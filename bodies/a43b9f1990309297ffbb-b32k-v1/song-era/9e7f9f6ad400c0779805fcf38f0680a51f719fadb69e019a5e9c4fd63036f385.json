[{"title":"舟中简祖显 其二","author":"章甫","text":"散发扁舟上，秋江一段清。\n鱼肥新入馔，鸥狎旧同盟。\n浦树参差出，云山远近迎。\n君诗妙图写，不减谢宣城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69789,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过家留一夕曹丈复和韵再作","author":"章甫","text":"贤圣何曾时一中，扁舟但困打头风。\n按田外叹裹粮乏，还舍内嗟瓶粟空。\n论事时遭瞋目视，催科隔绝满堂烘。\n匆匆结束又西迈，望眼却随黄鹄东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69790,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过清宇新居再用开字韵 其二","author":"章甫","text":"书帙儿能整，柴扉手自开。\n梦残江月上，酒醒竹风来。\n旧集秋重校，微吟日几回。\n初无俗客饭，当有故人杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69791,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过清宇新居再用开字韵 其一","author":"章甫","text":"市远嚣尘息，窗明老眼开。\n句从天外得，书自日边来。\n久住当成趣，相看不忍回。\n凉生初却扇，月出好衔杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69792,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"问祖显疾 其一","author":"章甫","text":"念子何多病，逢人问好音。\n可无安乐法，未用短长吟。\n陋巷邻南北，春风酒浅深。\n杯蛇弓落影，应已断疑心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69793,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"问祖显疾 其二","author":"章甫","text":"隐几维摩诘，伤春杜拾遗。\n观身如聚沫，忧国正攒眉。\n药裹添新说，腰围减旧时。\n朝来强饭不，问讯一凭诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69794,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即日 其三","author":"章甫","text":"醉里三春了，山中五载留。\n日长知已夏，雨冷忽如秋。\n书贷监河粟，箱存季子裘。\n曲肱朝睡美，身外付悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69795,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即日 其一","author":"章甫","text":"苦忆花吹尽，生嫌草长齐。\n莺啼春已暮，客散日还西。\n孺子抛书卷，童奴理菜畦。\n怒雷将急雨，一夜水平堤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69796,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即日 其二","author":"章甫","text":"吟苦知音少，棋低敌手多。\n故人无恙不，薄酒奈愁何。\n未暇兔三窟，聊同鸥一波。\n传闻江北路，人应力田科。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69797,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即事 其七","author":"章甫","text":"探报无虚日，淮东有捷音。\n周王方北伐，蠢动敢南侵。\n四海当多事，群公在一心。\n祖宗功业盛，德泽结民深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69798,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即事 其十","author":"章甫","text":"初失清河口，骎骎遂逼人。\n馀生偷岁月，无处避风尘。\n精锐看诸将，谋谟仰大臣。\n愞夫忧国泪，欲忍已沾巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69799,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即事 其一","author":"章甫","text":"暑雨何时了，江云不肯开。\n穷途惟有死，薄俗动相猜。\n怪事供诗卷，閒愁付酒杯。\n欲从湖海去，安得小舟来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69800,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即事 其九","author":"章甫","text":"群寇仍猖獗，城边即弃捐。\n休兵虽上策，讲信竟虚传。\n人事今如此，天心恐未然。\n忍令唇齿地，重此染腥膻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69801,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即事 其八","author":"章甫","text":"两淮仍蜀道，群寇再侵寻。\n不戒兵犹火，唯誇旅若林。\n皇图终复古，天意亦难谌。\n咨尔无猖獗，须思后患深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69802,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即事 其三","author":"章甫","text":"天意诚难测，人言果有不。\n便令江海竭，未厌虎狼求。\n独下伤时泪，谁陈活国谋。\n君王自神武，况乃富貔貅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69803,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即事 其四","author":"章甫","text":"门静悠悠日，春愁淡淡天。\n风尘殊未已，形影自相怜。\n有客还诗债，无人与酒钱。\n感时歌慷慨，忧国泪潺湲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69804,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即事","author":"章甫","text":"平边活国不关侬，昼永新添炙背功。\n鸠妇仳离天欲雨，鹊巢低稳岁多风。\n一弹指顷韶光半，微破颜时梦事空。\n但得馀生无病恼，从渠南北与西东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69805,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即事 其二","author":"章甫","text":"俯仰怜身世，飘零玩岁时。\n道途多异说，客子有新诗。\n日落乾坤惨，风生草木悲。\n高楼空北望，清泪不胜垂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69806,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即事 其五","author":"章甫","text":"风急收残雨，花轻点客衣。\n江山争秀发，燕雁不同飞。\n异县交游少，中原信息稀。\n王师战甚苦，方解蔡州围。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69807,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即事 其六","author":"章甫","text":"弟妹今安在，飘零各贱贫。\n诗成难寄远，目断更伤神。\n风俗殊方异，交情白首新。\n辛勤营一饱，愧此百年身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69808,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈胡德器","author":"章甫","text":"相逢纵酒又连旬，醉倒谁知主与宾。\n舌在莫谈当世事，眼明仍是故乡人。\n不愁春与花俱减，但恨君如我更贫。\n淮上风烟随分好，他年准拟作比邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69809,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"张王臣自湖南官满趋朝舟过白沙和惠资福二诗末章见及次韵 其二","author":"章甫","text":"丛桂书斋念昔游，红莲幕府喜归休。\n秋风起舵蒹葭渚，春月停桡杜若洲。\n未用把诗轻万户，直须呼酒散千忧。\n赞公亦是江湖旧，更问君能少住不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69810,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"张王臣自湖南官满趋朝舟过白沙和惠资福二诗末章见及次韵 其一","author":"章甫","text":"别来身世转乖违，老病交攻若有期。\n目力半昏难结字，心情全懒罢吟诗。\n鱼沉湖海无书日，犬吠柴荆有客时。\n三径莫嫌犹寂寞，地偏花木得春迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69811,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"张德恭以诗当谒次韵 其一","author":"章甫","text":"新诗俄拜辱，午醉未全醒。\n如入图书府，宜游著作庭。\n文章先体制，耆旧有仪刑。\n愧我空迟莫，穷居昼掩扃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69812,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"忧旱","author":"章甫","text":"贫贱甘羁旅，淹留赖薄田。\n悠悠将送老，比比不逢年。\n旱魃工为虐，雷公岂易鞭。\n醉能忘万事，安得酒如川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69813,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"苏训直方夷吾相挽同饭招隐","author":"章甫","text":"登临筋力犹如昨，兴废循环自有时。\n青石独存超士传，粉牌新得省郎诗。\n云山改色风生座，野鹿无踪水满池。\n胜处只宜文字饮，不须红袖苦追随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69814,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闰月二日清坐 其一","author":"章甫","text":"淮海秋风日，柴荆老病夫。\n诗因穷处得，愁到酒边无。\n俗物妨青眼，浮生喜白须。\n绳床供午寝，清梦落江湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69815,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闰月二日清坐 其二","author":"章甫","text":"秋闰迟收穫，年衰惜友朋。\n每怀人似玉，安得酒如渑。\n鹊语何多诞，蝉声故可憎。\n茶香新落磨，亦足洗炎蒸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69816,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"閒吟 其二","author":"章甫","text":"梅花白尽柳初黄，春未平分日已长。\n老眼明边湖水绿，閒愁来处楚山苍。\n高吟且喜诗无病，痛饮方知酒有肠。\n南北故人强健否，谁知旅鬓欲秋霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69817,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"閒吟 其一","author":"章甫","text":"春风略不欺贫贱，美酒真堪托死生。\n芳草又依穷巷绿，残尊重与故人倾。\n雨馀入馔添蔬笋，昼永攲眠忆弟兄。\n但得一廛供送老，更将诗颂纪升平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69818,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和朱少翁除夕","author":"章甫","text":"破晓东风又磔鸡，人心物态两推移。\n建瓴岁月今将老，漂梗江湖少不羁。\n独坐旧谙为客味，长愁新赋悼亡诗。\n多惭府主莺花约，归去西畴恐后期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69819,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和沈商卿次前韵 其二","author":"章甫","text":"逢人问行李，几日至东园。\n别去将三月，书来得五言。\n淮山分限域，风土异寒暄。\n四大知安稳，根尘要反源。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69820,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和沈商卿次前韵 其一","author":"章甫","text":"故人边上去，春到未还家。\n奔走因王事，艰难感岁华。\n诗坛推俊逸，醉帽想攲斜。\n莫怪书题少，新年眼更花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69821,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和周师禹所寄","author":"章甫","text":"九载光阴俯仰间，百年人世几悲欢。\n竹楼梦断伤春晚，云壑书来喜岁寒。\n别久更怜诗笔健，愁多须放酒杯宽。\n相望江北江南路，柳絮随风又作团。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69822,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和俞若晦晚步","author":"章甫","text":"日落帆归疾，天寒潮应迟。\n老蟾还照客，宿鸟未安枝。\n怀抱难忘酒，工夫不到诗。\n徘徊江上路，此意有谁知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69823,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和韩丈雪晴","author":"章甫","text":"天公逞巧逐时新，戏把乾坤作烂银。\n净压边尘无战马，寒持使节有诗人。\n夜长霜月争催晓，年近江山逼放春。\n归寿高堂先一醉，称觞汉殿及嘉辰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69824,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和韩无咎使君吊李谪仙","author":"章甫","text":"力士能令妃子嗔，长安无复谪仙人。\n宫袍却换江东酒，野服终为帝外臣。\n孤冢道旁空怨结，两峰烟际自愁颦。\n骑鲸捉月知何在，太白光芒夜夜新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69825,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜坐","author":"章甫","text":"枕簟迟迟睡，轩窗一一开。\n市收人语寂，江迥水风来。\n熠耀明衣袂，婵娟到酒杯。\n新凉儿女健，促织已相催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69826,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨中简孙文辅 其一","author":"章甫","text":"多病愁阴晦，长贫惯寂寥。\n一江云漠漠，十日雨潇潇。\n蛙黾誇秋水，鱼虾趁晚潮。\n新来疏酒盏，颇觉负清宵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69827,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨中简孙文辅 其二","author":"章甫","text":"马瘦凭谁相，龟灵故自焦。\n世途何偪仄，物性各逍遥。\n君老嗟黄绶，吾衰感黑貂。\n雨寒无病恼，酒熟即招邀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69828,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨中简孙文辅 其三","author":"章甫","text":"寂寂诸缘省，绵绵一气存。\n心情亲药裹，口味减盘飧。\n庞蕴无生话，维摩不二门。\n秋声摇万壑，落叶会归根。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69829,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨中简李牧之","author":"章甫","text":"提壶劝饮方多病，布谷催耕未有田。\n老去情怀非宿昔，日长图史得周旋。\n客愁正是连山雨，时事浑如上水船。\n问讯诗翁无恙否，遥怜裋褐耸双肩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69830,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日山居 其三","author":"章甫","text":"村陋浑成俗，云山要可人。\n短篱鸡唱午，芳树鸟啼春。\n地僻愁仍少，身閒懒更真。\n扁舟因送客，重到大江滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69831,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日山居 其一","author":"章甫","text":"流转情何限，艰难老见侵。\n儿啼妨午睡，花落搅春心。\n得句从谁说，开尊祇自斟。\n移家近城市，湖水几时深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69832,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日山居 其二","author":"章甫","text":"客舍逢迎少，村居道路迷。\n雨晴知虎过，烟暝有鸦啼。\n轻薄看诸子，辛勤愧老妻。\n人生真寄耳，巢燕亦添泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69833,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日村居 其三","author":"章甫","text":"冬暖惟忧麦，春寒却勒花。\n地偏宜鸟雀，江远少鱼虾。\n惊犬时时吠，归鸿字字斜。\n故园芳草色，游子亦思家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69834,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日村居 其五","author":"章甫","text":"土室宜冬夏，柴门玩岁时。\n不嫌贫作祟，直恐老相欺。\n草茁牛羊壮，山空虎豹饥。\n天晴好挑菜，吾亦伴儿嬉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69835,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日村居 其一","author":"章甫","text":"筑圃未成趣，栽桃才试花。\n年饥儿强饭，春困妇煎茶。\n为客空迟暮，逢人只叹嗟。\n上天新号令，雷雨起龙蛇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69836,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日村居 其四","author":"章甫","text":"浦树微微改，溪流稍稍深。\n春来差少病，岁后苦多阴。\n陇亩三年梦，亲朋万里心。\n感时仍念旧，老泪欲沾襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69837,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日村居 其二","author":"章甫","text":"村迥客来少，山寒春到迟。\n修塘留野水，插槿补疏篱。\n旁舍閒相过，幽人旧有期。\n出门看远烧，拄杖立多时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69838,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春尽","author":"章甫","text":"昼永花阴直，风轻麦浪匀。\n僧归还逼夏，莺语欲留春。\n须发垂垂老，亲朋往往贫。\n地偏人事少，聊以寄吾真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69839,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春晚寺居即事","author":"章甫","text":"晚晴鸟雀喜窥檐，客舍馀寒怕卷帘。\n多病新来知本草，安心老去读楞严。\n发稀帽侧头慵栉，火冷香消手自添。\n百念不生惟饱饭，春山蔬笋十分甜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69840,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春望","author":"章甫","text":"东风吹水岂容平，小雨催花却易晴。\n旅燕欲来春社近，故人何处晚山横。\n不才愧忝诸侯客，苦思难攻五字城。\n芳草满庭无一事，竹间幽鸟变新声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69841,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"独登南楼兼怀严圣几俞若晦 其三","author":"章甫","text":"昼景微微敛，阴云稍稍低。\n炎凉催旅燕，风雨听鸣鸡。\n独立江楼上，相思浙水西。\n诗情兼酒伴，何日手重携。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69842,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"独登南楼兼怀严圣几俞若晦 其一","author":"章甫","text":"瓜茗难逃暑，蚊蝇正作秋。\n劳生一念错，晚境万缘休。\n笔老无新语，囊空有敝裘。\n閒携瘦藤杖，独上郡南楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69843,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"独登南楼兼怀严圣几俞若晦 其二","author":"章甫","text":"城外江山好，楼前市井喧。\n登高明远目，直北望中原。\n济世原无策，伤心不忍言。\n唯馀忧国泪，还共水潺湲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69844,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋日 其二","author":"章甫","text":"故人多鬼录，久客又惊秋。\n为计无三窟，怀归在一丘。\n鸡鸣风雨晦，雁急稻粱谋。\n忆我山中友，天寒夜饭牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69845,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋日 其一","author":"章甫","text":"奔走伤形役，艰难感物华。\n澹烟笼远树，小雨湿寒沙。\n唤客尊无酒，撩人菊有华。\n弟兄书不至，过尽雁行斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69846,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋兴","author":"章甫","text":"宿昔驱蝇手，今还把蟹螯。\n家愁难止酒，天气近登高。\n岁月形容改，乡关梦寐劳。\n小窗无晤对，风叶暮萧骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69847,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"荐饥 其一","author":"章甫","text":"陇亩还枯旱，锄犁谩苦辛。\n饥寒知不免，盗贼恐相因。\n忧国书生志，安民圣主仁。\n丰凶端有数，天本爱斯民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69848,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"荐饥 其二","author":"章甫","text":"久客身长健，频年谷不登。\n天时有差忒，人事亦因仍。\n鹏运溟南北，鱼呼水斗升。\n世途惟论报，谁饭在家僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69849,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送十八兄","author":"章甫","text":"故园别去踰三纪，男子生来志四方。\n千里劳君双足趼，百穷笑我两眉长。\n雪深客舍衣裘冷，春晚家山杖履香。\n归省松楸终有日，临分老泪亦沾裳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69850,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送任政道","author":"章甫","text":"萧寺同时客，交情子更深。\n有时长共说，无事即相寻。\n临水初分袂，因风数寄音。\n青云如得路，珍重岁寒心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69851,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送张玉叔","author":"章甫","text":"春风端的解相期，吹尽桃花作雨飞。\n政苦无钱供剧饮，可堪临水送将归。\n穷愁度日添诗卷，老病忧时减带围。\n后夜思君望银汉，双星会处有光辉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69852,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送张安国","author":"章甫","text":"万里烟霄早致身，一麾到处作阳春。\n随时用舍知无愠，落笔纵横信有神。\n江国云山愁送远，桂林风土独宜人。\n笑谈坐慑群偷化，便合归来据要津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69853,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送张扬子","author":"章甫","text":"堂上弦歌吏早休，三年官舍冷于秋。\n诸公极力争推挽，野老何知欲借留。\n去矣青云皆坦路，归欤明月只扁舟。\n都城故旧如相问，草满空山自牧牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69854,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送李清宇","author":"章甫","text":"行李过门复小留，剧谭同此小窗幽。\n三杯酒力客愁破，一夜雨声春事休。\n旧燕寻巢元未毁，新莺出谷自相求。\n槐牙准拟供汤饼，初夏重来定到不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69855,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送孟希道","author":"章甫","text":"异县交游少，邻墙岁月深。\n肴蔬长共醉，风雨亦相寻。\n去路逾千里，离筵惜寸阴。\n功名君努力，衰病我何心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69856,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]