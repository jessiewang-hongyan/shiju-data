[{"title":"百花岩","author":"吴驲","text":"灵岩竞吐秀，百卉四时开。\n不假栽培力，天然锦绣堆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44348,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿王通判五首 其五","author":"吴势卿","text":"流霞潋滟照炎天，雪藕调冰佐玳筵。\n屈指西风凉意近，且拚剧饮管流年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44349,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿王通判五首 其四","author":"吴势卿","text":"古称半刺已翱翔，□垒回旋舞袖长。\n赖有治齐清净法，宏开寿域海沂康。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44350,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿王通判五首 其三","author":"吴势卿","text":"留槎阁外记前回，龟伴高斋今再来。\n试问剑州馀父老，棠阴勿剪又栽培。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44351,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿王通判五首 其二","author":"吴势卿","text":"仙都仙子锦云裳，手授长生不死方。\n观惠春风今几度，童颜不改只刘郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44352,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿王通判五首 其一","author":"吴势卿","text":"银潢漾漾月华清，宝婺辉联处士星。\n中有老人南极现，三台齐色照篁屏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44353,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"当筵致语","author":"吴势卿","text":"此去京师一握天，太平官府似神仙。\n九重明圣无疆寿，千里封圻大有年。\n政已和平春缓缓，民无愁叹鼓渊渊。\n三呼三祝情何已，稽首君恩雨露边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44354,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"呈徐知院题意一堂","author":"吴势卿","text":"几载辛勤有此堂，芝峰直面丽谯傍。\n千章山木朝烟合，百尺楼阴夜月凉。\n物我本于仁上一，居诸偏向静中长。\n衰年烛武知何用，空有忧时两鬓霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44355,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿周丞相益公 其五","author":"刘子寰","text":"兼善工夫自古难，有谁志学合伊颜。\n儒先拈得四书出，名相措诸万事閒。\n功向时危尤易见，道于世运实相关。\n鲁论一半犹收效，寿国应须安似山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44356,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿刘监丞 其一","author":"吴势卿","text":"昨陪骏马骤芳尘，怪得梅花喜色新。\n恰则祝尧开瑞节，居然生甫已今辰。\n冰壶缓度壶天日，翠玉交辉玉树人。\n天下至荣公占尽，綵衣皂盖更青春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44357,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿刘监丞 其二","author":"吴势卿","text":"佩玉徐行胜急驰，悠然滋味独深知。\n地当韩愈分符处，人羡买臣怀绶时。\n已出六奇陪授钺，更藏一著要观棋。\n经纶毕竟还精密，大任非公更属谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44358,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"咏后山镇水月奇观阁","author":"吴势卿","text":"厌逐京华辇路尘，归来杰阁敞虚明。\n斜阳两岸暮山紫，明月一天秋水横。\n芳草尽头黄犊乐，芦花深处白鸥声。\n是中不仗诗模写，一片丹青可得成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44359,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽欧阳梅坡","author":"吴势卿","text":"穆陵老进士，归侍白云乡。\n前辈风流远，斯文感慨长。\n平生足千载，盛德在诸郎。\n斜日城头路，寒梅立莽苍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44360,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽蔡久轩 其二","author":"吴势卿","text":"识见先几炳蔡蓍，艰难国事虑阽危。\n龟山如用救得半，君实未亡犹可为。\n人渺江涛已如此，公骑箕尾欲何之。\n门生老病丹心折，伫立空山有所思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44361,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽蔡久轩 其一","author":"吴势卿","text":"道学相承祖子孙，诸儒谁得似渊源。\n铜川而上谁家世，程氏之门止弟昆。\n后世定知尊所学，当时未尽用其言。\n四书功用弥天地，惜不推行半鲁论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44362,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"望阙致语","author":"吴势卿","text":"镐燕云开纪诞辰，括山人即华封人。\n圣明天子千秋节，帖泰时年半月春。\n龙左角占农事好，殿西头喜捷书频。\n小臣有录如金鉴，愿献吾君德日新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44363,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿丞相 其一","author":"吴势卿","text":"六月麟书雨作霖，生贤此际见天心。\n江都分洒虽名世，莘野商霖始见今。\n门馆无□仪表正，经纶有道本原深。\n正人命脉家常主，一念公忱朋盍簪。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44364,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿周丞相益公 其四","author":"刘子寰","text":"昨丙辰年相魏公，当时克敌首归功。\n何如手补天西漏，仍更神驱塞北空。\n一隙暇时关国祚，十分重任赖臣忠。\n天生贤佐兴王业，正看周诗六月中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44365,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿宗室","author":"吴势卿","text":"海珠吐月海水红，翠竹岩近蓬莱宫。\n晨游东华天帝所，望舒前导参丰隆。\n帝曰炎图亿万载，往哉汝谐盘石宗。\n授之虹玉金斗印，一佛出世群仙从。\n麟兮定兮已为瑞，綵袖接武葛氏龙。\n忆昔京畿得贤辅，胥涛欲齧粒食空。\n百万生灵衽席上，三日事业方寸中。\n至今途歌与里咏，活民生佛称我公。\n公侯衮衮世罕有，初心本愿皆阴功。\n枌榆社内木连理，华萼楼间天九重。\n邦臣未识买臣贵，天子应知刘向忠。\n未央前殿催元会，天诏传宣一字封。\n武夷之山三十六，仆居八曲鼓子峰。\n白马仙人向我说，高牙今驻秦甬东。\n起看梅花玉的皪，记得诞日今重逢。\n去年已献鹤飞曲，今年作诗尤未工。\n一年一轴从今始，邺架轴少诗无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44366,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"沁园春 寿董宪使","author":"吴势卿","text":"碧瓦霜融，绣阁寒轻，春浮寿杯。\n羡华年七帙，人生稀有，新阳七日，天意安排。\n丹凤门开，黄麾仗立，此际应须召促回。\n人道是，却暂时绣斧，索笑盐梅。\n吁江假守非才，犹记得当时传庾台。\n算良机再会，抠衣来久，归鞭何速，祝寿方才。\n应与邦人，传为佳话，只为先生诞日来。\n明年看，是侬方九曲，公已三台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44367,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"声声慢","author":"吴叔","text":"烟横山腹，雁点秋容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44368,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江上","author":"吴叔元","text":"独坐江之涘，高秋叶落时。\n风狂疑水立，云动觉天移。\n浦远孤鸥没，溪平小艇迟。\n徘徊待月上，把酒寄遐思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44369,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水调歌头 寿钱太尉","author":"吴叔虎","text":"清澈黄河底，乙未政和年。\n坤珍阐瑞，运符五百间生贤。\n日暖曲江花柳，鼎沸韶春弦管，尺五是青天。\n殊宠逢熙载，吉梦送真仙。\n承盛德，公故国，庆双全。\n行看旌钺紫泥，丹诏下苕川。\n多祝多男多寿，长愿长安长乐，剑履玉宸前。\n蕙炷紫琳馆，丹笔蕊珠篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44370,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"殊圣寺和孟我幕韵","author":"吴咏","text":"院静僧疑少，门幽客自稀。\n山寒云近屋，径狭石侵衣。\n松鬣苍髯古，姜芽紫笋肥。\n骚人诗战罢，踏月夜深归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44371,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"念奴娇 寿朋友","author":"吴季子","text":"雪罗初试，过赐衣时节，才三四日。\n记得延陵公子宅，麟角当年新绂。\n半刺名家，一经奥学，是青云人物。\n如何华发，蒲轮未聘遗逸。\n问讯怨鹤惊猿，不妨俱隐，且逍遥丈室。\n有子传家经可教，况有东皋种秫。\n醉里乾坤，闲中日月，便是长生术。\n瑶池宴后，剩看几度桃实。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44372,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"醉蓬莱 寿友人母","author":"吴季子","text":"正淡烟疏雨，梅子黄时，清和天气。\n阿母当年，暂辍瑶池会。\n霞帔星冠，霓旌羽纛，下碧霄云际。\n恰与瞿昙，同时共日，降人间世。\n裼寝开祥，斑衣祝寿，一种灵椿，两枝仙桂。\n满引玻璃，且向今宵醉。\n待看阶庭，蓝袍交映，奉板舆游戏。\n到得蟠桃，熟时归去，已三千岁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44373,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游梅坛有感","author":"吴季先","text":"小立仙坛挹斗箕，著身高处觉天低。\n南昌吏隐清风在，唤醒时人局面迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44374,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵游山门寺望文脊山","author":"王安石","text":"宣城百山间，文脊尤奇峰。\n拔出飞鸟上，图画难为容。\n闻昔有幽人，扪萝追赤松。\n遗形此古室，孤坐鹿裘重。\n人去邈不反，洞壑空藏龙。\n侧行苍崖烟，俯仰求灵踪。\n游者如可得，甘弃万户封。\n安能久尘土，倾倒相迎逢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44375,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九顶大像阁","author":"吴宗旦","text":"嘉州石佛名天下，回视新昌可子孙。\n幸甚身游大人国，恍然梦跨北溟鲲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44376,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金釜山灵泉","author":"吴宗旦","text":"泉来有脉去无痕，水底神龙暗吐吞。\n莫怪一池杯样小，个中风雨洗乾坤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44377,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"都梁宫","author":"吴宗旦","text":"从来香草骚人咏，晚作离宫炀帝游。\n三殿重重锁秋色，七泉脉脉贯中流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44378,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"吴宗旦","text":"避暑自应归故国，无端依旧入扬州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44379,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"墨梅","author":"吕本中","text":"岭南十月春渐回，妍暖先到前村梅。\n问君何处得此妙，一枝冷艳随霜开。\n长江凛凛欲奔岸，乃见好事移墙隈。\n初疑渗漉入瘴雾，更欲寂寞埋烟煤。\n微风不动暗香远，淡月入户空徘徊。\n坐看粉黛化腐恶，岂但桃李成舆台。\n我行万里厌穷独，疾病未已心先灰。\n对此不觉三叹息，恐是转侧同南来。\n异乡久处少意绪，破壁相对无根荄。\n古来寒士每如此，一世埋没随蒿莱。\n遁光藏德老不耀，肯与世俗相追陪。\n轮囷离奇多见用，牺尊青黄未为灾。\n含毫吮墨去颜色，况自不必须穿栽。\n岁穷路远莫惆怅，此去保无蜂蝶猜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44380,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"弹子岩题名","author":"徐梦莘","text":"吾侪生江南，远近俱邻乡。\n一官皆为贫，糊口走四方。\n遇合良独难，动如参与商。\n谁知自有时，朋盍聚炎荒。\n外台参计画，幕府佐纪纲。\n出宰得壮县，分教涖郡庠。\n曹掾胜三语，簿领真仇香。\n不止似人喜，顿觉吾军张。\n合坐尊序齿，避席敬行觞。\n岩酒纵登览，杖屦陪徜徉。\n棋矢以相娱，啸歌情意长。\n举酒起祝规，爱我药石良。\n古人尚植立，君子道其常。\n平生学忠孝，馀力从文章。\n临节不可夺，当官有何强。\n穷乃见节义，老当志弥刚。\n鸿鹄在寥廓，骐骥终腾骧。\n愿言各勉旃，事业要辉光。\n它日先上道，富贵无相忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44381,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九曲亭","author":"吴居厚","text":"山上盘旋九曲亭，春江满目与天平。\n青蘋白鹭渔家屋，几幅轻绡画得成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44382,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吴王城","author":"吴居厚","text":"吴王宫殿作飞尘，野鸟幽花各自春。\n料得寒溪暄笑日，也曾惊动武昌人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44383,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅山二首 其二","author":"吴居厚","text":"连云绝壁山无路，溅石潺湲水有花。\n试问昔时畬粟麦，何如今日种桑麻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44384,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅山二首 其一","author":"吴居厚","text":"寻溪小径多盘诘，车马初来路欲迷。\n千古英雄汉天子，桑麻今已遍标题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44385,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与部使同游司空山","author":"吴居厚","text":"王官身已达，所悦多纷华。\n区区朝与市，轻暖事穷奢。\n我公味冲澹，止乐山水嘉。\n肩舆靡厌寻，谢兴无津涯。\n杖藜适意游，野径穿迂斜。\n回忆挂冠时，息此避喧哗。\n骨相有神仙，得道成全家。\n遗迹富览观，高步淩烟霞。\n静中白日长，玉宇清风赊。\n睹兹神圣迹，喟然兴叹嗟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44386,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"吴居厚","text":"步寻斜径到寒溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44387,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九吟诗 飞玉","author":"吴昌裔","text":"谁擘岩扉石窦开，中流玉水漱苍苔。\n有时卷雪从天下，端是源头蓄得来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44388,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九吟诗 天柱","author":"吴昌裔","text":"柱天屹嶪断鳌根，卧草蒙茸伏虎痕。\n想见山中明月夜，有人长啸抱昆崙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44389,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九吟诗 来贤","author":"吴昌裔","text":"杖挂松花酒一瓢，手挼柏子杂香烧。\n山空露冷吟招隐，掉首诸贤不受招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44390,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九吟诗 栖真","author":"吴昌裔","text":"凿破千年浑沌心，石楠当户洞愔愔。\n诗臞犹怯春寒在，扪石梯云不敢深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44391,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶成","author":"吴明老","text":"西风飒飒动长林，斗酒沽来伴月斟。\n慷慨未应忧短褐，悲歌元不为秋砧。\n谁云塞马年年健，自是君门浩浩深。\n世祖丰神似高帝，楚囚珍重莫沾襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44392,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"磨崖颂","author":"吴杭","text":"周雅久不复，楚骚方独鸣。\n溪蛙弄气态，污我潇湘清。\n二公好奇古，大笔时纵横。\n磨崖勒唐颂，字字飞琼英。\n云烟借体势，水石生光精。\n浯溪在僻地，自是闻正声。\n名传播夷夏，孰贵燕然铭。\n弦歌入商鲁，永与神仙听。\n江流不可竭，此文如日星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44393,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上峰顶","author":"吴泳","text":"一峰骆驼岭突兀，万级胡孙梯屈盘。\n佛法岂无平易处，怕人只作等閒看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44394,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中峰","author":"吴泳","text":"连空阁道结飞霞，衲子云游少住家。\n问讯两仙呼不应，鸟啼惊落一岩花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44395,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"牛心寺","author":"吴泳","text":"青莲两两照山开，道是金仙手自栽。\n人与金牛俱不见，更从何处觅心来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44396,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉川茶","author":"吴泳","text":"一旗初试蜀山春，团銙谁论蔡与丁。\n更出苦言浇谏味，世间醉梦合俱醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44397,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"光相寺","author":"吴泳","text":"云气巃嵷羃晓山，晴曦倒影射阑干。\n须臾变态还空寂，水接天光一片寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44398,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"华严寺","author":"吴泳","text":"才上华严第一山，倚天双阙不曾关。\n白花紫柏漫山路，犹觉桃源在世间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44399,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"安西马","author":"吴泳","text":"月胁霜飞镜夹瞳，龙媒扫尽朔庭空。\n沙丘尚有真骊牡，端自方皋一顾中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44400,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和观棋","author":"吴泳","text":"七雄虎斗着难下，三季蚖蟠石不磨。\n蛮触纷纷无了日，青秧白水弄镰柯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44401,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张宪登乌尤山 其四","author":"吴泳","text":"子知天分不人尤，岂若纷纷式屡骄。\n旧见已知霜叶脱，新知才似谷牙焦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44402,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张宪登乌尤山 其一","author":"吴泳","text":"燕台爱士拔其尤，彻去藩篱吝与骄。\n藻翰宿春题品遍，青青无复土山焦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44403,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张宪登乌尤山 其三","author":"吴泳","text":"放怀物外亦何尤，便谓游遨士也骄。\n西日下来岩际宿，别尊难齧嚼皆焦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44404,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张宪登乌尤山 其二","author":"吴泳","text":"世涂偪仄动逢尤，山似高人色颇骄。\n寸碧亭亭还绿绕，知音不待爨桐焦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44405,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张宪登乌尤山 其五","author":"吴泳","text":"天戈何日戮蚩尤，省得营屯戍卒骄。\n事会无穷人物眇，坳杯莫救釜中焦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44406,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张宪登乌尤山 其六","author":"吴泳","text":"椒丘徐步不离尤，结驷朱门易养骄。\n宁似木鸡甘用拙，弗如龟筴以灵焦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44407,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和李雁湖晚春即事八首 其八","author":"吴泳","text":"杏花漠漠柳阴阴，彷佛前年礼殿深。\n赖有诗书缘不尽，青灯细雨短长吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44408,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和李雁湖晚春即事八首 其七","author":"吴泳","text":"庭草如茵鹿养茸，体当生意属仙翁。\n游龙不作千岩雨，却卷云根向洞中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44409,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和李雁湖晚春即事八首 其六","author":"吴泳","text":"丰神玉雪更清温，胸次涵濡七泽吞。\n闻道晚年偏好易，手探月窟足天根。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44410,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和李雁湖晚春即事八首 其五","author":"吴泳","text":"长鲸须向海波翻，泽雉何由肯畜樊。\n步障连空鞋一屋，不如萧散半山园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44411,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和李雁湖晚春即事八首 其四","author":"吴泳","text":"避人不必武陵源，荡有芙蓉溪有荪。\n弄水浇花心自远，何妨酌客两三尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44412,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和李雁湖晚春即事八首 其三","author":"吴泳","text":"蔼蔼停云八表昏，终风吹雨泊天门。\n系船东港缘壕去，落日牛羊下远村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44413,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和李雁湖晚春即事八首 其二","author":"吴泳","text":"纷纷花片落车茵，点点苔钱衬屐痕。\n造化生机浑不尽，又将新绿转春温。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44414,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]