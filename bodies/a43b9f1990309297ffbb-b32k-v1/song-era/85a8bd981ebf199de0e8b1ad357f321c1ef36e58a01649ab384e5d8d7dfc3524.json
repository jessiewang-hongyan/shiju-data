[{"title":"伯瞻郎中生日","author":"韦骧","text":"瑞气飘飘贯斗牛，当时贻庆在南州。\n太平势盛高贤出，造化功成万物秋。\n侯国几年凝课最，相门今日足风流。\n祝公寿与灵椿等，庶得胸中尽壮犹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46074,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中秋南康夜会得天字","author":"韦骧","text":"宿阴初卷尽，万状正萧然。\n夜色兼秋半，人情爱月圆。\n褫巾洒浊酒，露坐幕青天。\n佳节还相遇，阳阳忆去年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46075,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"假道南康长道语今夕中秋正故岁聚并喜乐时也遂留以夜饮饮半和所示诗","author":"韦骧","text":"月华乘颢气，人竞此宵明。\n旧会嗟经岁，修途为辍程。\n凉飘襟袖爽，秋入管弦清。\n莫诮红裙饮，新诗亦间成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46076,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"睦州千峰榭二首 其一","author":"韦骧","text":"千峰围绕自苍然，古榭凄凉不记年。\n搜索旧名逢雅尚，主张佳境有豪篇。\n坐凌翠霭群嚣隔，眼入清秋万状全。\n芜废不唯兴此地，当知民物尽陶甄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46077,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"睦州千峰榭二首 其二","author":"韦骧","text":"层基突兀倚晴空，碧嶂回环势复重。\n秀色有时侵画隼，苍烟尽日卧乌龙。\n严公滩近增幽概，方叟诗存得旧踪。\n贤守葺遗殊众好，政閒把酒看千峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46078,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿广严靖阁","author":"韦骧","text":"久为簿领废登临，一宿禅扃万虑沉。\n半夜松声惊梦枕，琴书幡起故园心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46079,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过法宁僧舍","author":"韦骧","text":"积阴卷尽见朝阳，更入云林古道场。\n疏旷襟怀终久在，暂离簿领已清狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46080,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题虎峰真师壁","author":"韦骧","text":"虎踞山形路屈盘，烟云过尽到禅关。\n老僧得地真安稳，不向人间趁往还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46081,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"检覆鸡啼源还虎峰","author":"韦骧","text":"到此崎岖力已疲，肩舁西去更乘危。\n始知不及閒人好，避险从安任所之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46082,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寒雨夜会得歌字","author":"韦骧","text":"佳客来相遇，衔杯语论和。\n夜寒兼雨甚，酒色向人多。\n泪烛摇红萼，风帷动翠波。\n漏声催举白，檐溜混微歌。\n朋契淡閒合，诗锋闇里磨。\n十年方一笑，不醉奈情何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46083,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"呈范子镇同年","author":"韦骧","text":"白日当时共得仙，清樽未倒且留连。\n间关益部君今去，后会轻论又几年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46084,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"劝元功饮","author":"韦骧","text":"昔时同闬今同郡，气义相欢此最亲。\n莫向酒杯成偃蹇，醉来诗格合清新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46085,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和范同年得厅字","author":"韦骧","text":"人生难计拟，并合若漂萍。\n稀阔同年会，萧条古县厅。\n冒寒欺雨势，卜夜托龟灵。\n漏转歌声促，风馀烛烬零。\n主樽惭北海，客量过沧溟。\n愿且留车马，离弦未可听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46086,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"涵碧池","author":"韦骧","text":"原泉有本养渊渟，更似端人见底清。\n竹色山光朝暮在，当知涵碧不虚名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46087,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"涵碧亭","author":"韦骧","text":"座隅平地是云山，爽气无穷六月寒。\n梦得祗知图未善，不知能画不能完。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46088,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"瀑泉","author":"韦骧","text":"堂堂一道出山腰，色似垂缣响似潮。\n何必枕流图洗耳，坐观已觉俗尘消。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46089,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"双石鱼","author":"韦骧","text":"谁磨紫石作双鱼，绕以清流泛酒觚。\n祗使幽人添醉逸，山林未快忆江湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46090,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"傲亭","author":"韦骧","text":"峨然危构冠山巅，以傲名亭傲可贤。\n不与世人论是否，谁能来此卧云烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46091,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"双峰","author":"韦骧","text":"我爱双峰若并趋，钧然苍翠傲荣枯。\n定应天意成真概，磊落相依道不孤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46092,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"击瓯","author":"韦骧","text":"箫鼓厌喧豗，瓯声可荐杯。\n鸣珂秋猎骏，锵佩晓朝回。\n挹注虽为助，甄陶别有胚。\n玉纤敲击锐，惊起玉山颓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46093,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和朱尉示亲老生日","author":"韦骧","text":"腊残朝夕是新春，秀入溪山碧万寻。\n白发亲逢蓬矢庆，綵衣人奉玉杯深。\n风回庭砌弦簧脆，日上帘旌插珥森。\n敢谓小官无足慰，尽欢菽水亦甘任。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46094,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和朱伯英元夕","author":"韦骧","text":"燃灯结綵学春山，佳节还逢邑事閒。\n僚佐相从真我侣，旄齯共乐在其间。\n月中风味当无比，醉里尘劳似不关。\n祗以清樽期漏尽，明朝应悔主才悭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46095,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"席间和向辟之元夜 其一","author":"韦骧","text":"令节伸眉且自宽，与民同乐是民官。\n宴酣岂为残更促，醉兀何妨万目观。\n舞袖飘飘凌夜月，灯山闪闪战春寒。\n孤城谁谓萧疏甚，无愧途人即可欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46096,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"席间和向辟之元夜 其二","author":"韦骧","text":"无愧涂人即可欢，□□□□□□□。\n月华瑩澈通春夕，民气融和却暮寒。\n捃摭肴蔬成曲会，扶携老稚任环观。\n邑侬他日逢今日，往往应能话旧官。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46097,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"回长道中论","author":"韦骧","text":"□□□□□□纷，吾子文章有本根。\n此说独能通正道，□□□□□专门。\n剖开先圣难明旨，羞杀拘儒既□□。\n□□□才何足议，但凭馀燄发冥昏。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46098,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和长道候使者宿龙窟见寄","author":"韦骧","text":"幽寺傍□□□□，□□昂藏顶翠螺。\n县尹候迎车暂□，田氓观□□□□。\n潭间水黑应龙卧，松表风清独鹤过。\n□□□□□□我，萧斋倚柱祗长歌。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46099,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"长道将罢邑借前韵以寄","author":"韦骧","text":"山□□□□□□，□对春风把酒螺。\n况是安氓嚣讼少，何□□□□怀多。\n眼看野色烟云秀，指数瓜期日月过。\n闻说贤侯将解印，追攀无计且酣歌。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46100,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和见贻","author":"韦骧","text":"拘挛山邑四□□，□滞徒嗟薄宦身。\n忆昨同时来视事，羡君先我作閒人。\n倾心虽记多佳议，寒齿还忧失旧邻。\n安得追攀如素约，舳舻衔尾倚江滨。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46101,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送章郎中赴阙 其一","author":"韦骧","text":"□□□□治已成，还台荣望本峥嵘。\n朝廷不许淹贤□，□□□□借守情。\n晓日旌旗动行色，春风笳鼓作边声。\n□□□阏城西道，祗恐朱轓欲迅征。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46102,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送章郎中赴阙 其二","author":"韦骧","text":"□□□□孰可俦，弟兄麾节占三州。\n疲氓救尽方为□，□□□还岂自由。\n仁似周侯小棠在，清嫌汉守大□留。\n祇应静夜双溪月，远挂公心未得休。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46103,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"探得海棠送章仲成","author":"韦骧","text":"高低海棠枝，交结离人思。\n离披海棠花，烂熳离人醉。\n醉来离思轻，看花自有情。\n一片随春风，悠悠逐君行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46104,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和长道交道驿见招同趋府","author":"韦骧","text":"北出城闉天未明，待驱款段趁君行。\n归时亦欲偕吟醉，寄语林间有落英。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46105,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同长道游惠僧翠樾堂","author":"韦骧","text":"覃覃洁宇枕城阿，车马知名始见过。\n邃密莫嫌春态浅，牢笼不碍翠阴多。\n玩心爽概真偏得，泯迹空山去几何。\n今日□□□褫带，暂将尘扰就消磨。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46106,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清明雨","author":"韦骧","text":"阴云散漫与山平，草暗花昏匝古城。\n定是天心恶游放，故将雨脚锁清明。\n谁知静圃无穷极，独有幽禽不住鸣。\n况值清明归去客，共樽谈笑有馀情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46107,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"四月一日西池作","author":"韦骧","text":"田田荷叶大如钱，拙令无功又一年。\n六月京尘传流口，不嫌池上更迁延。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46108,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"林沼春归后","author":"韦骧","text":"林沼春归后，幽芳日益添。\n芭蕉翠羽扇，芦笋碧牙签。\n薄霭笼夷径，微波荡曲檐。\n主人山野性，杖屦此无厌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46109,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和朱尉首夏偶书见寄","author":"韦骧","text":"蹭蹬瓜期失，山城独滞留。\n驰驱更万态，寒暑过三周。\n底里繇前固，堤崖懒外修。\n仅能违吐茹，岂谓足阳秋。\n所幸偷安佚，兹心在讨求。\n门阑方事隙，园落见春休。\n秀色孤花载，晴光隘叶浮。\n池鱼行有队，林鸟语多羞。\n芦笋青簪短，丁香翠幄稠。\n藏身咍野茧，努角笑蜗牛。\n庭拥芭蕉扇，墙披薜荔裘。\n清风如远俗，危坐自忘忧。\n目极山兼水，云飞越与瓯。\n官曹虽鞅掌，野兴易牵钩。\n缿绝侵疆讼，阍无覆刺投。\n优閒为佐局，邂逅得吾流。\n酒薄犹思共，诗成罔不酬。\n肺怀非异致，议论讵相矛。\n受代何辞晚，谋欢且自由。\n他时遂暌阻，徒尔念英游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46110,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游金柱观瀑泉","author":"韦骧","text":"源高云表许谁穷，飞出岩前百丈雄。\n岂是山神作灵怪，解将烟雨变晴空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46111,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和伯英再赋","author":"韦骧","text":"行踪隐怪少人知，非是山僧别有机。\n漏泄一朝逢地主，逢迎终不似前稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46112,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同朱尉游普宁僧舍","author":"韦骧","text":"名区日事出南城，来扣禅关万虑平。\n强作优閒羞宓子，自成清淡爱梅生。\n棋敲玉局林莺窜，诗落苔笺山鬼惊。\n却说去年违此约，老僧应解管宫营。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46113,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和初夏雨中","author":"韦骧","text":"撇然春去浃旬馀，积雨乘阴气节殊。\n旷野石泉飞白练，虚庭檐溜激明珠。\n茧因寒晚群情病，麦候晴收万室须。\n空解登楼伺云色，爱民拙令愧偷儒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46114,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"端午雨饮伯英池馆","author":"韦骧","text":"山城重午遭阴晦，谢氏池亭亦自堪。\n野色映来歌舞好，炎威消去酒肴甘。\n手中菖屑随杯泛，头上榴花带雨篸。\n且尽主人留客兴，明年谁北复谁南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46115,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送王学士赴京东漕","author":"韦骧","text":"重寄属名卿，除书拜宠荣。\n山东移使节，天上动星明。\n经画几三载，恩威尽列城。\n询求皆疾苦，课入自丰盈。\n酣宴咍无取，焦心悯未宏。\n孟阳魂已愧，刘晏誉还轻。\n报国胸襟壮，纾民术学精。\n休风鼓群吏，高论满诸生。\n讵奋身干进，难排翼传声。\n褒功形圣诏，易地近王京。\n持节将新命，遮车见众诚。\n拳拳思远托，冉冉即修程。\n风飏旌旗活，云收鼓吹清。\n山川开爽气，草木有馀情。\n行健途疑促，吟豪思欲倾。\n越吴钧慕恋，齐鲁乐奔迎。\n万里宣材力，中朝倚办营。\n佥谐犹有待，舆议岂能平。\n器尚虚兼济，谋终赞仰成。\n宸衷方外藉，安可忆登瀛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46116,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晓出候按察","author":"韦骧","text":"未晓驱车出，炎蒸畏日高。\n苍茫侵雾气，隐约听鸡号。\n流滞还尸禄，奔驰敢叹劳。\n苦吟随处有，未始废陶陶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46117,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自和","author":"韦骧","text":"将旦云天惨，前瞻使旆高。\n田翁持火走，山鸟向人号。\n自哂折腰久，谁怜负弩劳。\n解从归去乐，空愧不如陶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46118,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偶作","author":"韦骧","text":"纱巾疏爽葛衣宽，簿领无多笑傲间。\n黄卷仰持眠昼榻，白云斜敛见晴山。\n风荷泻露池声激，烟柳藏蝉野趣閒。\n日月淹留非不幸，柅车休叹未西还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46119,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"予莅制济民药朱尉掌粜常平粟因以记","author":"韦骧","text":"火日炎炎五月天，邑中分事力相完。\n君当庾廪司平粜，我近方书辑众丹。\n共识朝廷欲为惠，岂图居处自偷安。\n谁言忠谊须谋大，未合谋时且恪官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46120,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和新竹","author":"韦骧","text":"根本坚深岂费培，龙蛇蜕尽见天材。\n斜穿似爱幽人到，疏列还容小径开。\n凉月骤添新影密，清风不减旧枝来。\n岁穷自有凌霜节，宁比秋衰恶草莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46121,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和独钓 其一","author":"韦骧","text":"苍葭欺绿鬓，白水照朱颜。\n掷饵渊渟处，牵钩荡漾间。\n亦知鱼呴沬，肯学雀衔环。\n且欲资清旷，消磨永日閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46122,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和独钓 其二","author":"韦骧","text":"古人多隐钓，意不在徵求。\n稽海曾垂犗，磻溪旧直钩。\n声名当日晦，德业后来收。\n莫笑临流者，持竿迹更幽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46123,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送刘睦州移京西漕","author":"韦骧","text":"贤杰恬荣进，朝廷眷旧材。\n优閒辍为郡，按举复行台。\n忆昨巡荆北，于时会岁菑。\n转输忧国计，假易缓民财。\n吏议乌能避，邦条不可裁。\n谪迁知咎戾，忠信即基胎。\n解印离江浒，分麾溯浙洄。\n列城遗厚爱，千里沛馀才。\n火玉坚难变，霜松翠弗摧。\n壮行心所勇，胶禄素尝咍。\n履道期终固，谋身绝外猜。\n子文忘愠色，严助乐归来。\n抚俗专求瘼，提纲独整颓。\n察幽穷蒂芥，屏恶自渠魁。\n犴狱春多草，宾阶雨不苔。\n溪山围几席，风月侑樽罍。\n毫瘦清吟苦，弦高雅曲哀。\n黄堂成卧治，青律再飞灰。\n况味安符竹，胸襟傲面槐。\n桐庐声绩远，蓂陛宠光催。\n近部劳经画，兼资藉玮瑰。\n使旌蜺夭矫，宸诏凤毰毸。\n肃肃途将戒，元元慕若孩。\n车攀朝柅轴，舟遁夜张桅。\n被命恭虽益，封章恳以推。\n让廉仪组绂，贪冒愯驽骀。\n京辅非轻寄，天衷未易回。\n功名当盛获，蕴蓄岂空培。\n舆论蕲皆惬，高怀愿更恢。\n壮猷那久抑，早晚咏良哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46124,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"双莲二首 其一","author":"韦骧","text":"池间?鞢红，特尔不雷同。\n共本青跗瘦，骈头秀色充。\n湘娥心并恨，江女佩双空。\n忍负流觞乐，虚教逐暮风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46125,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"双莲二首 其二","author":"韦骧","text":"临风皆独媚，同蒂忽相亲。\n擢秀材宜合，飘香势自钧。\n虽惭两岐瑞，已掩百花春。\n定是怜濡滞，殷勤悦主人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46126,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和朱伯英以诗庆将代","author":"韦骧","text":"非材安敢叹淹留，吏外尤忻共雅游。\n欲代虽知归去乐，相看还动解携愁。\n襟期岂逐炎凉变，谈笑应随簿领休。\n来岁黄花何处好，怀思把盏对霜秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46127,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和","author":"韦骧","text":"区区邑落四逢秋，敢诧归期占上游。\n似得葵丘瓜代信，如销都护玉关愁。\n琴弹夜月声还变，诗写溪山兴未休。\n幸有台池且同醉，别离到后更何由。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46128,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"将归","author":"韦骧","text":"代期渐可数光阴，掉鞅归时秋已深。\n篱菊正牵元亮眼，江鲈还动季鹰心。\n迎新送故人徒扰，兴利除残我不任。\n唯有溪山不辜方，未尝旷日废清吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46129,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"效谢宣城体呈同事","author":"韦骧","text":"秋风鼓长松，声来何飕飕。\n众鸟相与还，山椒落景收。\n吏冗得所隙，笑傲偕优游。\n虽无杯中物，亦足忘余忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46130,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"呈孙东美","author":"韦骧","text":"露气侵帘幕，萧然夜已分。\n括囊停较艺，倚几重论文。\n邂逅成相际，从容慰所闻。\n溪船行各去，回首只秋云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46131,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"试罢","author":"韦骧","text":"沓沓纷袍去，寥寥锁院中。\n云收晴野旷，潮卷夜江空。\n难尽文章鉴，终输议论公。\n敢辞淹旦暮，归翼尚羁笼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46132,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和东美示内乐亭诗","author":"韦骧","text":"养恬真有得，逐俗固无心。\n月沼秋如鉴，风松夜当琴。\n公馀偏坐晚，客至不谈今。\n张我名亭意，惭君寄好音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46133,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和东美见寄","author":"韦骧","text":"子陵溪上各危樯，心逐君归到故乡。\n回首苍茫空鹤望，乱山萦绕似羊肠。\n评文酷爱胸襟远，坐邑还忧事业荒。\n忽得新篇开鄙塞，甚于潍水决沙囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46134,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"钧爱亭","author":"韦骧","text":"簿领支离每竞辰，退思当亦在吾民。\n抑扶为术如偏取，字养存心固一均。\n杖履数来消径藓，笙歌久阕聚梁尘。\n天公岂复遗疏拙，风月随时不负人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46135,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"内乐亭","author":"韦骧","text":"谁谓兹亭浪得名，寥寥气象副深诚。\n地饶松竹千年色，天与云山四合清。\n靖节固尝为傲吏，子真元不势名卿。\n伊余窃慕恬然乐，肯以纷华战性情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46136,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"凌翠阁 其一","author":"韦骧","text":"凌翠阁，翠光寒不落。\n公事馀閒日日来，檐前好鸟无惊作。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46137,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]