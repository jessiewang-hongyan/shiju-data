[{"title":"冬日山居好十首 其六","author":"舒岳祥","text":"冬日山居好，农人告岁功。\n明朝输井税，深夜动机舂。\n木脱见山市，霜清闻涧钟。\n倘无饥冻迫，何必羡侯封。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2946,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"冬日山居好十首 其五","author":"舒岳祥","text":"冬日山居好，尤于老叟便。\n年衰催酿酒，骨冷早装绵。\n著帽来梅下，扶舆到雪边。\n兴来聊复尔，微倦自高眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2947,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"冬日山居好十首 其四","author":"舒岳祥","text":"冬日山居好，幽斋羃纸窗。\n温存檐鹊并，暖热竹鸠双。\n鹿下霜封堑，樵归雪印矼。\n从兹谢城府，吾志鹿门庞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2948,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"冬日山居好十首 其三","author":"舒岳祥","text":"冬日山居好，随家丰俭宜。\n果成猿种核，薪落鹤巢枝。\n梅见天机早，菊知霜信迟。\n读书年少事，任汝眼昏眵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2949,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"冬日山居好十首 其二","author":"舒岳祥","text":"冬日山居好，谁能倚市门。\n从横鸦出郭，寂寞鹳归村。\n为念曲肱乐，因耽曝背温。\n此时新放饮，招我苦吟魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2950,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"冬日山居好十首 其一","author":"舒岳祥","text":"冬日山居好，茅茨不漏风。\n山厨蒸芋栗，野径扫风蓬。\n嫩酒篘初白，寒灰拨暂红。\n编氓吾未免，杜老屡囊空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2951,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"冬日过良坑冈东望沧海隐隐见渔村有感时避地者多浮海云","author":"舒岳祥","text":"平陆人烟险，渔舟家口肥。\n青天围箬笠，白雨浣蓑衣。\n静钓鸥分石，寒归雪满扉。\n磻溪有恨事，严濑本忘机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2952,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"去年大兵入台仙居幸免今冬屠掠无噍类衣冠妇女相随俱北闻而伤之作俘妇词","author":"舒岳祥","text":"初谓无兵祸，那知酷至斯。\n相看不敢哭，有死未知期。\n儿向草间没，夫随剑口离。\n琵琶犹带怨，况是作俘累。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2953,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"去春帅初尝约为榆林游欲烹羊酿酒为小孟尝既而仆归凤栖后帅初亦往西浙遂不果今帅初已归当践前言但同游之客达善已下世矣因黄甘便作诗以叙其怀","author":"舒岳祥","text":"戴子游西浙，藕花香满船。\n因思今日日，又是去年年。\n杨果珍闽荔，榆林下剡川。\n烹羊曾有约，已失碧桃仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2954,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"古渔父词二首 其二","author":"舒岳祥","text":"是店皆赊酒，无家只有船。\n烧鱼岩下火，吹笛水中天。\n枫叶霜铺地，芦花月满川。\n风波何处静，收钓即安眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2955,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"古渔父词二首 其一","author":"舒岳祥","text":"烟雨一叶小，江湖大厦宽。\n全家足风月，高枕恣波澜。\n白雪披蓑立，青山揭笠看。\n莫将文叔事，溷我钓鱼竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2956,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"四月一日霖潦新霁痼疾稍瘳乍归故园拂剔丛莽","author":"舒岳祥","text":"衰翁病起头初裹，拄杖穿林探笋生。\n悄悄菰蒲看鸟下，疏疏杨柳见人行。\n一春长雨花全瘦，半日佳晴蝶便轻。\n小立绿阴青子下，秾华洗尽总幽情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2957,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"四月二十四日雨中分酒饷山友","author":"舒岳祥","text":"欲言林下趣，思共涧边行。\n细雨枇杷熟，空江杜若生。\n离居非远道，向夕自含情。\n偶此开松酒，分将一榼倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2958,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"四月初四日正仲子堂可大及梅所周鍊师会耕养堂","author":"舒岳祥","text":"白月一家好，青山四坐迎。\n短筇看虎迹，高枕听蛙声。\n草具枇杷足，瓜庐熠耀行。\n相逢总佳士，更喜著弥明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2959,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"对红药有感","author":"舒岳祥","text":"牡丹过后卖芍药，清晓天街频叫时。\n传世园林莺自占，有名花草蝶先知。\n百年富贵一场梦，千古英雄几局棋。\n世上兴亡总如此，我今叹老复嗟衰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2960,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"帅初屡书有相访之约且求予文集知予有藏山之志也近因弥大过我知其有来日矣作此寄之","author":"舒岳祥","text":"流水不还剡，落花终到鄞。\n偶逢归峡客，乃是寄书人。\n古刹藏山志，他生结愿因。\n烦君同校正，字字莫留尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2961,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"归故园 其二","author":"舒岳祥","text":"辟兵辟寇走他方，六遍移家路转长。\n百醉与君同出处，五穷随我共行藏。\n柳花暗度谁家竹，燕子寒归何处梁。\n最羡刘家好男女，稳抛家事客原尝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2962,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"归故园 其一","author":"舒岳祥","text":"千家桑梓兵馀痛，十世松楸火后悲。\n瓦砾成滩无鸟雀，荆蒿如杖有狐狸。\n咸平树在枝柯损，晚易书亡目录遗。\n半树瑶花微雨里，向谁寂寞泪将垂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2963,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"正月十日新晴观正仲所写篆畦藁","author":"舒岳祥","text":"乱离又活十年身，帝闵吾徒已甚仁。\n近厚施为回世运，至和涵养合天真。\n花间醉客能骑马，柳外鸣禽似唤人。\n酬唱小编情性好，伊祁留得一分春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2964,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"正仲入鄞叙怀送别二首 其一","author":"舒岳祥","text":"遇事无心心自放，如今心事放尤难。\n酒开愁绪汤浇雪，书润枯肠火养丹。\n攲枕啼鸦分晓色，把杯归雁破春寒。\n君来访我连朝雨，三日新晴理去鞍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2965,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"正仲有诗因次和再别","author":"舒岳祥","text":"好客分明为我来，不嫌茅舍似鸡栖。\n归云古树如新画，久雨苍崖失旧题。\n别我此行正月尽，怀君老眼两行啼。\n丈夫出处有常度，不为黄金颜色低。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2966,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"正仲访余棠溪帅初来会正仲时余欲归阆风未能决书呈三友","author":"舒岳祥","text":"晴云高举雪云低，日日占天候不齐。\n菘白僵成茭白笋，麦黄淹作韭黄齑。\n江湖吐日鼋晞甲，山路成泥兽印蹄。\n老去欲休官不许，夜来魂梦旧山溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2967,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"正仲过凤栖临行赠别","author":"舒岳祥","text":"甲子春晴好，凤栖理去鞍。\n江湖一叶小，风雨对床寒。\n鼻鼾声何壮，灯花夜未阑。\n纷纷多盗日，吾党敢求安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2968,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"正仲过我一宿蓐食而行叙怀追饯之","author":"舒岳祥","text":"又见王师下海夷，书生笔砚自非宜。\n风尘宇内成百战，花坞山中自四时。\n故旧凋零今已矣，江山寂寞子何之。\n篮舆载雨匆匆去，一饭无因话别离。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2969,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"正仲思归作篆畦今夜月十诗非篆畦月乃雁苍月盖杜子美鄜州月之意也予作十章乃篆畦月也 其一","author":"舒岳祥","text":"篆畦今夜月，先暝启黄昏。\n狐叫青峰径，僧归白石源。\n分灯三户市，打鼓七郎村。\n莫管啼乌绕，吾今已断魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2970,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"正仲思归作篆畦今夜月十诗非篆畦月乃雁苍月盖杜子美鄜州月之意也予作十章乃篆畦月也 其七","author":"舒岳祥","text":"篆畦今夜月，尊酒共论文。\n冻茁沙中笋，冰芽涧底芹。\n人生半歌哭，世事异传闻。\n风宪分流品，儒生免出军。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2971,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"正仲思归作篆畦今夜月十诗非篆畦月乃雁苍月盖杜子美鄜州月之意也予作十章乃篆畦月也 其六","author":"舒岳祥","text":"篆畦今夜月，初出五更头。\n清旭辉相映，馀光淡未收。\n烟消江树出，霞弄市岚浮。\n忆昔趋丹陛，鸡人唱晓筹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2972,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"正仲思归作篆畦今夜月十诗非篆畦月乃雁苍月盖杜子美鄜州月之意也予作十章乃篆畦月也 其八","author":"舒岳祥","text":"篆畦今夜月，政自使人怜。\n久废登山屐，愁催下濑船。\n衰年免黄帽，旧习守青毡。\n东浙承平地，如今是近边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2973,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"正仲思归作篆畦今夜月十诗非篆畦月乃雁苍月盖杜子美鄜州月之意也予作十章乃篆畦月也 其九","author":"舒岳祥","text":"篆畦今夜月，特地向人明。\n海驿催传箭，荒鸡误报更。\n平生大敌勇，末暮小诗行。\n老矣今安用，深杯送此生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2974,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"正仲思归作篆畦今夜月十诗非篆畦月乃雁苍月盖杜子美鄜州月之意也予作十章乃篆畦月也 其五","author":"舒岳祥","text":"篆畦今夜月，绝妙四更残。\n攲枕清无寐，推窗独起看。\n流鸿曳稀宿，跃鲤散微澜。\n颇记倦游日，孤舟宿雪滩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2975,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"正仲思归作篆畦今夜月十诗非篆畦月乃雁苍月盖杜子美鄜州月之意也予作十章乃篆畦月也 其二","author":"舒岳祥","text":"篆畦今夜月，涌海出初更。\n溪寺鸣钟罢，山城禁火明。\n梅光初点滴，鹤睡自凄清。\n还念故人远，灯花结未成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2976,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"正仲思归作篆畦今夜月十诗非篆畦月乃雁苍月盖杜子美鄜州月之意也予作十章乃篆畦月也 其三","author":"舒岳祥","text":"篆畦今夜月，出峤二更初。\n蓐食催鸣碓，蒙头静著书。\n清霜闻吠犬，细火有归渔。\n一盏解寒酒，风炉煮雪蔬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2977,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"正仲思归作篆畦今夜月十诗非篆畦月乃雁苍月盖杜子美鄜州月之意也予作十章乃篆畦月也 其四","author":"舒岳祥","text":"篆畦今夜月，有待到三更。\n水鸟隔烟叫，山樵踏雪行。\n诗成嫌烛短，酒渴爱菹清。\n此际谁为伴，梅边送影横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2978,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"玉毬花","author":"舒岳祥","text":"花开压径枝堪挽，花落铺阶雪不飘。\n茧老蛾成投绿水，香乾蝶散离长条。\n满地月明浓不扫，无人梅落怨难销。\n老人别有心中事，愧尔投瓜乏报瑶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2979,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"用韵寄胡元鲁因梅所袖达","author":"舒岳祥","text":"宾鸿风逆断来縢，鱼腹书沉未上罾。\n镊白秋风鍊药院，研朱仙露读书灯。\n青峰极目先榆景，黄鸟收声有木冰。\n欲问都城初破事，愿君秉笔直无朋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2980,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"田舍偶忆菖蒲","author":"舒岳祥","text":"山窗偶闲静，无事忆菖蒲。\n怪石磨剑脊，西风拂虎须。\n性贞偏爱洁，节劲固应癯。\n何日新书室，清泉手自?。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2981,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"田家纪事","author":"舒岳祥","text":"濛濛土雾连三日，父老传经十七年。\n蚕月人家多忌讳，麦秋时候好安眠。\n桑鸠逐妇应嫌雨，社燕依人不避烟。\n短策绿阴新似沃，顷筐朱实写来圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2982,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"田家即事","author":"舒岳祥","text":"饱暖无他事，天心亦易回。\n缫车翻急瀑，麦磨响轻雷。\n履辟行泥笋，衣蒸过雨梅。\n荒村断鱼肉，随兴酌山杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2983,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"甲申正月二十日游盘谷道院赠石涧鍊师","author":"舒岳祥","text":"沧海连云族，青山远驿尘。\n回旋成小隐，想像著幽人。\n桃树偏临水，梅花讳说春。\n扶舆穿荦确，空翠湿衣巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2984,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"白发","author":"舒岳祥","text":"新发从渠白，旧颜疑我非。\n莫嫌冠易堕，且喜虱无依。\n镜里星星出，梳来日日稀。\n长惭老松树，翠鬣沐烟霏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2985,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"石上种剑蒲其脊成矣非陶隐居所谓溪荪者耶","author":"舒岳祥","text":"昆山片玉天生润，雁荡移来手自栽。\n禅客久亲清少病，山童勤拂净无埃。\n叶端洒洒通心露，根畔疏疏引水苔。\n必有事焉还勿助，此方端自养原来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2986,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"石莲花","author":"舒岳祥","text":"石上原无藕，林间自有莲。\n开花高似雪，垂实软如绵。\n不入江妃笑，祇令山鬼怜。\n芙蓉生木末，可證楚人篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2987,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"记梦 其二","author":"舒岳祥","text":"梅花清入梦，诗骨定非常。\n半树原遮藓，无风也自香。\n篮舆冲暮雪，茅舍带晨霜。\n傍竹依松处，无心肯向阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2988,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"会计家酿得十石日饮三升可周一岁是日一饮成醉","author":"舒岳祥","text":"朱朱石榴树，白白水栀花。\n振鹭青溪客，迁莺碧柳家。\n衰年新旅食，小雨梦京华。\n贫有杯中物，宾来未用赊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2989,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再次韵酬正仲","author":"舒岳祥","text":"好翁须好客，相映柳和花。\n自是曹刘匹，非分唐宋家。\n书空因学草，品水为知茶。\n爱酒欣逢伴，临风醉墨斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2990,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和前韵答达善季辩 其二","author":"舒岳祥","text":"北固漫誇城立铁，钱塘休说浪翻银。\n江山不改英雄泯，宇宙无穷战伐新。\n过眼烟花空似锦，到头富贵总成尘。\n旧时都下逢除夕，果食花饧祭灶神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2991,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和前韵答达善季辩 其一","author":"舒岳祥","text":"屝屦送人征影远，布裘知我涕痕零。\n初愁冻雪无狐白，忽喜晴霄现卵青。\n欲向华山成稳睡，不禁楚泽自长醒。\n桃源自昔无秦历，草木荣枯是瑞蓂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2992,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再赠","author":"舒岳祥","text":"不惜此时别，毋忘别后音。\n相随溪上影，共息树边阴。\n水落行田蟹，霜晴出谷禽。\n何须拘改岁，有兴即相寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2993,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同正仲赋赪桐彩蝶","author":"舒岳祥","text":"守著赪桐不为香，翩如凤子往来忙。\n徘徊最爱真红色，摇曳偏垂五彩裳。\n宁号孟蝉随鬓袅，莫为鬼蝶幻身藏。\n惜花却似诗人性，日舞中间夜宿房。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2994,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"安住寺松声","author":"舒岳祥","text":"晴日千竿籁，春风万鼓鼙。\n清和兼怨适，细大杂高低。\n释子聆眠石，行人听过溪。\n曾于天竺寺，为尔驻游藜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2995,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"岁莫送正仲还雁苍","author":"舒岳祥","text":"岁穷终有别，人老得无愁。\n眼看书先废，材衰句懒酬。\n计年知晚易，论学愧东丘。\n欲就宁川志，开春与子谋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2996,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"岁晚寄帅初","author":"舒岳祥","text":"车鱼鄮城馆，书画剡溪船。\n饭颗诗应瘦，灯花人未眠。\n空林带冰月，老屋架霜烟。\n寂寞凰栖叟，思君又一年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2997,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戏作","author":"舒岳祥","text":"莫笑山居僻，山居号令明。\n芭蕉工报雨，鸲鹆解知更。\n樵长专封拜，诗坛拥甲兵。\n开窗一壶酒，新句赏新晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2998,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戏述任翻诗句酬储梅癯见和之作","author":"舒岳祥","text":"我爱巾山去复回，城中平地起崔嵬。\n前村清景何人占，绝顶新凉几夜来。\n鹤起露翻松磴响，僧吟月上竹房开。\n任翻鍊得清新字，想见斯人百念灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2999,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戏赠牛女","author":"舒岳祥","text":"掷果久怜潘岳好，投梭不放幼舆痴。\n彩云似扇羞郎面，新月如弓学妇眉。\n喜鹊成桥终有别，阳乌出海且教迟。\n如何自古占天者，不说经躔有动移。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3000,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戏赠陈用之羡渠食笋也","author":"舒岳祥","text":"食笋肥胜肉，胸吞千亩宽。\n汗青终日对，水墨一窗寒。\n吾子风流甚，此君冰雪完。\n每思参玉版，莫作北伧看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3001,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"收心","author":"舒岳祥","text":"山寒猿梦断，地远雁魂归。\n猎火云中树，渔榔月下矶。\n官梅撩技痒，池草见天机。\n百岁风前烛，收心坐翠微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3002,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"早凉出邑","author":"舒岳祥","text":"暑浊难为酒，秋清易得诗。\n出门残月在，骑马晓风吹。\n山厂藤萝构，荒园枳棘篱。\n新条闻快活，归路不妨迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3003,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"有田妇献水麦甚美不知滹沱玉食曾有此否感怅作诗","author":"舒岳祥","text":"牟麦未全黄，和灰熟煮香。\n嚼来冰响齿，咽下露生吭。\n肉似鸡头韧，形疑鲎子长。\n食芹应配美，吾欲献君王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3004,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"有怀正仲还雁峰诗","author":"舒岳祥","text":"松声夜半如倾瀑，忆坐西斋共不眠。\n一鼓轻雷惊蛰后，细筛微雨落梅天。\n临流欲渡还休笑，送客归来始惘然。\n掩卷有谁知此意，一窗新绿待啼鹃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3005,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"有怀寄二林","author":"舒岳祥","text":"去矣两黄鹄，归与一老翁。\n秋虫阴雨里，夕鸟水云中。\n今古唯愁在，乾坤总幻空。\n诗成无寄处，沙上伫来鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3006,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"有怀寄正仲","author":"舒岳祥","text":"往事沄沄逝，新愁衮衮生。\n风来看木末，月上候潮声。\n偶鸟分枝泊，邻蛩护穴鸣。\n洗忧思学易，闻尔著书成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3007,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"有感","author":"舒岳祥","text":"风雨翛翛花事阑，馀寒迤逦麦秋天。\n一春不见飞蝴蝶，几夜初闻叫杜鹃。\n林外画眉谁妩媚，花间绣眼自便翾。\n上林还有嘤鸣否，此日春归一黯然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3008,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次正仲访山中留别韵","author":"舒岳祥","text":"及此真知老，吾初不谓然。\n相期无别事，不朽要千年。\n过我论新句，留君订旧篇。\n胡为趋归骑，忙似趁潮船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3009,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]