[{"title":"应禅人出丐求颂","author":"释正觉","text":"应身随处见尘尘，能顺因缘不背真。\n树上虎头呈伎俩，毛端师子显精神。\n平生自许得游刃，投老难传知斲轮。\n香气满城燂钵饭，丛林一洗浩然春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9972,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"怀上人出丐求颂","author":"释正觉","text":"胡床拥毳怯春寒，怀丐人行野雪乾。\n风信入华披锦段，月魂堕水濯金盘。\n净名取饭亡多力，慈氏开门只一弹。\n妙得其中佛受用，头头成见不相瞒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9973,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"投食山家","author":"释正觉","text":"霜晨藜杖起孤禅，乞食山家图省缘。\n斜径顺风鸣竹火，飞甍迷眼映松烟。\n秋羹木鳖有真味，午饭树鸡无俗膻。\n谁谓客床卧不稳，我无支遁买山钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9974,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"折桂章首座近自双泉来因作句与之","author":"释正觉","text":"家林稳卧一巢云，厌作梁家庵底宾。\n折桂手舒寒触月，衔珠眼合梦游春。\n庭除不见雨华鸟，麋鹿能来呼谷神。\n五老芳邻归问讯，笑谈相对白头新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9975,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"拟石牛与悟上人","author":"释正觉","text":"阿牛纯热不鞭牵，卧向古源苍树边。\n春谷玉田看去种，雪山香草饱来眠。\n背头隆骨任丰载，鼻底流津大作川。\n异路行行哮吼处，莫忘露地未萌前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9976,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"时禅人出丐求颂","author":"释正觉","text":"老能碓下米无舂，一出相烦作变通。\n阵阵香风看稻熟，番番时雨见年丰。\n手携拍板傅大士，杖挂剪刀梁志公。\n妙应群机真绝待，秋清河淡月行空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9977,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"来上人干延寿院乞颂","author":"释正觉","text":"披蓁卜筑古林阿，百丈心于老病多。\n照彻有无方得我，缘分生灭不干他。\n谷云冷抱松根石，山月明悬屋角萝。\n若子殷勤圆此话，毗耶城里问维摩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9978,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"纯白禅人求颂","author":"释正觉","text":"明月芦华未得如，清光自照本来虚。\n十方坐断须拈帽，一色功圆要放锄。\n转背石人归位后，抬头玉马过关初。\n尘尘刹刹见身相，方信曹山井觑驴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9979,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"良禅人干田求颂","author":"释正觉","text":"良田一片望无涯，旷古相传佛祖家。\n四至町畦谁作伴，中心树子自开华。\n示人镰样秋云卷，催牯鞭声春日斜。\n收拾归来付耕事，衲僧气味较些些。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9980,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"还南麓旧居。","author":"释正觉","text":"枝藤结伴得游娱，怀习难宁寻旧居。\n云水梦思孤榻稳，山林眼味四窗虚。\n秋衣未絮怯繁雨，午饭无盐甘软蔬。\n老境端来偿底志，道同巢鸟与渊鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9981,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"周秀才出家求颂","author":"释正觉","text":"标心脱帽法丹霞，借力堂前刬草些。\n塞上不须嗟失马，杯中端欲断疑蛇。\n久怀甘露濯尘骨，将意丛林开觉华。\n古渡雪芦明月共，一壶秋色属吾家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9982,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和禅人发心丐开海田","author":"释正觉","text":"檀度夤缘约远寻，利他方称出家心。\n丐行端取丛林饱，耕缛不嫌泥水深。\n地面丕平春种玉，波痕清浅月浮金。\n栽田博饭吾家事，一段风规得老琛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9983,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宗禅人出丐求颂","author":"释正觉","text":"万指生涯一钵归，丛林宗尚默无机。\n道耕自信我寒槁，妙用相烦君发挥。\n薜荔藩篱秋蔓衍，女萝窗户月依稀。\n时时处处通消息，物象都卢入范围。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9984,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨夜宿龙门晓登灵光台礼佛眼塔","author":"释正觉","text":"一跃龙门适旧怀，棱棱浪级向人开。\n洗尘云阵浇华雨，借力天衢破蛰雷。\n略彴驾溪桃水满，浮屠瘗骨玉山颓。\n欲知佛眼无遮障，须到灵光不夜台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9985,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨晴偶作示禅者","author":"释正觉","text":"快雨快晴寒食近，峥嵘芳事趁佳辰。\n弄风柳絮疑成雪，满地榆钱买得春。\n雷吐英英茶爪露，暖班茁茁蕨拳伸。\n桃华眼闹随蝴蝶，谁似灵云识故人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9986,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"亮禅人持钵求颂","author":"释正觉","text":"家林一锡飞，炊处青烟微。\n严默起禅板，虚通转化机。\n溪寒秋染色，月冷夜流辉。\n莫学西山亮，此行宜早归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9987,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"保福传化士乞颂","author":"释正觉","text":"梅福仙游井汲枯，而今云水稳禅蒲。\n青原门下藏麟角，黄檗床头捋虎须。\n学子柏庭寒立雪，檀家饭甑软炊珠。\n乞归将意丛林煖，松食荷衣良槁癯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9988,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南麓新居","author":"释正觉","text":"山麓水滨竹木阴，我侬懒养静居深。\n一生自足淡中味，三际那收閒底心。\n壑云未成出岫意，松风能作下滩音。\n十分清兴与谁共，想有沃洲支道林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9989,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"显禅人求颂","author":"释正觉","text":"显处机须隐，忙时智自閒。\n泥牛初出海，玉马复临关。\n寒水澄涵月，流云静倚山。\n回途分化柄，不作旧家悭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9990,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"津禅人出化盏橐乞颂","author":"释正觉","text":"吃茶去语落诸方，聚首商量柄杷长。\n相席是渠能打令，同尘输尔解和光。\n舌头狤獠明无骨，鼻孔累垂暗有香。\n盏橐成来圆此话，侬家受用恰平常。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9991,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"珊知浴求颂","author":"释正觉","text":"妙触宣明不洗尘，楞严会上悟心人。\n潜鳞窟宅半篙水，枯木形骸一杓春。\n涓滴量同法界性，发毛垢净虚空身。\n南园应问聊弹指，用处绵绵谷有神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9992,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"荣上人发心知罗汉堂办茶油事乞颂","author":"释正觉","text":"这开梦觉底因缘，佛佛心同亡后先。\n一点灵明三世外，十分妙净万机前。\n琢磨自得丛林下，游戏何妨百草颠。\n尘刹纵横俱化事，起家人只奋空拳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9993,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"退天童上太守吴学士","author":"释正觉","text":"三椽五合不求馀，汩汩营营笑拙疏。\n妄立是非徒喻马，乐同彼此解观鱼。\n洗霜骨出山宜瘦，答响神藏谷应虚。\n莫涴人间名字垢，身云心月本如如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9994,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送广禅人","author":"释正觉","text":"温风促客下云岭，触处无心即道游。\n得坐会当明变豹，出门须解倒骑牛。\n冲烟筇入青萝径，载月船回白鸟洲。\n中外夷犹功迹绝，㳷然天水一成秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9995,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送从上人驰书至京西","author":"释正觉","text":"衲帔蒙头自照人，月明堂上转机轮。\n肯传千里鹡鸰语，要作十分棠棣春。\n雪岭同风当日事，石头束篾旧时麟。\n家林归卧长连稳，满眼清光不见身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9996,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送元上人过长芦","author":"释正觉","text":"阿祖江滨插苇枝，丛林蕃茂果臻斯。\n师门昆仲知名旧，缘法东西得面迟。\n沙上盟寒鸥怪晚，屋头字草雁来时。\n月明古渡清铺练，千里同风不隔丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9997,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送仝座主归上党 其一","author":"释正觉","text":"月兔含清欲喷霜，客怀陈习作归翔。\n虽云扫尽名言垢，我笑熏成知见香。\n聚石为徒头易点，悟空能讲义难量。\n到家握麈随宜说，莫对馀机挥界方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9998,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送仝座主归上党 其二","author":"释正觉","text":"觉海长鲸作蜕翔，青天端以背磨光。\n胸中浩浩吞云梦，眉际津津秀太行。\n静榻每来成友语，孤筇它往咽人肠。\n后将访我先传雁，为薙别来三径荒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9999,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送仝座主归上党 其三","author":"释正觉","text":"夜明帘外月天霜，衲子还家机事忘。\n枯木吟云须内照，死蛇含毒更堤防。\n闻琴起舞饮光习，放镜迷头演若狂。\n好是重来斲蝇翼，祖师鼻孔要生光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10000,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送平禅人归鄂渚","author":"释正觉","text":"浮舟春水作归征，家有良田可饭羹。\n久客回翔云一点，旧巢卧看月三更。\n人猜我住尖头屋，尔去谁扶折脚铛。\n为问岩头穷鬼子，当时何似此时生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10001,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送修街坊出丐","author":"释正觉","text":"海上鳌峰裹绮霞，梅仙朋旧有生涯。\n清眠梦落三山月，和气吹成一县华。\n去驾风舟寻长者，来分甑饭入吾家。\n待君归扫馀疑膜，杯影垂弓不是蛇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10002,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送通禅者之襄阳","author":"释正觉","text":"疏巢凄冷卧西柯，梦觉归思遽许多。\n风雨江头乱雁字，家山坞外悬渔蓑。\n白杨村落庞居士，青石浮图蕴大哥。\n倦倚苍松坐凉夕，兔推明月下星河。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10003,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送缘上人持钵","author":"释正觉","text":"缘丐人间一锡飞，苍岩烟腻雪初晞。\n风丝未许闹禅眼，云锦将看落化机。\n自勉丛林供食钵，谁嫌尘土翳征衣。\n归来僧饱上方饭，相伴春山歌采薇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10004,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送嵩上人住庵 其三","author":"释正觉","text":"烧痕笋蕨富登春，谁解看承庵内人。\n天供异华功未尽，龙吟枯木病难泯。\n夜禅终作寒蝉蜕，昼卧何妨倦鸟伸。\n后日重来勘诸祖，阿谁钩上赤梢鳞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10005,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送嵩上人住庵 其二","author":"释正觉","text":"禅腹须来竹篾缠，好看水牯自耕田。\n布单不卖三千里，树耳谁疑二十年。\n一句合头尊旅会，十方坐断正偏圆。\n它时投杖来相访，且莫穷忙空竖拳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10006,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送僧归豫章省亲","author":"释正觉","text":"宾茧风枝梦不宁，夜堂思对老人星。\n一心归去事萱草，千里相求鸣鹡鸰。\n树树丹枫金堕叶，丛丛黄叶雪浮汀。\n西山秀骨濯秋雨，窗户卷帘分远青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10007,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"圆禅者求颂","author":"释正觉","text":"枯歇身心百不思，湛圆自照劫空时。\n妙明智鉴那留垢，虚廓灵机未度丝。\n的的髑髅看活眼，堂堂尘刹用閒眉。\n是须恁么承当去，鼻孔累垂识祖师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10008,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"恭鉴二禅人干浴镬求颂 其一","author":"释正觉","text":"大冶镕金入范看，不嫌口阔肚皮宽。\n得来妙触通身眼，净放光明赤肉团。\n衲子落成俱受赐，檀那相助许投干。\n底心试问楞严友，道契圆通只个般。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10009,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"恭鉴二禅人干浴镬求颂 其二","author":"释正觉","text":"范金为镬沸兰津，分付楞严会上宾。\n妙触宣明渠具眼，纤尘不受我通身。\n投谐冷暖浑忘水，迎合温和似得春。\n炉鞴相催成底器，量吞云梦可斯人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10010,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晖禅人丐盐求颂","author":"释正觉","text":"庐山淡薄已多时，谁与丛林洗败姿。\n为爱海冰资菜味，不嫌春雨破华枝。\n仙陀婆事行行辨，舜若多身处处宜。\n快意截流船到岸，江头风顺看樯旗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10011,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浮舟下淮访龟山禅师","author":"释正觉","text":"霜风猎猎扫平野，沙头蓁翳净如燖。\n淮津斜转龟山麓，云汉微分雁塔尖。\n篱落梅梢春点点，庭除松影月纤纤。\n禅家况是不羁友，问讯勤来想未嫌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10012,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浮舟之昌国谒韩克明知县","author":"释正觉","text":"南风帆腹饱，半夜渡沧津。\n鲸海漾新月，仙山寻故人。\n浪寒千里雪，烟暖十洲春。\n来就昌黎语，良惭我效颦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10013,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"海上人知浴求颂","author":"释正觉","text":"温温气象半篙津，匏杓调和冷煖匀。\n直得通身浑是水，端知赤肉了无尘。\n风埃面目揩磨净，丘壑形骸洗濯春。\n妙触宣明佛子住，首楞严会有斯人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10014,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"称上人干造延寿院乞颂","author":"释正觉","text":"丛林百丈有清规，特设堂安老病师。\n隐几虚心还自照，炷香孤坐绝他思。\n妙穷正念空三世，净洗馀昏月一墀。\n底意欲从何处问，毗耶居士饱相知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10015,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"航海之宝陀访真歇师兄 其二","author":"释正觉","text":"得得来寻真歇兄，孤舟扬楫顺潮行。\n重联断雁云中字，远赴閒鸥沙上盟。\n新味清油燣紫菜，古方淳蜜渍黄菁。\n海山只个供盘箸，一段家风不世情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10016,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"航海之宝陀访真歇师兄 其一","author":"释正觉","text":"至人亲见古观音，化迹今居海上岑。\n烟机外分青嶂骨，水天中见白云心。\n潮痕拥岸棱棱雪，月魄浮波烂烂金。\n根境一如能所断，圆通游践法门深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10017,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百则 其六十二","author":"释正觉","text":"第二头分悟破迷，快须攃手舍筌蹄。\n功兮未尽成骈拇，智也难知觉噬脐。\n兔老冰盘秋露泣，乌寒玉树晓风凄。\n持来大仰辨真假，痕玷浑无贵白圭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10018,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百则 其九十二","author":"释正觉","text":"收尽馀怀厌事华，归来何所是生涯。\n烂柯樵子疑无路，挂树壶公妙有家。\n夜水金波浮桂影，秋风雪阵拥芦花。\n寒鱼著底不吞饵，兴尽清歌却转槎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10019,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百则 其九十一","author":"释正觉","text":"照彻离微造化根，纷纭出没见其门。\n游神劫外问何有，著眼身前知妙存。\n虎啸萧萧岩吹作，龙吟冉冉洞云昏。\n南泉点破时人梦，要识堂堂补处尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10020,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百则 其十一","author":"释正觉","text":"森罗万象许峥嵘，透脱无方碍眼睛。\n扫彼门庭谁有力，隐人胸次自成情。\n船横野渡涵秋碧，棹入芦花照雪明。\n串锦老渔怀就市，飘飘一叶浪头行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10021,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百则 其二十","author":"释正觉","text":"而今参饱似当时，脱尽廉纤到不知。\n任短任长休剪缀，随高随下自平持。\n家门丰俭临时用，田地优游信步移。\n三十年前行脚事，分明辜负一双眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10022,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈十首 其九","author":"释正觉","text":"一段光明亘古今，有无照破脱情尘。\n当头触著弥天过，退步承当特地新。\n紫极宫中鸟抱卵，银河浪里兔推轮。\n是须妙手携来用，百亿分身处处真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10023,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十八首 其五十五","author":"释正觉","text":"玉线金针相续难，劫壶空处妙投关。\n香林烟暖风排雪，月窟冰寒影转山。\n里许借功方得活，那时退位不知闲。\n宗家密密绵绵事，布施多人莫要悭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10024,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十八首 其八十","author":"释正觉","text":"一亘清虚衲子家，十方三世个生涯。\n光明照夜触髅眼，消息含春枯木花。\n晓色依依云冉冉，天容淡淡月斜斜。\n母陀罗臂通身是，今日逢场便攃沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10025,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十八首 其七十二","author":"释正觉","text":"髑髅前有本来灵，照彻毗卢顶?平。\n玉马过关方半夜，木鸡唤月恰三更。\n寥寥迹绝全功转，历历光生借位明。\n却著弊衣垂化手，合同船子顺流行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10026,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十八首 其三十八","author":"释正觉","text":"去时不出户，来时不入门。\n清癯山有骨，闲澹云无根。\n归家奉祖祢，了事还儿孙。\n云水通方士，相期报佛恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10027,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十八首 其六十七","author":"释正觉","text":"吾家种草古今难，针鼻才分度线端。\n混处相期君把手，到时不与汝同盘。\n却来大用纵横是，向去全功转侧看。\n底事要凭师印可，轮回生死不相干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10028,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十八首 其五十二","author":"释正觉","text":"空劫有真宗，声前问己躬。\n赤穷新活计，清白旧家风。\n的的三乘外，寥寥一印中。\n却来行异类，万派自朝东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10029,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十八首 其五十","author":"释正觉","text":"祇个是家风，明明入混融。\n江光芦映月，夜色水吞空。\n攃手悬崖下，分身万像中。\n回涂登鸟道，恰恰是神通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10030,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十八首 其三十","author":"释正觉","text":"不可以色见，不可以声求。\n风定花犹落，鸟啼山更幽。\n四衢明自晓，六户冷如秋。\n再坐不疑处，杯中弓影浮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10031,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其四十三","author":"释正觉","text":"朔风拂旦吹秋过，时节薄寒宜就火。\n拱默威音世外游，放闲枯木堂中坐。\n尘劫空时却有家，道环虚处元无我。\n灵灵不昧寂而知，衣钵少林分付可。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10032,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其六十九","author":"释正觉","text":"密密住其中，灵然空不空。\n一牛才饮水，五马不嘶风。\n位里亡消息，机头有变通。\n三千大千事，弹指入圆融。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10033,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其十二","author":"释正觉","text":"万里西来坐少林，灯灯相续至如今。\n泥牛斗里同归海，玉线联时妙契针。\n未坠绵绵吾祖绪，不忘切切老婆心。\n风前一弄无弦曲，会有丛林人赏音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10034,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其八","author":"释正觉","text":"孤筇长作水云游，底事而今放下休。\n一点破幽明历历，十分合体冷湫湫。\n暗中须透金针穴，转处还藏玉线头。\n劫外家风兹日辨，渠侬真与我侬俦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10035,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]