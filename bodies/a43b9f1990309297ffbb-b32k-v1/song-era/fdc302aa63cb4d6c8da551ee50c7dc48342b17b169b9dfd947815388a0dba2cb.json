ance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46110,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赐苏易简 其一","author":"赵炅","text":"翰林承旨贵，清净玉堂中。\n应用咸依式，深严比更崇。\n归家思值日，入内集英风。\n儒措门生盛，高明大化雄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46111,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赐苏易简 其二","author":"赵炅","text":"运偶昌时远更深，果然谷在我中心。\n从风臣偃光朝野，此日清华见翰林。\n举措乐时周礼法，思贤教古善规箴。\n少年学士文明世，一守贤毫数万寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46112,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其一","author":"赵炅","text":"人救眼前急，何曾利益心。\n愚迷终浅见，达者智高深。\n苦行须知应，馀忧力不任。\n经书无限意，稽古便同今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46113,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"回文偈二首 其一","author":"赵炅","text":"教训大宽深，古羡协真齐。\n要运解观心，苦善业因迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46114,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"回文偈四首 其三","author":"赵炅","text":"解垂要理真，诠羡非深意。\n大谁教指因，缘善归心会。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46115,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"佛牙赞","author":"赵炅","text":"功成积劫印文端，不是南山得恐难。\n眼睹数重金色润，手擎一片玉光寒。\n鍊时百火精神透，藏处千年瑩采完。\n定果熏修真秘密，正心莫作等闲看。","collection