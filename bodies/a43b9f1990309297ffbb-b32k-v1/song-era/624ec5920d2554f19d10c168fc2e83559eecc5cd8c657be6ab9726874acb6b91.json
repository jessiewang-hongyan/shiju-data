[{"title":"九日与一飞诸友饮菊","author":"李石","text":"五年去国若为欢，九日逢秋强自宽。\n树搅冰霜惊岁晚，山围雾雨试朝寒。\n不关鸟帽随风落，只把红萸对俗看。\n惟有东湖无可遣，一杯香泛落英餐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59199,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九日类试院雨中制司送酒关子二首 其二","author":"李石","text":"老去轻时节，忧来稔岁年。\n黄花关上戍，青草渡头船。\n望眼知谁属，归心只自怜。\n仅沾微禄在，未敢计良田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59200,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九日类试院雨中制司送酒关子二首 其一","author":"李石","text":"学省三年别，文闱九日同。\n登高迟曲糵，避湿到芎藭。\n田舍飘零后，江湖震荡中。\n忍将忧国泪，滴向菊花丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59201,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又送马氏兄弟归彭门","author":"李石","text":"山程趼足肯相从，未厌崎岖易道东。\n二马仙风还旧观，六鳌香饵看新功。\n北田夜诵披莲蕊，东阁春归折桂丛。\n努力锦衣双拜手，寿杯堂上雪髯翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59202,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山亭三首 其三","author":"李石","text":"小圃依山入，危亭隐磴斜。\n林塘扫寒雨，篱落卧疏花。\n处士七松宅，先生五柳家。\n柴门何所待，倚杖数昏鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59203,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山亭三首 其二","author":"李石","text":"人谁怜老子，我自类痴儿。\n爱草留荒径，疏泉入小池。\n春风随处是，晴日与花宜。\n好客能相贷，携锄出短篱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59204,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山亭三首 其一","author":"李石","text":"春日山亭饭，青枝古树阴。\n亲朋知老病，田舍岂初心。\n月白水泉瑩，花多烟雾深。\n酒边防恶俗，醉语费披寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59205,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五更一点月照窗几以为晓也披衣视之雪厚至尺许喜甚赋诗","author":"李石","text":"雪片成孤立，蟾华与共游。\n从教惊蜀犬，曾是喘吴牛。\n蹲石依松瘦，寒溪映竹流。\n遥知明岁稔，携酒上南楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59206,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"公实公衍伯仲相访云木犀再花香橘新摘也并以为惠且将以佳篇因次韵","author":"李石","text":"桂屏立壁杳难攀，画舫层层碧玉栏。\n未觉香风披蕊晚，向来白雪避花繁。\n秋深犀子仍奔殿，夜迥珠星得走盘。\n二妙沓来成伯仲，恨无琼玖出毫端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59207,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"双鹤","author":"李石","text":"积雨催寒早，江湖渺障川。\n黄花到十月，白发已三年。\n酒尽迟村饷，诗成得昼眠。\n低回看双鹤，铩翮欲摩天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59208,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"彭山县君居","author":"文同","text":"公馆静寥寥，园亭景物饶。\n溪光明短彴，树影荫危谯。\n山鸟忽双下，池鱼时一跳。\n主人王事简，文酒日逍遥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59209,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"天彭受代迁静正堂以代者未到漫兴二首 其二","author":"李石","text":"罢戍成迁次，投閒想故居。\n风霜欺老大，书信卜交疏。\n黄叶频供扫，青山炯自如。\n斯文身健在，归及岁之馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59210,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"天彭受代迁静正堂以代者未到漫兴二首 其一","author":"李石","text":"客宦去未得，山风来不迟。\n东湖霜后冷，北斗夜深移。\n老桧新翻叶，狂花故著枝。\n忧时恐无补，祇益鬓丝垂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59211,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"天彭得解","author":"李石","text":"一第枫宸岁月深，槐花杯酒喜同斟。\n真成冀北空群马，便作双南满地金。\n计上八人才子数，笔端四海状元心。\n蜀天九万看鹏运，侧耳潮头驾捷音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59212,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"方舟二首 其二","author":"李石","text":"物我相轩轾，乘除只自知。\n儿临池上字，母养镜中丝。\n竹静泉生乳，花深地产芝。\n旧时双燕子，来往亦仪仪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59213,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"方舟二首 其一","author":"李石","text":"颇笑方舟拙，聊因拙自誇。\n家无三日谷，园有四时花。\n池静鱼吞墨，松高鹤护砂。\n著书逢好处，快痒得仙爬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59214,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"东湖感事二首 其二","author":"李石","text":"一官职檄冷秋冰，尽日量书接夜灯。\n老去髭须无可染，秋来面目自生憎。\n湖通堰尾听泉激，日出山尖见雪层。\n结习未除江海客，不忘回首梦觚棱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59215,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"东湖感事二首 其一","author":"李石","text":"桃李洲中别一春，雪山肯为障红尘。\n鬼神半夜应怜我，魑魅今朝不喜人。\n烟雨晦明窗外眼，风霜来去树边身。\n细思只合归耕好，并舍何由笑我贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59216,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"古柏二首 其二","author":"李石","text":"思人谁复念婆娑，窟室崖阴未易磨。\n四十围间看溜雨，三千年后数恒河。\n不堪与世供狙杙，尚许遗民占鸟窠。\n从此便名夫子树，匡人斤斧奈予何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59217,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"古柏二首 其一","author":"李石","text":"骄荣落尽雪霜浮，偃蹇空贻社栎羞。\n濡染东家虽借润，风烟西爽亦宜秋。\n皮灾已觉神明露，心在犹怀剪伐忧。\n铁锁何当绊龙脚，夜深雷雨捲潭湫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59218,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"市进马寒甚","author":"李石","text":"边云寒色与愁浓，酒味何由入颊红。\n眼看飞鸢来堕水，心随去骑欲追风。\n亲朋立望千山外，笑语殊思一饷同。\n问舍求田吾已决，不于湖海较穷通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59219,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用之相访忽忆汉孙不得一脉以死用前韵","author":"李石","text":"叩门剥啄涕沾襟，忽忆僧孙病骨侵。\n壁上卧龙香线断，柱间题凤墨痕深。\n仓皇不瞑思君眼，辗转犹希住世心。\n真意自天渠信否，赠篇聊当阁中箴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59220,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"石蒙恩召还以病留滞度岁赋此诗道别呈诸同官","author":"李石","text":"三驰旌聘合翻然，万里君恩荷记怜。\n肯许老饕同守岁，且因春酒介新年。\n风传鹢首五湖浪，雪涨蟆颐一脉泉。\n他日堂中元祐脚，只堪诵说学苏仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59221,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"礼殿","author":"李石","text":"雨老苔荒墨色昏，汉人两序姓名存。\n六经丝竹升堂后，千古衣冠此地尊。\n但使高文无废祀，只今扬马未招魂。\n寥寥蜀学谁为倡，东去江流注海门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59222,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"边州警报","author":"李石","text":"翠围矗矗乱山稠，蜑雨蛮烟冻不收。\n赤白囊来逢此岁，青黄谷熟又深秋。\n一官忍耻随人后，数口全生敢自谋。\n虮虱有心空地上，苍生难答两宫忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59223,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再用九日韵答何邵卿二首 其二","author":"李石","text":"习气仍馀酒后狂，十年坐斥醉中乡。\n读书窗外千堆雪，利剑床头一匣霜。\n收拾微吟追李杜，研摩小楷逼苏黄。\n他文消遣随儿辈，颇笑翁痴作一囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59224,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再用九日韵答何邵卿二首 其一","author":"李石","text":"老蝶凌风作晚狂，小春争得媚寒乡。\n池边团碧擎残雨，林末轻红拒薄霜。\n笑我何时书竹帛，似君依旧踏槐黄。\n相寻一醉能来否，枉费公家压酒囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59225,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同王夔州探梅","author":"李石","text":"莫因红紫媚楼台，洁白光中处处栽。\n香骨未应春雪妒，素心偏向暖风开。\n清樽妙赏今谁健，晓角年光不用催。\n别后西归玉堂约，诗筒只有月边来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59226,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵冯涪州见寄","author":"李石","text":"寄语巴中客，频频镊鬓霜。\n峡云春梦远，江月夜珍藏。\n才刃应多暇，词锋恨太刚。\n僧邻雨花地，何日再升堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59227,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵李判官见赠","author":"李石","text":"须髯残雪兀陈编，炀者何由更避烟。\n荣宦君方收晚岁，论交我亦得忘年。\n佐州相与营杯水，有路从今出瓮天。\n一日尚能千里驾，此间老骥不须鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59228,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵谊夫九日忆去岁共游东林","author":"李石","text":"菜饱无期岁已侵，高谈何处著幽深。\n二年旅寄不堪说，九日盟寒那复寻。\n此地有时容醉玉，寒花无数吐秋金。\n与君成是无诗句，闻道西山似竹林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59229,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵贾文学见赠","author":"李石","text":"方舟不似逆风船，船上烧香稳坐禅。\n五鼓紞如随鸟动，一春老矣学蚕眠。\n黄梅半熟雨不止，白发也应天见怜。\n赖有比邻贾诗老，醉中相对耸诗肩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59230,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵喜雨","author":"李石","text":"云色垂轩泼墨深，夜闻萧瑟振枯林。\n自怜一榻清凉意，想见千畦餍饫心。\n共道苏天私此泽，后来商旱更谁霖。\n公归还记田田叶，坐看荷珠自劝斟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59231,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"羽扇亭","author":"李石","text":"十里山光绀碧围，瘴烟收尽溢春晖。\n黄紬睡美闻衙唱，白羽风高入指挥。\n楼角片云随雁去，溪头骤雨送龙归。\n君王若问安边策，苜蓿漫山战马肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59232,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"至喜亭","author":"李石","text":"归路巴人处处逢，巴人舟楫语音同。\n雪霜寒谷残年后，云雨阳台昨梦空。\n沙水清能延月白，峡林香欲试春红。\n饭山虽瘦无奇语，至喜亭中著醉翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59233,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟次湖口追忆任明府","author":"李石","text":"重来又十年，山水故凄然。\n独雁仍为旅，双凫已作仙。\n浊流分蜀派，青色聚淮烟。\n石上罾鱼者，犹言县令贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59234,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"访范师山房","author":"李石","text":"野步山围合，春生物自欣。\n溪声如听雨，松色欲摩云。\n谢客推门入，支郎半坐分。\n林间携小队，不敢散鸦群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59235,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"李新仲圭同游醮坛归以诗告别次韵","author":"李石","text":"别去名场叹滞留，肯来空谷话清幽。\n知君有约趋金马，笑我无心对白鸥。\n千顷量陂能却老，一编家学莫他求。\n相将杖履题诗处，跨鹿山头记旧游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59236,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"沉黎四首 其四","author":"李石","text":"九折山围市，双溪水浸田。\n号风吹客袖，落雪舞蛮毡。\n塞上寻归马，波间畏跕鸢。\n此生随所适，老去合乘边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59237,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"沉黎四首 其三","author":"李石","text":"古屋云栖洞，深湖水拍桥。\n吏閒知学稼，民乐自歌樵。\n官监频添牧，蕃商不费招。\n老夫便午睡，风恶任飘摇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59238,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"沉黎四首 其二","author":"李石","text":"蜀相披荒垒，唐人拓密林。\n四川襟带重，六诏雾云深。\n盐米成民业，珠犀作吏箴。\n官閒无一事，闭閤念亲心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59239,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"沉黎四首 其一","author":"李石","text":"民俗濒蛮诏，边城异土宜。\n竹筒连水脉，板屋怯风吹。\n药叟鸦随噪，樵童虎不窥。\n爱山来九折，人笑此翁痴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59240,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"远去亲侧浩然归心再用韵","author":"李石","text":"指点西来海上峰，此间魑魅我能逢。\n果何所补身先老，岂不怀归意已浓。\n骐骥群中怜短褐，龙蛇窟里倚长松。\n一堂四相经行处，洒扫云烟觅旧踪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59241,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"閒居二首 其二","author":"李石","text":"吠亩三番聘，林泉一客逋。\n君方借唇吻，我自惜头颅。\n日月松偕老，江湖橘可奴。\n昭文虽未鼓，洗耳即良图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59242,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"閒居二首 其一","author":"李石","text":"七岁投閒日，浑如未第初。\n牛衣困褴缕，鹤饭愧粗疏。\n圣有杯中露，朝无别后书。\n温寻皆旧学，风雨岁时馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59243,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"到沉黎举家瞆气上如聋者踰月乃愈医人云此瘴气也","author":"李石","text":"儋史之孙病耳翁，人佯谓我与真同。\n蚊飞鬓外年时事，鹊噪愁边晚更空。\n老去鹿皮终可隐，听如龙鼻反能聪。\n昭文不鼓非无意，勉为慈亲奏凯风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59244,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"到夔门呈王待制","author":"李石","text":"手挈东风上水关，凤书迎日看新班。\n五湖家世乌衣巷，三峡楼台赤甲山。\n画戟门开春昼永，卧龙帐稳海波閒。\n安危大计须公等，天定应知即赐环。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59245,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"周参政惠书唁及亡儿开二首 其二","author":"李石","text":"取士平轩鉴，吾儿死布衣。\n招魂荒草墓，冤鬼泣松扉。\n推挽无遗力，挤排已觉非。\n存亡佩陈谊，舍此更谁归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59246,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"周参政惠书唁及亡儿开二首 其一","author":"李石","text":"颡马非才具，蜗牛惜弊庐。\n岁时甘伏枕，风雨阻来车。\n药裹衣巾内，梅花酒盏疏。\n江湖慰寂寞，一纸故人书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59247,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和杨子土牛之什","author":"李石","text":"陌上花开又一春，起来酒伴觅南邻。\n烟霞笑我虽成疾，霜雪于君恐不仁。\n柏叶殊思金马旧，柳枝偏向土牛新。\n相忘已约形骸外，老守先能堕醉巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59248,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"拌毫笔","author":"李石","text":"管城无别派，毛族竞分支。\n公子兔三穴，大夫羊五皮。\n端能开句眼，未肯画愁眉。\n若问结绳祖，先从六画推。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59249,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"苦胃不出二首 其二","author":"李石","text":"鸣禽百啭柳三眠，窗户阴晴任雨烟。\n芍药樱桃春殿后，芎藭麦曲病争先。\n奉亲满眼欠一饱，去国忧心今五年。\n南北风尘江两岸，不妨明月钓鱼船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59250,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"苦胃不出二首 其一","author":"李石","text":"眇小酲醲总见欺，颠狂苦诉有谁知。\n五音莺自调歌舌，百药蜂能酿蜜脾。\n世态只堪春睡美，鬓丝偏与落花宜。\n欲因耆旧寻乡路，投劾翻然恐未迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59251,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金山驿","author":"李石","text":"晚泊金山驿，风生玉宇秋。\n荒苔蚀佳句，乔木惜名流。\n鼠穴飞泉入，蛛丝积雨收。\n何须叹人物，华屋与山丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59252,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"峡中","author":"李石","text":"峡水方中驻，归舟溯蜀门。\n竹枝声处处，梅蕊雪村村。\n来去山峦笑，啼号地主恩。\n幸然穷性命，不必赋招魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59253,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春水","author":"李石","text":"倚杖河边记水痕，眼明喜见白鸥群。\n雨声夜向九峰泻，江势朝来三堰分。\n窟宅蛟龙元自擅，邻家鸡犬要相闻。\n我师一饱关天意，收拾晴风放密云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59254,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"眉州鹿鸣宴 其二","author":"李石","text":"六六成鳞吹，呦呦赋鹿鸣。\n三仙随劝驾，千佛要题名。\n俎豆初筵秩，衣冠习俗荣。\n例须烦举送，我亦鲁诸生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59255,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"眉州鹿鸣宴 其一","author":"李石","text":"大比周三岁，登名蜀一涯。\n圣贤元祐学，父子老苏家。\n类省登槐市，清秋艳桂华。\n生平晁董业，亲策对褒嘉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59256,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋月","author":"李石","text":"望崖相送欲凌虚，未拟边州作陋居。\n法令牛毛纷可笑，使君马尾自能书。\n白云度岭愁方寸，黄瘴埋沙费扫除。\n列戟横琴果何择，一窗秋月竹疏疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59257,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送勾龙教授","author":"李石","text":"广汉川原迥，重江秋水多。\n桥边金作雁，湖上酒如鹅。\n岂有雒书出，转添巴字讹。\n泥涂滞行客，之子惜经过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59258,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送王应祥","author":"李石","text":"进取虽狂我不狂，跨鳌今日郑公乡。\n未偕西蜀三年计，来访东湖九月霜。\n桃李山城漫红白，橘橙峡路看青黄。\n修门万里逢严助，剩剖琅玕出锦囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59259,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送处道","author":"李石","text":"上马挑书束破裘，宦情薄处不宜秋。\n二年拄笏山虽好，十舍浣花江合流。\n此处移文寻旧社，尚因奇字忆方舟。\n西川傥有东来雁，莫道曾无截镫留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59260,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送牟尧文","author":"李石","text":"别久无辞道路难，敝裘依旧据征鞍。\n五湖我已遭风逆，三径君能犯雪寒。\n下榻莫嫌烹瓠叶，倚门正及颂椒盘。\n一杯少味仍相送，折得梅花带笑看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59261,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送苏汉杰","author":"李石","text":"万里来归道路长，两年身寄水云乡。\n仅馀文字缣缃富，犹带湖山草木香。\n从此定应悬箔去，卑之且说踏槐忙。\n逢君客地成乖隔，相送江干问草堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59262,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送周行可","author":"李石","text":"国风惆怅黍离离，只有周郎五字诗。\n得见大巫今索矣，可怜小子孰裁之。\n心如废井凭谁汲，语到修门未可期。\n此别更须留好句，梅花窗外见相思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59263,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送客","author":"李石","text":"送客川原路，怜渠田舍秋。\n沙晴分野径，林断出溪流。\n马瘦诸公后，鸱夷一醉谋。\n泮林无酒伴，颇为老兵留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59264,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]