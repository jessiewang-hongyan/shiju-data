[{"title":"言命","author":"释绍嵩","text":"宇宙双蓬鬓，升沉尽听他。\n僧居随处好，身事逐年多。\n异国逢佳节，流光等逝波。\n无谋长委命，言命欲如何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15945,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"走笔代颜西叔次途中即事之什","author":"释绍嵩","text":"逦迤前冈压后冈，鸟鸣山馆客思乡。\n孤村树色昏残雨，满耳蛙声正夕阳。\n对酒已成千里客，怀人空结九回肠。\n平生忧患谙偿遍，回避红尘是所长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15946,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"走笔酬黎德夫","author":"释绍嵩","text":"索寞门长掩，图书是旧贫。\n无因从发药，有命懒谋身。\n寥落悲前事，英雄叹后尘。\n裁诗托幽思，幽思忽相亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15947,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和自然","author":"释绍嵩","text":"南北三年一解携，曾书蕉叶寄新题。\n知渠已富江山句，英誉自成桃李蹊。\n坡底诗人梅底醉，云间秋雁水间栖。\n千岩万壑时相忆，迢递寻君梦不迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15948,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和自然","author":"释绍嵩","text":"客里唯君数往还，笑谈终日尽君欢。\n敢将古道为吾事，已作归心即自宽。\n露草欲随霜草尽，泉声长带佩声寒。\n月生更爱栏干影，未厌慇勤达曙看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15949,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和陈尧臣","author":"释绍嵩","text":"羡君潇洒有馀清，霜翮摩霄万里情。\n冰雪照人徐孺子，篇章高体谢宣城。\n摇窗竹色留僧语，步野风寒散酒酲。\n明日岳阳楼上去，不妨谈笑又诗成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15950,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和蒋自然","author":"释绍嵩","text":"岁月悠悠一梦中，荣枯消得几何功。\n宁为宇宙闲吟客，岂是江湖把钓翁。\n山口断云怜旧路，沙边微雨湿孤蓬。\n饭馀鼓腹聊行乐，立尽疏帘落絮风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15951,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和崇上人","author":"释绍嵩","text":"松下中峰路，疏阴偃盖清。\n远云收海雨，数雁过秋城。\n抚事心犹壮，卑栖气未平。\n近来唯此乐，高韵寄闲情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15952,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和曾俊臣","author":"释绍嵩","text":"沉醉无期即是乡，暂偷闲卧老僧床。\n纵游籍草花垂酒，陈迹题诗蜗篆梁。\n故国山川皆梦寐，天涯形貌各昂藏。\n芭蕉叶上三更雨，一阵疏来一阵狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15953,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜汎有怀","author":"释绍嵩","text":"独自上孤舟，通宵浪打头。\n天风随断柳，江月值新秋。\n忽忽忘年老，忙忙汎夕流。\n此生成底事，谁不遣吾休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15954,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜题","author":"释绍嵩","text":"满庭松桂雨馀天，病眼开时月正圆。\n罗列众星依木末，安排流水落檐前。\n倚松长啸宜疏拙，随处何妨且信缘。\n白发青灯两无语，瓣香深炷夜堂禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15955,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"定慧别业次韵陈子中","author":"释绍嵩","text":"地胜千山会，孤怀行转幽。\n归云带层巘，远岸送轻舟。\n绿树莺边合，清泉槛外流。\n雨馀情更逸，端为故人留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15956,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宝溪道中","author":"释绍嵩","text":"径直夫何细，云山知几重。\n朱门均白屋，红叶间青松。\n野火烧冈草，残阳下远峰。\n伤心绕村落，倦客独携筇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15957,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"绍兴即事","author":"释绍嵩","text":"柳色葱葱官渡平，梨花吹雪度清明。\n山从海岸装吟景，寺倚云峰更晚晴。\n潮水忽生添野水，春城何忍作空城。\n黄莺久住浑相识，故作林间求友声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15958,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"绍兴道中","author":"释绍嵩","text":"古岸侵烟出，沙冈拥地形。\n断桥人寂寂，竟日雨冥冥。\n丘壑胸中事，乾坤水上萍。\n诗成何用好，聊以记飘零。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15959,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"郊行","author":"释绍嵩","text":"桑柘晴川口，林深一径存。\n披云登断岭，隔水见前村。\n春去花无迹，崖倾洞有门。\n郊行聊著眼，疑是武陵源。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15960,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨罢","author":"释绍嵩","text":"雨罢春光润，云随落日移。\n莺花愁不觉，世路老方知。\n苔遍安禅石，根侵洗砚池。\n晚来风月好，倚杖独题诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15961,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"临川道中","author":"释绍嵩","text":"历历沿荒岸，初闻落日蝉。\n江花铺浅水，村馆复临川。\n径仄傍无地，峰回别有天。\n吾行吾自返，兹意与谁传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15962,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"临川道中怅然有感因作遣情","author":"释绍嵩","text":"路傍官河一带长，风帆沙鸟认微茫。\n人生行乐知能几，世事多虞只自伤。\n破衲卷云秋漠漠，淡烟斜日晚荒荒。\n不堪吟罢东回首，底处青山是故乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15963,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南山书怀","author":"释绍嵩","text":"日色今朝分外明，湖光浩气共澄清。\n鸟啼绿树穿花影，水泛青山入古城。\n眼下见荣还见辱，病中嫌雨又嫌晴。\n衰迟自喜添诗学，三十年来掉臂行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15964,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"客中戏书 其一","author":"释绍嵩","text":"杖屦千崖表，江山故作妍。\n扪萝怀鸟道，踏石过溪泉。\n野湿禾中露，秋明树外天。\n白头何所恨，随处一欣然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15965,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"客次感怀","author":"释绍嵩","text":"投老诗成癖，愁生为客途。\n烟云长在目，山水暂游吴。\n远意极千里，归心寄九衢。\n一身仍更病，意绪日荒芜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15966,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"客邸昼寝起而追程","author":"释绍嵩","text":"客里无聊久合并，梦回南北昧平生。\n苦吟风月唯添病，独冒烟岚促去程。\n城外诸峰迎落照，花边白犬吠流莺。\n阮途未用嗟漂泊，自有孤云识此情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15967,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"客夜偶成","author":"释绍嵩","text":"万里长为客，穷愁岂自宽。\n年衰发种种，幽集夜漫漫。\n风卷湖烟静，云收溪月寒。\n天涯少知遇，唯有醉江干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15968,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"客思","author":"释绍嵩","text":"欲暮多羁思，客行悲故乡。\n背关馀古木，落叶堕寒霜。\n驿树收残雨，柴门掩夕阳。\n此身南复北，双鬓易苍浪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15969,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"待舟西兴遣闷","author":"释绍嵩","text":"海涌银为郭，吴疆与越连。\n有山来枕上，无酒到愁边。\n烈烈寒风起，悠悠落日悬。\n孤舟未得济，少驻祖生鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15970,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春夜书怀","author":"释绍嵩","text":"海内艰难各饱更，鬓毛宁与化工争。\n春宵思极兰灯暗，晓角初吹客梦惊。\n壮思不逢韩吏部，绝交益愧孔方兄。\n到头诗卷须藏却，薄饭粗缯老此生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15971,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"独步","author":"释绍嵩","text":"独步时凝望，幽襟失所从。\n烟霞横眼界，天地醉心胸。\n泽国秋容老，人家水影重。\n行穷十里岭，回首兴何慵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15972,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"独游","author":"释绍嵩","text":"幽圃多清致，殊方此日欢。\n松风攲枕听，春草隔溪看。\n红入桃花嫩，青还玉宇宽。\n独游吾有意，终日凭栏干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15973,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋日湖上憩水仙祠","author":"释绍嵩","text":"万木已西风，千山景象通。\n岸拖秋草绿，日抹半山红。\n穴蚁苔痕静，诗人眼界空。\n水仙来往处，脉脉兴何穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15974,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋夜忆亲庭有感","author":"释绍嵩","text":"碧涧寒侵屋，高林露气清。\n空窗闲月色，密竹动秋声。\n宴坐游三昧，邻谈喧五更。\n两亲今正老，此别不胜情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15975,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贻康兼善","author":"释绍嵩","text":"遍绕篱边日渐斜，尽无鸡犬有鸣鸦。\n风凋古木秋阴薄，烟琐西山暝色赊。\n题柱未期归蜀国，系船长得傍芦花。\n云林好处欲留脚，要趁新诗挽物华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15976,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送别一西堂","author":"释绍嵩","text":"一老说淡话，志怀绝险艰。\n别离从阙下，游戏且人间。\n落羽羞言命，临岐强破颜。\n住山须鈯斧，此句急追还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15977,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送别永上人","author":"释绍嵩","text":"四海无拘系，飘然不可留。\n泄云分叠巘，落日满行舟。\n举世谋三窟，馀生老一丘。\n对床清约在，后会必经秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15978,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送别周上人","author":"释绍嵩","text":"此地是何乡，悬帆兴甚长。\n山光分首暮，草气入林香。\n断岭云归白，栖鸦噪日黄。\n他年重会面，玄鬓莫疑霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15979,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送客归戏书","author":"释绍嵩","text":"险尽途方坦，溪鸣锦幄傍。\n暝烟沉古道，幽草恋残阳。\n寂寂春将晚，迢迢日自长。\n东门因送客，行得汗如浆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15980,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送黎主簿","author":"释绍嵩","text":"及瓜一笑上浮艎，孤淡无君得趣长。\n秋月春花入牙颊，锦机绣段出肝肠。\n诗题寺壁云根润，江送蓬婆雪汁香。\n丞相旧知为学苦，回轩应问石渠郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15981,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重经故人旧居","author":"释绍嵩","text":"五字研成举世传，醉吟朝夕在樊川。\n江南海北三千里，雨散云飞二十年。\n壁上尘黏蒲叶扇，镜中人入洞庭烟。\n倦游客子心无际，遐想星轺思惘然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15982,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"哭黄少府","author":"释绍嵩","text":"大节群公倡，儒科慕冉颜。\n远分天子命，长觉吏徒闲。\n秋入篇章里，川行翰墨间。\n壑舟今已矣，老泪为渠潸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15983,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"振策","author":"释绍嵩","text":"振策出游眺，清吟竹影东。\n石门千仞断，秀水一篙通。\n郡阁烟光里，人家秋色中。\n乌衣多胜槩，老子柰途穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15984,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"旅次","author":"释绍嵩","text":"树势分孤垒，江流复旧痕。\n断桥斜取路，小径曲通村。\n山叠云霞际，林垂橘柚繁。\n个中有佳句，欲就已忘言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15985,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"旅暮即事","author":"释绍嵩","text":"万壑初收雨，湖声正寂然。\n薄衣临积水，归鸟度平川。\n仙掌云边树，春风寺外船。\n诗成见新月，目极向遥天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15986,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"栖霞道中","author":"释绍嵩","text":"路僻闲行远，溪将罨画通。\n飞泉高泻月，细柳乱摇风。\n畎亩孤城外，山川暮霭中。\n旷然忘所在，心与白云空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15987,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"留题江亭","author":"释绍嵩","text":"晚凉闲步向江亭，山色偏于晚有情。\n綵索平时墙婉娩，飞花满眼句纵横。\n五峰遥拱千岩秀，四水萦纡十里程。\n鹊噪鸦啼俱喜色，望中浑恐是蓬瀛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15988,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"途次走笔送张明府之都城","author":"释绍嵩","text":"原下相逢便别离，故人特地为嗟咨。\n高滩落日光零乱，春水涵波绿渺瀰。\n四壁一身长客梦，三年两作送君诗。\n紫垣名士推扬切，会向天庭振羽仪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15989,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"途次遇雨和丘德高","author":"释绍嵩","text":"白苇黄茅路四通，芙蓉憔悴菊垂丛。\n川原缭绕浮云外，楼阁朦胧细雨中。\n蔽野吞村飘不住，重山复水去无穷。\n丘郎蜡屐能从我，一任此身同转蓬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15990,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"通判曾温伯生日 其一","author":"释绍嵩","text":"玉历标人瑞，膺门鹗独先。\n风雷开盛旦，嵩岳降真贤。\n壁暗诗千首，官当岁九迁。\n得知眉寿永，何但八千年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15991,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"钱清解舟有感","author":"释绍嵩","text":"解缆浙江头，真成汗漫游。\n山川元历历，云水自悠悠。\n举翮笼中鸟，归心水上鸥。\n夕阳谁共感，一雁度南楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15992,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陪赵知府登桃岭山亭","author":"释绍嵩","text":"谁向云端著此亭，檐前树木映窗棂。\n野田流水溅溅白，芳草随人段段青。\n春服照尘连草色，云萝幽信寄茶经。\n史君领客周遭看，钟送遥帆落晚汀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15993,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偶兴","author":"释绍嵩","text":"暖日薰杨柳，溪风为肃然。\n浣衣逢野水，拥锡上泷船。\n元是沧浪客，闲寻空谷泉。\n病来诗久废，喜此得终篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15994,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偶作","author":"释绍嵩","text":"孤锡依京寺，悠悠过一生。\n有山供杰句，无地可归耕。\n燕竞波中影，棋添局上声。\n流年衰此世，寂寞不胜情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15995,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄元藏主","author":"释绍嵩","text":"度岁不相见，别来春又春。\n纵横皆失计，谈笑亦何因。\n乡思盈愁望，形衰恨道贫。\n掩扉当太白，愿卜子为邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15996,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晚泊丫头岩","author":"释绍嵩","text":"旅泊依村树，高吟似得邻。\n斜风吹败叶，落日照行尘。\n扰扰成何事，飘飘任此身。\n客心君莫问，赢得鬓如银。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15997,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"萧山口占","author":"释绍嵩","text":"水鸟迎秋舫，红轮映曙霞。\n冥冥小江树，淡淡满枝花。\n碧草望中去，青山郭外斜。\n天涯重回首，回首重伤嗟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15998,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"野步","author":"释绍嵩","text":"野步随吾意，无劳问是非。\n风莺移树啭，江燕引雏飞。\n一径入寒竹，千峰驻晚晖。\n幽怀在天末，何要更忘机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15999,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"野眺有感","author":"释绍嵩","text":"流落复蹉跎，生涯总几何。\n羁游故交少，归思夜深多。\n纵目怀青岛，遥天浸白波。\n谁令贪眺望，到处被诗磨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16000,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪后复雨过西湖","author":"释绍嵩","text":"触目成幽兴，诗吟十数篇。\n风倾竹上雪，鸟度水中天。\n急雨涔涔日，迎人小小船。\n更逢清管发，声到客愁边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16001,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寓山寺戏成","author":"释绍嵩","text":"寺在猿啼外，都无俗到来。\n岸花开且落，水鸟去仍回。\n果落方知熟，诗成未费才。\n逍遥此中意，老子兴悠哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16002,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寓龙峰遣兴","author":"释绍嵩","text":"可要栖身向薜萝，闲门空掩半庭莎。\n天寒日暮游人少，花落僧禅覆地多。\n六尺屏风遮宴坐，数椽月屋爱岩阿。\n我今客气浑消尽，无奈千茎鬓雪何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16003,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寓笔","author":"释绍嵩","text":"幽径草初青，无人知地名。\n征鞍千里远，倚杖一江横。\n云重欲为雨，风和拗得晴。\n家家好春色，春色遍空明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16004,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游双径","author":"释绍嵩","text":"宝刹触南箕，登临独立时。\n江山如有味，花柳更无私。\n已病身犹健，言归心尚迟。\n片云头上黑，真个解催诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16005,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游天竺","author":"释绍嵩","text":"天竺秋重入，翛然适此心。\n路寻流水远，门闭野云深。\n澹泞生真趣，幽闲且自任。\n残阳应更好，蝉合伴清吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16006,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游古寺次朋上人韵","author":"释绍嵩","text":"黄叶前朝寺，携朋上故基。\n近山烟外远，芳草露中衰。\n碛碛风吹面，霏霏雨散池。\n旅情何计是，排闷强裁诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16007,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游光严精舍","author":"释绍嵩","text":"酷爱山兼水，山重水又回。\n树围平野合，花逼艳阳开。\n习习和风至，冥冥细雨来。\n将行谁请住，留步小庭隈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16008,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游吉祥登棘庵别业","author":"释绍嵩","text":"屋在瀑泉西，看来眼转迷。\n松风清飒飒，秋日正凄凄。\n海鸟和涛望，山鼯隔水啼。\n何须更飞锡，祇此是曹溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16009,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游西崦","author":"释绍嵩","text":"小隐寄幽谷，登临翠色中。\n乱云低薄暮，片水静涵空。\n往往游西崦，依依向北风。\n清猿不可听，幽思更无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16010,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游何山","author":"释绍嵩","text":"绿草闲深院，繁花的的开。\n捲帘当白昼，辞洞恋青苔。\n燕掠平芜去，人从瀑布来。\n林间清话久，杜宇一声催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16011,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游信州仙岩","author":"释绍嵩","text":"仙境闲寻采药翁，笋舆乘兴得蒿蓬。\n山钟夜度空江水，窗户凉生薜荔风。\n断臂青猿啼玉笥，斜行白鸟入遥空。\n舍南有竹堪书字，借笔题诗却未工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16012,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游清老别业","author":"释绍嵩","text":"别业青山郭，人烟远更微。\n湿花随水汎，长瀑倚空飞。\n开箧收诗卷，凭轩对竹扉。\n淹留更一醉，应在醉中归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16013,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]