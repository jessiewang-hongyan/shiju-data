[{"title":"小新堤","author":"董嗣杲","text":"谁筑湖堤种柳条，行春路截九松腰。\n直看西日当三竺，平接南山第五桥。\n曲院岸通沙涧浅，桃溪寺接玉泉遥。\n游人从此言旋便，不受回舟著相招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4622,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山丹花","author":"董嗣杲","text":"知是何峰秀所钟，曾因手种得仙翁。\n暑须怯袅粘金穗，凉瓣嗔封迸柿红。\n扑卖有声传寂昼，幽妍无力借薰风。\n窑瓶插满清香烈，攲枕探吟鄙鹿葱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4623,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山茶花","author":"董嗣杲","text":"老树苍枝翠子乾，烂红搀向雪晴看。\n绿攒劲叶身边刺，金凝纤须腹内丹。\n鹤顶剪开霞瓣暖，骊珠遗下日亡寒。\n几多名品中州有，染透春风十二阑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4624,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"巾子山","author":"董嗣杲","text":"岌嶪山形丑莫收，傍湖独整傲春秋。\n几株乌桕无根在，一幅华阳有样留。\n寒日霜乾还掠额，晓天岚重且遮头。\n东篱漉酒人知得，醒立风前不可求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4625,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"广济县","author":"董嗣杲","text":"云罨厅檐草拥门，荻花掠岸雪纷纷。\n龙行费圣祠前雨，鸦聚甘王墓上云。\n绝巘树环孤市尽，乱溪水入大江分。\n邑民还有思莼兴，帘底琴声寂不闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4626,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"广济县王氏山园","author":"董嗣杲","text":"忧世须眉觉，锄园梦想安。\n封疆南斗隘，天地北风寒。\n野水通眢井，山云补蠹阑。\n故乡营业堕，岁晚转艰难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4627,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"飞来峰","author":"董嗣杲","text":"理公著脚五峰前，树石苍浮滴翠涎。\n因指何年飞到此，曾栖中竺悟来禅。\n一猿可验为灵鹫，万古无言有冷泉。\n今日共知遗迹胜，隐名却有许由传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4628,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"马头渡","author":"董嗣杲","text":"几回问渡野阴浓，趁早相呼舣短篷。\n千里晚沈鸿翼信，片帆凉卸马头风。\n官坊酒浊秋旗破，客店人荒晚釜空。\n量取异乡愁几斛，只须倾泻锦囊中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4629,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"丰乐楼","author":"董嗣杲","text":"莺花箫鼓绮罗丛，人在熙和境界中。\n海宇三登歌化日，湖山一览醉春风。\n水摇层栋青红湿，云锁危梯粉黛空。\n十里掌平都掩尽，有谁曾纪建楼功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4630,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"云洞园","author":"董嗣杲","text":"拥湖营圃藉元勋，景色天然曲折分。\n水脉窨花通活港，洞基垒石走空云。\n千间大厦归春梦，一撮危亭纳夕曛。\n扁画自悬碑自压，当年何事立孤坟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4631,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"五丈观音","author":"董嗣杲","text":"海国风涛拥万寻，此躯何翅直千金。\n涉波直现昂藏相，结屋还坚报施心。\n图得诸方传转智，幸存一半有观音。\n阴廊谁立苔碑在，只载三朝法驾临。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4632,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"六一泉","author":"董嗣杲","text":"一别孤山十八年，重来忍见讲堂泉。\n当时同出师门下，今日多伤井屋前。\n取重欧公名有自，肯教勤老迹空传。\n此铭此意流千古，凿石为庵不可眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4633,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"午睡","author":"董嗣杲","text":"茶灶烟沉午睡迟，故山云远思依依。\n桑麻得雨侵檐长，燕雀临风掠水飞。\n簪帽无花徒绕砌，探瓶有粟且扃扉。\n翔空何处胎仙唳，华表当年识令威。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4634,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"壬戌元日二首 其二","author":"董嗣杲","text":"万里东风起楚皋，流年祗染鬓萧骚。\n富池江口听春雨，昭勇楼心看雪涛。\n薄俗苦无公可论，全身惟有隐方高。\n故山猿鹤应相笑，抗走殊乡实自劳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4635,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"壬戌元日二首 其一","author":"董嗣杲","text":"青灯挑雨晓光凝，岁律回壬万象新。\n心上痛怀松里友，客中忍视茗山春。\n谁横烟竹惊孤旅，自饮屠苏笑八神。\n摺起朝衣羞老去，驱车犹冒路岐尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4636,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"天池寺忆雪屋韶上人","author":"董嗣杲","text":"惠诗传驿旧，立雪想师遥。\n一别此山去，清风不可招。\n经窗云半掩，石塔水偏朝。\n托迹今三宿，伊谁共寂寥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4637,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"天池寺晚步","author":"董嗣杲","text":"傍通锦绣谷，上接铁船峰。\n月出龙潭净，风虚佛屋重。\n四维天象朗，孤阁野云封。\n收得天灯叶，荧荧却绝踪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4638,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"太平兴国宫","author":"董嗣杲","text":"旌幢龙虎卫，台殿鼓钟浮。\n水乱浑疑雨，山深祗见秋。\n九天严采访，元老主焚脩。\n得禄安萧散，前身几世修。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4639,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"月丹花","author":"董嗣杲","text":"朱砂炼椀质轻盈，知是蟾宫几杵成。\n槁蒂秀钟天种艳，碾光辉映御袍荣。\n叶沿绿刺星星劲，心结黄芽粟粟明。\n皓魄正圆花正丽，相看无语说长生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4640,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"月季花","author":"董嗣杲","text":"谢了还开肯悟空，一年三十六旬中。\n相看谁有长春艳，莫道花无百日红。\n酡风倚娇承舞雪，瘦枝扶力借柔风。\n四时常吐芳姿媚，人老那能与此同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4641,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"木兰花","author":"董嗣杲","text":"弄粉调红抹野姿，寂寥谁抱远书思。\n妆凝彩日含朱粉，艳染光霞拆紫丝。\n守戍自知身是女，发祥谁见树生芝。\n晚桡歌断何人望，遗得天随醉后诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4642,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"木香花","author":"董嗣杲","text":"斗雪轻微吐粉蕤，同开结约是酴醾。\n玉英递韵埋深叶，檀蕊分姿袅别枝。\n无力可延春色住，有方曾著药名遗。\n花空风转薰弦院，红柱棚攲?乱垂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4643,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"木笔花","author":"董嗣杲","text":"始开已落谩芳菲，暗写东皇几夕晖。\n傍树谁矜火燄异，对花自感壮年非。\n红脂含蒂长枝劲，紫粉粘蕤老叶肥。\n名占辛夷播方册，诗豪惟许少陵挥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4644,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"水月园","author":"董嗣杲","text":"园门当路掩清华，乔木灵根裹翠霞。\n地拥楼台齐葛岭，天分香影傍林家。\n中兴勋将曾营业，外邸王孙且看花。\n月色水光三十里，何人来此泛仙槎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4645,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"水乐洞","author":"董嗣杲","text":"筑园裹寺接山椒，如此经营岂一朝。\n两洞倚云空锁钥，乱泉激雨想箫韶。\n树埋院落关门邃，石罨亭台栈路遥。\n白发聋僧扶旧额，金莲又长玉渊苗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4646,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"水仙庙","author":"董嗣杲","text":"云翘雨佩有遗仙，香火宁随世道迁。\n庙始大同年纪著，额颁乾化敕碑镌。\n凤閒露辇荒瑶草，龙湿秋衣剪玉莲。\n堤上创新谁述记，却无门外一泓泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4647,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"水荭花","author":"董嗣杲","text":"问花忆别向秋江，清占花丛白鸟双。\n落日袅愁归钓岸，薰风吹艳入船窗。\n情迷洲渚根无蒂，名寄闾阎曲有腔。\n寒露拉摧浮脆尽，断矶绝岸出枯桩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4648,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"水退小园散步时垂替感赋","author":"董嗣杲","text":"移来菊本已成丛，潦退园篱失笑空。\n梦蝶自应知境幻，问牛谁谓可年丰。\n渺茫天地浮秋水，寂历溪山截暮虹。\n蛩咽莫禁莎砌湿，万愁愁付酒杯中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4649,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"长耳相","author":"董嗣杲","text":"眉目如生骨骼寒，后来曾纪短碑顽。\n双垂长耳过肩角，千古遗躯落世间。\n覆履有方随迹灭，守龛无语向僧閒。\n想知自丑难遮断，两扇禅扉及早关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4650,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"长桥","author":"董嗣杲","text":"南港虚明架石梁，寺楼钟鼓几斜阳。\n相传亭跨危基壮，谁见桥横古道长。\n澄水闸荒沙草碧，清波门近市尘黄。\n凤凰山在阑干外，玉抺烟屏鹭一行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4651,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"风篁岭","author":"董嗣杲","text":"横陈翠葆列烟屏，联步苍林想典刑。\n二老相分龙井岭，一时如过虎溪亭。\n风吹贴石丛篁碧，雨剥题名晕藓青。\n更有涧流朝暮落，此声不厌客来听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4652,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东林寺上方塔","author":"董嗣杲","text":"尘外乾坤岂易窥，上方寻胜短筇随。\n病僧借榻山衣破，卧佛当门石塔危。\n乱竹迸阶交密树，荒苔沿壁缠疏枝。\n幅巾居士修行久，爱说浮光死战时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4653,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东林寺晚步","author":"董嗣杲","text":"天地聚奇观，山林负隐名。\n月明僧影瘦，风定水声清。\n不觉忘身世，何须问死生。\n有诗难举似，真实避时英。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4654,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东林寺赠宜上人","author":"董嗣杲","text":"幽阶苔藓翠纤纤，屐齿沾濡逐步黏。\n晓涧迸泉迷杏坞，春风停雨暗茅檐。\n禅高何待音声悟，诗好争传格律严。\n谁浼我师重主社，社中休更外陶潜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4655,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"乐天竹阁","author":"董嗣杲","text":"此君玉立此楼空，不复幽眠想白公。\n百尺有檐侵碧落，千竿无语足清风。\n阑尖亭影流渔屋，龛面祠香托佛宫。\n石琢端平丞相记，都归宝庆守臣功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4656,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"兰花","author":"董嗣杲","text":"芳友幽栖九畹阴，花柔叶劲怯深寻。\n谢家毓取阶庭秀，屈子纫归泽国吟。\n百卉混林尊异种，一清传世绝同心。\n身悝风露甘修洁，谁托斯馨欲援琴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4657,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"冬寒客怀","author":"董嗣杲","text":"争锥无意志摧藏，岁晚栖然滞客房。\n井臼自亲犹火食，琴书谁力谩时装。\n前峰雪洗心方快，破廨风穿骨欲僵。\n烧荻禦寒身尚曲，有人皲瘃守边疆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4658,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"出西城","author":"董嗣杲","text":"舟车江郭隘，钟鼓梵祠遥。\n古驲停羁客，深林出晚樵。\n鹰呼风立至，鸦窜雪垂飘。\n市价招商急，残冬未寂寥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4659,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"出德化门外","author":"董嗣杲","text":"湖光分柳岸，野趣入桑畦。\n锦片花随水，犀尖笋迸泥。\n淮云收雨去，蜀鸟失春啼。\n隔浦军船过，斜阳送鼓鼙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4660,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"北高峰","author":"董嗣杲","text":"幡竿袅影入青冥，暮鼓朝钟镇不停。\n劫火几灰龛底像，西风两减塔层铃。\n市人祈福心苗异，庙祝求金口角灵。\n三十六弯登绝顶，日中长现七元星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4661,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"发黄池与朱一夔相别情思黯如","author":"董嗣杲","text":"同行谁际此心同，我去君留怅北风。\n两地相分云袂远，前峰自掩雪林空。\n几多遣兴怀樽俎，千万将书托燕鸿。\n独过顾城湖上晚，已拚绝饮蛰孤篷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4662,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"古柳林","author":"董嗣杲","text":"几眠几醒几清明，万态风流学老成。\n古翠碧连云洞杳，夕阳西捲射场平。\n絮团破径应迷蝶，枝压荒墙不露莺。\n如此多栽堪卜隐，苦无十亩秫田耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4663,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"四安舟上","author":"董嗣杲","text":"复添三叹处，回泊四安时。\n野市人言犷，官坊酒味醨。\n聚船要价重，涤釜待粮迟。\n客况那能遣，终身厌路岐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4664,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"玉岑","author":"董嗣杲","text":"云掩风林万窍号，慧因桥畔息方袍。\n秦郎閒濯溪头足，许老清挥石上毫。\n玉出何年迷草莽，教传异域想波涛。\n山门翠拥山岚润，一道光芒月正高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4665,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"玉泉","author":"董嗣杲","text":"南齐事迹已销沉，曾立苔碑记古今。\n一老出泉犹抚掌，此僧演法欲传心。\n树头龙过家家雨，池面鱼游尾尾金。\n行客不须閒照影，要知泽物溥春霖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4666,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"玉壶园","author":"董嗣杲","text":"莫问南漪与玉壶，杜鹃还更试花无。\n坡仙一顾吟空老，地主频更景不殊。\n船出断桥春溆远，钟传萧寺晚楼孤。\n山明水秀轩扉敞，落日渔歌过里湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4667,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"玉绣毬花 其二","author":"董嗣杲","text":"洁身自拥翠枝寒，遗得春魂寄素颜。\n夜月曳光凝绝径，晚风抛影入空关。\n几团白雪能娇腻，五色流苏只等闲。\n宛似恋香蝴蝶乱，绿阴深处不飞还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4668,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"玉绣毬花 其一","author":"董嗣杲","text":"芳妍独殿绿阴阑，几簇流琼拥髻鬟。\n攒粉倚风摇舞地，妒晴抛日透飞关。\n蝶魂春聚苍枝顶，雪片寒团翠幄间。\n花压露梢如许重，有瓶难插懒能攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4669,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"玉莲堂","author":"董嗣杲","text":"仙根曾就华峰移，净引湘波出浴妃。\n龙护先皇三字在，燕居旧尹一清非。\n风檐摇影凉姿媚，月槛迷香冷艳肥。\n平展水天菱唱远，竹山苍翠自成围。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4670,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"甘园","author":"董嗣杲","text":"内官园邃傍斋宫，杨柳堤南翠几重。\n四面堂虚凌上界，五层塔近压中峰。\n径连湖水行幽草，廊接风亭卧偃松。\n邻岸御舟空望幸，深坊长日锁飞龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4671,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"甲戌九日和楼宰乌回寺登高","author":"董嗣杲","text":"乌回何代寺，鸠唤此山晴。\n心契将军约，肩摩小队行。\n明年人更健，今夜月初明。\n更过谯楼饮，偏垂野客情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4672,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"甲戌重午留越寄武康同官","author":"董嗣杲","text":"湘累莫吊楚云迷，力疾喑喑客会稽。\n心想同寅分席醉，身逢重午借楼栖。\n今朝气象悲欢异，几种葵榴色泽齐。\n水际晚凉应有赋，藕花多处想供题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4673,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"白家池亭","author":"董嗣杲","text":"白傅流风尚可寻，炉峰蓊紫掩天阴。\n石埋遗像丹青落，泉绕虚堂岁月深。\n老木寒拖千谷翠，小莲凉矗两池金。\n挑包知是何方侣，空论能参惠远心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4674,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"白莲花","author":"董嗣杲","text":"素质盈盈绿盖张，肯同媚眼醉斜阳。\n俨然玉井风姿异，无此冰壶月色香。\n天地一空谁染着，水云十里自清凉。\n东林结社流芳处，还有池亭傍上方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4675,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"石竹花","author":"董嗣杲","text":"矮丛平剪海霞鲜，乱撒东风紫锦钱。\n露沈翠抽春节嫩，烟枰绣蹙绛绡圆。\n土阶晔晔摇芳泽，山舍英英吐秀妍。\n秋色易花谁得见，何时容得麝香眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4676,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"石佛庵","author":"董嗣杲","text":"南峰云堕屋梁危，异迹曾遗广顺时。\n行脚影留岩石涧，头陀老守草庵攲。\n几年香火传朝晚，万谷烟霞拥路岐。\n半掩风扉钟又响，风霜皴尽砌街碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4677,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"石函桥","author":"董嗣杲","text":"函开函闭管年丰，白傅能方夏禹功。\n湖石记埋泥藓里，斗门字蚀水花中。\n犁平阡陌犹春雨，船载笙歌自晚风。\n遍倚暮阑怀古往，月明无奈瀑声空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4678,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"石榴花","author":"董嗣杲","text":"猩巾绉摺亚枝红，独现精神万绿中。\n带种归来传博望，动人咏处想荆公。\n触风绛彩逃春艳，萦火朱房烁暑空。\n别有盆窠培埴异，深黄线碧不相同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4679,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鸟窠","author":"董嗣杲","text":"松顶巢成亦甚危，元和禅此太和归。\n比丘随处心传异，刺史游山礼谒稀。\n铭志土侵无几字，塔亭雨坏有孤扉。\n一空四十年间梦，定业门前鹊自飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4680,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"龙井","author":"董嗣杲","text":"腥攒石缝瀑花多，还有龙神蛰此窠。\n通海浅深山不语，随潮长落水无波。\n谩传方士遗丹在，不奈潜鳞吐雾何。\n时雨愆期无验处，几番雷火爇松柯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4681,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"先贤祠","author":"董嗣杲","text":"列仙始自许箕公，上国尊贤典礼隆。\n三十九人裁信史，百千万祀纪清风。\n衣冠文物流传盛，花柳亭台曲折通。\n镜水在先祠越隐，如今彼此可称雄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4682,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"先得楼","author":"董嗣杲","text":"潋滟澄波漾彩椽，柳丝晴绊俊游鞭。\n傍湖莫厌官楼水，得月无如此地先。\n迎榜书生空绛帐，抱琴才子沃金船。\n壶天萧爽人人醉，雪色屏风画谪仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4683,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"合涧桥","author":"董嗣杲","text":"危阑压定活流重，谁识钱源绕梵宫。\n两涧共归桥底合，万雷莫敌水声雄。\n游人移步心还恐，野衲栖禅耳欲聋。\n石倚卧梁山月落，白猿一啸五峰空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4684,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"回至兴国宫望天池一簇云气中因杨道士留有赋","author":"董嗣杲","text":"迎面苍峦泼黛浓，几番回首想行踪。\n白云拥海文殊阁，老水屯烟圣治峰。\n方别衲僧谈梦寐，又逢羽士接从容。\n明朝还踏青虚路，重掬神泉听乱钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4685,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"安丰朱一夔同舟","author":"董嗣杲","text":"寒劲滋烟浪，根浮蹈雪霜。\n同舟谙楚俗，空橐返吴乡。\n聚散羁情远，行藏话柄长。\n骤逢接言笑，直觉背时妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4686,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"安庆新城","author":"董嗣杲","text":"清香凝燕寝，春色遍龙舒。\n市井无遗地，人烟有定居。\n柝声营屋邃，帘影酒坊虚。\n白首三山客，编茅作校书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4687,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]