[{"title":"西叔兄生日 其一","author":"魏了翁","text":"从渠冷煖广文君，发越春和别有根。\n乐意融融兄及弟，庆流衮衮子生孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32013,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西叔兄生日 其二","author":"魏了翁","text":"只把农功作己忧，不将岁事与天谋。\n官修事举文书静，一室高眠粥似稠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32014,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西叔兄生日 其三","author":"魏了翁","text":"上寿班齐日未升，风廊露幕立公卿。\n亲闻商略西南彦，争说高家好弟兄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32015,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西叔兄生日 其四","author":"魏了翁","text":"花底班行锦样明，中閒宁少紫青人。\n更无入诵成都赋，拟抗声来问大钧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32016,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"讲筵侍立 其三","author":"魏了翁","text":"御前亲赐密云龙，讲罢分行帝在中。\n起揖坐尝还再拜，侍臣趋出辇还宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32017,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"讲筵侍立 其二","author":"魏了翁","text":"须臾讲殿报班齐，拜罢东升一半西。\n两序公卿皆赐坐，史臣讲读右阶隮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32018,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"讲筵侍立 其一","author":"魏了翁","text":"晨趋东朵侍天颜，奏事班回帝辇还。\n才向内门需少选，诸珰又趣讲筵班。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32019,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李参政生日 其六","author":"魏了翁","text":"分付诸儿自致身，朝阳阁上看长春。\n梅边认得真消息，往古来今一屈伸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32020,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李参政生日 其三","author":"魏了翁","text":"八十蹁跹老阿兄，一窗风雨伴双清。\n武昌近日音书少，时听湖边过雁声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32021,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李参政生日 其五","author":"魏了翁","text":"梅艳凌霜带雪馀，铅华洗尽玉生肤。\n东方千骑推人去，聊折春风寄雁湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32022,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李参政生日 其五","author":"魏了翁","text":"剺面花门未果驯，夏人兵马薄熙秦。\n谁将鞭策驱时运，十数年间日日新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32023,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李参政生日 其六","author":"魏了翁","text":"绝嗤梁梦误金瓯，又叹祁征困木牛。\n只藉人才作元气，闻公安健百无忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32024,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李参政生日 其三","author":"魏了翁","text":"才记官来早去官，行人惊说路艰难。\n行藏用舍何关我，时把尼渊出处看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32025,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李参政生日 其四","author":"魏了翁","text":"历尽玄枵十二辰，饱看三十六宫春。\n才喷一霎挂龙雨，又卷云霓还翠旻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32026,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李参政生日 其四","author":"魏了翁","text":"泻出清明醉眼醒，都人弹指祝前星。\n凭谁提起源头话，治国齐家要六经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32027,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李参政约至井监偶得三绝 其一","author":"魏了翁","text":"忽闻车马下天来，拥术阗衢拨不开。\n六十七年无此客，灶前老隶亦惊猜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32028,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李参政约至井监偶得三绝 其二","author":"魏了翁","text":"不乘轞轞上公车，轧轧肩舆两仆夫。\n世道险夷随所遇，车中只是旧时吾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32029,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李参政约至井监偶得三绝 其三","author":"魏了翁","text":"溪边鹄白芦花瘦，山下鹅黄稻实肥。\n更得天公晴十日，今年穑事庶乎几。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32030,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李参政折赠黄香梅与八咏俱至用韵以谢 其三","author":"魏了翁","text":"露拂蔷薇不太深，春风庭院晚阴阴。\n来迟未入黄昏句，谁唤钱塘人姓林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32031,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李参政折赠黄香梅与八咏俱至用韵以谢 其六","author":"魏了翁","text":"玄天黄露真颜色，金步摇中颤舞娃。\n更倩南窗书奶味，不妨来伴太常斋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32032,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李参政折赠黄香梅与八咏俱至用韵以谢 其八","author":"魏了翁","text":"诗翁曾住玉皇家，刚与梅花定等差。\n染上鞠衣宫样浅，练裙缟帨觉无华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32033,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李参政折赠黄香梅与八咏俱至用韵以谢 其二","author":"魏了翁","text":"犀镇帘帷风绰开，当庭恰似剪花回。\n眉间一点看浑似，笑领江南春信来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32034,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李参政折赠黄香梅与八咏俱至用韵以谢 其五","author":"魏了翁","text":"冰魂玉骨一枝春，风格南昌旧子真。\n谁幻神仙黄白术，时装近日太尖新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32035,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李参政折赠黄香梅与八咏俱至用韵以谢 其七","author":"魏了翁","text":"和羹心事岁寒姿，若第风标舍更谁。\n谩道色轻花更艳，几成涂抹水边枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32036,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李参政折赠黄香梅与八咏俱至用韵以谢 其四","author":"魏了翁","text":"入眼风光似世情，金裳玉质转分明。\n额黄十二谁分似，疑是仙人成智琼。","collection":"宋","notice":"","provenance":{"r