[{"title":"苦热二首 其一","author":"宋祁","text":"夜火虽中气未清，箑频□倦若为情。\n峰云不动林烟热，正为蜩螗作沸羹。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46662,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"试秩秘书","author":"宋祁","text":"绿底封书矞露光，试名仙局霭芸香。\n固惭卫国乘轩宠，犹胜唐家脱腕郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46663,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金雀花","author":"宋祁","text":"叠叶倚风绽，翩翾凌雾排。\n齐名仙母使，写样汉宫钗。\n俗眼未应妒，勿忧珠弹来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46664,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨中罢直","author":"宋祁","text":"禁树连天雨送秋，千门寒气袭轻裘。\n优旃不用誇谐辩，陛楯诸郎已得休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46665,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冒雨晚归马上口占","author":"宋祁","text":"满盖繁声结暝凉，独驱归马向閒坊。\n嚣尘暂息非无意，半作冲泥污锦鄣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46666,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南郊祠所上章摄事二首 其二","author":"宋祁","text":"上辛兹摄事，瑞祝本通天。\n自此春秋笔，还书大有年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46667,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南郊祠所上章摄事二首 其一","author":"宋祁","text":"七里城南路，斋祠宿下房。\n远烟晨燎地，斜日夕牲场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46668,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宣室","author":"宋祁","text":"宣室崔嵬冠未央，殿帷深掩上书囊。\n贾生始得虚前席，董偃寻闻献寿觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46669,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庠局观书偶呈同舍","author":"宋祁","text":"蠹简时披落暗尘，昼窗风冷冰蟾津。\n不须长叹夫差事，恐有邻房儳和人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46670,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挑灯杖","author":"宋祁","text":"处膏非自润，在寸敢矜长。\n试用蔀家暗，回为邻壁光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46671,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挟弹林下","author":"宋祁","text":"挟柘行吟涉庾园，鹊林惊绕果林寒。\n幕中病客殊真侠，虚费游童逐弹丸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46672,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日溪上","author":"宋祁","text":"溪上和风吹薄云，溪边花木亦欣欣。\n州人未散烦携酒，行乐先须让使君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46673,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日溪上示南正四首 其四","author":"宋祁","text":"绕溪台榭据丘陵，试对春风日日登。\n蘋藻凫鱼无旧恨，主人今是柳吴兴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46674,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日溪上示南正四首 其三","author":"宋祁","text":"莫言雨后长蓬蒿，恍惚溪边见小桃。\n待得数朝开烂漫，更须防避晚风号。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46675,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日溪上示南正四首 其二","author":"宋祁","text":"少华山头雪未消，东风先已入花梢。\n今朝懒到溪边看，林下流莺似见嘲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46676,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日溪上示南正四首 其一","author":"宋祁","text":"春云拂拂柳摇摇，尽日相望似见招。\n此意只应人未会，自持杯酒上溪桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46677,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春帖子词夫人阁十首 其十","author":"宋祁","text":"玉管轻罗和气动，土牛青帻报祠归。\n仙盘取露朝和药，舞殿裁云暝作衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46678,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春帖子词夫人阁十首 其九","author":"宋祁","text":"日照觚棱万户春，细风轻雾淡嘉辰。\n一番宫柳黄烟重，百种盘蔬紫甲新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46679,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春帖子词夫人阁十首 其八","author":"宋祁","text":"新年十日逢春日，紫禁千觞献寿觞。\n寰海欢心共萌达，皇家庆祚与天长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46680,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春帖子词夫人阁十首 其六","author":"宋祁","text":"春阙风光丽，春城歌吹喧。\n琼苏献春酒，金薄镂春幡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46681,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春帖子词夫人阁十首 其五","author":"宋祁","text":"东郊移仗晓迎春，已觉轻寒不著人。\n天瑞穰穰君泽美，并教和气助佳辰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46682,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春帖子词夫人阁十首 其四","author":"宋祁","text":"银阙崔嵬对未央，春来始觉好年光。\n风生禁苑无穷丽，日向仙壶一倍长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46683,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春帖子词夫人阁十首 其三","author":"宋祁","text":"春天丽春旭，春酒献春杯。\n树待珊瑚斗，花须羯鼓催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46684,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春帖子词夫人阁十首 其二","author":"宋祁","text":"春从何处生，先觉满瑶京。\n冰解鱼鳞散，云飞鹤态成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46685,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春帖子词夫人阁十首 其一","author":"宋祁","text":"雪罢云初暖，天和日便迟。\n玉楼新燕子，禖下记来时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46686,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春帖子词皇后阁十首 其十","author":"宋祁","text":"双阙鲜云抱日光，朝来春意已昌昌。\n先从太液催波绿，后到灵和报柳黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46687,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春帖子词皇后阁十首 其九","author":"宋祁","text":"迎春宝胜插钗梁，拂钿裁金斗巧妆。\n上作君王万年字，要知长奉白云觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46688,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春帖子词皇后阁十首 其八","author":"宋祁","text":"暖碧浮天面，迟红上日华。\n宝幡双帖燕，綵树对缠花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46689,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春帖子词皇后阁十首 其七","author":"宋祁","text":"晓佩摇苍玉，晨旂亚翠斿。\n新年好春色，今日满皇州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46690,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春帖子词皇后阁十首 其六","author":"宋祁","text":"嘉祐随年至，皇恩共气和。\n水痕冰处动，烟思柳前多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46691,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春帖子词皇后阁十首 其五","author":"宋祁","text":"谁道春从何处来，只从金阙遍瑶台。\n苍龙便入时巡仗，玉液还飞行庆杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46692,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春帖子词皇后阁十首 其四","author":"宋祁","text":"宫里春花才灼灼，殿前春仗已峨峨。\n东风尽解天池冻，不及君王庆泽多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46693,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春帖子词皇后阁十首 其三","author":"宋祁","text":"晓天春气净融融，飞入天关第九重。\n灵沼水生初报雁，蓬莱云暖即从龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46694,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春帖子词皇后阁十首 其二","author":"宋祁","text":"春前已岁换，岁后始春来。\n綵燕随宜帖，缯花斗巧开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46695,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春帖子词皇后阁十首 其一","author":"宋祁","text":"青郊迎淑气，华阙报芳辰。\n瑞木梢梢变，珍禽哢哢新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46696,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春帖子词皇帝阁十二首 其十二","author":"宋祁","text":"宜春苑里报春回，宝胜缯花百种催。\n瑞羽关关迁木早，神鱼泼泼上冰来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46697,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春帖子词皇帝阁十二首 其十一","author":"宋祁","text":"夭矫苍龙引翠旌，君王暂报出郊迎。\n勾芒一夜催春到，万户千门歌吹声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46698,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春帖子词皇帝阁十二首 其十","author":"宋祁","text":"水暖蛟冰解，灰飞凤管和。\n阳春与皇泽，并付女夷歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46699,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春帖子词皇帝阁十二首 其九","author":"宋祁","text":"天上春先遍，世间人未知。\n黄金装柳蕊，红密点花枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46700,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春帖子词皇帝阁十二首 其八","author":"宋祁","text":"阳和今日到，景物一时新。\n陛下南山寿，长迎千万春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46701,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春帖子词皇帝阁十二首 其七","author":"宋祁","text":"春风长乐地，春仗大明天。\n春酒皆千日，春枝即万年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46702,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春帖子词皇帝阁十二首 其六","author":"宋祁","text":"苍龙东阙转春旂，綷羽林梢最早知。\n青帝回风还习习，黄人捧日故迟迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46703,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春帖子词皇帝阁十二首 其五","author":"宋祁","text":"望春台下春先到，猎猎青旂倚汉宫。\n水自北涯生暖溜，花从东面受和风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46704,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春帖子词皇帝阁十二首 其四","author":"宋祁","text":"日华初丽上林天，殿里春花百种鲜。\n驱出馀寒还故腊，收回和气作新年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46705,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春帖子词皇帝阁十二首 其三","author":"宋祁","text":"縠管灰飞尽，金胥刻漏长。\n欢情与和气，并入万年觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46706,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春帖子词皇帝阁十二首 其二","author":"宋祁","text":"瑞福随春到，穰穰正似山。\n君王宽大诏，自此遍人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46707,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春帖子词皇帝阁十二首 其一","author":"宋祁","text":"东郊迎气罢，暖信入严宸。\n暂遣星杓转，令知天下春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46708,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春望杂咏二首 其一 归雁","author":"宋祁","text":"刷羽梁王池，春至欲言归。\n牵我东南恨，随君西北飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46709,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春望杂咏二首 其二 远树","author":"宋祁","text":"如帷复如荠，历历映沧洲。\n故障千里目，剩作一重愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46710,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"柏树 其一","author":"宋祁","text":"昔托孤根百仞溪，何年移植对芳蹊。\n云岩烈麝相思久，怅望清香未满脐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46711,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"柏树 其二","author":"宋祁","text":"翠柏童然杂蘤间，簿书馀暇独来看。\n不须更共春葩竞，留取青青待岁寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46712,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"柳絮","author":"宋祁","text":"万缕金长暖絮萦，雪乾云困遍春城。\n冲风力尽飞应怯，试与鸿毛较重轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46713,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"相国寺祈雨马上口占","author":"宋祁","text":"青鸳刹下天香集，丞相车前佛月低。\n知有风人无限思，火城催向五门西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46714,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"祗答晏尚书怀寄之什","author":"宋祁","text":"赤白边书费坐筹，尚馀清暇寄冥搜。\n知公擿句多情意，虚忆卢谌唱和流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46715,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋夕不寐","author":"宋祁","text":"风袅危樯浪拍船，三更残月下空弦。\n离鸿过尽啼乌困，犹自愁人不得眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46716,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋夕不寤","author":"宋祁","text":"倦枕回尤数，东方不肯明。\n只将无睡耳，终夜著蛩声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46717,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋日西望","author":"宋祁","text":"晚襟清旷属层楼，摇落乾坤共作秋。\n正为中山存阙意，得无平子侧知愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46718,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋园见蝶","author":"宋祁","text":"扑粉曾过宋玉墙，一身生计托流芳。\n不须长结东风怨，秋菊春兰各有香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46719,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋塘败荷","author":"宋祁","text":"去时荷出小如钱，归见荷枯意惘然。\n秋后渐稀霜后少，白头黄叶两相怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46720,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"草木杂咏五首 其三 橼","author":"宋祁","text":"绀实纷累累，柔柯缓若若。\n叶以代新陈，花仍开续落。\n味虽不常御，香能破酲恶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46721,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"荒斋昼坐为鸣鸢所聒","author":"宋祁","text":"喜钞寒鸱六翮轻，萧条墟落恣飞鸣。\n屠邻腐肉知无限，少作扬州饿箭声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46722,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郡将夜醮分贶斋酎","author":"宋祁","text":"殊庭夜醮肃真仪，奏罢云章月已低。\n自笑谈宾真俗骨，不斋犹得醉如泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46723,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郡将病免檄委郡事","author":"宋祁","text":"郡将移书卧阁频，假提千骑出班春。\n校中宁免时髦诮，欲作宣明面向人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46724,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郡圃","author":"宋祁","text":"侧曲艳歌閒送日，晚花初叶暗留春。\n舞狂风蝶时过树，啼熟林莺不避人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46725,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重阳不见菊 其一","author":"宋祁","text":"戏马佳辰菊未黄，有人惆怅独持觞。\n心知不作匆匆意，故欲凌寒报早霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46726,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重阳不见菊 其二","author":"宋祁","text":"蜀地秋高未拟寒，翠苞如粒露华乾。\n重阳已过君休恨，留取金英晚节看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46727,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重阳前二日喜雨答泗州郭从事 其一","author":"宋祁","text":"晚秋嘉树润焦原，楚老相欢万井喧。\n须信甘膏皆帝力，使君虚凭黑熊轩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46728,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重阳前二日喜雨答泗州郭从事 其二","author":"宋祁","text":"雨洗淮天旱始摧，正堪凭远上高台。\n萸津菊润斋醅熟，共助重阳辟恶杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46729,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重怀和靖林逋","author":"宋祁","text":"高士非求死，天教陨少微。\n云疑隐居在，犹傍岭头归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46730,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闻蛙二首 其二","author":"宋祁","text":"膨脝枵怒腹，日夕沸溪干。\n群响何容罢，时无牡鞠官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46731,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闻蛙二首 其一","author":"宋祁","text":"蛙声直可厌，聒耳横相干。\n怒气何关勇，私鸣不为官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46732,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闻新榜恩除异等辄成自咏","author":"宋祁","text":"兰署曾叨异等名，当年不与赋天庭。\n尘容此际支离极，惭见唐家千佛经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46733,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"除夕","author":"宋祁","text":"历尾无馀日，更筹促曙躔。\n持愁剩残岁，将老入新年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46734,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"除夕","author":"宋祁","text":"一杯芳酒夜分天，万虑劳劳耿不眠。\n明日新春到何处，菱花影里二毛边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46735,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"除夕作","author":"宋祁","text":"四十九年今日到，来欢往戚是欤非。\n床头周易有深意，自此恐须三绝韦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46736,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晏寝","author":"宋祁","text":"栩栩庄园梦正酣，曙霞分色照东南。\n闭门更费当关报，已是嵇康一不堪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46737,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桃 其三","author":"宋祁","text":"为就东君得早红，年年开趁落梅风。\n凌寒拂晓相看意，争合尊中放酒空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46738,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桃 其一","author":"宋祁","text":"春香摇曳夏阴繁，蹊曲愔愔静可攀。\n不是仙园三食罢，何缘灵核到人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46739,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桃 其二","author":"宋祁","text":"绛蕊迎春五出齐，开时未识早莺啼。\n不应尽占游人赏，留取馀芳付李蹊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46740,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"海棠","author":"宋祁","text":"万萼霞乾照曙空，向来心赏已多同。\n未如此日家园乐，数遍繁枝衮衮红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46741,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]