[{"title":"探梅","author":"吴可","text":"探春逼残岁，幽香度寒原。\n欲看枝横水，会待月挂村。\n谁怜槁木中，妙有春风根。\n孤芳自一丘，不受烟雾昏。\n饱霜分疏瘦，下笑浪蕊繁。\n喜无蜂蝶知，那与桃李言。\n要当碧云暮，殷勤赋离魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42508,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"筠寮","author":"吴可","text":"解衣一寮上，物色太窘束。\n柏禅费酬对，松官缚爵禄。\n此君真有道，虚心自岩谷。\n每以阅世人，得之定超俗。\n夜夜幽露寒，惊我庭下绿。\n独出万物表，清蟾映疏玉。\n嘉此烟雾姿，本无霜雪辱。\n朔风舞郊野，秀气压群木。\n旧根走苔径，新梢出云屋。\n要令千亩广，会待春雨足。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42509,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"醉乡诗","author":"吴可","text":"饮中境界妙四海，楚屈未知风俗淳。\n陶然席地已忘载，夜缚瓮下初不嗔。\n逃禅骂坐本真率，时一中之眇万物。\n纵兵端欲捲愁城，乐贤未始忘欢伯。\n佳处风光殊可人，好德悬知必有邻。\n黄花解劝张季鹰，俗妇那识刘伯伦。\n世间万物败人意，不如常作个中计。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42510,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题马上元所藏赵墨隐画渊明四诗","author":"吴可","text":"我不识赵子，见此便得之。\n谈笑出丘壑，粲然备四时。\n似闻月旦评，气压渊明诗。\n马卿宰白下，惯作烟云嬉。\n归来九衢尘，旧好不少移。\n慇勤著怀袖，亦足慰梦思。\n我本家北阜，一官老京师。\n颇怀月下松，披图觅幽姿。\n正恐林间鹤，怨我归无期。\n那知此心在，衡宇终栖迟。\n谁怜阿堵中，几有一斛泥。\n愿分溪上山，供我笏拄颐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42511,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题质龟轩","author":"吴可","text":"清江料事错，来作刳肠翁。\n不知几许灵，堕此朽骨中。\n时出纵横文，随意侮儿童。\n谁识轩中人，本自无吉凶。\n平生不惊俗，要与众客同。\n人言可为鉴，试卜来年丰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42512,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题翘翠轩诗","author":"吴可","text":"老木拔云苍翠起，新篁挟雨枝叶美。\n下有数峰莓苔寒，先生俯仰一笑喜。\n乘兴把书坐秋风，超然吐论飞长虹。\n客星忽去璧月上，陶陶醉卧玻璃中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42513,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠连楚狂","author":"吴可","text":"谁有画鱼癖，诗社寻楚狂。\n真成戏新荷，径欲穿垂杨。\n馀生堕辙中，恍然得濠梁。\n寓兴亦差乐，江湖庶相忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42514,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"吴可","text":"寿宁闲锁翰林春，月明空照琼花影。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42515,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题叠石山院僧壁","author":"吴可几","text":"缁客幽栖常苦吟，水边松下静愔愔。\n有时一室焚香坐，不以诗情废道心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42516,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和孔司封题蓬莱阁","author":"吴可几","text":"皇唐旧相元才子，曾作蕃宣式燕遨。\n郛郭上当星纪分，轩甍全压阆风高。\n宾僚会集簪裾盛，衙队周环鼓吹豪。\n不出公庭得仙馆，岂同徐福绝云涛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42517,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"钓台","author":"吴可几","text":"君王取天下，有人将甲兵。\n君王得天下，有人相升平。\n我欲介其间，区区安取成。\n莫若归养高，高卧嵓之扃。\n直使万乘意，慕仰非鸿冥。\n身虽隐渔钓，心岂忘朝廷。\n常虑天下定，君王志骄盈。\n群臣习见闻，力谏不尔听。\n不有不臣者，不足回其清。\n商山四老人，用是定西京。\n潜希绝世躅，万一助皇明。\n年当建武日，上下咸清宁。\n所怀忆不陈，终焉为客星。\n如何逸民传，乃有狂奴名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42518,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"石门峰","author":"吴弘钰","text":"横石架广门，天风自来去。\n夜半闻洞箫，知是神游处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42519,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"及第谢恩","author":"吴必达","text":"圣朝更化广蒐贤，丹陛遥瞻穆穆天。\n历数万年垂统正，精微一理得心传。\n输忠敢罄刘蕡胆，擢第应同李合肩。\n四海尚期王德洽，小臣稽首颂周篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42520,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"吴民载","text":"条风著野方蚕月，高树移阴又麦秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42521,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蜡梅","author":"吴泳","text":"若得西湖处士疑，如何颜色到鹅儿。\n清香全与江梅似，只欠横斜照水枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42522,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浮远堂","author":"吴汉英","text":"天险东南限此江，支分暨水北为阳。\n孤山不动婴潮怒，客艇飞来说路长。\n槛外烟云如出没，坐中顷刻变炎凉。\n裴回顿觉尘缨绊，一曲沧浪酬月光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42523,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题招提院静照堂","author":"吴申","text":"高檐飞远发辉光，向此心源默坐忘。\n岂忆布金抛旧地，便随飞锡起新堂。\n竹间野鸽听斋鼓，湖上游人系夜航。\n却懊未能攀胜境，东南云下欲腾翔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42524,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七娘子 贺人子晬","author":"吴申","text":"君家诸子燕山盛。\n去年两见门弧庆。\n银蜡烧花，宝香熏烬。\n晬盘珠玉还相映。\n耳边好语凭君听。\n此儿不与群儿并。\n右执金戈，左持金印。\n功名当似王文正。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42525,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"吴申李","text":"潮头高捲岸，雨脚半吞山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42526,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿主簿","author":"吴申甫","text":"武夷之山奇而青，九曲之水秀且清。\n山奇水秀佳气萃，孕毓多少名公卿。\n世运推来五百岁，岳渎又应一贤生。\n相国萧何储大昴，谪仙李白扶长庚。\n拍塞家声今几载，云来见此千人英。\n年少万卷付一读，胸中霜气秋空横。\n骅骝不作伏枥态，梦寐抵掌收功名。\n属时绿林肆分扰，邻疆鼎沸无遑宁。\n笑看吴钩应嚼齿，折冲不辞鞍马尘。\n发输红腐活饥殍，呻吟变作讴歌声。\n勾稽讵足究施设，直须舟楫济通津。\n幕府筹功居第一，联翩奏剡飞天庭。\n日边消息清夜至，芝泥炳焕皇恩新。\n铨闱行脱囊中颖，佩玉鸣珂游帝京。\n书云过后两旬及，还是霄躔初度辰。\n和气恰随阳气转，台星还并寿星明。\n北山底处香风动，湖山里外祥烟轻。\n帏罗幕绣玳筵列，歌珠舞翠金壶倾。\n未祝修身如成子，未祝庞眉偕钱铿。\n但愿登金仍步玉，盐梅商鼎早调羹。\n归来武夷溪九曲，幔亭曾孙旋寻盟。\n眉寿堂中恣盘礴，摩挲铜狄细推评。\n武夷之山比公寿，与公千岁同峥嵘。\n九曲之水酿公酒，与公千岁供寿觥。\n我亦更办诗千首，一年一首伸贺诚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42527,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题画扇","author":"吴白","text":"风枝露叶有馀清，转盼还从玉笋生。\n愿得此君长在眼，子猷虽老未忘情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42528,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠陈随隐","author":"吴石翁","text":"大隐君家小隐君，得名太早忌人闻。\n秋窗吟共缑山月，晓榻眠分华岳云。\n莺欲引雏先出谷，马才生骥便离群。\n新诗却要多拈出，突过郎罢张我军。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42529,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"听松楼落成","author":"吴礼","text":"仙人自昔好楼居，黄鹤而今成故墟。\n高架数椽悬碧落，歘听万树响空除。\n白云伴向松窗宿，翠虬摩将石壁书。\n长日怡然还自得，却疑有梦到华胥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42530,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"采桑子慢 秋别","author":"吴礼之","text":"金风颤叶，那更饯别江楼。\n听凄切、阳关声断，楚馆云收。\n去也难留。\n万重烟水一扁舟。\n锦屏罗幌，多应换得，蓼岸苹洲。\n凝想恁时欢笑，伤今萍梗悠悠。\n谩回首、妖娆何处，眷恋无由。\n先自悲秋。\n眼前景物只供愁。\n寂寥情绪，也恨分浅，也悔风流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42531,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"风入松 江景","author":"吴礼之","text":"苹汀蓼岸荻花洲。\n占断清秋。\n五湖景物供心眼，几曾有、一点闲愁。\n梦里翩翩胡蝶，觉来叶叶渔舟。\n谢郎随分总优游。\n信任沈浮。\n恬然云水无贪吝，笑腰缠、骑鹤扬州。\n只恐丹青妙笔，写传难尽风流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42532,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"失调名","author":"吴礼之","text":"我不成、心酸眼软。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42533,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"生查子 浙江","author":"吴礼之","text":"吴山与越山，相对摩今古。\n袅缆浙江亭，回首西兴渡。\n区区名利人，无分香闺住。\n匆遽促征鞍，又入临平路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42534,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"好事近 秋日席上","author":"吴礼之","text":"金菊间芙蓉，秋意未为萧索。\n临水见山庭院，伴玉人杯酌。\n携炉终日袅沈烟，氤氲篆文□。\n可惜被风吹散，把袖儿笼著。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42535,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杏花天 春思","author":"吴礼之","text":"闷来凭得阑干暖。\n自手引、朱帘高卷。\n桃花半露胭脂面。\n芳草如茵乍展。\n烟光散、湖光潋滟。\n映绿柳、黄鹂巧啭。\n遥山好似宫眉浅。\n人比遥山更远。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42536,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨中花慢","author":"吴礼之","text":"眷浓恩重，长离永别，凭谁为返香魂。\n忆湘裙霞袖，杏脸樱唇。\n眉扫春山淡淡，眼裁秋水盈盈。\n便如何忘得，温柔情态，恬静天真。\n凭栏念及，夕阳西下，暮烟四起江村。\n渐入夜、疏星映柳，新月笼云。\n酝造一生清瘦，能消几个黄昏。\n断肠时候，帘垂深院，人掩重门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42537,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"柳梢青 席上","author":"吴礼之","text":"板约红牙。\n歌翻白雪，杯泛流霞。\n苏小情多，潘郎年少，欢计生涯。\n轩窗临水人家。\n更门掩、青春杏花。\n百万呼卢，十千沽酒，不负韶华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42538,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桃源忆故人 春暮","author":"吴礼之","text":"画桥流水飞花舞。\n柳外斜风细雨。\n红瘦绿肥春暮。\n肠断桃源路。\n欢随仙子乘鸾去。\n镂月裁云何处。\n唯有病和愁绪。\n肯伴刘郎住。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42539,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 橄榄","author":"吴礼之","text":"南国风流是故乡。\n红盐落子不因霜。\n于中小底最珍藏。\n荐酒荐茶些子涩，透心透顶十分香。\n可人回味越思量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42540,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渔家傲 闺思","author":"吴礼之","text":"红日三竿莺百啭。\n梦回鸳枕离魂乱。\n料得玉人肠已断。\n眉峰敛。\n晓妆镜里春愁满。\n绿琐窗深难见面。\n云笺谩写教谁传。\n闻道笙歌归小院。\n梁尘颤。\n多因唱我新词劝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42541,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谒金门 春晚","author":"吴礼之","text":"风乍扇。\n帘外落红千片。\n飞尽落花春不管。\n斗忙莺与燕。\n往事上心撩乱。\n睡起日高犹倦。\n料得伊家情眷眷。\n近来长梦见。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42542,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜迁莺 闰元宵","author":"吴礼之","text":"银蟾光彩。\n喜稔岁闰正，元宵还再。\n乐事难并，佳时罕遇，依旧试灯何碍。\n花市又移星汉，莲炬重芳人海。\n尽勾引，遍嬉游宝马，香车喧隘。\n晴快。\n天意教、人月更圆，偿足风流债。\n媚柳烟浓，夭桃红小，景物迥然堪爱。\n巷陌笑声不断，襟袖馀香仍在。\n待归也，便相期明日，踏青挑菜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42543,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"瑞鹤仙 秋思","author":"吴礼之","text":"风传秋信至。\n颤叶叶庭梧，飘零阶砌。\n年华迅流水。\n况荣枯翻手，存亡弹指。\n谁编故纸。\n论古往、英雄斗智。\n在当时、唤做功名，到此尽成闲气。\n何谓。\n生为行客，死乃归人，世同驿邸。\n十步九计。\n空捞攘，谩儿戏。\n忍都将、有限光阴萦绊，趁逐无穷天地。\n我直须、跳出樊笼，做个俏底。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42544,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蓦山溪 感旧","author":"吴礼之","text":"刘郎老矣，倦入繁华地。\n触目愈伤情，念陈迹、人非物是。\n共谁携手，落日步江村，临远水，对遥山，闲看烟云起。\n买牛卖剑，便作儿孙计。\n朋旧自荣华，也怜我、无名无利。\n箪瓢钟鼎，等是百年身，空妄作，枉迂回，贪爱从今止。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42545,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蝶恋花 其三 春思","author":"吴礼之","text":"满地落红初过雨。\n绿树成阴，紫燕风前舞。\n烟草低迷萦小路。\n昼长人静扃朱户。\n沈水香销新剪苎。\n敧枕朦胧，花底闻莺语。\n春梦又还随柳絮。\n等闲飞过东墙去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42546,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蝶恋花 其二 别恨","author":"吴礼之","text":"急水浮萍风里絮。\n恰似人情，恩爱无凭据。\n去便不来来便去。\n到头毕竟成轻负。\n帘卷春山朝又暮。\n莺燕空忙，不念花无主。\n心事万千谁与诉。\n断云零雨知何处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42547,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蝶恋花 其一 春思","author":"吴礼之","text":"睡思厌厌莺唤起。\n帘卷东风，犹未忺梳洗。\n眼细眉长云拥髻。\n笑垂罗袖熏沈水。\n媚态盈盈闲举止。\n只有江梅，清韵能相比。\n诗酒琴棋歌舞地。\n又还同醉春风里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42548,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"霜天晓角 其一 王生陶氏月夜共沉西湖，赋此吊之","author":"吴礼之","text":"连环易缺。\n难解同心结。\n痴騃佳人才子，情缘重、怕离别。\n意切。\n人路绝。\n共沈烟水阔。\n荡漾香魂何处，长桥月。\n断桥月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42549,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"霜天晓角 其二 秋景","author":"吴礼之","text":"西风又急。\n细雨黄花湿。\n楼枕一篙烟水，兰舟漾、画桥侧。\n念昔。\n空泪滴。\n故人何处觅。\n魂断菱歌凄怨，疏帘卷、暮山碧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42550,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋兴","author":"吴龙起","text":"定是凭高易得愁，客怀牢落怕登楼。\n不知昨夜梧桐雨，添得阑干几许秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42551,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"栎园","author":"吴龙起","text":"栎园依古寺，景物久凄凉。\n荆棘无人剪，亭台逐处荒。\n数禽栖曲沼，独犬吠空堂。\n惆怅梅花发，凭谁管暗香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42552,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"久客湖海买舟西还","author":"吴龙翰","text":"万里烟波兴渺然，片心如在灞桥边。\n归装诗少不成担，自拗梅花凑满船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42553,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乌江项羽庙","author":"吴龙翰","text":"盖世英雄只恁休，千年遗恨大江流。\n汉提义帝作张本，当日君输第一筹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42554,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水边早梅","author":"吴龙翰","text":"梅花淡淡著寒烟，漏泄春光老屋边。\n会被清池写疏影，一枝分作两枝妍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42555,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"王荆公读书堂","author":"吴龙翰","text":"六籍纷纷尽可奴，翻腾字说乃菑畬。\n可知山半青灯夜，只读商君一卷书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42556,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬夜 其一","author":"吴龙翰","text":"读罢床头一卷易，晚风冻尽铜壶滴。\n起傍危阑啸一声，月明何处人横笛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42557,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬夜 其二","author":"吴龙翰","text":"一屋白云无锁钥，酒酣要摘梅花嚼。\n相逢石鼎老弥明，吟罢松梢月欲落。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42558,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬夜山中","author":"吴龙翰","text":"寒入雁声霜满地，香沈梅影月当崖。\n独鹤归来童亦睡，微风簌簌落松钗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42559,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"先曾大父作竹夫人铭北窗蘧蘧偎尔冰肌毋徇其名乃邪其思甚有思致余不能道漫作俳优语","author":"吴龙翰","text":"水沈为骨玉为肌，专宠凉台会有时。\n长得夫人容两足，客星不遣史官知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42560,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再过孤山","author":"吴龙翰","text":"一函鹤骨已尘埃，空筑孤山碧玉台。\n添种红莲千万朵，梅花从此不须开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42561,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"有所嗟","author":"吴龙翰","text":"乘鸾人去玉箫寒，云敛巫山晓梦残。\n柳线不堪系离别，自和烟雨搭阑干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42562,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自建邺归至绩溪迂路观石照","author":"吴龙翰","text":"谁磨白石如冰鉴，勋业安能试一窥。\n但觉秋风上潘鬓，半因为客半因诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42563,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过和州报恩寺唐籍故居也","author":"吴龙翰","text":"昔年此地著书人，诗骨成尘草木深。\n突兀眼前僧结屋，塔铃风里替君吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42564,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冻吟","author":"吴龙翰","text":"座左插梅花，座右横诗笔。\n风雪堕寒肩，先生方抱膝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42565,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"张丽华墓 其一","author":"吴龙翰","text":"金井辘轳春梦残，香魂飞不到长安。\n君王为虏妾为土，夜月空分两地寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42566,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"张丽华墓 其二","author":"吴龙翰","text":"结绮临春迹已尘，尚馀抔土锁娉婷。\n玉颜不及陇头草，岁岁春风吹得青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42567,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"辛酉秋吴画士写神","author":"吴龙翰","text":"功名自有兜鍪辈，荣辱宁干蓑笠翁。\n烦作田园秋兴画，短檐斜日稻花风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42568,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"京城寓居春日","author":"吴龙翰","text":"春城庭院柳风轻，帘影玲珑爱晓晴。\n红日半窗吟梦觉，咿哑墙外卖花声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42569,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"侠客行","author":"吴龙翰","text":"击筑复击筑，欲歌双泪横。\n宝刀重如命，命如鸿毛轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42570,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜兴","author":"吴龙翰","text":"山房静对碧巉岏，与客歌骚夜未阑。\n客去灯寒眠不稳，心随明月在阑干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42571,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜吟","author":"吴龙翰","text":"小院沈沈夜欲阑，东风吹月上阑干。\n手撼梅花露研墨，醉将吟笔蘸清寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42572,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]