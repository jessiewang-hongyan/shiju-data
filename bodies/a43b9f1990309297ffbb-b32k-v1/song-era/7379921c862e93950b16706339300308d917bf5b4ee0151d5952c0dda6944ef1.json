[{"title":"少年游 其三","author":"晏殊","text":"芙蓉花发去年枝。\n双燕欲归飞。\n兰堂风软，金炉香暖，新曲动帘帷。\n家人拜上千春寿，深意满琼卮。\n绿鬓朱颜，道家装束，长似少年时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57406,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"少年游 其一","author":"晏殊","text":"重阳过后，西风渐紧，庭树叶纷纷。\n朱阑向晓，芙蓉妖艳，特地斗芳新。\n霜前月下，斜红淡蕊，明媚欲回春。\n莫将琼萼等闲分。\n留赠意中人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57407,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"木兰花 其四","author":"晏殊","text":"池塘水绿风微暖。\n记得玉真初见面。\n重头歌韵响铮琮，入破舞腰红乱旋。\n玉钩阑下香阶畔。\n醉后不知斜日晚。\n当时共我赏花人，点检如今无一半。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57408,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"木兰花 春恨","author":"晏殊","text":"绿杨芳草长亭路，年少抛人容易去。\n楼头残梦五更钟，花底离愁三月雨。\n无情不似多情苦，一寸还成千万缕。\n天涯地角有穷时，只有相思无尽处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57409,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"木兰花/玉楼春 其七","author":"晏殊","text":"杏梁归燕双回首。\n黄蜀葵花开应候。\n画堂元是降生辰，玉盏更斟长命酒。\n炉中百和添香兽。\n帘外青蛾回舞袖。\n此时红粉感恩人，拜向月宫千岁寿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57410,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"木兰花/玉楼春 其八","author":"晏殊","text":"紫薇朱槿繁开后。\n枕簟微凉生玉漏。\n玳筵初启日穿帘，檀板欲开香满袖。\n红衫侍女频倾酒。\n龟鹤仙人来献寿。\n欢声喜气逐时新，青鬓玉颜长似旧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57411,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"木兰花/玉楼春 其九","author":"晏殊","text":"春葱指甲轻拢拈。\n五彩条垂双袖卷。\n雪香浓透紫檀槽，胡语急随红玉腕。\n当头一曲情无限。\n入破铮琮金凤战。\n百分芳酒祝长春，再拜敛容抬粉面。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57412,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"木兰花 其二","author":"晏殊","text":"帘旌浪卷金泥凤。\n宿醉醒来长瞢松。\n海棠开后晓寒轻，柳絮飞时春睡重。\n美酒一杯谁与共。\n往事旧欢时节动。\n不如怜取眼前人，免更劳魂兼役梦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57413,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"长生乐 其一","author":"晏殊","text":"玉露金风月正圆。\n台榭早凉天。\n画堂嘉会，组绣列芳筵。\n洞府星辰龟鹤，来添福寿。\n欢声喜色，同入金炉泛浓烟。\n清歌妙舞，急管繁弦。\n榴花满酌觥船。\n人尽祝、富贵又长年。\n莫教红日西晚，留著醉神仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57414,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"长生乐 其二","author":"晏殊","text":"阆苑神仙平地见，碧海架蓬瀛。\n洞门相向，倚金铺微明。\n处处天花撩乱，飘散歌声。\n装真筵寿，赐与流霞满瑶觥。\n红鸾翠节，紫凤银笙。\n玉女双来近彩云。\n随步朝夕拜三清。\n为传王母金箓，祝千岁长生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57415,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玉堂春 其二","author":"晏殊","text":"后园春早。\n残雪尚濛烟草。\n数树寒梅，欲绽香英。\n小妹无端、折尽钗头朵，满把金尊细细倾。\n忆得往年同伴，沈吟无限情。\n恼乱东风、莫便吹零落，惜取芳菲眼下明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57416,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玉堂春 其一","author":"晏殊","text":"帝城春暖。\n御柳暗遮空苑。\n海燕双双，拂扬帘栊。\n女伴相携、共绕林间路，折得樱桃插髻红。\n昨夜临明微雨，新英遍旧丛。\n宝马香车、欲傍西池看，触处杨花满袖风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57417,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玉堂春 其三","author":"晏殊","text":"斗城池馆。\n二月风和烟暖。\n绣户珠帘，日影初长。\n玉辔金鞍、缭绕沙堤路，几处行人映绿杨。\n小槛朱阑回倚，千花浓露香。\n脆管清弦、欲奏新翻曲，依约林间坐夕阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57418,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玉楼春 其三","author":"晏殊","text":"燕鸿过后莺归去。\n细算浮生千万绪。\n长于春梦几多时，散似秋云无觅处。\n闻琴解佩神仙侣。\n挽断罗衣留不住。\n劝君莫作独醒人，烂醉花间应有数。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57419,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玉楼春 其五","author":"晏殊","text":"玉楼朱阁横金锁。\n寒食清明春欲破。\n窗间斜月两眉愁，帘外落花双泪堕。\n朝云聚散真无那。\n百岁相看能几个。\n别来将为不牵情，万转千回思想过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57420,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玉楼春 其一","author":"晏殊","text":"东风昨夜回梁苑。\n日脚依稀添一线。\n旋开杨柳绿娥眉，暗拆海棠红粉面。\n无情一去云中雁。\n有意归来梁上燕。\n有情无意且休论，莫向酒杯容易散。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57421,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"红窗听 其二","author":"晏殊","text":"记得香闺临别语。\n彼此有、万重心诉。\n淡云轻霭知多少，隔桃源无处。\n梦觉相思天欲曙。\n依前是、银屏画烛，宵长岁暮。\n此时何计，托鸳鸯飞去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57422,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"红窗听 其一","author":"晏殊","text":"淡薄梳妆轻结束。\n天意与、脸红眉绿。\n断环书素传情久，许双飞同宿。\n一饷无端分比目。\n谁知道、风前月底，相看未足。\n此心终拟，觅鸾弦重续。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57423,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"更漏子 其二","author":"晏殊","text":"塞鸿高，仙露满。\n秋入银河清浅。\n逢好客，且开眉。\n盛年能几时。\n宝筝调，罗袖软。\n拍碎画堂檀板。\n须尽醉，莫推辞。\n人生多别离。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57424,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"更漏子 其一","author":"晏殊","text":"蕣华浓，山翠浅。\n一寸秋波如剪。\n红日永，绮筵开。\n暗随仙驭来。\n遏云声，回雪袖。\n占断晓莺春柳。\n才送目，又颦眉。\n此情谁得知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57425,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"更漏子 其四","author":"晏殊","text":"菊花残，梨叶堕。\n可惜良辰虚过。\n新酒熟，绮筵开。\n不辞红玉杯。\n蜀弦高，羌管脆。\n慢飐舞娥香袂。\n君莫笑，醉乡人。\n熙熙长似春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57426,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"更漏子 其三","author":"晏殊","text":"雪藏梅，烟著柳。\n依约上春时候。\n初送雁，欲闻莺。\n绿池波浪生。\n探花开，留客醉。\n忆得去年情味。\n金盏酒，玉炉香。\n任他红日长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57427,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诉衷情令 其三","author":"晏殊","text":"芙蓉金菊斗馨香。\n天气欲重阳。\n远村秋色如画，红树间疏黄。\n流水淡，碧天长。\n路茫茫。\n凭高目断，鸿雁来时，无限思量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57428,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诉衷情令 其七","author":"晏殊","text":"世间荣贵月中人。\n嘉庆在今辰。\n兰堂帘幕高卷，清唱遏行云。\n持玉盏，敛红巾。\n祝千春。\n榴花寿酒，金鸭炉香，岁岁长新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57429,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诉衷情令","author":"晏殊","text":"东风杨柳欲青青。\n烟淡雨初晴。\n恼他香阁浓睡，撩乱有啼莺。\n眉叶细，舞腰轻。\n宿妆成。\n一春芳意，三月和风，牵系人情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57430,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诉衷情令 其五","author":"晏殊","text":"露莲双脸远山眉。\n偏与淡妆宜。\n小庭帘幕春晚，闲共柳丝垂。\n人别后，月圆时。\n信迟迟。\n心心念念，说尽无凭，只是相思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57431,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诉衷情令 其一 寿","author":"晏殊","text":"幕天席地斗豪奢。\n歌妓捧红牙。\n从他醉醒醒醉，斜插满头花。\n车载酒，解貂贳。\n尽繁华。\n儿孙贤俊，家道荣昌，祝寿无涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57432,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诉衷情令","author":"晏殊","text":"海棠珠缀一重重。\n清晓近帘栊。\n胭脂谁与匀淡，偏向脸边浓。\n看叶嫩，惜花红。\n意无穷。\n如花似叶，岁岁年年，共占春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57433,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诉衷情令","author":"晏殊","text":"喧天丝竹韵融融。\n歌唱画堂中。\n玲女世间希有，烛影夜摇红。\n一同笑，饮千钟。\n兴何穷。\n功成名遂，富足年康，祝寿如松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57434,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诉衷情令 其一","author":"晏殊","text":"青梅煮酒斗时新。\n天气欲残春。\n东城南陌花下，逢著意中人。\n回绣袂，展香茵。\n叙情亲。\n此情拼作，千尺游丝，惹住朝云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57435,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"迎春乐","author":"晏殊","text":"长安紫陌春归早。\n亸垂杨、染芳草。\n被啼莺语燕催清晓。\n正好梦、频惊觉。\n当此际、青楼临大道。\n幽会处、两情多少。\n莫惜明珠百琲，占取长年少。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57436,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"连理枝 其二","author":"晏殊","text":"绿树莺声老。\n金井生秋早。\n不寒不暖，裁衣按曲，天时正好。\n况兰堂逢著寿筵开，见炉香缥缈。\n组绣呈纤巧。\n歌舞夸妍妙。\n玉酒频倾，朱弦翠管，移宫易调。\n献金杯重叠祝长生，永逍遥奉道。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57437,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"连理枝 其一","author":"晏殊","text":"玉宇秋风至。\n帘幕生凉气。\n朱槿犹开，红莲尚拆，芙蓉含蕊。\n送旧巢归燕拂高檐，见梧桐叶坠。\n嘉宴凌晨启。\n金鸭飘香细。\n凤竹鸾丝，清歌妙舞，尽呈游艺。\n愿百千遐寿比神仙，有年年岁岁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57438,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"拂霓裳 其一","author":"晏殊","text":"庆生辰。\n庆生辰是百千春。\n开雅宴，画堂高会有诸亲。\n钿函封大国，玉色受丝纶。\n感皇恩。\n望九重、天上拜尧云。\n今朝祝寿，祝寿数，比松椿。\n斟美酒，至心如对月中人。\n一声檀板动，一炷蕙香焚。\n祷仙真。\n愿年年今日、喜长新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57439,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"拂霓裳 其三","author":"晏殊","text":"乐秋天。\n晚荷花缀露珠圆。\n风日好，数行新雁贴寒烟。\n银簧调脆管，琼柱拨清弦。\n捧觥船。\n一声声、齐唱太平年。\n人生百岁，离别易，会逢难。\n无事日，剩呼宾友启芳筵。\n星霜催绿鬓，风露损朱颜。\n惜清欢。\n又何妨、沈醉玉尊前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57440,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"拂霓裳 其二","author":"晏殊","text":"喜秋成。\n见千门万户乐升平。\n金风细，玉池波浪縠文生。\n宿露沾罗幕，微凉入画屏。\n张绮宴，傍熏炉蕙炷、和新声。\n神仙雅会，会此日，象蓬瀛。\n管弦清，旋翻红袖学飞琼。\n光阴无暂住，欢醉有闲情。\n祝辰星。\n愿百千为寿、献瑶觥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57441,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"采桑子 其七","author":"晏殊","text":"林间摘遍双双叶，寄与相思。\n朱槿开时。\n尚有山榴一两枝。\n荷花欲绽金莲子，半落红衣。\n晚雨微微。\n待得空梁宿燕归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57442,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"采桑子 其五 石竹","author":"晏殊","text":"古罗衣上金针样，绣出芳妍。\n玉砌朱阑。\n紫艳红英照日鲜。\n佳人画阁新妆了，对立丛边。\n试摘婵娟。\n贴向眉心学翠钿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57443,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"采桑子 其六","author":"晏殊","text":"时光只解催人老，不信多情，长恨离亭，泪滴春衫酒易醒。\n梧桐昨夜西风急，淡月胧明，好梦频惊，何处高楼雁一声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57444,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"采桑子 其三","author":"晏殊","text":"阳和二月芳菲遍，暖景溶溶。\n戏蝶游蜂。\n深入千花粉艳中。\n何人解系天边日，占取春风。\n免使繁红。\n一片西飞一片东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57445,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"采桑子 其一","author":"晏殊","text":"春风不负东君信，遍拆群芳。\n燕子双双。\n依旧衔泥入杏梁。\n须知一盏花前酒，占得韶光。\n莫话匆忙。\n梦里浮生足断肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57446,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"采桑子 其二","author":"晏殊","text":"红英一树春来早，独占芳时。\n我有心期。\n把酒攀条惜绛蕤。\n无端一夜狂风雨，暗落繁枝。\n蝶怨莺悲。\n满眼春愁说向谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57447,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨中花令","author":"晏殊","text":"剪翠妆红欲就。\n折得清香满袖。\n一对鸳鸯眠未足，叶下长相守。\n莫傍细条寻嫩藕。\n怕绿刺、罥衣伤手。\n可惜许、月明风露好，恰在人归后。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57448,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"临江仙","author":"晏殊","text":"资善堂中三十载，旧人多是凋零。\n与君相见最伤情。\n一尊如旧，聊且话平生。\n此别要知须强饮，雪残风细长亭。\n待君归觐九重城。\n帝宸思旧，朝夕奉皇明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57449,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"点绛唇","author":"晏殊","text":"露下风高，井梧宫簟生秋意。\n画堂筵启。\n一曲呈珠缀。\n天外行云，欲去凝香袂。\n炉烟起。\n断肠声里。\n敛尽双蛾翠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57450,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"相思儿令 其一","author":"晏殊","text":"昨日探春消息，湖上绿波平。\n无奈绕堤芳草，还向旧痕生。\n有酒且醉瑶觥。\n更何妨、檀板新声。\n谁教杨柳千丝，就中牵系人情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57451,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"相思儿令 其二","author":"晏殊","text":"春色渐芳菲也，迟日满烟波。\n正好艳阳时节，争奈落花何。\n醉来拟恣狂歌。\n断肠中、赢得愁多。\n不如归傍纱窗，有人重画双蛾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57452,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋蕊香 其一","author":"晏殊","text":"梅蕊雪残香瘦。\n罗幕轻寒微透。\n多情只是春杨柳。\n占断可怜时候。\n萧娘劝我杯中酒。\n翻红袖。\n金乌玉兔长飞走。\n争得朱颜依旧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57453,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋蕊香 其二","author":"晏殊","text":"向晓雪花呈瑞。\n飞遍玉城瑶砌。\n何人剪碎天边桂。\n散作瑶田琼蕊。\n萧娘敛尽双蛾翠。\n回香袂。\n今朝有酒今朝醉。\n遮莫更长无睡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57454,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"胡捣练","author":"晏殊","text":"小桃花与早梅花，尽是芳妍品格。\n未上东风先拆。\n分付春消息。\n佳人钗上玉尊前，朵朵秾香堪惜。\n谁把彩毫描得。\n免恁轻抛掷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57455,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其三","author":"晏殊","text":"青杏园林煮酒香。\n佳人初试薄罗裳。\n柳丝无力燕飞忙。\n乍雨乍晴花自落，闲愁闲闷日偏长。\n为谁消瘦减容光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57456,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其五","author":"晏殊","text":"红蓼花香夹岸稠。\n绿波春水向东流。\n小船轻舫好追游。\n渔父酒醒重拨棹，鸳鸯飞去却回头。\n一杯销尽两眉愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57457,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其四","author":"晏殊","text":"一曲新词酒一杯，去年天气旧亭台，夕阳西下几时回。\n无可奈何花落去，似曾相识燕归来。\n小园香径独徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57458,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其二","author":"晏殊","text":"三月和风满上林。\n牡丹妖艳直千金。\n恼人天气又春阴。\n为我转回红脸面，向谁分付紫檀心。\n有情须殢酒杯深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57459,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其九","author":"晏殊","text":"绿叶红花媚晓烟。\n黄蜂金蕊欲披莲。\n水风深处懒回船。\n可惜异香珠箔外，不辞清唱玉尊前。\n使星归觐九重天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57460,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其十一","author":"晏殊","text":"杨柳阴中驻彩旌。\n芰荷香里劝金觥。\n小词流入管弦声。\n只有醉吟宽别恨，不须朝暮促归程。\n雨条烟叶系人情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57461,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其六","author":"晏殊","text":"淡淡梳妆薄薄衣。\n天仙模样好容仪。\n旧欢前事入颦眉。\n闲役梦魂孤烛暗，恨无消息画帘垂。\n且留双泪说相思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57462,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其十三","author":"晏殊","text":"玉碗冰寒滴露华。\n粉融香雪透轻纱。\n晚来妆面胜荷花。\n鬓亸欲迎眉际月，酒红初上脸边霞。\n一场春梦日西斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57463,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其十二","author":"晏殊","text":"一向年光有限身，等闲离别易销魂。\n酒筵歌席莫辞频。\n满目山河空念远，落花风雨更伤春。\n不如怜取眼前人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57464,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其七","author":"晏殊","text":"小阁重帘有燕过。\n晚花红片落庭莎。\n曲阑干影入凉波。\n一霎好风生翠幕，几回疏雨滴圆荷。\n酒醒人散得愁多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57465,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其一","author":"晏殊","text":"湖上西风急暮蝉。\n夜来清露湿红莲。\n少留归骑促歌筵。\n为别莫辞金盏酒，入朝须近玉炉烟。\n不知重会是何年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57466,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其八","author":"晏殊","text":"宿酒才醒厌玉卮。\n水沈香冷懒熏衣。\n早梅先绽日边枝。\n寒雪寂寥初散后，春风悠扬欲来时。\n小屏闲放画帘垂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57467,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其一","author":"晏殊","text":"阆苑瑶台风露秋。\n整鬟凝思捧觥筹。\n欲归临别强迟留。\n月好谩成孤枕梦，酒阑空得两眉愁。\n此时情绪悔风流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57468,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"破阵子 其三","author":"晏殊","text":"忆得去年今日，黄花已满东篱。\n曾与玉人临小槛，共折香英泛酒卮。\n长条插鬓垂。\n人貌不应迁换，珍丛又睹芳菲。\n重把一尊寻旧径，所惜光阴去似飞。\n风飘露冷时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57469,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"破阵子 春景","author":"晏殊","text":"燕子来时新社，梨花落后清明。\n池上碧苔三四点，叶底黄鹂一两声，日长飞絮轻。\n巧笑东邻女伴，采桑径里逢迎。\n疑怪昨宵春梦好，元是今朝斗草赢，笑从双脸生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57470,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]