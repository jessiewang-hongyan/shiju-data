[{"title":"宫词 其六十六","author":"王圭","text":"蕙炷香销烛影残，御衣薰尽彻更阑。\n归来困顿眠红帐，一枕西风梦里寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40148,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其六十七","author":"王圭","text":"东宫降诞挺佳辰，少海星边拥瑞云。\n中尉传开三日宴，翰林当撰洗儿文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40149,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其七十四","author":"王圭","text":"盘龙新织翠云裘，点检黄封玉匣收。\n防备秋来供御着，金箱捧入曝衣楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40150,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其八十六","author":"王圭","text":"大家装著斗时宜，独自寻常拂淡眉。\n为染浅黄衫子色，金盆添水看鹅儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40151,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其九十五","author":"王圭","text":"萱草成窠杏子青，夜闻禁漏晓闻莺。\n吹回一觉昭阳梦，帐外春风太薄情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40152,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"王圭","text":"十字水中分岛屿，数重花外见楼台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40153,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其四","author":"王圭","text":"年年三祝候尧蓂，清晓焚香启机扃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40154,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其五","author":"王圭","text":"禁籞平明帐殿开，华芝初下未央来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40155,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"乌栖曲二首 其二","author":"司马光","text":"星疏月明漏水长，罗帷翠帐华灯光。\n佳人起舞玉钗堕，门外乌栖雁南过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40156,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和之美舟行杂诗八首 其二 舟中夜坐","author":"司马光","text":"汀沙落席帆，岸柳萦单舸。\n小市远微茫，簇水初灯火。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40157,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又和秋怀","author":"司马光","text":"畴昔共登仕，尔来三十秋。\n常晞丝绳直，窃耻鸱夷柔。\n蹄涔学钜海，蚁垤依崇丘。\n行之不自疑，亲寡憎怨稠。\n于今不亟去，沦胥恐同流。\n努力买良田，远追沮溺游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40158,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"康定中予过洛桥南得诗两句于今三十二年矣再过其处足成一章","author":"司马光","text":"铜驼陌上桃花红，洛阳无处无春风。\n重来羞见水中影，鬓毛萧飒如秋蓬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40159,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"座中呈子骏尧夫","author":"司马光","text":"微雨虽妨行乐，薄寒却解留花。\n今日且游小圃，明朝更向谁家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40160,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"友人楚孟德过余纵言及神仙余谓之无孟德谓之有伊人也非诞妄者盖有以知之矣然余俗士终疑之故作游仙曲五章以佐戏笑云 其三","author":"司马光","text":"若士北游穷地角，还食蛤蜊养龟壳。\n卢敖尸骨不能飞，今朝九垓何处期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40161,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"边将 其三","author":"司马光","text":"横吹长笛千万骑，将军塞北立功回。\n边人争出孤城望，渐见旌旗天外来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40162,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"虞部刘员外约游金明光以贱事失期刘惠诗见嘲以诗四首谢之 其四","author":"司马光","text":"上苑花繁高覆墙，曲堤风暖柳丝长。\n炉边应有步兵尉，瓮下难寻吏部郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40163,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和之美河西列岫亭 其二","author":"司马光","text":"亭皋资远瞩，秋思浩无涯。\n雁唼牵菱蔓，童歌出荻花。\n垄荒犹叱犊，枝暗稍栖鸦。\n烟霭藏东渚，凭轩莫望家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40164,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"钓鱼有感 其二","author":"司马光","text":"野钓披榛竹，无人知往来。\n高空飞不下，鸥鸟已相猜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40165,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄郑县史令千之 其二","author":"司马光","text":"长春宫柳远扶疏，新树应多旧已枯。\n蠹柱苔墙偏寻历，古亭犹有杜诗无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40166,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"哭公素 其二","author":"司马光","text":"丹旌倚輤车，荣辱尽虚无。\n半道骅骝顿，先秋兰雨枯。\n儿痴才过龀，亲老不胜扶。\n家事今萧瑟，宁将未第殊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40167,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"奉和始平公酬大资政吴侍郎 其二","author":"司马光","text":"䆉稏千塍碧，芙蕖万顷香。\n跨波横略彴，逼地亚筼筜。\n大野禾麻溢，高斋几席凉。\n夔龙屡赓唱，东壁正垂光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40168,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"坐船","author":"司马光","text":"使君张皂盖，高宴碧湖心。\n苒蒻牵菱蔓，夷犹泊柳阴。\n晚风侵坐冷，春浪没篙深。\n倒载归何晚，波间夕照沈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40169,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"孟尝","author":"司马光","text":"冠盖盈门意气豪，海鱼兼雨未充庖。\n归来散尽三千客，方悟时人市道交。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40170,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读颍公清风集 其三","author":"司马光","text":"佳城郁郁閟英灵，幸有文章见典型。\n开卷未终双袖湿，目前彷佛对渊庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40171,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谒三门禹祠 其二","author":"司马光","text":"赑屃青崖裂，喧豗白浪豪。\n客舟浮木叶，生理脱鸿毛。\n柏映孤峰短，铭书绝壁高。\n河师不耕织，容易戏风涛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40172,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春贴子词 皇后阁五首 其一","author":"司马光","text":"穜稑献新种，祎褕浣旧衣。\n玉钩随步辇，行看采桑归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40173,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春贴子词 皇后阁五首 其五","author":"司马光","text":"春衣不用蕙兰薰，领缘无烦刺绣文。\n曾在蚕宫亲织紞，方知缕缕尽辛勤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40174,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和景仁题崇福宫 其二","author":"司马光","text":"不独山头白，人头亦垂素。\n积雪有时消，青山色如故。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40175,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"污亭","author":"司马光","text":"杂花乱种盘涡底，小屋深居鉴燧心。\n朝市嚣声那得到，晨昏暑气不能侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40176,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"药轩","author":"司马光","text":"雨馀条甲绕阶生，往往桐君昔未名。\n采贮不须勤暴彗，秋阳日日满檐楹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40177,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三月二十五日安之以诗二绝见招作真率会光以无从者不及赴依韵和呈 其一","author":"司马光","text":"真率由来无次第，经旬踰月不为稀。\n蓝舆但恨无人举，坐想纷纷醉落晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40178,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和秉国寄子骏尧夫二留台","author":"司马光","text":"一台二妙日追游，琥珀香醪白玉瓯。\n相下不厌贤者意，尚言执友欠龙头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40179,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"效赵学士体成口号十章献开府太师 其六","author":"司马光","text":"过春稀复到诸园，厌苦终朝鼓吹喧。\n招得老僧江外至，啜茶挥麈话松轩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40180,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又书一绝戏呈","author":"司马光","text":"伯常远自郢中回，喜与愁心相继来。\n幸得蒹葭依玉树，愁将瓦砾报琼瑰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40181,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"今古路行","author":"司马光","text":"出门道路多，纵横不我测。\n我今欲远行，须问曾行客。\n徐徐逢路人，咨问青松侧。\n客曰君何往，答曰游京邑。\n客乃指要路，而言行有益。\n古路虽大道，不如今路直。\n但行今人路，犹如假羽翼。\n彼客别我去，独自踟蹰立。\n为见今古路，无乃须差忒。\n今路足轮蹄，古路饶荆棘。\n欲行今人路，恐背古人迹。\n拟行古人路，今人笑迂僻。\n又拟不出门，奈有饥寒逼。\n哀哀于此情，悠悠苍天色。\n不避今人嫌，路须行古陌。\n古陌虽然远，且保无厥失。\n勉哉自勉哉，前古难知识。\n不复见杨朱，万古凝愁魄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40182,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"去年冬辙以起居郎入侍迩英讲不逾时迁中书舍人虽忝冒愈深而瞻望清光与日俱远追记当时所见作四绝句呈同省诸公 其三","author":"苏辙","text":"早岁西厢跪直言，起迎天步晚临轩。\n何知老侍曾孙圣，欲泣龙髯吐复吞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40183,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"去年冬辙以起居郎入侍迩英讲不逾时迁中书舍人虽忝冒愈深而瞻望清光与日俱远追记当时所见作四绝句呈同省诸公 其四","author":"苏辙","text":"讲罢渊然似不胜，诗书默已契天心。\n高宗问答终垂世，未信诸儒测浅深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40184,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"洋州三十景 其二十九 溪花亭","author":"鲜于侁","text":"湖源深可酾，溪水清能照。\n坐见落花来，不知春色老。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40185,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"熙春台 其一","author":"李详","text":"地回仙岛风光别，人在春台笑语温。\n事简民淳知帝力，时和岁稔荷天恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40186,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"熙春台 其二","author":"李详","text":"帘珠虚明十二栏，翛然身世尚人间。\n怪来拾得无尘句，放出云屏几叠山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40187,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其十六","author":"张公庠","text":"二月犹寒未有雷，江梅才谢小桃开。\n宫娥不放珠帘下，待得东风送燕归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40188,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其四十五","author":"张公庠","text":"上番宫女捲帘时，闪闪寒鸦拂晓啼。\n才索赭迎催进辇，紫宸门外报班齐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40189,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其六十一","author":"张公庠","text":"霞散云消无一毫，四垂天幕露华高。\n兰闺妆罢移红烛，金斗温温熨御袍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40190,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其八十三","author":"张公庠","text":"倦饮人闲春欲回，日华多处五云开。\n杨花满地东风转，半作轻毬衮衮来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40191,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其九十八","author":"张公庠","text":"自匀轻黛怯春寒，巧画双眉称绿鬟。\n楼上远山随指见，槛中新月对人弯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40192,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"李山甫","text":"世上几时曾好古。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40193,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"古乐府 其二 虞帝庙乐歌辞","author":"张载","text":"虞之阳兮漓之浒，皇降集兮巫屡舞。\n桂酒湛兮瑶觞，皇之归兮何所。\n听驾兮天门，羽毛兮缤纷。\n俯故宫兮一慨，越宇宙兮无邻。\n无邻兮奈何，七政协兮群生嘉。\n信玄功兮不宰，犹彷佛兮山阿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40194,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"刘阳归鸿阁","author":"张载","text":"帘捲晴空独倚阑，冥鸿点点无无间。\n秋风注目无人会，时与白云相对闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40195,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠李纲","author":"释宗本","text":"青共立，米去皮。\n此时节，甚光辉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40196,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"临终偈 其一","author":"释宗本","text":"百骸溃散寻常事，一物长灵识者稀。\n争似大梅知底意，无声三昧證缘知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40197,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"临终偈 其二","author":"释宗本","text":"两年脾疾苦相攻，瘦骨崚嶒鹤足同。\n赖有真常无病者，湛然常在寂光中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40198,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"昨日纳还公择诗卷相次复示三篇不独说茶曲尽其妙加以敏捷不易追攀辄罄鄙言聊答嘉贶 其三","author":"苏颂","text":"吟君三绝重徘徊，不复言诗为鼎来。\n咏到茶中精绝处，犹如笔下役风雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40199,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"明妃曲二首 其二","author":"王安石","text":"明妃初嫁与胡儿，毡车百两皆胡姬。\n含情欲说独无处，传与琵琶心自知。\n黄金捍拨春风手，弹看飞鸿劝胡酒。\n汉宫侍女暗垂泪，沙上行人却回首。\n汉恩自浅胡自深，人生乐在相知心。\n可怜青冢已芜没，尚有哀弦留至今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40200,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"彼狂","author":"王安石","text":"上古杳默无人声，日月不忒山川平。\n人与鸟兽相随行，祖孙一死十百生。\n万物不给乃相兵，伏羲画法作后程。\n渔虫猎兽宽群争，势不得已当经营。\n非以示世为聪明，方分类别物有名。\n夸贤尚功列耻荣，蛊伪日巧雕元精。\n至言一出众辄惊，上智闭匿不敢成。\n因时就俗救刖黥，惜哉彼狂以文鸣。\n强取色乐要聋盲，震荡沈浊终无清。\n诙诡徒乱圣人氓，岂若泯默死蚕耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40201,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题郢州白雪楼","author":"王安石","text":"折杨黄华笑者多，阳春白雪和者少。\n知音四海无几人，况乃区区郢中小。\n千载相传始欲慕，一时独唱谁能晓。\n古心以此分冥冥，俚耳至今徒扰扰。\n朱楼碧瓦何年有，榱桷连空欲惊矫。\n郢人烂漫醉浮云，郢女参差蹑飞鸟。\n丘墟馀响难再得，栏槛兹名复谁表。\n我来欲歌声更吞，石城寒江暮云绕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40202,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送谢师宰赴任楚州 其二","author":"王安石","text":"昆崙一支流向东，七月八月船如风。\n爱君少壮此行乐，恨我留连成老翁。\n神头两岸水无穷，伏槛荷花满地红。\n当时不得君携手，今日山川在眼中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40203,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与道原过西庄遂游宝乘道原游西庵遂至草堂宝乘寺二首 其二","author":"王安石","text":"亲朋会合少，时序感伤多。\n胜践聊为乐，清谈可当歌。\n微风淡水竹，净日暖烟萝。\n兴极犹难尽，当如薄暮何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40204,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"发馆陶","author":"王安石","text":"促辔数残更，似闻鸡一鸣。\n春风马上梦，沙路月中行。\n笳鼓远多思，衣裘寒始轻。\n稍知田父稳，灯火闭柴荆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40205,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和王微之秋浦望齐山感李太白杜牧之","author":"王安石","text":"齐山置酒菊花开，秋浦闻猿江上哀。\n此地流传空笔墨，昔人埋没已蒿莱。\n平生志业无高论，末世篇章有逸才。\n尚得使君驱五马，与寻陈迹久徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40206,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题思轩","author":"王安石","text":"名郎此地昔徘徊，天诱良孙接踵来。\n万屋尚歌馀泽在，一轩还向旧堂开。\n右军笔墨空残沼，内史文章祇废台。\n邑子从今誇胜事，岂论王谢世称才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40207,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"除夜寄舍弟","author":"王安石","text":"一尊聊有天涯忆，百感翻然醉里眠。\n酒醒灯前犹是客，梦回江北已经年。\n佳时流落真何得，胜事蹉跎只可怜。\n唯有到家寒食在，春风因泛滪溪船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40208,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题黄司理园","author":"王安石","text":"为忆去年梅，凌寒特地来。\n闰前空腊尽，浑未有花开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40209,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"泊雁","author":"王安石","text":"泊雁鸣深渚，收霞落晚川。\n柝随风敛阵，楼映月低弦。\n漠漠汀帆转，幽幽岸火然。\n壑危通细路，沟曲绕平田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40210,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"竹里","author":"王安石","text":"竹里编茅倚石根，竹茎疏处见前村。\n闲眠尽日无人到，自有春风为扫门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40211,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"耿天骘惠梨次韵奉酬三首 其一","author":"王安石","text":"故人家果独难忘，秋实初成便得尝。\n直使紫花形味胜，岂能终日望咸阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40212,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"耿天骘惠梨次韵奉酬三首 其二","author":"王安石","text":"淮圃新阴百亩凉，分甘每得助秋尝。\n张公大谷虽云美，谁肯苞苴出晋阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40213,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"耿天骘惠梨次韵奉酬三首 其三","author":"王安石","text":"甘滋南北共传誇，栽接还如老圃家。\n谁谓交梨非外奖，因君浇灌已萌芽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40214,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"北山有怀","author":"王安石","text":"香火因缘寄此山，主恩投老更人间。\n伤心踯躅冈头路，明日春风自往还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40215,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"定林院","author":"王安石","text":"穷谷经春不识花，新松老柏自攲斜。\n慇勤更上山头望，白下城中有几家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40216,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"独卧二首 其一","author":"王安石","text":"谁有锄耰不自操，可怜园地满蓬蒿。\n欲寻春物无蹊径，独卧南床白日高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40217,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"独卧二首 其二","author":"王安石","text":"茅檐午影转悠悠，门闭青苔水乱流。\n百啭黄鹂看不见，海棠无数出墙头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40218,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"仓颉","author":"王安石","text":"仓颉造书，不诂自明。\n于乎多言，祇误后生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40219,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]