[{"title":"桃源忆故人 其五","author":"朱敦儒","text":"谁能留得朱颜住。\n枉了百般辛苦。\n争似萧然无虑。\n任运随缘去。\n人人放著逍遥路。\n只怕君心不悟。\n弹指百年今古。\n有甚成亏处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39510,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其三","author":"朱敦儒","text":"银海清泉洗玉杯。\n恰篘白酒冷偏宜。\n水林檎嫩折青枝。\n争看使君长寿曲，旋教法部太平词。\n快风凉雨火云摧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39511,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其一 季钦拥双妙丽，使来求长短句，为赋","author":"朱敦儒","text":"折桂归来懒觅官。\n十年风月醉家山。\n有人挟瑟伴清闲。\n楚畹飞香兰结佩，蓝田生暖玉连环。\n拥书万卷看双鸾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39512,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其五","author":"朱敦儒","text":"雨湿清明香火残。\n碧溪桥外燕泥寒。\n日长独自倚阑干。\n脱箨修篁初散绿，褪花新杏未成酸。\n江南春好与谁看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39513,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其六","author":"朱敦儒","text":"风落芙蓉画扇闲。\n凉随春色到人间。\n乍垂罗幕乍飞鸾。\n好把深杯添绿酒，休拈明镜照苍颜。\n浮生难得是清欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39514,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其四","author":"朱敦儒","text":"碧玉栏干白玉人。\n倚花吹叶忍黄昏。\n萧郎一去又经春。\n眉澹翠峰愁易聚，脸残红雨泪难匀。\n纤腰减半绿罗裙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39515,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其七","author":"朱敦儒","text":"才子佳人相见难。\n舞收歌罢又更阑。\n密将春恨系幽欢。\n结子同心香佩带，帕儿双字玉连环。\n酒醒灯暗忍重看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39516,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其二 玄真子有渔父词，为添作","author":"朱敦儒","text":"西塞山边白鹭飞。\n吴兴江上绿杨低。\n桃花流水鳜鱼肥。\n青箬笠将风里戴，短蓑衣向雨中披。\n斜风细雨不须归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39517,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浪淘沙令 其二 康州泊船","author":"朱敦儒","text":"风约雨横江。\n秋满篷窗。\n个中物色尽凄凉。\n更是行人行未得，独系归艎。\n拥被换残香。\n黄卷堆床。\n开愁展恨剪思量。\n伊是浮云侬是梦，休问家乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39518,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浪淘沙令 其一 中秋阴雨，同显忠、椿年、谅之坐寺门作","author":"朱敦儒","text":"圆月又中秋。\n南海西头。\n蛮云瘴雨晚难收。\n北客相逢弹泪坐，合恨分愁。\n无酒可销忧。\n但说皇州。\n天家宫阙酒家楼。\n今夜只应清汴水，呜咽东流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39519,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浪淘沙令 其三","author":"朱敦儒","text":"白菊好开迟。\n冷蝶空迷。\n沾风惹露也随时。\n何事深藏偏在后，天性难移。\n陶令最怜伊。\n同病相医。\n寒枝瘦叶更栽培。\n直待群芳零落后，独殿东篱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39520,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"减字木兰花 其八","author":"朱敦儒","text":"无知老子。\n元住渔舟樵舍里。\n暂借权监。\n持节纡朱我甚惭。\n不能者止。\n免苦龟肠忧虎尾。\n身退心闲。\n剩向人间活几年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39521,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"减字木兰花 其七 秋日饮酒香山石楼醉中作","author":"朱敦儒","text":"古人误我。\n独舞西风双泪堕。\n鹤去无踪。\n木落西陵返照红。\n人间难住。\n掷下酒杯何处去。\n楼锁钟残。\n山北山南两点烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39522,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"减字木兰花 其四","author":"朱敦儒","text":"闲人行李。\n羽扇芒鞋尘世外。\n一叠溪山。\n也解分风送客帆。\n时平易醉。\n无复惊心并溅泪。\n长揖忘言。\n回棹桃花插满船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39523,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"减字木兰花 其六","author":"朱敦儒","text":"慵歌怕酒。\n今日春衫惊著瘦。\n双燕帘栊。\n金鸭香沈客泪中。\n琵琶重听。\n谁信人间多少恨。\n落日东风。\n吹得桃花满院红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39524,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"减字木兰花 其一","author":"朱敦儒","text":"挼花弄扇。\n碧斗遥山眉黛晚。\n白玉阑干。\n倚遍春风翠袖寒。\n难寻可见。\n何似一双青翅燕。\n人瘦春残。\n芳草连云日下山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39525,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"减字木兰花 其十三","author":"朱敦儒","text":"虚空无碍。\n你自痴迷不自在。\n撒手游行。\n到处笙歌拥路迎。\n天然美满。\n不用些儿心计算。\n莫听先生。\n引入深山百丈坑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39526,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"减字木兰花 其九","author":"朱敦儒","text":"斫鱼作鲊。\n酒面打开香可榨。\n相唤同来。\n草草杯盘饮几杯。\n人生虚假。\n昨日梅花今日谢。\n不醉何为。\n从古英雄总是痴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39527,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"减字木兰花 其二","author":"朱敦儒","text":"寻花携李。\n红漾轻舟汀柳外。\n小簇春山。\n溪雨岩云不饱帆。\n相逢心醉。\n容易堆盘银烛泪。\n痛饮何言。\n犀箸敲残玉酒船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39528,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"减字木兰花 其十二","author":"朱敦儒","text":"年衰人老。\n矍铄支离君莫笑。\n白日青天。\n我自心情胜少年。\n超凡入妙。\n游戏神通随意到。\n酒圣诗仙。\n舞棹虚空驾铁船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39529,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"减字木兰花 其三","author":"朱敦儒","text":"东风桃李。\n春水绿波花影外。\n载酒胥山。\n祓禊相期落锦帆。\n吾曹一醉。\n却笑新亭人有泪。\n相对清言。\n不觉黄昏雨打船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39530,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"减字木兰花 其一","author":"朱敦儒","text":"今年梅晚。\n懒趁寿阳钗上燕。\n月唤霜催。\n不肯人间取次开。\n低鬟掩袂。\n愁寄玉阑金井外。\n粉瘦香寒。\n独抱深心一点酸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39531,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"减字木兰花 其十七","author":"朱敦儒","text":"江南春水。\n罗幕黄昏寒未退。\n好个相知。\n唱到姮娥敛黛眉。\n夜阑人醉。\n风露无情花有泪。\n画角残时。\n一片参旗红杏西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39532,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"减字木兰花 其十五","author":"朱敦儒","text":"花随人去。\n今夜钱塘江上雨。\n宿酒残更。\n潮过西窗不肯明。\n小罗金缕。\n结尽同心留不住。\n何处长亭。\n绣被春寒掩翠屏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39533,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"减字木兰花 其五","author":"朱敦儒","text":"刘郎已老。\n不管桃花依旧笑。\n要听琵琶。\n重院莺啼觅谢家。\n曲终人醉。\n多似浔阳江上泪。\n万里东风。\n国破山河落照红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39534,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"减字木兰花 其十六","author":"朱敦儒","text":"有何不可。\n依旧一枚闲底我。\n饭饱茶香。\n瞌睡之时便上床。\n百般经过。\n且喜青鞋踏不破。\n小院低窗。\n桃李花开春昼长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39535,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"减字木兰花 其十四","author":"朱敦儒","text":"无人请我。\n我自铺毡松下坐。\n酌酒裁诗。\n调弄梅花作侍儿。\n心欢易醉。\n明月飞来花下睡。\n醉舞谁知。\n花满纱巾月满怀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39536,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"减字木兰花 其十一","author":"朱敦儒","text":"无人惜我。\n我自殷勤怜这个。\n恧峭惺惺。\n不肯随人独自行。\n乾坤许大。\n只在棘针尖上坐。\n依旧多情。\n搂著虚空睡到明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39537,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"望江南/忆江南","author":"朱敦儒","text":"炎昼永，初夜月侵床。\n露卧一丛莲叶畔，芙蓉香细水风凉。\n枕上是仙乡。\n浮世事，能有几多长。\n白日明朝依旧在，黄花非晚是重阳。\n不用苦思量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39538,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"望海潮 丁酉，西内成，乡人请作望幸曲","author":"朱敦儒","text":"嵩高维岳，图书之渊，西都二室三川。\n神鼎定金，麟符刻玉，英灵未称河山。\n谁再整乾坤。\n是挺生真主，浴日开天。\n御归梁苑，驾回汾水凤楼闲。\n升平运属当千。\n眷凝旒暇日，西顾依然。\n银汉诏虹，瑶台赐碧，一新瑞气祥烟。\n重到帝居前。\n怪鹊桥龙阙，飞下人间。\n父老欢呼，翠华来也太平年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39539,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梦玉人引 和祝圣俞","author":"朱敦儒","text":"浪萍风梗，寄人间，倦为客。\n梦里瀛洲，姓名误题仙籍。\n敛翅归来，爱小园、蜕箨筼筜碧。\n新种幽花，戒儿童休摘。\n放怀随分，各逍遥，飞鴳等鹏翼。\n舍此萧闲，问君携杖安适。\n诸彦群英，诗酒皆勍敌。\n太平时，向花前，不醉如何休得。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39540,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清平乐 其五","author":"朱敦儒","text":"春寒雨妥。\n花萼红难破。\n绣线金针慵不作。\n要见秋千无那。\n西邻姊妹丁宁。\n寻芳更约清明。\n画个丙丁帖子，前阶后院求晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39541,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清平乐 其六","author":"朱敦儒","text":"当初相见。\n君恨相逢晚。\n一曲秦筝弹未遍。\n无奈昭阳人怨。\n便教恩浅情疏。\n隔花空望金舆。\n春晚不拈红粉，碧窗自录仙书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39542,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清平乐 其一","author":"朱敦儒","text":"乱红深翠。\n楼阁春风外。\n胡蝶成团飞照水。\n睡鸭无人惊起。\n身闲更觉身轻。\n酒壶歌扇随行。\n芳草绿杨堤畔，一声初听啼莺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39543,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清平乐 其二 木樨","author":"朱敦儒","text":"人间花少。\n菊小芙蓉老。\n冷澹仙人偏得道。\n买定西风一笑。\n前身原是疏梅。\n黄姑点碎冰肌。\n惟有暗香长在，饱参清露霏微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39544,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清平乐 其四","author":"朱敦儒","text":"多寒易雨。\n春事都相误。\n愁过黄昏无著处。\n宝篆烧残香缕。\n低鬟暗摘明珰。\n罗巾挹损残妆。\n檐外几声风玉，丁东敲断人肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39545,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清平乐 其三","author":"朱敦儒","text":"相留不住。\n又趁东风去。\n楼外夕阳芳草路。\n今夜短亭何处。\n杏花斜压阑干。\n朱帘不卷春寒。\n惆怅黄昏前后，离愁酒病厌厌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39546,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渔家傲 其一","author":"朱敦儒","text":"谁转琵琶弹侧调。\n征尘万里伤怀抱。\n客散黄昏庭院悄。\n灯相照。\n春寒燕子归来早。\n可惜韶光虚过了。\n多情人已非年少。\n只恐莺啼春又老。\n知音少。\n人间何处寻芳草。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39547,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渔家傲 其三","author":"朱敦儒","text":"畏暑闲寻湖上径。\n雨丝断送凉成阵。\n风里芙蓉斜不整。\n沈红影。\n约回萍叶波心静。\n催唤吴姬迎小艇。\n妆花烛焰明相映。\n饮到夜阑人却醒。\n风雨定。\n欲归更把阑干凭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39548,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渔家傲 其二 石夷仲一姬去，念之，止小妓燕燕","author":"朱敦儒","text":"鉴水稽山尘不染。\n归来贺老身强健。\n有客跨鲸游汗漫。\n留羽扇。\n玉船取酒青鸾劝。\n莫恨飞花容易散。\n仙家风味何曾减。\n春色一壶丹九转。\n堪为伴。\n雕梁幸有轻盈燕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39549,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"眼儿媚 其二","author":"朱敦儒","text":"叠翠阑红斗纤浓。\n云雨绮为栊。\n只忧谢了，偏须著意，障雨遮风。\n瑞云香雾虽难觅，蓦地有时逢。\n不妨守定，从他人笑，老入花丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39550,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"眼儿媚 其一 席上瑞香","author":"朱敦儒","text":"青锦成帏瑞香浓。\n雅称小帘栊。\n主人好事，金杯留客，共倚春风。\n不知因甚来尘世，香似旧曾逢。\n江梅退步，幽兰偷眼，回避芳丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39551,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"眼儿媚 其三","author":"朱敦儒","text":"紫帔红襟艳争浓。\n光彩烁疏栊。\n香为小字，瑞为高姓，道骨仙风。\n此花合向瑶池种，可惜未遭逢。\n阿环见了，羞回眼尾，愁聚眉丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39552,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 其二","author":"朱敦儒","text":"芭蕉叶上秋风碧。\n晚来小雨流苏湿。\n新窨木樨沈。\n香迟斗帐深。\n无人同向夕。\n还是愁成忆。\n忆昔结同心。\n鸳鸯何处寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39553,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 其五","author":"朱敦儒","text":"芙蓉红落秋风急。\n夜寒纸帐霜华湿。\n枕畔木瓜香。\n晓来清兴长。\n轻舟青箬笠。\n短棹溪光碧。\n去觅谢三郎。\n芦花何处藏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39554,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 其四","author":"朱敦儒","text":"乡关散尽当年客。\n春风寂寞花无色。\n长日掩重门。\n江山眼外昏。\n画图高挂壁。\n嵩少参差碧。\n想见卧云人。\n松黄落洞门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39555,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 其一","author":"朱敦儒","text":"老人谙尽人间苦。\n近来恰似心头悟。\n九九是重阳。\n重阳菊散芳。\n出门何处去。\n对面谁相语。\n枕臂卧南窗。\n铜炉柏子香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39556,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 其三","author":"朱敦儒","text":"风流才子倾城色。\n红缨翠幰长安陌。\n夜饮小平康。\n暖生银字簧。\n持杯留上客。\n私语眉峰侧。\n半冷水沈香。\n罗帷宫漏长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39557,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谒金门 和李士举","author":"朱敦儒","text":"春怎恋。\n楼外绿催红殿。\n短袖迎风愁半卷。\n手寒无处暖。\n目断蓬莱宫殿。\n引去谁怜谁怨。\n相见不如青翅燕。\n举头长安远。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39558,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"朝中措 其四 上元席上和赵智夫，时小雨","author":"朱敦儒","text":"东方千骑拟三河。\n灯夕试春罗。\n想是蟾宫高会，暂留暮雨姮娥。\n使君燕喜，王孙赋就，桃叶秋波。\n弱柳移来娇舞，落梅换了行歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39559,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"朝中措 其二","author":"朱敦儒","text":"先生筇杖是生涯。\n挑月更担花。\n把住都无憎爱，放行总是烟霞。\n飘然携去，旗亭问酒，萧寺寻茶。\n恰似黄鹂无定，不知飞到谁家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39560,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"朝中措 其八","author":"朱敦儒","text":"新来省悟一生痴。\n寻觅上天梯。\n抛失眼前活计，踏翻暗里危机。\n莫言就错，真须悔过，休更迟疑。\n要识天苏陀味，元来只是黄齑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39561,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"朝中措 其一","author":"朱敦儒","text":"胸中尘土久无奇。\n今夕借清辉。\n歌纵群英诸彦，舞狂蕙带荷衣。\n鸳鸯湖上，波平岸远，酒酽鱼肥。\n好是中秋圆月，分明天下人知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39562,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"朝中措 其九","author":"朱敦儒","text":"登临何处自销忧。\n直北看扬州。\n朱雀桥边晚市，石头城下新秋。\n昔人何在，悲凉故国，寂寞潮头。\n个是一场春梦，长江不住东流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39563,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"朝中措 其六","author":"朱敦儒","text":"元宵初过少吹弹。\n楼角彩灯残。\n踏雪闲寻深院，携壶试觅幽欢。\n麻姑暂语，文君未寝，五老双鸾。\n要共梅花同晓，薄罗不耐春寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39564,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"朝中措 其三","author":"朱敦儒","text":"当年弹铗五陵间。\n行处万人看。\n雪猎星飞羽箭，春游花簇雕鞍。\n飘零到此，天涯倦客，海上苍颜。\n多谢江南苏小，尊前怪我青衫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39565,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"朝中措 其十一","author":"朱敦儒","text":"红稀绿暗掩重门。\n芳径罢追寻。\n已是老于前岁，那堪穷似他人。\n一杯自劝，江湖倦客，风雨残春。\n不是酴醾相伴，如何过得黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39566,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"朝中措 其五","author":"朱敦儒","text":"闲愁无奈指频弹。\n芳景为谁残。\n可惜良宵虚过，且容草草谋欢。\n招要楚雨，留连汉佩，多谢青鸾。\n浓艳暗香争暖，罗帷不用遮寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39567,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"朝中措 其七","author":"朱敦儒","text":"夜来听雪晓来看。\n惊失却尘寰。\n摇撼琼林玉树，心疑身是仙官。\n乘风缥缈，凌空径去，不怕高寒。\n却被孤鸿相劝，何如且在人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39568,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"朝中措 其一","author":"朱敦儒","text":"先生馋病老难医。\n赤米餍晨炊。\n自种畦中白菜，腌成瓮里黄齑。\n肥葱细点，香油慢煼，汤饼如丝。\n早晚一杯无害，神仙九转休痴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39569,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"聒龙谣 其二","author":"朱敦儒","text":"凭月携箫，溯空秉羽，梦踏绛霄仙去。\n花冷街榆，悄中天风露。\n并真官、蕊佩芬芳，望帝所、紫云容与。\n享钧天、九奏传觞，听龙啸，看鸾舞。\n惊尘世，悔平生，叹万感千恨，谁怜深素。\n群仙念我，好人间难住。\n劝阿母、偏与金桃，教酒星、剩斟琼醑。\n醉归时、手授丹经，指长生路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39570,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"聒龙谣 其一","author":"朱敦儒","text":"肩拍洪崖，手携子晋，梦里暂辞尘宇。\n高步层霄，俯人间如许。\n算蜗战、多少功名，问蚁聚、几回今古。\n度银潢、展尽参旗，桂花澹，月飞去。\n天风紧，玉楼斜，舞万女霓袖，光摇金缕。\n明廷宴阕，倚青冥回顾。\n过瑶池、重借双成，就楚岫、更邀巫女。\n转云车、指点虚无，引蓬莱路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39571,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"感皇恩 其二","author":"朱敦儒","text":"早起未梳头，小园行遍。\n拄杖穿花露犹泫。\n菊篱瓜畹。\n最喜引枝添蔓。\n先生独自笑，流莺见。\n著意访寻，幽香国艳。\n千里移根未为远。\n浅深相间。\n最要四时长看。\n群芳休怪我，归来晚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39572,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"感皇恩 其一 游□□园感旧","author":"朱敦儒","text":"曾醉武陵溪，竹深花好。\n玉佩云鬟共春笑。\n主人好事，坐客雨巾风帽。\n日斜青凤舞，金尊倒。\n歌断渭城，月沈星晓。\n海上归来故人少。\n旧游重到。\n但有夕阳衰草。\n恍然真一梦，人空老。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39573,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]