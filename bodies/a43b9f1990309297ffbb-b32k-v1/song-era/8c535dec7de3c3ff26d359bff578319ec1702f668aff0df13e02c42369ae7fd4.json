[{"title":"昼困","author":"韩淲","text":"困来四壁雨，睡觉一窗晴。\n顷刻寒犹煖，移时暗复明。\n扬扬柳絮起，矗矗竹萌生。\n芳槛鸟啼湿，小池鱼队平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26191,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"南窗日午困坐","author":"韩淲","text":"困顿南窗日，衰颓畏隙风。\n酒因寒得策，茶与睡书功。\n不比冯唐老，浑如阮籍穷。\n惊心还嗣岁，随意过残冬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26192,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪中围棋","author":"韩淲","text":"楼外千山雪，年年只欠诗。\n杯停常欲速，棋负不容迟。\n玉振光回合，冰清气眇弥。\n咸言聊自惜，世路易磷缁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26193,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夜坐","author":"韩淲","text":"冷夜灰堆坐，寻诗细拨灯。\n心怀为宛转，语句得凭凌。\n岁晚愁多饮，冬来煖未冰。\n俄听荒犬吠，村静远相仍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26194,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"邻家夜坐","author":"韩淲","text":"灯影摇初夜，寒声落近山。\n酒随人意浅，诗写我身閒。\n莫忿流年速，空搔短发斑。\n然而醒复醉，盖谓往仍还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26195,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"好仁斋夜雨与子似对床","author":"韩淲","text":"湖上归来晚，空斋夜雨声。\n对床惊昨梦，隐几话平生。\n灯净书还读，香销句忽成。\n他年相望处，吾亦用吾情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26196,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"杰上人房午睡","author":"韩淲","text":"喧卑无睡处，犹得到僧床。\n凉润新蒲雨，清熏老柏香。\n不嫌茶作祟，何待醉为乡。\n事事俱离眼，其功接混茫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26197,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次公招饮余子寿同坐","author":"韩淲","text":"老觉过从少，斯文恐不然。\n参天两玉树，忽堕一杯前。\n意象心非石，谈锋思涌泉。\n冰霜冻梅蕊，满眼是新年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26198,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"纵酒","author":"韩淲","text":"纵酒非能饮，长言未是诗。\n年华除夜逼，心事故人为。\n君欲醉须醉，我还归便归。\n南豅到南涧，官柳野梅知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26199,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"示病","author":"韩淲","text":"示病原非病，爱闲方始闲。\n水边宁欠水，山外更多山。\n我岂要人拙，人应嫌我顽。\n腊穷春又立，梅雪共斑斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26200,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"感风发汗卧病数日推枕翛然叙事为十诗 其一","author":"韩淲","text":"病起窗前坐，哦诗一解颜。\n人生祇恁么，世事未如闲。\n朝路谁知旧，田庐自往还。\n从今无别计，风月老溪山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26201,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"感风发汗卧病数日推枕翛然叙事为十诗 其二","author":"韩淲","text":"病起香初炷，蓬蓬喷玉烟。\n丝头方过眼，穗脚忽成拳。\n垢尽心无染，尘销意欲仙。\n吾生太痴绝，臭味乃如然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26202,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"感风发汗卧病数日推枕翛然叙事为十诗 其三","author":"韩淲","text":"病起思新茗，催煎蟹眼汤。\n分来香细腻，啜处味偏长。\n日永门庭静，风轻院宇凉。\n更寻双井试，瓯面乳如霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26203,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"感风发汗卧病数日推枕翛然叙事为十诗 其四","author":"韩淲","text":"病起支颐久，形神稍稍安。\n岂堪誇壮健，只怕已衰残。\n希圣心无倦，求官意渐阑。\n不为君子弃，何恨对瓢箪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26204,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"感风发汗卧病数日推枕翛然叙事为十诗 其五","author":"韩淲","text":"病起水边行，风回柳弄晴。\n岸虚微坼土，涧浅细无声。\n寂寂心逾静，飘飘神转清。\n衣襟带波影，搔首又诗成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26205,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"感风发汗卧病数日推枕翛然叙事为十诗 其六","author":"韩淲","text":"病起呼童语，门前客不来。\n无人理花草，为我扫莓苔。\n只欲寻书帙，何心泥酒杯。\n树阴横涧水，鸥下莫相猜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26206,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"感风发汗卧病数日推枕翛然叙事为十诗 其七","author":"韩淲","text":"病起寻藜杖，闲情孰可论。\n腾身上危径，著眼已高轩。\n城堞看州宅，沙汀识远村。\n幸无衰老相，逸兴且丘园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26207,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"感风发汗卧病数日推枕翛然叙事为十诗 其八","author":"韩淲","text":"病起加餐饭，随宜且菜蔬。\n何须尊有酒，岂叹食无鱼。\n绝不关人事，多惭得自如。\n从他志温饱，我愧腹空虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26208,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"感风发汗卧病数日推枕翛然叙事为十诗 其九","author":"韩淲","text":"病起看儿戏，阶庭闹不休。\n觅钱何所用，得果更无求。\n转觉童心好，翻令老态羞。\n年光正如电，愁入鬓边秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26209,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"感风发汗卧病数日推枕翛然叙事为十诗 其十","author":"韩淲","text":"病起何思虑，空斋读易时。\n沉潜三画象，研究六爻词。\n孔系诚难识，扬玄恐易知。\n乾乾且修业，学处在观颐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26210,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"中岁","author":"韩淲","text":"中岁百事懒，颇觉山林深。\n体适解巾屦，情安弄书琴。\n流年度寒暑，尽日看晴阴。\n穷达苟不委，何以全素襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26211,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"白髭一茎欣然为赋","author":"韩淲","text":"发已经年白，今朝又到须。\n形容真易改，心事合全无。\n晓室开青镜，晴窗据槁梧。\n门前谁送酒，不恨老东吴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26212,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"灯火","author":"韩淲","text":"灯火水边城，闾阎月始明。\n旧年行乐事，新岁合欢声。\n雪后犹含冻，风前未喜晴。\n崇朝雨如泻，沟浍又皆盈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26213,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寒灯","author":"韩淲","text":"拨剔寒灯燄，消停煖酒杯。\n醉从愁畔过，梦自觉中回。\n幽兴故为熟，衰颜底用催。\n小园荒草外，山意数枝梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26214,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"短吟","author":"韩淲","text":"高看复下看，长吟时短吟。\n人宁常适意，世或尽知音。\n灵运穿高屐，渊明理素琴。\n海隅风渺渺，山窟雪森森。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26215,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"即事","author":"韩淲","text":"蒲叶乱阴雨，藤花开煖风。\n涧流攲岸远，山逼小亭空。\n跃黾疏丛外，啼莺密树中。\n望随桥上下，行过屋西东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26216,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春情","author":"韩淲","text":"结绮寻芳去，春光处处多。\n莺花迟日丽，燕麦惠风和。\n翠滴烟林石，红摇晴浪波。\n馀情约重醉，归路听行歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26217,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偶怀","author":"韩淲","text":"已过中秋月，木犀犹少开。\n固尝同客饮，终是欠朋来。\n烈士志何在，幽人唤不回。\n凄风乱红叶，零雨湿荒苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26218,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偶成 其一","author":"韩淲","text":"酒亦逢人饮，诗须任我吟。\n短长徒有兴，醒醉盖无心。\n烂漫欢中趣，幽微得处寻。\n佳时思共赏，良夜忍孤斟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26219,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偶成 其二","author":"韩淲","text":"惜气思仙伎，因心理佛书。\n心安何所觉，气积本乘虚。\n造化融成后，神明主宰初。\n纵疑摩诘赘，未信洞宾疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26220,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偶成 其三","author":"韩淲","text":"出处升沉地，中年付短歌。\n世情时转变，人事日销磨。\n荡寇声虽在，平戎意尚多。\n山空流水急，啼鸟下烟萝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26221,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偶兴","author":"韩淲","text":"老喜交亲熟，贫嫌故旧真。\n山林无长物，天地有垂纶。\n胡蝶身中叶，铜驼世上尘。\n江南要梅雨，耕稼一番新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26222,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"转觉","author":"韩淲","text":"转觉亲知少，旁观事绪多。\n百年从汩没，一句待吟哦。\n小雨催新桂，连阴养晚禾。\n山深秋涧水，清溜亦盘涡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26223,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"隐遁禅参","author":"韩淲","text":"索隐安肥遁，安禅岂饱参。\n有缘皆可到，无闷悉能甘。\n野饭耕而美，村酤醉以酣。\n因思前后际，不与话三三。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26224,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"三月下旬药局书满","author":"韩淲","text":"卖药居吴市，人犹识姓名。\n自惊无遁志，谁信有浮荣。\n野迥林须密，泉深水更清。\n春帆送归棹，天地一身轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26225,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"初五日闻遣戍","author":"韩淲","text":"摇落秋风急，萧条易水寒。\n悲歌谁激烈，宵雅自平宽。\n本道尊中国，何庸伐可汗。\n山居闻备塞，莫厌腐儒餐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26226,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游宦","author":"韩淲","text":"游宦家何似，儿啼婢仆寒。\n敝衣无服饰，薄饭少杯盘。\n原宪贫非病，庞公遗以安。\n江山冬自好，梅已发林端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26227,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"敛膝","author":"韩淲","text":"敛膝贪窗日，抽身避隙风。\n深藏破屋底，困处小楼中。\n旧雪积犹在，新霜冻未空。\n壶浆无剩绿，炉炭尚微红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26228,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书怀","author":"韩淲","text":"古来憎命达，今亦叹才难。\n我自厌时暑，人谁耐岁寒。\n升沉空早计，中外试徐看。\n莫为多穷困，而怀常晏安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26229,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"有怀 其一","author":"韩淲","text":"晏斋风雨夜，门掩是深山。\n绝俗诗编净，怀人书尺闲。\n儿孙今满眼，鸡犬久怡颜。\n万籁定俱寂，高标不可攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26230,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"有怀 其二","author":"韩淲","text":"独行风雨夜，家事复身谋。\n推枕茅檐起，停骖麦陇收。\n亲情离聚矣，故旧往还不。\n抚著时文笑，荣涂遍九州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26231,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"有怀 其三","author":"韩淲","text":"山台风雨夜，一点是青灯。\n独把麟经究，谁知骥志凭。\n隔溪常过客，近寺不闻僧。\n梅夏清清里，翻愁易郁蒸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26232,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"有怀 其四","author":"韩淲","text":"山庵风雨夜，莫惜细论文。\n友直惟家学，僧清岂世氛。\n随宜粥饭好，奚止搢绅云。\n磬歇香灯上，词场自策勋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26233,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"有怀 其五","author":"韩淲","text":"山居风雨夜，吾亦老侵寻。\n搔屑萧萧发，收平耿耿心。\n更初殊不寐，人静尚孤斟。\n尽屏闲书帙，犹馀一破琴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26234,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"有怀 其六","author":"韩淲","text":"泠斋风雨夜，兄弟笑言温。\n灯火莱衣戏，文书马帐尊。\n更声传杳杳，檐溜落纷纷。\n茶果团栾坐，都无官舍喧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26235,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宋监仓挽词","author":"韩淲","text":"祖祢碑铭在，阶庭经术长。\n宦涂钦抚字，祠馆叹行藏。\n北客多先契，中原隔故乡。\n交游真破梦，哀挽不成章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26236,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"太尉武泰节度寿昌侯挽词 其一","author":"韩淲","text":"汉数当时盛，唐知馀庆家。\n至今犹相衮，从昔建高牙。\n阴邓何劳拟，崔卢亦漫誇。\n南来方再世，阀阅本京华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26237,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"太尉武泰节度寿昌侯挽词 其二","author":"韩淲","text":"乾道风云际，公持绣斧初。\n既为澄狱户，常忆使穹庐。\n主圣元无隐，官邪可痛锄。\n闽山江浙水，屈指事堪书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26238,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"太尉武泰节度寿昌侯挽词 其三","author":"韩淲","text":"晚节斋坛拜，勋名已四朝。\n开边屡铜虎，告弟仅金貂。\n壮志自难已，英魂孰得招。\n中原诸老尽，江海听吹箫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26239,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"江西赵漕送丞相行状索挽诗 其一","author":"韩淲","text":"叹息经邦志，恢洪发大魁。\n两宫传眷赏，诸老竞招徕。\n雨露铨衡际，风云史馆开。\n宗英图一相，盛事却生哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26240,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"江西赵漕送丞相行状索挽诗 其二","author":"韩淲","text":"全蜀钦隆委，闽山两帅华。\n中权收节制，入告罄忠嘉。\n宣辇犹持柄，垂帘竟报麻。\n奋身扶日手，国尔信忘家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26241,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"江西赵漕送丞相行状索挽诗 其三","author":"韩淲","text":"任道崇儒素，虚谦不近名。\n门庭规以睦，涂路畏夫清。\n世固推源委，人今孰统盟。\n皇明酬恤典，四表亦欢声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26242,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"李信州挽诗 其一","author":"韩淲","text":"一自南台酒，公今成古人。\n方期千载事，岂料百年身。\n从俗心良苦，安时志欲伸。\n稽山归旐飐，我泪亦沾巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26243,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"李信州挽诗 其二","author":"韩淲","text":"家世既如此，为邦可谓贤。\n廉名前后少，俭德始终全。\n时喜政平矣，吏嫌民晏然。\n下车虽未久，遗爱玉溪边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26244,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"吴雷州挽诗 其一","author":"韩淲","text":"睦信推潜德，饶封代有成。\n海康开郡绂，淮甸入廷评。\n进劄诚良遇，蠲输惜重征。\n诚斋廉茂荐，尤足动簪缨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26245,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"吴雷州挽诗 其二","author":"韩淲","text":"冰壶时泛玉，水宿更云庄。\n捐馆嗟何憾，移庵得所藏。\n开田期族众，浚港见流长。\n普济名陂意，南中保卫方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26246,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"耿和州挽诗 其一","author":"韩淲","text":"叹息馀光旧，吾翁识此公。\n后来持帅阃，勇退有高风。\n示疾带湖上，真祠崇道中。\n伤心华山路，松柏窆幽宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26247,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"耿和州挽诗 其二","author":"韩淲","text":"右学腾高第，抡才閤策尊。\n一心依日月，无力正乾坤。\n插带环宫陛，蕃宣复塞垣。\n遗芳馀庆在，犹记笑言温。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26248,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"何信州挽诗 其一","author":"韩淲","text":"忆昔弦歌盛，临归送以诗。\n恰如前日事，又作百年悲。\n苍岭新阡远，灵溪旧治思。\n悼亡犹未殡，丹旐忍参差。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26249,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"何信州挽诗 其二","author":"韩淲","text":"家族开王社，姻亲满帝京。\n紫枢推玉友，青琐本冰清。\n勋业持荷近，才名折桂荣。\n从兹才得路，胡独止专城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26250,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赵吏部挽诗","author":"韩淲","text":"克保家声大，脩明国论难。\n退闲聊激懦，辞召岂图安。\n入馆才郎省，高科合世官。\n同门名士笔，留状后人看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26251,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"潘太博端叔挽诗","author":"韩淲","text":"叹息词场旧，凄其三十年。\n训言犹在耳，辈行敢随肩。\n师友真凋落，交亲仅接联。\n何因置刍束，东望只潸然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26252,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"竹院晁学士挽诗 其一","author":"韩淲","text":"主客文风在，家仍竹院名。\n有孙宜世禄，乃父今公卿。\n事至不如意，人应为失声。\n伤哉蒿里去，书剑竟何成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26253,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"竹院晁学士挽诗 其二","author":"韩淲","text":"叹息通家旧，姻连岂异乡。\n江南流寓久，济北老成亡。\n健笔馀笺翰，高歌付酒觞。\n鹅湖玉溪路，无复见徜徉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26254,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽吴九伯丰县丞诗 其一","author":"韩淲","text":"往者灵溪路，君尝过我庐。\n相期千载事，竟欠一行书。\n论定终何有，生平合自如。\n九原不可作，宰木夜台虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26255,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽吴九伯丰县丞诗 其二","author":"韩淲","text":"养志年方盛，持身德已明。\n一官虽未达，百岁岂销声。\n师友嗟零落，宾亲自送迎。\n翩翩丹旐远，老泪亦须倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26256,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽江浦县丞郑公诗 其一","author":"韩淲","text":"寂寞同州守，衣冠葬玉山。\n国家遭祸变，臣子不生还。\n异域城应在，中原路尚艰。\n有孙才九品，本拟上朝班。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26257,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽江浦县丞郑公诗 其二","author":"韩淲","text":"恤典劝天下，诸公誉更多。\n伤心立门户，遗恨满山阿。\n犹记交情旧，时将诗句哦。\n浮生如意少，薤露忍成歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26258,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"都漕陈侍郎挽诗 其一","author":"韩淲","text":"赫赫相门旧，龟峰照玉溪。\n岂云名宦达，殆欲古人齐。\n文物禁林上，光华使节西。\n黄金横带处，新筑乃幽栖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26259,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"都漕陈侍郎挽诗 其二","author":"韩淲","text":"尊酒游行地，凄凉仅隔年。\n传闻当勿药，却报卜新阡。\n哀挽嗟无及，忠言孰为宣。\n彼何兵弗戢，去国记翻然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26260,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]