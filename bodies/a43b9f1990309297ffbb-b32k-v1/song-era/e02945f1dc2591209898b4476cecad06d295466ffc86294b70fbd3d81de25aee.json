[{"title":"拟古 其一","author":"赵处澹","text":"青青河畔草，皎皎林下人。\n草有四时色，人无千载身。\n胡为踏氛埃，樊笼长苦辛。\n君看鸿鹄飞，九万谁能驯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44232,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"拟古 其四","author":"赵处澹","text":"今日宴良会，微风动波心。\n逸响悲秦筝，仁声和舜琴。\n古人为此曲，寓意良以深。\n何当共欢乐，长啸溪之阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44233,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"拟古 其二","author":"赵处澹","text":"西北有高楼，楼高夜何其。\n圆影湛以光，遥望斗与箕。\n何为天一方，长恨身不飞。\n安得驾双翼，上下长相随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44234,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"拟古 其三","author":"赵处澹","text":"涉江采芙蓉，皎皎外名利。\n采之遗所思，共此无尘意。\n所思在芝田，道远莫之致。\n悠然对芳草，绿满江南地。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44235,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"追拟玄真子渔歌 其一","author":"赵处澹","text":"丁山烟雨晚濛濛，柳岸苍波著短篷。\n飞鸟白，断云红，一曲清歌淡月中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44236,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"追拟玄真子渔歌 其二","author":"赵处澹","text":"雨晴山色静堆蓝，桥外人家分两三。\n缘岸北，远溪南，片片闲云趁落帆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44237,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"追和陶渊明咏贫士","author":"赵处澹","text":"嗟予薄罗衲，孑孑将畴依。\n晨炊井已冻，夜凿邻无辉。\n苍苔鸟迹绝，卧看孤云飞。\n老力出市米，溪寒莫忘归。\n纤纤山雨微，何以充我饥。\n习习风吹衣，何以慰我悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44238,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄友","author":"赵处澹","text":"谁谓相去远，盈盈一水间。\n欲渡无津梁，中情何由殚。\n秋怀多感慨，抚衿起长叹。\n岩风堕朝露，轻云冒遥山。\n群芳尽摇落，孰与坚岁寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44239,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答本堂先生歌","author":"赵必兴","text":"往事兮浮云，偕老兮天伦。\n乐莫乐兮天真，如良人何兮良人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44240,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十月梅花","author":"赵必成","text":"初冬未见一片雪，先见梅开傍花庵。\n可是东君留厚意，早传消息到江南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44241,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题陈生鲤鱼图","author":"赵必成","text":"神龙原自异凡鱼，潴泽还知不久居。\n平地雷轰头角露，滔天浪浴甲鳞舒。\n应誇鳌海都量遍，漫道龙门不可踰。\n试问锦标刚一跃，陡成霖雨足沾濡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44242,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"饮酒","author":"赵必岊","text":"穷居无与娱，弱子戏我右。\n宁知千载前，不是桑榆友。\n今为骨肉亲，结爱岂不厚。\n不知后千载，当复如此否。\n且尽人间事，幽远非所叩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44243,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"摸鱼儿","author":"赵必岊","text":"倚西风、招鸿送燕，年华今已如客。\n青奴一饷贪凉梦，昨夜酒红无力。\n愁似织。\n听鸣叶寒蝉，话到情无极。\n舞衣春入。\n叹带眼偷移，琴心不断，襟袖旧时窄。\n红尘陌。\n谁寄佳人消息。\n任他珠网瑶瑟。\n金钗两鬓霓裳曲，总是浪歌闲拍。\n长夜笛。\n且慢析轻匀，留醉酒垆侧。\n烟青雾白。\n望残照关河，晴云楼阁，何处是秋色。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44244,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日田园杂兴","author":"赵必范","text":"一岁农功只在春，夫夫妇妇几艰辛。\n青门旧有种瓜地，绿野新添躬稼人。\n早把牛衣教诸子，欲修蚕具问良辰。\n夜来谷口东风过，只恐逢人问子真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44245,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其三","author":"赵必范","text":"几点飞花芳径雨，一双新燕荻帘风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44246,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其二","author":"赵必范","text":"幸有渔樵同此乐，苦无车马自相諠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44247,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其四","author":"赵必范","text":"茭白生苗藏蛤地，桑黄含葚浴蚕天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44248,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其一","author":"赵必范","text":"卜岁聊凭六壬课，有生未识五辛盘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44249,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和榴皮题壁韵","author":"赵必晔","text":"回仙吸露餐霞者，却胜人间烟火馀。\n二十八言留壁上，不须青鸟为传书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44250,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"言志","author":"赵必㳅","text":"足濯长江万里流，手提三尺龙泉游。\n胸中一片英雄气，生不杀奸死不休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44251,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夜玩月","author":"赵必㳅","text":"几度停杯发浩歌，月华偏照别离多。\n床头剩有樽酒绿，醉饮鲸飞沧海波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44252,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和孙逢辰游子吟","author":"赵必㳅","text":"独向春风泪几回，经年游子自堪悲。\n天涯只为青云绊，堂上应怜白雪垂。\n离思不随音问去，浪身惟逐梦魂归。\n有时得慰故乡愿，骨肉团团醉寿杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44253,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小亭夜坐即景","author":"赵必常","text":"小亭夜坐涤炎蒸，顿觉风清趣已成。\n数点流萤亭外度，儿童戏逐月边星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44254,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再用前韵集句 其一","author":"赵必?","text":"我思君处君思我，一掬归心未到家。\n相见或因中夜梦，孤灯何事独成花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44255,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再用前韵集句 其八","author":"赵必?","text":"何所独无芳草兮，归田有计一何稽。\n吾侪流落岂天意，俯仰天地身醯鸡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44256,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再用前韵集句 其二","author":"赵必?","text":"思君天阔水悠悠，醉里眉攒万国愁。\n所不负予如此酒，已教从事到青州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44257,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再用前韵集句 其七","author":"赵必?","text":"少年心壮轻为客，不寄梅花远信来。\n为见行舟试借问，看花出约几时回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44258,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再用前韵集句 其十","author":"赵必?","text":"忽忆故人天外去，感君赠我琼瑶枝。\n世间好句无人共，郎罢吟诗囝和诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44259,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再用前韵集句 其五","author":"赵必?","text":"相思一夜梅花发，吟破离心句不成。\n横玉叫云清似水，夜钟残月雁归声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44260,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再用前韵集句 其三","author":"赵必?","text":"蔬饭藜床破衲衣，经年兀兀槿花篱。\n与君聚散若云雨，君问归期未有期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44261,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏题睡屏 其二","author":"赵必?","text":"点检残枰未了棋，才贪著处转成低。\n一番输后惺惺了，记取从前当局迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44262,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏题睡屏 其一","author":"赵必?","text":"一别相如直至今，床头绿绮暗生尘。\n当年自是文君误，未必琴心解挑人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44263,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏题睡屏 其四","author":"赵必?","text":"秋水盈盈娇眼溜，春山淡淡黛眉轻。\n人间一段真描画，唤起王维写不成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44264,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吟社递至诗卷足十四韵以答之为梅水村发也 其六","author":"赵必?","text":"欲花未花时，此妙无人知。\n著花已多事，更为花吟诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44265,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吟社递至诗卷足十四韵以答之为梅水村发也 其二","author":"赵必?","text":"萧艾秽群芳，草木纷零落。\n梅花我辈人，例合束高阁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44266,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀梅水村十绝用张小山韵 其一","author":"赵必?","text":"人生南北浮萍耳，四海九州都是家。\n毕竟男儿心似铁，莫将愁泪涴梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44267,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀梅水村十绝用张小山韵 其七","author":"赵必?","text":"梅花集里识真梅，曾读梅花偈子来。\n四海交游君倒指，江南只有贺方回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44268,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀梅水村十绝用张小山韵 其二","author":"赵必?","text":"十年骑鹤梦悠悠，天地无情白发愁。\n归到咸阳还似客，几回肠断望并州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44269,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀梅水村十绝用张小山韵 其八","author":"赵必?","text":"银钩铁画忆珍题，笔法精神逼会稽。\n可是荆州佳子弟，争怜野鹜厌家鸡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44270,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀梅水村十绝用张小山韵 其五","author":"赵必?","text":"暮秋已误张郎约，冬暮归期又未成。\n趁取岁前到家好，春来怕有杜鹃声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44271,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"李月野舍旁之李花于梅时郡斋有诗遂次其韵 其一","author":"赵必?","text":"李花不减梅花白，閒与梅花争几回。\n惟有暗香疏影句，承当不下让还梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44272,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"李月野舍旁之李花于梅时郡斋有诗遂次其韵 其二","author":"赵必?","text":"李花久慕梅清洁，取友于梅结己知。\n不是争春逞年少，祇嫌桃杏带妖姿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44273,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南康县圃赏梨花呈长官 其四","author":"赵必?","text":"李俗桃粗不用评，梅花之后此花清。\n唤醒山谷商量过，差替山矾做弟兄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44274,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南康县圃赏梨花呈长官 其三","author":"赵必?","text":"霜玉肌肤冰雪魂，春风庭院月黄昏。\n儿曹不解吟翁意，无雨无风也闭门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44275,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽邓南山 其一","author":"赵必?","text":"洛社耆英久隐居，书田付与子孙锄。\n终南不是功名径，说著功名俗了渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44276,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽李自玉 其三","author":"赵必?","text":"百年心事两眉头，生死闾阎系戚休。\n浩荡中流无砥柱，乘风涨浪舞鲸鳅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44277,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽李自玉 其四","author":"赵必?","text":"医至犹言疾可为，酸风吹讣落茅茨。\n典型诸老凋零尽，一束生刍雨涕垂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44278,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽李自玉 其一","author":"赵必?","text":"安乐窝中寄幅巾，床头易注墨犹新。\n盖棺只著深衣去，疑是尧夫辈行人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44279,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽李自玉 其二","author":"赵必?","text":"宗主文盟护梓桑，春风一手种甘棠。\n葬时移近坡翁墓，留取清名伴菊香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44280,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题云岫半閒堂用李涉韵 其二","author":"赵必?","text":"卧月眠云屋半间，诗人到处是家山。\n当年悔弄君房笔，只得忙中一半閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44281,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题云岫半閒堂用李涉韵 其一","author":"赵必?","text":"一坞白云茅数间，归与钓水采于山。\n寄声灵彻休相笑，未必僧閒似我閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44282,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题月岩","author":"赵必?","text":"千年老桂影婆娑，一半银蟾挂碧萝。\n大抵人间天上事，团圆时少缺时多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44283,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠相士陈神眼","author":"赵必?","text":"忆昔初逢神眼时，已于未第便相期。\n不嫌屋矮重来访，宦况萧然且赠诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44284,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠黄槐谷 其二","author":"赵必?","text":"上下乾坤乱失经，祸淫祸善事冥冥。\n老天自是无分晓，更向痴人说五星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44285,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠黄槐谷 其一","author":"赵必?","text":"我坐诗穷子术穷，只堪雨笠与烟篷。\n牢收相法无人问，路上相逢尽相公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44286,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元日客中和同年韵","author":"赵必?","text":"岁堂堂去逐江干，夜半东风送旧寒。\n爆竹声中人老大，梅花香外客平安。\n一番春事从头起，万里天衢著步宽。\n上下云龙平昔愿，拟摩短翮附飞翰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44287,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"至节寄家信","author":"赵必?","text":"薄宦骎骎已及瓜，寒梅羞见旧时花。\n年来吟苦形成鹤，客里愁多鬓减鸦。\n浮世有身元大患，此生何处是真家。\n白云极目空搔首，归雁两三寒日斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44288,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别和明府归帅省 其二","author":"赵必?","text":"几度赋停云，重逢瘴海滨。\n已成三载别，犹是旧时贫。\n酒量病来减，诗情老更新。\n慇勤分袂意，折尽柳条春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44289,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别和明府归帅省 其一","author":"赵必?","text":"江山如昨日，人物已晨星。\n往事风前絮，浮生水上萍。\n别离头半白，邂逅眼终青。\n客子愁如醉，晓风吹未醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44290,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和尹权宰见访韵","author":"赵必?","text":"牛下高眠扣角歌，辔金裾翠重相过。\n江湖十载知心少，风雨一庭愁思多。\n君向青云腾骥足，我甘白发老渔蓑。\n茅檐剪烛更酌酒，人世欢娱能几何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44291,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和文文溪庆徐固峰六十得子韵","author":"赵必?","text":"明珠生老蚌，光彩射西湖。\n岁晚颖方实，春荣木不枯。\n卿儿是麟否，陵母梦云无。\n他日浣花老，骑驴索醉扶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44292,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和朱水乡韵 其四","author":"赵必?","text":"一我独栖栖，相逢又解携。\n惊鱼依乱藻，忙燕垒新泥。\n亦有种桃者，独无芳草兮。\n买舟欲乘兴，风雨黯前溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44293,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和朱水乡韵 其一","author":"赵必?","text":"已落渊明后，归欤寂寞滨。\n旧交松处士，新宠竹夫人。\n诗国尊齐晋，仙溪隔昴辰。\n南柯还是梦，蝼蚁自君臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44294,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和朱水乡韵 其三","author":"赵必?","text":"何处著诗豪，白云高更高。\n山中别天地，门外自波涛。\n夜雨荒园菊，春风媚观桃。\n归来怀故宇，招隐愧离骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44295,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和朱水乡韵 其二","author":"赵必?","text":"江湖双鬓短，风雨一灯孤。\n买酒初尝芡，抄诗细截蒲。\n织耕同德曜，编简对韩符。\n怕有伤时句，磨教棱角无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44296,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和自村同年韵寄南山刘义车","author":"赵必?","text":"空谷寥寥绝足音，月明千里故人心。\n功名蝴蝶半床梦，岁月蜉蝣一息阴。\n王粲曾闻附刘表，华元何忍薄羊斟。\n买舟欲泛剡溪曲，安道门前雪忒深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44297,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和张竹处韵饯陈匝峰之濂泉","author":"赵必?","text":"不愁官冷客无毡，力欲回澜障百川。\n无己晚年工觅句，元龙豪气讳求田。\n焚章径解诸侯印，买酒时分司业钱。\n庭草池莲总春意，诗人只合住濂泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44298,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和李梅外韵以伤邑士之无朋","author":"赵必?","text":"兀兀规规铁限门，须眉妾妇遍吾村。\n蜀南见日犬群吠，井底观天蛙自尊。\n守望谁为乡里助，典型藉有老成存。\n书生唇齿久荆棘，气不能平又一言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44299,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和黄秋韵","author":"赵必?","text":"骚坛分戍打愁城，奏凯梅边缓辔行。\n诗债填偿难一顿，酒缘结习是三生。\n未能范蠡浮轻舸，且学灵均赋落英。\n落魄半生成底事，沙汀月冷负鸥盟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44300,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贺黎耐交建经史阁","author":"赵必?","text":"芹宫地属淳熙祖，芸阁功成四世孙。\n千载诗书元气在，百年文献故家存。\n卷还赠券珍公帑，留取芳名榜圣门。\n当道宗工凤楼手，拟干椽笔刻玙璠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44301,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重九宴陈东湖亭","author":"赵必?","text":"诗成欢未尽，月下客重来。\n清影共千里，寒香更一杯。\n龙山秋寂寞，牛渚夜徘徊。\n饮待东方白，人生能几回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44302,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽张县尹","author":"赵必?","text":"别驾新除墨尚鲜，翩其凫舄已飞仙。\n床头空有栽花谱，身后应无买木钱。\n自古才人多薄命，如今乡国正思贤。\n累累孤寡相持泣，说与天知天也怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44303,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽李梅边 其二","author":"赵必?","text":"归卧西楼理故书，幅巾羽扇一癯儒。\n家庭师友尊明道，古史文章逼老苏。\n蓬鬓蚤因时事白，荷衣不受劫尘污。\n呜呼天不遗耆老，雨泪如倾一束刍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44304,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]