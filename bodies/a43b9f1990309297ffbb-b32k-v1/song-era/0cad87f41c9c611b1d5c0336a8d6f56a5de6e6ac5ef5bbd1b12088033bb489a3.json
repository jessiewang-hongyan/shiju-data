[{"title":"和孔纯老江上避风题酒肆","author":"王之道","text":"对酒应从暮吹号，酒行还喜荐溪毛。\n若将物象评诗思，须向江头看怒涛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10352,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和孔纯老别邻居钱进之醉寝留题","author":"王之道","text":"不敢支筇问起居，虑烦炰脍破兵厨。\n杜门终日无人顾，新竹墙头出万夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10353,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和孔纯老按属邑六首 其六","author":"王之道","text":"榛莽无边没尽头，当年禾稼压田畴。\n流亡复业知何日，九叙宜先戒用休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10354,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和孔纯老按属邑六首 其五","author":"王之道","text":"石窦泠泠注竹溪，溪光浮动软琉璃。\n幽人爱玩不忍去，觅句坐惊红日西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10355,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和孔纯老按属邑六首 其四","author":"王之道","text":"客里宵寒梦易醒，起看残月照窗明。\n招提正在山多处，过雨流泉碎玉鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10356,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和孔纯老按属邑六首 其三","author":"王之道","text":"行并焦湖试问涂，何如震泽占姑苏。\n提壶聒聒劝谁饮，我不知君渠自呼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10357,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和孔纯老按属邑六首 其二","author":"王之道","text":"云涛雪浪渺无边，一簇溪桥客聚船。\n舆卫欲休红日下，几家茅舍起炊烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10358,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和孔纯老按属邑六首 其一","author":"王之道","text":"野云和雨渡金湖，山色微风恍有无。\n不惯扁舟浮浩渺，且驱羸马上崎岖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10359,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和王元渤留题松寿岩白云庵寄郑顾道二首 其二","author":"王之道","text":"日影曈昽霁晓雰，几声幽鸟隔窗闻。\n谢安盍为苍生起，休恋青山卧白云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10360,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和王元渤留题松寿岩白云庵寄郑顾道二首 其一","author":"王之道","text":"流水泠泠浸稻田，岩耕应费买山钱。\n风梢雨盖摩霄汉，个里高人即地仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10361,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和王觉民双泉道中","author":"王之道","text":"白云深处是吾家，山市归来日影斜。\n独立前村聊送目，孤村流水闹寒鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10362,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和王圜中道上初见梅花二首 其二","author":"王之道","text":"安养疮痍过所亲，野人何幸预斯民。\n自怜枯槁无生意，遂与寒梅竞得春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10363,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和王圜中道上初见梅花二首 其一","author":"王之道","text":"马头惊见一枝新，夹道欢呼拥吏民。\n咫尺招提鸡黍约，不妨同醉万家春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10364,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和由字韵","author":"王之道","text":"当年相望见无由，千里荆襄隔数州。\n时得新诗夸好句，服膺何止钓槎头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10365,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘春卿秋夜对月","author":"王之道","text":"天宇澄清桂影秋，骚人乘兴欲登楼。\n楼前白水三千顷，滉滉镕银烂不收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10366,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘春卿晓起读书","author":"王之道","text":"梦断幽禽恰转更，窥窗残月淡孤灯。\n孜孜读诵如吾子，指日菁莪看锡朋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10367,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和吕子梅题陈倅窗前新栽竹二首 其二","author":"王之道","text":"自是清阴能借润，不应积雨尚流寒。\n先生端的磻溪裔，乞与沧溟作钓竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10368,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和吕子梅题陈倅窗前新栽竹二首 其一","author":"王之道","text":"封殖要当同种玉，翱翔端复见停鸾。\n此君不是尘中物，岂减樊川十万竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10369,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和因上人四首 其四","author":"王之道","text":"荼蘼花底照衰颜，风送馀香到酒间。\n春色他年尚无恙，红裙来继谢东山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10370,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和因上人四首 其三","author":"王之道","text":"水云深处见人烟，桑柘鸣鸠似可怜。\n却怪银泥环四壁，由来春雨上蜗涎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10371,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和因上人四首 其二","author":"王之道","text":"茭葑弥天眼界幽，浇愁应办酒如油。\n坐怜渔父机心胜，万顷春苗不下鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10372,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和因上人四首 其一","author":"王之道","text":"拍天湖水乱蛙鸣，雨脚随风泼细尘。\n翠幄不开杨柳晚，红云初坐海棠春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10373,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张元礼水仙花二首 其二","author":"王之道","text":"沉水香浓画不烟，赋花谁是饮中仙。\n顾予老拙辞源涩，空想东坡万斛泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10374,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张元礼水仙花二首 其一","author":"王之道","text":"素颊黄心破晓寒，叶如谖草臭如兰。\n一樽坐对东风软，敢比江梅取次看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10375,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张文伯先梅后雪","author":"王之道","text":"六花无怪索诗催，正恐清寒勒早梅。\n待得江头千树暗，故争明洁逐风来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10376,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张文伯春日劝农","author":"王之道","text":"奉诏欢均草莽臣，郊原风日自温温。\n欲知太守催耕意，重谷劭农本圣恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10377,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张文伯洞庭柑","author":"王之道","text":"金苞照俎出双柑，想见和枝映笋篮。\n欲倩玉纤分玉液，要濡燥吻发清谈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10378,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张文伯黄悦之席上赋雪","author":"王之道","text":"功成三白到春回，好放云天万里开。\n今夜子猷方对客，却烦安道过溪来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10379,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和沈次韩春日郊行二首 其二","author":"王之道","text":"山色新晴一蘸青，隔溪无数野花明。\n杞苗荻笋肥应美，采掇何妨趁晚烹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10380,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和沈次韩春日郊行二首 其一","author":"王之道","text":"杨花落地鸊鹈飞，百里湖山碧四围。\n信步不知行几远，却怜芳草伴人归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10381,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和陈天予经过南巢邑人迎旧尹","author":"王之道","text":"君来井邑笑烘烘，君去萧条迥不同。\n似说攀辕如昨日，可怜身老长儿童。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10382,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和陈勉仲大宁院见寄","author":"王之道","text":"使驿驰驱赋陟冈，等閒诗戏况逢场。\n清和在序芳菲歇，草色连天水满塘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10383,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和陈勉仲四首 其四","author":"王之道","text":"雨过山前草木苏，开窗澄碧渺金湖。\n近来翰墨君为绝，喜见诗中有画图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10384,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和陈勉仲四首 其三","author":"王之道","text":"拍天湖水注东关，水外渔舟破浪还。\n谁似老僧閒有味，清风一榻面佳山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10385,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和陈勉仲四首 其二","author":"王之道","text":"何日清游继大苏，扁舟东去泛西湖。\n欲将景物和诗句，写作钱塘伟观图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10386,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和陈勉仲四首 其一","author":"王之道","text":"清风为我晓开关，风外浮云过雨还。\n湛湛可怜清上下，一篙溪水水边山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10387,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和陈勉仲赠淮西漕吴介之二首 其二","author":"王之道","text":"九郡疮痍赖拊存，年来和气浃江村。\n此恩未易论天报，请看于公大里门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":