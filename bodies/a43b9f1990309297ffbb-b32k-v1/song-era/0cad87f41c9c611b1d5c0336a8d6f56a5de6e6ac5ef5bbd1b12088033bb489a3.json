73bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和徐伯远见寄三首 其一","author":"王之道","text":"我家湖上面九华，无钱买山山见赊。\n待栽北牖一坡竹，追配东门千载瓜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10401,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和徐季功舒蕲道中二十首 其二十","author":"王之道","text":"光风习习日晖晖，堕絮飞红积渐稀。\n芍药酴醾看正好，一尊能共送春归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10402,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和徐季功舒蕲道中二十首 其十九","author":"王之道","text":"灊皖归来麦已秋，相从时说白云游。\n八年不践同安境，梦里山溪记旧由。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10403,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和徐季功舒蕲道中二十首 其十八","author":"王之道","text":"怪石形模老牯同，漫将名字责农功。\n得来正与齐田类，谁敢言耕望岁丰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10404,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和徐季功舒蕲道中二十首 其十七","author":"王之道","text":"下马邮亭忽喟然，数间茅屋起孤烟。\n山花狼籍馀无几，断送归心起杜鹃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10405,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和徐季功舒蕲道中二十首 其十六","author":"王之道","text":"带雨酴醾不自持，短垣高榭倚斜枝。\n野人莫觅丹青手，摹写春容一绝诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10406,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和徐季功舒蕲道中二十首 其十五","author":"王之道","text":"庭閒人静鸟窥帘，坐对文书亦倦拈。\n春旱正须三尺雨，江湖宁放老蛟潜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10407,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和徐季功舒蕲道中二十首 其十四","author":"王之道","text":"日迟风细午阴微，柳外青骢去若飞。\n过得水村闻笑语，几家扶得醉人归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10408,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和徐季功舒蕲道中二十首 其十三","author":"王之道","text":"欲识吾君圣与仁，泽流寰海众熙春。\n两淮饥馑方移粟，六辔驰驱不惮勤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10409,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和徐季功舒蕲道中二十首 其十二","author":"王之道","text":"草色青青入烧痕，登临何处暗销魂。\n应怜野老无拘缚，种竹栽花教子孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10410,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和徐季功舒蕲道中二十首 其十一","author":"王之道","text":"晓光晴影正曈昽，转眼还惊日过中。\n芳草岸头人渡水，洛阳影里鸟呼风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10411,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和徐季功舒蕲道中二十首 其十","author":"王之道","text":"春云漠漠雨纤纤，花柳丛边见酒帘。\n心为惜春无处著，可堪啼鸟更般添。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10412,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和徐季功舒蕲道中二十首 其九","author":"王之道","text":"一夜西风作晓晴，纷然花草斗欣荣。\n苍松巧与夭桃并，漫使诗人意不平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10413,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和徐季功舒蕲道中二十首 其八","author":"王之道","text":"山下溪边阿母家，春雷初过茗生芽。\n马头睡思浓无那，一椀何妨泛乳花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10414,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和徐季功舒蕲道中二十首 其七","author":"王之道","text":"草满池塘水满川，雨馀溪溜正溅溅。\n黄梅恰在山多处，披雾时看一握天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10415,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和徐季功舒蕲道中二十首 其六","author":"王之道","text":"野鸟关关督驾犁，及时新雨土膏肥。\n知君有意农夫劝，故故穿林傍马飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10416,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和徐季功舒蕲道中二十首 其五","author":"王之道","text":"三日春霖发土毛，道傍芳草半人高。\n马头问是棠梨市，一片梨花映小桃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10417,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和徐季功舒蕲道中二十首 其四","author":"王之道","text":"拍溪春水鸭头青，溪上哦诗醉眼醒。\n不见梅花寒蘸影，野桃山杏自娉婷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10418,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和徐季功舒蕲道中二十首 其三","author":"王之道","text":"溪流滟滟草凄凄，春日农郊麦穗齐。\n捲地东风还作恶，片云随马渡溪低。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10419,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和徐季功舒蕲道中二十首 其二","author":"王之道","text":"一声何处叫提壶，杨柳阴中驻犊车。\n笑语谁家騃儿女，浣沙溪上数游鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10420,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和徐季功舒蕲道中二十首 其一","author":"王之道","text":"春阴连日竟何如，逐妇应怜拙勃姑。\n习习晚风来更急，欲吹时雨助虚枯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10421,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和秦寿之春晚偶成八绝 其八","author":"王之道","text":"带雨飞来燕一双，问伊何事为春忙。\n野人不解呢喃意，勉强搜吟对麦光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10422,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和秦寿之春晚偶成八绝 其五","author":"王之道","text":"欲下荒庭意已阑，一枝红药坐中看。\n东风不息成何事，又酝春阴作夜寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10423,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和秦寿之春晚偶成八绝 其四","author":"王之道","text":"官閒时醉秀溪春，醉里吟诗字字新。\n欲报自惭无好语，年来胸次亦埃尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10424,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和秦寿之春晚偶成八绝 其三","author":"王之道","text":"花外霏微雨弄晴，乱红狼藉过清明。\n伤春正苦无聊甚，接接欣闻噪鹊声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10425,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和秦寿之春晚偶成八绝 其一","author":"王之道","text":"相从辄莫太匆匆，赌酒分茶自有功。\n谁谓春归无处觅，柳蹊飞絮乱因风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10426,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和秦寿之春晚偶成八绝 其七","author":"王之道","text":"春来谈笑数追陪，多谢传杯不放杯。\n醉里狂言应可笑，问春归去几时回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10427,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]