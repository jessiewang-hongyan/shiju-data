[{"title":"酌龙井泉书聪师房二首 其二","author":"周紫芝","text":"八十霜髭不出门，老师犹是辩才孙。\n高人已复如云散，旧事那堪与客论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8160,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"太学落成二首 其一","author":"周紫芝","text":"偃革逢华旦，三雍识汉仪。\n明伦先太学，首善自京师。\n圣主脩文日，诸生望幸时。\n宸奎在轮奂，万目仰宏规。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8161,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"太学落成二首 其二","author":"周紫芝","text":"当宁敷文德，贤关喜气多。\n横经将正坐，讲艺忽投戈。\n云拥桥门路，风摇辟水波。\n小臣歌圣化，无地献菁莪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8162,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋夕卧病效唐人作语 其一","author":"周紫芝","text":"画阁兰膏欲尽初，小窗留住玉蟾蜍。\n欲知此地愁多少，一夜秋声入井梧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8163,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋夕卧病效唐人作语 其二","author":"周紫芝","text":"此夜秋怀谁得知，幽虫相语替人悲。\n自从啼破黄昏后，直到寒窗无月时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8164,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"西溪道人全一堂","author":"周紫芝","text":"道人不爱葛藤禅，参得维摩妙法门。\n颇怪后三犹有说，要从全一便归根。\n昭文琴在何须鼓，惠子书多亦费言。\n闻道山中少来客，炉香清坐与谁论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8165,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵季长感事","author":"周紫芝","text":"久将华发寄林泉，尺一呼来近日边。\n身退已甘无事老，眼明重见太平年。\n鼎湖龙去心虽在，长乐钟鸣喜欲颠。\n解道贞元朝士少，刘郎定自有新篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8166,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"种罂粟","author":"周紫芝","text":"墙根有地一弓许，人言可种数十竹。\n翁来只作三年留，仅比浮屠桑下宿。\n竹成须待五六年，我已归乡卜新筑。\n园夫笑谓主人言，不如锄苗种罂粟。\n二月春风上翠茎，三月轻红照深绿。\n嫣花落尽罂不空，碎粒圆时粟初熟。\n乳膏自入崖蜜甜，满贮醍醐饮僧粥。\n与其种竹供后人，孰若栽花资老腹。\n人间作计真眼前，万事皆尔真可怜。\n十年种木尚不肯，百年种德知何缘。\n倚锄自顾颇羞涩，病眼对花空惘然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8167,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"周秀实陈庭藻携酒见过徜徉湖山间甚款明日秀实有诗乃次韵","author":"周紫芝","text":"少年怀二妙，一日如三秋。\n岂料京洛间，岁暮方从游。\n空疏坐晚缪，清楚知前脩。\n周郎古名士，功以一战收。\n太丘亦贤者，盛德令人羞。\n周旋奉谈笑，领略开羁囚。\n有如我辈人，夫岂公等俦。\n窈窕寻远壑，共赋临清流。\n青山傥在眼，白发从满头。\n西湖如西子，好句岂易酬。\n不敢妄作语，恐有不下鸥。\n微君妙篇章，何以写我忧。\n人生每如此，万户不足侯。\n斯盟傥未寒，小艇尚可浮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8168,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送乔民瞻赴官闽中","author":"周紫芝","text":"我昔游梁走千里，回望江南隔江水。\n是时公作桐汭官，不复东来问行李。\n人言左史有重客，玉面青衫气豪伟。\n酒催红蜡诗欲成，月堕秋江客方起。\n我从京洛尘中来，哦君新篇眼如洗。\n溅血惊魂二十年，长梦清樽奉簪履。\n相逢吴会不相识，昔年强健今如此。\n如公自是台阁人，老困一官何乃尔。\n只今尚作入幕宾，无事不令公怒喜。\n丈夫要当列鼎食，何止忍饥分斗米。\n且须拄颊望闽山，饱看麦秋丹荔子。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8169,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送关康子将还青阳治旧田","author":"周紫芝","text":"关郎人物妙人间，莫作云长一样看。\n不到青云知有命，频遭白眼坐无官。\n纫兰秋浦应须尔，索米长安政恐难。\n我欲买田犹未可，但令归梦逐征鞍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8170,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书杭僧法惠事后见边郎中观音感应记","author":"周紫芝","text":"眼中铁弹不辞枯，眢井重波事亦殊。\n不用三三前说法，要须六六后还珠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8171,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵叶兵部九日不出十日登北高峰","author":"周紫芝","text":"登临一笑与谁同，此事人间未易逢。\n莫恨清樽负重九，且看黄菊笑西风。\n江连碧海潮初上，山近丹霄路欲通。\n向晚归来得新句，便知云梦落胸中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8172,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"顷岁盗起徽严间兵既临城部使者而下皆弃官以走别乘强幼安摄郡事解衣高卧而贼不至城遂以全仆尝作送行诗以书其事后二十一年岁癸亥幼安始得州相遇于钱塘幼安犹能诵鄙诗而余漫不复省矣手录见遗读之惘然为题三绝其后 其一","author":"周紫芝","text":"当年玉食轸深忧，两月东南弃八州。\n只有孤城强别驾，醉中看雪倚江楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8173,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"顷岁盗起徽严间兵既临城部使者而下皆弃官以走别乘强幼安摄郡事解衣高卧而贼不至城遂以全仆尝作送行诗以书其事后二十一年岁癸亥幼安始得州相遇于钱塘幼安犹能诵鄙诗而余漫不复省矣手录见遗读之惘然为题三绝其后 其二","author":"周紫芝","text":"使君功大苦难酬，埋没孤忠二十秋。\n便拥一麾知未称，伯郎犹解得凉州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8174,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"顷岁盗起徽严间兵既临城部使者而下皆弃官以走别乘强幼安摄郡事解衣高卧而贼不至城遂以全仆尝作送行诗以书其事后二十一年岁癸亥幼安始得州相遇于钱塘幼安犹能诵鄙诗而余漫不复省矣手录见遗读之惘然为题三绝其后 其三","author":"周紫芝","text":"江上孤城欲破时，闭门高卧复谁知。\n我无文字铭金石，安用烦君写恶诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8175,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"张鳌诗","author":"周紫芝","text":"曹瞒举汉鼎，一目窥九州。\n凌轹欺孤儿，大蒙口舌羞。\n左慈有道者，何为与之游。\n堂堂清献公，盛德岂操俦。\n鳌乃元放徒，为公亦少留。\n了知高世士，至意俱难求。\n先生两琴鹤，清节贯白头。\n雅宜鸿宝书，取火遽自投。\n公今骑箕尾，笑谈阅千秋。\n椿年亦细事，蚁梦轻封侯。\n强侯公自出，矫矫亦此流。\n作诗纪异事，誓将踵前脩。\n愧乏大手笔，为公著嘉猷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8176,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"去年闻载扬在武林及余至而载扬病已久逮其归则逝矣乃追用往时九日诗韵以悼其亡","author":"周紫芝","text":"与君一别几经秋，忽作脩文地下游。\n诗忆向来云态度，人今何在柳风流。\n西湖烟月生前恨，客路风霜晚岁愁。\n胜日交流半零落，数行老泪倩谁收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8177,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵德庄惠南城纸衾且示妙句","author":"周紫芝","text":"范公古遗直，富贵不自娱。\n平生一布衾，岁晚眠粗疏。\n至今镵新铭，尚得司马书。\n此老抱刚节，岂与公孙俱。\n乃知枯槁士，白单良复须。\n衰年忍风露，蹭蹬来东吴。\n感君借馀温，此意知何如。\n青毡寄幽梦，蕙帐羞吾庐。\n得此林下具，烂锦不愿馀。\n况乃粲佳句，薄袖翻明珠。\n恨我无苍珉，为君载龟趺。\n愿与冰雪姿，卧起同卷舒。\n荆土作翠被，此俑无乃愚。\n问言拥六尺，岂不贤一襦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8178,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十月二十日晨起见枇杷花","author":"周紫芝","text":"枝头红日退霜华，矮树低墙密护遮。\n黄菊已残秋后朵，枇杷又放隔年花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8179,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夜宿净慈明日当宿斋宫","author":"周紫芝","text":"上方枝策记当年，仿佛天宫五日间。\n老去新添唯白发，重来好在只青山。\n已怜雪意催寒急，更遣泉声唤梦还。\n明日郊宫禋社稷，此生犹得缀朝班。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8180,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"斋宫夜雨明日大雪","author":"周紫芝","text":"郊祭严祠事，斋宫肃夜寒。\n鸾刀催宰急，庭燎及晨难。\n雨湿牛羊俎，烟埋币帛坛。\n南山忽清晓，万玉已巑岏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8181,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闻耘老犹在霅川","author":"周紫芝","text":"湖上虽相见，重来失后期。\n风尘为客久，舟楫送归迟。\n雁远无消息，梅残恼别离。\n何时酌君酒，烂漫说新诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8182,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十一月十一日夜步行中庭月色明甚作诗三绝 其一","author":"周紫芝","text":"冰轮渐出海西头，身在三吴近海州。\n赖有梅花管羁客，细分疏影上驼裘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8183,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十一月十一日夜步行中庭月色明甚作诗三绝 其二","author":"周紫芝","text":"香风袅袅月娟娟，月满中庭夜悄然。\n只恐大罗天上有，人间今夕是何年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8184,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十一月十一日夜步行中庭月色明甚作诗三绝 其三","author":"周紫芝","text":"少年邀月伴清樽，老去空馀满袖尘。\n多谢蟾光深有意，尚来同我作三人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8185,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"二十一日雪中归资国","author":"周紫芝","text":"出门天意已垂垂，湖上回鞭雪满衣。\n人在水晶宫里住，马从银色界中归。\n树头云冻依然在，湖面鸥寒断不飞。\n今夜灯前有残榼，拥炉深闭一篷扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8186,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"蜡梅大有生意","author":"周紫芝","text":"幽芳念初分，厚地冻始裂。\n耐寒怜孤根，忍苦度尺雪。\n谁持万金良，起死医寸蘖。\n伶俜初回姿，荏苒似看叶。\n灌木犹未成，已与凡草别。\n平生冰玉交，胜韵颇奇绝。\n微风折轻黄，香雾湿寒月。\n棐几著冰壶，馀芬散清樾。\n只今满眼花，想像疑可折。\n感君分似意，老味倍欣悦。\n添我小窗春，芳意未衰歇。\n盛德不可忘，封殖宁敢阙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8187,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"石佛道中隔水梅花满山","author":"周紫芝","text":"平明跨羸骖，遥遵石头路。\n循山一溪横，隔水得幽处。\n树疑虬龙骧，石作苍虎踞。\n云庵有遗屋，突兀在烟树。\n方壶岂不佳，弱水无船渡。\n空馀恼幽香，梅花满春屿。\n心知姑射仙，兹焉饮风露。\n水自平湖分，香从一山度。\n风姿不自持，照影各矜顾。\n安得从之游，徘徊著双屦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8188,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书东窗二首 其一","author":"周紫芝","text":"枕上青山翠扑衣，西湖郡更似西施。\n苦无能事王摩诘，领略烟鬟却要诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8189,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书东窗二首 其二","author":"周紫芝","text":"湖上梅花春意回，水光山影入衔杯。\n无人许我分幽事，故遣双飞属玉来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8190,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵强幼安岁晚感事","author":"周紫芝","text":"寒日催残岁，新诗得夜光。\n雪犹随处有，梅亦为春芳。\n愁鬓何从白，流年有底忙。\n官闲应放腊，燕寝自凝香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8191,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"岁晚杂题四首 其一","author":"周紫芝","text":"安稳三冬计，栖迟一舍宽。\n卷帘唯水近，倚杖得山看。\n老罢人谁数，天寒岁又阑。\n自无稽古力，未可怨儒冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8192,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"岁晚杂题四首 其二","author":"周紫芝","text":"草色无人地，梅花近腊天。\n拟飞犹未雪，将尽欲新年。\n漫与空成恨，无求合信缘。\n平生为晚计，老去更茫然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8193,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"岁晚杂题四首 其三","author":"周紫芝","text":"倚杖千山里，穷年一水滨。\n有官羞隐吏，无句作诗人。\n雨送灯前梦，傩催腊后春。\n孤山林处士，笑我是比邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8194,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"岁晚杂题四首 其四","author":"周紫芝","text":"老病时携客，斜阳更上楼。\n山寒犹有雪，湖晚最宜鸥。\n诗可书幽事，儿能伴薄游。\n人生每如此，吾意复何忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8195,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵幼安寺丞感旧见示","author":"周紫芝","text":"当时长啸敌先摧，不费官军一炬灰。\n黠虏自惊风鸟散，使君方看玉山颓。\n撄城捍贼今亡矣，抗疏论功有是哉。\n相见可堪谈旧事，为公搔首一徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8196,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"甲子立春口号四首 其一","author":"周紫芝","text":"梅花消息未阑珊，春入千门笑语喧。\n人道上元新甲子，从头却数太平年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8197,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"甲子立春口号四首 其二","author":"周紫芝","text":"春来玉烛又初调，尽喜官仪是汉朝。\n御道雪晴方试辇，彤庭日暖渐闻韶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8198,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"甲子立春口号四首 其三","author":"周紫芝","text":"力争和议众初疑，事在君王子母知。\n旧日塞垣啼鸟处，如今长乐晓钟时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8199,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"甲子立春口号四首 其四","author":"周紫芝","text":"晴日初生禁籞春，苑花宫树一番新。\n君王勤俭无行乐，只作银钩赐近臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8200,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"元夕前三日书事 其一","author":"周紫芝","text":"旧岁冬馀雪，今年雨复晴。\n奉常新奏乐，蕃使近朝正。\n灯火鳌山路，风光凤辇城。\n须烦天一笑，四海尽无兵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8201,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"元夕前三日书事 其二","author":"周紫芝","text":"落日沧江上，潮回水自平。\n云连子胥庙，山接阖闾城。\n海岳朝吴会，衣冠奉帝京。\n端门旧灯火，还向此时明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8202,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"饭馀过总持庵","author":"周紫芝","text":"饱饭度永日，问邻从小园。\n闲携居士杖，来扣总持门。\n花木无人见，文书听客翻。\n更将方外事，细为老夫论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8203,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"德庄别后以诗见寄再游钱塘始见之次韵奉答且以叙将别之意","author":"周紫芝","text":"分作经年别，还成一笑同。\n看君须点漆，羞我鬓吹蓬。\n共醉宁非梦，缘诗各坐穷。\n相逢又惊散，往往似征鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8204,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"二月二十三日薄雪","author":"周紫芝","text":"湖上春风结暮阴，乱云堆雪晚来深。\n便随柳絮飞将去，谁管桃花冷不禁。\n自苦多愁成客恨，不关难测是天心。\n乘除妙理谁能会，明日朝暾忽满林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8205,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵子东春雪","author":"周紫芝","text":"春光早已到千林，尚有馀寒压晓衾。\n解作飞花朝蔌蔌，绝胜疏雨晓涔涔。\n无田亦有三登意，是瑞何妨一尺深。\n雪里故人谁过我，西湖岩壑似山阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8206,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"湖上戏题","author":"周紫芝","text":"一湖春水绿漪漪，卧水桃花红满枝。\n去住云情浑不定，阴晴天色故相欺。\n风前柳作小垂手，雨后山成双画眉。\n何必娉娉仍袅袅，西湖应便是西施。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8207,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"后二日又题一首","author":"周紫芝","text":"家在东湾古渡头，柴扉草阁枕寒流。\n无人拟弹能言鸭，有眼那惊不下鸥。\n月里踏歌何处社，樽中载酒几家游。\n溪南溪北村村水，春雨春风日日愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8208,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"后五日又题一首","author":"周紫芝","text":"几日春风大放颠，晚来寒日露晴天。\n浪纹随棹湖如镜，日脚翻鸦月似弦。\n便可饱看花入眼，不应直待柳吹绵。\n庾郎分得愁千斛，肯与青丝作少年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8209,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"湖居无事日课小诗 其一","author":"周紫芝","text":"春湖潮满入青天，浪拍东风打钓船。\n人在空濛飞絮里，鸟啼红白乱花前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8210,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"湖居无事日课小诗 其二","author":"周紫芝","text":"天上阴晴不可猜，两番云黑又云开。\n鹭从落日山边去，鱼趁晚湖潮里来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8211,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"湖居无事日课小诗 其三","author":"周紫芝","text":"茶了诗窗饭后杯，儿书未熟急须催。\n鸟于花外唤客出，山自眼前将句来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8212,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"湖居无事日课小诗 其四","author":"周紫芝","text":"老向华胥占一窗，无心更梦小云郎。\n城居可似湖居好，诗味颇随茶味长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8213,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"湖居无事日课小诗 其五","author":"周紫芝","text":"花枝满树雨添肥，晴色十分春又归。\n一生万事无不尔，行年六十尽成非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8214,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"湖居无事日课小诗 其六","author":"周紫芝","text":"多情白鸟去还来，无事风扉闭复开。\n山下一帆冲雨过，水边双燕得泥回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8215,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"湖居无事日课小诗 其七","author":"周紫芝","text":"海内名流诗有宗，时传佳句落闲中。\n不道建安六七子，可是近时三数公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8216,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵同季夜宿松园兼呈清照师","author":"周紫芝","text":"鹤骨松园老，霜髯八十春。\n相逢看日夕，留客赋诗新。\n鬼亦来听法，谁应可作邻。\n折腰营斗粟，宁不愧斯人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8217,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"强幼安用余与曾同季唱酬韵作二章见寄谨用韵为谢 其一","author":"周紫芝","text":"江国从游地，花今几度春。\n老唯羁客在，情独使君新。\n未敢论倾盖，应须托善邻。\n如公真盛德，举世更何人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8218,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"强幼安用余与曾同季唱酬韵作二章见寄谨用韵为谢 其二","author":"周紫芝","text":"花落青墩寺，谁从作好春。\n锦囊题句近，旧旆得州新。\n老手摧强敌，馀风睦四邻。\n他年数循吏，神爵有斯人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8219,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄李司农三首 其一","author":"周紫芝","text":"东阁当年夜，华灯照别樽。\n断碑思雁塔，佳客愧龙门。\n岂料三吴路，相逢一水村。\n只今悬望眼，犹欲黯离魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8220,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄李司农三首 其二","author":"周紫芝","text":"徽水定何处，谪官今几时。\n长沙应有赋，南涧可无诗。\n柳絮催春远，梅花寄客迟。\n谁怜忆公久，头白少相知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8221,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄李司农三首 其三","author":"周紫芝","text":"谢朓南齐守，司农古汉官。\n杯今与谁把，山亦要公看。\n细札颁何日，离骚读又残。\n侍郎兄弟在，往往上金銮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8222,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]