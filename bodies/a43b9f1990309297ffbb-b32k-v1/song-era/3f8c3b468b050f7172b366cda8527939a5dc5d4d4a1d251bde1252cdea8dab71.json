[{"title":"句 其一","author":"郑文宝","text":"水暖凫鹥行哺子，溪深桃李卧开花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34000,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其十六","author":"郑文宝","text":"登临虽未立。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34001,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其十二","author":"郑文宝","text":"鬓间相似雪，峰外寂寒烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34002,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其四","author":"郑文宝","text":"星沉会节歌钟早，天半上阳烟树微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34003,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其五","author":"郑文宝","text":"越绝晓残蝴蝶梦，单于秋引画龙声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34004,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陪秋山相公游大涤洞天一庵夜宿感梦","author":"郑斗焕","text":"天柱清游尾使星，笋舆轧轧入山深。\n龙行雨去泉花定，鹤叫云来木叶阴。\n松石已安通夕寐，江湖空老百年心。\n圆冠方袂何仙子，梦里将诗索共吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34005,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"临江仙","author":"郑无党","text":"不比寻常三五夜，万家齐望清辉。\n烂银盘透碧琉璃。\n莫辞终夕看，动是隔年期。\n试问嫦娥还记否，玉人曾折高枝。\n明年此夜再圆时。\n阖开东府宴，身在凤凰池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34006,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"勉子","author":"郑氏","text":"夏日林间风，汝父心樊笼。\n冬寒一炉火，严凝我独坐。\n汝父为官逋，四海镇区区。\n别汝始经年，汝父鬓皤然。\n岁寒霜雪落，此景谁能觉。\n近闻汝知音，两补未入学。\n亲戚无常心，以此加轻薄。\n兄姊暗攒眉，父母非惊愕。\n知汝负天才，误失不为错。\n远远报汝知，旅怀保安乐。\n经史多贯串，德业加磨琢。\n交友用慎择，出处当执卓。\n京国繁华地，人心险丘壑。\n切切遵予言，勿为外物铄。\n文行天所祐，仙桂在掌握。\n衣锦归故乡，双亲乃欢跃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34007,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"碧玉轩","author":"郑丙","text":"长安回首远如天，解榻祇园百病痊。\n身世本来如寄尔，佛僧同住更悠然。\n筼筜千采不受暑，岩桂一枝或自妍。\n长与高人伴幽独，粥鱼斋鼓度流年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34008,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过桂氏湖庄","author":"郑兰","text":"堂上一天水，秋风叫白鹇。\n地偏游客少，烟阔钓徒閒。\n怀古楼宜野，浇蔬月在山。\n驾言寻旧好，款款到芦湾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34009,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和晦庵斋居闻磬韵","author":"郑可学","text":"纤月照幽林，秋气一何爽。\n散步豁烦襟，旷然息群想。\n忽闻玉磬里，泠泠送清响。\n顿令尘虑空，颇觉道心长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34010,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"郑立","text":"南昌别墅湖光阔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34011,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岩桂花","author":"郑仲熊","text":"天公怜我太岑寂，每岁殷勤两度开。\n收拾落英将底用，博山香里荐清杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34012,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日奉新道中","author":"郑会","text":"嫩寒猎猎酒旗斜，古路西风欲暮鸦。\n何处飞来双蛱蝶，也知篱落有黄花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34013,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"天庆观寻裘司直碑","author":"郑会","text":"长廊钟鼓静无哗，白发高人自煮茶。\n可惜断碑无觅处，石坛微雨落松花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34014,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宁都县道中","author":"郑会","text":"绿水桥头小钓车，数椽败屋柱槎牙。\n年年贼火无人住，风落棠梨几片花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34015,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"白衣寺","author":"郑会","text":"白衣古寺瞰江流，隔断红尘不记秋。\n深羡老僧心入定，禅房花木四时幽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34016,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"竹月亭","author":"郑会","text":"小栏干上夕阳红，古树根头雪未融。\n落尽梅花人易老，主张杨柳是春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34017,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寿苏友橘 其三","author":"郑会","text":"金轮王寿三千岁，铜狄人生五百年。\n兹事不须皆援古，无灾无难即神仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34018,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寿苏友橘 其一","author":"郑会","text":"一春湖上看花枝，看到青青杏子肥。\n家在江南身在浙，年年生日未曾归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34019,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寿苏友橘 其二","author":"郑会","text":"人谁安逸浪中鱼，事费经营网上蛛。\n记得去年生日酒，去年无此白髭须。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34020,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陈舍人送蒲萄","author":"郑会","text":"黑玉之柈白玉棱，龙须马乳剪寒藤。\n自怜有母今尘土，持到黄泉唤不应。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34021,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"定斋","author":"郑会","text":"乱叶不停风衮衮，狂澜既倒浪滔滔。\n碧潭深处无人见，归尽浮云月正高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34022,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宝藏寺雨中","author":"郑会","text":"秋城雨气白纷纷，不见青山只见云。\n古寺半攲僧去尽，乱鸦飞上五王坟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34023,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"胡氏书房","author":"郑会","text":"腊尽山中不见梅，闭门高枕梦瑶台。\n午窗晴日蜂喧纸，忽有麻溪道士来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34024,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送程岘坡过扬州","author":"郑会","text":"轻衫湿雨过淮东，鹤背功名酒一中。\n歇马不须寻古事，隋家陵树正秋风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34025,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻黄叔敏双陆因寄","author":"郑会","text":"水晶帘动影傞傞，白玉棋盘金字窠。\n赢得阿谁花十八，日长深院笑声多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34026,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏日吴园","author":"郑会","text":"斫藕敲瓜酒面凉，片云如墨不成章。\n东风忽遣雨西去，相对两乌行夕阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34027,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"斋中独坐","author":"郑会","text":"香杀柑花麝不如，晚窗重理读残书。\n饥乌只道无人在，偷觑盆池一个鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34028,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄江西友人","author":"郑会","text":"浮云净尽倚栏干，西望南楼未得还。\n怕有旧人相借问，为梅移屋近孤山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34029,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄栖贤涣上人","author":"郑会","text":"栖贤桥下水流沙，开了菖蒲几度花。\n想得老师无别事，乱云晴日补袈裟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34030,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄焦瑩中在南康","author":"郑会","text":"冬青花落麦登秋，几度相思欲买舟。\n近日客来因问讯，又闻触热过池州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34031,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄熊秋堂","author":"郑会","text":"醉踏青山忆旧游，两年流落古杭州。\n梦随云影忽东去，石上藓花无限秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34032,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅花","author":"郑会","text":"江梅欲雪树槎牙，雪片飘零梅片斜。\n半有和风到窗纸，不知是雪是梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34033,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"黄叔敏许惠水栀子","author":"郑会","text":"八觚台子净无尘，六尺屏风一欠伸。\n忽忆西家水栀子，多时愁杀读骚人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34034,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游金精山","author":"郑会","text":"春风栈阁晓云寒，中有潺潺一玉湾。\n白石寨盘青石磴，藓花犹带汉时斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34035,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"湖桥用朱申之韵","author":"郑会","text":"小倚湖桥数暝鸦，竹篱深闭阿谁家。\n爱渠一架酴醾白，甚欲敲门觅数花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34036,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"瑞金县道中","author":"郑会","text":"野水深深小径斜，旧时闻是富人家。\n乱馀田地浑无主，近有流移来种麻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34037,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"简颉监酒","author":"郑会","text":"小立西风翠袖垂，淡黄蛱蝶□高低。\n重门不锁秋香冷，何处人家有木犀。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34038,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"豫章客楼","author":"郑会","text":"荠菜花开雨未晴，章江烟柳正愁人。\n无钱可买东风醉，自写唐诗过一春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34039,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题邸间壁","author":"郑会","text":"酴醾香梦怯春寒，翠掩重帘燕子閒。\n敲断玉钗红烛冷，计程应说到常山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34040,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"橘修乡事","author":"郑会","text":"压囊红溜滴真珠，配食江南赤鲤鱼。\n今日钱塘江上客，自怜吾亦爱吾庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34041,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"一室","author":"郑会","text":"坐眠惟一室，贫与病相依。\n风急夜沽酒，月明秋捣衣。\n异乡身是寄，久客事俱非。\n忽忽谁可语，满庭黄叶飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34042,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与国军道上","author":"郑会","text":"时节近清明，云官未放晴。\n落花春绪懒，飞絮客情轻。\n新上谁家冢，深林宿处程。\n相看一卮酒，为尔暂忘情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34043,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"分宁县斋","author":"郑会","text":"日高窗下枕书眠，带得吟情到梦边。\n过鸟触翻枝上雪，飞鸦惊破树头烟。\n百年世事聊供笑，千里乡心最可怜。\n亦有门前数竿竹，短琴横膝不须弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34044,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"刘寺","author":"郑会","text":"绍兴妃子寺，步步白云深。\n丛冢荒难认，寒泉清到今。\n山高松有子，石老树无心。\n寺主疏相见，如闻亦解吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34045,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吉州寓舍","author":"郑会","text":"处世例营营，好山长自青。\n鹊毛秋净洁，鸽影夜竛竮。\n无客谈时事，听人讲佛经。\n虽然非所好，亦足尉飘零。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34046,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西湖客舍","author":"郑会","text":"数日秋风早，单衣补未圆。\n长贫身事缺，多病主人怜。\n卖药僧归寺，看山客借船。\n推窗正烟雨，坐看白鸥眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34047,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀宣州李司法","author":"郑会","text":"忆着宣城郡，能诗李法曹。\n秋今已过半，梦亦罕相遭。\n风叶乱无数，雨萤飞不高。\n独来窗下坐，灯影照离骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34048,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"将抵家遇雨","author":"郑会","text":"遄车偏值雨连天，疲马难支又上船。\n树杪鸦兵催急棹，渡头渔火锁寒烟。\n论心知己期将近，念子慈亲望久悬。\n自笑归装无一物，就中强半是诗篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34049,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送孔炳先归宜春","author":"郑会","text":"微吟五个字，客路惜年华。\n人世谁无别，子行吾忆家。\n湿云生竹菌，晴雪噤梅花。\n明日烟波远，孤舟自煮茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34050,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"富阳江岸","author":"郑会","text":"江行吾所爱，不敢厌长途。\n薄日生花影，轻风老麦须。\n晚潮人趁渡，春旆客寻酤。\n却望青山远，青山有鹧鸪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34051,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寒夜怀郑泽民","author":"郑会","text":"布袍寒旋整，图事少曾谐。\n挈屋来游浙，修弓欲渡淮。\n家贫迟遣妹，母老苦为怀。\n深夜青灯坐，思君命亦乖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34052,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢送酒","author":"郑会","text":"刺豹朝淋血，烹龙莫泣脂。\n分君新瓮盎，及我旧鸱夷。\n竹叶供浮蚁，春风入朵颐。\n扶衰拜嘉惠，时复一中之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34053,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"酬余判院","author":"郑会","text":"新篇如许好，欲和费沉思。\n相聚不为浅，能吟独未知。\n柳含春细细，梅待雪迟迟。\n重碧沽官酒，今当与说诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34054,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题岘坡书院","author":"郑会","text":"羊公碑字晋苔昏，中有襄人古泪痕。\n忆作风烟涨尘土，自今日月照乾坤。\n维瓯有客伤前哲，以岘名坡续后昆。\n且莫掀窗看凫白，为君王洗汉江浑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34055,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"拟行行重行行","author":"郑会","text":"行行重行行，忆君行路难。\n十步九萦折，一峰千巑岏。\n空山叫猿猱，老石藏㺥虦。\n美人隔千里，西游何当还。\n鬓发日已老，带眼日已宽。\n孤灯照残梦，雨滴芭蕉寒。\n所思不可见，悒悒清夜阑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34056,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杨柳","author":"郑会","text":"忆别东湖两度春，西湖柳眼又新新。\n想因一样湖边柳，一样春风一样青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34057,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南浦亭","author":"郑会","text":"山含落日暮光紫，雁带冰雪归影单。\n柳岸一舟人不渡，芦花风战晚来寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34058,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送金松槜归永嘉","author":"郑会","text":"可惜西风早，无因得放迟。\n吹将客归去，空有梦相随。\n旧舍松根在，新坊酒价低。\n倘行天竺路，须为访留题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34059,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅雪堂","author":"郑会","text":"素心甘澹泊，秉节性贞固。\n开堂抚垂云，徘徊阅嘉树。\n孤根倚绝壁，清光更回互。\n生平铁石肠，不受纤尘污。\n愿结岁寒盟，相依共迟暮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34060,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"续潘探花捣衣曲","author":"郑会","text":"白石砧，秋沉沉。\n家家捣衣灯下补，惟有妾家心最苦。\n妾初嫁来能几时，良人从军今不归。\n去时杨花未飞絮，欲着春衫裁白苧。\n秋来暑尽白苧寒，远征未必便可还。\n宫裘止是赐上将，良人犹在行伍间。\n捣衣捣衣寄将去，闻道分兵又西戍。\n茫茫莎草生寒尘，沙场不见愁杀人。\n堂前阿姑老，得君早归好。\n捣衣捣衣空断魂，因□上有双泪痕。\n边功未成君着力，妾身孤单君莫忆。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34061,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答田耕叟","author":"郑会","text":"五字推敲苦，君来尉所思。\n眼虽如旧识，心即要相知。\n屋冷云归早，窗深月过迟。\n过从无百步，清话绻论语。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34062,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"郑会","text":"君未知人穷相事。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34063,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题蒋诗翁故居","author":"郑会龙","text":"诗翁仙去旧坛荒，云满空山花自香。\n老尽游人春不问，杜鹃声里几斜阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34064,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戊寅腊望会友双峨得薪字韵","author":"郑传之","text":"双峨文会友，生意蔼如春。\n风转闻啼鸟，冰销想跃鳞。\n焚香温宿火，煮茗爇枯薪。\n一座惟吾老，欣然得句新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34065,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"一绝寄家","author":"郑刚中","text":"惊枕梦回常半夜，倚楼魂断是斜阳。\n如何行李犹淹泊，未报蒲帆过武昌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34066,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九六编成考左氏所载卦象以近世占法合之得一绝","author":"郑刚中","text":"静坐义规三易古，焚香蓍布六爻灵。\n反身修德前贤意，莫把穷通叩杳冥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34067,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日","author":"郑刚中","text":"倦客飘零若转蓬，一尊深念菊花丛。\n马蹄踏处黄尘起，费尽天涯落帽风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34068,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"二月二十一日枕上闻莺时霖雨之后","author":"郑刚中","text":"山前急雨促春耕，废我徜徉小圃行。\n今日定知晴有意，咤然林际一声莺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34069,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"二月十七日马上","author":"郑刚中","text":"愁多发白惟知老，病起花飞不见春。\n我得此生真偶尔，休贪画饼作痴人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34070,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"二绝寄章氏女子 其二","author":"郑刚中","text":"益昌春晚百花开，骨肉今朝对酒杯。\n共说相思悲复喜，就中怜汝不同来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34071,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"二绝寄章氏女子 其一","author":"郑刚中","text":"女子有家难恋汝，外甥似舅岂忘渠。\n春风万里空相忆，但愿平安数寄书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34072,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"八月初四日谢雨采石中元祠","author":"郑刚中","text":"山柳叶疏容夜月，古松枝劲起秋风。\n定知明日便回首，百里牛矶烟雾中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34073,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]