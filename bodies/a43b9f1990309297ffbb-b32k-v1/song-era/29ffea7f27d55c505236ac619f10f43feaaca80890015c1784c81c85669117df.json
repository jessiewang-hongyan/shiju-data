[{"title":"赵平甫幽居八操 其三 醉石操","author":"杨万里","text":"望之温其玉，即之寒于冰。\n一饮五斗，一石解酲。\n众人皆醉石独醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34428,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赵平甫幽居八操 其四 竹斋操","author":"杨万里","text":"客来何闻，客去何嗔。\n左右前后惟此君。\n德不孤，必有邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34429,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赵平甫幽居八操 其五 北窗操","author":"杨万里","text":"一枕之甘，万户不愿。\n清风之快，万玉不价。\n为我谢避俗翁，谁在羲皇之下。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34430,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赵平甫幽居八操 其六 梅亭操","author":"杨万里","text":"竹屋夜明，竹户寒声。\n幽人舍琴而起视，香通国而白连城。\n梅耶雪乎，四问而四不应。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34431,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赵平甫幽居八操 其七 棋台操","author":"杨万里","text":"争名不亢则朝者嘻，争利不赢则市者吁。\n君子无所争，必也弈乎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34432,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赵平甫幽居八操 其八 龟潭操","author":"杨万里","text":"风耆其武，波赫斯怒。\n油然者渊，未遽如许。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34433,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题曾景山通判寿衍堂","author":"杨万里","text":"风月暂平分，为霖喜有人。\n斯堂非浪扁，佐主寿跻民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34434,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送刘茂才主簿之官理定","author":"杨万里","text":"梅子青青荔未丹，葵丘缩戍便之官。\n莫言屋矮位卑甚，早晚高人振羽翰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34435,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"萧照邻参政大资挽诗","author":"杨万里","text":"公如月欠一分圆，生死应同昼与昏。\n鼎鼐□□□□□，□□露□留好□。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34436,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠旴江谢正之","author":"杨万里","text":"策马访柴扉，庭前草亦□。\n谈今复谈古，如子□□□。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34437,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"太守赵山父命刘秀才写予老丑索赞","author":"杨万里","text":"□□如斯兼儿丑，丹青写出十分真。\n凌烟绘像吾无望，喜在山林老此身。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34438,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题舒州宿松知县戴在伯重新紫霄亭","author":"杨万里","text":"高高亭耸紫霄端，借榻高眠廛市间。\n轮奂重新无俗□，何如来此伴云闲。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34439,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨后至溪上三首 其一","author":"杨万里","text":"□□□□一番□，□□风光□□□。\n□□渭川公子在，此时□□理丝纶。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34440,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨后至溪上三首 其二","author":"杨万里","text":"扁舟一叶泊溪弯，一雨初收篷未乾。\n风浪依然平帖后，渔翁□出把渔竿。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34441,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨后至溪上三首 其三","author":"杨万里","text":"拟借丹青画作图，退休老子作渔夫。\n凤凰池上虽荣贵，何似清闲看浴凫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34442,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题太和宰赵嘉言勤民二图 其一","author":"杨万里","text":"特借丹青写二图，二图之意果何如。\n请君细看□□□，是亦□求无逸书。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34443,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题太和宰赵嘉言勤民二图 其二","author":"杨万里","text":"□民勿视作□□，勉力耕桑贵及时。\n上古□□犹画像，老夫喜赠二篇诗。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34444,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上元前一日游东园看梅三首 其一","author":"杨万里","text":"谁占百花头上魁，花神推许□□□。\n东园春信知多少，今日喜晴拚一来。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34445,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上元前一日游东园看梅三首 其二","author":"杨万里","text":"东园把酒问东皇，何事梅花压众芳。\n和靖当年一题品，到今几载句犹香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34446,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上元前一日游东园看梅三首 其三","author":"杨万里","text":"春到东园恰□□，腊前闻已破南枝。\n□□□□□□□，□旦元□□□诗。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34447,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李原之主簿投赠长篇谢以唐律","author":"杨万里","text":"宝气亭前双太阿，龙光再吐射银河。\n伯兮西啸巴山月，仲氏南嬉楚水波。\n赠以四愁真绝唱，不如一诣听长哦。\n簿书何至烦勾校，归校芸香蠹简讹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34448,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题西昌彭孝求求志堂","author":"杨万里","text":"西江山水何处好，观山夜泉快阁风。\n山奇水秀产瑰宝，彭氏四杰隐此中。\n斗间异气如白虹，少微芒寒摇太空。\n占言非剑亦非玉，长松下有幽人屋。\n似闻鸣驺入空谷，篱边老却陶潜菊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34449,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"杨万里","text":"露窠蛛恤纬，风语燕怀春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34450,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"杨万里","text":"立岸风大壮，还舟灯小明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34451,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其三","author":"杨万里","text":"疏星煜煜沙贯日，绿云扰扰水舞苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34452,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其四","author":"杨万里","text":"坐忘日月三杯酒，卧护江湖一钓船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34453,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上元竹枝歌和曾大卿 其二","author":"冉居常","text":"学箫学鼓少年群，准拟春来奉使君。\n自向雕笼作行队，安排好曲写殷勤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34454,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上元竹枝歌和曾大卿 其三","author":"冉居常","text":"珍珠络结绣衣裳，家住江南山后乡。\n闻道使君重行乐，争携腰鼓趁年光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34455,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酣饮 其二","author":"张咏","text":"吾真小不见，吾真大无伦。\n真苟无所适，亦免招悲辛。\n堪笑古人愚，刺轹徒殒身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34456,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游宝掌山寺","author":"方樗","text":"何年此招提，近在芝掌侧。\n巉岩耸苍空，云雾蒙绝壁。\n相传千岁僧，于此寄畴昔。\n提携酌春酒，况乃社日逼。\n俛仰天地间，一笑讵非得。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34457,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重阳对菊得雨字","author":"方樗","text":"昨我醉骑马，失脚行踽踽。\n主人笑掀髯，把臂犹起舞。\n兹辰复何辰，俛仰已今古。\n远来置刍客，共绕临池圃。\n折萸可插发，醉我不待酤。\n深悲聊强欢，即散辄复聚。\n悠悠去年人，不及今夕雨。\n愿持菊花卮，一浇坟上土。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34458,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题义门","author":"方樗","text":"大义久不作，颓纲孰能扶。\n有回万钧力，足起千载愚。\n沄沄麟溪上，奕奕君子居。\n同堂爨不析，已及九世馀。\n动必敦孝悌，昭焉遵训谟。\n有田可以稼，有畦可以蔬。\n有琴亦有筑，有诗亦有书。\n雍雍悦子姓，肃肃严妇姑。\n祀飨必诚悫，冠婚礼无踰。\n济邻屡发廪，致客恒軿车。\n一翁垂九十，群从纷前趋。\n支持屹柱石，淬砺精璠玙。\n清朝特旌义，大字标门闾。\n丰碑妙纪实，赋咏皆鸿儒。\n老我愧同里，时陪文字娱。\n白发映沼沚，清风满襟裾。\n高歌一举酒，歌罢仍长吁。\n末俗见淳朴，岿然真世模。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34459,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重阳明日得蝶字","author":"方樗","text":"主人留复留，烂醉歌白氎。\n移樽对寒花，散策响秋叶。\n香凝紫茱萸，舞倦青蛱蝶。\n惟有一逃宾，苍山云万叠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34460,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题吴景禧栖碧楼","author":"方樗","text":"白叟无人识，青山是故知。\n一从觞菊后，两过浴兰时。\n入暑重逢此，追凉约更谁。\n清风觉相变，未忍数归期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34461,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄吴晦叔","author":"方樗","text":"地僻书难到，春寒病转深。\n遥怜梅剪玉，更想柳摇金。\n几砚平生事，杯觞隔岁心。\n恐君亦思我，迢递寄愁唫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34462,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"立秋日喜雨寄楚老","author":"方樗","text":"抱疾不安枕，且为枯旱忧。\n俄然垂豹雾，莫是捲龙湫。\n烈焰全收暑，新凉正得秋。\n客谁讥褦襶，吾欲咏瓯窭。\n机杼松台邃，琴书竹户幽。\n西田宜早穫，却共虎溪游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34463,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次吴良贵雪中归韵","author":"方樗","text":"匆匆策马出林扉，不及江头揽别衣。\n霜鹗横秋终可望，雪舟乘夜稍须归。\n移家未比穷郊具，解带宁怜瘦沈围。\n耄矣吾翁惭菽水，绕枝乌鹊暮相依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34464,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"吴仲恭翠微楼九日落成和谢皋羽","author":"方樗","text":"层构初成一快登，新题招客共兹辰。\n凉风阑槛宜敲句，落日川原遥见人。\n歌倚白云醒俗梦，醉餐黄菊笑吟身。\n他年更足閒中趣，野服茸茸称葛巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34465,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"呈吴学士新第落成","author":"方樗","text":"一山遥接袅溪水，甲第宏开相府居。\n燕贺亲朋来落落，翚飞夏屋见渠渠。\n紫宸清禁功难泯，绿野春林兴有馀。\n轮奂敢陈张老颂，梁间更看有悬车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34466,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重阳明日得也字","author":"方梓","text":"主人有黄花，留客香满斝。\n日饮岂丝乎，市眠惭白也。\n依稀听雨床，愁绝系阶马。\n此会良独难，幽怀还重写。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34467,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽吴止所","author":"方梓","text":"先生六十化，吾道尚奚云。\n花馆空馀影，清歌无复闻。\n夜寒鹤思主，风急雁悲群。\n有子方跨灶，天应未丧文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34468,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重阳对菊得开字","author":"方梓","text":"江源旧社兹重来，素车欲返犹徘徊。\n亲朋正感邻舍笛，风雨复对重阳杯。\n穷人非诗语独恶，湑我有酒花须开。\n眼前悲喜异今昔，敢问戏马当年台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34469,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次吴良贵雪中归韵","author":"方梓","text":"儿时谐笑几庐扉，聚散浮云天上衣。\n季子客貂宁复敝，买臣乡锦暂宜归。\n驾涛巨舰风千里，覆屋长松雪十围。\n父子交游吾独拙，向来惭作辅车依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34470,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"吴仲恭翠微楼九日落成和谢皋羽","author":"方梓","text":"新楼招乐偶今朝，与客登临四望遥。\n竹日晖晖侵酒斝，松风沥沥响诗瓢。\n横烟曲径樵初过，落鹜空江叶正飘。\n看取他年欹醉帽，还思簪菊旧垂髫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34471,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄吴立夫","author":"方梓","text":"寻师负笈频千里，授业登堂此一时。\n我比栖苴宁得巳，尔如附赘亦何为。\n家山在望悠悠梦，舍馆相逢叠叠诗。\n归去尚须怜独客，为传消息报南枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34472,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"减字木兰花","author":"赵师?","text":"江南春早。\n春到南枝花更好。\n不比寻常。\n深著胭脂学弄妆。\n寿阳开宴。\n拂拂红霞生酒面。\n从此溪桥。\n步障翻腾著绛绡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34473,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"沁园春 送戴石屏","author":"宋自逊","text":"归去来兮，田园将芜，云胡不归。\n既有诗千首，如斯者少，行年七十，从古来稀。\n地阙东南，天倾西北，人事何缘有足时。\n江湖上，转不如前日，步步危机。\n石屏自有柴扉。\n占海岸、潮头岸一矶。\n唤彩衣孙子，携壶挈榼，白头翁媪，举案齐眉。\n身外声名，世间梦幻，万事一程无是非。\n书来往，都不须长语，直写心期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34474,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"柑子堂","author":"陶弼","text":"子厚才名甲有唐，谪官分得荔支乡。\n罗池水尽黄柑死，独有空碑在画堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34475,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"司马错城","author":"陶弼","text":"北设长城陷虏尘，更来劳役武陵民。\n我疑洞里栽桃者，便是当时版筑人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34476,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李","author":"陶弼","text":"春昼暖风薰翠幄，暑天凉气沁朱阑。\n主人肝胆无猜忌，果下游人任整冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34477,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"奉和滁州九咏九首并序 其三 归云洞","author":"曾巩","text":"洞远人言接沧海，洞幽晴始见莓苔。\n天下颙颙望霖雨，岂知云入此中来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34478,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋夜露坐偶作","author":"曾巩","text":"白云飞尚低，清露泫犹早。\n风来亦依微，浊暑焉得扫？\n客堂虚四楹，洒水恨枯槁。\n喜兹宵漏初，露坐散襟抱。\n河明带飞观，月白通驰道。\n顾眄尘虑销，瓶泉谢频倒。\n恨无同声人，诗义与探讨。\n踟蹰拂方床，归卧梦亦好。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34479,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨后环波亭次韵四首 其三 次维得禽字韵","author":"曾巩","text":"黄蜀葵开收宿雨，紫桑椹熟啭新禽。\n看花弄水非无事，犹胜纷纷别用心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34480,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"彭城道中","author":"曾巩","text":"百步洪声潦退初，白沙新岸凑舟车。\n一时屠钓英雄尽，千载河山战伐馀。\n楚汉旧歌流俚耳，韩彭遗壁冠荒墟。\n可怜马上纵横略，只在邳桥一卷书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34481,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"出郊","author":"曾巩","text":"葛叶催耕二月时，斜桥曲岸马行迟。\n家家卖酒清明近，红白花开一两枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34482,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"念奴娇","author":"曾觌","text":"霁天湛碧，正新凉风露，冰壶清澈。\n河汉无声□□□，涌出银蟾孤绝。\n巘桂香飘，井梧影转，冷浸宫袍洁。\n西厢往事，一帘幽梦凄切。\n肠断楚峡云归，尊前无绪，只有愁如发。\n此夕姮娥应也恨，冷落琼楼金阙。\n禁漏迢迢，边鸿杳杳，密意凭谁说。\n阑干星汉，落梅三弄初阕。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34483,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"点绛唇","author":"曾觌","text":"细雨斜风，上元灯火还空过。\n下帘孤坐。\n老去知因果。\n风月词情，冷落教谁和。\n今忘我。\n静中看破。\n万事空花堕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34484,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鸿鹄诗","author":"王安礼","text":"鸿鹄慕稻粱，日夜疑罝罘。\n蜻蛉善蜚翔，不为食饮留。\n胶丝竹竿杪，童子与我仇。\n出处或类此，明明君子羞。\n近世喜高论，罔知道沉浮。\n朵颐非吉人，赴海岂善谋。\n万事固有理，彼哉宁易求。\n爱子智虑明，吾言非暗投。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34485,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"常州寄吕进之五言一首","author":"王安礼","text":"峨峨霍邱上，可以望九州。\n衮衮蔡河底，日夜无停留。\n子与山水近，官冗亦少休。\n登高望我居，寄书托东舟。\n非唯慰我思，亦以解子忧。\n我欲问子讯，冰泥塞邗沟。\n又欲识子处，东山岂高邱。\n惜哉所处异，会合宁易求。\n何时春风来，从我繁台游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34486,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游集禧中元东轩分题得东字","author":"王安礼","text":"策马从仙子，探春游帝宫。\n爱此高尚志，开轩池水东。\n鸭绿漾残日，树碧留清风。\n生我潇洒思，超然尘世中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34487,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"昔日","author":"王安礼","text":"昔日登名级，天街是胜游。\n昔日初得志，潘鬓未惊秋。\n逸驭乘风远，迁莺出谷幽。\n琼林颁宴处，楼殿彩云浮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34488,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"丙寅九月二十日同蒋颖叔从长干雨中登高座寺诗","author":"王安礼","text":"弭节萧帝寺，驱车成子冈。\n莽卉翳涂泥，霖雨沾衣裳。\n跻攀踰百寻，险滑步寸量。\n生公不可见，雨花空此堂。\n当时听说法，神鬼久已藏。\n烟云渺无穷，凄风来我旁。\n山川万邑屋，所见未毫芒。\n驾言吾将归，重劳徒御将。\n迟明羲与和，宇宙观暄旸。\n安行凌太虚，旷朗观八荒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34489,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送别范希声","author":"王安礼","text":"驿吏闯晓鼓，仆夫乐晨征。\n叙别何草草，君今千里行。\n捧檄近京国，拜亲还洛城。\n层峦望太行，慷慨无俗情。\n嗟我寔僚友，追攀劳至诚。\n赠言岂无意，爱子智虑明。\n抱才太华高，视利鸿毛轻。\n世路有夷险，君行常直清。\n朝廷正博采，幕府讵久撄。\n少别勉自爱，他年看名卿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34490,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"曲院输麦二十二韵呈开父","author":"王安礼","text":"自讼愚且鄙，平生事辞翰。\n为文谢超卓，得禄未盈寸。\n一官走穷僻，百事真黾勉。\n昨者得州帖，输租被公选。\n曲舍只容膝，侍立如牛喘。\n逄逄鼓咽耳，漠漠尘翳眼。\n微风六月息，烈日四檐短。\n一座洒腥雨，万夫挥午汗。\n斗升烦较量，朱墨谩勾窜。\n岂惟畏刑书，农事宁可缓。\n赖有葛衣翁，志趣颇高简。\n爱民一心劳，慰我百忧遣。\n谁人坐华堂，玉簟罗婉娈。\n清樽近美竹，冰纨依素扇。\n贤愚定劳逸，贵贱天所绾。\n赋分乃自然，何须慕华弁。\n况予山野姿，夙尚本萧散。\n萦缠正自取，有类蚕作茧。\n得桷未知渐，盈庭巳占艮。\n恍怪旧学凋，冥羞素期舛。\n便当谢官长，趋墀来敛板。\n才谫又不力，引去非宜款。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34491,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酒罩","author":"王安礼","text":"妙绝因心匠，华堂此集英。\n轻尘避绿蚁，密影占香琼。\n醉有陶彭泽，狂如阮步兵。\n瓮头篱菊下，弃掷任纵横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34492,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]