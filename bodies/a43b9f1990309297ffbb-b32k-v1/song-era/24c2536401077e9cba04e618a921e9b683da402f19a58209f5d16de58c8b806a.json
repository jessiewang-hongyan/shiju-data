[{"title":"宿邵埭闻雨因买藕芡人回呈永叔","author":"梅尧臣","text":"秋雨雁来急，夜舟人未眠。\n乱风灯不定，暝色树相连。\n寒屋猛添响，湿窗愁打穿。\n明朝持藕使，书此寄公前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67630,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宿洪泽","author":"梅尧臣","text":"舟子起添缆，夜潮同雨来。\n寒声相乱急，远梦自然回。\n水鸟鸣还睡，风灯暗复开。\n宦游常作客，未息为贫催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67631,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄西京通判宋次道学士","author":"梅尧臣","text":"当时交友都无几，欲问欢娱亦异今。\n花接上林新木变，水分清洛旧池深。\n嵯峨嵩色云常在，窈窕宫墙草又侵。\n脩竹千竿白家寺，昔年题处可能寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67632,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄许主客","author":"梅尧臣","text":"昨日山光寺前雨，今朝邵伯堰头风。\n野云不散低侵水，鱼艇无依尚盖蓬。\n藕味初能消酒渴，蓼花犹爱照波红。\n扬州有使急回去，敢此寄声非塞鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67633,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄汶上","author":"梅尧臣","text":"大第未尝身一至，人猜巧宦我应非。\n弹冠不读先贤传，说剑休更短后衣。\n瘦马青袍三十载，故人朱毂几多违。\n功名富贵无能取，乱石清泉自忆归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67634,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄岳州孙屯田","author":"梅尧臣","text":"从来洞庭好，都在岳阳楼。\n明月一千里，寒光三万秋。\n年华有时尽，风物不知休。\n太守怜予句，应如沈隐侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67635,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄建德徐元舆","author":"梅尧臣","text":"才子方为邑，千峰对县门。\n静寒琴意古，闲厌鸟声喧。\n山茗烹仍绿，池莲摘更繁。\n讼稀应物咏，庭下长兰荪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67636,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄河阳签判富彦国","author":"梅尧臣","text":"籍籍名方远，人知第一流。\n翻同贵公子，来事外诸侯。\n地险长河急，天高画角秋。\n仲宣应自乐，宁复赋登楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67637,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄洪州致仕李国博","author":"梅尧臣","text":"湖上悠然度几春，勇抛荣禄遂天真。\n青蒲翠竹围华屋，白酒黄鸡命里人。\n果下有时乘小驷，儿曹方见拥朱轮。\n田园岁入千钟美，肯似疏家苦畏贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67638,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄送许待制知越州","author":"梅尧臣","text":"喜公新拜会稽章，五月平湖镜水光。\n菡萏花迎金板舫，葡萄酒泻玉壶浆。\n云归秦望山头静，雨洗若耶溪上凉。\n天子不能烦侍从，可将吟咏报时康。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67639,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄饶州范待制","author":"梅尧臣","text":"山水番君国，文章汉侍臣。\n古来中酒地，今见独醒人。\n坐啸安浮俗，谈诗接上宾。\n何由趋盛府，徒尔望清尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67640,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄桂州张谏议和永叔","author":"王巩","text":"桂林太守几时行，泛汴桃花浪已腾。\n目极云阴低远树，夜寒风急乱春灯。\n巢鸣翡翠愁无限，水宿鸳鸯冷不胜。\n阳朔山前好峰岭，为公怜爱万千层。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67641,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄致仕张郎中","author":"梅尧臣","text":"门荣世美高天下，身退心闲住洛阳。\n画鹤能同薛少保，爱书还比蔡中郎。\n花阴小酌呼邻父，月下清吟扫石床。\n不问从来生计薄，题签盈阁是家藏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67642,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄渭州经略王龙图","author":"梅尧臣","text":"儒将一临塞，虏尘无犯边。\n卷旗瞻汉地，收马入胡天。\n练卒朝营鼓，鸣筝夜峡泉。\n遥知玉关路，烽火不须传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67643,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄酬发运许主客","author":"梅尧臣","text":"淮上秋来物意闲，又乘轻舸信帆还。\n一浮一没水中鸟，更远更昏天外山。\n斜幅缠骹兵吏至，浓金洒纸颔珠颁。\n欲酬已觉不能敌，尽日临风思自悭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67644,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄酬睦州晏殿丞","author":"梅尧臣","text":"清潭吐明月，杳杳及吾庐。\n流彩满怀袖，托情非鸟鱼。\n朝因南涧雨，暮入北畦锄。\n岂不藉馀润，况兹方饭蔬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67645,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄题刁经臣润州园亭","author":"梅尧臣","text":"新作城边圃，陂原上下斜。\n竹多刘裕宅，松接戴颙家。\n山色不须买，江流何处涯。\n但邀东海月，莫听五更鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67646,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄题开元寺明上人院假山","author":"梅尧臣","text":"石是青苔石，山非杳蔼山。\n诸峰生镜里，小岭傍池间。\n雨不因云出，门疑为客关。\n何须费蜡屐，暂到此中閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67647,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄题杭州广公法喜堂","author":"梅尧臣","text":"淘青研朱画屋梁，黄漆柏障连曲房。\n日晖月色不须照，了了自可窥毫芒。\n夕阴花敛似欲病，飞鸟不惊乌帽郎。\n深山穷谷谩幽僻，喜得吴侬是药囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67648,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄题南陵息亭蕖阁","author":"梅尧臣","text":"竹里有清馆，寺中多藕花。\n日光穿岸脚，水影射檐牙。\n柱穴蜂归响，炉檀火过窊。\n已知民讼息，漉酒费巾纱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67649,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄题徐都官新居假山","author":"梅尧臣","text":"太湖万穴古山骨，人结峰岚势不孤。\n苔径三层平木末，河流一道接墙隅。\n已知谷口多花药，祇欠林间落狖鼯。\n谁侍巾鞲此游乐，里中遗老肯相呼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67650,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄题资州钱固秀才道胜堂","author":"梅尧臣","text":"醮坛旧山下，高卧一儒生。\n有室罗经籍，无心取组缨。\n芋肥收岁计，柑熟摘霜晴。\n暂向京都见，添书入蜀城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67651,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"彩霓亭","author":"梅尧臣","text":"高出岭头树，俯窥城下溪。\n半山飞急雨，举手弄晴霓。\n旷望已无极，万缘都与齐。\n自嗟来独晚，征棹苦言西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67652,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"悼亡三首 其三","author":"梅尧臣","text":"从来有脩短，岂敢问苍天。\n见尽人间妇，无如美且贤。\n譬令愚者寿，何不假其年。\n忍此连城宝，沉埋向九泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67653,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"悼亡三首 其二","author":"梅尧臣","text":"每出身如梦，逢人强意多。\n归来仍寂寞，欲语向谁何。\n窗冷孤萤入，宵长一雁过。\n世间无最苦，精爽此销磨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67654,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"悼亡三首 其一","author":"梅尧臣","text":"结发为夫妇，于今十七年。\n相看犹不足，何况是长捐。\n我鬓已多白，此身宁久全。\n终当与同穴，未死泪涟涟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67655,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"教授宋著作还","author":"梅尧臣","text":"何以拟君子，云鸿肃羽仪。\n将过上林苑，先集孝王池。\n唼藻有馀乐，渐磐方得时。\n野塘归莫晚，白水远连陂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67656,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚日","author":"梅尧臣","text":"晚日晴还暖，人閒见物机。\n叶枯虫自裹，窗响蜜寻归。\n林下见收柿，水边闻捣衣。\n吾嗟久为客，却愧寄荆扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67657,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晨起裴吴二直讲过门云凤阁韩舍人物故作五章以哭之 其五","author":"梅尧臣","text":"晓陌行车过，交相叹且惊。\n荀龙闻一蜕，穆骏失全鸣。\n不复中书直，空馀左史成。\n绪言犹在耳，尚想见平生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67658,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晨起裴吴二直讲过门云凤阁韩舍人物故作五章以哭之 其二","author":"梅尧臣","text":"使虏尝专对，江湖谪几年。\n始看还近侍，遽此隔重泉。\n沃酒酒空满，托词词谩传。\n视予犹手足，莫怪独潸然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67659,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晨起裴吴二直讲过门云凤阁韩舍人物故作五章以哭之 其三","author":"梅尧臣","text":"算数曾无据，仁人亦莫闻。\n很愚多至老，兰桂苦先焚。\n不竟千秋恨，还如万里分。\n临风一号恸，易散日边云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67660,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晨起裴吴二直讲过门云凤阁韩舍人物故作五章以哭之 其四","author":"梅尧臣","text":"昨时宾晏地，今见穗纬遮。\n栖室那因鵩，从杯不为蛇。\n曾无越人术，意起汉臣嗟。\n明日东城陌，悲凉后部笳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67661,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晨起裴吴二直讲过门云凤阁韩舍人物故作五章以哭之 其一","author":"梅尧臣","text":"平生交友泪，又哭寝门前。\n鲁叟不言命，楚人空问天。\n月沉沧海底，星陨太微边。\n莫恨终埋没，文章自可传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67662,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"望夫山","author":"梅尧臣","text":"亭亭千古质，曾是念征夫。\n一作山头石，畏看天际途。\n犹如托萝蔓，不似采蘼芜。\n时有江云近，仙衣挂六铢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67663,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅花","author":"梅尧臣","text":"似畏群芳妒，先春发故林。\n曾无莺蝶恋，空被雪霜侵。\n不道东风远，应悲上苑深。\n南枝已零落，羌笛寄馀音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67664,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅花","author":"梅尧臣","text":"已先群木得春色，不与杏花为比红。\n薄薄远香来涧谷，疏疏寒影近房栊。\n全枝恶折憎邻女，短笛横吹怨楚童。\n坠萼谁将呵在鬓，蕊残金粟上眉虫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67665,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅花","author":"梅尧臣","text":"江南腊月前溪上，照水野梅多少株。\n艳薄自将同鹄羽，粉寒曾不逐蜂须。\n桃根有妹犹含冻，杏树为邻尚带枯。\n楚客且休吹玉笛，清香飘尽更应无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67666,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梦故府钱公","author":"梅尧臣","text":"故相方来梦，分明接座隅。\n只知冠剑是，不道死生殊。\n西府看如旧，东山咏久徂。\n遽然兴寤叹，不觉泪沾须。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67667,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梨花","author":"梅尧臣","text":"处处梨花发，看看燕子归。\n园思前法部，泪湿旧宫妃。\n月白鞦韆地，风吹蛱蝶衣。\n强倾寒食酒，渐老觉欢微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67668,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梨花忆","author":"梅尧臣","text":"欲问梨花发，江南信始通。\n开因寒食雨，落尽故园风。\n白玉佳人死，青铜宝镜空。\n今朝两眼泪，怨苦属衰公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67669,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"欲雪复晴","author":"梅尧臣","text":"阴云不成雪，碧瓦有繁霜。\n日气生帘额，冰条结井床。\n飞乌鸣自乐，古木昼仍僵。\n谁意斗晴后，苦寒胜北方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67670,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"淮上杂诗六首 其六","author":"梅尧臣","text":"舟阁下滩迟，苍黄暮滩上。\n偏愁逆水风，更驾崩沙浪。\n落日看已昏，渔灯远相向。\n夜阑天转寒，坐待潮流涨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67671,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"淮上杂诗六首 其五","author":"梅尧臣","text":"漠漠昼烟披，纵横见渔艇。\n轻桡上急水，或与飞鸿并。\n鱼大钓丝微，牵随碧潭迥。\n向晚得志归，浩歌山月静。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67672,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"淮上杂诗六首 其四","author":"梅尧臣","text":"野雁不知数，翳然川上鸣。\n曾无设罗意，空自见船惊。\n渺渺拍波去，纷纷孤屿盈。\n苦寒非塞外，霜落夜淮清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67673,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"淮上杂诗六首 其三","author":"梅尧臣","text":"轻舟晚投处，聒聒渚禽嘶。\n橡子随薪束，蔬科带土携。\n岸幽云满石，潮落蚌生泥。\n客思无憀极，唯将鲁酒迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67674,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"淮上杂诗六首 其二","author":"梅尧臣","text":"暗开淮水平，远见孤城出。\n出舟问舟子，遽对那能悉。\n始闻庄生台，还想观鱼日。\n果得真隐心，鱼鸟情非密。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67675,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"淮上杂诗六首 其一","author":"梅尧臣","text":"宿云未全敛，微雨入船疏。\n问伴失前后，暝行随疾徐。\n相亲沙上雁，自乐水中鱼。\n亭午日光透，远分林际居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67676,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"淮阴","author":"梅尧臣","text":"青环瘦铁缆，系在淮阴城。\n水胫多长短，林枝有直横。\n山夔一足走，妖鸟九头鸣。\n韩信祠堂古，谁将胯下平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67677,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"淮阴侯","author":"梅尧臣","text":"功既高天下，身何不自防。\n已能成汉业，无复假齐王。\n复耻哙为伍，安知吕所忘。\n空名流未竭，淮水共汤汤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67678,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渐嘉楼望雨陪谢守","author":"梅尧臣","text":"冒雨上城头，凄凄欲报秋。\n云低密藏树，风急暗侵楼。\n渐积荷珠重，新添沼鉴幽。\n凭栏未能去，公自念民畴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67679,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"萧著作宰丰城","author":"梅尧臣","text":"王都二月花正开，社雨作阴迎燕子。\n人先春色向江南，江南春色归春水。\n拍岸绿波生荻芽，晨羞聊可助甘旨。\n县涂为政子所谙，不敢赠言言日鄙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67680,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"野望","author":"梅尧臣","text":"新晴宜野望，最爱是山前。\n远近花兼竹，高低水拍田。\n呼名鸟无数，问姓客多年。\n此地春耕晚，吴牛树底眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67681,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"随州钱相公挽歌三首 其三","author":"梅尧臣","text":"去年伊水上，倾府望云岑。\n路转犹回首，人谁不殒心。\n可怜飞语后，挤恨九幽深。\n从此埋英骨，空令泪满襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67682,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"随州钱相公挽歌三首 其二","author":"梅尧臣","text":"昔日伤归国，今朝叹举輀。\n忧愁传楚些，殄悴感周诗。\n文草明时访，忠言故吏知。\n居常呜咽涕，翻作众人悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67683,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"随州钱相公挽歌三首 其一","author":"梅尧臣","text":"筑岩无往梦，游岱有飞魂。\n堕泪隋侯国，遗金汉帝恩。\n文章留日域，忠孝在王门。\n天道何由问，秋风遍九原。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67684,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪","author":"梅尧臣","text":"朔云生晚雨，腊霰集狂风。\n不数花多出，安知天更工。\n漫阶夜已积，万物晓初蒙。\n谁忆新丰酒，乘驴灞水东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67685,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪中怀广教真上人","author":"梅尧臣","text":"苍山去不远，日日起寒云。\n堂上看飞雪，水边思练裙。\n铜瓶生薄冻，桂火压残薰。\n欲往有馀兴，林幽路不分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67686,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪后资政侍郎西湖宴集偶书","author":"梅尧臣","text":"潭心不冻处，雁鹜自相依。\n积雪正无际，因风忽起飞。\n初惊如避弋，复下信忘机。\n偶得从公饮，聊书此景归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67687,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪咏","author":"梅尧臣","text":"雪色混青冥，搴帏宿酒醒。\n龙蛇缘古木，凤鹄舞幽庭。\n密势因风力，轻姿任物形。\n公堂何寂寞，横案对玄经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67688,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"黄池月中共酌得池字","author":"梅尧臣","text":"将归谢公郡，喜见阮家儿。\n但对月和水，那能酒似池。\n衰形疑镜照，葆鬓怯霜吹。\n宿雁不堪托，乡人知未知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67689,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜雨","author":"梅尧臣","text":"冬涉春无雨，侵晨忽沛然。\n燕曾知社后，雷未发声前。\n细湿林花暗，轻沾土脉全。\n看看一百五，风势莫狂颠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67690,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寒食日过荆山","author":"梅尧臣","text":"山邮虽禁火，岭树自生烟。\n呜咽同归橹，悲哀欲问天。\n泣亲非泣玉，流泪剧流泉。\n春鲚横刀脍，何心更食鲜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67691,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寒食前一日陪希深远游大字院","author":"梅尧臣","text":"一百五将近，千门烟火微。\n闲过少傅宅，喜见老莱衣。\n晚雨竹间霁，春禽花上飞。\n禅庭清溜满，幽兴自忘归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67692,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"斑竹管笔","author":"梅尧臣","text":"翠管江潭竹，斑斑红泪滋。\n束毫何劲直，在橐许操持。\n欲写湘灵怨，堪传虞舜辞。\n蔚然君子器，安用俗人知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67693,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"景彝率和唐崇徽公主手痕诗","author":"梅尧臣","text":"两壁美人虹已收，苍崖纤手藓痕秋。\n和亲只道能稽古，沉略从来不解羞。\n汉月明明掌中照，胡尘漠漠指间留。\n昭君殁后更多恨，弹作琵琶曲未休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67694,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晴","author":"梅尧臣","text":"风扫天如鉴，云开日似萍。\n苑花犹带湿，蔬甲已微青。\n蝶翅粉应薄，塘漘波更渟。\n寻春不惜醉，莫笑发星星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67695,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"朝二首 其二","author":"梅尧臣","text":"木锁初开水上城，竹篱深闭日光生。\n青苔井畔雀儿斗，乌臼树头鸦舅鸣。\n世事但知开口笑，俗情休要著心行。\n是非不道任挑挞，唯忆当时阮步兵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67696,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"朝二首 其一","author":"梅尧臣","text":"鹅鸭出栏去，儿童临水驱。\n欲开花泫露，聚噪鸟窥厨。\n秣马刈青草，买薪嫌五铢。\n钱刀岂今古，村叟一何愚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67697,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]