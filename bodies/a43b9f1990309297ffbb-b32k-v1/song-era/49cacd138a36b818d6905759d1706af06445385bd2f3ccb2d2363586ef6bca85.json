[{"title":"次韵高阳吴中复待制见寄","author":"赵抃","text":"守蜀无堪讵足论，扪参天邈紫微垣。\n岁时丰衍真为幸，犴狱空虚冀不冤。\n素志未容龟曳尾，误恩深愧鹤乘轩。\n嘉章益见公高谊，所得长逢左右原。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37639,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵霍交中春游乐俗亭","author":"赵抃","text":"自怜拙政无他状，强继前贤乐远民。\n轩豁四檐芳草岸，夷犹千棹绿波春。\n岷山霁色尘氛敛，锦里风光气候新。\n暮角未吹人未散，醉歌欢舞共纷纶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37640,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵苏采游学射山","author":"赵抃","text":"锦川风俗喜时平，上巳家家出郡城。\n射圃人稠諠画鼓，龙湫波净照红旌。\n迎真昔诧登天虎，命侣今闻出谷莺。\n勉为远民同乐事，使台仍是得贤明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37641,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送程给事守越州","author":"赵抃","text":"千骑从君临照水，双旌复我守钱塘。\n当年已共攀蟾桂，今日休辞醉羽觞。\n行听龚黄歌治誉，好追元白递诗章。\n分符况与寻常异，彼此东西是故乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37642,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵前人寓越廨宇有怀","author":"赵抃","text":"越郡江南尽不如，乐天流语信非疏。\n人从锁闼中间出，宅在蓬莱向上居。\n言念玉符分镇日，却思琼苑拜恩初。\n临风又辱诗筒寄，足见优游刃有馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37643,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再用韵","author":"赵抃","text":"一别三秋一日如，望中红叶已萧疏。\n曾闻眷注行优召，自顾衰迟未退居。\n在昔游从今道旧，平生事契敢忘初。\n古人最重交情久，堪笑当年汉耳馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37644,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和前人有怀二首 其一","author":"赵抃","text":"一日褰帏令必从，自惭前秕属衰翁。\n声回地底清霜角，讼自庭中冷缿筒。\n旧契世同知管鲍，新文人服似轲雄。\n公閒数有琼瑶赠，又使乡闾笃士风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37645,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和前人有怀二首 其二","author":"赵抃","text":"远如千里志还同，目断云天未易穷。\n勉强一麾吴国分，雍容五马浙江东。\n泉源自古流丹井，桂子还逢下月宫。\n尽占神仙真乐地，轩裳何敢羡三公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37646,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵郡斋即事二首 其一","author":"赵抃","text":"凤沼宠荣辞禁闼，龙山安稳驻车轮。\n东方渐喜威严霁，属郡争传号令新。\n试数岁华如过隙，宜将世事拂前尘。\n因思四十年同榜，吴越如今只两人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37647,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵郡斋即事二首 其二","author":"赵抃","text":"田原多稼才丰日，橘柚逢霜正熟初。\n鉴水烟波乘兴远，兰舟风月助吟馀。\n安知贺老惟修道，未必羲之祗嗜书。\n谁道蓬莱宫尚小，玉皇香案吏来居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37648,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵见寄","author":"赵抃","text":"勇退犹惭大丈夫，两州四任若冥符。\n未容上冢重官越，不谓班条再守吴。\n云屋万家诚乐地，涛江一水隔名都。\n同年后日同归去，画作东西二老图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37649,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵郡斋偶成","author":"赵抃","text":"两火一刀名素胜，十分双涧地长灵。\n常心曾为乘华舫，好手应难作画屏。\n北海楼前千里静，南山天末四时青。\n蓬莱自是仙家景，解使诗翁醉眼醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37650,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"武林即事寄前人二首 其一","author":"赵抃","text":"乞得钱塘下九天，徙从青社复三川。\n坤维十往万馀里，吴分重来七八年。\n鉴水坐遥怀旧治，柯峰归晚愧前贤。\n东州赖有微之约，曾寄诗筒递百篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37651,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"武林即事寄前人二首 其二","author":"赵抃","text":"七十随缘岂有由，乐天曾不厌杭州。\n青山未隐如千里，白首重来又九秋。\n月窟仙人遗桂子，海门神物助潮头。\n自惭老守无心力，坐镇吾民静即休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37652,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题杭州普应院偃松","author":"赵抃","text":"老松低偃四时荣，太守重来眼为青。\n密叶动摇翔凤势，深根盘屈卧龙形。\n每容狂客春携酒，长庇閒僧昼看经。\n一百年来霜雪操，肯随群木漫彫零。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37653,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵程给事见怀","author":"赵抃","text":"烟水平湖千顷碧，楼台佳木四时青。\n人瞻杳杳升天宅，客意峨峨望海亭。\n已是威怀宽帝念，更加丰稔慰民灵。\n退公莫厌音题密，去鲤来鸿不暂停。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37654,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"有怀前人","author":"赵抃","text":"湖平去棹复鸣鼙，一别何时手重携。\n龙榜昔同科甲乙，虎符今得郡东西。\n寻真曾忆观丹井，乘兴徒思泛剡溪。\n闻说公堂多暇豫，湖山无处不留题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37655,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登望越亭寄程给事","author":"赵抃","text":"望越亭无一点尘，迢迢东首座凝神。\n雨馀岫色浓如黛，日出波光烂若银。\n我类武陵归去客，君为蓬岛上头人。\n谁知老守吾乡便，得与诗翁作善邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37656,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"有怀前人","author":"赵抃","text":"稽岭楼台真旷绝，武林风物竞豪华。\n两川对望音题数，一水中分会晤差。\n东海渺茫排岛屿，西陵依约露人家。\n元和赓唱今犹古，此乐情怀岂有涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37657,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵腊月不见梅花","author":"赵抃","text":"隔江气候不齐时，梅向杭开越上迟。\n春远未通蓬岛信，腊深先放武林枝。\n岭头素艳从争发，笛里孤音却后期。\n虚白堂前攀折看，咏公诗句醉金卮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37658,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵楼头闻角","author":"赵抃","text":"龙蛰穷冬万否开，蛩吟清晓在蓬莱。\n五更枕上惊残梦，一曲楼头动小梅。\n入牖凉飔声咽绝，满庭斜日思徘徊。\n新年合我七十一，柯岭不如归去来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37659,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵岁暮有感","author":"赵抃","text":"岁月如流不用嗟，盛衰前定岂曾差。\n自怜览照头浑雪，犹喜观书目未花。\n竺岭两曾逢落桂，龙山三见撷新茶。\n春元便欲休官去，谁顾杭州十万家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37660,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵即事见怀","author":"赵抃","text":"鉴水宽閒称越国，河塘繁剧是杭州。\n蓬山君继元丞相，竹马予惭郭细侯。\n郡邑丰穰真可喜，人家饱煖更何忧。\n西陵隔岸无多远，数上临江百尺楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37661,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"岁暮偶成寄前人","author":"赵抃","text":"宦途衰老改辞勤，只计斯民不计身。\n眷恋青山乖素约，迟留白首未归人。\n举头旧治无三舍，屈指明朝又一春。\n珍重东州年契厚，趁潮双鲤得书频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37662,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戊午元日偶成","author":"赵抃","text":"驱驰光景急如轮，复见元丰岁始春。\n七十一年欣入手，三千奏牍欲归身。\n江涛有信人随老，烟草无涯色又新。\n自是乞骸时节好，不应推托为思莼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37663,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清风阁即事","author":"赵抃","text":"庭有松萝砌有苔，退公聊此远尘埃。\n湖音隐隐海门至，泉势潺潺石缝来。\n夜榻衾裯仙梦觉，晓窗灯火佛书开。\n休官不久轻舟去，喜过严陵旧钓台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37664,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杭州上元观灯 其一","author":"赵抃","text":"元夕观灯把酒杯，宾朋不倦醉中陪。\n一轮丹桂当天满，千顷红莲匝地开。\n烟火楼台高复下，笙歌巷陌去还来。\n因民共作连宵乐，直待东方明始回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37665,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杭州上元观灯 其二","author":"赵抃","text":"初逢稔岁改初元，元夜从游驾两轓。\n寺曲水灯多巧怪，河塘歌吹竞喧繁。\n安排百戏无虚巷，开辟重关不锁门。\n愿以民心祝尧寿，从星高拱北辰尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37666,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵程给事越州元夕观灯","author":"赵抃","text":"隔江灯火越王城，别有新春喜复惊。\n累夕思乡还有感，三年怀旅岂忘情。\n歌钟浩浩临香陌，罗绮盈盈簇彩棚。\n秉烛夜游公不倦，也知斯乐为民行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37667,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵前人治西园池馆因怀昔日太守蒋堂侍郎二首 其一","author":"赵抃","text":"越有西园作者谁，公今不感咏歌之。\n千馀骑拥频来赏，四十年间尚去思。\n稚耋行谣方载路，主宾高会正乘时。\n也知此乐同民乐，况有前贤台沼诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37668,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵前人治西园池馆因怀昔日太守蒋堂侍郎二首 其二","author":"赵抃","text":"去年春色染波澜，画舸朝游暮可还。\n今岁屡闻临曲水，隔江惟是仰高山。\n翻思贤守经营处，尽属诗翁笑语间。\n公勿留连当亟召，德音行被对天颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37669,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"有怀前人","author":"赵抃","text":"却忆东舟去若仙，江亭分袂忽经年。\n春风境上无多地，夜月湖中共一天。\n海阁坐观涛拥鹭，山堂吟听漏移莲。\n新诗往复交情见，巨集成来已百篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37670,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵前人见寄","author":"赵抃","text":"阻奉交朋宴赏欢，杏林春发圣师坛。\n诗筒把玩初藏袖，铃阁吟哦为整冠。\n不啻梦昏惊玉磬，正如沈痼得金丹。\n夜来月下闻韶濩，并奏清音彻广寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37671,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄酬前人","author":"赵抃","text":"落笔词华矜白雪，棹寻花卉认红云。\n湖山对酌春将尽，风月高吟夜欲分。\n思入神酬青玉案，梦游仙拥羽衣裙。\n近来章句声名远，僻似鸡林也得闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37672,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄酬前人上巳日鉴湖即事三首 其一","author":"赵抃","text":"禊饮已经佳节后，画船犹泛若耶滨。\n未还魏阙陪仙使，且向稽山作主人。\n赓唱我知长引玉，恳归谁道苦思亲。\n鉴湖也似西湖好，两处风光一样春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37673,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄酬前人上巳日鉴湖即事三首 其二","author":"赵抃","text":"湖上初经上巳春，水边遥见碧芜新。\n轻舟竞泛无涯乐，夹岸希逢不醉人。\n厨酝旋斟浮蚁酽，府茶深点卧龙珍。\n诗筒往复余知幸，垂老亲仁得善邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37674,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄酬前人上巳日鉴湖即事三首 其三","author":"赵抃","text":"蓬莱高与卧龙俱，位望兼隆似合符。\n弦管夜声传井邑，楼台春影蘸江湖。\n休功即报期年政，直节曾行万里胡。\n真是玉皇得案吏，坐看归去赞萝图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37675,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵前人蓬莱阁即事","author":"赵抃","text":"蓬莱窗外晓光分，梦觉初惊杜宇魂。\n但有吏供衙府喏，断无人到讼庭喧。\n濛濛宿霭开湖面，隐隐更潮过海门。\n一水两州皆重镇，越清杭剧不同论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37676,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻致政赵少师概入境寄献","author":"赵抃","text":"我公优暇若神仙，八十高龄众所贤。\n政府昔同俄一纪，留封今别又三年。\n及时和气来吴国，度曲薰风入舜弦。\n昨日清台应密奏，老人星照浙西天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37677,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上天竺寺石岩花","author":"赵抃","text":"对植齐开古梵宫，欲求精笔画难工。\n直将春占三旬盛，谁谓花无十日红。\n未羡山桃资客笑，且陪庭柏作家风。\n遍寻他处都无此，宝殿前头只两丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37678,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵程给事寄献赵少师","author":"赵抃","text":"暮春船舣浙西州，且喜樽前两白头。\n蓬阁屡传宾榻解，涛江深阻故人游。\n凝眸宴集踰天远，屈指光阴若箭流。\n赖有诗筒并驿使，往还金玉共赓酬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37679,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵赵少师寄程给事二首 其一","author":"赵抃","text":"轻舟来蜀幕春时，便向钱塘咏式微。\n临海阻陪三岛会，隔江遥认五云飞。\n杀鸡炊黍初乘兴，怨鹤惊猿却念归。\n一水盈盈天一色，夜来千里共蟾辉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37680,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵赵少师寄程给事二首 其二","author":"赵抃","text":"襟怀冲旷忆江湖，老我全吴契不疏。\n北阙乍违尧日远，南风新入舜弦初。\n纻溪鉴水吟无厌，箭笋鎗茶味有馀。\n越绝主人招意重，卧龙山好驾安车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37681,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"少师自南都见访为诗以谢","author":"赵抃","text":"中怀和气祗如春，对酒赓歌莫厌频。\n半载昔同参国论，十年今长类天伦。\n不辞命驾踰千里，应念同心有二人。\n珍重宗盟恩意厚，岁寒终始见松筠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37682,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"留前人度夏方回南都","author":"赵抃","text":"宫师弥寿降尊时，顿觉光华满郡扉。\n况属炎晖初可畏，未逢秋爽莫言归。\n山堂酒嫩浮红蚁，石缝茶新碾翠旂。\n有美望湖风四面，尚留挥汗雨沾衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37683,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵前人题六和寺壁","author":"赵抃","text":"上方楼殿已幽深，更向诸峰胜处寻。\n金摆池鱼惊俗眼，琴调山溜写清音。\n红芝九本初无种，翠柏千株自有心。\n众羡宫师康且寿，始知功德积来阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37684,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陪前人游西湖兼简坐客","author":"赵抃","text":"丝管喧喧拥画船，澄澜上下照红莲。\n一樽各尽十分酒，四老共成三百年。\n北阙音书休忆念，西湖风物且留连。\n杭民夹道焚香看，白发朱颜长寿仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37685,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再用前韵","author":"赵抃","text":"共泛湖光范蠡船，持杯欢客倒金莲。\n此时朋契偕行乐，何日郡恩许引年。\n照水暗知华发改，倚楼高与紫云连。\n安车盛暑盘桓好，况是人间一散仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37686,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"武林言怀寄程给事","author":"赵抃","text":"岁丰公暇两安舒，吴越诗筒不使疏。\n世契琼瑶风谊厚，秋光怀袖气凉初。\n二千石重閒无计，七十年过退有馀。\n得旨便归田陇去，乡人从笑老农如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37687,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵前人怀西湖之游","author":"赵抃","text":"昔时唐殿预英雄，今独湖山幸会逢。\n谪宦青钱曾万选，承恩白首是三公。\n龙山我念经年别，虎榜君曾昔日同。\n老守七章还印绶，俞音朝暮出宸衷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37688,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵前人见寄二首 其一","author":"赵抃","text":"羡公铃閤绝纤尘，顾我何尝德被人。\n讼牍自怜无日暇，诗筒翻喜入秋新。\n白头未许还官政，紫诏频烦慰老臣。\n一去蓬莱已踰岁，梦魂长到十洲春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37689,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵前人见寄二首 其二","author":"赵抃","text":"立贤中外圣情均，青锁闱中辍迩臣。\n越水澄清无俗虑，秋风萧瑟助吟神。\n分符共治俄经岁，屈指同年尚几人。\n退鼓近来衰气觉，敢将诗酒敌东邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37690,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄新筠守毛维瞻大夫","author":"赵抃","text":"倚庐聊见复睽乖，忆遗诗筒字字佳。\n为乏琼瑶酬雅意，故凭笔牍写离怀。\n程赊越北层云断，路入江南叠巘排。\n我望贻书何以报，要将风谊属吾侪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37691,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵许遵少卿见寄","author":"赵抃","text":"头上有霜添白发，囊中无药驻朱颜。\n堪惊积岁加衰老，未省何时得退閒。\n渊净思临浮石渚，喧哗羞对武林山。\n君恩早赐俞音下，即拥菟裘故里还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37692,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答前人喜杭越二守赓唱","author":"赵抃","text":"吴越江分两郡斋，涛音朝夕听风雷。\n且陪故友閒赓唱，未遂先庐归去来。\n时节丰登饶鼓吹，湖山清旷见楼台。\n中秋明月期公共，万里烟氛彻晓开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37693,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"喜吴评少卿致政","author":"赵抃","text":"春秋七十更踰期，同甲同年世所稀。\n未遂乞骸嗟我老，已输先手羡公归。\n良朋集有湖山乐，故里思无羽翼飞。\n预想俞音还印日，鹭涛秋色上行衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37694,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵许少卿寄卧龙山茶","author":"赵抃","text":"越芽远寄入都时，酬倡珍誇互见诗。\n紫玉丛中观雨脚，翠峰顶上摘云旗。\n啜多思爽都忘寐，吟苦更长了不知。\n想到明年公进用，卧龙春色自迟迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37695,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵程给事郡斋即事","author":"赵抃","text":"望中吴越不为赊，止隔涛江便一涯。\n台沼赐湖非俗地，蓬瀛标阁属仙家。\n僧居壁古多留句，吏事庭虚只放衙。\n胜绝东方无复道，当年元相有诗誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37696,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵前人郡斋秋暑","author":"赵抃","text":"老为乡郡止偷安，自愧仙踪未易攀。\n八面松阴笼古寺，三秋桂子下灵山。\n良朋寄意诗篇里，高会追陪梦寐间。\n却忆会稽清旷处，樵风朝暮若邪弯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37697,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观宝林院塔偶成","author":"赵抃","text":"宝山新塔冠山形，心匠经营不日成。\n突兀插天三百尺，庄严容佛一千名。\n下临泉窦灵鳗蛰，上拂云端过雁惊。\n入境行人十馀里，指浮图认越王城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37698,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵毛维瞻度支过杭见赠","author":"赵抃","text":"吴民疲病惭攻治，寻胜西湖不放稀。\n秋后涛江增气势，夜深灯市斗光辉。\n望云翻忆青山旧，上印须添白发归。\n孝弟里闾松竹茂，柴扉谁复羡朱扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37699,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送姚源道郎中赴阙","author":"赵抃","text":"我念同僚遽解携，赠言如古漫成诗。\n二年别乘临岐日，八月登槎上汉时。\n莫阻十分斟酿蚁，不须三叹听歌骊。\n还朝宠数应非次，神圣方今大有为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37700,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄致政范镇郎中","author":"赵抃","text":"分携常忆禁门东，四见光阴换岁筒。\n白玉堂吉辞旧相，青城山里访仙翁。\n当时大本从忠谏，此日长年益道风。\n应惜西湖犹未到，近来同赏有三公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37701,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]