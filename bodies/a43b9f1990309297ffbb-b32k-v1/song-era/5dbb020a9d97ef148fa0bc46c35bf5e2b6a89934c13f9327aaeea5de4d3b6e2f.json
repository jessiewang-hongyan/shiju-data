[{"title":"喜雨应祷","author":"韩琦","text":"运月愆阳作旱灾，龙坛申祷洁三垓。\n至诚始惧卑高隔，嘉应俄如影响来。\n喜阔农心归击壤，润深人意不惊雷。\n大钧广播知难报，埏埴何尝望一杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37137,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵答签判沈唐太丞应祈雨足","author":"韩琦","text":"一雨滂沲过作霖，油云随祷极阴森。\n微诚未必回天意，灵答潜知渴众心。\n瑞绝莫先惟在谷，价高难拟不论金。\n朝来田畯更相贺，犁下侵淫二尺深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37138,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄致政欧阳少师","author":"韩琦","text":"独步文章世孰先，直声孤节亦无前。\n欲知退足高千古，请视经犹疾五年。\n在我光阴长更乐，扶天功业去如捐。\n西湖风月谁为伴，笑许当时处士贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37139,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"盛暑思接荣归之游寄相守张工部","author":"韩琦","text":"伏暑如何散郁陶，荣归陪赏望空劳。\n红芳照槛莲千颊，绿荫环波柳万条。\n趋第小车谁竞挽，见山新址日增高。\n遥知贤守多娱地，诗笔虽豪酒未豪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37140,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"辛亥七夕末伏","author":"韩琦","text":"二七今同末伏辰，初秋时候暑微熏。\n星桥旧说通灵匹，剑肉何人遗细君。\n瑩席冰寒心共爽，噪风蝉急耳欣闻。\n郢中新曲高难和，唯付珠喉任遏云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37141,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"七夕会关亭观莲","author":"韩琦","text":"陶暑娱宾次水西，满塘莲艳馥轩墀。\n荷坳似学伞翻去，房曲如将盏倒垂。\n肯把风流欺俭幕，且凭歌调拟吴姬。\n从来拙宦老难巧，任过灵光醉不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37142,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贻刑","author":"韩琦","text":"忆帅秦亭二纪馀，当时宾幕盛芙蕖。\n椎牛共乐毬场宴，倚马常资记室书。\n台席久从还绶退，月卿犹滞剖符居。\n樽前想解留连意，一笑难逢易掺袪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37143,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"元城埽行河","author":"韩琦","text":"怒河秋涨俯都城，纵啮长堤岂易平。\n气悍若从天上落，势高难使地中行。\n筑垣居水虽危事，沈马回波是至诚。\n故道几时循禹迹，免教常岁害民生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37144,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"行河道中","author":"韩琦","text":"鳞鳞郊隰引双旌，顿豁尘襟病眼明。\n微霭际空随日破，遥林环野接天平。\n捺弮禾重笼新雨，舐犊牛闲罢力耕。\n策马故寻堤上路，移时欣在绿阴行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37145,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"辛亥八月十六日社始月望","author":"韩琦","text":"中秋不必拘三五，惟望时方月正圆。\n已荐社壝通肸蚃，始开宾席对婵娟。\n清光自喜今宵满，俗会从输一日先。\n乐事几为风雨破，直须欢饮倍常年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37146,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"辛亥八月十六日夜复值阴晦","author":"韩琦","text":"舒轮方满正中秋，报社神歆已降休。\n且共良农歌稔岁，何须明月照高楼。\n金丝自壮欢吟气，风雨终为乐事仇。\n酣饫野翁犹带断，不争豪饮亦堪羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37147,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中秋饮散始微见月","author":"韩琦","text":"待月中秋欲共欢，不堪阴晦阻群观。\n宾归已彻青油幕，云绽聊窥白玉盘。\n就榻酒狂平未歇，据鞍吟苦得应难。\n孀娥此夕潜何甚，专要人将别眼看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37148,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九月四日会安正堂","author":"韩琦","text":"秋光浓拂使君家，尚去重阳五日赊。\n且育好诗成素饮，更先诸客对黄花。\n池萍渍雨钱钱密，塞雁书空字字斜。\n但纵高吟开醉胆，莫惊摇落动悲嗟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37149,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"辛亥重九会安正堂","author":"韩琦","text":"斯堂曾许占风光，须到重阳复命觞。\n坐上半非前岁客，杯中无改旧花香。\n初晴已过登高水，散虑宜趋自得场。\n唯有一时诗酒战，愿开强户振雄铓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37150,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"即席再赋","author":"韩琦","text":"芜音逢节佐宾罍，属和当筵尽雅才。\n铜钵一声诗已就，金铃千朵菊争开。\n月明正有抽毫乐，夜永何妨秉烛回。\n无酒可嗤彭泽令，东篱空望白衣来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37151,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"辛亥重九登骑山楼","author":"韩琦","text":"西北楼高四望长，登临还赏节辰良。\n荀陈盛集星光动，相卫名山记字详。\n玳瑁不妨攲醉弁，茱萸谁自斗香囊。\n病翁安敢当能赋，只俟英瑶作报章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37152,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和运判张端秘丞戏题安阳郡园","author":"韩琦","text":"垂杨阴里百花开，谁记当时任意栽。\n好事继逢贤太守，算无心望主人来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37153,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"代郡园见答","author":"韩琦","text":"昼锦轻抛又几年，纵逢春色亦依然。\n争知台榭笙歌外，尽是猿惊鹤怨天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37154,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再戏郡园","author":"韩琦","text":"一辞康乐困喧嚣，花笑莺啼似借嘲。\n日望君恩容病质，得归应自解譊譊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37155,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再代答","author":"韩琦","text":"买臣素贱犹乡守，庄舄虽荣尚越吟。\n已葺吾园似仙府，莫教归信苦沈沈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37156,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"御河舟中","author":"韩琦","text":"过虑先河备，轻舟造惬山。\n惊鸥情自动，流水意长闲。\n村落多丰外，寒温不定间。\n如何援民溺，搔首只空还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37157,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"视河惬山","author":"韩琦","text":"河决金堤在汉成，曾推延世此经营。\n安人为惬当时意，立事因垂不朽名。\n谁凿故山酾御水，却通新漕入都城。\n一疏一塞俱称利，暂访遗踪岂易评。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37158,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"至节筵间喜雪","author":"韩琦","text":"至节开樽就席前，六花飞舞助宾筵。\n飏空自胜重罗面，引满偏宜旋絮绵。\n合坐欢谈霏屑地，几声横笛落梅天。\n况逢阳复贞亨会，赢取笙歌烂醉眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37159,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"元宵席上","author":"韩琦","text":"灯烛森森万象罗，彻宵车马罢谁何。\n追人好月婵娟满，带雪轻寒料峭多。\n佳节俯从河沴寝，群心俄逐诏音和。\n乘春自欲开民郁，不为樽前笑与歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37160,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵答致政欧阳少师退居述怀二首 其一","author":"韩琦","text":"日跂高风谢世纷，只思移疾卧漳濆。\n万钟糠秕常知慕，三径蓬蒿欲自耘。\n忠义心诚终老合，仙凡岐路此时分。\n唯瞻天外冥鸿远，会起卑飞及旧群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37161,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵答致政欧阳少师退居述怀二首 其二","author":"韩琦","text":"尘俗徒希勇退高，几时投迹混耕樵。\n神交不间川涂阔，直道难因老病消。\n魏境民流河抹岸，颍湖春早柳萦桥。\n相从谁挹浮邱袂，左在琴书酒满瓢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37162,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"壬子上巳会许公亭","author":"韩琦","text":"来守留都第四年，年年元已此开筵。\n一春曾喜陈歌舞，三会皆逢去管弦。\n无乐只忧辞酒客，多寒谁辨惜花天。\n欲看郊外风光野，更上亭西祓禊船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37163,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上巳视惬山新堤","author":"韩琦","text":"元巳西津禊饮中，筑防因视惬山雄。\n调夫虽扰三农业，禦水犹希一篑功。\n曲突虑微方绝患，开门轻敌是招戎。\n岸边观者应相笑，遭贼徒弯过后弓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37164,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"壬子寒食会压沙寺二首 其一","author":"韩琦","text":"踏沙徐人绿杨中，渐见祗园宝势雄。\n柏奋怒虬环古殿，花遗娇靥散春风。\n娱心未放歌声好，对目难穷幻术工。\n共醉一时寒食景，不须庭际牡丹红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37165,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"壬子寒食会压沙寺二首 其二","author":"韩琦","text":"一春光景速奔车，且趁良辰会压沙。\n藏火未须传蜡烛，感时空自把梨花。\n笙歌不作芳菲主，风雅终成冷淡家。\n归路复疑霄汉上，御波舟稳衬云霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37166,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同赏梨花","author":"韩琦","text":"寒食西蓝赏素英，白毫光里乱云腾。\n庄严金地三千界，颜色瑶台十二层。\n后土琼花渐我寡，唐昌玉蕊岂吾朋。\n雪香预约为亭号，修创终逢好事僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37167,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"落花","author":"韩琦","text":"万点送春飞，人悲未足悲。\n禅关无问理，溪曲过开时。\n钿委津阳路，风回洛水湄。\n流年来自去，醉莫论空枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37168,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"壬子三月十八日游御河二首 其一","author":"韩琦","text":"寒食初过始及旬，魏都偏重此佳辰。\n倾城尽作河生日，匝岸皆如蜡祭人。\n几舰神仙疑骇俗，一川笳鼓任同民。\n东皇似助熙台乐，并与千门万户春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37169,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"壬子三月十八日游御河二首 其二","author":"韩琦","text":"三月游河魏国风，惬山通日正暄融。\n压沙寺古花残雪，过马桥高水饮虹。\n众乐自深春色外，万愁俱泯醉吟中。\n天公恐雨伤民意，只放轻云暝碧空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37170,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"舟中再赋一阕","author":"韩琦","text":"画艗双双掠水飞，一天云重锁春晖。\n遨头不与追铙鼓，无限游人寂寞归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37171,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"安正堂观牡丹","author":"韩琦","text":"何须风雨苦相催，自结东君不在媒。\n开晚要当三月盛，艳高宜作百花魁。\n好期天上香魂返，长对樽前醉玉颓。\n谁道元舆能体物，只教羞死刺玫瑰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37172,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"致政宫师张相公远惠佳篇谨次元韵为答","author":"韩琦","text":"八十康宁极品荣，神仙居处足颐生。\n风骚此日资高尚，事业当年有太平。\n酒量更从闲后长，禅心偏向静中明。\n自嗟不及飞来鹤，能伴公游称道情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37173,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又次韵和续成绝句","author":"韩琦","text":"醉卧嵩云得句豪，岂知平地有风涛。\n应嗤病骥盐车重，终日长鸣只告劳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37174,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻致政赵少师远访欧阳少师于颍川","author":"韩琦","text":"一忆贤交动至诚，安车虽远必勤征。\n荀陈为会还推象，嵇吕相思不问程。\n洛社成图兹易合，越溪回棹彼何情。\n西湖便是瀛洲上，莫接仙游跨海鲸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37175,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻前都水王荀龙郎中将率二三知旧游天平山寺","author":"韩琦","text":"天平高绝是家山，雨治安阳欲到难。\n此日名郎真好事，直携嘉客远同观。\n峰擎寺脚重霄近，雹起潭心六月寒。\n遥想醉吟昆阆里，乱飞珠玉出毫端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37176,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵答致政赵少师感怀","author":"韩琦","text":"羡公朝夕挹浮邱，应笑吾曹窘若囚。\n尘外有谁攀逸驾，壶中何处著闲愁。\n心休已得天真乐，身退犹存国事忧。\n积善由来神所劳，坐膺全福不须求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37177,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"壬子中秋对月","author":"韩琦","text":"一轮徐出海东头，皓彩全供白帝秋。\n桂迹自消安在斫，宝光无缺不因修。\n池心影撼金鳞碎，杯面波随玉液流。\n此夜圆蟾看处好，何须偏上最高楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37178,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登大安寺阁","author":"韩琦","text":"岧峣飞阁耸晴空，此过层梯第几重。\n四野风烟笼胜地，半天金碧护真容。\n浮图逼槛抽双笋，埤堄排云矗万峰。\n数刻飘然霄汉上，直疑超界脱尘踪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37179,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"八月十九日赏菊","author":"韩琦","text":"春英无不惜开迟，秋菊常怀素景悲。\n惯负晚霜甘索寞，忽逢先闰促离披。\n欲移庭槛嫌伤早，拟泛宾罍未入时。\n自是寒花当守分，一违佳节速人嗤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37180,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"壬子九月七日会大安寺","author":"韩琦","text":"萧辰禅宇展疏筵，才去登高二日前。\n欲识先期成雅会，要闻清论接英贤。\n何须白发喧歌板，自有黄花送酒船。\n危阁半空同倚槛，一般重九寂寥天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37181,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"壬子重九","author":"韩琦","text":"菊有黄花气候移，重阳香萼已乾枝。\n金铃后坼孤芳在，玉液轻浮一醉宜。\n烟渚去来鸿自适，霜丛飞绕蝶何知。\n风前客帽从吹落，且伴山翁倒接䍦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37182,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赵资政再尹西蜀","author":"韩琦","text":"坤维求尹此难才，重倚真贤出上怀。\n一去棠阴歌蔽芾，再来人乐似乖崖。\n新承纶綍从天别，旧过山川作画排。\n莫候使星临益分，郎回符采正三阶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37183,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"壬子冬至喜雪","author":"韩琦","text":"阳气初升力尚微，雪花来促故阴归。\n润滋柔荔乘时出，暖逐轻灰应律飞。\n彤笔喜丰书瑞谍，土圭收影侍灵晖。\n践长班集应同贺，剑佩光寒拱殿闱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37184,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵答接伴夏倚少卿","author":"韩琦","text":"定幕雍容绿水滨，使轺今喜接光尘。\n当年不足称良治，此日空惭问大钧。\n钟鼎已无前饮胜，笑言应认昔怀真。\n开樽莫惜俄欢弁，数刻相违易怆神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37185,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"壬子十一月二十九日时雪方洽","author":"韩琦","text":"近腊犹悭六出繁，忽惊盈尺及民宽。\n万方蒙泽人人贺，通夕无风阵阵乾。\n危石盖深盐虎陷，老枝擎重玉龙寒。\n欲知灵鹫银为界，试陟高楼一望看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37186,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新移宴厅","author":"韩琦","text":"魏藩池馆有唐风，宴宇耽然制尚雄。\n岁月已深摧巨栋，庭除非旧逼离宫。\n稍迁基址嚣尘外，适在园林掩映中。\n从此命宾何最盛，四时嘉景尽牢笼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37187,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"癸丑灯夕","author":"韩琦","text":"争放红蕖燎紫沈，胜游谁肯惜千金。\n人和更有笙歌助，酒美应无巷陌深。\n化国光阴方甚永，洞天风物不难寻。\n如何可致吾民乐，长似熙熙此夜心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37188,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"壬子春分方见迎春盛开以小诗嘲之","author":"韩琦","text":"迎得新春入旧科，独先嘉卉占阳和。\n今年顿被寒摧朽，应为尖头送暖多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37189,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"癸丑初拜先坟","author":"韩琦","text":"昼锦三来治邺城，古人无似此翁荣。\n首过先陇心还慰，一见家山眼自明。\n酾酒故庐延父老，驻车平野问农耕。\n便思解绶从田叟，报国惭虽万死轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37190,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次日早赴西坟","author":"韩琦","text":"风入旌旗撼晓光，两茔亲展喜非常。\n浓阴蔽野瞻乔木，逸势横天认太行。\n自叹重茵宁及养，纵垂三组敢夸乡。\n路人或指荣虽甚，明哲何如汉子房。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37191,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"坟北观泉","author":"韩琦","text":"坟北清泉味至甘，寺僧渟蓄已成潭。\n跃鱼灵感思追孝，酌水高怀不戒贪。\n万草日滋珠竞出，一天晴落鉴方函。\n暂延嘉客求新句，欲创幽亭即就龛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37192,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初会昼锦堂","author":"韩琦","text":"重向高堂举宴杯，四年牵强北门回。\n故园风物都如旧，多病襟怀遂一开。\n白发耻夸金络骑，绿阴欣满铁梁台。\n因思前彦荣归者，未有三曾昼锦来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37193,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵答提点醴泉张宗益工部喜还乡郡","author":"韩琦","text":"倦飞垂翼奈劳何，喜向南枝得旧窠。\n三治故乡前世少，一思遗履上恩多。\n病魂醒处安闲枕，酒量衰来怯巨螺。\n复听雅音清聩耳，爱居谁辨九韶和。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37194,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初会荣归堂","author":"韩琦","text":"当年尝欲志荣归，因建虚堂面北池。\n樽俎落成方自我，园林为主已输谁。\n重来故里前恩在，难报深仁旧老知。\n须俟安车时访此，践言人始信吾诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37195,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再题狎鸥亭","author":"韩琦","text":"危亭初起俯清浔，只得当轩几醉吟。\n一日乡园伤骤别，四年宫阙动归心。\n檐前好竹今成筱，波下修鳞旧种针。\n鸥识再来尤不惧，向人驯狎似家禽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37196,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初登休逸台","author":"韩琦","text":"休逸台高复凭栏，依然风月喜生颜。\n城头仰视亲栽柳，天外微分旧见山。\n草色且无归后怨，禽飞同到倦时还。\n欲知恩许三来幸，锦烂轻裘白昼闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37197,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"荣归观莲戏成","author":"韩琦","text":"风捲莲香不断头，田田荷影动清流。\n红包密障鱼鹰坐，绿盖低容水马游。\n时折嫩梢供玉箸，更裁圆叶代金瓯。\n何如满舰倾醇酎，醉向花前打拍浮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37198,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再葺双硙","author":"韩琦","text":"昔嗟官曲岁劳民，尝引新渠激硙轮。\n若念经营存爱利，肯从隳朽贵因循。\n轩楹遇葺知还旧，花木欣来似见春。\n已作州人游观地，即期同俗乐芳辰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37199,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"喜雨","author":"韩琦","text":"何假嗔雷击怒桴，点倾嘉泽浃民区。\n经时亢隔群心骇，数月焦熬一阵苏。\n已发宋苗安在揠，再生庄鲋不虞枯。\n须叟慰满三农望，却敛神功寂似无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37200,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再题康乐园","author":"韩琦","text":"旧拓名园壮邺中，本思行乐兴民同。\n闾阎已惯春游盛，花木谁矜半植功。\n爱客笙歌虽不定，称时风月且无穷。\n三来纵赏人休讶，白发苍颜坐醉翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37201,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]