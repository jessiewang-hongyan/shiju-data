[{"title":"题使台后圃八首 其七 清音楼","author":"释德洪","text":"雾暗轩窗失，风高帘幕低。\n夜晴湘笛起，楼迥岭猿啼。\n凭槛人如玉，搜诗气吐霓。\n还惊一声雁，翻影月平西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61651,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题使台后圃八首 其八 蒙斋","author":"释德洪","text":"妙物杂而著，深藏一默中。\n诚为反身乐，蒙亦圣人功。\n客至风生麈，吟馀月挂空。\n庄周称社栎，神拙意无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61652,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵李方叔游衡山僧舍","author":"释德洪","text":"道乡见城郭，世路谩升沉。\n寺胜增佳气，壁间馀醉吟。\n僧残过客少，山好为谁深。\n宁识通泉尉，独怀经济心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61653,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵谒子美祠堂","author":"释德洪","text":"颠沛干戈际，心常系洛阳。\n爱君臣子分，倾日露葵芳。\n醉眼盖千古，诗名动八荒。\n坏祠湘水上，烟树晚微茫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61654,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵达臣知县祈雪游岳麓寺分韵得游字","author":"释德洪","text":"丛祠香火罢，山寺偶同游。\n炉拨红金涌，窗空碧缕浮。\n旋敷白氎布，暖甚紫茸裘。\n试作吉祥卧，梦清如素秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61655,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题梦清轩","author":"释德洪","text":"小轩人不到，脩竹过墙生。\n眼倦经长掩，身闲梦亦清。\n微风吹篆缕，活火发茶铛。\n遥想佳眠夕，萧萧雨叶声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61656,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题一击轩","author":"释德洪","text":"閒把松枝彗，扫除门径尘。\n惊闻一击竹，顿见十方身。\n烟翠连窗暗，霜筠解箨新。\n老禅搆轩意，应欲悟来人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61657,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵胥学士","author":"释德洪","text":"笔下惯生春，年高句法新。\n还将吐凤语，来寄牧牛人。\n敏若盘珠妙，深如社栎神。\n长哦答清境，璧月上重闉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61658,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题曾逢原醉经堂","author":"释德洪","text":"酌古有深意，开编中圣人。\n百家笑糟粕，六艺饮全醇。\n兀若坠车适，盎如浮盏春。\n淳于吞一石，同味不同尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61659,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"隐山照上人求诗","author":"释德洪","text":"落发道林寺，随师家隐山。\n万缘都放舍，一衲遂安閒。\n璧月照宵定，金风掩昼关。\n平生无愧业，尘世许谁攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61660,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"龙山亦名隐山余宣和五年十一月中浣日过焉有浙道人鸿公乞偈为作","author":"释德洪","text":"迷路不知远，但知寒日斜。\n过溪逢菜叶，西崦有人家。\n斫额惊来客，拄锄方种畬。\n鸿禅效古者，当效此生涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61661,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游灵泉赠正悟大师","author":"释德洪","text":"支径入山寺，云林如见招。\n小轩临绝壑，危阁碍层霄。\n瓶泣地垆暖，屋睛岩雪消。\n大师京国旧，放意话州桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61662,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"七月初九夜坐西轩雨止月出不胜清绝","author":"释德洪","text":"夜雨止还作，小轩清有馀。\n暴寒吹客梦，残响滴阶除。\n明灭青灯在，帘栊璧月孤。\n故山归未得，千里漫平芜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61663,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"甲辰十一月十二日往湘阴马上和季长见寄小春二首 其一","author":"释德洪","text":"雨暗书云节，梅偷破腊春。\n里闾相馈饷，风物近袁筠。\n吴语知无伴，楚衣聊试新。\n忽惊身是客，流落老湘滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61664,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"甲辰十一月十二日往湘阴马上和季长见寄小春二首 其二","author":"释德洪","text":"风埃九十里，雾雨湿驼裘。\n雁过回诗眼，江寒聚晚愁。\n魂清方怯雪，句冷更含秋。\n残岸连孤屿，依稀似橘洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61665,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题阅世轩","author":"释德洪","text":"江水似人世，倚栏归思多。\n无穷流岁月，可畏易风波。\n□与老僧看，不妨闲客过。\n为君聊借榻，清梦到无何。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61666,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"云庵生辰","author":"释德洪","text":"探手取空劫，爪分破一尘。\n洞然无空缺，独立不鲜陈。\n试问声前见，何如顶后亲。\n死生浪遮掩，漏泄是今辰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61667,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵济之和刘元老偶成之句","author":"释德洪","text":"世乱惊流落，名高子可依。\n元龙谢襁负，叔冶冒重闱。\n黄屋方回望，青山敢问归。\n三桥伏道几，应叹眼中稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61668,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠成上人之云居","author":"释德洪","text":"天上欧峰寺，人间无事僧。\n偶从白沙岸，步入碧螺层。\n服匿连空钵，敷罗挂瘦藤。\n遥知云起处，一室掩香灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61669,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"四月二十五日智俱侍者生日戏作此授之","author":"释德洪","text":"与佛同生月，犹迟十八朝。\n参禅唯自肯，求法转相辽。\n谷响千斤重，虚空五采描。\n布毛吹起处，豁尔万缘消。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61670,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢大沩空印禅师惠茶","author":"释德洪","text":"钟鼓五千指，翔空楼殿开。\n不知大沩水，何尔小南台。\n让子鈯斧信，閒禅春露杯。\n故应念岑寂，先寄出山来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61671,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"愈崇二子求偈归江南","author":"释德洪","text":"人笑南台小，难安十八僧。\n日贫因日富，宜减不宜增。\n忽去两禅衲，如分一室灯。\n床宽齐顶礼，睡快免相憎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61672,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"曹教授夫人挽词","author":"释德洪","text":"礼敬良天性，求贤比孟光。\n搢绅闻懿淑，闾里发慈祥。\n馔按今谁举，山衣尚箧藏。\n荣名增史牒，有子类鸾皇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61673,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠尼昩上人","author":"释德洪","text":"不著包头绢，能披坏墨衣。\n愧无灌溪辩，敢对末山机。\n未肯题红叶，终期老翠微。\n余今倦行役，投杖梦烟扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61674,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"兴阑","author":"释德洪","text":"春晚忽凭槛，满眸佳景来。\n鸭头波荡漾，螺髻色崔嵬。\n苔嫩钱无数，花残锦作堆。\n一瓯双井酽，何必酒盈杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61675,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与海兄","author":"释德洪","text":"春寒真料峭，久客厌江城。\n云重欲为雨，风和尚未晴。\n意随飞鸟去，事逐乱埃轻。\n毕竟閒居好，烦君念此情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61676,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题灵鹫山","author":"释德洪","text":"侧径入招提，回峰据极西。\n云虚笼殿阁，地僻绝轮蹄。\n啼鸟栖高木，飞花泛碧溪。\n谁当学龙济，垂手接群迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61677,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"灯花偶书","author":"释德洪","text":"岑寂一闲僧，春宵清兴增。\n竹窗催梦雨，兰室对祥灯。\n世事知虚幻，人情剪爱憎。\n短长都分定，不恨百无能。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61678,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"怀友人","author":"释德洪","text":"不见邻峰友，还同楚越遥。\n每劳孤枕梦，时过小溪桥。\n凭槛疏帘卷，临风细雨飘。\n何当奉一笑，令我此情消。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61679,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赋竹","author":"释德洪","text":"龙孙盈槛秀，天柱耸云奇。\n阴锁安禅石，根侵洗砚池。\n珑璁伸粉节，偃蹇郁虬枝。\n敢谓桃兼李，羞邻雪后姿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61680,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贤上人觅偈","author":"释德洪","text":"懒修枯骨观，爱学文字禅。\n江山助佳兴，时有题叶篇。\n相逢未暇语，辄复一粲然。\n岂须究所学，觅偈亦自贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61681,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"黄檗佛智","author":"释德洪","text":"道誉闻寰宇，光华照锦江。\n祗园居第一，佛智果无双。\n凤阙帝恩厚，柏庭禅将降。\n僧中真领袖，传法瑞尧邦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61682,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题沩源","author":"释德洪","text":"临机不堕照，如水已知源。\n从此常流出，其声离语言。\n算沙嗟意马，捉月笑情猿。\n若解提空印，休登立雪轩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61683,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十五日立春","author":"释德洪","text":"千年像教唐朝寺，雪后新年晴复阴。\n残僧无事春又至，游客不来山自深。\n长廊扫叶望空翠，小阁卷经横水沉。\n三生白业有言说，一念净心无古今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61684,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晚步归西崦","author":"释德洪","text":"屋除有路入深壑，曳履翛然独往还。\n播谷风光寒日近，摘茶时节乱山间。\n花枝重少人甘老，燕子空忙春自閒。\n归晚断桥逢野水，更能揎手弄潺颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61685,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宗公以兰见遗风叶萧散兰芽并茁一干双花斗开宗以为瑞乞诗记其事","author":"释德洪","text":"深林忽见兰芽茁，不谓无人亦自贤。\n数叶横风作纤瘦，双花含雪吐明鲜。\n照人秀色虽堪画，入骨真香不可传。\n今日东君应择婿，谁家兄弟斗清妍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61686,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"黄幼安适过予所居题诗草圣甚妙","author":"释德洪","text":"怀袖功名手未探，乱头睡美厌朝参。\n笔端五色藻万象，胸次大千供剧谈。\n山寺寻僧宿风雨，水轩见月出东南。\n题诗满壁龙蛇动，盛事他年说草庵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61687,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"元夕读书罢假寐","author":"释德洪","text":"灯下文章已倦看，欲凭诗苦洗辛酸。\n世途忽起风波易，富贵不忘贫贱难。\n桃坞路迷安石冢，桐川水落子陵滩。\n卧闻屐响东廊静，催粥华鲸吼夜残。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61688,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示忠子","author":"释德洪","text":"梦冷寒庭半夜雨，幽欣临晓一番晴。\n柳娇困顿欲眠去，禽作清圆唤起声。\n曳履点残山寺静，开经拾得纸窗明。\n去年今日岐亭路，吹鬓尘埃趼足行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61689,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"访鉴师不遇书其壁","author":"释德洪","text":"独自来游微雨后，道人乞食及清晨。\n应门童子能迎客，满地榆钱欲买春。\n花醉发狂风日酽，柳眠唤起语音真。\n政当借榻酬无事，熟鼾从教聒四邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61690,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"资国寺春晚","author":"释德洪","text":"龙乡戒晓月空斜，唤起清圆响络车。\n烧笋饷田村窕窈，拾薪煮茧语諠哗。\n美忻崖蜜尝新果，香识山樊称意花。\n归去路迷光已夕，浸门春水一池蛙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61691,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻龚德庄入山先一日作诗迎之","author":"释德洪","text":"梦暖不知窗雾白，眼寒初爱縠罗轻。\n欣闻明日一龚至，想见随轩二李行。\n夜雨晓晴寒食近，水流花发子规声。\n披襟散坐青林下，依约斜川万古情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61692,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晚秋溪行","author":"释德洪","text":"熟路沿溪过石桥，扫除秋晚净迢迢。\n幽寻忽见兰芽茁，小立仍逢柿叶飘。\n扑摝水飞双去鸟，?珑山响一声樵。\n归来半掩残经在，燕寝香凝碧未消。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61693,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"张氏快轩","author":"释德洪","text":"草树分明天远大，酒阑登赏更从容。\n眼寒数点雁横雨，耳热一窗风度松。\n光滑纸开秋色阔，淋漓墨泼暮烟浓。\n欲倾蛟室琼词句，试借温江卓笔峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61694,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋晚同超然山行","author":"释德洪","text":"诸方游遍浑如梦，古寺归来独掩扃。\n无复诗篇云锦段，但馀心境木蛇形。\n高秋霜叶鱼腮赤，落日远山螺髻青。\n步尽松阴忽回首，绿萝疏处见溪亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61695,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送净心大师住温州江心寺","author":"释德洪","text":"万锻炉中百怨门，哲人虽往典刑存。\n扫除临济实头谤，称赏黄龙的骨孙。\n梦泽于菟三口视，丹山雏凤九苞文。\n还乡妙曲谁能听，一笛波心两岸闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61696,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和清上人","author":"释德洪","text":"驹儿堕地已汗血，毛骨萧森落眼中。\n今见马群方弄影，会看雷电疾追风。\n媒龙何止十倍价，凡马终当一洗空。\n我是道林能赏骏，识君语妙到无同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61697,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"升上人过石门","author":"释德洪","text":"门巷榆钱叠紫苔，十年心事首重回。\n暑风院落书签响，烟雨江村画牒开。\n瓦枕藤床初破睡，蔗浆冰椀欲生埃。\n风檐独立看遗照，忽有溪僧犯犬来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61698,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夏日偶书二首 其一","author":"释德洪","text":"碧缕横斜试水沉，红腮甘冷嚼来禽。\n含风广殿闻棋响，转日回廊暗柳阴。\n强撚冰纨馀睡色，倦凭棐几适閒心。\n攀翻涴衲黄尘事，过眼云踪不可寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61699,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夏日偶书二首 其二","author":"释德洪","text":"偏地知谁柳际门，消闲自扫竹西轩。\n井花晓汲闻馀滴，篆烧风摧觅旧痕。\n梦境消磨惊岁月，道乡彷佛见藩垣。\n宝书半摺山房寂，卧听娇莺说怨恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61700,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"邹必东竹枕","author":"释德洪","text":"黑甜谁欲当閒味，此枕令人稳称心。\n风骨子猷居处竹，典刑元亮醉时琴。\n宜笼雾鬓清圆语，听学朱弦发越音。\n不用制囊裁古锦，春寒长搭闹花衾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61701,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"竹炉","author":"释德洪","text":"博山沉水觉尘埃，旋斫凌云绿玉材。\n自拭锦绷含泪粉，要焚银叶返魂梅。\n意消未掩黄庭卷，火冷空馀白雪灰。\n应把熏衣闭深阁，流苏想见画屏开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61702,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"七月四日昼梦云庵和尚教诲久之而觉作此示超然","author":"释德洪","text":"夏窗午睡谁呼觉，院静惟闻绕砌泉。\n梦里绪言犹可记，壁间遗像尚依然。\n衬珠定使拳披见，坐榻当令膝处穿。\n塔在层峰衰眼力，何时同汝扫颓塼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61703,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"云庵塔有双桐作此寄因侄","author":"释德洪","text":"十年不扫先师塔，闻有双桐护石根。\n多宝佛应分半座，主林神对现前身。\n诗成坐对南州祖，写寄山中玉涧因。\n他日就阴当缚屋，岁时香火愿为邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61704,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中秋对月","author":"释德洪","text":"好天凉夕病衰馀，散步中庭瘦策扶。\n禅客相逢宿山寺，玉轮同看上云衢。\n十分归思悬江国，一半秋光入鬓须。\n草露湿衣香雾重，更将毛骨洗冰壶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61705,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"至上高谒李先甲会渊才德修","author":"释德洪","text":"先甲志大性重迟，是中可筑平生基。\n心期功名定不赦，未识所与游从谁。\n渊才人间汗血骥，德修天上麒麟儿。\n知君怀中有卿相，探手但未忙取之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61706,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵睿廓然送僧还东吴","author":"释德洪","text":"征夫应为指柴扉，湖水当门可濯衣。\n飞鸟已知今日倦，旧邻那悟昔人非。\n山情已作燖鸡净，世味真如嚼蜡微。\n遥想夜航无管束，棹歌应载月明归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61707,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送瑩上人游衡岳","author":"释德洪","text":"紫盖峰头楼阁生，朱灵洞口水云晴。\n盘空路作惊蛇去，落日人如冻蚁行。\n重郭老师今健否，藏年珍木但闻名。\n定应自扫岩边石，时发披云啸月声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61708,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄草堂上人","author":"释德洪","text":"首夏年芳尚可寻，兴来芒履恣登临。\n回头故国烟波阔，分袂幽人岁月深。\n落日杜鹃山馆静，薰风芳草柳塘阴。\n知君宴坐忘机地，谩寄新诗话此心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61709,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬潜上人","author":"释德洪","text":"满钩疏箔卷檐楹，秋静江天刮眼明。\n梵册已翻千偈妙，炉香未散一堂清。\n沾衣菊露情□□，□□松声梦不成。\n我与道人缘分熟，可能朝夕厌逢迎。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61710,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠为上人游方昭默之子也","author":"释德洪","text":"年少辞师作远游，人言虎穴不生彪。\n家声自古能名世，气宇如今已食牛。\n夺得我机方肯住，从教棒打不回头。\n云山万叠翛然去，江汉无风一叶舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61711,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"邓秀才就武举作诗美之","author":"释德洪","text":"丈夫气自磨牛斗，正似丰城狱屋刀。\n富贵岂终凭铁砚，功名先看掷霜毫。\n芦鞭未称迎风帽，紫绶从来赛绿袍。\n杖策军门君记取，祖宗汉室旧勋劳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61712,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"崇胜寺后竹千馀竿独一根秀出呼为竹尊者","author":"释德洪","text":"高节长身老不枯，平生风骨自清癯。\n爱君脩竹为尊者，却笑寒松作大夫。\n不见同行木上座，空馀听法石为徒。\n戏将秋色供斋钵，抹月披云得饱无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61713,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"童子名道员年五岁馀不茹荤随母往来禅林旦夕稍长即与落发觅诗作此授之","author":"释德洪","text":"气与秋容一倍清，出尘风骨自天成。\n逢僧论性人皆说，指佛高谈母亦惊。\n已觉君家钟善庆，从来我法付豪英。\n他年勘遍诸方老，古寺编蒲更道情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61714,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题水镜轩","author":"释德洪","text":"小轩明快照岩阿，得道幽人喜气多。\n但视世间如水镜，方知梦境有山河。\n佳眠不碍林光入，清坐何妨夜月过。\n我亦思归老丘壑，结邻西崦肯容么。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61715,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]