[{"title":"偈颂五十一首 其四十五","author":"释大观","text":"行不到处行一步，甜瓜彻蒂甜。\n说不到处说一句，苦瓠连根苦。\n扫尽从前闲佛祖，发机须是千钧弩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6205,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五十一首 其四十四","author":"释大观","text":"慈深愿广育圣明，首出万国之仪刑。\n寿崇功德无能名，妙高山色青又青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6206,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五十一首 其四十三","author":"释大观","text":"春雨如膏，春云如鹤。\n春草离离，春花灼灼。\n骑声盖色兮何太乖张，毫忽不形兮填沟塞壑。\n直往无前，犹欠一著。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6207,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五十一首 其四十二","author":"释大观","text":"九日无白醪，紫萸烹茗好。\n今古说登高，谁踏古皇道。\n落叶鼓真风，黄菊说玄要。\n自笑太无端，相牵入荒草。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6208,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五十一首 其四十一","author":"释大观","text":"霜风未老，爱景如春。\n空洞绝朕，弥满刹尘。\n今日明日，瞥喜瞥嗔，暗把风流卖与人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6209,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五十一首 其四十","author":"释大观","text":"众毛成毬，众水成流。\n众人成市，众土成丘。\n育王聚众作夏，今夏东州，明夏西州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6210,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五十一首 其三十九","author":"释大观","text":"淮云惨淡，淮水枯竭。\n径山老子无言说，喝得岩厓成百裂，末后全提太亲切。\n笑不彻，哭不彻，憍梵钵提惊吐舌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6211,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五十一首 其三十八","author":"释大观","text":"暗瓦霜凝寒客梦，晴窗日透借朝温。\n不能缄口围炉坐，敛袂空趋画戟门。\n堪悲堪笑不动尊，天津桥看弄胡孙。\n此意与谁论，长者子无裈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6212,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五十一首 其三十六","author":"释大观","text":"痴痴兀兀，乖乖厓厓。\n水乳和同，肝胆楚越。\n共倚阑干舒笑眼，四山松桂动秋风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6213,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五十一首 其三十五","author":"释大观","text":"三百馀会，尽是死句。\n娑罗树间，翻成活句。\n活中死，死中活，水绿山青，天宽地阔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6214,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五十一首 其三十四","author":"释大观","text":"闹浩浩，静悄悄。\n古策风高，玉壶春晓。\n左顾无瑕，右盼已老。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6215,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五十一首 其三十三","author":"释大观","text":"莲开陆地，海涌鳌山。\n不知今夕是何夕，山林城市约同看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6216,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五十一首 其三十二","author":"释大观","text":"不慕诸圣，不重己灵。\n櫜弓戢矢，坐享太平。\n德山有棒，正好束之高阁。\n临济有喝，也应无处施呈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6217,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五十一首 其三十一","author":"释大观","text":"生也如是，白骼树头鱼扇子。\n死也如是，泥牛饮乾东涧水。\n更待说偈，舜若多神三赤喙。\n讨甚巴鼻，丑恶重童无处洗。\n径山供尽死款，慈云也不相饶，从来生死不同条。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6218,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五十一首 其二十九","author":"释大观","text":"春风缓，春日暖。\n山鸟嘲啾，山花烂熳。\n达磨面壁九年，归宗拭坏双眼。\n诸人还会么，南山粲，白石烂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6219,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五十一首 其二十八","author":"释大观","text":"秋光杪暮，霜吹凄肃。\n无位真人，草眠露宿。\n慈云忍俊不禁，试为临风招之，式微式微胡不归。\n胡不归，一堂和气春熙熙。\n三条椽下堪自怡，东挨西倚终奚为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6220,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五十一首 其二十六","author":"释大观","text":"井梧叶叶响飕飗，搅动明河万里秋。\n楖?摩挲生远兴，白云流水共悠悠。\n不是寒山子，谁临古渡头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6221,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五十一首 其二十五","author":"释大观","text":"久晴还雨，禾山解打鼓。\n久雨还晴，普化爱摇铃。\n钱是足陌，物是定价，赵州直得五年分疏不下。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6222,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五十一首 其二十四","author":"释大观","text":"圆觉伽蓝，牛头北马头南。\n平等性智，七十三八十四。\n咬定牙关，四棱蹋地。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6223,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五十一首 其二十三","author":"释大观","text":"宽廓非外，寂寥非内。\n拽转虚空，须弥粉碎。\n土宿颔下髭须长，波斯眼深鼻孔大。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6224,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五十一首 其二十二","author":"释大观","text":"日复日，夜复夜。\n窦八布衫穿，虚空生柄把。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6225,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五十一首 其二十一","author":"释大观","text":"取不得舍不得，不可得中只么得。\n万籁收声兮万象自闲，秋水吞空兮秋天一色。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6226,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五十一首 其十七","author":"释大观","text":"凌霄跨灶，凌灭吾宗。\n危分险布，铁网千重。\n三更白如昼，掇转太虚空。\n幻智庵前觅不得，萧萧松竹引清风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6227,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五十一首 其十六","author":"释大观","text":"碍塞处，有通疏。\n看不足，绰有馀。\n千古华山山下路，输他潘阆倒骑驴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6228,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五十一首 其十五","author":"释大观","text":"终日忙忙，秀支替戾刚。\n那事无妨，仆谷劬秃当。\n不动智佛，长时七出八没。\n憍梵钵提，对人倒腹倾肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6229,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五十一首 其十三","author":"释大观","text":"世尊不说说，正月孟春犹寒。\n迦叶不闻闻，二月仲春渐暄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6230,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五十一首 其九","author":"释大观","text":"三世诸佛不知有，覆水难收。\n狸奴白牯却知有，头上安头。\n白日西沈，黄河北流。\n推倒门前案山子，从教坐地看扬州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6231,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五十一首 其八","author":"释大观","text":"作者相逢，一西一东。\n断碑刊白字，当道种青松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6232,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五十一首 其四十一","author":"释大观","text":"教戴天履地，击壤鼓腹兮不知天地之宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6233,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五十一首 其七","author":"释大观","text":"不动本位，瑞应人间。\n冠群灵而首出，摄大千于毫端。\n万汇熙熙兮春台之乐，万邦纳纳兮磐石之安。\n从教戴天履地，击壤鼓腹兮不知天地之宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6234,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五十一首 其六","author":"释大观","text":"十二月十五，石人相耳语。\n梅开寒谷春，雪滴晴檐雨。\n太分明，何所睹，南泉不打盐官鼓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6235,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五十一首 其五","author":"释大观","text":"开口失，闭口丧。\n脱白露净，矢在弦上。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6236,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五十一首 其四","author":"释大观","text":"觅之不得，不觅奚彰。\n戳瞎顶门，炜炜煌煌。\n桑畴雨过罗纨腻，麦垄风来饼饵香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6237,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五十一首 其三","author":"释大观","text":"空手把锄头，男命怕罗睺。\n步行骑水牛，石虎生肉彪。\n人从桥上过，桥流水不流。\n羲和鞭白日，少昊行清秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6238,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五十一首 其一","author":"释大观","text":"真不立，妄本空。\n七凹八凸，四辟六通。\n松声杂雨山长静，春色带寒花自红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6239,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晦机","author":"释大观","text":"舌上雷轰一默间，纤尘不动鼓波澜。\n拈花会上人无数，输与头陀一破颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6240,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梨洲戒长老请赞","author":"释大观","text":"相牵相引，自拈自弄。\n赚正因人，变灭胡种。\n业在其中不自知，九成韶集丹山凤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6241,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"维摩赞","author":"释大观","text":"环堵室，十笏地。\n咄哉维摩，病在者里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6242,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寒山扫地赞","author":"释大观","text":"横也扫，竖也扫。\n七佛之师，狼藉不少。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6243,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寒谷晖法师赞","author":"释大观","text":"祖庭力探，义天横截。\n南湖雨华，屡踞前列。\n鼎峙三观兮于菟元斑，区分一乘兮尾闾自泄。\n海阔山遥，难追轨辙。\n云暖谁寻寒谷春，晴宵又耿长空月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6244,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渡芦达磨赞","author":"释大观","text":"南头问，不善答。\n北头去，不相合。\n自谓踏得著，全然没交涉。\n无枝叶处，枝叶纵横。\n无风波处，风波匼匝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6245,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"越王感应大士赞","author":"释大观","text":"海山崭绝，海涛舂撞。\n海风披拂，海云飘扬。\n仰慧日之破暗兮谁其迷照，观普门之不钥兮去不至方。\n感应道交，叵测叵量。\n越国投诚，菩提影现。\n我作是说，增金以黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6246,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"道者复干接待","author":"释大观","text":"旋营屋子嵌云山，旧日灵泉气象还。\n但有过门教歇去，谁云道者少机关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6247,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"集福鉴长老请赞","author":"释大观","text":"雷轰电驰，寸毫尺釐。\n全机大用，放下竹篦。\n突出云门顾鉴，咦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6248,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"溢首座请赞","author":"释大观","text":"■■??，颙颙昂昂。\n强出人前，果见乖张。\n直如劈竹而人罕知其曲，圆如走丸而吾常用其方。\n闻说我宗甚奇特，当甚多年苕帚桩。\n明修栈道，暗渡陈仓。\n出语全无碑记，考贼不用證赃。\n敢滥称花木瓜直下儿孙，真所谓米尽到糠。\n个样嘴脸非惟人恶，吾亦自恶，那堪形之丹青，悬之高堂。\n第一分付断云，付与丙丁收藏。\n覆水自来收不得，从教四海沸如汤。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6249,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"照讲师赞","author":"释大观","text":"口哆眉厖，坐如钉桩。\n戒香逆风，孤行凌霜。\n一新受经重其本，三主法社持其纲。\n此其所以发毫端毗尼藏，而树末世精进幢者也。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6250,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颐蒙法师赞","author":"释大观","text":"癯然容仪，轩然作为。\n古潜清苕，珠媚蟾辉。\n筌忘大部兮半点不胶名相，冥通三观兮一毫不著玄微。\n石涧付衣，末流蓍龟。\n山雷山泉兮从教名?，虚空解讲兮其谁知之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6251,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"樊路分为母陈安人请赞","author":"释大观","text":"母仪慈淑，阃范持循。\n善行冰雪，寿骨松椿。\n雍容堂上兮凤霞俨俨，罗列堂下兮兰玉诜诜。\n厚德阴储兮留乎奕叶，和气辑睦兮浃乎乡邻。\n媲城东之作家兮付佛身于等幻，秉月上之迅机兮应日用而常亲。\n若问其中转身处，虚空揣出妙无痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6252,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题觉心居士转物轩","author":"释大观","text":"两沼滟寒碧，一堂纳宽閒。\n高柳逢春新翠展，寒梅霁雪清香繁。\n好本栽培常烂熳，四序芳馨看互换。\n杂华境遍刹尘中，十波罗蜜更主伴。\n觉心隐几随彷徉，六用俱妙无可降。\n跏趺不语亦不默，篆烟一缕春昼长。\n释迦老子何所见，教谭三百皆方便。\n就中一处最亲切，转物不为物所转。\n此堂物物元无殊，随人受用有亲疏。\n尘尘摄入大毗卢，应笑本来物无转亦无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6253,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五十一首 其二十七","author":"释大观","text":"一见便见，临崖浒眼。\n一得永得，坐井观天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6254,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五十一首 其二十","author":"释大观","text":"孤危不立，坐断千差。\n有笑陪宾，无赃验贼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6255,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五十一首 其十九","author":"释大观","text":"峰峦秀异，鹤不停机。\n灵木迢然，凤无依倚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6256,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五十一首 其十八","author":"释大观","text":"平常是道，不涉平常。\n颠来倒去，规圆矩方。\n林花著雨胭脂落，水荇牵风翠带长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6257,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"别石坚","author":"释大眼","text":"心如一片苗，是苗皆可植。\n莫种谁堆培，莫容荆与棘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6258,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"释子文","text":"不昧不落作么会，会得依前堕野狐。\n一夜凉风生画角，满船明月泛江湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6259,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"释子兰","text":"本是无情物，南飞又北飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6260,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"释子耶","text":"松欺腊雪千年古，竹扫溪风六月寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6261,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二首 其二","author":"释子涓","text":"乍雨乍晴山里寺，或来或去洞中云。\n满天星月明如昼，此境此时谁欲分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6262,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈三首 其三","author":"释子涓","text":"伴我行千里，携君过万山。\n未明心地印，难透祖师关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6263,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二首 其一","author":"释子涓","text":"狗子佛性无，门上钉桃符。\n邪魔并百怪，一见便消除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6264,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈三首 其二","author":"释子涓","text":"见见之时，见非是见。\n见犹离见，见不能及。\n鲸吞海水尽，露出珊瑚枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6265,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈三首 其一","author":"释子涓","text":"一二三四五六七，七六五四三二一。\n循环逆顺数将来，数到未来无尽日。\n因七见一，见一亡七。\n踏破太虚空，铁牛也汗出。\n绝气息，无踪迹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6266,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"化夏供","author":"释子益","text":"兴化年来彻骨贫，口生白醭面生尘。\n不知那个无思算，来饱无心闲道人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6267,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"对月赞","author":"释子益","text":"黑豆忙忙数，教休不肯休。\n幸然明似镜，何用曲如钩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6268,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"全上人之仰山","author":"释子益","text":"集云峰下四藤条，千载谁知恨未销。\n去去全身担荷得，石龙依旧碧岧峣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6269,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"灵照女赞","author":"释子益","text":"家业尽抛离，沿街卖笊篱。\n胸中无限意，不许老庞知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6270,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"拾得携苕帚赞","author":"释子益","text":"往来双涧路，脚下起尘埃。\n苕帚忙忙扫，何曾扫得来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6271,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"祖典座往南岳","author":"释子益","text":"寂寞相从恰四年，不曾谈著祖师禅。\n杖藜七十二峰去，点破潇湘水底天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6272,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"钦禅人之天童","author":"释子益","text":"兴化三门开两边，聚头噇饭不谈禅。\n天童有问其中事，收割今年胜去年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6273,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"祥侍者化供","author":"释子益","text":"祥禅为众下山来，七十高僧笑满腮。\n袖里金锤曾未动，千门万户一时开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6274,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十一首 其九","author":"释子益","text":"拨草瞻风寻剑客，桃花一见便忻然。\n直饶真到不疑地，放下更参三十年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6275,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十一首 其七","author":"释子益","text":"不是风兮不是幡，活人只在笑谈间。\n面前坦坦平平路，背后重重叠叠山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6276,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十一首 其四","author":"释子益","text":"钝如出匣吹毛剑，快似坚刚百炼锤。\n直下低头礼三拜，得便宜处落便宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6277,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]