[{"title":"宫词 其三十八","author":"宋白","text":"天子今朝就食迟，延英徵得逸人归。\n灵台监里知嘉瑞，隔月先曾奏少微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46358,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其三十四","author":"宋白","text":"御府书踪字字奇，散教宫女仿来时。\n研精笔法难停稳，并恨羲之与献之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46359,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其八十三","author":"宋白","text":"骊山讲武六师回，日月旗高过苑来。\n鞭入夹城箫鼓动，材林轻骑闹如雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46360,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其九十二","author":"宋白","text":"秋天如水月如霜，玉笛风清曲破长。\n众乐任高声迥别，六宫齐道是君王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46361,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其四十","author":"宋白","text":"白莲亭下柳垂丝，正是春波涮马时。\n宫女隔花相倚看，如龙步骤出涟漪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46362,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其八十一","author":"宋白","text":"殿角风琴细韵移，烛台春幸翰林时。\n三更向尽诸宫闭，犹在金銮夜赋诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46363,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其十","author":"宋白","text":"龙脑天香撒地衣，锦书新册太真妃。\n宫官一夜铺黄道，却踏金莲步步归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46364,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其二十","author":"宋白","text":"天玉风清北内闻，东朝相庆册储君。\n春坊晓奏元良瑞，鸡戟门西现彩云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46365,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其八十九","author":"宋白","text":"节假君王不坐朝，斗残芳草日难销。\n樗蒲长幸皆宫戏，输与昭容玉步摇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46366,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其三十三","author":"宋白","text":"萧萧宫树正秋风，虎圈门开辇路通。\n金屋阿娇心胆小，却嗔冯媛独当熊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46367,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其二十五","author":"宋白","text":"砌台春暖映垂杨，皇子皇孙戏艳阳。\n半騃半骄花里闹，真珠线断紫罗囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46368,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其十六","author":"宋白","text":"春雪轻轻洒露盘，真珠箔外玉勾栏。\n仙妃未起宫娃小，错报西楼晓月寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46369,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其八十四","author":"宋白","text":"虫响金阶捣练天，玉狻呀口喷香烟。\n来宵待赏中秋月，剩取珊瑚饤御筵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46370,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其七十八","author":"宋白","text":"寒食宫中也禁烟，郁金堂北画鞦韆。\n梨花明月皆如雪，时送清香到酒前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46371,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其九十六","author":"宋白","text":"南内天花照从官，上皇春醉圣情欢。\n月中閒说骊山事，笑向将军道阿瞒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46372,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其三十六","author":"宋白","text":"骠国朝天进乐时，宫商依约似龟兹。\n教坊风便伶官俊，全曲偷将并不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46373,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其一○○","author":"宋白","text":"春营小殿号披香，宣借天孙作学堂。\n李白宫词多好句，侧书红壁两三行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46374,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其八十五","author":"宋白","text":"月殿闻随羽客过，桂宫门外近天河。\n常娥装束还何似，潜问君王记得么。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46375,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其九十一","author":"宋白","text":"虢国威仪过薛王，担夫争路气扬扬。\n宫嫔后出香车送，飐碎钗头玉凤凰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46376,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其九十五","author":"宋白","text":"五岳无尘四海清，太平天子爱长生。\n蓬莱方士壶中宿，旋种仙芝一夜成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46377,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其十三","author":"宋白","text":"绣鞍新辔饰玫瑰，随驾堤边试马回。\n苑蕙香轻沙路湿，玉蹄沾得落花来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46378,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其六十五","author":"宋白","text":"水心高殿接兰塘，才拂龙须一簟凉。\n瑟瑟枕函云母帐，冰盘仙果近人香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46379,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其八十七","author":"宋白","text":"重阳菊蕊泛香醪，上寿因添饮兴高。\n玉项琵琶犹未快，别宣金凤紫檀槽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46380,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其二","author":"宋白","text":"万国车书一太平，宫花无数管弦声。\n近臣入奏新祥瑞，昨夜黄河彻底清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46381,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春","author":"宋白","text":"隔岸黄鹂语，当轩白鸟斜。\n晚来风紧处，飞絮满人家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46382,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"普贤寺","author":"宋白","text":"菩萨悲深居此地，峨眉名重镇南州。\n不知立处高多少，只见星辰在下头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46383,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠麻仲英","author":"宋白","text":"宣毫歙墨川笺纸，寄与麻家小秀才。\n七岁能吟天骨异，前生应折桂枝来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46384,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"一春","author":"宋白","text":"一春情调淡悠悠，閒倚书窗背小楼。\n暖日只添中酒睡，晚风频动惜花愁。\n莺冲舞蝶侵人过，絮逐天丝触处游。\n已为韶光发惆怅，可堪家近白蘋洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46385,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中酒","author":"宋白","text":"中酒事俱妨，偷眠就黑房。\n静嫌鹦鹉闹，渴忆荔枝香。\n病与慵相续，心和梦尚狂。\n从今改题品，不号醉为乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46386,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"云","author":"宋白","text":"化作奇形随物态，散成文锦自天机。\n红堆远峤日初上，碧满长空人未归。\n逸兴狂来连海阔，高情间甚出山飞。\n须知深处藏雷雨，不独江边绕钓矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46387,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"牡丹诗十首 其十","author":"宋白","text":"许多颜色泥春娇，就里轻红最□饶。\n生处地须名紫府，落时魂想返青霄。\n霞英散焰烧纤手，药粉飘香著步摇。\n轻剪自怜支节痛，倚烟啼露一无憀。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46388,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"牡丹诗十首 其八","author":"宋白","text":"水精冠叶镂春冰，巧思镌研仿未能。\n风砑红绡光点血，暖销金镂细含棱。\n韶容旖旎终无比，晚艳低佪更可憎。\n戏脱仙衣亲手覆，香身柔软力难胜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46389,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"牡丹诗十首 其七","author":"宋白","text":"风排香阵拂瑶墀，御苑新晴烂漫时。\n十五素娥羞水色，三千红面洗胭脂。\n宫腰映酒思轻舞，檀口偎笺欲咏诗。\n铁石心肠为君变，多情多恨一枝枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46390,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"牡丹诗十首 其六","author":"宋白","text":"锦为行障绣为衾，不杀猩猩色已深。\n花谱扬名居一品，药栏才见赏千金。\n谁忘正为褰珠箔，得意惟能挑玉琴。\n洛水桥南三月里，两无言语各知心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46391,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"牡丹诗十首 其五","author":"宋白","text":"澹黄容止间深檀，妥媠香红露未乾。\n和泪似嫌春渐老，向人如说夜来寒。\n妆成有样教天媛，礼绝无心下国兰。\n针绣笔描俱未是，好风相倚笑边鸾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46392,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"牡丹诗十首 其四","author":"宋白","text":"烟容粉态傍歌楼，半似窥人半似羞。\n把笔乍题先巧笑，凭栏微唤不回头。\n吹乾玉笛香犹在，槌破灵鼍爱未休。\n更得黄鹂将粉蝶，东西南北说风流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46393,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"牡丹诗十首 其三","author":"宋白","text":"春心相惜最相亲，湘叶匆匆换翠裙。\n双蒂喜如嫔二女，一枝愁似寡文君。\n艳繁谁卷真珠看，香好曾歌琥珀闻。\n深染鲛绡笼玉槛，莫教飞去作卿云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46394,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"花","author":"宋白","text":"谁将枝叶染还裁，却使馨香次第来。\n春柄定教三月主，天心合与一齐开。\n如何零露方滋菊，岂得东风不为梅。\n低蹙艳容愁似语，也疑由命不由才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46395,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送陈尧叟赴广西漕","author":"宋白","text":"莫辞征骑去迢迢，尽泻纯诚许圣朝。\n北阙皇恩从此布，南方沴气必然销。\n为诗自可怡情性，服药尝闻助摄调。\n仙馆粉闱官职好，定期骞翥上烟霄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46396,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"黄陵二妃庙","author":"宋白","text":"重瞳天子狩南荒，二女音容已渺茫。\n静听瑶琴当皓月，再闻珠泪洒幽篁。\n松愁老鹤清无梦，水映疏萤冷放光。\n一夜辽辽千古意，香魂依约绕潇湘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46397,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"狂吟八韵送英公暂归故乡迁殡二亲","author":"宋白","text":"十八般书四海传，长安话别已多年。\n今来帝里重相见，转觉师心更自然。\n下笔入神皆得法，出言成句尽通玄。\n花时乘兴先行乐，月夜忘机静坐禅。\n到处僧俗争识面，满朝英俊赠佳篇。\n长沙母葬彰纯孝，八水人思有善缘。\n衡岳醉投秋雨寺，汉江吟渡夕阳船。\n前期指在春三月，回首东风好著鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46398,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七夕","author":"宋白","text":"纤吹浮云荐，非因散巧楼。\n灵俦不可觌，仙溪泛悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46399,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"牡丹诗十首 其九","author":"宋白","text":"春风平地谪花仙，红袅生香下九天。\n艳欲背身垂玉箸，动如移步索金莲。\n含情待去为云雨，忍笑佯来听管弦。\n胧月轻寒应不惯，夜深浑拟傍丛眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46400,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"牡丹诗十首 其二","author":"宋白","text":"日华鲜丽露华浓，梳流香朝竞□容。\n来在梦中甘化蝶，入伊心里不如蜂。\n宫娥捧拥西施醉，天乐喧阗虢国风。\n高拗浮□须继烛，玳簪分载酒千钟。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46401,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"牡丹诗十首 其一","author":"宋白","text":"□应春处即□春，粉面□相□番新。\n语得必传天上事，摘来真是掌中身。\n百花推戴教为主，□日妖□欲□人。\n无可奈何□爱惜，少偷金蕊咽芳津。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46402,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其三","author":"宋白","text":"律管飞灰报早春，寿阳梅淡落香裀。\n词人竞进新诗入，俊思无过白舍人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46403,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其八十二","author":"宋白","text":"幕次春排晓御楼，千官贺雨拜珠旒。\n斜阳却幸鸳鸯殿，袍裤宫人尽筑毬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46404,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其五","author":"宋白","text":"彤廷立仗雪初销，仙乐空悬宴百寮。\n齐指终南称万寿，远平香案碧岧峣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46405,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其二十三","author":"宋白","text":"贪领吴娃唱鹧鸪，洞箫词赋顿生疏。\n沉吟不记当时字，却向宫中问婕妤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46406,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其四十六","author":"宋白","text":"雪鹘轻笼好六梢，五方供进内家调。\n灵和殿上乘风飏，一点秋星印碧霄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46407,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其八十六","author":"宋白","text":"便路横穿玉兔门，夜宣狎客宴金樽。\n江郎才俊思华别，赐坐从容索绣墩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46408,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄蔡昆","author":"宋白","text":"却忆醉相逢，云深太白东。\n离别经腊雪，魂梦又春风。\n芳草晴天阔，黄鹂细雨中。\n倚筇愁望处，烟树远濛笼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46409,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"惜别诗","author":"宋白","text":"年来又惜别清尘，故国荣过喜风新。\n竹叶莫辞千日酒，梅花惟寄一枝春。\n苦心曾未抛黄卷，得路终期近紫宸。\n不待政成迎风诏，颂声洋溢桂州人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46410,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"嘉州","author":"宋白","text":"嘉阳信美郡，风物眷多奇。\n有湖题明月，有楼名荔枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46411,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题义门胡氏华林书院","author":"宋白","text":"君家仙馆带村塘，气象清鲜雅趣长。\n千里客来如海纳，一楼书静透山光。\n门闾旌表芝泥贵，科篇联翩桂籍香。\n帝里词人多景慕，谩题诗句满修篁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46412,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其三","author":"宋白","text":"宋朝归圣主，潘阆是诗人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46413,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其十二","author":"宋白","text":"回眸已觉三山近，满壁潜惊五月寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46414,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其四","author":"宋白","text":"凌晨走退虾蟆鼻，几日飞经滟滪堆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46415,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其十一","author":"宋白","text":"道出嘉阳正西指，一带灵峰如涌起。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46416,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"宋白","text":"吉音来碧落，帖子报红笺。\n清夜惊神王，胧明到省前。\n风中宫漏尽，日出榜绳悬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46417,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"宋白","text":"劳君赠我古风诗，逋翁所谓扑凸奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46418,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其六","author":"宋白","text":"竹底衙人吏，花间押簿书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46419,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其七","author":"宋白","text":"峨眉多雨雅江秋，溢岸清波入郡流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46420,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其八","author":"宋白","text":"最念春风尝酒处，梅酸笋翠后溪头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46421,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其五","author":"宋白","text":"春风麦陇连蛮芊，细雨梨花问海棠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46422,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其九","author":"宋白","text":"玉津县里三年闷，金粟山前九月愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46423,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其十三","author":"宋白","text":"昔日曾为尺木阶，今朝真是青云友。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46424,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其十","author":"宋白","text":"梅雪初销腊酒香，嘉州属县且寻芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46425,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丑奴儿/采桑子 其三","author":"宋先生","text":"夜来子后披衣坐，心定神清。\n见个真人。\n脸似胭脂体似银。\n炉中火焰炎炎起，紫气腾腾。\n一粒丹成。\n管取飞升上帝京。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46426,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丑奴儿/采桑子 其二","author":"宋先生","text":"因师传说朝元理，昼夜功勤。\n炼煅成真。\n偷得阴阳共半斤。\n壶中天地何曾夜，四季长春。\n洞里光阴。\n交我如何与世论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46427,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丑奴儿/采桑子 其一","author":"宋先生","text":"河车怎敢停留住，搬入泥丸。\n水火烹煎。\n一粒丹砂炼汞铅。\n金丹大药人人有，只要心坚。\n休说闲言。\n不走阳精便是仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46428,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丑奴儿/采桑子","author":"宋先生","text":"真人本是凡人做，悟者何难。\n名利如山。\n隔断神仙路往还。\n谢师指教生死限，长在心间。\n长在心间。\n十二时中不暂闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46429,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丑奴儿/采桑子","author":"宋先生","text":"金公本是乾家子，住在坤宫。\n真虎真龙。\n吃尽三尸及九虫。\n丹砂锻炼泥丸里，赫赫长红。\n一日成功。\n直见三清太上公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46430,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"太常引","author":"宋先生","text":"金丹只在自身中。\n真水火、炼成功。\n因遇吕仙公。\n识返本、还元祖宗。\n阳全阴尽，神光现处，认得自真容。\n名姓列仙宫。\n已跳出、乾坤世笼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46431,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"阮郎归","author":"宋先生","text":"一轮明月照三峰。\n彩霞飞满空。\n分明见我主人公。\n明珠透上宫。\n丹药炼，鼎中红。\n频频要用功。\n功成定是出樊笼。\n闲游仙洞中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46432,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]