[{"title":"浮生吟","author":"邵雍","text":"浮生晓露边，且喜又添年。\n动悔须有悔，求全未必全。\n处人心上事，道物性中言。\n寰宇虽然广，其谁曰不然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3882,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"疾革吟","author":"邵雍","text":"有命更危亦不死，无命极医亦无效。\n唯将以命听于天，此外谁能闲计较。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3883,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病中吟","author":"邵雍","text":"尧夫三月病，忧损洛阳人。\n非止交朋意，都如骨肉亲。\n荐医心恳切，求药意慇勤。\n安得如前日，登门谢此恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3884,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病浅吟","author":"邵雍","text":"病浅之时人不疑，病深之后药难医。\n劳谦所以有终吉，迷复何尝无大亏。\n物我中间难著发，天人相去岂容丝。\n能知古乐犹今乐，省了譊譊多少辞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3885,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病起吟","author":"邵雍","text":"病作因循一月前，岂期为苦稍淹延。\n朝昏饮食是难进，躯体虚羸不可言。\n既劝佳宾持酒盏，更将大笔写诗篇。\n始知心者气之帅，心快沉痾自释然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3886,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病酒吟","author":"邵雍","text":"年年当此际，酒病掩柴扉。\n早是人多感，那堪春又归。\n花残蝴蝶乱，昼永子规啼。\n安得如前日，和风初扇微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3887,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"破釜","author":"邵雍","text":"有一破釜多故旧，掉向空房不照顾。\n上面?土尘埃生，两璺到耳连底透。\n叫得将来锢露人，拈得与他交觑部。\n羊皮鞴袋扇风急，旋去炉上炼金汗。\n烹向破釜窍眼中，锢露骨还如旧日。\n釜有□□人有病，人病还同斧有紊。\n破釜锢露上依然，人□□□枉丧命。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3888,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"笔兴吟","author":"邵雍","text":"窗晴气和暖，酒美手柔软。\n兴逸情撩乱，笔落春花烂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3889,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"罢吟吟","author":"邵雍","text":"久欲罢吟诗，还惊意忽奇。\n坐中知物体，言外到天机。\n得句不胜易，成篇岂忍遗。\n安知千万载，后世无宣尼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3890,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"能怀天下心","author":"邵雍","text":"能怀天下心，肯了人间事。\n岂止求于今，求古亦未易。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3891,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"莫如吟 其三","author":"邵雍","text":"君臣守以义，父子守以仁。\n义失为敌国，仁失为路人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3892,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"莫如吟 其二","author":"邵雍","text":"仁莫如父子，义莫如君臣。\n二者尚有失，自馀恶足论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3893,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读古诗","author":"邵雍","text":"闲读古人诗，因看古人意。\n古今时虽殊，其意固无异。\n喜怒与哀乐，贫贱与富贵。\n惜哉情何物，使人能如是。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3894,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读陶渊明归去来","author":"邵雍","text":"归去来兮任我真，事虽成往意能新。\n何尝不遇如斯世，其那难逢似此人。\n近暮特嗟时翳翳，向荣还喜木欣欣。\n可怜六百馀年外，复有闲人继后尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3895,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谈诗吟","author":"邵雍","text":"诗者人之志，非诗志莫传。\n人和心尽见，天与意相连。\n论物生新句，评文起雅言。\n兴来如宿构，未始用雕镌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3896,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赁屋吟","author":"邵雍","text":"屋新人喜居，屋弊人思去。\n主若善修完，何时不能住。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3897,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"酒少吟","author":"邵雍","text":"此物近来贫，时时得数斤。\n如茶辜老朽，似药负交亲。\n未饮先忧尽，虽斟不敢频。\n何由同九日，长有白衣人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3898,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高竹八首 其八","author":"邵雍","text":"高竹逾冬青，四月方易叶。\n抽萌如止戈，解箨若脱甲。\n脩静信可爱，绕行不知匝。\n嗟哉凡草木，徒自费锄锸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3899,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高竹八首 其七","author":"邵雍","text":"高竹数十尺，仍在高花上。\n柴门昼不开，青碧日相向。\n非止身休逸，是亦心夷旷。\n能知闲之乐，自可敌卿相。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3900,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高竹八首 其六","author":"邵雍","text":"高竹杂高梧，还惊秋节初。\n晚凉尤可喜，旧帙亦宜舒。\n池阁轻风里，园林晚景馀。\n人生有此乐，何必较锱铢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3901,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高竹八首 其五","author":"邵雍","text":"高竹如碧幢，翠柳若低盖。\n幽人有轩榻，日夜与之对。\n宇静觉神开，景闲喜真会。\n与其丧吾真，孰若从吾爱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3902,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高竹八首 其三","author":"邵雍","text":"高竹已可爱，况在垂杨下。\n幽人无轩冕，得此自可诧。\n枉尺既不能，括囊又何谢。\n贾生若知此，恸哭亦自罢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3903,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高竹八首 其二","author":"邵雍","text":"高竹临清沟，轩小亦且幽。\n光阴虽属夏，风露已惊秋。\n月色林间出，泉声砌下流。\n谁知此夜情，邈矣不能收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3904,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高竹八首 其一","author":"邵雍","text":"高竹百馀挺，固知为予生。\n忽忽有所得，时时闲绕行。\n自信或未至，自知或未明。\n窃比于古人，不能无愧情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3905,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乾坤吟","author":"邵雍","text":"用九见群龙，首能出庶物。\n用六利永贞，因乾以为利。\n四象以九成，遂为三十六。\n四象以六成，遂成二十四。\n如何九与六，能尽人间事。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3906,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乾坤吟二首 其二","author":"邵雍","text":"道不远于人，乾坤只在身。\n谁能天地外，别去觅乾坤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3907,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偶书 其一","author":"邵雍","text":"美食无使餍，餍则不能受。\n善人无使倦，倦则不能久。\n官小拜人喜，官高拜人耻。\n官职自外来，中心何若此。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3908,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偶见吟 其二","author":"邵雍","text":"世人多附炎，炎歇人自去。\n君子善处约，约久情自固。\n炎歇势不回，情固人不去。\n路人或如亲，亲人却如路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3909,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偶见吟 其一","author":"邵雍","text":"富贵多傲人，人情有时移。\n道德不傲人，人情久益归。\n道德有常理，富贵无定期。\n蒿莱霜至萎，松柏雪更滋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3910,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偶见吟 其三","author":"邵雍","text":"心迹贵相亲，相亲善恶分。\n世间须有物，天下岂无人。\n既见薰莸臭，当思玉石焚。\n如何得时态，长似洛阳春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3911,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偶得吟","author":"邵雍","text":"日为万象精，人为万物灵。\n万象与万物，由天然后生。\n言由人而信，月由日而明。\n由人与由日，何尝不太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3912,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偶得吟","author":"邵雍","text":"林间无事可装怀，昼睡功劳酒一杯。\n残梦不能全省记，半随风雨过东街。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3913,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偶得吟","author":"邵雍","text":"相去一毛间，千山复万山。\n虽能忘寝食，未肯去机关。\n不是责人备，奈何开口难。\n天心况非远，既远遂无还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3914,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偶得吟","author":"邵雍","text":"壮岁苦奔驰，随分受官职。\n所得唯锱铢，所丧无纪极。\n今日度一朝，明日过一夕。\n不免如路人，区区被劳役。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3915,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偶得吟","author":"邵雍","text":"集大成人不肯模，却行何异弃金车。\n便言天下无难事，岂信人间有丈夫。\n天意顺时为善计，人情安处是良图。\n天人之际只些子，过此还同隔五湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3916,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偶得吟","author":"邵雍","text":"蛙蜢泥中走，凤凰云外飞。\n云泥相去远，自是难相知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3917,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"唯天有二气","author":"邵雍","text":"唯天有二气，一阴而一阳。\n阴毒产蛇蝎，阳和生鸾凰。\n安得蛇蝎死，不为人之殃。\n安得凤凰生，长为国之祥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3918,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宿华清宫","author":"邵雍","text":"天宝初六载，作宫于温泉。\n明皇与妃子，自此岁幸焉。\n紫阁清风里，崇峦皓月前。\n奈何双石瓮，香溜尚涓涓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3919,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宿延秋庄","author":"邵雍","text":"驱车入洛川，下马弄飞泉。\n乍有云山乐，殊无朝市喧。\n非唯快心志，自可忘形言。\n借问尘中友，谁为得手先。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3920,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄三城旧友卫比部二绝 其一","author":"邵雍","text":"虽老未龙钟，篱边菊满丛。\n乍凉天气好，里闬正过从。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3921,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄杨轩","author":"邵雍","text":"淇水清且泚，泉源发吾地。\n流到君家时，尽是思君意。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3922,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄陕守祖择之舍人","author":"邵雍","text":"记得相逢否，当时在海东。\n别离千里外，倏忽十年中。\n迹异名尤异，心同齿更同。\n终期再清会，文酒乐无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3923,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄商守宋郎中","author":"邵雍","text":"初返洛城无限事，闲人体分似相违。\n如今一向觉优逸，却类商颜啸傲时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3924,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄曹州李审言龙图","author":"邵雍","text":"向日所云是，如今却是非。\n安知今日是，不起后来疑。\n向日所云我，如今却是伊。\n不知今日我，又是后来谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3925,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄谢三城太守韩子华舍人","author":"邵雍","text":"洛阳自为都，二千有馀年。\n举步图籍中，开目今古间。\n西北岌宫殿，东南倾山川。\n照人伊洛清，迎门嵩少寒。\n水竹最佳处，履道之南偏。\n下有幽人室，一径通柴关。\n蓬蒿隐其居，藜藿品其餐。\n上亲下妻子，厚薄随其缘。\n人虽不堪忧，己亦不改安。\n阅史悟兴亡，探经得根源。\n有客谓予曰，子独不通权。\n清朝能用才，圣主正求贤。\n道德与仁义，不徒为空言。\n功业贵及时，何不求美官。\n上食天子禄，下拯苍生残。\n通衢张大第，负郭广良田。\n朱门烂金紫，青楼繁管弦。\n外厩列肥骏，后庭罗纤妍。\n入则坐虚堂，出则乘华轩。\n冠剑何烨烨，气体自舒闲。\n高谈天下事，广坐生晴烟。\n人莫敢仰视，屏息候其颜。\n此所谓男子，志可得而观。\n又何必自苦，形容若枯鳣。\n道古人行事，拾前世遗编。\n而临水一沟，而爱竹数竿。\n此所谓匹夫，节何足而攀。\n予敢对客曰，事有难其诠。\n身非好敝缊，口非恶珍膻。\n岂不知系匏，而固辞执鞭。\n盖惧观朵颐，敢忘贲丘园。\n深极有层波，峻极有层巅。\n履之若平地，此非人所艰。\n贫贱人所苦，富贵人所迁。\n处之若无事，此诚人所难。\n进行己之道，退养己之全。\n既未之易地，胡为乎不坚。\n敢谓客之说，曾无所取焉。\n猗嗟乎玉兮，产之于荆山。\n和氏虽云知，楚国未为然。\n污隆道屈伸，进退时后先。\n苟不循此理，玉毁谁之愆。\n道之未行兮，其命也在天。\n近日游三城，薄言尚盘桓。\n当世之名卿，加等为之延。\n或清夜论道，或后池漾船。\n数夕文酒会，有无涯之欢。\n十月初寒外，万叶清霜前。\n归来到环堵，竹窗晴醉眠。\n仰谢君子知，代书成此篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3926,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"得一吟","author":"邵雍","text":"天自得一天无既，我一自天而后至。\n唯天与一无两般，我亦何尝与天异。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3927,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"惜芳菲","author":"邵雍","text":"细算人间千万事，皆输花底共开颜。\n芳菲大率一春内，烂漫都无十日间。\n亦恐忧愁为龃龉，更防风雨作艰难。\n莫教此后成遗恨，把火樽前尚可攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3928,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"探春吟","author":"邵雍","text":"草色依稀绿，花稍隐约红。\n一般难道说，如醉在心中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3929,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"接花吟","author":"邵雍","text":"物为万民生，人为万物灵。\n人非物不活，物待人而兴。\n男女天所生，夫妻人所成。\n天人相与外，率是皆虚名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3930,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"推诚吟","author":"邵雍","text":"天虽不语人能语，心可欺时天可欺。\n天人相去不相远，只在人心人不知。\n人心先天天弗违，人身后天奉天时。\n身心相去不相远，只在人诚人不推。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3931,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"教子吟","author":"邵雍","text":"为人能了自家身，千万人中有一人。\n虽用知如未知说，在乎行与不行分。\n该通始谓才中秀，杰出方名席上珍。\n善恶一何相去远，也由资性也由勤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3932,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"旋风吟二首 其二","author":"邵雍","text":"松桂隆冬始见青，蒿莱盛夏亦能荣。\n光阴去后绳难系，利害在前人必争。\n万事莫于疑处动，一身常向吉中行。\n人心相去无多远，安有太平人不平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3933,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"旋风吟二首 其一","author":"邵雍","text":"安有太平人不平，人心平处固无争。\n棋中机械不愿看，琴里语言时喜听。\n少日挂心唯帝典，老年留意只羲经。\n自知别得收功处，松桂隆冬始见青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3934,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚步吟","author":"邵雍","text":"晚步上阳堤，手携筇竹枝。\n静随芳草去，闲逐野云归。\n月出松梢处，风来蘋末时。\n林间此光景，能有几人知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3935,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚步洛河滩","author":"邵雍","text":"晚步洛河滩，河滩石万般。\n青黄有长短，大小或方圆。\n考彼多无数，求其用实难。\n琅玕在何处，止可使人叹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3936,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"望雨 其二","author":"邵雍","text":"久旱偶成雨，方喜慰愁苦。\n虽能敛尘土，不能救禾黍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3937,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"望雨 其一","author":"邵雍","text":"盛夏久不雨，满天下愁苦。\n安得一片云，救取人间否。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3938,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梁燕吟","author":"邵雍","text":"物情谁道尔无知，秋去春来不失期。\n今岁新雏又成就，去时宁不重依依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3939,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅花诗","author":"邵雍","text":"荡荡天门万古开，几人归去几人来。\n山河虽好非完璧，不信黄金是祸胎。\n湖山一梦事全非，再见云龙向北飞。\n三百年来终一日，长天碧水叹弥弥。\n天地相乘数一原，忽逢甲子又兴元。\n年华二八乾坤改，看尽残花总不言。\n毕竟英雄起布衣，朱门不是旧皇畿。\n飞来燕子寻常事，开到李花春已非。\n胡儿骑马走长安，开辟中原海境宽。\n洪水乍平洪水起，清光宜向汉中看。\n漫天一白汉江秋，憔悴黄花总带愁。\n古曜半升箕斗隐，金乌起灭海山头。\n云雾苍茫各一天，可怜西北起烽烟。\n东来暴客西来盗，还有胡儿在眼前。\n如棋世事局初残，共济和衷却大难。\n豹死犹留皮一袭，最佳秋色在长安。\n火龙蛰起燕门秋，原璧应难赵氏收。\n一院奇花春有主，连宵风雨不须愁。\n数点梅花天地春，欲将剥复问前因。\n寰中自有承平日，四海为家孰主宾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3940,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梦中吟","author":"邵雍","text":"梦中说梦犹能忆，梦觉梦中还又隔。\n今日恩光空喜欢，当年意爱难寻觅。\n水成流处岂无声，花到谢时安有色。\n过此相逢陌路人，都如元来曾相识。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3941,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梦过城东谒洛阳尉杨应之","author":"邵雍","text":"夜来清梦过城东，溪水分流径路通。\n全似乘查上天汉，但无严子验行踪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3942,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"盗伯吟 其二","author":"邵雍","text":"盗伯窥财物，其心只虑添。\n安得取时贪，却似败时嫌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3943,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"笺年老逢春八首 其一 好花看到半开时","author":"邵雍","text":"风轻如笑处，露重似啼时。\n只向笑啼处，浓香惹满衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3944,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绳水吟","author":"邵雍","text":"水能平而不能直，绳能直而不能平。\n安得绳水为人情，而使天下都无争。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3945,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"黄金吟","author":"邵雍","text":"身上有黄金，人无走陆沈。\n求时未必见，得处不因寻。\n辩捷非通物，涵容是了心。\n会弹无弦琴，然后能知音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3946,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"善饮酒吟","author":"邵雍","text":"人不善饮酒，唯喜饮之多。\n人或善饮酒，唯喜饮之和。\n饮多成酩酊，酩酊身遂痾。\n饮和成醺酣，醺酣颜遂酡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3947,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"善赏花吟","author":"邵雍","text":"人不善赏花，只爱花之貌。\n人或善赏花，只爱花之妙。\n花貌在颜色，颜色人可效。\n花妙在精神，精神人莫造。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3948,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]