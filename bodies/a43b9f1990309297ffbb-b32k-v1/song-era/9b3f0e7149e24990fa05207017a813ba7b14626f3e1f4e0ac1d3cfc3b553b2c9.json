[{"title":"次韵伯皋见别","author":"韩淲","text":"半世交游独有君，春风桃李满溪濆。\n数杯别酒同舟去，一种离情两路分。\n从昔早衰陶靖节，只今多病沈休文。\n浮名绊此身何用，醉眼晴空霭霭云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26709,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵晁元默和李季章参政长句因寄呈李参 其一","author":"韩淲","text":"雅怀何地不为春，弭节临川亦载欣。\n万事悠悠俱昨梦，一身落落掩前闻。\n山焚玉石何难辨，水杂淄渑未易分。\n喜见故家新筑就，试看灵谷赋烟云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26710,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵晁元默和李季章参政长句因寄呈李参 其二","author":"韩淲","text":"髣髴风流转小车，洛中情味尚谁家。\n江湖水满无飞雁，城郭春深有乱鸦。\n且自山间更林下，从渠地角是天涯。\n不因胜事那能此，一色红红白白花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26711,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"昌甫有诗琴士云得之黄子厚盖考亭坐中客也因入章泉同出城解后和韵","author":"韩淲","text":"青春深处见挥弦，吟到情时恨更牵。\n旧话相逢真梦尔，故人独觉倍依然。\n谷城大雅空三叹，云谷斯文已百年。\n珍重散庵因一笑，鬓丝禅榻羡同眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26712,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"昌甫谢徐倅行县因到山中次韵呈徐","author":"韩淲","text":"章水泉头春雨晴，寻幽都骑眼须明。\n固知地胜因人重，要是村深少客行。\n饮散轩窗虽寂寞，归馀草树亦敷荣。\n清风洗尽尘间俗，忻慕谁云只晏婴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26713,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"元日次韵绍之","author":"韩淲","text":"相从湖海逢元日，且与清吟作好春。\n病起喜能閒散步，客中翻得静怡神。\n寒侵是处梅枝晚，雪洗四边山色真。\n信道吾生有馀味，一瓢归去久甘贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26714,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵昌甫寒食 其一","author":"韩淲","text":"岁岁春深上冢时，担头挑酒纸钱垂。\n横铺嫩草松间出，乱点繁花水面吹。\n扶幼不知今潦倒，悼亡应叹昔追随。\n夕阳雨后归来路，杜宇声频落燕泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26715,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵昌甫寒食 其二","author":"韩淲","text":"三年寒食在天涯，老觉心情不为花。\n细雨随风初语燕，乱云藏日欲归鸦。\n无才圣世空狂望，有命王城莫苦嗟。\n南北两山青草遍，故园疑并野人家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26716,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵昌甫寒食 其三","author":"韩淲","text":"寒食同为异乡客，欲寻杯酒话花时。\n岂无它可倾三盏，那有閒能把一枝。\n衮衮市朝徒势隔，荒荒湖海付心知。\n牡丹天气金笺在，华发居头且送诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26717,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵上饶见怀苍筤","author":"韩淲","text":"风流天上张公子，又得清樽聚一堂。\n眇眇高人怀栗里，悠悠佳梦付巫阳。\n休论明月黄花曲，共约春时曲水觞。\n小醉醒来我何有，荒亭秋竹漫苍筤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26718,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"比年秩满言归以四季木犀瑞香二花赠徐和卿再来调官和卿有作因次韵","author":"韩淲","text":"年时我亦治行装，曾寄閒葩两种香。\n一别人犹得相见，再来花更不能忘。\n春风披拂依依紫，秋露凄迷冉冉黄。\n深巷逍遥昔居此，骚吟先后味何长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26719,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵子似同过九峰因游中团","author":"韩淲","text":"君游城市却山林，与我秋晴一日行。\n来坐村庵天欲暮，归从野寺月还明。\n时寻小榼倾残酒，更觅寒花嗅落英。\n此意相从信无几，绝怜风度各诗成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26720,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赵倅同守作太乙醮祷雨次其韵","author":"韩淲","text":"云车在望已多阴，想见东皇识此心。\n城阙步虚环佩冷，田庐望岁桔槔深。\n天高地下群龙起，雷动风行万马骎。\n午夜宝章昭格处，愿言三日便为霖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26721,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"初十日婺源得雨呈郑宰","author":"韩淲","text":"蚕麦登时天气晴，农田水利复关情。\n才看令尹灵祠祷，喜见闾阎甘雨倾。\n宣境飞蝗犹猛虎，淮壖小丑致饥氓。\n经从治国吾何幸，一枕新凉更解酲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26722,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵犁春","author":"韩淲","text":"世间何处不埃尘，百巧争如付一真。\n固蒂深根元属我，随波逐浪也由人。\n狂风骤雨时常有，野草闲花日逐新。\n安得雪堂老居士，同歌江上一犁春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26723,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"舒彦升寄东阜诗次韵","author":"韩淲","text":"朔风吹起雪成团，东阜知谁可岁寒。\n饭了行吟应杖屦，客来因酒置杯盘。\n弹冠结绶人皆易，问舍求田我亦难。\n安得相从话畴昔，但寻幽事博轻安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26724,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赵履道有诗因和韵","author":"韩淲","text":"惜此郊原一日春，高山山下葛溪滨。\n声传远树知樵斧，影落横波识钓轮。\n步稳折花空到眼，兴阑啼鸟更藏身。\n与君扶路乘残酒，清夜醒来梦亦新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26725,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和昌甫寄衡州赵推官韵","author":"韩淲","text":"遥遥石鼓是衡阳，想见山长水更长。\n世道只知天广大，文章徒与日争光。\n飘零交友难重数，偪塞閒愁懒寄将。\n谁复汎莲依簜节，好扶时运际明昌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26726,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和校官韵","author":"韩淲","text":"登山临水本何为，又近橙黄橘绿时。\n固是秋来多兴尔，岂非月上一中之。\n卧碑野处台前字，断壁山民阁上诗。\n今古风流要人物，可容吟啸不伸眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26727,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"尹谏议秋怀昌甫以其韵赋之因亦和焉 其一","author":"韩淲","text":"秋风还起白云吹，草木悲哉亦变衰。\n但觉乾坤閒外阔，未应日月闹中迟。\n丰凶处处思逢岁，穷达人人欲偶时。\n何似村居诗遣兴，柴门野老岸前篱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26728,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"尹谏议秋怀昌甫以其韵赋之因亦和焉 其二","author":"韩淲","text":"吾庐秋树正萧疏，且尔依山带郭居。\n愁与世违空泥饮，苦无诗和也抄书。\n意行谩曳双穿履，身懒常摇一败舆。\n此外并皆閒骨董，几曾妄想待何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26729,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"尹谏议秋怀昌甫以其韵赋之因亦和焉 其三","author":"韩淲","text":"争名争利路应填，幽步须容我折旋。\n一种空门心了义，八般奇语坐忘篇。\n秋来野菊开金饼，春去閒花落翠钿。\n扫尽喧卑稀客到，只闻猿鹤地尤偏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26730,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"尹谏议秋怀昌甫以其韵赋之因亦和焉 其四","author":"韩淲","text":"往来西舍复东邻，风约微岚雨敛尘。\n尽说世间多显者，岂知山里少閒人。\n路逢僧道非无累，家近渔樵定可亲。\n贫贱难居贵难守，任其商利与言缗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26731,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"尹谏议秋怀昌甫以其韵赋之因亦和焉 其五","author":"韩淲","text":"儒人从昔价连城，籍籍纷纷可浪评。\n力政既经秦六国，陈言多笑鲁诸生。\n怨缠楚些情何极，秋绝商歌意未明。\n村晚忽惊黄叶坠，又当寻取白鸥盟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26732,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"尹谏议秋怀昌甫以其韵赋之因亦和焉 其六","author":"韩淲","text":"牵牛花压小垣墙，落水澄江更草堂。\n北客任天为世界，南游何地不家乡。\n一官漫有萧朱绶，百计浑无陆贾装。\n案上堆书真可老，细哦清白洗肝肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26733,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"尹谏议秋怀昌甫以其韵赋之因亦和焉 其七","author":"韩淲","text":"壮心空使鬓先华，寂寂霜前水见沙。\n功尽醉乡元命世，名书文府且成家。\n越裳未可轻秦缶，羌笛何知咽塞笳。\n老觉悲秋甚无谓，是非愚智不须嗟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26734,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"尹谏议秋怀昌甫以其韵赋之因亦和焉 其八","author":"韩淲","text":"冷淡秋光画不成，闲身赢得醉而醒。\n水声自与月俱白，山势常知云更青。\n广大高明人孰辩，艰难险阻世曾经。\n著书固以穷愁后，陶冶多应出性灵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26735,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和民瞻所寄","author":"韩淲","text":"老觉从游易寂寥，梦思江海耿寒宵。\n元来冉冉乾坤里，大抵悠悠岁月飘。\n南北一峰高可仰，东西二馆隐谁招。\n园居好在带湖水，冰雪春须积渐消。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26736,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"昌甫同过竹院和其韵","author":"韩淲","text":"北客相从能几家，故庐谁复话京华。\n君因父母思仍赋，我亦姻㜕怅不哗。\n竹院风烟元有地，玉溪人物岂无涯。\n同来大半多先契，冻雨吹寒湿岸沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26737,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和昌甫韵","author":"韩淲","text":"云松雪竹野梅南，敢谓岁寒之友三。\n难弟难兄更佳句，閒人閒客漫游谈。\n朅来城郭如缘会，依旧山林属饱参。\n我已行缠打包笠，故家文物待重探。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26738,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和昌甫见寄","author":"韩淲","text":"岁晚溪南见旧游，归舆常恨莫能留。\n不堪别去人还远，犹幸诗来路匪修。\n野外梅生花气动，门前冰拆水声流。\n相思清梦章泉上，尽道才名光更优。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26739,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和周次公韵","author":"韩淲","text":"籍籍春山德养尊，风行水上自成文。\n饱谙世故时高枕，强对交情日置樽。\n健句如君宁有谓，和篇于我愧无闻。\n敢言暑退秋生后，静夜来敲月下门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26740,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和韵","author":"韩淲","text":"老怀相别易依依，世变纷然是与非。\n纵得斗升聊复尔，便能尺寸竟何归。\n涧横流水桃花过，路绕他山柳絮飞。\n莫叹征车我奔走，京尘应不到幽扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26741,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵昌甫送周正子入太学","author":"韩淲","text":"西风邂逅清扬婉，三叹章泉满纸诗。\n取友此时宜自信，决科他日未为迟。\n贤关礼乐当深考，世路风波不用知。\n我亦飘零玉溪住，乡评相与见于斯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26742,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和答施教授","author":"韩淲","text":"冷斋著我巽庵主，惜取禅心与法身。\n赢得閒官弄文字，岂容馀事乱吾真。\n永嘉见说多前辈，归去要知必有邻。\n野客灵山相邂逅，他年拈起话还新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26743,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"周六春伯教授四明","author":"韩淲","text":"簿正麻姑已十年，四明分教合腾骞。\n如其推毂须臾尔，便以乘轩岂偶然。\n金马玉堂非一士，蓬莱藏室尽群仙。\n儒人本是经纶学，少试羲皇所画编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26744,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"廿二日施教授父生朝又有子入佛","author":"韩淲","text":"贤关有子上云梯，更著谈空说妙儿。\n窦十郎于今可庆，庞居士在古为奇。\n双全福寿人皆仰，三昧薰脩我独知。\n春日千花记初度，玉溪閒客为声诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26745,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵推官东楼见怀","author":"韩淲","text":"谁把新诗满纸来，登临于我谓何哉。\n地偏亦有閒情在，人老宁无笑口开。\n溪山兴寄留诗眼，宾主风流落酒杯。\n昨夜秋声已摇荡，月明中夜只徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26746,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵昌甫九峰庵所寄","author":"韩淲","text":"庵院谁人车马来，草生泥路石生苔。\n冢边只有千章木，山外宁无一点埃。\n先友到时多感慨，孤儿知后转悲摧。\n读诗何忍赓酬去，夜月吹凉曲岸隈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26747,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和黄靖州适轩韵","author":"韩淲","text":"山中轩槛几经秋，谁得如公肯自由。\n既把旌旄开两镇，且因香火奉真游。\n消磨景色棋成趣，排遣功名醉不忧。\n此话尽教儿辈觉，人生凡事岂难求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26748,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵德久怀玉山诗友","author":"韩淲","text":"浙东山水几多山，公在家山定自闲。\n白发肯抛诗卷外，清愁须著酒杯间。\n岂无兴寄穷登览，犹有心情记往还。\n此道今人弃如土，翻疑逸驾未容扳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26749,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和韵沙坑","author":"韩淲","text":"交游閒处可忘年，寒日江村西稻田。\n城郭喜离墟市外，人家犹在石岩边。\n诗翁言句非嗟若，墨客心情岂舍旃。\n我亦沙坑旧酬唱，掩关空抱白云眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26750,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵巩仲至登楼见怀","author":"韩淲","text":"东望悠悠我所思，老当益壮尚知期。\n极知后会相思日，应话前因欲别时。\n往事是谁人去住，浮荣徒自位高卑。\n仲宣楼上春风里，只好疏帘看弈棋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26751,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"至日夜坐怀伯皋","author":"韩淲","text":"故人何在在乾封，想见书灯焰吐虹。\n节物正随云物转，君心应与我心同。\n梅花未有水边蕊，枫叶已无山外丛。\n何日持杯相劳苦，夜长霜重听鸣鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26752,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"有怀尹贤良玉山旧居","author":"韩淲","text":"方斋元在玉山深，六月都无暑气侵。\n一县閒人都不见，四方贤者始来寻。\n烟岚处处多真意，钟磬时时起梵音。\n既出城南过朝露，云仍留得是书琴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26753,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"有怀昌甫兄弟","author":"韩淲","text":"篱雨檐风落井梧，山幽时复见樵苏。\n近秋依约能鸣雁，长夏无过暂止乌。\n新面已多犹可饼，旧醅将少欲何酤。\n章泉二老瑞峰远，怅仰空成耳热呼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26754,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"因赵十有怀正字兄弟","author":"韩淲","text":"馀杭岳麓春还夏，只这心情各自知。\n衮衮官居随俗日，遥遥田里独醒时。\n州麾事业终何说，使节光华任有为。\n我老玉溪溪上住，醉迷风絮一吟之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26755,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"有怀","author":"韩淲","text":"相从樵隐对秋风，云气遥连沧海东。\n浮世从前多去马，空山依旧少来鸿。\n水生处处雨初足，稻熟家家饭不穷。\n我亦醉翁门下士，閒中惟觉句难工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26756,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"感兴","author":"韩淲","text":"天时人事两相催，雨浥薰风上绿槐。\n忧乐易从忙里过，荣枯空自老边来。\n寻枝带叶终无得，放浪随波岂有才。\n信道吾庐吾亦爱，溪山缭绕照崔嵬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26757,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋日感兴","author":"韩淲","text":"江湖吹雁一声秋，便合如人酒拍浮。\n南渡百年无旧事，中原积代有前修。\n竞传家国恢疆土，必定公卿运策谋。\n野处何尝知理乱，谈边遮莫话边愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26758,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"岁晚感兴","author":"韩淲","text":"岁晚天寒山水乡，团蒲曲几在书房。\n竹炉旋拨松花火，石鼎閒拈柏子香。\n吟就有时闻夜雪，睡馀乘早负朝阳。\n呼儿瓶粟今多少，且典青衫沽酒浆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26759,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"危坐","author":"韩淲","text":"行藏何事老相侵，流水高山自古今。\n强把诗书连夜读，唤回灯火十年心。\n人间富贵非难有，圣处工夫索愈深。\n不觉雨声吹入耳，秋风窗下一沉吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26760,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偶兴","author":"韩淲","text":"绿树啼莺春已阑，杜鹃声里最绵蛮。\n繁阴有路归幽处，长日无人到俗间。\n茶信为僧时过水，诗魔因客又登山。\n薄衣轻体风吹面，神观初明气自还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26761,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"述意","author":"韩淲","text":"不学神仙不问禅，此心收处亦安然。\n春风桃李閒行乐，夜月林泉常未眠。\n有客杯盘犹草草，无人杖履更翩翩。\n门前地僻红尘远，赢得虚閒近简编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26762,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"斥归","author":"韩淲","text":"一斥归来上野航，老无羁绊试斟量。\n诗囊纵在那能赋，酒盏何嫌且细尝。\n点检丘园理花草，咨询里社见蚕桑。\n玉为山底冰溪水，鱼鸟飞潜意更长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26763,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雨中睡起稍晏","author":"韩淲","text":"睡贪凉雨失窗明，坐起萧然笑我生。\n故旧几何论岁晚，僮奴只待得秋晴。\n蹊间井臼草多没，岸底沟池水易盈。\n閒不厌多宁厌病，卧时谁复更关情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26764,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春思","author":"韩淲","text":"春向深时花未多，柳浓桃淡欲如何。\n篱根山雪风犹力，屋角林霜日欠和。\n徒有爱闲常自惜，岂无好事略相过。\n得朋便若开心眼，芳绿韶红两荡摩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26765,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春怀","author":"韩淲","text":"寂寂春风送落花，芊绵芳草遍天涯。\n数声飞鸟閒亭馆，几个轻鸥泊浪沙。\n望断小溪流不尽，步寻幽谷路还赊。\n一巾华发吾何赋，肯与浮荣定等差。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26766,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋怀","author":"韩淲","text":"漠漠轻阴楼上头，老来心绪不关秋。\n相看鸿影檐前过，转觉蛩吟砌下幽。\n尽以诗囊供写兴，少将酒盏与浇愁。\n急风又堕萧萧叶，天淡水云无数浮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26767,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偶成","author":"韩淲","text":"老身何计可飞腾，收敛精神过此生。\n耿耿自温诚自遣，栖栖无乃类无成。\n湖山放浪惭真隐，朝市低回亦强荣。\n随分官曹了饥渴，小楼听雨晚风清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26768,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"勿向","author":"韩淲","text":"勿向閒中懒却身，自家志意要精明。\n书来眼下休粗看，事过手时多错行。\n血气易令人喜惧，功名徒使我衰荣。\n青山绿水虽潇洒，莫被清虚误一生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26769,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"杂诗","author":"韩淲","text":"富贵荣华总未经，此身虽老意何惊。\n日梳白发凭轩笑，时照苍颜傍水行。\n局束一家儿女态，凋零四海友朋情。\n烛摇醉眼梅花白，香动夜窗吹雨声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26770,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"孙期牧豕","author":"韩淲","text":"祝鸡牧豕其非误，逐鹿屠龙也是閒。\n用破心时无活路，得全身处有名山。\n洪纤高下皆徼幸，终始乘除每好还。\n一任凤歌仍豹隐，多应蚁梦与蜗蛮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26771,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]