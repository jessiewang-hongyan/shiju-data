[{"title":"扶胥三首 其一","author":"刘克庄","text":"一阵东风扫曀霾，天容海色豁然开。\n何须更网珊瑚树，祇读韩碑也合来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30006,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"报恩寺","author":"刘克庄","text":"一抹斜阳上缭垣，芫花满地柏阴繁。\n城中客子闻钟去，独立空山听断猿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30007,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"旴士张季携所注三略访西山先生既跋其书余复题二绝于卷尾 其二","author":"刘克庄","text":"千里从师细讲评，横渠昔亦谒高平。\n自从受得中庸了，止说西铭不说兵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30008,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"时事","author":"刘克庄","text":"问讯班春守，牢辞馈岁人。\n翁年十分老，时事一番新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30009,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"李文饶一首","author":"刘克庄","text":"画取维州如槁叶，策禽潞将似婴儿。\n九原精爽人犹畏，想见中书秉笔时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30010,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"村居书事四首 其四","author":"刘克庄","text":"刮膜神方直万金，国医曾费一生心。\n可怜髽髻提篮者，也有盲人问点针。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30011,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"村居书事四首 其三","author":"刘克庄","text":"卜叟囊书系肘边，儿童尊信等神仙。\n立谈算尽平生事，问到封侯拜相年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30012,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"村居书事四首 其二","author":"刘克庄","text":"新剃阇梨顶尚青，满村看说法华经。\n安知世有弥天释，万衲如云座下听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30013,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"村居书事四首 其一","author":"刘克庄","text":"有客相逢说坎离，葫芦中药不容窥。\n扣头无力营丹灶，聊奉先生一醉资。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30014,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"村獠","author":"刘克庄","text":"村獠席地睡，咍㘆唤不知。\n老夫将北面，渠莫是希夷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30015,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杜鹃问答二首 其二","author":"刘克庄","text":"云安万里一禽微，翅短安能远奋飞。\n帝放还山君有福，虏犹戍蜀我安归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30016,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杜鹃问答二首 其一","author":"刘克庄","text":"昔南使粤北防秋，闻汝啼声悔远游。\n我忆故乡归久矣，君归未得使人愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30017,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"求凤曲","author":"刘克庄","text":"古有轻生士，今无起死医。\n可怜茂陵渴，犹画远山眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30018,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"沧浪馆夜归二首 其二","author":"刘克庄","text":"立马飞书万众看，雪花满砚指皆寒。\n自怜衰惫今如此，枕上裁诗字未安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30019,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"沧浪馆夜归二首 其一","author":"刘克庄","text":"万疋沙场似电奔，轰天笳吹簇辕门。\n而今出借东家马，烟雨孤行小麦村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30020,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"灵著祠","author":"刘克庄","text":"甘宁关羽至今传，名将为神自古然。\n生不封侯三万户，死犹庙食数千年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30021,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"芙蓉二绝 其一","author":"刘克庄","text":"湖上秋风起棹歌，万株映柳更依荷。\n老来不作繁华梦，一树池边已觉多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30022,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"芙蓉二绝 其二","author":"刘克庄","text":"池上秋开一两丛，未妨冷淡伴诗翁。\n而今纵有看花意，不爱深红爱浅红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30023,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"芳臭","author":"刘克庄","text":"流芳斜谷出师表，遗臭樊城受禅碑。\n芳臭即今皆判矣，鲍鱼难掩祖龙尸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30024,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"苏柑","author":"刘克庄","text":"橘里争棋叟，壶中卖药公。\n苏柑肥似瓠，盛不得樗翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30025,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赤壁图","author":"刘克庄","text":"共餐鲈一箸，各饮酒三升。\n客去主人睡，明朝醉未兴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30026,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"辛卯满散天基节即事六首 其六","author":"刘克庄","text":"小臣无状挂丹书，还著青袍两载馀。\n物色依然如碧鹳，阶衔久矣削绯鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30027,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"辛卯满散天基节即事六首 其五","author":"刘克庄","text":"野衲云云祝圣躬，亦拈拂子演宗风。\n恨渠僻陋无闻见，不识光公与杲公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30028,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"辛卯满散天基节即事六首 其四","author":"刘克庄","text":"约己隆亲礼不同，钧天无宴锡臣工。\n太皇勋德侔高帝，陛下谦恭似孝宗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30029,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"辛卯满散天基节即事六首 其三","author":"刘克庄","text":"闻说都人竞出嬉，御街箫鼓倍年时。\n相公入奏天颜喜，半夜扬州送捷旗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30030,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"辛卯满散天基节即事六首 其二","author":"刘克庄","text":"门庑无人殿未开，白头散吏久徘徊。\n年年岁岁千秋节，长占群官第一来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30031,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"辛卯满散天基节即事六首 其一","author":"刘克庄","text":"老作黄冠返旧山，尚支驿料破衙官。\n孤臣毫发皆君赐，独坐风廊不觉寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30032,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"辛亥各口占十绝 其十","author":"刘克庄","text":"诛虎窃弓谁继者，留邕执笔定何如。\n东都台阁犹多士，未便无人续汉书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30033,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"辛亥各口占十绝 其一","author":"刘克庄","text":"和靖湖边冷笑人，白头来恋属车尘。\n此行莫与孤山诀，重见除非是后身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30034,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"辛亥各口占十绝 其八","author":"刘克庄","text":"院吏忙抄诏草辞，家奴却负锦囊随。\n更无客议坡公制，一任人嘲李老诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30035,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"辛亥各口占十绝 其九","author":"刘克庄","text":"柱史颂卿压病身，年高拜立两愁人。\n龙钟忽被还山诏，腰脚于今得欠伸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30036,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"辛亥各口占十绝 其三","author":"刘克庄","text":"乞骸亲奉留行诏，擢发犹蒙掩覆恩。\n泽畔累臣回首处，汤村已远更徐村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30037,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"辛亥各口占十绝 其七","author":"刘克庄","text":"向来宠辱皆虚假，老去亲冤两扫平。\n岂有陈三送迁客，亦无邢七卖先生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30038,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"辛亥各口占十绝 其五","author":"刘克庄","text":"玉局摛文毫尚湿，金华开卷席犹温。\n不妨缴纳朝堂了，帝赐新衔号后村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30039,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"辛亥各口占十绝 其二","author":"刘克庄","text":"苇间一叶且延缘，奎壁祥光上烛天。\n定有异人遥望气，个船不是米家船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30040,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"还杜子野诗卷","author":"刘克庄","text":"老眼昏花废课程，小窗久矣断书声。\n夜来忽得君诗卷，自起挑灯读到明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30041,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闲情","author":"刘克庄","text":"宴坐仅留半窗月，归装只载一船愁。\n可怜潘令无标致，却为闲情白了头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30042,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陆贾二首 其二","author":"刘克庄","text":"郦烹未久蒯几烹，陆子优游享令名。\n南帝称臣橐金返，更推馀智教陈平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30043,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陆贾二首 其一","author":"刘克庄","text":"田横死士今亡矣，陈豨从车安在哉。\n独有尉佗尚黄屋，故应两费陆生来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30044,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陈景升顷遗余化度寺碑甚佳阙后三行归自龙溪始为余补足记以绝句","author":"刘克庄","text":"端平曾叹阙三行，淳祐重来为补亡。\n收拾一碑劳十载，此生凡事不须忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30045,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乳洞","author":"刘克庄","text":"千峰梦里尚崔嵬，不记青鞋走几回。\n天恐锦囊犹欠阙，又添乳洞入诗来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30046,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"凯歌十首呈贾枢使 其一","author":"刘克庄","text":"孔明筹笔即天威，谢傅围棋亦事机。\n武骑散群望洋退，佛狸忍渴饮溲归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30047,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"凯歌十首呈贾枢使 其六","author":"刘克庄","text":"将谓长淮已荡平，岂知什堑又颠坑。\n从今莫近他城子，怕有南人夜斫营。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30048,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"凯歌十首呈贾枢使 其四","author":"刘克庄","text":"东南立国惟王谢，西北筹边只范韩。\n公不衮衣假黄钺，吾能右衽更巍冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30049,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"凯歌十首呈贾枢使 其二","author":"刘克庄","text":"剪称名将岂其然，汲汲惟求宅与田。\n见说淮兵殊死战，相公喝犒是私钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30050,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"凯歌十首呈贾枢使 其五","author":"刘克庄","text":"君亲一念与天通，麾下人人可即戎。\n岂敢全躯顾妻子，相公将母在军中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30051,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"凯歌十首呈贾枢使 其八","author":"刘克庄","text":"羽檄联翩趣募兵，单枪一剑觅功名。\n健儿争欲趋淮阃，宣相相看若父兄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30052,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"凯歌十首呈贾枢使 其九","author":"刘克庄","text":"残党分兵尽扑除，游魂多不返穹庐。\n肃清执至龙颜喜，又奏淮西有捷书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30053,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"凯歌十首呈贾枢使 其七","author":"刘克庄","text":"清野都无寸草留，暴师塞下欲何求。\n东风借便天亡敌，春水方生早去休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30054,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"凯歌十首呈贾枢使 其三","author":"刘克庄","text":"活俘万户虏无酋，拔寨宵奔黑祲收。\n不用偏师追出塞，杀胡林只在扬州。","collection":"宋","n