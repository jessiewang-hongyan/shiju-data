oetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30061,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和仲弟十绝 其七","author":"刘克庄","text":"少工文字老安施，不但才悭力已疲。\n无复滴泉来上绠，惠连入梦偶成诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30062,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和仲弟十绝 其四","author":"刘克庄","text":"楼头吹彻几寒梅，推枕穿衣晓帐开。\n蚁斗蜗争求予决，老夫身世自难裁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30063,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和仲弟十绝 其一","author":"刘克庄","text":"懒窥户外问晴阴，静向窗前阅古今。\n江国事稀聊袖手，钧天梦断久灰心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30064,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和仲弟十绝 其九","author":"刘克庄","text":"雁回杳杳浑无报，鹊语啾啾似有凭。\n忽得远书看百过，眼昏自起剔残灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30065,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和仲弟十绝 其六","author":"刘克庄","text":"行遍高台到曲池，闲将白发照清漪。\n未应官舍无幽事，亦有临流啸咏时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30066,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和仲弟十绝 其十","author":"刘克庄","text":"千古堂堂一孔明，尚咨幼宰访州平。\n诸君应悉惓惓意，老子宁希赫赫声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f7968