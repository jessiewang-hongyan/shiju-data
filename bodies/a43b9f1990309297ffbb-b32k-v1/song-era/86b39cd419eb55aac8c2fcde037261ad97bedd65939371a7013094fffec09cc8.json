[{"title":"送梁必大归杭省亲 其一","author":"黎廷瑞","text":"悠悠楚水，霭霭吴云。\n孰作之合，胡然而分。\n岂无良朋，我独子忻。\n于穆令德，有粲其文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30001,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"一剪梅 菊酒","author":"黎廷瑞","text":"小小黄花尔许愁。\n楚事悠悠，晋事悠悠。\n荒芜三径渺中洲，开几番秋，落几番秋。\n不是孤芳万古留。\n餐亦堪羞，采亦堪羞。\n离骚赋罢酒新篘，醒也风流，醉也风流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30002,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"八声甘州 金陵怀古","author":"黎廷瑞","text":"恨巨灵、多事凿长江，消沈几英雄。\n恨乌江亭长，天机轻泄，说与重瞳。\n更恨南阳耕叟，撺掇紫髯翁。\n一弹金陵土，战虎争龙。\n杯酒凤凰台上，对石城流水，钟阜诸峰。\n问六朝陵阙，何处是遗踪。\n后庭花、更无留响，渺春潮、残照笛声中。\n悲欢梦，芜城杨柳，几度春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30003,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大江东去/念奴娇 题项羽庙","author":"黎廷瑞","text":"鲍鱼腥断，楚将军、鞭虎驱龙而起。\n空费咸阳三月火，铸就金刀神器。\n垓下兵稀，阴陵道隘，月黑云如垒。\n楚歌哄发，山川都姓刘矣。\n悲泣呼醒虞姬，和伊死别，雪刃飞花髓。\n霸业休休骓不逝，英气乌江流水。\n古庙颓垣，斜阳老树，遗恨鸦声里。\n兴亡休问，高陵秋草空翠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30004,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"水龙吟 金陵雪后西望","author":"黎廷瑞","text":"不知玄武湖中，一瓢春水何人借。\n裁冰剪雨，等闲占断，桃花春社。\n古阜花城，玉龙盐虎，夕阳图画。\n是东风吹就，明朝吹散，又还是、东风也。\n回首当时光景，渺秦淮、绿波东下。\n滔滔江水，依依山色，悠悠物化。\n璧月琼花，世间消得，几多朝夜。\n笑乌衣、不管春寒，只管说、兴亡话。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30005,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"水龙吟 九日登城","author":"黎廷瑞","text":"荒城落日西风，满街芳草无行路。\n楼台羽化，萤飞故苑，蛩吟残础。\n不减承平，半湖秋月，隔溪烟树。\n慨江南风景，一朝如许，教人恨、王夷甫。\n对酒强推愁去。\n酒醒来、愁还如故。\n青萍三尺，阴符一卷，土花尘蠹。\n试问黄花，花知余否，沈吟无语。\n拍阑干，空羡平沙落雁，沧波归鹭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30006,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"水调歌头 寄奥屯竹庵察副留金陵约游扬州不果","author":"黎廷瑞","text":"腰缠十万贯，骑鹤上扬州。\n诗翁那得有此，天地一扁舟。\n二十四番风信，二十四桥风景，正好及春游。\n挂席欲东下，烟雨暗层楼。\n紫绮冠，绿玉杖，黑貂裘。\n沧波万里，浩荡踪迹寄浮鸥。\n想杀南台御史，笑杀南州孺子，何事此淹留。\n远思渺无极，日夜大江流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30007,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诉衷情令 濡溪悼旧","author":"黎廷瑞","text":"曲屏深院赴幽期。\n心事梦云知。\n佩环零乱何处，江上草离离。\n日平西，天似幕，月如眉。\n依稀还记，两岸杨花，送上船时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30008,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"青玉案 泛大江","author":"黎廷瑞","text":"巨舟双橹鸣鹅鹳。\n千万顷、玻璃面。\n宇宙浮萍堪永叹。\n黄唐开辟，秦隋争战。\n不把江山换。\n芦花新雪秋撩乱。\n何处渔舟起孤筦。\n一片古愁萦不断。\n平沙矮树，溪烟荒岸。\n落日西风雁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30009,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南乡子 乌衣园","author":"黎廷瑞","text":"醉罢黑瑶池。\n渺渺春云海峤归。\n画栋珠帘成昨梦，谁知。\n百姓人家几度非。\n相对语斜晖。\n肠断江城柳絮飞。\n再见玉郎应不认，堪悲。\n也被缁尘染素衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30010,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"祝英台近 闺怨","author":"黎廷瑞","text":"彩云空，香雨霁。\n一梦千年事。\n碧幌如烟，却扇试新睡。\n恁时杨柳阑干，芙蓉池馆，还只似、如今天气。\n远山翠。\n空相思，淡扫修眉，盈盈照秋水。\n落日西风，借问雁来未。\n只愁雁到来时，又无消息，只落得，一番憔悴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30011,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贺新郎 落星寺","author":"黎廷瑞","text":"帆影斜阳里。\n与芦花、分风飞过，落星遗此。\n瓦老苔荒钟鼓陋，斑剥，残碑无几。\n想此处、阅人多矣。\n天上白榆犹落去，况人间、一瞬浮花蕊。\n问五老，笑而已。\n仙翁当日曾挥麈。\n拍阑干、浩歌音响，振鱼龙耳。\n九十馀年无人问，遗韵半江烟水。\n慨宇宙、风涛如许。\n安得六丁移此石，去横身、作个中流砥。\n长唱罢，冥鸿起。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30012,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"唐多令","author":"黎廷瑞","text":"回棹百花洲。\n迢迢碧玉流。\n听笛声、何处高楼。\n如此江山无此客，虽有酒、奈何秋。\n呼月出云头。\n问渠能饮不。\n笑人间、元自无愁。\n可惜月翁呼不出，呼得出、载同游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30013,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浣溪沙 送别","author":"黎廷瑞","text":"一曲离愁浅黛嚬。\n云帆渺渺下烟津。\n山长水远客愁新。\n柳絮低迷千里梦，桃花荡漾一江春。\n小楼疏雨可怜人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30014,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浪淘沙令 惜别","author":"黎廷瑞","text":"别易见时难。\n万水千山。\n参商烟树暮云间。\n料想凤凰城里梦，夜夜归鞍。\n杨柳小楼闲。\n倚遍阑干。\n东风剪剪雨珊珊。\n落尽桃花无可落，只管春寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30015,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秦楼月/忆秦娥 其五","author":"黎廷瑞","text":"红苞拆。\n巡檐一笑风情别。\n风情别。\n广平空道，心肠如铁。\n灞桥更有狂吟客。\n短鞭破帽貂裘窄。\n貂裘窄。\n瘦驴卓耳，一鞍风雪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30016,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秦楼月/忆秦娥 其一","author":"黎廷瑞","text":"幽香歇。\n玉龙吹彻花如雪。\n花如雪。\n小桥流水，不胜愁绝。\n横梢剪入生绡墨。\n翠阴青子盈盈结。\n盈盈结。\n淡烟微雨，江南三月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30017,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秦楼月/忆秦娥 其三","author":"黎廷瑞","text":"叶叶里。\n一枝冷浸铜瓶水。\n铜瓶水。\n飞英簇簇，砚屏香几。\n夜来雪片敲窗纸。\n半衾芳梦相料理。\n相料理。\n梨花漠漠，江南千里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30018,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秦楼月/忆秦娥 其二","author":"黎廷瑞","text":"罗浮暮。\n青松林下相逢处。\n相逢处。\n缟衣素袂，沈吟无语。\n行云飞入瑶台路。\n梦回飘渺香风度。\n香风度。\n参横月落，几声翠羽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30019,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秦楼月/忆秦娥 其七","author":"黎廷瑞","text":"齐山硕。\n扫开残雪簪花饮。\n簪花饮。\n樽前人唱，暗香疏影。\n枝南枝北迢迢恨。\n春风旧梦难重省。\n难重省。\n小窗斜月，薄酲残醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30020,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秦楼月/忆秦娥 其九","author":"黎廷瑞","text":"醒人眼。\n一枝玉雪疏篱晚。\n疏篱晚。\n精神旷逸。\n风姿凝远。\n幽香零乱无人管。\n依依春恨天涯满。\n天涯满。\n霜城戍角，月楼羌管。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30021,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秦楼月/忆秦娥 其八","author":"黎廷瑞","text":"花孤冷。\n海棠聘与花应肯。\n花应肯。\n海棠只是，无香堪恨。\n香无却有仙风韵。\n能争几日芳期近。\n芳期近。\n东风何事，不留花等。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30022,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秦楼月/忆秦娥 其六","author":"黎廷瑞","text":"春来了。\n孤根矫树花开早。\n花开早。\n水村山郭，嫩红晴晓。\n陇头何处鳞鸿杳。\n一枝欲寄行人少。\n行人少。\n大江南岸，北风低草。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30023,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秦楼月/忆秦娥 其四","author":"黎廷瑞","text":"春脉脉。\n含章檐下妆宫额。\n妆宫额。\n也还点画，村烟茅结。\n人间天上俱清绝。\n风流大似东坡客。\n东坡客。\n玉堂如玉，雪堂如雪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30024,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秦楼月/忆秦娥 梅花十阕 其一","author":"黎廷瑞","text":"云根屋。\n东风四壁花如玉。\n花如玉。\n水仙伤婉。\n山矾伤俗。\n高标懒趁时妆束。\n一丘一壑便幽独。\n便幽独。\n商山四皓，首阳孤竹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30025,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清平乐 雨中春怀呈准轩","author":"黎廷瑞","text":"清明寒食。\n过了空相忆。\n千里音书无处觅。\n渺渺乱芜摇碧。\n苍天雨细风斜。\n小楼燕子谁家。\n只道春寒都尽，一分犹在桐花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30026,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清平乐 舒州","author":"黎廷瑞","text":"秋怀骚屑。\n卧听萧萧叶。\n四壁寒蛩吟不歇，旧恨新愁都说。\n疏疏雨打栖鸦。\n月痕犹在窗纱。\n一夜西风能紧，明朝瘦也黄花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30027,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"眼儿媚 寓城思归竹庵留行赋呈","author":"黎廷瑞","text":"暖云挟雨洗尘埃。\n刬地峭寒催。\n燕儿知否，莺儿知否，厮句春回。\n小楼日日重帘卷，应是把人猜。\n杏花如许，桃花如许，不见归来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30028,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"朝中措 送春","author":"黎廷瑞","text":"游丝千万暖风柔，只系得春愁。\n恨杀啼莺句引，孤他语燕攀留。\n纵然留住，香红吹尽，春也堪羞。\n去去不堪回首，斜阳一点西楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30029,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"满江红 赋竹樽","author":"黎廷瑞","text":"千亩君封，新移就、美泉天禄。\n形制古，椰樽嫌窄，瓠壶嫌俗。\n爱酒步兵缘业重，平生所愿何时足。\n再来生、竟堕此林中，充其腹。\n秋入洞，鉴金筑。\n春出户，跳珠玉。\n想宜城九酝，叶光凝绿。\n驴背夕阳同倒载，醉乡只在筼筜谷。\n问东坡、何独饮松醪，还思肉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30030,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酹江月/念奴娇 其二 呈谭龙山","author":"黎廷瑞","text":"锦袍何处，向旧江、衰草寒芦萧瑟。\n瀛馆神仙挥玉麈，唤醒诗酒魂魄。\n走电飞虹，惊涛触石，举目乾坤窄。\n油然归去，短篷多载风月。\n好在雨外云根，水边石上，鸥鹭盟重结。\n见说西湖湖上路，香沁梅梢新雪。\n驾白麒麟，鞭青鸾凤，次第孤山客。\n吾今西啸，寄诗先与逋仙说。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30031,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酹江月/念奴娇 其一 题永平监前刘氏小楼","author":"黎廷瑞","text":"远山如簇，对楼前、浓抹淡妆新翠。\n应是西湖湖上景，移过江南千里。\n旧日春光，重归杨柳，苒苒黄金缕。\n市声分付，画桥之外流水。\n最好叠观泥金，危城带粉，文笔双峰倚。\n烟寺晚钟渔浦笛，都入王维画里。\n敧枕方床，凭阑往古，世界浮萍耳。\n湖天风紧，白鸥欲下还起。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30032,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蝶恋花 元旦","author":"黎廷瑞","text":"密炬瑶霞光颤酒。\n翠柏红椒，细剪青丝韭。\n且劝金樽千万寿。\n年时芳梦休回首。\n小雨轻寒风满袖，下却帘儿，莫道梅花瘦。\n万点鹅黄春色透。\n玉箫吹上江南柳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30033,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"绳金寺","author":"黎良知","text":"悬崖结屋层层阁，眺远开窗面面峰。\n云起半天齐碧瓦，风生万壑响长松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30034,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"黎良知","text":"见说老僧吟更苦，中宵得句喜撞钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30035,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游金精山","author":"黎宙","text":"不到金精久，山空花自香。\n殿梁唐岁月，石鼓汉文章。\n洞杳多云气，崖高易夕阳。\n酌泉消世虑，吾亦正徜徉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30036,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽赵秋晓 其二","author":"黎善夫","text":"十载荒村共乱离，云龙上下忆追随。\n生前已饱撞钟问，死后方传覆瓿诗。\n此夕巷歌谁忍发，他年邻笛自应悲。\n伤心岂为幽冥负，重为斯文一涕洟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30037,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽赵秋晓 其一","author":"黎善夫","text":"年时父子记同登，讵意天从杞国倾。\n辇路春风三月梦，山庄夜雨十年灯。\n率更帖墨知魁梧，庾信文章迈老成。\n二妙风流今已矣，薤歌赋罢泪沾膺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30038,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"张桓侯庙","author":"黎登","text":"涿鹿雄威衮绣乡，早从昭烈起楼桑。\n眼空塞北万夫特，名在巴西千古香。\n将蜀若教星不陨，吞吴未信策非良。\n兴刘不尽英雄志，太息无由问彼苍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30039,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"门外","author":"黎道华","text":"门外黄尘尺许深，痴儿抵死竞浮沈。\n谁知一寸茅檐日，天付闲人值万金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30040,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢惠五月菊","author":"黎道华","text":"道人移菊到山家，细袅薰风带露华。\n便有渊明篱下趣，谁人着眼看荷花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30041,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢惠兰花","author":"黎道华","text":"晓起微凉病骨苏，国香和露到贫居。\n我今不向当门种，免被时人取次锄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30042,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"拟岘台","author":"黎道华","text":"我因访古独来游，万顷风烟一目收。\n灵谷诸峰排槛出，巽溪几曲抱城流。\n帆樯影乱汀洲晚，芦苇声寒雁鹜秋。\n堕泪丰碑那得见，片云落日是襄州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30043,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"明水寺","author":"黎道华","text":"寒日荒荒野外昏，乱山深处访祇园。\n一条涧水穿龙洞，十里松阴蔽寺门。\n衲子茹蔬惟鹤瘦，吾侪饮酒作鲸吞。\n夜阑笑语喧空阔，惊起栖鸦过别村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30044,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"疏山","author":"黎道华","text":"杖藜徐步兴何长，宛宛岚光接水光。\n蝉噪荒林桐叶老，风回半野稻花香。\n却过萧寺寻僧话，又入松轩卧晚凉。\n雨后微云山更好，与君行李未须忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30045,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"金石台遥碧堂","author":"黎道华","text":"三真驾鹤朝上清，金童前导双霓旌。\n去如抟风不复返，至今雾雨愁青冥。\n空山楼观才烟霭，山根水作青罗带。\n道人绿发映方瞳，呼吸岚光餐沆瀣。\n瀛洲有路接蓬壶，欲往从之无飞车。\n白浪如山海风恶，此时目断空愁予。\n何如散发一堂上，水色山容相荡漾。\n赋诗把酒弄清晖，酒人奇胸诗益壮。\n三真在天今几秋，瑶林琪树连琼楼。\n会看云鹤下尘世，金石岩前寻旧游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30046,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"城头月","author":"黎道静","text":"阳光子夜开清昼。\n照了无何有。\n弱水蓬莱，河车忽动，万顷金波皱。\n红铅墨汞相交媾。\n片饷丹成就。\n把握阴阳，一钟造化，此诀人知否。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30047,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽陈月桥","author":"黎献","text":"先生仙去上青冥，收拾华词付六丁。\n遗像堂堂千古月，名公落落几晨星。\n文章有子传灯印，学校无人属典型。\n公论权衡嗟已矣，兴言及此涕交零。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30048,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽陈淡交先生","author":"黎献","text":"承师受业忆同门，如水之交昔有年。\n痛哭鸰原情未已，徘徊鵩舍意凄然。\n功名早领贤书荐，世业由来家学传。\n硕德晨星嗟已矣，试编遗稿泪潸涟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30049,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽赵秋晓 其一","author":"黎献","text":"父子龙门客，衣冠濮邸孙。\n海桑尘劫换，文献故家存。\n白璧今横道，青衫此盖棺。\n风流顿消歇，些罢涕汍澜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30050,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽赵秋晓 其四","author":"黎献","text":"假馆惭何补，叨邻卜偶从。\n灯曾分夜读，歌忍相晨舂。\n一壁山河邈，他生饮啄同。\n眼前无此屋，风雨忆帡幪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30051,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽赵秋晓 其三","author":"黎献","text":"净觉草未宿，先生复踵之。\n百年几英特，三载两凋萎。\n此去无欢日，重逢有梦时。\n向来觞咏地，衰柳带斜晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30052,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽赵秋晓 其二","author":"黎献","text":"岭海英游少，诗书旺气衰。\n先生今不起，后死竟安归。\n文曲星何暝，灵光赋又非。\n儒宗真可憾，岂但哭吾私。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30053,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"绍熙庚戌中秋后三日拜张于湖墓","author":"操某","text":"古冢谁来香一瓣，断蓬衰草自斜阳。\n至今唯有文章骨，埋入幽泉土也香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30054,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"僻居","author":"燕肃","text":"茅茨城市远，草径接鱼村。\n白日偶无客，青山长对门。\n药炉留火暖，花坞带烟昏。\n静坐搜新句，冥心傍酒樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30055,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠惠山庆上人","author":"燕肃","text":"陆羽泉边倚瘦筇，参差台殿映疏松。\n五天讲去春骑虎，一钵擎来昼伏龙。\n像阁磬敲清有韵，苏庭云过静无踪。\n相逢多说游方话，知老灵山第几峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30056,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"剑阁","author":"燕肃","text":"剑耸秋峰积霭昏，关城遥向望中分。\n触新百堵连青嶂，依旧千家住白云。\n松桧影随岩寺出，管弦声杂涧声闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30057,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"燕肃","text":"鬓边今日白，腰下几时黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30058,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"燕肃","text":"南昌襦裤歌将洽，西掖丝纶演未迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30059,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其三","author":"燕肃","text":"王宣古楼阁，习郁旧池塘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30060,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"燕度","text":"三山排鼎足，七塔布琴弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30061,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"绝句","author":"燕照邻","text":"女矮儿痴十口馀，进时无业退无庐。\n一窗风雪韩城夜，火冷灯青照旧书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30062,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过西京","author":"穆脩","text":"西京千古帝王宫，无限名园水竹中。\n来恨不逢桃李日，满城红树正秋风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30063,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"城南五题 其一 郊步","author":"穆脩","text":"野水岸边逢草歇，平林烟畔逐花行。\n雨晴南陌尘埃洗，倍觉风光夺眼明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30064,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]