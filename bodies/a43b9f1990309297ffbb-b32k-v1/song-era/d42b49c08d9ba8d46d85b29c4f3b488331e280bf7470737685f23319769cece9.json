[{"title":"颂古一百则 其二十九","author":"释正觉","text":"铁牛之机，印住印破。\n透出毗卢顶?行，却来化佛舌头坐。\n风穴当衡，卢陂负堕。\n棒头喝下，电光石火。\n历历分明珠在盘，眨起眉毛还蹉过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10223,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百则 其十九","author":"释正觉","text":"不起一念须弥山，韶阳法施意非悭。\n肯来两手相分付，拟去千寻不可攀。\n沧海阔，白云闲，莫将毫发著其间。\n假鸡声韵难谩我，未肯模胡放过关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10224,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百则 其七十","author":"释正觉","text":"豁落亡依，高闲不羁，家邦平贴到人稀。\n些些力量分阶级，荡荡身心绝是非。\n是非绝，介立大方无轨辙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10225,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百则 其八十九","author":"释正觉","text":"草漫漫，门里门外君自看。\n荆棘林中下脚易，夜明帘外转身难。\n看看，几何般。\n且随老木同寒瘠，将逐春风入烧瘢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10226,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百则 其一○○","author":"释正觉","text":"钵里饭，桶里水，开口见胆求知己。\n拟思便落二三机，对面忽成千万里。\n韶阳师，较些子。\n断金之义兮谁与相同，匪石之心兮独能如此。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10227,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百则 其三十五","author":"释正觉","text":"摇头摆尾赤梢鳞，彻底无依解转身。\n截断舌头饶有术，拽回鼻孔妙通神。\n夜明帘外兮风月如昼，枯木岩前兮花卉长春。\n无舌人，无舌人，正令全提一句亲。\n独步环中明了了，任从天下乐欣欣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10228,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百则 其五十八","author":"释正觉","text":"缀缀功过，胶胶因果。\n镜外狂奔演若多，杖头击著破灶堕。\n灶堕破，来相贺，却道从前辜负我。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10229,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百则 其三十六","author":"释正觉","text":"日面月面，星流电卷。\n镜对像而无私，珠在盘而自转。\n君不见钳锤前百鍊之金，刀尺下一机之绢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10230,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百则 其九十三","author":"释正觉","text":"别是非，明得丧。\n应之心，指诸掌。\n往来不往来，只者俱是藏。\n轮王赏之有功，黄帝得之罔象。\n转枢机，能伎俩，明眼衲僧无卤莽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10231,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百则 其八十六","author":"释正觉","text":"九包之雏，千里之驹。\n真风度籥，灵机发枢。\n劈面来时飞电急，迷云破处太阳孤。\n捋虎须，见也无，个是雄雄大丈夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10232,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百则 其六十四","author":"释正觉","text":"离念见佛，破尘出经。\n现成家法，谁立门庭。\n月逐舟行江练净，春随草上烧痕青。\n拨不拨，听丁宁，三径就荒归便得，旧时松菊尚芳馨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10233,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百则 其十四","author":"释正觉","text":"觌面来时作者知，可中石火电光迟。\n输机谋主有深意，欺敌兵家无远思。\n发必中，更谩谁。\n脑后见腮兮人难触犯，眉底著眼兮渠得便宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10234,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二十一首 其二十二","author":"释正觉","text":"智门真得祖家风，放出云门广长舌。\n大智如愚，大巧若拙，用尽工夫参不彻。\n莫于平地上增堆，休向虚空里钉橛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10235,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二十一首 其二十一","author":"释正觉","text":"大众退后，衲僧去就。\n岂用机关，那容体究。\n蓑翁老熟惯风波，桡棹不施船放溜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10236,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二十一首 其二十","author":"释正觉","text":"翡翠帘垂，丝纶未济。\n紫罗帐合，视听难通。\n犯动毛头，月升夜扃。\n密移一步，鹤出银笼。\n脱身一色无遗影，不坐同风落大功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10237,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二十一首 其十九","author":"释正觉","text":"雪老大开方便路，低头却入庵中去。\n者僧有眼恰如盲，却被岩头行一步。\n者僧好休不肯休，依然依路去悠悠。\n元来不会雪峰意，却被岩头瓮赣头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10238,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二十一首 其十七","author":"释正觉","text":"无人接得渠，遗逼马相如。\n果来桥上也，记得柱头书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10239,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二十一首 其十五","author":"释正觉","text":"即日贵人，旧家贫汉。\n兄弟相承，尊卑互换。\n向晚途中眼不开，夜明帘外机旋转。\n骑牛戴帽异中来，百鍊真金色不变。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10240,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其七十六","author":"释正觉","text":"渠非老朽，不礼不受。\n威音世前，毗卢顶后。\n把定壶中白日长，触著匣内青蛇吼。\n良医叮嘱病人，服药不如忌口。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10241,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二十一首 其十三","author":"释正觉","text":"双盲入暗路崎岖，日落栖芦暂得苏。\n争似石人眠半夜，免教舜让守林居。\n须知花绽非干木，无脚行时早触途。\n昨朝风起长安道，元是昆崙进国图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10242,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二十一首 其七","author":"释正觉","text":"青山不异，白玉无瑕。\n茫茫流水，扰扰黄花。\n有佛处纤毫不立，无佛处万别千差。\n长安路上未归客，寻溪由自摘杨花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10243,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其二十九","author":"释清远","text":"容颜甚奇妙，光明照十方。\n我适曾供养，今复还亲觐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10244,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二十一首 其四","author":"释正觉","text":"沩山水牯牛，禅人聚头咬。\n可怜负舂人，唤作岭南獠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10245,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二十一首 其三","author":"释正觉","text":"我这镰子用得快，当时三十文钱买。\n南泉门下路歧通，寄语行人著精彩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10246,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"假日山行","author":"释正觉","text":"平生胸中云外峰，有閒便与扶瘦筇。\n但知一世丘壑味，想得十分猿鸟从。\n明见秋容山洗雨，清可人意风吟松。\n归来游兴散不尽，谁杵唤月黄昏钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10247,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈十首 其十","author":"释正觉","text":"衲僧巴鼻，圆明绝颣。\n直须推倒，却要扶起。\n玉马饮乾明月泉，泥牛耕破玻璃地。\n披毛戴角异中来，天上人间能几几。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10248,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈十首 其八","author":"释正觉","text":"触目绝对待，万法无不在。\n是汝心不知，非汝心不会。\n不会无不会，不知无不知。\n只个不会知，殊特也大奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10249,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈十首 其六","author":"释正觉","text":"万像之中独露身，唯人自肯乃方亲。\n昔年谬向途中觅，今日观来火里冰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10250,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈十首 其五","author":"释正觉","text":"牢笼不肯住，呼唤不回头。\n古圣不安排，至今无处所。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10251,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈十首 其四","author":"释正觉","text":"心是根，法是尘，两种犹如镜上痕。\n尘垢尽时光始现，心法双忘性即真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10252,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈十首 其三","author":"释正觉","text":"男子身中入正定，女子身中从定起。\n一尘入正受，诸尘三昧起。\n展翅奔腾六合云，抟风鼓荡四溟水。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10253,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈十首 其二","author":"释正觉","text":"万法是心光，诸缘唯性晓。\n本无迷悟人，只要今日了。\n心无形影，对缘即照。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10254,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十八首 其三","author":"释正觉","text":"山云冉冉，江水茫茫。\n正不居位，偏不涉傍。\n显而不露，隐而弥彰。\n猿啼古木音声急，鹤宿枯松梦寐长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10255,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十八首 其六十九","author":"释正觉","text":"云无心而自闲，天无际而能宽。\n道无像而普应，神无虑而常安。\n随之也不见去吊，迎之也不见来端。\n一藏教祇成赞叹，三世佛止可傍观。\n烛晓堂虚，织妇转机梭路细。\n水明夜静，渔老拥蓑船月寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10256,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十八首 其四十二","author":"释正觉","text":"声色见闻闹浩浩，怡似儿时斗百草。\n两家拈出一般般，相对无言点头笑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10257,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十八首 其二十二","author":"释正觉","text":"性觉妙明，本觉明妙。\n与太虚等量，与物情同道。\n应色应声，随听随眺。\n入三世而非去来，混万缘而无正倒。\n云日低时字雁横，夜蟾落处孤猿叫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10258,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十八首 其五十三","author":"释正觉","text":"道绵绵兮用也不勤，道绵绵兮寂也不灭。\n二乘困堕于空无，众生执迷于分别。\n菩萨区区于进修，诸佛唠唠于演说。\n一句子妙出三乘，一念閒功超万劫。\n水月茫茫兮舟棹闲，雪云冉冉兮路岐绝。\n明明灵灵兮唯己自知，大辩若讷兮大巧若拙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10259,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十八首 其七十八","author":"释正觉","text":"地水火风休假藉，一切不留还脱洒。\n家风廓落等虚空，田地虚明非昼夜。\n鸟道须知举足难，玄机不许丝头挂。\n同中有异异中同，彻底浑沦无缝罅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10260,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十八首 其七十四","author":"释正觉","text":"生灭心尽是寂灭，露柱怀胎底时节。\n寂灭心起是生灭，石女生儿解言说。\n用时万象不盈馀，休处一真无空缺。\n藤枯树倒笑呵呵，依旧清风与明月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10261,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十八首 其二十七","author":"释正觉","text":"藏身须要无踪迹，碧眼胡僧难辨白。\n没踪迹处莫藏身，门门廓达了诸尘。\n独来将谓无俦侣，闹里忽然逢故人。\n柳线含金犹畏冷，梅花破雪已成春。\n阿侬千眼通身是，善应无方处处真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10262,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十八首 其十五","author":"释正觉","text":"青山白云父，白云青山儿。\n白云终日倚，青山总不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10263,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十八首 其三十一","author":"释正觉","text":"一雨一晴，底事分明。\n六尘昏扰，世界峥嵘。\n一心虚泊，万法齐平。\n出得气是你鼻孔，觑得破是你眼睛。\n有缘不是余朋友，无用双眉却弟兄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10264,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十八首 其四十五","author":"释正觉","text":"五月半，农忙乱，插田心是秋成饭。\n却道禾熟不临场，祇么任从风雨烂。\n禅和子，一身了。\n一身两眼对两眼，个中丝发初无间。\n老狐涎尽复何疑，再坐盘中弓落盏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10265,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十八首 其五十一","author":"释正觉","text":"南亩黄云禾弄穟，中洲白雪苇成花。\n归舟恰向其閒过，一棹清风夜到家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10266,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十八首 其五十六","author":"释正觉","text":"直下无窠窟，不用求奇特。\n皓玉本无瑕，雕文丧君德。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10267,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十八首 其九","author":"释正觉","text":"心不自心始是心，眼不见眼始是眼。\n堂堂无影迹，历历绝思惟。\n明满环中，兔怀夜月。\n翠横海上，犀晕秋山。\n直须及尽玄微，始解承当底事。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10268,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十八首 其六十二","author":"释正觉","text":"一二三四五，禾山打鼓金牛舞。\n劈面来时著眼看，全身放下休回互。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10269,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十八首 其七十六","author":"释正觉","text":"赵州四门长开，不碍诸方往来。\n十字街头人大叫，平铺买卖没相猜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10270,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十八首 其六十六","author":"释正觉","text":"一尘具无量刹土，一念超无量劫数。\n一身现无量众生，一体合无量诸佛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10271,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十八首 其四十三","author":"释正觉","text":"碧琉璃色水澄清，紫磨金光身瑩明。\n洗净方知不受垢，释迦老子此时生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10272,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十八首 其六十三","author":"释正觉","text":"活计如今付旧人，版头疏久又还亲。\n星河月与长江混，渺渺清光一色匀。\n底时节，落功勋。\n卧稳须知却转身，转得了来相识么，寒穷面觜黑皴皴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10273,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十八首 其八","author":"释正觉","text":"丙丁童子来求火，南海波斯鼻孔大。\n狤獠舌头会者难，直下而今照得破。\n照得破，没功过。\n知你被底穿，曾与同床卧。\n廉纤脱尽旧时疑，杯影蛇弦留再坐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10274,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十八首","author":"释正觉","text":"黄蘖传来，临际用底，定上座触著关捩。\n廓然一念忘缘，泊尔十方无寄。\n现前不用安排，直下何劳拟议。\n不风流处也风流，有意气时添意气。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10275,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十八首 其六十","author":"释正觉","text":"同中有异，功亡就位。\n异中有同，在位借功。\n一步密移玄路转，全身放下劫壶空。\n隐隐密密，玲玲珑珑。\n记取深云须变豹，自然死水不藏龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10276,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十八首 其三十二","author":"释正觉","text":"即日贵人，旧家富汉。\n兄弟相成，尊宾互换。\n突晓途中眼不开，夜明帘外机旋转。\n骑牛戴帽异中来，百炼真金色不变。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10277,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十八首 其五","author":"释正觉","text":"十五日已前，有口说不得。\n十五日已后，无心却自然。\n正当十五日，云笼无缝袄，花笑不萌枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10278,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十八首 其十九","author":"释正觉","text":"寥寥无异辙，密密去玄功。\n月转芦花岸，水秋吞太空。\n欲识诞生王子父，鹤腾霄汉出银笼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10279,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十八首 其十六","author":"释正觉","text":"当生不生，借光现三十六应。\n当灭不灭，忘照摄千百亿身。\n祇如绝去，来无动静。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10280,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十八首","author":"释正觉","text":"明明百草头，明明祖师意。\n于佗未尝一，于我未赏异。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10281,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十八首 其七十五","author":"释正觉","text":"不是男，不是女。\n不是神，不是鬼。\n不是佛，不是物。\n祇知白云无心，谁辨青山在目。\n夜明识取断蛇珠，潭寒退下苍龙骨。\n等闲掣断紫丝绦，天上人间收不得。\n收不得，底事从来没窠窟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10282,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十八首 其三十三","author":"释正觉","text":"心月孤圆，义天洞晓。\n照中之虚，虚中之照。\n不萌枝上鸟初惺，无影树头春不老。\n垢衣权挂类中来，出门信手拈来草。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10283,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十八首 其五十七","author":"释正觉","text":"本来田地无涯岸，极目寒光成一片。\n消息平沈佛也迷，机轮转侧谁能辨。\n雪山山下拥蓑人，白牛一掣芒绳断。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10284,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十八首 其四十九","author":"释正觉","text":"日照昼，月照夜。\n天清而高，地厚而下。\n不我处者大功，不可逃者至化。\n举起镇州罗卜，酬却庐陵米价。\n阿噜勒继萨婆诃，佳作人可知礼也。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10285,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十八首 其六十五","author":"释正觉","text":"何须更举扬，全体露堂堂。\n湿暑时时雨，薰风阵阵香。\n秧针初透水痕浅，蒲刀欲剪柳丝长。\n双六盘中休喝彩，分明触事恰相当。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10286,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十八首 其一","author":"释正觉","text":"易外家风未兆时，三更黑马上乌鸡。\n而今拨转机轮也，刹刹尘尘更是谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10287,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十八首 其五十八","author":"释正觉","text":"灵苗发种，觉树敷春。\n冷湫湫处却要温和，乾爆爆时还须津润。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10288,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十八首 其六十四","author":"释正觉","text":"万物自有功，当言用极处。\n事存函盖合，理应箭锋柱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10289,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十八首 其十","author":"释正觉","text":"一不是，二不成。\n介然独立，法尔双行。\n柳线渐摇风力嫩，草针齐上烧痕青。\n一点灵光普天地，更嫌何处不分明。\n閒里摸著鼻孔，忙时换却眼睛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10290,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]