":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34016,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"霞外亭二首 其一","author":"刘应时","text":"诗眼眈眈细八荒，小亭徙倚湿山光。\n飞鸿影落遥岑外，兴与飞鸿更渺茫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34017,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"入夜","author":"刘应时","text":"入夜雨声细，小窗灯影寒。\n僻居成懒惰，饱食幸平安。\n时事不复问，旧书时一看。\n欣然会心处，香烬一炉残。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34018,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山行","author":"刘应时","text":"春光淡心目，乘兴聊跻攀。\n颇识造物意，长容我辈閒。\n横拖拄杖去，笑折梅花还。\n彼哉钟鼎乐，不在山林间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34019,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山行","author":"刘应时","text":"瘦藤惭愧肯相携，不怕微茫雪意低。\n晚照荒荒迷远岫，湿云漠漠度前溪。\n虽无酒力禦寒色，且向梅花觅旧题。\n漫说玉堂多胜事，何如丘壑卜幽栖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34020,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山居三首 其三","author":"刘应时","text":"雨湿茅茨暗，日长天气温。\n心閒忘物累，足懒出柴门。\n风静收云脚，山高露月痕。\n儿童展编简，灯火又黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34021,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山居三首 其二","author":"刘应时","text":"小小园林畔，萧萧丛薄间。\n茅檐颇幽隐，竹径自回环。\n犬吠溪头客，日衔窗外山。\n遗编淡相对，身世觉高閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34022,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山居三首 其一","author":"刘应时","text":"行年当耳顺，涉世尚心劳。\n倦矣归三径，皤然愧二毛。\n留诗羞茗供，为客酿松醪。\n晚照横篱落，呼儿课楚骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34023,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"石菖蒲","author":"刘应时","text":"十年梦不到丘壑，清坐喜看寒瘦姿。\n玉立一峰森黛色，虬蟠九节漾风漪。\n涓涓月露欲生处，漠漠溪云未散时。\n却笑轻狂桃李眼，臞仙风韵不能窥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34024,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵范至能寻梅","author":"刘应时","text":"藜杖扶人趁雪乾，玉虹倒影落前滩。\n竹篱短短溪头路，云木荒荒日暮寒。\n每愧清香留我住，苦无佳句与人看。\n孤吟不忍空归去，霜月侵衣兴未阑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34025,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江村","author":"刘应时","text":"前山疑抹黛，多稼欲成黳。\n水满蛙登岸，桥危马蹙蹄。\n风高帆腹壮，雨霁月眉低。\n杖屦投村舍，儿童指旧题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34026,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"耳聋","author":"刘应时","text":"叹昔英豪气，俄成一老翁。\n近年头尽白，今日耳犹聋。\n品位无丞职，是非随晓风。\n难陀能反听，梢境已消融。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34027,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟行","author":"刘应时","text":"小艇出前浦，槐阴覆小桥。\n云垂疑有雨，水稳不通潮。\n山色绿自足，汀花细可描。\n枕书篷底卧，欸乃认归樵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34028,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过田家","author":"刘应时","text":"鸠鸣桑树雨还来，且得农夫笑口开。\n虽曰田畴多再植，定须天气作重梅。\n江鱼欲买全无镪，社酒堪篘旋泼醅。\n更遣儿童炊麦饭，殷勤相劝且徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34029,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"别李簿","author":"刘应时","text":"执手江亭晚，回骖涧谷深。\n碧山衔落照，烟树锁愁心。\n空捣黄金泪，谁知白石音。\n殷勤嘱鱼雁，他日莫浮沉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34030,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杜宇","author":"刘应时","text":"花残叶密过芳春，江北江南烟水昏。\n何处飞来恼归客，小窗梦破正消魂。\n月明声在溪桥侧，雨后人行绿树村。\n啼得崔郎肠欲断，桃花颜色怅何存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34031,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"辛亥长至后二首 其二","author":"刘应时","text":"遥想清台上，已书云物祥。\n自惭身老大，渐喜日舒长。\n芹泮三益友，芸窗一炷香。\n此间无俗物，贫病亦何伤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34032,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"辛亥长至后二首 其一","author":"刘应时","text":"老去惊时序，冬温少冱阴。\n心閒知物理，阳复见天心。\n圣主成郊礼，寰区迓德音。\n病夫思赞善，拥褐发长吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34033,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜坐有感","author":"刘应时","text":"躬耕谷口未为贫，安得生涯似子真。\n平日固知穷有鬼，年来更觉老欺人。\n短檠颇怯蝇头字，蠹简时揩鼠迹尘。\n儿女岂知黄卷乐，苦嫌无补废精神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34034,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨后访田家","author":"刘应时","text":"一雨及时晴又佳，江村农父话諠哗。\n旋炊麦饭非常饱，笑指苗田不用车。\n有眼何曾识朝市，逢人只喜话桑麻。\n此间剩有渔樵地，容我旁边著一家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34035,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"幽居","author":"刘应时","text":"烟重柳腰困，雨肥梅脸皴。\n夜窗无锁钥，晨气湿衣巾。\n日晏犹便睡，犬鸣知有人。\n西家新酿熟，祀灶请比邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34036,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春晴","author":"刘应时","text":"帘幕低垂清昼长，弄晴梅柳拂邻墙。\n春光泼眼何明媚，幽鸟窥人自发扬。\n觅句忍饥贫亦乐，钞书得味老何伤。\n舍南舍北无人到，闭閤时焚一炷香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34037,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春暮","author":"刘应时","text":"愁里青春去，年来白发加。\n细书欺老眼，烂饭惬衰牙。\n宁梦穴中蚁，不疑杯里蛇。\n南窗时隐几，一缕篆烟斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34038,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"独饭","author":"刘应时","text":"云破日将西，村深鸡自啼。\n撑船傍林樾，独饭寓招提。\n山柿淡无味，园蔬嫩可刲。\n满抄云子白，心事愧锄犁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34039,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋夜书怀","author":"刘应时","text":"金行肃物岁功成，银汉西斜夜气清。\n淡月似为吾辈款，短檠深见古人情。\n候虫促织巧能语，露叶堕林微有声。\n自笑何为法天运，祇将心事卜前程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34040,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送张尉至丈亭","author":"刘应时","text":"丈亭亭前暂舣舟，寒涛拍岸江烟收。\n青山空解供望眼，浊酒不能浇别愁。\n春到疏篱梅蕊破，帆归别浦浪花浮。\n分携情绪剪不断，有愧悠悠波上鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34041,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]