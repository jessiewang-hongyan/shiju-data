[{"title":"少算","author":"戴复古","text":"吾生落落果何为，世事纷纷无了期。\n少算人皆嘲我拙，多求我却笑人痴。\n庭花密密疏疏蕊，溪柳长长短短枝。\n万事欲齐齐不得，天机政在不齐时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30874,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"斗山子王深父作石屏记为老夫书其文甚佳采记中语作五诗致谢 其四","author":"戴复古","text":"细读石屏记，堪嗟老病身。\n谁知饥欲死，曷取寿长贫。\n雪片丰年瑞，梅花腊月春。\n今朝一杯酒，谁道是生辰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30875,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"斗山子王深父作石屏记为老夫书其文甚佳采记中语作五诗致谢 其五","author":"戴复古","text":"细读石屏记，多君才思清。\n南山数峰碧，北斗七星明。\n风土钟奇秀，文章到老成。\n待看黄鹄举，唾手取功名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30876,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"斗山子王深父作石屏记为老夫书其文甚佳采记中语作五诗致谢 其二","author":"戴复古","text":"细读石屏记，诚然愧我心。\n兰荪借芳馥，金石假声音。\n俗子方腾谤，朋俦合献箴。\n分为无用物，白发委山林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30877,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"斗山子王深父作石屏记为老夫书其文甚佳采记中语作五诗致谢 其三","author":"戴复古","text":"细读石屏记，寻幽到水涯。\n老人相问答，属意在岩花。\n江海浮天阔，山林去国赊。\n草茅最深处，认作野人家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30878,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"斗山子王深父作石屏记为老夫书其文甚佳采记中语作五诗致谢 其一","author":"戴复古","text":"细读石屏记，临风觉厚颜。\n如何一片石，欲比众名山。\n浪迹江湖上，归身岩壑间。\n渔樵争半席，人笑老痴顽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30879,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"方孚若真□宅堂前池上作淮南小山题咏者甚多见其诗轴次韵","author":"戴复古","text":"妙手能移造化功，壶中幻出九华峰。\n山虽云小能栖凤，水不求深贵有龙。\n事纪淮南千古胜，记成嘉泰八年冬。\n先生不用赋招隐，办了功名访赤松。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30880,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"无为山中郑老家","author":"戴复古","text":"高谈可听用心幽，灼见此翁非俗流。\n鞍马破家还避世，田园得地肯封侯。\n开窗脩竹无由俗，绕屋青山总是秋。\n门外短篱看亦好，黄金菊间碧牵牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30881,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"无为军界上遇太湖赵尉制府禀议","author":"戴复古","text":"解后风尘底，周旋鞍马间。\n三杯送行色，一笑强开颜。\n夜宿煖汤市，晨炊冷水关。\n军前献筹策，第一守光山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30882,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"无策","author":"戴复古","text":"老觉登楼懒，心知涉世疏。\n梦蕉还得鹿，缘木可求鱼。\n晚岁未闻道，平生欠读书。\n行藏两无策，究竟果何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30883,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"月夜怀董叔宏闻其入京未得振","author":"戴复古","text":"酒醒兴未已，诗成吟不休。\n一凉风满座，半夜月明楼。\n老骥思千里，飞鸿阅九州。\n故人何处在，谁作置书邮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30884,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"水陆寺","author":"戴复古","text":"长沙沙上寺，突兀古楼台。\n四面水光合，一边山影来。\n静分僧榻坐，晚趁钓船回。\n明日重相约，前村访早梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30885,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王应求出示蜀中山水障气势甚雄伟李巽岩题其后论其画笔之源流二百馀字","author":"戴复古","text":"妙甚丹青手，能移造化功。\n三川山水国，半幅画图中。\n玉局人何在，铜梁路可通。\n巽岩扛鼎笔，文与画争雄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30886,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王和甫主簿卜地改葬双亲一夕梦到一处风水佳甚及到雁荡罗汉寺后山宛如梦中所见及造圹众石之中独有一穴仅可容双棺孝感如此","author":"戴复古","text":"仇香竭力奉双亲，孝感于天得此坟。\n众石中藏一抔土，来山面对五峰云。\n龟鸾远近参差见，龙虎低昂左右分。\n早见凌云牡丹现，他年朱紫定纷纷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30887,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王深道奏名而归","author":"戴复古","text":"忠言犯时忌，决不中高科。\n一日成名了，诸公属望多。\n还家宁久住，经世欲如何。\n西涧一泓水，行通沧海波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30888,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"见名园荒废有感","author":"戴复古","text":"乔木无留影，残花尚假妍。\n荒池蛙叫噪，破屋燕周旋。\n富贵偏多事，风流得几年。\n墙东有寒士，书种世相传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30889,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"见江东绣衣袁广微","author":"戴复古","text":"宇宙归微数，安危委大臣。\n金门一回首，玉节久临民。\n雅志思行古，清风不受尘。\n洁斋家学旧，用处日如新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30890,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"见赵知道运使","author":"戴复古","text":"饱食武昌鱼，不如归故庐。\n盟鸥还海道，问雁觅家书。\n又把乡人刺，来投使者车。\n东园桃与李，莫使著花疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30891,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"见淮东制帅赵南仲侍郎相待厚甚特送买山钱又欲刊石屏诗置于扬州郡斋话别叙谢","author":"戴复古","text":"如公当向古人求，识面何须万户侯。\n浪说钓鳌游瀚海，真成骑鹤上扬州。\n受恩多处难为别，宿酒醒时始觉愁。\n回首平山堂下路，不堪风雨送归舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30892,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"见曾提刑兼安抚","author":"戴复古","text":"传家学术用如新，风采英英照七闽。\n澄按并开都督府，平反专奉太夫人。\n关河未定心忧国，麾节相仍泽在民。\n闻说青云多故旧，不应久作外台臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30893,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"见湖南绣使陈益甫大著 其一","author":"戴复古","text":"手揽澄清辔，声名汉范滂。\n一台振风采，列郡正权纲。\n衡岳势增重，文星日有光。\n金门虽藐藐，玉节自堂堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30894,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"见湖南绣使陈益甫大著 其二","author":"戴复古","text":"麾节罗群彦，朝廷只数公。\n近民多惠泽，望阙负孤忠。\n星殒京城震，沙移海水通。\n欲知休咎證，无路问苍穹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30895,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"见湖南绣使陈益甫大著 其三","author":"戴复古","text":"敢写散人号，来登君子堂。\n论文才力短，忧世话头长。\n老不堪行路，心思归故乡。\n数行诗后语，夜夜吐光芒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30896,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"长汀寄李使君","author":"戴复古","text":"在处晚禾熟，经今瘴雾消。\n山林无盗贼，道路有歌谣。\n人喜逢丰岁，谁知感圣朝。\n溪桥闲寓目，鱼鸟亦逍遥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30897,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"长沙有感","author":"戴复古","text":"自饮长沙酒，春风几醉醒。\n江波随意绿，山色为谁青。\n鸟好因人好，龟灵不己灵。\n江蓠与杜若，何幸入骚经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30898,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"长沙呈赵东岩运使并简幕中杨唯叔通判诸丈","author":"戴复古","text":"日莫远涂行未休，白头又作长沙游。\n湘江一点不容俗，岳麓四时皆是秋。\n香草汀洲付骚客，红莲幕府聚名流。\n吟边万象写不得，上有风流赵倚楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30899,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"长沙道上","author":"戴复古","text":"诗情满天地，客梦绕潇湘。\n何处桂花发，秋风昨夜香。\n登山犹矍铄，照水见昂藏。\n未了一生事，难禁两鬓霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30900,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"风雨无憀中览镜有感作小诗未有断句适两侄孙携诗卷来","author":"戴复古","text":"览镜忽有感，谁能写我真。\n崚嶒忍饥面，蹭蹬苦吟身。\n风叶飘零夜，雨花狼藉春。\n相过慰牢落，吾族有诗人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30901,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东谷王子文死读其诗文有感","author":"戴复古","text":"东谷今何在，骑鲸去渺茫。\n荆花半零落，岩桂自芬芳。\n议论波澜阔，文章气脉长。\n遗编犹可考，何必计存亡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30902,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东轩","author":"戴复古","text":"东轩亦潇洒，春晚雨晴时。\n喜鹊立门限，飞花落砚池。\n青山解留客，绿竹遍题诗。\n一点归心动，夜来闻子规。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30903,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"代人送别","author":"戴复古","text":"南浦春波碧，东风送客船。\n别君杨柳外，挥泪杏花前。\n粉壁题诗句，金钗当酒钱。\n一声离岸橹，心碎楚江边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30904,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"代书寄韩履善右司赵庶可寺簿 其三","author":"戴复古","text":"闭户生涯薄，忧时念虑长。\n老犹思汗漫，贫已在膏肓。\n弱柳饶春色，幽兰抱国香。\n穷通安我命，一笑且持觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30905,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"代书寄韩履善右司赵庶可寺簿 其一","author":"戴复古","text":"懒不脩书札，将诗问起居。\n升沉元自异，故旧忍相疏。\n学术有馀用，班行不次除。\n功名付公等，世道莫愁予。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30906,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"代书寄韩履善右司赵庶可寺簿 其二","author":"戴复古","text":"涉世几三折，行年近八旬。\n江湖倦游客，天地苦吟身。\n白发可怜老，青云多故人。\n东风虽有力，朽木不逢春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30907,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"冬日移舟入峡避风","author":"戴复古","text":"棹入黄芦浦，惊飞白鹭群。\n霜华浓似雪，水气盛于云。\n市远炭增价，天寒酒策勋。\n同舟有佳士，拥被共论文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30908,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"冬暖","author":"戴复古","text":"天不雨霜雪，朝曦与暮霞。\n江梅迟腊蕊，岩桂更冬花。\n地暖宜为客，时难重忆家。\n楚山当晚眺，归兴逐栖鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30909,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"卢申之正字小酌","author":"戴复古","text":"清境无尘杂，羁怀向此开。\n主人有风度，和我不尘埃。\n倚竹评诗句，拈花泛酒杯。\n出门见明月，客去又招回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30910,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"去年访曾幼卿通判携歌舞者同游凤山仆有歌舞不容人不醉樽前方见董娇娆之句今岁到凤山又辟西隅筑堤种柳新作数亭且欲建藏书阁后堂佳丽皆屏去之矣仆嘉其志又有数语并录之 其二","author":"戴复古","text":"别驾常怀物外心，黄金屡费买山林。\n后堂不肯著歌舞，高阁唯思贮古今。\n几处亭台新结束，一春风雨阻登临。\n野夫昨日闲乘兴，著屐寻诗到柳阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30911,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"古田县行览呈刘无竞","author":"戴复古","text":"客游花县自逍遥，百里风光在两桥。\n语出桑阴鸠妇喜，身穿麦秀雉雏娇。\n青山一任云来去，绿水多为风动摇。\n上下相安长官好，野亭闲坐听民谣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30912,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"史贤良入蜀有锦江诗卷陈谊甚高","author":"戴复古","text":"学道世情薄，论交谊气深。\n谩怀三献玉，肯受四知金。\n万里铜梁道，千篇锦水吟。\n一芹供匕箸，聊寓野人心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30913,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"叶宗裔为令叔求竹山诗 其二","author":"戴复古","text":"一景分明似渭川，竹山堂好以人贤。\n兰亭价为羲之重，岘首名因叔子传。\n紫翠数峰长在眼，琅玕万个欲参天。\n老夫身堕尘埃底，遥挹清风亦洒然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30914,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"叶宗裔为令叔求竹山诗 其一","author":"戴复古","text":"爱竹旧称王子猷，今君异世等风流。\n山中便是清凉国，门下合封潇洒侯。\n有此一堂真可隐，不妨诸侄与同游。\n吟边想像参差绿，许我携琴一到不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30915,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"处世","author":"戴复古","text":"风波境界立身难，处世规模要放宽。\n万事尽从忙里错，一心须向静中安。\n路当平处经行稳，人有常情耐久看。\n直到始终无悔吝，旁生枝叶便多端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30916,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"平江呈毅夫侍郎","author":"戴复古","text":"龙墀射策三千字，未抵胸中十万兵。\n远大无过为将相，文章争似立功名。\n当今天下几豪杰，独数君家两弟兄。\n世事从横人事左，未知何以措升平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30917,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"归后遣书问讯李敷文 其三","author":"戴复古","text":"闻说营新第，无从贺落成。\n门庭山水色，楼阁管弦声。\n海内二三杰，胸中十万兵。\n宁为一区计，不使九州平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30918,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"归后遣书问讯李敷文 其四","author":"戴复古","text":"忆作南州客，归来东海滨。\n尚怀忧世志，忍说在家贫。\n老作山林计，梦随车马尘。\n郁孤台上月，无复照诗人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30919,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"归后遣书问讯李敷文 其一","author":"戴复古","text":"绣斧离章贡，旋闻帅寿沙。\n先生方易节，客子已还家。\n别后仙凡隔，归来道路赊。\n秋风两行字，也胜寄梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30920,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"归后遣书问讯李敷文 其二","author":"戴复古","text":"身退谋家易，时危致主难。\n才能今管乐，人物旧张韩。\n吾国日以小，边疆风正寒。\n平生倚天剑，终待斩楼兰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30921,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"归舟已具李宪楼仓有约盗贼梗道见避乱者可怜 其一","author":"戴复古","text":"岁律又云莫，临风咏式微。\n两台方有约，一棹未成归。\n夜宿三家市，天寒百衲衣。\n豺狼当道路，鸥鹭亦惊飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30922,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"归来二首儿子创小楼以安老者 其一","author":"戴复古","text":"老去知无用，归来得自如。\n几年眠客舍，今日爱吾庐。\n处世无长策，闲时读故书。\n但能营一饱，浑莫问其馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30923,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"归来二首儿子创小楼以安老者 其二","author":"戴复古","text":"破屋不可住，如何著老身。\n喜于乔木下，见此小楼新。\n山好如佳客，吾归作主人。\n摩挲双脚底，无复踏红尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30924,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戊戌冬","author":"戴复古","text":"造化人难测，寒时暖似春。\n蛟龙冬不蛰，雷电夜惊人。\n四海疮痍甚，三边战伐频。\n静中观气数，愁杀草茅臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30925,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"永新宰潘仁叔再约观梅","author":"戴复古","text":"去年忆访潘怀县，樽俎风流主意饶。\n爆竹声中度残岁，华灯影里醉元宵。\n春风又起观梅兴，野客仍烦折简招。\n预想张园寻故事，插花秉烛过溪桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30926,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"永新彭时甫馆仆于玉峰楼龙子崇来话旧","author":"戴复古","text":"暂舣溪头棹，来敲月下门。\n江湖十年别，故旧几人存。\n听雨夜同榻，论心酒一樽。\n不须谈世事，万虑满乾坤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30927,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"汉阳登览呈王中甫使君","author":"戴复古","text":"西州城郭虽然小，江汉规模壮矣哉。\n大别山头观禹迹，楚波亭上望吴台。\n萧萧修竹凤不至，漠漠平沙雁又来。\n五马相邀共登览，欲酬秋兴费诗材。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30928,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"玉山章泉本章氏所居赵昌甫迁居于此章泉之名遂显","author":"戴复古","text":"兹山自开辟，有此一泓泉。\n姓自章而立，名因赵以传。\n源从番水出，地与瑞峰连。\n寄语山中友，临流著数椽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30929,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"生朝对雪张子善有词为寿","author":"戴复古","text":"焚香拜天贶，满眼是瑰琦。\n腊月雪三尺，春风梅数枝。\n登楼忘老态，对酒展秋眉。\n争唱阳春曲，山翁醉不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30930,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"田园吟","author":"戴复古","text":"自古田园活计长，醉敲牛角取宫商。\n催耕啼后新秧绿，锻磨鸣时大麦黄。\n桐树著花茶户富，梅林无实秫田荒。\n狂夫本是农家子，抛却一犁游四方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30931,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"白鹤观","author":"戴复古","text":"荒径行如错，蟠松看转奇。\n鸟声人静处，山色雨晴时。\n赊得溪翁酒，閒寻道士棋。\n个中有佳趣，莫怪下山迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30932,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"石亭野老家","author":"戴复古","text":"野老将余到石亭，先呼小豹出相迎。\n依凭林谷住家稳，奔走儿童见客惊。\n牛豕与人争径路，桑麻绕屋蔽柴荆。\n溪边不合栽桃李，犹恐春风惹世情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30933,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"石屏久游湖海祖妣遂题二句于壁云机番白苧和愁织门掩黄花带恨吟后石屏归祖妣已亡矣续成一律","author":"戴复古","text":"伊昔天边望藁砧，天边鱼雁几浮沉。\n机番白苧和愁织，门掩黄花带恨吟。\n自古诗人皆浪迹，谁知贤妇有关心。\n归来却抱双雏哭，碑刻虽深恨更深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30934,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"石洲遇陈季申话旧","author":"戴复古","text":"绿树挂乌帽，清波照白头。\n合随秋燕去，那作贾胡留。\n红吐槟榔唾，香薰茉莉毬。\n樽前话畴昔，一笑不能休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30935,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"立春后二首 其二","author":"戴复古","text":"东风吹竹屋，无数落梅花。\n冻雀栖檐角，饥乌啄草芽。\n家乡劳夜梦，客路又春华。\n莫讶狂夫醉，西楼酒可赊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30936,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"立春后二首 其一","author":"戴复古","text":"夕望春风至，还经闰月迟。\n梅花丈人行，柳色少年时。\n爱酒常无伴，吟诗近得师。\n离骚变风雅，当效楚臣为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30937,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"会心","author":"戴复古","text":"我本江湖客，来观雁荡奇。\n脚穿灵运履，口诵贯休诗。\n景物与心会，山灵莫我知。\n白云迷去路，临水坐多时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30938,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]