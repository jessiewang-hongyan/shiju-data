[{"title":"闲居即事","author":"郑测","text":"小园风景暮春初，随分优游亦足娱。\n柳似王恭殊濯濯，蝶疑庄叟自蘧蘧。\n浇肠漫进三蕉酒，引睡聊翻数叶书。\n今日始知闲有味，悔从尘土曳长裾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5867,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赏心亭","author":"姜仲谦","text":"楼外青山刮眼明，轩窗当暑更风清。\n地分南北开天险，江泛东西几客程。\n四者难并同盏斝，一之已甚厌戈兵。\n最怜夜夜秦淮月，相伴依然似友生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5868,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"己酉中秋任才仲陈去非会饮岳阳楼上酒半酣高谈大笑行草间出诚一时俊游也为赋之","author":"姜仲谦","text":"岳阳楼高几千尺，俯视洞庭方酒酣。\n万顷波光天上下，两山秋色月东南。\n兴来鸾鹄随行草，夜永鱼龙骇笑谈。\n我欲烦公钓鳌手，尽移云水到松庵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5869,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"思杜亭","author":"姜仲谦","text":"十里松阴古道场，一亭还复枕潇湘。\n诗翁至死忧唐室，野客于今吊耒阳。\n窗户云生山雨集，岩溪花发晓风香。\n不唯临眺添惆怅，自是年来鬓已霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5870,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"长芦寺","author":"姜仲谦","text":"长芦禅刹昔经过，十载重游素发多。\n南去宦情聊尔耳，西来师意竟如何。\n千灯不绝开堂盛，一苇常存济世多。\n我久途穷仗佛力，剩书内叶弭风波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5871,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句","author":"姜仲谦","text":"铜鼓旧俗存，瘴江春色早。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5872,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游百岩","author":"刘师忠","text":"当年匹马度荒村，青眼相逢是此君。\n重到故乡归兴动，一竿风月对何人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5873,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和李处劢题萃清阁","author":"江纬","text":"于嗟道力浅，日恐世缘熟。\n身虽走朝市，梦辄在岩麓。\n归来濯尘缨，筑室浅流瀑。\n檐宿谪仙云，径荒陶令菊。\n吟哦格调古，卫养神气肃。\n遐观狭宇宙，幽讨遍山谷。\n林泉无俗韵，松桧有清馥。\n悠然梦幻身，忍把利名束。\n吾人蕴长才，未肯策高足。\n朅来金溪上，共奏紫芝曲。\n永结忘形交，何须醉?醁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5874,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书中贵人扇","author":"王彦和","text":"天边一线征鸿没，山色浅深墨未匀。\n别浦渔舟待归去，夕阳渡口两三人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5875,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句","author":"颜岐","text":"念昔从学日，同升夫子堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5876,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宁王进史图","author":"陈克","text":"上林风暖脊令飞，玉带花骢侍宴归。\n汗简不知天上事，至尊新纳寿王妃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5877,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"善财参自在天","author":"陈克","text":"善财得法犹儿子，工巧仍参自在天。\n若悟菩提同戏事，不应缚律更枯禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5878,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题赵次张所藏贼头子二首 其一","author":"陈克","text":"扬鞭指点万貔貅，打取卢龙十四州。\n烦君为发禄山冢，看我快饮月氏头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5879,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题赵次张所藏贼头子二首 其二","author":"陈克","text":"龙章凤姿世不乏，束手无奈于此思。\n丹青王会何须尔，颈血淋漓送藁街。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5880,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"画梅花 其一","author":"陈克","text":"溪路模糊半山雪，暗淡寒梅一枝月。\n醉眸无处认冰姿，两袖香风更愁绝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5881,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"画梅花 其二","author":"陈克","text":"长恨飘零如楚云，梦中犹记好精神。\n忽逢冷艳冰绡上，叹息侯家占好春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5882,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"画梅花 其三","author":"陈克","text":"误人吹裂柯亭笛，岂有残英落绮席。\n始信寿阳人写真，不知江南近消息。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5883,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"跋赵朝议江行初雪图","author":"陈克","text":"我本孤舟蓑笠翁，雪厓烟树一生中。\n如今不向江湖去，斗舰旌旗照水红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5884,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪岸图","author":"陈克","text":"大年貌得寒江雪，凫雁沙头野彴微。\n个里有诗谁会得，情知不道一蓑归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5885,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"江南山色","author":"陈克","text":"笔间烟雨漫愁人，不是溪山自在春。\n一段江南好风景，夕阳花坞净无尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5886,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谢曹中甫惠著色山水抺胸","author":"陈克","text":"曹郎富天巧，发思绮纨间。\n规模宝月团，浅淡分眉山。\n丹青缀锦树，金碧罗烟鬟。\n炉峰香自涌，楚云杳难攀。\n政宜林下风，妙想非人寰。\n飘萧河官步，罗抺陵九关。\n我家老孟光，刻画非妖娴。\n绣凤褐颠倒，锦鲸弃榛菅。\n忍将漫汗泽，败此脩连娟。\n缄藏寄书篆，晓梦生斓斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5887,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题赵宜兴万里江山图","author":"陈克","text":"惨淡何人画，飘飖万里心。\n云轻春树暗，日落暮江深。\n细酌渊明酒，仍弹子贱琴。\n知公湖海气，对此益骎骎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5888,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"大年流水绕孤村图","author":"陈克","text":"少游一觉扬州梦，自作清歌自写成。\n流水寒鸦总堪画，细看疑有断肠声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5889,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"唐人画牡丹图二首 其一","author":"陈克","text":"重楼杰阁上烟霞，戟带飘飘护翠华。\n侍女番休春醉著，不知野鹿犯宫花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5890,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"唐人画牡丹图二首 其二","author":"陈克","text":"残红通白及时开，不费君王羯鼓催。\n玉笛重拈天一笑，外边蜂蝶等闲来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5891,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"伯时四骑","author":"陈克","text":"弱毫寸纸有馀地，如见天闲八尺龙。\n坐想时危真致此，两军旗鼓噪西风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5892,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"曹夫人牧羊图","author":"陈克","text":"日长永巷车音细，插竹洒盐纷妒恃。\n美人零落泾水寒，两鬓风鬟一挥涕。\n柔毛??与人群，儿女恩怨徒纷纷。\n洞房那复知许事，但画远牧连空云。\n槲叶飘萧晚风劲，羖䍽相追寒鹊并。\n短童何处沙草深，族走群飞各天性。\n向来鞍马曹将军，文采班班今尚存。\n林下夫人更超绝，新图不作五花文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5893,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"观钱德尝书画","author":"陈克","text":"临池竞赏无心笔，破产新酬没骨花。\n老子眼寒俱不识，劳君煎点入香茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5894,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"奉题董端明渔父醉乡烧香图十六首 渔父七首 其一","author":"陈克","text":"处处晴沙著钓纶，浴凫飞鹭颇相亲。\n谁知夙昔风云会，只似寻常江海人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5895,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"奉题董端明渔父醉乡烧香图十六首 渔父七首 其二","author":"陈克","text":"鲙缕丝丝雪色鱼，碧筒香细引村沽。\n江天此乐谁无分，不问官家乞鉴湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5896,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"奉题董端明渔父醉乡烧香图十六首 渔父七首 其三","author":"陈克","text":"君王猎罢载熊罴，锡壤分茅合霸齐。\n邑有鱼盐太多事，翛然何似钓璜溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5897,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"奉题董端明渔父醉乡烧香图十六首 渔父七首 其四","author":"陈克","text":"倾吴佐越早经纶，朝市风波猛乞身。\n不道五湖春浪急，蓬窗还有捧心人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5898,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"奉题董端明渔父醉乡烧香图十六首 渔父七首 其五","author":"陈克","text":"志和渔隐古仙真，霅水风流见后身。\n蓑笠何须访图画，貂蝉凛凛在麒麟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5899,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"奉题董端明渔父醉乡烧香图十六首 渔父七首 其六","author":"陈克","text":"雷泽田渔翊圣明，射蛟南幸见升平。\n稍分天汉昭回象，更和江湖欸乃声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5900,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"奉题董端明渔父醉乡烧香图十六首 渔父七首 其七","author":"陈克","text":"风烟回首钓鱼台，巾褐从容小殿开。\n自是玉皇香案吏，外边休奏客星来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5901,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"奉题董端明渔父醉乡烧香图十六首 醉乡七首 其一","author":"陈克","text":"醉乡天地谁开辟，光景冲融古到今。\n明月清风一长啸，杯中时见昔人心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5902,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"奉题董端明渔父醉乡烧香图十六首 醉乡七首 其二","author":"陈克","text":"昔人爱酒复能诗，阮籍陶潜盖有之。\n共道尚书兼此兴，超然异代忽同时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5903,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"奉题董端明渔父醉乡烧香图十六首 醉乡七首 其三","author":"陈克","text":"斗酒百篇元祐初，当时流辈已萧疏。\n闭门日饮身强健，得见升平总不如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5904,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"奉题董端明渔父醉乡烧香图十六首 醉乡七首 其四","author":"陈克","text":"子房帷幄赞神谋，晚岁疏封自占留。\n代邸勋劳今绝口，上恩仍与醉乡侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5905,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"奉题董端明渔父醉乡烧香图十六首 醉乡七首 其五","author":"陈克","text":"脱靴神气迥飘飘，平日千钟奉帝尧。\n老子浮沉人不识，酒垆争席奈渔樵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5906,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"奉题董端明渔父醉乡烧香图十六首 醉乡七首 其六","author":"陈克","text":"老瓦盆中旋泼醅，陶然乐圣且衔杯。\n只今痛饮谁能那，宝器恩从天上来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5907,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"奉题董端明渔父醉乡烧香图十六首 醉乡七首 其七","author":"陈克","text":"黄金细字勒杯巡，鱼水恩私晚更亲。\n但得赐田堪种秫，向来浮议不关身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5908,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"奉题董端明渔父醉乡烧香图十六首 烧香二首 其一","author":"陈克","text":"相如绿绮有新声，荀令熏炉非故情。\n曲罢空山满香雾，飘然还上赤霄行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5909,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"奉题董端明渔父醉乡烧香图十六首 烧香二首 其二","author":"陈克","text":"琴心非佛亦非仙，座下弦歌万二千。\n一瓣香中谁会得，要须灵刹散花天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5910,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题叶硕父画卷二首 其一","author":"陈克","text":"扁舟欲向山阴去，端为林泉作此行。\n不独卷中携栗里，还于句里得渊明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5911,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题叶硕父画卷二首 其二","author":"陈克","text":"风烟幻出元晖画，林壑天然硕父诗。\n只似无心云出岫，轮囷萧索更多姿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5912,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题张文潜画帖 其一","author":"陈克","text":"此老从来马如狗，却笑蹇驴难朝天。\n聊尔据鞍犹觅句，想知行处似乘船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5913,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题张文潜画帖 其二","author":"陈克","text":"官曹文书堆满床，愦愦度日孤昼长。\n安得如彼二三子，抱琴挟策置我旁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5914,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"何伯言画","author":"陈克","text":"何子画山心极苦，不画山林画其趣。\n不知此绢厚几许，隐隐深入疑有路。\n去年持此干贵权，数幅得官仍得钱。\n平民常产卖有尽，笔端有产无穷年。\n而今东绢知何数，不为水墨为襦裤。\n我怜何子老更痴，平民皆饱汝独饥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5915,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"三品石","author":"陈克","text":"临春结绮今何在，屹立巉巉终不改。\n可怜江总负君恩，白头仍作北朝臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5916,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"瑞香","author":"陈克","text":"佳人在空谷，双星思银河。\n契阔不有命，盛时岂蹉跎。\n娟娟匡庐秀，如此粲者何。\n香蜜缀红糁，宝薰罩宫罗。\n幽窗下团栾，微风自婆娑。\n寂寥千年初，戢戢逢艾多。\n何阶托方便，百金聘猗傩。\n赤栏青篾舫，丁宁护根窠。\n泥沙亦天幸，扳联入宣和。\n谁令兰蕙徒，憔悴守岩阿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5917,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"九月瑞香盛开","author":"陈克","text":"宣和殿里春风早，红锦薰笼二月时。\n流落人间真善事，九秋霜露却相宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5918,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"代王正平从谏掾乞画凭肩美人扇子二首 其一","author":"陈克","text":"道人已悟孩提事，弃掷泥儿坏纸鸢。\n闻道近来都识破，丹青便面亦轻捐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5919,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"代王正平从谏掾乞画凭肩美人扇子二首 其二","author":"陈克","text":"难陀已幻登伽女，童子犹参苏密多。\n正士逡巡不应受，可能分供病维摩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5920,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游谢乡","author":"陈克","text":"雨里落帆游谢乡，寒声古木共荒凉。\n四山为我洗苍玉，况有故人归上方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5921,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闺情","author":"陈克","text":"壁间卫玠眉目是，膝下枚皋言语真。\n纵使无情似郎主，那能对此不沾巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5922,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"五月菊","author":"陈克","text":"黄菊有本性，霜馀见幽茂。\n名缁喻般若，太史谨占候。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5923,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送僧归天宁万年禅院","author":"陈克","text":"朝天来诣觚棱阙，傍海归寻瀑布峰。\n才大不惭师号美，道高翻讶帝恩重。\n问程行冒江村雨，寄宿吟听水寺钟。\n到日依依赏清景，石桥云月满杉松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5924,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"舍弟书来索近诗","author":"陈克","text":"溪上秋风浊酒杯，白头羞见菊花开。\n夫耕妇馌吾将老，弟劝兄酬子不来。\n霜露终身思建业，云山何处是天台。\n百年怀抱今如此，纵有诗成似七哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5925,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谢疟鬼","author":"陈克","text":"皇天分四时，寒暑代翕张。\n折胶与流金，民生以为常。\n伊坎离何神，为帝司一方。\n如何纵孽鬼，乘时盗阴阳。\n睢盱四五辈，欻东西跳踉。\n诡秘各有名，为人作炎凉。\n或燔以炬火，或吹以鞴囊。\n初噤如立雪，俄赫如探汤。\n炎洲抵阴壑，那得在一床。\n阏伯追实沈，左右分寇攘。\n须臾异冬春，裘扇安可当。\n番休数汗粟，冰炭沸我肠。\n怫郁不自聊，灾疢未渠央。\n非针艾所及，区区事祈禳。\n牺牲一物无，祝祠甚荒唐。\n殷勤谢众鬼，汝计诚未良。\n汝利在呕泄，藜苋焉足尝。\n我贫乏钱财，调汝徒披猖。\n来汝岂不闻，儒生类强梁。\n子美虽老瘦，腼颜事新妆。\n退之稍奸黠，百药更臭香。\n身病易语言，咄咄多谤伤。\n吾将援此例，勉作新诗章。\n诗以荣汝归，自可捐糗粮。\n资送于汝足，此外何所望。\n汝也宁不惭，急急去我旁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5926,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"阳羡春歌","author":"陈克","text":"石亭梅花落如积，吐鲛斓斑竹茹赤。\n祝陵有酒清若空，煮糯蒸鱼作寒食。\n长桥新晴好天气，两市儿郎棹船戏。\n溪头饶鼓狂杀侬，青盖红裙偶相值。\n风光何处最可怜，邵家高楼白日边。\n楼下游人颜色喜，溪南黄帽应羞死。\n三月未有二月残，灵龟可信渰水乾。\n葑草青青促归去，短萧横笛说明年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5927,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寿张教授","author":"陈克","text":"玉府多应惜谪仙，紫皇留恋到残年。\n画眉京溜风流在，借箸先生节概全。\n禄比书辞增百万，寿如门弟及三千。\n互乡不解华祝封，只诵天长地久篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5928,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游善权山留题三首 其一 乾洞","author":"陈克","text":"神仙何时开，中虚仰萦盘。\n呀然九地低，怪此天壤宽。\n窈窅辟琼户，璁珑缀珠鬘。\n阴道差险绝，真形谢雕剜。\n阆风安在哉，突兀浮云端。\n天高鬼神恶，欲往良独难。\n空飞遽未暇，穴处如何安。\n相将三重茅，势面玄都坛。\n仙田满嘉植，玉彩长阑干。\n心空腹自实，宁计米盐残。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5929,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游善权山留题三首 其二 水洞","author":"陈克","text":"逶迤步哀壑，局蹐生微澜。\n惨惨白日暮，萧萧朱夏寒。\n崖倾势方壮，石出水益湍。\n淙流响磬瑟，突起横镆干。\n微踪乍渺茫，妙想忺盘桓。\n我今人世间，所向行路难。\n如何洞宫脚，危磴仍屈蟠。\n神伤阻独往，发竖两股酸。\n了知仙凡隔，坐惜岁月残。\n心违泪交堕，已去犹长叹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5930,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游善权山留题三首 其三 寺后湫水","author":"陈克","text":"冈峦谁穿空，脉液互吞吐。\n凭虚倚翠岩，发地涵潼乳。\n哀弦响崖寺，清镜照林坞。\n萦坻骤曲折，啮石犹飞舞。\n津涯浩无穷，神怪传自古。\n参差见坤轴，晃荡连水府。\n微生寄荒绝，多病厌咸苦。\n永怀宅清泠，戮力事农圃。\n青秧渐出水，紫笋新过雨。\n无惭种秫陶，更似煎茶羽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5931,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"返魂梅次苏藉韵 其一","author":"陈克","text":"谁道春归无觅处，眠斋香雾作春昏。\n君诗似说江南信，试与梅花招断魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5932,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"返魂梅次苏藉韵 其二","author":"陈克","text":"花开莫奏伤心曲，花落休矜称面妆。\n只忆梦为蝴蝶去，香云密处有春光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5933,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"返魂梅次苏藉韵 其三","author":"陈克","text":"老夫粥后惟耽睡，灰暖香浓百念消。\n不学朱门贵公子，鸭炉烟里逞风标。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5934,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]