[{"title":"挽谢次安二首 其二","author":"吴芾","text":"场屋声名久，簪绅誉望优。\n心虽驰北阙，化止被南州。\n缅想生无憾，犹怜志未酬。\n庭阶有兰玉，身后复何忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44052,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽谢次安二首 其一","author":"吴芾","text":"耆旧今无几，乡闾素所依。\n官登五马贵，年及七旬稀。\n一旦成长往，九原谁与归。\n寒风吹画翣，回首泪空挥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44053,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽楼枢密二首 其二","author":"吴芾","text":"忆昔登龙日，从容接胜游。\n轩窗临绿野，尊俎俯清流。\n尚欲荣花坞，那知负钓舟。\n新阡何处是，极目暮云愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44054,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽楼枢密二首 其一","author":"吴芾","text":"耆旧凋零久，惟公作世程。\n险夷全一节，终始保荣名。\n二府勋庸著，三州政绩成。\n十连方倚重，何遽掩佳城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44055,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽翟伯寿二首 其二","author":"吴芾","text":"少日为僚古乐成，一时共喜得豪英。\n盍簪便有功名志，倾盖曾无世俗情。\n回想旧游如昨梦，顿成尘迹负平生。\n故人倒指彫零尽，矫首佳城泪欲倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44056,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽翟伯寿二首 其一","author":"吴芾","text":"高情爽气薄云天，洒落真如晋七贤。\n笔下虫鱼元自得，胸中丘壑更依然。\n风流已足追千载，寿考胡为不百年。\n人物此时谁得似，祇应馀庆尚流传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44057,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"爱梅","author":"吴芾","text":"经年不得见江梅，绕树行行日几回。\n已拟开时拚径醉，其如病后怯衔杯。\n伤心不觉成三叹，忍泪犹能强一来。\n顾我已衰无酒分，从今花更不须开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44058,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病中再继前韵书怀","author":"吴芾","text":"暌违行十日，日抱负薪忧。\n已疾无良药，呼医到别州。\n不堪当剧暑，渐喜近新秋。\n痛定因追念，从生若缀旒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44059,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病起泛舟呈诸亲友","author":"吴芾","text":"屏迹山间岁月深，四围绿树总成阴。\n已欣丛竹生湖岸，更爱双莲出水心。\n倚杖顿惊明老眼，舣舟还喜豁烦襟。\n病馀虽是无佳思，乘兴何妨试一吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44060,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"耿曼老自去秋起归兴以被旨救荒方有行色来告别伤成数语送之","author":"吴芾","text":"去秋已作送君诗，岂意淹留复许时。\n端为九重忧岁歉，故令六辔缓归期。\n万人全活俱安业，二麦收成足疗饥。\n此事一归君妙画，阴功当自有天知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44061,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读丐辞不允诏书感而有作 其一","author":"吴芾","text":"朅来江上再经年，衰病无时强自怜。\n屡控危衷甘屏缩，岂期优诏更留连。\n政平讼理曾何补，职称民安亦偶然。\n虽感上恩容卧治，何如便许老林泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44062,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读丐辞不允诏书感而有作 其二","author":"吴芾","text":"齿豁头童已暮年，未容归去亦堪怜。\n只思旧隐如元亮，宁有新诗似惠连。\n万事此生浑已矣，一尊今日且陶然。\n宦情况复清如水，何必移封向酒泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44063,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陪任漕胡仓登滕王阁秋屏列岫","author":"吴芾","text":"滕阁秋屏已快哉，更登列岫少徘徊。\n溶溶一水檐前去，隐隐千帆坐上来。\n每恨长年成契阔，颇欣今日得追陪。\n能并四乐由来少，且对江山举一杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44064,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"假山","author":"吴芾","text":"我爱青山欲细看，如何不在户庭间。\n聊移野外玲珑石，来作窗前重叠山。\n拄笏已堪供啸咏，杖藜还更得跻攀。\n莫言道院过从少，亦有修眉相伴闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44065,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶苦耳聋","author":"吴芾","text":"衰年已是病双瞳，那更新添两耳聋。\n山外钟声元不到，窗前鸡唱亦难通。\n便遭谤骂安能累，纵有笙歌也是空。\n每恨肚皮从旧窄，而今却做得家翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44066,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶得数琉璃瓶置窗几间因取小鱼漾其中乃见其浮游自适感而有作","author":"吴芾","text":"方安林下乐樵渔，底事牵来剖竹符。\n道院固知人少讼，丰年何幸俗多娱。\n闲随野鹤穿花径，静看游鱼戏玉壶。\n却愧此身犹束缚，未能归去老江湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44067,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄四二侄","author":"吴芾","text":"书来言旧隐，湖上足烟光。\n树密交青荫，花繁溢暗香。\n红尘飞不入，绿水去何长。\n回首千山隔，归心欲发狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44068,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄刘汝一陈天予","author":"吴芾","text":"昔年言路记同游，回首那知岁月流。\n已叹数公随物化，却欣二老与余留。\n去天不谓踰三岁，补外那知尚一州。\n想得赐环俱在即，不应似我老林丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44069,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄江朝宗","author":"吴芾","text":"君来已是后花期，不见春风烂熳时。\n槛外止馀新芍药，檐前祇有旧酴醾。\n尚堪共泛忘忧酒，亦可同吟遣兴诗。\n倒指春归能几日，速来相就赏残枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44070,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄江朝宗","author":"吴芾","text":"自遣迎君骑，期君指日来。\n胡为多坎坷，欲动却迟回。\n望眼凝还断，愁怀郁不开。\n相过须及早，莫待折寒梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44071,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄江朝宗","author":"吴芾","text":"相聚才经岁，分携又许时。\n遣怀还有酒，排闷岂无诗。\n饮罢凭谁语，吟成祇自知。\n愿君怜此意，命驾莫迟迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44072,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄李彦平","author":"吴芾","text":"日伫高轩过，从容慰别离。\n已乖桂子约，还失菊花期。\n正尔思一面，忽然掀两眉。\n闻君有召节，平步上丹墀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44073,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄杨次云岸长老","author":"吴芾","text":"高僧良士总贪閒，虽我同庚不往还。\n诗罢谁知勤治圃，斋馀无事只潜山。\n亦闻相约来倾盖，久待如何未叩关。\n湖上藕花今正发，不妨共戏水云间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44074,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄陈叔进","author":"吴芾","text":"乡里衣冠久不振，后来犹喜有斯人。\n曾为蓬岛神仙主，端是储闱羽翼臣。\n大节已观能直己，小淹何惜且临民。\n君家幸有佳山水，莫向他乡别卜邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44075,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄陈彦邦二首 其二","author":"吴芾","text":"不须细细说行藏，四十年来梦一场。\n我得放归心已足，君能勇退道尤光。\n閒中倍觉林泉好，闹里谁知日月长。\n我已与君成二老，更将一节起吾乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44076,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄陈彦邦二首 其一","author":"吴芾","text":"自古中兴用实才，正资贤哲共图回。\n若为清禁挽不住，亦效衰翁归去来。\n幸有江水供笑傲，更邀风月与徘徊。\n得閒莫惜频相过，伴我樽前笑口开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44077,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄周子及","author":"吴芾","text":"回头一别两经秋，喜奉安舆返故丘。\n自谓此时须见过，谁知官事不容留。\n君游幕府声猷著，我住湖山景趣幽。\n出处虽殊心不异，迂程能为一来不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44078,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄周表卿","author":"吴芾","text":"别来星纪两周天，梦想风标每慨然。\n靖退喜公今就第，奔驰愧我未归田。\n得闲正好哦诗句，乘兴何妨棹酒船。\n颇恨路长还病暑，无由一见话当年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44079,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄赵德庄","author":"吴芾","text":"故人分袂几何年，不谓乘轺到海边。\n我守丘园甘已矣，君驰原隰尚依然。\n有怀风月空相忆，无计杯觞可共传。\n出处不齐徒怅望，夕阳衰草自连天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44080,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄鲁漕","author":"吴芾","text":"四海耆英世共知，七旬强健似公稀。\n使星姑暂淹黄发，卿月还须近紫微。\n门外埙篪方合奏，庭前兰玉更相辉。\n人生乐事谁能及，莫惜通宵寿斝飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44081,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题鲁郎中遂隐堂","author":"吴芾","text":"老向江头强剖符，梦魂长是绕吾庐。\n正惭我未成归计，却羡君先遂隐居。\n湖上烟云常缥缈，园中花木总扶疏。\n他时尚冀相从醉，剩把鸱夷载后车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44082,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"巢内燕园中鹿俱生子喜而有作","author":"吴芾","text":"倦似渊明懒似嵇，归来聊向此中栖。\n湖山围绕吾庐静，草树高低野望迷。\n燕葺新巢方乳子，鹿游故苑又生麛。\n眼前景物俱堪赋，落日何妨一杖藜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44083,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"得三七侄书说湖山佳趣因以书中语成四韵","author":"吴芾","text":"今日家书到，从头说故丘。\n园林增茂密，池馆愈清幽。\n嫩竹已千个，新莲仅万头。\n欲归归未得，长是梦中游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44084,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"得三七舍侄书云二月二十五日同族人至湖山赏海棠花枝繁丽宛如神仙窟宅感而有作","author":"吴芾","text":"报言宗族竞寻芳，共到吾庐赏海棠。\n亭下定知春烂熳，花间想见醉淋浪。\n长年心著神仙窟，此日身縻云水乡。\n苦恨欲归无羽翼，夜深魂梦只悠飏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44085,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清明登白纻山","author":"吴芾","text":"偷得铃斋半日閒，喜逢佳节漫追攀。\n扶衰强策青藜杖，寻胜聊登白纻山。\n远岫千重云出没，清溪一带水回环。\n我来恨未穷游览，回首孤城落照间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44086,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"黄超然参议和拙者去郡十五绝又以诗见寄属痰眩未能一一次韵且和二篇以谢 其二","author":"吴芾","text":"向来从宦郑公乡，每遇清游坐有光。\n江上凭栏天一色，湖边舣棹木千章。\n眼前景物俱堪赋，心著家山独未忘。\n归到小西湖更好，观鱼何必远如棠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44087,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"黄超然参议和拙者去郡十五绝又以诗见寄属痰眩未能一一次韵且和二篇以谢 其一","author":"吴芾","text":"三复诗翁白雪篇，渴尘俄得醉心泉。\n高人固已追摩诘，好句还应压玉川。\n快似凉风来木末，清如皓月出云边。\n呼儿好为藏巾笥，莫许闲人取次传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44088,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"龚帅以久别寄诗远惠因次其韵 其一","author":"吴芾","text":"性便野服厌朝裾，一意归休学二疏。\n门外浑无俗士驾，案头惟有道家书。\n胜游但欲寻蓬岛，旧事那能记石渠。\n亦拟冥搜酬绝唱，惭将瓦砾报琼琚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44089,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"龚漕见示游山唱和诗卷用其首章和二篇 其二","author":"吴芾","text":"尘埃终日满华颠，忽见新诗堕我前。\n溢目众篇虽杰出，惊人逸思独飘然。\n秀如松桧枝枝老，好似珠玑颗颗圆。\n自此得闻清庙瑟，懒从滩上听师涓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44090,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"龚漕见示游山唱和诗卷用其首章和二篇 其一","author":"吴芾","text":"说著登临喜欲颠，正惭拘俗未能前。\n羡君领客同游去，使我闻风亦豁然。\n已叹高怀能放旷，还欣佳句更清圆。\n如今便蜡寻山屐，夙驾何须吉日涓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44091,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜入冬初七八得雨","author":"吴芾","text":"夏旱连秋又及冬，大田高下总成空。\n千仓已失三农望，一雨欣闻百里同。\n青入平畴看麦秀，绿回枯沼喜泉通。\n从今得免填沟壑，皆谢天公惠困穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44092,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜雨","author":"吴芾","text":"闻道他邦尽祷祈，沛然膏泽尚迟迟。\n有年已是天私我，连日那堪雨及时。\n声入万家添喜气，凉生千里解炎曦。\n也知造物恩难报，且采欢谣缀小诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44093,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜雪 其三","author":"吴芾","text":"冻云黯淡浩无涯，雪阵横空势欲斜。\n入户有人疑柳絮，绕园无处认梅花。\n举头顿觉青山老，扑面还惊绿鬓华。\n我醉未眠愁酒尽，挈瓶来问尔东家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44094,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜雪 其一","author":"吴芾","text":"糁遍山巅与水涯，天公着意做年华。\n要令腊里呈三白，时向空中散六花。\n勒住玉梅还可恨，妆成琼树却堪誇。\n须知造物忧民切，预把丰穰报万家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44095,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜雪 其二","author":"吴芾","text":"雪意初疑作不成，才飞数片又还晴。\n正思润泽沾千里，忽见缤纷满一城。\n凋郡共欣消沴气，老农相庆沸欢声。\n我将尽把姑溪酿，要与邦人乐太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44096,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜晴 其一","author":"吴芾","text":"积阴初散雨初收，一解霖霪十日忧。\n已见郡条平似水，不妨官舍冷如秋。\n年来触绪无佳思，老去同僚得胜流。\n更喜丰年消息好，从今还遂稻粱谋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44097,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜晴 其二","author":"吴芾","text":"久雨无聊喜乍晴，尚馀春色到檐楹。\n杨花飞去今无力，燕子归来似有情。\n静看游鱼波面跃，闲随野鹤竹间行。\n世缘到此消磨尽，只欲徜徉度此生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44098,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"曾元伯以余七十用韵见庆复和之","author":"吴芾","text":"迂疏如我世间稀，自笑于时百不宜。\n但欲平生无鬼责，岂期长命有天知。\n七旬虽慰白司马，三黜空惭柳士师。\n多谢君诗远相庆，一披顿解老人颐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44099,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游朱氏园","author":"吴芾","text":"萋萋芳草遍池塘，叹惜韶华一半强。\n闻道名园千亩胜，来看浪蕊万枝芳。\n浑疑席上红裙拥，未让阶前绮帐张。\n坐客径须拚痛饮，要将一醉答春光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44100,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游金山二首 其二","author":"吴芾","text":"欲向南昌去，先为北固行。\n泛舟游寺古，倚槛看江清。\n久作市朝客，喜闻钟磬声。\n登临曾未竟，已足快平生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44101,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游金山二首 其一","author":"吴芾","text":"造物分南北，长江欲尽头。\n有山浮碧玉，亘古屹中流。\n万顷涵空月，千帆破浪舟。\n羡他云水客，长此占清幽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44102,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游荆山寺","author":"吴芾","text":"道左逢幽寺，巍然气象新。\n泉声长绕舍，山色欲侵人。\n疏牖时穿竹，虚堂不染尘。\n老僧仍好事，不厌客来频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44103,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游鹿田三洞","author":"吴芾","text":"野性平生酷爱山，好山不厌绝跻攀。\n感时又见三春暮，乘兴聊同一日闲。\n云出岫时迷古洞，鹿耕田处认禅关。\n自怜扰扰尘埃里，眼底欣逢水石环。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44104,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游臞庵","author":"吴芾","text":"松江桥畔阚名园，一别重游二十年。\n种德堂前松菊茂，浮天阁下水云连。\n同来朋旧今谁在，独去情怀祇自怜。\n若许拂衣从此逝，不妨长泛钓鱼船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44105,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湖上遣兴","author":"吴芾","text":"閒来湖上觅清凉，竹杖芒鞋野兴长。\n青嶂回环如洞府，绿波澄澈似沧浪。\n枝头落絮随风急，水面浮鱼逐饵忙。\n自笑衰翁无个事，悠然身世两相忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44106,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登列岫","author":"吴芾","text":"此邦已是富烟光，那更斯亭冠此邦。\n正向座中窥列岫，恰从檐下瞰长江。\n闲穿松径云生屧，宴坐蒲团月满窗。\n想得山人应笑我，老来强拥碧油幢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44107,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登卧龙山","author":"吴芾","text":"岿然千古卧龙山，节物年来□旧观。\n犹有楼台出天半，正令星斗逼人寒。\n春风偶种花千树，夏日仍栽竹万竿。\n自愧牧民无实□，漫留佳致后来看。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44108,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登南楼二首 其二","author":"吴芾","text":"新敞南楼百尺雄，一溪遥跨两长虹。\n青山叠叠登临外，碧瓦鳞鳞指顾中。\n倦客自怜如倦翼，归心长是逐归鸿。\n凭高幸与宾僚共，酒盏何妨为我空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44109,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登南楼二首 其一","author":"吴芾","text":"人生安用惹閒愁，得暇何妨且少休。\n睡起径须烹北苑，兴来聊复上南楼。\n公庭渐觉日无事，田里仍逢岁有秋。\n满目江山还可乐，归心已动不容留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44110,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登景星岩","author":"吴芾","text":"道满三千界，潮音未许缄。\n何为狮子座，却上景星岩。\n天近云随步，林深翠滴衫。\n我来宁惮远，端欲洗尘凡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44111,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"联句题吉祥寺","author":"吴芾","text":"系舟枯柳岸，穷胜古城阴。\n松径云生屧，竹窗风满襟。\n不妨情话好，且放酒杯深。\n杖履寻归路，西山日未沈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44112,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢子肃任昆山丞和余留题旧游诗复次韵谢之","author":"吴芾","text":"故乡春好阻同游，谁与花前倒玉舟。\n陈迹未能忘茂苑，新诗俄喜寄丹丘。\n开缄已慰三年别，展诵还消万斛愁。\n文行如君今日少，蓝田宁许久淹留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44113,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢钱参惠驴","author":"吴芾","text":"白发衰翁七十馀，尚劳轸记特驰书。\n知无仙骨能骑鹤，喜有残骸可跨驴。\n厩下分来齐骏驷，林间乘去胜巾车。\n更烦拈出荆申事，遐想风流愧莫如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44114,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赏梅偶成","author":"吴芾","text":"一冬准拟赏江梅，直至如今始见开。\n已怪轻寒勒春住，更忧横雨把花摧。\n相携且看枝头雪，共坐聊倾树下杯。\n况是公庭无个事，何妨一醉习池回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44115,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]