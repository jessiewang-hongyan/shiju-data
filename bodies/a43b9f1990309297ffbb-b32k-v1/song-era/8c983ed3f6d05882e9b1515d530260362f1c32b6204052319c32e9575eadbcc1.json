5f84d192fe5294295f79689","path":"宋_2.csv","pointer":26329,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春贴子词 皇太后阁六首 其三","author":"周麟之","text":"晓箭催莲漏，君王问寝时。\n光风浮玉琯，瑞霭映云旗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26330,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春贴子词 皇太后阁六首 其二","author":"周麟之","text":"绕殿猗兰紫，浮觞寿柏青。\n瑶池演春算，倍受八千龄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26331,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春贴子词 皇太后阁六首 其一","author":"周麟之","text":"北极璿杓转，东朝绣户开。\n吾皇宴长乐，亲捧万年杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26332,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"破虏凯歌二十四首 其二十四","author":"周麟之","text":"江上春风凤盖旋，郁葱佳气霭中天。\n从今四海归图籍，金殿垂衣亿万年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26333,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"破虏凯歌二十四首 其二十三","author":"周麟之","text":"此日君王自抚师，列营争望翠华旗。\n不失一矢戎酋毙，又胜澶渊却敌时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26334,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"破虏凯歌二十四首 其二十二","author":"周麟之","text":"中兴天子汉宣光，自有深仁合彼苍。\n天遣百灵争助顺，神兵遍野拂云长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26335,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"破虏凯歌二十四首 其二十一","author":"周麟之","text":"胜负端从曲直分，我军屡捷气凌云。\n坐听笳鼓传新曲，不怕蕃家铁塔军。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26336,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"破虏凯歌二十四首 其二十","author":"周麟之","text":"昨从北邙山下过，旋移狼纛驻鸡笼。\n此身已是邻尸冢，又欲飞投鼎镬中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26337,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"破虏凯歌二十四首 其十九","author":"周麟之","text":"似闻虏帐启行初，尽拥青毡入故都。\n便好乘机收赤县，长缨更缚北单于。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26338,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"破虏凯歌二十四首 其十八","author":"周麟之","text":"曾为兵卜溷神听，不信名山事火攻。\n今日汝魂游岱去，不知何面向灵宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26339,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"破虏凯歌二十四首 其十七","author":"周麟之","text":"向来烧饭起中都，已觉胡星堕玉除。\n罪恶贯盈天不赦，区区犹欲祷医闾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26340,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"破虏凯歌二十四首 其十六","author":"周麟之","text":"每率群胡共打围，防奸惟许属鞬随。\n一朝醉卧隋堤曲，众箭攒胸死不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26341,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"破虏凯歌二十四首 其十五","author":"周麟之","text":"也学赋诗横槊公，浪抛狂语倡群凶。\n由来立马元无地，空指吴山第一峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26342,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"破虏凯歌二十四首 其十四","author":"周麟之","text":"何事图形到九墀，岂容鬼质近神奎。\n君王欲作诸戎戒，不惜云章手自题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26343,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"破虏凯歌二十四首 其十三","author":"周麟之","text":"黧面长须桀黠儿，一生浑事杀人嬉。\n莫将遗像欺群目，曾向贞元殿里窥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26344,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"破虏凯歌二十四首 其十二","author":"周麟之","text":"自闻三策日垂涎，急趁西风一举鞭。\n狼子不知天数尽，据鞍犹说马儿年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26345,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"破虏凯歌二十四首 其十一","author":"周麟之","text":"只凭信誓画山河，二十馀年两国和。\n解道渝盟甘踣国，若为轻信马韩哥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26346,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"破虏凯歌二十四首 其十","author":"周麟之","text":"七宝为床坐殿衙，金猊双立喷飞霞。\n自缘积恶难安享，不得全躯作帝羓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26347,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"破虏凯歌二十四首 其九","author":"周麟之","text":"燕山台殿压阿房，又欲移巢占大梁。\n起就汉宫三十六，固知无德祇为殃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26348,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"破虏凯歌二十四首 其八","author":"周麟之","text":"自古御行用众难，况图深入冒多艰。\n五百万人存者几，淮南白骨委如山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26349,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"破虏凯歌二十四首 其七","author":"周麟之","text":"淝河席捲苻坚阵，赤壁灰飞孟德舟。\n二虏犹能脱身去，汝来断送郅支头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26350,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"破虏凯歌二十四首 其六","author":"周麟之","text":"胡人不识九车船，笑理轻舠狎大川。\n莫道老胡曾得济，犹传折箭誓青天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26351,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"破虏凯歌二十四首 其五","author":"周麟之","text":"虏饿曾无一月粮，煮弦烧箭莫充肠。\n南来本恃清河粟，不意偏师夜绝纲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26352,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"破虏凯歌二十四首 其四","author":"周麟之","text":"一从犬吠瞰西山，便报车轮不得还。\n自诡长驱如破竹，不知先衄剑门关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26353,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"破虏凯歌二十四首 其三","author":"周麟之","text":"云航飞下北通州，弭楫胶西一战收。\n千七百艘同日尽，始知飞将有奇谋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26354,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"破虏凯歌二十四首 其二","author":"周麟之","text":"采石江头万鼓鼙，祭天台上手挥旗。\n坐驱朔马为鱼鳖，笑杀江南踏浪儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26355,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]