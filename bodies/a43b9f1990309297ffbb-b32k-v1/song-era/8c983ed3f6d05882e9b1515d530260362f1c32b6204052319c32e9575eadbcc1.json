[{"title":"西湖三首 其二","author":"周锷","text":"使君修禊与民游，十里笙歌水面浮。\n动地雄风云外起，截天雌霓雨中收。\n登台已有难并乐，击壤宁无寡和忧。\n却忆内家新赐火，海棠无数出墙头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26282,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西湖三首 其一","author":"周锷","text":"晓镜初开淑景明，使君风味一般清。\n舟从菡萏林中过，人在鲸鲵背上行。\n妙舞屡翻红药燕，清词时啭紫薇莺。\n赓歌久矣虚前席，肯向樽前恋曲生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26283,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和郡守彭吏部按视湖亭凡二首 其二","author":"周锷","text":"双虹倒影上檐楹，碧水澄空一镜明。\n野草闲花无限趣，短藜幽榜不胜情。\n已知风月随人意，聊为湖山载酒行。\n却讶锦囊赓梦草，坐令诗兴绕寰瀛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26284,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和郡守彭吏部按视湖亭凡二首 其一","author":"周锷","text":"使君风味压荆州，每为吾民乐更忧。\n锦里篇章推唱首，浣溪光景促遨头。\n行春预约花攲帽，把酒方欣雪点裘。\n岳史年来惭吏隐，扳舆时得从公游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26285,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"澄辉阁","author":"周锷","text":"雄建俯空阔，下瞻霄汉浮。\n眼将云漠漠，心寄水悠悠。\n日暖鸟飞镜，月凉鱼弄钩。\n行期分此景，家在甬西头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26286,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题清斯堂","author":"周锷","text":"万物本空寂，浮生方沼中。\n鸥轻时出没，萍散只西东。\n槛外风初息，天边月正融。\n了无尘可濯，危坐照衰翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26287,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游香山佛迹","author":"周锷","text":"灵山名达蓬，香水霭薝卜。\n龙祇久覆护，云物翳深谷。\n拂衣向劫中，神斧断苍玉。\n至今天人尊，灵迹印金粟。\n颇闻开士谶，飞锡隐岩麓。\n坐令湖海客，香供走川陆。\n巍巍虔报地，色相俨金屋。\n缅想旧巾瓶，犹能慰心目。\n篮舆访莲社，一笑欣自足。\n抚事动幽寻，畴能念荣辱。\n松炉袅如见，馀力付棋局。\n更觉梦中身，翛然百无欲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26288,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送水云归吴","author":"周静真","text":"燕山雪花大如席，马上吟诗无纸笔。\n他时若遇陇头人，折寄梅枝须一一。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26289,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"大观堂","author":"周德辉","text":"披襟渺无际，一笑碧云头。\n千里当眉睫，何须更上楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26290,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"磨崖碑 其一","author":"周缮","text":"贤才思述作，崖石尚磨砻。\n元才词华丽，颜公笔迹雄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26291,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"磨崖碑 其二","author":"周缮","text":"笔迹因难泯，词华讵可磨。\n二贤名不朽，千古著山阿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26292,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春月劝农至华林寺","author":"周震","text":"飞廉怒息海天明，十里篮舆出劝耕。\n陇麦低头须雨意，林花仰面笑春晴。\n熙寮连辔勤因事，父老传杯识至情。\n及物无功惭窃廪，丰年有愿是忠诚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26293,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"祗园寺","author":"倪祖常","text":"梵王宫殿有仙家，曾此瑶觞醉碧霞。\n雨过石坛寒象纬，风来祇寺委龙蛇。\n经翻贝叶相腾瑞，饭熟青精味胜麻。\n昨日老僧谈妙法，缤纷犹自坠天花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26294,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"柱笏轩","author":"周操","text":"未偶凶渠那便击，已逢昭代不须还。\n子猷老去身无用，拄颊朝来稳看山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26295,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"定林寺","author":"周燔","text":"定岩坐听松声好，德水行穿竹影斜。\n无限世间幽绝处，天工分付与僧家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26296,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与孙氏","author":"周默","text":"五十衰翁二十妻，目昏发白已头低。\n绛帏深处休论议，天外青鸾伴木鸡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26297,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"大云洞","author":"周燮","text":"西出州城五里馀，大云仙洞最清虚。\n近来选得禅师住，是处精蓝尽不如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26298,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏","author":"周翼之","text":"入夏庭中雀可罗，閒僧閒客间相过。\n莺声不得蛙声接，杨柳池塘寂寞多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26299,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西里翁宅","author":"周翼之","text":"诗人风致别，卜筑寓烟霞。\n一圃分三径，无时不有花。\n苔痕留鹤迹，松色在檐牙。\n细酌北窗下，逶迤到日斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26300,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"京口江亭","author":"周翼之","text":"不忍凭阑久，边愁随望生。\n如何万马壮，不比一江横。\n落日明金屿，高风撼铁城。\n寒涛触沙渚，天意苦难平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26301,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春雨","author":"周翼之","text":"青阳播物时，云气暗天涯。\n点滴听无厌，丰登喜有期。\n池幽生活水，花落长空枝。\n载酒行春屐，何忧入兴迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26302,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"道傍祠","author":"周翼之","text":"荒祠古道边，乔木翠森然。\n叠石为香案，攀藤挂纸钱。\n一时灵有迹，千载祀犹传。\n草草陈牛酒，深期大有年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26303,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"金精山","author":"周薰","text":"金精山高绝尘俗，中通洞天石削玉。\n仙家庭院昼不扃，草色迷阶秋雨绿。\n香炉峰前青可掬，石鼓坛边翠如沐。\n道人采药青牛还，铁笛声穿山鬼哭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26304,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"以珠子香建茶寄皖公山马先生","author":"周麟之","text":"筠谷珠玑北苑春，寸诚千里托灵芬。\n为投白鹿岩前客，何日容分半席云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26305,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春贴子词 皇后阁五首 其五","author":"周麟之","text":"椒涂日暖燕差池，又见瑶箱受福时。\n欲使后宫歌德化，试将彤管作春词。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26306,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春贴子词 皇后阁五首 其四","author":"周麟之","text":"银钩惯学君王帖，宝轸频听淑女琴。\n更与六宫循节俭，钗头不缀辟寒金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26307,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春贴子词 皇后阁五首 其三","author":"周麟之","text":"胜里金葩喜占新，红酥细字点宜春。\n内庭也作人间戏，自是时康乐事频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26308,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春贴子词 皇后阁五首 其二","author":"周麟之","text":"露沐千门柳，风萦九畹兰。\n会听莺出谷，行傍采桑坛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26309,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春贴子词 皇后阁五首 其一","author":"周麟之","text":"沼荇微生绿，宫梅暗度香。\n五云凝紫禁，一气转青阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26310,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春贴子词 皇帝阁六首 其六","author":"周麟之","text":"圣主清心仍寡欲，惟于笔砚未忘怀。\n彤廷仗下春朝散，独拥图书坐损斋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26311,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春贴子词 皇帝阁六首 其五","author":"周麟之","text":"凤盖龙车玉作轮，北临紫畤谒三神。\n已将福酒添眉寿，更祝椒觞一万春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26312,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春贴子词 皇帝阁六首 其四","author":"周麟之","text":"已过人日迎春驭，直待阶蓂十叶开。\n应是九门灯夕近，东皇欲驾六鳌来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26313,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春贴子词 皇帝阁六首 其三","author":"周麟之","text":"翠水冰融尽，雕栊日上迟。\n东风报花信，先拂万年枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26314,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春贴子词 皇帝阁六首 其二","author":"周麟之","text":"红日升旸谷，青辉应嶰筒。\n万方陶美化，浑在泰和中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26315,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春贴子词 皇帝阁六首 其一","author":"周麟之","text":"木铎扬宽诏，云翘舞化风。\n垂衣金殿里，圣德与天通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26316,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自南山归口占上王阁老 其二","author":"周麟之","text":"日高风软不生尘，十月湖山暖似春。\n绿绮抱来人不至，几时容我唤真真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26317,"s