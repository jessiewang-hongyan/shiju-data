[{"title":"送薛唐卿赴省试","author":"邹浩","text":"河东文物久尘埃，之子亭亭郁有材。\n已见中天鸣鸑鷟，不应环堵更蒿莱。\n绿衣春色知谁共，青简风流自此开。\n倾耳西州人快意，玉阶曾上直言来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56883,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送周茂宗学正赴省试","author":"邹浩","text":"草衣藿食寄尘编，凛凛声名玉几前。\n命数曲留成大器，乡书重上欲华颠。\n一鸣竟与凡禽远，三献方知美璞全。\n二十馀年古人志，从今摅发到青天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56884,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送周天和学谕以次十一人赴省试","author":"邹浩","text":"日月交光万国同，群英无复叹途穷。\n长松竟拔徂徕雪，骏马争驰冀北风。\n黄卷论心窥圣域，青云携手赴王功。\n归来协气充闾里，好是邦人识頖宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56885,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"元夕席上食柑子","author":"邹浩","text":"契阔吴门千里，栖迟颍水三年。\n臈炬光中气味，洞庭波上风烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56886,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"简仲孺","author":"邹浩","text":"晓来城府春融怡，博陵先生还自西。\n天时人事已如此，不应璧月空云霓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56887,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵酬德符湖上春色","author":"邹浩","text":"乘风曾到水晶宫，春色椎轮日力中。\n几处梅花傲残雪，不随桃李事轻红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56888,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戏史述古多问相","author":"邹浩","text":"穷当益坚愧枉道，心不胜术思齐贤。\n如何东里史夫子，骨相勤勤挥酒钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56889,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"世美约仲孺述之同泛清潩登楼待月分得楼字 其一","author":"邹浩","text":"风尘作恶败清游，杖履无光久自羞。\n约我晚来寻小艇，与君愁破对高楼。\n山分远翠凝衣重，月借澄辉扑水浮。\n不是严城不容与，径随双鹤宿沧州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56890,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"世美约仲孺述之同泛清潩登楼待月分得楼字 其二","author":"邹浩","text":"采石仙人放小舟，荆州老子上南楼。\n平生风度归遐想，今日还逢第一流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56891,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与仲孺述之世美东禅纳凉校韩文世美以韩公召先去 其一","author":"邹浩","text":"清风多处是精庐，饭罢俱来校异书。\n车马焉能落吾事，未斜桐影且安居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56892,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与仲孺述之世美东禅纳凉校韩文世美以韩公召先去 其二","author":"邹浩","text":"红衣青简竟多岐，无复寻盟作四夔。\n同见韩公不同趣，城南城北啭黄鹂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56893,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送杜謷居方城","author":"邹浩","text":"乃翁鬓发已秋霜，药裹仍闻满北堂。\n贫欲釜鱼勤子职，分甘足茧寄他乡。\n山前黄石空猿鹤，溪上青编屹栋梁。\n想见使亲忘我后，借书寻旧日徜徉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56894,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晓雨枕上有作","author":"邹浩","text":"震霆几日动天阍，河汉朝来竟一翻。\n顿觉炎歊辞枕簟，只应爽气满乾坤。\n鸡窗岂但开千卷，云稼悬知亘九原。\n北事平生最关虑，从今得意遂忘言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56895,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵德符曾家池上四诗 其一","author":"邹浩","text":"凉雨霏霏肃径沙，芰荷无数拥烟霞。\n幽人不受市朝挽，竟日池边藉落花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56896,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵德符曾家池上四诗 其二","author":"邹浩","text":"平生一语事诚忘，凫鹤不知谁短长。\n跬步秋园作殊域，从他白眼嘲裙裆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56897,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵德符曾家池上四诗 其三","author":"邹浩","text":"庭前叶下风萧萧，暑气不敢凭虚骄。\n青天碧水与君共，他日谪仙宫锦袍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56898,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵德符曾家池上四诗 其四","author":"邹浩","text":"真乐油油波底鳞，相从款款波上萍。\n雁奴燕子社前后，玉树鲜风吹晚庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56899,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"世美寓展江作此简之 其一","author":"邹浩","text":"白鹭飞时天宇清，君家琴瑟寄江滨。\n不愁折柳无多日，且喜荷花有主人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56900,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"世美寓展江作此简之 其二","author":"邹浩","text":"翩翩俭府几西风，更拟真游渌水中。\n秋晚倚栏应记得，全家看尽渚莲红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56901,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"洗竹","author":"邹浩","text":"欣欣花草不关心，绝倒宫庭一亩阴。\n夏箨陨风裁几日，秋筠要月拟千寻。\n携持斤斧从他怪，缭绕栏干著意深。\n全是吴中旧潇洒，过门应喜伴龙吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56902,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄裘仲","author":"邹浩","text":"几度秋陂老芰荷，蓬门不见雁来过。\n照人眉字今何似，得意诗篇日更多。\n事逐风云空白马，功随山岳尚黄河。\n无因双眼陪君子，暝立西楼一楚歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56903,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南堂八绝句 其一","author":"邹浩","text":"圣贤祠毕诸生散，曳履斜阳哦杜诗。\n幽鸟飞来似相好，竹枝深处语多时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56904,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南堂八绝句 其二","author":"邹浩","text":"桐竹交阴覆广庭，秋风时与叶争鸣。\n可怜一曲明君操，不似高山流水声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56905,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南堂八绝句 其三","author":"邹浩","text":"长廊耿耿注西东，鼓腹循环返照中。\n更拟将心寄明月，无端云叶上晴空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56906,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南堂八绝句 其四","author":"邹浩","text":"盆水如池傍竹根，早期功业在龙孙。\n尔来取饮多奇羽，更得南堂幽趣繁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56907,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南堂八绝句 其五","author":"邹浩","text":"窭人何缘有遗啄，一饮聊分秋水清。\n贪泉盗泉满机械，鸟鹊故应知此情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56908,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南堂八绝句 其六","author":"邹浩","text":"风摇疏影落清漪，汎汎鱼儿趁晚嬉。\n不是来禽惊不去，窗前从此使人疑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56909,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南堂八绝句 其七","author":"邹浩","text":"倦来支策立阶除，深喜官居似隐居。\n寒日西流报衙鼓，纷纷清影上图书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56910,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南堂八绝句 其八","author":"邹浩","text":"绿竹不应忘旧好，黄花还拟结新交。\n栏边醉倒非吾事，只爱金英媲玉梢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56911,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送田承君隐大留山","author":"邹浩","text":"田郎风节薄清旻，耻踏冥冥车马尘。\n远业不应忘魏阙，高人聊喜得东邻。\n鹿门隐去曾携子，绵上归来亦侍亲。\n早晚云飞雨天下，勒移何愧北山神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56912,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"湖上访世美不遇","author":"邹浩","text":"夜雨朝晴似蜀天，湖光山色故人边。\n琵琶不许陪犀麈，听水亭东一黯然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56913,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"月下怀同盟 其一","author":"邹浩","text":"常时二妙过晴窗，丙夜犹同秋月光。\n不分城扉日多事，天南天北又参商。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56914,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"月下怀同盟 其二","author":"邹浩","text":"碧天如水驻冰轮，粲粲裁馀一两星。\n想见墙东病居士，废书捐枕步中庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56915,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"月下怀同盟 其三","author":"邹浩","text":"晚云携雨入陉山，月到西湖万象閒。\n公子归来泛家宅，只应诗思落人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56916,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"月下怀同盟 其四","author":"邹浩","text":"睡觉谯门已转更，小童徐报月重明。\n揽衣起与妻孥共，矫首惟闻鸟鹊惊。\n濒水杯盘无俗物，隔墙巾屦有真情。\n相从竟日今相望，四者由来不易并。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56917,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"月下怀同盟 其五","author":"邹浩","text":"一经三五一亏盈，此夕胡然分外明。\n金令中分寒暑候，蟾辉独占古今清。\n樽罍自是常年事，天地何难永夜晴。\n寄语风云莫无赖，万方矫首此时情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56918,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵王彦温邂逅登舟","author":"邹浩","text":"过尽西城百丈堤，村村鸡犬午声齐。\n风前匹马不回首，知有幽人在竹溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56919,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"访仲弓","author":"邹浩","text":"凉雨吹丝络晚空，朅来秋兴与君同。\n巽亭鹄立云霓上，未许山川落眼中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56920,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中秋日泛湖杂诗 其一","author":"邹浩","text":"高柳茏苁暝晚烟，拍堤秋水远连天。\n恨君不见桃花盛，十里红波送酒船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56921,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中秋日泛湖杂诗 其二","author":"邹浩","text":"赏心自与月俱圆，今夜晴阴莫问天。\n秋色向人方有意，不逢星女不回船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56922,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中秋日泛湖杂诗 其三","author":"邹浩","text":"望中白鸟点青烟，秋意交情两薄天。\n仙李骑鲸不知处，高吟谁继岳阳船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56923,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中秋日泛湖杂诗 其四","author":"邹浩","text":"晚风知我兴飘然，力战浮云露远天。\n判却明朝官长骂，与君彻晓引金船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56924,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中秋日泛湖杂诗 其五","author":"邹浩","text":"从来笔力扫千军，卷舌无声岂不能。\n欲似元戎耀奇策，故令偏帅作先登。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56925,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中秋日泛湖杂诗 其六","author":"邹浩","text":"荷花影里逢君辈，棋子声中愧我能。\n拟上高楼对殷浩，更凭长啸引孙登。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56926,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中秋日泛湖杂诗 其七","author":"邹浩","text":"胡床兀兀坐忘情，似向曹溪见老能。\n若处樵歌好消息，妙高峰上许人登。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56927,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中秋日泛湖杂诗 其八","author":"邹浩","text":"路转城隅更可怜，尽桥横处响潺湲。\n篙人不会凭舟意，径逐西风过水源。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56928,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中秋日泛湖杂诗 其九","author":"邹浩","text":"灵隐山前独子知，清溪浑似颍川湄。\n何当把手东南去，却向山前话此时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56929,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中秋日泛湖杂诗 其十","author":"邹浩","text":"士龙拥鼻时一笑，司马忘机只言好。\n野人浪测君子心，应为狂吟分枯槁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56930,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中秋日泛湖杂诗 其十一","author":"邹浩","text":"舟去舟还秋半时，孤花细草雨霏霏。\n怪来诗句无清思，不见沙头双鹤飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56931,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中秋日泛湖杂诗 其十二","author":"邹浩","text":"每将冲韵拟琴高，不值飞鸣心更劳。\n邂逅诗成似招隐，稻花深处举霜毛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56932,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中秋日泛湖杂诗 其十三","author":"邹浩","text":"谁家脩竹拂云电，影带晴光漾渌漪。\n风日无情促归楫，不教閒客共题诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56933,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中秋日泛湖杂诗 其十四","author":"邹浩","text":"早觉鸣鸠啼木杪，晚来晴日破天颜。\n不愁今夜云遮月，且凭阑干一看山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56934,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中秋日泛湖杂诗 其十五","author":"邹浩","text":"乍疑绝岸行飞鹜，还误游鱼出听琴。\n公子自随星斗去，水声他日是棠阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56935,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中秋日泛湖杂诗 其十六","author":"邹浩","text":"滥巾文会出重城，把笔时为蚯蚓鸣。\n日暮归来理章句，低头惭愧楮先生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56936,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中秋日泛湖杂诗 其十七","author":"邹浩","text":"兴尽归来潩水边，翠阴亭上奏繁弦。\n龙媒耳接新声惯，驻足西风不受鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56937,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵述之","author":"邹浩","text":"杜陵秋拟问真源，博望亲从天上还。\n不使清风委平地，斯人今日在陉山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56938,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵德符展江怀世美","author":"邹浩","text":"翩翩风御返瀛洲，清梦还应此地游。\n凭仗云鸿寄消息，尔来何啻度三秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56939,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵先生湖上有作","author":"邹浩","text":"霜落西陂晚，追携物外欢。\n孤芳迎日动，轻浪逐莲乾。\n鱼计从来审，鸥盟未易寒。\n谁知少陵老，爱客似苏端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56940,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"湖上","author":"邹浩","text":"菱盘不复藏秋水，蒲剑犹能战晚风。\n共陟孤高更忘适，纷纷霜叶下晴空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56941,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵陈君益见寄","author":"邹浩","text":"冉冉岁云暮，泠然流水心。\n他邦勤短策，今日慰孤斟。\n竹韵凌风远，花光受月侵。\n毫端落珠琲，三复故情深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56942,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵罗正之朝散到临颍见寄","author":"邹浩","text":"何事委天数，平生嗤李寻。\n同时得君子，如古惜分阴。\n白发日非故，黄花秋似深。\n谁知千里驾，中有岁寒心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56943,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"代书招德符","author":"邹浩","text":"北风鸣四野，饥鸟下黄昏。\n寒烛照无寐，孤怀谁与论。\n伊予赋招隐，抚事倍销魂。\n莫使衡门下，朝来独负暄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56944,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偶书","author":"邹浩","text":"玄鸟未来阳鸟稀，广庭松竹皆故枝。\n书边痴坐送日月，春色过门都不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56945,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢马叔宝惠佛像琴弦","author":"邹浩","text":"故人知我久忘情，不假苞苴远寄诚。\n金范晬容窥往制，丝传流水得遗声。\n邻鸡破晓炉边静，霜月储清席上横。\n香散曲终谁会意，与君相望一高城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56946,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"曾存之以伫云名庵以待缁流因作此戏之","author":"邹浩","text":"不见从来庵内人，结茅濒水更慇勤。\n云飞日日满天地，借问如何能伫云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56947,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"仲弓见访同过叔原","author":"邹浩","text":"幕天云不动，庭竹晚生寒。\n好事倏假盖，拥炉聊整冠。\n香煤团薄雾，松麈落惊湍。\n思逸何当尽，邻家有谢安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56948,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵述之谢寄兰","author":"邹浩","text":"朅来幽韵与时分，雅称深沉扬子云。\n记取人间多恶草，一莸能败十年薰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56949,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"曾氏北园 其一","author":"邹浩","text":"浮云不傍此庵来，竹静幽兰一笑开。\n若处鲜鲜解人意，等閒冰破作春雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56950,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"曾氏北园 其二","author":"邹浩","text":"藕花莲叶弄晴晖，长记君来作好诗。\n我亦池塘兴不浅，若为相望北风时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56951,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"曾氏北园 其三","author":"邹浩","text":"江禽插颈梦初成，庭树横烟晚更轻。\n已恨重城落吾事，更堪明月向人生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56952,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"曾氏北园 其四","author":"邹浩","text":"苏郎北阙未寻盟，崔子西山尚掩扃。\n矫首空庭问怀抱，天高无路雁边青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56953,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"曾氏北园 其五","author":"邹浩","text":"十年不折江南春，亭下双梅是故人。\n凭仗开时属青翼，已判飞雪满悬鹑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56954,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"曾氏北园 其六","author":"邹浩","text":"白莲香火久凋零，还似乐天今服膺。\n我有一言人不解，请君问取北来僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56955,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"种竹","author":"邹浩","text":"去年今日常种竹，今年此日还添栽。\n岂论传舍不吾有，但愿清阴遗后来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56956,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵德符寄世美因以招之","author":"邹浩","text":"织女牵牛饯我车，归来篱菊已荣枯。\n韩城夫子旧青眼，肯使东斋屐齿疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56957,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]