[{"title":"寄天台万年淮海禅席","author":"释文珦","text":"四海今淮海，中年主万年。\n虚空曾悟性，文字不离禅。\n灵瀑煎茶净，寒株拾菌鲜。\n无由亲道话，梦绕石桥烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7853,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄西山嵩雪庭","author":"释文珦","text":"支遁还山去，翛然世外心。\n不曾离涧壑，长是爱云林。\n马放秋场静，龙眠夜井深。\n山林如许到，早晚亦相寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7854,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄林弓寮","author":"释文珦","text":"暗数鸣弦日，知君已及瓜。\n水光浮县郭，山色满樵家。\n讼简迟开印，庭空早放衙。\n传来多美政，不独种桃花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7855,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿闽中溪寺","author":"释文珦","text":"独宿闽溪寺，中宵梦自惊。\n月斜移树影，风急转滩声。\n起对清秋色，难为远客情。\n云山千万叠，何处是神京。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7856,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄淮头家兄","author":"释文珦","text":"君向淮堧去，相思梦不安。\n兵戈犹未定，道路自应难。\n旷野人烟少，荒城鬼燐寒。\n故园松菊在，何必恋微官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7857,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄游边友人","author":"释文珦","text":"念君为远役，日日为君愁。\n直道无知己，身贫难自由。\n角吹关月晓，鼙动碛霜秋。\n想亦怀归切，慈亲雪满头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7858,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄潜斋王尚书","author":"释文珦","text":"自解朝缨去，西山有的传。\n此心如白水，把酒问青天。\n直道难谐俗，閒身胜得仙。\n山林钟鼎味，并在小梅边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7859,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"探幽","author":"释文珦","text":"秋色令人爱，青藜助远探。\n柿枫丹互映，天水碧相涵。\n绝景沙鸥占，幽程野老谙。\n谓予云外去，更有古龙潭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7860,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晚步","author":"释文珦","text":"秋色遍西原，行吟野兴存。\n坂田通堰熟，溪水度滩喧。\n宿鸟分投树，归牛各认村。\n幽居乘夜返，松月在衡门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7861,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晚步","author":"释文珦","text":"竹杖芒鞋晚步迟，为贪山水有清晖。\n栖鸦已带残阳去，牧竖遥穿薄霭归。\n可保禅身终放浪，从教尘世各脂韦。\n閒中自有无穷乐，敢道麻衣胜锦衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7862,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晚春遣兴","author":"释文珦","text":"始听邻屋响秋砧，独住閒房春又深。\n遍地繁花非故色，一窗凉叶是新阴。\n仓庚谩得东君意，杜宇偏伤远客心。\n节物相催身易老，临风时复动悲吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7863,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晚秋閒步","author":"释文珦","text":"晚来閒步阅秋光，田上人家尽涤场。\n远浦寒波浮雁鹜，荒山落日下牛羊。\n客鬓已非当日黑，菊花空似去年黄。\n因听翁媪言音异，又复令人忆故乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7864,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晨步","author":"释文珦","text":"茅堂清漱罢，随意涉西陵。\n茅屋冰千柱，高峰雪一棱。\n水浑潮已长，霞淡日初升。\n更欲过前浦，渔舟唤不应。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7865,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"曹娥庙","author":"释文珦","text":"坟柏起阴风，舟行谒祭同。\n乡人今变俗，孝女旧沈躬。\n名寄长江远，神还野庙空。\n尚馀黄绢字，零落断碑中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7866,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梅雨","author":"释文珦","text":"梅雨无时下，霖淫一月馀。\n重阴迷早晚，常课废经书。\n衣润无由曝，园荒亦欠锄。\n尧天舜日远，怀抱若为舒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7867,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梅楠","author":"释文珦","text":"梅楠三四树，手种近岩房。\n始见条抽绿，俄惊叶陨黄。\n物情殊易变，身世岂能常。\n且尽修心法，休传却死方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7868,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梦觉吟","author":"释文珦","text":"百年如大梦，梦里几纷驰。\n觉后识为梦，梦时曾未知。\n吾生今已觉，不记梦中时。\n在梦人无限，昏昏信可悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7869,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"深村","author":"释文珦","text":"深村堪就隐，随处有人家。\n地远官无禁，年丰酒易赊。\n烟波藏钓艇，山雨送樵车。\n绝似桃源里，唯无洞口花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7870,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"深居","author":"释文珦","text":"湖海同流尽，深居独系匏。\n已全忘疏钞，亦不事推敲。\n水石为清供，烟霞作澹交。\n随行一枝锡，高挂在松梢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7871,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清苕","author":"释文珦","text":"清晓泛苕滨，长歌拨棹频。\n山川开霁景，草木畅馀春。\n野老知閒趣，沙鸥似故人。\n绝胜拈麈尾，驾说弊精神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7872,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渔父","author":"释文珦","text":"在处变名姓，往来长啸歌。\n一身无赋役，几口共烟波。\n江月垂纶下，汀云宿棹和。\n却应嫌渭叟，老去脱寒蓑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7873,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"盘谷","author":"释文珦","text":"盘谷住来深，馀生任陆沈。\n自知尘外趣，消尽世间心。\n林霭飘成画，风泉写入琴。\n清猿亦可爱，旦莫发长吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7874,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"绿阴满院","author":"释文珦","text":"一年花信过，满院绿阴多。\n老子于中住，新莺每到歌。\n萧閒遗世虑，清净合天和。\n好是孤云性，谁能管得他。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7875,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"野处","author":"释文珦","text":"野处日多暇，扶藜信脚行。\n荒原寒鸭阵，深巷午鸡声。\n随地有幽事，閒人无滞情。\n归来新月上，照我入柴荆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7876,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"野兴","author":"释文珦","text":"野人乘野兴，短策胜华轩。\n缓步有幽趣，长歌非俗言。\n烟霞仙佛境，鼓笛鬼神村。\n遁世今成乐，浮华岂足论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7877,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"野寺","author":"释文珦","text":"野寺居来岁月长，幽深真是隐人乡。\n怪枝结顶青松古，巨石分流碧涧长。\n拈弄诗章非俗事，断除禅病得良方。\n因悲窃国亡身者，枉作尘劳梦一场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7878,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"野老 其一","author":"释文珦","text":"野老一身轻，于今野趣成。\n交游木上座，疏阔楮先生。\n溪甑炊菰米，山卮咀菊英。\n林园道子好，时复到柴荆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7879,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"野老 其二","author":"释文珦","text":"溪头逢野老，邀我过桥东。\n牛卧閒田上，鸡鸣村巷中。\n豆乾霜腹饱，莲倒露房空。\n邻里交相命，桃源风景同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7880,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"野步","author":"释文珦","text":"野步任吾情，深村复远坰。\n陂塘波瀰瀰，坡垄麦青青。\n灶妇知蚕性，田夫识地形。\n牧儿尤可喜，记得相牛经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7881,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"野性","author":"释文珦","text":"野性难谐俗，空林自葺茅。\n且教同木石，不是慕夷巢。\n竹树长阴合，风泉夜响交。\n山中无小草，那许世人嘲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7882,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"野祠","author":"释文珦","text":"翁媪已相催，喧喧鼓笛来。\n荒祠三面水，老树一身苔。\n休咎冯巫语，凶丰信珓杯。\n神前酾酒罢，风散纸钱灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7883,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"野草花","author":"释文珦","text":"心爱无名草，閒花取次开。\n自能追造化，浑不假栽培。\n姚魏伤攀折，楩楠困剪裁。\n祇因非世用，长得保根荄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7884,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"野僧","author":"释文珦","text":"野僧尘虑尽，住在最深峰。\n庭树巢孤鹤，崖湫宅老龙。\n瀑绡悬百尺，云幌羃千重。\n静里玄机发，登楼夜击钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7885,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"随寓","author":"释文珦","text":"我忘方就隐，鸟倦自知还。\n随寓皆为道，何人有此閒。\n微茫春水渡，平远夕阳山。\n尽入清吟景，谁言胜事悭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7886,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"隐居","author":"释文珦","text":"隐居那用名，名没隐方成。\n交绝身常定，心安病不生。\n山肴珍白蕈，野饭美青精。\n回视人间世，何如戏一棚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7887,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪屋","author":"释文珦","text":"风落晓空寒，茅檐一尺宽。\n乱声依竹密，斜片打窗残。\n绝谷炊烟断，开门去路难。\n枕书眠白昼，人说似袁安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7888,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪窦山","author":"释文珦","text":"寺在诸峰顶，寥寥远世纷。\n岩飞千丈雪，门掩万重云。\n地冷春疑晚，松深日易曛。\n孤猿清叫月，僧向定中闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7889,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪霁","author":"释文珦","text":"静寄向空林，于今岁月深。\n因知閒趣味，懒与俗浮沉。\n霁雪千峰玉，朝阳万树金。\n是吾真富贵，不觉动微吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7890,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪霁别乡","author":"释文珦","text":"雪霁别乡关，经行百里间。\n溪流殊荡漾，山色正斓斑。\n民散无多户，程途转几湾。\n衰龄垂八十，未必又重还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7891,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"堪叹","author":"释文珦","text":"堪叹是衰年，年年白发添。\n客身穷鬼狎，古道俗人嫌。\n当作凌霄鹤，休为上竹鲇。\n到头归去好，祇合效陶潜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7892,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"富春屠","author":"释文珦","text":"瓜桥路入屠山寺，山势蜿蜒似卧龙。\n长者布金传几世，应真垂迹在前峰。\n连筒架壑寒泉洁，高阁凌空莫霭重。\n八十老僧偏念古，向余慷慨说孙钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7893,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"散人","author":"释文珦","text":"乾坤有散人，事事不关身。\n敛念息诸妄，到头唯一真。\n忘荣宁虑辱，无富岂嫌贫。\n虽道青山好，犹知是外尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7894,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游越","author":"释文珦","text":"吴客来游古越都，缅怀前事更踟蹰。\n高峰篆刻空秦望，遗庙丹青尚禹谟。\n佛屋几迁王令宅，官租半入贺家湖。\n日斜欲返烟城去，柳下春船不受呼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7895,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游囊山礼妙应祖师慧薰塔","author":"释文珦","text":"踏遍诸方倦说禅，偶逢佳处结良缘。\n祖师圣解何须举，衲子家风要别传。\n云外壶中如聚墨，望中沧海欲浮天。\n如今觌面相呈了，啼鸟落花俱寂然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7896,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"湖寺上方通玄峰顶","author":"释文珦","text":"峰顶非人世，青山满目多。\n塔层侵树影，钟响度湖波。\n心外元无境，诗成亦是魔。\n禅翁清净耳，浑不听笙歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7897,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"湖亭别友","author":"释文珦","text":"与君俱是客，重别意如何。\n斜日孤帆去，寒江风浪多。\n远怀随雁影，新咏杂渔歌。\n知此遨游地，何时复共过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7898,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登太白绝顶龙池望远","author":"释文珦","text":"苍莽势连空，跻攀径绝踪。\n乱峰排似戟，片石响于钟。\n鸟语春云密，龙归暮雨重。\n下观群岫小，始觉此为宗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7899,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登临写兴","author":"释文珦","text":"临水登山送此生，禽猿个个尽忘情。\n破除妄念唯空寂，藏蓄危机是利名。\n老子乐时谁不笑，众人重处我能轻。\n有时信口长歌发，好似东阳独自精。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7900,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅翁","author":"释文珦","text":"禅翁八十鬓如霜，冷坐云边旧竹房。\n唯放此身长懒散，更无馀事可思量。\n飞流激石泉珠迸，斜照入林松影长。\n即景成诗疑未稳，更寻樵父为平章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7901,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"腊月立明年春","author":"释文珦","text":"闰岁两番春，流光故逼人。\n月筒将谢丑，斗柄倏旋寅。\n玉作梅容润，金归柳眼新。\n物情虽万变，曾莫变吾真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7902,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"腊月立春雪后溪行偶作","author":"释文珦","text":"踽踽白头人，江湖寡所亲。\n故乡千里念，闰岁两番春。\n北雪歌黄竹，东风变绿蘋。\n此中来往熟，不问自知津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7903,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赓李筼房韵","author":"释文珦","text":"故国频关梦，春深一到来。\n却因风景异，便棹雨舟回。\n其可忘诸夏，真堪赋七哀。\n天居曾入处，满目是寒苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7904,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"越中三江斗门","author":"释文珦","text":"斗门何代设，千古截寒潮。\n水庙依枫树，湖田足葑苗。\n众山临海尽，丛港达城遥。\n落日渔歌里，西风动泬寥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7905,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雁荡大龙湫","author":"释文珦","text":"此水昔年人不见，梵僧来说始知名。\n飞扬半杂烟岚气，断续全同风雨声。\n四壁倚空疑鬼凿，一峰当面自天成。\n虽然未作山中住，曾到山中梦亦清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7906,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雁荡大龙湫","author":"释文珦","text":"深蹊入薜萝，一瀑泻岩阿。\n曾阅西天志，言居诺讵罗。\n斜飞疑是雨，清激自成涡。\n下有苍龙窟，樵人不敢过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7907,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"集奉川道中","author":"释文珦","text":"一路盘云远，连朝策瘦筇。\n神祠依古木，佛屋占奇峰。\n立石分田界，疏泉作涧舂。\n因思似乡土，归意忽然浓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7908,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"塞笛","author":"释文珦","text":"孤笛起寒洲，传声到暝楼。\n吹人元不怨，听者自生愁。\n万里家何所，三年戍未休。\n此时霜月下，白却少年头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7909,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"感旧","author":"释文珦","text":"山川虽不改，伤感自难穷。\n野树浮新绿，宫花陨旧红。\n两间无异气，一等是春风。\n万古乘除理，谁能究始终。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7910,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新昌南岩","author":"释文珦","text":"大禹未疏凿，此山为海门。\n试从樵径上，犹有钓车存。\n佛屋栖灵窦，仙坟荫远村。\n岩头一滴水，居者不知源。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7911,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"溪上","author":"释文珦","text":"散策清溪岸，茅檐事事幽。\n燕巢春始垒，蛛网雨来收。\n翁媪能留客，儿童不识愁。\n兴长归径晚，回首问群鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7912,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"溪上野人家","author":"释文珦","text":"隔水两三家，荆扉带郭斜。\n春风喧燕雀，时雨足桑麻。\n翁媪皆垂白，衣冠不尚华。\n乌蓬船一只，出入渡头沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7913,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"溪寺书怀","author":"释文珦","text":"野寺依溪曲，长桥接柳堤。\n俗人忙不入，孤客自安栖。\n懒散今成性，烟云尽入题。\n邻居有农父，时与话耕犁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7914,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"溪路","author":"释文珦","text":"溪路六七里，茅茨三两家。\n断崖悬石髓，古树有松花。\n绝壑无人处，看云到日斜。\n过山幽更甚，时复见樵车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7915,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禁体咏雪时方用兵故其末及之","author":"释文珦","text":"拥衲坐深更，频闻蔌蔌声。\n祇疑为落叶，不道是飞霙。\n晓压松头重，寒铺砌面平。\n幸成丰岁兆，何事却徵兵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7916,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禁体咏雪","author":"释文珦","text":"应臈雨连朝，丰年瑞已饶。\n乱声还蔌蔌，猛势尚瀌瀌。\n岭峤松增秀，原田麦长臕。\n穷阎休怨冷，见睍自应消。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7917,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"筼房秋崖来访不相值后往谢之筼复有诗喜余之至因次其韵","author":"释文珦","text":"吟车曾到社桥来，不见山人乞食回。\n荒沼秋深莲已谢，寒林冬近菊初开。\n句引渊明无酒盏，观迎元度但茶杯。\n寻盟却喜梅花发，日日论诗坐碧苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7918,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蓬户","author":"释文珦","text":"蓬户何须启，年来已绝交。\n色空原自了，玄白任渠嘲。\n琴谱添新曲，书囊屏旧抄。\n抟风九万里，安隐愧枝巢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7919,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鄞中他山堰","author":"释文珦","text":"碧浸他山古，梅梁昔化龙。\n江溪一堰隔，禾黍四郊重。\n绝唱思幽客，欢声遍野农。\n长官功不朽，遗庙合歌钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7920,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鄞中送坦上人归故里","author":"释文珦","text":"白云相见初，而子独知予。\n世态易翻覆，道交难间疏。\n三江同远棹，此日晚离袪。\n莫放音书绝，东来有鲤鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7921,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鄞中桃花渡即事","author":"释文珦","text":"城北桃花渡，楼居半海商。\n官河通远浦，津树杂高樯。\n旭日江烟暖，东风水草香。\n为看风土异，客子又怀乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7922,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]