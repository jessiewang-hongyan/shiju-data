[{"title":"挽龚汀州二首 其二","author":"刘克庄","text":"所守老尤刚，清风凛不亡。\n洞房无粉黛，垩室屏缁黄。\n东阁遵遗令，南山献吉藏。\n百年耆旧尽，里社转凄凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32268,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽龚汀州二首 其一","author":"刘克庄","text":"早日曾庐墓，中年懒建牙。\n的无金遗子，仅有笏传家。\n穷巷观时事，丛祠阅岁华。\n天乎清白吏，名位止斯耶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32269,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽惠安林丞","author":"刘克庄","text":"策名迫榆景，谢病去松厅。\n博取儒先说，尤深道德经。\n族通艾轩谱，葬得竹溪铭。\n愁绝蟆陵路，哀笳不忍听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32270,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽游勉之侍郎二首 其二","author":"刘克庄","text":"昔在高阳里，曾登夫子堂。\n武城愧言偃，畏垒化庚桑。\n病臂书全阙，惊心鉴忽亡。\n平生刍一束，道远不能将。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32271,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽游勉之侍郎二首 其一","author":"刘克庄","text":"不假横金贵，居然比玉温。\n诸公从上雍，一老立东门。\n伯氏推难弟，先师有嫡孙。\n耆英凋落尽，旧事向谁论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32272,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽程孺人","author":"刘克庄","text":"七诫尤纯备，三从总吉祥。\n良人今绮季，美子古黄香。\n花引归西竺，萱疑在北堂。\n恨余彤管拙，哀诔不能扬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32273,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽葛夫人二首 其二","author":"刘克庄","text":"不惟婆嫂咸嗟惜，学语儿知此母贤。\n味薄居常喜蔬食，心慈劝勿用蒲鞭。\n若非腾上天宫里，必是迎归海岸边。\n九十老农来祖奠，眼枯不觉亦潸然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32274,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽葛夫人二首 其一","author":"刘克庄","text":"银台曾奋涂归笔，我亦留花批逆鳞。\n早共裂麻沮裴相，晚甘负耒作滕民。\n儿斑衣从双旌贵，母绣帘迎万户春。\n方拥皇华荒大国，误他多少借留人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32275,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽韩母李氏","author":"刘克庄","text":"持家霜满鬓，誓口铁为心。\n兄戴万钟禄，黔娄一布衾。\n嘉宾怀截发，孤女感抽簪。\n遗庆观贤子，交游属望深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32276,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽意一徐枢二首 其二","author":"刘克庄","text":"长公宿草几番春，犹幸天留一颍滨。\n士欲捧盘定盟主，上看折槛记忠臣。\n翟门昔有张罗叹，徐墓今无挂剑人。\n夫子雅言武公谑，寻思一一可书绅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32277,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽意一徐枢二首 其一","author":"刘克庄","text":"苦言玉座常追忆，坚卧蒲轮未易招。\n昔喜凤来韶石奏，今愁鳌去海山摇。\n覆瓯望绝民无福，亡鉴悲深帝辍朝。\n欲向蟆陵沥卮酒，荒烟衰草路迢迢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32278,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽傅谏议三首 其三","author":"刘克庄","text":"忆昔南山寺，微言叩未终。\n晚犹温荐语，病尚寄书筒。\n骏厩谁收我，蟆陵合殉公。\n春风溪上泪，还与海潮东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32279,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽傅谏议三首 其二","author":"刘克庄","text":"今上龙飞始，先生驿召频。\n颇闻曾草疏，终不就蒲轮。\n勘破邯郸梦，抽回洛社身。\n也令千载下，知世有全人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32280,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽傅谏议三首 其一","author":"刘克庄","text":"昔事先皇帝，堂堂立玉墀。\n进怀伏蒲疏，退诵考槃诗。\n哀郢遗言切，忧周素发垂。\n它年耆旧传，此笔属诸谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32281,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽楼旸叔二首 其二","author":"刘克庄","text":"平生所历最崎嵚，不觉周南岁月深。\n拙宦元无金润屋，悼亡新有雪盈簪。\n凄凄德曜齐眉案，草草黔娄覆首衾。\n曾忝郡民渐教化，眼看双旐一沾襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32282,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽楼旸叔二首 其一","author":"刘克庄","text":"白首临凋瘵，齑盐似旧时。\n仅持一麾止，安用五车为。\n库有留州赋，家无葬地资。\n空馀清俭字，长使郡人思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32283,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽漳浦陈丞璧","author":"刘克庄","text":"非但闻诗礼，居然识典章。\n探环如梦里，拥笏向亲旁。\n州县淹斯立，家庭惜季方。\n北风无赖甚，吹雁不成行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32284,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽蔡遵府阁学二首 其二","author":"刘克庄","text":"俱侍清光迩，相看素发稠。\n已拚老聃去，尚意孔戣留。\n雌甲何其厄，同庚只么休。\n龙钟不出户，持此诔新丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32285,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽蔡遵府阁学二首 其一","author":"刘克庄","text":"外庸为世冠，内守与时乖。\n鲠论传文懿，麟编法止斋。\n晚方颛史笔，早不面公槐。\n已病犹箴谏，难忘耿耿怀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32286,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽毅斋郑观文二首 其二","author":"刘克庄","text":"卷服辞三事，深衣立一儒。\n羞扶孔公杖，宁入洛英图。\n鉴已云亡矣，梁其不坏乎。\n纷纷扫门客，曾拜董陵无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32287,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽毅斋郑观文二首 其一","author":"刘克庄","text":"嘉定名尤重，端平眷最浓。\n子虽曾摄相，公自要明农。\n尚意宣麻拜，俄惊斩板封。\n白头西府掾，无复奉从容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32288,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽潘柄","author":"刘克庄","text":"复斋之客潘夫子，生死相从未忍分。\n薛守颇曾参道洁，志完何可欠承君。\n鲁生邀饮犹同去，庞嫂来呼已不闻。\n菆舍一卮真永诀，老无脚力拜翁坟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32289,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽颜尚书二首 其二","author":"刘克庄","text":"昔有颜光禄，依稀即此翁。\n祖传孙愈盛，官与姓皆忠。\n遗训言犹在，楞伽读未终。\n遥知空巷送，笳鼓咽城东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32290,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽颜尚书二首 其一","author":"刘克庄","text":"忆昨端平际，烦公尹帝京。\n解弦三辅理，免胄一军惊。\n举国言尊勇，无人议敞轻。\n如何开济手，寂寞向佳城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32291,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽薛潮州","author":"刘克庄","text":"醇谨真贤胄，廉能亦吏师。\n潘花一手种，韩木百年思。\n良友招魂些，遗民堕泪碑。\n今无黄绢笔，书墓叹吾衰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32292,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽戴丞","author":"刘克庄","text":"戴氏多人物，君尤月旦推。\n能传后仓礼，亦擅叔伦诗。\n故里悬车蚤，名场解褐迟。\n它年端有恨，椿桂不同时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32293,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽夔漕王中甫二首 其二","author":"刘克庄","text":"半瓢丹药一邛枝，万里西来抚事悲。\n绶著藏中公事定，剑鸣匣内我年衰。\n可怜檄笔今零落，尚记纶巾共指麾。\n身在沧洲搔白首，断肠吟就八哀诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32294,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽夔漕王中甫二首 其一","author":"刘克庄","text":"羽书堆里挟遗编，往古来今尽粲然。\n白发晚持川口节，丹旌暑下峡门船。\n生前多半游榆塞，身后才方领木天。\n老去一双怀旧泪，谁知滴向建溪边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32295,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"敖茂才论诗","author":"刘克庄","text":"诗道不胜玄，难于问性天。\n莫求邻媪诵，姑付后儒笺。\n至质翻如俚，尤癯始似仙。\n吾非肝肺异，先得子同然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32296,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"敖器之宅子落成","author":"刘克庄","text":"臞翁卜筑向东皋，小憩江湖半世劳。\n绕屋树阴供杖屦，登楼山色发诗骚。\n客来贺厦杯行阔，市写抛梁纸价高。\n白虎渐台何处在，不如茅舍尚坚牢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32297,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晋元帝庙","author":"刘克庄","text":"元帝新祠西郭外，野人吊古独来游。\n阴阴画壁开冠剑，寂寂丝窠上璪旒。\n势比龙盘犹在眼，事随鸿去不回头。\n叶碑廊下无人看，欲去摩挲又少留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32298,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓鸡","author":"刘克庄","text":"绛帻昂然韵节清，不因风雪废长鸣。\n初闻烟岫犹衔月，久听山城渐杀更。\n惊起征夫茅店梦，唤回老将玉关情。\n年来无复中宵舞，自笑功名一念轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32299,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"栽竹","author":"刘克庄","text":"借居未定先栽竹，为爱疏声与薄阴。\n一日暂无能鄙吝，数竿虽少亦萧森。\n窗间对了添诗料，郭外移来费俸金。\n自笑明年何处在，虚檐风至且披襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32300,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桂花","author":"刘克庄","text":"生得粟来大，妆成蜡样黄。\n落金遮蚁穴，酿蜜满蜂房。\n月下高低影，风前远近香。\n夜深清到骨，幽梦绕胡床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32301,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浦城道中","author":"刘克庄","text":"才入仙霞路，重裘尚不支。\n居人收桕实，客子办梅诗。\n地湿然萁坐，霜寒隔被知。\n向来真错计，不买草堂基。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32302,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浴日亭一首","author":"刘克庄","text":"归客飘然一叶身，尚能飞屐陟嶙峋。\n危亭下瞰嵎夷宅，积水上通河汉津。\n叱驭为臣前有志，乘桴从我更无人。\n暮年笔力全衰退，甘与韩苏作后尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32303,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"海口三首 其三","author":"刘克庄","text":"人烟穷处屋三间，目断寒云接浅山。\n石塔有风铃自语，水亭无税印常闲。\n沙晴火伏如棋布，浪急渔舟似洗还。\n自古诗从登览得，莫辞绝境共追攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32304,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"海口三首 其二","author":"刘克庄","text":"岛烟常至晏方开，沙际参差辨远桅。\n风挟寒声从树起，潮分末势过桥来。\n吏人不禁山排闼，客子思倾海入杯。\n归忆斯游非冷淡，如尝橄榄味初回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32305,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"海口三首 其一","author":"刘克庄","text":"暂游不得久婆娑，柰此龙江景物何。\n天势去随帆际尽，海声来傍枕边多。\n昏窗微见灯明屿，霁阁遥看日浴波。\n定有后人寻旧迹，已留小篆识山阿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32306,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"海口官舍","author":"刘克庄","text":"晓起斋中望，千家未启扉。\n潮能驱海走，风欲挟人飞。\n烟寺钟初定，霜林叶半稀。\n客身偏畏冷，著尽带来衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32307,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"烟竹铺","author":"刘克庄","text":"野迥村疏起暮寒，偶逢废驿卸征鞍。\n主人家比渔舟小，客子房如鹤栅宽。\n灯与邻通眠未易，风从壁入避尤难。\n似闻南去加萧索，一夜披衣坐不安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32308,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留别表弟方时父二首 其二","author":"刘克庄","text":"忆昔分携今再闰，君犹黑鬓我霜颠。\n绝怜卢弟真才子，若比殷兄尚少年。\n渭北几时重把酒，山阴作么便回船。\n未知后会平安否，搔首临风意惘然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32309,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留别表弟方时父二首 其一","author":"刘克庄","text":"四壁萧萧落叶声，招留聊试子交情。\n不应华屋延珠履，得似蓬窗共铁檠。\n襆被都无三宿恋，重裘未觉一寒生。\n暮年彼此欢悰薄，相对清谈听断更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32310,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"□□□□ 其二","author":"刘克庄","text":"间或击强非果弱，未尝束湿自然严。\n起惟吏畏三风训，先为民蠲再榷盐。\n时与青油宾唯诺，尤于白屋士劳谦。\n悬知铃阁清如水，瓜李虽微亦远嫌。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32311,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病中九首 其五","author":"刘克庄","text":"炎官扇虐甚炰烹，忽听檐声病思清。\n白露降馀天气肃，碧云合处暮愁生。\n一秋药裹相料理，百岁书窗几暗明。\n他日汗青无事业，惟诗犹可窃虚名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32312,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病中九首 其四","author":"刘克庄","text":"鸦叫方知日出东，起瞻宇宙尚朦胧。\n空花久已参诸老，岩电何须似阿戎。\n乍可一灯虚室白，绝胜千炬火城红。\n痴人苦爱清凉散，道是肝家热上攻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32313,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病中九首 其三","author":"刘克庄","text":"褚公真迹胜顽碑，曾向三茅快睹之。\n一自偏盲常面壁，甚贪小楷废临池。\n粗如太尉书姜字，俚若蒿师唱月诗。\n老去无词并恶札，感今怀昔不胜悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32314,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病中九首 其二","author":"刘克庄","text":"捲五红云一朵边，抽身偶在众贤先。\n鹤归乡倏三千岁，马老人酬八百钱。\n雅叹蒙蒙徒仰视，骚称皦皦者难全。\n殷勤寄谢文房友，愿未来生再结缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32315,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病中九首 其一","author":"刘克庄","text":"汤熨兼旬尚未瘳，灾生盈满欲谁尤。\n禁中莲炬频宣锁，閤上藜灯几校雠。\n回向真人并大士，变教师冕作离娄。\n何时眸子重清朗，短策随身处处游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32316,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病起","author":"刘克庄","text":"病起龙钟怯负犁，劣能扶杖视蔬畦。\n罢休自笑同刍狗，老去君当恕木鸡。\n孤鹤惊飞沙苑箭，群乌嗔借上林栖。\n终须觅个安巢处，万叠青山缭碧溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32317,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病起十首 其十","author":"刘克庄","text":"有粟二囷书数厨，一生受用小规模。\n要令后裔师吾俭，不愿多财使尔愚。\n旋作续书传福畤，偶成小楷付官奴。\n自惭未至韩公地，老语谆谵谩劝符。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32318,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病起十首 其九","author":"刘克庄","text":"变风而下世无诗，幼学西昆壮耻为。\n老去仅名小家数，向来曾识大宗师。\n百年不觉皤双鬓，一字谁能断数髭。\n诚叟放翁几曾死，著鞭万一许肩随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32319,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病起十首 其八","author":"刘克庄","text":"暮年字字费冥搜，少作如山弃不收。\n作美新文生失节，留封禅草死包羞。\n怀中探锦都无几，身后悬金未易求。\n懊恨新来刚制酒，世间何物可浇愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32320,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病起十首 其七","author":"刘克庄","text":"酒户诗坛聊尔耳，也吟唧唧醉陶陶。\n鲸鱼翡翠兼群体，蜾蠃螟蛉视二豪。\n京洛饮徒烦借问，江湖社友谬推高。\n可怜小杜醺酣者，浪许诗人仆命骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32321,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病起十首 其六","author":"刘克庄","text":"昔与诸贤共造廷，如风吹絮浪飘萍。\n溘先忽忽同晨露，殿后晖晖独曙星。\n未肯肩随金谷友，幸留面见草堂灵。\n伯伦旧与吾通谱，欲往从之唤不醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32322,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病起十首 其五","author":"刘克庄","text":"有四宜休七不堪，岂容华皓尚痴贪。\n固难唐突耆英社，尚可追攀老学庵。\n酷嗜蟹螯聊自酌，高悬麈尾共谁谈。\n吾闻多寿常多辱，伯始何须饮菊潭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32323,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病起十首 其四","author":"刘克庄","text":"亹亹清谈犹可听，星星短发不禁搔。\n昔如八骏走千里，今似九牛亡一毛。\n吟苦都忘年事老，寝酣始悟早朝劳。\n箕山只在人间世，尧大如天未易逃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32324,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病起十首 其三","author":"刘克庄","text":"未纵心年乞退休，年垂八十更何求。\n相方好事下白屋，帝岂无人记玉楼。\n绶未必为翁子福，扇安能障彦回羞。\n吾诗绝似渊明诔，莫遣他人弄笔头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32325,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病起十首 其二","author":"刘克庄","text":"薄有桑麻在北溪，辎车悬了驾鸡栖。\n专房安得莫愁妾，同穴除非法喜妻。\n绒挂屋梁聊藉草，萤穿窗隙胜然藜。\n谢公虚下闻筝泪，输与刘伶醉似泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32326,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病起十首 其一","author":"刘克庄","text":"架帙纵横砚有埃，先生久不至山斋。\n散花魔已降摩诘，裹饭人谁访子来。\n又与杜康绝交矣，并疏毛颖少恩哉。\n几时真得金篦力，书债重偿酒禁开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32327,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病起五首 其五","author":"刘克庄","text":"越境迎医伎又穷，残骸奉施与天公。\n外庭幸际清明始，内障如囚黑暗中。\n贝叶今难开只眼，薰弦昔忝和重瞳。\n暮年膝上惟文度，常挈书灯伴乃翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32328,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病起五首 其四","author":"刘克庄","text":"百岁将阑猛省惊，六根不足可怜生。\n古人使祝为祈死，叔世无人吊失明。\n昔挨残更羞渴睡，今当清昼要扶行。\n时于梦里瞻星斗，愁绝邻鸡腷膊声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32329,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病起五首 其三","author":"刘克庄","text":"小窗不复听吾伊，时有蛩声出吻悲。\n曲宴无歌赓太液，中痟止酒饮华池。\n谁将晓雪堆新鬓，自拨寒灰锻近诗。\n未敢热瞒同社友，草鞋尚欲远寻师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32330,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病起五首 其二","author":"刘克庄","text":"鬻文卖赋今能几，穷薄常因病折磨。\n宁作地仙事思邈，不教天女恼维摩。\n乞骸幸已逃空谷，养气难于塞决河。\n岂是先生老而健，修方多更阅医多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32331,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病起五首 其一","author":"刘克庄","text":"躬圭宝箑俱藏起，出入惟消笠与蓑。\n农说雨旸差有准，客谈间谍易传讹。\n丰年海熟田尤熟，圣代朝和野亦和。\n纵使大寒并大暑，小车时出至行窝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32332,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病起夜坐读书一首","author":"刘克庄","text":"蜀剂十杯扶胃气，南烹一箸忍馋涎。\n病梨虽以樵贺废，寿栎翻因拥肿全。\n已脱坡翁赤猴月，并逃谢傅白鸡年。\n新凉尚起亲灯兴，谁道过时已悍坚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32333,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]