[{"title":"和范倅十首 其十","author":"曹勋","text":"对雪惘然怀酒伴，萦心还复为诗魔。\n老农心念须三白，渔父家风想一蓑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64800,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和范倅十首 其九","author":"曹勋","text":"幕天席地供馀酌，惜月留云忆旧书。\n今日海边消息断，空令稚子摘芳蔬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64801,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和范倅十首 其八","author":"曹勋","text":"轻绡乍试依微巧，蜡白仍随掩苒春。\n忽得新诗知节物，衰迟浑似梦中人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64802,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和范倅十首 其七","author":"曹勋","text":"綵幡金胜袅宫云，碧甲红芽巧斗新。\n异县幽怀易牢落，强看儿女艳芳春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64803,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和范倅十首 其六","author":"曹勋","text":"喧喧暮雀啅寒枝，夜雪澄光入锦帷。\n示病维摩元不病，要收好语入新诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64804,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和范倅十首 其五","author":"曹勋","text":"岩壑未销连夜雪，松篁深映一川梅。\n忍寒故作迟迟去，只为清香特特来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64805,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和范倅十首 其四","author":"曹勋","text":"海边草芥一冬新，况复冬温接畛春。\n从此近城花渐好，不妨闲作惜花人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64806,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和范倅十首 其三","author":"曹勋","text":"缤纷剪綵庆云低，佩玉摇金冷不知。\n禁殿想趋三白贺，微和先入万年枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64807,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和范倅十首 其二","author":"曹勋","text":"当年越相有青毡，百越于今奠枕眠。\n兰玉阶庭传相业，声猷剩在日华边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64808,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和范倅十首 其一","author":"曹勋","text":"腊雪已知收岁事，快晴喜复上朝晖。\n清樽要及东城醉，趁取风光未苦飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64809,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和郑国器六首 其六","author":"曹勋","text":"小桃经雨暖成川，云锦相辉粉色天。\n摘实未医尘世病，飞霞且致洞中仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64810,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和郑国器六首 其五","author":"曹勋","text":"带雨看时意始真，谁家院落故藏春。\n不须更待溶溶月，鬓影香传缥缈人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64811,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和郑国器六首 其四","author":"曹勋","text":"湿玉吹香吐万花，先春粲粲等芳华。\n朵云不惜吟疏影，踏雪应能访我家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64812,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和郑国器六首 其三","author":"曹勋","text":"幄密花深留暖径，日融天醉泛晴芳。\n何人收向黄金榼，犹得氛氲助玉香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64813,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和郑国器六首 其二","author":"曹勋","text":"老境欣逢世路平，收回神观远逢迎。\n五更不复趋双阙，六凿都忘任七情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64814,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和郑国器六首 其一","author":"曹勋","text":"归休三径得怡颜，何所羊裘与钓竿。\n剩得新诗载行事，如游玄圃拾琅玕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64815,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和皇甫先生题唯庵","author":"曹勋","text":"十载重来春晚时，群峰献秀晓风微。\n清谈更读神仙句，一炷氲香忘却归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64816,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和贺子忱五首 其五","author":"曹勋","text":"逢时顿足念松楸，节物频迁祇佐愁。\n衰草苍烟非故里，短篷轻桨漫归舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64817,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和贺子忱五首 其四","author":"曹勋","text":"一川清露泣黄花，拜扫人归石路斜。\n我亦天涯沦落客，丘园回首乱云遮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64818,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和贺子忱五首 其三","author":"曹勋","text":"投老身同钓与渔，放怀宁较董梧锄。\n爱闲成懒心常适，习静须香意莫虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64819,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和贺子忱五首 其二","author":"曹勋","text":"樗散端如老郑迂，喜寻山水每携扶。\n归来倦卧蓬门晚，犹忆松篁巧映途。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64820,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和贺子忱五首 其一","author":"曹勋","text":"雨馀屐齿不妨泥，自课家丁细理畦。\n尚有种花移竹意，要令好鸟入春啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64821,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和钱处和大资四首 其四","author":"曹勋","text":"松窗暂向瑞岩开，便拟寻云步月来。\n只恐紫泥催去路，都俞还复咏康哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64822,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和钱处和大资四首 其三","author":"曹勋","text":"曹源一滴鉴云开，便觉星蟾动地来。\n君去我方专此兴，祇应空照话诚哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64823,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和钱处和大资四首 其二","author":"曹勋","text":"五峰懒瓒笑颜开，正欲乘闲特特来。\n十里松风一鞭稳，虎溪捉手亦奇哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64824,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和钱处和大资四首 其一","author":"曹勋","text":"迷云公已性天开，双涧相逢若再来。\n二老果能如洛下，固宜慧远赋优哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64825,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和曾舍人梅影雪意二首 其二 雪意","author":"曹勋","text":"冥冥何处认飞鸿，天地同云冷不风。\n玉蕊瑶林应在望，儿童喜入笑声中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64826,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和曾舍人梅影雪意二首 其一 梅影","author":"曹勋","text":"疏枝冷蕊欲摇春，照水铺苔不碍尘。\n莫遣移寒占窗月，窗中应有可怜人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64827,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜夜曲","author":"曹勋","text":"舞衣叠翡翠，海月挂珊瑚。\n香满流苏幄，相迎问醉无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64828,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜泊仙居客舍","author":"曹勋","text":"山寒虚籁接溪声，暮雨连空翠几层。\n寄榻若无千里梦，便如云衲一孤僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64829,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"居泉南和江给事二首 其二","author":"曹勋","text":"年来意绪奈愁何，逢著清樽不厌多。\n闻道公馀白莲社，可能疏懒许相过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64830,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"居泉南和江给事二首 其一","author":"曹勋","text":"西山爽气不谁何，政恐愁容积渐多。\n动地边声入河陇，未妨车马断经过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64831,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"松隐雨过二首 其二","author":"曹勋","text":"云笼赫日藏阳焰，人向红尘困暑风。\n山驿醒心何处是，幅巾萧散梦魂中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64832,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"松隐雨过二首 其一","author":"曹勋","text":"坐见青天变黑云，雨来海上似翻盆。\n千岩万壑方喷薄，寂历斜阳已挂门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64833,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"松窗用杜句为韵和以棋酒为意十首 其十","author":"曹勋","text":"诵公十妙语，便觉舒华年。\n意与境俱会，超凌心欲仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64834,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"松窗用杜句为韵和以棋酒为意十首 其九","author":"曹勋","text":"红尘旧老我，青秧新插为。\n宁幸田畯喜，何能属车鸱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64835,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"松窗用杜句为韵和以棋酒为意十首 其八","author":"曹勋","text":"捣香复筛辣，兵厨泻芳酒。\n天宇澄清澜，山中寄声否。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64836,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"松窗用杜句为韵和以棋酒为意十首 其七","author":"曹勋","text":"公富天人学，已收廊庙用。\n宿有云水债，聊寄泉石供。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64837,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"松窗用杜句为韵和以棋酒为意十首 其六","author":"曹勋","text":"相君有妙理，芳醪正所应。\n红妆艳绮席，翠幕张华灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64838,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"松窗用杜句为韵和以棋酒为意十首 其五","author":"曹勋","text":"小小试部勒，诚可销长日。\n汀沙点鸦鹭，局带山云湿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64839,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"松窗用杜句为韵和以棋酒为意十首 其四","author":"曹勋","text":"帘旌风不摇，博山云自度。\n主人下东山，月色转归路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64840,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"松窗用杜句为韵和以棋酒为意十首 其三","author":"曹勋","text":"游戏三昧手，绝代无对棋。\n胜负俱可喜，是中聊作痴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64841,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"松窗用杜句为韵和以棋酒为意十首 其二","author":"曹勋","text":"燕坐靡天游，何必求云将。\n泠然契至道，厩有真乘黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64842,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"松窗用杜句为韵和以棋酒为意十首 其一","author":"曹勋","text":"相君有妙趣，一切不容且。\n纹楸谁与谈，惟彼上人者。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64843,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"枕上闻杜宇","author":"曹勋","text":"催晓钟残景气清，杜鹃声里梦魂惊。\n山林广袤不知乐，犹作不如归去声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64844,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绍兴癸丑上巳日","author":"曹勋","text":"连岁羌酋不荷戈，今年禊饮喜如何。\n中兴乐事虽无象，甲子先同晋永和。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64845,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"试笔偶书二首 其二","author":"曹勋","text":"道友山间四散居，忽然相会亦旬馀。\n直须把盏如村醉，醉后歌欢更自如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64846,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"试笔偶书二首 其一","author":"曹勋","text":"家住天台水石村，四围都是给孤园。\n有时桐柏庵中去，归下层峦夕照昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64847,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送曾谹父还朝十首 其七","author":"曹勋","text":"诗源正嗣江西派，句律先空冀北群。\n从此金门玉堂去，好将雅颂启吾君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64848,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨作二首 其二","author":"曹勋","text":"倒海倾潮翻白雨，钩窗捲箔度清风。\n江山一饷惊雷静，已有闲云行碧空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64849,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨作二首 其一","author":"曹勋","text":"千峰注雨作微凉，宝殿留阴忽夕阳。\n入夏暄寒曾莫测，雷声犹震碧云傍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64850,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南园有怀","author":"曹勋","text":"江上春阴一棹闲，湿云遮袖有无间。\n轻莎细雨未归得，且看重重叠叠山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64851,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宫词三十三首 其三十三","author":"曹勋","text":"天开黄道日华明，细细南薰下太清。\n宫殿云扶龙虎气，楼台风转管弦声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64852,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宫词三十三首 其三十二","author":"曹勋","text":"上圣忧劳昔未闻，看花岂复御佳辰。\n内人闻道频相语，不见秋千已几春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64853,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宫词三十三首 其三十一","author":"曹勋","text":"湖山风月锁葱葱，涣号春回万国同。\n因使吴人沾圣泽，一齐翻入棹歌中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64854,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宫词三十三首 其三十","author":"曹勋","text":"圣德隆昌纪绍兴，稍驯逆虏会清明。\n须知不待黄河报，自有天威靖太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64855,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宫词三十三首 其二十九","author":"曹勋","text":"江淮控制接荆蛮，销患无形仗卫闲。\n蔼蔼东风符帝力，新春先到凤凰山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64856,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宫词三十三首 其二十八","author":"曹勋","text":"天德同符立极恩，绍兴亿载抚维坤。\n今年颁历更名赐，大定中区号统元。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64857,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宫词三十三首 其二十七","author":"曹勋","text":"六宫上直试罗衣，未听鞭声等驾时。\n且趁晓闲临御札，官家常是下朝迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64858,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宫词三十三首 其二十六","author":"曹勋","text":"三年不废策儒宗，清问图回自九重。\n不特赐书荣进士，圣君政本道中庸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64859,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宫词三十三首 其二十五","author":"曹勋","text":"碧甲红芽物象新，天声震耀仰尧仁。\n只应露布来非晚，移跸中原烂漫春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64860,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宫词三十三首 其二十四","author":"曹勋","text":"升旸宫里雪初消，便觉春风袭柳条。\n新酝嘈嘈泻轻碧，尽分和气浃狐貂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64861,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宫词三十三首 其二十三","author":"曹勋","text":"务农春诏将臣宣，欲翳禾麻变有年。\n圣意且耕仍且战，稍令诸道作屯田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64862,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宫词三十三首 其二十二","author":"曹勋","text":"东风拂拂到行朝，剪綵膺时下绛霄。\n不但剑歌随骑曲，行须仪凤舞云韶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64863,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宫词三十三首 其二十一","author":"曹勋","text":"嗣岁庞恩浃九垓，熙熙人物咏春台。\n行知大业同文轨，今见萧曹佐汉来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64864,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宫词三十三首 其二十","author":"曹勋","text":"溥绥圣泽浙江湄，风转行宫赤羽旗。\n责己但书农本诏，乘春岂有宴游诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64865,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宫词三十三首 其十九","author":"曹勋","text":"射殿从容御六钧，飞星白羽骇臣邻。\n莫惊压尽天山箭，自昔羌胡畏圣神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64866,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宫词三十三首 其十八","author":"曹勋","text":"宽恤从来只陆沉，丁宁今始慰人心。\n圣情更欲民孚信，亲御云章下诏音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64867,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宫词三十三首 其十七","author":"曹勋","text":"泽国春非上苑同，近郊花木漫青红。\n今知圣化敦风俗，不许移根入禁中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64868,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宫词三十三首 其十六","author":"曹勋","text":"连年逆虏断侵凌，圣运当天日正升。\n顶相如山知美谶，绍隆火德即中兴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64869,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宫词三十三首 其十五","author":"曹勋","text":"拱北星辰静守心，暂清警跸凤凰深。\n萧条梅柳春如许，可复风烟比上林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64870,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宫词三十三首 其十四","author":"曹勋","text":"中兴仁泽浃华夷，则百斯男自可知。\n例诏高禖祭春社，掖庭应已梦熊罴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64871,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宫词三十三首 其十三","author":"曹勋","text":"滔天逆党作兵端，坐致酋渠诏意宽。\n咸与惟新皆赤子，释囚尽复汉衣冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64872,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宫词三十三首 其十二","author":"曹勋","text":"潮随春涨雪千寻，南越山藏暗浪深。\n欲识钱塘两回汛，便如万国奉君心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64873,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宫词三十三首 其十一","author":"曹勋","text":"女裳缘饰丽青红，俗竞浮华废百工。\n圣意与民敦俭素，尽除金翠复淳风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64874,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宫词三十三首 其十","author":"曹勋","text":"元正不贺自清衷，睿札频颁念两宫。\n天相吉音来自北，便知孝悌与天通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64875,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宫词三十三首 其九","author":"曹勋","text":"兰亭久已昧精粗，睿藻传模字一如。\n莫更坚珉求定本，且瞻奎画看临书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64876,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宫词三十三首 其八","author":"曹勋","text":"山迥江回地少尘，方州桃李不成春。\n要知驻跸非闲暇，看取君王苏远民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64877,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]