[{"title":"对月赠答二首 其一","author":"赵蕃","text":"闺中月是天涯月，照妾遥知亦照君。\n月解令人千里共，人能似月两头分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47234,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"对梅有作六首 其六","author":"赵蕃","text":"寥落江山无故人，见梅忆著故园春。\n水南水北寻诗地，想见风流一幅巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47235,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"对梅有作六首 其五","author":"赵蕃","text":"日未落时香未归，晚风方觉雪霏霏。\n月明纵可形模似，不比风流殆庶几。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47236,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"对梅有作六首 其四","author":"赵蕃","text":"酒恶思茶更炷香，不如梅蕊嚼冰霜。\n文园病渴知如此，未遽骑鲸返帝乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47237,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"对梅有作六首 其三","author":"赵蕃","text":"老来诗兴苦无多，折得梅花奈若何。\n便恐飘零不堪触，正须绕树数婆娑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47238,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"对梅有作六首 其二","author":"赵蕃","text":"四十飞腾暮景斜，更云学易数年加。\n勿谓衰催便欺我，尚能高兴属梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47239,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"对梅有作六首 其一","author":"赵蕃","text":"剩欲将梅月下看，却愁风露不胜寒。\n有时暂作披衣看，积雪凝霜不可干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47240,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"归近","author":"赵蕃","text":"黄溪潭上晚风生，吹我孤舟直又横。\n归近尚馀三十里，不妨待得月同行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47241,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"正月九日微雪二首 其二","author":"赵蕃","text":"小雨因风冻作花，冰梢争竞出槎牙。\n携筇偶作巡檐去，徙倚微吟低帽纱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47242,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"正月九日微雪二首 其一","author":"赵蕃","text":"霰雪纤纤晚倍寒，梅花清瘦不禁看。\n小园准拟寻诗去，少待侵苔屐齿乾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47243,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"正月二十二日晚过袁父","author":"赵蕃","text":"篱落桃花小破红，野田细雨又微风。\n莫嗤款段行难进，正要寻诗漠漠中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47244,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"永丰尉治神祠前梅已成阴忽著花七出而无鄂色又正白众咸异之尉上蔡谢君子畅有诗蕃次韵","author":"赵蕃","text":"谢君为吏清如水，神吐祠前不鄂花。\n我欲将诗道其事，却防流咏入京华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47245,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"永和道中怀成父","author":"赵蕃","text":"风帆十幅空百滩，布衾高卧宁知寒。\n连明风雨晓增剧，叹我山行逢路难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47246,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玉山久旱七月一日雨作望者云从常山来时赵吏部赴福州适入境已闻境上大雨取书邦人欢喜之词为口号二首呈之 其二","author":"赵蕃","text":"父老争迎旧使君，使君何以为吾民。\n要须一举为霖手，快泻天瓢洗旱尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47247,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玉山久旱七月一日雨作望者云从常山来时赵吏部赴福州适入境已闻境上大雨取书邦人欢喜之词为口号二首呈之 其一","author":"赵蕃","text":"一雨胡为限古城，定应留逐使君行。\n前驱尚远毋庸遽，已见萧萧破久晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47248,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玉聚","author":"赵蕃","text":"介然谁主复谁宾，风月婆娑却自亲。\n留得清名传野史，未妨白眼向时人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47249,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"生米矶之至德观余旧游也尝有题钓矶胡柏七言二绝句庚子夏五月八日再来道士复向余乞赋仙洲平远濯风涌月四题因各与一首 其三","author":"赵蕃","text":"往游故喜秋无暑，今至还欣夏有凉。\n褦襶不能来热客，泠然听我梦还乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47250,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"生米矶之至德观余旧游也尝有题钓矶胡柏七言二绝句庚子夏五月八日再来道士复向余乞赋仙洲平远濯风涌月四题因各与一首 其二","author":"赵蕃","text":"旧闻但觉生米矶，新游更见黄连石。\n石边矶上有轩窗，万里一时来咫尺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47251,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"生米矶之至德观余旧游也尝有题钓矶胡柏七言二绝句庚子夏五月八日再来道士复向余乞赋仙洲平远濯风涌月四题因各与一首 其四","author":"赵蕃","text":"团团政尔来天下，皎皎何从堕水中。\n剩欲学为牛渚咏，只愁笑杀绮裘翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47252,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"生米矶之至德观余旧游也尝有题钓矶胡柏七言二绝句庚子夏五月八日再来道士复向余乞赋仙洲平远濯风涌月四题因各与一首 其一","author":"赵蕃","text":"此地传为天宝门，政由渔叟话桃源。\n阁中名字谁为立，知是君平几世孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47253,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用一代不数人百年能几见为韵诗赋十章呈陈君举 其五","author":"赵蕃","text":"云物瞻闽峤，风声望海滨。\n如何一年内，顿得见斯人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47254,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用一代不数人百年能几见为韵诗赋十章呈陈君举 其二","author":"赵蕃","text":"公乎不为文，为必行于代。\n诵习孰其人，儿童兼老辈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47255,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用一代不数人百年能几见为韵诗赋十章呈陈君举 其七","author":"赵蕃","text":"山色仍前日，梅花又一年。\n休为招屈些，好泛渡湘船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47256,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用一代不数人百年能几见为韵诗赋十章呈陈君举 其一","author":"赵蕃","text":"东南固多贤，莫与永嘉匹。\n王郑已骑鲸，辈流公第一。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47257,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用一代不数人百年能几见为韵诗赋十章呈陈君举 其八","author":"赵蕃","text":"少小耽文字，初非哲匠能。\n空令为己学，老矣见何曾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47258,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用洪觉范诗为首作四绝 其二","author":"赵蕃","text":"钓舟无事白鸥閒，自是江湖境界宽。\n我欲汎然随所往，竹君谁与报平安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47259,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用洪觉范诗为首作四绝 其三","author":"赵蕃","text":"个中著我添图画，能画今谁如辋川。\n但写一蓑仍一笠，不须羽服记蹁跹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47260,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用洪觉范诗为首作四绝 其四","author":"赵蕃","text":"便似华亭落照湾，要人弹压愧诗孱。\n馀霞散尽空无绮，新月初升势已弯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47261,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"田家即事八首 其八","author":"赵蕃","text":"田夫荷锸去，乘水护田缺。\n田妇贳酒归，相与慰勤力。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47262,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"田家即事八首 其七","author":"赵蕃","text":"下田已鸥没，上田更龟坼。\n欲知雨未已，看取云泼墨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47263,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"田家即事八首 其六","author":"赵蕃","text":"老屋愁风破，空林过雨乾。\n飘零黄叶满，寂寞野香残。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47264,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"田家即事八首 其五","author":"赵蕃","text":"行役渠怜我，生涯我羡渠。\n太平今有象，随寓即吾庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47265,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"田家即事八首 其四","author":"赵蕃","text":"波静童闲笛，舟横翁卖鱼。\n村村皆乐业，处处尽安居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47266,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"田家即事八首 其三","author":"赵蕃","text":"社鼓村村急，春流岸岸高。\n双分待鱼鹭，红认隔溪桃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47267,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"田家即事八首 其二","author":"赵蕃","text":"十载溪山梦，一川桃李花。\n春深犹是客，几日定还家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47268,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"田家即事八首 其一","author":"赵蕃","text":"水汎将晴雾，山行欲雨云。\n鸥翻随渚见，鸡近隔林闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47269,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"白水寺","author":"赵蕃","text":"雾合深林晓到迟，树摇宿雨讶晴曦。\n不知客里何迁次，一似山中初起时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47270,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"白发三首 其三","author":"赵蕃","text":"少年志愿立修名，隐显悠悠略未成。\n倚赖少陵诗不误，白间会有黑丝生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47271,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"白发三首 其二","author":"赵蕃","text":"叶落归根莫漫悲，春风解发次年枝。\n人如草木空多智，一老宁闻再少时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47272,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"白发三首 其一","author":"赵蕃","text":"忆昨鬓毛殊未白，斑斑已复见于诗。\n天公嫌汝底相耗，故遣齐生不待衰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47273,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"白雾溪","author":"赵蕃","text":"雾雨犹疑合，槎头不可窥。\n凶年走牲酒，平旦但茅茨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47274,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"石门坞","author":"赵蕃","text":"溪已曲更曲，坞仍深更深。\n端居与奚自，出处各何心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47275,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"石井有感","author":"赵蕃","text":"岁月不可玩，变迁何所无。\n青衫今白发，泉谷乃官途。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47276,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"示梅山宁老二首 其二","author":"赵蕃","text":"八年再到仍冲暑，长愧堂中结夏僧。\n我欲松间借馀地，听风听雨发鬅鬙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47277,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"示梅山宁老二首 其一","author":"赵蕃","text":"梅山不见梅夫子，宗派仍亡宗上人。\n梅句不刊宗有集，山应生喜亦生嗔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47278,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"示曾耆英并其侄","author":"赵蕃","text":"伴我山行陈与吴，曾家父子更怜渠。\n武山碾得雪相似，来酌观山冰不如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47279,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"立春 其二","author":"赵蕃","text":"昨日元正今日春，佳辰并作一番新。\n试看柳色遽如许，无耐梅花憔悴人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47280,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"立春 其三","author":"赵蕃","text":"春日每颁宽大诏，天公意与圣人同。\n故于半载焦枯后，一雨聊资土脉通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47281,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"立春 其一","author":"赵蕃","text":"腊中要雪逢三白，春日还沾雨似膏。\n天意于农亦良厚，何须耒耜我家操。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47282,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"立春日小饮","author":"赵蕃","text":"今日青春立，今年白发多。\n酒杯欺我老，梅朵奈渠何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47283,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"仲春杂书二首 其二","author":"赵蕃","text":"二月倏已尽，一春馀几多。\n不知花过矣，谁问病如何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47284,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"仲春杂书二首 其一","author":"赵蕃","text":"社公能作雨，社子复成晴。\n日薄风仍薄，花明柳亦明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47285,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"全真以斯远所寄文卷后夜赋两绝句元韵作诗寄斯远蕃同之 其一","author":"赵蕃","text":"甘林彼美露初团，纵小犹堪白玉盘。\n叹息菊黄虽可待，孤根失所漫荒寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47286,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"全真以斯远所寄文卷后夜赋两绝句元韵作诗寄斯远蕃同之 其二","author":"赵蕃","text":"行时取别太匆匆，别后经怀数载中。\n赖有书函与文卷，不然何地可闻风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47287,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再来江下示成父","author":"赵蕃","text":"七郎堂下渡船开，岂料今晨又再来。\n吴水越山看未足，未妨兄弟与衔杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47288,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再蒙签判丈惠示惜花三绝句因次韵 其二","author":"赵蕃","text":"佛屋支撑仅可间，过门无客客非残。\n公能有意重来否，竹涧松门暖不寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47289,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再蒙签判丈惠示惜花三绝句因次韵 其三","author":"赵蕃","text":"兰馨岂亦竞春狂，不为无人废不芳。\n长使幽居在空谷，也胜半额趁时妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47290,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再蒙签判丈惠示惜花三绝句因次韵 其一","author":"赵蕃","text":"花飞忽忽减芳菲，欺我新来诗思迟。\n笔底羡君能捷敏，好词频许坐中披。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47291,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再赠","author":"赵蕃","text":"众醉纷纷忌独醒，也思放意遣沈冥。\n斗牛用事无庸问，为问何年用酒星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47292,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冲雨投宿石佛院次季承留题韵二首 其二","author":"赵蕃","text":"石佛如今安在哉，至人无往亦无来。\n山僧顾欲谈遗迹，说道空岩闭不开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47293,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冲雨投宿石佛院次季承留题韵二首 其一","author":"赵蕃","text":"尘埃彷佛前朝寺，客子今缘避雨来。\n欲访当时漫亡得，绿丛蕉并野花开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47294,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同何叔信赴在伯之集醉甚既归得二绝句并呈 其二","author":"赵蕃","text":"已向剡溪冲夜雪，要从东阁问官梅。\n气豪湖海宁辞醉，老怯风霜祇自哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47295,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同何叔信赴在伯之集醉甚既归得二绝句并呈 其一","author":"赵蕃","text":"醉里狂歌君不嗔，知予嗜酒见天真。\n还家径卧寒窗底，要暖编麻更■薪。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47296,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同徐斯远看王远父所藏僧圆契梅二首 其二","author":"赵蕃","text":"炎天梅蕊简斋诗，坐胜山村雨雪时。\n闵雨正歌云汉句，忽来为我起凉思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47297,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同徐斯远看王远父所藏僧圆契梅二首 其一","author":"赵蕃","text":"西轩宜热竹能藏，雨落何方此自凉。\n已对西湖冰雪句，一时顿有更徐王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47298,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"回憩芙蓉寺偶题","author":"赵蕃","text":"太华难攀十丈花，白莲零落远公家。\n此中那得嘉名占，绿水绕除山四遮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47299,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"因汤莘夫行寄欧阳伯威","author":"赵蕃","text":"传得新诗过半年，故应松柏尚苍然。\n要持尊酒为君寿，邂逅门前有过船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47300,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"因翟子固行送酒杨谨仲","author":"赵蕃","text":"君行为觅清江宅，水竹依依自作邻。\n问字未能从好事，一壶聊为乞诗陈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47301,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"在伯考试未归有怀 其二","author":"赵蕃","text":"相逢共问别来诗，作计君能似我痴。\n佳月中秋已无及，菊花十月未为迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47302,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"在伯考试未归有怀 其三","author":"赵蕃","text":"行路悠悠自有诗，君行况乃暮秋时。\n复萌鄙吝疏黄宪，都尽利名亲紫芝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47303,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"在伯教授为考试之行不知其地漫成五诗送之 其四","author":"赵蕃","text":"平生未识荆州牧，诗卷记评王进之。\n铃阁纵谈询保社，幸无过语恐遭嗤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47304,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"在伯教授为考试之行不知其地漫成五诗送之 其三","author":"赵蕃","text":"君行不到武昌下，别驾西京刘更生。\n但想新知作倾倒，莫闻高论吐峥嵘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47305,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"在伯教授为考试之行不知其地漫成五诗送之 其二","author":"赵蕃","text":"已孤万古中秋月，为约黄花九日杯。\n但得交情常旧雨，不辞尊酒理新醅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47306,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"在伯教授为考试之行不知其地漫成五诗送之 其五","author":"赵蕃","text":"峡州使君我所亲，书去犹新报未闻。\n此士如今为第一，见之烦为致慇勤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47307,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"在伯教授为考试之行不知其地漫成五诗送之 其一","author":"赵蕃","text":"雨后翛然遂欲秋，登临正尔要诗流。\n君行端复何所往，但道东之一舸游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47308,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"孙季章无愧郑季奕徐斯远以仆留智门载酒见过坐中雪作三诗 其一","author":"赵蕃","text":"出山已与晓寒冲，下马频欣束缊逢。\n已见南山行更钝，到时山寺已昏钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47309,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]