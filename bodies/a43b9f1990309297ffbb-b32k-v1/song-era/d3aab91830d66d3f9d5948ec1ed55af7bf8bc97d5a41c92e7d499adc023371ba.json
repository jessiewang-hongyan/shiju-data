,"commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30407,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清醒","author":"薛嵎","text":"独怀忠愤赴湘中，举国昏昏志不同。\n渔父笑君君亦笑，烟波相望各西东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30408,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渔村杂句十首 其十","author":"薛嵎","text":"白云相顾尚依依，十载江湖负宿知。\n时事未容轻所学，山中依旧只吟诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30409,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渔村杂句十首 其九","author":"薛嵎","text":"猿鹤何曾肯受羁，偶来亭畔立多时。\n物情未到忘机地，步步行行只自疑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30410,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渔村杂句十首 其八","author":"薛嵎","text":"野水微茫路欲迷，重重沙渚自高低。\n鹭鸶飞过无心泊，直入残阳树杪栖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30411,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渔村杂句十首 其七","author":"薛嵎","text":"三五人家住一湾，近城无路去来难。\n溪边自结同吟友，松柏青青到岁寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30412,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渔村杂句十首 其六","author":"薛嵎","text":"泽畔行行歌楚骚，一襟忠愤付湘涛。\n难教举世无醒者，莫羡渔翁活计高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30413,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渔村杂句十首 其五","author":"薛嵎","text":"月下门开不用敲，渡头长系木兰桡。\n盘餐市远从真率，会宿何妨屡卜宵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30414,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渔村杂句十首 其四","author":"薛嵎","text":"青山如主复如宾，相对无言意自真。\n富贵不应忘此味，从来世上少闲人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30415,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渔村杂句十首 其三","author":"薛嵎","text":"尽醉茅柴得自由，芦花飞雪满人头。\n蓑衣碎叶重重补，听雨吟风卒未休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30416,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渔村杂句十首 其二","author":"薛嵎","text":"非智非愚浪著鞭，前程倒指事茫然。\n临流一洗巢由耳，独立斜阳认钓船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30417,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渔村杂句十首 其一","author":"薛嵎","text":"莫论尘土与烟霞，收拾襟怀即我家。\n絮帽蒙头霜月下，水村深夜看梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30418,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渔村杂诗十首再和前韵 其二","author":"薛嵎","text":"兰菊分畦笋作鞭，南山相对意悠然。\n城中有路何曾入，只许苍头趁钓船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30419,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渔村杂诗十首再和前韵 其五","author":"薛嵎","text":"巡檐脩竹晚风敲，古寺僧归月下桡。\n童子闭门无一事，只须清坐过中宵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30420,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渔村杂诗十首再和前韵 其六","author":"薛嵎","text":"微吟朗咏足风骚，切莫危言试怒涛。\n云本无心泉自洁，不因作意立名高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30421,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渔村杂诗十首再和前韵 其七","author":"薛嵎","text":"生涯小小落溪湾，妻子知时不说难。\n毕竟直钩为计拙，晚来无酒可销寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30422,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渔村杂诗十首再和前韵 其九","author":"薛嵎","text":"雉入樊笼马受羁，低头犹怕欠趋时。\n人心到此无真识，未必人疑先自疑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30423,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渔村杂诗十首再和前韵 其八","author":"薛嵎","text":"暝色和烟四望迷，仰眠牛背觉天低。\n村翁遥指笙歌处，此地鱼沉鸟不栖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30424,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渔村杂诗十首再和前韵 其三","author":"薛嵎","text":"此身闲却有来由，白发中年已上头。\n莫道无官无可弃，从今放下一齐休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30425,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渔村杂诗十首再和前韵 其一","author":"薛嵎","text":"晴空万里散馀霞，一叶渔舟稳似家。\n学道未能全寡欲，水边隙地亦栽花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30426,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渔村杂诗十首再和前韵 其十","author":"薛嵎","text":"岁寒无物可相依，惟有梅花似故知。\n名世何曾在科甲，西湖处士只吟诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30427,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渔村杂诗十首再和前韵 其四","author":"薛嵎","text":"独作渔樵最上宾，土风淳朴物情真。\n鲍家兄弟皆和乐，林子诗豪胆压人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30428,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"黄蜀葵","author":"薛嵎","text":"娇黄无力趁芳菲，待得秋风落叶飞。\n空有丹心能就日，年年憔悴对斜晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30429,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"越僧一书记索赋二绝 其二 月泉","author":"薛嵎","text":"月色泉声境自真，有身终不惹埃尘。\n山中受用祇如此，住者知为澹泊人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30430,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"越僧一书记索赋二绝 其一 松风阁","author":"薛嵎","text":"何处笙箫起半空，满山斜日动蛟龙。\n老僧无语凭栏久，过尽白云千万重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30431,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"廉村薛庭芝诉贫于余余亦贫不能周之赠以是诗","author":"薛嵎","text":"两穷相值愁无计，同是开元补阙孙。\n百世清风于此在，莫将贫悴对人言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30432,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新春感怀五首 其五","author":"薛嵎","text":"多置田园占好官，妻儿奴婢尽生欢。\n贫家有子才堪教，身后穷愁且放宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30433,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新春感怀五首 其四","author":"薛嵎","text":"新种黄精助晚粮，生涯小小拙何妨。\n春风吹鬓不重绿，白日笑人长自忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30434,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新春感怀五首 其三","author":"薛嵎","text":"自悔中年废读书，馀生祇可业樵渔。\n青山白屋笑归去，从我高眠百事疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30435,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新春感怀五首 其二","author":"薛嵎","text":"儿女添年暗自欣，不知婚嫁逼侬身。\n羹藜衣褐由天分，莫负当初种德人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30436,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新春感怀五首 其一","author":"薛嵎","text":"新春风物旧山川，老大情怀一惘然。\n桃树不知秦世换，落花流水自年年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30437,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"湖外别业四咏 其四 蓑衣步","author":"薛嵎","text":"水浸石根冷，风吹藤叶飞。\n菰蒲秋影里，长趁钓船归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30438,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"薛野鹤","author":"薛嵎","text":"瘦形如鹤头如雪，流浪江湖岁月深。\n但是胸中有丘壑，何分城市与山林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30439,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠渔者","author":"薛嵎","text":"几度看山愧白鸥，身名心事两悠悠。\n何如醉醒寒江上，风捲芦花雪满头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30440,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"囊萤 其二","author":"薛嵎","text":"残星数点照科斗，此事分明属后生。\n记得年时头未雪，夜窗不觉又三更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30441,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"囊萤 其一","author":"薛嵎","text":"山中不羡青藜贵，清梦何曾到石渠。\n裁得綀囊连夜喜，儿童也学裹衣裾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30442,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"入京逢故人","author":"薛嵎","text":"长贫复羁旅，共爽十年欢。\n在世谁无累，如君事独难。\n蹴居怜火后，多病卧春残。\n纵决归山计，烟萝不疗寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30443,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"万象亭","author":"薛嵎","text":"年年此地驻吟鞍，十万人家指掌宽。\n天上星辰依旧远，山中松桂不知寒。\n月生沧海一轮静，云泊阑干片影残。\n见说亭基从古在，拟将图志试寻看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30444,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"下第","author":"薛嵎","text":"寸晷场中较尺寻，荣亲无路泪盈襟。\n一贫谁过箪瓢巷，百口难宽儿女心。\n昨梦重圆知误喜，平生失计为工吟。\n近来文体尤趋薄，古道何由可语今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30445,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"下第归故园","author":"薛嵎","text":"扁舟摇荡水心村，几度烟波入梦魂。\n猿鹤认名听号令，渔樵执礼叙寒温。\n浮生多事景逾促，自古求人道不尊。\n莫为穷途妨旷达，定应束帛贲丘园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30446,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山中","author":"薛嵎","text":"依然木石居，造物任乘除。\n时事今休问，山中计不疏。\n泉声增雨后，禽语变春初。\n吟得诗名世，终身甘荷锄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30447,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山中","author":"薛嵎","text":"长日山中坐，白云应笑人。\n浮生尘未脱，至老趣难真。\n身在影犹赘，年丰家自贫。\n莫将吟事废，柳色已知春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30448,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山中古松","author":"薛嵎","text":"曾经雷斧劈，上有鹘巢腥。\n过客谁摽纸，山精此托灵。\n虬龙云际顶，龟鸟土中苓。\n月夜境荒寂，秋声不可听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30449,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山中吟","author":"薛嵎","text":"疏拙本天性，束书归旧林。\n世人皆失笑，泉石自知心。\n山柿红犹涩，池鱼静亦沉。\n于中观物意，吾道乐弥深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30450,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山中遇雨","author":"薛嵎","text":"草荒泥磴滑，老病厌扶持。\n雨逐云先后，路随山险夷。\n天寒禽自浴，屋漏榻频移。\n吟事愁无绪，梅花意亦悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30451,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居有感","author":"薛嵎","text":"无忮复无求，山林终自由。\n雪飞犹欠积，云住欲相留。\n朋友疏因数，功名喜亦忧。\n休休亭记在，此是死前休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30452,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居述怀","author":"薛嵎","text":"山瓢动瀑冰，一枕曲肱清。\n未遇勤求日，非沽隐逸名。\n梅边月在水，寒夜酒如兵。\n悟得乘除数，贫中心自平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30453,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居简饮冰友清溪槐径二弟","author":"薛嵎","text":"别后全无梦，寄书安得频。\n谁怜独往意，天弃苦吟人。\n债长新年息，贫欺渐老身。\n入林知未密，犹与俗相亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30454,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"己亥大旱官催秋苗甚急","author":"薛嵎","text":"立秋才一日，期会到林泉。\n已悟征苗意，曾吟喜雨篇。\n饥锄山草尽，暍汲井泥坚。\n闻道邻州牧，忧民夜不眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30455,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中秋家人玩月","author":"薛嵎","text":"年年照离别，今夕喜团栾。\n不是人心异，全胜昨夜看。\n八荒同皎洁，列宿让清寒。\n自有银河路，乘槎到不难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30456,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"为张上翁赋松交","author":"薛嵎","text":"之人梅竹操，抱此岁寒心。\n古道久不作，高风独在今。\n无言欣意会，肥遁爱山深。\n我亦萧闲者，从君涧壑吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30457,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"为迪上人赋寒倚","author":"薛嵎","text":"山僧爱脩竹，种此出嚣尘。\n霜雪不知苦，岁时长自春。\n定回闲坐石，风过动吟身。\n傥欲求归止，清虚即道真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30458,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]