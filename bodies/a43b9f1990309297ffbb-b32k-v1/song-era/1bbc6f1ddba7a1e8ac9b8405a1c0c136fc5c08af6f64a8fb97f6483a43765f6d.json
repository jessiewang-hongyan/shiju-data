[{"title":"次王帅韵","author":"陈造","text":"使君觞客及公荣，慰我他时渴德深。\n已为穆生重设醴，更闻正始嗣遗音。\n打围红袖留连舞，论槛黄花取次簪。\n恰似雄边台上醉，回头岁月叹侵寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19240,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次王帅韵后诗呈叶教授 其一","author":"陈造","text":"业履冰壶器镆邪，元戎韬略况儒家。\n功名自昔须横草，南北于今赖灌瓜。\n村墅稻田黄罢亚，塞垣榆树老丫叉。\n为公著意收诗稿，传与中都万口誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19241,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次王帅韵后诗呈叶教授 其二","author":"陈造","text":"功名回首负年华，梨枣诸雏未克家。\n老计生涯须下泽，才非世用但匏瓜。\n为儒仅博肱三折，谋食宁羞手一叉。\n青眼故人犹念此，肯持巴唱向人誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19242,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次王仲衡尚书韵","author":"陈造","text":"著脚功名马络头，人生君所几居州。\n惟公德操朱弦直，映世冰壶白月秋。\n久已短长冥尺寸，可须肮脏羡伊优。\n即今千里讴谣地，赢得挥斤五凤楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19243,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次瓜州","author":"陈造","text":"云曀平山塔，烟明老濞城。\n客行判费日，舟泊细论程。\n闸水清兼浊，潮天雨复晴。\n未须归有梦，午枕惬凉生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19244,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次沈倅韵呈王漕","author":"陈造","text":"王家流庆水倾东，不独乌衣纪数公。\n天畀臧孙当有后，人迟汲直未居中。\n凤巢衮衮九文羽，鹏路摇摇万里风。\n隔坐从今几云母，定知周鲁各元功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19245,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次陈宰韵","author":"陈造","text":"觥筹交错舞僛僛，晓色侵窗客未知。\n便整醉魂乘款段，尚馀吟兴属酴醾。\n还家拟趁宝璎珞，唤客重乾金屈卮。\n著意风烟与调护，免教花意恨归迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19246,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次陈梦锡韵二首 其二","author":"陈造","text":"思君采艾叹如年，眼底羁愁只自煎。\n破梦有来惊剥啄，冲泥径欲跨连钱。\n新篇端复千年计，旧集犹须百手传。\n早晚聚头三日语，麈边闲听有源泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19247,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次陈梦锡韵二首 其一","author":"陈造","text":"薄雪晶瑩压屋茅，未须桂玉计晨庖。\n已便盐絮明愁眼，更喜乌鸢得夜巢。\n小听骚人赋梁苑，旋看春意满东郊。\n忍寒便拟寻梅去，梦想瑶英点旧梢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19248,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次林计议喜雪韵","author":"陈造","text":"雪缟长空纻带翻，数知冬意未阑残。\n岁功告瑞须三白，客子凭高耐一寒。\n拍塞闲郊瑶圃阔，晶荧危堞玉龙蟠。\n归来冻坐追清赏，重把君诗剪烛看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19249,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次前韵谢胡运属二首 其二","author":"陈造","text":"炉烟袅袅上晴丝，伴阅长须送似诗。\n眼著昏花予已老，句锵哀玉子能奇。\n随人趋步庸非俗，取意妆梳自入时。\n大手只宜台閤里，不应犹话鹿门期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19250,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次前韵谢胡运属二首 其一","author":"陈造","text":"耐暑初宵露白头，诗来分我一襟秋。\n露飞琼滴漙苍竹，月漾金波冰小楼。\n政用桐君弦白雪，便烦从事到青州。\n此怀未满须笺与，更为狂生赋远游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19251,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵赵夷仲 其二","author":"陈造","text":"坐听严更一再通，卓肩搜句夜虫同。\n拜嘉杰作开囊锦，似为衰翁疗首风。\n紫诰君宜步西掖，苍颜我欲隐东蒙。\n鞬櫜文陈甘三舍，百胜将军正总戎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19252,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵赵夷仲 其一","author":"陈造","text":"赵侯才望屹撑空，肯我过从笑语同。\n妙论全胜十年读，清篇分饷一襟风。\n珷玞可用酬昆璞，涎颡何曾梦锦蒙。\n莫把诗声陵此老，迟君谒帝画平戎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19253,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次赵解元韵 其二","author":"陈造","text":"兴刘止用一编书，万轴垂签或腐儒。\n表表君今超北学，多多我已悔东隅。\n声华看续诸公后，尔雅深知一笔无。\n缩手袖间真老矣，灌园蓄㹀了朱愚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19254,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次赵解元韵 其一","author":"陈造","text":"养病年来懒著书，逢人掉臂睨迂儒。\n愁边好客从天下，谭处清风起座隅。\n愧我多言终不近，似君知已未应无。\n酸咸嗜好虽殊禀，政恐渠侬诮太愚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19255,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次诸公韵","author":"陈造","text":"回首舟餐野店栖，何殊子美咏青泥。\n朅来贤将先回盼，径上诗坛许命题。\n举白烂陪山简醉，凝香到有武陵迷。\n异时过计今方悔，曾虑谈间彼子西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19256,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次宿北阿韵","author":"陈造","text":"闻道篮舆去，遥岗复近阿。\n诗应吊孝逸，碑或赞头陀。\n静者官糊口，公朝礼作罗。\n怜君日阡陌，尘土扑阴何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19257,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次崔帅韵","author":"陈造","text":"虎塞风云自壮怀，诗坛尤见不凡才。\n至音忽作锵金发，急笔宁须击钵催。\n属餍重尝项上脔，拜嘉如嗅陇头梅。\n还家定遣比邻怪，珠璧光芒重载回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19258,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次喜雨韵","author":"陈造","text":"被旱农家怒伏龙，衰翁岁望甚于农。\n人方半菽延朝夕，我亦频年阙釜钟。\n洒润似惊萁火冷，骤寒不贷布衾重。\n有来喜雨清新句，一笑令人失病容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19259,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次曾左司韵赠俞德瑞","author":"陈造","text":"班荆同冒软红尘，一种东风两样春。\n隽饮放君颜似赭，幽居怜我鬓如银。\n简编自诳供良夜，要襋渠今有好人。\n把酒若歌归缓缓，不妨折简唤东邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19260,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵什邡马主簿二首 其二","author":"陈造","text":"纷纷过眼甚螽斯，胆掉惊逢骥騄驰。\n献替付君温省树，朝晡还我故山芝。\n荆江蜀栈聊舒啸，卷耳思齐正采诗。\n回首定传天上信，囊荷知傍紫皇持。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19261,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵什邡马主簿二首 其一","author":"陈造","text":"陶谢前踪一笔追，掀天声价旧风驰。\n瑞时不数九文羽，换骨疑餐三秀芝。\n蜚电烛岩方左席，明珠照乘忽清漪。\n裹创瞢欲凌坚阵，可讳含毫不自持。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19262,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵元卿二首 其二","author":"陈造","text":"笑携佳句又冲寒，政用消忧觞咏间。\n酒贱粗能留子醉，食贫未暇惨予颜。\n搜诗杜老方须药，强项萧生且抱关。\n旧约偶耕犹念否，霜林雪竹正斓斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19263,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵元卿二首 其一","author":"陈造","text":"君自才高与世疏，我顽能使此溪愚。\n医师久已肱三折，赋客枵然屋四隅。\n莫道十年同好恶，相过一笑间忧虞。\n胸中圭角今馀几，诗胆由来已破觚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19264,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵方秘正 其二","author":"陈造","text":"小窗危坐正凝愁，诗客华编肯见投。\n明月拜嘉千斛赐，清风分送一襟秋。\n路迷端倚司南驾，金换还随过海舟。\n誇与湖山须快读，涌金门外倚曾楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19265,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵方秘正 其一","author":"陈造","text":"静女无媒未易昏，幽人乐地但琴樽。\n诗声况自推侯喜，墙仞悬知陋叔孙。\n拜手行申不敏谢，慕贤正黯索居魂。\n拘拘泄柳非君匹，老子来时肯闭门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19266,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵王知军夜坐有怀","author":"陈造","text":"梦想天兵下不其，壮心摇荡受风枝。\n摄衣试作听鸡舞，穷我庸非造物儿。\n腰下谁悬苏子印，城中人笑董生帷。\n西来江左夷吾在，小敌才堪剑首吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19267,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵王编修二首 其二","author":"陈造","text":"老誓捐书断苦吟，君苗笔砚戴逵琴。\n因君又试推敲手，揆我终惭缴绎音。\n漫作蠹鱼餐朽策，倏听鹎鵊语中林。\n肉台盘客曾丁字，碧酒留宾听浅深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19268,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵王编修二首 其一","author":"陈造","text":"落手新诗吮复吟，自甘壁角挂枯琴。\n祈光已吸金茎露，张野俄聆帝乐音。\n疗我平生风雅渴，放君高步隽英林。\n人间梦想珊瑚树，龙护灵湫万仞深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19269,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵王签判","author":"陈造","text":"奥学闻君不近名，声华犹是压时英。\n诗篇向我肯挥扫，句法惊人浑老成。\n未厌泛莲依卫幕，只今荐鹗达周京。\n明朝置酒当投辖，万斛洪源看倒倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19270,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵王签判二首 其二","author":"陈造","text":"五鬼侵陵两鬓苍，振穷扫白分无妨。\n酒徒丛里投名懒，诗社中间趁课忙。\n尘暗凤笙空自叹，风惊雁字不能行。\n向君草草追强韵，政复通人笑楚狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19271,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵王签判二首 其一","author":"陈造","text":"客中谁者伴闲身，祇有苍槐与翠筠。\n回首昔游惊梦断，故人重见倍情亲。\n簿书简省官居好，月露清圆句语新。\n千里相思匪天意，聚头一笑此何因。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19272,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵王漕起秀亭","author":"陈造","text":"梦蹑常山万仞巅，宝符千载尚依然。\n乌孙有底枭凭夜，赤子能忘蚁就膻。\n正朔会须还禹服，登临聊复对吴天。\n明年重放危亭目，万旅公方北首燕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19273,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵归路微雪","author":"陈造","text":"卓荦康时略，昂藏报主身。\n冲风还按辔，飞雪却宜人。\n帝渥先春遍，诗题触目新。\n行行何样好，归路玉为尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19274,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵石湖居士见梅","author":"陈造","text":"东风犹是玉为尘，静女冰肌小带皴。\n尚压芳华擅春事，枉当穷腊议花神。\n仙姿绝俗遗群妒，鼎实收功看一新。\n疏影暗香吾袖手，且容诗伯继黄陈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19275,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵石湖居士瓶中早梅二首 其二","author":"陈造","text":"罗帷护春色，群木未昭苏。\n绝胜翻香坐，聊陪琢句臞。\n天资便静独，冰影倚空无。\n后夜逢姑射，仙家白玉壶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19276,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵石湖居士瓶中早梅二首 其一","author":"陈造","text":"诗翁静三昧，筇杖壁间横。\n小閤自清绝，幽芳从瘦生。\n巧当窗影见，时映烛花明。\n底用寻春去，冲寒踏月行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19277,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵石湖居士晴窗遣兴","author":"陈造","text":"阊门车马隐晴雷，我亦临风咏快哉。\n平碧际空烟羃历，蔫红照影水萦回。\n园翁门巷初沾絮，游子杯盘欲荐梅。\n落晚小家还馔客，旋篘春瓮取新醅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19278,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵石湖居士游虎丘","author":"陈造","text":"山灵知我欲巾车，岫幌云扃已韨除。\n竹葆松幢平几席，碧烟红影认林庐。\n饭分禅供清无敌，饮属诗流兴有馀。\n莫话长安牢落客，付渠尘土曳长裾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19279,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵记别程帅谷城旅梦","author":"陈造","text":"金翘摇曳玉丁东，宾主依然醉笑同。\n旧事忽随残漏断，新愁不逐晓云空。\n挑灯旋拂穿帷雪，揽辔还禁逆帽风。\n回首梦魂飞到处，壶公窟宅五云中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19280,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵任解元喜雨二首 其二","author":"陈造","text":"跪奉炉香幸见怜，人言匹庶可回天。\n及今一睹盆倾势，满意重占斗覆年。\n仅息黄尘昏永昼，几时翠羽冒中田。\n此心安得顽如石，水旱丰凶付偶然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19281,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵任解元喜雨二首 其一","author":"陈造","text":"寄语今年主雨神，当知小雨未康屯。\n人心正切霶?望，农事深愁晼晚春。\n朽壤旧尝封蚁穴，停云空复叠鱼鳞。\n鲰生宿蕴天人学，无计王前拜手陈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19282,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵刘宰","author":"陈造","text":"倾盖回舟一再逢，向来淮左又江东。\n自惊岁钥催衰白，况说京尘踏软红。\n吏役吾方百寮底，诗工君更古人中。\n挽留重试传杯手，得醉歌呼兴未穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19283,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵刘常甫见赠二首 其二","author":"陈造","text":"笔阵平时枉计功，钝锤那办突铦锋。\n灞桥雪里嗟良苦，饭颗山头记昔逢。\n斲句自知穷有相，从人财博缪为恭。\n彭郎小隐刘郎宅，抖擞尘襟听所从。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19284,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵刘常甫见赠二首 其一","author":"陈造","text":"重来触目总宜诗，颇费行吟与坐思。\n旧友相过有嘉惠，满篇更喜胜前时。\n连朝把玩惊飞动，万象低摧受控持。\n尘翳玉笙嗟耳冷，何人度曲颤鸾篦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19285,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵同年诸公环碧叙同年会 其三","author":"陈造","text":"聚首论年不计官，寥寥故事复开端。\n俯容我辈输心语，更遣时流洗眼看。\n庾亮宾筵无尽兴，昌黎文饮有馀欢。\n舍人妙句还新样，白雪赓酬政自难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19286,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵同年诸公环碧叙同年会 其二","author":"陈造","text":"春意温然侍上官，松醪更劝语更端。\n行厨剩遣黄头载，下客何曾白眼看。\n杰在汉庭方眷注，功将周室更祗欢。\n孰知末至慈恩旧，老境犹歌行路难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19287,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵同年诸公环碧叙同年会 其一","author":"陈造","text":"天瓢挹注拱仙官，更阅诗仙锦绣端。\n离合不忘车笠誓，留传当并画图看。\n玄谭想有蛟龙听，得醉仍均客主欢。\n俛仰谪仙三百载，从知乐事继今难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19288,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵回涂打冰欲遵陆","author":"陈造","text":"转头风日破坚冰，未用穿危冒滑行。\n瀚海无波聊整棹，阳春有脚莫论程。\n诗情动处髭频撚，使事閒时酒细倾。\n冯问逢迎黄发叟，里间欢意为谁生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19289,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵早春","author":"陈造","text":"良辰邀醉得钱无，雪后郊原翠欲铺。\n无力晚风摇柳线，有情新日养花肤。\n寻芳拟贷愁边意，照水还惊病后臞。\n春到祇思为圃乐，剩移杞菊种鸡苏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19290,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵朱万卿五首 其五","author":"陈造","text":"平时歌酒伴，云散与风流。\n白发潘怀县，青衫许散愁。\n生怜自谋拙，人谓不堪忧。\n只拟江湖去，狂吟和棹讴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19291,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵朱万卿五首 其四","author":"陈造","text":"一雨动三日，沟塍皆怒流。\n风凉欺酒力，喜色寄诗愁。\n不待桑林祷，俄宽杞国忧。\n丰登知有象，满听载涂讴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19292,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵朱万卿五首 其三","author":"陈造","text":"彼姝绿窗子，欧靓亦其流。\n裙衩何因瘦，眉梢不贮愁。\n唾花新得意，庭草共忘忧。\n雌凤求凰曲，人前莫误讴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19293,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵朱万卿五首 其二","author":"陈造","text":"风义陶朱裔，斗南无此流。\n悬知禁厨脔，不赋畔牢愁。\n笔落无千载，谈间散百忧。\n尽抄新乐府，惜欠雪儿讴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19294,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵朱万卿五首 其一","author":"陈造","text":"陈雷好宾主，亹亹各风流。\n末座仍枚叟，捐金得莫愁。\n浓欢兼卜夜，暇日赖销忧。\n近按梁州谱，何妨一再讴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19295,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵朱秀才二首 其二","author":"陈造","text":"儒冠林立更鸿生，经倚菑畬道可耕。\n便合摘髭书桂籍，未须拥鼻避时名。\n似闻眕梦成三耳，会见惊人取一鸣。\n讲易露门谁第一，伫君重席振家声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19296,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵朱秀才二首 其一","author":"陈造","text":"萧斋愁兴倩谁宽，笼鹤昂霄顾羽翰。\n自昔诗深知武谔，肯辞雨湿过苏端。\n心期落落空轩豁，世事悠悠拙控抟。\n正枕诵君悲壮语，梦随飞将蹑鞮汗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19297,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵朱通判严上舍 其四","author":"陈造","text":"子元才望未专城，玉面醪敷且细倾。\n宠辱尽捐身外事，醺酣聊乐圣之清。\n分甘亦复怜吾老，饮湿终惭不自营。\n归去须君传此法，秫田百亩便平生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19298,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵朱通判严上舍 其一","author":"陈造","text":"蜀庄漂泊阖闾城，独向陶朱意气倾。\n诗写闲情易为好，雨鏖炎暑欲争清。\n居同蚁穴晴犹闭，归笑鸠巢老未营。\n久拟投君渠保社，援毫空复可怜生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19299,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵朱通判严上舍 其二","author":"陈造","text":"君家名酒压吴城，肯向时流取次倾。\n篘玉谁今窥正色，班荆渠定赏真清。\n双壶问字宁能许，一醉留宾不办营。\n莫惜驱车饷元亮，须防结袜要王生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19300,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵朱通判严上舍 其三","author":"陈造","text":"万手抄诗遍洛城，老怀可但向来倾。\n采菱白雪方迭奏，蜚雨晓风相与清。\n价重欲输和氏璧，令严谁犯伏波营。\n即今貂尾那容续，更判工夫费此生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19301,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵朱解元雪","author":"陈造","text":"掉头取别未经旬，已积胸中几斛尘。\n密雪忽明银海夜，端忧空负玉花春。\n笔驱和气君何健，囊致新诗我未贫。\n胜日兔园当有赋，可能客右欠斯人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19302,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵自序","author":"陈造","text":"丁年拾芥视功名，可但纫兰茹落英。\n深愧官曹无所补，向来志愿几馀成。\n分营伏腊耕淮壤，久绝音邮到帝京。\n尚有好贤馀习在，老怀端合向君倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19303,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]