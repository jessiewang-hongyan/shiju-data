[{"title":"偈颂十七首 其十四","author":"释智愚","text":"晷运推移，日南长至。\n东海鲤鱼，鼓腮振鬣。\n南山鳖鼻，伸眉吐气。\n唯有赵州老儿没意智，拖个破席日里睡。\n净慈路见不平，道个苏卢悉利。\n恐者老子背地里讨人便宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20391,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十七首 其十二","author":"释智愚","text":"船上无散工，驾御有方所。\n打篙底打篙，摇橹底摇橹。\n触浪迎风天地宽，去来不碍东西浦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20392,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十七首 其十一","author":"释智愚","text":"或隐或显，有亏有盈。\n为天上无私之鉴，实人间照夜之灯。\n寻常多是论三五，惟有今宵分外明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20393,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十七首 其八","author":"释智愚","text":"有意待不来，无心忽会面。\n顶发垂丝，眼光如电。\n说尽湖海风波，论量柴米贵贱。\n更有一处少人知，也是重安眼上眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20394,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十七首 其七","author":"释智愚","text":"朝朝相似，日日一般。\n见成受用，千难万难。\n因思临济掌黄檗，何似华亭把钓竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20395,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十七首 其六","author":"释智愚","text":"渡江风倚芦梢碧，夜深金殿人相忆。\n此土西天卖不行，千古万古成狼藉。\n当良月蓂敷五叶之辰，孰谓韬其光，晦其迹。\n熏炉茗椀想遗音，分明对面不相识。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20396,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十七首 其四","author":"释智愚","text":"金錍刮膜，自病难医。\n利剑挥空，逃踪莫及。\n何似横拈麈尾，抑挫来机。\n杀活虽殊，对扬有准，什么人得此三味。\n一二三，三二一。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20397,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十七首 其三","author":"释智愚","text":"尽信书不如无书，识得个字不如忘却个字。\n九经诸子徒尔藻饰，一大藏教尽是药方。\n分明对物收税，何用商量，一叶扁舟载大唐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20398,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十七首 其二","author":"释智愚","text":"吒吒呀呀如狮子儿，我者里也须勘你。\n勃勃窣窣似探竿影草，我者里也须疑你。\n虽然菽麦不分，争奈盐落酱里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20399,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄星婺适庄居士","author":"释智愚","text":"稽首毗耶金粟身，静中多见闹中人。\n却将不二门头事，时与虚空细讲论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20400,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄晦岩佛光法师","author":"释智愚","text":"对文笺释通人到，破句分科作者难。\n不见澧阳焚钞者，棒头拈出尚寒酸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20401,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄道彬侍者","author":"释智愚","text":"勃窣家风一任真，述朱终是不成文。\n何如竹榻吟清夜，月到花梢有几分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20402,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄集庆开山","author":"释智愚","text":"如意来尸释梵宫，雨花狼藉湿春风。\n自惭老矣无灵骨，日在深云听讲钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20403,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"常牧溪猿图","author":"释智愚","text":"霜堕群林空，一啸千岩静。\n耿耿殊有情，劳生发深省。\n抱子攀危条，清兴在高远。\n一点钟爱心，业风吹不断。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20404,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"准侍者归省","author":"释智愚","text":"山空木落岸云轻，吹面霜风有几程。\n明月脩江归梦急，入门先祝老人星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20405,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渔父","author":"释智愚","text":"菰蒲叶冷暮天低，断岸舟横水四围。\n祇有一竿湘楚竹，未尝容易下渔矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20406,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"黄檗礼佛掌宣宗图赞","author":"释智愚","text":"七赤之躯，额有圆珠。\n问著便掌，胆大心粗。\n不是大中天子，几乎唤马作驴。\n大家水底按葫芦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20407,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"傅禅人空谷","author":"释智愚","text":"洞然非洞亦非盘，个里有神谁解看。\n未启口前先应诺，听时莫被耳根谩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20408,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"揖让图","author":"释智愚","text":"行必有师，进之以礼。\n昭昭君子心，对面风波起。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20409,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"棘林和尚遗书至","author":"释智愚","text":"因记七峰来玉几，去年花月下云坳。\n未周一岁背盟我，剔尽春灯眼不交。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20410,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登祝融峰","author":"释智愚","text":"南岳诸峰七十二，惟有祝融峰最高。\n九千七百三十丈，下视寰海如秋豪。\n岷峨华顶远俯伏，九华五老来相朝。\n上封老僧日无事，兴来以手摩云霄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20411,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答洞阳居士糜监丞","author":"释智愚","text":"冷冰冰地洞阳春，橐籥乾坤万物新。\n抛下葛藤提不起，不知缠缚几多人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20412,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢戴悟庵","author":"释智愚","text":"深荷城东老净名，菜园舍了又斋僧。\n磨刀石子看看尽，居士肝心铁打成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20413,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"销印","author":"释智愚","text":"铁鞋无底饱风霜，岁晚归来卧石床。\n一对眼睛乌律律，半随云影挂寒堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20414,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"韩愈见大颠图赞","author":"释智愚","text":"毡拍板，无孔笛。\n省要乞一言，虚空轰霹雳。\n临机不解，转身又却。\n随他声色非声色，洞庭湖外千峰碧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20415,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新建净慈天锡庄请赞","author":"释智愚","text":"不期而会，不约而同。\n晴光烁烁，和气融融。\n际遇两朝圣主，中兴徽庙禅丛。\n良田天锡平如砥，坐对灵苗岁岁丰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20416,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"僧礼补陀","author":"释智愚","text":"孤踪抹过海门东，吴越溪山几万重。\n一拜起来还一拜，不知何处见圆通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20417,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"僧字止中","author":"释智愚","text":"鍊实而食，择木而栖。\n灵灵自晦，物物难齐。\n秋敛巢虚睡稳，梦破月印清溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20418,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"镌者任廷","author":"释智愚","text":"入石入木知分数，古篆今篆攻岂难。\n祇因雕巧失真体，不见全文在世间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20419,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"墨戏屠生善老融牛","author":"释智愚","text":"草木传真笔力高，戴嵩牛在一秋毫。\n此行莫拟天台去，忍作孤僧过石桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20420,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"磻溪禅子请赞","author":"释智愚","text":"怒气噀人，殊不可犯。\n虽有盖胆毛，且无验人眼。\n是亦刬，非亦刬。\n咬定牙关，一生担板。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20421,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"荷鹭 其二","author":"释智愚","text":"蒲叶吹秋，水天漠漠。\n敛影肃心，意不在啄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20422,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"荷鹭 其一","author":"释智愚","text":"沙嘴坡头，枯荷影里。\n清兴忽来，一息千里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20423,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百首 其九十二","author":"释智愚","text":"坑坑坎坎，崄崄巇巇。\n一言易出，驷马难追。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20424,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百首 其三十七","author":"释智愚","text":"以玉抵鹊，以鼠为璞。\n眇然视之，太虚寥廓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20425,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百首 其三十一","author":"释智愚","text":"不落因果，突出野狐。\n人心似铁，官法如炉。\n不昧因果，得脱野狐。\n顶上无骨，颔下有须。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20426,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百首 其十九","author":"释智愚","text":"白石凿凿，韫尔美璞。\n君子道晦，君子斯乐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20427,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百首 其十","author":"释智愚","text":"青山白云，碧溪萝月。\n画虎成狸，只得一橛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20428,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈五首 其一","author":"释子淳","text":"乾坤之内，宇宙之间。\n要有一宝，秘在形山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20429,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"辞世颂","author":"释智愚","text":"八十五年，佛祖不识。\n掉臂便行，太虚绝迹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20430,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"释雪窦革辙二门","author":"释智愚","text":"迦叶聆筝起舞，渊明闻钟皱眉。\n息耕斗室危坐，半窗冻日熙熙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20431,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十一首 其十一","author":"释智鉴","text":"青山是父白云儿，云散青山总不知。\n玉兔昼眠云母地，金乌夜宿不萌枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20432,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十一首 其十","author":"释智鉴","text":"觌面全提少室令，当机不荐过新罗。\n清风楼上逢知己，拨动烟尘不奈何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20433,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十一首 其九","author":"释智鉴","text":"虚玄鸟道没纤埃，玉殿空然琐绿苔。\n挂壁梭飞秋蜕骨，沧溟老蚌尽怀胎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20434,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十一首 其八","author":"释智鉴","text":"赵州一匝天轮转，婆子知音未足酬。\n普为人天开正眼，大千沙界一毫收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20435,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十一首 其七","author":"释智鉴","text":"玄途不涉透离微，道合平常发上机。\n无影树头春色晓，金鸡啼在不萌枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20436,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十一首 其六","author":"释智鉴","text":"云巢梦断月华秋，玉女翻身过斗牛。\n卸却花冠归旧隐，玄途鸟道未容收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20437,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十一首 其五","author":"释智鉴","text":"背前面后扬家丑，揭地洪音师子吼。\n分付仙陀知不知，法身午夜藏北斗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20438,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十一首 其四","author":"释智鉴","text":"百非路绝透离微，四句情忘发上机。\n竹密不妨流水过，山高岂碍白云飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20439,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十一首 其三","author":"释智鉴","text":"即心是佛外忘求，心佛圆明不假修。\n云净远山千点翠，水和明月一天秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20440,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十一首 其二","author":"释智鉴","text":"倒却门前刹竿，全提那涉玄端。\n翻身不坐空王殿，月照千峰夜色寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20441,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十一首 其一","author":"释智鉴","text":"土面灰头不染尘，华街柳巷乐天真。\n金鸡唱晓琼楼梦，一树华开浩劫春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20442,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"释智鉴","text":"世尊有密语，迦叶不覆藏。\n一夜落花雨，满城流水香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20443,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"古藤","author":"释辉","text":"翠盖阴森高隐鹤，修条屈曲暗藏蛇。\n闲来兀坐莓苔石，时见山禽扑落花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20444,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"润州","author":"释辉","text":"北固楼前一笛风，断云飞出建章宫。\n江南二月多芳草，春在濛濛细雨中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20445,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梅花","author":"释辉","text":"我见庭梅六十春，当时初见已轮囷。\n人老只道梅花老，不道梅花老笑人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20446,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题洞虚观","author":"仲殊","text":"古观多松桧，幽奇近暮秋。\n坐看新月上，閒见断云愁。\n野思同花鸟，乡情隔岛洲。\n轻寒披鹤氅，隐几自搔头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20447,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"木芙蓉","author":"释辉","text":"霜深才吐艳，日暮更饶红。\n掩映残荷浦，冯夷败菊丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20448,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"释辉","text":"丁宁童子休教扫，留取窗前当雪看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20449,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"将卒示嗣子蕴仁","author":"释遇安","text":"不是岭头携得事，岂从鸡足付将来。\n自古圣贤皆若此，非吾今日为君裁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20450,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答僧","author":"释遇安","text":"欲识曹溪旨，云飞前面山。\n分明真实个，不用别追攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20451,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"呈韶国师偈","author":"释遇安","text":"推真真无物，穷妄妄无形。\n返观真与妄，真妄亦虚名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20452,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上法智大师","author":"释遇昌","text":"雨霁遥空木落时，危亭南望倍依依。\n白莲旧社人离久，丹阙经年信去稀。\n入观夜堂江月满，挥松秋殿昼灯微。\n林中自有吾庐在，请益终期海上归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20453,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋夜坐","author":"释遇臻","text":"秋庭肃肃风颾颾，寒星列空蟾魄高。\n支颐静坐神不劳，鸟窠无端吹布毛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20454,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二十八首 其二十四","author":"释道川","text":"休争自己与山河，拨动干戈不奈何。\n看取将军施武略，两条寒剑定龙蛇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20455,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二十八首 其二十一","author":"释道川","text":"高声拨火招司徒，火焰炎天蓦面驱。\n祇向此间能稳坐，任教门外雪盈衢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20456,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二十八首 其二十","author":"释道川","text":"分明柑橘勿譊讹，献花借水辨龙蛇。\n白纸一张都盖了，免教天下动干戈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20457,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二十八首 其十七","author":"释道川","text":"演出大藏教，言端语亦端。\n两头都坐断，一剑倚天寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20458,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二十八首 其十四","author":"释道川","text":"三佛形容总不真，眼中瞳子面前人。\n若能信得家中宝，啼鸟山花一样春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20459,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二十八首 其六","author":"释道川","text":"戴角擎头笑一场，父子家和丑外扬。\n知有底人何处去，春来依旧百花香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20460,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二十八首 其八","author":"释道川","text":"生涯如梦若浮云，活计都无绝六亲。\n留得一双青白眼，笑他无限往来人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20461,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二十八首 其七","author":"释道川","text":"山堂静坐夜无言，寂寂寥寥本自然。\n何事西风动林野，一声寒雁泪长天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20462,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二十八首 其二","author":"释道川","text":"东西南北水茫茫，无角铁牛入海藏。\n千眼大悲寻不见，倒骑佛殿入僧堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20463,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二十八首 其一","author":"释道川","text":"明镜当台照不差，短长子丑尽归家。\n山河大地浑如故，不妨随处玩烟霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20464,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二首 其二","author":"释道川","text":"东边觑了复西观，拄杖重重话岁寒。\n带雨一枝花落尽，不烦公子倚栏干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20465,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二首 其一","author":"释道川","text":"群阴剥尽一阳生，草木园林尽发萌。\n唯有衲僧无底钵，依前盛饭又盛羹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20466,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二十八首 其四","author":"释道川","text":"观音门普普门收，才著襕衫便不羞。\n昨夜猿啼新岭上，今朝鹤唳古溪头。\n恶风飘堕回光息，欲火焚烧当处休。\n璎珞受来都不用，平生活计冷湫湫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20467,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]