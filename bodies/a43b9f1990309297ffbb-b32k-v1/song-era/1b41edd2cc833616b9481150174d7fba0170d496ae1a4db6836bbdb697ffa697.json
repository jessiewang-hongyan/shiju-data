[{"title":"秋穫后即事二首 其二","author":"陆游","text":"秋穫春耕力尚馀，雨中袯襫种寒蔬。\n筑居正可茨生草，出市何妨借蹇驴。\n老境朝晡数匙饭，腐儒生死一编书。\n敲门忽有岷山使，惭愧交情未作疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9542,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋穫后即事二首 其一","author":"陆游","text":"多稼如云接百城，村村鼓乐赛西成。\n顿宽公赋私逋责，一洗儿啼妇叹声。\n社酒粥醲供晚酌，秋菰玉洁芼晨烹。\n放翁醉饱摩便腹，自炙毫瓯试雪坑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9543,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋晚二首 其一","author":"陆游","text":"门巷清如水，情怀淡似秋。\n诗吟唐近体，谈慕晋高流。\n托命须长镵，浮家只小舟。\n江南烟雨岸，何处不堪留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9544,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋晚二首 其二","author":"陆游","text":"木落寺楼出，江平沙渚生。\n牛羊下残照，鼓角动高城。\n寒至衣犹质，忧多梦自惊。\n群胡方斗穴，河渭几时清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9545,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋晚","author":"陆游","text":"庭草犹残绿，溪枫已半丹。\n谁知此翁健，又见一年寒。\n幻境槐安梦，危机竹节滩。\n如今浑过尽，摩腹且加餐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9546,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋晚三首 其二","author":"陆游","text":"辞禄始知贫有味，杜门不觉老相催。\n寒鸦已占雁前到，黄菊犹须霜后开。\n团扇尘埃高挂壁，短檠书史乱成堆。\n羸躯自笑痴顽甚，撑拄新寒又一回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9547,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋晚二首 其一","author":"陆游","text":"梧桐落井床，蟋蟀在书堂。\n徂岁聿云暮，揽衣慨以慷。\n一生常蹭蹬，万事略更尝。\n赖有铭心语，南华论坐忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9548,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋晚","author":"陆游","text":"鸡声喔喔频催晓，木叶飕飕已变秋。\n忧患纵多终强项，饥寒未至且优游。\n老罴尚欲身当道，乳虎何疑气食牛。\n但有一愁消未得，大儿白发戍边头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9549,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋晚三首 其三","author":"陆游","text":"世事无穷似弈棋，不如常采故山芝。\n萧萧鸡犬三家聚，莽莽风烟十里陂。\n幸有浊醪从客醉，常忧黠鬼笑人痴。\n清秋乐处君知否，庭下幽花渐可移。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9550,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋晚三首 其一","author":"陆游","text":"西山破晓两眉青，南浦无风一镜平。\n食尽不容添鹤口，身闲且免负鸥盟。\n霜前草树已无色，雨到菰蒲先有声。\n只怪胜游频入梦，今朝蜀客话青城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9551,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋晚","author":"陆游","text":"寒渚雁新下，坏墙蛩夜吟。\n庭莎欲无色，园树不成阴。\n沾洒孤臣泪，驰驱壮士心。\n明朝镜中发，饱受雪霜侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9552,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋晚书感","author":"陆游","text":"丘冢相望故旧空，放翁犹复寄沤中。\n少眠危坐待窗白，得酒细倾生颊红。\n虽愧蛟龙起云雨，尚胜鱼鸟困池笼。\n秋来莫道无游兴，野渡村桥处处通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9553,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋晚书感","author":"陆游","text":"牺象初心岂愿才，沟中虽断不须哀。\n吾生自信云舒卷，客态谁论燕去来。\n夕露正看沾草棘，晨霜已见落楸槐。\n耄年闭户真无憾，葑火更阑熟芋魁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9554,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋晚书怀二首 其一","author":"陆游","text":"七泽三巴日月长，即今万事付茫茫。\n结庐穷僻新知少，属疾沉绵旧学荒。\n中夜饭牛初上阪，千年化鹤复还乡。\n自怜尚觉身为累，剩蓄荆薪待雪霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9555,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋晚书怀二首 其二","author":"陆游","text":"颓然兀兀复腾腾，万事惟除死未曾。\n无奈喜欢闲弄水，不胜顽健远寻僧。\n唤船野岸横斜渡，问路云山曲折登。\n却笑吾儿多事在，夜分未灭读书灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9556,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋晚岁登戏作二首 其一","author":"陆游","text":"水落沙痕出，天高野气严。\n饼香油乍压，齑美韭新腌。\n裘褐风霜逼，衡茆醉梦兼。\n菊花香满把，聊得拟陶潜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9557,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋晚岁登戏作二首 其二","author":"陆游","text":"漫漫荞铺白，累累橘弄黄。\n未论痴腹饱，已觉醉魂香。\n曳杖行歌里，抛书倦枕傍。\n轩车虽已矣，终愧食官仓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9558,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋晚村舍杂咏二首 其一","author":"陆游","text":"村巷翳桑麻，萧然野老家。\n园丁种冬菜，邻女卖秋茶。\n啄木矜奇服，牵牛蔓碧花。\n一樽虽草草，笑语且喧哗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9559,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋晚村舍杂咏二首 其二","author":"陆游","text":"秋晚年中熟，湖乡未寂寥。\n步头横画舫，柳外出朱桥。\n潮壮知多蟹，霜迟不损荞。\n家家新酿美，邻里递相邀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9560,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋晚闲步邻曲以予近尝卧病皆欣然迎劳","author":"陆游","text":"放翁病起出门行，绩女窥篱牧竖迎。\n酒似粥醲知社到，饼如盘大喜秋成。\n归来早觉人情好，对此弥将世事轻。\n红树青山只如昨，长安拜免几公卿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9561,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋晚雨中作","author":"陆游","text":"新雁南来岁又残，萧萧风雨暗江干。\n客疏似悉尔来病，酒薄不禁如许寒。\n草络篱头花尚碧，树当浦口叶初丹。\n醉来且拥黄紬睡，莫问何时后土乾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9562,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋晚幽居","author":"陆游","text":"吴中秋晚气犹和，疾竖其如此老何。\n鸟语渐稀人睡美，木阴初薄夕阳多。\n扫园日日成幽趣，抚枕时时亦浩歌。\n车辙久空君勿叹，文殊自解问维摩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9563,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋晚病起","author":"陆游","text":"心静病良已，翛然巾屦轻。\n灰深地炉暖，日出纸窗明。\n宿雨全消瘴，新霜剩得晴。\n井梧殊可念，无叶送秋声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9564,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋晚衰疾稍平聊识喜怀","author":"陆游","text":"世事纷纷博局中，岂知造物贷衰翁。\n短筇倚壁知身健，小甑炊粳喜岁丰。\n霜近平郊多雁落，雨频断港有船通。\n更馀一事生诗兴，乌桕新添数叶红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9565,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋晚寓叹六首 其四","author":"陆游","text":"老叹交朋尽，闲知日月长。\n著书终覆瓿，得句漫投囊。\n霜树昏鸦黑，风帘小蝶黄。\n村醪如水薄，也复答年光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9566,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋晚寓叹六首 其五","author":"陆游","text":"十里丹枫岸，三家小麦村。\n山多妨极目，秋晚易消魂。\n火举船过埭，人行犬吠门。\n穷愁已如许，那更雨昏昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9567,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋晚寓叹六首 其三","author":"陆游","text":"幽梦鸡呼觉，孤愁雨滴成。\n天高那可问，年往若为情。\n孱虏犹遗育，神州未削平。\n登高西北望，衰涕对谁倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9568,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋晚寓叹六首 其二","author":"陆游","text":"野处仍多病，经年无与游。\n僧庸几市井，医傲过公侯。\n不睡愁逢夜，无衣怯到秋。\n一端聊自慰，问事有长头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9569,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋晚寓叹六首 其六","author":"陆游","text":"行年垂大耋，久矣少朋俦。\n旧事同谁说，新诗或自酬。\n废书眠过日，泥酒醉经秋。\n迟速皆当死，时来莫预愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9570,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋晚湖上","author":"陆游","text":"已过西成赛庙期，家家下麦不容迟。\n夕阳遍野人归后，秋水生滩鹭集时。\n灵药不治怀抱恶，好诗空益鬓毛衰。\n从来未识苏司业，愁绝西风满酒旗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9571,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋晚登城北门","author":"陆游","text":"幅巾藜杖北城头，卷地西风满眼愁。\n一点烽传散关信，两行雁带杜陵秋。\n山河兴废供搔首，身世安危入倚楼。\n横槊赋诗非复昔，梦魂犹绕古梁州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9572,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋晚弊庐小葺一室过冬欣然有作","author":"陆游","text":"放翁毕竟合躬耕，剩喜东归乐太平。\n碧瓦新霜寒尚薄，明窗嫩日雨初晴。\n素琴寻得无弦曲，野饷烹成不糁羹。\n更说市朝痴太绝，一湖秋水濯尘缨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9573,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋望","author":"陆游","text":"千里郊原俯莽苍，三江烟水接微茫。\n横林虫镂无全叶，新雁风惊有断行。\n神禹祠庭遗剑佩，先秦金石古文章。\n一尊莫恨盘餐薄，终胜登楼忆故乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9574,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋望","author":"陆游","text":"快哉一雨洗浮尘，却喜郊原霁色匀。\n野火已亡秦相篆，江涛犹托伍胥神。\n登临顿觉清秋早，流落空悲白发新。\n东望思陵郁葱里，老民犹及见时巡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9575,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋景","author":"陆游","text":"雨泣蘋花老，风摇稗穗长。\n昏林喧宿鸟，秋院咽啼螀。\n旧学成迂阔，初心堕渺茫。\n颓龄尚馀几，谁与问苍苍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9576,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋晴","author":"陆游","text":"身健心闲百虑轻，秋晴未必减春晴。\n晨窗暖日烘花气，午枕微风送鸟声。\n韫玉砚凹宜墨色，冷金笺滑助诗情。\n少年风味嗟犹在，虚道归休学力耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9577,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋晴出游","author":"陆游","text":"雨馀清冷近霜天，拄杖闲拖不挂钱。\n黄叶舞风初簌簌，碧渠通溜正溅溅。\n无情日驭工催老，耐事天公听放颠。\n薄暮行歌并湖去，有人偷样画癯仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9578,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋晴园中山禽绝多有感而赋","author":"陆游","text":"九日秋阴一日晴，山禽应喜我闲行。\n幽吭弄暖闲相命，劲翮凌风远有声。\n熟果啄馀看核堕，细枝衔得欲巢成。\n名园美荫不飞去，似比交朋犹有情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9579,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋暑夜兴","author":"陆游","text":"寂寂空廊络纬鸣，消摇岸帻近南荣。\n闲眠簟作波纹冷，新浴衣如蝉翼轻。\n微雨已收云尽散，众星俱隐月徐行。\n呼童持烛开藤纸，一首清诗取次成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9580,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋感二首 其一","author":"陆游","text":"扶杖龙钟迫耄期，江湖木落更堪悲。\n醉中光景似得志，梦里朋侪如少时。\n落笔龙蛇仲蒙帖，满怀风月季长诗。\n前朝名胜凋零尽，百岁关心只自知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9581,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋感二首 其二","author":"陆游","text":"圣世优容许乞身，归来犹幸齿齐民。\n渔家那有悬车地，蔬食何施祝鲠人。\n獠婢临溪漂衣絮，蛮童扫叶续炊薪。\n生涯如此仍秋暮，赖是从来惯处贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9582,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋感","author":"陆游","text":"瘦尽腰围白尽头，悲蛩声里落梧秋。\n短檠且慰经年别，裋褐犹怀卒岁忧。\n天地无私嗟独困，风霜有信又残秋。\n顽躯安得常强健，更倚东吴寺寺楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9583,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋稼渐登识喜","author":"陆游","text":"门外新场滑似油，早禾已庆十分收。\n虹霓不隔郊原雨，蜩蚻争催巷陌秋。\n人乐风传迎社鼓，路长水溅采莲舟。\n老翁自笑无它事，欲隐墙东学侩牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9584,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋怀十首 其二","author":"陆游","text":"村晚归牛下，林昏宿鸟喧。\n微升天际月，半掩水边门。\n衣杵悲边信，渔歌断客魂。\n老人交旧尽，此意与谁论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9585,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋怀十首 其三","author":"陆游","text":"客思残荷外，农功晚稻前。\n祭多巫得职，税足吏无权。\n浦溆家家钓，村墟点点烟。\n归舟葛衣薄，始觉是秋天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9586,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋怀十首 其十","author":"陆游","text":"昨者风雨过，浩然天地秋。\n年光双雪鬓，生计一渔舟。\n卖药来查浦，听猿到沃洲。\n平生畏暑毒，八月记初游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9587,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋怀十首 其四","author":"陆游","text":"典琴沽市酿，卖剑买吴牛。\n鸡黍随时具，江山到处留。\n随僧日一浴，笑吏月三休。\n安得沅湘客，相从赋远游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9588,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋怀十首 其六","author":"陆游","text":"曩得治中俸，湖山偶卜居。\n身尝著禾谱，儿解读农书。\n遇事绝欣厌，接人均戚疏。\n乾坤虽浩浩，等付一蘧庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9589,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋怀十首 其七","author":"陆游","text":"秋暑虽犹在，晨兴气已清。\n蛮童扫荒径，獠婢涤空铛。\n病树有凋叶，残蝉无壮声。\n书生守故态，已复理灯檠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9590,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋怀十首 其五","author":"陆游","text":"心常凝不动，形要小劳之。\n活火闲煎茗，残枰静拾棋。\n晒书朝日出，丸药昼阴移。\n意适还休去，悠然到睡时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9591,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋怀十首 其八","author":"陆游","text":"种树清阴满，钞书蠹字穿。\n老身犹在世，屈指不知年。\n弃纸储诗稿，长筒聚药钱。\n一生如一日，正可付之天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9592,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋怀十首 其一","author":"陆游","text":"居在三家聚，门才一木横。\n用宽缘岁乐，敛薄为时平。\n疏树叶迟落，远村灯更明。\n题诗虽草草，亦足写幽情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9593,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋怀十首 其九","author":"陆游","text":"望远目犹明，登高脚更轻。\n每思游赤壁，时梦上青城。\n灯下书如蚁，花前饮似鲸。\n古仙曾历考，强半出儒生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9594,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"种麦","author":"陆游","text":"垦地播宿麦，饭牛临野池。\n未能贪佛日，正恐失农时。\n矻矻锄耰力，勤勤祝史辞。\n嘉平得三白，吾饱岂无期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9595,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"种秫","author":"陆游","text":"种秫供留客，移花待探春。\n愁边开乐国，闹里作闲身。\n鬓发今如此，头颅莫问人。\n白鸥非避俗，野性自难驯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9596,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"种蔬","author":"陆游","text":"老翁老去尚何言，除却翻书即灌园。\n处处移蔬乘小雨，时时拾砾绕颓垣。\n江乡地暖根常茂，旱岁虫生叶未繁。\n四壁愈空冬祭近，更催稚子牧鸡豚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9597,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秭归醉中怀都下诸公示坐客","author":"陆游","text":"长谣为子说天涯，四坐听歌且勿哗。\n蛮俗杀人供鬼祭，败舟触石委江沙。\n此身长是沧浪客，何日能为饱暖家。\n坐忆故人空有梦，尺书不敢到京华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9598,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"结茅","author":"陆游","text":"结茆湖曲两三间，客少柴荆尽日关。\n插架图书娱晚暮，满滩鸥鹭伴清闲。\n壁龛吴晋千年字，窗纳秦稽万叠山。\n自怪坚顽推不倒，时来临水照苍颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9599,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绝叹","author":"陆游","text":"老屋环青嶂，衰翁卧白头。\n残书且遮眼，薄酒不浇愁。\n世故真难料，吾生愈觉浮。\n馀年更须惜，幸得返山丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9600,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绝胜亭","author":"陆游","text":"蜀汉羁游岁月侵，京华乖隔少来音。\n登临忽据三江会，飞动从来万里心。\n地胜顿惊诗力壮，气增不怕酒杯深。\n一琴一剑白云外，挥手下山何处寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9601,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绝禄以来衣食愈不继小儿力图之殊未有涯予谓不若痛节用尔示以此诗","author":"陆游","text":"处世吾伤拙，营生汝亦疏。\n如谋道边舍，似信枕中书。\n瓮牖居疑泰，藜羹食敢馀。\n晏婴元学墨，勿负此心初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9602,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"统分稻晚归二首 其一","author":"陆游","text":"出裹一箪饭，归收百把禾。\n勤劳解堪忍，馀暇更吟哦。\n岁恶增吾困，家贫赖汝多。\n村醪莫辞醉，羹芋学岷峨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9603,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"统分稻晚归二首 其二","author":"陆游","text":"薄酒不自酌，夕阳须汝归。\n橘包霜后美，豆荚雨中肥。\n路远应加饭，天寒莫减衣。\n老怀忧自切，道眼看皆非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9604,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"美睡","author":"陆游","text":"老来胸次扫峥嵘，投枕神安气亦平。\n漫道布衾如铁冷，未妨鼻息自雷鸣。\n天高斗柄阑干晓，露下鸡埘腷膊声。\n俗念绝知无起处，梦为孤鹤过青城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9605,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"荀秀才送蜡梅十枝奇甚为赋此诗","author":"陆游","text":"与梅同谱又同时，我为评香似更奇。\n痛饮便判千日醉，清狂顿减十年衰。\n色疑初割蜂脾蜜，影欲平欺鹤膝枝。\n插向宝壶犹未称，合将金屋贮幽姿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9606,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"荆门冬夜","author":"陆游","text":"常饥龟老欲无肠，卧听寒更自短长。\n香椀得闲聊作伴，酒杯因病颇相忘。\n有情窗罅恰通月，耐冷橹枝多得霜。\n历尽风波知险阻，平生错羡捕鱼郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9607,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"草亭独坐","author":"陆游","text":"扫地垂帘坐草亭，东风吹颊醉初醒。\n睡蛇死后魔无力，疾竖降来药有灵。\n在手残梅香淡泊，傍檐幽鸟语丁宁。\n老人不是神通妙，世事元来要饱经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9608,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]