[{"title":"偈颂二百零五首 其一五一","author":"释正觉","text":"我住汝亦住，我行汝亦行。\n结制顺诸佛，禁足护众生。\n金锁无须两头动，灵犀有晕中间明。\n泥牛入海恰半夜，木鸡唤月看五更。\n云倚山是父子，眼约眉为兄弟。\n三世同参或一段合宗家之事，大千等量破微尘出自己之经。\n琼林寸寸宝，旃檀片片馨。\n物物头头有平出底多许，心心法法无外来底一星。\n抹抹挞挞憨皮袋，跛跛挈挈常不轻。\n无是无非长默默，非凡非圣独惺惺。\n蒲团坐倚无他事，永日寥寥谢太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10423,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一八一","author":"释正觉","text":"乞食浙西苏与秀，人人奉佛家家富。\n收拾几成三万缗，尚自不能供众口。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10424,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一六六","author":"释正觉","text":"无对无待，有兼有带。\n历历物机，空空眼界。\n绵绵相柱兮箭锋，恰恰相应兮函盖。\n巨海饮毛，妙峰纳芥。\n彼不见其有馀，我方知其无外。\n普明照世约同参，补怛落伽观自在。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10425,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其四十二","author":"释正觉","text":"藏山于泽，藏舟于壑。\n一真不可藏，怕尔满寥廓。\n传家清白有风规，圆陀陀地无棱角。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10426,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其八十九","author":"释正觉","text":"雨从何来，不离问处。\n森罗大千，出乎方寸。\n照中之虚，静中之动，衲僧分上常相共。\n寒露濡松夜气清，皋禽惊起月巢梦。\n举刘端公问云居：雨从何来？\n居云：从端公问处来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10427,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其九","author":"释正觉","text":"劫前机，肘后印，用而无痕，空而不尽。\n是谁造作大千，出自虚明方寸。\n你侬欲去泥瘢，匠石不悭斤运。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10428,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一七六","author":"释正觉","text":"家法简严，非二非三。\n月来明湛水，云退露寒岩。\n真机自得妙处，谁参不是文殊。\n白槌后也应，千古屈瞿昙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10429,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其二○四","author":"释正觉","text":"一物长灵，十方普应。\n骑声跨色，超眺越听。\n浩浩也能纵能横，如如也能动能静。\n参饱丛林个样人，取饭不问谁家甑。\n佛云常乞是清规，一切食中斯正命。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10430,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一八八","author":"释正觉","text":"经归藏，禅归海。\n稽首归依，合掌顶戴。\n王老师，超物外。\n二十年前恁么来，而今去尽閒光彩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10431,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一六一","author":"释正觉","text":"木有火伤身，人有火伤神。\n木无火不生，人无火不成。\n地水风火，亦复如是。\n四大普周同法界，各各普周无障碍。\n只者普周无碍时，自然无坏无不坏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10432,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一六九","author":"释正觉","text":"你也恁么住，我也恁么住，作业相似贫相聚。\n十方无壁，四面无门。\n遮丑无衣，禦寒无絮。\n直下不居功，个中看转处。\n采华蜂集萌不枝，卧月鸟栖无影树。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10433,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其六十四","author":"释正觉","text":"风不鸣条，雨不破块，会不会兮还信采。\n廓廓落落兮大方无外，跛跛挈挈兮大功不宰，稳稳密密兮心安如海。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10434,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其七十九","author":"释正觉","text":"十方大地是我一个身便能禁足，十方众生是我一个汉方解护生。\n禁足也步步不妄行，护生也心心不妄动。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10435,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其四","author":"释正觉","text":"生也死也，不道不道。\n只知憨狗怒逐块，谁见死蛇惊出草。\n著眼家林里许看，不萌枝上春阳早。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10436,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一四一","author":"释正觉","text":"云无心成何处雨，蜜有味是谁家华。\n一钵上方分得饭，归来香气满毗耶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10437,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一五○","author":"释正觉","text":"水不洗水，金不博金。\n眼不见眼，心不用心。\n不堕根境识，那涉去来今。\n迷里忽然逢达磨，何曾特地作丛林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10438,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其九十五","author":"释正觉","text":"里头看，勿暑寒，直下沧溟沥得乾。\n我道巨鳌能俯拾，笑君沙际弄钓竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10439,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一○二","author":"释正觉","text":"非男女之相，出有无之量。\n透万机之前，超三界之上。\n穷而通，简而当。\n松含月兮夜寒，溪带雨而春涨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10440,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一五九","author":"释正觉","text":"地藏栽田博饭，南泉买镰割禾。\n六祖负舂明历历，金牛棒钵笑呵呵。\n古人得恁饱参煞，尔辈莫嫌辛苦多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10441,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一三三","author":"释正觉","text":"只者一缝大小，饱丛林汉分晓。\n点头言语，丁宁摆手。\n舌头狤獠不狤獠，人人脚下长安道。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10442,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一三六","author":"释正觉","text":"今朝腊月二十五，衲僧一曲和云门。\n谁将节奏乱孔窍，不到瘢痕伤斧斤。\n舌无骨，眼有筋，方见韶阳老子能。\n拍拍元来浑是令，哩鸣啰了逻鸣棱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10443,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一七三","author":"释正觉","text":"三界无法，何处求心。\n风生虎啸，雾起龙吟。\n泥中有刺，绵里有针。\n华鸟隔墙相唤甚，十分春事到家林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10444,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其六十二","author":"释正觉","text":"乳粥当年得善生，心开成道见明星。\n而今各各恁么去，犹较瞿昙半月程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10445,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其五十八","author":"释正觉","text":"小雪纤纤洗霁色，新春冉冉入烧痕。\n三千界现非佗物，百亿分身有妙门。\n白云儿是青山用，青山父是白云根。\n寄语白云数回首，青山免见瘦棱棱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10446,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其六十","author":"释正觉","text":"云开青山横屋头，雨住流水涨门底。\n南无家家观世音，回避不及鼻相抵。\n非唯鼻相抵，亦乃同见同闻，同嗅同舐，同身同意，同得同智。\n果满菩提圆，华开世界起。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10447,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其八十","author":"释正觉","text":"十方法侣共安居，云月身心照处虚。\n转侧芦汀飞鹤鹭，亡机林壑混樵渔。\n瘢痕若尽光无际，丝糁才萌念有馀。\n廊下相逢休放喝，且容兴化撒珍珠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10448,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一二四","author":"释正觉","text":"一日不作，一日不食，歇者无心穫者力。\n分明只个是家风，会得种田博饭吃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10449,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一七五","author":"释正觉","text":"山谷之响，水监之像。\n白云之心，太虚之量。\n应机也乍卷乍舒，据令也全收全放。\n三千世界你夤缘，百亿分身君伎俩。\n风行空，船驾浪，施受通同无住相。\n一言相送知不知，千僧在你钵盂上。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10450,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一九四","author":"释正觉","text":"不落阶级，卓卓超出三际。\n曷用安排，十方自然畐塞。\n五色线不我羁縻，七宝冠是谁严饰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10451,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其六十三","author":"释正觉","text":"人平不语，水平不流。\n嘉州大象，陜府铁牛。\n莫怪扶桑最先照，大都家住海门洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10452,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其五十四","author":"释正觉","text":"拽石般土，打鼓作舞。\n意不立玄，机不停午。\n踏破草鞋赤脚行，见成底事休回互。\n不回互，大龙不受玄沙瞒，前面斑斑元是虎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10453,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其三十九","author":"释正觉","text":"大众退后，妙超窠臼。\n不用安排，何须饤饾。\n动弦别曲孰知音，舒肠沥胆渠开口。\n丛林切莫乱商量，三世诸佛不知有。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10454,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一○三","author":"释正觉","text":"管籥真风暗度韶，春恩如许在芳条。\n志公不是闲和尚，拄杖头边有剪刀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10455,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其四十八","author":"释正觉","text":"一阵清霜，千峰寒色，里许是谁看转侧。\n家风克绍绍非功，抚背忽惊儿脱白。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10456,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其三十七","author":"释正觉","text":"黄河九曲，七斤布衫。\n胡马嘶北，越鸟巢南。\n衲僧恰到真常处，语不欺人面不惭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10457,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其五十三","author":"释正觉","text":"三十六物一时空，空空空处自光通。\n转侧末山不露顶，非男女相主人翁。\n主人翁，借伴能来用莫穷。\n百草头上俱胝老，尘尘刹刹是家风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10458,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一八七","author":"释正觉","text":"仲秋渐凉，蒲团放稳长连床。\n身心澄彻见渊底，河汉淡淡秋磨光。\n二祖不短，少林不长，相传笑杀威音王。\n你无所得，我无所藏，四无壁落浑大方。\n万世清规信明白，夜寒吐月山苍苍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10459,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一四七","author":"释正觉","text":"春云堆絮，春雨散丝，华开笑口柳申眉。\n翻紫燕，嚼黄鹂，声色丛中有路歧。\n家风鼻孔相摩触，不独观音大士知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10460,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一四九","author":"释正觉","text":"主中宾，宾中主，相合回头看里许。\n明月团团夜正央，昆仑抱出珊瑚树。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10461,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一三四","author":"释正觉","text":"不问维摩经，看底甚么经，大千卷出破尘情。\n水中盐味，色里胶青，机前有路妙难名。\n才形言像迢然去，又是泥团换眼睛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10462,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一三○","author":"释正觉","text":"湛湛不昏，绵绵若存。\n三世佛护持为之顶相，历代祖传受为之命根。\n苍头祖父寒居位，白发儿孙夜过门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10463,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其三十六","author":"释正觉","text":"一月雨，半夏凉，蒲团禅板坐相当。\n泥牛踏破澄潭月，光影芒芒夜未央。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10464,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其二○三","author":"释正觉","text":"灵云悟桃华，玄沙旁不肯。\n昭昭然此心分明，隐隐也放身未稳。\n放得稳，八两元来是半斤，钩头秤尾能平等。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10465,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其十六","author":"释正觉","text":"阿那是祖，位崇家谱。\n二仪之根，万象之母。\n建化门未要转机，实际地如何进步。\n青山一线路相通，月落寒猿啼断处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10466,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一二○","author":"释正觉","text":"耳应声而无响，眼有照而亡缘，旷劫清规里许圆。\n生死死生不到处，云磨秋色水连天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10467,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一三七","author":"释正觉","text":"吃茶去，吃茶去，明明指人无异语。\n家风平展没机关，谁道赵州谩院主。\n苦苦苦，往往邯郸学唐步。\n恰恰长安道上行，分明有眼如天瞽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10468,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"崇上人求默庵颂","author":"释正觉","text":"默默中居底是庵，白槌上首乃同参。\n深明铁磨莫颠倒，真见末山非女男。\n坐里水天能湛湛，门前华雨任毵毵。\n一言妙證超名相，不惜眉毛笑翠岩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10469,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"教监寺写真求赞","author":"释正觉","text":"胡床一默，智游理窟。\n偏正往来，离微出没。\n上下混成也二仪之根，去来平等也三世之则。\n有时随应诸尘，不可说似一物。\n修證不无，污染不得。\n震之东，兑之西，离之南，坎之北。\n青州布衫，镇州萝卜。\n当家行眼里有筋，本色汉舌头无骨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10470,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"教禅人出丐求颂","author":"释正觉","text":"历历枢中转化机，出门气象履芳时。\n溪光丽濯红锦段，风柳细撚黄金丝。\n空空不碍浑亡我，处处相逢却是谁。\n会得宾头卢见佛，向人卖弄有长眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10471,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梦斋求颂","author":"释正觉","text":"香风华雨政纷纷，春困何妨聊曲肱。\n三世佛相传寐语，觉来无我坏儿孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10472,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"欲渡长芦与琛上人渔家词 其一","author":"释正觉","text":"岸树藤绳欲解维，海门蒲席弄清吹。\n舟不涩，兴无涯，回首灊山烟翠姿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10473,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"欲渡长芦与琛上人渔家词 其二","author":"释正觉","text":"一苇江头老白眉，而今问讯慰相思。\n风静夜，月明时，满眼寒光下钓丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10474,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清潭荣长老写师像求赞","author":"释正觉","text":"家山水兮，静忘处所。\n友鱼鸟兮，动忘尔汝。\n默默之得谁传，的的之宗自举。\n冰壶春未回，而痕垢无些。\n玉林月已上，而清光有许。\n湛存此个宗乘，肯坏人家男女。\n黄梅之钵笑夜偷，少室之衣疑浪与。\n方彻地区，圆该天宇。\n神发幽而空谷应呼，声出碍而霜钟忽杵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10475,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渊禅人出丐求颂","author":"释正觉","text":"渊源彻底碧涵秋，谁道寒光凝不流。\n转盼芦华与明月，更无一物碍船头。\n去来得妙，纵横自由。\n巨鳌犯饵快须掣，便是仙山坠也休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10476,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"符十五郎求颂 其一","author":"释正觉","text":"尘劳排遣廓而明，灵照心空合未萌。\n妙尽源穷成本得，从来等佛与众生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10477,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪窦宗长老兹写师像以授天童知事壁龛而挂之乞语书其上","author":"释正觉","text":"妙藏绝邻，毕竟无身也清虚之理真。\n幽灵独神，须臾返色也自照之智亲。\n云寒有雪意，天远连秋津。\n缘起佛种，觉生幻尘。\n语细音柔，丹山凤雏之韵。\n目深眉重，檀林师子之颦。\n借位途中宾主，借功门里君臣。\n洞水逆流，望云岩而半肯。\n曹山颠酒，知清税未全贫。\n曲木床头握麈尾，心传一句付其人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10478,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"善友陆铨写真请赞","author":"释正觉","text":"野云情态閒，秋山风骨瘦。\n真照也默默而灵，湛存也绵绵而寿。\n圆蒲曲木兮清白传家，老鹤苍松兮岁寒去就。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10479,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"惠首座写师像求赞","author":"释正觉","text":"衰飒仪容，僶俛颓慵。\n玲珑岩寺，夭矫云松。\n艳冷晚秋菊，韵清霜晓钟。\n刹刹尘尘三昧事，知音何处不相逢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10480,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"智宣直岁写师像求赞","author":"释正觉","text":"霜颅雪髭，壑眼岩眉。\n昆崙源我据，浑沌凿谁持。\n雁行没处秋天阔，华气繁时春日迟。\n诸尘出碍，妙触无疵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10481,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游龟山和何学士","author":"释正觉","text":"一宿曹溪今乃时，永嘉想见未忘兹。\n如何淮风遏行色，不得扶杖相参随。\n斯须佳惠玩珠璧，璨然倾泻胸中奇。\n词锋明锐许谁敌，禅悦清酣还我追。\n约君入社背时事，种藕著华春满池。\n道在金兰端未艾，回头阅世真儿嬉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10482,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登云顶庵峡口倚杖说偈","author":"释正觉","text":"雪梯陟云顶，来寻坏衲师。\n破峡水一脉，挂松月半规。\n疏旷麋鹿性，厌饫丘壑姿。\n眷言携不去，迟立倚筇枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10483,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写真求赞 其四十六","author":"释正觉","text":"忒煞觉老，寒而且槁。\n古岩春迟，澄潭秋早。\n心无象也月影未回，物不争也风吹便倒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10484,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写真求赞 其十六","author":"释正觉","text":"面瘦颊凸，眉棱眼深。\n默亡所住，妙在而今。\n鳞潜寒水，鹤梦月林。\n应声应色分身也，拍手家家观世音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10485,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写真求赞 其四十三","author":"释正觉","text":"说时不借口，用处不依身。\n天寒绝飞鸟，潭净无游鳞。\n点活眼，著精神，野草闲华自在春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10486,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写真求赞 其三十","author":"释正觉","text":"发长带雪，骨瘦横山。\n身心冷淡，云月高閒。\n三条篾束兮道情自槁，五叶华开兮春信那悭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10487,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写真求赞 其四十","author":"释正觉","text":"风日面皮，秋山眉目。\n闲情肖水云，野性从麋鹿。\n憨憨少室九年，草草曹溪一宿。\n穷根彻源，出髓敲骨。\n明回老兔宫，冷下苍龙窟。\n诸人名邈兮摇手未然，万象森罗兮点头具足。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10488,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]