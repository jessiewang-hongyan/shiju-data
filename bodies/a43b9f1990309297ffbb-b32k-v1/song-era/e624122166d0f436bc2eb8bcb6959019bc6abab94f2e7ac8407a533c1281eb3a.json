[{"title":"晚晴见雪呈梦锡","author":"孔平仲","text":"东北风声急，西南日景斜。\n断云方散锦，飞雪忽成花。\n见落初犹少，量深久渐加。\n远天明映玉，晴地湿团沙。\n浩荡随阴气，须臾变水华。\n清辉迷粉蝶，寒色带昏鸦。\n又是流年暮，同居沧海涯。\n寂寥求自遣，小咏寄诗家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51653,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"立春","author":"孔平仲","text":"春风不择地，亦到海边城。\n衮衮衣冠会，喧喧鼓吹迎。\n为牛一何苦，举世尽相争。\n旅客心偏静，停杯想耦耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51654,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春雪","author":"孔平仲","text":"才喜春风昨夜归，凌晨又见雪飘衣。\n缀林似惜梅花落，扑地争先柳絮飞。\n寒气却回侵暖律，阴云徐上蔽晴晖。\n近来四序皆无主，欲向东皇问是非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51655,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"正月十四夜","author":"孔平仲","text":"都人行正乐，天气忽微阴。\n尽恐明朝雪，如何此夕心。\n轮蹄迷道远，鼓吹乱更深。\n我独甘幽静，青灯照苦吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51656,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十五夜","author":"孔平仲","text":"今宵好元夕，去岁大丰年。\n委巷通车马，高台奏管弦。\n灯光照人暖，月色为时圆。\n此乐真难得，无辞酒满船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51657,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十六夜","author":"孔平仲","text":"明夜更无今夜灯，都人为此不胜情。\n皆愁隔岁期犹远，共约追欢直到明。\n君饮露台春易醉，我眠书馆月同清。\n东风亦有相撩意，梦觉犹传弦管声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51658,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春阳","author":"孔平仲","text":"春阳已出地，冰雪尚峥嵘。\n半作泥涂湿，尤妨车马行。\n溪流成小派，海气乱新晴。\n湮郁须披豁，谁同上古城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51659,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"古来","author":"孔平仲","text":"古来豪俊起，大半在山东。\n甚矣承平久，萧然武备空。\n封疆濒北狄，士卒戍西戎。\n器械恬儿戏，城隍骇土功。\n朝廷急扫敝，草莽许输忠。\n元恨天门远，无由半策通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51660,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和常父 其一","author":"孔平仲","text":"卧龙当日醉吟身，冷落天涯一旅人。\n早夕思亲增怅望，啸歌怀古更愁辛。\n角吹海上千山月，草入江南万里春。\n欲去尚留心未决，梦魂长在越溪滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51661,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和常父 其二","author":"孔平仲","text":"赴官并出江湖上，讲学联居海岱中。\n会合尤嗟别离促，音书何似笑言同。\n黄莺度曲争催晓，红杏薰香半倚风。\n景物佳时忆相见，恨无双翅逐飞鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51662,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄常父","author":"孔平仲","text":"历城未到已尝闻，文綵鱼盐市不贫。\n千里山川齐故地，百年风俗舜遗民。\n泉声滑滑长如雨，海气昏昏晚得春。\n北渚环波皆好景，为兄诗笔长精神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51663,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春色最佳呈梦锡 其一","author":"孔平仲","text":"小雨初收物象新，日华徐上气氤氲。\n欲知春色最佳处，万里青山无片云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51664,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春色最佳呈梦锡 其二","author":"孔平仲","text":"探遍名园花未红，高台极目兴何穷。\n欲知春色最佳处，尽在绿杨深浅中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51665,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春色最佳呈梦锡 其三","author":"孔平仲","text":"红日迟迟昼未央，北窗高枕傲羲皇。\n欲知春色最佳处，啼鸟一声幽梦长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51666,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春闺六言 其一","author":"孔平仲","text":"梦回红玉孤枕，日上真珠半帘。\n云彩阴晴不定，柳梢浓淡相兼。\n雁柱怨凭曲寄，兽炉愁逐香添。\n更倚危楼目断，却诉东风泪沾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51667,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春闺六言 其二","author":"孔平仲","text":"燕子舞开烟绿，杜鹃啼破花红。\n满地夕阳芳草，有时细雨斜风。\n锦帐尚寒梦短，彩笺虽远情通。\n泪痕染在襟上，愁绪织向机中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51668,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登资圣阁","author":"孔平仲","text":"平时尝仰望，今日一登临。\n海岱封疆小，乾坤气象深。\n废城增古意，叠嶂起诗心。\n远目方驰骋，春云还自阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51669,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上巳","author":"孔平仲","text":"上巳陪游骑，城南俯落晖。\n溪山俱可爱，花木自相依。\n佳节虽行乐，他邦未得归。\n兰亭应禊饮，回首白云飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51670,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"八日","author":"孔平仲","text":"花下饮馀留晚辔，溪边行处把春衫。\n东风作恶波微起，不得移舟滴水岩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51671,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄常父","author":"孔平仲","text":"缭绕龙山半府阴，春来漂泊阻登临。\n蓬莱阁下花多少，清旷亭前水浅深。\n暮霭漫天迷望目，东风绝海送归心。\n新诗亦有思家意，应记当年共醉吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51672,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"行香","author":"孔平仲","text":"枕上杜鹃啼，匆匆早起时。\n出行天未晓，月在杏花枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51673,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和昌龄落梅","author":"孔平仲","text":"玉摧繁艳蕙消香，渐见园林绿叶光。\n莫诮春风少情思，为君开遍万红芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51674,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登贺园高亭","author":"孔平仲","text":"东武名园数贺家，更于高处望春华。\n深红浅白知多少，直到南山尽是花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51675,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戏促二幕客","author":"孔平仲","text":"寄语红莲幕，当歌金缕衣。\n探春曾有约，今日已春归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51676,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初食牂牁菜","author":"孔平仲","text":"九仙山中牂牁菜，几日春风长绿苗。\n有客提携到深巷，自言采掇下青霄。\n口尝异味虽珍美，目断孤云却寂寥。\n千里思亲不独饱，慨然食罢一长谣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51677,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"呈王子高殿丞","author":"孔平仲","text":"天上人间事不同，相思何日却相逢。\n芙蓉城在蓬莱外，海阔波深千万重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51678,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"接通判于邸氏园园人献牡丹太守不收余私取其绝好者以归","author":"孔平仲","text":"薄暮归来何所携，牡丹初剪半开时。\n浓香盛色俱堪爱，占得春风第一枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51679,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"兄长寄五诗依韵和寄诗各有所怀 其一","author":"孔平仲","text":"忆昔西寻山下园，芙蓉香里醉颓然。\n幽篁迸笋无馀地，老木交阴不计年。\n彻幕旋迎秦望雨，汎杯旁引鉴湖泉。\n旧游寂寞今谁到，应有秋苔长绿钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51680,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"兄长寄五诗依韵和寄诗各有所怀 其二","author":"孔平仲","text":"昔同访客到山阴，马上相随不废吟。\n平视溪流绿烟远，回看府宅白云深。\n纷纷落麈陪高论，艳艳浮蛆劝满斟。\n宾主如今各分散，诗成长咏作吴音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51681,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"兄长寄五诗依韵和寄诗各有所怀 其三","author":"孔平仲","text":"蓬莱彼此一閒身，把酒临风送晚春。\n城邑万家供气象，湖山千里助精神。\n深林鸟语留连客，野径花香著莫人。\n今日天涯共怊怅，归心夜夜转车轮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51682,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"兄长寄五诗依韵和寄诗各有所怀 其四","author":"孔平仲","text":"忆昔幽寻到井仪，繁花落尽绿阴时。\n云迷步武多相失，风入襟怀只自知。\n金斗倒垂交劝饮，玉蟾分面各题诗。\n淋浪醉墨留西壁，好事于今刻作碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51683,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"兄长寄五诗依韵和寄诗各有所怀 其五","author":"孔平仲","text":"昔寻小隐到王家，早出归时逼晚衙。\n胜奕高亭弄纹局，撷芳深径采新茶。\n竹边云过阴相得，莲外风来气益嘉。\n夜坐西堂有馀兴，解酲更进一银瓜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51684,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"郡聚","author":"孔平仲","text":"幕府多閒暇，城台避郁蒸。\n金杯挥落日，银椀嚼寒冰。\n老妇歌犹好，双鬟舞最能。\n深宵红烛短，坐客醉忘兴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51685,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"正月七夜饮节之廨舍","author":"孔平仲","text":"草草杯盘具，喧喧笑语亲。\n浩歌回白雪，醉眼失青春。\n梨栗无遗颗，肴馐屡乞邻。\n颓然极乐际，心迹两俱泯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51686,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"六月五日","author":"孔平仲","text":"洒汗通宵已废眠，起来犹觉眼生烟。\n黄埃滚滚人行地，赤气腾腾日出天。\n纨扇急挥风亦热，银瓶空挂井无泉。\n狂心于此思霜雪，安得师文扣羽弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51687,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"喜雨上太守","author":"孔平仲","text":"曾佩金章祷象龙，滂沱飞雨出无穷。\n泰山吐雾连朝暗，东海驱波半夜空。\n爽压炎蒸民少病，润流枯涸岁将丰。\n黄堂下视相欢意，助以袁宏一扇风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51688,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晚霁","author":"孔平仲","text":"夜雨百泉响，晚晴风报秋。\n云归青山去，水入平川流。\n疫疠且不作，稻粱行亦稠。\n吾徒今则喜，向者为民忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51689,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"双门","author":"孔平仲","text":"崔嵬城阙倚云端，万里天风襟袖间。\n更有清凉无限意，坐看飞雨出南山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51690,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送蔡充道赴密院召","author":"孔平仲","text":"弹剑常为猛虎吟，扫清夷虏丈夫心。\n人留海上烟花老，梦入塞垣冰雪深。\n千里枢庭驰召节，几年家府探归音。\n此行傥未封侯贵，一策犹能绾万金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51691,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄常父 其一","author":"孔平仲","text":"六月凉泉声似雨，千家脩竹势凌云。\n齐州潇洒共閒暇，洗耳清流对此君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51692,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄常父 其二","author":"孔平仲","text":"红蓼最宜秋雨湿，绿槐无奈晚风吹。\n向来不用忧烦暑，庭户清凉自有诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51693,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"七月二十六日","author":"孔平仲","text":"蕲州小簟琴光枕，学馆无人日午时。\n睡去沈酣本避暑，梦回展转却添疲。\n倏忽云雷出天意，清凉风雨报秋思。\n世间此味宜无比，只说羲皇已自卑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51694,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢梦锡见临","author":"孔平仲","text":"雪月交光夜正寒，何人相伴语更阑。\n惟君枉驾时能慰，令我幽居意解欢。\n小仆旋来荧火烛，病妻无力治杯盘。\n清谈已倦还观史，冷淡相看不厌难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51695,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送张通判","author":"孔平仲","text":"清若冰壶断若金，孜孜常见恤民深。\n三年佐郡神明政，一旦归朝父老心。\n遗爱海波无断处，去思秋色有馀阴。\n临行曲为留旬日，少慰攀辕泪满襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51696,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西行","author":"孔平仲","text":"缭绕西行入乱山，白云深处据征鞍。\n荞花著雨相争秀，枣颊迎阳一半丹。\n鞅掌未能逃物役，乾坤何处托身安。\n莒台东向情无限，那更秋风作暮寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51697,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"荆林馆","author":"孔平仲","text":"古木森然满驿庭，繁阴凌乱月分明。\n千枝万叶谁拘管，搅作秋风一片声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51698,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"马上","author":"孔平仲","text":"秋山剥枣熟，野水沤麻香。\n鸟倦投空木，蝉悲送夕阳。\n去程犹未几，归兴一何长。\n应为西斋睡，疏慵意不忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51699,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"近兖","author":"孔平仲","text":"龟蒙山上泉如涌，白石河边雨已流。\n乔木烟深迷故国，黄芦风急战高秋。\n新科一变人方锐，旧学都忘我可羞。\n驱马远来徒自苦，敢将衡鉴定三州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51700,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"毛阳","author":"孔平仲","text":"客路方投辔，邮亭独掩门。\n无人共灯火，秋雨更黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51701,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和张道济长官立秋后作","author":"孔平仲","text":"万里悄然若有霜，南山秋色两苍苍。\n巳经晚雨驱除热，更得西风断送凉。\n瀚海人空云弄白，吴江波阔叶吹黄。\n知君昨夜书帷梦，半在亲庭半在乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51702,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"饮梦锡官舍出文君西子小小画真","author":"孔平仲","text":"西施苏小卓文君，画笔相传窈窕真。\n虽有金珠并粉黛，恨无笑语与精神。\n一樽美酒留连客，千载芳魂著莫人。\n醉眼恍然迷不觉，自惭心地尚埃尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51703,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"走笔 其一","author":"孔平仲","text":"霁雪如泉滴，荒城作阜遮。\n买猿装野景，插柳待春华。\n终日开黄卷，诸生望绛纱。\n王官倦奔走，何幸独安家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51704,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"走笔 其二","author":"孔平仲","text":"种竹禁当雪，栽花准拟春。\n诗书最閒局，寝食自由身。\n浙外音题数，齐州问讯频。\n邮筒烦郡县，此外不干人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51705,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"走笔 其三","author":"孔平仲","text":"触目方多事，栖身独此堂。\n窗迎先得日，檐送晓留霜。\n散漫皆书帙，逍遥或道装。\n墙东虽可隐，林下未能忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51706,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄常父二首 其一","author":"孔平仲","text":"欲和来诗诗未就，恍然心在历山阳。\n寒灯一点静相照，风雪打窗冬夜长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51707,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄常父二首 其二","author":"孔平仲","text":"不得家书又几朝，思亲梦断不堪招。\n欲归每恨川途远，久客空惊岁月消。\n雪意尚浓云黯淡，角声吹绝晚萧条。\n相看惟有兄相近，回首时能慰寂寥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51708,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送董少卿","author":"孔平仲","text":"庄重邦之望，疏明众所钦。\n守符频握虎，使节屡颁金。\n天子东州幸，时蒙皂盖临。\n名卿镇以静，循吏见于今。\n岂弟民无扰，廉隅俗不侵。\n清樽但谈宴，和气入讴吟。\n盛德推先进，高怀在直寻。\n两忘兼宠辱，一笑寄浮沈。\n积雪留行色，朱轮挽去音。\n梦回双阙表，爱结水棠阴。\n贱子非良器，经年托泮林。\n清晖瞻画戟，谆诲俯华簪。\n与进恩尤厚，临分恋最深。\n送公无外饰，终始古人心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51709,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"哦亭","author":"孔平仲","text":"点点花芽拨草根，深春终日在东园。\n烟筠冉冉阴相乱，燕雀啾啾语自繁。\n倚伏万端宁有定，是非一致亦何言。\n谁能伴我哦亭上，烂漫同斟浊酒樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51710,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中和节","author":"孔平仲","text":"二月中和节，海边犹积阴。\n风雷失春信，霜雪损花心。\n挟纩谁能禦，围炉兴愈深。\n寒暄地气异，故国想如今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51711,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晨兴","author":"孔平仲","text":"清閒薄体不成眠，起步庭除思悄然。\n正是雨晴寒食夜，杏花枝上月婵娟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51712,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"以事往齐州初发密","author":"孔平仲","text":"匆匆行色犯晨鸡，起见荒坡落月低。\n多谢使君相送厚，已将歌舞出城西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51713,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"折柳亭","author":"孔平仲","text":"杨柳已藏鸦，高亭望物华。\n平时常送客，此日自离家。\n别酒杯何满，征途日欲斜。\n醉行三十里，春思满莺花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51714,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"里伏驿","author":"孔平仲","text":"去家一日已思家，浩渺归期未有涯。\n满眼春风最多恨，无言似笑小桃花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51715,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"将至青州","author":"孔平仲","text":"磅礴西南万叠山，屈盘飞舞意相关。\n天形地势俱雄壮，人指青州在此间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51716,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"青州席上","author":"孔平仲","text":"笙歌相引入东园，二月青州花正繁。\n银幕四围香兽暖，绣茵十幅舞靴翻。\n游人见此心应乐，野客颓然思已烦。\n向晚凭栏得潇洒，狂风吹雨出云门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51717,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"马上小睡","author":"孔平仲","text":"夹路桃花眼自醉，昏昏不觉据鞍眠。\n觉来已失初时景，流水青山忽满前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51718,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王舍人庄","author":"孔平仲","text":"西出齐州似不远，晚留逆旅尚徘徊。\n泰山一夜兴云雨，洗耳流泉待我来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51719,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上曾子固","author":"孔平仲","text":"海邦穷僻想知音，疋马春风入岱阴。\n千里山川忘道远，一门兄弟辱恩深。\n发扬底滞先生德，振拔崎岖长者心。\n更以诗篇壮行色，东归胜挟万黄金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51720,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和常父见寄","author":"孔平仲","text":"济南风物称閒官，兄弟偕游意益欢。\n幽圃水声从地涌，画桥山色逼人寒。\n别来梦想犹相接，他处尘埃不足观。\n寂寞东斋又经夏，落花新叶共谁看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51721,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]