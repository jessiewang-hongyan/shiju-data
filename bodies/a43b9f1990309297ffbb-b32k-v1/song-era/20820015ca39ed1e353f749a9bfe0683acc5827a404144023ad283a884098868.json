[{"title":"渔家傲 其七","author":"可旻","text":"理性本来长自在。\n灵通昭彻光无碍。\n因被无明风恼害。\n真如海。\n等闲吹动波千派。\n五蕴山头云叆叇。\n遮藏心月无光彩。\n六贼会须知悔改。\n除贪爱。\n刹那跳出娑婆界。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21873,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渔家傲 其一","author":"可旻","text":"人世罪冤知底数。\n前程不是无冥府。\n争似静焚香一炷。\n无行住。\n声声称念弥陀父。\n罪业尽消生有处。\n弥陀愿力堪凭据。\n十念一心存旦暮。\n西方路。\n功成足步红莲去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21874,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渔家傲 其十七","author":"可旻","text":"一点神魂初托魄。\n青莲华里琉璃宅。\n毫相法音非间隔。\n虽明白。\n到头不似金台客。\n九品高低随报获。\n或经劫数华方拆。\n若是我生心性窄。\n应煎迫。\n未开须把莲华擘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21875,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渔家傲 其二","author":"可旻","text":"我佛莲华随步踏。\n黄金妙相青螺发。\n因地曾将洪誓发。\n四十八。\n众生尽度成菩萨。\n宫殿红香华影合。\n宝阶三道琉璃阔。\n水鸟树林皆念法。\n声嘈囋。\n空中零乱天华撒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21876,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渔家傲 其十六","author":"可旻","text":"三十六般包一袋。\n脓囊臭秽犹贪爱。\n恰似蜣螂推粪块。\n无停待。\n朝朝只在尘中。\n若解坚心生重悔。\n宁拘恶逆并魁脍。\n一念能消千劫罪。\n生华内。\n满身璎珞鸣珂佩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21877,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渔家傲 其九","author":"可旻","text":"四相相催生病老。\n死魔不定朝难保。\n争似寅昏持佛号。\n西方好。\n树林水鸟称三宝。\n磨灭等闲髭鬓皓。\n乐邦行计唯宜早。\n万亿国邦非远道。\n休烦恼。\n一弹指顷能行到。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21878,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渔家傲 其十三","author":"可旻","text":"富贵经中谈净域。\n赤珠玛瑙为严饰。\n彼土众生当晓色。\n擎衣裓。\n妙华供养他方佛。\n稚小嬉游随没溺。\n娑婆是苦何曾识。\n忻厌迩来方有力。\n从朝夕。\n静焚一炷香凝碧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21879,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渔家傲 其三","author":"可旻","text":"彼土因何名极乐。\n莲华九品无三恶。\n虽有频伽并白鹤。\n非彰灼。\n如来变化宣流作。\n九品一生离五浊。\n自然身挂珠璎珞。\n宛转白毫生额角。\n长辉烁。\n百千业障都消却。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21880,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"干丹阳宰乞米","author":"史千","text":"知君爱物与人民，敢造琴堂诉在陈。\n斗水果能相活否，今年犹甚去年贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21881,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书里中所见","author":"史卫卿","text":"阑干十二缬帘遮，兽栋鳞鳞鼎贵家。\n莫道楼台无地起，满城秋色半槐花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21882,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"有所见","author":"何应龙","text":"不着画罗金缕衣，寻常打扮最相宜。\n春风燕子楼前过，飘落梨花雪一枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21883,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冷泉观放水","author":"史卫卿","text":"溪流平地响晴雷，石上生风捲雪来。\n醉拍阑干衣袖湿，十分身在白云堆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21884,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西湖山居灯夕","author":"史卫卿","text":"繁华隔湖水，全似远宸京。\n灯火少年梦，山林此夜情。\n鹤闲梅下立，人静月中行。\n长愿岁时好，吟身见太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21885,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"听演师琴","author":"史卫卿","text":"禅悟却参琴，山高水复深。\n七弦手共语，万籁耳无音。\n激烈鬼神泪，发挥天地心。\n秋风时一曲，怀古更伤今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21886,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"依韵奉和司徒侍中龙兴灯夕","author":"史卫卿","text":"宝炬燃红映百坊，佛灯相照有馀光。\n樽前尽被公孙礼，席上惟无处士狂。\n午夜笙歌欢是伯，几家帘幕醉成乡。\n都人犹怕春宵短，共乐何妨舞袖长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21887,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春晴","author":"史卫卿","text":"平明晴可爱，眼界一湖春。\n不见水中鹭，惟多堤上人。\n梅花已白尽，柳色正青新。\n日暮无歌舞，清幽属野身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21888,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"捧檄家山","author":"史卫卿","text":"閒居愧未能，淮幕冷于冰。\n家檄官无俸，山吟客有僧。\n池荒眠鹭石，树折饮猿藤。\n寥落谁相问，孤明雨夜灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21889,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渔父","author":"史卫卿","text":"白头长是醉，湖海不知年。\n活业惟耕网，全家只住船。\n荷花同鹭宿，杨柳得鱼穿。\n一笛吹明月，朱门谩管弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21890,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋步述所见","author":"利登","text":"趁晴收断薪，破晓循幽浦。\n山寒树欲风，云重天将雨。\n兔奔初种畦，鸡拾穫残亩。\n叶深樵无踪，水落鱼可数。\n幽草不须生，千林秋已素。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21891,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪窦飞雪亭","author":"史才","text":"苍岷万仞起岩峦，潺瀑霏霏尽日寒。\n倒泻银河拖白练，人间应作六花看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21892,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过蒋学正三径庵","author":"史才","text":"纷纷处世羡鸣珂，君隐考槃诗独哦。\n三径早知皆坦路，一庵聊复障颓波。\n田园无悔归家晚，松柏存看绕舍多。\n笑我身闲闲未得，不知何日再相过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21893,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送别任龙图","author":"史才","text":"江上飞樯高数寻，西风客路思难禁。\n三千奏议曾经国，十万兵屯已属心。\n官驿疏梅春意足，楚天孤鹜晓烟沉。\n闽南君去才称最，慰我秋鸿达好音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21894,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮","author":"史介翁","text":"柳丝轻飏黄金缕。\n织成一片沙窗雨。\n斗合做春愁。\n困慵熏玉篝。\n暮寒罗袖薄。\n社雨催花落。\n先自为诗忙。\n蔷薇一阵香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21895,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雁湖","author":"史公亮","text":"梅艳凌霜带雪馀，露华洗尽玉生肤。\n东方千骑催人去，聊折春风寄雁湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21896,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"史化尧","text":"文仙亭与远峰齐，纵目凭栏似此稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21897,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"白龙洞磨崖","author":"史少南","text":"一自凌空降节飞，日瞻华表望翁归。\n今犹香气浮丹灶，时有仙韶殷翠微。\n青鸟山深藏宿雾，白猿洞敞纳晨晖。\n榴房桃李年年实，底事游人遇者稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21898,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"史文昌","text":"闲云尽日相随逐，只有朱云挽不来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21899,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"枯梅","author":"史文卿","text":"樛枝半著古苔痕，万斛寒香一点春。\n总为古今吟不尽，十分清瘦似诗人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21900,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋词 其一","author":"史文卿","text":"写就秋词雁影稀，背灯无语独眠迟。\n画栏点滴芭蕉雨，一夜将愁向阿谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21901,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋词 其二","author":"史文卿","text":"桂枝风动小山幽，雨过陂池水漫流。\n拟作楚骚吟未了，一行新雁数声秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21902,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"种梅 其二","author":"史文卿","text":"素与梅花自有缘，又移几本种庭前。\n镜中一半閒风月，不属王郎载雪船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21903,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶成","author":"史文卿","text":"一生富贵皆空梦，千古英雄只断碑。\n几欲含毫作天问，西风吹恨入江篱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21904,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"惜春","author":"史文卿","text":"秀麦条桑剪剪寒，锦屏残梦怯衣单。\n惜春只怕春归去，多插瓶花在处安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21905,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"万杉寺","author":"史文卿","text":"君恩报答果何如，手植松杉一万株。\n溪足断边横略彴，峰头好处见浮屠。\n凤书御墨藏飞白，龙吐山泉散作珠。\n包帚祝尧同此类，刻崖大庆拟嵩呼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21906,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"种梅 其一","author":"史文卿","text":"呼僮耕云种瑶树，斗挂青冥下风露。\n隔林野鹤不知寒，为我飞来复飞去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21907,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题东老庵","author":"史功举","text":"弁山凝翠碧横天，霅水开鉴流清泉。\n隐君东老志高洁，一庵结在青山边。\n平生倒屣爱佳客，买书不惜倾囊钱。\n秋风八月酒初熟，邂逅有客来翩跹。\n丰姿洒落眼秋碧，太白邀饮清风前。\n欣然二翁话相得，醉来促席相留连。\n不觉达旦欲辞去，笑语拍手洪崖肩。\n逡巡洒翰落珠玉，蔼蔼态度含云烟。\n更将祸福论天命，衣冠后世终荣传。\n嗟乎东老今已矣，长有声名伴山水。\n祇应骖鸾跨鹤蓬莱去，犹使乡人指点庵前路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21908,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"声声慢 和陆景思黄木香","author":"史可堂","text":"羞朱妒粉，染雾裁云，淡然苍佩仙裳。\n半额蜂妆，莫道梳洗家常。\n碧罗乱萦小带，翠虬寒、一架清香。\n春思苦，倚晴娇无力，如待韩郎。\n密幄笼芳吟夜，任露沾轻袖，月转空梁。\n弱骨柔姿，偏解勾引诗狂。\n遗钿碎金满地，恨无情、风送韶光。\n闲昼永，看青青、垂蔓过墙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21909,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蓦山溪","author":"史可堂","text":"危阑看月，番做听秋雨。\n一滴一声愁，似相伴，离人悲苦。\n笼香袖冷，独立倚西风，红叶落，菊花残，都是关情处。\n如何排遣，赖有高阳侣。\n长啸酒垆边，且同赋、秋娘词句。\n山翁醉矣，一笛小楼空，思往事，看孤云，目断征鸿去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21910,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"黄陵题咏 其三","author":"史正志","text":"直方谁似退之贤，过庙当时祷亦虔。\n徼福乞灵旋有助，倾囊十万出私钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21911,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"黄陵题咏 其二","author":"史正志","text":"庙塑湘妃少女容，谁知百岁奉重瞳。\n从今好事诗骚客，庄肃当存念虑中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21912,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"黄陵题咏 其一","author":"史正志","text":"玉驭苍梧去不还，泪痕泪竹尚斑斑。\n空传朱瑟流幽怨，谩许明珠解佩还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21913,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"新亭 其二","author":"史正志","text":"忽枉王人六辔驰，新亭有酒便同持。\n坐中不作南冠叹，江左夷吾是素期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21914,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"新亭 其一","author":"史正志","text":"龙盘虎踞阻江流，割据由来起仲谋。\n从此但誇佳丽地，不知西北有神州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21915,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"叙州","author":"史申之","text":"东楼特杰少陵诗，锁江颉颃涪翁题。\n两翁诗阵屹相向，千载名与江山齐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21916,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"严子陵钓台","author":"史吉卿","text":"功名束缚几英豪，无怪先生抵死逃。\n坐钓桐江一派水，清风千古与台高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21917,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵张台法元日书事","author":"史浩","text":"好事东君不惮劳，点妆梅柳见才高。\n尽输好景资元日，故遣清赍属我曹。\n锦绣忽贻新笔墨，琼瑶无以报瓜桃。\n春风染遍西湖绿，且涤金杯共漱醪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21918,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠大慈寺啸翁开士","author":"史守之","text":"挂锡云飞处，心闲境亦闲。\n万缘空俗想，一钵饱松关。\n身幻从兹化，风高未许攀。\n繁华满眼底，付与水潺潺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21919,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"高山堂和节度使梁公韵","author":"史安之","text":"阁凭嵬构敞轩扃，一望尘凡目暂醒。\n岩嶂远供千叠翠，松篁还耸四时青。\n登临雅爱恣吟笔，图画尤宜作座屏。\n我欲从君游未得，壮心方欲翥南溟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21920,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"曲君","author":"史安叔","text":"冥搜浑不见诗踪，却在陶然一醉中。\n到得醒来诗又去，曲君那有许神通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21921,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"问梅","author":"史安叔","text":"瘦藤拄晓觅寒梅，着蕊南枝开未开。\n祇我往来亭下路，芒鞋颠倒印苍苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21922,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和惜梅","author":"史安叔","text":"雪飞浑不管梅嗔，都把寒来障却春。\n直恐雪欺浑冻损，那知雪后越精神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21923,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓亭","author":"史安叔","text":"短褐冲风立晓亭，无端物物搅诗情。\n梅边正被寒山恼，又听松梢衮雪声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21924,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谩成","author":"史安叔","text":"闲较新诗意未降，吟髭撚断数茎霜。\n忽然得句笑声发，惊起花间蝶也狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21925,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"静治堂书怀","author":"史安叔","text":"长揖薰风咏式微，诪张山鸟怪儒衣。\n竹君伴我寻诗瘦，梅子从谁学道肥。\n先自宦情如雾薄，可堪乡梦与云飞。\n支林堂下波光好，鹭笑鸥嗔胡不归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21926,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乙丑中秋与山僧数辈自虎邱灵岩泛太湖登洞庭东山曰翠峰望湖中群山高下出没如大圆镜见百千万亿青螺髻然瑰玮绝特盖入眼未之见恨风作不能过西山睹林屋洞天之胜然已得其彷佛矣 其二","author":"史尧弼","text":"七十二山湖面横，横斜出没乱青冥。\n只疑亦有钧天奏，惊起鱼龙舞洞庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21927,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乙丑中秋与山僧数辈自虎邱灵岩泛太湖登洞庭东山曰翠峰望湖中群山高下出没如大圆镜见百千万亿青螺髻然瑰玮绝特盖入眼未之见恨风作不能过西山睹林屋洞天之胜然已得其彷佛矣 其三","author":"史尧弼","text":"群山相望有无间，髣髴三生常往还。\n不用张帆越清泚，化身先自遍西山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21928,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乙丑中秋与山僧数辈自虎邱灵岩泛太湖登洞庭东山曰翠峰望湖中群山高下出没如大圆镜见百千万亿青螺髻然瑰玮绝特盖入眼未之见恨风作不能过西山睹林屋洞天之胜然已得其彷佛矣 其四","author":"史尧弼","text":"孤峰直上散青眸，山峙西东浸碧流。\n弱水人言三万里，是间我已到瀛洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21929,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"公肃在东南三有书来未报闻其除司直以诗寄贺且谢 其三","author":"史尧弼","text":"纵横才力自时须，今代鹓行政要渠。\n亦有故人岩石里，未嫌不奉子公书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21930,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"公肃在东南三有书来未报闻其除司直以诗寄贺且谢 其二","author":"史尧弼","text":"小试犹为天下平，惠文柱后要无刑。\n从今准拟子张传，吾世常司汗简青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21931,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"公肃在东南三有书来未报闻其除司直以诗寄贺且谢 其一","author":"史尧弼","text":"江北江南罢战尘，两阶干舞作升平。\n河东五色真毛羽，九奏箫韶看一鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21932,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"甲子春过浙和周去华韵五绝 其二","author":"史尧弼","text":"贪看衡麓数峰山，那觉江风猎猎寒。\n吹乱衣巾都不记，橘洲沙上几遗冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21933,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"甲子春过浙和周去华韵五绝 其五","author":"史尧弼","text":"双峰翠扫半天馀，遥想岷峨霁雪初。\n足踏东南今已遍，却思归卧旧时庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21934,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"甲子春过浙和周去华韵五绝 其四","author":"史尧弼","text":"满眼残红正乱飞，端如棹入武林时。\n此身也是鹪鹩样，乞与桃林借一枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21935,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"甲子春过浙和周去华韵五绝 其三","author":"史尧弼","text":"谁家花柳暗门边，投憩同维药玉船。\n醉卧黄鹂新弄舌，一声唤起小窗眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21936,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戏中书岩宝印师方丈 其一","author":"史尧弼","text":"宁堕眉毛出为人，舌端雷电不无神。\n如今有口却挂壁，草木岩中元自春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21937,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戏中书岩宝印师方丈 其二","author":"史尧弼","text":"放形漫浪蜀山西，只是人间一阐提。\n不拟将心觅安处，闲来洗脚玉泉溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21938,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次程右史韵送僧南游问果佛日","author":"史尧弼","text":"问讯风颠妙喜师，天南海北看孤飞。\n如何指是无还地，却作梅州万里归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21939,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"张府君挽诗 其二","author":"史尧弼","text":"见说亲颜昼日嬉，夜窗膏火对书诗。\n功名底事身终误，孝友平生政已施。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21940,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"张府君挽诗 其四","author":"史尧弼","text":"惊起龙蛇忽梦归，一朝脱屣万缘非。\n遥知月露寒松滴，不是波涛木叶飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21941,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"张府君挽诗 其一","author":"史尧弼","text":"频年来往郑公乡，邂逅论文膝上郎。\n已讶树风增感叹，忽闻薤露送凄凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21942,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]