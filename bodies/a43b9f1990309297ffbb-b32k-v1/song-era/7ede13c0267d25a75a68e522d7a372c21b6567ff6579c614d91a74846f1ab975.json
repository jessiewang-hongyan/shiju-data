[{"title":"代书寄刘伯瑞仲文叔骥二首 其二","author":"赵蕃","text":"难兄两别驾，难弟一参军。\n从仕信多誉，传家仍茂文。\n嗟余空白发，期子在青云。\n寂寞题诗罢，林窗日半曛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48414,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代书寄刘伯瑞仲文叔骥二首 其一","author":"赵蕃","text":"每忆分携地，蒸湘绿遍春。\n于今怀想处，苕霅暗迷津。\n但有乖离数，何由宿昔亲。\n附书书复懒，君自识吾真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48415,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代书寄吕益卿","author":"赵蕃","text":"问讯临湘尉，冬来定若何。\n凶年无盗否，清俸及时么。\n再见不易得，惠诗空复哦。\n素书慵写得，此纸字无多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48416,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代书寄俞玉汝","author":"赵蕃","text":"送弟秦淮远，怀人楚驿长。\n素书慵写得，白发漫相望。\n再见知何日，孤怀只自伤。\n春风桃李径，流泪不成行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48417,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代书寄襄阳令于去非","author":"赵蕃","text":"来往丰城县，寻君总不遭。\n如闻漾凫舄，已复用牛刀。\n往事多遗迹，边庭简吏曹。\n莫由同古访，尚拟见诗豪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48418,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代成父送赵信州移知台州","author":"赵蕃","text":"邦人初喜两桥成，诏旨还传易镇荣。\n千里溪山如有恨，一川风雨似增情。\n未应重畀临凋郡，看即归来侍迩英。\n平日空哦海山赋，便思怀谒问经行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48419,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬日杂兴 其一","author":"赵蕃","text":"日出山门晓，日入山径阴。\n区区昏复旦，役役古犹今。\n竹瘦人群玉，菊荒文碎金。\n泛观难究理，默识自明心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48420,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬日杂兴 其八","author":"赵蕃","text":"杨柳迎霜败，枇杷隔岁花。\n柴桑今学隐，杜曲旧为家。\n北讯时闻雁，南烹久厌蛙。\n归津隔吴越，随地且桑麻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48421,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬日杂兴 其三","author":"赵蕃","text":"暑雨报禾熟，霜晴忧菜空。\n藜羹聊自诳，肉食念何功。\n岁晚贫兼病，年来西复东。\n诗成资遣闷，文就返招穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48422,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬日杂兴 其六","author":"赵蕃","text":"要识丰年象，闲观别墅诗。\n鸡声一閒暇，人语两娱嬉。\n北阙非无怒，东皋且自怡。\n物华从晼晚，吾意亦差池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48423,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬日杂兴 其五","author":"赵蕃","text":"鹭举虞卿璧，山开京兆眉。\n穷愁虽付酒，閒意更关诗。\n地瘠黄杨燥，旱深荞麦迟。\n冬温要非正，冰霰汝为期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48424,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬日杂兴 其七","author":"赵蕃","text":"久矣劳生厌，欣然野趣俱。\n苍姿松砥节，外饰橘纡朱。\n翰墨真吾好，功名已后图。\n一椽今粗有，二顷莫忧无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48425,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬日杂兴 其二","author":"赵蕃","text":"节物他乡晚，风声大壑俱。\n深愁木斯拔，宁虑蔓难图。\n杜老衣何短，颜公米已无。\n可怜鸡瑟缩，幸免鼠睢盱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48426,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冯守生日 其一","author":"赵蕃","text":"西汉冯君裔，康时万石家。\n治边清鼓角，劝课足桑麻。\n诞日今年再，欢声阖境哗。\n无言政长夏，亦可醉流霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48427,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冯守生日 其二","author":"赵蕃","text":"报政期年外，里言朝夕间。\n省郎何太晚，召节看遄颁。\n屡上薰风殿，行参玉笋班。\n故应怜末掾，牢落尚群蛮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48428,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"卢谊伯宜之见过要斯远同赋以赠二首 其二","author":"赵蕃","text":"苕水固多胜，吾州亦可邻。\n卜居虽匪旧，取友不妨新。\n佛屋从堪寓，溪亭更可人。\n莫嫌鹅鸭恼，最喜鹭鸥驯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48429,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"卢谊伯宜之见过要斯远同赋以赠二首 其一","author":"赵蕃","text":"近别溪山郡，忽过风雨村。\n浊醪成共把，佳句得深论。\n旧价真齐骆，新题复到元。\n从今得还往，宁只问寒暄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48430,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"去冬过新喻得前四句因见全真行足以成篇","author":"赵蕃","text":"雨里过新喻，风前忆旧游。\n凄凉孤鹤化，寂寞两羊裘。\n屡雪交游涕，无惊鬓发秋。\n君归应有感，荣谢各悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48431,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"去年过铅山一见季承自后邈不相闻秋试度必入城因成父行寄之以诗","author":"赵蕃","text":"去岁飘然反自闽，访君曾为驻征轮。\n尺书不至知殊县，五字可追如隔晨。\n秦论旧闻追乃祖，汉庭那得弃平津。\n行当过我一饭去，要话别来长苦辛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48432,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"去非尉曹于廨舍之侧凿池种竹为亭其上名曰有竹取文公诗云也","author":"赵蕃","text":"旧日南州于去非，一官黄绶不嫌卑。\n要为宾主壶觞地，因著胸中水竹期。\n怪底不同东野耄，政由深得退之奇。\n过君池草生春日，忆我丛篁长夏时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48433,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"去德清十数里阻冰舟行甚艰","author":"赵蕃","text":"常时一夜北新桥，问讯兹来故不遥。\n岂虑坚冰忽成合，更当冷日未能消。\n志存纡直无渠怒，行有艰难自我招。\n赖是晴山有佳色，不然何以慰无聊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48434,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"发永丰值雨投宿金仙寺明日还旧居雪大作","author":"赵蕃","text":"雨暗投野寺，雪明还旧居。\n林园浑异昨，门径亦非初。\n酒事难忘汝，诗材不负余。\n祇言冬大暖，暖极竟何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48435,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"对月","author":"赵蕃","text":"风清胜夏暑，月薄借秋光。\n坐觉还神观，心期隔帝乡。\n满阶蛩送感，何许笛飞凉。\n盘礴俄成久，轩然睡倚墙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48436,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"对月怀签判丈兼简文显","author":"赵蕃","text":"季月风当凛，南方候实偏。\n长林未摇落，频夕对婵娟。\n恨我遥成隔，知公夜不眠。\n连墙有周子，置论每超然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48437,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"对月简全真","author":"赵蕃","text":"对月重兹夕，吟风尚昔怀。\n思君兼野水，恨我局空阶。\n意向元相似，言谈自莫谐。\n忽思成简寄，还觉费安排。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48438,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"对雪有怀","author":"赵蕃","text":"颇怪风能急，还疑雨不成。\n疏疏闻夜半，璀璀及天明。\n安否妻子念，乖离兄弟情。\n谁令负湖海，政使落蛮荆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48439,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"归途","author":"赵蕃","text":"篮舆伊轧又前村，何许风来洗睡昏。\n木落尽还山面目，旱深穷见水根源。\n相逢负担皆征利，难觅隐居躬灌园。\n归路苦长行易倦，断鸦残月记松门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48440,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"归途马上二首 其二","author":"赵蕃","text":"赤叶江南少，黄花秋后开。\n禾场皆藁秸，茅屋半蒿莱。\n负日儿童乐，背人鸥鸟猜。\n归心已飘忽，鞭影顾裴徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48441,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"归途马上二首 其一","author":"赵蕃","text":"兀兀真成去，悠悠莫自嫌。\n阳光施德惠，风力霁威严。\n不待投醪赐，端同挟纩兼。\n山林从尔老，岁月岂余淹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48442,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"旧县道中二首 其二","author":"赵蕃","text":"绿树依平岸，平波映绿芜。\n中分虽有路，四极却成湖。\n艇子时三两，渔村定有无。\n谁其为题作，东野觅诗图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48443,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"旧县道中二首 其一","author":"赵蕃","text":"昨日风既止，今晨风未收。\n浮波羡幽鸟，唤雨怕鸣鸠。\n遗寺荒村里，贞祠古渡头。\n登高谢能赋，物色漫分留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48444,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"正月十三日过邓师契邂逅伯山在焉师契置酒因成五言四韵","author":"赵蕃","text":"竹已连梢种，梅应带蒂栽。\n因留看书帖，更辱倒尊罍。\n胜士亦俱集，好怀端为开。\n春风不拘束，两鬓自摧颓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48445,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"正月十六日雪","author":"赵蕃","text":"竹屋偏宜雪，江亭更受风。\n一杯时自酌，五字不须工。\n柳色全然未，梅花半堕空。\n东江虽可住，吾志在江东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48446,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"正月六日雪","author":"赵蕃","text":"立春才十日，春事已交加。\n政苦诗材窘，欣逢眼界赊。\n漫天皆柳絮，何地是梅花。\n无复青帘觅，敲门问酒家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48447,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玉田道中","author":"赵蕃","text":"释屩云移树，批崖水暗桥。\n殷勤劝耕鸟，劳苦趁虚樵。\n晨起人忘惫，泥行马不骄。\n哦诗殊有味，造谒未妨遥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48448,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玉汝从溧阳来辱李晦庵以诗问讯次韵寄答二首 其二","author":"赵蕃","text":"有身真有累，无地亦无锥。\n遇事频三北，干时愧六奇。\n自嗟寒若此，谁闵病而衰。\n已办穷秋去，宁馀几日思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48449,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玉汝从溧阳来辱李晦庵以诗问讯次韵寄答二首 其一","author":"赵蕃","text":"新诗明胜锦，健笔快于锥。\n工部深陶冶，昌黎杂怪奇。\n殷勤能寄远，风俗赖扶衰。\n屡作挑灯读，何胜对雨思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48450,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玉汝行颇遽以诗留之","author":"赵蕃","text":"云物荒荒苦未晴，客程惨惨易成惊。\n家贫纵乏淹留具，意合能忘赋咏情。\n底用飘然轻此去，未妨聊尔听流行。\n年来已是乖离数，况复相逢俱老生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48451,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玉汝置酒招二十一丈同之鄙句奉呈","author":"赵蕃","text":"薄宦一鸡肋，饱霜双蟹螯。\n祗言成尔负，那卜会吾曹。\n我已愧蓬鬓，君俱追锦袍。\n团团石头月，其下走江涛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48452,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"生米市尽处有寺名演义有二物且得甘叔异邓南秀简寿玉诗","author":"赵蕃","text":"往来屡觅肩吾钓，八十初逢演义僧。\n香爇黄连云细细，薜看石柱帔层层。\n何妨杖策往幽步，频念竹炉眠曲肱。\n海内故人难数见，壁间时得姓名曾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48453,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用文显秋字韵呈签判丈兼简子畅兄","author":"赵蕃","text":"林园瑟缩似高秋，门巷萧条若故侯。\n粗有百篇儿可诵，何须四海辙能周。\n怜才满世今谁是，好士如公独见优。\n父子曾闻自知己，朅来敢意许同游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48454,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用老谢丈立春韵赠周文显蕃与文显以癸巳岁是日相识始有倡酬故及之","author":"赵蕃","text":"时序飞腾不贷人，相从还此赋迎春。\n祇言世态有凉燠，须信吾曹无故新。\n长句能同李白好，为儒未许贾山醇。\n两郎玉立仍难弟，谁道先生解久贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48455,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用初三日韵简伯玉昆仲","author":"赵蕃","text":"雨势忽已过，云峰空复生。\n暂能苏暑病，未足慰农情。\n同社推诗好，今宵况月明。\n三人非对影，难弟与难兄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48456,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用前韵再简明叔仲威","author":"赵蕃","text":"晨兴袄子欠黄绵，宿火灰深更苦翻。\n官冷自疏凫鹜进，儿饥不作雁鹅喧。\n孰云数口须微禄，已料此身终灌园。\n二子交期非势利，故能冲雀屡排门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48457,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用思叔韵赠通神郎翁思明","author":"赵蕃","text":"吾友徐思叔，会稀多阻离。\n要知名下士，看取卷中诗。\n识面恨已晚，因渠端可知。\n通神定何物，莫致孔方疑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48458,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用送成父弟韵送周明甫赴补","author":"赵蕃","text":"诏取咸知有定员，朋来争欲副招延。\n扬眉欲竞将谁与，见敌能轻孰子先。\n养志乡时惟负米，薄游今日暂求船。\n男儿富贵须勤苦，笑我区区但眼前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48459,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用斯远韵寄赵湖州三首 其三","author":"赵蕃","text":"别去虽天外，书行每便中。\n昼吟宵不断，夜梦晓还空。\n时用有显晦，交情无达穷。\n看公与徐孺，宁复计违从。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48460,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用斯远韵寄赵湖州三首 其二","author":"赵蕃","text":"薄暮雨如驰，中宵月半规。\n真成忆玄度，不是突西施。\n蝉堕风枝急，蛩鸣露草垂。\n不眠还索句，自笑欲奚为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48461,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用斯远韵寄赵湖州三首 其一","author":"赵蕃","text":"窜迹穷阎底，求交四海中。\n为怀黄阁老，长咏白蘋风。\n远禄宁堪藉，吾身未适终。\n何山道场麓，政尔属君公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48462,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用签判丈送徐大雅之韵呈签判丈兼简子畅兄","author":"赵蕃","text":"年高端已辈吾翁，况倚通家夙好同。\n长夏江村能数过，论文尊酒未忧穷。\n分趋幕府如工部，耻入帝城因子公。\n闻道郎君亦轻禄，故知难进是家风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48463,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用韵示成父","author":"赵蕃","text":"林动风微扫，庭空月正方。\n不知昼已短，但觉夜初长。\n了了游乖旧，骎骎老至将。\n街头卖紫角，瓮里洒鹅黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48464,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用韵呈明叔","author":"赵蕃","text":"白鸥自倚占深湾，亦有幽人此照颜。\n岂但襟期非世俗，要知吟啸夺天悭。\n江天见处从教阔，松竹栽成不要删。\n我若赋诗君为写，绝人翰墨胜高闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48465,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用韵寄孙推官二首 其二","author":"赵蕃","text":"珍重章泉万竹雏，护烦邻里未应芜。\n浮生固觉浮云似，逝者难堪逝水趋。\n尚喜论诗有新益，幸逃阅士若旁无。\n君平未可山林去，傥欲赴盟其见呼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48466,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用韵寄孙推官二首 其一","author":"赵蕃","text":"泪垢悲啼失母雏，可思营室共衔芜。\n未能因事赋归去，尚此折腰成走趋。\n岂谓微官堪顾藉，不难征路指虚无。\n重轻得丧吾知矣，莫待孔宾闻夜呼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48467,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"田家即事","author":"赵蕃","text":"漫道诗书可起家，未知田舍足生涯。\n不辞伛偻翁栽稻，能作纷耘妇剥麻。\n口腹定繇勤力许，衣裘宁怕大寒加。\n罔知耕稼求温饱，行役虽劳莫重嗟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48468,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"白水道间","author":"赵蕃","text":"一源曲折几成桥，稻陇蔬畦高下浇。\n水碓暗鸣蛙吠草，绿云乱点鹭侵苗。\n谁云斗粟可相挽，到处佳山如见招。\n东亩拔秧南亩莳，乐哉安得助长谣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48469,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"石田渡口待潘文叔去岁亦尝于此待端叔","author":"赵蕃","text":"野店当溪静，荒园得日宽。\n频因候客至，并此把诗看。\n肯寄山中信，如今世上难。\n却忘相见后，劳苦杂悲酸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48470,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"示成父","author":"赵蕃","text":"雨重冬裘薄，泥深古道赊。\n东西但烟嶂，高下绝风花。\n斲句病肝肾，食寒愁齿牙。\n赴期元不后，分路各从家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48471,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"示严君","author":"赵蕃","text":"酒债未忘索，诗狂无用嗔。\n年华犹是腊，风日已如春。\n我鬓萧萧白，庭柯濯濯新。\n晚来暄暖剧，还遣振悬鹑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48472,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"示逸二首 其二","author":"赵蕃","text":"菊种初犹落，及今当梢滋。\n晴多须灌溉，草蔓合耘治。\n夏欲助茗椀，秋当浮酒卮。\n落英如可拾，更得慰长饥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48473,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"示逸二首 其一","author":"赵蕃","text":"纵欲必富贵，成身多贱贫。\n寸阴宁重璧，江水本觞岷。\n勿但愈流俗，要当论古人。\n残冬不十日，又说待来春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48474,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"示詹深父","author":"赵蕃","text":"浊泾清渭本源分，寂寞安能乱纠纷。\n世黠只知钱使鬼，我痴但识颖呼君。\n乘时大驵千金射，望岁良农赤地耘。\n富贵要知定何物，五车何必为渠勤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48475,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"立春日自城还县道中作","author":"赵蕃","text":"晴烟生野聚，冻雪被山田。\n树树梅花下，芊芊麦秀边。\n青春今日立，白发此身怜。\n更想痴儿女，悲啼忆去年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48476,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"立春日呈彦博并帖审知","author":"赵蕃","text":"忆昔少陵身在蜀，遇春曾忆两京梅。\n我今久隔乡关念，病后徒惊节物催。\n不见过门长者辙，可怜到手故人杯。\n长亭与想东征路，柳色青青拂面来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48477,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"立春日邂逅周文显于子畅兄许饮酒论文欢有馀也成二首 其二","author":"赵蕃","text":"吾友南昌尉，典刑诸父风。\n元龙豪气在，东野古心同。\n置酒能招我，论文更许公。\n相从真益者，那复叹途穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48478,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"立春日邂逅周文显于子畅兄许饮酒论文欢有馀也成二首 其一","author":"赵蕃","text":"文字追秦汉，箪瓢保贱贫。\n延英空侧席，下里老斯人。\n倾盖宁嗟晚，推门莫厌频。\n罢谈刍狗用，且看土牛春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48479,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"立春前三日雪明日犹未已诗简子进彦博昆仲示成父四首 其四","author":"赵蕃","text":"待伴先春至，差明积夜初。\n空庭戒无扫，冻笔屡成嘘。\n溪远应回棹，窗明好读书。\n惠连临此际，题赋复何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48480,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]