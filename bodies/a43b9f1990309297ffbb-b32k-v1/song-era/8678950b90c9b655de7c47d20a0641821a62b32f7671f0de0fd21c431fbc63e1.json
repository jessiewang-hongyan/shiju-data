[{"title":"秋日遣兴二首 其一","author":"李洪","text":"时序循环速，还惊一叶飞。\n草衰山自瘦，雨罢水增肥。\n芡嚼鲛人泪，荷凋楚客衣。\n鲈鱼不易得，张翰正思归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62324,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋雨叹","author":"李洪","text":"西风猎猎暮秋天，昏雾淫霖海气连。\n雨脚如麻云泼墨，禾头生耳稻漂田。\n庭前槐树惟增叹，阶下决明空可怜。\n愁绝寒儒思广厦，床床漏屋夜无眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62325,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋晚閒咏","author":"李洪","text":"六年门外送苕溪，绕舍黄花独杖藜。\n安有鹤觞逢白堕，新成螭盏得朱提。\n流匙乍饱丰年玉，病齿全疏饤座梨。\n欲问福城南去路，江山犹得助难题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62326,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"追和下若大雄寺汪内相陈朝桧诗","author":"李洪","text":"斮骨刳心操凛然，盘根厚地老逾坚。\n八千椿木应同寿，十五尧蓂莫纪年。\n辱井已荒伤故国，琼枝无复盗春权。\n六朝陈迹空馀此，阅世真成叹逝川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62327,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送子南兄参选","author":"李洪","text":"我李柯条世有人，如兄器业自超伦。\n岂容被褐常怀宝，好上烟霄早致身。\n天气未佳欲寒食，朝廷有道政青春。\n观光勿作迟迟去，桂玉何劳叹楚薪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62328,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送子都兄赴建康粮料三首 其三","author":"李洪","text":"霸业衣冠事莫论，秦淮潮汐自潺湲。\n新诗必有江山助，故国应无乔木存。\n宅施鸡园钟阜远，塔藏鸟爪道林尊。\n登临怀古情何限，想对三茅忆弟昆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62329,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送子都兄赴建康粮料三首 其二","author":"李洪","text":"留都万雉最繁雄，人物风流古所同。\n玉树玉笙亡国恨，桃根桃叶劫灰空。\n重新观阙青冥外，依旧山川王气中。\n好把清吟追太白，龙蟠虎踞美江东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62330,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送子都兄赴建康粮料三首 其一","author":"李洪","text":"三年待次喜瓜期，别酒春风劝一卮。\n欲试发硎稽古力，稍从连茹中兴时。\n徒劳人耳犹州县，可识荆兮复别离。\n深念对床听夜雨，情怀作恶不成诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62331,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送史志道帅建康","author":"李洪","text":"簪橐明光备武文，玉麟暂剖别尧云。\n朝中礼乐谋元帅，天下英雄有使君。\n陋矣齐丘当十万，鄙哉诸葛视三分。\n公归岂作东征远，彝鼎将书第一勋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62332,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送仲弥性赴蕲水","author":"李洪","text":"中兴岳牧任词人，分虎初班楚泽春。\n四纪才名文价重，一麾江海玺书新。\n眷深丹扆虚前席，祖意黄梅试问津。\n报政宁需外庸讫，遄归清禁掌丝纶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62333,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送许季韶倅桂林","author":"李洪","text":"尺五天边看颉颃，参辰出处九星霜。\n未令掌诰吟红药，屡喜嘉言贡皂囊。\n怀绂寓居欣会弁，监州岁晚客殊方。\n柱林赖有诗书帅，好共骖鸾上玉堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62334,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送武广叔游浙东二首 其二","author":"李洪","text":"嬴相去千载，规摹笔势难。\n空兴黄绢语，谁把翠珉刊。\n并海岁云暮，耶溪春更寒。\n知君四方志，无璧荐盘餐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62335,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送武广叔游浙东二首 其一","author":"李洪","text":"六载交情笃，安贫见子难。\n学穷栒邑鼎，篆逼峄山刊。\n歧路伤轻别，金兰义肯寒。\n浙东仍岁俭，持底劝加餐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62336,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送范至能帅桂林","author":"李洪","text":"口伐奇谋詟可汗，归来犹著侍臣冠。\n燧林草色供诗思，凤沼春波滟笔端。\n谁谓玉堂真学士，暂临桂管小长安。\n元戎十乘无遄迈，上阁宣麻句已团。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62337,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送荐福恩老","author":"李洪","text":"二老相从寂寞滨，往来藜杖特情亲。\n白头庐阜閒司马，杜口毗耶彼上人。\n知见普薰金斗域，伽陀语别霅溪濒。\n红梅已露西来意，要看全提祖令新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62338,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送赵德庄右司江东漕二首 其二","author":"李洪","text":"宰士雍容望最优，便期簪笔侍凝旒。\n暂劳省户弥纶手，稍缓关中馈饷忧。\n寓直文谟高内阁，褰帷仁政被南州。\n龙蟠虎踞登临胜，天险防边得细筹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62339,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送赵德庄右司江东漕二首 其一","author":"李洪","text":"帝胄英英秀本支，名驹千里众难睎。\n驰声小选衣冠地，振职中台政事机。\n礼乐光华持节宠，纶恩献纳赐环归。\n朝廷俊杰如公少，准拟重来伴紫微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62340,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送家叔通守光山二首 其二","author":"李洪","text":"彼美光山郡，风流楚相城。\n寝丘闻汉志，潘国尚侯名。\n泥轼疏荣渥，枫宸眷老成。\n侧闻颁一札，持橐奉承明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62341,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送家叔通守光山二首 其一","author":"李洪","text":"籍甚贤通守，吾家叔父尊。\n暂淹纡旧绶，久合拥朱轓。\n楚甸重分刺，边城已息屯。\n前驱须少伫，天子有恩言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62342,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送野上人游西山","author":"李洪","text":"诗名翰墨独兼全，海上从游十许年。\n进退两忘中有德，律禅不碍任随缘。\n岫云又作无心出，桃坞何劳一笑妍。\n好把经行写新咏，他时寄我小山篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62343,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送随公","author":"李洪","text":"莲社谈经阅几年，住山活计尽随缘。\n衔花百鸟未忘物，露地白牛谁著鞭。\n得计深居餐老柏，勿疑古涧与寒泉。\n他时要伴芸庵隐，竿木逢场不离禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62344,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送滕彦道除太府寺簿归吴门需次","author":"李洪","text":"论交先友接枢廷，末路为寮喜典刑。\n桃李春风同扈跸，衡茅夜雪并寒厅。\n暂从簿领陪卿月，行握兰荃应列星。\n临别遥思五湖乐，望中林屋已青青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62345,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闻季叔被召小诗为迓","author":"李洪","text":"郢人比屋庆循良，忽捧丝纶雨露香。\n骑竹方迎使君马，赐环已趣舍人装。\n好刊棠杕追嘉颂，应有阳春播乐章。\n归侍玉皇香案侧，愿将五色补垂裳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62346,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"除日立春雪","author":"李洪","text":"献日春回一日先，勾芒清晓试花权。\n要看腊雪连春雪，独占新年与旧年。\n梅绽香唇才半树，柳苏睡眼待三眠。\n东皇次第开桃李，谁顾寒松涧雪边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62347,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭幼子二首 其二","author":"李洪","text":"苗而不秀实天年，亭近千秋瘗祖阡。\n季札于嬴称达礼，乐天学佛尚成篇。\n情钟我辈诚难遣，古有东门岂信然。\n恩重讵堪耘爱草，拟将苦谛问南泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62348,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭幼子二首 其一","author":"李洪","text":"兼旬哭子鬓成丝，老眼眵昏泪绠縻。\n玉雪可怜凋并砌，金环无复探邻枝。\n何堪投杖逢曾子，谁解推天继退之。\n沧海逝波无返日，觉城南去有逢时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62349,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭药寮先生","author":"李洪","text":"先友凋零风义衰，绣衣躧履荷深知。\n未乾荐墨俄闻谪，欲寄邮书忽报危。\n赋就徒能感知己，樽前犹忆细论诗。\n白圭一玷身难赎，痛哭须陈吊屈辞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62350,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽刘刑部诗二首 其二","author":"李洪","text":"东海于公老，当年大里门。\n身为二千石，恩及四儿孙。\n富寿悬车日，悲伤易箦言。\n佳城今日启，松柏閟高原。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62351,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽刘刑部诗二首 其一","author":"李洪","text":"宪部为郎久，琳宫解组归。\n赐章三品贵，眉寿八旬稀。\n橘向前洲种，金难故里挥。\n凄凉薤露曲，泪湿老莱衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62352,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"涂中书怀","author":"李洪","text":"载驰十驿倦骖騑，已讶缁尘染素衣。\n历历征人数行店，翩翩越鸟恋南飞。\n贪看树向城头绿，不觉春从海际归。\n客鬓渐凋孤壮志，岂缘微禄恋轻肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62353,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"监试院秋夕无聊得日华寄诗","author":"李洪","text":"杰屋青灯夜不眠，诵君佳句喜跫然。\n别来已觉三秋远，书到难凭一雁传。\n浓淡西湖真在眼，钧枢东阁况蒐贤。\n徒劳屡起江乡兴，归钓槎头缩颈鳊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62354,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"饯史开府奉祠归四明 其一","author":"李洪","text":"千载风云佐命期，黑头先冠凤凰池。\n赤明龙汉升平运，河目龟文柱石姿。\n谭笑功成调鼎鼐，燮和元化请华夷。\n拂衣袖手林泉乐，咸仰中兴帝者师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62355,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"饯史开府奉祠归四明 其四","author":"李洪","text":"主眷方隆便乞身，共钦勇退解枢钧。\n湖山胜槩神仙宅，文武崇勋社稷臣。\n未许赤松陪杖屦，却须黄阁再经纶。\n苍生指日为霖雨，仄耳宣麻宠数新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62356,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"饯史开府奉祠归四明 其二","author":"李洪","text":"衮绣貂蝉侍太清，致身将相极儒生。\n三槐正位岩瞻峻，两镇交兵节制荣。\n昼锦蚤传留鉴水，召棠重喜蔽龙城。\n愿将闾里新谣咏，长和滔滔西峡声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62357,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"饯史开府奉祠归四明 其三","author":"李洪","text":"千里全闽按八州，曾闻三相衮衣游。\n谁知今代甘盘学，宽尽吾皇南顾忧。\n家给乞浆皆得酒，年丰卖剑有耕牛。\n诗歌绿竹为公寿，父子应须并相周。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62358,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"钱塘遇沈时仲匆匆索别","author":"李洪","text":"三年啄腐共吞腥，乍解南冠觐舜廷。\n新贵论交头漫白，吾曹相遇眼终青。\n休嗔轻薄纷纷雨，还恨分携落落星。\n岁晚江湖未归客，蒯缑弹铗不堪听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62359,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陪史志道侍郎遍览南园北第之胜即席赋诗","author":"李洪","text":"我公胸次妙陶甄，幻出壶中小有天。\n地近沧浪占风月，目吞笠泽饱云烟。\n玉杯金盌开新第，燠馆凉台继昔贤。\n闻说傅岩通帝梦，遄归黄阁卧貂蝉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62360,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陪朱德应泛丹","author":"李洪","text":"乘兴扬舲意未穷，俊游真有古人风。\n朱陈亲契当年少，李郭仙舟此日同。\n山色远看空翠里，笑声高彻水云中。\n贤关求士方虚席，得隽行闻冀北空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62361,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿天宁示?老","author":"李洪","text":"又扶残醉渡溪桥，饮散南园夜寂寥。\n炬火照山疑犯斗，松风动地欲平潮。\n观河自叹尘容老，就日那能鬓雪消。\n煨芋拥炉谈妙道，阶梯佛祖直须超。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62362,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿龙泉院有外氏陈户曹坟阴德记","author":"李洪","text":"外家多积庆，绝叹户曹贤。\n阴德神能告，潜光世更绵。\n龙泉依古寺，马鬣近封阡。\n欲篆苍崖古，惭无笔似椽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62363,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿宝宁寺","author":"李洪","text":"畏暑征涂倦，僧窗借榻眠。\n聚蚊雷隐隐，梦蝶昼翩翩。\n喜断梅黄雨，慵参柏树禅。\n潮生富春渚，重泛谢公船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62364,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿临平寺","author":"李洪","text":"客里疲奔走，禅关暂舣舟。\n颠毛成种种，身世信悠悠。\n天路辞鸿鹄，江湖狎鸟鸥。\n依然庭下柏，立雪伴冥搜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62365,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寂寞","author":"李洪","text":"寂寞伤吾道，宁为梁甫吟。\n霜威凌客鬓，雪意动梅心。\n酒尽兵无备，愁牢病不禁。\n简编聊寓目，未觉岁时侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62366,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄子都兄兼呈上饶使君赵有翼","author":"李洪","text":"十驿征涂雪塞川，玉溪乍到意醒然。\n家声盍继舍人样，台治遥分刺史天。\n感慨壮游词绚锦，笑谈登最地流钱。\n邦侯傥记论交旧，应有新诗寄日边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62367,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄沈时仲 其二","author":"李洪","text":"论交肺腑独深知，手札勤渠慰我思。\n郭泰垫巾频念旧，休文减带最能诗。\n常怀胜集无三友，坐想高谈彼一时。\n明月扁舟过苕霅，蘋汀重理钓鱼丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62368,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄沈时仲 其一","author":"李洪","text":"故人为别又经年，几度临风思黯然。\n赤县暂陪珠履客，青衫空负小山篇。\n壮时之武无能用，老矣扬雄只守玄。\n何日西湖追旧约，淡烟疏雨泛湖船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62369,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"得家书","author":"李洪","text":"伤春渺渺独凝眸，黄耳归时暂放愁。\n跪得双鱼开尺素，别来一日抵三秋。\n花前块处怜秦赘，泽畔行吟类楚囚。\n预约鲤庭归省处，清微风送木兰舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62370,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"扈跸玉津园","author":"李洪","text":"丽日祥云覆苑墙，柳丝驰道曲尘黄。\n山呼万岁迎春仗，花覆千官献玉觞。\n騄駬籋云天步远，驺虞节射乐声长。\n微臣奉引陪鹓鹭，许听箫韶入建章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62371,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"探梅 其三","author":"李洪","text":"幽姿矜冷淡，别占一家春。\n摩诘闻禅女，登伽善幻人。\n解愁空索笑，能赋更疑神。\n乞与水仙品，谁持上玉宸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62372,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"探梅 其一","author":"李洪","text":"帝所春先到，西湖梅自开。\n横斜窥水鉴，想像下瑶台。\n青女严霜侍，嫦娥借月来。\n景阳钟漏晚，翠羽勿须催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62373,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"探梅 其二","author":"李洪","text":"瓯粤千山外，清愁只个般。\n澹烟增态度，飞霰斗高寒。\n郑圃乘风驭，孤山傍水看。\n少陵诗兴动，题品信知难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62374,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"探梅次韵章庭倚","author":"李洪","text":"江园试觅去年梅，花下遨游得暂陪。\n脉脉早迎南日至，垂垂先放北枝开。\n江边墙角添诗兴，月落参横唤梦回。\n一见清香心已醉，何须更待曲生来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62375,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"望孤屿","author":"李洪","text":"缥缈风烟岛屿孤，朱楼丹阁欲凌虚。\n浩然逸兴成陈迹，康乐清吟足起予。\n鳌顶蓬莱无雁塔，龙宫蠖濩拥宸居。\n平生李杜空遐想，我欲投竿学钓鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62376,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"欲探梅西山简元量","author":"李洪","text":"寻梅试欲向江津，冷蕊商量效小颦。\n洗雨梳风无那瘦，巡檐索笑为谁春。\n西湖苦忆微吟老，庾岭偏愁折寄人。\n知有清诗似何逊，可能嚼蜡对横陈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62377,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淮上乱后寄子都兄五诗 其二","author":"李洪","text":"忆昨王师北渡江，山东豪杰已争降。\n衔枚夜雪俄平蔡，斫树明书果死庞。\n志士裹尸须马革，旧官祭灶熟羊腔。\n老奸牖下终何幸，远愧睢阳庙食双。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62378,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淮上乱后寄子都兄五诗 其五","author":"李洪","text":"多病新年白发生，愧无筹策赞亲征。\n弯弧空作饿鸱叫，逐兔休嗟走狗烹。\n凤阁鸾台少知己，天台雁荡恣经行。\n可怜未遂求田计，空负江湖浪漫名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62379,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淮上乱后寄子都兄五诗 其四","author":"李洪","text":"残臈仓皇间道奔，相逢悲喜语还吞。\n巡檐惨淡梅花月，寿酒淋漓柏叶樽。\n禦敌孤城存即墨，还家聚首似羌村。\n见几在莒思深戒，只恐黄金注自昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62380,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淮上乱后寄子都兄五诗 其三","author":"李洪","text":"两淮黔首苦飘零，庙算成功再底宁。\n头斫新都摅宿愤，脐燃郿坞赫王灵。\n羌人半已投戈拜，父老从观扶杖听。\n欲勒燕然继隆碣，大书谁纪史编青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62381,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淮上乱后寄子都兄五诗 其一","author":"李洪","text":"黄耳东来喜可知，鸰原书札慰愁思。\n艰难莫话平时事，愁绝长吟别后诗。\n再到空存旧城郭，遗黎重睹汉官仪。\n故乡枌梓凋零甚，梦寐芜城祇益悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62382,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清明自释","author":"李洪","text":"异乡节物又清明，懒复追游年少行。\n愁惨松楸十年泪，雨昏花絮数声莺。\n高红远绿俱无那，客恨春风两不平。\n强课新诗作寒食，不堪重忆故园饧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62383,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清明遣兴呈郭次张","author":"李洪","text":"倦游佳节负清明，禁籞芳菲未遍经。\n杨柳堆烟犹冉弱，杏花著雨半飘零。\n街头车马来还去，客里壶觞醉复醒。\n剩喜祥林洗尘土，吴山相对眼偏青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62384,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"移竹诗伯封垂和且闻兄弟皆欲作因用元韵奉寄 其一","author":"李洪","text":"海甸寻盟肯遽寒，叵嗔久未竖樯竿。\n张仪尚有口中舌，贡禹未弹头上冠。\n处处句奇有神护，行行墨妙似龙盘。\n阿连知有惊人语，鹤膝因君举似看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62385,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"移竹诗伯封垂和且闻兄弟皆欲作因用元韵奉寄 其二","author":"李洪","text":"密密脩篁入槛寒，君来移取出檐竿。\n结根久近幽人屋，解箨宜为壮士冠。\n曾共马兰同请客，不忧苜蓿但堆盘。\n从今莫羡萧郎画，风月良宵仔细看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62386,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赦后分祀禹庙有感","author":"李洪","text":"禹庙依山麓，江涛日到门。\n黎氓半樵牧，祝史洁罍樽。\n菲食虽王意，斋祠致主恩。\n人谁思帝德，空感习之言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62387,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]