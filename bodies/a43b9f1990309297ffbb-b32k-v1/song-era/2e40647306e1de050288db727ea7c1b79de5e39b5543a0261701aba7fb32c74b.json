ce":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63152,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其五十","author":"高似孙","text":"豆蔻雨分霁，翠蟳雪炊香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63153,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其三十三","author":"高似孙","text":"沙空擒逸蟹，泉熟煮寒青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63154,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"巫山秀丽为四川之奇观其一晴","author":"高吉","text":"巫峡秋深景最幽，山岚泼翠淡烟浮。\n看来不复成云雨，空锁襄王旧日愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63155,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"倦游","author":"高吉","text":"参透诸方向上机，瘦藤靠壁倦游时。\n充然有得机之外，口不能言心自知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63156,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读渊明传","author":"高吉","text":"谁为栖栖鲁孔丘，辙环天下果何求。\n爱人学道行吾志，束带何伤见督邮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63157,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"庾岭 其一","author":"高吉","text":"庾公陈迹已悠悠，春到江南天尽头。\n依旧冰花照行客，瘴烟原不犯清流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63158,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"庾岭 其二","author":"高吉","text":"江水悠悠去莫追，个中造道有深机。\n我来岂为观鱼说，人笑无钩钓傍矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63159,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"墨梅","author":"高吉","text":"识破宫妆色是空，香魂分付与东风。\n黑云泼眼催诗急，著我江头春暗中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63160,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"忆潇湘故人","author":"高吉","text":"竹好无多个，江清不觉深。\n馀香随去蝶，软语爱幽禽。\n美景翻成恨，经年不寄音。\n长沙一樽酒，得共几回斟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63161,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"快阁","author":"高吉","text":"不跨扬州鹤，来寻快阁鸥。\n澄江依旧月，落木几番秋。\n山色横青眼，交情叹白头。\n一声何处笛，我欲理归舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63162,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"觅桂花","author":"高吉","text":"金粟如来佛，拈花微笑时。\n烦君修月斧，分我占秋枝。\n且约黄香住，莫令青女知。\n夜窗清不寐，剩读几篇诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63163,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨肥","author":"高吉","text":"雨肥蔬解甲，坡暖竹添丁。\n物态俱自得，人痴终不醒。\n独行宁愧影，真懒遂忘形。\n巢燕归何晚，柴门风为扃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63164,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送客之楚","author":"高吉","text":"嘶骑随鞭尾，诗囊挂杖头。\n好风吹客去，落日启予愁。\n涉水搴沅芷，邀春醉楚楼。\n故人如问讯，云卧懒如鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63165,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"有所思","author":"高吉","text":"上山采芳桂，不盈一掬金。\n金色容易变，零落伤我心。\n欲以遗所思，山遥水沈沈。\n微物岂足贵，但感岁月深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63166,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"试长沙胡邦明墨","author":"高吉","text":"墨卿溯源流，甄陶何远矣。\n系出五大夫，杀身成人美。\n策勋凌烟阁，繇此著姓氏。\n开国从胶东，裂土封黑水。\n平生好太玄，握手忘汝尔。\n一笑吐奇芬，熏透诗人髓。\n磨砻去圭角，耐久坚莫比。\n朋来自远方，陶泓管城子。\n传文章心印，千古尽在是。\n我老久绝交，未忘抄录耳。\n种树书一编，养生论盈纸。\n烦卿为记之，岁晚吾事已。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63167,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋窗杂兴","author":"高吉","text":"月朗众星稀，天高万籁息。\n草露湿秋虫，悲悽声唧唧。\n隔窗听鸣机，寒光曙犹织。\n微物固催人，尤为贫女惜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63168,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"胡不归二首 其二","author":"高吉","text":"茕茕荡子妻，空房守幽独。\n缠绵心绪长，吞声忍夜哭。\n背灯耿孤影，香冷云幕低。\n绝怜屋上乌，替人呜呜啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63169,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"胡不归二首 其一","author":"高吉","text":"客从暑中来，清风入我户。\n佩带楚兰香，囊瘿湘蓠句。\n一笑忘形骸，百年示肺腑。\n烹鲤唤曲生，劳苦竹深处。\n远游焉伥伥，归梦应栩栩。\n回首白云飞，下有白发母。\n白发不堪剪，儿去定何所。\n频频占鹊喜，嗷嗷待乌哺。\n去时萱始华，执手泪如雨。\n萱华几飘风，月落啼杜宇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63170,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"塞南","author":"高吉","text":"塞南月冷乌夜飞，茫茫旷野无枝栖。\n防边夜歌大风起，铁衣如冰冻不死。\n功成那忍乞爱卿，叫阍已献龟形绮。\n钱塘江边乌欲栖，小卿醉软红玉肌。\n亸云溜簪困未醒，山头赤乌啄金饼。\n春宵恨不长如年，无情银漏何溅溅，起来一笑花嫣然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63171,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚梅","author":"高安斋","text":"买得街头最晚梅，潇潇风雨对吟杯。\n莫嫌吟蕊能稀少，不学春光烂熳开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63172,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]