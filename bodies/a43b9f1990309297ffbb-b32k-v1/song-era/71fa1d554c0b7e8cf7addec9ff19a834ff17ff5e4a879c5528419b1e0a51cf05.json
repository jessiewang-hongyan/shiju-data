[{"title":"偈颂六十八首 其六十四","author":"释法薰","text":"说短说长，自起自倒。\n跛脚老云门，慈悲成过咎。\n长安一路坦然平，往来曾不禁人行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14724,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十八首 其六十三","author":"释法薰","text":"全提半提，向上向下，冷泉直是口哑。\n真人面前，不得说假。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14725,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十八首 其六十一","author":"释法薰","text":"放下觅无踪，尽力提不起。\n寸铁未施，刀锵满地，明眼衲僧失巴鼻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14726,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十八首 其六十","author":"释法薰","text":"入室升堂，门庭施设。\n无途辙中，翻成途辙。\n百丈老常得一橛，解道吃茶珍重歇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14727,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十八首 其五十八","author":"释法薰","text":"灵隐门下，不犯之令。\n九十日中，头正尾正。\n衲僧路活，脚下生烟，老僧终不学云门索饭钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14728,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十八首 其五十七","author":"释法薰","text":"意到句到，宗通说通。\n一品二品，百匝千重。\n推倒面前案山子，长衫大袖舞春风。\n穷鬼子，莫莫莫，更须知有朱顶王菩萨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14729,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十八首 其五十六","author":"释法薰","text":"曲曲弯弯，平平坦坦。\n七穿八穴，十字纵横。\n是汝诸人，不妨东行西行，第一莫教撞著跛脚老云门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14730,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十八首 其五十五","author":"释法薰","text":"月旦升堂，无可垂示。\n便恁么散去，诸人未必灵利。\n且向秤锤上，捏出些子汁，贵图有个滋味。\n见之不取，思之千里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14731,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十八首 其五十二","author":"释法薰","text":"时时九夏，日日三秋。\n闹市里，百草头。\n夹山老子卖峭，重价未有轻酬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14732,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十八首 其五十一","author":"释法薰","text":"德山雨点棒，临际雷奔喝。\n收拾将来，七零八落。\n灵山咬定牙关，尽力也难提掇，睦州拶折云门脚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14733,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十八首 其五十","author":"释法薰","text":"青山不举步，日下不挑灯。\n黄头碧眼，臭肉生蝇。\n诸人三十年后悟去，不得错怪老僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14734,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十八首 其四十九","author":"释法薰","text":"不识字却识字，合识字却不识字。\n石田恁么判断，且道意在于何。\n万人争仰处，一箭落双雕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14735,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十八首 其四十八","author":"释法薰","text":"九十日已过半，那事毕竟如何。\n直饶穷到底，终是涉风波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14736,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十八首 其四十七","author":"释法薰","text":"非不非，是不是。\n建立则乖张，扫除则失旨。\n德山临际出来，换却髑髅里底。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14737,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十八首 其四十六","author":"释法薰","text":"明如镜，黑如漆。\n四七二三，多虚少实。\n灵山拄杖，且拈靠壁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14738,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十八首 其四十五","author":"释法薰","text":"春花烂漫，春光欲暮。\n杜宇声声，送春归去。\n诸人何不向这里眼明心悟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14739,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十八首 其四十四","author":"释法薰","text":"刀不自割，水不自洗。\n山僧拄杖化为龙，吞却乾坤大地。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14740,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十八首 其四十三","author":"释法薰","text":"临际顶中髓，杨岐眼里筋。\n欲明这个事，须还这个人。\n风前有路，秤尾无星。\n大家赢得笑忻忻，笑道秤尾无星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14741,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十八首 其四十二","author":"释法薰","text":"海上明公秀，衲僧不知有。\n冷地忽相逢，寻常无处讨。\n无处讨，莫草草，龙王宫殿，有谁亲到。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14742,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十八首 其四十一","author":"释法薰","text":"灵隐虽则无能，要与花药相见。\n十七十八，證龟成鳖。\n十九二十，半夜泼墨。\n直须枯木生花，胡饼出汁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14743,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十八首 其四十","author":"释法薰","text":"铁壁铁壁复铁壁，那边那边更那边。\n事到极头须倒断，瞎驴?跳过西天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14744,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十八首 其三十八","author":"释法薰","text":"春光冉冉，春日迟迟。\n春风包裹，上下四维。\n黄莺声在柳阴西，此意明明说向谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14745,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十八首 其三十七","author":"释法薰","text":"网细鱼稠，药多病甚。\n棒喝交驰，一品二品。\n山僧恁么逞驴唇，痴客徒劳劝主人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14746,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十八首 其三十六","author":"释法薰","text":"昨宵困倒床上，直至五鼓方苏。\n今日升堂，言句都无。\n且望大众，智不责愚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14747,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十八首 其三十五","author":"释法薰","text":"兔马有角，牛羊无角。\n不知不会，事同一家。\n多见多闻，千差万别，毕竟天无第二月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14748,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十八首 其三十四","author":"释法薰","text":"佛来也打，祖来也打，德山老人，甚生风彩。\n灵山这里，佛来也著，祖来也著，手中拄杖，权且架阁。\n擎茶扫地，也要一个半个。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14749,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十八首 其三十三","author":"释法薰","text":"七十九年间，大地遭欺诳。\n且喜葛藤根，今朝嚗地断。\n后代儿孙，三马九乱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14750,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十八首 其三十二","author":"释法薰","text":"喝如雷，棒如雨。\n大地绝纤尘，回头无觅处。\n无觅处，昨日有人从天台来，却往径山去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14751,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十八首 其三十一","author":"释法薰","text":"不参禅，不论义，拖个破席日里睡。\n赚他伎死禅和，至今坐在冷地。\n灵山不然，因行掉臂。\n买石得云饶，移花兼蝶至。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14752,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十八首 其三十","author":"释法薰","text":"识得一，万事毕。\n秘魔擎叉，鲁祖面壁。\n临际三玄三要，洞山五位君臣，云门念七，是一不是一。\n昨夜新州老卢，失却腰间特石。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14753,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十八首 其二十九","author":"释法薰","text":"若论此事，何必多言。\n不在内，不在外，不在中间，离娄行处浪滔天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14754,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十八首 其二十八","author":"释法薰","text":"东山正脉，不绝如线。\n睡虎去无踪，一斑今复见。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14755,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十八首 其二十七","author":"释法薰","text":"百尺竿头行阔步，紫罗帐里撒真珠。\n山僧赢得呵呵笑，未审诸人会也无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14756,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十八首 其二十六","author":"释法薰","text":"动容扬古路，不堕悄然机。\n承言者丧，滞句者迷。\n不承言，不滞句，虾䗫跳上梵天，灯笼吞却露柱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14757,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十八首 其二十五","author":"释法薰","text":"登天不假梯，遍地无行路。\n可怜杜衲僧，邯郸学唐步。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14758,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十八首 其二十四","author":"释法薰","text":"盲禅暗證，日中迷路。\n深闻浅悟，未入正流，不到乌江不肯休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14759,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十八首 其二十三","author":"释法薰","text":"释迦悭，弥勒富。\n甘草甜，黄连苦。\n法法小相干，人人各自度。\n咄，莫来拦我毬门路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14760,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十八首 其二十二","author":"释法薰","text":"直如弦，曲如钩。\n易见难识，老倒赵州。\n世事但将公道断，人心难似水长流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14761,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十八首 其二十一","author":"释法薰","text":"不在内，不在外，不在中间。\n朝看云冉冉，暮听水潺潺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14762,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十八首 其二十","author":"释法薰","text":"赵州老汉，心如檗，口如蜜。\n一埦粗茶，多虚少实。\n院主两眼眯?，毕竟何曾得吃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14763,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十八首 其十八","author":"释法薰","text":"我若坐时汝须立，同坐同立成瞎汉。\n非瞎汉，把手大家行那畔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14764,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十八首 其十七","author":"释法薰","text":"世尊拈花，迦叶微笑。\n正法眼藏，永永流通。\n古佛今佛，心同道同。\n风从虎，云从龙。\n节启天基伸祝颂，寿齐南北两高峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14765,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十八首 其十六","author":"释法薰","text":"节令不相饶，阳生第一爻。\n诸佛道长，众生道消。\n拄杖子，独孤标。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14766,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十八首 其十五","author":"释法薰","text":"水流湿，火就燥。\n临安纸贵，一状领过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14767,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十八首 其十四","author":"释法薰","text":"不是琅琊，洎被这僧惑乱。\n若非这僧，琅琊令不虚行。\n末后棒头卖峭，更向露柱藏身，笑杀毗耶杜口人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14768,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十八首 其十三","author":"释法薰","text":"秘魔老儿，擎个叉子，不肯放下。\n灵山这里，净裸裸，赤洒洒，没可把。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14769,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十八首 其十一","author":"释法薰","text":"祖师门下，讨甚巴鼻，满耳春风浩浩地。\n草木丛林，灯笼露柱，心空及第。\n汝等诸人，因甚却来这里瞌睡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14770,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十八首 其十","author":"释法薰","text":"日迁月化，又见中夏。\n衲僧那事，如何问著，人人口哑。\n有誵讹，不借借。\n六月卖松风，人间恐无价。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14771,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十八首 其九","author":"释法薰","text":"古人一指头禅，一生受用不尽。\n得恁么明白，得恁么简径。\n灵山这里不较多，三尺杖子搅黄河。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14772,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十八首 其八","author":"释法薰","text":"不问有言，不问无言。\n灵山拄杖，斜靠壁边。\n风光都占尽，不费一文钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14773,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十八首 其七","author":"释法薰","text":"乾峰锦包特石，云门铁裹泥团。\n筑著磕著，言端语端。\n不是任公子，徒劳话钓竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14774,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十八首 其三","author":"释法薰","text":"十八十九，痴人夜走。\n十九二十，人信不及。\n信得及，观音院里有弥勒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14775,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十八首 其四","author":"释法薰","text":"腊月烧山，火势炎炎。\n目前包裹，借手行拳。\n若是衲衣下事，犹较十万八千。\n御楼看射猎，不是刈茆田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14776,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十八首 其六","author":"释法薰","text":"折脚铛子，大家知有。\n左提右挈，劳烦众手。\n山僧赢得百无忧，一向面南看北斗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14777,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"彬监寺争田","author":"释法薰","text":"衲僧公验既分明，祖父田园尽力争。\n他日水云同一饱，几人放箸便忘恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14778,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清庵主请赞","author":"释法薰","text":"以石为田，举世怪笑。\n一粒入土，不耘自秀。\n也无禅，也无道。\n衲僧未跨门，早已勘破了。\n顶门自有通天窍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14779,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"维摩赞","author":"释法薰","text":"据坐胡床，风悄悄地。\n四八痴人夜走，未免落他圈樻。\n七佛之师，也遭连累。\n石田当时在傍，只消打个喷嚏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14780,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寒山拾得望月赞","author":"释法薰","text":"木叶题诗，寺厨执爨。\n遇夜乘闲，林间舒散。\n一片冰壶无影像，分明照破渠肝胆。\n堪笑当时天台山中，也无一个具眼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14781,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"普化和尚赞","author":"释法薰","text":"走城郭，摇铃铎。\n堂前吃生菜，触著驴性发。\n勘破河阳木塔，擒下临济小卒。\n赚却镇州一城人，铎声已远青天阔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14782,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"福长老绘师像请赞","author":"释法薰","text":"施不犯令，用无病药。\n笑有祖已来，错会者多。\n将衲僧珍财，尽底籍没。\n空腹高心，有年无德。\n就中一处最堪怜，车子横推向途辙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14783,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"潮州礼长老请赞","author":"释法薰","text":"面如死灰，匙挑不上。\n祖翁活业，尽情破荡。\n无星秤子拈来，也解分斤定两。\n礼长老，少思算。\n鳄鱼幸自徙化方，勾引渠归成祸患。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14784,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题参政楼公二圆相图","author":"释法薰","text":"皎然书平定字，攻愧写二圆相，引得多少平人望云上树。\n且喜两没交涉，要知的实，却须亲见石田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14785,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赞三教图","author":"释法薰","text":"警世昏，三老翁，服虽殊，心亦同。\n于中议优劣，蒿箭射虚空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14786,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赞丰干","author":"释法薰","text":"走松门，寻寒拾。\n虎斑易见，人斑难识。\n识不识，恶声恶迹成狼藉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14787,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赞五祖演和尚","author":"释法薰","text":"参录公犹未，瞥见白云方始彻果。\n有超师之作，敢道端师翁语拙。\n一生居淮不入浙，独弄单提这一著。\n至于接三佛，控南堂，以一大藏，切入啰娘。\n夫是之谓东山正续，毫发不移，亘千万世，源深流长者也。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14788,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赞水月观音","author":"释法薰","text":"现自在端严相，起利他悲悯心。\n水茫茫，月沉沉。\n众生无尽，我愿方兴。\n晓而复昏，泯去来今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14789,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赞布袋","author":"释法薰","text":"掣风颠，走市廛。\n回头顾盼，拄杖横肩。\n山僧既见，不可无言。\n叻，放下破布袋，与你一文钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14790,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赞吕先生","author":"释法薰","text":"为儒儒不达，学仙仙非真。\n黄龙门下过，秋蚊咬铁钉。\n回先生，回先生。\n岳阳人不识，老树却成精。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14791,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赞李源圆泽图","author":"释法薰","text":"昭昭灵灵，未脱生死。\n等闲狭路相逢，无奈这冤家子。\n天竺山前招角歌，至今馀韵在松萝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14792,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赞政黄牛","author":"释法薰","text":"不解倒骑，惟牛所之。\n郊原平衍，鞭索不施。\n山黯黯，水漪漪。\n知我者，白鹭鸶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14793,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赞黄檗和尚","author":"释法薰","text":"破布裹真珠，古寺甘守拙。\n与裴国安名，对百丈吐舌。\n棒头敲出小厮儿，却向大愚言下瞥。\n瞥不瞥，返遭一掌如何雪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14794,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赞朝阳穿破衲待月了残经 其一","author":"释法薰","text":"一衲三冬，千针万线。\n日影上三竿，眼力增一半。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14795,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赞朝阳穿破衲待月了残经 其二","author":"释法薰","text":"日晷已殂，我经未了。\n掩卷立须臾，冰壶挂林杪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14796,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"拈古十四首 其十二","author":"释法薰","text":"父子至亲，心眼无二。\n筑著磕著，透顶透底。\n傍观只把当儿戏，苍龙搅动澄潭水。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14797,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]