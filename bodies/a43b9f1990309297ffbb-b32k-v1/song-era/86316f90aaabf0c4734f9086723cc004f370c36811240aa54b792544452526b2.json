[{"title":"水行","author":"洪咨夔","text":"岸曲频移柂，巾攲独倚樯。\n月分云外影，风进水边凉。\n宿鸟树三匝，佳人天一方。\n清斯缨可濯，谁为赋沧浪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39630,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水宿","author":"洪咨夔","text":"分席眠鸥渚，庐山梦已通。\n蓬声疏密雨，灯影往来风。\n我正思吾母，儿应说乃翁。\n拥衾天未晓，此味与谁同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39631,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王火井见过先以诗寄用韵 其二","author":"洪咨夔","text":"故人寒踏龙门路，来听深山唱竹枝。\n半世向人长落落，几回于我独奇奇。\n淡交似水有馀味，薄俗如云无定姿。\n一点青灯俱白发，相看不语只心知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39632,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王火井见过先以诗寄用韵 其一","author":"洪咨夔","text":"自期东里先生似，恰与西龙道院宜。\n槲叶萧骚秋入画，梅花的皪月供诗。\n盟鸥谁是知机早，叹鹤吾犹决计迟。\n归去来兮松菊在，故山毋用费文移。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39633,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"长宁高守见寄用韵奉酬","author":"洪咨夔","text":"呼吸东风养姹婴，翰林非主墨非卿。\n吾身元与三才并，此性须存一点明。\n盘谷钓鲜深复窈，羌村倾榼浊还清。\n久要谁似长宁守，尚记慈恩恶姓名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39634,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"风定船开夜泊柳子口上到荆州尚三程","author":"洪咨夔","text":"山远江平眼为开，楚楼西畔即阳台。\n金钗短笠风声接，蒸裹燋糟节物来。\n鸡唤客程三老起，雁将归梦五更回。\n白云飞处西湖近，应买霜螯试泼醅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39635,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丙戌天基节自至道宫趋宝福院寒甚","author":"洪咨夔","text":"朝谒千秋节，攀援万岁藤。\n山明松戴雪，涧涩石怀冰。\n清壮髯还戟，酸癯面亦棱。\n暖寒能破戒，珍重虎溪僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39636,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东山次俞紫微止止堂韵","author":"洪咨夔","text":"佛法元无法，人谋尽过谋。\n说空犹是着，领妙更何求。\n径滑松杉古，窗虚水石幽。\n琤琤鸣铁里，安处一时休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39637,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东山怀谢傅用礼灭翁韵","author":"洪咨夔","text":"金堂石室旧徜徉，被发依然下大荒。\n月送婵娟华落蕊，云移缥缈湿疏篁。\n桓伊筝外深情酒，幼度棋边定力香。\n往古来今开阖眼，楼头吹面朔风凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39638,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东屯","author":"洪咨夔","text":"荦确嵚岑转百盘，峡天深处得平宽。\n秋风策策蘼花老，暮雨萧萧稻子寒。\n仁者乐山心本静，硕人在涧体俱胖。\n农家不解诗翁趣，只道丰年了纳官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39639,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"仙鹤楼避暑","author":"洪咨夔","text":"孤塔山光寂，危楼岸影斜。\n秋声来木末，客思满天涯。\n离列高低树，沧茫隐见沙。\n夜凉人被酒，乘月快浮家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39640,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"台中听雪","author":"洪咨夔","text":"淅沥松厅夜，空山一样声。\n冰霜元自劲，水月更添清。\n衾薄难留梦，窗虚易得明。\n庭乌催奏墨，未晓已先鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39641,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"叶主簿挽诗","author":"洪咨夔","text":"生理鸱夷子，心期桑苧翁。\n行厨脩竹月，坐舰落花风。\n雏好才孤凤，行疏忽断鸿。\n吴松明远目，一点夕阳红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39642,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵双桂","author":"洪咨夔","text":"物理无枯底有荣，一双玉树倚脩楹。\n长如拱璧天球在，元共交梨火枣生。\n卜筑地连盘谷胜，赋归人占小山清。\n昼阴最喜添新绿，时有佳禽自荐名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39643,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宁宗皇帝挽诗 其二","author":"洪咨夔","text":"德粹三灵接，功成万国雍。\n方培丰水芑，忽跨鼎湖龙。\n庙号追文考，陵名冠世宗。\n微臣趋觐晚，洒涕续车攻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39644,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宁宗皇帝挽诗 其一","author":"洪咨夔","text":"虚己尧黄屋，清心汉弋绨。\n乾符开太一，坤轸拓全齐。\n镇国天球在，宾空宝仗迷。\n历年施泽久，四海哭遗黎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39645,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"左蠡","author":"洪咨夔","text":"山为飞沙白，江缘涨潦黄。\n古今双去鹜，天地一轻航。\n隽永还攲枕，牢愁忍别觞。\n晴云横不度，何处是柴桑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39646,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"平山","author":"洪咨夔","text":"放脚氛埃表，搔头广莫间。\n淮分三代水，江护六朝山。\n落日苍烟起，秋风白鸟还。\n欧韩呼不起，髀满鬓毛斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39647,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"正月三日同莫干祝法游东西园","author":"洪咨夔","text":"探得行春第一筹，南梢花事半将休。\n断云不碍远山碧，新月自随江水流。\n金谷主人真已矣，玉堂老子尚来不。\n丁宁留取蒲城酒，更约东风汗漫游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39648,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用子有述怀韵为寿","author":"洪咨夔","text":"笔力强于二石弓，文场早合擅元戎。\n东西涂抹未为老，左右图书那得穷。\n三日窥牛酬壮志，十年到凤策奇功。\n更须传取长生诀，蜜炬高烧不受风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39649,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用王司理韵送别 其二","author":"洪咨夔","text":"芦花秋摵摵，征思旆悠悠。\n歌吹莫愁国，鼓铙熊绎州。\n胸奇空盾鼻，胆隽落旄头。\n傥有西风雁，频书老故侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39650,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用王司理韵送别 其一","author":"洪咨夔","text":"亨衢方四十，满谓乃翁如。\n为底澼洸药，依然城旦书。\n光尘风物里，消息事情初。\n束起东西玉，功名富贵馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39651,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用伯脩韵迓虞提刑","author":"洪咨夔","text":"从来图易必思艰，运甓工夫莫放闲。\n万里功名终竟在，百年元气早须还。\n安危着眼棋枰外，中否留心弩括间。\n寄似匆匆无几语，华阳东去是潼关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39652,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用吴秘书正月晦韵","author":"洪咨夔","text":"揽春群玉写芳怀，次第安排到药苔。\n但得斯文留脉在，须教我辈放眉开。\n疏风细雨桃花过，竹屋柴门燕子来。\n老去湖山无复梦，荷锄西崦觅桤栽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39653,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用虞提刑见寄诗韵答之 其二","author":"洪咨夔","text":"鸡鸣而起一般时，舜蹠殊途觉与迷。\n此理天无分厚薄，乃心人自眩东西。\n柴门风雨榴花老，草巷烟霏燕子低。\n玉汝有书来万里，圣贤不泰不栖栖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39654,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用虞提刑见寄诗韵答之 其一","author":"洪咨夔","text":"有美人兮古锦官，落花芳草几凭栏。\n纷纷世故肱三折，忽忽年华指一弹。\n诗到考槃须熟讲，易于未济莫轻看。\n门前尺雪青灯夜，尚欲从公扣两端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39655,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用韵答子有","author":"洪咨夔","text":"旧雨来人眼底稀，春风独许共襟期。\n斜川追古年年早，曲水从今事事奇。\n烂熳和诗齐少长，淋漓被酒略崇卑。\n惊回蜀道芳时梦，花亚银钗舞竹枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39656,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用韵答厉辅卿 其二","author":"洪咨夔","text":"南北锦一住，东西岩屡登。\n报春梅有信，送酒鹊无凭。\n之子能相过，诗名不浪称。\n漉冰烹小凤，爽思为渠增。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39657,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用韵答厉辅卿 其一","author":"洪咨夔","text":"坐穷无过客，失喜得吾侪。\n材逸类淮海，诗清如简斋。\n山明知玉气，水涸见霜涯。\n期子进此道，为亲生好怀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39658,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用韵答赵主簿","author":"洪咨夔","text":"逸气盖三谢，英词参二班。\n飞緌宜北阙，枉驾忽东山。\n花妥昼阴寂，絮吹春思闲。\n光风知几转，尽付酒杯间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39659,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用韵答游司直见寄","author":"洪咨夔","text":"道在皇王帝霸间，古今同是一人寰。\n不愁垂白三千丈，独喜飞黄十二闲。\n晚桂荐花熏鼎古，寒松堕子茗瓯斑。\n山中风味无人会，赖得新诗起老顽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39660,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"白鹿书院","author":"洪咨夔","text":"万绿团阴町疃场，倚凉弦诵玉琅琅。\n溪山涵毓中和气，草木薰蒸正大香。\n陋巷颜渊何所乐，舞雩曾点若为狂。\n懦夫百世闻风起，此去濂溪更有庄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39661,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"石斛","author":"洪咨夔","text":"蚱蜢髀多节，蜜蜂脾有香。\n藓痕分磥砢，兰颖聚琳琅。\n药谱知曾有，诗题得未尝。\n瓦盆风弄晚，披拂一襟凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39662,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"邛杖次韵","author":"洪咨夔","text":"槎使携归饷老人，高棱疏节屈中伸。\n拨开豺虎凭陵气，摄取蛟龙变化身。\n访洗头盆还喜健，伴行脚笠未嫌贫。\n一般仙骨清如鹤，倚看沧溟解起尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39663,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"龙州麸金丹砂到官后民告所得倍于他时喜为赋诗","author":"洪咨夔","text":"乳到零陵竭，珠辞合浦行。\n地非悭所产，人自晦于征。\n砂粒层层长，金麸点点明。\n盛衰非自尔，利莫与民争。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39664,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"龙池沙涨","author":"洪咨夔","text":"龙徙三湫宅，山飞百道洪。\n云车风马去，福地洞天空。\n苍莽浑沙积，崎岖没径通。\n等闲陵谷变，惊倒白头翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39665,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"龙尾","author":"洪咨夔","text":"浅碛苕花紫，平畦芋梗红。\n暝收渔筏雨，凉入酒帘风。\n客路三年梦，官身两鬓蓬。\n谁知龙尾道，却在鹿头东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39666,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"会心","author":"洪咨夔","text":"不是非心佛，还疑有漏仙。\n朝闻驰鼓起，夜候定钟眠。\n浴少衣偏垢，游多袜易穿。\n祗将毋不敬，推倒野狐禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39667,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"先妣忌日发昭化","author":"洪咨夔","text":"短棹横秋桔柏矶，青山无尽白云飞。\n官三年矣母安在，天一方兮儿欲归。\n拱木阴阴闲墓隧，背萱寂寂老庭闱。\n呼儿扫驿陈遗像，杯酒炉香泪满衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39668,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再用陀字韵","author":"洪咨夔","text":"烟霏深处万山罗，闲里工夫岁月磨。\n上采纬书乾凿度，下搜杂志薛延陀。\n手披不厌薰沉水，心悟何妨涉贝多。\n若问尊经阁中事，南丰作记也须呵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39669,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再和廷迈","author":"洪咨夔","text":"步障晴丝夹道青，土桥石磴向西坰。\n李乌奴宅空怀古，武阿婆祠懒乞灵。\n杜宇一声犹客路，白云万里是亲庭。\n只应江水知人意，东下何曾半息停。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39670,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再赋 其二","author":"洪咨夔","text":"一出俄经震巽离，盈虚消息取诸随。\n盆栽菡萏何时藕，檐挂蜘蛛尽日丝。\n左墄右平魂梦远，东岗西崦杖藜迟。\n棱棱瘦骨萧萧发，恰与黄冠野服宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39671,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再赋 其一","author":"洪咨夔","text":"谁为风光管合离，绿阴芳草日相随。\n此身百丈牵三峡，吾道千钧系一丝。\n力戒荡舟君子适，志期学圃小人迟。\n平生客气消磨尽，醉固佳哉醒亦宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39672,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"刘家江阻风 其二","author":"洪咨夔","text":"岁月孤槎转，风波断梗随。\n谢三元自惯，巽二莫相欺。\n沙岸往来拍，芦林开阖吹。\n欠伸呼斗酒，一笑酹冯夷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39673,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"刘家江阻风 其一","author":"洪咨夔","text":"动地千牛力，行天万马声。\n溟濛迷太极，浩荡送平生。\n梦与屏帏兀，心随簋缶倾。\n黄头多着缆，作止候三更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39674,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"后溪挽诗 其二","author":"洪咨夔","text":"气象融三极，规摹隘九州。\n天津朝发轫，野渡晚横舟。\n卫道身何爱，忧时死未休。\n落花春寂寂，万古蜀江流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39675,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"后溪挽诗 其一","author":"洪咨夔","text":"玉佩华裾翠，霜髯睟颊红。\n四朝天下老，百世后溪翁。\n绿竹猗重较，黄裳美在中。\n平生涵养力，于道有全功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39676,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"回龙寺松","author":"洪咨夔","text":"环蜀多宜柏，回龙独见松。\n似惊前辈落，忽与故人逢。\n水石清高骨，风霜老退容。\n更须坚晚节，莫洿大夫封。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39677,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"孙推内子挽诗","author":"洪咨夔","text":"玉立金闺客，家人亦许清。\n共听秋塞柝，细剔夜窗檠。\n娣袂从渠好，儿襦得我平。\n西风吹落叶，不尽夕阳明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39678,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"安泰","author":"洪咨夔","text":"不是官身是客身，下车随意踏芳尘。\n空濛山色雨非雨，冷淡花梢春自春。\n裘弊黑貂犹耐老，褐移紫凤未全贫。\n青帘垂脚游丝外，到处东风似故人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39679,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岁杪用韵 其二","author":"洪咨夔","text":"黄麾春簇仗，梦不到东华。\n瓦研磨冰叶，砖炉煮雪花。\n穷甘猿帐卧，老倦犊辕挝。\n冻解光风转，晴波拍两涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39680,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岁杪用韵 其一","author":"洪咨夔","text":"日月磨心绪，风霜染鬓华。\n历看新岁草，梅忆旧年花。\n浊酒供僛舞，清歌应掺挝。\n阿咸多事在，犹问老生涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39681,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"廷迈留少城和初入西龙道院诗来用韵答之","author":"洪咨夔","text":"雪锦楼高眼易寒，春风朵朵似长安。\n终年避事宁为客，到处寻诗胜觅官。\n金凿落边檛蹀躞，玉参差里舞?跚。\n华灯变尽归来晚，回首西涪可忍看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39682,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次及甫入峡杂咏 峡口","author":"洪咨夔","text":"山隘留天少，江迂占地多。\n风梢猿自挂，露草虎曾过。\n坐客犹吴语，行人尽楚歌。\n川妃澜浪甚，着语试谁何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39683,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次及甫见寄 其二","author":"洪咨夔","text":"燕颔非无相，鸢肩会有时。\n三薰珍敝帚，一笑玩征棋。\n松菊吾家物，衡茅厥父基。\n青峰帘独捲，细和式微诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39684,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次及甫见寄 其一","author":"洪咨夔","text":"文采晁无咎，襟期李伯时。\n昔为钩直钓，今是劫忙棋。\n弩谷深无路，盘堤薄有基。\n广文如我冷，两地四愁诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39685,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次及甫即事","author":"洪咨夔","text":"万里西征路，同君汗漫期。\n吴歈花里曲，楚些菊边词。\n问学千鸡蹠，功名五羖皮。\n目前姑置此，多办峡江诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39686,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次及甫觉寒","author":"洪咨夔","text":"霜勒衾如水，寒于客有期。\n不成神女梦，空赋外孙词。\n瓮暖宜桑落，冠凉怯竹皮。\n悬知鄱水上，冷落扊扅诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39687,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次及甫韵送致远别","author":"洪咨夔","text":"塞尘没没马萧萧，世事今朝异昨朝。\n为羡白鸥何浩荡，却思斥鴳亦逍遥。\n平沙露碛江波敛，远树明堤野雾销。\n快着扁舟归教子，胜渠满屋贮胡椒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39688,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次子有下第韵","author":"洪咨夔","text":"东风换骨立成仙，五色终迷自古然。\n龙变未符今举谶，鹤来当验后科缘。\n情如中酒宜亲酒，命合腰钱会有钱。\n许买娉婷供老伴，不妨迟得两三年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39689,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次仲禹迓叔禹西归韵 其二","author":"洪咨夔","text":"万里春风一札书，锦幢绣旆二难俱。\n殷红荔子武侯渡，深碧藕花房相湖。\n家庆盛于群玉府，身名荣过执金吾。\n人生信是团栾好，我亦归谋种芋区。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39690,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次仲禹迓叔禹西归韵 其一","author":"洪咨夔","text":"坡颍风流几许年，依然夜雨落花边。\n白头故媪釜忘轑，红颊诸孙衣解牵。\n聚雁沙平江百折，养鹅水暖柳三眠。\n行厨洗玉更为寿，父老来看许近前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39691,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次同年王火井不遇之韵","author":"洪咨夔","text":"题遍慈恩最上层，青云涂辙几人升。\n一经秋雨禾方穟，未到春风海亦冰。\n闹里功名多目论，淡中气味独心朋。\n苍苔不扫芙蓉老，有客敲门自出应。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39692,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次李绵州和丁兴元韵 其二","author":"洪咨夔","text":"梅花已是隔年香，投老何能面复光。\n求则得之青籸饭，归斯受矣白云乡。\n果柑微似温生乳，阆柿多于处着霜。\n扶起东南风物梦，举觞目送去鸿翔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39693,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次杨泸南以前区字韵送行 其二","author":"洪咨夔","text":"万里来鸿未有书，社前归燕与人俱。\n涨痕落后杭巫峡，风力高时略太湖。\n深愧平生嗟靖节，一匡天下望夷吾。\n延英入定中兴业，早震天声到鬼区。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39694,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次杨泸南以前区字韵送行 其一","author":"洪咨夔","text":"水稳风凉快长年，归帆东指白云边。\n落花款段儿能御，荐草乌犍手自牵。\n蜀口戍兵谁饱饭，淮头编户几安眠。\n野人只愿群贤进，辐凑良筹到上前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39695,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]