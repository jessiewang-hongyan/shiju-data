[{"title":"颂古三十八首 其三十八","author":"释从瑾","text":"南枝向暖北枝寒，何事春风作两般。\n凭仗高楼莫吹笛，大家留取倚阑看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6815,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十八首 其二十九","author":"释从瑾","text":"古帆未挂时，后园驴吃草。\n日短苦夜长，行人须及早。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6816,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十八首 其二十六","author":"释从瑾","text":"棚前夜半弄傀儡，行动威仪去就全。\n子细思量无道理，里头毕竟有人牵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6817,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十八首 其二十四","author":"释从瑾","text":"无魔无我已降魔，添得时人眼里花。\n今日镆铘无用处，也知贼不打贫家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6818,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十八首 其二十三","author":"释从瑾","text":"威风凛凛不容攀，跳入怀中便解颜。\n不是酒肠宽似海，争知诗胆大如山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6819,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十八首 其二十","author":"释从瑾","text":"悟得平常达本乡，时人多怕落平常。\n青春只有九十日，烂醉都无一百场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6820,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十八首 其十八","author":"释从瑾","text":"同根一体都如梦，梦里惺惺眼又花。\n蝴蝶飞来过墙去，不知春色落谁家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6821,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十八首 其十五","author":"释从瑾","text":"彻底冰壶无影像，倒翻筋斗模难成。\n千峰雨歇黄梅后，桂魄还从海上生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6822,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十八首 其十四","author":"释从瑾","text":"竹篱茆舍酒旗斜，一个胡芦败两家。\n酒后不知天与地，皈来满地是桃花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6823,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十八首 其十三","author":"释从瑾","text":"剃头头光生，洗脚脚清爽。\n脱衣上床眠，抓著通身痒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6824,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十八首 其十二","author":"释从瑾","text":"一喝当头雷电奔，人间说亦暗销魂。\n看来岂止聋三日，直至如今海岳昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6825,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十八首 其十","author":"释从瑾","text":"一箭射双雕，双雕随手落。\n波摇岳阳城，月满滕王阁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6826,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十八首 其八","author":"释从瑾","text":"自有觅不得，无端面发红。\n翻身吃一?，两手摸虚空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6827,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十八首 其六","author":"释从瑾","text":"踏翻地轴地不动，推倒天关天更高。\n稳泛铁船归少室，至今天下起风涛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6828,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十八首 其五","author":"释从瑾","text":"蕴空谁见法中王，觌体何曾碍剑光。\n古庙藤萝穿户牖，断碑风雨碎文章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6829,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十八首 其一","author":"释从瑾","text":"谁在画楼西，相逢语笑低。\n到家春色晚，花落鹧鸪啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6830,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三首 其一","author":"释从瑾","text":"睦州担板汉，从来见一边。\n浅深三尺水，上下两重天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6831,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十八首 其三十七","author":"释从瑾","text":"佛手驴脚生缘，南海波斯泛铁船。\n精金美玉团堆卖，毕竟何曾直一钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6832,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十八首 其三十五","author":"释从瑾","text":"我脚何似驴脚，急走归家日将落。\n自古长安如镜平，无端醉倒黄幡绰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6833,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十八首 其三十四","author":"释从瑾","text":"我手何似佛手，合掌面南看北斗。\n兔推明月上千峰，引得寒山开笑口。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6834,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十八首 其三十三","author":"释从瑾","text":"洞庭湖里失却船，赤脚波斯水底眠。\n尽大地人呼不起，春风吹入杏花村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6835,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十八首 其三十二","author":"释从瑾","text":"当阳打动番南鼓，万象森罗立地闻。\n不是大家齐则剧，难消白日到黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6836,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十八首 其三十一","author":"释从瑾","text":"顿超见色闻声句，不涉明心悟道言。\n花落鸟啼岩下寺，月明人唤渡头船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6837,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十八首 其三十","author":"释从瑾","text":"当面非暗投，应机皆直说。\n乾峰与云门，两口同一舌。\n若是续貂人，弄巧便成拙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6838,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十八首 其二十八","author":"释从瑾","text":"须弥倒卓，海水逆流。\n同参相访，作尽冤雠。\n休休，明日黄花蝶也愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6839,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十八首 其二十七","author":"释从瑾","text":"一喝两喝，全机出没。\n宾主历然，未免俱瞎。\n半夜摸乌龟，明月照积雪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6840,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十八首 其二十五","author":"释从瑾","text":"棒头有眼，眼里无筋。\n多逢浊富，罕遇清贫。\n自入洞门烟锁断，不知世上几经春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6841,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十八首 其二十二","author":"释从瑾","text":"临济赵州，禅林宗匠。\n特地相逢，恰似相扑。\n撞见今时行脚僧，呼为两个閒和尚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6842,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十八首 其二十一","author":"释从瑾","text":"钟送黄昏鸡报晓，赵州何用閒烦恼。\n裂破虚空作两边，古庙香炉出芝草。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6843,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十八首 其十九","author":"释从瑾","text":"甘贽设粥，南泉打锅。\n一般病痛，彻底誵讹。\n更有些儿好笑，明朝饿杀禅和。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6844,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十八首 其十七","author":"释从瑾","text":"恁么不得总不得，脱却布衫赤骨律。\n劈头一搭忽翻身，便见口开并眼白。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6845,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十八首 其十六","author":"释从瑾","text":"无目仙人揣骨头，暗中摸索认王侯。\n价高毕竟无人买，冷却勾栏懡㦬休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6846,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十八首 其十一","author":"释从瑾","text":"当年高甲已登科，读尽人间万卷书。\n今日一身天地窄，思量好事不如无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6847,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十八首 其七","author":"释从瑾","text":"九年冷坐已败阙，只履西归更脱空。\n后代儿孙空妄想，鸥鸪啼不为春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6848,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十八首 其三十六","author":"释从瑾","text":"人人有个生缘，且非东土与西天。\n击珊瑚树枝枝好，撒水银珠颗颗圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6849,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十八首 其四","author":"释从瑾","text":"家家门口透长安，不见纤毫眼界宽。\n无法无人谁付嘱，难兄难弟自相谩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6850,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十八首 其二","author":"释从瑾","text":"大地绝纤尘，面南看北斗。\n嫁鸡逐鸡飞，嫁狗逐狗走。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6851,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三首 其二","author":"释从瑾","text":"开口不见齿，伸手不见掌。\n夜半忽相逢，葛藤长万丈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6852,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三首 其三","author":"释从瑾","text":"玄沙驴前，云门马后。\n更问如何，合取狗口。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6853,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十八首 其九","author":"释从瑾","text":"不会黄梅佛法，梦中合眼惺惺。\n此地无金二两，俗人酤酒三升。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6854,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"释允堪","text":"始生岩谷畔，早有月中香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6855,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈七首 其五","author":"释允韶","text":"宝剑未出匣，神光射斗牛。\n千兵虽易得，一将实难求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6856,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈七首 其七","author":"释允韶","text":"篱畔黄花含晓露，庭前丹桂喷秋香。\n明明此物非他物，脱体承当不厮当。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6857,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈七首 其六","author":"释允韶","text":"八月秋，何处热。\n风入松，声瑟瑟。\n落霞孤鹜齐飞，秋水长天一色。\n不是对景对机，不是应时应节。\n下座巡堂去，吃茶珍重歇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6858,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈七首 其四","author":"释允韶","text":"秋光清浅时，白鹭和烟岛。\n良哉观世音，全身入荒草。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6859,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈七首 其三","author":"释允韶","text":"月月初一十五，处处槌钟打鼓。\n若不毁谤禅道，便是呵骂佛祖。\n尽道慈悲接人，毕竟无过于此。\n承天鼻孔笑伊，直是未敢相许。\n坐人舌头即不无，争教无舌人解语。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6860,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈七首 其二","author":"释允韶","text":"老汉当年腊月八，三更夜半颠狂发。\n刚把长钉钉眼睛，直至而今未能拔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6861,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈七首 其一","author":"释允韶","text":"一五二五，机轮无阻。\n南山起云，北山下雨。\n有人却道锦上添花，有人又道泥中洗土。\n有人又道离此二途，便见丹霄独步。\n若总如斯论量，山僧未敢相许。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6862,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"龙井十题 其一 风篁岭","author":"释元净","text":"风篁荫修岭，挺节含虚心。\n悠悠往还客，孰不聆清音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6863,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"龙井十题 其二 龙井亭","author":"释元净","text":"虚亭乱石间，中有潜虬府。\n澄湛源莫穷，旱岁为灵雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6864,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"龙井十题 其六 讷斋","author":"释元净","text":"忆昔毗耶老，杜口有谁听。\n还闻寂寞里，其辩过雷霆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6865,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"龙井十题 其五 坤泉","author":"释元净","text":"物外老馀生，泉发幽岩里。\n自可给瓶盂，不羡沧溟水。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6866,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"龙井十题 其八 照阁","author":"释元净","text":"高峰御皎月，深壑泻飞湍。\n谁来白云里，与汝凭栏看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6867,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"龙井十题 其四 潮音堂","author":"释元净","text":"真说无所示，真听无所闻。\n海潮山外过，妙响入深云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6868,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次赵清献公诗","author":"释元净","text":"南极星临释子家，杳然十里税青华。\n公年自尔增仙籍，几度龙泓诗贡茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6869,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵参寥师寄秦太虚三绝句，时秦君举进士不得 其三","author":"苏轼","text":"得丧秋毫久已冥，不须闻此气峥嵘。\n何妨却伴参寥子，无数新诗咳唾成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6870,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵参寥师寄秦太虚三绝句，时秦君举进士不得 其一","author":"苏轼","text":"秦郎文字固超然，汉武凭虚意欲仙。\n底事秋来不得解？\n定中试与问诸天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6871,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和苏子由","author":"释元净","text":"春去春来冬复冬，几思虚论未缘逢。\n歙溪道赏兄遗迹，勿少龙泓一老龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6872,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"四牛图颂 其二","author":"释元净","text":"改换毛衣了，从兹不自由。\n只知今日事，忘却旧时牛。\n步步虽同辙，昂昂不转头。\n四山成隔阔，相逐没时休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6873,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"四牛图颂 其三","author":"释元净","text":"瞥尔家栏里，回头识得伊。\n不须常管带，取次倒横骑。\n似客归家日，如儿得母时。\n平田荒草里，吹唱哩啰哩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6874,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和佛印","author":"释元净","text":"久仰真风扬四海，今朝邂逅欲生莲。\n法灯晃耀皆蒙照，佛印灵玄孰可传。\n诸子丛林禅里老，十方尘刹上中天。\n烁迦罗眼周三际，豁破群迷量廓然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6875,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"四牛图颂 其四","author":"释元净","text":"脱下娘生裤，还归不动尊。\n万缘具顿罢，一路涅槃门。\n大海波澜息，青天绝点云。\n披毛同异类，无刹不分身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6876,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"四牛图颂 其一","author":"释元净","text":"混沌不分处，三缘未合时。\n神通难可测，佛眼莫能窥。\n坦荡全躯白，安眠露地肥。\n为耽春色好，又被业风吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6877,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"龙井十题 其三 归隐桥","author":"释元净","text":"谢讲竺峰寺，归隐新此桥。\n院幽结林表，身老寄烟霄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6878,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"龙井十题 其九 狮子峰","author":"释元净","text":"独尔群山里，人称狮子峰。\n无心自哮吼，显晦烟云中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6879,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"龙井十题 其七 寂室","author":"释元净","text":"心寂寂自绝，此意为君说。\n寒云嵌空亭，独有月照雪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6880,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"龙井十题 其十 萨埵石","author":"释元净","text":"巨石如掌平，兀然半青嶂。\n钦哉昔道人，饲虎兹嵓上。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6881,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"龙井新亭","author":"释元净","text":"暇政去旌旆，杖策访林邱。\n人惟尚求旧，况悲蒲柳秋。\n云谷一临照，声光半载留。\n轩眉狮子峰，洗眼苍龙湫。\n路穿乱石脚，亭蔽重冈头。\n湖山一日尽，万象掌中浮。\n煮茗款道论，奠爵致龙优。\n过溪虽犯戒，兹意亦风流。\n自惟日老病，当期安养游。\n愿公归庙堂，用慰天下忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6882,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"释元净","text":"要行便行，要坐便坐。\n六处神通，是个什么。\n把定时一物不为，放行时杀人放火。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6883,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"释元实","text":"一位才彰五位分，君臣叶处紫云屯。\n夜明帘卷无私照，金殿重重显至尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6884,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"曹孝女庙","author":"释元昉","text":"祠古孝诚遥，悲风想暮号。\n月魂迷草色，血泪溅江涛。\n断碣惟黄绢，孤坟掩绿蒿。\n千年暗潮水，亦以姓为曹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6885,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二首 其二","author":"释元易","text":"若实无为无不为，天堂地狱长相随。\n三尺杖子搅黄河，八臂那吒冷眼窥。\n无限鱼龙尽奔走，捉得循河三脚龟。\n脱取壳，铁锥锥，吉凶之兆便分辉。\n借问东村白头老，吉凶未兆若何为。\n休休休，古往今来春复秋。\n白日腾腾随分过，更嫌何处不风流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6886,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂","author":"释元易","text":"拨动乾坤步转移，南观北斗有谁知。\n金乌暮向西山急，晓逐扶桑半夜飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6887,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二首 其一","author":"释元素","text":"大丈夫，秉慧剑，般若锋兮金刚焰。\n非道能摧外道心，早曾落却天魔胆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6888,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古八首 其七","author":"释元聪","text":"松阴行不尽，疏雨下无时。\n世事几兴废，山中人未知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6889,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古八首 其四","author":"释元聪","text":"钻头闹蓝远侍者，刺脑胶盆老赵州。\n两个人前誇好手，面皮三寸不知羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6890,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古八首 其三","author":"释元聪","text":"一下兰桡蓦口鞭，大洋海底火烧天。\n父南子北家何许，风满长空月满船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6891,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]