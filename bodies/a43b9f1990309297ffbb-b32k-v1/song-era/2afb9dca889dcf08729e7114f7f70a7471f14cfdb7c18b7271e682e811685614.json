[{"title":"刘岩居士再和去年中秋见贻次韵","author":"姜特立","text":"苍茫云海渺无津，玉户初圆绝点尘。\n万里共欣云叶净，一年争看桂华新。\n狂吟定约六七友，低唱可无三两人。\n今日公来赓旧曲，梅山惊动主林神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37788,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"刘益之判院挽章","author":"姜特立","text":"倾盖如今五十春，中间还得缀华姻。\n单于万里同哀使，马援一乡称善人。\n告老已能官及子，颁恩更喜爵荣亲。\n佳城一闭成千古，无复传觞酒入唇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37789,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同方叔自郡城归故园","author":"姜特立","text":"吏隐岂无名，东南一客星。\n松关今有主，岫幌不须扃。\n无梦妨清睡，唯閒伴独醒。\n着鞭吾已晚，先愧一鸿冥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37790,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同官直舍有木犀一株盛开与余脩竹惟隔屏墙尔暇日因共言清香绿阴不妨相过异时亦是一段佳话遂成小诗","author":"姜特立","text":"小山丛桂隔墙阴，曲槛脩篁别作林。\n芳意不孤符有德，寒梢相近本无心。\n春多得地生何幸，岁晚为邻分益深。\n赖有高人发佳致，因成盛事寄微吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37791,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"因赴郡会入城","author":"姜特立","text":"十年林下自由身，已放严光作外臣。\n终日奔驰非我意，有时嚅嗫失天真。\n庞公不合来城府，梅福如何走市尘。\n策蹇明朝且归去，故山猿鹤自相亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37792,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岁暮月下有怀","author":"姜特立","text":"春事侵红蕊，年光入白髭。\n暖云笼月夜，斜照放灯时。\n羁宦元无味，清愁只有诗。\n故山无百里，梦寐数归期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37793,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岁暮直舍感怀","author":"姜特立","text":"岁暮坐公馆，永怀时序迁。\n雪消残臈外，春到蚤梅边。\n夜色侵乌鹊，年光送管弦。\n无人同晤语，输写赖诗篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37794,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"巩大监挽诗","author":"姜特立","text":"列国名卿号众多，山堂族望最巍峨。\n魏宫宾客推公干，交趾威名畏伏波。\n老去一麾供坎壈，归来三径足婆娑。\n从今诗酒交朋少，怅望新阡泪若何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37795,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次人韵思弟","author":"姜特立","text":"二陆双飞共一班，士龙何事别长安。\n故园花鸟应无恙，胜日樽罍且自宽。\n春草梦回诗思好，暮荆风急客衣寒。\n苕溪一水苍茫外，无限相思入倚栏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37796,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵木犀","author":"姜特立","text":"老火西驰烧邓林，此花孤绝更清深。\n犀纹隐隐通肌骨，羽葆层层间彩金。\n残蕊尚堪然古鼎，生香长得汎秋砧。\n形容尽入诗人笔，不为唐贤叹陆沉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37797,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵陆郎中","author":"姜特立","text":"亟报门前寄好音，炯然书札照家林。\n兴来自说宦情薄，诗到方知秋思深。\n临老读书因教子，闭门扪虱为搜吟。\n当今大笔如君少，未用深藏叹陆沈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37798,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵黄司理","author":"姜特立","text":"龙墀射策笔如神，马首哦诗句益新。\n忽捧名篇端有意，欲求强对恐无人。\n浸淫汉魏知追古，摸索曹刘已识真。\n荀氏八龙谁最著，慈明头角在云津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37799,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自和","author":"姜特立","text":"喜报纡芳轸，深期办酒壶。\n兴来更唱和，耳热自歌呼。\n正可谈风月，何须较智愚。\n吾今方息驾，无复问征夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37800,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西湖素公爱余泊舟小诗画为扇子","author":"姜特立","text":"老子诗中那有画，阿师画里自兼诗。\n我非今世王摩诘，子岂前身李伯时。\n烟月正临青嶂落，滩声惟许白鸥知。\n可怜半幅鹅溪绢，写此寒江一段奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37801,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"讲官沈大监献东宫米字回赐笔墨因作小诗以求墨","author":"姜特立","text":"闻道宝书天上去，却携香墨袖中归。\n安西纸背曾题识，黟饼文房要发挥。\n素箧想藏玄玉炯，晴窗应试翠云霏。\n先生不作曹瞒吝，分我东斋发易机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37802,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"负暄","author":"姜特立","text":"不是羲和德泽流，寒乡何处觅温柔。\n绝怜天上黄绵袄，大胜人间紫绮裘。\n旋挟胡麻随景转，更携书卷与閒谋。\n天和妙处谁能会，欲献君王却自羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37803,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过行在宿詹塘","author":"姜特立","text":"三十年间倦路岐，今朝犹自羡轻肥。\n敝舆冲雨方行役，朴论干时未息机。\n日暮肠枵聊命酒，夜寒衾薄旋牵衣。\n一廛三径何时遂，且待相如驷马归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37804,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"余有仲子之戚九日亲故携酒访我于梅山之上因咏昔人诗人情皆向菊天意欲摧兰之句不觉凄然有感遂易一字足成篇","author":"姜特立","text":"九日上梅山，愁心卒未安。\n人情皆向菊，天意独摧兰。\n管女不及嫁，莱衣空自寒。\n牛山多感慨，把酒泪阑干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37805,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别枢相","author":"姜特立","text":"未冠鸡窗友，于今鹤发翁。\n功名各自致，齿发略相同。\n欲去情怀恶，临分礼意隆。\n百年才一瞬，无惜寄诗筒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37806,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈方叔","author":"姜特立","text":"聱牙落魄一閒官，职事何尝见一斑。\n不是论松须说剑，若非寻壑即观山。\n閒看落叶随风去，冷笑奔云送雨还。\n更有刘岩杨处士，伴渠痴坐老花间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37807,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈府判兄","author":"姜特立","text":"端忧伤逝者，花事欲如何。\n春色愁边少，悲悰酒后多。\n溪桃方著脸，区木渐成窠。\n拟作开眉计，何当扫障魔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37808,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"张致政挽章","author":"姜特立","text":"上寿身仍健，荣封岁屡终。\n无因拜庞德，空幸识王戎。\n含玉亡遗恨，悬车近古风。\n燎黄应不远，光宠贲幽宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37809,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀故友杨方叔","author":"姜特立","text":"游戏人间世，清虚物外缘。\n皇家虽结网，空谷竟遗贤。\n无恨堪悬剑，伤心有断弦。\n今年汤饼约，为尔一凄然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37810,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杨方叔过访送行","author":"姜特立","text":"遥传轩盖度西冈，亟返柴车喜欲狂。\n不惮除堂十夫费，且谋解榻半窗凉。\n归途送目云千叠，别夜寻诗月一方。\n何日重来慰牢落，梅山花发待传觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37811,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"极目亭有怀韩常伯","author":"姜特立","text":"先生种柳已成围，柳外孤亭但夕晖。\n如觉隐侯前日去，不知丁令几时归。\n云帆夜夜沙头落，风叶年年城上飞。\n吊古登临仰词伯，苦吟精思入幽微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37812,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"汪尚书挽章二首 其二","author":"姜特立","text":"文章事业盖群工，盛世明良喜会同。\n千首歌诗如白傅，百篇奏议似宣公。\n贰师失道违中制，元帅基谋丧后功。\n二十年间遂高志，鸱夷一舸鉴湖东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37813,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"汪尚书挽章二首 其一","author":"姜特立","text":"昔年宦路意相倾，四纪中间一寄声。\n贤嗣登门如对面，新诗缄兴见输情。\n安舆方拟来岩邑，急讣俄传上玉京。\n叹息于今鲜人物，短章吟罢泪沾缨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37814,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"辛亥上冢","author":"姜特立","text":"寒闺守节少年时，志凛冰霜不可移。\n追远积成千古恨，报恩宽作十年期。\n此生不愧先君死，后世应传寡妇碑。\n兰若栖神安稳在，遗言今日九原知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37815,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"閒咏","author":"姜特立","text":"坐叨厚廪饮醇醪，不挟文书不坐曹。\n检校园花为日课，裒寻诗草计年劳。\n仍将书册供慵卧，时唤杯盘佐老饕。\n感激大恩何以报，唯祈圣寿等天高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37816,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陆严州惠剑南集","author":"姜特立","text":"不蹑江西篱下迹，远追李杜与翱翔。\n流传何止三千首，开阖无疑万丈光。\n句到桐江剩深稳，气含玉垒旧飘扬。\n未须料理林间计，蚤晚明堂要雅章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37817,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陈右司挽诗","author":"姜特立","text":"麟经绝学冠名儒，科甲巍峨压隽途。\n两作星郎归省户，五持玉节佩州符。\n义仓睦族前贤少，犹子推恩举世无。\n忝窃亲邻违一奠，不堪老涕落寒须。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37818,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陈德承致政病后得诗且以见贺","author":"姜特立","text":"上恩鼎至愧叨逾，退省何尝有硕肤。\n甘作一麾山吏部，不为三败管夷吾。\n相思梦想江湖隔，熟诵篇章锦绣铺。\n无妄疾来终易愈，岂容医砭值庸夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37819,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"使北","author":"姜特立","text":"持哀万里敢辞难，汴泗都归指顾间。\n车上去程依北斗，马头归梦到南山。\n颇惊魏国山河少，尚觉周家境土悭。\n圣主若图恢复计，直须神武取榆关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37820,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和丁大卿韵","author":"姜特立","text":"久回俗驾向山中，无复诗骚见古风。\n方喜故人千里至，更容清夜一尊同。\n宾筵谈笑知无敌，笔力追陪愧未工。\n自古诗人难并世，归期那敢话匆匆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37821,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和丁使君八咏楼 其一","author":"姜特立","text":"八咏诗成沈隐侯，楼中风月尽兼收。\n三千题里无新语，七百年间有胜流。\n领客登临聊一快，举杯相属更无忧。\n令威早晚冲天去，华表归时记旧游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37822,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和丁使君八咏楼 其二","author":"姜特立","text":"使君政事妙如神，更有新诗字字新。\n方仰高深如海岳，岂知出没尚参辰。\n爱公自昔称贤守，喜我如今有主人。\n况是苏州许酬唱，丘丹应得寄閒身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37823,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和丁使君惠赠 其二","author":"姜特立","text":"杜老才高笔有神，却誇庾信句清新。\n方惭丑女依西子，更觉常星望北辰。\n眼底向来无作者，世间此去有诗人。\n交情何似吟情好，托契犹堪慰老身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37824,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和丁使君惠赠 其一","author":"姜特立","text":"浙江茅土几诸侯，美誉唯公一日收。\n冯翊望之新得郡，颍川黄霸旧承流。\n西湖一火愁中禁，东郡三霖慰客忧。\n早晚秋风吹紫桂，百钱应伴使君游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37825,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和元亨出示山扉诗","author":"姜特立","text":"手自葺柴荆，山扉亦自扃。\n莫辞蓬筚陋，要护草堂灵。\n忙为幽人启，閒无俗士经。\n不妨老赤脚，应户代奴星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37826,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和方叔中秋","author":"姜特立","text":"待月徘徊东涧滨，一天风露净无尘。\n老人欢意年年减，佳节清光夜夜新。\n悼往难传云外信，举杯那复眼中人。\n飘然遥想骑鲸兴，更觉高歌有鬼神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37827,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和王粹中","author":"姜特立","text":"昔年曾踏软红尘，回首修门七换春。\n官职不多还不欠，交情无旧亦无新。\n有花日日招嘉客，问字时时接近邻。\n且愿梅山新秫熟，许君长作醉归人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37828,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和叶叔豹","author":"姜特立","text":"暮龄旌节宠旋归，感谢皇恩念细微。\n已是丘园添盛事，更兼山水借清晖。\n老来自合深韬晦，语妙偏能相发挥。\n祝我青松君意厚，尚嫌诗瘦损腰围。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37829,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和叶枢密同游南明","author":"姜特立","text":"出郭眼增明，遐观酒共倾。\n好风吹暑气，快雨送雷声。\n僧磬清敲寂，莺簧巧弄晴。\n论交方缱绻，奈此别时情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37830,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和叶枢密题谢清音道人扇面","author":"姜特立","text":"纷纷朝市利名忙，唯有山林兴寄长。\n枢相好奇聊玩物，道人弄笔欲专房。\n方嫌小景鲛绡窄，忽辱新诗茧纸香。\n潭府炎蒸无著处，聊将三伏助清凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37831,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和司马倅喜雪","author":"姜特立","text":"寒意沉沉云气深，老来病骨冷难禁。\n巢禽一出不知下，笼鹤乍飞无处寻。\n便欲骑驴洛阳市，不妨放棹越山阴。\n天公已作丰年瑞，更仗风威扫滞淫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37832,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和刘建昌除夕有欠我饮屠苏之句","author":"姜特立","text":"閒愁客底费驱除，可复先生得自娱。\n商陆火添人独坐，沉檀香冷岁还徂。\n望家年甲那堪数，祭酒诗神合少苏。\n来岁黄堂当此夕，不知能解寄诗无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37833,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和刘建昌都下立春","author":"姜特立","text":"岧峣天阙五云飞，日上觚棱晓影移。\n合殿侍臣颁綵树，谁家纤手送青丝。\n寒禁粉蕊香犹浅，煖入陈根绿尚迟。\n从此江山春意动，使君拚费几多诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37834,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和巩教授趋朝","author":"姜特立","text":"昨梦中宵拾夜光，晓惊新句堕书旁。\n英游只合陪青琐，伟论何须列皂囊。\n溪上林峦新紫翠，船头橙橘半青黄。\n兹行好语须频寄，只恐空疏窘报章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37835,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和张时可","author":"姜特立","text":"一榻萧然文字林，闭门十日卧春阴。\n园林寒重莺声寂，风雨时长草色深。\n坐念治聋违社酒，遥知搜句搅春心。\n莫愁雁鹜分行进，簿领难埋旷士襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37836,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和李崧卿九日","author":"姜特立","text":"重阳无菊闷书空，心似渊明兴不同。\n聊且携壶上东岭，不妨攲帽对西风。\n百年尽付无何外，三径谁如阿堵中。\n十月黄花方烂熳，莫辞联骑访山翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37837,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和杨诚斋题梅山诗卷 其一","author":"姜特立","text":"洋洋海内服诗声，手决云章万象明。\n千仞览辉丹穴凤，三春刷羽上林莺。\n蒉桴土鼓有遗韵，牛鬼蛇神无遁情。\n才大渺瀰如碧海，蹄涔那敢斗澄泓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37838,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和陆郎中","author":"姜特立","text":"午庭风雨撼高槐，一洗城头十丈埃。\n老子坐间寻句去，故人门外寄诗来。\n劲锋久服穿杨妙，钝思深惭击钵催。\n请佩左符君未可，要听吟思发春雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37839,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和陆郎中放翁韵","author":"姜特立","text":"遥知三径长荒苔，解组东归亦快哉。\n津岸纷纷群吏去，船头衮衮好山来。\n平时佳客应相过，胜日清尊想屡开。\n若许诗篇数还往，直须共挽古风回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37840,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和叔豹咏家园","author":"姜特立","text":"小园缭绕瞰沧湾，搜抉天藏不放閒。\n愧我笔端无锦绣，羡君胸次有江山。\n规模未出经营外，物象先归赋咏间。\n何日携筇来共醉，每于胜处一开颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37841,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和赵太中觅诗","author":"姜特立","text":"每叹学诗如学仙，未能换骨谩成篇。\n翰林万丈光常在，著作三都赋蚤传。\n半世无成负便腹，终年有味耸吟肩。\n明珠何事轻弹雀，多谢高情未弃捐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37842,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和赵釴夫见惠","author":"姜特立","text":"归来揩眼望南明，山水光中慰此行。\n不把篇章供世好，肯将姓字占时名。\n才疏我合回三舍，语妙君能敌七兵。\n自此定交非造次，许陪诗社莫寒盟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37843,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和唐伯宪二首 其二","author":"姜特立","text":"卜邻初识面，把臂便论诗。\n摸索曹刘耦，凭陵汉魏时。\n新章专雅洁，古隶更清奇。\n若比江西派，无人说具茨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37844,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和唐伯宪二首 其一","author":"姜特立","text":"倦翼投深樾，惊鳞忆故川。\n渊明松有径，杨恽豆宜田。\n穷达安微分，行藏愧昔贤。\n此心谁尽了，达此固怡然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37845,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和雪诗","author":"姜特立","text":"怪见司寒着意浓，巧裁六出羡天工。\n乌翻树拂梨花月，鹭起沙平玉篆风。\n势合深连云渚北，光寒淡抹粉墙东。\n梁园赋就惊先手，末至相如敢擅雄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37846,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和黄正言劝农","author":"姜特立","text":"双溪溪上绿初匀，晓日曈眬霁景新。\n五马先声才出郭，九农和气已生春。\n教条颁布人心悦，父老醺酣德意亲。\n从此惰民俱力穑，会看优最上严宸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37847,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和曾少卿婺学建稽古阁三贤堂","author":"姜特立","text":"君侯敏手镇星城，杰阁巍堂指日成。\n经籍大恢新教化，英贤重振旧声名。\n势雄三洞双溪境，义动千秋万古情。\n一唯家传人共仰，盍将此道觉诸生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37848,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和答刘庆远","author":"姜特立","text":"夙昔何尝卑小官，已将富贵等閒看。\n科名不上韩公榜，事业难登汉将坛。\n念旧讵能忘里社，避喧终欲挂朝冠。\n故人不为吟招隐，更极吹嘘借羽翰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37849,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和答巩提干见贺浙东总戎","author":"姜特立","text":"黜陟何尝到耳边，旋栽花木学平泉。\n二年窃食祠官冷，一日颁恩宝篆鲜。\n阃寄暂居油幕副，朋从遥忆竹林贤。\n诗筒从此长来往，应有人编唱和篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37850,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和潘德久舍人见惠","author":"姜特立","text":"诗人拥节古来稀，郊岛诗穷彼一时。\n爱子篇章孤鹤唳，愧予门户两狼垂。\n遥知靖节閒栽菊，不见仪休愠拔葵。\n别去脩门莫嗟惋，时来如摘颔边髭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37851,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]