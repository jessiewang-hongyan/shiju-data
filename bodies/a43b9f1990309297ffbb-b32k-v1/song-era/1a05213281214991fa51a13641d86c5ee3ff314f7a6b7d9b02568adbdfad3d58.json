[{"title":"礼部尚书洪公挽歌词 其二","author":"葛立方","text":"守节冰天十五霜，归来飞语又炎方。\n正欣射雁还幽窖，旋复飞鸢堕瘴乡。\n位不当材仅喉舌，寿难酬德遽膏肓。\n八龙共侈荀门庆，虽厄龙蛇殆不亡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3918,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"礼部尚书洪公挽歌词 其一","author":"葛立方","text":"沙场握节仗时髦，说舌纵横小六韬。\n委质肯轻从晋鼓，摛文空见泣秦牢。\n冷山韵语名如斗，莲泺危言命若毛。\n岂料归朝才十稔，白杨声里寿原高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3919,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵仲平病间斋祠 其一","author":"葛立方","text":"居士弹一指，森罗万象皆。\n聊倾三昧酒，不奉八关斋。\n雨罢帘初捲，山迎闼自排。\n萧然忘世虑，心境两相谐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3920,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵仲平病间斋祠 其二","author":"葛立方","text":"病间百念屏，寒窗无与皆。\n吾公那窟室，学士且高斋。\n今日明粢彻，诘朝阊阖排。\n犹寻淡生话，泚笔当俳谐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3921,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵刘卿任饮散感秋之作二首 其二","author":"葛立方","text":"华堂不料著野客，菲屦底同章甫冠。\n鸥外翠光清醉眼，尊前爽气动危栏。\n霜沉紫荇玉奁阔，风脱丹林烟髺寒。\n百榼香醪消万斛，酒中跌宕赖君宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3922,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵刘卿任饮散感秋之作二首 其一","author":"葛立方","text":"云子登场赛鼓欢，村南村北尽黄冠。\n几声乾叶下碧甃，数尺瘦山浮画栏。\n水落野桥鱼网挂，月悬烟浦鹊枝寒。\n新秋愁绝他乡客，衣带年来如沈宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3923,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵伯父工部见庆尘忝之什","author":"葛立方","text":"江夏无双旧姓黄，末科容我出寒乡。\n人间学子垂垂老，天上丹枝恰恰芳。\n避地本安元结洞，拥书犹记赞公房。\n岂知今世持衡者，不听更筹听织芒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3924,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵陈元述见寄谢茶 其三","author":"葛立方","text":"青缕宜婴石穴神，姜盐藙橘岂容亲。\n汤鸣鼎甗飕飕响，末下刀圭瑟瑟尘。\n火里枪旗俱发妙，胸中梨枣不妨春。\n柳州佳句诚堪诵，涤虑还源更发真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3925,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵陈元述见寄谢茶 其二","author":"葛立方","text":"露窠那畏主林神，小摘筠篮手自亲。\n旋转注汤云作脚，缤纷出磨曲为尘。\n睡魔已战三竿日，诗社聊尝一信春。\n不把膏油涂首面，要须色里认天真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3926,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵陈元述见寄谢茶 其一","author":"葛立方","text":"年来直欲配茶神，石鼎山泉日日亲。\n竹里烹煎嗤左计，舌端绵味认前尘。\n书林坐搅枯肠读，酒所浑消玉颊春。\n曾饮日边甘露碗，沙溪难遣乱吾真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3927,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵陈廷藻户部西湖快目堂之集","author":"葛立方","text":"冰壶影里集朋从，三雅同倾共一中。\n相与文楸看飞雹，不须舞袖觅惊鸿。\n云边鸟道古来寺，烟际渔舟何处翁。\n竟日追欢难卜夜，只缘身在省墙东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3928,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵林梅卿吏部游湖","author":"葛立方","text":"竟日关心朱墨间，西湖好在且偷闲。\n光凌万顷摇银海，兴惬千钟倒玉山。\n未办綵毫书侧理，只愁赤壁下乌蛮。\n客儿忽堕池塘句，格律都高汉以还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3929,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵程天游叙旧","author":"葛立方","text":"太学齑盐怆语离，半周甲子定何之。\n霜空过雁我宴坐，云路看鸿君赋诗。\n鄙吝政忧陈仲举，谈谐喜值庾元规。\n东邻更有程居士，鼎足论文妙一时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3930,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵道祖书怀","author":"葛立方","text":"白云深处缚柴荆，一壑湾环似有情。\n志气萧娘并吕姥，年华张丈与殷兄。\n浊贤清圣时同酌，上尾平头得共评。\n莫问鹤翎由啄抱，此心久与白鸥盟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3931,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江阴新阡松柏为大浸所坏累夕见于梦寐","author":"葛立方","text":"新阡松槚已交柯，狂潦侵凌一尺过。\n拟欲移根易嘉本，正须救土捍层波。\n伤心半夜飞蝴蝶，触眼何人是橐驼。\n火迫归欤亲在视，定教枯蘖再婆娑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3932,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观插秧","author":"葛立方","text":"秧把束西畦，东畦翠罽齐。\n甘心鹤俛啄，不用马行泥。\n井井塍千曲，泱泱水半犁。\n黄云它日事，欢喜舞龆齯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3933,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过九坡","author":"葛立方","text":"行尽千山与万山，钟情偏在此烟岚。\n海波神阙今饶六，仙女巫峰尚欠三。\n雨润蒙条生翠滴，云封叠颖瑩脂涵。\n却思九坂修梁第，空使斯民命不堪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3934,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寿昌道中壁间有乌石寺诗和其韵","author":"葛立方","text":"钟情翠巘倚崚嶒，付与芒鞋与瘦藤。\n君赐一麾方作吏，天融万壑却输僧。\n拟将矩矱追廉杜，未许机锋嗣秀能。\n投帻它年应未晚，与君曲室话三乘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3935,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"张千里以诗送邰侄铨试用其韵","author":"葛立方","text":"明堂一柱已扶颠，下诏犹求梠与椽。\n言并玉卮宜阁笔，鉴同金镜正持铨。\n骊珠鱼目难齐价，嫫母西施孰是妍。\n勉矣一鸣惊众彦，莫将栀蜡误长鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3936,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"连日灌畦莳菜废作诗","author":"葛立方","text":"莫问新来额插犀，了无魂梦到金闺。\n平头上尾慵搜句，重后轻前且灌畦。\n正自无人尝鼎脔，不如有客办萍齑。\n庾郎三九同刍豢，野荠从教施五溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3937,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"具上人以诗相别复和之","author":"葛立方","text":"钵囊已解何山夏，千顷堂前又饱参。\n仙里未须求七七，禅中聊共说三三。\n远师今日宜同社，弥勒它年可共龛。\n不见生公讲经处，至今花雨落毵毵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3938,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"周元举侍郎梅花次韵三首 其三","author":"葛立方","text":"怪底穷冬凛冽天，一枝香艳媚尊前。\n未应黑帝专司杀，谁道青阳独斡权。\n冷伴素蟾斜弄影，轻飞么凤欲相先。\n坐中人是王夷甫，幽韵清标两斗鲜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3939,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"周元举侍郎梅花次韵三首 其二","author":"葛立方","text":"山村疑有散花天，五出琼瑶忽满前。\n闺女传香得韩寿，宫娥濡蜡照公权。\n赏心共付尊中美，索笑谁为席上先。\n它日成阴子如豆，不堪对酒割芳鲜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3940,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"周元举侍郎梅花次韵三首 其一","author":"葛立方","text":"不随群卉艳阳天，几树孤芳玉涧前。\n陆凯何妨饷范晔，绿华端合伴羊权。\n忧虞莫问兵戈满，赏玩要须酒盏先。\n虽是广平心似铁，也应作赋咏蕃鲜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3941,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"周元举待制挽歌词 其一","author":"葛立方","text":"平生器业负经纶，谁谓公才不秉钧。\n谠论十年持紫橐，仁声三郡驾朱轮。\n龟文岂是背无甲，驹隙俄惊岁在辰。\n宅夹清漳亲义重，佳城引脰涕沾巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3942,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"周元举待制挽歌词 其二","author":"葛立方","text":"手开榛棘启云扃，淳古胸怀到大庭。\n坐脱老庞那问日，自铭小杜不占星。\n牛头吉兆空形梦，马鬣新封遽妥灵。\n謦欬从今成永诀，欲瞻遗像只丹青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3943,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和道祖韵","author":"葛立方","text":"未落天狼未止戈，谁能频击唾壶歌。\n弈棋聊欲消忧耳，饮酒无如作病何。\n孙绍那忧卿太少，退之莫叹日无多。\n菟裘已向菁山卜，从此栖迟到发皤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3944,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和新城旅店壁间韵","author":"葛立方","text":"我本臞山泽，冠裳绊此身。\n平生只黄卷，晚岁误朱轮。\n妓舞山禽怪，驺呼叠颖嗔。\n会当还此笏，不愧葛天民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3945,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"奉祠太一","author":"葛立方","text":"鼕鼕鼛鼓不勤民，幻出琳宫远世尘。\n风咽呗声金殿邃，日移幡影石坛新。\n云軿摇曳来三境，雾帐凄迷妥十神。\n堪笑茂陵成左计，虚将枣脯候秋春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3946,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"所居二室号书痴禅悦各成一诗 书痴","author":"葛立方","text":"枕溪曲室巧涵虚，黄卷旁罗恣卷舒。\n单族未应惭四姓，寸阴端合竞三馀。\n麟毛不具羞文虎，狸骨空传尚墨猪。\n坐穴藜床逢掖事，那知新有鹤头书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3947,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"所居二室号书痴禅悦各成一诗 禅悦","author":"葛立方","text":"多生业果种情田，鹫岭宗风好著鞭。\n要使野狐惊铁杖，莫令黄叶认金钱。\n传衣虽落慧能后，成佛应居灵运前。\n趺坐蒲团成冷淡，比从人役竟谁贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3948,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"直孺叔用韵见赠再和为谢","author":"葛立方","text":"异时黉舍共翻书，黄卷相从乐有馀。\n十载乖离驰别梦，半生漂荡失吾庐。\n饮江偶脱胡人马，并海欣逢长者车。\n软语蝉联相劳苦，羁游无绪领勤渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3949,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"金灯花","author":"葛立方","text":"小圃金灯满意芳，苞舒绛彩照煌煌。\n珠玑小滴今朝雨，缟纻难禁昨夜霜。\n拂秉麟须蛾欲避，枝衔螭口蜡犹香。\n列钱都是银缸影，莫遣狂风出土囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3950,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"响应山","author":"葛立方","text":"一派寒滩度白云，几重危磴远红尘。\n奇礓烟合松筠古，绀殿香浮栋宇新。\n玉响碧潭鸣地籁，瀑垂苍岭挂天绅。\n潜虬未用升云去，乞取晴天畀散人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3951,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫庠旅泊","author":"葛立方","text":"客里绝经营，清心摧五兵。\n功名两蜗角，田舍一牛鸣。\n行止成阿唯，荣枯略弟兄。\n欲摅今日意，聊仗五言城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3952,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"将至玉山","author":"葛立方","text":"蓐食转前峰，梅黄细雨中。\n涛翻疑鹭翿，泉激认松风。\n山合秧畦窄，林深屐路通。\n怪来人语别，一置便江东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3953,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日野饮","author":"葛立方","text":"十载干戈仅脱身，残年重作太平民。\n杯铛有趣于中好，花柳无情分外春。\n不远上元新甲子，肯将短笔怨庚寅。\n从教蕙帐惊猿鹤，却欲重弹冠上尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3954,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"洪庆善郎中挽诗四首 其四","author":"葛立方","text":"阉茂之年拜伏犀，鸡豚同社记金溪。\n情深缟纻论交契，义切蓬麻荷品题。\n花底醉春同挈榼，云中历妙共扶藜。\n岂知生死今殊路，抆泪佳城意惨悽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3955,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"洪庆善郎中挽诗四首 其二","author":"葛立方","text":"笔下翻翻注九河，腹中空洞五车多。\n麟经旨妙传洙泗，骚学词明慰汨罗。\n六度有为超梵业，一心无累證禅那。\n龙蛇岁恶贤人逝，心折风前薤露歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3956,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"洪庆善郎中挽诗四首 其一","author":"葛立方","text":"登名蟾窟值休辰，中外掀腾宠数频。\n锦帐握兰荣帝所，绣衣持斧耀江滨。\n两州民社施张在，四水门墙卜筑新。\n岂料生还杳无日，冢边唯卧石麒麟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3957,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"胡枢横山堂 其一","author":"葛立方","text":"郁葱佳气龟食墨，雾閤云窗丹雘新。\n玉碗金杯有微玷，瑶林琼树无纤尘。\n枕溪饱度国山日，横海小乖朐水春。\n上古乾坤随处有，素琴浊酒且关身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3958,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"胡枢横山堂 其五","author":"葛立方","text":"天然平远染百幅，泚笔底须东绢传。\n窗户吐吞新日月，风烟出没旧山川。\n白公筑室地三一，杨子草玄文五千。\n筋力尚堪驱使在，异时重泛白蘋船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3959,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送李元孟赴湖南漕属","author":"葛立方","text":"君忽湘潭去，斜阳催马衔。\n将无冲白发，正坐此青衫。\n暑雨驱鱼婢，薰风入鲎帆。\n南来衡岳雁，引领望书函。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3960,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"旅次二首 其二","author":"葛立方","text":"视印宜春一月过，宁知平地起风波。\n未成黔突真如传，俄复脂车去似梭。\n虽快徵君还北牖，却思太守类南柯。\n流行坎止何须问，似觉闲中所得多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3961,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"旅次二首 其一","author":"葛立方","text":"山行确荦趁云程，食寝无多但有名。\n作梦方成鸡唤起，加餐未竟马催行。\n鼓风飞壒浑无际，敲日吹炎似有声。\n埃息火流知不晚，依然六幕自澄清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3962,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"桐庐牛岭","author":"葛立方","text":"舆曳入崔嵬，连天雾不开。\n惊波掀过雨，细路滑苍苔。\n瞰下忧鱼葬，凌高被鸟猜。\n垂堂千古戒，底急为名来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3963,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"盐仓作呈叔能同官","author":"葛立方","text":"平生懒作子公书，俛首铨曹一纪馀。\n第有神驰招隐馆，久无梦到承明庐。\n文字真宜覆酱瓿，技能只合服盐车。\n清才弗悟亦尘役，早晚促君登石渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3964,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"致政宣义王公挽歌辞","author":"葛立方","text":"平生志趣漫无求，蠖屈乡关七十秋。\n不把楞伽堆案上，每将周易置床头。\n天庭纶告荣初命，子舍安车互两州。\n云水俄惊遗宝剑，幽扉欲启涕横流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3965,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"崔申之以诗为别苏明父郭逢叔各有和章谨复用韵二首 其二","author":"葛立方","text":"见远亭边送落晖，菁山挽我作睽违。\n连年走俗为贫仕，一日投闲恐富归。\n谷水为官轻似纸，苕溪转棹疾于飞。\n羽觞捧剑无人问，怅望如今束广微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3966,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"崔申之以诗为别苏明父郭逢叔各有和章谨复用韵二首 其一","author":"葛立方","text":"露章沥血上彤墀，蝼蚁虽微愿弗违。\n韫迹正惭高士传，离群却恐小人归。\n身同玄豹雾中隐，目送孤鸿天际飞。\n丹灶素书今好在，临风忆子话精微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3967,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"接伴贺天申节北使至阙","author":"葛立方","text":"流虹寿节庆升平，嵩岳遥呼万岁声。\n毳幕奉琛充日阙，綵船卷旆息云程。\n九天镐宴欢鱼藻，重译宾筵咏鹿苹。\n闻有芝泥还饯客，淮山佳处拟班荆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3968,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"章氏园小集荷池上 其二","author":"葛立方","text":"钳釱困残暑，杯铛方兴浓。\n歌舞趁晨版，欢呼从暮钟。\n风声回立鹊，云影堕奇峰。\n行酒有佳丽，未须烦八龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3969,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"章氏园小集荷池上 其一","author":"葛立方","text":"一金营雅集，荷湿露香浓。\n鸟起惊歌扇，云移落酒钟。\n碧筒弯象鼻，翠釜出驼峰。\n百岁风狂似，无因系六龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3970,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"喜子邲登第","author":"葛立方","text":"吾家五世十三人，竞撷丹枝撼月轮。\n庆历贤科开后裔，隆兴儒业继前尘。\n泥金帖报家庭喜，烧尾筵张帝里春。\n从此传芳应未艾，桂香应已袭天伦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3971,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"喜侄郯登第","author":"葛立方","text":"飞铃走帜到金溪，喜子文闱预品题。\n名字巍峨光蕊榜，词章斐亹动文奎。\n阶梯已合婴儿梦，星斗先分天老题。\n后日胪传当第一，天伦科甲尚为低。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3972,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"朝隐病疟作谴疟鬼文而差示佳句次韵","author":"葛立方","text":"浃旬移病卧荒村，冰炭交攻水帝魂。\n句咏髑髅诗老在，舌飞霹雳诅师存。\n徙居何事四方馆，谴鬼宜归白石门。\n壮士高人今药喜，鲜妆隙地不须论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3973,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"疏慵","author":"葛立方","text":"闲处著疏慵，鲜鲜幽桂丛。\n读书聊灶北，避世且墙东。\n市骏卑苏代，求徵谢子公。\n丹心阻阊阖，欲付小心风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3974,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"筑室以乏金小辍","author":"葛立方","text":"萍踪留异县，小隐卜清苕。\n囊罄欲质史，官卑难贳貂。\n挥斤停匠手，伐木断江潮。\n未有王司马，携钱过野桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3975,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"携家避地 其二","author":"葛立方","text":"生身恨晼晚，丧乱适吾遭。\n百岁大槐过，三年空谷逃。\n平羌无上策，医国付群豪。\n年大伤蓬转，愁城破浊醪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3976,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"携家避地 其一","author":"葛立方","text":"菟裘真可老，飘寓失初心。\n去去家山远，行行泽国深。\n光阴三翼过，情绪二毛侵。\n何日干戈定，鸥盟得再寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3977,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新城道中","author":"葛立方","text":"已去日边远，宜春程尚赊。\n呼童秣征马，带月趁啼鸦。\n桥断复揭水，路穷还渡沙。\n谁能饰厨传，裹饭野人家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3978,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蒙才孺伯惠诗颇及参问","author":"葛立方","text":"鹤氅蒲团养粹和，冥心十地六波罗。\n宦情微似庵摩勒，佛行高于窣堵波。\n海里泥牛端解笑，庵前石镜不须磨。\n拟询一句合头语，只恐新罗鹞子过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3979,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠褚明远","author":"葛立方","text":"今岁难衣食，知闻莫若君。\n衣裳颠紫凤，陇亩槁黄云。\n主馈妇求去，承家子出分。\n清才岂长窭，奇相有龟文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3980,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"避地复归故乡","author":"葛立方","text":"二老堂边花作林，不愁酒竭贳貂金。\n宗人避世散还聚，才子哦诗绝复寻。\n莫话衣冠一酸鼻，回思戎虏几寒心。\n半墩仙隐吾庐在，人认桃源鸡犬音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3981,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]