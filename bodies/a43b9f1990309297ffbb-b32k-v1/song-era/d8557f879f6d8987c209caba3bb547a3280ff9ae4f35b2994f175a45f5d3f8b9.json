[{"title":"寄题吕得中先坟怀先亭","author":"郭祥正","text":"亭压全闽近冢丘，四时营祀想神游。\n毫添玉兔新成史，德合银潢不尽流。\n翼翼栋梁横蜃泽，林林松槚冒霜秋。\n荣名已往馀阴骘，定有儿孙万户侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48204,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄致政苏子平大夫","author":"郭祥正","text":"十年想见苏夫子，闻说腰金便弃官。\n云在皖山峰上住，龙归潜水窟中蟠。\n已无俗坌心休洗，更有春醪盏不乾。\n我亦江南专一壑，忆君相伴把渔竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48205,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送叶圣参守九江郡","author":"郭祥正","text":"湓浦夜涛声动地，香炉晴影碧连天。\n楼中不负庾公赏，席上谁为陶令贤。\n且拥旌旗飞画鹢，行闻台阁选青钱。\n班春过我旧游处，门巷桃花应寂然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48206,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送琳长老再游浙东","author":"郭祥正","text":"姑溪不是留君地，雪窦天台更一游。\n玉浪溅云泉尾活，金盘擎海月华秋。\n将心与客无痕迹，问疾何人敢对酬。\n我把钓竿相忆处，蓼花红影上丝头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48207,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"姜希哲四照轩送别","author":"郭祥正","text":"幽轩邀客每凭栏，景物萧然世味閒。\n翠碧湿烟山匼匝，光明随夜月回环。\n一杯浊酒超尘外，几首新诗寄壁间。\n不得从容与君语，片帆却欲趁风还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48208,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"胡与几被召访别","author":"郭祥正","text":"已喜乘轺归玉阙，尚能骑马过柴门。\n离魂有底销千丈，残日无多寄一樽。\n得路看君终直节，闭关唯我守空言。\n霜风素发频攲帽，泪对桓伊不可扪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48209,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再游浮山呈璞禅老","author":"郭祥正","text":"当年寻胜已忘还，乘兴重来倍觉閒。\n赤脚敬瞻新宝藏，白髯羞对旧青山。\n禅翁昔授岭头衲，狂客今探树穴环。\n行把生涯付妻子，幻身长寄一岩间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48210,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题潘温叟林堂","author":"郭祥正","text":"有堂归去容身好，天上人间已遍游。\n远害果能超华左，忘情却欲继雷刘。\n松台风送晴空雨，荷沼云生画卷秋。\n浩气本来缘直养，百年等是寄浮沤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48211,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和倪敦复观梅三首 其一","author":"郭祥正","text":"闻说观梅借烛光，今宵为我更开觞。\n月来枝上冰生艳，风过梢头玉有香。\n羌笛几声传旧曲，菱花一夜照繁妆。\n坐中老杜凌何逊，索酒题诗思欲狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48212,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和倪敦复观梅三首 其二","author":"郭祥正","text":"江月江梅斗冷光，就梅临月举瑶觞。\n素娥未许风摇影，青帝宁容蝶采香。\n迢递一声羌笛怨，轻盈千点玉人妆。\n出尘标格情多少，东阁曾令杜甫狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48213,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和倪敦复观梅三首 其三","author":"郭祥正","text":"月压江梅似雪光，史君要我共飞觞。\n不饶桂树轮中影，独占霜娥鉴里香。\n信报春来先众卉，恨随人去入残妆。\n孔融爱客君能似，席上应容处士狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48214,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又同赏落梅二首 其一","author":"郭祥正","text":"江梅千片惜离披，更向风前把一卮。\n冷艳不辞今日舞，清香还是隔年期。\n客经易水忘归处，云倚巫山欲散时。\n安得不吟仍不饮，满头华发拟何为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48215,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又同赏落梅二首 其二","author":"郭祥正","text":"谁惜东园玉树空，且携樽酒与君同。\n盈盈素艳辞寒萼，浥浥馀香散晓风。\n已许冰霜分我瑩，尽饶桃杏向人红。\n能诗自有倪夫子，何必滁阳觅醉翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48216,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题方处士卷尾","author":"郭祥正","text":"子陵独往已千年，处士重来把一竿。\n治乱不同非我计，文章聊许后人看。\n璞中美玉谁雕琢，潭底神龙会屈盘。\n七世有孙方遇主，风流长在泻惊湍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48217,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题谢氏双溪阁","author":"郭祥正","text":"谢家山下双溪阁，水远山深夏亦凉。\n霜练两条初合影，菱花一鉴泻馀光。\n樽罍日日邀宾客，仓廪年年富稻粱。\n更约诸孙勤问学，桂科将见绿衣郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48218,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重阳怀历阳孙公素太守","author":"郭祥正","text":"重阳应与客登临，隔水无缘预盍簪。\n浊瓮拨醅初泛蚁，佳人纤手斗挼金。\n南来纵有鸡山赏，北望频兴魏阙心。\n安得快风吹我去，勇提椽笔伴君吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48219,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"公素送酒见及复次前韵和答","author":"郭祥正","text":"掺别城东秋未深，相思白发已盈簪。\n远分酒味须颓玉，正是秋香欲散金。\n润泽生民公有志，浮沈末路我无心。\n扁舟明发穿南斗，聊学沧浪渔父吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48220,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送贾明叔侍御守宣","author":"郭祥正","text":"直节忠言久不闻，堂堂今见贾生孙。\n老奸去位朝廷正，圣母怜才德业尊。\n句水晓光尘不染，敬山秋色玉无痕。\n北楼把酒频邀客，紫诏传呼下国门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48221,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵昭掾徐子美见寄二首 其一","author":"郭祥正","text":"居巷虽穷愧彼颜，门无车马任苔斑。\n冰将合沼光容净，鸟不窥鱼意思闲。\n踪迹疏来唯梦往，音邮漫去得诗还。\n浮生七十今六十，早晚归飞寻旧山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48222,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵昭掾徐子美见寄二首 其二","author":"郭祥正","text":"侵侵白发改朱颜，不比当年鬓始斑。\n五斗可怜须苟禄，一岩犹喜早偷閒。\n黄花篱下千枝秀，紫雁云中几度还。\n万里未归归便得，昭州何似谢家山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48223,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题金陵白鹭亭呈府公安中尚书二首 其一","author":"郭祥正","text":"青城突兀与云连，谁作高亭落日边。\n六代衣冠归寂寞，一番罗绮自华鲜。\n低徊斗柄斟秋水，飞舞芦花欲雪天。\n直上烟霄无尺五，欲要王母对宾筵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48224,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题金陵白鹭亭呈府公安中尚书二首 其二","author":"郭祥正","text":"西望长安路几千，此亭更在赏心边。\n黄芦正耐风霜老，白鹭相将羽翼鲜。\n城竦鳌身山匝地，舟排笋柱水连天。\n龙吟一曲斜阳下，况是史君开别筵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48225,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵安中尚书钟阜轩","author":"郭祥正","text":"钟山鳞鬣奋晴雷，观里幽轩选胜开。\n江水北流朝海去，斗杓东转斡春回。\n已将白雪传龙笛，何用黄金筑隗台。\n宝塔中天挂刀尺，层层鸳瓦不浮灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48226,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送钱朝请还台","author":"郭祥正","text":"铨选相逢弱冠前，竹符分得各皤然。\n开樽且喜君尤健，问舍应输我最先。\n北上有心思报国，南来无物载归船。\n冰清世泽源流大，须享人间五福全。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48227,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"芜阴北寺桧轩","author":"郭祥正","text":"青幢碧盖俨天成，湿翠濛濛滴画楹。\n禅客自陪千岁老，游人时把一樽倾。\n耻随桃李春风短，夺尽松篁夜气清。\n安得鬼仙提巨笔，不容左纽独传名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48228,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"明叔致酒叠嶂楼","author":"郭祥正","text":"陵阳峰顶敞栏干，三伏登临冰骨寒。\n山卷宿云开紫府，水和明月泻金湍。\n谢公风味君能似，李白篇章我到难。\n幸有玉船腾酒浪，欲乘醉兴效鹏抟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48229,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵邹几圣舟次芜江见寄","author":"郭祥正","text":"东风冉冉送年华，末路浮沈岂足嗟。\n身着朱衣行直道，手披黄卷悟空花。\n世尘扰扰原无实，客宦悠悠役有涯。\n尚喜甘棠遗爱在，画船先许过渔家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48230,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题历阳王纯甫新作连云观二首 其一","author":"郭祥正","text":"久持使节别尧天，故起朱楼北斗边。\n势压江淮盘地厚，影分吴楚与云连。\n一声奏笛龙蛇晓，八法书牌剑戟悬。\n更借湓城庾家月，芟除桂树照樽前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48231,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题历阳王纯甫新作连云观二首 其二","author":"郭祥正","text":"闻道连云绝世无，急飞轻棹看规模。\n帘钩低挂半轮月，江岸平分千里图。\n飐飐金船流玉液，森森珠履踏冰壶。\n高材自是明堂柱，试作斯楼雄楚都。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48232,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送黄奉议知白州前宰清远","author":"郭祥正","text":"看君新作海边楼，气象雄兼四五州。\n把笔共题红粉壁，开樽仍泛玉蟾秋。\n喜分符竹行千里，莫羡渔蓑退一丘。\n此别定为生死隔，雪霜沾尽暮年头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48233,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵朱世昌察院登钟山","author":"郭祥正","text":"盘龙首尾压西东，宝塔棱层位正中。\n万古林泉流王气，六朝冠盖入悲风。\n烟生城郭尘昏尽，月满沙汀雪映空。\n回首临川埋骨处，后来经纬付诸公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48234,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵答光守杨公济见寄","author":"郭祥正","text":"一别成都扬子云，梦魂飞断每沾巾。\n金门赋奏龙蛇晓，原庙诗成锦绣春。\n顾我漫为长醉客，非君谁是广骚人。\n荣分符竹归无路，盛送佳篇慰病身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48235,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"病中先寄慎宰阎公达承议","author":"郭祥正","text":"松槚相望孰俊名，高才暂屈浚遒城。\n公庭寂寂无留讼，四野熙熙有让耕。\n未作盐梅调鼎鼐，且铿金玉直蓬瀛。\n病骸尚阻趋东阁，怀抱思君为一倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48236,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陪朱行中龙图饮澄惠院二首 其一","author":"郭祥正","text":"寒烟淡日满沧洲，台榭相通一径幽。\n志欲吞吴嗟隔水，力能成魏密藏舟。\n纸窗趁晓开黄卷，蒲叶涵春付白鸥。\n千载废兴何可问，一樽浊酒更迟留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48237,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陪朱行中龙图饮澄惠院二首 其二","author":"郭祥正","text":"岛屿回环水绕堤，碧芦青荇密相依。\n凌风战舰知何处，落日游人尚未归。\n细细佛香时入坐，双双沙鸟静忘机。\n史君自是蓬莱客，倚遍栏干恋翠微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48238,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再见吴渊卿长官时年八十一","author":"郭祥正","text":"十七年前载酒过，重来携手喜如何。\n寿齐八十君方健，思及妻儿我已多。\n对槛残花犹可赏，隔帘小妓且频歌。\n人间事了无忧患，头上光阴任掷梭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48239,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渊卿席上和李天贶四韵时与钟离中散并予共四人","author":"郭祥正","text":"悠悠岁月走惊湍，四十三时便弃官。\n座上得陪诸老醉，樽前须尽一生欢。\n花含馀恨春将去，棋算成功局未残。\n欲向金城传盛事，新诗聊代画图看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48240,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵行中龙图游后浦六首 其一","author":"郭祥正","text":"密竹疏松斗老苍，惊飞白鸟不成双。\n楼船飘忽随朝电，佛炬青荧彻夜窗。\n携酒且来寻岛屿，投竿那用忆湖江。\n君看雨过铺晴练，得句须令小谢降。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48241,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵行中龙图游后浦六首 其二","author":"郭祥正","text":"每欲收吴势未任，绕城凿浦迹堪寻。\n不知战罢楼船散，空见春归荇菜深。\n一坐清风吹往事，四筵白酒洗烦襟。\n公提椽笔诗无敌，未必张辽善醉吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48242,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵行中龙图游后浦六首 其三","author":"郭祥正","text":"细柳高松绿映苍，深沉台榭晚生凉。\n沙边宿鹭昏昏白，草际流萤点点光。\n投网舟移牵碧荇，采莲人去湿红裳。\n欲追逸调嗟何及，雨入杯盘归兴忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48243,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵行中龙图游后浦六首 其四","author":"郭祥正","text":"巨镇还须济世才，要宾览古笑谈开。\n蜀山迥出千螺秀，肥水长萦一带回。\n犹有金城藏后浦，不唯铜雀起高台。\n异时争战归何处，秋雁年年去复来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48244,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵行中龙图游后浦六首 其五","author":"郭祥正","text":"锦棹飞飞画舫迎，焚香夹道看双旌。\n佳宾谈笑民同乐，善政循良鸟不惊。\n花岛可怜春自舞，柳洲遥觉月微明。\n史君一饮诗千句，掷地浑如金玉声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48245,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵行中龙图游后浦六首 其六","author":"郭祥正","text":"冠带淮西第一州，扬鞭得从史君游。\n木鱼声断东台晓，水荇香传后浦秋。\n双脊自磨铜雀瓦，密云时泛建溪瓯。\n才清思健知无敌，且与衰残作荫庥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48246,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵行中龙图思宣城","author":"郭祥正","text":"公爱宣城心不休，当年应梦似崔侯。\n两条溪水横穿市，十里昭山半在州。\n小杜一时誇俊逸，玄晖千载擅风流。\n青毡旧物虽勤请，金马新恩定再留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48247,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题玉笥观兼简道正求逐马草草名逐马谓服之久则可以行逐良马","author":"郭祥正","text":"仙梁飞去有遗坛，融结工夫玉未乾。\n一片碧烟鸾舞破，数枝红蕊鹿衔残。\n雨经梅涧芝田熟，路入萧家月屋寒。\n晚景自怜行六十，欲求逐马问黄冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48248,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"端门肆赦","author":"郭祥正","text":"蔼蔼端门紫气浓，卷帘兰麝散和风。\n星环帝座天澄碧，伞映龙颜日透红。\n宝扇参差移仗里，金鸡绰约下云中。\n恩覃草木先春力，万岁欢声阖国同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48249,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王平甫下第南归","author":"郭祥正","text":"一番黄纸集群材，南国儒英起草莱。\n至宝不逢知己鉴，束书重见下天来。\n壮心肯向明时屈，孤愤须临浊酒开。\n许有新诗令我听，夜堂还使鬼神哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48250,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠历溪张居士","author":"郭祥正","text":"七十人稀九十翁，数椽寒屋历溪东。\n俯窥声利非吾事，自得逍遥与古同。\n三叠琴心调夜月，一杯茗酌送春风。\n趋庭有子明诗礼，善泽源源未可穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48251,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题濮阳氏新阁","author":"郭祥正","text":"宅据中洲四望宽，隔江山势舞青鸾。\n岧峣更起千寻阁，汗漫平吞万里湍。\n传业有儿须折桂，开樽留客共弹冠。\n霜消冰泮春将暖，魏阙遥瞻独倚栏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48252,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"代先书奉迎庐帅元舆待制","author":"郭祥正","text":"倦提椽笔厌承明，帝与兵符帅十城。\n箫鼓裂云迎五马，山川收雨引双旌。\n藏舟浦暖鱼频跃，教弩台空雁不惊。\n入境观风先可喜，秋田高下熟香粳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48253,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"许氏乐隐亭","author":"郭祥正","text":"曲水浮基竹绕檐，月华初度晚凉添。\n羽觞滟滟荷敷绿，象箸森森笋迸尖。\n白眼傲时饶阮籍，素琴调曲慕陶潜。\n城居乐隐能如此，中散风流友弟兼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48254,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重题严伯成秀才西斋喜其子高预乡荐","author":"郭祥正","text":"赋似相如不遇知，喜闻乡版荐麟儿。\n容身安稳书盈箧，与客翱翔酒满卮。\n夜月影摇杨柳径，秋风香散菊花篱。\n窦家千载传遗美，一树灵椿桂五枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48255,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"刘交侍禁书报王君安改官监怀州武德镇铎以诗喜之","author":"郭祥正","text":"自得刘郎音信通，遂闻增秩喜无穷。\n江东子弟谁怜我，洛下文章只有公。\n形影萧条千里外，交游零落百年中。\n何当老境重相遇，不话风流话苦空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48256,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪中招徐子美秘校饮二首 其一","author":"郭祥正","text":"冰澌合砚漫书空，密雪飘馀晓色通。\n万里云光同浩荡，四边山影隔溟濛。\n明明月窟迷惊兔，阵阵桑林叫朔风。\n不惜金龟将贳酒，欲招南郭苦寒翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48257,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪中招徐子美秘校饮二首 其二","author":"郭祥正","text":"霏霏皓雪翳长空，南郭缘何有径通。\n访戴船归清兴逸，姓袁人卧冷光濛。\n欲倾樽俎延高盖，忽得篇章迈古风。\n四十年前除夜乐，如今相对两衰翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48258,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"史君梁奉议送客至高明轩为予言登览之胜作四韵戏寄","author":"郭祥正","text":"史君送客陟高台，天宇澄清四望开。\n一字横空霜雁去，两眉分碧楚江来。\n庙堂孰是调羹手，郡国犹淹济世才。\n新酒正香鲈蟹美，篮舆何日许重陪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48259,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵徐子美见怀兼简汤君材","author":"郭祥正","text":"阔别天涯每怆然，相思只欲学飞仙。\n君承交辟专民事，我慕高风谢世缘。\n南郭不辞三径远，东山长与五云连。\n会须载酒勤相过，齿发萧条各暮年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48260,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"将至寿州先寄知府龙图三首 其一","author":"郭祥正","text":"感公招我欲论诗，故岁新年颇后期。\n冰塞大江舟渡晚，雪迷官道马行迟。\n深深画戟双开处，浅浅梅花半绽时。\n北阙除书应已到，愿陪祖帐捧琼卮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48261,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"将至寿州先寄知府龙图三首 其二","author":"郭祥正","text":"短帽轻衫信马蹄，只愁吟社爽襟期。\n晓回谷口禽声软，寒束梅梢春思迟。\n幸挹清标怜野逸，肯将孤愤累明时。\n听公高论何由尽，应比醍醐灌漏卮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48262,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"将至寿州先寄知府龙图三首 其三","author":"郭祥正","text":"采石江边寂寞归，寿阳重到信前期。\n闻韶忘味宁非美，倾盖论交已恨迟。\n白凤文章元出众，青云歧路合逢时。\n杏花正怯清明雨，强欲留连更一卮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48263,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"置酒寿阳楼呈主公龙图二首 其一","author":"郭祥正","text":"珠履缤纷宴寿阳，栏杆横出白云傍。\n清淮倒影长桥活，古垒无春峡石荒。\n小艇斗垂凹鼻钓，佳人犹学晓梅妆。\n史君笔力今谁敌，丽句须盈古锦囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48264,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"置酒寿阳楼呈主公龙图二首 其二","author":"郭祥正","text":"置酒南楼瞰夕阳，逶迤淮影转城傍。\n画残数幅山川旧，棋散一枰洲渚荒。\n细柳倚风相并舞，飞梅着地不成妆。\n坐中佳句谁先就，我欲窥公倒智囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48265,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]