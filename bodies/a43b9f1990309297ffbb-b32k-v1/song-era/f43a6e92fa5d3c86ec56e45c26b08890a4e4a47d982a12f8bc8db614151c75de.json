[{"title":"广野轩","author":"张之才","text":"城隅荒僻地，潇洒亦清虚。\n雅有林泉乐，閒同郊野居。\n小园春自好，幽径客来疏。\n不学樊迟稼，虞卿喜著书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49830,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠杜鼎升","author":"张及","text":"家本樊川老蜀都，世家冠剑岂寒儒。\n笔耕尚可储三载，酒战犹能敌百夫。\n僻爱舜琴湘水弄，每悬孙画醉仙图。\n孟光笑语长相逐，唤作梁鸿得也无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49831,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠黄孙二处士","author":"张及","text":"二公高节厌喧卑，同寄萧宫共展眉。\n玉树冰壶齐品格，野云皋鹤本追随。\n泉流指下何人赏，岳峭毫端祇自知。\n绻恋贤侯美风教，故山归去尚迟迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49832,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和白君","author":"张士瑰","text":"天下英雄只豫州，阿瞒不共戴天雠。\n山河割据三分国，宇宙威名丈八矛。\n江上祠堂严剑佩，人间刁斗见银钩。\n空馀诸葛秦川表，左袒何人复为刘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49833,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"云峰寺","author":"张士逊","text":"百越回辕度翠微，全家还憩白云扉。\n白云知我帝乡去，旋拂征鞍也要归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49834,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"忆越州 其一","author":"张士逊","text":"稽山岩壑深复高，思之谁妙丹青毫。\n霜缣若得一千幅，伻图何必乘兰舠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49835,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"忆越州 其二","author":"张士逊","text":"平湖八百里多奇，君曾纵赏无馀遗。\n不知风月谁为主，夷犹未必如当时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49836,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"官舍书事二首 其二","author":"张士逊","text":"官舍如僧舍，翛然万虑清。\n等闲无客到，容易有苔生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49837,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"官舍书事二首 其一","author":"张士逊","text":"一载涪江上，转添山野情。\n手携僧共出，笔放吏归耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49838,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"知邵武县祷雨大有感应任满作诗纪其事","author":"张士逊","text":"乞灵曾爇一炉烟，言下霶沱救旱田。\n今日解龟留数字，要教来者更恭虔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49839,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送柴大谏赴阙","author":"张士逊","text":"一万馀家留恋意，二三十里管弦声。\n惠加潼水流难尽，鞭指金门望转清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49840,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄唐山人","author":"张士逊","text":"梓潼江口涪江上，深僻还如樗杜村。\n独坐翠光喷钓艇，万家寒影落吟轩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49841,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚春游金明抵暮入宜秋门阍兵捧门牌请官位因书一阕","author":"张士逊","text":"闲游灵沼送春回，关吏何须苦见猜。\n八十衰翁无品秩，昔曾三到凤池来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49842,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答陈文惠","author":"张士逊","text":"八十光阴有二年，烟萝门户喜开关。\n近来无奈山内相，频寄书来许缀班。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49843,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题建宁县洛阳村寺","author":"张士逊","text":"金谷花时醉几场，旧游无日不思量。\n谁知万水千山里，枉被人言过洛阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49844,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"峡山寺","author":"张士逊","text":"峡寺一停桡，新秋暑乍消。\n幽怀徒易释，肥遁固难招。\n翠拟千峰活，红分数叶凋。\n优游虚岁月，何以报清朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49845,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送高学士知越","author":"张士逊","text":"著撰烦鸿笔，均劳利建侯。\n僧随天际棹，郡冠浙东州。\n山影四明接，溪声万壑流。\n谢家风月在，公外称冥搜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49846,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送僧归护国寺","author":"张士逊","text":"一言已了忘筌谊，诸祖休传坏色衣。\n只履远过葱岭去，片云高傍石桥归。\n海宫有请杯慵度，尘劫无涯锡倦飞。\n元帅香灯持百载，又从枢府发清辉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49847,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"麻姑山","author":"张士逊","text":"结友寻真重驻留，行行浑似近蓬邱。\n人擎绿玉简齐立，水带碧桃花乱流。\n松盖几层须自老，芝英三秀又谁收。\n坐中忽见红云起，疑是仙姑访旧游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49848,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"锡杖泉","author":"张士逊","text":"灵踪遗几载，卓锡在高岑。\n妙法归何地，清泉流至今。\n苔花生细细，云叶映沈沈。\n桂魄皎清夜，分明六祖心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49849,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雍熙中植桐于萧寺壬辰登科后告老来寺留题","author":"张士逊","text":"桐枝手植有桐孙，二纪重来愧此身。\n三匹衣鱼联贵仕，十洲轩冕接清尘。\n耕桑虽喜多新陇，耆艾堪嗟少故人。\n萧寺前题粉壁在，又书丁巳对壬辰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49850,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题西庵寺","author":"张士逊","text":"西庵深入西山里，算得当年少客游。\n密密石丛盘小径，涓涓云窦泻寒流。\n松皆有节谁青盖，僧尽无心也白头。\n欲刷粉牌书姓字，调卑官冗不堪留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49851,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄陈文惠","author":"张士逊","text":"赭案当年并命时，蒹葭衰飒倚琼枝。\n皇恩乞与桑榆老，鸿自高冥凤在池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49852,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题宝盖岩寺","author":"张士逊","text":"身为冠冕留，心是云泉客。\n每到云泉中，便拟忘归迹。\n况兹宝盖岩，天造清凉宅。\n税车官道边，谁知愿言适。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49853,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"张士逊","text":"李成谢世范宽死，唯有长安许道宁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49854,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其四","author":"张士逊","text":"藓壁留诗志何大，可怜太华老图南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49855,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其五","author":"张士逊","text":"人家飞鸟外，官舍翠屏中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49856,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"张士逊","text":"曾此焚香动圣容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49857,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诗一首","author":"张大亨","text":"方寸平田便有馀，子孙无复废耕锄。\n已将不死为嘉种，更向无何筑隐居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49858,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题三洞","author":"张大直","text":"雨过薰风吹面凉，芒鞋终日水云乡。\n可怜尘绪萦人久，赖有仙源引兴长。\n山鸟无心时自语，林花有意解留香。\n村醪不惜杖头费，渴似虹霓饮练光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49859,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题庆云东洞","author":"张大直","text":"个中别是一乾坤，蔼蔼祥云拥洞门。\n天柱遥知锁金阙，绛桥仍想接昆崙。\n仙人幻出珊瑚木，玉女妆成锦绣墩。\n石室霜台更奇绝，桃源从此不须论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49860,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题含虚南洞","author":"张大直","text":"云岭嵯峨挂夕阳，含虚南洞更徜徉。\n书堂犹觉宝薰在，石铫微闻仙茗香。\n遥想钓鱼台上客，飘然驾鹤白云乡。\n洪崖有路通仙岛，当日无人报始皇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49861,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题莲华西洞 其一","author":"张大直","text":"先生自是大罗仙，一去尘寰不记年。\n道室只今丹灶在，石窗依旧碧萝缠。\n空来莲洞闻仙乐，那得桃源驾铁船。\n欲觅当年天井路，云蒸雾罩水潺湲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49862,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题莲华西洞 其二","author":"张大直","text":"岩洞嵌空路险巘，神仙窟宅故应奇。\n涌云巧作莲幢仰，滴乳翻成石笋垂。\n琼树千年生异果，玉田四季产灵芝。\n真人隐壁君休问，驾鹤骖鸾自有时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49863,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵秦会之题墨梅二首 其一","author":"张子文","text":"南枝春色弄微温，记得清香扑酒尊。\n今日相逢隔烟雾，扬州残梦足销魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49864,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵何文缜墨梅二绝 其一","author":"张子文","text":"偃蹇江头卧夕阳，懒将玉雪斗春妍。\n心期老氏能知白，兴寄扬雄独守玄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49865,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵何文缜墨梅二绝 其二","author":"张子文","text":"仙衣云样拂轻缁，林下神情特地宜。\n妒妇津头风恐急，坏妆聊为变冰姿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49866,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"墨梅三绝 其三","author":"张子文","text":"逸少池边发兴新，管城别作一家春。\n临风玉笛无人会，鬒发空归想太真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49867,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"墨梅三绝 其二","author":"张子文","text":"忆昨江湖倒载归，暗香夹路雨霏微。\n谁人貌得春风景，远看如烟近却非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49868,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"墨梅三绝 其一","author":"张子文","text":"笔端唤醒玉梅魂，满袖春风不见痕。\n未许捲帘新月上，却教烟雨恼黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49869,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"白鸡冠花图","author":"张子龙","text":"鹿葱花尽凤仙空，一种奇葩色不同。\n似带冰霜归老笔，肯随篱落斗群雄。\n太平瑞映园林外，清白名归草木中。\n留向山窗伴幽独，半绡斜月五更风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49870,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"客居岭南","author":"张子龙","text":"天风吹白波，归客欲如何。\n炎国逢花早，春船载雨过。\n畏蛇焚瘿木，防蛊种衰荷。\n洞口商人妇，时时送夜歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49871,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"碧筒","author":"张子龙","text":"翠作浮洼玉作觞，连蜷浮动玉生香。\n手中风露分炎国，窍里乾坤入醉乡。\n满座争誇赛鹦鹉，可人曾忆盖鸳鸯。\n江长月白空痕在，一夜花神怨索郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49872,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"兴庆池禊宴","author":"张子定","text":"月标元巳乐嘉辰，兴庆烟波涨晓津。\n宴集幸联台衮坐，风流仍继禊堂春。\n兰亭事古成遗迹，华萼楼空委路尘。\n歌吹满船花夹岸，酒帘无处不留人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49873,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九日亭","author":"张子厚","text":"九日亭成气象高，宰君乘兴几回过。\n山怜峻极凌霄汉，路爱幽深入薜萝。\n长恐泛杯篱菊少，不愁落帽海风多。\n香醪正熟芳时节，对此年年奈醉何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49874,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送叠山先生北行","author":"张子惠","text":"打硬修行三十年，如今订验是儒仙。\n人皆屈膝甘为下，公独高声骂向前。\n此去好凭三寸舌，再来不值一文钱。\n到头毕竟全清节，留取芳名万古传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49875,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿梅仙坛","author":"张广汉","text":"夜宿梅坛境，山寒万籁空。\n无才供吏隐，有梦忆仙翁。\n石齿含残雪，松髯奋急风。\n灶烟如可舐，跨鹤问鸿濛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49876,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山行","author":"张弋","text":"偶作山行只杖藜，归逢寒日下山时。\n与僧并立看红树，忽有鹤来栖树枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49877,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"龙湾","author":"张弋","text":"画船椎鼓过龙湾，回首升州只见山。\n前日方来今又去，闲人元自不曾闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49878,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春晚","author":"张弋","text":"万事吾今飞絮轻，此身如燕又巢成。\n暗思庾信家边竹，绿箨新添有几茎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49879,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送人归南康","author":"张弋","text":"我来方与庐山别，你去庐山是故乡。\n前日住山浑不觉，如今山远却思量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49880,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄刘潜夫","author":"戴复古","text":"八斗文章用有馀，数车声誉满江湖。\n今年好献南郊赋，幕府文章有暇无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49881,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游智门寺 其一","author":"张弋","text":"一间瓦屋荒山里，山路萦回夕照明。\n祇有比丘头雪白，旋收经卷入相迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49882,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游智门寺 其二","author":"张弋","text":"传闻此地有龙飞，佛殿残砖刻凤螭。\n事去千年无问处，寂寥霜草卧苔碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49883,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"楚州","author":"张弋","text":"落帆停鼓鹳湖头，两度因循到楚州。\n柳下人家曾识面，笑求新句写妆楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49884,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"子山寺","author":"张弋","text":"迢递前朝寺，经过遂一游。\n白云鸦树晓，黄叶凤台秋。\n僧举开山话，人消在世愁。\n殿廊经劫火，已费十年修。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49885,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"广教寺","author":"张弋","text":"英雄居处终奇特，几度欲来今始能。\n骑省文高存古篆，桥公树朽长寒藤。\n清流并绕分三涧，翠竹相依住数僧。\n沙鸟讵知千载恨，日斜飞下立渔罾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49886,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元日","author":"张弋","text":"历以寅为正，风从艮位来。\n桃符当壁写，竹户趁钟开。\n宿雨滋初茁，长年老不材。\n满庭青柏叶，惆怅独持杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49887,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"东门野兴","author":"张弋","text":"偶尔行坰野，何曾载酒觞。\n草长难望远，树密易寻凉。\n月子闻吴唱，渔翁爱楚狂。\n还听路人说，□□□□□。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49888,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"汉东郡斋夕坐","author":"张弋","text":"庐山解夏洪山去，自到山边叶已飘。\n鸿雁影多怜塞近，交朋书少觉身遥。\n屡游骑惯将军马，不饮还封道士瓢。\n心忆清吟更岑寂，玉京谁与话寒宵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49889,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再送丕父","author":"张弋","text":"弟行兄出送，有约共凭栏。\n草木雨初过，江湖路转难。\n同怀年各长，重别酒无欢。\n明日双钟下，苍崖应独看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49890,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再送盛君之升州","author":"张弋","text":"君与余皆懒，余如君更贫。\n今年再同夏，两鬓独非春。\n去棹孤山浪，征衫西府尘。\n似闻仍用武，为算立功人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49891,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江楼饮客","author":"张弋","text":"邻家贳酒尊，斟酌共王孙。\n老菜羹迟熟，冻油灯屡昏。\n夜寒人罢市，坐久仆敲门。\n隔岸歌明月，月明江水浑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49892,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"李景文移居","author":"张弋","text":"能诗留幕府，借宅近南湖。\n吏去少公事，客来多钓徒。\n云为今夜雪，梅发去年株。\n我亦同州住，相过路不迂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49893,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舒州岁暮","author":"张弋","text":"穷冬日日爱天晴，古寺门开绝送迎。\n野鹤忽来桥上立，山僧独向水边行。\n过寒梅树白全少，入腊草牙青渐生。\n又是舒州一年了，怕看新历动乡情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49894,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"昼坐","author":"张弋","text":"出门无所往，独自坐胡床。\n雨濯残梅尽，风吹百草长。\n近边人喜战，偶病客传方。\n不奈春愁密，思君对酒觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49895,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送宋谦父之清江因简希亮","author":"张弋","text":"吟诗夕阳里，相送上潇滩。\n前路逢梅处，同谁倚棹看。\n岁穷风力紧，江阔雁声寒。\n持此呈苏李，人生识面难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49896,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送杜晦之兄弟归闽","author":"张弋","text":"秋来犹苦热，归去莫贪程。\n官写新衔位，诗传旧姓名。\n几家村酒贱，一路涧泉清。\n想到乡闾日，争看两弟兄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49897,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送胡道士归康庐","author":"张弋","text":"避世怀孤往，为庵近五峦。\n出无人作伴，归有鹤相看。\n老石苔衣净，深山瀑布寒。\n自言犹养母，应未得烧丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49898,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送赵秘著赴湖北仓","author":"张弋","text":"圣君私七泽，使事浼清高。\n俗古山川阔，路长车马劳。\n峒人耕绿野，隐者醉红桃。\n閒暇应登赏，词章继楚骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49899,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送徐和卿之上饶","author":"张弋","text":"江树杂丹青，江寒少得晴。\n亦知君去路，多是水为程。\n衔位犹书岳，游从半作卿。\n如逢二泉子，因说野人名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49900,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送翁十赴举","author":"张弋","text":"今年科诏下，颇亦动山情。\n丹灶留云守，书装冒热行。\n卜知三命胜，业擅一经明。\n倘赴琼林宴，能诗旧有声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49901,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送郭道士之江州","author":"张弋","text":"尽看山南景，忽思山北游。\n屐过云亦动，琴罢月空流。\n世上无非热，林间一似秋。\n虽然乍相识，别去也能愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49902,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]