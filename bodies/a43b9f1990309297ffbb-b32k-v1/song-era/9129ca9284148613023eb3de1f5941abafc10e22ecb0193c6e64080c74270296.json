[{"title":"唐崇徽公主手痕和韩内翰","author":"欧阳修","text":"故乡飞鸟尚啁啾，何况悲笳出塞愁。\n青冢埋魂知不返，翠崖遗迹为谁留。\n玉颜自古为身累，肉食何人与国谋。\n行路至今空叹息，岩花涧草自春秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29946,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏侯彦济武陟尉","author":"欧阳修","text":"风烟地接怀，井邑富田垓。\n河近闻冰坼，山高见雨来。\n官闲同小隐，酒美足衔杯。\n好去东篱菊，迎霜正欲开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29947,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"席上送刘都官","author":"欧阳修","text":"都城车马日喧喧，虽有离歌不惨颜。\n岂似客亭临野岸，暂留樽酒对青山。\n天街树绿腾归骑，玉殿霜清缀晓班。\n莫忘西亭曾醉处，月明风溜响潺潺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29948,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"旅思","author":"欧阳修","text":"调苦歌非乐，岐多泪始零。\n羞弹长铗剑，终恋五侯鲭。\n陌草薰沙绿，江枫照岸青。\n南陔动归思，兰叶向春馨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29949,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晏元献公挽辞三首 其三","author":"欧阳修","text":"富贵优游五十年，始终明哲保身全。\n一时闻望朝廷重，馀事文章海外传。\n旧馆池台闲水石，悲笳风日惨山川。\n解官制服门生礼，惭负君恩隔九泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29950,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晏元献公挽辞三首 其二","author":"欧阳修","text":"四镇名藩忽十春，归来白首两朝臣。\n上心方喜亲耆德，物论犹期秉国钧。\n退食图书盈一室，开樽谈笑列嘉宾。\n昔人风采今人少，恸哭何由赎以身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29951,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晏元献公挽辞三首 其一","author":"欧阳修","text":"接物襟怀旷，推贤品藻精。\n谋猷存二府，台阁遍诸生。\n帝念宫臣旧，恩隆衮服荣。\n春风绿野迥，千两送铭旌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29952,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晓发齐州道中二首 其二","author":"欧阳修","text":"岁晚劳征役，三齐旧富闲。\n人行桑下路，日上海边山。\n轩冕非吾志，风霜犯客颜。\n惟应思颍梦，先过穆陵关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29953,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晓发齐州道中二首 其一","author":"欧阳修","text":"东州几日倦征轩，千骑骖驔白草原。\n雁入寒云惊晓角，鸡鸣苍海浴朝暾。\n国恩未报身先老，客思无憀岁已昏。\n谁得平时为郡乐，自怜痟渴马文园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29954,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晓咏","author":"欧阳修","text":"帘外星辰逐斗移，紫河声转下云西。\n九雏乌起城将曙，百尺楼高月易低。\n露裛兰苕惟有泪，秋荒桃李不成蹊。\n西堂吟思无人助，草满池塘梦自迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29955,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"留守相公移镇汉东","author":"欧阳修","text":"周郊彻楚坰，旧相拥新旌。\n路识青山在，人今白首行。\n问农穿稻野，候节见梅英。\n腰组人稀识，偏应邸吏惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29956,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"留题安州朱氏草堂","author":"欧阳修","text":"俯槛临流蕙径深，平泉花木绕阴森。\n蛙鸣鼓吹春喧耳，草暖池塘梦费吟。\n赌墅乞甥宾对弈，惊鸿送目手挥琴。\n嗟予远捧从军檄，不得披裘五月寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29957,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病告中怀子华原父","author":"欧阳修","text":"狂来有意与春争，老去心情渐不能。\n世味惟存诗淡泊，生涯半为病侵陵。\n花明晓日繁如锦，酒拨浮醅绿似渑。\n自是少年豪横过，而今痴钝若寒蝇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29958,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"离峡州后回寄元珍表臣","author":"欧阳修","text":"经年迁谪厌荆蛮，惟有江山兴未阑。\n醉里人归青草渡，梦中船下武牙滩。\n野花零落风前乱，飞雨萧条江上寒。\n荻笋时鱼方有味，恨无佳客共杯盘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29959,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"离彭婆值雨投临汝驿回寄张九屯田司录","author":"欧阳修","text":"投馆野花边，羸骖晚不前。\n山桥断行路，溪雨涨春田。\n树冷无栖鸟，村深起暮烟。\n洛阳山已尽，休更望伊川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29960,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"罢官西京回寄河南张主簿","author":"欧阳修","text":"归客下三川，孤邮暂解鞍。\n鸟声催暮急，山气欲晴寒。\n已作愁霖咏，犹怀祖帐欢。\n更闻溪溜响，疑是石楼滩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29961,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"荷叶","author":"欧阳修","text":"采掇本芳陂，移根向玉池。\n晴香滋白露，翠色弄清漪。\n雨歇凉飙起，烟明夕照移。\n如何江上思，偏动越人悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29962,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读易","author":"欧阳修","text":"莫嫌白发拥朱轮，恩许东州养病臣。\n饮酒横琴销永日，焚香读易过残春。\n昔贤轩冕如遗屣，世路风波偶脱身。\n寄语西家隐君子，奈何名姓已惊人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29963,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陪府中诸官游城南","author":"欧阳修","text":"一雨郊圻迥，新秋榆枣繁。\n田荒溪溜入，禾熟雀声喧。\n烧出空槎腹，人耕废庙垣。\n闲追向城客，落日隐高原。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29964,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄大名程资政琳","author":"欧阳修","text":"龙门长恨晚方登，便以忘年接后生。\n谈剧每容陪玉麈，饮豪常忆困金觥。\n冰开御水春应绿，云破淮天月自明。\n醉倒离筵听别曲，醒来犹尚记馀声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29965,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄子春发运待制","author":"欧阳修","text":"广陵花月尝同醉，睢苑风霜暂破颜。\n但喜交情久弥重，休嗟人事老多艰。\n壮心未忍悲华发，强饮犹能倒玉山。\n留滞江湖应不久，多为春酒待君还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29966,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄刘昉秀才","author":"欧阳修","text":"丝路萦回细入云，离怀南陌草初薰。\n茂林脩竹谁同禊，明月春萝定勒文。\n燕忆铜鞮来不定，鸿归碣石信难分。\n东风莺友应相望，懊恼孤飞不及群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29967,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄西京张法曹","author":"范纯仁","text":"幕府三年客，群居几日亲。\n初分阙口路，犹见洛阳人。\n垄麦晴将秀，田花晚自春。\n向家行渐近，岂复倦征轮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29968,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄张至秘校","author":"欧阳修","text":"关山一里一重愁，念远伤离两未休。\n南陌望穷云似帐，西楼吟断月如钩。\n柳绵飞后春应减，兰径荒时客倦游。\n拟寄东流问沟水，亦应沟水更东流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29969,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄河阳王宣徽","author":"欧阳修","text":"谁谓萧条颍水边，能令嘉客少留连。\n肥鱼美酒偏宜老，明月清风不用钱。\n况值湖园方首夏，正当樱笋似三川。\n自知不及南都会，勉彊犹须诧短篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29970,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄阁老刘舍人","author":"欧阳修","text":"梦寐江西未得归，谁怜萧飒鬓毛衰。\n莓苔生壁图书室，风雨闭门桃李时。\n得酒虽能陪笑语，老年其实厌追随。\n明朝雨止花应在，又踏春泥向凤池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29971,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄徐巽秀才","author":"欧阳修","text":"瑶花飞雪荡离愁，鷤鴂惊风下绿畴。\n睢苑树荒谁共客，楚江枫老独悲秋。\n千重锦浪翻如箭，万叠春山翠入楼。\n章陌柳条今在否，定临沟水拂东流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29972,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄秦州田元均","author":"欧阳修","text":"由来边将用儒臣，坐以威名抚汉军。\n万马不嘶听号令，诸蕃无事著耕耘。\n梦回夜帐闻羌笛，诗就高楼对陇云。\n莫忘镇阳遗爱在，北潭桃李正氛氲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29973,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄渭州王仲仪龙图","author":"欧阳修","text":"羡君三作临边守，惯听胡笳不惨然。\n弓劲秋风鸣白角，帐寒春雪压青毡。\n威行四境烽烟断，响入千山号令传。\n翠幕红灯照罗绮，心情何似十年前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29974,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄题沙溪宝锡院","author":"欧阳修","text":"为爱江西物物佳，作诗尝向北人誇。\n青林霜日换枫叶，白水秋风吹稻花。\n酿酒烹鸡留醉客，鸣机织苧遍山家。\n野僧独得无生乐，终日焚香坐结跏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29975,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄题宜城县射亭","author":"欧阳修","text":"作邑三年事事勤，宜城风物自君新。\n已能为政留遗爱，何必栽花遗后人。\n蔼若芝兰芳可袭，温如金玉粹而纯。\n友朋欣慕自如此，何况斯民父母亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29976,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄题相州荣归堂","author":"欧阳修","text":"白首三朝社稷臣，壶浆夹道拥如云。\n金貂争看真丞相，竹马犹迎旧使君。\n岂止轩裳誇故里，已将钟鼎勒元勋。\n不须授简樽前客，好学平津自有文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29977,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄题梅龙图滑州溪园","author":"欧阳修","text":"闻说溪园景渐佳，遥知清兴已无涯。\n饮阑归骑多乘月，雪后寻春自探花。\n百啭黄鹂消永日，双飞白鸟避鸣笳。\n平生喜接君酬唱，不得樽前咏落霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29978,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄题景纯学士藏春坞新居","author":"欧阳修","text":"清才四纪擅时名，晚卜丘林遂解缨。\n欲借青春藏向此，须知白首尚多情。\n水浮花出人间去，山近云从席上生。\n漫说市朝堪大隐，仙家谁信在重城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29979,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"崇政殿试贤良晚归","author":"欧阳修","text":"槐柳依依禁籞长，初寒人意自凄凉。\n凤城斜日留残照，玉阙浮云结夜霜。\n老负渔竿贪国宠，病须樽酒送年光。\n归来解带西风冷，衣袖犹沾玉案香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29980,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"常州张卿养素堂","author":"欧阳修","text":"江左衣冠世有名，几人今复振家声。\n朝廷独立清冰节，闾里归来白首卿。\n志在言谈犹慷慨，身闲耳目益聪明。\n长松野水谁为伴，顾我堪羞恋宠荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29981,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清明赐新火","author":"欧阳修","text":"鱼钥侵晨放九门，天街一骑走红尘。\n桐华应候催佳节，榆火推恩忝侍臣。\n多病正愁饧粥冷，清香但爱蜡烟新。\n自怜惯识金莲烛，翰苑曾经七见春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29982,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"毬场看山","author":"欧阳修","text":"为爱南山紫翠峰，偶来仍值雪初融。\n自嫌前引朱衣吏，不称闲行白发翁。\n向老光阴双转毂，此身天地一飘蓬。\n何时粗报君恩了，去逐冥冥物外鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29983,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谒庙马上有感","author":"欧阳修","text":"旌旆晓悠悠，行惊岁已遒。\n霜云依日薄，野水带冰流。\n富庶齐三服，山川禹九州。\n自怜思颍意，无异旅人愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29984,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪后玉堂夜直","author":"欧阳修","text":"雪压宫墙锁禁城，沉沉楼殿景尤清。\n玉堂影乱灯交晃，银阙光寒夜自明。\n尘暗图书愁独直，人闲铃索久无声。\n銮坡地峻谁能到，莫惜宫壶酒屡倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29985,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"黄溪夜泊","author":"欧阳修","text":"楚人自古登临恨，暂到愁肠已九回。\n万树苍烟三峡暗，满川明月一猿哀。\n非乡况复惊残岁，慰客偏宜把酒杯。\n行见江山且吟咏，不因迁谪岂能来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29986,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寒食值雨","author":"欧阳修","text":"禁火仍风雨，客心愁复悽。\n阴云花更重，春日水平堤。\n油壁逢南陌，鞦韆出绿蹊。\n寻芳无厌远，自有锦障泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29987,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"景灵宫致斋","author":"欧阳修","text":"摄事衰年力不彊，谁怜岑寂卧斋坊。\n青苔点点无人迹，绿叶阴阴覆砌凉。\n玉宇清风来处远，仙家白日静中长。\n却视九衢车马客，自然颜鬓易苍苍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29988,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"景灵朝谒从驾还宫","author":"欧阳修","text":"琳馆清晨蔼瑞氛，玉旒朝罢奏韶钧。\n绿槐夹路飞黄盖，翠辇鸣鞘向紫宸。\n金阙日高犹泫露，綵旗风细不惊尘。\n自惭白首追时彦，行近储胥忝侍臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29989,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"智蟾上人游南岳","author":"欧阳修","text":"终日念云壑，南归心浩然。\n青山入楚路，白水望湖田。\n野渡惟浮钵，山家少施钱。\n到时春尚早，收茗绿岩前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29990,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游太清宫出城马上口占","author":"欧阳修","text":"拥旆西城一据鞍，耕夫初识劝农官。\n鸦鸣日出林光动，野阔风摇麦浪寒。\n渐暖绿杨才弄色，得晴丹杏不胜繁。\n牛羊鸡犬田家乐，终日思归盍挂冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29991,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游石子涧","author":"欧阳修","text":"巀嶭高亭古涧隈，偶携嘉客共徘徊。\n席间风起闻天籁，雨后山光入酒杯。\n泉落断崖舂壑响，花藏深崦过春开。\n麇䴥禽鸟莫惊顾，太守不将车骑来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29992,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游彭城公白莲庄","author":"欧阳修","text":"谢墅多幽赏，华轩曾共寻。\n人闲聊载酒，台迥独披襟。\n水落陂光淡，城当山气阴。\n惟馀桃李树，日觉翠蹊深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29993,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答子华舍人退朝小饮官舍","author":"欧阳修","text":"玉阶朝罢卷晨班，官舍相留一笑间。\n与世渐疏嗟已老，得朋为乐偶偷闲。\n红笺搦管吟红药，绿酒盈樽舞绿鬟。\n自是风情年少事，多惭白发与苍颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29994,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答子履学士见寄","author":"欧阳修","text":"颍亳相望乐未央，吾州仍得治仙乡。\n梦回枕上黄粱熟，身在壶中白日长。\n每恨老年才已尽，怕逢诗敌力难当。\n知君欲别西湖去，乞我桥南菡萏香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29995,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答王内翰范舍人","author":"欧阳修","text":"相从一笑欢无厌，屡获新篇喜可涯。\n自昔居前诮糠秕，幸容相倚愧蒹葭。\n白麻诏令追三代，青史文章自一家。\n我亦谏垣新忝命，君恩未报发先华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29996,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答王禹玉见赠","author":"欧阳修","text":"昔时叨入武成宫，曾看挥毫气吐虹。\n梦寐闲思十年旧，笑谈今此一樽同。\n喜君新赐黄金带，顾我宜为白发翁。\n自古荐贤为报国，幸依精识士称公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29997,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答吕太博赏双莲","author":"欧阳修","text":"年来因病不饮酒，老去无悰懒作诗。\n我已负花常自愧，君须屡醉及芳时。\n汉宫姊妹争新宠，湘浦皇英望所思。\n天下从来无定色，况将铅黛比天姿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29998,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答西京王尚书寄牡丹","author":"欧阳修","text":"新花来远喜开封，呼酒看花兴未穷。\n年少曾为洛阳客，眼明重见魏家红。\n却思初赴青油幕，自笑今为白发翁。\n西望无由陪胜赏，但吟佳句想芳丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29999,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答判班孙待制见寄","author":"欧阳修","text":"三朝窃宠幸逢辰，晚节恩深许乞身。\n无用物中仍老病，太平时得作闲人。\n鸣琴酌酒留嘉客，引水栽花过一春。\n惟恨江淹才已尽，难酬开府句清新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30000,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答杜相公宠示去思堂诗","author":"欧阳修","text":"当年丞相倦洪钧，弭节初来颍水濆。\n惟以琴樽乐嘉客，能将富贵比浮云。\n西溪水色春长绿，北渚花光暖自薰。\n得载公诗播人口，去思从此四夷闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30001,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答杜相公惠诗","author":"欧阳修","text":"药苗本是山家味，茶具偏于野客宜。\n敢以微诚将薄物，少资清兴入新诗。\n言无俗韵精而劲，笔有神锋老更奇。\n二宝收藏传百世，岂惟荣耀诧当时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30002,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答和王宣徽","author":"欧阳修","text":"相逢莫怪我皤然，出处参差四纪间。\n有道方令万物遂，无能拟乞一身闲。\n花前独酌樽前月，淮上扁舟枕上山。\n此乐想公应未暇，且持金盏醉红颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30003,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答和吕侍读","author":"欧阳修","text":"昔日题舆愧屈贤，今来还见拥朱轓。\n笑谈二纪思如昨，名望三朝老更尊。\n野径冷香黄菊秀，平湖斜照白鸥翻。\n此中自有忘言趣，病客犹堪奉一樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30004,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答枢密吴给事见寄","author":"欧阳修","text":"老得闲来兴味长，问将何事送馀光。\n春寒拥被三竿日，宴坐忘言一炷香。\n报国愧无功尺寸，归田仍值岁丰穰。\n枢庭任重才馀暇，犹有新篇寄草堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30005,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答资政邵谏议见寄二首 其二","author":"欧阳修","text":"欲知归计久迁延，三十篇诗二十年。\n受宠不思身报效，乞骸惟冀上哀怜。\n相如旧苦中痟渴，陶令犹能一醉眠。\n材薄力殚难勉强，岂同高士爱林泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30006,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答资政邵谏议见寄二首 其一","author":"欧阳修","text":"豪横当年气吐虹，萧条晚节鬓如蓬。\n欲知颍水新居士，即是滁山旧醉翁。\n所乐蕃篱追尺鴳，敢言寥廓逐冥鸿。\n期公归辅岩廊上，顾我无忘畎亩中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30007,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答通判吕太博","author":"欧阳修","text":"千顷芙蕖盖水平，扬州太守旧多情。\n画盆围处花光合，红袖传来酒令行。\n舞踏落晖留醉客，歌迟檀板换新声。\n如今寂寞西湖上，雨后无人看落英。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30008,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答谢判官独游幽谷见寄","author":"欧阳修","text":"闻道西亭偶独登，怅然怀我未忘情。\n新花自向游人笑，啼鸟犹为旧日声。\n因拂醉题诗句在，应怜手种树阴成。\n须知别后无由到，莫厌频携野客行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30009,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]