[{"title":"菩萨蛮","author":"朱子厚","text":"酴醾浴罢温香玉。\n牡丹睡起歌云绿。\n弹压属东阳。\n留春在庆堂。\n简端新组绶。\n辉映烟岚秀。\n妙曲倩清妍。\n祝君无尽年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38225,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谒金门","author":"朱子厚","text":"风动竹。\n清遍一窗梅溽。\n闻道小乔乘凤玉。\n仙裳飘雾縠。\n来嫁吾门公瑾叔。\n天上人间愿足。\n浓缭水沉燃宝烛。\n鬓长相对绿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38226,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出郊即事 其一","author":"朱子恭","text":"水满牛耕犊后随，早田大半已翻犁。\n趁时浸谷清明近，次第秧针绿又齐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38227,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出郊即事 其二","author":"朱子恭","text":"经行阡陌日迟迟，桑柘才方吐绿枝。\n只为峭寒交节晚，村家却是拂蚕时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38228,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"招义驿","author":"朱子恭","text":"霜林红叶趁桐花，路转崖根百尺斜。\n霁日断云成徙倚，湘南秋尽未还家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38229,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"天聪洞","author":"朱元升","text":"云开岩玲珑，一窍入虚空。\n亦有闾阎事，何当叩上穹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38230,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"龙角岩","author":"朱元升","text":"本是一顽石，偶如龙角象。\n至今渴仰人，便作风雷想。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38231,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"应潮潭","author":"朱元升","text":"群山虽叠嶂，大海暗来通。\n气类倘相应，寸心千里同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38232,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"天马峰","author":"朱元升","text":"塞上风尘高，处处寻天马。\n只在此山中，无人到图写。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38233,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"月牖","author":"朱元升","text":"谁将造化手，开此混沌窍。\n每夜吐月时，九州同一照。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38234,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"龙隐岩","author":"朱元升","text":"岩根岚雾深，神龙隐其所。\n莫恃云霄近，容易兴云雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38235,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"采药径","author":"朱元升","text":"黄精与钩吻，貌同性相反。\n寄诗径中人，采时高著眼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38236,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓云峰","author":"朱元升","text":"旱天无觅处，晓云此无数。\n只消一缕飞，亦可作甘露。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38237,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"沁园春 从臾还亲","author":"朱元夫","text":"心上浮香，轩前度影，约久传梅。\n奈月意风情，枝南枝北，云婚雨嫁，年去年来。\n几望溪桥，屡肥芳信，历尽冰霜春自回。\n朝来报，报梢头儿女，并蒂花开。\n佩环飞下妆台。\n喜今度佳期不用催。\n羡行李三千，金屏翠幄，仙姿第一，玉骨琼腮。\n雌蝶纷纷，雄蜂逐逐，争道工为使与媒。\n翁知么，有西楼过雁，暗为徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38238,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"壶中天/念奴娇 寿贺晓山五下九岁，四月十二日生，先年有横讼","author":"朱元夫","text":"人生有酒，得闲处、便合开怀随意。\n况对寿、龟仙鹤舞，犹直壶天一醉。\n蚕麦江村，梅霖院落，立夏明朝是。\n樽前回首，去年四月十二。\n依旧洛里吟窝，华台书隐，心事无怀氏。\n偃鼠醯鸡空扰扰，海月天风谁寄。\n珠璧祯祥，斗牛光景，预可占斯世。\n先生出否，明年方六十岁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38239,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"朱元瑜","text":"嚼梅香袭齿，攀柳绿藏巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38240,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与宋景文公唱酬牡丹诗","author":"朱公绰","text":"仁帅安全蜀，祥葩育至和。\n地寒开既晚，春曙力终多。\n翠幕遮蜂蝶，朱阑隔绮罗。\n殷勤凭驿使，光景易蹉跎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38241,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"朱公绰","text":"谏草焚来应见史，橐金散尽只留书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38242,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题湘湖","author":"姜应龙","text":"世路羊肠淹客游，尘缨来此濯清流。\n半窗修竹翠含雨，一片澄湖冷浸秋。\n地僻莓苔侵石几，机忘鸥鹭近渔舟。\n夜凉酒醒未能睡，诗句欲成搔白头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38243,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"神灯","author":"朱天民","text":"昔向长老说，北山有神灯。\n六月神初度，邑人竞高登。\n夜深无消息，忽其见崚嶒。\n璀璨作奇葩，点缀横玉绳。\n渐渐出阴壑，两两度松藤。\n乍明既倏晦，此没或彼兴。\n光中若有人，前后相参承。\n久久乃散去，各自为侪朋。\n神意会群望，欢尽车方升。\n我家枕朔冈，梦寐云气腾。\n日暮启窗户，挥扇却炎蒸。\n跂于默一祝，祥光来相应。\n体大赤杲日，中瑩融明冰。\n此乃少为贵，群嘱当未曾。\n再拜灯复出，照我心渊澄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38244,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"朱天锡","text":"百里欢声歌扇底，万家和气酒杯中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38245,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"芭蕉","author":"朱少游","text":"剪得西园一片青，故将来此恼诗情。\n怪来昨夜窗前雨，减却潇潇数点声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38246,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"掬水月在手","author":"朱少游","text":"十指纤纤弄碧波，分明掌上见姮娥。\n不知李白当年醉，曾向江边捉得么。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38247,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陈山道中","author":"朱斗文","text":"缭绕陈山路，萧疏古岸枫。\n侧身徐杖屦，蹇足奈蒿蓬。\n叆叆流云暮，冥冥落雁空。\n巨灵劈倒处，龙出玉泉中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38248,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"朱斗文","text":"丹楼碧阁南徐馆，叠嶂排峰北固山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38249,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"朱斗文","text":"巨灵擘两山，飞泉拟白龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38250,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其三","author":"朱斗文","text":"空存渌水桥，不见青苔寺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38251,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其四","author":"朱斗文","text":"隔溪人唤渔樵动，江上潮平船欲行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38252,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大涤洞天留题","author":"朱日新","text":"十年欲到今才到，九锁山中称策筇。\n白日燃松游两洞，清晨洗眼看孤峰。\n心情老矣难为节，景气暄然不似冬。\n剩与仙翁有期约，从兹来往定从容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38253,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"归隐桥新成偶题三绝句书呈同志 其三","author":"朱长文","text":"逢人尚欲开松径，送客应休过笔溪。\n林下有谁频肯顾，春深好听子规啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38254,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"归隐桥新成偶题三绝句书呈同志 其一","author":"朱长文","text":"幽居处处映烟萝，归隐桥边月色多。\n蟾桂有情怜病叟，清光终夕照酣歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38255,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"归隐桥新成偶题三绝句书呈同志 其二","author":"朱长文","text":"挂却簪缨裹幅巾，清流绕舍断红尘。\n小桥何用通来往，犹为凝冬病涉人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38256,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"华亭吴江道中偶作十绝 其三","author":"朱长文","text":"白日归来皆有意，平生事了最为难。\n可怜万顷烟波色，只属天随醉眼看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38257,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"华亭吴江道中偶作十绝 其一","author":"朱长文","text":"人间出鹤只云间，相合仙经得亦难。\n尘外应多随羽客，未教流俗等闲看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38258,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"华亭吴江道中偶作十绝 其八","author":"朱长文","text":"川上飞桥处处横，几回经此阅平生。\n碧芦萧瑟风前韵，一似家林霰雪声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38259,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"华亭吴江道中偶作十绝 其六","author":"朱长文","text":"贤哲多为贵势拘，人人空道爱江湖。\n谁将五鼎盈前食，肯换秋风一箸鲈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38260,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"华亭吴江