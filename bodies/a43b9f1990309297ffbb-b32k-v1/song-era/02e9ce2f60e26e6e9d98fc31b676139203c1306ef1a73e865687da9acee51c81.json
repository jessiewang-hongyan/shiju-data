[{"title":"睦州担板","author":"释守卓","text":"脑后与一锥，头头堕坑坎。\n直饶唤不回，也是虚担板。\n休担板，透过睦州关，乾坤一只眼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58450,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"云门俱子","author":"释守卓","text":"俱，俱，本祖丕图。\n淳风一振，处处欢呼。\n百草头上，荐献还殊。\n七佛之师亲识面，元来祇是古文殊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58451,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"曹山向火因缘日照寒潭明更明","author":"释守卓","text":"日照寒潭明更明，寥寥虎啸清风生。\n寰中阃外应须辨，白玉盘盛铁眼睛。\n曹山老，曹山老，正去偏来没处讨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58452,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三界唯心万法唯识","author":"释守卓","text":"三界唯心，海岳销沈。\n万法唯识，青黄曲直。\n天上人间，乃规乃则。\n眼耳即真，见闻俱惑。\n孰为言宣，讵假玄默。\n混尔圆常，分尔百亿。\n迷悟不来，尘毛匪忒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58453,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"云门糊饼","author":"释守卓","text":"左眼半斤，右眼八两。\n不问亲疏，有功者赏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58454,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"乾峰十方薄伽梵","author":"释守卓","text":"须弥头倒卓，碧海起清风。\n东弗已摇落，西瞿花正红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58455,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"即心即佛","author":"释守卓","text":"风劲叶频落，山高日易沈。\n坐中人不见，窗外白云深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58456,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"僧问四料拣因而颂之 其一","author":"释守卓","text":"夺人不夺境，山河光炯炯。\n若谓露全身，重添眼中眚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58457,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"僧问四料拣因而颂之 其二","author":"释守卓","text":"夺境不夺人，虚空问四邻。\n从来无眹兆，何事起埃尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58458,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"僧问四料拣因而颂之 其三","author":"释守卓","text":"人境两俱夺，倒转舌头说。\n四句若为分，昙花生枯蘖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58459,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"僧问四料拣因而颂之 其四","author":"释守卓","text":"人境俱不夺，东西任该抹。\n七九六十三，相逢阿喇喇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58460,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"总颂","author":"释守卓","text":"人境夺不夺，千手未拈掇。\n捧出黄金盘，赠君贮明月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58461,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答问颂五首 其一","author":"释守卓","text":"有宾有主，父子规程。\n子无线索，妙辨纵横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58462,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答问颂五首 其二","author":"释守卓","text":"一棒一条痕，蒺藜好自吞。\n仙陀还蹉过，赢得瞎驴存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58463,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答问颂五首 其三","author":"释守卓","text":"东山水上行，枯骨壮韩情。\n藤林荒已久，三句若为明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58464,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答问颂五首 其四","author":"释守卓","text":"乌鸡头带雪，偏正没安排。\n明月堂前意，悠悠莫乱猜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58465,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答问颂五首 其五","author":"释守卓","text":"问取修山主，浅浅实甚深。\n若谓唯心现，玄艘已陆沉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58466,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宗门一句","author":"释守卓","text":"宗门一句，明明独露。\n孰辨端倪，胡为指注。\n指注不真，镜像空尘。\n空尘何立，镜像谁入。\n当机则应，头头非剩。\n触处俱宣，句句通玄。\n门门宾主，互正互偏。\n含容透脱，千江一月。\n无在不在，谁憎谁爱。\n焕尔既明，森然不碍。\n不碍既明，金刚眼睛。\n穷幽测显，神妙体灵。\n妙灵不住，无生不生。\n是宜超越，所以纵横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58467,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"迷悟何从","author":"释守卓","text":"恰恰今人用，明明古佛心。\n寒云归碧嶂，幽鸟下青林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58468,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"白圭无玷","author":"释守卓","text":"云生不翳空，日上难逃影。\n相逢一笑中，何须重反省。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58469,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答客问","author":"释守卓","text":"从来住处无人识，今日劳公扣指南。\n是眼不应还见眼，从教佛祖竞来参。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58470,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示辨实","author":"释守卓","text":"一酬一问分宾主，端的如何辨正邪。\n卓尔未能超本际，茫茫难透眼前花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58471,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"会同风","author":"释守卓","text":"君子南北我东西，瞥尔惺惺忽尔迷。\n一笑一狂谁会得，白云深处有猿啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58472,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偶言","author":"释守卓","text":"岩松森翠皆穿眼，涧水清泠亦到心。\n自笑不能修白业，祇凭流水念观音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58473,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东山礼祖塔二首 其一","author":"释守卓","text":"云拥莲峰插太虚，清香不付岭南卢。\n而今五叶分明在，触处离披见得无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58474,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东山礼祖塔二首 其二","author":"释守卓","text":"古鉴光分前后身，拟于何处拂埃尘。\n易观刹海毛端现，难把师心说向人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58475,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赞饮光","author":"释守卓","text":"千闻巧演眉犹蹙，一见轻拈笑不休。\n笑里藏锋谁辨的，刹竿倒却有来由。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58476,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赞达磨","author":"释守卓","text":"神光的的见聱讹，面壁喃喃语更多。\n不是梁王先勘破，脱身归去奈渠何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58477,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赞二祖","author":"释守卓","text":"断臂求师，平田失脚。\n三拜依位，诚人得谑。\n稽首高深，少峰伊洛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58478,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赞三祖","author":"释守卓","text":"白衣受道，瘥病非药。\n无欠无馀，有锤有凿。\n觅解脱门，汝为谁缚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58479,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赞四祖","author":"释守卓","text":"法法明心，尘尘垂手。\n正出黄梅，傍生牛首。\n巍巍双峰，天长地久。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58480,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赞五祖","author":"释守卓","text":"浊港转身，破头印法。\n五叶芬芳，千徒杂踏。\n于秀于能，谁离谁合。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58481,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赞六祖","author":"释守卓","text":"驾白牛车，受黄梅印。\n没体归神，当机发迅。\n真轨无差，坤维大顺。\n衣止不传，法唯自信。\n曹源一滴起滔天，千古南宗谁独振。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58482,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赞灵源和尚二首 其一","author":"释守卓","text":"拳下翻身，竿头进步。\n万派同归，灵源独露。\n瓦砾光辉，风云流布。\n千眼那知，群心自度。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58483,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赞灵源和尚二首 其二","author":"释守卓","text":"灵灵在源，昭昭而默。\n不汝不谁，奔南走北。\n同佛同魔，佛魔自或。\n衲子之祸，偏见之贼。\n跛跛挈挈兮我师无师，浑浑仑仑兮人识不识。\n前三十年，拶破一拳。\n直至如今，虚空偪塞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58484,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赞太平勤禅师","author":"释守卓","text":"铁石咽喉，吞栗棘蓬于白云山下。\n风霜号令，示金刚圈于皖伯台前。\n十年据坐道场，四海喧腾声价。\n无佛法可说，有公桉须行。\n望风何多，一进一退。\n稽首赞扬，得罪得罪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58485,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"师自作真赞 其一","author":"释守卓","text":"锥扎不入，顽皮太煞。\n自无一文，随方买卖。\n淮田神州，酬还宿债。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58486,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"师自作真赞 其二","author":"释守卓","text":"溃散百骸从龌龊，一长灵物熟知音。\n银蟾不落清江里，坐对黄花秋已深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58487,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"师自作真赞 其三","author":"释守卓","text":"镜中电影急观瞻，水底灯毬休把捉。\n忘言要辨此时机，万里清秋看一鹗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58488,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"师自作真赞 其四","author":"释守卓","text":"南海之滨，兔生两角。\n幕阜之顶，硗硗确确。\n从十年游，脚跟皴剥。\n讨甚机锋，七错八错。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58489,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"师自作真赞 其五","author":"释守卓","text":"铁牛奔入玉麟队，自古无双今一对。\n脱体堂堂呈似伊，有眼无口如何会。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58490,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"师自作真赞 其六","author":"释守卓","text":"曾戴花冠入东鲁，又携角杖到西乾。\n恶嫌黄檗无多子，笑许韶阳烂漫禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58491,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"牧牛颂示众","author":"释守卓","text":"日用须牧牛，鼻索莫离手。\n露地非自然，驯良在日久。\n鞭绳既无用，人牛复何有。\n此时唯己知，始觉从前咎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58492,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读传灯录","author":"释守卓","text":"谁谓拈花后，联芳直至今。\n到头珠有水，未免线因针。\n蝶在花犹在，春深草亦深。\n轩窗倚疏豁，闲听洞龙吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58493,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和昭默老人寄示拂子颂","author":"释守卓","text":"即此用，离此用，箭未离弦的先中。\n万仞崖前撒手归，一句机玄无用用。\n此时针芥审无差，戴恩奚翅丘山重。\n誓捐躯命壮县丝，随波聊与人天共。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58494,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题廓然居士指庵","author":"释守卓","text":"全指即亡指，应机何有机。\n此庵容法界，当处洞真归。\n寂是用还是，生非佛亦非。\n南方休更问，一笑豁离微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58495,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"刘公任侍郎比乞法名示之以妙通兹承佳偈因和以答","author":"释守卓","text":"法法彰全妙，心心祇自通。\n迥然分木迹，廓尔绝边中。\n谛了名斯立，安行实所从。\n大哉无事事，裴运有孤风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58496,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"即来言和答公任侍郎 其一","author":"释守卓","text":"迥脱根尘始识尘，了无所得才真得。\n堂堂独露本来光，越自南兮胡自北。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58497,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"即来言和答公任侍郎 其二","author":"释守卓","text":"打破乾坤渠即我，包衾覆载我非渠。\n渠渠我我教谁识，当体玄玄祇自如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58498,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"即来言和答公任侍郎 其三","author":"释守卓","text":"旷大劫来没作做，今日非新昨非故。\n回光暂借瞥时间，豁见长灵名得度。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58499,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和答妙灵修撰谢法名","author":"释守卓","text":"扣己的明无妙妙，参渠始见不灵灵。\n妙灵灵处谁参扣，瞥转机轮悟独醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58500,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"灵然居士施曲木禅床因坐小参以颂示众","author":"释守卓","text":"灵然家秘曲木床，愿供长灵坐八荒。\n衲子惺惺为掀倒，翻然独露本然光。\n本然光透呵呵笑，无限虚空呈一窍。\n南海波斯弄琵琶，声声解作单于调。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58501,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"小偈四首寄示心然道人聊资体味以进个中精淳之趣 其一","author":"释守卓","text":"心然法法然，法异心心异。\n透过然异来，许你个巴鼻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58502,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"小偈四首寄示心然道人聊资体味以进个中精淳之趣 其二","author":"释守卓","text":"个中好巴鼻，言下须瞥地。\n寂寂要惺惺，当机善游戏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58503,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"小偈四首寄示心然道人聊资体味以进个中精淳之趣 其三","author":"释守卓","text":"心然法法死，大用始全举。\n的的彻生生，互非互相许。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58504,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"小偈四首寄示心然道人聊资体味以进个中精淳之趣 其四","author":"释守卓","text":"非许复何如，法界一蘧庐。\n于中全谛实，此外尽撩虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58505,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄徐师利 其一","author":"释守卓","text":"要明得丧非干我，须到身心洞彻时。\n彻处忘缘缘即彻，从兹出处但随宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58506,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄徐师利 其二","author":"释守卓","text":"迹在世途心了了，两全方显丈夫儿。\n八风尽入遮那境，秘诀何劳问祖师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58507,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送愿上人归龙山省侍昭默老人","author":"释守卓","text":"我省老师未尝病，汝行亲省病老师。\n汝我同门无异路，彼彼步步不相随。\n肯谓长行无伴侣，正宜念念念在兹。\n我惭塞责成拘局，心虽默堂身远离。\n尔能急义重去就，身心俱往更由谁。\n千里龙山不日到，归心犹恐锡飞迟。\n无病病师力奉侍，不亲亲者真其资。\n双溪幕阜不相远，一往一来皆妙期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58508,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送谌首座归永嘉","author":"释守卓","text":"万变相应一句通，十二年来已无口。\n别余遥指海山归，雁荡峰作师子吼。\n此旨明明不覆藏，冥怀自乐有馀光。\n曹源一滴流千古，宿觉徽猷振大唐。\n觌面家风人若问，钓鱼须是谢三郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58509,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送慈侍者宁亲","author":"释守卓","text":"生缘断处参吾道，孝义敦时念倚门。\n要得一槌收两当，别余归去省寒温。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58510,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送僧归永嘉","author":"释守卓","text":"在在常参一宿觉，的的生缘非永嘉。\n还我今朝却归去，大千俱属眼中花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58511,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"拟寒山四首 其一","author":"释守卓","text":"有物是何物，周流泄妙机。\n春晴山鸟语，日暮洞云归。\n指是马还是，心非佛亦非。\n谁能同彼此，携手入玄微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58512,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"拟寒山四首 其二","author":"释守卓","text":"一念通真际，尘尘秘藏开。\n当头谁是主，撒手自为媒。\n大海收毛孔，神珠隐蚌胎。\n此时知佛祖，犹向外边来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58513,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"拟寒山四首 其三","author":"释守卓","text":"问讯西来祖，人心为有无。\n如何垂直指，早晚转凡夫。\n洛水澄如练，嵩山秀若图。\n不知端的者，刚道有差殊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58514,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"拟寒山四首 其四","author":"释守卓","text":"见道即修道，无心谁悟心。\n是非凡与圣，成坏古无今。\n碧涧流残叶，微风入静林。\n谁来石岩下，教汝夜穿针。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58515,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居三首 其一","author":"释守卓","text":"僧家毕竟居山好，石室茆茨养病身。\n开眼不知明属日，回头只见影随人。\n密通蛇虎为真友，笑与禽鱼会本因。\n客间住山今几久，一番芳草一番春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58516,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居三首 其二","author":"释守卓","text":"孤猿瘦鹤冷相看，百衲三衣任岁寒。\n未拟将心求别佛，曾因拨草见幽兰。\n谁为虚谷呼能应，自许无弦密可弹。\n若谓本来无一物，知公亲被祖师谩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58517,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居三首 其三","author":"释守卓","text":"当轩唯有好溪山，卒岁无人共往还。\n闲看白云生翠碧，静闻清磬落潺湲。\n声将声入分犹易，空以空藏见即难。\n此个不能收拾得，任随流水落人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58518,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渔父","author":"释守卓","text":"白发慵梳百不忧，与他鸥鸟日悠悠。\n清朝荣辱几番事，满眼烟波一叶舟。\n雨过洞庭歌棹月，霜飞云梦醉眼秋。\n蓑纶晚■芦花岸，闲扣金针作钓钩。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58519,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"牧童","author":"释守卓","text":"相呼相唤又村讴，放却牛来古渡头。\n有客问津浑不顾，笑将轻苇汎孤舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58520,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山中偶作五首 其一","author":"释守卓","text":"万化曾无间，真机宛自灵。\n白云盘作盖，青嶂列为屏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58521,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山中偶作五首 其二","author":"释守卓","text":"猛虎啸寒谷，乌鸦噪晚晖。\n圆通门大启，何事不同归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58522,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山中偶作五首 其三","author":"释守卓","text":"坐石吊孤影，看云笑此身。\n蒲团无限意，分付与何人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58523,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]