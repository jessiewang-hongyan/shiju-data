[{"title":"此君室 其十","author":"方蒙仲","text":"泛菊秋始佳，爱莲夏方娱。\n不如交此君，清兴无时无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9387,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"此君室 其十四","author":"方蒙仲","text":"横厨先玉盘，膻荤鄙哉俗。\n竹谓高将军，汝手污吾足。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9388,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"此君室 其五","author":"方蒙仲","text":"辈行有后先，志节无今古。\n君看锦绷儿，楚楚已可数。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9389,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"此君室 其六","author":"方蒙仲","text":"不入闹园林，雅媚佳山水。\n君子亦党乎，贤者后乐此。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9390,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"此君室 其十七","author":"方蒙仲","text":"柳以柔故重，枣以弱故惛。\n凛凛首阳人，何赖东皇君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9391,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"此君室 其十九","author":"方蒙仲","text":"问卿自用卿，为我宁作我。\n道莫强项为，本见折腰可。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9392,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"此君室 其十一","author":"方蒙仲","text":"仆也环堵人，公也钧天居。\n本出元子下，岂必竹马馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9393,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"此君室 其四","author":"方蒙仲","text":"清福造物悭，数竿自超俗。\n苦觅渭滨封，万此岂有足。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9394,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"红梅","author":"方蒙仲","text":"不但色秾华，更觉香幽迥。\n笑杀海棠仙，死抱渊材恨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9395,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西湖梅","author":"方蒙仲","text":"忆昔跨吟鞍，花翁赏新句。\n回首十年强，肠断天竺路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9396,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"层梅","author":"方蒙仲","text":"化工真是巧，玉蕊更层层。\n若使□□刻，千年犹未成。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9397,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘后村梅花百咏 其七十八","author":"方蒙仲","text":"花昔罗浮山下居，肌肤玉雪缟衣裾。\n冷斋不到朝云死，独与松风伴大苏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9398,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘后村梅花百咏 其三十一","author":"方蒙仲","text":"煮木石餐多药灶，断荤膻气独茶铛。\n诗人自合长年瘦，底事梅花更瘦生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9399,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘后村梅花百咏 其十六","author":"方蒙仲","text":"青子成时殊苦淡，玉英嚼处更清酸。\n自缘芳洁盈腔里，安肯甘甜转舌间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9400,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘后村梅花百咏 其三十二","author":"方蒙仲","text":"刻玉雕琼费尽工，待看佳实绿阴中。\n早推花作群芳首，谁道梨为百果宗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9401,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘后村梅花百咏 其一","author":"方蒙仲","text":"从来芳事无时歇，雨洒风飘且莫悲。\n收拾苍苔成艾紬，茶山后有放翁诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9402,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘后村梅花百咏 其六十八","author":"方蒙仲","text":"一从香影句名佳，嗣响才称竹外斜。\n千古梅诗三句好，何如阁笔只看花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9403,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘后村梅花百咏 其八十五","author":"方蒙仲","text":"无色无香应是画，雨珠雨玉柰何穷。\n素餐终老坐成晚，白业它生扫未空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9404,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘后村梅花百咏 其三十六","author":"方蒙仲","text":"纯是沉檀和乳麝，许多珠瓅间金瑰。\n素娥亲捣摊成片，玉帝闲游撒下来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9405,"sha256":"18413bf7