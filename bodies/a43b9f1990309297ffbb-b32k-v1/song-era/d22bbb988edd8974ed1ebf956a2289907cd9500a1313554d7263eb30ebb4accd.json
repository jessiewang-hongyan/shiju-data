etry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9437,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"癸酉冬赴部除夜宿信州客舍","author":"方翥","text":"隔屋青灯一点明，卧听檐雨落三更。\n无因作得还乡梦，门外儿童爆竹声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9438,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送虞仲房监仓归临安","author":"方翥","text":"宿命须同一洞天，相逢孰处故依然。\n不知堕落青衫底，何日尘泥是了缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9439,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病起","author":"方翥","text":"淡荡光风寻户牖，迷濛宿雾净园林。\n春深燕子来无数，雨后桃花落不禁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9440,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"离武林","author":"方翥","text":"大江东接海漫漫，海气江风吹雨寒。\n才出国门三十里，便成回首望长安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9441,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读老子","author":"方翥","text":"且柅流沙青犊车，葱葱佳气满城闾。\n白头不解家人语，狂学司空城旦书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9442,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读易","author":"方翥","text":"昼出阳关已断肠，那堪真别更凄凉。\n痴人刻水方求剑，一息舟行过夜郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9443,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读易 乾","author":"方翥","text":"荡荡春风野老家，欲寻踪迹隔烟霞。\n洞中携出小桃核，种作碧云千树花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9444,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿钓溪","author":"方翥","text":"茅檐寂寞住人稀，落日逢迎宿酒旗。\n梦觉五更山月上，溪边人语钓船移。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9445,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿尊胜庵二首呈谦之 其一","author":"方翥","text":"天寒古寺往来希，门掩柴炉昼共围。\n细雨无声潜自落，开帘时复见霏霏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9446,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿尊胜庵二首呈谦之 其二","author":"方翥","text":"阵阵山风递雨来，夜深飘损满庭梅。\n未应一等成摇落，知有人家花未开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9447,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"紫微","author":"方翥","text":"学得天文夜睡迟，云笼月照恨星稀。\n而今病眼都无力，犹向檐边认紫微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9448,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元日","author":"方翥","text":"又见增年齿，谋身事事非。\n时难逢岁饭，日暖换春衣。\n新莽奸犹在，怀王殡未归。\n中原久离绝，感节泪频挥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9449,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬夜忆谦之","author":"方翥","text":"忽忆夫君阻笑言，出门南望欲飞翻。\n孤诚隔水初浸夜，画角因风自入村。\n短句有时随意得，古心近日与谁论。\n未除习气君应哂，月冷梅香易断魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9450,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再过几先侄斋中","author":"方翥","text":"树连平野阔，深夜易高风。\n星月迷濛外，乾坤鼓荡中。\n山窗寒未白，宿炭晓能红。\n抱被论诗句，长长与子同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9451,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵郑夹漈题林时隐霆芹斋诗","author":"方翥","text":"邓侯牵挽政难留，六十年来亦倦游。\n至竟眼高无俗韵，不因人唤始回头。\n江湖白鸟缘应熟，尘土乌靴心少休。\n可笑山翁痴未已，欲成吏隐更何由。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9452,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谓柔立兄","author":"方翥","text":"鸡犬还家自识村，重营生理长儿孙。\n时平战地逢华屋，岁久他乡是故园。\n别后尘埃如我老，归来耆旧几人存。\n雁行畴昔从游者，莫话凋零恐断魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9453,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与郑国叔司法山行","author":"方翥","text":"策筇山下路，未省尽幽寻。\n回首见桑柘，始知墟落深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9454,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仙篆石","author":"方翥","text":"何人登眺睨绝顶，一树一石探幽奇。\n虫文鸟篆不可识，如读岣嵝神禹碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9455,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再至北乡干归路中作","author":"方翥","text":"远山马首尚相随，近岸迎人势却回。\n鸲鹆食残松子落，虹霓饮过水声来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9456,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寺中别林谦之兼寄诸郑","author":"方翥","text":"游从忘朝晡，尊酒轻招呼。\n笑语恣玩狎，翻覆云雨疏。\n我友数君子，古心相与娱。\n每见辄宾敬，衣裳俨而趋。\n恶石寓规诫，美疢疾佞谀。\n深山足风雨，零落梅花株。\n亭亭岩上松，霜姿一何孤。\n感兹各努力，勿以岁事徂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9457,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵时瑞见寄","author":"方翥","text":"吟诗夜半霜月白，胡床梦作乘槎客。\n醉中入月捉玉兔，手摵桂枝鸣策策。\n风吹天河银浪高，月边星宿相周遭。\n五色机头索云锦，天孙一笑颜如桃。\n天河下接武陵溪，重觅仙源路却迷。\n五更波上回烟棹，半空飞雨落凄凄。\n羽衣稚子双瞳方，伴我清江老严光。\n落日还收钓筒去，芦风起处暮天长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9458,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诗一首","author":"方翥","text":"江山入眼昔无殊，只有人事堪嗟歔。\n权门杂沓行苞苴，屠儿贩客纡青朱。\n梵仪膜拜参浮屠，痴儿娇子不识书。\n淫坊博塞为欢娱，金章下堂揖老胥，老胥分庭抗士儒。\n身裹道衣臂佛珠，岁时入谒何易于。\n羊肩斗酒清而腴，酬酢偃蹇以字呼。\n官家赤子元何辜，一毫枉直凭青蚨。\n十八年前此事无，作诗一笑君应呼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9459,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"除夜寄谦之","author":"方翥","text":"去年雪暗江南路，日暮踟蹰无宿处。\n今年坐见故园春，梅花已过桃花新。\n东皋薄田才数亩，依方旋造逡巡酒。\n嗣宗痛饮是吾师，万事否臧勿挂口。\n循环三百真超忽，谁向空濛问巢窟。\n愚痴聪慧一冥冥，不如且进杯中物。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9460,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"家有白鸡蓄之三年矣驯熟可爱谦之读书山中一日相过偶道庵僧所阙遂送谦之以遗之","author":"方翥","text":"羽仪洁白如自脩，风雨晦冥那失晓。\n沙头鸥鸟不驯熟，雪里鹭丝太孤皎。\n山寒夜半落叶深，闭门垂荑偎重衾。\n闻鸡而起竟何事，我老看书不入心。\n久无斗志形如木，世上痴儿能舍肉。\n白鸡之肉不可食，无劳断尾亦为福。\n山僧穷独老无妻，想见爱养如婴儿。\n得地羽毛愈应好，天年全得山中老。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9461,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"粘蚝石","author":"方翥","text":"累累蚝山着石面，此非所有能无疑。\n细看大石深孔窍，舟人撑篙迹犹遗。\n乃知此山千载前，汹涌尚作海渺瀰。\n蛟龙鱼鳖占窟宅，不省造化能密移。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9462,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]