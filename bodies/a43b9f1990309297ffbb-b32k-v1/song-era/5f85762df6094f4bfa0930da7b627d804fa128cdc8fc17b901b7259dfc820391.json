o":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72039,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠嗣直弟颂十首 其九","author":"黄庭坚","text":"向上关捩子，未曾说似人。\n困来一觉睡，妙绝更通神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72040,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠嗣直弟颂十首 其八","author":"黄庭坚","text":"虽受然灯记，不从然灯得。\n若会翻身句，弥勒真弥勒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72041,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠嗣直弟颂十首 其七","author":"黄庭坚","text":"江南十兄弟，长被时一共。\n梦时各自境，独与君同梦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72042,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠嗣直弟颂十首 其六","author":"黄庭坚","text":"万里唯将我，回观更有谁。\n初无卓锥地，今日更无锥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72043,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠嗣直弟颂十首 其五","author":"黄庭坚","text":"江南鸿雁行，人言好兄弟。\n无端风忽起，纵横不成字。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72044,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠嗣直弟颂十首 其四","author":"黄庭坚","text":"涪陵萨埵子，且道也旁行。\n亦嚼横陈蜡，不爱孔方兄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72045,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠嗣直弟颂十首 其三","author":"黄庭坚","text":"正观心地时，丝发亦无有。\n却来观世间，冬后数九九。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72046,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠嗣直弟颂十首 其二","author":"黄庭坚","text":"去日撒手去，来时无与偕。\n若将来去看，还似不曾斋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72047,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠嗣直弟颂十首 其一","author":"黄庭坚","text":"饥渴随时用，悲欢触事真。\n十方无壁落，中有昔怨人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72048,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"避秦十人","author":"黄庭坚","text":"九真承诏上龙胡，尽是骊山所送徒。\n惟有邓公留不去，松根支鼎煮菖蒲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72049,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"避暑李氏园二首 其二","author":"黄庭坚","text":"荷气竹风宜永日，冰壶凉簟不能回。\n题诗未有惊人句，会唤谪仙苏二来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72050,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"避暑李氏园二首 其一","author":"黄庭坚","text":"李侯别馆锁春阴，花径吹香可细寻。\n迸笋侵阶藤倒架，主人重为费千金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72051,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"魏夫人坛","author":"黄庭坚","text":"独扫蛾眉作远山，春风瑶草照朱颜。\n我来欲问许玉斧，二十四峰如髻鬟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72052,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"字颂","author":"黄庭坚","text":"斋馀睡兀兀，占尽檐前日。\n不与一瓯茶，眼前黑如漆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72053,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"二月丁卯喜雨吴体为北门留守文潞公作","author":"黄庭坚","text":"乘舆斋祭甘泉宫，遣使骏奔河岳中。\n谁与至尊分旰食，北门卧镇司徒公。\n微风不动天如醉，润物无声春有功。\n三十馀年霖雨手，淹留河外作时丰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72054,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十二月十九日夜中发鄂渚晓泊汉阳亲旧携酒追送聊为短句","author":"黄庭坚","text":"接淅报官府，敢违王事程。\n宵征江夏县，睡起汉阳城。\n邻里烦追送，杯盘泻浊清。\n秪应瘴乡老，难答故人情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72055,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"万州下岩二首 其二","author":"黄庭坚","text":"寺古松楠老，岩虚塔庙开。\n僧缘蚕麦去，官数荔支来。\n石室无心骨，金铺称意苔。\n若为刘道者，拽得鼻头回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72056,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三月壬申同尧民希孝观净名寺经藏得弘明集中沈烱同庾肩吾诸人游明庆寺诗次韵奉呈二公","author":"黄庭坚","text":"秘藏开新译，天花雨旧堂。\n證经多宝塔，寝疾净名床。\n鸟语杂歌颂，蛛丝凝篆香。\n同游得赵李，谈道过何王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72057,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与黔倅张茂宗","author":"黄庭坚","text":"静居门巷似乌衣，文采风流众所归。\n别乘同来二千石，化民曾寄十三徽。\n寒香亭下方遗爱，吏隐堂中已息机。\n暂与计司参婉画，百城官吏借光辉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72058,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"卫南","author":"黄庭坚","text":"今年畚锸弃春耕，折苇枯荷绕坏城。\n白鸟自多人自少，污泥终浊水终清。\n沙场旗鼓千人集，渔户风烟一笛横。\n惟有鸣鸱古祠柏，对人犹是向时情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72059,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"大秀宫","author":"黄庭坚","text":"玉笥山前大白峰，望仙桥下水溶溶。\n前溪流水后溪月，五步白云三步松。\n半夜佩环朝上阙，插天楼阁度疏钟。\n梦馀彷佛钧天奏，如在蓬莱第几重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72060,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"子范徼巡诸乡捕逐群盗几尽辄作长句劳苦行李","author":"黄庭坚","text":"白发尉曹能挽弓，著鞭跨马欲生风。\n乃兄本是文章伯，此老真成矍铄翁。\n枹鼓诸村宵警报，牛羊几处暮牢空。\n得公万户开门卧，看取三年治最功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72061,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中秋","author":"黄庭坚","text":"灏气才中兔魄圆，众躔韬彩独娟娟。\n魏宫乌绕空枝上，汉苑桐凋露井前。\n金液万重涵渤海，玉沙千里对江边。\n遥知此夕多情思，三级萧台枕碧涟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72062,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书睢阳事后","author":"黄庭坚","text":"莫道睢阳覆我师，再兴唐祚匪公谁。\n流离颠沛义不辱，去就死生心自知。\n政使贺兰非长者，岂妨南八是男儿。\n乾坤震荡风尘晦，愁绝宗臣陷贼诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72063,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"予既不得叶遂过洛滨醉游累日","author":"黄庭坚","text":"瘿民见我亦悠悠，瘿木累累满道周。\n飞舄已随王令化，真龙宁为叶公留。\n未能洗耳箕山去，且复吹笙洛浦游。\n舍故趋新归有分，令人何处欲藏舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72064,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"从陈季张求竹竿引水入厨","author":"黄庭坚","text":"井边分水过寒厅，斩竹南溪仗友生。\n来酿百壶春酒味，怒流三峡夜泉声。\n能令官舍庖厨洁，未减君家风月清。\n挥斧直须轻放手，却愁食实凤凰惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72065,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"以同心之言其臭如兰为韵寄李子先 其三","author":"黄庭坚","text":"俗士得失重，舍龟观朵颐。\n六经成市道，驵侩以为师。\n吾学淡如水，载行欲安之。\n惟有无心子，白云相与期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72066,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"以同心之言其臭如兰为韵寄李子先 其七","author":"黄庭坚","text":"客从济南来，遗我故人书。\n墨淡字疏行，故人情有馀。\n上言犹健否，次问意何如。\n只今意何有，思食故溪鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72067,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"劝交代张和父酒","author":"黄庭坚","text":"风流五日张京兆，今日诸孙困小官。\n作尹大都如广汉，画眉仍复近长安。\n三人成虎事多有，众口铄金君自宽。\n酒兴情亲俱不浅，贱生何取罄交欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72068,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"文安国挽词二首 其二","author":"黄庭坚","text":"平生翰墨学，空走使臣车。\n瞿令能苍史，归公好古书。\n秦山刊日月，周鼓颂畋渔。\n不见龙蛇笔，新乾研滴蜍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72069,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王文恭公挽词二首 其二","author":"黄庭坚","text":"宥密深黄阁，光辉极上台。\n藏舟移夜壑，华屋落泉台。\n雨绋谁为挽，寒笳故作哀。\n伤心具瞻地，无复衮衣来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72070,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王文恭公挽词二首 其一","author":"黄庭坚","text":"先皇凭玉几，末命寄元勋。\n宾日行黄道，攀髯上白云。\n四时成岁律，五色补天文。\n不谓堂堂去，今为马鬣坟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72071,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王圣美三子补中广文生","author":"黄庭坚","text":"王家人物从来远，今见诸孙总好贤。\n三级定知鱼尾进，一鸣已作雁行连。\n愧无藻鉴能推毂，愿卷囊书当赠钱。\n归去雄誇向儿侄，舍中犊子剩狂颠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72072,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王彦祖惠其祖黄州制草书其后","author":"黄庭坚","text":"脱略看时辈，诸君等发蒙。\n董狐常直笔，汲黯少居中。\n鵩入迁臣舍，乌号厌世弓。\n平生有嘉树，犹起九原风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72073,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"世弼惠诗求舜泉辄欲以长安酥共泛一杯次韵戏答","author":"黄庭坚","text":"寒齑薄饭留佳客，蠹简残编作近邻。\n避地梁鸿真好学，著书扬子未全贫。\n玉酥鍊得三危露，石火烧成一片春。\n沙鼎探汤供卯饮，不忧问字绝无人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72074,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乐寿县君吕氏挽词二首 其二","author":"黄庭坚","text":"剪髻宾筵盛，齐眉妇礼闲。\n谓宜俱白发，忽去作青山。\n大梦惊蝴蝶，何时识佩环。\n哀歌行欲绝，丹旐雨斑斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72075,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乐寿县君吕氏挽词二首 其一","author":"黄庭坚","text":"归装衣楚楚，家世印累累。\n来作箕帚妇，不忘蘋藻诗。\n居然成万古，何啻谒三医。\n骑省还秋直，霜侵鬓脚衰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72076,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"出池藕花","author":"黄庭坚","text":"惜丝不肯织宫鞋，花月仙人谪下来。\n河伯借泥封玉腕，风神翻浪沃香腮。\n无房不许僧归宿，有盖尝令鹭自开。\n何事冤他结青女，一朝收拾付尘灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72077,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"出迎使客质明放船自瓦窑归","author":"黄庭坚","text":"鼓吹喧江雨不开，丹枫落叶放船回。\n风行水上如云过，地近岭南无雁来。\n楼阁人家捲帘幕，菰蒲鸥鸟乐湾洄。\n惜无陶谢挥斤手，诗句纵横付酒杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72078,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"去岁和元翁重到双涧寺观余兄弟题诗之篇总忘收录病中记忆成此诗","author":"黄庭坚","text":"素琴声在时能听，白鸟盟寒久未寻。\n眼见野僧垂雪发，养亲原不顾朱金。\n开泉浸稻双涧水，煨笋充盘春竹林。\n安得一廛吾欲老，君听庄舄病时吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72079,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"去贤斋","author":"黄庭坚","text":"争名朝市鱼千里，观道诗书豹一班。\n末俗风波尤浩渺，古人廉陛要跻攀。\n螗螂怒臂当车辙，鹦鹉能言著锁关。\n顾我安知贤者事，松风永日下帘间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72080,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"古风次韵答初和甫二首 其二","author":"黄庭坚","text":"君吟春风花草香，我爱春夜璧月凉。\n美人美人隔湘水，其雨其雨怨朝阳。\n兰荃盈怀报琼玖，冠缨自洁非沧浪。\n道人四十心如水，那得梦为胡蝶狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72081,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"古风次韵答初和甫二首 其一","author":"黄庭坚","text":"饥思河鲤与河鲂，渴思蔗浆玉碗凉。\n冬愿纯绵对阴雪，夏愿绉絺度盛阳。\n万端作计身愁苦，一事不谐鬓苍浪。\n调笑天街吟海燕，藜羹脱粟非公狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72082,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"古渔父","author":"黄庭坚","text":"穷秋漫漫蒹葭雨，裋褐休休白发翁。\n范子归来思狡兔，吕公何意兆非熊。\n渔收亥日妻到市，醉卧水痕船信风。\n四海租庸人草草，太平长在碧波中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72083,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"史天休中散挽词","author":"黄庭坚","text":"光禄九男君独秀，赋名几与景仁班。\n淹留州县看恬默，出入风波笑险艰。\n遗爱蜀中三郡有，退身林下十年閒。\n山川英气消磨尽，昨日华堂作土山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72084,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"司马文正公挽词四首 其四","author":"黄庭坚","text":"毁誉盖棺了，于今名实尊。\n哀荣有王命，终始酌民言。\n蝉冕三公府，深衣独乐园。\n公心两无累，忧国爱元元。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72085,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"司马文正公挽词四首 其三","author":"黄庭坚","text":"献纳无虚日，居然迹已陈。\n清班区玉石，宝历顺星辰。\n更化思鸣鵙，遗书似获麟。\n易名无异论，今代两三人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72086,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"司马文正公挽词四首 其二","author":"黄庭坚","text":"国在多艰日，人如大雅诗。\n忠清俱没世，孝友是生知。\n加璧延诸老，櫜弓抚四夷。\n公身与宗社，同作太平基。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72087,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"司马文正公挽词四首 其一","author":"黄庭坚","text":"元祐开皇极，功归用老成。\n惟深万物表，不令四时行。\n日者倾三接，天乎奠两楹。\n堂堂宁复有，埋玉恸佳城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72088,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"四月末天气陡然如秋遂御袷衣游北沙亭观江涨","author":"黄庭坚","text":"沙岸人家报急流，船官解缆正夷犹。\n震雷将雨度绝壑，远水粘天吞钓舟。\n甚欲去挥白羽箑，可堪更着紫茸裘。\n平生得意无人会，浩荡舂锄且自由。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72089,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用几复韵题伯氏思堂","author":"黄庭坚","text":"夫子勤于蘧伯玉，洗心观道得灵龟。\n开门择友尽三益，清坐不言行四时。\n风与蛛丝游碧落，日将槐影下隆墀。\n天空地迥何处觅，岁计有馀心自知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72090,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用明发不寐有怀二人为韵寄李秉彝德叟 其八","author":"黄庭坚","text":"桃李春成径，本自不期人。\n历下两寒士，箪瓢能悦亲。\n耻蒙伐国问，肯卧覆车尘。\n子既得此友，从之求日新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72091,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用明发不寐有怀二人为韵寄李秉彝德叟 其一","author":"黄庭坚","text":"竹贯四时清，月通云气明。\n外弟有佳质，妙年推老成。\n后凋对霜雪，不昧处阴晴。\n盛德当如此，古人畏后生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72092,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用明发不寐有怀二人为韵寄李秉彝德叟 其五","author":"黄庭坚","text":"往在舅氏旁，获拚堂上帚。\n六经观圣人，明如夜占斗。\n索居废旧闻，独学无新有。\n羡子杞梓材，未曾离矫揉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72093,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"光山道中","author":"黄庭坚","text":"客子空知行路难，中田耕者自高闲。\n柳条莺啭清阴里，楸树蝉嘶翠带间。\n梦幻百年随逝水，劳歌一曲对青山。\n出门捧檄羞闲友，归寿吾亲得解颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72094,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵","author":"黄庭坚","text":"穷奇投有北，鸿鹄止丘隅。\n我已魑魅禦，君方燕雀俱。\n道应无蒂芥，学要尽工夫。\n莫斩猿狙杙，明堂待栋桴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72095,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵戏赠道夫","author":"黄庭坚","text":"名教自乐地，思君相与娱。\n囊锥见末疾，椟玉待时沽。\n雨歇鸣鸠树，薰销睡鸭炉。\n不来应梦起，子学□啼歈。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72096,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]