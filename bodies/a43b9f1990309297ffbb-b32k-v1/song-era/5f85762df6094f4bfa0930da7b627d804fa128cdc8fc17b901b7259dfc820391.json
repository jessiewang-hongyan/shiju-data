[{"title":"题惠崇画扇","author":"黄庭坚","text":"惠崇笔下开江面，万里晴波向落晖。\n梅影横斜人不见，鸳鸯相对浴红衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72027,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题落星寺四首 其四","author":"黄庭坚","text":"北风吹倒落星寺，吾与伯伦俱醉眠。\n螟蛉蜾蠃但痴坐，夜寒南北斗垂天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72028,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题燕邸洋川公养浩堂画二首 其二","author":"黄庭坚","text":"拥膝度残腊，攀条惊早春。\n陈郎浮竹叶，著我北归人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72029,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题燕邸洋川公养浩堂画二首 其一","author":"黄庭坚","text":"萧寺吟双竹，秋醪荐二螯。\n破尘归骑速，横日雁行高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72030,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题醒心轩","author":"黄庭坚","text":"尽日竹风谈法要，无人竹影又斜阳。\n他时若有相应者，莫负开轩人姓黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72031,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠石敏若","author":"黄庭坚","text":"才似谪仙惟欠酒，情如宋玉更逢秋。\n相看领会一谈胜，注目长江天际流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72032,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠刘静翁颂四首 其四","author":"黄庭坚","text":"净名庞老总垂须，君幸元无免破除。\n心若出家