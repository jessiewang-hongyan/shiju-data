[{"title":"访诸葛鍊师不遇","author":"高翥","text":"青铜留着布囊中，去谒人间小卧龙。\n久欲共君谋一醉，有钱却又不相逢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63601,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"访铦朴翁不遇二首 其二","author":"高翥","text":"乘兴寻僧入翠微，山中无限野蔷薇。\n主人不见从谁赏，折得繁枝自插归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63602,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"访铦朴翁不遇二首 其一","author":"高翥","text":"乱花飞絮趁长髯，来访西湖竹里庵。\n行尽白云三十里，诗人又在白云南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63603,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过临平","author":"高翥","text":"征帆一似白鸥轻，起揭船篷看晓晴。\n梅子着花霜压岸，自披风帽过临平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63604,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吴山绝句","author":"高翥","text":"拂晓官来簿录时，未曾吹彻玉参差。\n旁人不忍听鹦鹉，犹向金笼唤太师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63605,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"庐山道中","author":"高翥","text":"沿路梅花管送迎，庐山初别雪初晴。\n若无急事相驱役，有酒人家便不行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63606,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜步天街书所见","author":"高翥","text":"赛罢祠山赛二郎，酒行明日欲祠张。\n愚民可是都忘本，香火何曾到杜康。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63607,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"孤山雪后","author":"高翥","text":"雪后骑驴行步迟，孤山何似灞桥时。\n近来行辈无和靖，见说梅花不要诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63608,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岩桂花","author":"高翥","text":"玉蕊琅玕树，天香知意薰。\n露寒清透骨，风定远含芬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63609,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"郁孤台 其一","author":"高翥","text":"十年重上郁孤台，带得江湖白发来。\n满眼青山旧相识，晚鸦群噪莫惊猜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63610,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"郁孤台 其二","author":"高翥","text":"登临犹觉酒边豪，往事新愁付一陶。\n深浅不常章贡水，崆峒只似旧时高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63611,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨中","author":"高翥","text":"浓云漠漠雨飞飞，不放东风取次吹。\n先自一春晴意少，那堪梅子欲黄时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63612,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日北山二首 其二","author":"高翥","text":"插花吹笛两山中，桃李尊前日日同。\n待得马头飞絮满，更来沽酒看残红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63613,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日北山二首 其一","author":"高翥","text":"人缘白石溯清溪，手剥苍苔认旧题。\n春色满山归不去，拆桐花里画眉啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63614,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日杂兴二首 其二","author":"高翥","text":"春归门巷静深深，老去无情不彊吟。\n风絮入帘晴昼永，自烧香饼试花沈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63615,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日杂兴二首 其一","author":"高翥","text":"檐铃奏曲响珊珊，尽日重门不启关。\n多插瓶花供宴坐，为渠消受一春閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63616,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春怀","author":"高翥","text":"江南春尽尚春寒，添尽征衣独掩关。\n日暮酒醒闻谢豹，所欢多在水云间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63617,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春情四首 其四","author":"高翥","text":"斗草归来上玉阶，香尘微涴合欢鞋。\n全筹赢得无人赏，依旧春愁自满怀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63618,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春情四首 其三","author":"高翥","text":"深院沈沈照落晖，宝香熏彻旧时衣。\n一春行乐谁为伴，羞见花前蛱蝶飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63619,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春情四首 其二","author":"高翥","text":"天涯海角水云宽，人在吴头楚尾间。\n弹彻箜篌难寄恨，海棠庭院独凭阑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63620,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春情四首 其一","author":"高翥","text":"楼头上马苦匆匆，百计相留无计从。\n正好看花郎却去，江边春色为谁浓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63621,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春寒","author":"高翥","text":"料峭东风破客衣，春寒不比腊前时。\n绝怜墙角樱桃树，全似梅花雪后枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63622,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"看弄潮回","author":"高翥","text":"弄罢江潮晚入城，红旗飐飐白旗轻。\n不因会吃翻头浪，争得天街鼓乐迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63623,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋山散步","author":"高翥","text":"乍晴沙路软于尘，新着芒鞋更可人。\n谁道秋山不宜客，桂花多处胜行春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63624,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋日三首 其三","author":"高翥","text":"独客飘然物外游，江南江北总宜秋。\n芭蕉昨夜缘何事，和雨和风作许愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63625,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋日三首 其一","author":"高翥","text":"旋买扁舟载一翁，片帆吹下夕阳东。\n西风欲织江头锦，催染秋林叶叶红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63626,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋日三首 其二","author":"高翥","text":"庭草衔秋自短长，悲蛩传响答寒螀。\n豆花似解通邻好，引蔓殷勤远过墙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63627,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋兴","author":"高翥","text":"数声新雁夜初长，晓起开门衣袂凉。\n篱菊褪黄秋兴懒，瓦沟财试一痕霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63628,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夜","author":"高翥","text":"老去惊秋白发添，不禁凉吹逼疏帘。\n楼高幸自蛩声远，争柰梧桐又傍檐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63629,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋晚即事","author":"高翥","text":"江头风叶舞低回，催得浓云顷刻开。\n万里碧天红日晚，数声新雁送寒来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63630,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"荆棘中见梅花","author":"高翥","text":"荆棘丛中数点春，春云态度月精神。\n依然竹屋茅檐下，靓女盈盈不嫁人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63631,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送别","author":"高翥","text":"老去情怀怕别离，年来不作送行诗。\n人前举似终难信，问着垂杨便可知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63632,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"首夏","author":"高翥","text":"漾漾池塘碧染衣，阴阴草树绿成围。\n江村寂寞春归后，一点杨花不见飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63633,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"恭跋思陵宸翰拓本卷后","author":"高翥","text":"淡黄越纸打残碑，尽是先皇御赐诗。\n白发内人和泪读，为曾亲见写诗时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63634,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"涧傍菊花","author":"高翥","text":"历寂黄花老涧傍，不因风雨减清芳。\n从教衰谢随秋草，到了能全晚节香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63635,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚春即事","author":"高翥","text":"轻烟终日锁楼台，细雨丝丝半湿苔。\n杜宇一声青嶂外，溪流时送落花来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63636,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菊花 其二","author":"高翥","text":"亲向东篱手自栽，夕阳小径重徘徊。\n花应得似人乖角，过了重阳烂漫开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63637,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菊花 其三","author":"高翥","text":"爱花千古说渊明，肯把秋光不似春。\n我重此花全晚节，剩栽三径伴閒身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63638,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菊花 其一","author":"高翥","text":"白白黄黄自岁寒，诗人但作菊花看。\n牡丹茉莉非吾事，自是时人被眼瞒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63639,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"僧房夜坐","author":"高翥","text":"万枝松里一篝镫，知是山房第几层。\n静夜数声清磬响，上方应有诵经僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63640,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"聚景园口号二首 其二","author":"高翥","text":"竹影参差临断岸，花阴历寂浸清流。\n游人难到阑干角，尽日垂杨盖御舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63641,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"聚景园口号二首 其一","author":"高翥","text":"浅碧池塘连路口，淡黄杨柳护檐牙。\n旧时岁岁春风里，长见君王出看花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63642,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题二小姬扇二首 其二","author":"高翥","text":"湘湘未识羞，独坐抱箜篌。\n贪学耆婆舞，抬身拜部头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63643,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题二小姬扇二首 其一","author":"高翥","text":"庆娘颦翠眉，春瘦怯罗衣。\n笑问采花蝶，如何成对飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63644,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"孺子祠堂","author":"高翥","text":"三间官屋老湖滨，孺子名声日日新。\n下榻本非天上事，后人空自愧前人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63645,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丁卯冬送方岩","author":"高翥","text":"忠言历历未曾行，尽载图书出帝城。\n馀子但知才可忌，先生当以去为荣。\n门阑竹石关心久，部曲溪山照眼明。\n长啸归欤莫怊怅，浙江风定自潮平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63646,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"七夕","author":"高翥","text":"一枕新凉供醉眠，觉来风物已凄然。\n山云带雨重重合，宫树鸣秋叶叶颠。\n满进一杯酬好节，休看两鬓换流年。\n双星回施痴儿等，容我长斋绣佛前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63647,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"卜居","author":"高翥","text":"结屋离黄道，开门对白沙。\n一庄千古月，三径四时花。\n客至旋沽酒，身闲自煮茶。\n相闻虫鸟外，不复听喧哗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63648,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三峡桥","author":"高翥","text":"倦游华发冷萧骚，长夏来登三峡桥。\n山吐湿云何日尽，溪流冻雪几时消。\n陆公泉在犹堪汲，五老峰高不易招。\n客子倚栏思羽化，未仙衣袂已飘飘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63649,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小楼","author":"高翥","text":"小楼终日脱冠巾，白发萧疏不受尘。\n虽是客身犹足乐，苦无世累未为贫。\n家书远寄凭游子，邸报频看念故人。\n自叹此心清似水，为他閒事恼天真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63650,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小楼夜雨","author":"高翥","text":"心懒缘忘世，身閒为不才。\n客愁随病散，老眼共书开。\n嗜酒有天戒，爱花无地栽。\n小楼风雨夜，还我鼻如雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63651,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小楼雨中","author":"高翥","text":"云浮江雨暗，独客苦淹留。\n白发羞明镜，青山对小楼。\n酒功书下下，心事付悠悠。\n安得并州剪，从头剪断愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63652,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小楼雨中","author":"高翥","text":"长安市上僦楼居，闲里身心尽自如。\n十日雨声春对酒，一窗镫影夜观书。\n茶经未展愁先醒，药录才看病已除。\n所欠短檐晴景好，拆桐花月共扶疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63653,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山中哭复斋","author":"高翥","text":"封章字少纳忠多，袖疏前陈无柰何。\n但得中天行日月，不愁平地起风波。\n台官论罪终投笔，山贼闻名亦倒戈。\n惆怅脊梁如铁硬，天胡忍使閟山河。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63654,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山行即事","author":"高翥","text":"篮舆破晓入山家，独木桥低小径斜。\n屋角尽悬牛蒡菜，篱根多发马兰花。\n主人一笑先呼酒，劝客三杯便当茶。\n我已经年无此乐，为怜身久在京华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63655,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"门径","author":"高翥","text":"门径萧然独自居，入无给侍出无车。\n江湖故旧音尘绝，里巷游从酒盏疏。\n豪举已抛三尺剑，神交惟有一床书。\n吾兄白发家空谷，岁晚灯前最忆渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63656,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元日","author":"高翥","text":"长忆儿时二老傍，元正岁岁有风光。\n搀先礼数修人事，着好衣裳侍酒觞。\n回首不堪追日月，感情空叹换星霜。\n尚期我老如亲老，却看儿童作节忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63657,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"天台曹园","author":"高翥","text":"蔡岭桑麻地，曹家桃李庄。\n溪流春水滑，梅度晚风香。\n竹屋解留客，笋舆休俶装。\n平生看花法，不学蜜蜂忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63658,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"天衣寺","author":"高翥","text":"万壑千岩非浪闻，十峰双涧不须论。\n袈裟旋化空王服，宫殿曾招帝子魂。\n山向马头回禹穴，溪分燕尾入云门。\n秋行既了登临愿，草草题诗对绿尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63659,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"天章寺","author":"高翥","text":"地胜秋清人欲仙，倚阑时节月初圆。\n不知寺在烟霞表，但觉身临星斗边。\n宝墨旧归天上去，高名今向世间传。\n登临莫作匆匆会，去后重来又几年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63660,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"忆西湖","author":"高翥","text":"西湖春二月，结客少年游。\n骏马黄金勒，长身紫绮裘。\n爱花论担买，嗜酒满船浮。\n两载缘何事，台州又越州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63661,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"无锡县春日","author":"高翥","text":"吴楚新岐路，江湖旧散人。\n放船来古县，沽酒供闲身。\n花卸一村雨，鸟啼千树春。\n野塘风捲地，无复见芳尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63662,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"兄寿弟","author":"高翥","text":"再岁佳辰捧寿卮，今年清梦浙江湄。\n鹡鸰地冷真堪□，鸿雁云飞会有时。\n芍药泛杯犹共醉，梅花照座可重期。\n直须千岁州成日，铜狄摩挲世自知。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63663,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"兰亭","author":"高翥","text":"老来浑不爱春游，来对兰亭烂熳秋。\n亭下水非当日曲，山前竹似旧时脩。\n二三客子因怀古，八百馀年续胜流。\n试与山灵论往事，不知还肯点头不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63664,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬日书怀用正甫韵","author":"高翥","text":"惯将双手托虚空，岁事虽穷道不穷。\n身健不知行路远，心安还与在家同。\n客携酒至一樽绿，兄寄书来三印红。\n看罢兄书斟客酒，闲愁无事置胸中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63665,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"古寺","author":"高翥","text":"山路荒凉出小亭，土墙斑驳带枯藤。\n攲斜古殿三尊佛，黯澹寒篝一点镫。\n碣石半磨天宝字，禅房空老政和僧。\n头陀礼拜迎人说，门外浮屠欠两层。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63666,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"古庙","author":"高翥","text":"古庙依乔木，开门对浅沙。\n短篱红槿树，深径碧苔花。\n屋破香烟湿，庭空日脚斜。\n山寒无赛鼓，鸣噪集神鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63667,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"叹息","author":"高翥","text":"叹息闲身不自如，长年借屋客中居。\n事多只为人情熟，贫甚还因世法疏。\n兄弟候归应有梦，交游散去更无书。\n攒心万感争催老，白发萧骚欲满梳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63668,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"归来","author":"高翥","text":"归来成倦客，随分乐闲居。\n供佛换新水，课儿温旧书。\n已荒三径菊，且种一园蔬。\n来往多邻舍，馀无长者车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63669,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"归寓舍","author":"高翥","text":"门前流水碧粼粼，岁晚归来亦可人。\n梅欲开时多是雨，草财生处便成春。\n娇儿对面两痴绝，老子关情一欠伸。\n快洗竹篘篘浊酒，举杯先为洗京尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63670,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"多景楼","author":"高翥","text":"一带青山欲尽头，精蓝深处着危楼。\n下无馀地容车马，上有重檐接斗牛。\n鸦落野田长趁晚，雁沉烟渚最宜秋。\n江南好景从来少，北望空多故国愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63671,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"竹楼","author":"高翥","text":"老竹平分当建瓴，小楼从此擅高名。\n地连云堞登临稳，栏俯晴江梦寐清。\n一记自能追正始，三閒谁与续咸平。\n涛音日日烟中落，依约焚香读易声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63672,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自赋","author":"高翥","text":"蜗角蝇头总是虚，何须留恋市朝居。\n老于亲戚情当密，贫与公卿分合疏。\n小涧草荒元种菊，故山尘满旧抄书。\n几时归去重料理，啸月眠云得自如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63673,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过方孚若寺丞故庐","author":"高翥","text":"诗境园林万柳閒，四围秋草带愁颜。\n楼台寂寞鼠成穴，岩石崔嵬蚊负山。\n三径昔嫌前辈窄，一区今欠此翁閒。\n客来莫怪匆匆去，万感催人鬓易斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63674,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]