[{"title":"拍栏","author":"赵汝燧","text":"偶把栏干拍，沙鸥水上惊。\n晚红残照在，秋碧远山横。\n尽被浮名役，皆从妄念生。\n不如归去好，杖屦老柴荆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45243,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"招贤渡溪阁晚望","author":"赵汝燧","text":"溪流清到底，十顷浸秋光。\n烟重山加色，风狂雁失行。\n尘埃双老鬓，天地几斜阳。\n何处一声笛，征人暗断肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45244,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"明皇","author":"赵汝燧","text":"初年不是不聪明，勤政开元致太平。\n一曲羽衣妃子进，三朝锦褓禄儿生。\n眼乾蜀道山川泪，胆碎渔阳鼙鼓声。\n祸福兴亡皆自取，信知女色解倾城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45245,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"沿檄宿虎山山家","author":"赵汝燧","text":"高低田水曲通池，小小人家短短篱。\n杜宇教唆春去早，阴云遮盖月明迟。\n年华只解催教老，公事从来了是痴。\n若不随缘强烦恼，谩添两鬓几茎丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45246,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泊卢家步","author":"赵汝燧","text":"泊舟葭苇岸，风唤夜凉生。\n天远星疑坠，秋清月倍明。\n倾杯浮蚁匝，把剑古蛟鸣。\n甚矣吾衰矣，功名念已轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45247,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泊舟","author":"赵汝燧","text":"前头无泊处，且住荻花林。\n水沸知滩浅，烟蜂花在瓶。\n呼童治茶具，有客扣柴扃。\n共说山林话，休嗟两鬓星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45248,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泊舟","author":"赵汝燧","text":"舟泊似差早，篙工爱酒坊。\n羊群归远陇，柳影恋斜阳。\n泽国人千里，暮霞天一方。\n茶多不思睡，渔唱听沧浪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45249,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泊舟周家步","author":"赵汝燧","text":"梢子商量乘早泊，向前十里不逢村。\n卸帆敛柁依山脚，系缆添桩傍树根。\n月魄知风昏有晕，秋光入水净无痕。\n五更露下欺孤枕，忽听新鸿更断魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45250,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泊舟黄家渡","author":"赵汝燧","text":"溪流暴涨舟如箭，夜向深湾稳处停。\n猛虎啸风威动壑，飞鸿过月影移汀。\n青山入梦催归棹，白发欺人叹暮龄。\n幸得还家玩光景，歠醨终日醉休醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45251,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"范园避暑","author":"赵汝燧","text":"六月暑如炊，追凉此地宜。\n棹舟荷柄飐，坐石竹阴移。\n筹贯壶双耳，鼎烹茶一旗。\n小童供笔砚，醉客竞赓诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45252,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"郊行同张宰","author":"赵汝燧","text":"雨晴郊外共寻芳，细水交流注野塘。\n花欲恋枝风不肯，柳才舞影日还藏。\n转添老态难于健，看得闲时少似忙。\n拟访一僧共茶话，禅房扃锁出游方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45253,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"郑氏庄","author":"赵汝燧","text":"庄居深僻处，敲户小童应。\n此地清如许，前时到未曾。\n柳腰金袅娜，苔发翠鬅鬙。\n山上茅亭子，扶衰为一登。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45254,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"金山","author":"赵汝燧","text":"自古称浮玉，更名为得金。\n一山藏寺腹，双塔立江心。\n淮浙中流断，风烟四岸侵。\n梦回禅榻悄，月午听龙吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45255,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"临川县治古桂两大株与叶潜仲邬文伯饮花下","author":"赵汝燧","text":"双桂相传久，百年殊未衰。\n树联铺叶密，根老著花迟。\n葩坠黏诗笔，香浓透酒卮。\n月中但孤影，安得两交枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45256,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"信步","author":"赵汝燧","text":"午窗方睡起，信步过东畦。\n穴徙蚁知雨，巢穿燕补泥。\n路坍连草没，果重压枝低。\n村妇抱儿子，笼边教唤鸡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45257,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春郊","author":"赵汝燧","text":"数点绿杨风，春光是处同。\n蜂喧搜蕊瘠，鸟闹聒山聋。\n联句逢诗友，寻僧问牧童。\n家家办农具，准拟试新工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45258,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夕","author":"赵汝燧","text":"秋风动梧井，无顿许多凉。\n夜静滩喧枕，窗开月到床。\n道心便冷淡，世事莫思量。\n只被浇花累，朝朝却用忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45259,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋日同王显父赵子野何庄叟泛湖赵紫芝继至分韵得秋字","author":"赵汝燧","text":"雨馀湖更爽，载酒共清游。\n天净倒涵水，峰高争献秋。\n风烟入吟笔，箫鼓自邻舟。\n堤上诗人过，相邀便肯留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45260,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夜怀归","author":"赵汝燧","text":"乡里千山月，尘埃两鬓星。\n秋声虽是爽，客耳不堪听。\n多泪风前烛，孤明竹外萤。\n吟蛩更亡赖，终夜几曾停。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45261,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋居","author":"赵汝燧","text":"入得秋来爽，何烦宋玉悲。\n推窗对脩竹，开卷课诸儿。\n世事放轻著，人生无足时。\n年多自当老，不用染吟髭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45262,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋意","author":"赵汝燧","text":"今年秋意早，夜傍井梧生。\n怪得雨声急，洗教山骨清。\n倚栏看叶舞，寻砌听蛩鸣。\n举目无非爽，吟诗易得精。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45263,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"胡教醵杯观画围棋","author":"赵汝燧","text":"山肴野蔌且随宜，约定同来最怕迟。\n朋友每思相聚乐，尘埃难得有闲时。\n春回画笔丹青轴，雹落文楸黑白棋。\n醉客坐间誇俊逸，掀髯连写数篇诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45264,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送仲久之京口","author":"赵汝燧","text":"才归又东去，且道几时还。\n算路亦差远，缘君不耐闲。\n江城登铁瓮，烟寺认金山。\n我昔经行地，诗牌挂壁间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45265,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送同年李教秩满归闽","author":"赵汝燧","text":"雁塔同题久，相看两鬓皤。\n功名皆分定，安乐直钱多。\n绛帐归来后，青山住得么。\n时流推老笔，册府欠编摩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45266,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送同官叶榷院造朝二首 其二","author":"赵汝燧","text":"满岁尘埃共，交情骨肉亲。\n我犹京口客，君已日边人。\n波及无忘晋，渠成亦利秦。\n西湖约携手，两岸柳摇春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45267,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送同官叶榷院造朝二首 其一","author":"赵汝燧","text":"新制重分司，谁云筦榷卑。\n鹏抟终可料，鴳笑彼何知。\n细满岂无待，横飞亦未迟。\n催班天上去，黄色已浮眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45268,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送沈推赴官婺女","author":"赵汝燧","text":"子抱风云志，吾同笔砚游。\n众皆尊大手，老尚客诸侯。\n清逼双溪水，句涵三洞秋。\n俭僚非所处，有路在瀛洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45269,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送奇仲过霅川","author":"赵汝燧","text":"少年湖海气，近又负诗名。\n今忽担簦去，谁非倒屣迎。\n雨茶烹顾渚，春酒醉乌程。\n有句茅亭著，蘋风洲上生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45270,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送宗上人归闽","author":"赵汝燧","text":"顶笠遍参请，平生志甚勤。\n耳方离岳瀑，眼已接闽云。\n宿岭星辰近，渡溪烟雾分。\n劝师早休歇，禅不在多闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45271,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送彦东还湘","author":"赵汝燧","text":"湖南多爽处，羡子片帆还。\n秋影清涵水，烟痕淡著山。\n兰风香楚佩，竹泪冷湘斑。\n见说诛茅地，江头只数间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45272,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送曹深叟之越","author":"赵汝燧","text":"几时重握手，未可便轻离。\n路指千岩去，程宽一月期。\n扪萝窥禹穴，剥藓读曹碑。\n必自兰亭过，方当春暮时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45273,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送端叔游淮","author":"赵汝燧","text":"堂堂玉立须垂腹，谈论逢人见肺肝。\n手弄七弦琴韵古，腰横三尺剑光寒。\n但将计策寻知己，肯学闾阎为觅官。\n乌幕闻君定罗致，别樽不复话儒酸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45274,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送聪上人归四明","author":"赵汝燧","text":"办得四方游，孜孜讨入头。\n归云起斋钵，高浪送行舟。\n笠戴天童雨，鞋穿雪窦秋。\n平常心是道，莫更问人休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45275,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送翼之过天台","author":"赵汝燧","text":"天台山水窟，人道是仙家。\n白鹤挂寒溜，赤城飞暮霞。\n独携筇杖过，莫畏石桥斜。\n牢记经行处，归来向我誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45276,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻舟中笛","author":"赵汝燧","text":"横笛秋篷底，衔山夕照残。\n孤音起水面，馀韵到云端。\n吹怨芦声惨，含悽雁影寒。\n有人江阁上，敛翠凭栏干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45277,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"倚楼","author":"赵汝燧","text":"蒹葭秋色晚，百尺倚江楼。\n日暗烟藏寺，风高浪拍舟。\n归云投远岭，饥雁叫沧洲。\n心事非年少，尘埃白尽头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45278,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏日普信寺江阁","author":"赵汝燧","text":"到此全无暑，虚栏千里风。\n看飞云度水，听落石鸣空。\n日月忙乌兔，春秋递燕鸿。\n一生尘里过，烟艇羡渔翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45279,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏夜","author":"赵汝燧","text":"今夕暑差甚，芒鞋阶下行。\n除灯檐月上，却扇竹风生。\n病骨坐怕久，静吟诗易成。\n夜凉思睡去，楼鼓已三更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45280,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏夜与东叔昆仲小酌","author":"赵汝燧","text":"入夏不为浅，亭虚未甚炎。\n云收风卷幕，月满夜开奁。\n怕热移灯远，开怀索酒添。\n半酣诗兴动，写韵客分拈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45281,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"旅次春眺","author":"赵汝燧","text":"独倚危栏春意远，本无情绪强登临。\n一眉晚拂晴山黛，万缕风摇岸柳金。\n久负故园泉石约，恍惊老鬓雪霜侵。\n两年双脚数千里，奔走尘埃损道心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45282,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"流杯池","author":"赵汝燧","text":"分得兰亭胜，今才二十年。\n飞觞流石罅，曲水出天然。\n古意欠修竹，清香足旧莲。\n嶙峋裂奇怪，两兽卧山边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45283,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"留客","author":"赵汝燧","text":"阔疏方在念，飞盖忽相过。\n酒缺邻堪觅，诗成子自哦。\n添羹挑野菜，包鲊就池荷。\n莫屡辞归去，馀樽亦不多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45284,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"翁灵舒客临川因经从访之不遇闻过村居","author":"赵汝燧","text":"闻道深村里，结茅三四间。\n买田因种秫，移树为看山。\n诗好人皆诵，身安心自闲。\n有时思雁荡，依旧棹舟还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45285,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蚕舍","author":"赵汝燧","text":"每到蚕时候，村村多闭门。\n往来断亲党，啼叫禁儿孙。\n不惜兼旬力，将图终岁温。\n殷勤马明祝，灯火谨朝昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45286,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"途中","author":"赵汝燧","text":"雨中奔走十来程，风卷云开陡顿晴。\n双燕引雏花下教，一鸠唤妇树梢鸣。\n烟江远认帆樯影，山舍微闻机杼声。\n最爱水边数株柳，翠条浓处两三莺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45287,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"郴州鹿鸣宴","author":"赵汝燧","text":"连科已占十名前，行听鸿胪第一传。\n我俟合符留劝驾，君能摛藻预兴贤。\n湘山点化名千佛，郴岭飞升效九仙。\n此去琼林天上宴，今朝先赋鹿鸣篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45288,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宿山观","author":"赵汝燧","text":"昏暮无处宿，樵人指路头。\n仆夫皆已困，道士幸相留。\n明月夜翻昼，阴崖暑变秋。\n闻鸡便行路，定要到潭州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45289,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宿方家店","author":"赵汝燧","text":"昏暮方投宿，敢嫌茅屋低。\n池清月易入，林密鸟争栖。\n买酒春篘瓮，求蔬夜摘畦。\n路长莫贪睡，嘱仆早听鸡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45290,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宿古寺","author":"赵汝燧","text":"黄昏投寺宿，古屋瞰荒江。\n村酒沽春瓮，山房耿夜釭。\n滩高声撼枕，月落影收窗。\n僧老人皆玩，楼钟晓未撞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45291,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宿溪馆","author":"赵汝燧","text":"投宿溪头馆，途长主仆饥。\n湿薪难便著，恶米更须筛。\n风细帆来稳，山高月上迟。\n客怀正悽恻，渔笛蓼洲吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45292,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宿横山","author":"赵汝燧","text":"颇厌东征道路长，回头十日离乡邦。\n扫愁酌酒虽云独，照影挑灯却暂双。\n打并馀花风动地，迁延残夜月留窗。\n店鸡已唱催人起，更听疏钟隔水撞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45293,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄友人","author":"赵汝燧","text":"口信传商贾，年前未得归。\n湘沅淹异县，日月老征衣。\n骚兴遍芳渚，旧栖闲钓矶。\n思君不可见，独自立斜晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45294,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄卢司户","author":"赵汝燧","text":"寂寞卢司户，诛茅楚水东。\n几年与君别，一字不余通。\n钓水空烹鲤，行汀屡扣鸿。\n梦魂还可托，握手片时同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45295,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"崇真观东轩","author":"赵汝燧","text":"东轩面水枕山阿，左右云烟湿翠萝。\n风度鹤声闻远壑，日移松影转前坡。\n愁来独靠清樽遣，老去休憎白发多。\n道士罢琴挥醉笔，诗成自唤小童哦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45296,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"常山道中","author":"赵汝燧","text":"寒谢春才展，匆匆二月中。\n算来晴几日，多是雨兼风。\n烟草迷村碧，山桃夹竹红。\n浮名能役我，策马几回东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45297,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚兴","author":"赵汝燧","text":"是处牛羊下，喧哗走牧童。\n霁烟拖淡碧，夕照殒残红。\n老鬓日添雪，衰躯晚怕风。\n愁来无著处，分付酒杯中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45298,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚征","author":"赵汝燧","text":"回首家山已十程，摇鞭自笑苦劳生。\n云先带暝岩边宿，月独伴人溪上行。\n草屋停骖难可意，店翁叱犬不容声。\n明朝路远起须早，第一鸡啼是五更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45299,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚泊","author":"赵汝燧","text":"篙师言已晚，岂可更贪程。\n风起且须泊，滩多未易撑。\n星河明夜色，葭苇撼秋声。\n回首人千里，通宵梦不成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45300,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清明小饮","author":"赵汝燧","text":"草草清明饮，惠风天气和。\n身轻梁燕舞，舌巧柳莺歌。\n但道三春好，其如两鬓何。\n升沉付杯酒，由命不由他。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45301,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"维舟","author":"赵汝燧","text":"望见人家了，犹须转一坳。\n寺从滩背出，船向柳边捎。\n问酒寻溪馆，呼儿解腊包。\n三杯亦径醉，世事且权抛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45302,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"野步","author":"赵汝燧","text":"雨收日薄春容嫩，步步东风桃李蹊。\n香递深林疑麝过，声传幽谷认莺啼。\n路摧迂步行荒草，桥断褰裳涉浅溪。\n归遇田翁醉邀我，旋教买酒旋烹鸡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45303,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"野望","author":"赵汝燧","text":"一天秋色远，千里病眸宽。\n野旷牛羊小，楼高风露寒。\n扫愁嫌酒薄，少事欲心安。\n溪友门前过，留鱼荐晚餐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45304,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪中寻僧","author":"赵汝燧","text":"寻僧同踏雪，握手上钟楼。\n初下寒飘屑，才浓风辊毬。\n水波糊纸閤，春乳泛茶瓯。\n片片看来好，庞公有话头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45305,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪后徐广文招同官小集分韵得明字","author":"赵汝燧","text":"瞰江亭馆约登临，雪后凭栏景倍清。\n波面玉虹千丈霁，寒边冰镜十分明。\n放怀共恨添杯少，分韵俄惊击钵成。\n对弈不知谁胜败，醉中但听子丁丁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45306,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"黄干见约小饮就宿","author":"赵汝燧","text":"病后何人慰寂寥，长须持简忽相招。\n溪山见说为楼爽，杖屦宁辞去郭遥。\n柳絮一天晴舞雪，松声十里夜闻潮。\n谈诗直到疏钟动，酒困频将茗椀浇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45307,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游目","author":"赵汝燧","text":"游目林坰信马蹄，十来家住小桥西。\n浮沉野水看晴雁，唱和茅檐听午鸡。\n菜要遮栏增旧堑，田分荫注作新堤。\n年丰米贱人人乐，农父相逢醉似泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45308,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游曹园","author":"赵汝燧","text":"先登东畔高亭子，洗却胸襟万斛尘。\n落片玉残梅兴尽，旧梢金吐柳芽新。\n倚林困鹤聊休足，巡食饥乌不避人。\n尚欲徘徊已灯火，归驺屡趣入城闉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45309,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"湖亭夜饮会别友人","author":"赵汝燧","text":"每闻嗟叹无知己，定要携琴过浙东。\n莫讶醵樽俱草草，只因束担去匆匆。\n竹筛夜影千竿月，荷送湖香万朵风。\n早晚我寻京口戍，子归或遇半途中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45310,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"琳宇","author":"赵汝燧","text":"琳宇栖岩谷，翛然一径深。\n风篁竿戛玉，霜橘颗垂金。\n是院皆扃户，无人但听琴。\n绕廊行数匝，聊以洗尘心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45311,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]