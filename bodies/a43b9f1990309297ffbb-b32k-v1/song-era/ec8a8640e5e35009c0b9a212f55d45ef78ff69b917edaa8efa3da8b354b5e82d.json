[{"title":"庐山道中 其七","author":"李彭","text":"不识西湖林处士，饱闻阴木叫钩辀。\n茂陵遗藁今应在，索价虽高未肯酬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":868,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"庐山道中 其八","author":"李彭","text":"英姿秀骨徐尚书，忠义丹青那可图。\n褒鄂真成毛发动，犹将生气压曹蜍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":869,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"北斋两绝句 其一","author":"李彭","text":"芭蕉叶大雨声催，叶底繁花菌蠢开。\n欲据胡床呼作炙，膳夫何用探心来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":870,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"北斋两绝句 其二","author":"李彭","text":"烟沙茂密小池塘，注水枯荷馥晚凉。\n何许蜻蜓立荷盖，惊飞作伴过东墙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":871,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"对雪有怀庐山道中","author":"李彭","text":"傍窗幽鸟语匆匆，云阵群山雪辊风。\n信有农谈四邻久，隔篱烟火醉眠中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":872,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自和六绝句 其一","author":"李彭","text":"丽日暄风下大荒，百花气暖汉宫香。\n携幼来寻竹间寺，游丝寂寂绕回廊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":873,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自和六绝句 其二","author":"李彭","text":"金屑琵琶刺绣裙，弦弦软语怨昭君。\n仍年病著屏杯盎，酒兴多于出岫云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":874,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自和六绝句 其三","author":"李彭","text":"水荇芦芽相纬经，倦飞翠碧暂来停。\n含毫未下无新句，安得毫端飞迅霆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":875,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自和六绝句 其四","author":"李彭","text":"蛙鸣废沼弄妍姿，破梦起看星斗垂。\n度曲安能当鼓吹，洒灰那复计官私。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":876,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自和六绝句 其五","author":"李彭","text":"边腹从来不贮愁，归鸿目送颇悠悠。\n三吴何用忧狼顾，一战行看擒狗偷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":877,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自和六绝句 其六","author":"李彭","text":"二季苍颜催我老，年过四十眼犹明。\n细字未能妨老读，每逢佳处胜专城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":878,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再和 其一","author":"李彭","text":"清朝画省得名郎，嚼麝高谈百和香。\n水镜欣传佳吏部，更须端委侍岩廊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":879,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再和 其二","author":"李彭","text":"仇池仙伯烟霄外，妙出湖州写墨裙。\n昼永虚斋风动壁，枝枝叶叶欲生云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":880,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再和 其三","author":"李彭","text":"刘侯白发续群经，原夜怜渠不少停。\n赍恨沈王今已矣，那知为电复为霆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":881,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再和 其四","author":"李彭","text":"圭璋挺特晁夫子，家法文章万代垂。\n却袖当年医国手，磨铅起例只营私。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":882,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再和 其五","author":"李彭","text":"且复持觞歌莫愁，点衣柳絮晚悠悠。\n要知境静自心远，不是年衰成语偷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":883,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再和 其六","author":"李彭","text":"平生爱花被花恼，况复杂花川上明。\n剑外参谋诗满眼，乞灵何必锦官城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":884,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"同季敌弟过南岸野寺","author":"李彭","text":"杨花糁径雪缤纷，短艇横江烟草昏。\n小雁俱来觅春事，情知春过水南村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":885,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"数日阴雨怀李生 其一","author":"李彭","text":"衣裾兰茝有馀清，风骨冰霜照眼明。\n欲共阿戎谈绝倒，亦憎暮雨滴阶声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":886,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"数日阴雨怀李生 其二","author":"李彭","text":"文楸玉子知无敌，愧我元非王积薪。\n愿赋烟茶不堪剪，风流文物不无人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":887,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"数日阴雨怀李生 其三","author":"李彭","text":"燕颔应须游玉关，归来绿发看峨冠。\n他时烂醉红鹦鹉，更跨追风乌贺兰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":888,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戏刻真牧堂竹间","author":"李彭","text":"风微雨细花梢动，日落钟鸣雀语多。\n未有池塘春草句，戏成户外竹枝歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":889,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"小憩琵琶亭呈环中养正 其一","author":"李彭","text":"南楼岑绝冠湖外，举扇每避元规尘。\n庾公楼下落帆处，掀簸定为公所嗔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":890,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"小憩琵琶亭呈环中养正 其二","author":"李彭","text":"超超迈俗郭有道，育孤事嫠如古人。\n莫言壁立贫至骨，鸡黍自是延嘉宾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":891,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"小憩琵琶亭呈环中养正 其三","author":"李彭","text":"山南濩落苏季子，饮作江潮雪阵来。\n想到诗肠应作祟，挽回妙语如琼瑰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":892,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山郭遇郑禹功行县","author":"李彭","text":"广文官冷饭不足，行县符移秖屡催。\n邂逅班荆作吴语，风姿峭峭绝纤埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":893,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"清晓登无相浮屠上有东坡书","author":"李彭","text":"窈窈龙蛇穴窟宽，淮山楚水绕栏干。\n儋州宰木应摇落，八法犹参星斗寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":894,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"舟中戏作俳体 其一","author":"李彭","text":"皎齿青娥倚柁楼，楚波微动晚风秋。\n不辞自去迎桃叶，两桨还须送莫愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":895,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"舟中戏作俳体 其二","author":"李彭","text":"目成可意亦不浅，思是罗敷旧姓秦。\n莫道使君自有妇，愿为解佩汉皋人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":896,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"茯苓","author":"李彭","text":"忆昨舍边松雪明，于今偃盖入青冥。\n何时容我携长镵，翻动龙蛇取茯苓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":897,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"老坡自海外归为书简寂观云卿閤榜今为煞风景者毁之","author":"李彭","text":"笔底飓风吹海波，榜悬郁郁照岩阿。\n十年呵禁烦神物，奈尔焚琴煮鹤何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":898,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戏书 其一","author":"李彭","text":"虐雪饕风春事晚，轻红未放入夭桃。\n即看倚杖花经眼，便许堆盘黍雪毛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":899,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戏书 其二","author":"李彭","text":"晴檐已复听提壶，浊酒聊堪释荷锄。\n短短长长爱园柳，三三两两数溪鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":900,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戏书 其三","author":"李彭","text":"渫井寒泉彻底清，不容私地有蛙鸣。\n修除何独充庖易，要看箨龙将雨行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":901,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戏书 其四","author":"李彭","text":"止酒废诗春昼长，颇知易戒复难忘。\n戏于窗下还诗债，便欲花前唤索郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":902,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵文潜立春三绝 其一","author":"李彭","text":"腊前漏泄有官梅，春色悬知里许回。\n日涉园中聊步屧，黄菘早韭复争开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":903,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵文潜立春三绝 其二","author":"李彭","text":"后皇司春生意还，无知草木亦班班。\n顾怜绿发添华发，羞插耐寒花上幡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":904,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵文潜立春三绝 其三","author":"李彭","text":"举酒徵贤且合姻，盘飧野菜斗尝新。\n阳春有脚今谁是，始觉前朝贵老身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":905,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"延福寺","author":"李彭","text":"寻尽云山发兴多，稍知兰若在岩阿。\n不以姬姜弃憔悴，杖藜聊复一来过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":906,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"齐安江头别何氏兄弟舟中得四绝句 其一","author":"李彭","text":"疏星牢落散江东，怅望夷犹醉眼中。\n长年三老相欺得，故将短棹指西风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":907,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"齐安江头别何氏兄弟舟中得四绝句 其二","author":"李彭","text":"八字山头阅世故，周郎赤壁断人肠。\n玉鱼金枕皆冥寞，铁骑楼船堕渺茫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":908,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"齐安江头别何氏兄弟舟中得四绝句 其三","author":"李彭","text":"乐群野鹜巧相依，旁母凫雏肯浪飞。\n怪底相连若耆旧，无人花鸟自忘机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":909,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"齐安江头别何氏兄弟舟中得四绝句 其四","author":"李彭","text":"岩岩五老古须眉，似对幽人歌采薇。\n汉事烦公即调护，蒲轮飞诏盍来归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":910,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"留别小庆","author":"李彭","text":"风催万壑雨归去，云闭连峰不放晴。\n门外从教春水阔，杖藜准拟听江声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":911,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"二绝 其一","author":"李彭","text":"过尽柳花无复绵，几畦麦浪涨晴川。\n幽禽唤起醉乡梦，疑在故园茅屋边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":912,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"二绝 其二","author":"李彭","text":"生绡他日写荒寒，咫尺浑如万里宽。\n我据笋舆烟雾里，有人应作画图看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":913,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"对酒二首 其一","author":"李彭","text":"颇欲持觞为上顿，直疑买醪成大偷。\n盎中曲蘖可肥遁，不比终南猿鸟愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":914,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"对酒二首 其二","author":"李彭","text":"雄猜刻薄王处中，不饮思欲诛蛾眉。\n何如一醉睨万物，小黠向来成大痴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":915,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梦秦处度持生绢画山水图来语予此画刘随州诗也君为我作诗书其上梦中赋此诗","author":"李彭","text":"随州句法自无敌，写作无声绝妙词。\n谁料长城千载下，秦郎复出用偏师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":916,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"岁晚四首 其一","author":"李彭","text":"天长候雁作行远，沙晚浴凫相对眠。\n松醪朝醉复暮醉，江月下弦仍上弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":917,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"岁晚四首 其二","author":"李彭","text":"汪侯胸次阔潇湘，秀润清时符宝郎。\n谢宇窗间仍发兴，敬亭山下屡成章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":918,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"岁晚四首 其三","author":"李彭","text":"苦忆中州向子期，微官镌尽赋新诗。\n清班未许联天仗，直指聊看著绣衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":919,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"岁晚四首 其四","author":"李彭","text":"眼看杨柳涨春风，忽复山明雪映松。\n但把一尊扶醉病，何须三揖送文穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":920,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"茅堂清坐有怀元亮","author":"李彭","text":"不到青园三月馀，行间茂密见新蔬。\n最怜鼠迹生尘案，复有潜筠穿我庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":921,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"有怀雪堂旧游 其一","author":"李彭","text":"雪堂杨柳三五株，堂里先生万世无。\n伐树何人成粪土，如闻筑屋复栖乌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":922,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"有怀雪堂旧游 其二","author":"李彭","text":"柱史秦郎无检幅，笔端真有大夫辞。\n追怀耆旧谁能继，况复赏音黄绢碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":923,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"有怀雪堂旧游 其三","author":"李彭","text":"张侯赡蔚气如虹，字字追还西汉风。\n歆向俱为泉下士，辞林正派绝流通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":924,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"有怀雪堂旧游 其四","author":"李彭","text":"陈子真成病乘黄，圜丘一仆殆堪伤。\n苦吟幽语多奇涩，未免人讥急就章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":925,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"有怀雪堂旧游 其五","author":"李彭","text":"柯陂潘子骨已冷，文采风流付陆云。\n不见十年应好在，酒浇边腹贮皇坟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":926,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"有怀雪堂旧游 其六","author":"李彭","text":"珍重何家大小山，高文丽赋敌扬班。\n书来慰藉江头别，想见园林人外闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":927,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"离曲池憩巾口 其一","author":"李彭","text":"小泊曲池桑柘阴，远墙岑寂伴高吟。\n孤云两角真在梦，一抹寒林古木深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":928,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"离曲池憩巾口 其二","author":"李彭","text":"野僧亦复稻畦衣，两两三三巾口归。\n拂拭涪翁刑部句，晚风吹泪对斜晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":929,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"离曲池憩巾口 其三","author":"李彭","text":"物色真成行画图，十年对面不供书。\n才悭更著李商隐，无复重讥獭祭鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":930,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"林占处士和靖先生之孙也与予厚善今死矣作雨绝句吊之 其一","author":"李彭","text":"爱君浑似金华客，谓我犹堪供奉班。\n萧寺愚溪两冥寞，一尊聊复对西山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":931,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"林占处士和靖先生之孙也与予厚善今死矣作雨绝句吊之 其二","author":"李彭","text":"危脆芭蕉何足道，姓名今不减西湖。\n茂陵遗稿他年在，宁有书言封禅无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":932,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"久不得六弟消息二绝 其一","author":"李彭","text":"去日么荷拳未舒，水花高盖已扶疏。\n大医法窟应寻遍，有底能忘一纸书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":933,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"久不得六弟消息二绝 其二","author":"李彭","text":"平生大敌刘文叔，每发一兵鬓为苍。\n不得淮南近消息，萧然添我鬓毛霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":934,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游云居寺三绝 其一","author":"李彭","text":"茗椀薰炉久不来，晓猿夜鹤总相猜。\n故将野老扶衰杖，踏破山家称意苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":935,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游云居寺三绝 其二","author":"李彭","text":"去年重失洪崖约，今日又寒徐稚盟。\n胜日幽期无恶客，寻僧银色界中行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":936,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游云居寺三绝 其三","author":"李彭","text":"燕坐身游水晶城，梦回心净玉壶冰。\n更听夜雨檐花落，却是细泉幽窦倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":937,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"代二螯解嘲","author":"李彭","text":"臞儒他日倦龟壳，蛤蜊自可破愁颜。\n不似二螯风韵好，那堪把酒对西山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":938,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"解嘲 其一","author":"李彭","text":"平生痴绝百无忧，党友相嘲顾虎头。\n痴黠胸中各相半，要之与我不同流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":939,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"解嘲 其二","author":"李彭","text":"丘林久矣自耘锄，罕识心劳瓜芋区。\n不复论文传幼妇，安能索笔著潜夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":940,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"西隐观","author":"李彭","text":"书签无复梁萧统，像设空馀谭紫霄。\n驯鹿将麑眠药圃，归云带雨度山椒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":941,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"离豫章进贤道中","author":"李彭","text":"春在江村桑柘中，多情十日雨兼风。\n杜鹃北向劝归去，我为故人聊复东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":942,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"招隐亭","author":"李彭","text":"袅袅秋风生桂枝，小山岩壑石逶迤。\n王孙归去岁将晏，莫学臞儒炊扊扅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":943,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"邻鸡","author":"李彭","text":"邻鸡午唱静中哗，挟雨苍苔傲落花。\n已觉星星鬓边出，真成一倍惜年华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":944,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"醉中戏次师言韵兼简少逸 其一","author":"李彭","text":"不觉庞公隐鹿门，逢场作戏任吾真。\n风烟久著双蓬鬓，脱帽公应恕醉人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":945,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"醉中戏次师言韵兼简少逸 其二","author":"李彭","text":"笔下疾雷惊四邻，勒兵小试颂声新。\n司空城旦馀波尔，六籍纷纶井大春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":946,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]