[{"title":"正月十六夜大雪次张守诸公韵二首 其一","author":"陈造","text":"阳阖阴开意莫穷，东君衒巧似良工。\n红莲熄燄人收市，丹杏开时雪滚风。\n韵语真宜咏飞絮，短歌当有颂元丰。\n一番壮观俄漂忽，已落诗人卷轴中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19113,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"正月十四日雪","author":"陈造","text":"乡园灯市颇豪奢，客子扁舟恰到家。\n月姊层云藏宝鉴，雪神千手扑天葩。\n未容火树陪宵燕，谩说江梅擅岁华。\n苦忆醉穿罗绮阵，小軿吟度赤城霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19114,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"正仲和帅属被盗二首 其二","author":"陈造","text":"向来忠信倚垣墙，诲盗如今坐慢藏。\n望意漫言疑圣智，奇文不合吐光芒。\n玉川空屋遭窥瞰，子敬青毡果在亡。\n赖有平生千牍在，未妨捃载作归装。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19115,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"正仲和帅属被盗二首 其一","author":"陈造","text":"衣囊缄鐍竟胡为，祇与偷儿便挈携。\n髻重得无猜祖珽，璧亡遮莫议张仪。\n馆人求屦古未免，有力负山人得知。\n不用经营办春服，旧纫兰芷扈玄蓠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19116,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"正觉寺","author":"陈造","text":"细穿诘曲上高寒，一鹫青冥杳霭间。\n栏楯攲浮沧海影，东南重见紫金山。\n方壶入眼鲸堪跨，璧月依人桂易攀。\n闻说老禅佳寝饭，一生无梦落尘寰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19117,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用赠朴翁旧韵二诗送徐南卿南归 其一","author":"陈造","text":"飞鹏尺鴳计穷通，今古幽人一笑中。\n等是劳生浮大块，谁能诡遇诧良工。\n书堪引睡聊遮眼，酒可祛愁胜作公。\n此意平章有同社，绝怜相望马牛风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19118,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用赠朴翁旧韵二诗送徐南卿南归 其二","author":"陈造","text":"莫将半菽羡千钟，生世谁非囿数中。\n荐福议碑雷已震，浩然遌意句徒工。\n我知寒饿怜颜阖，人说乘除有志公。\n穷鬼趁渠来败类，秋禾一昔仆霜风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19119,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"石城","author":"陈造","text":"山岩水缭石为城，千古馀风尚典刑。\n竞诧君王启蓝缕，不无艇子载娉婷。\n流连犹问圭堪柲，兆朕虚传蜜作萍。\n更惜谗锋发兰尚，祇今日月炳骚经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19120,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"石湖生日致语口号","author":"陈造","text":"寿筵高敞老仙家，帘影中间五色霞。\n碧酒旧须麟作脯，雕盘新荐枣如瓜。\n玉壶缥缈非尘世，金狄依稀记岁华。\n胜日年年攲醉帽，鬓香长点吉云花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19121,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"立春","author":"陈造","text":"春信葭灰动，寻知寒事休。\n光阴从冉冉，身世判悠悠。\n鬓影看银胜，官期志土牛。\n羸骸更元命，惜为斗升留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19122,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"立春前一夕雪二首 其二","author":"陈造","text":"雪龙侵夜正衔枚，破晓郊原玉作堆。\n云叶攀翻徒自舞，瑶花顷刻为谁开。\n土膏已遽宜农事，綵胜何妨映酒杯。\n幻作冰壶天一噱，梦回品物各春台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19123,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"立春前一夕雪二首 其一","author":"陈造","text":"天仙几夜集瑶台，剪水筛琼不受催。\n直遣瑞花将腊去，尽驱和气与春回。\n坐窗客有吟飞絮，对酒人应唱落梅。\n雪与相如俱末至，可能草赋压邹枚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19124,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"交割州事致语口号","author":"陈造","text":"一时律吕韵金丝，用播中和乐职诗。\n所喜玳筵重启日，还当璧月再圆时。\n伊凉聒夜铿千杖，兰蕙回春艳十眉。\n明日酒醒还得句，东游夸与大堤儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19125,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"任满交割郡事致语口号","author":"陈造","text":"星屏已喜一樽俱，嗣启芳筵合郡符。\n袅袅细香生玉醴，飔飔凉吹度冰壶。\n锦纹眩旋明回雪，云影依微觅贯珠。\n乘醉言分当卜夜，火城璧月共通衢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19126,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"任满交割倅事致语口号","author":"陈造","text":"黄堂冰峙两飞仙，不遣纤尘到绣筵。\n龙麝香中挥玉麈，蕙兰丛里釂金船。\n即今别乘符初合，伫看丹墀璧再联。\n来岁凉飔生殿阁，帝觞同捧听钧天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19127,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再口占次韵","author":"陈造","text":"君家朱閤隔嚣尘，可欠宾筵兰蕙春。\n横草定铭鞮汗石，穿杨新赐上方银。\n几时酾酒招嘉客，不假倾囊得丽人。\n莫坐风悭仍雨涩，祇将诗笔诧无邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19128,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再用前韵赠高司理共八首 其八","author":"陈造","text":"帝旅曾观武事扬，如君文势整堂堂。\n了知一笔无前古，坐遣诸生丧所长。\n丹桂高攀霄汉迥，捷书西下姓名香。\n贝宫鳌禁应馀地，看展平生补衮章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19129,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再用前韵赠高司理共八首 其七","author":"陈造","text":"腰钱几夜梦维扬，上雨傍风祇此堂。\n人笑铅刀那用割，自知袜线岂能长。\n课诗坛畔独飞动，问字人来且碧香。\n径欲披衣还旧隐，二天宁久溷苏章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19130,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再用前韵赠高司理共八首 其六","author":"陈造","text":"苏李宗风我举扬，少陵公按子开堂。\n官曹此地文书省，诗社从今日月长。\n山滴晓烟收后翠，莲漂天女戏时香。\n可孤煮饼分彊韵，正使铜花涩印章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19131,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再用前韵赠高司理共八首 其五","author":"陈造","text":"俗里毫丝起抑扬，请君时闭读书堂。\n渭清肯混泾流浊，凫短徒忧鹤胫长。\n千载流传防造次，百年表立要馨香。\n了知此印君堪付，过眼尨凉忽报章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19132,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再用前韵赠高司理共八首 其四","author":"陈造","text":"诗语庸非自播扬，流传朋旧定哄堂。\n儒书投老空成癖，舞袖平生不解长。\n黄鸟啄残丹杏颗，清风摇动绿筠香。\n山城寂寞便吾懒，劣胜精神弊句章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19133,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再用前韵赠高司理共八首 其三","author":"陈造","text":"衰宗如此况他扬，碌碌诸雏欠肯堂。\n薄宦幽忧殊未醒，故园归梦可胜长。\n杯盘顿顿家鸡嫩，翁媪呜呜社酒香。\n犹记比邻笑行客，夏畦龙断为金章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19134,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再用前韵赠高司理共八首 其二","author":"陈造","text":"帅幕群才赖激扬，衰迟犹喜后升堂。\n雷封局缩聊偿债，衮字褒嘉但寸长。\n再试真成不龟药，九言终佩辟邪香。\n龙门梦断谁知己，几诵桑阿赋末章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19135,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再用前韵赠高司理共八首 其一","author":"陈造","text":"少年场里独鹰扬，他日悬知玉作堂。\n小试问囚穷两造，徐看载笔擅三长。\n得诗遽眩珠玑烂，玩味还疑齿颊香。\n风月无穷才不尽，坐须乔木拥千章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19136,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再用韵寄丁知县三首 其三","author":"陈造","text":"别时把酒欲沾襟，楚翼吴鳞要嗣音。\n撞玉餍听辞客语，断金深得故人心。\n对床风雨终前约，满眼湖山念独吟。\n何日水云淮上宅，草荒三径肯深寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19137,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再用韵寄丁知县三首 其二","author":"陈造","text":"南楼酌酒未分襟，啅鹊啼乌亦好音。\n晴日倒红生笑颊，烟梧摇渌涨杯心。\n可堪岁月供行色，尽把江山博醉吟。\n不继芜湖留十日，焦峰浮玉恣幽寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19138,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再用韵寄丁知县三首 其一","author":"陈造","text":"旗亭风月小披襟，慰我东归听足音。\n潮水去来当有信，岫云出入自无心。\n酒杯乘兴从妨梦，诗律缘愁久废吟。\n明日扬舲回白首，烟横北固棹千寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19139,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次习池诗韵寄程帅二首 其二","author":"陈造","text":"春意垂垂如我老，客怀领略欠当时。\n倏惊鶗鴂鸣清昼，便有蜻蜓点碧池。\n酒榼相过但溪友，锦囊馀几问庐儿。\n芳辰渠尽人离索，苦念从公乘烛嬉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19140,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次习池诗韵寄程帅二首 其一","author":"陈造","text":"南园胜绝真堪画，边上谁为李伯时。\n山纳嫩岚侵密坐，花骈红影闯清池。\n吟笺传遍鸳鸿友，舞袖轻于翡翠儿。\n东府西州皆四釜，若为长伴酒边嬉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19141,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次张丞韵","author":"陈造","text":"龙职阴晴肯转圜，寒侵春事倍常年。\n弥旬稔听盆翻雨，一室何殊瓮里天。\n多病可堪严酒戒，高舂未慭枕书眠。\n忘忧蠲忿疑无策，小草论功亦浪传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19142,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次杨宰游土山韵","author":"陈造","text":"志公岩顶云萦绕，罗汉洞前山郁盘。\n鲧禹镌镵那用许，乾坤包纳若为宽。\n我行六月犹春服，谁遣千岩起暮寒。\n思与三花古仙伯，往还游戏辔青鸾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19143,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次前韵二首 其二","author":"陈造","text":"起柁扬帆趁便风，狎鸥惊雁水烟中。\n裹香荐彘聊随俗，计日听鸡等自公。\n诗句涤愁收一一，酒杯浇别悔匆匆。\n与君二纪陈雷契，犹遣时人笑两穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19144,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次前韵二首 其一","author":"陈造","text":"解缆征涂一怆神，房陵十舍望西秦。\n苦无勋业裨昭代，久分江湖著老身。\n三楚上游常定伯，六朝陈迹渺愁人。\n不缘俛仰悲凉甚，可博临风得句新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19145,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次赵侯韵","author":"陈造","text":"理窟疏明面面通，如君襟抱古贤同。\n孤标碧落行霜月，胜韵芳林度蕙风。\n妙语宁惟压元白，大封端合启龟蒙。\n规恢伫看收功去，自勒丰碑纪殪戎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19146,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵 其三","author":"陈造","text":"横前整整万全兵，自笑空弮借背城。\n更遣齐竽混东郭，坐令鹄卵化南荣。\n黄陈得法仍宗派，甫白论情自弟兄。\n顾我无能邹贾役，放公笔力擅西京。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19147,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵 其四","author":"陈造","text":"因诗衰病顾徒然，凿井今犹未及泉。\n药幻霜须端有待，囊缄玉唾愧无传。\n冥心拟学无言子，授诀今犹不老仙。\n探妙卫生俄两得，信知穮蓘解逢年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19148,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵 其二","author":"陈造","text":"从公囊笔看西边，不比分弓出酒泉。\n觞咏每忘秋漏永，平安晏有夕烽传。\n痼肠顿已蜂腰病，妙手亲逢鹤背仙。\n归捋霜须诧儿子，为翁试校故新年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19149,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵","author":"陈造","text":"好时好节工恼客，投老祇思深闭关。\n鹤膝痛医终是病，蛾眉公夺岂容悭。\n浩歌已减落梅曲，苦思更妨颓醉山。\n冷语陋姝何所似，贫家矮屋劣成间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19150,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵","author":"陈造","text":"解橐临风得好怀，祇令公等费诗才。\n行装并喜鸱夷满，春意如烦羯鼓催。\n饭白重供飞雪鲙，眼青还对照溪梅。\n滞留不恶归仍好，笑杀山阴兴尽回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19151,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵 其一","author":"陈造","text":"门第应疑甚不庭，翩随府檄下山城。\n江梅作意先秋拆，槛菊多情擅晚荣。\n饮处凝香严画戟，客间张丈间殷兄。\n主宾缥缈蜚埃外，信有人间小玉京。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19152,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵二首 其一","author":"陈造","text":"雪神不袖嘘枯手，嗣岁丰登预告成。\n泚笔径烦书上瑞，载涂况已沸欢声。\n骑驴有客搜新句，扶路何人趁晚晴。\n一笑与渠分乐事，的知琼露胜宜城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19153,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵二首 其一","author":"陈造","text":"饱食频频祇鸒斯，可堪迅景隙驹驰。\n不逢犹是桐为弩，当价胡宁菌作芝。\n天籁寂时三弄笛，楚山穷处四愁诗。\n将坛可复宜衰病，此柄须君为主持。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19154,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵二首 其二","author":"陈造","text":"近墅何妨一再行，后车应著老弥明。\n诗成直压抢榆上，谭胜宁容鄙吝萌。\n鸥鹭一滩窥语笑，松筠千挺峙寒清。\n从今好绘斜川集，莫靳流传到帝城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19155,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵二首 其一","author":"陈造","text":"铅墨才为一饱谋，还因跋疐赋休休。\n南州习俗难驯扰，北客迂疏易悔尤。\n世味辰星今落落，归心风旆正悠悠。\n知非况自五十九，为问衰翁底更求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19156,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵二首 其二","author":"陈造","text":"欲辔青骢试小行，拥衾待得晓窗明。\n端知霁日浑无价，可信啼鸠识未萌。\n胜处风烟堪一醉，是家池馆擅双清。\n不忧儿辈妨人乐，倚赖诗豪五字城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19157,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵二首 其二","author":"陈造","text":"自揖高人拥鼻吟，湖滨诗酒便论心。\n天教联绶同民社，日许挑灯订古今。\n刺眼未妨翻著袜，跃炉宁问不祥金。\n简编自有千年计，迟子追还正始音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19158,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵二首 其一","author":"陈造","text":"郡政只今多暇日，名园欲到指苍茫。\n能诗有客怜侯喜，好士惟公继郑庄。\n促膝未妨渑似酒，转头当复玉为堂。\n联金缀玉真吾事，剩刻坚珉表士乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19159,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵二首 其一","author":"陈造","text":"宋璞隋珠不当偿，平时佳思堕荒茫。\n老规种秫师陶令，备有前茅愧楚庄。\n蜂鹤搅肠空轧轧，鹳鹅严阵怯堂堂。\n即今全胜输公等，自占床敷霸睡乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19160,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵二首 其二","author":"陈造","text":"历块飞黄可得追，加鞭十驾浪驱驰。\n不应猗顿怀周朴，敢向天仙话土芝。\n晚傍涪翁观落笔，了知高叟固为诗。\n谬为恭敬吾何取，政恐龙泉有倒持。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19161,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵十首 其十","author":"陈造","text":"靖节瓶无粟，思归更命车。\n慵垂督邮带，况袖子公书。\n老我须闲适，尘缘得破除。\n还应与鸥鹭，分占碧溪渔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19162,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵十首 其九","author":"陈造","text":"仕为饥寒迫，归怜兴味长。\n卜居从诡谲，勿药幸康强。\n邻拟千钱买，书开万卷藏。\n残年文字癖，更欲竞流光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19163,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵十首 其八","author":"陈造","text":"进业湖海窄，取名丝缕轻。\n因君论前辈，卫道有金城。\n潢潦先知本，机缄贵用情。\n灵台与秋日，烱烛古今明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19164,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵十首 其七","author":"陈造","text":"中天有台阁，自问汝何能。\n世路信薄命，吏曹须异称。\n北归甘醉叟，西上且聋丞。\n执友论文地，能无兴可乘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19165,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵十首 其六","author":"陈造","text":"城西山水窟，早晚命篮舆。\n胜绝僧能有，拘挛我不如。\n山云侧步踊，雪壁细行书。\n它日尝般礴，萧然乐有馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19166,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵十首 其五","author":"陈造","text":"朝家无阙政，秋禜继春雩。\n恤纬怜吾怯，知言敢自诬。\n闭阴宁董傅，为己肯杨朱。\n未断蜗缘壁，仍多豕负涂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19167,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵十首 其四","author":"陈造","text":"吴门诗酒伴，入社记吾曾。\n香篆温难烬，铜壶冷易冰。\n赓酬恕吾老，声价放渠增。\n衰谢犹回首，思分蔀屋灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19168,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵十首 其三","author":"陈造","text":"客舍无佳晤，君来肯小留。\n衣穿从见肘，赋好似登楼。\n论世聊扪舌，输棋不计筹。\n明窗坐方稳，寒日为谁遒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19169,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵十首 其二","author":"陈造","text":"曲巷才人迹，泥涂没屐深。\n未妨冲雨到，要伴掉头吟。\n大巧专亭毒，何时扫疹淫。\n浊醪君莫厌，排闷勉孤斟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19170,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵十首 其一","author":"陈造","text":"重见发更白，羁栖偕在行。\n余嗟遽如许，子亦可怜生。\n玉粒书新券，霜蔬煮破铛。\n诗成莫浪出，或取世儒轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19171,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵小雪馀言别 其一","author":"陈造","text":"舞霙飞霰闹中庭，已办持杯听渭城。\n汉水襄山骤漂忽，早梅晚菊自枯荣。\n雪神作意凌风伯，客子归途待日兄。\n蹀躞霜蹄从踣铁，穿林䠞石赋于京。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19172,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵小雪馀言别 其二","author":"陈造","text":"语别诗翁玉麈边，已催歌舞压香泉。\n日陪色笑庸何取，橐捃篇章敢浪传。\n还舍剩书银笔字，今朝犹是玉壶仙。\n后山幸自坡公客，谁遣离怀怆暮年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19173,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵马主簿二首 其二","author":"陈造","text":"左顾衰翁底取斯，转头归马又西驰。\n剩催阿买抄新稿，大胜斋房纪瑞芝。\n乐岁人家皆有酒，高秋天气总宜诗。\n霜花露菊留迎客，预戒西成省控持。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19174,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵马主簿二首 其一","author":"陈造","text":"冥搜成癖漫勤斯，缅想骚人正坐驰。\n点化今逢万金剂，神奇蒸出九华芝。\n三吴才隽应焚砚，万里风烟尽入诗。\n盍与元刘论伯仲，未容郊岛更矜持。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19175,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵四首 其一","author":"陈造","text":"新酿开缸渌蚁浮，旧辞仍缺唾壶讴。\n宦涂要处难插手，诗社丛中常引头。\n倒载肯陪山简醉，反关莫厌孟公留。\n秋田粗可供佳客，不比封君亦素侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19176,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]