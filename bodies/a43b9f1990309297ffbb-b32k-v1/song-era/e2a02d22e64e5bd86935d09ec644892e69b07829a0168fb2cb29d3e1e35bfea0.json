[{"title":"绍兴十年发皇太后册宝八首 其一 皇帝随册宝降殿用《圣安》。","author":"郊庙朝会歌辞","text":"景祚有开，符天媲昊。\n诞毓圣神，是崇位号。\n星拱天随，祗严册宝。\n还御慈宁，增光舜道。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2056,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后祀五方帝六十首 送神用《高安》。","author":"郊庙朝会歌辞","text":"神之戾止，天门夜开。\n礼备告成，云■亟回。\n旗纛晻霭，万灵喧豗。\n独遗祉福，用泽九垓。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2057,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后祀五方帝六十首 亚、终献用《文安》。","author":"郊庙朝会歌辞","text":"万汇揫敛，时惟冬序。\n蠢尔黎氓，入此室处。\n酌献告神，礼以时举。\n赖此阴骘，民有所怙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2058,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后祀五方帝六十首 高阳氏酌献用《祐安》。","author":"郊庙朝会歌辞","text":"十月纳禾，民务藏盖。\n不有神休，民罔攸赖。\n孟冬之吉，礼行不昧。\n神降百祥，昭著蓍蔡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2059,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后祀五方帝六十首 亚、终献用《文安》。","author":"郊庙朝会歌辞","text":"盥爵奠斝，载虔载恭。\n笾豆静嘉，于乐鼓钟。\n礼备三献，神具醉止。\n孰显神德，扬光纷委。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2060,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后祀五方帝六十首 神农氏酌献用《祐安》。","author":"郊庙朝会歌辞","text":"猗欤先农，肇兹黍稷。\n既殖既播，有此粒食。\n秬鬯洁清，彝樽疏幂。\n竭我瑶斝，莫报嘉绩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2061,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后祀五方帝六十首 赤帝酌献用《祐安》。","author":"郊庙朝会歌辞","text":"四月维夏，兆于重离。\n帝执其衡，物无疠疵。\n于皇帝功，思乐旨酒。\n奠爵既成，垂福则有。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2062,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后祀五方帝六十首 奉俎用《丰安》。","author":"郊庙朝会歌辞","text":"有牲在涤，从以骍牡。\n或肆或将，有洁其俎。\n神嗜饮食，飶飶芬芬。\n莫腆于诚，神其顾歆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2063,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后祀五方帝六十首 神农氏奠币用《嘉安》。","author":"郊庙朝会歌辞","text":"练以纁黄，有篚将之。\n肸蚃斯答，有神昭之。\n维神于民，实始货食。\n归德报功，敢怠王国。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2064,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后祀五方帝六十首 赤帝奠玉币用《嘉安》。","author":"郊庙朝会歌辞","text":"太微呈祥，炎德克彰。\n佑我基命，格于明昌。\n一纯二精，有严典祀。\n于以奠之，以介繁祉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2065,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后祀五方帝六十首 升殿用《正安》。","author":"郊庙朝会歌辞","text":"除地国南，有基崇崇。\n载陟载降，式虔式恭。\n燎烟既燔，黻冕斯容。\n神如在焉，肆予幽通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2066,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后祀五方帝六十首 其四 赤帝降神用《高安》。","author":"郊庙朝会歌辞","text":"烨烨其光，炳炳其灵。\n窅其如容，歘其如声。\n扇以景风，导以朱斿。\n我德匪类，神其安留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2067,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后祀五方帝六十首 其三 赤帝降神用《高安》。","author":"郊庙朝会歌辞","text":"八卦相荡，一气散施。\n隆炽恢台，职神尸之。\n肃肃飙御，神戾于天。\n于昭神休，天子万年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2068,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后祀五方帝六十首 其二 赤帝降神用《高安》。","author":"郊庙朝会歌辞","text":"赤精之君，位于朱明。\n茂育万物，假然长嬴。\n我洁我盛，我蠲我诚。\n神其下来，云车是承。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2069,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后祀五方帝六十首 其一 赤帝降神用《高安》。","author":"郊庙朝会歌辞","text":"离明御正，德协于火。\n有感其生，维帝是何。\n帝图炎炎，贻福锡我。\n鉴于妥虔，高灵下堕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2070,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后祀五方帝六十首 送神用《高安》。","author":"郊庙朝会歌辞","text":"忽而来兮，格神鸿休。\n忽而往兮，神不予留。\n神在天兮，福我寿我。\n千万春兮，高灵下堕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2071,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后祀五方帝六十首 亚、终献用《文安》。","author":"郊庙朝会歌辞","text":"贰觞具举，承神嘉虞。\n神具醉止，眷焉此都。\n我岁方新，我亩伊殖。\n时旸时雨，繄神之力。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2072,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后祀五方帝六十首 太昊酌献用《祐安》。","author":"郊庙朝会歌辞","text":"五德之王，谁实始之。\n功括造化，与天无期。\n酌我清酤，盥献载饬。\n神鉴孔飨，天子之德。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2073,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后祀五方帝六十首 黑帝酌献用《祐安》。","author":"郊庙朝会歌辞","text":"赫赫神游，周流八极。\n德馨上闻，于焉来格。\n不腆酒醴，用伸悃愊。\n神其歆之，民用向德。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2074,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后祀五方帝六十首 奉俎用《丰安》。","author":"郊庙朝会歌辞","text":"辰牡孔硕，奉牲以告。\n秘祝非祈，丰年宜报。\n至意昭彻，交乎神明。\n降福穰穰，用燕群生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2075,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后祀五方帝六十首 高阳氏位奠币用《嘉安》。","author":"郊庙朝会歌辞","text":"飙驭云盖，神之顾歆。\n丕昭礼容，发扬乐音。\n祀事既举，仰当神心。\n申以嘉币，式荐诚谌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2076,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后祀五方帝六十首 黑帝奠玉币用《嘉安》。","author":"郊庙朝会歌辞","text":"晨曦未升，天宇肃穆。\n祗若元祀，将以币玉。\n神之格思，三献茅缩。\n明灵怿豫，下土是福。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2077,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后祀五方帝六十首 升殿用《正安》。","author":"郊庙朝会歌辞","text":"昧爽昭事，煌煌露光。\n涤溉蠲洁，容仪肃庄。\n牲肥酒旨，荐此芬芳。\n降陟有序，礼无越常。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2078,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后祀五方帝六十首 其四 黑帝降神用《高安》。","author":"郊庙朝会歌辞","text":"天地闭塞，盛德在水。\n黑精之君，降福羡祉。\n洋洋在上，若或见之。\n齐庄承祀，其敢斁思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2079,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后祀五方帝六十首 其三 黑帝降神用《高安》。","author":"郊庙朝会歌辞","text":"北方之神，执权司冬。\n三时务农，于焉告功。\n礼备乐作，归功于神。\n风马来游，永锡斯民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2080,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后祀五方帝六十首 其二 黑帝降神用《高安》。","author":"郊庙朝会歌辞","text":"良月盈数，四气推迁。\n帝于是时，典司其权。\n高灵下堕，降祉幅员。\n神之听之，祀事罔愆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2081,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后祀五方帝六十首 其一 黑帝降神用《高安》。","author":"郊庙朝会歌辞","text":"吉日壬癸，律中应钟。\n国有故常，北郊迎冬。\n乃蒇祀事，必祗必恭。\n明默虽异，感而遂通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2082,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后祀五方帝六十首 亚、终献用《文安》。","author":"郊庙朝会歌辞","text":"肃成万物，泬寥其秋。\n惟兹祀事，戾止灵斿。\n酌献具举，典礼是求。\n冀福斯民，黍稷盈畴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2083,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后祀五方帝六十首 少昊氏位酌献用《祐安》。","author":"郊庙朝会歌辞","text":"沆砀西颢，功载万世。\n乘金宅兑，侑我明祀。\n嘉觞布兰，牲玉洁精。\n神之燕虞，肃用有成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2084,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后祀五方帝六十首 白帝酌献用《祐安》。","author":"郊庙朝会歌辞","text":"徂商肇祀，灵盖孔飨。\n恭承嘉禧，湛澹秬鬯。\n监此馨香，灵其安留。\n畴惠下民，匪灵之休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2085,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后祀五方帝六十首 奉俎用《丰安》。","author":"郊庙朝会歌辞","text":"洽礼既陈，谐音具举。\n有涤斯牲，孔硕为俎。\n维帝居歆，介我稷黍。\n乐哉有秋，繄神之祜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2086,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后祀五方帝六十首 少昊氏位奠币用《嘉安》。","author":"郊庙朝会歌辞","text":"西颢肃清，群生茂遂。\n有严报典，孔明祀事。\n圭币告虔，神灵燕喜。\n赉我丰年，以锡民祉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2087,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后祀五方帝六十首 白帝奠玉币用《嘉安》。","author":"郊庙朝会歌辞","text":"惟时素秋，肇举元祀。\n礼备乐作，降登有数。\n洋洋在上，神既来止。\n神之格思，锡我繁祉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2088,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后祀五方帝六十首 升殿用《正安》。","author":"郊庙朝会歌辞","text":"素猋谐律，西颢堕灵。\n肇复元祀，晨炀肃清。\n下土层陔，嘉荐芳馨。\n以御蕃祉，介我西成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2089,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后祀五方帝六十首 其四 白帝降神用《高安》。","author":"郊庙朝会歌辞","text":"执矩斯兑，实惟素灵。\n受职储休，万宝以成。\n飨于西郊，奠玉陈牲。\n侑以雅乐，来歆克诚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2090,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后祀五方帝六十首 其三 白帝降神用《高安》。","author":"郊庙朝会歌辞","text":"昊天之气，揫敛万汇。\n涓日洁齐，有严厥祀。\n有牲维肥，有酒维旨。\n神之燕娭，锡兹福祉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2091,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后祀五方帝六十首 其二 白帝降神用《高安》。","author":"郊庙朝会歌辞","text":"素精肇节，金行固藏。\n气冲炎伏，明河翻霜。\n功收有年，礼荐有章。\n祇越眇冥，鸿基永昌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2092,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后祀五方帝六十首 其一 白帝降神用《高安》。","author":"郊庙朝会歌辞","text":"白藏启序，庶汇向成。\n有严禋祀，用答幽灵。\n风马云车，来燕来宁。\n洋洋在上，休福是承。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2093,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后祀五方帝六十首 送神用《高安》。","author":"郊庙朝会歌辞","text":"灵不肯留，沛兮将归。\n玉节猋逝，翠旗并驰。\n顾瞻伫立，怅然佳期。\n蹇千万年，无斁人斯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2094,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后祀五方帝六十首 亚、终献用《文安》。","author":"郊庙朝会歌辞","text":"羽觞更陈，厥味清凉。\n饮之不烦，又有蔗浆。\n夜未艾止，明星浮浮。\n愿言妥灵，灵兮淹留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2095,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后祀五方帝六十首 有熊氏酌献用《祐安》。","author":"郊庙朝会歌辞","text":"昔在绵邈，有人公孙。\n登政抚辰，节用良勤。\n所蓄既大，所行宜远。\n载其华樽，从以箫管。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2096,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后祀五方帝六十首 黄帝酌献用《祐安》。","author":"郊庙朝会歌辞","text":"黍以为翁，郁以为妇。\n以侑元功，以酌大斗。\n伊谁歆之，皇皇帝后。\n伊谁嘏之，天子万寿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2097,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后祀五方帝六十首 奉俎用《丰安》。","author":"郊庙朝会歌辞","text":"王曰钦哉，无爱斯牲。\n登我元祀，亦有皇灵。\n以将以享，或剥或烹。\n大夫之俎，天子之诚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2098,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后祀五方帝六十首 有熊氏位奠币用《嘉安》。","author":"郊庙朝会歌辞","text":"维有熊氏，以土胜王。\n其后皆沿，兹德用壮。\n黼黻幅舄，裳衣是创。\n币之玄纁，对此昭亮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2099,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后祀五方帝六十首 黄帝奠玉币用《嘉安》。","author":"郊庙朝会歌辞","text":"万椟之宝，一絇之丝。\n孕之育之，谁为此施。\n归之后神，神曰何为。\n不宰之功，荡然四垂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2100,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后祀五方帝六十首 升殿用《正安》。","author":"郊庙朝会歌辞","text":"民生地中，动作食息。\n与我周旋，莫匪尔极。\n捕鲽东海，搴茅南山。\n彼劳如何，矧升降间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2101,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后祀五方帝六十首 其四 黄帝降神用《高安》。","author":"郊庙朝会歌辞","text":"澹兮抚琴，啾兮吹笙。\n神之未来，肃穆以听。\n缤纷羽旄，姣服在中。\n神既来止，亦无惰容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2102,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后祀五方帝六十首 其三 黄帝降神用《高安》。","author":"郊庙朝会歌辞","text":"乐哉帝居，逝留无常。\n尔信我宅，尔中我乡。\n乃眷兹土，于赫君王。\n翩然下来，去未遽央。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2103,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后祀五方帝六十首 其二 黄帝降神用《高安》。","author":"郊庙朝会歌辞","text":"荪无不在，日与我居。\n孰不可来，肸蚃斯须。\n象服龙驾，渊渊鼓桴。\n荪不汝多，多汝意孚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2104,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后祀五方帝六十首 其一 黄帝降神用《高安》。","author":"郊庙朝会歌辞","text":"维帝奠位，乃咸于时。\n孰主张是，而枢纽之。\n谷我腹我，比予于儿。\n告我冠服，迨其委蛇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2105,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后祀五方帝六十首 送神用《高安》。","author":"郊庙朝会歌辞","text":"神来何从，馺然灵风。\n神去何之，杳然幽踪。\n伊神去来，雾散云烝。\n独遗休祥，山崇川增。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2106,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后祀五方帝六十首 青帝酌献用《祐安》。","author":"郊庙朝会歌辞","text":"百末布兰，我酒伊旨。\n酌以匏爵，洽我百礼。\n帝居青阳，顾予嘉觞。\n右我天子，宜君宜王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2107,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后祀五方帝六十首 奉俎用《丰安》。","author":"郊庙朝会歌辞","text":"灵兮安留，烟燎既升。\n有硕其牲，有俎斯承。\n匪牲则硕，我德惟馨。\n缓节安歌，庶几是听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2108,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后祀五方帝六十首 太昊氏位奠币用《嘉安》。","author":"郊庙朝会歌辞","text":"卜岁之初，我迎春祗。\n孰克侑飨，曰古宓戏。\n于皇宓戏，万世之德。\n再拜稽首，敢爱斯璧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2109,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后祀五方帝六十首 青帝奠玉币用《嘉安》。","author":"郊庙朝会歌辞","text":"物之熙熙，胡为其然。\n蒙神之休，乃敢报旃。\n有邸斯圭，有量斯币。\n于以奠之，格此精意。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2110,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后祀五方帝六十首 升殿用《正安》。","author":"郊庙朝会歌辞","text":"在国之东，有坛崇成。\n节以和乐，式降式登。\n洁我佩服，璆琳锵鸣。\n匪坛斯高，曷妥厥灵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2111,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后祀五方帝六十首 其四 青帝降神用《高安》。","author":"郊庙朝会歌辞","text":"温然仁矣，熙然春矣。\n龙驾帝服，穆将临矣。\n我酒清矣，我肴烝矣。\n我乐备矣，我神顾矣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2112,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后祀五方帝六十首 其三 青帝降神用《高安》。","author":"郊庙朝会歌辞","text":"神在途矣，习习以风。\n百灵后先，敢一不恭。\n奔走疠疫，祓除菑凶。\n顾瞻下方，逍遥从容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2113,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后祀五方帝六十首 其二 青帝降神用《高安》。","author":"郊庙朝会歌辞","text":"神兮焉居，神在震方。\n仁以为宅，秉天之阳。\n神之来矣，道修以阻。\n望神未来，使我心苦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2114,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后祀五方帝六十首 其一 青帝降神用《高安》。","author":"郊庙朝会歌辞","text":"于神何司，而德于木。\n肃然顾歆，则我斯福。\n我祀孔时，我心载祗。\n匪我之私，神来不来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2115,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后祀感生帝十六首 望燎用《普安》。","author":"郊庙朝会歌辞","text":"礼文既洽，熏燎聿升。\n嘉气四塞，丹诚上腾。\n惟类之应，惟福之兴。\n永炽天统，亿载灵承。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2116,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后祀感生帝十六首 送神用《大安》。","author":"郊庙朝会歌辞","text":"丰祀孔饰，肃来自天。\n兰尊既彻，飙驭载遄。\n骑云缥缈，聆乐流连。\n惟迈惟顾，降福绵绵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2117,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后祀感生帝十六首 彻豆用《肃安》。","author":"郊庙朝会歌辞","text":"洁陈斯备，昭格惟禋。\n神歆以饫，宰彻其馂。\n清歌振晓，叶气流春。\n永锡祚嗣，以渥烝民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2118,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后祀感生帝十六首 亚、终献用《文安》。","author":"郊庙朝会歌辞","text":"伟炎厥初，缘感而系。\n庆衍式崇，昭融有契。\n乐功既谐，觞献斯继。\n歆类不违，克昌百世。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2119,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后祀感生帝十六首 文舞退、武舞进用《正安》。","author":"郊庙朝会歌辞","text":"苾苾芬芬，神具醉止。\n笙磬铿锵，干旄旖旎。\n鬷假无言，神灵惟喜。\n申锡蕃釐，暨我孙子。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2120,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后祀感生帝十六首 僖祖位酌献用《肃安》。","author":"郊庙朝会歌辞","text":"皇矣文献，开国有先。\n德配感生，对越在天。\n练日得辛，来止灵坛。\n神其锡羡，瑞应猗兰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2121,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]