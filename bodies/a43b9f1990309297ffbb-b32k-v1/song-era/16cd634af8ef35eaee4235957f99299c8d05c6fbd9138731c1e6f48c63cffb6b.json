[{"title":"水友辞 陶河","author":"王质","text":"陶河，陶河，江文萃蔡搔江莎。\n岸沙岩石相荡摩，异音同流烝涉波。\n东在梁，西在梁，缫风纷雾无斜阳。\n呜呼此友兮相与永，岛影忽翻水声并。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24576,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"水友辞 鵁鶄","author":"王质","text":"鵁鶄，鵁鶄，嗢咽秋水溞秋声。\n石树??崖棱棱，蹋蘋蹴藻轻轻行。\n哺儿饥，诲儿痴，淋渗离褷相挟飞。\n呜呼此友兮常相存，溪子通知鱼鸟心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24577,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"水友辞 鱼姑","author":"王质","text":"鱼姑，鱼姑，溪南溪北遥相呼。\n烟深雾重栖沉鱼，荒荒秋汉秋星疏。\n要姑活，怕姑死，姑且閒飞歇深沚。\n呜呼此友兮真足称，草平树安波不兴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24578,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"水友辞 鱼燕子","author":"王质","text":"鱼燕子，鱼燕子，堇饴不下银花觜。\n荷香菱香溪清泠，涮尽嚏喋全无腥。\n蒲槌黄，菰台黑，波痕荡摇渚花蚀。\n呜呼此友兮能相宽，天生水资欢水贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24579,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"水友辞 水莺子","author":"王质","text":"水莺子，水莺子，不爱林花爱溪水。\n春岸春莎翕习飞，波动鬣摇霍身坠。\n罱入浅，罩入深，东渚抛纶西拗罾。\n呜呼此友兮良相宜，水光树光韬暗辉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24580,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"水友辞 鱼乌子","author":"王质","text":"鱼乌子，鱼乌子，相唤相挨擦风苇。\n春莎渗子渐成鳞，的皪眼光入波底。\n唼草芽，啑杨花，勃勃春沫吹春莎。\n呜呼此友兮宜接迹，溪气溪香午犹湿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24581,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"水友辞 科斗儿","author":"王质","text":"科斗儿，科斗儿，役役聿聿成攒嬉。\n软温春水调春泥，噆深噆浅随高低。\n傍春草，傍春石，莫向空中乱澄碧。\n呜呼此友兮良可观，羽葆鼓吹春风前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24582,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"水友辞 水鸦鹊","author":"王质","text":"水鸦鹊，水鸦鹊，软荷搭水身可泊。\n高荷脩茎难著脚，一盘一窝足安乐。\n灶有薪，甑有饭，芦人渔子事皆办。\n呜呼此友兮宜相倚，溪风来定水香归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24583,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"水友辞 寐卑子","author":"王质","text":"寐卑子，寐卑子，春菰秋蒲老烟水。\n一双飞逐一双飞，斜景净空光陆离。\n恋桃花，恋麦黄，瓜蔓荻苗皆故乡。\n呜呼此友兮宜同方，江花吹子鱼花香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24584,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山友续辞 枸杞","author":"王质","text":"我取友兮得枸杞，左陂花头野声起。\n蘘蓑霏雨杂斜阳，半湿半乾留春水。\n仙人杖，王母杖，所思兮焉可旷，野莺怂恿野花旺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24585,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山友续辞 黄精","author":"王质","text":"我取友兮得黄精，竹叶豆花交野阴。\n人不图仙只图饱，鸦鹊窠雕龙爪零。\n白可撷，青可捋，所思兮何由掇，半岩斜阳孟溪泼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24586,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山友续辞 山药","author":"王质","text":"我取友兮得山药，蝶花开尽铃子落。\n几日几日黄不成，?莫日灵施少灵。\n猿父上，?子下，所思兮安可舍，一重空岩一重野。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24587,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山友续辞 甘菊","author":"王质","text":"我取友兮得甘菊，高丛低叶贮清馥。\n石盂幡纚乳花飞，错落纷敷间寒绿。\n入顾渚，入蒙山，所思兮安可捐，椿儿桂子争芳鲜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24588,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山友续辞 牛蒡","author":"王质","text":"我取友兮得牛蒡，稠丛捷鼠走不上。\n深山谁伏又谁牵，唇粗舌皴膝头壮。\n实虽恶，食不恶，所思兮奚可却，松冈竹墩隔沙泺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24589,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山友续辞 石耳","author":"王质","text":"我取友兮得石耳，石壁峻嶒下无底。\n非脾非肾非肝肠，马齿马牙衔不起。\n耳无是，耳无非，所思兮何可萎，石笋石花滋石脂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24590,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山友续辞 合蕈","author":"王质","text":"我取友兮得合蕈，山深树底风不进。\n弹子团栾敷未敷，飞儡腾猿毋口粗。\n藤花迷，豆花肥，所思兮焉可遗，溪山撩乱将安归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24591,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山友续辞 槐芽","author":"王质","text":"我取友兮得槐芽，缭陂灌丛饶杂花。\n才茁嫩荚抽枯桠，涎流山鹊并山鸦。\n胶著虻，房著蠊，所思兮安可芟，碧鲜冷淘思露寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24592,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山友续辞 蔊头","author":"王质","text":"我取友兮得蔊头，猛嚏烈香惊伏虬。\n石羊石蛇齧不得，弹蟹燕蚕胡可偷。\n常风寒，常雪寒，所思兮奚可堪，阴崖涌沫号飞湍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24593,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山友续辞 山姑","author":"王质","text":"我取友兮得山姑，春雨春风沙土苏。\n山粗屦绽不皴脚，祗恐叉头罥花落。\n拜蘋婆，揖菜娘，所思兮岂可忘，苦楝风高须索防。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24594,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"水友续辞 莲子","author":"王质","text":"我取友兮得莲子，月白风清影横水。\n烟消露飞香愈茂，风标宜夜不宜昼。\n薏青青，的白白，所思兮将焉歇，中坻阻跻不可越。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24595,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"水友续辞 藕条","author":"王质","text":"我取友兮得藕条，花近可招远可撩。\n龟鱼到底亦不见，但见红开乃碧凋。\n风漾漾，露霏霏，所思兮焉可移，光旁聊寄幽并儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24596,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"水友续辞 鸡头","author":"王质","text":"我取友兮得鸡头，漪澜汪洸不肯流。\n鸡栖雁栖卑不飞，雁或浮上鸡何为。\n溪无洒，沙无虱，所思兮安有毕，湿沙暗虫声??。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24597,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"水友续辞 菱角","author":"王质","text":"我取友兮得菱角，碎叶参差水瀺灂。\n重重叠叠庶相鯈，虽见噞喁不可捉。\n收壁袋，收簧丝，所思兮宜相资，擦莎挨树秋蝉啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24598,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"水友续辞 水粽","author":"王质","text":"我取友兮得水粽，结花甚轻结根重。\n竹筒楝叶潇湘馀，随波凌乱飘江湖。\n藤笼闭，漏兜闲，所思兮奚可悭，芦岸槿篱门早?。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24599,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"水友续辞 水芽儿","author":"王质","text":"我取友兮得水芽，荷花为娘藕为爷。\n不闻儿声闻水声，短埼长溆鸣奔沙。\n霜欲飞，水欲归，所思兮不忍欺，东波南荡秋风稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24600,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"水友续辞 慈菰","author":"王质","text":"我取友兮得慈菰，秋水才没藏莎馀。\n并州剪刀聊藉姑，剪得閒花閒子疏。\n燕摇尾，龙掀须，所思兮可与娱，秋波索索秋声孤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24601,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"水友续辞 水芹","author":"王质","text":"我取友兮得水芹，深青浅绿鬖鬖开。\n半沉半浮轻去来，溪毛石发相毰毸。\n健鱼赤，弱鱼碧，所思兮不胜积，疏烟淡川净如拭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24602,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"水友续辞 水莼","author":"王质","text":"我取友兮得水莼，黄黄白白花深深。\n美髯得非龙子孙，秋风不退香涎痕。\n东鲁思，东吴思，所思兮宜相诒，草木溪山今是非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24603,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山水友馀辞 婆看蚕","author":"王质","text":"一百箔，二百箔，千百箔，遍村落。\n官绢不厌厚，私绢不厌薄。\n婆看蚕，婆看蚕，蒲桶荷包共作田，晚豅秋秋风摇稻髯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24604,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山水友馀辞 鹘嘲","author":"王质","text":"鹘不挟，雕不劂，各忀徉，毋獝狨。\n一愁扯花裂，二愁踏花折。\n鹘嘲，鹘嘲，相呼窃脂并博劳，同寻念佛婆罗巢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24605,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山水友馀辞 铜觜","author":"王质","text":"不银眉，不金翅，寻驮梁，搬草子。\n啄花蜡觜狞，啄粟铜觜狞。\n铜觜，铜觜，春环春嘤好兄弟，春喁自飞莫同队。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24606,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山水友馀辞 涴鸣","author":"王质","text":"幸蒙宠，聊舂容，有水矿，无筠筒。\n雪姑抬揌妇，巧妇坚正翁。\n涴鸣，涴鸣，寻花寻柳无山无，繁阴渐合春模糊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24607,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山水友馀辞 黄头儿","author":"王质","text":"山鲍老，甘受嘲，山婆婆，惜得骄。\n■子来解腕，大头来间交。\n黄头儿，黄头儿，白黄头儿有老时，鸦线靴头相伴飞。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24608,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山水友馀辞 绿毛龟","author":"王质","text":"似太平，自开元，虽垂老，不踰钱。\n只爱绿苔净，勿爱金丝鲜。\n绿毛龟，绿毛龟，三三八八总不知，彷徉露蒋风蒲稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24609,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山水友馀辞 秧鸡","author":"王质","text":"望水白，雁来黄，隔山拖，先拖秧。\n卯子何日圆，马牙何日长。\n秧鸡，秧鸡，雨豪狭溪成阔溪，螺蛳蠼子澎澎肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24610,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山水友馀辞 水涝子","author":"王质","text":"獭最黠，鼠更黠，知水情，识水脉。\n荷花不禁掐，稻花不禁捾。\n水涝子，水涝子，鴳滥堆随江风起，自仗秋莎噆秋水。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24611,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山水友馀辞 水划虫","author":"王质","text":"足为棹，须为桡，舴艋子，何多劳。\n黑油急旋旋，玉掌轻摇摇。\n水划虫，水划虫，鸊鷉鹥鸭同从容，宽陂缓波无点风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24612,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山水友馀辞 水蛾儿","author":"王质","text":"任霜叶，任霜花，啑飞蚊，味亦佳。\n浪稳无弩狐，波平无钩蛇。\n水蛾儿，水蛾儿，石妇春风放尽丝，松根共掠蘋花飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24613,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山水友馀辞 刺椿","author":"王质","text":"唤春鸟，当春呼，莫错呼，非茱萸。\n前林迎榆郎，后林接榆姑。\n刺椿，刺椿，黠禽掐捾馀姑存，土卵蕨鸡无宿根。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24614,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山水友馀辞 金樱子","author":"王质","text":"蔷薇花，榅桲实，多■㗱，津浥浥。\n椰子亦成酒，缩沙亦成蜜。\n金樱子，金樱子，速挽菖蒲出溪水，仍招茯苓并远志。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24615,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山水友馀辞 甜藤","author":"王质","text":"元姓甘，不姓丁，引春风，含常春。\n鸡翁呷甘露，祁婆插金棱。\n甜藤，甜藤，粥香饧白度清明，一片春山快活声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24616,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山水友馀辞 苦菜","author":"王质","text":"王瓜后，靡草前，荠却苦，荼却甘。\n贝母花哆哆，龙葵叶团团。\n苦菜，苦菜，空山自有閒人爱，竹箸木瓢越甜煞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24617,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山水友馀辞 甜椎","author":"王质","text":"花成穗，子成毬，雅相似，终非俦。\n茅栗低坡尾，旋栗高冈头。\n甜椎，甜椎，秋后秋树倚斜晖，苦者掷与看牛儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24618,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山水友馀辞 蓼米","author":"王质","text":"无马缠，无虾须，罗裙带，色色无。\n愿花变流沙，愿花变穿珠。\n蓼米，蓼米，秋风易摇入秋水，大平中期难屈指。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24619,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山水友馀辞 水芋头","author":"王质","text":"不粤卵，不岷鸱，虽沉波，堪作魁。\n葧脐叶搓牙，芥■苗整齐。\n水芋头，水芋头，江湖百年无一愁，南湾北湾皆膳羞。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24620,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山水友馀辞 蒌蒿","author":"王质","text":"皤老白，角子乌，尔未萌，我已敷。\n芦笋茁戢戢，荻笋抽擢擢。\n蒌蒿，蒌蒿，风枝两叶老萧萧，草堂黍氏不得骄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24621,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山水友馀辞 茭白","author":"王质","text":"春斑犀，秋彫胡，一年计，在江湖。\n赤脚白脚癯，黄鲜红鲜圬。\n茭白，茭白，■人渔子手拍拍，桨芽橹脐晓香发。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24622,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山水友馀辞 黄花菜","author":"王质","text":"大金星，小金钱，急咽淡，缓嚼甜。\n黄花了未了，小儿群争讨。\n黄花菜，黄花菜，大黄小黄甑蓬闿，饭香蔬香直一噫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24623,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山水友别辞 茯苓酥","author":"王质","text":"且自伏尔菟，毋劳伏我神。\n只图滋一啜，不图延千龄。\n酥也酥，总弗如，松风浩荡相招呼，呼上青冥山亦无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24624,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山水友别辞 地黄糖","author":"王质","text":"风来闻清香，月来见清光。\n鶗鴂但先鸣，芐芭毋歇芳。\n糖他糖，总弗强，草花树花争结房，迎梅送梅陂愈苍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24625,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山水友别辞 薏苡饭","author":"王质","text":"勾漏升空飞，伏波抱愁死。\n一饱万事已，古人皆流水。\n饭它饭，总弗换，树阴相随鸟声变，草虫木虻自撩乱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24626,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山水友别辞 松粉","author":"王质","text":"奉劝十八公，莫入明光宫。\n藉尔毬端露，助我屩底风。\n粉它粉，总弗近，总总松毛粪松本，松子松花香愈猛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24627,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山水友别辞 芭蕉脯","author":"王质","text":"不愁风槭槭，不愁雨萧萧。\n为人张秋本，为我解春牢。\n脯它脯，总弗许，山鬼且往凭山树，繁阴相倍享风露。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24628,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山水友别辞 薝卜鲊","author":"王质","text":"天上雪花六，地下梅花六。\n彼花花我眼，此花实我腹。\n鲊它鲊，总弗亚，山南招提北兰若，野僧家风莫相舍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24629,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山水友别辞 榆酱","author":"王质","text":"榆叶瀹可菹，榆皮舂可脯。\n代豆酿为酱，代面胶为糊。\n酱他酱，总莫尚，榆郎榆姑春春旺，林下山间慰所望。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24630,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山水友别辞 苍耳酒","author":"王质","text":"山妇耳带珰，山儿耳带枲。\n黄衣酱已佳，碧叶酒尤美。\n酒它酒，总弗右，陂草草深别宇宙，野香薰蒸喷饙馏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24631,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"黄香梅","author":"王质","text":"新翻微变寿阳妆，喜色横斜水一方。\n点破冰肌愈清绝，月明无处著清香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24632,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"墨梅","author":"王质","text":"纷纷初疑月挂树，耿耿独与参横昏。\n自从东坡老子飞此英，茫茫世界总无人。\n疏影横斜水清浅，暗香浮动月黄昏。\n自从西湖处士扬此灵，纷纷豪俊半无神。\n赠子一转语，挑子万年机。\n嘬苏诗，嚅林诗，要使苏诗林诗透心脾。\n槎南枝，挼北枝，直使南枝北枝伏指麾。\n九州四海寻人去，不遇当人不要归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24633,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和沈述之与俞舜俞题墨梅","author":"王质","text":"玉京群帝周大罗，芙蓉倒影旌旗多。\n明视仍孙窃姮娥，双成飞琼相和歌。\n飞琼授以无声诗，下走人间駃莫追。\n梅花狂扫不自持，但见浮动横斜他不知。\n中书君贵列钟鼓，唤下真真命歌舞。\n真真呼上复呼下，上屏不言下屏语。\n空郊莽苍江渺茫，中书头锐身瘦长。\n玄泓濡首醉淋浪，首所触者皆生香。\n柳山俞生气象别，不惟手洁更身洁。\n中书相与有良缘，共看霜天羌筦裂。\n十指五指握妙华，不在山颠即水涯。\n老杨死守梅花树，攀枝弄叶犹咨嗟。\n眼光落此亦前定，过去垣外触参井。\n俞生今世伴梅花，若伴他花应不肯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24634,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题龚嘉谋墨梅","author":"王质","text":"梅花一枝复一枝，是邪非邪吾不知。\n空堂惨淡寒寂寞，安得璀璨生光辉。\n今朝朔云覆江野，无乃雪花冲屋楣。\n少定徐观元不尔，壁上横陈皆不飞。\n摩挲零乱争欲动，亟避又不来沾衣。\n稍悟寒英著明缟，已信未信犹衔疑。\n虽然是梅不是雪，亦岂人力攘天机。\n伸脚欲下俄复缩，泠泠亦似奔湍溪。\n忽听檐牙啅林雀，纷纷惊下玉葳蕤。\n鼻端三嗅定何有，萧骚若有霜风吹。\n乃是瀼溪小龚子，搦笔汎翰生清奇。\n老杜见松被松嚇，王子见梅遭梅欺。\n却忆西湖疏影里，断桥流水袖香归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24635,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题俞舜俞墨梅","author":"王质","text":"杨无咎，透梅肝胆入梅心。\n俞舜俞，刳梅皮骨到梅髓。\n大江之西出二士，长淮以北屈两指。\n吾尝菁村山中饱玩玉葳蕤，十里五里无他枝。\n所恨俞子不同载，至今心系吴江湄。\n吾尝竹山道上烂看蜡凌乱，三程两程行不断。\n所恨俞子不同征，至今梦绕襄山畔。\n百尺卷雪楼，十顷黄龙州。\n此地遇俞子，此时逢孟秋。\n巽二滕六皆未集，广寒宫中暗窃来相投。\n一枝两枝虽不多，千林红紫无若何。\n七尺八尺抑何短，万里莽苍亦云满。\n赠尔一则语，收却万年功。\n真梅蕴在磊块胸，幻梅流出精明瞳。\n溟濛摸索未有睹，惨淡经营何所从。\n中庸大学松斋绎几转，楞严圆觉竹几翻数卷。\n他时相逢江路傍，茫茫江月梅花香。\n但见梅花普照眼，不为梅花空断肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24636,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题晁子止侍郎小横轴江路野梅数枝","author":"王质","text":"西楼何自有江声，安得梅花的皪明。\n斗转参横无定舍，侍郎行处亦随行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24637,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题李赞可掀篷梅轴二首 其一","author":"王质","text":"低篷掀起凑平沙，略见玲珑八九花。\n自有青天衮明月，灵台长见影横斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24638,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题李赞可掀篷梅轴二首 其二","author":"王质","text":"半腰已自见全身，但要当人著眼明。\n觑到梅花头上上，十方同是玉为京。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24639,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]