[{"title":"偈颂十八首 其十","author":"释道璨","text":"闹浩浩，闲寂寂。\n不动一丝头，如对万人敌。\n惺惺直是惺惺，历历直是历历。\n捉象亦全其力，捉兔亦全其力。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21319,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十八首 其九","author":"释道璨","text":"玉关度了久班师，犹向人前动鼓鼙。\n只道马行荒草地，不知身已陷重围。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21320,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十八首 其八","author":"释道璨","text":"临济处一杓，末山处半杓。\n玉本无暇，妄自雕琢。\n有年无德老睦州，无端拶折云门脚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21321,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十八首 其七","author":"释道璨","text":"寒一上，热一上。\n普通年事只在，于今更无三般两样。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21322,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十八首 其六","author":"释道璨","text":"即心即佛，山无重数。\n非心非佛，水无重数。\n不是心不是佛，白云又无重数。\n荐福恁么告报，灞陵桥上望西川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21323,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十八首 其四","author":"释道璨","text":"云门放洞山三顿棒，黄檗打临济三顿棒。\n减灶添兵，伤盐费酱。\n一不成单，二不成两。\n多少芦花对蓼红，时人只看丝纶上。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21324,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十八首 其二","author":"释道璨","text":"弟兄财本不多争，共驾官船各自撑。\n撑去撑来回首看，依前不离蓼花汀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21325,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题赵山台莲花方丈","author":"释道璨","text":"四壁纵横都十尺，门对若耶溪水碧。\n画阑漠漠吹香风，绿窗练练浮秋色。\n中有诗家白玉颜，饮露沐芳度朝夕。\n当轩大坐眼波横，只许诗人来入室。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21326,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题瑞昌簿厅景苏堂墨竹","author":"释道璨","text":"一叶复一叶，世道几翻覆。\n一点复一点，书脉要接续。\n亲见长公来，一节不肯曲。\n见竹如见公，北麓能不俗。\n回首熙丰间，几人愧此竹。\n翰墨直枝叶，点化到草木。\n长公有深意，此事付北麓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21327,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"野水横舟","author":"释道璨","text":"望之一叶轻，即之万钧重。\n天风吹不去，世波摇不动。\n送尽千帆飞，济川已无梦。\n月冷蘋花秋，此兴白鸥共。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21328,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪菊","author":"释道璨","text":"大雪冻不死，秋风吹不开。\n许大天地间，受得一气呆。\n生意在根本，肯趁阳和回。\n要从梅兄游，一笑霜雪堆。\n六花已飞舞，槁悴如根荄。\n下有返魂香，英英死不摧。\n老仙造化手，妙处能夺胎。\n唤醒万黄金，桃李皆奴侪。\n对花酌老仙，高致谁能陪。\n东篱有佳人，万些招不来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21329,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"喜雨呈梅石赵都大","author":"释道璨","text":"久旱天地焦，酷出秦法外。\n一雨中夜来，汉兵起丰沛。\n万物皆吐气，昭苏脱厄会。\n忧国有天人，爱民如子辈。\n心香彻九关，化为云叆叇。\n生意一万里，直在方寸内。\n老农相与言，晓晴坐牛背。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21330,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寒拾赞 其一","author":"释道璨","text":"苍崖锁寒色，题目分明极。\n无端书两字，刬地失平仄。\n飏却笔，放却墨，一句了然超百亿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21331,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赋张寺丞樗寮","author":"释道璨","text":"樗寮先生千载士，草木有谁同臭味。\n外无刀斧斫削痕，中有冰霜不老气。\n红紫纷纷满上林，我自无心趁桃李。\n苏秦张仪自纵横，宠辱不惊鲁连氏。\n梁栋峨峨入阿阁，我自无心为杞梓。\n杜乔李固自党锢，网罗不及徐孺子。\n故家乔木百世阴，有此孙枝能蔽芾。\n落去英华植本根，深培不朽圣贤事。\n牺尊青黄互翻覆，眼看世事如醒醉。\n愿言善保丘壑姿，留取清风在天地。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21332,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"樗寮生日","author":"释道璨","text":"长庚流煇千丈强，斗南夜气浮耿光。\n晋唐以前旧人物，翩然乘风下大荒。\n平生厌官不爱做，自歌招隐山中住。\n后园明月手自锄，多种山前老梅树。\n岁寒心事梅花清，沧浪白发梅花明。\n有时指花对客道，此是吾家难弟兄。\n上国春风醉桃李，过眼纷纷付流水。\n禁得清寒耐后霜，幽独何曾有如许。\n今年枝间著子无，黄金作颗应累累。\n想见日长庭院静，时时绕枝如哺雏。\n摘来不用供调鼎，且唤曲生相管领。\n等閒一醉一千年，莫遣东风吹酒醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21333,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"潜上人求菊山","author":"释道璨","text":"具郎号菊山，秀色已衰朽。\n潜郎号菊山，清香满襟袖。\n天地一东篱，万古一重九。\n绝爱陶渊明，揽之不盈手。\n后人不识秋，多向篱边守。\n璨璨万黄金，把玩岂长久。\n西风容易老，回首已如帚。\n因潜忆具郎，有泪如苦酒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21334,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题于潜西菩兼山阁参寥受业","author":"释道璨","text":"青山在屋头，易见甚难识。\n如玉有碎气，如土有正色。\n平生万里眼，付此千丈壁。\n云行山欲动，云深山更碧。\n动止同一机，兼处贵自得。\n心外无青山，身外无周易。\n安得识山人，倚阑论未画。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21335,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题会稽孙竹阁望梅亭","author":"释道璨","text":"梅梁在屋东，梅溪在屋西。\n举头东西望，古意入双眉。\n彼溺犹己溺，彼饥犹己饥。\n皇皇圣人心，万世同一机。\n诚明与物欲，方寸分町畦。\n火然而泉达，扩充无边涯。\n禹亦何人哉，勉之宜及时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21336,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题和山推蓬看梅","author":"释道璨","text":"沙头寒声入芦苇，沙际暝烟湿微雨。\n疏花明在树梢头，吟身卧在船蓬底。\n相看一笑大江横，白鸟不飞天似水。\n逃禅英骨閟九原，褚郎有神呼得起。\n倔强横枝不受屈，玲珑孤标净如洗。\n春风满面吹不开，冰雪满身冻不死。\n岁寒心事谁得知，大似和山隐君子。\n我有扁舟蓑笠盟，落在吴头并楚尾。\n挑灯今夜不成眠，免得相寻来梦里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21337,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题饶德操关子长紫芝诗轴","author":"释道璨","text":"郭家墓田土花碧，轮菌紫芝大盈尺。\n淋浪雨泪种得成，不识春风生长力。\n晴云练练依遥岑，霁月烱烱悬崖阴。\n苦心实竹谁赏识，青山重叠黄泉深。\n两翁落笔九天上，发煇潜德光千丈。\n此卷长留天地间，灵芝万古常无恙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21338,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题善住阁","author":"释道璨","text":"阁前溪水声潺湲，阁后山色空巑岏。\n取之不得舍不得，善住道人如是观。\n浩荡春风满天地，飞絮游丝无定处。\n去无所至来无踪，善住道人如是住。\n有所住兮成守株，鱼止泺兮鸟栖芦。\n无所住兮成漫浪，空中迹兮镜中像。\n道人一笑璨琳琅，住不住兮吾已忘。\n閒倚阑干春昼长，眼看白鸟浮沧浪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21339,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题源虚叟庐山行卷","author":"释道璨","text":"胸中有庐山，笔下有庐山。\n窗下有庐山，眼中有庐山。\n别山十七年，见山一日间。\n韵险落鬼胆，语妙破天悭。\n永怀看山人，恨不同跻攀。\n摩挲青石砚，负山良厚颜。\n天风几时来，乘之欲西还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21340,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠观妙道士","author":"释道璨","text":"妙处不可观，可观非是妙。\n杳杳无方所，冥冥无朕兆。\n我观三十年，力尽不能透。\n及其会心时，忻然惟一笑。\n碧桃开晚花，黄鹂啭春昼。\n大哉众妙门，老子亲传授。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21341,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠明侍者","author":"释道璨","text":"好诗无音律，至文难言说。\n学之无他术，先要心路绝。\n兀坐送清昼，万事付一拙。\n如是三十年，大巧自发越。\n万象赴陶冶，百怪乞提挈。\n兴来忽运笔，妙处无前哲。\n古来翰墨士，外此别无诀。\n明也江南来，俊气方烈烈。\n乘潮观海门，入越探禹穴。\n须从言外参，莫向纸上窃。\n此方吾必秘，为子轻漏泄。\n慎勿语俗子，只可自怡悦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21342,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蹋雪下云居山宿崇寿寄草堂","author":"释道璨","text":"别山三十年，见山双眼碧。\n山灵喜我来，一笑作戏剧。\n纵横万花舞，变乱山颜色。\n圭璧拔地起，自在群玉国。\n去兴纷莫留，下足深没膝。\n冻合坡长短，石碍路剞侧。\n跻攀脚未稳，失势落数尺。\n平生江海屐，常患天地窄。\n立处贵稳密，取道贵径直。\n只要缓步行，不在多用力。\n祇以到为期，半途肯休息。\n须臾到山趾，坦途随意适。\n回看行路处，倚天立青壁。\n极爱山上云，长年抱幽石。\n耐得许多清，一夜遥相忆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21343,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"布袋赞 其一","author":"释道璨","text":"布袋无口，拄杖无枝。\n靠定这个，有甚了期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21344,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十五首 其九","author":"释道璨","text":"开眼便是，开口便是。\n举手便是，举足便是。\n虽然如是，未是未是。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21345,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十五首 其八","author":"释道璨","text":"仰山撼树，沩山良久。\n说体说用，互扬家丑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21346,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十二首 其八","author":"释道璨","text":"不拨一境，不露一机。\n锦包特石，绵裹秤椎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21347,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十二首 其七","author":"释道璨","text":"临济一喝，德山一棒。\n霹雳电光，宁容近傍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21348,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十二首 其一","author":"释道璨","text":"无个入处，奔走杀人。\n有个入处，碍塞杀人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21349,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十八首 其十三","author":"释道璨","text":"至日书云，云作何色。\n眼里无筋，青黄赤白。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21350,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十八首 其三","author":"释道璨","text":"鼓棹扬帆，驾没底船。\n横行海上，神头鬼面。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21351,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十八首 其一","author":"释道璨","text":"天高地厚，日盈月昃。\n全提半提，天地悬隔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21352,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十二首 其一","author":"释道璨","text":"隐山无量罪过，复被公安追到。\n要得重整颓纲，不免再升此座。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21353,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十七首 其二十一","author":"释鼎需","text":"路穷崖断进无门，赖有山翁指出原。\n九曲黄河清彻底，谁知别是一乾坤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21354,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十七首 其十四","author":"释鼎需","text":"一不问兮二不休，直须识取那钩头。\n再三回首来相见，急水波心辊绣毬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21355,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十七首 其十三","author":"释鼎需","text":"京师出大黄，不许谩商量。\n贵买还贱卖，才吃便承当。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21356,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十七首 其十一","author":"释鼎需","text":"昨夜三更转向西，昏昏宇宙几人迷。\n澄潭影转风初息，猿狖微闻岭外啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21357,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十七首 其六","author":"释鼎需","text":"镆铘在握当堂坐，拟欲冲前便丧躯。\n纵使机锋如电拂，到头未免病栖芦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21358,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十七首 其五","author":"释鼎需","text":"王令威严谁敢拟，纤毫才动铁轮随。\n时人只见锥头利，几人能见利头锥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21359,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十七首 其四","author":"释鼎需","text":"大义开田创祖基，分明书契示传持。\n儿孙不肯遗先业，乞食年年役路歧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21360,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十七首 其三","author":"释鼎需","text":"父子相将草里游，人前拈弄几包羞。\n返雷一震惊天地，直得沧溟绝点流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21361,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十七首 其二","author":"释鼎需","text":"打车即是打牛是，鼻孔辽天也被穿。\n已向人前输肺腑，可怜今古妄加鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21362,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四首 其三","author":"释鼎需","text":"闭门入圃太周遮，一唤回头便到家。\n良遂知时人不委，海山空映夕阳斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21363,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四首 其一","author":"释鼎需","text":"入息未尝居阴界，出息何曾涉万缘。\n一声渔笛离南浦，依旧芦花深处眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21364,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二十首 其二十","author":"释鼎需","text":"西天悉达多太子，今日降神出母胎。\n一步一莲随宝足，人间天上独崔嵬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21365,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十五首 其三","author":"释宝印","text":"虎头带角人难措，石火电光须密布。\n假饶烈士荐应难，懵底如何善回互。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21366,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二十首 其十三","author":"释鼎需","text":"人间正月十五日，西来祖意若为陈。\n楼台上下火照火，车马往来人看人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21367,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二十首 其七","author":"释鼎需","text":"昨夜三更转向西，昏昏宇宙几人迷。\n澄潭影转风初息，孤狖微闻岭外啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21368,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自赞","author":"释鼎需","text":"一不爱乖崖傲物，又不爱像楼打楼。\n饱谙世事慵开口，暗展双眉自点头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21369,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十七首 其十九","author":"释鼎需","text":"幽谷白云藏白雀，拟心栖处隔山迷。\n直饶不住栖心处，犹落怡山第二机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21370,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十七首 其十八","author":"释鼎需","text":"??鸟，守空池。\n鱼从脚底过，??总不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21371,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十七首 其十七","author":"释鼎需","text":"全锋敌胜铁牛机，电掣雷奔已是迟。\n等閒活捉卢陂老，纵饶猛略若为施。\n君不见，寰中意气，阃外威权，拟议冲前总灭门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21372,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十七首 其十六","author":"释鼎需","text":"畐塞虚空，不如不去。\n前后际断，今亦无住。\n倒骑佛殿出三门，却把三门挂露柱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21373,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十七首 其十五","author":"释鼎需","text":"云门大作师子吼，刚把衷肠为谁剖。\n眼似流星尚懵然，狂夫逐臭争知有。\n君不见，岩头有语兮，咬人屎橛非好狗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21374,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十七首 其十二","author":"释鼎需","text":"两个孩儿抱花鼓，左边打了右边舞。\n一曲两曲无人会，历历清风动千古。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21375,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十七首 其十","author":"释鼎需","text":"骑虎头，把虎尾，霹雳一声惊万里。\n坐观成败老将军，脑后一槌谁敢拟。\n拟不拟，个个无裈长者子。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21376,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十七首 其九","author":"释鼎需","text":"金木水火土，始终颠倒数。\n五六下四三，初爻传白虎。\n苦苦，卜得此卦一生贫，远信不来病人死。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21377,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十七首 其七","author":"释鼎需","text":"堪笑当年陆大夫，独誇身外更无馀。\n不因指出花如梦，争得双眸翳尽除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21378,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十七首 其一","author":"释鼎需","text":"鸟窠佛法无多子，只在褴襂一布毛。\n一气吹来何处去，至今天下有譊讹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21379,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四首 其四","author":"释鼎需","text":"言言言兮，飘风洒雪。\n默默默兮，雷輷电掣。\n藕丝孔里骑大鹏，等閒挨落天边月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21380,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四首 其二","author":"释鼎需","text":"池阳面壁许谁知，万古孤峰对落晖。\n才见攒眉便回去，早知不是丈夫儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21381,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二十首 其十七","author":"释鼎需","text":"三月安居，九旬禁足。\n物外閒人，何拘何束。\n青绢扇子足风凉，一任山青并水绿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21382,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二十首 其十六","author":"释鼎需","text":"死中活，閒云散尽长空阔。\n活中死，螺江水流截不住。\n两岸芦花相对开，渔翁拨棹还归去。\n去去何处，寒梅已绽岭南枝，漫漫雪覆千峰寺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21383,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二十首 其十四","author":"释鼎需","text":"一不得孤负自己，二不得停囚长智。\n三不得生心比拟，拟不拟，眨起眉毛千万里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21384,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二十首 其十一","author":"释鼎需","text":"陜府铁牛吞大像，生得河东鸑鷟儿。\n海门深处宜归隐，只恐调高人不知。\n知不知，拟欲抬眸一顾之，早是失却两茎眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21385,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二十首 其十","author":"释鼎需","text":"行亦禅，坐亦禅，语默动静体安然。\n江上晚来堪画处，一叶扁舟破远烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21386,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]