[{"title":"和王宫教送酒韵","author":"王炎","text":"不肯独醒如屈平，要于酒国立诗城。\n苍头满挹鸬鹚杓，中有春风习习生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15743,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和王宫教韵","author":"王炎","text":"六籍横陈日醉心，忍贫不肯问钱神。\n旁人但见门冰冷，岂识胸中暖似春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15744,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和何元清韵九绝 其二","author":"王炎","text":"丝竹无缘在后堂，肉羞不辨出东房。\n金徽弹罢惟清坐，共挹熏炉一穗香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15745,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和何元清韵九绝 其九","author":"王炎","text":"焦桐为我发哀弹，但觉清风绕指寒。\n老大虽思闻古调，莫弹别鹄感离鸾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15746,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和何元清韵九绝 其六","author":"王炎","text":"青眼虽惭阮嗣宗，为君解榻席相重。\n菜羹蔬食能甘否，自昔人言俭易容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15747,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和何元清韵九绝 其五","author":"王炎","text":"觅官安用羡登仙，求富何须愿执鞭。\n洙泗从游多达者，箪瓢颜子独称贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15748,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和何元清韵九绝 其四","author":"王炎","text":"老来视听稍精明，休问如何太瘦生。\n还信閒中安乐否，龟巢莲叶喜身轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15749,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和何元清韵九绝 其八","author":"王炎","text":"一洗平生筝笛耳，极知绿绮有遗音。\n君臣庆会休三弄，泉石膏肓不可针。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15750,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和何元清韵九绝 其七","author":"王炎","text":"莫年筑室北山边，自笑浑无塞屋钱。\n巾褐翛然穷亦乐，岂曾有梦到金莲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15751,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和何元清韵九绝 其一","author":"王炎","text":"春深绕屋绿阴稠，却扫无人识冗侯。\n独肯叩关相劳问，不妨挟册共藏脩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15752,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和吴秀才二绝 其二","author":"王炎","text":"世人相马苦嫌瘦，谁识龙媒气逸群。\n归傍青灯对贤圣，汉庭射策待方闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15753,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和吴秀才二绝 其一","author":"王炎","text":"句法洪徐可逼真，摩挲老眼见斯人。\n怜渠袖有钓鳌手，要试虹竿欠李绅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15754,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和周南吉二绝 其二","author":"王炎","text":"旧游追记岳阳城，莫惜经过憩旆旌。\n容易别离难会合，为君重酌圣人清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15755,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和周南吉二绝 其一","author":"王炎","text":"才谞诸公争汲引，文高后学共仪刑。\n相逢未觉功名晚，镜里依然两鬓青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15756,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和林宝文吹暑轩二绝 其二","author":"王炎","text":"藕花香里画船横，人静惟闻洗玉声。\n四野清平公燕喜，隐然方面有长城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15757,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和林宝文吹暑轩二绝 其一","author":"王炎","text":"木末长风送雨来，田家远近稻花开。\n披襟燕坐黄堂静，一笑江山爽气回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15758,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和林宝文喜雨","author":"王炎","text":"山椒霭霭暮云徂，一雨翻盆物尽苏。\n父老相逢笑相语，今年和气旧时无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15759,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和将使早雪","author":"王炎","text":"晓日藏明恐雪羞，远山含暝更云浮。\n不须苦道丰年瑞，拥衲炉边索酒舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15760,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和留宰赏荼蘼二绝 其一","author":"王炎","text":"郎官唤客坐花旁，尽日杯行笑语香。\n醉看绿云笼暖雪，不知憔悴落他乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15761,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和留宰赏荼蘼二绝 其二","author":"王炎","text":"得酒衰怀亦满觞，不禁花气逼人香。\n醒时忍见风吹尽，玉质温柔是故乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15762,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和萧参议游岳麓八绝 其六","author":"王炎","text":"每到精庐即少留，品题清境甲湘州。\n游山脚力犹强健，缓步曾登最上头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15763,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和萧参议游岳麓八绝 其五","author":"王炎","text":"清风峡里水清泠，不但琮琤可静听。\n秋桂秋兰在深谷，更堪鼻观挹幽馨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15764,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和萧参议游岳麓八绝 其一","author":"王炎","text":"登临须返意须留，目力无边不著愁。\n收拾风光归古锦，千岩万壑献清秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15765,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和萧参议游岳麓八绝 其三","author":"王炎","text":"凭栏落照俯江天，睥睨诗翁翰墨传。\n试为江山重著语，笔端桃李恰争妍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15766,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和萧参议游岳麓八绝 其二","author":"王炎","text":"逐客当年出帝乡，不容踪迹到黄堂。\n苍崖屐齿今安在，公独怀思未忍忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","pat