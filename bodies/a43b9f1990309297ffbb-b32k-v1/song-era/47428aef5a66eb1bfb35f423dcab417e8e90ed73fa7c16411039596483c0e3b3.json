[{"title":"金陵道中","author":"释斯植","text":"望远生愁思，凄凉处处同。\n青山迷旧冢，芳草蔽闲宫。\n雨过城楼月，潮回鼓角风。\n十年怀古恨，多在六朝中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18644,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨夜","author":"释斯植","text":"雨雪寒窗下，孤灯夜不眠。\n衰残如旧日，荣达是何年。\n已觉观书妄，方参入世缘。\n存心在仁理，何必后人传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18645,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日","author":"释斯植","text":"人生厌别离，老去更何为。\n独对清明雨，闲吟社日诗。\n野蜂成蜜早，海燕入帘迟。\n未尽寻春兴，应须愧后期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18646,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日同友人游湖上","author":"释斯植","text":"十里湖边路，垂杨映马蹄。\n水光平野阔，山影绕楼低。\n夜雨生青草，春风湿紫泥。\n兴来无限意，同此片时题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18647,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送人谒所知","author":"释斯植","text":"西风忽别离，满袖百篇诗。\n取己尚如此，问人应可知。\n山寒城角远，地阔海帆迟。\n料想回车日，相看是岁期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18648,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送人游吴","author":"释斯植","text":"阖门烟霭外，地阔水城高。\n蜃气蒸吟鬓，霜风入缊袍。\n数程秋岸雨，一饭野船蒿。\n若问当时事，人誇有二豪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18649,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送灵耀之姑苏","author":"释斯植","text":"一身唯在道，清苦独知君。\n世路终成别，山光不共分。\n晚天寒欲雨，春树夜生云。\n此去他乡寺，猿声各自闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18650,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送故人之天台","author":"释斯植","text":"新绿又成阴，归期直到今。\n人行芳草远，犬吠落花深。\n野店春寒雨，江城橘树林。\n无情名利事，休系一生心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18651,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送觉上人","author":"释斯植","text":"送君千里去，又见落花飞。\n水国今宵别，天涯隔岁归。\n岸多春树密，滩小夕阳微。\n后夜扁舟月，应逢宿鸟稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18652,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送敏上人归永嘉","author":"释斯植","text":"风光苦变迁，客里对残年。\n别我此时路，问乡何处船。\n断云连雨雪，落日远人烟。\n又向龙湫畔，开扉近瀑泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18653,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送隐士游京淮","author":"释斯植","text":"送君湖柳下，未别已关情。\n古塞去程远，寒江入梦清。\n野云低水树，山雨闭春城。\n到处逢知己，虚传隐姓名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18654,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽白云赵宗丞","author":"释斯植","text":"天上楼成日，人间独丧君。\n料知生死事，还与去来分。\n夜月江村路，春风岭树云。\n交馀多感槩，那忍见遗文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18655,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽芸居秘校","author":"释斯植","text":"世上名犹在，闲情岂足悲。\n自怜吟日少，唯恨识君迟。\n兰阁人亡后，寒林月上时。\n十年青史梦，只有老天知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18656,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"效樊川体","author":"释斯植","text":"吟边绕架书千卷，壁上梅花水一瓢。\n世事尽从忙里过，年华空向静中消。\n山云宿雨笼残日，汀草浮香满小桥。\n对此不须惆怅去，野人今已悟吹箫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18657,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"旅中偶成","author":"释斯植","text":"风吹客袂寒，飘泊在长安。\n对雨春题尽，看云夜坐残。\n远山平楚水，苍汉接吴滩。\n遥忆天台寺，相携去不难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18658,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"旅中寄故人","author":"释斯植","text":"世路长安里，三年别钓矶。\n只因吟事僻，宁免识人非。\n性拙趋时少，家贫过客稀。\n春风归去日，同采故山薇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18659,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"旅怀","author":"释斯植","text":"十年不倚谢公楼，满眼凄凉上客舟。\n往事尽随流水去，青山长忆故人游。\n海门风起天将暮，渡口云生树欲秋。\n络纬自啼花自落，更堪回首是他州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18660,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偶成柬续芸","author":"释斯植","text":"相看又一春，花乱马前尘。\n湖海他乡路，烟霞几处人。\n草连闲地远，鸟入暮山频。\n多少凄凉事，那堪白发新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18661,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿云山房","author":"释斯植","text":"缥渺沉虚碧，清池见宿云。\n松声临石断，山影与泉分。\n芳草经年梦，幽禽隔径闻。\n倚栏吟未尽，红日又将曛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18662,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄梅叟法师","author":"释斯植","text":"一从飞锡后，迢递各天涯。\n春事随流水，行人问落花。\n住当南岳寺，门对赤城霞。\n遥忆焚香处，松高月影斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18663,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄深居冯发管","author":"释斯植","text":"相怀千里外，空望极遥天。\n处世唯今日，看花忆去年。\n春风生岛树，夜月满渔船。\n此后闲寻处，应须借榻眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18664,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄彭泽后人","author":"释斯植","text":"不为折腰事，田园足野情。\n笔粘春雾重，诗带晚唐清。\n柳巷闲渔艇，山扉对水城。\n论心暂来往，无愧远公名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18665,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄静佳朱明府","author":"释斯植","text":"翰苑留名久，城边半掩扉。\n声随淮水远，吟入楚天微。\n吏静看山坐，乡遥抚剑归。\n清虚无别事，嘉政在璇玑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18666,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"喜人归幽栖","author":"释斯植","text":"霄汉分携久，吟怀思欲迷。\n相逢春草外，归隐石房西。\n涧急禽声少，松摇月影低。\n要知人静夜，犹自怯猿啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18667,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登云汉阁","author":"释斯植","text":"高阁势凌虚，天涯入望微。\n云藏山鸟影，春满野人衣。\n积雨催花尽，寒樵背日归。\n焚香端坐处，似觉世尘稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18668,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登吴山","author":"释斯植","text":"嵯峨宫树霭晴空，吴越迢迢一望中。\n几处笙歌人远近，万重花柳路西东。\n风生帘幕春云碧，水绕楼台海日红。\n沙鸟自飞还自宿，百年无计与谁同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18669,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赋老将","author":"释斯植","text":"猎猎征旗促晓鞍，几回临阵练兵官。\n黄沙满塞黄云暗，白马嘶风白日寒。\n汉语肯随蛮地改，战袍犹带血腥乾。\n如今韬略浑无用，瘦骨萧条甲胄宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18670,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"道宫","author":"释斯植","text":"千年兴废地，仙诀字犹存。\n露重云生树，坛空月到门。\n心清无外事，静极是真源。\n此境非凡世，何人与续言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18671,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"塞北","author":"释斯植","text":"兵战何时息，边尘染客旌。\n乱鸦啼又歇，荒草死还生。\n岛雨连秋曙，江风入雁声。\n近淮民自悦，应是宦情清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18672,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"遣怀","author":"释斯植","text":"愁极鬓成丝，沧江梦未归。\n鸟啼山雨急，春尽故人稀。\n晓润侵吟壁，寒云绕竹扉。\n向来诗满束，应是与心违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18673,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"暮春雨中感怀","author":"释斯植","text":"回首郡城东，春残碧树中。\n落花千点恨，疏雨一帘风。\n白雪侵新鬓，归心逐断鸿。\n茫茫事如此，何必怨途穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18674,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"暮春感怀呈勿斋提举","author":"释斯植","text":"浮世事非真，吟多白发新。\n身居京寺久，梦到石桥频。\n日落烟生树，花残草自春。\n坐看今夜月，应与旧房邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18675,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"韬光庵","author":"释斯植","text":"石涧长松行十里，杖藜从此得迟留。\n青霄望去山河远，白水看来日月流。\n老树叶残霜鬼哭，断崖云冷洞猿愁。\n韬光名在身何在，今古茫茫几白头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18676,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题天竺岩栖山房","author":"释斯植","text":"一室寄云隈，凭栏日几回。\n无风山自雨，有主燕还来。\n野径通樵远，岩花向晚开。\n旧时题数壁，今已半苍苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18677,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题彭泽后人吟楼","author":"释斯植","text":"结屋在云端，悠然趣自安。\n江山随望远，星月近人寒。\n剑气当空正，诗情对酒宽。\n往来庭畔叟，只作晋时看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18678,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与子入山来","author":"释斯植","text":"与子入山来，永夜不得睡。\n但闻松子声，敲落梧桐树。\n月到窗愈明，秋风泻流水。\n古奏三两弦，知音不知处。\n唯有白面猿，闲中自来去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18679,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山中寓意","author":"释斯植","text":"白发今如许，自吟还自愁。\n满山晴叶雨，四壁老蛩秋。\n看水知心静，观云觉事浮。\n数年衰感意，挥泪不能收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18680,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"从军行","author":"释斯植","text":"茫茫塞月笼寒雾，万里征人不知数。\n年少难消壮志多，精锐连营肃貔虎。\n从军何日见军回，但见日日长淮雨。\n烽烟散漫满路岐，边声飒飒秋风起。\n天涯荒草马成群，放去弯弓乱飞舞。\n夜深更听胡女歌，古来白骨多于土。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18681,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"丙辰季夏雨中","author":"释斯植","text":"天涯身尚寄，何日向东州。\n一夜霜欺鬓，连朝雨送愁。\n梦多吟作祟，闲极懒为雠。\n若问浮生事，无心即是谋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18682,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"丙辰季夏避暑山中长松脩竹恍若蓬莱异人之居走笔索句以纪其事","author":"释斯植","text":"六月厌烦襟，纵步情未足。\n爱此石径长，缈缈清溪曲。\n古道何人居，门闲对脩竹。\n好鸟发新声，静极成幽独。\n山风吹晚凉，山影摇红绿。\n翘首兴未阑，青猿睡初熟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18683,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"古乐府 其四","author":"释斯植","text":"早作西州行，暮作西州宿。\n杨柳忽风生，年年芳草绿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18684,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"古乐府 其一","author":"释斯植","text":"携君石上琴，弹我窗前月。\n月缺又还圆，谁能免离别。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18685,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"古乐府 其七","author":"释斯植","text":"晚步入松阴，敛霁人影绝。\n唯闻太古音，听之心胆裂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18686,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"古乐府 其六","author":"释斯植","text":"山鸡啼一声，深院日当午。\n世无同心人，入此薜萝里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18687,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"古乐府 其五","author":"释斯植","text":"兰死根亦香，人死不知处。\n人死不堪悲，兰香化为雾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18688,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"古乐府 其三","author":"释斯植","text":"欲买采菱船，野水无人识。\n野水去不回，迢迢暮山碧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18689,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"古乐府 其八","author":"释斯植","text":"一入经战场，白马不足数。\n白马不敢嘶，春风在场圃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18690,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"古乐府 其二","author":"释斯植","text":"青山叫子规，行人泪如雨。\n子规不肯归，行人不能去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18691,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"古乐府 其九","author":"释斯植","text":"青云千里心，白鹭一点雪。\n谁将玉笛吹，吹下关山月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18692,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"对梅分韵得堂字","author":"释斯植","text":"霜风吹短发，值此天气凉。\n行行阴壑中，万树皆含芳。\n相对发微咏，安用持华觞。\n嗟彼咸平人，清风生我肠。\n花非不及时，众鸟何回翔。\n归看两壁间，画者犹苍苍。\n抱此幽露姿，愿登君子堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18693,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江村晚望","author":"释斯植","text":"何处问归程，沧茫入句清。\n云生峰顶白，月近水边明。\n芳草连平楚，晴楼出远城。\n此身南北外，渔火是闲情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18694,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"池上曲","author":"释斯植","text":"晓雨生池荷，圆珠漾新绿。\n入手不成珠，空歌彩莲曲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18695,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西园即事","author":"释斯植","text":"一径落花红，回廊复旧踪。\n千峰遥隔水，万木远涵空。\n沙鸟晴云外，寒帆夕照中。\n几宵曾宿此，江月夜相通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18696,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西湖晚望","author":"释斯植","text":"久雨初晴睡正长，春蛙鸣遍旧池塘。\n小亭寂寞斜阳里，一阵东风过木香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18697,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闲观","author":"朱继芳","text":"闲观造化馀，静极悦自性。\n胡蝶忽飞来，吾心已无竞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18698,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"远山","author":"释斯植","text":"万里色苍然，春烟夕照边。\n旧过南岳寺，曾向雨中看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18699,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和子履雍家园","author":"苏舜钦","text":"长桥南走群山间，中有雍子之名园。\n苍云蔽天竹色净，暖香扑地花气繁。\n飞泉来从远岭背，林下曲折寒波翻。\n珍禽不可见毛质，数声清绝如哀弹。\n我来踞石弄琴瑟，唯恐日暮登归轩。\n尘纷剥落耳目异，只疑梦入仙家村。\n君之襟尚我同好，作诗闳放莫可攀。\n高篇绝景两不及，久之想像空冥烦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18700,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鸣鸠","author":"释斯植","text":"何处芳草多，相呼向深坞。\n竹外立寒枝，山南又春雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18701,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"客路和胡元鲁出入韵","author":"释斯植","text":"十载天涯客，浮云不定身。\n烟波春雨渡，灯火夜渔村。\n世事空为累，人心未觉仁。\n何时留片石，归老古松根。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18702,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"柳","author":"释斯植","text":"汴水隋堤总寂寥，春风吹恨未曾消。\n长条本自无拘束，也向人前学舞腰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18703,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送人之吴","author":"释斯植","text":"无心学隐沦，此去向吴津。\n千古是非地，一灯烟雨村。\n烽尘连楚戍，榆柳隔淮春。\n别后新吟句，何人可共论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18704,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送李容甫归北都","author":"释斯植","text":"先生读书不下堂，堂上有客语浪浪。\n弟子出观如堵墙，怪君眉彩生光芒。\n北都晁夫子，一别久相望。\n君来道信问，使我开肺肠。\n三日不改服，犹觉芝兰香。\n平生寡投分，一笑且云乐。\n慇勤发黄卷，钝吻悭应酢。\n大杵撞哑钟，已厌音响恶。\n更惭河伯观，未易穷海若。\n索寞岁华晚，飕飕黄叶秋。\n归心剧流水，忽忽不可留。\n固知此鳣鲸，肯托寻常沟。\n直须见老聃，可化南荣俦。\n海州岁有冲天鹄，卵如萍实光琢玉，蜀鸡眇然何敢伏。\n羽成不须求日浴，一举将惊万人目。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18705,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送故人之江东","author":"释斯植","text":"凤城花气浥旌旗，又见春风上马时。\n不是灞桥难话别，垂杨空折去年枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18706,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻子规","author":"释斯植","text":"十年已起故乡情，客里凄凉不耐听。\n啼到蜀天空有恨，水流依旧月还明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18707,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽周彦良","author":"释斯植","text":"白首功成未十年，寡妻相吊泣江干。\n诗名似水声还远，世事如云梦已残。\n杨柳满堤人去后，海棠深巷雨初乾。\n东风忽起青山泪，虽有君书不忍看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18708,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"铁笛倦长吹","author":"释斯植","text":"铁笛倦长吹，虚空剑寒倚。\n俯仰阴晴天，泰山不可视。\n荡桨归白云，回首沧波里。\n人生无百年，世事已如此。\n既与荣辱同，兴废乃相似。\n春风从何来，纷纷竞桃李。\n至士本无心，误为诗所使。\n纵步夕照间，养性在芳芷。\n天涯一夜杜鹃愁，万里行人度湘水。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18709,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿云轩","author":"释斯植","text":"千峰云未还，数树芭蕉绿。\n风雨暗黄昏，何人共幽独。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18710,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄衣曲 其二","author":"释斯植","text":"自君之出矣，欲寄征衣泪如雨。\n征衣未寄心已悲，一寸相思隔千里。\n湘江水是巫山云，巫山云是湘江水。\n湘江两岸芳草深，湘江日夜多行人。\n行人去去天之涯，门对落花三两家。\n家家有酒讴且歌，醉来月下弹琵琶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18711,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄衣曲 其一","author":"释斯植","text":"自君之出矣，壁上琵琶君记取。\n日日望君君不归，自君去后徒相忆。\n欲剪征衣寄赠君，天涯望断无消息。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18712,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪鸪","author":"释斯植","text":"风吹芦苇鸣，残雪满桥板。\n不见棹回人，愁立沙汀晚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18713,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]