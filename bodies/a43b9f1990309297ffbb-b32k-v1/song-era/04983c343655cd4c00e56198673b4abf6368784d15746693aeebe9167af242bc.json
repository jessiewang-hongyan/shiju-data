mmit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33440,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杂咏六言八首 其一","author":"刘克庄","text":"退之效玉川体，子美和舂陵行。\n古训后生可畏，俗语文人相轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33441,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"竹溪再和余亦再作 其七","author":"刘克庄","text":"竹马恍曾聚戏，金鱼从美外观。\n随柱史青牛易，骑吕仙黄鹤难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33442,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"竹溪再和余亦再作 其八","author":"刘克庄","text":"掇英可以忘忧，采薇可以求仁。\n忙杀遮西日客，愧死攫白昼人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33443,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"竹溪再和余亦再作 其二","author":"刘克庄","text":"老丑难瞒青镜，纯白不生黑丝。\n露顶秃鹙堪笑，垂头病鹤可怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33444,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"竹溪再和余亦再作 其一","author":"刘克庄","text":"帝率耆英入社，攀留穷鬼忘年。\n华胥国在吾宇，桃花源有别天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33445,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"竹溪再和余亦再作 其四","author":"刘克庄","text":"薄雾乍舒乍卷，空花是假是真。\n昔曾有刮膜者，世岂无明眼人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv