[{"title":"幽居述事四首 其二","author":"陆游","text":"颓然掩户不妨奇，又赋幽居第二诗。\n大药鼎成令虎守，精思床稳用龟支。\n壶中自喜乾坤别，局上元知日月迟。\n更就群童闲斗草，人间何处不儿嬉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9143,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"幽居述事四首 其三","author":"陆游","text":"落叶平沟日满廊，幽居又赋第三章。\n喜无俗事干灵府，恨不终年住醉乡。\n上树榜船虽老健，疏泉移竹亦穷忙。\n山僧欲去还留话，更尽西斋一炷香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9144,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"幽居述事四首 其四","author":"陆游","text":"舴艋东归喜遂初，频拈枯笔赋幽居。\n细烧柏子供清坐，明点松肪读道书。\n苍爪嫩芽开露茗，红根小把瀹烟蔬。\n年来自许机心尽，颇怪飞鸥自作疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9145,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"幽居述事四首 其一","author":"陆游","text":"曾会兰亭醉堕簪，后身依旧住山阴。\n琴传数世漆文断，鹤养多年丹顶深。\n涤砚滩头无渍墨，吹箫月下有遗音。\n小诗戏述幽居事，后有高人识此心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9146,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"幽居春夜","author":"陆游","text":"暮景催人雪鬓双，十年始复反吾邦。\n云逢佳月每避舍，酒压闲愁如受降。\n三弄笛声初到枕，一枝梅影正横窗。\n要知清梦游何许，不钓桐江即锦江。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9147,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"幽居春晚二首 其一","author":"陆游","text":"云归禹穴赏新晴，酒买兰亭散宿酲。\n竹带鞭移俄盛出，鹤全窠买已长鸣。\n故山虽愧收身晚，外物元如脱发轻。\n只恐村邻成间阔，杖藜随处叩柴荆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9148,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"幽居春晚二首 其二","author":"陆游","text":"老废雠书病废诗，昼闲惟与睡相宜。\n未寻内史流觞地，又近庞公上冢时。\n花发游蜂喧院落，笋长驯鹿入藩篱。\n石帆山下春如许，野老来招不用辞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9149,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"幽居夏日二首 其二","author":"陆游","text":"内史兰亭晚卜邻，永和风月凛如新。\n功名不入闲人梦，诗酒犹关老子身。\n檐浅时时闻霣箨，池清一一见潜鳞。\n正令未逐飞仙去，要是巢居太古民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9150,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"幽居夏日二首 其一","author":"陆游","text":"茅舍参差烟霭中，超然高兴与谁同。\n形骸已与流年老，诗句犹争造物功。\n子母瓜新间尊俎，公孙竹长映帘栊。\n日长愈觉闲无事，隐具成书又一通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9151,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"幽居晚兴","author":"陆游","text":"借锄斸药喜微香，汲井浇花趁晚凉。\n胸次何曾横一物，尊前尚欲笑千场。\n锦江秋雨芙蓉老，笠泽春风杜若芳。\n归去自佳留亦乐，梦中何处是吾乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9152,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"幽居感怀","author":"陆游","text":"偶傍枫林结数椽，东归也复度流年。\n汀洲雁下依残水，墟里人行破夕烟。\n十月风霜欺客枕，五更鼓角满江天。\n散关清渭应如昨，回首功名一怆然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9153,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"幽居遣怀三首 其二","author":"陆游","text":"斜阳孤影叹伶仃，横案乌藤坐草亭。\n闲久更知贫有味，病多那责药无灵。\n农书甚欲从师授，忍字常须作座铭。\n更喜友生能饷酒，欣然一醉倒长瓶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9154,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"幽居遣怀三首 其一","author":"陆游","text":"大患元因有此身，正须枵腹对空囷。\n扶持接客宁嗟老，质贷迎医未厌贫。\n碓下罕遗鸡啄粒，席间不扫鼠行尘。\n时时笑顾儿曹说，纵有烟霄莫问津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9155,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"幽居遣怀三首 其三","author":"陆游","text":"习气深知要扫除，时时褊忿独何欤。\n呼童不应自生火，待饭未来还读书。\n世态讵堪闲处看，俗人自与我曹疏。\n作诗未必能传后，要是幽怀得小摅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9156,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"幽栖二首 其二","author":"陆游","text":"自卜幽栖地，频惊岁月移。\n乡邻崇礼让，子弟习书诗。\n喔喔鸡鸣树，狺狺犬吠篱。\n谋生已过足，富贵亦何为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9157,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"幽栖二首 其一","author":"陆游","text":"幽栖少人客，积病得衰残。\n身纳分司禄，儿须远次官。\n新寒换衣典，闲日借书观。\n更叹秋来瘦，晨兴觉帽宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9158,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"幽栖","author":"陆游","text":"何处是幽栖，城南路少西。\n杨花穿户入，燕子避帘低。\n棋局聊相对，茶炉亦自携。\n溪头云易合，晚雨又成泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9159,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"幽栖二首 其二","author":"陆游","text":"谁谓幽栖陋，茅茨足庇床。\n雨便梧叶大，风度楝花香。\n浴佛儿童喜，缫丝妇女忙。\n朅来三十载，吾鬓固宜霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9160,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"幽栖二首 其一","author":"陆游","text":"闲人了无事，地僻称幽栖。\n䑔米留鸡食，移琴避燕泥。\n桐生窗欲暗，笋长径还迷。\n不作容车计，门闾尽放低。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9161,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"幽情","author":"陆游","text":"免归又破六年闲，每寄幽情烟水间。\n清镜不藏新白发，芳樽犹惜旧朱颜。\n一编蠹简心空在，百瓮寒齑债未还。\n莫为岷峨劳梦想，故乡随分有名山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9162,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"庭中夜赋","author":"陆游","text":"流汗沾衣不自支，庭中散发立多时。\n乌乌画角凌风起，淡淡银河拂地垂。\n浮玉闲游元自乐，浣花小筑亦何疑。\n东归万里君知否，要了沧洲一段奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9163,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"待青城道人不至","author":"陆游","text":"我亦从来薄世缘，偶然采药到西川。\n慵追万里骑鲸客，且伴千年化鹤仙。\n金鼎养丹暾海日，玉壶取酒醉江天。\n朝来坐待方平久，读尽黄庭内外篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9164,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"思子虡","author":"陆游","text":"里堠迢迢阻问津，年光冉冉苦催人。\n未能免俗予嗟老，岂不怀归汝念亲。\n家酿湖莼谁共醉，江云淮月又经春。\n新诗题罢无从寄，独倚危阑一怆神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9165,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"思归","author":"陆游","text":"白发满青镜，怅然山水身。\n那因五斗米，常作半涂人。\n涉世风波恶，思归怀抱真。\n会当求鈯斧，送老镜湖滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9166,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"思归","author":"陆游","text":"短发今年雪满巾，一杯且醉瓮中春。\n定无术致长生药，那得愁供有限身。\n碎枕不求名利梦，挽河尽洗簿书尘。\n江湖意决君知否，致主唐虞自有人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9167,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"思归示儿辈","author":"陆游","text":"睡味甜如蜜，人情冷似浆。\n流年垂及耄，客子固多伤。\n兴发鸡豚社，心阑翰墨场。\n吾儿姑力穑，莫羡笏堆床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9168,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"思剡","author":"陆游","text":"羸疾无休日，清秋适此时。\n节存旄尽落，带剩眼频移。\n吾兴复不浅，俗人那得知。\n会当游剡去，支许有深期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9169,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"思蜀四首 其一","author":"陆游","text":"思蜀寸心折，归吴双鬓衰。\n今年脱虎口，昨夜梦蟆颐。\n死隔平时友，愁吟别后诗。\n江山应好在，谁记踏青期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9170,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"思蜀三首 其三","author":"陆游","text":"谭侯才气敌文园，日日银鞍画戟门。\n奇句入神闻鬼泣，巨觥如海看鲸吞。\n一官胄监能令死，万里铭旌忍更论。\n湖上秋来频入梦，凭谁词翰与招魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9171,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"思蜀三首 其一","author":"陆游","text":"园庐已卜锦城东，乘驿归来更得穷。\n只道骅骝开道路，岂知鱼鸟困池笼。\n石犀祠下春波绿，金雁桥边夜烛红。\n未死旧游如可继，典衣犹拟醉郫筒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9172,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"思蜀","author":"陆游","text":"西游陈迹浩无穷，回首真同一梦中。\n柳拂驿墙思凤集，鼓喧市里忆蚕丛。\n故人丘垄秋芜碧，旧隐园林夕照红。\n自闵未能忘感慨，浩歌弹剑送飞鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9173,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"思蜀","author":"陆游","text":"老子馋堪笑，珍盘忆少城。\n流匙抄薏饭，加糁啜巢羹。\n柑美倾筠笼，茶香出土铛。\n西郊有旧隐，何日返柴荆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9174,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"思蜀四首 其三","author":"陆游","text":"来从云栈北，行度雪山西。\n故事谈金马，遗踪访石犀。\n闲情淡于水，豪饮醉如泥。\n坏壁尘封遍，何人拂旧题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9175,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"思蜀四首 其四","author":"陆游","text":"玉食峨嵋栮，金齑丙穴鱼。\n常思晚秋醉，未与故人疏。\n白发当归隐，青山可结庐。\n梅花消息动，怅望雪消初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9176,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"思蜀四首 其二","author":"陆游","text":"一作剑关客，闲游将十年。\n不嫌狂骇俗，自许醉知天。\n瑞草溪桥路，青衣野庙壖。\n霜天猎归处，万里入横鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9177,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"思蜀","author":"陆游","text":"白首躬耕遇荐饥，江南自笑欲畴依。\n凌烟勋业无人许，濯锦园林有梦归。\n心似游僧思远适，身如败将陷重围。\n客来彊欲相宽释，每说人生七十稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9178,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"急雨","author":"陆游","text":"触热支离老病增，忽看东北片云兴。\n疾雷载雨输膏泽，茂树生风洗郁蒸。\n采药喜逢岷下客，说诗曾对剡中僧。\n坐令身在羲皇上，绕坐何烦更设冰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9179,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"急雨","author":"陆游","text":"阴云屯硖口，急雨过城头。\n白舫投沙峡，青帘捲市楼。\n漂摇争阖户，壅溢共疏沟。\n抽得驱蝇手，题诗慰旅愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9180,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"急雨","author":"陆游","text":"蜗庐四壁仅容身，赫赫炎曦不贷人。\n正喜风清三伏暑，已看雨压九衢尘。\n寒泉不减中?味，贡茗初尝正焙新。\n安得凌空双健羽，径随猿鹤上嶙峋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9181,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"急雨遽凉","author":"陆游","text":"急雨消残暑，旷然天地秋。\n露萤矜熠熠，风叶送飕飕。\n凉簟惟添睡，明河不洗愁。\n流年又如此，随处怯登楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9182,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"拜敕口号二首 其二","author":"陆游","text":"扶病中庭拜，君恩抵海深。\n顿增新禄格，暂拂旧朝簪。\n心欲先营酒，儿言且赎琴。\n人生奉祠贵，喜色动山林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9183,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挥手","author":"陆游","text":"挥手群玉府，说驾石帆山。\n偶与片云出，却随孤鹤还。\n松风暮萧瑟，石溜夜淙潺。\n阿敏读书处，更添茆一间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9184,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"故人赵昌甫久不相闻寄三诗皆杰作也辄以长句奉酬","author":"陆游","text":"海内文章有阿昌，数能著句寄龟堂。\n就令觌面成三倒，未若冥心付两忘。\n道义极知当负荷，风波那得易禁当。\n相思命驾应无日，且约陶然寓醉乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9185,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"故山四首 其二 禹祠","author":"陆游","text":"禹祠行乐盛年年，绣毂争先罨画船。\n十里烟波明月夜，万人歌吹早莺天。\n花如上苑常成市，酒似新丰不直钱。\n老子未须悲白发，黄公垆下且闲眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9186,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"故山四首 其一 镜湖","author":"陆游","text":"功名莫苦怨天悭，一棹归来到死闲。\n傍水无家无好竹，卷帘是处是青山。\n满篮箭竹瑶簪白，压担棱梅鹤顶殷。\n野兴尽时尤可乐，小江烟雨趁潮还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9187,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"故山四首 其四 云门","author":"陆游","text":"落涧泉奔舞玉虹，护丹松老卧苍龙。\n霜柑篱角寒初熟，野碓云边夜自舂。\n挈榼人沽村市酒，打包僧趁寺楼钟。\n幽寻自是年来懒，枉道山灵不见容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9188,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"故山四首 其三 梅山","author":"陆游","text":"老尉鸿飞隐市门，千年犹有旧巢痕。\n陆生于此寓棋局，曾丈时来开酒樽。\n渺渺帆樯遥见海，冥冥蒲苇不知村。\n数僧也复投诗社，零落今无一二存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9189,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"故里","author":"陆游","text":"故里淳风比结绳，归耕况遇岁丰登。\n已侵钟漏行安往，略有园庐退可凭。\n万事宁容愧天地，一心常若蹈渊冰。\n区区僻见君无怪，人固终身有不能。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9190,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"故里","author":"陆游","text":"漏尽钟鸣有夜行，几人故里得归耕。\n摧伤自喜消前业，疾恙天教学养生。\n邻曲新传秧马式，房栊静听纬车声。\n芋魁菰首君无笑，老子看来是大烹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9191,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日二首 其二","author":"陆游","text":"久抛朝帻懒重弹，华发萧然二寸冠。\n不恨凄凉侵晚境，犹能语笑向春盘。\n银杯酒色家家绿，箬笠烟波处处宽。\n一片梅花无复在，却嫌新暖换馀寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9192,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日","author":"陆游","text":"车马闲中绝，衣襦病后宽。\n改诗消昼永，赊酒敌春寒。\n柳细搓难似，花新染未乾。\n归鸿与来燕，各自管悲欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9193,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日","author":"陆游","text":"春来日日困春酲，徂岁如驰得我惊。\n山寺馈茶知谷雨，人家插柳记清明。\n登阶勃窣晨鸡老，侵路纵横野草生。\n堪叹筋骸犹健在，强随丁壮事深耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9194,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日二首 其一","author":"陆游","text":"老夫一卧三山下，两见城门送土牛。\n贫舍春盘还草草，暮年心事转悠悠。\n湖光涨绿分烟浦，柳色摇金映市楼。\n药饵及时身尚健，无风无雨且闲游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9195,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日","author":"陆游","text":"节节足足雀噪檐，朱朱白白花窥帘。\n坐旁设酒随时饮，床上堆书信手拈。\n寓世无求犹役役，杜门不病亦厌厌。\n春浓日永有佳处，睡味著人如蜜甜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9196,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日小园杂赋二首 其二","author":"陆游","text":"市尘不到放翁家，绕麦穿桑野径斜。\n夜雨长深三尺水，晓寒留得一分花。\n闷从邻舍分春瓮，闲就僧窗试露芽。\n自此年光应更好，日驱秧马听缫车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9197,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日小园杂赋二首 其一","author":"陆游","text":"久矣云霄铩羽翰，小园聊得赋春寒。\n风生鸭绿纹如织，露染猩红色未乾。\n不向山丘叹零落，且从儿女话团栾。\n人言麦信春来好，汤饼今年虑已宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9198,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日杂赋五首 其四","author":"陆游","text":"乞得身归剡曲边，衡门茅舍共萧然。\n向来误计守书册，此日遣愁无酒钱。\n俗客妒闲来衮衮，流年欺老去翩翩。\n梨花杨柳清明过，且向江村剩放颠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9199,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日杂赋五首 其五","author":"陆游","text":"人生觅饭元多术，最下方为禄代耕。\n脱却朝衫犹老健，快如苦雨得春晴。\n鸟声频唤五更梦，花气顿醒三日酲。\n最喜晨兴闻剥啄，吾儿书札到柴荆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9200,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日杂赋五首 其三","author":"陆游","text":"江湖放浪水云人，药物枝梧梦幻身。\n移竹南窗初试笋，扫花北陌旋成尘。\n穷忙自笑常终日，老健犹能不负春。\n未遂初心惟一事，乞薪赊米恼吾邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9201,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日杂赋五首 其二","author":"陆游","text":"鬓毛八九已成霜，此际逢春只自伤。\n苦雨不容花抵敌，馀寒犹赖酒禁当。\n退红衣焙熏香冷，古锦诗囊觅句忙。\n堪笑散人闲事业，西窗容易又斜阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9202,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日杂赋五首 其一","author":"陆游","text":"羁怀病思正厌厌，诗卷渔竿信手拈。\n老境何尝忘一笑，春风也解到穷阎。\n残花满地无馀萼，新笋掀泥已露尖。\n转老转穷君勿笑，熊蹯鱼腹岂容兼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9203,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日访客于逆旅及郊寺感而有赋","author":"陆游","text":"底事经年客帝乡，风光淡沲日初长。\n野歌作气老犹壮，花气撩人醒亦狂。\n店壁拂尘寻旧字，寺楼极目送斜阳。\n告归不过残春事，杜曲桑麻亦未荒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9204,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日园中作","author":"陆游","text":"杏花开过尚轻寒，尽日无人独倚阑。\n久别名山凭梦到，每思旧友取书看。\n尘埃幸已赊腰折，富贵深知欠面团。\n老去逢春都有几，一杯行复送春残。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9205,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日睡起","author":"陆游","text":"睡起悠然弄衲琴，铜猊半烬海南沉。\n凄凉故里逢春处，忠愤孤臣许国心。\n水满凫鹥初拍拍，雨馀花木已阴阴。\n吾儿捩柂淮边未，归近清愁转不禁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9206,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春兴","author":"陆游","text":"万事不关身，翛然一幅巾。\n虽非爱酒伴，犹是别花人。\n领略琴书意，扫空车马尘。\n东阡与南陌，随处梦残春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9207,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春尽记可喜数事","author":"陆游","text":"微雨洗浮埃，苍颜一笑开。\n僧招行药圃，儿报得琴材。\n病退初尝酒，春残已过灾。\n邻家赛神会，自喜亦能来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9208,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]