[{"title":"高座寺","author":"曾极","text":"石子冈前高座寺，犊车曾向此徘徊。\n清谈未解倾人国，更引番僧度海来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":522,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"商飙馆","author":"曾极","text":"商飙基在昔人非，草木犹为富贵移。\n曾是六朝歌舞地，黄花一半染胭脂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":523,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梁金华宫石","author":"曾极","text":"照影清溪眩怪奇，推迁十代市朝非。\n莫欺藓眼苍苔面，曾伴昭明识蔡妃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":524,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梦笔驿","author":"曾极","text":"晋尚清谈笔力衰，文章高下亦随时。\n景纯不作文通死，五色毛锥付与谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":525,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清凉广惠禅寺","author":"曾极","text":"鸣鞘响断苑墙平，敲戛惟闻风玉声。\n三百年间陵谷变，寒潮不到石头城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":526,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渔父","author":"曾极","text":"智士旁观当局迷，沧浪钓叟出陈诗。\n江头风怒掀渔屋，底事全家醉不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":527,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蛇盘驿","author":"曾极","text":"枳篱华屋半雕残，列肆屠羊客卸鞍。\n霸气销沉形影歇，龙盘何事作蛇盘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":528,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"黄天荡","author":"曾极","text":"受金纵敌将何知，曹沬功名失此时。\n雁足不来貔虎散，沙头蚌鹬谩相持。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":529,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游寒岩 其一","author":"曾极","text":"金玉其相一两花，遐心空为尔兴嗟。\n山矾不用来修敬，只许江梅共一家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":530,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游寒岩 其二","author":"曾极","text":"黄瑶白璧缀幽花，珍重高人为叹嗟。\n织女横河溪月堕，杯盘狼籍水仙家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":531,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"湘宫寺","author":"曾极","text":"数椽败屋湘宫寺，虞愿忠规正凛然。\n十级浮屠那复有，虚抛贴妇卖儿钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":532,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蒋帝庙","author":"曾极","text":"白马千年系庙门，炉烟浮动衮龙昏。\n阖棺谩说荣枯定，青骨犹当履至尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":533,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢公像","author":"曾极","text":"失喜向来因折屐，含悲今日为闻筝。\n人间悲喜何时了，携伎东山载酒行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":534,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢玄庙","author":"曾极","text":"儿辈能军国未危，更令朱序助声威。\n秦人若也全师集，云母车盛晋鼎归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":535,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赏心亭","author":"曾极","text":"柱上题名客姓苏，江山清绝冠吴都。\n六花飞舞凭阑处，一本天生卧雪图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":536,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"辎车","author":"曾极","text":"娅姹吴音今古同，宫妆袨服已成空。\n雕文结角辎车巧，犹有梁陈宫掖风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":537,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"摄山","author":"曾极","text":"一丈唐碑今露立，十寻梵塔已低摧。\n层层石佛云閒出，坐阅齐梁成劫灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":538,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新亭","author":"曾极","text":"青山四合绕天津，风景依然似洛滨。\n江左于今成乐土，新亭垂泪亦无人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":539,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蜀海棠","author":"曾极","text":"传芳远远自西邻，锦伞高张熨眼新。\n花睡觉来红泪落，年年如忆故宫春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":540,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"榠楂","author":"曾极","text":"子丹进馔色微黄，仙老调胹有禁方。\n五和糁奇无处觅，榠楂新熟压枝香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":541,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"德庆堂字","author":"曾极","text":"森然笔势聚干将，气轧钟王未肯降。\n惆怅当年铁钩锁，可能无意锁长江。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":542,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"澄心堂","author":"曾极","text":"楮生玉面务深藏，未肯横陈翰墨场。\n一幅降笺何用许，价高缘写宋文章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":543,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题识山堂","author":"曾极","text":"抉开云气从天末，唤得炉峰入坐閒。\n似见二林春霭霭，殊闻三叠水潺潺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":544,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"濂溪","author":"曾极","text":"逍遥社里周夫子，太极图成昼掩关。\n欲验个中真动静，终朝临水对庐山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":545,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"覆舟山","author":"曾极","text":"六代兴亡貉一丘，繁华梦逐水东流。\n操蛇神向山前笑，三百年前几度舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":546,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大唐","author":"曾极","text":"仁义晋阳主，神功致太平。\n子孙承事业，妇寺窃权衡。\n府卫兵先坏，租庸调不行。\n未几三百载，逆贼入宫城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":547,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"五代","author":"曾极","text":"弑篡起交争，中原战血腥。\n王庭更五姓，民户乏孤丁。\n耕织常年弛，干戈甚日停。\n圣人祈早降，香雾达高冥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":548,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"六朝","author":"曾极","text":"倒指六朝事，江城不忍登。\n燕巢非故宅，兔窟遍诸陵。\n亹亹称王霸，嗟嗟感废兴。\n青山龙虎在，金气又消凝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":549,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"文公先生挽词","author":"曾极","text":"皇天开太极，庚戌圣贤生。\n六籍文将绝，千年道复明。\n渊源罗仲素，师友李延平。\n绕舍闽溪急，潺湲洛水声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":550,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"红泉精舍","author":"曾极","text":"十里长松一幅巾，温汤净濯满衣尘。\n石门隔断世间事，仙窟能容鹤上人。\n已主谢公为北道，更依华子作西邻。\n红泉可酒兼宜茗，便合躬耕老此身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":551,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"约友人赏春","author":"曾极","text":"人生何事最为亲，不看春容不识春。\n岸柳细摇多意思，野花初绽足精神。\n精神识得施为别，意思到时言语新。\n为报同门须急赏，莫教春去始伤春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":552,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"往舂陵作","author":"曾极","text":"杖策行行访楚囚，也胜流落峤南州。\n鬓丝半是吴蚕吐，襟血全因蜀鸟流。\n径窄不妨随茧栗，路长那更听钩辀。\n家山千里云千叠，十口生离两地愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":553,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春望","author":"曾极","text":"楼上从容晓日明，春风随处动郊坰。\n定知有象根冲漠，未信至真惟杳冥。\n万化淳时云霭霭，一元亨处雨零零。\n无言共倚阑干曲，绿满原田水满汀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":554,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送真泉州","author":"曾极","text":"隐然风节动朝行，屡叩龙墀贡皂囊。\n未促相如归蜀道，翻令汲黯去淮阳。\n便藩自足荣莱服，邃殿谁当补舜裳。\n急召诸贤固根本，玺书早晚出明光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":555,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽真西山二首 其二","author":"曾极","text":"一片诚心并若丹，爱民何止十分宽。\n不成中国相司马，空使苍生望谢安。\n广益集思今已晚，以明佐圣古来难。\n治平一卷黄扉墨，留与君王拭泪看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":556,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽真西山二首 其一","author":"曾极","text":"云出西山雨未成，已闻华表鹤飞鸣。\n声名未必少黄霸，礼乐正缘无孔明。\n天下已传新宰相，胸中不改旧书生。\n寒蟾没入少微去，从此泰阶何日平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":557,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽蔡西山先生","author":"曾极","text":"天子中年后，名家信有初。\n身罹钩党祸，学稿启蒙书。\n木直宜先伐，兰芳竟自锄。\n首阳千驷马，后世定何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":558,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄陈正己","author":"曾极","text":"扊扅深闭断经过，倒摺尘编且卧痾。\n九十日春晴景少，一千年事乱时多。\n吟成楚些翻愁绝，鬓染吴霜奈老何。\n心铁正坚思急试，忆君中夜起悲歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":559,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蔡西山贬道州","author":"曾极","text":"四海朱夫子，徵君独典刑。\n青云伯夷传，白首太玄经。\n有客怜孤愤，无人问独醒。\n瑶琴空宝匣，弦断不堪听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":560,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题太平宫","author":"曾极","text":"前朝失太平，仙馆寄空名。\n日日有秋色，房房闻水声。\n碑传吴叟画，殿厄建炎兵。\n旧物云关在，新宫再落成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":561,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上朱晦庵","author":"曾极","text":"玄天默无言，妙契有伏义。\n爰初画八卦，圣学乃肇基。\n于皇陶唐氏，□心折危微。\n鲁叟述六经，为世立范围。\n正色斥诐淫，邹孟独先几。\n道丧向千载，华风变醇醨。\n皇纲一以振，属此文明时。\n真儒出河洛，坚白不磷缁。\n探我囊中胶，续彼桐上丝。\n徽音嗣正始，但惜和者稀。\n祥麟虽见获，凤鸟终来迟。\n珍重武夷翁，斯文今在兹。\n岩栖三十年，著书觉群迷。\n往者不可谏，来者犹可追。\n趋隅偶未谐，夙昔梦见之。\n散发弄五弦，弹作南风诗。\n曲终起长嗟，弦绝有馀悲。\n止止不复弹，缪然歌采薇。\n鸾翮有时铩，鸱鸢刺天飞。\n公乎抱高寒，岁晚将安归。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":562,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大江","author":"曾极","text":"烽烟岁岁满江干，将师诛求盍少宽。\n未得三军如挟纩，凭谁数处护风寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":563,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"后主祠","author":"曾极","text":"真珠帘下变离声，多少嫱妃掩袂听。\n赢得牢愁三万斛，孤舟撑入大梁城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":564,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和谢康乐华子冈韵","author":"曾极","text":"隐仙无定在，馆宇非一山。\n华子出商洛，巢云府渴泉。\n嬴颠刘蹶际，师生自为贤。\n颇哀区中人，峰岭起新阡。\n决绝目下事，驾鸿凌紫烟。\n身隐焉用文，灭迹隐空筌。\n云仍散洲渚，世渔业相传。\n笭箵挂虎落，舴艋当门前。\n蹇予厌世议，企石听潺湲。\n山空月明时，足音自跫然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":565,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"青松路","author":"曾极","text":"致君尧舜事何难，投老钟山赋考槃。\n愁杀天津桥上客，杜鹃声里两眉攒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":566,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南唐郊坛","author":"曾极","text":"上帝神兵破石头，别离歌管六宫愁。\n燔柴空有高坛在，乞与千年麋鹿游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":567,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"射殿","author":"曾极","text":"鹤盖阴阴覆苑墙，更添苍雪助清凉。\n高皇俭德规模远，不作南朝石步廊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":568,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄陈正己","author":"曾极","text":"十载忧迫发半华，东山有意净胡沙。\n公车战策三千牍，腹笥兵书五十家。\n好佩青萍光夺月，莫惊赤羽气成霞。\n嗟予本亦轻生者，欲渡黄海掷马挝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":569,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清凉寺","author":"曾极","text":"秋月春花迹未陈，衮龙曾绕梦中身。\n夷门金鼓从天落，惊起床头鼻鼾人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":570,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游华子冈红泉碧涧","author":"曾极","text":"去城才半驿，深谷自逶迤。\n藤络崩崖石，松垂倒地枝。\n寒山缩毛发，碧涧照须眉。\n霜气全消歇，空存太傅祠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":571,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送举人","author":"曾汪","text":"乐作疑游太古庭，韩门今喜见诸生。\n千间厦敞摅雄思，万里桥成助去程。\n玉醑杯深乡意重，银蟾宫近客身轻。\n前贤已有惊人举，更听胪传第一声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":572,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"曾纻","text":"汉江水涨鸭头绿，宜城酒熟鹅儿黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":573,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"危全枫祠","author":"曾季狸","text":"香火颓然寄梵宫，精英不与众禅同。\n临川千古人心在，犹说当年保障功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":574,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西隐寺","author":"曾季狸","text":"彷佛儿时住此间，重来不记旧山川。\n却因坐久僧相问，细数如今二十年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":575,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宝应寺","author":"曾季狸","text":"檀心素面水沉香，一架清阴满院凉。\n莫道春归无觅处，春归却在赞公房。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":576,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"苦竹舟行","author":"曾季狸","text":"船头触处浪花生，船尾随人山影行。\n一水到家能几许，顺流东下片时程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":577,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"相峰寺","author":"曾季狸","text":"一灯投宿阿兰若，雨过凉生夜气清。\n何许秋声惊客梦，檐间不断一铃鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":578,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"绯桃","author":"王庭圭","text":"衣裁缃缬态纤秾，犹在瑶池午醉中。\n嫌近清明时节冷，趁渠新火一番红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":579,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"积翠楼 其一","author":"曾季狸","text":"手扪霄汉摘天星，脚踏丹梯最上层。\n须信神仙足官府，能令鸡犬亦飞升。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":580,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"疏山三首 其三","author":"曾季狸","text":"草封支径路欲断，雨洗野花山更寒。\n西岭东冈烟漠漠，南溪北涧水潺潺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":581,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"疏山三首 其二","author":"曾季狸","text":"垍湖潭畔呼舟渡，苦竹林边策杖回。\n衣湿为穿山雨过，手香因折野梅来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":582,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"疏山三首 其一","author":"曾季狸","text":"江南九月未飞霜，木叶萧萧已半黄。\n行遍疏山山下路，满山唯有桂花香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":583,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"疏山道中","author":"曾季狸","text":"村深谷鸟近人鸣，暮霭收时雨又晴。\n极目春山随处好，笋舆穿尽绿阴行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":584,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"白水寺","author":"曾季狸","text":"暂假僧房憩，炎蒸觉顿忘。\n谁知六月雨，已似九秋凉。\n石径苔痕滑，稻花田水香。\n鸣蝉休聒耳，容我此徜徉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":585,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杨源寺","author":"曾季狸","text":"落日郊原独杖藜，偶寻萧寺坐移时。\n下临稻垄如棋局，细数僧房似蜜脾。\n风里长松能远韵，霜馀残菊尚多姿。\n因吟竹院诗人语，笑我劳生力已疲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":586,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"苦竹行","author":"曾季狸","text":"碧草送春晚，绿阴迎夏凉。\n轻风摇细麦，浅水出新秧。\n岁月催人老，田园引兴长。\n一廛如可办，吾亦学耕桑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":587,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"金石台","author":"曾季狸","text":"江上岧峣百尺台，摩挲尘迹但徘徊。\n不辞浊酒三杯醉，坐对晴空万里开。\n楚泽风烟随处好，仙家桃李有谁栽。\n黄花过了梅花发，待我扶藜得复来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":588,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"金沙寺","author":"曾季狸","text":"古寺同真率，君家更秩筵。\n酒杯无算饮，橘树不论钱。\n胜日携佳客，曾来是去年。\n莫嫌频至此，直为主人贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":589,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南湖","author":"曾季狸","text":"葛巾藜杖兴何长，为爱南湖六月凉。\n雨在山头作云气，风来水面散荷香。\n登临稍喜市声远，徙倚犹嫌归兴忙。\n后日重来携枕簟，不妨午梦到斜阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":590,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陪张舍人出郊","author":"曾季狸","text":"官桠千寻大，清溪五尺流。\n眼看春事适，心与老农谋。\n节物年年好，田园事事幽。\n缓归陪皂盖，觅句待苏州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":591,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿正觉寺","author":"曾季狸","text":"月落僧窗暗，衾单客梦惊。\n鸡鸣催客起，犬吠恶人行。\n蓐食事已毕，膏车天未明。\n畏涂饥饿岁，哪得事宵征。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":592,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿正觉寺","author":"曾季狸","text":"正觉江边寺，风烟罨画然。\n庭罗合抱树，门泊钓鱼船。\n暮雨凉初过，中秋月正圆。\n无人来共赏，独自占江天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":593,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"憩雷公山","author":"曾季狸","text":"酒薄饮难醉，山寒梦不成。\n窗间残月影，枕上晓钟声。\n丘壑平生事，山林少日情。\n白头翁老矣，数亩未经营。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":594,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"五星泉","author":"曾季狸","text":"五星耀寒芒，直射入九渊。\n化为石泉眠，位置相联绵。\n相映璧月夜，上下争珠连。\n星光本游空，著地今何然。\n得非泉石癖，如我老不悛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":595,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]