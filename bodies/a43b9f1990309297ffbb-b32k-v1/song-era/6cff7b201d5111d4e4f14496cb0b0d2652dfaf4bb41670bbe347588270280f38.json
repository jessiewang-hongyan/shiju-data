[{"title":"和陈瑩中了斋自警六绝 其四","author":"杨时","text":"造次欲安嗟孰是，参前无物若为书。\n萧条此意人谁问，兴废由来命也与。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71488,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和陈瑩中了斋自警六绝 其二","author":"杨时","text":"八荒同宇混车书，一视那知更有渠。\n凭轼自应由砥道，径蹊无处问归与。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71489,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和陈瑩中了斋自警六绝 其五","author":"杨时","text":"圣门事业学须彊，俚耳从来笑折杨。\n诡遇得禽非我事，但知无有是吾乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71490,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和陈瑩中了斋自警六绝 其六","author":"杨时","text":"盈科日进几时休，到海方能止众流。\n只恐达多狂未歇，坐驰还爱镜中头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71491,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和陈瑩中了斋自警六绝 其一","author":"杨时","text":"画前有易方知易，历上求玄恐未玄。\n白首纷如成底事，蠹鱼徒自老青编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71492,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜雨","author":"杨时","text":"似闻疏雨打篷声，枕上悠扬梦半醒。\n明日觉来浑不记，隔船相语过前汀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71493,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宜春溪","author":"杨时","text":"斜斜疏柳照清漪，藉藉残红自满蹊。\n刺眼藤稍牵不断，欲寻流水路还迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71494,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"直舍书事","author":"杨时","text":"鳞鳞池面水初生，萍底青蛙自在鸣。\n谁使幽庭当鼓吹，雨馀时听作新声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71495,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"勉怀","author":"杨时","text":"纷纷于我未忘情，疏懒多应舍怨憎。\n便好世间师柳惠，不须岩下问孙登。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71496,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"勉谢自明","author":"杨时","text":"少年力学志须彊，得失由来一梦长。\n试问邯郸攲枕客，人间几度熟黄粱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71497,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日五首 其五","author":"杨时","text":"雨馀残日照窗明，风弄行云点点轻。\n坐对庭阴人阒寂，时闻蛛网挂虫声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71498,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日五首 其四","author":"杨时","text":"晴明百鸟啭新声，摧啄幽花折粉英。\n冷坐隔帘呼不起，惜春无计若为情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71499,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日五首 其三","author":"杨时","text":"一番微雨一番晴，淡淡春容照眼明。\n庭外幽花自开落，飞扬无处觅残英。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71500,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日五首 其二","author":"杨时","text":"蔷薇正好结花棚，拟为幽轩作锦屏。\n穷巷寂寥人不到，空藏春色锁深扃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71501,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春早","author":"杨时","text":"云天羃羃漏微光，疏懒惟添睡思长。\n枕上隔篱闻鸟语，半残春梦更悠扬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71502,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春波亭上","author":"杨时","text":"城头飞盖映朝晖，向晚游人兴未移。\n安得鲁阳酣战手，为留羲驭更迟迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71503,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春晓 其二","author":"杨时","text":"浮花浪蕊自纷纷，点缀梅苔作绣茵。\n独有猗兰香不歇，可纫幽佩系馀春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71504,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浏阳五咏 其三 飞鴳亭","author":"杨时","text":"芙蓉彫尽蕙兰芳，杖屦翛然一漫郎。\n凫鹤短长宁复问，但知鹏鴳两相忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71505,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浏阳五咏 其二 归鸿阁","author":"杨时","text":"帘捲晴空独倚栏，冥鸿点点有无间。\n秋风注目无人会，时与白云相对閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71506,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浏阳五咏 其四 相公台","author":"杨时","text":"柔条疏蔓绿交加，烟锁云涵去路赊。\n绣绂貂缨无处问，空馀鸡犬两三家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71507,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浏阳五咏 其一 渭水","author":"杨时","text":"洄渊浩荡白鸥飞，老懒时来坐钓矶。\n岸帻行人聊自适，不应憔悴似湘缧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71508,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送陈几叟南归 其一","author":"杨时","text":"连墙东郭倦追寻，高卧毗耶老病侵。\n自愧屠龙真拙技，漫令吾子费千金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71509,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送陈几叟南归 其三","author":"杨时","text":"几年梦想到亲闱，身逐行云万里飞。\n苕水未殊沂上乐，春风无负舞雩归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71510,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送陈几叟南归 其二","author":"杨时","text":"霾风霪雨湿征裾，隔雨楼台半有无。\n南去定逢韩阁老，归愚当见问夷涂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71511,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄游定夫","author":"杨时","text":"绛帷燕侍每从容，一听微言万虑空。\n却愧犹悬三釜乐，未能终此挹清风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71512,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重经乌石铺","author":"杨时","text":"夹屋青松翠霭中，去年经此亦匆匆。\n重来乌石冈头路，依旧松声带晓风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71513,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"容照岩","author":"杨时","text":"清时投迹在嵚崟，一穴晴光破晚阴。\n刺草未容忘魏阙，故应长有子牟心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71514,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"徐郎庙","author":"杨时","text":"古庙灵场枕碧巅，松楸依约锁风烟。\n羽毛一去无消息，堕落人间几百年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71515,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病中作 其一","author":"杨时","text":"此身如幻病何伤，白日无人景自长。\n寄傲南窗容膝地，时时飞梦到羲皇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71516,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病中作 其三","author":"杨时","text":"寄形一榻日蘧然，倚杖支颐髻指天。\n莫逆过门无子祀，时来鉴井自跰?。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71517,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病中作","author":"杨时","text":"通衢隔辙断经过，门巷空无雀可罗。\n驱去儿童卧虚室，萧然惟一病维摩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71518,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病中作 其二","author":"杨时","text":"过檐赫日昼如燔，睡转庭阴始一反。\n纵有诸人来问疾，毗耶居士已忘言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71519,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病中作 其四","author":"杨时","text":"古椿朝菌已忘年，贫病宁须更问天。\n石弹不妨随物化，自求鸮炙自应便。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71520,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病起","author":"杨时","text":"竹风带雨作秋声，半睡惟闻鸟雀争。\n老病衰残惟骨立，白头看镜不须惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71521,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"荷花","author":"杨时","text":"照眼红云斗晚霞，重重青盖半倾斜。\n会须直跨三千仞，移取峰头十丈花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71522,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶成 其二","author":"杨时","text":"悠扬春梦成幽兴，冷落溪光照酒卮。\n天阔云浮遮不尽，浪平风过舞涟漪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71523,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶成 其一","author":"杨时","text":"绿鬓潜惊老境催，更怜衰病困低回。\n但知周道平如砥，莫问瞿唐滟预堆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71524,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梭山候潮","author":"杨时","text":"向晚牛羊沙岸归，落帆烟浦候潮时。\n谁言江上须忠信，潮到于今自失期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71525,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淮上独酌","author":"杨时","text":"廉纤晚雨洗轻尘，天淡云浮夜色新。\n赖有曲生风味好，不须邀月作三人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71526,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绿阴亭上","author":"杨时","text":"沙边幽鸟傍清漪，泷下渔船逆浪归。\n身在辋川图画里，晴空惟欠雪花飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71527,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登岘首阻雨 其二","author":"杨时","text":"江浮云影抱层栏，云外青山一水间。\n尽日倚阑看不足，杖藜欲去更回还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71528,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"咏古十六首 其一","author":"华镇","text":"衮衣自美好，无能被猿猱。\n鶢鶋巢鲁门，恻怆临九牢。\n此物乃异类，珍华宜见逃。\n颍阳本无人，嗜好非羽毛。\n执心一何苦，用形一何劳。\n采薇代刍豢，刍豢气膻臊。\n饮水宁手掬，飘风声怒号。\n不慕黄屋尊，遗之如秋毫。\n道真固所重，无乃太嚣嚣。\n达士各有心，非志斯郁陶。\n饮河已盈腹，河流自滔滔。\n一枝傥可栖，云构如蓬蒿。\n适外皆长物，逐物非吾曹。\n如何市朝人，捐生竞锥刀。\n颓川无回波，始觉素风高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71529,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登岘首阻雨 其三","author":"杨时","text":"江风飞雨上雕栏，庭树萧萧景自閒。\n向晚微云遮不尽，好山浑在有无间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71530,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登桐君山","author":"杨时","text":"翠崖千尺峙云高，楼殿翚飞压巨涛。\n槛外回峰自连著，祇因潭下有灵鳌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71531,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"腊月见桃花","author":"杨时","text":"脂脸轻匀作艳妆，未应洁白似梅香。\n夭红不见凌霜操，漫向春前取次芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71532,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"感事","author":"杨时","text":"桑麻腴地莽榛荆，骑士西来剑戟腥。\n藜藿陋儒心更鄙，但思干羽舞虞廷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71533,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"感事","author":"杨时","text":"权门车马日纷纷，寂寞多应笑子云。\n玄白定知非世尚，解嘲那复彊云云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71534,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蓝田溪上","author":"杨时","text":"夹篱桃李趁溪斜，浅浅清流映落花。\n欲问武陵源上路，度云穿石认胡麻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71535,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"端午日","author":"杨时","text":"悠悠南北各天涯，欲望乡关眼已花。\n忆得亲庭谁共语，应怜游子未还家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71536,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题陈宣事烟波泛宅","author":"杨时","text":"忘怀缨绂寄浮居，来泛烟波拟钓徒。\n我欲他时清洛上，为君正橹作鲻鲻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71537,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题诗长老壁","author":"杨时","text":"维摩病士意超然，边腹便便但昼眠。\n共说平时忙底事，烹茶煮药过残年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71538,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"藏春峡","author":"杨时","text":"山衔幽径碧如环，一壑风烟自往还。\n不似武陵流出水，残红那得到人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71539,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"醴陵丁君洋洋亭","author":"杨时","text":"依蒲泳藻两相忘，宛有江湖气味长。\n凭槛翛然真得计，祇应幽兴在濠梁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71540,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又用前韵和早梅二首 其二","author":"杨时","text":"星驭经行处，梅花忽已开。\n只疑春信早，先拥使旌来。\n嫩萼红初破，寒柯绿未回。\n凌霜半含月，皎皎绝纤埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71541,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又用前韵和早梅二首 其一","author":"杨时","text":"楚国春归早，寒梅处处开。\n月和清艳冷，天与靓妆来。\n东阁诗魂动，南枝岁律回。\n萧然冰雪态，无处觅轻埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71542,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寸碧轩","author":"杨时","text":"隐隐遥山列画屏，檐间寸碧与云平。\n低回席上遗簪露，彷佛墙东翠黛横。\n虚景远涵千里色，晚晖仍借一溪清。\n春风景物知多少，可称收身乐此生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71543,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"予自长沙还植兰竹于东西轩调官京师逾年而归兰竹皆衰悴感而成诗","author":"杨时","text":"柴桑衰晚爱吾庐，三径归来手自锄。\n但得叔卿长饱饭，不妨孝若老谈书。\n兰因采佩枝先瘁，竹为凌霜叶自疏。\n留骨庙堂宁曳尾，鲁门无用祀爰居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71544,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"天宁节","author":"杨时","text":"祥开若木射瑶光，淑气先春景自长。\n玉陛风閒飞綵绶，兽炉烟暖袭珠囊。\n云门羽鹤仪仙仗，天上蟠桃荐寿觞。\n已见晶辉环帝座，定应长照鼎宫傍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71545,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"王簿清辉亭","author":"杨时","text":"黛染烟螺拂槛低，抱城流水绿逶迤。\n澄澜碎影摇青镜，斜日流峰隐半规。\n坐上盈樽无俗客，壁间照夜有新诗。\n登临已动忘归兴，况复清谈足解颐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71546,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乐语口号 其一","author":"杨时","text":"庭下秋风飐旆旌，使君爽气逼人清。\n功名共喜千龄会，尊酒仍逢四事并。\n甘谷残英留晚翠，雍门馀曲有新声。\n莫辞酩酊同民乐，凤诏行催上玉京。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71547,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乐语口号 其二","author":"杨时","text":"灵槎初泛斗牛间，隐隐晶光照夜寒。\n况是春城多乐事，果逢星节驻征鞍。\n使藩暂屈留旌旆，云路均同接羽翰。\n已写风猷传乐府，更磨琬琰一时刊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71548,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬早书事","author":"杨时","text":"窈冥谁为宰炉锤，荣谢唯知岁序催。\n腊日未经梅已绽，春风尚远冻先开。\n愁无润泽归芳树，独有馀寒著死荄。\n收尽浮云天愈净，夜深犹起望三台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71549,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬晓","author":"杨时","text":"著瓦霜华冷，暝空晓雾均。\n气昏难见日，风过易生尘。\n洗砚冰纹破，凭炉火色春。\n莫嫌寒尚薄，雨雪更愁人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71550,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬寒两齿忽觉动摇因成书怀","author":"杨时","text":"未年三十发先彫，岁晚俄惊两齿摇。\n都为疏慵成计拙，直缘衰病觉形焦。\n连经宿雨重裘冷，旋煮藜羹野兴饶。\n摆脱尘樊犹未得，不堪回首问渔樵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71551,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"归雁","author":"杨时","text":"天末惊风急，江湖夜思长。\n悲鸣愁绝塞，接翼冒清霜。\n泽岸多缯弋，云间乏稻粱。\n茫然栖息地，饮啄欲何伤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71552,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"汉坂舟行","author":"杨时","text":"曲岸通幽径，疏篱映竹斜。\n坞深藏吠犬，林薄露人家。\n石濑鱼偏美，邻村酒易赊。\n祇应云水富，自是一生涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71553,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"合江亭晚眺","author":"杨时","text":"倚杖钩帘两水间，晴光飞影上雕栏。\n帆催画鹢抟风去，雪吐铦锋作剑攒。\n平野烟浮迷远目，晚溪潮涨失前滩。\n骑鲸一往扶桑近，休问人间行路难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71554,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"安礼以宏词见勉奉寄","author":"杨时","text":"吏部文章世所珍，终惭无补费精神。\n浮名肤外增馀赘，薄宦戈头寄此身。\n养志吾方同邴曼，谈书谁复问山宾。\n自怜坐顷三遗矢，衰晚那能用楚人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71555,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵安礼见寄","author":"杨时","text":"末俗相看老尚新，交游千里更谁亲。\n萧条身世聊安分，迂阔行藏懒徇人。\n宦路竞羞关柝吏，劳生谁息利名身。\n我惭抱瓮无机械，幽兴惟思水石滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71556,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵思睿见寄","author":"杨时","text":"圣贤千古愧难攀，力学方忧敢自閒。\n顾我久抛声迹外，惭君犹挂齿牙间。\n平生拙计心长在，解带高风志未还。\n捧檄于今非得已，漫劳魂梦绕溪山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71557,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵晁以道","author":"杨时","text":"谁能载酒寻元亮，共寄无何作醉乡。\n便好收心事农圃，不须惊世露文章。\n壶中日月春长在，塞上烟尘客自忙。\n千里同风无远近，未分秦陇与潇湘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71558,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵钱帐计","author":"杨时","text":"骎骎羲驭定难羁，过隙跳丸日夜驰。\n但见光阴如掣电，却寻稽览已当期。\n飞黄汗血宜千里，秋鹗乘风此一时。\n芝草凤凰真美瑞，清名应有退之知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71559,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵蔡武子书怀","author":"杨时","text":"放形锄色恐成光，斲垩能令鼻不伤。\n自信放鱼真得计，却怜挟策亦亡羊。\n刃投有间多馀地，语到无言辄自忘。\n扰扰世纷何足问，松窗终日独彷徨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71560,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过关山 其二","author":"杨时","text":"岁律行将暮，飙风凌九垓。\n山深人寂寞，路远马虺隤。\n幽意从谁展，愁怀殢酒开。\n衰迟仍惜日，投晚独徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71561,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]