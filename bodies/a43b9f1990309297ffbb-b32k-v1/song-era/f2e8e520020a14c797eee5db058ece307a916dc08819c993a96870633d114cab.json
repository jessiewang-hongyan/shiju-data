[{"title":"西江月 其一","author":"杨冠卿","text":"妙墨龙蛇飞动，新词雪月交光。\n论文齿颊带冰霜。\n凤阁从来宫样。\n寿菊丛开三径，清姿高压群芳。\n折花聊尔问行藏。\n会见横飞直上。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72243,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西江月 其三 咏黄菊","author":"杨冠卿","text":"昨梦钧天帝所，曾陪奏赋明光。\n玉除金蕊映秋霜。\n尽道宫花别样。\n娇额涂黄牢就，金莲衬步齐芳。\n舞鸾仪凤巧难藏。\n羞杀繁红陌上。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72244,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"垂丝钓","author":"杨冠卿","text":"翠帘昼卷。\n庭花日影初转。\n酒力未醒，眉黛还敛。\n停歌扇。\n背画阑倚遍。\n情无限。\n怅韶华又晚。\n锦鞯去后，愁宽珠袖金钏。\n碧云信远。\n难托西楼雁。\n空写银筝怨。\n肠欲断。\n更落红万点。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72245,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"柳梢青 其一","author":"杨冠卿","text":"红药翻阶。\n天香国艳，辉映楼台。\n解语浑如，三千粉黛，十二金钗。\n青鞋踏破苍苔。\n趁舞蝶、游蜂去来。\n宿粉偷香，也应难似，年少情怀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72246,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"柳梢青 其二 咏鸳鸯菊、双心而白、秋晚始开","author":"杨冠卿","text":"金蕊飘残。\n江城秋晚，月冷霜寒。\n一种幽芳，雕冰镂玉，舞凤翔鸾。\n悠然静对南山。\n笑琼沼、鸳飞翠澜。\n小玉惊呼，太真娇困，俯槛慵看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72247,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"柳梢青 其三 为丁明仲纪梦","author":"杨冠卿","text":"归梦迢迢。\n分明曾见，舞遍云韶。\n解道相思，愁宽金钏，瘦损宫腰。\n觉来情绪无聊。\n正戍角、声翻丽谯。\n楚塞山长，巫阳人远，斗帐香消。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72248,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺新郎","author":"杨冠卿","text":"薄暮垂虹去。\n正江天、残霞冠日，乱鸿遵渚。\n万顷云涛风浩荡，笑整羽轮飞渡。\n问弱水、神仙何处。\n翳凤骑麟思往事，记朝元、金殿闻钟鼓。\n环佩响，翠鸾舞。\n梦中失却江南路。\n待西风、长城饮马，朔庭张弩。\n目尽青天何时到，赢得儿童好语。\n怅未复、长陵抔土。\n西子五湖归去后，泛仙舟、尚许寻盟否。\n风袂逐，片帆举。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72249,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其一","author":"杨冠卿","text":"洞口春深长薜萝。\n幽栖地僻少经过。\n一溪新绿涨晴波。\n惊梦觉来啼鸟近，惜春归去落花多。\n东风独倚奈愁何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72250,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其二 次韩户侍","author":"杨冠卿","text":"银叶香销暑簟清。\n枕鸳醉倚玉钗横。\n起来红日半窗明。\n多病情怀无可奈，惜花天气恼馀酲。\n瑶琴谁弄晓莺声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72251,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清平乐","author":"杨冠卿","text":"翠团嘉树。\n杜宇呼春去。\n帘卷金泥凝望处。\n几点红薇香雨。\n等闲过了花时。\n殷勤来问酴醾。\n恰有一枝春在，画楼红日林西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72252,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 其一 春日呈安国舍人","author":"杨冠卿","text":"飞云障碧江天暮。\n杏花帘幕黄昏雨。\n翠袖怯春寒。\n有人愁倚阑。\n天涯芳草路。\n目送征鸿去。\n人远玉关长。\n尺书难寄将。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72253,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 其二 春日西湖用吴监簿韵","author":"杨冠卿","text":"春山愁对修眉绿。\n春衫谁为裁冰縠。\n日暮倚阑干。\n不禁烟雾寒。\n湖边归去路。\n犹记传觞处。\n往事等空花。\n客心惊岁华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72254,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 其四 雪中呈李常门","author":"杨冠卿","text":"玉妃夜宴瑶池冷。\n翩然飞下霓旌影。\n天阔水云长。\n风飘舞袖香。\n姑山人似旧。\n清压红梅瘦。\n同凭玉阑干。\n光摇银海寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72255,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 其三","author":"杨冠卿","text":"冰肌玉衬香绡薄。\n无言独倚阑干角。\n相见又还休。\n可堪归去愁。\n碧波溪上路。\n几阵黄昏雨。\n归去断人肠。\n纱厨枕簟凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72256,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谒金门 春暮有感","author":"杨冠卿","text":"伤漂泊。\n负了花前期约。\n寒食清明都过却。\n愁怀无处著。\n晴日柳阴池阁。\n风絮斜穿帘幕。\n帘外秋千闲彩索。\n断肠人寂寞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72257,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蝶恋花 其一 次张俊臣韵","author":"杨冠卿","text":"舞处曾看花满面。\n独倚东风，往事思量遍。\n绿怨红愁春不管。\n天涯芳草人肠断。\n一纸云笺鱼雁远。\n归凤求凰，谁识琴心怨。\n臂枕香消眉黛敛。\n也应为我宽金钏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72258,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蝶恋花 其二","author":"杨冠卿","text":"月冷花寒宫漏促。\n人在虚檐，玉体温无粟。\n弦断鸾胶还再续。\n娇云时霎情难足。\n解道双鸳愁独宿。\n宿翠偎红，蛱蝶元相逐。\n蓬海路遥天六六。\n终须伴我骑黄鹄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72259,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天 次韵宝溪探梅未放","author":"杨冠卿","text":"岁月如驰乌兔飞。\n情怀著酒强支持。\n经年不见宫妆面，秾碧谁斟翡翠卮。\n江路晚，夕阳低。\n奚奴空负锦囊归。\n欲凭驿使传芳信，未放东风第一枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72260,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"霜天晓角 次韵李次山提举渔社词","author":"杨冠卿","text":"渔舟簇簇。\n西塞山前宿。\n流水落红香远，春江涨、葡萄绿。\n蕲竹。\n奏新曲。\n惊回幽梦独。\n却把渔竿远去，骑鲸背、钓璜玉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72261,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题天台福圣观瀑布","author":"杨契","text":"积雪悬崖照幽谷，轰雷破石响空山。\n直疑天上银河水，倒泻千岩万壑间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72262,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴己巳游洞霄","author":"杨契","text":"青山九锁隔凡缘，福地潜通小有天。\n古洞落花春寂寂，空山乱石水涓涓。\n金丹翠箬藏千岁，芝草琅玕定几年。\n惆怅何时谢尘事，山中长作地行仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72263,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题马远画梅四幅 其三 霞铺烟表","author":"杨娃","text":"夭桃艳杏岂相同，红润姿容冷淡中。\n披拂轻烟何所似，动人春色碧纱笼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72264,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题马远画梅四幅 其一 晴雪烘香","author":"杨娃","text":"重重叠叠染缃黄，此际春光已半芳。\n开处不禁风日煖，乱飞晴雪点衣裳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72265,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题马远画梅四幅 其二 朱颜傅粉","author":"杨娃","text":"铢衣翠盖映朱颜，未识何年入帝关。\n默被画工传写得，至今犹似在衡山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72266,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题马远画梅四幅 其四 层叠冰绡","author":"杨娃","text":"浑如冷蝶宿花房，拥抱檀心忆旧香。\n开到寒梢犹可爱，此般必是汉宫妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72267,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题马和之画四小景 其二","author":"杨娃","text":"石楠叶落小池清，独下平桥弄扇行。\n倚日绿云无觅处，不如归去两三声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72268,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题赵伯骕画","author":"杨娃","text":"莲开宫沼年年盛，香染斑衣叶叶新。\n愿借琴音奏清雅，薰风凉殿寿双亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72269,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自述真赞","author":"释通慧","text":"真兮寥廓，郢人图雘。\n岳耸云空，澄潭月跃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72270,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游大涤栖真洞 其二","author":"杨栋","text":"山峨来夹案，泉急自穿渠。\n密记东阳诀，高题上帝居。\n牙儿藏宝箧，山子走篮舆。\n曲折玑衡转，溪坳可结庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72271,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"净土寺追和东坡韵","author":"杨栋","text":"令君督来期，书邮日旁午。\n世事不足论，清游乃先务。\n朝朝叩禅关，复此得净宇。\n浅斟琥珀浓，细嚼银丝缕。\n味隽问牛酥，轩高来燕乳。\n曲折溪屡横，尖圆峰可数。\n万顷喧桑田，一簇静松坞。\n由来镜中人，不殊草头露。\n越主朝汴宫，蜀客尽吴语。\n剥蚀净土碑，荒残峡山路。\n桑梓如之何，谁能忘一顾。\n日询锦桥新，三叹清流俯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72272,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丁巳再游题蓬山堂泉石","author":"杨栋","text":"琼流鉴空，混沌一隙。\n紫霄柱下，清泉白石。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72273,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"云安龙脊滩","author":"杨济","text":"洞庭老龙时出没，万斛舟航皆辟易。\n此龙脊背已铁石，肯逐时好作人日。\n我呼邦人来踏碛，恍然如见河图出。\n大巫鸡卜占云吉，小巫竹枝歌转激。\n飘石扬沙障江色，尘埃何处不相袭。\n摩挲石刻聊偃息，恐有老人来横笛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72274,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"杨炳","text":"酿溪煮海恩无极，千家沽酒万家盐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72275,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜泛西湖","author":"杨珂","text":"明月欺人醉不知，夜深偷入读书帏。\n好将松户牢关锁，留此清光莫放归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72276,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其十九","author":"杨皇后","text":"银烛瑶觥竞上元，□□午月正当轩。\n棚头忽唤歌新曲，宛转馀音出紫垣。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72277,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其三十八","author":"杨皇后","text":"新翻歌谱甚能奇，宣索蕊官入管吹。\n按拍未谐争共笑，含羞无语自凝思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72278,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其五十","author":"杨皇后","text":"小样龙盘集翠毬，金羁缓控五花骝。\n绣旗高处钧天奏，御棒先过第一筹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72279,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其四十","author":"杨皇后","text":"夭桃稚柳恣春妍，镇日呼群嬉水边。\n忽地上棚宣进入，祗承未惯怕争前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72280,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其四十八","author":"杨皇后","text":"海棠移向小窗栽，高叠盆山合复开。\n将见红葩斗新艳，君王应为探花来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72281,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其五","author":"杨皇后","text":"溶溶太液碧波翻，云外楼台日月闲。\n春到汉宫三十六，为分和气到人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72282,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其四十五","author":"杨皇后","text":"好花开遍玉栏杆，挈伴拖桡浅水滩。\n但笑红霞映池面，不知娇面早先丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72283,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其十四","author":"杨皇后","text":"绕堤翠柳忘忧草，夹岸红葵安石榴。\n御水一沟清彻底，晚凉时泛小龙舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72284,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其四十九","author":"杨皇后","text":"遥夜焚香礼□□，桂花丛里展文茵。\n长空月浸星河影，鹦鹉惊寒频唤人。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72285,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其三十九","author":"杨皇后","text":"一朵榴花插鬓鸦，君王长得笑时誇。\n内家衫子新番出，浅色新裁艾虎纱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72286,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其三十四","author":"杨皇后","text":"黄鸟惊眠曙色开，慵梳鬟髻意徘徊。\n君王早御延英殿，频唤宫人上直来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72287,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其二十九","author":"杨皇后","text":"泛索坤宁日一羊，自从正位控辞章。\n好生躬俭超千古，风化宫嫔只淡妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72288,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其二十七","author":"杨皇后","text":"用人论理见宸衷，赏罚刑威合至公。\n天下监司二千石，姓名都在御屏中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72289,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其二十一","author":"杨皇后","text":"落絮濛濛立夏天，楼前槐树影初圆。\n传闻紫殿深深处，别有薰风入舜弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72290,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其二","author":"杨皇后","text":"元宵时雨赏宫梅，恭请光尧寿圣来。\n醉里君王扶上辇，銮舆半仗点灯回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72291,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其十六","author":"杨皇后","text":"宫殿钩帘看水晶，时当三伏炽炎蒸。\n翰林学士知谁直，今日传宣与赐冰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72292,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其九","author":"杨皇后","text":"上林花木正芳菲，内里争传御制词。\n春赋新翻入宫调，美人群唱捧瑶卮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72293,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其四十一","author":"杨皇后","text":"帘幕深深四面垂，清和天气漏声迟。\n宫中阁里催缫茧，要趁亲蚕作五丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72294,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其三","author":"杨皇后","text":"柳枝挟雨握新绿，桃蕊含风破小红。\n天上春光偏得早，嵯峨宫殿五云中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72295,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其二十二","author":"杨皇后","text":"紫禁仙舆诘旦来，旌旗遥倚望春台。\n不知庭霰今朝下，疑是林花昨夜开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72296,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其三十一","author":"杨皇后","text":"缺月流光入绮疏，金壶传箭梦回初。\n秦台綵凤无消息，桂影空闲十二除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72297,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其二十三","author":"杨皇后","text":"凉生水殿乐声游，钓得金鳞上御钩。\n圣德至仁元不杀，指挥皆放小池头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72298,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其三十五","author":"杨皇后","text":"宫槐映日翠阴浓，薄暑应难到九重。\n节近赐衣争试巧，彩丝新样起盘龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72299,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其二十八","author":"杨皇后","text":"家传笔法学光尧，圣草真行说两朝。\n天纵自然成一体，谩誇虎步与龙跳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72300,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其三十二","author":"杨皇后","text":"辇路青苔雨后深，铜鱼双钥昼沉沉。\n词臣还有相如在，不得当时买赋金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72301,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其四十二","author":"杨皇后","text":"岁岁蚕忙麦熟时，密令中使视郊圻。\n归来奏罢天颜悦，喜阜吾民鼓玉徽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72302,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其四十六","author":"杨皇后","text":"小小宫娥近水居，雕楣绣额映清渠。\n忽然携伴凭低槛，好是双莲出水初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72303,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其二十六","author":"杨皇后","text":"思贤梦寝过商宗，右武崇儒帝道隆。\n总览权纲求治理，群臣臧否疏屏风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72304,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其三十三","author":"杨皇后","text":"击鞠由来岂作嬉，不忘鞍马是神机。\n牵缰绝尾施新巧，背打星毬一点飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72305,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其十五","author":"杨皇后","text":"薰风宫殿日长时，静运天机一局棋。\n国手人人饶处著，须知圣算出新奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72306,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其二十五","author":"杨皇后","text":"秋高风动角弓鸣，臂健常嫌斗力轻。\n玉陛才传看御箭，中心双中谢恩声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72307,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其十八","author":"杨皇后","text":"琐窗宫漏滴铜壶，午梦惊回落井梧。\n风递乐声来玉宇，日移花影上金铺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72308,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其四","author":"杨皇后","text":"春风淡淡水淙淙，携伴寻芳过小杠。\n恼杀野塘閒送目，鸳鸯无数各双双。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72309,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其四十四","author":"杨皇后","text":"阿姊携侬近紫薇，蕊官承宠斗芳菲。\n绣帏独自裁新锦，怕见花间双蝶飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72310,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其七","author":"杨皇后","text":"剪剪轻风二月天，柳丝飘飏倍堪怜。\n静凭雕槛浑无事，细数穿花燕影偏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72311,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其三十","author":"杨皇后","text":"兰径香销玉辇踪，梨花不肯负春风。\n绿窗深锁无人见，自碾朱砂养守宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72312,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其六","author":"杨皇后","text":"晓窗生白已莺啼，啼在宫花第几枝。\n烟断兽炉香未绝，曲房朱户梦回时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72313,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其四十七","author":"杨皇后","text":"日日寻春不见春，弓鞋踏破小除芸。\n棚头宣入红妆队，春在金樽已十分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72314,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其十二","author":"杨皇后","text":"天申圣节礼非常，躬率群臣上寿觞。\n天子捧盘仍再拜，侍中宣达近龙床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72315,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]