[{"title":"病中闻雨","author":"李昭玘","text":"官居寥落禁门东，秋满长安一夜风。\n老病不眠成展转，五更钟鼓雨声中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59112,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"吊刘孝嗣","author":"李昭玘","text":"富贵从来一羽轻，胸中万卷复何营。\n囊钱尽处布衾短，谤焰息时坟草生。\n一日得行须有命，百年不死是高名。\n瑶琴挂壁凝尘满，无复当年流水声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59113,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"经睢阳有感","author":"李昭玘","text":"昔日经由一梦同，高楼虽在旧游空。\n东流不改当年水，白首已成今日翁。\n梁苑衣冠共黄壤，隋堤杨柳几春风。\n扁舟莫负南来兴，咫尺吴松落眼中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59114,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南游道中","author":"李昭玘","text":"玉鲙金齑昔未尝，几回飞梦到沧浪。\n乡关望处归期晚，风水声中去路长。\n梅使南来问行驿，雁声北度下斜阳。\n囊钱未尽江湖近，拟买渔舟学漫郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59115,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"舟行阻雨","author":"李昭玘","text":"暮雨来何急，乘时助发生。\n水边千树暗，篷底一灯明。\n半夜起乡思，空陂闻雁声。\n春风故留客，不为阻归程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59116,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"道中书怀三首 其一","author":"李昭玘","text":"竹树出平岸，人家藏远烟。\n片帆云度水，双桨雁随船。\n绿变春回地，寒生雨后天。\n前途尽佳境，得意且留连。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59117,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"道中书怀三首 其二","author":"李昭玘","text":"渐入临淮路，移舟每问津。\n行行风逆水，处处雨随人。\n啼鸟如留客，幽花忽见春。\n白鱼不论价，沽酒莫辞频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59118,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"道中书怀三首 其三","author":"李昭玘","text":"平野青芜合，长桥绿树低。\n客愁须白酒，春意属黄鹂。\n落日乡关远，孤村烟水迷。\n清明能几日，却过浙江西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59119,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过盱眙宿慈氏寺","author":"李昭玘","text":"行役经旬不自聊，强将登览寄春醪。\n淮吞汴水长增急，城睍南峰不让高。\n贾客正来喧万井，夕阳初下舣千艘。\n明朝更作留连计，醉卧西窗听夜涛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59120,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿慈氏遥碧斋有感","author":"李昭玘","text":"高僧邀我暂淹留，细话朱轓此屡游。\n不见清谈飞麈尾，空流悲泪拂银钩。\n淮山胜绝千年在，人物才华一梦休。\n欲作招魂吊馀恨，晚烟疏雨不胜愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59121,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"天长道中","author":"李昭玘","text":"细草眠黄犊，短篱穿绿杨。\n舂声鹁鸪急，田径蝍蛆长。\n地暖足春物，雨频宜水乡。\n羁怀不可话，倒橐酒须尝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59122,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"久雨","author":"李昭玘","text":"苦雨经旬久，溟濛势未收。\n细声来短盖，横点透重裘。\n涧曲水流急，峰深云气浮。\n此行吾自喜，所念老农忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59123,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南峰閒步","author":"李昭玘","text":"足健会真赏，眼明逃世纷。\n风烟入诗画，杖屦逐僧云。\n水阔天疑尽，峰寒日易曛。\n羁人正愁思，城角不堪闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59124,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登龙游寺","author":"李昭玘","text":"飞构起崔嵬，江晴宿雾开。\n风幡两州见，花供四天来。\n日月依峰转，鱼龙触石回。\n蓬壶在何处，更拟上层台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59125,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过虹县有作","author":"李昭玘","text":"老态倦羁旅，不堪行舸催。\n风高鸟横度，汀转树交回。\n雨过雾犹湿，春寒花未开。\n楚伧如见问，不为米南来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59126,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过淮","author":"李昭玘","text":"东风吹雨过淮滨，草木精神一番新。\n雁起沙堤烟隔水，寺藏松崦塔招人。\n荡胸长忆江湖月，眯眼曾嫌京洛尘。\n谁道南来少知识，向人修竹特相亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59127,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登平山堂","author":"李昭玘","text":"断槛攲檐风雨频，不逢心赏为重新。\n依稀叠嶂宛如画，憔悴垂杨今复春。\n一阕高歌长在耳，后来佳客复何人。\n悠然未尽云烟思，不见扬州十里尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59128,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"泊扬州城外","author":"李昭玘","text":"地占东南会，舟浮百货通。\n惺忪喜淮粲，啁哳困吴农。\n春唤雁俱北，水将人更东。\n吾庐杳何在，天末暮霞红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59129,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠盱眙令王邦直","author":"李昭玘","text":"樽酒留连淮水边，一灯相对共茫然。\n退閒得计我华发，抚字有声君壮年。\n幸有高情种松竹，可无馀思落淮川。\n南金不用充行赆，古锦囊中乞数篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59130,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"还家有作","author":"李昭玘","text":"还家春已晚，风雨误归期。\n饮啖嬉儿笑，形容吠犬疑。\n江山犹似梦，巾箧谩多诗。\n未负东园醉，桃花正此时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59131,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和程适正见赠二首 其一","author":"李昭玘","text":"壮岁干名幸起家，十年蹭蹬一长嗟。\n凭陵初托风前鹢，淘汰终随浪底沙。\n没得玄机问黄檗，却将齐物付南华。\n感君怜我贻佳句，一段秋光照晚霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59132,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和程适正见赠二首 其二","author":"李昭玘","text":"簿领栖迟叹陆沈，滔滔何处觅知音。\n凌云词句豪难敌，似水交情老更深。\n鼷鼠饮河聊满腹，白云出岫本无心。\n从今收拾身閒计，洗竹锄花日醉吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59133,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"北园书事三首 其一","author":"李昭玘","text":"葛巾茅屋自为娱，门掩槐阴长夏初。\n聒聒难休鸠唤妇，飞飞不定燕将雏。\n绕池曳策携双鹤，架水浇花课小奴。\n麦饭满瓯葵数箸，丁宁车马肯来无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59134,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"北园书事三首 其二","author":"李昭玘","text":"得丧有万理，古今犹一区。\n鹤凫元自足，蛮触竟同枯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59135,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"北园书事三首 其三","author":"李昭玘","text":"十年萧散愈身轻，弄笔翻书亦称情。\n当案忽闻缘壁堕，隔池遥见啄苔行。\n静疑多事非求福，老觉无心胜摄生。\n自爱吾庐人不到，何须谷口问归耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59136,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠子常二首 其一","author":"李昭玘","text":"幽兰一曲思无涯，炊熟黄粱日已斜。\n闭户终年心似水，读书万卷眼生花。\n汗流不舍浯溪刻，粮绝犹须北苑芽。\n束帛不来人已老，只将清白付吾家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59137,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠子常二首 其二","author":"李昭玘","text":"本无机械亦非愚，自信沈冥与世疏。\n一段画图冬卧雪，平生乐事日翻书。\n田园无暇供馀税，风雨何堪卷敝庐。\n笑杀贵人门下客，不逢此老曳长裾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59138,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠故人刘器之待制","author":"李昭玘","text":"文史当年共讲磨，扁舟此地复经过。\n流年屈指梦相似，白发论心喜倍多。\n寄眼偶怀梁苑雪，临风犹骇洞庭波。\n从今燕坐参空寂，却笑天人被佛魔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59139,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"早秋书事二首 其一","author":"李昭玘","text":"正昼睡方起，门无雀可罗。\n风池乱荷盖，雨径满槐鹅。\n齿发流年速，江湖归兴多。\n终期买船去，卧月扣舷歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59140,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"早秋书事二首 其二","author":"李昭玘","text":"尽日与琴语，经旬无客过。\n蝉移鹊争树，鱼散雨倾河。\n每悟酒如圣，不禁诗作魔。\n风声稍萧瑟，残热定无多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59141,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"齿落","author":"李昭玘","text":"孽虫负固饱膻荤，摧折才能绝祸根。\n每遇屠门惭大嚼，犹思梦泽欲平吞。\n初摇不为唇先丧，已脱翻惊舌尚存。\n莫与时人作嘲笑，不如缄口学无言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59142,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"发白有感","author":"李昭玘","text":"剪媙无多日，星星已数茎。\n不空年可讳，端与事俱生。\n安得马肝石，未尝甘露羹。\n有情怜陆展，解与小儿争。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59143,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"早秋","author":"李昭玘","text":"大暑不可怨，秋来终有时。\n露惊庭鹊睡，风动井梧枝。\n逐客长夜感，美人团扇悲。\n如何陶靖节，独与菊花期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59144,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠汉臣","author":"李昭玘","text":"夫子以贫病，终身复冻饥。\n捉衿无可揽，数米不成炊。\n何以谢蟋蟀，独能留扊扅。\n徒劳问仓扁，王老是良医。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59145,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"八月十五日夜大雨","author":"李昭玘","text":"风伯遭谗不自停，鞭龙倒海势如倾。\n胸中洗尽三年渴，□□□□□□□。\n□□□□□□□，千仓嘉谷入新耕。\n野人亦有充饥幸，相见春绵满眼明。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59146,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九月八日雨作","author":"李昭玘","text":"荡涤骄阳势已回，遍流和气入根荄。\n檐间点急侵灯落，枕底声高带雁来。\n永夜故留人不寐，轻寒未放菊全开。\n明年麦价应如土，安用登高把酒杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59147,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"北园偶成二首 其一","author":"李昭玘","text":"游宦归来似系匏，偶依河渚寄衡茅。\n以贫为乐漫喜酒，与世无求非绝交。\n倚杖静闻风过竹，枕书閒看燕争巢。\n却怜多事扬夫子，更为玄文作解嘲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59148,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"北园偶成二首 其二","author":"李昭玘","text":"酒昏便书榻，诗瘦怯寒菹。\n志大怀千驷，功高忆五湖。\n□□□□□，□□□□□。\n何如一杯粥，晴日照吾庐。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59149,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送春","author":"李昭玘","text":"终日无人昼掩扉，绿阴庭草自相依。\n轻寒晓觉池台静，半夜春随风雨归。\n恰似旧游莺独语，略无馀恨燕争飞。\n飘零不解东君意，却放杨花乱扑衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59150,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"有客携扇欲予题字因以一绝答之","author":"李昭玘","text":"平生自笑书成癖，运墨圆毫日几回。\n六角招人聊一戏，区区老媪复能来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59151,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和鲍辇七夕四绝 其一","author":"李昭玘","text":"织女黄姑天一隅，九清飞驭尽通衢。\n年年须作秋风约，此事朦胧信有无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59152,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和鲍辇七夕四绝 其二","author":"李昭玘","text":"奕奕流云度太虚，盛陈瓜果望天衢。\n尝闻刻楮三年久，一夕穿针乞得无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59153,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和鲍辇七夕四绝 其三","author":"李昭玘","text":"如何灵匹异人间，脉脉相望卒卒还。\n不用蛛丝争送巧，自知得拙半生閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59154,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和鲍辇七夕四绝 其四","author":"李昭玘","text":"一水盈盈会合难，古今云路暂来还。\n几多灵鹊成桥去，独有栖乌月底閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59155,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十月晦过舍弟庭玉处见诸人棋战方酣顷之复过集者皆散独枰尚在窗户阒然因成三篇呈子常汉臣 其一","author":"李昭玘","text":"妙手固多暇，忿兵终易穷。\n戏馀归一笑，战罢失群雄。\n风过雨雹息，天明星斗空。\n烂柯人已去，斜日上窗红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59156,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十月晦过舍弟庭玉处见诸人棋战方酣顷之复过集者皆散独枰尚在窗户阒然因成三篇呈子常汉臣 其二","author":"李昭玘","text":"一先虽自喜，百战亦须穷。\n狡兔有三窟，连鸡无两雄。\n霸成秦陌广，骑去楚营空。\n老子无知解，颓然醉颊红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59157,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十月晦过舍弟庭玉处见诸人棋战方酣顷之复过集者皆散独枰尚在窗户阒然因成三篇呈子常汉臣 其三","author":"李昭玘","text":"得失信偶尔，好谋徒自穷。\n前功竟何在，百战漫争雄。\n昧者甘守拙，高人成悟空。\n不如来饮酒，听唱小桃红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59158,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"御试宿集英殿雨过有作呈敏甫学士","author":"李昭玘","text":"朝寒生广陌，宿雨涨方池。\n雾柳和鸦重，风帘为燕攲。\n□□□□□，□□□□□。\n多才恶摩诘，无日不成诗。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59159,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"子常生日无以为寿偶得团茶一饼因书拙诗一首藉之以献","author":"李昭玘","text":"比年方贡竞珍藏，肤理丰腴紫璧光。\n虬膂左回分绝格，蒻衣十袭护新香。\n贵人恩泽才浮赐，俗骨尘埃不合尝。\n愿作诗翁千岁寿，乘风聊复发清狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59160,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"迎驾","author":"李昭玘","text":"端门万骑锦衣红，迤逦鸣槊下半空。\n天极奥居黄道北，瑶池归仗五云中。\n金舆影度长廊日，法曲声回广殿风。\n泗水昔年曾梦到，拜恩何幸接鹓鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59161,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"喜晴寄张使君","author":"李昭玘","text":"使君仁术物同情，日望田畴祝颂成。\n夜滴未休心欲折，朝阳初放眼先明。\n比年岁熟多中上，此事边防系重轻。\n食足讼稀真可乐，时倾杯酒话平生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59162,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"无咎哀辞二首 其一","author":"李昭玘","text":"落落孤标气吐虹，青云指日黑头公。\n两行粉字平生尽，一曲龙吟万事空。\n夹路衣冠如昨日，故园桃李又春风。\n朱弦虽在知音绝，樽酒今谁笑语同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59163,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"无咎哀辞二首 其二","author":"李昭玘","text":"才屈千人未易量，妙年文采已飞扬。\n终身祇得一麾守，后日空留万丈光。\n风驭不来成寂绝，玉楼何在隔苍茫。\n可堪回首鱼峰路，满崦青松照夕阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59164,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送次膺赴诏二首 其一","author":"李昭玘","text":"辞章泛滥昔称雄，飘泊文园偶未逢。\n旧典铙歌归制作，盛时郊祀待形容。\n久无青眼怜高卧，新有宫词落九重。\n异日锦衣还故里，却寻莲社日相从。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59165,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送次膺赴诏二首 其二","author":"李昭玘","text":"青云初上万人看，中路摧颓铩羽翰。\n一日驰声动黄阁，几回飞梦绕长安。\n翩翾丹凤来天上，寂寞双松倚岁寒。\n自笑白头冠尚在，十年尘土不堪弹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59166,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次膺哀辞三首 其一","author":"李昭玘","text":"翻然矫首奉恩除，却似当年擢第初。\n憔悴九衢林下客，光明一轴锦装书。\n冯陵河岳才无敌，绘画乾坤思有馀。\n方板赤虬何太迫，君王曾未识相如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59167,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次膺哀辞三首 其二","author":"李昭玘","text":"平昔弦觞浪自怡，暮年荐鹗有新知。\n蛾眉翻作黄昏哭，乐府空传白纻词。\n上国音尘随梦断，东山箫管结秋悲。\n风亭月观依然在，辽鹤归来复几时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59168,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次膺哀辞三首 其三","author":"李昭玘","text":"行止非人不自谋，飘然一叶信沉浮。\n踌躇去步迷三径，奄忽平生闭一丘。\n韶乐已闻更雅奏，瑶池尤喜近中秋。\n无人解写升平事，惆怅骑鲸去不留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59169,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨后二篇 其一","author":"李昭玘","text":"苦雨几十日，满庭多土花。\n行螺上墙屋，倒竹卧泥沙。\n澄景生凉吹，晴云变晚霞。\n却愁清夜梦，无计逐池蛙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59170,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨后二篇 其二","author":"李昭玘","text":"一气不自息，四时如转丸。\n月流天宇静，风掠叶声乾。\n纨扇已谢事，莎虫将戒寒。\n登临偶有得，不复计悲欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59171,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠汉老侄琴","author":"李昭玘","text":"邹峄孤桐不可寻，汧公旧斲万黄金。\n顾余久有沈舟志，知子尝怀欲炙心。\n便好安弦求妙趣，不须变雅作新音。\n席间弟子来倾耳，为问何人属意深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59172,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"某氏挽辞二首 其一","author":"李昭玘","text":"翟茀朝初罢，升堂拜已非。\n凝尘孟光案，洒血老莱衣。\n奁镜悲鸾舞，庭萱感露晞。\n西风原上路，无复板舆归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59173,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"某氏挽辞二首 其二","author":"李昭玘","text":"主馈齐家道，羞蘩肃妇功。\n疏封秦大国，致养汉三公。\n世事哀荣极，人生梦幻空。\n慈颜不可望，彤史有遗风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59174,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"摘果","author":"李昭玘","text":"霜静百果熟，采摘将荐新。\n贮之黄金盘，绚烂如星陈。\n苞縢待嘉客，培溉昔已勤。\n君子务种德，所成非一身。\n公家有令恩，饤坐多惊人。\n累累万石富，长笑木奴贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59175,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"培花","author":"李昭玘","text":"惜花如曼容，蠹实害心腹。\n养之近胎祸，动绝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59176,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赞潏水先生","author":"李昭玘","text":"结交赖有紫髯翁，鹤骨崭崭烂修目。\n五言长城屹千丈，万卷书楼聊一读。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59177,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日游金明池","author":"李昭玘","text":"日有江湖思，坐无车马尘。\n横桥自照水，啼鸟不惊人。\n辇路晴飞絮，宫门暗锁春。\n多情老园吏，洒地喜相亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59178,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]