[{"title":"绍兴别庙乐歌五首 其二 奉俎用《肃安》。","author":"郊庙朝会歌辞","text":"肇严庙祀，爰图遗芳。\n物必称德，或陈或将。\n有缛其仪，有苾其香。\n灵兮来下，割烹是尝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58071,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绍兴别庙乐歌五首 其一 升殿用《崇安》。","author":"郊庙朝会歌辞","text":"新庙肃肃，蒇事以时。\n陟降阶墄，雍容有仪。\n鞠躬周旋，罔敢不祗。\n祝史正辞，灵其格思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58072,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绍熙别庙二首 其二 安恭皇后室酌献用《歆安》。","author":"郊庙朝会歌辞","text":"美咏河洲，德嫔妫汭。\n徽音如存，肇修祀事。\n缩以包茅，酌以醴齐。\n灵来顾歆，降福攸备。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58073,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绍熙别庙二首 其一 安穆皇后室酌献用《歆安》。","author":"郊庙朝会歌辞","text":"祥发伣天，符彰梦日。\n有怀慈容，孝享庙室。\n泰尊是酌，旨酒嘉栗。\n灵其格思，祚以元吉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58074,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"皇后庙十五首 其十四 终献用《顺安》。","author":"郊庙朝会歌辞","text":"荐献有终，礼容斯穆。\n以奉嘉觞，以膺多福。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58075,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"皇后庙十五首 其十三 亚献用《恭安》。","author":"郊庙朝会歌辞","text":"宗臣率礼，步玉锵锵。\n吉蠲斯献，百禄是将。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58076,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"皇后庙十五首 其十二 饮福用《禧安》。","author":"郊庙朝会歌辞","text":"彝尊鬯酒，庆佑遂行。\n介以纯嘏，允答明诚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58077,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"皇后庙十五首 其十一 元德皇后室用《兴安》。","author":"郊庙朝会歌辞","text":"为太宗后，为天下母。\n诞圣继明，膺乾作主。\n玉振金相，兰芬桂芳。\n于万斯年，永奉烝尝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58078,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"皇后庙十五首 其十 庄怀皇后室用《永安》。","author":"郊庙朝会歌辞","text":"淑德昭著，至乐和平。\n登豆在列，膋香荐诚。\n六变合礼，八音谐声。\n穰穰景福，佑我休明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58079,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"皇后庙十五首 其九 庄穆皇后室用《理安》。","author":"郊庙朝会歌辞","text":"曾孙袭庆，柔祇育德。\n正位居体，其仪不忒。\n教被宫壶，化行邦国。\n祝史正辞，垂裕无极。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58080,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"皇后庙十五首 其八 淑德皇后室用《嘉安》。","author":"郊庙朝会歌辞","text":"明明英媛，德备椒庭。\n笾豆有践，黍稷匪馨。\n静嘉致荐，容与昭灵。\n精意以达，顾享来宁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58081,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"皇后庙十五首 其七 懿德皇后室用《顺安》。","author":"郊庙朝会歌辞","text":"王门禀庆，帝族惟贤。\n功存内治，德协静专。\n流芳图史，垂范纮綖。\n新庙有侐，祀礼昭然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58082,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"皇后庙十五首 其六 孝章皇后室用《懿安》。","author":"郊庙朝会歌辞","text":"猗那淑圣，象应资生。\n配天作合，与日齐明。\n椒宫垂范，彤史扬名。\n聿修毖祀，永奉粢盛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58083,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"皇后庙十五首 其五 孝惠皇后室用《奉安》。","author":"郊庙朝会歌辞","text":"初阳作配，内助惟贤。\n柔顺中积，英徽外宣。\n神宫有侐，明祀惟虔。\n歆诚降祐，于万斯年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58084,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"皇后庙十五首 其四 酌献孝明皇后室用《惠安》。","author":"郊庙朝会歌辞","text":"祀事孔明，庙室惟肃。\n铏登笾豆，金石丝竹。\n既灌既荐，允恭允穆。\n奉神如在，以介景福。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58085,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"皇后庙十五首 其三 司徒捧俎用《丰安》。彻同。","author":"郊庙朝会歌辞","text":"恪恭奉祀，祗荐牺牲。\n九成爰奏，有俎斯盈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58086,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"皇后庙十五首 其二 太尉行用《舒安》。","author":"郊庙朝会歌辞","text":"服章观象，山龙是则。\n容止跄跄，威仪翼翼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58087,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"皇后庙十五首 其一 迎神用《肃安》。","author":"郊庙朝会歌辞","text":"閟宫翼翼，雅乐洋洋。\n牲器肃设，几筵用张。\n饰以明备，秩其令芳。\n神兮来格，风动云翔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58088,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"祗奉天书六首 升降用《灵文》。","author":"郊庙朝会歌辞","text":"旻穹无声，惟德是辅。\n降监锡符，垂文篆素。\n孝瑞纪封，英声载路。\n既寿而昌，笃天之祜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58089,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"祗奉天书六首 其一 奉香酌献用《瑞安》。","author":"郊庙朝会歌辞","text":"谓天盖高，惟皇合德。\n倬彼灵章，图书是锡。\n眷命谆谆，被以遐历。\n膺箓告成，虔恭钦翼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58090,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"祗奉天书六首 泰山社首坛升降用《瑞安》。","author":"郊庙朝会歌辞","text":"玄穹眷怀，宝符申锡。\n垂露腾文，粲然灵迹。\n发祥吉图，纯熙写奕。\n登荐钦崇，式昭天历。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58091,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"祗奉天书六首 含芳园用《瑞安》。","author":"郊庙朝会歌辞","text":"运格熙盛，将封介丘。\n礼神之域，瑞命殊尤。\n灵文荐降，丕显皇猷。\n圣心肃奉，永洽鸿休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58092,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"祗奉天书六首 朝元殿酌献用《瑞安》。","author":"郊庙朝会歌辞","text":"妙道非常，神变无方。\n惟天辅德，灵贶诞章。\n玄文昭锡，宝历弥昌。\n礼崇明祀，式荐馨香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58093,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"真宗告飨六首 其六 六室加谥用《显安》。","author":"郊庙朝会歌辞","text":"钦崇太霄，肃奉徽册。\n大礼克诚，鸿猷有赫。\n令芳爰荐，明灵斯格。\n照谢垂祥，永怀何极。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58094,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"真宗告飨六首 其五 圣祖降亲告用《瑞安》。","author":"郊庙朝会歌辞","text":"于赫圣祖，景灵在天。\n神游来暨，睟容穆然。\n诲言昭示，帝胄开先。\n齐明钦若，延鸿亿年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58095,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"真宗告飨六首 其四 祀汾阴毕躬谢酌献用《显安》。","author":"郊庙朝会歌辞","text":"于昭列圣，休德清明。\n威灵如在，享于克诚。\n报功厚载，馨荐惟精。\n归格饮至，礼备乐成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58096,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"真宗告飨六首 其三 东封毕躬谢酌献用《封安》。","author":"郊庙朝会歌辞","text":"奕奕清庙，锡羡诒谋。\n升中神岳，显允皇猷。\n归格艺祖，昭报灵休。\n奉先追远，盛德益修。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58097,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"真宗告飨六首 其二 太祖、太宗加上尊谥用《显安》。","author":"郊庙朝会歌辞","text":"报贶陟封，聿昭典礼。\n让德穹厚，归功祖祢。\n丕显尊称，尽善尽美。\n寅威孝思，以介蕃祉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58098,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"真宗告飨六首 其一 告受天书用《瑞安》。","author":"郊庙朝会歌辞","text":"宝命自天，鸿禧锡祚。\n昭晰绿文，氤氲黄素。\n玄感荐彰，灵休诞布。\n寅奉珍符，聿怀永慕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58099,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"真宗汾阴礼毕亲谢元德皇后室三首 其三 送神用《理安》。","author":"郊庙朝会歌辞","text":"鸾骖复整，鹤驾难留。\n白云缥缈，紫府深幽。\n庙虽载止，神无不游。\n垂佑皇宋，以永鸿休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58100,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"真宗汾阴礼毕亲谢元德皇后室三首 其二 奉俎用《丰安》。","author":"郊庙朝会歌辞","text":"乐铿金石，俎奉牺牲。\n九成斯奏，五教爰行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58101,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"真宗汾阴礼毕亲谢元德皇后室三首 其一 迎神用《肃安》。","author":"郊庙朝会歌辞","text":"閟宫奕奕，韶乐洋洋。\n牲币虔布，几筵肃张。\n醴泉淳美，嘉肴洁香。\n俟神来格，降彼帝乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58102,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"真宗奉圣祖玉清昭应宫十一首 其十一 送圣用《真安》。","author":"郊庙朝会歌辞","text":"精心既达，真游允臻。\n礼容斯举，福应惟醇。\n将整仙驭，言还上旻。\n永存嘉贶，用泰烝民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58103,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"真宗奉圣祖玉清昭应宫十一首 其十 彻馔用《吉安》。","author":"郊庙朝会歌辞","text":"雕俎在御，飙驾闻声。\n真游斯降，旨酒斯盈。\n大乐云阕，大礼云成。\n彻彼常荐，罄此明诚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58104,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"真宗奉圣祖玉清昭应宫十一首 其九 饮福用《庆安》。","author":"郊庙朝会歌辞","text":"明明始祖，诞启庆基。\n翼翼后嗣，虔奉孝思。\n精洁斯达，祉福咸宜。\n于以报贶，于以受釐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58105,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"真宗奉圣祖玉清昭应宫十一首 其七 太宗位酌献用《庆安》。","author":"郊庙朝会歌辞","text":"明明文考，储精上苍。\n礼乐明备，溥率宾王。\n功德累洽，历数会昌。\n孝思罔极，丕祐无疆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58106,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"真宗奉圣祖玉清昭应宫十一首 其六 太祖位酌献用《庆安》。","author":"郊庙朝会歌辞","text":"赫赫艺祖，受命高穹。\n威加海外，化浃区中。\n发祥宗祏，锡祐眇冲。\n钦承积德，励翼精衷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58107,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"真宗奉圣祖玉清昭应宫十一首 其五 圣祖位酌献用《庆安》。","author":"郊庙朝会歌辞","text":"于昭灵贶，诞启鸿源。\n功济庶汇，庆流后昆。\n兰肴登俎，桂酒盈尊。\n俯回飙驾，永庇云孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58108,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"真宗奉圣祖玉清昭应宫十一首 其四 玉皇位酌献用《庆安》。","author":"郊庙朝会歌辞","text":"无体之体，强名之名。\n监观万宇，统治九清。\n真期保祐，瑞命昭明。\n乾乾翼翼，祗答财成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58109,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"真宗奉圣祖玉清昭应宫十一首 其三 奉馔用《吉安》。","author":"郊庙朝会歌辞","text":"发祥有自，介福无疆。\n纷纶丕应，保佑下方。\n嘉荐斯备，雅奏具扬。\n寅威洞达，监眄昭章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58110,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"真宗奉圣祖玉清昭应宫十一首 其二 奉香用《灵安》。","author":"郊庙朝会歌辞","text":"芳气上浃，飙驭下临。\n绍承丕绪，永励精明。\n氤氲成雾，葱郁垂阴。\n虔恭对越，介祉攸钦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58111,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"真宗奉圣祖玉清昭应宫十一首 其一 降圣用《真安》。","author":"郊庙朝会歌辞","text":"巍巍真宇，奕奕殊庭。\n规模太紫，炳焕丹青。\n元命祗答，大猷是经。\n多仪有践，丕应无形。\n肆设金石，声闻杳冥。\n伫回飙驭，永祐基扃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58112,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"真宗御制二首 其二 亚献、终献用《平晋乐》。","author":"郊庙朝会歌辞","text":"五代衰替，六合携离。\n封疆窃据，兵甲竞驰。\n天顾黎献，涂炭可悲。\n帝启灵命，浚哲应期。\n皇祖丕变，金钺俄麾。\n率土执贽，犷俗来仪。\n瞻彼大卤，窃此馀基。\n独迷文告，莫畏天威。\n神宗继统，璿图有辉。\n尚安蠢尔，罔怀格思。\n六飞夙驾，万旅奉辞。\n徯来发咏，不阵行师。\n云旗先路，壶浆塞岐。\n天临日照，宸虑通微。\n前歌后舞，人心悦随。\n要领自得，智力何施。\n风移僭冒，政治淳熙。\n书文混一，盛德咸宜。\n干戈倒载，振振言归。\n诞昭七德，永定九围。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58113,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"真宗御制二首 其一 奠瓒用《万国朝天》。","author":"郊庙朝会歌辞","text":"鸿源浚发，睿图诞彰。\n高明锡羡，累洽延祥。\n巍巍艺祖，溥率宾王。\n煌煌文考，区宇大康。\n珍符昭显，宝历绵长。\n物性茂遂，民俗阜昌。\n甫田多稼，禾黍穰穰。\n含生嘉育，鸟兽跄跄。\n八纮统域，九服要荒。\n沐浴惠泽，祗畏典常。\n隔谷分壤，望斗辨方。\n并袭冠带，来奉圭璋。\n峨峨双阙，济济明堂。\n诸侯执帛，天后当阳。\n何以辨等，衮衣绣裳。\n何以褒德，辂车乘黄。\n声明焕赫，雅颂汪洋。\n启兹丕绪，祐我无疆。\n大统斯集，大乐斯扬。\n俯隆宗祏，仰继穹苍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58114,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高宗祀明堂前朝享太庙二十一首 其二十一 还大次用《乾安》。","author":"郊庙朝会歌辞","text":"神明既交，恍若有承。\n钦翼齐庄，福禄具膺。\n王业是兴，祖武是绳。\n佑我亿年，以莫不增。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58115,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高宗祀明堂前朝享太庙二十一首 其十九 饮福用《禧安》。","author":"郊庙朝会歌辞","text":"赫赫明明，德与天通。\n施于孙子，福禄攸同。\n日靖四方，民和年丰。\n有秩斯祜，申锡无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58116,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高宗祀明堂前朝享太庙二十一首 其十八 终献用《正安》。","author":"郊庙朝会歌辞","text":"疏幂三举，诚意一纯。\n孰陪予祀，公族振振。\n明灵来娭，乐舞具陈。\n奉神所佑，昭孝息民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58117,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高宗祀明堂前朝享太庙二十一首 其十七 亚献用《正安》。","author":"郊庙朝会歌辞","text":"威神在天，来格于诚。\n既载清酤，有闻无声。\n相予熙事，时赖宗英。\n肃肃雍雍，允协思成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58118,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高宗祀明堂前朝享太庙二十一首 其十六 文舞退、武舞进用《正安》。","author":"郊庙朝会歌辞","text":"作乐合祖，笋簴在庭。\n众奏具举，肃雍和鸣。\n神灵来格，庶几是听。\n皦绎以终，永观厥成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58119,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高宗祀明堂前朝享太庙二十一首 其十五 徽宗室用《承元》。","author":"郊庙朝会歌辞","text":"圣考巍巍，光绍丕基。\n礼隆乐备，时维纯熙。\n天仁兼覆，皇化无为。\n功成弗处，心潜希夷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58120,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高宗祀明堂前朝享太庙二十一首 其十四 哲宗室用《重光》。","author":"郊庙朝会歌辞","text":"明哲煌煌，照临无疆。\n丕承先志，嘉靖多方。\n朝廷尊荣，民庶乐康。\n珍符来应，锡兹重光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58121,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高宗祀明堂前朝享太庙二十一首 其十三 神宗室用《大明》。","author":"郊庙朝会歌辞","text":"烝哉维后，继明体神。\n宪章文武，宜民宜人。\n经世之道，功格于天。\n子孙严祀，无穷之传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58122,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高宗祀明堂前朝享太庙二十一首 其十二 英宗室用《治隆》。","author":"郊庙朝会歌辞","text":"噫我大君，嗣世修文。\n维文维武，諟继虞勋。\n天锡丕祚，施于后昆。\n于荐清酤，酌之欣欣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58123,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高宗祀明堂前朝享太庙二十一首 其十一 真宗室用《熙文》。仁宗室曲同郊祀，送神亦同。","author":"郊庙朝会歌辞","text":"于皇真宗，体道之崇。\n游心物外，应迹寰中。\n四方既同，化民以躬。\n清净无为，盛德之容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58124,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高宗祀明堂前朝享太庙二十一首 其十 太宗室用《大定》。","author":"郊庙朝会歌辞","text":"煌煌神武，再御戎轩。\n时惠南土，旋定太原。\n车书混同，声教布宣。\n维天佑之，亿万斯年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58125,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高宗祀明堂前朝享太庙二十一首 其九 太祖室用《皇武》。","author":"郊庙朝会歌辞","text":"猗欤皇祖，下民攸归。\n膺帝之命，龙翔太微。\n戎车雷动，天地清夷。\n峨峨奉璋，万世无违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58126,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高宗祀明堂前朝享太庙二十一首 其八 宣祖室酌献用《天元》。","author":"郊庙朝会歌辞","text":"昭哉皇祖，骏发其祥。\n雕戈圭瓒，盛烈载扬。\n天锡宝符，俾炽而昌。\n神圣应期，赫然垂光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58127,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高宗祀明堂前朝享太庙二十一首 其七 翼祖室用《大顺》。","author":"郊庙朝会歌辞","text":"上帝监观，维仁是依。\n继世修德，皇心顾之。\n其顾伊何，在彼冀方。\n施于子孙，降福穰穰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58128,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高宗祀明堂前朝享太庙二十一首 其六 僖祖室酌献用《基命》。","author":"郊庙朝会歌辞","text":"何庆之长，实兆于商。\n由商太戊，子孙其昌。\n皇基成命，宋道用光。\n诒厥孙谋，膺受四方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58129,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高宗祀明堂前朝享太庙二十一首 其五 捧俎用《丰安》。","author":"郊庙朝会歌辞","text":"来相于庭，鸣鋗锵锵。\n奉牲而告，登彼雕房。\n非牲之备，民庶是康。\n神依民听，上帝斯皇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58130,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高宗祀明堂前朝享太庙二十一首 其四 迎神用《兴安》。","author":"郊庙朝会歌辞","text":"涓选休成，祖考是享。\n夙夜专精，求诸惚恍。\n洋洋在上，惟神之仰。\n鬯矣清明，应之如响。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58131,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高宗祀明堂前朝享太庙二十一首 其三 盥洗用《乾安》。","author":"郊庙朝会歌辞","text":"于皇维后，观盥之初。\n精意昭著，既顺既愉。\n圭鬯承祀，卿士咸趋。\n目视心化，四方其孚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58132,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高宗祀明堂前朝享太庙二十一首 其二 升殿用《乾安》。","author":"郊庙朝会歌辞","text":"肃哉清宫，熉珠照幄。\n神之来思，八音振作。\n赤舄龙章，奉玉惟恪。\n匪今斯今，先民时若。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58133,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高宗祀明堂前朝享太庙二十一首 其一 皇帝入门用《乾安》。","author":"郊庙朝会歌辞","text":"于皇我后，祗戒专精。\n齐肃有容，祖考是承。\n造次匪懈，孝思纯诚。\n神听有格，福禄来宁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58134,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]