[{"title":"冲虚侍宸王文卿像赞","author":"白玉蟾","text":"醉持铁尺叫风雷，玉帝纶言召两回。\n到得人间无鬼蜮，依然长啸入西台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25283,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"华阳吟 其十四","author":"白玉蟾","text":"一吟一醉一刀圭，真气真精满四肢。\n若到酒酣眠熟后，满船载宝过曹溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25284,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"华阳吟 其三十","author":"白玉蟾","text":"拈弄溪山诗伎巧，吐吞风月酒神通。\n且将诗酒瞒人眼，出入红尘过几冬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25285,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"华阳吟 其二十九","author":"白玉蟾","text":"梦幻之身不久长，桑榆能几耐风霜。\n何如跳出利名窟，赠汝长生不死方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25286,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"华阳吟 其二十八","author":"白玉蟾","text":"气盖山河心胆粗，不能学剑不搜书。\n夜来掇得乾坤动，火候温温守玉炉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25287,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"华阳吟 其二十七","author":"白玉蟾","text":"家在神仙九气天，天中楼殿贮群仙。\n偶然来到人间世，料想神霄未一年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25288,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"华阳吟 其二十六","author":"白玉蟾","text":"绛阙仙都一散郎，偶来尘世且佯狂。\n身中自有长生宝，夜夜飞神谒上苍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25289,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"华阳吟 其二十五","author":"白玉蟾","text":"祇将戊己作丹炉，炼得红丸化玉酥。\n漫守火爻三百日，产成一颗夜明珠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25290,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"华阳吟 其二十四","author":"白玉蟾","text":"曹溪一路透泥丸，只在丹田上下间。\n解使金翁媒姹女，朝云暮雨满巫山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25291,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"华阳吟 其二十三","author":"白玉蟾","text":"玉皇殿下一仙童，曾掌符书守蕊宫。\n因甚俗缘犹未断，于今幻质入尘笼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25292,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"华阳吟 其二十二","author":"白玉蟾","text":"昨夜三更雷撼山，九天门户不曾关。\n曹溪路上分明见，有个金乌入广寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25293,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"华阳吟 其二十一","author":"白玉蟾","text":"谁识周天造化工，于今蹙在片时中。\n只将铅汞入真土，炼出金花满鼎红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25294,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"华阳吟 其二十","author":"白玉蟾","text":"不动丝毫过玉关，关头自有玉京山。\n能于山上通来往，风搅九天霜雪寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25295,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"华阳吟 其十九","author":"白玉蟾","text":"一泓神水满华池，夜夜池边白雪飞。\n雪里有人擒玉兔，赶教明月上寒枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25296,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"华阳吟 其十八","author":"白玉蟾","text":"片饷工夫炼汞铅，一炉猛火夜烧天。\n忽然神水落金井，打合灵砂月样圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25297,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"华阳吟 其十七","author":"白玉蟾","text":"青牛人去几多年，此道分明在目前。\n愿识目前真的处，一堂风冷月婵娟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25298,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"华阳吟 其十六","author":"白玉蟾","text":"饥餐一两黑龟肝，寒向丹田猛火山。\n但见心头无点事，不知人世有饥寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25299,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"华阳吟 其十五","author":"白玉蟾","text":"元神夜夜宿丹田，云满黄庭月满天。\n两个鸳鸯浮绿水，水心一朵紫金莲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25300,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"华阳吟 其十三","author":"白玉蟾","text":"怪事教人笑几回，男儿今也会怀胎。\n自家精血自交媾，身里夫妻真妙哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25301,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"华阳吟 其十二","author":"白玉蟾","text":"人身自有一蓬莱，十二层楼白玉阶。\n姹女金翁常宴会，堂前夜夜牡丹开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25302,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"华阳吟 其十一","author":"白玉蟾","text":"戏泛金船到海涯，暗随海水度流沙。\n一从登著蓬莱岸，去看琼台阆苑花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25303,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"华阳吟 其十","author":"白玉蟾","text":"移将北斗过南辰，两手双擎日月轮。\n飞趁昆崙山上去，须臾化作一天云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25304,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"华阳吟 其九","author":"白玉蟾","text":"渴饮金波数百钟，醉时仗剑指虚空。\n脚根戏蹑交乾斗，长啸一声天地红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25305,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"华阳吟 其八","author":"白玉蟾","text":"白马江头笑一声，红光紫雾水中生。\n急抽匣内青蛇剑，搅得黄河彻底清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25306,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"华阳吟 其七","author":"白玉蟾","text":"得诀归来试炼看，龙争虎斗片时间。\n九华天上人知得，一夜风雷撼万山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25307,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"华阳吟 其五","author":"白玉蟾","text":"拄杖随身入武夷，幔亭峰下雪花飞。\n行从九曲山头看，万壑千岩翠打围。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25308,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"华阳吟 其四","author":"白玉蟾","text":"白云和我到天台，眼入青山意豁开。\n到彼山中结茅屋，空馀千古夜猿哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25309,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"华阳吟 其三","author":"白玉蟾","text":"一脚从别海南船，身逐云飞江浙天。\n走遍洞天寻隐者，不知费几草鞋钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25310,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"华阳吟 其二","author":"白玉蟾","text":"海南一片水云天，望眼生花已十年。\n忽一二时回首处，西风夕照咽悲蝉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25311,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"华阳吟 其一","author":"白玉蟾","text":"家在琼崖万里遥，此身来往似孤舟。\n夜来梦趁西风去，目断家山空泪流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25312,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同邓孤舟林片雪二友晚吟 其三","author":"白玉蟾","text":"江天漠漠但黄芦，雁鹜相呼日已晡。\n雨过月如全赵璧，烟深山似绐秦图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25313,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同邓孤舟林片雪二友晚吟 其二","author":"白玉蟾","text":"君非爱此数峰青，肯恋扁舟尚蓼汀。\n群雁横空成一字，孤萤度水似双星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25314,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同邓孤舟林片雪二友晚吟 其一","author":"白玉蟾","text":"扁舟如叶片帆孤，少霁临江得句无。\n雨竹似人扶酒病，风松学我撚吟须。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25315,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"安仁县问宿","author":"白玉蟾","text":"幕燕翻雷天作云，一声归鸟万林昏。\n荒城寂寞无堪酒，灯下支颐雨打门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25316,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戏鹤林","author":"白玉蟾","text":"柱下固能官老子，漆园亦可禄庄周。\n鹤林不仕知何意，快取青毡趁黑头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25317,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"早行","author":"白玉蟾","text":"店远鸡声近，月斜人影长。\n再三谢风露，拜赐一天凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25318,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"早秋","author":"白玉蟾","text":"云来云去状秋阴，细雨笼晴夕照沉。\n半夜月明千籁静，一声猿叫万山深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25319,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"曲肱诗 其二十","author":"白玉蟾","text":"桑田变海海成田，这话教人信也难。\n只有一般输我处，君王未有此清闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25320,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"曲肱诗 其十九","author":"白玉蟾","text":"不把双眸看俗人，五湖四海一空身。\n洞天深处无人到，溪上桃花几度春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25321,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"曲肱诗 其十八","author":"白玉蟾","text":"不识看经不坐禅，饥来吃饭困来眠。\n玉皇若不开青眼，却是凡夫骨未仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25322,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"曲肱诗 其十七","author":"白玉蟾","text":"我有随身一颗珠，见时似有觅时无。\n金鸡叫罢无人见，月射寒光满太虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25323,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"曲肱诗 其十六","author":"白玉蟾","text":"这回空过二十年，肉重不能飞上天。\n抖擞衲头还自笑，囊中也没一文钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25324,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"曲肱诗 其十五","author":"白玉蟾","text":"跣足蓬头破衲衣，闷来饮酒醉吟诗。\n廛中走遍无人识，我是东华大帝儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25325,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"曲肱诗 其十四","author":"白玉蟾","text":"说与清风明月知，扬州有鹤未能骑。\n夜来五凤楼前看，天上白云空自飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25326,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"曲肱诗 其十三","author":"白玉蟾","text":"白云随我见天台，又趁金华路上回。\n栖凤亭中留不去，武夷山下野猿哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25327,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"曲肱诗 其十二","author":"白玉蟾","text":"做到天仙地位时，三遭天谴落天墀。\n却嫌天上多官府，且就人间洞府嬉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25328,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"曲肱诗 其十一","author":"白玉蟾","text":"往昔逍遥在太华，朝餐玉乳看琼花。\n当年身著六铢服，不识人间有苧麻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25329,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"曲肱诗 其十","author":"白玉蟾","text":"我到人间未百年，恰如顷刻在三天。\n向来我本雷霆吏，今更休疑作甚仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25330,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"曲肱诗 其九","author":"白玉蟾","text":"瑶池王母宴群仙，两部笙歌簇绮筵。\n误取一枚仙李吃，又来人世不知年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25331,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"曲肱诗 其八","author":"白玉蟾","text":"玉府官僚无甚人，上皇怜我最辛勤。\n忽然诏下催归去，猿叫万山空白云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25332,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"曲肱诗 其七","author":"白玉蟾","text":"梦断南柯觉昨非，因缘尽处两分飞。\n寒松空锁翠娥梦，我独于今未得归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25333,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"曲肱诗 其六","author":"白玉蟾","text":"我不生嗔怨玉皇，翠娥无复舞霓裳。\n如何天上神仙女，染污清都一散郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25334,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"曲肱诗 其五","author":"白玉蟾","text":"太乙天皇谒紫清，翠娥百万拥云軿。\n当时不合抬头看，忽见天丁叱火铃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25335,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"曲肱诗 其四","author":"白玉蟾","text":"五雷深锁玉清宫，白鹤呼风唳碧空。\n说著这般辛苦处，三千玉女蹙眉峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25336,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"曲肱诗 其三","author":"白玉蟾","text":"谪君尘世意徘徊，炼尽金丹待鹤来。\n归去神霄朝玉帝，依前命我掌风雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25337,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"曲肱诗 其二","author":"白玉蟾","text":"玉皇有敕问神霄，谁去骑龙乱作妖。\n自别雷城一回首，人间天上已相辽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25338,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"曲肱诗 其一","author":"白玉蟾","text":"昔在青华第一宫，祇缘醉后怒骑龙。\n倾翻半滴金瓶水，不觉人间雨发洪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25339,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"有怀聂尉 其五","author":"白玉蟾","text":"剑浦犹残堠，螺江始问津。\n向来风浪恶，回首谢灵均。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25340,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"有怀聂尉 其四","author":"白玉蟾","text":"不是无知己，相忘独有君。\n孤襟开皓月，往事付浮云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25341,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"有怀聂尉 其三","author":"白玉蟾","text":"月湿松梢露，溪鸣竹里风。\n是中有诗味，何日一樽同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25342,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"有怀聂尉 其二","author":"白玉蟾","text":"北阙投封事，南山返故庐。\n李衡千树橘，张琰一园蔬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25343,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"有怀聂尉 其一","author":"白玉蟾","text":"身岂能为患，心何可得安。\n想应知鹤怨，未得伴鸥闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25344,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵王将仕 其二","author":"白玉蟾","text":"白雾重重山复山，山光树色有无间。\n是中紫翠皆诗料，病起无聊著句难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25345,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵王将仕 其一","author":"白玉蟾","text":"散发披襟乐醉乡，从朝笑语到斜阳。\n坐来一片蝉声久，未信人间有此凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25346,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"霜夕吟月 其二","author":"白玉蟾","text":"吟魂缥渺迈霜空，立影茕然翠阁东。\n素喜半钩西面月，生憎一箭北头风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25347,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵永兴王宰游钟成观 其一","author":"白玉蟾","text":"万斛苍烟恋钓矶，一川秋绿漾清晖。\n空明隐映流光薄，翻忆当年苏紫微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25348,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵曾丈探梅","author":"白玉蟾","text":"夜半风吹雪满阶，头巾不裹把窗开。\n南枝暗就江头发，一点香从月下来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25349,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江上散纵","author":"白玉蟾","text":"欲晓江头杖策徐，一峰西去众峰趋。\n不知林里犹僧寺，少立忽闻敲木鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25350,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江口有怀 其二","author":"白玉蟾","text":"丹枫偷落风无觉，白鹭微行鱼不知。\n两地南楼今夜月，一般清皎百般思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25351,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江口有怀 其一","author":"白玉蟾","text":"霜将枫绿染为红，风把芦花缕作茸。\n云自幕天谁钉挂，月来佐酒与从容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25352,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江头","author":"白玉蟾","text":"江上初收雨，云头尚恋山。\n归帆巡古岸，晴草守沧湾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25353,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江亭夜坐","author":"白玉蟾","text":"月冷松寒露满襟，天容绀碧鹤声沉。\n夜深独把栏干拍，只有长江识此心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25354,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江楼夜话","author":"白玉蟾","text":"江雾秋楼白，灯花夜雨青。\n九天无一梦，此道付晨星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25355,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"竹园 其三","author":"白玉蟾","text":"自笑园丁职事新，一春风雨为供申。\n笋如滕薛皆争长，瓜似朱陈已结亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25356,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"竹园 其二","author":"白玉蟾","text":"一片琅玕香净天，风吹细细雨娟娟。\n龙孙始学斑衣戏，鹙子从谈玉版禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25357,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"竹园 其一","author":"白玉蟾","text":"可惜洋州不再生，此君只许伯夷清。\n霜删近觉林方瘦，笋碍浑无路得行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25358,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"竹里桃花","author":"白玉蟾","text":"风吹雨洗玉猗猗，云捲霞舒锦陆离。\n竹夹桃花花映竹，雅如翠障绣西施。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25359,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秉烛照红梅再次前韵即席","author":"林季仲","text":"玉妃初醉下瑶台，紫雾深深拨不开。\n却恐错穿桃杏径，高烧银烛照归来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25360,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"红梅","author":"白玉蟾","text":"明皇爱雪响云营，侍宴宫娃不计名。\n守等太真眠未起，醺然秉烛到深更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25361,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自赞 其三","author":"白玉蟾","text":"神府雷霆吏，琼山白玉蟾。\n本来真面目，水墨写霜缣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25362,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]