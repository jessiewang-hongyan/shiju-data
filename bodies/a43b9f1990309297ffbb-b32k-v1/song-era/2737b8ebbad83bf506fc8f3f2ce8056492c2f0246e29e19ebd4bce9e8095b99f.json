[{"title":"古歙道中","author":"艾性夫","text":"叠翠峰前听踏歌，十年脚债又经过。\n长因买砚迂途远，每为看山费日多。\n别渚清流团宿鹭，小桥红影动秋荷。\n新安夫子知何在，满目祠亭锁薜萝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27021,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"史氏铁笛","author":"艾性夫","text":"蕲川老竹未为奇，横截凉州黑玉枝。\n阳燧无烟山鬼铸，蓬壶乘月浪仙吹。\n一声响裂千崖石，九曲亭标二老诗。\n俗耳从前听不得，壁尘蛛网故多时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27022,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"失题","author":"艾性夫","text":"格磔声高午梦残，扊扅歌罢酒杯乾。\n漫天飞去杨花乱，著雨归来燕子寒。\n世味淡如和蜡嚼，春山好在带云看。\n近来习性浑成懒，抄尽陶诗独倚阑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27023,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"平塘陶使君挽歌","author":"艾性夫","text":"今代平塘老，前身靖节翁。\n死知随物化，贫与不官同。\n仕国棠阴在，休亭蕙帐空。\n容人方竹马，楚些已西风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27024,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"归大五侄天觉砚","author":"艾性夫","text":"脉暖犹涵老藓斑，眼花仍带泪痕潸。\n厄于劫火元无恙，意在斯文岂苟完。\n一片墨光留手泽，浑家黄色上眉间。\n只消半滴冰蜍水，涨起满村烟雨寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27025,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"旧庐毁于乱十年矣吾老他寓每不能再葺戊子冬良异聚芸人之资自构小堂因以勉之","author":"艾性夫","text":"旧址相传五世昌，寒芜忍堕十年荒。\n老吾衰落空怀土，幸汝辛勤自肯堂。\n袖里莫忘无恤简，墙头犹有孔明桑。\n地灵旧日钟文气，且要扶持此脉长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27026,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"正觉僧榻","author":"艾性夫","text":"赞公分半榻，卧近竹西楼。\n四壁寒蛩夜，一山黄叶秋。\n梦随三鼓动，月尚半窗留。\n零乱芭蕉影，禅衣烂不收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27027,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用言客谈奉谢 其二","author":"艾性夫","text":"门外黄尘透日飞，山中白发得春迟。\n一身冠屦聊存古，半语诗书不入时。\n佳桥尽从中路变，苍松独到岁寒知。\n黑牛白犊今无验，空遣闲愁上两眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27028,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"示子良异","author":"艾性夫","text":"霜雪林头又绿稠，乾坤生意几时休。\n人情葵扇炎凉态，世路瞿塘上下舟。\n鳖跛未输蚿百足，茅封不敌橘千头。\n细看不似吾儒业，一片书田或有秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27029,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"立春日雪","author":"艾性夫","text":"晓炉香剂已烧残，漫捲棨帘倚药栏。\n鞭底土牛方转燠，石边盐虎忽凝寒。\n有人剪綵娱羔酒，独我煎茶续菜盘。\n冰冱砚池呵未泮，东风到底入毫端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27030,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再答诸丈见和二首 其二","author":"艾性夫","text":"肯为刘安赋小山，几时鸡犬过云间。\n命穷无用三千字，蹄蹶难供十二闲。\n薄酒程头多隔县，故人踪迹半阳关。\n何当共嚼西岩雪，嗅取梅花一破颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27031,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再答诸丈见和二首 其一","author":"艾性夫","text":"神龟为我作天山，合住清泉白石间。\n岁月短梭人易老，诗书高阁士方闲。\n秋鸿社燕炎凉势，沧海桑田梦觉关。\n近屋虬松三百尺，时时相对各苍颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27032,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"危见心携示别去寄谢","author":"艾性夫","text":"好客来今雨，长吟出古风。\n诗神君独富，文鬼我方穷。\n湖海飘零外，乾坤感慨中。\n相逢难衮衮，取别竟匆匆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27033,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吊老松","author":"艾性夫","text":"合梁清庙栋明堂，弃掷终身古道傍。\n大节不容秦点污，孤根能与宋存亡。\n山空百丈龙蛇影，泉沁千年琥珀香。\n韦偃毕宏今不见，谁将老骨写风霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27034,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"安南贡象","author":"艾性夫","text":"锦鞯宝勒度南云，到处丛观暗驿尘。\n人喜此生初见象，我忧今世不生麟。\n半年传舍劳供亿，德色中朝动搢绅。\n粉饰太平焉用此，只消黄犊一犁春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27035,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"尽日","author":"艾性夫","text":"尽日坐谷口，看云生岭头。\n蝉声偏占晚，菊色欲专秋。\n江碧水心淡，叶红溪树愁。\n乾坤万万古，流转一虚舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27036,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岁菊","author":"艾性夫","text":"不逐登高老孟嘉，同来守岁阿戎家。\n能将秋圃风霜骨，直作寒梅辈行花。\n香称屠苏浮腊蚁，色侵幡胜插云鸦。\n老夫细把金英撷，独拟明朝早供茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27037,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"有感","author":"艾性夫","text":"江汉亡维楫，山林困蒺藜。\n头颅春雪重，心绪晚云低。\n挂树蛇留蜕，踰垣虎印蹄。\n遥怜伯劳燕，辟地各东西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27038,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次大五侄问移家韵","author":"艾性夫","text":"投老移家僻坞来，满林秋露洗黄埃。\n饭才种麦须堪饱，衣旋培桑未可裁。\n万古乾坤如传舍，一生风雪叹江梅。\n相看喜有青田鹤，肯与诗筒日往回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27039,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次吴寿翁溪园韵寄题","author":"艾性夫","text":"营营谁肯卧沧洲，喜有高人此枕流。\n得水最多知地胜，种花无数欲春留。\n图传笠泽三分画，梦绕黄淤十里秋。\n料得江枫吟未了，载诗应汗谪仙牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27040,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵秋心","author":"艾性夫","text":"短发白已尽，寒花黄到今。\n秋清山见骨，年老树留心。\n独鹤离骚怨，虚泉大雅音。\n冥鸿不知处，引睇暮云深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27041,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江上","author":"艾性夫","text":"江上春肥衰草生，林梢烟暖乳鸠鸣。\n青山与我一面雅，白鸟令人双眼明。\n云净有时看雨泣，水平无处觅溪声。\n折芳弄翠浑閒冗，时与樵渔错杂行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27042,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"竹杖","author":"艾性夫","text":"一枝九节称身长，扶得衰翁气力强。\n色点湘妃红泪雨，骨凝王屋紫藤霜。\n结交最与芒鞋密，寄友应含荜拨香。\n独有探梅时节苦，相随江路雪茫茫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27043,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"老竹","author":"艾性夫","text":"苍黄瘦硬立颓垣，疑是栽时第一根。\n早岁孤君惟二子，暮年千亩尽诸孙。\n雨鞭老迸苍龙骨，霜节寒封古藓痕。\n消得培滋号尊者，把诗题作野人轩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27044,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"老梅","author":"艾性夫","text":"摇落荒村野水涯，貌枯神泽骨槎牙。\n一生知历几多雪，绝好只消三两花。\n万木尊为诸老行，孤根淡似道人家。\n儿时见汝今头白，正拟相看度岁华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27045,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观放鸬鹚","author":"艾性夫","text":"乌鬼淋漓受指呼，江鱼终日为人驱。\n扼吭不及能言鸭，哇肉几同反哺乌。\n暂满空喉如瘿大，竟无半尾塞肠枯。\n少宽颈组方谋饱，水冷沙寒日已晡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27046,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观潮","author":"艾性夫","text":"按节波神逆水来，鱼龙掀舞斗崔嵬。\n浪高峰顶青天雪，风助江声白昼雷。\n势欲上时掀海立，怒无泄处触山回。\n世间亡国知多少，谁似灵胥恨未灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27047,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过长林书罗文恭公碑阴","author":"艾性夫","text":"人家落落堕荒丘，碑带苍苔独自留。\n博陆脊梁浮日月，中郎铭笔法春秋。\n一抔谁下寻坟马，片石今供砺角牛。\n惟有斜阳閒照管，肯和鸦影上螭头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27048,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过石泉寺","author":"艾性夫","text":"藓壁作怪画，石泉操古琴。\n藤多山木老，僧瘦道根深。\n白鹄随人饭，青猿抱佛吟。\n经过恨不数，带雨度遥岑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27049,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"馀干问舟","author":"艾性夫","text":"乌桕林头月上弦，黄芦矶下水平天。\n十年客路多随雁，一树秋声总是蝉。\n江阔乱分渔火细，滩空长漱岸沙圆。\n丁宁说与梢人去，若过芝山且系船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27050,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"医僧洪淡寮见示金刚经解集验方村寺清规皆自著也诗以归之","author":"艾性夫","text":"不作人间肉食僧，霜髭茁茁骨棱棱。\n释经妙在一转语，疗病良于三折肱。\n处寺有规能缚律，即心是佛不传灯。\n胸中历历前朝事，说到西头气拂膺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27051,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即事","author":"艾性夫","text":"一片轻鸿度小坡，半泓浅碧浸丛莎。\n黑云垂地雨声急，黄叶满林秋意多。\n短发未冬先有雪，懒心如井不生波。\n孤砧已报寒消息，欠问眠鸥觅芰荷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27052,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吴种柳枉教辄复奉答","author":"艾性夫","text":"天地穷东野，江湖困子长。\n逢人双白眼，衒俗小红裳。\n旧句传枫冷，新吟带柳香。\n还能相料理，亦足慰凄凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27053,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杉树牌晚憩","author":"艾性夫","text":"倦童呼不诺，久客坐长叹。\n野色归烟暝，秋声入雨寒。\n阅人江树老，经火路牌残。\n近郭鱼羹饭，招呼作晚餐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27054,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"饭客","author":"艾性夫","text":"菜剪尧时韭，羹羞晋代莼。\n家寒多食淡，客好不嫌贫。\n一夜小窗雨，百年华发人。\n明朝未须去，老别最伤神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27055,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"咏眠窝","author":"艾性夫","text":"独榻孤扉木几双，小窝可受北风降。\n带霜枫叶寒供火，随月梅梢瘦入窗。\n梦熟不知衾似铁，睡醒何用酒盈缸。\n近山最有松声好，卧听空潮上浙江。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27056,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庚寅二月朔积雪初霁过和山见雪深堂瑞香盛开回过烟雨村则庭中花更早亦未歇也得数语录似二花主人","author":"艾性夫","text":"烟雨庭前锦伞张，一般秾郁雪深堂。\n偶扶晴日孤筇出，连挹春风两屋香。\n供佛省烧苍柏子，薰书不藉绿芸囊。\n冰霜尽厄芳心在，自与梅花是雁行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27057,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"废贡院为米廪过之值盘廒","author":"艾性夫","text":"担夫勇似踏槐忙，卫卒严于夹棘防。\n千古文章成画饼，万人场屋忽敖仓。\n籍存尚或思班爵，礼废宁容并去羊。\n立尽斜阳还独笑，功名自古梦黄粱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27058,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"枕上","author":"艾性夫","text":"画兰重补纸床屏，支石横眠道气清。\n杜宇不啼春一半，落花如梦雨三更。\n老心暗觅馀年健，万感偏从静夜生。\n最忆宝莲山下月，照人扶醉听吹笙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27059,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"籴踊感兴","author":"艾性夫","text":"笔耕长馁拙生涯，何用撑肠著五车。\n甚欲疗饥难煮字，可怜不饱费炊砂。\n老惭乞米修竿牍，贫欲休粮种枣瓜。\n梦里不知时世换，买珠犹自说京华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27060,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"苦雨喜晴早作散步","author":"艾性夫","text":"寂历山房久杜门，清晨踏碎碧苔纹。\n池经宿雨添三尺，花怯春寒瘦一分。\n满地月凉翻竹露，隔溪风细度松云。\n近来生计随缘足，半亩荒畦手自耘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27061,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"临汝书院落成诸公有诗用韵","author":"艾性夫","text":"鱼跃鸢飞喜落成，鹅湖鹿洞共峥嵘。\n世无孔孟乾坤熄，学到周程日月明。\n议论高虚终害道，圣贤平实不争名。\n光风霁月元无迹，分付庭前草自生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27062,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"客归","author":"艾性夫","text":"发僧行脚倦，归计上心忙。\n秋老蝉声短，江空雁影长。\n乾坤无了日，霜露感殊乡。\n遥想梅花未，还家定雪香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27063,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"拜五世祖妣墓","author":"艾性夫","text":"敬脉人人似饮泉，扫松罗拜喜争先。\n颂琴不朽终流庆，石仲相看莫计年。\n沧海桑田谁料此，秋风宰树幸依然。\n五陵莫说骊山下，愁绝求羊一穗烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27064,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春山","author":"艾性夫","text":"春山不可画，烟雨近江楼。\n藤老依松活，泉迂避石流。\n懒云低渡竹，细草乱沿沟。\n欲打巴禽去，家居听亦愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27065,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"洞泉观杨梅屋寮","author":"艾性夫","text":"孤屿如螺出水心，松苍竹翠结寒阴。\n不因钟磬穿云响，谁信神仙入洞深。\n早日羽衣人尽老，春风摇草路重寻。\n径须著我梅边屋，听讲南华弄玉琴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27066,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"癸巳小至","author":"艾性夫","text":"舌在贫何害，脾清瘦不妨。\n天心半夜子，道脉一分阳。\n山色春秋老，梅花天地香。\n半炉煨芋火，意味颇悠长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27067,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"看镜","author":"艾性夫","text":"自摩寒镜看头颅，短发萧萧不受梳。\n天地风霜吾辈老，江湖烟雨故人疏。\n道穷分命真如纸，世乱功名不要书。\n纵有黄金难铸错，一编残易伴犁锄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27068,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋丁卧堰合楼","author":"艾性夫","text":"忆得年时此倚阑，日边指点说吴山。\n舟移半夜成虚梦，人负斯楼亦厚颜。\n槐古不知花几度，城颓空护屋三间。\n追思往事浑无寐，寂历虚檐月半弯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27069,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋阴","author":"艾性夫","text":"老蝉吟渐懒，愁蚓思无穷。\n数点菊花雨，一溪茅屋风。\n苔衣秋井绿，枫缬晓山红。\n急索鹑裘补，寒先及老翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27070,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋堂","author":"艾性夫","text":"虚幌湿朝露，枯琴寒夜泉。\n苔多应占地，林阙欲分天。\n香细浮烟短，蓬穿漏日圆。\n黄花慰贫老，满眼粲金钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27071,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"荐福寺","author":"艾性夫","text":"细看莫莫堂前月，似是寥寥五祖灯。\n曾有虎来听法去，更无碑可付雷轰。\n修廊半是题诗壁，游客多于住院僧。\n我亦飘零归未得，竹床分卧看云生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27072,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送环洲先罗宪卿","author":"艾性夫","text":"马耳萧萧雪拥裘，乱山南下是处州。\n自从天地生吟骨，何处江山无脚头。\n空有梦随东野去，可无言送子长游。\n白云在望频回首，珍重归期记麦秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27073,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送客至灵谷","author":"艾性夫","text":"仙林路细出山腰，灵谷峰高入紫霄。\n立石借为题字壁，倒松因作度溪桥。\n雨花湿地人归晚，烟草迷川马去遥。\n记得玄都种桃处，黯然分袂各魂销。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27074,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郡中逢桐庐方冰鉴相士","author":"艾性夫","text":"七里滩头曾识面，五峰城里又逢君。\n人间一瞬白驹日，世事几番苍狗云。\n奇骨谁当侯万里，匹夫那可帅三军。\n试凭冰鉴从头问，细雨青灯过夜分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27075,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郡楼九日","author":"艾性夫","text":"虹影初消雨脚收，凭高聊复散牢愁。\n烟横三市蜂房屋，尘掩重门燕子楼。\n黄菊自随陶令节，白云那管汉时秋。\n雁飞不尽乾坤大，安得相从汗漫游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27076,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重宿芳草渡","author":"艾性夫","text":"曾卧江楼听雨声，萧疏又似送归程。\n正如老马倦行路，忽有鹁姑啼晚晴。\n绕屋种花春烂漫，隔窗无树月分明。\n苍头不管人眠熟，连报严城打五更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27077,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重赠星翁陈跛子","author":"艾性夫","text":"拄拐蹒跚鬓雪明，向来小范亦分羹。\n十年不见疑先死，一旦相逢似再生。\n尽乱亦收诗卷上，长贫犹挟命书行。\n试言何物妖星照，是处青山白骨横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27078,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"除夕感兴","author":"艾性夫","text":"黔乌缟兔斗飞梭，春树流年忆踏歌。\n扫白了无烧药法，守玄不及力田科。\n人于淡处交情耐，梅到枯时生意多。\n寂历风帘捲山雪，醉眠不问夜如何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27079,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"除日立春","author":"艾性夫","text":"岁如旧政方书满，春与故人同惠来。\n白发最愁新历换，清谈且博笑颜开。\n屠苏卯酒红生晕，细菜辛盘翠作堆。\n但觅年年各强健，不妨日日小徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27080,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"项羽庙","author":"艾性夫","text":"容心绝少忌心多，背楚疑增自倒戈。\n羞渡乌江依故老，竟乘乌骓泣娇娥。\n一生负气止如此，大义亏人争奈何。\n莫唱送迎山下曲，恐渠惊是汉军歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27081,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"凉棚","author":"艾性夫","text":"数柱伶俜不架椽，密铺松发厚如毡。\n御风难觅深蓬岛，障日聊成矮木天。\n肥瓠引藤高浥露，閒花借荫省浇泉。\n热时搆汝凉时撤，不是疏恩势使然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27082,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭北谷罗先生","author":"艾性夫","text":"死到先生世道衰，忍弹双泪看铭碑。\n动随天去心无愧，视得官轻事敢为。\n他日史书廉太守，四方人哭老宗师。\n不知精爽归何处，定在梅花自在时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27083,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭林止庵","author":"艾性夫","text":"止庵诸老行，今日九原人。\n头为谈经白，家因好客贫。\n欲铭贞曜墓，来哭广成真。\n俯仰南湖月，瑶琴锁碧尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27084,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭环州先生 其一","author":"艾性夫","text":"閒却秋洲野钓矶，谁知远出是危机。\n一篙赣水虚舟急，千里诗魂半夜归。\n前月仆来书尚健，一生志与命相违。\n亲庭已老儿方幼，最为先生泪满衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27085,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]