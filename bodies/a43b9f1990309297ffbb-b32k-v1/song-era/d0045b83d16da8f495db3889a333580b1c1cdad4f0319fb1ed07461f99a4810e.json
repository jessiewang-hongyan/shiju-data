[{"title":"出城","author":"李廌","text":"岸走舟安稳，逍遥若步虚。\n晴烟迷白鹭，春水见浮鱼。\n桑树连坡种，人家夹水居。\n年丰村舍好，稚子学诗书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64497,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"光化霁景楼","author":"李廌","text":"层楼压清汉，初上便忘归。\n夕霭藏平野，晴烟漏翠微。\n城昏晚鸦集，江静野鸥飞。\n何日赋招隐，行吟傍钓矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64498,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"光禄朱卿挽词 其十","author":"李廌","text":"蚤悟多金累，惟修俭与仁。\n考终虽罔愧，直道未容伸。\n地想流谦德，天惟赉善人。\n昭昭锡繁祉，馀庆在振振。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64499,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"光禄朱卿挽词 其九","author":"李廌","text":"五十虽非寿，休嗟不慭遗。\n赏延姑可待，子贵竟何迟。\n异鹊惊蝉蜕，凄风落木芝。\n乘骢千里客，歌罢不胜悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64500,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"光禄朱卿挽词 其八","author":"李廌","text":"沧海梦悠悠，关河壮气收。\n魂归伤委蜕，壑迥失虚舟。\n月暗菰蒲夜，山空木叶秋。\n可堪频怅望，松梓繄新丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64501,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"光禄朱卿挽词 其七","author":"李廌","text":"乐圃林泉好，藤萝荫古台。\n仰攀高节处，豫约挂冠来。\n凉月空堂影，新霜百草荄。\n凄清行乐地，履迹满苍苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64502,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"光禄朱卿挽词 其六","author":"李廌","text":"七十古云稀，公忠况未衰。\n言常思悟主，老更惜明时。\n雪发丹心被，君恩宝剑知。\n如何天不慭，直道竟何施。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64503,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"光禄朱卿挽词 其五","author":"李廌","text":"畴昔始龙馆，能声到海隅。\n兆民方菜色，境政独蒲卢。\n尚赖德弥邵，安知今也无。\n犹闻江左郡，荒政徯来苏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64504,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"光禄朱卿挽词 其四","author":"李廌","text":"南国旧书生，今谁老更荣。\n朱轓频补郡，白首到名卿。\n牧守惟司命，官曹任老成。\n道孚姑已矣，何患不声名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64505,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"光禄朱卿挽词 其三","author":"李廌","text":"省寺官联贵，曾升社稷臣。\n双瞻观日月，接迹望星辰。\n锡爵虽开国，封侯未富民。\n天扉如可到，直拟问通津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64506,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"光禄朱卿挽词 其二","author":"李廌","text":"要路多知己，期公集有庸。\n行趋青琐闼，荣拜紫泥封。\n帝室常虚席，侯邦久卧龙。\n空馀遗爱颂，安得镂斯镛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64507,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"光禄朱卿挽词 其一","author":"李廌","text":"自信仁由己，深知道满门。\n才华辉日域，嘉誉达天阍。\n坦腹方趋进，亨衢迓骏奔。\n欲令唐晋后，不独美姚温。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64508,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再上闾丘通牧少卿","author":"李廌","text":"东邦滨海帝忧劳，慎迪名卿礼意褒。\n板简拜旌前宪掾，云骈骖驭旧仙曹。\n庭柯露下回春色，夜浦珠还息海涛。\n阴惠日隆天眷异，蓬莱东去近金鳌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64509,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同德麟仲宝过谢公定酌酒赏菊以悲哉秋之为气萧瑟八字探韵各赋二诗仍复相次八韵某分得哉萧二字 其二","author":"李廌","text":"葳蕤晚秋菊，芬菲忽齐开。\n缘阶上古垒，粲若黄金台。\n搔首念霜发，撷英泛羽杯。\n颓龄恐能制，寿侯安在哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64510,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吕朝散挽诗二首 其二","author":"李廌","text":"金马玉堂高步宜，中年遂与水云期。\n太冲早擅三都赋，叔度难量万顷陂。\n夜壑藏舟今孰在，白驹过隙事堪悲。\n南园从此无行迹，老桧高松知未知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64511,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吕朝散挽诗二首 其一","author":"李廌","text":"殊重平生邴曼容，退身能勇自为雄。\n盛衰付与枕中梦，福禄犹嗤塞上翁。\n松菊渐荒三径合，鹤猿误怨故山空。\n苍苔满地尘凝席，惟有萧萧蕙帐风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64512,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戏赠史次仲","author":"李廌","text":"世俗匪吾谋，嘉篇常见投。\n旧交皆炫曜，夫子独淹留。\n礼乐尚虚器，衣冠何自囚。\n秪应凉冷后，萧飒更清秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64513,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵刘厚之久阴未雨","author":"李廌","text":"欲和丰年几日霖，密云委地结繁阴。\n莫疑造物收功晚，自是阳和著意深。\n且具黄鸡倾白酒，更求青李与来禽。\n扫除万古穷通想，付与南薰一弄琴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64514,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"老叹","author":"李廌","text":"此身常恐竟无成，忧患频更已不惊。\n下第但能供酒令，他时何意主文盟。\n耽经谩有春秋癖，闭户犹防月旦评。\n独对秋风叹华发，暮云萧瑟岁峥嵘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64515,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过昆阳城","author":"李廌","text":"昆阳城下黍苗稀，寂历荒墟隐翠微。\n远想龙蛇方斗野，解驱虎豹使成围。\n乌知将拥河流断，定喜能令屋瓦飞。\n白水真人今物化，舂陵惟有荷锄归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64516,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过阎氏桥亭","author":"李廌","text":"绿芰红蕖照眼新，池塘风软起青蘋。\n远山碧映重林暮，委径香传别洞春。\n五月独为长道客，沧浪自有濯缨人。\n谁知雅意在丘壑，惭对箕嵩愧路尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64517,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宋英宝宣德自杞至邑将复东还见遗途中诗次韵和之以见惜别","author":"李廌","text":"思君仍岁此相逢，后夜梦魂无复东。\n白纻泪痕何处恨，故园花信几番风。\n归来可喜似新燕，惜别预愁如去鸿。\n老矣奈何春半老，悠悠万事付杯中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64518,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杨十三虞卿在希颜上人房纳凉余时在村舍归和诸公韵","author":"李廌","text":"土渴山焦独在阿，考槃孰与世相过。\n皇皇夫子犹伤凤，碌碌苍生尚执柯。\n头白已惊为学晚，日长赢得读书多。\n北禅释子应相笑，树瘿多年变木鹅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64519,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杨元忠和叶秘校腊茶诗相率偕赋","author":"李廌","text":"风驾已驰供御品，霜郊未卷喊山旂。\n七闽地产犹为宝，两府官高故不遗。\n须藉水帘泉胜乳，也容双井白过磁。\n东堂退食公宫晚，金鼎新烹欲沁脾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64520,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"社日书怀","author":"李廌","text":"社公沐发望年丰，岂谓雨馀仍苦风。\n未报田间禾颖秀，但惊堂上燕巢空。\n里人分胙祈微福，稚子爬沟拟乞聪。\n老病不知秋过半，谩刍新酿要治聋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64521,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谷隐寺书事诗","author":"李廌","text":"云如戏我舒还卷，雨似欺人去复来。\n学道忘忧从老至，持杯得意使颜开。\n骊驹喜饱嘶犹恋，猘犬誇狞吠欲催。\n三日山中果何有，赋诗满得锦囊回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64522,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和二兄书事三首 其三","author":"李廌","text":"功名于我实何多，祇为浮华未浩歌。\n两月病痁诚已甚，半头白发似无何。\n诏惟选吁将从众，学贵师心在匪他。\n当世闻人知不少，片言敢谓众难过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64523,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和二兄书事三首 其二","author":"李廌","text":"逋逃内溃古云多，楚塞群雄尚感歌。\n血飨彼猖神苟幸，庙谋非壮士谁何。\n将军威信当询众，决胜神机岂谓他。\n试把香囊问少子，淝川投策夜潜过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64524,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和二兄书事三首 其一","author":"李廌","text":"年少看书耻未多，壮心今岁沛中歌。\n带江黄帜有蹻蹠，举国白头无绛何。\n为我忠谋能有几，匪人阿比敢言他。\n手攀荆葛藤萝近，敢把新凉取次过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64525,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和人九日诗","author":"李廌","text":"三径就荒陶令宅，两峰高并杜翁情。\n悲秋不奈黄花好，落帽谁怜白发生。\n远岫薄云收细雨，晚林丹叶弄新晴。\n登临俯仰寰区隘，欲驾风轮更上征。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64526,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和人寄寇昌朝韵","author":"李廌","text":"久料腾骧空冀北，如何留滞困周南。\n闻君载酒访狂客，把酒为君当剧谈。\n上国分携今已久，丹砂未就我怀惭。\n六蜚驾驭须天马，吾恐骅骝备两骖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64527,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和人游嵩韵","author":"李廌","text":"嵩高峻极压三川，周视方舆见广员。\n绝顶固知天下小，泰山为占海隅偏。\n白云散尽千林月，急雨收回万壑烟。\n莫笑层峦高似岸，举头一握是玄天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64528,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和次仲砚诗","author":"李廌","text":"闻道端溪好，疑应为土风。\n彼人非博识，此语未为公。\n野客虽云美，才华恐未同。\n濡毫滋墨外，文涣亦徒空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64529,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和杨元忠主簿观鱼","author":"李廌","text":"轻澜沔满带维舟，新雨群鱼藻际浮。\n既亦非知梁上乐，敢嗟彼有釜中忧。\n汉江水浊斑衣獭，楚岸烟深雪色鸥。\n未作金鳌莫惊惕，月澄清海漫如钩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64530,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和郑十三东斋言事二首 其二","author":"李廌","text":"春光故故恼人情，新葺茆茨欲醉经。\n积雨水衣龙颔滑，晚晴山翠佛螺青。\n月边柳色疏疏见，风外梅花细细听。\n半夜白云生石枕，润珠蒸湿醉魂醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64531,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和郑十三东斋言事二首 其一","author":"李廌","text":"为贫轩冕未忘情，宁使栖迟抱六经。\n安得神仙断鲸剑，拂开云翳露天青。\n雾浓玄豹终朝隐，冰薄猜狐抵夜听。\n昏垫直疑皆饮鸩，沉冥何苦辨清醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64532,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和钱之道游虎丘二首 其二","author":"李廌","text":"石头槎牙占官道，松树老怪蘖断云。\n骊龙睡隐潭水黑，雨积粪壤生朝菌。\n山光缭绕林朴樕，野气空阔云氤氲。\n归来月落天色莫，水边游女溅红裙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64533,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和钱之道游虎丘二首 其一","author":"李廌","text":"轻云细雨放花时，才过清明已夹衣。\n拚得酒时教尽醉，可题诗处莫空归。\n丁宁莺语机关巧，轻薄杨花气力微。\n阊阖晚来行客尽，稚乌相趁入城飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64534,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宝干山茶","author":"李廌","text":"山茶乃凡木，宝干始为奇。\n婉雅瑞荷花，扶疏连理枝。\n倾心相尔汝，和气生怡怡。\n清阴亦可爱，恶木正离披。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64535,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"范蜀公挽诗 其一","author":"李廌","text":"蚤岁青云近，英声四海驰。\n能怀天下宝，独让月中枝。\n既已登龙坂，咸观入凤池。\n如何老清禁，偃蹇卧明时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64536,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"范蜀公挽诗 其四","author":"李廌","text":"荆舒昔未惩，抗疏誓身争。\n卫鞅虽难屈，桑羊屡请烹。\n危言知不用，脱屣谢浮荣。\n岂恋三台近，全无万世清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64537,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"范蜀公挽诗 其十","author":"李廌","text":"众乐西南圃，从公数共游。\n清无马融帐，荣预李膺舟。\n河汉德星陨，山川英气收。\n孤生筑场意，索寞向新丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64538,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"范蜀公挽诗 其八","author":"李廌","text":"重望晋随会，清明越大夫。\n忘身安社稷，寄傲老江湖。\n黼冕固已远，黄金犹可模。\n旌贤宜异数，愿上孝宣图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64539,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"范蜀公挽诗 其九","author":"李廌","text":"八十虽云寿，吾嗟未及期。\n方之昔卫武，犹不至期颐。\n幸处仁人里，叨膺国士知。\n空馀恋轩想，况复九原悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64540,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"范蜀公挽诗 其二","author":"李廌","text":"仁人宜有勇，无欲故能刚。\n凛凛回天力，危危极谏章。\n一言扶日御，万古正乾纲。\n首犯龙鳞意，渊衷亮未忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64541,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"范蜀公挽诗 其七","author":"李廌","text":"关雎久盈耳，魏阙亦游心。\n不废江湖乐，亲调钟磬音。\n九重初击拊，千代正哇淫。\n器在人亡矣，哀哉泪满襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64542,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"范蜀公挽诗 其五","author":"李廌","text":"直气犯荆舒，承明下玉除。\n禁林馀谏藁，蜀道拥安车。\n自谓三宜去，吾知众莫如。\n谁为忠义传，事事举堪书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64543,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"范蜀公挽诗 其六","author":"李廌","text":"嗣皇思故老，趣诏侍筵经。\n驷马空频驾，高鸿本自冥。\n苍生虽绝望，盛德愈流馨。\n出处俱全节，辉光并日星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64544,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"范蜀公挽诗 其三","author":"李廌","text":"庆宁虽首议，濮庙一何公。\n君子初无党，贤臣惟尽忠。\n死生全大节，社稷倚元功。\n疾彼梁丘子，依违秪尚同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64545,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"范蜀公得请再致仕蜀公作诗命某次韵","author":"李廌","text":"老恋林泉拒衮衣，高山景行众思齐。\n久膺重任当先觉，独以清风激众迷。\n越相家声千载后，商公旧隐白云西。\n坐令贪懦趋忠厚，寄语狂童勿芥鸡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64546,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"表高氏石公之墓","author":"李廌","text":"黄金照地晋将军，剑履盈门万石君。\n独以德名追远裔，尽将富贵比浮云。\n璚田种药期公寿，夜壑移舟忽梦分。\n彷佛平生阻瞻觌，一诗三叹漫殷勤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64547,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诗一首","author":"李廌","text":"江皋草茅软，马首路平宽。\n叹老龙钟态，伤春料峭寒。\n月檐茅影乱，风瓦竹声乾。\n喜从佳公子，诗成槊在鞍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64548,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"钓台","author":"李廌","text":"钓国固有术，直钩宁漫劳。\n吾常鄙龙伯，岂复羡琴高。\n濯足风波地，游心虎豹韬。\n谁云无是子，天下自嚣嚣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64549,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登钓台","author":"范端臣","text":"此地有天险，双台千仞岗。\n眼宽知世窄，皇极便神伤。\n惨澹诸峰立，萦纡一水长。\n振衣怀古罢，新句入斜阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64550,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨中宿超化寺","author":"李廌","text":"暴雨如建瓴，龙渊俄怒流。\n逸哉我三士，冒雨探奇幽。\n古寺浮积壤，危若萍与沤。\n抱忧穷乐事，斗酒聊重留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64551,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨中游法王寺诗","author":"李廌","text":"雨脚如麻未肯收，雨中还作法王游。\n云埋辇路烟初合，水溅松岩雪乱流。\n心畏险途常恐失，寒侵病骨已知秋。\n群峰耸峭犹无畏，为语山僧不用留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64552,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"青泥雪中和德麟韵","author":"李廌","text":"君笑吾痴绝，吾知自不痴。\n远游陪胜士，归橐有新诗。\n笑觉山途近，寒因酒力迟。\n相从畏嘲谑，别后复怀思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64553,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哀都官王申","author":"李廌","text":"垄上弓旌降鹤书，戋戋璧帛贲乡闾。\n汉宫入奏贤臣颂，蜀道荣观驷马车。\n谁谓诸侯老宾客，归来华发伴樵渔。\n泮宫陈迹神游否，绛帐门生多石渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64554,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"某与鲜于绰元勋共约同习制科","author":"李廌","text":"赵括痴儿漫喜兵，他年自料困长平。\n将军各有万人敌，下士难先二子鸣。\n卢骆杨王何足算，江黄六蓼岂劳征。\n英雄少贬虽惭愧，且徇区区月旦评。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64555,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋山","author":"李廌","text":"山色带晴云，云山远莫分。\n寒林迥萧散，秀气自氤氲。\n定有丘园士，彼同麋鹿群。\n弓旌访岩谷，谁为上方闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64556,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋日杂兴 其六","author":"李廌","text":"芡珠乃笾实，鸡首真溪毛。\n芥羽复丹帻，凌波竞将号。\n苍啄胜玄蚝，百琲转含桃。\n骊颔有照乘，海夫得应劳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64557,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋风","author":"李廌","text":"万籁静中起，扶摇风怒号。\n半天鸣剑戟，平地卷波涛。\n鹢退宋都疾，鹏抟溟海高。\n贺兰吹不尽，何用战蓬蒿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64558,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋郊","author":"李廌","text":"郊原千里望，好是暮秋时。\n欲尽登临兴，惟应杖屦宜。\n鹗雕方得意，燕雀彼焉知。\n黄犬苍鹰去，谁家年少儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64559,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋扇和之道","author":"李廌","text":"过时悲既往，适用复相先。\n世事蓂生陨，人情月晦圆。\n寒凉非尔适，衰歇岂余捐。\n岁事待秋敛，农夫期有年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64560,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋晓","author":"李廌","text":"秋色已飘零，凄凄晓更清。\n芜城宿残霭，云日递微明。\n瓦冷寒霜色，庭空槁叶声。\n悲欢更盈耳，箫鼓和铙钲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64561,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋莺诗","author":"李廌","text":"秋日生春意，林间闻晓莺。\n奈何时序晚，不及候虫鸣。\n摇落无多感，芳菲会满城。\n好音宜自默，反舌可无声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64562,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋菊","author":"李廌","text":"春花富红紫，黄菊与秋宜。\n风劲幽香怯，露晞寒艳滋。\n孤标虽独步，呈秀此何迟。\n欲待群芳歇，专荣占一时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64563,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]