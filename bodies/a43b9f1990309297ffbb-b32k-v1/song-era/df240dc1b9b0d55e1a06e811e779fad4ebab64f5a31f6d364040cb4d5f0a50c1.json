[{"title":"南乡子 其二","author":"黄庭坚","text":"未报贾船回。\n三径荒锄菊卧开。\n想得邻船霜笛罢，沾衣。\n不为涪翁更为谁。\n风力袅萸枝。\n酒面红鳞惬细吹。\n莫笑插花和事老，摧颓。\n却向人间耐盛衰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73665,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南柯子/南歌子 其一","author":"黄庭坚","text":"郭泰曾名我，刘翁复见谁。\n入廛还作和罗槌。\n特地干戈相待、使人疑。\n秋浦横波眼，春窗远岫眉。\n补陀岩畔夕阳迟。\n何似金沙滩上、放憨时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73666,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南柯子/南歌子 其二","author":"黄庭坚","text":"万里沧江月，波清说向谁。\n顶门须更下金槌。\n只恐风惊草动、又生疑。\n金雁斜妆颊，青螺浅画眉。\n庖丁有底下刀迟。\n直要人牛无际、是休时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73667,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南浦","author":"黄庭坚","text":"太守俱来此西山，楼观重复半烟间。\n高僧置酒林泉处，南浦名区望没环。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73668,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南歌子","author":"黄庭坚","text":"诗有渊明语，歌无子夜声。\n论文思见老弥明。\n坐想罗浮山下、羽衣轻。\n何处黔中郡，遥知隔晚晴。\n雨馀风急断虹横。\n应梦池塘春草、若为情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73669,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南歌子","author":"黄庭坚","text":"槐绿低窗暗，榴红照眼明。\n玉人邀我少留行。\n无奈一帆烟雨、画船轻。\n柳叶随歌皱，梨花与泪倾。\n别时不似见时情。\n今夜月明江上、酒初醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73670,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"品令 送黔守曹伯达供备","author":"黄庭坚","text":"败叶霜天晓。\n渐鼓吹、催行棹。\n栽成桃李未开，便解银章归报。\n去取麒麟图画，要及年少。\n劝公醉倒。\n别语怎向醒时道。\n楚山千里暮云，正锁离人情抱。\n记取江州司马，坐中最老。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73671,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"品令 茶词","author":"黄庭坚","text":"凤舞团团饼。\n恨分破、教孤令。\n金渠体净，只轮慢碾，玉尘光莹。\n汤响松风，早减了、二分酒病。\n味浓香永。\n醉乡路、成佳境。\n恰如灯下，故人万里，归来对影。\n口不能言，心下快活自省。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73672,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"昼夜乐","author":"黄庭坚","text":"夜深记得临歧语。\n说花时、归来去。\n教人每日思量，到处与谁分付。\n其奈冤家无定据。\n约云朝、又还雨暮。\n将泪入鸳衾，总不成行步。\n元来也解知思虑。\n一封书、深相许。\n情知玉帐堪欢，为向金门进取。\n直待腰金拖紫后，有夫人、县君相与。\n争奈会分疏，没嫌伊门路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73673,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"洞仙歌 泸守王补之生日","author":"黄庭坚","text":"月中丹桂，自风霜难老。\n阅尽人间盛衰草。\n望中秋、才有几日，十分圆，霾风雨，云表常如永昼。\n不得文章力，白首防秋，谁念云中上功守。\n正注意，得人雄，静扫河山，应难纵、五湖归棹。\n问持节冯唐几时来，看再策勋名，印窠如斗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73674,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"点绛唇","author":"黄庭坚","text":"浊酒黄花，画檐十日无秋燕。\n梦中相见。\n起作南柯观。\n镜里朱颜，又减年时半。\n江山远。\n登高人健。\n应问西来雁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73675,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"点绛唇 其一","author":"黄庭坚","text":"几日无书，举头欲问西来燕。\n世情梦幻。\n复作如斯观。\n自叹人生，分合常相半。\n戎虽远。\n念中相见。\n不托鱼和雁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73676,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"看花回 茶词","author":"黄庭坚","text":"夜永兰堂醺饮，半倚颓玉。\n烂熳坠钿堕履，是醉时风景，花暗烛残，欢意未阑，舞燕歌珠成断续。\n催茗饮、旋煮寒泉，露井瓶窦响飞瀑。\n纤指缓、连环动触。\n渐泛起、满瓯银粟。\n香引春风在手，似粤岭闽溪，初采盈掬。\n暗想当时，探春连云询篁竹。\n怎归得，鬓将老，付与杯中绿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73677,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贺圣朝","author":"黄庭坚","text":"脱霜披茜初登第。\n名高得意。\n樱桃荣宴玉墀游，领群仙行缀。\n佳人何事。\n轻相戏道，得之何济。\n君家声誉古无双，且均平居二。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73678,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宴桃源/如梦令 书赵伯充家上姬领巾","author":"黄庭坚","text":"天气把人僝僽。\n落絮游丝时候。\n茶饭可曾忺，镜中赢得销瘦。\n生受。\n生受。\n更被养娘催绣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73679,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"捣练子","author":"黄庭坚","text":"梅凋粉，柳摇金。\n微雨轻风敛陌尘。\n厚约深盟何处诉，除非重见那人人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73680,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"桃源忆故人","author":"黄庭坚","text":"碧天露洗春容净。\n淡月晓收残晕。\n花上密烟飘尽。\n花底莺声嫩。\n云归楚峡厌厌困。\n两点遥山新恨。\n和泪暗弹红粉。\n生怕人来问。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73681,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙","author":"黄庭坚","text":"新妇滩头眉黛愁。\n女儿浦口眼波秋。\n惊鱼错认月沈钩。\n青箬笠前无限事，绿蓑衣底一时休。\n斜风吹雨转船头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73682,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其一","author":"黄庭坚","text":"飞鹊台前晕翠蛾。\n千金新买帝青螺。\n最难如意为情多。\n几处泪痕留醉袖，一春愁思近横波。\n远山低尽不成歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73683,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其二","author":"黄庭坚","text":"一叶扁舟卷画帘。\n老妻学饮伴清谈。\n人传诗句满江南。\n林下猿垂窥涤砚，岩前鹿卧看收帆。\n杜鹃声乱水如环。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73684,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浪淘沙令 荔枝","author":"黄庭坚","text":"忆昔谪巴蛮。\n荔子亲攀。\n冰肌照映柘枝冠。\n日擘轻红三百颗，一味甘寒。\n重入鬼门关。\n也似人间。\n一双和叶插云鬟。\n赖得清湘燕玉面，同倚阑干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73685,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"留春令","author":"黄庭坚","text":"江南一雁横秋水。\n叹咫尺、断行千里。\n回纹机上字纵横，欲寄远、凭谁是。\n谢客池塘春都未。\n微微动、短墙桃李。\n半阴才暖却清寒，是瘦损、人天气。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73686,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"离亭燕/离亭宴 次韵答廖明略见寄","author":"黄庭坚","text":"十载樽前谈笑。\n天禄故人年少。\n可是陆沈英俊地，看即锁窗批诏。\n此处忽相逢，潦倒秃翁同调。\n西顾郎官湖渺。\n事看庾楼人小。\n短艇绝江空怅望，寄得诗来高妙。\n梦去倚君傍，胡蝶归来清晓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73687,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绣带子/好女儿 张宽夫园赏梅","author":"黄庭坚","text":"小院一枝梅。\n冲破晓寒开。\n晚到芳园游戏，满袖带香回。\n玉酒覆银杯。\n尽醉去、犹待重来。\n东邻何事，惊吹怨笛，雪片成堆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73688,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"调笑歌/调笑令","author":"黄庭坚","text":"无语。\n恨如许。\n方士归时肠断处。\n梨花一枝春带雨。\n半钿分钗亲付。\n天长地久相思苦。\n渺渺鲸波无路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73689,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"逍遥乐","author":"黄庭坚","text":"春意渐归芳草。\n故国佳人，千里信沈音杳。\n雨润烟光，晚景澄明，极目危栏斜照。\n梦当年少。\n对樽前、上客邹枚，小鬟燕赵。\n共舞雪歌尘，醉里谈笑。\n花色枝枝争好。\n鬓丝年年渐老。\n如今遇风景，空瘦损、向谁道。\n东君幸赐与，天幕翠遮红绕。\n休休，醉乡歧路，华胥蓬岛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73690,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"减字木兰花 其三 登巫山县楼作","author":"黄庭坚","text":"襄王梦里。\n草绿烟深何处是。\n宋玉台头。\n暮雨朝云几许愁。\n飞花漫漫。\n不管羁人肠欲断。\n春水茫茫。\n欲度南陵更断肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73691,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玉楼春 其六","author":"黄庭坚","text":"可怜翡翠随鸡走。\n学绾双鬟年纪小。\n见来行待恶怜伊，心性娇痴空解笑。\n红蕖照映霜林表。\n杨柳舞风腰袅袅。\n衾馀枕剩尽相容，只是老人难再少。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73692,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"减字木兰花 其九","author":"黄庭坚","text":"中秋无雨。\n醉送月衔西岭去。\n笑口须开。\n几度中秋见月来。\n前年江外。\n儿女传杯兄弟会。\n此夜登楼。\n小谢清吟慰白头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73693,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"减字木兰花 其七 私情","author":"黄庭坚","text":"终宵忘寐。\n好事如何犹尚未。\n子细沈吟。\n珠泪盈盈湿袖襟。\n与君别也。\n愿在郎心莫暂舍。\n记取盟言。\n闻早回程却再圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73694,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"减字木兰花 其四","author":"黄庭坚","text":"巫山古县。\n老杜淹留情始见。\n拨闷题诗。\n千古神交世不知。\n云阳台下。\n更值清明风雨夜。\n知道愁辛。\n果是当时作赋人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73695,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清平乐 其四","author":"黄庭坚","text":"舞鬟娟好。\n白发黄花帽。\n醉任旁观嘲潦倒。\n扶老偏宜年小。\n舞回脸玉胸酥。\n缠头一斛明珠。\n日日梁州薄媚，年年金菊茱萸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73696,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玉楼春 其五","author":"黄庭坚","text":"黔中士女游晴昼。\n花信轻寒罗袖透。\n争寻穿石道宜男，更买江鱼双贯柳。\n竹枝歌好移船就。\n依倚风光垂翠袖。\n满倾芦酒指摩围，相守与郎如许寿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73697,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"减字木兰花 其十三 用前韵示知命弟","author":"黄庭坚","text":"当年夜雨。\n头白相依无去住。\n儿女成围。\n欢笑尊前月照之。\n阿连高秀。\n千万里来忠孝有。\n岂谓无衣。\n岁晚先寒要弟知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73698,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玉楼春 其四","author":"黄庭坚","text":"黄金捍拨春风手，帘幕重重音韵透。\n梅花破萼便回春，似有黄鹂鸣翠柳。\n晓妆未惬梅添就，玉笋捧杯离钿袖。\n会拼千日笑尊前，他日相思空损寿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73699,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清平乐 其五 示知命","author":"黄庭坚","text":"乍晴秋好。\n黄菊敧乌帽。\n不见清谈人绝倒。\n更忆添丁小小。\n蜀娘漫点花酥。\n酒槽空滴真珠。\n兄弟四人别住，他年同插茱萸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73700,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"减字木兰花 其十二 戏答","author":"黄庭坚","text":"月中笑语。\n万里同依光景住。\n天水相围。\n相见无因梦见之。\n诸儿娟秀。\n儒学传家渠自有。\n自作秋衣。\n渐老先寒人未知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73701,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"减字木兰花 其一","author":"黄庭坚","text":"浓云骤雨。\n巫峡有情来又去。\n今夜天开。\n不与姮娥作伴来。\n清光无外。\n白发老人心自会。\n何处歌楼。\n贪看冰轮不转头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73702,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"减字木兰花 其五 和赵文仪","author":"黄庭坚","text":"诗翁才刃。\n曾陷文场貔虎阵。\n谁敢当哉。\n况是焚舟决胜来。\n三巴春杪。\n客馆梦回风雨晓。\n胸次峥嵘。\n欲共涛头赤甲平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73703,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玉楼春","author":"黄庭坚","text":"新年何许春光漏。\n小院闭门风日透。\n酥花入坐颇欺梅，雪絮因风全是柳。\n使君落笔春词就。\n应唤歌檀催舞袖。\n得开眉处且开眉，人世可能金石寿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73704,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"减字木兰花 其十一","author":"黄庭坚","text":"举头无语。\n家在月明生处住。\n拟上摩围。\n最上峰头试望之。\n偏怜络秀。\n苦淡同甘谁更有。\n想见牵衣。\n月到愁边总不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73705,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"减字木兰花 其六","author":"黄庭坚","text":"苍崖万仞。\n下有奔雷千百阵。\n自古危哉。\n谁遣西园漝么来。\n猿啼云杪。\n破梦一声巫峡晓。\n苦唤愁生。\n不是西园作么平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73706,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"减字木兰花 其一 春","author":"黄庭坚","text":"馀寒争令。\n雪共蜡梅相照影。\n昨夜东风。\n已出耕牛劝岁功。\n阴云羃羃。\n近觉去天无几尺。\n休恨春迟。\n桃李梢头次第知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73707,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"减字木兰花 其八","author":"黄庭坚","text":"中秋多雨。\n常是尊罍狼藉去。\n今夜云开。\n须道姮娥得得来。\n不知云外。\n还有清光同此会。\n笛在层楼。\n声彻摩围顶上头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73708,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"减字木兰花 其二","author":"黄庭坚","text":"拂我眉头。\n无处重寻庾信愁。\n山云弥漫。\n夹道旌旗联复断。\n万事茫茫。\n分付澄波与烂肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73709,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"惜馀欢/惜余欢 茶词","author":"黄庭坚","text":"四时美景，正年少赏心，频启东阁。\n芳酒载盈车，喜朋侣簪合。\n杯觞交飞劝酬献，正酣饮、醉主公陈榻。\n坐来争奈，玉山未颓，兴寻巫峡。\n歌阑旋烧绛蜡。\n况漏转铜壶，烟断香鸭。\n犹整醉中花，借纤手重插。\n相将扶上，金鞍騕袅，碾春焙、愿少延欢洽。\n未须归去，重寻艳歌，更留时霎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73710,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"望江东","author":"黄庭坚","text":"江水西头隔烟树。\n望不见、江东路。\n思量只有梦来去。\n更不怕、江阑住。\n灯前写了书无数。\n算没个、人传与。\n直饶寻得雁分付。\n又还是、秋将暮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73711,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"望远行","author":"黄庭坚","text":"自见来，虚过却、好时好日。\n这訑尿粘腻得处煞是律。\n据眼前言定，也有十分七八。\n冤我无心除告佛。\n管人闲底，且放我快活。\n便索些别茶祗待，又怎不遇偎花映月。\n且与一班半点，只怕你没丁香核。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73712,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清平乐 其六 饮宴","author":"黄庭坚","text":"冰堂酒好。\n只恨银杯小。\n新作金荷工献巧。\n图要连台拗倒。\n采莲一曲清歌。\n争檀催卷金荷。\n醉里香飘睡鸭，更惊罗袜凌波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73713,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清平乐 其三","author":"黄庭坚","text":"休推小户。\n看即风光暮。\n萸粉菊英浮碗醑。\n报答风光有处。\n几回笑口能开。\n少年不肯重来。\n借问牛山戏马，今为谁姓池台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73714,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清平乐 其二 重九","author":"黄庭坚","text":"黄花当户。\n已觉秋容暮。\n云梦南州逢笑语。\n心在歌边舞处。\n使君一笑眉开。\n新晴照酒尊来。\n且乐尊前见在，休思走马章台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73715,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清平乐 其一","author":"黄庭坚","text":"春归何处？\n寂寞无行路。\n若有人知春去处，唤取归来同住。\n春无踪迹谁知？\n除非问取黄鹂。\n百啭无人能解，因风飞过蔷薇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73716,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔家傲 其一","author":"黄庭坚","text":"万水千山来此土。\n本提心印传梁武。\n对朕者谁浑不顾。\n成死语。\n江头暗折长芦渡。\n面壁九年看二祖。\n一花五叶亲分付。\n只履提归葱岭去。\n君知否。\n分明忘却来时路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73717,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔家傲 其四","author":"黄庭坚","text":"百丈峰头开古镜。\n马驹踏杀重苏醒。\n接得古灵心眼净。\n光炯炯。\n归来藏在袈裟影。\n好个佛堂佛不圣。\n祖师沈醉犹看镜。\n却与斩新提祖令。\n方猛省。\n无声三昧天皇饼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73718,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔家傲 其五","author":"黄庭坚","text":"踏破草鞋参到了。\n等闲拾得衣中宝。\n遇酒逢花须一笑。\n长年少。\n俗人不用瞋贫道。\n何处青旗夸酒好。\n醉乡路上多芳草。\n提著葫芦行未到。\n风落帽。\n葫芦却缠葫芦倒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73719,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔家傲 题船子钓滩","author":"黄庭坚","text":"荡漾生涯身已老。\n短蓑箬笠扁舟小。\n深入水云人不到。\n吟复笑。\n一轮明月长相照。\n谁谓阿师来问道。\n一桡直与传心要。\n船子踏翻才是了。\n波渺渺。\n长鲸万古无人钓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73720,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔家傲 其二","author":"黄庭坚","text":"三十年来无孔窍。\n几回得眼还迷照。\n一见桃花参学了。\n呈法要。\n无弦琴上单于调。\n摘叶寻枝虚半老。\n拈花特地重年少。\n今后水云人欲晓。\n非玄妙。\n灵云合破桃花笑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73721,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔家傲 其三","author":"黄庭坚","text":"忆昔药山生一虎。\n华亭船上寻人渡。\n散却夹山拈坐具。\n呈见处。\n繁驴橛上合头语。\n千户垂丝君看取。\n离钩三寸无生路。\n蓦口一桡亲子父，犹回顾。\n瞎驴丧我儿孙去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73722,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮","author":"黄庭坚","text":"半烟半雨溪桥畔。\n渔翁醉著无人唤。\n疏懒意何长。\n春风花草香。\n江山如有待。\n此意陶潜解。\n问我去何之。\n君行到自知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73723,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮","author":"黄庭坚","text":"轻风袅断沈烟炷。\n霏微尽日寒塘雨。\n残绣没心情。\n鸟啼花外声。\n离愁难自制。\n年少乖盟誓。\n寂寞掩朱门。\n罗衣空泪痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73724,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 淹泊平山堂。寒食节，固陵绿事参军表弟周元固惠酒，为作此词","author":"黄庭坚","text":"细腰宫外清明雨。\n云阳台上烟如缕。\n云雨暗巫山。\n流人殊未还。\n阿谁知此意。\n解遣双壶至。\n不是白头新。\n周郎旧可人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73725,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谒金门 示知命弟","author":"黄庭坚","text":"山又水。\n行尽吴头楚尾。\n兄弟灯前家万里。\n相看如梦寐。\n君似成蹊桃李。\n入我草堂松桂。\n莫厌岁寒无气味。\n馀生今已矣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73726,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪花飞","author":"黄庭坚","text":"携手青云路稳，天声迤逦传呼。\n袍笏恩章乍赐，春满皇都。\n何处难忘酒，琼花照玉壶。\n归袅丝梢竞醉，雪舞郊衢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73727,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]