[{"title":"游黄山留题","author":"王揆（尤溪","text":"地灵山秀景清虚，健羡游人兴有馀。\n黄叶尽时分叠嶂，白云深处见精庐。\n去同灵运低前屐，回与浮丘揽右裾。\n自叹尘劳羁鞅甚，林泉高趣苦相疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19120,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"怡怡亭","author":"王景云","text":"老年常聚首，兄弟共怡怡。\n并坐閒挥麈，交斟醒设卮。\n双声频检韵，让道更敲棋。\n自是天伦乐，嬉游似少时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19121,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"采石渡","author":"王景月","text":"兴亡怀此渡，贳酒易为醺。\n数树松青处，千年李白坟。\n晓山看夜雪，淮甸没江云。\n牛渚矶边过，惊涛不可闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19122,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桃源行","author":"王景月","text":"秦皇有地包沙漠，秦民无地堪托足。\n民心咫尺不戴秦，秦令安能到空谷。\n商山紫芝青门瓜，武陵洞底栽桃花。\n草木不共人逃去，虞妃山赭良堪嗟。\n秦皇一世二世歇，秦民万世桃花月。\n渔子相逢五百年，已闻几度乾坤裂。\n靖节先生曾作记，祇云贤者兹避世。\n时人浪作神仙传，空自渺茫涉奇异。\n君不见年来礼乐卯金刀，先生归对庐山高。\n所种柴桑五株柳，胜是武陵千树桃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19123,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"怡怡亭","author":"王景华","text":"怡怡亭畔路，兄到弟随肩。\n花径同调瑟，兰窗共擘笺。\n看山携老杖，分果忆儿筵。\n底事常相忍，张家未是贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19124,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送程给事知越州","author":"王晰","text":"冰颜黑发未应衰，巨舰高旌使府威。\n琐闼领藩承嘏去，绣衣过郡买臣归。\n湖山胜迹吟毫健，风月良辰宴斝飞。\n金榜弟兄同舍长，老年相别重依依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19125,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"王晰","text":"当利江头最僻州，怀人惟是数登楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19126,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"王晰","text":"西风晴日过姑苏，左瞰松江右太湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19127,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"皇帝阁立春帖子","author":"王曾","text":"北陆凝阴尽，千门淑气新。\n年年金殿里，宝字贴宜春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19128,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送李文定移镇兖海诗","author":"王曾","text":"锦标夺得曾相继，金鼎调时亦荐更。\n并土儿童君再见，会稽章绂我偏荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19129,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送钱易","author":"王曾","text":"籍其声名喧魏阙，幽奇风物指吴乡。\n上饶此去逾千里，莫惜临岐酒满觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19130,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送何水部蒙出牧袁州","author":"王曾","text":"雉省荣迁拜命新，鱼符重佩出关频。\n停骖却访枌榆社，恋阙回瞻析木津。\n水薤有谁裨政术，江山终日助吟神。\n一麾岭外遥相望，应合趋庭问狷人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19131,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送李寺丞归临江","author":"王曾","text":"辞荣知退出尘埃，泽国皆推隐逸才。\n清世不为王事累，白云重向帝乡来。\n僧因好古留棋诀，鸥为忘机恋钓台。\n应见酒旗回马首，远烟沈澹百花开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19132,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"献金陵牧薛大夫白马诗","author":"王曾","text":"白马披丝练一团，今朝被绊欲行难。\n雪中放去唯留迹，月下牵来只见鞍。\n向北长鸣天外远，临风斜坠耳边寒。\n自知毛骨还应异，更请王良子细看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19133,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其六","author":"王曾","text":"明朝知是天中节，旋刻菖蒲要辟邪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19134,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其十一","author":"王曾","text":"钗头艾虎辟群邪，晓驾祥云七宝车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19135,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"王曾","text":"綵燕迎春入宾飞，轻寒未放缕金衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19136,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其九","author":"王曾","text":"仙艾垂门绿，魂丝绕户长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19137,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其四","author":"王曾","text":"绕臂双条达，红纱昼梦警。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19138,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其十二","author":"王曾","text":"更闻天子孝，荐术助长生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19139,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其十三","author":"王曾","text":"人畏轩台久，春归雨泽多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19140,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送林道会归平阳","author":"王朝佐","text":"研朱点易已多年，洞底烟霞别有天。\n千里漫来骑只鹤，一官归去领群仙。\n药炉煖养烧丹火，茶灶晴分瀹茗泉。\n安得尘襟都扫却，相从细读悟真篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19141,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清辉堂","author":"王朝佐","text":"古汴寒灰不可温，荧荧孤屿火犹存。\n一抔未问长陵土，两字先劳万乘尊。\n卓笔有锋兵自弱，投戈无志艺何论。\n清辉堂外重回首，谩说旋乾与转坤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19142,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"敬轩","author":"王朝佐","text":"作圣阶梯义甚明，岂容惰慢倒仪形。\n气将六马收衔辔，心不多歧守性灵。\n上帝鉴兹恒翼翼，主翁唤醒更惺惺。\n揭楣倘有希贤志，合把斋箴究考亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19143,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题英薮山房","author":"王朝佐","text":"筑室傍丹梯，新颜手自题。\n空涵龙洞雨，壁污燕巢泥。\n树色围春昼，书声杂暮溪。\n南园花正发，携酒听莺啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19144,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贞义女祠","author":"王朝佐","text":"濑水何泱泱，携篚向水旁。\n低头事漂洗，不惜湿罗裳。\n晨出未暮归，老母在高堂。\n三十不愿适，焉知绣鸳鸯。\n道逢困丈夫，行乞良可伤。\n一饭妇女仁，况有残壶浆。\n终焉感礼义，出词何慨慷。\n贞洁恐无知，清流见肝肠。\n悲哉伍子胥，百金何足偿。\n惟有鸱夷心，可与增辉光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19145,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"第一山","author":"王渥","text":"亭耸东南第一山，登临身在白云间。\n市楼斜日红高下，客艇轻波绿往还。\n舆地望中成异境，将军阃外亦胡颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19146,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"凤凰台","author":"王渭卿","text":"江山还似六朝时，老尽梧桐凤不知。\n保大空存前殿佛，元嘉已没旧廊碑。\n几年何德之衰也，曷日览辉而下之。\n不见长安豪杰恨，诸公忍读谪仙诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19147,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游大涤","author":"王溉","text":"山合群峰路屈盘，溪行九折势蜿蜒。\n云根长伴仙人迹，元盖潜通大涤天。\n玉殿香消人寂寂，石坛花落草芊芊。\n黄冠解识寻幽兴，为洗寒铛煮碧泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19148,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"老人村","author":"王溉","text":"山前老泽经行路，百岁翁翁犹健步。\n非仙非佛非鬼神，不识人间盐与醋。\n嗜欲既浅亦机深，窟宅宜与仙家邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19149,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"王溉","text":"只应唤作小西湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19150,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"王溉","text":"仙人有宫号储福，藏在千山万山曲。\n翠微高下压檐楹，重叠堆峰三十六。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19151,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其三","author":"王溉","text":"西边更拥上皇山，大面六顶不可攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19152,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"无弦琴","author":"王琪","text":"寂寞之淳音，其为乐至深。\n应嫌鼓腹者，独自抚弦琴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19153,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"红梅","author":"王琪","text":"馆娃宫里旧精神，粉瘦琼寒露蕊新。\n园吏无端偷折去，凤城从此有双身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19154,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"垂虹亭","author":"王琪","text":"红桥跨浪二千尺，桥上危亭在水心。\n六月火云烧万里，夜来风细似秋深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19155,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句 其二","author":"王琪","text":"正月初弦二月赊，小园春事已如麻。\n强誇力健因移石，不减公忙为种花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19156,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句 其一","author":"王琪","text":"香溪春老误寻芳，只有愁云映夕阳。\n今日重来已如此，何须更问海生桑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19157,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答永叔问","author":"王琪","text":"班班疏雨寒无定，皎皎圆蟾望欲阑。\n应在浮云尽深处，更凭丝竹一催看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19158,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"暮春游小园","author":"王琪","text":"一丛梅粉褪残妆，涂抹新红上海棠。\n开到荼蘼花事了，丝丝天棘出莓墙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19159,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九曲池","author":"王琪","text":"越调隋家曲，当年亦九成。\n哀音已亡国，废诏尚留名。\n仪凤终沉影，鸣蛙祇沸声。\n凄凉不可问，落日背芜城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19160,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵赏心亭","author":"王琪","text":"千里秦淮在玉壶，江山清丽壮吴都。\n昔人已化辽天鹤，旧画难寻卧雪图。\n冉冉流年去京国，萧萧华发老江湖。\n残蝉不会登临意，又噪西风入座隅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19161,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送安公归顶山瑞石庵","author":"王琪","text":"谈空一纪馀，重出访岩居。\n身是汾阳嗣，囊惟郭璞书。\n公侯倒屣后，泉石结茆初。\n山顶收榛栗，经秋信莫疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19162,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吴中晓寒曲","author":"王琪","text":"大泽穹天莽同色，碧瓦阊门晓花白。\n石岩左右断行人，洞庭一夜冰千尺。\n曾持汉节单于垒，北风如刀割人耳。\n知怜冻足苦双摧，一生不向遐方履。\n凭谁赠我紫衣裘，中吴风土清且柔。\n令严气正天地肃，长歌白苧临寒流。\n玉兰酒熟金醅溢，太白连云尚殊□。\n书窗半掩昼始开，几日红梅断消息。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19163,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"咏玉蕊花","author":"王琪","text":"玉蕊生禁林，地崇姿亦贵。\n散漫阴谷中，蓬茨复何异。\n清芬信幽远，素彩非妖丽。\n苍烟蔽山日，琼瑶为之晦。\n岁久自扶疏，岩深愈凝邃。\n请观唐相吟，俗眼无轻视。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19164,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋日白鹭亭向夕有感","author":"王琪","text":"白鹭敞西轩，檐宇穷爽垲。\n千峰若连环，翠色不可解。\n是时天宇旷，六幕无纤霭。\n金斗熨秋江，素练横衣带。\n乾坤清且敛，气象朝昏改。\n芦花作雪风，飞舞来沧海。\n九霄汀鹭起，万里樯乌快。\n月上三山头，鸟没横塘外。\n苍茫洲渚寥，错落星斗大。\n开尊屏丝竹，披襟向萧籁。\n余生本江湖，偃蹇欣所会。\n清兴虽自废，苦嗜亦吾累。\n鱼龙凭夜涛，四面忽滂湃。\n安得燃犀灯，煌煌发水怪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19165,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清辉殿观唐明皇山水石字歌","author":"王琪","text":"皇家四叶恢圣功，天临日烛清华戎。\n汉条静治洽柔教，老心稽古开神聪。\n有唐英主称好文，仙毫洒落驱风云。\n壮哉山水有奇字，焕乎八法存翠珉。\n自从弃置咸阳道，藓驳烟滋委宫草。\n天开神赞会休辰，甄收再作皇居宝。\n如何沦弃三百春，迎逢睿鉴来紫宸。\n奎钩粲粲光华动，群玉森森气象新。\n丹籞春妍瑞霭深，文梁藻栋结芳林。\n鸿翔凤翥径方丈，杯流泉涌蒙亲临。\n鲰臣荣幸从金舆，钩婉魂惊拭目初。\n多惭揽笔非清藻，唯庆千龄际帝图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19166,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题招隐寺","author":"王琪","text":"苍崖何蟠回，尝为隐君宅。\n孰谓人琴亡，松风正萧瑟。\n花闲雪英舞，鹿去岩泉冽。\n经声草堂迥，天香中夜发。\n月落山气深，清猿啸亦绝。\n如何人外迹，轻为世网别。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19167,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"定风波","author":"王琪","text":"把酒花前欲问天。\n春来秋去苦茫然。\n风雨满枝花满地。\n何事。\n却教纤草占流年。\n试把钿筝重促柱。\n无绪。\n酒阑清泪滴朱弦。\n赖有玉人相顾好。\n轻笑。\n却疑春色在婵娟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19168,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"祝英台/祝英台近","author":"王琪","text":"可堪妒柳羞花，下床都懒，便瘦也教春知道。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19169,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"望江南/忆江南 柳","author":"王琪","text":"江南酒，何处味偏浓。\n醉卧春风深巷里，晓寻香旆小桥东。\n竹叶满金钟。\n檀板醉，人面粉生红。\n青杏黄梅朱阁上，鲥鱼苦笋玉盘中。\n酩酊任愁攻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19170,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"望江南/忆江南 其四 柳","author":"王琪","text":"江南竹，清润绝纤埃。\n深径欲留双凤宿，后庭偏映小桃开。\n风月影徘徊。\n寒玉瘦，霜霰信相催。\n粉泪空流妆点在，羊车曾傍翠枝来。\n龙笛莫轻裁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19171,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"望江南 其三 柳","author":"王琪","text":"江南燕，轻扬绣帘风。\n二月池塘新社过，六朝宫殿旧巢空。\n颉颃恣西东。\n王谢宅，曾入绮堂中。\n烟径掠花飞远远，晓窗惊梦语匆匆。\n偏占杏园红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19172,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"望江南 其六 江景","author":"王琪","text":"江南雨，风送满长川。\n碧瓦烟昏沈柳岸，红绡香润入梅天。\n飘洒正潇然。\n朝与暮，长在楚峰前。\n寒夜愁敧金带枕，暮江深闭木兰船。\n烟浪远相连。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19173,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"望江南/忆江南 其一 柳","author":"王琪","text":"江南雪，轻素剪云端。\n琼树忽惊春意早，梅花偏觉晓香寒。\n冷影褫清欢。\n蟾玉迥，清夜好重看。\n谢女联诗衾翠幕，子猷乘兴泛平澜。\n空惜舞英残。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19174,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"望江南 其九 柳","author":"王琪","text":"江南月，清夜满西楼。\n云落开时冰吐鉴，浪花深处玉沈钩。\n圆缺几时休。\n星汉迥，风露入新秋。\n丹桂不知摇落恨，素娥应信别离愁。\n天上共悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19175,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"望江南/忆江南 其七 柳","author":"王琪","text":"江南水，江路转平沙。\n雨霁高烟收素练，风晴细浪吐寒花。\n迢递送星槎。\n名利客，飘泊未还家。\n西塞山前渔唱远，洞庭波上雁行斜。\n征棹宿天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19176,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"望江南 其五 柳","author":"王琪","text":"江南草，如种复如描。\n深映落花莺舌乱，绿迷南浦客魂销。\n日日斗青袍。\n风欲转，柔态不胜娇。\n远翠天涯经夜雨，冷痕沙上带昏潮。\n谁梦与兰苕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19177,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"望江南 其八 江乡","author":"王琪","text":"江南岸，云树半晴阴。\n帆去帆来天亦老，潮生潮落日还沈。\n南北别离心。\n兴废事，千古一沾襟。\n山下孤烟渔市晓，柳边疏雨酒家深。\n行客莫登临。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19178,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其十四","author":"王琪","text":"山花冷隔何堪折，一曲红梅字字香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19179,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其五","author":"王琪","text":"蜀江雪浪来天际，一派泉舂宝钗碎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19180,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其八","author":"王琪","text":"疾风甚雨青春老，瘦马疲牛绿野深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19181,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其九","author":"王琪","text":"谁将水调歌秋雁，不遣君王待曲终。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19182,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其六","author":"王琪","text":"结伴不禁鸳瓦冷，羞明常怯玉钩斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19183,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"王琪","text":"万壑松声山雨过，一川花气水风生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19184,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其十二","author":"王琪","text":"露槿东西照，风荷向背愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19185,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其十五","author":"王琪","text":"鱼上晚潮沙市合，鸦啼寒树石城昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19186,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"王琪","text":"春风吹孤云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19187,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其十六","author":"王琪","text":"枫迷楚客伤春野，山晦荆王梦雨天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19188,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其十三","author":"王琪","text":"凉吹易成团扇恨，夕阳偏结小窗愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19189,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其四","author":"王琪","text":"陇雁半惊天在水，征人相顾月如霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19190,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"王琪","text":"蚕寒冰趼瘦，蜂老露房欹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19191,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]