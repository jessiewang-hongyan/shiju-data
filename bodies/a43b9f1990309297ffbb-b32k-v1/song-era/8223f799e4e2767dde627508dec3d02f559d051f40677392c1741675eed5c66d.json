[{"title":"长安府舍十咏 其五 月台","author":"韩琦","text":"待月西台早，移时凭曲栏。\n云端开玉叶，海面起金盘。\n燕席通宵雅，凉波入坐寒。\n香风来不断，清露裛红兰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37011,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"长安府舍十咏 其六 池亭","author":"韩琦","text":"亭出水中央，轻风四面凉。\n岸平飞略彴，波暖戏鸳鸯。\n静夜蟾蜍落，清秋菡萏芳。\n公馀时独坐，万虑默皆忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37012,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"长安府舍十咏 其七 山楼","author":"韩琦","text":"西北高楼上，南山日面栏。\n势笼秦地胜，阴落渭波寒。\n带雨新屏活，穿云古道难。\n仙扃如可造，便拟挂朝冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37013,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"长安府舍十咏 其八 流杯","author":"韩琦","text":"迢递穿花出，弯环作篆来。\n若非天上醴，不泛洞中杯。\n水鸟浮还没，仙航去复回。\n蓬瀛真境事，销得玉山颓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37014,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"长安府舍十咏 其九 石林","author":"韩琦","text":"丛石竞崭岩，当轩翠扑岚。\n疑峰何啻九，仙岛迥侔三。\n润极云犹抱，温多玉尚含。\n楼高慵引望，坐看小终南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37015,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"长安府舍十咏 其十 竹径","author":"韩琦","text":"北榭层基下，森森竹径幽。\n枝繁低拂盖，根密仅通流。\n劲节轻环粉，狂鞭怒走虬。\n风霜胡可动，松柏乃吾俦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37016,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题致政赵刚大卿卧云堂","author":"韩琦","text":"一挂朝冠谢世纷，终南高隐邈难群。\n不容圣治询黄发，径宅幽岩卧白云。\n书簏绕床唯我伴，磴泉喧枕乃予闻。\n此时谁可攀真驭，应有浮邱解挹君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37017,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题致政赵刚大卿宴息堂","author":"韩琦","text":"家园休息敞虚堂，直造希夷境外乡。\n无物不推山下胜，有花皆似洛中芳。\n荷裁万扇悲长信，笋掷千簪醉孟尝。\n子蔼令名居自足，主公襟韵日康强。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37018,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戊申末伏与立秋同日","author":"韩琦","text":"末伏居尝极蕴隆，今辰俄与立秋同。\n虽馀暴虐难禁暑，奈有萧骚已至风。\n冰出魏台犹示贵，扇思班箧欲收功。\n从兹渐入清凉境，林嘒寒蝉露暧空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37019,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初发长安遇雨","author":"韩琦","text":"九龙朝发起程初，甘泽滂然洒路衢。\n敢倦征途泥没踝，且观嘉谷秀垂珠。\n高原直泻波头恶，弊伞平穿阵势粗。\n绣岭任遥须趁宿，莲花汤下洗尘躯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37020,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题灵泉观","author":"韩琦","text":"老木阴森盖满山，萧条宫展倚巑岏。\n留为治世无穷戒，自足明皇数纪欢。\n旧浴已残汤室暖，馀悲尚惨渭川寒。\n欲知百二关河胜，更待朝元阁上看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37021,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题温汤","author":"韩琦","text":"康定西征始壮馀，往还休此任驰驱。\n白头又罢咸秦帅，却向温汤浴病肤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37022,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题朝元阁","author":"韩琦","text":"试往骊山顶上行，朝元孤绝耸峥嵘。\n了无楼殿嗟馀侈，自见耕桑复太平。\n两后绿苔多滑径，叶间红子不知名。\n南巅更就丹霞挹，顿觉尪然病骨清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37023,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游石瓮寺路险而返","author":"韩琦","text":"古寺跨山椒，虚明瞰泬寥。\n路危难进马，林密不容樵。\n飞瀑连云湿，凝岚带雨饶。\n崖穷徒一望，归步默无聊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37024,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"灵泉览古","author":"韩琦","text":"灵馆骊山下，开元迹尚遗。\n莲穿喷玉溜，字缺照人碑。\n古殿天姿晦，真工石像奇。\n羽衣沉旧曲，锦雁失前池。\n不见长生鹿，犹看连理枝。\n辞雄小杜句，意尽老陈诗。\n治乱由斯监，贤愚共一悲。\n时君自奢俭，绣岭此何知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37025,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题镇潼西溪","author":"韩琦","text":"芳林环掩密相搀，仙府天成似隐潜。\n峰面槎牙屏簇画，溪心平澈鉴开奁。\n秾妆照槛秋莲合，碎玉敲篷夜雨添。\n暂柅客轩醒病目，日斜无意驭彤襜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37026,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题云台观","author":"韩琦","text":"仙掌峰前羽客家，玉虚宫殿倚云霞。\n最高顶上谁曾到，得见莲开十丈花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37027,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题希夷先生真堂","author":"韩琦","text":"伊昔天真被谪书，亦教人境得仙居。\n开门翠霭三峰近，合眼红尘万事疏。\n髣髴旧容蝉已蜕，徘徊高隐室犹虚。\n何时归伴赤松子，稳驾寻君物外车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37028,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"仲秋之八日睹云台观冲观大师北轩群花盛开","author":"韩琦","text":"春早凡花百种荣，秋芳能得几多名。\n仙家八月灵葩发，不与寻常俗艳争。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37029,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题玉泉院","author":"韩琦","text":"两行修柏夹云根，引入莲峰直下村。\n病骨醒魂安气母，幽亭收景厌山孙。\n金堆望远千滩出，玉溜声喧万马奔。\n坐叹尘劳无计住，却寻归路日黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37030,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"硖石道中","author":"韩琦","text":"气爽风清八月天，雨馀秋色自萧然。\n正当崤渑难行路，得见田畴大有年。\n丛薄远青供极望，霁云低白半危巅。\n河桥咫尺乡程便，病质虽疲喜强前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37031,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渑池道中","author":"韩琦","text":"渡涧登坡直几重，岭头初日上曈昽。\n野花红紫连官道，露裛清香散晓风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37032,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戊申西洛中秋对月","author":"韩琦","text":"海东推出水晶毬，碧抹晴空暝霭收。\n素景独宜惟上节，清光无敌是中秋。\n家为梵室黄金界，人在天宫白玉楼。\n当此客途衰病者，敢于诗酒擅风流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37033,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵答崔公孺比部至陈桥驿来别相会","author":"韩琦","text":"永日劳君倍驿驰，相期无失见相思。\n义均吕驾来千里，情过阳关书一卮。\n喜接禅医开道眼，愧逢诗将立降旗。\n此行且纵漳滨卧，免弄幽并侠少儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37034,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又次韵答夜宴陈桥驿","author":"韩琦","text":"客邮聊得接交亲，夜席开谈彼此真。\n薄酒不辞知易别，征车从解喜难申。\n请看随分樽罍事，可是留心富贵人。\n早晚共成林下约，钓潭风月有竿纶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37035,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又次韵答陈桥话别","author":"韩琦","text":"欲知连日柅征车，倾盖唯忧后会赊。\n被顾高情非白眼，论空真理黜黄牙。\n还家粗喜松成径，怀印谁惊绶引花。\n卧治必难逃吏责，羡君奇志托青霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37036,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重九与诸亲会别桥驿","author":"韩琦","text":"邮馆侵晨举别觞，一时佳节遇重阳。\n莫悲白首分行袂，且伴黄花入醉乡。\n旅雁带霜横寒阵，香萸和露贮宫囊。\n诸君送我无多念，病质将休昼锦堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37037,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"早发韦城","author":"韩琦","text":"北去川原极目平，修途尘敛雨初晴。\n岁丰禾黍高低积，天晓云霞散乱明。\n宵露尚漙香草木，朔风时紧撼旗旌。\n病襟斗觉精神健，屈指乡邦近数程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37038,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初拜先坟","author":"韩琦","text":"未交符竹展先坟，肃肃秋天雨半昏。\n荣入松楸虽动色，感深闺闑复伤魂。\n山川望远平如日，父老欢迎识旧恩。\n白昼锦衣人已骇，更留旄节宿郊村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37039,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再题昼锦堂","author":"韩琦","text":"为郡偏荣昼锦归，再容乡任古来稀。\n邸人只骇新章贵，仙表谁瞻旧鹤飞。\n浃境士民增慰悦，一轩风物起光辉。\n镵诗又志君恩厚，鼎镬捐身报亦微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37040,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再题休逸台","author":"韩琦","text":"冰井梁摧几百秋，昔移为柱立台头。\n层基面垒盘蜗壳，倒影侵池侧蜃楼。\n拂槛落霞凌绮席，入檐初月误琼钩。\n芳林已合阴成茂，不见西山涌万邱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37041,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再题康乐园","author":"韩琦","text":"名园初辟至和中，思与康时众乐同。\n一纪丰光虽易老，万家春色且无穷。\n归来敢衒吾乡胜，到此须知旧邺雄。\n病守纵疲犹强葺，欲随民适醉东风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37042,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"狎鸥亭","author":"韩琦","text":"亭压东池复坏基，园林须喜主人归。\n憩棠犹茂应存爱，植柳堪惊仅过围。\n鱼泳藻间谙物性，月沈波底发禅机。\n群鸥只在轻舟畔，知我无心自不飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37043,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观鱼轩","author":"韩琦","text":"雨后方池碧涨秋，观鱼亭槛俯临流。\n时看隐荇骈头戏，忽见开萍作队游。\n喜掷舟前翻乱锦，静潜波下起圆沤。\n吾心大欲同斯乐，肯插筠竿饵钓钩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37044,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"洗竹","author":"韩琦","text":"当日曾移碧玉竿，缭坦交植竞檀栾。\n栽培尽力宜长盛，剪拂无人已半残。\n洗出烟姿还雅澹，削开龙影起幽蟠。\n此君高节殊堪慕，贤者来须著意看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37045,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"删柏","author":"韩琦","text":"翠柏枝繁郁未伸，我来删理务躬亲。\n孤根得地虽经岁，逸势参天不在人。\n先易工夫知取舍，后凋颜色长精神。\n环材自入他年用，莫厌因时剪择频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37046,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"放泉","author":"韩琦","text":"缓带凭轩喜放泉，映花穿柳逗潺湲。\n谁言胜境须昆阆，自有清音过管弦。\n赴海任遥终泽润，灌园思足尚留连。\n衰翁日寄南窗傲，枕上时醒白昼眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37047,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"冬至祀坟","author":"韩琦","text":"至日郊原拥节旄，先茔躬得奉牲醪。\n霜威压野寒方重，山色凌虚气自高。\n衣锦不来夸富贵，报亲惟切念劬劳。\n连村父老欢相迓，因劝勤耕候土膏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37048,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"烧煤戏成","author":"韩琦","text":"无臭含天德，资贫乃地珍。\n群阴徒肆暴，万室自融春。\n丰黍轻邹律，歌襦陋蜀民。\n何妨灰弃道，仁政不同秦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37049,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"悲二木","author":"韩琦","text":"偃盖孤松挺北轩，亭亭双柏寝堂前。\n干霄夭矫苍龙上，当户阴森翠幄圆。\n百岁生成犹易蘖，近时栽葺欲谁怜。\n居官好恶宜加谨，诗拙徒思警后贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37050,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"喜雪","author":"韩琦","text":"昨夜同云彻晓阴，雪床轻衬六花深。\n一开帝扆忧民虑，普慰农畴望岁心。\n天兴酒徒张醉幕，家疑仙室尽瑶林。\n喜凭休逸台西槛，群玉高低耸万岑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37051,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪霁登休逸台","author":"韩琦","text":"休逸台头雪乍晴，病眸虽涩亦增明。\n几年无此三农乐，万物皆随一气清。\n修竹拒寒森晚节，垂杨偷润袅春情。\n当轩欲绘西山景，巧笔何人似李成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37052,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢观文赵尚书寄示集注老子","author":"韩琦","text":"公今重释五千言，一法专求是要诠。\n天道生成忘万物，师人功业在群贤。\n世尘甚扰吾何欲，谦柄常持彼任先。\n治国治身非异理，雨无心迹自安然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37053,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"双硙","author":"韩琦","text":"一渠遐引直千金，对激双轮用智深。\n本务爱民除岁患，且非为政有机心。\n重罗撼雪收长利，嘉植成帷展旧阴。\n来者相沿知日盛，肯教前作入烟沈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37054,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"壕林","author":"韩琦","text":"鹿角科民岁甚劳，故栽榆柳匝城壕。\n骈枝岂下笓篱密，耸干将凌埤堄高。\n捍蔽莫先轻枳棘，森严无日挺干旄。\n霜斤谨勿窥微利，惜取金汤四面牢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37055,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"元日祀坟马上","author":"韩琦","text":"三朝遍喜得晴和，岁美民康此验多。\n天运主生方启户，土膏乘暖已腾波。\n雪凭空阔高低在，风引韶妍次第过。\n霁霭正开先陇近，太行晡景上嵯峨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37056,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"栽花二阕 其一","author":"韩琦","text":"名园尝已植群芳，更得新株补旧行。\n非欲后来传好事，只图芬馥满吾乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37057,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"栽花二阕 其二","author":"韩琦","text":"百品名花手种来，复寻嘉艳及时栽。\n主人便去心无恨，从向东风自在开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37058,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵答并帅王仲仪端明以诗见寄","author":"韩琦","text":"退削尝连上，清衷遂一开。\n调元辞重任，殄寇倚非才。\n虎士方争奋，羌雏已诉哀。\n遽驰金节觐，俄得锦衣回。\n雅契瞻并府，衰容病邺台。\n孤怀难托雁，芳信忽传梅。\n玳瑁遥宾席，蒲萄入醉杯。\n高谈嗟阻阔，危榭几徘徊。\n大卤诚淹帅，中枢即贰台。\n三槐东第甲，还似相车来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37059,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵答宫保张相公以长篇见寄","author":"韩琦","text":"睿师当亨会，真贤上贵途。\n骥程轻历块，鹏运狭抢榆。\n大器方膺用，清风自少徒。\n危言忘世忌，直道得神扶。\n廪粟常周急，囊衣异弗娄。\n临戎资远略，进读待名儒。\n位峻升中执，胡骄赖北狙。\n殊邻摧桀骜，正路屏榛芜。\n机务参筹幄，恬波静海隅。\n高名乔岳重，劲节老松孤。\n众望归钧席，群生入化垆。\n幽遐通滞塞，愁郁变怡愉。\n明哲咸推甫，深忠独许壶。\n上枢俄任德，冢辅适容愚。\n清燕常陪论，丹诚得尽输。\n协心安国本，罄宇保民苏。\n知止频思退，遗荣遂恳图。\n连章倾悃愊，重责厌忧虞。\n物议皆嗟去，宸言勉赐俞。\n四朝全始卒，一代足师模。\n恣逐林泉乐，几忘仆马痡。\n韩城穷近赏，嵩谷喜深趋。\n飞溜星分派，奇峰笋迸株。\n买山兼胜得，卜宅与真俱。\n寿考何人及，优游举世无。\n神颐紫虚观，迹谢赤墀涂。\n不意烦诗笔，勤来恤病躯。\n龙章惊表裸，雀弹枉投珠。\n酬唱情虽接，仙凡路尚殊。\n终期解官绶，先约造灵区。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37060,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"留题相州王珫推官园亭","author":"韩琦","text":"王氏名园枕子城，主人方壮便遗荣。\n栽花直欲春长在，爱客谁尤囊尽倾。\n万景并归闲日月，一身常寄小蓬瀛。\n吾居甚迩还空锁，不退堪为达士轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37061,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵答王拱辰宣徽将交政惠诗","author":"韩琦","text":"适辞乡邑入平川，春恼轻寒未禁烟。\n金印此时交大府，银袍当日接英躔。\n清衷正渴摅贤蕴，窳质前知在化甄。\n衰病早期还旧里，不循公迹住三年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37062,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上巳属疾","author":"韩琦","text":"去年修禊小龙池，醉席高吟盛一时。\n今日正逢春骀荡，此身翻苦病支离。\n浮觞胜会人胥乐，闭阁衰悰自不知。\n御水有期犹半月，雨馀风景愿迟迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37063,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"会食许公亭","author":"韩琦","text":"许公亭馆压通津，强率羸躯接会宾。\n万陇得苗经饱雨，满车馀粟有归民。\n退花杏小惊春晚，系马蔬柔辨食珍。\n风伯入谗憎乐事，怒号终日走埃尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37064,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"扶沟宰周源来求二苏兄弟留题于白鹤观诗","author":"韩琦","text":"二苏遗笔匿仙扃，贤宰来求为发明。\n字久半随风雨剥，气豪犹入鬼神惊。\n终疑鸾凤骞云去，不假江山到骨清。\n人对盛时须自勉，醉吟颠草尚垂名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37065,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵答子渊赵学士","author":"韩琦","text":"再乞乡邦遂志艰，十年方得见家山。\n昼衣丽锦过前宠，秋逼衰蒲失旧颜。\n数月又迁当冗剧，一生曾未识安闲。\n故人千里无由愬，赖有诗筒去复还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37066,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再答二阕 其一","author":"韩琦","text":"从来交分拟金兰，一纪前同陟道山。\n君畜高才终未偶，我居荣路独何颜。\n邺台将卜全身退，洛宅先输任意闲。\n感旧倚楼空自叹，不如飞翼倦知还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37067,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再答二阕 其二","author":"韩琦","text":"退谋休洛勇难攀，性得清虚不在山。\n十亩足居应慕白，一瓢犹乐直师颜。\n谁论世路风波恶，渐见仙家日月闲。\n我亦安阳蜗舍就，羡君殊欲幅由还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37068,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄致政赵少师","author":"韩琦","text":"雨曾擎日上高天，遽脱浮荣请退坚。\n宠殿大邦方异礼，确申前恳甫踰年。\n三师共仰青宫贵，四海皆称白傅贤。\n自顾衰残归未得，几时平地接神仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37069,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又寄二阕 其一","author":"韩琦","text":"月榭风亭胜雅名，主公闲适愈多情。\n芳樽屡酌瀛洲上，谁听霓裳散序声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37070,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又寄二阕 其二","author":"韩琦","text":"到处园亭列画屏，四时如只在仙扃。\n归来便是无为乐，不必重笺道德经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37071,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登望宸阁","author":"韩琦","text":"危阁轻裘陟望宸，欲逃蒸暑若忧焚。\n清风自越兼金贵，真境都无数仞分。\n归渚水禽明似雪，扰空沙燕闹如蚊。\n凭轩眷阙羁魂断，乱逐南飞送雨云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37072,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登金铜门","author":"韩琦","text":"当暑思来坐北轩，俯看形胜在檐前。\n楼台突兀陵高木，城堞萦回际远天。\n万室正虞多暍者，一身惭独御泠然。\n歊烦尽涤无心下，欲帐轻绡彻夜眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37073,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"立秋日后园","author":"韩琦","text":"亭馆虽芜胜势存，病襟犹足涤冥昏。\n晚凉天气秋风入，雨霁园林伏暑奔。\n古榭稳骑危岫翠，御流遥泻曲池浑。\n河鱼未获山芎效，几废良辰命客樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37074,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]