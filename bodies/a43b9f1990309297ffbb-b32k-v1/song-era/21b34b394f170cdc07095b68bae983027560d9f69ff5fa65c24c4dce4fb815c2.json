[{"title":"药洲四首 其二","author":"刘克庄","text":"役民如犬马，国破作降俘。\n往往湖中石，宣和艮岳无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30245,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"药洲四首 其一","author":"刘克庄","text":"非有干时策，聊为避地图。\n昔人补勾漏，老子管仙湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30246,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赵昌花","author":"刘克庄","text":"要识洛阳姚魏面，赵昌著色亦名家。\n可怜俗眼无真赏，不宝丹青宝墨花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30247,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"轵道","author":"刘克庄","text":"秦暴浑如狼牧羊，筑临洮郡至咸阳。\n苦防齐客出关外，岂料子婴降道傍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30248,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送山甫赴岭口仓五言二首 其一","author":"刘克庄","text":"跬步难相舍，今为薄宦驱。\n长年干父蛊，晚节赖家驹。\n乡近多安讯，时清少急符。\n故人问郎罢，卧起一筇扶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30249,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送广师谒竹溪中书五言二首 其二","author":"刘克庄","text":"五十有三个，问法向谁边。\n村老小颠尔，竹溪翁大颠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30250,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送广师谒竹溪中书五言二首 其一","author":"刘克庄","text":"村老诗颠者，颠年八十年。\n后生被传染，引得广师颠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30251,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送仙游黄尉","author":"刘克庄","text":"三载仙溪上，萧然少府厅。\n不曾填格日，但见纂图经。\n黄绶离卑冗，青衿冒典刑。\n泉潮相接壤，尤可奉亲庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30252,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送延平张生归南溪","author":"刘克庄","text":"问讯南溪水，韩张泛几回。\n侍郎何处在，司业有孙来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30253,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送陈德林巡辖","author":"刘克庄","text":"拔丁而去矣，袖瓦似要之。\n谁道州人薄，君行有綵旗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30254,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送侍读常尚书绝句六首 其六","author":"刘克庄","text":"制酒何曾把巨觥，抛书不复对寒檠。\n老儒愿忍须臾死，要看诸贤起太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30255,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送侍读常尚书绝句六首 其五","author":"刘克庄","text":"瑶编日益百千人，琛税年亏钜万缗。\n公对玉阶方寸地，细为天子说州贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30256,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送侍读常尚书绝句六首 其四","author":"刘克庄","text":"粟泉竭泽剥床肤，券封如山泄尾闾。\n埒国贾胡成小贩，专城太守甚癯儒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30257,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送侍读常尚书绝句六首 其三","author":"刘克庄","text":"先帝倦勤扬末命，嗣皇访落记孤忠。\n铜人嘿嘿输伊辈，铁汉堂堂止此翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30258,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送侍读常尚书绝句六首 其二","author":"刘克庄","text":"季唐兵柄由中尉，先汉铜山赐弄臣。\n不是银台批敕手，北司将谓国无人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30259,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送侍读常尚书绝句六首 其一","author":"刘克庄","text":"蚀月妖蟆俄扫穴，鸣阳丹凤力回天。\n围腰不爱重金带，洗脚宁登一叶船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30260,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送明甫初筮十首 其十","author":"刘克庄","text":"汝幼不努力，忽为三十馀。\n勉旃教汝子，要付善和书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30261,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送明甫初筮十首 其九","author":"刘克庄","text":"博士今儒彦，遥知讲席重。\n汝宜束脩往，吾亦执经从。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30262,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送明甫初筮十首 其八","author":"刘克庄","text":"记取元城语，南州热异常。\n别无卫生诀，止酒是丹方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30263,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送明甫初筮十首 其七","author":"刘克庄","text":"十载脾神厄，何曾食有鱼。\n击鲜徒溷汝，遗鲊适忧吾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30264,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送明甫初筮十首 其六","author":"刘克庄","text":"先绪微如线，未知谁亢宗。\n翁犹惭父祖，汝可复惭翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30265,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送明甫初筮十首 其五","author":"刘克庄","text":"莫叹家庭远，卿侯即父师。\n尚于吾缱绻，定不汝瑕疵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30266,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送明甫初筮十首 其四","author":"刘克庄","text":"宁游屋溪畔，勿傍盗泉边。\n监竹不食笋，先贤样在前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30267,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送明甫初筮十首 其三","author":"刘克庄","text":"禄米皆前定，分铢不可添。\n园葵莫争利，邻枣亦伤廉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30268,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送明甫初筮十首 其二","author":"刘克庄","text":"守相卿耆旧，相逢必霁威。\n渠宁私邑子，汝勿视翁归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30269,"sha256":"18413bf73b9