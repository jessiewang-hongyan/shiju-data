"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30294,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闻五月八日宸翰口号十首 其四","author":"刘克庄","text":"树精犹识吕翁仙，舆尉安知绛老贤。\n黄吻小儿吾语汝，古来天子礼高年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30295,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闻五月八日宸翰口号十首 其三","author":"刘克庄","text":"饮瓢未必臞颜氏，裹饭谁曾访子来。\n天上人间唯玉帝，肯分雨露到枯荄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30296,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闻五月八日宸翰口号十首 其二","author":"刘克庄","text":"叩墀还笏今三闰，誓墓垂车又五春。\n赖有两轮大圆镜，当空照见戴盆人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30297,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闻五月八日宸翰口号十首 其一","author":"刘克庄","text":"有文殊佛来禅室，无后将军顾草庐。\n肉眼错看病居士，玉音犹记老尚书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30298,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闻笛二首 其二","author":"刘克庄","text":"初如废将哭穷边，又似孤臣诉左迁。\n何必谢公双泪落，野人听罢亦凄然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30299,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闻笛二首 其一","author":"刘克庄","text":"少年毬马逐秋风，笛起连营响裂空。\n今夕梦回村墅冷，一枝孤奏月明中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49