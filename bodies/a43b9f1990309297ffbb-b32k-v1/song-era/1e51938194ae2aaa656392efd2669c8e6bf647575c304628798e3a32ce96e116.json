[{"title":"福昌官舍后绝句十首 其四","author":"张耒","text":"漫与东风作主人，栽培花草伴閒身。\n不辞伐竹成高架，收拾蔷薇一片春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51407,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"福昌官舍后绝句十首 其一","author":"张耒","text":"淮南梅柳想春还，怯见西州岁暮寒。\n惟有看山心未厌，晴明终日在阑干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51408,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"福昌官舍后绝句十首 其六","author":"张耒","text":"翠竹留人不忍还，暖泉春涨已潺潺。\n寄言山鸟休归去，与尔同来乐此间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51409,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"福昌官舍后绝句十首 其十","author":"张耒","text":"清明山色到前檐，汩汩溪流聚小潭。\n一榻竹窗晴昼睡，依依春梦入江南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51410,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"福昌官舍后绝句十首 其八","author":"张耒","text":"风吹春日下南山，尚有轻冰结暮滩。\n何事鸳鸯故相守，清溪不怕夜栖寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51411,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"福昌官舍后绝句十首 其九","author":"张耒","text":"不扫竹根藏笋茁，旋培残雪拥兰芽。\n为君更接樱桃树，付与春风换却花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51412,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"福昌官舍后绝句十首 其五","author":"张耒","text":"卧听堂南布谷鸣，陇头细麦已青盈。\n殷勤谢汝催春种，我为无田岂懒耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51413,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"遣兴","author":"张耒","text":"百感摧伤强对春，看花花畔独沾巾。\n祇应闭目林中坐，须学无言壁下人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51414,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹎鵊","author":"张耒","text":"整刷衣裾紫翠新，晓天风露压鸡晨。\n应知不置莲花漏，长唤林中宴坐人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51415,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"僧允怀惠紫竹杖","author":"张耒","text":"轻坚滑泽节仍匀，上下柯山助老身。\n他日天恩许归去，提携同踏故园春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51416,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"墙东二首 其二","author":"张耒","text":"岁晚长安足风土，天寒官舍少文书。\n下马闭门复无事，壁间佛像对铜炉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51417,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"墙东二首 其一","author":"张耒","text":"墙东椿老叶已尽，堂下菊丛无复香。\n长安风埃岁已晚，闭门不出马毛长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51418,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"摘芙蓉","author":"张耒","text":"今年古寺摘芙蓉，憔悴真成泽畔翁。\n聊把一枝閒照酒，明年何处对霜红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51419,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"漫成七首 其七","author":"张耒","text":"庭阴当午起犹慵，断送残春醉梦中。\n桑柘成阴桃李尽，一川零乱柳花风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51420,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"漫成七首 其六","author":"张耒","text":"溪水春来清荡沙，溪南溪北是人家。\n依依陌上多情柳，簇簇原头自在花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51421,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"漫成七首 其五","author":"张耒","text":"江南梅花凌雪霜，桃李开尽春无光。\n谁知洛阳三月暮，千金一朵卖姚黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51422,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"漫成七首 其四","author":"张耒","text":"风吹桃花西复东，雨打海棠零乱红。\n可是春光即消歇，牡丹音信未全通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51423,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"漫成七首 其三","author":"张耒","text":"高槐无花亦有阴，参天老枝逾十寻。\n流莺不使人窥见，故隔深条送好音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51424,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"漫成七首 其二","author":"张耒","text":"修竹娟娟一万竿，清渠引水正潺潺。\n知时燕子来相语，任意凫雏去不还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51425,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"漫成七首 其一","author":"张耒","text":"应敌诗才惭古人，牵情春色空閒身。\n铺排物色虽甘拙，消散閒愁亦有神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51426,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"漫呈无咎一绝","author":"张耒","text":"题扇灯前亦偶然，那知别后远如天。\n去年醉舞看花处，独听琵琶却惘然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51427,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"嘲无咎夜起明灯听慎思诵诗","author":"张耒","text":"翠屏香暖秋眠稳，霜冷宝奁金错刀。\n谁信苦吟无睡客，挑灯起听楚人骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51428,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"樊山","author":"张耒","text":"黄叶疏林江上洲，西风角怨夕阳楼。\n晚天紫翠凌空阔，只有樊山取意秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51429,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"潮水二首 其二","author":"张耒","text":"近来消息愈堪猜，飞鸟无情不肯回。\n惟有清淮慰人意，春流日日自东来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51430,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"潮水二首 其一","author":"张耒","text":"水满清淮自在流，落花吹尽浪悠悠。\n总将春雨为春泪，未比思君一半愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51431,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蕲水道中二首 其二","author":"张耒","text":"绿野新晴风日凉，肩舆细路转重冈。\n桥边野水侵官道，旋唤渔舟渡夕阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51432,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蕲水道中二首 其一","author":"张耒","text":"蚕老麦枯田舍忙，谁令四月雨浪浪。\n未容乌鸟私遗粒，鸣蚓跳蛙欲满场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51433,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"霅溪道至四安镇","author":"张耒","text":"苕霅清秋水底天，夜帆灯火客高眠。\n江东可但鲈鱼美，一看溪山直万钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51434,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题五柳亭","author":"张耒","text":"大夫风韵如彭泽，五柳萧森手自栽。\n我亦扁舟倦游者，登临聊复赋归来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51435,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题史院直舍鱼鹭屏","author":"张耒","text":"钟鼓声稀下直迟，秋晖初转万年枝。\n寒厅尽日谁相对，惭愧屏风两鹭鸶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51436,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题宅后井","author":"张耒","text":"清泉十丈白如浆，甘似醍醐透椀凉。\n君欲道中无渴死，百寻操绠莫辞长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51437,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题西园酴醾","author":"张耒","text":"风霜老蘖蹙龙蛇，中有青春白玉葩。\n要使根深生意遂，不妨秋雨卧泥沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51438,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题寿阳楼二首 其二","author":"张耒","text":"长淮不断水悠悠，楼下行人淮上楼。\n谁谓满前风景好，古今供作别离愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51439,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题寿阳楼二首 其一","author":"张耒","text":"渺渺长淮去不休，行人独上寿阳楼。\n一阕长歌不须唱，山川都是旧时愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51440,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题周文翰郭熙山水二首 其二","author":"张耒","text":"洞庭叶落万波秋，说与南人亦自愁。\n指点吴江何处是，一行鸿雁海山头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51441,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题周文翰郭熙山水二首 其一","author":"张耒","text":"鱼村橘市楚江边，人外秋原雨外川。\n遣骑竹边邀短艇，天涯暮色已苍然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51442,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题画二首 其二","author":"张耒","text":"苍苍老石守寒丛，雪洒林鸠美睡中。\n鹑傍陈根饥更啄，雀栖高蘖瞑愁风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51443,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题画二首 其一","author":"张耒","text":"败芦浸水冻滩沙，朔雪随