[{"title":"望华山","author":"刘攽","text":"荆山连太华，青翠望难分。\n岭首明新旭，山腰暝白云。\n玉攒光自照，波荡势成文。\n应接宁知倦，清辉远送君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40698,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"凤翔官宅园亭","author":"刘攽","text":"退食自閒暇，空堂仍集虚。\n秋林长费扫，寒草不教锄。\n移石改迂径，拂墙看旧书。\n枝栖亦云稳，何用忆吾庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40699,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"马当山","author":"刘攽","text":"云壑断无土，江流横倒山。\n蛟涎晴出没，鸟羽倦飞还。\n神禹遗疏凿，天机藉险艰。\n长风且破浪，帆席慰愁颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40700,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送毕长官","author":"刘攽","text":"铜墨非君志，仙凫为我来。\n三年话倾盖，十日算衔杯。\n许与羞垂白，飞腾指上台。\n倚门方有待，未觉厌京埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40701,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送郑推官","author":"刘攽","text":"此邦人事少，离恨不关心。\n顿与吾子别，如何旅思深。\n暖风随跃马，永路变鸣禽。\n蓬鬓添衰白，知予厌滞淫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40702,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏雪","author":"刘攽","text":"北风吹朔雪，楚塞亦凝寒。\n天地浮云满，江湖行路难。\n醉宜乘马出，高爱倚楼看。\n会是丰年候，居人意似宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40703,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书堂对雪","author":"刘攽","text":"天寒不成寐，看雪坐清晨。\n默怪人声绝，都迷物态真。\n璇宫寒烁目，琪树静无尘。\n信有昆崙圃，神游属此身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40704,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和裴库部诸家雪 侯家","author":"刘攽","text":"裘马寒逾壮，歌钟暝未閒。\n排云朝象阙，踏冻猎黄山。\n上客珠装履，妖姬玉缀鬟。\n园林通夜赏，洞户不须关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40705,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和裴库部诸家雪 山家","author":"刘攽","text":"云暗峰疑断，林长路稍迷。\n庭隅时卧鹿，旁舍远听鸡。\n隐几添樵火，应门倚杖藜。\n儿童别村至，薄酒自提携。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40706,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和裴库部诸家雪 酒家","author":"刘攽","text":"缭径集瓶罂，江楼倚上层。\n青帘吹淡墨，翠幕映飘灯。\n劝客寒威壮，歌时岁事登。\n十千赊可得，不恨价仍增。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40707,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和裴库部诸家雪 猎家","author":"刘攽","text":"寒事轻杯酒，晨装急制衣。\n狐麋寻去迹，鹰隼竞横飞。\n沙路浓随马，风毛盛合围。\n兴酣生鼻火，狂发会忘归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40708,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和裴库部诸家雪 樵家","author":"刘攽","text":"山木琼瑶合，溪风虎豹哀。\n旧林迷处所，破斧独归来。\n世路深泥滓，生涯半死灰。\n谁怜廊庙语，正复此遗材。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40709,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和裴库部诸家雪 船家","author":"刘攽","text":"云白连沙渚，风高杂浪花。\n解帆依下雁，沽酒看栖鸦。\n篷响投珠乱，门攲堕剑斜。\n山阴路不远，去问戴逵家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40710,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪后 其一","author":"刘攽","text":"高城催戍鼓，病枕听哀鸿。\n洒竹萧萧雪，开门峭峭风。\n消忧樽酒绿，久雨烛花红。\n旅梦还知路，孤舟向剡中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40711,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪后 其二","author":"刘攽","text":"朔雪冻乾坤，黄云昼景昏。\n宿酲犹恋酒，静卧亦开门。\n乌鹊时时语，松篁处处翻。\n问知淮水冻，不复渡头喧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40712,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陆子履有诗赠行次韵留别","author":"刘攽","text":"尚白不自悟，愧君称绝伦。\n高秋独去国，下水不留人。\n菊秀鸿初过，鱼肥稻已新。\n淮山见明月，千里最情亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40713,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"留别傅钦之","author":"刘攽","text":"驱车长值险，投足正临深。\n白首抱壹意，故人知此心。\n巢禽欢避弋，辙鲋偶为霖。\n去矣江湖兴，凄然东武吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40714,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"苦热 其一","author":"刘攽","text":"炎晖不可避，郁郁度朝晡。\n飞鸟有时堕，高林无事枯。\n形骸等外物，橐籥任洪炉。\n正有捐尘浊，东浮万里桴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40715,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"苦热 其二","author":"刘攽","text":"炎晖共兹世，南纪独何偏。\n天地大炉耳，江湖沸鼎然。\n鱼龙危失所，黍稷恐无年。\n浩荡思雷雨，长吟云汉篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40716,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"画鹤","author":"刘攽","text":"置此怜神骏，三年故不飞。\n轩车宁假宠，野客会忘机。\n燕雀那相笑，凫鹥直自肥。\n蓬莱千万里，正想玉为衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40717,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"得杨十七书见报所居近种花木诗","author":"刘攽","text":"堪忧虽陋巷，寓兴即名园。\n似得壶公乐，如吹黍谷暄。\n艳花争献笑，芳草共忘言。\n近种南轩竹，春来亦有孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40718,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"眼昏","author":"刘攽","text":"因循衰便至，邂逅眼成昏。\n稍与诗书隔，初惭长老言。\n谈空迷起灭，蝇翼竞飞翻。\n懒卧称长策，深居欲杜门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40719,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登浴室院阁 其一","author":"刘攽","text":"秋霁登临好，危栏百尺梯。\n层城斜照里，双阙五云西。\n杂树黄映绿，生烟高复低。\n章台少年子，走马锦障泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40720,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登浴室院阁 其二","author":"刘攽","text":"稍出红尘外，方知万象虚。\n林端辨远水，楼角怪行车。\n灯续黄金像，香馀贝叶书。\n谁能捐世事，即地亦山居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40721,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中夜见月","author":"刘攽","text":"月午四邻静，高斋人寂然。\n虚空时有警，影响善惊眠。\n宿羽移深树，商胡惯夜船。\n无云更可恨，珍重此婵娟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40722,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新月","author":"刘攽","text":"稍见桑榆上，还沈河汉西。\n气凉知露白，天阔见星低。\n静色馀帘额，回光射鸟栖。\n城乌偏可恨，到晓不休啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40723,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和黄朝议 其一","author":"刘攽","text":"下武新周烈，讴歌属禹谟。\n恭闻始元诏，远绍帝轩图。\n山海无加赋，戎胡遂息徒。\n英风逾草偃，俯仰逮樵苏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40724,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和黄朝议 其二","author":"刘攽","text":"已作华颠老，欣闻紫诏新。\n经纶兼事事，哀痛及人人。\n愿辍须臾死，求观富寿民。\n短歌随击壤，感动不无神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40725,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"伤丁元珍学士","author":"刘攽","text":"休沐非连骑，投沙迫去身。\n似鸮忧鵩鸟，比鹤望乡人。\n梦与江湖隔，情存翰墨新。\n定交相得晚，抚事亦酸辛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40726,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"喜雨","author":"刘攽","text":"山雨来何暮，高天始震雷。\n江声翻滟滪，水气逼昭回。\n洒落芳年晚，空凉醉眼开。\n蛟龙定神宅，蜗角更谁猜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40727,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"漫成","author":"刘攽","text":"经旬柳已绿，过雨草齐生。\n无事观儿戏，閒游识鸟情。\n看花低帽立，弄水棹舟行。\n宦学都如梦，浮生底自名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40728,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和司法掾陈郛","author":"刘攽","text":"晚得诗人赋，长谣长者言。\n坐曹凉雨过，归舍暮禽喧。\n交态伤贫富，时情任轾轩。\n怀归空有梦，郢路属营魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40729,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送慧思归吴","author":"刘攽","text":"尘埃十年梦，江海一身归。\n境与夙心会，事容前日非。\n连山横远势，定水湛明辉。\n别后相望处，云孤雁自飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40730,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"奠昭禅师","author":"刘攽","text":"昭公不住世，岑寂白莲宫。\n煮水终还冷，浮云本自空。\n诸天方丈室，万事百年翁。\n俯仰成今昔，萧萧鹤树风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40731,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送僧子南","author":"刘攽","text":"脱身游万里，空手出长安。\n犹以抱琴乐，不知行路难。\n春归吴国远，水满紫溪寒。\n越俗今章甫，疑师不著冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40732,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宋门城下新居","author":"刘攽","text":"颇习田野事，偶居朝市间。\n前尘应妄想，旧观辄来还。\n甘井如汲涧，高城疑望山。\n更怜车马绝，日在掩柴关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40733,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新居","author":"刘攽","text":"举世同逆旅，此身那拙谋。\n趣营容膝地，适似种瓜侯。\n药饵扶多病，躬耕强隐忧。\n弹冠仍应客，车马肯淹留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40734,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪后行小园","author":"刘攽","text":"晚照开霁色，闭园幽事增。\n树摇风落雪，池涨水浮冰。\n鹊乱声已变，鸢飞谁为矜。\n风光看满眼，取醉此吾能。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40735,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过丁晋公旧园","author":"刘攽","text":"宁知陵谷变，遂见曲池平。\n乔木祇益老，储胥空复情。\n废墀盈叠藓，颓榭迹微行。\n桑霍为厚戒，千秋馀叹声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40736,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪夜酌酒","author":"刘攽","text":"雨雪寒休市，春泥早闭门。\n严城深窈窕，孤月静黄昏。\n栖翼此中树，高舂何处村。\n物容烦应接，乘兴即开樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40737,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送雍元直使浙右","author":"刘攽","text":"诏给四封传，自乘千里船。\n云山深发兴，秋物正萧然。\n零雨随持节，惊涛避执鞭。\n鲈肥稻米白，胜事奈君偏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40738,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"引泉","author":"刘攽","text":"春池冻已消，泉落白鱼跳。\n石浅喧鸣玉，沙虚没暗潮。\n晚寒妨濯足，竟日欲平桥。\n最爱临波柳，东风万万条。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40739,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"金凤花","author":"刘攽","text":"妖娆如自媚，红白竞为娱。\n共笑翔千仞，犹疑将九雏。\n轩墀蒙?睐，风雨易泥涂。\n静扫苍苔地，还令近酒壶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40740,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"景潮亭","author":"刘攽","text":"泽国水遥远，归舟亭短长。\n他方向夕景，此地正朝阳。\n物色桑榆上，风波凫雁行。\n临流问渔父，好在濯沧浪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40741,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"退朝观御沟上杂花赠陆四","author":"刘攽","text":"沟水去无穷，宫花映日红。\n惜阴犹宿露，照影独衰翁。\n燕语晴明外，风香锦绣中。\n为非温室问，心赏幸君同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40742,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上三山矶","author":"刘攽","text":"江湍趋绝壁，山木映云涛。\n野路青冥近，孤舟应接劳。\n鱼龙防碎首，鸟兽几亡曹。\n生事垂堂戒，愁心欲二毛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40743,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过龙眼矶","author":"刘攽","text":"洪波浮一叶，弱发引千钧。\n虎豹公横道，蛟龙喜得人。\n强颜犹失色，乘险屡伤神。\n回首双凫翼，随波愧此身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40744,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送郑五下第西归","author":"刘攽","text":"万里河西路，怜君徒步归。\n游人并塞少，落叶待霜飞。\n相得不恨晚，知音深谓稀。\n壮心须慷慨，勿学泪沾衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40745,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送人之官岭南","author":"刘攽","text":"过岭几千里，孤城近海涯。\n地温饶瘴毒，民恶半蛮家。\n并日初开市，非春亦有花。\n知君望星斗，西北认京华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40746,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和孙少述中秋 其一","author":"刘攽","text":"月出东山表，遥思泽国秋。\n绿云孤镜上，透水大珠浮。\n重露梧桐落，微寒蟋蟀愁。\n我时携客饮，浮白最高楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40747,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和孙少述中秋 其二","author":"刘攽","text":"竟夕云四敛，始知天意偏。\n西风不胜冷，亭午更添圆。\n老发缘诗苦，秋怀得酒便。\n君居江浦上，望我想依然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40748,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日野次","author":"刘攽","text":"溪云晴漠漠，野日昼阴阴。\n燕翼飞高下，花房乱浅深。\n和风快吹面，净水喜清心。\n极目伤千里，曾无枫树林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40749,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南原","author":"刘攽","text":"南原殊可望，桑柘百家村。\n紫赤春晴气，青葱旧烧痕。\n远川飞雁鹜，平壤牧鸡豚。\n更待花如织，临高置一樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40750,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"远信","author":"刘攽","text":"清秋万里梦，久客一封书。\n长日看鸿雁，呼儿问鲤鱼。\n凉风郢路远，落叶洞庭初。\n无限归凫翼，南飞最跂予。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40751,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"金沙花","author":"刘攽","text":"苒弱金沙树，花奇名字珍。\n移从今日晚，恨失去年春。\n嫩绿藤垂架，深红棘刺人。\n东风会入手，照眼万枝新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40752,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠邻翁","author":"刘攽","text":"与彼茅茨接，看渠卜筑初。\n丈人真耄矣，孺子复何如。\n翁且勤杯酒，儿教读道书。\n衡门来往近，时为过吾庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40753,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初晴赠某翁","author":"刘攽","text":"云随夜色改，日与曙光升。\n已变前除雪，犹馀北户冰。\n鸿飞知适意，鹤语若矜能。\n天事宽羁旅，幽人亦有朋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40754,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晨起","author":"刘攽","text":"断角续鸣钟，惜时春已空。\n晓星犹伴月，早雨不禁风。\n眠食须颐老，衣冠强自公。\n庭阴全绿色，无复见残红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40755,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽胡元夫母寿安县太君二首 其一","author":"刘攽","text":"应妪金琛社，桓釐邑致膰。\n母仪真盛德，禄养现兴门。\n尚想君羹遗，那悲口泽存。\n苍山松梓暮，吊鹤去翩翻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40756,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽胡元夫母寿安县太君二首 其二","author":"刘攽","text":"清德畏人知，传家赖母慈。\n何时丹桂擢，相戒白华诗。\n戏綵欢无极，藏舟事密移。\n千钟已不暨，后日可胜悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40757,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"孟冬","author":"刘攽","text":"十月江南暑，居人尚葛衣。\n秋花看不绝，沙鸟听忘归。\n气郁愁成瘴，霜轻叹失威。\n异方羁旅思，岁事每多违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40758,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"午睡","author":"刘攽","text":"浮云蔽白日，风雨近秋天。\n车马欲安适，户庭方阒然。\n世涂高枕外，身事曲肱前。\n似觉松生腹，迢遥不记年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40759,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"古槐二首 其一","author":"刘攽","text":"地有藏丹井，人传不死乡。\n南柯经腊李，黑叶胜枯杨。\n甲错龙鳞断，花明鼠耳黄。\n离宫缘望幸，仙桧俨相望。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40760,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"古槐二首 其二","author":"刘攽","text":"仙人鍊形骨，枯槁不知年。\n秀色倏还观，阳和仍宛然。\n今古山川异，乾坤雨露偏。\n东阳无歇息，生意会绵绵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40761,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"复和前韵二首 其一","author":"刘攽","text":"遗履事悠远，白云飞帝乡。\n潜真社寄栎，观化肘生杨。\n秀叶发垂绿，杂英牙变黄。\n牺尊与沟断，俗骨尔何望。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40762,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"复和前韵二首 其二","author":"刘攽","text":"父老见枯朽，皆从童稚年。\n孙枝复秀色，仙事故依然。\n巢鹤千龄异，源泉一溉偏。\n颇笑海棕陋，崎岖留在绵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40763,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋暑呈冯守","author":"刘攽","text":"秋律何时效，炎云莫肯阴。\n烈风长鼓鞴，去水亦流金。\n藿食无求饱，单絺不自任。\n开怀幸宽政，事省得清心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40764,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿荆门","author":"刘攽","text":"山行厌曲折，小邑正欢哗。\n流水才一带，居人聚两涯。\n池偏饶草木，山晚聚云霞。\n郢路定未远，梦魂还到家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40765,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西湖水决","author":"刘攽","text":"平原出大水，蚁壤溃长汀。\n舟楫疑藏壑，波涛骇建瓴。\n蛟龙随过雨，鱼鳖问沧溟。\n闻道蓬莱水，桑田亦屡经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40766,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"素屏","author":"刘攽","text":"陋室避尘杂，深居惟此屏。\n虚空自生白，朴素拟忘形。\n画手山林迹，先生几杖铭。\n长来师绝学，未肯事丹青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40767,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"烧残树","author":"刘攽","text":"异时龙起蛰，一夕鸟焚巢。\n摧落残孤干，荒凉委近郊。\n莓苔深蚁穴，风雨诧神交。\n尚想知音遇，空心或远庖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40768,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]