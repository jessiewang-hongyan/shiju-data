[{"title":"送子仁侄南归二首 其二","author":"杨万里","text":"再岁来相款，三杯忽语离。\n忍将垂老泪，滴作送行诗。\n子去侬犹住，身留梦亦随。\n南溪旧风月，千万寄相思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69248,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送广帅秩满之官丹阳二首 其二","author":"杨万里","text":"南海元戎禁从臣，却升北斗捧星辰。\n回头五岭忽千里，屈指十贤添一人。\n笑别广平堂下月，归看太极殿前春。\n一尊话别端何有，绿水青山更白云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69249,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送广帅秩满之官丹阳二首 其一","author":"杨万里","text":"北门卧护要耆英，小试胸中十万兵。\n天借金山吟落月，身兼铁瓮作长城。\n何如岭上因归路，摘取梅酸去作羹。\n已有紫泥教诣阙，便应留住付钧衡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69250,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送马庄父游金陵","author":"杨万里","text":"东华踏遍软红尘，却去秦淮钓月轮。\n朱雀乌衣王谢宅，黄旗紫盖晋梁春。\n江山拾得风光好，杖屦归来句子新。\n祗恐参卿署军事，醲薰荐墨到槐宸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69251,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送文黼叔主簿之官松溪","author":"杨万里","text":"乃翁只解日争晖，不解尘中脱叔兮。\n杨簿故应过习簿，建溪好处说松溪。\n此行诗句何须觅，满路春光总是题。\n飞上金銮稳安脚，竹林分付一莺啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69252,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送王文伯上舍归丰城兼简何侍郎","author":"杨万里","text":"碧落先生少可人，银钩茧纸苦称君。\n谈间口吸西江水，句里家传南浦云。\n千里端能来命驾，一尊得与细论文。\n还家剩草三千牍，看策平津第一勋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69253,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送王吉州宣子舍人知明州二首 其二","author":"杨万里","text":"碧海翻词笔，清霜逼谊风。\n不应盛名下，未著玉堂中。\n剩欲公留此，其如帝望公。\n从今摩病眼，看到火城红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69254,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送王吉州宣子舍人知明州二首 其一","author":"杨万里","text":"满听除书好，明州胜吉州。\n又为邦伯去，政坐治声优。\n过阙端能遇，居中定作留。\n新民莫漫喜，竹马不须休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69255,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送王成之中书舍人使虏","author":"杨万里","text":"帝遣唐朝第一人，玉门关外赐金银。\n使星芒动梅花早，汉月光垂塞草春。\n故国山河迎诏旨，中原父老识词臣。\n十分宣慰华戎了，归为君王转大钧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69256,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送王季德提刑宝文少卿","author":"杨万里","text":"宝储依旧接英游，荡节何曾远藻旒。\n卿月使星银汉晓，绣衣綵服太湖秋。\n豺当道上狐何问，鹰击霜前兔已愁。\n火急平反供一笑，紫荷玉笋待君侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69257,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送王恭父监丞倅潼川","author":"杨万里","text":"淡墨抡魁政少年，蓬山璧水得诗仙。\n集贤学士看文笔，国子先生费酒钱。\n濯锦江头频入梦，桃花水面送归船。\n平分风月真聊尔，不日来朝尺五天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69258,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送丘宗卿帅蜀三首 其三","author":"杨万里","text":"蜀人诧蜀不能休，花作江山锦作州。\n老我无缘更行脚，羡君来岁领遨头。\n碧鸡金马端谁见，酒肆琴台访昔游。\n收入西征诗集里，忆侬还解寄侬不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69259,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送丘宗卿帅蜀三首 其二","author":"杨万里","text":"谕蜀宣威百万兵，不须号令自精明。\n酒挥勃律天西椀，鼓卧蓬婆雪外城。\n二月海棠倾国色，五更杜宇说乡情。\n少陵山谷千年恨，不遇丘迟眼为青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69260,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送丘宗卿帅蜀三首 其一","author":"杨万里","text":"人似隆中汉卧龙，韵如江左晋诸公。\n四川全国牙旗底，万里长江羽扇中。\n玉垒顿清开宿雾，雪山增重起秋风。\n近来廊庙多西帅，出相谁言只在东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69261,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送永州唐德明","author":"杨万里","text":"忽报故人至，知从何许来。\n满怀俱玉雪，半语不尘埃。\n聚散千江月，悲驩一酒杯。\n樯乌有底急，一夕百相催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69262,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送伍耀卿监庙西归","author":"杨万里","text":"敬轩居士子胥孙，河出昆仑学有源。\n秋鹗屡看书祢表，春风两度对尧轩。\n钓竿已拂珊瑚树，拄笏新沾雨露恩。\n暂作祝融香火吏，裹轮早晚到柴门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69263,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送刘孔章县尉得官西归","author":"杨万里","text":"早宴黄花诣粉闱，晚挼春草染朝衣。\n却提猛士弓弯月，去扫封狐雪打围。\n绿鬓朱颜君胜我，青春白日我思归。\n何时共瀹青原茗，下看江鸥来去飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69264,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送刘童子","author":"杨万里","text":"天上麒麟地上行，掌中珠玉月中生。\n澜翻六籍吞诸子，声动三公及九卿。\n别有诗书真事业，不应童子是勋名。\n长成来奏三千牍，桃李春风冠集英。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69265,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送刘德脩殿院直阁将漕潼川二首 其二","author":"杨万里","text":"半世西风吹盛名，晚同朝路慰平生。\n一言半语到金石，四海九州成弟兄。\n雪岭锦城君理棹，青鞋黄帽我归耕。\n长江万里通吴蜀，逢著双鱼各寄声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69266,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送刘德脩殿院直阁将漕潼川二首 其一","author":"杨万里","text":"乌府何缘著佞臣，紫皇亲擢得斯人。\n金丹半粒回元气，玉宇崇朝作好春。\n不惜孤身轻一叶，坐令九鼎重千钧。\n万牛回首求梁栋，未要沱江理钓缗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69267,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送孙从之司业持节湖南二首 其二","author":"杨万里","text":"白头灯火共书林，自少论交老慰心。\n官职坏人饧里鸩，忠贤到骨锻中金。\n朝阳鸣凤祗今见，夜雨对床何日寻。\n回雁峰前雁回后，紫薇红药待渠吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69268,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送孙从之司业持节湖南二首 其一","author":"杨万里","text":"全家先遁却谁知，匹马西归也大奇。\n出昼莫嫌三宿恋，坏麻不待七年迟。\n风生折槛人无古，水绕圜桥士有师。\n六一澹庵乔木在，今秋新长雪霜枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69269,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送孙检正德操龙图出知镇江二首 其二","author":"杨万里","text":"看花走马绍兴间，彼此春风各少年。\n黄甲诸儒今几许，白头同舍省东偏。\n昨宵归梦月千里，馀债欠君诗两篇。\n已乞闽山一窠阙，老身只要早归田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69270,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送孙检正德操龙图出知镇江二首 其一","author":"杨万里","text":"润州太守去明州，谁寄长江万里流。\n鸡省却烦三语掾，龙章卧护两淮秋。\n古来北府多名酒，今复南徐说胜游。\n聊奉双亲小行乐，即持荷橐侍宸旒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69271,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送朱师古龙图少卿帅潼川二首 其二","author":"杨万里","text":"甲戌花时策集英，相看须鬓各青青。\n曲江初别春三月，北阙重来再一星。\n百石去官君似邴，千年归鹤我输丁。\n因书若寄杨员外，莫道山寒少茯苓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69272,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送朱师古龙图少卿帅潼川二首 其一","author":"杨万里","text":"璧水蓬山遍羽仪，颂台公府更光辉。\n紫荷到眼垂持橐，黄菊关心便拂衣。\n鬻子运筹年尚少，买臣衣绣日思归。\n小烦谕蜀须还报，却袖香烟侍太微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69273,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送次公子之官安仁监税","author":"杨万里","text":"汝仕今差晚，家庭莫恨离。\n学须官事了，廉忌世人知。\n争进非身福，临民只母慈。\n关征岂得已，龙断欲何为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69274,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送何一之右司出守平江","author":"杨万里","text":"十年一别再从游，又见鱼书拜彻侯。\n人物只今何水部，风流不减柳苏州。\n白蘋洲上春传语，乌鹊桥边草唤愁。\n报政不应迟五月，莺花紫禁伫归舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69275,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送何主簿归丰城","author":"杨万里","text":"众里非无士，难中却几人。\n如何新帅泽，偏作此邦春。\n未要栖鸾恨，方看报主身。\n青灯一樽酒，聊复话酸辛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69276,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送吴敏叔待制侍郎","author":"杨万里","text":"脚踏鸡翘豹尾间，心飞碧岫白云端。\n人看疏傅如图画，帝念严光返钓滩。\n玉殿松班唐次对，竹宫茅立汉祠官。\n自怜病鹤樊笼底，万羡冥鸿片影寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69277,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送吴监丞季行知简州","author":"杨万里","text":"勋烈涪阳异姓王，手扶西极汉天长。\n有孙文武千人杰，透纸风骚万字香。\n小涉移中公事笔，又怀剑外史君章。\n同朝多日相从少，不唱阳关也断肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69278,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送庐陵丞刘约之","author":"杨万里","text":"忠显闻孙定不虚，西枢犹子故应殊。\n鸾停梧上遗风在，雁进松间得句无。\n剩有老农歌赞府，未多荐墨送清都。\n晦翁若问诚斋叟，上下千峰不要扶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69279,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送庐陵宰赵材老","author":"杨万里","text":"赵侯龙种秀天潢，金玉肝脾锦绣肠。\n未复九人黄阁相，犹堪三字紫微郎。\n饥餐兰菊枝枝月，醉洒云烟句句霜。\n谁与邦民颂遗爱，老夫端欲续甘棠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69280,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送庐陵宰黄伯庸赴召","author":"杨万里","text":"君寄梅花道别肠，我攀官柳送归艎。\n东都循吏似名茂，南浦诗人更姓黄。\n白鹭青原留惠爱，苍苔红药入篇章。\n故人若问诚斋叟，化作沙鸥弄夕阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69281,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送张元直尉盐官二首 其二","author":"杨万里","text":"溧水孟东野，南昌梅子真。\n平生一少府，千载两高人。\n白马松梢寺，朱旗雪外春。\n村行如得句，寄我大江滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69282,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送张元直尉盐官二首 其一","author":"杨万里","text":"璧水寒齑客，春闱擢桂郎。\n折腰端小耐，整翮未须忙。\n德进官无小，诗癯誉更香。\n会看两鸂鶒，飞下蓼滩傍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69283,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送张定叟二首 其二","author":"杨万里","text":"紫岩衣钵付南轩，介弟曾同半夜传。\n师友别来真梦耳，江湖相对各潸然。\n但令门户无遗恨，何必功名在早年。\n君向潇湘我闽粤，寄书只在寄茶前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69284,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送张定叟二首 其一","author":"杨万里","text":"直上云霄未遣休，分符京兆帝王州。\n赤丸窟里无白额，碧落班中政黑头。\n两地好官才半武，扁舟归兴恰中秋。\n只应银信从天降，莫恋融峰与橘洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69285,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送李伯珍主管西归","author":"杨万里","text":"淡墨题名冠子衿，一星州县叹浮沈。\n向来寄我南楼赋，不减古人东武吟。\n几阁文书聊韫玉，兰台笔札即紬金。\n李家兄弟鹓鸾侣，一日双飞入上林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69286,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送李制干季允擢第归蜀","author":"杨万里","text":"玉立长身太史公，诸郎个个有家风。\n高文大册传书种，怨句愁吟恼化工。\n鸿雁双衔月宫桂，鹓雏独恋蜀山桐。\n何如天网笼云表，三凤都归上苑中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69287,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送沈虞卿秘监脩撰将漕江东二首 其二","author":"杨万里","text":"再入脩门访旧游，故人相见喜还愁。\n茂林脩竹君髯碧，折苇枯荷我鬓秋。\n莫把升沈著怀抱，古来贤圣几公侯。\n一尊追送江东棹，梦逐清波弄白鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69288,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送沈虞卿秘监脩撰将漕江东二首 其一","author":"杨万里","text":"蓬莱仙伯沈东阳，领袖诸儒太极旁。\n东壁二星云汉近，西昆群玉简编香。\n鸡翘豹尾无多子，锦缆牙樯有底忙。\n建业江山入诗集，却归天上侍虚皇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69289,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送陆子静删定宫使","author":"杨万里","text":"朝路江西不十人，又看一个奉仙真。\n可怜议论长倾坐，不管声名解误身。\n苦忆去年郊祀日，与渠并辔笑谈春。\n何时相趁沧洲去，雪笠风蓑钓白蘋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69290,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送陈行之寺丞出守南剑二首 其二","author":"杨万里","text":"我召公先到，公归我亦行。\n三年如梦尔，一笑可怜生。\n野店缘山去，春风并辔轻。\n先愁饶水上，话别若为情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69291,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送陈行之寺丞出守南剑二首 其一","author":"杨万里","text":"甫尔丞农扈，翩然牧剑津。\n诸公谁不相，有子几何人。\n气节霜馀凛，辞章玉样新。\n飞腾可轻料，渠亦正青春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69292,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送陈婿履常县丞之官泰宁","author":"杨万里","text":"玉润非冠玉，东床忽易东。\n一官斯立样，五字后山风。\n明月来宵共，清尊何日同。\n看君即飞兔，老我自冥鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69293,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送周元吉显谟左司将漕湖北三首 其三","author":"杨万里","text":"彼此江湖漫浪翁，相逢递宿省西东。\n两穷握手论诗后，一笑投胶入漆中。\n临水登山公别我，青鞋布袜我从公。\n貂裘已博江西艇，只待黄花半席风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69294,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送周元吉显谟左司将漕湖北三首 其二","author":"杨万里","text":"又见周郎携小乔，武昌赤壁醉娇饶。\n蜀江雪水来三峡，吴苑风烟访六朝。\n秋月春花出肝肺，新词丽曲入笙箫。\n归来却侍金銮殿，好看霜毛映珥貂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69295,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送周元吉显谟左司将漕湖北三首 其一","author":"杨万里","text":"君诗日日说归休，忽解西风一叶舟。\n黄鹤楼前作重九，水精宫里过中秋。\n职亲六阁仍金马，喜入千屯看木牛。\n绣斧光华谁不羡，一贤去国欠人留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69296,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送周仲觉访来又别","author":"杨万里","text":"酒边诗里久尘埃，见子令人病眼开。\n无夕不谈谈不睡，看薪成火火成灰。\n小留差胜匆匆别，欲去何如莫莫来。\n渠政功名我岩壑，老身谁子共归哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69297,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送周彦敷通判之官临川","author":"杨万里","text":"益国今姬旦，治中小吕申。\n留家视兰膳，疋马见州民。\n慈训二六句，寒窗三十春。\n校书天禄阁，才子即云津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69298,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送昌英叔知县之官麻阳","author":"杨万里","text":"政坐诗无半点尘，天令著句锦江春。\n远民蒙惠即真学，漫仕缘亲非为身。\n许日相从今恨少，先生此别我谁邻。\n不应更作徒劳叹，廊庙方寻密县人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69299,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送林子方直阁秘书将漕闽部三首 其三","author":"杨万里","text":"亦闻小泊赞公房，清晓扶藜叩上方。\n君与一僧游别嶂，我行百匝绕长廊。\n风巾雾屦来云外，雪桧霜松满袖香。\n政是炎官张火伞，不应多取海山凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69300,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送林子方直阁秘书将漕闽部三首 其二","author":"杨万里","text":"梅花国里荔枝村，颇记张灯作上元。\n一别频蒙访生死，七年再见劣寒温。\n属当闵雨祈群望，不得临风共一尊。\n谁为君王留国士，吾衰犹拟叫天阍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69301,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送林子方直阁秘书将漕闽部三首 其一","author":"杨万里","text":"才趁锋车入帝关，又持使节过家山。\n作仙茶囿芝田里，寓直蓬莱藏室间。\n握手清谈纱帽点，羡君白日绣衣还。\n来年贡了云龙璧，便缀金鸾玉笋班。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69302,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送罗永年归永丰","author":"杨万里","text":"谁道三年聚，能胜一别多。\n岁寒知子可，心折奈吾何。\n所喜如椽笔，能挥却日戈。\n老夫留病眼，看子中文科。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69303,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送罗季周主簿之官八桂","author":"杨万里","text":"忆昔相从夜诵时，子垂两髧我初髭。\n梧桐叶落犹无睡，桃李春归总不知。\n我已悬车老岩壑，子方敛板走阶墀。\n莫嫌衰病人皆弃，桂岭梅花寄一枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69304,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送罗春伯大著提举浙西","author":"杨万里","text":"晁董声名彼一时，夫君下笔与渠齐。\n承明厌直辞金马，英荡非关访碧鸡。\n山岳动摇增气色，诏书宣布舞群黎。\n归期只在千秋节，留赋苍苔凤掖西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69305,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送金元度教授辞满赴部改秩","author":"杨万里","text":"金华唐吕两儒先，夜半黄梅君并传。\n不日经筵重坐席，暂时黉舍冷无毡。\n引班晓漏槐枫里，出宰春风桃李边。\n莫遣垂杨知别恨，一篙新涨解归船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69306,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送俞漕子清大卿赴召二首 其二","author":"杨万里","text":"自笑孤踪霜叶轻，宦游何幸并耆英。\n合符先后分江郡，接武差池缀月卿。\n爱我从来两胶漆，与公别是一亲情。\n老身无用难提挈，尚有儿曹累使令。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69307,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送俞漕子清大卿赴召二首 其一","author":"杨万里","text":"帝求耆旧忆吾公，紫诏斜行下碧穹。\n励操兰薰仍雪瑩，作民冬日与春风。\n便登凤阁鸾台上，小试鸡翘豹尾中。\n十载江湖访民瘼，一时倾倒沃天聪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69308,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送客既归晚登清心阁","author":"杨万里","text":"谁不知侬懒，其如送客何。\n叶声和雨细，山色上楼多。\n出处俱为累，升沉尽听他。\n疏钟暮相答，也解说愁么。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69309,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送胡端明赴召","author":"杨万里","text":"紫泥夜下日星晖，赤舄朝看衮绣归。\n中国如今相司马，四夷见说问非衣。\n金鱼玉带明霜鬓，斗极台符拱太微。\n卫武年龄子仪考，一身双美古来稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69310,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]