[{"title":"汝南湾","author":"杨备","text":"汝南王昔过江东，此地名将汝海同。\n玉斝濯来人易醉，有时人面照花红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71735,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观风楼","author":"杨备","text":"观风危堞与云齐，楼下开门画戟西。\n鼓角声沉丝管沸，卷帘晴黛远山低。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71736,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"驰道","author":"杨备","text":"路平如砥直如弦，官柳千株拂翠烟。\n玉勒金羁天下骏，急于奔电更挥鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71737,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"佛窟寺","author":"杨备","text":"曩事何人为證明，白云深锁翠微坑。\n已闻过去辟支佛，未见如来弥勒生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71738,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"劳劳亭","author":"杨备","text":"柳风飞絮扑征袍，望远楼中望眼高。\n几许江南名利客，灰尘满面日劳劳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71739,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吴大帝庙","author":"杨备","text":"古木阴森庙岿然，龙蟠虎踞旧山川。\n当时鼎足一场梦，空里旋风飞纸钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71740,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吴王井","author":"杨备","text":"石甃遗踪傍古台，一泓寒影鉴光开。\n何人照面金钗落，曾见越溪红粉来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71741,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吴江","author":"杨备","text":"松陵水国面松江，学弄渔竿对酒缸。\n惊起鸳鸯是旗鼓，背帆飞去一双双。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71742,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"层城观","author":"杨备","text":"秋星如弹月如梳，宫妓香添乞巧炉。\n万缕千针同一意，眼穿肠断得知无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71743,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"应潮井","author":"杨备","text":"碧甃时时减复增，山头海面密相应。\n古来泉脉谁穿过，潮落潮生不暂澄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71744,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陆机宅","author":"杨备","text":"陆家兄弟颇能文，入洛仍将笔砚焚。\n旧宅荆榛狐兔窟，机云无复有昆云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71745,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鸡鸣埭","author":"杨备","text":"辇出城时鸡未鸣，春罗蝉翼赭袍轻。\n蒙尘猎骑奔如电，到此闻鸡第一声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71746,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"咏钟山","author":"杨备","text":"周子无心隐姓名，裂荷焚芰使猿惊。\n不能高枕云中卧，琐屑贪它墨绶荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71747,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"姑苏台","author":"杨备","text":"山花野草一荒丘，云里骄奢旧迹留。\n珠翠管弦人不见，上头麋鹿至今游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71748,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岩因崇报禅寺","author":"杨备","text":"一炷香销百和焚，有时钟磬梵天闻。\n上方结草如高枕，不独栖霞可卧云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71749,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"披香殿","author":"杨备","text":"兽口金昏烟穗浓，螭头玉照露华融。\n萧郎的是春光主，曾作春衣此殿中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71750,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"昆丘","author":"杨备","text":"云里山花翠欲浮，当时片玉转难求。\n卞和死后无人识，石腹句藏不采收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71751,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"穹窿山","author":"杨备","text":"吴郡名山第一山，翠微心在碧霄间。\n林泉潇洒烟岚秀，直拟结庐终老闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71752,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"虎丘","author":"杨备","text":"阖闾城见古荒丘，云里钟声满寺楼。\n白虎金晶人不见，昔曾雄据此山头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71753,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"试剑石","author":"杨备","text":"白刃凝霜照水寒，当时入匣便回銮。\n岩前片石犹中断，切玉如泥也不难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71754,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"采香径","author":"杨备","text":"馆娃南面即香山，画轲争浮日往还。\n翠盖风翻红袖影，芙蓉一路照波间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71755,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金城柳","author":"杨备","text":"风絮烟丝春复秋，攀条何故泪双流。\n因怜树老犹青眼，不觉人衰已白头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71756,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"青溪","author":"杨备","text":"倾城倾国两妃嫔，此地闻名不见人。\n潜想旧时红粉面，落花风里步香尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71757,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"青溪姑","author":"杨备","text":"曩不乘龙即跨鱼，岸傍人复乞灵无。\n柳如眉黛花如面，闻是青溪一小姑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71758,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"促妆钟","author":"杨备","text":"枕面钟声及早催，锦衾香叠百花堆。\n蟾蜍影落珊瑚架，照得仙娥下界来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71759,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"剑池","author":"杨备","text":"三尺龙盘古到今，波光凝碧暮云深。\n沈丝不断应无底，山脚池心彻海心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71760,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"响屧廊","author":"杨备","text":"步步香翻罗袜尘，粉红花艳满宫春。\n倾城一笑无遗迹，不见长廊响屧人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71761,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"洗马池","author":"杨备","text":"一一牵来种是龙，临深欲下更嘶风。\n金鞍玉勒抛何处，腾踏渥洼寒影中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71762,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"洞玄观","author":"杨备","text":"葛玄功行满三千，白日骖鸾上碧天。\n留得旧时坛宇在，后人方信有神仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71763,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝地","author":"杨备","text":"四主衣冠令不终，高门列戟漫重重。\n由来瘠沃分劳逸，莫道人凶非宅凶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71764,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝地","author":"杨备","text":"列戟高门气自雄，主人应是偶相逢。\n由来祸福皆人召，此地无辜唤作凶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71765,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冥漠君墓","author":"杨备","text":"柴垒穿壕见古坟，元嘉东府惠连文。\n可怜名字知音少，祇使双棺万古闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71766,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏驾湖","author":"杨备","text":"湖面波光鉴影开，绿荷红芰绕楼台。\n可怜风物还依旧，曾见吴王六马来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71767,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晋阴山庙","author":"杨备","text":"炉香烟断暮云凝，阴德山高众所称。\n开府琅玡旧蒙福，龙飞一马至中兴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71768,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"栽松岘","author":"杨备","text":"耸壑凌霄色共苍，森然万树约千行。\n刘郎大厦寻颠覆，应是其间少栋梁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71769,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桂岭","author":"杨备","text":"步步高如月里攀，拂云枝叶伴云间。\n开花结子清香远，应似淮南一小山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71770,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桃叶渡","author":"杨备","text":"桃叶桃根柳岸头，献之才调颇风流。\n相看不语横波急，艇子翻成送莫愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71771,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"真娘墓","author":"杨备","text":"冰肌玉骨真遗妍，粉作妒云黛作烟。\n知有香魂埋不得，夜深岩底月中仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71772,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵览古 秦淮","author":"朱存","text":"一气东南王斗牛，祖龙潜为子孙忧。\n金陵地脉何曾断，不觉真人已姓刘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71773,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清暑殿","author":"杨备","text":"窣地帘光挂水精，玉钩斜处月初生。\n龙皮席上鹅毛扇，何必风来暑自清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71774,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"烽火台","author":"杨备","text":"一带东流当复阙，筑台相望水云间。\n丽华应不如褒姒，几许狼烟得破颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71775,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"铜螭署","author":"杨备","text":"挈壶传箭逼天聪，铸出蟠螭巧范同。\n何事腹中藏怪物，人惊蝘蜓气如虹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71776,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"善泉池","author":"杨备","text":"影浸龙楼彻凤城，昭明有意在澄清。\n穿时深欲状溟渤，乐府当歌重润声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71777,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"景阳井","author":"杨备","text":"擒虎戈矛满六宫，春花无树不秋风。\n苍惶益见多情处，同穴甘心赴井中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71778,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"焚衣街","author":"杨备","text":"雉头金缕又珠胎，烟绪香云昼不开。\n御路傍人皆叹息，逡巡红焰作青灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71779,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蒋帝庙","author":"杨备","text":"深逼岩扉敞庙门，灵风时动戟衣翻。\n禦灾捍患阴功大，玉册荣加帝者尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71780,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"越来溪","author":"杨备","text":"临流何必吊前非，且说吴宫得意时。\n夹岸桃花烟水绿，画船礼物载西施。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71781,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"幕府山","author":"杨备","text":"六代繁华一瞬间，平芜远树不胜闲。\n倚楼天暝云如幕，知是琅琊幕府山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71782,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"新亭","author":"杨备","text":"满目江山异洛阳，北人怀土泪千行。\n不如亡国中书令，归老新亭是故乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71783,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"新宫","author":"杨备","text":"玉案金炉对御床，岿然应是鲁灵光。\n螭头直上双鱼尾，不让西京旧柏梁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71784,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"楚靳尚庙","author":"杨备","text":"汩罗鱼腹葬灵均，竞渡如飞不救人。\n天意明知谗口毒，果遭天谴作蛇身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71785,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"锦署","author":"杨备","text":"人衣蓝缕地衣红，不念家家杼柚空。\n厥篚织文应岁贡，更翻新样集机工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71786,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"慧聚寺","author":"杨备","text":"驻锡栖云石室中，楼台一片画屏风。\n禅师道德知多少，不尔山神肯助工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71787,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"横塘","author":"杨备","text":"早潮才过晚潮来，一一轩窗照水开。\n鉴面无尘风不动，分明倒影见楼台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71788,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"潜鹤鼓","author":"杨备","text":"端门击破使人惊，潜鹤双飞上玉清。\n怪得旧时声太远，冲天合自九皋鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71789,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题木兰堂","author":"杨备","text":"木兰枝密树仍高，堂下花光照节旄。\n列鼎重茵歌舞地，金章同色使君袍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71790,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题延射亭","author":"杨备","text":"高台芜没曲池平，十万人家古县城。\n烟水云山屏画里，阖闾坟域旧都名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71791,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题幽独居","author":"杨备","text":"金检书残石壁云，二名幽独彼何人。\n春深草没松门路，泉下诗犹感鬼神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71792,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题常熟县","author":"杨备","text":"远逼江垠傍海壖，落帆多是两来船。\n县庭无讼乡闾富，岁岁加收常熟田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71793,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"濛汜池","author":"杨备","text":"春条拂岸柳如金，一鉴澄空照底深。\n傍见龙舟赭袍影，分明红日在池心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71794,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"藏冰井","author":"杨备","text":"尤喜凌人职未隳，闭藏出纳示箴规。\n战兢国步艰难者，常似临深履薄时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71795,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蠡口","author":"杨备","text":"霸越勋名间世才，五湖烟浪一帆开。\n犹防乌喙伤同辈，此地复招文种回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71796,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"长洲 其一","author":"杨备","text":"太湖东西即长洲，临水孤城远若浮。\n雨过云收山泼黛，管弦歌动酒家楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71797,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"石室大岩","author":"杨备","text":"玉洞云深夏亦寒，客来寻胜久盘桓。\n其间隐约闻鸡犬，应有仙桃待一餐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71798,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江令宅","author":"杨备","text":"竹木池台尚俨然，归时白头雪霜寒。\n青溪隐隐朱门处，曾属中书一品官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71799,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吴建初寺","author":"杨备","text":"僧会西来始布金，常闻足磬伴潮音。\n江南古寺知多少，此寺独应年最深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71800,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乘黄署","author":"杨备","text":"执辔何人籍帝台，汉家天马不时来。\n疲驽多亦费刍粟，莫惜千金市骏材。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71801,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"麾扇渡","author":"杨备","text":"旌旗烁日刃凝霜，甲光如龙人似狼。\n羽扇一挥风偃草，策勋多谢顾丹阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71802,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"杨备","text":"云窦穿银井，冰甃贮玉浆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71803,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"杨备","text":"生来葬鱼腹，死后触龙鳞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71804,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题汪水云诗卷","author":"杨学李","text":"野服意翛然，心无世网牵。\n衣冠旧朝士，湖海老诗仙。\n横槊思公瑾，登楼忆仲宣。\n潇湘风月好，何日理归船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71805,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西郊晚步","author":"杨学李","text":"江城五月风雨馀，岭南地僻少驰驱。\n政馀长日无与俱，寻幽步屧城西隅。\n地平山远迷绿芜，垂阳深处闻鹧鸪。\n萦纡小径逅浮图，松风夹道如笙竽。\n清池冷浸秋水菰，如有露气侵庭梧。\n桃笙院静横竹奴，栩栩清梦游冰壶。\n觉来残照不可呼，更待好月同归涂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71806,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初秋夜坐","author":"杨学李","text":"青灯伴微吟，烦暑犹蒸炊。\n风声如山雷，怒落窗西篱。\n砌蛩泣候莎，老树鸣高枝。\n桂魄忽婵娟，夜气侵凉絺。\n莼羹岂不怀，未了一载痴。\n依依游子情，堂萱重驰思。\n祇将冰雪心，或可为母慈。\n清白为家箴，夫岂世俗知。\n南来秋复秋，剩喜瓜及期。\n娱亲已可望，须记思亲时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71807,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"望云楼","author":"杨学李","text":"楼前山色青如鬟，楼高夜映心斗寒。\n推窗纵目纳吟思，倚槛爽气生眉端。\n荒烟宿霭迷野甸，古崖怪石横惊湍。\n城孤下瞰天蘸碧，日永坐听风鸣銮。\n登临独慨城郭是，把酒一酹还三叹。\n虽未如元龙高卧之百尺，已不减庾公步月之游观。\n又何须黄鹤霄汉之浩渺，亦可想岳阳烟水之弥漫。\n岿然独立贺江许，已矣楼中沸歌舞。\n胜境无诗亦可羞，谩自檐楹庇风雨。\n望云人远迹生尘，祇有江流自今古。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71808,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题汪水云诗卷","author":"杨学周","text":"握手论心不记年，重逢仍似地行仙。\n琴弹碧玉时三弄，袖有骊珠近百篇。\n岳麓晓行云外履，湘潭夜醉月中船。\n它时归隐西湖畔，能把新诗寄一联。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71809,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与高氏子","author":"杨尚书","text":"十数年来聋耳聩，可将社酒便能医。\n一心更愿清盲了，免见豪家小马儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71810,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"成都运司园亭十首 其十 小亭","author":"杨怡","text":"方亭惟四柱，对峙花竹间。\n下有雪岭水，淙流日潺潺。\n宛如双綵舸，缆向春波湾。\n欲起江湖心，而奈风涛艰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71811,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"成都运司园亭十首 其五 月台","author":"杨怡","text":"嘉木密交阴，月夕苦荟翳。\n高台出林杪，远目望天际。\n不厌清露寒，秪恐轻云蔽。\n可但少陵翁，能思斫仙桂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71812,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"成都运司园亭十首 其九 水阁","author":"杨怡","text":"小阁平池阳，危桥属花屿。\n杖履乐幽闲，龟鱼荫深阻。\n刻柱记新涨，弄水涤烦暑。\n物我久相忘，珍禽近人语。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71813,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]