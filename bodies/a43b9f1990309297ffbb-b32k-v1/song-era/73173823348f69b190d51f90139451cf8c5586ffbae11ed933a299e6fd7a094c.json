[{"title":"偶成","author":"冯去非","text":"春风吹送笑谈香，玉漏银灯破夜凉。\n归去东华听宫漏，杏花落尽六更长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21062,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题道士郑渭滨诗卷","author":"冯去非","text":"江湖曾是饮清波，笔染霜华秋最多。\n梦里诵君新句子，觉来无奈月明何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21063,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"凤凰台","author":"冯去非","text":"许大乾坤里，那无一凤鸣。\n台攲红日晚，梧拂翠云生。\n琐琐六朝梦，悠悠千古情。\n寒潮如有恨，时打石头城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21064,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江上","author":"冯去非","text":"清秋不可奈，先自懒登楼。\n一雁叫寒水，数峰生远愁。\n乾坤消剑气，江海笑诗流。\n不解人间事，眠鸥尽自由。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21065,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"张季海园梅","author":"冯去非","text":"到眼春流急，当桥梅影斜。\n怕闻连夜雨，为爱隔年花。\n寺古名多误，邻新酒少赊。\n如何双屐齿，太半白鸥沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21066,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"怀云泉颐山老","author":"姚镛","text":"枯吟世虑轻，求道不求名。\n病起春风过，闲居野草生。\n游山寻旧屐，煮药试新铛。\n别久空相忆，疏钟隔水鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21067,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寓居","author":"冯去非","text":"身世漂流付等闲，向来感慨鬓毛斑。\n唤船载梦西兴渡，借屋盛书北固山。\n开到黄花风渐锐，照残清野月频弯。\n江流送我东来了，何日潮头送我还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21068,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山居","author":"陈与义","text":"耿耿虚堂一榻秋，人间高枕几王侯。\n乱云未放晓山出，片月不随寒水流。\n检校一身浑是懒，平章千古得无愁。\n湘波见说清人骨，恨不移家阿那州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21069,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜客泉次韵","author":"冯去非","text":"白云在空山，丹光照崖水。\n仙人迹如埽，客至泉辄喜。\n世路多不平，个中太清生。\n政以静自怡，亦与凡将迎。\n风波处处息，坎离人人有。\n要使到此踪，尽作蓬瀛友。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21070,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"八声甘州 过松江","author":"冯去非","text":"买扁舟、载月过长桥，回首梦耶非。\n问往日三高，清风万古，继者伊谁。\n惟有茶烟轻扬，零露湿莼丝。\n西子知何处，鸿怨蛩悲。\n遥想家山好在，正倚天青壁，石瘦云肥。\n甚抛奇亸秀，猿鹤互猜疑。\n归去好、散人相国，迥升沈、毕竟总尘泥。\n须还我，松间旧隐，竹上新诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21071,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"点绛唇","author":"冯去非","text":"秋满孤篷，翠蒲红蓼留人住。\n一帘香缕。\n边影惊鸿度。\n小据胡床，旧事新情绪。\n凭谁诉。\n蜡灯犀尘。\n拟共西风语。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21072,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜迁莺","author":"冯去非","text":"凉生遥渚。\n正绿芰擎霜，黄花招雨。\n雁外渔村，蛩边蟹舍，绛叶满秋来路。\n世事不离双鬓，远梦偏欺孤旅。\n送望眼，但凭舷微笑，书空无语。\n慵觑。\n清镜里，十载征尘，长把朱颜污。\n借箸青油，挥毫紫塞，旧事不堪重举。\n间阔故山猿鹤，冷落同盟鸥鹭。\n倦游也，便樯云柁月，浩歌归去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21073,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"冯去非","text":"却是后生王介甫，不曾携妓涴东山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21074,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"冯去非","text":"茶疏缘睡少。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21075,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"冯去辩","text":"饟事十年当结局，襟期千古举同牢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21076,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"冯去辩","text":"琴心自误谁料理，犊鼻虽贫未主臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21077,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"睢阳五老会诗","author":"冯平","text":"诏恩分务许优闲，肯借留都獬豸冠。\n名宦傥来空扰攘，丘园归去好盘桓。\n醉游春圃烟霞暖，吟听秋潭水石寒。\n退傅况兼为隐伴，红尘那复举头看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21078,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"咏史","author":"冯必大","text":"亭长何曾识帝王，入关便解约三章。\n只消一勺清冷水，冷却秦锅百沸汤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21079,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"冯伉","text":"算来真是风骚将，李杜坛边好策勋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21080,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"冯伉","text":"传语东归王副使，也须别却海棠回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21081,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"云仙引 桂花夹钟羽","author":"冯伟寿","text":"紫凤台高，红鸾镜里，馡馡几度秋馨。\n黄金重，绿云轻。\n丹砂鬓边滴粟，翠叶玲珑烟剪成。\n含笑出帘，月香满袖，天雾萦身。\n年时花下逢迎。\n有游女、翩翩如五云。\n乱掷芳英，为簪斜朵，事事关心。\n长向金风，一枝在手，嗅蕊悲歌双黛颦。\n绕临溪树，对初弦月，露下更深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21082,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"木兰花慢 和答玉林韵","author":"冯伟寿","text":"酒醒人世换，碧桃靓、海山春。\n任青鸟沈沈，紫鳞杳杳，有玉林人。\n宫袍掉头未爱，爱荷衣、不染市朝尘。\n仙样蓬莱翰墨，云间鸾凤精神。\n笑呼银汉入金鲸。\n琼苑自由身。\n羡咳唾成章，香薰花雾，音和韶钧。\n六丁夜来捧去，便天人、也自叹尖新。\n那得金笺飞洒，浩歌飞步苍旻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21083,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉连环/解连环 忆李谪仙","author":"冯伟寿","text":"谪仙往矣，问当年、饮中俦侣，于今谁在。\n叹沈香醉梦，胡尘日月，流浪锦袍宫带。\n高吟三峡动，舞剑九州隘。\n玉皇归觐，半空遗下，诗囊酒佩。\n云月仰挹清芬，揽虬须、尚友千载。\n晋宋颓波，羲皇春梦，尊前一慨。\n待相将共蹑，龙肩鲸背。\n海山何处，五云叆叆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21084,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春云怨 上巳黄钟商","author":"冯伟寿","text":"春风恶劣。\n把数枝香锦，和莺吹折。\n雨重柳腰娇困，燕子欲扶扶不得。\n软日烘烟，乾风吹雾，芍药荼弄颜色。\n帘幕轻阴，图书清润，日永篆香绝。\n盈盈笑靥宫黄额。\n试红鸾小扇，丁香双结。\n团凤眉心倩郎贴。\n教洗金罍，共看西堂，醉花新月。\n曲水成空，丽人何处，往事暮云万叶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21085,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春风袅娜 春恨黄钟羽","author":"冯伟寿","text":"被梁间双燕，话尽春愁。\n朝粉谢，午花柔。\n倚红阑故与，蝶围蜂绕，柳绵无数，飞上搔头。\n凤管声圆，蚕房香暖，笑挽罗衫须少留。\n隔院兰馨趁风远，邻墙桃影伴烟收。\n些子风情未减，眉头眼尾，万千事、欲说还休。\n蔷薇露，牡丹球。\n殷勤记省，前度绸缪。\n梦里飞红，觉来无觅，望中新绿，别后空稠。\n相思难偶，叹无情明月，今年已是，三度如钩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21086,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"眼儿媚 春情","author":"冯伟寿","text":"自颦双黛听啼鸦。\n帘外翠烟斜。\n社前风雨，已归燕子，未入人家。\n鞋儿试著无人看，莫是忒宽些。\n想它楼上，闷拈箫管，憔悴莺花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21087,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题壁","author":"冯兴宗","text":"眼俗难观古，时间只顺天。\n平生羞诡遇，投老更加鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21088,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹤林寺","author":"冯多福","text":"春郊躬劝相，税驾拟禅关。\n院古深藏竹，堂虚净对山。\n日曛农父醉，云伴老僧闲。\n暇日还携茗，同来瀹虎斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21089,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"拙诗五十六言赠富乐山海公长老","author":"冯如晦","text":"山名富乐冠三巴，佛子今生此出家。\n六祖禅宗心顿悟，碧云诗句众争誇。\n虎闻讲法驯高座，鸥识忘机立浅沙。\n八十馀年无俗虑，只应幽会有莲华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21090,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"临终颂","author":"冯观国","text":"平生无町畦，任真但落魄。\n烂醉是生涯，天地为棺椁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21091,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"酒间作","author":"冯观国","text":"南北东西总是家，自知身命属烟霞。\n只因贪恋一杯酒，误却碧桃千树花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21092,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢人","author":"冯观国","text":"踏遍红尘四百州，几多风月是良俦。\n朝来应笑酡颜叟，道不相侔风马牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21093,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题化龙坊酒楼壁","author":"冯观国","text":"若问先生归去来，此行直是到天台。\n碧桃瑶草紫芝熟，到日须容醉玉杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21094,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题栋","author":"冯观国","text":"水非沟壑龙方卧，木是梧桐凤始栖。\n莫道男儿无去路，碧霄云外有仙梯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21095,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"述怀","author":"冯观国","text":"落魄尘寰触处然，深藏妙用散神仙。\n笔端间作龙蛇走，壶里常挑日月悬。\n漫假人伦来混世，只将酒盏度流年。\n潜修功行归何处，笑指瀛洲返洞天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21096,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"击瓯楼夜饮 其一","author":"冯伯规","text":"不上江亭数日间，雨馀山色带清寒。\n西风峭湛休围却，要放秋光入画阑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21097,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"击瓯楼夜饮 其二","author":"冯伯规","text":"去□□月莫回头，又见清商酝凛秋。\n怅望一双鸿鹄下，径冲烟雨占沧洲。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21098,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"约同僚游佳阴 其二","author":"冯伯规","text":"晚霁青山无处逃，秋来乘兴便登高。\n□君欲暮休催去，小驿依然□嫩醪。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21099,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"净凉夜坐","author":"冯伯规","text":"水光滟滟竹阴□，何□□香露泛襟。\n更欲□阑看身转，一钩弦月过□心。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21100,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游北岩","author":"冯伯规","text":"遥指蒙茸云木堆，入门小刹傍岩偎。\n放怀丘壑兴未尽，隔岸角声招我回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21101,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"□后圃成三绝句 其三","author":"冯伯规","text":"家山稍远梦难到，郡事渐希诗作魔。\n句就欲烦相催和，夜窗无奈透霜何。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21102,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"□后圃成三绝句 其二","author":"冯伯规","text":"摇落枝头□半空，纷纷群崔啅寒丛。\n四山□合如封锁，霜角凭晴声更雄。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21103,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"□后圃成三绝句 其一","author":"冯伯规","text":"重阳过后菊方开，引得幽人日日来。\n从□□开到花落，每来倾饮两三杯。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21104,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"先期登高观菊岩新榜","author":"冯伯规","text":"先得重阳五日来，清江晚日与人谐。\n共搜磊磊落落句，要敌奇奇怪怪崖。\n乌帽几容罗此影，黄花每喜近吾侪。\n山城酒熟浑无客，一笑临风寄老怀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21105,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岁晚倚栏","author":"冯伯规","text":"倏忽秋又尽，明朝恰立冬。\n细倾碧潋滟，喜对白芙蓉。\n问信迟宾雁，催寒有响蛩。\n暝烟都不见，闻得望□钟。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21106,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵仲秉木犀","author":"冯伯规","text":"金借颜色月借光，作团秾绿缀深黄。\n合令范晔添成传，曾向维摩饭此香。\n尚忆□□披御赐，颇疑妙舞簇霓裳。\n当陪玉树栽天上，肯学夭桃露短墙。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21107,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵泛舟仲秉有诗","author":"冯伯规","text":"且喜山城未傍边，漫从锦水学游船。\n何时官里真无事，是处壶中别有天。\n岂复江湖增远兴，强凭丝竹写中年。\n接䍦虽醉无劳著，恰要临流揖望仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21108,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵谢史提干见知","author":"冯伯规","text":"呼得蜿蜒入小瓴，便能飞雨挟林坰。\n油云顿失千山赤，丹篆尝腾一纸青。\n汉节可眠知免旷，仙祠屡扣信通灵。\n欲同此乐君西去，历想三峨旧所经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21109,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵酬李通江","author":"冯伯规","text":"长官祷雨信精诚，便觉丰年遍远坰。\n缫茧齐头丝卷白，插秧随手稻翻青。\n行篘秫酒酣天禄，益长香芽发地灵。\n守令爱民须表里，君其为纬我为经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21110,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初至郡讲禊饮于江上夜归赋此","author":"冯伯规","text":"身坠千峰不自知，尚修故事水之麋。\n真居峻岭崇山下，又过绿阴青子时。\n幻出流觞共顷刻，款留归棹展娱嬉。\n史君澹泊随民乐，先赋丰年一首诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21111,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"祷晴获应喜而赋诗","author":"冯伯规","text":"才通香火上高穹，雨脚随收不见踪。\n岂但五民保狼戾，也缘造物相龙钟。\n连山柿栗难胜摘，入市禾麻乍出舂。\n一饱可期秋酿熟，青山绿水即过从。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21112,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"端午前三日观坡诗首夏官舍即事因次其韵","author":"冯伯规","text":"帘阴不捲漏乌迟，数朵庭萱也自菲。\n公退万缘俱谢绝，心空一气自知归。\n但期菽粟令民足，未觉诗书与愿违。\n闻旱问龙求一雨，乘凉约客扣岩扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21113,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次日游西龛再用韵","author":"冯伯规","text":"倚阑一览兴无边，好举尊前药玉船。\n一水云昏失罗带，万松风偃舞钧天。\n早评月旦参群彦，老上霜鬓近十年。\n解后登临都乐事，酣馀争恐史君仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21114,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵中秉教授喜雨之作","author":"冯伯规","text":"入春绝无一声雷，赤日又将近夏末。\n阴霾蔽天动经月，草木叶上积寸埃。\n朝朝群望俱遍走，一毫及民更无有。\n雨师远逃龙亦睡，江涩鱼跳鼍空吼。\n初虽一雨慰望霓，明晨骄阳射到西。\n田如石坚耕不得，栏卧牛犊壁倚犁。\n诉天搏手嗟亡策，上山默扣真人宅。\n忽然斗暗云墨黑，尽化焚焦作膏泽。\n稽首谢天拜低头，郡寄且许臣分忧。\n击瓯楼上望四野，只愿保此三年秋。\n吾侪风萍偶接际，剩酝新秫储年计。\n稻苗便秧粟已芽，稳藉清尊度今岁。\n五更复闻檐溜声，攲枕不眠隔窗听。\n公馀一榻安禅处，姑借民谣当诗句。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21115,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵刘阆州谢送菊岩春","author":"冯伯规","text":"山中有佳菊，足以配古岩。\n饮酒对此菊，何用荐芳甘。\n不妨玉山颓，对卧千载楠。\n清赏不可共，妙句传巴南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21116,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵忠甫初见菊开","author":"冯伯规","text":"积雨晓放霁，红日照我帷。\n起来步幽蹊，金蕊灿朱扉。\n芳姿自妩媚，微香袭人衣。\n令节无多日，更宜拥培之。\n三径岂不富，最喜先开枝。\n此意谁领解，惟有渊明知。\n子诗正芳润，白露与俱滋。\n未□泛杯酌，且要涤甘肥。\n落英行可餐，乐哉遂忘饥。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21117,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"约同僚游佳阴 其一","author":"冯伯规","text":"老木垂垂绿覆栏，栏前髣髴见山□。\n尽教富贵饶公等，未许林泉□数廉。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21118,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"约同僚游佳阴 其三","author":"冯伯规","text":"□□时山漏夕阳，下山草木响□□。\n□来望到山尽处，一片明冰□□光。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21119,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观涨","author":"冯伯规","text":"孤城如深村，过客绝轮鞅。\n江流卷初霁，晚风纳微爽。\n我来适幽怀，新涨逸远响。\n汀没鸥鹭翔，牧罢牛羊上。\n郡古安陋朴，事简谢鞅掌。\n小酌便陶然，倚栏送轻桨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21120,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"季春下浣游南龛","author":"冯伯规","text":"四山如猬毛，中有线路萦。\n谁人导我来，得此掌许平。\n雨后天宇空，夏气和且清。\n休日一无事，驾言南山行。\n南山有何好，翠壁列峥嵘。\n巨木老已仆，赖有红石撑。\n自从严大夫，废兴今几更。\n稚干亦合抱，知几阅晦明。\n幽壑架危亭，无风凉自生。\n少间上绝顶，四望围长城。\n涨江笼篆纹，小市分棋枰。\n俛仰忘身世，独慨呼酒倾。\n何知玉堂客，分杂巴叟耕。\n下山喜同步，元自脚力轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21121,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨后观涨","author":"冯伯规","text":"闻得江头汹涌声，不知何处雨盆倾。\n两涯牛马那容辨，一夕蛟龙怒不平。\n浪尽横汀孤树在，微开顽翳夕阳明。\n尽饶河伯乘秋旺，潦涸霜寒水自清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21122,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"继而稍旱祷而复雨喜而作诗","author":"冯伯规","text":"连夕滂沱类建瓴，送将凉意满郊坰。\n江边草木太半绿，天外一峰无限青。\n却信神龙元解事，岂容旱魃更争灵。\n从今怀抱如冰释，闭阁烧香伴六经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21123,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶得新粳□送仲秉","author":"冯伯规","text":"东来五月见新粳，舂出□圆颗粒明。\n端羡□堂有母遗，数匙晚炊助尝羹。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21124,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登赋诗楼","author":"冯伯规","text":"高楼无一尘，适此半日闲。\n请以老杜句，赋诗榜其颜。\n井邑各参差，峰峦共回环。\n岁月行且换，星斗如可攀。\n不堪霜风劲，未许酒胆悭。\n祇缘期会急，勿怪题咏艰。\n所喜谈圣贤，大胜醉髦蛮。\n倚栏遥夜寂，一笑喧千山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21125,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"冯宋","text":"布衣已有回天力，太学翻为御史台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21126,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]