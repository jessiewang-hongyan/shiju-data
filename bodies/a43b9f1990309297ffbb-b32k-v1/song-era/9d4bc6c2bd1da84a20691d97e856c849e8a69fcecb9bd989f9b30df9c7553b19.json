[{"title":"次秀野种粟韵","author":"朱熹","text":"阿香一笑走丰隆，雨遍平畴万顷中。\n旧喜樊迟知学圃，今看许子快论功。\n遥怜郁郁翻秋陇，预想垂垂弄晚风。\n珍重诗翁且彊健，东阡南陌兴无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20470,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和秀野蕲簟之句","author":"朱熹","text":"史君两鬓尚青青，学道仍抛后院笙。\n溽暑快眠知簟好，晚凉徐觉喜诗成。\n人从蕲水当年寄，诗比韩公此日清。\n坐对更深谁是伴，唯应阙月共长庚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20471,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵寄题芙蕖馆三首 其一","author":"朱熹","text":"乱山丛里有江乡，华馆清波引兴长。\n正喜白鸥轻易狎，忽惊红妓俨分行。\n临流更好挥椽笔，俯槛何妨接羽觞。\n共说仙翁闲日月，不因春草梦池塘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20472,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵寄题芙蕖馆三首 其二","author":"朱熹","text":"幻成飞阁笑谈馀，便有新荷水面铺。\n指点清波浮菡萏，惊呼红影碎陬隅。\n且将伴侣同杯酒，不用君王予镜湖。\n多少故交台阁上，问渠落拓更能无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20473,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵寄题芙蕖馆三首 其三","author":"朱熹","text":"不须艇子棹歌来，且看芙蓉面面开。\n卷里有诗都锦绣，席间无地可尘埃。\n风清月白琴三弄，绿暗红深酒一杯。\n明日仲宣楼上去，越吟应是首频回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20474,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵雪后书事二首 其一","author":"朱熹","text":"惆怅江头几树梅，杖藜行绕去还来。\n前时雪压无寻处，昨夜月明依旧开。\n折寄遥怜人似玉，相思应恨劫成灰。\n沈吟日落寒鸦起，却望柴荆独自回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20475,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵雪后书事二首 其二","author":"朱熹","text":"满山残雪对虚堂，想似当年辋口庄。\n门掩不须垂铁锁，客来聊复共藜床。\n故人闻道歌围暖，妙语空传醉墨香。\n莫为姬姜厌憔悴，论文把酒话偏长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20476,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和秀野韵二首 其一","author":"朱熹","text":"闻道无馀事，翛然百虑空。\n何心分彼我，无地著穷通。\n昨日青衿子，明朝白发翁。\n天机元自尔，不是故匆匆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20477,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和秀野韵二首 其二","author":"朱熹","text":"久矣安岑寂，山栖恨不深。\n谩将门自掩，那有客相寻。\n炙背迎朝景，加趺度夕阴。\n感君传秀句，把卷独呻吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20478,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次秀野暑中二首 其一","author":"朱熹","text":"剧暑悲难度，清秋喜却回。\n病随庚伏尽，尊向晚凉开。\n临水看云去，钩帘待月来。\n胜游惊昨梦，曾上郁萧台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20479,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次秀野暑中二首 其二","author":"朱熹","text":"绝境人难到，唯堪乐此身。\n泉吟青玉峡，风度白纶巾。\n独往宁无意，长闲未有因。\n云山天赐履，吾道岂全贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20480,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次秀野杂诗韵 葺居二首 其一","author":"朱熹","text":"丈人高卧碧江头，门掩西风万木秋。\n重喜青山还绕屋，却嫌黄叶渐平沟。\n开轩且放浮岚入，决水徐通废圃流。\n便觉园林顿萧爽，不妨随境味玄幽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20481,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次秀野杂诗韵 葺居二首 其二","author":"朱熹","text":"向来鞅掌元非病，此日徜徉讵有妨。\n自喜登台闲瘦竹，人惊步屧响空廊。\n高斋雨过新山色，曲沼风来旧水光。\n千里壮心殊未已，不应疏懒兴能长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20482,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次秀野杂诗韵 刻漏","author":"朱熹","text":"无疑莫诣君平肆，任运休寻季主家。\n谩设铜壶候尺咫，闲参玉表验分差。\n不妨启处知时节，那更荣枯纪岁华。\n却羡升平好官府，日高三丈放朝衙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20483,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次秀野杂诗韵 栗熟","author":"朱熹","text":"树杂椅桐继国风，莫教林下长蒿蓬。\n共期秋实充肠饱，不羡春华转眼空。\n病起数升传药录，晨兴三咽学仙翁。\n樱桃浪得银丝荐，一笑才堪发面红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20484,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次秀野杂诗韵 山药","author":"朱熹","text":"怪来朽壤耀琼英，小斸倾筐可代耕。\n豢豹于人尽无分，蹲鸱从此不须生。\n雪镵但使身长健，石鼎何妨手自烹。\n欲赋玉延无好语，羞论蜂蜜与羊羹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20485,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次秀野杂诗韵 食梨","author":"朱熹","text":"珍实浑疑露结成，香葩况是雪储精。\n乍惊磊落堆盘出，旋剖轻盈照骨明。\n卢橘谩劳誇夏熟，柘浆未许析朝酲。\n啖馀更检桐君录，快果知非浪得名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20486,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次秀野杂诗韵 导引","author":"朱熹","text":"闻说牛刀久不更，闲中应接羡门生。\n向来已悟藏千界，今日何劳倒五行。\n按蹻有时聊戏剧，居心无物转虚明。\n举觞试问同亭侣，九转工夫早晚成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20487,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次秀野杂诗韵 假山焚香作烟云掬水为瀑布二首 其一","author":"朱熹","text":"平地俄惊紫翠堆，便应题作小飞来。\n炉熏细度岩姿出，线溜遥分壁色开。\n独往但凭南郭几，远游休剪北山莱。\n人言造化无私力，珍重仙翁挽得回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20488,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次秀野杂诗韵 假山焚香作烟云掬水为瀑布二首 其二","author":"朱熹","text":"一篑工夫莫坐谈，便教庭际涌千岩。\n眼中水石今成趣，物外烟霞旧所耽。\n泉细寒声生夜壑，香销暝霭变晴岚。\n儿童也识幽栖地，共指南山更近南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20489,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次秀野杂诗韵 家酿二首 其一","author":"朱熹","text":"铚艾无中熟，欢谣阙屡丰。\n但知愁鬓白，那复醉颜红。\n田舍寒如此，侯家事不同。\n新醅拨浮蚁，春满夜堂中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20490,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次秀野杂诗韵 家酿二首 其二","author":"朱熹","text":"闻道兵厨盛，春泉响臈篘。\n定知盈榼送，不待扣门求。\n沆瀣应难比，茅柴祇自羞。\n病身从法缚，好客为公留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20491,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次秀野杂诗韵 酒市二首 其一","author":"朱熹","text":"闻说崇安市，家家曲米春。\n楼头邀上客，花底觅南邻。\n讵有当垆子，应无折券人。\n劝君浑莫问，一酌便还醇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20492,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次秀野杂诗韵 酒市二首 其二","author":"朱熹","text":"丽藻摛云锦，新章写陟釐。\n诗传国风体，兴发酒家旗。\n见说难中圣，遥知但啜醨。\n盘餐杂鲑菜，那有蟹螯持。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20493,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次秀野杂诗韵 黄雀鲊","author":"朱熹","text":"黄雀飞鸣处，交交异窃脂。\n稻粱求易足，罗网去何迟。\n味厚资偏嗜，谋疏阙自为。\n韩彭尚菹醢，么么尔诚宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20494,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次秀野杂诗韵 槟榔","author":"朱熹","text":"忆昔南游日，初尝面发红。\n药囊知有用，茗盌讵能同。\n蠲疾收殊效，修真录异功。\n三彭如不避，糜烂七非中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20495,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次秀野杂诗韵 其一 又五绝卒章戏简及之主簿","author":"朱熹","text":"暮年药裹关身切，此外翛然百不贪。\n薏苡载来缘下气，槟榔收得为祛痰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20496,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次秀野杂诗韵 其二 又五绝卒章戏简及之主簿","author":"朱熹","text":"锦文缕切劝加餐，蜃炭扶留共一柈。\n食罢有时求不得，英雄邂逅亦饥寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20497,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次秀野杂诗韵 其三 又五绝卒章戏简及之主簿","author":"朱熹","text":"向来试吏著南冠，马甲蚝山得饫餐。\n却藉芳辛来解秽，鸡心磊落看堆柈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20498,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次秀野杂诗韵 其四 又五绝卒章戏简及之主簿","author":"朱熹","text":"个中有味要君参，螫吻舂喉久不甘。\n珍重人心亦如此，莫将寒苦换春酣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20499,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次秀野杂诗韵 其五 又五绝卒章戏简及之主簿","author":"朱熹","text":"高士沉迷簿领书，有时红糁缀玄须。\n定知不著金柈贮，儿女心情本自无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20500,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"答王无功在京思故园见乡人问","author":"朱熹","text":"我从铜川来，见子上京客。\n问我故乡事，慰子羁旅色。\n子问我所知，我对子应识。\n朋游总彊?，童稚各长成。\n华宗盛文史，连墙富池亭。\n独子园最古，旧林间新坰。\n柳行随堤势，茅斋看地形。\n竹从去年移，梅是今年荣。\n渠水经夏响，石苔终岁青。\n院果早晚熟，林花先后明。\n语罢相叹息，浩然起深情。\n归哉且五斗，饷子东皋耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20501,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送吴茂实","author":"朱熹","text":"朝市令人昏，山林使人傲。\n谁知昏傲两俱非，但说山林是高蹈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20502,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"短句奉迎荆南幕府二首 其一","author":"朱熹","text":"雄藩荆楚地，自古国西门。\n客有筹边略，人知幕府尊。\n时平烽燧冷，事省笑谈温。\n宛洛何年向，奇功要一论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20503,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"短句奉迎荆南幕府二首 其二","author":"朱熹","text":"军府资长算，家山辍胜游。\n故人千里别，归骑两年秋。\n吊古宁忘恨，开尊且破愁。\n相思欲回首，但上曲江楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20504,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赵君泽携琴载酒见访分韵得琴字","author":"朱熹","text":"山城夜寥阒，虚堂杳沉沉。\n王孙有高趣，挈榼来相寻。\n喜兹烦抱舒，未觉杯酒深。\n一为尘外想，再抚丘中琴。\n馀音殷雷动，爽籁悲龙吟。\n寄谢筝笛耳，宁知山水音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20505,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄题浏阳李氏遗经阁二首 其一","author":"朱熹","text":"老翁无物与孙儿，楼上牙签满架垂。\n更得南湖亲嘱付，归来端的有馀师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20506,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄题浏阳李氏遗经阁二首 其二","author":"朱熹","text":"读书不见行间墨，始识当年教外心。\n个是侬家真宝藏，不应犹羡满籯金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20507,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题郑德辉悠然堂","author":"朱熹","text":"高人结屋乱云边，直面群峰势接连。\n车马不来真避俗，箪瓢可乐便忘年。\n移筇绿幄成三径，回首黄尘自一川。\n认得渊明千古意，南山经雨更苍然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20508,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"长溪林一鹗秀才有落发之愿示及诸贤诗卷因题其后二首 其一","author":"朱熹","text":"闻说当机百念休，区区何更苦营求。\n早知名教无穷乐，陋巷箪瓢也自由。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20509,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"长溪林一鹗秀才有落发之愿示及诸贤诗卷因题其后二首 其二","author":"朱熹","text":"贫里烦君特地过，金襕谁与换鱼蓑。\n它年云水经行遍，佛法元来本不多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20510,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送德和弟归婺源二首 其一","author":"朱熹","text":"十舍辛勤触热来，琴书曾未拂尘埃。\n秋风何事催归兴，步出闽山黄叶堆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20511,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送德和弟归婺源二首 其二","author":"朱熹","text":"十年寂寞抱遗经，圣路悠悠不计程。\n误子南来却空去，但将迂阔话平生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20512,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"仲缜尊兄对策南宫相顾田舍辄赋小诗攀饯行李","author":"朱熹","text":"三径荒凉独掩门，故人车马过相存。\n长安此去无千里，浊酒何妨尽一尊。\n共说渊源非曩日，好披肝胆奉明恩。\n不辞妄窃仁人号，执手临岐敢赠言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20513,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"分水铺壁间读赵仲缜留题二十字戏续其后","author":"朱熹","text":"水流无彼此，地势有西东。\n若识分时异，方知合处同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20514,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次刘明远宋子飞反招隐韵二首 其一","author":"朱熹","text":"先生留落岁时多，气涌如山不易磨。\n却学幽人陶靖节，正缘三径起弦歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20515,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次刘明远宋子飞反招隐韵二首 其二","author":"朱熹","text":"荣丑穷通祇偶然，未妨闲共耸吟肩。\n君能触处真齐物，我亦平生不怨天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20516,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送谢周辅入广","author":"朱熹","text":"夫君壮节与奇谋，屈首微官世所羞。\n揽辔未妨聊矍铄，赋诗直为写离忧。\n苍茫岭海三年别，珍重亲朋几日留。\n满意分携一杯酒，登山临水不能休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20517,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和亦乐园韵","author":"朱熹","text":"莫笑君家五亩园，要须胸次亦平宽。\n坐间花柳阴初合，望外山河势若蟠。\n把酒尽誇双鬓绿，击鲜争见两轮丹。\n邻翁未到心先识，更喜诗筒得细观。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20518,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵谢刘仲行惠笋二首 其一","author":"朱熹","text":"谁寄寒林新斸笋，开奁喜见白差差。\n知君调我酸寒甚，不是封侯食肉姿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20519,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵谢刘仲行惠笋二首 其二","author":"朱熹","text":"君诗高处古无师，岛瘦郊寒讵足差。\n缚得狞龙并寄我，句中仍喜见雄姿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20520,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次季通韵赠范康侯","author":"朱熹","text":"朝霜逼凋梅，夕露忽团菊。\n百年风雨过，宜笑不宜哭。\n口川失自防，心兵几回触。\n年来身老大，甘此胯下辱。\n永谢五鼎烹，聊寄一瓢足。\n虽惭龙蟠泥，肯羡莺出谷。\n适意超混茫，放情遗结束。\n俯仰天壤间，静胜惟我独。\n苍苍有心柏，落落无瑕玉。\n年纪尚无闻，头颅岂须卜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20521,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"同张明府登凌风亭怀韩无咎","author":"朱熹","text":"日夕和风至，西山淡无姿。\n危亭极远眺，胜处良在兹。\n忆昔韩令尹，青云乃心期。\n鞿羁不得骋，发此胸中奇。\n前瞻千仞冈，俯视万顷陂。\n神襟一以旷，我志浩渺瀰。\n飞车越沧浪，天风振裳衣。\n怀哉此焉薄，问讯无边辞。\n今公岂不佳，宫商似前徽。\n相携岸晚帻，共此长相思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20522,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次王宰立春日大雪韵","author":"朱熹","text":"是身已分老菟裘，肯为春回作许愁。\n偶去寻芳朝信马，却来踏雪夜驱牛。\n铺筵不见小垂手，联句空惭高结喉。\n更约桃花红浪暖，却陪履舄上兰舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20523,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再次王宰韵","author":"朱熹","text":"相随到处一羊裘，况有澄江散客愁。\n且看跳鱼并集鸟，莫思去马与来牛。\n欢情往日空回首，酒味今年不下喉。\n只待两公高宴罢，却携茶鼎上渔舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20524,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送张彦辅赴阙","author":"朱熹","text":"执手何草草，送君千里道。\n君行入脩门，披胆谒至尊。\n问君此去谈何事，袖有谏书三万字。\n明堂封禅不要论，智名勇功非所敦。\n愿言中兴圣天子，脩政攘夷从此始。\n深仁大义天与通，农桑万里长春风。\n朝纲清夷军律举，边屯不惊卧哮虎。\n一朝决策向中原，著鞭宁许他人先。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20525,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"天湖四乙丈坐间赏梅作送刘充甫平甫如豫章","author":"朱熹","text":"竹外横枝老屈盘，冰壶遥夜玉窗寒。\n两公明日江南路，雪后园林子细看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20526,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"哭罗宗约二首 其一","author":"朱熹","text":"江阁论心地，重来感慨多。\n故人今已矣，此道竟如何。\n但使穷新得，终当订旧讹。\n话言虽永隔，吾欲问沧波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20527,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"哭罗宗约二首 其二","author":"朱熹","text":"行义追前辈，孤风凛一生。\n子平婚嫁了，元亮去留轻。\n涪万无归棹，严杨有旧盟。\n空令同社客，生死痛交情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20528,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题米元晖画","author":"朱熹","text":"楚山直丛丛，木落秋云起。\n向晓一登台，沧江日千里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20529,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"观刘氏山馆壁间所画四时景物各有深趣因为六言一绝复以其句为题作五言四咏 其一","author":"朱熹","text":"绝壑云浮冉冉，层岩日隐重重。\n释子岩中宴坐，行人雪里迷踪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20530,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"观刘氏山馆壁间所画四时景物各有深趣因为六言一绝复以其句为题作五言四咏 其二","author":"朱熹","text":"头上山泄云，脚下云迷树。\n不知春浅深，但见云来去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20531,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"观刘氏山馆壁间所画四时景物各有深趣因为六言一绝复以其句为题作五言四咏 其三","author":"朱熹","text":"夕阳在西峰，晚谷背南岭。\n烦郁未渠央，伫兹清夜景。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20532,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"观刘氏山馆壁间所画四时景物各有深趣因为六言一绝复以其句为题作五言四咏 其四","author":"朱熹","text":"清秋气萧瑟，遥夜水崩奔。\n自了岩中趣，无人可共论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20533,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"观刘氏山馆壁间所画四时景物各有深趣因为六言一绝复以其句为题作五言四咏 其五","author":"朱熹","text":"悲风号万窍，密雪变千林。\n匹马关山路，谁知客子心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20534,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"观祝孝友画卷为赋六言一绝复以其句为题作五言四咏 其一","author":"朱熹","text":"春晓云山烟树，炎天雨壑风林。\n江阁月临静夜，溪桥雪拥寒襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20535,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]