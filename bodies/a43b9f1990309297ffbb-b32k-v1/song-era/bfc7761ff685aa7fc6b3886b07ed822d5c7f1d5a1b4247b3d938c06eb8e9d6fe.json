[{"title":"馀干见游存诚","author":"王洋","text":"世家兄弟久随流，少不同嬉老宦游。\n身似舟空长信浪，官如萍转偶同州。\n论文共酌三斟酒，决胜公围一局楸。\n三百里溪明月夜，得心情处便相求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17470,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初萤","author":"王洋","text":"腐草渐时泽，翩然变化功。\n分光衣作炫，乘暗力排空。\n自表因存照，虽多不暖风。\n偶缘膏火尽，得到兀窗中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17471,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即事","author":"王洋","text":"官闲久愧叨祠廪，身幸真堪学种瓜。\n月给郡仓三斛米，日寻山路一川花。\n盘空婢去催烧笋，炉暖妻来趁焙茶。\n阅尽邻僧闲况味，官供粥饭胜僧家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17472,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"李丞相挽章 其二","author":"王洋","text":"风云扶日月，尧舜正衣裳。\n壮烈周方叔，从容汉子房。\n鼎彝酬钜业，典礼贲幽光。\n怅望它山远，千年绿野堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17473,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"李丞相挽章 其一","author":"王洋","text":"名纪三朝重，身居百辟师。\n华夷占用否，进退繫安危。\n见梦英灵在，成功命数奇。\n出师身已老，垂泪忆当时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17474,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杜倅再示前韵继之二首 其二","author":"王洋","text":"不惜分馀为借光，情同结客少年场。\n谁知亲拜六篇语，全胜摇闻十里香。\n自叹满头频献白，敢言三俎欲怀黄。\n一瓶一钵烟波里，径入苕溪向水央。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17475,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杜倅再示前韵继之二首 其一","author":"王洋","text":"惭愧诗筒数往回，自嫌局促困驽材。\n尘踪已挂旧官壁，妙语犹随新雨来。\n好客共谋良夜醉，养花长得四时开。\n知君客里犹行乐，端为襟怀不染埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17476,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杨仲承秘书蹉跎三年今得荣州文学冬日贻书以诗答之","author":"王洋","text":"昔年曾叹小差池，官带荣名自有时。\n二火并光君有渐，一茅覆屋两相宜。\n心田自乐缘知足，世路无求亦少思。\n好是一丘藏曲折，也无邻里共追随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17477,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秀实再用前韵惠诗再答 答见赠","author":"王洋","text":"身似鹪鹩寄远林，仍将病骨卜晴阴。\n有情缘堕有情法，无处云知无处心。\n棋对僧窗时自纵，诗传人口不堪吟。\n感君裁鉴多清赏，收拾焦桐爨下琴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17478,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秀实再用前韵惠诗再答 答自述","author":"王洋","text":"声驰南国秀千林，逸气终疑困华阴。\n病任烧空不烧火，诗唯传句不传心。\n当年宗鲁江西梦，异日睎颜洛下吟。\n直把风流付丘壑，真如封锁匣中琴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17479,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秀实惠简问闲居消息有滴水滴冻之语以诗报之 其一","author":"王洋","text":"气血扶舆梦幻身，用多补少不调匀。\n如今滴水滴冻客，便是贪花贪酒人。\n发白容衰争早晚，官荣家富费精神。\n空花若解揩摩尽，方识人间一笑春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17480,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秀实惠简问闲居消息有滴水滴冻之语以诗报之 其二","author":"王洋","text":"晨钟斋鼓住僧园，纵不陪堂已一般。\n恐为因缘略相似，若无消息自难安。\n乐为苦本宜先戒，病是良医要好看。\n为问炉香经卷外，有无尘妄更相干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17481,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"近闻直学冯子容以家产中丘乘之赋作诗戏之","author":"王洋","text":"千古茫茫不可攀，仲尼日月照儒关。\n生前冷灶七日火，身后遗基十万间。\n宁许富儿通市籍，只求贤士共欢颜。\n那知等级输邦计，亦许颜原见一班。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17482,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"还许推诗轴","author":"王洋","text":"好在东安解戍瓜，归怀珠璧慰生涯。\n翰林词伯梦中草，粉署仙郎笔下花。\n已间箫韶还政俗，未持旌节自光华。\n邦人故眼应回首，诗律传芳又一家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17483,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"还龟溪成拙句呈给事刘兄","author":"王洋","text":"上春日暮暮春头，翠浅芳浓草色柔。\n五十日天和暖候，一帆风地往来舟。\n棋神得隽惊逢敌，酒病寻医尚入流。\n只有风流动文采，较量沈谢亦推刘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17484,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闲中即事","author":"王洋","text":"虫有鋋矛兽有戈，江中飞燕避淘河。\n点红翡翠飞传锦，展翅鸬鹚卧晒蓑。\n绝境芳菲时唤客，隔林机杼夜催梭。\n平生约略闲忙境，到底闲中得较多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17485,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陈长卿凌季文自弋阳寄酒曲以诗谢之","author":"王洋","text":"六十行年两鬓苍，兴来犹爱引杯长。\n黄翁垆下山河远，酒母车来驿传香。\n碧落侍郎烧鼎诀，粉闱仙客驻颜方。\n三斟卯饮心无事，一枕亡何是故乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17486,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和尹少稷上元 其一","author":"王洋","text":"年少轻衫竞彩霄，老翁心地寄参寥。\n照人灯火成何事，示我威仪贵不恌。\n闲却剪刀寻断梦，任随锦毂纵华镳。\n固知行乐承恩泽，亦喜丰年乐一瓢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17487,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和方智善两色梅","author":"王洋","text":"春到冬馀去住间，玉楼无处不轻寒。\n鲜鲜魏女履下履，粲粲真妃冠上冠。\n眼乱互摇歌扇羽，心惊添著粉闱襕。\n东君厚薄非无意，一种馨香两眼看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17488,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和圣求","author":"王洋","text":"桃花人面共春风，人去桃花自笑红。\n撩乱絮飞春物后，依稀云散梦魂中。\n莺迁是处皆良友，蝶化知谁是主翁。\n莫讶求仙杳无信，卖花人过小桥东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17489,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和平甫","author":"王洋","text":"八节滩头老醉吟，年来愁也不胜禁。\n须知到处难忘酒，有意来时且抱琴。\n欲与君游忘世虑，若非吾事莫关心。\n相期早晚尘缘外，共访毗耶听梵音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17490,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和仲嘉示秀实","author":"王洋","text":"去秋九日失归期，今度花前又过时。\n唤客便宜倾凿落，与谁同伴插酴醾。\n新甘未厌松江鲙，敏捷先酬季父诗。\n莫道野翁无食品，葵羹烂煮亦偏宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17491,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和吉父示送别七言","author":"王洋","text":"景物随人也解愁，年来谖草不忘忧。\n微官自缚敢辞冷，倦鸟纵归何处投。\n一岁又闻禾黍熟，百年惟喜甲兵休。\n人生佳节真难遇，莫惜重阳菊满头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17492,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和吉父还谹父诗","author":"王洋","text":"病折丹心一寸灰，犹怜花月照云罍。\n碧腴既许投交分，黄菊从教却放开。\n上客醉时花婀娜，绮筵歌罢月迟徊。\n白头贺监频三请，好客从前招不来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17493,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和吉父赋随字韵","author":"王洋","text":"此生休戚已前期，命薄天公不可移。\n一饮且同今日醉，数篇曾见古人诗。\n青山招我成长计，白发欺人亦太痴。\n莫与老翁疑甲子，当年犹记会沙随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17494,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和吉父赠谹父诗","author":"王洋","text":"疟有黎邱竞出奇，操矛不报主人知。\n问渠去处终无定，与我周旋便有期。\n贫似渊明犹爱酒，瘦如工部只缘诗。\n但教酒入无功社，何用诗称国士为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17495,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和朱秘校惠诗二首 其二","author":"王洋","text":"短檠灯火几经秋，古远人疏道不侔。\n可惜诗书架三万，不如奴婢橘千头。\n颜回赋禄唯箪食，林类当春亦破裘。\n见说老人怀旧事，梦中吹笛更能不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17496,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和朱秘校惠诗二首 其一","author":"王洋","text":"了了臞儒说旧章，三钟初试楚金良。\n当年尚老君方壮，此道催人意已忘。\n懒逐肥尘规冷炙，甘同贫女借馀光。\n谁家春草能终惠，惆怅还同病乘黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17497,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和江如晦 其一","author":"王洋","text":"萧寺姑分一日光，人生同调稳相当。\n空斋夜语规前哲，带酒论文恐老狂。\n三献三休真琬琰，一前一却笑螳螂。\n君家江左才名旧，会向长涂一振骧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17498,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和江如晦 其二","author":"王洋","text":"妇未生儿先制名，人生适意但随情。\n有无何预它人事，轮奂当期异日成。\n收拾功名须义勇，较量得失是心兵。\n鄙文不用量轻重，久已无心羡世荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17499,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和伯氏二首 其二","author":"王洋","text":"眼见群儿倦走书，明琼忽报涨双鱼。\n造端万绪自成室，迷路多岐要卜居。\n谈氏龟儿门相在，微之道保晓星疏。\n愿翁寿考贻孙子，文有千箱德有舆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17500,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和伯氏二首 其一","author":"王洋","text":"松竹窗边拂简书，芙蓉水伴戏龟鱼。\n雁行千里时一往，蜂得一房聊共居。\n千二百年形骨健，三十六计米盐疏。\n齿牙缺落无衰病，惭愧当年谢幼舆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17501,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和伯氏示儿侄","author":"王洋","text":"屋僻唯宜静，栊疏巧受寒。\n衾光宵献白，炉火昼无丹。\n潦倒投僧梵，依稀似宰官。\n一钱不停蓄，却喜布囊宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17502,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和伯氏别元老赠行","author":"王洋","text":"相见还如相别时，杖头明月旧相随。\n五亭溪下西风静，六合沙边夏日曦。\n洗钵又辞香积饭，传衣仍是雪山儿。\n要须桑下无三宿，不为淮南塞草衰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17503,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和伯氏韵赠王元明元明旧亲予叔行也今死于贼矣 其二","author":"王洋","text":"野树霏烟不傍城，还知高士欲逃名。\n倦投芒屩春随处，笑起孤帆潮又生。\n曾宿客来门不掩，无心人住鸟忘情。\n郊原盛事知多少，出郭当朝共眼明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17504,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和伯氏韵赠王元明元明旧亲予叔行也今死于贼矣 其一","author":"王洋","text":"十分佳处限长淮，人在空明静□猜。\n水北结茅真好去，袖中漫刺为谁来。\n因嗟翳日尘凝榭，更吊沈枪卧绿苔。\n多少平岗绕淮路，分明逐处是池台。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17505,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和吴朝议 其二","author":"王洋","text":"自是天公亦厌艰，十年战士好休闲。\n胡儿弓射燕陲月，汉将心驰海上山。\n庆事频闻输帝府，好音传落到人间。\n丈人自是朝廷旧，早趁鹓鸾入近班。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17506,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和吴朝议 其一","author":"王洋","text":"小说风烟已自佳，前峰矗矗为盘牙。\n千重岩壑名卿宅，一簇楼台刺史家。\n自愧虚凉无物望，难将术业向人誇。\n所闻政绩刊金石，刻画无盐学篆沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17507,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张中大 其二","author":"王洋","text":"忆昔开元夜宴图，锦为方丈玉为壶。\n但誇北里楼吹笛，谁问长安米胜珠。\n事去牵连难雪耻，愁来陪奉长霜须。\n兔园岩穴皆时彦，一斗青精过刻符。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17508,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张中大 其一","author":"王洋","text":"天作长绡玉作图，恍然身世在冰壶。\n岁期共饱如颁粟，瑞要均行胜得珠。\n未办五湖扬短艇，且谋双鲤唤长须。\n清朝不要培芝菌，正好称觞颂正符。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17509,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和李商隐赋红梅 其一","author":"王洋","text":"公主檐间睡起时，匀红行绕大安池。\n北人未识春迷眼，妃子偏怜酒入肌。\n更若施朱疑太赤，不须生女白如脂。\n由来风骨都相似，岂为丹青别赋诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17510,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和李商隐赋红梅 其二","author":"王洋","text":"梅蕊年年破腊时，玉花飞舞集鸾池。\n独将艳色添真色，任尔冰肌映雪肌。\n带恨不妨红作泪，洗妆终见白凝脂。\n可怜渠有风流句，只作歌词不作诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17511,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和秀实","author":"王洋","text":"十风九雨一春除，散绿留红證夏初。\n心事自应随念远，年华未省向人疏。\n欲开胸次犹须酒，泛若因缘却为书。\n饱满盘天久无望，良规真恐在污渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17512,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和秀实别寄二篇 其二","author":"王洋","text":"香火社闲棋度日，溪山伴静酒为年。\n碧霄鹤唳诗情远，湖院僧知茶梦圆。\n常喜春锄行佚老，每嫌棋路尚争先。\n平湖草岸经行好，后夜延缘刺钓船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17513,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和秀实别寄二篇 其一","author":"王洋","text":"世德联绵自汉朝，元功当日说萧曹。\n营分细柳威名重，笑指飞烟量度高。\n文挟素勋谁与敌，诗推馀事尚称豪。\n了知三阮逃名久，恐被名牵未可逃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17514,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和秀实寄尹商老见访","author":"王洋","text":"二千里外命车轮，慰我言词字字新。\n自向江西逢隐吏，方知物外有高人。\n频将篇什收风月，怠整形仪作搢绅。\n相对茅檐终日语，从教人道是沉沦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17515,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和秀实扉字韵","author":"王洋","text":"柴车朝出莫柴扉，麋鹿情通麋鹿知。\n寓目每因思旧约，破颜时幸读新诗。\n妻儿债负真冤境，祖佛因缘即妙医。\n救火抱薪还止火，只嫌虚幻没休时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17516,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和邵尧夫韵示儿侄","author":"王洋","text":"言贵安徐行贵常，与人平淡勿相伤。\n莫贪顺路行时快，到了回思见去长。\n克已定知天降福，害人只是自贻殃。\n长教言行枢机密，此外虚心不用防。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17517,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和陈长卿赋芭蕉二首 其二","author":"王洋","text":"一幅青天世外珍，诗人得句共清新。\n书生几上侧理纸，巫女庙中巴峡神。\n长恐天寒凭日暮，不将翠袖染缁尘。\n世间荷叶并蕉叶，不与红芳竞占春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17518,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和陈长卿赋芭蕉二首 其一","author":"王洋","text":"落落虚怀好自珍，一番舒展一番新。\n摇风捲起窗铺月，滴雨惊回梦怆神。\n荔子丹时陪献豆，丁香结处共愁尘。\n本无颜色争韶艳，野老由来不怨春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17519,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和叔颖楮衾","author":"王洋","text":"自顾生来骨相屯，不容强觅綵衣轻。\n荣华地位无多子，寂寞因缘已半生。\n我拥素衾方自喜，君贻组句遂兼荣。\n书窗对榻仍摇腹，谁道挑灯梦不成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17520,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和周仲嘉再示三篇 其一","author":"王洋","text":"旧日衣冠说武林，风流曾不减山阴。\n百年人物千山秀，万里功名天下心。\n族姓人人誇盛事，溪山处处称高吟。\n后生欲听清商曲，莫学无弦只抚琴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17521,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和周仲嘉再示三篇 其二","author":"王洋","text":"花有芳丛竹有林，春来各竞趁光阴。\n妍媸等是目前事，冷淡方知异日心。\n十二里山长隔面，一帆风地每传吟。\n高山流水人知否，绿绮窗间自晓琴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17522,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和周仲嘉再示三篇 其三","author":"王洋","text":"长篇大轴势如林，慰我穷愁正结阴。\n数首娱忧兼寓物，几人对面便知心。\n多求笔吏供濡墨，剩买筠筒给浩吟。\n闲静心情如此少，能听贺若是知琴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17523,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和知字韵二篇 其二 答寄赠","author":"王洋","text":"全无客到掩庵扉，冷暖心肠袛自知。\n贫欠饭租难乞米，午亏睡课且裁诗。\n已伤刃自惊逢敌，多病人难更说医。\n强半工夫付诗轴，独惭骑吏立门时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17524,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和知字韵二篇 其一 答解嘲","author":"王洋","text":"春来秋去锁烟扉，此境人间不易知。\n强遣忧愁须藉酒，巧传消息却因诗。\n生缘有累难除药，性本无为不用医。\n苦乐从来略相对，乘车须记饭牛时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17525,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和郑丈戏赠谹父","author":"王洋","text":"生疏僮仆贱，颜色病妻同。\n定有明人眼，真烦寿乃翁。\n仙曹歌法曲，词伯缀秋风。\n不是人间谱，霓裳堕月中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17526,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和郑贰卿别赋","author":"王洋","text":"病逐秋风至，年随塞草衰。\n家如百年梦，身入四愁诗。\n北焙联圭璧，南薰润岳池。\n斋房多胜事，可但滑琉璃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17527,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和春雨韵 其一","author":"王洋","text":"客路元来促，春情本自长。\n送愁谁纳款，遣癖又无方。\n失性陪飘雪，凋颜自染霜。\n吟君春雨句，萦拂为牵肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17528,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和春雨韵 其二","author":"王洋","text":"荣辱一时梦，浮生百种心。\n愚因难化稳，懒为不治深。\n分退何须卜，贪高每自斟。\n须君说情话，泽畔欲行吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17529,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和赵倅兼善观徐园诗","author":"王洋","text":"雨闇长亭去驿赊，褰帷那免叹年华。\n应缘问俗颁温诏，却得名园看好花。\n晴入郊圻初浩荡，春随杖屦得津涯。\n仙郎不解收珠玉，别乘归时载满车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17530,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和徐思远韵","author":"王洋","text":"几叶文章开一花，布裘中句已名家。\n无心于世苦亡赖，生子如郎定可誇。\n行矣斋房思贾传，莫将高论诋王嘉。\n冥鸿一去自千里，寂寞沙村只望涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17531,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和谹父小雨秋凉","author":"王洋","text":"时丰报祀拂黄收，共说金穰更几秋。\n树染烟浓山着色，月临天迥水明楼。\n盈囷黍答三时力，七字诗销万斛愁。\n饱饭哦诗醉山月，不妨归老一扁舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17532,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和谹父问讯吉父 其二","author":"王洋","text":"困臂知三折，攻顽费七旬。\n不闻覆杯水，能救一舆薪。\n俗傲轩辕圣，巫誇越女神。\n百年勾漏术，触处白头新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17533,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]