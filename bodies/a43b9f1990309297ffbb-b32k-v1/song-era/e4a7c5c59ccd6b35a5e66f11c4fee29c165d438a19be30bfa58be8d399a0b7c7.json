[{"title":"喜才元过洛小诗招饮","author":"司马光","text":"素发各垂领，旧交相见稀。\n不唯春物好，况是锦衣归。\n洛社冻醪熟，伊鲂丝鲙肥。\n南轩已洒扫，命驾不须违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24480,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜张圣民得登州","author":"司马光","text":"昼日少闲暇，中宵梦亦劳。\n符移空浩浩，榜楚镇謷謷。\n敢说今求郡，番思昔坐曹。\n羡君乘五马，东去一何高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24481,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜孙器之来自共城","author":"司马光","text":"取友不无人，爱君天性真。\n远寻穷巷宅，未拂满衣尘。\n主礼贫尤重，交情别更亲。\n谁家酿醇酒，尽醉准衣巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24482,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜雨三首呈景仁侍郎兼献大尹宣徽 其一","author":"司马光","text":"累日增烦暑，通宵结薄阴。\n苍茫变风色，散漫作春霖。\n野店垂杨重，僧房绿筱深。\n疏慵尤得趣，闭户拥重衾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24483,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜雨三首呈景仁侍郎兼献大尹宣徽 其三","author":"司马光","text":"麦田正尘坌，桑径忽滂沱。\n比屋起相告，荷锄行且歌。\n园林半扃锁，车马绝经过。\n大尹爱民物，何妨喜更多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24484,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寒食御筵口号二首 其二","author":"司马光","text":"圣主褒优鼎轴臣，金觞玉醴照青春。\n万家烟火朝来静，九陌风光雨后新。\n高燕翔飞惊紫绶，馀光点缀托朱轮。\n问牛因得观民俗，不独嬉游惜令辰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24485,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寒食御筵口号二首 其一","author":"司马光","text":"雨意沉沉泼火馀，夔龙盛集退朝初。\n酒殽络绎来丹禁，冠剑参差下玉除。\n紫凤归飞云烂漫，黄鹂新啭柳扶疏。\n麦禾满野边烽息，佳节何妨赋乐胥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24486,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寒食许昌道中寄幕府诸君","author":"司马光","text":"原上烟芜淡复浓，寂寥佳节思无穷。\n竹林近水半边绿，桃树连村一片红。\n尽日解鞍山店雨，晚天回首酒旗风。\n遥知幕府清明饮，应笑驱驰羁旅中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24487,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寒食南宫夜饮","author":"司马光","text":"积旬留省署，容易度春华。\n芳草踏青晚，长楸行乐赊。\n云疏时送雨，风细暗飞花。\n直有黄金百，无因过酒家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24488,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寓泊郑圃寄献昌言舍人","author":"司马光","text":"旅食缁衣馆，飘蓬恍自迷。\n树横寒雾远，山隐古原低。\n愁暮空庭雀，惊晨别墅鸡。\n故人何处在，依约玉绳西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24489,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"御制后苑赏花钓鱼七言四韵诗一首奉圣旨次韵","author":"司马光","text":"馺娑蜚廉次第开，鸣鞘传跸自天来。\n云随綵仗低临幄，柳压金堤翠入杯。\n槛倚柔风丝缥渺，花翻丽日影徘徊。\n上林春色长如旧，玉辇嬉游岁岁陪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24490,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"御宴送李宣徽知真定府口号","author":"司马光","text":"匈奴旧畏李将军，今日重来几代孙。\n旗尾飘扬山烧裂，马啼腾踏塞尘昏。\n降王稽颡朝南阙，天子垂衣御北门。\n幕府事闲刁斗静，碧潭佳景日开樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24491,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"御筵送李宣徽知真定府","author":"司马光","text":"秋风萧瑟引华旌，祖宴高张出斗城。\n玉馔芳菲罗百铁，绣衣照耀拥千兵。\n骊歌未阕长杨苑，骑吹先临细柳营。\n雨露醲恩何以报，沙场不惜树功名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24492,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"景仁书云去冬因酒病耳病牙遂不入洛以诗寄呈","author":"司马光","text":"许昌携手尽时英，况复新开甲第成。\n醉里都将春作达，老来不向酒藏情。\n齿疏无废衔杯趣，耳病犹分度曲声。\n旧友昔游浑忘却，可怜寂寂洛阳城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24493,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"景仁招游东园马上口占","author":"司马光","text":"适野自可爱，况逢佳主人。\n马穿官柳影，衣拂帝城尘。\n物外谁知乐，樽前别有春。\n年华己消歇，历历见松筠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24494,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"御沟 未开木芙蓉","author":"司马光","text":"木末采芙蓉，骚人歌所无。\n何言霜花艳，不与水芝殊。\n香苞麝脐结，茂叶桐阴敷。\n岂若龟巢类，飘零老五湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24495,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"景福东厢诗 夜意","author":"司马光","text":"清夜四无哗，深严上帝家。\n星翻珠网白，斗挂玉楼斜。\n风静虚成韵，霜轻未作花。\n还疑汉津客，浩荡寄流槎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24496,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"御沟 读武士策","author":"司马光","text":"汉家求猛士，云集未央宫。\n天外朝星淡，山西将种空。\n奇谋纷并进，壮节凛生风。\n八阵纵横势，依然见目中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24497,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"御沟 菊","author":"司马光","text":"琐琐南阳菊，秋潭岁自开。\n孤根拥红叶，落蕊媚苍苔。\n正以参灵药，因之植紫台。\n愿兼金掌露，同入柏梁杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24498,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"御沟","author":"司马光","text":"万户郁相钩，枝分瑟瑟流。\n萦纡通桂观，隐见带龙楼。\n碧映千林曙，红飘一叶秋。\n寒波长不竭，岁岁奉宸游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24499,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"御沟 赐酒","author":"司马光","text":"和气盈金榼，恩光湛玉觞。\n应知北山羽，犹怯上林霜。\n醇味回秋色，清都近醉乡。\n山茅沾雨露，誓极寸心长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24500,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游三门开化寺","author":"司马光","text":"山石古来色，河流无尽声。\n行船自往返，群木几枯荣。\n狂象调难伏，空华灭复生。\n我来何所得，聊此濯尘缨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24501,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游山呈景仁","author":"司马光","text":"我禄多龚舍，君年少孔戣。\n道心闲始见，世路老方知。\n山水不相厌，风光难豫期。\n嬉游不可缓，花卉即离披。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24502,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游延安宿马太博东馆","author":"司马光","text":"高馆寂无哗，安闲胜在家。\n暮烟凝塞上，堠火落天涯。\n坐久笔生冻，夜阑灯作花。\n主人意未尽，归路不为赊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24503,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游李卫公平泉庄","author":"司马光","text":"相国已何在，空山馀故林。\n向时堪炙手，今日但伤心。\n陵谷尚未改，门阑不可寻。\n谁知荆棘地，鹤盖旧成阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24504,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游瀍上刘氏园","author":"司马光","text":"日暖孤台迥，露浓幽径微。\n茅斋举白饮，沙溆踏青归。\n照水清满眼，穿林香湿衣。\n莫言春尚浅，已有杏花飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24505,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湖上村家","author":"司马光","text":"万顷寒烟外，茅茨枕碧流。\n枫林巢乳鹤，沙溆乱鸣鸥。\n漠漠菰蒲晚，苍苍芦荻秋。\n欲过南浦去，篱下出渔舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24506,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答刘原父贺庞公惠炭","author":"司马光","text":"东郭先生履半穿，禦冬深愧主人贤。\n应怜道上雪欲积，意使炉中灰复然。\n曲糵暗添寒酒力，图书共免湿薪烟。\n茅斋斗似饶光彩，客至何忧腊后天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24507,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答张伯常之郢州涂中见寄","author":"司马光","text":"适意遗轩冕，轻于鸿一毛。\n扁舟千里远，佳句百篇豪。\n酒饮宜城美，歌闻白雪高。\n家林已春色，慎勿滞江皋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24508,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答陈进士谓之忆江东旧游见赠","author":"司马光","text":"客路今东去，亭皋木叶飞。\n居然不堪恨，况与赏心违。\n顾渚烟波阔，长洲草树微。\n江边好春色，行望锦标归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24509,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"紫微石舍人挽歌二首 其二","author":"司马光","text":"顾我非君比，最为相得欢。\n平生游处久，美行始终完。\n长夜忍埋玉，秋霜不借兰。\n西风湿襟袖，空有泪阑干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24510,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"紫微石舍人挽歌二首 其一","author":"司马光","text":"地胜岷峨秀，时清隽乂生。\n扬雄晚得禄，何武少知名。\n性有图书癖，心忘绂冕荣。\n前年归谕蜀，不使里人惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24511,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"塞上 其四","author":"司马光","text":"剑客苍鹰队，将军白虎牙。\n分兵逻圁水，纵骑猎鸣沙。\n浪有书藏袖，难凭信达家。\n不堪闻晓角，吹尽落梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24512,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"塞上 其一","author":"司马光","text":"节物正防秋，关山落叶稠。\n霜风壮金鼓，雾气湿旌裘。\n未得西羌灭，终为大汉羞。\n惭非班定远，弃笔取封侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24513,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"塞上 其三","author":"司马光","text":"瀚海秋风至，萧萧木叶飞。\n如何逢汉使，犹未寄征衣。\n不叹千里远，难甘一信稀。\n年年沙漠雁，随意得南归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24514,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"塞上 其二","author":"司马光","text":"鸿雁秋先到，牛羊夕未还。\n旌旗遥背水，亭堠远依山。\n落日衔西塞，阴烟澹北关。\n何时献戎捷，鞍甲一朝闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24515,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"感兴寄聂之美","author":"司马光","text":"平生百无可，强为一官縻。\n世味偏予薄，心期独子知。\n林猿愁玉琐，枥马患金羁。\n年事今华发，求荣欲为谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24516,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"感物","author":"司马光","text":"朝看新燕飞，暮听子规啼。\n尺蠖身藏叶，神龟尾曳泥。\n韝鹰何用掣，枥马不当嘶。\n自伐憎狙巧，颓然忧木鸡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24517,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"新买叠石溪庄再用前韵招景仁","author":"司马光","text":"一溪清水佩声寒，两岸莓苔锦绣斑。\n三径谁来卜邻舍，千峰我已作家山。\n鹿裘藜杖偏宜老，紫陌红尘不称闲。\n早挈琴书远相就，放歌烂醉白云间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24518,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"睢阳五老图","author":"司马光","text":"图谋已就乐时闲，晓向田园喜脱冠。\n心志不灰犹有策，星长还在尚无桓。\n朝阳鸣凤身轻暖，赴壑刚蛇齿健寒。\n仪表珍藏传不朽，每于清士敬持看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24519,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"辞坟","author":"司马光","text":"十年一展墓，旬浃复东旋。\n岂负襁褓爱，横遭章绶缠。\n更来知几日，遗恨恐终天。\n恸哭出松径，悲风为飒然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24520,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鄜州怀聂之美","author":"司马光","text":"何言内外家，忧患两如麻。\n别泪行三岁，思心各一涯。\n海边昏雾雨，塞外惨风沙。\n安得云飞术，乘空去不遐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24521,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"酪羹","author":"司马光","text":"军厨重羊酪，飨士旧风传。\n不数紫莼滑，徒誇素鲔鲜。\n?蠡烦挏取，勺药助烹煎。\n莫与吴儿说，还令笑茂先。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24522,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"酬不疑雪中书怀见寄","author":"司马光","text":"直道免三黜，敢云羞小官。\n盘餐红粟涩，衣桁黑貂寒。\n画府容身易，侯门曲意难。\n荆扉盈尺雪，有客问袁安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24523,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"酬师道雪夜见寄","author":"司马光","text":"玉树交横雪后天，银河沉着斗栏干。\n笔峰微结冰丝涩，灯晕初成花烬残。\n太学先生毡苦薄，公车倦客履仍单。\n欲吟佳句到清晓，夜寂愁闻金石寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24524,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"酬君贶和景仁对酒见寄三首 其一 上宣徽","author":"司马光","text":"懒拙无时用，耆朋独我思。\n乘闲同把酒，道旧各成诗。\n高义刮眼膜，清风生鬓丝。\n方将激衰俗，贱子实何为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24525,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"酬君贶和景仁对酒见寄三首 上侍中","author":"司马光","text":"何事挂冠客，至今留帝台。\n红尘终可厌，青眼不长开。\n春路半消雪，寒枝初破梅。\n南园虚客席，洒扫望公来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24526,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"酬君贶和景仁对酒见寄三首 其二 上宣徽","author":"司马光","text":"北阙黄金印，西山白发翁。\n吁谟帝廷异，小筑洛川同。\n晴野峰峰碧，霜林叶叶红。\n无因侍樽席，惆怅又秋风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24527,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"酬宋叔达卜居洛城见寄","author":"司马光","text":"离群四十一春风，纵有相逢似梦中。\n幸得相逢作邻舍，但嗟彼此是衰翁。\n汉文前席人将去，庾信诛茅橐未充。\n怅望金堤碧芜阔，杖藜携手几时同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24528,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"酬张二十五秀才南园遣意","author":"司马光","text":"花卉日相续，朝昏兴寄新。\n露荷香入坐，风竹净无尘。\n啸咏皆群从，喧嚣远四邻。\n须知轩冕客，富贵不关身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24529,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"酬张三十秀才见赠","author":"司马光","text":"朴学居人后，清涂忝众先。\n瓠因无用弃，木为不才全。\n比得林泉趣，仍依邑里贤。\n自惭头半白，方解赋归田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24530,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"酬邵尧夫见示安乐窝中打乖吟","author":"司马光","text":"安乐窝中自在身，犹嫌名字落红尘。\n醉吟终日不知老，经史满堂谁道贫。\n长掩柴荆避寒暑，只将花卉记冬春。\n料非空处打乖客，乃是清朝避世人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24531,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"酬终南阎谏议见寄","author":"司马光","text":"齿衰心力耗，揣分乞西台。\n微禄供多病，闲官养不才。\n弊庐容啸傲，清洛伴归来。\n故友犹相念，寒光生死灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24532,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"酬仲通初提举崇福宫见寄","author":"司马光","text":"富寿安民旧学违，符移拥笔素心非。\n青云有路那足顾，白发满头胡不归。\n永日杜门无俗客，临风隐几得天机。\n西山爽气秋应好，恨不相从上翠微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24533,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"臧郎中挽歌二首 其二","author":"司马光","text":"素履存诚厚，虚怀待物真。\n乡闾昔相接，朋友世弥亲。\n遗札蝇头细，长阡马鬣新。\n九原那可作，空复想音尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24534,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"臧郎中挽歌二首 其一","author":"司马光","text":"积庆承前烈，呈才会圣时。\n践杨朝有籍，治行吏为师。\n僚友皆亲誉，黎民每去思。\n惜哉违世早，志业未全施。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24535,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题传灯录","author":"司马光","text":"呷著声闻酒便狂，它州浪走不归乡。\n谁曾缚汝安用解，彼自无创勿误伤。\n探月拾针传妄语，安居暇食赖先王。\n但令时世如三代，达磨从他面向墙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24536,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题杨中正供奉洗心堂","author":"司马光","text":"阀阅盛山西，朱门飏戟衣。\n雅知名教乐，深笑宴游非。\n一室琴书隘，三年园圃稀。\n异时论事业，肯复让轻肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24537,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题陈秀才园林","author":"司马光","text":"剧谈惊满座，音貌独琅然。\n可惜郦生老，谁知苏季贤。\n青囊世外药，碧幕醉中天。\n不佩黄金印，都缘负郭田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24538,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题致仕李太傅园亭","author":"司马光","text":"汉家飞将种，气概耿清秋。\n解去金貂贵，来从洛社游。\n清商拥高宴，华馆带长流。\n可笑班超老，崎岖万里侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24539,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠太子太傅康靖李公挽歌词二首 其二","author":"司马光","text":"卤簿去悠悠，西郊乱叶秋。\n旐翻寒日薄，笳咽断云愁。\n吊客门飞鹤，佳城山卧牛。\n灵车今不返，洧水日东流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24540,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠太子太傅康靖李公挽歌词二首 其一","author":"司马光","text":"黄发今彫丧，苍生欲奈何。\n散金才极乐，曳杖已成歌。\n十郡馀恩在，三台故吏多。\n位崇仍有后，五福更为多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24541,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠吴之才","author":"司马光","text":"胜冠自立艰难里，大器由来贵晚成。\n松柏傥非生磊落，岩崖何易出峥嵘。\n苏秦游困羞妻嫂，主父居贫厌弟兄。\n六印佗年拥车骑，会须重过洛阳城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24542,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠学仙者","author":"司马光","text":"微径透重峦，茅堂竹叶冠。\n方瞳映骨静，秀气逼人寒。\n夜火装丹灶，晴霜醮石坛。\n不须惊浅俗，轻举入云端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24543,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠河中通判朱郎中","author":"司马光","text":"陟屺今将老，扶床昔未行。\n旨甘无所展，朱紫不为荣。\n里巷传呼入，比邻失涕惊。\n方知贯金石，何以易精诚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24544,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠狄节推","author":"司马光","text":"天马云孙在，终然骨相奇。\n泥涂辱虽久，霜雪志难移。\n白发无嗟老，青衫莫厌卑。\n为山已九仞，高节肯中衰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24545,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠清衍","author":"司马光","text":"我厌俗缘苦，空为薄宦牵。\n如师真达者，于世亦超然。\n敝笠冲尘陌，寒云拥雪天。\n崎岖远相顾，深愧此心专。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24546,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠楚法曹叔度","author":"司马光","text":"夫君能直节，不耻杨曹轻。\n道果因时屈，官无当已荣。\n松杉虽偃蹇，霜霰苦峥嵘。\n会有良工识，终观大器成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24547,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]