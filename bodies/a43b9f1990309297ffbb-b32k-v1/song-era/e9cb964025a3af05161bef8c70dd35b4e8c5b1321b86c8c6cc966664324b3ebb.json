[{"title":"喜乐吟","author":"邵雍","text":"生身有五乐，居洛有五喜。\n人多轻习常，殊不以为事。\n吾才无所长，吾识无所纪。\n其心之泰然，奈何人了此。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3949,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜欢吟","author":"邵雍","text":"平生喜饮酒，饮酒喜轻醇。\n不喜大段醉，只便微带醺。\n融怡如再少，和煦似初春。\n亦恐难名状，两仪仍未分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3950,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜饮吟","author":"邵雍","text":"尧夫喜饮酒，饮酒喜全真。\n不喜成酩酊，只喜成微醺。\n微醺景何似，襟怀如初春。\n初春景何似，天地才絪纭。\n不知身是人，不知人是身。\n只知身与人，与天都未分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3951,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寒夜吟","author":"邵雍","text":"天加一上寒，我添一重被。\n不出既往言，不为已甚事。\n责己重以周，与人不求备。\n唯是大圣人，能立无过地。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3952,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"属事吟","author":"邵雍","text":"鹪鹩分寄一枝巢，不信甘言便易骄。\n当力尚难超北海，去威何足动鸿毛。\n愿将情意分明谢，肯把恩光取次烧。\n天宠居多为幸久，春花无奈正夭饶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3953,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"悲怒吟","author":"邵雍","text":"多怒伤人气，多悲伤人心。\n□□□□□，伤心为害深。\n害浅药易治，害深药难任。\n谁能知未病，何药能相寻。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3954,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游山二首 其二","author":"邵雍","text":"二室多好峰，三川多好云。\n看之不知倦，和气潜生神。\n一虑若动荡，万事从纷纭。\n人言无事贵，身为无事人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3955,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游山二首 其一","author":"邵雍","text":"洛川多好山，伊川多美竹。\n游既各有时，虽频无倦目。\n贪清非伤廉，渎幽不为辱。\n麋鹿不害人，心无害麋鹿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3956,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游海棠西山示赵彦成","author":"邵雍","text":"东风吹雨过溪门，白白朱朱乱远村。\n滩石已无回棹势，岸枫犹出系船痕。\n时危不厌江山僻，客好惟知笑语温。\n莫上南冈看春色，海棠花下却销魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3957,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登山临水吟","author":"邵雍","text":"山有乔峰水有涛，未能容屐岂容舠。\n非无仁智斯为乐，少有登临不惮劳。\n言味止知甘脍炙，语真谁是识琼瑶。\n自惭不尽人才处，长恨今人论太高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3958,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登封县宇观少室","author":"邵雍","text":"天地始融结，此山已高极。\n群峰拥旌幢，巨石罗剑戟。\n日出崖先红，雨馀岚更碧。\n安知无神仙，其间久遁迹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3959,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答人书","author":"邵雍","text":"卿相一岁俸，寒儒一生费。\n人爵固不同，天爵何尝匮。\n不有霜与雪，安知松与桂。\n虽无官自高，岂无道自贵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3960,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答人书言","author":"邵雍","text":"无位立事难，逢时建功易。\n求全自有毁，举大须略细。\n去恶虑伤恩，存恶忧害义。\n徒有仁者心，殊无仁者意。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3961,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答人书意","author":"邵雍","text":"仲尼言正性，子舆言践形。\n二者能自得，殆不为虚生。\n所交若以道，所感若以诚。\n虽三军在前，而莫得之凌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3962,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答友人","author":"邵雍","text":"何者名为善处身，非惟能武又能文。\n可行可止存诸己，或是或非系在人。\n遍数古来贤所得，历观天下事须真。\n吉凶悔吝生乎动，刚毅木讷近于仁。\n易地皆然休计较，不言而信省开陈。\n虽居蛮貊亦行矣，无患乡闾情未亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3963,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答客吟","author":"邵雍","text":"说者从来太过乎，道须能卷又能舒。\n人间好事不常有，天下奇才何处无。\n年近从心唯策杖，诗逢得意便操觚。\n快心亦恐诗拘束，更把狂诗大字书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3964,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答傅钦之","author":"邵雍","text":"芝兰在室，不能无臭。\n金石振地，不能无声。\n恶则哀之，哀而不伤。\n善则乐之，乐而不淫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3965,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答富郑公见示正旦四绝","author":"邵雍","text":"正旦四篇诗，缘忻七十期。\n请观唐故事，未放晋公归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3966,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"策杖吟","author":"邵雍","text":"策杖南园或北园，春来尤足慰衰年。\n初晴天气上元后，乍暖风光寒食前。\n池岸微微装嫩草，林梢薄薄罩轻烟。\n东君此际情何厚，非象之中正造妍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3967,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"落花长吟","author":"邵雍","text":"以酒战花秾，花秾酒更浓。\n花能十日尽，酒未百壶空。\n尚喜装衣袂，犹怜坠酒钟。\n多情唯粉蝶，薄倖是游蜂。\n减却墙头艳，添为径畔红。\n飘零深院宇，点缀静帘栊。\n又恐随流水，仍忧嫁远风。\n水流犹委曲，风远便西东。\n狼籍残春后，离披晚照中。\n亭台虽有主，轩骑断无踪。\n剑去拥妃子，兵来围石崇。\n马嵬方恋恋，金谷正匆匆。\n曹植辞休切，襄王梦已终。\n谬称寻洛浦，浪说数巫峰。\n燕诉冤还在，莺传信莫通。\n苔钱如可买，柳线自能缝。\n怅望尤真宰，凄凉殢化工。\n放教成烂漫，不使略从容。\n命扫心争忍，言收计遂穷。\n异香销骨髓，绝色死英雄。\n任诧回天力，饶矜盖世功。\n奈何时既往，到了事难重。\n开谢形相戾，兴衰理一同。\n天机之浅者，未始免忡忡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3968,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"落花吟","author":"邵雍","text":"万紫千红处处飞，满川桃李漫成蹊。\n狂风猛雨日将暮，舞榭歌台人乍稀。\n水上漂浮安有定，径边狼籍更无依。\n流莺不用多言语，到了一番春已归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3969,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"芳草短吟","author":"邵雍","text":"花间水畔绿如茵，兴废曾经汉与秦。\n占了山川无限地，愁伤今古几何人。\n严霜杀尽还逢雨，野火烧残又遇春。\n不那路傍多此物，农家长是费耕耘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3970,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢人惠石笋","author":"邵雍","text":"谁将天柱峰，快刀割一半。\n泉漱痕微清，云抱色犹见。\n权门不能移，富室不能转。\n则予何人哉，当阎君之献。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3971,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢宁寺丞惠希夷樽","author":"邵雍","text":"仙掌峰峦峭不收，希夷去后遂无俦。\n能斟时事高抬手，善酌人情略拨头。\n画虎不成心尚在，悲麟无应泪横流。\n悟来不必多言语，赢得清闲第一筹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3972,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢安之少卿用始知安是道梯阶","author":"邵雍","text":"窝名安乐直堪咍，臂痛头风接续来。\n恰见安之便安乐，始知安是道梯阶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3973,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢君实端明诗","author":"邵雍","text":"人说昆崙多美玉，世传沧海有明珠。\n世传人说恐无据，今我家藏乃不虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3974,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢宋推官惠白牛","author":"邵雍","text":"毛如霜雪眼如朱，耳角方齐三尺馀。\n状异不将耕旷土，性驯宜用驾安车。\n水边牧处龙能扰，月下牵时兔可驱。\n从此洛阳图㡠上，丹青人更著功夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3975,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢城南张氏四弟兄冒雪载肴酒见过","author":"邵雍","text":"久旱几逾冬，川守祈未得。\n雁行联镳来，佳雪遽盈尺。\n酒面生红光，客心喜何极。\n上夜离天津，天津陡岑寂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3976,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢商守宋郎中寄到天柱山户帖仍依元韵 其五","author":"邵雍","text":"无成麋鹿久同群，占籍恩深荷史君。\n万古千今名与姓，得随天柱数峰存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3977,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢傅钦之学士见访","author":"邵雍","text":"长莫长于天，大莫大于地。\n天地尚有极，自馀安足计。\n世态非一朝，人情止于是。\n以至立殊功，无非借巨势。\n适会在其间，慎勿强生事。\n虽严似雪霜，无改如松桂。\n方惜久离阔，却喜由道义。\n相别二十年，犹能记憔悴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3978,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢富相公见示新诗一轴 其二","author":"邵雍","text":"文章天下称公器，诗在文章更不疏。\n到性始知真气味，入神方见妙功夫。\n闲将岁月观消长，静把乾坤照有无。\n辞比离骚更温润，离骚其奈少宽舒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3979,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赏雪吟","author":"邵雍","text":"一片两片雪纷纷，三杯五杯酒醺醺。\n此时情状不可论，直疑天地才絪纭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3980,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"愁花吟","author":"邵雍","text":"三千宫女衣宫袍，望幸心同各自娇。\n初似绽时犹淡薄，半来开处特妖娆。\n檀心未吐香先发，露粉既垂魂已销。\n对此芳樽多少意，看看风雨骋粗豪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3981,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"意未萌于心","author":"邵雍","text":"意未萌于心，言未出诸口。\n神莫得而窥，人莫得而咎。\n君子贵慎独，上不愧屋漏。\n人神亦吾心，口自处其后。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3982,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"感事吟","author":"邵雍","text":"切玉如泥剑不虚，谁知世上有昆吾。\n能言未是真男子，善处方名大丈夫。\n士老林泉诚所愿，民填沟壑谅何辜。\n然非我事我心恻，珍重羲皇一卷书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3983,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"感事吟","author":"邵雍","text":"君子小人正相反，上智下愚诚不移。\n冶葛根非连灵芝，奈何生与天地齐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3984,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"感事吟","author":"邵雍","text":"芝兰种不荣，荆棘剪不去。\n二者无奈何，徘徊岁将暮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3985,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"感事吟","author":"邵雍","text":"古人不见面，止可观其心。\n其心固无他，而多顾义深。\n今人不见心，止可观其面。\n其面顾无他，而多顾利浅。\n顾义则利人，顾利则害民。\n利人与害民，而卒反其身。\n其身幸而免，亦须殃子孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3986,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"感事吟","author":"邵雍","text":"四海三江与五湖，只通舟楫不通车。\n往来无限安平者，岂是都由香一炉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3987,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"摄生吟","author":"邵雍","text":"握固如婴儿，作气如壮士。\n二者非自然，皆出不容易。\n心为身之主，志者气之帅。\n沉珠于深渊，养自己天地。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3988,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"楼上寄友人","author":"邵雍","text":"有客常轻平地春，夫春不得不云云。\n能安陋巷无如我，既上高楼还忆君。\n满眼云林都是绿，万家辉舞半来新。\n凭栏须是心无事，谁是凭栏无事人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3989,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"窥开吟 其十三","author":"邵雍","text":"物理窥开后，人情照破间。\n敢言天下事，到手又何难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3990,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"窥开吟 其八","author":"邵雍","text":"物理窥开后，人情照破初。\n不堪将劝诫，止可与嗟吁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3991,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"触观物","author":"邵雍","text":"万物备吾身，身贫道未贫。\n观时见物理，主敬得天真。\n心净星辰夜，情析草木春。\n自怜斲丧者，能作太平人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3992,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"路径吟","author":"邵雍","text":"面前路径无令窄，路径窄时无过客。\n过客无时路径荒，人间大率多荆棘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3993,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"暮春吟","author":"邵雍","text":"春来小圃弄群芳，谁为贫居富贵乡。\n门外柳阴浮翠润，阶前花影溜红光。\n梁间新燕未调舌，天末归鸿已着行。\n自问心源无所有，答云疏懒味偏长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3994,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"暮春吟","author":"邵雍","text":"多情潘佑羡杨花，出入千家复万家。\n少日壮心都失去，老年新事不知他。\n诗中罪过人多恕，酒里功劳我自誇。\n犹有一般牢落处，交亲太半在天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3995,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"演绎吟 其四","author":"邵雍","text":"何者谓来仪，来仪意不低。\n有身皆衎衎，无物不熙熙。\n一国若一物，四方犹四支。\n巍巍乎尧舜，何得而名之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3996,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"静坐吟","author":"邵雍","text":"人生固有命，物生固有定。\n岂谓人最灵，不如物正性。\n或闻阴有鬼，善能致人死。\n致死设有由，死外何所求。\n又况人之命，系天不系他。\n阴鬼设有灵，独且奈天何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3997,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鲜欢吟","author":"邵雍","text":"生不争名与争利，夫君何故鲜欢意。\n以道自重固有之，非理相干是无谓。\n白日升天恐虚传，金貂换酒何曾醉。\n谁云忧挠大于山，亦是人间常式事。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3998,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"嘱花吟","author":"邵雍","text":"把酒嘱花枝，花枝亦要知。\n花无十日盛，人有百年期。\n据此销魂处，宁思中酒时。\n若非诗断割，难解一生迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3999,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"履道会饮","author":"邵雍","text":"众人之所乐，所乐唯嚣尘。\n吾友之所乐，所乐唯清芬。\n清芬无鼓吹，直与太古邻。\n太古者靡它，和气常絪纭。\n里闬旧情好，有才复有文。\n过从一日乐，十月生阳春。\n洛阳古神州，周公尝缕陈。\n四时寒暑正，四方道里均。\n代不乏英俊，号为多缙绅。\n至于花与木，天下莫敢伦。\n而逢此之景，而当此之辰。\n而能开口笑，而世有几人。\n清衷贯金石，剧谈惊鬼神。\n天地为一指，富贵如浮云。\n明时缓康济，白昼闲经纶。\n莫如陪欢伯，又复对此君。\n商于六百里，黄金四万斤。\n不能买兹乐，自馀恶足论。\n接䍦倒戴时，蟾蜍生海垠。\n小车倒载时，山翁归天津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4000,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"履道留题吟","author":"邵雍","text":"何代无人振德辉，众贤今日会西畿。\n太平文物风流事，更胜元和全盛时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4001,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"潜机吟","author":"邵雍","text":"世事观开日，人情看破时。\n一身都是我，瘦了又还肥。\n贷聚知朋聚，财离亲戚离。\n目前常见此，焉得不潜机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4002,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝎蛇吟","author":"邵雍","text":"蛇毒远于生，蝎毒近于死。\n蛇蝎虽不同，其毒固无异。\n蛇以首中人，蝎以尾用事。\n奈何天地间，畏首又畏尾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4003,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题华山","author":"邵雍","text":"域中有五岳，国家谨时祀。\n华岳居其一，作镇雄西裔。\n唐号金天王，今封顺圣帝。\n吁咈哉若神，僭窃同天地。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4004,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题范忠献公真","author":"邵雍","text":"范邵居洛阳，希夷居华山。\n陈邵为逸人，忠献为显官。\n邵在范之后，陈在范之前。\n三人貌相类，两人名相连。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4005,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"燕堂闲坐","author":"邵雍","text":"天网疏难漏，世网密莫通。\n我心久不动，一脱二网中。\n高竹漱清泉，长松迎清风。\n此时逢此景，正与此心同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4006,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"燕堂暑饮","author":"邵雍","text":"燕堂通高明，檐依断崖嵚。\n凉风来松梢，清泉飞竹阴。\n佳果间红绿，旨酒随浅深。\n却思阛阓间，郁蒸不可任。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4007,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠富公","author":"邵雍","text":"天下系休戚，世间谁拟伦。\n三朝为宰相，四水作闲人。\n照破万古事，收归一点真。\n不知缘底事，见我却慇勤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4008,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"辩谤吟","author":"邵雍","text":"田丹功盖国，貂勃语回君。\n谤者古来有，犹能杀九人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4009,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"辩熊耳","author":"邵雍","text":"昔禹别九州，导洛自熊耳。\n熊耳自有两，未审孰为是。\n东者近成周，西者隔丹水。\n书传称上洛，斯言得之矣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4010,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"臂痛吟","author":"邵雍","text":"先苦头风已病躯，新添臂痛又何如。\n无妨把盏只妨拜，虽废梳头未废书。\n不向医方求效验，唯将谈笑且消除。\n大凡物老须生病，人老何由不病乎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4011,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"霜露吟","author":"邵雍","text":"天地有润泽，其降也瀼瀼。\n暖则为湛露，寒则为繁霜。\n为露万物悦，为霜万物伤。\n二物本一气，恩威何昭彰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4012,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"瞻礼孔子吟","author":"邵雍","text":"执卷何人不读书，能知性者又何如。\n工居天下语言内，妙出世间绳墨馀。\n陶冶有无天事业，权衡治乱帝功夫。\n大哉赞易脩经意，料得生民以后无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4013,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"曝书吟","author":"邵雍","text":"虫蠹书害少，人蠹书害多。\n虫蠹曝已去，人蠹当如何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4014,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蠹书鱼","author":"邵雍","text":"形状类于鱼，其心好蠹书。\n居常游箧笥，未始在江湖。\n为害千般有，言烹一物无。\n年年当盛夏，㬠了却如初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4015,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"一言感人","author":"邵雍","text":"为女不嫁，为士不官，齐人一言，田子辞焉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4016,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]