[{"title":"春光好","author":"张元干","text":"寒食近，踏青时。\n画堂西。\n可是春来偏倦绣，乍生儿。\n香绵轻拂胭脂。\n加文褓、初试斑衣。\n诮没功夫存问我，且怜伊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50263,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春光好 其一 为杨聪父侍儿切鲙作","author":"张元干","text":"花恨雨，柳嫌风。\n客愁浓。\n坐久霜刀飞碎雪，一尊同。\n劳烦玉指春葱。\n未放箸、金盘已空。\n更与个中寻尺素，两情通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50264,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"昭君怨","author":"张元干","text":"春院深深莺语。\n花怨一帘烟雨。\n禁火已销魂。\n更黄昏。\n衾暖麝灯落灺。\n雨过重门深夜。\n枕上百般猜。\n未归来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50265,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"柳梢青 其二","author":"张元干","text":"小楼南陌。\n翠軿金勒，谁家春色。\n冷雨吹花，禁烟怯柳，伤心行客。\n少年百万呼卢，拥越女、吴姬共掷。\n被底香浓，尊前烛灭，如今消得。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50266,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"柳梢青 其一","author":"张元干","text":"清山浮碧。\n细风丝雨，新愁如织。\n慵试春衫，不禁宿酒，天涯寒食。\n归期莫数芳辰，误几度、回廊夜色。\n入户飞花，隔帘双燕，有谁知得。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50267,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"点绛唇","author":"张元干","text":"小雨忺晴，坐来池上荷珠碎。\n倬眉浓翠。\n怎不交人醉。\n美盼流觞，白鹭窥秋水。\n天然媚。\n大家休睡。\n笑倚西风里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50268,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"点绛唇 其一 丙寅秋社前一日溪光亭大雨作","author":"张元干","text":"山暗秋云，暝鸦接翅啼榕树。\n故人何处。\n一夜溪亭雨。\n梦入新凉，只道消残暑。\n还知否。\n燕将雏去。\n又是流年度。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50269,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"点绛唇 其四","author":"张元干","text":"画阁深围，暖红光里芳林影。\n暗香成阵。\n上下花相映。\n倒挂疏枝，月落参横冷。\n休装景。\n要人酒醒。\n除是花枝并。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50270,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"点绛唇 其七","author":"张元干","text":"醉泛吴松，小舟谁怕东风大。\n旧时经过。\n曾向垂虹卧。\n月淡霜天，今夜空清坐。\n还知么。\n满斟高和。\n只有君知我。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50271,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"点绛唇 其九","author":"张元干","text":"水鹢风帆，两眉只解相思皱。\n悄然难受。\n教我怎唧?。\n待得书来，不管归时瘦。\n娇痴后。\n是事撋就。\n只这难依口。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50272,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"点绛唇 其八","author":"张元干","text":"减塑冠儿，宝钗金缕双緌结。\n怎教宁帖。\n眼恼儿里劣。\n韵底人人，天与多磨折。\n休分说。\n放灯时节。\n闲了花和月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50273,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"点绛唇 其三","author":"张元干","text":"春晓轻雷，采蘋洲上清明雨。\n乱云遮树。\n暗澹江村路。\n今夜归舟，绿润红香处。\n遥山暮。\n画楼何许。\n唤取潮回去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50274,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"点绛唇 其二","author":"张元干","text":"水驿凝霜，夜帆风驶潮生晓。\n酒醒寒悄。\n枕底波声小。\n好去归舟，有个人风调。\n君行了。\n此欢应少。\n索共梅花笑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50275,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"点绛唇 其五 生朝","author":"张元干","text":"嵩洛云烟，间生真相耆英裔。\n要知鲐背。\n难老中和气。\n报道玉堂，已草调元制。\n华夷喜。\n绣裳貂珥。\n便向东山起。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50276,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"点绛唇 其六 呈洛滨、筠溪二老","author":"张元干","text":"清夜沉沉，暗蛩啼处檐花落。\n乍惊帘幕，香绕屏山角。\n堪恨归鸿，情似秋云薄。\n书难托，尽交寂寞，忘了前时约。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50277,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"祝英台近","author":"张元干","text":"枕霞红，钗燕坠。\n花露殢云髻。\n粉淡香残，犹带宿酲睡。\n画檐红日三竿，慵窥鸾鉴，长是倚、春风无力。\n又经岁。\n玉腕条脱轻松，羞郎见憔悴。\n何事秋来，容易又分袂。\n可堪疏雨梧桐，空阶络纬，背人处、偷弹珠泪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50278,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺新郎 其二 送胡邦衡待制","author":"张元干","text":"梦绕神州路。\n怅秋风、连营画角，故宫离黍。\n底事昆崙倾砥柱。\n九地黄流乱注。\n聚万落、千村狐兔。\n天意从来高难问，况人情、老易悲如许。\n更南浦，送君去。\n凉生岸柳催残暑。\n耿斜河、疏星淡月，断云微度。\n万里江山知何处。\n回首对床夜语。\n雁不到、书成谁与。\n目尽青天怀今古，肯儿曹、恩怨相尔汝。\n举大白，听金缕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50279,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺新郎 其一 寄李伯纪丞相","author":"张元干","text":"曳杖危楼去。\n斗垂天、沧波万顷，月流烟渚。\n扫尽浮云风不定，未放扁舟夜渡。\n宿雁落、寒芦深处。\n怅望关河空吊影，正人间、鼻息鸣鼍鼓。\n谁伴我，醉中舞。\n十年一梦扬州路。\n倚高寒、愁生故国，气吞骄虏。\n要斩楼兰三尺剑，遗恨琵琶旧语。\n谩暗涩、铜华尘土。\n唤取谪仙平章看，过苕溪、尚许垂纶否。\n风浩荡，欲飞举。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50280,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏云峰 丙寅六月为筠翁寿","author":"张元干","text":"涌冰轮，飞沆瀣，霄汉万里云开。\n南极瑞占象纬，寿应三台。\n锦肠珠唾，钟间气、卓荦天才。\n正暑，有祥光照社，玉燕投怀。\n新堂深处捧杯，乍香泛水芝，空翠风回。\n凉送燕歌缓舞，醉罥瑶钗。\n长生难老，都道是、柏叶仙阶。\n笑傲，且山中宰相，平地蓬莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50281,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其二","author":"张元干","text":"一枕秋风两处凉。\n雨声初歇漏声长。\n池塘零落藕花香。\n归梦等闲归燕去，断肠分付断云行。\n画屏今夜更思量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50282,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其十四","author":"张元干","text":"棐几明窗乐未央。\n熏炉茗碗是家常。\n客来长揖对胡床。\n蟹眼汤深轻泛乳，龙涎灰暖细烘香。\n为君行草写秋阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50283,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其一","author":"张元干","text":"曲室明窗烛吐光。\n瓦炉灰暖炷瓢香。\n夜阑茗碗间飞觞。\n坐稳蒲团凭棐几，熏馀纸帐掩梨床。\n个中风味更难忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50284,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其十二 求年例贡馀香","author":"张元干","text":"花气薰人百和香。\n少陵佳句是仙方。\n空教蜂蝶为花忙。\n和露摘来轻换骨，傍怀闻处恼回肠。\n去年时候入思量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50285,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其四 武林送李似表","author":"张元干","text":"燕掠风樯款款飞。\n艳桃秾李闹长堤。\n骑鲸人去晓莺啼。\n可意湖山留我住，断肠烟水送君归。\n三春不是别离时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50286,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其十五 书大同驿壁","author":"张元干","text":"榕叶桄榔驿枕溪。\n海风吹断瘴云低。\n薄寒初觉到征衣。\n岁晚可堪归梦远，愁深偏恨得书稀。\n荒庭日脚又垂西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50287,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其六","author":"张元干","text":"山绕平湖波撼城，湖光倒影浸山青，水晶楼下欲三更。\n雾柳暗时云度月，露荷翻处水流萤，萧萧散发到天明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50288,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其七","author":"张元干","text":"目送归州铁瓮城。\n隔江想见蜀山青。\n风前团扇仆频更。\n梦里有时身化鹤，人间无数草为萤。\n此时山月下楼明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50289,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其八 蔷薇水","author":"张元干","text":"月转花枝清影疏。\n露华浓处滴真珠。\n天香遗恨罥花须。\n沐出乌云多态度，晕成娥绿费工夫。\n归时分付与妆梳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50290,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其十一 戏简宇文德和求相香","author":"张元干","text":"花气蒸浓古鼎烟。\n水沈春透露华鲜。\n心清无暇数龙涎。\n乞与病夫僧帐座，不妨公子醉茵眠。\n普熏三界扫腥膻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50291,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其十三","author":"张元干","text":"残腊晴寒出众芳。\n风流勾引破春光。\n年年长为此花忙。\n夜久莫教银烛灺，酒边何似玉台妆。\n冰肌温处觅馀香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50292,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 咏木香","author":"张元干","text":"睡起中庭月未蹉。\n繁香随影上轻罗。\n多情肯放一春过。\n比似雪时犹带韵，不如梅处却缘多。\n酒边枕畔奈愁何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50293,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 范才元自酿，色香玉如，直与绿萼梅同调，宛然京洛气味也，因名曰萼绿春，且作一首。谚以窃尝为吹笙云 其一","author":"张元干","text":"萼绿华家萼绿春。\n山瓶何处下青云。\n浓香气味已醺人。\n竹叶传杯惊老眼，松醪题赋倒纶巾。\n须防银字暖朱唇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50294,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其五","author":"张元干","text":"云气吞江卷夕阳。\n白头波上电飞忙。\n奔雷惊雨溅胡床。\n玉节故人同壮观，锦囊公子更平章。\n榕阴归梦十分凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50295,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其三 王仲时席上赋木犀","author":"张元干","text":"翡翠钗头缀玉虫。\n秋蟾飘下广寒宫。\n数枝金粟露华浓。\n花底清歌生皓齿，烛边疏影映酥胸。\n恼人风味冷香中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50296,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其九 笃耨香","author":"张元干","text":"花气天然百和芬。\n仙风吹过海中春。\n龙涎沈水总销魂。\n清润巧萦金缕细，氤氲偏傍玉脂温。\n别来长是惜馀熏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50297,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"减字木兰花","author":"张元干","text":"客亭小会。\n可惜无欢容易醉。\n归去更阑。\n细雨鸣窗一夜寒。\n昏然独坐。\n举世疏狂谁似我。\n强拨炉烟。\n也道今宵是上元。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50298,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"彩鸾归令 为张子安舞姬作","author":"张元干","text":"珠履争围。\n小立春风趁拍低。\n态闲不管乐催伊。\n整铢衣。\n粉融香润随人劝，玉困花娇越样宜。\n凤城灯夜旧家时。\n数他谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50299,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"望海潮 其二 为富枢生朝寿","author":"张元干","text":"麒麟图画，貂蝉冠冕，青毡自属元勋。\n绿野旧游，平泉雅咏，霞舒烟卷朝昏。\n风月小阳春。\n照玳筵珠履，公子王孙。\n雪度嵩高，影横伊水庆生申。\n早梅长醉芳尊。\n况中兴盛际，宥密宗臣。\n琳馆奉祠，金瓯覆字，和羹妙手还新。\n光射紫微垣。\n看五云朝斗，千载逢辰。\n开取八荒寿域，一气转洪钧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50300,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"望海潮 其一 癸卯冬为建守赵季西赋碧云楼","author":"张元干","text":"苍山烟澹，寒溪风定，玉簪罗带绸缪。\n轻霭暮飞，青冥远净，珠星璧月光浮。\n城际踊层楼。\n正翠帘高卷，绿琐低钩。\n影落尊罍，气和歌管共清游。\n史君冠世风流。\n拥香鬟凭槛，雾鬓凝眸。\n银烛暖宵，花光照席，谯门莫报更筹。\n逸兴醉无休。\n赋探梅芳信，翻曲新讴。\n想见疏枝冷蕊，春意到沙洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50301,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清平乐 其二","author":"张元干","text":"明珠翠羽。\n小绾同心缕。\n好去吴松江上路。\n寄与双鱼尺素。\n兰桡飞取归来。\n愁眉待得伊开。\n相见嫣然一笑，眼波先入郎怀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50302,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清平乐 其一","author":"张元干","text":"乱山深处。\n雪拥溪桥路。\n晓日乍明催客去。\n惊起玉鸦翻树。\n翠衾香暖檀灰。\n一枝想见疏梅。\n凭仗东风说与，画眉人共春回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50303,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渔父家风/诉衷情令","author":"张元干","text":"八年不见荔枝红。\n肠断故园东。\n风枝露叶新采，怅望冷香浓。\n冰透骨，玉开容。\n想筠笼。\n今宵归去，满颊天浆，更御冷风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50304,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渔家傲 其三 奉陪富公季申探梅有作","author":"张元干","text":"寒日西郊湖畔路。\n天低野阔山无数。\n路转斜冈花满树。\n丝吹雨。\n南枝占得春光住。\n藉草携壶花底去。\n花飞酒面香浮处。\n老手调羹当独步。\n须记取。\n坐中都是芳菲侣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50305,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渔家傲 其二","author":"张元干","text":"楼外天寒山欲暮。\n溪边雪后藏云树。\n小艇风斜沙觜露。\n流年度。\n春光已向梅梢住。\n短梦今宵还到否。\n苇村四望知何处。\n客里从来无意绪。\n催归去。\n故园正要莺花主。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50306,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渔家傲 其一 题玄真子图","author":"张元干","text":"钓笠披云青嶂绕，绿蓑细雨春江渺。\n白鸟飞来风满棹。\n收纶了，渔童拍手樵青笑。\n明月太虚同一照，浮家泛宅忘昏晓。\n醉眼冷看城市闹。\n烟波老，谁能惹得闲烦恼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50307,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"眼儿媚","author":"张元干","text":"萧萧疏雨滴梧桐。\n人在绮窗中。\n离愁遍绕，天涯不尽，却在眉峰。\n娇波暗落相思泪，流破脸边红。\n可怜瘦似，一枝春柳，不奈东风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50308,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 其六","author":"张元干","text":"甘林玉蕊生香雾。\n游蜂争采清晨露。\n芳意著人浓。\n微烘曲室中。\n春来瀛海外。\n沈水迎风碎。\n好事富馀熏。\n频分几缕云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50309,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 其一","author":"张元干","text":"天涯客里秋容晚。\n妖红聊戏思乡眼。\n一朵醉深妆。\n羞渠照鬓霜。\n开时谁断送。\n不待司花共。\n有脚号阳春。\n芳菲属主人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50310,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 其一 送友人还富沙","author":"张元干","text":"山城何岁无风雨。\n楼台底事随波去。\n归棹望谯门。\n沙痕炯断云。\n诗成空吊古。\n想像经行处。\n陵谷有馀悲。\n举觞浇别离。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50311,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 其四","author":"张元干","text":"雨馀翠袖琼肤润。\n一枝想像伤春困。\n老眼见花时。\n惜花心未衰。\n酿成谁与醉。\n应把流苏缀。\n泪沁枕囊香。\n恼侬归梦长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50312,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 其五 政和壬辰东都作","author":"张元干","text":"黄莺啼破纱窗晓。\n兰缸一点窥人小。\n春浅锦屏寒。\n麝煤金博山。\n梦回无处觅。\n细雨梨花湿。\n正是踏青时。\n眼前偏少伊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50313,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 其二 戏呈周介卿","author":"张元干","text":"拍堤绿涨桃花水。\n画船稳泛东风里。\n丝雨湿苔钱。\n浅寒生禁烟。\n江山留不住。\n却载笙歌去。\n醉倚玉搔头。\n几曾知旅愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50314,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 其二","author":"张元干","text":"微云红衬馀霞绮。\n明星碧浸银河水。\n欹枕画檐风。\n愁生草际蛩。\n雁行离塞晚。\n不道衡阳远。\n归恨隔重山。\n楼高莫凭栏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50315,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 其三 三月晦，送春有集，坐中偶书","author":"张元干","text":"春来春去催人老，老夫争肯输年少。\n醉后少年狂，白髭殊未妨。\n插花还起舞，管领风光处。\n把酒共留春，莫教花笑人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50316,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谒金门 其二 道山亭饯张椿老赴行在","author":"张元干","text":"风露底。\n石上岸巾愁起。\n月到房心天似水。\n乱峰清影里。\n此去登瀛须记。\n今夕道山同醉。\n春殿明年人共指。\n玉皇香案吏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50317,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谒金门 其三 送康伯桧","author":"张元干","text":"清光溢。\n影转画檐凉入。\n风露一天星斗湿。\n无云天更碧。\n满引送君何惜。\n记取吾曹今夕。\n目断秋江君到日。\n潮来风正急。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50318,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谒金门 其一","author":"张元干","text":"鸳鸯渚。\n春涨一江花雨。\n别岸数声初过橹。\n晚风生碧树。\n艇子相呼相语。\n载取暮愁归去。\n寒食烟村芳草路。\n愁来无着处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50319,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜迁莺令/喜迁莺 其二 呈富枢","author":"张元干","text":"云叶乱，月华光。\n罗幕卷新凉。\n玉醅初泛嫩鹅黄。\n花露滴秋香。\n地行仙，天上相。\n风度世间人样。\n悬知洗盏径开尝。\n谁醉伴禅床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50320,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜迁莺令/喜迁莺 其一 送何晋之大著兄趋朝，歌以侑酒","author":"张元干","text":"文倚马，笔如椽。\n桂殿早登仙。\n旧游册府记当年。\n衮绣合貂蝉。\n庆天申，瞻玉座，鹓鹭正陪班。\n看君稳步过花砖。\n归院引金莲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50321,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜迁莺慢/喜迁莺 鹿鸣宴作","author":"张元干","text":"雁塔题名，宝津朌宴，盛事簪绅常说。\n文物昭融，圣代搜罗，千里争趋丹阙。\n元侯劝驾，乡老献书，发轫龟前列。\n山川秀，圜冠众多，无如闽越豪杰。\n姓标红纸，帖报泥金，喜信归来俱捷。\n骄马芦鞭醉垂，蓝绶吹雪。\n芳月素娥情厚，桂华一任郎君折。\n须满引，南台又是，合沙时节。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50322,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"朝中措 次聪父韵","author":"张元干","text":"花阴如坐木兰船。\n风露正娟娟。\n翠盖匝庭芳影，青蛟平地飞涎。\n春撩狂兴，香迷痛饮，中圣中贤。\n携取一枝同梦，从他五夜如年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50323,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"感皇恩 其一 寿","author":"张元干","text":"绿发照魁星，平康争看。\n锦绣肝肠五千卷。\n出逢熙运，早侍玉皇香案。\n禁涂扬历遍，纡宸眷。\n安养老成，十年萧散。\n天要中兴相公健。\n生朝开宴，长是通宵弦管。\n藕花香不断，南风远。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50324,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"感皇恩 其四 寿","author":"张元干","text":"豹尾引黄幡，宣麻金殿。\n雨露恩浓自天遣。\n搢绅交誉，最乐至诚为善。\n信知宗姓喜，君王眷。\n宝炬密香，玉卮波滟。\n醉拥笙歌夜深院。\n西清班近，雅称元戎同燕。\n要看茅土相，貂蝉面。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50325,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]