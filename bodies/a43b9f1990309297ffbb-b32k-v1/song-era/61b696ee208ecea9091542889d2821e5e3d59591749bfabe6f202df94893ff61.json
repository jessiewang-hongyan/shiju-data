[{"title":"天仙子","author":"赵令畤","text":"宿雨洗空台榭莹。\n下尽珠帘寒未定。\n花开花落几番晴，春欲竟。\n愁未醒。\n池面杏花红透影。\n一纸短书言不尽。\n明月清风还记省。\n玉楼香断又添香，闲展兴。\n临好景。\n心似乱萍何处整。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44169,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"失调名","author":"赵令畤","text":"脸薄难藏泪，眉长易觉愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44170,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"好事近","author":"赵令畤","text":"急雨涨溪浑，小树带山秋色。\n轻棹暮天归路，袅芙蓉烟白。\n酒醒香冷梦回时，虫声正凄绝。\n只觉小窗风月，与昨宵都别。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44171,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西江月","author":"赵令畤","text":"人世一场大梦，我生魔了十年。\n明窗千古探遗编。\n不救饥寒一点。\n更被维摩老子，不教此处容言。\n炉薰清炷坐安禅。\n物物头头显现。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44172,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"临江仙 阿方初出","author":"赵令畤","text":"枝上粉香吹欲尽，依前庭院春风。\n更谁同绕摘芳丛。\n漏残金兽冷，信断锦屏空。\n看结灯花愁不睡，酒阑无梦相逢。\n凄凉长判一生中。\n不如云外月，永夜在房栊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44173,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"临江仙","author":"赵令畤","text":"翠袖卷纱红映肉，无风玉骨生寒。\n可堪新晓雨初残。\n颦眉谁恼著，粉泪滴阑干。\n闻道谪仙歌妙语，新妆再发愁颜。\n雾帘云幕荐金盘。\n笔间长借句，直莫放春还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44174,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天","author":"赵令畤","text":"素玉朝来有好怀。\n一枝梅粉照人开。\n晴云欲向怀中起，春色先从脸上来。\n深院落，小楼台。\n玉盘香篆看徘徊。\n须知月色撩人恨，数夜春寒不下阶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44175,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其二","author":"赵令畤","text":"槐柳春馀绿涨天。\n酒旗高插夕阳边。\n谁家墙里笑秋千。\n往事不堪楼上看，新愁多向曲中传。\n此情销得是何年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44176,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其三","author":"赵令畤","text":"一朵梦云惊晓鸦。\n数枝春雨带梨花。\n坐来残月冷窗纱。\n钗凤谩曾留得半，枕山犹是枕时斜。\n对花今日奈天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44177,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙","author":"赵令畤","text":"稳小弓鞋三寸罗。\n歌唇清韵一樱多。\n灯前秀艳总横波。\n指下鸣泉清杳渺，掌中回旋小婆娑。\n明朝归路奈情何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44178,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其五","author":"赵令畤","text":"少日怀山老住山。\n一官休务得身闲。\n几年食息白云间。\n似我乐来真是少，见人忙处不相关。\n养真高静出尘寰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44179,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其四","author":"赵令畤","text":"水满池塘花满枝。\n乱香深里语黄鹂。\n东风轻软弄帘帏。\n日正长时春梦短，燕交飞处柳烟低。\n玉窗红子斗棋时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44180,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其一 王晋卿筵上作","author":"赵令畤","text":"风急花飞昼掩门。\n一帘残雨滴黄昏。\n便无离恨也销魂。\n翠被任熏终不暖，玉杯慵举几番温。\n个般情事与谁论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44181,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清平乐","author":"赵令畤","text":"春风依旧。\n著意随堤柳。\n搓得蛾儿黄欲就。\n天气清明时候。\n去年紫陌青门。\n今宵雨魄云魂。\n断送一生憔悴，只销几个黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44182,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 其二","author":"赵令畤","text":"长淮渺渺寒烟白。\n凭阑人是霜台客。\n诗句妙春豪。\n风云不啻高。\n樽前人已老。\n馀恨连芳草。\n一曲酒醒时。\n梧桐月欲低。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44183,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 其一","author":"赵令畤","text":"轻鸥欲下春塘浴。\n双双飞破春烟绿。\n两岸野蔷薇。\n翠笼薰绣衣。\n凭船闲弄水。\n中有相思意。\n忆得去年时。\n水边初别离。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44184,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 其三","author":"赵令畤","text":"春风试手先梅蕊。\n頩姿冷艳明沙水。\n不受众芳知。\n端须月与期。\n清香闲自远。\n先向钗头见。\n雪后燕瑶池。\n人间第一枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44185,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"满庭芳","author":"赵令畤","text":"玉枕生凉，金缸传晓，败叶飞破清秋。\n雨馀翻浪，渺渺阻行舟。\n暂系汀洲侧畔，风夜起、荻叶添愁。\n银屏远，龙香渐尽，还是梦扬州。\n更筹。\n何太永，当年情事，今日堪酬。\n最苦恨红楼，笑我飘浮。\n为寄相思细字，教字字、愁蹙眉头。\n凄凉久，渔人唱晓，随月过横沟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44186,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"虞美人 光化道中寄家","author":"赵令畤","text":"画船稳泛春波渺。\n夕雨寒声小。\n紫烟深处数峰横。\n惊起一滩鸥鹭、照川明。\n西楼今夜归期误。\n恨入阑干暮。\n可堪春事满春怀。\n不似珠帘新燕、早归来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44187,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝶恋花 商调十二首 其六","author":"赵令畤","text":"数夕孤眠如度岁。\n将谓今生，会合终无计。\n正是断肠凝望际。\n云心捧得嫦娥至。\n玉困花柔羞抆泪。\n端丽妖娆，不与前时比。\n人去月斜疑梦寐。\n衣香犹在妆留臂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44188,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝶恋花 商调十二首 其四","author":"赵令畤","text":"庭院黄昏春雨霁。\n一缕深心，百种成牵系。\n青翼蓦然来报喜。\n鱼笺微谕相容意。\n待月西厢人不寐。\n帘影摇光，朱户犹慵闭。\n花动拂墙红萼坠。\n分明疑是情人至。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44189,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝶恋花 商调十二首 其八","author":"赵令畤","text":"碧沼鸳鸯交颈舞。\n正恁双栖，又遣分飞去。\n洒翰赠言终不许。\n援琴请尽奴衷素。\n曲未成声先怨慕。\n忍泪凝情，强作霓裳序。\n弹到离愁凄咽处。\n弦肠俱断梨花雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44190,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝶恋花 商调十二首 其十一","author":"赵令畤","text":"梦觉高唐云雨散。\n十二巫峰，隔断相思眼。\n不为旁人移步懒。\n为郎憔悴羞郎见。\n青翼不来孤凤怨。\n路失桃源，再会终无便。\n旧恨新愁无计遣。\n情深何似情俱浅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44191,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝶恋花 商调十二首 其一","author":"赵令畤","text":"丽质仙娥生月殿。\n谪向人间，未免凡情乱。\n宋玉墙东流美盼。\n乱花深处曾相见。\n密意浓欢方有便。\n不奈浮名，旋遣轻分散。\n最恨多才情太浅。\n等闲不念离人怨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44192,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝶恋花 商调十二首 其九","author":"赵令畤","text":"别后相思心目乱。\n不谓芳音，忽寄南来雁。\n却写花笺和泪卷。\n细书方寸教伊看。\n独寐良宵无计遣。\n梦里依稀，暂若寻常见。\n幽会未终魂已断。\n半衾如暖人犹远。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44193,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝶恋花 商调十二首 其二","author":"赵令畤","text":"锦额重帘深几许。\n绣履弯弯，未省离朱户。\n强出娇羞都不语。\n绛绡频掩酥胸素。\n黛浅愁红妆淡伫。\n怨绝情凝，不肯聊回顾。\n媚脸未匀新泪污。\n梅英犹带春朝露。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44194,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝶恋花 商调十二首 其七","author":"赵令畤","text":"一梦行云还暂阻。\n尽把深诚，缀作新诗句。\n幸有青鸾堪密付。\n良宵从此无虚度。\n两意相欢朝又暮。\n争奈郎鞭，暂指长安路。\n最是动人愁怨处。\n离情盈抱终无语。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44195,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝶恋花 商调十二首 其一","author":"赵令畤","text":"尺素重重封锦字。\n未尽幽闺，别后心中事。\n佩玉彩丝文竹器。\n愿君一见知深意。\n环玉长圆丝万系。\n竹上斓斑，总是相思泪。\n物会见郎人永弃。\n心驰魂去神千里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44196,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝶恋花 商调十二首 其十二","author":"赵令畤","text":"镜破人离何处问。\n路隔银河，岁会知犹近。\n只道新来消瘦损。\n玉容不见空传信。\n弃掷前欢俱未忍。\n岂料盟言，陡顿无凭准。\n地久天长终有尽，绵绵不似无穷恨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44197,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝶恋花 商调十二首 其五","author":"赵令畤","text":"屈指幽期惟恐误。\n恰到春宵，明月当三五。\n红影压墙花密处。\n花阴便是桃源路。\n不谓兰诚金石固。\n敛袂怡声，恣把多才数。\n惆怅空回谁共语。\n只应化作朝云去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44198,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝶恋花 商调十二首 其三","author":"赵令畤","text":"懊恼娇痴情未惯。\n不道看看，役得人肠断。\n万语千言都不管。\n兰房跬步如天远。\n废寝忘餐思想遍。\n赖有青鸾，不必凭鱼雁。\n密写香笺论缱绻。\n春词一纸芳心乱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44199,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其一 前改张文潜诗，但有此四句，正为咸平刘生作。馀作后改为鹧鸪天赠之","author":"赵令畤","text":"可是相逢意便深。\n为郎巧笑不须金。\n门前一尺春风髻，窗内三更夜雨衾。\n情渺渺，信沈沈。\n青鸾无路寄芳音。\n山城钟鼓愁难听，不解襄王梦里寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44200,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其二 蓝良辅知阁舟中晚坐会上作","author":"赵令畤","text":"麝发雕炉小袖笼。\n天教我辈此时同。\n橼经雪重香方满，菊到秋深色自浓。\n船槛内，月明中。\n插花归去莫匆匆。\n人生更在艰难内，胜事年来不易逢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44201,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"野人家","author":"赵兰皋","text":"总为门无马足尘，败蓑悬壁亦天真。\n看渠只是芸田者，处世强如识字人。\n隔水架茅知避俗，得鱼沽酒却分邻。\n市朝多少人称隐，只隐黄金不隐身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44202,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"八声甘州 燕山雪花","author":"赵功可","text":"渺平沙、莽莽海风吹，一寒气崔嵬。\n耿长天欲压，河流不动，云湿如灰。\n帝敕冰花剪刻，飞瑞上燕台。\n马上行人笑，万玉堆豗。\n滉漾天街晴昼，料酒楼歌馆，都是春回。\n喜丰年有象，贺表四方来。\n仗下貂裘茸帽，拥千官、齐上紫金杯。\n明朝起，江南驿使，来进宫梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44203,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"氐州第一 次韵送春","author":"赵功可","text":"杨柳楼深，推梦乍起，前山一片愁雨。\n嫩绿成云，飞红欲雪，天亦留春不住。\n借问东风，甚飘泊、天涯何许。\n可惜风流，三生杜牧，少年张绪。\n陌上差差携手去。\n怕行到、歌台旧处。\n落日啼鹃，断烟荒草，吟不成谁语。\n听西河、人唱罢，何堪把、江南重赋。\n敲碎琼壶，又前村、数声钟鼓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44204,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"曲游春 次韵","author":"赵功可","text":"千树玲珑罩，正蒲风微过，梅雨新霁。\n客里幽窗，算无春可到，和愁都闭。\n万种人生计。\n应不似、午天闲睡。\n起来踏碎松阴，萧萧欲动疑水。\n借问归舟归未。\n望柳色烟光，何处明媚。\n抖擞人间，除离情别恨，乾坤馀几。\n一笑晴凫起。\n酒醒后、阑干独倚。\n时见双燕飞来，斜阳满地。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44205,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"声声慢 残梦和儿韵","author":"赵功可","text":"情痴倦极，天阔归迟，吟魂无力随风。\n月落墙阴，一屏睡睫濛濛。\n邯郸平生难记，记花前、犹醉金钟。\n留连处，忽一声山外，吹度晴钟。\n觉来重重追忆，似游尘飞去，那拾遗踪。\n寄谢芳卿，向来曾主芙蓉。\n人间兴亡万感，看千年、与梦皆空。\n披衣起，倚阑干、人在笑中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44206,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"柳梢青 其二 友人至","author":"赵功可","text":"客里凄凉，桐花满地，杜宇深山。\n幸自君来，谁教春去，剪剪轻寒。\n愁怀无语相看。\n谩写入、徽弦自弹。\n小院黄昏，前村风雨，莫倚阑干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44207,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"柳梢青 其一 怀青山兄，时在东湖","author":"赵功可","text":"一健如仙，东湖烟柳，坐拥吟翁。\n几许功名，百年身世，相见匆匆。\n别来三度秋风。\n怕看见、云间过鸿。\n酒醒灯寒，更残月落，吾美楼中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44208,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"桂枝香 和詹天游就访","author":"赵功可","text":"晓天凉露。\n天上玉箫吹，飞声如雨。\n金阙高寒，闲却一庭梅雨。\n漫漫八表尘埃梦，把文章、洗空千古。\n精神一似，风裳水佩，兰皋蘅浦。\n看万里、跳龙跃虎。\n甚花娇英气，剑清尘妩。\n憔悴江南，应念小窗贫女。\n朱楼十二春无际，倚苍寒、青袖如故。\n茶香酒熟，月明风细，试教歌舞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44209,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绮寮怨 和儿韵","author":"赵功可","text":"忽忽东风又老，冷云吹晚阴。\n疏帘下、茶鼎孤烟，断桥外、梅豆千林。\n江南庾郎憔悴，睡未醒、病酒愁怎禁。\n倚阑干、一扇凉风，看平地、落花如雪深。\n千曲囊中古琴。\n平泉金谷，不堪旧事重寻。\n当日登临。\n都化作、梦销沈。\n元龙丘坟无恙，谁唤起，共论心。\n哀歌怨吟。\n问何似、啼鸟枝上音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44210,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"裂衣书诗寄弟","author":"赵卯发","text":"城池不高深，无财又无兵。\n惟有死报国，来生作弟兄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44211,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题于壁","author":"赵卯发","text":"国不可负，城难以降。\n夫妇俱死，节义成双。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44212,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"万松岭","author":"赵遹","text":"清溪狭径小桥东，风入桃花处处同。\n我为日长无一事，偶然来此听松风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44213,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"借榻","author":"赵处澹","text":"帘捲薰风透骨香，月移花影上回廊。\n客游不作安居计，漫借高斋一榻凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44214,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清明雨中","author":"赵处澹","text":"竹绕清渠长嫩蒲，数声村角晚吹梧。\n山家最怕清明雨，打落残花一片无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44215,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丁山眺望","author":"赵处澹","text":"绝顶苍崖险，藤萝手自攀。\n云烟万里迥，宇宙一身闲。\n秋气悲才子，夕阳明远山。\n看看九日至，黄菊翠岩间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44216,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日会饮翠麓","author":"赵处澹","text":"山亭对佳客，秋老暮烟横。\n鸟下江如画，潮回浪有声。\n竹光添麓润，诗思入门清。\n偶约非因酒，相逢话此生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44217,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"八月十四夜","author":"赵处澹","text":"洲渚云飞尽，江流碧映天。\n明朝秋欲半，今夜月先圆。\n玉宇浓垂露，银河冷坠烟。\n焦桐弹一曲，孤鹤舞风前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44218,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山行和韵","author":"赵处澹","text":"历穷山底路，浑不见人家。\n傍石寻丹鼎，随云到玉华。\n蝶幽停蕙蕊，鹿饱卧苔花。\n中有胡麻甑，香泉浸碧沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44219,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"月夜","author":"赵处澹","text":"渔笛吹清夜，芦花深处闻。\n岸穷天拍水，山静月笼云。\n蛩哽声声切，萤明个个分。\n任渠尘外事，城市日纷纭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44220,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"厌雨","author":"赵处澹","text":"拟欲占晴待暮鸦，不禁愁思满蒹葭。\n片云飞渡风和雨，斜日低穿水浸沙。\n薏苡石边收钓笠，芙蓉篱外响芦笳。\n最怜冉冉秋将半，未得先乘问月槎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44221,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"村居","author":"赵处澹","text":"乍晴山染碧，过雨落疏花。\n水阔暮天迥，村居春昼嘉。\n倚栏时展画，留客旋烹茶。\n剩得闲中趣，吟诗到日斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44222,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和韵","author":"赵处澹","text":"爱看山色遍，小立渡头风。\n飞鹭起沙渚，何人移短篷。\n村烟秋入夜，江月冷摇空。\n回首清香满，方知是桂丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44223,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨","author":"赵处澹","text":"溪云依翠竹，乱石注流泉。\n数日饶春雨，馀寒胜腊天。\n书从琴案读，茶共药炉煎。\n故旧经过少，题诗一二篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44224,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日卧病","author":"赵处澹","text":"江雨日霏霏，春寒易入衣。\n贫居兼卧病，愁绪对斜晖。\n有句平生拙，无营世虑稀。\n梅花欺老眼，故傍短岩飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44225,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偶成","author":"赵处澹","text":"风约波痕远，云含野色低。\n村舂向晚急，山鸟爱晴啼。\n牧笛过蘋渚，溪船泊柳堤。\n旅魂招未得，窗草更萋萋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44226,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偶成用溪阴韵","author":"赵处澹","text":"虚室萧萧百虑忘，近来趣味一何长。\n清谈自笑如东晋，好句谁能学盛唐。\n旧日故园春寂寞，三年上国梦凄凉。\n功名原在青编里，况有青毡在玉堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44227,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题周恭叔谢池读书处","author":"赵处澹","text":"粉蝶黄蜂二月天，初晴已觉十分妍。\n市桥船系垂垂柳，花寺钟敲淡淡烟。\n幽趣静看青鸟啄，闲情独羡白鸥眠。\n谢家风月今何许，总入池塘梦里篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44228,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"濯缨亭","author":"赵处澹","text":"两派清溪合，回波到此间。\n危峰衔古石，幽洞隔尘寰。\n云影高低树，岚光远近山。\n先贤遗迹在，盍挽旧风还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44229,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"长门怨","author":"赵处澹","text":"未央宫中花满枝，笙歌不断春风词。\n玉阶露冷与天近，霓裳舞罢琼瑶卮。\n如今寂寂长门春，寒风萧萧愁杀人。\n花开花落泪如洗，转眼身为陌上尘。\n自笑夜来清梦断，犹觉瑶池侍君宴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44230,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬至日书怀","author":"赵处澹","text":"岁月不可挽，迅如双转毂。\n人生能几何，苦不自知足。\n西风吹繁霜，冻雁鸣相逐。\n老干枯无条，积叶掩深谷。\n冉冉四序迁，忽见一阳复。\n今年才四十，玄鬓忽已秃。\n久作林下想，雅致在幽独。\n三径几株松，一窗数竿竹。\n任懒锄荒园，更种渊明菊。\n逍遥以终年，澹然忘所欲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44231,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]