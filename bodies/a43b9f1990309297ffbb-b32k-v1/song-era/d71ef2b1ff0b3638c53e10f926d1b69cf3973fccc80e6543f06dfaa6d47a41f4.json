[{"title":"和秦寿之铜陵江上二首 其二","author":"王之道","text":"烟销远水分帆影，木落疏林出斧痕。\n啸咏不知红日下，九华何处望中昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10428,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和秦寿之铜陵江上二首 其一","author":"王之道","text":"枫叶霜馀霞灿烂，苇花风起雪纵横。\n铜陵江上秋容好，两绝新诗取次成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10429,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和章序臣梅花二首 其二","author":"王之道","text":"多谢苍头语我来，恍如相见笑相陪。\n新诗高妙梅清绝，展读花前病眼开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10430,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和章序臣梅花二首 其一","author":"王之道","text":"三月诗筒绝往来，有时谈麈许追陪。\n梅花雅欲撩佳句，犯雪凌霜为我开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10431,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和富公权宗丞十首 其六","author":"王之道","text":"昂昂野鹤在鸡群，一见人分浊与清。\n吟对红葵朝雨细，坐临绿竹午风轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10432,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和富公权宗丞十首 其九","author":"王之道","text":"嗟予少也戆无奇，才力而今老更衰。\n文阵异时逢大敌，犹能斩将复搴旗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10433,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和富公权宗丞十首 其八","author":"王之道","text":"恶客未尝知酒圣，高人何止擅文豪。\n三司自揣非吾事，敢觊徐州解佩刀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10434,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和富公权宗丞十首 其十","author":"王之道","text":"我惭思涩同司马，君患才多继士衡。\n今日相从非偶耳，挂冠淮浙好寻盟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10435,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和富公权宗丞十首 其一","author":"王之道","text":"门外传来一轴诗，烂然蓬荜顿增辉。\n匹夫不敢贪怀璧，什袭今从故府归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10436,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和富公权宗丞十首 其三","author":"王之道","text":"閒想当年啸咏声，一时人物斗峥嵘。\n江山清壮今犹昔，谁谓丹青画不成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10437,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和富公权宗丞十首 其二","author":"王之道","text":"展读新诗次第看，管中文豹喜窥斑。\n不知笔力能豪放，落纸云烟欬唾间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10438,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和富公权宗丞十首 其四","author":"王之道","text":"后来模楷复何人，千载风流郭泰巾。\n欲睹诗豪兼草圣，一尊聊发洞庭春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10439,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和富公权宗丞十首 其五","author":"王之道","text":"行草应曾阅斗蛇，世情无识笑东家。\n君看横雨随风势，纸纸清新字字斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10440,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和道可","author":"王之道","text":"卧雨春头到地长，清风一榻借微凉。\n棋声惊断高僧梦，起拨炉中未过香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10441,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和鲁如晦七夕","author":"王之道","text":"乞巧谁家绮席开，夜阑箫鼓趁虚催。\n启明不为牵牛计，又放朝阳送曙来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10442,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和戴禹功幕府归来三首 其三","author":"王之道","text":"临淮终日鉴修眉，水外遥山尺五低。\n我欲骑云叫阊阖，请将捕寇付平西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10443,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和戴禹功幕府归来三首 其二","author":"王之道","text":"客里诗成付漫书，清风一榻黑甜馀。\n相山旧隐今分定，却是归来计不疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10444,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和戴禹功幕府归来三首 其一","author":"王之道","text":"抖擞空肠一字无，下邳能复异时书。\n中兴正欲平骄寇，莫若相如赋子虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10445,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和魏定父早春十首 其十","author":"王之道","text":"南禅相望无多地，深谢高轩日见过。\n归去山林遂閒放，却寻农圃问谁何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10446,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和魏定父早春十首 其九","author":"王之道","text":"辰瓜醉竹定何如，试问君家种莳书。\n坐久幽窗转斜日，恰怜梅影上衣裾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10447,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和魏定父早春十首 其八","author":"王之道","text":"怪来庭砌堕寒梅，风笛数声清以哀。\n两日枯肠餍蔬笋，不堪茗椀发轻雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10448,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和魏定父早春十首 其七","author":"王之道","text":"㶁㶁溪流碎玉鸣，野梅随处伴行人。\n归欤路出临邛市，准拟沉浮曲米春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10449,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和魏定父早春十首 其六","author":"王之道","text":"春到花梢一点红，吹嘘应谢晓来风。\n南园缭绕城边路，无限诗情杖履中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10450,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和魏定父早春十首 其五","author":"王之道","text":"门前溪水绿萦回，风縠无边费剪裁。\n待与东君写春色，好教红紫一时开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10451,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和魏定父早春十首 其四","author":"王之道","text":"晚来天意欲晴寒，幽鸟争春到舌端。\n诗骨自怜山样瘦，酒肠君似海能宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10452,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和魏定父早春十首 其三","author":"王之道","text":"依依杨柳绕溪斜，黑白溪头鹄伴鸦。\n雨过芜菁自春色，一丛茅屋野人家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10453,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和魏定父早春十首 其二","author":"王之道","text":"安得都护胡青骢，与君并辔摇玲珑。\n南溪今日冻初解，好看游鱼翻鬣红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10454,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和魏定父早春十首 其一","author":"王之道","text":"早从子美追懒真，近向长康得痴绝。\n相逢可笑复可怜，君看稀疏鬓边雪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10455,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岳阳楼","author":"王之道","text":"云开层观切高寒，三面江湖一面山。\n眼界不知多少远，望中幽鸟暮飞还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10456,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"法云寺和汤立贤留题","author":"王之道","text":"寺占湖边数亩山，杖藜偷得一朝閒。\n昨朝恰别居巢长，又喜新诗在壁间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10457,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"经过合寨吊孟氏故居二首 其二","author":"王之道","text":"行过春泥没马深，几声幽鸟啭乔林。\n感时恨别愁无那，赖有清樽慰此心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10458,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"经过合寨吊孟氏故居二首 其一","author":"王之道","text":"藤梢棘刺失朱门，空想当年载酒樽。\n天色重增行客恨，东风吹雨湿黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10459,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"青梅","author":"王之道","text":"疏白欺人侵短鬓，老红乘酒驻衰颜。\n食梅已判非吾事，把读清诗忆故山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10460,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鸣山驿夜雨","author":"王之道","text":"夜来风雨晓还晴，沙路无泥快早行。\n鸟语花容春自好，有生何处不安生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10461,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日书事呈历阳县苏仁仲八首 其八","author":"王之道","text":"子美不应花解恼，次公何必酒而狂。\n知君颇负风流债，安得司空惯窃香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10462,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日书事呈历阳县苏仁仲八首 其七","author":"王之道","text":"猛风吹雨暮江头，烟草微茫一片愁。\n双鲤不来无处问，欲寻归路转悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10463,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日书事呈历阳县苏仁仲八首 其六","author":"王之道","text":"学似卿家宜有法，人如我辈岂无情。\n新诗早自推心服，幽会知谁付目成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10464,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日书事呈历阳县苏仁仲八首 其五","author":"王之道","text":"公馀槐柳转斜日，吏散鸟雀来空庭。\n康成书带可人意，坐见茸茸相对青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10465,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日书事呈历阳县苏仁仲八首 其四","author":"王之道","text":"情似长江流不断，事如芳草刬还生。\n此身何苦浮名绊，正拟花时取次行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10466,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日书事呈历阳县苏仁仲八首 其三","author":"王之道","text":"似是东风恼客心，淹留行色故相禁。\n扁舟正在江南岸，又扰浮云作暮阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10467,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日书事呈历阳县苏仁仲八首 其二","author":"王之道","text":"芳草池塘处处佳，竹篱茅屋野人家。\n清明过了桃花尽，颇觉春容属菜花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10468,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日书事呈历阳县苏仁仲八首 其一","author":"王之道","text":"篮舆兀醉出东门，赖有官舟为解纷。\n流马木牛今已矣，其馀儿辈说三分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10469,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日访道上人","author":"王之道","text":"陇麦如烟水满塘，路边桃李问柔桑。\n道人不作渊明调，笑碾新茶看瑞香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10470,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日偶成","author":"王之道","text":"短垣新雨上银泥，柳外幽花咫尺迷。\n独喜流莺解人意，一声声傍绿窗啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10471,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"独步","author":"王之道","text":"雨晴烟渚白鸥乱，风过霜林红叶稀。\n独步幽吟心正苦，却怜明月照人归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10472,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋日即事二首 其二","author":"王之道","text":"枕缘睡熟来魂梦，衣为酣频带酒痕。\n多事长红兼短白，雨馀相倚映江村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10473,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋日即事二首 其一","author":"王之道","text":"潮退菰蒲风自倒，秋深菱芡雨应添。\n怪来病眼双明甚，喜见遥山寸碧纤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10474,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋日悯旱题香山庄舍","author":"王之道","text":"千里骄阳稼穑枯，人心穷极但天呼。\n须烦岩壑为霖手，下泽苍生慰海隅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10475,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋日野步和王觉民十六首 其十六","author":"王之道","text":"病怯酒杯微过量，瘦怜衣带颇宽痕。\n伤心故国迷烟草，秋日荒凉处处村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10476,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋日野步和王觉民十六首 其十四","author":"王之道","text":"更穷诗债应难欠，纵懒书淫亦自添。\n水外修眉横翠巘，试凭张敞画浓纤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10477,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋日野步和王觉民十六首 其十三","author":"王之道","text":"烟里山光陈水墨，云边日影乱青红。\n新诗有画人难到，高压澄江五字工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10478,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋日野步和王觉民十六首 其十二","author":"王之道","text":"雨开繁菊金无价，风皱平池鉴有痕。\n日暮客帆何处落，柿林西畔荻花村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10479,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋日野步和王觉民十六首 其十一","author":"王之道","text":"箪瓢不失生涯在，诗酒何当习气除。\n欲倩雕弧落新雁，足间寻觅子卿书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10480,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋日野步和王觉民十六首 其十","author":"王之道","text":"孤灯闪闪风还暗，清漏沉沉夜向添。\n案上数枝漙露菊，可怜疏落嫩纤纤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10481,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋日野步和王觉民十六首 其九","author":"王之道","text":"酒嫩细斟浮蚁绿，芡柔轻剥汗衫红。\n搜罗物象嗟予拙，挥扫词章放子工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10482,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋日野步和王觉民十六首 其八","author":"王之道","text":"雨晴庭户生秋意，潮落溪桥见水痕。\n稻熟人家得相向，兵馀眼底两三村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10483,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋日野步和王觉民十六首 其七","author":"王之道","text":"五穷韩愈烦驱逐，一室陈蕃倦扫除。\n我有埙篪旧诗集，当令阿买为君书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10484,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋日野步和王觉民十六首 其六","author":"王之道","text":"迂愚长与懒相兼，岁晚空馀白发添。\n坐送夕阳还黯黯，倚看新月露纤纤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10485,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋日野步和王觉民十六首 其五","author":"王之道","text":"荷叶倚风摇败绿，蓼花沾雨卧衰红。\n物华虽逐穷秋老，诗句翻从壮岁工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10486,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋日野步和王觉民十六首 其四","author":"王之道","text":"揉蓝拍岸秋涛信，列炬缘山夜烧痕。\n枫叶经霜红更好，晚来扶杖过前村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10487,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋日野步和王觉民十六首 其三","author":"王之道","text":"穷愁长怕诗撩拨，幽愤须凭酒破除。\n对酒更遭诗债窘，可堪毛颖不中书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10488,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋日野步和王觉民十六首 其二","author":"王之道","text":"桑林閒觉疏黄减，菜陇贫怜嫩绿添。\n秋水接潮还潋滟，晚风吹雨乍廉纤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10489,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋日野步和王觉民十六首 其一","author":"王之道","text":"芡觜静缄秋水碧，梨腮深抺夕阳红。\n近来诗社争相胜，幽讨冥搜字字工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10490,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋日野步和王觉民十六首 其十五","author":"王之道","text":"人言会饮辰嫌酉，我为求医日问除。\n老去谁能遵百忌，秋来只欲上三书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10491,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"给散告帖","author":"王之道","text":"曾随骁将远追奔，勇冠诸军继虎贲。\n圣主念功知有自，一时高下拜新恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10492,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"追和东坡梅花十绝 其九","author":"王之道","text":"步入芳丛脚自轻，看来群卉眼偏明。\n和羹有实休疑晚，况是东君旧着情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10493,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"追和东坡梅花十绝 其四","author":"王之道","text":"问言何处是前村，万木号寒雪障昏。\n安得梦为蝴蝶去，花间栩栩适吟魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10494,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"追和东坡梅花十绝 其十","author":"王之道","text":"山下溪头卖酒家，为谁低入屋檐斜。\n蔬肠不柰村酤涩，笑挽长条沃井花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10495,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"追和东坡梅花十绝 其八","author":"王之道","text":"绛跗檀口映冰肌，踏雪来看带雪枝。\n一见遂能消鄙吝，汝南谁敢忽牛医。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10496,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"追和东坡梅花十绝 其六","author":"王之道","text":"醉眼昏昏午倦开，不堪诗债苦相催。\n清香自是蠲烦药，为折霜蕤一朵来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10497,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"追和东坡梅花十绝 其七","author":"王之道","text":"莫怪风前玉斝飞，饮酣初喜传花枝。\n正当北雪消残后，恰直东风料峭时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10498,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"追和东坡梅花十绝 其五","author":"王之道","text":"真香暗逐微风远，疏影低随淡日斜。\n好在黄昏清浅意，一时收拾付诗家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10499,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"追和东坡梅花十绝 其二","author":"王之道","text":"盈盈终日对妆台，一树临溪欲半开。\n吟赏不须期烂漫，恐随春雨点苍苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10500,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"追和东坡梅花十绝 其一","author":"王之道","text":"春到梅梢日自和，动人芳气不须多。\n清肌瘦骨如冰玉，瘴雾那能柰子何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10501,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"追和东坡梅花十绝 其三","author":"王之道","text":"一池春水绿萦回，池上梅花暖自开。\n想见温泉初出浴，六宫遥指太真来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10502,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"追和贾明叔侯陟明二侍郎瑞香二首 其二","author":"王之道","text":"深院重帘数尺墙，对花何必竟烧香。\n九龄风度高难挹，举世纷纷漫笏囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10503,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"追和贾明叔侯陟明二侍郎瑞香二首 其一","author":"王之道","text":"日午高人睡正浓，幽香初破碧山红。\n忽然梦觉寻无处，会有东来一阵风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10504,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]