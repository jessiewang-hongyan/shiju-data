[{"title":"和新市杂咏 其三","author":"赵希逢","text":"醉来援笔壁飞鸦，他日还能罩碧纱。\n却喜樽前低笑道，长安何处没闲花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45620,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和新市杂咏 其九","author":"赵希逢","text":"离愁别恨满沧洲，匹马匆匆去莫留。\n山尽回头人不见，齐云何日贮高楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45621,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和新市杂咏 其七","author":"赵希逢","text":"歌声娇带晓莺啼，何处糟糠更有妻。\n脉脉寸心和酒闷，明朝还恐两东西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45622,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和新市杂咏 其六","author":"赵希逢","text":"婥约精神解语花，娥娥不受点云遮。\n相看醉后还能醒，驱遣睡魔那用茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45623,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和新市杂咏 其八","author":"赵希逢","text":"新诗曾寄紫云娘，异日相逢尚未忘。\n料想匆匆恨离别，愁肠万缕系垂杨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45624,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和群鸥","author":"赵希逢","text":"素衣缟服道家流，羽化江湖作白鸥。\n清节夷齐无以过，可怜不解饿沧洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45625,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和蛾眉亭","author":"赵希逢","text":"两山相挟作眉弯，不似横云照眼寒。\n料想当年馀半额，至今留得与人看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45626,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和暮秋闻雁有怀 其一","author":"赵希逢","text":"数声雁送故乡愁，唤起沧江万顷秋。\n料想日寒风色惨，可堪寂寞冷沙洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45627,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和暮秋闻雁有怀 其二","author":"赵希逢","text":"有腹夫谁肯贮愁，笑他宋玉浪悲秋。\n征鸿纵使声多恨，怎得无声过小楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45628,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和题丹青阁 其一","author":"赵希逢","text":"落日残霞映绮疏，群山横翠壮规模。\n登临那更添风月，唤作凌烟阁内图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45629,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和题莲花壁间","author":"赵希逢","text":"乱云翠拥千层盖，拳落时听雨打声。\n长笛隔江吹晚霁，水光月色两分明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45630,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和?斋杂咏","author":"赵希逢","text":"急风狂雨三月头，门前一水涨清流。\n几回送客沧江上，愁逐乱红飞远洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45631,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋","author":"赵希逢","text":"千林摇落窍号风，怒激秋涛气势雄。\n远水兼天拖练白，晓风委地染丹红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45632,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"暑","author":"赵希逢","text":"强学刘叉赋雪车，更陪河朔饮流霞。\n漱泉枕石闲终日，满口水晶寒嚼瓜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45633,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书堂遇雨","author":"赵希逢","text":"急风吹不散，肤寸起云层。\n覆手檐如泻，寒心霤莫承。\n雷轰天上鼓，电掣眼前灯。\n掩卷兴深省，书声息口滕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45634,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏","author":"赵希逢","text":"绿暗红稀四月天，榆钱铺径撒青毡。\n雨肥渴动羹梅兴，风暖香传饼麦鲜。\n解愠更无琴可续，纳凉徒有句堪联。\n看看河朔相追逐，避暑忘形到酒边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45635,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和九日溪楼远望","author":"赵希逢","text":"明时月与日俱阳，君子如何谪远方。\n青眼相看惟旧菊，白衣不至谩空觞。\n横秋过雁书晴碧，薄暮屯云带夕黄。\n独倚危栏闲著句，惭无五字比韦郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45636,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和三衢道中","author":"赵希逢","text":"飘飘兴动酒家帘，身世都拚醉大千。\n愁逐梦魂回夜半，思随诗句到天边。\n再兴炎祚诸公力，一线桐江万古贤。\n何日洗心来伴此，不须别办买山钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45637,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和小圃","author":"赵希逢","text":"渊明从日涉，董子不窥园。\n行乐从吾好，安恬亦性根。\n我今勤抱瓮，花发应开樽。\n安得恢馀地，群珍剩阐坤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45638,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和山居","author":"赵希逢","text":"峨云羞杀鵔鸃冠，半掩山扉日不关。\n林下一般安分好，人生万事转头间。\n忘机禽鸟傍人语，入暮牛羊带日还。\n多少江山足诗料，一蓑更好伴鸥闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45639,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和不祷","author":"赵希逢","text":"艰难险阻谩曾经，有惠终输有福人。\n邈尔大钧休致问，澹然方寸自能神。\n早知造物难侥倖，何似虚怀任屈伸。\n但看四时周复始，几曾雪后不回春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45640,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和双桂堂","author":"赵希逢","text":"排云直上叫天门，路入蟾宫不问人。\n缥缈飞梯高著步，广寒有殿四无邻。\n天香飘泛非凡境，仙桂栽培今几春。\n拟欲和根都拔取，有辞还恐到严宸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45641,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和忆弟妹","author":"赵希逢","text":"行行吊影建溪南，举眼何人共急难。\n同气蜂飞缘蜜剖，群奸蚋聚为醯酸。\n荆山那得枝长合，豆泣堪伤肉自剜。\n杜老固知怀弟妹，醉愁想更忆长安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45642,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和斗斋","author":"赵希逢","text":"笑他白足道人昙，准拟来同弥勒龛。\n悬肘不须誇印大，折腰归去傲窗南。\n久藏还喜有真一，就饮何妨说后三。\n萍实拾来相对剖，味甜疑是蜜中函。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45643,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和当涂道中","author":"赵希逢","text":"至今修竹下，陈迹忆山阴。\n去去人如水，行行杖挂金。\n柳丝偏惹恨，禽语更关心。\n对景愁千斛，无言酒懒斟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45644,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和池亭即事","author":"赵希逢","text":"邂逅那堪皆我辈，一觞一咏觉情深。\n浮荣槐枕半炊梦，清兴竹林千古心。\n风涨晴空飞絮急，雨滋冷砌任苔侵。\n池亭小立便幽寂，时听清泉戛玉音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45645,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和别馆即事","author":"赵希逢","text":"溪摇日色远生光，飞絮随风上下狂。\n缬间群花连野发，锦添稚笋满林香。\n斜阳落尽千山晚，带月归来一苇航。\n老矣追欢非我事，效颦子美访黄娘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45646,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和忧世寄清溪友人","author":"赵希逢","text":"少年奋笔若挥戈，兵甲胸中数万罗。\n一片忠肝明贯日，十分辩口势悬河。\n肯同郭璞递投策，莫学楚舆狂作歌。\n四海苍生望霖雨，看看离毕致滂沱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45647,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和村居","author":"赵希逢","text":"卜筑便幽僻，相逢喜客嘉。\n充庖锄野笋，饤坐拗山花。\n竹列阶前戟，山排门外衙。\n夜深谁是伴，风月两三家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45648,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和杨花 其一","author":"赵希逢","text":"枝头的皪耀珠光，蝶使蜂媒未许忙。\n识赏何人曾眼白，形容无语可雌黄。\n溪桥月下疏横影，玉垄风前暗度香。\n今古骚人吟不尽，奚奴空背锦为囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45649,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和纸帐","author":"赵希逢","text":"拟回暖律到寒襟，落价休论直几缗。\n已唤楮生同一榻，肯容小女动纤尘。\n窗横梅影眠和月，路入梨云梦著人。\n欲效负暄献天子，暖烘烘地一笼春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45650,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和纸衾","author":"赵希逢","text":"楮缣泻出谷纹花，全幅如抛织女梭。\n春向腊前回孟季，寒催暑往任羲娥。\n洛中曾记纸增价，枕上想无诗作魔。\n任待冻云天欲雪，蒙头不信得知么。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45651,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和岩桂","author":"赵希逢","text":"嫦娥羞涩隐闺房，曾记当年窃药囊。\n奔入月中知几载，却于秋后喷幽房。\n枝头遗落兼金屑，坐上浓薰沉水香。\n恍惚蟾宫身屡到，似犹相隔一门墙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45652,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和岩桂落英","author":"赵希逢","text":"沉麝为肌蜡剪英，九霄递馥到寰瀛。\n徘徊忍离花边去，彷佛如从月窟行。\n残蕊尚堪燃古鼎，清芬真可濯尘缨。\n纷纷落尽盈杯勺，堪笑承糟空捧罂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45653,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和武兴解舟","author":"赵希逢","text":"寂寞黄昏古渡头，凄然秋思满汀洲。\n卧薪要复中原地，载荻先烧强虏舟。\n席胜长驱如朽拉，老师何苦更迍留。\n义旗直指兵无血，剩活千人世世侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45654,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和河鲀","author":"赵希逢","text":"杨花飞处贱鱼虾，蕨已抽拳韭迸芽。\n此日河鲀真剑腹，生风谷虎浪磨牙。\n品题不在八珍数，甘美从今众口誇。\n一死分明非为国，罪诚由己不关他。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45655,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和舍后植花竹","author":"赵希逢","text":"东西地袤里千馀，三径环栽松大夫。\n竹比渭川知几亩，梅移庾岭可千株。\n清欢不减巴丘橘，胜境如悬费氏壶。\n况欲万间恢广厦，莫须更有空闲无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45656,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和临清阁","author":"赵希逢","text":"蔬羹相对泼油葱，无事依僧万虑空。\n强拾放心看语录，肯将老眼犯尘红。\n本来无物台非镜，会得何心幡动风。\n料想临清高阁上，超然不与俗人同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45657,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和南剑水阁","author":"赵希逢","text":"莫把铅刀比莫邪，匣藏文采锁烟霞。\n可怜建水踪犹梗，因忆洛阳酒与花。\n寸念空劳驰北阙，真经早合诵南华。\n几回魂断云山外，一掬乡心未到家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45658,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和南浦客邸","author":"赵希逢","text":"路滑山边石，滩浑水底沙。\n晓风动银烛，夜漏滴檐花。\n身伴灯为客，心随梦到家。\n顽云痴未散，合唤阿香车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45659,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和幽居 其一","author":"赵希逢","text":"不用堆钱更买山，群峰前后翠遮阑。\n玻璃千顷清无滓，星月一天光动寒。\n得趣吟成千首易，逃空降服寸心难。\n梦魂胜境飞难到，只把翠微诗细看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45660,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和幽居 其三","author":"赵希逢","text":"云锁烟封山几重，翠微深处夕阳红。\n径迂杨柳低迷路，木古藤萝密蔽空。\n枕漱有泉兼有石，衣披和月也和风。\n落花时或随流水，恍惚桃源陌与通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45661,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和拜茶","author":"赵希逢","text":"地灵分异产，人力果何功。\n护想森神物，馀应处下风。\n叶初缄嫩绿，色敢带昏红。\n珍重春前雪，殷勤奉帝宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45662,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和借景楼","author":"赵希逢","text":"静夜延孤月，清觞酌九霞。\n歌声传皓齿，悲思类鸣笳。\n窃听酤楼管，真成献佛花。\n无端恼狂客，酒兴满天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45663,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和倪尚书生祠","author":"赵希逢","text":"风流酝藉绝绚都，鍊得身形似鹤癯。\n要为阎闾伸郁抑，促教松菊就荒芜。\n贪残安得市中虎，恩爱由遗屋上乌。\n不识在朝共尔位，用心皆似若人无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45664,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和套筒","author":"赵希逢","text":"长鸣谁敢扼吾咽，掉臂天门不受牵。\n岂是转喉能触讳，自缘贼柳欲为圈。\n几回怒起横长剑，何日归来老数椽。\n林下也休惊曲木，一般安分赛当钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45665,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和容膝","author":"赵希逢","text":"□□□常裕，看书日易消。\n乾坤同广大，风雨任飘摇。\n坐□□穿榻，安然免折腰。\n奴颜羞俗辈，华屋插云遥。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45666,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和浦城买舟 其二","author":"赵希逢","text":"丈夫傥知命，身肯委虚舟。\n不为君亲重，徙知道路忧。\n危机甘失脚，苦海莫回头。\n接迹岩墙下，滔滔皆若流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45667,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日舟中","author":"赵希逢","text":"倦客逢萸节，生涯寄叶舟。\n穷途危不顾，飞棹去难留。\n旧菊重阳日，寒芦两岸秋。\n多情惟破帽，犹恋老人头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45668,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和读史","author":"赵希逢","text":"作史先须正论持，是非便把圣经稽。\n兄诛直笔周公弟，母出声言孔伋妻。\n恶戒欺君书指鹿，报嘉食客载鸣鸡。\n至今左右严官守，谁复将桐戏剪圭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45669,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和寄王士贵","author":"赵希逢","text":"又逢南浦草生春，独咏江东日暮云。\n樽俎从容成感旧，鼎茵安否莫知君。\n寸心终夕驰千里，一见他时胜百闻。\n欲到小峰身不羽，此情脉脉倩诗云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45670,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和寄王清之","author":"赵希逢","text":"奔驰造物实为之，何日连镳共赋归。\n有梦凭谁为递到，举头恨肉不能飞。\n公门胡靳栽桃李，治世谁甘采蕨薇。\n忍死初心终不负，愿驱风鹤捷淮淝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45671,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和寄刘浩然","author":"赵希逢","text":"缘空宝镜一轮新，何处纤云更敢侵。\n四望孤城连远塞，几声哀杵间寒砧。\n月明飞鹊无依地，夜静征鸿有过音。\n报国寸心空耿耿，可怜鬓发已侵寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45672,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和寄江子岗","author":"赵希逢","text":"间关踏尽几重岗，去国悠悠路更长。\n别后三秋惊岁月，潇然一旅惯风霜。\n属厌茶味能消闷，搜搅书肠觉有香。\n过雁怀人空矫首，草书未暇事应忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45673,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和寄西山 其一","author":"赵希逢","text":"寥寥千古一西山，望著令人脚便酸。\n充腹野薇当日事，照人清节至今寒。\n未闻治世饥而死，留与凌烟画出看。\n厚卫生经非浪语，欲安家国在身安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45674,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和寄西山 其二","author":"赵希逢","text":"残胡妄欲肆穿窬，愤激英雄起草庐。\n广也数奇穷亦命，括之一败罪非书。\n梦魂北阙常倾霍，饿死西山未分蔬。\n奋志鹰扬正吾事，谁能闲立作舂锄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45675,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和寄两庠同舍","author":"赵希逢","text":"早欲排云扣帝阍，可怜驹隙过青春。\n文章未必劣班马，人物直疑分广闽。\n夜对短檠空抱恨，日愁破甑暗生尘。\n山间江上风和月，令眼傍观却笑人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45676,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和寄卢进士","author":"赵希逢","text":"珊瑚文采烂银钩，挟策相期汗漫游。\n世路商盘更周诰，旅亭楚尾望吴头。\n新诗聊写别来况，过雁俄惊客里秋。\n魂梦也知飞不到，夜长赢得数更筹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45677,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和寄陈士元","author":"赵希逢","text":"开禧一失晚方收，在位诸公似拙谋。\n逞志真成穷鸭绿，悯寒谁识遣貂裘。\n王恢首事徒开衅，广利邀功要觅侯。\n多少英雄窗下坐，沉吟无语暗搔头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45678,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和寄苕溪故人","author":"赵希逢","text":"抟砂聚散易西东，览镜颜非旧日红。\n千里雁邮成杳杳，百年驹隙去匆匆。\n暮云杜忆谪仙子，夜雪王思安道公。\n蚕室史迁非有罪，从来文士例多穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45679,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和寄范茂卿","author":"赵希逢","text":"拣芽雀舌乍辞枝，小杓分江欲试时。\n孤闷不知消几椀，睡魔立使竖降旗。\n何人紫色分金饼，入口清泉生玉池。\n搜搅胸中书传起，谁能扪腹不吟诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45680,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和清富楼 其二","author":"赵希逢","text":"对景谁能不赋诗，凭高著眼到幽微。\n下临无地仙三岛，水远兼天山四围。\n岂但追陪闲著句，更应珍重为留衣。\n北山他日移文去，蕙帐无人月满扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45681,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和祷富沙","author":"赵希逢","text":"也知铜玉宁无璞，自是蒙金合以沙。\n俛首何辜联盗械，脱身无路觅仙槎。\n怀珍空自经三献，受用何尝得五车。\n事业万分浑杳一，可怜早已发生华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45682,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和登楼晚望 其一","author":"赵希逢","text":"远山寒暮景，无事试登楼。\n泛渚鸥终日，书空雁迎秋。\n朱帘高卷□，雨渡自横舟。\n望极到何许，水穷天尽头。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45683,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和谢仵判院惠米","author":"赵希逢","text":"忧辱都非言行招，孤忠自莫胜群嚣。\n已甘逆旅长糊口，无复有言能副腰。\n一士岂无关国论，九重亦合采民谣。\n莫教流落江湖上，笑酌天浆独举瓢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45684,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和感应王祠","author":"赵希逢","text":"无端治世苦幽囚，千古空贻善类羞。\n格是爱君身敢恤，势须苦口疾方瘳。\n明祠傥鉴长非罪，异日焉知广不侯。\n一片忠肝明白甚，可怜无计彻凝旒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45685,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和题泽民庙","author":"赵希逢","text":"落霞晴云淡白黎，何人清梦绕山溪。\n邯郸枕上占炊黍，审雨堂中慰望霓。\n血食不随今古变，洪休直与国家齐。\n乞灵仆仆纷行客，得意都忘筌与蹄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45686,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和题富沙庙","author":"赵希逢","text":"瞬息鳞鳞万瓦空，伊谁叱驭半空中。\n郁攸饮气收残焰，群祀甘心处下风。\n坤转乾旋神有□，离居坎上水无功。\n乞灵何日趋祠下，借助青霄作凤冲。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45687,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]