[{"title":"多稼亭前小步","author":"杨万里","text":"樱桃抛过隔墙莟，芍药丛抽刺土芽。\n最是蜜蜂无意思，忍将尘脚踏梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66968,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"多稼亭看梅二首 其二","author":"杨万里","text":"梅花不合太争春，政盛开时却恼人。\n试折一枝轻著手，惊飞万点扑衣巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66969,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"多稼亭看梅二首 其一","author":"杨万里","text":"先生次第即还家，更上城头一望赊。\n行尽荒寒无意思，不如来此看梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66970,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"多稼亭宴客","author":"杨万里","text":"归来不省醉还醒，只怪谯门打一更。\n秉烛径穿梅下过，此身真在雪中行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66971,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庆长叔招饮一杯未釂雪声璀然即席走笔赋十诗 其六","author":"杨万里","text":"急雪穿帘绕蜡灯，梅花微笑古铜瓶。\n朔风恶剧惊人杀，吹倒琉璃六曲屏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66972,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庆长叔招饮一杯未釂雪声璀然即席走笔赋十诗 其二","author":"杨万里","text":"长廊尽处绕梅行，过尽风声得雪声。\n醉里不愁飘湿面，自舒翠袖点琼英。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66973,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庆长叔招饮一杯未釂雪声璀然即席走笔赋十诗 其四","author":"杨万里","text":"梅花得雪更清妍，折入灯前细撚看。\n下却珠帘教到地，横枝太瘦不禁寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66974,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庆长叔招饮一杯未釂雪声璀然即席走笔赋十诗 其九","author":"杨万里","text":"酒香端的似梅无，小摘梅花浸酒壶。\n莫遣南枝独醒著，一杯聊劝雪肌肤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66975,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庆长叔招饮一杯未釂雪声璀然即席走笔赋十诗 其五","author":"杨万里","text":"雪政飞时梅政开，倩人和雪折庭梅。\n莫教颤脱梢头雪，千万轻轻折取来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66976,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庆长叔招饮一杯未釂雪声璀然即席走笔赋十诗 其八","author":"杨万里","text":"不是今宵雪不清，只愁清杀老书生。\n不知落得几多雪，做尽北风无限声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66977,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庆长叔招饮一杯未釂雪声璀然即席走笔赋十诗 其一","author":"杨万里","text":"晚饮西邻大阮家，天风吹雪入檐牙。\n呼僮净扫青苔地，莫遣纤尘涴玉花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66978,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庆长叔招饮一杯未釂雪声璀然即席走笔赋十诗 其三","author":"杨万里","text":"老子那知鬓脚凋，忍寒拚命看珠跳。\n却嫌地暖无冰冻，恰则飞来恰则销。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66979,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"廷弼弟座上绝句","author":"杨万里","text":"黄雀初肥入口销，玉醅新熟得春饶。\n主人更恐香无味，沉水龙涎作伴烧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66980,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戏咏陈氏女剪綵花二绝句 其一 拒霜","author":"杨万里","text":"染露金风里，宜霜玉水滨。\n莫嫌开最晚，元自不争春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66981,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戏咏陈氏女剪綵花二绝句 其二 菊","author":"杨万里","text":"味苦谁能爱，香寒只自珍。\n长将潭底水，普供世间人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66982,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戏笔二首 其二","author":"杨万里","text":"哦诗只道更无题，物物秋来总是诗。\n著意染须玄尚白，梳头得虱素成缁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66983,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戏綵堂前海棠","author":"杨万里","text":"露揉雨渍柳方浓，日晒风曛杏政烘。\n祗有海棠非旋染，粟来大小便鲜红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66984,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戏跋朱元晦楚辞解二首 其二","author":"杨万里","text":"霜后藜枯无可羹，饥吟长作候虫声。\n藏神上诉天应泣，支赐江蓠与杜蘅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66985,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戏跋朱元晦楚辞解二首 其一","author":"杨万里","text":"注易笺诗解鲁论，一帆径度浴沂天。\n无端又被湘累唤，去看西川竞渡船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66986,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戏嘲金灯花上皂蝶","author":"杨万里","text":"花须为饭露为浆，黑雾玄霜剪薄裳。\n飞绕金灯来又去，不知能有几多香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66987,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戏题","author":"杨万里","text":"蜂居笔管没人知，谁遣啾啾不住时。\n最是蜗牛太多事，长将宅子自相随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66988,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戏题水墨山水屏","author":"杨万里","text":"棹郎大似半边蝇，摘蕙为船折草撑。\n今夜不知何处泊，浪头正与岭头平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66989,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戏题岸柳","author":"杨万里","text":"斫尽江边杨柳梢，要教新岁换新条。\n老夫也镊霜须鬓，镊却霜根出雪苗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66990,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戏题郡斋水墨坐屏二面二首 其二","author":"杨万里","text":"荆溪四面四无山，不是荒林即野田。\n忽有石崖天半出，飞泉落处稍人烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66991,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戏题郡斋水墨坐屏二面二首 其一","author":"杨万里","text":"两客呼船一急行，树林半落半犹青。\n诸峰最是中峰好，我欲峰头筑小亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66992,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戏赠子仁侄","author":"杨万里","text":"小阮新来觅句忙，自携破砚汲寒江。\n天公念子抄诗苦，借与朝阳小半窗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66993,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"早行鸣山二首 其二","author":"杨万里","text":"灵山未见见龟山，且捲诗书子细看。\n春日幸从年后暖，春风须带腊前寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66994,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"早行鸣山二首 其一","author":"杨万里","text":"淡淡清霜薄薄冰，晓寒端为作新晴。\n殷勤唤醒梅花睡，枝上春禽一两声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66995,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"早朝紫宸殿贺雪呈尤延之二首 其二","author":"杨万里","text":"雪妃月姊宴群仙，珠阁银楼集玉鸾。\n老子来看收不彻，梅梢拾得水精盘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66996,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"早朝紫宸殿贺雪呈尤延之二首 其一","author":"杨万里","text":"雪花将瑞献君王，晴早销迟恋建章。\n不肯独清须带月，犹嫌未冷更吹霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66997,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"曲湾放船","author":"杨万里","text":"梅子成阴夹道周，木绵吐焰满江头。\n春来不是无桃李，腊月开花已落休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66998,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"有叹","author":"杨万里","text":"饱喜饥嗔笑杀侬，凤皇未可笑狙公。\n尽逃暮四朝三外，犹在桐花竹实中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66999,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"有叹","author":"杨万里","text":"老来无面见毛锥，犹把闲愁付小诗。\n若道愁多头易白，鹭鸶从小鬓成丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67000,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江上松径","author":"杨万里","text":"一日江行百折中，回头犹见夜来峰。\n好山十里都如画，更与横排一径松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67001,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江下送客","author":"杨万里","text":"却因送客动归心，过市逢喧闷不禁。\n偶见人家好池馆，柳行尽处一亭深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67002,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江山道中蚕麦大熟三首 其一","author":"杨万里","text":"衢信中央两尽头，蚕麰今岁十分收。\n穗初黄后枝无绿，不但麦秋桑亦秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67003,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江天暮景有叹二首 其二","author":"杨万里","text":"一鹭南飞道偶然，忽然百百复千千。\n江淮总属天家管，不肯营巢向北边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67004,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江天暮景有叹二首 其一","author":"杨万里","text":"只争一水是江淮，日暮风高云不开。\n白鹭倦飞波政阔，都从淮上过江来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67005,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江行七日阻风至繁昌舍舟出陆二首 其二","author":"杨万里","text":"山行辛苦水行愁，只是诗人薄命休。\n管取如今遵陆了，云开风顺水东流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67006,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江行七日阻风至繁昌舍舟出陆二首 其一","author":"杨万里","text":"日日江行怖杀侬，逆风恶浪打船篷。\n只今判却肩舆去，遮莫掀天浪与风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67007,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江郎峰三石山在江山县南三十五里礼贤镇望之极正里人又呼为郎峰","author":"杨万里","text":"走遍名山脚不停，见渠令我眼偏明。\n郎峰好处端何似，笋剥三竿紫水精。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67008,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江雨三首 其三","author":"杨万里","text":"翡翠洲横绿锦山，真珠汁洗水精砖。\n江天万景无拘管，乞与诗人塞满船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67009,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江雨三首 其二","author":"杨万里","text":"雨里油窗莫要关，滴来堪玩洒堪闻。\n万珠贡入龙宫了，剩得檐前数颗看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67010,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江雨三首 其一","author":"杨万里","text":"雨点飞来水面初，湿银盘里走真珠。\n龙宫可是忙收拾，万斛齐倾半霎无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67011,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题代度寺","author":"杨万里","text":"一别重来十五年，残僧半在寺依然。\n黄杨当日绝低小，已过危檐也可怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67012,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"池冰二首 其二","author":"杨万里","text":"怕寒不敢上高台，上得高台急急回。\n日欲消冰风不允，天犹未夕月先来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67013,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"池冰二首 其一","author":"杨万里","text":"池底枯荷瘦不胜，池冰新琢玉壶凝。\n如何留到炎蒸日，上有荷花下有冰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67014,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"池亭双树梅花","author":"杨万里","text":"开尽梅花半欲残，两株晴雪作双寒。\n团栾绕树元无见，只合池亭隔水看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67015,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"汤田早行见李花甚盛二首 其二","author":"杨万里","text":"似妒梅花早，同时斗雪肤。\n新年三二月，还解再开无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67016,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"汤田早行见李花甚盛二首 其一","author":"杨万里","text":"此地先春信，年年只是梅。\n南中春更早，腊日李花开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67017,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"竹枝歌七首 其七","author":"杨万里","text":"幸自通宵暖更晴，何劳细雨送残更。\n知侬笠漏芒鞋破，须遣拖泥带水行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67018,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"竹枝歌七首 其六","author":"杨万里","text":"月子弯弯照几州，几家驩乐几家愁。\n愁杀人来关月事，得休休处且休休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67019,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"竹枝歌七首 其五","author":"杨万里","text":"岸旁燎火莫阑残，须念儿郎手脚寒。\n更把绿荷包热饭，前头不怕上高滩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67020,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"竹枝歌七首 其四","author":"杨万里","text":"积雪初融做晚晴，黄昏恬静到三更。\n小风不动还知么，且只牵船免打冰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67021,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"竹枝歌七首 其三","author":"杨万里","text":"船头更鼓恰三槌，底事荒鸡早个啼。\n戏学当年度关客，且图一笑过前溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67022,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"竹枝歌七首 其二","author":"杨万里","text":"莫笑楼船不解行，识侬号令听侬声。\n一人唱了千人和，又得蹉前五里程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67023,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"竹枝歌七首 其一","author":"杨万里","text":"吴侬一队好儿郎，只要船行不要忙。\n著力大家齐一拽，前头管取到丹阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67024,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"米囊花二首 其二","author":"杨万里","text":"鸟语蜂喧蝶亦忙，争传天诏诏花王。\n东皇羽卫无供给，探借春风十日粮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67025,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"米囊花二首 其一","author":"杨万里","text":"铅膏细细点花梢，道是春深雪未销。\n一斛千囊苍玉粟，东风吹作米长腰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67026,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"红叶","author":"杨万里","text":"诗人满腹著清愁，吐作千诗未肯休。\n写遍壁间无去处，却将红叶强题秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67027,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自生米小路出舞阳渡","author":"杨万里","text":"独径千盘绕水田，初逢官路一欣然。\n舞阳渡口新河水，白发重来二十年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67028,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自金陵西归至豫章发南浦亭宿黄家渡","author":"杨万里","text":"过了重湖雪浪堆，章江欲尽淦江来。\n到家无此江山景，画舫行迟不用催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67029,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自值夏小溪泛舟出大江","author":"杨万里","text":"放溜山溪一叶轻，山溪尽处大江横。\n舟中寂寂无人语，只有波声及雨声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67030,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自彭田铺至汤田道旁梅花十馀里","author":"杨万里","text":"一行谁栽十里梅，下临溪水恰齐开。\n此行便是无官事，只为梅花也合来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67031,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自跋江西道院集戏答客问 其二","author":"杨万里","text":"客从南渡向侬来，我马西征拜此台。\n若问个中何所有，一腔热血和诗裁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67032,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自跋江西道院集戏答客问 其一","author":"杨万里","text":"问我来朝南内南，便从花底趁朝参。\n新诗犹作江西集，为带筠州刺史衔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67033,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自遣","author":"杨万里","text":"莫将一病苦忧煎，山尚能游石可眠。\n匹似病风兼病脚，老夫犹是地行仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67034,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自嘲白须三首 其一","author":"杨万里","text":"强惜数茎须，惟愁白却渠。\n朝来都白尽，愁惜两何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67035,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自嘲白须三首 其三","author":"杨万里","text":"涅髭只诳客，那可诳妻儿。\n诳得妻儿著，还能诳面皮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67036,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"至日前思亲","author":"杨万里","text":"节近亲庭远，天寒日暮时。\n未风窗已报，欲雪脚先知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67037,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"至永和","author":"杨万里","text":"出城即便见青原，正在长江出处天。\n却到青原望城里，楼台些子水云边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67038,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"至后入城道中杂兴十首 其十","author":"杨万里","text":"春时宿处雨浪浪，至后重投张氏庄。\n际晚乌银何许买，夕阳特地恋寒窗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67039,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"至后入城道中杂兴十首 其九","author":"杨万里","text":"忽见轻绡三两重，横遮万丈翠屏风。\n老夫细熨䰒松眼，却是青原隐雾中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67040,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"至后入城道中杂兴十首 其八","author":"杨万里","text":"谁练苕花作雪茸，更将枫叶染猩红。\n姮娥不认推青女，青女又还推化工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67041,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"至后入城道中杂兴十首 其七","author":"杨万里","text":"山路肩舆倦仆夫，家兄为我酒频沽。\n卖薪人散知城近，啼柳乌忙觉日晡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67042,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"至后入城道中杂兴十首 其六","author":"杨万里","text":"丰年物物总欣驩，不但人和畜亦蕃。\n簸处金肤肥彘母，舂馀珠屑饱鸡孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67043,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"至后入城道中杂兴十首 其五","author":"杨万里","text":"长亭阿姥短亭翁，探借桃花作面红。\n酒熟自尝仍自卖，一生割据醉乡中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67044,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]