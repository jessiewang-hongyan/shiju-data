[{"title":"云云","author":"宋伯仁","text":"休将閒耳听云云，只作深居耳不闻。\n素志肯随时节改，清贫难许利名分。\n忘情茅屋无非燕，著脚春山独是云。\n试问急流谁勇退，故园同看木欣欣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48252,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"午睡","author":"宋伯仁","text":"午梦惊回笋簟凉，坦夷襟度即潇湘。\n诗高自与梅花好，食淡方知菜味长。\n事说万端多画虎，人无一念不亡羊。\n满头飞絮春零乱，莫笑狂夫老更狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48253,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出陆","author":"宋伯仁","text":"吴陵咫尺是惟扬，徒步方知去路长。\n渔屋试霜芦叶老，酒家留客豆花香。\n秋光浅淡人同瘦，雁影参差我共忙。\n仆子莫嗟行李重，担头强半旧诗囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48254,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"四十","author":"宋伯仁","text":"役役人间世，齐头四十年。\n读书虽未已，作事亦徒然。\n宦业蕉中鹿，生涯叶底蝉。\n愿逢时务好，一榻醉时眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48255,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"对菊","author":"宋伯仁","text":"少有惺惺得到头，此心何苦懒方收。\n五湖烟雨常如昔，一稔功名自不由。\n世事莫将真个看，客程难作旧时留。\n人间岂少渊明□，见著黄花便合羞。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48256,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"民夫","author":"宋伯仁","text":"阃帅差夫欲太平，浚河才了又修城。\n挑泥锹钁无休日，失业妻儿有叹声。\n两个布衫寒透骨，半盂蒸饭冷无羹。\n何时一统山河了，只向春田带雨耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48257,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"瓜洲阻风","author":"宋伯仁","text":"狂风未许放归船，借得僧房半榻眠。\n落雁影收帆脚外，怒涛声到枕头边。\n黄芦叶底秋将老，白羽书中病未痊。\n传语将军多著力，扬州不比旧家年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48258,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"边头老马","author":"宋伯仁","text":"解下缰绳便欲眠，绝无筋力可胜鞭。\n霜蹄遍识淮南地，夜草犹吞塞北烟。\n怕逐綵旗排偃月，宁思金镫趁朝天。\n华山自有安身处，试问将军在几年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48259,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再会夏石芝","author":"宋伯仁","text":"自与君相别，骎骎已数年。\n一缄书不寄，千里梦徒然。\n雨店花新长，风棂月几圆。\n岭梅无恙否，愁满鬓丝边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48260,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"安居","author":"宋伯仁","text":"穷通岂在苦劳神，且作安居懒散人。\n买地种花多种竹，煮茶邀客也邀邻。\n求名岂识书三上，得兴无过醉一巡。\n喜得满?收芋栗，杜陵应未笑全贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48261,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岁旦","author":"宋伯仁","text":"居閒无贺客，早起只如常。\n桃版随人换，梅花隔岁香。\n春风回笑语，云气卜丰穰。\n柏酒何劳劝，心平寿自长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48262,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自叹","author":"宋伯仁","text":"又作淮南客，边尘压鬓毛。\n夜长蛩聒聒，家远雁忉忉。\n把酒天徒问，推篷月正高。\n英雄四方志，休恋故人袍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48263,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"行色","author":"宋伯仁","text":"拟作惟扬数月留，西风劝我买归舟。\n功名得失千年梦，豪杰穷通万斛愁。\n黄菊已花休恋酒，青山何处不登楼。\n渔翁自倚船篷睡，一任男儿白尽头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48264,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初冬","author":"宋伯仁","text":"过了重阳便作寒，貂裘心事未容安。\n贫时侯伯人难识，醉里乾坤我自宽。\n红叶已飘千万点，黄花羞对两三般。\n小窗破处须频补，莫放西风正眼看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48265,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初夏","author":"宋伯仁","text":"杜宇枝头雨未乾，晓来犹学夜来寒。\n花如旧日全然少，梅亦何心只尔酸。\n世事浅深连酌酒，春光行止一凭阑。\n流莺默默浑无语，只把游人冷眼看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48266,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"呈可斋先生陈侍郎","author":"宋伯仁","text":"男儿心事少陵诗，不与英雄说又谁。\n衰鬓未甘无用处，壮怀图见太平时。\n休惭夜雨挑寒灺，喜听春枰改旧棋。\n一信暖风花万蕾，孤根应发冻梅枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48267,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"呈菊坡先生陈枢使","author":"宋伯仁","text":"但知猿鹤伴闲居，不觉忧时鬓已疏。\n对客怕言今日事，挑灯重读少年书。\n楼迎山色诗堪画，门对梅花月共锄。\n相业累兴明主意，先生只恐自踌躇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48268,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"妙智庵","author":"宋伯仁","text":"结屋占山巅，源流未有年。\n便非真隐者，且喜得安然。\n石洞云同卧，茶铛客对煎。\n我来聊小憩，诗满夕阳天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48269,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"村市","author":"宋伯仁","text":"山暗风屯雨，溪浑水浴沙。\n小桥通古寺，疏柳纳残鸦。\n苜蓿重沽酒，芝麻旋点茶。\n愿人长似旧，岁岁插桃花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48270,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"村庄即事","author":"宋伯仁","text":"青旗猎猎又村庄，仙景还他是水乡。\n人近七旬头未白，山无重数叶初黄。\n稻畦明月家家酒，茅屋清歌处处霜。\n满地菊花秋欲老，客怀牢落愧重阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48271,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"苏州有感","author":"宋伯仁","text":"秋意满姑苏，扁舟忆五湖。\n铃声边报急，帆影客心孤。\n野港青如染，遥山澹欲无。\n英雄应念我，时事满银须。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48272,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闷中","author":"宋伯仁","text":"一千里外鬓斑斑，枉被微官夺笑颜。\n酒后稍知寒力退，闷中尤惜世途艰。\n丹砂药剂宁如健，钟鼎功名不似闲。\n何日五湖深处住，四窗烟雨纳青山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48273,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闷甚","author":"宋伯仁","text":"酴醾开已残，窗户尚轻寒。\n往事多因拙，清尊强自宽。\n对妻怜病久，顾影易心酸。\n更展渊明集，从头子细看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48274,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"到家","author":"宋伯仁","text":"尘压征裘满，今朝喜到家。\n牵衣儿欲泪，满地菊初花。\n瓦甑添蒸芋，铜铛旋煮茶。\n安贫儒者事，何必恋天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48275,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜过乌镇","author":"宋伯仁","text":"望极模糊古树林，弯弯溪港似难寻。\n荻芦花重霜初下，桑柘阴移月未沉。\n恨别情怀虽恋酒，送衣时节怕闻砧。\n夜行船上山歌意，说尽还家一片心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48276,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"苦雨督鹾课甚迫","author":"宋伯仁","text":"仆仆驱驰梦不安，猥哉谁恤买鹾官。\n星台阁住春来俸，雨意翻成夜半寒。\n可说话人能几辈，难区处事更多般。\n桃花一日都开了，插满铜瓶亦倦看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48277,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨中","author":"宋伯仁","text":"终日翻盆雨，池亭晚更凉。\n对琴思古意，酾酒惜韶光。\n绿涨便鸥懒，残花笑蝶忙。\n高田皆可插，好与报君王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48278,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"拼桑得替题道院","author":"宋伯仁","text":"煮海三年不等闲，几多归梦绕青山。\n鸢肩诗瘦羞郊岛，蜗角名虚愧触蛮。\n戈淅剑炊恬砑耐，云翻雨覆任痴顽。\n知机人识圆机意，尽在西风一笑间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48279,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春半","author":"宋伯仁","text":"春到已多时，游人替衲衣。\n柳眠莺唤醒，花瘦雨添肥。\n官事痴能了，人情久易非。\n一贫能自守，赢得掩柴扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48280,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"柬赵监盐","author":"宋伯仁","text":"西风吹破黑貂裘，多少江山惜倦游。\n红叶已霜天欲暮，绿蓑初雨客吟秋。\n人逢知己无荣辱，事不萦怀任去留。\n但是菊花开便好，醉中休说异乡愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48281,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"烂溪","author":"宋伯仁","text":"几家篱落傍溪居，只看青山尽自如。\n隔岸有桥多卖酒，小篮无处不提鱼。\n何时茅屋人同住，旋买瓜田雨自锄。\n寄语牧童休笑我，都缘错读半生书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48282,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋风","author":"宋伯仁","text":"秋风卷秋叶，秋思满秋天。\n骨立山如削，声低雁欲眠。\n客愁无暇日，农事喜丰年。\n说著鲈莼事，归心满钓船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48283,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋雨简刘主簿","author":"宋伯仁","text":"秋到天涯未两旬，西风无日不霖霪。\n数行新雁千门晓，十幅轻帆万里心。\n薄宦只宜闻早去，长淮未许作狂吟。\n江南谁倚阑干曲，丹桂香中酒自斟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48284,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺元枢游先生除右相","author":"宋伯仁","text":"元枢登相未为奇，奇在先生甚懒为。\n四海熙熙今有日，九重眷眷已多时。\n人才岂用拘彝调，边事常如援拙棋。\n天下儿童颂君实，太平欣卜万年基。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48285,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺凤山先生李文昌赴召","author":"宋伯仁","text":"国老如公仅几人，岂宜长啸太湖滨。\n畴咨宰相调元化，诏趣尚书侍紫宸。\n欲振国威千载立，当从局面一番新。\n先生莫作前时看，多少枯根望早春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48286,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺游先生再入元枢","author":"宋伯仁","text":"粤从宝绍历嘉淳，国事如棋局几新。\n欲识万年占气脉，须教一著顿精神。\n重臣休惮头盈雪，赤子咸期屋自春。\n天下倚公心更切，泰山宗社在垂绅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48287,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺鹤林吴尚书赴召除隆兴","author":"宋伯仁","text":"鸾翔芝检下溪堂，醉梦惊回午正凉。\n宠报帝俞催宰相，且将州绂召文昌。\n蘋花襟袖宫花近，诗草帘栊谏草香。\n大化一新多吉士，卷阿历历告成王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48288,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送庐陵王月窗秀才之武昌谒秋壑贾侍郎","author":"宋伯仁","text":"一緉芒鞋一橐诗，等闲西上欲何之。\n青原山下家虽远，黄鹤楼前笛未吹。\n秋壑最宜秋到后，月窗当趁月明时。\n问君如见调羹手，说寄梅花寄阿谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48289,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送杨提干过淮求辟","author":"宋伯仁","text":"功名会底不为难，莫把登科作等闲。\n豪杰岂容忘矢石，行藏只要识机关。\n天连芳草千家雨，月照长芦四面山。\n但是辟书休自懒，偏亲绿鬓已成斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48290,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"值雨","author":"宋伯仁","text":"吴陵两月雨留连，来问琼花雨亦然。\n市酒未销狂客恨，塞鸿先作嫩寒天。\n只忧松下无三径，不管囊中欠一钱。\n扬子渡头风正急，未知何日买归船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48291,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"席上有举东坡集归去来字成诗十首醉中戏续一首","author":"宋伯仁","text":"傲世欲何求，归来已倦游。\n琴诗聊自啸，丘壑复相留。\n问菊时携酒，乘风或棹舟。\n乐天良有以，心事老田畴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48292,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"通新代者书偶作","author":"宋伯仁","text":"庭阴日日杜鹃啼，问我胡为未赋归。\n官况苦如梅豆小，人情轻似柳绵飞。\n三年独自知操纵，两耳从他说是非。\n瓜戍喜催新代者，呆衫应许换征衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48293,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"都闉遭爇","author":"宋伯仁","text":"融风何事入神州，一扫天衢万百楼。\n莫为朱门誇炙手，又令赤子叹焦头。\n诗人幸有湖山在，壮士难为富贵谋。\n世事可惊言不尽，得休休处便休休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48294,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"酒边","author":"宋伯仁","text":"一醉复一醉，陶陶醉未休。\n何伤于日月，知我者春秋。\n万事难追昔，千金不解愁。\n白鸥飞浩荡，此兴属渔舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48295,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄旧友二首 其二","author":"宋伯仁","text":"微官宁得似穷儒，俛首逢迎气不舒。\n便是伐薪能煮海，何如烧叶自观书。\n半蓬寒雨苕溪酒，一线西风震泽鱼。\n但得此身无系束，江南有地著顽疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48296,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄旧友二首 其一","author":"宋伯仁","text":"男儿未遇总英雄，漂饭非怜计已穷。\n鲍叔但能知管仲，孔明何必拜庞公。\n秋江萍梗人何处，夜月梅花梦亦同。\n借问选诗编几许，玄晖潇散渐唐风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48297,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄白子元","author":"宋伯仁","text":"一番书满两番求，千里重来我更羞。\n薄世告人难启口，小官何事不担忧。\n知心唯有长天月，把酒还思故国秋。\n只待菊花开遍了，半蓑寒雨上轻舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48298,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄呈东圳先生曹侍郎","author":"宋伯仁","text":"芝书催觐已多时，底事归班似懒归。\n诸老正缘无定说，先生只得暗知机。\n柳花樽俎春千点，竹屋云山绿四围。\n东圳东边行乐遍，不妨款曲上黄扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48299,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄呈检正徐侍郎","author":"宋伯仁","text":"纹楸一著响新棋，惊起英雄睡足时。\n南渡欲恢前汉业，北窗谁恋晚唐诗。\n熬波沧海徒劳尔，举酒青天欲问之。\n吾道正归公造化，暖风须到落花枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48300,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄郑贡父秀才","author":"宋伯仁","text":"至友惜分飞，嘹嘹雁独知。\n想斟新社酒，多读盛唐诗。\n白发愁何虑，清贫久却宜。\n曾观时事否，又是一盘棋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48301,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄海安林监镇","author":"宋伯仁","text":"风摇红叶下林端，又见长淮九月寒。\n诗草未谐唐律吕，菊花如忆晋衣冠。\n目穷鹾灶烟初息，梦想亭沙雨未乾。\n客宦有缘随处好，不须来作小场官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48302,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄海安赵路分","author":"宋伯仁","text":"雨湿中秋节，重阳始得晴。\n菊花荣辱重，萍梗去留轻。\n诗卷抄无尽，乡书写未成。\n鲈鱼如钓得，分我一杯羹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48303,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄楼云卧","author":"宋伯仁","text":"云卧西湖又几年，吟鞍多在酒炉边。\n定知今古皆春梦，不把功名作宿缘。\n芳草满汀山带雨，黄梅落地水连天。\n相逢未说江南事，且问何时理钓船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48304,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题天台王主簿约牖","author":"宋伯仁","text":"世道巇岖可厌寻，牖名以约孰知音。\n数棂秋雨千年事，一剔寒篝万古心。\n山入酒卮青耿耿，风摇槐影绿愔愔。\n坎爻六四君休说，笑拍阑干月满襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48305,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题临江玉实斋司户百花洲","author":"宋伯仁","text":"锦囊诗里识花洲，何日清江得醉游。\n百亩故园重饾饤，四贤遗像愈风流。\n香浮红树春应早，雪压寒梅月想留。\n我有烟波鱼具了，一丝风底愿维舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48306,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"曹娥谢赵菊庄相访","author":"宋伯仁","text":"江程潮汛小，沙碛缆行舟。\n挈酒寻诗好，披心话客愁。\n云归山欲晚，风急雨如秋。\n可惜相逢处，匆匆不少留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48307,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清和","author":"宋伯仁","text":"诗债还无足，家园亦倦看。\n客游宜致仕，午睡当之官。\n舌笑张仪在，心凭达摩安。\n清和天气好，应免夹衣寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48308,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渔父吟","author":"宋伯仁","text":"小舟如雁许，稳稳下波心。\n蓑笠几风雨，江山无古今。\n清歌鸣短棹，红叶满疏林。\n一醉不知世，前村月未沈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48309,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪后","author":"宋伯仁","text":"暖地难为雪，春天易得晴。\n落梅狂客意，啼鸟故园声。\n愁乐从他事，湖山寄此生。\n愿将身与世，浑似柳梢轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48310,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寓兴","author":"宋伯仁","text":"又近重阳节，伤心事可嗟。\n塞鸿河洛志，篱菊古今花。\n苦雨床俱漏，颠风扇莫遮。\n渔船如一叶，快活似侬家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48311,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寓西马塍","author":"宋伯仁","text":"十亩荒林屋数间，门通小艇水湾湾。\n人行远路多嫌僻，我得安居却称闲。\n樽酒相忘霜后菊，一诗难尽雨中山。\n何时漾下浮名事，只与田翁剩往还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48312,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"楮先生","author":"宋伯仁","text":"先生邂逅龙亭日，多少云仍满世间。\n千古典谟文独记，九流毫发事相关。\n代庖阿堵名尤重，制甲防边职未閒。\n只与道人为鹤帐，始能清梦绕湖山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48313,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"焦山简主僧无庵","author":"宋伯仁","text":"轻摇风桨过焦山，山色相留半日闲。\n万顷月波秋雨后，一篝烟翠夕阳间。\n城依铁瓮心尤壮，酒对金峰鬓惜斑。\n愿得淮头来好语，吸江亭下且怡颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48314,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登海陵城","author":"宋伯仁","text":"淮楚年年一番秋，西风惯识古谯楼。\n金汤城壁休清野，玉帐英雄未白头。\n霜草万家人冷落，冻云千叠雁绸缪。\n中原目即难修整，且对屯兵说近愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48315,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答林巡检惠诗","author":"宋伯仁","text":"客久情怀恶，逢人懒说诗。\n不堪秋到后，将近雁来时。\n攲枕皆归梦，同心只旧知。\n渊明篱下菊，谁伴傲霜枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48316,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答林行父","author":"宋伯仁","text":"男儿未肯著渔蓑，且把屠龙一剑磨。\n宣室岂容无贾谊，词林尚可著廉颇。\n壮怀每被愁怀恼，官况宁如旅况多。\n我欲便归归未得，江南孤负采菱歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48317,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]