[{"title":"坐客宋周士忽垂光和复用元韵答之三首 其一","author":"强至","text":"魏台营妓胜添酥，一笑堪酬百琲珠。\n只恐更深云雨散，明朝共是守寒炉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75586,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"坐客宋周士忽垂光和复用元韵答之三首 其二","author":"强至","text":"风流双腕转凝酥，舞彻伊州汗有珠。\n探手始知帘外冷，照堂兽炭焰围炉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75587,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宋周士以新蕈为惠并示佳句依韵和答","author":"强至","text":"食蕈由来胜茹芝，十年此味望晴霓。\n雕盘细簇春云朵，惠我殷勤助杀鸡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75588,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"张升甫惠新笋走笔代简谢之","author":"强至","text":"粉箨迎霜嫩更匀，中厨未有许尝新。\n明朝便好供佳客，只恨杯羹欠紫莼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75589,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"张文通以诗觅小桃走笔依韵和答","author":"强至","text":"名园闻说洛阳春，金谷前无石季伦。\n第一牡丹应惯见，怜君翻作觅花人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75590,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"李景初许借剪綵花数轴一观累日不至戏成二绝督之 其二","author":"强至","text":"剪綵茸茸细逼真，秋风堂上数枝春。\n为偷造化防天觉，却拟深藏不借人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75591,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"李景初许借剪綵花数轴一观累日不至戏成二绝督之 其一","author":"强至","text":"壶蜂蛱蝶日徘徊，只欠生香去复来。\n应是春风随玉指，剪刀行处一花开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75592,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杨公济以诗索粉纸依韵和答","author":"强至","text":"春云落纸不归天，就把霜刀剪四边。\n欲送草堂还缩手，少陵惯见浣花笺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75593,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泛湖有作","author":"强至","text":"不比危湍急濑船，平湖慢桨恰相便。\n蓬飘萍泛真吾事，舞袖歌鬟付少年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75594,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"走笔依韵和酬王彦霖四首 其四","author":"强至","text":"不住年光衮衮流，莺花渐老使人愁。\n莺犹可听花犹在，再卜他时一醉休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75595,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"走笔依韵和酬王彦霖四首 其三","author":"强至","text":"夫子人间第一流，清言暂隔已离愁。\n今朝偶负寻春约，诗思勾牵未肯休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75596,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"走笔依韵和酬王彦霖四首 其二","author":"强至","text":"感旧情怀日日深，三春能几半晴阴。\n醉题难尽当时意，啼彻春风羡暮禽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75597,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"走笔依韵和酬王彦霖四首 其一","author":"强至","text":"几度春风信陆沉，曾题醉笔写花阴。\n诗情不复随风乱，今日花前对展禽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75598,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"辛卯七夕悼往","author":"强至","text":"忆共佳人曝绣衣，馀香如昨旧欢非。\n鹊桥虽别年年在，犹胜娇魂去不归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75599,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"閒卿遽垂和答复依元韵戏之","author":"强至","text":"师怨白云相望久，撇然便欲揽征衣。\n其如飞雪能留客，不放禅翁及早归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75600,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"閒卿遽然云别因书二十八言奉送","author":"强至","text":"禅翁为我出岩扉，坐席才温便拂衣。\n又道孤云无定所，如何却傍旧山归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75601,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陈伯成学士垂访以病中新浴不克见走书二短篇谢之 其一","author":"强至","text":"时情逐势饵边鱼，贫病由来俗易疏。\n何事太丘直有道，炎天问病到贫居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75602,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陈伯成学士垂访以病中新浴不克见走书二短篇谢之 其二","author":"强至","text":"病肤新浴觉神还，散发支颐一室间。\n岂敢不冠延重客，空将感抱寄惭颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75603,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵和栽花二阕 其一","author":"强至","text":"前后殷勤选众芳，名园移植总成行。\n要须花笑春风里，次第迎公入醉乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75604,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵和栽花二阕 其二","author":"强至","text":"移花新了诏书来，似负迎春著意栽。\n桃李我公天下满，不须偏待此中开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75605,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵和温泉","author":"强至","text":"上公分陕半年馀，驷马东还不待驱。\n肯独澡身汤室里，行推润泽浃民肤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75606,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和司徒侍中同赏梨花","author":"强至","text":"映花急把玉交杯，风扫残香已几堆。\n酷爱岂惟公假借，惯曾御苑见花来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75607,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和司徒侍中舟中再赋一阕","author":"强至","text":"燕子迎船贴岸飞，波光流色日晖晖。\n都人倍恋行春乐，只恐恩容昼锦归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75608,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉和尧夫","author":"强至","text":"固穷终不悔沉沦，满腹深藏上古珍。\n手写新诗成几卷，亦教馀事照千春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75609,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"庚戌仲春十二夜同无愧饮林夫西窗有感","author":"强至","text":"忆听西窗一曲歌，金杯未尽转横波。\n酒徒依旧歌声断，今夜西窗奈我何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75610,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"承乏幕府晨出马上戏书","author":"强至","text":"五载青衫走两都，北门官绪更区区。\n马鞍出带残更梦，却是双飞邺县凫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75611,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"松江别吴伯强","author":"强至","text":"底处与君长笑歌，夜舟醉漾松江波。\n君帆今夕不我住，其奈一江风月何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75612,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"河亭戏题","author":"强至","text":"黄沙衮衮激洪流，白舫人群杂马牛。\n却忆春风湖上月，画船载酒鉴中游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75613,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"牧养监阅马","author":"强至","text":"骨瘦谁知骥騄名，驽群平视圉夫轻。\n夷涂好在重骧首，喜见今年春草生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75614,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"苦旱二首 其二","author":"强至","text":"赤地关中带几州，浊泾清渭总如沟。\n野农不省天时晚，犹祷閒神望有秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75615,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"苦旱二首 其一","author":"强至","text":"垄上痿人卧槁苗，频年郡国诉诸朝。\n雨师不为苍生起，只纵晴虹作旱妖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75616,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送王审言供奉","author":"强至","text":"飞花几点送春馀，执手春风意惨如。\n一见相欢露肝胆，莫因别后却情疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75617,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送石师正","author":"强至","text":"马蹄南出都门路，行客少年春色暮。\n花片空随别盏飞，柳条难系征鞍住。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75618,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻马公节裴光世别头入试偶成","author":"强至","text":"忆昔丁年力战文，旁吞强敌若无人。\n乡书果在诸生上，二子今谁蹑后尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75619,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻无愧夜会二三君子戏呈二十八字","author":"强至","text":"烛边醉脸拟融酥，盏畔歌喉欲贯珠。\n应念东家多病叟，静披宽褐拥红炉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75620,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"席上戏成","author":"强至","text":"玉溪一别十年馀，北绾铜章西辟书。\n寄语湖山好相待，苍颜归日骇禽鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75621,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病中雪夜闻韩六秘校会诸君二首 其二","author":"强至","text":"别都观阁玉栏干，尤称褰帘把酒看。\n唯有三冬多病客，拥衾时听夜声乾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75622,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病中雪夜闻韩六秘校会诸君二首 其一","author":"强至","text":"玉色乾坤无一痕，暮寒惨惨入千门。\n自怜司马方消渴，不得摛词醉兔园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75623,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偶书净信院壁","author":"强至","text":"系舟曾访远公庐，游屐重来一纪馀。\n惟有湖山如往日，懒将前事问禽鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75624,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄县学方晦之","author":"强至","text":"素志青云已贴然，风霜苦处涉层巅。\n不如未第方夫子，独抱遗经议圣贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75625,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寇参军九日惠诗以左冯翊赵监所遗玉液一壶并诗答之","author":"强至","text":"久傍严公趋玉帐，近蒙贺监解金龟。\n一壶分助登高饮，客宦长安共此时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75626,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寇参军以孤雁一绝见贻因酬之","author":"强至","text":"紫塞来时偶失群，追飞已隔万重云。\n人情所喜惟朋附，耳听孤鸣似不闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75627,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"望思台","author":"强至","text":"一朝木偶发深宫，父子恩隳晻暧中。\n不见戾园埋恨处，至今草木有悲风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75628,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"温泉","author":"强至","text":"壮观悲凉旧迹存，莲花泉暖至今温。\n行人莫罪无情水，一笑华清是祸源。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75629,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"禽凤二绝 其二","author":"强至","text":"凤凰只是瑞时鸣，邂逅千年或一声。\n不比喧啾争巧舌，微禽何苦蓄疑情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75630,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"禽凤二绝 其一","author":"强至","text":"击搏微禽拙自防，网罗须触是寻常。\n不知利嘴鹰扬处，却漫喧啾怨凤凰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75631,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢和诗","author":"强至","text":"窗外家僮遽疾呼，开门满幅把明珠。\n惊回一觉无聊梦，犹有寒灯守药炉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75632,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢春幡","author":"强至","text":"晓策羸骖趁谢恩，君王昨夜赐春幡。\n涂金剪綵虽云异，竞戴还同拜禁门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75633,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"韩及甫惠陕梨走笔书句谢之","author":"强至","text":"霜后琼浆味转饶，关山封寄路迢迢。\n分甘珍重知君意，应为相如正病消。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75634,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"睹林夫诗编信笔","author":"强至","text":"唐子能诗世一家，不矜纤巧剪天葩。\n直窥六义追风雅，世上骚人谩苇麻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75635,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谨和答惠茶之什","author":"强至","text":"绿云浮面味回长，每饮疑兼盛德香。\n不独蠲烦优下吏，更容归遗细君尝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75636,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"暮角","author":"强至","text":"画角愔愔清且哀，古今晓色此中催。\n可堪绝塞风霜苦，还傍将军玉帐来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75637,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"暮春伯宪留饮席上走笔戏成二首 其二","author":"强至","text":"春去无多日，勤来把酒卮。\n残花聊点缀，犹胜对空枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75638,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"暮春伯宪留饮席上走笔戏成二首 其一","author":"强至","text":"春从花际来，却向天边去。\n莺蝶空徘徊，寻春不知处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75639,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"暮春晦日","author":"强至","text":"绿阴轻处记春踪，芳草虽残饮兴浓。\n明日清和天更好，不须愁听晓楼钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75640,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉中刘道叔尹嗣复李子先垂和予乙巳岁开元寺仁王院咏竹二十八字复依元韵走笔答之","author":"强至","text":"忆弄吟毫倚翠阴，也应新笋更成林。\n感君潇洒赓诗句，不负凌虚一寸心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75641,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠芝公长老","author":"强至","text":"我爱师开方便门，闻人有疾足先奔。\n何须端坐禅床上，始是如来不动尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75642,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"一春未尝行乐而群花今已离披感而成篇","author":"强至","text":"只知倦马趁风沙，不觉啼莺破物华。\n始拟尊前谋小酌，早堪枝上数残花。\n壮图惨淡流年驶，乐事参差暮景斜。\n薄醉浩歌搔短发，江湖归兴满天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75643,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日","author":"强至","text":"霜净乾坤阔，登高极古台。\n秋声枫几落，客眼菊三开。\n短发频看帽，寒吟间引杯。\n篱边空意绪，难得白衣来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75644,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日二首 其二","author":"强至","text":"渐老襟怀已足悲，登高节物可无诗。\n秋声飒爽侵蓬鬓，晚意萧条伴菊枝。\n故里江山寻好处，重阳樽酒负当时。\n天边鸿雁随南望，忆弟双眸泪欲垂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75645,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日二首 其一","author":"强至","text":"去岁重阳踏路尘，异乡今日恨还新。\n如何佳节长为客，却恐黄花解笑人。\n强饮破愁为乐酒，自怜多病足情身。\n龙山旧事知难问，千载相期属此辰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75646,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日上兵部","author":"强至","text":"重阳无酒上高台，冷对西风笑几回。\n虽信佳辰从古重，不知今日为谁来。\n忽闻天外清歌发，云是淮边曲宴开。\n自叹弗如篱下菊，此时翻得伴吟杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75647,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日至嘉禾","author":"强至","text":"登高时节异乡中，回首家山隔乱峰。\n白酒莫辞今日醉，黄花不似故园逢。\n苦嗟节物经秋老，赢得情怀为别浓。\n却爱紫微诗意好，笑歌开口强为容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75648,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日过后漫题堂前双菊","author":"强至","text":"花日金相照，条风翠竞翻。\n谁言羞晚艳，自喜胜孤根。\n客土深培力，家人一溉恩。\n秋香真好在，未易负清樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75649,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日作","author":"强至","text":"九日登临双阙边，三秋感慨一尊前。\n黄花若解怜多病，白发应嗟老去年。\n忆昨忽叨门下召，此辰方醉侍中筵。\n追欢筋力于今异，赢得新愁入短篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75650,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日病中泊舟召伯堰","author":"强至","text":"采采南山菊，还应满故园。\n全家泊孤埭，多病负清樽。\n木末秋声老，天涯雨气昏。\n乡关吟望外，愁泪有双痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75651,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日陪两制诸公燕赵氏园亭","author":"强至","text":"筋力追欢胜去年，不应吹帽愧华颠。\n壮心未折秋风里，笑口频开晚照边。\n学士带欺黄菊烂，侍臣绶夺紫萸鲜。\n自怜蹭蹬诸公后，一醉犹能赋此筵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75652,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九月二十六日河上雪","author":"强至","text":"昨朝今日尽天风，九月长河雪片中。\n云外谁偷榆荚种，人间自满菊花丛。\n群阴已鼓先时勇，万井应愁卒岁穷。\n亦欲蹇驴乘逸兴，灞桥何处觅诗翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75653,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"二月二日作","author":"强至","text":"江上初逢社燕归，青春二月色犹微。\n茸茸屐底草烟合，冉冉樽边花雾飞。\n蹭蹬容图双鬓改，苍茫乐事寸心违。\n紫丝结鞚谁家子，马跃东风试薄衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75654,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"二月十二日城西送韩玉汝龙图马上作","author":"强至","text":"信马春风踏软沙，晴郊芳意接京华。\n绿垂波面官桥柳，红出墙头御苑花。\n莫问年光侵老境，且拚日醉送生涯。\n归鞭犹恐严城隔，那得行人不念家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75655,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"二月大寒偶书短句","author":"强至","text":"上天谁与问，四序曷相干。\n已季春成暮，当温气反寒。\n农心忧地冻，俗眼惜花残。\n我岂殊民意，身为父母官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75656,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"二月过半犹未见花昨日逢之珍云已有小桃因成短句","author":"强至","text":"不觉春过半，开花始见桃。\n年光双鸟翼，世事一鸿毛。\n有兴抚清景，将愁付浊醪。\n家林应烂漫，南望首空搔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75657,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"人日立春辇下作","author":"强至","text":"楼上满倾人日酒，更逢春气到京华。\n盘擎白玉来生菜，胜插黄金出镂花。\n客兴纷纭那可数，年光流转亦无涯。\n天边梅柳应相笑，两度东风不在家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75658,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丈人生辰","author":"强至","text":"才过中元九日期，人间最重早秋时。\n当年间杰凝天粹，此际生贤作吏师。\n候属金行资义节，气钟庚宿究兵奇。\n愿公大用龄盈百，岁岁长吟祝寿诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75659,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]