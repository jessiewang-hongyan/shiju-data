[{"title":"题谊上人石室","author":"丘葵","text":"接石为巢瓦缝攲，家风惟有白云知。\n连筒远取煎茶水，种竹先寻挂衲枝。\n庵小偏涵新世界，山空不见旧亭池。\n清宵一段西来意，林影参差月上时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20742,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题章法山房","author":"丘葵","text":"四壁羲文卦，曾因学易居。\n今来三十载，只有一空庐。\n境寂含群动，窗明纳太虚。\n无人悟玄理，梅竹翠扶疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20743,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"颜北城有约看梅徘徊花下","author":"丘葵","text":"千林共摇落，老树独蜿蜒。\n玉立无人处，黄昏欲雪天。\n临风情脉脉，倚竹静娟娟。\n身世寒香里，相看意已仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20744,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠义上人","author":"丘葵","text":"足迹遍天涯，何年始出家。\n去时双不借，归日一袈裟。\n有句堪题壁，无魔敢散花。\n至今清夜话，犹自带烟霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20745,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠云岫上人","author":"丘葵","text":"诸生多晚出，一老独高年。\n月照遗经匣，云生破衲褰。\n苔深埋屐齿，屋老带松烟。\n何日尘氛断，从师此话禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20746,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠浮曦柳秀才","author":"丘葵","text":"家在浮曦江上住，胡为来此市廛中。\n残杯冷炙成何味，只研孤灯盍固穷。\n我本持竿钓鱼客，子缘识字入儒宫。\n何当共把丝纶去，明月矶头坐晚风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20747,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠曹贯之","author":"丘葵","text":"一见如畴昔，人文两崛奇。\n豪来无一世，狂发有千诗。\n浩然乾坤塞，修名台省知。\n就寻一勺水，神物自应移。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20748,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠富公","author":"丘葵","text":"师年过七十，万事总无心。\n猿鸟窥禅性，鱼龙避梵音。\n烟消香篆冷，霜入鬓根深。\n手种庵前树，苍苍十丈阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20749,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七歌效杜陵体 其七","author":"丘葵","text":"我生不辰逢乱离，四方蹙蹙何所之。\n欲登山兮有虎豹，欲入海兮有蛟螭。\n归来归来磨兜坚，毋与蛟斗兮毋充虎饥。\n呜呼七歌兮歌曲罢，猿啼清昼虫鸣夜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20750,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七歌效杜陵体 其一","author":"丘葵","text":"景炎元年北人至，撒花初令豪家备。\n谁梯祸乱敷我民，敲朴日烦无处避。\n富者有银犹可苏，贫者无银卖田地。\n呜呼一歌兮歌已衰，天日不见惟阴霾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20751,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七歌效杜陵体 其六","author":"丘葵","text":"十家九室厨无烟，儿夫仆后妻僵前。\n米珠薪桂肉如玉，野无青草飞乌鸢。\n手持空券向何许，官司有印侬无钱。\n呜呼六歌兮歌愈悲，天下太平竟何时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20752,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七歌效杜陵体 其四","author":"丘葵","text":"督府养兵如养子，帛堆其家粟崇庾。\n少不如意出怨言，恃功偃蹇骄其主。\n道旁老氓哭告予，未被贼苦被军苦。\n呜呼四歌兮歌始宣，悲风为我吹尘寰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20753,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七歌效杜陵体 其五","author":"丘葵","text":"富儿谐了西园债，身著绿衣足誇诧。\n那知又有价高人，昨日新官今日罢。\n近来书满只月馀，白头老吏慵送迓。\n呜呼五歌兮歌未足，末世由来多反覆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20754,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七歌效杜陵体 其三","author":"丘葵","text":"山林啸聚繁有徒，州家买尽勤招呼。\n县官被命不敢逊，麒麟出模群狐孤。\n昨者参州红帕首，高官厚禄恣狂图。\n呜呼三歌兮歌三发，天翻地覆纲常灭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20755,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七歌效杜陵体 其二","author":"丘葵","text":"三宫北狩何时返，猿啼鬼哭尘沙远。\n李陵卫律甘匪人，岂无蔡琰吹胡管。\n江南江北骨成山，箭瘢纷纷剑痕满。\n呜呼二歌兮歌未休，潸然出涕滂沱流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20756,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三月三十日","author":"丘葵","text":"盎盎天地春，万物日和煦。\n云胡生五谷，不若草木数。\n天地一小变，六龙不行雨。\n东皇讵忍归，田间已焦土。\n□□□□人，书生空自愁。\n饥死者不恨，特为苍生忧。\n我愿呼东皇，为我呼屏翳。\n沛为三日霖，枯苗有生意。\n皇天青荡荡，无繇诉衷情。\n空怜汝布谷，辛苦催人耕。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20757,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"义方堂瞻先贤遗像 其五","author":"丘葵","text":"六经重刊定，炳炳如日月。\n毫分而缕析，反约以详说。\n千载开我人，遗书□□□。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20758,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"义方堂瞻先贤遗像 其六","author":"丘葵","text":"炎炎太平翁，谁敢触其讳。\n乞枭之藁街，公乃明大义。\n至今读谏疏，凛凛有生气。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20759,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"义方堂瞻先贤遗像 其二","author":"丘葵","text":"三十六宫中，手探足还蹑。\n一元十二会，理乱在目睫。\n我欲从先生，□□□□□。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20760,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"义方堂瞻先贤遗像 其三","author":"丘葵","text":"性命同一原，谁能发其奥。\n茫茫太虚中，指出天与道。\n精思与力践，千古为独到。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20761,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"义方堂瞻先贤遗像 其一","author":"丘葵","text":"龙龟不再出，谁能探真精。\n图书天所付，手授之二程。\n欲知千载意，窗外草青青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20762,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"义方堂瞻先贤遗像 其四","author":"丘葵","text":"石井初筮时，已将教为政。\n真成叔梁纥，有子为孔圣。\n至今鳌山下，过者莫不敬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20763,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"太阳 其四","author":"丘葵","text":"太阳一入地，经天返复返。\n老学傥能勉，去圣岂云远。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20764,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"太阳 其五","author":"丘葵","text":"君子之于学，没身而后已。\n苟未至陨越，敢不湛攸止。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20765,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"太阳 其二","author":"丘葵","text":"太阳一入地，尚能掣成电。\n老学傥能勉，气质岂不变。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20766,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"风雨中与吕之寿读文公诗传","author":"丘葵","text":"冷冷叶上风，瑟瑟檐头雨。\n天分本无私，人性皆相似。\n譬之入山林，斧斤随所取。\n姿年舍我去，初心日以负。\n勖君岁寒心，保此栋梁具。\n圣域廓悠悠，修途未容驻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20767,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"北山","author":"丘葵","text":"朝见北山青，暮见北山紫。\n顽然土与石，此色何处起。\n无情草木含清辉，朝露夕阳助明媚。\n四时烟雨姿态异，天机滚滚何曾已。\n人见山上有青天，谁知天在青山里。\n欲问巨灵知不知，孤鸢飞处白云起。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20768,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"古愚兄戒食","author":"丘葵","text":"有美者庭花，谨毋纵牛羊。\n方苞亦方折，其叶何牂牂。\n敦笃哉吾兄，一食不我忘。\n有酒既醑我，又以嘉殽将。\n感兄此意厚，起奉千年觞。\n何以报嘉惠，作善天降祥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20769,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"对竹","author":"丘葵","text":"此君无媚色，耿耿合予衷。\n外直形容瘦，中虚忿欲空。\n炎凉多变态，潇潇独清风。\n幸免斧斤患，苍然保令终。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20770,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"田舍 其二","author":"丘葵","text":"乱后无鸡犬，昏到足蚋蚊。\n有翁如老鹤，蹙頞说官军。\n理谷为春种，鞭禾到夜分。\n与儿再三话，衣食在辛勤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20771,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"田舍 其三","author":"丘葵","text":"片云头上黑，冻雨自西来。\n促妇收馀谷，呼童拾爨柴。\n堆禾披草盖，移菜傍畦栽。\n却忆翁年老，前村醉未回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20772,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"白露日独立","author":"丘葵","text":"西风吹我鬓鬅鬙，独立庭中影随形。\n一岁露从今夜白，百年眼对老天青。\n经秋不脱无多树，近月能明有几星。\n惆怅前修人去尽，后生谁可嘱遗经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20773,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"石榴花","author":"丘葵","text":"莫峙而匪山，莫流而匪川。\n人生有懿德，万性同此天。\n云胡不自责，听此六贼牵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20774,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"石榴花 其二","author":"丘葵","text":"英英石榴花，不朱而自赤。\n凡今之人兮，谁不悦媚色。\n脂水涨渭流，妍姿竟倾国。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20775,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"石榴花 其一","author":"丘葵","text":"英英石榴花，不火而自晰。\n凡今之人兮，谁不附炎热。\n百鬼瞰高明，丹朱易倾跌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20776,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"示儿","author":"丘葵","text":"吃紧为人毋自欺，吾犹失学况吾儿。\n人谁无过过须改，道不远人人莫知。\n一定万牛拖不动，少差驷马亦难追。\n如今老去空惆怅，八十年前尽背驰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20777,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"记先贤","author":"丘葵","text":"进学在致知，涵养须用敬。\n廓然而大公，物来则顺应。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20778,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜坐读书","author":"丘葵","text":"茅檐晚来雨，东风忽吹晴。\n不暖亦不寒，夜气觉自清。\n书生澹无事，复恋旧短檠。\n开卷见圣贤，愧我犹编氓。\n便思澡尘虑，肃然奉天明。\n出门视斗极，敬心由之生。\n姿年舍我去，老学何由成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20779,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"亦足轩中试墨","author":"丘葵","text":"溁河无复见龙马，车子锄商乃获麟。\n虞夏不存暴易暴，诗书何罪秦又秦。\n古来尚有拿舟者，今世那无伐木人。\n天地闭时应且隐，确乎不拔为潜鳞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20780,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仰高堂外看山","author":"丘葵","text":"半生劳仰止，今日忽堕前。\n如忘形骸友，相对亦屹然。\n此心有全体，动静无尘缘。\n遥睇层层碧，群仙室其巅。\n我欲往从之，于道恐未然。\n但当安所止，万物同此天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20781,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同建阳熊退斋游九日山","author":"丘葵","text":"八荒去求仁，名山在吾西。\n云石长挂眼，云何不攀跻。\n攀跻有何求，林木心所欢。\n欣欣岂在目，昔有秦隐君。\n隐君天上去，尚有姓名留。\n想当嘉遁时，煮茗日唱酬。\n唱酬者为谁，曰惟姜欧阳。\n于昭忠与义，追琢而成章。\n成章匪摛藻，一字不出山。\n最后有致光，亦复兹盘桓。\n盘桓尚如昨，人生几陵谷。\n至今荒祠下，凛凛人如玉。\n如玉复如玉，千年仰高风。\n谁哉共我游，建阳勿斋翁。\n翁谓朱紫阳，穆穆千载师。\n昔年此游历，尚有妙遗句。\n遗句尚可歌，于焉且徜徉。\n欲寻廓然处，但见山苍苍。\n苍苍未尝歇，谁识天机深。\n未知后来者，能复此同心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20782,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同景仁芝山赏梅","author":"丘葵","text":"西风杀群卉，麋鹿觉悽怆。\n野菊亦憔悴，萧条不堪赏。\n主人庵中梅，的皪为谁放。\n当兹肃霜月，数枝春盎盎。\n真如得道人，形槁神独王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20783,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吕之寿诗到仍用前韵约为五峰之游同访老人","author":"丘葵","text":"客中枉佳句，三复喜还悲。\n冉冉岁暮矣，悠悠思何之。\n桐下不共往，梅花预作期。\n地炉风雪夜，同访五峰缁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20784,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吕所盘以诗送茅柴酒与红螺用韵以谢","author":"丘葵","text":"玉液新篘彻底清，琼肌脱壳有馀馨。\n嗜茶枉自为搜搅，食蛤空怜有典刑。\n脉脉客愁閒白昼，纷纷雨脚下青冥。\n此时一领仙家味，应使灵均悔独醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20785,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次放翁梅花韵","author":"丘葵","text":"冰崖雪谷物未芽，造物破荒开此花。\n神全形枯近有道，意庄正色知无邪。\n高坚正要饱忧患，放弃何遽愁荒遐。\n移根上苑亦早计，竹篱茅舍真吾家。\n平生自嫌亦自许，妙处可识不可誇。\n金樽翠杓未免俗，篝灯为试江南茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20786,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次晦庵先生韵自警","author":"丘葵","text":"我非欠缺圣非馀，此性皆由气与虚。\n欲认存亡为出入，莫嫌粗粝慕膏腴。\n仰钻未得有门入，酬酢方知讲学疏。\n一息犹存毋敢懈，从今要下死工夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20787,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵长卿仍招为桐下之游","author":"丘葵","text":"老怀原寂寞，非子竟谁倾。\n去矣无多日，缅然相与情。\n云山留共往，风雪渺孤征。\n更解同行否，无为岁暮惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20788,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵吴静能秦桧","author":"丘葵","text":"故老相传为秦桧，飞仙时立冻蛟背。\n疑是当年丫髻人，凭虚驭气今安在。\n百千年树见栽时，新承雨露入昭代。\n托根南极殿下生，巍巍直与天枢对。\n纷纷牛马已成尘，露叶风枝今几载。\n是时鸾凤一来栖，枭狐不敢鸣妖怪。\n一朝名字动至尊，不见尊形空粉绘。\n多少黄冠尽白头，依神正直人再拜。\n老榛何物敢干名，直根惟有苏仙爱。\n方今南北同一天，孤标不见贞元会。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20789,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自知","author":"丘葵","text":"古寺栖身又两期，西风吹我鬓成丝。\n俗儿往往貌相敬，吾道悠悠心自知。\n尽去皮毛方是学，若无情性定非诗。\n可怜千载相传授，只为秦人煨烬遗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20790,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观赤石龙潭","author":"丘葵","text":"豢扰久不氏，神物失所从。\n砧岩石壁下，岂足为龙宫。\n亦有万仞海，茫茫与天通。\n谁言汝为智，出入人鬼中。\n穷冬天地闭，风云末由逢。\n泠泠一掬溜，于焉托孤踪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20791,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观物 其三","author":"丘葵","text":"万物即一物，一物即一身。\n妙合气与灵，知觉日以新。\n物物为过化，性性为存神。\n践形者惟肖，其斯之谓人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20792,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观物 其一","author":"丘葵","text":"太虚寂无朕，妙感何絪缊。\n清浊一浮沈，二仪奠乾坤。\n客形与客感，万变日纷纷。\n形感本来无，志诚谅斯存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20793,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观物 其四","author":"丘葵","text":"春蒲发华滋，潮涨失沙嘴。\n好风自西来，吹皱一江水。\n何人掉孤舟，撑入春浦里。\n不见舟中人，一阵鸥飞起。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20794,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观物 其二","author":"丘葵","text":"气聚则明施，气散则明匿。\n孰能知其妙，聚散乃为客。\n法象乃糟糠，真机乃虚寂。\n大哉无方体，是谓神与易。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20795,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观湖 其四","author":"丘葵","text":"飞飞洲上禽，亦能戾于天。\n圣域尚能臻，吾车安敢旋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20796,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观湖 其一","author":"丘葵","text":"潮来沙石没，潮去沙石露。\n士生那无学，学则词章富。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20797,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观湖 其二","author":"丘葵","text":"潮来舴艋正，潮去舴艋攲。\n士生那无学，学则气习移。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20798,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观湖 其三","author":"丘葵","text":"潮来鱼网设，潮去鱼网收。\n士生那无学，学则德业优。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20799,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闭户","author":"丘葵","text":"自我来兹泮，闭户交游绝。\n经生一二辈，长庚伴残月。\n芹藻自青青，谁与共采撷。\n唯于泼泼处，见得源头活。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20800,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"伯恭侄家书所见 其三","author":"丘葵","text":"百舌在墙廉，其子在墙阴。\n他年汝哺儿，方识父母心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20801,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"伯恭侄家书所见 其二","author":"丘葵","text":"百舌在墙头，其子在墙根。\n飞飞拾虫蚁，哺之何殷勤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20802,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"伯恭侄家书所见 其一","author":"丘葵","text":"百舌在墙东，其子在墙西。\n纵有反哺日，那得如哺儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20803,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"呈大宗丞求笔戏","author":"丘葵","text":"咄咄人谁识，翩翩老更佳。\n王维不是画，苏晋已长斋。\n地静白生室，天秋黄落阶。\n日长用幽意，咫尺到无怀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20804,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"张可大甥与古愚家兄游阳孟岩已废而旧日之山屹然独存有诗因次其韵","author":"丘葵","text":"笑推窗户揖青山，茶鼎松风入耳潺。\n老去已知今世错，贫来剩得此身閒。\n漱流枕石心长在，涉水穿林步已难。\n六十年来醉题壁，那知尚在白云间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20805,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"怀古愚兄 其二","author":"丘葵","text":"紫帽之峰兮高且崷，白云一片兮空悠悠。\n我有兄兮在海陬，三月不见兮使我心忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20806,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"怀古愚兄 其一","author":"丘葵","text":"紫帽之峰兮高且巍，白云一片兮空依依。\n我有兄兮在海湄，三月不见兮使我心悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20807,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"怀玉岩先生谪广州忽自古杭有书至","author":"丘葵","text":"十二年前旧师友，书来欲拆泪成行。\n几回相忆人千里，往事追思梦一场。\n琴剑知辞南国久，干戈尚任北方强。\n伤心吾道秋容冷，遥忆师门数仞墙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20808,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]