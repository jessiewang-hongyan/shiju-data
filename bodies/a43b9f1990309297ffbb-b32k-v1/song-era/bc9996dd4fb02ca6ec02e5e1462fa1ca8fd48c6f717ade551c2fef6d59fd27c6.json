[{"title":"霜天晓角","author":"张孝祥","text":"柳丝无力。\n冉冉萦愁碧。\n系我船儿不住，楚江上、晚风急。\n棹歌休怨抑。\n有人离恨极。\n说与归期不远，刚不信、泪偷滴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53656,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题富览亭","author":"张孝章","text":"碧瓦朱甍接翠崖，周回无地着纤埃。\n山从云脚断边出，水向天根尽处来。\n去蜀征帆轻渺渺，隔淮春树绿洄洄。\n偷閒一到尘襟涤，坐见星河落酒杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53657,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题义门胡氏华林书院","author":"张孝隆","text":"烟霞缥缈锁仙乡，万卷诗书一草堂。\n孝义声华辉北阙，门闾显赫耀南方。\n千寻瀑布侵肌冷，四季闲花扑鼻香。\n胜事人间无敌处，王公诗版砌虹梁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53658,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"天汉桥","author":"张宋卿","text":"一派银河木杪飞，碧云飞处彩虹垂。\n免教灵鹊长填石，来看天孙出嫁时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53659,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"忆罗浮寄曾元功二首 其二","author":"张宋卿","text":"春树江云我所思，平生臭味不差池。\n如何驿使行千里，不把梅花寄一枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53660,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"忆罗浮寄曾元功二首 其一","author":"张宋卿","text":"当年南涧弄泉流，妄起功名分外求。\n群玉峰头今倦立，却烦清梦到罗浮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53661,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答岳鹏举","author":"张完","text":"相别相逢不计春，眼前非旧亦非新。\n声求色相皆邪妄，莫认无疑是昔人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53662,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"张纮","text":"时见空中飞八百，每闻岸上叫三千。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53663,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"张志","text":"矗汉危桥吞兔魄，出林疏磬落鲸涛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53664,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"白石山","author":"张志道","text":"山似游龙势欲奔，山中有路透天阍。\n峰峦常带烟霞色，洞穴浑无斧凿痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53665,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西湖怀古","author":"张志道","text":"荷花桂子不胜悲，江介繁华异昔时。\n天目山来孤凤歇，海门潮去六龙移。\n贾充误国终无策，庾信哀时尚有词。\n莫向中原誇绝景，西湖□恨是西施。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53666,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西江月 其七","author":"张抡","text":"一梦浮生未觉，三冬短晷堪惊。\n天高谁解挽长绳。\n系住流年光景。\n须信阴阳有定，非关岁月无情。\n若教心地湛然清。\n日在壶中自永。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53667,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西江月 瑞香","author":"张抡","text":"剪就碧云闹叶，刻成紫玉芳心。\n浅春不怕峭寒侵。\n暖彻薰笼瑞锦。\n花里清芬独步，尊前胜韵难禁。\n飞香直到玉杯深。\n消得厌厌痛饮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53668,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西江月 其一","author":"张抡","text":"仙道于人不□，□□□□□□。\n坎离□□□无穷。\n不信浮生若梦。\n君看□□窨雪，寻常见睍消熔。\n能令新旧再相逢。\n此是如何作用。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53669,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西江月 其九","author":"张抡","text":"独坐闲观瑞雪，方知造化无偏。\n不论林木与山川。\n白玉一时装遍。\n梁苑休寻赋客，山阴莫上溪船。\n三杯醉□意陶然。\n梦后瑶台阆苑。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53670,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西江月 其八","author":"张抡","text":"四序常如转毂，百年须待春风。\n江梅何事向严冬。\n早有清香浮动。\n只为六阴极处，一阳已肇黄宫。\n阴阳迭用事何穷。\n此是乾坤妙用。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53671,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西江月 其二","author":"张抡","text":"雪似琼花铺地，月如宝鉴当空。\n光辉上下两相通。\n千古谁窥妙用。\n若悟珠生蚌腹，方知非异非同。\n阴阳相感有无中。\n恍惚已萌真种。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53672,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西江月 咏冬十首 其一","author":"张抡","text":"有限光阴过隙，无情日月飞梭。\n春花秋月暗消磨。\n一岁相看又过。\n逢酒须成痛饮，临风莫厌高歌。\n虚名微利两如何。\n识破方知恁么。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53673,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西江月 其五","author":"张抡","text":"雅士常多雅□，□□□□□怀。\n雪溪□□□舟来。\n兴尽何须见戴。\n恰似□云出岫，岂拘宇内形骸。\n超然物外远尘埃。\n到此方为自在。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53674,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西江月 其六","author":"张抡","text":"冬至一阳初动，鼎炉光满帘帏。\n五行造化太幽微。\n颠倒难穷妙理。\n遇此急须进火，速修犹恐迟迟。\n茫茫何处问天机。\n要悟须凭师指。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53675,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西江月 其四","author":"张抡","text":"密布同云万里，六飞玉糁琼铺。\n清歌妙舞拥红炉。\n犹恨寒侵尊俎。\n谁念山林路险，独行跣足樵夫。\n莫惊苦乐□殊途。\n阳□皆由阴注。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53676,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西江月 其三","author":"张抡","text":"卷地朔风凛凛，漫天瑞雪霏霏。\n园林万木变枯枝。\n因甚松篁独翠。\n只为春花竞发，却教秋叶争飞。\n若无荣盛便无衰。\n悟此方名达理。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53677,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"阮郎归 其四","author":"张抡","text":"炎天何处可登临。\n须于物外寻。\n松风涧水杂清音。\n空山如弄琴。\n宜散发，称披襟。\n都无烦暑侵。\n莫将城市比山林。\n山林兴味深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53678,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"阮郎归 其八","author":"张抡","text":"谁言无处避炎光。\n山中有草堂。\n安然一枕即仙乡。\n竹风穿户凉。\n名不恋，利都忘。\n心闲日自长。\n不须辛苦觅琼浆。\n华池神水香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53679,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"阮郎归 咏夏十首 其一","author":"张抡","text":"亭亭槐柳午阴圆。\n薰风拂舜弦。\n一轮红日贴中天。\n乾坤如火然。\n观上象，想丹田。\n阳精色正鲜。\n□从炼得体纯全。\n朱颜无岁年。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53680,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"阮郎归 其六","author":"张抡","text":"金乌玉兔最无情。\n驱驰不暂停。\n春光才去又朱明。\n年华只暗惊。\n须省悟，莫劳神。\n朱颜不再新。\n灭除妄想养天真。\n管无寒暑侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53681,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"阮郎归 其三","author":"张抡","text":"深亭邃馆锁清风。\n榴花芳艳浓。\n阳光染就欲烧空。\n谁能窥化工。\n观物外，喻身中。\n灵砂别有功。\n若将一粒比花容。\n金丹色又红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53682,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"阮郎归 其七","author":"张抡","text":"动时思静暑思寒。\n尘劳扰扰间。\n翻云覆雨百千般。\n几时心地闲。\n□□□，□□难。\n将□□□然。\n自然寒暑不相□。\n□□□地仙。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53683,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"阮郎归 其一","author":"张抡","text":"寒来暑往几时休。\n光阴逐水流。\n浮云身世两悠悠。\n何劳身外求。\n天上月，水边楼。\n须将一醉酬。\n陶然无喜亦无忧。\n人生且自由。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53684,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"阮郎归 其九","author":"张抡","text":"炎炎皦日正当中。\n澄潭忽此逢。\n金丹乍浴表深功。\n通明照水红。\n丹浴罢，乐无穷。\n怡然百体融。\n人间何处不清风。\n此怀谁与同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53685,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"阮郎归 其五","author":"张抡","text":"豪家大厦敞千楹。\n风摇玉柄轻。\n金盆弄水复敲冰。\n热从何处生。\n低草舍，小茅亭。\n如何安此身。\n元来一念静无尘。\n萧然心自清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53686,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"阮郎归 其二","author":"张抡","text":"欲如臭腐化神奇。\n当观蝉蜕时。\n脱然飞上绿槐枝。\n炎炎昼景□。\n□□□，□如斯。\n□□□□迷。\n灵躯一旦脱□□。\n□□□□归。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53687,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诉衷情令 其七","author":"张抡","text":"闲中一弄七弦琴。\n此曲少知音。\n多因淡然无味，不比郑声淫。\n松院静，竹林深。\n夜沈沈。\n清风拂轸，明月当轩，谁会幽心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53688,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诉衷情令 其四","author":"张抡","text":"闲中一篆百花香。\n袅袅翠□□。\n低回宛转何似，行路绕羊肠。\n深竹户，小山房。\n雅相当。\n清心默坐，燕寝无风，永日芬芳。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53689,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诉衷情令 其三","author":"张抡","text":"闲中一亩小□□。\n临水对遥岑。\n茅茨□□低小，竹径要幽深。\n逢酒醉，遇花吟。\n日登临。\n四时无限，好景良辰，莫负光阴。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53690,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诉衷情令 咏闲十首 其一","author":"张抡","text":"闲中一卷圣贤书。\n耽玩意□□。\n潜心要游阃奥，须是下功夫。\n今何异，古何殊。\n本同途。\n若明性理，一点灵台，万事都无。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53691,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诉衷情令 其五","author":"张抡","text":"闲中一盏瓮头春。\n养气又颐神。\n莫教大段沈醉，只好带微醺。\n心自适，体还淳。\n乐吾真。\n此怀何似，兀兀陶陶，太古天民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53692,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诉衷情令 其六","author":"张抡","text":"闲中一盏建溪茶。\n香嫩雨前芽。\n砖炉最宜石铫，装点野人家。\n三昧手，不须夸。\n满瓯花。\n睡魔何处，两腋清风，兴满烟霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53693,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诉衷情令 其八","author":"张抡","text":"闲中一叶小渔舟。\n无线也无钩。\n□□□云深处，适性自遨游。\n波渺渺，兴悠悠。\n意休休。\n一船明月，一棹清风，换了封侯。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53694,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诉衷情令 其九","author":"张抡","text":"闲中一觉日高眠。\n都没利□□。\n黑甜自来无比，百计总输先。\n花转影，篆凝烟。\n意悠然。\n华胥何处，蝶化逍遥，此意谁传。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53695,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诉衷情令 其二","author":"张抡","text":"闲中一片□□□。\n□□□□□。\n□□□澄秋水，明月夜□□。\n□□□，□□□。\n□□□。\n鹤长凫短，前定难□，□□□□。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53696,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诉衷情令 其一","author":"张抡","text":"闲中一首醉时歌。\n此乐信无过。\n阳春自来寡和，谁与乐天和。\n言不尽，意何多。\n且蹉跎。\n功名莫问，富贵休言，到底如何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53697,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"临江仙 其二 车驾朝享景灵宫，久雨，一夕开霁","author":"张抡","text":"闻道彤庭森宝仗，霜风逐雨驱云。\n六龙扶辇下青冥。\n香随鸾扇远，日射赭袍明。\n帘卷天街人隘路，满城喜望清尘。\n欢声催起岭梅春。\n欲知天意好，昨夜月华新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53698,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"临江仙 其一","author":"张抡","text":"玉宇凉生清禁晓，丹葩色照晴空。\n珊瑚敲碎小玲珑。\n人间无此种，来自广寒宫。\n雕玉阑干深院静，嫣然凝笑西风。\n曲屏须占一枝红。\n且图敧醉枕，香到梦魂中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53699,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春光好","author":"张抡","text":"烟澹澹，雨濛濛。\n水溶溶。\n帖水落花飞不起，小桥东。\n翩翩怨蝶愁蜂。\n绕芳丛。\n恋馀红。\n不恨无情桥下水，恨东风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53700,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"柳梢青","author":"张抡","text":"柳色初匀。\n轻寒似水，纤雨如尘。\n一阵东风，縠纹微皱，碧沼鳞鳞。\n仙娥花月精神。\n奏凤管、鸾丝斗新。\n万岁声中，九霞杯里，长醉芳春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53701,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"点绛唇 其八","author":"张抡","text":"乐事难并，少年常恨春宵短。\n万花丛畔。\n只恐金杯浅。\n方喜春来，又叹韶华晚。\n频相劝。\n且闻强健。\n莫厌花经眼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53702,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"点绛唇 其三","author":"张抡","text":"阳气初生，万花潜动根荄暖。\n暗藏芳艳。\n未许东君见。\n恰似温温，铅鼎丹初转。\n功犹浅。\n九回烹炼。\n日月光华满。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53703,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"点绛唇 其九","author":"张抡","text":"一瞬光阴，世人常被芳菲恼。\n玉壶频倒。\n惟恨春归早。\n何似逍遥，物外寻三岛。\n春长好。\n瑞芝瑶草。\n春又何曾老。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53704,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"点绛唇 其六","author":"张抡","text":"春入山家，杖藜独步登岩岫。\n野花争秀。\n弄蕊香盈袖。\n对景开怀，莫遣双眉皱。\n春难久。\n乱红飞后。\n留得韶光否。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53705,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"点绛唇","author":"张抡","text":"气体冲融，四时长在阳春里。\n玉田琼蕊。\n养就灵苗异。\n堪笑□□，□□□□□。\n□□□。\n□□流水。\n半落苍□□。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53706,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"点绛唇 其一","author":"张抡","text":"浮世如何，问花何事花无语。\n夜来风雨。\n已送韶华暮。\n念此堪惊，得失休思虑。\n从今去。\n醉乡深处。\n莫管流年度。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53707,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"点绛唇 咏春十首 其一","author":"张抡","text":"何处春来，惠风初自东郊至。\n柳条花蕊。\n迤逦争明媚。\n造化难穷，谁晓幽微理。\n都来是。\n自然天地。\n一点冲和气。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53708,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"壶中天慢/念奴娇","author":"张抡","text":"洞天深处赏娇红，轻玉高张云幕。\n国艳天香相竞秀，琼苑风光如昨。\n露洗妖妍，风传馥郁，云雨巫山约。\n春浓如酒，五云台榭楼阁。\n圣代道洽功成，一尘不动，四境无鸣柝。\n屡有丰年天助顺，基业增隆山岳。\n两世明君，千秋万岁，永享升平乐。\n东皇呈瑞，更无一片花落。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53709,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 和曾纯甫题谢氏小阁","author":"张抡","text":"筑室峥嵘占宝峰。\n退朝燕坐万缘空，出尘高志抗冥鸿。\n何日嘉招陪一笑，看君豪饮釂千钟。\n试凭鄙句作先容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53710,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"烛影摇红 上元有怀","author":"张抡","text":"双阙中天，凤楼十二春寒浅。\n去年元夜奉宸游，曾侍瑶池宴。\n玉殿珠帘尽卷。\n拥群仙、蓬壶阆苑。\n五云深处，万烛光中，揭天丝管。\n驰隙流年，恍如一瞬星霜换。\n今宵谁念泣孤臣，回首长安远。\n可是尘缘未断。\n谩惆怅、华胥梦短。\n满怀幽恨，数点寒灯，几声归雁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53711,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"减字木兰花 其一","author":"张抡","text":"还元返本。\n作用难明须细论。\n神气□□。\n窈窕之中复混成。\n勤修不倦。\n直到无为功始见。\n此是天机。\n不遇真仙莫强知。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53712,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"减字木兰花 其五","author":"张抡","text":"天机深远。\n不遇真仙争得见。\n欲下工夫。\n须是先寻偃月炉。\n抽添运用。\n火候不明□妄动。\n毫发才差。\n只恐灵根□□芽。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53713,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"减字木兰花 其三","author":"张抡","text":"至言妙道。\n□□□□□□□。\n□□□□。\n□是蓬莱顶上仙。\n归根□□。\n□□□□方复命。\n复命常存。\n此事幽微好细论。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53714,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"减字木兰花 修养十首 其一","author":"张抡","text":"五行颠倒。\n火里栽莲君莫□。\n□要东牵。\n引取青龙来西边。\n一阳时候。\n□□温温光已透。\n消尽群阴。\n赫赤金丹色渐深。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53715,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"减字木兰花","author":"张抡","text":"冥冥窈窕。\n□□□□□□□。\n□□□□。\n□□□□□□□。\n□□□□。\n□□□□□□□。\n□□□□。\n□□□□□□□。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53716,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"减字木兰花","author":"张抡","text":"阴阳均配。\n□□□□□□□。\n□□□□。\n争得灵苗不解□。\n□□□□。\n□□□□□□□。\n□是真铅。\n只□□□□□□。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53717,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"减字木兰花 其九","author":"张抡","text":"乾坤入手。\n谈笑三关云□□。\n□□□□。\n鬼骇神惊一黍光。\n逍遥宇内。\n□□□□□数外。\n功满三千。\n独跨斑麟入紫烟。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53718,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"减字木兰花 其四","author":"张抡","text":"神仙何处。\n若有宿缘须□□。\n□□□□。\n不在山林及市朝。\n丹炉休守。\n须信人人皆自有。\n此外非真。\n莫认凡砂与水银。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53719,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"减字木兰花 其六","author":"张抡","text":"咽津纳气。\n鼎内须□□□□。\n□□□□。\n□□空铛枉误人。\n有真不□。\n□□□□□□□。\n□□修持。\n超出□□□□□。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53720,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]