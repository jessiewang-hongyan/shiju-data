[{"title":"送李运使学士赴阙十咏 其七","author":"赵抃","text":"荆衡此驾轺，封郡去相辽。\n国廪矜流衍，农畴喜富饶。\n几时无协气，何处不欢谣。\n汉室通粮道，论功最后萧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37386,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送李运使学士赴阙十咏 其八","author":"赵抃","text":"南荣来汉诏，北阙近尧天。\n懿绩隆三岁，丰储备九年。\n威严多摘伏，荐籍几登贤。\n去去民思甚，销魂尽黯然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37387,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送李运使学士赴阙十咏 其九","author":"赵抃","text":"歌阕散雕筵，膺舟是谪仙。\n秦亭临断岸，楚水浸遥天。\n魏阙瞻湖上，长安指日边。\n綵旌随目远，一向立风前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37388,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送李运使学士赴阙十咏 其十","author":"赵抃","text":"供帐楚江滨，瞻言泪满巾。\n如何从事客，曾作受恩人。\n再顾沟中物，尤惭席上珍。\n异时调鼎鼐，应许与陶钧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37389,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和戴天使重阳前一夕宿长沙驿二首 其一","author":"赵抃","text":"诘旦逢佳节，今宵寓远乡。\n且欣宾榻解，休叹客亭长。\n黄叶临风乱，红萸浥露香。\n酒徒何处所，空自忆高阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37390,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和戴天使重阳前一夕宿长沙驿二首 其二","author":"赵抃","text":"楚馆夜衾凉，离人念故乡。\n远吟只觉苦，归梦不成长。\n壁有寒蛩怨，邻闻绿蚁香。\n登高在何处，明日宴山阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37391,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻杨畋病愈","author":"赵抃","text":"湖南杨叔武，消息有人传。\n连岁征蛮徼，经秋卧瘴烟。\n为时天未丧，勿药病还痊。\n云水溶溶去，凭诗寄此篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37392,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"入蜀舟中逢春","author":"赵抃","text":"春到依羁旅，怀开似发缄。\n野禽鸣胜管，春草绿于衫。\n水暖风微碎，山明日半衔。\n巴西寒极地，冰雪尚千岩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37393,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"入蜀江上对月","author":"赵抃","text":"照不私毫发，波光上下浮。\n明馀到琴淡，清极入诗幽。\n忽认江湖昼，浑疑天地秋。\n閒云勿轻蔽，有客坐孤舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37394,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日陪宴会春园亭","author":"赵抃","text":"为怕三春过，因谋数刻狂。\n醉轻欣射中，欢甚惜歌长。\n骄马花间系，啼莺柳下藏。\n前旌归去晚，十里淡风光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37395,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"月夜听僧化宜弹琴","author":"赵抃","text":"蜀国有良工，孙枝斲古桐。\n逢师写流水，为我益清风。\n淡恐时心厌，幽蕲世耳聪。\n坐来明月满，无语讼庭空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37396,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送蜀守贾昌朝水部赴阙","author":"赵抃","text":"召节下英藩，归辕望帝阍。\n中和刺史政，教友相君门。\n去听涂歌美，留瞻壁像尊。\n欲知春色好，元是百城恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37397,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送曾交屯田赴阙","author":"赵抃","text":"治多祥气感，名可信书褒。\n诗有千篇富，才为两蜀豪。\n任诚时少与，敦义世推高。\n剑栈芳菲地，公行我亦劳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37398,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和范御史初出都门","author":"赵抃","text":"牍奏辞三院，乡荣领百城。\n帝恩山岳重，臣命羽毛轻。\n风月随人好，江湖照胆清。\n须公赠金玉，光照重行行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37399,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和韵前人初出销头","author":"赵抃","text":"奏恳初无饰，天恩亦重违。\n一麾新命下，两桨故关归。\n淮木林林脱，霜鸿阵阵飞。\n贤朋诗酒乐，行矣自相依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37400,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和石涧寺龙潭","author":"赵抃","text":"一遇汤王旱，须为傅说霖。\n只应蟠涧底，济物是初心。\n昔岁苗将槁，阳骄不和阴。\n农夫望膏泽，徒蛰尔何深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37401,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和通判范都官不赴赏春","author":"赵抃","text":"幽郡少丛事，名园邀上宾。\n逢花有深意，拚醉欲酬春。\n僚友同年旧，郎官拜命新。\n不来无此乐，还似姓车人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37402,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"续梦中作","author":"赵抃","text":"边寄今儒弁，帷筹得将才。\n甘辛均士卒，号令走风雷。\n惊晓城鼙急，吹秋陇笛哀。\n先声羌胆碎，闻道汉兵来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37403,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵吴充学士斋居冬夜书事","author":"赵抃","text":"轮奂相辉映，严扉耸画楹。\n霜空夜月午，斋冷湛冰清。\n缛礼行神庙，星华下禁城。\n瀛洲有才士，佳句见交情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37404,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和六弟抗江上书怀","author":"赵抃","text":"一失已戚戚，诚哉勿尔为。\n因知贤者事，不与众人期。\n别浦客帆卸，隔江渔笛吹。\n同行兄弟乐，还免动乡思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37405,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"惊涛","author":"赵抃","text":"路半狂飙起，江心巨浪横。\n苍茫舟子叫，匍匐稚儿惊。\n古岸移时入，新醪薄暮倾。\n此宜无足道，大抵似人生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37406,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"别后寄表弟李定","author":"赵抃","text":"之官虽异数，行棹欲同仙。\n忽觉清风远，因惊俗累牵。\n子留书得后，我愧约乖前。\n境上依依过，江南水拍天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37407,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"彭泽狄梁公祠","author":"赵抃","text":"贤正屯蒙日，阴邪会用时。\n人从万死过，谁肯一言危。\n毒意回天后，忠诚荐柬之。\n复唐三百载，留得枕江祠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37408,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"经鄱阳湖","author":"赵抃","text":"舍陆事川程，霜天晓色明。\n长波万顷阔，大舸一帆轻。\n静唱村渔乐，斜飞渚雁惊。\n云披见楼阁，隐隐豫章城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37409,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵何若谷赏花即席","author":"赵抃","text":"朋心照旧明，宁比盖初倾。\n共惜花兼酒，谁论利复名。\n与君如有约，不醉似无情。\n更遇诗勍敌，周旋未易轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37410,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"纪雨","author":"赵抃","text":"岁始三日雨，恩随万井春。\n如何至和气，先被远方人。\n洗濯山川秀，沾濡草木新。\n尧仁际天地，调燮有臣邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37411,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵提刑蔡挺度支见赠","author":"赵抃","text":"历章初请外，亡状愧瘝官。\n为郡恩尤重，斯民治素难。\n讼稀逢薄稔，诗倡得清欢。\n况复仁封接，焉依簟与菅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37412,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵何若谷中隐堂观棋","author":"赵抃","text":"春昼僧房静，楸枰战气豪。\n斜飞沙塞雁，奔怒海门涛。\n决胜周旋久，阴谋计较劳。\n岂知中隐士，心不挂纤毫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37413,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送兴国令徐师回殿丞","author":"赵抃","text":"报政方山下，分携赣水滨。\n人蒙百里惠，花见四年春。\n亲志乐戏綵，家声高缙绅。\n还期逢庆节，慈宴拱严宸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37414,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登章贡台","author":"赵抃","text":"章贡东西派，并流作赣川。\n奔湍出城曲，离合向台前。\n把酒来凭槛，鸣鼙见放船。\n滔滔归底处，沧海路三千。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37415,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵周敦颐国博重阳节近见菊","author":"赵抃","text":"为僚初自喜，邀客亦逢嘉。\n把酒须同乐，分襟莫预嗟。\n未成登画舸，好共赏黄花。\n试向东篱看，秋丛映晚霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37416,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题张果老洞","author":"赵抃","text":"洞老寿松椿，高名古绝群。\n乱山泉㶁㶁，举世事纷纷。\n使者持丹诏，先生卧白云。\n方今莫招隐，君德正华勋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37417,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠琴台僧正","author":"赵抃","text":"寺古傍郊坰，门无车马声。\n我来闻众妙，人少到师清。\n锦水金波静，银蟾一指明。\n幽琴徐发响，真不负台名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37418,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"留题修觉山","author":"赵抃","text":"按行车暂尼，身得止峥嵘。\n江喜淙淙听，云疑步步生。\n春邻花县好，晴远剑关明。\n买石镌豪句，高哉老杜名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37419,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵孔宪山斋","author":"赵抃","text":"讼简岁丰盈，铃斋竟日清。\n窗排群石怪，檐拥远山明。\n古木风千叶，新髭雪数茎。\n开樽向幽处，馀论见高情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37420,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送前人赴阙","author":"赵抃","text":"正性归忠谊，名谈见本原。\n中丞有贤子，宣圣得真孙。\n解职留民惠，还朝拜主恩。\n东方要安堵，一为上前论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37421,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵吴中复龙图题长桥铺","author":"赵抃","text":"山东去蜀右，不惮客程遥。\n酒酌杯中醁，琴携爨下焦。\n故人题大笔，佳句刻长桥。\n快读离怀解，如冰暖日消。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37422,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄衢僧惟简","author":"赵抃","text":"南禅众所称，简老是真僧。\n法器闻虽古，清风见未曾。\n洪炉中点雪，大海里孤灯。\n七十休官近，归欤我得朋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37423,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄谢毛宪","author":"赵抃","text":"去赣八千里，于今十二年。\n无缘久东浙，有命再西川。\n吏散庭空讼，僧高寺欲禅。\n老来思旧治，尤喜获佳篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37424,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送范宪百禄赴阙","author":"赵抃","text":"泥书下紫宸，公议协朝绅。\n真主正图治，谏官今得人。\n从容陪国论，憔悴恤天民。\n大对如晁董，公尝素所陈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37425,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和荣諲学士按部过长濆关所寄诗","author":"赵抃","text":"叱驭穷边垒，还辕赏驿梅。\n微香心旋吐，清咏意尤瑰。\n诲墨蒙兼贶，邮筒喜屡开。\n锦官花更好，翘望腊前回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37426,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闵雨","author":"赵抃","text":"闵雨诏复下，伤农今四春。\n潭龙从号懒，庙鬼讵能神。\n苗槁尘生久，云空电转频。\n天公诚可问，谁与主陶钧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37427,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵李元方秀才秋日旅怀","author":"赵抃","text":"节物奚为感，秋怀不自任。\n晓寒侵远梦，秋力助高吟。\n薄脱惊风叶，疏舂隔水砧。\n商弦调一曲，惟子定知音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37428,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题灵山寺","author":"赵抃","text":"我为灵山好，登留到日曛。\n岩幽馀暑雪，钟冷入秋云。\n篇咏惟僧助，尘烦与俗分。\n明朝入东棹，因得识吾文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37429,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题致政周洙屯田如诏亭","author":"赵抃","text":"诰出义方语，亭更发诏名。\n为郎拜天宠，有子擅家声。\n健羡乡评美，光辉野史荣。\n綵衣官亦重，门外拥双旌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37430,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"致政都官宋兄言归旧隐赠行","author":"赵抃","text":"休官镇浮俗，眉寿冠同年。\n恬养八十岁，苦吟三百篇。\n乘秋迓杖屦，终日隐林泉。\n我羡归欤乐，高踪不可肩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37431,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游海云山","author":"赵抃","text":"缥缈齐云阁，遥闻摸石池。\n物华春已盛，人意乐无涯。\n罗绮一山遍，旌旗十里随。\n花棚夹归道，骁骑看星驰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37432,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵程给事赴越任过杭相会","author":"赵抃","text":"已久论交契，何妨醉别筵。\n君宜归大用，我独倦高年。\n郡印今分治，科名昔共镌。\n离怀虽一水，言远似三川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37433,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题杭州双竹寺","author":"赵抃","text":"粉箨双双脱，修篁两两高。\n同心齐管鲍，并节汉萧曹。\n寒岁霜威禦，炎天暑气逃。\n此君真可异，吟绕不知劳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37434,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送章岵少卿提举洞霄宫二首 其一","author":"赵抃","text":"秘馆红尘外，瑶京白日边。\n樽中不空酒，琴面已无弦。\n晓上朝真阁，春耕负郭田。\n优游大自在，何处更神仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37435,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送章岵少卿提举洞霄宫二首 其二","author":"赵抃","text":"使节忠罄勤，东南两见春。\n清宵多假寐，白发半忧民。\n金阙遥辞宠，琳宫去谒真。\n羡公谁最甚，我是欲归人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37436,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵赵少师寄别程给事","author":"赵抃","text":"人生难会合，天与此阶缘。\n逸驾来艰远，孤帆映后前。\n吴江阻潮汐，越峤望云烟。\n叙别情何厚，新诗两灿然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37437,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送六弟随子之官毗陵","author":"赵抃","text":"雁序暂分飞，毗陵动所思。\n廉能真有子，清白素闻诗。\n船泛西州远，山寻北荡奇。\n明春复归会，还是隔年期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37438,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"览先祖太傅留题国清寺继和","author":"赵抃","text":"得谢殊狂客，无言愧净名。\n心观潭月白，梵听海潮声。\n晓色开华顶，秋晖照赤城。\n公诗播人口，冰玉未为清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37439,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"抵永嘉题谢公岩","author":"赵抃","text":"岭路与岩坰，池楼古郡城。\n千年温俗意，四榜谢公名。\n寄傲留佳句，遗思出至诚。\n滔滔慎江水，东注等休声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37440,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠郑赓高士","author":"赵抃","text":"易有幽人象，天垂处士星。\n知音辞相府，归养为亲庭。\n閒和碧云句，深穷白首经。\n惟贤二千石，优顾眼尤青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37441,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"早离温江夜泊白沙步","author":"赵抃","text":"晓与诸孙别，依然颇动怀。\n去乘兰棹稳，行得綵衣偕。\n渔父遥连市，村扉半掩柴。\n夜来溪上宿，梦已在高斋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37442,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵寄致政石牧之大夫","author":"赵抃","text":"予退喜同休，翻思慎水游。\n閒云披远岫，明月在高楼。\n送日千馀里，离怀三度秋。\n争如禅客子，截断众江流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37443,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄酬吴天常中散","author":"赵抃","text":"仕契最敦厚，夤缘绝夤伦。\n同登甲戌第，俱是戊申人。\n把酒曾四老，分携又五春。\n新诗光箧笥，珠宝未为珍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37444,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送毛宽任清流主簿","author":"赵抃","text":"轻舟离晓岸，凉气满秋空。\n鸾枳从官况，蟾宫继父风。\n荣涂终颉颃，清节愈磨砻。\n今我所期子，名当彻舜聪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37445,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西湖吴中允坟生芝草","author":"赵抃","text":"中允寿龄尊，人亡德尚存。\n无根彼芝草，为瑞此松坟。\n往行称乡井，遗荣付子孙。\n灵苗岂虚设，所应在高门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37446,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送吴柏节推赴阙","author":"赵抃","text":"简刑忧俗困，一境被恩私。\n清极人知劝，诚先吏不欺。\n席觞徒眷恋，岸菊渐离披。\n荐鹗有馀表，横飞去指期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37447,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿故梁子正得意堂有感示诸梁英少","author":"赵抃","text":"遗训素谆谆，先生冢尚新。\n门风竞兰玉，乡誉动簪绅。\n户牖宵排烛，琴书昼拂尘。\n子孙为学盛，宜有起家人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37448,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"外弟李定少卿挽诗三首 其一","author":"赵抃","text":"子舍竞诜诜，号天日月昏。\n有绡传秀像，无药反英魂。\n右棘官虚位，西山墓闭门。\n遣余衣上泪，时复有啼痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37449,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"外弟李定少卿挽诗三首 其二","author":"赵抃","text":"少列吾姑子，怀能负俊良。\n歌诗追李杜，笔札出钟王。\n道指三千远，年踰六十亡。\n嗟哉长已矣，冠剑失威光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37450,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"外弟李定少卿挽诗三首 其三","author":"赵抃","text":"福地生奚似，丧人送几何。\n环环山水秀，蛰蛰子孙多。\n情悼魂兮些，辞凭挽者歌。\n嗟余身在越，西首泪滂沱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37451,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"故吴丞相充挽诗三首 其一","author":"赵抃","text":"富贵三朝老，公忠百辟师。\n跻民复仁寿，与国系安危。\n圣意加优注，荣途亦屡辞。\n人嗟五福内，独不享期颐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37452,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"故吴丞相充挽诗三首 其二","author":"赵抃","text":"论道尊三事，登庸历十年。\n舜尝咨尔岳，说已济斯川。\n太史书清德，高门继象贤。\n都人瞻绘像，衮服冠貂蝉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37453,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"故吴丞相充挽诗三首 其三","author":"赵抃","text":"纯诚先德行，馀事著文章。\n所予维中寿，难谋彼上苍。\n旌铭笼晓月，挽铎诉秋霜。\n自愧居田里，无缘奠柩觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37454,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄开化余遵道","author":"赵抃","text":"野老余遵道，人微德义尊。\n家居青嶂底，身在白云根。\n盛事传闾里，昌期付子孙。\n不烦迂步远，此去自高门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37455,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]