[{"title":"摊破浣溪沙 其二","author":"李清照","text":"病起萧萧两鬓华，卧看残月上窗纱。\n豆蔻连梢煎熟水，莫分茶。\n枕上诗书闲处好，门前风景雨来佳，终日向人多酝藉，木犀花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63400,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"摊破浣溪沙 其一","author":"李清照","text":"揉破黄金万点轻，剪成碧玉叶层层。\n风度精神如彦辅，太鲜明。\n梅蕊重重何俗甚，丁香千结苦粗生。\n熏透愁人千里梦，却无情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63401,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"新荷叶","author":"李清照","text":"薄露初零，长宵共、永昼分停。\n绕水楼台，高耸万丈蓬瀛。\n芝兰为寿，相辉映、簪笏盈庭。\n花柔玉净，捧觞别有娉婷。\n鹤瘦松青，精神与、秋月争明。\n德行文章，素驰日下声名。\n东山高蹈，虽卿相、不足为荣。\n安石须起，要苏天下苍生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63402,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"满庭芳","author":"李清照","text":"小阁藏春，闲窗锁昼，画堂无限深幽。\n篆香烧尽，日影下帘钩。\n手种江梅更好，又何必、临水登楼？\n无人到，寂寥恰似、何逊在扬州。\n从来，知韵胜，难堪雨藉，不耐风揉。\n更谁家横笛，吹动浓愁？\n莫恨香消雪减，须信道、扫迹情留。\n难言处，良宵淡月，疏影尚风流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63403,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"满庭芳","author":"李清照","text":"芳草池塘，绿阴庭院，晚晴寒透窗纱。\n□□金锁，管是客来唦。\n寂寞尊前席上，惟□□、海角天涯。\n能留否？\n酴醾落尽，犹赖有□□。\n当年，曾胜赏，生香熏袖，活火分茶。\n□□龙骄马，流水轻车。\n不怕风狂雨骤，恰才称、煮酒残花，如今也，不成怀抱，得似旧时那。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63404,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"瑞鹧鸪 双银杏","author":"李清照","text":"风韵雍容未甚都，尊前甘橘可为奴。\n谁怜流落江湖上，玉骨冰肌未肯枯。\n谁教并蒂连枝摘，醉后明皇倚太真。\n居士擘开真有意，要吟风味两家新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63405,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"殢人娇 后庭梅花开有感","author":"李清照","text":"玉瘦香浓，檀深雪散，今年恨探梅又晚。\n江楼楚馆，云闲水远。\n清昼永，凭栏翠帘低卷。\n坐上客来，尊前酒满，歌声共水流云断。\n南枝可插，更须频剪，莫待西楼，数声羌管。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63406,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蝶恋花 其一","author":"李清照","text":"泪湿罗衣脂粉满，四叠阳关，唱到千千遍。\n人道山长山又断，潇潇微雨闻孤馆。\n惜别伤离方寸乱，忘了临行，酒盏深和浅，好把音书凭过雁，东莱不似蓬莱远。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63407,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蝶恋花 上巳召亲族","author":"李清照","text":"永夜恹恹欢意少，空梦长安，认取长安道。\n为报今年春色好，花光月影宜相照。\n随意杯盘虽草草，酒美梅酸，恰称人怀抱。\n醉里插花花莫笑，可怜春似人将老。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63408,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蝶恋花 其二 离情","author":"李清照","text":"暖日晴风初破冻，柳眼梅腮，已觉春心动。\n酒意诗情谁与共，泪融残粉花钿重。\n乍试夹衫金缕缝，山枕斜欹，枕损钗头凤。\n独抱浓愁无好梦，夜阑犹剪灯花弄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63409,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"醉花阴","author":"李清照","text":"薄雾浓云愁永昼，瑞脑消金兽。\n佳节又重阳，玉枕纱厨，半夜凉初透。\n东篱把酒黄昏后，有暗香盈袖。\n莫道不消魂，帘卷西风，人比黄花瘦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63410,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天","author":"李清照","text":"寒日萧萧上锁窗，梧桐应恨夜来霜。\n酒阑更喜团茶苦，梦断偏宜瑞脑香。\n秋已尽，日犹长，仲宣怀远更凄凉。\n不如随分尊前醉，莫负东篱菊蕊黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63411,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天","author":"李清照","text":"暗淡轻黄体性柔，情疏迹远只香留。\n何须浅碧深红色，自是花中第一流。\n梅定妒，菊应羞，画栏开处冠中秋。\n骚人可煞无情思，何事当年不见收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63412,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"李渎","text":"行到水穷处，未知天尽时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63413,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜迁莺 其一","author":"李焕","text":"云蒸雷动。\n庆瑞岳降真，祥生申甫。\n元后慈贤，勋臣英烈，百世显光家谱。\n久许致身忠孝，何止满怀今古。\n听舆论，是侯王苗裔，神仙俦侣。\n争睹藩尹盛，刑揩政成，和气横眉宇。\n北阙莺花，西湖风月，旌骑稳游天路。\n福海寿山无比，烂醉黄堂歌舞。\n正荣耀，有华姻宠授，清朝恩数。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63414,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜迁莺 其二","author":"李焕","text":"风云嘉会，有英杰瑞时，来符平泰。\n子建才华，平阳勋业，流庆至今犹在。\n闾史卿来曾记，骨相堂堂庞艾。\n少年日，已心包云泽，名高嵩岱。\n超迈人尽道，今代吏师，小试犹淹大。\n两路登车，三州出牧，游刃了无凝碍。\n便合进推荷橐，迤逦参陪天縡。\n愿从此，奉明君真相，优游千载。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63415,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十月过昭觉庭梅萧然已动人意因作二十八字","author":"李焘","text":"厌逐游人药市行，暂来心迹喜双清。\n疏风细雨荒庭菊，便觉梅花暗有情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63416,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"升元寺 其一","author":"李焘","text":"看尽庵前手种松，草堂聊复少从容。\n令人却忆骑驴老，悔不终身作卧龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63417,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"升元寺 其二","author":"李焘","text":"升元古寺宝灵珠，照影东西与众殊。\n本为仁皇贲潜府，岂知今日镇留都。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63418,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"成都施氏园海棠方盛时觅酒径醉二月九日","author":"李焘","text":"染根著色谢天公，破睡犹禁一再风。\n为此径须浮大白，老夫元自爱深红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63419,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岑公洞","author":"李焘","text":"隋邦危乱谁得免，虚鉴真人愿独行。\n道骨仙风今可想，幽栖岩洞及高明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63420,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"望川亭","author":"李焘","text":"潼川绕郭多名寺，都在少陵诗句中。\n西上飞亭更奇绝，水光山色两无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63421,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题龙鹄山房","author":"李焘","text":"已作清时鸟倦飞，杜鹃更劝阿谁归。\n似嫌住处犹城郭，不解携家隐翠微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63422,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"灵云岩","author":"李焘","text":"路转层冈十里馀，武陵传者亦难如。\n昔年炼药仙人室，今日餐霞道士居。\n洞外蟠花开锦绣，岩前石溜漱琼琚。\n猗欤灵气为时雨，可惜图经阙不书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63423,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"制胜楼","author":"李焘","text":"画省容台记并游，相思相望几登楼。\n路长久叹音尘绝，事变还惊岁月流。\n合侍钧天终雅奏，却穿巴峡看横舟。\n欲酬嘉惠须新语，老觉枯肠不奈搜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63424,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"客怀 其四","author":"李焘","text":"雨意忽如此，客愁将奈何。\n出门谁可诣，掩卷独高歌。\n尘世兔三穴，古人蓬一窠。\n区区奚足道，默默幸无它。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63425,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"客怀 其二","author":"李焘","text":"久客厌尘土，幽居怀翠微。\n只馀清夜梦，长作故山归。\n菊已开三径，松应长十围。\n晨钟忽惊觉，犹有露沾衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63426,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"客怀 其三","author":"李焘","text":"壮矣府中县，索如城外村。\n墨池今扫迹，石笋旧馀根。\n风急汉弦断，雨多秦镜昏。\n新秋一怀古，情绪若为论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63427,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"客怀 其一","author":"李焘","text":"寂寞三秋节，凄凉万里风。\n关河尽形胜，人物几英雄。\n秦叶随流水，周禾满故宫。\n此心悬象阙，梦绕浙西东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63428,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"客怀 其五","author":"李焘","text":"长忆在家好，已知从仕难。\n纷纷犹嚇鼠，悄悄政栖鸾。\n忘意蹑高位，敢言卑小官。\n世途真甚隘，怀抱要须宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63429,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"洞庭","author":"李焘","text":"镜面千顷阔，修眉一带横。\n湖深有龙蛰，山静少人行。\n似与真仙约，都无世俗情。\n鸟啼猿叫歇，轩乐有馀声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63430,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登金山","author":"李焘","text":"金山何处好，四顾不相连。\n窗迥前无地，波澄下有天。\n堂留三楚客，门泊五湖船。\n暝色关诗思，江笼两岸烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63431,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三月二十日出郊泛舟西津得予字","author":"李焘","text":"春日行郊坰，南风初唱予。\n相携出城郭，著意买江湖。\n句好从儿觅，杯乾任客呼。\n长年足诗酒，此外复何须。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63432,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"从何使君父子游墨池分韵得名字","author":"李焘","text":"蜀学擅天下，马王先得名。\n簧如巧言语，于道盖小成。\n子云最后出，振策思遐征。\n斯文大一统，欻使圣域清。\n富贵尽在我，绂冕非所荣。\n旁皇天禄阁，聊亦观我生。\n怀哉不能归，旧宅荒榛荆。\n寂寞竟谁顾，正路今莫行。\n使君蓬莱仙，弭节归赤城。\n门无俗宾客，家有贤父兄。\n慨念此耆老，不登汉公卿。\n临池一樽酒，尚友千载英。\n并呼严与李，月旦共细评。\n区区可无憾，彼重适我轻。\n朅来成都市，尘土污冠缨。\n古人不可见，见此眼自明。\n请为怀古诗，玉振而金声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63433,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"长生观","author":"李焘","text":"成家得将军，如越大夫蠡。\n功成拂衣去，智囊未叩底。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63434,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"龙鹄山","author":"李焘","text":"西山有佳人，惯踏山下路。\n晨吟泽畔风，午睡岩前雨。\n莫使儿辈觉，损我岩壑趣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63435,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观施氏芍药呈同游者","author":"李焘","text":"怪底吹残万点红，馀妍都在此花中。\n攀枝未许风流尽，振袂还知结习空。\n杳杳人谁赠南园，菲菲身恐堕仙宫。\n乞将新雨酬佳丽，始信青春不负公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63436,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"拥翠楼","author":"李焘","text":"淳熙元年九月尾，菊未落英梅破蕊。\n从来两美难必合，今忽得此一笑喜。\n人言地瘴物失时，进忌太蚤退苦迟。\n老夫亦岂不自觉，姑与饮酒仍赋诗。\n忍令芳草直为艾，封植嘉树宁少待。\n夕餐九华可无死，却期老岁于吾子。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63437,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"信相院水月亭","author":"李焘","text":"水中之月不可取，收揽结成湖上亭。\n天光沉沉射虚白，夜色耿耿含空青。\n朅来穷冬所见异，但有破块黏枯萍。\n吾心皎洁竟何似，本自无物谁当铭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63438,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游蔡山","author":"李焘","text":"岩峦最高顶，云气时蔚荟。\n彷佛群仙宅，宫阙曜珠贝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63439,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鼎建金釜仙山灵泉古观碑","author":"李焘","text":"臣閪独步转淦浪，□□□□□□阳。\n风生□□□□□，紫气缤纷赛锦堂。\n欲频了了载诗酒，总为超□□□阴。\n幽胜若天香境万，□舍兴乐招掌爱。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63440,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"李焘","text":"试上层楼高处望，十洲三岛似蓬莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63441,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"李焘","text":"瓦屋如案平，金仙閟光景。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63442,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其六","author":"李焘","text":"行亦自劾去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63443,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其五","author":"李焘","text":"平盖神仙院，武阳山水乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63444,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其四","author":"李焘","text":"山绕一城藏几寺，江连二水送孤舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63445,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其三","author":"李焘","text":"断碑唐日寺，遗像晋时僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63446,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题金陵杂兴诗后 其八","author":"李琏","text":"南轩隐约夜声微，独咏齐梁绮靡诗。\n鬼火对山青焰短，依稀忆得独眠时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63447,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初至长干寺","author":"周文璞","text":"云杪荧荧一塔灯，觉皇舍利宝烟凝。\n山门推上三更月，似照前朝礼拜僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63448,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题金陵杂兴诗后 其六","author":"李琏","text":"司马家儿持酒杯，天星下吸亦佳哉。\n恨渠不便效牛饮，那得孟津师旅来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63449,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题金陵杂兴诗后 其五","author":"李琏","text":"南门点检旧行踪，最苦人人认得侬。\n羞涩面皮无处著，横拖山屐过青松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63450,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题金陵杂兴诗后 其四","author":"李琏","text":"夜过江左从鸾旂，从此灵君著汉衣。\n春到阴山花似雪，望乡台上鹧鸪飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63451,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题金陵杂兴诗后 其三","author":"李琏","text":"相君息女小乘僧，身向西天佛律行。\n三尺戒坛秋色紧，个中蝼蚁亦长生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63452,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"径山玉芝庵主源上人持痴绝老人语录求作行状留连踰月谈论铿锵音吐鸿畅众中之龙象也临别书二绝赠行 其二","author":"赵若琚","text":"应密单传的的真，一番举起一番新。\n老师末后殷勤语，直下承当正要人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63453,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题金陵杂兴诗后十八首 其九","author":"李琏","text":"离离禾黍已难言，空觅枫林与菜园。\n瓦屋半间非辱井，经幢两个即升元。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63454,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大涤洞留题 其二","author":"裴良杰","text":"鸠杖先生旨趣深，探直搜隐事幽寻。\n顶头有眼谁能识，心鉴无尘物莫侵。\n洞里烟霞人不老，水边花木自成阴。\n乞师金鼎丹炉火，为慰平生觉道心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63455,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂咏 其二","author":"周文璞","text":"长干小妇学吹箫，楼外閒风弄翠条。\n近得广陵消息未，暮潮已过赤栏桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63456,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题金陵杂兴诗后 其一","author":"李琏","text":"花开似污天衣血，雨过重闻御案香。\n最恨寺奴隳太极，预先夺我画梅梁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63457,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大涤洞留题 其二","author":"赵汝諿","text":"家近云山九锁深，诛茅已负十年心。\n笋舆扶醉归来晚，清梦犹闻金玉音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63458,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂咏 其一","author":"周文璞","text":"滟滟江波绿更肥，苍烟中有鸭鸥飞。\n当年神武今何在，老却遗民更不归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63459,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题金陵杂兴诗后 其七","author":"李琏","text":"孙帝陵傍水最悲，蒋侯庙下月来迟。\n夜深客子心惊恐，猿挂南朝枫树枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63460,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题金陵杂兴诗后 其二","author":"李琏","text":"池边石是南朝石，绿染苔花亦可怜。\n今日波平人事变，白鱼犹自跃天泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63461,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"暮雨","author":"周文璞","text":"暮雨潇潇郎不归，尊前谁忆旧歌词。\n望夫乌臼浓于染，叶叶惊秋恨欲飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63462,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"李略","text":"此身若得西归去，犹胜开笼放雀儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63463,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送舒殿丞","author":"李维","text":"读碑经岘首，贳酒过宜城。\n莫问依刘事，休伤吊屈情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63464,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"休沐端居有怀希圣","author":"李维","text":"银阙琳房视草馀，龙门岑寂断轩车。\n彩毫闲试金壶墨，青案时看玉字书。\n王令风流希谢傅，子云词赋敌相如。\n琼枝不见萧斋晚，蕙草烟微度绮疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63465,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送张无梦归天台","author":"李维","text":"金骨一何轻，瞳方鬓复青。\n楼居隐岩桂，飙驭别阶蓂。\n玉宇藏丹诀，雕觞泛绿醽。\n霞城中夕梦，悬想在彤庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63466,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送僧归护国寺","author":"李维","text":"香刹隐霞标，斋房见落潮。\n归思海众绕，来应辅臣招。\n倚策吟云合，乘杯咒浪销。\n曹溪久得法，游戏自逍遥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63467,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"霜月","author":"李维","text":"银床叶暗飘，霜月夜迢迢。\n寒极犀难辟，忧多酒漫消。\n荀炉残更换，湘瑟罢仍调。\n谁道河流浅，盈盈万里遥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63468,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]