[{"title":"畜一鸡报晓声清圆而鸣每晚戏书绝句","author":"陆游","text":"鸡鸣平旦未为迟，恰是山房睡觉时。\n著屐起寻溪上路，野梅犹有未残枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5866,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病中卧闻舂声二首 其一","author":"陆游","text":"丘嫂羹存先戛釜，山僧斋竟始鸣钟。\n孰知造物独怜我，一日未尝无夕舂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5867,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病中卧闻舂声二首 其二","author":"陆游","text":"妄想说梅犹止渴，真闻舂米固忘饥。\n未论炊熟香生甑，已觉抄来雪满匙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5868,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病中夜半","author":"陆游","text":"萧萧欲脱犹吟叶，耿耿微明未灭灯。\n夜半不眠闲倚壁，使君清似北山僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5869,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病中忽有眉山士人史君见过欣然接之口占绝句","author":"陆游","text":"蜀语初闻喜复惊，依然如有故乡情。\n绛罗饼餤玻璃酒，何日蟆颐伴我行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5870,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病中绝句六首 其四","author":"陆游","text":"造物今年悯我劳，微痾得遂闭门高。\n黄紬被暖青毡稳，不怕郊原雪意豪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5871,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病中绝句六首 其三","author":"陆游","text":"酒味醺人睡味浓，午时高枕到昏钟。\n经旬不见西窗日，世上应无懒似侬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5872,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病中绝句六首 其一","author":"陆游","text":"酒钱自昔从人乞，诗思出门何处无。\n青箬织篷菅织席，此生端欲老江湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5873,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病中绝句六首 其六","author":"陆游","text":"少时谈舌挟风雷，病后逢人口懒开。\n安得东皋隐君子，相看无语只衔杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5874,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病中绝句六首 其二","author":"陆游","text":"半脱貂裘雪满鞍，惯将豪举压儒酸。\n病来意气浑非昨，一炷香烟帐底看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5875,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病中绝句六首 其五","author":"陆游","text":"青荧犹有佛灯明，点滴时闻竹露声。\n欲睡不成还起坐，丽谯风顺报三更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5876,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病中遣怀六首 其二","author":"陆游","text":"放生何足为爱物，施药因行聊结缘。\n山舍老翁无事业，只将闲事占流年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5877,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病中遣怀六首 其六","author":"陆游","text":"开皱紫栗如拳大，带叶黄柑染袖香。\n天与山家讲邻好，江天昨夜有新霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5878,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病中遣怀六首 其五","author":"陆游","text":"菘芥煮羹甘胜蜜，稻粱炊饭滑如珠。\n上方香积宁过此，惭愧天公养病夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5879,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病中遣怀六首 其三","author":"陆游","text":"鲜肥莫事肤寸舌，萧散何辜七尺躯。\n山路岂无孤店宿，渡头亦有小舟呼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5880,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病中遣怀六首 其四","author":"陆游","text":"家贫不与身添业，病久宁非天儆予。\n扫尽世间闲忿欲，小园烟雨种春蔬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5881,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病中遣怀六首 其一","author":"陆游","text":"人生长短无百岁，八十五年行九分。\n堪笑痴翁作黠计，欲将绳子系浮云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5882,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病后晨兴食粥戏书","author":"陆游","text":"蝴蝶庄周安在哉，达人聊借作嘲诙。\n不知自此随缘住，更把晨窗粥几杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5883,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病思六首 其二","author":"陆游","text":"杀物求君舌本肥，是非岂复待深思。\n即今不足何时足，小甑香粳日两炊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e0