[{"title":"送僧之雪峰","author":"释普度","text":"南山鳖鼻死多时，何苦崎岖要觅伊。\n无底篮儿收拾得，不妨挑取杖头归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18936,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"益侍者请赞","author":"释普度","text":"面目可憎，胸中条直。\n勿彼勿此，何损何益。\n不将佛法当人情，一任破沙盆狼藉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18937,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蚬子赞","author":"释普度","text":"不钓鲸鳌只捞蚬，得些滋味兴偏佳。\n拈来塞断娘生口，一段风光属当家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18938,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"钱清接待","author":"释普度","text":"短策轻囊称野情，憧憧何事过钱清。\n入门吃饭出门去，莫道沃洲山水青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18939,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其一○九","author":"释普度","text":"二大老，一人船行，一人步到。\n狭路相逢，掀眉一笑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18940,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其七十九","author":"释普度","text":"普天寒色，大地为炉。\n但见清风壁立，不知石烂松枯。\n丹霞烧木佛，因甚院主堕眉须。\n若无这些火种，讨甚碧眼老胡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18941,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其三十四","author":"释普度","text":"风号寒，霜凛冽。\n屋浪崩腾，飞银撒雪。\n截流过者，未称全提。\n作死马医，暖气相接。\n倒腹倾肠一线通，月明不借芦花白。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18942,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其十二","author":"释普度","text":"十五日已前，只许老胡知，不许老胡会。\n十五日已后，只许老胡会，不许老胡知。\n正当十五日，会不会，知不知。\n风细细，日迟迟。\n不惜黄金为弹子，牡丹花下打黄鹂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18943,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其六十四","author":"释普度","text":"兔马有角，牛羊无角。\n寸毫尺釐，天地寥廓。\n潘阆倒骑驴，攧杀黄番趠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18944,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其三十六","author":"释普度","text":"烹佛炼祖，锻圣镕凡。\n杀活在手，宝剑光寒。\n意在星兮不在盘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18945,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其六十六","author":"释普度","text":"祖师门下，讨甚巴鼻。\n东行西行，无是不是。\n忽然篱下菊花黄，此时决定是重阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18946,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其十","author":"释普度","text":"毫末非轻，丘山非重。\n按佛祖云头，穿衲僧鼻孔，剖破方知无罅缝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18947,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其一一○","author":"释普度","text":"天无四壁，大地为炉。\n篱头吹觱栗，寒雁一声孤。\n老胡若不渡江去，至今火种一星无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18948,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其四十一","author":"释普度","text":"大机圆应，大智无方。\n右左逢原，七穿八穴。\n万叠云山一抹过，十八滩头声浩浩。\n遇贵即贵，遇贱即贱。\n法随法行，法幢随处建立。\n要津把断，纵夺临时。\n风细细，日迟迟。\n四海浪平龙睡稳，九天云净鹤高飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18949,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其九十六","author":"释普度","text":"清明前，寒食后，花雨漫天云满岫。\n谁家小犊力未完，但知逐队随群走。\n阿呵呵，索头只在翁翁手。\n当机一掣掣断时，野犴便作师子吼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18950,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其一一八","author":"释普度","text":"忆昔当年错访寻，被他用尽毒肝心。\n赚来赚到凌霄顶，火冷云寒恨转深。\n冤可解，不可结，必竟如今甚时节。\n打拳何似吃拳时，此理明明向谁说。\n旋汲龙渊万丈深，烂煮春茶翻白雪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18951,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其三十九","author":"释普度","text":"白云高，滩水急。\n不动脚头，全身直入。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18952,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其二","author":"释普度","text":"悟道染泥沙，佛祖生冤家。\n新半山为甚烧香礼拜，明珠绝颣，皓玉无瑕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18953,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其二十二","author":"释普度","text":"月冷天高，风号怒涛。\n提杀人剑，用活人刀。\n云淡淡寒江雁影，山渺渺落日危巢。\n见成题目，眨上眉毛。\n万机顿罢归来，也是徒劳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18954,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其十九","author":"释普度","text":"雨洗炎威，秋磨霄汉。\n风传䆉稏香，雁腹寒岩畔。\n位转功回木马嘶，劫外不须重借伴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18955,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其五十五","author":"释普度","text":"妙德岩中宴坐时，释梵天王同赞喜。\n地摇六振雨花飞，一声霹雳清飙起。\n沧海头，青海尾。\n杨岐毒，种灵苗，殃害儿孙未已。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18956,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其九十一","author":"释普度","text":"入荒田，出荒田，信手拈来颗颗圆。\n横三千，竖三千。\n虽曰眼底空花，直是明白洞然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18957,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其四","author":"释普度","text":"一佛出世，千佛赞扬。\n十方坐断，独露真常。\n山苍苍，云苍苍。\n半开半合，隐显全彰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18958,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其六","author":"释普度","text":"雨涤炎威，秋云自在。\n一片两片拄杖头，或卷或舒林木外。\n白璧明珠，泥团土块。\n放去收来颗颗圆，填沟塞壑无人会。\n阿呵呵，六只骰子满盆红，有采无采，大家别赛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18959,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其二十","author":"释普度","text":"布袋头开天地大，翠岩眉毛在不在。\n一声鸿雁海门秋，行人已在青山外。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18960,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其四十","author":"释普度","text":"花簇簇，锦簇簇。\n吟不足，咏不足。\n的的无弦琴上曲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18961,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其三十三","author":"释普度","text":"山之高，水之深，非古亦非今。\n老胡打失一只履，葱岭那边无处寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18962,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其一一六","author":"释普度","text":"时临秋九，不寒不热。\n瓦砾鸣秋蛩，茅檐挂残月。\n各自著便宜，正是好时节。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18963,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其四十八","author":"释普度","text":"来何迟，去何速，十七日缘今已足。\n拄杖横担归去来，一笑出门山水绿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18964,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其六十","author":"释普度","text":"垂垂白发老成魔，异类中行罪过多。\n业债既深偿未足，又拖犁杷出烟萝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18965,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其八十七","author":"释普度","text":"二千年前，毗蓝园里。\n地动山摇，祸胎忽起。\n云门瞎棒打不死，后代儿孙空切齿。\n休切齿，杓柄短长，浇泼在你。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18966,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其四十二","author":"释普度","text":"春风卷春雨，春树生春烟。\n作家相见不谈禅。\n天寒烧榾柮，云外煮清泉。\n更有一般风味在，从来附子出西川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18967,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其八十一","author":"释普度","text":"拔地凌霄峰，嵯峨倚寥泬。\n一夜天风忽吹折，木马悲嘶，石人哽咽。\n晓来云散谷风清，千古虚堂照明月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18968,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其六十五","author":"释普度","text":"十五日已前，银山铁壁。\n十五日已后，铁壁银山。\n正当十五日，一尘不立天地宽，那知更有上头关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18969,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其一○五","author":"释普度","text":"屋里有金，外头有秤。\n盐咸醋淡，斤两自定。\n自然左右逢原，管取拍拍是令。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18970,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其二十一","author":"释普度","text":"千说万说，不如亲见。\n有时怒涛衮底，有时水清月现。\n风飕飕冷啾啾，虽然旧阁闲田地，一度赢来方始休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18971,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其一○一","author":"释普度","text":"一佛出世，祥光布地。\n一念万年，寿山增翠。\n晓来风起满庭香，吹绽蟠桃三五蕊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18972,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其七十六","author":"释普度","text":"八月九月，不寒不热。\n盘山掷剑挥空，正是个般时节。\n无古无今，无间无歇。\n痴云卷尽雨声收，千里万里一条铁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18973,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其一○四","author":"释普度","text":"山前一片闲田地，旷大劫来无界至。\n今朝恢复又归来，坐断脚头并脚尾。\n东也是，西也是，南北东西无不是。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18974,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其七","author":"释普度","text":"说禅说道，撒土撒沙，半山终不也随邪。\n重阳定在九月九，东篱何处无黄花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18975,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其七十七","author":"释普度","text":"露滴滴，风凄凄。\n黄花香满路，何独在东篱。\n高低普应，步步相随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18976,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其一二二","author":"释普度","text":"学道先须有悟由，贼无种，相鼓儱，还如曾斗快龙舟，碧眼胡僧笑不休。\n虽然旧阁闲田地，物见主，眼卓竖。\n一度赢来方始休，绿杨影里戴嵩牛。\n如是安居，如是禁足。\n知投身于火悉皆成火，似镕像为金莫不□□。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18977,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其一一四","author":"释普度","text":"铁网漫漫面面开，百城几度去还来。\n二千年结知谁解，又著三文买草鞋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18978,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其九十九","author":"释普度","text":"秧入土，麦上场。\n丰年已兆，比屋盈仓。\n饥来吃饭，热来乘凉。\n东倒西擂，随缘遇方。\n更无馀事可商量，夜来却被子规啼断肠。\n因甚如此，阎罗老子要饭钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18979,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其五十六","author":"释普度","text":"手指天，脚踏地。\n目顾四方，真少儿戏。\n自言惟我独尊，天上人间诽诽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18980,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其八十八","author":"释普度","text":"说禅说道易，成佛作祖难，突出门前大案山。\n成佛作祖易，说禅说道难，南海波斯念八还。\n也不难，也不易，衲僧敲处辽天鼻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18981,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其九十","author":"释普度","text":"开口不是禅，闭口不是道。\n只是个轮槌，拈来用恰好。\n一击天门开，万象俱靠倒。\n狭路忽相逢，拍掌呵呵笑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18982,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其九十七","author":"释普度","text":"船来也到，陆来也到。\n船来陆来，红日杲杲。\n白云缺处烧痕青，春在少林元不老。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18983,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其二十四","author":"释普度","text":"清明寒食节，韶光烂漫时。\n野花迷古径，回首暮云低。\n纸钱飞处杜鹃啼，不是苦心人不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18984,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其八十","author":"释普度","text":"海门一夜波涛恶，玉麟攧折黄金角。\n鱼龙虾蟹尽潜踪，大悲千手难摸索。\n木马悲嘶，石人泪落。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18985,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其五十三","author":"释普度","text":"落叶辞柯满竹扉。\n道道，何处寻。\n今即古，古即今。\n曹溪波浪如相似，无限平人被陆沈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18986,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其一○○","author":"释普度","text":"见身无实是佛见，了心如幻是佛了。\n了得身心本性空，斯人与佛何殊别。\n坐底坐，立底立。\n触目遇缘，更非他物。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18987,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其七十四","author":"释普度","text":"不钉桃符，不悬艾虎。\n驾铁牛机，击涂毒鼓。\n千妖百怪尽潜踪，灵鹫峰高日卓午。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18988,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其一","author":"释普度","text":"前不搆店，后不迭村。\n当阳坐断，上下平分。\n更看直透云霄之顶，独步乾坤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18989,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其一○三","author":"释普度","text":"用文武火，运恶钳锤。\n死学者偷心，开人天眼目。\n大用机前转辘辘，十分慈悲，十分恶毒。\n六踞名蓝兮一笑来归，青灯夜寒兮香风馥馥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18990,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其二十七","author":"释普度","text":"年年是好年，日日是好日。\n新年人看旧年人，旧年日是新年日。\n潮生涨旧痕，潮落石头出。\n万物有迁流，迁流无变易。\n有变易，上上大吉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18991,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其十七","author":"释普度","text":"一见便见，一得永得。\n四边界至，故是分明。\n一寸笔头，万钧之力。\n三十年异苗翻茂，千万古中流伟绩。\n阿呵呵，知不知，青毡元是吾家物，好看金牛作舞时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18992,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其十四","author":"释普度","text":"推不去，挽不来。\n南天台，北五台。\n大地寥寥兮何者当情，春风浩浩兮雨打莓苔。\n见成公案，不涉安排，岂在见桃花而后眼开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18993,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其八十五","author":"释普度","text":"一即三，三即一，达磨不曾离少室。\n父子虽亲妙不传，一花五叶成狼藉。\n海风吹起怒涛寒，截流过者脚不湿。\n道在中庸，梅香岩石。\n破沙盆子响玲珑，要在当人善抛掷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18994,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其四十六","author":"释普度","text":"开口即错，闭口即哑。\n钉嘴铁舌，一时列下。\n碧玉盘，无缝罅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18995,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其六十九","author":"释普度","text":"短棹轻帆，风恬浪静。\n溢目湖光镜样平，渔歌未起同谁听。\n万壑千岩，高低普应。\n狼藉断霞残照中，船头拨转都收尽。\n么朅提国，亲行此令。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18996,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其五十七","author":"释普度","text":"正法眼，破沙盆。\n零敲碎打，不直分文。\n一一银山铁壁，一一电掣雷奔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18997,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其八十三","author":"释普度","text":"有权有实，有照有用，些些鬼眼睛，临机要活弄。\n弄得活，没疏亲。\n谁知席帽下，都是旧时人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18998,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其九十八","author":"释普度","text":"结夏已十日，那事无消息。\n云在岭头闲，水流何太急。\n法法不隐藏，古今无朕迹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18999,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其七十五","author":"释普度","text":"大机圆应，大用无方。\n扑碎破沙盆，灭却正法眼。\n要津把定，佛祖潜踪。\n正案傍提，百发百中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19000,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其八十四","author":"释普度","text":"声前一句，斗换星移。\n石火莫及，电光罔追。\n栗棘蓬当面掷，全刚剑信手挥。\n少林消息断，花绽不萌枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19001,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其五十","author":"释普度","text":"面皮上刮得霜，枯骨里敲出髓。\n转得身，吐得气。\n不是不是。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19002,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其六十八","author":"释普度","text":"一期九十日，铁壁复铁壁。\n四方八面来，只是跳不出。\n落霞与孤鹜齐飞，秋水共长天一色。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19003,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其十三","author":"释普度","text":"大海扬尘，高源出水。\n狭路相逢，知心有几。\n明明玉鉴光中，浩浩烟波万里。\n鸑鷟擎头，金鳞摆尾。\n江北江南绝望时，一声霹雳清飙起。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19004,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其七十八","author":"释普度","text":"落叶飘飘，秋江清浅。\n烈士相逢，干戈不展。\n言多去，道转远。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19005,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]