[{"title":"赠安邑簿伍彬归隐","author":"路振","text":"考终秋鬓白，归隐旧峰前。\n庭树鸟频啄，山房人尚眠。\n寒岩落桂子，野水过茶烟。\n已结劳生念，虔心向竺乾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27169,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"路振","text":"瘴海千枝雾，骊山一骑尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27170,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"盱眙旅舍","author":"路德章","text":"道旁草屋两三家，见客擂麻旋点茶。\n渐近中原语音好，不知淮水是天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27171,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渔父","author":"游次公","text":"竹里茅茨傍小溪，粼粼白石护渔矶。\n想应日日来垂钓，石上蓑衣不带归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27172,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"归建溪","author":"鄢玉庭","text":"归去寒溪觅旧盟，相逢诗酒足娱情。\n閒云不碍青山好，物外风高梦自清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27173,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东岩寺","author":"雍大椿","text":"精庐隐东山，气象严竹柏。\n入门佛画好，晓日明金碧。\n向来岩名寺，初不觇遗迹。\n隐庵中梁秀，邂逅论夙昔。\n行前亟指似，云磴飞双舄。\n始知翠微中，洞穴刊青壁。\n莓苔暗龙象，缺甃贮灵液。\n开山记乾元，断碣馀□□。\n经营想耆旧，兴废今几易。\n平生泉石心，逮此欣有□。\n惜哉荆棘地，尚阻游人屐。\n畴能发其秘，澄观今藉□。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27174,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"富乐山 其二","author":"雍有容","text":"大汉曾封隆准翁，闻道山河锦绣中。\n安能郁郁久居此，睥睨三秦日欲东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27175,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"富乐山 其一","author":"雍有容","text":"当时四海一刘备，至此已堪悲失脚。\n出语翻为乐国想，是人止可偏方著。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27176,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"雍明远","text":"洞庭湖里固深根。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27177,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"雍明远","text":"洞庭湖裹固深根。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27178,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"仙马洞","author":"雍沿","text":"龙驹昔日此升仙，洞掩碑残不计年。\n胜迹依然无处问，一僧重锁薜萝烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27179,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"尔朱真人药灶","author":"雍沿","text":"当日先生药已成，便将金井等闲轻。\n迨今遗迹峰峦上，时有青烟灶下生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27180,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"太蓬景福寺","author":"雍沿","text":"楼阁参差耸茂林，危梯■径几重深。\n周行岩麓四十里，下视井尘千万寻。\n僧住不生云水兴，客游偷息利名心。\n若教工部曾经此，应遍灵踪处处吟。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27181,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"简州","author":"雍鸣","text":"学山云顶遍寻游，烟棹夷犹出简州。\n夜雨借公三日水，秋风送我一兰舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27182,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"好事近","author":"雷应春","text":"梅片作团飞，雨外柳丝金湿。\n客子短篷无据，倚长风挂席。\n回头流水小桥东，烟扫画楼出。\n楼上有人凝伫，似旧家曾识。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27183,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"沁园春 官满作","author":"雷应春","text":"问讯故园，今如之何，还胜昔无。\n想旧耘兰蕙，依然葱茜，新栽杨柳，亦已扶疏。\n韭本千畦，芋根一亩，雨老烟荒谁为锄。\n难忘者，是竹吾爱甚，梅汝知乎。\n茅亭低压平湖。\n有狎鹭驯鸥尚可呼。\n把绛纱准拟，新官到也，寒毡收拾，贱子归欤。\n略整柴门，更芟草径，惟有幽人解枉车。\n丁宁著，与做添棋局，砌换茶垆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27184,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"雷侍郎","text":"无魔不成佛，观过始知仁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27185,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"雷周辅","text":"路险客须到，山高人尽耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27186,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠顾梅山","author":"雷苦斋","text":"携手河梁送子卿，池塘春草梦中生。\n武林今有梅山老，五字才高笔代耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27187,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王官瀑布","author":"雷临","text":"区区奔走漫华颠，一别王官十四年。\n绿玉峡中喷白玉，溉田浇竹满平川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27188,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"雷庵正受","text":"千山同一月，万户尽皆春。\n千江有水千江月，万里无云万里天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27189,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄甘露舒公上人","author":"雷简夫","text":"成都多少寺，梵学竞推能。\n到老不破戒，满城唯此僧。\n池龙听夜讲，海客施年灯。\n别后空相忆，尘劳正可憎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27190,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"村晚","author":"雷震","text":"草满寒塘水满陂，山衔落日浸寒漪。\n牧童归去横牛背，短笛无腔信口吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27191,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"内使黄公","author":"《靖康小雅》作者","text":"在昔汉唐，亡由阉宦。\n出或用之，鲜不贻患。\n岂期黄公，独禀高见。\n白发虔心，有闻必谏。\n竭力东城，以身死难。\n揭名不磨，万世炳焕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27192,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"太学生徐公","author":"《靖康小雅》作者","text":"欃枪腾光，遂勃太阳。\n六龙不翔，昧昧八荒。\n公欲挟飞，再丽咸桑。\n怒发烈烈，力镌暴羌。\n白刃亘野，视犹猬芒。\n凛凛之气，虽死不亡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27193,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"太尉镇洮军节度使同知枢密院事种公","author":"《靖康小雅》作者","text":"壮哉此翁，谋深气劲。\n终始一节，佑我三圣。\n百战之馀，所料必胜。\n提师入援，敌詟威令。\n叠尽良策，众莫之听。\n割地增币，强邻益横。\n万里长城，恃为藩屏。\n倏嗟不禄，乱何有定。\n旌旗无光，兵民凄哽。\n馀烈昭昭，方求独盛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27194,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"吏部员外郎傅公","author":"《靖康小雅》作者","text":"强敌寒盟，兵忽踰塞。\n公持汉节，迓客于界。\n控弦欻来，率土震骇。\n外臣桀傲，自矜强大。\n公誓不慑，有死无拜。\n杀身成仁，播美千载。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27195,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"吏部侍郎李公","author":"《靖康小雅》作者","text":"烈烈李公，实备全德。\n义动幽明，气贯金石。\n扈跸敌营，爰究忠烈。\n杞人之忧，废立大厄。\n公挺不顾，二将面叱。\n勇甚雷霆，天地动色。\n命轻鸿毛，名高斗极。\n燎火之焚，不变蓝璧。\n滔天之溺，砥柱独立。\n死得其所，震耀方册。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27196,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"佥书枢密院事张公","author":"《靖康小雅》作者","text":"金人强悍，一岁再至。\n公提郡兵，疾驱入卫。\n敌将易姓，公秉大义。\n独敢抗言，必复赵氏。\n欲扶日驭，力扫氛翳。\n身拘名张，忠烈振世。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27197,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"兵部尚书孙公","author":"《靖康小雅》作者","text":"巍巍孙公，忠烈俱伟。\n受天大任，渊渟山峙。\n谋谟密宥，帝所眷倚。\n付以留钥，又托以子。\n天未悔祸，甘赴万死。\n国家德泽，周及远迩。\n罹兹祸变，孰奋而起。\n公节不渝，独负大美。\n若神人然，众所仰止。\n彼以偷生，徒奄如鬼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27198,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"果州团练使何公","author":"《靖康小雅》作者","text":"巍巍京师，帝王之泽。\n临制华夏，宪相紫极。\n边尘涨天，雨坠矢石。\n千雉摧毁，公死于敌。\n欃枪舒芒，万象变色。\n独垂忠烈，以光载籍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27199,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"河东马步军副总管王公","author":"《靖康小雅》作者","text":"矫矫虎臣，捍城于并。\n殚其智力，为国长城。\n攻踰两时，敌不能乘。\n无食无援，百雉乃倾。\n负像赴水，义不苟生。\n大节卓伟，千载光明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27200,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"河北都转运使王公","author":"《靖康小雅》作者","text":"建炎绍统，锐于中兴。\n乃得贤辅，食檗饮水。\n责君尧舜，良哉股肱。\n苟用其言，不难丕承。\n时相巨蠹，忌嫉才能。\n群邪翼之，如彼鹯鹰。\n公奋不顾，忠勇日增。\n瞻之维何，垂天之鹏。\n琐琐潜善，陋比蛙蝇。\n贤死奸寿，何戒何惩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27201,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"真定府路兵马都钤辖刘公","author":"《靖康小雅》作者","text":"将军死绥，古人所长。\n有如刘公，与城俱亡。\n兵挐常山，公以身当。\n生竭其勇，力挫戎行。\n天未悔祸，敌势益张。\n公虽瞑目，万古传芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27202,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"御史中丞秦公","author":"《靖康小雅》作者","text":"天崩地陷，革我洪图。\n孰敢争之，维时醇儒。\n祈复明辟，义在捐躯。\n猛虎垂涎，遂捋其须。\n骊龙不睡，乃探其珠。\n身赴沙漠，名振九区。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27203,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"提举京城四壁守禦刘公","author":"《靖康小雅》作者","text":"有赫刘公，心在王室。\n气吞强敌，忠贯日月。\n九鼎既沦，四溟荡潏。\n公如山岳，万仞屹屹。\n富贵莫诱，威武莫屈。\n仗节而死，无愧委质。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27204,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"靖康臣僚","text":"伊尹定归商社稷，霍光终作汉臣邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27205,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送钤辖馆使王公","author":"靳宗","text":"再任坤维报政成，紫泥恩诏下神京。\n摇鞭有客添归兴，折柳何人不怆情。\n杜宇江山经鸟道，海棠池馆忆龟城。\n尊前执手难收泪，投分从来比弟兄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27206,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中隐堂二首 其二","author":"鲍同","text":"问舍知君困欲还，才高那得卧南山。\n由来甘井人争汲，却恐心闲身未闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27207,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中隐堂二首 其一","author":"鲍同","text":"当年早有菟裘意，岁晚尘埃尚困予。\n闻说龙江真可隐，欲将馀日寄仙居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27208,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"孤雁","author":"鲍当","text":"天寒稻粱少，万里孤难进。\n不惜充君庖，为带边城信。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27209,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"松江夜泊","author":"鲍当","text":"舟闲人已息，林际月微明。\n一片清江水，中涵万古情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27210,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄西湖择栖公","author":"鲍当","text":"两信海潮喧晓夕，百年事过无遗迹。\n旧住招提有几人，春风苔长湖边石。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27211,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬阮逸诗卷","author":"鲍当","text":"木有毫端水有源，渐成盘错始潺湲。\n右丞画笔多平浅，平浅应知近自然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27212,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题和靖隐居","author":"鲍当","text":"湖水春来绿，山云忧亦繁。\n如何隐君子，长啸掩柴门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27213,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送人南归","author":"鲍当","text":"凄凄杨柳暮，时复一蝉声。\n沧海不可极，风帆难计程。\n微烟生晚浦，斜日上孤城。\n欲寄相思札，谁传万里情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27214,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送天台进长老","author":"鲍当","text":"尝闻台岭秀，积翠倚南天。\n鹿下深溪饮，僧从绝岭禅。\n浮尘满浮世，流水逐流泉。\n人别归心切，瓶盂上客船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27215,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送白上人归天台","author":"鲍当","text":"梵译千篇广，归心一念生。\n浮杯识海岸，持钵去王城。\n雨彴春莓滑，香盆漏叶轻。\n遥知守庵虎，先辨锡环声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27216,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿栖霞观","author":"鲍当","text":"一宵会清境，不悟世间忧。\n天共白云晓，水和明月流。\n碧烟生藻井，红日映花楼。\n顾我无道气，拂衣难少留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27217,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寓怀会稽吴道子遇因师","author":"鲍当","text":"隐沦与释子，时予久往还。\n览照不自认，况复思君颜。\n昨日山书至，乃梦云萝间。\n何必风韵息，始觉万境闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27218,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"鲍当","text":"更无声接续，空有影相随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27219,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"维扬怀古","author":"鲍寿孙","text":"江北江南水一涯，迷楼结绮两堪悲。\n雷塘草绿人安在，曾见黄奴坐井时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27220,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蒋山八功德水","author":"鲍寿孙","text":"功德河沙七宝池，可如甘露降三危。\n钟山一滴曹溪水，好及萧郎索蜜时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27221,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"平山","author":"鲍寿孙","text":"平冈横亘北城头，一上青冥目数州。\n吴岫南从京口出，蜀江东赴海门流。\n香销后土花如梦，烟锁雷塘草亦愁。\n惟有依然淮泗水，年年吹浪到瓜洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27222,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"伍子胥庙","author":"鲍寿孙","text":"百世子胥庙，犹存寂寞中。\n鞭尸生快怨，抉眼死遗忠。\n故国古今梦，怒涛朝夕风。\n登临一长啸，斜日海门红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27223,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"松声","author":"鲍寿孙","text":"千丈森森磥砢生，风来岩壑韵琮琤。\n耳根一洗俗尘净，木末时闻天籁鸣。\n汹汹银涛朝拍岸，萧萧铁马夜还营。\n山中宰相殷勤听，说与傍人笑绝缨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27224,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"鲍寿孙","text":"我无孤雁句，君有倚楼诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27225,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其四","author":"鲍寿孙","text":"但喜亲庭健，何愁客路长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27226,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其三","author":"鲍寿孙","text":"千篇异代垂金薤，一曲当年忤玉环。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27227,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"鲍寿孙","text":"一樽浮大白，千里策飞黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27228,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其六","author":"鲍寿孙","text":"重生子厚为师范，更与宣尼续庙碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27229,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秀峰院","author":"鲍承议","text":"平田千顷绿秧稠，水绕山阿出涧流。\n门掩落花春自晚，画檐时听鸟声幽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27230,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"藤溪怀古","author":"鲍若虚","text":"小桥流水去茫茫，隔岸何人在一方。\n传道荆公曾晓渡，天风吹落五更霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27231,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和贾平章咸淳庚午冬大雪遗安抚潜侍郎诗","author":"鲍度","text":"一陶催发万园林，平施工夫天地心。\n计出陈奇歼巨寇，盟推滕六长诸任。\n三登气象先呈腊，一统封疆后视今。\n多谢玉龙擎重力，太平蓑笠好溪阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27232,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"乞休","author":"鲍彪","text":"一纶长伴月娟娟，满岸芦花入短舷。\n薜荔未堪华衮用，此身甘作老林泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27233,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登前守李公亭","author":"鲍粹","text":"李公亭即鲍公亭，何事因仍旧日名。\n官守二年如过客，风流千古是虚名。\n扪萝缭绕寻新径，隔水微茫认故城。\n陵谷变迁君莫问，此中气象转分明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27234,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重到钱唐 其四","author":"鲍輗","text":"闻道深春雪打围，谁怜身上藕丝衣。\n莫忧白璧成尘土，解逐南风万里归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27235,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重到钱唐 其二","author":"鲍輗","text":"无赖山光叠叠青，玉鱼金盌早飘零。\n冷思禹穴真奇事，千古衣冠托杳冥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27236,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重到钱唐 其五","author":"鲍輗","text":"惟有寒潮不世情，朝朝莫莫过空城。\n百年车马阊门外，独被春风草又生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27237,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重到钱唐 其一","author":"鲍輗","text":"生死双飞正可怜，若为白发上征船。\n未应分手江南去，更有春光七十年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27238,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重到钱唐 其三","author":"鲍輗","text":"万家歌舞送浮生，曾有涓埃答太平。\n猿鹤虫沙天始定，不须辛苦怨南征。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27239,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"天马","author":"鲍輗","text":"天马抱奇相，紧骨瞳方明。\n出入百万中，有如一鸟轻。\n宇宙莽超踏，风云惨经营。\n独倚雄杰态，萧萧随北征。\n朝饮南海头，夕秣乃幽并。\n失主坐黯淡，别群奋长鸣。\n岂无轻侠儿，金羁悬朱缨。\n但感束帛义，不忍负死生。\n低头为君老，喑喑万里情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27240,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]