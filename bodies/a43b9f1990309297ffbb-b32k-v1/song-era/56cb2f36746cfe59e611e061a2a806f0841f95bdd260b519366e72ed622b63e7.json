[{"title":"偈颂九首 其六","author":"释如净","text":"西湖湖里水，南山山上云。\n天台拄杖子，相见笑忻忻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11308,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九首 其二","author":"释如净","text":"打破黑漆桶，十方空索索。\n不受灵山记，安居大圆觉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11309,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九首 其一","author":"释如净","text":"衲衣下事火烧山，腊月家贫彻骨寒。\n堪笑连延曾未息，眉毛焦赤面皮斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11310,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十五首 其十二","author":"释如净","text":"灵云见处桃花开，天童见处桃花落。\n桃花开，春风催。\n桃花落，春风恶。\n春风恶，桃花跃浪生头角。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11311,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十五首 其二十五","author":"释如净","text":"进院得住便住，退院要行便行。\n个条乌拄杖，莫怪太生狞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11312,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十五首 其二十四","author":"释如净","text":"瞿昙腊月八，夜半走出山。\n贼路羊肠曲，偷心虎背斑。\n钝置人天者一番。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11313,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十五首 其二十三","author":"释如净","text":"霜风号肃杀，霜叶堕萧颾。\n唯有玲珑岩，崔嵬望转高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11314,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十五首 其二十二","author":"释如净","text":"古今大雪满长安，天童卖却这心肝。\n无神通菩萨猛劈一椎，千手眼大悲捏怪多端。\n狮子教儿迷子诀，老婆心切不相瞒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11315,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十五首 其二十一","author":"释如净","text":"天童仲冬第一句，槎槎牙牙老梅树。\n忽开花，一花两花三四五花无数花。\n清不可誇，香不可誇。\n散作春容吹草木，衲僧个个顶门秃。\n蓦劄变怪，狂风暴雨交衮，大地雪漫漫。\n老梅树太无端，寒冻摩挲鼻孔酸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11316,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十五首 其二十","author":"释如净","text":"八月十八钱塘潮，浙翁声价泼天高。\n尽教四海弄潮手，彻底穷渊辊一遭。\n重拣择，不辞劳，要透龙门继凤毛。\n忽然收卷还源去，万古曹溪风怒号。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11317,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十五首 其十九","author":"释如净","text":"眼见黄叶落，耳闻孤雁鸣。\n咦，溪上秋光分外清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11318,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十五首 其十八","author":"释如净","text":"去那边去，来者里来，中间绝壑断崖。\n依稀金磴阔，彷佛彩虹弯，人从桥上过。\n松萝影里开天巧，汗黑光中入画看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11319,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十五首 其十七","author":"释如净","text":"金刚王宝剑在匣，有望风不犯之威。\n天童喝下飞出，变作无孔铁锤。\n辊入荒田乱草，任教日炙风吹。\n拈匙把箸知多少，不是知音不易知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11320,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十五首 其十六","author":"释如净","text":"窦八布衫穿，大家出只手。\n横须弥为槩，量大海为斗。\n生杀在前，收放在后，归功塞破虚空口。\n天童不敢相辜，甘作啼鸡吠狗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11321,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十五首 其十五","author":"释如净","text":"推倒多年老鼠窠，扫空平地笑呵呵。\n从空架起生头角，盖覆驴牛不厌多。\n今朝成就大缘，千古发挥大事。\n斫额任他门外客，到家还我个中人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11322,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十五首 其十四","author":"释如净","text":"铁酸豏，金刚圈。\n塞断咽喉，拽脱鼻孔。\n天童立地有分，衲僧乞命无门，堪与瞿昙作子孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11323,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十五首 其十三","author":"释如净","text":"结却衲僧布袋头，天童拈来作气毬。\n脚尖趯出佛无数，付与丛林作马牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11324,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十五首 其十一","author":"释如净","text":"天童铁臭老拳头，打杀江湖水牯牛。\n夜深忽然生个卵，天明推出大日头。\n晒㫰诸人烝湿处，免教行步滑如油。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11325,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十五首 其十","author":"释如净","text":"开无间地狱，现阎罗大王。\n聚夜叉一部，列牛头两行。\n与其进者剑树上猛火进用，与其退者刀山里寒冰退藏。\n叵耐饭饱弄箸，判断屎急尿床。\n花柳春风入戏场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11326,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十五首 其九","author":"释如净","text":"只个柴头煨火种，诸方聿起竞开炉。\n天童直截超宗处，炉与柴头尽底无。\n恁么却有煖气，正好猛做工夫。\n蓦忽雷霆轰烈焰，从教深夜雪模糊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11327,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十五首 其八","author":"释如净","text":"心念分飞，如何措手。\n赵州狗子佛性无，只个无字铁扫帚。\n扫处纷飞多，纷飞多处扫。\n转扫转多，扫不得处拚命扫。\n昼夜竖起脊梁，勇猛切莫放倒。\n忽然扫破太虚空，万别千差尽豁通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11328,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十五首 其七","author":"释如净","text":"冤有头，债有主。\n一剑当锋，豁开门户。\n拽队成群恁么来，放火杀人相合聚。\n老胡顶?跨龙虎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11329,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十五首 其六","author":"释如净","text":"外不放入，内不放出。\n痛下一槌，万事了毕。\n太白峰前令斩新，内外纪纲俱委悉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11330,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十五首 其三","author":"释如净","text":"横一丈，竖一丈。\n文殊维摩，隔壁抓痒。\n尽大地人，不钓自上。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11331,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十五首 其二","author":"释如净","text":"黄金妙相，驴腮马觜。\n咦，贼是小人，智过君子。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11332,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十五首 其一","author":"释如净","text":"天童大解脱门豁开。\n衲僧自已透，乾坤无表里。\n万古清风八面来，前楼后阁玲珑起。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11333,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十二首 其十一","author":"释如净","text":"半年吃饭坐鞔峰，锁断烟云千万重。\n忽地一声轰霹雳，帝乡春色杏花红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11334,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十二首 其九","author":"释如净","text":"夜半乌鸡抱鹄卵，天明生出个老鹳。\n毛长觜短鹭鹚形，飞起一天星斗乱。\n一拳拳倒黄鹤楼，一踢踢翻鹦鹉洲。\n咄，篱边燕雀空啾啾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11335,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十二首 其八","author":"释如净","text":"今朝九月初一，打板普请坐禅。\n第一切忌瞎睡，直下猛烈为先。\n忽然爆破漆桶，豁如云散秋天。\n劈脊棒，迸胸拳，昼夜方才不可眠。\n虚空消殒更消殒，透过威音未朕前。\n咦，栗棘金圈恣交衮，凯歌高贺彻风颠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11336,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十二首 其七","author":"释如净","text":"斩鲸龙头角，截虎豹爪牙。\n烂泥团受用不尽，踏著刺方见作家。\n谁在画楼沽酒处，相邀来吃赵州茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11337,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十二首 其六","author":"释如净","text":"晷运推移，日南长至。\n眼睛里放光，鼻孔里出气。\n饱饭快活屙一堆，超过瞿昙亲授记。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11338,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十二首 其五","author":"释如净","text":"韩信造浮桥，李广入布袋。\n一箭透双关，乾坤无挂碍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11339,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十二首 其四","author":"释如净","text":"打破黑漆桶，十方空豁豁。\n爆雷一喝变通，掣电千机顿发。\n便可以东行撑架门庭，西班怒骂佛祖。\n收放绝来由，纵横透今古。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11340,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十二首 其三","author":"释如净","text":"平沈大地，高出虚空。\n机先坐断，游戏神通。\n须弥灯王立下风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11341,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十四首 其三十五","author":"释如净","text":"秋风凉，岩桂香。\n未归客，思故乡。\n吾无隐乎尔，捉贼须捉赃，舞蝶游蜂过短墙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11342,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十八首 其十六","author":"释如净","text":"上大人，丘乙己，西湖南山图画里。\n孔门弟子无人识，空有三千七十士。\n忽然一阵秋风吹，吹作秋云送流水。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11343,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十八首 其八","author":"释如净","text":"杨柳妆腰带，梅花络臂韝。\n黄莺偷眼觑，舞得最风流。\n净慈门下萝卜头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11344,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十八首 其十四","author":"释如净","text":"惆怅杜鹃鸟，哀哀昼夜啼。\n落花飞絮怨流水，芳草懊恨迷东西。\n呜呼，春光浩荡可吊而不可送，醉倒愁人烂似泥。\n若匪丹山凤，徒劳语楚鸡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11345,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十八首 其十七","author":"释如净","text":"衲僧拄杖子，漫漫黑似烟。\n西湖九个月，可恶亦堪怜。\n忽然飞过鄞江去，搅动沧溟浪拍天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11346,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十八首 其四","author":"释如净","text":"当天一句，万机显露。\n衲僧顶戴奉行，鼻孔机先證据。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11347,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十八首 其九","author":"释如净","text":"者个是百尺竿头，进一步则有象，退一步则无踪。\n进退全机变，从衡振祖风。\n都在南山掌握中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11348,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十八首 其二","author":"释如净","text":"大开此殿，亲面一见。\n眼里抽钉，脑后拔箭，本来无象通机变。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11349,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十八首 其十五","author":"释如净","text":"六月连三伏，人间似焰炉。\n依稀寒水玉，彷佛冷秋菰。\n脩竹芭蕉入画图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11350,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十八首 其七","author":"释如净","text":"打杀然灯佛，堕落黑暗狱。\n永劫无出期，衲僧歌一曲。\n满天星斗辉华屋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11351,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十八首 其一","author":"释如净","text":"净慈屋里门，净慈屋里开。\n昔日净慈曾此去，净慈从此又还来。\n咦，净慈关棙衮风雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11352,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十八首 其六","author":"释如净","text":"漫天大水云翻墨，捲地狂风浪衮山。\n掣断丝纶归喝彩，鲸鳌只在此山间。\n操舟又入洪波里，愁杀渔翁两鬓斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11353,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十六首 其十四","author":"释如净","text":"如何是四棱蹈地，入三摩存分别智。\n若是有事而不通，知未知伊彼元气。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11354,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十六首 其十三","author":"释如净","text":"净妙妙时解活计，露堂堂处有家风。\n须知脱体卓然道，廓落圆通是个宗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11355,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十六首 其七","author":"释如净","text":"一花开五家宗要，一叶缀九室诀机。\n朝朝暮暮只斯是，何用琼林觅玉枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11356,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十六首 其五","author":"释如净","text":"善行者不移双足，善入者不动双扉。\n清秋夜冷波心月，谁问安禅友亦稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11357,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十六首 其三","author":"释如净","text":"是不是是江光铺练，非不是非花岳叠锦。\n举竟合成什么边事，三界无法何处求心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11358,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十六首 其二","author":"释如净","text":"山披锦云而烂成春意，水含碧月而淡存秋容。\n恁么也恁么，说似曾不中。\n黄头并碧眼，消息子难通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11359,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十首 其九","author":"释如净","text":"今朝日南长至，黑豆生芽。\n大众恭惟欢庆，铁树开花。\n如何结果，龙驰虎骤，撒土抛沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11360,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十首 其八","author":"释如净","text":"秋风清，秋月明，大地山河露眼睛。\n瑞岩点瞎重相见，棒喝交驰验衲僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11361,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十首 其六","author":"释如净","text":"一言相契即住，笑面花开玉树。\n诸方恁么点头，瑞岩刬地恶辣。\n咦，拳头无私绝后看，瞿昙顶上活鱍鱍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11362,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十首 其五","author":"释如净","text":"深山岩崖问，石头大小答。\n崖崩石迸裂，虚空闹聒聒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11363,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十首 其四","author":"释如净","text":"西来祖意庭前柏，鼻孔寥寥对眼睛。\n落地枯枝才?跳，松萝亮鬲笑掀腾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11364,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十首 其三","author":"释如净","text":"舞衫歌扇，花鼓拍板。\n总是者个戏棚，卖弄许多伎俩。\n咦，任他千圣出头来，立在下风高著眼。\n建法幢，立宗旨，明明佛敕曹溪是。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11365,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十首 其二","author":"释如净","text":"黄金妙相，著衣吃饭。\n因我礼你，早眠晏起。\n咦，谈玄说妙太无端，切忌拈花自热瞒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11366,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十首 其一","author":"释如净","text":"回避无门，此门大开。\n家私都脱尽，平白起风雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11367,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十八首 其三十八","author":"释如净","text":"铁酸豏，金刚剑，吞了斩了，以活为验。\n作家恁么共提持，超过佛祖增光焰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11368,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十八首 其三十七","author":"释如净","text":"一番雨，一番风，风雨湖山图画中。\n风摇水色琉璃滑，雨泼山光翡翠浓。\n咄，杜鹃啼血滴花红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11369,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十八首 其三十六","author":"释如净","text":"春雨洗春雪，雪消湖上山。\n雨晴相对看，突兀髑髅寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11370,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十八首 其三十五","author":"释如净","text":"元正启祚，鼻孔发露。\n万物咸新，笑面迎春。\n净慈门下转风流，饭满钵盂茶满瓯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11371,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十八首 其三十四","author":"释如净","text":"竿木随身，逢场作戏。\n释迦老子毒花开，达磨大师王小二。\n吹笛打鼓，搀行夺市，万像森罗笑点头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11372,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十八首 其三十三","author":"释如净","text":"掩室摩竭国，老胡豁开顶门。\n杜口毗耶城，净名败缺话柄。\n提上古两端公案，发今朝一段威光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11373,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十八首 其三十二","author":"释如净","text":"人从平江来，却得福州信。\n寒食拜新年，虚空突出柄。\n咦，打破虚空笑不休，大家彻底验聱头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11374,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十八首 其三十一","author":"释如净","text":"钟楼上念赞，床脚下种菜。\n不会不自在，会得是障碍。\n白狗吃生姜，胡人夜渡关。\n若不得流水，还应过别山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11375,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十八首 其三十","author":"释如净","text":"烟濛濛，雨濛濛，芍药花开湿嫩红。\n我今灌沐诸如来，人间天上起清风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11376,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十八首 其二十九","author":"释如净","text":"杀人刀，活人剑，转磨转精，累试累验。\n乃上古之风规，亦今时之枢要。\n净慈门下实相当，倚天照雪寒光耀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11377,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十八首 其二十八","author":"释如净","text":"坐断老卢顶?，拈起无柄木杓。\n忽然舀出铜汁铁丸，忽然舀出醍醐酥酪。\n佛祖大机难测度，犹是家常茶饭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11378,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十八首 其二十七","author":"释如净","text":"连雨初晴九月一，日头依旧东边出。\n照见五蕴皆空，衲僧参学事毕。\n一尺水，一丈波，谢郎船上唱山歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11379,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十八首 其二十六","author":"释如净","text":"十五日已前，湖光潋滟晴方好。\n十五日已后，山色空濛雨益奇。\n正当十五日，若把西湖比西子，淡妆浓抹总相宜。\n中秋月似鸾台镜，赢得多才一首诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11380,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]