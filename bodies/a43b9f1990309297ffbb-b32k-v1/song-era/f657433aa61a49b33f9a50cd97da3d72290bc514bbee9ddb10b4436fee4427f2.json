[{"title":"岩溪书堂登眺","author":"赵汝腾","text":"崎岖穿竹篮舆侧，高下扪萝石径幽。\n虎豹遁时深谷窈，鱼龙舞处大江浮。\n公难閒坐山中相，我久吟披泽畔裘。\n白石清泉知此意，请将直钓钓璜流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45053,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"径坂左司使君惠和近诗为亲而喜合天理之公得性情之正复用韵以庆 其一","author":"赵汝腾","text":"扶杖来观遍老农，清朝新礼采芝翁。\n德尊韦布封员外，恩重牙绯视治中。\n言悟千秋逢主圣，躬行万石耀臣工。\n求与抑与从天下，径坂丹忱殿陛通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45054,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"径坂左司使君惠和近诗为亲而喜合天理之公得性情之正复用韵以庆 其二","author":"赵汝腾","text":"何曾学圃学为农，陋巷萧然白发翁。\n便拜冯唐长郎署，更荣弘景相山中。\n诏褒忠孝垂青史，上想仪型遣画工。\n庄叟湛然元不动，平生风雨视穷通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45055,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"饯卢威仲","author":"赵汝腾","text":"狐腋羊皮孰劣优，每嗟里社尚沉浮。\n千篇南雪题几遍，一马东风去不留。\n吴地名高诵梅福，汉廷语吉趣朱游。\n柯山若问衰陈迹，为说犹怀畎亩忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45056,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"饯史计使 其一","author":"赵汝腾","text":"祥刑生意遍庭荄，蔽芾棠阴手自栽。\n世降此翁犹尚德，俗衰时辈但论材。\n九仙截?于公去，万石熏炉召父来。\n揽辔紫阳垂教地，饶何盍聘到崇台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45057,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"饯史计使 其二","author":"赵汝腾","text":"使者星明太史占，东风戒路揭帷襜。\n食当加倍稀亲酒，献不求馀少榷盐。\n因进御茶供味谏，肯然官烛示家廉。\n老生莫效临岐赠，诗附仁言当束缣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45058,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"饯用晦侄南安令 其二","author":"赵汝腾","text":"作邑无他法，精神在拊摩。\n吏肥民必瘦，酒少饭宜多。\n宁拙催科考，须知于蔿歌。\n莫将还债看，好事易蹉跎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45059,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"饯用晦侄南安令 其一","author":"赵汝腾","text":"尔宦神皋日，搢绅无间言。\n勇怀南邑绶，为便北堂萱。\n侍讲鸾栖旧，端明棠荫存。\n时能挹前辈，为政有根源。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45060,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"驿至得径坂讲席帛诗喜甚和韵且坚秋风武夷之约 其一","author":"赵汝腾","text":"驿足归来以口陈，烂柯山色碧嶙峋。\n横经二月二十一，听讲三千三百人。\n圣者子孙皆在列，愚而夫妇也知津。\n衰翁首看法筵义，文与正蒙相比伦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45061,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"驿至得径坂讲席帛诗喜甚和韵且坚秋风武夷之约 其二","author":"赵汝腾","text":"紫霞老子望青霞，喜诵新吟倚鬓华。\n已遣鸣驺迎道左，那知纫佩尚天涯。\n为庄椿寿称觞近，访武夷仙卜日赊。\n秋夜月明游九曲，棹歌声里赋岩花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45062,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"勉癸丑新进士","author":"赵汝腾","text":"霞州守吏庆筵开，喜为朝家得俊材。\n九曲山川增气槩，八元人物照樽罍。\n谶佳将报淮沙合，文焕新迎御扁来。\n不朽荣华轩冕外，君看云谷胜云台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45063,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奏径坂尊公致政盛德于上就以诗报之","author":"赵汝腾","text":"拜疏归田学老农，天高未肯听衰翁。\n逸民且举邵康节，有子并称程大中。\n给札说书皆御墨，教忠锡爵励群工。\n老臣只代臣颐请，颐不祈恩何自通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45064,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送伯和侄归里之戍","author":"赵汝腾","text":"留尔纫秋桂，归欤迫戍瓜。\n定将儒术饰，肯以惠文誇。\n狱敬裨王国，帷褰佐使家。\n公馀更努力，学似海无涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45065,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送游几叟衡山尉","author":"赵汝腾","text":"西风催仕轫，比部得英曹。\n泽物官无小，观山岳最高。\n须知戴星出，慎勿厌尘劳。\n綵棒有馀暇，何妨诵楚骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45066,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽朱夫人","author":"赵汝腾","text":"兰陔送母度新阡，追忆东岩老谪仙。\n齑办咄嗟供妇职，肝刲一再续亲年。\n六珈偕老荣何盛，二子乘舟晚可怜。\n彤管责堪陈信史，今将列女传同编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45067,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽竹湖李端明 其一","author":"赵汝腾","text":"千古筠溪节，名孙尚有诸。\n敢言禁闼黯，勇退汉廷疏。\n扫轨门如水，悬鱼饭只蔬。\n讣传缨绂骇，惜绾不中书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45068,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽竹湖李端明 其二","author":"赵汝腾","text":"淡似香山老，臞于涑水翁。\n政须将及子，心孰不为公。\n后进师清俭，前旒誉直空。\n墓陵手所筑，过者式高风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45069,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽岩云赵使君","author":"赵汝腾","text":"忆与东岩居里社，萝云松月共诗盟。\n伤心遂哭公三世，堕泪难招尔九京。\n领郡抗章生掇祸，过庭吟稿死留名。\n似闻难弟尤儒雅，好率诸郎副旦评。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45070,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽郑知府","author":"赵汝腾","text":"先正当年遇阜陵，在廷玉立指忠清。\n甘棠笏得孙枝绍，使竹符分棣萼荣。\n七帙骎骎登上寿，诸郎鼎鼎擅英名。\n北邙千古知无恨，吟些聊供薤露声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45071,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽盛君时","author":"赵汝腾","text":"忽报斯人讣，伤哉命压头。\n皇皇如有索，落落竟何求。\n学道鱼千里，辞家貉一丘。\n幸哉犹有子，可解二亲忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45072,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"涌泉亭","author":"赵汝腾","text":"涌泉亭畔坐蒙茸，手指三江抚万松。\n石鼓生云深有意，珠骊吐水密无踪。\n禽声人语同时乐，林影日华相映重。\n邂逅一樽开笑口，菊萸犹笑不从容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45073,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陪饶计使至北苑焙","author":"赵汝腾","text":"东风未绿无边草，北苑先抽绝品芽。\n六辔行山清雾潦，一枪入焙带烟霞。\n凤呈奇羽名仙麓，龙护香泉供帝家。\n万碾玉尘飞动处，鬼犹劳矣况人耶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45074,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陪高计使柱史谢庾使刑郎登梅仙山丹青阁 其一","author":"赵汝腾","text":"侵云祠宇绝荒凉，目眴凭虚兴寄长。\n仙者远游非穆穆，天之视下亦苍苍。\n贵公业趁尘泥腐，小尉名争日月光。\n此地何缘子真到，孤忠处处慕留芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45075,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄六湖陈如晦","author":"赵汝腾","text":"琴剑前时为我来，志同道合味悠哉。\n每怜一水马头险，惜放斯人鹢首回。\n鲁语手笺应毕卷，汾亭指授想多材。\n不知肯践诗盟否，菊已凋零梅又开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45076,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄卢玉堂武子","author":"赵汝腾","text":"建上文忠音响绝，尔来复说蔡翁卢。\n君归南浦颜无怍，我老西河道不孤。\n空有寸心驰记室，绝无一字到中都。\n吟成遣寄嗟何阔，开卷应嗤此叟迂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45077,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄李颐老","author":"赵汝腾","text":"清苦推洪毅，人今合古求。\n道东吾所敬，学北子为优。\n夜气存无馁，晨餐缺不忧。\n时来同析理，相对一茶瓯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45078,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄程沧洲","author":"赵汝腾","text":"山间藜杖看初春，忽报沧洲除命新。\n今日昌黎司宪部，几年陆贽任词臣。\n扶持世道岂无策，宗主时贤今有人。\n老懒贵游书尽绝，一诗隃寄霅江滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45079,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄新衡阳徐使君左司山长","author":"赵汝腾","text":"醉墨淋漓天地间，谁知大德不踰闲。\n世无孔子今希孔，国有颜渊易铸颜。\n多士龙门一乔岳，斯文牛耳两名山。\n暮春九曲峰前水，一笑风雩气象还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45080,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登北苑焙呈高计使谢庾使 其一","author":"赵汝腾","text":"急雨收声霁景开，蓬仙岭客岛云来。\n千丛撷秀牙铺雪，万臼研膏杵震雷。\n池上落英留绿叶，眼中飞絮点苍苔。\n去年醉墨今重看，笑领诗翁潋滟杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45081,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登北苑焙呈高计使谢庾使 其二","author":"赵汝腾","text":"蜀浙当年贡亦劳，至今惟重建溪毛。\n地灵丹凤衔萱草，水圣苍虬幻雪涛。\n笑指茶星誇小范，愁伤民力叹袁高。\n皇华早晚归经幄，丁俑应难谏舌逃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45082,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登石鼓追思武夷馀干二老呈威仲","author":"赵汝腾","text":"云间把酒更持螯，九日登临意气豪。\n自有此山题墨富，独推二老擅名高。\n禅关曾访移泉脉，亭扁重书镇海涛。\n老我空游愧能赋，得君藻笔仆名骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45083,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答高计使韵","author":"赵汝腾","text":"使承帝命若予工，膴膴周原布惠风。\n正似公权怀笔谏，岂如后蔡谱茶功。\n春盈夏涸疑神水，荼苦饴甘属太空。\n芹献固知仍旧比，采蘩泂酌亦昭忠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45084,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答高耻堂计使招赏海棠","author":"赵汝腾","text":"皇华相约醉崇台，正月海棠弥望开。\n万象呈春杯潋滟，千花炫夜烛萦回。\n雨馀妃带华清沐，云幕仙从绛阙来。\n明岁公归对红药，吟成寄我馆蓬莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45085,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢史计使寄建茗","author":"赵汝腾","text":"皇华珍意办头纲，馀馥吾侪也得尝。\n黯戆终然言有味，仝衰那得字搜肠。\n耕云陇畔知无憾，贮月瓢中剩有香。\n独念郊民多菜色，旱饥粟价踊非常。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45086,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢饶计使遣饷头贡馀","author":"赵汝腾","text":"仙芽龙水办头纲，百草山中不敢香。\n表进得陪华使拜，贡馀遣饷守臣尝。\n拟思苦口陈忠谏，可但饴茶献上方。\n分我清风生两腋，惜无文字只枯肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45087,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢高茶使遣饷头纲贡馀","author":"赵汝腾","text":"东风吹折凤山芽，驿献花箱仗使家。\n遥想仙芳供御盌，应怜味谏落天涯。\n厥包锡贡何年始，其苦如饴信地嘉。\n斋祭无繇陪褥位，膏馀分丐咀菁华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45088,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"趣饶伯舆来期","author":"赵汝腾","text":"忽得高贤讯，篝灯读数回。\n苦辞白鹿讲，盍为紫阳来。\n水毁祠无恙，堂新教有开。\n须君速戾止，倡道淑英材。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45089,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赞径坂使君柯山仲春讲席之盛","author":"赵汝腾","text":"赢粮多士二千馀，争向柯山讲席隅。\n立天地心鸣道铎，开生灵眼识师儒。\n孔融鲁国奇男子，孟氏邹人大丈夫。\n我在紫霞洲上笑，惜无羽翼到三衢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45090,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠徐国谕","author":"赵汝腾","text":"英英直气验操存，夜校群书日灌园。\n懒不到城三十载，老犹落笔数千言。\n吴公何敢轻招贾，徐稚兹来特访蕃。\n衰拙迩来逢盛事，德星远远照朱轓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45091,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠萧高士","author":"赵汝腾","text":"槃涧老龙埋骨久，交游得尔最知心。\n诗摹海屿天风景，琴弄仙台玉笥音。\n畴昔羽衣曾过我，只今石鼎又联吟。\n丹成若欲归山去，恐被人间有物侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45092,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠隆中黄进士","author":"赵汝腾","text":"遍游天下好山川，归向隆中葺数椽。\n似慕孔明效龙卧，尚随陶侃指牛眠。\n诗书发冢笑何益，富贵乞墦嗟可怜。\n若语人时劝忠孝，福田不似种心田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45093,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠璘上人","author":"赵汝腾","text":"潜斋山雨过从久，每说二公不离口。\n山雨去佐玉楼仙，潜斋起领金坛守。\n一江一浙两知音，柏枝东指还西否。\n胡然拄杖转落南，膜拜丛中狮子吼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45094,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与张草庐予欲嗣奏聘君草庐寄声止予歌以答之","author":"赵汝腾","text":"姑蔑之墟，郡郭之隅。\n幽阒兮陋巷，卑渫兮绳枢。\n真人兮椟藏，道貌兮山臞。\n有时兮过市，徐行兮当车。\n天津游兮闻鹃而慨叹，鹿门登兮采药而踌躇。\n明月兮啸咏，白云兮卷舒。\n我评其人，陶邵之徒。\n畴昔岁兮司银台，力抗疏兮徵玉庐。\n朝奏墨兮欲下，暮出昼兮尼。\n诸君一笑兮草芥，余三惜兮璠玙。\n拟笺天兮嗣请，近因风兮止余。\n仰高致兮慕予，积卑忱兮愿摅。\n善不进兮不已，终当谅乎纯愚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45095,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"为饶计使题","author":"赵汝腾","text":"煌煌使者轩，新扁焕群目。\n周爰远有华，不可居无竹。\n天风泠然来，云气滃而簇。\n知君子猷趣，一笑等荣辱。\n每云安乐窝，似胜相州纛。\n凭栏对此君，竟日玩不足。\n余亦慕姱节，时时赋猗绿。\n閒思载醪去，悠悠想九曲。\n新诗带仙姿，霞餐谢粱肉。\n愿言植梅友，疏影横水澳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45096,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"示林桂高歌","author":"赵汝腾","text":"丈夫流芳在身后，眼前一食常不饱。\n何况吟工抉元化，万象日月遭搜搅。\n君不见饭颗山头饿少陵，柴桑径里饥渊明。\n无钱对菊坐终日，得钱沽酒醉交朋。\n又不见春岸飞杨花，圣俞得句贫转加。\n羊肠绕车声，黄九一生坐穷鸣。\n欧苏只得从旁叹，不尔何由负盛名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45097,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"示赵与槟","author":"赵汝腾","text":"今年至日有喜色，四方士友来请益。\n德场宗英质大学，上饶诸贤问太极。\n草庐一纸隃寄音，径坂七言大书帛。\n衰予甘遁西河上，点检身心有方册。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45098,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再用韵答","author":"赵汝腾","text":"不羡丛菊并二螯，羡君出语真俊豪。\n崛奇退之石鼓句，清逸永叔庐山高。\n壮怀倾倒涌泉寺，健笔嘘吸沧海涛。\n后期进步登大顶，上续风雅卑庄骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45099,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再用韵答高茶使","author":"赵汝腾","text":"凡卉千山未吐芽，天生灵草瑞天家。\n漕修贡事东西廨，使起英流南北涯。\n谏苦固应疏汲黯，品高终必相王嘉。\n老衰不办茶歌献，但诵周原远有华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45100,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再答 其三","author":"赵汝腾","text":"孤风独上子陵台，藻思天然顷刻开。\n银烛不妨花下照，铁心肯向赋中回。\n休怀濯锦江边梦，早应筑沙堤上来。\n急裹紫霞望公至，也教凡卉识仙莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45101,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寿史刑使","author":"赵汝腾","text":"岷峨储英贤，一例皆家食。\n公亦淹海角，麾节犹赫奕。\n七闽政多幸，福星照南极。\n轻裘镇铃閤，使斧光卫戟。\n门弧初度临，和气遍阡陌。\n宿雨洗瘴氛，朔云报寒色。\n前期为重九，后期为至日。\n中间产蜀珍，天意扶阳脉。\n愿言爱刚健，他日寿王国。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45102,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寿史刑使","author":"赵汝腾","text":"羡公博学今扬雄，未许蜀珍专瑞蜀。\n喜公奉使今鲜于，又见福星来照福。\n我初敬公因谠疏，万言批鳞折五鹿。\n我转敬公缘清操，高吟放鹤孤山麓。\n今兹仗斧更仁厚，庭草不锄生意足。\n忧时两鬓白发增，爱贤一念缁衣笃。\n衰予归卧西河上，都骑时来寻涧谷。\n清言竟日无尽藏，想见胸中几天禄。\n若人盍置论思地，垂弧定有锋车趣。\n去年五言称公寿，今年笑指湖山绿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45103,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寿致政徐光禄","author":"赵汝腾","text":"易跻廿四中书考，难聚三千听讲生。\n入侍亲庭为一笑，方瞳弘景转精神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45104,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陈谓老见过云今年六十有九将预为周身之防余曰君定未死不如觅钱沽酒耳用戏成拙句赠行","author":"赵汝腾","text":"荷锸自随刘伯伦，裸葬旧闻杨王孙。\n伟哉二子真旷达，身虽殒灭名独存。\n要知形骸本外物，中有妙用超六根。\n火风地水归四大，梦幻泡影何足论。\n君不见桓魋石椁秦铁户，歌钟未彻野火焚。\n不如得钱即沽酒，时时醉倒三家村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45105,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和史绣使瑞梅韵","author":"赵汝腾","text":"忆昔朝旌别未央，逋仙风味饱哜尝。\n绣衣来酹东涛月，清节更餐南雪香。\n姑射真仙陪直指，绿华再萼瑞高堂。\n蓬莱花使传春信，早晚芝书趣觐王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45106,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和徐径坂 其二","author":"赵汝腾","text":"予归假阖庐，守曰于我馆。\n风雨已遁逃，云山况奇观。\n径坂形声诗，蓬莱名遂远。\n求仁居之安，是宅靡有间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45107,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和徐径坂 其一","author":"赵汝腾","text":"我敬梅野翁，治郡如元结。\n一朝殉国死，黄壤恨谁雪。\n赤输陈蕃心，碧化苌弘血。\n铭笔得柯仙，群阴消蟋蟀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45108,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和徐径坂帛诗韵并约徐立大同赋","author":"赵汝腾","text":"谒想仙姿诗见之，坛高屈宋隶吾麾。\n在邦无怨仁何怨，与世多违道不违。\n一鲁丈夫独儒服，百曹相国漫戎衣。\n折冲人物山中隐，谁佐君王立德威。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45109,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和徐径坂韵二首 其二","author":"赵汝腾","text":"学者山斗吾径坂，杜门养志衣莱斑。\n孤峰度越青云上，一世失得浮埃间。\n凤鸣思诚频遗讯，龙卧草庐相对閒。\n三贤鼎立名师友，衢江万古身潺湲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45110,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和徐径坂韵二首 其一","author":"赵汝腾","text":"玉柯仙管频念我，大书束缣浓墨斑。\n寄情缥渺江海际，匠语惨澹云烟间。\n燃藜太乙中夜照，垂钓客星清昼閒。\n观公舒卷皆以道，仁智山静水潺湲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45111,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"饯新三衢牧常著郎","author":"赵汝腾","text":"咫尺去天郡，少双名世儒。\n两轓建有日，五裤周无襦。\n孔庙云来祀，柯山衿佩趋。\n常侯振文化，相业起于衢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45112,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"复用韵答高计使谢庾使","author":"赵汝腾","text":"何人漱石枕寒青，飞鸟徘徊不敢经。\n却骑同登观溟涬，怀仙遥想戒真泠。\n西山南浦临流阁，北树东云把酒亭。\n道极高明须峻绝，铁狮峰顶振风翎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45113,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"柬陈谠送鹅","author":"赵汝腾","text":"鹢鹢何为至，于陵转馈予。\n出哇吾不敢，笑付老庖厨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45114,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]