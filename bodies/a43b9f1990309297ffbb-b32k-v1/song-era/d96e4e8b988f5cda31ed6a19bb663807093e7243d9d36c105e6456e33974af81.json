[{"title":"莞尔堂夏日偶成","author":"向滈","text":"槐荫参差日转廊，时看野鸟下横塘。\n闲窗绿映筼筜净，流水红浮菡萏香。\n座有琴觞真道院，径通花木似禅房。\n文楸珍簟疏帘里，与子同消夏日长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36417,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"莞尔堂和柳枢密韵","author":"向滈","text":"平生麋鹿性，从仕匪所娱。\n要非折腰具，悠然慕潜夫。\n赋归恨不蚤，空悲岁云徂。\n世情固险薄，官路徒惊呼。\n君看得失际，岂问戚与疏。\n论心未必尔，反眼何所无。\n嗟我与世忤，正坐所见殊。\n强颜恋五斗，我岂不足与。\n湖南有良田，亦有宅一区。\n会当拂衣去，俯仰聊自如。\n谁能揖上官，迫促畏简书。\n遂令湖海上，坐觉豪气除。\n君言浪见许，众口方骂予。\n不学望尘辈，甘心履危途。\n所得俱可耻，山岩等豪铢。\n古人惟事道，吾行端不迂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36418,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"卜算子 寄内","author":"向滈","text":"休逞一灵心，争甚闲言语。\n十一年间并枕时，没个牵情处。\n四岁学言儿，七岁娇痴女。\n说与傍人也断肠，你自思量取。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36419,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小重山","author":"向滈","text":"翡翠林梢青黛山。\n小楼新罨画，卷珠帘。\n碧纱窗外水挼蓝。\n凭栏处，相对玉纤纤。\n人散酒阑珊。\n夜长都睡皱，唾花衫。\n一弯残月下风檐。\n凌波去，罗袜步蹁跹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36420,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"忆秦娥","author":"向滈","text":"秋萧索。\n别来先自情怀恶。\n情怀恶。\n日斜庭院，月明帘幕。\n轻离却似于人薄。\n而今休更思量著。\n思量著。\n肝肠空断，水云辽邈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36421,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水调歌头","author":"向滈","text":"短棹舣湍石，华月满汀洲。\n应知孤客无寐，特地照离忧。\n谁念姮娥单枕，寂寞广寒宫殿，亦自□□□。\n□□□□□，□□□□□。\n□怜我，尘满袖，雪盈头。\n两乡千里萦恨，何事不归休。\n遥想闺中今夜，夜久寒生玉臂，犹自倚高楼。\n别泪入湘水，归梦绕鄜州。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36422,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"长相思 其二","author":"向滈","text":"行相思。\n坐相思。\n两处相思各自知。\n相思更为谁。\n朝相思。\n暮相思。\n一日相思十二时。\n相思无尽期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36423,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"长相思 其一","author":"向滈","text":"桃花堤。\n柳花堤。\n芳草桥边花满溪。\n而今戎马嘶。\n千山西。\n万山西。\n归雁横云落日低。\n登楼望欲迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36424,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"好事近","author":"向滈","text":"清晓渡横江，江上月寒霜白。\n寂寞断桥南畔，有一枝春色。\n玉肌孤瘦恰如伊，此际转相忆。\n且道这些烦恼，看几时休得。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36425,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"如梦令 其八","author":"向滈","text":"厮守许多时价。\n谁信一筹不画。\n相送到矾园，赢得泪珠如泻。\n挥洒。\n挥洒。\n将底江州司马。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36426,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"如梦令 其三 书百方观音寺壁","author":"向滈","text":"直面雨轻风峭。\n极目水空烟渺。\n家在武陵溪，无限壑讥峰诮。\n归好。\n归好。\n睡足一江春晓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36427,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"如梦令 其五","author":"向滈","text":"杨柳千丝万缕。\n特地织成愁绪。\n休更唱阳关，便是渭城西路。\n归去。\n归去。\n红杏一腮春雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36428,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"如梦令 其七","author":"向滈","text":"谁伴明窗独坐。\n和我影儿两个。\n灯烬欲眠时，影也把人抛躲。\n无那。\n无那。\n好个恓惶的我。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36429,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"如梦令 其四 书弋阳楼","author":"向滈","text":"楼上千峰翠巘。\n楼下一湾清浅。\n宝簟酒醒时，枕上月华如练。\n留恋。\n留恋。\n明日水村烟岸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36430,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"如梦令 其二 次韵子文邢丈","author":"向滈","text":"梦断绿窗莺语。\n消遣客愁无处。\n小槛俯青郊，恨满楚江南路。\n归去。\n归去。\n花落一川烟雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36431,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"如梦令 其一 道人书郡楼","author":"向滈","text":"旧恨新愁无际。\n近水远山都是。\n西北有高楼，正为行藏独倚。\n留滞。\n留滞。\n家在吴头楚尾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36432,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西江月 其三","author":"向滈","text":"竹寺青灯永夜，江城黄叶高秋。\n当时文物尽交游。\n更为笛声怀旧。\n牢落一生羁思，风流万斛诗愁。\n强邀从事到青州。\n酒病绵绵越瘦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36433,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西江月 其五","author":"向滈","text":"别后千思万想，眼前一日三秋。\n小街栏槛记追游。\n料得新妆依旧。\n自笑非常蒂殢，为他无限闲愁。\n莫将离恨寄鄜州。\n闻道腰肢愈瘦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36434,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西江月 其四","author":"向滈","text":"抵死漫生要见，偷方觅便求欢。\n十分赢得带围宽。\n刬地如今难恋。\n枕畔水沈烟尽，床头银蜡烧残。\n鸳衾不觉夜深寒。\n记取有人肠断。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36435,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西江月 其二","author":"向滈","text":"门柳疏疏映日，井桐策策翻秋。\n萧条不似那时游。\n只有山光依旧。\n别久犹牵去梦，怀多还惹新愁。\n吹箫人在雁回州。\n不管沈郎消瘦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36436,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西江月 其一","author":"向滈","text":"流水断桥衰草，西风落日清笳。\n往来赢得鬓边华。\n此去征鞍休跨。\n烟溆绿深陂筱，霜篱红老江花。\n青山尽处是侬家。\n拟唤渔舟东下。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36437,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"阮郎归","author":"向滈","text":"隔篱疏影照横塘。\n东风吹暗香。\n陇头归路指苍茫。\n江南春兴长。\n扃小院，静回廊。\n有人凭短墙。\n角声惊梦月横窗。\n此时能断肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36438,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"阮郎归","author":"向滈","text":"湘南楼上好凭栏。\n西风吹鼻酸。\n宦游何处不惊湍。\n白鸥盟已寒。\n空饮恨，废追欢。\n沈郎衣带宽。\n故人休放酒杯乾。\n而今行路难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36439,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"念奴娇 木樨","author":"向滈","text":"霜威凄紧，政悲风摇落，千山群木。\n十里清香方盛赏，岩桂娇黄姹绿。\n九畹衰丛，东篱落蕊，到此成粗俗。\n孤标高远，淡然还媚幽独。\n憔悴诗老多情，问佳人底事，幽居空谷。\n日暮天寒垂翠袖，愁倚萧萧修竹。\n林下神情，月边风露，不向雕栏曲。\n殷勤惟有，篆烟留得馀馥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36440,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"武陵春 藤州江月楼","author":"向滈","text":"长记酒醒人散后，风月满江楼。\n楼外烟波万顷秋。\n高槛冷飕飕。\n想见云鬟香雾湿，斜坠玉搔头。\n两处相思一样愁。\n休更照鄜州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36441,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"青玉案 其二","author":"向滈","text":"多情赋得相思分。\n便揽断、愁和闷。\n万种千般说不尽。\n吃他圈樻，被他拖逗，便佛也、须教恨。\n传消寄息无凭信。\n水远山遥怎生奔。\n梦也而今难得近。\n伊还知道，为伊成病，便死也、谁能问。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36442,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"青玉案 其一","author":"向滈","text":"别时抆泪花无语。\n但一味、教郎住。\n此日扁舟游远浦。\n雨晴云树，月斜烟树。\n目断家何许。\n红笺不寄相思句。\n人在潇湘雁回处。\n屈指归期秋已暮。\n万千里路，两三头绪。\n恨不飞将去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36443,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"临江仙 其二","author":"向滈","text":"乱后此身何计是，翠微深处柴扉。\n即今双鬓已如丝。\n虚名将底用，真意在鸱夷。\n治国无谋归去好，衡门犹可栖迟。\n不妨沈醉典春衣。\n人生行乐耳，须富贵何时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36444,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"临江仙 其一 再到桂林","author":"向滈","text":"瘦损东阳缘底事，离愁别恨难禁。\n夜长谁共拥孤衾。\n来时青鬓在，今已二毛侵。\n流水青山依旧是，兰桡往事空寻。\n一番风雨又春深。\n桃花都落尽，赢得是清阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36445,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南乡子 白石铺","author":"向滈","text":"临水窗儿。\n与卷珠帘看画眉。\n雨浴红衣惊起后，争知。\n水远山长各自飞。\n受尽孤凄。\n极目风烟说与谁。\n直是为他憔悴损，寻思。\n怎得心肠一似伊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36446,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南歌子","author":"向滈","text":"路尽湘江水，人行瘴雾间。\n昏昏西日度严关。\n天外一簪初见、岭南山。\n北雁连书断，新霜点鬓斑。\n此时休问几时还。\n准拟桂林佳处、过春残。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36447,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"点绛唇","author":"向滈","text":"屈指新冬，肃霜天气重阳后。\n授衣时候。\n兰菊香盈袖。\n此日生申，维岳钟神秀。\n倾名酎。\n篆添金兽。\n共祝如椿寿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36448,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"点绛唇 和彪德美韵赠杨伯原","author":"向滈","text":"蕙怨兰愁，玉台羞对啼妆面。\n懒匀香脸。\n不放眉峰展。\n幽恨谁知，锦字空传远。\n何时见。\n为郎肠断。\n不似郎情浅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36449,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"减字木兰花","author":"向滈","text":"多情被恼。\n枉了东君无限巧。\n真个愁人。\n一片轻飞减却春。\n阑干凭暖。\n目断彩云肠也断。\n两岸青山。\n隐隐孤舟浪接天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36450,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清平乐 次韵王武子寄远","author":"向滈","text":"离愁万斛。\n春思难拘束。\n瘦尽玉肌清彻骨。\n蹙损两眉秀绿。\n画屏罗幌输君。\n文鳞锦翼尤勤。\n长记酒醒香冷，笑将髻子隈人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36451,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 其一 望行人","author":"向滈","text":"小楼不放珠帘卷。\n菱花羞照啼妆面。\n金鸭水沈烟。\n待君来共添。\n鹊声生暗喜。\n翠袖轮纤指。\n细细数归程。\n脸桃春色深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36452,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 其二","author":"向滈","text":"云屏月帐孤鸾恨。\n香消玉减无人问。\n斜倚碧琅玕。\n萧萧生暮寒。\n低垂双翠袖。\n袖薄轻寒透。\n庭院欲黄昏。\n凝情空断魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36453,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"朝中措","author":"向滈","text":"平生此地几经过。\n家近奈情何。\n长记月斜风劲，小舟犹渡烟波。\n而今老大，欢消意减，只有愁多。\n不似旧时心性，夜长听彻渔歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36454,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"摊破丑奴儿/采桑子","author":"向滈","text":"自笑好痴迷。\n只为俺、忒㬠雏儿。\n近来都得傍人道，帖儿上面，言儿语子，那底都是虚脾。\n楼上等多时。\n两地里、人马都饥。\n低低说与当直底，轿儿抬转，喝声靠里，看俺么、裸而归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36455,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"满庭芳 寿妻母高令人","author":"向滈","text":"玉粉匀梅，曲尘浮柳，画檐迟日融融。\n金猊喷麝，庭户转香风。\n好是闲居戏彩，寿觞举、和满春容。\n须知道，闺门孕秀，佳气在帘栊。\n无穷。\n观盛事，年年此会，拚醉金钟。\n又何须、西池高宴仙宫。\n尽把乔松□寿，兼大国、秦虢重封。\n那堪更，门阑多喜，女婿近乘龙。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36456,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"虞美人 其二","author":"向滈","text":"宝梳半脱文窗里。\n玉软因谁醉。\n锦鸳应是懒熏香。\n□我水村孤酌、减疏狂。\n此时纵有千金笑。\n情味如伊少。\n带围宽尽莫教知。\n嫌怕为侬成病、似前时。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36457,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"虞美人 其一 临安客店","author":"向滈","text":"酒阑敧枕新凉夜。\n断尽人肠也。\n西风吹起许多愁。\n不道沈腰潘鬓、不禁秋。\n如今病也无人管。\n真个难消遣。\n东邻一笑直千金。\n争奈茂陵情分、在文君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36458,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蝶恋花","author":"向滈","text":"费尽东君无限巧。\n玉减香销，回首令人老。\n梦绕岭头归未到。\n角声吹断江天晓。\n燕子来时春正好。\n寸寸柔肠，休问愁多少。\n从此欢心还草草。\n凭栏一任桃花笑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36459,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"踏莎行","author":"向滈","text":"万水千山，两头三绪。\n凭高望断迢迢路。\n钱塘江上客归迟，落花流水青春暮。\n步步金莲，朝朝琼树。\n目前都是伤心处。\n飞鸿过尽没书来，梦魂依旧阳台雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36460,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"向滈","text":"人情甚似吴江冷，世路真如蜀道难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36461,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"从吴傅朋游芝山登五老亭以驾言出游分韵赋诗","author":"向?","text":"兹山何巍巍，气欲等嵩华。\n从公二三子，胜日饱闲暇。\n跻攀谢车舆，自办两不借。\n扪萝觅幽磴，行椒得孤榭。\n侧送夕阳移，俯视高鸟下。\n登临记曩昔，岁月惊代谢。\n却数一周星，复命千里驾。\n身从泛梗流，事与浮云化。\n朅来共一尊，似为天所赦。\n明发还问涂，合离足悲叱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36462,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题吴傅朋游丝书","author":"向?","text":"先生著名节，百世追延陵。\n我评先生贤，不以能书称。\n功成磨苍崖，盛德颂日升。\n勿书凌云榜，华颠踏高层。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36463,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"向?","text":"脩篁万个玉生烟，芳木千名花欲语。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36464,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"如梦令 其六","author":"向镐","text":"野店几杯空酒，醉里两眉长皱，已是不成眠，那更酒醒时候，知否，知否？\n直是为他消瘦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36465,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春归","author":"吕人龙","text":"过却清明艳冶天，梨花飞雪柳森烟。\n欲凭莺燕留春住，无奈东风信杜鹃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36466,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿建兴寺","author":"吕人龙","text":"路入招提晚更深，万山秋老薄寒生。\n芙容枝上无多雨，自把孤怀滴到明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36467,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题钓台 其一","author":"吕人龙","text":"钓台还是先生物，洛汭今非汉帝家。\n过客不知兴废事，又驰车马入京华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36468,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题钓台 其二","author":"吕人龙","text":"万古寒潭数曲山，红尘不到白鸥閒。\n先生自是生涯淡，却厌浮云满世间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36469,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上融堂","author":"吕人龙","text":"直道人间未可孤，朝廷有意用真儒。\n故将通鉴烦司马，不使春秋欠董狐。\n握节米猪高节不，盗名齐豹得名无。\n若商败狄鏖秦事，先轸何尝是匹夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36470,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"光风霁月亭","author":"吕人龙","text":"江边回首见峥嵘，砥柱颓波气象狞。\n三面好山俱觌面，一泓寒绿不闻声。\n月从康节诗边吐，风向包羲易里生。\n如此生涯天未老，更须著脚外间行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36471,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺陈随隐以布衣除东宫掌书","author":"吕三馀","text":"青宫楼观近尧阶，班列屏风间坐开。\n人羡杜閒生杜甫，天教苏颋继苏瑰。\n马归禁苑行边柳，鹤伴平山隐处梅。\n我恨长镵斸黄独，兀年无计策衰颓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36472,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"憾金南伐","author":"吕之鹏","text":"缝掖无由挂铁衣，剑花生涩马空肥。\n灯前草就平南策，一夜江神涕泣归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36473,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南山留题","author":"吕元锡","text":"龙穴潜幽通海潮，璇宫突兀插云霄。\n三千世界诸天近，百二山河故国遥。\n寥落偏城连谷口，荒凉古寺倚山腰。\n溪南可款门脩竹，何况丁宁已见招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36474,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"归洛寄祖择之龙图","author":"吕公著","text":"恩深骨髓谓慈亲，义重邱山是故人。\n归过嵩阳旧游地，□云收得薜萝身。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36475,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和王安之同赴府尹王宣徽洛社秋会","author":"邵雍","text":"后房深出会亲宾，乐按新声妙入神。\n红烛盛时翻翠袖，画桡停处占青蘋。\n早年金殿旧游客，此日凤池将去人。\n宅冠名都号蜗隐，邵尧夫敢作西邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36476,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"延福坊李太博乞园池诗","author":"邵雍","text":"宣威十九次高牙，奕叶功臣旧将家。\n清世辞荣归里第，白头行乐过年华。\n杯盈香醑浮春水，曲度新声出靓花。\n如此园池如此寿，儿孙满眼庆无涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36477,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杨郎中新居和尧夫先生韵 其二","author":"吕公著","text":"碧瓦朱门将相居，见嵩临洛百家无。\n登高此地还能赋，会老他年定入图。\n花发四时排步障，鸟鸣终日劝提壶。\n何人遇赏偏留赏，逸士清风激鄙夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36478,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杨郎中新居和尧夫先生韵 其一","author":"吕公著","text":"高斋旷望极山川，却顾卑居不值钱。\n二室峰峦凝画碧，万家楼阁带轻烟。\n春浓缭绕环游骑，地胜依稀寓列仙。\n唱发幽人丞相和，当时纸贵洛城传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36479,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和王安之六老诗 其一","author":"吕公著","text":"六老皤然鬓似霜，纵心年至又非狂。\n园池共避何方胜，樽酒相欢未始忙。\n杖屦烂游千载运，衣巾浓惹万花香。\n过从见率添成七，况复秋来亦渐凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36480,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"追和王常侍登郡楼望山","author":"邵雍","text":"四贤当日此盘桓，千百年人尚厚颜。\n天下有名难避世，胸中无物漫居山。\n事观今古兴亡后，道在君臣进退间。\n若蕴奇才必奇用，不然须负一生闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36481,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]