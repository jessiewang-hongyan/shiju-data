[{"title":"次韵朱塘三首 其一","author":"许月卿","text":"杏坛黄叶满霜林，何幸朱塘兀古枌。\n试上月台因问月，知涵云谷几多云。\n梦游当日成何事，嗜学于今喜旧闻。\n我意昨游春水满，重来秋意见涯垠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40082,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵郑将士","author":"许月卿","text":"何曾离日用，千古到如今。\n菊蕊霜全节，梅花月印心。\n韩公蕲竹咏，苏子楚山音。\n谷口微吾子，风流何处寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40083,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵黄玉如大章携先集来访二首 其二","author":"许月卿","text":"桥梓风流满腹经，桂花香里识魁名。\n翻成宵梦古今事，何况人间父子情。\n先集一编诗橐富，家传万卷子金荣。\n挂名叙跋流芳远，晓起吟窗仔细评。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40084,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵黄玉如大章携先集来访二首 其一","author":"许月卿","text":"夜宿槎溪碧草幽，草窗招隐劝巢由。\n朝来忽得新诗好，客里俄惊喜气浮。\n秋老空山唳清鹤，天寒野水卧孤舟。\n细吟天下黄香句，晓雾轻烟古渡头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40085,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵黄玉如求记","author":"许月卿","text":"先子北山书剑留，山川还自旧相缪。\n与君去岁衔杯处，遣我长歌陟岵游。\n瘦鹤风轻霜桧舞，归鸦烟重晚林投。\n中斋孟氏仙官府，同号同庚成佛不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40086,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵程说和","author":"许月卿","text":"灯花昨夜为谁开，谁笑泉田处士来。\n不染一尘宜宝界，长如三月似天台。\n频摇麈尾频挥翰，每看蟾轮每举杯。\n和气满堂春拍拍，灯花昨夜为谁开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40087,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵程愿二首 其二","author":"许月卿","text":"二李歌行醉里歌，君溪两棹我烟蓑。\n凤凰台上我山墅，虹马轩高君月坡。\n晓径焰间追李杜，夜窗灰里拨阴何。\n长哦岁晚成二老，诗社往来君肯么。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40088,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵程愿二首 其一","author":"许月卿","text":"我家张许同生岁，果者尧时值圣明。\n丙子与君无贵者，甲辰惟我亦同庚。\n闲云万岭林泉兴，明月一溪丘壑情。\n同岁同心有如此，相期岁晚李歌行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40089,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵蜀人李施州芾端午 其二","author":"许月卿","text":"对时思故国，客里厌南音。\n同谷凄凉恶，三闾感慨心。\n赐衣聊杜句，要艾孰骚吟。\n莫说成都景，岷峨秋满襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40090,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵蜀人李施州芾端午 其一","author":"许月卿","text":"几日愁无雨，梦回闻雨声。\n恰逢端午至，不觉和诗成。\n惨淡疑天泪，滂沱吊屈生。\n邦人云此日，阴感助阴兵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40091,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"灯火","author":"许月卿","text":"灯火掩柴门，疏芜烟水昏。\n鸡啼孤月晓，犬吠隔山村。\n桃叶翻新曲，梅花返旧魂。\n凄其何处笛，一笑卧空樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40092,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"住黛障","author":"许月卿","text":"黛障地眉展，绿波天画开。\n鸳鸯长不散，翡翠去还来。\n坛杏颓垣里，陇梅荒草堆。\n山川浑似旧，不管曲声哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40093,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"使华","author":"许月卿","text":"使华馆伴日宣劳，风雨连床夜作逃。\n爱惜太痴如拱璧，弃遗胜读若秋毫。\n双清幽沼芳泉活，一碧长空皓月高。\n坐看睡魔三舍辟，金炉兽炭古离骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40094,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和子思弟韵寿母","author":"许月卿","text":"劣相谁知此老天，瑶池专遣雪当筵。\n开花敬上夫人寿，列树无非西子妍。\n松学妙龄施粉点，鹤迷归路认莲船。\n水晶世界琼梅阁，肯道人间不是仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40095,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和赵资相","author":"许月卿","text":"手托东南半壁天，向天捧诏下搜贤。\n尘沙骑鹤征鸿倦，衢道乘鸾病骥先。\n玉陛九重将玉立，珠帘十里看珠联。\n状元宰相平生事，雅意中原愿执鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40096,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜永","author":"许月卿","text":"夜永月清甚，雨馀风快哉。\n月将槐影出，风遣桂香来。\n风至地自扫，月来云亦开。\n三千翰林手，光霁瑩灵台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40097,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"临川","author":"许月卿","text":"临川摄守得仁侯，闵两精诚贯显幽。\n五日不将京兆看，丰年惟切杜陵忧。\n先欣霢霂滋青稻，伫见滂沱涨碧流。\n物外闲人欢喜处，炎天亭受一亭秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40098,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"临川家史君坤翁喜雨","author":"许月卿","text":"临川鼓舞诵贤侯，闵雨皇皇祈有秋。\n昨夜琅函奏霄汉，今朝玉粒雨平畴。\n名亭应有东坡记，积粟可宽西顾忧。\n我得顺流南浦去，商霖又是济川舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40099,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"咸淳","author":"许月卿","text":"咸淳风乐好，淳厚似咸平。\n人意逢春乐，天心遇社晴。\n征僮催远信，舞袖促新声。\n今岁梅能耐，咸平诗可盟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40100,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"客来","author":"许月卿","text":"客来商略诗，夜市正惊时。\n云破天青眼，烟收月白眉。\n芙蓉天富贵，松竹月清奇。\n我醉欲眠去，携琴明日迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40101,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"帝学","author":"许月卿","text":"帝学须君入，天游输我豪。\n君方注老子，我自读离骚。\n湖上春风好，山中夜月高。\n山高君寄内，湖海我陶陶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40102,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"神静","author":"许月卿","text":"神静何须卜，心閒即是仙。\n芋煨牛粪火，瓢滴马鬃泉。\n绿染春风柳，红匀晓露莲。\n明朝晴景好，一棹尽平川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40103,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"追赋暮游","author":"许月卿","text":"锡山舟泊似荒村，微服南禅古迹存。\n壁上姓名今已远，碑阴人物了能言。\n薄游草草山侵袖，远思悠悠风满轩。\n携手出门烟树密，数僧离立语黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40104,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送孙山长谒皮参政","author":"许月卿","text":"授钺天教锦故乡，公心泉石不旂常。\n沙堤正自恐不免，野渡安能久退藏。\n羡子白刘从绿野，顾予鸡犬愧旌阳。\n衮衣会趁春风入，野服犹堪谒道傍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40105,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送张平湖山游","author":"许月卿","text":"殷勤来访别，去作子长游。\n雪霁月清甚，天寒雁过不。\n沙堤今相府，花苑古苏州。\n归路梅花好，还来问白鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40106,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送周徽州赴建州","author":"许月卿","text":"作牧文公父母州，考亭今又借邦侯。\n来莫建山同仰止，去思歙水共长流。\n贡茗莫淹千里守，和羹须是百花头。\n暇日摩挲厅壁记，昔梁叔子后身周。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40107,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重寄留梦炎","author":"许月卿","text":"安得肉生羽，从公出外游。\n同年多契阔，新句孰赓酬。\n天玉梅花雪，人寒野水舟。\n中斋难醉白，山屋好中秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40108,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重寄郭衢州","author":"许月卿","text":"细数东京士，无如许郭优。\n山林异朝市，姓字欠书邮。\n久已巢由隐，难成李郭舟。\n三衢春有脚，山屋好中秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40109,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"香潭八首 其八","author":"许月卿","text":"政须洗耳听新篇，业已扁舟学计然。\n洁己庶几堪谏主，力田未必愧逢年。\n菑畬之业平心地，金石之交只在天。\n舞殿歌台从冷暖，此心如月一婵娟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40110,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"香潭八首 其七","author":"许月卿","text":"老师当日启灵篇，亲手传承岂偶然。\n残月晓风空夜夜，垂杨芳草自年年。\n报恩男子那无地，未丧斯文决有天。\n月在香潭照心曲，更饶一雨洗娟娟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40111,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"香潭八首 其六","author":"许月卿","text":"斗酒从来诗百篇，世间庄语便哗然。\n蕙兰得志应无日，稊稗逢时却有年。\n何必怨尤难舍我，欲教平治直须天。\n生来不被蛾眉误，人谤人间无丽娟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40112,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"香潭八首 其五","author":"许月卿","text":"信笔篇篇又一篇，东坡父子故依然。\n凤凰鸣处知何日，龙虎榜中今几年。\n残岁寄寒难避地，颠风急雪更无天。\n六宫粉黛无颜色，谁道人间少静娟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40113,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"香潭八首 其四","author":"许月卿","text":"我歌乱以归来篇，君笑骑驴孟浩然。\n君有风云须得地，我无历日不知年。\n君贪觞咏盟泉石，我愿朝廷泰地天。\n君去登畿春浩浩，我归受币女娟娟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40114,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"香潭八首 其三","author":"许月卿","text":"殷勤教我琵琶篇，年友胸中炯炯然。\n公瑾风流酹江月，孔明礼乐中兴年。\n君臣可谓逢千载，南北须教总一天。\n水调歌中休惜别，月明千里共婵娟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40115,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"香潭八首 其二","author":"许月卿","text":"琼林宴坐赐诗篇，先帝恩光故烨然。\n紫陌寻春思是日，红笺通刺戒同年。\n浮花浪蕊阳和地，疏影暗香霜雪天。\n松柏岁寒吾共子，春风永巷闭连娟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40116,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"香潭八首 其一","author":"许月卿","text":"平生不作明河篇，一笑童心尚隐然。\n后日视今哀后日，同年而语不同年。\n瑩清川泽玻璃地，浓淡烟云水墨天。\n尽向痴人前说梦，何妨句里有婵娟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40117,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽马枢密母段氏","author":"许月卿","text":"松冈新植泷丰碑，千古哀荣谁似之。\n训子断机霜雪冷，退朝犹绩月星垂。\n绿衣西府梅花落，素幄北堂萱草萎。\n何惜沙堤明日路，潘舆无复再来时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40118,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽外舅二首 其二","author":"许月卿","text":"月卿方髻时，公欲东床之。\n我姑已黄土，公鬓正青丝。\n忽忽成今古，茫茫问孰谁。\n但能抱茂子，洒泪读新碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40119,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽外舅二首 其一","author":"许月卿","text":"人间三十二，名字几千春。\n慷慨汉游侠，孝慈周吉人。\n视物犹视己，顾亲宁顾身。\n山中当出相，嗣子世其仁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40120,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽张丞泳","author":"许月卿","text":"异时两举遂登科，人谓功名当若何。\n三十馀年空屈曲，七咨脱选竟蹉跎。\n为丞再出簿尉下，斯世浑如梦觉过。\n同里同年老御史，谅难如此不悲歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40121,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽李左藏","author":"许月卿","text":"少年谓子气横秋，壮已边城汗漫游。\n筮仕弗如归亦好，读书未了死方休。\n半生懒意琴三叠，千古诗情土一邱。\n月落锡林烟露冷，松风无籁自飕飕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40122,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽汪士洪","author":"许月卿","text":"昔日杜小侄，中年马少游。\n不知身外事，祇觉鬓边秋。\n有子三株柳，同公荒草邱。\n梅溪一夜雪，片片逐寒流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40123,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽陈节使","author":"许月卿","text":"凛凛如公一寸丹，荒城夜月彻清寒。\n向时尚已死诸葛，今日难贪老阿瞒。\n素志平生兆马革，黎民一郡博弹冠。\n只鸡斗酒群群谶，吾力犹能灭贺兰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40124,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽妹婿汪汻四首 其一","author":"许月卿","text":"奉礼徒员外，京师枉治中。\n二郎槐不做，四老橘成空。\n三凤壁岩子，双龙宝剑雄。\n万人真莫赎，愁绝老坡翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40125,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽胡制机康侯","author":"许月卿","text":"鹭点青松白，莺穿绿柳黄。\n儿时工对偶，老去更文章。\n诛意平生学，爰咨去路忙。\n酒边招隐操，我更忆山堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40126,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽座主吴倅","author":"许月卿","text":"菊翁去后菊园荒，寿不如花尽自香。\n进学解成谁贝锦，题舆字湿已黄粱。\n众流出壑三秋暮，明月照松千仞冈。\n冷落僧炉数间屋，但留名节付贤郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40127,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽清湘令董介轩","author":"许月卿","text":"偏得人间谤与名，盖棺方定伯夷清。\n五经笥满风云壮，百尺楼高星斗横。\n明月照庭香不断，狂飙吹雪意如生。\n河汾回首成今古，礼乐犹将致太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40128,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽番阳戴如曾贡士母金氏","author":"许月卿","text":"霜气凛闺妹，严风老更癯。\n诗书谓有子，门户可无夫。\n雏凤横秋鹗，孤鸾啼夜乌。\n长松有风雨，枯草但平芜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40129,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓幄","author":"许月卿","text":"晓幄明初日，晨钟递北风。\n人生行乐著，天道好还同。\n我友诗三昧，吾衰酒一中。\n万间君雅志，突兀倚晴空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40130,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"起来","author":"许月卿","text":"起来霜月冷飕飕，清兴催人不自由。\n万户千门胡蝶梦，五更三点黑貂裘。\n旦公待旦霜如雪，时夜如时月似钩。\n明日人来问寄字，一天霜月倚西楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40131,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"途中赓禁体雪韵","author":"许月卿","text":"野店冲寒出晓芭，浑如踏月过溪沙。\n五浆先具檐头蕊，六博争雄屐齿花。\n狐白裘成天不管，玉清境净地无瑕。\n素光自是渔人物，披得一蓑来酒家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40132,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄东宫官","author":"许月卿","text":"瀛洲有诏翊储宫，妙选欢传有古风。\n鹤禁共看周八士，狐裘记取国三公。\n年华春早鸡声里，博望秋严霜气中。\n入侍缉熙传圣学，四书隽永事何穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40133,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄陈宰","author":"许月卿","text":"上国春多雨，西江莲自香。\n恐人疑少室，惟我薄淮阳。\n南北东西命，君臣父子常。\n到官理词讼，月色更风光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40134,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄留梦炎","author":"许月卿","text":"山屋好中秋，中斋炯在眸。\n中流谁砥柱，野水却孤舟。\n上意甘盘甚，来迟季子留。\n愿毋淹独乐，留相九重休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40135,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄郭衢州","author":"许月卿","text":"渤海潢池盗，龚卿奉诏忧。\n东轩继芳躅，西府踵清流。\n同榜黄扉匹，中峰皂盖俦。\n中斋同一笑，山屋好中秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40136,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄顾次岳五首 其五","author":"许月卿","text":"半夜开窗凭阑坐，无心云起镜湖心。\n铺茵烟草漫天幄，璞玉楼台浑色金。\n访古寂寥秋漠漠，怀人感慨碧岑岑。\n未知何日韦斋井，明月清风烦暑襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40137,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄顾次岳五首 其四","author":"许月卿","text":"运千可际休明运，心一堪传贤圣心。\n不一此心非自玉，半千之运或如金。\n道源天出三清境，远目明双寸碧岑。\n胸次须令天样阔，五湖为带三江襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40138,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄顾次岳五首 其三","author":"许月卿","text":"镜湖扁字无今古，无古无今只此心。\n云入枕边堂署玉，月穷天外日镕金。\n楼台髣髴水墨画，烟雾空濛岩壑岑。\n须信尚书最难读，人间无许大胸襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40139,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄顾次岳五首 其二","author":"许月卿","text":"韦斋井畔通宵月，流出文公阙里心。\n半夜起来湖瑩玉，明朝应有柳摇金。\n万壑正看天地肃，一楼坐断水云岑。\n镜湖楼扁知无恙，二十年前醉解襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40140,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄顾次岳五首 其一","author":"许月卿","text":"柳塘醉我无边酒，得陇痴生望蜀心。\n亦有白衣双白玉，不孤黄菊万黄金。\n宝婺古来金绣水，银蟾后夜玉青岑。\n韦斋井畔通宵月，应照空樽印渴襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40141,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题岩经楼","author":"许月卿","text":"楼中图史澹炉墨，中有成都较艺文。\n手泽存焉生旧感，心传妙处长新闻。\n世科事业无如子，经学源流可致君。\n祇恐校雠天禄阁，猿啼楼外满溪云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40142,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"得安道中","author":"许月卿","text":"洲渚但明月，人烟如晓星。\n春泥才故里，秋水又浮萍。\n衣破披蓑冷，厨空煮草腥。\n抱儿含笑语，衣里麦青青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40143,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"捧砚姬空翠二首 其二","author":"许月卿","text":"看山车放慢，遇水马争先。\n须信一年景，无如三月天。\n露花如此好，烟柳十分员。\n客醉不须去，竹床相对眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40144,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"捧砚姬空翠二首 其一","author":"许月卿","text":"捧砚姬空翠，随琴鹤晓烟。\n夕阳更山外，流水自楼前。\n芳草垂杨地，和风丽日天。\n戏游看处处，明媚自年年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40145,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梦中作","author":"许月卿","text":"我来烟水远，渔艇夜鸣榔。\n万仞巫山耸，一宵秋梦长。\n金翘何婀娜，玉佩遽叮当。\n月冷天鸡晓，空馀枕屏香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40146,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹿鸣用赵资相韵","author":"许月卿","text":"宗主人才郭子仪，门多将相蔚相辉。\n托根小草秋榆宦，食叶长廊春棘闱。\n报国自怜心事壮，忧时不觉梦魂飞。\n平生此志非温饱，勋业从公问指归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40147,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]