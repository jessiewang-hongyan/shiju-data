[{"title":"雪中再示德龄二弟三首 其二","author":"裘万顷","text":"平生蓑笠惯冲寒，长忆江湖把钓竿。\n昨夜北窗闻雪作，梦魂飞到子陵滩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26908,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪中再示德龄二弟三首 其一","author":"裘万顷","text":"只道园林春未归，风前一夜柳花飞。\n东皇自是繁华主，不用玄冥荐玉妃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26909,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪中戏元德元龄二弟二首 其二","author":"裘万顷","text":"袖间出手不应迟，柳絮渔蓑总是诗。\n二妙得君真所喜，一寒如我有谁知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26910,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪中戏元德元龄二弟二首 其一","author":"裘万顷","text":"在昔梅花犹有赋，如今冰柱亦无诗。\n吾衰不作池塘梦，春草生时子合知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26911,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"善利阁次伯仁所题赵子良画四首 其三","author":"裘万顷","text":"风檐手君诗，心迹已清绝。\n何当更长吟，坐对澄江雪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26912,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"皖山纸帐送宋居士","author":"裘万顷","text":"剪裁不惜楮先生，要护高人雪屋眠。\n只恐鹤书催起去，长留空帐北山巅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26913,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"窗前古槐二首 其二","author":"裘万顷","text":"去岁西湖避暑来，藕花无数眼慵开。\n而今归卧洪崖侧，看尽飞泉看古槐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26914,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"窗前古槐二首 其一","author":"裘万顷","text":"密叶繁阴画不成，捲帘双眼为渠明。\n人间炎热无来处，赢得轩窗分外清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26915,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"简瑄上人","author":"裘万顷","text":"千里归来觅故林，朱弦虽在少知音。\n春风玉几山前路，忍负平生一片心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26916,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"简瑄上人借楞严经","author":"裘万顷","text":"石室云山镇日扃，午鸡啼处睡初醒。\n案头上有炉熏在，试读楞严一卷经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26917,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬余求之二首 其二","author":"裘万顷","text":"雨后轩窗无一尘，窗前松竹更清新。\n不妨踏遍莓苔地，遗我青鞋有故人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26918,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬余求之二首 其一","author":"裘万顷","text":"枕中久已黄粱熟，镜里从教白发垂。\n但得渔樵分半席，此生何必要人知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26919,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题书院壁间碑","author":"裘万顷","text":"天上真龙去不回，世间凡马谩争驰。\n少年气习今犹在，袖手时来省断碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26920,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题老悟画卷四首 其四","author":"裘万顷","text":"谡谡风前荷叶枯，摇摇霜后蓼花疏。\n舂锄旧有江湖约，数辈相依正要渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26921,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题老悟画卷四首 其三","author":"裘万顷","text":"何处移来一川竹，空濛烟雾染人衣。\n其间应有葛陂杖，时出林梢带雨飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26922,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题老悟画卷四首 其二","author":"裘万顷","text":"吏隐三年楚水头，每随凫雁杙扁舟。\n归来喜色惊邻里，分得潇湘一片秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26923,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题老悟画卷四首 其一","author":"裘万顷","text":"中兴以前作山水，只说李成与郭熙。\n谁知淳熙有此老，健笔不减巨然师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26924,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题希亮画","author":"裘万顷","text":"晚牧归来月在山，夜深茅舍不胜寒。\n栖乌欲动催翁起，快傍烟汀把钓竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26925,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题针出羹字韵","author":"裘万顷","text":"一寸坚刚铁琢成，绮罗丛里度平生。\n有时稚子敲成钓，钓得鱼儿便作羹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26926,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题昭君图","author":"裘万顷","text":"纷纷争赂毛延寿，今日丹青竟不传。\n万事无过真实处，后人赢得写婵娟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26927,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题破尘读经所","author":"裘万顷","text":"试为众生破一尘，出经为筏度沧溟。\n待渠到岸无惊畏，复破微尘纳此经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26928,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题笺","author":"裘万顷","text":"六七叶芦秋雨里，两三个雁夕阳边。\n青天万里浑无碍，冲破寒潭一抹烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26929,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题隐室","author":"裘万顷","text":"闽浙相望两道场，上人曾炷室中香。\n直须了却旧公案，莫向空山便隐藏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26930,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"乡人罗朝宗与兵部尚书京公有旧将往见之遇予于乐平因饯别","author":"裘万顷","text":"四时成岁秋云暮，九月肃霜天渐寒。\n有客褰裳涉鄱水，逢人剧口话长安。\n悬知欲听星辰履，厌见从来苜蓿盘。\n姑举一觞饯行色，无鱼长铗切休弹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26931,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"兀坐有感","author":"裘万顷","text":"忘言编简倦三复，适意丝桐聊再行。\n已共白云论久要，更寻青鸟问长生。\n按行泉石苔侵屦，披拂松篁露湿缨。\n此事洪崖知我旧，归与端合与同盟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26932,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大雪用前韵五首 其五","author":"裘万顷","text":"谁知天巧出玄机，但怪飞璚过眼奇。\n暝立风枝寒雀倦，愁吟冰谷晓猿饥。\n芦花洲渚月明夜，柳絮池塘春暮时。\n此景人间不长有，写真传影正须诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26933,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大雪用前韵五首 其四","author":"裘万顷","text":"伊人元不堕危机，踏冻冲寒正自奇。\n只怪飞花无处避，都忘炊玉有时饥。\n月明剡水回舟夜，岁暮梁园作赋时。\n一段风流谁得似，只今王谢却能诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26934,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大雪用前韵五首 其三","author":"裘万顷","text":"谁扶天女下冰机，剪水成花片片奇。\n影落池塘波不动，寒侵鸥鹭色皆饥。\n纵横万舞风回处，表里双清月霁时。\n浪战未能无寸铁，对人羞诵醉翁诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26935,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大雪用前韵五首 其二","author":"裘万顷","text":"天孙云里散支机，飞坠人间分外奇。\n勾引芳尊留客醉，栽培玉粒疗民饥。\n幅巾篱落寻梅处，一舸江湖钓月时。\n妙处惟诗可摹写，却怜老去不工诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26936,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大雪用前韵五首 其一","author":"裘万顷","text":"雨师风伯妙天机，幻出乾坤一段奇。\n晚对青山浑似画，夜看黄卷可忘饥。\n金貂换酒非吾事，铁甲屯边正此时。\n失国残胡应冻死，书生犹赋采薇诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26937,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"不雨","author":"裘万顷","text":"农时阅月天不雨，嘉谷丛中龟兆生。\n云势只随风聚散，鸠声空报客阴晴。\n半生忧国发欲白，一饱无期心屡惊。\n尚愿秋阳化甘澍，稍苏枯槁望西成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26938,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书晁文元道院集","author":"裘万顷","text":"华屋金狨座，雕鞍驷马车。\n才堪誇世俗，早已落丘墟。\n此病久沈痼，无人解扫除。\n千年子晁子，道院有遗书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26939,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书率更西林碑","author":"裘万顷","text":"冉冉老将至，区区心已疲。\n文章非世用，字画谩儿嬉。\n庐阜多名刹，隋人有断碑。\n骊黄虽易辩，堂奥未容窥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26940,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"玉山道中时赴掌故之命","author":"裘万顷","text":"麦苗堆绿菜花黄，一簇人家古道傍。\n酒熟不妨邀里巷，年丰赢得事农桑。\n世情只说宦游好，客里那知归兴长。\n我有平生蓑笠在，钓丝何日理斜阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26941,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"用郑浮梁韵简圜师二首 其二","author":"裘万顷","text":"古寺规模壮，空山岁月深。\n春排千树绿，云堕一溪阴。\n地僻人稀到，官闲我得寻。\n归来诧清赏，未觉负初心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26942,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"用郑浮梁韵简圜师二首 其一","author":"裘万顷","text":"杖屦山蹊窄，钟鱼佛界深。\n寒梅残屋角，春荠老墙阴。\n一水元无恙，扁舟尚可寻。\n烦师掬清溜，为我洗尘心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26943,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"用前韵谢伯量过访山中","author":"裘万顷","text":"胜游千里笑谈中，雪片梅花正仲冬。\n肯向席门寻孺子，更能草具重茅容。\n春风顿觉生寒谷，夜榻惟愁听晓钟。\n半世坡梅门下客，乃今何幸得过从。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26944,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"用黄子益韵二首 其二","author":"裘万顷","text":"睡起忻然思虑少，病馀犹觉应酬艰。\n招摇风月聊须竹，收拾云烟幸有山。\n但要世缘随手断，莫忧诗债几时还。\n追奔富贵非吾事，且占林泉一味闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26945,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"用黄子益韵二首 其一","author":"裘万顷","text":"青衫日日困尘沙，安用浮名与世誇。\n已过半生真似梦，未荒三径且还家。\n恨无沈水纡香穗，喜有寒泉瀹茗花。\n袖却西归遮日手，园林幽处看桑麻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26946,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"有感","author":"裘万顷","text":"政尔双泉忆旧游，柳江闻又有归舟。\n谁能不作千年调，梦断真成万事休。\n倾盖向来情莫逆，奠刍无计泪空流。\n重云已失鹍鹏影，愁绝沧浪一白鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26947,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"有感时与李弘斋有约","author":"裘万顷","text":"去年今日西归客，曝背茅檐又一冬。\n岁月催人虽迅速，简编于我却从容。\n知名焉用诗千首，养病聊须酒一钟。\n早晚杖藜修水去，故人有约许相从。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26948,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次元德弟","author":"裘万顷","text":"宁逐春风上下狂，懒从桃李借恩光。\n只应朝市风波恶，不似山林气味长。\n莫惜举杯邀太白，要看骑马似知章。\n南征他日如相忆，诗句还须付革囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26949,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次元德弟示从龙入学","author":"裘万顷","text":"生儿虽小莫怜渠，学问工夫在谨初。\n今日从师良不恶，他年闭户反成疏。\n双亲未老身无事，诸父能文家有书。\n好与汝兄俱努力，后生丛里试群居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26950,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次王成之咏梅","author":"裘万顷","text":"谁遣冰魂照夕阳，摇摇一任北风凉。\n眼前共有几多蕊，鼻观胡为如此香。\n佳实会须归列鼎，孤标已自压群芳。\n濡毫我欲从君赋，未害平生铁石肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26951,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次光伯韵","author":"裘万顷","text":"竹径当年手自开，只今无处著莓苔。\n绝怜此地过从少，赖有高人时复来。\n篱下久霜犹有菊，水边近腊正多梅。\n我云眷眷三年别，君莫匆匆一夕回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26952,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次朱震远韵","author":"裘万顷","text":"芳池绿水自生肥，上有轩窗隐翠微。\n花竹旧尝开小径，门阑今又启重扉。\n直须阊阖排云去，要看长安跃马归。\n词赋合魁天下士，春光端不负刘煇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26953,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次伯仁善利阁","author":"裘万顷","text":"看经堂中钟磬鸣，看经堂外水云清。\n山连远渚鸟飞急，风入轻帆舟去平。\n烟树不妨留夕照，尘缨正欲濯寒泓。\n凭谁为我问造物，乞与少陵常眼明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26954,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次施真人韵","author":"裘万顷","text":"素韠方多难，丹砂傥一逢。\n勿疑蕉覆鹿，会见竹成龙。\n涧水远仍洁，岩花幽更浓。\n行行望仙宇，知在最高峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26955,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次洪内相梅亭","author":"裘万顷","text":"人间多是梅开后，旋踵东篱事故常。\n那得红帘卷朱户，细看素质傲清霜。\n一生寄兴云山外，几度搔头江路傍。\n咫尺名园身未到，夜窗羞对返魂香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26956,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次洪内相菊亭","author":"裘万顷","text":"诗仙种菊未多时，因菊名亭早有诗。\n欲为寒花标晚节，故将新句寄东篱。\n平生未省翻三峡，高处那能赞一辞。\n便得从容侍公侧，回头已是十年迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26957,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次胡伯仁韵","author":"裘万顷","text":"山长飞鸟急，江阔去帆微。\n唱晚几渔笛，凭高一钓矶。\n从君濯冰雪，满袖得珠玑。\n三叹不能已，归来吟夕晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26958,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"老屋","author":"裘万顷","text":"老屋久攲侧，随宜聊拄撑。\n吾今且共住，缘尽会须行。\n雨打从教坏，风摇不用惊。\n世间虚幻相，聚散本无情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26959,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"别敬叔","author":"裘万顷","text":"笔砚君无间，冰霜岁又除。\n诸生得模范，六艺共耕锄。\n松菊渊明宅，蓬蒿仲蔚居。\n相望傥相忆，时寄数行书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26960,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"怀范光伯再用韵","author":"裘万顷","text":"梅边流水碧洄洄，都把相思付折梅。\n十载不禁双泪落，一尊期慰九肠回。\n惊残蝶梦鹊空喜，望断马蹄人不来。\n咫尺云山尚如此，天涯那解得追陪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26961,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"旸谷偶成","author":"裘万顷","text":"竹近颇忻衣袂爽，苔深长恐履痕侵。\n夜灯四壁图书影，晓日一床花木阴。\n载酒只今谁好事，绝弦从昔为知音。\n区区外物成何用，慎勿缘渠愁此心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26962,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"旸谷偶成","author":"裘万顷","text":"爱日袪愁雾，微和散积阴。\n一窗尘外趣，万竹岁寒心。\n士要崇清节，吾将老故林。\n抱琴聊一醉，何用觅知音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26963,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闲居","author":"裘万顷","text":"闲居最与性相便，勤即翻书懒即眠。\n终日闭门真省事，有时面壁似耽禅。\n大椿岁籥祈亲寿，断简生涯听子传。\n待问洪崖觅丹诀，白云深处引寒泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26964,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜坐","author":"裘万顷","text":"炉火篝灯孰与同，此心吾欲付冥鸿。\n茅檐已作十旬雨，蕙帐不禁连夜风。\n一段清愁诗句里，十分寒事酒杯中。\n溪云未用安排雪，且听梅花试小红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26965,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜坐再用韵二首 其二","author":"裘万顷","text":"家有辋川集，人如王右丞。\n琴书多暇日，觞咏尽高朋。\n拟脱云山屐，来分夜案灯。\n新诗要传写，病眼任瞢腾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26966,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜坐再用韵二首 其一","author":"裘万顷","text":"洪井今真隐，长沙昔谩丞。\n馀生付岩壑，拙宦愧交朋。\n饭菜浑忘肉，囊萤足代灯。\n诗成夜将半，云际月腾腾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26967,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"松花开竹笋茂喜而咏之","author":"裘万顷","text":"繁花密笋暮春时，妆点园林一段奇。\n金粉生香风细细，斑衣留润露垂垂。\n品高宜入神仙药，节劲终全冰雪姿。\n笑彼杏桃儿女态，谩争艳冶媚山歧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26968,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨后","author":"裘万顷","text":"秋事雨已毕，秋容晴为妍。\n新香浮䆉稏，馀润溢潺湲。\n机杼蛩声里，犁锄鹭影边。\n吾生一何幸，田里又丰年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26969,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"临安别余求之","author":"裘万顷","text":"长安车盖喜如云，邂逅惟君是故人。\n风月满怀情洒落，珠玑撒纸句清新。\n携来客里一尊酒，洗尽湖边十里尘。\n富贵功名丈夫事，别离无用泪沾巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26970,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送张高安入京","author":"裘万顷","text":"青衫十载蟾宫客，黑绶三年凤岭头。\n循吏声名武阳令，故家风味富平侯。\n江边休叹双凫去，天上行看一网收。\n八簉鹓班立仙仗，莫忘回首顾沙鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26971,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送范二丈入蓝田书院二首 其二","author":"裘万顷","text":"君在淳熙日，尝师陆监丞。\n今为后死者，乐有远来朋。\n此道未坠地，他时要续灯。\n病夫力不足，拱立看鶱腾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26972,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送范二丈入蓝田书院二首 其一","author":"裘万顷","text":"今代崔斯立，才高不负丞。\n君方为重客，人谓得良朋。\n敏捷朝千字，辛勤夜一灯。\n明年冠秋试，万里看飞腾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26973,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送胡仲立入京","author":"裘万顷","text":"昔对延英日，诸公叹弗如。\n敢言天下事，不负案头书。\n此去朝双阙，悬知有异除。\n荣途方著脚，未用曳长裾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26974,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送胡仲衡","author":"裘万顷","text":"忆昔樵江一见君，喜君吃吃善谈文。\n别来岁月今如许，书里工夫想得勤。\n近世起家多白屋，几人驰志在青云。\n穑斋已踏贤关路，更有诸孙策异勋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26975,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"凉风","author":"裘万顷","text":"凉风几时动，日暮已秋声。\n稍稍月华白，纷纷林影清。\n予怀元不恶，世事巧相撄。\n所愿西成后，边头息戍兵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26976,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]