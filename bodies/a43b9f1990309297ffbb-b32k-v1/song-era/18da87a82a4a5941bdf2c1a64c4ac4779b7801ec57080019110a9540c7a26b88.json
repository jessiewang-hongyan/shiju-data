[{"title":"送华亭沈主簿","author":"司马光","text":"执袂青门道，萧萧马欲东。\n暮云零落翠，远树浅深红。\n楚泽吟声里，吴山醉眼中。\n相思杳何许，野鹤唳高风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24343,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送向防禦知陈州","author":"司马光","text":"千骑去翩翩，专城上少年。\n韦平家好学，阴马世称贤。\n官用才能进，恩非雨露偏。\n想闻河润远，封畛帝畿连。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24344,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送尧夫知河中府二首 其二","author":"司马光","text":"河抱城根曲，山侵地势斜。\n周馀古楼观，舜俗旧人家。\n回首游从阔，装怀牒诉哗。\n何时重载酒，同醉洛阳花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24345,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送尧夫知河中府二首 其一","author":"司马光","text":"耆老承风旧，丝纶锡命新。\n展禽安屡黜，原宪乐常贫。\n执志穷通壹，论交表里真。\n但祈深自重，膏泽望斯民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24346,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送师道知长溪因归觐省","author":"司马光","text":"羁旅帝城久，逢人青眼稀。\n闻君又当去，使我益思归。\n佳色邻乡树，高堂望綵衣。\n春流先自疾，心出片帆飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24347,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送杨太祝知长洲县","author":"司马光","text":"三吴佳县首，民物旧熙熙。\n专用清谈治，非如俗吏为。\n林疏丹橘迥，稻熟白芒攲。\n宜使民无忘，严修太伯祠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24348,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送朱校理知潍州","author":"司马光","text":"东国连年水伤稼，使君到部即行春。\n茫茫四野潢污竭，郁郁万行桑柘新。\n俗不好奢田器贵，狱无留系吏家贫。\n齐人忽怨归朝速，自是承明侍从臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24349,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送朱职方提举江淮运盐","author":"司马光","text":"熬漉沧波耗，征输泽国贫。\n婴罗矜赤子，运筴借能臣。\n拜手觚棱晓，浮舟狼汤春。\n东南待苏息，别酒莫逡巡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24350,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送次道知太平州","author":"司马光","text":"狼汤春流满，芜湖候吏迎。\n旌旟晓日丽，钲鼓野风清。\n暂喜红尘远，休嗟素发生。\n专城方四十，自古以为荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24351,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送计先辈尉宗城","author":"司马光","text":"红尘久帝城，高价动公卿。\n竹柏寒方茂，骅骝老更成。\n冰霜驱马瘦，书剑束装轻。\n丞相虚东阁，遥知倒屣迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24352,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送齐学士知荆南","author":"司马光","text":"汉家太守治才高，楚国山川气象豪。\n旗旆逶迤蟠梦泽，楼船赑屃压江涛。\n雄名谁复知宣武，遗爱犹应祀叔敖。\n何必三年求奏计，诏书朝夕赐金褒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24353,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送何万下第归蜀 其二","author":"司马光","text":"失意流年老，残春对夕阳。\n可堪临远道，更复举离觞。\n花柳已萧索，云山复渺茫。\n西风如有意，音信勿相忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24354,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送何万下第归蜀 其一","author":"司马光","text":"十上终无就，才高定复论。\n清时守儒术，白首在丘园。\n远树隐残日，孤烟生暮村。\n扬鞭万里去，几许不销魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24355,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送何济川为庞公使庆阳席上探得冬字","author":"司马光","text":"幕府遥三舍，传车乘一封。\n忠深轻远道，醉暖失严冬。\n圁水犹飞檄，芦阕未灭烽。\n贤侯虽喜士，难得久从容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24356,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送吴仲庶知江宁","author":"司马光","text":"江南佳丽地，人物自风流。\n青骨灵祠在，黄旗王气收。\n衣冠馀旧俗，歌颂乐贤侯。\n正恐还朝速，江山未遍游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24357,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送吴驾部知真州","author":"司马光","text":"向托屏星驾，同随丞相车。\n终朝容懒拙，经岁庇迂疏。\n共此趋云阙，旋闻建隼旟。\n江淮一都会，游刃必多馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24358,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送吴辨叔大名司户 其二","author":"司马光","text":"致远必自近，如君岂椽曹。\n鱼龙试春浪，松栝露秋毫。\n错落辞华富，䃘?气节高。\n垂天起肤寸，无叹走尘劳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24359,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送吴辨叔大名司户 其一","author":"司马光","text":"元宰司宫钥，旌旄压大河。\n敢言趋府倦，私叹折腰多。\n机发何妨避，光尘未免和。\n艰难方远到，庆阀肯蹉跎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24360,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送宋郎中知凤翔府","author":"司马光","text":"昔解陈仓印，于今二十秋。\n双凫久东上，五马重西游。\n铙骑行关外，壶浆拥道周。\n民心已化服，条教不更修。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24361,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送张寺丞知富顺监","author":"司马光","text":"汉家五尺道，置吏抚南夷。\n欲使文翁教，兼令孟获知。\n盘羞蒟酱实，歌杂竹枝辞。\n取酒须勤醉，乡关不可思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24362,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送张学士两浙提点刑狱","author":"司马光","text":"朝家重典刑，书府借时英。\n钲鼓喧江下，云山拂眼清。\n秋风鲈鲙美，书日锦衣荣。\n勿似朱翁子，空令守邸惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24363,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送张秘校知分宁","author":"司马光","text":"百里大夫官不轻，莫嗟领上发垂星。\n人生谷禄偏宜晚，世路艰难不厌经。\n数曲秋江萦县白，几峰霁色入帘青。\n于公向日多阴德，已有鹓雏在帝庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24364,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送张都官江南东路提刑","author":"司马光","text":"楚俗号难治，司刑尤择贤。\n危疑片言决，舒惨一方专。\n松不彫寒色，丝曾断直弦。\n清风过江外，应在下车前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24365,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送张景淳知邵武军","author":"司马光","text":"闽岭窅何在，东南千里遥。\n仳离伤草草，会合更迢迢。\n隋岸微吹絮，吴江欲上潮。\n肯无同舍念，回首弭轻桡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24366,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送李学士使北","author":"司马光","text":"征盖霜空迥，飘飘迎塞鸿。\n虏牙侵海角，汉节下天中。\n酒薄阴山雪，裘寒易水风。\n边声不可听，归思浩无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24367,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送李益之侍郎致政归庐山 其二","author":"司马光","text":"水底元无月，衣中自有珠。\n六尘皆外物，万法尽迷涂。\n瀑布寒云湿，觚棱瑞气扶。\n遥知至乐地，不异在京都。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24368,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送李益之侍郎致政归庐山 其一","author":"司马光","text":"儒业金华贵，归心白鹤孤。\n江山依旧在，轩冕向来无。\n啸咏谁当共，登临未索扶。\n浩然知此乐，迥与世人殊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24369,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送杨秘丞通判扬州","author":"司马光","text":"苦闻小杜说扬都，当昔豪华今在无。\n江势横来控南楚，地形前不瞰东吴。\n万商落日船交尾，一市春风酒并垆。\n得意莫忘京国友，踏尘冲雪奉朝趋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24370,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送沈寺丞知南昌县","author":"司马光","text":"长江湛湛带枫林，古木寒云县寺深。\n老吏不能容狡狯，细民无复有冤侵。\n洪崖丹井闻犹在，徐孺衡门说可寻。\n宁复淹留如宝剑，更令牛斗气沈沈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24371,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送苏屯田知单州","author":"司马光","text":"佳郡望都城，相闻击柝声。\n宾朋才执别，耆旧已前迎。\n綵服当年戏，骊驹此日荣。\n弦歌应尽在，琴调不须更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24372,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送周寺丞畋知洛南","author":"司马光","text":"太华指商于，中间百里馀。\n稍行山驿远，渐与世尘疏。\n楚塞参差接，秦民错杂居。\n惜哉非綮肯，不足试投虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24373,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送昌言舍人得告还蜀三首 其三","author":"司马光","text":"富贵动归思，由来光里闾。\n戒门羞主父，负弩笑相如。\n外物有荣悴，中心无戚疏。\n遥知见亲旧，不改布衣初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24374,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送昌言舍人得告还蜀三首 其二","author":"司马光","text":"悽怆怀桑梓，劬劳咏蓼莪。\n树风今远矣，鼎食奈悲何。\n剑阁登车近，秦关屈指过。\n腾装才首路，夕梦已江沱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24375,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送昌言舍人得告还蜀三首 其一","author":"司马光","text":"迢递铜梁道，凝严青琐闱。\n负书当日去，鸣玉此时归。\n乡树迎朱毂，江花照锦衣。\n临邛不足并，荣耀古今稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24376,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送昌言知宿州","author":"司马光","text":"炜炜符离守，中流簇鼓旂。\n柳阴浓不断，舟势激如飞。\n魏阙行归奏，承明秪暂违。\n星轺晨夜度，尺素勿令稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24377,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送魏寺丞赴辟秦州判官","author":"司马光","text":"征西大府开，后乘得高才。\n区脱烽烟静，渠搜职贡来。\n陇云低玉帐，羌舞奉金罍。\n信美从军乐，脩梧茂帝台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24378,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送罗郎中管勾玉局观","author":"司马光","text":"官名为玉局，已与俗尘疏。\n钟出寒松迥，香疑古殿虚。\n乡闾非甚远，俸禄岂无馀。\n谁道神仙乐，神仙恐不如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24379,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送郑推官赴邠州 其三","author":"司马光","text":"骄虏已归计，圣朝方寝兵。\n时闻候火入，非复塞尘惊。\n秋岭无南牧，春田恣北耕。\n休穷西海路，辛苦学甘英。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24380,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送郑推官赴邠州 其二","author":"司马光","text":"百榼行春乐，千弓从猎豪。\n苦吟边月冷，飞镝野风高。\n奇策鞭殊俗，长缨系不毛。\n输君跃马贵，一等着青袍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24381,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送郑推官赴邠州 其一","author":"司马光","text":"形便豳公国，旌旗拥将坛。\n秦云低落日，塞树怯春寒。\n草檄无留思，投壶不废欢。\n还应笑黄卷，寂寂守儒官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24382,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送峡州陈廉秘丞 其三","author":"司马光","text":"地险三巴口，江流百折蟠。\n驺珂通峡响，门戟照秋寒。\n翠壁虎牙石，素花狼尾滩。\n孙刘置栅处，细为写图看。",