[{"title":"湖","author":"徐玑","text":"拾得柔条弄浅波，清风吹断采莲歌。\n又移小艇前汀去，莲叶稠时柳叶多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53236,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新春喜雨","author":"徐玑","text":"农家不厌一冬晴，岁事春来渐有形。\n昨夜新雷催好雨，蔬畦麦垄最先青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53237,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新秋","author":"徐玑","text":"新秋一雨洗林关，晚色清澄满望间。\n风静白云横不断，山前又叠一重山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53238,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新凉","author":"徐玑","text":"水满田畴稻叶齐，日光穿树晓烟低。\n黄莺也爱新凉好，飞过青山影里啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53239,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"漳州圆山","author":"徐玑","text":"轻烟漠漠雾绵绵，野色笼青傍屋前。\n尽说漳南风水好，众山围绕一山圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53240,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"酴醾","author":"徐玑","text":"丛丛扶重蕊，微风动弱枝。\n北人言语巧，唤作菊酴醾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53241,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题陈西老画蜀山图","author":"徐玑","text":"壁立青山带峡溪，閒云尽日自高低。\n知他春树深多少，应有清猿在里啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53242,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"一雨","author":"徐玑","text":"一雨郊原绿，高田水过低。\n荷锄烦稚子，馌亩伺良妻。\n老去知谁许，归欤得自犁。\n缓行溪上石，吟咏到鸦栖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53243,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十日","author":"徐玑","text":"十日清溪路，新春细雨天。\n绿波随棹起，白鸟望舟眠。\n麦秀初如草，云浓半是烟。\n明朝可遵陆，还忆此江边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53244,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"又寄","author":"徐玑","text":"庭深自无暑，苔径复萦纡。\n宾客不长到，儿童亦可娱。\n荷花晴带粉，蒲叶晓凝珠。\n与尔城闉隔，兹欢想不殊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53245,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"大龙湫","author":"徐玑","text":"瀑水数千尺，何曾贴石流。\n还疑众山坼，故使半空浮。\n雾雨初相乱，波涛忽自由。\n道场从建后，龙去任人游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53246,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居","author":"徐玑","text":"柳竹藏花坞，茅茨接草池。\n开门惊燕子，汲水得鱼儿。\n地僻春犹静，人闲日自迟。\n山禽啼忽住，飞起又相随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53247,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"不食姑","author":"徐玑","text":"惟诵天童咒，饮泉能不饥。\n只缘多自誉，翻以致人疑。\n赋质全如鹤，谋生却似龟。\n绿华通籍后，会报女仙知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53248,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中川别舍弟","author":"徐玑","text":"中川人语别，南国夜何其。\n江迥风来急，山低月落迟。\n缆从前浦远，角在古城吹。\n五亩耕锄地，何当手共治。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53249,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中秋集鲍楼作","author":"徐玑","text":"秋在湖楼正可过，扁舟窈窕逐菱歌。\n淡云遮月连天白，远水生凉入夜多。\n已是高人难会聚，矧逢佳节共吟哦。\n明朝此集喧城市，应说风流似永和。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53250,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书翁卷诗集后","author":"徐玑","text":"五字极难精，知君合有名。\n磨砻双鬓改，收拾一编成。\n泉落秋岩洁，花开野径清。\n渐多来学者，体法似元英。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53251,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"六月归途","author":"徐玑","text":"星明残照数峰晴，夜静惟闻水有声。\n六月行人须早起，一天凉露湿衣轻。\n宦情每向途中薄，诗句多于马上成。\n故里诸公应念我，稻花香里计归程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53252,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"壬戌二月","author":"徐玑","text":"山城二月景如何，行处时时听踏歌。\n淡色似黄杨叶小，浓香如蜜菜花多。\n春容每到晴时改，天气偏从雨后和。\n好向溪头寻钓侣，小溪连夕涨清波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53253,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬日书怀","author":"徐玑","text":"闲庭黄叶满，园树尽玲珑。\n寒水终朝碧，霜天向晚红。\n蔬餐如野寺，茅舍近溪翁。\n非是分嚣寂，由来趣不同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53254,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"亥月","author":"徐玑","text":"亥月霜澄霁，幽窗晚更明。\n文书随意阅，兰菊与心清。\n洗砚须池暖，燃香得火轻。\n妻孥浑笑我，作计亦平平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53255,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同友人乘舟","author":"徐玑","text":"泽国自秋凉，乘舟入渺茫。\n荷披沙渚碧，花乱暑风香。\n山色含疏雨，蝉声带夕阳。\n不知归路杳，相对有篇章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53256,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"年家生张主簿经过相寻率尔赠别","author":"徐玑","text":"上世喜同登，论交建水清。\n故人逢客里，明日又离情。\n佳阙东南少，卑官远近行。\n秋风分手地，霜叶满江城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53257,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵刘明远移家 其三","author":"徐玑","text":"躬耕儒者事，甘苦自能便。\n叩角吟山际，休锄坐竹边。\n长年多涉历，丰岁少忧煎。\n一一旧所好，知君能弃捐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53258,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵刘明远移家 其二","author":"徐玑","text":"恬淡安身易，新家似旧居。\n径凉行落叶，池净数游鱼。\n诗得唐人句，碑临晋代书。\n半生惟此乐，同辈必无如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53259,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵刘明远移家 其一","author":"徐玑","text":"隐居须是僻，君向数家村。\n自以闲为乐，何嫌贫尚存。\n碧波连草舍，白日掩柴门。\n挂得一瓢在，风来应恶喧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53260,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江亭临眺","author":"徐玑","text":"问得梅花信，寒林动晚声。\n雨来山渐远，潮去水还清。\n寥落寻新句，欢娱解宿酲。\n相携归路滑，灯火近孤城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53261,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自觉","author":"徐玑","text":"自觉中年后，惟能半夕眠。\n寒窗微带月，山郡远闻泉。\n行乐人同尚，迟留我未然。\n题书寄朋旧，归日是春边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53262,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西兴渡压雨赠同邸李计议","author":"徐玑","text":"客里遭多难，相逢意已降。\n酒殽同晚店，烟雨隔秋江。\n许国心犹壮，论兵世少双。\n将门寻旧绩，应不记蓬窗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53263,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西征有寄翁赵徐三友","author":"徐玑","text":"穷冬逆旅身，薄宦此艰辛。\n渡水添愁思，看山忆故人。\n烟生村落晚，雨过竹松新。\n昨夜还乡梦，逢君苦未真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53264,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"访湖友","author":"徐玑","text":"城中日日望南湖，乞得閒来访隐居。\n渐有秋霖篱菊长，才无暑气渚莲疏。\n壁间古画多贤像，案上尘编半佛书。\n未见主人逢稚子，不通姓字独踟躇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53265,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏","author":"徐玑","text":"一雨临初夏，惊雷昨夜新。\n地晴烟冉冉，堤涨渌鳞鳞。\n兰麝销衣润，珊瑚净几尘。\n墙阴旧无竹，笋过谢东邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53266,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别赵汝鬯黄中","author":"徐玑","text":"古道难为友，相期一见中。\n但令心事合，不在语言同。\n秋早湘烟白，舟移岸蓼红。\n别怀如迥野，长与水云通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53267,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寿权漕大卿 其二","author":"徐玑","text":"接物温温笑满眉，步趋登降亦委蛇。\n非关饰貌邀人誉，祇是存心不自欺。\n王导果能恢德业，谢公端可镇浇漓。\n圣明天子崇恭俭，合向中朝正羽仪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53268,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀素台","author":"徐玑","text":"不识张颠面，画成钗股艰。\n长存昔年宅，犹塑醉时颜。\n笔与身同葬，池荒墨似斑。\n才清人必重，潇岸野云间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53269,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"投周益公","author":"徐玑","text":"辞相还家后，清癯带少颜。\n便令凡事足，不似一身闲。\n长日惟开卷，晴天偶看山。\n只应忧国念，到此或相关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53270,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"时鱼","author":"徐玑","text":"风晴霜气合，沙渚夜鸣榔。\n独喜鳞兼细，时看寸有长。\n月斜寒动影，水碧静传香。\n可爱渔翁乐，溪梅次第芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53271,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"灵峰寺洞","author":"徐玑","text":"洞在寺之右，昔存罗汉踪。\n石峰排似笋，山势裂因龙。\n自有泉甘美，无愁路叠重。\n圣灯云照夜，宿客间曾逢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53272,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"净光山四首 其三 会景轩","author":"徐玑","text":"屋自与山背，西原景最清。\n凉风从下起，新月向前明。\n林静闻僧语，田虚见鹭行。\n此方多积翠，略似镇南城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53273,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"净光山四首 其二 绝境亭","author":"徐玑","text":"行向最高处，惟将物色参。\n郡城依薮泽，地势转东南。\n对景身垂老，题诗兴欲酣。\n可能清晓出，四面有晴岚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53274,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"净光山四首 其四 茶山堂","author":"徐玑","text":"山是朝廷赐，名从古昔传。\n为堂居此地，汲水记前贤。\n雨露馀根在，荆榛细蔓缘。\n困来求一盏，打坐亦安禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53275,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"净光山四首 其一 宿觉庵","author":"徐玑","text":"欲问庵中事，无论后与先。\n还因一宿觉，不用再参禅。\n门远青山曲，檐依古木边。\n谁当秋夜静，来看月孤圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53276,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"净名寺","author":"徐玑","text":"万法先除病，谁能识病多。\n因来净名寺，认得老维摩。\n海水峰前听，秋山雨后过。\n提刑旧题句，韵调复如何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53277,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"凭高","author":"徐玑","text":"凭高散幽策，绿草满春坡。\n楚野无林木，湘山似水波。\n客怀随地改，诗思出门多。\n尚有溪西寺，斜阳未得过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53278,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉酬翁松庐见寄","author":"徐玑","text":"客路归时雨似烟，归来还近菊花天。\n寸心不到青云上，一事难成白发前。\n风外松声如昨夕，竹间梅蕊接新年。\n閒来得句频相送，自有高人住屋边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53279,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"孤坐","author":"徐玑","text":"晨起犹孤坐，瓶泉待煮茶。\n寒烟添竹色，疏雪乱梅花。\n独喜忘时事，谁知改岁华。\n多君能过此，人里似山家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53280,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岳麓书院","author":"徐玑","text":"屋舍如庠序，读书兼教文。\n来兹望南岳，青似一重云。\n步绕丛山小，城看隔水分。\n欲知巡狩事，野老间能云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53281,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泊马公岭","author":"徐玑","text":"维舟拂晓步平沙，晚泊云根第一家。\n新取菜蔬沾野露，旋编篱落带山花。\n门前相对青峰小，屋后流来白水斜。\n可爱山翁无一事，藤墙西畔看蜂衙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53282,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨中","author":"徐玑","text":"雨来连几夕，满涨一湖波。\n苦似前时少，毋嫌此日多。\n砌荒蜗出舍，屋漏燕移窠。\n今岁翻成稔，田塍亦产禾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53283,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日晚望","author":"徐玑","text":"楼上看春晚，烟分远近村。\n晓晴千树绿，新雨半池浑。\n柳密莺无影，泥新燕有痕。\n轻寒衫袖薄，杯酌更须温。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53284,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夕怀赵师秀","author":"徐玑","text":"冷落生愁思，衰怀得句稀。\n如何秋夜雨，不念故人归。\n蛩响砌尤静，云疏月尚微。\n惟怜篱下菊，渐渐可相依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53285,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋日登玉峰","author":"徐玑","text":"玉琢孤峰压富沙，人行峰顶步云霞。\n溪流缓去几回曲，树色幽分无数家。\n翠拂寒烟平似水，红飘霜叶远如花。\n明朝重向城中望，对此孤峰应不差。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53286,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送刘明远客和州 其二","author":"徐玑","text":"十载知心友，文才尔独兼。\n病谙孤寝乐，贫识茹蔬甜。\n冬暖梅花早，年丰酒价廉。\n不愁无远信，佳句日应添。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53287,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送刘明远客和州 其一","author":"徐玑","text":"边郡三年守，知陪后乘安。\n远游登览易，老大别离难。\n红日千峰晓，清霜几树丹。\n江皋一回首，念尔去凌寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53288,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送华亭薛运干","author":"徐玑","text":"三任来得禄，兹行亦是缘。\n地宜惟有鹤，清职但看船。\n浙水通清海，吴门隔远烟。\n别离春欲半，草色正芊芊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53289,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送朱学谕游建上赴陈提举约","author":"徐玑","text":"星郎复持节，垂榻待君来。\n又醉闽溪酒，因沾谢屐苔。\n天寒松子落，腊月茗花开。\n白发伤离绪，何堪节物催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53290,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送宋省元教授吉州","author":"徐玑","text":"州名因水得，此地昔曾游。\n自有欧公宅，常多儒者流。\n野花开别岸，春色在行舟。\n勉就诗书教，名高不用求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53291,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送单丙文先生归沅州","author":"徐玑","text":"传得临池诀，勤劳敢遽忘。\n锥沙惟是正，舞剑本非狂。\n旧隐寻芳芷，离怀对碧湘。\n寸心长记面，不似隔他乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53292,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送岳州蒋节推","author":"徐玑","text":"湘水知几派，到湖相合流。\n烟深云梦晓，风静岳阳秋。\n送子方行役，令予忆旧游。\n文书时正省，赋咏可登楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53293,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送赵灵秀赴筠州幕予亦将之湖外","author":"徐玑","text":"郡以竹为名，因知此地清。\n溪来城下绿，山到市边平。\n入幕非无客，能文必有声。\n江湖共游宦，相望若为情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53294,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送赵明叔为漳浦宰","author":"徐玑","text":"去年官满处，送子意何如。\n地接泉山近，人依大泽居。\n南中繁赋役，美政辑田庐。\n公退无他事，弹琴更读书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53295,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送徐侍郎南迁","author":"徐玑","text":"已见皇家日月安，更教远去不辞艰。\n若人岂谓元城在，有客先知御史还。\n风急满江皆白浪，雨收何处不青山。\n天心正欲扶宗社，为报慈闱得解颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53296,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送徐照先回江西","author":"徐玑","text":"骨体先如鹤，离家岁已周。\n欲知诗思远，曾共楚乡游。\n穷达身将老，分携菊正秋。\n江西看旧友，归计少迟留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53297,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送徐照还旧山 其一","author":"徐玑","text":"城闉多汩没，宜尔向村居。\n蔬茹餐僧饭，香茶读古书。\n秋潮侵岸满，晓月带星疏。\n相送未相忆，相期同荷锄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53298,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送徐照还旧山 其二","author":"徐玑","text":"役役劳形器，乾坤一转蓬。\n暗因凡虑汩，明为此心空。\n小舍依沙渚，扁舟系荻丛。\n且能渔钓乐，亦似古人风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53299,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送翁巴陵之官","author":"徐玑","text":"好去巴陵县，神仙屡此过。\n但知存惠爱，自足感弦歌。\n官况湘流碧，诗情楚岫多。\n梅花送征棹，万里接阳和。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53300,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送翁灵舒游边","author":"徐玑","text":"子向江淮去，应怀计策新。\n但须先审己，然后可图人。\n战野寒犹力，边城草不春。\n曹刘若无竞，闲却卧龙身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53301,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送瑞州张知录","author":"徐玑","text":"岁暮不惜别，君行是宦游。\n江西多野水，湖上正高秋。\n旧友曾过处，新题必共留。\n官閒可寻访，竹径最深幽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53302,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送戴文子赴定海主簿","author":"徐玑","text":"江天经雨后，秋意转新高。\n远棹送行客，凉飔生细涛。\n高人初禄仕，判语亦风骚。\n若到海西岸，佛光盈翠袍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53303,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏日","author":"徐玑","text":"书困当檐立，微风动鬓毛。\n桐阴遮井暗，莺语出林高。\n执热思时雨，如疲得美醪。\n居然吟思起，独步几周遭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53304,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏日怀友","author":"徐玑","text":"流水阶除静，孤眠得自由。\n月生林欲晓，雨过夜如秋。\n远忆荷花浦，谁吟杜若洲。\n良宵恐无梦，有梦即俱游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53305,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏日湖上访隐士","author":"徐玑","text":"烦暑何能避，孤舟访隐人。\n水乡菱藕熟，晴野稻苗新。\n为学师前辈，谈空悟宿身。\n镜湖三百顷，不似此湖滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53306,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]