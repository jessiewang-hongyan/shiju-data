[{"title":"章献明肃皇太后恭谢太庙 其十五","author":"郊庙朝会歌辞","text":"九奏合兮僾然来，百礼成兮欻尔回。\n想霜驭兮望天阙，八音阕兮心悠哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1786,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夕月十首 送神用《理安》。","author":"郊庙朝会歌辞","text":"歌奏云阕，式礼莫愆。\n以我齐明，罄其吉蠲。\n神保聿归，降康自天。\n萝图永固，亿万斯年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1787,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夕月十首 亚、终献用《文安》。","author":"郊庙朝会歌辞","text":"肃雍严祀，圣治昭彰。\n清酒既载，或肆或将。\n礼匝三献，终然允臧。\n神具醉止，其乐且康。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1788,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夕月十首 酌献用《嘉安》。","author":"郊庙朝会歌辞","text":"白藏在序，享惟其时。\n躬即明坛，礼惟载祗。\n斟以瑶爵，神灵燕娭。\n歆馨顾德，锡我蕃釐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1789,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夕月十首 奉俎用《丰安》。","author":"郊庙朝会歌辞","text":"谷旦其差，有牲在涤。\n工祝致告，为俎孔硕。\n肸蚃是期，祚我明德。\n备兹孝钦，式和民则。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1790,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夕月十首 奠玉币用《嘉安》。","author":"郊庙朝会歌辞","text":"少采陈仪，实曰坎祭。\n礼备乐举，严恭将事。\n于以奠之，嘉玉量币。\n神兮昭受，阴骘万汇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1791,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夕月十首 升殿用《正安》。","author":"郊庙朝会歌辞","text":"猗欤崇基，右平左墄。\n祗率典常，届兹秋夕。\n陟降惟寅，威仪抑抑。\n神其鉴观，穰简是集。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1792,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夕月十首 其四 降神用《高安》。","author":"郊庙朝会歌辞","text":"穆穆流辉，太阴之精。\n盈亏靡忒，寒暑以均。\n克禋克祀，揆日涓辰。\n牲硕酒旨，来燕来宁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1793,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夕月十首 其三 降神用《高安》。","author":"郊庙朝会歌辞","text":"溯日著明，丽天作配。\n洁诚以祠，礼行肃拜。\n光凝冕服，气肃环佩。\n庶几昭格，祗而不懈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1794,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夕月十首 其二 降神用《高安》。","author":"郊庙朝会歌辞","text":"时维秋仲，夜寂天清。\n实严姊事，用答阴灵。\n坛壝斯设，黍稷惟馨。\n云车来下，庶歆厥诚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1795,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夕月十首 其一 降神用《高安》。","author":"郊庙朝会歌辞","text":"金行告遒，玉律分秋。\n礼蒇西郊，毖祀聿修。\n精意潜达，永孚于休。\n神之听之，爰格飙斿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1796,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夕月三首 其三 送神用《高安》。","author":"郊庙朝会歌辞","text":"夙陈笾豆，洁诚致祈。\n垂休保佑，景祚巍巍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1797,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夕月三首 其一 降神用《高安》。六变。","author":"郊庙朝会歌辞","text":"凝阴禀粹，照临八埏。\n丽天垂象，继日代明。\n一气资始，四时运行。\n灵祇昭格，备物荐诚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1798,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大中祥符五岳加帝号祭告八首 其八 送神用《静安》。","author":"郊庙朝会歌辞","text":"祗荐鸿名，寅威明祀。\n有楚之仪，如在之祭。\n奠献既终，礼容克备。\n神鉴孔昭，福禧来暨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1799,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大中祥符五岳加帝号祭告八首 其七 中岳。","author":"郊庙朝会歌辞","text":"岩岩神岳，作镇中央。\n肃奉徽册，尊名孔章。\n聿降飙驾，载献兰觞。\n熙事允洽，宝祚弥昌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1800,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大中祥符五岳加帝号祭告八首 其六 北岳。","author":"郊庙朝会歌辞","text":"仰止灵岳，镇于朔方。\n增崇懿号，度越彝章。\n祗荐嘉乐，式陈令芳。\n永资纯佑，国祚蕃昌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1801,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大中祥符五岳加帝号祭告八首 其五 西岳。","author":"郊庙朝会歌辞","text":"瞻言太华，奠方作镇。\n典册是膺，等威以峻。\n上公奉仪，祀宗荐信。\n介祉万邦，永配坤顺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1802,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大中祥符五岳加帝号祭告八首 其四 南岳。","author":"郊庙朝会歌辞","text":"作镇炎夏，畜兹灵光。\n敷与万物，既阜既昌。\n爰刻温玉，式荐徽章。\n昭嘏神意，福熙穰穰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1803,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大中祥符五岳加帝号祭告八首 其三 酌献东岳用《嘉安》。","author":"郊庙朝会歌辞","text":"节彼岱宗，有严庙貌。\n惟辟奉天，依神设教。\n帝典焜煌，嘉荐普淖。\n至灵格思，殊祥是效。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1804,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大中祥符五岳加帝号祭告八首 其二 册入门用《正安》。","author":"郊庙朝会歌辞","text":"节彼乔岳，神明之府。\n秩秩威仪，肃肃灵宇。\n懿号克崇，庶物咸睹。\n帝籍升名，式绥九土。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1805,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大中祥符五岳加帝号祭告八首 其一 迎神用《静安》。","author":"郊庙朝会歌辞","text":"钟石既作，俎豆在前。\n云旗飞扬，神光肃然。\n当驾飙欻，来乎青圆。\n言备缛礼，享兹吉蠲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1806,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大观三年释奠六首 其六 送神用《凝安》。","author":"郊庙朝会歌辞","text":"肃庄绅緌，吉蠲牲牺。\n于皇明祀，荐登惟时。\n神之来兮，肸蚃之随。\n神之去兮，休嘉之贻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1807,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大观三年释奠六首 其五 配位酌献用《成安》。","author":"郊庙朝会歌辞","text":"俨然冠缨，崇然庙庭。\n百王承祀，涓辰惟丁。\n于牲于醑，其从予享。\n与圣为徒，其德不爽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1808,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大观三年释奠六首 其四 酌献用《成安》。","author":"郊庙朝会歌辞","text":"道德渊源，斯文之宗。\n功名糠秕，素王之风。\n硕兮斯牲，芬兮斯酒。\n绥我无疆，与天为久。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1809,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大观三年释奠六首 其三 奠币用《明安》。","author":"郊庙朝会歌辞","text":"于论鼓钟，于兹西雍。\n粢盛肥硕，有显其容。\n其容洋洋，咸瞻像设。\n币以达诚，歆我明洁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1810,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大观三年释奠六首 其二 升降用《同安》。","author":"郊庙朝会歌辞","text":"生民以来，道莫与京。\n温良恭俭，惟神惟明。\n我洁尊罍，陈兹芹藻。\n言升言旋，式崇斯教。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1811,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大观三年释奠六首 其一 迎神用《凝安》。","author":"郊庙朝会歌辞","text":"仰之弥高，钻之弥坚。\n于昭斯文，被于万年。\n峨峨胶庠，神其来止。\n思款无穷，敢忘于始。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1812,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大观祀社稷九首 送神用《宁安》。","author":"郊庙朝会歌辞","text":"尊罍芬香，威仪肃雍。\n灵心嘉止，洋洋交通。\n神归降禧，年斯屡丰。\n仓箱千万，慰予三农。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1813,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大观祀社稷九首 亚、终献用《文安》。","author":"郊庙朝会歌辞","text":"荐嘉亶时，洋洋来格。\n载登兹坛，齐明维敕。\n神用居歆，顺成农穑。\n其崇若墉，其比如栉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1814,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大观祀社稷九首 酌献用《嘉安》。","author":"郊庙朝会歌辞","text":"坤元生物，功利相宣。\n蠲兹祀事，美报致虔。\n清酤芬如，灵坛岿然。\n酌尊奠觞，神其格焉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1815,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大观祀社稷九首 奠币用《嘉安》。","author":"郊庙朝会歌辞","text":"于嘻阴祀，封土惟崇。\n于时之吉，歆予鼓钟。\n柔静化光，人赖其功。\n陈兹量币，百货是隆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1816,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大观祀社稷九首 初献升降用《正安》。","author":"郊庙朝会歌辞","text":"崇崇广坛，严恭祀事。\n威仪孔时，周旋进止。\n锵若环佩，诚通于幽。\n相于农植，邦其咸休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1817,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大观祀社稷九首 其四 迎神用《宁安》。","author":"郊庙朝会歌辞","text":"笾豆斯陈，三牲告幽。\n报本之礼，答神之休。\n来歆芬香，丰登于秋。\n仓箱千万，治符成周。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1818,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大观祀社稷九首 其三 迎神用《宁安》。","author":"郊庙朝会歌辞","text":"猗欤那欤，生养斯民。\n家给人足，时底熙纯。\n祗严明禋，于荐苾芬。\n粢盛丰洁，神乃有闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1819,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大观祀社稷九首 其二 迎神用《宁安》。","author":"郊庙朝会歌辞","text":"惟谷之神，函育无穷。\n百嘉蕃殖，民依厥功。\n严饬坛壝，威仪肃雍。\n神之来享，祈于登丰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1820,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大观祀社稷九首 其一 迎神用《宁安》。","author":"郊庙朝会歌辞","text":"惟土之尊，民食资焉。\n阴祀昭格，牲牢腥膻。\n有功于民，告其吉蠲。\n神之来享，云车翩翩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1821,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大观祀武成王一首 酌献用《成安》。","author":"郊庙朝会歌辞","text":"凉彼周王，君臣相遇。\n终谋其成，诸侯来许。\n洋洋神灵，尊载酒醑。\n新声为侑，笙箫备举。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1822,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大观宗祀明堂五首 酌献用《孝安》。","author":"郊庙朝会歌辞","text":"若昔大猷，孝思维则。\n永言孝思，丕承其德。\n于昭明威，侑于上帝。\n赉我思成，永绥福祉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1823,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大观宗祀明堂五首 配位奠币用《信安》。","author":"郊庙朝会歌辞","text":"肇祀明堂，告成大报。\n颙颙祗祗，率见昭考。\n涓选休辰，齐明朝夕。\n于惟皇王，孝思罔极。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1824,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大观宗祀明堂五首 其二 奠玉币用《镇安》。","author":"郊庙朝会歌辞","text":"有邦事神，享帝为尊。\n内心致德，外示弥文。\n嘉玉效珍，荐以量币。\n恭钦伊何，惟以宗祀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1825,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大观宗祀明堂五首 其一 奠玉币用《镇安》。","author":"郊庙朝会歌辞","text":"交于神明，内心为贵。\n外致其文，亦效精意。\n嘉玉既陈，将以量币。\n肃肃雍雍，惟帝之对。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1826,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大观秋分夕月四首 其四 送神。","author":"郊庙朝会歌辞","text":"四扉大开，五云车立。\n霓裾娣从，风翿童执。\n摇曳胥来，锵洋爰集。\n歆我严禋，西面以揖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1827,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大观秋分夕月四首 其三 酌献。","author":"郊庙朝会歌辞","text":"名稽汉仪，歌参唐宗。\n往于卿少，乘秋气中。\n周天而行，如姊之崇。\n可飞霞佩，下琉璃宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1828,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大观秋分夕月四首 其二 奠玉币。","author":"郊庙朝会歌辞","text":"玉钩初弯，冰盘乍圆。\n扇掩秋后，乌飞枝边。\n精凝蟾蜍，辉光婵娟。\n歆于明祀，弭芳节焉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1829,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大观秋分夕月四首 其一 降神用《高安》。","author":"郊庙朝会歌辞","text":"至阴之精，亏而复盈。\n轮高仙桂，阶应祥蓂。\n玉兔影孤，金茎露溢。\n其驾星车，顾于兹夕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1830,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大观闻喜宴六首 其六","author":"郊庙朝会歌辞","text":"思皇多士，扬于王庭。\n钟鼓乐之，肃雍和鸣。\n威仪抑抑，既安且宁。\n天子万寿，永观厥成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1831,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大观闻喜宴六首 其五","author":"郊庙朝会歌辞","text":"我求懿德，烝然来思。\n笾豆静嘉，式燕绥之。\n温温其恭，莫不令仪。\n追琢其章，髦士攸宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1832,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大观闻喜宴六首 其四","author":"郊庙朝会歌辞","text":"圣谟洋洋，纲纪四方。\n烝我髦士，观国之光。\n遐不作人，而邦其昌。\n以燕天子，万寿无疆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1833,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大观闻喜宴六首 其三","author":"郊庙朝会歌辞","text":"乐只君子，式燕又思。\n服其命服，摄以威仪。\n钟鼓既设，一朝酬之。\n德音是茂，邦家之基。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1834,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大观闻喜宴六首 其二","author":"郊庙朝会歌辞","text":"明明天子，率由旧章。\n思乐泮水，光于四方。\n薄采其芹，用宾于王。\n我有好爵，寘彼周行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1835,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大观闻喜宴六首 其一","author":"郊庙朝会歌辞","text":"多士济济，于彼西雍。\n钦肃威仪，亦有斯容。\n烝然来思，自西自东。\n天畀尔禄，惟王其崇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1836,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大观祭风师六首 其六 送神用《欣安》。","author":"郊庙朝会歌辞","text":"窈冥无穷，肸蚃斯融。\n来终嘉荐，归返遥空。\n惟神之归，欣安导和。\n惟神之泽，于彼滂沱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1837,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大观祭风师六首 其五 亚、终献用《雍安》。","author":"郊庙朝会歌辞","text":"清酤洋洋，虔恭注兹。\n条鬯敷宣，神用歆之。\n尊罍静嘉，金奏谐熙。\n于皇肆祀，休我群黎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1838,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大观祭风师六首 其四 酌献用《雍安》。","author":"郊庙朝会歌辞","text":"牺尊斯陈，清酤盈中。\n芬芬苾苾，馨香交通。\n明灵来思，歆我精衷。\n维千万祀，品物芃芃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1839,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大观祭风师六首 其三 奠币用《容安》。","author":"郊庙朝会歌辞","text":"吹嘘于喁，披拂氤氲。\n众窍咸作，潜运化钧。\n恩大功丰，酬神维恭。\n嘉赠盈箱，于物有容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1840,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大观祭风师六首 其二 初献升降用《钦安》。","author":"郊庙朝会歌辞","text":"明昭惟馨，威仪孔时。\n锵锵鸣佩，钦荐牲牺。\n惟恭惟祗，无愆无违。\n周旋中礼，肃恭委蛇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1841,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大观祭风师六首 其一 降神用《欣安》。","author":"郊庙朝会歌辞","text":"羽旗云车，飘飖自天。\n猗欤南箕，歆嘉升烟。\n牲饩粢盛，俎簋铏笾。\n维神戾止，从空泠然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1842,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大观蜡祭二首 其二 南郊升降用《穆安》。","author":"郊庙朝会歌辞","text":"穆如薰风，敷舒文藻。\n气蒸消除，丰予黍稻。\n神之听之，钟鼓咸考。\n于万斯年，惟皇之报。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1843,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大观蜡祭二首 其一 东郊亚、终献用《庆安》。","author":"郊庙朝会歌辞","text":"震乘春阳，仁司生殖。\n锡我岁丰，襄我民力。\n谁其尸之，宗子先啬。\n亿万斯年，怀神罔极。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1844,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大晟府拟撰释奠十四首 送神用《凝安》。","author":"郊庙朝会歌辞","text":"有严学宫，四方来宗。\n恪恭祀事，威仪雍雍。\n歆兹惟馨，飙驭旋复。\n明禋斯毕，咸膺百福。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1845,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"景祐祭文宣王庙六首 饮福用《绥安》。","author":"郊庙朝会歌辞","text":"牺象在前，豆笾在列。\n以享以荐，既芬既洁。\n礼成乐备，人和神悦。\n祭则受福，率遵无越。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1846,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大晟府拟撰释奠十四首 亚、终献用《文安》。","author":"郊庙朝会歌辞","text":"百王宗师，生民物轨。\n瞻之洋洋，神其宁止。\n酌彼金罍，惟清且旨。\n登献惟三，于嘻成礼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1847,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大晟府拟撰释奠十四首 邹国公位酌献用《成安》。","author":"郊庙朝会歌辞","text":"道之由兴，于皇宣圣。\n惟公之传，人知趋正。\n与飨在堂，情文实称。\n万年承休，假哉天命。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1848,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大晟府拟撰释奠十四首 兖国公位酌献用《成安》。","author":"郊庙朝会歌辞","text":"庶几屡空，渊源深矣。\n亚圣宣猷，百世宜祀。\n吉蠲斯辰，昭陈尊簋。\n旨酒欣欣，神其来止。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1849,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大晟府拟撰释奠十四首 文宣王位酌献用《成安》。","author":"郊庙朝会歌辞","text":"大哉圣王，实天生德。\n作乐以崇，时祀无斁。\n清酤惟馨，嘉牲孔硕。\n荐羞神明，庶几昭格。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1850,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大晟府拟撰释奠十四首 奉俎用《丰安》。","author":"郊庙朝会歌辞","text":"道同乎天，人伦之至。\n有飨无穷，其兴万世。\n既洁斯牲，粢明醑旨。\n不懈以忱，神之来暨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1851,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大晟府拟撰释奠十四首 奠币用《明安》。","author":"郊庙朝会歌辞","text":"自生民来，谁底其盛。\n惟王神明，度越前圣。\n粢币具成，礼容斯称。\n黍稷非馨，惟神之听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1852,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大晟府拟撰释奠十四首 升殿用《同安》。","author":"郊庙朝会歌辞","text":"诞兴斯文，经天纬地。\n功加于民，实千万世。\n笙镛和鸣，粢盛丰备。\n肃肃降登，歆兹秩祀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1853,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]