[{"title":"自和 其二","author":"叶茵","text":"一雁云间落劲弧，经秋不见寄来书。\n人情自昔如翻纸，世道从今甚借锄。\n鹿梦隍中知得丧，爵罗门外看亲疏。\n岁寒独有梅花月，香影年年到户除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22917,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山行","author":"叶茵","text":"未了行春债，因哦遣兴诗。\n寒多啼鸟噤，路滑蹇驴迟。\n久雨红辞树，深林绿授枝。\n惊心衰朽日，容易过花时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22918,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山行","author":"叶茵","text":"舍棹入山村，山深树自繁。\n短歌田舍乐，长揖野人尊。\n苔老云生石，松高月闯门。\n不闻名利语，太古一乾坤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22919,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元夕","author":"叶茵","text":"梦想传柑宴，村醪可试沽。\n谩酬元夕尔，不复去年吾。\n旧事思清汴，幽情卜紫姑。\n六分春已一，秉烛步通衢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22920,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"友人见借放翁绝笔","author":"叶茵","text":"放翁今已矣，犹有未刊诗。\n阅稿无三豕，还书欠一鸱。\n听儿弦诵罢，留客笑谈时。\n发越吟边思，心香答所知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22921,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"友人自淮至","author":"叶茵","text":"别子若为久，于心终不忘。\n一杯评旧雨，两鬓对新霜。\n客里春行早，愁边夜坐长。\n明时成摈弃，无语及淮乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22922,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"天平山谒范文正祠登白云亭","author":"叶茵","text":"为谒先儒马鬣茔，倚藤得得上天平。\n直疑寺外崚嶒石，犹是胸中数万兵。\n松障四开心目快，山泉一歃骨毛清。\n坐间恰动思亲念，隐隐白云何处生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22923,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"天童山","author":"叶茵","text":"著足万松关，东州第一山。\n听泉穷地脉，历栈近天颜。\n奎画疏烟外，钟声远树间。\n衲翁曾有约，分我片时閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22924,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"忆友","author":"叶茵","text":"萧萧檐角雨，冉冉雨中舟。\n年老难于别，春寒重却愁。\n风窗乱书叶，尘壁暗灯篝。\n夜半无来雁，披衣对小楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22925,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"忆弟","author":"叶茵","text":"支藤来海峤，骨肉海西边。\n对月成千里，举头同一天。\n更沈寒戍角，歌急晚潮船。\n孤雁商予意，声声落枕前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22926,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水天一色亭上即事 其二","author":"叶茵","text":"得得寻幽到水天，开樽洗勺动庖烟。\n败欢红袖翻棋局，惯客乌衣拂坐边。\n好景自应分半席，雅歌政不欠繁弦。\n黄昏未忍轻归去，长笛一声何处船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22927,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水天一色亭上即事 其一","author":"叶茵","text":"芰荷深处小壶天，时见征帆破晚烟。\n非主非宾和气里，似晴似雨绿阴边。\n凭阑笑语惊鱼鸟，信步游行废管弦。\n剩喜利名尘不到，持竿柳下问渔船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22928,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出郊","author":"叶茵","text":"多谢天公佐好晴，只今载酒作郊行。\n飞花恋客閒中意，远笛吟春景外声。\n已把物情归幻相，且将足力趁浮生。\n南堂办得休休计，燕雀充庭亦贺成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22929,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出城","author":"叶茵","text":"清晓出江城，波平觉棹轻。\n烟荷学人老，风柳作秋声。\n岁稔时无事，心和物有情。\n客来慵与语，苦苦问功名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22930,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"北窗","author":"叶茵","text":"八面玲珑静向阴，静中时现定中身。\n解传佛祖从前意，便是羲皇向上人。\n背日一檐浑不暑，依山百卉若为春。\n未逢惠远相招致，厌杀浮生有劫尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22931,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"半塘寺","author":"叶茵","text":"寺枕彩云桥，残碑纪晋朝。\n地平垂塔影，林古镇塘腰。\n夜月松千阜，春风柳万条。\n景多僧住少，近觉有尘嚣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22932,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"幼弟墓下","author":"叶茵","text":"春到棣无色，风来松亦悲。\n细看云起处，不复雁归时。\n忆汝九京隔，嗟予两鬓衰。\n寥寥今古意，独许杜陵知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22933,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"生日对梅口占","author":"叶茵","text":"一生已得半生閒，出入诗篇酒盏间。\n祗把小儿看造化，不妨老子号痴顽。\n幻身且喜无诸恙，灵药谁能觅大还。\n多谢梅花来荐寿，年年雪里破春颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22934,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"多景楼","author":"叶茵","text":"北望中原惨莫烟，楼头风物故依然。\n后人拍得阑干碎，往日轻教眼界偏。\n水撼金焦声亦怒，云连楚泗势犹全。\n壮怀且付生前酒，千古英雄冢道边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22935,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"扫榻","author":"叶茵","text":"扫榻卧终日，香销百念除。\n不愁浑厌酒，无事剩钞书。\n粉浅庭前笋，青齐雨后蔬。\n自嫌犹有累，添水种金鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22936,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次中秋不见月韵","author":"叶茵","text":"五分秋色到银河，应是蟾蜍浴细波。\n握手相期千里共，举头无柰片云何。\n愁边幸自逢欢伯，清处何须著艳娥。\n未可来宵倦游赏，光辉依旧向人多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22937,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次王竹斋韵","author":"叶茵","text":"忘身忘世老方回，适处从教节物催。\n几日吟情为热恼，一天生意趁凉来。\n屋边花竹时时好，水外轩窗面面开。\n独有此君同此趣，百年事业两三杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22938,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次吊原韵","author":"叶茵","text":"为怜举世不曾醒，放浪形骸泽畔行。\n会得危言危行意，佐成濯足濯缨名。\n义无可去缘同姓，心亦何求要独清。\n今日龙舟虽古意，吴人未必楚人情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22939,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次守岁韵","author":"叶茵","text":"爆竹散千灾，从今事事谐。\n五辛空䬦饤，六甲已安排。\n井贮屠苏药，庭辉榾柮柴。\n谩教添一岁，依旧好情怀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22940,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次池亭韵","author":"叶茵","text":"凭虚结草亭，占得古来清。\n睡债茶驱遣，诗情酒发明。\n梅撑拳石瘦，芦障一阑平。\n未尽逍遥意，重寻枕簟盟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22941,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次吴菊潭八月十四夜韵二首 其二","author":"叶茵","text":"月过市无声，令人毛发清。\n连村三鼓急，隔水一灯明。\n琢句醉时语，簪花老后情。\n凭栏发长啸，不管卧龙惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22942,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次吴菊潭八月十四夜韵二首 其一","author":"叶茵","text":"来夕九秋半，月同心迹清。\n已知千里共，祇欠一分明。\n流水往来影，幽人今古情。\n撞钟先得句，尘世不须惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22943,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次林和靖先生梅韵","author":"叶茵","text":"世上群芳未敢妍，独将春色占南园。\n生来清质十分瘦，肯受红尘一点昏。\n东阁诗成应动兴，西湖仙去谩招魂。\n便须结客陪花笑，句引幽香入酒尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22944,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次游十洲之一亭韵","author":"叶茵","text":"抵掌论文酒易酣，岸巾风外鬓䰐鬖。\n十洲所有今之一，七步而成尔乃三。\n桥压平堤波捲绿，烟封远沚草舒蓝。\n閒边得侣评佳境，留与他时作美谈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22945,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次赋顺适堂韵","author":"叶茵","text":"万卷藏书抵万金，翛然轩宇绝尘侵。\n顺时不作荣枯想，适意元无胜负心。\n蒲石疏帘真道院，柏香净几小丛林。\n四时剩有閒风月，醒里寻题醉里吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22946,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次禊帖韵","author":"叶茵","text":"梅花旧刻字将磨，勘辨其如病眼何。\n千载鼠须遗墨少，一时赝本误人多。\n肯将金谷序文比，因想山阴气候和。\n最喜孤居山下姥，慕名特特为烹鹅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22947,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵","author":"叶茵","text":"举世一枰棋，谁能著著奇。\n懒皆安乐法，醉即太平时。\n梅雨飞不断，茶烟凝欲垂。\n吟诗为无事，多事又因诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22948,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵","author":"叶茵","text":"时清叹陆沈，楚泽伴渔吟。\n探索圣贤语，发明天地心。\n无机棋少著，有趣树多阴。\n坐上皆知己，赓酬夜向深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22949,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵","author":"叶茵","text":"疏窗小博山，窗外鸟关关。\n占得江湖隐，佐成天地閒。\n檐牙丛筱碧，墙隙两鸠斑。\n痴坐不知晚，渔篷捲钓还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22950,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵","author":"叶茵","text":"看月过天中，贪幽臭味同。\n竹光延野碧，灯影染窗红。\n听客谈时务，呼儿诵国风。\n还思浮世事，到底是匆匆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22951,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵","author":"叶茵","text":"鬓边惊雪点，腰下欠金围。\n已绝功名想，甘为耕钓归。\n浮生醒亦醉，往事是耶非。\n独有楼前景，年年霞鹜飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22952,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵","author":"叶茵","text":"童去鹤归迟，青山皓首期。\n池塘圆草梦，家世受梅知。\n拂石和云卧，分鱼换米炊。\n人生裁足耳，舍子更其谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22953,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵","author":"叶茵","text":"生涯老布衾，清处更清吟。\n旧事即新梦，今人非古心。\n意行双谢屐，道在一陶琴。\n谁解无名利，其中有浅深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22954,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵","author":"叶茵","text":"懒作千年调，偷閒得几回。\n吟坛元不峻，俗驾可曾来。\n藓碧墙阴合，榴红屋角开。\n枕肱真乐在，饮水当传杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22955,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵","author":"叶茵","text":"枯坐如僧欠钵单，年来梦不赴槐安。\n稀行种竹容风入，大字钞书就月看。\n为有故人同冷淡，非干明主弃孤寒。\n因閒悟得家山趣，堪笑世间行路难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22956,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵","author":"叶茵","text":"竹满园林水满沟，幽深地位度春秋。\n坐中不可无侯喜，歌处何须有莫愁。\n别墅帘栊风飐燕，远村籉笠雨耕牛。\n老来应物犹强健，多少壮年成梦休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22957,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵二首 其二","author":"叶茵","text":"难把来笺向后黏，载持珠玉傍风檐。\n吟根此性辞平易，学本于经意简严。\n未逊弥明联石鼎，还嗤韩渥赋香奁。\n阳春政不容人和，自听巴音亦自嫌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22958,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵二首 其一","author":"叶茵","text":"过墙新竹粉痕黏，蛙闹池塘燕掠檐。\n自喜江乡成懒散，从教世界要庄严。\n稻秧井井畦千纬，荷叶田田水一奁。\n心事太平风物好，与人无爱亦无嫌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22959,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵二首 其一","author":"叶茵","text":"几载江湖兄弟心，老夫吟了听君吟。\n休论聚散时难易，要识推敲意浅深。\n昼静床头便竹简，风清墙角度松琴。\n山灵应是驰山檄，知向孤山何处寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22960,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次月蚀韵","author":"叶茵","text":"起来搔首夜如何，瞥见虾蟆影里过。\n幸自十分悬素魄，岂应一息驻妖魔。\n光清于水尘难滓，色白如圭玷可磨。\n休诵玉川艰险句，终篇比兴为元和。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22961,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江湖伟观","author":"叶茵","text":"此地旧寒碧，留题护竹君。\n窗虚不碍月，壁老易生云。\n一水东西隔，两山南北分。\n未堪低著眼，世事正纷纷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22962,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"竹夫人","author":"叶茵","text":"风神林下秀，宠数梦中新。\n假使不如肉，争知见似人。\n茗奴甘谢事，黄妳喜论亲。\n凛凛百年操，从教进退频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22963,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自和 其一","author":"叶茵","text":"壮士须张燕角弧，男儿须诵圣人书。\n譬如田叟祈多稼，未有春时不荷锄。\n分内功名从早晚，腹中学问怕空疏。\n老夫犹记昌黎语，潢潦朝盈夕已除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22964,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自适","author":"叶茵","text":"澹薄野人心，难教著利名。\n重农田舍熟，省事世情生。\n石老旗枪叶，池喧鼓吹声。\n东风知此乐，飞絮荡新晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22965,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自释","author":"叶茵","text":"繁红妒紫绚前林，杖策来栖花下阴。\n休道游情难似昔，可能他日尚如今。\n乍晴涧曲萦流水，未晓庭皋调野禽。\n毕竟老天怜老子，幽閒断送一生心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22966,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自遣","author":"叶茵","text":"蚁梦功名觉即休，驹阴岁月去难留。\n伤今不复并三乐，拟古犹堪续四愁。\n松下抱琴尘外境，雨馀莳药柳边洲。\n老来莫问浮生事，醉后同为造物游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22967,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟中即事","author":"叶茵","text":"草舍密还稀，编篱枕钓矶。\n鸭群迎棹去，牛背晒衣归。\n风紧浪千叠，村深柳四围。\n倚樯无与语，数雁失斜晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22968,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟行次韵二首 其二","author":"叶茵","text":"河汉净如流，枯槎便可舟。\n掉头诸事懒，弹指半生休。\n撼竹风疑雨，依山屋当楼。\n此游情味好，应不待苛留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22969,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟行次韵二首 其一","author":"叶茵","text":"相逢隐者流，同是五湖舟。\n为老铭三住，因閒话四休。\n黄沙明野渡，画角咽谯楼。\n已践登山约，煎茶更少留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22970,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"严子陵祠","author":"叶茵","text":"横足齁齁梦御床，祗将故旧视君王。\n意嫌汉室乾坤小，归占严江日月长。\n独茧丝头忘宠辱，生刍庭上阅兴亡。\n留题多是功名士，也为留题姓字香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22971,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"伯氏墓下","author":"叶茵","text":"敬长于今我独亡，转头惊见十飞霜。\n心乎爱矣兄如在，陟彼冈兮木已苍。\n直喜克家犹有子，回思疗疾苦无方。\n伏波不忍离坟墓，泪洒归舟重感伤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22972,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"何氏书堂","author":"叶茵","text":"千岁松阴护一亭，风来犹带读书声。\n虽无芳史摹勋业，自有青山说姓名。\n客抚丰碑苔剥落，春归暗径草生成。\n几年访古谋清隐，好借虚檐著短檠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22973,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"别曾源一","author":"叶茵","text":"梅边又上帝王都，柳下俄空处士庐。\n汉月楚星人去后，淮云蜀雨事何如。\n东龟不食西征缺，南雁难期北信疏。\n此去叫阍天路直，何时快睹茂陵书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22974,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿水竹弟","author":"叶茵","text":"人生真乐在家山，况有名园五亩宽。\n眼底不随花富贵，水边长报竹平安。\n养心澹泊千诗稿，种德蕃滋九畹兰。\n以此寿君君必寿，年年新月照杯盘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22975,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"投所知","author":"叶茵","text":"中流砥柱一宗臣，长把丹衷动玉宸。\n三十四番如此疏，百千载后更无人。\n堂留薇药谁知己，路长萧茅谩得春。\n自是不曾轻出处，到头著著为斯民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22976,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秀实长子玉麟期晬","author":"叶茵","text":"门左蓬弧喜事新，四朝先佛庆生辰。\n峣峣已露峙头玉，表表因名系角麟。\n鼻祖同庚光后叶，卯君著瑞定前身。\n我来摩顶为儿寿，一岁从今百岁春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22977,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"邑宰劭农","author":"叶茵","text":"双凫小驻柳边洲，岂是花时作胜游。\n著意劝民躬耒耜，终朝把酒话田畴。\n三年两下车尘拜，九客同为野景留。\n桃李成阴春欲去，寸心耿耿夕阳舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22978,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"阿育王寺舍利塔","author":"叶茵","text":"粒粟悬悬左角钟，几年镇压梵王宫。\n要知八万四千所，元在寻常一念中。\n佛现紫金归胜地，僧誇乌石坠虚空。\n毫光起处无人见，明月堂前玉几东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22979,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"参选有感","author":"叶茵","text":"元是江湖萧散客，谁将幽梦落南柯。\n十年不调幸然好，一著才差悟处多。\n肯使北山驰鹤信，且随西舍唱渔歌。\n野人自喜无弹缴，却恐金章羡绿蓑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22980,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"垂虹桥","author":"叶茵","text":"何年现采虹，悬足控西东。\n两地烟波隔，一天风月同。\n橹声摇雁柱，檐影覆龙宫。\n雠虏曾垂钓，谁收饵虏功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22981,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜坐","author":"叶茵","text":"秋院稚凉生，看书睡未能。\n扇閒萤扑袂，窗破鼠窥灯。\n晚境物华异，清宵道气增。\n邻家犹不寐，席地话丰登。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22982,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"废墓有感","author":"叶茵","text":"轩冕委尘埃，今人为古哀。\n百年丘陇废，几个子孙来。\n蔓草栖朝露，穷猿泣夜台。\n世间类如此，当乐且衔杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22983,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"松江","author":"叶茵","text":"占得中吴第一清，莼鲈里社可鸥盟。\n七层灯火重湖影，千尺阑干两市声。\n欸乃歌分长短律，往来帆带古今情。\n三高岂是无名利，祗与时人有重轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22984,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]