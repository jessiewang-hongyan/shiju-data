[{"title":"忆程公权","author":"彭汝砺","text":"游从邂逅值王孙，万事无穷寄一真。\n倾盖异时心似旧，望尘今日味如新。\n清风遂别江山晓，润泽空馀草木春。\n欲寄赠言终少取，独为瞻慕共斯民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49505,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"尝约谊父同游龙泉奔走失期故作是诗奉和元韵","author":"彭汝砺","text":"野寺幽幽隐翠岚，山川形势尽东南。\n吟随野竹吾怀惬，醉啜溪泉此意堪。\n乐事难并真可惜，登高能赋亦曾谙。\n游从欲尽林间胜，雨气浑浑满古潭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49506,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"古木","author":"彭汝砺","text":"雨湿路岐泥滑滑，风吹江海水茫茫。\n壮心弦直值吾道，孤宦蓬飞各异乡。\n诗句好吟江上碧，酒卮已负菊边香。\n丰年谁及农家乐，老稚驩讴自涤场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49507,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"得庭佐岩夫二弟二书","author":"彭汝砺","text":"十年翰墨共萤窗，万里忧勤鬓欲桩。\n薄宦鹿埃寄南国，归心日夜度重江。\n春风喜咏棠阴秀，夜月愁看雁影双。\n病眼相望劳不彻，书来聊得此心降。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49508,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贺兄长有子","author":"彭汝砺","text":"鳷鹊曾将喜信来，奇祥昨夜出珠胎。\n一枝始得龙孙贵，万里看成骥子材。\n道路笑临诗首首，庭帏欢上酒杯杯。\n风吹消息归江国，老稚应须眼为开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49509,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"欲雨马上寄兄长","author":"彭汝砺","text":"去马惊尘犯客襟，喜看云影聚轻阴。\n雁飞浅草风声疾，蚁斗枯梨雨意深。\n亭外见山输独啸，林边上马强清吟。\n一声误认齐蝉晚，叫起肥陵夜夜心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49510,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"暑雨","author":"彭汝砺","text":"暑热炎炎起道途，霆雷一阵出山隅。\n雨吹细点沾须鬓，风卷轻寒上发肤。\n但使田畴终润泽，敢言车马久泥涂。\n天时信有丰年意，笑语轻便共野夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49511,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过紫金山","author":"彭汝砺","text":"薄晚迟留问旧山，尘埃敢意紫金丹。\n云生石眼千年润，风出云稍五月寒。\n下蔡涂泥沾马足，长淮风浪触渔竿。\n八公更有威灵在，簿领应须笑贱官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49512,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"拟赏花钓鱼诗 其一","author":"彭汝砺","text":"晴云扶日上昭阳，翠辇鸣鞭下建章。\n化国楼台天半际，瀛洲殿阁水中央。\n鱼游自并龟龙国，花气浑如薝卜香。\n拟学华封人作颂，千秋万岁奉君王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49513,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"拟赏花钓鱼诗 其二","author":"彭汝砺","text":"琉璃宫殿云深处，锦绣池堂雨过时。\n鱼跃定名千岁鲤，花开多是万年枝。\n恩流河汉波澜阔，春在蓬瀛日月迟。\n三十馀年无此会，今朝会见柏梁诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49514,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"拟赏花钓鱼诗 其三","author":"彭汝砺","text":"孔雀横斜宝扇回，雕龙浮动翠舆来。\n鱼知迎日争先跃，花会留春独后开。\n法部方将九成乐，侍臣迭送万年杯。\n太平恰似唐虞际，臣主从容赋起哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49515,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"拟赏花钓鱼诗 其四","author":"彭汝砺","text":"翠跸雕舆下未央，禁林春色秀天芳。\n帝居便是蓬莱胜，花气浑如薝卜香。\n五色灵池鱼拨剌，九苞阿阁凤徊翔。\n神仙世界光阴别，比着人间一倍长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49516,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"拟赏花钓鱼诗 其五","author":"彭汝砺","text":"日暖鱼游百子池，雨馀花折万年枝。\n微风静觉丝缗远，暖日徐看淑景移。\n九奏高张洞庭乐，七言遍赋柏梁诗。\n吁俞不忘几微戒，恰似唐尧虞舜时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49517,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"拟赏花钓鱼诗 其六","author":"彭汝砺","text":"甘雨祈祈兆岁丰，君王暇豫与人同。\n晴阳鱼跃烟涛外，暖日花开锦绣中。\n更有灵龟千岁绿，仍多陈粟万仓红。\n便知岂乐歌颁首，不比飞扬赋大风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49518,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"拟赏花钓鱼诗 其七","author":"彭汝砺","text":"百子池塘春复还，五云楼阁晓犹寒。\n蛟龙影上黄金辇，锦绣香浮白玉盘。\n宿蕊万包开雨露，修鳞五色跃波澜。\n太平既醉恩无报，白首侵寻畏素餐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49519,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"拟赏花钓鱼诗 其八","author":"彭汝砺","text":"槛外幽花暖欲然，池边弱柳困初眠。\n风晴莺戏长杨日，水净鱼游太液天。\n玉斝酒深浮湛露，宝炉香聚引长烟。\n云章光绝无能继，但颂南山亿万年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49520,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"拟赏花钓鱼诗 其九","author":"彭汝砺","text":"霁色苍茫杳蔼中，玉舆朝出大明宫。\n修鳞戏跃神池日，宿蕊争开禁籞风。\n韶乐大恩流动植，灵台馀泽入鱼虫。\n龙光所被何其厚，欲报惭无尺寸功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49521,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"拟赏花钓鱼诗 其十","author":"彭汝砺","text":"九重殿阁五云中，閒暇君臣燕乐同。\n芳卉便成金色界，游鳞如在水晶宫。\n承云乐见太平象，湛露诗成王者风。\n从幸甘泉能献赋，愧无人可似扬雄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49522,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题醒心亭","author":"彭汝砺","text":"红尘万里困征鞍，喜向幽亭一倚栏。\n日夜水声趋涧曲，西南山色上云端。\n窗横古木秋阴老，槛逼苍崖雨气寒。\n搜尽肺肠吟不竟，欲君亲置画图看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49523,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谨次知县奉议","author":"彭汝砺","text":"早日苍茫杳霭中，绣衣綵旆照花骢。\n路从古汴聊分北，家在琅琊更近东。\n大野晓行千嶂月，长河朝济一帆风。\n赐环不独邦人愿，名字从来重两宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49524,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次来韵","author":"彭汝砺","text":"山川不见石泉城，风日摇摇想旆旌。\n鸑鷟老寻丹穴宿，骅骝饥上赤霄行。\n隆冬霜雪伤萍泛，末路埃尘忆盖倾。\n父老祇知荣衣绣，乡人未会贵登瀛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49525,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"拙句送通判学士正夫","author":"彭汝砺","text":"山谷冥冥多雪霜，人情随处不悲凉。\n綵衣公独有老母，乔木我今思故乡。\n行酒赋诗不忍别，登高临远便相望。\n故乡虽好莫留滞，日月其除行路长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49526,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"长沙道中寄君时","author":"彭汝砺","text":"少时惜别惟男女，老大相思味尤苦。\n时节愁深聚作云，道途泪落纷如雨。\n梦魂章水去无时，书信蒲山来有数。\n几时与汝归去来，綵服相看老农圃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49527,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和文渊游馀干山寺","author":"彭汝砺","text":"爱山终日在山巅，山径迟留几屐穿。\n涧水曲流随步屧，炉香深处作云烟。\n峨峨健马横岩石，漠漠苍龙宿旧渊。\n为语琵琶洲上路，几时容我系归船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49528,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"道中每至山寺辄迟留久之","author":"彭汝砺","text":"杖屦徜徉信所之，偶逢佳致即忘归。\n舟帷不系东西去，云似无心在处飞。\n岁月漫能催我老，江山可复与人违。\n一廛未足南陔志，静笑浮生事事非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49529,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"武冈驿","author":"彭汝砺","text":"行路萧条伤客心，黄云不动祇阴阴。\n天寒独鹤飞平泽，日暮慈鸦归故林。\n鳞翼不将一字至，雪霜莫怪二毛侵。\n拥炉更饮钟陵酒，抱膝漫为梁甫吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49530,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"依韵和萧推官见贻推官字子方知桂州修撰字子善相及喜论兵尝见于鄱阳","author":"彭汝砺","text":"晚年相遇更堂堂，祇似当时鄱水阳。\n物论固非低阀阅，家声元自满湖湘。\n风回獠俗归陶冶，囊括蛮州入井疆。\n使指质成非有用，赠言虚自辱圭璋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49531,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄佛印","author":"彭汝砺","text":"菩萨化成瑶象车，超腾倏忽到云居。\n提携满钵雕胡饭，供养一箪明月珠。\n称我姓名日专甲，问师安否近何如。\n即今无病无言说，还有人能致问无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49532,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清江闻提举承议先行驰寄小诗","author":"彭汝砺","text":"一水相忘复此时，世情岂故与人违。\n江湖雨涨潜鳞去，霄汉云深画鹢飞。\n晓月正思公共载，春风好与我同归。\n别来道味知何似，丹灶黄芽想更肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49533,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"走笔和萧推官迎提举承议 其一","author":"彭汝砺","text":"青山远远水回回，初见钟陵城上台。\n将迎不独儿童喜，杨柳看人亦眼开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49534,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"走笔和萧推官迎提举承议 其二","author":"彭汝砺","text":"画舫急随江上鸥，犹嗟不及水先流。\n欲知今日陈雷社，不数当时李郭舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49535,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又和治居许昌诗 其一","author":"彭汝砺","text":"事与心违即挂冠，逍遥芝朮长童颜。\n黄金晚去云中阙，员峤深游海上山。\n平日以身当国论，老年将梦比人间。\n文章气力终豪健，四韵诗来倚马还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49536,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又和治居许昌诗 其二","author":"彭汝砺","text":"闻说当年鹓鹭班，谏书无数慰龙颜。\n水横颍首归新第，云断峨眉忆旧山。\n漫有新诗名海内，曾闻雅乐献河间。\n西湖今日春应好，想见扁舟载月还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49537,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"途中寄君时弟 其一","author":"彭汝砺","text":"邮亭车马日纷纷，可遂尘埃老此身。\n燕子恰如曾宿客，雁奴犹是未归人。\n晚云明灭初收雨，朝日阴晴拟放春。\n花木一时浑自好，寄声华发莫争新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49538,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"途中寄君时弟 其二","author":"彭汝砺","text":"天晴日驭去迟迟，恰是春风中半时。\n柳色笑花须似锦，雨声欺雪故如丝。\n迁乔他日吾求友，发药明朝汝得师。\n乐事信知人不及，异乡同有拜亲期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49539,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次君时韵","author":"彭汝砺","text":"牙弦不愿世人知，末路论心有子期。\n万物参差为我与，三人邂逅得吾师。\n更贫未乏扬雄宅，已会谁悲墨子丝。\n欲说本来时节事，直须会得未来时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49540,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄检法奉议","author":"彭汝砺","text":"长春月月与玫瑰，烦近萱堂仔细栽。\n却语花开无造次，老亲寒食以前来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49541,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"老儿挈幼小将及邓因寄君时弟 其一","author":"彭汝砺","text":"莫言法法与尘尘，祇论而今见在身。\n婆子台山能护物，厮儿临济最疑人。\n阿那含果多生叶，优钵罗花别样春。\n须认铁牛楼上语，一回几看一回新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49542,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"老儿挈幼小将及邓因寄君时弟 其二","author":"彭汝砺","text":"长年骑马走风尘，扰扰犹知梦幻身。\n野柳最怜青绶客，山桃莫笑白髭人。\n照溪七里亭边晚，近郭百花洲上春。\n捉麈即从君道旧，浮蛆更许我尝新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49543,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和范学士 其一","author":"彭汝砺","text":"红尘投老倦征鞍，梦寐清规祇厚颜。\n论德每疑观大水，言诗曾赋仰高山。\n退之自处轲雄后，甫也当居扬马间。\n知止旧风衰久矣，只今须合为公还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49544,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和范学士 其二","author":"彭汝砺","text":"酒榼棋枰足燕闲，市朝愁复抗尘颜。\n曾非学道随东鲁，可怕移文累北山。\n花烛园林春半际，烟波亭榭水中间。\n篮舆想见公游处，颍水何时听我还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49545,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄致政侍郎","author":"彭汝砺","text":"孔门弟子数三千，用舍行藏独与颜。\n委曲百川终至海，辛勤一篑欲为山。\n是非扰扰俱身外，生死悠悠亦梦间。\n漫爱隐居多气味，扁舟今欲与公还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49546,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又书怀","author":"彭汝砺","text":"锦江蟠泊落云端，秀气全分在尔颜。\n少日大鹏飞北海，清时片玉出昆山。\n心存魏阙安危际，名在丹台伯仲间。\n昨夜泸渝初奏捷，巅崖谁为勒铭还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49547,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中丞温伯杂端持正与其僚出祖正孺端伯于刘元忠宅某即席赋诗","author":"彭汝砺","text":"蜀山想见去程兼，满眼春风别兴添。\n光动酒船浮玉雪，味调羹鼎足梅盐。\n竹枝堕影低垂砌，花叶吹香细入帘。\n更欲稍留山简醉，应须少霁弱翁严。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49548,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"翌日景繁察院公初叔明推直谦父主簿复会某晚至即席用前韵 其一","author":"彭汝砺","text":"鼎食参差海陆兼，炉烟浮动麝兰添。\n纷纷不及同朝饮，草草犹能共暮盐。\n最爱梅香频倚槛，欲留槐影更褰帘。\n驿途即折垂杨别，酒令毋嫌细柳严。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49549,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"翌日景繁察院公初叔明推直谦父主簿复会某晚至即席用前韵 其二","author":"彭汝砺","text":"银鱼朱绂綵衣兼，稍觉公行气象添。\n白水长时云似雾，青泥三月雪如盐。\n诗成曷日传邮置，书就他时奏陛帘。\n更为朝廷问幽仄，人材岂遂乏杨严。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49550,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送桂阳令臧祖道","author":"彭汝砺","text":"莫笑长官权势轻，所怀端可及生灵。\n勤忧每见朝尝胆，劝恤遥知夜戴星。\n礼节但能坚玉石，清名亦合上丹青。\n饯行欲以言箴赠，留作君家座右铭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49551,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中丞温伯杂端持正约同饯夷仲不克某独出城重阳后一日","author":"彭汝砺","text":"宛转平林十里开，天晴更喜少风埃。\n桃花笑摘篱边菊，竹叶惭无马上杯。\n更欲看君横奋迅，不应如我久低徊。\n闾阎蛰蛰忧昏垫，侧耳乘骢御史来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49552,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和提点少卿诗韵","author":"彭汝砺","text":"文场俱是出群雄，曾颂鸿毛遇顺风。\n稍记螭头初赐第，渐惊鹤发欲成翁。\n老年翰墨才仍敌，故国溪山路更同。\n存殁感怀浑梦寐，会须推付酒樽中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49553,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和提点少卿喜雪诗韵 其一","author":"彭汝砺","text":"曲岸沧洲一水涯，轻舟欲访戴逵家。\n城隅寂淡梧桐月，溪岸萧骚芦苇花。\n润泽便知年事足，清明更爱晓晴佳。\n园林已有春来信，笑看浮生鬓欲华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49554,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和提点少卿喜雪诗韵 其二","author":"彭汝砺","text":"同云漫不见津涯，雪雾参差似一家。\n辛苦宋人成楮叶，殷勤驿使寄梅花。\n润沾南亩从横阔，寒助西山晓夕佳。\n三白更同千乘喜，屡丰吾亦有光华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49555,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"久雨和张季友寄程德林时季友得环倅程受婺源未赴","author":"彭汝砺","text":"寂寂不闻车马声，泥途无亦畏逢迎。\n引觞自放连朝醉，挥麈遥思一座倾。\n傅野好为三日雨，杜陵莫醉百忧行。\n西南俱说催征辔，却愿双轮四角生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49556,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和张季友正夫归因为诗寄","author":"彭汝砺","text":"曲曲幽林远远山，归与谁得似公安。\n定为五柳先生传，应笑三年博士官。\n上国尘沙随马箠，长溪风浪属渔竿。\n秋风喜得音声到，起对青灯子细看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49557,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄妻兄宁文渊时广西方用兵而文渊谪官在广东","author":"彭汝砺","text":"有客迟留瘴海边，白头想见欲潸然。\n淹留每笑犹千里，芘藾遥知有二天。\n行听伏波平岭峤，已闻下濑济楼船。\n几时幽谷灵芝路，水石相看稳昼眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49558,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送郭知章宰浮梁 其一","author":"彭汝砺","text":"万室喁喁望已深，临流不敢重分襟。\n闾阎早觉春风到，岩谷遥思昼日临。\n制御古非无至策，爱调人自有良心。\n笑言已得公才敏，侧耳风前听好音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49559,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送郭知章宰浮梁 其二","author":"彭汝砺","text":"仕宦悠悠今几年，初分一邑走江边。\n凤飞远水颠崖地，鹤唳清霜皓月天。\n潇洒渊明多种秫，从容子贱数鸣弦。\n秋风坐看车辕速，一梦归争鸟翼先。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49560,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和李潜夫同年并简宁文渊时二君在鄱阳","author":"彭汝砺","text":"我贱无庸如子何，白头相望欲悲歌。\n少年策在英豪腹，清世名专守相科。\n薄宦从容忧自少，故人邂逅乐应多。\n秋风不见北归信，东顾苍茫临大河。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49561,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送徐望之郎中提举舒州灵仙观","author":"彭汝砺","text":"江濒远别几秋萤，汴曲相逢眼更青。\n予志自能同豹变，弋人安得望鸿冥。\n风流绿蚁千钟酒，香火黄庭一卷经。\n祇恐诸公还荐鹗，未容轻去老岩扃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49562,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送提点少卿丈还鄱阳","author":"彭汝砺","text":"秋风吹雨响梧桐，南岸遥山翠几重。\n稍爱楼台足清旷，可怜樽俎未从容。\n三溪天外横新水，五老云间出旧峰。\n邂逅一舟吾亦往，登临还复与公从。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49563,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"奉和提点少卿来章","author":"彭汝砺","text":"场屋当年翰墨亲，故乡相别九年春。\n相如旧有凌云赋，居士今惟净法身。\n素节直须深爱惜，高材未必竟沉沦。\n祇疑龙去须为雨，不似区区尺蠖伸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49564,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"呈运判学士 其一","author":"彭汝砺","text":"邂逅江滨宿使航，五更窗外月犹黄。\n因陪谈麈殊优远，自反机心愈渺茫。\n老马但羞千岳阻，病翰孰与九皋翔。\n明时赖有吾宗在，敢学西邻便涕伤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49565,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"呈运判学士 其二","author":"彭汝砺","text":"相望冰壶江水滨，渴心枯涸欲生尘。\n忽逢使节何胜喜，又说宗乘得愈真。\n鬓里雪霜经岁有，眼前风浪与时新。\n茫然未有归田计，愧以穷通问故人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49566,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和十二法曹","author":"彭汝砺","text":"秋来初得兔园书，更有诗来慰索居。\n出宿几时吾税驾，归宁何日尔脂车。\n贫如原宪元非病，懒比嵇康老更疏。\n鸿雁池边知可乐，鹡鸰原上正相胥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49567,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]