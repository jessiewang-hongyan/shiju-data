[{"title":"秋夜 其一","author":"丘葵","text":"缺月黄昏照短垣，一灯明灭尚留残。\n衰颓但觉风霜苦，忧患不知天地宽。\n坐想兴亡成感慨，起瞻星象倍辛酸。\n冻琴弦断书帷冷，槭槭庭梧半夜寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20674,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋夜","author":"丘葵","text":"中秋爱亲友，欲别不胜愁。\n此去无多日，羁情可奈秋。\n山寒犹碧树，水落正沧洲。\n莫道非吾土，今冬尚此留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20675,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋夜 其二","author":"丘葵","text":"纷纷败叶已辞林，四顾凄凉夜色深。\n月伴征人惊梦枕，风摇戌妇捣衣砧。\n失群孤雁千山影，无数寒虫四壁音。\n满目乾坤都是恨，头毛白尽更愁吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20676,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送千岩摘稿还仲仁","author":"丘葵","text":"借得千岩一卷诗，吟窗尽日不停披。\n苍波溜雨岷峨柏，赤石封苔岣嵝碑。\n不是胸中横屴崱，如何笔下许瑰奇。\n还君此宝文房里，应有神明为护持。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20677,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送陈判之邑庠","author":"丘葵","text":"君去采芹藻，那知事不同。\n乾坤已易主，礼乐尚儒宫。\n雨过山仍绿，春归花尽红。\n悠悠圣门意，千古独清风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20678,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送春","author":"丘葵","text":"一物生生无尽时，落花啼鸟总天机。\n三千界内知音少，九十日馀回首非。\n世事只今看烂熟，诗人自古爱芳菲。\n年年岁岁送春去，何日春能送我归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20679,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送谊上人归城","author":"丘葵","text":"恰是闻师到，持筇又欲归。\n去云黏木屐，飘叶泊禅衣。\n不敢生离思，应愁损道机。\n故人如见问，为说志渔矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20680,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送舶司李郎中","author":"丘葵","text":"朝家三尺法，海舶一帆风。\n物到琛声上，人行浪屋中。\n货因拚命得，廉故秉心公。\n行李清如洗，名应达陛枫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20681,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闻吴丞图漳倅","author":"丘葵","text":"黄屋南巡去不回，乾坤举目是尘埃。\n风轻山鸟犹啼恨，露重园花亦溅哀。\n只影独看西日落，满城争喜北人来。\n先生莫为浮云动，忧国双眉皱未开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20682,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乘除","author":"丘葵","text":"若问乘除法，须当健补贫。\n何如穷到骨，更有病缠身。\n忽忽又将老，苍苍更不神。\n此生吾自断，蓑笠一閒人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20683,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"倚杖","author":"丘葵","text":"为怜情景好，倚杖立还移。\n海近云来湿，波平日下迟。\n归牛行砾确，幽鸟语沦漪。\n觅句心将呕，傍人过不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20684,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭吕朴卿先生 其二","author":"丘葵","text":"潮士瞻韩木，莆民爱召棠。\n名随天共远，身与物俱亡。\n血碧一时恨，汗青千载香。\n玄虬方陨蹶，螾蛭恣飞扬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20685,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭吕朴卿先生 其三","author":"丘葵","text":"斯文天欲丧，疑义有谁祛。\n无复谆谆诱，空令咄咄书。\n秋风冢上木，夜月墓边庐。\n每与诸孤道，相看泪满裾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20686,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭吕朴卿先生 其一","author":"丘葵","text":"已拟侍荷橐，俄抽似叶身。\n甘为南地鬼，不作北朝臣。\n屋壁遗文坏，邻州战血新。\n劫灰飞未尽，碑碣托何人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20687,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭矩斋先生","author":"丘葵","text":"早悟官为祟，晚将家付儿。\n公今成佛去，仆尚是人猗。\n柿叶收遗墨，梅花忆赠诗。\n自嫌闻道晚，有泪哭先师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20688,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭高氏妹","author":"丘葵","text":"寒月照幽闺，眉多客里齐。\n飘零杜氏妹，隐约伯鸾妻。\n乌啄有新哺，凤飞无故栖。\n近闻犹子说，忆汝万行啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20689,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"恶况","author":"丘葵","text":"恶况有谁知，僵妻与仆儿。\n无人乞颜米，有客泣杨岐。\n浩劫天难免，凶年鬼亦饥。\n但言身长在，不敢恨流离。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20690,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽张樗堂","author":"丘葵","text":"与君虽远隔，自少即相亲。\n老失同年友，乡无好善人。\n樗堂春绝迹，蒿里暗伤神。\n丹旐归何处，风霜故冢滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20691,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽梁丹隐","author":"丘葵","text":"受用伯阳书，万缘都觉虚。\n达官直桎梏，大厦即籧篨。\n世谓求仙妄，谁知是道馀。\n临终为土解，何必泪盈裾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20692,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓意","author":"丘葵","text":"邻窗鸡唱晓，客路马嘶风。\n夜色钟声外，晨光角韵中。\n蟾归曳残白，乌出浴新红。\n一点清明意，那无保养功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20693,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浪出","author":"丘葵","text":"浪出鬼揶揄，归来失故吾。\n庭空榕落子，人静鸟呼雏。\n潮退石自出，天高日正晡。\n寥寥谁与语，怀古一长吁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20694,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浮名","author":"丘葵","text":"不起浮名想，都缘耐寂寥。\n小斋坐听雨，野渡立看潮。\n岁月吟边过，忧愁醉里消。\n早知书分浅，悔不学渔樵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20695,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病中作","author":"丘葵","text":"独坐茅檐静养疴，亦知来日苦无多。\n此心不动穷无鬼，元气将衰病有魔。\n叹老嗟卑非我事，贪生怛化欲如何。\n平生不为浮屠惑，自此幢峰土一窝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20696,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"破屋","author":"丘葵","text":"数间破屋住陈人，八尺空床卧病身。\n赤脚婢沽深巷酒，苍头奴买对江鳞。\n匣中菱镜难藏老，阶下苔钱不济贫。\n百念已灰何自苦，迩来喜与孟家邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20697,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"离相院","author":"丘葵","text":"一夕僧留宿，翛然万虑空。\n草分仙掌绿，花发御袍红。\n白鸟松梢雪，玄谈麈尾风。\n因悲人世上，终日业尘中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20698,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"离相院暂憩","author":"丘葵","text":"一别已五载，重来得旧朋。\n秋风多败叶，童行半为僧。\n暂憩亦云好，长游愧未能。\n前山久相识，为我碧崚嶒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20699,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秘藏院","author":"丘葵","text":"才入空门里，尘心便欲抛。\n土花生石缝，野蔓上林梢。\n栋老蜂钻穴，檐低雀结巢。\n僧中无贾岛，得句自推敲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20700,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读元次山诗有感而作","author":"丘葵","text":"民病未苏息，谁为元道州。\n争趋热翕翕，不念冷飕飕。\n摧剥先虫户，差科及钓舟。\n君门千万里，欲往诉无由。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20701,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读石隐淡吟藁","author":"丘葵","text":"借师新藁读，睡睫不曾交。\n璧月沉寒濑，琪花著老梢。\n一吟三叹咏，双字几推敲。\n晓雨驱炎热，僧窗得尽钞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20702,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读易彻章呈濠乐主人","author":"丘葵","text":"侬是寒江独钓人，曾偕樵叟见羲文。\n当时也似吞三画，今日翻难说七分。\n萱草不堪濒外望，梅花岂是野中群。\n解颐一笑明年事，未别先愁日暮云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20703,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读楚词","author":"丘葵","text":"鶗鴂一声天地闭，谁知风月有遗音。\n清醒已脱尘中蜕，枯槁何妨泽畔吟。\n渔父不来湘水阔，重华一去楚云深。\n青镫半夜书帏冷，照破三闾万古心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20704,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"钱侯寺","author":"丘葵","text":"福唐钱氏子，爵命古诸侯。\n老树护灵镇，神鸦迎客舟。\n晨昏两潮汐，尸祝几春秋。\n参佐凭风景，轻嚣走不休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20705,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶成","author":"丘葵","text":"风雨三间屋，乾坤一腐儒。\n营生妻笑拙，学古客言迂。\n坐久灯花落，吟成砚水枯。\n方书俱遍览，无药可医愚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20706,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿镜山欲访之寿忽闻东浯思仲至约为南山之游不果","author":"丘葵","text":"镜山欲相访，马首已之东。\n常日对衿佩，此行如燕鸿。\n将归逢所与，有约竟成空。\n若到斋中日，为予传主翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20707,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄吕之寿","author":"丘葵","text":"一灯清夜话，觉子颇真情。\n世已无前辈，方予畏后生。\n天涯共流落，岁晚独无成。\n桐下来春约，飞鸿望寄声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20708,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄呈张教谕","author":"丘葵","text":"天欲昌吾道，君来董县庠。\n坛荒犹杏树，水落且芹香。\n欲与二三子，皈依数仞墙。\n若为鸥鹭伴，留住水云乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20709,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄陈儒正","author":"丘葵","text":"论心才暑夕，别后已凉秋。\n月照陈蕃榻，风生王粲楼。\n哀音虫外笛，远棹雁边舟。\n欲写相思意，题诗寄水流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20710,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄林簿","author":"丘葵","text":"一别又一载，相思入梦频。\n以予拙生计，知子不为贫。\n鼠迹陶瓶粟，蛛丝范甑尘。\n莫将憔悴意，说与得时人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20711,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄南剑詹野渡先生","author":"丘葵","text":"贤圣已往古，吾侪空自今。\n六经寻断脉，千里遇知音。\n莫笑因缘浅，相期造道深。\n可怜山海隔，无路盍朋簪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20712,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄雪庭老子","author":"丘葵","text":"问讯紫云老，何时立雪参。\n生来将满百，空界直超三。\n泡幻修千劫，佛应同一龛。\n曾师蒙印可，玄谛老方谙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20713,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题朱推官竹斋","author":"丘葵","text":"万紫千红转眼非，高斋惟与竹相宜。\n自从出地有清节，直至参天无曲枝。\n六月高标寒凛凛，三冬秀色绿猗猗。\n此君妙处无心得，道在虚中人不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20714,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"悠悠","author":"丘葵","text":"江上形容老，竹间窗户秋。\n悠悠忘岁月，落落少交游。\n无食令儿瘦，有诗消客愁。\n古今多少事，卷易在床头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20715,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚行书所见","author":"丘葵","text":"夕阳半落红犹在，寒月初升白未匀。\n流水孤村天欲暮，颓檐败壁野无人。\n雀衔遗芥营巢急，蛛绎新丝织网频。\n欲问前朝无故老，髑髅落地路荆榛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20716,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚步","author":"丘葵","text":"片月黄昏挂客愁，杖藜閒过水西头。\n婵娟正喜临清沼，菡萏无端枕碧流。\n入暮江山浑似画，向南门巷已先秋。\n稻田尽处为沧海，时见乘风万斛舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20717,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚道过镜山寺借憩未及曙而返","author":"丘葵","text":"晚风残照岸乌巾，小借禅床憩旅身。\n坐对新花忘故我，行看古月照今人。\n聊为江畔骑驴客，难会云间驾鹤宾。\n泡沫风灯成一笑，近来东海又扬尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20718,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅","author":"丘葵","text":"历尽风霜不受埃，始知渠是岁寒材。\n孤芳独洁无由俗，百卉争娇未敢开。\n江驿倾攲留月伴，雪山凝冱带春来。\n樗翁忘了桂花白，误道柴桑不咏梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20719,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"移居 其二","author":"丘葵","text":"田家一路到村南，尽是农人野叟谈。\n鸟过江来平入树，牛沿堤去倒行潭。\n蜻蜓影下波纹皱，䆉稏穗中秋意含。\n日暮东坡浑似画，倚风无数水荭酣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20720,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"移居 其三","author":"丘葵","text":"断云将雨过桥南，谁想庄门憩雨谈。\n雀喜客来喧古棘，蛙嗔人过没深潭。\n莲房堕粉风初歇，稻叶抽珠水尚含。\n村酿沽来薄难醉，不妨此兴为诗酣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20721,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"章法院中作","author":"丘葵","text":"一入紫云深更深，游僧亦喜不相寻。\n已无尘事败人意，时有书声杂梵音。\n浩气养成天地小，欲心扫尽鬼神钦。\n人生能有几七十，自爱当如百炼金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20722,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寓居姚家村","author":"丘葵","text":"平头五十沧江叟，寄迹三家桑柘村。\n樽酒不知谁主客，柬书相伴过晨昏。\n有时独步来沙际，尽日清谈倚树根。\n一任傍人笑迂阔，此心欲与白鸥论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20723,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寓浯江识老魏秀才 其二","author":"丘葵","text":"月澹蓬门掩候虫，穷通何必问天工。\n茶烹粟面纷纷白，灯吐花心灼灼红。\n屡改新吟添砚水，密翻旧稿护窗风。\n相逢莫道庞公老，览镜先惭似老翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20724,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寓浯江识老魏秀才 其一","author":"丘葵","text":"衡茅萧索泣寒虫，独自吟诗句未工。\n败叶能令沟水黑，乱云不放夕阳红。\n半生辛苦空儒服，一岁蹉跎又朔风。\n不意穷乡有奇事，暮年得拜鹿门翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20725,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"御史马伯庸与达鲁花赤徵币不出","author":"丘葵","text":"皇帝书徵老秀才，秀才懒下读书台。\n张良本为韩仇出，黄石特因汉祚来。\n太守枉劳阶下拜，使臣空向日边回。\n床头一卷春秋笔，斧钺胸中独自裁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20726,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游龙湖庵","author":"丘葵","text":"一路野花开，春阴满树苔。\n旧时僧已去，前度客重来。\n浮世年年变，尘心事事灰。\n跏趺清昼永，玄奘壁间回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20727,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游承天寺海翁首座相与登月台因过方丈","author":"丘葵","text":"偶趁秋风一到城，市尘湫隘败人清。\n牵丝聊作逢场戏，举眼那知得月明。\n寂外幡幢皆古意，堂边萱草自秋声。\n因过方寸观心印，见得泥牛入海行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20728,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游贤坂书赠可大","author":"丘葵","text":"十月寒犹未，幽人乐自便。\n看山行觅句，扫石坐谈玄。\n一径藤萝月，数家桑柘烟。\n旧时钓鱼处，枯木倒寒泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20729,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游秘藏院呈老叟","author":"丘葵","text":"法藏千年在，何人结构功。\n寒潭空夜月，老桧易秋风。\n我问四奇观，师云一切空。\n因之悟真境，只在太虚中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20730,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答城中友人相勉求官","author":"丘葵","text":"愁来自唱五噫歌，名利场中脚岂牢。\n君看青衫求热炙，我怜赤子有寒号。\n鹤沾卫禄犹堪薄，松受秦封岂足高。\n家在荻芦丛畔住，分当蓑笠钓江皋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20731,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赏梅分韵得殊字","author":"丘葵","text":"梅是花中先觉者，天才迥与众芳殊。\n朔风如铁为寒骨，暖日投金作细须。\n吐出奇芬春意思，描成疏影月工夫。\n玉容清润丰腴甚，无限诗人错道癯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20732,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"感遇","author":"丘葵","text":"本是畏人嫌我真，何人使我入城闉。\n客中谁问张仲蔚，夜半有呼祁孔宾。\n万象不离心内易，一私坏尽世间人。\n半生说过行无寸，石火光中寄此身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20733,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"慈济行祠","author":"丘葵","text":"上人栖息地，况近佛庄严。\n乱藓缄新甃，閒花覆古檐。\n浯山青入眼，榕树紫垂髯。\n独步秋祠晚，云间月一镰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20734,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"瑞光亭","author":"丘葵","text":"昔闻石幢寺，今见瑞光亭。\n一水东南碧，四榕冬夏青。\n往来多俗子，老病抱遗经。\n亲冢招提北，回头涕泗零。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20735,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"瑞光亭有作","author":"丘葵","text":"终年萧寺里，人迹往来稀。\n雀踏梁尘落，蜂穿木屑飞。\n佛幡书古偈，僧壁挂禅衣。\n此景惟予爱，冷然契道机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20736,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"暮雨","author":"丘葵","text":"几月环城万骑屯，一朝闻鞑便南奔。\n龙枯未必还忧蚁，牛瘠胡为莫偾豚。\n典午既衰无管仲，吐蕃方炽有怀恩。\n临风一掬英雄泪，散作弥天暮雨昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20737,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"端午","author":"丘葵","text":"世乱逢端午，凄凉吊古心。\n空存蒲长绿，不见黍包金。\n蛇壑横人骨，鳌江绝古音。\n追思前日事，愁比海波深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20738,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题心泉所赠李白画像","author":"丘葵","text":"太白仙人紫绮裘，千年遗像尚风流。\n狂来踏月共吟咏，醉后呼天与唱酬。\n唐室已无一抔土，浔阳今见几回秋。\n后身定是青霞老，何日分骑鲸背游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20739,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题可翁塔","author":"丘葵","text":"至人埋骨地，草木总皆玄。\n未腊梅先觉，无风竹亦禅。\n灯缘千载燄，名共四松传。\n旧日经行处，瓶盂常俨然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20740,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题杨子岩","author":"丘葵","text":"抗尘走俗令人憎，因觅桃源作此行。\n畏日烧空时事恶，飞泉泻石道心生。\n青天尽处孤舟渺，好鸟鸣时万壑清。\n一老头陀癯似鹤，殷勤煮水爨风铛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20741,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]