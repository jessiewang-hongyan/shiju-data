[{"title":"守居园池杂题 无言亭","author":"文同","text":"谁此设懒床，颇称我衰惰。\n公事凡少休，须来默然坐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7018,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"守居园池杂题 冰池","author":"文同","text":"日暮池已冰，翩翩下凫鹜。\n不怕池中寒，便于冰上宿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7019,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"守居园池杂题 过溪亭","author":"文同","text":"小彴过清溪，有亭才四柱。\n地僻少人行，翩翩下鸥鹭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7020,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"守居园池杂题 金橙径","author":"文同","text":"金橙实佳果，不为土人重。\n上苑闻未多，谁能为移种。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7021,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"守居园池杂题 南园","author":"文同","text":"农桑乘晓日，凌乱如碧油。\n紫椹熟未熟，但闻黄栗留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7022,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"守居园池杂题 待月台","author":"文同","text":"城端筑层台，木杪转深路。\n常此候明月，上到天心去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7023,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"守居园池杂题 荼蘼洞","author":"文同","text":"柔条缀繁英，拥架若深洞。\n是处欲清香，凭风为持送。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7024,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"守居园池杂题 涵虚亭","author":"文同","text":"石磴抱城回，入竹见虚槛。\n前望佳景多，倚筇聊此暂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7025,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"守居园池杂题 菡萏轩","author":"文同","text":"朝阳媚秋漪，菡萏隔深竹。\n谁开翠锦障，无限点银烛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7026,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"守居园池杂题 野人庐","author":"文同","text":"萧条野人庐，篱巷杂蓬苇。\n每一过衡门，归心为之起。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7027,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"守居园池杂题 寒芦港","author":"文同","text":"落月照冰湖，晓气何太爽。\n两岸雪烟昏，凫鸥出深港。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7028,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"守居园池杂题 溪光亭","author":"文同","text":"横湖决馀波，㶁㶁泻寒溜。\n日影上高林，清光动窗牖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7029,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"守居园池杂题 蓼屿","author":"文同","text":"孤屿红蓼深，清波照寒影。\n时有双鹭鸶，飞来作佳景。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7030,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"守居园池杂题 横湖","author":"文同","text":"长湖直东西，漾漾承守寝。\n一望见荷花，天机织云锦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7031,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"守居园池杂题 露香亭","author":"文同","text":"宿露濛晓花，婀娜清香发。\n随风入怀袖，累日不消歇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7032,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岁晚登清素院北阁","author":"文同","text":"云端访古寺，树杪临危阁。\n风厉慑草木，霜乾喜雕鹗。\n天时既悽惨，人意亦寂寞。\n回念故山远，心随日西落。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7033,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"师厚还朝","author":"文同","text":"闻公之名三十年，常恨与公不相值。\n岂期今乃出门下，每一见公心自醉。\n词章豪荡已难敌，辨论注射尤可畏。\n咨询故事要蒋乂，讲正大体须贾谊。\n荆山拾玉抵乾鹊，虞坂装盐压良骥。\n用人最忌非所宜，愿莫使公嗟俗吏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7034,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"收复河湟故地","author":"文同","text":"哑儿峡西山已尘，驮金辇帛无断群。\n河湟故疆尽收复，解辫厥角归如云。\n堂中玉带赐丞相，陇外金节酬将军。\n唐兵万里若日月，请作古今人未闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7035,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"早秋山水砚屏","author":"文同","text":"晚霭隔远岫，秋容入平林。\n方素仅盈尺，岩谷能许深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7036,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"早起览物成咏","author":"文同","text":"移枕出幽幌，披衣步前楹。\n秋容草木静，晓气烟云轻。\n蝉噪宿露滴，雁飞朝霞明。\n尘心幸未动，聊此纳馀清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7037,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"朱康叔郎中弃官求母于金州因会华清宫作此诗送之","author":"文同","text":"蟠桃实在枝，蟠桃花已飞。\n相隔五十春，一旦还相依。\n康叔视金龟，解去如粪土。\n徒步入峣关，金州取其母。\n古人亦有此，比之康叔难。\n几时有古人，能如公弃官。\n玉莲仙宇中，相会谈此事。\n使我发惊叹，达晓不能寐。\n借问侍安舆，辇下何时过。\n我欲率诸君，扶服诣门贺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7038,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"朱樱歌","author":"文同","text":"金衣珍禽弄深樾，禁籞朱樱斑若缬。\n上幸离宫促荐新，藤篮宝笼貂珰发。\n凝霞作丸珠尚软，油露成津蜜初割。\n君王日午坐猗兰，翡翠一盘红靺鞨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7039,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"此乐","author":"文同","text":"吏散收簿书，公馆如山居。\n归来换野服，携策将焉如。\n园亭极潇洒，阴森修竹下。\n拂石坐终日，徙倚不知夜。\n山月照我明，林风吹我清。\n口诵太古文，往来池上行。\n露下觉微凛，南窗归就枕。\n心闲神自安，达旦得酣寝。\n乱曰：懒守尔何为，日日常若斯。\n为言我自尔，此乐非汝知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7040,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"此君庵","author":"文同","text":"斑斑堕箨开新筠，粉光璀璨香氛氲。\n我常爱君此默坐，胜见无限寻常人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7041,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"百舌鸟","author":"文同","text":"众禽乘春喉吻生，满林无限啼新晴。\n南园花木正繁盛，小小大大皆来鸣。\n藏枝映叶复谁使，不肯停住常嘤嘤。\n就中百舌最无谓，满口学尽群鸟声。\n自无一语出于己，徒尔嘲?誇从横。\n朝朝泊我高柳上，叫破一窗残月明。\n幽人稳睡正酣美，无计可奈遭尔惊。\n少年挟弹彼谁者，安得为我来五更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7042,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自君之出矣","author":"文同","text":"自君之出矣，吊影度晨夕。\n中门一步地，未省有行迹。\n闺闱足仪检，常恐犯绳尺。\n欲寄锦字书，知谁者云的。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7043,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自斜谷第一堰溯舟上观石门两岸奇峰最为佳绝","author":"文同","text":"北风吹云落寒水，逆波刺船行五里。\n层峦夹空抱丛石，万剑侧脊翠烟起。\n草木枝叶自殊别，禽虫羽毛亦奇诡。\n安得鸡冠数棱田，便可诛茅此居止。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7044,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"行李载书成咏","author":"文同","text":"于世已无用，何苦爱读书。\n自笑身许大，所处如蟫鱼。\n编简补断烂，卷轴收残馀。\n又锁十馀箧，作数随行书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7045,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西门行","author":"文同","text":"盛年可爱重，芳辰宜嬉游。\n金瓮酿醇酒，玉盘炙肥牛。\n青春九十日，不可一日休。\n勿自汨浩气，满胸藏百忧。\n君莫惜黄金，黄金身后雠。\n自古贪与吝，常为贤者羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7046,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西冈僦居","author":"文同","text":"出官在秦蜀，始末凡十年。\n所治得公宇，靡不完且坚。\n中堂与挟廊，角翼相钩联。\n领属仅十口，出处皆安便。\n冬夏恶风日，侵薄曾无缘。\n今年归中都，职事叨磨铅。\n未免僦屋住，敢谓须华鲜。\n西冈颇幽僻，爱此远市廛。\n问得王氏居，十楹月四千。\n床榻案几外，空处无一椽。\n匽溷及井灶，坼壁皆相连。\n经庳须俯首，过隘常侧肩。\n所谓十口者，日绕蜗壳旋。\n前时大暑中，几不禁袢延。\n郁若鼎釜炊，局如狴犴挛。\n走蝎过乱蚁，飞蚊剧群蝉。\n今日幸过之，复畏明日然。\n喜见白露节，相贺肌肉全。\n如何下淫雨，晓夕常绵绵。\n瓦破榱栋漏，柱陷墙垣穿。\n惟供改席坐，岂暇安枕眠。\n中庭止数步，深已可载船。\n尽室徒跣行，一起复一颠。\n京师费耗地，居止实重迁。\n俸料计月入，外得无几钱。\n却思已过分，仅免亲犁田。\n自望于古人，若地而升天。\n小庐焦生高，陋巷颜子贤。\n引之谕妻孥，吾道宜此焉。\n犹胜比邻者，寒突无晨烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7047,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西崦道友","author":"文同","text":"西崦入深窅，幽茅藏隐仙。\n虚窗画云篆，净几校灵编。\n绝巘耸玉干，危岩泻珠涎。\n相留饭青䭀，人世凡几年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7048,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观风阁","author":"文同","text":"危阁覆高林，晚步聊徙倚。\n东南两峰断，空阔见万里。\n茫茫落霞外，苒苒孤烟里。\n忽暗识归云，乍明知积水。\n风从半天下，月向平地起。\n夜久殊未还，峨冠露盈几。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7049,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"许中正捕龙雷","author":"文同","text":"彼龙胡为被天谪，不肯为天行雨泽。\n天敕雷公恣搜索，龙藏何所忽尔获。\n提之满空若曳帛，雹风电火相卷射。\n雷张两翅但拍拍，首尾挽之足双磔。\n龙力与雷固不敌，雷转威怒龙褫魄，须臾定见肝胃拆。\n万力千气凡几画，斯人斯品入神格。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7050,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"许道宁寒林","author":"文同","text":"许生虽学李营丘，墨路纵横多自出。\n交柯挥霍裴旻剑，乱蔓淋漓张晓笔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7051,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"访古寺老僧不遇书壁","author":"文同","text":"寂寂复寂寂，门前苔藓积。\n巾钵定何之，禅房封屈膝。\n蛛丝网窗户，蜗涎篆墙壁。\n欲去重迟留，空中望归锡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7052,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贞女吟","author":"文同","text":"身外无一簪，何以供铅华。\n饰行不饰容，浊水白藕花。\n藕心乱如丝，妾心圆如珠。\n丝乱端绪多，珠圆瑕颣无。\n焉得偶君子，奉之此高节。\n所生虽至亲，此意安可说。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7053,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过金鸡关","author":"文同","text":"关头气象古，关下风烟淡。\n春深草木活，岚重坑谷暗。\n禽声著部奏，花色成窠勘。\n归鞍虽若水，留此亦能暂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7054,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"问陈彦升觅古瓦砚","author":"文同","text":"魏主用死力，构彼铜雀台。\n当时台上瓦，百澄为一坯。\n烧成比坚玉，翠甲横崔嵬。\n西陵既归后，此地日以摧。\n后历典午朝，群雄力相豗。\n兹台既已倾，此瓦只自堆。\n岁久岸谷变，埋没深蒿莱。\n初谁得耕人，刳之研松煤。\n其理密且润，端歙真可咍。\n彦升所有者，一一皆珍材。\n自言欲购时，经岁无一枚。\n琴纹与锡花，此乃如琼瑰。\n前日秘阁下，重匣手自开。\n示我者佳绝，恰用一朴裁。\n形模甚古野，用可资怪魁。\n归来作诗乞，愿致无迟回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7055,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"问景逊借梅圣俞诗卷","author":"文同","text":"前日读子诗，快我烦病躯。\n若坐大暑中，琼杯饮琳腴。\n辞严意清绝，敢谓人所无。\n子乃不自高，尚尔尊圣俞。\n为我诵佳句，实亦郊岛徒。\n遂云有家藏，两轴如椽粗。\n我方嗜此学，常恨失所趋。\n愿子少假之，使之识夷途。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7056,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冷瓶","author":"文同","text":"海南有陶器，质状矮而?。\n云初日炙就，锻铄不以火。\n水壶丑突兀，酒甒肥磥砢。\n山罍颈微肿，石鼎足已跛。\n圆如鸱夷形，大比康瓠颗。\n华元腹且皤，王莽口何哆。\n蕃胡入中国，万里随大舸。\n携之五羊市，巾匮费包裹。\n侏㒧讲其效，泻辩若炙輠。\n课以沸泉沃，冰雪变立可。\n炙敲疗中渴，其用岂幺么。\n君凡几钱得，不惜持遗我。\n曾将对佳客，屡试辄亦果。\n勿云远且陋，幸可置之左。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7057,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吟春","author":"文同","text":"春工运潜巧，是处有行迹。\n庭梢发新颖，岩溜融暖脉。\n晴湖影拨剌，晓树音格磔。\n须知玉峰下，日有寻芳客。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7058,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"呈李坚甫中舍","author":"文同","text":"往年曾忆过长安，短纸书名诣门下。\n君时延我坐终日，洒扫东轩留看画。\n横图巨轴不知数，但见匣中时一把。\n甲犹未竟乙复作，门类著番开满架。\n使人叹羡不能已，只恨有门归隔夜。\n归来兀坐想精绝，念此荣观若为谢。\n就中寒林两大幅，此物世间谁敢价。\n倏然一别十五载，常向人前盛誇诧。\n因君奉使临敝邑，见先问此馀不暇。\n君能为我再讲说，座上不容人俗话。\n如君所蓄更谁有，有亦未能无笑骂。\n况君累世尽清职，摹本敢来前弄诈。\n君今还省正擢用，异日须求作邻舍。\n峨巾曳屦日相谒，更欲重烦开几帕。\n待寻前辈用心处，款曲应须频假借。\n每厨阅讫当便还，不敢奉欺言羽化。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7059,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吴趋曲 其三","author":"文同","text":"荡漾水中舟，徘徊岸边马。\n相看两不语，密意待谁写。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7060,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吾友务深有叹琴之什运使子骏答之佳章务深亦使余继作","author":"文同","text":"白水满方湖，山中好秋色。\n逋翁促瑶轸，来坐湖水侧。\n临风起高调，此兴浩无极。\n波静戢游鳞，云空矫飞翼。\n萧条变林野，万籁一以息。\n且莫缓商弦，令人涕横臆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7061,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"呈里中诸友","author":"文同","text":"君莫怪我不读书，君莫笑我不饮酒。\n更精文史岂足用，渐老欢娱复何有。\n负郭安得二百亩，举家已聚三十口。\n且来伴我数月闲，未几区区又西走。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7062,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宋复古度支晚川晴雪","author":"文同","text":"霁色变云林，寒光混烟水。\n遥山定何处，渺漭才可指。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7063,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"巫山高","author":"文同","text":"巫山高，高凝烟，十二碧簪寒插天。\n危岩绝壁已飞动，况复下压万丈之苍渊。\n波冲浪激作深井，虎眼彻底时一漩。\n长风澒涌发滟滪，恶色怒势因谁然。\n我欲截中流，虹梁莫得施?蜷。\n东西相远望不到，两目欲断心将穿。\n回看高唐庙下洒灵雨，遣我归意常翩翩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7064,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"弄珠亭下柳","author":"文同","text":"江柳早春前，濛濛弄紫烟。\n未容长作带，已见乱飞绵。\n远外分晴岛，深中泊暮船。\n惟应汉水色，奈尔一年年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7065,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"张少愚书院","author":"文同","text":"涧水侵断桥，车马不得通。\n飞岚积庭础，秋藓垂紫茸。\n窗纸烂溪雨，帘衣拆林风。\n主人殊未归，使我烟景空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7066,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"张骞冢祠","author":"文同","text":"中梁山麓汉水滨，路侧有墓高嶙峋。\n丛祠蓊蔚蔽野雾，榜曰博望侯之神。\n当年宝币走绝域，此日鸡豚邀小民。\n君不见武帝甘心事远略，靡坏财力由斯人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7067,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"忧居","author":"文同","text":"忧居向山林，虫鸟日为伍。\n形骸乍摧剥，骨肉惯辛苦。\n蔬盘羞客至，病榻厌人语。\n地僻谁往还，闲门闭深雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7068,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"折杨柳","author":"文同","text":"垂杨百尺临池水，风定烟浓盘不起。\n欲折长条寄远行，想到君边已憔悴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7069,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"旱雷","author":"文同","text":"夏旱亦已久，众惧非常灾。\n茫茫大田中，赤风起炎埃。\n密云徒满空，甘泽竟不来。\n但闻南山下，日日喧怒雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7070,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"李太尉","author":"文同","text":"昏雺翳紫极，横霓势光大。\n妖威集凶冀，忍秽实中赖。\n奸铓日增剡，谁汝触取害。\n骄根愈自固，所植利孱昧。\n容容彼群辅，窜伏皆鼠辈。\n侧视况未敢，肯复形叹慨。\n太尉汉中士，气引八极外。\n岌然处大麓，天下耸风采。\n自开煮饼祸，贼意已莫快。\n移书沥愤胆，语激益睚眦。\n罹冤卒用此，数与六九会。\n基兹被沈酷，燮免乃天贷。\n高忠揭万古，宇宙莫能载。\n垂晶耀简策，粪土视广戒。\n归来葬硗埆，祠冢兹俨在。\n宏垣敞深豁，巨木森晻暧。\n神灵皎如日，过者知再拜。\n同愚忝郡寄，公里曰境内。\n心期款举像，所顾官有碍。\n精衷托明酌，举手向东酹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7071,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"李生画鹤","author":"文同","text":"昂昂青田姿，杳杳在轻素。\n一身万里意，双目九霄顾。\n钐钐羽翮利，竦竦骨节露。\n君初本谁学，我恐必神悟。\n得于想像外，看在绝笔处。\n稷筌如复生，相与较独步。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7072,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"李道士惠琴轩集 其二","author":"文同","text":"寿宁孙老画壁下，当日偶同君此行。\n是时众里略一揖，自尔乃得君诗名。\n风驰雨绝十五载，此地忽尔相逢迎。\n见投琴轩两大集，宝匣金钥缄瑶琼。\n未开试使道所有，毛发寒竖肝胆惊。\n归来烧灯读至晓，句险字硬才力狞。\n君身长不满三尺，万象何术独手擎。\n嗟我气俗音韵浅，不敢与君相和鸣。\n聊书短歌报佳惠，它日愿将朝七璎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7073,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"村居","author":"林之奇","text":"日影满松窗，云开雨初止。\n晴林梨栗熟，晓巷儿童喜。\n牛羊深涧下，凫雁寒塘里。\n田父酒新成，瓶瓮馈邻里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7074,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杜逸人归龙山","author":"文同","text":"上亭北望二百里，颓巘堕壑围龙山。\n余尝往来见之喜，饮食梦寐皆孱颜。\n恨无羽翼一飞到，羡子长往不欲还。\n安得摆手掉世故，相与傲兀于其间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7075,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"极寒","author":"文同","text":"灯火宜冬杪，图书称夜长。\n帘钩挂新月，窗纸漏飞霜。\n酒醴惭孤宦，皮毛逐异乡。\n谁知旧山下，梅艳满东墙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7076,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"沙堤行","author":"文同","text":"金吾驰骑东复西，督兵万指平沙堤。\n传言筑路拜新相，恐与九衢同一泥。\n夜来上在蓬莱宿，手写姓名符梦卜。\n连诏黄门下北扉，趣草赞辞登力牧。\n平明剑佩罗东阁，大字满行书德业。\n谒者长言告紫宸，感召一庭和气合。\n上心喜曰予良弼，未谢急宣令直笔。\n群吏迎归政事堂，指顾之间歌画一。\n午漏初移催入马，宝带盘腰印垂胯。\n归来冠盖烂盈门，异口同音贺太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7077,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"芳树","author":"文同","text":"庭前有芳树，秾阴满轩碧。\n莫惜更携酒，醉此青春色。\n朝来见鶗鴂，飞鸣绕其侧。\n光景不可留，徒遣君叹息。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7078,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"芹叹","author":"文同","text":"清霜入寒溪，水迹落一尺。\n飞沙上芹叶，脆卷如燎炙。\n孤根抱生意，春泽守遗沥。\n愿奉野人荐，充君盘中实。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7079,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]