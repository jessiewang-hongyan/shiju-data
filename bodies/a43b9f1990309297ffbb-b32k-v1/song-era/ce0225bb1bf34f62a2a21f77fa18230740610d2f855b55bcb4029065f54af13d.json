[{"title":"睦州秀亭","author":"钱协","text":"秀色四时好，探春来此亭。\n花初拥槛发，山晚与云青。\n得鲙严陵濑，评泉陆羽经。\n欢馀不尽醉，鼓角限重扃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47201,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"甘棠楼","author":"钱协","text":"楼曲开三面，山重合四围。\n溪冲朝霭出，帆并夕阳飞。\n芳杜供春望，晴云渡袷衣。\n樊川犹未识，清兴莫忘归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47202,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"高峰寺","author":"钱协","text":"苒苒郡城东，穿云入几重。\n已穷难上路，才到最高峰。\n竹老龙孙瘦，泉甘马酒浓。\n何当来漱石，安稳饱疏慵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47203,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东馆楼","author":"钱协","text":"帘影隔朝暾，云低昼尚昏。\n山形分歙翠，溪色到江浑。\n日尽天垂幕，歌馀酒满尊。\n栏干不堪倚，归思断乡魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47204,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"玉泉庵","author":"钱协","text":"遥派落天潢，分崖射璧光。\n山从千古润，江得一源长。\n风雨无时作，珠玑满谷量。\n淄渑欲谁辨，愿借易牙尝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47205,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"分韵奉送中济侍郎出帅环庆得启字","author":"钱协","text":"除戎问边锁，谋帅系国体。\n遴简出丝缗，光华建旌棨。\n威谋重兼济，垢玩当一洗。\n游刃无全牛，岂复论肯綮。\n勇猛不为边，九伐秉周礼。\n行期凯歌还，宸廷聊聚米。\n游从惜暌离，合醵置甘醴。\n灵囿郁敷腴，天潢湛清泚。\n偕赋踵前修，银钩閟方底。\n从予轻若飞，吾方惭七启。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47206,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赴越书呈杭州熊侍郎","author":"钱协","text":"鉴湖清泚对胥山，两地相望一水间。\n共佩天涯太守印，犹联丹陛侍臣班。\n君方白傅才何愧，我比微之思苦悭。\n莫把旧诗犹见诧，繁雄未必胜清闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47207,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题万年妙莲阁","author":"钱协","text":"应真飞锡霭灵踪，智者遗杉尚灌丛。\n宝构迥临清鉴上，妙莲高擢污泥中。\n甚深秘藏资谈席，最上真乘振祖风。\n嗟我拘挛犹未历，坐驰神爽愧兴公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47208,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与辩才东坡道潜倡和诗","author":"钱协","text":"幻泡昧空色，真梦迷黄邱。\n宦学类狂走，尔来三十秋。\n齿发非他时，岁月不我留。\n古刹插乱石，蛰龙蟠霞湫。\n天人大导师，驻锡今白头。\n安住善护念，晚节非沉浮。\n昔尝同出处，未用相劣优。\n权寔分二乘，股肱均九流。\n今知搅搅者，讵得逍遥游。\n从兹许礼足，尚可治幽忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47209,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏辩才大师","author":"钱协","text":"辩才天人师，一意演说法。\n犹如一雨倾，药草皆萌达。\n瓮盎及湖海，各观天一月。\n以是度众生，报身随数灭。\n旧龛留香灯，想像瞻华发。\n应供无时穷，龙渊莫之竭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47210,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和阁老舍人曝书会","author":"钱协","text":"天禄图书府，芸签岁曝频。\n翻经穷藏室，赐会集儒绅。\n顾陆高标好，钟王妙入神。\n司无椠俗吏，来预石渠宾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47211,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送奉使钤辖高侯之任成都","author":"钱协","text":"烈士由来不徇名，西南万里不留行。\n熊罴训整屯千计，尊俎雍容镇百城。\n阃外使华新报聘，山西家法旧论兵。\n封侯富贵须由命，请访沈冥卖卜生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47212,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢子瞻内翰浙西开府","author":"钱协","text":"隽庭鸳鹭集珍丛，病翮摧颓下九门。\n罪戾我惭非昼锦，回翔公亦暂朱轮。\n龚黄政化知应尔，夔契谋谟想自存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47213,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题齐山寺壁","author":"钱协","text":"来逢采石连江雪，坐见齐山拂槛梅。\n惆怅佳人隔烟水，碧云空谷未归来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47214,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"钱协","text":"一来亦甘草，无使君子疑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47215,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"钱协","text":"敢云霹雳手，且免鹘鹭蹄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47216,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其三","author":"钱协","text":"梦泽盘山长卿赋，朱栏流水牧之诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47217,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其五","author":"钱协","text":"碧玉簪长生洞府，黄金杯重压银台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47218,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其六","author":"钱协","text":"列圣公规修盛典，万方和气助升烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47219,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵穆父兄见寄","author":"钱和","text":"乌衣巷里走双轮，正是家山二月春。\n明日湖平定归去，蓬莱还见谪仙人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47220,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浯溪","author":"钱和","text":"唐室中兴颂德碑，元颜文字孰宜为。\n天齐崖石磨镌久，万世功名不可隳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47221,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重题江干初雪图","author":"安焘","text":"曾游沧海困惊澜，晚涉风波路更难。\n从此江湖无限兴，不如祇向画图看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47222,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清明日赴玉津园宴集","author":"安焘","text":"帝眷三朝辅弼臣，诏颁禁籞燕慈均。\n已惊贵老恩荣厚，重叹优贤礼意新。\n使至屡闻天上语，酒酣想见洞中春。\n太平无事忘情久，更接人间事了人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47223,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"葛仙洞","author":"孙载","text":"九载功成驾鹤骈，空遗丹灶冷无烟。\n衣冠昔日犹埋冢，鸡犬当时亦上天。\n高步瑶池观日月，几经沧海变桑田。\n可怜黄野归来晚，留与人间作地仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47224,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"景泰禅阁","author":"孙载","text":"二山环合壁相重，禅阁攲危杳霭中。\n云塔孤标淩绝巘，石楼双峙耸晴空。\n灵泉冷透千岩翠，古木阴生万壑风。\n自笑尘劳促归思，懒将身世问禅翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47225,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题中阁","author":"孙载","text":"中阁犹追旧寺名，淩虚阑槛拂云平。\n烟迷勾漏烧丹灶，雨杂尚书旧履声。\n泉水几年明鉴曲，圳田一日布□枰。\n却收谢客寻山屐，且共禅师语此生。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47226,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"孙载","text":"地据淮西尽，江吞石壁宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47227,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"孙载","text":"云梦南州富物华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47228,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"碧岩亭和许门下韵","author":"王汝舟","text":"亭开幽谷草堂边，朝暮清音落槛前。\n人去日升蓬岛路，客来空爱玉溪泉。\n仙翁世界藏沈洞，佛子楼台出半天。\n谁为琢磨岩下石，拟将遗事记当年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47229,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"芦花","author":"王汝舟","text":"琵琶亭前夜泊舟，荻花瑟瑟风飕飕。\n浔阳夜静月如昼，琵琶寂寞江空流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47230,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"翠微峰","author":"王汝舟","text":"尘嚣十里清，秀岭半空插。\n萦纡疑无路，两石开一峡。\n豁然见天宇，四顾皆峭拔。\n入门上石级，伛偻如登塔。\n悬岩置楼殿，飞栋相匼匝。\n徐行云影动，低语谷声答。\n仰视绝壁间，势恐千仞压。\n侧身过幽谷，洞口若呀呷。\n仙英去何许，遗像寄山胁。\n浴池弄清泚，不敢着脚踏。\n顾余倦游者，一宿借云榻。\n天风吹夜籁，客兴亦萧飒。\n幽寻约重来，吾屐当再蜡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47231,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏归堂隐鳞洞 其一","author":"王汝舟","text":"先生名利比尘灰，绿竹青松手自栽。\n拟把一竿盘石上，幅巾闲过峡山来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47232,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏归堂隐鳞洞 其二","author":"王汝舟","text":"清时通退一何忙，抚志山西汉仲长。\n静觉眼根无俗物，翛然一室自焚香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47233,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏归堂隐鳞洞 其三","author":"王汝舟","text":"隐德家声累世闻，考槃幽涧作闲人。\n夭红过眼随荣谢，菊秀兰香自占春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47234,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏归堂隐鳞洞 其四","author":"王汝舟","text":"种竹淇园远致君，生平孤节负辛勤。\n需贤侧席非无意，地远言轻岂易闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47235,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"藏春秋","author":"王汝舟","text":"短楼矮阁小亭台，中有高人避世埃。\n寒翠自怜霜后竹，清香谁辨雪中梅。\n喧嚣祇为莺声巧，漏泄多应柳眼开。\n只恐藏春藏不得，东君勾勒下山来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47236,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和秦少游赠刘景文韵","author":"王钦臣","text":"每爱扬庄解荐雄，喜君归兴自江东。\n轩昂岂为兵家学，磊落真馀国士风。\n垂橐忽惊诗满卷，论文常负酒樽空。\n边州千骑新居上，莫忆鲈鱼记棹蓬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47237,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"召试学士院试罢作","author":"王钦臣","text":"翠木阴阴白玉堂，老来方此试文章。\n日斜奏罢长杨赋，闲拂尘埃看画墙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47238,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"魏宫弹棋局","author":"王钦臣","text":"邺城台殿付尘埃，玉局依然独未灰。\n妙手一弹那复得，宝奁当日为谁开。\n飘零久已抛红子，埋没惟斯近紫苔。\n此艺不传真可惜，摩挲聊记再看来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47239,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"使辽回竟恭敏李公席上作","author":"王钦臣","text":"穹庐三月已淹留，白草黄云见即愁。\n满袖尘埃何处说，李家池上海棠洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47240,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戏书长老院","author":"王钦臣","text":"蜀国相如最好辞，武皇深恨不同时。\n凌云赋罢还无事，寂寞文园兴可知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47241,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"述梦","author":"王钦臣","text":"晓雪谁惊最后时，土膏方得助甘滋。\n岁功已觉三元近，春事何忧一览迟。\n不著寒梅容触冒，半留红杏惜离披。\n神交彼此无劳辨，更为公题述梦诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47242,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵苏子由咏李伯时所藏韩干马","author":"王钦臣","text":"天闲不遇头亦垂，真姓本不求青丝。\n由来奇骨类奇士，立见俱似囊中锥。\n凤头初踏葱岭至，绣膊东由青海驰。\n春风宛转白玉镫，晚日照耀黄金羁。\n李侯对此意匠发，造物真比毫端奇。\n方歅之相岂可拟，颠倒未免雄称雌。\n翰林相继写高韵，何止羊何共和之。\n玉花照夜古称美，颜色乃是论其皮。\n固知神骏不易写，心与道合方能知。\n文章书画固一理，不见摩诘前身应画师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47243,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题万年妙莲阁","author":"王钦臣","text":"石桥飞锡断遗踪，挥麈谈禅想旧丛。\n万萼莲新青嶂外，十围松老白云中。\n他年宴坐开华构，当日咨承拟顺风。\n岁晚丹丘如可约，杖藜相引欲烦公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47244,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"奉送中济经略侍郎赴镇庆州得元字","author":"王钦臣","text":"远驭寡上策，羁縻有前言。\n平生徙戎论，感慨江应元。\n家世近三河，游历多塞垣。\n谁言一方面，十载滞上恩。\n前日诏书下，旌麾方及门。\n部曲已稍集，始知旗鼓尊。\n边书尚羽急，戍卒仍云屯。\n东山旧部落，自昔为墙藩。\n铦锋固可用，内实须禾虋。\n胸中自有策，肯为浅见论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47245,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游王官谷","author":"王钦臣","text":"钟鼎山林出处明，中间不合枉高情。\n有钱须买王官谷，流水声中过一生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47246,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"王钦臣","text":"谁知第七车中客，天遣归来助庆禋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47247,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"王钦臣","text":"西曹深处见春来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47248,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赞死心禅师偈 其一","author":"释惟久","text":"韶阳死心，灵源甚深。\n耳中见色，眼里闻声。\n凡明圣昧，后富前贫。\n利生济物，点铁成金。\n丹青徒状，非古非今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47249,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赞死心禅师偈 其二","author":"释惟久","text":"死心非真，真非死心。\n虚空无状，妙有无形。\n绝后再苏，亲见死心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47250,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读法界观","author":"释惟久","text":"物我元无二，森罗镜象同。\n明明超主伴，了了彻真空。\n一体含多法，交参帝网中。\n重重无尽意，动静悉圆通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47251,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"别诸禅众 其一","author":"向宗道","text":"四绝之名岂浪传，千岩万石五云间。\n无才可述无穷景，祇爱真山似假山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47252,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"别诸禅众 其二","author":"向宗道","text":"古殿琅珰木鱼响，匆匆策马长松间。\n回头却恨归时早，月淡烟昏不见山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47253,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宝华山","author":"向宗道","text":"松风山月送人归，几处溪声拂马蹄。\n殿角参差浦云隐，回头真似武陵迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47254,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"被诏还阙过碧落洞观元伯兄留题怅然久之兼成拙诗以纪胜概","author":"向宗旦","text":"洞府穹隆罩碧津，云扃岫幌谢嚣尘。\n泉声激激撞群玉，乳溜垂垂挂万巾。\n绝景多藏穷僻处，胜游少有放闲人。\n剥苔洗壁三遗刻，惆怅难兄笔尚新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47255,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"桐林驿","author":"向宗旦","text":"落日低垂一两竿，烟岚殊未厌跻攀。\n马头渐近铜林驿，误认真山做假山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47256,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"虎跑泉","author":"张彦卿","text":"乳泉发穴漏岩根，乱石成池溜始分。\n鸿渐当时高品第，虎跑今日信传闻。\n山僧勺供疑甘露，野史烹茶胜白云。\n应是灵源迟出地，不然须冠季卿文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47257,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"司马太史庙 其一","author":"李奎","text":"生在龙门境，葬临韩奕坡。\n荒祠邻后土，孤冢压黄河。\n澽水愁声远，梁山惨色多。\n一言遭显戮，将奈汉君何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47258,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"司马太史庙 其二","author":"李奎","text":"著书虽已先三史，论道如何后六经。\n因雪李陵为国士，岂期武帝有宫刑。\n丛生荆棘迷坟冢，旧画龙蛇照庙庭。\n为览遗文来一奠，不知何在子长灵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47259,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贾司仓祠","author":"赵嗣业","text":"抱负如公屈不伸，古来无有达诗人。\n声名岂似官资小，才调宁如掾俸贫。\n东野旧称涛涌骨，退之曾说胆过身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47260,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中山广轩","author":"刘握","text":"天边登览处，雕槛俯层岑。\n山到三吴尽，江连百粤深。\n柳烟含晚色，花雨伴春阴。\n骚雅知多助，清虚在当心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47261,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"刘握","text":"玉乳何年终始见，金沙畴昔谩曾闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47262,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"郭知古","text":"塞草远连吴会去，羁怀易逐峡江平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47263,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"通山洞","author":"林通","text":"为爱通山景致幽，携琴载酒任遨游。\n云封路径人烟少，翠拥峰峦树木稠。\n棋石闲敲偏自乐，新诗赋就顿忘忧。\n管他世个尘凡事，春自春来秋自秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47264,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"石床","author":"林通","text":"一榻涵虚洞，冈峦势若堆。\n梦魂迷蛱蝶，枕簟锁莓苔。\n白昼晴宵里，清风明月来。\n欲知卧云趣，不必意崔嵬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47265,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"平江亭邀冯山允南同作","author":"赵衮","text":"文公昔记滕王阁，气象终天拂寥廓。\n崔颢题诗黄鹤楼，今日声华还磊落。\n安汉城头有佳处，江山清气归帘幕。\n少陵无人谪仙死，不遇才豪终寂寞。\n苍苔满地荆棘生，梁栋尘埃喧鸟雀。\n风流贤守一登临，久倚阑干情不薄。\n夜来风月觉澄清，天意人心如素约。\n仙葩当见浮空来，几百年来无此作。\n嗟予好古今白头，到底支离材力弱。\n木桃或见致琼瑶，免对江山负惭作。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47266,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"王安上","text":"历阳城外桃花坞，台榭废来名已古。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47267,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"王安上","text":"日往月来时已久，万古千年名不朽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47268,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其三","author":"王安上","text":"战士触热冲暑雾，舌燥唇乾惮长路。\n将军马上设良谋，遥望青山指梅树。\n齿牙不觉流津津，比似投醪同饮醇。\n汉鼎未扶竟分裂，惜哉不是调羹人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47269,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"王彦博","text":"黄须战士据鞍听，白发将军抚剑叹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47270,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]