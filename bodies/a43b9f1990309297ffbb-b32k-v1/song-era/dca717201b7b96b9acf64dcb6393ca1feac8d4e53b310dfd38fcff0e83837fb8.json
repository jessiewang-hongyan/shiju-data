"notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21979,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湖上 其一","author":"史尧弼","text":"浪汹涛翻忽渺漫，须臾风定见平宽。\n此间有句无人得，赤手长蛇试捕看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21980,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题南岳方广后洞五百罗汉所居二绝 其二","author":"史尧弼","text":"山自周回溪自流，沉沉万籁不胜幽。\n此间有句谁堪话，五百真人今在不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21981,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题南岳方广后洞五百罗汉所居二绝 其一","author":"史尧弼","text":"岳势扶舆峻莫攀，岂知深处锁幽闲。\n千岩万壑争回互，别有乾坤藏此间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21982,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题南岳祝融峰","author":"史尧弼","text":"祝融峰上蹑云根，咫尺苍霄欲手扪。\n闻道东山曾小鲁，洞庭今已一毛吞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21983,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题墨花","author":"史尧弼","text":"元功初剪刻，妙处极玄玄。\n醉墨谁家笔，于今合自然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21984,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"古松","author":"史尧弼","text":"人之生也直，此物自长年。\n雾雨晦深谷，风云乘半天。\n扶危正须尔，得道亦超然。\n惨澹空回盼，长吁立暝烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21985,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"孙致平尊人挽诗","author":"史尧弼","text":"再见书楼氏，风流继六贤。\n素轻千户拟，还守一经传。\n好学嗟亡矣，伤心为衋然。\n郎君今二妙，早晚慰深泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21986,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"师伯浑至青神约访而潜归以诗相别因戏之","author":"史尧弼","text":"开门脱兔岂非痴，空费追亡急作诗。\n雪月会知思戴老，枣瓜方欲问安期。\n梦魂莫逐人千里，遥夜还同月一规。\n此去相过吾得计，定应掎角待伊尼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21987,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟过黄州上赤壁因怀东坡偶题","author":"史尧弼","text":"赤壁今朝过，苍梧几日期。\n天旋疑水远，风怒恐樯危。\n断岸馀千丈，英雄只一时。\n多情雪堂老，月白夜探奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21988,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杨夫人挽诗","author":"史尧弼","text":"奉嫔归盛族，观奠及遗芳。\n藻已空南涧，萱应茂北堂。\n人间空堕骥，地下复鸣凰。\n惨惨闻吹棘，纷纷想断肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21989,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"癸亥秋陪张丞相游西湖和周去华机宜韵二首 其二","author":"史尧弼","text":"幸陪双绝巘，偶念莽苍间。\n野旱经时赤，行云尽日闲。\n萧萧看脱木，悄悄对空山。\n几欲兼忘去，江湖独往还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21990,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"癸亥秋陪张丞相游西湖和周去华机宜韵二首 其一","author":"史尧弼","text":"天上辞魁柄，拂衣岩石间。\n乾坤双眼静，日月一身闲。\n目极朝东水，心怀直北山。\n应怜沙际雁，亦解向阳关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21991,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"胡氏旧游临行赠别二章 其二","author":"史尧弼","text":"妙契还从盖始倾，无言与共四时行。\n可堪岁晚仓皇别，多谢诗来缱绻情。\n最喜伊家三树秀，故应我辈一经横。\n人间定价如金玉，入眼那能较重轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21992,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"胡氏旧游临行赠别二章 其一","author":"史尧弼","text":"孤枕怀归夜夜倾，闭关犹作旅人行。\n绝知半路能游客，难忍终年欲别情。\n雪里梅花逢的皪，风前木叶任纵横。\n一鞭明日三岩路，可是泠然马足轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21993,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送青神宰樊允南解官次杜应求韵 其四","author":"史尧弼","text":"并辔中岩寺，芳樽一破愁。\n更寒谭衮衮，云晓玉浮浮。\n会有相从乐，还如此地不。\n合离真有数，那敢作人谋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21994,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送青神宰樊允南解官次杜应求韵 其三","author":"史尧弼","text":"从昔安平易，无心问疾迟。\n才知中自守，不逐世多岐。\n赫赫宁期誉，悠悠去有思。\n丰碑人口是，看取祖行诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21995,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送青神宰樊允南解官次杜应求韵 其二","author":"史尧弼","text":"簿领侵寻地，淹留寄此乡。\n相逢谭笑共，不觉岁年长。\n物色重阳近，秋高万象藏。\n赋归三径里，篱菊有馀香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21996,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送青神宰樊允南解官次杜应求韵 其一","author":"史尧弼","text":"折腰真漫尔，掉鞅忽班如。\n心委身来去，人怀政卷舒。\n宦游三釜计，臭味一编书。\n此道傥同趣，何曾有别欤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21997,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送谯允蹈解青神赴永康学官二首 其二","author":"史尧弼","text":"亦有澹台者，时升单父堂。\n匆匆能几见，忽忽两相忘。\n明日舞雩地，薰风编简香。\n策勋归圣域，此道久微茫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21998,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送谯允蹈解青神赴永康学官二首 其一","author":"史尧弼","text":"簿领尘埃地，淹回岁月阑。\n青山应有素，去路肯留难。\n吏隐宁官冷，心清则体胖。\n不嫌时拄笏，三十六峰寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21999,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽刘中远侍郎 其一","author":"史尧弼","text":"神主多艰日，归安九庙中。\n忌才终引去，退卧敢论功。\n未省真忘世，尝疑数悟空。\n欲咨黄发老，几杖合扶公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22000,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽刘中远侍郎 其三","author":"史尧弼","text":"沄沄绿水边，丈室一萧然。\n顾陆留青箬，宗雷老白莲。\n研朱看点易，摇麈听谈玄。\n忽忽风流尽，长怀晋宋前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22001,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽刘中远侍郎 其二","author":"史尧弼","text":"精神曾感会，帝念老臣馀。\n内阁升严直，褒章赐命书。\n同时那得有，回首却成虚。\n露电从渠过，吾游自物初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22002,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽刘中远侍郎 其四","author":"史尧弼","text":"故国馀乔木，萧条今作哀。\n舂容思曩昔，怀抱复谁开。\n浩劫真难诘，微言不重陪。\n未忘吾里在，华表一归来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22003,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽宋邑宰","author":"史尧弼","text":"充宇蝇头字，寒更豹体膏。\n当时书雁塔，晚岁试牛刀。\n便作泉台去，难酬雪案劳。\n凤雏家学在，飞翥看秋高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22004,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽李提刑久善 其四","author":"史尧弼","text":"梦寐平生杖屦从，惯看高论吐长虹。\n滕王阁畔樽罍共，房琯湖中啸咏同。\n忍乡西州悲谢傅，空期斗酒酹桥公。\n缄诗髣髴招英爽，泪湿西风未有穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22005,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽李提刑久善 其二","author":"史尧弼","text":"大江南畔按澄初，兵弄潢池悉就俘。\n坐使奔鲸无脱网，当时悬鼓不鸣桴。\n后来盗起螺川震，却恨公归蜀道趋。\n但使国侨长在郑，定知卖剑化萑蒲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22006,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽李提刑久善 其一","author":"史尧弼","text":"绝知嗣法一枝香，作意开堂嗣雪堂。\n早悟锥沙传笔画，旋收珠玉入诗囊。\n卷藏人閟龙蛇字，炳蔚家馀虎豹章。\n衣钵两郎公不恨，班班文物未凄凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22007,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽李提刑久善 其三","author":"史尧弼","text":"曩持玉节问痌瘝，邂逅南昌一解颜。\n亲见疮痍摩手拊，夜深父子短檠间。\n行装约束有琴鹤，道力较量无素蛮。\n自合明光将剑履，如何零落遂丘山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22008,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽邑令王公","author":"史尧弼","text":"君家家学有传衣，事业如何只漫违。\n九万鹏程终莫上，一双凫舄叹频飞。\n空传是处棠阴布，倏作朝来薤露稀。\n楚些莫愁招不得，山头骑鹤看来归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22009,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽彦承知监","author":"史尧弼","text":"蚤年独出弃繻关，肯作辕驹老故山。\n澒洞烟尘尝解难，从容矢石敢投艰。\n尚馀长短苏张术，不值风云楚汉间。\n还想湖湘对床酌，泪滂原草不胜斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22010,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽故眉守张廷琛 其一","author":"史尧弼","text":"伊人湖海士，夙昔想风流。\n决策元戎幕，宣威塞北秋。\n分辽空往恨，保蜀尚前筹。\n落寞三刀梦，真成取次休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22011,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽故眉守张廷琛 其二","author":"史尧弼","text":"碣石峥嵘岁，何如扣帝阍。\n狼烟今昼晦，鲸海正波翻。\n遗恨公流涕，当时独抗言。\n荒阡新宰木，谁酹曲江魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22012,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽故眉守张廷琛 其三","author":"史尧弼","text":"公典吾州日，人怀不忍欺。\n辕攀那复得，巷哭竟成悲。\n外祖松楸在，空山草木萎。\n魂游傥来否，尚作凯风思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22013,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]