[{"title":"次韵周希稷饷耕三绝句 其一","author":"王庭圭","text":"初下车来首劝耕，老农争走道边迎。\n欢声便似承平日，不待期年政已成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5568,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵周希稷饷耕三绝句 其二","author":"王庭圭","text":"夜闻催饷不成眠，遥望官壶眼欲穿。\n醉倒田间真快乐，念无田者益堪怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5569,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵周希稷饷耕三绝句 其三","author":"王庭圭","text":"莫厌行春马足劳，弹琴吟咏节弥高。\n尽驱赤子持田器，勿使潢池烦贼曹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5570,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠写真刘琮 其一","author":"王庭圭","text":"会写峨眉玉局真，远看前辈画麒麟。\n此翁此画不常有，宜并银钩绝世珍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5571,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠写真刘琮 其二","author":"王庭圭","text":"布袜青鞋倚瘦松，我生骨相真生穷。\n烦君画著渔船上，刺入卢江烟雨中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5572,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠写真刘琮 其三","author":"王庭圭","text":"画作萧然物外身，笔端如此有风神。\n蹇骑破帽江南岸，不是寻常行路人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5573,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送风雅长老","author":"王庭圭","text":"集云回雁两峰前，木马嘶风鹤唳天。\n他日归来无一事，却教谁出草鞋钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5574,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送胡绍立往高陂游学","author":"王庭圭","text":"天下干戈未尽稀，独骑瘦马苦吟诗。\n穷山窟里携书剑，半夜不眠听鼓鼙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5575,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游湖头观桃花行数里弥望不绝有僧新开兰若于万花之中留三绝句书辩公房 其一","author":"王庭圭","text":"十里红香衬马蹄，更穿林樾访僧扉。\n烟长草远望不断，忽有钟声出翠微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5576,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游湖头观桃花行数里弥望不绝有僧新开兰若于万花之中留三绝句书辩公房 其二","author":"王庭圭","text":"城内僧来城外住，寺边花隔寺中篱。\n花开花落春如许，宴坐深房总不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5577,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游湖头观桃花行数里弥望不绝有僧新开兰若于万花之中留三绝句书辩公房 其三","author":"王庭圭","text":"方丈前林万木春，桃花面目更尖新。\n为师拈出灵云话，却恐桃花解笑人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5578,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"欧阳公制粮尽扣门索米戏书绝句送之","author":"王庭圭","text":"闻道瓶中无积粟，不忧甑里有尘埃。\n饥时且就我索食，更恐胡奴送米来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5579,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵赵逢源秋日溪居十绝 其一","author":"王庭圭","text":"溪面微凉生晚风，山衔落日半边红。\n临流解赋归来句，知是柴桑避俗翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5580,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵赵逢源秋日溪居十绝 其二","author":"王庭圭","text":"门外仙槎泛急湍，应从霄汉落银湾。\n归来不记河源路，风雾凄凄月满山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5581,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵赵逢源秋日溪居十绝 其三","author":"王庭圭","text":"水边楼上最宜秋，天在阑干四角头。\n觅句正缘偿宿债，著书元不为穷愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5582,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵赵逢源秋日溪居十绝 其四","author":"王庭圭","text":"仙人山水古今无，画妙诗工可得俱。\n论画已非前辈手，声诗能作辋川图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5583,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵赵逢源秋日溪居十绝 其五","author":"王庭圭","text":"出水芙蓉天与工，六郎何事比花红。\n后生不识李元礼，试听长松引劲风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5584,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵赵逢源秋日溪居十绝 其六","author":"王庭圭","text":"南岭浮云过北岭，东溪流水入西溪。\n秋容清澹石骨露，更看明年浪拍堤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5585,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵赵逢源秋日溪居十绝 其七","author":"王庭圭","text":"昔人万里醉为乡，暮越朝燕不裹粮。\n却怕醒来尘外出，千艘衔尾夜鸣榔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5586,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵赵逢源秋日溪居十绝 其八","author":"王庭圭","text":"鸦翻日影弄清溪，溪上危巢鸣哺儿。\n林下西风晚来急，满身木叶碎琉璃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5587,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵赵逢源秋日溪居十绝 其九","author":"王庭圭","text":"千寻塔影照江清，古殿金龙蟠绣楹。\n秋色排门入萧寺，闲来饭后听钟声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5588,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题画鲤鱼","author":"王庭圭","text":"谁把吴松江剪断，得此鲤鱼长尺半。\n会逢李白过江来，骑上青天游汗漫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5589,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"适从县门下经西湖上归见竹间桃花盛开湖上景物一新因成两绝句呈向宰 其一","author":"王庭圭","text":"彭泽门前惟有柳，河阳县里只栽花。\n如今夹竹开桃李，犹似当年刺史家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5590,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"适从县门下经西湖上归见竹间桃花盛开湖上景物一新因成两绝句呈向宰 其二","author":"王庭圭","text":"何处春深刺史家，园林犹锁晋朝花。\n风烟况接西湖水，重起书斋对郡衙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5591,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再次韵二绝句 其一","author":"王庭圭","text":"墙根巨竹新生笋，竹下小桃初试花。\n竹色花光正如此，香风吹落几千家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5592,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再次韵二绝句 其二","author":"王庭圭","text":"新竹高斋凝燕寝，从教细雨落檐花。\n青山绿水中为县，卧拥黄紬听打衙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5593,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵韩宰上元二绝句 其一","author":"王庭圭","text":"火炬银花照眼明，乱来谁得见升平。\n邦君解与民同乐，海上初移不夜城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5594,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵韩宰上元二绝句 其二","author":"王庭圭","text":"伤时此夜忆神京，月照鳌山辇道平。\n朱雀街门旧行路，星毬飞上凤凰城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5595,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和刘英臣见寄二绝句 其一","author":"王庭圭","text":"诸葛奇才当十倍，谪仙词句满三千。\n我惟闭阁扪书册，扫地烧香亦静便。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5596,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和刘英臣见寄二绝句 其二","author":"王庭圭","text":"胸吞云梦欲八九，日诵古书常数千。\n撑拄枯肠只堪睡，从君嘲我腹便便。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5597,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"幽兰寄向文刚二绝句 其一","author":"王庭圭","text":"西风黄叶深林下，忽有新兰动地香。\n公子夜寒谁对语，应容幽客到书房。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5598,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"幽兰寄向文刚二绝句 其二","author":"王庭圭","text":"连夜风吹碧玉枝，山深寒重得香迟。\n穷秋故出迈往韵，要就高人觅好诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5599,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵黄超然","author":"王庭圭","text":"楚词赋物取香草，众草犹须避国香。\n一辱雕章重题品，何惭清庙荐芝房。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5600,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪中遇胡烈臣归自郴阳戏成一绝","author":"王庭圭","text":"路傍有客骑牛过，乞与蓑衣作席眠。\n邂逅若能相顾问，和公画上钓鱼船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5601,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"衡岳铨德观作 其一","author":"王庭圭","text":"峰头乌帽翠云裘，三百年来无此流。\n馀论更容平子否，犹胜湛辈岘山游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5602,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"衡岳铨德观作 其二","author":"王庭圭","text":"碧玉峰前云满径，赤栏桥畔柳参天。\n长廊静夜松风起，写得馀声入响泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5603,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"清江张氏活人堂二绝句 其一","author":"王庭圭","text":"远系长沙太守孙，家传太守活人言。\n刀圭一粒起人死，安得声名不出门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5604,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"清江张氏活人堂二绝句 其二","author":"王庭圭","text":"海底龙宫失护防，老龙偷得返魂方。\n闻君夜压春槽响，携扣柴门乞酒浆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5605,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵谢昌国","author":"王庭圭","text":"今人不识古人心，谁识羲皇太古音。\n如望银河九天上，聊分一勺濯尘襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5606,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"双田逢萧国器话别","author":"王庭圭","text":"黄叶西风何处村，茅檐立马问寒温。\n江东渭北情无限，樽酒他时得细论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5607,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和康晋侯见赠","author":"王庭圭","text":"儒生无力荷干戈，乱后篇章感慨多。\n但拿笔头吟白雪，莫挑马箠渡黄河。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5608,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪中以酒送欧阳广明袁叔明","author":"王庭圭","text":"小槽新压瓮头春，盛欲招呼雪闭门。\n卧对袁郎说周易，不妨伸颈饮清樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5609,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"鄱阳周师禹求清轩雾斋诗二首 其一","author":"王庭圭","text":"月入柴门夜色新，坐坚谈垒足佳宾。\n谁云老子兴不浅，政恐元规尘污人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5610,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"鄱阳周师禹求清轩雾斋诗二首 其二","author":"王庭圭","text":"细雨如烟下九垓，始闻岩谷隐奇才。\n一朝文彩惊人眼，知自南山雾里来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5611,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送彭士贵 其一","author":"王庭圭","text":"诏谓将军急击戎，连营已列汉旗红。\n须君磨盾作露布，破阵谁先第一功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5612,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送彭士贵 其二","author":"王庭圭","text":"大将威名震九州，毛锥何补剑鎗头。\n但歌出塞从军乐，莫笑居乡马少游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5613,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"刘天锡之子八岁能作大字今年十三矣笔画愈进有雄健之气作二绝句赠之 其一","author":"王庭圭","text":"群儿墨汁翻老鸦，尔独落纸生龙蛇。\n郎罢不须频掣笔，渠今自会画江沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5614,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"刘天锡之子八岁能作大字今年十三矣笔画愈进有雄健之气作二绝句赠之 其二","author":"王庭圭","text":"作戈如挽百钧弩，腕力想能回万牛。\n江夏当年有童子，未闻落笔写银钩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5615,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"郊外留别友人","author":"王庭圭","text":"不及匆匆把一卮，丹枫黄叶助题诗。\n天教远谪非无意，更上沅湘看九疑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5616,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄刘世臣仲美","author":"王庭圭","text":"此道陵迟久已亡，后生无复立门墙。\n遥知二子心如铁，端为卢溪一瓣香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5617,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠无识道人","author":"王庭圭","text":"古庙香炉冷似冰，向来土木弄精灵。\n如今万事都不会，却笑金刚努眼睛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5618,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谢张东言","author":"王庭圭","text":"忽见蛟蛇绕壁蟠，归时星斗已阑干。\n山童不识回鸾字，误认题门作凤看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5619,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"惜春亭观酴醾","author":"王庭圭","text":"东皇收拾春归去，独遣酴醾殿后尘。\n怜我寒窗赋愁寂，时看玉面送残春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5620,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"彭青老好谈禅喜作诗西宁诗有谋身之语借其语激之三首 其一","author":"王庭圭","text":"未省前身是道人，莫嗟求仕困无津。\n东风动地泥牛吼，檐卜花开别是春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5621,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"彭青老好谈禅喜作诗西宁诗有谋身之语借其语激之三首 其二","author":"王庭圭","text":"未能投笔取封侯，一食聊须为口谋。\n日向晴窗研破砚，读书当读亿那由。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5622,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"彭青老好谈禅喜作诗西宁诗有谋身之语借其语激之三首 其三","author":"王庭圭","text":"好诗浑厚如金玉，妙质勿令斤斧侵。\n要识笔端三昧力，夜深山水自成音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5623,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"渔父词","author":"王庭圭","text":"冥冥江雨湿蓑衣，夜上高岩宿翠微。\n梦断一声烟草绿，遥闻款乃扣舷归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5624,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"曦上人顷脱尘网可谓俊哉衲僧也绝句赠之","author":"王庭圭","text":"震林狮子非凡兽，脱网鲤鱼真衲僧。\n宿垢消磨应已尽，竿头海底任横行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5625,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游沅陵刘道人庵中唯一禅椅不置卧榻云不睡四十年矣戏作二绝 其一","author":"王庭圭","text":"一庵茅屋白云深，坐待丹砂欲变金。\n谁信庵中人不睡，满池春水听龙吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5626,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游沅陵刘道人庵中唯一禅椅不置卧榻云不睡四十年矣戏作二绝 其二","author":"王庭圭","text":"九曲江边云欲净，三更海上月华孤。\n金刀直入沧溟底，夺得骊龙颔下珠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5627,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵陈君授暮春感怀","author":"王庭圭","text":"雨馀山鸟百般啼，烟隔桃蹊一线微。\n南北东西春总好，杜鹃何苦劝人归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5628,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"辰州马观察送酒二首 其一","author":"王庭圭","text":"壶头直下开边郡，勋业谁如马伏波。\n还见远孙持汉节，坐令千骑拥雕戈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5629,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"辰州马观察送酒二首 其二","author":"王庭圭","text":"倒尽邻翁老瓦缸，使君忽送玉为浆。\n昌黎对月无诗酒，绝句聊酬马侍郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5630,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"董仲仪来夜郎访死生二首 其一","author":"王庭圭","text":"雪霾鬼葬山头路，雾失鬼门关外村。\n不谓故人千万里，忽携书册夜敲门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5631,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"董仲仪来夜郎访死生二首 其二","author":"王庭圭","text":"我识君家董状元，草莱崛起跳天门。\n挥毫玉陛摩星斗，持橐明光奉至尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5632,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵酬国子生赵秀才四绝句 其一","author":"王庭圭","text":"渊明五柳非无宅，子美西枝自有村。\n堪笑长安近时客，纷纷骑马傍谁门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5633,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵酬国子生赵秀才四绝句 其二","author":"王庭圭","text":"入关莫恋铜驼陌，待诏行趋金马门。\n场屋若归丞相府，可无公道得推尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5634,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵酬国子生赵秀才四绝句 其三","author":"王庭圭","text":"羡君将入银蟾窟，容我归耕谷口村。\n遥想明年春殿下，胪传先出九重门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5635,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵酬国子生赵秀才四绝句 其四","author":"王庭圭","text":"圣主方今举八元，何人复扫相君门。\n迂生曲士如丘垤，回首方知泰华尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5636,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"程子山侍讲自靖州贬所归相会于武陵怪余颜鬓未改作四绝句示之 其一","author":"王庭圭","text":"误读黄庭玉字章，醉翻王母九霞觞。\n从兹一堕人间世，独赖宽恩谪夜郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5637,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"程子山侍讲自靖州贬所归相会于武陵怪余颜鬓未改作四绝句示之 其二","author":"王庭圭","text":"问我何年谪夜郎，尚馀疏发未成霜。\n梦朝玉帝窥香案，偷得神仙不死方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5638,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"程子山侍讲自靖州贬所归相会于武陵怪余颜鬓未改作四绝句示之 其三","author":"王庭圭","text":"欲吊沈湘乏雅章，借君妙语酹馀觞。\n已知绝倒如平子，更喜清新似庾郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5639,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"程子山侍讲自靖州贬所归相会于武陵怪余颜鬓未改作四绝句示之 其四","author":"王庭圭","text":"莫把莲花比六郎，六郎元自不禁霜。\n君看磥砢松千尺，高节参天孰可方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5640,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次前韵酬赵提干二首 其一","author":"王庭圭","text":"解作新诗似乐章，交情风味敌壶觞。\n平生阅士知多少，耸壑昂霄见此郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5641,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次前韵酬赵提干二首 其二","author":"王庭圭","text":"留滞沅湘见此郎，气如九月雁横霜。\n麻鞋踏雪穿沙底，赐履他年出上方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5642,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]