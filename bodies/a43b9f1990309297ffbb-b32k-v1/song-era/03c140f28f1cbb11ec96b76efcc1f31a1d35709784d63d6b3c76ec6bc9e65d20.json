[{"title":"内当","author":"杨亿","text":"芝泥初熟诏书成，红药翻阶昼景清。\n屋瓦生烟宫漏永，时闻幽鸟自呼名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70687,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"史馆杨嵎学士以诗话及空门之事次韵和之","author":"杨亿","text":"双树金言付嘱频，阎浮外护托王臣。\n谁知天禄草玄客，曾是灵山受记人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70688,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戊申年七夕五绝 其五","author":"杨亿","text":"玉女壶倾笑电频，白榆晴影接星津。\n神光奕奕云容薄，谁见凌波袜起尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70689,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戊申年七夕五绝 其一","author":"杨亿","text":"六幕西回斗转车，鲜云点缀玉钩斜。\n天孙已渡黄姑渚，阿母还来汉帝家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70690,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戊申年七夕五绝 其四","author":"杨亿","text":"神女欢娱一夕休，月娥孀独已千秋。\n争如灵匹年年会，莫恨牛津隔凤辀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70691,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戊申年七夕五绝 其二","author":"杨亿","text":"明河左界鹊南飞，汉苑高楼正曝衣。\n一夕匆匆停弄杼，谁将锦石暂支机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70692,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"白莲","author":"杨亿","text":"昨夜三更里，嫦娥坠玉簪。\n冯夷不敢受，捧出碧波心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70693,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"李御史","author":"杨亿","text":"清晓乘骢出九逵，内朝簪笔坐前墀。\n天家御史非凡格，曾向昆崙服众芝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70694,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诗一首","author":"杨亿","text":"沤生复沤灭，二法本来齐。\n要识真归处，赵州东院西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70695,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金马","author":"杨亿","text":"茂异纷纶集汉庭，求贤诏在竹书青。\n共趋金马门前路，谁识东方是岁星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70696,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贻诸馆阁","author":"杨亿","text":"闻戴宫花满鬓红，上林丝筦侍重瞳。\n蓬莱咫尺无因到，始信仙凡迥不同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70697,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送钱易","author":"杨亿","text":"霜叶飞梁苑，风樯指上饶。\n江山应有助，别恨寄兰苕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70698,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送禅床与枢密王左丞","author":"杨亿","text":"北祖安禅唯看净，毗邪升座更谈空。\n须知密勿万机外，常在瑜伽三昧中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70699,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闺思","author":"杨亿","text":"征夫万里戍交河，塞外萧条朔气多。\n古壁暗蛩催夜织，朝来一叶下庭柯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70700,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留别","author":"杨亿","text":"梦笔山前君别我，下沙桥上我思君。\n黄昏更过西阳岭，满目青山与白云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70701,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读史学白体","author":"杨亿","text":"易牙昔日曾蒸子，翁叔当年亦杀儿。\n史笔是非空自许，世情真伪复谁知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70702,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"傀儡","author":"杨亿","text":"鲍老当筵笑郭郎，笑他舞袖太郎当。\n若教鲍老当筵舞，转更郎当舞袖长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70703,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"虎丘山","author":"蒋堂","text":"林端生色美新晴，楼阁依山若画屏。\n石坐最宜人选胜，剑池潜想地遗灵。\n僧窗松竹冬犹茂，寺路烟霞昼亦冥。\n自愧逾年假麾守，一回方得扣禅扃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70704,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丁集贤通判馀杭","author":"杨亿","text":"辽东羽客富仙材，仙殿飞觞接上台。\n便道归宁白蘋渚，经时赐对柏梁台。\n里中驱弩先行路，膝下斑衣庆寿杯。\n明诏许令过别墅，不忧郡阁简书催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70705,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七夕","author":"杨亿","text":"东西燕子伯劳飞，新月如钩玉露垂。\n河鼓天孙信灵匹，鹊桥星渚有佳期。\n穿针乞巧伫立久，织素成章报答迟。\n定与黄姑享偕老，晋宫休插奈花枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70706,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七夕","author":"杨亿","text":"金壶漏滴正迢迢，灵匹相从在此宵。\n月魄婵娟乌绕树，河流清浅鹊成桥。\n云轻天上榆花没，风细炉中麝炷飘。\n寂寞堪怜观渡女，无眠耿耿望青霄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70707,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七夕","author":"杨亿","text":"清浅银河暝霭收，汉宫还起曝衣楼。\n共瞻月树怜飞鹊，谁泛星槎见饮牛。\n弄杼暂应停素手，穿针空待贶明眸。\n匆匆一夕填桥苦，不似人间有造舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70708,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十九哥赴舒州太湖簿仍得假归乡","author":"杨亿","text":"初官佐邑少嗟咨，且喜乡关得告归。\n松菊门前三径在，烟波江上片帆飞。\n枌榆旧社虽堪恋，星火严程不可违。\n莫为栖鸾尚卑屑，悔将锦袄换蓑衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70709,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上元夜会慎大詹西斋分题得歌字","author":"杨亿","text":"帝里风光上元节，乌衣旧巷喜经过。\n樽中酒渌宁辞醉，梁上尘飞只欠歌。\n坐听禁城传玉漏，起看河汉转金波。\n主人爱客春宵永，彩笔题诗奈乐何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70710,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与客启明","author":"杨亿","text":"越客逃名误凿坯，汉庭初聘碧鸡才。\n操心四十知无惑，削牍三千耻自媒。\n苦吟多年依洛社，赋成他日上兰台。\n郡斋悬榻流尘满，七见东风落楚梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70711,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"义门胡生南归","author":"杨亿","text":"南国乌衣族，东京伯始孙。\n一枝须折桂，六阙旧旌门。\n归思鲈鱼脍，离筵竹叶樽。\n秋风正摇落，楚客莫销魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70712,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夕阳","author":"杨亿","text":"夕籁起汀葭，秋空送目赊。\n绿芜平度鸟，红树远连霞。\n水阔迷归棹，风清咽迥笳。\n高楼未成下，天际玉钩斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70713,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大名府大安阁主道者","author":"杨亿","text":"释子修行与众殊，铜台连接起精庐。\n群公共结二林社，万乘曾回六尺舆。\n衣惹天香亲御座，阁成云构倚晴虚。\n浮生自恨犹贪禄，未得同翻贝叶书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70714,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大理赵寺丞世长知益州华阳县","author":"杨亿","text":"帝选循良抚远民，由来百里应星辰。\n征车蜀道闻猿苦，祖帐西郊落叶频。\n莫为割鸡轻邑宰，应须叱驭效忠臣。\n锦城自古繁华地，好与风光作主人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70715,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小园秋夕","author":"杨亿","text":"鸿都归晚直城赊，墙外连营咽暮笳。\n玉井梧倾犹待凤，金塘柳密更藏鸦。\n心摇云阙传疏漏，目断星津过迥槎。\n已是秋来移带眼，可堪玄鬓有霜华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70716,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书怀寄刘五","author":"杨亿","text":"风波名路壮心残，三径荒凉未得还。\n病起东阳衣带缓，愁多骑省鬓毛斑。\n五年书命尘西阁，千古移文愧北山。\n独忆琼枝苦霜霰，清樽岁晏强酡颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70717,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仆射李相公宅观花烛","author":"杨亿","text":"孙阁相君和鼎贵，秦楼爱婿坦床贤。\n东方千骑还居上，南极三星正在天。\n路入桃源花烂漫，桥横银汉水漪涟。\n乘龙择对真无比，月桂宫中第一仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70718,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元净上人之新安谒李学士兼游庐阜","author":"杨亿","text":"双阙重城到几回，两游千里忽浮杯。\n黟江春水浅深绿，庐岳夏莲倾倒开。\n谢守同翻贝叶字，汤师独占碧云才。\n旧房京寺门空闭，坐榻凝尘砌长苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70719,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元奉宗宰绩溪","author":"杨亿","text":"游梁度几春，时誉蔼天伦。\n家寄汀蘋久，名题桂籍新。\n溪鳞清可数，泽雉到应驯。\n黟歙非难治，民风自古淳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70720,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"公子","author":"杨亿","text":"夹道青楼拂綵霓，月轩宫袖按前溪。\n锦鳞河伯供烹鲤，金距邻翁逐斗鸡。\n细雨垫巾过柳市，轻风侧帽上铜堤。\n珊瑚击碎牛心热，香枣兰芳客自迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70721,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"劝石集贤饮","author":"杨亿","text":"日上三竿宿雾披，章台走马帽檐欹。\n祇传祖席觞无算，肯顾尚书对有期。\n芸省翻经终寂寞，柳堤飞鞚好追随。\n灵均不醉真何益，千古离骚怨楚词。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70722,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"升山","author":"杨亿","text":"层峦连近郭，占胜有招提。\n宿雾昏金像，飞泉溅石梯。\n钟声空谷答，塔影乱云齐。\n千骑时来此，寻幽独杖藜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70723,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"太常李博士史馆孙秘丞相继奉使浙右博士至郡以孙侯诗三章示予且以致意因次韵和酬 其二","author":"杨亿","text":"分忧从汉殿，捧诏出萧墙。\n路入三吴远，舟浮一水长。\n诗题石门侧，梦彻斗城傍。\n清晓见云物，依依认帝乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70724,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"太常李博士史馆孙秘丞相继奉使浙右博士至郡以孙侯诗三章示予且以致意因次韵和酬 其三","author":"杨亿","text":"北极分忧瞩，东瓯布惠和。\n曾蒙倾盖分，偶得枉帆过。\n郑驿非常速，融樽复几何。\n孙侯不假道，鄙我信为多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70725,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"太常李博士史馆孙秘丞相继奉使浙右博士至郡以孙侯诗三章示予且以致意因次韵和酬 其一","author":"杨亿","text":"迅濑拖舟上，危梯蹑屐登。\n山光翠欲滴，水气热如蒸。\n路转藤萝暗，天开物象澄。\n丘园足逋客，应得荐贤能。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70726,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"文慧大师归蜀","author":"杨亿","text":"南宗传法了，汉殿赐衣新。\n归路峨眉雪，旧房京洛尘。\n天花飘讲席，海月照吟身。\n谁结香灯社，金门贵近臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70727,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"无为军王从事","author":"杨亿","text":"奏牍曾蒙乙夜观，擅场文价在金銮。\n貂裘岁久京尘暗，鹢路风高旅翮残。\n取酒黄金都已尽，食鱼长铗更须弹。\n时清水国无书檄，谁见挥毫一据鞍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70728,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"无题","author":"杨亿","text":"巫阳归梦隔千峰，辟恶香销翠被空。\n桂魄渐亏愁晓月，蕉心不展怨春风。\n遥山黯黯眉长敛，一水盈盈语未通。\n漫托鹍弦传恨意，云鬟日夕似飞蓬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70729,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"无题二首 其二","author":"杨亿","text":"露冷星翻月上弦，九枝银烛照金钿。\n应知韩掾偷香夜，犹记潘郎掷果年。\n天上明河虽可望，苑中高柳未经眠。\n乌啼人散青楼晓，堂下轻风转荚钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70730,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"无题二首 其一","author":"杨亿","text":"铜盘蕙草起青烟，斗帐香囊四角悬。\n沈约愁多徒自瘦，相如意密有谁传。\n金塘雨过犹疑梦，翠袖风回祇恐仙。\n日上秦楼休寄咏，东方千骑拥辎軿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70731,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"无题三首 其三","author":"杨亿","text":"满天飞絮罥游丝，扣砌苔钱晦履綦。\n北渚自应流怨泪，东邻谁敢效颦眉。\n嫦娥桂独成幽恨，素女弦多有剩悲。\n几夕空机愁促杼，银河休问报章迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70732,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"无题三首 其二","author":"杨亿","text":"合欢蠲忿亦休论，梦蝶翩翩逐怨魂。\n祗待倾城终未笑，不曾亡国自无言。\n风翩林叶迷归燕，露袅池荷触戏鸳。\n湘水东流何日竭，烟篁千古见啼痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70733,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"无题三首 其一","author":"杨亿","text":"曲池波煖蕙风轻，头白鸳鸯占绿萍。\n才断歌云成梦雨，斗回笑电作嗔霆。\n湘兰自古成幽怨，秦凤何年入杳冥。\n不待萱苏蠲薄怒，閒阶斗雀有遗翎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70734,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"王中庸赴河南巩县尉","author":"杨亿","text":"春风祖席引香醪，白马骊驹草色袍。\n官舍前临两京道，居民半杂五陵豪。\n卑飞碌碌犹栖棘，馀地飘飘暂鼓刀。\n捧檄初同昔人喜，不应搔首叹徒劳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70735,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"王寺丞借西第避暑因有寄赠","author":"杨亿","text":"滕公甲第冠神州，昼日青烟瓦上浮。\n南榭薰风偏解愠，北阶萱草更忘忧。\n朝回门闭人疑病，雨过凉生景似秋。\n角枕閒眠支体适，不知胡蝶是庄周。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70736,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"王廷评臻知庐州舒城县","author":"杨亿","text":"颍水生贤自古奇，西游声价满京师。\n梁园献赋天将雪，潘县临民鬓未丝。\n南浦销魂分袂处，北堂献寿捧觞时。\n到官卧治成高趣，终日清谈吏不欺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70737,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"王尚食知凤翔","author":"杨亿","text":"露冕分忧辍近班，朝阳鸣凤古岐山。\n三刀吉梦频为郡，驷马高车又出关。\n宴客羽觞那有算，题诗綵笔莫教閒。\n将坛义府平生事，早立边功振凯还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70738,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"代答","author":"杨亿","text":"征车苦迢递，节物感愁辛。\n已入授衣月，那经落帽辰。\n金樽难独酌，宝瑟任生尘。\n把菊流双泪，谁知忆远人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70739,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"代意二首 其二","author":"杨亿","text":"短梦残妆惨别魂，白头词苦怨文园。\n谁容五马传心曲，祗许双鸾见泪痕。\n易变肯随南地橘，忘忧虚对北堂萱。\n回文信断衣香歇，犹忆章台走画辕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70740,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"代意二首 其一","author":"杨亿","text":"梦兰前事悔成占，却羡归飞拂画檐。\n锦瑟惊弦愁别鹤，星机促杼怨新缣。\n舞腰罢试收纨袖，博齿慵开委玉奁。\n几夕离魂自无寐，楚天云断见凉蟾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70741,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬夜","author":"杨亿","text":"香街鼓绝暝烟深，檐近孤釭射宿禽。\n露井银床霜气冷，琐窗珠网月华侵。\n初沉远籁闻疏漏，旋拂流尘抚素琴。\n坐久星河渐侵没，萧萧朔吹度平林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70742,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"史馆阮比部知衢州因归建阳别墅二首 其二","author":"杨亿","text":"少小乡关振大名，武夷山翠落门庭。\n郎君近折仙人桂，伯氏高分处士星。\n城郭辽东应改易，芝兰谢圃自分馨。\n吴民正待随车雨，莫苦淹留醉醁醽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70743,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"史馆阮比部知衢州因归建阳别墅二首 其一","author":"杨亿","text":"再入蓬丘席未暖，飘飘又建隼旟行。\n交朋莫惜河梁别，乡曲初期昼锦荣。\n竹箭波声随一棹，斧柯山色对双旌。\n子牟江海心应在，频上高楼望帝京。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70744,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"史馆张学士知婺州","author":"杨亿","text":"鸾掖分符又出麾，津亭目送片帆飞。\n暂随越鸟栖烟树，重许吴侬见锦衣。\n属邑行春熊轼稳，公堂卜夜蟹螯肥。\n隐侯带眼看成缓，双阙恩深更忆归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70745,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"史馆赵祠部况通判宿州","author":"杨亿","text":"风流华省含香客，籍甚先朝奏赋人。\n竹使三年劳佐郡，柳堤千里待行春。\n文园避事心长笑，天禄雠书鬓渐新。\n帝念河渠在封部，特缘经义委名臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70746,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"史馆高司谏绅知华州","author":"杨亿","text":"谏署才闻满岁迁，分符便见入秦川。\n援毫厌赋梁园雪，缓辔闲看华岳莲。\n竹简汗青妨约史，缣囊封皂且论边。\n三峰洞穴多灵药，莫便抛官去学仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70747,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"史馆盛学士以诗相贺因而答之","author":"杨亿","text":"前年出守缙云城，曾枉骊歌慰远行。\n今日代言青锁闼，又披郢唱见深情。\n侧聆九奏都忘味，连得双金自满籯。\n红药阶前试吟嚼，胸中鄙吝一时平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70748,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"叶生归缙云","author":"杨亿","text":"出门西望长安笑，抱璞来求善价沽。\n惟罄囊装买群籍，不持刺字谒当涂。\n鲈鱼渐熟思归切，羊酪初尝得味无。\n送子东还重销黯，我曾三载守仙都。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70749,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"叶秘书温知蜀州江原县","author":"杨亿","text":"秘省丞郎出字人，锦江偏好濯缨尘。\n酒垆千古风流地，花县三年烂漫春。\n白羽豫州慵草檄，青天蜀道厌摧轮。\n巴猿杜魄惊乡梦，莫遣霜华鬓畔新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70750,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"司农栾少卿知洪州","author":"杨亿","text":"大农搜粟汉名卿，千里江西拥旆旌。\n腰下金龟三品绶，手中铜虎八州兵。\n属鞬牧伯趋庭见，骑竹儿童塞路迎。\n洪井主人今重士，肯教悬榻有尘生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70751,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"外弟张湜西游","author":"杨亿","text":"六年随我客梁园，西上孤飞彻九门。\n抱璞有瑕唯叹命，泣岐无托更销魂。\n秦关百二聊乘兴，汉牍三千待叫阍。\n赤日炎风两京道，文章满腹与谁论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70752,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"旧将","author":"杨亿","text":"平生苦战忆山西，拊剑临风气吐霓。\n戟户当衢容驷马，髯奴绕帐列生犀。\n新丰酒满清商咽，武库兵销太白低。\n髀肉渐生衣带缓，早朝空听汝南鸡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70753,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"民牛多疫死","author":"杨亿","text":"南海逸风如失性，东吴喘月不逢医。\n一元祀典古所重，九谷民天命在斯。\n真相柅车宁致问，族庖更刃亦焉施。\n炎神厉鬼争为虐，渡虎消蝗复是谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70754,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]