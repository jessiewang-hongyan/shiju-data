[{"title":"和吴教授投赠二首 其二","author":"刘克庄","text":"衮衮登瀛更上坡，且容老子钓烟波。\n凤麟自合呈祥瑞，凫雁何曾系少多。\n时有耦耕人共语，亦无问字客相过。\n倒囊欲答骊珠赠，柰此家徒四壁何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31553,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和吴教授投赠二首 其一","author":"刘克庄","text":"三径荒凉手自开，旋移花竹剪蒿莱。\n休休岂不缘迂惰，屑屑何为费往来。\n明主祇今蒐坠典，故人太半客翘材。\n累臣方卧漳滨疾，错梦钧天听乐回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31554,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和吴警斋侍郎二首 其二","author":"刘克庄","text":"帝悯龙钟许放还，梦魂尚记侍威颜。\n难陪贡禹王阳后，犹在申公辕固间。\n昔领群仙上蓬岛，今为居士老香山。\n痴年八十官三品，不欠浮名只欠闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31555,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和吴警斋侍郎二首 其一","author":"刘克庄","text":"□□抽得不赀身，惭愧君恩厚老臣。\n扇障绝胜一青盖，杖扶安用两朱轮。\n门无造请冠裳懒，室有昭回翰墨珍。\n道是全人吾岂敢，温公才做九分人。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31556,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张文学投赠","author":"刘克庄","text":"身如老桐树，拱把至于今。\n阅世已焦尾，无人知苦心。\n免随薪爨尽，误被斧斤寻。\n曾侍薰风殿，先皇独赏音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31557,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张使君一首","author":"刘克庄","text":"里巷传呼府座来，柴门草户亦荣哉。\n相忘金鲫忽然跃，惯见白鸥浑不猜。\n墨客堵墙观落笔，花神步水出行杯。\n定知入奉吾丘计，万一君王访草莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31558,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张秘丞灯夕韵四首 其四","author":"刘克庄","text":"频年沴气稀安业，一旦仁风忽扇和。\n野老说侯游豫少，醉翁与客倡酬多。\n一筇扶我蹒跚步，五马输君蹀躞珂。\n得雨下秧晴亦好，旧冬犹有未鞭禾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31559,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张秘丞灯夕韵四首 其三","author":"刘克庄","text":"君侯谈笑该能事，诗到元和字永和。\n五夜纵游聊与众，一年更借不为多。\n牙旗此际留宵钥，宝马来春蹋晓珂。\n白发老农相告语，看灯归去要栽禾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31560,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张秘丞灯夕韵四首 其二","author":"刘克庄","text":"牧守二期方奉计，末期君已得民和。\n不愁米送官仓少，但怪莲开陆地多。\n座客共沾眉寿酒，厩人预戒早朝珂。\n诸公若问龙钟叟，为说腰镰自刈禾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31561,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张秘丞灯夕韵四首 其一","author":"刘克庄","text":"公承赤地饥荒后，一念通天立致和。\n永日庭中私谒少，丰年陌上醉人多。\n更生昔忝陪藜杖，臣甫今宁想玉珂。\n益郡乐歌何足拟，要书善政续归禾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31562,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张简簿尉韵","author":"刘克庄","text":"旧案依俙在柏台，寄声杭本莫翻开。\n骑驴导从两黥挟，罗爵门庭几客来。\n务观可堪供史草，补之不会作宫梅。\n男儿盍建横行策，免使君王叹乏材。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31563,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和陈生投赠二首 其二","author":"刘克庄","text":"华裾乃肯访衰翁，何德烦君贽一通。\n百尺楼真广陵后，千岩宅在鲁家东。\n句中有眼参方见，删后无诗论未公。\n年少分阴且惜取，老夫不觉已头童。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31564,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和陈生投赠二首 其一","author":"刘克庄","text":"乍可破琴栖剡曲，谁能抱瑟立齐门。\n昔赓太液池新咏，今叹灵光殿独存。\n摩诘不烦人问疾，巫咸难为帝招魂。\n老农无复供春帖，题遍南村与北村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31565,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和季弟韵二十首 其二十","author":"刘克庄","text":"帆近蓬莱忽浩茫，归来散发且阳狂。\n昔陪上帝图书府，今作清都山水郎。\n子美愁来曾叫舜，退之老去独鸣唐。\n商歌满屋如金石，绝胜箫声出洞房。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31566,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和季弟韵二十首 其十九","author":"刘克庄","text":"荒村随分有区廛，不在花边即水边。\n甚懒安能诗咏史，已归不复赋思玄。\n提壶声好行沽酒，扑满身灾坐贮钱。\n拣个名山藏断藁，莫教望气识龙泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31567,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和季弟韵二十首 其十八","author":"刘克庄","text":"倘来事已付茫茫，朝野皆知故态狂。\n视草偶曾称学士，看花未了失台郎。\n贾生作赋先扬马，屈子分骚与景唐。\n绝笔且宜高束起，要赓黄鹄和芝房。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31568,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和季弟韵二十首 其十七","author":"刘克庄","text":"村有数家无百廛，小轩送目到鸿边。\n青牛曾动半空紫，白凤端为一卷玄。\n上世架签犹万轴，太平斗米只三钱。\n课童更渫墙西井，拟学苏仙赋乳泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31569,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和季弟韵二十首 其十六","author":"刘克庄","text":"且耕閒旷钓迷茫，风月佳时亦放狂。\n辟谷久从赤松子，对花几换紫微郎。\n王何变晋为东晋，郊岛催唐入季唐。\n此事故须商榷在，铁檠未可厌山房。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31570,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和季弟韵二十首 其十五","author":"刘克庄","text":"小隐山林大隐廛，市尘吹不到书边。\n知他孟喜传谁易，仅一侯芭受我玄。\n古有饭牛仍扣角，世无骑鹤又腰钱。\n溪光门外清如镜，莫遣胡公涴菊泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31571,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和季弟韵二十首 其十四","author":"刘克庄","text":"几欲乘桴泛淼茫，世间讵著次公狂。\n幸无珠可分房老，安得钱堪遗窟郎。\n直笔今谁书汉晋，巍冠昔谩讲虞唐。\n那知溪上垂纶叟，曾导龙绡辇出房。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31572,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和季弟韵二十首 其十三","author":"刘克庄","text":"不管开阡与税廛，自锄瓜芋小溪边。\n向来一鹗谩荐祢，它日只鸡谁诔玄。\n埋骨要邻高士冢，买山莫费故人钱。\n舍旁苔井尤宜茗，何必人间第一泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31573,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和季弟韵二十首 其十二","author":"刘克庄","text":"群书烟海眩弥茫，一念毫釐判圣狂。\n煽宠艳诗多狎客，漏名直笔几牙郎。\n同时待诏馀枚叟，何处山人似李唐。\n老矣自筹身世事，不将卦气问京房。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31574,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和季弟韵二十首 其十一","author":"刘克庄","text":"栖山毕竟胜居廛，投老柴门古道边。\n儋死更无人守墨，雄存已有客嘲玄。\n鸱夷腹大常盛酒，麈尾谈清绝口钱。\n挂起桔槔能几日，田间轧轧又机泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31575,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和季弟韵二十首 其十","author":"刘克庄","text":"天海凭高两杳茫，岂无容地著吾狂。\n俗人不惯呼聱叟，明主何曾罪寝郎。\n耕富春山能重汉，隐王官谷未忘唐。\n自嫌老病疏溪墅，只靠邻僧守竹房。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31576,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和季弟韵二十首 其九","author":"刘克庄","text":"去国为农混里廛，故书抛向短檠边。\n台卿复壁犹温孟，夷甫排墙始悔玄。\n送老只消营藁葬，买春不过费榆钱。\n枯肠欲汲无涓滴，谁道先生万斛泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31577,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和季弟韵二十首 其八","author":"刘克庄","text":"蠡管安能测混茫，楚狂敢道国人狂。\n似闻函谷逐秦客，恰见初筵笑郭郎。\n壮志不如乘下泽，微辞何足讽高唐。\n入山未即无邻伴，书室旁边著鹤房。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31578,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和季弟韵二十首 其七","author":"刘克庄","text":"虽与渔樵共受廛，尚馀气习雪萤边。\n故须堂下参轮扁，未可灯前骂郑玄。\n那有传求千斛米，更无策救五铢钱。\n陈编老矣犹加勉，凿久安知不及泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31579,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和季弟韵二十首 其六","author":"刘克庄","text":"梦事回头堕渺茫，松间梅畔放清狂。\n直须添竹成三友，不必栽槐待二郎。\n老爱家山安畏垒，早知世路险瞿唐。\n人间腥腐如何向，莫怪灵均葺药房。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31580,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和季弟韵二十首 其五","author":"刘克庄","text":"秋输急急了园廛，生怕租瘢照水边。\n有客耸肩对摩诘，无人拥髻伴伶玄。\n俗中安得游仙枕，世上原须使鬼钱。\n却笑赞皇归不得，崖州城北望平泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31581,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和季弟韵二十首 其四","author":"刘克庄","text":"即今巾镜叹苍茫，但觉书痴胜酒狂。\n已怕词头趋坡老，更禁帖子累秦郎。\n鲁生竞起为绵蕝，邶俗谁能不采唐。\n自唱樵歌余季和，免教人谤到君房。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31582,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和季弟韵二十首 其三","author":"刘克庄","text":"放逐归来老一廛，旧巢回首五云边。\n固知七略惭臣向，误把三长责子玄。\n岂有侍郎留下榼，亦无司业送来钱。\n丰年不怕相如渴，处处人家酒似泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31583,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和季弟韵二十首 其二","author":"刘克庄","text":"古书随读已微茫，时事閒思欲发狂。\n愿保残年同绛老，不贪来世作缁郎。\n史饶西汉宁论晋，诗止黄初不及唐。\n海阔天高孤鹤远，寄声飞矢莫抽房。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31584,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和季弟韵二十首 其一","author":"刘克庄","text":"何处有禾三百廛，芋区止在舍西边。\n室如蒙叟生虚白，诗赛唐人选极玄。\n耐久不如常友石，固穷未肯便兄钱。\n春晴尤惬看花者，却怕山田欠水泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31585,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和实之读邸报四首 其四","author":"刘克庄","text":"一抨初骇听，双泪谩求哀。\n极口诬贤者，甘心誉彼哉。\n早知豺不食，安用鸩为媒。\n试问高阳里，迎车几两来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31586,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和实之读邸报四首 其三","author":"刘克庄","text":"外观殊伟岸，内禀极憸柔。\n欲取汉清议，尽投唐浊流。\n鬼车鸣甚恶，猛虎死方羞。\n芳臭须臾判，哀哉不善谋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31587,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和实之读邸报四首 其二","author":"刘克庄","text":"穿凿彊挥麈，跳梁勇执弓。\n矫诬天亦怒，驱逐国为空。\n笑里刀常有，盟边甲已衷。\n拾遗端可拜，诛佞笔生风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31588,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和实之读邸报四首 其一","author":"刘克庄","text":"祝鮀非是佞，莒仆未为凶。\n鬼谷从横舌，终南诡秘踪。\n断无麟在薮，独有鼠穿墉。\n千古谁俦匹，依稀似敬宗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31589,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和居厚弟一首","author":"刘克庄","text":"处处笙歌杂诵谣，盍簪一笑共今宵。\n宛然上齿尊三老，非若班廷序百僚。\n乡饮讵宜先仗出，虞人不必以弓招。\n明时各适鸢鱼性，在野尤和似在朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31590,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和居厚弟韵","author":"刘克庄","text":"端嘉已羡谷莺迁，不觉龙飞又几年。\n坡老尝称少公胜，伯淳曾道二哥贤。\n腾笺内举虽如此，秉笔中书岂必然。\n岁晚偶同耆旧传，瞎翁安得似癯仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31591,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和林太渊二首 其二","author":"刘克庄","text":"声称籍甚自髫年，圣处闻之于膝边。\n庙瑟久无人续响，国棋谁与子分先。\n书经秦火讹难读，钵至曹溪靳不传。\n功行满时笙鹤下，未应山泽著臞仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31592,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和林太渊二首 其一","author":"刘克庄","text":"端人舌本钝如槌，自画村眉不入时。\n门巷张罗宾客少，车轮生角仆夫悲。\n共游洛下凋零尽，末向岩头付嘱谁。\n为吾子师余岂敢，伊家元有大宗师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31593,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和林肃翁有所思韵 其一","author":"刘克庄","text":"老厌人间事远游，弇州西畔比台州。\n须弥身大安知痛，云梦胸宽不贮愁。\n旧友惟君真管鲍，诸生若个是程仇。\n跳丸去速还舟晚，独立空山两鬓秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31594,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和林肃翁有所思韵 其二","author":"刘克庄","text":"少豪曾挟一筇游，晚似庞公怕入州。\n橡栗尚烦天赋粟，茅柴如以水浇愁。\n何妨范史书钩党，不愿欧碑说解仇。\n自古放臣多感慨，吾评哀郢胜悲秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31595,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和赵广文韵","author":"刘克庄","text":"赵室儒英盍聚奎，奈何白首钓磻溪。\n不通光范门前谒，□较征西墓上题。\n晚节画工图广受，高文太史序重黎。\n章泉没后无耆旧，他日清名可与齐。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31596,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和赵吉州三首 其三","author":"刘克庄","text":"今代庐陵牧，苍生属意深。\n胸中丝补衮，肘后药成金。\n仆自操齐瑟，公宜和舜琴。\n篝灯精舍里，何日共论心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31597,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和赵吉州三首 其二","author":"刘克庄","text":"憔悴东阳令，区区谩自疲。\n断无问牛智，宁受放鱼欺。\n俭陋交游笑，低平父老知。\n向来子元子，髣髴是吾师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31598,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和赵吉州三首 其一","author":"刘克庄","text":"学者当穷理，工诗岂美名。\n不能禆采访，徒自取讥评。\n责己希韦孟，休官慕尚平。\n如今成病鹤，垂首噤无声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31599,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和钟子鸿二首 其二","author":"刘克庄","text":"清吟颇觉续貂难，衔袖勤于贽热官。\n怪子车轮行地远，愧予门户似冰寒。\n舂粱礼数呼儿具，覆酱文章怕客看。\n老去商歌声满屋，孰云野处寂无欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31600,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和钟子鸿二首 其一","author":"刘克庄","text":"匹雏欲拔佞山难，还敕区区慕守官。\n捋虎自怜馀勇在，狎鸥似责昔盟寒。\n新麻断腕毋容草，堕甑回头不更看。\n老子平生差耐事，肯于得丧置悲欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31601,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和除字韵问大渊来期","author":"刘克庄","text":"故人有约钦迟久，竹榭茅亭自扫除。\n宁载鸱夷访杨子，羞蒙狗监荐相如。\n极思座上挥长麈，莫赚□□□□车。\n□□□□□□□，□□□□更垂鱼。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31602,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和徐常丞洪秘监倡和四首 其四","author":"刘克庄","text":"公诗妙巧过般输，蚓窍何堪和大儒。\n岂敢分庭掣鲸海，颇思越邑会鹅湖。\n薰莸年老迷香臭，酒脯涎垂向市沽。\n病起带围浑减尽，免教人诮腹如壶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31603,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和徐常丞洪秘监倡和四首 其三","author":"刘克庄","text":"孤忠郁积未全输，臧氏其如命世儒。\n归治隐栖秦系里，去留遗爱葛仙湖。\n一辞吾已抽身退，什袭公非待价沽。\n大手会当摛玉检，窭人只合传冰壶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31604,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和徐常丞洪秘监倡和四首 其二","author":"刘克庄","text":"纷纷博局迭赢输，孰是真儒孰盗儒。\n履道宅佳多辇石，辋川亭巧恰临湖。\n可无诗唤刘郎和，偶有钱同郑老沽。\n却笑吴儿拚命者，潮头如屋靠腰壶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31605,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和徐常丞洪秘监倡和四首 其一","author":"刘克庄","text":"一著能回一局输，安危岂不系兹儒。\n乐卿昔去曾入海，老监今归但乞湖。\n阮子杖挑聊共出，麻姑榼送不烦沽。\n二仙占断壶中景，不许长房跳入壶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31606,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和高九万雪诗","author":"刘克庄","text":"添尽绵衣体未和，小窗奈此苦寒何。\n极知上竺仙人喜，不道长安贫士多。\n穷巷都无晨噪鹊，边城应有夜惊鹅。\n君才堪续梁台赋，早晚楼船济汴河。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31607,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和曹守司直劝驾","author":"刘克庄","text":"李唐故典存烧尾，皇宋科名从敕头。\n月露浓熏仙桂发，天风高送客槎浮。\n三场魁匪先贤志，千佛名知几劫脩。\n自笑申公垂八十，不能挟册共西游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31608,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和黄户曹投赠二首 其二","author":"刘克庄","text":"巫医末技有师生，古道今人鲜复行。\n受子云玄谁卒业，附韩公传不埋名。\n虱犹可以箭锋贯，蝇岂能增秤尾轻。\n颇欲他时观续集，定将苍老换朱荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31609,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和黄户曹投赠二首 其一","author":"刘克庄","text":"羞问胡奴乞米炊，君恩朴断老儋祠。\n蚤赓殿阁微凉作，晚课田园杂兴诗。\n洛下共游无在者，岩头末句欲传谁。\n天公别有相裨补，素发星星两鬓垂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31610,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和曾史君喜雨","author":"刘克庄","text":"雄乌忽变作雌霓，太守为坛水畔祠。\n多谢龙公来挹彼，寄声风伯莫吹之。\n麦残黑穟差伤晚，秧出青针未过期。\n想见铃斋闻点滴，银钩满纸又成诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31611,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和答北山","author":"刘克庄","text":"北山当代文章祖，孔思周情幸未泯。\n弟子力疲心尚在，先生齿宿意逾新。\n今无斲鼻成风手，古有埋腰立雪人。\n不向师门勤稽首，一生怀抱对谁伸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31612,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和潘侯劝驾韵","author":"刘克庄","text":"底须辛苦访蓬莱，唾手功名亦快哉。\n唐季闽尤多进士，宋兴莆已四抡魁。\n来听雅乐歌三阕，去占群花第一开。\n乡老献书侯劝驾，共为昭代育群才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31613,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和警斋侍郎二首 其二","author":"刘克庄","text":"家传岂有枕中方，敢向尧朝议大章。\n难入高贤真率社，且寻童子钓游乡。\n有西畴事咨衡宇，无北山移诮草堂。\n独恨才衰诗不进，傥容摘艳更薰香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31614,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和警斋侍郎二首 其一","author":"刘克庄","text":"颜苍鬓秃旧词臣，几见台家局面新。\n栖碧山中真大隐，立红云畔是前身。\n鲁公昔有书干禄，杨子今无赋逐贫。\n纵使未能追绮皓，绝胜赐杖给扶人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31615,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]