[{"title":"登仙人掌山","author":"徐元杰","text":"山名仙掌足盘桓，未醉黄花半日閒。\n更上一层高著眺，此身拟可透天关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52970,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题日者李成斋所藏李文清幅","author":"徐元杰","text":"相公提笔福苍生，印得当年命术精。\n钧翰珍藏塞翁马，六丁严护不容惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52971,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题俞簿梅阜书院","author":"徐元杰","text":"浅清溪浒瘦山巅，净洗肌肤冰雪天。\n偏向书窗伴幽独，不教尘俗滓婵娟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52972,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠刀镊王诚三首 其三","author":"徐元杰","text":"妇人盖亦有仁心，只为冥顽溺爱深。\n今此警之当愧死，何妨重理旧弦琴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52973,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠刀镊王诚三首 其二","author":"徐元杰","text":"汝家住近里仁坊，不恋妻儿恋侍旁。\n父子性天非可夺，亲亲仁也盍揄扬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52974,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠刀镊王诚三首 其一","author":"徐元杰","text":"刀镊王生勇黜妻，痛怜白发有亲慈。\n纷纷世上私妻子，闻有斯人死愧之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52975,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠日者林雪庵","author":"徐元杰","text":"雪庵笑我头如雪，雪干须知立岁寒。\n会面炎炎朱夏日，门庭雪澹自相看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52976,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠风鉴神眼","author":"徐元杰","text":"世道支撑尽要人，阅人多后眼通神。\n一朝相去三丞相，今昔同归识认亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52977,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠鉴堂","author":"徐元杰","text":"方寸无尘眼有筋，如他图了几勋臣。\n更烦提起丹青手，写出惊天动地人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52978,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"入讲论语二首 其二","author":"徐元杰","text":"躬承清问及年丰，蚕麦今还与旧同。\n稼穑艰难周圣虑，农桑劝课即田功。\n志民深闵僖公雨，勤业犹存豳国风。\n恳恳召和关主德，我皇心直与天通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52979,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"入讲论语二首 其一","author":"徐元杰","text":"温温中旨肃传宣，鲁语书陈诵说专。\n圣意聿宗伊洛训，愚臣谨绎考亭编。\n寸心普物根源地，百拜承颜咫尺天。\n尧舜吾君持所学，敢陈他道对王前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52980,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"又用韵答何上舍","author":"徐元杰","text":"腊雪多为瑞，丰穰隔岁知。\n林峦银剑戟，苑囿玉壶池。\n映几孙书饱，卧冰祥母饥。\n疾风看正色，馀事付清诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52981,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"又赠日者曰清朝贵官","author":"徐元杰","text":"歆艳清朝作贵官，人人都把命来看。\n未言造化穷天理，且据干支铺卦盘。\n富贵热中从古有，功名向上每才难。\n荣枯勘破花开落，始识霜松自岁寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52982,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"及第谢恩","author":"徐元杰","text":"圣朝天子荐临轩，嘉与愚臣究本原。\n天地两间扶景运，唐虞三代印微言。\n惭无一德酬清问，猥玷初班误圣恩。\n一节誓坚忠与孝，立身端不负乾坤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52983,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书安象祖静轩有感","author":"徐元杰","text":"太极即人极，坤爻德不孤。\n直方真主宰，敬静实功夫。\n老桧霜中干，寒梅雪里株。\n常惺惺法处，收敛物俱无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52984,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戊戌恭和御制","author":"徐元杰","text":"明庭亲策广蒐贤，识治朋来谊少年。\n肆秩琼林宾燕衎，载颁宝画宠光延。\n此时礼乐三千字，他日丹青数百篇。\n蝼蚁怀忠赓帝咏，相先事业誓神仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52985,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戊戌馆中分韵饯刘秘书","author":"徐元杰","text":"圣明钦恤重皋陶，一日飞星五使轺。\n方幸蓬山陪末属，遽瞻英簜隔层霄。\n谆谆天语扶邦计，念念民生弼教条。\n轻重适权孚简眷，金鸡山色谶鸡翘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52986,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"甲辰恭和御制","author":"徐元杰","text":"衮衣日月炳当轩，光逮刍荛采众言。\n内外修攘明治体，忧勤终始养心源。\n英髦瑞列霜中干，治化春回雪里根。\n愿溥需云苏物槁，九垓滂沛洽君恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52987,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"早起玉堂窗前俯方池有感","author":"徐元杰","text":"玉堂窗外小池深，香雾朝浮花气沈。\n树杪亭亭鸦点墨，萍根发发鲤跳金。\n中涵一勺渊泉定，上有九重天日临。\n充广恩波无尽意，敢渝洁白寸丹心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52988,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次赵守鹿鸣宴韵","author":"徐元杰","text":"邦侯光价擅文场，密印心胸书传香。\n鸣鹿载歌苹野什，骄骅群跨杏园芳。\n阳春有脚葭吹管，生意无边柳著行。\n已报主人环玉立，与观宾句递春坊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52989,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次章守鹿鸣宴韵","author":"徐元杰","text":"儒宫新创俯青溪，上挹魁躔踵旧规。\n鹗荐联名充赋日，龙飞亲策采言时。\n指迷承学云中路，珍重贤侯席上诗。\n只有梅花知此意，东君著眼是先期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52990,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵何陆二别驾同游灵山阁三首 其三","author":"徐元杰","text":"彼美前修亦伟哉，岿然风雨不能摧。\n人新人古怀斯阁，春去春来付一杯。\n游兴漫随流水去，衰眸长对好山开。\n销凝往事凭栏久，杜宇一声烟际催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52991,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵何陆二别驾同游灵山阁三首 其二","author":"徐元杰","text":"闻说精蓝颇壮哉，天教杰栋起崔嵬。\n檐前山色呈螺髻，槛外溪光献玉杯。\n对景自应双眼豁，忧时应得笑颜开。\n唤回忠定遗芳躅，衮衮云霄步武催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52992,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵何陆二别驾同游灵山阁三首 其一","author":"徐元杰","text":"平分风月两悠哉，胜践春浓花未摧。\n萧寺适今重建阁，兰亭怀古共流杯。\n典型二老溪山重，唱咏诸公今日开。\n惭我枯肠元蹇涩，底教头上片云催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52993,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别旴江易耕道","author":"徐元杰","text":"点勘窗前昼景舒，豁人双眼绿阴敷。\n明方寸地通三极，会一理中该万殊。\n静体阳工生意思，密融心匠活工夫。\n丁宁后会秋风鹗，万里青冥是坦涂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52994,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"供铨部职","author":"徐元杰","text":"愚生何幸圣明遭，官府宫墙上界高。\n冰雪身心参宿列，日星条令揭天曹。\n二南美意存周召，九德淳风慨禹皋。\n我亦空餐惭汝士，谆谆惟切痛民膏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52995,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和袁守","author":"徐元杰","text":"和籴存和气，春生垦辟时。\n民庸天上见，岁事腊前知。\n吾谚诸侯度，谁褰使者帷。\n乐民之乐者，犁雨趣耕治。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52996,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和章宰访祝子寿来青书院韵","author":"徐元杰","text":"文昌因祖饯，郎宿问斋名。\n枉驾一朝款，寒窗千载荣。\n未花梅索赋，堪杖竹经行。\n自得来青句，山泉不可清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52997,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"咏以人与天地万物为一体刻印章诗","author":"徐元杰","text":"三才中立囿形均，昧者拘拘利乃身。\n不道有身皆有血，岂应知我不知人。\n其间一物容亏性，是即四肢顽不仁。\n洞洞八荒皆我闼，豁然窥见等天真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52998,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"直宿禁中","author":"徐元杰","text":"清和时候玉堂宣，愚亦何人厕讲筵。\n但觉梦回深夜爽，不知身在九霄眠。\n志裨君德从容地，恋切宸恩咫尺天。\n愿散辉光烛幽隐，肯专荣耀贲金莲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52999,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"饯上饶推幕叶西涧召为国子录二首 其二","author":"徐元杰","text":"客有携来端水珉，天然中界玉圭形。\n送君早入薇垣紫，结劄先登藜阁青。\n要看濡毫香典籍，直须提笔福生灵。\n端凝正笏如山立，匪石斯心社稷经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53000,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"饯上饶推幕叶西涧召为国子录二首 其一","author":"徐元杰","text":"魁耀来从古赤城，三年冰水一般清。\n莲池婉婉中流砥，米廪行行要路程。\n悟主谠言须启沃，康时伟业待恢宏。\n却惭疏窳深知遇，别后音书等弟兄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53001,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"饯永丰易丞赴庾檄","author":"徐元杰","text":"世道圆通更直方，松阴庭院亦声光。\n眼明英簜公题品，身入芙蓉婉赞襄。\n田里叹愁从此达，公私幽枉待君扬。\n更烦好斡东君造，一道奸贪凛雪霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53002,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"饯江东绣使庸斋赵玉堂二首 其二","author":"徐元杰","text":"福星分野大江东，道味蓬山聚话中。\n漠漠暮云诗兴感，依依何日酒樽同。\n虚心无我爰咨度，养气知言协粹冲。\n望切衮归基宥密，可能无梦到周公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53003,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"饯江东绣使庸斋赵玉堂二首 其一","author":"徐元杰","text":"天上玉堂辞宠荣，却持玉节按江城。\n惟刑之恤民心悦，不怒而威吏胆惊。\n有脚春来陶化日，无心云出雨苍生。\n个中运量常提醒，元气循环昼夜行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53004,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送尹子潜赴省","author":"徐元杰","text":"吾侪坚世好，心事老天知。\n梦寐符前说，轩翔定此时。\n故家当有后，造物本无私。\n雪里阳春脚，梅开第一枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53005,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送陈国珍之官鄱阳","author":"徐元杰","text":"盟缔慈恩十四年，匆匆话别戍梅仙。\n便家泽国冰溪壤，得庇皇华刺史天。\n事到直须行己志，官卑最喜近氓编。\n许多静定清修力，警戒声名企昔贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53006,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送绍兴叶帅改当涂 其二","author":"徐元杰","text":"人言禹会即当涂，上曰芜湖抵鉴湖。\n姑少副公求去尔，匪伊有诏盍归乎。\n知心霜月浑无滓，回首春风定与俱。\n惭愧蓬莱宾客后，愿言陪侍入天衢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53007,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送绍兴叶帅改当涂 其一","author":"徐元杰","text":"八年于外与民宜，遍历穹台阃又麾。\n襟度乾坤无忤物，鬓髯霜雪却缘谁。\n宽平到底人怀去，廉靖如初帝简知。\n受善如流闻义勇，真诚端以古求之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53008,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送畏斋何监簿添倅解替东归","author":"徐元杰","text":"春风行李万篇诗，明月归舟几片碑。\n千载岫云佳话柄，两年怀玉淡生涯。\n已闻北阙飞丹诏，早趁南薰度赤墀。\n历历口开天下事，直声元是九重知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53009,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"席间和周颖斋韵","author":"徐元杰","text":"清泉白石诱登临，净瞰轩窗竹一林。\n隽永如君真有味，膏肓和我不须针。\n流行坎止人难必，果育蒙亨力要深。\n一笑相逢邀一勺，喜渠介洁似侬心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53010,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽分宁张少仙二首 其二","author":"徐元杰","text":"当路知公谂，搜扬入剡科。\n才难行志易，官小及民多。\n北部劳人耳，东皈奈命何。\n邮音嗟忽断，空有泪滂沱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53011,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽分宁张少仙二首 其一","author":"徐元杰","text":"貌与心俱古，岁寒松桧苍。\n学高眸炯月，吟苦鬓先霜。\n能赋秋宾早，收功晚节香。\n满门弓冶趣，有鹗待云翔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53012,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽王迪功","author":"徐元杰","text":"徼好年家后，知公月旦先。\n宠荣身外物，孝友性中天。\n趣自怡堂得，诗从犹子传。\n故园遗迹恨，月落早无边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53013,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽克斋陈先生四首 其四","author":"徐元杰","text":"痛惨哲人痿，愚缠丧母悲。\n溯风怀绋路，泣雨写哀词。\n学本藏诸用，行皆笃所知。\n惟馀经训在，交付有孙枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53014,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽克斋陈先生四首 其三","author":"徐元杰","text":"师承心独切，于道愧无闻。\n几载钻坚叹，前年枉教勤。\n墨车回可赞，晋鄙善潜薰。\n道脉惟其寿，天胡遽丧文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53015,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽克斋陈先生四首 其二","author":"徐元杰","text":"亲养九旬馀，先生寿亦如。\n学充淇澳美，训释济南书。\n诸老经筵送，俞音宠渥疏。\n惜非程子聘，中沮亦时欤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53016,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽克斋陈先生四首 其一","author":"徐元杰","text":"薰炙儒先早，朱门授受亲。\n去寻颜巷乐，归咏点雩春。\n道妙穷精一，心传有省循。\n乐天知命者，忧道不忧贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53017,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽吴准斋","author":"徐元杰","text":"壮岁能官不厌卑，怆怀霜露蚤知几。\n扣其学问中心得，如此典型今代希。\n天子诏之坚逊避，朝端达者夙瞻依。\n甲辰重晤言前定，痛述生平泪忍挥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53018,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽求志居士王料院二首 其二","author":"徐元杰","text":"身忝蓬莱客，抠衣谒使臣。\n麈谈频款曲，樽酒屡殷勤。\n政事钦前迹，诗书耸旧文。\n话言犹在耳，不忍哭公坟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53019,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽求志居士王料院二首 其一","author":"徐元杰","text":"奕叶文宗盛，如公罕与俱。\n源流传紫橐，题品重洪枢。\n浙左清名凛，江南政绩殊。\n二难芗共荐，生死亦同涂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53020,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽辛宪若五首 其五","author":"徐元杰","text":"眷义门墙旧，交游手足如。\n方勤来妣赙，忍写慰公书。\n继世多先烈，诸郎总令誉。\n观音山路黯，飞些重欷歔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53021,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽辛宪若五首 其四","author":"徐元杰","text":"旌廉优召节，丐佚得临漳。\n静退家庭旧，清芬滋味长。\n病中知命见，力上挂冠章。\n了了遗言善，虽亡实不亡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53022,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽辛宪若五首 其三","author":"徐元杰","text":"十载居间学，瓢泉映洁清。\n陶潜黄菊趣，杜老白鸥盟。\n云自无心出，春随有脚行。\n知非古巴蜀，使指若为情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53023,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽辛宪若五首 其二","author":"徐元杰","text":"荣显宜超躐，威声憺外陲。\n边疆多崄历，麾节两朝推。\n范子甲兵有，张名草木知。\n急流缘底勇，路口岘山碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53024,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽辛宪若五首 其一","author":"徐元杰","text":"在昔我先翁，礼廑先正隆。\n潭潭带湖府，凛凛玉溪风。\n夜韭觞筹里，春花唱咏中。\n怀哉秋水去，世好孰如公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53025,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽宜春赵别驾二首 其二","author":"徐元杰","text":"诗债松边了，锄荒剩种花。\n云程衡麓雁，风味仰山茶。\n白玉楼成速，金銮事可嗟。\n桃源千古恨，寒日惨啼鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53026,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽宜春赵别驾二首 其一","author":"徐元杰","text":"丛桂论文旧，辛酸话早年。\n齑盐朝惯苦，膏火夜无眠。\n一第酬初志，殊勋策步仙。\n激昂英气宇，缓步赤霄躔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53027,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽前南剑添倅杨料院","author":"徐元杰","text":"泣别监州隔死生，薄云兹义更何人。\n草青彭蠡湖边晓，花满江郎峰畔春。\n每慨共官惟气直，略无片语不情真。\n西芹香火家家意，所欠笺天泽徙薪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53028,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽都大王郎中二首 其二","author":"徐元杰","text":"一门孝友古难为，坚苦端凝更自持。\n如此典型今代少，粹然言论满朝推。\n若人已矣嗟何及，魂气信乎无不之。\n楚水芗溪生死地，英灵上诉九原知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53029,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽都大王郎中二首 其一","author":"徐元杰","text":"魁望西来职秘丘，年家托好叙绸缪。\n身为僚友两三月，公肃皇华百八州。\n列纬载班清剧耀，高风遽勇急中流。\n讣闻落晚呼天咽，涕泗交颐重所忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53030,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽黄制属","author":"徐元杰","text":"家传山谷旧簪缨，志业刚豪早有声。\n二子学文能绍志，一官拜命竟辞荣。\n琴斋不听惊人语，钺阃空留荐剡名。\n借问松坡谁是主，疏梅淡月两凄清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53031,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"旅舍灯","author":"徐元杰","text":"荒居雨醒已昏黄，败壁张灯四散光。\n相待村炊同坐久，更陪幽梦入更长。\n屋头鸡唱惊孤枕，门外马嘶催晓装。\n僮仆告行吾亦去，空房留尔重凄凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53032,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"荷花","author":"徐元杰","text":"鼓角声中璧月光，竹舆十里绕横塘。\n碧摇仙子凌波袜，红散天丝织锦裳。\n彷佛若耶溪上路，栖迷太华井边凉。\n入城不觉东方白，吹散一身风露香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53033,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"部中观新竹有感","author":"徐元杰","text":"粉署窗前小竹林，子孙蛰蛰得春深。\n土膏肥迸苍龙角，地发抽迟紫玉簪。\n檐近十分饶宿溜，墙高终日碍层阴。\n南风昨夜阳和透，放出参天劲节森。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53034,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宿部观铨法苦蚊","author":"徐元杰","text":"炎方典礼始郊迎，夜宿铨闱暑气清。\n万物洪纤俱夏长，九天宽大遍春生。\n眼明剔蠹牙签滑，手倦驱蚊玉箑轻。\n我自黑甜深帐稳，不容形遁晓窗明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53035,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]