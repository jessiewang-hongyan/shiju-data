[{"title":"喜英公大师挂锡太华","author":"陈抟","text":"暗喜莲峰作近邻，拨开云雾见师频。\n有时问个艰难字，便沐周旋说与人。\n唐李监应留后迹，汉蔡邕想是前身。\n堪嗟继踵无徒弟，笔法收藏在渭滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16577,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠张乖崖","author":"陈抟","text":"自吴入蜀是寻常，歌舞筵中救火忙。\n乞得金陵养闲散，也须多谢鬓边疮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16578,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其二","author":"陈抟","text":"万顷白云独自有，一枝仙桂阿谁无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16579,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中秋月和桃源夫人","author":"陈纯","text":"仙源尝误到，羁思正萧然。\n秋静夜方静，月圆人更圆。\n清尊歌越调，仙棹泛晴川。\n幽意知多少，重重类楚绵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16580,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自紫极观过天柱","author":"陈良孙","text":"道在吾身宇宙宽，朝踰云岫暮云关。\n丹灵不服春风转，欲度世人那得閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16581,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诗一首","author":"陈良","text":"父子联荣世所希，予家何幸窃恩辉。\n自惭不及吾儿甚，得向亲前谢绿衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16582,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"琼花","author":"陈良","text":"淮海春深照月长，灵祠佳树擅孤芳。\n人迷三月天山雪，风逗千门汉殿香。\n上苑菁葱思旧赏，金闺回旋入新章。\n后庭遗韵歌声好，试折琼枝荐一觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16583,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪中浴冷泉示诸友","author":"陈良孙","text":"风鼓空林雪蔽山，身如铁石不知寒。\n尘埃岂是相随物，付与溪流出世间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16584,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽吕东莱二首 其二","author":"陈良祐","text":"讲道东阳郡，门生数百人。\n从游倾里社，忻慕满朝绅。\n仕宦淹难进，声名烱不泯。\n伯牛有斯疾，夫子亦悲辛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16585,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽吕东莱二首 其一","author":"陈良祐","text":"家学相传久，天资自得高。\n读书如夙习，授业更忘劳。\n史笔追迁左，诗编继郑毛。\n渊源有如此，沾丐及吾曹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16586,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽郭丈彦邹","author":"陈良祐","text":"谁起相如疾，空悲武子亡。\n平生有高志，属意在诸郎。\n梦断驹过隙，风高雁折行。\n莫陪千乘送，妙选愧东床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16587,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三圣殿","author":"陈良翰","text":"巨镇标闽越，灵踪肇晋齐。\n空坛仙一去，古洞佛双栖。\n化石龟犹在，烧丹井已迷。\n尘襟谁复悟，惟听晓猿啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16588,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同舍弟游紫阳","author":"陈芾","text":"紫阳高不极，旧是许仙家。\n古观开山麓，悬崖吐杏花。\n云飞笼晚树，鹤唳落残霞。\n且共探玄理，从他日欲斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16589,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"陈诂","text":"笼鸡对窗语，斗雀绕门飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16590,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吴江太湖笠泽虹桥","author":"陈远","text":"世间八月十五夜，何处楼台得月多。\n不及吴江桥上望，水晶宫里揖嫦娥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16591,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"咏麻姑山","author":"陈陀","text":"晓入麻姑瑞气浮，羽人重喜故人游。\n鹤从仙仗归丹穴，药种灵苗满旧洲。\n乔木老含春色澹，夜溪寒带月光流。\n登临已觉凡尘少，何必区区慕虎邱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16592,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"龟山","author":"陈龟年","text":"山是东南第一峰，长淮古汴渺连空。\n登临不是观泉石，心折神皋指顾中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16593,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游净社寺","author":"陈龟年","text":"古寺何年斲，山空一片云。\n乔松含晚翠，修竹洒清阴。\n老衲朝阳缀，雎鸠带雨吟。\n俗缘何日了，借榻净尘心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16594,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄南海郭宪使","author":"陈供","text":"一望天涯万里舟，波涛如掌见安流。\n霜威清逼珠光夜，海怪寒惊剑气秋。\n人在西风何处梦，书回南雁隔年愁。\n政成载月归来后，须到沧洲访白头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16595,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送素上人游方","author":"陈叔坚","text":"不是无衣钵，师心酷爱山。\n自言行脚好，却厌住庵閒。\n野水寒林外，孤云夕照间。\n清游何处寺，须寄好碑还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16596,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"龙隐洞","author":"张埏","text":"几年鳞甲蛰清渊，一旦飞腾石自穿。\n遗迹谩存离旧隐，定应衔雨去朝天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16597,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"双皂荚行","author":"陈叔度","text":"绿叶森森迎晓日，双双暗结秋霜实。\n乾坤造化借风流，阴灵滑稽为谁匹。\n一蒂双葩心两同，风力雨绵神其功。\n中官始奏献奇异，祥图瑞牒挥毫锋。\n四海万方只一株，缭绕周墙百丈馀。\n侍从宫娃共争取，攀援棘刺血罗襦。\n采得温泉奉金辇，雪瑩肌肤红玉暖。\n合欢当前此物生，上皇都笑天机浅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16598,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"陈国材","text":"红日晚天三四雁，碧波春水一双鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16599,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"沁园春","author":"陈坦之","text":"睡起闻莺，卷帘微雨，黄昏递愁。\n正青翰音断，离怀几摺，碧云暮合，千里双眸。\n思发花前，人归雁后，误记归帆天际舟。\n浑无据，但馀香绕梦，频到西楼。\n风流。\n翻是花雠。\n谩长遣眉山翠不流。\n想哀筝绕指，鸿移凤咽，残灯背泣，玉沁春柔。\n夜月精神，朝阳微艳，何处瑶台轻驻留。\n愁无际，被东风吹去，绿黯芳洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16600,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"柳梢青","author":"陈坦之","text":"绿弱红臞。\n暖云沁雨，乍有还无。\n破晓幽禽，平渠流水，春响庭除。\n梅酸初著花跗。\n似滴滴、新愁未舒。\n几信花风，一痕青烧，万里秦吴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16601,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谒金门","author":"陈坦之","text":"归未卜。\n频倒金彄纤玉。\n明月绡窗停剪烛。\n搦愁题蠹绿。\n秋水娟娟鱼目。\n腰素几分销缩。\n接得云笺无意读。\n雕鞍何处宿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16602,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"塞翁吟","author":"陈坦之","text":"远碧秋痕瘦，楚玉恨赋凄凉。\n荷雨碎，泣残妆。\n系愁在垂杨。\n秋衣拂叠仙栀露，裁云刀尺犹香。\n诗锦字，献明珰。\n肯容易相忘。\n思量。\n空掩抑，分宵缓枕，终不敌、凉谯漏长。\n自解佩、兰皋去后，渐消灭、香梅酝藉，小杜疏狂。\n年华驶水，鬓影西风，都付清觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16603,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答清江钱大尹问閤皂山中景","author":"陈孟阳","text":"形如閤皂对清江，吴汉神仙古道场。\n玉像灵多民受赐，天书岁久墨犹香。\n绛霞密锁灵仙馆，碧雾轻笼正一堂。\n苍藓斓斑双鲤石，寒泉澄湛九龙塘。\n著衣台上三冬暖，鸣水亭前六月凉。\n捣药鸟声喧夜榻，升天马迹印西冈。\n葛憩源深生异草，凌云峰峻染瑶光。\n丹井虽存人杳漠，松巢空见鹤飞翔。\n屏妆水墨誇陶弼，门断尘埃忆孟昌。\n风来松桧笙箫地，春入园林锦绣乡。\n个中自少红尘到，闲里惟知白昼长。\n景物敢吟成实录，愿凭贤宰一称扬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16604,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乙丑春旱至四月十六夜雨 其二","author":"陈宓","text":"何处笙歌酒入唇，应惭忍渴望云人。\n朝来顿觉西山黑，农圃欢声总是春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16605,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乙丑春旱至四月十六夜雨 其一","author":"陈宓","text":"说梅津漱不濡唇，秧稻堪惊陌上人。\n昨夜天公一翻手，苍生百万面生春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16606,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"入暮","author":"陈宓","text":"溪光延夕暝，山色接天青。\n独立待霜月，山童已触屏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16607,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"八月五日妙寂道中 其一","author":"陈宓","text":"漫漫红紫是谁栽，八月春风暗里来。\n过眼纷纷难尽忆，殷勤却看稻花开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16608,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"八月五日妙寂道中 其二","author":"陈宓","text":"山间万点缀黄琼，尽是秋光酿得成。\n残暑满城痴未退，一枝能使去兼程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16609,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"又和单丞咏梅","author":"陈宓","text":"树杪风来玉佩惊，仙香远胜市廛清。\n细看一段孤高趣，恰似幽人避世情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16610,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"又和喜晴","author":"陈宓","text":"年来日日候阴晴，浑是耕耘陇上人。\n但得鸡豚欢里社，敢将蛊鼠累陶钧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16611,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三月芙蓉盛开二十馀花和友人韵 其二","author":"陈宓","text":"云袖霞衣自等差，天风吹下玉皇家。\n似怜桃李无颜色，来伴姚黄魏紫花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16612,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三月芙蓉盛开二十馀花和友人韵 其一","author":"陈宓","text":"芳辰美景最难兼，桃李春风桂子蟾。\n百卉并生吾道泰，嘉祥敢恃我师谦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16613,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与友人中元作别九月十日复会中间节物不得共观追酬所愿有今夕在聊成小诗谢之","author":"陈宓","text":"两逢佳节独登楼，一醉樽前拟并酬。\n昨日黄华今更好，此宵明月胜中秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16614,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与赵录参游东湖 其二","author":"陈宓","text":"四山围绕池居内，百雉周遭人莫过。\n此是延平新胜概，月明拟办一渔蓑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16615,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与赵录参游东湖 其一","author":"陈宓","text":"天河凿就馀三亩，腊雨增成四尺波。\n我与同寮来共看，一时都喜镜初磨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16616,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与高画生","author":"陈宓","text":"衰颜不似十年前，今日重模一惘然。\n拟向沧洲寄尘迹，凭君归报小蓬仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16617,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"大目寺牡丹","author":"陈宓","text":"行人那得不如狂，谪下仙真衣锦裳。\n要识洛阳姚魏色，烦君千里到维扬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16618,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山丹五本盛开 其一","author":"陈宓","text":"今年丹荔逐南风，独有名花发旧丛。\n似恨庭前绛囊少，慇勤来献绣毬红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16619,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山丹五本盛开 其二","author":"陈宓","text":"簇簇丹葩巧作丛，开时两月受薰风。\n北人见此应偷眼，未羡猩唇鹤顶红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16620,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山寺","author":"陈宓","text":"疏林漏晓日，脩竹起寒风。\n钟鼓催朝暮，千年如此同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16621,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山行","author":"陈宓","text":"禽声戛玉琤如堕，蝶翅新妆粉欲飞。\n山静物闲无一事，却嫌钓叟下鱼矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16622,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中夜","author":"陈宓","text":"功名有念心常醒，更鼓无声夜更长。\n天运乾乾同转磨，鬓毛能不几时霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16623,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中秋前偶题 其一","author":"陈宓","text":"百岁中秋几月明，长先十日候阴晴。\n清风不觉传三鼓，又恐冰轮碾女城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16624,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中秋前偶题 其二","author":"陈宓","text":"世事浮云频改换，月华千古祇清新。\n炎风暑气常侵客，纵有凄风亦可人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16625,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丹桂","author":"陈宓","text":"自是仙家别样妆，风来疑解舞霓裳。\n异香只许蟾宫采，不与秋光作伴黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16626,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书怀","author":"陈宓","text":"书卷丛中偏得垂，园花开后却慵看。\n嵬胸莫受一尘染，壮岁须腾万里翰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16627,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书帷","author":"陈宓","text":"青编有补曾无损，白璧难全易作瑕。\n欲下凉帷玩真味，莫将丝履染尘沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16628,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"予守南康适当旱岁睹东坡玉涧留题喜雨书之庶几新年三白之符也","author":"陈宓","text":"雪堂居士醉方熟，玉涧仙人冷不眠。\n送与安州泼醅酒，一年三白是丰年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16629,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"云台寺梅坡 其二","author":"陈宓","text":"树杪风来玉佩轻，仙香飘作世间清。\n一枝不许来城市，祇伴高人避世情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16630,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"云津阁","author":"陈宓","text":"山色月中犹见碧，溪流枕上更宜声。\n身轻阁稳欣投宿，此是还家第一程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16631,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"五月下旬雨后喜晴","author":"陈宓","text":"晓来初日满林光，犹见枝头梅子黄。\n一对蝉声相上下，柳丝摇曳与俱长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16632,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"六月三日大风雨蔡忠惠家玉堂红一洗而尽因忆去年三山帅宪各致馈","author":"陈宓","text":"三年渴想玉堂红，六月都随一夜风。\n却忆去年当此际，一时台府馈筠笼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16633,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"六月祷衍山剑镡得雨 其四","author":"陈宓","text":"好善如君似饥渴，春华下笔吐芳词。\n莫言郡小无多事，协力从今请共治。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16634,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"六月祷衍山剑镡得雨 其二","author":"陈宓","text":"连宵清雨洗炎光，六月浑如九月凉。\n拟向暇晨村郭外，西风高下看云黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16635,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"六月祷衍山剑镡得雨 其三","author":"陈宓","text":"窘无财粟振民饥，仰扣天阍愧纳词。\n连月心胸成菀结，通宵一雨为医治。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16636,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"六月祷衍山剑镡得雨 其一","author":"陈宓","text":"自昔山川致云雨，我今坛筑为焚香。\n三回应祷皆如响，始验吾儒道术长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16637,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"分水岭","author":"陈宓","text":"区域瓯闽此岭存，朝来飞雨暮行云。\n方今天下车同轨，一水如何强别分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16638,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"忆天台之游","author":"陈宓","text":"小酌一杯金凿落，共听终席玉潺湲。\n何时筑室屏山侧，静与秋蟾作伴眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16639,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"月岩 其三","author":"陈宓","text":"常时百步马先疲，今日岩前故不迟。\n回首兔宫犹未远，会须千里巧相随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16640,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"月岩 其二","author":"陈宓","text":"人间元有广寒宫，谁道仙凡路不通。\n借问蓬莱相近否，不须七椀去乘风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16641,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"月岩 其一","author":"陈宓","text":"谁将玉斧凿岚烟，放出团团白昼天。\n自是天公恨盈缺，故开云月要长圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16642,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王主簿右州某日思其归因见黄华动渊明之兴方欲寄诗忽承佳句次韵见意 其二","author":"陈宓","text":"静坐思君秋日长，清波白鹭两茫茫。\n定应嚼遍湘累菊，寄我新诗字字香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16643,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"见月","author":"陈宓","text":"皓月忽从墙角见，好风时送竹声来。\n事随日出无时暇，薄暮尘襟始一开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16644,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"风雨过武夷山","author":"陈宓","text":"我与兹山是故人，十年相别意弥真。\n如何咫尺迷风雨，刚道情亲却不亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16645,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"风雨涨檐溜忆东平以疾不往","author":"陈宓","text":"不到东平夏又秋，闲居身尚不吾由。\n可怜岩上千寻瀑，不似檐前一派流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16646,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"出古田道中","author":"陈宓","text":"尽历崎岖到古田，平生未识此攀缘。\n白云破处青岚见，知有山围峻属天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16647,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"四月下旬见黄梅水栀花","author":"陈宓","text":"人间桃李漫春风，流水飞埃过眼空。\n谁信黄梅深院静，水栀如玉映群红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16648,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"四月中浣流惠亭见莲 其二","author":"陈宓","text":"疾雷不雨卷行云，湖面清风篆玉文。\n我自得间来卧看，狎人鸥鹭亦成群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16649,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"四月中浣流惠亭见莲 其一","author":"陈宓","text":"谁言红艳占春多，风雨真成一掷梭。\n何似水花秋更好，才逢四月已开荷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16650,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]