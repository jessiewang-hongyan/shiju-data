enance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23200,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"徐师垕广行家集定价三百","author":"叶适","text":"徐照名齐贾浪仙，未多诗卷少人看。\n惜钱嫌贵不催买，忽到鸡林要倍难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23201,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"翁常之挽词 其二","author":"叶适","text":"秀峰插天下回溪，曾送郴州路久迷。\n更欲扶衰为公往，葛陂龙化的卢嘶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23202,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"翁常之挽词 其一","author":"叶适","text":"晋画唐吟老愈奇，堪嗟动转是风机。\n幸能栩栩形中去，何不蘧蘧梦里归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23203,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"请惟耿住水陆院","author":"叶适","text":"宰官不管僧閒事，北秀南能总未亲。\n说似随缘耿长老，这回住院且繇身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23204,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读叶子元诗题其后","author":"叶适","text":"心閒误比游丝转，境胜空疑浊燄流。\n我亦输君闻早觉，醉吟都与句中收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23205,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郭宰为郑全真殁买田以赡其后","author":"叶适","text":"郑生在日常无食，身后恓惶又可知。\n郭象有缘天付与，新租满碓不言饥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c0685