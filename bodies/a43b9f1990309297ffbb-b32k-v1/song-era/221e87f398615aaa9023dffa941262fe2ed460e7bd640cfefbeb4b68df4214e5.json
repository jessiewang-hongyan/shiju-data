[{"title":"致政中散荀龙连惠三篇俯光衰老辄亦依韵和呈再鼓羸师其气已竭止希一览而弃之可也","author":"文彦博","text":"郢楼高唱丽阳春，重叠三章妙入神。\n席上纵欢殊不倦，樽前道旧转相亲。\n故交共是休闲客，令子今为辅弼人。\n河内仙居颇优逸，风流雅尚有谁伦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35800,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"河阳寄留守相公","author":"文彦博","text":"暂别荧煌座，初为半月期。\n洛城归意切，不独为花时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35801,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵留守相公促令归洛","author":"文彦博","text":"自古锦城虽可乐，犹言不若早还家。\n三城争似洛城乐，只是安仁一县花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35802,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢留守相公尧夫惠书及诗意爱勤重 其一","author":"文彦博","text":"河阳满县花称好，仰望山川难比肩。\n留钥惠诗锵玉振，采毫洒墨灿星联。\n樽前毕集邹枚客，舟上同登李郭仙。\n伊叟依刘心更切，柴车促驾即言还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35803,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢留守相公尧夫惠书及诗意爱勤重 其二","author":"文彦博","text":"雨后全无京洛尘，名园胜景好游人。\n东田兼有春毬探，来就三城报得春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35804,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题河阳太师堂 其一","author":"文彦博","text":"自别三城十九年，重来旧迹总依然。\n鲤庭兼是鱼符守，戏綵承颜慰目前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35805,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题河阳太师堂 其二","author":"文彦博","text":"河桥洛宅近相望，三月花时日又长。\n暂整安车来子舍，为吾特启太师堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35806,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游花市示之珍","author":"文彦博","text":"去年春夜游花市，今日重来事宛然。\n列肆千灯争闪烁，长廊万蕊斗鲜妍。\n交驰翠幰新罗绮，迎献芳樽细管弦。\n人道洛阳为乐国，醉归恍若梦钧天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35807,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题伊叟庵 其一","author":"文彦博","text":"斯干室上上方北，岩伴自为伊叟庵。\n每到庵中须熟寝，觉来惟共老僧谈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35808,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题伊叟庵 其二","author":"文彦博","text":"此庵庵北望伊堂，南望伊川极目长。\n更有箕山并颍水，连延直入挂瓢乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35809,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清明后同秦帅端明会饮于李氏园池偶作","author":"文彦博","text":"洛浦林塘春暮时，暂同游赏莫相违。\n风光不要人传语，一任花前尽醉归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35810,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贤大师以诸巨公画像见示传神写照曲尽其妙兼丐拙诗辄成一首奉呈","author":"文彦博","text":"用志专精妙入神，援毫肖象夺天真。\n能将绘素传奇表，似与公侯结胜因。\n娄德高僧通夙命，王维善画记前身。\n师缘素习今生悟，曾写云台四七人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35811,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题郭熙画樵夫渡水扇","author":"文彦博","text":"浅水深山一径通，樵夫涉水出林中。\n可怜画笔多情思，写在霜纨一扇风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35812,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"经略大观文相公寄示东田别后一篇谨次元韵","author":"文彦博","text":"出处交游数十年，故情勤重见矜怜。\n东田屡涉求羊径，西洛频陪李郭仙。\n四路连城归节制，万兵开府壮威权。\n雅章垂贶尤奇绝，走笔如风似涌泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35813,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵留守相公以某赴东庄特赐佳篇","author":"文彦博","text":"东郊瘠土才千亩，绕舍团椒仅百家。\n地接玉泉多草木，路经缑岭少风沙。\n能留过客虽无饵，时对清樽亦有花。\n昔日相君曾降顾，常忧蜗陋不容车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35814,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"驾经略太尉相公移镇太原 其一","author":"文彦博","text":"国节移全晋，阶符应列星。\n新开大幕府，俗号小朝廷。\n风偃殊邻服，威加绝塞宁。\n归来烟阁上，肖象炳丹青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35815,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"驾经略太尉相公移镇太原 其二","author":"文彦博","text":"北首并州路，旌幢拥画轮。\n万兵严后从，百吏拜前尘。\n汉相仪刑重，尧风气俗淳。\n政成期月报，四海望洪钧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35816,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"驾经略太尉相公移镇太原 其三","author":"文彦博","text":"将军号令柳营传，缓带投壶自适然。\n一片笙歌闻四面，晋公旧事在龙泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35817,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"驾经略太尉相公移镇太原 其四","author":"文彦博","text":"晋阳襦裤歌来暮，洛宅衣冠动去思。\n若到参虚念嵩少，北园南望下楼迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35818,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"忆东溪","author":"文彦博","text":"常忆东溪溪上坐，相从惟有野僧来。\n可怜鸥鸟知人意，料得无机总不猜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35819,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"某以端居多暇怀洛成诗伏蒙运使兵部俯垂属和拙诗伸谢","author":"文彦博","text":"倦翼念归林，幽怀动越吟。\n更回溪叟信，深契野云心。\n巴里传高唱，英韶继善音。\n便须传洛社，纸价重千金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35820,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"运使兵部以某驰想林泉拙诗言志荐承属和曲有褒嘉今复致谢","author":"文彦博","text":"为忆伊川坞，因成洛社吟。\n永言聊见志，真赏得知心。\n黼绣频加饰，夔牙屡振音。\n传家同秘宝，不啻满籯金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35821,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"运使兵部见采拙诗四沐继和唱者已竭而答者无穷内省小巫敢当大敌既难收合馀烬愿为城下之盟","author":"文彦博","text":"引玉才三唱，投珠已四吟。\n一钧皆协律，六义尽同心。\n巨浸倾无竭，洪钟叩有音。\n鼓行君正勇，怯者原闻金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35822,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"元师迁化其徒得舍利供于天钵因作四十言赞叹既而得殿省苏承诗又增十字","author":"文彦博","text":"师今顺寂去，所寂竟何如。\n倏尔归无物，湛然同太虚。\n化成三昧火，超出四禅居。\n方悟祇园法，又胜漆园书。\n苏君善知识，言诗更起予。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35823,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"令弟坚官满归京偶成四十言代书寄判武学顾学士略资一噱","author":"文彦博","text":"多年判武学，未改旧官衔。\n有意将投阁，无人为解骖。\n师资尽韬略，况味极齑盐。\n闻说鲈鱼好，归心风满帆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35824,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蒙惠咸阳水梨极佳快陶隐居谓梨为快果太原凤栖梨少许纳上非报也欲校其味耳吕大忠运使惠","author":"文彦博","text":"凤栖佳果玉浆寒，马乳龙须味一般。\n未敢便教充钉坐，更将冰蜜校量看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35825,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"承答诗披览叹服无已今复和呈资一噱而已","author":"文彦博","text":"药录虽称性味寒，涤烦功效有多般。\n从来御宿嘉名著，岂与西沙一例看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35826,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"承惠梨栗前诗止及梨今并及之荒词喧黯又增战栗","author":"文彦博","text":"盈襜始自终南采，兼量初从御宿般。\n寄到邺城人未识，阿通欣跃已先看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35827,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"承惠鳜白鱼蛤蜊仍以佳章见示并深珍感辄依来韵奉和且申致谢之意 其一","author":"文彦博","text":"多鱼见馈逾双鲤，异味兼常过八珍。\n更使伊宾垂钓手，转思东上鲙鲈人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35828,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"承惠鳜白鱼蛤蜊仍以佳章见示并深珍感辄依来韵奉和且申致谢之意 其二","author":"文彦博","text":"望月怀珠重紫唇，隔墙闻卖已称珍。\n奁收箧贮承佳惠，深济颓山病酒人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35829,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偶书答岐守吴卿","author":"文彦博","text":"君说归期未有期，西风又是鲙鲈时。\n何当会集香山伴，同赴松窗烛下棋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35830,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东溪奉送景仁内翰归东都 其一","author":"文彦博","text":"君自东都至西洛，风光相赏不相违。\n瑞雪承露从头看，看到姚黄兴尽归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35831,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东溪奉送景仁内翰归东都 其二","author":"文彦博","text":"暮春脩禊洛川游，丝管随登李郭舟。\n仲损昌言俱未至，凝眸东望不回头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35832,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东溪奉送景仁内翰归东都 其三","author":"文彦博","text":"送君东至伊东坞，东望青嵩与白云。\n又向嵩云更东去，花前把酒惜离群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35833,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂送天钵长老","author":"文彦博","text":"江无行化久，法眼众推尊。\n不惮南来远，缘从北请频。\n潮音振祖道，朔土辟宗门。\n有授传高弟，无遮接下根。\n慈航拯群溺，慧日破重昏。\n老守心迷钝，求师求一言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35834,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"五老会诗","author":"文彦博","text":"四个老儿三百岁，当时此会已难伦。\n如今白发游河叟，半是清朝解绶人。\n喜向园林同燕集，更缘樽酒长精神。\n欢言预有伊川约，好作元丰第四春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35835,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"耆老会诗","author":"文彦博","text":"九老唐贤形绘事，元丰今胜会昌春。\n垂肩素发皆时彦，挥麈清谈尽席珍。\n染翰不停诗思健，飞觞无算酒行频。\n兰亭雅集誇脩禊，洛社英游贵序宾。\n自愧空疏陪几杖，更容款密奉簪绅。\n当筵尚齿尤多幸，十二人中第二人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35836,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再酬富公一绝","author":"文彦博","text":"洛下衣冠今最盛，当年尚齿礼容优。\n惟公福寿并勋德，合是人间第一流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35837,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵秦帅经略吕通议过洛少留","author":"文彦博","text":"喜过西都暂解鞍，樽前不惜醉酡颜。\n推襟道旧从容久，落笔成诗顷刻间。\n塞外定知威令肃，幕中常得雅歌闲。\n相门出相归人望，琐闼难淹侍从班。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35838,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"家园花开与陈大师饮茶同赏呈伯寿正叔昌言","author":"文彦博","text":"今朝自赏家园花，浓艳繁英粗可誇。\n外监上坡俱不至，紫园仙客共烹茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35839,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"近以洛花寄献斋阁蒙赐诗五绝褒借今辄成五篇以答来贶端明 其一","author":"文彦博","text":"左魏牛黄数十枝，洗妆添色又新奇。\n金刀剪送三城去，聊助山翁宴习池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35840,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"近以洛花寄献斋阁蒙赐诗五绝褒借今辄成五篇以答来贶端明 其二","author":"文彦博","text":"山翁为赏洛花奇，采笔连挥五绝诗。\n口沫手胝频捧读，兰亭醉墨尚淋漓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35841,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"近以洛花寄献斋阁蒙赐诗五绝褒借今辄成五篇以答来贶端明 其三","author":"文彦博","text":"旧说河阳满县花，安仁当日颇矜誇。\n洛城花品虽奇绝，多出寻常百姓家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35842,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"近以洛花寄献斋阁蒙赐诗五绝褒借今辄成五篇以答来贶端明 其四","author":"文彦博","text":"朱轮大旆行春乐，济上山阳景物佳。\n莫羡洛城花品好，三城本自有朱砂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35843,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"近以洛花寄献斋阁蒙赐诗五绝褒借今辄成五篇以答来贶端明 其五","author":"文彦博","text":"后园不见栽桃李，旧尹无能可自知。\n从使当时曾手植，经今十载亦凋衰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35844,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"近闻有真率会呈提举端明","author":"文彦博","text":"近知雅会名真率，率意从心各任真。\n颜子箪瓢犹自乐，庾郎鲑韭不为贫。\n加笾只恐劳烦主，缉御徒能困倦宾。\n务简去华方尽适，古来彭泽是其人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35845,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"提举端明宠示三月三十日雨中书怀包含广博义味精深词高韵险宜其寡和辄次元韵","author":"文彦博","text":"春光垂欲尽，夏景渐增添。\n郁郁松篁茂，萧萧风雨兼。\n花心随絮落，屐齿被苔粘。\n巧啭莺迁木，惊飞燕入帘。\n虾须穿曲沼，虎爪度前檐。\n坐久香销炷，吟多笔费尖。\n云容方霭霭，日色未炎炎。\n舞鹤倾丹顶，游龟散绿髯。\n命宾常务率，出令更须严。\n诗咏当阶药，书寻傍架签。\n兰芬衣可袭，露润草俱沾。\n贵近辞金马，编脩赐玉蟾。\n高欢惟自适，独乐未尝厌。\n赤白曾咨丙，丹青每诮阎。\n冲和缘养浩，寂寞为安恬。\n身处贫无愧，心贪道不廉。\n成文推大手，济用鄙轻缣。\n视履循清节，祈恩陋杂占。\n闻韶欣凤舞，在藻爱鱼潜。\n鲈鲙思鱼艇，貂冠望酒帘。\n圣时非吏隐，贤业系民瞻。\n抚事惟公论，摛辞乃自谦。\n保躬诚易退，康世义难淹。\n颣句惭无取，酬言幸不嫌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35846,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"奉陪伯温中散程伯康朝议司马君从大夫席于所居小园作同甲会","author":"文彦博","text":"四人三百十二岁，况是同生丙午年。\n招得梁园同赋客，合成商岭采芝仙。\n清谈亹亹风盈席，素发飘飘雪满肩。\n此会从来诚未有，洛中应作画图传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35847,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"子山朝奉倅汝阴过洛访别求诗","author":"文彦博","text":"邺下才名同七子，六年开幕得嘉宾。\n屈从颍水投馀刃，合去甘泉作从臣。\n素以潘阳敦信睦，仍于洛孟卜仁邻。\n士元骥足难羁绊，即见康衢势绝尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35848,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"留守相公和提举端明作三寿公字韵诗辄继前韵 纪留守相公","author":"文彦博","text":"三川开盛府，万钥主离宫。\n雪苑延梅叟，湖园奉晋公。\n因依念有素，出处幸多同。\n雅会欢言意，今推前辈风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35849,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"留守相公和提举端明作三寿公字韵诗辄继前韵 自述并谢留守相公","author":"文彦博","text":"千载亲逢圣，三槐位忝公。\n周行簉鹓鹭，渭水愧罴熊。\n致主曾无术，康时岂有功。\n台文形雅咏，褒假过优隆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35850,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"留守相公和提举端明作三寿公字韵诗辄继前韵 景仁内翰","author":"文彦博","text":"春色满伊嵩，春花拆万红。\n欣逢翰林主，还访玉壶公。\n听赏吹箫凤，陪随飞盖鸿。\n樽前忍轻别，乐事转头空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35851,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"留守相公和提举端明作三寿公字韵诗辄继前韵 君实端明","author":"文彦博","text":"水轩淙夜响，花寨烨春红。\n中有群书府，恬然独乐公。\n清吟如唳鹤，高翥若冥鸿。\n汗简犹多费，时闻橐屡空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35852,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"承伯寿大蓬惠书寄大小钵囊花并语及敝居松下石上之饮因成二小诗 其一","author":"文彦博","text":"片石长松时下有，青山绿水觉来无。\n姚黄赏尽东归去，六六峰前会酒徒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35853,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"承伯寿大蓬惠书寄大小钵囊花并语及敝居松下石上之饮因成二小诗 其二","author":"文彦博","text":"大小钵囊花色好，不知得似此间无。\n玉华峰下应频赏，绮里园中是饮徒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35854,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵留守相公洛中金橘","author":"文彦博","text":"嘉实本从南地产，移栽洛土结成时。\n踰淮未必全为枳，方信中邦物物宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35855,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"北都留守相公韩以某顷守魏都粗脩斋舍特加标榜仍示雅章谨依高韵","author":"文彦博","text":"载守铜壶踰八岁，渐营凉室与温房。\n疏帘夏捲清风阁，密幄冬褰爱日堂。\n窗静坐闻松竹韵，径深行袭蕙兰香。\n已惭必葺非宏丽，更愧佳章比召棠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35856,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠国信毕少卿北京作","author":"文彦博","text":"邺下常推七子才，兔园宾客重邹枚。\n三千里外出疆去，四五年前点顿来。\n将幕未归惭老大，使旃重到喜追徘。\n朔风不度龙沙远，只向云中讲信回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35857,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答庞相家园虽陋春物向荣日冀相车时枉游览未蒙宠降承贶佳章谨次严韵","author":"文彦博","text":"一廛幽趣斗城西，竹映轩窗柳拂堤。\n园吏每誇风物美，主人常叹簿书迷。\n碧池荷动观鱼戏，朱槛梧倾待凤栖。\n惟愿毗耶长者至，莫忧花里有莺啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35858,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题龙门奉先寺兴禅师房","author":"文彦博","text":"伊叟已先至，兴公犹未归。\n凭高东北望，一片白云飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35859,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偶书扇面","author":"文彦博","text":"人生七十古来稀，老境来侵老病随。\n自算愚年垂九十，也须惭愧耳聋迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35860,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"慈圣皇太后挽词 其一","author":"文彦博","text":"仁皇当宁久，圣后配天崇。\n厚德符坤象，先朝定震宫。\n尊荣三代礼，拥佑两朝功。\n徽范并慈训，皆留信史中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35861,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"慈圣皇太后挽词 其二","author":"文彦博","text":"圣孝攀慈范，神游冀少留。\n重明缘积庆，阴德在贻谋。\n制服从恩重，因山变礼优。\n白云何处去，雪涕望嵩丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35862,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"慈圣皇太后挽词 其三","author":"文彦博","text":"榆輴渐出金门远，兰膳深悲玉座空。\n奕叶舜华推至孝，前朝文母继清风。\n柏城郁郁依嵩北，石阙隆隆镇洛东。\n白发老臣何以报，日期西去扫山宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35863,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"英宗皇帝挽词 其一","author":"文彦博","text":"乾德符亨会，天飞出庆宁。\n继明光五叶，启圣协千龄。\n方保瑶图永，俄悲玉殿青。\n定知迁宝座，还集太微庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35864,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]