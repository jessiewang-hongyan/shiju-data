[{"title":"夏日","author":"宋祁","text":"六幕风轻昼刻长，地形卑湿近南方。\n人挥羽翣依林樾，绠续金瓶下井床。\n云路飞鸢愁跕跕，玉徽流水怨汤汤。\n尸官盛府中乾甚，久饮台冰未觉凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47423,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏日江渎亭小饮","author":"宋祁","text":"飞槛枕溪光，欢言客遍觞。\n暂云消树影，骤雨发荷香。\n辛臼橙齑熟，庖刀脍缕长。\n蘋风如有意，盈衽借浮凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47424,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏日池上 其一","author":"宋祁","text":"溪流来不近，永日映霞霏。\n水荇自相缭，汀禽无次飞。\n颓沙时损路，幽濑忽藏矶。\n谁欲留连我，相将日暮归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47425,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏日池上 其二","author":"宋祁","text":"独坐溪堂上，炎天客少过。\n红垂初熟果，碧捲未开荷。\n曳絮云更坞，摇金日弄波。\n一杯聊自举，凉意雨前多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47426,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏日陪提刑彭学士登周襄王故城","author":"宋祁","text":"聊随汉使者，一上周王城。\n片雨北郊晦，残阳西岭明。\n野禽呼自别，香草问无名。\n谁复歌离黍，惟兴箕颍情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47427,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"家居","author":"宋祁","text":"赁庑接中林，迷途感慨深。\n穷年不材木，提月退飞禽。\n官宇昏投版，私囊利挫针。\n病呻无用怪，不是显时吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47428,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"家居","author":"宋祁","text":"郁郁行何适，肩肩体寖臞。\n安人非善宦，宁子是真愚。\n北化随江枳，东游谢海桴。\n何须命私驾，危涕避穷途。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47429,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"徐帅北归","author":"宋祁","text":"旧国青山阔，仙岩绿桂春。\n金壶柱史客，玉札上清人。\n学雾应成市，泠风肯待旬。\n他年留半剂，牝谷愿凝神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47430,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽张元常葬母夫人二首 其二","author":"宋祁","text":"婴病曾无苦，期颐未满年。\n风酸吹棘地，露泣采兰天。\n庀具藏分泽，张琴委暗弦。\n江流终不竭，懿范此俱传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47431,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽张元常葬母夫人二首 其一","author":"宋祁","text":"象服流恩贵，轻舆就养荣。\n新成大家赋，经饷颍封羹。\n过隙诚难驻，藏舟自不惊。\n子贤能顺礼，三月祔佳城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47432,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病兴","author":"宋祁","text":"病兴还见岁华阴，身属櫜鞬久未任。\n主画固须烦孟博，作书宁免倩陈琳。\n仙丸玉匕贪馀饵，甜酎银瓯喜细斟。\n谁笑衣囊长寂寞，横思新得汉台金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47433,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病兴见春物欣盛释然有临眺之意","author":"宋祁","text":"东风掠野暂轻埃，洒洒残寒伴落梅。\n晓报谷莺朋友动，暖将塞雁弟兄回。\n骤生溪水迎人远，自喜林花索露开。\n老罢何颜玩芳物，试凭狂醉上春台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47434,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病兴早朝","author":"宋祁","text":"万辔冬珑凤阙西，病兴重喜趁朝闺。\n初霞稍上岩廊戟，落月催传卫士鸡。\n温树未凋风力薄，仙杯已满露华低。\n明光一对清光罢，昏目犹惭眩转迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47435,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病告作寄武平湖内翰","author":"宋祁","text":"病拥绨袍雪领垂，当关重叠报晨晖。\n夷吾畏事将成吃，蘧瑗增年转悟非。\n宦路风波频岁剧，故山薇蕨每春肥。\n馀生正似风前鹢，惭负阳秋说退飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47436,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病间答杂端庞淳之见寄","author":"宋祁","text":"廓落弥旬故眼移，居惭君粟养支离。\n绫衾倦梦愁淹卧，星鬓流年报早衰。\n药剂袪繁催月杵，茗腴供啜嗜春旗。\n迷魂复干闻清唱，不减巫阳筮些诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47437,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"监中会两禁诸公饮饯吴舍人梁正言富修撰叶龙图以计省不赴作诗见寄","author":"宋祁","text":"殊庭诏跸斗车回，学省歌骊宴豆开。\n孺子橐閒同放笔，景山铛暖不停杯。\n桥门细溜生寒沼，经市斜光落晚槐。\n捉麈知君非兴浅，枉教华剧计筹催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47438,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"真定述事","author":"宋祁","text":"莫嫌屯垒是边州，试听河山说上游。\n帐下文书三幕府，马前韡靺五诸侯。\n王藩故社经除国，侠窟馀风解报仇。\n四十年来民缓带，使君何事不轻裘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47439,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"离宛丘舟中作","author":"宋祁","text":"孑孑归樯五两斜，浮云尽处是京华。\n不随东鲁人浮海，正似新丰犬识家。\n笏首新荷寻珥笔，腰间故印解垂緺。\n多年蹇足蹒跚甚，却畏丹泥九墄赊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47440,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"笔次","author":"宋祁","text":"菱花照鬓感流年，始觉空名尽偶然。\n十掷成犍宁是拙，一丸求药浪图仙。\n位卑司败无言责，事少当关许晏眠。\n上此隳官堪自劾，不烦公掾更平镌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47441,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"荷花","author":"宋祁","text":"晚雨跳珠万盖匀，红房高下照池新。\n采时双艇须加桨，行罢微波不见尘。\n解把清香贻密坐，忍将芳意付萧晨。\n如何老帅残风味，三占秋英作主人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47442,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"衰感 其一","author":"宋祁","text":"眩罢目还暗，花残鬓益稀。\n长吟病庄舄，孤愤老韩非。\n坊酒叨常秩，雕花滥赐衣。\n家田耕熟未，元亮欲言归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47443,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"衰感 其二","author":"宋祁","text":"秋色遍华颠，真成私自怜。\n身慵宁复事，秋早不依年。\n作吏惟思隐，从僧寖悟禅。\n支离果如此，只称据梧眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47444,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读史","author":"宋祁","text":"昔事堪追咎，斯人亦寡谋。\n臧仓君侧毁，赵孟死前偷。\n直笔空料理，忠臣遂隐忧。\n只应贻后世，三叹废缇油。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47445,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读张巡故事","author":"宋祁","text":"叛将窥华日，英臣死节年。\n城当劲兵处，人甚缀旒然。\n直木摧贪隧，长堤制盗泉。\n羯尘虽覆马，不污沛南天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47446,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读绝交论","author":"宋祁","text":"嫌忌萧朱末，盈虚田窦间。\n言虽甘若醴，心定险于山。\n覆辙何能救，颓波遂不还。\n居然孝标论，抵几若为删。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47447,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"阅古堂","author":"宋祁","text":"堂皇对岑蔚，欢酌坐怡然。\n蟹美持螯日，鲂甘抑鲊天。\n渚翘幽处鹭，林响静时蝉。\n老去兴非浅，无妨清夜旋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47448,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陪季秋大宴","author":"宋祁","text":"秘殿霞暾几刻移，天临法座俨朝緌。\n鱼龙雾暗充庭后，羯鼓风乾解渴时。\n山答欢声来广座，花留和气入繁枝。\n自怜侍从非方朔，不识壶?是隐词。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47449,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乾元节锡庆院燕","author":"宋祁","text":"盛节推慈洽宴觞，千官不拜俨分行。\n搊弹并给黎园部，曼衍争趋角抵场。\n传炙濯罍纷络绎，神仙綵树互低昂。\n名酋面内千胥乐，欢译遥通戴斗香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47450,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偈答王侍郎","author":"宋祁","text":"遮莫传衣去，饶他舍筏回。\n雪虽炉上见，珠自髻中来。\n劫劫无真谛，人人止妄猜。\n公知兜率否，举足便尘埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47451,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶书","author":"宋祁","text":"病骨岩岩怯早衰，月枝三绕寄身危。\n避风宁望鶢鶋享，出卜频遭偻句欺。\n烟糁蔽江怀隐伴，雨苗颓垄负耕期。\n开年几许他乡泪，尽付穷途与素丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47452,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶成","author":"宋祁","text":"不用真如鼠，胡瞻亦有鹑。\n田园未归客，天地一畸人。\n京邑风霜苦，江乡薇蕨春。\n可能迷鬼笑，长送左朱轮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47453,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶作","author":"宋祁","text":"人远言都废，身閒道转迂。\n是非才一马，多少但双凫。\n学稼惭农老，还山笑客逋。\n嘶蝉何所谓，相伴据庭梧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47454,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶作二首 其二","author":"宋祁","text":"衰翁好藏密，移病此侨居。\n白眼慵迎客，青泥倦襆书。\n风侵残昼网，烟锁蔽春樗。\n惟有伊蒲士，相从乐饭蔬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47455,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶作二首 其一","author":"宋祁","text":"去国日云久，寥寥双鬓衰。\n长安举头近，漳浦窜身危。\n沫俟穷鳃喣，春非坠叶知。\n一廛先亩在，扶耒有归期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47456,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶作寄季长学士","author":"宋祁","text":"已是南宫素发郎，尚持衰味对风光。\n爱吟讵敢追梁甫，倚醉时能问葛彊。\n才苦空疏残史牒，分从澄汰襆衣囊。\n江楼夜月清高地，试问同君一据床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47457,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿直","author":"宋祁","text":"三重仙阁道家山，寓直由来恧素餐。\n漏近章沟先报暝，树连温省未知寒。\n兰釭静对朱花结，芒帙间披白蠹乾。\n前膝正宜无夜召，贾生衰鬓仅胜冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47458,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄大固山嘉祐院长吉上人","author":"宋祁","text":"名高身愈隐，孤锡倚岩扃。\n园布黄金地，台藏白马经。\n庵云吞暝烛，涧月泻虚瓶。\n坐想溪桥路，莓苔又几青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47459,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄弋阳王学士","author":"宋祁","text":"新年给札汉家台，爱伏枚皋受诏才。\n偃蹇不随虞弁进，栖迟翻逐阮麾来。\n倡优技拙飞觞浅，寒具盘空秘画开。\n早暮传车趋一节，敝冠犹望振穷埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47460,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄公序兄资政给事","author":"宋祁","text":"再分铜虎滞侯藩，别后兼闻素领繁。\n契阔不成騑服马，急难空念脊令原。\n壮心干镆年年钝，世路风波衮衮翻。\n缰锁虚名应只尔，早同私驾老邱樊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47461,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄王共","author":"宋祁","text":"沸蚁云罍溢，离鹍雪苑开。\n吏催东府计，卿待楚人材。\n旧隐周萝月，前期禹凿雷。\n我惭芳岁晚，犹俊蹇修媒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47462,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄令狐揆二首 其二","author":"宋祁","text":"紫汉参横宿雾收，烟江南渡怅夷犹。\n梦中未省能知路，天上何缘许寄愁。\n岂有文鳞凭远客，枉缘香杜怨芳洲。\n遥知花艳惊郎目，几曲新诗播郢楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47463,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄令狐揆二首 其一","author":"宋祁","text":"楚山千叠隐南辕，汉渚风樯箭浪翻。\n流水东西俱怨别，离亭长短共销魂。\n歌翻白雪知难和，注怯黄金故易昏。\n玉骨更羸诗笔苦，客裾犹欲曳何门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47464,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄叶兵部","author":"宋祁","text":"吴门练影逐金羁，共羡潜郎得请归。\n殖产旧封千户橘，去台初襆五时衣。\n晨杯斗豉江莼滑，夕俎供糖渚蟹肥。\n分籍未容妨隐趣，海鸥汀鹭对忘机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47465,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄会稽天休学士","author":"宋祁","text":"凫乙天遥水驿长，笠车贪贰会稽章。\n风从射的迎仙舸，水是山阴作禊堂。\n铃阁宴盘留薤白，书林官笔燥雌黄。\n庾郎于此情非浅，应许诸人共据床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47466,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄沂州王学士","author":"宋祁","text":"旧租丞相国，新治使君州。\n坐树贪循政，怀铅倦雅游。\n猿惊乡岭树，蜃结海天楼。\n谁见行春盛，东方最上头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47467,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄连元礼屯田员外","author":"宋祁","text":"忆共西州把酒卮，酒酣风味未全衰。\n人惊李郭同舟日，句索羊何共和时。\n省帐飘香君觐早，箧书腾谤我归迟。\n他年会面须惊怅，瘦尽昆山玉树枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47468,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄净名庵僧长吉","author":"宋祁","text":"故人诗未报，恨恨复经年。\n梦去长江路，心知宝所天。\n孤情岩桂老，逸思暮云传。\n无奈缨緌累，犹乖方外缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47469,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄河东按察待制施正臣","author":"宋祁","text":"并门迢递驾朱轮，紫橐宫毫晦隙尘。\n几眼带移贪事国，半生桐老苦伤春。\n比来置酒觞何属，自此惊秋发恐新。\n鳌署病夫期自代，眼中遍忆未归人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47470,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄泾北都运待制施正臣","author":"宋祁","text":"我作东南守，君为河朔行。\n旌旂向江步，笳鼓入边声。\n共结光华遇，难禁离索情。\n惟应指羊酪，未肯下莼羹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47471,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄郑天休","author":"宋祁","text":"翘车交辟滞东南，盘蕙多年歇赐衫。\n千日醉醒孤共酌，一书开闭遂空函。\n怨归定对王孙草，无恙应随散骑帆。\n倾听囊帷奏嘉颂，清时宁忌绛侯谗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47472,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄南郡直讲王圣源","author":"宋祁","text":"良辰酒所独持杯，目极南云首重回。\n荣路久嗟冠一免，经筵贪爱㰅三摧。\n多年道胜胸中战，即席人推客右才。\n深诏糊名求异等，伫看挥笔映天台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47473,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄药山长老省贤","author":"宋祁","text":"南方有尊者，卓锡恋林丘。\n演法三千界，多闻第一流。\n炉烟熏定几，笋脯供斋瓯。\n社约惭成负，霜莲落几秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47474,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄郭仲微","author":"宋祁","text":"自君入佐张苍计，直室深扃老氏关。\n顾我偶陪螭陛立，无人并驾鹿车还。\n红牙干利资良画，缥帙劳功积厚颜。\n几日归休期一笑，新醪浮白早黎殷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47475,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄鄂渚胡从事","author":"宋祁","text":"红蕖薰幕得僚英，膝下斑裳捧檄荣。\n露茗一枪蠲蜀渴，丝莼千里佐吴羹。\n驻车吏识官桥柳，作赋人传陇坻鹦。\n夜席两宫求士切，天官宁复带糊名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47476,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄献许昌晏相公","author":"宋祁","text":"右辅风烟接上都，功成番爱驻州旟。\n炉经万物为铜后，田是诸侯假璧馀。\n合宴金匏催大白，当年宾从照红蕖。\n向来病守成惆怅，不预怀铅奉相车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47477,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄献南京致政杜相公","author":"宋祁","text":"调元罢后久忘机，三见东山拜诏时。\n言在典谟经舜问，规留廊庙许曹随。\n人间岁月尊黄发，方外讴谣续紫芝。\n举酒祝公千万寿，逍遥长与赤松期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47478,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄献淮阳陈相公","author":"宋祁","text":"翘才阁下旧宾游，偶得鱼符拥使辀。\n本自炉锤依大冶，敢言鎗脚是邻州。\n频年废忘抛黄卷，此地优閒养白头。\n漫引双旌非敏政，馀波须仰富民侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47479,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄献澶渊太傅","author":"宋祁","text":"使旆高翻西北云，舟梁横过九江濆。\n文书吏乐轻车府，表帜人知大树军。\n引溉劭农渠雨密，感凉邀会帐霞醺。\n花门车子能歌地，乐职声诗日夕闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47480,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题相台太尉韩公昼锦堂","author":"宋祁","text":"瑞节前驱昼锦身，堂成署榜示州民。\n迁莺贺燕翩翻集，大树甘棠次第春。\n漳岸夕波能沼溜，魏堂暾日弄梁尘。\n君看千古青编上，得意如公有几人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47481,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题眉州孙氏书楼","author":"宋祁","text":"鲁简多年屋壁藏，始营翚棘瞰堂皇。\n髹厨四匝香防蠹，镂椠千题缥制囊。\n定与乡人评月旦，何妨婢子诵灵光。\n良辰更此邀清赏，庭树交阴隽味长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47482,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题药山牛栏庵壁","author":"宋祁","text":"昔人牛口下，胥宇化南州。\n祖地千灯续，荒垣八字留。\n漏长莲叶晦，园胜柰阴稠。\n后嗣推崇意，同风古佛流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47483,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题滑台园亭","author":"宋祁","text":"有处行春住杏鞯，列亭相望斗翚联。\n花衔晓圃三竿日，树绕洪河一曲天。\n芳草细迎吟路屐，翠篙徐转饮溪船。\n胜游惠政成双纪，乞与州图后世传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47484,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄赠高知县","author":"宋祁","text":"绿发如云艾绶青，弦歌百里久沈英。\n琴台滞讼投刀释，月观雕章梦草成。\n紫芋蹲鸱编富籍，飞觞浮蚁析朝酲。\n何当入会甘泉计，玉树扶疏倚太清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47485,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄襄阳观徐师","author":"宋祁","text":"日夕高阳釂羽杯，琳房岑寂外尘埃。\n山庭桂老幽人住，天陆星翻处士回。\n珍树暝猿侵户啸，碧潭仙菊照窗开。\n箕风动地云罗阔，谁伴凌空禦寇来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47486,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"崔氏逍遥堂","author":"宋祁","text":"戚里封侯旧，家园缔宇初。\n据梧人化蝶，坐石客焚鱼。\n砌草交垂带，窗筠就刻书。\n欲知真趣盛，长者数回车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47487,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"得扬州书","author":"宋祁","text":"四郡连翩拥使旗，多年不听汝南鸡。\n宴开河朔千人帐，书用黎阳一襆泥。\n水曲箭波喧夜橹，原田丝雨劝春犁。\n可嗟未预元规论，坐据胡床送月低。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47488,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"得伯逢书","author":"宋祁","text":"书来何所道，报我二毛生。\n种种因年化，星星著领明。\n别离才几日，感慨若为情。\n且莫悲迟暮，须容四海兄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47489,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]