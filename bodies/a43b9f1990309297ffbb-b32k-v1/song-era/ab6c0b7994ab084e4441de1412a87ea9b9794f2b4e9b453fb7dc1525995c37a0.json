[{"title":"水调歌头 千叶红梅送史君","author":"陈造","text":"胜日探梅去，邂逅得奇观。\n南枝的皪，陡觉品俗又香悭。\n曾是瑶妃清瘦，帝与金丹换骨，酒韵上韶颜。\n百叠侈罗袂，小立耐春寒。\n凝香地，古仙伯，玉尘间。\n烦公持并三友，秀色更堪餐。\n定笑芙蓉骚客，认作东风桃杏，醉眼自相谩。\n想见落诗笔，字字漱龙兰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20391,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江神子/江城子 席上史君令谢芷索词作","author":"陈造","text":"歌筵当日小蓬瀛。\n晚妆明。\n识芳卿。\n挽袖新词，曾博遏云声。\n又侍仙翁灯夕饮，红雾底，沸箫笙。\n催人刻烛待诗成。\n捧雕觥。\n媚盈盈。\n不道醉魂，入夜已瞢腾。\n墨涴香罗回盼处，和笑道，太狂生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20392,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诉衷情令 西湖","author":"陈造","text":"今朝人自藕州来。\n花意尚迟回。\n几时画船同载，云锦照樽罍。\n铃斋外，已全开。\n是谁催，诗仙住处，和气回春，羯鼓如雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20393,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"洞仙歌 赵史君送红梅","author":"陈造","text":"蝶狂风闹，不到凝香地。\n谁见飞琼巧梳洗。\n厌孤标冷艳，不入时宜，银烛底，酒沁冰肌未睡。\n东君怜索寞，分寄寒斋，闹耐残醒嗅芳蕊。\n费西湖东阁，多少诗愁，援彩笔、重与江梅品第。\n算肯容、丹杏接仙游，又却要蕊宫，侍香扶醉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20394,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 十月十三日，宝应宰招饮，弟子常盼酒所指屏间画梅乞词","author":"陈造","text":"冰花的皪冰蟾下。\n松烟竹雾溪桥夜。\n斜倚小峰峦。\n依依同岁寒。\n生绡明粉墨。\n浅笑犹倾国。\n恰似野桥看。\n飘零只等闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20395,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"虞美人 呈赵帅","author":"陈造","text":"凝香仙伯莺花主。\n雅意怜羁旅。\n略分春色便浓欢。\n街吏何妨日日、报平安。\n诗人一醉龙公妒。\n恰限今朝雨。\n关门独酌强伸眉。\n也胜栖栖腰铺、守风时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20396,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝶恋花 范参政游石湖作命次","author":"陈造","text":"山立翠屏开几面。\n画舸经行，蒲葺□□岸。\n想过溪门帆影转。\n湖光忽作浮天远。\n诗卷来时春晼晚。\n愁把钓游，佳处寻思遍。\n不许冷官人所贱。\n拘缠自叹冰蚕茧。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20397,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其三","author":"陈造","text":"醉阅东风百种花。\n醒来长悔误随车。\n须知绿幕黄帘底，别有春藏姚魏家。\n空想像，剩惊嗟。\n梦云从此漫天涯。\n二年得趁花前约，潘鬓缘愁恐更华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20398,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其二","author":"陈造","text":"遍赏扬州百种花。\n因循忘却鬓苍华。\n客闲惯刻分题烛，坐久还生醉眼霞。\n催掺鼓，趁鸣笳。\n未应回首问归槎。\n清明寒食风烟地，判到今春不著家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20399,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其一","author":"陈造","text":"闲去街头赏大花。\n翠帷珠幰护豪华。\n西真宴罢群仙醉，千尺黄云错紫霞。\n团粉黛，闹箫笳。\n使星躔处驻灵槎。\n定知今夜游仙梦，不落西京姚魏家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20400,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"田家谣","author":"陈造","text":"麦上场，蚕出筐，此时祇有田家忙。\n半月天晴一夜雨，前日麦地皆青秧。\n阴晴随意古难得，妇后夫先各努力。\n倏凉骤暖茧易蛾，大妇络丝中妇织。\n中妇辍闲事铅华，不比大妇能忧家。\n饭熟何曾趁时吃，辛苦仅得蚕事毕。\n小妇初嫁当少宽，令伴阿姑顽过日。\n明年愿得如今年，剩贮二麦饶丝绵。\n小妇莫辞担上肩，却放大妇常姑前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20401,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题九锁山","author":"陈逢辰","text":"九山互锁碧烟深，路转花香恼客吟。\n归鹤带云回谷口，潜蛟飞雪喷亭心。\n洞中无计寻芝鼠，箬底犹闻捣药禽。\n莫叹仙凡几尘隔，菊花岩畔是知音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20402,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乌夜啼","author":"陈逢辰","text":"月痕未到朱扉。\n送郎时。\n暗里一汪儿泪、没人知。\n揾不住。\n收不聚。\n被风吹。\n吹作一天愁雨、损花枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20403,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西江月","author":"陈逢辰","text":"杨柳雪融滞雨，酴醾玉软欺风。\n飞英簌簌扣雕栊。\n残蝶归来粉重。\n罨画扇题尘掩，绣花纱带寒笼。\n送春先自费啼红。\n更结疏云秋梦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20404,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泮林释奠偶缘摄事遂获充员窃观礼文乐奏之盛不胜欣叹辄成小诗奉呈僚友","author":"陈邕","text":"春丁逢上日方中，涓吉修诚荐泮宫。\n奠璧采璘诚可格，代庖越俎数徒充。\n八音合奏东南少，一道相传今古同。\n我辈因文须识本，浴沂好咏舞雩风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20405,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"二月晦游东屯拜少陵像","author":"陈邕","text":"飞飞鸣枭啄金屋，孔雀饮泉牛抵触。\n杜鹃喜免百巢嗔，鹪鹩强息一枝足。\n烛天光焰几许长，日眩东极升朝阳。\n世人谩作诗老看，肩拍吕葛心羲皇。\n玉珂金钥裁通籍，锦水铜梁俄浪迹。\n两河磔裂甲欲洗，四壁呻吟饭无吃。\n萍漂蓬转客夔门，栖迟瀼西复东屯。\n群峰竦壁水萦带，有怪膴膴如周原。\n纵横豺虎深稂莠，熊儿执耒骥子耨。\n除芒落杵未流匙，问有长安消息否。\n峡云巴月困冥搜，去醉洞庭湘浦秋。\n溪山留得金石响，定应骑气时神游。\n扪参历井甘飞辙，端为穿花听鸟设。\n簿书丛里掣舟来，风雨声中与春别。\n仰窥层阁俯平川，想见杜曲桑麻田。\n更起鸣酬傥可待，一弹指顷三千年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20406,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岑公洞","author":"陈邕","text":"武陵种桃人，香山茹芝老。\n世变百战酣，仙境一蹴倒。\n炀虐浮于秦，海宇争飞䎂。\n人间别有天，海上应无岛。\n我行经南浦，奇迹事幽讨。\n出门霜落木，呼渡江空潦。\n莫言不能饮，笑起同醉倒。\n何以侑我觞，泉音玉琴操。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20407,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"八声甘州","author":"陈偕","text":"芰荷风、涤面恰麦秋，应倒著春衣。\n渡晓溪云湿，日流尘脚，露滉蛛丝。\n调翼受风雏燕，弱不解争泥。\n衬琅玕锦院，竹外蔷薇。\n立久阑干凭暖，看行鱼吹沫，波晕平池。\n藓痕斑础石，渐雨熟梅时。\n傍短篱、成团粉蝶，掠野花、相逐□高低。\n忘言处，徽弦乍拂，流水先知。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20408,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"满庭芳 其一 西湖","author":"陈偕","text":"岚影浮春，云容阁雨，澄泓碧展玻璃。\n高低楼观，窗户舞涟漪。\n别有轻盈水面，清讴起、舟叶如飞。\n沙堤上，垂鞭信马，柳重绿交枝。\n渐残红倒影，金波潋滟，弦管催归。\n看飘香陈粉，满路扶携。\n不尽湖边风月，孤山下、猿鸟须知。\n东风里、年年此水，贮尽是和非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20409,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"大涤洞天留题","author":"陈埯留","text":"支径萦纡路似穷，疑非琼馆洞霄宫。\n虽烦绿野诸公领，谁到青山九锁中。\n栝隐又深千嶂月，笋将犹欠一枝筇。\n道人欲识岩栖处，因鹤东来问漫翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20410,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南雁山","author":"陈埴","text":"千峰历罢寄山窗，酒力诗狂总未降。\n月白洞门花落尽，天空华表鹤飞双。\n崖边瀑雪寒侵梦，涧底笙箫冷韵腔。\n且喜懒残煨芋熟，不妨久话共秋缸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20411,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送叶守","author":"陈康伯","text":"海国民皆兴礼义，潢池盗已息干戈。\n农桑四境丰年屡，箫鼓千村叶气多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20412,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题龟峰","author":"陈康伯","text":"形势如龟禀赋奇，昂头曳尾向溪湄。\n石色烝霞红甲润，苔痕湿雨绿毛垂。\n恍如献瑞在官日，犹似呈书出洛时。\n千秋矻立层霄表，寿比乔松可等期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20413,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书弋阳馆","author":"陈康伯","text":"忆昨东京拜相时，武夫前导争驱驰。\n上奉天子一人命，下率百寮罗纲维。\n泰阶赐膳侑金币，上食供进黄门赍。\n夜来胡尘犯边土，手握亿万兵擒虏。\n挥扬杀气横九秋，指挥猛将皆貔虎。\n八荒扫荡沙漠空，旋师奏凯明皇宫。\n英雄富贵皆长事，辞荣解绶归兴浓。\n白石如玉泉如酥，河清海晏乐耕锄。\n雉鸣麦秀花卉敷，亲朋会合情欢娱。\n有子可教孙可训，有书可读田可租。\n常愿年丰五谷登，斯民安堵心则愉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20414,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题闽县西湖","author":"陈康伯","text":"凿开百顷碧融融，颍上钱塘约略同。\n杨柳两堤连绿荫，芰荷十里馥香风。\n波涵翠巘层层出，潮接新河处处通。\n舆诵载涂农事起，从今岁岁作年丰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20415,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"阮郎归","author":"陈康伯","text":"闲来溪上有云飞。\n溪光接翠微。\n江南三月落花时。\n春波去棹迟。\n寻竹路，破林扉。\n苍台旧钓矶。\n欲归回首未成归。\n黄尘满素衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20416,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江左驿舍寄文湖","author":"陈庸","text":"云水苍苍日欲阑，邮亭遥忆旧家山。\n故人两地分南北，几度相思鬓为斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20417,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"凉轩","author":"陈庸","text":"宰予居丰暇，构轩凉愈清。\n尘襟当此释，暑气未尝生。\n植竹助真性，弄琴宜正声。\n披风兹可会，觞咏豁交情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20418,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"露坐","author":"陈得时","text":"露坐当中夜，谁家梦正迷。\n行人在边戍，孤月到深闺。\n天迥斗横北，海寒风自西。\n庭前有高树，分借老乌栖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20419,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晓思","author":"陈得时","text":"南楼捲书坐，极目动清□。\n野色春千里，晴光晓万家。\n人耕烟外草，鸟啄树头花。\n记得夜来梦，清天飞日华。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20420,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水调歌头 寿曹太守","author":"陈惟哲","text":"近畿贤太守，陆地隐神仙。\n功高玉记，名通紫府自长年。\n拂拭壶中光景，游戏人间风月，富贵本青毡。\n十载五分牧，惠泽浸江天。\n把文章，做勋业，德才全。\n龟峰堂上，满城和气入歌筵。\n春在百花庭院，坐拥十眉珠翠，寿酒吸长川。\n来岁称觞处，稳向凤池边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20421,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"光渌亭杏花","author":"陈掞","text":"西郊见说春事浓，杏花香发眠东风。\n主人未解此花意，小槽溜溜杯犹空。\n劝君潋滟蒲萄绿，好看枝头红映肉。\n莫令风雨遣花飞，徒唱人间断肠曲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20422,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"破山寺双头白莲","author":"陈掞","text":"湘南夜水风露清，月明耿耿波益平。\n婵娟有人步罗袜，琼珰玉佩双娉婷。\n可怜玉骨埋藏久，肠断人间无复有。\n岂知化作兰若莲，宿契未忘犹并首。\n想应快意洗尘缘，不向谢池争取妍。\n玻璃盘中净土颊，一心稽首西方仙。\n请君以图献天子，当与嘉禾并周史。\n毋令寂寞堕空山，泣月悲云清夜残。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20423,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题稙庵","author":"陈掞","text":"季鹰雅志本江湖，胡为入洛诚计疏。\n一杯莼羹入归梦，岁晚仅饱松江鲈。\n何如王郎十亩宅，一生江头枕江碧。\n西风落日弄烟波，却笑陶朱计然策。\n我来访君春已深，江花江柳翻绿阴。\n相携三径拾瑶草，为问客来何苦心。\n固知此事君计得，我被微官苦相逼。\n劝君谨勿语弹冠，便恐纷纷北山檄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20424,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"合掌岩","author":"陈桷","text":"合掌仙峰插汉高，下临沧海压波涛。\n看来疑是金仙子，无相光辉礼玉毫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20425,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"广化寺","author":"陈桷","text":"山高不受暑，秋到十分凉。\n望外去程远，闲中度日长。\n寺林投宿鸟，山路自归羊。\n物物各有适，羁愁逐异乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20426,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"陈桷","text":"神仙多是大罗客，我比大罗超一格。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20427,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄菊山","author":"陈梅","text":"老发戴儒冠，黄金不爱官。\n江湖双脚健，天地寸心宽。\n山月晓犹白，松风夏亦寒。\n小诗讯猿鹤，聊以慰平安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20428,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"述怀 其一","author":"陈梅庄","text":"一寸柔肠万叠萦，那堪更值此春情。\n黄鹂知我无情绪，飞过花梢禁不声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20429,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"述怀 其三","author":"陈梅庄","text":"山城忽忽欲昏黄，又了浮生半日忙。\n侍妾不须烧绛蜡，让由明月入回廊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20430,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"述怀 其二","author":"陈梅庄","text":"一片愁心怯杜鹃，懒妆从任鬓云偏。\n怕郎却起阳关意，常掩琵琶第四弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20431,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"淡山岩","author":"陈梅所","text":"天下人知此一岩，霜清杖履雅宜闲。\n闽峰尽有堪怡处，猿鹤多时望客还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20432,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渡江云 寿妇人集曲名","author":"陈梦协","text":"瑞云浓，缥缈弦月当庭，天香满院。\n玉女传言，把真珠帘卷。\n拥鹊桥仙，引江城子，拟醉蓬莱宴。\n吹紫玉箫，唱黄金缕，按拍声声慢。\n昼锦堂前，倾杯为寿，祝快活年，应天长远。\n喜似娘儿，解称人心愿。\n梦兰蕙芳，种宜男草，丹凤吟非晚。\n更步蟾宫，宴琼林日，汉宫春暖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20433,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登泰山 其二","author":"陈梦良","text":"何处鸾笙凤管清，觉来身世在蓬瀛。\n龟蒙凫峄争趋势，恒霍嵩华共仰兄。\n封禅幸无书献纳，洞天尚有路通名。\n自惭游兴非司马，不扣天门空此生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20434,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登泰山 其一","author":"陈梦良","text":"一跻尼父更谁登，扶日扪参紫翠层。\n四海儿孙向罗立，万方稚子走香灯。\n独将浑噩留天地，几为沧桑纪废兴。\n长啸一声空八表，恍疑鹏背坐来曾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20435,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上喻史君重建霞起堂六首 其四","author":"陈梦建","text":"玉泉天上古仙伯，曾吏五云书阁来。\n寄语家人须候我，有时骑鹤过丹台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20436,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上喻史君重建霞起堂六首 其三","author":"陈梦建","text":"诗社神交识乃翁，耳孙凛凛有仙风。\n青云垂上斜飞去，时要题诗遍浙东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20437,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上喻史君重建霞起堂六首 其五","author":"陈梦建","text":"楼观微茫似积苏，一麾得傍化人居。\n可能永日销棋局，且要蒙头读道书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20438,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上喻史君重建霞起堂六首 其一","author":"陈梦建","text":"丈人昔日经行处，草暗苔荒四十春。\n谁倚高寒访陈迹，璇题宝墨一时新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20439,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上喻史君重建霞起堂六首 其二","author":"陈梦建","text":"酒酣步出玉霄峰，此去天关隔几重。\n霞佩颉颃风雨上，清都只在嘿存中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20440,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冯中郎庙","author":"陈淳","text":"为问中郎昔抗忠，力箴颇牧不能庸。\n如今疆埸多尘扰，颇牧还能容不容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20441,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"示儿定孙二绝 其一","author":"陈淳","text":"童蒙发轫最初时，庸圣分岐谨所之。\n凡百小儿嬉戏事，汝皆鄙俚不须为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20442,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"示儿定孙二绝 其二","author":"陈淳","text":"丈夫尚志志高明，勿效卑卑世俗情。\n从上一条平坦路，千贤万圣所通行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20443,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"训儿童八首 其五 人子","author":"陈淳","text":"人子勤于孝，无时志不存。\n夜来安寝息，早起问寒暄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20444,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"训儿童八首 其一 孔子","author":"陈淳","text":"孔子生东鲁，斯文实在兹。\n六经垂训法，万世共宗师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20445,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"训儿童八首 其七 应对","author":"陈淳","text":"应对须恭谨，言言罔不祗。\n父呼唯无诺，长问逊为辞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20446,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"训儿童八首 其二 弟子","author":"陈淳","text":"洙泗三千众，何人得正传。\n省身有曾子，克己独颜渊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20447,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"训儿童八首 其八 进退","author":"陈淳","text":"进退须恭敬，时时勿敢轻。\n先生趋拱立，长者后徐行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20448,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"训儿童八首 其六 洒扫","author":"陈淳","text":"奉水微微洒，恭提帚与箕。\n室堂须净扫，几案亦轻麾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20449,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"训儿童八首 其四 曾子","author":"陈淳","text":"敬谨曾参氏，临深履薄如。\n平生传圣训，要具孝经书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20450,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"训儿童八首 其三 颜子","author":"陈淳","text":"贤哉颜氏子，陋巷独幽居。\n箪食与瓢饮，萧然乐有馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20451,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"存心","author":"陈淳","text":"心藏隐奥最难知，出入无时不可羁。\n须向动时牢把住，莫教失却便支离。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20452,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西征范田遇雪三绝 其一","author":"陈淳","text":"夜宿荒村曰范田，声声频滴屋檐前。\n朝来揭起柴扉看，满目青山白玉巅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20453,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西征范田遇雪三绝 其三","author":"陈淳","text":"历历山坳冻迫人，指头欲堕痹难伸。\n探囊速买三杯后，更觉阳和畅此身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20454,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]