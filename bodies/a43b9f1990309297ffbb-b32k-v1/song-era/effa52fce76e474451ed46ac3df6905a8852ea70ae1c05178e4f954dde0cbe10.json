[{"title":"颂古十一首 其二","author":"释子益","text":"多处添些已是讹，少处减些还是诳。\n几多著眼看机轮，谁知不在机轮上。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6278,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其六十八","author":"释子益","text":"虚空年与寿山同，答处由来在问宗。\n但见皇风成一片，不知何处是疆封。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6279,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其六十二","author":"释子益","text":"六载雪山修，几乎没合杀。\n半夜睹明星，和盲勃睟瞎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6280,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其五十六","author":"释子益","text":"问处分明答处亲，太平天子太平臣。\n等闲喝散千峰雪，此土西天一样春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6281,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其四十二","author":"释子益","text":"法身充塞太虚空，出没何曾有定踪。\n独许波旬知此意，半偷欢喜半搥胸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6282,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其三十五","author":"释子益","text":"十声槌下定纲宗，送去迎来事一同。\n竖百横千有通变，笊篱无柄舀春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6283,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寒山把蕉叶执笔赞","author":"释子益","text":"吟诗吟未就，执笔且搜枯。\n欲写芭蕉上，依前一字无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6284,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"朝阳赞","author":"释子益","text":"者边才补了，又见那边穿。\n不觉日又夜，争教人少年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6285,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢东禅月湖以诸祖偈颂见示","author":"释子益","text":"家贫路富鼻辽天，各立门风辱祖先。\n争似太平无事客，长伸两脚放憨眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6286,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠月蓬相士","author":"释子益","text":"月蓬岩下电，相心不相面。\n剑关不露锋，向甚处相见。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6287,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偶成","author":"释子益","text":"那得工夫过一关，从空放下绝追攀。\n松风不入是非耳，竹径肯通人我山。\n有问对谈惟莫莫，无心袖手只闲闲。\n忽闻枝上灵禽语，似笑山翁痴复顽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6288,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题幽林寺","author":"释子益","text":"幽林卓锡地，香火续深禅。\n但见树迷户，不知头顶天。\n云开青嶂耸，瀑溅雪珠悬。\n一脉来何处，曹溪万丈渊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6289,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"一上人之径山","author":"释子益","text":"一处才通处处通，凌霄突兀对青龙。\n道途不涉最亲句，只在平常日用中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6290,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"小师慧清游山","author":"释子益","text":"行脚不遇人，不如屋里坐。\n那事本现成，何须外边讨。\n东行西行，蓦忽筑著脚指头。\n定笑玄沙，错认橘皮唤作火。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6291,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"出山相赞","author":"释子益","text":"捏双拳，衣露肘。\n谓悟明星，有甚分晓。\n本为修行利济人，谁知变作不唧?。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6292,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"布袋赞","author":"释子益","text":"布袋横拖，肚皮捺下。\n行货有些，没人酬价。\n拊背觅钱真奉化。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6293,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"礼开山伏虎祖师塔","author":"释子益","text":"羊肠知几折，行尽水村村。\n扪壁穿云栈，攀萝过石门。\n寻踪知虎在，绕塔见师存。\n他日重来地，松枝拂藓痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6294,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"传上人之径山","author":"释子益","text":"佛祖不传希世宝，千人万人觑不破。\n五峰相见索看时，切忌倾出一栲栳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6295,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自赞庆成长老请","author":"释子益","text":"怡山顶不露，上有通天窍。\n事事总不知，虚明肯自照。\n个样䖃苴川僧，如何描邈得就。\n庆成讦露人前，早是外扬家丑。\n不用别举话头，我手何似佛手。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6296,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观音赞","author":"释子益","text":"杨柳枝头，琉璃瓶里。\n一滴浑无，千波竞起。\n步步金莲衬足生，何曾踏著自家底。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6297,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"达磨携履赞","author":"释子益","text":"赤双脚，携只履。\n自东自西，谁不识你。\n最难掩是当门齿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6298,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"佛鉴和尚赞","author":"释子益","text":"雨过五峰，云横玉几。\n日面月面，只这便是。\n道是佛鉴，舌拄梵天。\n道非佛鉴，眉毛拖地。\n更言两对君王，三奉诏旨。\n看来元是阴平界上雍师波，谁不识你。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6299,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十一首 其十一","author":"释子益","text":"撼树良久，好手手中呈好手。\n得用得体，一不成兮二不是。\n三十拄杖放渠侬，大似贼过后张弓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6300,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十一首 其十","author":"释子益","text":"地藏栽田博饭，大似饥过心荒。\n听它三三两两，佛法浩浩商量。\n杓柄那知有短长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6301,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十一首 其八","author":"释子益","text":"抛砖引玉老香严，打著南边动北边。\n听事不真钟作瓮，至今千古错流传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6302,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十一首 其六","author":"释子益","text":"尽道赵州勘婆子，不知婆子勘赵州。\n有意气时添意气，不风流处也风流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6303,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十一首 其三","author":"释子益","text":"狗子佛性无，铁船水上浮。\n顺风帆未挂，已过洞庭湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6304,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十一首 其一","author":"释子益","text":"心手相忘，二俱得妙，箭箭中的。\n未脱窠臼脱窠臼，好手手中呈好手。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6305,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其七十","author":"释子益","text":"直下是，直下是。\n赚杀人，疑杀你。\n上是天，下是地。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6306,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其七十六","author":"释子益","text":"腊月二十五，一曲重新举。\n唱寡兮和稀，韵高兮调古。\n堪悲堪笑老东山，谩说豆子山前打瓦鼓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6307,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其七十五","author":"释子益","text":"有一则语，久欲拈出。\n未动舌头，遍界狼藉。\n且作么生收拾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6308,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其七十四","author":"释子益","text":"此段光明，辉天鉴地。\n灵山错话，曹溪错指。\n雾暗云屯兮历历常明，地陷天崩兮也只如是。\n赚杀你。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6309,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其七十三","author":"释子益","text":"识得一，万事毕。\n佛法飏在它方，世法拈靠一壁。\n有问奇特因缘，立秋已过五日。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6310,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其七十二","author":"释子益","text":"二月十五，瞿昙灭度。\n文殊顿足普贤悲，外道拊掌波旬舞。\n甜瓜彻蒂甜，苦瓠连根苦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6311,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其六十九","author":"释子益","text":"世尊不说说，迦叶不闻闻。\n两个无孔铁锤，打就一合乾坤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6312,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其六十七","author":"释子益","text":"定本无门，从何而入。\n坐断两头，中亦不立。\n没可把，绝承当，风来一阵芰荷香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6313,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其六十六","author":"释子益","text":"瞿昙色相紫金容，雨后青山插半空。\n觌面当机如不荐，桃花依旧笑春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6314,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其六十五","author":"释子益","text":"有拄杖与拄杖，击木无声。\n无拄杖夺拄杖，敲空作响。\n还见芭蕉和尚么，莫妄想。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6315,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其六十四","author":"释子益","text":"春已过半，百花竞芳。\n有些佛法，如何商量。\n千言万语无人会，又逐流莺过短墙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6316,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其六十","author":"释子益","text":"菊花黄，茱萸香。\n时节既至，其理自彰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6317,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其五十八","author":"释子益","text":"九十长期，三分过二。\n觉海浪平，铁船无底。\n寒山子水牯牛作么生，切不得道大家在这里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6318,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其五十七","author":"释子益","text":"现成公案，了无迁变。\n入得门来，一见便见。\n左顾则狮子嚬呻，右盼则象王回转。\n灵山一会俨然存，捏聚春风成一片。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6319,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其五十五","author":"释子益","text":"拄杖生根劫外春，斩新拈出示诸人。\n擘开华岳千峰秀，放出黄河一派清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6320,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其五十四","author":"释子益","text":"至玄至妙，至奥至微。\n不可以识识，不可以智知。\n与么会得，咈㖃啒㖀。\n不与么会，凤林吒之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6321,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其五十三","author":"释子益","text":"六出花飞，无地卓锥。\n填沟塞壑，绝毫绝厘。\n嗄，忽惊捲尽青山去，又喜重携春色归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6322,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其五十二","author":"释子益","text":"未入山时，气冲牛斗。\n出得山来，衣穿露肘。\n更言午夜见明星，不知面皮厚多少。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6323,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其五十一","author":"释子益","text":"六阴既穷，群魔自殄。\n一阳来复，吾道大亨。\n拄杖竖，十方世界一时竖。\n拄杖横，十方世界一时横。\n兵随印转，将逐符行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6324,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其五十","author":"释子益","text":"亲从宝山来，收得宝山宝。\n一片玉无瑕，千峰云脱帽。\n九莲峰畔无处藏，兜率宫中卒难讨。\n归来打鼓普请看，盘走珠兮珠走盘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6325,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其四十九","author":"释子益","text":"常光现前，壁立万仞。\n者里一划划断，别有一条捷径。\n明眼人，因甚落井。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6326,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其四十八","author":"释子益","text":"东司头，粪坑上。\n臭气薰天，如何近傍。\n一屙便了底，痛与一锥。\n的的卓卓底，三十拄杖。\n有功者赏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6327,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其四十七","author":"释子益","text":"秋江清，秋月白。\n登高双眼空，独步乾坤窄。\n只手未曾举，黄菊已盈握。\n好彩从来奔龊家，随分一盏茱萸茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6328,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其四十六","author":"释子益","text":"十五日已前明似镜，十五日已后曲如镰。\n正当十五日，无人知此意，令我忆南泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6329,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其四十五","author":"释子益","text":"觉性海中，圆无不融。\n闻时富贵，见后贫穷。\n穷则变，变则通，草鞋狞似虎，拄杖活如龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6330,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其四十四","author":"释子益","text":"进以礼，退以礼。\n录得语一篇，不在纸衣里。\n所以智藏被马师涂糊，克宾遭兴化钝置。\n千古之下，挂人唇齿。\n恩大难酬，痛入骨髓。\n检点将来，玄沙道底。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6331,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其四十三","author":"释子益","text":"时节既至，其理自彰。\n井井秧浮绿，村村麦弄黄。\n半窗山月白，一枕竹风凉，笑倒山前邓八郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6332,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其四十一","author":"释子益","text":"古佛心，即于今。\n春风浩浩，春雨霖霖，高山流水少知音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6333,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其四十","author":"释子益","text":"是句亦刬，非句亦刬。\n德山焚疏钞，临济烧禅板。\n堪悲堪笑，一对无孔铁锤，驴年梦见正法眼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6334,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其三十九","author":"释子益","text":"一夏九十日，半月已过了。\n有问蜡人冰，鼻孔仍依旧。\n我手何似佛手。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6335,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其三十八","author":"释子益","text":"心如虚空不可量，圣君寿量亦如是。\n将如是法报皇恩，天上人间更无比。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6336,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其三十七","author":"释子益","text":"忆昔玉几时，分赃不合火。\n今日蓦相逢，依然众恁么。\n不恁么，睦州担板，云门脚跛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6337,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其三十六","author":"释子益","text":"般若锋，金刚焰。\n觌面当机，突出难辨。\n春风一阵来，落花飞片片。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6338,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其三十四","author":"释子益","text":"冬前冬后，沙飞石走。\n时节到来，不容袖手。\n兴化虽无驱风走电之谋，也要应个时候，一九二九。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6339,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其三十三","author":"释子益","text":"得路塞路，过桥断桥。\n不拘两岸，不滞中流。\n直饶你会得步行骑水牛，我更问你，空手因甚把锄头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6340,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其三十二","author":"释子益","text":"一日复一日，一秋复一秋。\n从头屈指数，屈指又从头，乌飞兔走几时休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6341,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其三十一","author":"释子益","text":"日可冷，月可热，众魔不能坏真说。\n且作么生是真说，屋头泉溜响无休，砌下寒蛩声更切。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6342,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其三十","author":"释子益","text":"一见便见，天回地转。\n宗通说通，风虎云龙。\n只如百丈被马祖一喝，因甚三日耳聋。\n闽蜀同风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6343,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其二十九","author":"释子益","text":"酷暑炎炎何处避，不在镬汤炉炭里。\n北窗一枕黑甜馀，细听松风杂流水。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6344,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其二十八","author":"释子益","text":"玄沙不出岭，拄杖生根休用剪。\n保寿不渡河，钵盂无柄不须安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6345,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其二十七","author":"释子益","text":"正法轮，轻拨转。\n日出中天，云开岳面，如优昙花时一现。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6346,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其二十六","author":"释子益","text":"作无所作，为无所为。\n灰头土面，带水拖泥。\n恁么要见兴化，快须照顾两茎眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6347,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其二十五","author":"释子益","text":"天寒地冷，昼短夜长。\n死灰拨尽，没可商量。\n昨夜三更月到窗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6348,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其二十四","author":"释子益","text":"见见之时，羯谛羯谛。\n见非是见，波罗羯谛。\n见犹离见，波罗僧羯谛。\n见莫能及，菩提萨婆诃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6349,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其二十三","author":"释子益","text":"格外提持，斗转星移。\n智藏不会，海兄不知。\n叵耐睦州担板汉，教坏临济小厮儿。\n此意明明说向谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6350,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其二十二","author":"释子益","text":"怪得深夜寒，破晓清霜重。\n双涧水无声，千峰云欲冻。\n这里冷湫湫，那边热鬨鬨。\n不知那个得便宜，惭愧杨岐老冻脓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6351,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其二十一","author":"释子益","text":"秋未霜，菊正芳。\n千朵万朵香吐蕊，三枝两枝金样黄。\n不作世谛流布，亦非佛法商量。\n九月九日是重阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6352,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]