[{"title":"伯顺以歙砚饷我因用前韵谢之并简亨老以助致师之请","author":"赵鼎臣","text":"挟山超海吾岂能，章服裹之麋鹿惊。\n平生忍饥耕破砚，字画仅能通姓名。\n自传同舍有和璧，未敢攫取先以声。\n耿侯闻之顾且笑，弃掷不啻鸿毛轻。\n我穷正坐毛颖误，恋著翰墨天所刑。\n少不如人今老矣，笔阵欲合阴借兵。\n何郎持重欲困我，坚壁不闻刁斗鸣。\n明朝一阵气已了，大将旗鼓居吾营。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60376,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵子磐悼畜马死","author":"赵鼎臣","text":"吾闻古者八骏图，白义騄耳皆龙驹。\n独嘶长风志万里，意态自与凡马殊。\n常时陆陆未足道，一日致远君应须。\n朝秣幽燕暮吴粤，顾视款段犹泥涂。\n王良不生造父死，校计岂复分毫铢。\n忆君初应将军召，随身惟以一马俱。\n官曹卑微骑从少，岂有负弩供前驱。\n忽然据鞍欲有适，老兵一诺费百呼。\n空槽无刍但与饮，坐令槁死城南隅。\n天嫌此马非俊物，如君岂合冉冉趋。\n才高不肯露头角，有计甘学水中凫。\n故令驽蹇自毙踣，欲君感慨求夷途。\n当捐千金市绝足，勿仗短策驱庸奴。\n人生但可印如斗，世上岂患骓无乌。\n马骨朽时君贵矣，颇应忆著敝帷无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60377,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"驿中燕北使戏成","author":"赵鼎臣","text":"夜长更长睡复觉，欲雪不雪寒且风。\n人如胡越不觉异，酒味圣贤聊复中。\n客来不语虽礼简，宾去献弓而爱同。\n书生多口慎勿出，累圣消兵在此中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60378,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寒日前二日直宿省中","author":"赵鼎臣","text":"古屋寒无禁，幽眠梦不成。\n鼠留窥砚迹，风度响窗声。\n人语天将晓，春阴日未明。\n起来搔短发，端自有馀清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60379,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨中直宿","author":"赵鼎臣","text":"白日文书满，清秋寓直频。\n雨愁官路滑，风喜夜凉新。\n头里千茎雪，胸中万斛尘。\n不知穷列宿，若个是吾身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60380,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"伏日还府题王村铺","author":"赵鼎臣","text":"火候犹骑伏，金行已立秋。\n凉虽来缓缓，热好罢休休。\n岁月随鞭箠，尘埃老置邮。\n年年禾黍熟，吾道得无忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60381,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"六月十二日被檄诣边道中即事","author":"赵鼎臣","text":"驱马日尚早，解鞍天向晨。\n风虽排酷吏，雨复滞行人。\n保障连营远，陂塘发兴新。\n荷花娇欲语，愁绝故伤神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60382,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晋阳道中","author":"赵鼎臣","text":"路入羊肠里，师行鼠穴中。\n山田如越俗，板屋类秦风。\n形势无加损，污隆有异同。\n百年开寿域，兴国太平功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60383,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"岚谷道中","author":"赵鼎臣","text":"汗漫穿岩谷，悠悠不计程。\n林鸠呼妇宿，驿马带驹行。\n叶落知霜早，禾登喜岁成。\n潺湲溪水急，未暇濯吾缨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60384,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过武强渡","author":"赵鼎臣","text":"千里跨羸马，一舟浮大河。\n他乡故旧少，长路往来多。\n心欲求田耳，身如作吏何。\n荒凉三径晚，归计日蹉跎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60385,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过铜雀台吊魏武","author":"赵鼎臣","text":"慷慨勤王始，艰难创业初。\n英辞传乐府，妙略布新书。\n逐鹿功虽在，藏舟计已疏。\n一朝空穗帐，爱子竟何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60386,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"八月十一日山中早发薄寒凝冰马上重裘尚未能以禦寒也时将中秋感旧而作","author":"赵鼎臣","text":"萧索岚州路，天寒已著人。\n可怜挟纩日，不待饮冰辰。\n凉夜更筹永，清秋月色新。\n去无河朔饮，絺绤故相亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60387,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"任邱道中值雪赠权邑宰曹弋取道曹河间同僚也 其一","author":"赵鼎臣","text":"宿雾寒犹重，浓阴晓未分。\n山川连野暗，鸡犬隔村闻。\n浩荡天将雪，朦胧酒半醺。\n向来临易水，长啸欲移文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60388,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"任邱道中值雪赠权邑宰曹弋取道曹河间同僚也 其二","author":"赵鼎臣","text":"俎豆嗟何有，櫜鞬病未能。\n府中嘲短簿，门下养聋丞。\n问路朝驰传，逢人夕饮冰。\n全家今饱满，此禄惧难胜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60389,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"骑立山祷雨诗二首 其一","author":"赵鼎臣","text":"绝壁临无地，飞泉落半天。\n潭中看止水，涧下响惊川。\n江汉威南及，嵩邙势北连。\n寻山应最易，骑立众峰前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60390,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"骑立山祷雨诗二首 其二","author":"赵鼎臣","text":"乞雨甘重茧，瞻天剧戴盆。\n无才修政事，有腼傍祠门。\n马足盘山肋，泉声漱石根。\n云霓如响答，蘋藻愿星奔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60391,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢诸公惠喜雨之什","author":"赵鼎臣","text":"薄宦惭亡补，高秋恨不归。\n况逢仍岁旱，犹著故时衣。\n祷雨精诚竭，忧民寝食非。\n自惟存畎亩，何以辱珠玑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60392,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"喜雨","author":"赵鼎臣","text":"暂举催科手，来吟喜雨诗。\n不徒人物惠，且免吏民嗤。\n三日霖随应，千箱乐在兹。\n为言农事好，卒岁保嘻嘻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60393,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"四月二十七日雨后诣府学道过辟雍不暇谒权朝美归以诗寄之","author":"赵鼎臣","text":"三日霖雨足，四郊牟麦稠。\n日长浑似夏，风冷却疑秋。\n璧水劳心曲，车轮阻道周。\n桃花如烂熳，他日定来游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60394,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和钦止桐庐中道见寄二首 其一","author":"赵鼎臣","text":"邂逅来随牒，因循未拂衣。\n江乡知旧少，京国信音稀。\n老废书千卷，愁宽带十围。\n故人鸿鹄举，燕雀自卑飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60395,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和钦止桐庐中道见寄二首 其二","author":"赵鼎臣","text":"昔忝同僚分，深惭国士知。\n发衰将得白，衣素已成缁。\n富贵君馀事，功名彼一时。\n腊梅如可寄，为折最南枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60396,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵翟经国见寄","author":"赵鼎臣","text":"故国几乔木，长歧数短亭。\n日趋天阙绛，坐失鬓丝青。\n旧著归田赋，新传酿酒经。\n卜邻知有日，烂醉不须醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60397,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"喜闻方时敏来","author":"赵鼎臣","text":"浙江为客久，汴岸舣舟新。\n未暇趋东阁，先来觅故人。\n棋应缘老退，诗不为家贫。\n土物惟襄锦，堪为照乘珍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60398,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄山阴隐者","author":"赵鼎臣","text":"闻道山阴老，春来乐有馀。\n饥餐一盘饭，闲读两行书。\n竹里亲沽酒，江边自买鱼。\n何曾入城市，人事转生疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60399,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"翟经国筑室于乡里人誇传以为盛其西吾苇溪也以诗戏之","author":"赵鼎臣","text":"故人高隐处，近在郭门西。\n数仞檐楹敞，满城门户低。\n便当容驷马，何止卜幽栖。\n更请开三径，时来过苇溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60400,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十二月二十一日雪取道置酒于清白堂林正仲有诗次韵","author":"赵鼎臣","text":"花飞何事急，纨细不胜裁。\n睡起明书幌，妆成湿镜台。\n多情调玉烛，作意耻金罍。\n授简何容易，相如欲到来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60401,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"泛舟席上次韵祖武闻笛","author":"赵鼎臣","text":"虎槛留春色，龙吟入酒杯。\n响从天外去，妙向曲中来。\n但可金樽满，何劳暮鼓催。\n独怜羁旅客，愁绝正徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60402,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"嘲咏诗","author":"赵鼎臣","text":"尧俗虽勤俭，并儿可叹嗟。\n井牵长颈盎，山驾破辕车。\n八月霜如霰，三春雹似瓜。\n头蓬非愿女，膏沐欠油麻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60403,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"披风","author":"赵鼎臣","text":"脩竹不受暑，暗惊疑故人。\n暂来聊解愠，径去不惊尘。\n汗湿衣裳雨，书翻几案鳞。\n快哉那独敢，赠尔耦耕民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60404,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"昼眠","author":"赵鼎臣","text":"枕瓷歌娅姹，屏纸涨涟漪。\n左角蜗休斗，南柯蚁正为。\n静喧闲处失，忧喜梦中移。\n吐握真贤相，相邀不计时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60405,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"波流一首","author":"赵鼎臣","text":"波流非自性，绿竹盖其姿。\n坐得濯缨理，还思垂钓时。\n几人能乐水，此处可无诗。\n寄语尘埃客，勤来一洒之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60406,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"买花诗","author":"赵鼎臣","text":"老觉欢娱少，愁惊岁月频。\n能消几日醉，又过一年春。\n陌上枝枝好，钗头种种新。\n买归持博笑，贡自可怜人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60407,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"竹","author":"赵鼎臣","text":"雨洗修篁净，风摇翠影森。\n苍官投分久，丹穴寄怀深。\n窈窕蕙兰质，轻狂桃李心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60408,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"无题","author":"赵鼎臣","text":"韵胜应难画，肌香不受熏。\n拂眉烟度柳，梳鬓月侵云。\n歌罢犹依扇，闲来懒系裙。\n最怜能赋客，浑似卓文君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60409,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"故大司成葛亚卿挽诗 其一","author":"赵鼎臣","text":"行义知名早，云霄得路迟。\n喜闻儒者用，忽叹哲人萎。\n故事留青锁，平生有素丝。\n马鸣犹踯躅，似记入朝时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60410,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"故大司成葛亚卿挽诗 其二","author":"赵鼎臣","text":"璧水除官日，漳滨卧疾年。\n贺书犹未报，吊客已相先。\n梦幻真空矣，衣冠尚俨然。\n平生诗满箧，当自有人传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60411,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽李待制浦五首 其一","author":"赵鼎臣","text":"乡党推耆旧，朝廷重老成。\n闺门无政事，孝悌有平生。\n万卷常充宇，千金不满籯。\n种成兰玉后，华发看升平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60412,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽李待制浦五首 其二","author":"赵鼎臣","text":"晚持安世橐，早挂隐居冠。\n子贵年方壮，家严色更难。\n古今成俯仰，歌哭异悲欢。\n泪滴新阡上，风吹不肯乾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60413,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽李待制浦五首 其三","author":"赵鼎臣","text":"就养今西府，趋庭国柄臣。\n上思耆艾久，诏问起居频。\n赠典河图贵，佳城马鬣新。\n丹青虽可画，那复见斯人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60414,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽李待制浦五首 其四","author":"赵鼎臣","text":"人物推河内，英灵禀太行。\n先生虽隐晦，嗣子遂腾骧。\n尧舜亲延接，夔龙日赞襄。\n于门高未了，不惜更轩昂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60415,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽李待制浦五首 其五","author":"赵鼎臣","text":"往昔陪尊俎，从容接话言。\n骨虽如鹤瘦，语尚作春温。\n一梦人琴失，流年日月奔。\n空馀华屋处，愁绝向谁论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60416,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽傅奉议三首 其一","author":"赵鼎臣","text":"行义推乡里，才华动搢绅。\n六经常自醉，一室故安贫。\n未觉蒲轮晚，俄悲薤露新。\n他年儒学传，莫谓史无人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60417,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽傅奉议三首 其二","author":"赵鼎臣","text":"往日调商鼎，当年筑汉坛。\n从容作霖雨，谈笑斩楼兰。\n每恐风流尽，空馀琬琰刊。\n承家今已矣，清泪一汍澜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60418,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽傅奉议三首 其三","author":"赵鼎臣","text":"为儒嗟不达，射策竟知名。\n爵命加黄壤，诗书到后生。\n高年鸠杖贵，故国锦衣荣。\n他日兰亭会，何由见老成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60419,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽故致政大夫诗 其一","author":"赵鼎臣","text":"乍捧毛生檄，初登贾傅年。\n低回成鹤发，勉强用蒲鞭。\n遗爱西州说，清风古国传。\n欲知阴德处，廷尉有青毡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60420,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽故致政大夫诗 其二","author":"赵鼎臣","text":"系忝宗盟重，交推父党尊。\n凄凉思往日，邂逅识朱轓。\n华屋耆年逝，衡门稚子存。\n大岯山下路，愁句向谁论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60421,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"彭乐道挽诗三首 其一","author":"赵鼎臣","text":"绛帐名虽早，青衫位不登。\n对囚常涕泣，奏当极哀矜。\n养气劳存想，看书废寝兴。\n短檠留案上，不复夜挑灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60422,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"彭乐道挽诗三首 其二","author":"赵鼎臣","text":"法吏真鸡割，儒衣叹陆沉。\n官曹曾接武，谈麈独倾心。\n笑我趋时懒，知渠味道深。\n微言今已矣，慷慨独沾襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60423,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"彭乐道挽诗三首 其三","author":"赵鼎臣","text":"身老羞干禄，家贫喜著书。\n妙虽穷比兴，粗亦到虫鱼。\n潘令官何拙，虞卿意不疏。\n传诗今有子，应不废菑畬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60424,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"刘孝叔挽诗","author":"赵鼎臣","text":"登科方欲冠，谢病未当传。\n欢喜荣亲日，康强任子年。\n入川将老矣，返鲁遂终焉。\n他日南城路，回车一怆然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60425,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"唐康功挽诗二首 其一","author":"赵鼎臣","text":"命也人难料，天乎子可怜。\n愁看一片玉，埋向九重泉。\n已觉荆枝悴，空馀綵服鲜。\n老亲今八十，行路亦悽然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60426,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"唐康功挽诗二首 其二","author":"赵鼎臣","text":"意气闻他日，声名盖此邦。\n胆令奸吏破，心使壮夫降。\n顿失歆龙一，仍存贾虎双。\n风流嗟已矣，洒泪向秋江。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60427,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"故太原郡太夫人李氏挽歌诗二首 其一","author":"赵鼎臣","text":"德配平原盛，家传相国亲。\n桂抽三笋茂，玉种两株成。\n化剑中秋冷，藏舟半夜惊。\n凯风从此去，忍听自南声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60428,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"故太原郡太夫人李氏挽歌诗二首 其二","author":"赵鼎臣","text":"大郡开汤沐，高堂问凊温。\n腰金仍及婿，持橐更连孙。\n养极千钟富，身兼五福尊。\n从今隽京兆，谁为赏平反。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60429,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"故安定郡太夫人郭氏挽诗二首 其一","author":"赵鼎臣","text":"象服承恩日，金笺告第初。\n御前颁诏旨，天上写除书。\n流水三春逝，黄粱一梦虚。\n七弦虽自足，亡已复何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60430,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"故安定郡太夫人郭氏挽诗二首 其二","author":"赵鼎臣","text":"卜葬开新兆，从姑返旧茔。\n二卿衔恤意，八座悼亡情。\n蘋藻全抛却，松楸已种成。\n鱼轩相逐去，非复是平生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60431,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜直宿有怀","author":"赵鼎臣","text":"坐爱王孙不嗣音，东家芳草怨何深。\n柳芽得雨皆青茁，花叶随风故陆沉。\n未可便成春去恨，犹堪自强老来心。\n直须淡墨题名了，一醉相期到上林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60432,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"二月八日以藉田职事雪中至郊外归过美之题于屋壁","author":"赵鼎臣","text":"簿领劳人不少休，暂因王事得抽头。\n不辞出郭辛勤去，聊作寻春烂漫游。\n酒兴欲狂无客唤，雪花方急被风收。\n銮舆不日临千亩，郁郁天田瑞气浮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60433,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"社日过美之兄","author":"赵鼎臣","text":"鸣鸠唤妇喜新晴，旧燕寻巢乍入城。\n雷送雨声逢甲子，寒留春色到清明。\n赏心未向桃蹊发，饱意先从麦陇生。\n觅句尽于南亩得，粗官真自少风情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60434,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寒食前一日率赵伯山李汉老杨时可秦夷行刘仲忱游西池泛舟置酒分韵赋诗以每日江头尽醉归为韵余得江字因即赋所见","author":"赵鼎臣","text":"老欲争春未肯降，强陪诸彦倒空缸。\n上林春景宜寒食，水殿楼台胜曲江。\n花里人家酤酒斗，苇间钓艇买鱼双。\n眼穿不见春风面，翠袖依微半隐窗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60435,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寒食道中病目","author":"赵鼎臣","text":"今年已作暗寒食，此日正如盲老翁。\n病眼昏昏迷白黑，幻花隐隐出青红。\n人歌人哭千家里，春雨春晴一梦中。\n会放目光牛背上，转头何事不成空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60436,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"暮春东阳道中寄乡里弟兄","author":"赵鼎臣","text":"天末题诗望故乡，碧云烟树两茫茫。\n青山九折屡回首，杜宇一声还断肠。\n别后已成千万恨，书来不寄两三行。\n江南春尽频相忆，为有杨梅欲共尝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60437,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"仲秋席上呈张几仲","author":"赵鼎臣","text":"父老欢呼夹道周，将军喜色在眉头。\n临边已见三开府，玩月何妨七倚楼。\n盛事珠玑交履舄，丰年酒肉到锄耰。\n请公径作通宵饮，今夜何须秉烛游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60438,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九日张师席上次韵志康","author":"赵鼎臣","text":"重阳何处可衔杯，瀛海新成百尺台。\n白雁迎霜前日到，黄花冒雨一时开。\n篱边岁岁民同乐，塞外年年上倚才。\n况有登高能赋客，孙郎声价擅天台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60439,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵张衡父冬夕书事","author":"赵鼎臣","text":"横笛休吹且当挝，幽人梦短不禁茶。\n风琴不鼓自成曲，雪蕊无香犹是花。\n瑚琏少时轻子贡，鹪鹩此日慕张华。\n劳生正是南飞雁，秋去春来讵有涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60440,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]