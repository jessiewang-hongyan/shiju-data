[{"title":"咏史二十二首 其五 周武","author":"赵戣","text":"大邑周新造，曾孙武始王。\n伯夷方马谏，尚父已鹰扬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29804,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"咏史二十二首 其六 秦始皇","author":"赵戣","text":"万世家为国，长城山作围。\n试凭骊岫望，秦鹿几年肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29805,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"咏史二十二首 其七 汉高祖","author":"赵戣","text":"真主乘昌运，假王恢隽功。\n如何亡赖子，失笑未央宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29806,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"咏史二十二首 其八 汉光武","author":"赵戣","text":"意豁高皇似，雄才大敌摧。\n万方瞻日角，列宿粲云台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29807,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"咏史二十二首 其九 魏文帝","author":"赵戣","text":"横槊真名将，燃萁亦忍人。\n大君时有命，雅意俗还淳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29808,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"咏史二十二首 其十 晋武帝","author":"赵戣","text":"犬噬忧方重，羊车意转深。\n可怜司马国，又属问蟆人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29809,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"咏史二十二首 其十一 晋元帝","author":"赵戣","text":"马浮虽是谶，牛继亦殊闻。\n昔者车书共，天乎南北分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29810,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"咏史二十二首 其十二 宋武帝","author":"赵戣","text":"已拓三秦地，宁无几月留。\n登城聊北望，老泪不胜流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29811,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"咏史二十二首 其十三 齐高祖","author":"赵戣","text":"戡难功何补，欺孤计已深。\n尽饶摧导玉，那解贱黄金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29812,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"咏史二十二首 其十四 梁武帝","author":"赵戣","text":"玉陛尊梁帝，金园号群公。\n闻经同泰寺，索蜜净居宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29813,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"咏史二十二首 其十五 陈武帝","author":"赵戣","text":"清净方贻笑，庄严更舍身。\n基图虽肇始，识趣只庸人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29814,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"咏史二十二首 其十六 隋文帝","author":"赵戣","text":"猛上临光殿，生擒归命侯。\n师心无学术，与子失贻谋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29815,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"咏史二十二首 其十七 唐高祖","author":"赵戣","text":"唐室恢新造，秦王有大功。\n一人居北极，太子在东宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29816,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"咏史二十二首 其十八 后梁太祖","author":"赵戣","text":"未必黄明在，终令丑口亡。\n难教疏网漏，不直败毡藏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29817,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"咏史二十二首 其十九 后唐庄宗","author":"赵戣","text":"刺心真有志，批颊更何为。\n试问唐新主，何如亚子时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29818,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"咏史二十二首 其二十 后晋高祖","author":"赵戣","text":"尊以父皇帝，赂之十六州。\n终无啖饭所，谁不石郎羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29819,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"咏史二十二首 其二十一 后汉高祖","author":"赵戣","text":"不假契丹力，踢翻麦饭盂。\n试看龙衮畔，还有雀儿无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29820,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"咏史二十二首 其二十二 后周太祖","author":"赵戣","text":"坤舆聊底定，鼎祚又更新。\n五代无真主，世宗差可人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29821,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和人渊明采菊图","author":"赵戣","text":"渊明为米腰慵折，送酒人来却强颜。\n今日东篱重采菊，只应醒眼对南山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29822,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"锦鶒夜逸","author":"赵戣","text":"草径郁纡溪隔村，谁抽关鐍逋孤鸳。\n林樊搜纠崖厂邃，岸曲括责菰茭根。\n初拟布罟鼠盗夜，又恐缺月狐乘昏。\n死壳枯梗秘踪迹，老圉劝我增垣藩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29823,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"胡苇航寄古剑","author":"盛世忠","text":"有人尺锦长安来，远寄宝匣手自开。\n红云紫气灿虚室，铗中青蛇鳞生苔。\n诚携掌握一挥动，瞬息天地兴风雷。\n少年志气老益壮，惟愿圣诏下九垓。\n厩中我有汗血马，与汝直北清氛埃。\n丈夫当为国雪耻，笑指经生真不才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29824,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"柴门","author":"盛世忠","text":"石砌苔初合，柴门手自开。\n日催花影转，风递竹声来。\n蟹眼翻茶鼎，鹅儿滟酒杯。\n不须忧岁计，魁芋已新栽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29825,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"刘常簿席上","author":"盛世忠","text":"近授长生券，从天下绮筵。\n潞公专洛日，吕望佐姬年。\n坐语风生舌，梳头雪满肩。\n上思耆旧用，飞诏到林泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29826,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"观棋","author":"盛世忠","text":"争先刘与项，得势楚侵秦。\n本是知心友，翻成敌国人。\n运筹争劫杀，败局在逡巡。\n袖手旁观者，机深亦损神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29827,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送吕东山之清漳","author":"盛世忠","text":"君是纯阳派，神清性亦真。\n有诗聊遣兴，无术可医贫。\n富贵皆尤物，江湖易老人。\n置山钱足矣，客路莫因循。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29828,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄藏叟僧善珍","author":"盛世忠","text":"访友南山路，桥横古木阴。\n砌苔无俗迹，庭柏是禅心。\n旧衲连云补，新诗带月吟。\n同袍严戒行，别是一丛林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29829,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"生涯诗","author":"盛世忠","text":"壮岁欲飞腾，生涯亦可矜。\n一千馀日战，三十九年僧。\n砚枕秋风梦，书灯夜雨澄。\n儒生贵知命，饮水曲吾肱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29830,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"简贾户部","author":"盛世忠","text":"十五年前别，相逢各老成。\n旧游如一梦，忽见似重生。\n剧饮无人敌，高谈坐客惊。\n诸郎尤可喜，事业短灯檠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29831,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"病起书院偶成","author":"盛世忠","text":"蓄水滋兰畹，开窗近竹林。\n败糊黄蚁鬨，断简老虫侵。\n酒尚欺人病，诗能对客吟。\n晨昏一饱足，此外不关心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29832,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秦竹溪校书清漳未回","author":"盛世忠","text":"茅斋雅称竹方床，风过疏篱有暗香。\n剧饮一冬成酒病，得闲终日为诗忙。\n新移橘本便霜信，贪看梅花倚夕阳。\n相望故人三百里，十宵九梦到清漳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29833,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"今是行呈刘以道","author":"盛世忠","text":"少年湖海误加鞭，久戍归欤暂息肩。\n时有故山来梦里，更无愁绪到吟边。\n晨餐全仰数畦菜，岁计尤逋二顷田。\n闲倚瘦筇长啸处，此身疑是结绳前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29834,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"塞上闻角","author":"盛世忠","text":"刁斗城头夜月寒，一声呜咽到江干。\n梅花吹落浑闲事，白首征人泪暗弹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29835,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"倦妆图","author":"盛世忠","text":"睡觉春山懒更添，起来馀恨锁眉尖。\n料应春事关心曲，怕见杨花不捲帘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29836,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"懒读书","author":"盛世忠","text":"不弄丝桐不作诗，槃池叠石学儿嬉。\n少年读易都忘却，身似羲皇未画时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29837,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"王昭君","author":"盛世忠","text":"汉使南归绝信音，毡庭青草始知春。\n蛾眉却解安邦国，羞杀麒麟阁上人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29838,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次屏翁韵","author":"戴烨","text":"几番樽酒遇书棂，谈笑清风起座屏。\n一世猖狂浑似醉，此心明白固长醒。\n英雄自昔难虚老，钟鼎他年要刻铭。\n若见旁人问消息，为言桂子待秋馨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29839,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"献阙廷","author":"郑采","text":"韩阳风景世间无，堪与王维作画图。\n四顾罗山朝虎井，一条带小绕龟湖。\n形如丹凤飞衔印，势似苍龙卧吐珠。\n此处不堪为县治，更于何处拜皇都。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29840,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"云岩","author":"金文刚","text":"丹崖何突兀，与客共跻攀。\n一啸九天润，断云千古闲。\n杖行龙虎背，袖拂斗牛间。\n愿言觅刀圭，乘风弄羽翰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29841,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"庆元府人日乡饮酒礼","author":"颜颐仲","text":"王春人日喜阴晴，文物衣冠萃四明。\n礼乐几年今一见，主宾百拜酒三行。\n人心天理须兴起，士习民风悉变更。\n太守自惭才德薄，纲维全赖老先生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29842,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"柳花","author":"颜颐仲","text":"柳渐成阴万缕斜，无腰柔弱弄韶华。\n一庭春色无人管，檐雨声中飞尽花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29843,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"桐","author":"颜颐仲","text":"庭梧惊秋风，叶叶彫萎红。\n行人何不归，委魂逐孤鸿。\n去日良已赊，客身转飘蓬。\n千里各一涯，关山月明中。\n两臂恨不羽，飞逐君西东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29844,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和碧玉千峰诗","author":"颜颐仲","text":"道在穹壤间，如日照万国。\n淳乾再中天，斯文荷申锡。\n惟时朱夫子，一柱擎天力。\n勉斋妙心传，月印寒潭碧。\n东野正始音，绝唱未易续。\n昕庭万言对，珠玑灿盈掬。\n一麾压南州，寒谷回春燠。\n煌煌漳水珠，照耀昆山玉。\n美哉巽斋守，杰构捐金钱。\n横经踞皋比，冠剑来三千。\n贤侯揭新扁，伟观还当年。\n孰能踵公武，名盖东南天。\n经畬望有秋，譬彼田舍翁。\n学道犹学医，百脉期疏通。\n立身尚名节，峻峙千仞峰。\n勉哉蹈前修，毋与流俗同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29845,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"茅山","author":"杨至质","text":"玉肺空浮巳字山，五门不锁洞天宽。\n紫花可饵秋寻朮，红焰难埋夜见丹。\n画出一牛方水草，飞来三鹄各峰峦。\n仙踪寂寞高风远，谁为先生指额瘢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29846,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送茅山刘书记游南岳","author":"杨至质","text":"忆共住华阳，晴蓝紫朮香。\n空山今诣阙，吾子亦游方。\n草露双芒屦，丹经一布囊。\n好登祝融顶，红橘迸扶桑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29847,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄杨休文","author":"李叔与","text":"溪园雪凝古梅枝，我逐归云子到时。\n交一臂间迟面见，乃千里外话心期。\n人缘至此犹难合，天意其然欲对移。\n拟办瘦藤闻束担，有何山水未经诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29848,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"舟中寄涧谷","author":"李叔与","text":"秋风四起秋云薄，客怀颇欠商量著。\n浅滩胶舟石荦确，欲进不可退难却。\n蘋蓼妆成秋绰约，独倚晚风吟思涸。\n故人云锦自天落，一纸模糊万金药。\n上言相思下离索，勾引莼鲈味逾恶。\n吾心孤云身野鹤，到此方知出山错。\n归理绿蓑更青蒻，何处方舟无杜若。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29849,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山窗杂诗 其一","author":"李叔与","text":"学把锄头莳小畦，牡丹不种种荼縻。\n花开赢得年年看，棘蔓犹堪补败篱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29850,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山窗杂诗 其二","author":"李叔与","text":"一样春风到町畦，物成春亦不能齐。\n过篱新笋贪成竹，不管同根未脱泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29851,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山窗杂诗 其三","author":"李叔与","text":"夜久寒炉火尚红，隔山谁动五更钟。\n小童和梦移灯去，不管残书读未终。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29852,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"内河 其一","author":"李叔与","text":"短篷邀我到常州，入郭犹如野渡头。\n忽有画桥杨柳岸，柳中依约见青楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29853,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"内河 其二","author":"李叔与","text":"隔岸青松数百株，柳阴阴处结茅庐。\n溪翁有此不知趣，乞与诗人作退居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29854,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"乌衣园 其一","author":"李叔与","text":"绿阴庭院夏初长，梅子新肥杏子黄。\n枝上莫弹秦吉了，游人借此当笙簧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29855,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"乌衣园 其二","author":"李叔与","text":"乌衣三径去年开，庭树幽阴绿作堆。\n胡蝶不知人是客，双双飞入矮墙来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29856,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"层楼 其一","author":"李叔与","text":"半空和月倚新秋，十二栏干曲曲愁。\n我亦天涯零落者，不如饮到醉归休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29857,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"层楼 其二","author":"李叔与","text":"台城胜概得同游，烂醉西风药玉舟。\n目送归云天一角，教人生怕上层楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29858,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山窗","author":"李叔与","text":"挂起山窗满眼秋，小溪寒处竹深幽。\n有诗戏尔教儿诵，无酒归而与妇谋。\n窗为防风须密补，篱因禦寇更完脩。\n怕无人可论心事，剩种梅花在屋头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29859,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山窗杂诗 其一","author":"李叔与","text":"柳花收絮麦收芒，安石榴开日渐长。\n窗下小儒无一事，自携新水活菖阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29860,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山窗杂诗 其二","author":"李叔与","text":"月照西窗夜未阑，起来和墨研池乾。\n急忙欲写梅花赋，敲碎溪冰一片寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29861,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题李伯章蓬窗","author":"李叔与","text":"短篷留雪映窗纱，一似王家访戴家。\n到底王家风味浅，月痕低处欠梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29862,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题刘总郎书堂屏上","author":"李叔与","text":"怀人已仙去，书堂犹昔时。\n夜梦虽微茫，昼日俨在兹。\n我欲载遗事，简素多亡遗。\n目前尚如此，后世谁相知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29863,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偶成","author":"李叔与","text":"扑断清贫事，萧然一室居。\n雨将苔曼衍，秋与蕙清癯。\n火白衣犹煖，香焦味有馀。\n山中足诗思，岂必灞桥驴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29864,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题徐后湖扣舷歌卷末","author":"李叔与","text":"吾欲钓鱼东海去，一叶扁舟未能具。\n君呼小舫山水间，扣舷作歌秋水寒。\n吾诗百篇不直一杯水，君歌一阕游鱼亦倾耳。\n得君此编拱璧加明冰，玉笥陵云无此清。\n安能移我龙湖白竺之茅屋，来并清江后湖曲。\n我鸣榔，君扣舷。\n醉歌长篇复短篇，却使后人呼作徐李同舟仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29865,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送李仲炳归 其一","author":"李叔与","text":"君家渝水我螺川，同是江南百里天。\n同道同心更同姓，只年相远却忘年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29866,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送李仲炳归 其二","author":"李叔与","text":"扁舟同载石头城，雨打孤蓬夜共听。\n愁杀明朝桃叶渡，阳关无曲柳能青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29867,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送李仲炳归 其三","author":"李叔与","text":"思归恨臂不成翰，却笑谁令汝出山。\n梦暂得归归未得，且编归梦寄书还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29868,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠谈天","author":"李叔与","text":"我坐诗穷子术穷，十年湖海两漂蓬。\n子归农圃吾归钓，此去悬知命可通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29869,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"暮春感兴","author":"何基","text":"郊原春向深，幽居寡来往。\n和风日披拂，淑气遍万象。\n草本意欣荣，禽鸟声下上。\n静中观物化，胸次得浩养。\n缅怀浴沂人，从容侍函丈。\n舍瑟自言志，宣圣独深赏。\n一私尽消融，万理悉照朗。\n其人不可见，其意尚可想。\n我生千载后，恨不操几杖。\n春服虽已成，童冠乏俦党。\n安得同心人，咏归嗣遗响。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29870,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和吴巽之石菖蒲","author":"何基","text":"菖蒲绿茸茸，偏得高人怜。\n心清境自胜，何必幽涧边。\n节老叶愈劲，色定枝不妍。\n堂中贤主人，与汝俱萧然。\n岂不与世接，自远尘俗沾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29871,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]