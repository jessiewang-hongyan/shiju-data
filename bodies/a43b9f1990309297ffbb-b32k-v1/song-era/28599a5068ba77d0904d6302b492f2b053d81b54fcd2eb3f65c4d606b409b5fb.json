[{"title":"寒食相将诸子游翟园得十诗 其五","author":"杨万里","text":"小小茅亭短短窗，海棠围里柳中央。\n乍晴萱草浑无力，落尽梅花尚有香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68283,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寒食相将诸子游翟园得十诗 其七","author":"杨万里","text":"三月风光一岁无，杏花欲过李花初。\n柳丝自为春风舞，竹尾如何也学渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68284,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寒食相将诸子游翟园得十诗 其二","author":"杨万里","text":"鹿葱旧种菊新栽，幽径深行忘却回。\n忽有野香寻不得，兰于石背一花开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68285,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寒食相将诸子游翟园得十诗 其十","author":"杨万里","text":"荆溪老守底风流，哦就千诗一笑休。\n天欲做春无去处，只堆浓绿柳梢头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68286,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寒食相将诸子游翟园得十诗 其六","author":"杨万里","text":"儿曹健走尽从渠，老脚微酸半要扶。\n未委前头花好否，且令蜂蝶作前驱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68287,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寒食相将诸子游翟园得十诗 其八","author":"杨万里","text":"驱使花枝苦未休，平章诗句政冥搜。\n无端一窦西窗日，不遣吾人略小留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68288,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寒食相将诸子游翟园得十诗 其四","author":"杨万里","text":"尽忙也到翟园休，只见春光不见愁。\n屈折海棠团更密，日光下照绣灯毬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68289,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寒食相将诸子游翟园得十诗 其九","author":"杨万里","text":"花木从渠取次栽，青山那肯入城隈。\n翟公不有驱山手，城里松林底处来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68290,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寒雀","author":"杨万里","text":"百千寒雀下空庭，小集梅梢话晚晴。\n特地作团喧杀我，忽然惊散寂无声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68291,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"衔命郊劳使客船过崇德县三首 其三","author":"杨万里","text":"岸树低欹一雪馀，枝头半叶已全无。\n油窗过尽千梢影，浓处还浓枯处枯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68292,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"衔命郊劳使客船过崇德县三首 其二","author":"杨万里","text":"水面光浮赤玉盘，也应知我牵夫寒。\n满河圭璧无人要，吹入诗翁冻笔端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68293,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"衔命郊劳使客船过崇德县三首 其一","author":"杨万里","text":"北关落日送船行，欲到嘉兴天已明。\n睡起一河冰片满，槌琼摐玉梦中声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68294,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"揭阳道中二首 其二","author":"杨万里","text":"地平如掌树成行，野有邮亭浦有梁。\n旧日潮州底处所，如今风物冠南方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68295,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"揭阳道中二首 其一","author":"杨万里","text":"厌穿山径石嵚?，喜见川原路坦夷。\n更著两行团树子，引人行远不教知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68296,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晴后再雪四首 其四","author":"杨万里","text":"八盘岭上雪偏清，万斛琼尘作一倾。\n空里仰看都不见，碧山映得却分明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68297,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晴后再雪四首 其三","author":"杨万里","text":"天上琼楼万玉妃，月宫学舞试云衣。\n霓裳未彻天风起，脑子花钿星散飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68298,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晴后再雪四首 其二","author":"杨万里","text":"滕家仙子六琼娘，煮露为酥不剩浆。\n滴作玉虫千万只，一时飞满白云乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68299,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晴后再雪四首 其一","author":"杨万里","text":"幸自晴光雪半开，谁将泥脚涴琼瑰。\n水仙上诉姮娥泣，再遣天花散一回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68300,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晴望","author":"杨万里","text":"愁于望处一时销，山亦霜前分外高。\n枸杞一丛浑落尽，只残红乳似樱桃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68301,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"暑中早起东斋独坐","author":"杨万里","text":"松竹阴中逗晓光，无风有露自生凉。\n黄筠椅子十二只，倚遍琉璃背满霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68302,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"暑雨后散策","author":"杨万里","text":"溪南稻紫似溪北，雨后山青非雨前。\n芒屦泥深凉不浅，今年六月个般天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68303,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游云际寺诸僧皆出因过田家","author":"杨万里","text":"游遍诸峰欲晚霞，倦投野寺觅煎茶。\n更无一个残僧在，归路却投田舍家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68304,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游定林寺即荆公读书处四首 其四","author":"杨万里","text":"踏月敲门访病夫，问来还是雪堂苏。\n不知把烛高谈许，曾举乌台诗帐无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68305,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游定林寺即荆公读书处四首 其三","author":"杨万里","text":"半破僧庵半补篱，旧题无复壁间诗。\n祗馀手植双桐在，此外仍兼洗砚池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68306,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游定林寺即荆公读书处四首 其二","author":"杨万里","text":"一个青童一蹇驴，九年来往定林居。\n经纶枉被周公误，罢相归来始读书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68307,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游定林寺即荆公读书处四首 其一","author":"杨万里","text":"钟山已在万山深，更过钟山入定林。\n穿尽松杉行尽石，一庵犹隔白云岑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68308,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游翟园三首 其三","author":"杨万里","text":"翟园从此即相辞，园里春归我亦归。\n蜂踏残花容易落，蝶随数片往来飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68309,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游翟园三首 其二","author":"杨万里","text":"柔风软日斩新晴，酽白娇红鼎盛春。\n借问主人何处去，春光分付守园人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68310,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游翟园三首 其一","author":"杨万里","text":"花枝劣相絓人衣，蜂子颠狂触面皮。\n一巷海棠千架锦，两堤杨柳万窝丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68311,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湖天暮景五首 其五","author":"杨万里","text":"断肠浪说贺方回，未抵秦郎剪水才。\n欲向湖边问遗唱，鸳鸯鹦鹉两相推。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68312,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湖天暮景五首 其四","author":"杨万里","text":"雕碎肝脾只坐诗，须髯成雪鬓成丝。\n暮云薄倖斜阳劣，合造清愁付阿谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68313,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湖天暮景五首 其三","author":"杨万里","text":"抵暮渔郎初上船，一竿摇入水精天。\n忍寒不睡妨底事，来早卖鱼充酒钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68314,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湖天暮景五首 其二","author":"杨万里","text":"坐看西日落湖滨，不是山衔不是云。\n寸寸低来忽全没，分明入水只无痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68315,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湖天暮景五首 其一","author":"杨万里","text":"湖面黏天不见堤，湖心茭葑水周围。\n暮鸿成阵鸦成队，已落还飞久未栖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68316,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湖州三里桥取道德清","author":"杨万里","text":"浙西只欠到湖州，三里桥头转却舟。\n不到湖州妨底事，不如元不到桥头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68317,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登天柱冈","author":"杨万里","text":"云外千峰斗速行，山尖一树独分明。\n不知林下人家密，倚杖忽闻鸡犬声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68318,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登多稼亭晓望","author":"杨万里","text":"风不能销晓雾痕，天犹未放宿云根。\n城腰折处才三径，山觜前头别一村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68319,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登净远亭","author":"杨万里","text":"池冰受日未全开，旋旋波痕百皱来。\n野鸭被人惊得惯，作群飞去却飞回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68320,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登奉圣寺千佛阁四首 其四","author":"杨万里","text":"何许飞来双白鸥，碧山贴出雪花浮。\n倚栏只管移床立，看到双鸥没处休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68321,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登奉圣寺千佛阁四首 其三","author":"杨万里","text":"长诵悬崖置屋牢，此诗此阁晚相遭。\n阁中未觉高低在，下到山门始是高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68322,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登奉圣寺千佛阁四首 其二","author":"杨万里","text":"远山细腻近山粗，别处求粗也则无。\n更向远山山外看，教君病眼一双枯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68323,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登奉圣寺千佛阁四首 其一","author":"杨万里","text":"一只奇峰入眼中，看来只只是奇峰。\n好山道是无重数，少说青苍十万重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68324,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登南州奇观前临大江浮桥江心起三石台皆有亭子二首 其二","author":"杨万里","text":"玉壶冰底卧青龙，海外三山堕眼中。\n奇观揭名浑未在，只消题作小垂虹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68325,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登南州奇观前临大江浮桥江心起三石台皆有亭子二首 其一","author":"杨万里","text":"梅边楼阁海边山，银竹初收霁日寒。\n看著南州奇观了，人间山水不须看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68326,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登度雪台","author":"杨万里","text":"欲问金沙信，聊登度雪台。\n碧桃良解事，开过架梢来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68327,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登清心阁","author":"杨万里","text":"苦遭好月唤登楼，脚力虽慵不自由。\n上得金梯一回首，冰轮已过树梢头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68328,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答徐子材谈绝句","author":"杨万里","text":"受业初参且半山，终须投换晚唐间。\n国风此去无多子，关捩挑来祗等闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68329,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答提点纲马驿程刘修武翰二首 其二","author":"杨万里","text":"解道征鸿数字秋，清于雪椀映冰瓯。\n老来笔底心无毒，交割风光与子休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68330,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答提点纲马驿程刘修武翰二首 其一","author":"杨万里","text":"公干当年子建亲，景文今代大苏宾。\n绝知将种仍诗种，不放骚人与外人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68331,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"紫宸殿拜表贺雪二首 其一","author":"杨万里","text":"怪来腊日起春风，一夜琼花发禁中。\n大地山河银色界，九重楼观水精宫。\n紫宸廊迥寒无价，文石庭乾扫不融。\n又喜来年书大有，谁知圣主是天公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68332,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"缓辔入东宫门望见渔浦山","author":"杨万里","text":"渔浦孤峰入九城，承华门里最分明。\n马头看得山低去，夹道芙蓉红露声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68333,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"腊里立春蜂蝶辈出","author":"杨万里","text":"嫩日催青出冻荄，小风吹白落疏梅。\n残冬未放春交割，早有黄蜂紫蝶来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68334,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"落花","author":"杨万里","text":"红紫成泥泥作尘，颠风不管惜花人。\n落花辞树虽无语，别倩黄鹂告诉春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68335,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"落梅再著晚花","author":"杨万里","text":"数日春风不奈暄，梅花落尽净无痕。\n却将晚莟重收拾，更放南枝第二番。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68336,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"落梅有叹","author":"杨万里","text":"才看腊后得春饶，愁见风前作雪飘。\n脱蕊收将熬粥吃，落英仍好当香烧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68337,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"葵叶","author":"杨万里","text":"箬笠端能直几钱，骑奴不拟雨连天。\n盖头旋折山葵叶，擘破青青伞半边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68338,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蛛网","author":"杨万里","text":"深山无水又无人，晒网摊罾夺日明。\n却是蜘蛛遭积雨，经纶家计趁新晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68339,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蛩声","author":"杨万里","text":"诚斋老子一归休，最感蛩声五报秋。\n细听蛩声元自乐，人愁却道是它愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68340,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蛩声三首 其三","author":"杨万里","text":"莫憎苦调太酸辛，月思霜哀亦可人。\n村路小家无此客，溧阳少府是前身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68341,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蛩声三首 其二","author":"杨万里","text":"床根吟夜句冥搜，莎底啼寒泣怨秋。\n人世如何无苦乐，一般蟋蟀两般愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68342,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蛩声三首 其一","author":"杨万里","text":"山行我已厌征尘，夜语谁能伴老身。\n幸有暗蛩同店宿，被渠告诉却愁人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68343,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢江东耿漕曼老寄书并与沈侍郎唱和诗二首 其一 谢诒书劳苦","author":"杨万里","text":"朱雀桥边旧使星，五年再照大江明。\n端能记忆诚斋叟，千里书来访死生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68344,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢江东耿漕曼老寄书并与沈侍郎唱和诗二首 其二 谢唱和佳句","author":"杨万里","text":"碧落侍郎金作句，瀛洲学士玉为章。\n两公唱和君知么，个是安期却老方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68345,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢李元德郎中饷家酿二首 其二","author":"杨万里","text":"惠山山下玉泉香，酿作鹅儿一拂黄。\n吏部只知防姓毕，不知吏部有它杨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68346,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢李元德郎中饷家酿二首 其一","author":"杨万里","text":"长史衔杯太白醺，诙词笑杀古来人。\n至今太白一船酒，不饮还将饮子云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68347,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢赵茂甫惠浙曹中笔蜀越薄笺二首 其二","author":"杨万里","text":"百楮先生十兔尖，心知奇绝敢言贪。\n诗无好语书仍俗，喜气多多抵得惭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68348,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢赵茂甫惠浙曹中笔蜀越薄笺二首 其一","author":"杨万里","text":"公子平生无长物，几研生涯敌玉冰。\n二妙端能并送似，便呼毛颖试溪藤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68349,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赏牡丹","author":"杨万里","text":"把酒看花绕画栏，病身只得忍轻寒。\n主人半醉花微倦，下却珠帘放牡丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68350,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赏菊四首 其四","author":"杨万里","text":"物性从来各一家，谁贪寒瘦厌妍华。\n菊花自择风霜国，不是春光外菊花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68351,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赏菊四首 其三","author":"杨万里","text":"菊生不是遇渊明，自是渊明遇菊生。\n岁晚霜寒心独苦，渊明元是菊花精。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68352,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赏菊四首 其二","author":"杨万里","text":"菊花肯为别人黄，长怨先生不断肠。\n两鬓尽凋无地插，一杯细嚼入神香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68353,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赏菊四首 其一","author":"杨万里","text":"老子平生不解愁，花开酒熟万缘休。\n更教不为黄花醉，枉却今年一片秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68354,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"跋天台王仲言乞米诗","author":"杨万里","text":"改言缩项更长腰，黄独青精也绝苗。\n尚有囊中餐玉法，蓝田山里过明朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68355,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"跋尤延之山水两轴二首 其二","author":"杨万里","text":"水漱琼沙冰已凘，野凫半起半犹迟。\n千竿脩竹一江碧，只欠梅花三两枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68356,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"跋尤延之山水两轴二首 其一","author":"杨万里","text":"水际芦青荷叶黄，霜前木落蓼花香。\n渔舟去尽天将夕，雪色飞来鹭一行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68357,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"跋刘敏叔梅兰竹石四清图","author":"杨万里","text":"老夫老伴竹千竿，湖石江梅更畹兰。\n不道外人将短纸，一时捲去也无端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68358,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"跋余伯益所藏张钦夫书西铭短纸二首 其二","author":"杨万里","text":"横渠方寸著乾坤，传到南轩更莫论。\n四海交朋霜叶落，半张翰墨雪涛翻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68359,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]