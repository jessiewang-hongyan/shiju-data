[{"title":"奉别道先","author":"吕南公","text":"邂逅过从两载强，诗书存问满藜床。\n光荣得路谁非友，道义心知独不忘。\n圣代君才多勉勉，中年吾发已苍苍。\n牙弦自此聊停缓，万里穷山隔帝乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54339,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"桐城与曾唐杰话别","author":"吕南公","text":"事物无穷世路长，人生聚散亦堪伤。\n寒暄旦暮年年急，尘土风波处处忙。\n我马欲冲梁苑雪，君帆先犯楚天霜。\n交情若是存悠久，定有音书入帝乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54340,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿青绥铺","author":"吕南公","text":"两槛中间风脚横，解衣铺簟近南荣。\n曦光欲堕已睡熟，斗柄转斜才梦惊。\n方恨此时无月色，未知何处有蚊声。\n尘埃恶热明朝路，会为今宵动旅情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54341,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过洪州","author":"吕南公","text":"未定荣华与退休，三年四度过洪州。\n红尘白日知何得，西去东归不自由。\n一带好山谁旧隐，百端閒事我新忧。\n可能石马亭边路，见客区区到白头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54342,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"道先游仙都至李尊师故居见余早岁题赠拙句存于屋壁辄寄四韵重相叹赏谨有赓酬","author":"吕南公","text":"仙李枝条万国分，陇西旧望道家孙。\n曾经二十载还往，忽过七千馀晓昏。\n人落九泉无可奈，诗存古壁更休论。\n困穷辞气君偏爱，太息南征返北辕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54343,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十月二十日过陈二表民追讲昔年同学事迹慨然赠之以诗","author":"吕南公","text":"西斋共学昔辛勤，一别侵寻十四春。\n此日科场还似梦，旧时书屋已成尘。\n文章不斗钱财福，贫病长依寂寞滨。\n相值酒边当取醉，大家忘却困穷身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54344,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"百年","author":"吕南公","text":"百年长短有愁兼，世味如今岂足沾。\n客路无聊贫苒苒，春风相值病厌厌。\n辞章漫与前贤并，气调终遭俗士嫌。\n安得一廛閒散去，耕桑吟醉似陶潜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54345,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晓陪内翰步至北园","author":"吕南公","text":"晓风吹雨北园开，追逐双旌踏翠苔。\n芍药一栏霞上锦，嫩荷千片玉流杯。\n多年架阁游春兴，此日关防感物才。\n花不能言草成恨，故应知我偶然来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54346,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵显翁幽居即事","author":"吕南公","text":"文高只合论钱神，屈膝须防望贵尘。\n轩冕未来应有命，丘园随分亦安身。\n山樵水钓心常逸，夜坐朝耕乐更均。\n嗟我久怀农圃计，何时操耒即相亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54347,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送唐杰重过金陵","author":"吕南公","text":"金陵春水解归舟，重到金陵恰仲秋。\n世路已衔奔走恨，风光更引别离愁。\n支持事变何由办，叹息安閒不易求。\n只有北山长好在，为余频上冶城头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54348,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄赠张县丞","author":"吕南公","text":"二年来往南丰路，饱听乡民说县丞。\n刚果已如秋汉鹗，洁清仍似玉壶冰。\n室无奸吏纵横入，门有书生旦暮登。\n何事廉车帷幕厚，不将高位待贤能。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54349,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"熙宁五年归至旧山伤己感时作诗奉呈升卿黄丈 其一","author":"吕南公","text":"几年奔走背农桑，半世归来只感伤。\n蛇足画成曾失酒，古书看遍却亡羊。\n一廛席屦何从受，三径园庐已就荒。\n犹赖比邻贤父老，许同飞鸒贼馀粮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54350,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"熙宁五年归至旧山伤己感时作诗奉呈升卿黄丈 其二","author":"吕南公","text":"彬树湖前流水远，石城街左乱山苍。\n滩深潭浅无由问，竹秀松枯不可常。\n物理自应随变动，道心聊欲寄存亡。\n唯君坐占忘言境，珍重诗编与酒觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54351,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和呈二首 其一","author":"吕南公","text":"五亩之园未种桑，自怜疏懒致财伤。\n稻粱只是同鸡鹜，皮鞟徒劳胜犬羊。\n敢羡苏秦终富贵，正忧郗鉴遇饥荒。\n遭承若值开元日，何恤东南万里粮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54352,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和呈二首 其二","author":"吕南公","text":"茂林修竹旧时乡，争得安閒两鬓苍。\n长忆樵渔有山涧，岂论勋业到旂常。\n儿童好在今初见，故旧寻来半已亡。\n此意不堪频念虑，便倾襟抱付深觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54353,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再用前韵奉赠升卿三十一丈 其一","author":"吕南公","text":"百年此地有维桑，后庆唯公免物伤。\n早岁懿文如鸑鷟，一生纯德似羔羊。\n人推奥学追三箧，自许宽巾贮八荒。\n冷笑村田诸父老，满胸茅塞只赀粮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54354,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再用前韵奉赠升卿三十一丈 其二","author":"吕南公","text":"好德年高富且康，就中多福荷穹苍。\n吟哦有得能千首，议论无穷只五常。\n此日乡闾获矜式，异时风化免销亡。\n嗟余欲买西邻住，岁为先生祝寿觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54355,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"金陵递中示到亨父老丈去年秋初见寄诗书捧咏无穷之意不胜私感因成四韵奉呈","author":"吕南公","text":"邮签初发去年书，叹息贫穷未破除。\n乞食君方如槛虎，贼粮我亦似卑居。\n有求自恨伤生酷，多难谁能虑事疏。\n同病相忧古来语，此情今日好欷歔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54356,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九月一日口号奉呈显翁文叔","author":"吕南公","text":"九秋未尽六秋穷，露冷风高爽气雄。\n无事日成多事过，故乡身与异乡同。\n心随酒盏归愁外，眼对时花到梦中。\n鸿雁已南吾渐北，自怜安稳愧庞公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54357,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵酬朱推官","author":"吕南公","text":"上国辉光不许观，故园岑寂且閒眠。\n无心自可齐穷达，有口皆能论圣贤。\n百本柔桑绕茅屋，一陂清水灌沙田。\n馀生饱暖聊依此，岂有高风远市廛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54358,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄酒伴唐彦君益","author":"吕南公","text":"门外水渠鸣漉漉，屋头桐叶落翩翩。\n向来苦旱难寻井，及此愁霖易怨天。\n数盏旧藏真糯液，一盘初烂壮牛肩。\n故人忙迫城隍远，独息书床又醉眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54359,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"得乡信","author":"吕南公","text":"乡信迢迢出旧山，琴心先落断弦间。\n数行文字传新事，几段悲欢破客颜。\n闻喜竹林经雪好，想怜溪水逐年閒。\n征衫有泪归无计，一夜穷魂趁梦还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54360,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过聂彦伦故宅","author":"吕南公","text":"彦伦门外旧城墙，雉堞崩销草木荒。\n人物已成尘土去，风烟犹与岁时长。\n绿衫科第何曾贵，白发诗书不可常。\n平昔往还吾亦预，经过此日倍凄凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54361,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"范十七司理见问岁除鳅蔬夜饮之约新春愆爽以八句答之","author":"吕南公","text":"田泥涣烂鳅怀子，圃垄肥腴菜长心。\n僧镬纵然忘忌讳，书刀何忍屡残淫。\n村渔不逊财难动，澍雨无端草易深。\n拘束学官懒复懒，坐愁佳约未能寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54362,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"出都","author":"吕南公","text":"霜风吹背出皇都，大笑回头谢酒垆。\n楚国但闻悲弃璞，鲁门那复辨真儒。\n百年风槩文终在，一世光荣意已无。\n乞得耕桑了疏野，太平何害有潜夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54363,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"稚女","author":"吕南公","text":"衣无罗绮且贫清，口有诗书亦性灵。\n论客须多如反寇，笑爷帽破似穷伶。\n园中果熟心先动，案上杯传眼更青。\n钗拟荆枝裙拟布，暮年吾活正凋零。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54364,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄李居士","author":"吕南公","text":"三月山城叹旅穷，冷看豪士振浇风。\n送花盘上春情重，卖酒垆前醉魄雄。\n钟鼓聒眠崇佛庙，绮罗争路拜神宫。\n此怀若向林泉说，又落仙翁大笑中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54365,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"奉答顾言见寄新句二首 其一","author":"吕南公","text":"早年辛苦待飞翻，翅折无因达九关。\n更使襟灵憎市井，足知缘分在云山。\n谁怜古学长无用，自幸馀生且就閒。\n多谢鹿鸣筵上友，解传诗句慰衰颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54366,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"奉答顾言见寄新句二首 其二","author":"吕南公","text":"羡君肝胆壮难攀，不厌长安出入关。\n探穴定期收虎子，采薇宁暇顾西山。\n盱衡自庆千年运，冷笑人求一日閒。\n乃肯题诗寄空谷，的于游旧有温颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54367,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和酬道先贤良见寄新句","author":"吕南公","text":"中林独往寡襟期，祗与耕桑治町畦。\n迟晚识君真幸会，生平于世似分携。\n未能捧履师黄石，且欲同歌效紫溪。\n郡阁郊园遥百里，未妨怀寄屡封题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54368,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"池口阻风奉寄唐杰","author":"吕南公","text":"贵池亭下浪如山，触拨愁根阻楫间。\n眼为故人成北望，梦知乡路数东还。\n此生太半沦忧患，万事何时脱险艰。\n不敢临流更窥影，便疑秋鬓已斑斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54369,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"子发移令上高","author":"吕南公","text":"两州三载屈参卿，百里初来福困氓。\n无处不思逃浊暗，此邦何幸得贤明。\n后生智足科防密，凶岁财伤性命轻。\n能为爱人忘富贵，岂徒循吏有佳声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54370,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"有怀溪斋奉寄微之","author":"吕南公","text":"溪光清媚四山稠，十五年前记薄游。\n茆屋读书风满座，野桥寻酒月当头。\n身名不分轻如梦，甲历谁令过若流。\n此地主人相问否，一廛今带百端忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54371,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题陶集","author":"吕南公","text":"未读陶诗已爱閒，自从能读转思山。\n烟霞合定徘徊分，尘土刚侵勉强颜。\n伊昔有人安白屋，祗今何事慕青纶。\n披蓑戴笠终当去，更在规谋俛仰间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54372,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"豫章城","author":"吕南公","text":"西山东下古池隍，增饰依稀问晚唐。\n平世但严民筦钥，乱时曾是贼金汤。\n春归旧堞多芳草，鸟聚荒陴正夕阳。\n也欲登临赋风物，自怜才笔厌忧伤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54373,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晓过城隍街马上看木芙蓉","author":"吕南公","text":"秋来风味苦阑珊，偶为繁红略据鞍。\n何处更期征雁过，祗今聊作故人看。\n三冬已至休争气，九月将残未觉寒。\n自有荣华趁时节，免将憔悴惜幽兰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54374,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"八月十四夜小雨","author":"吕南公","text":"小雨遮空意未回，轻风迎夜势初来。\n青楼月好人何在，锦帐灯寒扇自开。\n四七功名真土芥，一千期运亦烟埃。\n会须放纵云雷手，不到人间有剩才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54375,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"高赋亭二首 其一","author":"吕南公","text":"耳外蜩螗响切才，眼前冈麓秀环回。\n曦光堕地收风尽，云脚遮山送雨来。\n长恐易成多事恨，可怜难见绝尘才。\n何由上得昆崙顶，试使烦襟磊落开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54376,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"高赋亭二首 其二","author":"吕南公","text":"事变纷纷不可防，祇应人世恶忧伤。\n高情易与时风背，远虑空为智士忙。\n感古有怀成戚戚，就书图活得遑遑。\n贫穷到处乖悰况，不但他乡异故乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54377,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"将归南城留别高赋亭二首 其一","author":"吕南公","text":"一上高亭一惨然，飘流无状见风烟。\n林泉本是侬家分，衣食刚为此世牵。\n流水岭云能自得，樵歌谷响远相连。\n来时祇恐禽鱼笑，掩敛南华第一篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54378,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"将归南城留别高赋亭二首 其二","author":"吕南公","text":"寄食官斋过一期，登临容易此阶梯。\n四时光景非无乐，千里忧伤却自迷。\n旷望可能舒感慨，幽吟长是写酸嘶。\n从今风物多清暇，免被书生掩泪题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54379,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清明日再题高赋亭","author":"吕南公","text":"二年来作旅行人，节物相逢但感情。\n彭蠡湖边看竞渡，摐阳山畔过清明。\n游神杳默皆愁意，倾耳寻常得恨声。\n若有桑麻三亩地，肯将高迹学蓬萍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54380,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送子发赴江州司理","author":"吕南公","text":"湓江湛湛照闉阇，庐岳蟠蟠荫郭郛。\n此地一官虽郁屈，异人当日亦踟蹰。\n元规楼下随红旆，居易祠前看白须。\n才调似君真不薄，有诗无吝寄云夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54381,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄范司理","author":"吕南公","text":"郡南郡北叫呼间，砚席相望聚首难。\n笑我性灵偏忍饿，怜君风韵似无官。\n傥来富贵能多与，不朽文章倍好看。\n莫怪参寻颇疏缓，鞋穿衣薄怯霜寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54382,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送张司理","author":"吕南公","text":"三年频说狱空虚，叹息贤才治有馀。\n晓踏府尘铃窅眇，夜吟庭月树扶疏。\n尚微官职人皆有，已大精神众不如。\n努力无忘建功业，秃毫他日为君书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54383,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"感怀奉呈纯父","author":"吕南公","text":"去年三月出京关，汴水东奔不可宽。\n今岁此时还逆旅，牡丹开尽未曾看。\n春风祇管添须发，世事争来触肺肝。\n传语百忧休恣横，已因泉石著南冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54384,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵彦臣感怀","author":"吕南公","text":"不得经纶辅太平，枉于天地荷生成。\n少如贾谊频垂涕，老似樊须请学耕。\n醉舞或将猴共势，饥吟时与蚓同声。\n若教眼底不识字，应已脱除穷困名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54385,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过湖口","author":"吕南公","text":"野客西来意绪劳，为停征棹到亭皋。\n湖山气象皆清旷，名利襟怀自郁陶。\n晓市鱼多腥万鼻，晚波风健趁千艘。\n高情未有分张处，愁诵山移一两遭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54386,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偶书所怀","author":"吕南公","text":"凤凰亭上倚层轩，桃李分香到几筵。\n曾与故人同一饮，试思前事已三年。\n歌欢旧兴知何在，衰飒新愁祇自怜。\n纵使春风容病迹，亦贪窗下枕书眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54387,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"奉和内翰太中建昌三见梅花","author":"吕南公","text":"三见梅花似故人，楚乡春是洛阳春。\n蘸杯酒意枝枝重，入笔诗情处处新。\n南野幽林寻去远，西园高树绕来频。\n无心草木穷山里，还解遭逢侍从臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54388,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登滕王阁","author":"吕南公","text":"韦君德政满洪州，去后无人更讲求。\n帝子骄奢起高阁，到今连岁为增修。\n座中箫鼓来无定，槛外帆樯过不休。\n惆怅幽怀谁与问，水长山远总关愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54389,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书边","author":"吕南公","text":"劳佚由来命不同，悠悠身事几时穷。\n学能爱日终无补，愁解迎春却有功。\n千虑漫游言语外，寸心常在苦辛中。\n故应樽酒怜憔悴，会借书边醉颊红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54390,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"风雨","author":"吕南公","text":"春来未苦狂风雨，初见云雷气象豪。\n合杂忽如乔岳倒，迷冥不辨九天高。\n林峦偃亚传雄韵，沟涧苍茫起怒涛。\n花卉一空何足问，且欣馀润入耕皋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54391,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"哭邓氏女兄 其一","author":"吕南公","text":"东田嶂下古荒村，又向荆榛占一坟。\n寒苦到今初是了，荣枯从此更休分。\n棺旁乳女随遗褓，膝下亡男恨白云。\n共系人间酸鼻事，欲言聊复泪纷纷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54392,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"哭邓氏女兄 其二","author":"吕南公","text":"凄凉三十六青春，叹息从人只累身。\n内外诸门方破碎，初终两姓却沉沦。\n平生尚未谙奢泰，已病犹能强补纫。\n便向夜台逢考妣，应传同气各邅迍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54393,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答道先寄酒柴荆","author":"吕南公","text":"江州双酎到篱东，快杀陶家寂寞翁。\n田野放怀容易老，篇章写意敢言工。\n渐生耳外熏烘热，转觉杯间潋滟空。\n何必篮舆依五柳，久来身世醉乡中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54394,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"己未上元宿崇相山寺","author":"吕南公","text":"七十年华已半除，新春犹复感穷途。\n肠便酒味虽如旧，眼对花枝只似无。\n计画但求閒次第，文章知是枉功夫。\n满城灯火笙歌沸，独访东山宿佛图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54395,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陪道先兄游麻源辄赋二小诗 其一","author":"吕南公","text":"借得篮舆便出城，山光门外望西行。\n昨宵偶雨路尘少，今日好风林霭轻。\n有竹人家庭院秀，避驺樵客面颜生。\n溪田桥北驼鞍岭，犹记当年志未平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54396,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陪道先兄游麻源辄赋二小诗 其二","author":"吕南公","text":"十五年前胆气粗，拟将文字换金珠。\n科场委顿成何事，耕稼辛勤落晚途。\n累岁不曾言石磴，居山空道有茅庐。\n今朝碧涧潺湲响，若不因公得听无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54397,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"永定东轩望净土芭蕉","author":"吕南公","text":"高丛猎猎画檐西，曾听寒声惨淡吹。\n午枕有怀疏雨后，夜灯无语恶风时。\n二年成别应多恨，此日凭高动所思。\n人世不堪谋虑远，眼前容易得伤悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54398,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过游源驿","author":"吕南公","text":"游源驿里壁间诗，去岁经过一览时。\n客子面皮真铁铸，閒人公论是灵旂。\n有谁谑浪慵开口，只我哀怜为敛眉。\n多谢县侯新荡涤，从今莫恨放行迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54399,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"池塘","author":"吕南公","text":"池塘春草夏仍多，更照层林发翠波。\n到处风光长好在，座中愁客奈情何。\n眼随高鸟寻乡思，手把閒书养睡魔。\n谁使早蝉能触拨，新声来与断肠和。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54400,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵济道见寄 其一","author":"吕南公","text":"君作王官效众儒，尚逢廊庙有为初。\n尘中白日虽牵逼，笔下清风肯破除。\n欲去定成贤者隐，未归尝与俗流疏。\n人生到处随荣愿，何必江湖胜漆沮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54401,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]