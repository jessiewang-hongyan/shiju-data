[{"title":"和雨后对月","author":"李光","text":"载酒人无顾寂寥，秋来门巷更萧萧。\n风驱雨脚收千嶂，云捲月轮升九霄。\n松竹此时聊谷隐，巾车指日见弓招。\n登临莫作殊乡念，乘兴时寻小石桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3492,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"海外气候每岁三四月间已如剧暑客有自吉阳至者寓馆问汉亭累日且言吉阳气候昼夜如炊因叹此邦之胜乃知人生无有足时不经热恼岂知平日之清凉乎故古之达者每以此对治释氏云推落大火坑火坑变成池皮鞋和尚以为即时清凉也苏公亦云岭南瘴毒地有此江月寒乃知天壤间何人不清安予谪居岭海踰十五年见闻习熟不以为异因作此诗以自慰且以警世之贱丈夫一不快即愁叹怨愤或讥谤怒骂如柳刘之徒盖未足以语此也","author":"李光","text":"客自东来说吉阳，始知儋耳本清凉。\n潮声卷海千峰雨，月色侵门满地霜。\n更欲何方寻佛国，此生真欲老蛮乡。\n安心守一师吾祖，尚觉人间日月长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3493,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"予生世几八十年交游士友有昧平生而一见气合者有同乡并舍而终身情乖者因悟笑曰此释氏所谓宿缘也知此则可以忘忧恼泯是非免轮回而脱生死也因作拙句以道其意云","author":"李光","text":"路隔仙凡只一尘，浮生出没转风轮。\n宿缘未断形虽换，异世相逢意自亲。\n圆泽再来寻旧伴，房公一笑悟前身。\n若将爱见迷真性，万劫难超未了因。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3494,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"丙子正月二十三日纪事","author":"李光","text":"风捲阴霾日月明，鲸鲵已戮海波平。\n奸憸藉手捐奇货，交友通书免诡名。\n旧俗衣冠回左衽，新疆兵革偃长城。\n圣君若用当时将，一洗烟尘宇宙清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3495,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"离阳寿县百馀里遇大风雨溪流涨溢宿修仁境小寺新洁可喜不复有滞留之叹偶成长句老病字画攲斜辄自笑也仲子孟坚同来","author":"李光","text":"逐客多年住海滨，今朝喜作北乡人。\n飘风扫地捲烦暑，骤雨翻空洗瘴尘。\n境恶乍离宾馆陋，眼明欣睹佛祠新。\n松林竹径俱幽胜，留滞何庸叹苦辛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3496,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"某到郴几两月适当重阳而菊犹未开然江山清远又仙佛所居有足乐者因成鄙句以写离忧","author":"李光","text":"重阳从古多伤感，逐客南来重叹嗟。\n镜里但惊添白发，樽前犹未见黄花。\n求仙顿觉三山近，成佛无令一念差。\n习气平生都扫尽，更凭橘水洗尘沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3497,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"郴士为作暖阁既成是夕雪作喜而成诗","author":"李光","text":"暖阁初成荷北邻，欢然一笑欲烘春。\n香烟苒苒萦纡转，鼻息齁齁出入匀。\n睡美忽惊天曈昽，夜寒谁怕脚舒伸。\n老兵来报雪床厚，准拟明朝共饮醇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3498,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"悼程伯宇尚书","author":"李光","text":"人物江东第一流，天衢阔步纵骅骝。\n弹冠事主俱青绂，握手论交到白头。\n照世词华窥贾马，致君事业拟伊周。\n平生自谓孔北海，晚节欲为陈太丘。\n危行危言逢有道，一生一死见交游。\n自怜罪大无归日，哭送松门叹莫由。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3499,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵奉酬当时参议见赠游钟山五诗 其一","author":"李光","text":"二水苍茫外，千峰杳霭间。\n伤心金碧地，举目异河山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3500,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵奉酬当时参议见赠游钟山五诗 其二","author":"李光","text":"英谋参上幕，爽气盖群雄。\n愤世仍忧国，都忘酒盏中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3501,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵奉酬当时参议见赠游钟山五诗 其三","author":"李光","text":"六国衣冠盛，中原气象存。\n腰间佩金印，莫忘杀王敦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3502,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵奉酬当时参议见赠游钟山五诗 其四","author":"李光","text":"雅志希三釜，平生擅一丘。\n归寻赤松约，何必更封留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3503,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵奉酬当时参议见赠游钟山五诗 其五","author":"李光","text":"塞北烟尘息，江南胜气多。\n君王总戎旅，来继大风歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3504,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"跋六无诗卷后","author":"李光","text":"六无信笔成，无令浪流传。\n它时达官知，人人愿南迁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3505,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"脩仁道中微雨峭寒荒山古道间桃花盛开因偶成小诗","author":"李光","text":"古道逢元夕，荒山惨暮烟。\n桃花虽作意，未是艳阳天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3506,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"丁丑岁冬夜发家书二首 其一","author":"李光","text":"一别关山隔，相逢未有期。\n书来知勿药，欢喜偶成诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3507,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"丁丑岁冬夜发家书二首 其二","author":"李光","text":"越国今安在，湖边想旧居。\n衡阳空有雁，不寄一行书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3508,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"三月六日闻五马同郡僚出郊劝农 其一","author":"李光","text":"遥闻鼓吹出城闉，露冕褰帷意在民。\n父老莫疑频驻马，使君那顾采桑人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3509,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"三月六日闻五马同郡僚出郊劝农 其二","author":"李光","text":"旋移瑶席盍朋簪，日暮行庖簇柳阴。\n力劝耕农颁汉诏，应知圣主爱民心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3510,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"病中作","author":"李光","text":"一枕昏昏若醉乡，云收雾散月临窗。\n幽人睡足自惊觉，云在青天月在床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3511,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"池外红蕉","author":"李光","text":"雨后芭蕉粲晓霞，近如相妒远如誇。\n临池似把菱花照，隔叶深将翠幔遮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3512,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"立夏日纳凉","author":"李光","text":"茅庵西畔小池东，乌鹊藏身柳影中。\n沙岸山坡无野店，不知此处有清风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3513,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"五月八日雨大作闻守倅游湖以前日白莲见寄戏成小诗谢之","author":"李光","text":"守倅风流好事同，笙歌都在雨声中。\n似知坐上多狂客，不许佳人酒面红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3514,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"老钦阇黎以政和七年九月十七日夜圆寂趺坐如生道俗叹仰邑丞向仁叔作偈赞悼因次其韵 其一","author":"李光","text":"鍊得金刚一性坚，形如枯木尚凝然。\n莫疑台岭慈灯息，薪尽何妨火自传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3515,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"老钦阇黎以政和七年九月十七日夜圆寂趺坐如生道俗叹仰邑丞向仁叔作偈赞悼因次其韵 其二","author":"李光","text":"老人端悟上乘禅，夜壑藏舟已脱然。\n认得本来无一物，不将三观浪流传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3516,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄天童觉老","author":"李光","text":"竹牖茅檐屋数间，不贪杯酒不游山。\n征租纳罢秋田熟，未必天童似我闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3517,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闲赠赵与槟","author":"李光","text":"岁岁天寒白鹤来，箧中旧藁为君开。\n濂伊一脉微如线，力践精思渐可回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3518,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"竹几","author":"李光","text":"虚滑轻凉任自然，水边林下最相便。\n他年若遇青城叟，成坏方知尽属天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3519,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"洞下宗风冷秋初地而近时了觉二老化行淮甸今复盛于闽浙学徒常千馀人予固疑之昨天童访予于五松山交臂立谈之顷疑情顿释因成偈四句奉呈大众一笑可也","author":"李光","text":"一条枯木如青盖，古庙香炉散紫烟。\n百鸟却衔花作供，恁时方会祖师禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3520,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"双雁道中","author":"李光","text":"晚潮落尽水涓涓，柳老秧齐过禁烟。\n十里人家鸡犬静，竹扉斜掩护蚕眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3521,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送春二首 其一","author":"李光","text":"层楼极目送春回，愁里匆匆把一杯。\n更有明年寻旧约，先驱还到北枝梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3522,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送春二首 其二","author":"李光","text":"群花落尽柳绵飞，陌上游人去渐稀。\n今日江津送春去，明年还向柳梢归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3523,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"友人惠鹅仆方戒杀赠二小诗还之 其一","author":"李光","text":"晓随芦雁聚寒汀，只有崇师画得成。\n欲付庖人应未忍，怜渠岂是不能鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3524,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"友人惠鹅仆方戒杀赠二小诗还之 其二","author":"李光","text":"右军池上动成群，何事羁栖傍主人。\n放汝江湖须远去，莫随鸡鹜恼比邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3525,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"留春","author":"李光","text":"红蕉开尽槿花飞，载酒登临到落晖。\n秉烛更期寻胜侣，不教容易放春归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3526,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"白莲","author":"李光","text":"白色莲花也自奇，亭亭水面半开时。\n恰如西子新妆了，未把胭脂污玉肌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3527,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"跋胡机宜画卷","author":"李光","text":"吴山越峤对横斜，清梦时时到外沙。\n行过小桥墟落静，定知深处是吾家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3528,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戏成寄介然先辈","author":"李光","text":"鸣鸠隔屋报新晴，小阁幽窗分外明。\n怪底女僮来涤砚，无人知是和诗成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3529,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"政和戊戌孟夏补试文武遣兴一首","author":"李光","text":"一帘疏雨锁牢愁，小阁幽轩得暂留。\n漫说金瓯能破睡，不如玉局解消忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3530,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"新桥","author":"李光","text":"贾客船回泊暮潮，夜凉乘月卧吹箫。\n两堤更拟栽垂柳，掩映荆溪罨画桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3531,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"浯溪","author":"李光","text":"结屋浯溪最上头，冰轮滟滟水悠悠。\n夜深燕坐观心境，月到中天江自流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3532,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自象登舟入武仙县境有山耸拔四十丈奇秀异常有道人于此升仙因以得名","author":"李光","text":"青山万叠俯涟漪，时有幽花挂石衣。\n百里清溪休荡桨，要看倒影入窗扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3533,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"阳朔道中两绝 其一","author":"李光","text":"北客多誇阳朔山，今朝了了见层峦。\n定知万壑干岩胜，不似山阴道上看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3534,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"阳朔道中两绝 其二","author":"李光","text":"万里南行岂偶然，黄粱一枕梦邯郸。\n初无惠政苏疲俗，父老休迎旧长官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3535,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"览义叟秋香二首词情悽惋使人感叹义叟新有闺房之戚因戏续其韵且知予感念故人不忘之意 其一","author":"李光","text":"小诗清绝与招魂，香雾依然湿鬓云。\n一夜狂风都扫尽，鼻端无复嗅馀芬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3536,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"览义叟秋香二首词情悽惋使人感叹义叟新有闺房之戚因戏续其韵且知予感念故人不忘之意 其二","author":"李光","text":"冷艳孤芳孰与俦，此花飘尽更非秋。\n岭头赖有寒梅在，接续幽香入品流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3537,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵补之药名十绝 其一","author":"李光","text":"一樽聊对菊花前，独上危楼晚景天。\n风外笛声闻续断，海桐摇落夜敲砖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3538,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵补之药名十绝 其二","author":"李光","text":"婆娑终日步莲塘，云点空青月到廊。\n病渴长卿初赋就，伏神东壁漏声长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3539,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵补之药名十绝 其三","author":"李光","text":"平昔雌黄悯圣丘，预知钩吻卒难收。\n狼牙狗舌须防已，拟向前湖觅败舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3540,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵补之药名十绝 其四","author":"李光","text":"百部披寻手不停，肠留藁本味精英。\n林泉甘遂高良性，石斛何如五斗轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3541,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵补之药名十绝 其五","author":"李光","text":"阶前一叶巧随风，夜半金茎沆瀣浓。\n白兔西飞如赤箭，乌头旋复向龙钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3542,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵补之药名十绝 其六","author":"李光","text":"面壁潜心学大空，此身无患任飘蓬。\n草堂自得醍醐味，更访稽山支遁翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3543,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵补之药名十绝 其七","author":"李光","text":"山城衢陌厌尘泥，独扫云房价不低。\n早晚天门自开阖，不须鸡舌决明啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3544,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵补之药名十绝 其八","author":"李光","text":"才过天社又中秋，江子何时写我忧。\n风扫半天河海净，玄霜着物蜕蝉休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3545,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵补之药名十绝 其九","author":"李光","text":"草堂谁缉败蒲编，笑傲松萝不记年。\n应喜秋来甘泽泻，牵牛时复自蹊田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3546,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵补之药名十绝 其十","author":"李光","text":"却上南亭望北亭，云生秋石逼帘旌。\n露欺绿玉青蒲色，风掷琅玕败叶声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3547,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵补之惜花诗","author":"李光","text":"年来直欲挽韶华，柳径桃蹊便是家。\n綵锦幕天防横雨，红纱照夜看飞花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3548,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"咏史","author":"李光","text":"入关不守旧山河，汉用张良作网罗。\n垓下不知兵已合，夜深方讶楚人多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3549,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"纪异","author":"李光","text":"掣电驱雷起蛰龙，一番桃李斗纤秾。\n晚来忽见千山白，戏蚓鸣蛙失旧踪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3550,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠林桂高二首 其一","author":"李光","text":"子向柯山得所从，天寒滨海致诗筒。\n卷中更赌忠斋笔，力障狂澜有二公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3551,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠林桂高二首 其二","author":"李光","text":"知入庐山翠几重，归除怀玉不匆匆。\n绝怜梅野双雏凤，长记闽中一秃翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3552,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"退朝见越山二首 其一","author":"李光","text":"晓来朝退紫宸班，马上悠然见越山。\n便欲挂冠寻旧隐，卧看远岫列窗闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3553,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"退朝见越山二首 其二","author":"李光","text":"接武鸳鸾缀近班，愧无谋略济时艰。\n打包结伴寻芳去，相对僧窗一味闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3554,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题百官步","author":"李光","text":"晓雨微茫水接天，隔江茅店有炊烟。\n杖藜独上沙头路，犹记当时赶渡船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3555,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"失题二首 其一","author":"李光","text":"别乘风流迈昔贤，澄江堂下剩栽莲。\n秋来更有江湖思，睡鸭残芦带暝烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3556,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"失题二首 其二","author":"李光","text":"贺监门前水一湾，藕花十里对梅山。\n归心不待秋风急，恐负轻鸥作伴闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3557,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"绍兴二年三月还自淮西重至宣城与德渊寺丞诸友散步后圃登双溪楼二首 其一","author":"李光","text":"翛然危观出风尘，千里溪山照映人。\n飞盖追随宾客旧，满园桃李不胜春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3558,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"绍兴二年三月还自淮西重至宣城与德渊寺丞诸友散步后圃登双溪楼二首 其二","author":"李光","text":"夙衔王命出行朝，军士无哗罢击刁。\n一笑聊空狐鼠穴，却驱貔虎取天骄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3559,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赴金陵舟过霅川偶作 其一","author":"李光","text":"孤村远浦接微茫，处处经行看插秧。\n却忆年时住家处，藕花无数绕林塘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3560,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赴金陵舟过霅川偶作 其二","author":"李光","text":"渔舟荡漾逐鸥轻，呕轧缫车杂橹声。\n却入江淮兵革地，梦魂何似此间清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3561,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿伯氏南轩","author":"李光","text":"江山秀色照窗扉，暖阁清檐许暂依。\n白首往来寒食路，扁舟长趁落潮归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3562,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"孚先兄示诗颇怀愤悱且有杜门不出之誓连日病目不能答今小愈因成三绝句奉寄以广其意 其一","author":"李光","text":"荆玉灵珠祗自珍，闭门觅句未全贫。\n先生不出人难测，应有清风动四邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3563,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]