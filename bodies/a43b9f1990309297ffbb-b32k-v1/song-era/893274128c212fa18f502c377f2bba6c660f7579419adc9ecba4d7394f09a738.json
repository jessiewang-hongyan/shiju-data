[{"title":"室中三关 其一","author":"释原妙","text":"杲日当空，无所不照，因甚被片云遮却。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17336,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十一首 其二十九","author":"释原妙","text":"不动尊，提不起，茫茫宇宙谁能委。\n秋江清夜月澄辉，鹭鸶飞入芦花里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17337,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十一首 其二十三","author":"释原妙","text":"三十年来在梦中，生涯丧尽绝行踪。\n自惭一见桃花后，依旧漫天鼓黑风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17338,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈七首 其三","author":"释守端","text":"泥佛不度水，木佛不度火。\n金佛不度炉，真佛内里坐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17339,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十一首 其四","author":"释原妙","text":"祖师不会禅，夫子不识字。\n棒打石人头，嚗嚗论实事。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17340,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十一首 其三","author":"释原妙","text":"死款都来一口供，情穷理极卒难容。\n若将皮髓论高下，争见花开五叶红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17341,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五首 其三","author":"释原妙","text":"滴滴通身是烂脓，更无一点落西东。\n若言不是知音者，未免风吹别调中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17342,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五首 其二","author":"释原妙","text":"剖尽枯肠丧尽机，通身不挂一毫丝。\n清风步步随身转，明月谁分上下池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17343,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十二首 其十二","author":"释原妙","text":"不得者个，争得那个。\n既得那个，忘却者个。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17344,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十二首 其十","author":"释原妙","text":"若论此事，正如傍墙逼狗。\n逼来逼去，逼至尖角落头，未免翻身遭他一口。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17345,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十二首 其九","author":"释原妙","text":"封却拄杖头，结却布袋口。\n禁在铁围山，枷上重增杻。\n有中拷出无，无中拷出有。\n痛楚百千般，不离者窠臼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17346,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十二首 其八","author":"释原妙","text":"腊月三十日，时节看看至。\n露柱与灯笼，休更打瞌睡。\n觌面当机提，当机觌面觑。\n蓦然触瞎眼睛，照顾烂泥里有刺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17347,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十二首 其七","author":"释原妙","text":"一二三四，四三二一。\n钩锁连环，银山铁壁。\n觑得破，跳得出。\n大千沙界海中沤，一切圣贤如电拂。\n若是觑不破跳不出，切须翻天覆地离巢越窟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17348,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十二首 其六","author":"释原妙","text":"有时热鬨鬨，有时冷冰冰。\n有时如牵驴入井，有时如顺水张帆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17349,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十二首 其四","author":"释原妙","text":"东西十万，南北八千。\n纤尘不立，寸草不生。\n往来无碍，妙用纵横。\n直饶亲到者里，正是弃本逐末，引祸招殃。\n且道如何是本，抛出轮王三寸铁，分明遍界是刀鎗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17350,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十二首 其二","author":"释原妙","text":"皮穿肉烂，筋断骨折。\n具无碍辩，横说竖说。\n若谓向上一关，敢保老兄未彻。\n直须虚空粉碎，大海枯竭。\n透顶透底，内外澄澈。\n正恁么时，犹是眼中著屑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17351,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十二首 其一","author":"释原妙","text":"欲明种子因，熟读上大人。\n若到可知礼，盲龟跛鳖亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17352,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十七首 其二十二","author":"释原妙","text":"八十日中，千说万喻。\n说也说到无说时，闻也闻到无闻处。\n既是无说又无闻，功成果满凭何举。\n吹龙笛，击鼍鼓。\n皓齿歌，细腰舞。\n桃花乱落如红雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17353,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十七首 其十","author":"释原妙","text":"新年头，行新令。\n露柱灯笼，急著眼听。\n灶头西南角有片方砖，惺惺伶俐，伶俐惺惺。\n念兹在兹，必恭必敬。\n因甚如此，徐十三郎行年本命。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17354,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十七首 其六十三","author":"释原妙","text":"今朝八月一，行脚禅和出。\n不识自家珍，却向途中觅。\n直饶走遍一百一十城，参见五十三善知识，功超十地三乘，位等释迦弥勒。\n若还来到西峰，未免一棒打折你驴脊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17355,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十七首 其二十一","author":"释原妙","text":"水中咸味，色里胶青。\n决定是有，不见其形。\n见其形，失却山前一村人眼睛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17356,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十七首 其二十四","author":"释原妙","text":"布袋头开，喂驴喂马。\n要骑便骑，要下便下。\n若到江西湖南，撞著焦尾大虫，切莫道在西峰度夏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17357,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十七首 其十一","author":"释原妙","text":"爱之欲其生，恶之欲其死。\n爱恶两重关，总向遮里起。\n直饶识得根源，更买草鞋行脚三十年，何曾踏著遮里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17358,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十七首 其二十六","author":"释原妙","text":"一阳来复，万物咸新。\n恭惟盲龟跛鳖，鬼怪妖精。\n莫问前长后短，大家扶起破沙盆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17359,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十七首 其六十七","author":"释原妙","text":"红尘堆里学山居，寂灭身心道有馀。\n但得胸中憎爱尽，不参禅亦是工夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17360,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十七首 其十二","author":"释原妙","text":"师子窟，师子吼。\n师子儿，无前后。\n蓦然直下翻身，便解人前开口。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17361,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十七首 其二十","author":"释原妙","text":"禅不在参，道不须悟。\n动转施为，山岳鼓舞。\n孟八郎汉便恁么去，争似西峰搬石运土。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17362,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十七首 其四十六","author":"释原妙","text":"十五日已前，■■??，魍魍魉魉。\n十五日已后，巍巍堂堂，炜炜煌煌。\n正当十五日，虚空为鼓。\n须弥为槌，轻轻击动，佛祖攒眉。\n若将耳听应难会，眼处闻声方始知。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17363,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十七首 其六十二","author":"释原妙","text":"打开布袋头，放出百千牛。\n纵随芳草去，终不被人收。\n一日归来重会面，半含容笑半含羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17364,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十七首 其五十八","author":"释原妙","text":"一年又过一月，今日又从头起。\n循环乌兔如梭，百年光阴有几。\n诸上座，休瞌睡。\n直饶火急翻身，四大海水早已倾在汝耳里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17365,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十七首 其十七","author":"释原妙","text":"一叶落，天下秋。\n一尘起，大地收。\n有意气时添意气，不风流处也风流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17366,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十七首 其六十","author":"释原妙","text":"资生贵图求富，参禅贵图求悟。\n求悟若学资生，个个成佛作祖。\n咄，甜瓜彻蒂甜，苦瓠连根苦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17367,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十七首 其二十七","author":"释原妙","text":"黄面瞿昙，夜半成道。\n正是唤奴作郎，赢得一场好笑。\n山僧恁么告报，也是细姑嫌嫂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17368,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十七首 其九","author":"释原妙","text":"归宗拭却眼睛，二祖安心断臂。\n云门拶折一足，玄沙?破脚指。\n遮一夥随搂搜汉，蚤知有遮般消息，免见血淋满地。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17369,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十七首 其五十六","author":"释原妙","text":"识得拄杖子，被拄杖子缚。\n不识拄杖子，亦被拄杖子缚。\n不是弄潮人，徒劳遭点额。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17370,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十七首 其二十五","author":"释原妙","text":"吃粥了也，洗钵盂去。\n矢上加尖，一场败露。\n西峰今日忍俊不禁，却要向鹭鸶腿上割股。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17371,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十七首 其四十三","author":"释原妙","text":"指天指地，一棒打杀。\n鸩屎砒霜，合造毒药。\n飏在三千世界中，不知那个亲遭著。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17372,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十七首 其六十一","author":"释原妙","text":"千疑万疑，祇是一疑。\n若能决此一疑，免教节上生枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17373,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十七首 其六","author":"释原妙","text":"万里不挂片云，虚空突出一窍。\n双髻峰?跳上三十三天，拄杖子向十字街头扬声大叫。\n炎炎六月火生冰，夜半日轮当午照。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17374,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十七首 其二十八","author":"释原妙","text":"参须实参，悟须实悟。\n动转施为，辉今耀古。\n若是操心不正，悟处不真，妆妆点点，斗斗钉钉，被人轻轻拶著，未免唤灯笼作露柱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17375,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十七首 其五十七","author":"释原妙","text":"咄哉老贼，偷心未息。\n石灰布袋，到处成迹。\n若谓子为父隐，毕竟曲不藏直。\n今日因斋庆赞，未免乘时拈出。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17376,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十七首 其四十一","author":"释原妙","text":"前四十五日何处去，焦尾大虫入闹市。\n后四十五日何处来，三脚驴子上高台。\n俊鹰快鹞便合乘时，跛鳖盲龟徒劳?跳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17377,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十七首 其三十二","author":"释原妙","text":"一年已减五日，光影如驹过隙。\n直须如救头然，切莫随情放逸。\n夜来一雨雪消镕，万叠青山如洗出。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17378,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十七首 其十六","author":"释原妙","text":"忘却当年密授句，枉教一众吃辛苦。\n夜来枕上忽忆著，年年五月黄梅雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17379,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十七首 其三十七","author":"释原妙","text":"日正暄，春已暮，落花片片随流去。\n拄杖枝头一点红，馨香遍界无人顾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17380,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十七首 其三十九","author":"释原妙","text":"一年三百六十日，看看逗到今宵毕。\n十个有五双，参禅禅又不知，学道道亦不识。\n只遮不知不识四字，正是三世诸佛骨髓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17381,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十七首 其十三","author":"释原妙","text":"大限九旬，小限七日。\n粗中有细，细中有密。\n密密无间，纤尘不立。\n正恁么时，银山铁壁。\n进则无门，退之则失。\n如堕万丈深坑，四面悬崖荆棘。\n切须猛烈英雄，直要翻身跳出。\n若还一念迟疑，佛亦救你不得。\n此是最上玄门，普请大家著力。\n山僧虽则不管閒非，越例与诸人通个消息。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17382,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十七首 其五十","author":"释原妙","text":"裁蜀锦，剪吴绫。\n披白玉，间黄金。\n打成一片时，针劄不入。\n罗纹结角处，线路难寻。\n天香影散莓苔石，五叶花开薝卜林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17383,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十七首 其二十九","author":"释原妙","text":"低头觅天，仰面寻地。\n波波挈挈，远之远矣。\n蓦然撞著徐十三郎，嗄，元来只在遮里。\n在遮里，腊月三十日到来，也是开眼见鬼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17384,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十七首 其三十八","author":"释原妙","text":"一夏以来，诸人懡㦬，山僧亦懡㦬。\n懡㦬逢懡㦬，彼此无空过。\n今朝圣制告圆，不免更说些懡㦬禅，赢得大家俱懡㦬。\n如何是懡㦬禅，咄，猛火著油煎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17385,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十七首 其二","author":"释原妙","text":"有一物，明历历。\n佛祖觑不破，大地无人识。\n常在舌头尖，尽力吐不出。\n吐得出，也是胡饼里呷汁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17386,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十七首 其五十二","author":"释原妙","text":"万法归一，一归何处。\n狭路相逢，两手分付。\n逴得便行，黄河三千年一度清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17387,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十七首 其四十九","author":"释原妙","text":"一不成，二不是。\n红底桃，白底李。\n红红白白不相瞒，因甚达磨大师被流支三藏打落当门齿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17388,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十七首 其三十三","author":"释原妙","text":"参禅须是铁汉，著手心头便判。\n只如雪覆千山，孤峰不白，作么生判。\n上元定是正月半。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17389,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十七首 其一","author":"释原妙","text":"谈玄谈妙，说性说心。\n攒花簇锦，巧妙尖新。\n如麻似粟，从古至今。\n莫不皆是乘虚接响底汉，倚草附木精灵。\n山僧虽是他家种草，决定不向遮里藏身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17390,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十七首 其三","author":"释原妙","text":"有句无句，金乌吞玉兔。\n如藤倚树，癞马系枯椿。\n树倒藤解，一冬烧不尽。\n句归何处，石虎当途踞。\n呵呵大笑，龙头蛇尾。\n捺倒烂泥里，刚刀不斩无罪之人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17391,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十七首 其六十六","author":"释原妙","text":"万法归一一何归，只贵惺惺著意疑。\n疑到情忘心绝处，金乌夜半彻天飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17392,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十七首 其四","author":"释原妙","text":"千岭万山雪，五湖四海冰。\n清光成一片，物物尽皆明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17393,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十七首 其七","author":"释原妙","text":"一夏九十日，看看又将半。\n面门无位人，急著眼睛看。\n冷地蓦相逢，脚跟红线断。\n掌内握乾坤，翻身游碧汉。\n堪笑当年老瑞岩，惺惺石上重呼唤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17394,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十七首 其三十五","author":"释原妙","text":"身贫道贫，无法可亲。\n一味盲枷瞎棒，闻者见者莫不生嗔。\n黄金自有黄金价，终不和沙卖与人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17395,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十七首 其四十","author":"释原妙","text":"封却拄杖头，结却布袋头。\n大家团栾头，赤眼火柴头。\n嗄，正是冤家共聚头，不妨头上更安头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17396,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十七首 其四十二","author":"释原妙","text":"巴陵设忌三转语，西峰单单只一句。\n聻，逢人切忌错举。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17397,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十七首 其十九","author":"释原妙","text":"阴向鼻端灭，阳从眼里生。\n会得个中意，更参三十年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17398,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十七首 其三十六","author":"释原妙","text":"西峰今年结夏，全然不成保社。\n一日两头薄粥，大家忍饥无暇。\n虽有真如佛性，菩提涅槃，权且飏在师子岩下。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17399,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十七首 其六十五","author":"释原妙","text":"参禅一著莫迟疑，念念如同救火时。\n烈燄亘天浑不顾，翻身直造万重围。\n一朝火灭烟消后，鼻孔依前向下垂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17400,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十二首 其五","author":"释原妙","text":"五阴山中，魔强法弱。\n战之不胜，休拟议著。\n宝剑全提，莫问生杀。\n奋不顾身，星飞火撒。\n有功者赏，无功者罚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17401,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十七首 其五十三","author":"释原妙","text":"意句不到，宗说不通，盲龟跛鳖。\n意句俱到，宗说俱通，盲龟跛鳖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17402,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十七首 其四十七","author":"释原妙","text":"入我法中，不论凡圣。\n动转施为，咸遵旧令。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17403,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十七首 其二十三","author":"释原妙","text":"大海无鱼，大地无草。\n大富无粮，大悟无道。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17404,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人请赞 其一","author":"释原妙","text":"遮个村僧，只好闻名。\n尾巴才露，天下人憎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17405,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十七首 其四十八","author":"释原妙","text":"九旬把定重关，今朝放开一线。\n顶门具眼衲僧，自合知机识变。\n依旧平分局面。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17406,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]