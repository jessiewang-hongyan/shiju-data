[{"title":"雨后微阴光景益奇复得长句","author":"陆游","text":"结辙轩车已扫空，挥犀谈笑与谁同。\n日消浅醉闲吟里，春在轻阴薄霭中。\n百尺游丝喜风定，一双新燕说泥融。\n天工只费须臾力，开遍东阑半丈红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8945,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨后露坐小酌","author":"陆游","text":"闭门谁与乐颓年，旋扫桐阴近酒边。\n病久一春稀见蝶，雨多六月始闻蝉。\n官仓求饱真聊尔，山墅怀归每惘然。\n从此读书仍复懒，惟留白眼望青天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8946,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨夜","author":"陆游","text":"吴中地多雨，海角客常愁。\n羸疾须医药，残年忆辈流。\n解装孤驿晚，捩柁小江秋。\n莫起潇湘兴，无才赋远游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8947,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨后二首 其一","author":"陆游","text":"镜湖归隐老黄冠，布褐萧然一室宽。\n灯影青荧人未睡，雨声点滴夜将阑。\n四朝出处朋侪尽，半世漂流骨相寒。\n青史无名端可耻，著书留与后人看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8948,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨夜","author":"陆游","text":"百紫千红占岁华，又随风雨捲泥沙。\n即今空有梦为蝶，当日曾将命乞花。\n倦枕残灯人寂寞，幽窗小草字攲斜。\n悲欢变灭何穷已，学得山僧自一家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8949,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨夜","author":"陆游","text":"暮雨濯残热，史官非坐曹。\n忍惭靡粟帛，偷暇近诗骚。\n屋老孤灯闇，风颠万木号。\n明朝有奇事，江阁看秋涛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8950,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨夜","author":"陆游","text":"急雨如河泻瓦沟，空堂卧对一灯幽。\n老鸡多事彊知晓，落叶无情先报秋。\n身未盖棺谁可料，尊常有酒莫闲愁。\n功名老大从来事，且复长歌起饭牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8951,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨夜","author":"陆游","text":"小雨初凉夜，残灯欲暗时。\n病多愁近酒，心弱怯题诗。\n旧友殊方少，归耕晚岁宜。\n回头语孤影，此意有君知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8952,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨夜","author":"陆游","text":"小雨收仍落，孤灯翳复明。\n衰残书易忘，忧患梦多惊。\n熠熠萤矜暗，翻翻雀转更。\n闭门行老死，亦足慰平生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8953,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨夜","author":"陆游","text":"羸躯对影怆馀龄，追念平时只自惊。\n夏木正浓桐叶坠，秋风未起草虫鸣。\n蠹鱼似是三生业，汗马难希百世名。\n小雨迎凉何所作，北窗还对短灯檠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8954,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨夜","author":"陆游","text":"北风吹雨乱疏钟，蔌蔌灯花破碎红。\n孤梦正行天一握，高城俄报鼓三通。\n衰迟空抱屠龙技，豪俊谁收汗马功。\n但愿舆图早来复，白头敢望起云中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8955,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨夜","author":"陆游","text":"岁晚茆茨劣自容，齿摇将脱发将童。\n心游万里关河外，身卧一窗风雨中。\n医不可招惟忍病，书犹能读足忘穷。\n夜阑睡觉蛩声里，时见灯花落碎红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8956,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨夜","author":"陆游","text":"断岸轻烟著柳条，孤村小雨夜萧萧。\n荒鸡隔浦声相续，短烛无风焰自摇。\n朴学元知縻岁月，残生竟是老渔樵。\n最怜鬓畔千茎雪，日日春风吹不消。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8957,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨夜","author":"陆游","text":"细雨催扃户，昏灯照拥衾。\n倦知秋漏永，瘦怯晓寒深。\n林鹊依檐宿，莎虫入户吟。\n此时搔短发，谁会欲归心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8958,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨夜","author":"陆游","text":"末路萧条客子心，不堪徂岁更沉阴。\n低檐雨滴睡眠少，败壁灯残感慨深。\n不办典衣谋尽醉，尚能拥鼻作微吟。\n交朋一散如天远，试向今宵梦里寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8959,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨夜有怀张季长少卿","author":"陆游","text":"放翁虽老未忘情，独卧山村每自惊。\n鼎鼎百年如电速，寥寥一笑抵河清。\n梅初破藟行江路，灯欲成花听雨声。\n正用此时思剧饮，故交零落怆馀生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8960,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨夜观史","author":"陆游","text":"读书雨夜一灯昏，叹息何由起九原。\n邪正古来观大节，是非死后有公言。\n未能剧论希扪虱，且复长歌学叩辕。\n它日安知无志士，经过指点放翁门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8961,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨夜作","author":"陆游","text":"十月多蚊蚋，昏昏气未平。\n正须三日雨，却用一霜晴。\n闲馆萧条意，空阶点滴声。\n钟残抚枕叹，归梦几时成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8962,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨夜怀唐安","author":"郑獬","text":"归心日夜逆江流，官柳三千忆蜀州。\n小阁帘栊频梦蝶，平湖烟水已盟鸥。\n萤依湿草同为旅，雨滴空阶别是愁。\n堪笑邦人不解事，区区犹借陆君留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8963,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨夜思子虡","author":"陆游","text":"兀兀过遥夜，悠悠拥破衾。\n峭寒侵病骨，残雨滴愁心。\n人别易千里，书来真万金。\n醉眠差似可，谁与伴孤斟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8964,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨夜读书","author":"陆游","text":"农家冬少事，无地肆吾勤。\n急雨生新健，陈编寄一欣。\n高风感莘渭，善治仰华勋。\n老死今朝夕，何由诵所闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8965,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨夜起行室中","author":"陆游","text":"老疾逢秋体自轻，披衣暂起绕床行。\n隙风不断灯将灭，檐雨如倾阶欲平。\n鳏叟何尝愁枕冷，病夫未免待窗明。\n拂书洗砚龟堂上，幽事谁知日有程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8966,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨夜偶书","author":"陆游","text":"高卧空堂风雨来，更阑频看烛花摧。\n新凉萧爽秋期近，多病侵寻老境催。\n万事极知终变灭，一官那得久低回。\n床头幸有楞伽在，更炷炉香手自开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8967,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨夜排闷二首 其二","author":"陆游","text":"村巷时时雨，江城夜夜砧。\n沉忧羁客梦，孤愤远臣心。\n身病常须药，囊空未赎琴。\n明朝镜中发，饱受雪霜侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8968,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨夜排闷二首 其一","author":"陆游","text":"羸病愁灯影，羁怀怯雨声。\n新秋忽已半，垂老若为情。\n金印儿嬉事，青编身后名。\n何如破窗下，袖手送馀生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8969,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨夜感怀","author":"陆游","text":"点滴空阶雨送凉，青灯对影独凄伤。\n身如病木惊秋早，心似鳏鱼怯夜长。\n铸得黄金犹有术，扫空白发定无方。\n萧然禅榻君休笑，一卷残书伴枕傍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8970,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨复作自近村归","author":"陆游","text":"夜听萧萧未涨溪，朝行㶁㶁已成泥。\n可怜鸠取招麾速，谁似云知出处齐。\n野菊枝长半狼藉，江枫叶落正凄迷。\n行人也识龟堂老，小榼村醪手自携。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8971,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨凉小饮戏作","author":"陆游","text":"孤村小院雨输凉，团扇流尘簟避床。\n蛩思感秋吟坏壁，萤光乘暗绕高梁。\n巾箱字细成褫懒，閤醁杯深断送狂。\n坐睡觉来人已散，帘栊时度玉簪香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8972,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨雪久无来客亦不能出作长句排闷","author":"陆游","text":"造物无情岂我私，从来不使堕危机。\n青云路近常排去，白浪堆高亦脱归。\n残稿尚存空自许，故人略尽欲谁依。\n新春雪暗山村路，且复焚香独掩扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8973,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨晴","author":"陆游","text":"久雨作我病，今朝身顿轻。\n花房避初旭，帘影弄新晴。\n漉酒纶巾折，听琴拄杖横。\n翛然又终日，未觉负平生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8974,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨晴","author":"陆游","text":"旱暵常思雨，沉阴却喜晴。\n放船莲荡远，岸帻竹风清。\n淮浦戎初遁，兴州盗甫平。\n为邦要持重，恐复议消兵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8975,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨晴","author":"陆游","text":"小雨初增气惨凄，新晴差解病沉迷。\n虚廊静院听松籁，细草甘泉养鹿麛。\n寒霭细分山远近，野歌相应路高低。\n孰知倦客萧然意，水品茶经手自携。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8976,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨晴","author":"陆游","text":"闲曳枯筇自在行，曲廊小阁赏新晴。\n幽禽叶底吟风久，残雨枝间照日明。\n茶映盏毫新乳上，琴横荐石细泉鸣。\n亦知老健终难恃，且复萧然得此生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8977,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨晴游洞宫山天庆观坐间复雨","author":"陆游","text":"近水松篁锁翠微，洞天宫殿对清晖。\n快晴似为酴醾计，急雨还妨燕子飞。\n道士昼闲丹灶冷，山童晓出药苗肥。\n拂床不用勤留客，我困文书自怕归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8978,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨霁","author":"陆游","text":"一雨洗炎蒸，危阑偶独凭。\n凉飔生萃蔡，爽气入鬅鬙。\n庭下宵游燐，盘中昼扫蝇。\n绝胜尘土里，马上嚼寒冰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8979,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨霁","author":"陆游","text":"雨霁禽鱼乐，风生草木香。\n老惊时易失，闲觉日偏长。\n閤閤蛙何怒，翩翩蝶许忙。\n闭门真得计，切勿变轩昂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8980,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨霁春色粲然喜而有赋","author":"陆游","text":"应接年光老渐慵，犹能一饮百分空。\n半沾蝶粉帘栊雨，远送莺声巷陌风。\n千缕曲尘杨柳绿，万枝猩血海棠红。\n从来造物陶甄手，却在闲人诗句中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8981,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨霰作雪不成大风散云月色皎然","author":"陆游","text":"数间茅屋寄蓬蒿，天遣来归息我劳。\n月可一庭陈素练，风酣万木起惊涛。\n病侵齿发才虽尽，酒挟江山气尚豪。\n安得人间掣鲸手，共提笔阵法庄骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8982,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"青羊宫小饮赠道士","author":"陆游","text":"青羊道士竹为家，也种玄都观里花。\n微雨晴时看鹤舞，小窗幽处听蜂衙。\n药垆宿火荧荧暖，醉袖迎风猎猎斜。\n老我一官真漫浪，会来分子淡生涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8983,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"青城大面山中有二隐士一曰谯先生定字天授建炎初以经行召至扬州欲留之讲筵不可拜通直郎直秘阁致仕今百三十馀岁巢居崄绝人不能到而先生数年辄一出至山前人有见之者其一曰姚太尉平仲字希晏靖康初在围城中夜将死士攻贼营不利骑骏骡逸去建炎初所在揭榜以观察使召之竟不出淳熙甲午乙未间乃或见之于丈人观道院亦年近九十紫髯长委地喜作草书盖皆得道于山中云偶成五字二首托上官道人寄之 其一 寄谯先生","author":"陆游","text":"寄谢谯夫子，今年一出无。\n万缘随梦断，百念与形枯。\n云护巢松谷，神呵煅药炉。\n凭高应念我，白首学徵租。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8984,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"青城县会饮何氏池亭赠谭德称","author":"陆游","text":"赤日黄尘行路难，青城县里得偷闲。\n十年去国悲霜鬓，六月登楼望雪山。\n醉客千言犹落笔，美人斗酒未酡颜。\n凭谁唤住谭夫子，更与徘徊水石间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8985,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"青溪道中行古松间因少留瀹茶而行","author":"陆游","text":"露湿青松细细香，旋呼拄杖踏斜阳。\n三生旧发游山愿，一卷新传辟谷方。\n云外未论笙鹤近，尘中实厌簿书忙。\n拾樵汲涧俱清绝，聊为煎茶一据床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8986,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"饱食","author":"陆游","text":"饱食无功愧汗青，灯前顾影叹伶俜。\n马衰犹养疑知路，龟久当捐为不灵。\n腰下徒誇绶若若，镜中何止发星星。\n石帆回首初非远，要及清秋斸茯苓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8987,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"驿亭小憩遣兴","author":"陆游","text":"淡日微云共陆离，曲阑危栈出参差。\n老松临道阅千载，杜宇号山连四时。\n汉水东流那有极，秦关北望不胜悲。\n邮亭下马开孤剑，老大功名颇自期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8988,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"驿壁偶题三首 其二","author":"陆游","text":"去去投山驿，悠悠解橐装。\n斜阳穿破厩，落叶满空廊。\n舞简村巫醉，涂朱野女妆。\n近行吾亦倦，假寝据胡床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8989,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"驿壁偶题三首 其一","author":"陆游","text":"累累驿门堠，杳杳寺楼钟。\n叶落树阴薄，云生山崦重。\n交亲穷未弃，父子老相从。\n惟待新粳熟，高眠听夜舂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8990,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"驿壁偶题三首 其三","author":"陆游","text":"过市未十里，入山知几重。\n幽林闻格磔，浅濑见噞喁。\n小瓮家家酒，衡门世世农。\n班生定痴绝，辛苦觅侯封。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8991,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鱼池将涸车水注之","author":"陆游","text":"清波溜溜入新渠，邻曲来观乐有馀。\n试手便同三日雨，满陂已活十千鱼。\n喜如雷动风行际，快若天开地辟初。\n万物但令俱有托，吾曹安取爱吾庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8992,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"临安春雨初霁","author":"陆游","text":"世味年来薄似纱，谁令骑马客京华。\n小楼一夜听春雨，深巷明朝卖杏花。\n矮纸斜行闲作草，晴窗细乳戏分茶。\n素衣莫起风尘叹，犹及清明可到家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8993,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"亲旧书来多问近况以诗荅之","author":"陆游","text":"耐辱推颓百不能，居然老病住庵僧。\n流年速似一弹指，更事多于三折肱。\n庭树影中闻夜汲，邻机声里对寒灯。\n沈诗任笔俱忘尽，酒户新来却少增。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8994,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"亲旧见过多见贺强健戏作此篇","author":"陆游","text":"偶向人间脱骇机，玉池中夜自生肥。\n据鞍马援虽堪笑，强饭廉颇亦未非。\n道貌安能希睟盎，世缘但可付猗违。\n它年不死君须记，会在天津看落晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8995,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"亲旧或见嘲终岁杜门戏作解嘲","author":"陆游","text":"十年萧散住林间，只是幽居不是闲。\n续得茶经新绝笔，补成僧史可藏山。\n诗题紫阁凭云寄，药报青城附鹤还。\n自笑何曾总无事，枉教人道闭柴关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8996,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"信步近村","author":"陆游","text":"端闲何以永今朝，拈得筇枝度野桥。\n三亩空园喧啄木，十寻高树络凌霄。\n长饥未必缘诗瘦，多闷惟须赖酒浇。\n兴尽归来又陈迹，一林风叶暮萧萧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8997,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"养气","author":"陆游","text":"学道先养气，吾闻三住章。\n屏除金鼎药，糠秕玉函方。\n凛凛春冰履，兢兢拱璧藏。\n高谈忘力守，此病最膏肓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8998,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"养气","author":"陆游","text":"养气安心不计年，未尝一念住愁边。\n才疏屡扫朝中迹，命薄翻成世外缘。\n耐老尚能消劫石，放狂聊复醉江天。\n饱知句曲罗浮路，不访初平即稚川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8999,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"养生","author":"陆游","text":"西游曾受养生书，晚爱烟波结草庐。\n两眦神光穿夜户，一头胎发入晨梳。\n邀云作伴远忘返，与鹤分窠宽有馀。\n占尽世间闲事业，任渠千载笑迂疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9000,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"养生","author":"陆游","text":"受廛故里老为氓，三十馀年学养生。\n倩盼作妖狐未惨，肥甘藏毒酖犹轻。\n忠言何啻千金药，赤口能烧万里城。\n陋巷藜羹心自乐，傍观虚说傲公卿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9001,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冒雨登拟岘台观江涨","author":"陆游","text":"雨气分千嶂，江声撼万家。\n云翻一天墨，浪蹴半空花。\n喷薄侵虚阁，低昂泛断槎。\n壮游思夙昔，乘醉下三巴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9002,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"前诗感慨颇深犹吾前日之言也明日读而悔之乃复作此然亦未能超然物外也","author":"陆游","text":"身世今如一老僧，病馀残发雪鬅鬙。\n湖桑埭下渔舟雨，道树山前野店灯。\n涧水潺湲供洗钵，松风萧飒入行縢。\n世人欲觅何由得，觌面相逢唤不应。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9003,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"勉学","author":"陆游","text":"学力艰危见，精诚梦寐知。\n众人虽莫察，吾道岂容欺。\n雷雨含元气，蓍龟决大疑。\n为儒能体此，端不负先师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9004,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南门晚眺","author":"陆游","text":"奚奴前负一胡床，门巷楸梧已渐黄。\n不历尘埃三伏热，孰知风露九秋凉。\n萧萧浦溆渔歌晚，漠漠陂塘稻穗香。\n勿恨行云吞素月，梦回正爱雨淋浪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9005,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南池","author":"陆游","text":"二月莺花满阆中，城南搔首立衰翁。\n数茎白发愁无那，万顷苍池事已空。\n陂复岂惟民食足，渠成终助霸图雄。\n眼前碌碌谁知此，漫走丛祠乞岁丰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9006,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南园四首 其一","author":"陆游","text":"晓莺催系柳边舟，老陌东风拂面柔。\n客里又惊春事晚，梦中重续栝苍游。\n欢情饮量年年减，古寺名园处处留。\n却羡少年轻岁月，角声如此不知愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9007,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南园四首 其二","author":"陆游","text":"南游云海叹茫茫，又泛归舟到栝苍。\n城郭凄凉叹辽鹤，鬓毛萧飒点吴霜。\n酴醾可把春无几，弦索初陈燕未央。\n楼下清溪三百里，溪流不似客愁长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9008,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南园观梅","author":"陆游","text":"小岭清陂寂寞中，绿樽岁晚与君同。\n高标赖有诗人识，绝艳真穷造物工。\n正喜参差横夜月，又惊零落付春风。\n老谙世事宁多叹，身自人间一转蓬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9009,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]