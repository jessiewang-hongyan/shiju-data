"commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61910,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"建宁解归寄雪峰因大梦","author":"李昴英","text":"行脚今朝又起单，欣然归去得安闲。\n从前大梦难忘处，上白云山望雪山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61911,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"罗浮桃源峒","author":"李昴英","text":"灵符锁尽穴中蛇，深入千岩处士家。\n峒户隔云呼不应，时时流水出桃花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61912,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"罗浮梁弥仙游烂柯山赠以曲筇方笠","author":"李昴英","text":"葛坡龙竹东坡笠，合伴山人到洞天。\n柯烂想应留斧在，凭君试问石桥仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61913,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"采阳轩","author":"李昴英","text":"看尽西园十里梅，黄昏寒月趁人回。\n要圆一段清游事，更访仙宫索茗杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61914,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨行梅关二首 其二","author":"李昴英","text":"通宵雨滴急催梅，枝北枝南晓尽开。\n多谢花神好看客，随车十里雪香来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61915,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨行梅关二首 其一","author":"李昴英","text":"浓岚四合冻云痴，水墨连屏斗崛奇。\n冲雨此行风景别，满山翠滴水帘垂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61916,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"表释应端住兴化寺以其说而勉之二首 其二","author":"李昴英","text":"一般奇怪弄精魂，猪蚬皆餐针戏吞。\n未到空通渠地位，只当斋戒作沙门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61917,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"表释应端住兴化寺以其说而勉之二首 其一","author":"李昴英","text":"钵中滴水也难消，切莫贪他寺富饶。\n留取大皮缠大树，腹围紧紧篾三条。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61918,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南华寺五首 其五","author":"李昴英","text":"清者何曾饮盗泉，僧盂底饭逆巢田。\n此疑欲问师无语，风撼长松啸半天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61919,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南华寺五首 其四","author":"李昴英","text":"未参五祖已开山，合下全身此地安。\n不是香烟忘故里，衣留孔道要人看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61920,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南华寺五首 其三","author":"李昴英","text":"从前梵说堕虚空，独有坛经说不同。\n体用圆明皆宝相，一丁不识却心通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61921,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南华寺五首 其二","author":"李昴英","text":"西方骨董南方宝，留镇曹溪几百年。\n自是后人当不得，有如翁者亦单传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61922,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南华寺五首 其一","author":"李昴英","text":"诵经听得入从门，壁上偷他四偈言。\n毕竟单传端的处，卖薪供母是心源。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61923,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"峡山诗","author":"李昴英","text":"山通一水径皇都，多少英豪出此途。\n传我飞来元羽翼，好风吹送过天衢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61924,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪封寺二首 其二","author":"李昴英","text":"征舆六月度梅关，大地清凉树影班。\n行客不须梅止渴，流泉到耳冷潺潺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61925,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪封寺二首 其一","author":"李昴英","text":"凿通危石张文献，勘破禅关卢祖师。\n奇事已堪誇北客，梅花先暖亦南枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61926,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"子先宗友试兰省送以小诗","author":"李昴英","text":"毫端五色织成章，皎皎清标月照梁。\n再战文场推定霸，一经书法首尊王。\n鞭扬庾岭梅花早，梯上寒宫桂籍香。\n师道自居吾岂敢，所期竹帛远流芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61927,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山寺夜起看月","author":"李昴英","text":"丙夜忽窗白，披衣起凭栏。\n山川如昼见，松桧照人寒。\n孤鹤欬屋脊，群僧鼾纸单。\n灯前呼老佛，妙境许同观。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61928,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山行","author":"李昴英","text":"尘中事日生，拨剔且山行。\n襆被欣然出，登车趣便清。\n奴收携蜡屐，客请带棋枰。\n才过城闉外，耳根无市声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61929,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中秋无月","author":"李昴英","text":"已孤前度一中秋，满望今宵月下游。\n药杵放闲灵兔懒，镜奁掩却素娥愁。\n知谁有术擎梯取，枉费当年弄斧修。\n天靳清明每如此，樽前休恨翳云浮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61930,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"云关观月","author":"李昴英","text":"山间未晚先得月，料想城中见较迟。\n海吐银蟾渐呈露，林垂翠影早参差。\n孤轮涵涧安禅处，明镜当空沉籁时。\n夜半衰翁犹独坐，清光吸尽入诗脾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61931,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"云泉亭","author":"李昴英","text":"绝顶郁其前，寒崖喷玉泉。\n亭成山补阙，境胜我搀先。\n树杪江天接，榕根石磴悬。\n赏心遂连日，合为智仙传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61932,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"代送丘漕迪哲","author":"李昴英","text":"假帅如公自古无，邦人久矣望锋车。\n政声难掩诸公说，明主周知万里馀。\n豹尾鸡翘那欠此，莼羹鲈鲙且归欤。\n江头鼓动江船去，喜气欢声动里闾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61933,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"四月十五游僧寺","author":"李昴英","text":"今日快逢僧结夏，不妨乘兴扣禅扉。\n山垂远瀑溪声急，风捲痴云雨脚稀。\n囊锦诗成僧借看，纹楸棋落鸟惊飞。\n此来莫讶凭栏久，杰阁新成拂翠微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61934,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用人韵送梅纠梁现","author":"李昴英","text":"征鞍风软踏香尘，又送斯人南海濒。\n纠郡正资宾画重，洗冤须放笔头春。\n勉期圣处功夫到，肯学世间儿女颦。\n五瘴由心今一洗，笑渠辟瘴嚼人频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61935,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用前韵送潘上舍","author":"李昴英","text":"谦为贤业址，取履卜封留。\n笔下千钧弩，胸中万斛舟。\n椿庭闻诲语，米廪友名流。\n连捷归蓝绶，邻翁好话头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61936,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]