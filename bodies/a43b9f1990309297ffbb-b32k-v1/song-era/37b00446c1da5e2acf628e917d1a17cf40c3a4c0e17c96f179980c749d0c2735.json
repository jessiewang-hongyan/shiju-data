[{"title":"挽胡季昭 其一","author":"李庭芝","text":"绿鬓两科好，丹心一片忠。\n言言关国体，蹇蹇匪渠躬。\n谁谓鸳行底，能持鲠论公。\n象台死得所，万古忆清风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61862,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽胡季昭 其二","author":"李庭芝","text":"玉李当春孟，公书以讣闻。\n但期同气骨，不作异乡坟。\n岂料鳞音后，俄传蝶梦云。\n想教宁越水，恨不识朱云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61863,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题万年宫","author":"李彦方","text":"日华晴射武夷峰，湛碧溪流照玉骢。\n行郡敢辞千里路，祝釐先拜万年宫。\n山川历历神仙境，民物熙熙太古风。\n笑领霞觞云子酒，姓名留在洞天中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61864,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"云山","author":"李思聪","text":"水石光涵千里色，川林阴翠湿芝兰。\n杏花坞接投龙洞，瀑溅苍崖鹤骨寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61865,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金城山","author":"李思聪","text":"杏花洞天路崎岖，曾见千年石斛奴。\n试问金城山里事，只言仙境似蓬壶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61866,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"朱陵洞","author":"李思聪","text":"灵峰七十二巑岏，紫盖芙蓉杳霭间。\n影浸潇湘盘地脉，秀擎翼轸插天关。\n真君玉册光千古，赤帝璇宫镇八蛮。\n好比吾皇大椿算，万年松在最高山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61867,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"李拱","text":"琴弹终日得古调，印锁经秋带藓痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61868,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其三","author":"李拱","text":"雨后有人耕绿野，月明无犬吠花村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61869,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"李拱","text":"犬眠花影地，牛牧雨声坡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61870,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"人月圆令","author":"李持正","text":"小桃枝上春风早，初试薄罗衣。\n年年乐事，华灯竞处，人月圆时。\n禁街箫鼓，寒轻夜永，纤手重携。\n更阑人散，千门笑语，声在帘帏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61871,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明月逐人来","author":"李持正","text":"星河明淡。\n春来深浅。\n红莲正、满城开遍。\n禁街行乐，暗尘香拂面。\n皓月随人近远。\n天半鳌山，光动凤楼两观。\n东风静、珠帘不卷。\n玉辇待归，云外闻弦管。\n认得宫花影转。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61872,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹭","author":"李春伯","text":"春暗汀洲杜若香，风飘公子白霓裳。\n碧天片片忽飞去，何处人家水满塘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61873,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"木芙蓉","author":"李春伯","text":"甚疑牡丹丛，但病皮骨老。\n不宜入水看，只可隔水眺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61874,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭张元吉","author":"李春叟","text":"时平持论易，世否见才难。\n孤柱支颠厦，危船上急滩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61875,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽赵秋晓 其七","author":"李春叟","text":"森森兰玉出庭闱，突过燕山桂五枝。\n六逸风流谁得似，君家个个是麟儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61876,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽赵秋晓 其一","author":"李春叟","text":"秀出天潢一派来，广寒早折桂枝回。\n生前笑破春风面，尽把浮名付酒杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61877,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽赵秋晓 其六","author":"李春叟","text":"五十年间富贵中，生来玉树饱春风。\n买臣晚贵成何事，那得全归似此翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61878,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽赵秋晓 其四","author":"李春叟","text":"箧中遗藁墨犹新，门外池塘草自春。\n邻笛一声肠欲断，骚坛失却倚楼人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61879,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽赵秋晓 其二","author":"李春叟","text":"蓦地刚风折羽翰，懒将勋业镜中看。\n时危羞佩黄金印，乍可无毡作冷官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61880,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽赵秋晓 其三","author":"李春叟","text":"百尺楼中眼孔高，气吞馀子等儿曹。\n才名赫赫天公妒，罚作人间诗酒豪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61881,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题云溪寺","author":"李春叟","text":"杖屦前溪踏晓霜，僧茶那定搅饥肠。\n不如乘此清风去，觅取留侯辟谷方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61882,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"文丞相兵挫循州诗以迓之","author":"李春叟","text":"手持兵甲挽天河，铁石心肝尚枕戈。\n宾客三千毛遂少，将军百万李陵多。\n风波如此子焉往，天道不然人奈何。\n岭海书生今已老，天涯无石为君磨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61883,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"钓鳌台","author":"李春叟","text":"谁把渔竿老渭滨，拨开尘鞅对清薰。\n乾坤浩荡台非旧，湖海凄凉我接君。\n有客携家来上冢，无人载酒共论文。\n山阴兴尽空归去，何处天风落五云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61884,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送熊飞将军赴文丞相麾下","author":"李春叟","text":"龙泉出匣鬼神惊，猎猎霜风送客程。\n白发垂堂千里别，丹心报国一身轻。\n划开云路冲牛斗，挽落天河洗甲兵。\n马革裹尸真壮士，阳关莫作断肠声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61885,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登粤秀山","author":"李春叟","text":"宇宙皇图远，山川霸气收。\n唯馀汉时月，犹照越台秋。\n天迥明城树，云空敛海楼。\n清光对尊酒，莫作古今愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61886,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽赵秋晓 其五","author":"李春叟","text":"世上纷纷白首翁，老天何独死英雄。\n想应仙魄乘风去，犹在蓬莱第一峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61887,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书用师庵","author":"李昭述","text":"架泉龛石搆幽栖，竹树阴森锁翠微。\n珍重支郎得高趣，一庵一榻自忘机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61888,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送张待制知越","author":"李昭述","text":"严助厌承明，东南抗使旌。\n箕裘汉相子，屏翰越王城。\n胜概须留赏，仙舟莫计程。\n湖光八百里，风月有馀清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61889,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"弋阳郑氏翠麓亭","author":"李昴英","text":"管领寒溪揖怪峰，径穿钜竹绿阴浓。\n幽人去后无猿鹤，冷落亭台湿藓封。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61890,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书龙头义约簿二首 其二","author":"李昴英","text":"雕鹗联翻二十名，看看金榜是同盟。\n河南人面分明见，尽说龙头谶已成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61891,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书龙头义约簿二首 其一","author":"李昴英","text":"桂菊风香造榜天，门标捷帜地流钱。\n笔端快便行年顺，骑鹤缠腰身两全。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61892,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"古成之仙箕","author":"李昴英","text":"翁来灵笔舞龙蛇，翁去瑶坛锁暮霞。\n旧事欲谈三百载，五云阁上望仙槎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61893,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"司法曾子美新第荣归欲得余诗不敢效世俗谀语二首 其二","author":"李昴英","text":"舌似河悬笔水翻，春官首疏见忠肝。\n士须卓尔名当世，好取前修节行看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61894,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"司法曾子美新第荣归欲得余诗不敢效世俗谀语二首 其一","author":"李昴英","text":"里同清献久闻风，耿耿胸中便不同。\n一疏叫云韦布日，大廷对策想输忠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61895,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"白云狮子峰望罗浮","author":"李昴英","text":"不到罗浮瞥六年，后期几误铁桥仙。\n远云不隔山真面，西麓原同第七天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61896,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"众建莲社堂求疏语","author":"李昴英","text":"远公鼻孔著莲香，引得喃喃鬨几场。\n供佛建庵人更错，参机元不在西方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61897,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戏题罗浮梁弥仙写真","author":"李昴英","text":"八十童颜双眼明，浪游湖海一身轻。\n莫将啖肉先生比，个是罗浮老树精。","collection":"宋","notice