[{"title":"赠广宣大师","author":"范仲淹","text":"忆昔同游紫阁云，别来三十二回春。\n白头相见双林下，犹是清朝未退人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35027,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"无题","author":"范仲淹","text":"江南有美人，别后长相忆。\n何以慰相思，赠汝好颜色。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35028,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中秋旅怀","author":"释尚能","text":"所畜惟骚雅，兼之得固穷。\n望乡连北斗，听雨带西风。\n稼穑村坊远，烟波路径通。\n冥搜清绝句，恰似有神功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35029,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"邵焕","text":"船官风破浪，关吏鼓通晨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35030,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"胡僧","text":"何事将军封万户，却教红粉去和戎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35031,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"古瓦砚诗 其二","author":"晏殊","text":"已恣玉锋磨藓骨，更持蟾泪湿云根。\n欲知千载凄凉意，尚有昭阳夜雨痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35032,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"社日","author":"晏殊","text":"山郡多暇日，社时放吏归。\n坐阁独成闷，行塘阅清辉。\n春风动高柳，芳园掩夕扉。\n遥思里中会，心绪怅微微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35033,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其十九","author":"晏殊","text":"闲思北海银宫畔，谁驾丹山白凤凰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35034,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"宋绶","text":"四时常有烟棚合，三月犹无菜甲生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35035,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其五","author":"宋绶","text":"江涵帝子翚飞阁，山际真君鹤驭天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35036,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其八","author":"宋绶","text":"海国瓯乡浙水东，暂烦良守此凭熊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35037,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"剑联句","author":"欧阳修","text":"圣人作神兵，以定天下厄。\n蚩尤发灵机，干将构雄绩。\n橐籥天地开，炉冶阴阳辟。\n南帝输火精，西皇降金液。\n炎炎昆冈荧，汹汹洪河擘。\n雷霆助意气，日月沦精魄。\n神气不在大，错落就三尺。\n直淬灵溪泉，横磨太行石。\n雄雌威并立，昼夜光相射。\n提携风云生，指顾烟霞寂。\n坚刚正人心，耿介志士迹。\n初疑成夏鼎，魑魅世所适。\n又若引吴刀，犀象谓无隔。\n截波虬尾滑，脱浪鲸牙直。\n顽冰挂阴霤，皎月乘孤隙。\n河角起彗气，云罅露秋碧。\n晓镡星斗烂，夜匣飞龙宅。\n舞酣霰雪回，弹俊球琳击。\n鲜摇霅水光，腻刮湘山色。\n青蛟渴雨瘦，素虺蟠霜瘠。\n清音锵以鸣，寒姿坚且泽。\n鬼类丧影响，佞党摧肝膈。\n一旦会神武，四海屠凶逆。\n周王奉天讨，商郊千里赤。\n楚子扬军声，秦师万首白。\n祥辉冠吴楚，杀气横燕易。\n与君斩鳌足，八极停震虩。\n与君刜鹏翼，三辰增焕赫。\n莫使化猿翁，辱我为幻惑。\n莫使暴虎人，屈我执仇敌。\n尊严俟冠冕，左右舞干戚。\n功成不可留，延平空霹雳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35038,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鹤联句","author":"欧阳修","text":"上霄降灵气，钟此千年禽。\n幽闲靖节性，孤高伯夷心。\n颉颃紫霄垠，飘飖沧浪浔。\n岳湛有仙姿，钧韶无俗音。\n毛滋月华淡，顶粹霞光深。\n目流泉客泪，翅垂羽人襟。\n腾汉雪千丈，点溪霜半寻。\n纤喙砺青铁，脩胫雕碧琳。\n岩栖干溪树，泽饮卑蹄涔。\n鸾皇自埙篪，燕雀徒商参。\n独翅耸琼枝，群舞倾瑶林。\n病馀霞云段，梦回松吹吟。\n静嫌鹦鹉言，高笑鸳鸯淫。\n金精冷澄澈，玉格寒萧森。\n洁白不我恃，腥膻非所任。\n稻粱不得已，虮虱胡为侵。\n天池忆鹏游，云罗伤凤沈。\n风流超缟素，雅淡绝规箴。\n相亲长道情，偶见销烦襟。\n西汉惜冯唐，华皓欲投簪。\n南朝仰卫玠，清羸疑不禁。\n端如方直臣，处群良足钦。\n介如廉退士，惊秋犹在阴。\n几诮鹰隼鸷，羁韝俄见临。\n还嗤凫鹥贪，弋缴终就擒。\n乘轩乃一芥，空笼仍万金。\n片云伴遥影，冥冥越烟岑。\n长飙送逸响，亭亭出霜砧。\n蓬瀛忽往来，桑田成古今。\n愿下八佾庭，鼓舞薰风琴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35039,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠回道士","author":"滕宗谅","text":"华州回道士，来到岳阳城。\n别我游何处，秋空一剑横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35040,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠妓兜娘","author":"滕宗谅","text":"十载芳洲采白蘋，移舟弄水赏青春。\n当时自倚青春力，不信东风解误人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35041,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居书事","author":"太上隐者","text":"偶来松树下，高枕石头眠。\n山中无历日，寒尽不知年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35042,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"榴花","author":"石延年","text":"王母庭前亲见栽，张骞偷得下天来。\n谁家巧妇残针线，一撮生红熨不开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35043,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"真定怀古","author":"石延年","text":"光武经营业未兴，王郎兵革暂凭陵。\n须知后汉功臣力，不及滹沱一片冰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35044,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其三","author":"石延年","text":"檐垂冰箸晴先滴，草屈金钩绿未回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35045,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"联句","author":"韩绛","text":"古木含清吹，池上增晚凉。\n余怀本达旷，联此傲羲皇。\n孤鸥可与狎，幽岸足以觞。\n幸有彭泽酒，便同永嘉堂。\n潘生起为寿，王子齐陈章。\n林端见新月，草际闻寒螀。\n照水萤影乱，拂筵蓼花香。\n徘徊恋嘉境，坐使归兴忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35046,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"方氏清芬阁","author":"刁约","text":"自别高居二纪馀，今朝重到懒踟蹰。\n山川胜景依然在，屈指交亲一半无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35047,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"青帝","author":"王初","text":"青帝邀春隔岁还，月娥孀独夜漫漫。\n韩凭舞羽身犹在，素女商弦调未残。\n终古兰岩栖偶鹤，从来玉谷有离鸾。\n几时幽恨飘然断，共待天池一水乾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35048,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日咏梅花 其二","author":"王初","text":"青帝来时值远芳，残花残雪尚交光。\n隔年拟待春消息，得见春风已断肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35049,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"七夕","author":"王初","text":"榆叶飘零碧汉流，玉蟾珠露两清秋。\n仙家若有单栖恨，莫向银台半夜游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35050,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送陈校勘入宿","author":"王初","text":"日落风回卷碧霓，方蓬一夜拆龙泥。\n银台级级连清汉，桂子香浓月杵低。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35051,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"即夕","author":"王初","text":"风幌凉生白袷衣，星榆才乱绛河低。\n月明休近相思树，恐有韩凭一处栖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35052,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"宋咸","text":"宝花初烂欲连枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35053,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢御书飞白扇子歌","author":"胡宿","text":"圣皇多才复多艺，包牺徒云造书契。\n坦然制作侔日星，焕有文章贲天地。\n太宗飞白入于神，玉堂四字标奇势。\n宝跗一学造其精，圣祖神孙知善继。\n万几馀力表全能，三纪体仁成至治。\n金壶贮墨奉严禋，往年大揭明堂门。\n素龙鳞角俨欲举，白凤翅翼行将翻。\n八会辽邈不可见，六书细碎何足论。\n仁慈原庙多珍榜，河汉黼黻辉朝昏。\n天公常敕六丁护，在在处处祥烟屯。\n迩英叨籍侍清切，浴兰每岁逢佳节。\n鲛人海底织冰绡，宫工天上裁纨雪。\n弥纶宝箑已珍华，泛洒神毫益精绝。\n纷如薄雾翳灵芝，淡若轻云拂初日。\n免令常侍登御床，就降王人颁睿札。\n玉玺封题光姓名，孤臣拜手欢且荣。\n旸炎扇暍昭慈眷，夙夜安民彰圣情。\n九门才传妙墨出，三殿已觉薰风生。\n标章有愧参鸿硕，视草无能裨圣明。\n短歌莫尽形容美，微志聊依颂叹声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35054,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"早春","author":"胡宿","text":"燠沐阳和盛，苍筤老色浓。\n大明消积雪，青霭遍诸峰。\n远浪浮赪鲤，惊雷起蛰龙。\n去年南去雁，蓟北又相逢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35055,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"津桥晚望","author":"胡宿","text":"徙倚津桥上，苍凉树幄中。\n江云数峰黑，山日半规红。\n菖叶深依水，兰苕迥得风。\n雩坛春服就，归思羡沂童。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35056,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"井桐","author":"胡宿","text":"一水清无底，双桐碧有情。\n银床翻昼影，玉虎堕秋声。\n露叶游丝断，风枝宿鸟惊。\n隔帘人不寐，又送月西倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35057,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"舟次江口","author":"胡宿","text":"香吹生兰渚，飞霜下荻州。\n月波清浸夜，天幕冷垂秋。\n远屿迎潮没，寒烟护水浮。\n冲歌来泽畔，知是采菱舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35058,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赋江皋","author":"胡宿","text":"目睇兰皋上，春波泛早晖。\n画船人竞渡，绣羽雉交飞。\n岛树残潮落，汀花宿雾稀。\n短亭迷酒市，官柳绿依依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35059,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西郊二首 其一","author":"胡宿","text":"高楼十二曲，倚遍到斜晖。\n天幕清无翳，溪云冻不飞。\n断冈残烧尽，远树宿禽归。\n久忆莲华社，钟声隔翠微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35060,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西郊二首 其二","author":"胡宿","text":"远籁生寒野，平芜弄夕阳。\n天寒空鸟道，水落见鱼梁。\n岛树风仍荡，汀葭日映黄。\n津楼慵极目，杳杳白云乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35061,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"庆云寺桧","author":"胡宿","text":"宝坊金布地，嘉木此含荣。\n吴帝留青盖，湘神驻翠旌。\n月移香砌冷，风入夜琴清。\n若比东阳树，婆娑意未平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35062,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送臧寺丞赴建昌","author":"胡宿","text":"新擢京司秩，初旌幕府贤。\n少年裁美锦，昼日抚鸣弦。\n山好当衙际，云閒至榻前。\n庭中无一事，时问岳僧禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35063,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送君为从事东归","author":"胡宿","text":"秋半饬归艎，轻桡入水乡。\n吴歌闻子夜，陶菊见重阳。\n月浦鲵收浪，霜空鸟拂樯。\n南冠归未得，潘鬓莫苍浪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35064,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送孙从事","author":"胡宿","text":"三十一仙科，同时升大罗。\n轩翔几人去，沦谪独君何。\n淮桂牵吟数，湘兰寄恨多。\n且欣弹頍弁，荣路未蹉跎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35065,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送王从事赴漳州","author":"胡宿","text":"再奉天官集，初登郡将筵。\n檄材磨盾妙，宾履蹑珠贤。\n旧洞毛生竹，新池水映莲。\n幕中多暇日，曳彩戏亲前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35066,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禁直晨兴呈承旨侍郎","author":"胡宿","text":"内殿已攒点，揽衣朝未央。\n月低衔禁树，云薄护朝霜。\n欲放鱼文钥，先含鸡舌香。\n大昕鹓与鹭，奏事向明光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35067,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"馆中候马","author":"胡宿","text":"紫陌归鞍后，端门午鼓馀。\n铜池衔落景，铁擿掩残书。\n水远沟声细，花閒壁影疏。\n去驺呼已远，自笑守应庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35068,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"近郊","author":"胡宿","text":"信马斗城外，芳郊秋物多。\n丹枫惊岁晏，华黍喜时和。\n野老醉相话，牧童閒自歌。\n牛羊稍觉晚，一一下层坡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35069,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"沙鸟","author":"胡宿","text":"一啄樊笼外，萧然烟水乡。\n折芦翻夕梦，急雨乱秋行。\n南涧渔波浅，西风菰米香。\n世无摩诘手，谁与入清防。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35070,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"岁除","author":"胡宿","text":"守岁薰炉永，迎年煦律回。\n仙人收腊去，木帝送春来。\n桂伴阴蟾隐，梅冲艳雪开。\n平明喧寿宴，柏叶奉欢杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35071,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鹦鹉杯","author":"胡宿","text":"介族生螭蚌，杯形肖陇禽。\n曾经良匠手，见爱主人心。\n置在金樽侧，来从珠水浔。\n愿为仁者寿，再拜莫辞深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35072,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上苑","author":"胡宿","text":"汉籞春来早，光风近太清。\n花深迷玉漏，雾远失金茎。\n夹道青松密，周阿碧树生。\n回瞻葱郁气，遥覆九重城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35073,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山中","author":"胡宿","text":"乘秋寻远壑，偶到幽人家。\n浊醪酿秫米，香饭炊胡麻。\n微径扪萝茑，高峰弄云霞。\n餐和殆忘返，落景半规斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35074,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东溪早步","author":"胡宿","text":"宿雨澄纷幕，高霞冠远岑。\n青莲护水色，翠竹结村阴。\n雪浪鱼跳藻，风簧鸟啭林。\n峭帆天末起，撩动五湖心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35075,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送徐晋卿东归","author":"胡宿","text":"夜来龙具冷，有客厌长安。\n去国朝衣缁，还家楚叶丹。\n雪情欺酒薄，月思拂琴寒。\n只待东风起，林莺振美翰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35076,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送旌德田宰","author":"胡宿","text":"锦邑罢鸣琴，归涂指上林。\n柳鞭饶醉折，山馆胜游吟。\n清誉时苗犊，离悰望帝禽。\n明庭趋觐日，优绩简宸襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35077,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"招公仪小饮","author":"胡宿","text":"官舍隐非隐，仕途才不才。\n栋閒秋燕去，篱静晚花开。\n卓瓮何妨卧，庄轩或自来。\n求羊疏我甚，三径有青苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35078,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"朱鸟航","author":"胡宿","text":"浮航二十四，一一跨淮中。\n此地名朱鸟，当年踏彩虹。\n香尘迷旧路，寒水荡遥空。\n日暮惊飞盖，翩翩下渚鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35079,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和人山居","author":"胡宿","text":"翠柏荫山庄，岩扃四序凉。\n歌攀牛角远，啸引凤音长。\n夕膳烹葵熟，春杯切桂香。\n列侯生计在，千户橘含霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35080,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居","author":"胡宿","text":"松韵笙竽径，云容水墨天。\n人行春色里，莺语落花边。\n脩竹三间屋，清泉二顷田。\n了无官府事，鸡犬莫登仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35081,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"经朱氏郊居","author":"胡宿","text":"东冈接钓矶，有客偃郊扉。\n绕舍喧流水，当窗识翠微。\n溪田香稌熟，霜树晚桃稀。\n半日挥尘袂，停车不记归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35082,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送外表王植赴官岭外","author":"胡宿","text":"五岭知何许，离怀岂易言。\n传情无去雁，惊梦有啼猿。\n溪思吴莼老，林香越槿繁。\n渠渠持美酒，计日望归轩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35083,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"银台退朝","author":"胡宿","text":"官事良为少，人生初得閒。\n长吟聊拥鼻，薄酒且酡颜。\n春物行将晏，年芳尚可攀。\n此心同木雁，材与不材间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35084,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"桃叶渡","author":"胡宿","text":"怅望情人曲，空留此渡名。\n一条衣带水，千古石头城。\n艳歇双桃色，歌沈两桨声。\n不堪怀古意，山外夕阳明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35085,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春寒","author":"胡宿","text":"三楚多寒地，凭山复大川。\n龙鳞横雪隰，羊角起风天。\n酒价高平日，花期晚去年。\n白门无限柳，疏瘦未成眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35086,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蓬莱词","author":"胡宿","text":"瀛阆盛佳招，排云下赤霄。\n水犀梳插鬓，火玉佩垂腰。\n凫影朝青舄，鸾音咽紫箫。\n鳌宫无夜色，豹髓未尝烧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35087,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄合肥知己","author":"胡宿","text":"离管回香辔，行舟动翠篙。\n夕魂惟是黯，春目旋成蒿。\n梦与杨花荡，书凭燕子高。\n望中人不见，湖上首重搔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35088,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题兰溪","author":"胡宿","text":"招提紫翠中，僧住最高峰。\n几劫亲诸佛，三生听此钟。\n早香依涧树，高腊寄庭松。\n性海无穷愿，金书字字浓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35089,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"景福殿绯桃","author":"胡宿","text":"偷约蓬山客，閒寻芳树蹊。\n晨葩鲜欲语，春色醉成迷。\n艳夺朝霞段，香传冰麝脐。\n飘然凡境外，初有乳莺啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35090,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"暑夕水亭","author":"胡宿","text":"曲槛瞰回塘，披襟对羽觞。\n蘋风微有韵，水月自成凉。\n嫩筱疏疏影，新荷偃偃香。\n么弦聊按抚，志不在沧浪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35091,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新荷","author":"胡宿","text":"一夜抽轻盖，平明映曲池。\n水凉鱼未觉，烟净鸟先窥。\n露重心犹卷，风多柄尚危。\n东林应结社，祇待素华披。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35092,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"惜花","author":"胡宿","text":"试步向栏干，奇花正好看。\n乾坤增著力，风雨莫无端。\n彩笔题诗易，金刀下剪难。\n十分方吐半，犹喜夜来寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35093,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晴虹","author":"胡宿","text":"霁野收云雨，长光架一条。\n娲天初补石，乾鹊早成桥。\n日驭迷黄道，仙梯接绛霄。\n谁能乘六气，万里信扶摇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35094,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]