[{"title":"知非斋","author":"汪藻","text":"真是果安在，况今非故吾。\n个中惟醉好，莫忘黄公垆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4080,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"爱闲斋","author":"汪藻","text":"竿木逢场处，何人肯自还。\n秖应韩吏部，能道不如闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4081,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"光风桥","author":"汪藻","text":"茂林修竹下，一水独萦回。\n时过赤栏去，风从蘋末来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4082,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"饭牛庵","author":"汪藻","text":"相从龙具中，耕稼亦吾学。\n所求一饱同，安用瑩蹄角。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4083,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"临赋阁","author":"汪藻","text":"与物相忘久，于何寄此情。\n秖应逢胜会，不觉句还成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4084,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵吴明叟集鹤林五首 其一","author":"汪藻","text":"平生梦往处，始到天南峰。\n风来荷气度，日转松阴重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4085,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵吴明叟集鹤林五首 其二","author":"汪藻","text":"林间煮茗罢，谷口苍烟漫。\n行看草根露，已作珠玑团。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4086,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵吴明叟集鹤林五首 其三","author":"汪藻","text":"临分更携手，坐听烟钟声。\n斜阳有底急，不贷四窗明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4087,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵吴明叟集鹤林五首 其四","author":"汪藻","text":"支头涧底石，濯足松下泉。\n吾生傥有此，无复东西缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4088,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵吴明叟集鹤林五首 其五","author":"汪藻","text":"冥冥近岭翠，浏浏长廊风。\n他年竹林社，记取山王同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4089,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"北窗","author":"汪藻","text":"睡起无一事，怡然盼庭柯。\n绿阴微缺处，最得南飔多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4090,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题松竹图","author":"汪藻","text":"清霜摇落后，赖此慰诗翁。\n借有茱萸沜，风流可得同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4091,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戏题寂庵","author":"汪藻","text":"是心长不起，宴坐一团蒲。\n安得龙眠手，添成憩寂图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4092,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题商乐亭","author":"汪藻","text":"趣收霜后实，供我洞庭春。\n未暇三百颗，作书怀故人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4093,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偶成","author":"汪藻","text":"幽卧一禅榻，无人共白云。\n山泉与溪水，偏遣夜深闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4094,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"舟行三首 其一","author":"汪藻","text":"摩诘画中平远，庾郎句里清新。\n有底江山面目，年来到处相亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4095,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"舟行三首 其二","author":"汪藻","text":"水底藻迷淡晓，树头叶振凋年。\n未许梅悬玉乳，先教橘噀冰泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4096,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"舟行三首 其三","author":"汪藻","text":"山水俱含古色，烟云巧发天藏。\n乞与诗人醉眼，要令弹压秋光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4097,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题张资政汝川图九首 其一 澹岩书堂","author":"汪藻","text":"昔人曾此结精庐，故老犹存井臼馀。\n今代子房来卜筑，要看圮上一编书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4098,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题张资政汝川图九首 其二 泊湖潭","author":"汪藻","text":"湖潭千尺见脩鳞，倚杖时观镜里身。\n汝辈只堪笺尔雅，骑鲸那识谪仙人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4099,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题张资政汝川图九首 其三 虾蟆石","author":"汪藻","text":"发挥泉石有新图，西蜀蟆颐得尔无。\n暂作钓璜溪上客，溪神何必问贤愚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4100,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题张资政汝川图九首 其四 多宝院","author":"汪藻","text":"每寻疏磬访支郎，松竹交阴杖屦傍。\n丝履氎巾聊取用，风流不减赞公房。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4101,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题张资政汝川图九首 其五 金石台","author":"汪藻","text":"花光连接两台春，中有眠云跂石人。\n莫使鞭笞鸾凤去，时来重现宰官身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4102,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题张资政汝川图九首 其六 梅仙潭","author":"汪藻","text":"年年春色报公知，不与天涯驿使期。\n我是平章风物主，可知东阁见君时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4103,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题张资政汝川图九首 其七 怀贤庵","author":"汪藻","text":"履綦行处日苍苔，鞶帨深藏月一开。\n已办此身同法喜，不应临感更难裁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4104,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题张资政汝川图九首 其八 积翠楼","author":"汪藻","text":"直到孤峰最上头，下看双涧玉虹流。\n世间培塿何须数，且卧元龙百尺楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4105,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题张资政汝川图九首 其九 甘陂庄","author":"汪藻","text":"萧散香山与辋川，功名绿野及平泉。\n有田种秫供春醉，五柳先生似更贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4106,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵胡德辉乞予钞书之副六首 其一","author":"汪藻","text":"蝇头于我已无缘，拈问东家不直钱。\n乞与中庸胡伯始，免教堆屋篆蜗涎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4107,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵胡德辉乞予钞书之副六首 其二","author":"汪藻","text":"尔来书史钝如锤，安用牙签万轴为。\n遣我床头周易去，凭君分取半生痴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4108,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵胡德辉乞予钞书之副六首 其三","author":"汪藻","text":"欲钻故纸出何缘，大似儿啼业作钱。\n我已捐书觅三昧，怪君旧著野狐涎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4109,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵胡德辉乞予钞书之副六首 其四","author":"汪藻","text":"长年朱墨明窗下，自笑膏肓不可为。\n卖菜区区苦求益，君房他日更应痴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4110,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵胡德辉乞予钞书之副六首 其五","author":"汪藻","text":"五车政自妨人乐，秖合镵供饷鬼钱。\n我有灵编端欲见，为君扫地注龙涎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4111,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵胡德辉乞予钞书之副六首 其六","author":"汪藻","text":"长檠计出群儿下，两眼眵昏欲底为。\n凭语少年须著便，酒狂端合信书痴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4112,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"醉书","author":"汪藻","text":"尊前和雨唱阳关，红烛荧荧照夜阑。\n酒醒梦回山月小，水云无际雁声寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4113,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"将至郡城","author":"汪藻","text":"花姑溪上问归舟，谢守城边识小楼。\n两岸垂垂秋色老，渡头人更老于秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4114,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"熊使君垂和漫兴诗次答四首 其一","author":"汪藻","text":"凭轩时见白云行，霜入长江万丈清。\n逐客今年缘底事，村村箫鼓报秋成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4115,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"熊使君垂和漫兴诗次答四首 其二","author":"汪藻","text":"新亭虽小亦翚飞，陡觉风烟与昨非。\n分得使君秋数顷，登山临水送将归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4116,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"熊使君垂和漫兴诗次答四首 其三","author":"汪藻","text":"闭门多睡少经行，随分匏尊泻独清。\n庭下若生书带草，前身即是郑康成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4117,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"熊使君垂和漫兴诗次答四首 其四","author":"汪藻","text":"儿时也羡刺天飞，投老方知绝百非。\n酬唱恰成刘与白，分司且住莫言归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4118,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题江南春晓图","author":"汪藻","text":"忽从林杪见朝晖，湿峤轻云半欲飞。\n何惜扁舟并画我，要从沙际望春归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4119,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠人二首 其一","author":"汪藻","text":"闻将衲子日寻幽，度水穿云处处游。\n遥想逃禅时一醉，人间春瓮与扶头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4120,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠人二首 其二","author":"汪藻","text":"山城重到转清幽，胜日闲寻旧钓游。\n定是沙鸥嫌俗驾，背人飞去不回头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4121,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次零陵太守竞秀堂韵四首 其一","author":"汪藻","text":"层峦远近翠浮空，人道山川似剡中。\n正要潇湘含远色，莫教江上起樵风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4122,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次零陵太守竞秀堂韵四首 其二","author":"汪藻","text":"柳子当年亦好奇，衡阳丛桂手亲移。\n何如此地栽桃李，春到千岩万壑知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4123,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次零陵太守竞秀堂韵四首 其三","author":"汪藻","text":"从渠歌舞转头空，且索尊前一笑同。\n欲识使君真乐处，蒲团禅板是家风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4124,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次零陵太守竞秀堂韵四首 其四","author":"汪藻","text":"桃花拈出自灵云，荐得伽陀独有君。\n无事时来观物化，妙高峰顶度朝曛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4125,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵周圣举四首 其一","author":"汪藻","text":"斗酒相逢且缓觞，惜无妙曲恼周郎。\n愿吹江水添杯杓，不管春秋似许长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4126,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵周圣举四首 其二","author":"汪藻","text":"满眼晴江滟不收，浴凫飞鹭迥相俦。\n何须细话兴亡事，今古从来貉一丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4127,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵周圣举四首 其三","author":"汪藻","text":"弃甲高于熊耳山，大弨挂壁更须弯。\n从今江北江南柳，莫遣行人取次攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4128,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵周圣举四首 其四","author":"汪藻","text":"少妇中宵闻马嘶，晓看黄色上脩眉。\n男儿一为功名死，肯向空山愁秭归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4129,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵蔡天任十首 其一","author":"汪藻","text":"江头山色旧所爱，倒影玉海空嶙峋。\n尔来处处作媚妩，似与世争眉黛新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4130,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵蔡天任十首 其二","author":"汪藻","text":"幽人午枕梦清熟，书笔满床花自开。\n儿童误起听脩竹，旧雨故人今不来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4131,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵蔡天任十首 其三","author":"汪藻","text":"我家君家一牛鸣，相见几何今露萤。\n要须来往成白首，痛饮共读离骚经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4132,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵蔡天任十首 其四","author":"汪藻","text":"江南六月底风土，十日市无山鞠藭。\n不应梅子趁时节，自是国人愁寓公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4133,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵蔡天任十首 其五","author":"汪藻","text":"君家食指如堵墙，不著斗酒求西凉。\n门前䆉稏三百亩，胜我笔耕无寸秧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4134,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵蔡天任十首 其六","author":"汪藻","text":"关西老将争捐躯，帐下健儿思草枯。\n谁能捐粟百万斛，乞与绕树南飞乌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4135,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵蔡天任十首 其七","author":"汪藻","text":"山中种橘无千头，一饱未卜为君忧。\n长年有饭即吾土，问米贵贱还东流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4136,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵蔡天任十首 其八","author":"汪藻","text":"脩廊过午夕阴合，蝴蝶满庭春草长。\n呼儿更卷帘数尺，要放晚晴升屋梁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4137,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵蔡天任十首 其九","author":"汪藻","text":"百年都卢能几日，况迫晼晚行归休。\n高车列鼎岂非欲，安步晚食差无忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4138,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵蔡天任十首 其十","author":"汪藻","text":"中郎故是渥洼种，不受世人金络头。\n十年一衲作僧过，卧看烟雨明沙鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4139,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"万上人将游三吴袖杼山居士赠言见过戏成两绝送之 其一","author":"汪藻","text":"参得汤休五字禅，一瓶一钵去飘然。\n定知游历名山遍，吟入江湖万顷天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4140,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"万上人将游三吴袖杼山居士赠言见过戏成两绝送之 其二","author":"汪藻","text":"韩子由来未识真，欲还澄观作诗人。\n若教早被儒冠误，那得云山自在身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4141,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"还琏上人诗卷","author":"汪藻","text":"笔端游戏讵须频，短轴才开即可人。\n月映澄江梅映雪，比君犹自未清新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4142,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"或传有归期陈时发饷灵寿杖求诗","author":"汪藻","text":"圣恩端许返柴荆，便合跏趺过此生。\n九节烦君持送似，人间险处不重行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4143,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"银毫","author":"汪藻","text":"玉为蟾蜍冰作滴，乌丝栏开宝鸦墨。\n天孙夜拾瑶草归，醉舞银毫斗春碧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4144,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"枯禅","author":"汪藻","text":"我行昔到虎溪头，俗气浮光两无尽。\n当时独指烟树杪，有士枯禅雪侵鬓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4145,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"浴孙日熊叔雅有诗次其韵二首 其一","author":"汪藻","text":"休论臭腐与神奇，康乐还生谢客儿。\n我有浮溪农圃在，他年分付小樊迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4146,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"浴孙日熊叔雅有诗次其韵二首 其二","author":"汪藻","text":"释氏梦中亲抱送，人言价重百车渠。\n阮家新妇得雄帖，还有数行中令书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4147,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夜雨遣兴","author":"汪藻","text":"风雨鸣窗报客知，还孤月底探梅期。\n泉声犹自断还续，遥想栖禽无定枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4148,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵何子应七月十八日书事二首 其一","author":"汪藻","text":"寄语江鸥莫浪猜，先生爱汝水潆洄。\n自从楚国灵均后，几个骚人到此来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4149,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵何子应七月十八日书事二首 其二","author":"汪藻","text":"卧看山色懒扶舆，拟棹扁舟学钓鱼。\n谁似湘流知我意，秋来三得道州书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4150,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"吕丞相自天台寄示退老堂诗卷赋此二首 其一","author":"汪藻","text":"心如金石气如虹，整顿乾坤指顾中。\n挽去暂成调鼎事，归来还作钓璜翁。\n东山胜践今人见，西洛耆年几客同。\n圮上一编浑未用，赤松那得便从公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4151,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"吕丞相自天台寄示退老堂诗卷赋此二首 其二","author":"汪藻","text":"我公英爽笑臞仙，来占东南古洞天。\n几度倾身安社稷，一朝袖手向林泉。\n长劳海内簪缨望，小作山中杖屦缘。\n谩使吴儿生意气，凉台燠馆记他年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4152,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"尽心堂为张丞相题","author":"汪藻","text":"道林岳麓天下无，下有万顷之重湖。\n群山奇变水清泻，紫气合沓来中区。\n张公扶持宇宙了，天与此境为公娱。\n烟云冲融几席上，幻出百态供朝晡。\n那知公亦寓焉耳，胸中炯炯如冰壶。\n平生忠孝心铁石，不磨要与兹山俱。\n向来卜筑营草木，汲汲可笑平泉愚。\n何如坐以眼为界，卷藏云梦吞衡巫。\n主人归来头正黑，剑履未给黄门扶。\n我虽忘世世不尔，唾手行取东西都。\n谁云古今不相及，今见谢傅东山图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4153,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿招贤馆","author":"汪藻","text":"儿时客衢州，尝过招贤馆。\n主人敬爱客，置驿极安便。\n堂前花作屏，堂后竹成援。\n人来铜步岭，路异玉玉县。\n回头四十载，兴废眼中见。\n重寻旧馆盟，井径无复辨。\n沉吟茂林缺，怅望佳石转。\n道逢里监门，难我曾识面。\n白头相劳苦，语已涕双泫。\n破屋为少留，天寒雨如线。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4154,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"新安石砚","author":"汪藻","text":"冰蚕吐茧抽银忽，仙女鸣机号月窟。\n云绡裂断掷残繻，沦入空山作尤物。\n中书君老不任事，蛛网陶泓空俗骨。\n故令玉质傲松腴，万缕秋毫聊出没。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4155,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]