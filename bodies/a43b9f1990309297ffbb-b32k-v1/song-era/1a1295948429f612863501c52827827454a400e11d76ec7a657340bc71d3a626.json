ommit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13268,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题半山寺壁二首 其二","author":"王安石","text":"寒时暖处坐，热时凉处行。\n众生不异佛，佛即是众生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13269,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题半山寺壁二首 其一","author":"王安石","text":"我行天即雨，我止雨还住。\n雨岂为我行，邂逅与相遇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13270,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题正觉院箨龙轩二首 其二","author":"王安石","text":"仙事茫茫不可知，箨龙空此见孙枝。\n壶中若有闲天地，何苦归来问葛陂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13271,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题正觉院箨龙轩二首 其一","author":"王安石","text":"北轩名字经平子，爱此吾能为赋诗。\n山雨江风一披拂，箨龙还自有吟时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13272,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题永庆壁有雱遗墨数行","author":"王安石","text":"永庆招提墨数行，岁时风露每凄伤。\n残骸岂久人间世，故有情钟未可忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13273,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题玉光亭","author":"王安石","text":"传闻天玉此埋堙，千古谁分伪与真。\n每向小庭风月夜，却疑山水有精神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13274,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题齐安壁","author":"王安石","text":"日净山如染，风暄草欲薰。\n梅残数点雪，麦涨一溪云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13275,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题何氏宅园亭","author":"王安石","text":"荷叶参差卷，榴花次第开。\n但令心有赏，岁月任渠催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13276,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题张司业诗","author":"王安石","text":"苏州司业诗名老，乐府皆言妙入神。\n看似寻常最奇崛，成如容易却艰辛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13277,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题杨溪","author":"王安石","text":"桥横葛仙陂，住近杨雄宅。\n主人胡不归，为我炊香白。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13278,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题定力院壁","author":"王安石","text":"溪北溪南水暗通，隔溪遥见夕阳舂。\n思量诸葛成何事，只合终身作卧龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13279,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题定林壁怀李叔时","author":"王安石","text":"云与渊明出，风随禦寇还。\n燎炉无伏火，蕙帐冷空山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13280,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题宝岩寺寒碧亭二首 其一","author":"王安石","text":"两岸青山刻峭成，一溪回曲篆纹平。\n绿阴隐隐无重数，欲去黄鹂又一声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13281,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题画扇","author":"王安石","text":"玉斧修成宝月团，月边仍有女乘鸾。\n青冥风露非人世，鬓乱钗斜特地寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13282,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题金沙","author":"王安石","text":"海棠开后数金沙，高架层层吐绛葩。\n咫尺西城无力到，不知谁赏魏家花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13283,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题金陵驿","author":"王安石","text":"重冈古道春风里，草色花光似故人。\n却喜此身今漫浪，回家随处得相亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13284,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题勇老退居院","author":"王安石","text":"道人投老寄山林，偶坐翛然洗我心。\n梦境此身能且在，明年寒食更相寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13285,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题夏旼扇","author":"王安石","text":"白马津头驿路边，阴森乔木带漪涟。\n夕阳一马匆匆过，梦寐如今十五年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13286,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]