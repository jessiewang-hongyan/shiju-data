[{"title":"竹下见兰","author":"郑清之","text":"竹下幽香祗自知，孤高终近岁寒姿。\n垂杨曼舞多娇态，倚赖东风得几时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35010,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"纪龙井上所见","author":"郑清之","text":"摇曳轻阴羃柳堤，坳塘日暖漾凫鹥。\n无端崖下鸣榔发，飞起一声过水西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35011,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自嘲","author":"郑清之","text":"我亦逢场因作戏，要令竿木自随身。\n老僧不学面壁观，山偈随缘举似人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35012,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西湖 其二","author":"郑清之","text":"官程未了是敲推，课督无人只自催。\n不到西湖无半句，西湖端合号诗媒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35013,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西湖 其一","author":"郑清之","text":"黑云妒日故要遮，剩得轻红一缕霞。\n小雨挟风针水面，满奁皱縠起团花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35014,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观王导传作","author":"郑清之","text":"江东老子惠之和，九锡牛车愠蔡婆。\n不杀伯仁君信否，澹然推分意如何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35015,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观史有感","author":"郑清之","text":"家令身危侯国计，洛阳谗摈涕流书。\n都门祖帐何功德，千古徽名说二疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35016,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别僧","author":"郑清之","text":"溪边风景远且平，颇似江乡双眼明。\n柳风淅淅荔日淡，计取生还第一程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35017,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即事","author":"郑清之","text":"微云疏雨一分月，折苇枯荷强半秋。\n犹有远禽飞不尽，急翻孤影暮江头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35018,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"花间见蝶","author":"郑清之","text":"粉翅萦花几度忙，惜花长是为春光。\n争如个个蜂须上，到处分甘作乳房。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35019,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲中口占数绝 观书困甚","author":"郑清之","text":"眼欲观书身欲眠，斜拖黄卷曲肱边。\n不须身眼争然否，试待醒来问孝先。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35020,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲中口占数绝 园丁去乌蜂","author":"郑清之","text":"见说乌蜂不采花，群飞啄蜜喙如鸦。\n虽然冗食真堪汰，笑语园丁且放衙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35021,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲中口占数绝 浓绿中见芍药一朵","author":"郑清之","text":"杏桃结子已成翁，稚绿中间着耄红。\n阶药元来如许寿，麦秋天气露春工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35022,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲中口占数绝 海鱼绝少","author":"郑清之","text":"春鱼潮罢捉洋山，数水艚船索手还。\n海若想应饕更甚，饱鲜无复到人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35023,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲中口占数绝 联雨解闷","author":"郑清之","text":"雨多愁麦又忧苗，不雨还忧旱火骄。\n忧国浪愁端自苦，老天那肯病汤尧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35024,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和白雪老禅二偈 其一","author":"郑清之","text":"阅尽恒河水上波，声尘何似泡沤多。\n还师拍板钳锤后，更唱谁家别调歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35025,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和白雪老禅二偈 其二","author":"郑清之","text":"檐铎吟风月半凹，黄金布地欠诛茅。\n三更出日真光景，大好钦身正笠包。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35026,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和虚斋劝农十诗 其八","author":"郑清之","text":"小队旌旗半道归，松阴缓策揽清晖。\n女郎未觉褰帷过，笑语相教着嫁衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35027,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和虚斋劝农十诗 其二","author":"郑清之","text":"爇天妖焰彗初沉，朝汲仁贤简帝心。\n未用锋车便脂牵，小须千里遍春霖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35028,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和虚斋劝农十诗 其三","author":"郑清之","text":"蔽日寒云悄欲秋，仁风载路晓光浮。\n田翁揽抱儿孙笑，竹马横陈未肯休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35029,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和虚斋劝农十诗 其五","author":"郑清之","text":"暇日棋书六一翁，锦樯丝辔与春逢。\n年时豹尾车中望，山色有无知几重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35030,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和虚斋劝农十诗 其十","author":"郑清之","text":"恰好农时踏翠烟，睡龙惊起雨公田。\n官程便作乘闲看，不用扁舟学计然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35031,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和虚斋劝农十诗 其一","author":"郑清之","text":"迢递层阴晓自开，仙舟花底问瀛莱。\n文章太守非游衍，为省春耕特地来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35032,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和虚斋劝农十诗 其六","author":"郑清之","text":"晓梦吟成望帝归，征鞍未许柳丝知。\n笑听鄮岭春禽哢，去博延英午漏迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35033,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和虚斋劝农十诗 其四","author":"郑清之","text":"问讯桑麻真郡政，按行松菊似家山。\n挽回和气归田里，只费斋铃半日闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35034,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和虚斋劝农十诗 其七","author":"郑清之","text":"酡颜醉客玉西东，半湿尘衫上翠空。\n邹谷虽寒应解黍，朱车面面是春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35035,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜雨","author":"郑清之","text":"依风急雨垫秋清，疏数无时总有声。\n最是可怜云里月，几番阴翳几番明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35036,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泊黄檀","author":"郑清之","text":"夕阳茅屋占江干，风敛炊烟作暮寒。\n閒看月光牛背上，画图添我一樯竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35037,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"茄子","author":"郑清之","text":"青紫皮肤类宰官，光圆头脑作僧看。\n如何缁俗偏同嗜，入口元来总一般。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35038,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"觅桂花于夷陵宰 其二","author":"郑清之","text":"东家竹屋最穷空，不识檐花落雨中。\n笑遣吴刚挥玉斧，解令冷舍作蟾宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35039,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"觅桂花于夷陵宰 其一","author":"郑清之","text":"月圃仙人试道妆，风流六一旧琴堂。\n遥知鼻观盈秋馥，乞与冰曹数粟香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35040,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨中即事简二友 其二","author":"郑清之","text":"举头但觉云头闇，移脚何曾雨脚乾。\n衣裌未便时衣褐，薄寒浑作晚秋看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35041,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨中即事简二友 其四","author":"郑清之","text":"五月炎天正及时，轻丝扇子未曾持。\n殷勤寄语班姬道，只恐秋深却要伊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35042,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨中即事简二友 其三","author":"郑清之","text":"鸠能唤雨复呼晴，日日长从屋角鸣。\n晴雨不应关汝事，强饶唇舌效君卿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35043,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨中即事简二友 其一","author":"郑清之","text":"怒蛙频作灌夫骂，老鹳唯闻庄舄吟。\n麦熟只应呼快活，林间欠此一声禽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35044,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨中即事简二友 其六","author":"郑清之","text":"莺声求友乱缫车，兀坐翻思二客佳。\n乞得晚晴红照水，南坡东畔月侵阶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35045,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南坡口号十八首 其十八","author":"郑清之","text":"红红白白共枝荣，怪底山茶有宁馨。\n倩得司花来判断，不妨一姓养螟蛉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35046,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南坡口号十八首 其十七","author":"郑清之","text":"安晚生涯冷似灰，别墅经营半月回。\n誇与儿郎翁骤富，诗囊盈握送陈雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35047,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南坡口号十八首 其十六","author":"郑清之","text":"旧日都城饫子鱼，一鳞今不到茅庐。\n果然额上通三印，尽去侯门代鲤书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35048,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南坡口号十八首 其十五","author":"郑清之","text":"晓来两鹊屋山鸣，报喜多应只报晴。\n似为东皇传好语，故留胜赏到清明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35049,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南坡口号十八首 其十三","author":"郑清之","text":"枝筇挂起一旬彊，剪剪春寒到柳塘。\n白发不公欺老我，偏于闲处引风霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35050,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南坡口号十八首 其十二","author":"郑清之","text":"小窗白醉篆香迟，只有书君伴燕颐。\n料得人间无此乐，殷勤献与定牢辞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35051,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南坡口号十八首 其十一","author":"郑清之","text":"纷纶儿造信多才，果解分风作去来。\n我向南坡一旬雨，春阴今晓为谁开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35052,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南坡口号十八首 其十","author":"郑清之","text":"分席春畦仅一弓，灵根移自石窗东。\n饶渠五味誇仙药，争似盐梅正策功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35053,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南坡口号十八首 其九","author":"郑清之","text":"试向清池放小鲜，洋洋圉圉忽攸然。\n校人真个知鱼乐，杀活机锋总是禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35054,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南坡口号十八首 其八","author":"郑清之","text":"管弦不碍登山屐，粱肉何妨满腹书。\n岂是清谈愧夷甫，为无阿堵绕吾庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35055,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南坡口号十八首 其七","author":"郑清之","text":"酷爱鸟鸣山更幽，墙阴风雨但飕飕。\n筠笼买得春禽语，不会忧时也白头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35056,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南坡口号十八首 其六","author":"郑清之","text":"吾孙宗子喜相过，一笑檀栾似乐窝。\n且向尊中陪北海，直须闲里识南坡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35057,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南坡口号十八首 其五","author":"郑清之","text":"欲识鱼梁试作看，轻抛野渌罩清寒。\n几回漉起空无物，输杀群儿下钓竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35058,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南坡口号十八首 其十四","author":"郑清之","text":"记得儿时诵古诗，其甘如荠谓吾欺。\n淡交休恨相知晚，携向晶盘笑杀伊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35059,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南坡口号十八首 其三","author":"郑清之","text":"谁将春晚作冬看，添着绵衣减却难。\n道是麦寒犹未在，愿渠麦熟且禁寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35060,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南坡口号十八首 其二","author":"郑清之","text":"天工忽忽度年光，料理人间富贵忙。\n闲里何曾关造物，一分风景亦收藏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35061,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南坡口号十八首 其一","author":"郑清之","text":"十日南坡两日晴，晴时不放日华明。\n春光似妒闲人佔，端的春风饱世情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35062,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南坡口号十八首 其四","author":"郑清之","text":"休言无地起楼台，十个花窠没处栽。\n东近比邻西近水，且教红白面墙开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35063,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋成风雨","author":"郑清之","text":"垂垂金颖贺秋成，去逐狂风一羽轻。\n何事天工恶戏剧，眼前翻覆见亏盈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35064,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋色佳甚未能一到觉际像景谩赋二绝 其二","author":"郑清之","text":"藕花万柄敛春妆，剩驻霜荷葺芰裳。\n水路想通渔艇入，我来月下要鸣榔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35065,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋色佳甚未能一到觉际像景谩赋二绝 其一","author":"郑清之","text":"秋光澹薄有无间，掠水斜风雨脚斑。\n试向菰蒲深处望，嫩黄一点荇花闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35066,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"茶","author":"郑清之","text":"书如香色倦犹爱，茶似苦言终有情。\n慎勿教渠纨裤识，珠槽碎釜浪相轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35067,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"虹出","author":"郑清之","text":"轻红浅翠抹弓腰，高映斜阳跨碧霄。\n半似一条琼玉带，合成五色水晶桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35068,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"觉际闲坐纪所见","author":"郑清之","text":"蛛网雨中时恤纬，蜂屯衙后自婴城。\n竹根得土笋争长，纸隙受风窗善鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35069,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"觉际偶成","author":"郑清之","text":"自愧端平村宰相，今为安晚野堂翁。\n君恩全付閒身世，山水从容一笑中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35070,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻觉际被风寄頔老","author":"郑清之","text":"古德把茅惟盖头，飓风飘屋等虚舟。\n矮窗犹有蒲团滑，也胜床前衮雪毬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35071,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻蝉","author":"郑清之","text":"人行沌口三程路，蝉作阳关第四声。\n待到日夕蝉歇处，无端促织替渠鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35072,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"食豆荚","author":"郑清之","text":"西风摵摵草虫鸣，万荚丛中诧瑞蓂。\n煮啖快输儿女吻，燃萁不忍尚堆青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35073,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"香山老惠两猫","author":"郑清之","text":"杀活禅机本自由，顺行逆用总先筹。\n伽梨亲抱狸奴送，管是南泉是赵州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35074,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"香山猫食粥","author":"郑清之","text":"梵宫新遣两狸奴，晨粥饥餐食肉如。\n料是伊蒲三昧熟，未知绕膝诉无鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35075,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"家园即事十三首 其十三","author":"郑清之","text":"老红拟佔春光住，嫩绿枝头更娇妒。\n随风宛转未肯落，犹作霓裳羽衣舞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35076,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"家园即事十三首 其十二","author":"郑清之","text":"人心似铁炉犹在，世事如棋路不移。\n闲著目光牛背上，英雄千古竟儿嬉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35077,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"家园即事十三首 其十一","author":"郑清之","text":"客有可人君子竹，书无同至大王风。\n此风此竹堪谁共，着得茶经桑苧翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35078,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"家园即事十三首 其十","author":"郑清之","text":"游鱼绕石日千里，反舌鸣声已百能。\n老鹤易饥增廪稍，乳鸡勤哺领孙曾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35079,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"家园即事十三首 其九","author":"郑清之","text":"树底鸣鸠相唯诺，花间飞蝶自绸缪。\n二虫得失聊堪笑，鸿鹄谁能问弈秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35080,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"家园即事十三首 其八","author":"郑清之","text":"书带环生缭岸青，叶间虫篆学阳冰。\n墨池文冢非难化，芝菌从教子厚蒸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35081,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"家园即事十三首 其七","author":"郑清之","text":"早作南风午北风，暄凉翻手雨无踪。\n田翁举似霖霪日，脚踏鸣车笑杀侬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35082,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"家园即事十三首 其六","author":"郑清之","text":"侏儒饱愧东方朔，妪母呼回郭舍人。\n博局由来更胜负，雉卢那复较疏亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35083,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"家园即事十三首 其五","author":"郑清之","text":"绿阴乐静未号蝉，藕叶扶娇汎水眠。\n输杀蜂屯深闭壁，峙粮宿饱蜜中边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35084,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"家园即事十三首 其四","author":"郑清之","text":"千岩万壑自秋春，静处观山能几人。\n叠得假山人竞看，世间宜假不宜真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35085,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"家园即事十三首 其二","author":"郑清之","text":"新竹地肥方怒长，幽花晚发自欣荣。\n飞来野蝶多情思，不逐蜻蜓点水轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35086,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"家园即事十三首 其一","author":"郑清之","text":"水满横塘占晓凉，莲腮霞举叶云生。\n鱼儿富贵真难比，翠盖红妆拥队行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35087,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]