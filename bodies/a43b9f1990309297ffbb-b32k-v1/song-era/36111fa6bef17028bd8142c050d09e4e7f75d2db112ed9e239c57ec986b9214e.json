[{"title":"金陵杂兴二百首 其一九八","author":"苏泂","text":"紫云回薄隐新愁，早起钟声也是不。\n遍地葱花两三亩，至今人道景阳楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74138,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其四十","author":"苏泂","text":"云气依稀有若无，定山山下片帆孤。\n青芜不尽天连水，野鸭飞来成画图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74139,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其一五一","author":"苏泂","text":"竹树池台三亩馀，白云千载护幽居。\n悲凉物色须弹压，粉白脂红却要渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74140,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其二十四","author":"苏泂","text":"清唱闻之妓女家，依稀犹似后庭花。\n重楼复阁参天起，不见佳人张丽华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74141,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其一四四","author":"苏泂","text":"凤凰台上凤凰游，凤去台空水自流。\n惆怅何因见李白，采江试觅月明舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74142,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其九十六","author":"苏泂","text":"看杀先来所寄书，不知病体比何如。\n想应药裹关心外，更与儿曹作念渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74143,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其一○三","author":"苏泂","text":"魏紫姚黄扫地空，斩新相尚庆元红。\n道人眼界无分别，只赏东来一味风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74144,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其六十五","author":"苏泂","text":"休论句曲更茅山，只到栖霞说半年。\n暂学僧閒犹未得，几时真个作神仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74145,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其四十五","author":"苏泂","text":"绿阴黄鸟半山园，谢字王名宛若存。\n试问时人两安石，却推翁仲不能言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74146,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其一七九","author":"苏泂","text":"一曲清溪一首诗，风流千载忆僧施。\n小姑溪上平安否，容我骑鱼作伴嬉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74147,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其九十九","author":"苏泂","text":"乌衣巷侧长干寺，暇日閒来看一回。\n未觉六朝兴废迹，凄凉先傍眼边来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74148,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其七十五","author":"苏泂","text":"州衙三面接秦淮，临水朱门一半开。\n却是浙中无此景，江鸥飞舞入城来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74149,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其一三四","author":"苏泂","text":"亭上施屏或可无，江山形胜恐难摹。\n何当穷腊亲来此，身作袁安卧雪图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74150,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其一一五","author":"苏泂","text":"晋宋齐梁几帝陵，土堆谁解有英灵。\n三台五省纷纷改，惟有钟山只么青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74151,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其四十六","author":"苏泂","text":"等君日日在高台，吹尽杨花君不来。\n归兴自浓身尚客，江南老却贺方回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74152,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其一七三","author":"苏泂","text":"紫髯何事忽迁都，有意宫中号太初。\n他日三军嫌饮水，只应翻忆武昌鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74153,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其一八五","author":"苏泂","text":"八功德水饮一勺，当下令君热恼消。\n城里红尘莫回首，小屏风岭好逍遥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74154,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其一三二","author":"苏泂","text":"杏堂缭绕过梅堂，小竹高松映苑墙。\n白雪飞残红雾密，乘舆不到却凄凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74155,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其三十三","author":"苏泂","text":"白石鄱姜病更贫，几年白下往来频。\n歌词剪就能哀怨，未必刘郎是后身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74156,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其一六七","author":"苏泂","text":"上尽层城更上楼，绿杨枝外尽汀洲。\n蝶衔花蕊蜂衔粉，同向春风各自愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74157,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其三十一","author":"苏泂","text":"客里逢春得几回，山桃还似旧年开。\n玄都道士何曾识，真个刘郎去复来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74158,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其六十七","author":"苏泂","text":"青漆楼高制作奇，当时纯不用琉璃。\n东昏幸自嗤梁武，不道东昏更可嗤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74159,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其一五三","author":"苏泂","text":"艳杏夭桃日夜忙，雨馀啼损不成妆。\n元戎和气春风似，又引笙歌看海棠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74160,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其五十四","author":"苏泂","text":"谢公遗冢尚坡陀，丝竹中年好若何。\n亦到旧时携妓处，野人行馌妇行歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74161,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其四十九","author":"苏泂","text":"小伞障羞去复回，蒋山寺里看花开。\n摩挲拄杖君随我，遮莫松间喝道来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74162,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其五十三","author":"苏泂","text":"鼓声打得海棠开，更向花前舞一回。\n传语流莺莫相怪，青春去后不重来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74163,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其十","author":"苏泂","text":"归心突兀不可制，一夜梦中行越山。\n惊觉恍然犹是客，欲随春色共东还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74164,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其九十二","author":"苏泂","text":"雨花台下百花香，驻马坡前百草长。\n若还谷熟人民乐，依旧风流好建康。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74165,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其五十六","author":"苏泂","text":"青骨标灵尔许奇，翩翩白马去何之。\n庙门贴在烟云上，此是江东第一祠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74166,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其一九四","author":"苏泂","text":"扬州风物转头非，又是葵榴得意时。\n班扇入怀君莫恃，秋来那免弃捐悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74167,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其一二○","author":"苏泂","text":"忆杀当年刘改之，风流曾赋秣陵诗。\n如今白骨埋青草，百咏何因尔得知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74168,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其一三一","author":"苏泂","text":"池亭楚楚更堂堂，占得宽閒地一方。\n花竹四时随处有，纵无人赏亦何妨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74169,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其一○○","author":"苏泂","text":"桑间少妇谁能管，松下孤僧却可怜。\n鱼跃鸢飞均适尔，流行坎止不徒然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74170,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其三十七","author":"苏泂","text":"龙虎江山未改形，临高一目但青青。\n春风岂是无才思，不洗从来战伐腥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74171,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其五","author":"苏泂","text":"江南堤柳拂人头，三月吹花特地愁。\n却忆旧时狂李白，题诗曾遍酒家楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74172,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其一○四","author":"苏泂","text":"二十四番风信催，郭南间道有花开。\n园官欲斗金钱赏，名字先供百品来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74173,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其一二九","author":"苏泂","text":"阑干三面倚晴晖，竹外长江一线微。\n太守不来僧自看，清凉境界箨龙围。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74174,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其八十八","author":"苏泂","text":"暄风吹斋响苍玉，竹石相看便有情。\n提胡卢来沽美酒，终日撩人不住声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74175,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其一一一","author":"苏泂","text":"头上瓶中一万枝，花枝人面两相宜。\n满堂将帅文兼武，都载周家既醉诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74176,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其一五○","author":"苏泂","text":"柳思花情分外娇，青楼消息夜迢迢。\n金陵看得新歌舞，不数吴音共楚腰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74177,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其一○一","author":"苏泂","text":"钟山窈窕转龙身，小屋低松次第新。\n试觅定林依旧在，只无当日读书人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74178,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其二","author":"苏泂","text":"朱雀街头观阙红，角门东畔好春风。\n人家一样垂杨柳，种入宫墙自不同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74179,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其一二五","author":"苏泂","text":"毫端真敌万人军，蔬笋能空粉黛群。\n机幕昼閒仍吊古，不胜东閤好郎君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74180,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其一四九","author":"苏泂","text":"南台北榭隔飞烟，绿水朱桥思渺然。\n月下閒来看箕斗，傍人指点似神仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74181,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其一四八","author":"苏泂","text":"飞梁谁字小垂虹，波面蜿蜒去不穷。\n一段风烟无处觅，鸳鸯鸂鶒在其中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74182,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵池上","author":"苏泂","text":"府园秋后一池荷，绿盖纵横百柄多。\n折尽再生钱样叶，却疑天气复清和。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74183,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"钓鱼","author":"苏泂","text":"是非不上钓鱼舟，从此闲身得自由。\n一色藕花三十丈，明年归住鉴湖头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74184,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨中水阁闲眺 其一","author":"苏泂","text":"两山正作脩眉绿，一水犹如疋练横。\n竟日书窗览今古，几年人世少豪英。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74185,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨中水阁闲眺 其二","author":"苏泂","text":"朝看雨脚似悬绳，暮见宽波没钓汀。\n鸭鸭归来人寂寂，鸦鸦飞去草青青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74186,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨中海棠花放简冯元咨","author":"苏泂","text":"天涯万里春风晚，曾上西楼看此花。\n今日东南无处觅，矮筇来问蜀人家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74187,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨夜","author":"苏泂","text":"不待船来雨又风，雨声元要打船篷。\n不干篷底纤毫事，一夜佳眠自落空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74188,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"顷在金陵郡斋与黄观复夜坐漏箭下一二十刻率未寝对语既尽明烛渐昏相与坐睡而后已归同郡居乃经时不见追忆当时曾有四句云","author":"苏泂","text":"映雪工夫久已无，引锥自刺一何愚。\n青灯一盏书狼藉，画作金陵瞌睡图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74189,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南塔诗","author":"苏泂","text":"松树何知过百年，树根流水亦清涟。\n莫嫌寂寞无人到，多有人来正不然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74190,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"复过二首 其二","author":"苏泂","text":"西风奕奕细吟商，客枕凄然一夜凉。\n吟尽蘋花浑可事，少留荷叶盖鸳鸯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74191,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"复过二首 其一","author":"苏泂","text":"远水连山碧四围，烟波时有鹭鸶飞。\n馀姚江上中秋月，自买扁舟一个归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74192,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庭前菊","author":"苏泂","text":"百叶黄香十月春，东篱佳节误陶巾。\n开花较晚酒羞涩，风味依然似主人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74193,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"恨春","author":"苏泂","text":"芍药荼蘼一万枝，花开动是隔年期。\n欲留春色都无计，睡过红云白雪时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74194,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"拜年人 其一","author":"苏泂","text":"来车去马拜纷纷，岁岁年年不惮烦。\n拜得老人山上去，一番儿女各当门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74195,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"拜年人 其二","author":"苏泂","text":"小年踯躅随群队，长大悲伤怕物华。\n爇罢天香来影室，不行人事便归家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74196,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春归","author":"苏泂","text":"十日晴明九日非，人家庭院绿成帏。\n春风怕见匆忙去，莫放杨花一点飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74197,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春谷","author":"苏泂","text":"寒谷春生物物均，薰然和气特相亲。\n十年屡作开花赏，重费吹嘘是此人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74198,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春涧曲","author":"苏泂","text":"点点飞红逐细流，拾樵烹荐茗花浮。\n秋来岂不潺湲好，才带猿声便是愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74199,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"昭君村","author":"苏泂","text":"都将心事与琵琶，青冢魂归路转赊。\n赢得故乡儿女子，至今头白不离家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74200,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋声","author":"苏泂","text":"枕边无寐骨毛轻，露欲为霜月正明。\n一叶梧桐如唤客，起来搔首听秋声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74201,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋夜 其一","author":"苏泂","text":"一派银河似练横，浅深波浪浸天青。\n夜阑忽有风吹动，摇漾南箕北斗星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74202,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋夜 其二","author":"苏泂","text":"一点流萤自入扉，清风都向草头吹。\n眠稀又被啼螀妒，看见新凉上小时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74203,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋感","author":"苏泂","text":"油窗漠漠雨垂垂，秋尽江南草木知。\n促织到头无一语，不知能有几多丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74204,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送赵大资途次口占","author":"苏泂","text":"渡口斜阳欲满旗，锦衣容易逐云衣。\n圣朝无事宗臣老，白发沧浪一舸归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74205,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送黄木香与九兄 其二","author":"苏泂","text":"妃子妖红湿领巾，马嵬遗恨几番春。\n如何淡素衣龙衮，一似秦宫入道人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74206,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送黄木香与九兄 其一","author":"苏泂","text":"冶叶倡条无意度，黄香千叠最宜春。\n折来欲赠空惆怅，未遇人间第一人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74207,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送裕师骨 其一","author":"苏泂","text":"去年石上君携我，今日溪边我送君。\n世事尽从朝晚过，人情难必死生分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74208,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送裕师骨 其二","author":"苏泂","text":"轻幡袅袅思悠悠，梦破依然到鼎州。\n送客各还家里去，青山白骨自风流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74209,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重阳二首 其二","author":"苏泂","text":"九日登临两鬓华，鸥边秋色带风沙。\n绝怜当日陶彭泽，依旧无钱对菊花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74210,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重阳二首 其一","author":"苏泂","text":"为客时多不解愁，亦逢佳节强登楼。\n酒阑自摘茱萸望，何处青山是越州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74211,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重到西湖","author":"苏泂","text":"都下重来百事非，故人相见少相知。\n绝怜水减西湖瘦，更喜兵强北虏衰。\n顾虑每怀医国计，仓黄犹忆过家时。\n书生老矣都无用，自捲波澜入小诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74212,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闻莺","author":"苏泂","text":"一个冬青树，莺声日日来。\n屋西偏娅姹，应是绿云堆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74213,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"借屋","author":"苏泂","text":"借屋移来逐半年，眼看花发便欣然。\n主人官满吾当去，却忆看花又可怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74214,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏行郊外","author":"苏泂","text":"吹红换得绿团枝，蝴蝶飞来又却疑。\n藤架野花无著莫，是人行处有香随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74215,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]