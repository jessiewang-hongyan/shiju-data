[{"title":"此君室 其十六","author":"方蒙仲","text":"千载兰亭人，所乐在山水。\n等闲一笑间，风度乃如此。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9230,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"此君室 其三","author":"方蒙仲","text":"为嫌太孤高，邂逅松梅友。\n忽与竹同评，是遇知音不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9231,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"此君室 其九","author":"方蒙仲","text":"滔滔天地间，非我安知我。\n大儿王子猷，小儿文与可。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9232,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"此君室 其十二","author":"方蒙仲","text":"先生啸诺馀，尝欲访青士。\n门生可举舆，不必命儿子。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9233,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江路梅","author":"方蒙仲","text":"翁仲为余泣，江头负月明。\n一从少陵死，此路断人行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9234,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"问梅","author":"方蒙仲","text":"夜月玉堂前，春风紫盖边。\n想君都看破，宁与我周旋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9235,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿徐意一参政 其二","author":"方蒙仲","text":"吕氏早皆期正献，范家晚竟相忠宣。\n不成二十年声望，久坐难兄一旧毡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9236,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿徐意一参政 其三","author":"方蒙仲","text":"众芳摇落此何时，争看江梅拆一枝。\n相去小春才四日，调羹消息不应迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9237,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿徐意一参政 其一","author":"方蒙仲","text":"红云朵里紫霞杯，敕使今朝四度来。\n意一堂中开九帙，太微星里现三台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9238,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿徐意一参政 其四","author":"方蒙仲","text":"黄花晚节香愈劲，老圃秋容景更奇。\n欲侑瓣香无好语，且偷忠献一联诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9239,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"折梅","author":"方蒙仲","text":"看梅如看画，由我不由他。\n千树江头少，一枝瓶里多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9240,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘后村梅花百咏 其五十一","author":"方蒙仲","text":"香奁陋体实堪哀，惭谢诸公费挽推。\n铁石心肠元作赋，浮华讵足定人才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9241,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘后村梅花百咏 其六十四","author":"方蒙仲","text":"心事芬芬流品胜，一生清友是梅臞。\n可怜介甫交游尽，岁晚钟山进二俞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9242,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘后村梅花百咏 其五十五","author":"方蒙仲","text":"乐事赏心谁不有，可人胜士古来难。\n樽前莫怪同游少，恐被梅花白眼看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9243,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘后村梅花百咏 其四十六","author":"方蒙仲","text":"后村画卷四方来，输与先生作袜材。\n貌就寒林差易事，玉堂云雾欠人裁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9244,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘后村梅花百咏 其七十一","author":"方蒙仲","text":"十分元得孤寒力，一点无关坱圠功。\n谁令春风来得晚，梅花也不傲春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9245,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘后村梅花百咏 其四十八","author":"方蒙仲","text":"此花清绝畏人知，间许吟人咽入脾。\n咽去居然佳句少，谁云臭腐可神奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9246,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘后村梅花百咏 其六十五","author":"方蒙仲","text":"怀中黄敕墨犹新，曾尾群贤步玉津。\n惆怅看花成昨梦，大输今岁赏梅人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9247,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘后村梅花百咏 其五十六","author":"方蒙仲","text":"千顷琼田徒手得，连云綵阁一朝成。\n平生富贵梅时健，肯作穷人冻饿声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9248,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘后村梅花百咏 其四十三","author":"方蒙仲","text":"鸥社同盟交最久，兔园授简事堪悲。\n开元才子多佳句，借向宫人笛里吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9249,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘后村梅花百咏 其六十二","author":"方蒙仲","text":"溪北溪南雪跨悬，琼楼玉宇照庭前。\n萸坪竹馆辛夷坞，肯与王维赌辋川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9250,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘后村梅花百咏 其十四","author":"方蒙仲","text":"一生梦不识愁台，口吻悲鸣有底哀。\n树上玉人应冷笑，从今不敢送愁来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9251,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘后村梅花百咏 其五十七","author":"方蒙仲","text":"禹锡当年出省台，玄都花谢转生哀。\n梅花不涉春风事，看取先生几度来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9252,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘后村梅花百咏 其三十五","author":"方蒙仲","text":"驿处徘徊磴处缘，任教人唤作梅颠。\n赊它陆凯二十字，唤起杜陵三百年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9253,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘后村梅花百咏 其七十四","author":"方蒙仲","text":"温柔乡苦不胜衣，端正楼嫌微有肌。\n安得花神供步辇，不肥不瘦美兼之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9254,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘后村梅花百咏 其二十五","author":"方蒙仲","text":"不把山林换市朝，鲜明自是一时标。\n便令大冶安能铸，傥有小山差可招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9255,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘后村梅花百咏 其六十九","author":"方蒙仲","text":"宝络珠璎佛子龛，荒原断涧隐君庵。\n清言悟法无人会，时有游蜂细细参。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9256,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘后村梅花百咏 其六十一","author":"方蒙仲","text":"少豪放出旅枯槎，归橐垂垂返海涯。\n叔子诸公自佳耳，关人心事只梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9257,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘后村梅花百咏 其四十五","author":"方蒙仲","text":"方见横斜忽乱飞，噫其造物未昌时。\n点衣片片皆诗料，爱惜移时不敢吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9258,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘后村梅花百咏 其五十二","author":"方蒙仲","text":"惜花心固凄凉矣，绕树身犹矍铄哉。\n且莫怨嗟难可口，和羹事只系时来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9259,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘后村梅花百咏 其十一","author":"方蒙仲","text":"少陵前仅陆君诗，骚里居多摭茝蓠。\n未必梅花非有待，不妨敲琢古人遗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9260,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘后村梅花百咏 其七十七","author":"方蒙仲","text":"树边久立任衣单，为爱天香彻骨寒。\n脑子斛量犹觉臭，安知人世有沉檀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9261,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘后村梅花百咏 其十九","author":"方蒙仲","text":"帘围玉馆愁吟尽，锦藉瑶瓶怕摘残。\n姑息梅花讵须尔，山家何处有朱栏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9262,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘后村梅花百咏 其四十二","author":"方蒙仲","text":"百年老树半边枯，众卉难攀觉太孤。\n欲进素馨交茉莉，柰渠浪蕊欠根株。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9263,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘后村梅花百咏 其二十八","author":"方蒙仲","text":"托根岂解媚中珰，采蕨祇当慕首阳。\n未必木天无秽史，岂其枌省尽清郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9264,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘后村梅花百咏 其十八","author":"方蒙仲","text":"无人可共倚雕栏，折得横枝独自看。\n梅癖难医君信否，东阳瘦损少陵酸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9265,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘后村梅花百咏 其三","author":"方蒙仲","text":"紫府仙人水月英，绝嫌臭秽溷真清。\n玉尘月赋三千斛，一洗人间死鬼兄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9266,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘后村梅花百咏 其八","author":"方蒙仲","text":"惆怅庭前三树株，十年依旧一锥无。\n从今只作梅生活，底用江头千木奴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9267,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘后村梅花百咏 其六","author":"方蒙仲","text":"拾遗当日醉于诗，江路寻梅兀似痴。\n花底柳边真梦事，居然短褐鬓如丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9268,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘后村梅花百咏 其五","author":"方蒙仲","text":"参横月落梦何从，且领清香入盏中。\n一岁见梅须一醉，梅前有几百年翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9269,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘后村梅花百咏 其十二","author":"方蒙仲","text":"短篱疏竹自周遮，官舍过如野老家。\n不是陋儒太孤绝，自看梅后觉无花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9270,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘后村梅花百咏 其二","author":"方蒙仲","text":"莫恃千芳胜一莸，兰渐芝滫便休休。\n年来萧艾吁堪怕，剩拾天香置宝篝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9271,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘后村梅花百咏 其四十一","author":"方蒙仲","text":"夜色朝光两莫知，树间但见白差差。\n江南到处名姝少，一律前村雪里词。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9272,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘后村梅花百咏 其五十四","author":"方蒙仲","text":"窗明不寐夜寥寥，恍惚珠幢跨玉桥。\n冷掾久严红妓禁，綵鸾莫误唤文箫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9273,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘后村梅花百咏 其二十一","author":"方蒙仲","text":"吟人写物例浮夸，未易形容是此花。\n好事休刊和靖集，一联已足自成家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9274,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘后村梅花百咏 其四十四","author":"方蒙仲","text":"童黄安足名天下，太白常疑在世间。\n生纵不陪振鹭列，死犹可葬伯鸾山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9275,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘后村梅花百咏 其四十七","author":"方蒙仲","text":"香臭难逃万古评，白黄安得一般清。\n好看玉树临风立，羞杀金莲帖地行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9276,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘后村梅花百咏 其十五","author":"方蒙仲","text":"倚树静看成入定，巡檐对语似谈空。\n是花是雪都休问，但觉清香满袖风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9277,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘后村梅花百咏 其二十","author":"方蒙仲","text":"雨霰潇潇天地宽，相看岛瘦与郊寒。\n埋腰立雪心良苦，拥鼻吟风事大难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9278,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘后村梅花百咏 其十","author":"方蒙仲","text":"凛凛冰清岩壑气，亭亭玉立庙廊身。\n从前误把瑶姬比，雌了梅花俗了人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9279,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘后村梅花百咏 其七","author":"方蒙仲","text":"岁岁年年花状头，瑶珰琼佩瑞光浮。\n玉螭赏遍三千界，不识珠帘十二楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9280,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘后村梅花百咏 其二十四","author":"方蒙仲","text":"自是不容加染涴，看来良亦富才情。\n落羌女管声声怨，点寿阳妆片片轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9281,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘后村梅花百咏 其四","author":"方蒙仲","text":"儿时两颔已生髭，一饱皇皇亟失时。\n索性断它烟火气，餐英汲润当朝炊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9282,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘后村梅花百咏 其十七","author":"方蒙仲","text":"从知枯淡芬芳远，自古荣华朽腐多。\n且作从容廊庙看，一丘一壑觉如何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9283,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘后村梅花百咏 其七十九","author":"方蒙仲","text":"初似穷儿观异宝，俄惊上帝锡嘉名。\n荒山底处生珠藏，蓬户居然扁玉清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9284,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘后村梅花百咏 其二十三","author":"方蒙仲","text":"玉羽江莲美莫当，酴醾缟袂雪为裳。\n白之谓白何分别，毕竟还梅是当行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9285,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘后村梅花百咏 其二十七","author":"方蒙仲","text":"智琼久已乘龙去，留得人间十二枝。\n插向瓦瓶伴孤枕，别无玉骨与冰肌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9286,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘后村梅花百咏 其七十三","author":"方蒙仲","text":"懒入寿宫供贵主，难凭庾驿寄时贤。\n不如吹入霜天角，尚为君王戍北边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9287,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘后村梅花百咏 其六十六","author":"方蒙仲","text":"生涯冷淡乐者少，声色希夷见若无。\n洛下只知海棠会，岭南竞作荔枝图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9288,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘后村梅花百咏 其八十四","author":"方蒙仲","text":"忍寒宁死饿宁僵，不去偷它贾女香。\n感叹怀铅成底事，辛勤餐玉竟无方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9289,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘后村梅花百咏 其八十三","author":"方蒙仲","text":"不慕清官况热官，竹篱纸帐睡差安。\n却愁帝敕梅龙去，第一瑶台分外寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9290,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘后村梅花百咏 其六十七","author":"方蒙仲","text":"极知云月浩无边，所恨舂容欠大篇。\n宵立我犹嫌俗士，形臞尔可配儒仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9291,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘后村梅花百咏 其二十二","author":"方蒙仲","text":"一气居然分冷暖，南枝开早北枝迟。\n都城巧力真堪羡，竞买梅花八月时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9292,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘后村梅花百咏 其七十六","author":"方蒙仲","text":"西湖已死犹名世，东阁更佳何与人。\n但得心传清白事，不须足踏软红尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9293,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘后村梅花百咏 其三十","author":"方蒙仲","text":"綵叶如云观玚蕊，金盆照日品桃花。\n安知尤物真瑰特，落在西湖处士家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9294,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘后村梅花百咏 其九","author":"方蒙仲","text":"百万瑶妃传粉酥，诗翁列屋世间无。\n江南穷相韩熙载，有甚歌姬画作图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9295,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘后村梅花百咏 其五十九","author":"方蒙仲","text":"沸鼎乾坤尘未消，椒菌杂袭少高标。\n君王曾梦商岩否，此物差堪与燮调。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9296,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘后村梅花百咏 其二十六","author":"方蒙仲","text":"肠断当年古吹台，酒酣欲叫谪仙回。\n夜深落月照颜色，端的宫袍入梦来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9297,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘后村梅花百咏 其八十","author":"方蒙仲","text":"雪裹空身无庇叶，风前妙质忽飞尘。\n一襦不著中寒去，莫是陈三辈行人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9298,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘后村梅花百咏 其五十三","author":"方蒙仲","text":"老天机轴无停手，忙织千葩染万红。\n惟有一冬闲岁月，梅花专局不分功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9299,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘后村梅花百咏 其三十八","author":"方蒙仲","text":"雪破白时惊臈早，雨肥红处已春归。\n到头不识东皇面，看尽蜂黄蝶粉飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9300,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘后村梅花百咏 其六十三","author":"方蒙仲","text":"披衣徙倚天方曙，秉烛吟哦夜忽中。\n不是被他驱使得，爱他意政与人同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9301,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘后村梅花百咏 其八十一","author":"方蒙仲","text":"扫空习气尚馀狂，岂不怀思拾众芳。\n花里素王真足贵，橘中皓叟更无香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9302,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘后村梅花百咏 其三十四","author":"方蒙仲","text":"行吟坐想午忘饥，剔尽青灯睡失时。\n唐宋以来多作者，姑为汉魏补梅诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9303,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘后村梅花百咏 其五十八","author":"方蒙仲","text":"一生不信有金芝，今岁庭前碧玉枝。\n只恨相看无一语，恍如月下对桓伊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9304,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘后村梅花百咏 其七十二","author":"方蒙仲","text":"和靖墓荒吟骨冷，孤山新庙尚危栏。\n便当纯用梅花祭，一洗蕉黄与荔丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9305,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘后村梅花百咏 其三十七","author":"方蒙仲","text":"十分正色白为难，眼底红黄总热瞒。\n安得云英挥玉杵，臈馀为合返魂丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9306,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]