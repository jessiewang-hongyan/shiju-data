b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题城南书院三十四咏 其十三","author":"张栻","text":"铙鼓喧豗十里城，人情正喜上元晴。\n瘦筇独立湖边路，却有白鸥同眼明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54999,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题城南书院三十四咏 其四","author":"张栻","text":"新凉物物有精神，静倚书窗听雨声。\n忽忆子綦元未解，强分天籁太粗生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55000,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题城南书院三十四咏 其三","author":"张栻","text":"阶前树影开还合，叶底蝉声短复长。\n睡起更知茶味永，客来聊共竹风凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55001,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题城南书院三十四咏 其六","author":"张栻","text":"林塘过雨不胜秋，万盖跳珠写碧流。\n倚槛孤吟天欲暮，更穿芒屩上方舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55002,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题城南书院三十四咏 其七","author":"张栻","text":"山色顿清秋欲半，湖光更净日平西。\n凉风猎猎低荷盖，归翼翩翩度柳堤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55003,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题城南书院三十四咏 其十六","author":"张栻","text":"花柳芳妍十日晴，五更风雨送馀春。\n莫嫌红紫都吹尽，新绿满园还可人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55004,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题城南书院三十四咏 其十一","author":"张栻","text":"今年少雨菊花迟，青蕊方开三两枝。\n但得悠然真意在，青山何处不相宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55005,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题城南书院三十四咏 其二十三","author":"张栻","text":"疏竹萧萧正雨声，眼中日影又还晴。\n钩窗燕坐夏将半，荷叶已香湖水清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55006,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题城南书院三十四咏 其十五","author":"张栻","text":"晓来天气便清新，独倚阑干正暮春。\n花落花开莺自语，东风吹水细鳞鳞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55007,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题城南书院三十四咏 其三十","author":"张栻","text":"睡觉西山月正平，荷香不断晓凉生。\n园中只鹤知人意，已作金风警露声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55008,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题城南书院三十四咏 其二十四","author":"张栻","text":"莫道闲中一事无，闲中事业有工夫。\n闭门清昼读书罢，扫地焚香到日晡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55009,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题城南书院三十四咏 其五","author":"张栻","text":"凌晨骑马路新凉，来挹湖边风露香。\n妙意此时谁共领，波间鸥鹭静相忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55010,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题城南书院三十四咏 其八","author":"张栻","text":"湖边小筑喜新成，秋入西山照眼明。\n不是厌喧来觅静，四时光景本均平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55011,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题城南书院三十四咏 其二十八","author":"张栻","text":"朝阳初上藕花香，下马虚亭一味凉。\n山鸟自呼鱼自乐，谁云身世可相忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55012,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题城南书院三十四咏 其九","author":"张栻","text":"秋风飒飒林塘晚，万绿丛中数点红。\n若识荣枯是真实，不知何物更谈空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55013,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题城南书院三十四咏 其十九","author":"张栻","text":"化工生意源源在，静处详观总不偏。\n飞絮满空春不尽，新荷贴水已田田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55014,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题城南书院三十四咏 其二十九","author":"张栻","text":"北窗竹簟午阴凉，亦有清风到我旁。\n还与陶公事同否，未妨诸子细商量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55015,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题城南书院三十四咏 其二十二","author":"张栻","text":"阴阴松竹影自转，午枕无人到北窗。\n何许狂风来动地，梦回波浪汹春江。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55016,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题城南书院三十四咏 其十八","author":"张栻","text":"无言桃李也成阴，叶底黄鹂自好音。\n一缕炉烟清昼永，韦编卷罢短长吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55017,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题城南书院三十四咏 其二十五","author":"张栻","text":"亭畔薰风尽日凉，来从水面过新篁。\n悠然但觉盈襟抱，千古虞弦意未央。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55018,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题城南书院三十四咏 其十四","author":"张栻","text":"和风习习禽声乐，晴日迟迟花气深。\n妙理冲融无间断，湖边伫立此时心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55019,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题城南书院三十四咏 其二十一","author":"张栻","text":"暮从别墅跨驴归，风雨萧萧泥溅衣。\n出门回首且按辔，细听泉声和式微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55020,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题城南书院三十四咏 其十七","author":"张栻","text":"并湖数亩新疏辟，便有鱼儿作队行。\n我亦随流浮小艇，晚凉细看縠纹生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55021,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题城南书院三十四咏 其三十四","author":"张栻","text":"殷雷终日在前山，风卷云环意作难。\n泊暮有怀空伫立，忽然飞雨到阑干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55022,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题城南书院三十四咏 其十二","author":"张栻","text":"秋后冬前一月晴，小园佳处日经行。\n半山木落楼台露，几树霜馀橘柚明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55023,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题城南书院三十四咏 其三十一","author":"张栻","text":"西风夜半摧炎暑，晓看云横天际秋。\n时序转移皆妙理，惟应及早戒衣裘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55024,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题城南书院三十四咏 其二十七","author":"张栻","text":"乌云夭矫风作恶，雷奔电掣雨悬河。\n须臾天宇复清霁，突兀西山紫翠多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55025,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题城南书院三十四咏 其三十二","author":"张栻","text":"新凉修竹意愈静，初日芙蕖色倍鲜。\n物态直须闲里见，人情多向快中偏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55026,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题城南书院三十四咏 其十","author":"张栻","text":"移得幽兰几本来，竹篱深处手栽培。\n芬芳不必纫为佩，月白风清取次开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55027,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题庾楼","author":"张栻","text":"南瞻庐阜北淮山，下有长江万顷寒。\n往事无边随去浪，西风有客傍阑干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55028,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题曾氏山园十一咏 其八 北山","author":"张栻","text":"南山烟雨霏，北山风露多。\n衣沾非所惜，屦湿知如何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55029,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题曾氏山园十一咏 其十一 吟风桥","author":"张栻","text":"桥边风月佳，俯仰有馀思。\n无忘履冰心，方识吟风意。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55030,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题曾氏山园十一咏 其十 桃花坞","author":"张栻","text":"花开山与明，花落水流去。\n行人欲寻源，只在山深处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55031,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题曾氏山园十一咏 其四 霜杰","author":"张栻","text":"种松苦难长，松长还耐久。\n莫作目前思，但种门前柳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55032,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题湘潭丞黄子辩哦松轩","author":"张栻","text":"黄子官居多暇日，吟哦薄暮一窗中。\n虽无㶁㶁循除水，但觉飕飕满屋风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55033,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题雉山禊亭","author":"张栻","text":"一曲清江正可怜，隔江新竹露娟娟。\n好风成我曲肱梦，起看飞云度碧天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55034,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹤","author":"张栻","text":"月底风前意味多，不妨伫立胜婆娑。\n轩中君子知多少，遣汝乘轩看若何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55035,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九日登千山观","author":"张栻","text":"清晨领客上巉岩，野路衣襟湿翠岚。\n九日开樽仍绝景，西风攲帽且高谈。\n地形盘薄一都会，山色周遭万玉簪。\n却指飞鸿烟漠漠，故园茱菊老江潭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55036,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二月二十五日登裴台坐上口占","author":"张栻","text":"朝来风雨好，抱病亦登临。\n故国江山在，荒城花柳深。\n忧时空百虑，望远只微吟。\n春事如樱笋，幽盟可重寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55037,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二月十日野步城南晚与吴伯承诸友饮裴台分韵得江字","author":"张栻","text":"春日烟沙岸，禅房风竹窗。\n有时倾绿酒，随处见清江。\n世路纷多辙，吾生老此邦。\n千林看不尽，白鸟去双双。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55038,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"人日游城东晚饭陈仲思茅亭分韵得香字","author":"张栻","text":"绝怜梅事晚，与客到林塘。\n瓦椀村醪酽，杯羹野菜香。\n旧游看壁字，新岁尚他乡。\n一笑俱真率，悠然意未央。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55039,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十二月十六日夜枕上闻雷已而大雪","author":"张栻","text":"春信梅边动，雷声枕上惊。\n忽看窗纸白，顿觉竹声清。\n江海空馀梦，壶觞起自倾。\n朝来倚楼处，玉树满湘城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55040,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十三日晨起霜晴用定王台韵赋此","author":"张栻","text":"晴岚开岳镇，云雨断阳台。\n日出寒光迥，川平秀色回。\n兴随天际雁，诗寄岭头梅。\n盛事它年说，凭君记玉杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55041,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十五日再登祝融峰用台字韵","author":"张栻","text":"今朝风日霁，共约再登台。\n人在云端上，僧从天际回。\n岩头风戛竹，林畔雪欺梅。\n浊酒消寒气，无妨饮数杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55042,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十四日陪黄仲秉渡湘饮岳麓台上分韵得长字","author":"张栻","text":"支筇穿百级，把酒问春光。\n乔木依然在，幽兰祇自芳。\n未当湘水满，更觉橘洲长。\n暝色犹回首，天涯话故乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55043,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上巳日晚登裴台自仲春凡三登","author":"张栻","text":"前日看花地，重来对落晖。\n雨馀山著色，沙没水初肥。\n寒食家家出，残红树树飞。\n还同二三子，及此咏而归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55044,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上封有怀元晦","author":"张栻","text":"忆共朱夫子，登临冰雪中。\n剧谈无俗调，得句有新功。\n别去雁横浦，重来月满空。\n遥怜今夕意，清梦傥相同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55045,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与弟侄饮梅花下分韵得香字","author":"张栻","text":"日多色愈正，春和天与香。\n提携一樽酒，问讯满园芳。\n嗣岁诗多思，怀人心甚长。\n更须多秉烛，玉立胜红妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55046,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小园荼蘼盛开伯承以诗见督置酒于此为增不敏之叹","author":"张栻","text":"留连红紫计无从，晚惜芬芳万卉空。\n枕上几回清梦断，风前政可碧纱笼。\n春随夜雨但三叹，韵入香醪尚一中。\n长有花开消息在，不应鸣鼓便相攻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55047,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]