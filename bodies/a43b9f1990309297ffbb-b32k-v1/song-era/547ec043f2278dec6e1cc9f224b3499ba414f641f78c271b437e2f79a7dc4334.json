[{"title":"宫中词","author":"武衍","text":"睡馀罗袖印眉山，行傍妆台理坠鬟。\n圣主忧勤排当少，犀椎鱼拨总成閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30761,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宫词补遗 其二","author":"武衍","text":"牡丹春籞正秾华，有旨今年不赏花。\n剪落金盘三百朵，内批分赐近臣家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30762,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宫思","author":"武衍","text":"当时十五正娇妍，选入宫中二十年。\n谁料祇今三十五，舞靴未蹋玉阶前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30763,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"尝葡萄","author":"武衍","text":"压架骈枝露颗圆，水精落落照晴轩。\n微酸自是江南种，尚忍因渠说太原。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30764,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日舟中书所见 其一","author":"武衍","text":"翠峰斜倚侧金翘，罗带萦红罥碧桃。\n应是春愁禁不得，东风深院粉墙高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30765,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日舟中书所见 其二","author":"武衍","text":"花外风来夹腻香，片云谁遣下巫阳。\n不须回首频相顾，彼此伤春易断肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30766,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日湖上 其一","author":"武衍","text":"花外垂杨阅四朝，东风依旧绿条条。\n当年盛事人犹说，二殿龙舟泊画桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30767,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日湖上 其二","author":"武衍","text":"拆桐花上雨初乾，寒食游人尽出关。\n一片湖边春富贵，断桥船簇夕阳间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30768,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日湖上 其三","author":"武衍","text":"飞鹢鸣镳鼓吹喧，繁华应胜渡江前。\n吟梅处士今还在，肯住孤山尔许年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30769,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日湖上 其四","author":"武衍","text":"船里歌声去复还，游人乐在酒杯间。\n争如策蹇长堤上，细看南山与北山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30770,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春晓山行马上口占 其二","author":"武衍","text":"路转前山复后山，宿烟收尽薄生寒。\n吟鞭忽指松梢月，绝胜城中楼上看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30771,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春晓山行马上口占 其一","author":"武衍","text":"山深竹暗晓风轻，几样幽禽错杂鸣。\n驻马细听浑不识，就中惟识子规声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30772,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"柳枝词","author":"武衍","text":"灵和殿里最风流，三月飞花雪御楼。\n换得玉人眉样巧，一春浑不下帘钩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30773,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夕过松陵","author":"武衍","text":"月冷江空夜气浓，桂香飞下广庭风。\n不知何处神仙过，鹤唳数声烟霭中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30774,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夕清汎","author":"武衍","text":"弄月吹箫过石湖，冷香摇荡碧芙蕖。\n贪寻旧日鸥边宿，露湿船头数轴书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30775,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贵游","author":"武衍","text":"钿车辘辘辗芳尘，步幛香移一片春。\n花下玉盘行禁脔，御前宣劝到湖滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30776,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重访西湖旧游","author":"武衍","text":"西风吹晓凤城开，桂子香中信马来。\n十载不行湖上路，知它添了几楼台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30777,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻角呈宗谕方蕙岩","author":"武衍","text":"晓角吹愁客梦寒，一声声落曲屏閒。\n吴儿可杀无风味，老却梅花祇当閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30778,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"恭谢庆成诗十阕 其二","author":"武衍","text":"麝蜡笼纱粲玉阶，珠栊齐撤九门开。\n一天星斗明如月，法驾徐擎出殿来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30779,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"恭谢庆成诗十阕 其一","author":"武衍","text":"二载明禋帝意专，瓣香盍谢祖宗前。\n愿前盛典从头数，绍述应须亿万年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30780,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"恭谢庆成诗十阕 其八","author":"武衍","text":"染罗彫草斡天机，簇戴工夫斗出奇。\n唯有近臣恩数异，尚方别赐细栾枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30781,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"恭谢庆成诗十阕 其九","author":"武衍","text":"小白长红十里春，归来天仗拥香尘。\n翩翩黄屋彫霞里，辇上无花止一人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30782,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"恭谢庆成诗十阕 其三","author":"武衍","text":"宫监推帘探晓星，景阳钟动已妆成。\n凤舆陆续衔车马，黄道香浓尾驾行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30783,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"恭谢庆成诗十阕 其四","author":"武衍","text":"礼成列圣宴群工，浩荡春风到竹宫。\n传旨簪花俄侣锦，信知天子是天公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30784,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"恭谢庆成诗十阕 其七","author":"武衍","text":"宫前仪卫尚般还，花里声传午漏残。\n见说御园才放水，圣心游泳正观澜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30785,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"恭谢庆成诗十阕 其五","author":"武衍","text":"大官宣劝礼优宽，中殿妃嫔各尽欢。\n和气满城天色好，不妨直际晚回銮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30786,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"恭谢庆成诗十阕 其十","author":"武衍","text":"士庶重重间绮罗，霁光熏作小春和。\n御街两行瞻天表，比似前回人更多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30787,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"恭谢庆成诗十阕 其六","author":"武衍","text":"乐奏仙韶进寿觥，觚棱风细宝香清。\n隔帘微见龙颜启，缘是优人有笑声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30788,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"莺","author":"武衍","text":"柳外飞来恰弄声，瞥然流去一梭轻。\n分明啼断春愁处，风不惊花午院晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30789,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄社友","author":"武衍","text":"秉烛西园事已非，更堪中酒落花时。\n隔帘燕子偏饶舌，不管春愁倦作诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30790,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"虚皇坛月下闻笙","author":"武衍","text":"何人吹动玉笙攒，天阔风高桂殿寒。\n声轧五云飞不去，夜深和鹤落瑶坛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30791,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪中登垂虹亭","author":"武衍","text":"投箠江边雪满头，玉虹千尺要诗酬。\n诗成上马谁同说，说似亭前两白鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30792,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寓京口四首答汤菊庄兼简分司郑料院 其四 月观远眺","author":"武衍","text":"朝宗亭下浪冥冥，何日寻观瘗鹤铭。\n更欲裹茶邀客去，短篷敲火瀹中泠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30793,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寓京口四首答汤菊庄兼简分司郑料院 其三 甘露寺很石","author":"武衍","text":"二雄曾向此般还，鼎立功名各未安。\n留得坐时顽石在，至今人尚说曹瞒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30794,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寓京口四首答汤菊庄兼简分司郑料院 其二 鹘山","author":"武衍","text":"屹然孤石藓痕青，千古江湍洗不平。\n苍鹘飞来复飞去，不知身为此山名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30795,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游吴门同乐园疥池光亭壁呈使君张都承","author":"武衍","text":"一城和气万家春，金碧楼台处处新。\n太守不孤同乐意，木兰堂上看游人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30796,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"湖边","author":"武衍","text":"日日湖边上小车，要寻红紫醉年华。\n东风合与春料理，忍把轻寒瘦杏花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30797,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"湖亭席上赠商素","author":"武衍","text":"一曲春风已擅场，浅颦低啭更传觞。\n令人忆杀香山老，旧日玲珑也姓商。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30798,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雁奴","author":"武衍","text":"断沙残汐葑田枯，寂历寒烟卧雁奴。\n飞起不知何处落，数声蓦忽隔黄芦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30799,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"韩干照夜白 其二","author":"武衍","text":"振金喷玉出天闲，几向骊宫骤月还。\n脱使干生天宝后，画图那得到人閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30800,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"榴花","author":"武衍","text":"蹙蹙生红露滴珠，薰风凉幌晓妆初。\n折来戴朵频拈看，应讶罗裙色不如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30801,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蜡梅 其一","author":"武衍","text":"磬口檀心紫晕重，繁香微泄绣帘风。\n照花休用添红烛，却怕轻明暖易融。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30802,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蜡梅 其二","author":"武衍","text":"赋得姿容类至中，哨枝宿叶又春风。\n品题虽入江梅谱，可惜名同韵不同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30803,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"燕子","author":"武衍","text":"燕子搀风入画楹，不知人傍绿窗行。\n香泥惊落忽飞去，却向桐华顶上鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30804,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠苕上隐者","author":"武衍","text":"夹溪槐柳绿云堆，辙迹何尝到碧苔。\n不种桃花缘底事，恐因流水误人来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30805,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"霜梧","author":"武衍","text":"栖凤枝头数叶轻，井边篱落正关情。\n晚来纵有西风过，一片秋声作不成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30806,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书所怀","author":"武衍","text":"閒拂尘中镜，犹怜壁上梭。\n生平多坎壈，知己半销磨。\n对酒成孤酌，横琴寓九歌。\n相思江水阔，岁晚客如何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30807,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"示舵师","author":"武衍","text":"不拘早晚过长桥，要泊桥边踏巨鳌。\n无月色时方得睡，有梅花处必停篙。\n不逢水活鱼休买，才见溪清米便淘。\n到得旗亭须报我，落帆相与醉村醪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30808,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"边烽既息穑事告登歌以五十六字用和击壤","author":"武衍","text":"见说边头事已宁，捷书复得寿春城。\n从来方面多豪杰，均与朝廷系重轻。\n枣实虽红休北顾，稻花垂白近西成。\n民无饥色添欢色，气象方才似太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30809,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"刘后村被召","author":"武衍","text":"衔上官虽显，吟边兴不衰。\n细评南岳稿，远过后山诗。\n才大人多忌，名高上素知。\n瓣香吾敢后，幸见召环时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30810,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送徐云友归行都","author":"武衍","text":"落落奇男子，长年走客尘。\n白身无寸禄，青眼欠高人。\n病为思诗苦，贫缘立行真。\n片云留不住，归醉洛阳春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30811,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岁在丁亥郊禋礼成皇帝登门肆赦获睹盛典恭成口号","author":"武衍","text":"阊阖煌煌辟晓云，千官鹄立望严宸。\n鹤书飞下珠檐峻，雉扇分开玉座新。\n山寿声中团喜气，钧天奏处隔香尘。\n明王盛事民何幸，三载恩宽四海春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30812,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵答菊庄汤伯起","author":"武衍","text":"数弓蔬地一方池，吾爱吾庐祇自知。\n芦碧补交杨柳缺，柽红搀上藕花迟。\n翠阴围合疑无日，凉意萧骚剩有诗。\n君欲重来须更待，嫩烟浮动晚晴时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30813,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"访隐者居","author":"武衍","text":"藓磴披萝入，茅堂著竹遮。\n绿看流去水，红惜落残花。\n蜀鸟啼春静，山童厌客哗。\n细观题壁者，一一是诗家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30814,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"芦笋","author":"武衍","text":"春风荻渚暗潮平，紫绿尖新嫩茁生。\n带水掐来随手脆，棹船归去满篝轻。\n竹根稚子难专美，涧底香芹可配羹。\n风味祇应渔舍占，玉盘空厌五侯鲭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30815,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"京口策应戍将归营","author":"武衍","text":"老矣犹征调，新从淮上归。\n尽知边境事，曾解寿春围。\n腥血封刀匣，黄沙渍铁衣。\n奏功均得赏，沽酒醉斜晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30816,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"松陵晚泊","author":"武衍","text":"漭漭风涛外，天随底处寻。\n碧云千嶂暝，红树九秋深。\n故国荒城梦，空江倦客心。\n行藏那复计，篷月闯孤斟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30817,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"枫桥道中","author":"武衍","text":"路接官河柳行斜，蹇驴冲暑憩田家。\n雨馀天迥云生叶，日午风轻稻放花。\n袯襫已悬黄犊睡，桔槔不动绿阴遮。\n老翁相见如相识，命坐藜床自析瓜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30818,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"郊居纪实","author":"武衍","text":"既安能适复何疑，小筑重营即旧规。\n狡兔反为三窟累，鹪鹩终遂一枝期。\n种成水际芙蓉径，凿得亭前菡萏池。\n客有可人尊有酒，四时风月总相宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30819,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"哀魏方泉 其一","author":"武衍","text":"每见中吴士，多称太守贤。\n一毫无暴政，千里乐丰年。\n心醉西楼月，身飞北阙天。\n那知人事异，梦绝柳桥边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30820,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送友人赴长沙酒官","author":"武衍","text":"老枫残月晓江滨，送客归来又送君。\n愁滴离声三叠泪，眼穿行色万重云。\n过湘应取离骚续，到邑终期课最闻。\n莫为西班羞薄宦，要思先世立殊勋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30821,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送外家通倅方澹庵","author":"武衍","text":"风节传清素，名多为宦游。\n花封才解绶，芝检趣监州。\n等上持麾节，归来觐冕旒。\n江南与江北，底用说离愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30822,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送客之润赴时贵约","author":"武衍","text":"折柳亭边未问津，江山先入梦来频。\n漕渠水足新逢雨，客路风光恰是春。\n莫论孙刘悲既往，愿言宾主乐相亲。\n曾留短绝题多景，君到应须为拂尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30823,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送蕙坡赵富阳赴高邮元幕见次","author":"武衍","text":"相逢客里便相欢，握手真能出肺肝。\n买得酒尊曾共酌，带来诗卷每容看。\n旧闻游宦多知己，今喜公朝与好官。\n一片淮云千里月，觐圭何日入长安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30824,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏日书事","author":"武衍","text":"缓将琴轸卷将书，谁信閒中事有馀。\n约客论茶和水试，课童移菊带泥锄。\n竹栊日午犹关鹤，水槛朝来自喂鱼。\n山蓟已苗瓜已蔓，适安生计未全疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30825,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病目","author":"武衍","text":"病目医治两睫宽，迎风犹苦泪漫漫。\n水边望月虽无碍，灯下观书便觉难。\n索句每防愁入肾，好杯多是热归肝。\n法当著意收神观，不用金篦久自安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30826,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宿吕城舟中","author":"武衍","text":"古堞遗踪何处寻，断烟残日意沈沈。\n飞湍过闸风雷怒，峭岸如山草木深。\n灯火邻船喧客枕，江天漂梗碎乡心。\n明朝沽酒新丰市，怊怅无人伴苦吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30827,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄汤伯起","author":"武衍","text":"徙家城市去，不为故人留。\n种菊应无地，观山合起楼。\n别来通讯少，春至作诗不。\n池上双柽绿，孤吟我正愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30828,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄吴德章签判","author":"武衍","text":"莫转朱弦轸，知音世不悭。\n吟情清似水，壮志屹于山。\n自入乡关去，相思云树间。\n春风吹五叶，早趁集英班。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30829,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"悼戴式之","author":"武衍","text":"四海诗人说石屏，一时知己尽公卿。\n家传衣钵生无愧，气挟江湖老更清。\n重感慨时多比兴，最瑰奇处是歌行。\n九原不作空遗稿，三些吟魂泪为倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30830,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清明湖上","author":"武衍","text":"榆火初传禁漏残，满城和气在湖山。\n接天杨柳风烟里，照水桃花图画閒。\n旧路人穿新路去，长桥船出断桥还。\n吾皇应喜民胥乐，岁许西门入夜关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30831,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晴丝","author":"武衍","text":"何处飞来缭碧空，敲吟终日费形容。\n榑桑老茧抽纤纬，星殿残机剪素茸。\n蓦忽带归帘外燕，等閒惹住柳边蜂。\n风柔日薄楼台晚，一缕低垂力正慵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30832,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"湖亭席上","author":"武衍","text":"寒食梨花月，新晴杨柳风。\n愁融山色里，兴极酒杯中。\n绿发日夜变，青春今古同。\n忍教行乐处，容易夕阳红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30833,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢曹东圳跋吟卷","author":"武衍","text":"十年湖海仰师儒，八斗衣传子建馀。\n袖里有诗须印證，句中无眼定趑趄。\n吹香玉唾清如许，刮膜金篦病已除。\n媪扇何曾求贵重，等閒中得会稽书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30834,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]