[{"title":"捧香人","author":"王安礼","text":"绮席延佳士，香来似有情。\n当年漫拱默，终日费携擎。\n偶以朱蓝僣，还因刻画成。\n犹胜海上客，逐臭了平生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34493,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠道光法师","author":"王安礼","text":"闻名非一日，许见便忘年。\n宴坐得真际，与游无俗缘。\n杖藜寻古刹，洗钵试幽泉。\n稍寄钟山约，临风但慨然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34494,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"为爱","author":"王安礼","text":"为爱诗家景，分题昼幕褰。\n寒生洞庭石，翠滴华峰莲。\n刷羽天门过，潜鳞海窟眠。\n未饶元白辈，争购百金传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34495,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中父礼院学士挽词","author":"王安礼","text":"汉殿曾亲册，收科咫尺间。\n文成疾翻水，学富似登山。\n夷路方腾驾，重泉忽掩关。\n乡人洒泪送，犹想去车还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34496,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王夫人挽词二首 其一","author":"王安礼","text":"仙去还缑岭，丧行指洛川。\n松楸闲故垄，笳鼓咽新阡。\n制诏隆名定，铭诗具美传。\n王宫尽恩旧，雨泣望云軿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34497,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王夫人挽词二首 其二","author":"王安礼","text":"启国恩章称，颁恩典册徽。\n都人瞻卤簿，王子泣缞衣。\n落日随丹旐，悲风引素帏。\n西城供祖奠，惆怅昔游非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34498,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠别君重安抚太尉","author":"王安礼","text":"箫鼓纷纷倒酒樽，贤侯于此驻高轩。\n平明受诏辞龙阙，睿圣分忧在雁门。\n种落望尘迎汉使，吏民填道看王孙。\n一瞻车马人皆乐，宁识安边策略存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34499,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿直二首 其一","author":"王安礼","text":"天上春风水外寒，琉璃瓦湿月团团。\n千门纳钥尘飞远，一夕联文火禁宽。\n人想柝声来睥睨，鸟惊花影堕栏干。\n少陵老去唯便静，此地优容欲报难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34500,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿直二首 其二","author":"王安礼","text":"烛泪漼漼罢赋诗，幅巾乘兴步东西。\n银河逼夜光芒堕，玉宇参天次第迷。\n稍梦荆江三里鹄，忽惊汉殿五时鸡。\n平生出处无心较，亦似庄周万物齐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34501,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题灵壁兰皋张氏园亭","author":"王安礼","text":"池塘脉脉春泉动，亭馆阴阴夏木凉。\n砌叶乱风摇月色，檐枝留雪宿年芳。\n四时气象谁长见，一夜追游我太忙。\n从此与君携酒后，梦魂应不隔沧浪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34502,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵徽之学士马上口占","author":"王安礼","text":"料峭风来午漏迟，壁门䡾䡾敞轻支。\n侵寻出谷春莺啭，约略营巢社燕期。\n隐几稍同南郭嗒，滥巾未望北山移。\n值君佳句吟哦久，等是官曹得暇时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34503,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游齐山","author":"王安礼","text":"曾随嘉客在层峦，秋色阴晴一望间。\n洞外暂乘云缥缈，林端时露水湾环。\n维舟暇日来寻胜，经世高才却爱闲。\n闻说使君歌舞去，盛游应不减东山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34504,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"琼林苑赐燕饯别留守太尉辄继元韵","author":"王安礼","text":"名德从来重四夷，朝廷今日见官仪。\n陪祠自冠三公位，分陕犹为百辟师。\n金谷望尘多眷旧，琼林赐饯尽丞疑。\n都人喜看旂旄美，宁识勋庸在鼎彝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34505,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵仆射相公侍燕集英长句 其一","author":"王安礼","text":"天授嘉符帝祖宫，仙枝产秀福来崇。\n金茎对峙灵根固，云朵交升圣泽通。\n法驾留观知锡羡，从臣称庆未辞穷。\n诗人只解歌行苇，宁识君王造化功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34506,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵仆射相公侍燕集英长句 其二","author":"王安礼","text":"御沼环流瑞景长，集英宫殿紫宸旁。\n香随银漏留春色，花压琼筵斗日光。\n仙乐缓调瞻凤扆，天人高拱对龙章。\n皇家多庆千官喜，万岁声中献一觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34507,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日即席有题","author":"王安礼","text":"早是天涯多病客，可堪春末少年时。\n风流任使花王笑，欢乐除非酒伯知。\n荆岫定为郊社器，渭川终作帝王师。\n琅玕未实烟空老，不恨年来紫凤饥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34508,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"七言一章赠别吴兴太守中父学士兄","author":"王安礼","text":"蓬山仙子任天真，乞领南麾奏疏频。\n金锁阙边辞黼座，水晶宫里得朱轮。\n公庭事简烦丞掾，斋阁诗多泣鬼神。\n莫为行春恋苕霅，銮坡挥笔待词臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34509,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送卢大雅赴阙","author":"王安礼","text":"箫鼓纷纷载酒醪，送行汾水觉秋高。\n吏民遮道瞻思切，车马还朝气势豪。\n圣主询谟忘旰昃，明庭收选尽英髦。\n看君才业何人似，哿矣趋荣勿告劳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34510,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送吕陶赴阙","author":"王安礼","text":"赋比相如巳绝伦，即论才识又名臣。\n致身可但诸公右，发策宜为上国珍。\n今日朝廷思谠直，一时贤俊待经纶。\n行看致主唐虞术，与笑淄川曲学人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34511,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送子玉赴阙","author":"王安礼","text":"寂寞扬雄与世疏，赖逢佳友慰穷居。\n深沉智虑三冬学，磊落胸怀万卷书。\n自古贤豪今日盛，看君才调几人如。\n还朝好作登瀛客，闻说元臣荐子虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34512,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和踏青","author":"王安礼","text":"踏青争惜赏春葩，尽日无辞到月华。\n金谷正宜开锦帐，曲江翻想映毡车。\n侠卿酝藉歌飞雪，游女娉婷脸夺花。\n更咏汉宫传蜡烛，青烟散入五侯家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34513,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清明日赐宴琼林苑奉酬宫使太师相公","author":"王安礼","text":"清明春律十分回，草色连云花尽开。\n禁籞幸随诸彦入，安车仍赐上师陪。\n百壶未许都门饯，九奏先从帝所来。\n鱼钥恩留方锡劝，柳边迟日莫相催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34514,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送吴殿中知景陵","author":"王安礼","text":"柘上论功使节临，奏书倾动士人林。\n沙墀通籍沾新宠，泽国鸣弦试好音。\n郭畔黄芦宜日晚，水边红橘与秋深。\n君才八九吞云梦，应笑离骚向此吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34515,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠无为张居士","author":"王安礼","text":"余学无为无所成，每闻风论便神清。\n乡人来问真如理，居士能忘物我情。\n胜业久应三界护，妙言非止百金轻。\n世途多少冥行客，好与分明说化城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34516,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过王整状元墓寄薛唐卿郎中","author":"王安礼","text":"始任监州便殒身，我来临奠重悲君。\n一名曾冠千人榜，三尺翻如百姓坟。\n古木带风号晚照，野花和雨泣秋云。\n贤侯若为刊碑碣，乞取东床内翰文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34517,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"恭和御制上元观灯","author":"王安礼","text":"銮舆清晓出瑶台，羽卫瞻迎扇影开。\n凤阙张灯天上坐，鸡林献曲海边来。\n修文可笑秦无策，能赋休誇楚有才。\n星汉末斜钧乐阕，君王宣示万年杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34518,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谨赋五言一章赠别致政太师","author":"王安礼","text":"封国营邱近，行胪洛水浑。\n位齐师尚父，名重相公孙。\n勋业归宗祏，威声寄塞垣。\n安居今日老，魏阙此心存。\n祖燕临华省，赓歌屈至尊。\n里门多喜色，云汉在瑶琨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34519,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"奉和留守太尉赐燕玉津图","author":"王安礼","text":"将相仪刑久，师儒典册新。\n乘车朝魏阙，铭鼎颂舆人。\n高会开名苑，多欢浃辅臣。\n仙葩分巨丽，宸藻赐全醇。\n自昔脩天爵，平时秉国钧。\n谁如始终遇，奕叶荷君仁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34520,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上王端明生日","author":"王安礼","text":"梦帝资良辅，生申恊圣期。\n妙龄谈国体，初筮得家规。\n侃侃当官色，循循待士辞。\n法冠曾触佞，谏纸讵容私。\n外历蕃宣久，归参待从宜。\n政声虽召杜，学术本皋夔。\n业履今安匹，贤劳上所知。\n都畿重尹正，延阁旧论思。\n治出诸公右，经为大帝师。\n三边更惠爱，一体系安危。\n羌虏跳西夏，朝家念北陲。\n秘庭还旧秩，左辖正新仪。\n暂屈并门重，其苏晋国饥。\n指麾柔旅拒，谈笑妥茕嫠。\n邺邑祠河急，荆州祷雨迟。\n怒波回潬碛，旱种变京坻。\n道与千龄遇，身将百禄随。\n民瞻方有裕，天宠盖无疑。\n俊乂思皇日，钦明乐胥时。\n缁衣如宠庆，愿续武公诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34521,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄君重安抚太尉","author":"王安礼","text":"三伏重冰上五台，葡萄生摘荐新醅。\n雁门太守佳公子，应喜王孙拥节来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34522,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日感怀","author":"王安礼","text":"柳亭暮霭笼金眼，茶岭寒轻卓翠旗。\n春色正浓人未老，掷觞飞笔好追随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34523,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清明日赐宴琼林苑奉酬宫使太师相公 其一","author":"王安礼","text":"几年留滞起边愁，只忆家园烂熳游。\n今日西来更愁索，却令人意忆并州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34524,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清明日赐宴琼林苑奉酬宫使太师相公 其二","author":"王安礼","text":"戎鼙声里冷云秋，投老难堪此段愁。\n说似旁人都不管，待凭书劄到并州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34525,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清明日赐宴琼林苑奉酬宫使太师相公 其三","author":"王安礼","text":"月墀绣屐想无踪，庭户新凉绿簟空。\n寄语金泥旧裙衩，莫教放尽石榴红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34526,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西江月","author":"王安礼","text":"梅好惟嫌淡泞，天教薄与胭脂。\n真妃初出凤皇池。\n酒入琼肌半醉。\n东阁诗情易动，南楼玉管休吹。\n北人浑作杏花疑。\n惟有青枝不似。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34527,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新居成呈刘君玉殿院","author":"邵雍","text":"履道坊南竹径脩，绿杨阴裹水分流。\n众贤买得澄心景，独我居为养志秋。\n若比陈门诚已僭，敬陪颜巷亦堪忧。\n无端风雨虽狂暴，不信能凌沈隐侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34528,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闲居述事 其三","author":"邵雍","text":"初晴月向松间出，盛暑风从水面来。\n己比他人多数倍，况能时复举樽罍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34529,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"归洛寄郑州祖择之龙图","author":"邵雍","text":"恩深骨髓谓慈亲，义重丘山是故人。\n归过嵩阳旧游地，白云收得薜萝身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34530,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄李景真太博","author":"邵雍","text":"花前静榻闲眠处，竹下明窗独坐时。\n著甚语言名宇泰，林间自有翠禽知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34531,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"招司马君实游夏圃","author":"邵雍","text":"雨霁景自好，秋深天未寒。\n可能乘兴否，夏圃一盘桓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34532,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"安乐窝中吟 其二","author":"邵雍","text":"安乐窝中事事无，唯存一卷伏羲书。\n倦时就枕不必睡，欢后携筇任所趋。\n准备点茶收露水，堤防合药种鱼苏。\n苟非先圣开蒙吝，几作人间浅丈夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34533,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"笺年老逢春诗","author":"邵雍","text":"年老逢春春莫疑，老年才会惜芳菲。\n自知一赏有分付，谁让万金无孑遗。\n美酒饮教微醉后，好花看到半开时。\n这般意思难名状，只恐人间都未知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34534,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢君贶宣徽用少微今已应星文","author":"邵雍","text":"一字诗中义未分，少微今已应星文。\n闲人早是无凭据，更与闲人开后门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34535,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三皇吟","author":"邵雍","text":"三皇之世正熙熙，乌鹊之巢俯可窥。\n当日一般情味切，初春天气早晨时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34536,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"依韵和王安之少卿六老诗仍见率成七首 其一","author":"邵雍","text":"六老皤然鬓似霜，纵心年至又非狂。\n园池共选何妨胜，樽俎相欢未始忙。\n杖屦烂游千载运，衣巾浓惹万花香。\n过从见率添成七，况复秋来亦渐凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34537,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"坐右吟","author":"邵雍","text":"万化备于身，直须资养深。\n因何为宝鉴，只被用精金。\n酒少如茶饮，诗多似史吟。\n颜渊方内乐，天下事难任。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34538,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观事吟","author":"邵雍","text":"一岁之事勤在春，一日之事勤在晨。\n一生之事勤在少，一端之事勤在新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34539,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"穷达吟","author":"邵雍","text":"穷不能卷，达不能舒。\n谓之知道，不亦难乎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34540,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"感事吟","author":"邵雍","text":"为善大宜量力分，知机都在近人情。\n人情尽后疑难入，力分量时事自平。\n理顺面前皆道路，义乖门外是榛刑。\n何人肯认此言语，此语分明人不听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34541,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"知人吟","author":"邵雍","text":"君子知人出于知，小人知人出于私。\n出于知，则同乎理者谓之是，异乎理者谓之非。\n出于私，则同乎己者谓之是，异乎己者谓之非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34542,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"左衽吟","author":"邵雍","text":"自古禦戎无上策，唯凭仁义是中原。\n王师问罪固能道，天子蒙尘争忍言。\n二晋乱亡成茂草，三君屈辱落陈编。\n公闾延广何人也，始信兴邦亦一言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34543,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"时事吟 其一","author":"邵雍","text":"时之来兮，其势可乘。\n时之去兮，其事遂生。\n前日之事兮，今日不行。\n今日之事兮，后来必更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34544,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"窥开吟 其二","author":"邵雍","text":"物理窥开后，人情照破时。\n能将函谷塞，只用一丸泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34545,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"窥开吟 其三","author":"邵雍","text":"物理窥开后，人情照破时。\n正如携宝剑，切玉过如泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34546,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"窥开吟 其四","author":"邵雍","text":"物理窥开后，人情照破时。\n渴多逢美酒，病后遇良医。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34547,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"窥开吟 其五","author":"邵雍","text":"物理窥开后，人情照破时。\n能将一个字，善解百年迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34548,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"窥开吟 其六","author":"邵雍","text":"物理窥开后，人情照破时。\n情中明事体，理外见天机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34549,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"窥开吟 其七","author":"邵雍","text":"物理窥开后，人情照破时。\n可嗟兼可唾，堪鄙又堪嗤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34550,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"窥开吟 其九","author":"邵雍","text":"物理窥开后，人情照破前。\n止堪今执笔，不可使持权。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34551,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"窥开吟 其十一","author":"邵雍","text":"物理窥开后，人情照破时。\n欲知花烂漫，须是叶离披。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34552,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"窥开吟 其十二","author":"邵雍","text":"物理窥开后，人情照破时。\n有权能处置，更狡待何为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34553,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"洛阳春吟 其七","author":"邵雍","text":"春归必竟归何处，无限春冤都未诉。\n欲托流莺问所因，子规又叫不如去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34554,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观物吟","author":"邵雍","text":"水雨霖，火雨露，土雨濛，石雨雹。\n水风凉，火风热，土风和，石风冽。\n水云黑，火云赤，土云黄，石云白。\n水雷云，火雷虩，土雷连，石雷霹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34555,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"病亟吟","author":"邵雍","text":"生于太平世，长于太平世，老于太平世，死于太平世。\n客问年几何，六十有七岁。\n俯仰天地间，浩然无所愧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34556,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"壮观","author":"米芾","text":"临南山猗陟北岵，抚壮胜猗遗万古。\n漫漫苍苍穹无所，奕奕嶪嶪踪奇度。\n逶迤猗前征，盘礴猗后驻。\n奋迅猗奔驶，却约猗畔顾。\n环旋猗抱卷，引伸猗就旅。\n雾释猗离掩，云乘猗平举。\n瞭瞭猗蟾辉，悒悒猗蒸雨。\n郁郁猗阳春，莽莽猗玉露。\n爚爚猗午停，翳翳猗酉去。\n领吾侪猗并舆步，却飞仙猗不遐慕，癯其形猗久何苦。\n便莫便猗遵坦路，适莫适猗破心阻。\n乐莫乐猗频会遇，莫莞藤猗撷芳藇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34557,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"涟漪瑞墨堂书","author":"米芾","text":"陟巘不自期，孤云挂松顶。\n一揖不相期，飞云无留影。\n云已去，泉更长。\n云泉毕世友，相得每相忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34558,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晋陵龙挂行","author":"米芾","text":"万声齐呼一声嚇，东望苍旻两龙挂。\n浩浩随云百川倒，隐隐雷车千两驾。\n疲农望天手加颡，怕歉求丰心惘惘。\n老龙甲坼血流莽，取水虽多旱弥广。\n暴尪囚魃精诚微，赫赫炎曦一轮榜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34559,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]