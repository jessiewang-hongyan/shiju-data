[{"title":"送能首座住紫箨","author":"释慧远","text":"驱耕夺食继心灯，互换交驰货物增。\n道大莫知空冀北，功恢高揖岭南能。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21851,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"钱知县祈嗣求颂","author":"释慧远","text":"明珠在掌犹遗坠，辉玉囊中不失时。\n幸有观音玉环手，何劳更诵梦熊诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21852,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十五首 其十四","author":"释慧远","text":"山花如锦水如蓝，亲见文殊接话谈。\n十字街头轻一拶，前三三对后三三。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21853,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十五首 其十三","author":"释慧远","text":"明暗双双照用分，几人亲到孟尝门。\n街头不识真弥勒，却向灵山问世尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21854,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十五首 其十二","author":"释慧远","text":"南北东西老赵州，见人骑马也骑牛。\n清风月下寻归路，夫子门前问孔丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21855,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十五首 其十一","author":"释慧远","text":"换手搥胸哭老爷，棺材未出死尸斜。\n不如掘地深埋却，管取来年吃嫩茄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21856,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十五首 其十","author":"释慧远","text":"佛性分明脱有无，醋酸何用挂葫芦。\n薄雾轻烟留不住，扁舟已过洞庭湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21857,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十五首 其四","author":"释慧远","text":"见处孤危立处高，急如石火利如刀。\n到家问路家何在，掀倒棋盘脱布袍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21858,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十五首 其一","author":"释慧远","text":"老胡一击许谁知，大冶红炉片雪飞。\n青草冢间留不住，白云还望故山归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21859,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十五首 其二十","author":"释慧远","text":"楚王城畔水东流，独脚山魈趯气毬。\n贪看六么花十八，不知船子下扬州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21860,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十五首 其四十二","author":"释慧远","text":"飘飘一雁落寒空，步步追空觅雁踪。\n蹋破草鞋跟已断，巍然独坐大雄峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21861,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十五首 其一","author":"释慧远","text":"未离兜率降王宫，便就刀山入镬汤。\n等闲擒下白拈贼，满眼俱为败露赃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21862,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十五首 其三十六","author":"释慧远","text":"更深夜静好商量，携手相将入醉乡。\n姹女已归霄汉去，呆郎何事守空房。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21863,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十五首 其三十八","author":"释慧远","text":"门外雨滴声，家和万事成。\n归来无一物，令人忆镜清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21864,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十五首 其三十七","author":"释慧远","text":"无位真人赤肉团，电机旋掣走珠盘。\n金刚正眼泥弹子，烈燄光中侧足看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21865,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十五首 其二十六","author":"释慧远","text":"汲水佳人立晓风，青丝放尽辘轳空。\n银瓶触破红妆面，零落桃花满井红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21866,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十五首 其二十五","author":"释慧远","text":"父严子逆事犹乖，宣德楼前问李差。\n断头剖腹从轻断，直待还魂合处埋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21867,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十五首 其八","author":"释慧远","text":"咄咄瞎驴趁大队，眨上眉毛佛不会。\n白云断处是青山，行人更在青山外。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21868,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十五首 其十","author":"释慧远","text":"参天白刃赤身挨，李顺王均破草鞋。\n德山智量过君子，活捉生擒立地埋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21869,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十五首 其四十一","author":"释慧远","text":"暑往寒来春复秋，夕阳西去水东流。\n将军战马今何在，野草闲花满地愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21870,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十五首 其二十四","author":"释慧远","text":"膏肓未必两边寻，好是良医双下针。\n死活不能全忌口，丧车背后念观音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21871,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十五首 其十九","author":"释慧远","text":"不是风幡动，亦非仁者心。\n自从胡乱后，淈?到而今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21872,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十五首 其七","author":"释慧远","text":"时临孤岛畔，拭目望蓬莱。\n空山无人处，水流花自开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21873,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十五首 其四","author":"释慧远","text":"家常待客劝三杯，鸩酒不消吃一盏。\n当时裂破夜叉头，顶门突出醯罗眼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21874,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十五首 其四十","author":"释慧远","text":"神前拨帐问西来，直截当机指酒台。\n赤体袒肩头面礼，祸从天降不生灾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21875,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十五首 其二十一","author":"释慧远","text":"神仙秘诀妙难传，秃顶脩罗打左拳。\n半夜归来无觅处，忍饥高卧饭箩边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21876,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十五首 其十八","author":"释慧远","text":"率陀天上翻筋斗，酆毕罗都汩碖眠。\n醉后归来明月夜，笙歌引入画堂前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21877,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十五首 其三十","author":"释慧远","text":"等闲饶舌话金襕，便与当头倒刹竿。\n从此天伦转无义，冷光犹自逼人寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21878,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十五首 其九","author":"释慧远","text":"浓云泼墨半遮山，碎雨跳珠乱入船。\n卷地风来忽吹散，望湖楼下水如天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21879,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈八首 其五","author":"释慧远","text":"滴水冰生分外寒，冻云环合锁峰峦。\n根尘不昧心珠露，眨上眉毛子细看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21880,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其七十二","author":"释慧远","text":"梦魂飞锡下天台，疑是佗方应供来。\n石室乍归于雾冷，海山风月满楼台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21881,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其一","author":"释慧远","text":"千尺身中丈六衣，斩新拈出恰相宜。\n长针短线君看取，节角请讹我自知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21882,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其六十三","author":"释慧远","text":"容路如天远，情忘道义深。\n虚空无向背，何处觅家音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21883,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其十五","author":"释慧远","text":"南山匼匝云遮日，西坞逡巡水满塘。\n三日不来成话霸，叶公若在□郎当。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21884,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其四十一","author":"释慧远","text":"瞎堂也有三个诀，靠倒云门乾屎橛。\n一双白大吃泥鳅，两个鹭鸶吞石蠮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21885,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其十","author":"释慧远","text":"醉翁亭畔寒梅折，庶子泉边瑞雪铺。\n不二法门从此入，更于何处觅文殊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21886,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其三十一","author":"释慧远","text":"人天道大梅阳老，佛祖功恢临济宗。\n赤手擘开无字印，冤家何处不相逢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21887,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其四十四","author":"释慧远","text":"陕府铁牛口门窄，嘉州石佛耳轮长。\n惊起暮天沙上雁，海门斜去两三行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21888,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其八十四","author":"释慧远","text":"水满花肥春正长，东君作意脑愁肠。\n同风未必如吾蜀，鼻观先闻荔子香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21889,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其二十八","author":"释慧远","text":"新罗国里打斋钟，稳泛灵槎到月宫。\n仙侣不知何处去，秋声依旧著梧桐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21890,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其十三","author":"释慧远","text":"先师□住独龙山，四十馀程自买船。\n今日琅琊归普济，借婆裙子拜婆年。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21891,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其二十五","author":"释慧远","text":"老胡诞生四月八，韶阳乱棒打不杀。\n如今纵得十分全，顶门正眼依前瞎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21892,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其九十九","author":"释慧远","text":"浓云泼墨无回互，疾燄过风不可窥。\n赖有金华慈悯力，火坑化作白莲池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21893,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其九十一","author":"释慧远","text":"天书下十诏，云恩飞九重。\n万邦归正化，千载一遭逢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21894,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其二十","author":"释慧远","text":"竹杖轻携离婺女，云衣高捲上仙霞。\n五湖四海休云别，南北东西六一家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21895,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其二十一","author":"释慧远","text":"愧我金鳞困守株，误佗禅寂远招呼。\n中途再领贤使命，定业难逃住子湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21896,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其七","author":"释慧远","text":"佛祖由来总是冤，电机旋处直如弦。\n金毛若解和声拶，月里麒麟笑揭天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21897,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其二","author":"释慧远","text":"龙幡胜槩落群峰，水石清奇叠万重。\n燕坐不辞提祖令，微躯那更继前踪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21898,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其二十六","author":"释慧远","text":"大道忘情绝去留，天伦何处觅踪由。\n七星利剑当锋按，八臂那吒辊绣毬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21899,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其九十六","author":"释慧远","text":"青苍山色挼蓝翠，潋滟湖光照眼新。\n珍重导师居此地，颓纲振举是其人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21900,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其七十三","author":"释慧远","text":"曾到未到俱吃茶，不在沾唇眼便花。\n若是谢家船上客，肯来平地摝鱼虾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21901,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其九十五","author":"释慧远","text":"托迹但知忘世故，栖芦何事不容闲。\n已能蹑足龙门过，试把轮钩飏碧湾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21902,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其五","author":"释慧远","text":"如来不说无馀说，迦叶无闻无异闻。\n体得无闻无说说，玉石难分亦自分。\n国恩佛恩总报，人王法王道存。\n仰祝圣明逾日月，更祈睿算等乾坤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21903,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄中竺妙禅师","author":"释慧远","text":"湖山添得老魔王，舌卷风雷眼放光。\n背却法堂重勘破，不知谁与我分赃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21904,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄体首座","author":"释慧远","text":"白石山头衲子多，泥牛吸尽井中波。\n佗年布袋重开口，佛祖依前不奈何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21905,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄杨高士","author":"释慧远","text":"富有十年别，贫无一觉眠。\n好来同夜话，相共酌清泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21906,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄汪状元","author":"释慧远","text":"全机倒用若为酬，尽法无民未肯休。\n金马玉堂留不住，依前屋里贩扬州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21907,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄道场全和尚","author":"释慧远","text":"雪顶昆崙著意猜，十头罗刹笑颜开。\n镬汤冷处君先入，浒眼横时待我来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21908,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄骥禅人","author":"释慧远","text":"姑苏台畔恶相从，海涌峰前事亦同。\n故国梦回春已走，水云相望一帆风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21909,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"船子和尚赞 其一","author":"释慧远","text":"老手当年靠夹山，全机丧尽结深冤。\n父南子北家何在，拨转天关地轴翻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21910,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其九十四","author":"释慧远","text":"风捲云天小艇斜，烟波深处作生涯。\n丝纶掣断双关手，抉出骊龙眼里沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21911,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游刘阮洞","author":"释慧远","text":"云深露冷无人到，小径阴云翠欲迷。\n吊罢神仙古时迹，乱峰影里听猿啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21912,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答松窗居士","author":"释慧远","text":"万机消烁眼头空，一点不来谁与同。\n未问维摩先杜口，如何作得住山翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21913,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答葛通判","author":"释慧远","text":"醯罗正眼尘中现，列祖玄机格外提。\n打鼓看来冤未雪，从来赤土画团箕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21914,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"葛通判请益非心非佛因缘以偈示之","author":"释慧远","text":"即心即佛眉拖地，非佛非心双眼横。\n蝴蝶梦中家万里，子规枝上月三更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21915,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"楞严六根 其二 无耳能闻","author":"释慧远","text":"跋难陀龙能听闻，净名结舌若为论。\n行到水穷山尽处，虚空依旧塞乾坤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21916,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"楞严六根 其三 无鼻嗅香","author":"释慧远","text":"殑伽河神非鼻香，贫儿乍富也寻常。\n莲河岸上曾遭叱，祸出私门变吉祥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21917,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"楞严六根 其五 非身觉触","author":"释慧远","text":"舜若多非身觉触，闭门塞户栽荆棘。\n邈得虚空恰似渠，似渠也是闲相识。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21918,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"楞严六根 其一 非眼能见","author":"释慧远","text":"阿那律陀天眼观，大千摄入一毫端。\n掌中谩说庵摩勒，无限苍生被热谩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21919,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"瞎堂三句 其二","author":"释慧远","text":"我有截水停轮句，人天路绝信来稀。\n等闲靠却过头杖，门里深沙眼■■。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21920,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"瞎堂三句 其三","author":"释慧远","text":"我有和烟钓月句，山摧海竭是生涯。\n到头贫富知恩少，收拾归来总一家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21921,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"镜庵","author":"释慧远","text":"古镜破来庵许大，秋毫未尽眼能宽。\n江湖不记三生梦，风月惟馀一钓竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21922,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"双林无著轩","author":"释慧远","text":"卓尔群机赴，陶然万象沈。\n湖天浮水远，岸石浸云深。\n雨霁月华透，风摇山影侵。\n灵然超八达，廓彻妙明心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21923,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示化士 其五","author":"释慧远","text":"顾在机前发，鉴从顾后抽。\n法身藏北斗，船子下扬州。\n四海风为线，三山月作钩。\n回戈拨龙尾，伫看钓鳌头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21924,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十五首 其三十二","author":"释慧远","text":"眼目高低鼻孔横，浅深轻重不多争。\n蠓䗈虿上挨肩入，鸑鷟牙根借路行。\n便把长河搅酥酪，敢将粟柄作禾茎。\n后山未是潜身处，出没任佗乌兔更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21925,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其四十","author":"释慧远","text":"新岁有来由，烹茶上酒楼。\n一双无两脚，半个有三头。\n突出神难辨，相逢鬼见愁。\n倒吹无孔笛，促拍舞梁州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21926,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其八十九","author":"释慧远","text":"门外春将半，岩花带雨开。\n信从天外至，人自日边来。\n虎啸风生谷，龙吟雾满腮。\n相逢眉盖眼，平地舞三台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21927,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]