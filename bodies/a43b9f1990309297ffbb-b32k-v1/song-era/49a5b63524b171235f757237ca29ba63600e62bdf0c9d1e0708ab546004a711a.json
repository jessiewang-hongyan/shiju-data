[{"title":"送方德和大镛赴漕","author":"王迈","text":"好风昨夜作秋天，吹送雏鹓上紫烟。\n慈母整裘颜有喜，难兄提钵面相传。\n策勋胄榜特馀事，努力巍科趁壮年。\n直数重阳到端午，快聆三捷凯歌还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14658,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送方潜仲入太学","author":"王迈","text":"英气轩轩贯斗牛，春风匹马辟雍游。\n家庭竞秀三株树，伯仲相交五凤楼。\n回首白云添旧感，细听夜雨入新愁。\n妙年唾掌收科第，会有欧公避一头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14659,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送会之梦龙赴南安尉","author":"王迈","text":"儒生十九谙吏事，君自胸中有八窗。\n好去褆身师长吏，谨毋泄迩薄邻邦。\n政声要重车渠百，祥兆须来鸂鶒双。\n自笑悭囊无可赆，篇诗独不美羊腔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14660,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送傅一新西上","author":"王迈","text":"此去兰宫好策勋，子行真足张吾军。\n大鹏怒奋溟南翼，骏马鸣惊冀北群。\n直要安排医国策，不徒戏作送穷文。\n逢人有问狂生者，为说忧时已白纷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14661,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送刘无竞克逊司门赴召三首 其三","author":"王迈","text":"更化仅如许，和戎觉又非。\n边陲风色恶，人物晓星稀。\n国事迷当局，时贤赴急机。\n周嫠空愤切，不虑岁无衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14662,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送刘无竞克逊司门赴召三首 其二","author":"王迈","text":"上了朱轓最，催还白玉京。\n兄怜子由别，母劝器之行。\n医国言须切，谋身策尚平。\n友朋空爱助，君自有权衡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14663,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送刘无竞克逊司门赴召三首 其一","author":"王迈","text":"吾郡称多士，君家总俊游。\n仲方在閒散，伯又袭编修。\n道与时升降，宾随主去留。\n邮亭还祖饯，别意爽于秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14664,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送朱君锡圭尉德化二首 其二","author":"王迈","text":"邻邑宜初宦，轻轩最便家。\n亲颜悦萱草，诗料有梅花。\n佳兆双飞鶒，夷途万里骅。\n好培经世业，他日步清华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14665,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送朱君锡圭尉德化二首 其一","author":"王迈","text":"鼓箧游环璧，如君最妙龄。\n阿㜷开绛幔，大阮共炉亭。\n力学案堆雪，收科蛰奋霆。\n莫嫌梅市小，有路透青冥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14666,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送朱典卿履常上舍西上","author":"王迈","text":"天庠教育总英游，文行惟君擅两优。\n玉润珠明盈咳唾，兰薰雪白见操修。\n老天不错须开眼，朱吏相逢定点头。\n月里一枝高斫处，向来我已为君留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14667,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送吴梦大监税赴潮州圃湾二首 其二","author":"王迈","text":"一命官无小，心思及物同。\n高风超俗见，只手救人穷。\n宦路梅花白，亲庭萱草红。\n贤明尤易事，最喜遇南丰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14668,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送吴梦大监税赴潮州圃湾二首 其一","author":"王迈","text":"诗礼名家子，铮铮早有声。\n右班聊借径，在计更司征。\n霜日孤标净，湖山一鬨平。\n图南九万里，此去是头程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14669,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送吴魁君谋叔告赴召二首 其二","author":"王迈","text":"盛名之下最难居，一节清忠自有馀。\n竖铁脊梁须我辈，横金腰带听伊渠。\n和戎自古迷当局，善类何时可得舆。\n抗论朝廷须正大，莫如乡党费分疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14670,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送吴魁君谋叔告赴召二首 其一","author":"王迈","text":"三载天庭出一魁，一魁岂是利名媒。\n熙宁如叶庸人耳，南渡惟张君子哉。\n胪唱若为调众论，囊封正要看人才。\n千年青史芬芳远，过眼浮荣付傥来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14671,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送张柔翁必强西上","author":"王迈","text":"说诗匡鼎笔如椽，此去云霄稳着鞭。\n富贵恰当年五十，扶摇快上路三千。\n乃翁积种今归子，是理乘除信有天。\n梅友面传衣钵好，题名更向万人前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14672,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送张能父天定赴瑞州教二首 其二","author":"王迈","text":"太学穿杨巧，青春斫桂荣。\n心灯传老宿，文印授诸生。\n德履华嵩重，襟期玉雪清。\n君王他日问，张姓复其名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14673,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送张能父天定赴瑞州教二首 其一","author":"王迈","text":"孟子称三乐，广文兼有之。\n寿椿齐百岁，常棣秀连枝。\n初筮筠江郡，尊为芹泮师。\n英才需教育，远业立镃基。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14674,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送良沃州赋得石上松","author":"王迈","text":"南山岩石上，郁郁长青松。\n樛枝全似铁，老干半成龙。\n法雨流根润，慈云护影重。\n吾师挂锡处，苔藓近来封。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14675,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送陈汝功起宰永春二首 其二","author":"王迈","text":"一第垂三纪，卿评占得多。\n生涯似韦布，谈笑试弦歌。\n夏校士师道，春台民饮和。\n政成行奏最，好去立言坡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14676,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送陈汝功起宰永春二首 其一","author":"王迈","text":"通了金闺籍，须教邑债还。\n尚威民作敌，徙善吏容奸。\n世久无彭泽，人今识鲁山。\n平生经济学，随力救时艰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14677,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送陈宗谕进叔晋接赴庆元添倅及乃弟泰来四首 其四","author":"王迈","text":"玉季吾心友，经行话旧游。\n定知龙有种，又快鹗横秋。\n对策空丹臆，为兄赛一筹。\n功名相迫遂，只许片时留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14678,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送陈宗谕进叔晋接赴庆元添倅及乃弟泰来四首 其三","author":"王迈","text":"若见青山老，烦言仆寄声。\n入新无好况，依旧是狂生。\n国事今如许，庸医见亦惊。\n不知灵寿杖，还解拄天倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14679,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送陈宗谕进叔晋接赴庆元添倅及乃弟泰来四首 其二","author":"王迈","text":"谩说题舆乐，谁知忧国心。\n城狐方伺隙，边马已如林。\n去上缇屏最，行陈丹扆箴。\n脂韦何足算，百炼是精金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f8