[{"title":"兴化县","author":"刘克庄","text":"绕县百千峰，初疑路不通。\n居民犹太古，令尹似春风。\n筝远呼难至，杯寒吸易空。\n却从归路望，飞榭半天中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31175,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三和 其一","author":"刘克庄","text":"断无小妾坐金鞯，且伴诸孙垦纸田。\n天子尤尊方外者，少陵盛说饮中仙。\n宫花毕竟非真色，朝菌安知有大年。\n牧竖和声侬倡首，管他王后与卢前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31176,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再次竹溪韵","author":"刘克庄","text":"聊为汤饼会亲宾，岂敢誇张堕地麟。\n汝若上扳曾大父，翁堪下见我先人。\n善和书即传家宝，儒行篇方聘席珍。\n莫遣父兄被嗤笑，金根谬改作金银。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31177,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再次竹溪韵三首 其三","author":"刘克庄","text":"小词落拓逼希真，未典春衣未是贫。\n穷肯磷缁久幽操，老犹熏沐不赀身。\n营巢燕熟飞来旧，脱裤禽痴唤著新。\n蜀口尘清江浪白，息头重作太平人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31178,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再次竹溪韵三首 其二","author":"刘克庄","text":"健笔当年奡可排，岂知老挟病俱来。\n芋梨煨熟曾分啖，榾柮烧残共画灰。\n伏壁尚堪传学者，虞廷犹记和康哉。\n向时同辇诸君子，输与村翁早乞骸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31179,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再次竹溪韵三首 其一","author":"刘克庄","text":"谁云子建卷波澜，诗到黄初最可观。\n无奈中衰变风起，不应例作晚唐看。\n煎胶粘莫教春去，秉烛游谁管夜阑。\n纵有閒愁天样大，此翁烂醉不相干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31180,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再和 其二","author":"刘克庄","text":"鹄袍再著姑行法，雁塔重来定策名。\n大尹前呵宽贾岛，相君十反访州平。\n故溪旧有钓鱼石，平地今多陷马坑。\n不信天公囚两鸟，一鸣会遣百虫惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31181,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再和 其二","author":"刘克庄","text":"依本文章趁韵诗，暮年深不愿人知。\n退閒时有宾留刺，挛痹难为长折枝。\n蚓窍声微羞入社，鸦涂札恶懒临池。\n僧谈石竺山幽胜，拟执驴鞭挟册随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31182,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再和 其二","author":"刘克庄","text":"世味浇漓酒趣深，对花无客亦孤斟。\n饥来肯羡乞墦食，贫杀不贪谀墓金。\n耄齿未妨师抑戒，高谭何似守规箴。\n吾今会得逍遥义，懒访曹溪问少林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31183,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再和 其一","author":"刘克庄","text":"动而得谤亦名随，生子看来不必奇。\n尔辈真堪畀豺虎，君王安用猎熊罴。\n人言李白文如锦，谁信卢能命若丝。\n回首世间机阱恶，子归闭户有馀师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31184,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再和 其一","author":"刘克庄","text":"从来粪土轻胡赵，晚视渠侬直唯阿。\n时与客联烘虱句，断无人听饭牛歌。\n挂冠耄及收身晚，赐扇恩深取数多。\n周易鲁论俱束閤，免教后世罪王何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31185,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再和 其一","author":"刘克庄","text":"刬骑犊子不施鞯，老退犹堪学力田。\n疏大夫金虽已散，蔺相如璧偶然全。\n黄河水有曾清日，白发人无再少年。\n许大乾坤愁塞满，觅无愁处只樽前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31186,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再和二首 其二","author":"刘克庄","text":"少小从军事裤靴，祇今庙算主通和。\n胡来复去兔三窟，民散未收蜂一窝。\n病觉风光于我薄，老知书册误人多。\n罪言著就深藏取，自笑狂生壮志蹉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31187,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再和二首 其一","author":"刘克庄","text":"包羞羊借皋比盖，饰貌狙将衮服披。\n妾去绿衣裳以曲，佗乘黄屋髻犹椎。\n方开元际唐风盛，自建安来汉道衰。\n举世纷纷学姚贾，老夫持此欲安之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31188,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再和二首 其一","author":"刘克庄","text":"借屋城中又一春，桃符万口说清新。\n向来曾上庆历颂，老去甘为元祐人。\n健论真堪惊谄子，固穷不肯媚钱神。\n吾评此士西塘比，后进纷纷谩效颦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31189,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再和二首 其二","author":"刘克庄","text":"与君未得便安闲，边警偏能恼涧槃。\n草地枣红犹索斗，田家稻白可能餐。\n谁将铁绠横江锁，莫靠琵琶出塞弹。\n处处冲梯楼上舞，不应诸老自巍冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31190,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再和二首 其一","author":"刘克庄","text":"旨蓄元无可御冬，薄醪欣与故人同。\n蜀珍乃肯临闽聚，韩富何尝笑孟穷。\n旧事回头梦中蝶，浮荣过眼雨馀虹。\n惟公出处关时运，堪谷年荒玉岁丰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31191,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再和二首 其二","author":"刘克庄","text":"新岁凝严过旧冬，微和初扇八州同。\n固知使者获五福，应念天民先四穷。\n政召嘉祥平地雪，诗腾光怪亘天虹。\n祝公相业追元祐，二虏来王九扈丰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31192,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再和二首 其一","author":"刘克庄","text":"荥阳相昔独当朝，曾忝弓旌第一招。\n无力不能救房琯，有书安敢托洪乔。\n如闻徒步轻千驷，未觉堂厨胜一瓢。\n邓禹封侯子陵钓，君看二者孰风标。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31193,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再和二首 其二","author":"刘克庄","text":"古柏每经寒耸秀，朝花不待夕离披。\n举扬壹似德山棒，摧拉过于力士椎。\n化鹤仙归见孙老，感麟翁泣叹吾衰。\n楚狂难和薰风句，聊自歌之舞蹈之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31194,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再和方孚若瀑上种梅五首 其五","author":"刘克庄","text":"杖屦暇时常检点，细分枝干数株桩。\n试呼童子调霜弄，绝胜奴兵擂晓逄。\n色映岩松寒引鹤，根连园杞夜闻尨。\n社中作者铦锋颖，甘树降幡束短杠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31195,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再和方孚若瀑上种梅五首 其四","author":"刘克庄","text":"绝巅岁晚无人到，但见山风激岭泷。\n高蘤恍如珠照乘，深葩还似宝迷邦。\n巢居公未甘枯槁，鼎实朝方起硕厖。\n诗在简斋和靖里，追攀真以寸筳撞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31196,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再和方孚若瀑上种梅五首 其三","author":"刘克庄","text":"手选千株高下种，似行庾岭泛湘江。\n只销一朵南枝拆，尽受群花北面降。\n自爱空山吹缟袂，绝羞华屋照银釭。\n主林神禁人残毁，深夜应无斫树庞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31197,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再和方孚若瀑上种梅五首 其二","author":"刘克庄","text":"厌看花开平地上，故攀绝磴履危矼。\n节方静女尤专一，韵比高人更少双。\n堪伴愚公居北谷，宜偕漫叟隐南淙。\n素标尚恐诗轻媟，敢犯人间曲子腔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31198,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再和四首 其四","author":"刘克庄","text":"伏阁何其壮，登舟得许哀。\n人多称快者，上岂少恩哉。\n恶草毋留种，夭桃不待媒。\n九重方远佞，宁放郑詹来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31199,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再和四首 其三","author":"刘克庄","text":"噬人侔虺毒，害物比猫柔。\n清议姑驱逐，宽恩未放流。\n剑诛张禹佞，扇障褚渊羞。\n谏笔非私忿，惓惓为国谋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31200,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再和四首 其二","author":"刘克庄","text":"旧知偏下石，远避亦伤弓。\n留落周南众，萧条冀北空。\n万言徒饰诈，双泪却由衷。\n王绩何曾醉，刘蕡本不风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31201,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再和四首 其一","author":"刘克庄","text":"狐鸣工作祟，鸦噪每为凶。\n鲁观初尸罪，丘门永削踪。\n谋身真有窟，凿趾欲无墉。\n力击延龄去，堂堂似亢宗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31202,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再和张文学","author":"刘克庄","text":"安知后来者，所作不如今。\n孰可执牛耳，君能贯虱心。\n孤根才一寸，老干忽千寻。\n未必子期死，无人听古音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31203,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再和宿囊山三首 其三","author":"刘克庄","text":"未能葱岭从初祖，也不蓬莱访洞宾。\n煎凤髓须还此老，执牛耳更属何人。\n笈储丹药堤防病，案设图书粉饰贫。\n老觉为僧差省事，韩公何必强冠巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31204,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再和宿囊山三首 其二","author":"刘克庄","text":"乞骸不作凝香守，掩鼻难随逐臭夫。\n牛角书堪教村学，鱼羹饭胜食堂厨。\n门无喜鹊传朝报，笥有悬鹑拆海图。\n常敬渊明归去早，村翁晚始觉迷涂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31205,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再和宿囊山三首 其一","author":"刘克庄","text":"恰似病沙门退院，又如老禅录归农。\n素无才调宴三阁，不愿歌词传六宫。\n万首漏名宗派里，百年占籍醉乡中。\n暮龄喜共樵夫语，懒与诸儒论异同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31206,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再送蒙仲二首 其二","author":"刘克庄","text":"送君怀旧一销魂，谢墅孙陵髣髴存。\n下濑楼船皆万斛，曲江宫殿尚千门。\n笑陈狎客为俳体，与晋诸贤洗泪痕。\n定有奇谋裨玉帐，莫挥麈尾事清言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31207,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再送蒙仲二首 其一","author":"刘克庄","text":"昔人曾叹择栖难，今子翱游二相间。\n对弈未妨看露布，论诗未合上斋坛。\n沉来铁锁真儿戏，吟退毡裘却凯还。\n班固作铭繇捷表，待揩老眼细传观。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31208,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再获一砚自和","author":"刘克庄","text":"三砚联翩买券成，绝胜玉杵聘云英。\n拊摩无粟向肌起，涂抹有花从笔生。\n韫椟每愁逢暴客，倾囊或笑费方兄。\n古来事业由勤苦，不信磨穿道不亨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31209,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再题信庵墨梅","author":"刘克庄","text":"信庵墨戏古无之，元气淋漓尔许奇。\n特与此翁挥匹楮，不为彼相作横枝。\n秘藏扫雪辋川画，曾序调羹沂国诗。\n九十老农尤宝惜，时时开卷拂蛛丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31210,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再赠一首","author":"刘克庄","text":"药囊价重百车渠，肯受村翁折简呼。\n失喜迎君瞻紫气，必能为我索玄珠。\n晨兴舐鼎尝残药，夕暝吹灯据槁梧。\n乞取刀圭补精髓，天公岂忍瞎癯儒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31211,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"刘玄德","author":"刘克庄","text":"老瞒虐焰市朝空，宗室惟馀大耳翁。\n汉贼有谁分逆顺，关河无地著英雄。\n紫髯久矣营江表，黄屋萧然寄峡中。\n可惜姜维胆如斗，功虽不就有馀忠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31212,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"华严知客寮","author":"刘克庄","text":"檐外苍榕六月秋，小年来此爱深幽。\n坏墙萤出如渔火，古壁蜂穿似射侯。\n涉世昏昏忘旧话，入山历历记前游。\n故人埋玉僧归塔，独听疏钟起暮愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31213,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同孙季蕃游净居诸庵 其二","author":"刘克庄","text":"满院静沉沉，微闻有梵音。\n不来陪客语，应恐坏禅心。\n母处归全少，师边悟已深。\n戒衣皆自衲，因讲始停针。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31214,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同孙季蕃游净居诸庵 其一","author":"刘克庄","text":"舍俗依空事梵王，韶颜寂寂度年芳。\n门前草色迷行径，院里花阴接步廊。\n弓样展来靴尚窄，黛痕剃出顶应凉。\n当时若使窥鸾镜，一步何因出洞房。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31215,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同安权县林丞和余二首趁韵答之 其二","author":"刘克庄","text":"颇闻四境有弦声，雉傍人飞犬不惊。\n在处棠阴应勿伐，等闲花判亦流行。\n掞庭子盍摛新藻，绝廪□□□落英。\n台府诸公衡尺审，春风荐子有谁争。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31216,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同秘书弟赋三老各一首 老奴","author":"刘克庄","text":"少贱肠枵破褐单，傍人门户活饥寒。\n自从毁齿初成券，直至长须尚不冠。\n冷炙时沾筵上馂，秃芒旋扫臼边残。\n他时纵取封侯印，仅得君王踞厕看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31217,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同秘书弟赋三老各一首 老兵","author":"刘克庄","text":"昔拥雕戈射铁帘，可堪蓬鬓映冰髯。\n金疮常有些儿痛，斗力今难寸许添。\n至老安能希骆甲，从初悔不事蒙恬。\n莫嗟身上衣裘薄，犹向官中请半缣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31218,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同秘书弟赋三老各一首 老妾","author":"刘克庄","text":"伤春感旧似中酲，乐器全抛曲谱生。\n自小抱衾无怨色，有时拥髻尚风情。\n曾陪太尉斟还唱，犹记司空眼与声。\n著主衣裳为主寿，莫如琴客别宜城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31219,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夹漈草堂","author":"刘克庄","text":"岭绝瀑源穷，曾于此筑宫。\n得知千载上，因住万山中。\n废址苔荒尽，遗书电取空。\n高皇南渡始，却议及招弓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31220,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"妄想","author":"刘克庄","text":"妄想如冰已尽消，朱颜日向镜中凋。\n玉关万里曾投笔，草市三家却负樵。\n弱水古来无路到，小山岁晚有人招。\n吾庐寂寂何须笑，君看闲僧住退寮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31221,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"孙伯符","author":"刘克庄","text":"霸略谁堪敌伯符，每开史册想规模。\n一千扫众横江去，十七成功自古无。\n不分老瞒称猘子，便呼公瑾作姨夫。\n君看末命尤奇特，指顾张昭为托孤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31222,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"尧庙","author":"刘克庄","text":"帝与天同大，天存帝亦存。\n桑麻通绝徼，箫鼓出深村。\n水至孤亭合，山居列岫尊。\n尚馀土阶意，樵牧践篱藩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31223,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岁晚试笔一首","author":"刘克庄","text":"忆与诸贤共造廷，暮年屈指略凋零。\n颜郎衫色有时紫，潘令鬓毛无日青。\n小草自应惭远志，落英犹足制颓龄。\n左丞岂识吾诗者，举向村姑倚树听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31224,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"延平汤使君惠双溪楼记跋以小诗","author":"刘克庄","text":"吾评此记前无古，历历溪山在目中。\n潦后数椽谁朴斲，云间千尺忽青红。\n比滁亭笔尤高简，与洛桥碑角长雄。\n父老皆云侯苦节，咄嗟幻出化人宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31225,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戏书客舍","author":"刘克庄","text":"已去光阴挽不回，渐惊老态逼人来。\n决河犹有方堪塞，脱发应无术可栽。\n圯戍宝藏惟檄草，南游稛载是诗材。\n客愁何物禁当得，聊向旗亭买一杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31226,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戏孙季蕃","author":"刘克庄","text":"少日逢春一味痴，轻鞭小袖趁芳时。\n常过茶邸租船出，或在禅林借枕攲。\n名妓难呼多占定，好花易落况开迟。\n身今惟悴投空谷，悔不当年秉烛嬉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31227,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戏郑闽清灼艾","author":"刘克庄","text":"点穴不须医，针经手自披。\n既云丹熟后，焉用火攻为。\n简出创牵步，端居痛上眉。\n闭门功行满，应有解飞时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31228,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戏题山庵二首 其二","author":"刘克庄","text":"封高四尺宁从险，穴锢三泉岂不愚。\n客过唐陵悲石马，盗穿秦冢得金凫。\n蛩吟不必人歌挽，鸡絮那无客吊孤。\n自作铭诗差实录，免教人谤退之谀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31229,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戏题山庵二首 其一","author":"刘克庄","text":"曾批龙鳞捋虎须，君恩天大偶全躯。\n入华胥国浑成梦，移太行山得许愚。\n无剑拄颐但樵服，有衾覆首胜珠襦。\n他时只著深衣去，不必防闲发冢儒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31230,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"扬州作","author":"刘克庄","text":"几多精甲没黄沙，野哭遥怜战士家。\n瓜渡月明空粉堞，芜城烟断只昏鸦。\n似闻汉使攽王醢，尚喜胡儿剖帝羓。\n怊怅两淮蚕织地，春风不复长桑芽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31231,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"早去","author":"刘克庄","text":"早去天知无宦情，急攻人惎有虚名。\n老而能学□□少，耄不加刑黜典轻。\n宿昔□□□未就，他时血碧尚难平。\n吾书岂必行今世，千□□□泣蒯生。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31232,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"早行","author":"刘克庄","text":"店妪明灯送，前村认未真。\n山头云似雪，陌上树如人。\n渐觉高星少，才分远烧新。\n何烦看堠子，来往暗知津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31233,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"有叹","author":"刘克庄","text":"方喜凤箫吹协律，忽惊鸾镜黯无光。\n入君怀袖初蒙幸，著主衣裳外不忘。\n陌上野游多薄倖，闺中婉娈有刚肠。\n落花满地无人扫，自是春来懒下堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31234,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"有兴","author":"刘克庄","text":"有兴驾柴车，无心起草庐。\n浅倾家酿酒，细读手抄书。\n门巷慵耘草，园篱课种蔬。\n虽非黄叔度，未易得亲疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31235,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"有感","author":"刘克庄","text":"跸移退保一隅偏，幅裂才馀半体全。\n恰见测圭营洛邑，忍看披发祭伊川。\n胡行如鬼无逃地，帝剖为羓得罪天。\n直待健儿归洗甲，补还几觉北窗眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31236,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"有感","author":"项安世","text":"我与昔贤生异世，昼思夜梦两微茫。\n掉头堕雾入东海，被发乘风下大荒。\n仙伯已寻丹灶地，武皇亦返白云乡。\n惟应诗卷留天地，宝气虽埋斗有光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31237,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"有感","author":"刘克庄","text":"残羯如蜂暂寄窠，十年南北问干戈。\n穹庐昔少曾居汴，莫府今犹未过河。\n越石不生谁可将，奉春再出亦难和。\n忧时元是诗人职，莫怪吟中感慨多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31238,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]