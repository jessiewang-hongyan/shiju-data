[{"title":"喜朝天/踏莎行 其一 绮霞阁即踏莎行","author":"曹冠","text":"绣水雕栏，绮霞邃宇。\n薰风飒至清无暑。\n花间休唱遏云歌，枝头且听娇莺语。\n景物撩人，悠然得句。\n深杯戏把纹楸赌。\n胸中丘壑自生凉，何须泉石寻佳趣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64648,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"朝中措 其二 汤","author":"曹冠","text":"更阑月影转瑶台。\n歌舞下香阶。\n洞府归云缥缈，主宾清兴徘徊。\n汤斟崖蜜，香浮瑞露，风味方回。\n投辖高情无厌，抱琴明日重来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64649,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"朝中措 其一 茶","author":"曹冠","text":"春芽北苑小方圭。\n碾畔玉尘飞。\n金箸春葱击拂，花瓷雪乳珍奇。\n主人情重，留连佳客，不醉无归。\n邀住清风两腋，重斟上马金卮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64650,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"满江红 其二","author":"曹冠","text":"日暖烟轻，竹梢映、花阴凌乱。\n微风皱、池光青碧，绿杨垂岸。\n艳杏墙头红粉媚，幽兰砌下飘香暖。\n称邀宾、明日去寻芳，频欢宴。\n光景速，浑如箭。\n醉梦里，春强半。\n且花前莫厌，玉杯频劝。\n一枕游仙方警悟，浮名自笑犹萦绊。\n醉挥毫、付与雪儿歌，娇莺啭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64651,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"满江红 其一","author":"曹冠","text":"味道韬光，伴耕钓、城南涧曲。\n吾不羡、炼丹金井，访仙王屋。\n清洁无瑕通隐显，满堂岂肯贪金玉。\n向北窗、高卧水风凉，槐阴绿。\n闲自赏，东篱菊。\n偏喜种，幽居竹。\n信巍然良贵，有荣无辱。\n外物随缘姑泛应，无心仕止常知足。\n喜圣时、协气屡丰年，西畴熟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64652,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"满庭芳","author":"曹冠","text":"榴艳喷红，槐阴凝绿，薰风初扇微凉。\n新荷舒盖，翠色映波光。\n时见金鳞戏跃，听莺声、巧啭垂杨。\n谁知我，身闲无累，对景自襄羊。\n南堂。\n清昼永，瑶琴横膝，芸帙披香。\n负气冲牛斗，操凛冰霜。\n吟笔通神掣电，乘高兴、鲸吸飞觞。\n情何憾，君亲未报，功业志难忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64653,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蓦山溪 其三 乾道戊子秋游涵碧","author":"曹冠","text":"深秋澄霁，烟淡霜天晓。\n翠岘峻摩穹，有碧涧、清溪缭绕。\n鸣弦多暇，乘兴约登临，听水乐，习丰碑，遐想东坡老。\n当年叔子，何事伤怀抱。\n名与此山俱，叹无闻、真成可笑。\n吾侪勋业，要使列云台，擒颉利，斩楼兰，混一车书道。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64654,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蓦山溪 其四 渡江咏潮","author":"曹冠","text":"潮生潮落，千古长如许。\n吴越旧争衡，览遗迹、英雄何处。\n胥神忠愤，贾勇助鲸波，湍砥柱，驾鳌峰，万骑轰鼍鼓。\n连天雪浪，直上银河去。\n击楫誓中流，剑冲星、醉酣起舞。\n丈夫志业，当使列云台，擒颉利，斩楼兰，雪耻歼狂虏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64655,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蓦山溪 其二 鉴湖","author":"曹冠","text":"鉴湖千顷，四序风光好。\n拨棹皱涟漪，极目处、青山缭绕。\n微茫烟霭，鸥鹭点菰蒲，云帆过，钓舟横，俱被劳生扰。\n知章请赐，独占心何小。\n风月本无私，同众乐、宁论多少。\n浮家泛宅，它日效陶朱，烹鲈鳜，酌松醪，吟笔千篇扫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64656,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蓦山溪 其一 九日","author":"曹冠","text":"年年九日，萸菊登高宴。\n今岁旅新丰，听征雁、吟蛩幽怨。\n行行游赏，邂逅得诗人，呼斗酒，发清吟，豪气凌霄汉。\n穷通默定，志士那兴叹。\n寓意醉乡游，且赢得、开怀萧散。\n功名外物，何必累冲襟，炼丹井，叱羊山，寻个修真伴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64657,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蓦山溪 其五 九日","author":"曹冠","text":"佳辰荐九，吹帽霜风峭。\n画阁势崔嵬，遍危阑、翠峰缭绕。\n茂林修竹，别是小壶天，烟霭淡，夕阳明，隐映溪光渺。\n匣琴流水，休恨知音少。\n长啸对西风，觉志气、凌云缥缈。\n传杯兴逸，高会继龙山，簪嫩菊，插红萸，相对年年好。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64658,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 梦仙","author":"曹冠","text":"我昔蓬莱侍列仙。\n梦游方悟绊尘缘。\n青春放浪迷诗酒，黄卷优游对圣贤。\n嘲水石，咏云烟。\n乘风欲往思泠然。\n要知昨夜方壶景，只在芸斋杖屦前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64659,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"霜天晓角 其三","author":"曹冠","text":"水亭清绝。\n拥翠环林樾。\n湘簟宾筵乘兴，玉壶酒、漾冰雪。\n宝兽沈烟爇。\n玉琴声韵彻。\n夜永风微烟淡，梧桐影、碎明月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64660,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"霜天晓角 其一 清高堂看山","author":"曹冠","text":"小雨濛濛。\n轻烟舞曳风。\n林樾高低疏密，依浅濑、媚遥峰。\n浴鹭水溶溶。\n晴霞映晚红。\n拟向玉堂举似，摹写入、画图中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64661,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"霜天晓角 其二","author":"曹冠","text":"浦溆凝烟。\n谁家女采莲。\n手捻荷花微笑，传雅令、侑清欢。\n擘叶劝金船。\n香风袭绮筵。\n最后殷勤一瓣，分付与、酒中仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64662,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上元前四日宣召赏梅","author":"曹勋","text":"冉冉东风春乍回，睿思宣入禁中来。\n忽参鼻观清香彻，殊喜一庭都是梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64663,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与印老同访天封老至夕忘归","author":"曹勋","text":"斜风吹雪冷征衣，来见长眉老阿师。\n为我晓开银色界，笑谈宁复问归期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64664,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小轩偶成","author":"曹勋","text":"才添禄廪便添事，岂若清贫自在闲。\n常恨吾庐无水石，漫将青竹当青山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64665,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小诗遗人谒邑令","author":"曹勋","text":"林生牢落叹萍蓬，词采飘飘甑屡空。\n闻道河阳花满县，欲从大手借春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64666,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小雨看海棠","author":"曹勋","text":"浣花红绿四回环，何事轻阴作嫩寒。\n应是化工知胜处，海棠宜向雨中看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64667,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小游仙三首 其三","author":"曹勋","text":"摇曳空歌上玉清，飞烟冉冉拂仙缨。\n龙軿已过黄金阙，致肃门郎识姓名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64668,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小游仙三首 其二","author":"曹勋","text":"十二层城倚阆风，金台珠树郁葱葱。\n遥瞻玉室藏书府，万仞飞光散晓红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64669,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小游仙三首 其一","author":"曹勋","text":"九霄风静夜沉沉，仙籁虚徐度玉音。\n好是太真歌未阕，飞烟遥上郁华林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64670,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丹桂再开对酒","author":"曹勋","text":"丹桂何堪急雨催，清香不肯逐蒿莱。\n却应念我经年待，借得馀霞为再开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64671,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书王应夫题记后","author":"曹勋","text":"每逢佳处见新诗，语妙春红绕万枝。\n我亦欲寻潮揭去，拟求握手话风期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64672,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书玻璃泉壁","author":"曹勋","text":"秋夕淮天不肯明，壮怀冲斗若为情。\n卧闻隔水吹三弄，又喜孤城报五更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64673,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"从驾玉津园二首 其二","author":"曹勋","text":"花梢糁糁动朱栏，萱草侵苔雪已乾。\n行阙风光随处乐，春台人物不知寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64674,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"从驾玉津园二首 其一","author":"曹勋","text":"天子行春御六龙，五云回暖泛晴风。\n和鸾宝苑梅花路，剩有香传玉座中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64675,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"天台书事十三首 其十三","author":"曹勋","text":"饭了从容古寺前，杖藜闲倚听清泉。\n因看一则邻僧话，搅却老夫中夜眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64676,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"天台书事十三首 其十二","author":"曹勋","text":"香火寻盟欲过门，相迎道地盍先论。\n路从舍北清溪曲，家在县东黄叶村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64677,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"天台书事十三首 其十一","author":"曹勋","text":"束发名场历百艰，荷恩早许出清班。\n未能脱迹尘埃外，已爱著身泉石间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64678,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"天台书事十三首 其十","author":"曹勋","text":"云出云归山未静，潮生潮落海非闲。\n岂如此老犹强健，一挂冠裳便掩关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64679,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"天台书事十三首 其九","author":"曹勋","text":"水云深处是吾家，饭有胡麻饮有茶。\n铛里未能炊一粟，山头学得种三花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64680,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"天台书事十三首 其八","author":"曹勋","text":"终日飞霙下远空，冷回帘幕怯东风。\n瑞香满槛深遮映，怕损亭亭紫锦笼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64681,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"天台书事十三首 其七","author":"曹勋","text":"绿阴侵坐午窗明，几案书繁倦思生。\n喜拆缄题新卷帙，故人惠我见高情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64682,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"天台书事十三首 其六","author":"曹勋","text":"小圃都无花木名，只栽松竹养馀清。\n时时风向边头过，喜听松声又竹声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64683,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"天台书事十三首 其五","author":"曹勋","text":"清晓鸦啼睡梦间，喜闻飞雪满前山。\n揽衣忙作披衣意，不问轻寒且凭栏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64684,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"天台书事十三首 其四","author":"曹勋","text":"连雨催寒黄著苔，纷然枯叶拥闲阶。\n了无春意到梅萼，只有瑞香先腊开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64685,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"天台书事十三首 其三","author":"曹勋","text":"人情人事拨来无，惟有亲知意不疏。\n数幅沓来还一幅，寒温而已作回书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64686,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"天台书事十三首 其二","author":"曹勋","text":"老来少睡怕房栊，欲睡还休被屡烘。\n半夜披衣还打坐，耳边听尽两山钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64687,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"天台书事十三首 其一","author":"曹勋","text":"南窗面日北窗寒，终日南窗体甚安。\n向道老来惟倦坐，看销一缕篆烟残。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64688,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"忆台城之东十里梅","author":"曹勋","text":"东城十里冷云低，照眼传香总是梅。\n冷落京尘谁晤语，关河千里独裴回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64689,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王孙游二首 其二","author":"曹勋","text":"夭桃与芳草，艳色明朝阳。\n思君念华旦，贱妾惜容光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64690,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王孙游二首 其一","author":"曹勋","text":"红芳开绣户，碧草衬斜阳。\n楼上频回首，思君道路长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64691,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王昭君","author":"曹勋","text":"好恶由来各在人，况凭图像觅天真。\n君王视听能无壅，延寿何知敢妄陈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64692,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王德言枢密生日十首 其十","author":"曹勋","text":"八月凉秋草未斑，诞辰正近旧长安。\n客涂拜寿无琴奏，应念清辉玉臂寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64693,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王德言枢密生日十首 其九","author":"曹勋","text":"笋舆轧轧塞沙黄，赪襜胡儿语隔窗。\n且喜纵观临易水，未须枫落赋吴江。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64694,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王德言枢密生日十首 其八","author":"曹勋","text":"中原秋色入輶轩，益助胸中造化权。\n大有新诗入行纪，他时綵笔一时编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64695,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王德言枢密生日十首 其七","author":"曹勋","text":"皇华临遣下彤墀，雨卧风餐益自怡。\n口伐可汗初不识，得陪后乘始应知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64696,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王德言枢密生日十首 其六","author":"曹勋","text":"每喜高情语甚真，谠言亹亹赞天钧。\n不殊林下忘形态，定是因中地位人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64697,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王德言枢密生日十首 其五","author":"曹勋","text":"友于相爱陟通津，同气同居善益亲。\n自是茅家好兄弟，一堂和乐棣华春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64698,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王德言枢密生日十首 其四","author":"曹勋","text":"庆源淮渎正滔滔，昆季中间誉最高。\n三接固知先政地，五兵聊欲试钧陶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64699,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王德言枢密生日十首 其三","author":"曹勋","text":"籍甚家声孰可俦，玉堂金马著清脩。\n已摅荷橐三千牍，行相枫宸十二旒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64700,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王德言枢密生日十首 其二","author":"曹勋","text":"骨相霜筠与雪松，高才直节固无同。\n向来举似他时贵，声出丹田踵息中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64701,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王德言枢密生日十首 其一","author":"曹勋","text":"露华澄澹月痕秋，灏气储神侍帝猷。\n暂握元枢均造化，苍生愿看济川舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64702,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"长信宫中草","author":"曹勋","text":"长信宫中草，年来特地长。\n无人同步辇，门外度斜阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64703,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代广漕刘元举谢赵相茶二首 其二","author":"曹勋","text":"方圭圆璧贡春前，上相分颁自九天。\n何止芳芗禦魑魅，要知红日在斜川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64704,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代广漕刘元举谢赵相茶二首 其一","author":"曹勋","text":"龙焙黄封锡有功，谨严正味德相同。\n便知钧播无求备，更借扶南两腋风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64705,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代简国清老惠梅","author":"曹勋","text":"梅从云坞冷摇春，玉雪浮香不著尘。\n愚谷斩新肯拈出，一时全露法王身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64706,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"汉宫词三首 其三","author":"曹勋","text":"费尽千金写玉容，冀承恩幸宠深宫。\n妾心未改君心改，不及夭桃媚晓风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64707,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"汉宫词三首 其二","author":"曹勋","text":"鳷鹊楼高百尺墙，墙高元不碍笙簧。\n君王对面如天远，可笑梅娘不自量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64708,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"汉宫词三首 其一","author":"曹勋","text":"夜漏沉沉度建章，千门万户锁深房。\n入宫不识君王面，犹被傍人妒晓妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64709,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用前韵赠闾丘民表","author":"曹勋","text":"四寂无人雪在峦，喜君乘兴酒肠宽。\n上方归路踏梅影，霜月一庭天正寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64710,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"仲冬再到和前韵","author":"曹勋","text":"江淮烽火照云头，买尽临安去国舟。\n行见中兴圣天子，一戎大定复神州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64711,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"光孝病中闻予与印在天封亦冒雪见过","author":"曹勋","text":"老病维摩方丈开，天风破冷舞琼瑰。\n满山皓色作和气，知是道人冲雪来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64712,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冲啬书事","author":"曹勋","text":"山居终日不开门，室有南窗气自温。\n人籁暂休天籁息，月华将冷照黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64713,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冲啬有新泉","author":"曹勋","text":"梅黄积雨思无欢，麦浪摇晴喜纵观。\n闻道源中添一脉，莫交轻触水精盘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64714,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"孙倅书尾附二诗 其一","author":"曹勋","text":"已作惊禽不择柯，异乡那复困风波。\n别来莫讶书悽恻，忧患艰难我最多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64715,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"孙倅书尾附二诗 其二","author":"曹勋","text":"南徐作别抵闽乡，三见春风换众芳。\n若对旧游知识问，为言羁旅鬓成霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64716,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"守闸书事时已退居五首 其五","author":"曹勋","text":"野情漫对三眠柳，幽思空怀九畹兰。\n他日倘从春步约，湖边一笑似非难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64717,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"守闸书事时已退居五首 其四","author":"曹勋","text":"老去惟思彻骨清，便无弱水限仙瀛。\n士龙犹记当时梦，梦想如今海上城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64718,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"守闸书事时已退居五首 其三","author":"曹勋","text":"坐断天台四五年，居山心迹两超然。\n谁能更看纸上语，且守自家方寸田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64719,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"守闸书事时已退居五首 其二","author":"曹勋","text":"薄阴疏雨湿春容，两岸增添绿与红。\n短棹悠悠了无事，却怜云水旧匆匆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64720,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]