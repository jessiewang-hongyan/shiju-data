192fe5294295f79689","path":"宋_2.csv","pointer":33469,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"有叹二首 其二","author":"范成大","text":"贫富交情乃见，炎凉岁序方成。\n越秦本异肥瘠，鲁卫何曾弟兄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33470,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"有叹二首 其一","author":"范成大","text":"春秋兰菊殊调，南北马牛异方。\n心醉井蛙海若，眼空鹏海鸠枋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33471,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵举老见嘲未归石湖","author":"范成大","text":"半世吟客舍柳，长年忆后园花。\n为报庐山莫笑，云丘今属谁家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33472,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵养正元日六言","author":"范成大","text":"岁踰耳顺俄七，年去古稀只三。\n从今莲叶巢稳，谁在槐柯战酣。\n脐下丹田休想，口边白醭罢参。\n渴饮饥餐困睡，是名真学瞿聃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33473,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自箴 其一","author":"范成大","text":"有对易成畛域，无情那有从违。\n痴人妄认逆境，平地自生铁围。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33474,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初秋閒记园池草木五首 其二","author":"范成大","text":"牛牵碧蔓自绕，鸡耸朱冠欲争。\n菱葩可范伯雅，蓼节偏宜曲生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33475,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初秋閒记园池草木五首 其一","author":"范成大","text":"茙葵烂紫终陋，薝卜嫣黄亦香。\n医俗剩延竹色，疗愁催拆萱房。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33476,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初秋閒记园池草木五首 其四","author":"范成大","text":"醉怜金盏齐侧，卧看玉簪对横。\n腥水留灌末利，结香旋薰素馨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33477,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初秋閒记园池草木五首 其三","author":"范成大","text":"旱地莲花娇小，水盆栀子幽芳。\n薇帐半年春艳，桂丛四季秋香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33478,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初秋閒记园池草木五首 其五","author":"范成大","text":"玉菡化生稚子，碧枝视现声闻。\n马齿任藏汞冷，鸿头自胜硫温。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33479,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"园丁折花七品各赋一绝 其一 单叶御衣黄","author":"范成大","text":"舟前鹅羽映酒，塞上驼酥截肪。\n春工若与多叶，应入姚家雁行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33480,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"园丁折花七品各赋一绝 其三 寿安红","author":"范成大","text":"丰肌弱骨自喜，醉晕妆光总宜。\n独立风前雨里，嫣然不要人持。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33481,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"或劝病中不宜数亲文墨医亦归咎题四绝以自戒末篇又以解嘲 其一","author":"范成大","text":"作字腕中百斛，吟诗天外片心。\n习气吹剑一吷，病躯垂堂千金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33482,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"枕上六言二首 其二","author":"范成大","text":"独眠被出圭角，晏起帐承隙光。\n一老绸缪牖户，几人颠倒衣裳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33483,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"枕上六言二首 其一","author":"范成大","text":"寒更寂历向晓，短梦参差屡惊。\n鸡鸣似唤我醒，犬吠知有人行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33484,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"苦雨五首 其一","author":"范成大","text":"河流满满更满，檐溜垂垂又垂。\n皇天宁有漏处，后土岂无乾时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33485,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"苦雨五首 其三","author":"范成大","text":"折笋肥梅饤坐，涎蜗斗蚁上梁。\n雨工莫贾馀勇，留待稻花半黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33486,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"苦雨五首 其五","author":"范成大","text":"已厌衣裳蒸润，仍怜书画斓斑。\n奁香尚馀几所，尽付熏垆博山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33487,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"苦雨五首 其二","author":"范成大","text":"不辞蛾化麦穗，叵忍秧浮浪花。\n儿孙汩汰护岸，翁媪扶携上车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33488,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"苦雨五首 其四","author":"范成大","text":"润础才晴又汗，湿薪未爆先烟。\n壮夫往往言病，病叟岑岑且眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33489,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"苦寒六言","author":"范成大","text":"檐冰低挂阑角，隙雪斜侵坐隅。\n春后一寒如此，梅花有信来无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33490,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"荆公墓二首 其一","author":"范成大","text":"百岁谁人巧拙，一丘底处亏成。\n半世青苗法意，当年雪竹诗情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33491,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"荆公墓二首 其二","author":"范成大","text":"本意治功徙木，何心党祸扬尘。\n报雠岂教行劫，作俑翻成害仁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33492,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鬼门关","author":"范成大","text":"天作陇头石阙，人言要隔尘樊。\n百年会须作鬼，无事先穿鬼关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33493,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"剧暑","author":"范成大","text":"赫赫炎官张伞，啾啾赤帝骑龙。\n安得雷轰九地，会令雨起千峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33494,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏至二首 其二","author":"范成大","text":"石鼎声中朝暮，纸窗影下寒温。\n踰年不与庙祭，敢云孝子慈孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33495,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏至二首 其一","author":"范成大","text":"李核垂腰祝饐，粽丝系臂扶羸。\n节物竞随乡俗，老翁閒伴儿嬉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33496,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]