[{"title":"霜后纪园中草木十二绝 其四","author":"范成大","text":"种葵如种麦，隔岁已下子。\n仅成一干花，浪备四时气。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33422,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"霜后纪园中草木十二绝 其九","author":"范成大","text":"清霜染柿叶，荒园有佳趣。\n留连伴岁晚，莫作流红去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33423,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"霜后纪园中草木十二绝 其七","author":"范成大","text":"客从扬州来，遗我扬州花。\n筠笼贮枯蘖，明年擅春华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33424,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"霜后纪园中草木十二绝 其一","author":"范成大","text":"菊老芙蓉退，化工少均逸。\n蚤晚梅花动，从此无閒日。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33425,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"霜后纪园中草木十二绝 其八","author":"范成大","text":"风倒酴醾架，长条头抢地。\n趁渠未萌芽，政可相料理。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33426,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"霜后纪园中草木十二绝 其十","author":"范成大","text":"真珠缀玉船，梧子炒可供。\n莫嫌能堕发，老夫头已童。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33427,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"霜后纪园中草木十二绝 其三","author":"范成大","text":"制芰亦不急，缊袍堪禦冬。\n从渠抱枝槁，摵摵鸣霜风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33428,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"霜后纪园中草木十二绝 其十二","author":"范成大","text":"门冬如佳隶，长年护阶除。\n生儿乃不凡，磊落玻璃珠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33429,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"骤寒吟","author":"范成大","text":"九月奇寒前未闻，巷南巷北无行人。\n冥凌尽用大冬手，肯为岁华留小春。\n阴风吹雨作冰屑，驼裘如铁绵裘折。\n可怜篱下木芙蓉，不独宜霜更宜雪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33430,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蟠龙岭","author":"范成大","text":"夷陵至?䏰，复岭苦丝乱。\n初程尚勇往，少日还委顿。\n安得长剑挥，尽铲叠嶂断。\n虽云北山愚，聊快南溟运。\n此意竟萧索，劳歌谩凄曼。\n日日望平陆，念念到彼岸。\n人言束马险，但欠蟠龙峻。\n摧颓强弩末，黾勉焚舟战。\n譬如已偿逋，犹有未折券。\n山根治晓装，峰顶寄朝饭。\n稍脱蚓瘴染，还探虎窠玩。\n性命乃可忧，筋力何足算。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33431,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"腊月村田乐府十首 其五 爆竹行","author":"范成大","text":"岁朝爆竹传自昔，吴侬政用前五日。\n食残豆粥埽罢尘，截筒五尺煨以薪。\n节间汗流火力透，健仆取将仍疾走。\n儿童却立避其锋，当阶击地雷霆吼。\n一声两声百鬼惊，三声四声鬼巢倾。\n十声百声神道宁，八方上下皆和平。\n却拾焦头叠床底，犹有馀威可驱疠。\n屏除药裹添酒杯，昼日嬉游夜浓睡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33432,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"藻侄比课五言诗已有意趣老怀甚喜因吟病中十二首示之可率昆季赓和胜终日饱閒也 其十二","author":"范成大","text":"学业荒呻毕，欢悰隔笑盐。\n入秋先复幕，过夏亦疏帘。\n门客嗔愁思，家人献吉占。\n尤怜小儿女，时报鹊鸣檐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33433,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"藻侄比课五言诗已有意趣老怀甚喜因吟病中十二首示之可率昆季赓和胜终日饱閒也 其四","author":"范成大","text":"绳倚扶枵骨，蒲团阁瘁肤。\n事疑偿业债，形类窘囚拘。\n空劫真常体，浮生幻化躯。\n个中元不二，无语对文殊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33434,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晞真阁留别方道士宾实","author":"范成大","text":"东山西山双袖舞，中有清宫蟠万础。\n云横朱阁碧梧寒，风扫石坛苍桧古。\n道人宾实其姓方，来从何许今几霜。\n诛蒿仆蓬殿突兀，玉华紫气腾真香。\n胸奇腹愤无人识，我独相从似畴昔。\n时时苦语见针砭，邂逅天涯得三益。\n明朝归客上归艎，重到晞真计渺茫。\n只有双鱼相问讯，歙江之水通吴江。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33435,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夔州竹枝歌九首 其五","author":"范成大","text":"白头老媪篸红花，黑头女娘三髻丫。\n背上儿眠上山去，采桑已闲当采茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33436,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夔州竹枝歌九首 其四","author":"范成大","text":"瘿妇趁墟城里来，十十五五市南街。\n行人莫笑女粗丑，儿郎自与买银钗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33437,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夔州竹枝歌九首 其二","author":"范成大","text":"赤甲白盐碧丛丛，半山人家草木风。\n榴花满山红似火，荔子天凉未肯红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33438,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夔州竹枝歌九首 其一","author":"范成大","text":"五月五日岚气开，南门竞船争看来。\n云安酒浓曲米贱，家家扶得醉人回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33439,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"荣木","author":"范成大","text":"薰风南来，木荣于兹。\n木荣几时，黄落从之。\n逝其须臾，坐成四时。\n今我不学，殆其已而。\n天旋地游，日月其根。\n形息气徂，不亡者存。\n去乡离家，莫肯过门。\n猗欤先师，不我疵陋。\n褰衣示珠，俾我复旧。\n自我来归，十年不富。\n孰蠹孰蛊，惟汝自疚。\n冉冉荣木，霜华将坠。\n天黑路长，屹蹶可畏。\n隶也不力，奚取六骥。\n脂车著鞭，一息而至。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33440,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乙巳十月朔开炉三首 其三","author":"范成大","text":"石湖今日开炉，俗家恰似精庐。\n抆涕虽无情绪，吟诗却有工夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33441,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乙巳十月朔开炉三首 其二","author":"范成大","text":"石湖今日开炉，两壁仍安画图。\n万事篆烟曲几，百年毳衲团蒲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33442,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乙巳十月朔开炉三首 其一","author":"范成大","text":"石湖今日开炉，纸窗银白新糊。\n童子烧红榾柮，老翁睡煖氍毹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33443,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"二偈呈似寿老 其一","author":"范成大","text":"法法刹那无住，云何见在去来。\n若觅三心不见，便从不见打开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33444,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"久病或劝勉强游适吟四绝答之 其三","author":"范成大","text":"扪虱即是忙事，驱蝇岂非褊心。\n香煖香寒功课，窗明窗暗光阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33445,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"久病或劝勉强游适吟四绝答之 其四","author":"范成大","text":"羸如蓐妇多忌，倦似田翁作劳。\n玩具僧梳刖屦，欢悰丁尾龟毛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33446,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"久病或劝勉强游适吟四绝答之 其二","author":"范成大","text":"鹤怨久回俗驾，鸥盟谁主载书。\n一丘一壑谢汝，三岁三秋望予。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33447,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"久病或劝勉强游适吟四绝答之 其一","author":"范成大","text":"风月个中老子，江湖之上散人。\n化炉苦靳清福，环堵閒抛好春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33448,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"不寐","author":"范成大","text":"春宵似暖非暖，晓梦欲成未成。\n风竹时惊雀噪，月窗谁伴梅横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33449,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书事三绝 其二","author":"范成大","text":"日日处方候脉，时时推筴禳灾。\n门外虽无车辙，医生卜叟犹来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33450,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书事三绝 其三","author":"范成大","text":"简子约同湖棹，周郎许过田庐。\n碧云日暮空合，多病故人遂疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33451,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书事三绝 其一","author":"范成大","text":"爨婢请淘酒米，园丁催算花钱。\n如许日生公事，谁云穷巷萧然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33452,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"从圣集乞黄岩鱼鲊","author":"范成大","text":"截玉凝膏腻白，点酥粘粟轻红。\n千里来从何处，想看舶浪帆风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33453,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬祠太乙六言四首 其三","author":"范成大","text":"云木栖乌未动，风庭警鹤先鸣。\n残夜百灵夙驾，人间鼻息雷惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33454,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬祠太乙六言四首 其二","author":"范成大","text":"月色胧明碧瓦，蜡烟浮动黄帘。\n罡骑飙轮欲下，一天飞霰纤纤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33455,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬祠太乙六言四首 其一","author":"范成大","text":"三一旧传神咒，十神今济时艰。\n愿挽灵旗北指，为君直捣阴山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33456,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬祠太乙六言四首 其四","author":"范成大","text":"行道羽衣缥缈，捲班玉佩冬珑。\n回首金铺兽面，