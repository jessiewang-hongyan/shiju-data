[{"title":"望江南/忆江南","author":"蔡真人","text":"阑干曲，红扬绣帘旌。\n花嫩不禁纤手捻，被风吹去意还惊。\n眉黛蹙山青。\n铿铁板，闲引步虚声。\n尘世无人知此曲，却骑黄鹤上瑶京。\n风冷月华清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28236,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上乌程李明府","author":"蔡绦","text":"两鬓忧民半欲丝，此中能政动神祇。\n河阳花发春风满，单父琴调昼日迟。\n直操已为松柏许，贞心不逐岁时移。\n凤雏骥子生有种，已是庭前玉树枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28237,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"芳美亭","author":"蔡载","text":"高人不惜地，自种无边春。\n莫随流水去，恐污世间尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28238,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"遂初亭","author":"蔡载","text":"结庐傍林泉，偶与初心期。\n佳处时自领，未应鱼鸟知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28239,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"通惠亭","author":"蔡载","text":"水行天地间，万派同一指。\n胡为穿石来，要洗巢由耳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28240,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"望云亭","author":"蔡载","text":"白云来何时，英英冠山椒。\n西风莫吹去，使我心摇摇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28241,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题胶山寺绣佛","author":"蔡载","text":"妙相夺天真，针针巧入神。\n几多瞻佛者，还想用心人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28242,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"蔡载","text":"应有化人巢木末，枝间一国自行春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28243,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和陈轩题汀州苍玉洞","author":"蔡隽","text":"向来曾醉呼猿洞，乱石崩云拥坐隅。\n谁料七闽烟瘴底，半岩风物似西湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28244,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谒馆阁校勘欧阳公","author":"蔡高","text":"此日登史阁，高风孰可追。\n学期明主佐，道许后生师。\n余岂能自信，公真不我欺。\n微躬托所厚，惭愧异新知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28245,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自咏","author":"蔡渊","text":"屈指抠衣四十年，自怜须鬓已皤然。\n久知轩冕应无分，但觉西山若有缘。\n下学功夫惭未到，先天事业敢轻传。\n祇今已饱烟霞疾，更乞清溪著钓船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28246,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初度谩成","author":"蔡渊","text":"揆予初度又今时，老桂吹香满翠微。\n回首六千馀里外，惊心四十九年非。\n閒寻旧藁黏吟卷，怕损团花理战衣。\n一饭君恩何以报，貔貅按堵马秋肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28247,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"仲弟未归岁晚有怀","author":"蔡渊","text":"明月照席寒，生我愁百端。\n冉冉岁云徂，游子不顾还。\n相送荷花碧，相望枫叶丹。\n高楼日千回，散步东林隈。\n攀条复揽秀，日暮空徘徊。\n金杯白玉台，犹能对寒梅。\n寄书岂不早，三月千里道。\n敢怨归轩迟，但念堂中老。\n春风萱草生，更树堂前庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28248,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠谈命余圆机","author":"蔡渊","text":"甲子难周日与时，不拘全阙是圆机。\n只将八字纵横看，祸福无差妙太虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28249,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游圣水兴慈寺","author":"蔡逸","text":"二月春事半，县花无数开。\n江头连骑行，江雾绍红埃。\n下马坐清荫，观鱼大江隈。\n行行历山寺，金碧森楼台。\n拂石有唐碑，字老生莓苔。\n缅想古今事，悠然一伤怀。\n解榼醉泉石，徬徨不忍回。\n辞径下扁舟，重开剩樽罍。\n江烟暝川谷，冰轮出崔嵬。\n水面映金波，流光浮玉杯。\n荡漾舟渚间，往来恣徘徊。\n一棹转圆沙，灯火来相催。\n高歌赋厌厌，会须期再来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28250,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游圣水寺偶成","author":"蔡逸","text":"尽日苦征赋，公馀散霁怀。\n塞云生古石，宿雨溜悬崖。\n鸟倦晨犹伏，僧眠午未斋。\n高人莫相笑，仙尉亦吾侪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28251,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夏日登车盖亭十绝 其四","author":"蔡确","text":"纸屏石枕竹方床，手倦抛书午梦长。\n睡起莞然成独笑，数声渔笛在沧浪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28252,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春","author":"蔡确","text":"十二天街雨压沙，鞦韆咿喔响人家。\n东风会劝十分酒，寒食初开百玉花。\n年少斩新金络马，柳荫无数画轮车。\n春来谁道迟迟日，尤觉春来日易斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28253,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"失调名","author":"蔡确","text":"骊山宫中看乞巧，太液池边收曝衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28254,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九宫坛斋居","author":"蔡戡","text":"斋居独卧小禅房，暂得心閒气味长。\n一炷炉熏春睡足，此身疑是在家乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28255,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三孤山","author":"蔡戡","text":"小孤相去大孤山，一望烟波百里间。\n风日晴和江似镜，两峰对峙拥青鬟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28256,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"六十","author":"蔡戡","text":"六十不归何日归，人生七十古来稀。\n忧愁疾病常相半，十载光阴转瞩非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28257,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"天柱峰","author":"蔡戡","text":"壁立千峰紫翠浮，一峰直上更孤遒。\n世间有此擎天柱，何用人怀杞国忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28258,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"日者郑生谓余晚遇至人享上寿其词多诞以诗简之","author":"蔡戡","text":"钟鼎山林不两全，未闻富贵出神仙。\n万钉宝带何须此，九转金丹未可怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28259,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王东卿惠墨戏副之以诗因次韵谢之 其一","author":"蔡戡","text":"戏拈秃笔聊复尔，一剪吴淞半江水。\n归心已逐水东流，梦到家山四千里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28260,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王东卿惠墨戏副之以诗因次韵谢之 其五","author":"蔡戡","text":"轩冕傥来真漫尔，稳泛潇湘弄烟水。\n凭君收入画图中，一抹云山数千里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28261,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王东卿惠墨戏副之以诗因次韵谢之 其三","author":"蔡戡","text":"挥翰等閒游戏尔，谁能十日画一水。\n烟云杳霭咫尺间，远势应须论万里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28262,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王东卿惠墨戏副之以诗因次韵谢之 其四","author":"蔡戡","text":"玉篸罗带故依然，吏部文章二百年。\n画笔诗篇两奇绝，正须妙手写龙渊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28263,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王东卿惠墨戏副之以诗因次韵谢之 其六","author":"蔡戡","text":"近时画手说超然，小景仍推赵大年。\n谁识当家老摩诘，有如珠玉韫深渊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28264,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王东卿惠墨戏副之以诗因次韵谢之 其二","author":"蔡戡","text":"枯槎怪石出天然，笔力挽回三百年。\n但见毫端侔造化，不知胸次蕴天渊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28265,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"平山堂","author":"蔡戡","text":"平山堂上略从容，笑拍栏干万事空。\n因念醉翁行乐地，不知还又几春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28266,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次张伯信韵题吴园画轴","author":"蔡戡","text":"谁把吴园较辋川，画图犹复想当年。\n要知故国非乔木，文采风流尚宛然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28267,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"红菊","author":"蔡戡","text":"为爱东篱九日黄，孤标正色占秋光。\n如何却被胭脂污，也学人间时世妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28268,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和胡秉彝敷文岩桂四首 其四","author":"蔡戡","text":"秋入东山景物奇，花开亦遣野人知。\n二难佳句真连璧，顾我深惭嫫与施。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28269,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和胡秉彝敷文岩桂四首 其三","author":"蔡戡","text":"独占秋光自一奇，深藏岩壑少人知。\n招还茉莉同为伴，欺压黄花不得施。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28270,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和胡秉彝敷文岩桂四首 其二","author":"蔡戡","text":"移根月窟最珍奇，料得姮娥谁不知。\n挽住西风拚一醉，玉杯从此不徒施。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28271,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和胡秉彝敷文岩桂四首 其一","author":"蔡戡","text":"翠葆金英天与奇，清香十里已先知。\n春光不似秋光好，桃李纷纷何所施。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28272,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和胡端约岩桂六首 其六","author":"蔡戡","text":"一枝小摘间簪冠，酌酒酬花莫作难。\n唯有诗情被花恼，冥搜应作孟郊寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28273,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和胡端约岩桂六首 其五","author":"蔡戡","text":"勿愁金蕊堕秋风，自是灵犀一点通。\n醉魄薰成宝篝细，香脂匀就玉肌丰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28274,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和胡端约岩桂六首 其四","author":"蔡戡","text":"幽香拂拂影珊珊，宜在江梅伯仲间。\n懒对春风争妩媚，从他桃李自漫山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28275,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和胡端约岩桂六首 其三","author":"蔡戡","text":"羞涩东篱九日黄，拒霜粗俗不宜霜。\n此花底事小如许，无那恼人风味长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28276,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和胡端约岩桂六首 其二","author":"蔡戡","text":"蔷薇清露染衣裳，绰约仙姿淡淡妆。\n碧玉参差张翠幄，黄金错落缀珠珰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28277,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和胡端约岩桂六首 其一","author":"蔡戡","text":"万妃蕊佩影珊珊，沉水薰肌栗玉颜。\n曾记广寒宫里见，谁移仙种下人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28278,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南岩","author":"蔡戡","text":"笋舆兀兀一南岩，人在千峰紫翠间。\n剩欲日来陪杖屦，其如病足怯登山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28279,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春郊即事","author":"蔡戡","text":"一犁春雨欲平塍，预卜今年穑事成。\n天意却愁人意懒，故令布谷苦催耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28280,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送葛谦问 其十","author":"蔡戡","text":"顾我穷途醉未醒，年来不复叹飘零。\n道山朋旧如相问，为说生涯一草亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28281,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送葛谦问 其四","author":"蔡戡","text":"杯酒从容相劝酬，须臾堕帻自搔头。\n玉山倾倒从人笑，我醉欲眠君罢休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28282,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送葛谦问 其五","author":"蔡戡","text":"功名固有更何疑，平步青云不用梯。\n他日玉堂风雨夜，略移清梦到荆溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28283,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送葛谦问 其一","author":"蔡戡","text":"风流人物曹刘上，俊逸诗章鲍谢间。\n好似骑鲸天上去，不应著脚向尘寰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28284,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送葛谦问 其二","author":"蔡戡","text":"禅心久已绝贪嗔，剧饮狂歌总是真。\n世态纷纷翻覆手，不图复见葛天民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28285,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送葛谦问 其三","author":"蔡戡","text":"有酒盈尊客满门，陈卿百谪不须闻。\n痴儿官事何时了，我本无心出岫云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28286,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送葛谦问 其七","author":"蔡戡","text":"从来钟鼎不关心，此去溪山更可人。\n傥有新诗摹胜槩，好凭尺素寄双鳞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28287,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送葛谦问 其六","author":"蔡戡","text":"江上霜枫叶叶红，不堪摇落又西风。\n只愁叠鼓催船去，千里相思月满空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28288,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送葛谦问 其九","author":"蔡戡","text":"莫唱阳关堕泪声，一杯相属已酸辛。\n丈夫感慨犹如此，应有偷弹玉箸人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28289,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送葛谦问 其八","author":"蔡戡","text":"垂虹亭上少迟留，卧看冰轮万里秋。\n正是莼丝鲈鲙美，不妨乘兴五湖舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28290,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"剡溪","author":"蔡戡","text":"六月冲炎出问囚，归途因泛剡溪舟。\n短篷块坐如深甑，却羡清寒王子猷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28291,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"黄陵庙 其二","author":"蔡戡","text":"苍梧杳霭暮云阴，尚记南巡岁月深。\n不但邦人严祀事，至今千古想韶音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28292,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"黄陵庙 其一","author":"蔡戡","text":"千载追崇古帝祠，不知世代几推移。\n未须回首叫虞舜，今日亲逢虞舜时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28293,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"龚彦则送水栀小盆口占为谢","author":"蔡戡","text":"动人春色不须多，一点幽香叵奈何。\n薝卜林中谁折得，故令相恼病维摩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28294,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"提壶","author":"蔡戡","text":"斗酒千金未易沽，声声何事劝提壶。\n山禽岂解知人意，不道思家饭也无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28295,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登三高亭","author":"蔡戡","text":"我为莼鲈得得来，三高亭上且徘徊。\n老来心事无机械，寄语群鸥勿浪猜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28296,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"道中见梅","author":"蔡戡","text":"篮舆兀兀梦初回，怪底幽香触鼻来。\n日暮天寒正愁绝，谁家篱落数枝开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28297,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"端约遗墨梅以诗谢之 其一","author":"蔡戡","text":"先生出语已惊人，戏作梅花又逼真。\n眼底江山诗有助，胸中丘壑画精神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28298,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"端约遗墨梅以诗谢之 其二","author":"蔡戡","text":"清香素质恼诗情，更倩挥毫为写真。\n共挽东风拚一醉，不须摹仿费精神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28299,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题墨梅","author":"蔡戡","text":"谁作横枝太逼真，枝头的皪眼俱明。\n也知笔力窥天巧，无奈清香画不成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28300,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"丁未立春日读白乐天浩歌行不觉身年四十七之句时方悼亡有感而作","author":"蔡戡","text":"不觉身年四十七，此身虽在鬓如霜。\n平生意气空摧索，老去功名付渺茫。\n愁里不知佳节至，尊前那复少年狂。\n梅花纸帐焚香坐，感旧伤怀泪两行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28301,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"丁收仲寺丞挽诗 其二","author":"蔡戡","text":"耆旧凋零尽，吾犹及此公。\n典刑前辈近，气概古人同。\n抵掌谈如在，掀髯笑已空。\n堂堂宁复见，萧瑟九原中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28302,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"丁收仲寺丞挽诗 其三","author":"蔡戡","text":"华屋平生处，伤心事已非。\n綵衣方共乐，宝剑忽双飞。\n漫说乘鸾去，终期化鹤归。\n长年知有泪，感慨一沾衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28303,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"丁收仲寺丞挽诗 其一","author":"蔡戡","text":"元祐名卿后，甘盘旧学臣。\n肯堂真有子，论世岂无人。\n仕至二千石，年垂八十春。\n哀荣子毋憾，全福更谁伦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28304,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十月十六日发南昌下半月过建康便风顺流日行二百里舟人云未有如此速者","author":"蔡戡","text":"钟陵一水下金陵，轻舸何劳半月程。\n千里快风冲雪浪，一天寒日弄霜晴。\n天公有意如相念，川后安流自不惊。\n料得还家时节近，买羊沽酒互逢迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28305,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"不寐","author":"蔡戡","text":"独卧虚斋百念衰，枕边犹有数枝梅。\n青灯看尽愁肠断，画角吹残旅梦回。\n发为忧时浑欲雪，心存报国未全灰。\n功名蹭蹬身先老，那更骎骎急景催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28306,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"丐祠得请喜而有作示介卿 其二","author":"蔡戡","text":"人心轻万仞，吾志在兼山。\n知止今真止，求閒复得閒。\n天应念衰病，人免笑痴顽。\n二老风流在，何妨日往还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28307,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"丐祠得请喜而有作示介卿 其一","author":"蔡戡","text":"多病身先懒，閒居乐有馀。\n山林真可老，故事未应疏。\n性与禽鱼适，身便水竹居。\n非无轩冕志，吾亦爱吾庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28308,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"为赵氏题三桂堂","author":"蔡戡","text":"千佛联名未足多，书生荣遇已如何。\n钟英况出神明胄，接武仍登甲乙科。\n郗氏一枝犹可贵，燕山五桂未能过。\n矧君四世推良吏，信史垂芳永不磨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28309,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书怀","author":"蔡戡","text":"消息观天道，炎凉阅世情。\n禅心了生死，病骨识阴晴。\n杜宇伤心切，梅花照眼清。\n焚香读周易，顿觉此身轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28310,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]