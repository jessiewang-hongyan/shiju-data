[{"title":"次韵蔡仲平察院中秋 其二","author":"葛立方","text":"不是银河隐半轮，满天散彩绝埃尘。\n幽怀想得如罗隐，耿耿相看似故人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3846,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵蔡仲平察院中秋 其一","author":"葛立方","text":"素魄经秋分外明，桂枝浓傍蕊渊清。\n人寰散影千山白，愁绝村村砧杵鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3847,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"张千里惠诗次韵 其一","author":"葛立方","text":"十年风搅海波翻，未报穹庐气踊山。\n且把毛锥觑天巧，异时方叔要威蛮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3848,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"张千里惠诗次韵 其二","author":"葛立方","text":"笔端玉箸更银钩，胸次三坟复九丘。\n儿辈政忧书种断，灵胶忽至凤麟洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3849,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"张千里惠诗次韵 其三","author":"葛立方","text":"芝兰楚楚峙庭阶，不集寻常村里来。\n新蔡门前说甘露，也应入细视庭槐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3850,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和卢叔才食蛹 其一","author":"葛立方","text":"绿柘林中听晚缫，闻将煮蛹当持螯。\n何须有茧大如瓮，救得妻儿啼与号。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3851,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和卢叔才食蛹 其二","author":"葛立方","text":"开箔团团雪满床，桃浆洒尽煮兰汤。\n微躯分合葬君腹，报答君家三亩桑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3852,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏春申君二首 其二","author":"葛立方","text":"先秦岂谓嬴为吕，东晋那知马作牛。\n不悟春申亦如许，敢凭宫掖妻邪谋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3853,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏春申君二首 其一","author":"葛立方","text":"朱英在楚强黄歇，黄歇如何弱李园。\n一旦棘门奇祸作，自诒伊戚向谁论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3854,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"试院和陈蕃仲酴醾两绝 其一","author":"葛立方","text":"芳心玉面出蚕丛，骨醉先生酒盏中。\n白发病翁新止酒，枕囊犹觊梦魂通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3855,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"省习堂偶题","author":"葛立方","text":"格外官曹自在身，阖门扫轨养天真。\n何须更待年三十，始约孤高不诣人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3856,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送舒殿丞","author":"葛立方","text":"紫盖亭亭秀荆渚，股分綵水穿林莽。\n尚想当年老阿瞒，燕骑蛇矛走先主。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3857,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻琵琶方响成二绝 其一","author":"葛立方","text":"赤乌宝女眩新妆，九酘霞浆肯见觞。\n但听琵琶喧啄木，谁知捍拨是龙香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3858,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻歌二绝 其二","author":"葛立方","text":"月明如镜酒如空，响谷清声出汉宫。\n怪得中庭红叶堕，琉璃帐底唱回风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3859,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻歌二绝 其一","author":"葛立方","text":"初唱城闉雁影寒，玉喉䆗窱亸云簪。\n小丛底处传歌样，供奉梨园人姓南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3860,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晚泊二绝 其二","author":"葛立方","text":"曲突无烟驿吏忙，匆匆弛担旋舂粮。\n紞如五鼓还应起，早趁南窗一枕凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3861,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晚泊二绝 其一","author":"葛立方","text":"晚泊牛羊已下来，清泉为我洗尘埃。\n解颜客里无卮酒，壁上寻诗笑几回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3862,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游衢州乌巨山乾明寺","author":"葛立方","text":"乌巨山前谈实谛，江郎岩畔逗真机。\n白虹示灭知何处，去采山桃又不归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3863,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题曲屏牡丹桃花 其一","author":"葛立方","text":"不与春风别有因，香苞长好四时新。\n曲屏忽见西明种，疑有蓝关竖箔人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3864,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题曲屏牡丹桃花 其二","author":"葛立方","text":"一枝浓艳欲烧空，谁畏门前人姓封。\n岂有落英飘曲槛，与儿洗面作华容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3865,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题卧屏十八花 八仙","author":"葛立方","text":"瑶林琼树非人世，种得仙花雪作团。\n后土祠边还寂寞，只今空对画图看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3866,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题卧屏十八花 白菊","author":"葛立方","text":"天上新栽琪树枝，拖云带月下瑶墀。\n须知正自真仙种，岂是金钿未染时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3867,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题卧屏十八花 芍药","author":"葛立方","text":"沉水飘香透蕊尘，红灯烁烁一枝春。\n鼠姑倚槛虽无赖，未肯甘为近侍臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3868,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题卧屏十八花 杏花","author":"葛立方","text":"赖乡仙种手亲栽，春闹枝头满意开。\n正拂文君酒垆上，莫教蜂蝶等闲来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3869,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题卧屏十八花 杜鹃花","author":"葛立方","text":"云昏水暖草萋萋，空谷无人独杖藜。\n却忆西江石楼老，送春花下子规啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3870,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题卧屏十八花 苣霜","author":"葛立方","text":"密叶高丛傲岁寒，殷红腻绿映江干。\n沉香亭畔无消息，赖有霜前秋牡丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3871,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题卧屏十八花 姚黄","author":"葛立方","text":"抗旌汾浦根移白，竖箔蓝关花染红。\n欲识龙媒空万马，宫袍黄挟御炉风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3872,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题卧屏十八花 牵牛竹","author":"葛立方","text":"高节本为青女伴，牵牛弗悟配龙孙。\n孔融天下无双士，并坐尊前对虎贲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3873,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题卧屏十八花 海棠","author":"葛立方","text":"濯锦江边雨露匀，杜鹃啼血染香缯。\n自缘佳处诗难貌，可是无花开杜陵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3874,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题卧屏十八花 梅花","author":"葛立方","text":"含章英落佳人睡，却月香残水部诗。\n何似江南觅春信，和香先得最南枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3875,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题卧屏十八花 黄菊","author":"葛立方","text":"秋入重阳气倍清，东篱采菊眼偏明。\n杯中要作茱萸伴，不是湘累餐落英。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3876,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题卧屏十八花 蜀葵","author":"葛立方","text":"倾心小圃阳初照，束火中庭雨不沾。\n袅那腰支浑欲舞，好令韩偓赋香奁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3877,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题卧屏十八花 榴花","author":"葛立方","text":"琴轸含房风未吹，盈盈脉脉度炎晖。\n怪来一夜丹须拆，杯酒新翻阿措衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3878,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题卧屏十八花 蔷薇","author":"葛立方","text":"香风细细入东荣，嫩刺柔条叠绛英。\n飞下神霞缘底事，剪来曾倩董双成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3879,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题卧屏十八花 酴醾","author":"葛立方","text":"玉骨檀心不肯妆，牵丝引蔓过东墙。\n政须把酒酬清艳，莫待幽香閟枕囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3880,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"操叶舟凌巨浪访道祖 其二","author":"葛立方","text":"一顷烟波渺太空，独操莲叶破青铜。\n炊烟不动无桐甑，底处求僧与二童。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3881,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"操叶舟凌巨浪访道祖 其一","author":"葛立方","text":"一牛鸣处是君家，乘兴烟蓬蹴浪花。\n银浦流云新得路，人惊仙客在浮槎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3882,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠施尧年老人 其三","author":"葛立方","text":"谒叟支筇步后吴，茅檐枳落水平铺。\n大儿侍侧霜飘领，犹著荆衣学弄乌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3883,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠施尧年老人 其一","author":"葛立方","text":"何须石室秘仙书，家有云英尚药炉。\n奕世大年缘底事，知君华胄出肩吾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3884,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠施尧年老人 其二","author":"葛立方","text":"从今九夏即期颐，小楷犹搜贺雨诗。\n未得雨时曾过我，见君忧色上庞眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3885,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"避地伤春六绝句 其六","author":"葛立方","text":"菖叶青青杏蕊新，牛耕白水一犁匀。\n茜裙窥爱疏篱晚，不是沉香倚太真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3886,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"避地伤春六绝句 其五","author":"葛立方","text":"石门连日动征鼙，花柳无情自绕溪。\n回首故园今好在，杜鹃花落子规啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3887,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"避地伤春六绝句 其四","author":"葛立方","text":"碧罗天宇乱花稠，搔首花阴只重愁。\n头上无貂堪换酒，开箱赖有骕骦裘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3888,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"避地伤春六绝句 其一","author":"葛立方","text":"一年春事又阑珊，可惜芳菲愁里看。\n慎勿扫花供喂马，恼人秀色自堪餐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3889,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"避地伤春六绝句 其三","author":"葛立方","text":"枯藤六尺步长阡，客里韶光绝可怜。\n好著青枫重试火，西阳三日突无烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3890,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"避地伤春六绝句 其二","author":"葛立方","text":"洛阳宫阙半成灰，草草花枝溅泪开。\n国色天香消息断，妆台谁奉紫金杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3891,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九日庆善示诗次韵","author":"葛立方","text":"眼明逢九日，习气自多生。\n官冷有闲趣，花开无世情。\n玄嚣何许是，素浐第存名。\n百岁风狂似，东篱且掇英。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3892,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"二老堂","author":"葛立方","text":"去家才隔水一股，二老堂成三百弓。\n鸰原暮下沙水暖，雁行夜落霜天空。\n竹根酌酒不妨醉，花萼斲诗如许工。\n坐久与关筇竹杖，出门人指两仙翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3893,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十一月十日酒散已二鼓与千里步月因至水堂 其一","author":"葛立方","text":"雪后泥方冻，酒阑寒少威。\n傍云生夜月，唤客出柴扉。\n篱败犬声合，街闲人影稀。\n石栏山几尺，暝霭只依依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3894,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十一月十日酒散已二鼓与千里步月因至水堂 其三","author":"葛立方","text":"杖策踏霜月，满空烟雾浮。\n苍颜酡蚁酒，黑帝避貂裘。\n太液池台晚，广寒宫殿秋。\n归来清耿耿，未省喘吴牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3895,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大人游千金访张仲宗以守舍不得侍行用仲宗韵二首 其二","author":"葛立方","text":"闻道千金好，幽人已奠居。\n森森松绕寺，㶁㶁水循渠。\n旅泊未妨酒，长饥犹著书。\n谪仙诗酒地，今尚指匡庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3896,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大人游千金访张仲宗以守舍不得侍行用仲宗韵二首 其一","author":"葛立方","text":"古寺依烟艇，一篙春水深。\n石坛幡转影，玉殿磬流音。\n客有张公子，僧皆支道林。\n行行云水窟，幽梦渺难寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3897,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大人筑室将毕道祖亦作宅基治园作四诗示道祖 其四","author":"葛立方","text":"世事只如许，幽居诚乐哉。\n报安知楚竹，索笑得江梅。\n岸放平湖入，窗邀远岫来。\n两家车马地，莫遣染苍苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3898,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大人筑室将毕道祖亦作宅基治园作四诗示道祖 其二","author":"葛立方","text":"蓬转欣小定，泛金非我乡。\n买田无好畤，共宅有清漳。\n菱罢水天接，风来花草香。\n邗沟风月地，怊怅隔参商。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3899,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大人筑室将毕道祖亦作宅基治园作四诗示道祖 其一","author":"葛立方","text":"习隐肯回驾，求荣难著鞭。\n有心营绿野，无梦到凌烟。\n盏斝花开里，檐楹雁落边。\n冰清仍玉润，共此一山川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3900,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"子直近日画笔稍进而棋似倒长作诗戏之","author":"葛立方","text":"沈郎终日掩柴扉，游艺虽多道日肥。\n东绢丹青真得髓，文楸黑白要知机。\n笔添龙眼防颓壁，阵合鱼丽孰解围。\n暇日杖藜须过子，一枰赢取画图归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3901,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"小酌以诗招道祖分茶","author":"葛立方","text":"宝胯开缃叶，香尘堕柘罗。\n汤鸣檐雨细，盏占陇云多。\n连日伊蒲塞，今朝热洛河。\n春风入诗腹，五字与君哦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3902,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"己卯岁四月二十七日自湖州赴宜春郡馀杭出陆至富阳","author":"葛立方","text":"发轫出江津，晴熏绿野匀。\n泉声漱莎石，岚翠湿衣巾。\n天近云冲马，林深鸟唤人。\n将身入图画，谁复羡麒麟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3903,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"不饮","author":"葛立方","text":"蒲团藜杖屋三间，世故真成触与蛮。\n但有云山供送目，傥无尊酒亦开颜。\n吴宫雪纻鹤翎散，历社风荷象鼻弯。\n老子何曾持入梦，百年鼎鼎鬓毛班。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3904,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"不寐","author":"葛立方","text":"年来百念如灰冷，何物关心搅睡眠。\n奠枕不容安丙夜，乘轺端复类丁年。\n曲中谁辨齁齁趣，梦里难成栩栩然。\n只恐睡蛇钩已尽，髦蛮难到曲屏边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3905,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"丐祠将离云间崔申之以诗为别次韵","author":"葛立方","text":"荆兰戏綵关情切，朱墨为官与愿违。\n夜鹤帐空周子去，秋鲈风动季鹰归。\n忍看妙句金声振，行阻清谈木屑飞。\n引领吴兴何许是，碧云深处暮山微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3906,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"为章道祖作颇及葛藤 沧浪亭","author":"葛立方","text":"沧浪亭下水连溪，影倒虚檐凤翅齐。\n白小牵风动晨镜，碧圆著雨响秋鼙。\n鱼舟点点依蘋渚，雁齿依依跨柳堤。\n旧日沧浪元不变，何妨居士为全提。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3907,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"为章道祖作颇及葛藤 缀景亭","author":"葛立方","text":"烟溪云巘映朱扉，声色丛中入定时。\n十万丈夫森铁甲，三千宫女醉瑶池。\n累累珠帐露滋颗，点点金衣霜著枝。\n心境消融无一物，景从何得缀为谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3908,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"为章道祖作颇及葛藤 锦薰閤","author":"葛立方","text":"窈窕轩窗小閤深，种花卜得半晴阴。\n眼根忽堕锦绣谷，鼻观如游薝卜林。\n莫问花枝有开落，须知法性勿来今。\n色香尘里回光照，只这凡心是佛心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3909,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"为章道祖作颇及葛藤 踊山閤","author":"葛立方","text":"横空复閤面嵯峨，影堕前溪瑟瑟波。\n九坂端疑筑梁第，二山应恐负夸娥。\n凌云北固俗尘远，采菊东篱真意多。\n会取祖师端的意，此间万象正森罗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3910,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"天游以前韵赋雪诗走笔和","author":"葛立方","text":"剪水飞花下玉墀，驼裘忍冻一窥之。\n寒侵凿落豪呼酒，冰合陶泓懒赋诗。\n嵩岭齐腰缘个事，剡溪鼓棹欲何规。\n唯欣嗣岁千仓积，玉烛调和运四时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3911,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"月蚀","author":"葛立方","text":"六月炎歊气郁蒸，缘空宝镜没埃尘。\n长歌不见徘徊影，并出初无龃龉轮。\n麟斗何因识星度，鹊飞谁复见天津。\n春秋不著诚非异，毋惑东家号素臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3912,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"比访叔才旋蒙赐诗以贫不能留客为愧次韵","author":"葛立方","text":"一舸风帆放晚秋，访君幽巷卜淹留。\n绿摇岸柳容如舞，碧蘸溪毛美可羞。\n喜见林宗銮为辍，久钦阿大语难休。\n士贫鸡黍无劳具，谋食何如道可谋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3913,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"比赋棋画诗蒙子直次韵复和","author":"葛立方","text":"东床高韵画兼棋，不比寻常似瓠肥。\n莫向谢安争别墅，自同刘子得天机。\n翻成小窟乖三捷，规出神光诧一围。\n二事相从真可乐，篮舆访子殆忘归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3914,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"风起","author":"葛立方","text":"炎蒸困钳釱，虎啸漏天机。\n树杪忽垂髻，榴边今污衣。\n草鸣溪水立，帆饱客船飞。\n更设琉璃簟，瓜茶迟落晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3915,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"冬至小雨踏泥出谒","author":"葛立方","text":"葭灰动玉琯，丝雨惨良辰。\n幽巷未通屐，高人犹垫巾。\n底忙持爵里，冲冷候比邻。\n犹胜邯郸驿，灯前影伴身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3916,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"礼部尚书洪公挽歌词 其三","author":"葛立方","text":"高材博识服簪绅，玉树瑶林绝点尘。\n氏族源流推肉谱，春秋褒贬藉调人。\n膝间韵磬传山水，枰上枯棋战楚秦。\n妙处不传今已矣，遥瞻遗像泪沾巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3917,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]