[{"title":"江东报英烈拟封二字侯喜成三绝 其一","author":"钱时","text":"焕章飞报下徽州，英烈将褒二字侯。\n千古沉沉黄壤骨，一朝提上碧云头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61758,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江东报英烈拟封二字侯喜成三绝 其二","author":"钱时","text":"胡尘明越连焦土，海道温台暂翠华。\n西溯涛江渠叵测，不知豪杰起山家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61759,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江东报英烈拟封二字侯喜成三绝 其三","author":"钱时","text":"长驱席捲蹑遐踪，蓦地桐江一扫空。\n北走天骄吾事了，归来袖手敢言功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61760,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江岸群牛用前韵","author":"钱时","text":"江边犊子喜新晴，草软沙平满意春。\n自食自眠渠自乐，不消多费牧牛人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61761,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"池上梅开一花","author":"钱时","text":"蜀阜溪山堪老眼，岁寒风月尽闲身。\n凭栏政尔吟无句，忽报梅梢一点春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61762,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"池上梅复开一花今数日矣始成绝句","author":"钱时","text":"一花消息小春前，冷眼相看似故年。\n但觉老怀诗渐懒，略无行遣到花边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61763,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"池上梅烂开一枝横竹间方蕊","author":"钱时","text":"临池满树玉离披，纵有馀香已不奇。\n蹈雪过来亭上坐，竹閒疏蕊忽横枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61764,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"灯夕有感二首 其二","author":"钱时","text":"忆得儿时三五夜，人间此乐有涯哉。\n不知节物将春去，只道春随节物来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61765,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"灯夕有感二首 其一","author":"钱时","text":"箫鼓分明搅夜阑，山翁和月倚栏干。\n儿童争噪梅花烛，不解将花仔细看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61766,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"百丈寺竹所","author":"钱时","text":"向来百丈有清规，此日山中肯者谁。\n檐外萧萧群玉立，不由客子不题诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61767,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"百丈有感","author":"钱时","text":"不染东华一点尘，桑麻满眼土风淳。\n如何林下无嘉客，却有西湖浩荡春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61768,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"竹所睡起偶成书呈谢守之","author":"钱时","text":"万竹中通两牖虚，红尘炎暑不关渠。\n幽人日用底难办，一榻午风清有馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61769,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"老仲夜集","author":"钱时","text":"谭兵谁是古君子，说易难逢大丈夫。\n风月岁寒双塔夜，一卮清露世间无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61770,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自述九首 其九","author":"钱时","text":"毫分缕析较便宜，若个便宜总不知。\n总是自家家里事，十分明白十分疑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61771,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自述九首 其八","author":"钱时","text":"山翁何处是便宜，若个便宜合属谁。\n千古英雄誇好手，到头都没个人知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61772,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自述九首 其七","author":"钱时","text":"山翁何处是便宜，正是吟边得句时。\n长向升平风露里，满天和气属吾诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61773,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自述九首 其六","author":"钱时","text":"山翁何处是便宜，正是溪头雨足时。\n水鸟傍人飞又去，一湾新绿绕长堤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61774,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自述九首 其五","author":"钱时","text":"山翁何处是便宜，正是西郊散脚时。\n天地春风和气里，绿杨堤上瘦筇枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61775,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自述九首 其四","author":"钱时","text":"山翁何处是便宜，正是凭栏晚眺时。\n忽地小桃当面笑，著何言句可酬伊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61776,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自述九首 其三","author":"钱时","text":"山翁何处是便宜，正是池边独立时。\n一饷柳风轻拂面，婆娑斜日弄金丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61777,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自述九首 其二","author":"钱时","text":"山翁何处是便宜，正是冬窝独坐时。\n不是惺惺强无事，实无个事可思为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61778,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自述九首 其一","author":"钱时","text":"山翁何处是便宜，正是晴窗睡足时。\n庭户无人春寂寂，入帘幽鸟语高低。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61779,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舟中卧听守之读皇宋诗","author":"钱时","text":"一转船头便是归，蓬窗初煖睡偏宜。\n略无梦到华胥国，枕上听歌圣宋诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61780,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观富郑公及东坡颍滨无垢著名禅派口占","author":"钱时","text":"唐虞千古旧规模，周孔谁云不丈夫。\n幸自家风皇极教，未消宗派祖师图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61781,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"许由亭其来远矣名以名之非便也下有白牛桥洗耳滩皆当时事宜揭之以洗耳","author":"钱时","text":"尧舜相传自执中，一瓢赢得迈高风。\n白牛桥下沧浪水，应洗人间万古聋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61782,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过九里湾二首 其二","author":"钱时","text":"吟风吟雨又吟晴，春满诗囊不负春。\n一韵到家三十首，人间有底等闲人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61783,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过九里湾二首 其一","author":"钱时","text":"溶溶泛日桃溪浪，濯濯抛风柳岸春。\n天地十分和气里，此时无语倚蓬人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61784,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初闻杜鹃","author":"钱时","text":"庭前细雨湿莓苔，花鸟知时不待催。\n茂院天葩开满树，一声清晓杜鹃来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61785,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别朱几仲","author":"钱时","text":"古貌臞然一病翁，胸中戈甲气如虹。\n子房元凯能骑马，破贼红旗未足功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61786,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别许正甫","author":"钱时","text":"昭如揭日莫生疑，万变纵横用者谁。\n会得有言犹是病，向无言处更深思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61787,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别诸亲友二首 其一","author":"钱时","text":"良会难逢万事非，弥旬缱绻思清微。\n家山一夜梅花发，月霁风光夜欲归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61788,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别诸亲友二首 其二","author":"钱时","text":"四十年间梦已非，论文谈道意方微。\n愿言著眼羲皇上，南北东西莫浪归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61789,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"含晖晚眺","author":"钱时","text":"雨声欲断气氤氲，小阁浮空自吐吞。\n古木苍烟何处寺，数声青板报黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61790,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"张明发有问用前韵谢之","author":"钱时","text":"本自光明不费灯，个中元不隔微尘。\n如何曾点归来后，千古无人解咏春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61791,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"抛滩前韵","author":"钱时","text":"舟著滩根半雨晴，何须争浪苦争春。\n抛从漫处平平上，绝胜从前弄险人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61792,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"旷轩","author":"钱时","text":"巨鳌飞出水精宫，蹙踏群山气象雄。\n更觉我来轩愈旷，乾坤舒卷一襟风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61793,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"沧浪亭有感二首 其二","author":"钱时","text":"莫倚危栏学冻吟，英雄到此泪沾襟。\n纷纷只解毛锥子，毕竟何人办赤心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61794,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"沧