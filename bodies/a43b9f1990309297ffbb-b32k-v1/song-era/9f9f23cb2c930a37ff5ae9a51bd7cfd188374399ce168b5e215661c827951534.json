[{"title":"和黄先卿即事五首 其二","author":"王炎","text":"鸿雁南随暖，玑衡北转杓。\n忍贫居自稳，得句兴偏饶。\n藜杖难频出，蒲轮合见招。\n惜无推毂手，寂寞老渔樵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16030,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和黄先卿即事五首 其三","author":"王炎","text":"水落洲争出，天寒日易昏。\n倦游来异县，小隐住荒村。\n鹤骨缘诗瘦，鸡肤借酒温。\n长须烦洒扫，吾欲叩柴门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16031,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和黄先卿即事五首 其一","author":"王炎","text":"见说幽栖地，长年只杜门。\n谁知双井后，今有此公存。\n钓月操莲叶，批云卧竹根。\n静中观物化，画外识乾坤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16032,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和游尧臣劝农韵","author":"王炎","text":"传呼稳凭笋舆行，喜见漫山麦浪平。\n道上老农皆好语，年来瘦地有新耕。\n草深黄犊阳坡暖，雨过青蒲野水生。\n桃李阴中春事好，田家鸡犬亦欢声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16033,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和游尧臣出郊二首 其二","author":"王炎","text":"小窗独坐怯轻寒，一穗香云绕博山。\n鹊语匆匆来屋角，梅花点点下栏干。\n马蹄破雨休行役，麈尾生风共燕閒。\n只恐日边需振鹭，锋车早晚趣君还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16034,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和游尧臣出郊二首 其一","author":"王炎","text":"崎岖深谷与崇冈，王事有期行李忙。\n玉佩泉鸣清醉耳，剑铓山峭割愁肠。\n鸟鸣花发年华改，雨暗云昏客路长。\n且喜归来同笑语，蒲团棐几似僧房。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16035,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和程丞游清水岩黄龙山韵","author":"王炎","text":"岚光野色共扶舆，见说壶天气象殊。\n叠巘吞云圭角露，寒泉触石篆文纡。\n荒凉佛屋存遗像，窈窕仙岩有别区。\n何日青鞋亲扣历，细评佳致染松腴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16036,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和程丞游清水岩黄龙山韵 其二 黄龙山","author":"王炎","text":"未闻衲子著深功，但见龙孙送好风。\n尊宿尚留双塔在，众丘皆让一山雄。\n禅关暂到何须住，法窟虽深岂用穷。\n若问如如心自在，梦魂不入大槐宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16037,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和程丞游清水岩黄龙山韵 其一 黄龙山","author":"王炎","text":"老南蜕骨几何年，揖客支筇谩曲拳。\n本自心清无染著，岂因境静息攀缘。\n我行不值挥犀语，公到惟堪扫榻眠。\n尚有诗魔降未得，不禁物色巧勾牵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16038,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和韩毅伯拟别","author":"王炎","text":"踉蹡揖客客为谁，依旧骊珠色陆离。\n不谓远游来此地，未能小隐待何时。\n惯看覆手仍翻手，休问开眉与皱眉。\n归去淮山访猿鹤，清风满袖自披披。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16039,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和韩毅伯咏雁","author":"王炎","text":"孤飞欲作上林游，塞北来时天始秋。\n世路岂无矰缴虑，水乡聊作稻粱谋。\n摩云不惮关山远，刷羽定非鸡鹜俦。\n待看草青烟浪暖，带将春色离南州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16040,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和韩毅伯述怀","author":"王炎","text":"洗盏从容对圣贤，笑谈未了意悽然。\n折腰我既惭陶令，肆志公宜学仲连。\n三沐三熏嗟已晚，一觞一咏乐馀年。\n人穷愈甚诗方好，留取珠玑向后传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16041,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和韩毅伯韵三首 其三","author":"王炎","text":"万里乾坤尚侧身，诸公青眼拂埃尘。\n平生毛颖义相许，今日方兄情稍亲。\n信有朱弦能使鬼，肯将拱璧暗投人。\n不妨岁晚留行色，梅柳梢头已报春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16042,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和韩毅伯韵三首 其二","author":"王炎","text":"有客回车肯再过，天寒冰雪满关河。\n家贫草具惟鸡黍，地僻柴门但雀罗。\n人固刚肠穷已甚，天无老眼命如何。\n男儿自许功名事，相对肯悲弹剑歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16043,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和韩毅伯韵三首 其一","author":"王炎","text":"鹊寄先声到敝庐，故人回首意何如。\n我方无事能高枕，子亦徐行可当车。\n小瓮床头新注酒，青灯窗下静观书。\n齑盐冷淡商今古，恐胜朱门食有鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16044,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和廖守岳阳楼韵三首 其三","author":"王炎","text":"清香燕寝憩儒先，出对湖山一莞然。\n红旆小驱聊缓带，青云直上且扬鞭。\n肯容坐客同挥麈，莫惮行厨费击鲜。\n种就巴丘桃李径，不应画诺更留连。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16045,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和廖守岳阳楼韵三首 其二","author":"王炎","text":"蛟螭旗尾拥楼头，偃仰胡床护一州。\n水阔三江成汇泽，风高六月有清秋。\n长吟不减白蘋句，坐啸能分黄屋忧。\n凭槛可穷千里目，角声呜轧楚帆收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16046,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和廖守岳阳楼韵三首 其一","author":"王炎","text":"湖水无波亦蹴天，君山蟠结独岿然。\n未须吊古怀骚客，聊复凭虚揖吕仙。\n霁月光风供笑傲，长篇短句总流传。\n尊中况有蒲萄绿，试作长鲸饮百川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16047,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和毅伯见寄","author":"王炎","text":"欲问故人归未归，江湖不见雁南飞。\n青云未上辞乡国，白璧无因困褐衣。\n客里书来行李滞，江南春尽落花稀。\n倚门望断山川远，我却疑君此策非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16048,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜坐","author":"王炎","text":"月白侵衣冷，窗间对一灯。\n淹留归未得，进取我何能。\n空室无天女，清谈只衲僧。\n不嫌身寂寞，绝喜睡瞢腾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16049,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庚申元日","author":"王炎","text":"九陌欢声合，三宫瑞气开。\n阴云催岁换，霁日迓春回。\n郁垒还当户，屠苏强举杯。\n二雏无返日，羸老不胜哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16050,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"招同官诸宣教一饭用舟字韵成拙句","author":"王炎","text":"士要飞腾及黑头，肯来挥麈试同谋。\n已携荷叶招欢伯，莫笑花枝欠杜秋。\n老我馀年思钓渭，诸君他日合封留。\n胸中器度须深阔，江汉方行万斛舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16051,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"炎十世先陇在婺源不归拜扫者九年清明有感遂成小诗","author":"王炎","text":"九陌黄尘里，不知桃李开。\n匆匆春又过，逐逐老相催。\n浮脆身如露，纷华念已灰。\n松楸无恙否，久客盍归来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16052,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"述怀三首 其三","author":"王炎","text":"百指久转食，一身今倦游。\n事无非堕甑，心本是虚舟。\n傥不尝艰阻，渠能寡悔尤。\n管城虽解语，懒赋畔牢愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16053,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"述怀三首 其二","author":"王炎","text":"宦薄因谋拙，心安任数奇。\n功名半幅纸，权利一钩丝。\n已作络头骥，殊惭曳尾龟。\n暂时深袖手，风月话襟期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16054,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"述怀三首 其一","author":"王炎","text":"久客二年半，故乡千里馀。\n儿曹穿草屦，老子挂柴车。\n世事杯中物，生涯箧里书。\n一廛何日办，衰晚忆吾庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16055,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金夫人挽诗","author":"王炎","text":"两大家声著，三从妇德全。\n金珠捐玩饰，蘋藻荐恭虔。\n眉寿无遗恨，心空悟秘诠。\n生刍来奠客，千两拥新阡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16056,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"俞义夫挽诗","author":"王炎","text":"恩爱周姻族，宽和善里闾。\n年高无悔吝，身没有名誉。\n愿见今何及，从游旧亦疏。\n若修耆旧传，言行可追书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16057,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南斋书怀","author":"王炎","text":"幽居用拙懒追寻，小径无人苔半侵。\n燕子已归知社近，桃花半破觉春深。\n长编短简资身策，故岁新年念母心。\n拂拭横床眠未稳，匆匆屋角有鸣禽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16058,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"复州道中二首 其二","author":"王炎","text":"私喜归期近，天边更远游。\n士须尝险阻，吾敢恨淹留。\n尘事蚁旋磨，浮名鱼中钩。\n春风桃李月，倚柂看东流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16059,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"复州道中二首 其一","author":"王炎","text":"岁事已告毕，客行殊未归。\n蒌蒿穿雪长，水鸟背人飞。\n沮洳蒹葭远，村墟烟火稀。\n边风吹莫色，短策度斜晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16060,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"将使有诗欲移具相邀到双溪因次韵","author":"王炎","text":"缅思花下饮，岁月易侵寻。\n人老今华发，春深半绿阴。\n挥毫来妙语，移具有佳音。\n草木生光彩，青藜肯下临。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16061,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日书怀","author":"王炎","text":"自怜童稚色凄凉，偃伏田庐岁月长。\n用拙漫令文有冢，避愁不惯醉为乡。\n春来雨禁鸟乌乐，天末风回鸿雁行。\n轩冕山林两无得，讳穷徒觉意苍茫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16062,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日丛桂书舍偶成二首 其二","author":"王炎","text":"檐头燕子话新晴，客里春来何似生。\n短榻曲肱眠未稳，好花刺眼笑相迎。\n生憎重碧杯中物，懒趁踏青江上行。\n燕坐翛然有佳处，耳根更听读书声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16063,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日丛桂书舍偶成二首 其一","author":"王炎","text":"芳草青青昼掩关，倦游心绪叹重山。\n寒生怪雨盲风后，春在斜阳暮霭间。\n杜宇劝人归小隐，桃花笑我欲苍颜。\n腐儒未解谋生理，鱼蠹陈编不自閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16064,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日遣怀","author":"王炎","text":"感怀细数十年事，养拙略无终日閒。\n景物自新春稍稍，吾亲渐老发斑斑。\n岂曾有梦到天上，且任此生浮世间。\n愿约渔樵同小隐，谓予不信有南山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16065,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春兴二首 其二","author":"王炎","text":"山远烟蒙树，汀回水啮沙。\n云阴初解驳，春色已光华。\n土润麦争秀，日蒸桃欲花。\n杜门无可喜，鹊语误楂楂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16066,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春兴二首 其一","author":"王炎","text":"蔓长宜诛草，花飞可吊梅。\n断云将雨去，啼鸟唤春回。\n书乱时开帙，樽空久覆杯。\n长年观景物，不复起衰怀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16067,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春雨","author":"王炎","text":"唤雨苍鸠罢，山高云更隮。\n泥深妨著屣，水足有扶犁。\n索酒无同饮，哦诗只自题。\n小窗回午梦，邻舍一声鸡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16068,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋日晚晴","author":"王炎","text":"断霞缕脉浅深红，雨挟凉来助好风。\n心厌乱蝉专美荫，目随高鸟度晴空。\n此身尚落功名外，生理方侵念虑中。\n坐到夜深明月上，秋声故故绕梧桐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16069,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋怀二首 其二","author":"王炎","text":"朅来云梦泽南州，风物萧萧两见秋。\n三径草荒真左计，一官冰冷更何求。\n莫招毛颖论时事，且唤曲生浇客愁。\n短艇轻蓑良不恶，此心何敢负江鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16070,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋怀二首 其一","author":"王炎","text":"镜中忽忽老侵寻，政坐文穷自陆沉。\n独对西风搔短发，欲谋小隐背初心。\n江湖鸿雁天将冷，篱落黄花秋又深。\n拄笏看山聊尔耳，懒弹绿绮索知音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16071,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋旱得雨子大诗言祈祷所致炎谓不可贪天之功次韵以见区区","author":"王炎","text":"宦游碌碌本无奇，失脚归来莫皱眉。\n只合一廛修穑事，岂堪千骑把州麾。\n旱乾偶得崇朝雨，秋熟应无卒岁饥。\n耕凿熙熙皆帝力，丰年请为续周诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16072,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋夜","author":"王炎","text":"索索风叶响，寒生秋夜深。\n閒思千古事，虚费一生心。\n命薄谋多拙，年衰病易侵。\n黄粱今梦觉，高枕卧山林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16073,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"胡清卿来访留一日亟求去云欲谒郑宰因以小诗佐其行","author":"王炎","text":"跋涉山川岁一归，奚奴古锦惯相随。\n自怜机杼无遗巧，却怪珠玑不疗饥。\n酌酒挽君浇舌本，解骖许我话心期。\n空囊羞涩将焉往，笑说凫仙旧见知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16074,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺吴兴郡王生日","author":"王炎","text":"花萼楼台畔，年年瑞气新。\n慈闱欢爱洽，帝殿宠光频。\n清静心如水，和平气似春。\n自然眉寿永，何必羡松椿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16075,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺皇太子生辰 其二","author":"王炎","text":"郁葱佳气拥天庭，申命无疆启震亨。\n少海永重瀛海润，前星长拱极星明。\n螭旗色转秋风爽，鸡戟光凝晓月清。\n遥想宫僚斟玉斝，进趋无地倍驰情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16076,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺皇太子生辰 其一","author":"王炎","text":"凤姿日表极高明，讲习诗书若性成。\n参决万机裨独断，力行三善答舆情。\n绮园何必来为助，启诵安能更擅名。\n日侍两宫慈孝洽，万年主鬯共安荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16077,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺景高新居","author":"王炎","text":"百楹夏屋势渠渠，气象岿然压里闾。\n庭下紫荆方秀茂，阶前玉树亦扶疏。\n门容驷马于公宅，客佩金鱼吏部庐。\n莫使乌衣文彩减，诸郎勤读五车书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16078,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赵处州挽诗 其一","author":"王炎","text":"秀邸多英俊，惟公最有声。\n君陈兼孝友，子政极忠精。\n白璧千金价，青云万里程。\n皇天无老眼，名位止专城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16079,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赵处州挽诗 其二","author":"王炎","text":"白首来苕霅，深知有故人。\n登门虽不数，倾盖本相亲。\n浮鹢行方远，烹鱼墨尚新。\n青山埋玉树，老泪漫沾巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16080,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"追念鳙溪老人 其二","author":"王炎","text":"绕屋青山锁白云，其人如玉已埋沈。\n瘦筇未扫往来迹，遗墨半存长短吟。\n有客不堪频堕捷，此生无复见知音。\n天寒日短凄凉甚，老眼皇天照此心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16081,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"追念鳙溪老人 其一","author":"王炎","text":"交游大半上青云，可使斯人竟陆沈。\n寒日乱山皆惨色，北风古木亦悲吟。\n伤情空拜丹青像，提耳不闻金玉音。\n舐墨欲书耆旧传，无言三叹我何心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16082,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"追悼亲哥","author":"王炎","text":"昔在清华日，明珠掌上新。\n岂期吾薄福，不见汝成人。\n荒冢魂长夜，空山草自春。\n凄凉无限恨，独坐一沾巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16083,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"追悼昭叔弟","author":"王炎","text":"老去无他念，追怀手足亲。\n学成虽漫仕，客处只长贫。\n在昔为三友，如今少一人。\n青山未归窆，回首独伤神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16084,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送王巽泽侍郎 其一","author":"王炎","text":"今代王文度，声名满日边。\n中年登近侍，早岁悟深禅。\n要路频回首，名藩小息肩。\n卷舒无不可，胸次本超然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16085,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送王巽泽侍郎 其二","author":"王炎","text":"屈指桃溪上，差池二十年。\n知心宁易得，识面岂无缘。\n离别何须恨，平安可数传。\n异时如索我，小隐翠微边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16086,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送刘都干","author":"王炎","text":"本叹儒冠误，因思学六韬。\n侵寻身尚困，凌厉气当豪。\n生理旧良薄，亲年今已高。\n匣中雄剑在，早去树旗旄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16087,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送杨明夫郎中持节闽中","author":"王炎","text":"稍觉飞腾疾，方知选择公。\n云霄移列宿，泉岭度春风。\n问俗穷阎底，搜材荐墨中。\n褰帷先办此，续续寄诗筒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16088,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送房陵倅韦同年二首 其二","author":"王炎","text":"德齿皆兄我，曾联淡墨名。\n挥犀方晤语，浮鹢又催行。\n今日惟櫜矢，何人更请缨。\n战尘犹未息，北望若为情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16089,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送房陵倅韦同年二首 其一","author":"王炎","text":"白玉难求市，青云缓作程。\n小烦乘别驾，远去护边城。\n斥堠烽烟冷，谯门鼓角清。\n采桑遗戒在，约束要坚明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16090,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送相士管明甫","author":"王炎","text":"名士多相识，吾乡亦旧游。\n知君倦行役，见我小淹留。\n道路双青眼，风霜一敝裘。\n人中逢燕颔，早为说封侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16091,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送游大冶归建阳","author":"王炎","text":"震泽黄柑熟，苕溪紫蟹肥。\n天寒留客舍，岁晚念亲闱。\n抱负须时用，行藏与志违。\n临分话情愫，衰谢亦谋归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16092,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送谢庭玉二首 其二","author":"王炎","text":"话旧情非浅，遄归意谓何。\n杜门元简出，命驾特相过。\n黄鹄仙翁逝，青衿子姓多。\n属渠勤肄业，岁月易蹉跎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16093,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送谢庭玉二首 其一","author":"王炎","text":"旧事十年久，故人千里疏。\n喜逢青眼语，胜寄锦鳞书。\n草草衔杯酒，匆匆返笋舆。\n桂山今健否，烦为问兴居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16094,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送詹少游之平江","author":"王炎","text":"溪上相逢把盏时，回头今是一年馀。\n闻君有喜驱都骑，顾我无聊守敝庐。\n信道此行骑凤背，未知何日寄鱼书。\n月明千里关山隔，莫为新情忘故居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16095,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]