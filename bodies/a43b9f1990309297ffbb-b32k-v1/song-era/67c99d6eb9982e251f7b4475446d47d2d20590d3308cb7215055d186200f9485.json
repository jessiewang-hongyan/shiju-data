[{"title":"过樊山","author":"薛季宣","text":"谁将春信过中江，草木无情取次芳。\n装罢美人梅破额，愁成行客柳牵肠。\n江滩凿凿添新涨，沙塞茫茫反夕阳。\n款段趷梯樊岭道，几多畦町杂苍黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23506,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"樊山春望","author":"薛季宣","text":"飞出仙人壶外天，壶中日月故依然。\n虚明百雉龙鳞动，空翠千峦翡羽鲜。\n咫尺画图藏世界，侵寻锦绣簇山川。\n归来身入寒溪路，恍若瑶林一梦还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23507,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"济江逆田开府过西阳俞氏家林","author":"薛季宣","text":"轻舟时复到齐安，一过俞家一黯颜。\n江打颓墙开野径，篁生故垒上家山。\n萧骚城郭尘埃外，缥渺烟霞云水间。\n便好系船终日卧，官曹不许片时閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23508,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闻吴王城中军戍严鼓","author":"薛季宣","text":"年时芳草碧蒙戎，聒耳新闻甲夜风。\n军吏误应非进鼓，天王锡忍废彤弓。\n刚言苻诏难倾晋，不信文王可伐崇。\n击柝杜关无个事，钓台江月静朦胧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23509,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿大城寺与寺僧行鄀子故城于壁垒间得铜矢镞土中螺壳往往不坏僧言初作此寺发殿基下有古砖渠宫城中得铜矛矢镞百数南城中土窖积灰埋鹅首骨犹具自瓮城北望有鄀王墓僧云其傍墟冢甚多王墓常有巫者发之未开被蜂毒死巫家于怀袖间得蜂乃黄金所化","author":"薛季宣","text":"二千逆数到春秋，战国兴亡一转眸。\n垒壁讵销埋蚌壳，劫灰宁烬斩鹅头。\n坟缘开发金成范，殿为焚修瓦出沟。\n哨矢燋铜伤我意，古来争战几曾休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23510,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"祈晴车中望安乐宫故址","author":"薛季宣","text":"罢休祈雨又祈晴，天道难知德好生。\n钟鼓铿锵西佛寺，草茅荒秽古王城。\n温舆即就凉舆便，阴气潜消煖气盈。\n栖凤未堪云尚密，可人日脚尚微明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23511,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寒食甚雨中泛东舍溪偶晴游张公石室三首 其一","author":"薛季宣","text":"籧篨烟霭入浮槎，罨画溪干阿果家。\n浩荡天风飞羽盖，缤纷法雨落昙华。\n阪悬饮涧猿连臂，魄褫投牢虎落牙。\n岂是仙翁未神圣，笑谈为我放灵鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23512,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寒食甚雨中泛东舍溪偶晴游张公石室三首 其二","author":"薛季宣","text":"天游无事月中槎，物外仙灵别是家。\n老蝠有方精不化，白驴绝迹眩生华。\n灶馀丹药清毛骨，涧吐清泉厉齿牙。\n回首周郎斩蛟处，晚云当面舞神鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23513,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寒食甚雨中泛东舍溪偶晴游张公石室三首 其三","author":"薛季宣","text":"天河重泛客星槎，便好成都访卜家。\n渭水未成浮竹叶，武陵犹记落桃华。\n传闻铁骑充牛口，暗想楼船破虎牙。\n浊酒一杯山水绿，棹歌三叠百啼鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23514,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"周将军庙观岳侯石像二首 其一","author":"薛季宣","text":"万死何知狱吏尊，威名盖代古难存。\n二桃岂为功高赐，一舸不容身退论。\n几为饮江思道济，缪因图像削王敦。\n沈碑千古蛟川恨，留与无穷客断魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23515,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"周将军庙观岳侯石像二首 其二","author":"薛季宣","text":"军声良苦听南风，说礼敦诗也不容。\n斗蚁达聪良是病，战蜗流血可同宗。\n亲疏间入联镳话，真假言从蹑足封。\n趣诏河阳长已矣，隆中悲切起人龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23516,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雨后","author":"薛季宣","text":"搅人无赖是东风，埽尽春菲一雨中。\n窗外远山装暗绿，眼前佳卉梦新红。\n梅生乐圃枝如缀，草合诚台路叵通。\n芍药牡丹知渐老，折来瓶水玩芳丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23517,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"连日自退谷路抵袁口","author":"薛季宣","text":"晚烟暝雨不胜愁，改日仍为退谷游。\n司事守田如有意，催归脱裤感行休。\n连营谷里旌旗暮，细草杯湖荷芰秋。\n果下马拖泥水去，石头路滑且夷犹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23518,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雨后忆龙翔寺","author":"薛季宣","text":"好溪东赴海门秋，中有禅居涌碧流。\n潮信往来双别屿，世缘生灭几浮沤。\n菱歌面面来渔鼓，灯火层层到客舟。\n何事瓜期外留滞，短窗斜雨不堪愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23519,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春游怀古","author":"薛季宣","text":"登临一度一伤神，功业蹉跎万物新。\n飞鸟远归云外岭，赏花频对眼前人。\n茸茸雨脚南郊暮，种种茅针太极春。\n鼓掌祇供渔父笑，朅来生水拍江漘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23520,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寒食遣兴","author":"薛季宣","text":"介子龙蛇亦大灵，禁烟犹复雨零零。\n时风未办作寒食，春事无过醉醁醽。\n取士语乾三礼穴，延宾为屈五经瓶。\n明年此日家山路，沧漠从君看水萍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23521,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"县舍酴醾始有开意会走迁居簿厅","author":"薛季宣","text":"芳丛累累结珠玑，雨后芬香郁麝脐。\n半醉半醒春昼永，载行载笑洞仙迷。\n青蛇眼见游飞雾，绿绶生愁解佩觿。\n举袂与君为此别，幸传薰德绛囊携。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23522,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"落梅","author":"薛季宣","text":"东风一夕报春来，管领群芳次第开。\n出岫白云如有意，照人明月几难回。\n缟衣聊复归三岛，绿醑无辞举百杯。\n真味不须谈鼎实，等閒谁识锁梁材。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23523,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"折枝水仙","author":"薛季宣","text":"西子苧萝溪浣纱，李白捉月千丈波。\n风流东迤去不尽，玉钏犹传金叵罗。\n芰荷蒲荇争清泚，微香密与和风起。\n可将斋洁祀王明，为言酌献持杯水。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23524,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"月下酴醾","author":"薛季宣","text":"喷人清馥偏閒庭，心醉银釭对醁醽。\n高髻月娥呈素面，孤云天盖拂明星。\n腰支天袅愁萦绪，玉佩招摇尚典刑。\n著意政须延永夜，新条明日定飘零。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23525,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和许簿牡丹二首 其一","author":"薛季宣","text":"天与花王化日舒，可堪买酒共提壶。\n荒凉洛苑芳菲甚，落寞扬州气味殊。\n倾国几迷狂舞蝶，还钱不得迅飞凫。\n清愁怀抱多春感，一苇悬知此意无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23526,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和许簿牡丹二首 其二","author":"薛季宣","text":"清江不解蹋长芦，闷向花前问玉壶。\n秀色可餐谁是伴，浓装独立自应殊。\n醉倾镜外归钟酒，飞尽人间几血凫。\n多占春风称第一，檀心知有谢来无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23527,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"复和仲蟠二首 其一","author":"薛季宣","text":"开缄豁豁皱眉舒，一首新诗酒一壶。\n寒食禁烟春已半，佳人倾国态悬殊。\n园荒不减游群鹿，才尽应悲短续凫。\n有墨牡丹君种否，乡邦能借一畦无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23528,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"复和仲蟠二首 其二","author":"薛季宣","text":"一见春红意已舒，何须幻化入悬壶。\n含芳镇日香千和，作态临风色万殊。\n曲槛乍开金缕凤，清池斜照玉为凫。\n洛阳拟问门园在，王后如今解接无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23529,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"思乡奉和","author":"薛季宣","text":"杯室开门傍石泉，平生活计枕书眠。\n但知身世非人界，不信方家说洞天。\n陋巷分甘颜子乐，一瓢所得许由贤。\n年来把板尘埃去，笑杀商山四皓仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23530,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和钱都官","author":"薛季宣","text":"道学从初小况雄，文光万丈吐长虹。\n凌霜壮节生来劲，喷玉清诗老更工。\n攀槛定须回日御，叫阍端复悟天聪。\n愿公赤舄安狼疐，豳国何曾有变风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23531,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和元直","author":"薛季宣","text":"畴昔相要学娄空，蹉跎行即叹龙钟。\n三千牍欠东方奏，十万兵无小范胸。\n大愧入关歌一箭，终期出塞传三烽。\n蓬莱有愿占云气，又羡江山笔墨供。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23532,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和元可赠别","author":"薛季宣","text":"惟怜踪迹负平生，愧予秋空万里清。\n体道信能忘聚散，论交曾复俟将迎。\n愁多人物输前辈，恨有天公也世情。\n阳羡买田虽旧约，虞歌喜起欲谁赓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23533,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"王朴","author":"薛季宣","text":"海宇煎熬沸鼎时，先生静付一支颐。\n单辞隐几三仁在，大略平边百世知。\n到了勋庸成底事，由来用舍出先几。\n长枪不用毛锥子，应使毛锥自用为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23534,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"酬朱张二秀才皆次其首章韵二首 其一","author":"薛季宣","text":"殃民政虐恐风传，镇日穷愁蝉腹然。\n化物未能参物格，高谈无当若谈天。\n雅歌清唱俱流徵，善听多惭可绝弦。\n何事拦腰撞君价，绝尘奔逸正吾前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23535,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"酬朱张二秀才皆次其首章韵二首 其二","author":"薛季宣","text":"万缘政尔未能佳，绘句彫锼直谩誇。\n客里悬知君有谓，宦游当念我何奢。\n几时西塞歌飞鹭，指日东篱采菊花。\n五斗折腰良自苦，奈今无粟饭胡麻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23536,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"观法帖","author":"薛季宣","text":"字学从前小艺林，谁论终古可传心。\n毛锥刻划龙蛇动，笔阵纵横剑戟森。\n须省六书兼八法，由来一字值千金。\n世人不解张颠圣，刚把碑文镇日临。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23537,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夜闻桂香","author":"薛季宣","text":"秋香烈烈锁房栊，龙麝腥膻不易同。\n清素月中留夜魄，芬芳林下有家风。\n记惟密雪开梅萼，忆过疏篱采菊丛。\n独有平泉旧诗句，浪誇金粟竟非工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23538,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"蓼花","author":"薛季宣","text":"不矜秀色傲春风，笑倚斜阳露气浓。\n秋草凄凉风索索，江天寂静水溶溶。\n岸移晴绮飘仙袂，叶起丹霞照玉容。\n可奈少香香似可，为传滋味入醺醲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23539,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"社日","author":"薛季宣","text":"年去年来春复秋，田丰土谷浪言酬。\n败家谑善崔文纪，宰社均无曲逆侯。\n灯烛灵坛三告祀，燕鸿边塞两淹留。\n不须饮福倾樽酒，聋过今生方始休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23540,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"至樊口三首 其一","author":"薛季宣","text":"一霎重为退谷游，扁舟一叶浪如舟。\n人生百岁浑如许，借问都来几白头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23541,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"至樊口三首 其二","author":"薛季宣","text":"小回中入大回中，激水那堪括面风。\n退谷未堙聱叟笑，钓台宁是不英雄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23542,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"至樊口三首 其三","author":"薛季宣","text":"长安当日碎樊山，闻说孙郎凿岘还。\n舴艋架虚掀舞甚，可堪破舶问前湾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23543,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿大城寺 其一","author":"薛季宣","text":"断烟疏竹锁楼台，鄀子如今安在哉。\n明灭故城无限意，紫薇花傍夕阳开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23544,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿大城寺 其二","author":"薛季宣","text":"新蝉无数咽新秋，故国伊谁伴我愁。\n夜静月明风动竹，也疑离殿过歌喉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23545,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春草曲","author":"薛季宣","text":"霰雪枝头寒已老，平芜一夜铺春草。\n江梅著子怯东风，花落满庭浑不埽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23546,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"樊山春望","author":"薛季宣","text":"东鄂城东安乐宫，李花练绚玉玲珑。\n画图长喜平芜绿，不觉身归罨画中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23547,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"追和澹泊楼先祖诗韵","author":"薛季宣","text":"种柳栽花意已深，曾楼岳立千丈森。\n可须轮奂翚飞翼，会见逍遥天地心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23548,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赴调","author":"薛季宣","text":"三年踪迹走泥涂，走遍泥涂一事无。\n今日又行当日路，旁人为我一邪歈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23549,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"王征引","author":"薛季宣","text":"盆倾暑雨两襄陵，三插苗心悉?生。\n一草不遗禾黍地，若为刍秣事王征。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23550,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"喜闻","author":"薛季宣","text":"若恨珷玞多乱玉，几能沙砾尽披金。\n虞庠旧意无多子，也有箫韶拊搏音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23551,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"帐宿幡竿岭","author":"薛季宣","text":"长笑飞刍馈六军，也驱疲瘁逐征尘。\n楸林卓帐秋风夜，山鸟惊啁可笑人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23552,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"黄陂县怀古","author":"薛季宣","text":"尼丘非复贰先生，逐利滔滔尽舌耕。\n还忆蔡侯当日事，郢州知隔几年程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23553,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"记梦","author":"薛季宣","text":"通梦周公不我欺，咿嘤无若大音希。\n诗人伎子知谁在，一枕邻鸡曙已晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23554,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"病兴即事","author":"薛季宣","text":"东风细细筀芽绿，畏日曛曛天昼清。\n万绪不兴坐兀兀，林端鶗鴃两三声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23555,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"无题","author":"薛季宣","text":"朦胧夜色暗浮云，咫尺氛埃怯战尘。\n深夜鸣榔到庭户，江湖知有钓鱼人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23556,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"魏勃 其一","author":"薛季宣","text":"异姓侯王约重陈，谁知兴复自陪臣。\n滕公刚笑轻齐尉，大勇直须庸妄人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23557,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"魏勃 其二","author":"薛季宣","text":"怒激三军岂足言，汉庭股战始能贤。\n齐卿不及公侯贵，擎跽偷生雄雉前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23558,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书温公集后","author":"薛季宣","text":"不用须藏用即行，未分丘壑与朝廷。\n声名怪得生来盛，非但潜心醉六经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23559,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"读舒王日录","author":"薛季宣","text":"立志嘐嘐必致君，四方观听一时新。\n周家道备骊戎变，流俗元来不误人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23560,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"读鬼谷子","author":"薛季宣","text":"捭阖乾坤若有神，崎岖长短困仪秦。\n无声无臭文王道，应是先生浪鼓唇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23561,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"新岁病起","author":"薛季宣","text":"墙外梅花浑欲飞，萦人无奈柳依依。\n穷愁三识新年面，犹喜当陪乳燕归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23562,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"桔槔","author":"薛季宣","text":"怪得朝来俯仰频，王明用汲有深仁。\n无为抱瓮先生笑，机械邪歈已玩人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23563,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闻鸠","author":"薛季宣","text":"桃李无情花自妍，竹根行复破苔痕。\n新妇抱儿未归去，愧死鹁姑啼满园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23564,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"长湖以南李花弥满山谷诚台望之皞如也","author":"薛季宣","text":"层冰峨峨春不融，璧月皎皎夜常满。\n明河入望浩无津，欲往从之人甚远。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23565,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"酴醾花谢有感","author":"薛季宣","text":"当初曾醉浣花春，席地棠梨当锦茵。\n今日酴醾飘似雪，閒忙不比旧时人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23566,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"巴口感事","author":"薛季宣","text":"曙烟带柳日希微，一簇鱼虾市井迟。\n莫讶上官深致志，云龙曾说锁牙旗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23567,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十四日从诸同官登西山郊坛冈次孟监务韵 其一","author":"薛季宣","text":"催人暖律厌飞灰，高会莲灯懒重陪。\n閒到苏仙旧游处，熙熙不祇登春台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23568,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十四日从诸同官登西山郊坛冈次孟监务韵 其二","author":"薛季宣","text":"菩萨岩泉湛佛乘，澄泓无复现天灯。\n强歌下里酬春雪，便好为文吊剡藤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23569,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十四日从诸同官登西山郊坛冈次孟监务韵 其三","author":"薛季宣","text":"清游无是亦无非，陡绝圆坛一强跻。\n赤壁望中公瑾在，战尘何日静征鼙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23570,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十四日从诸同官登西山郊坛冈次孟监务韵 其四","author":"薛季宣","text":"人间万事尽浮埃，顾影穷游莫倦陪。\n吴王百世不复在，祇有九仞郊天台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23571,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十四日从诸同官登西山郊坛冈次孟监务韵 其五","author":"薛季宣","text":"交神有道非关我，元夜虚张太乙灯。\n拟学昌黎恸河华，扳援石磴多藟藤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23572,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十四日从诸同官登西山郊坛冈次孟监务韵 其六","author":"薛季宣","text":"不论人间是与非，崇丘礧嵬尚慵跻。\n登临自有无穷意，安得閒愁衮地鼙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23573,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"读史记","author":"薛季宣","text":"公旦征淮难疐尾，仲尼去鲁速吹毛。\n圣贤出处平生事，间不容针却中惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23574,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]