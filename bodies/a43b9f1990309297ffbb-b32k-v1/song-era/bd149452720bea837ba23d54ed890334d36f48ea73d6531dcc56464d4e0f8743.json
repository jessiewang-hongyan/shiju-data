[{"title":"次韵任况之见赠 其一","author":"苏过","text":"强辞南亩服儒冠，敢意青云便可干。\n似是马曹宜懒病，却惭鸡肋眷微官。\n眼前簿领成何用，梦里云山得暂欢。\n为问崎岖缘底事，鬓毛萧飒带围宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63479,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵任况之见赠 其二","author":"苏过","text":"知君幼好切云冠，肯为浮名俛首干。\n应笑严徐吐唇吻，欲呼屈宋作衙官。\n地偏心远人知少，酒熟诗成我自欢。\n诗诵髯刘枯槁句，秕糠万事百忧宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63480,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自颍昌归任况之有诗次其韵","author":"苏过","text":"暂抛彭泽故园归，趁见春山笋蕨齐。\n不谓简书诚可畏，便寻渔钓欲重携。\n故人念我勤车马，走笔题诗寄象犀。\n欲遣长须无以报，太牢滋味愧羹藜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63481,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵徐正夫见赠","author":"苏过","text":"自信儒冠不误身，从教尘土满衣巾。\n安能学稼与学圃，已得异书逢异人。\n只影自随空四海，岁寒相伴有孤筠。\n扬雄何日一区老，问字应当载酒频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63482,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵少蕴二首 其一","author":"苏过","text":"画师安得老龙眠，写此西湖李郭船。\n谈麈生风看落屑，诗坛馀勇战空弮。\n拍堤春涨云空阔，夹岸桃蹊锦接连。\n到处聚观千万目，要公膏雨作丰年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63483,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵少蕴二首 其二","author":"苏过","text":"云间笑语杂鹓行，山意波光两浩茫。\n老大读书真伯业，歌呼狎客类平阳。\n丹青遗构风流在，尊酒题诗草木芳。\n湛辈不须悲岁月，羊公名与岘山长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63484,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵伯元咏牡丹二首 其一","author":"苏过","text":"珍重谁移洛下根，玉盘径尺露花新。\n不劳铅粉强为色，自是肌肤淑且真。\n美恶本非春有意，栽培直恐伎凝神。\n空斋独嗅无人赏，鼻送幽香息息匀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63485,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵伯元咏牡丹二首 其二","author":"苏过","text":"草木无情解悦人，徒因见少得名新。\n剪裁罗绮空争似，研合丹青太逼真。\n尤物端能耗地力，痴儿竟欲费精神。\n愿回春色归南亩，变作秋成玉粒匀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63486,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵欧阳诚发牡丹","author":"苏过","text":"青春过隙不多时，佳会应须日日期。\n羡子多情勤秉烛，寻芳问柳每题诗。\n洛花名字争新见，尤物东君剪刻迟。\n安得韩湘写奇句，世间铅粉谩劳施。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63487,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵孙志康牡丹 其一","author":"苏过","text":"春事依稀见一班，山花灼灼强施丹。\n能容丞掾歌呼处，信是平阳度量宽。\n溪上有人归独晚，夜阑秉烛若为欢。\n但筽草檄催诗债，何必重寻落蕊看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63488,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵孙志康牡丹 其二","author":"苏过","text":"樽馀旧压蒲萄绿，盘有南珍荔子丹。\n草草春光虽未称，人人酒令暂须宽。\n兴来勿废无何饮，老去难寻特地欢。\n慰我穷愁真待子，凭诗寄与故人看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63489,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"卜居城南二首酬兄弟甥侄 其一","author":"苏过","text":"萧萧素发插人头，世上功名得汝求。\n神马尻舆安所税，寸田尺宅早归休。\n结茅但使才容膝，解剑还须便买牛。\n更慕少游乘下泽，不妨闾里自沈浮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63490,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"卜居城南二首酬兄弟甥侄 其二","author":"苏过","text":"采椽竹屋亦天真，但喜相望北阮邻。\n等是南柯游此世，聊将传舍诳吾身。\n高门恐负于公志，近市空惭晏子仁。\n定枕不闻尨也吠，荜门圭窦固应贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63491,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵孙志康喜贾子庄还任","author":"苏过","text":"君王物物与恩均，令尹还须畏吏民。\n投劾赋归无二顷，上书遮阙有千人。\n朝阳升处幽阴破，暖律回时草木春。\n看取子文无喜愠，从来冰鉴恃尧仁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63492,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"横山道中","author":"苏过","text":"物外闲人日月长，意行无复有重冈。\n林深步步衣裳湿，麦熟村村饼饵香。\n遥想云间下双舄，空怀仙子望三乡。\n欲寻好句供诗眼，旋逐东风堕眇茫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63493,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"小子籥与其友作㶏亭置酒泛舟唱酬之什予肃戏用其韵","author":"苏过","text":"胜事随年阿堵中，老夫久绝马牛风。\n消磨药石一春过，寂寞樽罍万事空。\n亭下麦秋惊翠浪，山前雨脚卷晴虹。\n渡头试验丰穰意，半是村醪入颊红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63494,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题欧阳晦叔竹癖轩","author":"苏过","text":"海竹纤杉乱苇萑，君家千树独淇园。\n清阴夏簟常留客，疏影秋光共入轩。\n屐阮孰窥尘外趣，锻嵇聊与世人论。\n可怜此路今无几，桃李成蹊不待言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63495,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和良卿病目在告","author":"苏过","text":"寒月侵窗独在檠，幽人燕坐梦魂清。\n一从拾得空花病，十日不闻鼙鼓声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63496,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题李微叔所藏戴嵩暮雨图","author":"苏过","text":"春云漠漠雨垂垂，水满平畴秧稻时。\n青蒻绿蓑晚归去，为问市朝侬不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63497,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵韩文若展江五咏 其一","author":"苏过","text":"山河景色本无偏，须信壶中有洞天。\n明月端地临不夜，珠宫玉宇澹娟娟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63498,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵韩文若展江五咏 其二","author":"苏过","text":"闲寻短棹问溪源，乘兴真为载酒船。\n应学二疏辞汉早，胜游兼作地行仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63499,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵韩文若展江五咏 其三","author":"苏过","text":"绿暗红稀禁火时，使君轩驭雨仍随。\n清风吹得江湖句，争遣诗筒挑鼓旗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63500,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵韩文若展江五咏 其四","author":"苏过","text":"欲追急景去如飞，剩赋新诗酒百卮。\n倒载接䍦扶酩酊，恰如山简醉归时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63501,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵韩文若展江五咏 其五","author":"苏过","text":"新醅泼蚁绿溶溶，时为贤人复一中。\n况有能诗庾开府，论文兴叹有谁同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63502,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵韩文若展江五咏 其六","author":"苏过","text":"睡蛇已死得安眠，扰扰尘中学坐禅。\n我欲退休从杖屦，春明门外有云泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63503,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山行次韵杨良卿见寄二首 其一","author":"苏过","text":"山行六日已逃空，况入青冥窈窕中。\n欲写姓名孤绝处，恐君遗恨不吾同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63504,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山行次韵杨良卿见寄二首 其二","author":"苏过","text":"出谷泉声已转雷，忽惊山断见离堆。\n寻溪便欲挐舟去，留取他时雪夜来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63505,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"道中买得草屦","author":"苏过","text":"买得芒鞋拄杖挑，心先向足蹑云霄。\n山林本是吾归处，不待移文辱见招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63506,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵叶守端午西湖曲水 其一","author":"苏过","text":"远酾清颍入溪渠，左缭孤城转古墟。\n岂止江湖来席上，一苏穷泽十千鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63507,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵叶守端午西湖曲水 其二","author":"苏过","text":"暗泉百道草间鸣，已觉圆荷翠盖倾。\n拟欲挐舟江海去，门前归路是春明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63508,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵叶守端午西湖曲水 其三","author":"苏过","text":"一叶何时纵棹歌，空悲急景怨羲和。\n斜风细雨添愁绝，青蒻蒙头映绿蓑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63509,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵叶守端午西湖曲水 其四","author":"苏过","text":"兵厨酒色似鹅儿，计泛楼船会有期。\n苇折荷枯秋露净，更看镜面渺瀰时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63510,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵叶守端午西湖曲水 其五","author":"苏过","text":"叔度平生挠不浑，注之不满挹无痕。\n甘棠讼息篮舆晚，目送牛羊自下村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63511,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵赵伯充雪中见招 其一","author":"苏过","text":"华堂玉烛夜沈沈，淡月疏星作雪阴。\n天为王孙醒醉眼，晚来雾淞入千林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63512,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵赵伯充雪中见招 其二","author":"苏过","text":"拥鼻袁生方块然，不知玉色浩无边。\n西陂欲与稽山并，贺监风流太白船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63513,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵张次应见寄","author":"苏过","text":"西城夜雨一追攀，前辈风流顿觉还。\n穷似少陵无裋褐，空怀大厦庇千间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63514,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"丛台","author":"苏过","text":"百尺危台高入云，欲将罗绮炫强秦。\n长平一战坑俱满，台上应无豪杰人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63515,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵承之乞鱼于保德","author":"苏过","text":"莼鲈一别信音疏，食指令人尽信书。\n不是分甘慰愁思，临渊空羡计无如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63516,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和叔父所居六首之一","author":"苏过","text":"野卉非千叶，妖红愧两京。\n依然守旧态，谁与制新名。\n琥珀缀圆石，燕脂染落英。\n愿因少陵句，草木亦鲜明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63517,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"张庭实得石名小括苍","author":"苏过","text":"蓬莱异石出珠宫，远涧幽龛定几重。\n玉井分明太华顶，洞天疑是括苍峰。\n穿云细路屏间见，落谷幽泉砚可供。\n谁遣飞来在几案，伴君文史老三冬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63518,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"行军城道中","author":"苏过","text":"北望青山几百重，秋来翠色欲摩空。\n犬戎绝漠今无几，鸟道营粮力已穷。\n岩谷有田空琐细，旌旗何日卷殷红。\n此行岂得功名事，聊欲探奇访葛洪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63519,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送李文儒赴汉东教授","author":"苏过","text":"自欲担簦拾紫朱，谁能碌碌守吾庐。\n割鲜固已夸多获，贾勇今将试有馀。\n环堵未成三径业，束装惟载五车书。\n要令洙泗行江汉，归伴诸儒校石渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63520,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居苦寒 其一","author":"苏过","text":"十里山行步步高，阴风怪穴乱呼号。\n孤灯独掩柴门夜，骨冷谁分范叔袍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63521,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居苦寒 其二","author":"苏过","text":"墙东凿牖纳朝光，掘地为炉土作床。\n快燄生薪聊禦腊，茅茨未必愧华堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63522,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居苦寒 其三","author":"苏过","text":"自扫空山勃落柴，夜深犹复拨残灰。\n更招野叟谈伧语，旋斸蔓菁手自煨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63523,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居苦寒 其四","author":"苏过","text":"傍舍孤嫠八十馀，背无完絮况裙襦。\n分衣愧乏庄公惠，纸被聊将慰老臞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63524,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戏赠吴子野","author":"苏过","text":"从来非佛亦非仙，直以虚心谢世缘。\n饥火尽时无内热，睡蛇死后得安眠。\n饥肠自饱无非药，定性难摇始是禅。\n麦饭葱羹俱不设，馆君清坐不论年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63525,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵王幼安哭韩君表","author":"苏过","text":"公子虽轩冕，山林契夙心。\n坐禅新活计，脱屣旧冠簪。\n共笑谋生拙，知非涉世深。\n颂诗留纩息，妙意可销沈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63526,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏三瘦","author":"苏过","text":"勿轻三士各鸢肩，气吐虹霓诗涌泉。\n共与扶持加药饵，要令山泽著臞仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63527,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"先君与叔父试制策各携一端砚外孙文骥藏其一过藏其一名贤良砚","author":"苏过","text":"两翁出蜀时，不携一束书。\n朅来奉大对，昧死排奸谀。\n谏官与御史，钳口惭青蒲。\n翁登鸾台上玉堂，论恩献纳在帝旁。\n居夷渡海不汝置，险阻艰难曾备尝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63528,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"先公守汝阴尝以诗送都曹路君挂冠东归载乖崖公留其录曹语今传播世间三十年矣过寓居颍昌一日有都曹公之季子文老者来自京师出其家所藏二帖纸墨如新因道存没之旧感慨于怀乃追继先公诗韵以遗文老时方就试春官待报也","author":"苏过","text":"谁闻鬷蔑言，执手为改容。\n此道久寂寥，世态日方浓。\n昔翁守颍尾，轩裳心已慵。\n感怀督邮老，独蹑二疏踪。\n脱屣太仓粟，归谋田舍舂。\n浮云悟此理，可必禄万钟。\n已矣衡门下，哀哉马鬣封。\n箕裘付诸子，介胄轻边烽。\n坐看一战霸，此言天心从。\n翁诗墨犹新，我涕交颐胸。\n重寻笔砚盟，愧乏好语供。\n子非终穷者，时节会自逢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63529,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"政和甲午孟冬休后一日苏过叔党彦明自开化甘泉至明仙时念老禅师复出世矣因题诗壁间","author":"苏过","text":"暂抛尘土扣云扉，山色空濛翠湿衣。\n涧水松风俱有恨，道人瓶钵几时归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63530,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九日诗","author":"苏过","text":"火云收初旦，凄露净中夕。\n良辰非虚名，菊秀萸更实。\n世间孰真乐，心境遇相适。\n华屋与茅茨，何足系欣戚。\n勿云瘴海恶，山水侣吴浙。\n我有环堵居，危台俯清绝。\n及时要行乐，鸡黎随丰乏。\n真一拨新酿，九华袭前哲。\n西邻有书生，破帽衣百结。\n勿惮往来烦，杯中犹有物。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63531,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大人生日三首 其一","author":"苏过","text":"天爵□□□，名高实自分。\n云何困积毁，抑未泯斯文。\n欲救微言绝，先惩百氏纷。\n韦编收断简，鲁壁出馀焚。\n论斥诸儒陋，功逾绛帐勤。\n吾庸亦多矣，奚恤彼狺狺。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63532,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大人生日三首 其二","author":"苏过","text":"天定人难胜，诚哉申子言。\n不须占倚伏，久已恃乾坤。\n八郡裤襦德，三吴肉骨恩。\n少卿真不病，廷尉自高门。\n勿叹乘桴远，当知出世尊。\n无邪有妙理，一悟可长存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63533,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大人生日三首 其三","author":"苏过","text":"大士来淮泗，神交寤寐中。\n应缘济物意，岂为写经功。\n恻隐仁之本，慈悲佛所同。\n虽无逮焚溺，尚欲起疲癃。\n五鼎荣何有，三光路已通。\n回看种桃处，葵麦卷春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63534,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题几仲所居二诗次定国王父旧韵 其一","author":"苏过","text":"菽水奉甘旨，亲安吾不贫。\n平反一笑喜，公子情何真。\n想见斋容膝，端居廓无邻。\n萧然十室间，吾力尚可陈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63535,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题几仲所居二诗次定国王父旧韵 其二","author":"苏过","text":"涉世谁如子，凛然霜中筠。\n独能退藏密，恐污元规尘。\n阮籍废臧否，曹参惟饮醇。\n谁为晤语者，黄卷对古人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63536,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵叔父月季再生","author":"苏过","text":"瘴海不知秋，幽人忘岁月。\n祇记庭中花，几度开还蘖。\n忆昔移居时，始是青荑茁。\n殷勤主人惠，浸灌寒泉冽。\n颜色日鲜好，条枝争秀拔。\n意无后人剪，喜托先生苃。\n海康接儋耳，云水何田蹑。\n俯楹独四顾，怅此波涛匝。\n闻道海门松，僵枝出繁叶。\n困穷不足道，喜有千人活。\n不似玄都花，蔌蔌那容折。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63537,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"借书","author":"苏过","text":"妙年不可再，白日谁能系。\n空惭粱肉索，不悟齿发逝。\n季子颇亦困，还家笑奴隶。\n经年得揣摩，尚可资游说。\n良田初不耕，拱手那望岁。\n谁令困不学，斯与草木弊。\n海南寡书籍，蠹简仅编缀。\n诗亡不见雅，易绝空馀系。\n借书如假田，主以岁月计。\n常恐遗地力，敢有不敛穧。\n便便五经腹，三冬良可继。\n傥磭愧寸阴，得无讥没世。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63538,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠知命刘居士卜居","author":"苏过","text":"言乘下泽车，来赴嵩高约。\n春山多雨露，咫尺负丘壑。\n眷余实畸人，雅兴世缘薄。\n问途忽我顾，扣户烦剥啄。\n君才少不羁，屡散千金櫜。\n胸中横诗书，帐下馀猿鹤。\n何妨门如市，心若虚舟泊。\n聊师季主卜，玩世甘寂寞。\n箕山宛在目，颍水清带郭。\n何年定卜居，伴我采薇藿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63539,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵答徐翼之画木石 其一","author":"苏过","text":"轩裳定浮云，于人竟何得。\n不如饱诗书，颇似勤播植。\n丰凶纵有时，穮蓑无倦色。\n会须酬高廪，何用遽枉尺。\n我观徐夫子，六艺自警饬。\n肯回少年驾，闭户志匪石。\n弹冠岂不好，恐遂林泉隔。\n一朝堕世网，顿判云间翮。\n曲高和自寡，得丧相什伯。\n愿子保岁寒，功名当远索。\n俯首簿书间，聊将逃遣谪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63540,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵答徐翼之画木石 其二","author":"苏过","text":"士贵贫时交，菽水清而真。\n我尔两相从，良是茅茨邻。\n太息屡书空，气横戈戟新。\n跰跚定笑我，曳踵随车轮。\n壮志早摧折，羁缧易伤神。\n放怀笔砚间，聊欲出怪珍。\n老木卧千岁，不才得终身。\n持此寿君子，勿愁脱粟贫。\n相将老潩水，烟雨共垂纶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63541,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]