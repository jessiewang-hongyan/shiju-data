[{"title":"掩扉","author":"陆游","text":"久卧空山独掩扉，迂疏不恨世相违。\n新霜巷陌鸟乌乐，小雨园畦菘芥肥。\n骥病极知当伏枥，鸥闲谁与共忘机。\n一编蠹简从吾好，又见西窗挂夕晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10072,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚出偏门","author":"陆游","text":"一段新愁带宿酲，半攲乌帽策驴行。\n村墟香动梅初破，裘褐寒轻雪未成。\n渡口人争红日晚，沙边雁带碧烟横。\n悠然又觅长堤路，肠断城楼画角声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10073,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚归","author":"陆游","text":"暑雨初晴日，江皋欲莫天。\n鸦栖沙际树，人唤渡头船。\n病骨羸将折，昏眸困欲眠。\n市桥灯火闹，且复喜丰年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10074,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚归","author":"陆游","text":"无事经秋别镜湖，诗囊随处累奚奴。\n楼头寒日低将尽，陌上残泥踏欲无。\n轩冕岂容关喜愠，箪瓢亦未费枝梧。\n画桥绿浦归来晚，一盏昏灯得自娱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10075,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚归舟中作","author":"陆游","text":"路入芙蕖浦，家依䆉稏村。\n急滩双鹭立，平野万鸦翻。\n市散人争渡，僧归寺掩门。\n凄凉诵新句，招得欲残魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10076,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚兴","author":"陆游","text":"并檐幽鸟语璁珑，一榻萧然四面风。\n客散茶甘留舌本，睡馀书味在胸中。\n浮云变态吾何与，腐骨成尘论自公。\n剩欲与君谈此事，少须明月出溪东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10077,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚兴","author":"陆游","text":"壮游车辙遍天涯，晚落农桑不自知。\n许国虽坚身遽老，读书未倦眼先衰。\n云深岭路樵归晚，雨细江亭渡发迟。\n一事犹堪慰孤寂，锦囊倾倒有新诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10078,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚兴","author":"陆游","text":"白布裙襦退士装，短篱幽径独相羊。\n莎根蟋蟀催秋候，稗穗蜻蜓立晚凉。\n屈子所悲人尽醉，郦生常谓我非狂。\n知心赖有青天在，又炷中庭一夕香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10079,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚兴","author":"陆游","text":"羸病时时剧，欢悰日日疏。\n睡凭书绍介，愁赖酒驱除。\n小蹇追凉处，轻衫出浴初。\n无人堪晤语，且复狎樵渔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10080,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚兴","author":"陆游","text":"老病愁趋画戟门，天教高卧浣花村。\n山林独往杂屠钓，世界皆空谁怨恩。\n千卷蠹书忘岁月，一尊浊酒信乾坤。\n兴来倚杖清江上，断角疏钟正敛昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10081,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚兴二首 其二","author":"陆游","text":"身如病鹤谢樊笼，白尽衰髯脸尚红。\n蒲苇陂塘新涨后，梧楸门巷夕阳中。\n遗名要耐千年看，快饮方誇百榼空。\n造物闵怜君会否，放教折臂老新丰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10082,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚兴","author":"陆游","text":"地荒蓬藋与人齐，局促何曾厌屋低。\n村市船归闻犬吠，寺楼钟暝送鸦栖。\n山童新斫朱藤杖，伧婢能腌白苣齑。\n政欲出门寻酒伴，霏霏小雨又成泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10083,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚自北港泛舟还家","author":"陆游","text":"舒啸蓬笼底，经行略彴西。\n水深鹅唼草，雨细犊掀泥。\n醉倚乾坤大，闲知物我齐。\n衡门触冠过，聊得赋幽栖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10084,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚自白鹿泉上归","author":"陆游","text":"坐穴藜床愧未能，酌泉聊喜曳枯藤。\n诗从病后功殊少，酒到愁边量自增。\n事业何由垂竹帛，笑谈空觉负交朋。\n兴阑却逐栖鸦返，寂寞西窗已上灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10085,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚至新塘","author":"陆游","text":"青鞋随意出柴荆，聊向南塘曳杖行。\n归鸟已从烟际没，断虹犹在柳梢明。\n城头层塔凌空立，浦口孤舟并岸横。\n向道有诗浑不信，为君拥鼻作吴声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10086,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚行舍北","author":"陆游","text":"逆旅将归客，扶衰取次行。\n霜浓木叶尽，水落岸痕生。\n凫雁浮寒浦，牛羊满晚晴。\n东村隔烟寺，杳杳送钟声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10087,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚行舍后","author":"陆游","text":"略彴东边一径深，杖藜行饭当登临。\n稷山并海出遥碧，禹穴生云成暮阴。\n残岁自兴游子感，少年谁解老人心。\n归来灯火参差夜，倦倚胡床续短吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10088,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚行湖上","author":"陆游","text":"饱来扪腹绕村嬉，北陌东阡信所之。\n女手采馀桑郁郁，烟芜生遍冢累累。\n高林日暮无莺语，深巷人归有犬随。\n东走郡城逾十里，好风劳送角声悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10089,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚过邻曲","author":"陆游","text":"阳狂跌宕送年华，信步来寻野老家。\n浅濑水清逢立鹭，横林叶尽数栖鸦。\n书生一饱依耕耒，壮士孤愁入戍笳。\n王绩但思酣美酝，葛洪不复问丹砂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10090,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚过招贤渡","author":"陆游","text":"老马骨巉然，虺尵不受鞭。\n行人争晚渡，归鸟破秋烟。\n湖海凄凉地，风霜摇落天。\n吾生半行路，搔首送流年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10091,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚过保福","author":"陆游","text":"堂静僧闲普请疏，炉红毡暖放参馀。\n莲花池上容投社，椰子身中悔著书。\n茶试赵坡如泼乳，芋来犀浦可专车。\n放翁一饱真无事，拟伴园头日把锄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10092,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚步","author":"陆游","text":"晚步清溪上，微阴忽快晴。\n鸦栖先小泊，鱼暖已群行。\n药饵扶垂老，耕桑乐太平。\n非关恋乡社，久客倦遐征。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10093,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚步门外书触目","author":"陆游","text":"数椽茆屋镜湖旁，乔木苍烟一径长。\n酒贱过门多醉叟，天寒栖亩有馀粮。\n歌呼草市知人乐，箫鼓丛祠喜岁穰。\n只道老来诗思尽，未妨击壤颂时康。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10094,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚步门外散怀二首 其二","author":"陆游","text":"万化纷纷本一机，不为腐骨欲安归。\n彭殇共尽孰修短，尧桀两忘无是非。\n濡首极知当痛饮，剪翎那复许群飞。\n江郊未解春寒恶，高柳吹花又满衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10095,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚步门外散怀二首 其一","author":"陆游","text":"大千沙界一浮沤，成坏元知不自由。\n寓迹个中谁耐久，问君底事不归休。\n春陂欲雨黄鸦闹，晚渡无人白犊浮。\n七十之年何啻足，戏凭药物小迟留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10096,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚步江上","author":"陆游","text":"万里桥边带夕阳，隔江渔市似清湘。\n山林独往吾何恨，车马交流渠自忙。\n高柳阴中扶拄杖，平沙稳处据胡床。\n故人京国无消息，安得相携共此凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10097,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚步至湖上","author":"陆游","text":"柴车无与驾，篷艇亦须人。\n赖有拄杖子，能扶羸病身。\n云山翠屏合，烟月玉钩新。\n萧散湖塘路，微风吹葛巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10098,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚步舍东","author":"陆游","text":"遇兴穿丛竹，寻香折野梅。\n暮天寒欲雪，幽径绿生苔。\n栖雀争枝噪，归牛并堑来。\n高城角声动，不尽古今哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10099,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚步舍北归","author":"陆游","text":"昨日海棠开，今朝燕子来。\n偶行沙际去，却傍柳阴回。\n酒是治愁药，书为引睡媒。\n吾生不乏此，外物信悠哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10100,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚步湖上","author":"陆游","text":"云薄漏春晖，湖空弄夕霏。\n沾泥花半落，掠水燕交飞。\n小倦聊扶策，新晴旋减衣。\n幽寻殊未已，画角唤人归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10101,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚步湖堤","author":"陆游","text":"絁裘桐帽野人装，又上湖堤步夕阳。\n贫甚不为明日计，兴来犹作少年狂。\n残樽倒酒无馀沥，幽圃寻梅认暗香。\n时有行人叹顽健，黑丝点破颔间霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10102,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚步湖堤归偶作","author":"陆游","text":"酒尽知难折简呼，出门仍苦要人扶。\n残梅委地香谁惜，归雁穿云远欲无。\n日落牛羊犹被野，农闲畚锸正开湖。\n还家寂寞西窗晚，旋燎枯枝拥地炉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10103,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚步湖塘少休民家","author":"陆游","text":"瓜蔓缘篱竹，芦芽刺岸沙。\n横陂浮雁鹜，古道暗桑麻。\n适遇扶犁叟，同休织屦家。\n村童亦可念，唤客手吒叉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10104,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚饭后步至门外并溪而归","author":"陆游","text":"徐行摩腹出荆扉，掠面风尖酒力微。\n市步空船迎荻去，湖堤轻担卖鱼归。\n潺潺沙窦鸣残水，莽莽平芜衬落晖。\n商略最关诗思处，满村砧杵捣秋衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10105,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚饭罢小立门外有作","author":"陆游","text":"此心何敢慕轻肥，尚愧无功饱蕨薇。\n浦面鸟冲残霭去，柳阴人荷一锄归。\n病嗟短发纷纷白，老觉初心种种非。\n百步空庭著明月，黄昏手自掩荆扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10106,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚到东园","author":"陆游","text":"岸帻寻青士，凭轩待素娥。\n官身苦日短，荒圃得秋多。\n醉眼轻浮世，羁怀激浩歌。\n功名从蹭蹬，诗酒且婆娑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10107,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚泊","author":"陆游","text":"楼上呜呜角，桥边点点灯。\n聚沙新到雁，趁渡独归僧。\n日隐山光暗，天低海气蒸。\n居人笑老子，醉发乱鬅鬙）。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10108,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚泊","author":"陆游","text":"半世无归似转蓬，今年作梦到巴东。\n身游万死一生地，路入千峰百嶂中。\n邻舫有时来乞火，丛祠无处不祈风。\n晚潮又泊淮南岸，落日啼鸦戍堞空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10109,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚泊松滋渡口二首 其二","author":"陆游","text":"小滩拍拍鸬鹚飞，深竹萧萧杜宇悲。\n看镜不堪衰病后，系船最好夕阳时。\n生涯落魄惟耽酒，客路苍茫自咏诗。\n莫问长安在何许，乱山孤店是松滋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10110,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚泊松滋渡口二首 其一","author":"陆游","text":"此行何处不艰难，寸寸强弓且旋弯。\n县近欢欣初得菜，江回徙倚忽逢山。\n系船日落松滋渡，跋马云埋滟滪关。\n未满百年均是客，不须数日待东还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10111,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚泊慈姥矶下二首 其二","author":"陆游","text":"慈姥矶头月，纤纤照酒杯。\n素秋风露重，久客鬓毛催。\n宿鸟惊还定，飞萤阖复开。\n平生四方志，老去转悠哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10112,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚泊慈姥矶下二首 其一","author":"陆游","text":"山断峭崖立，江空翠霭生。\n漫多来往客，不尽古今情。\n月碎知流急，风高觉笛清。\n儿曹笑老子，不睡待潮平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10113,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚雨","author":"陆游","text":"万里双芒屩，终年一布裘。\n病侵消壮志，醉著失闲愁。\n琴料凭僧问，巢居与鹤谋。\n晚来疏雨过，探借北窗秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10114,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚雨","author":"曾几","text":"萧瑟度横塘，霏微映缭墙。\n压低尘不动，洒急土生香。\n声入楸梧碎，清分枕簟凉。\n回头忽陈迹，檐角挂斜阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10115,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚春二首 其二","author":"陆游","text":"莫笑花前醉堕巾，放翁又看一年春。\n寻巢燕熟频穿户，酿蜜蜂喧不避人。\n楚庙羔豚初散社，稽山笋蕨正尝新。\n要知不负年光处，南陌东阡自在身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10116,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚春二首 其一","author":"陆游","text":"世事纷纷不足论，流年去似海涛翻。\n莫因齿发悲残景，且喜柴荆是故园。\n千里桑麻无旷土，数家鸡犬自成村。\n邻翁过我誇秧信，雨后春泥一尺浑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10117,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚春感事四首 其二","author":"陆游","text":"和风薄霭过清明，减尽重裘觉体轻。\n正午轩窗无树影，乍晴阡陌有莺声。\n酿成西蜀鹅雏酒，煮就东坡玉糁羹。\n扪腹翛然出门去，春郊何处不堪行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10118,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚春感事四首 其一","author":"陆游","text":"风恶房栊燕子归，雨多山路蕨芽肥。\n青餈旋捣作寒食，白葛预裁充暑衣。\n稚子日长供课早，故人官达寄书稀。\n幽居自喜浑无事，又向湖阴坐钓矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10119,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚春感事四首 其三","author":"陆游","text":"徙倚阑干送落晖，年华冉冉恨依依。\n护雏燕子常更出，著雨杨花又懒飞。\n已为读书悲眼力，还因揽带叹腰围。\n亲朋半作荒郊冢，欲话初心泪满衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10120,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚秋风雨","author":"陆游","text":"尽道渔村陋，秋来物色奇。\n寒生沽酒兴，雨及种花时。\n狂舞欲谁属，清吟空自知。\n茫茫宇宙内，吾道竟何之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10121,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚秋出门戏作二首 其一","author":"陆游","text":"病叟徜徉古泽边，横林摇落暮秋天。\n鸣鸠雨后却呼妇，飞雀霜前先著绵。\n抱被每投僧榻宿，卷书时当酒家钱。\n秋风想像芝房熟，北望商山一怅然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10122,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚秋出门戏作二首 其二","author":"陆游","text":"闲愁那到野人边，万事元知合付天。\n尽醉仅能三龠酒，新寒未办一铢绵。\n邻僧每欲分斋钵，庙史犹来索社钱。\n无地置锥真细事，不妨胸次日超然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10123,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚秋野兴二首 其二","author":"陆游","text":"彻底无能彻骨贫，自怜虚作六朝民。\n学因病废捐长日，志与年衰愧古人。\n露湿乱萤飞暗庑，霜清饥雀噪空囷。\n一生眼境常如此，草赋凭谁问大钧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10124,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚秋野兴二首 其一","author":"陆游","text":"病骨支离不耐秋，今年九月即轻裘。\n细书灯下幸能读，旧友梦中时与游。\n官赋毕输无吠犬，农功已息有闲牛。\n不知冠盖朝天客，也得心安似我不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10125,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚凉述怀","author":"陆游","text":"末学常忧堕吝骄，晚知鹏鴳本逍遥。\n屏医却药疾良已，破械空囹盗自消。\n父子终身美藜藿，交游太半是渔樵。\n衡门日落清风起，又著藤冠度野桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10126,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚起","author":"陆游","text":"新晴窗日弄春妍，幌小屏深意自便。\n长恨病多妨痛饮，却缘客少得安眠。\n雏莺故故啼檐角，飞絮翩翩堕枕前。\n欲著衣裳还懒起，重寻残梦一悠然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10127,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚起二首 其二","author":"陆游","text":"学道逍遥心太平，幽窗鼻息撼床声。\n柳花无蒂蛮毡暖，龟甲有纹缯帐明。\n候起儿童陈盥栉，笑衰人客闯柴荆。\n此生睡足无馀念，安用元戎报五更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10128,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚起二首 其一","author":"陆游","text":"卖剑捐书绝世缘，掩关高枕送流年。\n久从道士学踵息，谁管门生嘲腹便。\n化蝶飞时嗟昨梦，睡蛇去后喜安眠。\n欠伸看起东窗日，也似金銮过八砖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10129,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚眺","author":"陆游","text":"秋晚闲愁抵酒浓，试寻高处倚枯筇。\n云归时带雨数点，木落又添山一峰。\n鸣雁沙边惊客橹，行僧烟际认楼钟。\n个中诗思来无尽，十手传抄畏不供。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10130,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚寒自东村步归","author":"陆游","text":"夕阳下平野，落叶满荒街。\n村店卖荞面，人家烧豆䕸。\n溪风透布褐，草露湿芒鞋。\n骨相元如此，何由与世谐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10131,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚晴","author":"陆游","text":"水声㶁㶁赴回塘，帘影疏疏绕四廊。\n静院数杯倾白堕，幽窗一枕梦清湘。\n润侵书笥深防蠹，暖彻衣篝剩得香。\n解组径归应更乐，偷闲犹足傲羲皇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10132,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚晴","author":"陆游","text":"雨馀残日入疏篱，变化相乘乃尔奇。\n千嶂暮云收尽后，一年秋暑洗空时。\n如山酒券不相贷，隔巷衣砧如许悲。\n剩欲出门纾滞思，交亲零落与谁期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10133,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚晴书事呈同舍","author":"陆游","text":"鱼复城边夕照红，物华偏解恼衰翁。\n巴莺有恨啼芳树，野水无情入故宫。\n许国渐疏悲壮志，读书多忘愧新功。\n因君共语增惆怅，京洛交游欲半空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10134,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚晴出行近村闲咏景物","author":"陆游","text":"雪云吹尽木阴移，正是先生曳杖时。\n老㹀行将新长犊，空桑卧出寄生枝。\n医翁暮过囊探药，筮叟晨占手布蓍。\n谁谓人间足忧患，未妨古俗自熙熙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10135,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚晴至索笑亭","author":"陆游","text":"中年苦肺热，剩喜见新霜。\n登览江山美，经行草树荒。\n堂空响棋子，盏小聚茶香。\n兴尽扶藜去，斜阳满画廊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10136,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚晴闲步邻曲间有赋","author":"陆游","text":"汤沐身轻念出游，近春原野霁烟浮。\n楼阴雪在玉三寸，云罅月生银一钩。\n穷巷客稀常足睡，暮年诗退不禁愁。\n乡邻无事冬耕罢，独倚篱门数过牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10137,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]