f1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"园中二首 其二","author":"晁公溯","text":"眇眇周垣总路平，森森夏木已阴成。\n却疑身在华轩上，翠幄中间曳杖行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54719,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"园中二首 其一","author":"晁公溯","text":"南北东西极目天，看天不比下牢关。\n遥知前面山尤远，直到飞鸦灭没间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54720,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"近承琮上人问讯甚勤老懒不能作书以偈答之 其三","author":"晁公溯","text":"十年不到吴溪上，闻道禅龛更斩新。\n得见山中此松老，后来谁是住庵人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54721,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"近承琮上人问讯甚勤老懒不能作书以偈答之 其二","author":"晁公溯","text":"世界犹如露电身，更于空里聚微尘。\n何时麦积崖边路，说法重来要度人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54722,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"近承琮上人问讯甚勤老懒不能作书以偈答之 其一","author":"晁公溯","text":"食时持钵乞诸邻，不用毗耶遣化身。\n想见堂中惭此老，法轮未转转饥轮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54723,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"咏铜瓶中梅","author":"晁公溯","text":"折得寒香日暮归，铜瓶添水养横枝。\n书窗一夜月初满，却似小溪清浅时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54724,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨中观庭下梅二首 其二","author":"晁公溯","text":"春近梅梢著意红，留花不发待东风。\n篱边一树最佳处，半在冥濛烟雨中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54725,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨中观庭下梅二首 其一","author":"晁公溯","text":"霏霏冻雨细无声，解洗梅花花上尘。\n似与横枝借颜色，故应添我一分春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54726,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨中登披风榭望东山","author":"晁公溯","text":"冈岭逶迤草木低，东山好处我能知。\n色浓意远真堪画，须在冥濛奄霭时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54727,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]