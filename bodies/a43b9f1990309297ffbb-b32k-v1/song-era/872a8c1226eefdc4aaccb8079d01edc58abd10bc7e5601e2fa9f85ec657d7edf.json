[{"title":"初闻雷声","author":"高翥","text":"二月寒犹在，春云湿未开。\n洒窗终夜雨，发轫数声雷。\n荠麦绿生脑，棠梨红拆腮。\n西湖花事动，从此日裴回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63675,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀安王宰索得助诗奉题一首","author":"高翥","text":"亭在唐贤好句中，阑干六曲尽春风。\n不知脚下是官府，但见面前如渚宫。\n江水逢潮音激切，山云因雨思溟濛。\n主人雅兴居诗外，花影琴声事事工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63676,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"投老","author":"高翥","text":"投老才营一把茅，前临官路后林坳。\n最宜鸡犬无邻舍，好放牛羊有近郊。\n春韭采来胜市食，秋鲈留取续山肴。\n吾庐谁道难寻觅，古树排门尽鹊巢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63677,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"李将","author":"高翥","text":"自小在行伍，得官因用兵。\n筹边头发竖，入阵骨毛轻。\n战马惜如命，宝刀都有名。\n酒酣常骂坐，嫌客话升平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63678,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杨花","author":"高翥","text":"万缕千丝拂水滨，尽催飞絮送残春。\n风前轻薄佳人命，天外飘零宕子身。\n绕路铺时成素毯，就泥沾处衬芳尘。\n江头雨过遗踪尽，留得柔条折赠人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63679,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"灵岩寺","author":"高翥","text":"天柱峰高逼太清，灵岩端足擅高名。\n人间有石皆奴仆，天下无山可弟兄。\n樵径雪深多虎迹，清溪风暖尽猿声。\n客身元是山林种，见此如何不动情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63680,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜过马当山","author":"高翥","text":"独载诗书趁野航，自怜漂泊度时光。\n残年准拟登牛首，连夜匆忙过马当。\n古庙荒寒江浸影，断崖凄惨石凝霜。\n壮怀未分甘衰老，回首长淮恨更长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63681,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜过西兴","author":"高翥","text":"宵济向西兴，钟声隔岸听。\n浅滩淘落月，远树纳残星。\n客路悠悠去，征桡在在停。\n明朝故山近，不必问邮亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63682,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"昌国县普济寺小亭","author":"高翥","text":"鲸海中流地，龙峰小洞天。\n亭高先得月，树老久忘年。\n大士居邻境，闲僧指便船。\n若为风浪息，更结补陀缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63683,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"松溪庙","author":"高翥","text":"庙自何年立，门深昼不扃。\n寒藤扶坏壁，秋草带疏棂。\n溪接东西碧，山分远近青。\n老巫逢客至，谩说有神灵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63684,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"育王寺","author":"高翥","text":"精蓝游历地，景物自情亲。\n鹤引登山客，僧迎礼塔人。\n名花千佛供，乔木万夫身。\n碑刻东坡作，重来为拂尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63685,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舍侄来","author":"高翥","text":"自从清晓至黄昏，閒坐閒眠深闭门。\n犹子雨中来息担，老夫镫下起开樽。\n故山坟墓何人守，旧宅园亭几处存。\n问答恍然如隔世，若非沈醉定消魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63686,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"虎丘寺","author":"高翥","text":"西出吴门步屧轻，浮屠唤客入山行。\n石从试剑何年裂，池自通泉尽日平。\n烟径远传僧磬响，云龛深锁佛灯明。\n移舟更宿枫桥寺，要听疏钟半夜鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63687,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"采石","author":"高翥","text":"采石兴亡地，声名宇宙齐。\n山眉间吴楚，江口折东西。\n今古多遗恨，英雄几噬脐。\n征尘何日尽，北望转悲悽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63688,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"客枕","author":"高翥","text":"客枕眠僧舍，巍然鹤发翁。\n事如前日异，心与少年同。\n一夜送春雨，五更临晓风。\n梦回思往事，愁在不言中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63689,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"度仙霞岭","author":"高翥","text":"尽日度仙霞，西风吹鬓华。\n乍寒抛白苧，临晚见黄花。\n山险全无路，溪晴半是沙。\n岭头逢宿处，斜月带栖鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63690,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"拜林和靖墓","author":"高翥","text":"玉函香骨老云根，占断孤山水月村。\n荐菊泉清涵竹影，种梅地冷带苔痕。\n生前已自全名节，身后从谁问子孙。\n惟是年年寒食日，游人来与酹清尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63691,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日即事","author":"高翥","text":"人间闲日月，春后乍晴阴。\n半夜雨声急，一溪流水深。\n鸟啼花自发，诗就客能吟。\n短策西湖路，幽芳信意寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63692,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日湖上","author":"高翥","text":"清波门外放船时，尽日轻寒恋客衣。\n花下笑声人共语，柳边樯影燕初飞。\n晓风不定棠梨瘦，夜雨相连荠麦肥。\n最忆故山春更好，夜来先遣梦魂归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63693,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日湖上","author":"高翥","text":"乘兴行新路，凝情独老翁。\n马蹄春草上，人影夕阳中。\n飞絮沿湖白，残花染浪红。\n晚归云气合，双桨破空濛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63694,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春夜","author":"高翥","text":"小窗兀兀守更残，案上诗书亦懒观。\n频剪烛花听夜雨，尽垂帘影隔春寒。\n破除梦幻从头了，安置身心向下看。\n老子静中消日月，全然不似客长安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63695,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送春","author":"高翥","text":"韶光催去太无情，祇为东君去住轻。\n虽欲迟留芳草梦，如何禁得杜鹃声。\n桐花快落春风老，梅子微酸晚雨晴。\n从此嬉游时节少，不须日日报诗成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63696,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春霁","author":"高翥","text":"积雨才收云尽归，长空一色碧琉璃。\n日移帘影临书案，风飐瓶花落研池。\n巢燕学飞犹恋母，笼鸡得食旋呼儿。\n眼看景物关情甚，喜为新晴赋此诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63697,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋日入无量院","author":"高翥","text":"僧閒甘寂寞，寺古绝纷华。\n鸟摘过墙枣，猿争守树楂。\n雨多溪没井，藤老蔓缘笆。\n莫坐庭前石，怕伤苔藓花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63698,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋兴","author":"高翥","text":"老去无心世事轻，但从景物略关情。\n晓看雁阵惊秋晚，夜听鹤声知月明。\n石鼎煮茶论水品，土墙题字记花名。\n出门更自有真乐，閒向通衢稳步行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63699,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夜","author":"高翥","text":"小屏相对两眉攒，长夜迢迢不肯残。\n鼠向镫前窥坐卧，人从梦里说悲欢。\n故山无计行秋晚，客路从谁守岁寒。\n留得浊醪相慰藉，酒肠犹喜十分宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63700,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赵仲庄都钤山居","author":"高翥","text":"一官难换北山薇，结屋栽花度四时。\n果熟不妨禽摘尽，酒香惟恐客来迟。\n小蘋低唱花间曲，阿广高吟李下诗。\n客久办心分半隐，尚嫌风骨欠仙姿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63701,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题赵忠定公雪锦楼诗","author":"戴复古","text":"九鼎重安国势牢，功名易办谤难逃。\n手扶日月扫云雾，身向江湖直羽毛。\n雪锦诗成先谶兆，金縢书启见勤劳。\n纷纷论定知忠定，不负朝廷两字褒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63702,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送刘允叔主簿归山中","author":"高翥","text":"浮利浮名挽不来，故山归去恰春回。\n马兰旋摘和菘煮，枸杞新生傍菊栽。\n庭树夜留山鸟宿，洞门早为野云开。\n明年我亦天台寺，相伴芒鞋蹋古苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63703,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重阳述怀","author":"高翥","text":"年年客里过佳期，时节难逢莫皱眉。\n酒量且为重九尽，杯行不必再三辞。\n登高兴懒诗仍赋，怀古情深泪自垂。\n纵使西风落乌帽，黄花犹恋鬓边丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63704,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重游无量院","author":"高翥","text":"佛屋攲斜老翠微，小轩犹记昔游时。\n江云带雨凉生竹，野水迎潮暗入篱。\n门外风波僧自识，山中朝莫客曾知。\n眼明素壁关情久，十载财能写此诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63705,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"凌歊台","author":"高翥","text":"宋祖高台山上头，三閒破屋蔽层丘。\n离离荒草迷行殿，漠漠寒沙拥故洲。\n塔影远招孤客恨，江声长替古人愁。\n题诗自旧知多少，清绝难磨许郢州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63706,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽陈复斋","author":"高翥","text":"忧世心劳鬓易斑，笑颦还与世相关。\n秋霜烈日君臣际，和气春风母子閒。\n学道期传千载统，献言先办一生閒。\n堂堂仰止人何在，独有名如不动山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63707,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晓出黄山寺","author":"高翥","text":"晓上篮舆出宝坊，野塘山路尽春光。\n试穿松影登平陆，已觉钟声在上方。\n草色溪流高下碧，菜花杨柳浅深黄。\n杖藜切莫匆匆去，有伴行春不要忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63708,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晓行","author":"高翥","text":"跨马登长路，闻鸡度远关。\n水光斜漾月，云影倒薶山。\n人迹霜桥外，禽声烟树间。\n自惭林下客，清梦未曾还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63709,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"破屋","author":"高翥","text":"破屋三间书五车，一翁醉发老髿髿。\n萧墙甚窄难栽竹，草地虽平不种花。\n井浅自能供日用，楼高谁怕被云遮。\n过门人问何人住，题扇桥西百姓家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63710,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"莲实","author":"高翥","text":"腻玉肌肤碧玉房，累累波面趁红芳。\n坐忘佛土三生梦，来结人间一夏凉。\n青子绽时仙掌湿，绿包分处蜜脾香。\n尊前笑摘酬风露，犹记西湖古柳傍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63711,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宿囊山寺","author":"高翥","text":"小泊囊山古化城，山林端足擅高名。\n楼台影外秋风老，钟磬声中夜气清。\n客子情怀宜淡薄，主人言语亦分明。\n只应海月堂前境，从此江湖有梦成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63712,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄方岩","author":"高翥","text":"绿发仙人山泽癯，出游入息几曾拘。\n种花甚少四时有，谏草不多千古无。\n阅世眼高磨日月，好贤名重满江湖。\n行藏到得无心处，钟鼎山林岂异涂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63713,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄王仲彝仲彝留三衢久不归省因以箴之","author":"高翥","text":"别君三见雁南飞，梦里相逢觉又非。\n书去不知何日到，人来先问几时归。\n正堪镫火亲书卷，莫遣尘埃染客衣。\n二老倚门知已久，交情于此亦依依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63714,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄林徵君","author":"高翥","text":"老无闲事上双眉，问着穷通尽不知。\n两鹤忽飞因客到，一牛方病得妻医。\n案头几卷阴功录，壁上诸家劝世诗。\n见说今年公八十，鬓边财有数茎丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63715,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"常熟县破山寺","author":"高翥","text":"古县沧浪外，精蓝缥渺间。\n木枯曾阅世，龙老解分山。\n鸟道秋迷迹，禅房昼掩关。\n诗成游子去，流水自潺潺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63716,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清明日对酒","author":"高翥","text":"南北山头多墓田，清明祭扫各纷然。\n纸灰飞作白胡蝶，泪血染成红杜鹃。\n日落狐狸眠冢上，夜归儿女笑镫前。\n人生有酒须当醉，一滴何曾到九泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63717,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清明日延平道上","author":"高翥","text":"自从闽峤至延平，试问归涂第几程。\n人向烟岚深处出，鸟依云树密边鸣。\n润沾破屐春泥滑，寒入征衫晓雨晴。\n多谢山家插杨柳，报侬今日是清明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63718,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清明日约宋正甫黄行之兄弟为东湖之集","author":"高翥","text":"自在嬉游遍四方，不曾孤负独春光。\n醉眠芳草衣裳冷，笑嚼名花齿颊香。\n既是烟霞令久任，岂应风月断来章。\n故人尚有閒情不，相伴湖边举一觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63719,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清明日招社友","author":"高翥","text":"面皮如铁鬓如丝，依旧粗豪似向时。\n嗜酒更拚三日醉，看花因费一春诗。\n生前富贵谁能必，身后声名我不知。\n且趁酴醾对醽醁，共来相与一伸眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63720,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"船户","author":"高翥","text":"尽将家具载轻舟，来往长江春复秋。\n三世儿孙居柁尾，四方知识会沙头。\n老翁晓起占风信，少妇晨妆照水流。\n自笑此生漂泊甚，爱渠生理付浮悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63721,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"隆兴借东湖驿度夏杂题","author":"高翥","text":"西风来几日，荷柳早衰容。\n百感闻秋笛，孤吟答晚钟。\n事能如意少，酒不教愁浓。\n忆著莼鲈美，家山隔几重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63722,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪堂","author":"高翥","text":"胜地从来迹易陈，东坡日月久尤新。\n小桥曾压归时雪，老柳长摇别后春。\n城郭寥寥怀独鹤，江山历历见斯人。\n客生较晚空惆怅，梦想陈潘结旧邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63723,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"黄居士山房","author":"高翥","text":"浮利浮名心已灰，三间茅屋白云堆。\n先生自酿松精酒，侍女能持藤瘿杯。\n养鹿晓随原草去，放猿时摘野花来。\n近闻身口浑无累，槲叶黄菁绕宅栽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63724,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜杜仲高移居清湖","author":"高翥","text":"笑携鸡犬入城居，无复游从叹阔疏。\n河水通船堪载酒，桐阴近屋可脩书。\n饭香休忆辛田米，羹美何惭丙穴鱼。\n我亦买山湖上住，效芹时拟贡园蔬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63725,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"富阳县秋日","author":"高翥","text":"古井梧桐老，平田䆉稏收。\n鸡豚百里社，砧杵十分秋。\n乾鹊催归兴，寒蝉唤客愁。\n衔杯忆霜蟹，沙尾暮停舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63726,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渡钱塘","author":"高翥","text":"小立晴江上，潮生落照边。\n晚花低映水，春草暗迷烟。\n燕子飞官驿，鸥群引客船。\n关情南浦别，相对独依然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63727,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"焦山","author":"高翥","text":"山拥中流翠作堆，四围竹树郁崔嵬。\n殿前云向檐牙出，门外潮从海口来。\n乞食僧归斋鼓动，打碑人去渡船开。\n焦公羽化将名迹，付与瞿昙亦壮哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63728,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登九华楼","author":"高翥","text":"高阁临江可契心，兴来时得一登临。\n山云浦树重重合，野水汀蒲日日深。\n鸦背夕阳供晚哺，蝉迎凉吹试秋吟。\n倚阑尽见诸峰出，如对风流李翰林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63729,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赏心亭","author":"高翥","text":"江亭如倚钓鱼矶，面面云檐势欲飞。\n西望汀洲依白鹭，东连巷陌接乌衣。\n六朝更代人何在，千古兴亡事总非。\n客子独怜风景好，倚阑长是欲忘归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63730,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"感怀二首 其二","author":"高翥","text":"行遍千山复万山，不应蜀道若为难。\n数茎发向殊方白，一寸心从故国丹。\n弓软臂无三斗力，杯深量欠十分宽。\n粗豪到了非吾事，只盍家居度岁寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63731,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"感怀二首 其一","author":"高翥","text":"漂泊南州又过年，恰如杜子客鄜川。\n酒堪度日难为醉，诗怕伤时未可传。\n店舍无烟兵火后，街坊有月试灯前。\n荒凉古驿闻吹笛，老泪纵横落枕边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63732,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"感春","author":"高翥","text":"人事日纷纷，不知春已分。\n问梅成绿叶，看杏落红云。\n燕向晴空语，蛙从夜静闻。\n感时伤老大，孤坐对炉熏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63733,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蛾眉亭","author":"高翥","text":"千尺悬崖巨浪撞，危亭高峙对微茫。\n远峰凝黛双蛾澹，流水连云一带长。\n日落江容难可尽，天寒山色不成妆。\n停舟欲试登临眼，北望青烟欲断肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63734,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"静对","author":"高翥","text":"静对炉烟一缕霞，谢天成就澹生涯。\n安排瓦砚临章草，收拾瓷瓶插郑花。\n莫问家储无担石，休嫌人事似团沙。\n三杯竟醉醒时晚，卧看春云送日斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63735,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"毅斋郑秘书道山领客","author":"高翥","text":"群玉堂前春昼阴，主人领客步清深。\n上方图画无真赝，东壁诗书有古今。\n手转玉玑看测日，指挥金井试为霖。\n山翁不作蓬莱梦，但愿时来洗此心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63736,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"潜夫约中途遣诗相送至江山无耗寄诗督之","author":"高翥","text":"望诗十步九回头，目断江山望未休。\n所幸临行曾举似，仅能记忆可遮羞。\n碧云漏日村村雨，红树吟风叶叶秋。\n不见夜光生歇处，客身却恨欠迟留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63737,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蕺山戒珠寺寺王右军故居也","author":"高翥","text":"叶叶东风吹客衣，昌安寺里晚游时。\n攲斜竹屋羲之宅，磨灭经幢率府碑。\n佛化是谁留实相，鹅亡犹自见方池。\n逢僧小作煎茶供，略问源流笑不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63738,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蕺山登高","author":"高翥","text":"醉眼横斜看菊枝，又成客里过佳期。\n去年行路犹持酒，今日登高懒赋诗。\n老泪怕从衣袖见，闲情但有帽檐知。\n阿髯故国才归得，岁岁须来举一卮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63739,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题信天巢集","author":"高翥","text":"信天巢小仅容身，中有图书障俗尘。\n不与世争闲意气，且随时养老精神。\n破铛安稳齐钟鼎，短褐参差比缙绅。\n渴饮三杯饥二饭，主人日用未为贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63740,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]