[{"title":"闻仙都李道士下世 其三","author":"吕南公","text":"九月霪霖谷欲登，稻芽连穗水漫塍。\n无方解我心愁寂，更欲闻师近寝兴。\n纸尾忽传成异物，棺中还恐已飞升。\n羲和睡熟泥涂恶，絮酒寻浇叹未能。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54465,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄江州沈尊师","author":"吕南公","text":"洞天一别七春风，长梦桃花烂漫红。\n不得云雷相借助，且因文学守贫穷。\n曾寻物外无穷意，已觉人间万事空。\n便作野夫才是分，祇嗟凡骨误仙翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54466,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"橘林居士题载溪馆壁","author":"吕南公","text":"云冻月笼影，风生水涩寒。\n故人真似雪，何必到门阑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54467,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄茶李侍禁","author":"吕南公","text":"东塞将军日月閒，五兵不试坐云间。\n却因睡思侵书卷，送与茶瓯解壮颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54468,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过虎林渡","author":"吕南公","text":"淮南行尽到江南，野渡风高送晚帆。\n五五长亭莫回首，向来穷泪已盈衫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54469,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戏题白鹤观","author":"吕南公","text":"八月风高宇宙清，银河秋浪到天声。\n门前合有仙槎过，会待参随上玉京。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54470,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戏题妙灵观怪松","author":"吕南公","text":"二十年前看怒龙，鳞鬐半已召雷风。\n至今未拂层霄去，可是怀文与我同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54471,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晓雨","author":"吕南公","text":"晓雨彭彭发旧泥，田家拆壁备朝炊。\n无数星辰一轮月，夜来空似欲晴时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54472,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重过福兴院 其一","author":"吕南公","text":"重过山寺借床眠，屈指前游已七年。\n文字转工身转困，被僧相问却悽然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54473,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重过福兴院 其二","author":"吕南公","text":"乞钱谋食总悠悠，两事平生话亦羞。\n何意茂林脩竹下，今年还得一回游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54474,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和道先雨中栽花 其一","author":"吕南公","text":"二月前头雨意回，移花趁雨破青苔。\n芳根得地春工敏，定有新英次第开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54475,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和道先雨中栽花 其二","author":"吕南公","text":"旋封旋筑带霏微，赢得浇瓶不用携。\n众草自今常避地，主人来绕渐成蹊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54476,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题药录","author":"吕南公","text":"华佗气绝钓台侧，扁鹊坟荒浚水边。\n末俗好财无妙智，此书何日似鱼筌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54477,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"茶铛","author":"吕南公","text":"宾榻萧萧午户开，松枝火尽半寒灰。\n主人欲就游仙梦，休愿煎茶醒睡来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54478,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"风雨","author":"吕南公","text":"风雨萧萧夜漏沈，北窗灯影见伤心。\n从今莫更言沧海，只合思量此恨深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54479,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"有见","author":"吕南公","text":"卖药诸生体调狂，尘埃空助老来忙。\n壶中自少閒天地，岂是今无费长房。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54480,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晓日","author":"吕南公","text":"晓日曈曈上纸窗，小炉文火近缣缃。\n冲愁满盏扶头酒，笑杀医师第一方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54481,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏白发 其一","author":"吕南公","text":"人言华发是愁功，不分悲伤得老翁。\n亦有不愁头自白，可怜功过略相同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54482,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏白发 其二","author":"吕南公","text":"已任萧衰潜似雪，何须轻脱便随梳。\n不及穷愁索长远，一生相逐未相疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54483,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偶成","author":"吕南公","text":"苒苒新青上草头，小庭春色强悠悠。\n酒瓶虚卧琴弦暗，眼见风光似九秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54484,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新室","author":"吕南公","text":"为奸只是疑王涉，至死何曾识杜吴。\n四体早知成散漫，前年悔更染閒须。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54485,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"魏勃","author":"吕南公","text":"虽发齐兵未不臣，问时何用便销魂。\n一生才勇都纤小，可怪区区扫相门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54486,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"祢衡","author":"吕南公","text":"世乱无人及祢衡，眼看豺虎似蚊蝇。\n乔玄荀彧皆儒雅，至死何曾晓爱憎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54487,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"覆船山","author":"吕南公","text":"山似舟航压众坡，静为平地动为波。\n桅樯不藉瞻乌首，争奈风帆百尺何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54488,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过武陵翁题其屋壁 其一","author":"吕南公","text":"十年骑马走红尘，非敢求为富贵人。\n只愿似他龚处士，不馀不欠一閒身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54489,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过武陵翁题其屋壁 其二","author":"吕南公","text":"绿竹林边白发翁，面颜犹似壮时红。\n朝来卖药钱多少，又闪閒愁入醉中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54490,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"废井","author":"吕南公","text":"清不能常浊有馀，辘轳音绝甃苔枯。\n荒凉欲就群蛙问，今有观天坐客无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54491,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"见广度院紫荆一株先开","author":"吕南公","text":"满树新英待发时，东风先动向阳枝。\n同根若是生疑怪，为道开迟谢亦迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54492,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"兰溪驿","author":"吕南公","text":"驿亭何处近兰溪，行尽莲华日暮时。\n春雨发香无分见，断肠频诵杜郎诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54493,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"恶客","author":"吕南公","text":"恶客无端舍旧山，坐令千虑险相关。\n青灯白日贫兼病，听著农桑更厚颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54494,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"野客","author":"吕南公","text":"野客来过洞府门，天风吹断去时魂。\n得归应被乡人笑，衣上云霞有异痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54495,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酒客","author":"吕南公","text":"酒客胸襟亦自贤，平生不断醉因缘。\n望见青帘涎已活，谁能顾惜杖头钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54496,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜拟李义山四更四点","author":"吕南公","text":"四更四点露成霜，个里愁人暗断肠。\n鼓角未喧闻鼻鼾，北风窗户月荒凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54497,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"反李义山人欲篇","author":"吕南公","text":"药囊易中荆卿背，匕首难伤赵政胸。\n燕国无辜竟鱼肉，可能人欲有天从。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54498,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题圆上人宴静轩","author":"吕南公","text":"宴安深静属居僧，一炷檀烟万虑清。\n犹自笑他檐外铎，风来未免斗鸣声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54499,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"客到","author":"吕南公","text":"客到空斋说早春，嫩红轻绿渐纷纷。\n寒人不预寻芳品，多谢东风许听闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54500,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答内翰太中观插稻见寄","author":"吕南公","text":"睡过春深一月馀，绿秧黄犊负村居。\n东风似恨归耕晚，故遣藜床日枕书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54501,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杨朱","author":"吕南公","text":"战国功名尺寸劳，先生持论异吾曹。\n孟轲解辩承三圣，后世谁曾拔一毛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54502,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陈都曹座中出示诸公曲词以四句酬之","author":"吕南公","text":"看尽新词听尽声，未能高和耳徒倾。\n聋身纵作岐山老，争得闻他彩凤鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54503,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"真辉阁","author":"吕南公","text":"会得真时真亦空，光辉何足更流通。\n劝师不用严标榜，瞀者逢灯与暗同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54504,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"安昌县侯","author":"吕南公","text":"能说齐论与鲁论，世儒希合便纷纷。\n何曾后学皆传信，祇有奸名万古闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54505,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"小槛","author":"吕南公","text":"小槛幽花已破香，此心无处避韶光。\n年年恶作伤春客，稳为东风细断肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54506,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杨八送笋以四句谢之时在湖口","author":"吕南公","text":"杀却卢家十五龙，野人盘馔当时丰。\n湖干少得中林味，此日乡心转不同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54507,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读白司马江州诗","author":"吕南公","text":"四年司马滞江边，几杖茅堂自说闲。\n倘使金銮不迁谪，知君未暇爱庐山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54508,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"献陈和叔内翰","author":"吕南公","text":"留滞周南事可嗟，东风三度见梅花。\n岩廊未引经纶手，山国频听早晚衙。\n酒为忧民倾日月，诗从思退写烟霞。\n宾筹更有林中士，谁及船斋太守家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54509,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九月二十三日过黄家岭望行春门有感","author":"吕南公","text":"閒云泛淡水浮浮，秋色阴时刺眼愁。\n十载未成三窟计，一身长带百年忧。\n逢人语笑非良味，洒面尘埃岂自由。\n望见故山归不得，小栏高槛更回头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54510,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"五贤堂","author":"吕南公","text":"汉唐相望向千年，此地追崇祇五贤。\n器业不同流俗浅，声容终得后人传。\n壁间碑版敲新墨，砌下莓苔长野钱。\n何似淫祠专祸福，歌吹士女日諠阗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54511,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"吕南公","text":"溪田桥畔驼鞍岭，犹记当年志未平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54512,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"太父太师密国公赋诗江楼世称名笔从侄子绩得之以居肇缅思祖德且爱绩之能继志也为赋一首","author":"曾肇","text":"当年太史谪仙翁，笔落江楼气吐虹。\n无复琴樽对鸥鸟，空遗松柏几秋风。\n由来兰玉生台下，重见溪山入坐中。\n顾我岂能绳祖武，倚阑归思附冥鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54513,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次兄子宣先生作高阳众乐园成被命金陵易镇韵","author":"曾肇","text":"文物河间信可嘉，风流江左亦堪誇。\n水南水北千竿竹，山后山前二月花。\n久愧迂儒怀郡绂，聊须隽老驻军牙。\n两州耆旧无多怪，鲁卫从来是一家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54514,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游石仙岩次兄子宣公韵","author":"曾肇","text":"尘埃华发换朱颜，十载重来款故关。\n天下楼台春寂寂，洞中鸡犬昼闲闲。\n苔深尚识曾题石，木老难寻旧戏环。\n未断凡心却归去，他年飞鸟会知还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54515,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"族兄山庄","author":"曾肇","text":"宦路崎岖寄此身，羡君筑室离嚣尘。\n能将孝谨传家法，何用声名动世人。\n桑落百壶宁惜醉，竹竿千亩不忧贫。\n求田更欲依丘垄，来往他时愿卜邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54516,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"出门寄家","author":"曾肇","text":"出门日日念归期，恐过归期未得归。\n画角数声来别浦，孤帆一点背斜晖。\n行逢山树秋前落，坐见江云水上飞。\n尽是南人好风景，客心惊此却依依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54517,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄吕南公","author":"曾肇","text":"主人第一河南守，之子无双江夏才。\n会见吹嘘上云汉，可能憔悴隐蒿莱。\n风骚寓兴垂金薤，翰墨传家富玉杯。\n倾盖相知胜白首，扁舟临别重徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54518,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"淮南道中","author":"曾肇","text":"四山蓊郁气朝隮，晚雨廉纤未有泥。\n鸭绿几寻塘水浸，鹅黄一段稻秧齐。\n幽花布地金钱小，野蔓萦林翠幄低。\n满目淮南风景好，不堪时听子规啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54519,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"海陵春雨日","author":"曾肇","text":"公事无多使客稀，雨时衙退吏人归。\n沉烟一炷春阴重，画角三声晚照微。\n桑雉未驯惭报政，海鸥相近信忘机。\n只将宴坐收心念，懒向人间问是非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54520,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南郭隐居","author":"曾肇","text":"南郭萧条居士家，断垣荒堑翳蓬麻。\n筼筜映水千竿直，略彴当门一径斜。\n老有图书忘世界，贫无杯酌送生涯。\n倘来轩冕何须贵，未胜牛衣驾鹿车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54521,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次后山陈师道见寄韵","author":"曾肇","text":"故人南北叹乖离，忽把清诗慰所思。\n松茂雪霜无改色，鸡鸣风雨不愆时。\n著书子已通蝌蚪，窃食吾方逐鸒斯。\n便欲去为林下友，懒随年少乐新知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54522,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"京口甘露寺","author":"曾肇","text":"屈曲危楼倚半空，诗情无限景无穷。\n江声逆顺潮来往，山色有无烟淡浓。\n风月满楼供一览，乾坤万里豁双瞳。\n片云迥逐斜阳去，知落淮山第几重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54523,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"元祐六年十月庚午驾自景陵宫移仗谒先圣孔子祠入门降辇步就小次由东阶以升奠爵再拜礼官告成礼然后退幸太学诏博士皆升堂坐诸生两庑下命国子祭酒丰稷讲书无逸终篇因又幸武成王庙而还左丞相吕大防右丞相刘挚率百官皆从于是丞相赋诗以形容上德诸在位者皆属和肇以礼官忝从诸大夫之后谨和诗一章","author":"曾肇","text":"琳馆陪祠日未央，隆儒诏跸至胶庠。\n桥门亿万衣冠集，阙里三千弟子行。\n降辇横经尊往圣，垂裳论道法前王。\n宗公归美清风诵，穆若赓酬出庙堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54524,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"武夷山天柱峰","author":"曾肇","text":"燕越相望路八千，忽惊天柱落樽前。\n何如乞我双凫舄，飞上峰头访列仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54525,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"滁州琅玡山茶仙亭","author":"曾肇","text":"山僧独好事，为我结茅茨。\n茶仙榜亭中，颇宗樊川诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54526,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"灵寿同年兄再以杞屑分惠复成小诗以代善谑","author":"曾肇","text":"场屋十年长，铃斋一笑欢。\n微言师水薤，交分托金兰。\n腹饱仙人杖，心存姹女丹。\n他时玉京路，同缀侍宸官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54527,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上王荆公墓","author":"曾肇","text":"天上龙胡断，人间鵩鸟来。\n未应淮水竭，所惜泰山颓。\n华屋今非昔，佳城闭不开。\n白头门下士，怅望有馀哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54528,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"河间","author":"曾肇","text":"南北车书久混同，河间今有楚人风。\n独惭太守非何武，已见州闾出两龚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54529,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"二贤堂 其一","author":"曾肇","text":"天骥精神凤羽仪，青云天路此委蛇。\n由来道谊千钧重，不独文章一世师。\n史牒已传三黜赋，骚人谁继八哀诗。\n有时无命非今日，从古长沙贾傅悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54530,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"二贤堂 其二","author":"曾肇","text":"万壑千岩花草香，醉翁此地昔徜徉。\n不闻燕雀知鸿鹄，但见鸱枭笑凤凰。\n平日声名追屈贾，暮年勋业佐虞唐。\n神清洞府今何处，故事空留楚天傍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54531,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"凌霄花","author":"曾肇","text":"凌波条体纤，柔枝叶上缀。\n青青乱松树，直干遭蒙蔽。\n不有严霜威，焉能辨坚脆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54532,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"紫薇花 其一","author":"曾肇","text":"堂前紫薇花，堂下红药砌。\n繁华天上春，偪仄人间世。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54533,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"紫薇花 其二","author":"曾肇","text":"明丽碧天霞，千茸紫绶花。\n香开荀令宅，艳入孝王家。\n几岁自荣辱，高情方叹嗟。\n有人移上苑，犹足占年华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54534,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"灵寿木","author":"曾肇","text":"滇池藤赤人难到，太乙青藜事近诬。\n林下支来供燕息，省中携去宠师儒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54535,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"薝卜花","author":"曾肇","text":"林兰擅孤芳，性与凡木异。\n不受雪霰侵，自足中和气。\n欲知清净身，即此林间是。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54536,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]