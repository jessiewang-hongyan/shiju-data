[{"title":"依韵和陆丈瑞香花","author":"强至","text":"花下诗翁已富情，爱花相咏句还成。\n才开秀格能殊众，到老清香不负名。\n世上流芳归几处，江南传价入中京。\n乾坤定是怜馨德，那许风前趁落英。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75854,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵和居方观崔生画","author":"强至","text":"古今画手得名人，一物才工自出伦。\n字与丹青俱是绝，势关飞动不无神。\n浪传误笔成蝇点，那待青田写鹤真。\n候雁枯荷含远意，江湖归兴划然新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75855,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵和择之惜春","author":"强至","text":"何门织妇为春魔，几听啼莺暗辍梭。\n美酿入唇宜莫算，芳期屈指已无多。\n迎风柳絮飘都尽，著雨花枝落半过。\n正好狂歌对馀景，休因节物叹蹉跎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75856,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵和郑中立秘丞将替写怀","author":"强至","text":"宰邑优游不足为，传家事业复能持。\n政兼子产那专惠，学近康成最爱诗。\n百里耕桑增日课，三年闾井见风移。\n襟怀洒落恬荣进，清节从来畏众知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75857,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵和赵晦夫书记将替写怀","author":"强至","text":"芙蓉幕里住三年，鹦鹉才高动四筵。\n风月漫劳吟杜曲，文章自好纪燕然。\n朋簪会合愁分手，官簿纵横待息肩。\n直道先难终易偶，近闻知已荐书全。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75858,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵和留台崔库部局中自遣","author":"强至","text":"儒林文雅作，萧散欲挥金。\n老去安时态，秋来慰夙心。\n谁陪黄菊酒，自喜白头吟。\n宾客霜台少，诗成每独斟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75859,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵和崔伯宪谢王正甫遗三灵丸蜀茶","author":"强至","text":"一丸道士曾投药，七碗先生亦爱茶。\n服久有时轻俗骨，味新应早摘灵芽。\n病躯自健遗藤杖，睡眼全醒耐烛花。\n可是兼饶诗力壮，芙蓉幕里句堪嘉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75860,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵和彭九及之归养之什","author":"强至","text":"江南春自好，蜀客亦思归。\n泪与花俱落，心随燕共飞。\n露章还子舍，孝理副宸闱。\n禁署风流后，谋渔未有矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75861,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵和答公谔郎中冠氏道中偶成","author":"强至","text":"漭漭黄埃接大河，驱车底处觅阳和。\n参差花信春将半，恼乱诗情日转多。\n乐事恍如初觉梦，年光撇若迅流波。\n马蹄莫放归时缓，知有佳人听玉珂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75862,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵和答陆革进士招饮池上诗","author":"强至","text":"主人爱客扫林亭，天影波光相与明。\n蝶傍池边飞舞惯，鸟从花上往来轻。\n沧浪傲世不复羡，鶗鴂妒春惟欲鸣。\n能趁繁枝开熟酿，先拚黄帽为君倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75863,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵和答陈公度五邑季点道中见寄之什","author":"强至","text":"幕府清郎安在哉，方冬行县冒尘埃。\n寂寥坐客思车乐，点检诗朋欠鼎来。\n按吏最谁官簿整，教民几处战旗开。\n未应输我论文饮，赢得新诗满箧回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75864,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵和答晋倅洪君然都官三益见寄","author":"强至","text":"别乘文章晚更奇，全家才业继前徽。\n闺中蔡琰诗无敌，膝下刘歆笔有讥。\n归意我惭彭泽柳，清肠君爱首阳薇。\n案头簿领真流俗，独喜吟怀与世违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75865,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵和道济秘丞集英殿秋宴作","author":"强至","text":"都场百戏已先呈，舞字逡巡列太平。\n酒缓天颜应有喜，乐高禁漏不闻声。\n晴晖忽傍金茎动，协气偏从玉座横。\n何事君臣皆共乐，银台连日奏秋成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75866,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵和酬王明远见寄","author":"强至","text":"一日论交坐席间，肯平壮气就衰颜。\n篇章漫欲窥沧海，道谊从来仰泰山。\n白日声名君籍籍，青云意绪我斑斑。\n元戎幕府那能久，太学诸生已望还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75867,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵和酬孙公素中允写怀见贻","author":"强至","text":"车马门前住罕逢，春坊内允独相从。\n领垂素发惊潘岳，器负青云爱仲容。\n身世百年今有愧，功名万事近尤慵。\n不缘婚嫁须微禄，已拂红尘就赤松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75868,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵和酬杨公济澄江见寄长句","author":"强至","text":"子美幕中赡暇日，喜传幽事到京华。\n地偏浙水开孤垒，风散江云覆万家。\n日出鱼虾来早市，潮空凫雁落晴沙。\n羡君吏隐能终岁，却恨吾游未有涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75869,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵和酬顺安使君王大观见寄之什","author":"强至","text":"苍鬓萧疏并曲台，北门笑口屡同开。\n仲升投笔燕南去，王粲从军陕右来。\n月冷戍楼悲短笛，天寒戎幕赖深杯。\n更为后会知何地，终日思君首懒回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75870,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵和酬留别","author":"强至","text":"魏国山河气自雄，殊方客子一身穷。\n灵文独富肝脾内，秀句连成咳唾中。\n细数旧游如俯仰，俄惊新别又西东。\n郡侯早晚论高行，懒就秋闱望至公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75871,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵和酬阆州刘侍禁季孙见寄","author":"强至","text":"别来双鬓一衰翁，近喜刘郎信息通。\n剑气未闲频犯斗，赋声无用尚摩空。\n传闻蜀道逾天上，见说城南冠阆中。\n山水纵游那觉久，清霜两度变丹枫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75872,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵和酬鲜于子骏郎中见寄","author":"强至","text":"昨在王公幕，同时辄仰攀。\n论情昆弟等，知己友朋间。\n渭北孤交臂，淮阳慰客颜。\n长卿看驷马，父老望西还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75873,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵和粹中早春","author":"强至","text":"寒威犹压晓，淑气已回春。\n不道朱颜旧，刚怜华岁新。\n震雷将出地，蛰户莫存身。\n渐报莺花信，眉头日渐伸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75874,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵和镇叔送元宵之什","author":"强至","text":"一夜云衢火树空，照人唯有月华同。\n却思广陌追游处，都似南柯梦寐中。\n未分园林辜乐事，况栽桃杏有春工。\n可怜此景何时再，直待明年岁起东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75875,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵奉和王平甫学士寄元内翰诗","author":"强至","text":"蓬莱仙阙地深沉，视草雠书此盍簪。\n禁漏传声来阁外，宫云曳影过廊阴。\n能诗摩诘淹儒馆，未相微之在翰林。\n马跃秋风出阊阖，片时相失遂成吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75876,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵奉和司徒侍中八月十九日赏菊","author":"强至","text":"秋风生意众怜迟，一旦先开岂足悲。\n无髻竞分浓蕊插，有襟聊对细香披。\n闰催虽隔重阳月，节去犹胜十日时。\n不比无名閒草木，早蒙造化祇堪嗤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75877,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵奉和司徒侍中上元遇雨即席","author":"强至","text":"金络香軿匼匝来，门阑彻禁夜无猜。\n正怜舞曲随风转，骤觉灯花冒雨开。\n屏翳呼云何倏忽，嫦娥收月漫徘徊。\n相君未放春宵醉，倒尽宜城第几罍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75878,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵奉和司徒侍中中秋筵散雨馀微见月色","author":"强至","text":"待月开筵细雨侵，月来宾去意空深。\n未容午夜瞻全璧，先隔微云漏碎金。\n万户渐宜归一望，重楼恨不起千寻。\n应须润泽周封内，始放清辉出暝阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75879,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵奉和司徒侍中元城埽行河","author":"强至","text":"一鼓千夫下揵声，缺堤漏穴几时平。\n盘涡倒吸湍流住，巨浸疑浮厚地行。\n举锸每年劳众力，治河无策贡愚诚。\n赖公自有安邦德，何处风波敢更生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75880,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵奉和司徒侍中元宵席上","author":"强至","text":"席上香风转绮罗，北门东道汉萧何。\n灯摇万井年光嫩，月覆千闾夜色多。\n楼阁影重占物阜，管弦声洽验民和。\n相公不惜阳春曲，传与都人每岁歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75881,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵奉和司徒侍中壬子九日","author":"强至","text":"虚堂飞阁席频移，肯对茱萸忆赐枝。\n诗集元精尤唱绝，歌翻新曲更相宜。\n登临晚日曾谁怨，醉倒秋风不自知。\n一种孤根输老菊，明年犹得傍东蓠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75882,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵奉和司徒侍中壬子三月十八日游御河二首 其二","author":"强至","text":"綵舟徐动信春风，丞相行春乐意融。\n花底马蹄追暮鸟，柳梢旗尾挂晴虹。\n驱驰造化三篇里，摆落尊荣一笑中。\n何况佳辰偏宴客，酒樽东阁不曾空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75883,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵奉和司徒侍中壬子三月十八日游御河二首 其一","author":"强至","text":"当时御水始通津，遂作河生记此辰。\n载籍不闻传故老，盛游相继到今人。\n金貂为政居从俗，画鹢连年出慰民。\n锦绣匝堤箫鼓沸，风光流动一城春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75884,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵奉和司徒侍中壬子中秋对月","author":"强至","text":"莫畏流光催白头，且欣圆魄半清秋。\n当时初作今宵会，每岁还同故事修。\n飞盖漫游亏燕喜，胡床独坐减风流。\n何如锦席笙歌拥，醉看银盘射玉楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75885,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵奉和司徒侍中冬节筵间喜雪","author":"强至","text":"初长日景午阴前，瑞雪迎开上相筵。\n点缀酒杯飞细细，侵凌歌扇落绵绵。\n岁功豫作三登地，云气都成一色天。\n惊破醉魂诗句险，不容吏部瓮根眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75886,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵奉和司徒侍中戊申西洛中秋对月","author":"强至","text":"白玉盘从海面浮，闲云一点即时收。\n山川表里无遗照，天地寻常可是秋。\n清景似偏孙相阁，高情更属庾公楼。\n暂纾化笔归诗句，不泯长随洛水流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75887,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵奉和司徒侍中仲春释奠","author":"强至","text":"先圣祠逾重，尊儒世适丁。\n上公仪最熟，太学祭频经。\n晓月衣冠净，春风俎豆馨。\n魏人休请颂，在泮已言形。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75888,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵奉和司徒侍中压沙寺梨","author":"强至","text":"谁将冰蜜共囊封，结实祇园颗颗同。\n蔽芾舍傍思召伯，周流林下赋扬雄。\n花经春月千层白，颊傅秋霜一抹红。\n江橘空甘得奴号，果中清品合称公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75889,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵奉和司徒侍中同赏牡丹","author":"强至","text":"按谱新求洛下栽，朱栏围土事深培。\n半妆晓日争光照，一笑春风喜竞开。\n得地自依孙相閤，飞香欲绕邺王台。\n绣帘对赏犹嫌远，剪上金盘近酒杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75890,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵奉和司徒侍中同赏梨花","author":"强至","text":"千株缀雪绀园中，数顷花开几度逢。\n体瑩直忧春欲妒，色孤犹喜月相容。\n香浮翠盖台光近，瓣落清樽饮兴浓。\n公恰徘徊吟妙句，不须忙打寺楼钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75891,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵奉和司徒侍中安正堂观牡丹","author":"强至","text":"独王花天晚自开，群芳臣妾漫争媒。\n金刀几度裁云叶，玉席多情向斗魁。\n檀口似迎迟日笑，香心肯逐疾风颓。\n相君造化春工手，写入新诗意更瑰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75892,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵奉和司徒侍中西园初暑之什","author":"强至","text":"夏木参云百尺长，昼阴笼日一轩凉。\n杂追楚榭迎风袂，冷笑淄川作雨滂。\n歌扇参差立燕赵，客裾容曳赴原尝。\n坐来诗句清人骨，胜抱冰壶饮玉浆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75893,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵奉和司徒侍中辛亥七夕末伏","author":"强至","text":"七夕三庚共此辰，风迎西火转南薰。\n金盘瓜果随时俗，玉盏笙歌劝相君。\n月下巧心空自竞，天边私语复谁闻。\n早归肯效东方朔，待看星桥夜度云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75894,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵奉和司徒侍中辛亥二月十五日","author":"强至","text":"去去春光鸟翼过，云阴风恶更相和。\n屡探花信犹全閟，拟借莺声肯暂那。\n铃吏事来须缓报，相公宾退正闲哦。\n九旬已是中分了，诗酒尤宜并一科。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75895,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵奉和司徒侍中辛亥三月十八日游御河二首 其二","author":"强至","text":"此日河生旧俗传，相公同众乐沙堧。\n迎舟戏羽来低岸，罥席游丝落半天。\n佳句独高珠履上，贵名都忘玉樽前。\n明年盛会知难再，行看还朝百辟先。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75896,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵奉和司徒侍中辛亥三月十八日游御河二首 其一","author":"强至","text":"玉勒牙旌驻水湄，万人齐看柁开时。\n此朝河伯想增气，去岁国公还赋诗。\n岸蝶偶然穿翠箔，沙禽曾不避红旗。\n旬馀即报行春足，可厌归轩暮雨随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75897,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵奉和司徒侍中辛亥上巳会许公亭","author":"强至","text":"许开壮观旧平津，今日还延相阁宾。\n茅社一临封国地，花亭三见禊杯春。\n随车和气蒙鱼鸟，即席高吟动鬼神。\n西北连年参幕府，东风长忝从游人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75898,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵奉和司徒侍中庚戌秋分","author":"强至","text":"金气才分向此朝，天清林叶拟辞条。\n三秋半去吟蛩逼，百感中来酝蚁消。\n候早初逢旬甫浃，月圆前距望非遥。\n如今昼夜均长短，占录无劳史姓谯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75899,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵奉和司徒侍中苦热未雨","author":"强至","text":"乾坤五月气炎歊，丞相忧农心更焦。\n思脱尘埃遗暑湿，拟排寥廓御风飙。\n穴中战蚁空知验，云外晴虹尚肆祅。\n下土颙颙望霖雨，好回天意慰黎苗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75900,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵奉和司徒侍中视河惬山","author":"强至","text":"闻昔兹山运土成，喜情比屋与连营。\n可怜事出三王后，不得亲逢伯禹名。\n邻国一朝罹暴水，相君先虑护严城。\n他时人说公来日，应记初更月旦评。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75901,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵奉和司徒侍中春阴席上","author":"强至","text":"未消残雪在墙阴，昼景昏昏似日沈。\n土冻转愁花信远，天寒唯仗酒分深。\n笑谈四座相欢色，富贵三朝不动心。\n诗句一传人竞写，也应潜购到鸡林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75902,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵奉和司徒侍中春雪","author":"强至","text":"草木空催造化忙，六花先出压群芳。\n酒寒玉斝消春味，烟湿金炉减昼香。\n地暖落斝堆旋失，风和乱片舞初长。\n相公更好调元去，已兆丰年在此乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75903,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵奉和司徒侍中重九会安正堂二首 其二","author":"强至","text":"萸杯引满宴公堂，病客偏容泛浅觞。\n为爱菊花惊晚节，不羞蓬鬓插秋香。\n众宾谈笑谁倾座，上相风骚独擅场。\n来岁凤池吟此日，夔龙高会耀辞铓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75904,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵奉和司徒侍中重九会安正堂二首 其一","author":"强至","text":"茱萸缀席落新堂，丞相诗锋不可当。\n九日绣筵吟节物，十年黄閤运阴阳。\n酒边和气忘公衮，风外清歌出女墙。\n宾去每来安正坐，泰然德宇发天光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75905,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵奉和司徒侍中留题灵泉观","author":"强至","text":"坏道颓墙绕旧山，空馀绣岭郁巑岏。\n庭柯引蔓长垂盖，林荚遗妖尚合欢。\n清渭不随人事改，温泉那解客心寒。\n唐宫芜没今何在，漫拂津阳石记看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75906,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵奉和司徒侍中喜雨应祷","author":"强至","text":"合书时雨奏银台，润泽从今遍九垓。\n应祷岂惟三日后，为霖曾是十年来。\n已逃虐魃知何地，自起乖龙不待雷。\n无数公堂森贺笏，尽同秋种荷陶坯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75907,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵奉和判府司徒侍中望宸閤雪后","author":"强至","text":"雪中气象但漫漫，雪后乾坤净好看。\n零落瑶林晴照里，参差银阙暮云端。\n疑开粉墨图新就，犹洒楼台笔未乾。\n万井都人蒙煦育，恩深不觉夜来寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75908,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵奉和判府司徒侍中赏西禅院牡丹之什","author":"强至","text":"花蒙一顾重长安，从此时人洗眼看。\n留艳徘徊供燕席，飞香迤逦上貂冠。\n露苞含晓宜三嗅，风朵摇春似七盘。\n便好移归东阁种，免教来岁隔栏干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75909,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵奉和判府司徒侍中壕林","author":"强至","text":"星榆落种还生地，营柳移根总傍壕。\n夸父林稠宜较盛，太师垣峻敢争高。\n岁科充蠹疲民产，城守胜提壮士旄。\n长与万家添外圉，邺人心结此思牢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75910,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵奉和判府经略司徒侍中上巳晚游九曲池诗","author":"强至","text":"地势盘纡巧凿开，当年匠意亦多才。\n池名不逐唐宫废，岸折犹如蜀阪来。\n水落有时逢旧石，草深无处觅遗台。\n行春丞相寻陈迹，往事空嗟浩劫灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75911,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵奉和判府经略司徒侍中春阴马上之什","author":"强至","text":"湿云落地未回天，坠絮将飞力尚绵。\n雾重自侵旗尾润，日高谁傍瓮头眠。\n行田岁望三登谷，按辔诗成万选钱。\n霖雨长应随出处，春来只见月光圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75912,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵奉和经略司徒侍中寒食后池诗二首 其二","author":"强至","text":"置酒高吟禁火天，主人勋德重韦贤。\n庙朝论道看三入，樽俎谈兵已万全。\n晓竹洗烟丛玉瘦，春池溅雨乱珠圆。\n曲江壮观今芜没，不复红妆照客船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75913,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵奉和经略司徒侍中上巳会兴庆池","author":"强至","text":"千载兰亭后，风流宛目前。\n竹昏烟冉冉，花泣露涟涟。\n笔落诗推将，杯行酒有仙。\n水边佳丽少，春草谩芊绵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75914,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵奉和经略司徒侍中过湫马上始见终南","author":"强至","text":"紫诰泥封墨未乾，暂班全陕诏条宽。\n旧来霖雨从神觅，好在晴山立马看。\n翠入重城朝自润，势吞平野夏犹寒。\n公师岩石同临镇，关右人心转觉安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75915,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]