[{"title":"满江红 丁未九月南渡，泊舟仪真江口作","author":"赵鼎","text":"惨结秋阴，西风送、霏霏雨湿。\n凄望眼、征鸿几字，暮投沙碛。\n试问乡关何处是，水云浩荡迷南北。\n但一抹、寒青有无中，遥山色。\n天涯路，江上客。\n肠欲断，头应白。\n空搔首兴叹，暮年离拆。\n须信道消忧除是酒，奈酒行有尽情无极。\n便挽取、长江入尊罍，浇胸臆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46944,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"满庭芳 九日用渊明二诗作","author":"赵鼎","text":"靡靡流光，凄凄风露，小园草木初凋。\n杳然尘影，爽气界天高。\n爱此佳名重九，随宜对、秋菊持醪。\n登临处，哀蝉断响，燕雁度云霄。\n闲谣。\n情缅邈，相寻万化，人世徒劳。\n念胸中百虑，何物能消。\n欲致颓龄不老，和金茎、一醉陶陶。\n君休问，千年事往，聊与永今朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46945,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"虞美人 冯翊送信道舅先归桐宫","author":"赵鼎","text":"魂消目断关山路。\n曾送雕鞍去。\n而今留滞古陪京。\n还是一尊芳酒、送君行。\n吾庐好在条山曲。\n三径应芜没。\n诛茅为我补东篱。\n会待新春残腊、也来归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46946,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝶恋花 其一","author":"赵鼎","text":"一朵江梅春带雪。\n玉软云娇，姑射肌肤洁。\n照影凌波微步怯。\n暗香浮动黄昏月。\n谩道广平心似铁。\n词赋风流，不尽愁千结。\n望断江南音信绝。\n陇头行客空情切。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46947,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝶恋花 其二 河中作","author":"赵鼎","text":"尽日东风吹绿树。\n向晚轻寒，数点催花雨。\n年少凄凉天付与。\n更堪春思萦离绪。\n临水高楼携酒处。\n曾倚哀弦，歌断黄金缕。\n楼下水流何处去。\n凭栏目送苍烟暮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46948,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉桃园/桃源忆故人 送春","author":"赵鼎","text":"青春不与花为主。\n花正开时春暮。\n花下醉眠休诉。\n看取春归去。\n莺愁蝶怨春知否。\n欲问春归何处。\n只有一尊芳醑。\n留得青春住。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46949,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉蓬莱 庆寿","author":"赵鼎","text":"破新正春到，五叶尧蓂，弄芳初秀。\n剪彩然膏，灿华筵如昼。\n家庆图中，老莱堂上，竞祝翁遐寿。\n喜气欢容，光生玉斝，香霏金兽。\n谁会高情，淡然声利，一笑尘寰，万缘何有。\n解组归来，访渔樵朋友。\n华发苍颜，任从老去，但此情依旧。\n岁岁年年，花前月下，一尊芳酒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46950,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"燕归梁 为人生日作","author":"赵鼎","text":"绰约彤霞降紫霄。\n是仙子风标。\n湘裙明佩响琼瑶。\n散馥郁、暗香飘。\n小春十月寒犹浅，妆粉弄梅梢。\n秦楼风月待吹箫。\n舞双鹤、醉蟠桃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46951,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 建康上元作","author":"赵鼎","text":"客路那知岁序移，忽惊春到小桃枝。\n天涯海角悲凉地，记得当年全盛时。\n花弄影，月流辉，水晶宫殿五云飞。\n分明一觉华胥梦，回首东风泪满衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46952,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"念奴娇","author":"赵鼎臣","text":"嫦娥伴侣，降人世，天与长生仙箓。\n五色云开浮瑞霭，中有西真眉目。\n贤德家风，艳容天赋，占尽人间福。\n长庚明月，誓同千古相逐。\n开宴香蔼华堂，金杯休诉，好醉蟠桃熟。\n子子孙孙同上寿，有个人人同祝。\n雨鬓春风，一钗香雾，长与瑶池绿。\n更祈眉寿，愿如南山松竹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46953,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"念奴娇","author":"赵鼎臣","text":"旧游何处，记金汤形胜，蓬瀛佳丽。\n渌水芙蓉，元帅与宾僚，风流济济。\n万柳庭边，雅歌堂上，醉倒春风里。\n十年一梦，觉来烟水千里。\n惆怅送子重游，南楼依旧不，朱阑谁倚。\n要识当时，惟是有明月，曾陪珠履。\n量减杯中，雪添头上，甚矣吾衰矣。\n酒徒相问，为言憔悴如此。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46954,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题张家店壁","author":"赵像之","text":"舍策投床睡便浓，觉来凉叶动西风。\n惊秋念远无穷意，客里谁知此夜同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46955,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"阮郎归 远德殿作和赵志忠","author":"赵慎","text":"留连春意晚花稠。\n云疏雨未收。\n新荷池面叶齐抽。\n凉天醉碧楼。\n能达理，有何愁。\n心宽万事休。\n人生还似水中沤。\n金尊尽更酬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46956,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"览梦得所藏李伯时画吴中三贤像因各书绝句 张翰","author":"赵楷","text":"西风淅淅动高梧，目送浮云悟卷舒。\n自是归心感秋色，不应高兴为鲈鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46957,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"览梦得所藏李伯时画吴中三贤像因各书绝句 陆龟蒙","author":"赵楷","text":"杞菊萧条绕屋春，不教鹅鸭恼比邻。\n满身花影犹沈醉，真是江湖一散人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46958,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"览梦得所藏李伯时画吴中三贤像因各书绝句 范蠡","author":"赵楷","text":"已将勋业等浮鸥，鸟尽弓藏见远谋。\n越国江山留不住，五湖风月一扁舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46959,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舟□□□读中兴碑","author":"赵楷","text":"西风吹岸著浯溪，玉洁摩空十丈碑。\n不□开元久培植，可能灵武善扶持。\n斯文未泯今□□，盛德之兴彼一时。\n崖下漫郎应在否，□□流涕手题诗。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46960,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其五","author":"赵佶","text":"方当月白风清夜，正是霜高木落时。\n落花满地春光晚，芳草连云暮色深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46961,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"老苏先生挽词 其一","author":"赵概","text":"称味栾城旧，潜光谷口栖。\n雄文联组绣，高论吐虹霓。\n遽忽悲丹旐，无因祀碧鸡。\n徒嗟太丘德，位不至公圭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46962,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"老苏先生挽词 其二","author":"赵概","text":"侍从推词伯，君王问子虚。\n早通金匮学，晚就曲台书。\n露泣时难驻，琴亡韵亦疏。\n臧孙知有后，里闬待高车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46963,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送梵才大师归天台","author":"赵概","text":"建刹存真意，崇台表大因。\n中藏般若偈，外护赤城神。\n花雨长霏昼，松风自扫尘。\n愧心同范宁，莲社阻相亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46964,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"赵概","text":"滁水西偏郡，丰山北际楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46965,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吴山青/长相思 水仙","author":"赵溍","text":"金璞明。\n玉璞明。\n小小杯柈翠袖擎。\n满将春色盛。\n仙佩鸣。\n玉佩鸣。\n雪月花中过洞庭。\n此时人独清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46966,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"临江仙 西湖春泛","author":"赵溍","text":"堤曲朱墙近远，山明碧瓦高低。\n好风二十四花期。\n骄骢穿柳去，文艗挟春飞。\n箫鼓晴雷殷殷，笑歌香雾霏霏，闲情不受酒禁持。\n断肠无立处，斜日欲归时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46967,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日山","author":"赵崇源","text":"九日登临老奈何，强将幽恨寄悲歌。\n疲攲巾帽愁风动，病著饥肠厌酒多。\n东岭荒榛藏马鬣，西岩空榻锁蜂窠。\n独怜堂下千章木，跨历齐梁未改柯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46968,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玉虚宫隐真堂","author":"赵瑞","text":"刘公到处留遗迹，奇绝惟兹独擅名。\n禅石无尘床稳卧，神丹有验井还清。\n冈峦四合如环绕，石笋孤高类削成。\n瑶草常春鹤不驻，松风犹似步虚声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46969,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游黄龙寺","author":"赵瑞","text":"一到黄龙万虑灰，豪吟胜赏喜追陪。\n幽兰独秀花香袭，宿雨初收雾气开。\n湛湛冰池藏世界，悠悠梵呗隔尘埃。\n清风明月无人管，付与纵横石上苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46970,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠胡侍郎致仕","author":"赵瑞","text":"几年为国寸心丹，今喜承恩衣锦还。\n张翰莼鲈偏入兴，陶潜松菊意休閒。\n坐邀夜月惟斟酒，笑引春风且看山。\n最好溪山多翠竹，与君日日报平安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46971,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"医兼画","author":"赵福元","text":"从来艺事两难精，今日逢君喜且惊。\n不待折肱医始悟，直须点目画方成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46972,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"苔钱","author":"赵福元","text":"绕径玲珑撒绿钱，田田成百又成千。\n未知买得春多少，草带不妨长短芊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46973,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"茉莉","author":"赵福元","text":"刻玉雕琼作小葩，清姿元不受铅华。\n西风偷得馀香去，分与秋城无限花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46974,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蚊","author":"赵福元","text":"隐隐雷声语暮天，欺风偷到玉堂前。\n纱厨浸月凉如水，赢得珠钿臂上眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46975,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚钟","author":"赵福元","text":"花洲人别月凉船，烟寺寒鲸隔岸闻。\n带雨一声天外落，过江穿破半山云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46976,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寿赵推官 其一","author":"赵福元","text":"天枝分秀蔼璇杓，光涌银河半夜潮。\n西母诞弥先十日，寿星颁朔恰三朝。\n骑龙曾把黄金斧，驾凤旋登紫玉霄。\n两国夫人荣有子，慈宣不老瑞香飘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46977,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寿徐尉","author":"赵福元","text":"幔亭驾斗浮丹巘，扁题密镂黄金篆。\n淋漓羽盖森鸾旂，仙凡不隔蟠桃宴。\n红云垂地醉壶天，真珠为浆玉为馔。\n中有一人长眉青，紫锦荷囊灿星弁。\n金昆玉友相追随，乌戟雕戈光转炫。\n皇览徐公百不忧，衮衮庆源由积善。\n綵童宣敕呼瑞麟，金锁掣雷奔虎殿。\n琼胎掇入孔释送，精神秋水目如电。\n抱琴来访矩庾仙，溉竹南墙弄诗卷。\n手持造化发生柄，和气嘘枯遍翘端。\n一同按谱学鸣弦，里巷生春无蹇连。\n岂弟君子民父母，肇迹温麻未之见。\n肘边叠组斗累累，五鹗搏空交剡荐。\n绿绨联翩阊阖门，催入笋班陪翠辇。\n九重宣补舜衣裳，吐出胸中五色线。\n周公拜前曾拜后，圣朝自有云屏典。\n朱颜苍鬓侍玉皇，九转金丹开鼎铉。\n芹香儒馆忻献歌，愿乞馀圭及鸡犬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46978,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"桃木","author":"赵福元","text":"神仙拥出蓬莱宫，罗帏绣幕围香风。\n云鬟绕绕梳翡翠，赪颜滴滴匀猩红。\n千娇百媚粲相逐，烂醉芳春逞芳馥。\n朝阳影里粲琼红，晨霞香中咽寒玉。\n承恩侍宴青帝前，锦衣半脱酣昼眠。\n莺莺燕燕扶不起，巧呼苦唤殊可怜。\n傍阑无力娇欲语，花群本是桃源女。\n几年流水饭胡麻，今在武陵溪上住。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46979,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梨花","author":"赵福元","text":"玉作精神雪作肤，雨中娇韵越清癯。\n若人会得嫣然态，写作杨妃出浴图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46980,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"沁园春 其三 寿黄虚庵三月廿九","author":"赵福元","text":"珠斗阑干，银河清浅，梦籋帝关。\n见六丁拥道，一声传跸，翠幢舞凤，彩扇交鸾。\n寿祝天齐，神夸岳降，报道明朝重整班。\n璇星烂，有赤松黄石，雾凑苍坛。\n仙风绿鬓朱颜。\n才奏罢呼麟游海山。\n命飞琼步月，瑶台凝净，云英捣雪，玉杵光寒。\n鹤立芝庭，龟迎荷□，鼎看翩翩彩袖翻。\n留春醉，醉何须归去，常在人寰。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46981,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"沁园春 其一 庆赵运干","author":"赵福元","text":"一剑凌风，跨六鳌头，登群玉峰。\n听金童宣敕，琼胎掇送，大唐进士，圣宋仙翁。\n琪树玲珑，宝花散漫，香霭天枝绕绛空。\n后五日，有竹湖公相，梦叶非熊。\n峥嵘得子如龙。\n傲南墅修篁皓鹤中。\n似银瓶碾月，一清彻底，玉虹贯斗，千丈蟠胸。\n洛殿催班，燃灯赐对，九万鹏程瞬息通。\n蟠桃宴，与蟾宫双桂，长伴乔松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46982,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"沁园春 其二 寿朱漕正月初八","author":"赵福元","text":"斗柄御寅，序启苍涂，气转洪钧。\n正乾坤交泰，圣贤相遇，风声虎啸，雾滃龙兴。\n华渚流虹，璇枢绕电，期迈三朝嵩降申。\n真希有，庆吾皇万岁，重臣千春。\n枫震宠数来频。\n绾叠组累累辉楚城。\n看袍将赐锦，带仍佩玉，十行丹诏，单骑红尘。\n入赞中兴，泰阶上宰，寿域八荒歌太平。\n运化笔，管烘□桃李，又一番新。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46983,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"减字木兰花 赠草书颠","author":"赵福元","text":"吮煤弄笔。\n草圣寰中君第一。\n电脚摇光。\n骤雨旋风声满堂。\n毫厘巧辨。\n唤起羲之当北面。\n醉眼摩研。\n错认书颠作酒颠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46984,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 赠歌妓","author":"赵福元","text":"裙曳湘波六幅缣。\n风流体段总无嫌。\n歌翻檀口朱樱小，拍弄红牙玉笋纤。\n腔子里，字儿添。\n嘲撩风月性多般。\n忔憎声里金珠迸，惊起梁尘落无帘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46985,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽叠山先生","author":"赵简边","text":"西山东海莫容身，芒履萧萧万里尘。\n去住更无宽岁月，死生惟有一君亲。\n丹心故国江云冷，白骨他乡塞草青。\n不是回头春已暮，至今犹说似痴人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46986,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游月岩书二绝以纪其清 其一","author":"赵虞臣","text":"兰著秋花分外奇，月岩清坐听枰棋。\n笑谭相与同心处，更近新凉八月时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46987,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游月岩书二绝以纪其清 其二","author":"赵虞臣","text":"兹游闲适实清奇，恍对柯山一局棋。\n兴尽相呼下山去，归途犹趁日西时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46988,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"涤斋","author":"赵雷","text":"想象盘铭号涤斋，涤斋端得苦安排。\n清清流出源头水，浴德澄清未有涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46989,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书楼课子","author":"赵雷","text":"云头月出倚楼看，老桂深深发广寒。\n底事嫦娥深爱惜，他年摘为少年簪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46990,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送马扩诣行在 其一","author":"赵榛","text":"全赵收燕至太平，朔方寸土比千金。\n氛祲一扫銮舆返，若个将军肯用心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46991,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送马扩诣行在 其二","author":"赵榛","text":"遣公直往面天颜，一奏临朝莫避难。\n多少焦苗待霖雨，雨霖只在月旬间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46992,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"少稷赋十二相属诗戏赠","author":"赵端行","text":"不用为鼠何数奇，饭牛南山聊自怡。\n探穴取虎有奇祸，守株伺兔非全痴。\n文成雕龙成卷轴，画蛇失杯坐添足。\n走马章台忆旧游，岁月才惊羊胛熟。\n羊窗要自息猕猴，异□无应心日休。\n白衣苍狗变化见，世事何如牧猪戏。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46993,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浪淘沙令","author":"赵缩手","text":"损屋一间儿。\n好与支持。\n休教风雨等闲欺。\n觅个带修安稳路，休遣人知。\n须是着便宜。\n运转临时。\n祆知险里却防危。\n透得玄关归去路，方步云梯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46994,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过大桥并出界偶成四绝寄邵阳父老 其三","author":"赵鼐","text":"邵阳拙政一年馀，不暇精思及远图。\n且了眼前无饿殍，家家温饱是良谟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46995,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过大桥并出界偶成四绝寄邵阳父老 其二","author":"赵鼐","text":"闻说当年送沈君，一城攀卧尽沾巾。\n续貂虽不亲传授，也解规随继后尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46996,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过大桥并出界偶成四绝寄邵阳父老 其一","author":"赵鼐","text":"行过邮亭日未西，遮留父老杂童儿。\n寄言我自无遗爱，底事潸然出涕洟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46997,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诗一首","author":"赵德□","text":"镵崖刻石成大像，谁道老僧多伎俩。\n虽云百尺最高高，应有游人到头上。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46998,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"澹山岩","author":"赵德纶","text":"岩扃二里锁烟霏，天下名山此本稀。\n硬石穿空谁运斧，寒泉滴雪欲添衣。\n仙游尘外杜萝老，僧住山间笋蕨肥。\n自叹微官犹缚我，倘容卜筑定忘归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46999,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绍兴丙辰冬十有二月戊申赵德载赴官宕渠入境小雨肩舆中戏作一绝书白鹤寺壁","author":"赵德载","text":"三年冷眼笑吹竽，世态炎凉我自如。\n却怪天公亦人事，入邦便有雨随车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47000,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题弦风亭","author":"赵潜夫","text":"怪他蟹舍蚝房地，不是吟情住亦难。\n数尺短墙围昼寂，半钩疏箔障春寒。\n水生草满蛙鸣合，日薄花阴鹤梦安。\n底处青衫病司马，浩歌东望取琴弹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47001,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丁卯除夕寓泸南独坐舟中有感去岁此夕","author":"赵蕃","text":"米仓山寨雪连云，不见椒盘见贼尘。\n今日江城闻爆竹，莫嫌杯酒不沾唇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47002,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"七月十有五夜一再梦故舒州使君侍御公宛如平生且于其案间得若纸若缯者一沓皆公所书或印者翻之有如帜者三有曰苛政曰赃吏忘其一焉问傍立者以何所用云始朝议欲遣公为某使故建此云觉而赋诗四绝 其四","author":"赵蕃","text":"梦回始觉死生分，愁咏江东日暮云。\n安得分明再如昨，并须示我玉楼文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47003,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"七月十有五夜一再梦故舒州使君侍御公宛如平生且于其案间得若纸若缯者一沓皆公所书或印者翻之有如帜者三有曰苛政曰赃吏忘其一焉问傍立者以何所用云始朝议欲遣公为某使故建此云觉而赋诗四绝 其三","author":"赵蕃","text":"弟过江东得附辞，奠犹乖往恸奚为。\n情真未觉幽明负，贫病牢人甚絷维。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47004,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"七月十有五夜一再梦故舒州使君侍御公宛如平生且于其案间得若纸若缯者一沓皆公所书或印者翻之有如帜者三有曰苛政曰赃吏忘其一焉问傍立者以何所用云始朝议欲遣公为某使故建此云觉而赋诗四绝 其二","author":"赵蕃","text":"一夕安能再与俱，话言宁觉死生殊。\n帜书更识埋轮志，生有不忘如是夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47005,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]