[{"title":"太宗皇帝挽歌 其一","author":"王禹称","text":"卜世知无极，上仙安可寻。\n祝尧违众望，传启合天心。\n陵柏萧骚韵，阶茅寂寞阴。\n何人开殿閤，尘暗九弦琴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18098,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"太宗皇帝挽歌 其二","author":"王禹称","text":"舜化无偏党，尧年欠耄期。\n世间人自哭，天上事难知。\n终让东封礼，遂成南狩悲。\n金銮旧学士，头白涕涟洏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18099,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"忆旧游寄致仕了倩寺丞","author":"王禹称","text":"桥映家家柳，泾通处处莲。\n海山微出地，湖水远同天。\n草没潮泥上，沙明蟹火然。\n应随白太守，十只洞庭船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18100,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"日长简仲咸","author":"王禹称","text":"日长何计到黄昏，郡僻官闲昼掩门。\n子美集开诗世界，伯阳书见道根源。\n风飘北院花千片，月上东楼酒一樽。\n不是同年来主郡，此心牢落共谁论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18101,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"长洲遣兴 其一","author":"王禹称","text":"七十浮生已半生，徒劳何日见功名。\n折腰米贱堪羞死，负郭田荒好力耕。\n庭鹤惯侵孤坐影，邻鸡应信夜吟声。\n年来更待贤良诏，咫尺松江未濯缨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18102,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"长洲遣兴 其二","author":"王禹称","text":"妻儿莫笑甑中尘，只患功名不患贫。\n自觉有文行古道，可能无位泰生民。\n烟村旧业劳归梦，雪屋孤灯照病身。\n投老绿袍未休去，九重天子用平人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18103,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"东邻竹","author":"王禹称","text":"东邻谁种竹，偏称长官心。\n月上分清影，风来惠好音。\n低枝疑见接，迸笋似相寻。\n多谢此君意，墙头诱我吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18104,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仙娥峰","author":"王禹称","text":"窈窕奇峰叠古苔，望秦岭外势徘徊。\n巨灵非疋休期刻，毛女为邻合往来。\n傅粉微茫春雪在，堕鬟浮动晓云开。\n好邀上雒王常侍，时就岩前饮一杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18105,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出守黄州上史馆相公","author":"王禹称","text":"出入西垣与内廷，十年四度直承明。\n又为太守黄州去，依旧郎官白发生。\n贫有妻贤须薄禄，老无田宅可归耕。\n未甘便葬江鱼腹，敢向台阶请罪名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18106,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"司空相公挽歌 其一","author":"王禹称","text":"全德群儒服，清名信史书。\n何人不调鼎，唯我得悬车。\n萧相文无害，于公庆有馀。\n三川归葬地，松槚自扶疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18107,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"司空相公挽歌 其三","author":"王禹称","text":"去岁频宣召，观灯复赏花。\n健嫌灵寿杖，轻弃富人车。\n列座先台席，温颜逼翠华。\n而今宅前路，雨破筑堤沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18108,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"司空相公挽歌 其二","author":"王禹称","text":"执礼身虽退，思贤宠未衰。\n垂行三入命，遽逼九原期。\n本末皆书史，功名别树碑。\n须知文集里，全似白公诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18109,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"四皓庙 其二","author":"王禹称","text":"小言望小利，载在礼经中。\n遂有鹰犬辈，拔剑各争功。\n一出定万乘，去若冥冥鸿。\n寂寂千古下，孰继采芝翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18110,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宁公新拜首座因赠","author":"王禹称","text":"著书新奏御，优诏及禅扉。\n首座名虽贵，家山老未归。\n磬声寒绕枕，塔影静侵衣。\n终忆西湖上，秋风白鸟飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18111,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"正月尽偶题","author":"王禹称","text":"一岁春光九十日，三分已是一分休。\n何曾快见花烧眼，只解潜催雪满头。\n莫问穷通求季主，自齐生死学庄周。\n终须摆脱人间事，高逐冥鸿狎海鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18112,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"甘棠即事简孙何","author":"王禹称","text":"甘棠风雅美贤臣，伐树悽悽亦圣人。\n因感得时留蔽芾，更嗟无位泣麒麟。\n谁知素教长多难，我向清朝自不辰。\n听讼何如使无讼，与君忧道合沾巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18113,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"立春日细雨","author":"王禹称","text":"澹于寒雾乱于丝，无点无声落不知。\n轻助雪痕归麦垄，暗随春气入梅枝。\n踏苔立久微沾屐，绕竹吟馀渐著髭。\n翻忆满身珠䍡?，江头闲把钓蓑披。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18114,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"龙凤茶","author":"王禹称","text":"样标龙凤号题新，赐得还因作近臣。\n烹处岂期商岭外，碾时空想建溪春。\n香于九畹芳兰气，圆似三秋皓月轮。\n爱惜不尝惟恐尽，除将供养白头亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18115,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仲咸以一秋苦雨两日忽晴以四韵见寄因次原韵兼纾客情","author":"王禹称","text":"愁霖百日思低迷，昨夜星辰似旧时。\n稼穑已伤忧客计，津梁全坏怯归期。\n丹河浪减沙痕涨，锦岭霜晴月影迟。\n喜霁未遑抽赋笔，劳君先惠碧云诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18116,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仲咸借予海鱼图观罢有诗因和","author":"王禹称","text":"偶费霜缣与綵毫，海鱼图画满波涛。\n支床难死惭龟壳，把酒狂歌忆蟹螯。\n鲳蚱脚多垂似带，锯鲨齿密利如刀。\n何当一一穷真伪，须把千寻铁网捞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18117,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仲咸就加郡印因以四韵贺而勉之","author":"王禹称","text":"如何小郡滞清贤，未得徵归振鹭班。\n莫怕三年持汉诏，犹胜迁客卧商山。\n俱谙宦路须推命，同有诗情合好闲。\n唯是谪官无考限，比君知向几时还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18118,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"伏日偶作","author":"王禹称","text":"移床拖簟就南轩，门掩闲坊半树蝉。\n多病形容唯有骨，食贫生计旋无钱。\n掖垣已忝年深直，朝谒终妨日晏眠。\n会解纶闱求郡印，早收馀俸卜归田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18119,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"先帝登遐圣君嗣位追惟恩顾涕泣成章","author":"王禹称","text":"鼎湖髯断去难攀，九五飞龙已御乾。\n两制旧臣生白发，一番新贵上青天。\n老为郎吏承缞绖，假作诸侯哭几筵。\n疏贱无由撰哀册，梦中空负笔如椽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18120,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再授小谏偶书所怀","author":"王禹称","text":"宦途滋味饱更谙，命薄于人分亦甘。\n两鬓雪霜为小谏，六街泥雨趁常参。\n便休禄仕饥寒累，强逐班行面目惭。\n安得去如种处士，板舆荣侍卧终南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18121,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再赋一章用伸赠别","author":"王禹称","text":"七榜御前搜俊造，商州终未识迁莺。\n可怜白屋孤寒士，更住深山寂寞城。\n独跨蹇驴云外去，仍携稚子雪中行。\n散官不敢将书荐，空解吟诗说姓名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18122,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"回襄阳周奉礼同年因题纸尾","author":"王禹称","text":"武关西畔路巉岩，两月劳君寄两缄。\n镜里想添新白发，箧中犹贮旧青衫。\n扶头酒好无辞醉，缩项鱼多且放馋。\n譬似元和张太祝，十年不改旧官衔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18123,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岁除日同年冯中允携觞见访因而沉醉病酒三日醒而偶题","author":"王禹称","text":"除夜浑疑便白头，携壶相劝醉方休。\n敢辞枕上三朝卧，且免灯前一夕愁。\n薄命我甘离凤阁，多才君亦滞龙楼。\n相逢不尽杯中物，何以支当寂寞州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18124,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岁暮偶书寄苏台旧僚友","author":"王禹称","text":"吴门吏隐过三年，何事陶潜捧诏还。\n步武已趋龙尾道，梦魂犹忆虎丘山。\n花开茂苑谁同醉，雪满梁园独掩关。\n会待他年求郡印，剑池重绕碧潺潺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18125,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岁暮感怀","author":"王禹称","text":"岁暮山城放逐臣，老从霄汉委泥尘。\n公卿别后全无信，兄弟书来祇说贫。\n眼看青山休未得，鬓垂华发摘空频。\n文章气概成何事，沾惹虚名误此身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18126,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岁暮感怀贻冯同年中允 其三","author":"王禹称","text":"谪居京信断，岁暮更凄凉。\n郡僻青山合，官闲白日长。\n烧烟侵寺舍，林雪照街坊。\n为有迁莺侣，诗情不敢忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18127,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岁暮感怀贻冯同年中允 其二","author":"王禹称","text":"岁暮客商山，谪居多昼眠。\n梦回红药树，身落紫微天。\n不得亲公事，如何望俸钱。\n荒城共谁语，除却访同年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18128,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岁暮感怀贻冯同年中允 其一","author":"王禹称","text":"谪宦商于郡，闲门车马稀。\n尘侵书命笔，香散入朝衣。\n烧尽峰峦出，霜晴木叶飞。\n夜来天欲雪，寒梦不成归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18129,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戏和寿州曾秘丞黄黄诗","author":"王禹称","text":"黄黄真是小巫娥，买恐千金价不多。\n别母语娇空有泪，对人声颤未成歌。\n产从南国胜桃李，携去东山隐薜萝。\n滁上老郎无妓女，草玄读易拟如何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18130,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戏题二章述滁州官况寄翰林旧同院 其二","author":"王禹称","text":"要见滁州谪宦情，信缘随俗且营营。\n不誇两制词臣贵，多伴三班奉职行。\n楼堞倚空乘月上，樽罍有酒对山倾。\n升沉得丧何须问，况是浮生已半生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18131,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戏题二章述滁州官况寄翰林旧同院 其一","author":"王禹称","text":"要知滁上兴如何，养拙偷安幸亦多。\n小郡既无衣袄使，丰年兼有裤襦歌。\n公馀处处携山屐，官酝时时泛海螺。\n病眼白头唯醉睡，朝廷好事不闻他。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18132,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"成武县作","author":"王禹称","text":"释褐来成武，初官且自强。\n位卑松在涧，俸薄叶经霜。\n雨菌生书案，饥禽啄印床。\n犹惊写秋卷，槐砌落花黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18133,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"扬州道中感事兼简史馆丁学士","author":"王禹称","text":"淮边为郡再相逢，又得同途赴九重。\n顾我尚骑天厩马，共君遥想鼎湖龙。\n贾生北望朝文帝，白傅何期哭宪宗。\n携手驿桥残照里，断魂空对隔江峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18134,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"有伤","author":"王禹称","text":"壁上时牌催昼夜，案头朝报见存亡。\n悬车又丧司空相，延阁新薨贾侍郎。\n陶铸官资经化笔，品题名姓在文场。\n穗帷一恸无由得，徒洒春风泪数行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18135,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"有怀戚二仲言同年","author":"王禹称","text":"闻说去官常，悽悽返故乡。\n与君同甲子，似我有文章。\n憔悴衣衫绿，蹉跎鬓发苍。\n此身知幸处，曾得紫微郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18136,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵许推官行县道中纪事","author":"王禹称","text":"禾头低映黍头昂，处处沟塍水面凉。\n村路扶携无冻馁，里门嬉戏有丁黄。\n鸡豚入市溪鱼美，梨枣登盘社酒香。\n岁乐田家风景好，待君模写奏明光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18137,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵和丁学士途中偶作","author":"王禹称","text":"淮海丰登接帝畿，家家耕破旧荒陂。\n乳牛引犊精神健，野叟携孙鬓发衰。\n河市妓翻轻茜袖，社筵人插小红旗。\n凭谁画取村田乐，尽使忧民圣主知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18138,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵和史馆丁学士赴阙书怀见示","author":"王禹称","text":"清夜哀吟敌晓鸡，行藏无玷白于圭。\n阳春寡和人传郢，肉味都忘子在齐。\n绝俗文章终远大，循资班列暂卑栖。\n看君更刷鸾皇翼，一举方知燕雀低。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18139,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵和仲咸送池秀才西游","author":"王禹称","text":"夏课诗成又旅游，离离秦树叶惊秋。\n青霄路在何难到，白雪才高岂易酬。\n几处读碑寻野径，共谁沽酒上高楼。\n商于迁客曾如此，系滞空思十二旒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18140,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵和仲咸感怀贻道友 其一","author":"王禹称","text":"莫问穷通事若何，遇花逢酒且狂歌。\n人情易逐炎凉改，官路难防陷阱多。\n只合收心抛世网，不须推命说天罗。\n如今玉石休分别，免被无辜刖卞和。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18141,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵和朗公见赠","author":"王禹称","text":"朗公垂老尚吟诗，曾泛三湘看九疑。\n欲问劳生心扰扰，强酬佳句思迟迟。\n红尘策马殊无味，碧嶂携僧自合宜。\n共待中条山有雪，寺楼吟尽更同谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18142,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"池上作","author":"王禹称","text":"未遂沧洲去，池边弄绿波。\n醉浮船底兀，吟绕履痕多。\n静照新华发，沉思旧钓蓑。\n晚凉得幽趣，鱼戏上圆荷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18143,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自问","author":"王禹称","text":"自问意何如，身穷业有馀。\n卷怀君子道，耽味古人书。\n月给非无酒，晨羞亦有鱼。\n山头刺史宅，未替是吾庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18144,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自宽","author":"王禹称","text":"身世龙钟且自宽，追量才分合饥寒。\n朝中旧友休誇贵，箧里新诗不博官。\n晓发静梳微霰落，夜琴闲拂古风残。\n会须归去沧江上，累石移莎拥钓滩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18145,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自笑","author":"王禹称","text":"年来失职别金銮，身世漂沦鬓发残。\n贫藉俸钱犹典郡，老为郎吏是何官。\n开樽暂喜愁肠破，堆案仍劳病眼看。\n自笑不归田里去，谩将名姓挂朝端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18146,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"芍药诗 其三","author":"王禹称","text":"满院匀开似赤城，帝乡齐点上元灯。\n感伤纶阁多情客，珍重维扬好事僧。\n酌处酒杯深蘸甲，折来花朵细含棱。\n老郎为郡辜朝寄，除却吟诗百不能。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18147,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"芍药诗 其一","author":"王禹称","text":"牡丹落尽正凄凉，红药开时醉一场。\n羽客暗传尸解术，仙家重爇返魂香。\n蜂寻檀口论前事，露湿红英试晓妆。\n曾忝掖垣真旧物，多情应认紫微郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18148,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"芍药诗 其二","author":"王禹称","text":"东君著意占残春，得得迟开亦有因。\n曾与掖垣留故事，又来淮海伴词臣。\n日烧红艳排千朵，风递清香满四邻。\n更爱枝头弄金缕，异时相对掌丝纶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18149,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"迂儒","author":"王禹称","text":"自笑是迂儒，诚宜与世疏。\n左迁犹上疏，薄俸亦抄书。\n漠漠花侵眼，萧萧发映梳。\n唯当早休去，幽处卜吾庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18150,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过鸿沟","author":"王禹称","text":"侯公缓颊太公归，项籍何曾会战机。\n只见鸿沟分两处，不知垓下有重围。\n危桥带雨无人过，败叶随风傍马飞。\n半日垂鞭念前事，露莎霜树映斜晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18151,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初上单州有作","author":"王禹称","text":"旧官休念直承明，就养虽能系宦情。\n蓝绶昔年为短簿，綵衣今日是专城。\n妓人半在登楼看，亲老初来满郡迎。\n慢逐板舆张皂盖，平生唯有此时荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18152,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿孙三日","author":"王禹称","text":"经年病不饮，此日一开樽。\n鉴里休嫌老，怀中已抱孙。\n红绷裁锦段，香水浴银盆。\n他日归田去，相扶入荜门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18153,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"张屯田弄璋三日略不会客戏题短什期以满月开筵","author":"王禹称","text":"布素相知二十年，喜君新咏弄璋篇。\n洗儿已过三朝会，屈客应须满月筵。\n桂子定为前进士，兰芽兼是小屯田。\n至时担酒移厨去，请办笙歌与管弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18154,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"村行","author":"王禹称","text":"马穿山径菊初黄，信马悠悠野兴长。\n万壑有声含晚籁，数峰无语立斜阳。\n棠梨叶落胭脂色，荞麦花开白雪香。\n何事吟馀忽惆怅，村桥原树似吾乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18155,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"花鹿","author":"王禹称","text":"花鹿一何驯，长随病使君。\n必教吾在野，当与尔为群。\n静饮清溪水，闲眠碧洞云。\n犹胜市朝里，逐众走纷纷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18156,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诏知滁州军州事因题二首 其二","author":"王禹称","text":"罢直金銮领一麾，依前憔悴咏江蓠。\n所嗟吾道关消长，岂为微躯系盛衰。\n尚愧临民为父母，终当学稼养妻儿。\n自怜此度辞京阙，犹胜商山副使时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18157,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诏知滁州军州事因题二首 其一","author":"王禹称","text":"晓直银台作侍臣，暮为郎吏入埃尘。\n一生大抵如春梦，三黜何妨似古人。\n不称禁中批紫诏，犹教淮上拥朱轮。\n时清郡小应多暇，感激君恩养病身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18158,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"身世","author":"王禹称","text":"淮边为小郡，身世复何云。\n妻病无医药，儿痴废典坟。\n簪裳看似梦，俸禄薄如云。\n不作归耕计，何阶望致君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18159,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闲居","author":"王禹称","text":"何必问生涯，幽闲度岁华。\n有琴方是乐，无竹不成家。\n吟里销春色，眠中见曙霞。\n今年如未去，更拟种胡麻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18160,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和屯田杨郎中同年留别之什","author":"王禹称","text":"科名长恐辱同年，许国丹诚皎日悬。\n谬掌斯文虽未丧，欲行吾道即无权。\n谢公留滞苍苔院，潘岳征行落叶天。\n引重力轻深自愧，强酬诗什益凄然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18161,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和冯中允仙娥峰","author":"王禹称","text":"熊耳如当出槛熊，仙姿孤秀压诸峰。\n采芝逋客怜贞质，化石佳人妒丽容。\n身上霓衣慵整顿，天边华盖会裁缝。\n嫦娥月里休相笑，万古应无窃药踪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18162,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]