[{"title":"杂兴三首 其一","author":"陆游","text":"鳗井初生一缕云，鲍郎山下雨昏昏。\n橹声呕轧秋空晓，水际人家尚闭门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4843,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂兴十首 其九","author":"陆游","text":"粟无人馈方差快，门有僧敲未绝幽。\n岂是耄荒深绝物，从来不惯惹闲愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4844,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂兴四首 其一","author":"陆游","text":"灰中火如萤，燎原从此始。\n元气一点存，危疾亦不死。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4845,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂兴四首 其二","author":"陆游","text":"尧舜桀纣皆腐骨，王侯蝼蚁同丘墟。\n麦苗覆块鸠唤雨，常恨无人同荷锄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4846,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂兴十首 其十","author":"陆游","text":"瞿聃杨墨宁非学，治狱行兵亦有师。\n惟是儒生知择术，百年穷达守书诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4847,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂兴四首 其四","author":"陆游","text":"铿尔舍瑟作，嚗然放杖笑。\n浩浩太古音，与俗不同调。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4848,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂兴十首 其三","author":"陆游","text":"灵府宁容一物侵，此身只合老山林。\n何由挽得银河水，净洗群生忿欲心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4849,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂兴十首 其六","author":"陆游","text":"砚传百岁玺阙角，笔擅一时锥出囊。\n纸欲穷时瘦蛟举，已看雷雨跨苍茫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4850,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂兴六首 其六","author":"陆游","text":"故交零落形吊影，陈迹凄凉口语心。\n辛苦一生成底事，祈招空解诵愔愔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4851,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂兴六首 其五","author":"陆游","text":"面颜日瘦口眼大，气血顿衰须发狞。\n不用凌烟写冠剑，一蓑烟雨事春耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4852,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂兴六首 其四","author":"陆游","text":"一身逋负愁赊酒，满眼关山悔上楼。\n子细推来惟合睡，五更风雨已如秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4853,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂兴六首 其三","author":"陆游","text":"老无添处仍逢病，春欲残时未减寒。\n架上汉书浑忘尽，床头周易却常看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4854,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂兴六首 其二","author":"陆游","text":"羲和分职授人时，断自唐虞意可知。\n兽舞凤来馀事耳，西成东作要熙熙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4855,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂兴六首 其一","author":"陆游","text":"秦汉区区了目前，周家风化遂无传。\n君看八百年基业，尽在东山七月篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4856,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂咏四首 其四","author":"陆游","text":"世事盛衰谁得知，惠陵烟草掩柴扉。\n陵边人家丛竹里，灯火喧呼迎妇归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4857,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂咏十首 其九","author":"陆游","text":"斜风吹雨晚空濛，独立溪边两鬓蓬。\n便过此生何所恨，百年强半水云中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4858,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂咏十首 其六","author":"陆游","text":"夸士骑牛著铁冠，往来城市拥途观。\n争如老子无奇怪，惟是蓑衣伴钓竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4859,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂咏十首 其十","author":"陆游","text":"病起清臞不自持，纱巾一幅倚筇枝。\n水沉香冷红蕉晚，恰似道山群玉时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4860,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂咏十首 其八","author":"陆游","text":"宦途所至尚偷闲，何况湖边昼掩关。\n未爱好风吹醉袖，且贪微雨养盆山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4861,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂咏十首 其一","author":"陆游","text":"仕困风波归可乐，生如疣赘死何悲。\n极知此手终无巧，那得随人尽作痴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4862,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂咏十首 其二","author":"陆游","text":"镜中颜状年年改，海内交朋日日疏。\n一恸寝门生意尽，从今无复季长书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4863,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂咏四首 其三","author":"陆游","text":"松肪燎火满炉红，罂粟煎汤到手空。\n试问斋居守丹灶，何如醉卧听松风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4864,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂咏四首 其一","author":"陆游","text":"少日狂疏触怒嗔，每缘忧患丧吾真。\n晚收咄咄书空手，却作腾腾任运人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4865,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂咏十首 其四","author":"陆游","text":"一日日穷穷不醒，一年年老老如期。\n黄河却有逢清日，白发应无返黑时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4866,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂咏四首 其四","author":"陆游","text":"旧闻五岳多灵药，晚遇高人得秘文。\n梦境此身常是客，几时归卧华山云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4867,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂咏十首 其三","author":"陆游","text":"女郎花树新移种，官长梅园亦探租。\n作尽人间儿戏事，谁知空橐一钱无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4868,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂咏十首 其五","author":"陆游","text":"世间万事本悠悠，自古诗人易白头。\n莫羡老夫垂九十，一年添得一年愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4869,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂咏园中果子四首 其一","author":"陆游","text":"不酸金橘种初成，无核枇杷接亦生。\n珍产已从幽圃得，浊醪仍就小槽倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4870,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂咏园中果子四首 其三","author":"陆游","text":"架垂马乳收论斛，港种鸡头采满船。\n鼋鼎若为占食指，曲车未用堕馋涎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4871,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂咏园中果子四首 其四","author":"陆游","text":"山杏溪桃本看花，累累成实亦堪誇。\n盐收蜜渍饶风味，送与山僧下夜茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4872,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂咏园中果子四首 其二","author":"陆游","text":"浆石榴随糕作节，蜡樱桃与酪同时。\n两株偶向池边种，可喜今年坠折枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4873,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂赋十二首 其十二","author":"陆游","text":"得雨郊原已遍耕，东家西舍多逢迎。\n前山云起树无影，别浦潮生船有声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4874,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂赋十二首 其八","author":"陆游","text":"梦里曾作南柯守，少时元是东陵侯。\n今朝半醉归草市，指点青帘上酒楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4875,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂赋十二首 其六","author":"陆游","text":"昔人莽莽荒丘里，陈迹纷纷朽简中。\n毕竟是非谁辨得，举杯吾欲问虚空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4876,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂赋十二首 其十一","author":"陆游","text":"齐民让畔不争桑，和气横流岁自穰。\n君看三山百家聚，更无一垄有遗蝗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4877,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂赋十二首 其十","author":"陆游","text":"中年畏病杯行浅，晚岁修真食禁多。\n谢客杜门殊省事，一盂香饭养天和。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4878,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂赋十二首 其四","author":"陆游","text":"出门信步作闲游，野庙村坊到处留。\n每伴樵夫尝半舍，更随牧竖采沿沟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4879,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂赋十二首 其三","author":"陆游","text":"终日才堪米一升，生涯略似草庵僧。\n湿薪不管晨炊晚，留得松肪代夜灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4880,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂赋十二首 其一","author":"陆游","text":"地炉夜热麻䕸暖，瓦釜晨烹豆粥香。\n不是有心轻富贵，从来吾亦爱吾乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4881,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂赋十二首 其九","author":"陆游","text":"七十八十古来稀，行年九十固应衰。\n已兴工部耳聋叹，更和文公齿落诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4882,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂赋十二首 其二","author":"陆游","text":"病叟胸中一物无，梦游信脚到华胥。\n觉来忽见天窗白，短发萧萧起自梳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4883,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂赋十二首 其七","author":"陆游","text":"百亿须弥理固有，八九云梦何足吞。\n天下广居君识否，一间茆屋寄孤村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4884,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂感四首 其三","author":"陆游","text":"平生所闻宋华子，病忘乃与知道邻。\n老夫历尽世间事，始觉此公真可人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4885,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂感十首 其一","author":"陆游","text":"志士山栖恨不深，人知已是负初心。\n不须先说严光辈，直自巢由错到今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4886,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂感四首 其二","author":"陆游","text":"古言忍字似而非，独有痴顽二字奇。\n此是龟堂安乐法，大书铭座更何疑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4887,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂感六首 其一","author":"陆游","text":"鹤乘轩车已堪叹，狐戴髑髅何可亲。\n劝君一笑扫除尽，来作人间百岁人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4888,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂感十首 其九","author":"陆游","text":"故旧书来访死生，时闻剥啄叩柴荆。\n自嗟不及东家老，至死无人识姓名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4889,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂感十首 其五","author":"陆游","text":"世间鱼鸟各飞沉，茅屋青山无古今。\n毕竟替他愁不得，几人虚费一生心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4890,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂感十首 其三","author":"陆游","text":"世事纷纷无已时，劝君杯到不须辞。\n但能烂醉三千日，楚汉兴亡总不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4891,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂感四首 其三","author":"陆游","text":"射的山前花柳新，典衣买酒过残春。\n但甘身作哙等伍，莫信人间髯绝伦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4892,"sha256":"803c6a90ea341892bf