[{"title":"东阿","author":"陈师道","text":"恸哭东阿县，伤心莫与论。\n却思当痛日，敢望此身存。\n举目人将母，回头影吊魂。\n更堪悲手足，孤稚满船门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15841,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"对厅口号","author":"陈师道","text":"黄堂窈窕庆佳辰，密坐雍容合搢绅。\n广乐充庭如在梦，欢声著物似逢春。\n瞻天已祝无穷寿，尽醉为期莫计巡。\n平世难逢身易老，岭梅初破酒方醇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15842,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"归雁二首 其二","author":"陈师道","text":"作计胸怀早，为生去住频。\n固违阴岭雪，不尽洞庭春。\n巧作斜行字，催归去国人。\n知时如有信，决起亦相亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15843,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"归雁二首 其一","author":"陈师道","text":"弧矢千夫志，潇湘万里秋。\n宁为宝筝柱，肯作置书邮。\n远道勤相唤，羁怀误作愁。\n聊宽稻粱意，宁复网罗忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15844,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"甲亭","author":"陈师道","text":"峻壁亭临水，横陂树彻山。\n两河惟甲氏，数柏共苍颜。\n随意游成适，回舟月与还。\n早知乘下泽，不再结青纶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15845,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"立春","author":"陈师道","text":"马蹄残雪未成尘，梅子梢头已著春。\n巧胜向人真奈老，衰颜从俗不宜新。\n高门肯送青丝菜，下里谁思白发人。\n共学少年天下士，独能濡湿辙中鳞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15846,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"立春致语口号","author":"陈师道","text":"霏微腊雪不沾尘，收拾阳和作早春。\n一坐尽倾归盛德，四时难得是佳辰。\n鬓边綵胜年年好，樽下歌声日日新。\n一笑难逢时易失，杯行到手莫辞频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15847,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丞相温公挽词三首 其三","author":"陈师道","text":"少学真成己，中年托著书。\n辍耕扶日月，起废极吹嘘。\n得志宁论晚，成功不愿馀。\n一为天下恸，不敢爱吾庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15848,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丞相温公挽词三首 其二","author":"陈师道","text":"百姓归周老，三年待鲁儒。\n世方随日化，身已要人扶。\n玉几虽来晚，明堂讫授图。\n心知死诸葛，终不羡曹蜍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15849,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丞相温公挽词三首 其一","author":"陈师道","text":"恭默思良弼，诗书正百工。\n事多违谢傅，天遽夺杨公。\n一代风流尽，三师礼数崇。\n若无天下议，美恶并成空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15850,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再到钱塘呈会宗伯益","author":"陈师道","text":"负笈重来感旧游，流年衰鬓两经秋。\n湖山依旧浑相识，风月愁人不自由。\n尚有故交重冷榻，可堪归梦到沧洲。\n谁怜壮志空凋落，百鍊金为绕指柔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15851,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再和寇十一二首 其一","author":"陈师道","text":"南山楼观插穹苍，林杪青灯出上方。\n形胜自如诸老逝，功名随尽二流长。\n马游从昔哀吾老，王粲当年赋异乡。\n少日幻心今净尽，多生绮语未全忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15852,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再和寇十一二首 其二","author":"陈师道","text":"与世相违孰自量，资身无策漫多方。\n逢场作戏真呈拙，误笔成蝇岂所长。\n名字不归青史笔，形容终老白云乡。\n可须五斗轻千里，赖有斯人未肯忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15853,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再酬","author":"陈师道","text":"乡里衣冠不绝人，近天尺五只清门。\n论文正可簪双笔，浇舌行看赐上樽。\n琼玖每蒙先木李，蜩鸠方共笑飞鲲。\n固知贤杰当传世，下里朱陈亦有孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15854,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再赠寇司户","author":"陈师道","text":"仕屈诸儒底，名成一战中。\n酒为千日计，诗费几生功。\n戏马章台下，呼鹰上蔡东。\n少年豪侠窟，杵臼得梁鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15855,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同苏不疑避暑法惠寺","author":"陈师道","text":"酷暑不可处，相将寻昼凉。\n清谈荫广厦，甘寝就匡床。\n莲剥明珠滑，瓜浮绀玉香。\n因知北窗卧，自信出羲皇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15856,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"后湖晚坐","author":"陈师道","text":"水净偏明眼，城荒可当山。\n青林无限意，白鸟有馀闲。\n身致江湖上，名成伯季间。\n目随归雁尽，坐待暮鸦还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15857,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吕吉父使君生日","author":"陈师道","text":"司漏凌晨报晓签，曈曈赫日上重檐。\n良辰也应纯乾策，吉梦先符太卜占。\n棣萼同时升紫禁，棠阴由此驻彤襜。\n一杯欲助邦人祷，愿借黄堂寿斝添。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15858,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"早春","author":"陈师道","text":"度腊不成雪，迎年遽得春。\n冰开还旧渌，鱼喜跃脩鳞。\n柳及年年发，愁随日日新。\n老怀吾自异，不是故违人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15859,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"早起","author":"陈师道","text":"邻鸡接响作三鸣，残点连声杀五更。\n寒气挟霜侵败絮，宾鸿将子度微明。\n有家无食违高枕，百巧千穷只短檠。\n翰墨日疏身日远，世间安得尚虚名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15860,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂题 其二","author":"陈师道","text":"泥雪才通脚，烟云复结阴。\n迟留随处处，帘幕静沉沉。\n去雁怀归意，来禽欲好音。\n稍宽沟壑辱，不惮二毛侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15861,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂题","author":"陈师道","text":"春水涨湖田，先寻沪渎船。\n隔江争问主，入市不论钱。\n味得莼尤滑，香因豉更便。\n它年楝花落，追忆漫流涎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15862,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂题 其一","author":"陈师道","text":"乱水交如线，群山翠作屏。\n寒轻春稍稍，雪尽麦青青。\n霜草犹疑滑，风林渐喜听。\n生涯鞍马上，岁月短长亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15863,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵无斁偶作二首 其二","author":"陈师道","text":"此老三年别，何时万里回。\n更无南去雁，犹见北枝梅。\n会有哀笼鸟，宁须溺死灰。\n圣朝无弃物，与子赋归哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15864,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵无斁偶作二首 其一","author":"陈师道","text":"肩耸三峰峻，眉厖八字横。\n玄谈人绝倒，家法句新清。\n八俊先张子，诸公少贾生。\n已传乌鹊喜，欲听鹡鸰声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15865,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵无斁雪后二首 其二","author":"陈师道","text":"取性无通介，随时有异同。\n雪馀盖地白，春浅著梢红。\n寄食虚长算，论诗阙近功。\n相看不相弃，赖有古人风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15866,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵无斁雪后二首 其一","author":"陈师道","text":"闭閤春云薄，开门夜雪深。\n江梅犹故意，湖雁起归心。\n草润留馀泽，窗明度积阴。\n慇勤报春信，屋角有来禽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15867,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵关子容湖上晚饮","author":"陈师道","text":"风树吹花落四邻，暮云将雨作催人。\n旋倾美酒留连客，急作新诗报答春。\n试傍清湖看鬓发，莫辞行乐费金银。\n如今归去还高卧，更问风光有几旬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15868,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵观月","author":"陈师道","text":"风云随落日，河汉欲回天。\n隔巷如千里，还家已再圆。\n帘疏分细细，江净共娟娟。\n他日吾何适，听诗说去年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15869,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵何子温祈晴二首 其二","author":"陈师道","text":"九虎当关信不传，烧烟才上已回天。\n驱除雾雨还朝日，畜缩涛波复二川。\n夺目光华开秀句，堆场藁秸验丰年。\n从今更上中和颂，少费将军九万笺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15870,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵李节推九日登南山","author":"陈师道","text":"平林广野骑台荒，山寺鸣钟报夕阳。\n人事自生今日意，寒花只作去年香。\n巾攲更觉霜侵鬓，语妙何妨石作肠。\n落木无边江不尽，此身此日更须忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15871,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵杨内翰赠诸进士","author":"陈师道","text":"一官归老岂嘉宾，喜见群材入选抡。\n学变古今人得意，化行梁楚俗还醇。\n士蒙馀勇天同力，诗度清秋物再新。\n勉作功名求善颂，径从平地据通津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15872,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵苏公督两欧阳诗","author":"陈师道","text":"吟声正可候虫鸣，酒面犹须作老兵。\n岂有文章妨要务，孰知诗律自前生。\n向来怀璧真成罪，未必含光不屡惊。\n血指汗颜终缩手，此怀端复向谁倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15873,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵夜雨","author":"陈师道","text":"暗雨来何急，寒房客自醒。\n骤看灯闪闪，拟对竹青青。\n声到江干尽，风回叶上听。\n更长那得晓，攲侧想仪形。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15874,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵春怀","author":"陈师道","text":"欲作归田计，无如二顷何。\n折腰方赖禄，拭面未伤和。\n日下乌声乐，尘生鸟迹多。\n渡头留小楫，乘兴得相过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15875,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵春怀","author":"陈师道","text":"老形已具臂膝痛，春事无多樱笋来。\n败絮不温生虮虱，大杯覆酒著尘埃。\n衰年此日仍为客，旧国当时只废台。\n河岭尚堪供极目，少年为句未须哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15876,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵顺法师十三间楼避暑","author":"陈师道","text":"窗暗时时雨，门开处处山。\n心苏解衣后，愁破立谈间。\n枕簟长相待，功名久不关。\n论文非小陆，愧色满颜间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15877,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵夏日","author":"陈师道","text":"江上双峰一草堂，门闲心静自清凉。\n诗书发冢功名薄，麋鹿同群岁月长。\n句里江山随指顾，舌端幽眇致张皇。\n莫欺九尺须眉白，解醉佳人锦瑟傍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15878,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵夏日江村","author":"陈师道","text":"漏屋檐生菌，临江树作门。\n卷帘通燕子，织竹护鸡孙。\n向夕微凉进，相逢故意存。\n何当加我岁，从子问乾坤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15879,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵晁无斁冬夜见寄","author":"陈师道","text":"寒窗冷砚欲生尘，短枕长衾却自亲。\n老子形骸从薄暮，先生意气尚青春。\n覆杯不待回丹颊，危坐犹能作直身。\n城郭山林两无得，暮年当复几沾巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15880,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵晁无斁春怀","author":"陈师道","text":"城郭朝阳散积阴，郊原注目日青深。\n年衰鸥鹭如今是，梦断邯郸何处寻。\n语鹊飞乌春稍稍，重帘深院晚沉沉。\n不辞杖屦冲泥雪，未有琼琚报好音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15881,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵晁无斁除日述怀","author":"陈师道","text":"世学违从众，名家最近天。\n感时犹壮志，得句起衰年。\n袁酒无何饮，陶琴不具弦。\n平生挥翰手，几见绝韦编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15882,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵寇秀才寄下邳家兄","author":"陈师道","text":"少共千忧老一官，中间毁誉两茫然。\n去留有命真如此，俯仰从人却未然。\n故著江山供极目，正将彊健入新年。\n惊逢小杜风流胜，信有衣冠不乏贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15883,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵萤火","author":"陈师道","text":"年侵观物化，共被岁时催。\n熠熠孤光动，翩翩度水来。\n稍能穿幔入，已复受风回。\n投卷吾衰矣，微吟子壮哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15884,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵黄生","author":"陈师道","text":"入竹投窗夜有声，似违残腊作初正。\n三更爽气侵危坐，万里回风逼发生。\n呵笔小吟撩我老，闭门高卧见君情。\n只今剩作惊人句，颇觉吟边意未平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15885,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵敬酬元弼三兄","author":"陈师道","text":"冥冥雨力及时来，冉冉春光作意回。\n白发尚堪供语笑，青衫不惜著风埃。\n林庐要自家家到，尊酒宁辞日日开。\n只恐未便文字饮，人间无梦到阳台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15886,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵游花洞","author":"陈师道","text":"远洞容徐步，繁英故压枝。\n锦衾堆襞积，春事向离披。\n作意真成误，寻芳似较迟。\n预为来岁约，及早共瑶卮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15887,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"老柏三首 其三","author":"陈师道","text":"岁月那能记，风霜亦饱经。\n槁乾仍故节，润泽出新青。\n色与江波共，声留静夜听。\n辉辉垂重露，点点缀流萤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15888,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"老柏三首 其二","author":"陈师道","text":"英姿带枯槁，劲节阙和柔。\n物理有兴坏，人情成去留。\n稍看栖鸟集，聊待晚风秋。\n解道庭前柏，何曾识赵州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15889,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"老柏三首 其一","author":"陈师道","text":"庭柏无生意，摧残二十秋。\n稍沾杯水润，已与岁寒谋。\n黄里青青出，愁边稍稍瘳。\n会看笙鹤下，暮雀莫深投。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15890,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"行次旧县寄立之","author":"陈师道","text":"岁晚方奔命，春期作过宾。\n逢君为地主，顾我拙谋身。\n官是三年客，情缘一日亲。\n将身随斗食，应作未归人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15891,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西湖","author":"陈师道","text":"小径才容足，寒花只自香。\n官池下凫雁，荒冢上牛羊。\n有子吾甘老，无家去未量。\n三年哦五字，草木借辉光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15892,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过杭留别曹无逸朝奉","author":"陈师道","text":"陈蕃解榻为留连，俯仰徒惊岁月迁。\n故意斯人奈风雨，多情于我独山川。\n可怜颜貌非前日，依旧穷愁似去年。\n后夜相思隔烟水，梦魂空寄过江船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15893,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"住雁","author":"陈师道","text":"断岸通横水，枯荷著早霜。\n一陂堪度岁，数雁不成行。\n市远无缯缴，年丰足稻粱。\n中原有佳气，不必到衡阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15894,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"何太中挽词二首 其二","author":"陈师道","text":"哀挽诸儒竞，丰碑故吏繁。\n素车纷雨泣，丹旐与风翻。\n几地留遗爱，他年作九原。\n涕流耆旧尽，不独为乡园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15895,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"何太中挽词二首 其一","author":"陈师道","text":"课最三川守，名成万石君。\n平生欠一识，声烈即多闻。\n兜率真归处，琴台只断云。\n伤心今夜月，忍便到初坟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15896,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"何复教授以事待理","author":"陈师道","text":"负俗宁能累哲人，昔贤由此致功名。\n骥收盐坂车前足，琴得焦桐爨下声。\n三献荆山时未识，一鸣齐鸟众方惊。\n传闻下诏搜遗逸，劝讲方思用老成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15897,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初到锦城","author":"陈师道","text":"溪绕层峦路绕溪，飞梁相接挂晴霓。\n山川王气今何有，岩谷灵踪昔未跻。\n十里松篁参羽仗，半天楼阁倚云梯。\n胜游欲尽无穷目，未到桃源客已迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15898,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别乡旧","author":"陈师道","text":"数有中年别，宽为满岁期。\n得无鱼口厄，聊复雁门踦。\n齿脱心犹壮，秋清意自悲。\n平时郡文学，邓禹得三为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15899,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别月华严","author":"陈师道","text":"寓世生同里，随方去有情。\n来为百年别，不惜片时程。\n斋钵须勤供，经钟莫倦鸣。\n当来第三会，此界却逢迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15900,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别观音山主","author":"陈师道","text":"离合应生理，过逢岂近缘。\n情亲见今日，语妙记当年。\n闭户安禅主，冲风逆水船。\n不应清夜月，故作别时圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15901,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别负山居士","author":"陈师道","text":"田园相与老，此别意如何。\n更病可无酒，犹寒已自和。\n高名胡未广，诗兴尚能多。\n沙草东山路，犹须一再过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15902,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别叔父录曹","author":"陈师道","text":"为吏专文法，成家托弟昆。\n三年如昨日，一笑更何言。\n扶老须微禄，移官实至恩。\n两疏元父子，何日复东辕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15903,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别叔父昆山丞","author":"陈师道","text":"父子兼知己，扶携共白头。\n又为千里别，未使寸心休。\n鸟雀空庭晓，风霜落木秋。\n近亲零落尽，更觉别离愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15904,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别宝讲主","author":"陈师道","text":"此地相逢晚，他方有胜缘。\n咒功先服猛，戒力得扶颠。\n暂息三支论，重参二老禅。\n夜床鞋脚别，何日著行缠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15905,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别威德寺","author":"陈师道","text":"三宿城隈寺，轻赍类老禅。\n暂来真偶尔，适去更翛然。\n笑别留春坞，行寻下濑船。\n此身犹断梗，飘泊且随缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15906,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别黄徐州","author":"陈师道","text":"姓名曾落荐书中，刻画无盐自不工。\n一日虚声满天下，十年从事得途穷。\n白头未觉功名晚，青眼常蒙今昔同。\n衰疾又为今日别，数行老泪洒西风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15907,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寿安县君挽词","author":"陈师道","text":"两大推平日，三从播后声。\n忧勤登上寿，箫鼓闭佳城。\n缌布千人从，松楸十里行。\n哀荣动邻里，点笔竞诸生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15908,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]