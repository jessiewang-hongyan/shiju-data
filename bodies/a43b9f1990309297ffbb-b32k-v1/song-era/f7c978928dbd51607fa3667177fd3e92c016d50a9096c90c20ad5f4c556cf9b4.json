[{"title":"偈颂四十一首 其十九","author":"释普宁","text":"向上一路滑，壁立千仞险。\n南禅不立阶级，直与当头坐断。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18784,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十一首 其十八","author":"释普宁","text":"出现在扬州，留锡于此地。\n宝塔凌高空，声光动万里。\n利物应群机，如月分众水。\n我来爇瓣香，一瞻一顶礼。\n从教人道自倒还自起。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18785,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十一首 其十七","author":"释普宁","text":"我此门风，孤危不立。\n若是临济儿孙，便请单刀直入。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18786,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十一首 其十六","author":"释普宁","text":"拆东篱，补西壁。\n从空架空，以楔出楔。\n佗时耸壑昂霄，须信不劳馀力。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18787,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十一首 其二十七","author":"释普宁","text":"直下犹通信班会，寻言转更赊。\n若言佛与祖，特地隔天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18788,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十一首 其十四","author":"释普宁","text":"拄杖子，化为龙。\n拿云攫雾，妙应难穷。\n霈然洪霔，四海皆通。\n五谷结实，万物归功。\n鼓腹讴歌忘世事，太阳依旧海门东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18789,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十一首 其十三","author":"释普宁","text":"我有一句子，不封亦不树。\n不在舌头边，亦非思忆处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18790,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十一首 其十二","author":"释普宁","text":"顽处非常放软顽，偏能陆地要撑船。\n蓦然撑向龙门去，踪迹不知往那边。\n几多望断空惆怅，亦复嗟叹泪潸然，安得鸾胶续断弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18791,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十一首 其十一","author":"释普宁","text":"拄杖子，无偏党。\n遍界不曾藏，通身无影像。\n妖怪尽剿除，佛魔俱扫荡。\n普天皇道无遮障。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18792,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十一首 其十","author":"释普宁","text":"诸方安居结制，灵岩结制安居。\n虽是一般规矩，于中大有差殊。\n赵州东壁挂葫芦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18793,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十一首 其九","author":"释普宁","text":"寒食清明节，家家拜扫时。\n木人空叹息，石女泪双垂。\n惟有林下道人，绝学无为。\n百不会，百不知。\n拈起少林无孔笛，逆风吹了顺风吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18794,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十一首 其八","author":"释普宁","text":"没弦琴，指趣深。\n尖新曲调，须遇知音。\n高山流水无穷意，落落断崖千万寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18795,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十一首 其七","author":"释普宁","text":"目前无法，意在目前。\n东西十万，南北八千。\n达磨不来东土，二祖不往西天。\n点检将来，只见一边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18796,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十一首 其六","author":"释普宁","text":"一夏九十日，不觉已过半。\n管带牯牛儿，切忌随物转。\n紧把鼻头索，莫放令宽缓。\n如是十二时，时时无间断。\n收得纯熟，斥之不去。\n受人言语，不动不变。\n觌面当机，当机觌面。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18797,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十一首 其五","author":"释普宁","text":"荷叶团团团似镜，菱角尖尖尖似锥。\n风吹柳絮毛毬走，雨打梨花蛱蝶飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18798,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十一首 其四","author":"释普宁","text":"披野干皮，作狮子吼。\n指东为西，将无作有，惊起法身藏北斗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18799,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十一首 其二","author":"释普宁","text":"坐断千差，当阳烜赫。\n任是须弥灯王，也须望空斫额。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18800,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十一首 其一","author":"释普宁","text":"迷悟两门，圣凡二路。\n总与诸人开辟了也，普请一时證入。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18801,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寒山拾得赞","author":"释普宁","text":"指东画西，眼笑眉垂。\n心似秋月，发如乱丝。\n吟句不成句，题诗不是诗。\n丰干轻饶舌，败缺一时知。\n善哉苦哉，敢称七佛之师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18802,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"普化赞","author":"释普宁","text":"踢倒饭床，特地乖张。\n指空话空，撤颠撤狂。\n木槌拈来换人眼，赢得恶声满大唐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18803,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"最明寺殿契悟说付法偈","author":"释普宁","text":"我无佛法一字说，子亦无心无所得。\n无说无得无心中，释迦亲见燃灯佛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18804,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"最明梦一善知识教训坚固参禅醒后亲绘供养越两年值老僧到先来参礼果与梦见一同契悟后捧呈所画顶相求赞","author":"释普宁","text":"千煅万炼工夫熟，感得梦见善知识。\n力劝加工用行修，果获契悟心满足。\n自彰丑恶自涂糊，佛祖仰望俱失色。\n老僧更与添一重，急急如律令敕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18805,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渡江达磨赞","author":"释普宁","text":"道个不识，自生荆棘。\n曈曈渡江，忍羞面壁。\n赖有神光与雪屈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18806,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"樗寮字阿弥陀经书偈送最明寺殿","author":"释普宁","text":"我有大经卷，量等三千界。\n亲付最明殿，祝寿如沧海。\n但愿得此经，当下明此心。\n的知胡达磨，元不在少林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18807,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宏海侍者请赞","author":"释普宁","text":"这川䖃苴，全不仁者。\n握起老拳，佛祖也怕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18808,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十一首 其十一","author":"释普宁","text":"向上一路，千圣不传。\n等闲踏著，不直半钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18809,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"最明寺殿真像赞","author":"释普宁","text":"掌持国土，天下安堵。\n信向佛法，运心坚固。\n德重丘山，名播寰宇。\n清白传家，望隆今古。\n参透吾宗，眼眉卓竖。\n末后一机，超佛越祖。\n汝辜负吾，吾辜负汝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18810,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大义渡","author":"释普岩","text":"孩儿不见弃浑身，可惜婆婆眼不亲。\n白浪洪波无了日，至今愁杀渡头人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18811,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大藏主号镜中","author":"释普岩","text":"孤光不堕有无间，碧落冲开万象寒。\n扑破果然亡朕迹，从教大地黑漫漫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18812,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄太白幸首座","author":"释普岩","text":"粪火堆头潦倒身，且无花鸟闹芳春。\n口边白醭心如铁，甘作丛林不义人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18813,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送洪维那","author":"释普岩","text":"笑把虚空一口吞，髑髅瞥转振乾坤。\n破沙盆有儿孙在，玉笛横吹出海门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18814,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送僧见孟侍郎","author":"释普岩","text":"三秋月冷半山云，来谒维摩必有因。\n特见岭梅开一朵，也应知道不干春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18815,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"乘禅者归蜀","author":"释普岩","text":"出剑门兮入剑门，眼空寰宇一闲身。\n杖挑一滴江南水，散作西川劫外春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18816,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十首 其十","author":"释普岩","text":"如是如何正法眼，蓦然突出破沙盆。\n依稀渭北春天树，彷佛江东日暮云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18817,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十首 其九","author":"释普岩","text":"洗肠换骨老芭蕉，拄杖拈来价转高。\n卖与买人人不买，翻令平地起波涛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18818,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十首 其八","author":"释普岩","text":"等闲提起七斤衫，多少禅和著意参。\n尽向青州做窠窟，不知春色在江南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18819,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十首 其七","author":"释普岩","text":"百骸一物贞薰天，风起今朝病一般。\n酷恨双双医不得，枕边空听雁声寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18820,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十首 其六","author":"释普岩","text":"搽抔抹粉没人猜，五百生中与么来。\n觌体风流有多少，不知何处可安排。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18821,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十首 其五","author":"释普岩","text":"洗钵家家事一同，新罗不在海门东。\n因行掉臂赵州老，身在烟萝第几重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18822,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十首 其四","author":"释普岩","text":"铁壁银山几万重，有无之字若为通。\n斩关岂在搴旗手，枉有虚名落汉中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18823,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十首 其三","author":"释普岩","text":"月淡江空泛小舟，唱歌和月看江流。\n更深攲枕梦何处，两峰清霜晓未收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18824,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十首 其二","author":"释普岩","text":"抬头霹雳不容追，缺齿胡僧陷铁围。\n六合空空风悄悄，杜鹃啼月不如归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18825,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十首 其一","author":"释普岩","text":"自谓五更侵早起，谁知更有夜行人。\n条风块雨今非昔，尧舜垂衣万国宾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18826,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十五首 其七","author":"释普岩","text":"此香堪笑又堪悲，刚把愁肠说向谁。\n冶父山前曾落节，千钧之重一毫釐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18827,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题戢庵居士竹亭","author":"释普岩","text":"疏疏绿叶起清风，屈指巡檐数不穷。\n幽致果然难比况，此君未必在其中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18828,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自赞 其二","author":"释普岩","text":"妙在转处，密在汝边。\n绘予面目，正中乖偏。\n踏翻却谢郎船。\n不拨万象，火冷灰寒。\n我有丰子分，谁道不完全。\n十分狼藉难收拾，微风吹动碧琅玕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18829,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"布袋和尚赞","author":"释普岩","text":"山月未出，海云忽飘。\n瞑目而坐，归路迢迢。\n布袋里头无长物，许谁胡蝶梦溪桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18830,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"百丈大师赞","author":"释普岩","text":"亲见马簸箕，面目甚奇怪。\n鼻痛野鸭飞，漆桶好不快。\n只见祥麟一角尖，定知罪犯弥天大。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18831,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自赞 其一","author":"释普岩","text":"断杨岐正脉，灭临济纲宗。\n猿啼碧嶂，月锁千峰。\n影落于阗国，人在大辽东。\n应缘淡泊，无分从容。\n谓是运庵真面目，澄潭不许卧苍龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18832,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观音大士赞","author":"释普岩","text":"草木丘陵，风雷云气。\n具足妙相尊，證入三摩地。\n万象森罗从鼎沸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18833,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"达磨大师赞","author":"释普岩","text":"苇航身险，风急水寒。\n九年面壁，用尽心肝。\n大唐人不识只履过西天，单传直指待驴年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18834,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"济颠书记赞","author":"释普岩","text":"毁不得，赞不得，天台出得个般僧，一似青天轰霹雳。\n走京城，无处觅。\n业识忙忙，风流则剧。\n末后筋斗背翻，煅出水连天碧。\n稽首济颠，不识不识。\n狭路相逢捻鼻头，也是普州人送贼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18835,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十五首 其二十五","author":"释普岩","text":"项短耳聩，千妖百怪。\n如是三十年，续东山正脉。\n我也错商量，三拜一炉香，一任傍人说短长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18836,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十五首 其二十四","author":"释普岩","text":"四年承乏云峰寺，暗写秋肠寄阿谁。\n每到十一月初五，一狐疑了一狐疑。\n故我开山伏虎禅师，指柳骂杨，伤龟恕鳖，你死我活。\n莫说一碗粗茶一炷香，也胜和盲㪍诉瞎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18837,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十五首 其二十三","author":"释普岩","text":"老洞山玷辱宗风，泰首座埋没自己。\n双双绣出鸳鸯，千古扶持不起。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18838,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十五首 其二十二","author":"释普岩","text":"老讷今朝死，老岩今日生。\n二俱无伎俩，有梦不同床。\n夤缘继踵，香火荒凉。\n肝肠铁作也须裂，骊屎如何比麝香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18839,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十五首 其二十一","author":"释普岩","text":"断杨歧正脉，坏临济纲宗。\n赤土涂牛奶，密室不通风。\n身前身后不了，深瘗白云之中。\n非父非子，狭路相逢。\n涧藻溪蘋相钝置，谢郎错认钓鱼船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18840,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十五首 其二十","author":"释普岩","text":"显慈鼻祖，诺庵法兄。\n机如电掣，辩似河倾。\n无心相撞著，分外得人憎。\n彼此不堪为种草，先师之道转竛竮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18841,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十五首 其十九","author":"释普岩","text":"一叶落，天下秋。\n一尘起，大地收。\n临济掌黄檗，南泉唤赵州。\n开口不在舌头上，夜涛催发海南舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18842,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十五首 其十八","author":"释普岩","text":"季春渐暄，鸟啼花笑。\n恒沙数见闻觉知，悉皆了了。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18843,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十五首 其十七","author":"释普岩","text":"一阳生也，树头惊起双双鱼，石上迸出长长笋。\n即日伏惟两序，高人现前清众。\n履兹长至，倍膺戬谷。\n喝一喝，俗气未除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18844,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十五首 其十六","author":"释普岩","text":"洞门无钥，剑阁崔嵬。\n风露高寒，且非人世。\n是则是，天上人间知几几。\n者僧一问不将来，黄檗通身是泥水。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18845,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十五首 其十四","author":"释普岩","text":"毒攻毒，楔出楔。\n老曹山，不识别。\n那里是者僧吃酒处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18846,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十五首 其十三","author":"释普岩","text":"故人方外来，相见便相悉。\n倒指三十年，道义同一日。\n铁壁银山，十分狼藉。\n直得同声相应，同气相求，西河师子在汾州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18847,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十五首 其十二","author":"释普岩","text":"近之不逊，远之则怨。\n无义无情，可贵可贱。\n一年一度雪深冤，毕竟无人是的传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18848,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十五首 其十一","author":"释普岩","text":"归来出去，迦叶贫，阿难富。\n出去归来，南天台，北五台。\n目前包裹，满面尘埃。\n禹力不到处，河声流向西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18849,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十五首 其十","author":"释普岩","text":"入院数日来，人事闹鬨鬨。\n两脚走如烟，眼不见鼻孔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18850,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十五首 其九","author":"释普岩","text":"风云合匝，龙虎交驰。\n一进一退，各适其宜。\n丛林烜赫，慧命流辉。\n寿丘面皮厚多少，惟许通方作者知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18851,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十五首 其八","author":"释普岩","text":"离四句，绝百非。\n清寥寥，白滴滴。\n直透万重关，不住青霄外。\n千手大悲提不起，烁迦罗眼莫能窥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18852,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十五首 其四","author":"释普岩","text":"马头回，牛头没。\n一字入公门，九牛曳不出。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18853,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十五首 其二","author":"释普岩","text":"出现扬州，坐断寿丘。\n脚跟不点地，赢得一身愁，不是冤家不聚头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18854,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十五首 其一","author":"释普岩","text":"豁开户牖，直出直入。\n鲇鱼上竹竿，俊鹘趁不及。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18855,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄天目礼书记闽回","author":"释普岩","text":"爪牙消息露三山，勘破曾郎想不难。\n一啸归来千嶂晓，于菟不似旧时斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18856,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十五首 其十五","author":"释普岩","text":"令不虚行，箭不虚发。\n傥或踌躇，二九十八。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18857,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]