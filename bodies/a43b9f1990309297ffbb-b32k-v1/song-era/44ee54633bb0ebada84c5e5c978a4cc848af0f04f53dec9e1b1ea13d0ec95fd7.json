[{"title":"社日小饮二首 其二","author":"陆游","text":"社雨霏霏湿杏花，农家分喜到州家。\n苍鹅戏处塘初满，黄犊归时日欲斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5158,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"社日小饮","author":"陆游","text":"人生当惜老年时，醉插山花压帽攲。\n世事恰如风过耳，微聋自好不须治。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5159,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"系舟二首 其二","author":"陆游","text":"地旷月明铺素练，霜寒河浅拂轻绡。\n手扶万里天坛杖，夜过前村禹会桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5160,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"系舟二首 其一","author":"陆游","text":"系舟江浦待潮平，叹息无人共月明。\n历尽世间多少事，飘然依旧老书生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5161,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"纵笔四首 其三","author":"陆游","text":"背上嵯峨两肉山，明驼有债自须还。\n玉霄峰头雪色鹿，清晓一声烟雨间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5162,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"纵笔四首 其四","author":"陆游","text":"素月徘徊牛斗间，天风吹鹤度函关。\n一年似此佳时少，唤起陈抟醉华山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5163,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"纵笔四首 其二","author":"陆游","text":"一纸除书到海边，紫皇赐号武夷仙。\n功名敢道浑无意，暂作闲人五百年