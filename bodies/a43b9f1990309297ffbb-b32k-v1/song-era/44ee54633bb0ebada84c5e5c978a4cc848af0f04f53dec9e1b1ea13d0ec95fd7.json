fe5294295f79689","path":"宋_2.csv","pointer":5170,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"纵笔二首 其二","author":"陆游","text":"百尺松根结茯苓，千年长养似人形。\n谁知金鼎烹初熟，恰直山翁醉欲醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5171,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"纵游深山随所遇记之四首 其一","author":"陆游","text":"行穿荦确度谽谺，路跨清溪一木斜。\n历尽艰危到平地，坏垣攲屋两三家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5172,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"纵游深山随所遇记之四首 其二","author":"陆游","text":"山径攲危细栈通，孤村小店夕阳红。\n竹郎有庙临江际，木客无家住箐中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5173,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"纵游深山随所遇记之四首 其四","author":"陆游","text":"古寺萧萧不见僧，飞鼪满屋老枭鸣。\n空房终夜无灯火，断木支门睡到明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5174,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"纵游深山随所遇记之四首 其三","author":"陆游","text":"道逢山客束荆薪，口眼睢盱略似人。\n试问村名瞠不语，剨然长啸上嶙峋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5175,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"纸阁午睡二首 其一","author":"陆游","text":"纸阁砖炉火一杴，断香欲出碍蒲帘。\n放翁不管人间事，睡味无穷似蜜甜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5176,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"纸阁午睡二首 其二","author":"陆游","text":"黄紬被暖青毡稳，纸阁油窗晚更妍。\n一饱无营睡终日，自疑身在结绳前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5177,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"纸墨皆渐竭戏作","author":"陆游","text":"官库谁能饷陟釐，汉宫无复赐隃麋。\n不如扫尽书生事，闲伴儿童竹马嬉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5178,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蔬园杂咏五首 其二 芜菁","author":"陆游","text":"往日芜菁不到吴，如今幽圃手亲锄。\n凭谁为向曹瞒道，彻底无能合种蔬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5179,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"花下小酌二首 其一","author":"陆游","text":"柳色初深燕子回，猩红千点海棠开。\n鲚鱼莼菜随宜具，也是花前一醉来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5180,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"花下小酌二首 其二","author":"陆游","text":"云开太华插遥空，我是山中采药翁。\n何日胡尘扫除尽，敷溪道上醉春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5181,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"花时遍游诸家园十首 其二","author":"陆游","text":"为爱名花抵死狂，只愁风日损红芳。\n绿章夜奏通明殿，乞借春阴护海棠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5182,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"花时遍游诸家园十首 其四","author":"陆游","text":"花阴扫地置清尊，烂醉归时夜已分。\n欲睡未成攲倦枕，轮囷帐底见红云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5183,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"花时遍游诸家园十首 其六","author":"陆游","text":"枝上猩猩血未晞，尊前红袖醉成围。\n应须直到三更看，画烛如椽为发辉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5184,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"花时遍游诸家园十首 其九","author":"陆游","text":"飞花尽逐五更风，不照先生社酒中。\n输与新来双燕子，衔泥犹得带残红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5185,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"花时遍游诸家园十首 其五","author":"陆游","text":"宣华无树著啼莺，惟有摩诃春水生。\n故老能言当日事，直将宫锦裹宫城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5186,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"花时遍游诸家园十首 其一","author":"陆游","text":"看花南陌复东阡，晓露初乾日正妍。\n走马碧鸡坊里去，市人唤作海棠颠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5187,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"花时遍游诸家园十首 其三","author":"陆游","text":"翩翩马上帽檐斜，尽日寻春不到家。\n偏爱张园好风景，半天高柳卧溪花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5188,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"花时遍游诸家园十首 其八","author":"陆游","text":"丝丝红萼弄春柔，不似疏梅只惯愁。\n常恐夜寒花索寞，锦茵银烛按凉州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5189,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"花时遍游诸家园十首 其十","author":"陆游","text":"海棠已过不成春，丝竹凄凉锁暗尘。\n眼看燕脂吹作雪，不须零落始愁人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5190,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"迎诏书","author":"陆游","text":"忆瞻銮仗省门前，扇影鞭声下九天。\n寂寞嘉州迎诏处，忽闻鼓吹却悽然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5191,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"迓益帅马上作","author":"陆游","text":"马上遥看江上山，白云红树画图间。\n经年簿领无休日，却向忙中得少闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5192,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"还舍","author":"陆游","text":"剩欲衔杯乐太平，新愁还续旧愁生。\n出门始觉春来早，处处帘栊笑语声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5193,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"连日云兴气浊雨意欲成西南风辄大作比夜月明如昼","author":"陆游","text":"鸠自呼鸣蚓自歌，何时甘澍一滂沱。\n封姨漫妒阳台梦，却付长空与素娥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5194,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"连日风雨寒甚夜忽大风明旦遂晴","author":"陆游","text":"万里浮云一扫空，碧天无际日曈昽。\n欢声四起春风里，恰似祥符景德中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5195,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"连日暴下薾然不支戏作","author":"陆游","text":"老子心如行脚僧，秋风久已办行縢。\n纸衾夜夜江湖梦，小复迟留待判惩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5196,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"邻人送菰菜","author":"陆游","text":"张苍饮乳元难学，绮季餐芝未免饥。\n稻饭似珠菰似玉，老农此味有谁知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5197,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"邻曲有未饭被追入郭者悯然有作","author":"陆游","text":"舂得香粳摘绿葵，县符急急不容炊。\n君王日御金华殿，谁诵周家七月诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5198,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闰月三夜舍西观新月","author":"陆游","text":"平生绝爱初三月，况是平池浸玉钩。\n老去人间朋旧少，一樽谁与话清愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5199,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲中自咏二首 其一","author":"陆游","text":"小艇上时皆绿水，短筇到处即青山。\n二十四考中书令，不换先生半日闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5200,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲中自咏二首 其二","author":"陆游","text":"声名本自不关身，富贵元知与祸邻。\n但恨平生闲不足，再来真作卧云人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5201,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲吟","author":"陆游","text":"闲吟可是治愁药，一展吴笺万事忘。\n不惜暮年酬倡绝，犹能作意答秋光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5202,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲咏园中草木六首 其五","author":"陆游","text":"日高未办续晨炊，一碗村醅且疗饥。\n盘箸索然君勿笑，桑间紫椹正累累。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5203,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲咏园中草木六首 其二","author":"陆游","text":"麝香萱草移东郭，锦子葵花买上原。\n儿唤乃翁闲一看，欣然曳杖出篱门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5204,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲咏园中草木六首 其四","author":"陆游","text":"绿侵小径蟆衣草，青络疏篱鬼带藤。\n未暇开编寻本草，且将名品问山僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5205,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲咏园中草木六首 其六","author":"陆游","text":"仲夏园中百草灵，风吹露坼各青青。\n劝君办取金鸦觜，不问昌阳与豨苓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5206,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲咏园中草木六首 其一","author":"陆游","text":"剪刀叶畔戏鱼回，帔子花头舞蝶来。\n领略年光属闲客，一樽自劝不须推。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5207,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲居七首 其六","author":"陆游","text":"生计淡无味，终焉乐有馀。\n灌畦亲抱瓮，种秫学拈锄。\n择木翔归鸟，临渊聚戏鱼。\n地偏心更远，靖节爱吾庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5208,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲居七首 其三","author":"陆游","text":"厨给胡麻粒，山供鹿脯盘。\n扫门迟客至，入郭借书看。\n种竹添风韵，留松老岁寒。\n一生无别事，鸡犬恋刘安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5209,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲居七首 其一","author":"陆游","text":"小隐轻华屋，深山自结茅。\n乱苔侵石磴，疏竹映花梢。\n泉濑含清韵，风来慰淡交。\n闭门烧柏子，好把道书抄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5210,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲居七首 其七","author":"陆游","text":"剪叶霜风劲，关门谢远游。\n深村梅映雪，前浦水明楼。\n蜜熟蜂衙放，膻残蚁阵收。\n地炉无兽炭，炙背补衣裘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5211,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲居七首 其五","author":"陆游","text":"野水明窗几，通渠绕屋流。\n鹭冲烟织素，鱼避月沉钩。\n草闹蚊虻市，林昏蝙蝠秋。\n开怀觉清旷，万象入冥搜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5212,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲居七首 其二","author":"陆游","text":"溪透桃源路，门连小华峰。\n虹霓横水槛，羽盖偃岩松。\n日月诗魂迥，烟霞道气浓。\n欲寻钟吕去，世外说从容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5213,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲游三首 其二","author":"陆游","text":"溪桥偶与僧游话，草市来寻逆旅炊。\n自笑一生为客惯，捉驴小竖诉朝饥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5214,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲游三首 其一","author":"陆游","text":"江边小市旧经过，岁月真如东逝波。\n茶灶酒垆多识面，少留卖药买渔蓑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5215,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲游三首 其三","author":"陆游","text":"祓除情累烟波上，放荡胸怀诗酒中。\n禹会桥边潮落处，夕阳几度系孤篷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5216,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲游二首 其二","author":"陆游","text":"好事湖边卖酒家，杖头钱尽惯曾赊。\n垆边烂醉眠经日，开过红薇一架花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5217,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"感兴二首 其一","author":"陆游","text":"少小遇丧乱，妄意忧元元。\n忍饥卧空山，著书十万言。\n贼亮负函贷，江北烟尘昏。\n奏记本兵府，大事得具论。\n请治故臣罪，深绝衰乱根。\n言疏卒见弃，袂有血泪痕。\n尔来十五年，残虏尚游魂。\n遗民沦左衽，何由雪烦冤。\n我发日益白，病骸宁久存。\n常恐先狗马，不见清中原。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5218,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲游二首 其一","author":"陆游","text":"一见溪山病眼开，青鞋处处蹋苍苔。\n平生长物扫除尽，犹带笔床茶灶来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5219,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"阿姥","author":"陆游","text":"城南倒社下湖忙，阿姥龙钟七十强。\n犹有尘埃嫁时镜，东涂西抹不成妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5220,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"阿通自闽中归甫九岁颇有老成之风作此诗示之","author":"陆游","text":"通子还家已九龄，从师衿佩两青青。\n长成勉作功名计，勿学衰翁老一经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5221,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陈少监饷澄清堂酒","author":"陆游","text":"酣畅年来岂易逢，齑汤蜜汁亦时中。\n玉醅忽逐春风至，一吸悬知百榼空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5222,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陈伯予见过喜予强健戏作","author":"陆游","text":"寒无毡坐甑生尘，此老年来乃尔贫。\n两颊如丹君会否，胸中原自有阳春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5223,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"饭罢碾茶戏书","author":"陆游","text":"江风吹雨暗衡门，手碾新茶破睡昏。\n小饼戏龙供玉食，今年也到浣花村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5224,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"饮村店夜归二首 其二","author":"陆游","text":"滟滟村醪君勿辞，橙椒香美白鹅肥。\n醉中忘却身今老，戏逐萤光蹋雨归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5225,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"饮村店夜归二首 其一","author":"陆游","text":"致主初心陋汉唐，暮年身世落农桑。\n草烟牛迹西山外，又卧旗亭送夕阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5226,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"饮村酒","author":"陆游","text":"湘浦骚人咏啜漓，黄州饮湿又增奇。\n纷纷坐客评清浊，我已昏然睡不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5227,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鸡犬二首 其一","author":"陆游","text":"乡村年久竞农务，秋敛春耕恐失时。\n我老元无夙兴事，懒鸡啼晓恰相宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5228,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鸡犬二首 其二","author":"陆游","text":"贫家也复谨朝昏，小犬今年乞近村。\n糠秕无多深愧汝，狺狺终夜护篱门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5229,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"龟堂东窗戏弄笔墨偶得绝句五首 其四","author":"陆游","text":"老衰有验诗先退，勋业无心梦渐稀。\n浅浦小山孤绝处，数家烟火自相依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5230,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"龟堂东窗戏弄笔墨偶得绝句五首 其二","author":"陆游","text":"一樽且复罄幽欢，不是痴顽强自宽。\n死去何忧累儿子，千钱可买市成棺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5231,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"龟堂东窗戏弄笔墨偶得绝句五首 其一","author":"陆游","text":"身如蚕老已三眠，一茧何妨自裹缠。\n豆饭藜羹支永日，槿篱竹屋送馀年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5232,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"龟堂东窗戏弄笔墨偶得绝句五首 其五","author":"陆游","text":"老人孤寂似无家，午枕初回日已斜。\n偶得风和身亦健，舍南舍北探梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5233,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"龟堂东窗戏弄笔墨偶得绝句五首 其三","author":"陆游","text":"北庵睡起坐东厢，无事方知日月长。\n天与诗人送诗本，一双黄蝶弄秋光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5234,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]