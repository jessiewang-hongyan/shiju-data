[{"title":"望崖上遗构","author":"韦骧","text":"万仞苍崖耸碧空，谁为危室撼云中。\n双扉虚辟无人到，疑是飞仙逞妙工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46801,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"四十八渡","author":"韦骧","text":"山盘水转路岐开，揭厉凡经六八回。\n若向芳春桃盛发，几何非自武陵来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46802,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送刘公仪典四明","author":"韦骧","text":"人间离合固寻常，契义稠重岂易忘。\n崇政青春同擢第，文昌白首并为郎。\n东城判袂情怀惨，南国分符兴味长。\n唯伫来风慰瞻望，治声当不减龚黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46803,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和何子温郎中家园一首","author":"韦骧","text":"江河清兴渺无边，又睹新诗忆故园。\n仙爪虽欣搔痒背，布音还愧过雷门。\n祇闻松石誇朋旧，应免纷华遗子孙。\n何日幅巾陪燕坐，共将风月快吟魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46804,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自峡之夔过竹竿山","author":"韦骧","text":"行路始知难，覆盆千石间。\n为逃人鲊瓮，敢惮竹竿山。\n晚日群峰碧，春风两鬓班。\n何时似都护，还度玉门关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46805,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答宋茂宗诗卷","author":"韦骧","text":"夔府春残暂息肩，感君佳遗意飘然。\n顿忘巇崄三千路，为得风骚五十篇。\n山水清音归老笔，球琳秀气满新编。\n虽无健句酬来贶，终日吟哦兴自全。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46806,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿云安云岩寺","author":"韦骧","text":"去国三千里，携家四十程。\n云岩暂投宿，聊使梦魂清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46807,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨中观白莲一首","author":"韦骧","text":"终日飘零酷暑平，白莲池上独含情。\n已怜瑩洁添花色，更爱淋浪打叶声。\n宫女洗妆馀粉泽，水仙攲弁濯琼瑛。\n漫携玉盏衔冰酒，气味须教一等清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46808,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读潘阆再过钱塘一绝","author":"韦骧","text":"昔年潘阆足诗情，曾过钱塘眼暂明。\n今日天涯闻此句，无穷乡思逐江声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46809,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和答韩循之送行诗","author":"韦骧","text":"归隐无田计未成，区区叱驭又遄征。\n自惭白首犹尸禄，何补清时漫远行。\n谈麈追思挥玉色，送篇珍重发金声。\n欲知天末相望处，云水苍茫白帝城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46810,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和答刘子先舍人送行诗","author":"韦骧","text":"梯险航深岐路赊，国恩未报敢咨嗟。\n感公秀句浑惊俗，送我孤踪远使巴。\n民讼稀疏几吏隐，官居岑寂似山家。\n举头霄汉思贤躅，聊和来篇示拜嘉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46811,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"明恕斋","author":"韦骧","text":"明恕题标榜，心随目所瞻。\n平反长在念，燕适自无嫌。\n山气清朝幌，江光射昼檐。\n几何非吏隐，危坐兴难厌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46812,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中秋夜待月不见一首","author":"韦骧","text":"中秋待月异寻常，桂魄如何特晦藏。\n疑是天心忌盈满，故将云影蔽辉光。\n徬徨注目瞻霄汉，冷落呼灯照豆觞。\n须记今宵有馀恨，明年此会莫轻忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46813,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄明守刘公仪","author":"韦骧","text":"去年更直宿文昌，今日暌违各一方。\n遐想四明安坐府，肯思三峡险乘航。\n恨无羽翼亲谈席，应有笙歌簇燕堂。\n旧好未宜因远废，邮筒时且寄篇章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46814,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九日","author":"韦骧","text":"重九萧条秋已深，登高更在蜀江浔。\n黄花未肯趁时吐，白酒祇如常日斟。\n绝塞烟云长满目，故园风物愈关心。\n须凭酩酊酬佳节，追感齐山不浪吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46815,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿缙云僧舍一首","author":"韦骧","text":"石磴跻攀上缙云，九峰苍翠与天邻。\n岩崖佛屋疑神助，烟霭禅扃绝世尘。\n此日乘轺宿寒夜，他年屈指数青春。\n山僧莫笑匆匆去，寻胜能来有几人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46816,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过温汤寺一绝","author":"韦骧","text":"一窦飞泉煖似汤，池鱼无数自洋洋。\n不须绕寺寻碑刻，知是南平古道场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46817,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"武龙道中","author":"韦骧","text":"四十年前前进士，三千里外外官人。\n手提邦宪平冤抑，敢不公心报大钧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46818,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"放船一首","author":"韦骧","text":"峥嵘岁垂尽，泛鹢下岷江。\n鸣橹风声壮，摇旌日影双。\n巨滩何累累，急鼓促韸韸。\n语疾躯生翼，论危颈缩腔。\n栖迟凭漆几，睥睨近纱窗。\n解缆侵朝雾，休程傍晚矼。\n童山连岌岌，古木竞摐摐。\n岑绝行荒县，间关按列邦。\n俗书慵注目，薄酒倦开缸。\n仙迹徒追羡，名篇乃素降。\n有谁陪亹亹，竟夕听淙淙。\n幽兴将诗遣，还嗟语意厖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46819,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"正月二日饮茂宗官舍一首","author":"韦骧","text":"然灯数百照青樽，香穗萦回酒半醺。\n却怪预为元夕态，撩人乡思乱纷纷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46820,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏八仙 撚鼻","author":"韦骧","text":"道气本冲融，胡为撚鼻中。\n知无愿言嚏，聊以快吾衷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46821,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏八仙 爬背","author":"韦骧","text":"刻成纤手利，痒背可施功。\n岂待麻姑爪，携持意自通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46822,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏八仙 呵欠","author":"韦骧","text":"引手如双翼，俄然一欠伸。\n须臾端顾盼，别是好精神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46823,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏八仙 栉发","author":"韦骧","text":"搔首意不满，聊凭象栉功。\n高情唯自适，岂恤鬓如蓬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46824,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏八仙 鼓琴","author":"韦骧","text":"万事不关心，悠悠在一琴。\n非山亦非水，何必问知音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46825,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏八仙 吹箫","author":"韦骧","text":"内乐本无声，吹箫且任情。\n于兹代长啸，自是一般清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46826,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏八仙 横笛","author":"韦骧","text":"不是乐繁音，吹扬兴自深。\n数杯醇酎罢，更学水龙吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46827,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏八仙 撚耳","author":"韦骧","text":"撚耳意阳阳，林泉白昼长。\n市朝声自远，聪听又何妨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46828,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"丁承受放目亭一首","author":"韦骧","text":"择地为亭智思全，飞甍如翼插苍烟。\n身栖一哄喧声外，目逆千山秀色边。\n腊雪春葩饶映带，峡云江月每流连。\n所嗟此境藏夔府，不入当年子美篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46829,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"人日太宁道中一首","author":"韦骧","text":"改年三日立青春，涉七风光日日新。\n列岫渐生千霭媚，幽禽初弄小声匀。\n篮舆度岭官兵汗，红旆穿林野雉驯。\n白发自怜犹远使，何时归棹浙江滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46830,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"白帝祠一绝","author":"韦骧","text":"瞿塘峡口江声急，古木阴中白帝祠。\n犹有馀灵凭险阻，往来舟楫祷安危。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46831,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"奉节道中望群山有雪","author":"韦骧","text":"腊去春来只数朝，远山残雪未全消。\n昆冈玉出清光瑩，沧海潮横白浪遥。\n天外画图终日展，云端仙佩许谁邀。\n长途极目添幽兴，更折寒梅渡野桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46832,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和刘公仪见寄","author":"韦骧","text":"崎岖巴峡走单车，潇洒鄞江想载旟。\n驰款比追前日好，开缄忽奉去年书。\n篇章互及情皆见，踪迹相暌义不疏。\n但使鳞鸿勿虚过，何须临纸恨踌躇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46833,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"忠州木莲花二绝 其一","author":"韦骧","text":"乔木开花似水莲，画图远自昔人传。\n化工既许殊凡品，落在遐方亦可怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46834,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"忠州木莲花二绝 其二","author":"韦骧","text":"绿叶枝头灼烁红，尚疑轻易比芙蓉。\n根苗不自污泥出，只合移栽近佛宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46835,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄明守刘公仪","author":"韦骧","text":"海角天涯相去遥，邮筒还往势迢迢。\n两篇佳咏兼金重，三复长吟万虑销。\n已向宦途惊聚散，休将桂籍论荣彫。\n承誇倒载清欢数，使我流涎乡思摇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46836,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"摆绣鸡 其一","author":"韦骧","text":"异质本难驯，金笼摆绣频。\n文华真出类，舒卷速如神。\n怒角双枝翠，垂緌九叶新。\n燕堂春昼永，注目屡逡巡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46837,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"摆绣鸡 其二","author":"韦骧","text":"一片垂丹臆，鲜明锦不如。\n殷红间深翠，半敛又全舒。\n未遇夺真画，犹虚博物书。\n虽非孔鸾比，傥可诧其馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46838,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戏答宋茂宗","author":"韦骧","text":"穿山君蹈险，逆浪我乘危。\n玉事以勤济，人生少暇时。\n多材看腾踔，无补愧衰迟。\n巳饱殊乡味，何烦觉后知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46839,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄李世美","author":"韦骧","text":"都门执别再经春，相望天涯引脰频。\n峡外山川愁倦翼，江西风月羡怡神。\n来书虽阔情还密，旧咏重窥意似新。\n聊寄短篇追往好，莫缘无雁便因循。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46840,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送宋茂宗","author":"韦骧","text":"三年持节使巴夔，今日飘然受代归。\n去棹勇争江水急，前旌遥趁峡云飞。\n陟明伫听跻华贯，荣觐应欣著綵衣。\n肯记天涯留咏处，翠岩幽洞亦几稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46841,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渝南九日","author":"韦骧","text":"草草开筵重九日，区区奉使第三年。\n黄花不肯趁时节，薄酒可堪无管弦。\n秋雨岷山犹涨水，夕阳巴峤自生烟。\n登高兴味空惆怅，万里乡关在目前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46842,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南陵坡","author":"韦骧","text":"南陵坡对巫山县，直上青冥百八盘。\n此日身由岁巡到，他年愁向画图看。\n可堪雨湿羊肠险，更怯风冲狐腋寒。\n却想九天朝谒罢，禁街平稳跃金鞍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46843,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"金山","author":"韦骧","text":"金山目逆路之隅，峭壁奇峰画不如。\n若使峥嵘近京雒，未应声价减南徐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46844,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"瘦驴岭","author":"韦骧","text":"马瘏前咏闵驰驱，登岭今朝歉瘦驴。\n自是老来情味减，欲图靡盬可安居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46845,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"石榻平望七峰山","author":"韦骧","text":"路过黔江石榻平，七峰奇杰翠峥嵘。\n祇应自有神仙宅，肯向人间浪得名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46846,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿木宗驿","author":"韦骧","text":"暮投荒驿傍岩隈，更柝声频梦易回。\n半夜忽惊飞霰急，凌晨还喜冻云开。\n雪凝山表平如截，梅发林坳迥若堆。\n问俗观风何所补，勤劳唯有马虺隤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46847,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"二月","author":"韦骧","text":"二月渝南春已老，西园桃李顿萧然。\n傍檐飞絮纷如雪，贴水圆荷大似钱。\n览物未能忘感概，纾情聊且缀诗篇。\n冯郎白发知多少，更向巴山听杜鹃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46848,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"邻垣","author":"韦骧","text":"官路蹉跎晚景斜，更堪踪迹在天涯。\n江春已老犹寒色，山雨相仍减物华。\n留滞唯知搔白首，衰疲何可泥丹砂。\n无聊情思翻成喜，喜见邻垣架上花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46849,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寿安县君挽词一首","author":"韦骧","text":"乡党推贤懿，宗姻慕孝慈。\n享年非及耄，造物固难知。\n神护铭旌远，龟从葬宅宜。\n幽冥复何恨，夫子映清时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46850,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和张从道 二月","author":"韦骧","text":"天气融融近禁烟，巴渝风俗自熙然。\n排门沽酒易成市，著处看花不用钱。\n一带江山入图画，几番云雨促诗篇。\n独嗟久使无裨补，终日归心趁杜鹃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46851,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和张从道 邻垣","author":"韦骧","text":"官舍相依吾二家，碧山之麓水之涯。\n祇知閒暇交谈屑，不觉逡巡改岁华。\n坐喜良农得麰麦，行闻异俗贡毡砂。\n衔杯且尽兵厨酿，安用呼儿索五花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46852,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和唐韦相国盛山十二咏 其一 宿云亭","author":"韦骧","text":"无心固无恋，犹爱宿危檐。\n况复寻幽客，高情岂易厌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46853,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和唐韦相国盛山十二咏 其二 隐月岫","author":"韦骧","text":"隐月月非隐，岫名诚强名。\n清光中夜满，谁谓碍峥嵘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46854,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和唐韦相国盛山十二咏 其三 茶岭","author":"韦骧","text":"种茶当岭上，日近地先春。\n始自钧陶手，遗芳及后人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46855,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和唐韦相国盛山十二咏 其四 梅溪","author":"韦骧","text":"清影笼寒水，幽香逐晚风。\n和羹人已远，溪上自芳丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46856,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和唐韦相国盛山十二咏 其五 流杯渠","author":"韦骧","text":"渠湾水流速，杯漾酒行迟。\n莫诮经营巧，清欢得所施。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46857,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和唐韦相国盛山十二咏 其六 盘石磴","author":"韦骧","text":"盘石以为磴，萦纡上翠岑。\n披云瞩佳境，适此慰登临。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46858,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和唐韦相国盛山十二咏 其七 桃坞","author":"韦骧","text":"当日桃花坞，多应效武陵。\n春风今寂寞，犹以旧名称。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46859,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和唐韦相国盛山十二咏 其八 竹岩","author":"韦骧","text":"栉密翠婵娟，结根岩石前。\n不饶尘土地，自信雪霜天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46860,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和唐韦相国盛山十二咏 其九 琵琶台","author":"韦骧","text":"象物名台势，琵琶出自然。\n登临得真趣，所乐类无弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46861,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和唐韦相国盛山十二咏 其十 胡芦沼","author":"韦骧","text":"沼有胡芦状，成非疏凿功。\n霄澄星月影，彷佛似壶中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46862,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和唐韦相国盛山十二咏 其十一 绣衣石榻","author":"韦骧","text":"绣衣无已久，石榻尚依然。\n不识寻山客，几人能爱贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46863,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和唐韦相国盛山十二咏 其十二 上士瓶泉","author":"韦骧","text":"上士体虚无，瓶泉与道俱。\n倘馀涓滴润，可救众焦枯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46864,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清远阁","author":"韦骧","text":"屹然虚阁并莲宫，似出尘寰扰扰中。\n浩荡乾坤来爽气，峥嵘栏楯倚晴空。\n江奔吴楚流何急，山接岷峨望不穷。\n清远榜题真有意，登临聊以裕吾衷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46865,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"横翠亭","author":"韦骧","text":"胜概本天成，增营智亦精。\n何年丹槛敞，终日碧山横。\n青霭飘来薄，澄江泻去明。\n官居况相迩，杖屦不胜情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46866,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九日","author":"韦骧","text":"四逢九日峡江湄，窃禄无功祇自嗤。\n把酒又迟今岁菊，开编还愧去年诗。\n牛山悽感何其昧，蓝水欢吟乃所宜。\n白发不辞吹帽落，更登山阁醉佳时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46867,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答王晋叔","author":"韦骧","text":"区区行役临南浦，忽奉来书墨未乾。\n见报新恩移亳社，便疑衰迹近长安。\n山危水恶行将免，宦思乡情日渐宽。\n朝夕放船来就别，赠言应许遗琅玕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46868,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"遇黄志仁","author":"韦骧","text":"舟楫逢迎涪水滨，久违应讶鬓霜新。\n按廉虽共相望阔，邂逅于斯两喜钧。\n对舣晴沙旗影动，交谈寒夜烛花春。\n迟明又向东西去，回首沧江雾色匀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46869,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"别张从道","author":"韦骧","text":"官居相并日相过，盈岁光阴不觉多。\n每幸开心互询度，都忘倦迹久蹉跎。\n新除忽遂东归欲，雅好其如远别何。\n把酒不辞金盏溢，预将离索就消磨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46870,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"别王叔重","author":"韦骧","text":"区区奉使越三年，晚得渝南刺史贤。\n美政日闻行旧学，高怀时见发新篇。\n近违方得挥谈麈，远别俄惊彻祖筵。\n回首寒江初放鹢，牙城隐隐隔云烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46871,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]