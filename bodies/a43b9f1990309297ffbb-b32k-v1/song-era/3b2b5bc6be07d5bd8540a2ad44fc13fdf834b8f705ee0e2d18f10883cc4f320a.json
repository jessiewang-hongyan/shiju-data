[{"title":"寄湖州刁殿丞","author":"赵湘","text":"白蘋溪湛五亭寒，物象全宜谢守閒。\n秋尽棋声过竹寺，雨馀诗思落茶山。\n鸟依高树和烟宿，人钓清流带月还。\n池馆有情多入梦，近来谁在笛声间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46812,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄新安梁殿丞","author":"赵湘","text":"郡孤诗句许秋供，见说多閒却似慵。\n移树好禽来独院，上楼高雪在诸峰。\n泉当月际摇吟影，藓自云边得屣踪。\n此兴未寻频挂梦，阮公池馆旧相容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46813,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"望云岩","author":"赵湘","text":"不见寒山子，寒岩日欲曛。\n无人到深处，众木隐孤云。\n水照秋痕尽，霞明晚翠分。\n孤猿啼亦在，谁向此中闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46814,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"萧山李宰君北亭即事","author":"赵湘","text":"扫洒仍闻属意劳，绕池生藓不生蒿。\n敲花雨过琴弦润，吹竹风来鹤语高。\n窗里树光清著枕，砚中山色冷趋毫。\n何人可作题诗伴，试茗应思谢法曹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46815,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"野步","author":"赵湘","text":"原野宜秋步，支筇日欲斜。\n断桥时立鸟，疏草露行蛇。\n细雨沾梨叶，微风过稻花。\n坡西又吹笛，烟火两三家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46816,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"黄莺","author":"赵湘","text":"黄金类羽翰，飞出雪晴山。\n语晓他禽默，啼花别树閒。\n微阳疑独照，急管偶相关。\n红杏园林阔，经时得往还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46817,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游石桥寺","author":"赵湘","text":"陶令寻山胜境开，偶陪清赏忆天台。\n秋云尽放诸峰出，野水时闻独鸟来。\n岩畔坐宜窥蟋蟀，树边行亦避莓苔。\n斜阳石上题诗去，更向松阴绕一回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46818,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游烂柯山","author":"赵湘","text":"仙人与王质，相会偶多时。\n落日千年事，空山一局棋。\n树高明月在，风动白云移。\n未得酬身计，閒来学采芝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46819,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登天竺灵隐寺上方","author":"赵湘","text":"寺高傅绝顶，一到即忘机。\n夜月逢僧早，秋云出树微。\n磬边岩狖过，窗外海雕飞。\n欲下莓苔磴，题名却惜归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46820,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登扬州孝先寺佛阁","author":"赵湘","text":"胜寺登危阁，凭栏即近雕。\n无云生北固，看日下南朝。\n木落吴山迥，天晴楚水遥。\n从容万虑息，目喜赴僧招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46821,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登杭州冷泉亭","author":"赵湘","text":"天竺峰西月几层，亭孤应忌俗人登。\n山光晓射闻猿客，泉影秋摇倚树僧。\n微雨洒台青有点，片云生石冷多棱。\n斜阳更起题诗兴，还喜重来或未能。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46822,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登高","author":"赵湘","text":"天晴九月九，秋思搅腾腾。\n大醉无人会，高山独自登。\n看鸿时背水，采菊阻寻僧。\n往事还堪忆，狂吟罢未能。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46823,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登程主簿南亭","author":"赵湘","text":"南溪亭蔽月，主簿好看云。\n暇日曾移树，炎风尽带薰。\n四窗山曲入，一径草微分。\n买石清流底，名贤待赠君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46824,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答徐本","author":"赵湘","text":"天远草离离，秋霖寄信迟。\n相思逢叶尽，独坐听蝉悲。\n岳色寒前见，松心雪后知。\n频招犹未至，时复检清辞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46825,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"辇下送沈天锡","author":"赵湘","text":"未第逢花尽，残阳照渡头。\n入关频值雨，归棹独随鸥。\n树暗藏鸣鸟，山空接漫流。\n琴书不同去，犹在酒家楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46826,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新定旅馆中作","author":"赵湘","text":"岁月乡关外，溪山螟色中。\n孤城秋闭雨，独客夜闻鸿。\n病使新髭出，贫令旧业空。\n思归不得梦，攲枕近梧桐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46827,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"照上人山房庭树","author":"赵湘","text":"惹云非手植，自与薜萝交。\n雨过苔侵影，秋来月照巢。\n锡寒枝上挂，偈好叶中抄。\n谁见僧行绕，烟凉夜磬敲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46828,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"僧院苔","author":"赵湘","text":"香销人寂寂，铺碧断尘埃。\n积雨声初尽，高僧定未开。\n冷痕穿竹去，秋阵隔泉回。\n此处应长在，閒人况不来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46829,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"暮春郊园雨霁","author":"赵湘","text":"郊园春已暮，霁色射疏篱。\n地静苔过竹，沙清树入池。\n野人来尽日，山鸟话多时。\n偶傍松窗立，微风动七丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46830,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题包山人拄杖","author":"赵湘","text":"倚云生处绝尘埃，见说嵩高客寄来。\n扶醉未闻和屐到，伴吟曾是探山回。\n寻僧过竹青敲月，看鹤沿池冷卓苔。\n知渡寒溪偏得力，夕阳风紧打冰开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46831,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题石桥寺山井","author":"赵湘","text":"何年凿藓纹，寒气触僧魂。\n穴在青松底，泉通白石根。\n汲因尝茗客，窥有断肠猿。\n偶向秋来照，吟髭雪露痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46832,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题张处士山庭落叶","author":"赵湘","text":"摇落拂残棋，萧骚傍菊篱。\n砚浮窗外影，人拾树中诗。\n扫绿粘苔冷，烧红煮茗迟。\n巢乌还有意，犹在月明枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46833,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠水墨峦上人","author":"赵湘","text":"讲馀精小笔，深院竹脩脩。\n试墨因磨雨，思山忽写秋。\n静曾穷鹤趣，高亦近诗流。\n更拟缘清思，和云状沃洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46834,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠何明府","author":"赵湘","text":"陶家宜寂寞，多醉复多才。\n锁印秋山入，移琴夜雨来。\n试茶还扫叶，买树亦和苔。\n妙句邻僧乞，仍闻得药回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46835,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠省安上人","author":"赵湘","text":"闭门栖古寺，尘路杳无踪。\n夜讲香飘月，晨斋磬入松。\n石屏泉气冷，山屐藓痕浓。\n自说秋来兴，时时梦远峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46836,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠潜溪李明府","author":"赵湘","text":"县幽多水石，栽竹亦成畦。\n听雨公田近，开窗月岳齐。\n宿禽无别语，病马立閒蹄。\n夜坐闻清唱，何人钓月溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46837,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"翻经台","author":"赵湘","text":"胜事如飞去不还，无人更立白云间。\n西风落尽贝多叶，明月自来天竺山。\n岩桂影寒泉暗滴，玉炉香减藓空斑。\n孤猿亦有斜阳恨，莫道三声是等闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46838,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄梁鼎殿丞十二韵","author":"赵湘","text":"忆昔初投刺，秋风八咏边。\n偶参知好日，一见自多年。\n吏散公堂雨，帘垂馆树烟。\n共吟曾试茗，同坐或闻蝉。\n渡水寻支遁，登山学地仙。\n献酬多奥妙，谈笑屡迁延。\n夜月侵诗卷，寒灯落酒船。\n醉容韦带去，卧许石床连。\n池馆今何远，汀洲思倍牵。\n庾楼知有约，颜巷奈多缘。\n病眼随蓬断，愁心逐旆悬。\n高台聊一望，芳草夕阳天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46839,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄霅川刁殿丞十二韵","author":"赵湘","text":"柳浑曾吟郡，中间遇牧之。\n留连皆往日，寂寞偶多时。\n物象应无改，轩车自有期。\n忆山辞阙早，采药上官迟。\n泽国閒堪赏，公堂静好窥。\n扫苔红叶过，临水白蘋移。\n树石秋供画，汀洲晓入诗。\n讴谣渔父得，孤洁鹭鸶知。\n笛外风含酒，楼中月照棋。\n野田耕带雨，寒井汲和澌。\n城郭烟霞近，人家橘柚垂。\n会须寻此景，况与二公宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46840,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日松林寺登高","author":"赵湘","text":"九日松林寺，登高过石桥。\n野僧怜不醉，山菊笑无憀。\n屐齿凭泉漱，云衣近树飘。\n自知清静意，应免俗人招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46841,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"天台思古","author":"杨杰","text":"游人行尽天台路，仙家杳杳知何处。\n唯有山前一派溪，落花依旧流春暮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46842,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自乐","author":"赵湘","text":"自乐原西趣，疏林入户清。\n洗池秋得月，移菊夜栖萤。\n古意怜琴淡，新题喜病醒。\n时闻岳僧至，閒讲煮茶经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46843,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"官舍偶书","author":"赵湘","text":"病枕方行药，公门似隐居。\n孤烟寄庭木，微雨长秋蔬。\n宦薄惭骑马，山高梦结庐。\n期僧仍未至，慵写与人书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46844,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夫人阁四首 其四","author":"韩维","text":"宫娃拂晓已催班，拜谢春幡列御前。\n不待东风报花信，红酥綵缕斗芳妍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46845,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送李先辈罢官之四明","author":"赵湘","text":"官满鹤衣轻，全家在四明。\n上船秋月白，到岸海山青。\n药妙初痊病，诗高旧振名。\n遥思落帆处，太守出郊迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46846,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送僧归终南","author":"赵湘","text":"夏满辞京寺，终南路有松。\n月高缘白阁，叶尽到中峰。\n漱齿泉飘锡，冥心露滴钟。\n长安如不去，期与鹿相逢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46847,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"桐江晚望","author":"赵湘","text":"叠浪浸天青，离愁望处生。\n雨馀孤岛暝，花落一船横。\n岸远红兰湿，鱼狂白鸟惊。\n无人问行客，山寺莫钟声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46848,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题国清寺","author":"赵湘","text":"物外千年寺，人间四绝名。\n两廊诸岳色，九里乱松声。\n海气飘僧院，秋钟彻县城。\n夜来疏磬断，月影遍楼清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46849,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠兰江鞠明府","author":"赵湘","text":"笛里声飘柳色寒，县斋深在白云间。\n孤吟夜倚琴边月，半醉秋登宅后山。\n烟径树清苔藓长，雨塘人散鹭鸶还。\n兰舟有客题诗望，溪上家家晚唱阑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46850,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠张处士","author":"赵湘","text":"应问秋云学得閒，飘然如不在人间。\n青藤箧里诗多怪，紫栗枝边药更瘢。\n江客对棋曾赌鹤，野僧分屐借登山。\n仍闻昨日来城市，又抱孤琴踏月还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46851,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"圣号雅二篇 其七","author":"赵湘","text":"皇宅斯道，汗汗浩浩。\n贤俊茀茀，钟鼓考考。\n爰煦尔赤，爰妥其老。\n乐只万国，宁德攸宝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46852,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"圣号雅二篇 其一","author":"赵湘","text":"天监王德，莫如宋赫。\n宋道平平，莫如法天。\n皇法昊天，覆罔攸私。\n达乎鬼方，化被孔时。\n维戬维禄，维生维育。\n被彼虫鱼，及尔草木。\n惟命克遂，于其有俶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46853,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"圣号雅二篇 其三","author":"赵湘","text":"皇实法之，配道无作。\n始则以宽，终靡庸度。\n呜呼下民，亦孔之莫。\n皇鉴下土，将安将乐。\n皇视四方，匪丑匪恶。\n法尔天永，民祷斯恪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46854,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"圣号雅二篇 其二","author":"赵湘","text":"皇振厥猷，法天以宁。\n我法我度，我经我营。\n或风或雨，或雷或霆。\n日月昭然，奋皇之明。\n霜肃以平，露泽以清。\n左右百辟，烂兮敷星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46855,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"圣号雅二篇 其四","author":"赵湘","text":"赫赫君道，皇其崇之。\n遹彼丕教，皇实基之。\n维基伊何，实以无为。\n海隅苍生，被服熙熙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46856,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"圣号雅二篇 其五","author":"赵湘","text":"天下既平，狄人既庭。\n其棘匪劳，神圣以宁。\n无乱斯聪，无惑斯明。\n衣裳自垂，冕旒是凝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46857,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"圣号雅二篇 其八","author":"赵湘","text":"皇道靡彻，载昭载晰。\n克彼有截，万国是悦。\n皇矣圣朝，绵尔瓜瓞。\n是崇是洁，万世贻厥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46858,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"圣号雅二篇 其六","author":"赵湘","text":"烝哉皇极，道靡有息。\n勤勤以谟，罔视其迹。\n凿饮自鼓，耕食自绩。\n维相以歌，勿荷后辟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46859,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宋颂","author":"赵湘","text":"九区混茫，皇天锡皇。\n羲教农化，勋纪华彰。\n继华于禹，承禹于汤。\n比于文武，逮其成康。\n圣道攸传，富寿无疆。\n隋之弃仁，天命不常。\n歼厥侈毒，祚归巨唐。\n唐孙复昏，荡于四方。\n民瘼其咨，逾于怀襄。\n草创中间，崩析滋章。\n割山裂川，国为披猖。\n氓不堪命，神恫其殃。\n俾宋有图，横弛竖张。\n日月五辰，齐其启光。\n实维太祖，肇基建邦。\n有若有苗，逆命弗祥。\n爰整其师，赫怒斯扬。\n荆舒既贡，南海趋跄。\n庸蜀微卢，虽险无当。\n惟尔曰夏，毒靡有流，民始克昌。\n屡饥而馔，久渴而浆。\n冰极授衣，暑烦降凉。\n洎我圣君，传叶振芳。\n圣神仁明，浩浩汪汪。\n吴人来王，并汾慑降。\n服不以戎，鼓罔其镗。\n风雨攸暨，如禽集翔。\n淳复天人，礼修夏商。\n前正后直，左贤右良。\n忠正并驱，回邪局藏。\n鳏恤寡矜，寇屏宄亡。\n药蒸石黎，法衡度量。\n乃宅孝悌，乃谨序庠。\n衣帛食肉，罔有攸伤。\n关讥匪艰，什一靡庞。\n虽有罟网，不罹污潢。\n虽有山林，不乱斧斨。\n虽有权衡，民不以强。\n虽有郛郭，民不以防。\n宗庙既清，郊社甚庄。\n品物争瑞，史载交相。\n未诰俗化，将时合苍。\n盈耳四海，但闻洋洋。\n其雍其熙，无施无为。\n乾坤法之，治于垂衣。\n蒙彼蚩蚩，不觉不知。\n天下一致，夫何虑思。\n清之净之，平之泰之。\n倏变于道，殊途同归。\n伟焉厥图，本蕃益枝。\n百世之后，实流其奇。\n史官既良，康哉具书。\n古有吉甫，为宣王诗。\n是故臣湘，作夫颂辞。\n圣德形容，神明告兹。\n狂斐恐慑，少颂史遗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46860,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送驾部刘侯赴阙诗","author":"赵湘","text":"帝有天命，四方是宣。\n祥有时数，元极则传。\n爱物在皇，恶盈在天。\n惟彼庐墟，安宁有年。\n土沃无蠹，民骄且专。\n穷侈勿度，宄猾相肩。\n彼孽既盈，厥兆斯绵。\n天子眷之，丞相竦然。\n佥曰畴当，刘侯其贤。\n帝命钦哉，布教甚玄。\n俭以示之，信以布之。\n侈焉猾焉，禁之制之。\n惟公拳拳，是民咨咨。\n惟民未知，其恶去迟。\n公恐公惧，吾知天时。\n将及弗度，明年果饥。\n雨师不顾，其岁莫支。\n回禄仍怒，公豫其知。\n虽凶虽燄，弗祷弗祈。\n厥民既羸，爰求其私。\n始恻天变，相议而辞。\n公始俭我，我莫肯随。\n公始廉我，谓公启威。\n公实爱我，而莫之知。\n洎禀公教，里闾相师。\n易侈以俭，猾庸悔追。\n逮夫次岁，百物咸宜。\n雨奋于毕，火藏于离。\n民歌且谣，四郊怡怡。\n教民肃祗，功德流滋。\n史臣弗遗，后世是资。\n孝绩未彰，徵于帝畿。\n腹心肾肠，帝将布其。\n民之怀仁，亦孔之微。\n公不我留，赍咨涕洟。\n来既云暮，去惟是思。\n湘采民谣，播于声诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46861,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其一","author":"赵湘","text":"十度花残一觉眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46862,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题汪水云诗卷","author":"赵焱","text":"山城拄笏意如何，孤鹤东来态度殊。\n天上阳春归阆苑，人间贵客在仙都。\n当年化蝶非真梦，今日骑鲸即故吾。\n莫操钱塘怀古曲，遗黎有泪洒江湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46863,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"密老","author":"赵琥","text":"匹马飘然似转蓬，一年两度过湘东。\n襟裾润带黄梅雨，枕簟凉生若楝风。\n急急穷途将底用，区区苟禄有何功。\n输他燕坐长厅老，点对浓香丈室中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46864,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题冲真观","author":"赵琥","text":"琳馆绝埃尘，溪山是四邻。\n烟霞千古色，花木一庭春。\n月白琴声朗，风清鹤唳频。\n閒中时复醉，应笑市朝人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46865,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别友","author":"赵琥","text":"斜风细雨酿轻寒，握手相看话别难。\n有酒莫辞今日醉，凤仪门外即阳关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46866,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题喜鹊栖树","author":"赵琥","text":"梳翎刷羽立高柯，不落人间小网罗。\n一点通灵良不谬，檐头报我喜还多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46867,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄林可山","author":"赵琨夫","text":"好春虚度三之一，满架荼蘼取次开。\n有客相看无可设，数枝带雨摘将来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46868,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十月见菊","author":"赵葵","text":"落拓山园载酒来，江梅含雪倚春台。\n黄花无藉秋光老，犹自离披带雨开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46869,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上元","author":"赵葵","text":"翡翠帘开舞袖轻，寒星万点下蓬瀛。\n清尊对月酌不已，也向蓬窗坐到明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46870,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寺 其二","author":"赵葵","text":"溪绕青山山绕溪，溪山胜处只僧知。\n云闲古木禅关静，不到禅关又几时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46871,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江行","author":"赵葵","text":"霜清月冷雁声秋，今古江流不尽愁。\n风捲芦花漫雪里，夜深鼓棹落汀洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46872,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"竹 其一","author":"赵葵","text":"一抹轻烟隔小桥，新篁摇翠两三梢。\n惜春不觉归来晚，花压重门带月敲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46873,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舟 其一","author":"赵葵","text":"雨过平芜带落晖，芦花飘泊点征衣。\n舟人忽报东风急，万斛龙骧喷雪飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46874,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"芍药","author":"赵葵","text":"芍药殿春春几许，帘幕风轻飞絮舞。\n昨宵酒醉玉楼春，一声画角吹残雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46875,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过小浆市","author":"赵葵","text":"人生南北与东西，几度云山几度溪。\n我亦欲归归未得，子规从此不须啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46876,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]