[{"title":"挽韩侍郎夫人范郡君 其二","author":"刘攽","text":"夫尊因受郡，子贵亦通朝。\n象服违偕老，幽宫不复朝。\n长川空滚滚，落叶自飘飘。\n哀挽青郊道，悲风送大招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40627,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西戎","author":"刘攽","text":"旄头占虏候，鸣镝射单于。\n哀死知明主，和亲愧腐儒。\n边锋少南牧，天马自东趋。\n看撤山西戍，无劳议远图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40628,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晚过西湖","author":"刘攽","text":"落日微雨好，浮云近水多。\n空濛乱林树，涵泳著星河。\n赏极兴不尽，迹归心更过。\n犹须明月夜，濯足弄金波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40629,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"泛舟西湖 其一","author":"刘攽","text":"靡亹蘋萍合，夤缘岛屿深。\n操舟非有术，鉴水会清心。\n老树成重盖，初荷散万簪。\n名园皆有主，费日试幽寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40630,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"泛舟西湖 其二","author":"刘攽","text":"懒意适自强，旧游疑触新。\n如从剡溪客，忽晤武陵人。\n钟磬高低寺，渔樵来去津。\n凉风水云合，天半是鱼鳞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40631,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"郑侍郎挽词 其一","author":"刘攽","text":"置驿无留客，名卿拟上公。\n应惟泣遗爱，竞欲颂宽中。\n赐履灵台隔，开阡梦泽空。\n秋音送归旐，依约认樵风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40632,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"郑侍郎挽词 其二","author":"刘攽","text":"治狱馀阴德，哀矜出片言。\n千金无重比，驷马见高门。\n星落林乌暝，愁悲薤露喧。\n江风伤远目，楚些一招魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40633,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送张六入浙东","author":"刘攽","text":"君侯曾一仕，已作弃官归。\n又欲过吴市，还愁脱赐衣。\n春风解冰雪，泽国尽芳菲。\n相望不可及，孤云天外飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40634,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上清宫花木自夏及秋相续","author":"刘攽","text":"信此神仙地，经时玩物华。\n残红未零落，暗紫续矜夸。\n扫石分文绣，开林碎晚霞。\n秋风兰菊茂，此去有黄花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40635,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"将去上清宫题梧桐","author":"刘攽","text":"旧日见春华，圆阴羽盖斜。\n野轩何必扫，小径故从遮。\n秋气先摧叶，春风别有花。\n野夫心好静，异日到山家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40636,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九日","author":"刘攽","text":"九日秋萧瑟，登高亦少欢。\n黄花宜澹泊，碧树早凋残。\n醉舞乌纱落，弹歌短剑寒。\n可怜西北望，白日远长安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40637,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九日寄江北兄弟","author":"刘攽","text":"登高虽有兴，羁旅亦消魂。\n插鬓茱萸细，题诗蟋蟀喧。\n黄花一樽酒，斜日最高原。\n回首江天迥，翩翩塞雁翻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40638,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"张比部景真挽诗 其一","author":"刘攽","text":"埋轮负壮志，持节向炎墟。\n反户惊殊俗，彤襜岂定居。\n跕鸢愁瘴雾，断雁哭来书。\n天理真冥漠，谁能问太虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40639,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"张比部景真挽诗 其二","author":"刘攽","text":"五岭瘴疠地，宦游前事存。\n求为勾漏令，卧念少游言。\n夫子独不返，壮心谁复论。\n凄凉大招赋，不见入修门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40640,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"苏度支挽诗 其一","author":"刘攽","text":"翰墨兼能事，功名自壮图。\n云霄曾几许，意气即通衢。\n埋玉情何已，修文理不诬。\n敢忘徐稚礼，絮酒望江湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40641,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"苏度支挽诗 其二","author":"刘攽","text":"前年伯鸾死，卜葬近要离。\n今日延陵墓，仍书季子碑。\n人琴俱已矣，林壑助悽其。\n心许千金剑，终当挂树枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40642,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"建公挽诗","author":"刘攽","text":"燕祺欢受福，阳禄痛离灾。\n胙土乘初载，宾天遽不回。\n弄璋迷梦幻，壮发变尘埃。\n唯有华封祝，能宽上圣哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40643,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题鲁氏老桧堂","author":"刘攽","text":"当日山林客，移根近小轩。\n树阴今百尺，人世亦曾孙。\n坚节寒逾甚，清风老更存。\n犹馀双白鹤，终恋主人恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40644,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"柏悦堂 其一","author":"刘攽","text":"往说齐侯寝，此堂申甫馀。\n千龄长秀耸，众木既消除。\n杖履每多兴，冰霜深自如。\n凉风破蒸暑，真赏复谁须。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40645,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"柏悦堂 其二","author":"刘攽","text":"华堂柏两株，清景喜多馀。\n密影随步武，凉风自扫除。\n苍颜师尚父，劲节蔺相如。\n寄谢繁华子，荣枯可立须。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40646,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜凉","author":"刘攽","text":"稀星映斜汉，孤月静前轩。\n意喜凉风过，遥看碧树翻。\n劳生共裘葛，辞秩愧田园。\n高枕息群动，吟蛬依草根。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40647,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自蔡河之陈州","author":"刘攽","text":"扁舟去凫雁，川路正龙蛇。\n日色暝如午，风鸟端复斜。\n渐渐过陇麦，短短被堤花。\n涕泪元无极，那堪视物华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40648,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重伤胡二","author":"刘攽","text":"逝水竟不复，死生嗟可怜。\n所思今已矣，归使一悽然。\n尚想飞凫?，终辜忆戴船。\n神交如有验，会付广陵弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40649,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"五龙井祷雨","author":"刘攽","text":"汤年不过此，丘祷亦何频。\n石井无多水，泥蟠讵有神。\n舞雩声寂寞，剪爪事酸辛。\n万古为霖意，长嗟傅野人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40650,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"苦寒","author":"刘攽","text":"苦寒殊不意，衰老若为谋。\n赐隔青绫被，贫馀白罽裘。\n蛰龙才自脱，过雁可深忧。\n靳靳西颓日，墙阴肯为留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40651,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋过荐福院竹亭 其一","author":"刘攽","text":"入秋才一到，风物已凄凉。\n旧筱全侵席，新梢乱出墙。\n萧萧吹叶雨，稍稍坠枝霜。\n为有留人意，嘉游不可忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40652,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋过荐福院竹亭 其二","author":"刘攽","text":"开门金锁碎，绕径碧檀栾。\n钟呗风馀韵，房栊日暮寒。\n老僧长入定，好鸟故相看。\n何事扁舟客，殷勤觅钓竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40653,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"济川亭 其一","author":"刘攽","text":"谁谓此池小，远将天汉通。\n分明涵列宿，迢递引来风。\n松竹凌虚碧，轩窗倒影红。\n高明推李杜，不负傅岩功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40654,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"济川亭 其二","author":"刘攽","text":"自倚杖九节，时携书一通。\n石桥照影水，竹槛纳凉风。\n高柳参天碧，新莲映日红。\n由来帝何力，况数济川功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40655,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晒书","author":"刘攽","text":"幽事随时有，移书晒日华。\n囊开鱼蠹字，眼晕石榴花。\n病忘多三箧，劳心愧五车。\n赐书仍有品，前辈羡吾家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40656,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜过曾孚先","author":"刘攽","text":"索我形骸内，从君里巷居。\n度阡仍越陌，酌醴更焚鱼。\n残雪春泥熟，青灯缺月初。\n谁能惮乘兴，叹息岁将除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40657,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"将赴官庐州寄张四隐直二首 其一","author":"刘攽","text":"一为弹冠仕，遂废东皋田。\n不至二千石，行登四十年。\n羁游无定许，鬓发欲苍然。\n万里南江路，春风棹客船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40658,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"将赴官庐州寄张四隐直二首 其二","author":"刘攽","text":"江路西南永，风波岁月淹。\n赖君同此役，久客复谁嫌。\n榜叟誇忠信，津童识孝廉。\n云山仍在眼，诗兴力能兼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40659,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贺隐直","author":"刘攽","text":"举国皆儒服，吾人智有馀。\n焚舟济河后，埋剑发硎初。\n天路骞黄鹄，云涛纵巨鱼。\n殷勤故人意，青眼看乡书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40660,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送隐直归扶离","author":"刘攽","text":"羁旅自无友，非因七不堪。\n逃空见人喜，失学向君惭。\n贫病意不展，滞留情未甘。\n相从欲有问，空法本传南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40661,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪中忆隐直","author":"刘攽","text":"北风吹朔雪，遥想度关西。\n覆阁眼初熟，登楼望独迷。\n巧妆梅意密，偏压柳条低。\n竟日思君饮，空怜骏马蹄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40662,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"哭张隐直 其一","author":"刘攽","text":"结友儿童岁，对门兄弟辞。\n存亡殊不意，晚暮可胜悲。\n宰木归吴远，輀车出剑迟。\n善人鲜百福，神理傥吾欺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40663,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"哭张隐直 其二","author":"刘攽","text":"二星占使者，九折见忠臣。\n白发犹强力，青云早致身。\n劳生真梦寐，过事悉埃尘。\n已矣寝门泪，石交兼懿亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40664,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"占晴 其一","author":"刘攽","text":"南国无全腊，江天可喜晴。\n山林开雪色，凫雁与风声。\n春物催群动，年华强旅情。\n无人同此酒，叹息滞蛮荆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40665,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"占晴 其二","author":"刘攽","text":"蒸湿何由解，暄和自不禁。\n片云常蔽日，小雨不成霖。\n蚊蟆晴明地，蛟龙老病心。\n雄风不易得，无处可披襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40666,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪晴","author":"刘攽","text":"山雪喜初霁，意行因肆观。\n岩光花半散，峰势玉新攒。\n鸟去树冰落，水来溪舍寒。\n还愁向融散，立到夕阳看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40667,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"还郡寄洛中诸贤","author":"刘攽","text":"虽勤车马役，而与故人同。\n濯热宜清洛，忘饥为碧松。\n御风思禦寇，缩地忆壶公。\n待我成仙术，相过岂有穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40668,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送江淑寺丞弃官归江州","author":"刘攽","text":"时事不可愿，还家方自由。\n看山一长啸，饮水亦消忧。\n林竹通邻里，陔兰洁膳羞。\n还将计然策，江上倚扁舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40669,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"霍邱谢令寺丞","author":"刘攽","text":"明府双飞凫，南归鸿鹄俱。\n东风解冰雪，春水渡江湖。\n光禄诗为乐，渊明酒自娱。\n公田皆种秫，三径更何须。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40670,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送王肃侍禁新安监酒","author":"刘攽","text":"丹穴凤皆好，蓝田玉自温。\n流传洛生咏，叹赏贵公孙。\n好事欲成癖，著书经闭门。\n看君桂枝擢，禄仕复谁论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40671,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山寺","author":"刘攽","text":"叠嶂横秋水，招提隐半峰。\n白云迷到路，晓日自鸣钟。\n法会樵渔熟，斋时鸟雀慵。\n试寻方外士，系马就长松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40672,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"画雪扇子","author":"刘攽","text":"洒落瑶花薄，苍茫杀气深。\n因风惊拂面，濯热幸开襟。\n夜色非关月，朝云不待阴。\n秋风来应起，好在郢中吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40673,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晓起东园","author":"刘攽","text":"禽鸣知欲曙，野客自晨兴。\n春草生三径，朝光下九层。\n园林问圃老，笋蕨待岩僧。\n即此甘幽屏，趋时要未能。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40674,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"古桧亭 其一","author":"刘攽","text":"散栎厌为社，枯梧非有神。\n一身具松柏，千岁作秋春。\n风影日亭午，露香宵向晨。\n唯应仙鹿迹，不悔白头新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40675,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"古桧亭 其二","author":"刘攽","text":"昔闻上升桧，传作亳宫神。\n念此亦千载，玩之经一春。\n凉蝉号永昼，独鹤起清晨。\n谁与画屏幛，长令水墨新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40676,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上櫰","author":"刘攽","text":"人世南柯梦，看君葺旧居。\n小庭长汛扫，暇日省文书。\n黑叶生烟外，黄花过雨馀。\n那知山谷兴，不向市朝疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40677,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登楼","author":"刘攽","text":"溪谷含冰雪，川原见草芽。\n春生三峡水，日照万人家。\n时节长如此，风光会有涯。\n唯应多美酒，厌看海棠花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40678,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨中过汜水关入巩县","author":"刘攽","text":"泥涂出关恶，风雨过云寒。\n悬水馀百仞，层峰知几盘。\n攀跻头目眩，揭厉衣裳单。\n稍出万山外，始知人世宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40679,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵谢三利涉寺见寄","author":"刘攽","text":"众水会苍山，僧房积翠间。\n夕阴留到客，清暑独开关。\n月出乱峰白，天明游子还。\n他时望君意，馀恨不同攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40680,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题利涉寺","author":"刘攽","text":"云水上方居，迢迢百尺馀。\n水光摇几席，岚翠彻窗疏。\n鹤树追前佛，隆中问结庐。\n已知禅寂意，仍得揣摩书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40681,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"哭王子直 其一","author":"刘攽","text":"积水忽变浊，聚星无复光。\n风流都灭尽，天理竟冥茫。\n过事皆陈迹，馀哀祇泪行。\n遥怜转麈柄，顾影夜灯旁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40682,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"哭王子直 其二","author":"刘攽","text":"衰老惜年岁，羁孤慕友生。\n一哀谁为恸，百志尔无成。\n弓剑轻前敌，诗书足自名。\n人皆期不朽，持此傲公卿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40683,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"荷花","author":"刘攽","text":"白水满方塘，荷花五月芳。\n弄珠圆不定，濯锦冷逾光。\n香忆风醒酒，声宜雨送凉。\n扁舟学骚客，葺室近沧浪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40684,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"黄州临皋亭","author":"刘攽","text":"远国江千里，荒城水一涯。\n居人愁避虎，过客竞乘槎。\n秋雨吹天暮，寒涛浸日车。\n从来迁谪地，卑湿是长沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40685,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"野竹亭","author":"刘攽","text":"劲节四时好，此君常眼青。\n影摇金破碎，声动玉珑玲。\n方丈尘埃绝，高斋醉梦醒。\n由来谋野意，不异在林坰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40686,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻西戎乞降","author":"刘攽","text":"玉关依斥堠，荒服祀春秋。\n干羽由来事，桑榆尚可收。\n发书迎宝马，锡贡入貂裘。\n高枕兴王世，吾生免外忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40687,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"冬夜赏月","author":"刘攽","text":"晕逐阴风起，光随凛气多。\n霜应摧桂树，冰恐彻天河。\n池镜初容鉴，窗棂亦戏磨。\n关山千里雪，此夕共金波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40688,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪夜月中","author":"刘攽","text":"雪霁流云尽，天虚片月升。\n气清群玉府，光彻满壶冰。\n过雁明可数，啼鸟寒不胜。\n山阴自此去，野兴岂难乘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40689,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"玩芳亭","author":"刘攽","text":"谁与玩芳草，慨然思古人。\n东风千里目，红蕊一城春。\n贺燕自高下，浮云无旧新。\n南山际沧海，更觉尔为邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40690,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"留别诸兄弟","author":"刘攽","text":"羁游路万里，物色共悽然。\n霖雨伤秋意，西南接漏天。\n壶公缩地远，列子御风旋。\n信有神仙术，诸公一见怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40691,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"暂之霅上留别一二兄弟","author":"刘攽","text":"回首嗟行役，吟诗怆物华。\n西风凋木叶，客子去天涯。\n日暮看边雁，江秋见海槎。\n重阳谁对酒，野菊自开花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40692,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日登楼 其一","author":"刘攽","text":"水国春归晚，晴楼旅望赊。\n青丝垂地柳，白朵出墙花。\n听鸟参人语，看云任帽斜。\n沧浪殊不极，春色故无涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40693,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日登楼 其二","author":"刘攽","text":"野性耽章句，春容看旅愁。\n眼前都俗物，天外倚高楼。\n芳草茫茫绿，清淮??流。\n片云还欲雨，怅望恐花休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40694,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"绿野亭偶题 其一","author":"刘攽","text":"记得春晚句，缘情因谢公。\n名贤共标准，清境定无穷。\n乐矣登临际，悠然坐啸中。\n壶觞聊发兴，随俭亦随丰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40695,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"绿野亭偶题 其二","author":"刘攽","text":"倚郭遍禾黍，安知私与公。\n为农亦可乐，遇岁不终穷。\n累榭白云外，壤歌明月中。\n谁言鲁酒薄，自觉胜新丰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40696,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"日晚步过孙监丞","author":"刘攽","text":"夕阳喧鸟雀，幽径入蓬蒿。\n于此兴不浅，行吟殊未劳。\n市朝移俗态，麋鹿共吾曹。\n稍稍钟声暝，林梢白月高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40697,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]