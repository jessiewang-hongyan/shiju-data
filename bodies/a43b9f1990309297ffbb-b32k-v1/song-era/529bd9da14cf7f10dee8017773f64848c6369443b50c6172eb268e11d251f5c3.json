8e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65004,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新岁七十以人生七十古来稀为韵寄钱大参七首 其七","author":"曹勋","text":"居当山麓入烟扉，乔木苍藤接翠微。\n筑室暮年今尚少，得归真是眼中稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65005,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新岁七十以人生七十古来稀为韵寄钱大参七首 其二","author":"曹勋","text":"萧然心迹喜双清，且得肩头担已轻。\n老病正须安静处，林间风味慰平生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65006,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新岁七十以人生七十古来稀为韵寄钱大参七首 其一","author":"曹勋","text":"从心之岁自由身，恩许前期脱搢绅。\n一褐林泉侣樵牧，熙熙端是太平人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65007,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"楚妃叹五首 其五","author":"曹勋","text":"人静宫深夜漏长，深宫漏永忆君王。\n可怜不及秋蒲草，犹得承欢荐宝床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65008,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"楚妃叹五首 其四","author":"曹勋","text":"宝靥香销翠幄宽，更深明月上阑干。\n徘徊踏碎银蟾影，谁念从来不耐寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65009,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"楚妃叹五首 其三","author":"曹勋","text":"霜满虚庭月满楼，罗帷珠箔闭清秋。\n炉香烟断添银烛，谁道更深睡去休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65010,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"楚妃叹五首 其二","author":"曹勋","text":"用意十分巧画眉，妆成独自惜容仪。\n非缘郑袖能歌舞，自是人心著处迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65011,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"楚妃叹五首 其一","author":"曹勋","text":"日晚章华翠辇归，寂寥深院锁重扉。\n非缘掩鼻移恩宠，自是新人巧用机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65012,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"楚宫词三首 其三","author":"曹勋","text":"庭下茸茸碧草齐，不知桃李竟芳菲。\n自从侍妾承恩后，忘著迎春金缕衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65013,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"楚宫词三首 其二","author":"曹勋","text":"坐待鸡鸣报早朝，那知别殿困笙箫。\n妾身恨不为鹦鹉，犹恃君王顾盼骄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65014,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"楚宫词三首 其一","author":"曹勋","text":"忆昔君王初选时，侍儿邀宠学蛾眉。\n而今弃置同衰草，不及章台杨柳枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65015,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"瑞岩仰老见和复酬前韵七首 其七","author":"曹勋","text":"云英两凤跨烟扉，收尽诗才坐翠微。\n相国题评为携挈，一方莲社似公稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65016,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"瑞岩仰老见和复酬前韵七首 其六","author":"曹勋","text":"白足持诗怀抱开，清言秀润喜惟梅。\n便知雅贶翛翛意，端为闲人特特来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65017,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"瑞岩仰老见和复酬前韵七首 其五","author":"曹勋","text":"当年卜近虎溪侣，领略闲心笑相许。\n岂图云水各一方，回首向来若怀古。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65018,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"瑞岩仰老见和复酬前韵七首 其四","author":"曹勋","text":"台山之麓少卑湿，小筑还专甘井汲。\n陋巷闭门饮一瓢，惭非回也能知十。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65019,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"瑞岩仰老见和复酬前韵七首 其三","author":"曹勋","text":"生死之徒六与七，可救群生可愈疾。\n心如秋月碧潭空，深闭岩扉方表悉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65020,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"瑞岩仰老见和复酬前韵七首 其二","author":"曹勋","text":"双涧流泉彻底清，五峰晴挂白云轻。\n泉流云散迟归步，犹欲思丰问此生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65021,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"瑞岩仰老见和复酬前韵七首 其一","author":"曹勋","text":"请得忙中物外身，要看飞瀑泻天绅。\n佳时每与渔樵伴，仿语相倍是故人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65022,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"禁中赏芍药口占","author":"曹勋","text":"千壶芍药霭祥云，一部箫韶合曲新。\n三圣临轩听歌舞，端知造物款留春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65023,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"禁直偶作三首 其三","author":"曹勋","text":"声藏禁柳莺簧巧，香霭宫花凤髓浮。\n不怕苑中归骑晚，分光御烛下神州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65024,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"禁直偶作三首 其二","author":"曹勋","text":"缓移淑景觉暄妍，春晚尤宜听管弦。\n院宇日斜花欲睡，池塘风澹柳初眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65025,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"禁直偶作三首 其一","author":"曹勋","text":"寓直承明意味清，风传禁漏作春声。\n梅梢影转三更月，身在蓬壶梦不成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65026,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"禁直赋所见荼蘼","author":"曹勋","text":"密叶素华青羽帔，繁香秀色六铢衣。\n枕间为插琉璃满，清梦泠泠入翠微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65027,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"嘉游歌","author":"曹勋","text":"紫殿香风暖，珠帘璧月斜。\n阁中调宝瑟，门外驻羊车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65028,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端午帖子九首 其九","author":"曹勋","text":"雨后风微荷芰香，顿驱初暑作疏凉。\n黑云捲尽青天大，却倚湖光看夕阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65029,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端午帖子九首 其八","author":"曹勋","text":"下直归来阆苑游，椒风高转紫云楼。\n冰盘纹簟清薰细，捲上珠帘白玉钩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65030,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端午帖子九首 其七","author":"曹勋","text":"参差台殿照祥云，叠雪含风綵缕新。\n玉带轻纱迎令节，五云深处奉严宸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65031,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]