[{"title":"游仙都 其五","author":"吴谨微","text":"山下霏微雨洒尘，门前嘹唳鹤迎人。\n遂成一觉仙都梦，更访遗踪得隐真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44903,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游仙都 其四","author":"吴谨微","text":"石笋古传八百丈，鼎湖仙去几千年。\n我疑二事无从政，但信仙都是洞天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44904,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游仙都 其三","author":"吴谨微","text":"黄冠道士老而癯，相对谈玄一事无。\n劝我莫教沉宦海，人间亦自有仙都。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44905,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游仙都 其二","author":"吴谨微","text":"辙迹峰前聊息迹，忘归洞口未能归。\n往来名利憧憧者，著脚仙都亦自稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44906,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游仙都 其一","author":"吴谨微","text":"薄宦驱人畏简书，金柔暑浊倦征途。\n归来有意寻真境，路入仙都不惮迂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44907,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游永福方广岩","author":"吴锜","text":"曾访神仙岩洞来，人言伟观似天台。\n藤萝足下猿猱啸，钟鼓声边日月开。\n灯续佛光凝紫翠，云将蜃气作楼台。\n最怜贯石神龙尾，犹带天东雨露回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44908,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三高祠","author":"吴锡畴","text":"去越思吴居甫里，并祠千载说三高。\n到头杞菊饶馀味，不涉人间富贵劳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44909,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夕阳","author":"吴锡畴","text":"夕阳牛背数家村，一笛声中欲断魂。\n人世百年双短鬓，不知禁得几黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44910,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山中杂言 其二","author":"吴锡畴","text":"老作山翁行辈人，素衣曾不化京尘。\n只应猿鹤无惊怨，从自龙蛇有屈伸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44911,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山中杂言 其五","author":"吴锡畴","text":"移春有槛遍京华，剩种人间富贵花。\n谁识山中穷活计，眼前沃沃只桑麻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44912,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山中杂言 其四","author":"吴锡畴","text":"草色侵除雨后深，天教閒静在山林。\n无田种秫供桑落，有地栽兰当水沈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44913,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山中杂言 其一","author":"吴锡畴","text":"小小柴门傍竹开，幽深不惯有人来。\n颇嫌老鹤无情思，啄损庭前一径苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44914,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山中杂言 其六","author":"吴锡畴","text":"得失升沈是与非，纷纷世上局如棋。\n白云谷口横遮断，万事山中总不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44915,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山中杂言 其三","author":"吴锡畴","text":"数家鸡犬小成村，一带冈峦近入门。\n怕有渔人来问讯，溪流那得截云根。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44916,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山中杂言 其七","author":"吴锡畴","text":"谬有生涯类蠹鱼，萧然四壁一床书。\n儿曹未信儒冠误，犹事青灯废耒锄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44917,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"六和塔","author":"吴锡畴","text":"直上浮屠最上头，茫茫渺渺入双眸。\n斜阳断雁新秋意，惹起西风一段愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44918,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"友人有约未至","author":"吴锡畴","text":"梅破疏英饯岁华，寻梅有约过山家。\n短窗昨夜占佳晤，挑尽寒灯未肯花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44919,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"无弦古琴","author":"吴锡畴","text":"寥寥谁是识琴心，得趣元来不在音。\n可惜伯牙犹未达，绝弦当日恨徒深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44920,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"兰","author":"吴锡畴","text":"石畔棱棱翠叶长，葳蕤紫蕊吐幽芳。\n灵均去后无人问，林密山深只自香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44921,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬日 其一","author":"吴锡畴","text":"日薄霜清水见沙，水边偶到野人家。\n满阶风叶浑慵扫，为爱深红似落花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44922,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬日 其二","author":"吴锡畴","text":"夕阳孤倚立溪头，三两渔舟溯碧流。\n惊起一行新宿雁，斜飞又过别汀洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44923,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬日 其三","author":"吴锡畴","text":"谁人雅趣似林逋，绕屋栽梅入画图。\n淡日笼晴霜转暖，从头看过有花无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44924,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"对雪","author":"吴锡畴","text":"婆娑舞忽凌空去，散漫狂还扫地来。\n几片飞黏梅树上，恍疑昨夜有花开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44925,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"多景楼","author":"吴锡畴","text":"栏干投北是神州，莫怪诸公怯上楼。\n千载潮声如有恨，犹能含怒到瓜洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44926,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵孙艮夫赠别 其二","author":"吴锡畴","text":"扬子江头欸乃歌，一天星斗络斜河。\n怕无才思堪风月，拾入奚囊未必多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44927,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵孙艮夫赠别 其一","author":"吴锡畴","text":"第一江山第一程，新诗快读逼梅清。\n碧云不断飞帆急，立尽樯竿晚日明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44928,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵题璜原僧舍","author":"吴锡畴","text":"鱼鼓无声昼阒沈，荒碑积雨古苔侵。\n忽飞寒雀窥斋钵，偶有驯猿听梵音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44929,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江氏静山堂","author":"吴锡畴","text":"一炷清香万叠山，依仁体艮寂然间。\n油云自去为霖雨，千古苍苍只恁閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44930,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杨花 其二","author":"吴锡畴","text":"飞舞随春去不停，空条留得罩邮亭。\n狂心未肯沾泥死，犹作轻浮水上萍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44931,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杨花 其一","author":"吴锡畴","text":"为见春风不久归，颠狂上下弄晴晖。\n只饶天与无拘束，入幕穿帘任意飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44932,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜雨","author":"吴锡畴","text":"漠漠春阴未肯晴，空阶滴点到平明。\n应知不入笙歌耳，来作愁人枕畔声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44933,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"姑苏台","author":"吴锡畴","text":"歌舞声消迹已陈，危台今日压城闉。\n麋游莫恨终亡国，谁把鸱夷载谏臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44934,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"林和靖墓","author":"吴锡畴","text":"遗稿曾无封禅文，鹤归何处但孤坟。\n清风千载梅花共，说著梅花定说君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44935,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨中过昱岭","author":"吴锡畴","text":"下舆扶杖过山蹊，雨溅征裾屐溅泥。\n正自不禁行路苦，一声何处竹鸡啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44936,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"看山","author":"吴锡畴","text":"一寒未办买山赀，随处看山总可诗。\n人事无常山换主，青山依旧不曾移。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44937,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送春 其二","author":"吴锡畴","text":"惆怅春归自不禁，日长门巷静沈沈。\n应知不止为花地，沃沃桑麻雨露深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44938,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送春 其一","author":"吴锡畴","text":"红衬晴霞一角天，小楼重上眺前川。\n莫言春去无踪迹，尽在枝头嫩绿边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44939,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送春 其三","author":"吴锡畴","text":"新绿回环暗竹扉，静中物物总天机。\n啼莺戏蝶浑如旧，莫是春风尚未归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44940,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重午于潜道中","author":"吴锡畴","text":"逢人篸艾知重午，漫把青钱问酒杯。\n岂是醉狂慵吊古，独醒不禁客愁来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44941,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重题钓台","author":"吴锡畴","text":"不向云台恋故袍，清风固自钓台高。\n渭川八十年烟雨，岂是渔竿把不牢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44942,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闻莺","author":"吴锡畴","text":"湖边春压柳丝低，云淡风轻一杖藜。\n伐木诗亡交道绝，绵蛮空为尽情啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44943,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闻雁","author":"吴锡畴","text":"暮霞天角正红酣，渺渺飞鸣雁两三。\n万里中原消息断，赖能带得过江南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44944,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"除夜 其一","author":"吴锡畴","text":"日月跳丸岁又除，书生作计太迂疏。\n也知穷鬼难驱逐，郁垒神荼莫用渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44945,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"除夜 其二","author":"吴锡畴","text":"守岁儿童语笑频，老翁醉拥地炉春。\n欠伸起唤梅花说，明日平头五十人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44946,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桂花","author":"吴锡畴","text":"许多香却不多花，灏气浮空月满家。\n明日石坛金屑富，旋收剩馥入龙茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44947,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"荷葭坞呈秋崖方工部","author":"吴锡畴","text":"怕惊啼鸟推棋罢，为爱落花迂屐行。\n窈窈绿云春一坞，游丝飞絮弄新晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44948,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶成 其一","author":"吴锡畴","text":"酒能成病姑停饮，诗怕伤时莫浪吟。\n客又不来春欲去，一帘花影哢鸣琴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44949,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶成 其二","author":"吴锡畴","text":"酿蜜山蜂初割户，衔泥梁燕已成家。\n春愁漠漠连芳草，閒过东园数落花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44950,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚眺","author":"吴锡畴","text":"日未沈西月色东，一山秋叶染霜红。\n鲜明恰胜春花好，不似春花耐得风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44951,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"笼鹤","author":"吴锡畴","text":"本是云霄万里身，樊笼著向绿槐阴。\n虽然禄料曾无欠，孤却宽閒自在心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44952,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"棣华堂先大父国录叔大父安抚教授之地堂前古桂岿然独存花时踏月徘徊其下诵先君旧隐之诗次韵追感","author":"吴锡畴","text":"古桂吹香秋月明，当年曾听读书声。\n角弓有赋门人在，邂逅犹须问悴荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44953,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湖上闻鹃","author":"吴锡畴","text":"涌金门外买湖船，绿树阴阴叫杜鹃。\n恰莫叫从城里去，有谁人肯办归田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44954,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"琴枕","author":"吴锡畴","text":"三尺焦桐称醉眠，邯郸底用遇回仙。\n梦中髣髴闻流水，元是山间响瀑泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44955,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"醉起","author":"吴锡畴","text":"水宿篙师报歇程，维舟聊此问旗亭。\n醉来顿觉乡愁失，苦被霜风吹又醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44956,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠写照陈生","author":"吴锡畴","text":"燕颔鸢肩总属夫，几何人得上凌烟。\n且烦写在山岩里，野服黄冠看瀑泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44957,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鸂鶒","author":"吴锡畴","text":"满身文彩漫成愁，一曲清池强滞留。\n翘足有时双睡去，梦魂依旧绕沧洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44958,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九日","author":"吴锡畴","text":"九日今朝是，风吹帽欲斜。\n愁惟添白发，贫莫负黄花。\n蟹上橙初熟，秋登酒易赊。\n茱萸休把玩，且办醉生涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44959,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九日集客","author":"吴锡畴","text":"佳节欲酬须酩酊，东篱不记几飞觞。\n从教乌帽吹将去，且对黄花领取香。\n世事漫劳三太息，人生宽破百重阳。\n英雄盖代今何在，戏马高台久已荒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44960,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山行","author":"吴锡畴","text":"策蹇又山行，看山不识名。\n平林秋后薄，叠嶂日边明。\n云近侵衣湿，泉幽照影清。\n归樵饶乐意，笛弄两三声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44961,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山村问宿","author":"吴锡畴","text":"问宿山村里，人烟断复连。\n高峰明落日，危石响幽泉。\n世事双眉上，年华两鬓边。\n沧洲森万玉，飞梦月娟娟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44962,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山居寂寥与世如隔是非不到荣辱两忘因忆秋崖工部尝教以我爱山居好十诗追次其韵聊写穷山之趣 其七","author":"吴锡畴","text":"我爱山居好，枌榆老故丘。\n好峰当户立，远水护田流。\n鼓响移秧日，耞鸣穫稻秋。\n年丰身老健，一饱外无求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44963,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山居寂寥与世如隔是非不到荣辱两忘因忆秋崖工部尝教以我爱山居好十诗追次其韵聊写穷山之趣 其九","author":"吴锡畴","text":"我爱山居好，茶瓯困解围。\n松边横藓石，柳下敞渔扉。\n细雨噞喁出，斜阳觳觫归。\n交情殊贵贱，似觉故人非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44964,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山居寂寥与世如隔是非不到荣辱两忘因忆秋崖工部尝教以我爱山居好十诗追次其韵聊写穷山之趣 其六","author":"吴锡畴","text":"我爱山居好，崖云湿爨烟。\n琴横双鹤舞，犁阁一牛眠。\n酒熟花开日，诗成雨霁天。\n逢场聊适意，总结喜欢缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44965,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山居寂寥与世如隔是非不到荣辱两忘因忆秋崖工部尝教以我爱山居好十诗追次其韵聊写穷山之趣 其一","author":"吴锡畴","text":"我爱山居好，扶藜步晚晴。\n俗醇存古意，境寂快诗情。\n杜老银丝脍，坡翁玉糁羹。\n随缘清供足，尽可佚馀生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44966,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山居寂寥与世如隔是非不到荣辱两忘因忆秋崖工部尝教以我爱山居好十诗追次其韵聊写穷山之趣 其十","author":"吴锡畴","text":"我爱山居好，田园在力耘。\n樵歌风外断，猿啸月中闻。\n舴艋夜招鹤，辘轳晓汲云。\n久惭呼处士，未必应星文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44967,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山居寂寥与世如隔是非不到荣辱两忘因忆秋崖工部尝教以我爱山居好十诗追次其韵聊写穷山之趣 其四","author":"吴锡畴","text":"我爱山居好，轩窗傍水开。\n游鱼吹堕絮，閒鹤啄荒苔。\n有字人谁问，无租吏不来。\n寂寥门径侧，数尺长蒿莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44968,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山居寂寥与世如隔是非不到荣辱两忘因忆秋崖工部尝教以我爱山居好十诗追次其韵聊写穷山之趣 其五","author":"吴锡畴","text":"我爱山居好，陶然与世忘。\n细听泉漱玉，那羡佩鸣珰。\n乳燕飞閒宇，新篁出矮墙。\n静观机不息，天地为谁忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44969,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山居寂寥与世如隔是非不到荣辱两忘因忆秋崖工部尝教以我爱山居好十诗追次其韵聊写穷山之趣 其八","author":"吴锡畴","text":"我爱山居好，苍矶一钓竿。\n白鸥春水阔，黄犊绿坡宽。\n径菊香秋晚，溪梅约岁寒。\n人间幽意足，诗思倚栏干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44970,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元日","author":"吴锡畴","text":"寂寞柴门贺客疏，已输渐后饮屠苏。\n花情柳思开新岁，竹简蒲团只故吾。\n献楚有谁能辨玉，求齐正自不工竽。\n朝来笑挽春风问，亦解重青两鬓无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44971,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"分题牡丹","author":"吴锡畴","text":"此花谁实与封王，公道东皇有品量。\n宿露低垂苍玉佩，暄风轻振紫罗裳。\n精神因为得春久，富贵何妨到晚芳。\n醉把一枝簪帽侧，从教人笑老夫狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44972,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"友人幽居","author":"吴锡畴","text":"空谷境常寂，幽居趣最真。\n蛙鸣聊当乐，花发即为春。\n白首惟诗酒，青山自主宾。\n惜无骚雅笔，写寄市朝人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44973,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"对月有怀","author":"吴锡畴","text":"破晴斜月入帘阴，鬓影萧骚老不禁。\n九十日春风与雨，百千年事后犹今。\n牡丹红褪残妆面，杜宇声寒故国心。\n眼底交游期又误，飞鸿杳杳鲤沈沈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44974,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"对灯咏感","author":"吴锡畴","text":"竛竮瘦影伴孤灯，两鬓萧然失旧青。\n豪在尚堪论剑术，骨凡何用泥丹经。\n半生踪迹如春燕，少日交游类曙星。\n閒拂桐丝写幽意，洋洋不为有人听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44975,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵叶介夫","author":"吴锡畴","text":"芳草垂杨浥嫩寒，苔痕新过雨斑斑。\n一年春付花开落，长日庭分燕往还。\n世事祇堪频对酒，诗情自可饱看山。\n尽穷莫用文为送，郊岛曾容季孟间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44976,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]