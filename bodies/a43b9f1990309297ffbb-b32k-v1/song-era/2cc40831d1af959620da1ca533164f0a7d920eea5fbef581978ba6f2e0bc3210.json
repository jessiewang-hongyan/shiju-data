[{"title":"昌甫梦中有句和韵答寄 其二","author":"韩淲","text":"人是梅花梅是人，似谈如见景常新。\n花香直入人肌骨，寤寐成香孰比伦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27382,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵留饮翼日诗来因次韵为答","author":"韩淲","text":"熟醉春山许著身，夜何其后转逡巡。\n纵翻旧话拈新话，未叹今人笑古人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27383,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"姊丈携诸甥送至十里寺戏题壁间","author":"韩淲","text":"薰风小寺驻征鞍，不问人间行路难。\n酒力渐添诗力健，芙蓉空自叠高寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27384,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送客 其一","author":"韩淲","text":"吟到西湖诗更清，路经严濑想舟行。\n春风细雨潮回处，好泊徐村入帝城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27385,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送客 其二","author":"韩淲","text":"荣宦重来十数年，管弦深处百花天。\n云飞咫尺璇霄去，给札西清听奏篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27386,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送客 其三","author":"韩淲","text":"延陵有客正同僚，千里相望意已消。\n功业文章付杯酒，孤山东畔问渔樵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27387,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送昌甫盖前晚独立涧上看桃花初开意思正适时见昌甫来也 其一","author":"韩淲","text":"涧头薄暮看桃花，忽见高人来过家。\n一酌扶藜村坞去，夜清灯火思无涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27388,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送昌甫盖前晚独立涧上看桃花初开意思正适时见昌甫来也 其二","author":"韩淲","text":"恨不追随到玉山，笋舆咿轧可怡颜。\n诗情酒兴复几许，春在花光草色间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27389,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送昌甫盖前晚独立涧上看桃花初开意思正适时见昌甫来也 其三","author":"韩淲","text":"春来閒谈竟谁同，啼鸟漫山弄暖风。\n章泉水生野花发，老眼古意唯此翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27390,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送耿宣赞 其一","author":"韩淲","text":"西湖水月两峰高，吴会东临日夜潮。\n鳷鹊未央仙仗里，眼明入阁上云霄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27391,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送耿宣赞 其二","author":"韩淲","text":"数年来往于南鹿，酒到诗成情转亲。\n鹏翼喜君才得路，春风更不话离情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27392,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"停舟步月访春伯","author":"韩淲","text":"一溪明月汎清深，醉泊滩头筱径阴。\n静夜蛙声鸣又歇，砌蛩秋近已微吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27393,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"二十九日过朴翁","author":"韩淲","text":"苏堤东畔南屏北，忽有诗人横小楼。\n杨柳已疏蒲稗晚，旋酤寻蟹洗牢愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27394,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过王伯是乃岐公孙也","author":"韩淲","text":"小窗听雨看梅花，人在江南旧相家。\n不是岁阑情味别，旧回归路板桥斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27395,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过邻家","author":"韩淲","text":"饭馀来访水东家，竹树萧森蓼著花。\n绝口不谈閒俗事，只寻棋具看煎茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27396,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过野趣","author":"韩淲","text":"晚窗持酒对梅花，山色吹寒入岁华。\n冰水溪南南涧曲，行吟閒过两三家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27397,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过余学正家","author":"韩淲","text":"绿叶扶疏雨未花，芙蓉窗院晚山斜。\n清秋东郭门前路，可醉可吟能几家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27398,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"见成季昆仲","author":"韩淲","text":"岁前三日到君家，溪雾连山雨两涯。\n香汎茶甘拥炉坐，纸窗瓶水浸梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27399,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"道中访何贡士","author":"韩淲","text":"野路寻诗立马时，骚人闲淡少人知。\n霜华满地吹黄叶，应有早梅开一枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27400,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十九日回涂与郑一矫首不能去 其一","author":"韩淲","text":"丛祠寒霭舞神鸦，归路禾场日未斜。\n回望幽人在深隐，山明红叶水明沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27401,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十九日回涂与郑一矫首不能去 其二","author":"韩淲","text":"离城过县访深幽，不许凡人识路头。\n暂得相看易相远，烟横云绕谓何求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27402,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十九日回涂与郑一矫首不能去 其三","author":"韩淲","text":"行吟应更笑刘伶，醉里云山传逸心。\n华发萧萧天广大，岁寒碧色是松林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27403,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"郑一送其母舅就禄临江因往长沙 其一","author":"韩淲","text":"玉笥仙坛葛稚川，古人何在岂徒然。\n君行但作游山想，不就丹砂也自贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27404,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"郑一送其母舅就禄临江因往长沙 其二","author":"韩淲","text":"道林四绝初无恙，何必骚词抵死吟。\n我识輶车曾著记，潇湘流尽碧波心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27405,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送成季 其一","author":"韩淲","text":"才见西来又见归，子陵台下水烟霏。\n停桡应为一回首，笑杀京尘满客衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27406,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送成季 其二","author":"韩淲","text":"开岁春风我亦归，雪云犹带雨霏霏。\n不须别酒添乡思，待上灵山同振衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27407,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送成季 其三","author":"韩淲","text":"想见庭闱日望归，好催帆影度山霏。\n团栾共颂椒花处，真乐人间是綵衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27408,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闻少卫有行役 其一","author":"韩淲","text":"见说扁舟下彭蠡，九江日落照庐山。\n弟兄情话对床夜，应笑冰溪人更閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27409,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闻少卫有行役 其二","author":"韩淲","text":"官梅何似野梅好，一任有诗能细论。\n牧笛樵歌茶灶外，几多北海只空樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27410,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"溪路邂逅傅骐骥之在所沽酒话别 其一","author":"韩淲","text":"濯锦江头山四围，游人爱山自忘归。\n山光不为人转改，冉冉绿雾黄叶飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27411,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"溪路邂逅傅骐骥之在所沽酒话别 其二","author":"韩淲","text":"濯锦江头织锦家，几多花草斗矜夸。\n无人识得他机杼，伫立视之徒叹嗟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27412,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"溪路邂逅傅骐骥之在所沽酒话别 其三","author":"韩淲","text":"濯锦江头冬日晴，水光山色傍人清。\n我身偶閒来散步，适有溪山能动情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27413,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"劳去姬","author":"韩淲","text":"香温宝鸭枕痕收，眉黛空攒一点愁。\n春尽絮飞留不住，乐天犹自说风流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27414,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送野云孔鍊师回永嘉 其一","author":"韩淲","text":"野云飞过玉溪云，枉把清氛入世氛。\n五十三参善知识，伟哉犹说象山君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27415,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送野云孔鍊师回永嘉 其二","author":"韩淲","text":"开元观近水心寺，丹峤濛鸿第几峰。\n夜半醮坛星月冷，珠藏学海睡骊龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27416,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠杨相士","author":"韩淲","text":"贤愚贵贱不相关，风鉴如何著眼看。\n三百年来旧宗社，公卿将相满朝端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27417,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"钱相士邂逅灵山阁 其一","author":"韩淲","text":"玉溪深处灵山阁，一片孤云飞野鹤。\n从人索相问穷通，照破髑髅错不错。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27418,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"钱相士邂逅灵山阁 其二","author":"韩淲","text":"古来云海本茫茫，见素谭玄总自藏。\n挥手出门何处去，华阳且道是仙乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27419,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"访杰师不值","author":"韩淲","text":"老于交往喜寻僧，涧道微寒水未冰。\n尽日应身何处供，夜钟谁上佛前灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27420,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雨晴过杰上人","author":"韩淲","text":"闲身初不管阴晴，雨即关门听瓦声。\n今日溪边山雾捲，僧坊赢得放身行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27421,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"九日湖上寄铦师","author":"韩淲","text":"湖上游船拨不开，芙蓉十里锦新裁。\n夜深风露非尘世，惆怅无人月下来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27422,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄杰上人","author":"韩淲","text":"葡萄架叶雨苍凉，经卷禅床自一窗。\n便做山僧休歇去，也闻檐溜响淙淙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27423,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"琴僧见过 其一","author":"韩淲","text":"孤山从昔有琴聪，不但寻声指甲中。\n一似少游闻复语，几曾著眼送飞鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27424,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"琴僧见过 其二","author":"韩淲","text":"涧上秋深黄叶多，素琴终日奏云和。\n上人过我还休去，一段风光可奈何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27425,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"五月二十二日寻僧 其一","author":"韩淲","text":"踏热归来睡涧泉，更寻雪观碧云篇。\n崎岖小径通僧路，不管田乾五月天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27426,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"五月二十二日寻僧 其二","author":"韩淲","text":"行遍灵岩与虎丘，洞霄双径也闲游。\n钱塘潮送钓台上，投老心情却自由。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27427,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"五月二十二日寻僧 其三","author":"韩淲","text":"旋汲清泠注石盆，葡萄阴落砌苔痕。\n道人坐久茶尤好，香净不繁萦小轩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27428,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵铦师壁间句四首 其一","author":"韩淲","text":"老僧有句逼阴何，一字流传兴已多。\n秋日湖山载尊酒，试邀我辈与相过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27429,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵铦师壁间句四首 其二","author":"韩淲","text":"檐外扶疏秋竹竿，冷清清地碧团团。\n四人话到离骚地，却怪从前有个般。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27430,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵铦师壁间句四首 其三","author":"韩淲","text":"系船湖畔作山行，物是人非几变更。\n川畔何须问圆泽，世间禅指即三生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27431,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵铦师壁间句四首 其四","author":"韩淲","text":"禅家法眼本高寒，不用机缘出世间。\n一首清诗一盂饭，静看南北两云山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27432,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"玩易 其一","author":"韩淲","text":"刚决柔爻是五阳，一年春数此方强。\n希夷只把临分画，龙见于田意最长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27433,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"玩易 其二","author":"韩淲","text":"太玄准易装为旅，历气推详阳夏时。\n亲寡且从人事说，艮离山火去何之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27434,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"读归去来词","author":"韩淲","text":"彭泽非缘懒折腰，便如莲社也萧条。\n经邱寻壑归来事，醉眼兴亡日月飘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27435,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"读唐韩文公和皇甫持正陆浑山火诗","author":"韩淲","text":"神焦鬼烂陆浑山，皇甫与韩吟其间。\n曲突徙薪城市事，可怜焦土是咸关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27436,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题武夷所校丹经后","author":"韩淲","text":"武夷山翁今已仙，此书留与学长年。\n丹砂夜就龙虎鼎，后之读者心应然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27437,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题昌甫所录郭文诸人传后","author":"韩淲","text":"兽鹿如斯为慨然，使君犹入野人船。\n游山失道今谁问，孤姥翻知长史贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27438,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"昌甫示所藏淮海谪处州税官时诗草","author":"韩淲","text":"雪云苔竹寒炉伴，细展横看淮海诗。\n静坐溪庵写经罢，鱼豚收税更何为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27439,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"昌甫诗编","author":"韩淲","text":"昌甫诗编成甫题，放翁文物海山知。\n交情生死人谁识，千古绝弦钟子期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27440,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"读成季近诗慨然有怀诸人 其一","author":"韩淲","text":"近来诗句无人道，犹得章泉与栗斋。\n寂寂南豅霜雪里，一枝梅蕊又能佳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27441,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"读成季近诗慨然有怀诸人 其二","author":"韩淲","text":"因君却数旧过从，南北东西路亦通。\n孟达宣城何澹泊，樟丘斯远更丰融。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27442,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"读成季近诗慨然有怀诸人 其三","author":"韩淲","text":"梅山已谢小山老，律调不同情不殊。\n九日一尊潘德久，相思相与是西湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27443,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"读昌甫诗","author":"韩淲","text":"玉山高并两峰寒，向背稀稠画亦难。\n一味清新无我爱，遥看直北是长安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27444,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"读半山诗","author":"韩淲","text":"钟山投老漫寻诗，幽草闲花水满陂。\n步转暖风还尽日，坐因凉雨独移时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27445,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"青阳龙池僧索诗","author":"韩淲","text":"老僧口边生白醭，坐断诸方占幽独。\n池中应有龙去来，好为朝昏打斋粥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27446,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"抄诗","author":"韩淲","text":"更把诗来子细抄，虚空界尽一丝毫。\n楚人已往应刘远，难倩麻姑痒处抓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27447,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"同昌甫观赵将所录庞白蘋与其诸父兄诗","author":"韩淲","text":"萧条壮客见王孙，谁说中原旧相门。\n今日行间为惆怅，白蘋洲上有吟魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27448,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"余伯皋持巩仲至三山诗卷来因借录之 其一","author":"韩淲","text":"不见睡翁恰六年，郭文山下正鸣弦。\n欲求一句无因耳，且录旧诗殊恍然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27449,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"余伯皋持巩仲至三山诗卷来因借录之 其二","author":"韩淲","text":"敝衣旧絮依冬日，作墨亲传仲至诗。\n我有斯人容老矣，何将凫舄共参差。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27450,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"余伯皋持巩仲至三山诗卷来因借录之 其三","author":"韩淲","text":"雅怀好事伯皋子，游到三山又游江。\n收得巩郎诗一卷，归来杯酒话吟窗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27451,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赵昌甫写寄江西道中诗卷","author":"韩淲","text":"眼底谁无一卷诗，诗能如此亦何为。\n纵言光景留连者，春在人间有几知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27452,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"仲至近诗戏题卷末","author":"韩淲","text":"三年不见栗斋翁，满卷新诗是国风。\n野趣轩前梅蕊白，故人应在醉吟中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27453,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"仲可出刘武子行卷因题","author":"韩淲","text":"绮窗春思入钟山，日日江云草树间。\n不觉东风吹酒醒，宝香犹煖玉笙寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27454,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赵清江几间见刘小山诗卷","author":"韩淲","text":"锦翻香字彩笺轻，折尽青青柳下亭。\n半夜隔江风月冷，碧云深处是诗星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27455,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题刘叔骥诗卷","author":"韩淲","text":"春风一曲唱离歌，楼外玉溪流细波。\n诗酒尚能如此在，岂知白发我偏多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27456,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"黄仲明所藏巩诗小卷次上饶韵","author":"韩淲","text":"天壤无能著此翁，空令千古想其风。\n摩挲诗字尤堪忆，愁切水心名志中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27457,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赵主奉得易帅所书敬斋二字","author":"韩淲","text":"闲身八桂复清湘，邂逅犹于敬不忘。\n写作斋名君记取，他时拈出话尤长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27458,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵昌甫所题唐宋诸贤画像石刻 其一","author":"韩淲","text":"法云宝月自空山，相业都归双鬓斑。\n便得人传图画好，百年何有断碑间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27459,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]