[{"title":"偈一百二十首 其六十三","author":"释怀深","text":"虎穴门前曾宴坐，龙床角畔去谈禅。\n睹人莫苦生离思，风月从来共一天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1823,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其六十四","author":"释怀深","text":"住亦随缘去是常，山林城市两无妨。\n白云本是无心物，一任风吹入帝乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1824,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其六十五","author":"释怀深","text":"一居丈室，家风壁立。\n把断重关，有谁敢入。\n直饶铁眼铜睛汉，也是门头户底人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1825,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其六十六","author":"释怀深","text":"物物头头不覆藏，须弥高广露堂堂。\n要知此曲无音韵，更对薰风舞一场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1826,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其六十七","author":"释怀深","text":"气息才通不可收，一回拈起一回羞。\n威音王外难分雪，殃及儿孙卒未休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1827,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其六十八","author":"释怀深","text":"今年两次逢端午，不须更打划船鼓。\n金刚门外笑呵呵，一夜通身汗如雨。\n汗如雨，不须言，犀牛扇子亦陡然。\n旧山多积雪，归去是何年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1828,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其六十九","author":"释怀深","text":"一切有为法，如梦幻泡影。\n如露亦如电，应作如是观。\n释迦老子，只知其一，不知其二。\n幻化空身即法身，个中无染亦无尘。\n拈匙把箸如明了，扫地烧香不倩人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1829,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其七十","author":"释怀深","text":"赵州住院二十年，折脚禅床欠一边。\n灰头土面半饥饿，苦涩家风今古传。\n翻笑今人做长老，恰似官人问职田。\n职田多，我便去，免见钵盂无著处。\n职田少，我不去，生怕没盐兼没醋。\n禅门难得好儿孙，正眼近来如扫土。\n慧林首座久韬藏，个中果熟自然香。\n大海钓鱼拚得失，空船归去也无妨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1830,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其七十一","author":"释怀深","text":"一钵迢迢历数州，朱门白屋信缘求。\n如今茧足归来也，自在沩山一牯牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1831,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其七十二","author":"释怀深","text":"拍手相逢笑不休，本来无證亦无修。\n人人尽是阿罗汉，何必天台雁荡求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1832,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其七十三","author":"释怀深","text":"长夏无别趣，调和羹一釜。\n滋味颇馨香，刚地成点污。\n口是祸之门，舌是斩身斧。\n陪却三斤铁，只因看锢鏴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1833,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其七十四","author":"释怀深","text":"慧林小院子，恰似一只船。\n终日行上水，须得众人牵。\n出入底出入，说禅底说禅。\n做饭底做饭，打眠底打眠。\n有时甜似蜜，有时苦如连。\n恁么度众生，笑倒老金仙。\n若问西来意，令人肚里煎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1834,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其七十五","author":"释怀深","text":"滕王阁畔遥招手，汴水堤边未点头。\n要得锦鳞来上钓，大家撑动木兰舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1835,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其七十六","author":"释怀深","text":"以法传心，似衣表信。\n黄梅山头，白莲峰顶。\n分付曹溪路上人，一模铸就黄金印。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1836,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其七十七","author":"释怀深","text":"今朝四月十五，已见炎炎酷暑。\n只宜摇扇饮水，岂可谭今引古。\n却请九仙长老，倾些清凉法雨。\n众中钉觜禅和，便好出来进步。\n问教口似磉盘，始信长老难做。\n亲长老，自照顾，发机须是千钧弩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1837,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其七十八","author":"释怀深","text":"慧林投老入红尘，俯仰三年成跺权。\n自笑欲归归未得，时时送客出都城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1838,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其七十九","author":"释怀深","text":"世事悠悠，不如山丘。\n青松散日，碧涧长流。\n山云当幕，夜月为钩。\n卧藤萝下，块石枕头。\n饥餐混饮浑无事，自在沩山水牯牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1839,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其八十","author":"释怀深","text":"著黑衣，护黑柱。\n虎不食斑，恶伤其侣。\n云何狮子身中虫，终朝返食狮子血。\n忍痛金毛不作声，个中滋味难分雪。\n从咬齧，愿尔回光返照时，始信虚空无两舌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1840,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其八十一","author":"释怀深","text":"下初死却爷共娘，二十馀年割不断。\n今朝打破骨董箱，请我升堂举公案。\n古灵平地起风波，瞌睡禅人不奈何。\n地狱天堂都莫问，大家随例吃燠鹅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1841,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其八十二","author":"释怀深","text":"佛病与祖病，众生心上疑。\n情尘一念脱，消散如风吹。\n试问诸病源，起灭从何依。\n来从何所来，去向何所归。\n若能直下见，苦痛无毫釐。\n不见维摩老，文殊问疾时。\n聚头说药方，失却狮子儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1842,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其八十三","author":"释怀深","text":"得者长生，服之不死。\n神农不知名，耆婆无处讨。\n破除佛祖病，扫荡无明烦恼。\n物物头头不覆藏，灵光洞耀何人晓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1843,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其八十四","author":"释怀深","text":"过去事如梦，了然无罅缝。\n要当做梦时，便作觉时用。\n未来事如电，有无不可见。\n莫将希望心，昧却娘生面。\n见在事如云，目前仿佛有。\n安得东南风，吹散西山口。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1844,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其八十五","author":"释怀深","text":"十年做长老，今年闹吵吵。\n思量世间事，佛也不可晓。\n昨日买个卦，卜道来年好。\n财帛星入门，虚耗鬼去了。\n知事与头首，各著些孔窍。\n盛点两瓯茶，多陪一面笑。\n大家说些快活禅，免教拄杖生烦恼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1845,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其八十六","author":"释怀深","text":"大悲时时降生，诸佛头头无间。\n者里裂破面门，荐取通身手眼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1846,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其八十七","author":"释怀深","text":"时节因缘自有由，知音千里远相求。\n寒山陌上才招手，拾得溪边已点头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1847,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其八十八","author":"释怀深","text":"五叶花敷大地春，泥牛鞭起著精神。\n好将一苇堂前曲，举向东州路上人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1848,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其八十九","author":"释怀深","text":"晓来雨过地无尘，绿暗红疏烂熳春。\n拄杖花开人不会，等闲昧却本来身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1849,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其九十","author":"释怀深","text":"春睡不知晓，觉来天已光。\n七条衣未著，五味粥先香。\n宰相鸡鸣起，凡夫彻夜忙。\n不知禅和子，将底报君王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1850,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其九十一","author":"释怀深","text":"白日人事劳攘，夜里只了瞌睡。\n忘记安排说禅，且望诸人不罪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1851,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其九十二","author":"释怀深","text":"千般说，万般喻，特地令人转不悟。\n西风昨夜泄天机，郁郁黄花香满路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1852,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其九十三","author":"释怀深","text":"欣逢诞圣时，无以报明主。\n唯凭一炷香，更击三通鼓。\n唱起太平歌，共行向上路。\n只愿尧天日月长，待见黄河清万度。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1853,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其九十四","author":"释怀深","text":"北风如箭射庭除，冷落禅门一物无。\n多谢诸人相暖热，殷勤为我作开炉。\n老僧来慧林，四见书云节。\n不解巧逢迎，岂敢多饶舌。\n瞋即听你瞋，拙即从我拙。\n要透祖师关，放教心地歇。\n若不歇，腊月三十日，一时都败阙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1854,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其九十五","author":"释怀深","text":"十年持钓在江湖，蒻笠蓑衣只自如。\n忽尔竿头浮子动，等闲钓得一头鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1855,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其九十六","author":"释怀深","text":"慧林铁馒头，做来年已久。\n不是不拈出，自是人不受。\n觑著齿牙寒，咬著眉头皱。\n不是张鹏举，谁人敢下口。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1856,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其九十七","author":"释怀深","text":"祖师妙诀，头头漏泄。\n众生日用不知，只管强生分别。\n岂不见灵云陌上桃花，赵州指出庭前柏。\n别别，正似红炉一点雪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1857,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其九十八","author":"释怀深","text":"夜来看上元，一觉到天晓。\n纸被暖如春，被底呵呵笑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1858,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其九十九","author":"释怀深","text":"寒食清明都过了，野桃红杏已凋零。\n多时不听檐头雨，特地令人忆镜清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1859,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其一○一","author":"释怀深","text":"四海五湖人，慧林同禁足。\n譬如学牧牛，身心要淳熟。\n常耕自己田，莫犯他人谷。\n一句若参差，九旬何面目。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1860,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其一○二","author":"释怀深","text":"万法是心光，诸缘唯性晓。\n衲僧恁么会，钻头入荒草。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1861,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其一○三","author":"释怀深","text":"身心一如，身外无馀。\n便恁么会，缘木求鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1862,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其一○四","author":"释怀深","text":"寒来共向无烟火，饭了同烹雪色茶。\n饱食高眠无一事，不知何以报官家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1863,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其一○五","author":"释怀深","text":"布施门开非一朝，云山千里肯辞劳。\n尘中欲听无生曲，座上先横智慧刀。\n贴肉汗衫容易施，有心道者却难消。\n愿公福似鄱台塔，一层高了一层高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1864,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其一○六","author":"释怀深","text":"盛暑隆寒相继来，慧林四见地炉开。\n衲僧向火知方便，切忌团圞守死灰。\n恁么恁么即易，不恁么不恁么却难。\n直教枯木再生花，任是寒灰重起焰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1865,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其一○七","author":"释怀深","text":"火焰时时转法轮，广长舌相耀乾坤。\n衲僧不会转身句，烁破娘生旧面门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1866,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其一○八","author":"释怀深","text":"水中盐味，色里胶青。\n决定是有，不见其形。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1867,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其一○九","author":"释怀深","text":"炭头今日地炉开，涩雨悭风恼破怀。\n老僧向火吃酸豏，谁管檀那来不来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1868,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其一一○","author":"释怀深","text":"皓月团团照碧天，鳌山灯火不须然。\n吾皇恭俭人心乐，自有叹声四海传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1869,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其一一一","author":"释怀深","text":"忆昔在山日，眠云并枕石。\n如今城里居，欲去去不得。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1870,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其一一二","author":"释怀深","text":"日暖旌旗壮凤城，圣君勤俭古风清。\n宝刀不染匈奴血，四海从今自太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1871,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其一一三","author":"释怀深","text":"顺天门外古招提，烂熳春光照锦溪。\n物物更无心外法，个中能有几人知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1872,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其一一四","author":"释怀深","text":"牵率归来口懒开，婆娑重陟旧猊台。\n孤云本是无心物，又被东风拘管来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1873,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其一一五","author":"释怀深","text":"夜来春睡烂如泥，禁漏声残总不知。\n翻忆南泉好言语，如斯痴钝也还稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1874,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其一一六","author":"释怀深","text":"不唯禁足，亦乃禁口。\n不唯禁口，亦乃禁手。\n不唯禁手，亦乃禁心。\n禁心不禁口，日日嫌佛丑。\n禁口不禁手，累及眉头皱。\n禁手不禁心，罪过转弥深。\n禁足更禁口，蚁子衔椀走。\n禁口更禁手，垂杨生左肘。\n禁手更禁心，大地是黄金。\n要得一夏安乐，细看两重注脚。\n山僧恁么说话，大似不龟手之药。\n明珠一颗价难酬，不是知音便暗投。\n翻笑药山空费力，水清鱼现不吞钩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1875,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其一一七","author":"释怀深","text":"相送无言泪满巾，溪头黄叶正纷纷。\n劝君更进一杯酒，西出阳关无故人。\n一口吸尽西江水，不知何地著离情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1876,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其一一八","author":"释怀深","text":"六年扫洒皇家寺，一日君恩得游还。\n拄杖重挑旧瓶钵，者回信脚入青山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1877,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"前往焦山历代尊宿真赞 珍禅师","author":"释怀深","text":"末上开山师最劳，栽松种竹意何高。\n舟横断岸无人识，几度因风弄海涛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1878,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"前往焦山历代尊宿真赞 伦禅师","author":"释怀深","text":"一著天衣无缝袄，平常话语暖如春。\n山蔬纸帐家风在，谁是当年听法人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1879,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"前往焦山历代尊宿真赞 佛印禅师","author":"释怀深","text":"水翻千偈亦轻酬，一笑瓯峰万事休。\n今古碧桃湾底路，几多风月属渔舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1880,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"前往焦山历代尊宿真赞 深禅师","author":"释怀深","text":"南山拾得劫初铃，乡曲谁人会此声。\n拨转海门关棙子，云楼月殿一时成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1881,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"前往焦山历代尊宿真赞 从禅师","author":"释怀深","text":"雪眉岩顶鹤精神，淡薄家风世少邻。\n明月芦花藏不得，老来重跨铁麒麟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1882,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"前往焦山历代尊宿真赞 慈受和尚自赞","author":"释怀深","text":"因风便作海门居，钓尽波澜未见鱼。\n水冷云寒归未得，笑看新月上珊瑚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1883,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"前住慧林历代禅师真赞 圆照法空禅师","author":"释怀深","text":"大圆镜中，真光明炬。\n慈中有威，击涂毒鼓。\n威中有慈，辟荆棘路。\n无缘饰，没遮护。\n一切众生，睹相而悟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1884,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"前住慧林历代禅师真赞 觉海冲禅师","author":"释怀深","text":"言简理直，道高德重。\n无妄谈笑，无妄迎送。\n衲子入门，毛发耸动。\n密密处，莫能观，倚天灵刃照人寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1885,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"前住慧林历代禅师真赞 佛陀逊禅师","author":"释怀深","text":"转方作圆，辉今耀昔。\n龙袖三关，金锤一击。\n五十馀年，胁不至席。\n逆鳞句，阿谁识，生死观来如戏剧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1886,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"前住慧林历代禅师真赞 佛光正禅师","author":"释怀深","text":"炟赫佛光，逆顺无碍。\n道传昆山，声飞湖海。\n戏笑怒骂，皆师三昧。\n风流处，更尤佳。\n曾悟庭前柏，春风二月花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1887,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"前住慧林历代禅师真赞 祖印悟禅师","author":"释怀深","text":"师道平夷，师貌浑厚。\n持如地心，开无妄口。\n四坐道场，一尘不受。\n节角处，没窼臼，三眼神龟火里走。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1888,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"前住慧林历代禅师真赞 月印禅师","author":"释怀深","text":"凛然孤风，粲然眉目。\n利剑当门，谁敢轻触。\n脱略处，妙难传，万仞峰前驾铁船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1889,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"退步 其一","author":"释怀深","text":"万事无如退步人，摩头至踵自观身。\n只因吹灭心头火，不见从前肚里瞋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1890,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"退步 其二","author":"释怀深","text":"万事无如退步人，孤云野鹤自由身。\n松门十里时来往，笑揖峰头月一轮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1891,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"退步 其三","author":"释怀深","text":"万事无如退步人，淡中滋味最天真。\n炉边向火慵开口，睡里抓头忘却身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1892,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]