[{"title":"和李相园亭 其一","author":"李弥逊","text":"轩户新成紫翠边，花光竹色借厨烟。\n诗人莫浪誇盘谷，画手无工貌辋川。\n何必吾庐在丘壑，要令是处有林泉。\n此心正恐无人会，把酒南山一笛前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60775,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和陈颖仲题刘鞠祠","author":"李弥逊","text":"山绕平湖绿四边，两翁遗泽到今传。\n蘋风引钓鱼随艇，谷雨催耕水拍田。\n败壁丹青悲落日，荒庭绅笏想流年。\n桐乡不废春秋祀，箫鼓鸡豚久更虔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60776,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和尚书兄留题兴福","author":"李弥逊","text":"殿阁群峰合，山根一水长。\n檐楹接云树，钟磬杂风篁。\n客枕愁花雨，斋鱼搅梦梁。\n篮舆隔溪路，目断佛龛香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60777,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和明甫南山用粹之韵","author":"李弥逊","text":"寻源探穴上林丘，宛似愚溪柳柳州。\n树拥千头争地出，江分一股抱山流。\n阴堂阁雨云生屋，晚浦收潮草泛舟。\n幽兴未穷留眼力，将雏结友更深游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60778,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和舍弟简公序","author":"李弥逊","text":"百计疏慵一味闲，杖藜无日不寻山。\n着鞭每到羲皇上，扶履欣同季孟间。\n寸步思君劳远梦，七言惊我动衰颜。\n定无戛玉酬人句，拙速应胜隔岁还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60779,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和渊老妙现之什","author":"李弥逊","text":"乾坤渺渺一浮尊，万象分明水四滨。\n虎脊横空山作队，鱼鳞倒影海成纹。\n老僧诗罢闲攲竹，幽士馀斋正卧云。\n妙现镜中无一事，世间从此罢挥斤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60780,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和韵仲宗天宁见怀月馀卧病横山得其诗颇动念所以末句见意","author":"李弥逊","text":"病逢木上坐，携我曲栏行。\n远水兼潮阔，层山带角横。\n秋随北雁到，愁向暮蛩生。\n正怯骚人句，诗坛莫浪盟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60781,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和颖仲山行即事","author":"李弥逊","text":"平芜新绿占封圻，横路游丝网落晖。\n山径人稀藏窈窕，禅扉春尽老芳菲。\n缓行照水知鱼乐，随意穿花见蝶飞。\n二子舁篮今夜月，龙钟犹胜杖藜归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60782,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"奉陪赵彦术登叠嶂还饮陵峰梅竹间","author":"李弥逊","text":"春晓飞花一尺围，旋看风力屑琼瑰。\n广寒宫殿千门启，群玉峰峦四面开。\n直节自强深笑竹，清姿堪并绝知梅。\n使君剩有延枝意，收拾寒光上酒杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60783,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"奉酬龙兴益老伽陀","author":"李弥逊","text":"居士心如出岫云，逢场作戏不求真。\n桃花自落非关雨，梅子半黄知是春。\n此外更无身外事，闲中那得个中人。\n箭锋相拄君休问，千里同风始见亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60784,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"学士兄还乡之始会宾亲石门寺以病不能往公晔颖仲有诗次韵","author":"李弥逊","text":"群贤嘉会走舆臣，乍喜郎星照七闽。\n寺近南塘钟秀丽，筵开晚水荐甘珍。\n放怀想尽百川饮，留客应生四角轮。\n我独沉疴方面壁，愈风赖有两骚人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60785,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宝学连公挽诗 其二","author":"李弥逊","text":"弱冠论交老更坚，平生风义想前贤。\n银峰告政一千里，雁塔联名四十年。\n漫许赤心酬雨露，终成白发傲林泉。\n酸风送子寒山暮，鸣壑摇松亦泫然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60786,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宝学连公挽诗 其一","author":"李弥逊","text":"男儿死尔未应悲，可惜胸中尚有奇。\n绝域英声宜早岁，楚庭高议补明时。\n壮怀自感中流楫，旧爱今存岘首碑。\n天独不能遗此老，盖棺两鬓未全丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60787,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"知郡郑公挽诗","author":"李弥逊","text":"拾芥声名早岁驰，白头有蕴未全施。\n向来茂草无留讼，是处甘棠有去思。\n才术旧闻优少赣，交游剩欲赖当时。\n谁知沱水歌来暮，翻作西城薤露诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60788,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"知郡韩公挽诗 其二","author":"李弥逊","text":"雁塔联名旧，盐车得路先。\n凌云曾诵赋，纵壑愿推贤。\n继剖龙溪竹，同归象骨田。\n伤心老盘谷，谁与序山川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60789,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"知郡韩公挽诗 其一","author":"李弥逊","text":"夫君抱清节，独秀不求知。\n晋鄙多薰德，阌乡早出奇。\n功名天靳惜，正直自扶持。\n赖有仁风在，朱轓两郡遗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60790,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴已未发临安偶成","author":"李弥逊","text":"君休更问小行年，浮水虚舟已信缘。\n拂袖家山须及早，着鞭春色已输先。\n吾庐竹暗闽山月，别墅花迷浙步船。\n欲学少陵闲事业，晴窗点检白云编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60791,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"苦早","author":"李弥逊","text":"单练直似御重袍，碧盌冰浆饮尚豪。\n满载骊珠思薏苡，堆盘马乳说蒲萄。\n轻雷破远喧鼍鼓，小雨遮空簇猬毛。\n谁挽天河洗炎酷，冷云凉月助风骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60792,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"范参议宜人高氏挽诗 其二","author":"李弥逊","text":"兰玉无偏爱，衾裯不忍欺。\n甘辛同逆旅，生死独先知。\n马鬣苔封合，鱼机宝帐遗。\n酸风入松槚，空作暮山悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60793,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"范参议宜人高氏挽诗 其一","author":"李弥逊","text":"毓秀勋庸后，来嫔诗礼家。\n浮云轻富贵，朽木视铅华。\n晚日俄晞露，春风自笑花。\n平生偕老志，愁绝五云车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60794,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郑尚明学士挽诗 其二","author":"李弥逊","text":"四十才名重，归来白发侵。\n一官驹在谷，有子鹤鸣阴。\n剩著潜夫论，今亡子敬琴。\n送车知几两，松壑助哀音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60795,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郑尚明学士挽诗 其一","author":"李弥逊","text":"人物羲皇上，尘中无此流。\n高谈悲管晏，老手命曹刘。\n室有芝兰弃，家馀钟鼎收。\n平生断金约，堕泪盖棺休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60796,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"采蘋亭分韵得花字","author":"李弥逊","text":"楼头钟鼓晓催衙，吏散庭空日已斜。\n烽火望中常作客，簿书丛里偶成家。\n阴阴密叶榴垂实，剪剪新荷藕结花。\n小立方塘一杯酒，又传归恨到天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60797,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"驾还观灯","author":"李弥逊","text":"琳宇风微宝辂还，春随人意却馀寒。\n金堤花拥华芝盖，银汉云扶白玉盘。\n宴及臣邻三事协，欢均区宇九夷安。\n年年端阙龙灯试，万岁声中拜舞看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60798,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南山送客席上次明甫韵","author":"李弥逊","text":"江北江南可避喧，已甘丘壑寄馀年。\n筠梢松盖一区宅，莲叶菱花二顷田。\n秋到登山更临水，夜归骑马似乘船。\n醉中不必分乘坠，世事从头一梦然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60799,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南楼","author":"李弥逊","text":"百尺危楼枕水滨，风烟入眼乱纷纷。\n趁虚渔唱来成市，入垄田歌去作群。\n阁雨云深山着帽，驾潮风急浪翻云。\n寄言残夜明楼月，莫负胡床老使君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60800,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南楼晚望","author":"李弥逊","text":"海角长安望尔赊，日边云影更横斜。\n身闲梦觉俱成蝶，眼病朝昏只见花。\n可但陶潜能避俗，不应范蠡便浮家。\n君恩未报惊华发，目断飞鸿水四涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60801,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"复用前韵约蹈元顾","author":"李弥逊","text":"时序惊人咄咄来，荣枯毕竟为谁催。\n风将满地飞红去，日拥半天高绿回。\n顾我似尝当道李，渴君如望隔林梅。\n一年春事无多子，唤取提壶触处开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60802,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫使待制舍人赵公挽诗 其三","author":"李弥逊","text":"忆昨司青琐，公时对紫薇。\n午轩评谏草，晓殿缀朝衣。\n金石平生契，人琴此日非。\n白头情易感，无泪与君挥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60803,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫使待制舍人赵公挽诗 其二","author":"李弥逊","text":"曲突深时虑，长裾鄙世流。\n无书来北阙，有意在东周。\n旷远嵇中散，疏慵马少游。\n长松想风表，千古閟山丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60804,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫使待制舍人赵公挽诗 其一","author":"李弥逊","text":"秀出青徐野，风移邹鲁乡。\n家声齐丙魏，人物到轩黄。\n漫士从三已，危机付两忘。\n并游无此老，谁与共行藏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60805,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"将到金陵投宿乌江寺","author":"李弥逊","text":"阅世真成一梦阑，尘埃谁复共开颜。\n辛壬癸甲常为客，南北东西只问山。\n萦树远云高作盖，护田流水曲于环。\n秋风送我江边寺，准拟如今到处闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60806,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"彦节判宗观察挽诗 其二","author":"李弥逊","text":"俭素师寒隽，谦冲识老成。\n养亲公族化，取友士林倾。\n贺屦填门近，灵輀赴垄轻。\n悲欢反覆手，挥泪湿铭旌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60807,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"彦节判宗观察挽诗 其一","author":"李弥逊","text":"国步增磐石，维城协梦熊。\n风神龙种异，才格马群空。\n家训惟知白，官箴祇自公。\n拊棺伤有德，天意或难穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60808,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"彦术权郡大夫相邀昭亭以病酒不果往得所示佳句辄次韵呈","author":"李弥逊","text":"五马行春路，松行旧不斜。\n醉眠方梦草，游骑想穿花。\n访古千秋暗，逃禅百虑赊。\n归来传丽句，字字敌春华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60809,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"待月久不至须臾云破星露溪光发众宾欢呼席上次德甫韵","author":"李弥逊","text":"待月新亭兴已慵，眼花空乱烛花红。\n溪山路隔烟尘外，觞咏身疑梦寐中。\n却暑已烦瞋恚雨，扫云须赖吉祥风。\n水光已报冰轮信，一笑能令万斛空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60810,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"故相少师李公挽诗 其四","author":"李弥逊","text":"白发陈雷旧，交情贵不渝。\n诗笺留晓炬，书雁聚春芦。\n忧国言犹在，知心道已孤。\n江皋一襟泪，不复见夷吾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60811,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"故相少师李公挽诗 其一","author":"李弥逊","text":"天意康时难，贤生盖世雄。\n风流晋人上，事业舜歌中。\n许国回天力，怀君贯日忠。\n平生英爽气，凛凛未成空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60812,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"故相少师李公挽诗 其三","author":"李弥逊","text":"去国头方黑，伤时鬓易丝。\n徙薪谋独验，击楫志空悲。\n尚想嘉猷告，曾闻大政咨。\n两楹歌昨梦，忍诵慭遗诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60813,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"故相少师李公挽诗 其二","author":"李弥逊","text":"国步乘阳九，胡尘暗上京。\n支倾隆大厦，却敌隐长城。\n草木知春泽，狐狸绝夜鸣。\n云台瞻衮绣，千古继哀荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60814,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日杂咏 其九","author":"李弥逊","text":"轩冕真成寄，江山早见招。\n懒从春后觉，意别枕边消。\n竹色侵书静，松声落耳摇。\n妄心朝雾薄，乌鹊莫相撩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60815,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日杂咏 其八","author":"李弥逊","text":"二月忽已破，一春强半过。\n提壶工唤客，布谷巧当歌。\n得酒先愁尽，惜花翻恨多。\n逢辰不为乐，明日复如何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60816,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日杂咏 其七","author":"李弥逊","text":"懒慢嵇中散，宽闲得自怡。\n抱衾长恨晚，倒屐不嫌迟。\n网日蛛丝挂，梳烟柳发垂。\n朝来被花恼，浪走习家池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60817,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日杂咏 其六","author":"李弥逊","text":"不作觚棱梦，长闲地角身。\n南冠欲从楚，西笑敢怀秦。\n鸿雁犹千里，牛羊绝四邻。\n门罗今可设，更恐白头新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60818,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日杂咏 其五","author":"李弥逊","text":"忆昨金门侍，晨参玉佩声。\n解缨青琐闼，束载锦官城。\n日与长安远，春随上苑生。\n执鞭非所好，独抱恋轩情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60819,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日杂咏 其四","author":"李弥逊","text":"役役炎凉态，悠悠道路赊。\n情怀知老大，梦幻阅纷华。\n搅思云边树，供愁雨外花。\n生涯书一束，到处即为家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60820,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日杂咏 其三","author":"李弥逊","text":"渐欲抛书卷，行藏任转蓬。\n负暄携稚子，抱熟觅邻翁。\n接叶犹妨径，拳芽未着丛。\n主林真好事，为我结新红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60821,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日杂咏 其二","author":"李弥逊","text":"幽栖足春事，晴日若相催。\n屐齿穿沙稳，筇须碍竹回。\n风光初转蕙，残雪欲欺梅。\n自是经过少，柴门日日开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60822,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日杂咏 其一","author":"李弥逊","text":"春到陵阳市，人家泊翠微。\n南烹甘入箸，北户暖生衣。\n花暗昭亭寺，鱼肥句水矶。\n乐游须结社，倒著接䍦归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60823,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春阴遣兴","author":"李弥逊","text":"老去逢时秪自惊，春风三过小长汀。\n壮心更事已全白，短发耐愁犹半青。\n酿雨山云昏败屋，唤晴风竹响寒厅。\n干戈南北归无路，付与身随水上萍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60824,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春近风日渐佳与似表弟开小户纵步后庭","author":"李弥逊","text":"围炉人散长寒煤，暖日还催墐户开。\n春近郊原思梦蝶，雪残池馆见真梅。\n客愁宛转凌双鬓，岁律侵寻寄一杯。\n试绕小栏寻翠甲，履痕犹占旧苍苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60825,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春雨久不止戏呈诸公","author":"李弥逊","text":"蕉上雨声无尽来，龙疲应困阿香催。\n竹萌出土囊锥见，燕觜得泥风鹢回。\n料峭侵衣犹带臈，廉纤昏昼已如梅。\n愁边酒盏都无力，更着浓阴拨不开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60826,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春雨不止复用前韵书怀呈诸友","author":"李弥逊","text":"时序惊人翻手云，不禁风雨破除春。\n岸容故故留花使，夜色明明助稼神。\n异县逢人思故旧，长年作客见疏亲。\n穷途自喜多闲日，虚费公家十束薪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60827,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋日同刘方明游石师岩","author":"李弥逊","text":"翠合峰峦万叶稠，云擎佛屋出岩幽。\n秋光不到庭阴树，晓日先明竹外楼。\n户牖高低分世界，川原远近失汀洲。\n阳休示我真消息，更在灵山最上头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60828,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋月回文","author":"李弥逊","text":"霜盘玉隐倒团金，迥水秋天碧夜侵。\n光掩半扉寒夜永，影分疏竹翠轩深。\n长空远岫归云捲，古木高风浥露沉。\n凉袂客愁应梦楚，长城晓角夜悲吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60829,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"饮酒 不寐","author":"李弥逊","text":"不寐苦长夜，起看天未明。\n疏星微占晓，宿雾冷遮晴。\n人逐秋风老，事随朝日生。\n南飞多过雁，早寄靖边声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60830,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"饮酒 多病","author":"李弥逊","text":"茗椀醒昼寝，粥盂供晚餐。\n支离惭受粟，拓落笑为官。\n幡影伽蓝古，铃声窣堵寒。\n病多闲步屐，犹可据征鞍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60831,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"饮酒 怀远","author":"李弥逊","text":"去年别怀玉，山净觉秋高。\n岁月频思梦，江湖多怨涛。\n无书寄风翼，有鬓着霜毛。\n独立寒汀暮，忘言正郁陶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60832,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"饮酒 临海观望","author":"李弥逊","text":"指极分南北，观澜混浊清。\n荡胸金饼上，觌面玉绳横。\n洲渚平沤发，风云一噫生。\n神山端可往，九万作宽程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60833,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"饮酒 晚望","author":"李弥逊","text":"寒日倚江阁，晚云低可攀。\n溪翁随水上，田妇赴虚还。\n幻境梦占梦，畏涂山复山。\n乾坤有馀地，闲处着衰颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60834,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋晚十咏 散策","author":"李弥逊","text":"散策北岗路，牛羊归径深。\n水穷人小立，山静客微吟。\n点点稻花雨，团团榕叶阴。\n田翁罢争席，明日共幽寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60835,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋晚十咏 瞑坐","author":"李弥逊","text":"隐几北窗静，柏烟生鼎迟。\n雨焦寒入座，风竹暗侵篱。\n贝叶谈无相，桃花现不疑。\n叩床呼稚子，怜到暮钟时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60836,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋霜阁","author":"李弥逊","text":"十月水西寺，兴穷还为留。\n净坊深闭雨，虚阁暗藏秋。\n妄尽霜中叶，身闲水上鸥。\n知几伤太白，五月念貂裘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60837,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送王彦声归苕溪 其二","author":"李弥逊","text":"相逢华发两星星，旧事邯郸一梦惊。\n舌底雌黄谙世味，眼中青白见交情。\n馀杯更觅论文具，好树休啼唤客声。\n后夜扁舟苕霅路，半轮寒月一溪横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60838,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送王彦声归苕溪 其一","author":"李弥逊","text":"盛世英才偶未逢，寄身无地转如蓬。\n诗亲东野穷尤壮，赋拟相如老更工。\n雕鹗不飞行奋迅，璠玙未献要磨砻。\n会须自要唐衢荐，谁与吹嘘借便风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60839,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送仲宗之建安","author":"李弥逊","text":"老翁更事几河沙，苦爱溪头管物华。\n种竹成林心未足，买船载月思无涯。\n黄莺唤友非多事，白鹭窥鱼更可嗟。\n念子蓝舁晚山里，可能来共拾馀霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60840,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]