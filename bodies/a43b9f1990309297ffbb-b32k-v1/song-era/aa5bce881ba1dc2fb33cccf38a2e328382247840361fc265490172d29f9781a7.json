[{"title":"柳词","author":"郭磊卿","text":"春风垂柳丝，只向庭前住。\n妾心逐征夫，万里天南去。\n柳枝纵多绵，妾梦不知数。\n少年学得画双眉，今日看看作愁具。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61617,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"朱萼亭侍宴","author":"郭稹","text":"九重香辇出，三月御庭开。\n圣酒鸾杯酌，宫花羯鼓催。\n莺声压歌管，山色满亭台。\n睿赏欢无极，叨陪愧不才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61618,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻延州警","author":"郭稹","text":"塞日兵前惨，城烟战后无。\n分明千帝纪，况乃畔天都。\n桂玉京师涌，金汤鄜路孤。\n迟回思庙算，端坐愧龙图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61619,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和枢密侍郎因看海棠忆禁苑此花最盛","author":"郭稹","text":"朱栏明媚照横塘，芳树交加枕短墙。\n传得东君深意态，染成西蜀好风光。\n破红枝上仍施粉，繁翠阴中旋扑香。\n应为无诗怨工部，至今含露作啼妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61620,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"老卒","author":"郭震","text":"老来弓剑喜离身，说著沙场更怆神。\n任使将军全得胜，归时须少去时人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61621,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"纸窗","author":"郭震","text":"偏宜酥壁称闲情，白似溪云薄似冰。\n不是野人嫌月色，免教风弄读书灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61622,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诗二首 其二","author":"郭震","text":"江楼四面立屏风，到此诗家合用功。\n沽酒店藏花影内，打渔村在浪声中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61623,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诗二首 其一","author":"郭震","text":"流落天涯与海涯，旧山终日恨归迟。\n思量却得蹉跎力，会尽人间一肚皮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61624,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"海棠","author":"郭震","text":"又随桃李一时荣，不逐东风处处生。\n疑是四方嫌不种，教于蜀地独垂名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61625,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宿渔家","author":"郭震","text":"几代生涯傍海涯，两三间屋盖芦花。\n灯前笑说归来夜，明月随船送到家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61626,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔者","author":"郭震","text":"江柳弄风颦翠黛，山光著雨湿胭脂。\n却收短棹拈长笛，一叶舟中仰面吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61627,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题龙华山","author":"郭震","text":"昔年曾到此山来，百鸟声中酒一杯。\n最好寺边开眼处，段文昌有读书台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61628,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其一","author":"郭震","text":"人世几番更面目，仙山依旧锁烟霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61629,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其二","author":"郭震","text":"前山尚自无人到，更说后山山更高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61630,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其四","author":"郭震","text":"半欲离披半欲开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61631,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送吴中复镇长沙","author":"郑獬","text":"初登西汉文章府，便领吴王第一州。\n绕郭白云衡岳近，满帆明月洞庭秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61632,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮","author":"郭□□","text":"卖饧天气箫声软。\n午院水沉烟未断。\n睡起补残眉。\n红绵入镜迟。\n霎时开笑靥。\n花上看双蝶。\n新月上帘钩。\n相思不断头。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61633,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"朝中措 改欧阳修词","author":"都下妓","text":"屏山栏槛倚晴空。\n山色有无中。\n手种庭前桃李，别来几度春风。\n文章宰相，挥毫万字，一饮千钟。\n行乐不须年少，尊前看取仙翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61634,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次太守李侍郎和郡博士包丈芍药韵二首 其二","author":"钱亿年","text":"艳草妖花理易残，无劳太息抚雕栏。\n终年费尽壅培力，能共樽前几日看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61635,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次太守李侍郎和郡博士包丈芍药韵二首 其一","author":"钱亿年","text":"栽花未免惜花残，忙里应须护小栏。\n何似长松与修竹，不妨耐久静中看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61636,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次游玉虚洞韵","author":"钱亿年","text":"茂松修竹昼阴阴，涧水幽流一径深。\n未必山中无外事，须知静躁总因心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61637,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈盛逢时","author":"钱亿年","text":"倦翮知还心已休，无穷世事懒回头。\n是非不属闲人耳，月自当空水自流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61638,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和唐子固见寄初冬晚步韵","author":"钱亿年","text":"凄风满寒谷，广陌照落日。\n繁霜排岸草，尪瘁怯寒慄。\n块坐阅残编，十日九不出。\n时为孤愤吟，嗟嗟类蟋蟀。\n歧路多阻艰，烟霞成痼疾。\n保是千金躯，他慕无终毕。\n远览尘垢外，无得初无失。\n溺志胶扰间，跧跽信匪一。\n阮生亦有言，何异裈中虱。\n呼童洗破觥，一醉真可必。\n耳热即呜呜，鄙野谁诃诘。\n浩歌莫予知，奚用聆清瑟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61639,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重阳","author":"钱亿年","text":"商飙惊秀木，松桂不受秋。\n萸菊有光辉，芬芳满金瓯。\n古来贤达人，逢时聊解忧。\n龙山孟参军，帽落初不羞。\n东篱陶徵士，得酒更何求。\n若人不常有，至今称风流。\n节物自尔殊，生灭同一沤。\n浮世梦幻身，适意是良谋。\n山翁未尝乐，而亦未尝愁。\n吾独可奈何，任渠自悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61640,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"避暑椒山呈潘师清","author":"钱亿年","text":"凉风生层峦，炎日遮叠嶂。\n我来兹地游，心焉乐清旷。\n为吏即华颠，愧临士民上。\n老丑畏近人，筋骸非少壮。\n知止远卑辱，奚敢谓高尚。\n龊龊方自持，良心未容放。\n促柱有繁音，庞聒无清唱。\n却暑御絺绤，自修终弭谤。\n居闲无适莫，且免萦重恙。\n俯仰心不惭，无言亦疏畅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61641,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春夜","author":"钱大椿","text":"燕子衔泥已下帘，深深庭院薄寒天。\n海棠枝上黄昏月，杨柳梢头浅澹烟。\n勾引芳情春梦蝶，频催愁绪夜啼鹃。\n踏青年少归来晚，斗酒花阴枕石眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61642,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"踏莎行","author":"钱宀孙","text":"征雁云深，乱蛩寒浅。\n惊心怕见年华晚。\n萧疏堤柳不禁霜，江梅瘦影清相伴。\n舞暗香茵，歌阑团扇。\n月明梦绕天涯远。\n断肠人在画楼中，东风不放珠帘卷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61643,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游苍玉洞","author":"钱元忠","text":"峭嵘乱石满陵冈，颜色苍润如琳琅。\n神恻鬼□□□惨，牛眠虎跳深伏藏。\n太湖灵壁不足数，涪水□麦熟可方。\n剥苔剔藓验古刻，诸贤□□腾光茫。\n如此至宝岂易得，宜檄山灵护□□。\n□□□□□□□，却恐六丁下取将。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61644,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登黄花亭遗址","author":"钱元鼎","text":"隔城舒晚啸，信步得高台。\n亭去名犹在，霜迟菊未开。\n浮云西日下，明月大江来。\n逸思飞难禁，昏钟何处催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61645,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和许仲涂郎中游山","author":"钱公辅","text":"每同南郭先生到，今伴东牟太守来。\n自顾拙疏聊自乐，白云径里踏荒苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61646,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"众乐亭二首 其二","author":"钱公辅","text":"势压平湖四面佳，好风明月是生涯。\n鲸鲵背上浮三岛，菡萏香中放两衙。\n屏列已疑云母净，帘垂不待水精奢。\n此心会笑元丞相，终日楼台为一家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61647,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"众乐亭二首 其一","author":"钱公辅","text":"谁把江湖付此翁，江湖更在广城中。\n葺成世界三千景，占得鹏天九万风。\n宴豆四时諠画鼓，游人两岸跨长虹。\n他年若数东南胜，须作蓬邱第一宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61648,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"禹穴","author":"钱公辅","text":"一朵云根压众岚，古传深坎自天錾。\n藏书未必先王事，好怪惟闻太史探。\n洞府閒来何寂寞，龙髯垂处认䰐鬖。\n近岩更剖知章字，谩识奇踪意自甘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61649,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄题翠麓寺呈伯强寺丞","author":"钱公辅","text":"曩时曾作家山游，亭有翠麓排新幽。\n疏轩密牖竹锵戛，烈风劲雨松飕飗。\n呀然出户瞰山足，屹然数竿围上头。\n扫除云峰耸客步，煎煮锡水供茶瓯。\n我时既合众宾饮，醉岸山帻心迟留。\n山僧领我丐诗榜，诗未脱吻惊旋辀。\n四方环走倏已晚，十载负约今方酬。\n珍蓝增葺想胜旧，我已白首縻藩州。\n何当一赋归去来，再款岩室空披搜。\n吾宗道人正嘉遁，摆脱世上无穷忧。\n欣逢主人贤且令，泉石笑傲都相求。\n上人洒扫莫暂闲，行行逆我西来舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61650,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"福州","author":"钱公辅","text":"七闽天东南，群山号未绝。\n其中长乐郡，佳丽比吴越。\n日出朝可攀，地温冬不雪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61651,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蓬莱行","author":"钱公辅","text":"蓬莱谪居香案吏，此语昔自微之始。\n后人慷慨慕前芬，高阁雄名由此起。\n一从圮废知几年，栋摧础断埋空山。\n遗踪馀址杳何处，惟有竹树荒芜閒。\n过者徘徊游者惜，举头不见溪山色。\n寂寞无人欲问谁，神仙有景真虚掷。\n一兴一弊固有时，主人旌旆来何迟。\n下车铓刃得优逸，痛此旧事几凌夷。\n呼工萃材若河决，正值西成农隙月。\n屹然大厦立层巅，百尺崇基鬼神拔。\n虹蜺截空崖险平，一级一级烟云生。\n步武陵虚眉睫湿，四面四面屏障迎。\n时携宾佐恣吟赏，笙歌辈类文章党。\n回眸眩晃相顾笑，莫辨人间与天上。\n观风龌龊环翠低，左右罗列如婴儿。\n鉴湖浩渺稽岭秀，上下延揖生光辉。\n秋日凄清春日媚，冬宜饮雪夏宜醉。\n四时风景各一全，须言不是寻常地。\n乃知真境未易彰，神物宝护天缄藏。\n人谋暗与鬼工合，一日剖露如腾骧。\n越王台榭荒凉后，唐相英灵磨灭久。\n千岩万壑幽隐处，而今尽入人襟袖。\n凭栏黯黯半斜阳，烧烟渔火凝寒光。\n此时撇起千里恨，使人凄哽生断肠。\n隔帘依依渐明月，酒气浩荡歌声滑。\n此时放出百杯欢，使人雍容重击节。\n惟公独作蓬莱主，夜拥琴书杂樽俎。\n胸中气焰欲干斗，座上辞锋欣捉麈。\n嗟余时作蓬莱客，赋咏登临儒者职。\n千日徒教混醉醒，七言未解锵金石。\n蓬莱本在沧溟中，那知平地别有宫。\n方壶圆峤咫尺是，愿乘鹏翼长西东。\n满筵谁匪蓬莱宾，阖境尽是蓬莱民。\n人人共结蓬莱约，行行醉看蓬莱春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61652,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题梵竹卿蓬居","author":"钱文","text":"梅绕蓬居不计株，水仙数畹斗芳腴。\n竺卿白业二香妙，世界红尘一点无。\n可比远公莲社胜，应嗟陶令菊园芜。\n炉薰清鼻茗浇舌，月浸松窗对结趺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61653,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"窊尊绝句","author":"钱文子","text":"招邀风月须坡叟，管领江山属漫郎。\n更筑危亭依巨石，愿从二子老沧浪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61654,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵李使君追悼雪巢先生","author":"钱文子","text":"文龙竟复老污池，一笑应从造化期。\n环顾室庐无长物，流传人世有新诗。\n殷勤池上相从处，悽怆床前永诀时。\n更有后来贤太守，溯风犹解挹清规。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61655,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"白石岩","author":"钱文婉","text":"两道蟠溪锁碧山，飘然仙带绿回环。\n千岩林木沟渠下，万顷沧田指掌间。\n霜月天边清兴远，金钟云里梦魂閒。\n夕阳归步饶仙骑，懒拂烟萝下玉关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61656,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"钱文婉","text":"两岸绮罗春纵目，一天星斗夜凭栏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61657,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诗一首","author":"钱氏","text":"士悲秋色女怀春，此语由来未是真。\n倘若有情相眷恋，四时天气总愁人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61658,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题壁","author":"钱氏","text":"落日西风照楚关，断魂残魄吊衰颜。\n自从鸿鹄分飞后，无复鸳鸯并枕间。\n腕玉瘦宽金缕袖，鬓蝉慵掠翠云鬟。\n秋天冬暮风雪寒，对镜懒把金蝉簇。\n梦魂夜夜到君边，觉来寂寞鸳衾独。\n此时行坐闲纱窗，忍泪含情眉黛蹙。\n古人惜别日三秋，不知君去几多宿。\n山高水阔三千里，名利使人复尔耳。\n昔年曾拨伯牙弦，未遇知音莫怨天。\n去年又奏相如赋，汉殿依前还不遇。\n时人不知双字讹，平川倏忽风波起。\n当时南宫报罢音，教妾沉吟杵中心。\n为君滴下红粉泪，红罗帐里湿鸳衾。\n愤愤调琴蝉鹊噪，默默吟诗怨桂林。\n千调万拨不成曲，争奈胸中气相掬。\n千思万想不成诗，心如死灰谁得知。\n料得君心当此际，事国繁华闲田地。\n朝朝暮暮望君归，日在东隅月在西。\n碧落翩翩飞雁过，青山切切子规啼。\n望尽一月复一月，不见音容寸肠结。\n又闻君自河东来，夜夜不教红烛灭。\n鸡鸣犬唳侧耳听，寂寂不闻车马声。\n自此知君无定止，一片情怀冷如水。\n既无黄耳寄家书，也合随时寄雁鱼。\n日月逡巡又一年，何事归期竟杳然。\n鲛绡裛遍相思泪，眉黛无心画远山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61659,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送何水部蒙出牧袁州","author":"钱丕","text":"白首名郎有几人，双旌昼锦不如君。\n楚江萍暖烘朝日，玉女衣轻挂晓云。\n极浦仙舟烟澹澹，高秘郡阁叶纷纷。\n政成更与他州别，从古宜阳重艺文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61660,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"钱世雄","text":"黄泥坂西春欲回，雪堂万木连云栽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61661,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"招贤里","author":"钱可则","text":"学行文章彻九重，故旌闾里振颓风。\n傍人莫作寻常看，几百年中有此翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61662,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登潇洒亭","author":"钱可则","text":"有缘结得南山境，潇洒亭高最可人。\n此景古今吟不尽，熙熙客里且行春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61663,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"念奴娇","author":"钱处仁","text":"勋门积庆，为皇家此日，重生贤辅。\n崧岳储神须信道，非特当年申甫。\n清白传芳，高明驰誉，材更兼文武。\n黑头年少，风云还会龙虎。\n天为指日垂弧，张旃持节，不遣穹庐去。\n中使传宣，颁赐锡赉，清晓欢声旁午。\n两世光华，一门荣耀，盛事夸今古。\n祝公千岁，庙堂长佐贤主。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61664,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉蓬莱","author":"钱处仁","text":"正梧阴碧转，扇浪凉生，渐回秋意。\n祥绕朱门，有崧灵钟瑞。\n笔走龙蛇，句雕风月，好客敦高谊。\n苏小琵琶，绿珠箫管，日添罗绮。\n邃阁清班，贰车清政，奕叶蝉联，世间谁比。\n行侍甘泉，趁青春荣贵。\n尽卷虾须，满斟鹦鹉，向画堂沉醉。\n铜狄摩挲，蓬莱清浅，八千椿岁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61665,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题静春堂集","author":"钱仲鼎","text":"闭门雪卧远，咏史风情留。\n诗有三百篇，令子手所裒。\n汝翁秀儒林，殖学媲前修。\n六经穷窔奥，万象工雕锼。\n广矣雅音正，悕矣骚情幽。\n照耀明月珠，珍重珊瑚钩。\n一读令人喜，再读令人愁。\n李杜骨已朽，江湖名同流。\n忆昔托末契，东城得追游。\n平时少契阔，暇日多唱酬。\n栎材自揣劣，藻思谁与俦。\n老我岁冉冉，霜鬓风飙飙。\n索居破茅屋，寒拥敝貂裘。\n夜来清梦飞，故绕松江头。\n梦中不识路，修亭渺悠悠。\n粲然见梅花，落月香影浮。\n性情阅千古，感发交未休。\n神交赴冥冥，知我双白鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61666,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题赵鸥波高士图","author":"钱仲鼎","text":"在昔洛阳，雪深丈馀。\n士也高卧，来令尹车。\n今年吴淞，雪复何如。\n积素一色，鸥鹭有无。\n之子江皋，修亭是居。\n有琴有书，有酒有鱼。\n赏静独眺，聊以自娱。\n挹兹清风，凛凛起予。\n此景此图，再卷再舒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61667,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西江月","author":"钱安安","text":"谁道词高和寡，须知会少离多。\n三家本作一家和。\n更莫容他别个。\n且恁眼前同乐，休将饮里相磨。\n酒肠不奈苦揉挼。\n我醉无多酌我。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61668,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"卞壸忠孝堂","author":"钱汝元","text":"哀哉战死国门边，忠孝千年独两全。\n盖有完躯保妻子，诞谩奏凯说麋捐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61669,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽薛艮斋 其一","author":"钱佖","text":"蚤悟传心学，精微造本原。\n读书残万卷，落笔动千言。\n孤邑验英略，流民感至恩。\n颜亡虽可痛，自有不亡存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61670,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽薛艮斋 其二","author":"钱佖","text":"伟矣万人杰，精神运五兵。\n议屯谋甚婉，料敌智尤明。\n谨厚唐刘氏，渊源汉贾生。\n斯文嗟遽丧，哀挽泪纵横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61671,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"白石岩","author":"钱宏","text":"岩下碧藤挂紫烟，岩头白石插青天。\n精灵屹作乡邦镇，一剑霜寒二百年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61672,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"望吴亭次黄二尹韵","author":"钱宏","text":"东望长安山复山，数峰还出两峰间。\n揽衣来即三年戍，引客聊为一日闲。\n身似暮云低更好，心如归鸟倦知还。\n圣朝倘得收遗物，叹息搔头鬓已斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61673,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题九龙岩","author":"钱怀哲","text":"潇湘行迈遇初秋，何幸因官得一游。\n无异醴陵三室洞，九仙羽客是吾俦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61674,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"一斋夜坐","author":"钱时","text":"尽觉山中日月长，何心更梦白云乡。\n池塘夜滴梅花雨，默坐占城一瓣香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61675,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日融堂池上","author":"钱时","text":"岩花不趁中秋约，篱菊齐供九日看。\n冉冉隔墙风不断，夜深和月倚栏干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61676,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九月望徙坐冬窝 其一","author":"钱时","text":"黄花弄影日婆娑，一夜秋风百感多。\n门外红尘深几许，老夫今日坐冬窝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61677,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九月望徙坐冬窝 其二","author":"钱时","text":"满窗融日育天和，个里还来着到么。\n多少世间闲落索，老夫情绪只冬窝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61678,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]