[{"title":"梅花","author":"戴复古","text":"潇洒春葩缟寿阳，百花惟有此花强。\n月中分外精神出，雪里几多风味长。\n折向书窗疑是玉，吟来齿颊亦生香。\n年年茅舍江村畔，勾引诗人费品量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31335,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梦与赵用父王子文陈叔方相会甚款","author":"戴复古","text":"鼎足当州县，别来音问稀。\n故人俱显达，吾道亦光辉。\n三凤梦中见，孤鸿天外飞。\n应怜江海客，白首未成归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31336,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梦中题林逢吉轩壁觉来全篇可读天明忘了落句","author":"戴复古","text":"嚣尘不到眼，潇洒似僧家。\n风月三千首，图书四十车。\n绿垂当户柳，红映隔墙花。\n好读天台赋，登楼咏落霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31337,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"淮上回九江","author":"戴复古","text":"江水接淮水，扁舟去复回。\n客程官路柳，心事故园梅。\n活计鱼千里，空言水一杯。\n石屏有茅屋，朝夕望归来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31338,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"淮上春日","author":"戴复古","text":"边寒客衣薄，渐喜暖风回。\n社后未闻燕，春深方见梅。\n壮怀频抚剑，孤愤强衔杯。\n北望山河语，天时不再来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31339,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"淮上寄赵茂实","author":"戴复古","text":"渺渺长淮路，秋风落木悲。\n乾坤限南北，胡虏迭兴衰。\n志士言机会，中原入梦思。\n江湖好山色，都在夕阳时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31340,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"淮东赵漕领客东园赵世卿剩谈近日诸公仆谓今日东园之会想像欧苏风流不可见","author":"戴复古","text":"今日东园会，能为野客期。\n乾坤一南北，花木几兴衰。\n亭馆经行地，欧苏无恙时。\n风流不可见，烟雨谩题诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31341,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"淮岸阻风","author":"戴复古","text":"舣棹枫林外，平沙步晚晴。\n秋深红鹤至，波动白鸥惊。\n荻浦留三日，江州计几程。\n夜来风色好，行不待天明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31342,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清明前梦得花字","author":"戴复古","text":"白头那办老生涯，幸有痴儿可主家。\n百岁光阴一场梦，三春消息几番花。\n扫松预造清明酒，入峡先租谷雨茶。\n随分支吾度时节，那求不死炼丹砂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31343,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清明感伤","author":"戴复古","text":"一笠戴春雨，愁来不可遮。\n清明思上冢，昨夜梦还家。\n归兴随流水，伤心对落花。\n晋原松下泪，沾洒楚天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31344,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"琅琊山中废寺","author":"戴复古","text":"欲访山中寺，沿堤石甃长。\n宝坊兵后废，御帖窖中藏。\n故址生秋草，寒窗带夕阳。\n孤僧出迎客，满口话凄凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31345,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"舂陵山中","author":"戴复古","text":"地僻民风古，雨晴天气新。\n空山竖奇石，乔木堕枯薪。\n深入千崖路，多逢百岁人。\n繁华凋性命，寂寞可全真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31346,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"舂陵山中作写寄孔海翁","author":"戴复古","text":"昨日分携后，回头望竹关。\n相亲唯白水，所见但青山。\n云近人家远，苔生石径斑。\n闻钟知有寺，又在渺茫间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31347,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"舂陵道上","author":"戴复古","text":"云际寻行路，时逢一两家。\n山川闲世界，耕钓小生涯。\n病竹长新笋，寒芒摇落花。\n溪翁解延客，连煮数杯茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31348,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菊坡崔参政说平叛卒不得已拜经略之命岂敢言功","author":"戴复古","text":"角巾私第自逍遥，诸老之中此老高。\n无可柰何怀印绶，甚非得已用弓刀。\n风生玉帐千兵肃，天落金牌一札褒。\n缓急经心护乡井，生憎儿辈说功劳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31349,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"萍乡县圃","author":"戴复古","text":"亭榭八九所，一筇随往还。\n四桥朱槛外，三径绿阴间。\n凿浅通流水，凭高见远山。\n琴堂判风月，一笑得双鬟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31350,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"萍乡客舍","author":"戴复古","text":"草罢惜春赋，持杯亦鲜欢。\n檐楹双燕语，风雨百花残。\n小阁无聊坐，征衣不耐寒。\n地炉烧石炭，强把故书看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31351,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"萧飞卿将使赴湖北戎幕诗送其行兼简秋壑贾总侍二首 其二","author":"戴复古","text":"鄂渚三千里，遥遥望使星。\n江湖今寂寞，桃李半凋零。\n世有一秋壑，时无两石屏。\n平生不相遇，老眼向谁青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31352,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"萧飞卿将使赴湖北戎幕诗送其行兼简秋壑贾总侍二首 其一","author":"戴复古","text":"文章萧颖士，一剑去从军。\n远望西关路，愁看两浦云。\n九霄腾意气，万里取功勋。\n马上一杯酒，须斟满十分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31353,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"萧仲有遗经堂","author":"戴复古","text":"一经传世宝，说与子孙知。\n欲作久长计，毋忘礼义为。\n黄金生悔吝，白璧有瑕疵。\n兼取庞公语，图安不遗危。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31354,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"萧学易何季皋和作别诗佳甚再用前韵","author":"戴复古","text":"少年行脚白头归，不负平生汗漫期。\n望断海山云漠漠，愁生江路草离离。\n一篇王粲登楼赋，几首巴陵送别诗。\n独倚篷窗无意绪，瓦盆倾酒忆金卮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31355,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鄂州戎治静憩亭","author":"戴复古","text":"幽亭何处寻，岩树碧森森。\n独坐生云石，少安经世心。\n伴人双鹤立，多事一蝉吟。\n提剑翻然起，中原秋草深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31356,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鄂渚烟波亭","author":"戴复古","text":"倚遍南楼更鹤楼，小亭潇洒最宜秋。\n接天烟浪来三峡，隔岸楼台又一州。\n豪杰不生机事息，古今无尽大江流。\n凭栏日暮怀乡国，崔颢诗中旧日愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31357,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"隆兴度夏借东湖驿安下","author":"戴复古","text":"面对一池荷，四旁杨柳坡。\n树阴遮日少，屋敞受风多。\n疑是清凉国，暂为安乐窝。\n人人争避暑，老子自婆娑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31358,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"随军转运司王宣子上巳日会客","author":"戴复古","text":"边头相遇若相期，又见随军转运司。\n忆昨醉君京口酒，伤今读我石壕诗。\n兰亭饮客酬佳节，淝水收功定几时。\n准拟看花花较少，春风全在绿杨枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31359,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪后暖","author":"戴复古","text":"先腊梅花谢，不冰溪水流。\n早尝春菜饼，暖卸木终裘。\n去岁三冬雪，今年百谷秋。\n此冬无此瑞，又为老农忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31360,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"麻城道中","author":"戴复古","text":"三杯成小醉，行处总堪诗。\n临水知鱼乐，观山爱马迟。\n林塘飞翡翠，篱落带酴醾。\n问讯边头事，溪翁总不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31361,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"黄州竹楼呈谢国正","author":"戴复古","text":"每日黄堂事了时，一心惟恐上楼迟。\n发挥天地读周易，管领江山歌杜诗。\n切戒吏来呈簿历，常邀客至共琴棋。\n风流太守谁其似，半似元之半牧之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31362,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"黄州偶成","author":"戴复古","text":"雁叫淮南欲雪天，倚楼无味抱愁眠。\n算从沧海白云际，行到黄州赤壁边。\n万事忌于怀壮志，一生穷为耸吟肩。\n鬓间白者休教镊，要使天知老可怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31363,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"黄道士出爻","author":"戴复古","text":"林屋何潇洒，权为羽士家。\n客来多载酒，僧至自煎茶。\n试墨题新竹，携筇数落花。\n饮中忙过日，无暇问丹砂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31364,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"喜闻平峒寇","author":"戴复古","text":"峒寇都平了，官军奏凯歌。\n千山通道路，一雨洗干戈。\n天地和风转，江湖春水多。\n蜀中无近报，西贼定如何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31365,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"喜梅雨既晴","author":"戴复古","text":"屋角鸣禽弄好音，楼头夏木绿阴阴。\n镊空白发愁根在，熟尽黄梅雨意深。\n苔榻有泥妨客坐，稻田足水慰农心。\n老夫已作丰年想，鼓腹思为击壤吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31366,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"彭绣使平叛卒后除经略小诗陈利害 其一","author":"戴复古","text":"广东经略使，今古几人贤。\n陛下用一士，民间有二天。\n清风排瘴雨，廉德照贪泉。\n龙节生光彩，鸾车奏凯旋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31367,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"彭绣使平叛卒后除经略小诗陈利害 其三","author":"戴复古","text":"乳虎恋巢穴，穷猿失木悲。\n早须思一著，先要释群疑。\n豪杰通心腹，人民无怨咨。\n御军明纪律，威爱贵兼施。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31368,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"彭绣使平叛卒后除经略小诗陈利害 其二","author":"戴复古","text":"斩蛟移鳄后，近水有惊鳞。\n阃外尚多事，幕中无一人。\n佩韦防狷急，强饭养精神。\n罗致贤能士，仍须藻鉴真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31369,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"提刑彭仲节平叛卒","author":"戴复古","text":"千兵喝赏黄金尽，六月临戎白刃寒。\n慷慨丈夫为事别，太平人物济时难。\n谁言江左无王谢，今喜军中有范韩。\n汉节梅花留不住，借君一剑斩楼兰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31370,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"曾云巢同相勉李玉涧不赴召","author":"戴复古","text":"诏书催赴紫宸班，九奏君王乞挂冠。\n日暮倒行非我事，急流勇退有何难。\n地灵不隐金砂胜，秋水长流玉涧寒。\n好把山林寄图画，试教天下故人看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31371,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"曾云巢年八十聪明不衰小楷写六经家有小楼日登览不倦诸监司尝荐遗逸","author":"戴复古","text":"八十云巢老，诸公旧典刑。\n心情古井水，辈行晓天星。\n身健登高阁，眼明书六经。\n尝闻荐遗逸，何以报朝廷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31372,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"曾景建得罪道州听读","author":"戴复古","text":"闻说乌台欲勘诗，此身幸不堕危机。\n少陵酒后轻严武，太白花前忤贵妃。\n迁客芬芳穷也达，故人评论是耶非。\n饱参一勺濂溪水，带取光风霁月归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31373,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渝江绿阴亭九日燕集 其一","author":"戴复古","text":"佳节重有感，人间行道难。\n登高苦无地，把酒一凭栏。\n山迥暮烟合，江空秋水寒。\n沙头有鸂鶒，莫作鸳鸯看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31374,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渝江绿阴亭九日燕集 其二","author":"戴复古","text":"九日江亭上，谁怜老孟嘉。\n要人看白发，不用整乌纱。\n寄兴题桐叶，长歌醉菊花。\n归心徒自苦，犹在楚天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31375,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游云溪与郡宴用太守韵即事二首 其二","author":"戴复古","text":"官府太平无一事，凝香座上著衰翁。\n飘摇短棹游方沼，缥缈高楼倚半空。\n把酒夜深霜落后，吹箫人在月明中。\n使君笑指梅花说，去岁今年事不同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31376,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游云溪与郡宴用太守韵即事二首 其一","author":"戴复古","text":"溪堂久矣无人到，千骑传呼五马来。\n流水奔腾砥柱立，好山呈露晚云开。\n指挥壮士驰骁骑，管领衰翁吊古梅。\n笑问风流羊叔子，几人登览不尘埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31377,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游天竺","author":"戴复古","text":"好山看不了，遂借上方眠。\n酒渴倾花露，诗清泻涧泉。\n生无适俗韵，老欲结僧缘。\n睡觉钟声晓，窗腾柏子烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31378,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"湖口","author":"戴复古","text":"水落山增峻，江空石出奇。\n倚篷看不足，解缆放教迟。\n沙上雁初到，樽前蟹可持。\n中秋能几日，又是菊花时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31379,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"湖广李漕革夫大卿饮客西湘","author":"戴复古","text":"管领风光此会稀，坐中宾客总能诗。\n神仙有洞寻难见，山水当轩看转奇。\n春不再生陶侃柏，人来多打李邕碑。\n因思屈贾伤今古，国有忠臣无用时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31380,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"湖南见真帅","author":"戴复古","text":"致身虽自文章选，经世尤高政事科。\n以若所为即伊吕，使其不遇亦丘轲。\n长沙地窄儒衣阔，明月池乾春水多。\n天以一贤私一路，其如四海九州何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31381,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"湘中","author":"戴复古","text":"荆楚一都会，潇湘八景图。\n试呼沙鸟问，曾识古人无。\n痛哭贾太傅，行吟屈大夫。\n汀洲芳草歇，转使客情孤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31382,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"湘中","author":"戴复古","text":"一棹无情度碧湘，行行不脱水云乡。\n旗亭少饮村醪薄，田舍新炊晚稻香。\n箫鼓远来朝岳去，包笼争出趁虚忙。\n涂人有愧黄居士，十载看经不下堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31383,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"焦山","author":"戴复古","text":"江接海冥冥，山连岛树青。\n似非人境界，宜有佛宫庭。\n藏压蟠龙宅，潮渰瘗鹤铭。\n西岩更清绝，心与酒俱醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31384,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登快阁黄明府强使和山谷先生留题之韵","author":"戴复古","text":"未登快阁心先快，红日半檐秋雨晴。\n宇宙无边万山立，云烟不动八窗明。\n飞来一鹤天相近，过尽千帆江自横。\n借问金华老仙伯，几人无忝入诗盟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31385,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登祝融","author":"戴复古","text":"秋风吹拄杖，直到祝融颠。\n目击三千界，肩摩尺五天。\n扶桑旸谷畔，青草洞庭边。\n云气无遮障，分明在眼前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31386,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"董侍郎山园燕楼宗丞","author":"戴复古","text":"旌旗千骑拥春华，倾动临川十万家。\n皂盖出郊因问柳，紫荷领客共看花。\n樽前人唱鶑随唱，堂下吏衙蜂亦衙。\n寄语风流贤太守，好留醉墨伴烟霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31387,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"董侍郎蒙泉书院","author":"戴复古","text":"一室可忘老，四窗宜读书。\n但教樽有酒，莫问食无鱼。\n客子家何在，明朝岁又除。\n思归徒自苦，安处即吾庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31388,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"董叔宏黄伯厚载酒黄塘送别","author":"戴复古","text":"愁酌开怀酒，凉生破暑风。\n论交谈洒洒，告别恨匆匆。\n十里黄塘路，扁舟白发翁。\n多情今夜月，为我照吟篷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31389,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"董叔震书堂","author":"戴复古","text":"数椽深巷底，朝夕自委蛇。\n勋业时看剑，诗书日下帷。\n古碑遮素壁，破砚浴清池。\n灯火伊吾夜，犹如未第时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31390,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢王使君送旅费","author":"戴复古","text":"风撼梅花雨，雾笼杨柳烟。\n如何残腊月，已似半春天。\n岁里无多日，闽中过一年。\n黄堂解留客，时送卖诗钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31391,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢史石窗送酒并茶","author":"戴复古","text":"遣来二物应时须，客子行厨用有馀。\n午困政须茶料理，春愁全仗酒消除。\n不胜欢喜拜嘉惠，无限慇勤作谢书。\n君既有来何以报，一床蕲簟两淮鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31392,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢吴秘丞作石屏集后序","author":"戴复古","text":"说破当年旧石屏，自惭无德又无能。\n乡来江海疏狂客，今作山林老病僧。\n高卧一楼成宇宙，冷看独影当宾朋。\n恶诗有误公题品，不是夔州杜少陵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31393,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢项子宜帅干遣馈","author":"戴复古","text":"闻说沙溪上，分明似渭川。\n重山照华屋，万竹绕清泉。\n遣馈知相忆，登门未有缘。\n一楼先月景，想像在吟边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31394,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢萧和伯见访","author":"戴复古","text":"定交虽日浅，老眼见君深。\n急谊真如渴，能诗不肯吟。\n江湖尊白发，土苴视黄金。\n野客无边幅，相看话此心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31395,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"遇张韩伯说边事","author":"戴复古","text":"每上高楼欲断魂，沿江市井几家存。\n飞鸿历历传边信，芳草青青补烧痕。\n北望苦无多世界，南来别是一乾坤。\n相逢莫说伤心事，且把霜螯荐酒樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31396,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"遇淮人问蕲黄之变哽噎泪下不能语许俊不解围乃提兵过武昌","author":"戴复古","text":"偶逢淮上客，急急问蕲黄。\n未语心先噎，低头泪已滂。\n五关人失守，残虏势非强。\n闻说许都统，提兵过武昌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31397,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"道傍馆","author":"戴复古","text":"道傍谁氏馆，□我坐开樽。\n翁妪出迎客，儿童为扫门。\n好花生竹所，流水浸云根。\n傥遂卜邻约，为农老此村。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31398,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雁山罗汉寺省王总干之墓待和甫主簿之来","author":"戴复古","text":"山鸟怪儒衣，游山我亦痴。\n叫云云不应，问水水相知。\n俗物刺人眼，春风发我诗。\n噪檐鸦鹊喜，主簿有来期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31399,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雁山总题此山本朝方显 其一","author":"戴复古","text":"此地古无闻，谁封万石君。\n山林才整整，来往早纷纷。\n两派龙湫水，千峰雁荡云。\n东西十八寺，纪载欠碑文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31400,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]