[{"title":"梅雨","author":"薛季宣","text":"霢霂雨黄梅，凝云绾不开。\n心知养苗稼，眼见长莓苔。\n密箧几如渍，崇墉势欲隤。\n郁蒸任炎热，谁解酌金罍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23385,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游飞霞洞","author":"薛季宣","text":"横塘富花柳，杳杳镜中行。\n楼观朱涵壁，洞天珉掩闳。\n林深暮云合，地僻夏寒生。\n康乐屏岩静，鸣榔时一声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23386,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"龙翔寺","author":"薛季宣","text":"二江涵古寺，双屿耸平沙。\n翠浪环流净，金城到眼奢。\n水光摇殿阁，塔景动龙蛇。\n不减蓬壶意，屯云未许遮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23387,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"酬张县尉","author":"薛季宣","text":"久客多尘滓，心怀为子开。\n文知龙有种，名苦雉为媒。\n但得贫无累，何嗟去不来。\n吴门众多士，待尔和羹梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23388,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"元夕忆世母","author":"薛季宣","text":"苍天毒我生，顾复自孩婴。\n元夜维蛇梦，三山寿斝倾。\n星毬明烜赫，鳌岛峻峥嵘。\n乐事都如梦，伤心母道情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23389,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拒霜花","author":"薛季宣","text":"蘸染木芙蓉，深红间浅红。\n锦笼烘夕照，翠袖揖秋风。\n艳冶归尤物，凄凉识化工。\n拒霜高节在，丹药谩成丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23390,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"早行","author":"薛季宣","text":"旅枕罢残梦，明星悬屋椽。\n不辞风露冷，欲了东西缘。\n云驭方擎日，月轮犹印天。\n波波定何事，羞死地行仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23391,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"天阴","author":"薛季宣","text":"梅月乍开霁，油云閒卷舒。\n溢光穿隙日，浮祲出清虚。\n鼓吹蛙声乱，笙簧竹影疏。\n雨来三四点，静觉打籧篨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23392,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"告归郡不得请倦于将迎之劳","author":"薛季宣","text":"閒居百不忧，何事武昌游。\n旦旦三江口，时时十里头。\n个中都是妄，此外竟何求。\n生被浮名累，将迎卒未休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23393,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"昧爽寒溪送客","author":"薛季宣","text":"攀援长者车，昧爽踏汀沙。\n片玉山衔水，堆金日蘸霞。\n风来云外岭，露重竹间花。\n好景看如客，心閒即是家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23394,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"二十三日送客寒溪还视邑事食时过节推周文犹高卧未起愒然嗟羡以诗戏之","author":"薛季宣","text":"惊起周公梦，三竿日倍高。\n被毡吟不用，州县职徒劳。\n脂辖驱邮置，金车困贼曹。\n几如陈处士，龙卧楚江皋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23395,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夏日江滨","author":"薛季宣","text":"鸟迹铺天篆，金波漾日沙。\n鹭拳岩积雪，风勺浪飞花。\n江断客帆入，崖回山影斜。\n峰云青入汉，略约二三家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23396,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闻黄仲益云梦辟书报命","author":"薛季宣","text":"三府书交上，群公座尽倾。\n量包云梦岭，名动洛阳城。\n鸡肋刀焉用，牛腰轴定盈。\n江南望江北，无可赠梅英。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23397,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"读萧铣传","author":"薛季宣","text":"不假成田势，宁堪麦秀悲。\n青毡梁旧物，赤帜汉威仪。\n刚被农家误，俄推鼎祚移。\n江湖百郡地，只自黍离离。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23398,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"读九国志闷书","author":"薛季宣","text":"吊古因紬卷，伤神却皱眉。\n蜂房开自牖，蚁穴溃成堤。\n不苦南风竞，长怀北马悲。\n阳曦曜星月，还有饯西时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23399,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"被甲","author":"薛季宣","text":"儒服便章甫，戎装乍铁衣。\n几曾生共乐，犹有死同归。\n著屦惟何甚，乘车未遽非。\n愧酬军旅问，先见少知几。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23400,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"曾阳回棹","author":"薛季宣","text":"沔曲回晨棹，惊飞羡水禽。\n波纹沙隐见，山影浪浮沈。\n色动芦花雪，光摇日脚金。\n扁舟归未得，惆怅五湖心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23401,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"读三国志","author":"薛季宣","text":"左角蛮攻触，南柯檀伐槐。\n徘谐记名字，人物委尘埃。\n锦里昔曾到，樊川今此来。\n遗风不可见，观古意悠哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23402,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"读史","author":"薛季宣","text":"信乃哙等伍，宏与滔比肩。\n飨士未为过，出跨真能贤。\n物外体三极，环中无二天。\n伤哉千古恨，颦蹙玩陈编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23403,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"仵落回路得家书是夕有归梦","author":"薛季宣","text":"梦入江南路，依然识旧庐。\n家人话生计，儿子督程书。\n缭绕俗缘在，缠绵习气馀。\n金鸡惊误我，安问未为疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23404,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"三月七日按云陂庄还宿旧州寺怀松楸作","author":"薛季宣","text":"不学老农稼，而为田舍翁。\n劬劳方轸虑，定集竟何功。\n心恻焄蒿气，时寒疾甚风。\n年时尚坛祭，废绝意奚穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23405,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山舍三首 其一","author":"薛季宣","text":"髣髴依蛮室，林端鸟道萦。\n烟疑云异色，松接涧同声。\n树古龙蛇蚴，岩嵬虎豹狞。\n野花舞狂蝶，栩栩梦庄生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23406,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山舍三首 其二","author":"薛季宣","text":"坞阔廜苏小，奇峰叠翠屏。\n岩头通鸟迹，山脊走龙形。\n峡断风偏劲，林幽天欲冥。\n流泉不知处，虚谷响泠泠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23407,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山舍三首 其三","author":"薛季宣","text":"寂寞无尘事，茅茨秀岭连。\n密萝蒙灌木，乱石隐流泉。\n蝉噪云间树，鸟飞山外天。\n孤云自明灭，应达主人玄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23408,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"观棋","author":"薛季宣","text":"战伐徒形似，死生俱妄为。\n争先明有法，当局自成迷。\n多算非关劫，成功定出奇。\n两情深海若，不比看人知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23409,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"升仙寺","author":"薛季宣","text":"羽翼假真仙，飞来秀岭巅。\n道高还自正，境寂若为禅。\n寓目山如砺，昂头浪拍天。\n闽城多少地，羃历带平烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23410,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"丙子岁春","author":"薛季宣","text":"物极虽云反，寒威何太衰。\n东风入帘幕，生意满林畦。\n古木含新绿，仙葩吐旧枝。\n阴晴苦不定，中夜忍闻规。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23411,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"江行即事","author":"薛季宣","text":"春信潮声急，滔滔掩岸沙。\n客船离浦溆，渔笛起蒹葭。\n荡桨水光碎，转山帆影斜。\n篙工指烟树，依约有人家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23412,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪销","author":"薛季宣","text":"旬浃雨银花，山林尽绮罗。\n东风云气减，南纪日光和。\n皓皓污应易，涓涓滴转多。\n冰生又冰释，天道竟如何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23413,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"读大定书诏","author":"薛季宣","text":"窃国盗仁义，惊人新见闻。\n腥膻冠冕俗，秽杂犬羊群。\n孟获尚七纵，匈奴非五分。\n启民身薙草，为有雁门军。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23414,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"诚台雪望怀子都五首 其一","author":"薛季宣","text":"不见子都子，诚台一壮观。\n烂开梅骨峭，高耸玉峰寒。\n谁共云霄目，诗亡锦绣肝。\n梦魂千里道，应更酒肠宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23415,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"诚台雪望怀子都五首 其二","author":"薛季宣","text":"故人一相遇，七返霰瀌瀌。\n辞采应奇甚，颠狂即在不。\n寻思落帽会，乘兴锦官游。\n皎皎诚台暮，诗肠独自搜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23416,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"诚台雪望怀子都五首 其三","author":"薛季宣","text":"白也今良嗣，千年璧一双。\n文思泉漱石，色照月明窗。\n朴樕空樊渚，飘零远汉江。\n此情谁与度，木介响琤瑽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23417,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"诚台雪望怀子都五首 其四","author":"薛季宣","text":"狂游失可人，萍聚我和君。\n千里共明月，几山空白云。\n击雕飞堕毳，嚼雪冷冰龈。\n百岁无多子，离居困索群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23418,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"诚台雪望怀子都五首 其五","author":"薛季宣","text":"掩胫诚台雪，吟头祇自昂。\n梅花开岭路，冰玉皱池塘。\n良马日千里，美人天一方。\n尺书不可寄，道义两相忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23419,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和贾簿","author":"薛季宣","text":"官冷君休叹，浮名陌路车。\n冰山逢燠泮，豆粥并寒除。\n但酌樽中酒，从堆架上书。\n未酬题柱志，终不羡相如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23420,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"忌日雪","author":"薛季宣","text":"荼毒惟何甚，同时失所天。\n哀伤逢此日，怀抱忆初年。\n白雪明心素，青松黯墓埏。\n不堪陈几席，罪罟欲谁冤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23421,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"大雪","author":"薛季宣","text":"江市弥旬雪，人行失旧踪。\n梅藏香骨瘦，冰结浪花重。\n髣髴门前柳，昏迷郭外峰。\n屋檐天汉在，一雁没清空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23422,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"喜雨","author":"薛季宣","text":"麦穗虽乾耳，秧苗未吐心。\n正须云泼墨，生怕日流金。\n气郁山堂润，风回竹径阴。\n称人三四点，争道即为霖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23423,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春老寒雨酴醾竟烂","author":"薛季宣","text":"无定若游丝，神人荐玉衣。\n飘摇思远举，婀娜怯空归。\n晚色檀心重，春寒酒力微。\n牵肠无柳眼，香絮雪花飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23424,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"读史","author":"薛季宣","text":"闲是等闲非，沈迷不自知。\n黄粱一夜梦，白雪数人诗。\n身后输杯酒，生前对局棋。\n几多亡国恨，窗几静支颐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23425,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"延陵感怀","author":"薛季宣","text":"延陵七春梦，悲切意更微。\n颇复吴牛喘，还多代马依。\n去来纷混混，今昨是非非。\n况在辽东鹤，千年方始归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23426,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪霁和智叔次诸郎曹韵二首 其一","author":"薛季宣","text":"风洗朔云静，愁蠲泪眼晴。\n夜阑灰亦冷，目眩室生明。\n客子远乡巷，天公偏世情。\n布衾寒泼水，坠叶也心惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23427,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪霁和智叔次诸郎曹韵二首 其二","author":"薛季宣","text":"同云起飞絮，忽作无意晴。\n梦破客愁绝，魂销天夜明。\n闻鸡悲壮节，哀雁切乡情。\n夜静群动息，空床时自惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23428,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"元日","author":"薛季宣","text":"凤历回龙纪，羲和御物新。\n崎岖万里道，牢落五年春。\n羁客闻哀雁，伤怀念昔人。\n米盐能几许，还自不由身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23429,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梦回二首 其一","author":"薛季宣","text":"忆到梯云巷，哀伤韡鄂丛。\n舞鸾悲引镜，伤雁落空弓。\n清梦回时雨，繁声发夏虫。\n情钟正吾辈，匡坐泣薰风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23430,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梦回二首 其二","author":"薛季宣","text":"吾宗鲜兄弟，何事日飘零。\n凋落皆鹓凤，相从谢鹡鸰。\n世缘那可了，魂梦也非宁。\n屈指伤心事，端如欲曙星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23431,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"乡思","author":"薛季宣","text":"达仕租千石，虚名酒五经。\n岂能千日醉，未胜九年耕。\n识取杯中趣，知从袋里乘。\n读书无一事，官宦汩平生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23432,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寒食二首 其一","author":"薛季宣","text":"异县临寒食，为情觉大难。\n焄蒿五精气，破散六祠坛。\n堕泪纷朝雨，回肠减夜餐。\n谁家箫鼓咽，欢舞欲媻跚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23433,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寒食二首 其二","author":"薛季宣","text":"五岁怀归梦，言归已得归。\n未能逃俗累，旋复著征衣。\n子贡当何战，燕人切自悲。\n无堪一百五，春雨作霏微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23434,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"感事","author":"薛季宣","text":"狐死正丘首，鸢飞翰戾天。\n乃知司马晋，不若慕容燕。\n济乱须人杰，投机赧世贤。\n长江千古恨，南北几陈编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23435,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"鸂鶒","author":"薛季宣","text":"溪?沧江外，雌雄万里心。\n浪花浮彩翠，烟雨弄清音。\n蓼岸无端艳，莲塘底处寻。\n鸳鸯谁著色，知误几金针。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23436,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"读邸报二首 其一","author":"薛季宣","text":"大漠烟尘静，三公计画奇。\n定安唐庙貌，行复汉官仪。\n捷奏腾千里，除书满四维。\n自然禽颉利，蚤晚赞无为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23437,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"读邸报二首 其二","author":"薛季宣","text":"世味刀头蜜，人情屋上乌。\n荣华叶子格，升黜选仙图。\n豺祭知生兽，蛇衔欲报珠。\n不将魂梦到，反是忆莼鲈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23438,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"九月十日菊","author":"薛季宣","text":"不改天香细，无端人意疏。\n重阳把杯者，今夕尚来与。\n白羽摇依旧，黄裳笑反初。\n知时自凡俗，冷暖欲焉如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23439,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夜闻捷音","author":"薛季宣","text":"圆觉声闻夜，蒙头大比丘。\n上功来莫府，如用复东周。\n行即升平旧，还从汗漫游。\n凭谁问淮蔡，元济莫擒不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23440,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闷成","author":"薛季宣","text":"春鸟弄轻微，凝阴满院飞。\n蚕姑云力作，杜宇不如归。\n世变知音少，人亡解语希。\n汗颜多反仄，溅泪湿单衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23441,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春阴","author":"薛季宣","text":"春昼阁春愁，无情若隐忧。\n柔肠牵柳眼，困泪点花头。\n不放春风度，从教暮雨休。\n哀怜无限意，小畜闵黄州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23442,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"灯花","author":"薛季宣","text":"自得天然艳，书窗气吐虹。\n有心惟烛物，无种到施工。\n不管三春候，平分两曜功。\n报人知喜事，谁辨悉归空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23443,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送郑景望赴国子丞诗二首 其一","author":"薛季宣","text":"风喜樯乌顺，知难唤酒杯。\n好溪寒已半，京洛暖应回。\n僧舍方飘雪，江篱欲放梅。\n不须愁国步，之子栋梁材。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23444,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送郑景望赴国子丞诗二首 其二","author":"薛季宣","text":"忾我论交晚，何堪又索居。\n朝阳鸣必凤，清水察无鱼。\n百恼愁成斛，群疑鬼载车。\n否臧亡可道，赢得腹诗书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23445,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送郑景元赴秀州判官诗","author":"薛季宣","text":"恢炱煽炎毒，万里无来风。\n殿阁少微凉，况乃陌路中。\n纨扇可把挥，秋高网丝虫。\n冰山岂足恃，见睍聿消融。\n进退信惟谷，黄尘奈匆匆。\n郑君冰雪姿，干将依崆峒。\n竭蹶救头然，巾车佐元戎。\n生人在炽炭，吾何惮爞隆。\n往闻开元帝，逃暑绣岭宫。\n偪仄政浩叹，木阴见姚崇。\n烦溽顿以消，语识静胜工。\n相期在此行，山泉养童蒙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23446,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"兄子象先罢公试归知武林动静成古风三首 其一","author":"薛季宣","text":"黄庭有真诣，魂升魄入渊。\n知机动以食，还反道自然。\n尝闻鍊色石，可用补苍天。\n时哉复时哉，宁教悔在前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23447,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"兄子象先罢公试归知武林动静成古风三首 其二","author":"薛季宣","text":"野鹤入鸡群，猿岂王孙辈。\n之人定忘物，未足言身世。\n丹山两凤皇，为谁来哕哕。\n灵龟发与肣，可以卜隆杀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23448,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"兄子象先罢公试归知武林动静成古风三首 其三","author":"薛季宣","text":"明珠以弹雀，得雀亦亡珠。\n飏鹜以当鹰，夫岂猎之徒。\n黄金有定价，韫椟盍藏诸。\n薰风扇馀凉，吾方爱吾庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23449,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"元夜斋居","author":"薛季宣","text":"元夜忆年时，忘情居灏灏。\n县斋今夕居，曷谓伤怀抱。\n都缘人事非，不足年时好。\n世母舍我归，屈指忧吾老。\n人亡不可见，此心为草草。\n大人月云忌，弃我方儿褓。\n呱呱救婴泣，安知请丘祷。\n诸父洎诸兄，下世吁何早。\n悲伤失所恃，涕泪流行潦。\n哀思动时节，不见莲灯好。\n乡居计日长，松楸倩谁埽。\n诸母侍何期，念旧呼穹昊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23450,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春雨","author":"薛季宣","text":"春雨不知止，新晴旋复阴。\n霏溦散秋毫，虚檐水鸣琴。\n琤瑽响疏窗，庭除有馀音。\n跬步莫可纵，苍苔看侵淫。\n县斋知几秋，中堂漏相寻。\n涓涓溅人衣，黯黯乏胜襟。\n发策漫如渍，明眸暗沈吟。\n翛然薄云开，风声到园林。\n坐觉筠筀芽，罗鞭粲修森。\n巾车过坊市，沟渠涨江浔。\n言归转通渠，举头见西岑。\n峰青雾衔白，何堪送迎心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23451,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春江小雨","author":"薛季宣","text":"小雨春风里，澄江满涨痕。\n沙平波渺渺，山远雾昏昏。\n短棹烟尘细，浮云天地根。\n将迎倦无已，羞目旧杯尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23452,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]