[{"title":"宋元献公挽辞三首 其二","author":"韩维","text":"俭是终身事，书无释手时。\n搯膺谁戒妾，易箦自呼儿。\n冠剑平生象，箫笳一品仪。\n邦人知所法，宸篆表忠规。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38280,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宋元献公挽辞三首 其三","author":"韩维","text":"昔侍从容论，犹能记绪馀。\n精深义山句，妙绝漆园书。\n顾钝尝加砺，怜枯每借嘘。\n霜风国西路，挥涕洒灵车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38281,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"仆射高文庄公挽辞三首 其一","author":"韩维","text":"群经分上下，大节凛终初。\n国仰谟猷在，人传论议馀。\n藏家惟古器，纳圹或奇书。\n儒者哀荣极，临觞降玉舆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38282,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"仆射高文庄公挽辞三首 其二","author":"韩维","text":"恳上畿庭印，来敷秘殿经。\n退朝多谢客，隐几或忘形。\n道胜于生达，时穷与化冥。\n高谈无复见，遗像泣丹青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38283,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"仆射高文庄公挽辞三首 其三","author":"韩维","text":"未卒金华业，俄闻卤簿行。\n音容如夙昔，文雅是平生。\n偃蹇丹旌动，徘徊素骥鸣。\n霜风九京路，凄怆国人情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38284,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王侍读挽辞二首 其一","author":"韩维","text":"旧族人犹凤，清班署冠鳌。\n法书传隶古，才笔拟庄骚。\n赠印官称宠，题旌谥典高。\n无由攀葬绋，伫立望行艘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38285,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王侍读挽辞二首 其二","author":"韩维","text":"去日还乡旆，今朝反葬车。\n露门虚近位，东观束残书。\n论议留台阁，哀荣动里闾。\n始终稽古力，当代几人如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38286,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"邓圣求挽诗二首 其一","author":"韩维","text":"南国丞旄士，西清对宿儒。\n晚跻淹庙胜，速夺动宸吁。\n正色持风宪，嘉猷俨典谟。\n惟书仁者勇，传世厉非夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38287,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"邓圣求挽诗二首 其二","author":"韩维","text":"乡有先生号，朝多长者言。\n谈经人服戴，辨狱世高袁。\n雨湿铭旌暗，风摇挽铎喧。\n无缘攀葬绋，洒泪望秋原。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38288,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"苏才翁挽辞二首 其一","author":"韩维","text":"勋业经营内，贤豪许与中。\n远图宜将相，高论自儿童。\n名挂江云白，魂归楚树红。\n诸孤尽才秀，它日大门风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38289,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"苏才翁挽辞二首 其二","author":"韩维","text":"奕世婚姻旧，平生昆弟游。\n篇章每惊坐，谈笑得忘忧。\n不复衔杯乐，空能助绋讴。\n凄凉箧中字，挥洒看银钩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38290,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"哭苏子美三首 其一","author":"韩维","text":"未起蛟龙卧，俄缠鵩鸟悲。\n寝门号故友，穗帐哭孤儿。\n业履归舆议，铭文愧绝辞。\n沧浪亭下路，长负故人期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38291,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"哭苏子美三首 其二","author":"韩维","text":"魄动书流怆，诚通梦告悲。\n人生要有尽，君没竟何施。\n白日空尘几，春风自酒卮。\n旅魂归未得，藁葬近要离。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38292,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"哭苏子美三首 其三","author":"韩维","text":"才大终为累，冤深岂复论。\n几年流落恨，千里寂寥魂。\n功业初怀负，风流秀句存。\n英灵邈无所，洒泪望阊门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38293,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"郑公挽辞","author":"韩维","text":"兼才不废刑名学，雅意多从翰墨游。\n通德门中传旧业，平蛮记上见佳谋。\n朝衣永閟泉台夜，挽铎犹添梦野秋。\n文彩声名今不泯，郎官君听在鳌头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38294,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"范蜀公挽辞二首 其一","author":"韩维","text":"正学跻经席，孤忠入谏垣。\n论储十九疏，议乐数千言。\n勇去高门地，归乘下泽辕。\n华颠不及用，遗恨满丘樊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38295,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"范蜀公挽辞二首 其二","author":"韩维","text":"白圭绝玷成高节，古井无波见静心。\n朝庙肯随时俯仰，闾阎宁与俗浮沉。\n新声未及乘仪凤，丽赋空馀掷地金。\n曾是南园预游客，春风泪洒百花林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38296,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"孙曼叔挽词三首 其一","author":"韩维","text":"高才正论动朝绅，出入光华二十春。\n褒诏未登新学士，恤章俄贲旧宫臣。\n履声长绝高门地，墨妙空留素壁尘。\n一奠华觞不知恸，白头相好苦无人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38297,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"孙曼叔挽词三首 其二","author":"韩维","text":"定契仍三世，从游复一乡。\n掷金看丽赋，报玉得雕章。\n不尽良哉用，空令识者伤。\n欲知恩礼重，恤视走银珰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38298,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"孙曼叔挽词三首 其三","author":"韩维","text":"青邸传经罢，朱轓报政成。\n近民缘恺乐，致主出忠精。\n屡困清漳卧，终乘下泽行。\n衰年失良友，行泣望铭旌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38299,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中书傅钦之侍郎挽词三首 其一","author":"韩维","text":"圣主方思助，皇天亦棐诚。\n屡空安可病，久困卒能亨。\n廊庙虚槐位，家园近柏城。\n声名流不竭，长共济时清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38300,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中书傅钦之侍郎挽词三首 其二","author":"韩维","text":"久敬钦交旧，雍和浃弟昆。\n玉温儒者行，矢直谏臣言。\n遽返生申魄，犹虚命说恩。\n只因为善报，馀庆在高门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38301,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中书傅钦之侍郎挽词三首 其三","author":"韩维","text":"壮节淹鹏海，高年集凤池。\n谟猷未及展，箫鼓已成悲。\n经擿留天幄，书囊入殿帷。\n伤心济源道，无复故人期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38302,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢师厚挽词三首 其一","author":"韩维","text":"落笔无尘语，垂髫有俊声。\n人咨汉故事，坐屈鲁诸生。\n道不缘贫病，心能处困亨。\n它年文苑传，不愧著公明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38303,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢师厚挽词三首 其二","author":"韩维","text":"论文满樽酒，别恨几筒诗。\n不谓相思久，终无一笑期。\n地卑伤贾谊，冢近得要离。\n尚有芝兰秀，风流未觉衰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38304,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢师厚挽词三首 其三","author":"韩维","text":"幻有终何得，真空夙所归。\n丘陵甘一跌，霄汉任群飞。\n妙墨嗟犹在，华觞不重挥。\n交亲半零落，衰泪下沾衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38305,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"郑闳中挽辞二首 其一","author":"韩维","text":"南宫平昔佐文衡，丽赋亲聆掷地声。\n群进士中连得隽，四先生里旧知名。\n严凝□□来何暮，潇洒安舆去已轻。\n万里故乡归不得，要离冢畔有佳城。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38306,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"郑闳中挽辞二首 其二","author":"韩维","text":"守道贫原宪，传经老伏生。\n声名徒自振，心虑淡无营。\n废卷多怀古，衔杯靡吝情。\n思君最深处，始卒尽纯诚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38307,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王微之龙图挽辞二首 其一","author":"韩维","text":"用舍时焉尔，穷通命也欤。\n石渠推旧德，王座阅新书。\n雪饮连挥斝，春游每并舆。\n平生寝门泪，白首倍连茹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38308,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王微之龙图挽辞二首 其二","author":"韩维","text":"高情夙慕冥鸿举，晚节终随倦鸟回。\n物外忘情常隐几，酒中得趣亦衔杯。\n每因误曲烦周顾，几废言诗每鼎来。\n九十年龄随化尽，所嗟不尽是君才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38309,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"冯当世挽词二首 其一","author":"韩维","text":"名冠英雄彀，身参将相尊。\n有客沧海量，无玷白圭言。\n密议调羹鼎，高怀寄酒樽。\n从今此中意，无复故人论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38310,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"冯当世挽词二首 其二","author":"韩维","text":"逍遥灵寿杖，严密具茨书。\n脱屣遗浮世，披衣得旧庐。\n酹非光禄酒，祭乏武昌鱼。\n礼薄情从厚，秋风泪满裾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38311,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"哭曾令绰三首 其一","author":"韩维","text":"密勿论兵地，光华问俗车。\n嘉谋尽戎幕，惠泽浃民闾。\n语道多忘己，言诗屡起予。\n去思何以慰，遗像俨精庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38312,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"哭曾令绰三首 其二","author":"韩维","text":"典丽文章雅正躬，高才又出相门中。\n庙堂帝识精忠议，蕃服民歌恺悌风。\n一息不还成昨梦，六情都尽见真空。\n平时共说无生和，生死如今异与同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38313,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"哭曾令绰三首 其三","author":"韩维","text":"饰馆延归驭，维舟结胜游。\n黄花频采掇，白发共淹留。\n预约归田计，仍怀许国忧。\n斯言两不遂，恸哭竟何尤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38314,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"毌沆挽辞二首 其一","author":"韩维","text":"早接英豪论，闻君伯仲贤。\n高谈诸老屈，懿行一乡传。\n处顺宁违俗，求归不待年。\n终南山色好，长到酒樽前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38315,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"毌沆挽辞二首 其二","author":"韩维","text":"畴昔西游雍，相逢各壮年。\n坐从歌扇密，欢任酒杯传。\n乐事空尘土，清名自简编。\n耆英满朝路，回首一潸然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38316,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"故汉嘉太守礼院学士张公挽诗 其一","author":"韩维","text":"奏赋先多士，雠书并列仙。\n荣归衣屡锦，高议蕝尝绵。\n料寇流言止，安民善颂传。\n凭谁持絮酒，一酹蜀山前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38317,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"故汉嘉太守礼院学士张公挽诗 其二","author":"韩维","text":"吾交崔与范，取友得端良。\n直节晚仍苦，嘉名久更香。\n高怀轻世利，馀事入文章。\n万里缄哀恨，春风挽铎锵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38318,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"归许道中二首 其一","author":"韩维","text":"京洛风尘久客情，暂由归路眼中明。\n最怜杨柳青青色，徐策征骖唱渭城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38319,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"归许道中二首 其二","author":"韩维","text":"骆驼岗上沙如浪，马足东来困涉登。\n却羡长陂春水满，清晨渔子下寒罾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38320,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"丞相城上植柏","author":"韩维","text":"种柏东城次第高，便惊苍翠映霞朝。\n有心解报公封植，不学群芳艳易凋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38321,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和晏相公西湖","author":"韩维","text":"荷香时傍清樽落，菱蔓遥迎画舸开。\n行到南亭莫回首，绿杨阴外即风埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38322,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和晏相公湖上四首 其一","author":"韩维","text":"雾霁山高牖，天寒水落沙。\n试披深岸草，往往见黄花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38323,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和晏相公湖上四首 其二","author":"韩维","text":"穫水登红稻，篙舟割紫菱。\n杯盘见秋物，江海思飞腾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38324,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和晏相公湖上四首 其三","author":"韩维","text":"风枝挂危叶，飞动夕阳中。\n莫遣儿童撼，留看著露红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38325,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和晏相公湖上四首 其四","author":"韩维","text":"折苇随风色，枯荷尽雨声。\n平波极眼净，好放画船行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38326,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"莺二首 其一","author":"韩维","text":"春风摇动叶阴低，上下林间弄暖晖。\n似惜清音知者少，孤吟不尽又惊飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38327,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"莺二首 其二","author":"韩维","text":"鸣声清滑簧温暖，毛羽鲜明金瑩磨。\n剩拟墙边栽绿柳，好来相伴日吟哦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38328,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答师厚夜归客舍见诒","author":"韩维","text":"幽居直欲学忘言，忍对贤豪遂默然。\n谈到精微夜寥阒，秋风时下竹窗前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38329,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和晏相公湖上十月九日三首 其一","author":"韩维","text":"霜风吹林叶乱坠，波下叠叠如铺茵。\n渔人不用更安掺，直可凿水收紫鳞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38330,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和晏相公湖上十月九日三首 其二","author":"韩维","text":"断桥孤屿寒光外，短楫轻舟夕照中。\n未必江湖能胜此，野棠梨叶赤如枫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38331,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和晏相公湖上十月九日三首 其三","author":"韩维","text":"秋花含练犹强发，映水依林黄复丹。\n已觉微阳在波底，浴凫沈鹭不知寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38332,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"余去岁游襄城之高阳山逮今复来视壁间所识适当去年之游日作诗记之","author":"韩维","text":"曾访禅林翠霭间，再游时序已循环。\n自怜不是风尘客，独喜年年来看山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38333,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢送妃子园荔枝","author":"韩维","text":"年年驿使走红尘，贡入骊宫色尚新。\n妃子园名犹未改，一笼丹实寄闲人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38334,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"惠文编","author":"韩维","text":"一编高唱暑中开，习习清风匝地来。\n金作瓶盘珠就贯，知君亲到宝山回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38335,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江长官惠茶","author":"韩维","text":"春风北苑露芽繁，购得封题第一番。\n真际云门吾不问，一提瓶起万魔奔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38336,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄曼叔","author":"韩维","text":"陟径幽园独杖藜，幽襟默与好风期。\n欲知何处思君切，正对红团野杏时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38337,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酴醾花","author":"韩维","text":"细蓓繁英次第开，攀条尽日未能回。\n不如醉卧春风底，时使清香拂面来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38338,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢朱厚之惠米","author":"韩维","text":"水边看得霜粳熟，月下春来玉粒寒。\n不待鲁公亲折简，直忧颜子屡空箪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38339,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再用前韵答厚之","author":"韩维","text":"食新味美欣秋稔，求旧情深见岁寒。\n若共朱门论德义，万钟争及一瓢箪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38340,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"城西书事五首 其二","author":"韩维","text":"朱果繁霜后，甘甜半自零。\n忽惊林色曙，零落见残星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38341,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"城西书事五首 其三","author":"韩维","text":"犬吠村墟改，人移井臼空。\n谁家收栗罢，林脚有遗蓬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38342,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"城西书事五首 其四","author":"韩维","text":"松阴不可憩，冷冽恐飞霜。\n时有高风过，乾花落石床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38343,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"城西书事五首 其五","author":"韩维","text":"野竹蒙荒堑，寒花乱废墟。\n秋郊足幽事，直欲带经锄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38344,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"徐秘校过池上见访留五绝句 其一","author":"韩维","text":"林暗罢收笋，蹊空初扫花。\n静中泉落岸，清极雨沾沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38345,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"徐秘校过池上见访留五绝句 其二","author":"韩维","text":"舟小从波兀，桥深爱树遮。\n风烟生远思，何必慕乘槎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38346,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"徐秘校过池上见访留五绝句 其三","author":"韩维","text":"樽酒浮多蚁，舟篷覆似蜗。\n折杨争贯鲤，编竹自捞虾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38347,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"徐秘校过池上见访留五绝句 其四","author":"韩维","text":"多病宜田里，无名籍殿衙。\n一耽林馆胜，回首笑尘哗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38348,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"徐秘校过池上见访留五绝句 其五","author":"韩维","text":"怜君此休驾，长日坐倾斜。\n山雨催行酒，林烟候煮茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38349,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"始见龙门","author":"韩维","text":"十年长望洛川云，目极空思胜事繁。\n今日良游知我有，彭婆北下见龙门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38350,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和晏相公府东三咏 其一 韩王宅","author":"韩维","text":"开邦勋业高无让，启第规模壮绝邻。\n兴废感怀悲咤久，柳梢花叶自青春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38351,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和晏相公府东三咏 其二 楚家宅","author":"韩维","text":"婆娑桂树垂丹艳，落落松枝偃翠英。\n访古赏春俱有得，不劳勤远事幽寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38352,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]