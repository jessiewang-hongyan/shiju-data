[{"title":"次韵承君见寄 其一","author":"邹浩","text":"纷纷市道久成风，平地青楼作帝宫。\n白玉相看有君子，坐令高议薄冥鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56958,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵承君见寄 其二","author":"邹浩","text":"生平勋业在诗书，黑绶翩翩下蕊珠。\n漳水功名未为最，他年丹槛更捐躯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56959,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢承君见访","author":"邹浩","text":"龙吟虎啸岭云开，卷罢残经首重回。\n命驾直因中散去，赍羊不为护军来。\n真情破腊融初日，高论先春骇迅雷。\n勉力古人论一报，终惭瓦砾异琼瑰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56960,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵刘世德见赠","author":"邹浩","text":"诗书久与壮心期，邂逅尘埃满客衣。\n不分寿陵终失步，更怜蘧瑗早知非。\n龙蟠旧水风雷在，玉韫寒山草木辉。\n大抵穷通有时节，莫将吾道羡雄飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56961,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵文仲元日登巽亭 其一","author":"邹浩","text":"春随鼓角静浮游，放浪乾坤百尺楼。\n北陌东阡政车马，一时高兴属清流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56962,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵文仲元日登巽亭 其二","author":"邹浩","text":"刺字漫来得古城，柳枝桃叶入春情。\n人间久迟东君到，独子相投盖始倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56963,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵马叔宝忆梅","author":"邹浩","text":"儒冠染尽马蹄尘，又见年光冉冉新。\n寄我一枝无驿使，赖君佳句有阳春。\n雪边孤韵谢安石，风际幽香韩得真。\n何日相携拂衣去，澹烟微月楚江滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56964,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"仲弓意欲协律作此戏之","author":"邹浩","text":"王郎豪翰落明珠，自合鹓行俨帝居。\n底事奉常思协律，不归天禄更雠书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56965,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵仲孺用前韵寄世美二首 其一","author":"邹浩","text":"雪霁高阳里，欣欣春意深。\n旧游还入眼，何处复挥金。\n尘表谁南北，杯中失古今。\n重怜非土木，犹自一沉吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56966,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵仲孺用前韵寄世美二首 其二","author":"邹浩","text":"天宇梅边静，春光破蚁封。\n岭云犹过雁，冰浪欲飞龙。\n玉镫随新约，茅檐祗故容。\n何当卷书去，相与豁尘胸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56967,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵文仲落梅","author":"邹浩","text":"前引苍龙驾，人间春欲光。\n遽先鸿灭影，应误蝶寻香。\n何事雪霜际，不随松桧长。\n无言倚晴日，酌水与君尝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56968,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵仲弓寄德符大受","author":"邹浩","text":"二子麻衣掩旧春，霏霏眦血洒惊尘。\n白云不雨还遮岫，清颍无心解阅人。\n祸福循环终有数，诗书饱腹未为贫。\n何当跋马同君去，萝月松风慰秃巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56969,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"邻家集射","author":"邹浩","text":"墙东金鼓不停声，知是将军奕世孙。\n莫浪鸣弓向飞雁，一年一度到中原。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56970,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"曾园见梅 其一","author":"邹浩","text":"滨水娟娟四五枝，不甘柳眼巧相窥。\n晚来快我江南思，似欲慇勤报小诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56971,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"曾园见梅 其二","author":"邹浩","text":"姑射冰肌不黄土，洛阳玉容更青春。\n嗅风影日了无语，知我此心能几人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56972,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪中怀述之","author":"邹浩","text":"不为梁园赋，因辞颍水滨。\n谁知遇风雪，孤坐耿阳春。\n问路无来辙，携筇匪旧邻。\n从君一樽酒，犹喜有诗人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56973,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"招文仲","author":"邹浩","text":"晖晖晴日动寒灰，书罢衡门为子开。\n莫似王郎著杯酒，更无茶思竹边来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56974,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻小引呈仲孺文仲","author":"邹浩","text":"香中日月久无邻，特地过从两玉人。\n何必开轩视天壤，角声嘹亮自知春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56975,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"独坐","author":"邹浩","text":"庭下芝兰秀，堂中简策清。\n都缘无嗜好，不是近声名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56976,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻仲弓得籍田令","author":"邹浩","text":"夏木如云作昼清，西豪无复岸纶巾。\n知君谈笑籍田去，又喜长安有故人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56977,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"对雨","author":"邹浩","text":"不为泥融俟燕还，自携秋事入春田。\n人间因得风光好，洗出从来寒食天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56978,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寒食日诸友见过","author":"邹浩","text":"燕子声中藿食寒，北辕同轨得儒冠。\n槐檀新火未曾试，为觅山泉破小团。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56979,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和仲孺前韵约赏展江海棠及简仲弓述之 其一","author":"邹浩","text":"西蜀地暖北地寒，长条殿春走衣冠。\n江亭巧作故时面，濯濯宫锦花成团。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56980,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和仲孺前韵约赏展江海棠及简仲弓述之 其二","author":"邹浩","text":"一日秋阳十日寒，李下多机难整冠。\n戴崇彭宣各天性，玉斧何当新月团。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56981,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"曾园见海棠","author":"邹浩","text":"海棠簇簇弄繁英，随分相逢眼自青。\n一种风流似西蜀，何须心着展江亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56982,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戏明豫","author":"邹浩","text":"西幕情真庭驻云，东幕心机门闭春。\n无端幽梦落蛇虺，漏泄风光来近邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56983,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"代者不以时至失仲孺同行之约怆然作此","author":"邹浩","text":"平日莼鲈计，犹随黄犊留。\n苏君验前语，裴子但孤舟。\n隋柳薰风岸，淮山霁月楼。\n故应今好在，为我一回头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56984,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上巳日招仲孺述之","author":"邹浩","text":"三月三日颍水滨，兰亭故事颓冠巾。\n与君嗜好酷相似，速来同鲙盘中鳞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56985,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵仲弓马上","author":"邹浩","text":"霜蹄遥指日边飞，犹得春湖一笑期。\n到此君方动离思，并将怀抱入新诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56986,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵君表送仲弓回有作","author":"邹浩","text":"北野阴成幄，崇朝得暂休。\n班荆无浊酒，交辔有清流。\n风絮閒相逐，晴丝懒自游。\n吾行亦朝夕，未拟问功裘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56987,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"招仲孺述之同过文仲看酴醾","author":"邹浩","text":"芝堂公子读书忙，堂下酴醾晚自香。\n犹喜阿文清兴在，拟携双璧步斜阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56988,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵谢文仲惠酴醾","author":"邹浩","text":"绕架应怜不记归，故分新摘慰栖迟。\n慧香妙质无人共，赖有青笺寄我诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56989,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵龙阳孔方平秋居见怀","author":"邹浩","text":"黄落龙山暮，天高霁色澄。\n栖岩方自若，吾子亦难能。\n家学潜东国，时文斥茂陵。\n遥知见怀处，诗就耿寒灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56990,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和钱塘诸公赏梅十绝 其一","author":"邹浩","text":"冲寒来访喜生和，破恨新诗不必多。\n太皞初还好消息，从今日饮更无何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56991,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和钱塘诸公赏梅十绝 其二","author":"邹浩","text":"琼英潜解叩灵台，一见先令双眼开。\n欲识情缘未忘处，不辞珠履步苍苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56992,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和钱塘诸公赏梅十绝 其三","author":"邹浩","text":"云山寂寂水回回，幽境非缘世俗开。\n桃李无言且如此，自然人逐暗香来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56993,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和钱塘诸公赏梅十绝 其四","author":"邹浩","text":"江天吹雪不胜繁，南北东西晚更昏。\n料得时人散车马，清吟应亦有英魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56994,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和钱塘诸公赏梅十绝 其五","author":"邹浩","text":"陈根未作去年花，天宇空明雁影斜。\n忽上溪桥见颜色，不施朱粉似东家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56995,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和钱塘诸公赏梅十绝 其六","author":"邹浩","text":"排闼端令天地开，万花从此四时催。\n政如匠石椎轮后，始有光华大辂来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56996,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和钱塘诸公赏梅十绝 其七","author":"邹浩","text":"东风柝柝动冰泥，素萼迎春满故枝。\n早晚团空熟青实，人间消渴待真医。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56997,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和钱塘诸公赏梅十绝 其八","author":"邹浩","text":"蜜蜂蝴蝶未狂飞，蝼蚁仍难上冻枝。\n惟有青松一千丈，相看曾共岁寒时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56998,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和钱塘诸公赏梅十绝 其九","author":"邹浩","text":"绰约冰肌故自轻，玉衣玉食更鲜明。\n无心来此与君遇，莫起他时儿女情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56999,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和钱塘诸公赏梅十绝 其十","author":"邹浩","text":"玉树森森太傅家，玲珑徐动晓风斜。\n可怜刻楮空机事，一叶三年犹未花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57000,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戏舜俞游西湖","author":"邹浩","text":"湖光收尽只芙蕖，决眦飞来白鸟孤。\n想见城南葛藤老，又将心境示妻孥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57001,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠周仁熟教授","author":"邹浩","text":"西来黄轴塞虚空，都在圆光一点中。\n陌路劝君高着眼，宗风况即是家风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57002,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵答李希白秀才","author":"邹浩","text":"数椽茆屋异千间，惭愧君歌行路难。\n自昔牛羊多列鼎，只今藜藿未盈箪。\n须将嘉木殷勤植，莫把修鳞取次蟠。\n请看齐城不危困，功名岂复有田单。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57003,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵德符马上口占","author":"邹浩","text":"直欲掩关心似水，不知开国面如田。\n相逢一枕秋光里，疑是先生亦姓边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57004,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春阴","author":"邹浩","text":"极目三封日易斜，无因重守故庭花。\n春阴又是怜花草，燕子飞来知几家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57005,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻莺","author":"邹浩","text":"樱桃初熟露珠轻，客里光阴晓更清。\n犹恐先生只归梦，故携天籁入风声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57006,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵仲弓见答","author":"邹浩","text":"青衫白马吏天边，胸次长年只辋川。\n我愧无才似裴迪，亦缘春步见新篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57007,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"席上呈仲明","author":"邹浩","text":"诵诗久欲陪苏焕，载酒谁怜访子云。\n莫道囊空乏供给，邻家芹菊许人分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57008,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次王彦鲁韵呈仲弓","author":"邹浩","text":"城南兼吏隐，草树水中央。\n飞鸟有时到，惊尘无处扬。\n留春供燕集，落日借辉光。\n一自乌衣后，风流知几王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57009,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送郭舜俞再任颍昌","author":"邹浩","text":"谷雨冥冥春尽头，故人重解去时舟。\n西湖好在一百顷，为我传声到白鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57010,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初到京谒执政","author":"邹浩","text":"邹阳谩说曳长裾，东阁由来礼自殊。\n负郭田园倘无恙，不如归去老江湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57011,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵文仲冬夜书怀 其一","author":"邹浩","text":"抱经何必叹空言，看取东郊旧力田。\n藨蓘倘能无落事，太阴居卯定丰年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57012,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵文仲冬夜书怀 其二","author":"邹浩","text":"长冰迎日动堤塍，堤上人行似独醒。\n只有群鸥疑着在，一时飞舞起寒汀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57013,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵文仲冬夜书怀 其三","author":"邹浩","text":"冷官裘马怯凌风，咫尺云窗邈异封。\n长忆去年同燕处，竹边梨栗送残冬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57014,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初夏过西苑呈商居平程良弼二年兄","author":"邹浩","text":"红香吹尽绿阴垂，恰似当年锡宴时。\n今日玉津楼下过，午声依旧啭黄鹂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57015,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵蔡天启寄籍田令","author":"邹浩","text":"兴来云路欲飞仙，风更吹凉入绮钱。\n岂但乌衣今莫逆，也知白鸟旧相便。\n波随静止荷初展，舟逐閒移楫自眠。\n我亦书边有馀日，与君同到五湖天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57016,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨中","author":"邹浩","text":"五月沉阴久不开，冷风吹雨满天街。\n老农且莫愁蚕麦，丞相祈晴已宿斋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57017,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与存之会相国","author":"邹浩","text":"雨中竹叶不胜翠，风过榴花元自红。\n门外喧喧正商贾，与君趺坐入真空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57018,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梦阎求仁","author":"邹浩","text":"朱衣象笏肃宾阶，平昔襟怀向我开。\n犹恐孤根自摇荡，故传好语梦中来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57019,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登建隆回呈俞秀老","author":"邹浩","text":"瘦骨崚嶒耸碧峰，应缘曾住大明东。\n道吾埋没今何处，少室分张昔已空。\n殿阁不移秋际影，松篁犹韵晓来风。\n为人彻困无人解，借问三生庞德翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57020,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"虎丘晚归呈同游","author":"邹浩","text":"虎丘山色最宜秋，山下溅溅亦可舟。\n北去几年空好梦，东来今日快昏眸。\n邦畿正蔼无双誉，杖履仍逢第一流。\n邂逅高风许追逐，异时应拟岘山头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57021,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"济明不预虎丘之游作此寄之","author":"邹浩","text":"虎据千年一故丘，尔来形胜绝南州。\n池清不碍龙收影，台迥犹疑石点头。\n白日青天秋更好，幅巾藜杖晓同游。\n遥知正拥双旌坐，直上云峰一凭楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57022,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再用前韵答济明见和","author":"邹浩","text":"长笑空言谩九丘，更携馀刃佐方州。\n老奸不复潜封内，佳句终然到笔头。\n秋入江山供远思，路回猿鹤伫清游。\n只应未厌斯民乐，还听钟鸣十二楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57023,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和通判梁端夫朝奉晓登岘山有作","author":"邹浩","text":"天宇霜来岘首高，爽心先寄雪中桡。\n早陪胜集方多暇，应念前人不复朝。\n雁影有时摇莽苍，江声终日上岧峣。\n遥知清绝诗成际，正似寒窗火欲销。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57024,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和端夫席上送樗年","author":"邹浩","text":"过额纷纷竞扫眉，此心直与古人期。\n三年并席惟夫子，一笑忘言谢小儿。\n江国旧编尘漠漠，帝乡新路日迟迟。\n儒冠道在无通塞，莫问高门知不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57025,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄世美","author":"邹浩","text":"江南秀色满崔嵬，上得平山入眼来。\n遥想归心动朝夕，不应犹待八仙开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57026,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢端夫惠梁因求馀材","author":"邹浩","text":"破竹诛茆屋数椽，尔来风雨荡朝昏。\n岂知东阁犹堪厩，若比胶庠不可园。\n蓬荜已甘聊卒岁，栋梁谁谓入衡门。\n因公起我高堂意，更乞馀材千万根。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57027,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再用前韵答端夫见和","author":"邹浩","text":"朝衣暂此拥屏星，长笑他时智慧昏。\n不以诚心尊孔氏，却将吾道奉祇园。\n由来博施能周物，曾是寒生亦叩门。\n只恐堂成待公落，镜中黄色尚山根。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57028,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"简襄阳令田世德通直求馀材","author":"邹浩","text":"百里江天指顾中，大夫真有古人风。\n似闻斋馆成功久，应许馀材入泮宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57029,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]