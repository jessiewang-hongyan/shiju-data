[{"title":"题洪阳洞","author":"许及之","text":"划开灵怪几千年，传与洪阳二老仙。\n石室尽头真境秘，天窗明处葆光圆。\n乳泉煖滴烧丹井，芝径畦分种玉田。\n不是到来须束火，故应名胜限嚣廛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22173,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闻转庵游西湖奉寄","author":"许及之","text":"马上春光过若驰，不须纪历校花时。\n青于前日长街柳，白似去年双鬓丝。\n强学后生须藉酒，苦邀同社索题诗。\n朝回要便西湖去，输与安仁尚黑髭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22174,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"酬常之换韵和江心寺诗","author":"许及之","text":"千峰屏绕浪环铺，莫把金焦作对呼。\n绝境谁窥全体现，小亭人号媚川图。\n市声非远尘难到，塔影虽双屿只孤。\n大似橘洲浮不去，岳根元插赤沙湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22175,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再次常之换韵题江心寺诗","author":"许及之","text":"山川如画镇长铺，每坐危亭谓笑呼。\n大艑扬帆飞略彴，巨鳌出水载浮图。\n锦袍仙想前峣古，饭颗神游绝境孤。\n不是谢公亲历览，相忘祇竟渺江湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22176,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"媚川图亭上观江心寺","author":"许及之","text":"三山海上失双峰，插作中川镇水龙。\n高出赭垣尊御寝，长拖粉庑过僧筇。\n夜敲图绕千灯磬，晓击声闻两岸钟。\n莫恨无缘随展钵，时来亭上足从容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22177,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"某谬题媚川图江心寺晚荷仲归兄依韵宠和至再愈工勉酬厚意终惭辞费","author":"许及之","text":"孤亭面直海坛峰，真睹龙翔瑞应龙。\n长羡僧行图上境，不劳杯渡水边筇。\n推移日月东西塔，透彻天渊昏晓钟。\n妙处难将声相见，吟摹终恐费形容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22178,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"酬翁常之和媚川图上观江心寺诗","author":"许及之","text":"江北屯云翳列峰，江心灵雨走神龙。\n已拚阮子一生屐，更倚仙人九节筇。\n晻霭孤帆昏野渡，霏微两塔湿疏钟。\n何须小米模糊笔，潘令新诗足写容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22179,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送吴待制安抚襄阳 其一","author":"许及之","text":"天借琳琅镇上流，西风作意送行舟。\n去看岘首何因感，遥见长安却是愁。\n平昔勋名期带砺，向来谈笑饱貔貅。\n轻裘少展筹边略，归问君王觅酂侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22180,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送吴待制安抚襄阳 其二","author":"许及之","text":"如君自是急难材，牛斗光芒未烛台。\n何以家为人咄咄，维其时矣诏来来。\n临湖尽去封侯橘，度地先栽调鼎梅。\n恶语流传真引玉，满怀明月向人开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22181,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送何正言持节湖南","author":"许及之","text":"山庄寂寞信惊猿，鹓鹭行疏亦断魂。\n持节过家天借便，引嫌得请帝疏恩。\n湘云开处峰峰好，谏纸藏来字字温。\n只恐夜深思贾傅，长沙宁久驻轺轩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22182,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送赵端明帅蜀","author":"许及之","text":"谋深无位可酬功，端殿几廷礼数同。\n尽以四川归节制，重乘九折见精忠。\n平生清白天垂相，简在登庸帝降衷。\n万里桥头莫言远，恩波只在大江通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22183,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送邹国遂武博知濠州二首 其一","author":"许及之","text":"长髯如戟气如虹，只欠吾曹抹额红。\n右序谈兵瓴建水，上前论事殿生风。\n恳辞射策登宾阁，乞许分符立战功。\n他日濠梁真得意，要看鱼水得君同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22184,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送邹国遂武博知濠州二首 其二","author":"许及之","text":"孤屿秋风忆钓蓑，因君理棹起劳歌。\n分留乡思从兹始，报答君恩奈若何。\n陶令篱傍犹有菊，伯龄石上苦无禾。\n问言何补青蒲事，为道新来白发多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22185,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送毛监丞知漳州","author":"许及之","text":"参裨不解力吹嘘，掺别何劳叹索居。\n子去定为慈父母，邦人应得乐田庐。\n临漳从此无苛吏，严濑曾闻治猾胥。\n暇日若亲横槊赋，为言珍重百砗磲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22186,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送胡司谏同年赴湖北漕","author":"许及之","text":"洞庭青草碧相连，使节经行别有天。\n又辍谏官湖外去，要苏民力未央前。\n一枝腊雪边江驿，百丈春潮上水船。\n小驻轺轩私雨露，司存及早侍甘泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22187,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送潘德久都干为贺生辰使属","author":"许及之","text":"乃翁旧取燕山第，子恰从人去使燕。\n孽子孤臣应有泪，祖功宗德本无边。\n离离故国摇鞭影，耿耿新诗贮腹便。\n父老相逢勤劳苦，为言咫尺中兴年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22188,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送张子仪尚书镇福州","author":"许及之","text":"暂违天陛星辰履，便上春风李郭船。\n两地逼人真勇退，三山去路俨登仙。\n循环花甲趋庭日，遗笏棠阴在镇年。\n盛事相望已无匹，宝奎新赐更光前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22189,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送直院楼尚书同年以阁学知婺州二首 其一","author":"许及之","text":"受敌词章八面全，庆元书诏四方传。\n星辰听履聊纡步，笔墨论功即化权。\n将母愿为符竹计，投诚径缴冕旒前。\n暂烦明月双溪照，两两台星尺五天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22190,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送直院楼尚书同年以阁学知婺州二首 其二","author":"许及之","text":"隆兴最盛初元榜，当日曾推第一人。\n出世经纶知几佛，看君意度不无神。\n居然勇退非惊俗，行矣追随亦为亲。\n只恐苦无明月句，经行难作隐侯宾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22191,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送禹之皋之舅赴调二首 其一","author":"许及之","text":"我是次公门下客，登龙因许与乘龙。\n只今击柝从关吏，渐可扶犁作老农。\n莫报黄垆埋白玉，满看清庙列金钟。\n二难自是从来誉，勉事功名定亢宗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22192,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送禹之皋之舅赴调二首 其二","author":"许及之","text":"九年清梦落鸣珂，尊酒相逢奈乐何。\n但恨醉人成谬误，莫嗔惊汝感摩挲。\n行装忽指吴门道，别意今随楚水波。\n若访水仙逢处士，为言新句苦无多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22193,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"用楼尚书韵饯同年曾寺丞守温州","author":"许及之","text":"三十三年同日喜，忆曾书札问淮堧。\n造朝合究三千牍，出守聊违尺五天。\n官舍君应思系马，家山我亦念斜川。\n政成的有天官列，不拟攀辕拟执鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22194,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送刘东玉提干之官茂苑","author":"许及之","text":"共论隶古弄文漪，酌别宁忘载酒卮。\n去去台中摅婉画，行行箧里富新诗。\n向来阀阅多丹禁，岂有人门后白眉。\n九万扶摇从此始，他年书劄问茅茨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22195,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送石谦伯就许襄阳辟","author":"许及之","text":"襄阳耆旧流风在，幕府文书并省馀。\n勿以脩涂愁泛宅，不妨胜处憩安舆。\n碑存岘首堪怀古，诗忆槎头匪为鱼。\n万里功名从此始，勉旃声价百砗磲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22196,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送郑仁叔宰长溪","author":"许及之","text":"清于道骨澹于僧，海内忘形得此朋。\n作县只如诗思苦，能官已被荐书腾。\n下车搏虎真堪笑，入境无蝗定有称。\n我亦孤愚谙此味，愿言加饭履春冰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22197,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"黄叔万知县以鲁名斋求诗将赴公安并以为饯","author":"许及之","text":"堂堂张也竟难为，一唯工夫鲁得之。\n得兔故应忘百虑，亡羊正尔失多歧。\n千林摇落青还在，孤月当空影自随。\n昔日校官今作县，鲁斋行处即吾师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22198,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送王子大知县","author":"许及之","text":"金闺通籍绾铜章，荔子黄时恰到乡。\n僧夏相期尘外住，官期将趣橐中装。\n倾心栖棘仇香地，侧耳鸣弦单父堂。\n说著江西如故里，南城春色胜河阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22199,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送余伯益知县","author":"许及之","text":"建章万户及千门，博物如君自不群。\n入幕向来争论荐，鸣琴此去定知闻。\n官惟作县堪行志，闽独于盐害未分。\n剖竹乘轺同臭味，愿求长策献吾君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22200,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送郑节卿赴新喻丞并呈李谏议","author":"许及之","text":"南漳抚字溢三年，当路文章喜荐贤。\n鹤发有亲须禄养，鹗书无地足常员。\n为丞盍过滕王阁，诣府欣依刺史天。\n谏议恩深曾一顾，烦君为我道拳拳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22201,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送郑廷玉教授之官邵武","author":"许及之","text":"太学声名十五年，鸡林副墨竞流传。\n诸生定满升堂履，独冷何愁坐客毡。\n预恐上方催给劄，便应西笑去朝天。\n君王若问安边策，上药良医有十全。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22202,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"沈架阁席上送沈教授之官邵阳二首 其一","author":"许及之","text":"祝融七十二峰尊，诸老相望古道存。\n二邵人才元有种，三湘风物向曾论。\n先生此去行师说，弟子从今记善言。\n为访衡山戴监岳，可能略不傍华轩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22203,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"沈架阁席上送沈教授之官邵阳二首 其二","author":"许及之","text":"郡侯名字祖鞭先，郡倅风流世有传。\n更著广文铛脚坐，亦怜委吏鼎科年。\n江山莫道非吾土，官舍曾无有此贤。\n自是蓬莱山上客，枉教予作送行篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22204,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送简寿王主簿之官番禺","author":"许及之","text":"住久江西近物情，闻名虽旧盖初倾。\n未听健论折髯喜，况有新诗出袖清。\n为簿免从高士例，饮泉要改昔人名。\n为言牧伯乘骢旧，愧尔传家折槛声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22205,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵临川傅簿经过道旧之什","author":"许及之","text":"倾盖临川卜再逢，岁华飘忽老秋风。\n汗颜何补千人聚，过眼还惊万马空。\n今子所淹栖棘地，曩余曾掌采芹宫。\n种松已长烦公问，梁栋如今中未中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22206,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送鲍清卿运干调官还里二首 其一","author":"许及之","text":"笔端有印印金泥，榜榜名高米样齐。\n两郡漫游官似水，七阶懒觅荐为梯。\n登瀛已近帆惊转，入幕虽卑首愿低。\n举士引嫌堪自愧，眼看湖海放凫鹥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22207,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送鲍清卿运干调官还里二首 其二","author":"许及之","text":"家住城南水竹村，羡君月榭与风轩。\n头颅已料书生骨，言语难酬明主恩。\n何日致还归里社，也教依样买山村。\n弹边求炙君怜我，许种名葩寄后园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22208,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送范南宫守彭归蜀","author":"许及之","text":"起草南宫著作庭，历阶亦合侍承明。\n乞身只拟分符去，持节何妨衣锦行。\n道在不孤知己旧，才难偏怆语离情。\n极知便下思贤诏，其奈巴江白发生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22209,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送黄元章秘书还馀杭待次荆门","author":"许及之","text":"蓬莱云色正飞浮，猛乞分符向玉州。\n抵鹊信嫌三献辱，如虹肯要万金酬。\n勋名不朽山为砺，轩冕随缘芥作舟。\n却憾渥洼求汗血，不如天厩出骅骝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22210,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送郑节推胜弃职归省","author":"许及之","text":"慷慨中原泣夜阑，一门忠孝只南冠。\n来归九死赊犹易，就养一官轻底难。\n幕府礼罗留莫住，清时长铗惜休弹。\n男儿富贵寻常事，要取功名与世看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22211,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送郑南秀解秩东归","author":"许及之","text":"小麦茸茸短覆泥，如何熟得济民饥。\n青黄未接我狼顾，黑白既分君解龟。\n已拜一言真苦口，极知三折是良医。\n从今洗眼看华要，书札无忘慰梦思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22212,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送谷仲归谦谢以诗次韵奉酬","author":"许及之","text":"一乐长存抵万金，百年谁肯放愁侵。\n饭蔬饮水真吾事，怀宝迷邦岂本心。\n桑户琴歌奚此极，孔门弦诵有遗音。\n新诗当暑时时至，每读清风自满襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22213,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送解省元赴南宫","author":"许及之","text":"过庭有子即同登，学圃承家岂足称。\n刻画无盐容更丑，宠光蕙草句全胜。\n名场自此一投足，宦路不须三折肱。\n累月笞儿吾岂敢，短檠犹可课秋灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22214,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送林定国赴秋试","author":"许及之","text":"读却床头满架书，时文元不费工夫。\n向来点额关奇数，今日焚舟合壮图。\n去去秋风趋北阙，行行春色满西湖。\n痴儿未了书生事，珍重青衫报国躯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22215,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送刘守之上舍赴试","author":"许及之","text":"乃翁壮誉动贤关，晚把州麾苦要閒。\n细字尚陪灯火课，淡书端要姓名攀。\n扶摇稳泛鱼三级，文采曾窥豹一斑。\n舍弟若为同日喜，两家亲老想开颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22216,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵饯振之之行","author":"许及之","text":"半生经吏竞分阴，奏牍三千几汗青。\n技到屠龙从俗笑，志存流水有人听。\n故园勋业千株橘，世路生涯一草亭。\n却笑刘商长得醉，为无管属爱浮萍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22217,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送安福刘秀才谋卿仍简分宜傅公谋","author":"许及之","text":"昨夜西风入楚扉，登临游子倦将归。\n璧廱未顿新书笥，锦里还寻旧钓矶。\n平世勋名赊马革，男儿贫贱且牛衣。\n傅岩词客如相问，说是今非昨更非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22218,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送德友之长沙章贡并怀薛叶二兄","author":"许及之","text":"篇章足可慕渊明，其奈田无二顷耕。\n甥馆久居谁厌汝，客涂远问我怜生。\n湘山物色留新句，使节绨袍有故情。\n并语郁孤东道主，春风吹梦到容成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22219,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送陈西老西上并简张功甫","author":"许及之","text":"二月春光韵管弦，琴书独上馆头船。\n箧中未有西湖句，阙下曾传乐府篇。\n名胜难逢分手易，游从虽晚服膺先。\n有如尚待金门诏，须访南湖桂隐仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22220,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"中川席上送陈同甫","author":"许及之","text":"眼底男儿隘六区，似君豪气有谁如。\n中原赤子头今白，天下苍生力未纾。\n北阙有书流涕上，西山无地带经锄。\n共谈世事何时了，劝子加餐返故庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22221,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送俊老再住惠因","author":"许及之","text":"天台自是金仙窟，而况师曾住惠因。\n祖令全提馀作略，旧营重按想精神。\n绝怜老宿参辰象，何限名蓝甲乙人。\n若遇毒龙师摄取，经行杯渡熟知津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22222,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送清监寺往平阳化缘清乃王詹事女","author":"许及之","text":"詹事家中灵照女，月圆会下祖师禅。\n一条见地如丝直，百架脩廊尚结缘。\n飞锡先从坳里去，掷杯聊当渡头船。\n更于何处求真佛，说似檀那领现前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22223,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"喜德久从人使北来归","author":"许及之","text":"诗翁万里恰归来，涤面那无一点埃。\n生马谙骑便武事，故京熟览动诗才。\n别来我已成炊梦，此去君应悟劫灰。\n见说北庭犹假息，可无尊酒沃崔嵬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22224,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和袁同年接伴赓从客陆成文韵","author":"许及之","text":"雁塔题名不记年，相从淮海喜跫然。\n了知鹏鴳悬微分，祇觉夔蚿有故怜。\n共泛仙舟凌浩渺，赓吟醉墨堕芳鲜。\n少游陈迹无寻处，小五湖中水拍天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22225,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和袁同年接伴赓从客霍希文过楚州韵","author":"许及之","text":"一水分流西复东，画船随水去匆匆。\n晚风鼓角增悲壮，高垒营屯足长雄。\n粮道已无清口应，舟师会把朔庭空。\n眼中方略全图在，未肯轻将属画工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22226,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵袁同年回程见示","author":"许及之","text":"秋风日日动诗情，人与诗篇一样清。\n归去星辰添秀润，经行草木倍精明。\n河山未阂功名志，岁月徒催鬓发生。\n送客微言何足录，便将佳句榻前呈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22227,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"吴门次韵颐刚严陵留别过新安","author":"许及之","text":"功名破甑等虚空，身世随缘邴曼容。\n行色过于秋澹薄，离情恰似酒醇浓。\n想君时看水西景，顾我方听夜半钟。\n莫计升沉须强饭，男儿爱惜鬓星松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22228,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"因振之之行过新昌怀鲍清卿","author":"许及之","text":"新昌令尹鲍参军，中的声名孰似君。\n未免徒劳纡墨绶，不教平步上青云。\n句如冰柱当庚伏，心似秋空纳世氛。\n岂为求齐工鼓瑟，知音合遣九霄闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22229,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"怀转庵饯客","author":"许及之","text":"一水经行昔饱谙，故乡真似是淮南。\n杏花岩畔春携酒，杨柳堂前夜驻骖。\n邻境不停科甲马，吾民常喜足田蚕。\n风谣物色堪诗句，饯客归时问转庵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22230,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"南省帘外唱和五首 其一","author":"许及之","text":"句读江西独亢宗，笔裨造化蚤论功。\n相逢客已传河尹，未见天教忆戴公。\n欻讶鞭鸾仙尚散，犹怜小草味能同。\n明朝遣客方公事，醉墨何妨落暮鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22231,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"南省帘外唱和五首 其二","author":"许及之","text":"寒似西来不立宗，酒兵屡敌故难功。\n诗成染笔能忙事，勘罢糊名也自公。\n细雨烧灯惊节过，清尊华发与君同。\n故园花讯新来少，欲问平安无过鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22232,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"南省帘外唱和五首 其三","author":"许及之","text":"画史何人更姓吴，梁园重与续成图。\n晴泥正好一犁雨，归思还先六幅蒲。\n院锁馀寒春力峭，书残午后客情孤。\n新诗剩喜相料理，已觉胸中隘五湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22233,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"南省帘外唱和五首 其四","author":"许及之","text":"桃李枝头锁冱寒，天工一笑发嫣然。\n唤回雪苑阳春脚，幻出琼壶小有天。\n欻看南图羊角上，恍思西抹阿婆年。\n政须点勘频呵护，准拟开函近御筵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22234,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]