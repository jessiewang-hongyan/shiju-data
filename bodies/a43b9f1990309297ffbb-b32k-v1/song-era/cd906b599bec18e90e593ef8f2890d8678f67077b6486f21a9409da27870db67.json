[{"title":"阻雨","author":"韩淲","text":"独坐空堂上，忧来与谁语。\n出门欲远游，泥雨复艰阻。\n不见一人来，那逢会心侣。\n前除一幽禽，四壁响饥鼠。\n无以涤睡昏，春茶尚可煮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25265,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自清明后十日雨","author":"韩淲","text":"得雨宜秧田，久雨损麦陇。\n日暖可成实，天寒妨出种。\n米面世所资，敢为一身奉。\n望眼冀晴色，深为农夫恐。\n长林风飕飕，狭港水汹汹。\n闲谣不能欢，名与食孰重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25266,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雨中作","author":"韩淲","text":"闵雨涧将涸，为霖流复湍。\n声来白浩浩，气起清漫漫。\n随山问本源，踏地观狂澜。\n隔水城市尘，了然不相干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25267,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"初三日雨","author":"韩淲","text":"一林梅花雨，香湿烟冥濛。\n水流涧底清，声落前溪中。\n鸟飞既整暇，人意亦冲融。\n今岁春来早，新萱已满丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25268,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雨中","author":"韩淲","text":"山林得凉雨，倍觉十分秋。\n衡门篱落间，木槿上牵牛。\n霏微弄空明，炊烟澹飞浮。\n有酒不肯饮，南冠真楚囚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25269,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夏雨","author":"韩淲","text":"已忻五月凉，连得六月雨。\n泉石养芝朮，圳浍长禾黍。\n病虽未能饮，起亦尚可句。\n凌晨百鸟啼，静夜百虫语。\n寺外钟磬音，樵歌自来去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25270,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"阴雨","author":"韩淲","text":"变风忽交作，雨脚窗纸鸣。\n隘巷掩关坐，炉深沸瓶笙。\n岂不念故山，斗升聊自营。\n米贵薪炭少，天亦放我晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25271,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夜霜窗户肃然严冷","author":"韩淲","text":"行都镇东南，衣冠萃轩盖。\n文书漫穰穰，人物当蔼蔼。\n痴或不知止，隘即莫可奈。\n江山何清空，天地本正大。\n四更霜气重，肃若起深籁。\n乃信埃?中，此景终不害。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25272,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雨后","author":"韩淲","text":"夜煖雨骤至，沟流起微湍。\n一秋多苦晴，鱼虾生意艰。\n朝来清蛙鸣，便觉斗水宽。\n岂不念其涸，跳梁聊自欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25273,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"凉雨","author":"韩淲","text":"凉雨濯袢暑，中林动清觞。\n一日亦易与，千古不可忘。\n人物信消长，治运空微昌。\n我有插架书，醉甚无慨慷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25274,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"社雨 其一","author":"韩淲","text":"空山水流涧，社雨掩篱门。\n云阴起微寒，药炉自常温。\n老懒一欠伸，开卷窗明昏。\n屋边桃李蹊，飞飞亦无言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25275,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"社雨 其二","author":"韩淲","text":"开帘卷书坐，燕声烟雨中。\n时物依辰至，春社古所同。\n岂不知其然，岁月何匆匆。\n拥襟一闲谣，林花落檐风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25276,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅雪","author":"韩淲","text":"残冬且论诗，岂待梅与雪。\n雪固以水清，梅自惟花洁。\n玄机未易窥，圣解不难说。\n弃置便扫除，俗者虑上拙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25277,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"松雪","author":"韩淲","text":"松雪照残腊，沟流起轻冰。\n倦身固蹒跚，睡眼犹瞢腾。\n尘埃与野马，何急来相仍。\n东邻可以饮，一举宜数升。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25278,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪","author":"韩淲","text":"我枕曲藉糟，女为彼玉雪。\n惊心京索旧，流徙此越绝。\n霏霏醉飞花，堂上烛勿灭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25279,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"积雪","author":"韩淲","text":"积雪有何好，照我窗牖明。\n窗明不能寐，披衣数寒更。\n带雨岂灭踪，无风如有声。\n荒荒山野人，渺渺江海情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25280,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"坐想孤山雪竹压篱碍过之胜","author":"韩淲","text":"诗亦常语尔，细思有何情。\n瞀瞀青眼收，种种白发生。\n不如缄口住，时复信脚行。\n折竹松边路，孤山篱雪清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25281,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"回路雪作野酤","author":"韩淲","text":"适俗心不夷，索隐山不深。\n驾言出春浦，回车已留阴。\n雪飞催我句，村酤且重斟。\n此致天所资，优哉有遗音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25282,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪中 其一","author":"韩淲","text":"雪映山窗白，竹炉残叶灰。\n寒垂纸帐低，起坐百念催。\n推枕理吾梦，栩栩鼻如雷。\n觉来神气中，平旦阳明开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25283,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪中 其二","author":"韩淲","text":"净业与秽业，交战则我微。\n未能涤玄览，前识相依违。\n玄冬霜后雪，涧谷慵启扉。\n天耶其人耶，咸言上上机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25284,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪中 其三","author":"韩淲","text":"今年已有雪，今年亦有梅。\n梅花与雪片，日夕相徘徊。\n失喜固莫尔，亡忧尚何哉。\n不与万法侣，孔蹠俱尘埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25285,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪中 其四","author":"韩淲","text":"泾渭本一水，浊清我何尤。\n白雪固为洁，老兴开两眸。\n须臾冥心坐，薪火时添抽。\n咄哉皆前尘，秃发不满头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25286,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪中 其五","author":"韩淲","text":"鸟声已鸣春，涧庐雪色深。\n纷纶五经笥，古人云鉥心。\n心本理和顺，万缘常逼侵。\n莫作断灭相，明明去来今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25287,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赵十有诗及高泉之行因思往年同游青岩","author":"韩淲","text":"秋花满青岩，禅榻如昨日。\n举眼曾几何，岁月流电疾。\n君其壮藻思，我已老蓬荜。\n谁云彼高泉，春晚又能出。\n寺底读叶碑，祠前看周笔。\n夷犹慨以慷，缅邈咤而叱。\n思君弟行役，应惜良会失。\n朋从淫液之，于我岂固必。\n旁观徵逐间，往往诮游逸。\n相望一樽酒，朱弦理青瑟。\n坠绪或可寻，陈迹安可诘。\n澒洞尘眯人，荣名真虮虱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25288,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题南豅","author":"韩淲","text":"南豅山下路，一眼烟雨昏。\n松篁叶满地，杨柳条映门。\n此兴非所难，吾道何由尊。\n铿尔舍瑟希，带湿藏春痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25289,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游南高峰下","author":"韩淲","text":"濛鸿山气润，喷薄涧水急。\n残花护新枝，春晚绿阴集。\n杖策一俛仰，挈榼共行立。\n路转南高峰，窣堵正嶪岌。\n胜迹古今同，轩裳孰羁絷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25290,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谭守约陈漕林宰同游南岩得问字","author":"韩淲","text":"高情动岩壑，幽讨忘远近。\n追随得秋日，挈榼多美酝。\n悠悠远朝市，寂寂委时运。\n雨集星散间，他年或相问。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25291,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"霞山","author":"韩淲","text":"避喧甘猛虎，杜语诚有味。\n况此古城游，尽迥尽无畏。\n扪萝鱼贯登，荦确入荒蔚。\n俄而得峻极，天阙逼象纬。\n春风犹未旬，芳事已髣髴。\n凭虚了不寒，清淑满肠胃。\n眼高物破碎，意广身良贵。\n隘彼微尘歊，邑郭亦何谓。\n同来三二友，斯道久泾渭。\n偶然一尊携，物笑我频喟。\n焉知酒行多，但觉饮之既。\n烟峦屏障环，秀润仍蔽芾。\n更对西日红，轮囷缠海气。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25292,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"中平峰下岩可坐百客绝顶尤奇","author":"韩淲","text":"临水既凝伫，望崖试徘徊。\n榜舟一以渡，露晞岚影开。\n矫首与人居，直上无飞埃。\n峭壁过鸟道，老树相萦回。\n下访隐者庐，败堵留岩隈。\n乱草蔽嵌空，停泉照崔嵬。\n因知胜绝地，使我心悠哉。\n誓当如庞老，举家为此来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25293,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"斋居湖寺晚对南屏疏钟茂林雾气蓊然","author":"韩淲","text":"南山起寒雾，雨气蓊林木。\n但觉白漫漫，不见山下屋。\n须臾逼昏黑，疏钟度幽谷。\n寺冷西湖秋，斋房媚幽独。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25294,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"步涧壑上山隐","author":"韩淲","text":"秋山响松竹，漠漠起云阴。\n褰裳过石濑，望崖荒草深。\n谁家窗户开，少寄閒澹心。\n茗醑无不可，所畏尘雾侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25295,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"道场山山上有伏虎师宴坐岩寺中方池清深可爱","author":"韩淲","text":"翠麓转危径，清涟媚方池。\n钟鱼鸣宝坊，窣堵高不危。\n凭轩眼力尽，晴色烟凄迷。\n秋原禾黍登，佳处端在兹。\n斋馀作茗事，昼寂香篆迟。\n当年伏虎师，此地尝岩栖。\n高风动寥邈，胜迹穷险巇。\n回桡日已暮，怅望空自知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25296,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"茶山 其一","author":"韩淲","text":"人日游茶山，点检山下泉。\n载惟两贤祠，缅邈桑苧仙。\n岂无高洁怀，何有香火缘。\n雨晴动春事，草树含芳妍。\n独来宴坐久，湛然还惘然。\n扶舆度归路，寻友了閒篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25297,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"茶山 其二","author":"韩淲","text":"南风满脩竹，两贤凛如生。\n残僧具汤饼，茗椀寒泉清。\n归来涉城市，货殖何纵横。\n溪明漾长桥，履此复畅情。\n喧寂等一境，人世不足惊。\n北窗卧微凉，神思才清平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25298,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"同尹一游茶山齐贤继来","author":"韩淲","text":"蒸雨隘闾巷，茶山午风清。\n同吟方斋人，禅老相送迎。\n隔城带湖光，更约畅叙情。\n轻云转雷晚，静定天宇明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25299,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"东南一峰松雪明朗舍前甚可眺","author":"韩淲","text":"夜严风色冽，开门恍奇绝。\n谁将连日雨，幻此琼玉屑。\n林深竹初折，涧浅冰复结。\n望久忽烟销，山明见松雪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25300,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"四月十一日灵岩","author":"韩淲","text":"陟径得遐瞩，濯泉惬幽寻。\n禅窗坐来久，聊以娱客心。\n平田绿未整，湖色收晚阴。\n回桡缱绻馀，翔禽亦遗音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25301,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"午日赵钤辖同坐溪旁望灵山云气次韵","author":"韩淲","text":"尘俗自尘俗，幽奇自幽奇。\n竞渡殊污人，正尔无所之。\n城隅白云堆，涌出灵山诗。\n不可磨灭者，天欲铸伟辞。\n是大有佳趣，岂问庾元规。\n举扇勿障风，吾与子同归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25302,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪观 其一","author":"韩淲","text":"绝壑过兰若，炷熏拥寒炉。\n稍收神观明，时翻经与书。\n忘言忽自笑，得兴将谁拘。\n雪云起冰霜，是事俱澹如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25303,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪观 其二","author":"韩淲","text":"暮鼓朝钟外，鼻端消息真。\n灵山高溪南，而有彼上人。\n祝发岂灭性，趺坐宜忘身。\n咄哉露地牛，染净俱一尘。\n当年少林立，话头犹许新。\n北风吹雨花，缤纷皓如银。\n我来试标榜，此境何了因。\n无相亦无證，颦伸气方匀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25304,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋日郊行题崇福寺大井","author":"韩淲","text":"秋暑未退舍，独游亭午时。\n篮舆汗翻浆，陡觉回凉飔。\n青春十载前，此地尝娱嬉。\n只今发种种，蹉跎尚何之。\n悬崖多紫花，绕夜垂青枝。\n残蝉犹尔噪，新雁乃许迟。\n允矣原宪贫，异哉宋玉悲。\n酌泉揖老僧，清坐生佳思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25305,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"灵井","author":"韩淲","text":"灵井复何许，薰风度前林。\n一筇为萧散，涉流殊匪深。\n山空人迹少，无言见鸣禽。\n嵌岩适所会，潺然送清音。\n宜我濯尘土，陶写此胸襟。\n富贵本天命，得闲且幽寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25306,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"天竺灵隐观鸿渐寺记白香山泉碑","author":"韩淲","text":"灵隐天竺山，清流漱奇石。\n草木郁青葱，岩洞耀丹碧。\n有时闲联骑，尽日为散策。\n萧条怀古心，髣髴问遗迹。\n胜士多去来，流年几今昔。\n寺记喜逢陆，泉碑尚馀白。\n因知幽绝处，得之乃无斁。\n所以千载后，山名转辉赫。\n二子有逸韵，烟霞本其癖。\n想当落笔时，无地著清适。\n嗟我复何人，长歌想英魄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25307,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"参寥泉","author":"韩淲","text":"湖光佛寺古，山色泉水清。\n苏仙则已远，名字空含情。\n西风动林松，琴瑟有馀声。\n我来揖而酌，一饮百虑轻。\n朗吟两石碣，脊记眼为明。\n当年彼比邱，亦足得此生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25308,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"六一泉","author":"韩淲","text":"不见六一翁，但见六一泉。\n得泉以思翁，昔僧何其贤。\n旨哉山中乐，合与苍崖镌。\n后来坡仙铭，空以文字传。\n山林已禁苑，复与道院连。\n兰若纵莫存，此水尤泠然。\n岁月诚易与，陵谷终变迁。\n薰风拂湖水，晚日明湖烟。\n回头叫林逋，醉倒孤山前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25309,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"松竹堂次萧宰相韵","author":"韩淲","text":"鸣琴意自永，小筑松竹林。\n公馀一委蛇，巡檐见遥岑。\n冰雪凛节操，昼寂绿阴阴。\n何事智与名，萧散徵在今。\n当年山水间，读书情致深。\n仪凤览德辉，终古存知音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25310,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"栖闲堂","author":"韩淲","text":"能栖不能闲，其心未可知。\n能闲不能栖，其迹无已时。\n栖闲一以名，二者兼得之。\n昔春升其堂，尊酒饮于斯。\n昆山日夕佳，陂池清渺瀰。\n手植花柳间，田园粗充饥。\n洁哉两龚家，异代犹许奇。\n夫岂忘治功，而故与世违。\n汉朝有蒲轮，用舍端不欺。\n三江五湖口，君子谨其仪。\n何以写我歌，遥遥记所思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25311,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄题寿乐亭","author":"韩淲","text":"兰江生縠波，金华郁嵯峨。\n是中鹤发亲，赢得岁月多。\n时时著莱衣，儿嬉为婆娑。\n抚掌问妻子，我意今如何。\n祥风动檐花，美日行庭柯。\n更觉山水外，一曲欸乃歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25312,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过新安月夜步浮丘亭分韵赋诗得弄字","author":"韩淲","text":"平生风月怀，醉语或惊众。\n休倾袁绍杯，且卧毕卓瓮。\n使君良不凡，客子恍如梦。\n对影将奈何，晓角梅花弄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25313,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"同谭守登跨鹤台","author":"韩淲","text":"昔守王道甫，作此跨鹤台。\n金行露气高，尝同斸蒿莱。\n九日长沙归，晦翁命予杯。\n至今清梦长，寂寂令心哀。\n君侯我辈人，能赋有馀才。\n复兹菊花秋，登临为徘徊。\n子美高李句，万里风云来。\n世道古犹今，兴也何悠哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25314,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"浙江亭","author":"韩淲","text":"海风吹潮声，过我栏槛外。\n不知地势险，但觉天宇大。\n何时一壶酒，挂席上严濑。\n班班云寿阴，越山远如带。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25315,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"访南岩一滴泉","author":"韩淲","text":"僧逃寺已摧，唯馀旧堂殿。\n颠倒但土木，彷佛昔所见。\n山寒少阳燄，崖冷尽冰线。\n曾无五六年，骤觉荒凉变。\n遗基尚可登，一滴泉自溅。\n忆昨淳熙秋，诸老所闲燕。\n晦庵持节归，行李自畿甸。\n来访吾翁庐，翁出成饮饯。\n因约徐衡仲，西风过游衍。\n辛师倏然至，载酒具殽膳。\n四人语笑处，识者知叹羡。\n摩挲题字在，苔藓忽侵遍。\n壬寅到庚申，风景过如箭。\n惊心半存没，历览步徐转。\n回思劝耕地，尝著郡侯宴。\n今亦不能来，草木漫葱茜。\n人间之废坏，物力费营缮。\n不如姑付之，猿鸟自啼啭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25316,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寻梅至梅岭因游红羊石青枫峡","author":"韩淲","text":"冲寒步晴光，霜重积如雪。\n寻梅渡长溪，荦确路曲折。\n回风送滩声，静听鸣复咽。\n当知我辈游，名与山不灭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25317,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题姜尧章白石洞","author":"韩淲","text":"诗眼玩尘世，漫作威凤鸣。\n经行苕溪水，乃见白石清。\n拂衣鉴须眉，唤起仙骨惊。\n胡为随人间，叹息百虑萦。\n洞中应笑我，何不高举轻。\n明时乐未正，尚欲追英茎。\n它年淳气合，肯有爵服情。\n痴人莫说梦，烈士徒殉名。\n转庵偶饶舌，已足压旦评。\n古来旷达者，谈笑得此生。\n临流赋招隐，一奏朱弦声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25318,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄雪观","author":"韩淲","text":"秋暑睡不美，但想雪观居。\n焚香贝叶动，洗钵伊蒲馀。\n应身了诸幻，起性包太虚。\n蓬蒿一水隔，吾岂爱吾庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25319,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄题熊氏得要亭","author":"韩淲","text":"未踏得要亭，先写得要诗。\n识赏无远近，渺然西江涯。\n薰风入山水，佳趣罔不宜。\n想见昏旦候，云鸟日参差。\n主人应飘洒，何时同酒卮。\n三叹玉局仙，为我先及兹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25320,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夜过潘楼","author":"韩淲","text":"雨多晴气新，星彩动凉夜。\n因人闲出门，寻诗税吾驾。\n一杯小楼风，图画寄清暇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25321,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"聚远台","author":"韩淲","text":"遥遥聚远台，是岂俗所要。\n只宜我行适，信得山水妙。\n地高出林表，眇邈有殊调。\n主人运心匠，择胜出素料。\n陂陀阐微径，俯视溪可照。\n匪云赋新诗，聊尔索言笑。\n三月青春深，风林杜鹃叫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25322,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"亭皋","author":"韩淲","text":"亭皋新雨沐，物物秋气深。\n著蕊木芙蓉，桂树尤萧森。\n岂伊酒可尝，而我诗未吟。\n朅来六七辈，领会宜素衿。\n尘眯共一扫，风乎出云岑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25323,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"会心堂","author":"韩淲","text":"胸中有天游，寓外皆所嬉。\n胜士固可逢，俗物亦可偕。\n杯酒得流行，放意而伸眉。\n兹辰我阳春，溪水多清姿。\n岸柳已青青，山花更晖晖。\n当筵主与宾，谈妙尤克谐。\n雷声忽送雨，云风动情思。\n由来理性真，肯计志愿违。\n松柏独也正，造物付之谁。\n欢笑酬座人，长言其勿噫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25324,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题三茅堂读放翁碑易道士设茗","author":"韩淲","text":"宝山最佳处，突兀三茅堂。\n幽襟玩岩穴，散脚登崇冈。\n梅亭虽未花，自觉草树香。\n午阴布修干，禽鸟时来翔。\n下视江海波，风烟渺茫茫。\n贞石披妙词，摩挲有馀光。\n吾身已尘土，乃得閒相羊。\n羽人复能吟，煎茗邀山房。\n意胜神顿适，俗远虑兼忘。\n乃知轩裳絷，自苦升斗藏。\n饥饿非难忍，岁月空帝乡。\n挥手下山去，馀情满秋阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25325,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]