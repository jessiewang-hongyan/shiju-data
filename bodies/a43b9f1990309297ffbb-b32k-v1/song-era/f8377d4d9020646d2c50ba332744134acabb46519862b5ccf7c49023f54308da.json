[{"title":"诗一首","author":"韩退","text":"山人跨雪精，上便不论程。\n嗅地打不动，笑天休始行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23471,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜归","author":"韩兼山","text":"西风淅淅吹荷衣，家在芦花深夜归。\n明月满江人不见，白鸥双立钓鱼矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23472,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九月梨花","author":"韩准","text":"粉腻迷春月满枝，误随秋日弄芳菲。\n料应潜作春宵梦，刚被西风不放归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23473,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浣溪沙","author":"韩准","text":"潇洒梧桐几度秋。\n凤凰飞去旧山幽。\n风景不殊人物换，恨悠悠。\n衰草远从烟际合，夕阳空趁水西流。\n恰好凭楼便回首，怕生愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23474,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"崇仁县后白莲花","author":"韩晓","text":"东皇发生无贤愚，祝融长养无枯偏。\n一般薰风同芊芊，何独芙蕖多靓妍。\n小荷出水浮青烟，沈郎抛下买春钱。\n相看高柄绿又圆，谁家绀幰驰长川。\n美人酡颜立幰边，疑是水府集诸仙。\n严妆一一皆青钿，凌波罗袜行蹁跹。\n望中娟丽未足怜，别有一种尤天然。\n珍珠帘捲水晶軿，不在铅华施紫绵。\n冰肌玉骨妙无前，恍若广寒坠婵娟。\n层台细蕊黄最鲜，俨然玉女侍尧天。\n扬州盘盂休独传，拱手宜推先著鞭。\n虽云红紫难差肩，未必时人眼所便。\n一杯劝花且盘旋，慰我天涯尘土缘。\n回首水乡兴益坚，鉴湖十里花相连。\n无端名利苦萦牵，簿书丛里将三年。\n何当归去守一廛，月明重上采莲船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23475,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"栽兰","author":"韩爱山","text":"不能随俗办生涯，刬草栽兰当理家。\n不见西湖林处士，一生受用只梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23476,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送程给事知越州","author":"韩铎","text":"青琐身荣故国遥，除书催下紫宸朝。\n金籯旧学辞仙殿，玉帐新兵拥使桡。\n阁上云山围画壁，军中鼓角战江潮。\n珠玑满箧群贤什，瓦砾谁收亦谩飘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23477,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"白日偶无客青山长对门 其二","author":"韩淲","text":"枕流饭脱粟，长夏以终日。\n曳屣行歌商，风轩时弄笔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23478,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"白日偶无客青山长对门 其三","author":"韩淲","text":"身心既已闲，吟风兴亦偶。\n山东打茶声，睡思忽抖擞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23479,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"白龙洞","author":"韩淲","text":"西湖浪宕我能知，却赋龙岩老古锥。\n便做诗家元不恶，华亭举棹是因谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23480,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"八月","author":"韩淲","text":"山林风雨便清凉，待把邻家社瓮尝。\n到手自应无美恶，回头谁解别斟量。\n深居但觉秋声起，熟睡焉知夜漏长。\n未老得闲今又老，床头书册渐相忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23481,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"八月六日伯皋见过","author":"韩淲","text":"华发秋来忽满梳，故人相见意何如。\n强亲杯酒欢无几，尚觉篇章兴有馀。\n世事纷然随野马，吾生老矣信蘧庐。\n林间已下萧萧叶，雨过空山木影疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23482,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"八月四日仁甫行","author":"韩淲","text":"投老不堪别，莫云师友情。\n当时建阳聚，何日上饶行。\n旧事消除尽，新愁积渐生。\n酒杯无浪与，醉醒是秋声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23483,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"风雨中诵潘邠老诗","author":"韩淲","text":"满城风雨近重阳，独上吴山看大江。\n老眼昏花忘远近，壮心轩豁任行藏。\n从来野色供吟兴，是处秋光合断肠。\n今古骚人乃如许，暮潮声捲入苍茫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23484,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨多极凉冷","author":"韩淲","text":"焉知三伏雨，已作九秋风。\n木叶凉应脱，禾苗润必丰。\n地偏山吐月，桥断水浮空。\n鸡犬邻家外，鱼虾小市中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23485,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"爱客","author":"韩淲","text":"婆饼焦何急，飞鸣小竹间。\n雨多溪涨水，云厚日藏山。\n景物固无恙，人情终等閒。\n老来惟爱客，茶果或相关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23486,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"魏知府挽诗 其一","author":"韩淲","text":"先正声猷在，诸贤竞挽推。\n蚤年知振厉，中道惜裴回。\n论建何老识，文词岂小才。\n近来耆旧尽，徒与士生哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23487,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"魏知府挽诗 其二","author":"韩淲","text":"历历亲言话，长怀逸老堂。\n典刑杯酒外，气象简编旁。\n有子真源委，何人更发扬。\n宣风觉庵地，霜露郁乎苍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23488,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"八月二十五日过南豅 其一","author":"韩淲","text":"凉雨忽不止，秋阴无奈何。\n山根泻新涨，小立玩流波。\n会逢其适尔，紫芝有奇歌。\n惜此未深密，时见人游过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23489,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"八月二十五日过南豅 其三","author":"韩淲","text":"抚枕知夜永，淅淅过山雨。\n净听秋气还，清吟可无侣。\n年来幽兴熟，心口自相语。\n我其内热欤，何其未能处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23490,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"八月二十五日过南豅 其二","author":"韩淲","text":"岩桂苦未花，寻香上扁舟。\n溯洄得蹊间，微步理旧游。\n鲜鲜见新枝，幽芳浩难收。\n回首城市尘，所憩因少留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23491,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"八月初七日终夜大雷震雨如倾注风败吾藩篱拔吾庭树","author":"韩淲","text":"晴明天气佳，草木浮光煇。\n珍禽各翔语，群花竞芳菲。\n人情春和时，怡游类忘归。\n常阳一以亢，旱甚翻歔欷。\n赤地至千里，焉有不年饥。\n家家望云霓，想像阴雨霏。\n狂飙震雷吼，连夕恐非机。\n溪涨桥已解，拍岸欲平矶。\n所幸蛙黾尔，跳噪皆轻肥。\n居民其奈何，泥淖生理微。\n意欲问彼苍，何日生清晖。\n由来此阴阳，岁事中和希。\n今年积秋热，焦熬在郊圻。\n既雨复苦风，拔树败墙围。\n后土无乾处，眇予将畴依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23492,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"白日偶无客青山长对门 其四","author":"韩淲","text":"人生等戏剧，衮衮徒区区。\n老身其回头，今有古非无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23493,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"白日偶无客青山长对门 其七","author":"韩淲","text":"不见屋外溪，但见屋上山。\n云月复风雨，展转朝暮间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23494,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"白日偶无客青山长对门 其一","author":"韩淲","text":"云低树头青，风急叶背白。\n一坞无来人，鸟语斗格磔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23495,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"白日偶无客青山长对门 其五","author":"韩淲","text":"朝市无遗音，丘园有绝迹。\n蓬茅晏不开，才开待迎客。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23496,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"白日偶无客青山长对门 其六","author":"韩淲","text":"涧浅山四合，泠泠浸青青。\n略彴度前林，更有泉上亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23497,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"庵邻王家两送酒来","author":"韩淲","text":"渴饮对空觞，俛仰自长喟。\n赖有田中邻，时时遣酒至。\n欢言斟酌之，感彼勤重意。\n漂母哀王孙，从古多此类。\n泽畔且行吟，春风尚堪醉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23498,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"一丛花 次韵斯远","author":"韩淲","text":"翻空雪浪送飞花。\n春晓媚霜华。\n风回点点迷人处，峭寒轻、诗思殊佳。\n双燕未来，断鸿何在，微雨又天涯。\n绮窗明暗是谁家。\n雕槛馥兰芽。\n画檐帘幕黄昏后，试倾杯、笑语喧哗。\n聚散人生，吾侪老矣，醉墨任横斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23499,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"一剪梅 闻箜篌","author":"韩淲","text":"缥渺神仙云雾窗。\n说与苏州，未断人肠。\n带湖烟月堕苍茫。\n唤醒嫦娥，春笋纤长。\n马上琵琶半额妆。\n拨尽相思，十二巫阳。\n疏□清梦入潇湘。\n佩玉鸣鸾，吹下天香。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23500,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"一剪梅 送冯德英","author":"韩淲","text":"说著相思梦亦愁。\n芳草斜阳，春满秦楼。\n楼前新绿水西流。\n一曲阳关，分付眉头。\n多少风流事已休。\n纷薄香浓，怕见绸缪。\n淡云笼月小庭幽。\n明日山长，清恨悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23501,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"一剪梅 腊前梅","author":"韩淲","text":"一朵梅花百和香。\n浅色春风，别样宫妆。\n西湖衣钵更难忘。\n雪意江天，浑断人肠。\n清夜横斜竹影窗。\n赢得相思，魂梦悠扬。\n玉溪山外水云乡。\n茅舍疏篱，不换金章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23502,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"一剪梅 醉中","author":"韩淲","text":"醉倒城中不过溪。\n溪外无尘，惟掩柴扉。\n水浮桥漾翠烟霏。\n一片闲情，能几人知。\n留饮君家絮帽敧。\n爆竹声中，万事如斯。\n梅催春动已熹微。\n尔既能来，我亦何疑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23503,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"卜算子 中秋前一日和昌甫所寄","author":"韩淲","text":"一雨已秋深，月色寒而静。\n夜半披衣草树间，玉露团清影。\n长笛倚楼声，听彻还重省。\n手启柴门倦复关，云卧衣裳冷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23504,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"卜算子 初十日海棠宋十一哥家饮","author":"韩淲","text":"烟雨海棠花，春夜沈沈酌。\n寒食清明数日间，人也须行乐。\n不怕笛声长，只怕风儿恶。\n烛影红酣宝篆香，楼上黄昏角。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23505,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"卜算子 生朝次坐客韵呈四叔","author":"韩淲","text":"花底醉东风，好景宜同寿。\n海角天涯今几春，邂逅新丰酒。\n内集记高阳，南渡闲回首。\n但愿长年饱饭休，一笑风尘表。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23506,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"小重山 和吴子似","author":"韩淲","text":"云影收晴雨外明。\n碧溪春滟滟，落花平。\n莺声催我过桥行。\n人何在，诗酒淡心情。\n闲里兴还生。\n锦鳞题尺素，有谁能。\n草边芳径柳边城。\n归来也，清梦绕山屏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23507,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"小重山 柳色新","author":"韩淲","text":"点染烟浓柳色新。\n小桃红映水，日初匀。\n露收芳径草铺茵。\n凝情久，风淡起轻尘。\n梁燕已争春。\n折花闲伴酒，试濡唇。\n流莺何处语声频。\n阑干曲，蜂蝶更随人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23508,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"太常引 腊前梅","author":"韩淲","text":"小春时候腊前梅。\n还知道、为谁开。\n应绕百千回。\n夜色转、参横斗魁。\n十分孤静，替伊愁绝，片月共徘徊。\n一阵暗香来。\n便觉得、诗情有涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23509,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"太常引 呈昌甫","author":"韩淲","text":"随风和雨带烟开。\n更清冷、照崔巍。\n片片亦佳哉。\n细看得、花如剪裁。\n茅檐出没，水浮桥外，人自两峰来。\n吟到涧泉梅。\n问何似、山阴道回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23510,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"少年游 玉腊梅枝","author":"韩淲","text":"闲寻杯酒，清翻曲语，相与送残冬。\n天地推移，古今兴替，斯道岂雷同。\n明窗玉蜡梅枝好，人情淡、物华浓。\n个样风光，别般滋味，无梦听飞鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23511,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"忆秦娥 茉莉","author":"韩淲","text":"香滴滴。\n肌肤冰雪娇无力。\n娇无力。\n秋风凉冷，有谁消得。\n洗妆不奈云鬟侧。\n璧堂珠院空相忆。\n空想忆。\n轻颦浅笑，小梅标格。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23512,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"月宫春 和吴尉","author":"韩淲","text":"柳娇花妒燕莺喧。\n断肠空眼穿。\n一春风雨夜厌厌。\n不闻钟鼓传。\n香冷曲屏罗帐掩，园林谁与上秋千。\n忆得年时凤枕，日高犹醉眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23513,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"水龙吟 七月二十六日信守生朝王道夫","author":"韩淲","text":"从来江左夷吾，大名迥诸出公右。\n金堂玉室，瑶林琼树，龙麟蟠走。\n志在神皋，气雄云梦，十吞八九。\n问三槐盛事，当年初度，人应羡、青毡旧。\n说与文章太守。\n庆千秋、好为亲寿。\n冰桃雪藕，霞裾月佩，莺鸾歌奏。\n雨熟西畴，星躔南极，宝香凝昼。\n趁新凉，便约乘云绕日，饮天浆酒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23514,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"水调歌头 晁子应三十八丈见过，因□张德广对木犀水饮，次德广韵","author":"韩淲","text":"明月到花影，把酒对香红。\n此情飘洒，但觉清景满帘栊。\n人被好花相恼，花亦知人幽韵，佳处本同风。\n挥手谢尘网，举袂步蟾宫。\n秋已半，幽涧侧，乱山中。\n故人过我，终夕乘兴可千钟。\n赖有曲江才子，坐上平章花月，不管老英雄。\n心事将何寄，醉语又匆匆。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23515,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"水调歌头 和石倅寿汤守","author":"韩淲","text":"玉水灵山地，燕寝亦书功。\n邦人耆老，诞弥佳节以词通。\n尔岂知吾恺悌，我乃因君谈笑，祝寿酒杯同。\n箫鼓少人会，歌舞为谁容。\n观坐客，惊野老，笔如风。\n个般酬唱，诏回应上玉华东。\n多少家传经济，留与孙谋持守，出处信何穷。\n唤起千年调，分付一车公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23516,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"水调歌头 次韵载叔","author":"韩淲","text":"一枕暑风外，事事且随缘。\n随缘何处琴剑，闲泊此层巅。\n日绕九天楼殿，烟抹四山林薄，尘土市声前。\n老眼醉还醒，犹得到诗边。\n桥南院，双桂隐，有名言。\n江湖人物，好在收拾付书帘。\n回首吾庐无恙，寄卧僧窗何事，鸿鹄本高骞。\n水调赋明月，谁道更超然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23517,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"水调歌头 坐间有伤仲至，且怀昌甫，因呈张宰","author":"韩淲","text":"新月已如许，我问带湖梅。\n人间题句，赢得浮潋酒盈杯。\n落拓豪英满坐，烂漫风骚连纸，天外凤凰来。\n只怕轻孤负，莫待巧安排。\n空翠滴，寒爽矣，晚佳哉。\n为君绝倒，折尽千树玉蓓堆。\n渺渺章泉好在，寂寂卢泉仙去，今古付尊罍。\n拍手见花木，放眼记莓苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23518,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"水调歌头 次韵倅车寿守","author":"韩淲","text":"一曲笙歌外，四座笑谈清。\n使君秋霁领客，别乘更宗英。\n想像亲闱称寿，写就通家情分，相与庆恩荣。\n欢动桂花发，香雾扑帘旌。\n功名事，台阁路，好同登。\n只今报政归诏，舆论正蜚声。\n以我文章学术，与国和平安靖，冠剑入明庭。\n应顾棠阴下，野老鬓星星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23519,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"水调歌头 次宋倅韵","author":"韩淲","text":"嘉节已吹帽，谁复见南山。\n南山佳处，台上云绕一溪环。\n犹记使君同醉，化鹤千年何在，今古自应悭。\n胜事漫陈迹，风物只高寒。\n都莫问，归酒畔，集毫端。\n等闲吟笑而已，赖有孔融尊。\n伟矣广平心致，赢得相遭淡泊，感旧唱酬闲。\n且看小斋菊，抵掌共凭阑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23520,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"水调歌头 清明严濑","author":"韩淲","text":"今古钓台下，行客系扁舟。\n扁舟何以，云山千叠亦东游。\n我欲停桡一醉，与写平生幽愤，横管更清讴。\n小上客星阁，短鬓独搔头。\n风乍起，烟未敛，雨初收。\n一年花事，数声鶗鴂欲春休。\n吊古怀贤情味，只有浮名如故，谁复识羊裘。\n赖得玄英隐，相望此溪流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23521,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"风入松 远山横","author":"韩淲","text":"小楼春映远山横。\n绿遍高城。\n望中一片斜阳静，更萋萋、芳草还生。\n疏雨冷烟寒食，落花飞絮清明。\n数声弦管忍重听。\n犹带微酲。\n问春何事春将老，春不语、春恨难平。\n莫把风流时节，都归闲淡心情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23522,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"冉冉云 弄花雨","author":"韩淲","text":"倚遍阑干弄花雨。\n卷珠帘、草迷芳树。\n山崦里、几许云烟来去。\n画不就、人家院宇。\n社寒梁燕呢喃舞。\n小桃红、海棠初吐。\n谁信道、午醉醒时情绪。\n闲整春衫自语。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23523,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"生查子 题梅溪橘阁词","author":"韩淲","text":"霜叶柳塘风，烟蕊梅溪渡。\n茅店问村醪，未许空归去。\n倚杖小裴回，写我吟边句。\n醉眼复何之，落日孤鸿处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23524,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"生查子 晴色入青山","author":"韩淲","text":"晴色入青山，更见飞花晚。\n不是不登临，自是心情懒。\n试襞小红笺，与写天涯怨。\n杜宇一声春，楼下沧波远。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23525,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"生查子 梅和柳","author":"韩淲","text":"山意入春晴，都是梅和柳。\n白白与青青，日映风前酒。\n归去也如何，路上休回首。\n各自做新年，柳袅梅枝瘦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23526,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"好事近 其三 又","author":"韩淲","text":"三叠古藤阴，自笑无能为役。\n千载和陶新曲，了非仙非释。\n影徒随我月徘徊，风叶露华湿。\n瓮下是成真逸，醉令人思毕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23527,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"好事近 红梅","author":"韩淲","text":"春色入芳梢，点缀万枝红玉。\n莫道怕愁贪睡，倚新妆如束。\n纷纷桃李太妖娆，相对夜阑烛。\n记取疏花横处，有暗香飘馥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23528,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"好事近 其二 又","author":"韩淲","text":"黄发享颐期，兄弟此时宜告。\n见说对床夜雨，世间尘都扫。\n青毡堂外瑞峰高，云气拂晴昊。\n老大中原人物，在江湖乡保。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23529,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"好事近 其一 次韵昌甫","author":"韩淲","text":"梅雨快晴风，苔竹定翻新箨。\n相望得寻幽调，把陈言都略。\n大江东去更飞云，心事共回薄。\n彷佛散庵佳处，一声声猿鹤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23530,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"好事近 翠圆枝","author":"韩淲","text":"一涧水南山，腊尽春生梅雪。\n行过小桥深处，带疏钟横月。\n征衫闲著指东吴，休怕与人别。\n吟到翠圆枝上，是归来时节。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23531,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"好事近 次韵昌甫","author":"韩淲","text":"北客过江来，赢得家家都老。\n屈指中兴人物，到如今谁好。\n散庵常是爱山林，健笔胜挥扫。\n我则临风三叹，信儿曹惊倒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23532,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]