[{"title":"谢张漕荐剡","author":"吕声之","text":"谁人洗甲挽天河，玉宇无尘海不波。\n汉使褰帷将命出，淮民挟纩被恩多。\n流离岂但身安集，凋瘵亲曾手拊摩。\n惠利才施催召亟，其如席未及温何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36615,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题龙翔观","author":"吕声之","text":"曾到龙翔不记年，两峰巍压水中天。\n潮生潮落青芜外，人去人来白鹭边。\n四接远游僧万笠，重新旧观屋千椽。\n东南送目秋无际，隔岸人家问钓船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36616,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题陈岩庵寄诸兄弟","author":"吕声之","text":"地接丹丘姥岭赊，山盘曲折状如蛇。\n每因过此瞻双陇，何必从旁置万家。\n孝弟本根时润泽，诗书种子日萌芽。\n到来岂但春秋祀，酌水何妨一献花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36617,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"开禧丁卯重过龙门有怀方丈老子","author":"吕声之","text":"翠屋交空结夏阴，征鞍亭午喜登临。\n披开草棘千重路，洗出冰壶一片心。\n禅老还寻江浙去，诗家谁作楚梁吟。\n须知珠玉元无踵，不惜西风惠我音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36618,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西寺留题","author":"吕声之","text":"白石孤云自在閒，红尘一事不相关。\n寺遮翠霭青萝外，人到落花流水间。\n欲效锦囊收胜概，惭无玉带镇名山。\n白莲喜结当年社，未厌朝来暮便还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36619,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"咏桂花","author":"吕声之","text":"独占三秋压众芳，何誇橘绿与橙黄。\n自从分下月中种，果若飘来天际香。\n清影不嫌秋露白，新丛偏带晚烟苍。\n高枝已折郤生手，万斛奇芬贮锦囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36620,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游石城山","author":"吕声之","text":"祇因寻胜到林泉，四抱回峰万景连。\n僧过不知山隐寺，客来方见洞开天。\n浮图照水光相映，古木依崖影倒悬。\n风露了非人世界，濯缨秋后玉壶天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36621,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题南岩寺","author":"吕声之","text":"谁把长竿钓巨鱼，至今蹲石倚空虚。\n蜂房爱向山崖结，鸟迹疑从海岛居。\n入座翠岚生昼寂，夹川红树照春馀。\n任公此去三千载，为看芳碑一嘅吁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36622,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"见学院诸生作诗因和","author":"吕希纯","text":"骐骥方腾踏，蚊虻敢扑缘。\n明年小期集，请看十庐鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36623,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"民表圆同庵","author":"吕希纯","text":"翠竹庵前久不疑，雨花岩畔更忘机。\n何人得似江居士，在定时多出定稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36624,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"王氏亭池","author":"吕希纯","text":"城外溪山知几重，独怜池馆占城中。\n亭花不动波澜细，径石相连岛屿通。\n床下系舟同醉傅，尊前垂钓似仙翁。\n王家最数乌衣巷，莫废江南旧士风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36625,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉泉庵","author":"吕希纯","text":"瀑布岩东转画旗，拂云穿石上霏微。\n抱溪修竹通千个，夹道乔松过十围。\n檐外一潭泓翠碧，窗间万斛溅珠玑。\n使君不用笙歌拥，漱玉声中岸帻归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36626,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"朱氏园","author":"吕希纯","text":"十里游山兴尽回，重留车骑款郊扉。\n中桥驾石临清港，危榭开轩挹翠微。\n夹道松风吹酒面，满庭花气袭人衣。\n殷勤更谢华亭鹤，引吭高声送我归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36627,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陈尊宿庵","author":"吕希纯","text":"尊宿芳名盛，庵岩迹未颓。\n织蒲随日用，儋版唤人回。\n临济亲推出，云门手托开。\n于今两禅派，俱自睦州来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36628,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"承天思范轩","author":"吕希纯","text":"范公当日守江滨，本是西清献纳臣。\n潇洒溪山潇洒郡，太平天子太平民。\n棠郊遗爱今仍在，竹榭高吟迹已陈。\n还忆开元宋开府，相望彷佛见精神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36629,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赵清献赏春亭","author":"吕希纯","text":"遗直兼遗爱，居今见古人。\n殿中收白简，江上拥朱轮。\n栋宇才函丈，琴尊喜对宾。\n绕亭佳水在，长与物为春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36630,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"潇洒亭","author":"吕希纯","text":"郡因贤守得佳名，水态山光会此亭。\n云外僧归穿竹坞，日边鸥下集沙汀。\n浮梁倒影横雌霓，宝塔张灯叠万星。\n不独班春行田野，重缘香火叩禅扃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36631,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"千峰榭","author":"吕希纯","text":"古郡千山里，高台六月凉。\n开轩背城市，伏槛即林塘。\n白佛当平远，乌龙插昊苍。\n水风生枕簟，岚翠扑衣裳。\n欲雨高峰暗，新晴瀑布长。\n稻塍分锦绣，松岭奏笙簧。\n自昔多贤守，于今载雅章。\n承流叨继踵，主诺粗提纲。\n夙乐阿兰若，端居最上方。\n南津有禅侣，默坐正相望。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36632,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乌龙寺","author":"吕希纯","text":"秀岭奇峰接钓台，乌龙直北更崔嵬。\n万松合处虚亭敞，千佛光中梵宇开。\n林外瀑泉飞朔雪，云间宝藏转春雷。\n攀藤更入西庵路，一听支郎语劫灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36633,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元夕 其一","author":"吕希纯","text":"何处元宵好，迎銮册府西。\n箫声云外起，扇影日边低。\n秘禁威容肃，名流步武齐。\n舜瞳回左顾，真欲过金闺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36634,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"灵香阁","author":"吕希纯","text":"昔闻僧道开，清净本求佛。\n谈经悟教藏，施药蠲众疾。\n临嶂起重阁，最上构禅室。\n灵香邈可继，壮丽固已轶。\n桐庐潇洒郡，兹阁更奇崛。\n峰峦互掩映，松竹富蒙密。\n我来一伏槛，紫翠竞森出。\n尘襟与羁帻，中坐恍已失。\n清风来甚远，冲气久弥逸。\n东轩视蟠桃，仙路如彷佛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36635,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"定川门","author":"吕希纯","text":"江如丁字凑城隈，长畏蛟龙鼓浪来。\n门表奠川聊致祷，职当求瘼愧非才。\n两滩涨定沙痕白，七里山晴雾雨开。\n放出庾家楼上月，却留宾从少徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36636,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诗一首","author":"吕希纯","text":"梦寐西山结草庐，逝将临水咏游鱼。\n何人见卵求时夜，更著閒言问紫姑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36637,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"高峰庵","author":"吕希纯","text":"予尝登高峰，近瞰碧溪坞。\n老松如卧龙，夹道忽腾翥。\n危梯过百折，直下看云雨。\n善导有遗踪，十佛从口吐。\n岁久缺其三，尘埃谁复数。\n佛寿倘能续，佛像谅可补。\n绕山行道迹，会转坦无阻。\n中休有磐石，蔽日多林莽。\n安得德山流，来为此峰主。\n结茅孤顶上，端坐诃佛祖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36638,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄兄","author":"吕希纯","text":"江南江北来，昨夜同枝宿。\n平明一声起，回顾已极目。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36639,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"临江仙","author":"吕希纯","text":"□□□□□□□，□□□□□□。\n莫交闲虑到心头。\n有来忧不得，无后不须忧。\n□□□□□□□，□□□□□□。\n万般希望不如休。\n无来求不得，有后不须求。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36640,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"吕希纯","text":"何处孤城号秭归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36641,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句","author":"吕希哲","text":"老读文书兴易阑，须知养病不如闲。\n行林瓦枕虚堂上，卧看江南雨后山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36642,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"礼","author":"吕大临","text":"礼仪三百复三千，酬酢天机理必然。\n寒即加衣饥即食，孰为末后孰为先。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36643,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"经筵大雪不罢讲 其二","author":"吕大临","text":"强记师承道古先，无穷新意出尘编。\n一言有补天颜动，全胜三军贺凯旋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36644,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"经筵大雪不罢讲 其一","author":"吕大临","text":"水晶宫殿玉花零，点缀宫槐卧素屏。\n特敕下帘延墨客，不因风雪废谈经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36645,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登单州城楼","author":"吕希哲","text":"断霞孤鹜欲寒天，无复青山碍目前。\n世路崎岖饱经历，始知平地是神仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36646,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和尧夫打乖吟","author":"吕希哲","text":"先生不是闭关人，高趣逍遥混世尘。\n得志须为天下雨，放怀聊占洛阳春。\n家无甔石宾常满，论极锱铢意始新。\n任使终身卧安乐，一毫何费养天真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36647,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其四","author":"吕希哲","text":"除却借书沽酒外，更无一事扰公私。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36648,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其三","author":"吕希哲","text":"独抱遗经唐处士，差强人意汉将军。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36649,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"吕希哲","text":"将谓清风全扫地，世间今复有卢鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36650,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"吕希哲","text":"他日稍成毛义志，再求师友究渊源。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36651,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"斋宿南山堂","author":"吕良叔","text":"寒窗一穗篆烟斜，纸帐孤眠对月华。\n信是道人风味别，枕边祇欠着梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36652,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄九日山僧","author":"吕言","text":"目极闽南道，云山隔几层。\n深秋城外寺，白日定中僧。\n野蔓穿松甲，幽泉漱石棱。\n遥思茶话夕，敲碎玉池冰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36653,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戏马台","author":"吕定","text":"据鞍挥指八千兵，昔日中原几战争。\n追鹿已无秦社稷，逝骓方叹楚歌声。\n英雄事往人何在，寂寞台空草自生。\n回首云山青矗矗，黄流依旧绕彭城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36654,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过峡山寺","author":"吕定","text":"峡江江上峡山寺，落日峰峦翠作堆。\n云拥半空楼殿出，天然一幅画图开。\n仙人采药和光洞，释子翻经化乐台。\n顾我红尘车马客，题诗无暇扫苍苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36655,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜宿甓社湖","author":"吕定","text":"湖光如镜迥无山，耿耿银河路可攀。\n万象不移天地外，一尘能到水云间。\n月明孤屿森楼阁，夜静飞仙过佩环。\n借问孟城何处是，微微灯火绿杨湾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36656,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"奉天门朝贺","author":"吕定","text":"晓日初临万岁山，宝幢华盖列朝班。\n九重天上来仙乐，五色云中识圣颜。\n深殿捲帘香雾袅，近臣传制佩声还。\n嵩呼齐祝恩如海，散作阳和满世间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36657,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵旅夜","author":"吕定","text":"一雨皇都万象明，东风娇啭上林莺。\n火烟亭馆春多少，钟鼓楼台夜几更。\n枕上故园蝴蝶梦，枝头斜月杜鹃声。\n银笺欲写长相忆，滚滚江流不尽情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36658,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"度大庾岭","author":"吕定","text":"凿破鸿濛一窍通，至今传说九龄功。\n天垂瘴雨蛮烟外，路入炎荒火树中。\n万里关河瞻北极，两行旌旆过南雄。\n鹧鸪声里端阳近，榕树青青荔子红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36659,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赴京","author":"吕定","text":"太白楼前雨乍收，画船挝鼓上皇州。\n肯因离别牵愁思，要把勋名事壮游。\n千里关河旗带月，一天星斗剑横秋。\n胸中剩有安边策，此去应当献冕旒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36660,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浴日亭和苏学士韵","author":"吕定","text":"危亭突兀倚青山，坐对扶桑碧海湾。\n紫雾欲生龙伯庙，洪涛先涌虎门关。\n光摇宇宙花生眼，影动阑干酒上颜。\n遥望蓬莱宫阙晓，一轮飞挂碧云间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36661,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"调兵","author":"吕定","text":"年少谈兵胆气豪，折冲千里岂辞劳。\n旌旗影动秋风瑟，鼓角声回夜月高。\n红锦裁鞍新试马，黄金装带旧悬刀。\n临征自信军容盛，五色团花绣战袍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36662,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"扈驾","author":"吕定","text":"八月秋高战马肥，观兵郊外振天威。\n一声凤吹迎鸾驭，五色龙文杂衮衣。\n剑戟横空金气肃，旌旗映日綵云飞。\n令严星火诸军奋，直斩单于塞上归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36663,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"望岱岳","author":"吕定","text":"岱宗东望郁嵯峨，万丈仙桥鸟外过。\n秦树千年空老大，汉碑终古不消磨。\n天坛夜静乘星斗，石磴春深长薜萝。\n记得旧游曾载酒，颓然峰顶放长歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36664,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"望峄山","author":"吕定","text":"极目东山秀色浓，紫霄千叶醉芙蓉。\n题诗尚记仙人洞，飞佩曾过玉女峰。\n树老孤桐秋露下，碑残古篆暮云封。\n何时再醉天门月，卧听清风万壑松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36665,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谒金华寺六祖法堂","author":"吕定","text":"坐阅人间几百年，双趺浑似后来禅。\n空空明镜台前地，寂寂红尘境外天。\n风动法林从虎过，云生咒钵解龙眠。\n至今月到层楼上，应共祥光午夜圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36666,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪夜","author":"吕定","text":"漠漠同云遍海涯，晓风寒逼绿窗纱。\n飞扬鳞甲三千界，妆点楼台百万家。\n何处妙歌金帐酒，谁人清对玉梅花。\n便应石鼎融冰水，乌帽笼头自煮茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36667,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游匡庐山","author":"吕定","text":"欲向匡庐观瀑布，便从鼓蠡骤楼船。\n一声长啸来丹壑，千丈飞流下碧天。\n洞里楼台无岁月，云中鸡犬有神仙。\n凭谁呼起巢松者，醉拥宫袍对酒眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36668,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游海珠寺","author":"吕定","text":"何年神物抱珠游，遗向沧浪第一洲。\n五色化成金世界，六鳌擎出宝香楼。\n光涵蛟室星辰动，影落龙宫日月浮。\n万古团团天地里，磬声敲出海门秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36669,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登广城楼","author":"吕定","text":"三尺龙泉事远游，越王台上望南州。\n一天雨过千山晓，万里风来五月秋。\n江郭楼台蛮客市，海门烟日蜑家舟。\n临戎不有安边策，应愧常何荐马周。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36670,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登东岳山","author":"吕定","text":"海内名山孰与齐，清风掖我上丹梯。\n鹏程九万扶摇近，世界三千指顾低。\n瀑挂天门惊霹雳，雨蒸日观出虹霓。\n太平会见东封盛，玉简金书焕紫泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36671,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登越王台","author":"吕定","text":"海上荒台草树平，登临不尽古人情。\n白云万里怀亲舍，红日中天望帝京。\n百粤山川秋历落，三城楼阁晚峥嵘。\n醉来徙倚栏干曲，听彻西风画角声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36672,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登翠云台","author":"吕定","text":"一柱中流亦壮哉，分明世上有蓬莱。\n帘开庐阜层层出，船汎岷山滚滚来。\n夜冷神龙蟠水府，天青仙佩下瑶台。\n閒将玉管吹明月，勾引翩翩彩凤回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36673,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"怀古","author":"吕定","text":"我昔游海上，东望三神山。\n风波几万里，苍茫云霭间。\n鱼龙自掀舞，天空日月閒。\n神仙渺无迹，徐福去不还。\n空馀蓬莱阁，千载留人寰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36674,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过小孤山","author":"吕定","text":"八月灵槎溯海门，翠云台上醉芳樽。\n峰头楼閤相高下，水底鱼龙自吐吞。\n万古青天留玉柱，五更红日涌金盆。\n宦游不尽登临兴，欲洗苍苔颂圣恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36675,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"追和苏子瞻游峡山寺韵","author":"吕定","text":"山迥宝华阁，水绕金锁湾。\n尘虑顿焉息，于兹开我颜。\n疏钟日夕动，老僧林下还。\n天风吹白云，悠悠满松关。\n归猿有馀悲，月明啸空山。\n仙人自何来，翱翔八极间。\n手把玉芙蓉，吟笑锵佩环。\n歌罢忽飞去，千峰堆翠鬟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36676,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"班师","author":"吕定","text":"紫塞回来雪正晴，王师百万拥连营。\n马嘶大地山河壮，旗捲长空日月明。\n龙虎台高千嶂耸，凤皇城近五云生。\n圣颜有喜天心顺，中外欢闻奏凯声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36677,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登彭城楼","author":"吕定","text":"项王台上白云秋，亚夫坟前草树稠。\n山色不随人事改，水声长近戍城流。\n空馀夜月龙神庙，无复春风燕子楼。\n楚汉兴亡俱土壤，不须怀古重夷犹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36678,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题文州安静堂","author":"吕宜之","text":"峡束秋空一线青，万山深处长官厅。\n此堂虚旷无馀物，面面为开碧玉屏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36679,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅林分韵得诗字","author":"吕宜之","text":"寒梅如高人，冰雪凛风期。\n霜威凌万木，孤芳缀疏枝。\n古来岁寒心，肯与时节移。\n家家浣溪南，横斜映笆篱。\n老树更崛奇，矫矫蛟龙姿。\n中有调鼎味，几年江之湄。\n征衫十年寒，霜蹄快追随。\n先生羊叔子，到处英名垂。\n对花有妙语，豪气无百卮。\n兴来属湛辈，同出舂容诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36680,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"吕昌明","text":"岂惟藏两蜀，亦自限三巴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36681,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"甘园","author":"吕炎","text":"曾入当年富贵家，东风几度换年华。\n满园桃李不知主，独自开花自落花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36682,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]