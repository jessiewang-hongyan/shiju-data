[{"title":"逍遥咏 其十四","author":"赵炅","text":"玄门至道故无涯，自是人心所见邪。\n智识未能通大药，岂将容易拟荣家。\n千年圣境何虚谬，百劫曾修不用遮。\n龙虎欲成堪鍊鼎，勿为利路乱交加。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46031,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其十八","author":"赵炅","text":"大都滋味莫因循，减节从教岁月身。\n述作比图人世解，凡情谩说内丹真。\n消停意上宽还远，宗旨犹来最好亲。\n动静机关勿劳苦，坎离卦象善调匀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46032,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其十八","author":"赵炅","text":"一身独善欲何之，争及衣冠解抚绥。\n浮世浅情无限量，愚蒙自是不相规。\n直须凭仗分明说，语取灵源问得知。\n要觅洞中闲日月，除将济事谩非为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46033,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其十三","author":"赵炅","text":"逍遥我咏杳冥中，万物齐归各异同。\n晓解精微无所著，先从含识践真空。\n希夷自变刚柔理，述作纵横道不穷。\n剖判三才堪测度，辉华积德上玄功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46034,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其十八","author":"赵炅","text":"烘烘火色水中论，至宝须教鼎内存。\n点化自然常在手，区分道理有玄门。\n莫将容易誇言说，尽入虚无是我尊。\n天动地神邪可畏，丹能飞走似云奔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46035,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其六","author":"赵炅","text":"何处堪依仗，经心便皱眉。\n世情多诡诈，业重信愚痴。\n取次招他谤，违非不自知。\n貌恭无德行，祸福在修持。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46036,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其十八","author":"赵炅","text":"寂静皆无语，其于理一般。\n若非通秘奥，故是入微端。\n善可名高尚，真乘智识宽。\n天长与地久，万物不相干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46037,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其十五","author":"赵炅","text":"随缘心不见，性各本来真。\n恶事誇唇颊，愚痴似醉人。\n忙忙何物有，急急利名亲。\n入定观浮世，苍生业感因。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46038,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其七","author":"赵炅","text":"泽泻池塘灌药畦，太清云黯步红霓。\n松花鍊鼎龙山侧，甲第群仙凤鹤栖。\n分别要从华等级，微言道泰物须齐。\n自吟自咏求师侣，入品诗流旋作题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46039,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其七","author":"赵炅","text":"清静常清静，缘来尽可行。\n道高麋鹿性，庸识岁年轻。\n日昃相依势，花开触处明。\n是非论巧拙，达外福苍生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46040,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其一","author":"赵炅","text":"道妙怀真纪异常，人间天上若存亡。\n潜机物类多中觑，纳取虚无定久长。\n碧落遨游归洞府，黄金不买自馨香。\n参同契合诸经说，精魄夺来烂紫光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46041,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其三","author":"赵炅","text":"百法还丹数，玄门各自深。\n真空光似日，解脱本由心。\n迷惑终无应，精修重古今。\n循环岂暂息，七宝聚高岑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46042,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其十四","author":"赵炅","text":"水精宫殿月华明，白玉为墙火不侵。\n八境风高骈羽驾，九重天上绛霞深。\n物情晃朗无遮隔，非是凡间比类寻。\n汗漫真游谁得到，桂花香洁影森森。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46043,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其十三","author":"赵炅","text":"逍遥密化道希夷，宗习群流我咏之。\n应是有情听譬论，莫教虚度悟参差。\n深穷动静宜消息，测隐玄元善所为。\n性识更能通幻梦，恬然存相似生知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46044,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其十五","author":"赵炅","text":"阳与阴和合，须从一字求。\n分明皆是象，作相不能投。\n举措先真实，精粗各自柔。\n恒持通觉悟，万派水东流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46045,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其十三","author":"赵炅","text":"乾坤常运转，兀兀见众生。\n利物终相应，施为愿要精。\n身慵何隐遁，舌辩谩纵横。\n种性归真理，因缘有重轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46046,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其十七","author":"赵炅","text":"诗中包异境，解者不为非。\n深信含玄理，幽通是可依。\n达人皆论道，狂酒败棱威。\n浩渺寰瀛内，寒暄隐圣机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46047,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其二十","author":"赵炅","text":"大底缘由比类深，能中此道费光阴。\n若知浊浪澄清水，不达浮生认白金。\n走作真珠藏妙理，究推神室好相寻。\n功成稳审时间用，变转无穷重古今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46048,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其十二","author":"赵炅","text":"法则定乾坤，千秋与万春。\n金乌飞绛阙，玉兔弄精神。\n达识逢堪笑，贤愚本是真。\n清风摇圣境，仙说洞中人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46049,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其九","author":"赵炅","text":"天界殊胜理，凡愚不易知。\n曩因谁可究，浅近故怀疑。\n的实归真性，区邪入正持。\n乐耶亲大道，报应自然之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46050,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其十五","author":"赵炅","text":"从凡入圣作梯媒，红燄炉深岂易裁。\n点化纵横名大药，纳驱杂类谩成灰。\n真铅即是机关理，闇室皆明任众猜。\n未究前言劳自苦，精穷玄妙乐康哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46051,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其二","author":"赵炅","text":"大道虚无境，信之则有灵。\n幽深玄妙理，运转几曾停。\n拘束从何益，周通静杳冥。\n真空非作相，善应保安宁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46052,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其十八","author":"赵炅","text":"宿愿通贤圣，贪心勿强为。\n眼前销恶趣，天鉴故无私。\n如梦何光景，明神所在知。\n精修观出离，解脱影相随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46053,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其三","author":"赵炅","text":"大道逢来是宿缘，终期定可访真仙。\n山中修鍊非州郡，城里无荒隐市廛。\n秘术岂教容易得，幽深还许递相传。\n超凡入圣浑闲事，问取人间十洞天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46054,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"缘识 其四十五","author":"赵炅","text":"古来高逸士，数目几多人。\n积德千花秀，温良七宝珍。\n缘因终可作，好事福齐臻。\n宇内光阴速，仙天夜月春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46055,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"缘识 其四十六","author":"赵炅","text":"秋锁烟岚日未蚁，道情欲话老僧期。\n旋烹茶灶心先喜，摇撼松风睡思迟。\n鹤唳九霄堪入画，云平三界化无私。\n真宗象教非虚说，对境成空是我师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46056,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其十五","author":"赵炅","text":"达道真人见者稀，岂教容易等闲知。\n阴阳造化无非实，天地元精动合宜。\n功行三千须及物，还丹九转上升时。\n忙中岁月忙中遣，我本愚来性不移。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46057,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其一","author":"赵炅","text":"还元到即见真归，不是虚传羽化飞。\n大道勿将闲设用，精修别得便忘机。\n安排稳入龙宫内，变易终藏虎鼎威。\n豁达乾坤神妙理，逍遥铅汞共相依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46058,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"缘识 其四十三","author":"赵炅","text":"皆救眼前急，锥刀蕴利名。\n愚心违善道，慧眼自分明。\n大海波浪没，深山栋木成。\n旁求存古意，后学法先生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46059,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"缘识 其三十七","author":"赵炅","text":"世上多虚饰，方知一切心。\n不群终是异，僻学古同今。\n逸士宽怀释，为官理道深。\n移时非独见，令我思沈吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46060,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"缘识 其二","author":"赵炅","text":"往事兴人感，徘徊思寂寥。\n湛然穷古道，群品似相邀。\n春台松柏静，秋风海岳摇。\n时迁何倏忽，落叶自零飘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46061,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其二","author":"赵炅","text":"无为道大入幽玄，几许风光慕昔贤。\n对境尽同闲见识，忙中皆是急相煎。\n配匹直须宽雅淡，会有逢时不偶然。\n修鍊但教坚志气，参详稳审更周旋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46062,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"缘识 其四十八","author":"赵炅","text":"人本心田静，机关买是非。\n聪明存节操，曲直自相依。\n思寂知玄奥，区分有顺违。\n精通含识性，理义恺然希。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46063,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"缘识 其四十","author":"赵炅","text":"豁意何清净，愚人不信迷。\n石岩孤野鹤，仙路蹑云梯。\n栋木生深谷，寒鸦入夜啼。\n怡颜能待客，沽酒旋烹鸡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46064,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"缘识 其四十","author":"赵炅","text":"凤皇燕雀不同群，非类宜然信有闻。\n好景销磨还尔梦，方知虚诞似浮云。\n闲吟比喻明如日，雅道留情旧典坟。\n堪与言论谁是识，舜琴惠爱鼓南薰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46065,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"缘识 其三十九","author":"赵炅","text":"石室巢新燕，人心在眼前。\n飞云高去影，败叶拥流泉。\n取舍凭认定，升沈勿自专。\n守贫知大道，盛事好攀缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46066,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"缘识 其八","author":"赵炅","text":"寂静人歌咏，愚情岂易知。\n但求心自乐，不怕面相欺。\n枉直回邪灭，颠狂道德持。\n高明常鉴照，方寸欲何之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46067,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"缘识 其一","author":"赵炅","text":"高山石室半空嵌，选取灵芝草尽芟。\n法意要修心一等，道情焉用口三缄。\n丹砂保重开清境，白发相宜倚翠岩。\n曩劫缘中因种在，布衣鹤袖凤来衔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46068,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"缘识 其十","author":"赵炅","text":"浮生人怕死，蝼蚁命何轻。\n福业随缘寂，慈悲响善名。\n在家行孝爱，食禄尽忠贞。\n天道不移改，佛心化有情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46069,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其九","author":"赵炅","text":"巅峰一望不深潭，谁解缘情语话堪。\n暗室自开明日月，道心奇异老山庵。\n研穷妙理真消息，诫忌先贤让不贪。\n稽古尚为今法则，愚蒙太甚苦谈谈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46070,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"缘识 其三十六","author":"赵炅","text":"民间天上事，通理一言之。\n仙积千年寿，人终百岁期。\n礼容分次第，汎爱别尊卑。\n福业有轻重，那堪乱作为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46071,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"缘识 其十四","author":"赵炅","text":"无穷思广大，幽隐便知深。\n智达千经论，方关一寸心。\n总明怀往古，曩劫顺从今。\n此理人须信，周旋子细寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46072,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"缘识 其八","author":"赵炅","text":"孤云野鹤镇常闲，随宜自在杳冥间。\n杉松高拔千万尺，寒泉引望峭青山。\n大道烟霞看更远，将临海峤叩玄关。\n知之修鍊凡超圣，岁月空深不易攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46073,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"缘识 其五十","author":"赵炅","text":"金刚般若心，善破无明因。\n我佛慈悲日，祇园见法身。\n菩萨开慧眼，生死转为轮。\n五蕴皆空尽，六根不染尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46074,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"缘识 其四十三","author":"赵炅","text":"高山树叶翠森森，寂静因中道最深。\n利得昆崙皆璞玉，不须丽水有真金。\n浇漓渐变同尧日，薄俗将重理舜琴。\n祸福年长随世改，玄门大戒喻飞沈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46075,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其四","author":"赵炅","text":"泥丸本是命根宫，消息临时语话通。\n大道比来行气术，其馀效验藉阴功。\n物情之理皆清净，造化玄微事莫同。\n珍重此言深可意，腹中日运鼎花空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46076,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其十一","author":"赵炅","text":"非人口似泻汾河，此辈尘中有甚多。\n心恨貌恭无定止，舌誇端正乱乖讹。\n为官善政身荣禄，利剑休教石上磨。\n立待满盈船陷水，恶风从被海神拖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46077,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"缘识 其二十七","author":"赵炅","text":"世途含万象，稽古便知今。\n大树垂清影，如花耀碧岑。\n虚劳空自白，德行胜黄金。\n有过而能改，无为积善深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46078,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"缘识 其五十九","author":"赵炅","text":"拊弄声相引，兼能辨五音。\n沈思调品切，句度更加吟。\n紧慢弦中得，凝情指法深。\n精英闲雅澹，停歇世途心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46079,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其十二","author":"赵炅","text":"清静真空理，不无解者难。\n纵横依见性，廓落智中观。\n坦荡归仁德，辛勤久远看。\n勿教为逆顺，平地入云端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46080,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其二十","author":"赵炅","text":"因缘业障遇真稀，黄帝乘龙岂是非。\n达识尚凝常恍惚，愚蒙学解故相违。\n华池秘密人天授，神室光扬日月辉。\n智者无言皆口嘿，敢将容易论玄机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46081,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"缘识 其四十五","author":"赵炅","text":"四叙相迁亦可观，斜扉半掩半攲关。\n诗吟海岳皆空尽，扇觉秋凉渐放闲。\n树影临窗迷远思，渴禽恋水复飞还。\n旋教摘果瞑心话，叶木苍苍天地间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46082,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"缘识 其四","author":"赵炅","text":"当看浮生业，朝观暮亦悲。\n笑迎先溟目，恶至聚愁眉。\n正直回斜曲，冤逢不用推。\n小人心似兽，君子定无欺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46083,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"缘识 其三十","author":"赵炅","text":"爱老及怜贫，逢迎善者亲。\n道高明似日，民有几般人。\n盛暑观蚊蚋，窊鱼探海津。\n闲忙皆自得，冬去后知春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46084,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"缘识 其四","author":"赵炅","text":"耳根清静本来修，万法从心不外求。\n海岳动摇山色异，玄珠尽在眼中收。\n持斋道士寻红药，醉卧仙人未白头。\n麋鹿同群方可信，逢春但笑乐花秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46085,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"缘识 其六","author":"赵炅","text":"大道常恭谨，明灵不降威。\n少言知有信，多事自招非。\n年寿看松柏，冠簪短布衣。\n我心忙也乐，清净得同归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46086,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其十四","author":"赵炅","text":"贪染犹来理不通，虚劳岁月面西东。\n从前自是凡心别，利益须归上帝功。\n洞府名高同景致，尘泥踪迹莫知空。\n去非但向铅中作，变化飞腾大道雄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46087,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其十九","author":"赵炅","text":"寻思道味咏吟哦，去住先贤有几何。\n性识无凝关要妙，浮沈依约不言多。\n但将子细分明说，犹恐闲非却被魔。\n救世比来心所愿，逍遥尽入扣玄歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46088,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"缘识 其四十六","author":"赵炅","text":"君子怀幽趣，谦恭礼乐才。\n经心皆识见，书史尽通该。\n有德馨还远，清虚道亦开。\n先生宜法则，宿习自将来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46089,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"缘识 其二十八","author":"赵炅","text":"法演双林下，凡情世眼观。\n澹烟光雨际，孤月净云端。\n意思皆时暂，纵横大教宽。\n含情能息虑，物外不相干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46090,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"缘识 其五十","author":"赵炅","text":"是非人我利名心，情伪言同海似深。\n浩渺无涯成理性，无为志大可胜任。\n千年岁月周游在，万卷诗书不易寻。\n世界之中宽更远，从分混沌至如今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46091,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其八","author":"赵炅","text":"真境堪依仗，周迁四叙移。\n人忙闲圣迹，心达罢狐疑。\n俊造皆流品，逢能即是师。\n二从寒暑变，龙浴凤皇池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46092,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其六","author":"赵炅","text":"天生颜貌几何般，鹤骨餐霞厌俗观。\n赤水华池谁法则，白银为阙又堪看。\n来传音旨俱然混，位有尊卑勿异端。\n逆顺之中关理性，心田静外岂相干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46093,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"缘识 其二十四","author":"赵炅","text":"避罪胜修福，其为理一般。\n资财丰利益，公道不欺瞒。\n浊世贪荣禄，明时善政官。\n遏强能抚弱，容此势情观。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46094,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"缘识 其二十二","author":"赵炅","text":"一逢又一别，来往几时休。\n处世皆名利，贪生去不留。\n善缘看似梦，恶事勿临头。\n如病心常怕，生前乐自由。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46095,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"缘识 其四十七","author":"赵炅","text":"夜醮星坛海岳飞，龙车摇曳羽云衣。\n红霞影里轻烟色，玉烛风清皓月辉。\n三岛花明铺锦绣，千年鹤送下金扉。\n仙家莫道无多事，十二琼楼恨不归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46096,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"缘识 其四十二","author":"赵炅","text":"智使千般用，思量也大愚。\n黄昏直至晓，皎日瑩康衢。\n瑞典通三界，华胥乐四隅。\n谕开方便治，平坦绝崎岖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46097,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"缘识 其十八","author":"赵炅","text":"庶事情多感，光阴自古长。\n贪痴何意遣，愚辈为谁忙。\n红叶随时变，白头最易伤。\n世途能及物，善德远馨香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46098,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]