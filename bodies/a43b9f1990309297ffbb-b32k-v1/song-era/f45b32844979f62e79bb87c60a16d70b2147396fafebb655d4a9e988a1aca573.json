[{"title":"句 其八","author":"洪刍","text":"清都琼叶霏霏下，净界空花种种开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58376,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其九","author":"洪刍","text":"偏随江月横陈夜，未放官梅独自春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58377,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其五","author":"汪藻","text":"霜后木奴香噀手，秋来云子滑流匙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58378,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其十一","author":"洪刍","text":"题诗未有随州句，敢唤阮郎为老兵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58379,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其十二","author":"洪刍","text":"龙沙依旧抱城流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58380,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其十三","author":"洪刍","text":"庐山排闼参差见，湓水萦城屈曲来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58381,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其十五","author":"洪刍","text":"摩挲道傍醉石，定是天边酒星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58382,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其十七","author":"洪刍","text":"花辞好树犹啼雨，竹喜嘉宾亦叹风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58383,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其十八","author":"洪刍","text":"深秋转觉山形瘦，新雨能添水面肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58384,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梧州","author":"萧磐","text":"吟拾江边金翠羽，醉骑海上玉麟腰。\n清谈试茗游冰井，至乐观鱼坐鉴桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58385,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"冰井","author":"萧磐","text":"冰井曷无水，为与火山对。\n真宰福梧人，命名适相配。\n炎炎火之性，所至能为害。\n冰焉压其气，转否还高泰。\n祥光每发时，州人同福赉。\n乃至井若冰，其义故有在。\n我来酌冰井，其美同沆瀣。\n初疑蓬岛脉，又雅林泉派。\n井窦倘依然，古基尽亡昧。\n半为土烟没，半为石缺坏。\n于时初下车，未暇整颓溃。\n州城百舍敝，缔创岂容怠。\n旧者为之新，露者为之盖。\n卑污易以高，狭小易以大。\n于公无所侵，于私无所贷。\n一诚与规画，黾勉及三载。\n始来想井基，指示经数辈。\n引绳取其直，立标正其界。\n开凿三尺馀，适与古基会。\n西偏甃坚完，界不差井怪。\n三隅彷佛见，砖师且徐缀。\n此井信有神，州人亦嗟怪。\n井前为开池，引水成沟浍。\n所防三伏天，饮者成群队。\n井名未磨灭，自我发沉晦。\n□□□□□，所虑规模隘。\n堑崖基坎穴，伐木除荒秽。\n装点自天成，可为州胜概。\n碧塘寺之腹，青山寺之背。\n环翠既控引，泉水亦襟带。\n三宝杂装严，七宝旧豪迈。\n对面瞻神霄，出门远阛阓。\n登临益增价，顾盼无凡态。\n往往市人来，如在琼壶内。\n往往士人来，如出尘笼外。\n我常引客至，五马随双旆。\n暂脱簿领巾，忽然无障碍。\n怡神八极远，濯体清风快。\n临池似山涧，酩酊常所戒。\n屡作谢公游，敢望苍生待。\n虽无异政绩，薄有循良最。\n寄语此冰泉，为我留遗爱。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58386,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"黄华姑岩","author":"黄符","text":"铁色阴崖积石屯，玉颜窈窕镇昆崙。\n上池降液行灵响，左角承云出晓暾。\n手抉风雷穿月窟，坐当星斗直天门。\n昔人政有怀仙地，为挹清泉注一尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58387,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东湖 其一","author":"林迪","text":"门巷深深过客稀，杖藜闲坐钓鱼矶。\n醉来一枕华胥梦，肯校人间是与非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58388,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东湖 其二","author":"林迪","text":"崎岖世路苦风波，物外逍遥得趣多。\n门掩夕阳新睡觉，数声时度采菱歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58389,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东湖 其三","author":"林迪","text":"林梢乍过黄梅雨，湖面闲来白昼风。\n六月游人不知暑，恍惊身在水晶宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58390,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东湖 其四","author":"林迪","text":"一曲清歌酒一觞，幅巾林下兴何长。\n沙鸥似觉忘机久，时引新雏过短墙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58391,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东湖 其五","author":"林迪","text":"高下人家绕郡城，隔湖遥认笑谈声。\n黄庭阅罢无馀事，却倚朱栏看月生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58392,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东湖 其六","author":"林迪","text":"采莲游女惬轻衣，争弄兰舟一叶飞。\n过尽绿荷人不见，夜深时带月明归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58393,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东湖 其七","author":"林迪","text":"诗坛棋战两无双，分得壶中日月长。\n只恐明时搜隐逸，不容高蹈老沧浪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58394,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"林迪","text":"为种不同攒核李，过墙便作小陈紫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58395,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"林迪","text":"寂寂峰峦千古意，溶溶花木一家春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58396,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和祗谒真祠诗","author":"何贲","text":"清晨雪霁出东城，躬款灵祠致克诚。\n百品果蔬供荐献，万人箫鼓贺升平。\n晖晖晓日明台殿，猎猎霜风满旆旌。\n碧瓦脩廊尽宏丽，亦从民欲落新成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58397,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题刘资仁韩干饮马图","author":"赵旸","text":"韩干所画天闲图，县官日给三品刍。\n不嘶不鸣肥如凫，时时步作康庄衢。\n饮之曲江戏短芜，沙软风轻乐于于。\n岂知渥洼真龙驹，垂头戢耳困盐车。\n圉人太仆反歔歈，瘦骨硉矹甘为驽。\n不须骧首顾长途，局促骥足何时无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58398,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"奉和姚仲美腊梅","author":"赵旸","text":"阳和都未见芳菲，初喜寒苞发故枝。\n绝色夐无朱粉态，真香宁许燕莺知。\n凝愁金谷登楼日，敛黛温泉赐浴时。\n写作新声传玉笛，谁人持向月中吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58399,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"芝山梅仙洞","author":"刘绾","text":"传闻梅子真，入山歌采芝。\n蝉蜕升紫雾，灵踪使人思。\n骖鸾不复返，蔓草空离披。\n高风自百世，非假神仙师。\n人生不朽业，大节在无亏。\n服食求冲举，虚无恐难期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58400,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寒食","author":"陈元老","text":"至后百五日，春光无火晨。\n金钿沽酒妾，罗袜弄毬人。\n莺语如留意，花枝不卖贫。\n东园旧桃李，红白尽成尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58401,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登科","author":"陈元老","text":"引领群仙上紫微，云间相逐步相随。\n桃花直透三层浪，桂子高攀第一枝。\n阆苑更无前骤马，杏园都是后题诗。\n男儿显达当如此，满袖馨香天下知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58402,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"道士","author":"陈元老","text":"头戴鹿胎皮，身披鹤氅衣。\n月寒丹井立，霜白醮坛归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58403,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"徐真君祠堂东西二室次许将韵","author":"陈旸","text":"六题曾彻九重门，暂阻尧阶奏万言。\n今日又蒙师许我，汉廷当沛异常恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58404,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赵真君岩","author":"陈旸","text":"岩顶风云常不散，洞门日日吐烟霞。\n济时偏解为霖雨，信是神仙第一家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58405,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南台沙合亭","author":"陈旸","text":"闽州胜概是南台，沙合相传有自来。\n一道三桥横渡处，分明平步揖天台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58406,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"缺题","author":"陈旸","text":"行艺当年帝所闻，声名久矣动簪绅。\n文场秉笔渊源厚，诗席谈经业履醇。\n白发忽惊蒿里暮，青衫难问箬溪春。\n两京模范垂芳远，多少生徒泪满巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58407,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"陈旸","text":"地喷飞泉成雨露，根盘乔木列旌麾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58408,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"陈旸","text":"南台沙合半成洲，千尺虹桥橄榄舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58409,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题灵岩寺","author":"蔡安持","text":"四绝之中剧最先，山围宫殿锁云烟。\n当年鹤驭归何处，世上犹传锡杖泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58410,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"灵岩","author":"蔡安持","text":"岱宗分秀萃灵岩，殿阁峥嵘叠嶂间。\n师感青蛇寻胜地，泉因白鹤贡禅关。\n松梯十里藏归路，僧梵千声响夜山。\n暂脱尘缨聊息驾，未容心逐片云閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58411,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和洪朋","author":"饶次守","text":"当时为举首，满意望龙飞。\n而今已报罢，且归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58412,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"八百石洞","author":"胡僧孺","text":"八百遗踪石室存，神仙杳邈事难论。\n云浮绝顶人常见，龙起深潭昼亦昏。\n信有林泉閒日月，好将名利付乾坤。\n他年栖隐山畴下，咫尺烟萝再可扪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58413,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和邑宰韵","author":"江贽","text":"一室萧然傍水湾，自知穷达不相关。\n钓鱼溪绕黄沙路，种粟原通白马山。\n有命幸逢天子诏，无才休望啬夫纶。\n佳篇劝奖非吾事，已许巢由厕有班。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58414,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"植竹吏隐堂后因题 其一","author":"许安仁","text":"斸破中庭一亩苔，主人发白手亲栽。\n即今谁识清真节，须向三冬雪后来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58415,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"植竹吏隐堂后因题 其二","author":"许安仁","text":"珍重劳君慰远游，繁声疏影一堂秋。\n主人看即官期满，分付风烟与子猷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58416,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和御制宫词","author":"许安仁","text":"轻寒惨惨透衾罗，玉箭铜壶漏水多。\n常是未明供御服，梦回频问夜如何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58417,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梦中作","author":"许安仁","text":"山色浓如滴，湖光平如席。\n风月不相识，相逢便相得。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58418,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题善山院","author":"许安仁","text":"瓦炉柏子袅残烟，午梦醒时一畅然。\n不悟功名负终老，荒山饥走又三年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58419,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和郡守刘巨济重开石门洞","author":"朱筠","text":"谢公箕颍流，特拟耽幽栖。\n蜡屐得洞天，双鹤頫清溪。\n拟追玄圃游，对此为阶基。\n披榛剪萝茑，宿雾暝欲迷。\n方当誇高标，焉能分径蹊。\n鬼物谅夺气，幽禽亦惊啼。\n卓哉旷世怀，心与境不携。\n俯视嚣尘中，荣枯犹稗夷。\n孰知东海偏，秦鞭预排驱。\n付与破荒手，从此凌丹梯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58420,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答琅琊问无位真人偈","author":"俞道婆","text":"有一无位人，六臂三头努力嗔。\n一擘华山分两路，万年流水不知春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58421,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"马祖不安因缘颂","author":"俞道婆","text":"日面月面，虚空闪电。\n虽然截断天下衲僧舌头，分明祇道得一半。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58422,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"婆子偷赵州笋因缘颂","author":"俞道婆","text":"虎穴魔宫到者稀，老婆失脚又怀疑。\n赵州吃掌无人会，直至如今成是非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58423,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"吕大有","text":"范雎才拊穰侯背，蔡泽闻之又入秦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58424,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"世尊指天地","author":"释守卓","text":"周行七步便称尊，家丑那堪放出门。\n祇向母胎度人毕，也须一棒一条痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58425,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"外道问佛","author":"释守卓","text":"外道粗心惯崄夷，老胡鞭影露针锥。\n行人拾得东门兔，谁管韩獹精力疲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58426,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"维摩不二","author":"释守卓","text":"洞门常启客来稀，碧草丛边野蕨肥。\n可笑流年空老大，惭无一德报恩知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58427,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"珊瑚枝枝撑著月","author":"释守卓","text":"仙重三千不可图，从教千古强名模。\n长因塞北烟尘息，记得江南啼鹧鸪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58428,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"汝是慧超","author":"释守卓","text":"问佛如何答慧超，秤锤虽定价相饶。\n云中不睹双雕落，箭过新罗十万遥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58429,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"不许夜行投明须到","author":"释守卓","text":"虚空产生铁牛儿，头角分明也太奇。\n踏破澄潭深处月，夜阑牵向雪中归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58430,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"国师三唤侍者","author":"释守卓","text":"唤处分明应处亲，不知谁是负恩人。\n东家漏泄西家事，却使傍观笑转新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58431,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"恁么也不得","author":"释守卓","text":"凛凛清风八面吹，雄雄独跨铁牛儿。\n为公剔起金刚眼，拶破髑髅应自知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58432,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"风幡谁动","author":"释守卓","text":"梦游华顶过丹丘，蹑尽寒云倚石楼。\n贪看瀑泉泻崖壁，岂知身在碧江头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58433,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"目前无法意在目前","author":"释守卓","text":"九转灵丹难却易，一锤便当易还难。\n相逢话尽壶中事，重把仙书子细看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58434,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"昨日栽茄子","author":"释守卓","text":"钁子头边得意时，开花著子不愁伊。\n几多不善根株者，祇见枝头又长枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58435,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赵州勘婆","author":"释守卓","text":"勘破谁知老赵州，玉鞭鞭起卧金牛。\n台山今古行人口，笑饮清风味转幽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58436,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"智门莲花","author":"释守卓","text":"莲花荷叶的须分，无限清香付与君。\n弹指若知霄汉路，便能平地起烟云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58437,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寒时寒杀阇黎","author":"释守卓","text":"偏中有正正中偏，流落人间百万年。\n几度欲归归不得，门前依旧草芊芊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58438,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"道吾生也不道","author":"释守卓","text":"木人把板云中唱，石女穿靴水上行。\n生死死生休更问，从来日午打三更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58439,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"投子下绳床立","author":"释守卓","text":"爱向江边弄钓丝，碧潭深处有嘉鱼。\n钩头不是无香饵，个底如何钓得渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58440,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"虾蟆头上戴青苔","author":"释守卓","text":"虾蟆头上戴青苔，绣出鸳鸯孰辨猜。\n几许离人消息断，一声鸿雁送愁来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58441,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"长沙令人问三圣南泉迁化向什么处去","author":"释守卓","text":"探花蝴蝶舞三台，啄木掉头鸣讶鼓。\n处处相逢岑大虫，元来便是玄沙虎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58442,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"岩头甘贽家过夏因缘二颂 其一","author":"释守卓","text":"一回吃水一回噎，百鍊精金要人别。\n门前谁解倒刹竿，瓮里何曾失却鳖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58443,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"岩头甘贽家过夏因缘二颂 其二","author":"释守卓","text":"针头扎去几人知，妇儿女子莫猜疑。\n圣凡命脉果何在，向此须明上上机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58444,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"世尊拈花迦叶微笑","author":"释守卓","text":"世尊拈花，迦叶微笑。\n不落宫商，是何曲调。\n古洞风清，寒潭月皎。\n报公知，须晓了，融峰最好音声鸟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58445,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"日面佛月面佛","author":"释守卓","text":"日面佛，月面佛，大海波翻，须弥突兀。\n磕破脑门，额头汗出。\n明眼衲僧未辨明，抬头好看冲天鹘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58446,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"德山棒临济喝","author":"释守卓","text":"德山棒，临济喝。\n铜金刚，铁菩萨。\n轰雷发处，有耳皆聋。\n撒星来时，无眼不瞎，瞎与公重指曹溪月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58447,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三圣到德山即展坐具","author":"释守卓","text":"呼为云，吸为雨，袭袭清风动寰宇。\n笑哭不是等闲声，路见不平应有主。\n要斩不平人，不与平人语。\n而今何处见踪由，剔起眉毛看鹞子。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58448,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"定上座桥上立有座主问如何是禅河深处须穷底","author":"释守卓","text":"辨金要识鍮，觅髓须打骨。\n平地激风波，禅河没窠窟。\n党理亦党亲，成家又成国。\n拗拗硗硗，突突兀兀。\n无限傍人，眼睛凸出。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58449,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]