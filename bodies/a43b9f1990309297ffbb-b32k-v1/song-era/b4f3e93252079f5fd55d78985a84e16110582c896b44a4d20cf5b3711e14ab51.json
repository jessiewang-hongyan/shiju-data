[{"title":"题晁恭道善境界图 其一","author":"吕本中","text":"畴昔相从三十年，如今休去不逃禅。\n知君参见法轮老，始悟苍苍便是天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12631,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题晁恭道善境界图 其二","author":"吕本中","text":"境界本来无善恶，人间何处有新图。\n欲知个里真消息，腊月寒松永不枯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12632,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"问乾元圭老","author":"吕本中","text":"问讯乾元老，江头几日回。\n还应舣船待，不作御风来。\n漫有经旬别，频思一笑开。\n庭前荔子熟，尚要著诗催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12633,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠杨绍祖","author":"吕本中","text":"城东往还者，相近得杨卿。\n处世如无事，为官不近名。\n匣藏防身剑，案有读书檠。\n此外唯尊酒，时时唤客倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12634,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谢宇文漳州送茶","author":"吕本中","text":"暑气侵人病逾剧，虚堂坐调出入息。\n漳州太守送茶来，王圭小凤俱无敌。\n太守怜我病无语，故遣此茶相劳苦。\n千金一饼君未许，百金一盏如泼乳。\n其它斗芽未足数，下视纷纷等尘土。\n病夫未饮病先愈，坐觉爽气生肺腑。\n城中车马闹如雨，更有乐善如君否。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12635,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夏日","author":"吕本中","text":"暑雨遂经月，客来困稍疏。\n闭门观易象，反复看何如。\n妙处元非画，微言不在书。\n故山初未远，举首是吾庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12636,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过刘忠显公乡县作","author":"吕本中","text":"疾风知劲草，世乱识忠臣。\n自古有此语，今代岂无人。\n刘公生东南，节义迈等伦。\n时危出一死，以捍胡马尘。\n遂令天下人，稍知吾道尊。\n至今生气在，凛凛凌层云。\n我行崇安野，瞻望彼高坟。\n流泽既未远，有子贤而文。\n会当广德业，早为建殊勋。\n此意苟不泯，楚人生伍员。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12637,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夏日深居二首 其一","author":"吕本中","text":"匆匆车马未言还，因病深居未得闲。\n更为故人留一夏，稍移行李过东山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12638,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夏日深居二首 其二","author":"吕本中","text":"故人多住城东寺，还许相过结净缘。\n海寇求降荔子熟，是中风月可忘年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12639,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"乾元副寺欲还云门","author":"吕本中","text":"子有四方志，云门寻旧游。\n溪山往时梦，江海一番秋。\n物态随高下，生涯任去留。\n闲将问庵主，如此是禅不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12640,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"庆尧侍者以诗相赠偶成绝句谢之","author":"吕本中","text":"满城车马杂尘埃，所至如云拨不开。\n只有西禅尧侍者，肯冲剧暑送诗来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12641,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"渴雨简张仲宗二首 其一","author":"吕本中","text":"强读文书不补饥，只今一饱尚难期。\n薄云未肯苏禾稼，细雨才堪湿荔枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12642,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"渴雨简张仲宗二首 其二","author":"吕本中","text":"雨湿平林松桂香，断云冉冉拂疏篁。\n江山故自可人意，从此归休策最长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12643,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谢杨绍祖惠玉友","author":"吕本中","text":"我来闽中居，中热久断酒。\n端居苦无事，神气思内守。\n故人怜我病，小缸送玉友。\n极知此不凡，岭海见未有。\n感君意则重，纳约况自牖。\n欣然洗盏尝，不待捧素手。\n空杯贮玉色，一洗市沽丑。\n坐令百疾去，敢复望升斗。\n从令破酒戒，可以入道不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12644,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"与李似宗别后奉寄","author":"吕本中","text":"昔者相过今几时，心期虽在事多疑。\n滞留江海君先病，怅望云山我欲归。\n老境犹存作诗苦，故人多有食言肥。\n汉阴老父如无事，肯复逢人论是非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12645,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"作雨不成旱暑愈甚未能就道","author":"吕本中","text":"三日阴风雨不成，坐嫌冲暑作宵征。\n敢因贫故累公子，尚欲闲时寻友生。\n兵甲未休心已醉，诗书颇费眼犹明。\n便须准拟庵居用，拄杖绳床折脚铛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12646,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闻鹊","author":"吕本中","text":"一夏病如此，他乡闲未回。\n疏檐闻鹊喜，知有远书来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12647,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"荔子","author":"吕本中","text":"南征未厌苦关山，荔子今年已厌餐。\n时有野僧来献供，每烦佳士约同槃。\n门前炎暑三伏旱，坐上冰霜六月寒。\n他日一尊须念此，中州传买半梨乾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12648,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"乾元真歇数约他日同庵居","author":"吕本中","text":"与君俱自走天涯，何处云山不是家。\n城市少留真梦事，林泉高卧亦空花。\n久无佳句彫肝肾，漫有微言到齿牙。\n他日一庵如可必，愿分斋罢半瓯茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12649,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"将发福唐","author":"吕本中","text":"尽此一囊粟，我行当有期。\n凉风吹天涯，增我别后思。\n结束向行在，问子还何时。\n初无济时策，处事多参差。\n环视中所有，无一施可宜。\n形骸久已病，敢徼当世知。\n不蒙朋友责，定遭儿辈嗤。\n矧此世外人，劝归常恐迟。\n相寻有如日，请盟吾此诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12650,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"听雨","author":"吕本中","text":"日数归期似有期，故园无语说相思。\n芭蕉叶上三更雨，正是愁人睡觉时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12651,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"末利","author":"吕本中","text":"香如含笑全然胜，韵比酴醾更似高。\n所恨海滨出太远，初无名字入风骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12652,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闻二弟召对","author":"吕本中","text":"晚来忽雨已如秋，竹枕攲眠得自由。\n忽报诸郎例升进，颇容老子便归休。\n人传胡虏三年旱，势合山河一战收。\n顾我迂疏最宜病，祗应随处见菟裘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12653,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夜凉早起寻李贻季陆庆长所惠诗有作","author":"吕本中","text":"夜长忘阴晴，忽听檐雨滴。\n空房闭重门，凉气通枕席。\n欣然欲揽被，如觅旧相识。\n那知庚伏内，得此睡通夕。\n起寻两君诗，令我生气力。\n成蹊长桃李，已自除荆棘。\n远游得数士，舍此百无益。\n挑灯视皮肤，不顾蚊咬赤。\n因之不复寐，为子增叹息。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12654,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闻大伦与三曾二范聚学并寄夏三十一四首 其一","author":"吕本中","text":"我思临川居，欲往意未慊。\n每怀三二子，岁月多荏苒。\n后生慎所习，正是丝在染。\n未须极轩昂，且须就收敛。\n举动思故人，此志岂不远。\n才虽有高下，事亦要强勉。\n愿为江海深，莫作盆盎浅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12655,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闻大伦与三曾二范聚学并寄夏三十一四首 其二","author":"吕本中","text":"世人争锱铢，未语色已变。\n居然面颈赤，自处亦已贱。\n宁知烈士胸，渠自有志愿。\n一介不妄取，万钟我亦倦。\n古人有伯夷，名冠太史传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12656,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闻大伦与三曾二范聚学并寄夏三十一四首 其三","author":"吕本中","text":"见人辄有求，所以百虑非。\n但能守箪瓢，何事不可为。\n愚夫饱欲死，志士固长饥。\n出门万里涂，其亦慎所之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12657,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闻大伦与三曾二范聚学并寄夏三十一四首 其四","author":"吕本中","text":"莫惜一日勤，而忘终身忧。\n农夫力耕作，其必岁有秋。\n日前不卤莽，久亦有倍收。\n少年不努力，老大复何求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12658,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"别法一上人","author":"吕本中","text":"我有江浙役，子能乘兴来。\n便同汤院浴，却为故人回。\n此道恐遂绝，后生良可哀。\n试寻钥匙子，一一与重开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12659,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"别后寄圭粹中","author":"吕本中","text":"海上相逢两过秋，飘然乘兴亦悠悠。\n送行百里还归去，同是江湖不系舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12660,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"哭王元迈","author":"吕本中","text":"纷纷举手争毫末，砥柱当河独不流。\n一夕便随波浪没，天涯黄叶更悲秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12661,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"别林氏兄弟","author":"吕本中","text":"二年住闽岭，所阅足青紫。\n那知万众中，得此数君子。\n相从不我厌，但觉岁月驶。\n高论脱时俗，如风濯烦暑。\n出处虽未同，气味固相似。\n人生有离合，所畏为物使。\n要当啜英华，不必计渣滓。\n他年肯相寻，在彼不在此。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12662,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"本中欲谋他日复来福唐之东山林少颖请作诗以记因成两绝 其一","author":"吕本中","text":"老大驰驱百不宜，敢将筋力蹈危机。\n他年更欲眠云住，同过东山尝荔枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12663,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"本中欲谋他日复来福唐之东山林少颖请作诗以记因成两绝 其二","author":"吕本中","text":"更作东山住，寻盟尚有诗。\n看君腾踏去，及我未归时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12664,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谢人惠陈家紫","author":"吕本中","text":"烦君惠我陈家紫，万里漂流合得尝。\n莫道闻名不相识，旧随笾实到吾乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12665,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闲居感旧偶成十绝乘兴有作不复诠次 其一","author":"吕本中","text":"四海交游一信民，后来情分更谁亲。\n可怜相伴溪堂老，一去尘寰三十春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12666,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闲居感旧偶成十绝乘兴有作不复诠次 其二","author":"吕本中","text":"一世声名高与关，亦知不合住人间。\n不令整顿乾坤了，虚逐松声半夜还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12667,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闲居感旧偶成十绝乘兴有作不复诠次 其三","author":"吕本中","text":"璧老投冠去学禅，堂堂一鼓阵无前。\n平生老伴唯均父，马病涂穷不著鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12668,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闲居感旧偶成十绝乘兴有作不复诠次 其四","author":"吕本中","text":"屏医却药病良已，绝学捐书我又休。\n却到旧时行履处，五湖烟水上渔舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12669,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闲居感旧偶成十绝乘兴有作不复诠次 其五","author":"吕本中","text":"万里飘然不系舟，老来专忆旧交游。\n西风日落中原路，虚度江湖数十秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12670,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闲居感旧偶成十绝乘兴有作不复诠次 其六","author":"吕本中","text":"唐子直心绝可怜，夏侯苦节更谁传。\n诸晁事业风流在，各有残诗十数篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12671,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闲居感旧偶成十绝乘兴有作不复诠次 其七","author":"吕本中","text":"平生亲爱独诸晁，叔也相亲共寂寥。\n半日不来须折简，暂时相远定相招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12672,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闲居感旧偶成十绝乘兴有作不复诠次 其八","author":"吕本中","text":"病夫长病合长饥，岂复轻随世上儿。\n云雨覆翻渠有分，江湖潦倒我无知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12673,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闲居感旧偶成十绝乘兴有作不复诠次 其九","author":"吕本中","text":"曾郎学行冠姻亲，赵子才能又绝伦。\n仲弟故应同二妙，一时先后委埃尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12674,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闲居感旧偶成十绝乘兴有作不复诠次 其十","author":"吕本中","text":"便欲长休老未能，尔来频愧住庵僧。\n直须弃尽人间事，始见从来一点灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12675,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"温泉","author":"吕本中","text":"海上秋来早晚凉，客愁苏醒似还乡。\n归途尚欲疗疮疥，剩乞温泉一勺汤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12676,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"将去福州","author":"吕本中","text":"委曲随人久未甘，翛然午枕睡方酣。\n功名到此终无分，身世从来百不堪。\n为己工夫今粗晓，住山活计久相谙。\n他时不用求三径，投老才须住一庵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12677,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"初秋","author":"吕本中","text":"凉风惊木叶，意欲作深秋。\n客病浑如昨，囊空却自由。\n因闲得饮酒，端坐胜封侯。\n寄语平生友，当能为我谋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12678,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"奉呈鼓山云门二老","author":"吕本中","text":"汝水相逢今几年，只今同住海南偏。\n月明本自无亏缺，山色何尝有变迁。\n他日会逢昆弟语，一时惊散老狐禅。\n倘因居士闲开口，却作冲和二月天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12679,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"从叔巽叔觅茶","author":"吕本中","text":"疾病侵凌转不堪，时思一室奉清谈。\n嗣宗已饷兵厨酒，当有新茶惠阿咸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12680,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"福建界首寄福州亲旧","author":"吕本中","text":"海上秋风吹客衣，屡烦亲旧送将归。\n今朝更入江东路，便恐书来即渐稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12681,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"严州九日坐上赠胡明仲常子正","author":"吕本中","text":"今年得交旧，九日会严州。\n城角风云暮，天涯景色秋。\n功名有长铗，行李付扁舟。\n苦恨三年别，聊因一笑留。\n病添文字懒，老耻稻粱谋。\n活国须公等，吾生便可休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12682,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"方允迪挽词二首 其一","author":"吕本中","text":"已矣儒林老，今为地下郎。\n空山留几杖，遗稿漫文章。\n径狭风霜远，溪深草木长。\n伤心钓台路，千载閟幽光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12683,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"方允迪挽词二首 其二","author":"吕本中","text":"惟君好兄弟，少小共声名。\n岂止千人杰，俱为一代英。\n云何卧丘壑，不使至公卿。\n恸哭松风远，悲云咽莫声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12684,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"程伯禹母夫人挽诗二首 其一","author":"吕本中","text":"久矣闺门秀，端如玉在渊。\n相夫成令德，教子作名贤。\n遽逐秋风尽，空令莫景迁。\n伤心江左地，松柏闭新阡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12685,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"程伯禹母夫人挽诗二首 其二","author":"吕本中","text":"旧随贤子后，每得熟严规。\n未获升堂拜，空成相挽诗。\n爵频赐汤沐，寿不到期颐。\n他日家声在，流传世未知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12686,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送范师厚宣谕四川","author":"吕本中","text":"老境侵寻久废诗，送君宁复似当时。\n虺隤病马犹长路，偃蹇寒松只旧枝。\n想得山川瞻使节，便令父老识家规。\n圣朝本意惟宽大，网漏吞舟始合宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12687,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠了老","author":"吕本中","text":"前年见公沧海上，法会堂堂万骑将。\n今年见公浙河东，犹是当时旧老翁。\n送行更有天童老，骐骥齐驱猎霜草。\n野狐射干胆欲破，不但独喷群马倒。\n我衰且病百念绝，便得从公不为早。\n忘情遁迹亦未是，言与不言俱一扫。\n世人扰扰不归家，公行问渠有何好。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12688,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送杨晨当时赴夔漕","author":"吕本中","text":"杨侯从旧名籍籍，吴中一见如旧识。\n怜我衰颓病已侵，怪我辛勤百无益。\n今君遽作巴蜀行，江头宿昔春水生。\n路经三峡不艰阻，遍与疲民问疾苦。\n随身长剑莫轻舞，试伐蛟鼍斩豺虎。\n此来人士众如雨，得君此行慰羁旅。\n君但垂情一笑许，胜使区区入州府。\n百城因之遂安堵，亦胜无事闲坐否。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12689,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送徐林稚山赴江西漕","author":"吕本中","text":"总角相从四十年，如今衰病已华颠。\n久无耆老可访事，尚喜交游不乏贤。\n未使从容持从橐，却令辛苦上江船。\n百城编户皆疲瘵，日望公来与息肩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12690,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"将发金陵奉怀张彦实","author":"吕本中","text":"老矣君何往，翩然我欲归。\n文章晚未用，岁月事多违。\n江接鄱阳路，风吹游子衣。\n不应蘧伯玉，独悟昔年非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12691,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"初离建康 其一","author":"吕本中","text":"尝忆他年出旧京，汴堤榆柳与船平。\n宁知此日钟山路，亦是东行第一程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12692,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"初离建康 其二","author":"吕本中","text":"纷纷车马未言还，我独支离便得闲。\n尚有同门二三子，肯同今夜宿钟山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12693,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寓会稽禹迹寺","author":"吕本中","text":"阴雨静不出，端居还自由。\n客来从短褐，天气已深秋。\n所在兵犹斗，中原乱不休。\n庙堂如有意，便与万人谋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12694,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"会稽初秋四首 其一","author":"吕本中","text":"今来留滞浙河东，想见闽山荔子红。\n虽有故人家在彼，可无方便托西风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12695,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"会稽初秋四首 其二","author":"吕本中","text":"张侯问舍复何时，我亦留连去未期。\n便欲为君草堂客，几时先寄落成诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12696,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"会稽初秋四首 其三","author":"吕本中","text":"故园回首但斜阳，所至奔波避贼忙。\n天下何曾有定处，越南燕北是中央。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12697,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"会稽初秋四首 其四","author":"吕本中","text":"病来每有居山兴，老去初无住世心。\n三尺枯桐无旧谱，始知三叹有遗音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12698,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]