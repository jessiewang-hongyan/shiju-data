[{"title":"和周监丞闻京洛关中收复四首 其二","author":"王庭圭","text":"战甲初休马，边烽不举狼。\n山河秦地壮，日月汉天长。\n剑戟将销尽，钩锄始破荒。\n欲观调鼎手，一脔已堪尝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5179,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和周监丞闻京洛关中收复四首 其三","author":"王庭圭","text":"喜有官中信，衣冠返旧京。\n交驰节旄使，悉罢羽林兵。\n丹诏从天落，群心仰首迎。\n萧条万里道，今日有人行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5180,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和周监丞闻京洛关中收复四首 其四","author":"王庭圭","text":"河南新郡县，吾宋旧山川。\n乔木应犹在，遗民不记年。\n行人将汉月，持节照胡天。\n属国今无恙，遥知免齧毡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5181,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送刘禹锡之官五羊","author":"王庭圭","text":"南海千山外，东风几驿催。\n岭头梅雨歇，旗尾瘴烟开。\n蛮徼无尘起，中原有使来。\n时应问消息，会向日边回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5182,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋夜","author":"王庭圭","text":"山色酿空碧，砧声鸣翠微。\n自怜为逐客，谁为捣寒衣。\n居士本无病，参军胡不归。\n扁舟在吾手，尔莫用危机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5183,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"晓行唐兴寺道中寄刘美中","author":"王庭圭","text":"雨洗穹色静，云开晓碧初。\n峰峦争峭拔，台殿已清虚。\n村落孤烟起，人家半岭居。\n回看岩际寺，几欲倒骑驴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5184,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"清轩","author":"王庭圭","text":"竹径有佳色，耳根无市声。\n山如画屏立，水作縠文生。\n窗户松风响，园蔬杞菊馨。\n夜深天更静，待看玉蟾明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5185,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"乱后过东山寺","author":"王庭圭","text":"烟尘苦未尽，绀殿倚岩阿。\n云护佛世界，山栖老禅和。\n斯人具眼目，法力辟兵戈。\n攲枕听粥鼓，谁能奈尔何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5186,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和黄子馀湖南道中寄弟子默二首 其一","author":"王庭圭","text":"花落黄陵庙，禽声隔岸闻。\n山川湖外远，牛斗地形分。\n回趁峰头雁，遥瞻岭上云。\n惠连诗更好，梦里亦思君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5187,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和黄子馀湖南道中寄弟子默二首 其二","author":"王庭圭","text":"卷里诗新出，关中记旧闻。\n乾坤今转大，吴楚昔尝分。\n雾失朱陵峒，晴开紫盖云。\n仍传九疑尉，奇策动明君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5188,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"又和酬子馀","author":"王庭圭","text":"句法出脩水，家声谁不闻。\n微言虽甚秘，残馥可能分。\n笔扫堂堂阵，词飞蔼蔼云。\n马卿才思逸，倾动卓文君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5189,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"又和酬子默","author":"王庭圭","text":"牛渚西江夜，新声月下闻。\n定知终夕咏，不觉晓光分。\n傥有樽中酒，重论日暮云。\n山林正憔悴，抵掌忽逢君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5190,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颇侄明碧轩","author":"王庭圭","text":"不可居无竹，开轩眼界新。\n风摇碧玉玦，雨解箨龙鳞。\n晚色侵书帙，疏枝挂月轮。\n客来从径造，莫问打门人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5191,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和李巽伯送刘德基赴县斋","author":"王庭圭","text":"令君湖海士，置榻谓公贤。\n绿野千峰翠，朱甍万室连。\n客依彭泽柳，人问孝廉船。\n他日功名逼，金鱼未免悬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5192,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"郡燕新进士胡文侍读即席赋诗因次其韵","author":"王庭圭","text":"雁塔题名处，蟾宫折桂新。\n英雄缀行列，材业济生民。\n荣耀初开宴，招呼如此宾。\n鹏飞上霄汉，横海脱凡鳞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5193,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"郭教授南窗置酒观竞渡次坐客刘时举韵 其一","author":"王庭圭","text":"一饮径一石，此风谁敢陪。\n日移林影转，船劈浪纹开。\n银烛自相映，玉山何用推。\n广文官独冷，赖有酒盈杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5194,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"郭教授南窗置酒观竞渡次坐客刘时举韵 其二","author":"王庭圭","text":"殊方作异客，胜日喜游陪。\n鼓噪风雷动，帆争锦绣开。\n诗元无格律，谁与定敲推。\n折得新荷叶，聊将当酒杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5195,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送郭教授","author":"王庭圭","text":"蛮域经年住，飘然见古风。\n新编文似锦，高论气如虹。\n杖屦容追步，箴规有发蒙。\n方期亲謦欬，吾道又将东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5196,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"庐山道中寄送聂名世","author":"王庭圭","text":"村远孤烟起，山明晓雾开。\n人行万松里，路过九江来。\n此去日千里，其如肠九回。\n淮南酒楼近，玉笛不胜哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5197,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵杨廷秀临安小楼不寐之什","author":"王庭圭","text":"坐待银蟾上，寒禁酒力加。\n霜清群动息，雁过几行斜。\n楼角犹吹笛，天街又走车。\n客眠终未稳，人语已争哗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5198,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵李巽伯赠琴僧惠端","author":"王庭圭","text":"老端高世士，髯李仙中人。\n凤吐千篇久，新吟十弄新。\n妙谈天地假，笑破海山春。\n物物消磨尽，今年始是贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5199,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"野外春日","author":"王庭圭","text":"步屧穿花径，香风吹客衣。\n地偏穷谷暖，雨过乱莺飞。\n草色连空阔，僧居入翠微。\n田翁泥人饮，数肘不容归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5200,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送向主簿","author":"王庭圭","text":"枥马志万里，棘鸾才一飞。\n荐书闻帝里，綵服过庭闱。\n野渡生春草，林花弄晚晖。\n君家芸阁老，应问我何归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5201,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题刘元弼远庵","author":"王庭圭","text":"门径临官路，耳根无市声。\n山从云外起，风入坐中清。\n静趣逸天半，孤吟待月生。\n缅怀江海意，溪水绕庵鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5202,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"辰州上元","author":"王庭圭","text":"留滞沅湘浦，飘如云水僧。\n来为万里客，又看一年灯。\n翠幰褰珠箔，高楼俯玉绳。\n鳌山今夜月，应上最高层。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5203,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"用前韵酬清首座","author":"王庭圭","text":"寺寄他乡客，家居何处僧。\n一盂钟后饭，数盏夜深灯。\n出井初无索，斲轮还中绳。\n拟心观此境，阶级已成层。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5204,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"早春游孔志行园","author":"王庭圭","text":"小圃傍城郭，新堂磨碧砖。\n青枫未钻火，高柳已参天。\n好鸟又相语，幽葩自在妍。\n敲门时径造，不问主人贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5205,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春日携頔子同刘养正教授游净国寺至李家园","author":"王庭圭","text":"野外烟光阔，僧园竹径通。\n柳丝摇嫩绿，桃雨落轻红。\n处处花如旧，年年人不同。\n自矜双足健，著屐试春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5206,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"清明日访胡师颜","author":"王庭圭","text":"门巷倚城郭，林亭占水云。\n竹摇碧玉玦，池皱绿罗纹。\n莺舌初调曲，兰芽忽吐芬。\n牡丹虽晚发，风味独超群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5207,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"入辰州界道中用頔子韵","author":"王庭圭","text":"路入荒溪恶，波穿乱石跳。\n骑驴行木杪，避水转山腰。\n倒挂猿当道，横过竹渡桥。\n吾生本如寄，岁晚尚飘飖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5208,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"忆馨鸿二孙","author":"王庭圭","text":"忆汝何时见，愁眉此日舒。\n别来三换岁，诵得几多书。\n字稍堪拈出，翁今喜有馀。\n阿鸿才弄笔，相对想轩渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5209,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题步云轩","author":"王庭圭","text":"身在飞烟里，如登霄汉行。\n云从脚下起，雷忽耳边鸣。\n暮碧佳人远，春红晚照明。\n能消几緉屐，当不负平生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5210,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题昭昭阁","author":"王庭圭","text":"天意岂难诉，云烟渺降真。\n倚栏瞻日月，满壁绘星辰。\n夜梵光生户，晨炊灶见神。\n高门有阴德，当不误儒身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5211,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和余教授","author":"王庭圭","text":"词高云蔼蔼，笔扫阵堂堂。\n妙绝江南社，清新乐府章。\n穷通元自乐，身世两相忘。\n不下千寻海，焉能得夜光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5212,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和胡观光闻蝉","author":"王庭圭","text":"地僻林逾静，山幽鸟不惊。\n日高帘影重，蝉噪柳阴轻。\n鬓学风前翼，琴传叶下声。\n士龙能作赋，为尔特留情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5213,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送李彦明","author":"王庭圭","text":"叔父今谁贵，中郎一世豪。\n渡江人物盛，容驷里门高。\n冠盖荣吾党，芝兰见汝曹。\n兹游兼问学，鼓箧莫辞劳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5214,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"江上","author":"王庭圭","text":"倚杖江风起，呼船水面开。\n人从州觜渡，帆破浪头来。\n月色共千里，天恩遍九垓。\n当年送客处，待看赤车回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5215,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送杨彦昭往湖南谒陈梦肇运使","author":"王庭圭","text":"结客少年日，同游碧水边。\n今持绣衣斧，就觅孝廉船。\n湖阔惊千里，云开有一天。\n莫嗟清绝地，不异泛红莲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5216,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谪辰州","author":"王庭圭","text":"得失真何事，文章妙入场。\n隐身三十载，汗简几千张。\n名落江湖外，气干牛斗傍。\n吾衰任飘泊，朝夕渡沅湘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5217,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"沅江上晚晴用頔子韵","author":"王庭圭","text":"急雨捎溪面，兰桡转渡头。\n寒鸦栖古木，晚日射危楼。\n山带黔巫远，水还荆汉流。\n晴天思无限，细细数沙鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5218,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵周秀实通判送段季裕还永新二首 其一","author":"王庭圭","text":"竹下忘年友，谁如藉与戎。\n相从知理窟，会见立奇功。\n两地风烟接，三吴水石穷。\n飘蓬岁事晚，何日一樽同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5219,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵周秀实通判送段季裕还永新二首 其二","author":"王庭圭","text":"州里闻名旧，江湖识面新。\n读书元自喜，拟古欲谁伦。\n岩穴人归隐，池塘草又春。\n周侯有佳句，持赠可娱亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5220,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"惜春亭席上和伍孺安酴醾","author":"王庭圭","text":"满眼伤春色，瑶花堕玉卮。\n群仙下来看，皎月自相随。\n国艳晚尤贵，天香发每迟。\n我方留客醉，帘捲未教垂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5221,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"同施倅游寿昌观","author":"王庭圭","text":"岸曲穿丛筱，山回转翠屏。\n烟云摇晚霁，楼殿倚空青。\n柏黛参天峻，松脂入地灵。\n幽寻未能及，重约扣岩扃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5222,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠惠门端师","author":"王庭圭","text":"劫火燋乡邑，烟尘何处逃。\n云藏佛世界，门背古亭皋。\n径隐花木静，山深人物高。\n老师具眼目，法力辟兵刀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5223,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"齐云阁","author":"王庭圭","text":"缥缈虚无里，嵯峨碧绕穹。\n云从断山起，楼在半天中。\n暮碧千峰雨，凉生四面风。\n更临风雨上，待看出丰隆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5224,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"清音亭","author":"王庭圭","text":"亭枕秋山窟，山明水共清。\n空林生逸响，飞溜落寒泓。\n谁识高深意，初无世俗情。\n何当携韵磬，泻此澹无声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5225,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵伍孺安赋草堂瑞香","author":"王庭圭","text":"草屋帘垂地，移花共宴游。\n艳姬香入骨，熏炷锦幪头。\n绝世方名立，残霞暮不收。\n夜声灯影乱，犹觉带娇羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5226,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"水亭","author":"王庭圭","text":"新暑池亭上，竹风吹我衣。\n残花经眼尽，好鸟傍檐飞。\n水面澄阴阔，橘林香气微。\n傥容携茗具，来此避炎威。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5227,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"遗经阁","author":"王庭圭","text":"殖财作争府，教子乃义方。\n斗起千寻阁，中藏万丈光。\n诸郎一受业，丹桂几回芳。\n他日石渠论，斯文想未亡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5228,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄黄平国正字","author":"王庭圭","text":"麟阁岧峣入紫清，官居真是上蓬瀛。\n玉壶风采想如旧，金马文章元有声。\n近喜边头新奏捷，独怜江外正拿兵。\n老夫饱饭无他虑，料理敲推怠未成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5229,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"陪周秀实通判游欧阳炳文园晚过隆庆寺契真亭","author":"王庭圭","text":"别驾前驱朱两轮，后车蓝缕载穷宾。\n开门叵复见此客，看竹何须问主人。\n坐久风云欲回薄，雨馀钟磬忽清新。\n隔墙便是城西寺，应有高僧住契真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5230,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和李巽伯少卿见怀","author":"王庭圭","text":"眼高四海意何如，敢谓论交到阔疏。\n春草梦池方得句，夜霜置酒复怀予。\n初披郇国五云字，何啻刘公一纸书。\n铜鼓遇时思发响，蜀椎须待刻桐鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5231,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵徐漕案部至庐陵见访","author":"王庭圭","text":"节拥朱轮下九霄，因从物外访英豪。\n江南正自贤徐稚，天子先应问伏滔。\n试看翰林批凤尾，何如大尉饮羊羔。\n诸公拔剑论功业，当念萧侯转粟劳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5232,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄程子山舍人","author":"王庭圭","text":"老泉仙翁骑列星，文采风流属此甥。\n凤阁初传舍人样，帝城新有能诗声。\n青萍出匣蛟兕吼，赤手捕蛇狐兔惊。\n愿扣洪钟识音响，暮年聊欲听铿鍧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5233,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过刘美中新居","author":"王庭圭","text":"乱碧峰头水拍堤，白沙寒竹净柴扉。\n晨光破雾千山出，绝壁盘云一雁飞。\n窗外烟霞舒锦绮，坐中谈笑落珠玑。\n江边野老逢人说，待看追锋入翠微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5234,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"陪元勃舍人秀实监丞游彻见阁","author":"王庭圭","text":"薰风拂晓度长堤，堤上双红捲使旗。\n楼影与天俱在水，岸沙经雨不成泥。\n他州半落青山外，别浦遥分翠浪低。\n渡口神螺谁复识，江空应只月明知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5235,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"登滕王阁二首 其一","author":"王庭圭","text":"翼轸南边第一州，滕王高阁枕江流。\n天提日月东南走，地辟山川昼夜浮。\n午后朱帘捲斜照，更深白水自明楼。\n当时帝子鸣銮后，歌舞重翻又几秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5236,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"登滕王阁二首 其二","author":"王庭圭","text":"滕王歌舞今千载，彷佛鸣銮度绮窗。\n尚有残霞伴孤鹜，时闻晚唱下长泷。\n危栏杰栋临无地，翠岭层阴落半江。\n欲咏朱帘捲山雨，含毫自觉寸心降。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5237,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠黄伯成","author":"王庭圭","text":"痛饮长斋拟八仙，醉中谈辩亦逃禅。\n吟诗不落正始后，作句定居灵运前。\n富贵逼人应未免，文章惊世始堪传。\n近闻相国频搜访，应有除书上九天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5238,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄贺刘美中舍人直学士院","author":"王庭圭","text":"明光清晓玉开关，脚踏金銮近侍班。\n行尽九重天上路，正临方丈海中山。\n紫薇阁对青霄近，红药花翻白日闲。\n待看飞龙催赐马，锦袍莲烛夜深还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5239,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"出城北由山径入彻源忽逢荷花弥望不知为何处询其地名曰长塘又行数里行大路出连岭作诗记之","author":"王庭圭","text":"山根细路绕长塘，忽有荷花照水光。\n误入孤村看青壁，却逢千盖拥红妆。\n采莲不见溪中女，缓辔徒牵马上郎。\n行傍绿堤将过尽，回鞭小住惜馀香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5240,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"长沙试殿闻傅彦济永州考试还先寄此诗","author":"王庭圭","text":"归马锵然响辔环，道傍春色正斓斑。\n吟登回雁峰头月，览遍清湘雨后山。\n剩有虹蜺蟠笔下，喜闻蝴蝶入帘间。\n花时独锁深深院，卧听笙箫梦里还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5241,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再次前韵","author":"王庭圭","text":"湘水清如碧玉环，湘妃泪染竹痕斑。\n此时游宦非高志，何日抱琴归故山。\n雁塔共题双阙际，马蹄同下五云间。\n今朝憔悴荆湖外，却望烟霄叹未还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5242,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春日山行","author":"王庭圭","text":"缓鞚青丝马不嘶，春山草长静柴扉。\n迸林新笋斑斑出，隔水幽禽款款飞。\n雨过泉声鸣岭背，日长花气扑人衣。\n云藏远岫茶烟起，知有僧居在翠微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5243,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"正月二十立春观雪次韵向文刚","author":"王庭圭","text":"雪拥东皇下紫虚，霓旌凤驭肃前驱。\n天将平地开银阙，人似春冰在玉壶。\n绿蚁飘香浮翠斝，青丝传菜出行厨。\n老农惯识丰年兆，正欠渔蓑入画图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5244,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再次前韵二首 其一","author":"王庭圭","text":"马上吟诗雪满须，垂鞭信马不须驱。\n病馀消渴浇茶枕，醉后狂歌打唾壶。\n坐见词锋森武库，还如禁脔出天厨。\n笔间能作有声画，似看辋川摩诘图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5245,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]