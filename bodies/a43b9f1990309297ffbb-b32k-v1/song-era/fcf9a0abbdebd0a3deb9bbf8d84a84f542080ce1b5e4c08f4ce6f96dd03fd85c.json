[{"title":"送文达甫赞善","author":"吕陶","text":"洪河一曲晋溪滨，自有馀波及四邻。\n循吏风声今慕昔，淡交情味故如新。\n江山极目登临远，岁月惊心聚散频。\n无限名园费吟赏，化工偏与洛阳春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43536,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和成都转运判官孙圣微见寄","author":"吕陶","text":"文章平昔擅才名，使指于今总列城。\n甲乙常联榜中第，东西俱作剑南行。\n清吟愈觉交朋厚，老别难堪岁月惊。\n惟喜归途近霄汉，吾乡留得是嘉声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43537,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和重己晚菊三首 其一","author":"吕陶","text":"众菊争开此独迟，已过重九见新枝。\n自甘化力均先后，不与春芳较盛衰。\n秀蕊渐繁微雨夜，清香终在早霜时。\n诗人未便移青眼，会有金樽是己知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43538,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和重己晚菊三首 其二","author":"吕陶","text":"花开虽晚莫嗟迟，落尽千葩发几枝。\n清露有恩殊未报，寒风无赖不能衰。\n幽芳自占三秋景，真赏堪同九日时。\n蝶少蜂愁人事别，餐英独有屈平知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43539,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和重己晚菊三首 其三","author":"吕陶","text":"仙翁培种一何迟，点缀黄金更满枝。\n秋色已高方秀茂，物华皆老未凋衰。\n几多俗客慵留意，无限妖花笑后时。\n独向风霜对松竹，洁清标格自相知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43540,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻说一首寄与可为尧夫作","author":"吕陶","text":"闻说蓬仙作小麾，湛恩从此破群疑。\n平生直道宜三黜，自古周防用四知。\n松竹何尝凋晚秀，稻梁应且续朝饥。\n不须利口归豺虎，皎皎清穹未易欺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43541,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵赠陈季常","author":"吕陶","text":"一尘殊不挂胸中，标韵高閒辩论雄。\n诗得江山深有助，道因橐籥易为功。\n平生拟效漆园吏，何日相逢黄石公。\n可惜壮年长策在，却陪明月与清风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43542,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"伏日池上二首 其一","author":"吕陶","text":"尘氛不到此池亭，庚伏长来驻旆旌。\n波荡画船冲岸急，露明翠盖遇风倾。\n一先有得棋频胜，众乐无嫌酒屡行。\n红日渐低钟鼓近，路人歌笑望专城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43543,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"伏日池上二首 其二","author":"吕陶","text":"南风时起有馀温，晷影炎炎势欲焚。\n堤上游人皆乐俗，坐中豪客少将军。\n深思阔沼生冰色，尤畏晴霞散锦纹。\n待得清凉到襟袖，断烟重叠送西曛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43544,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题致仕袁成均燕申亭","author":"吕陶","text":"挂冠归后爱林泉，择地为亭欲看山。\n清画绝无尘坌到，白云常与性情閒。\n诗书教子雍容外，琴酒娱宾笑傲间。\n堂构不隳门有庆，綵衣终约锦衣还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43545,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送李宝之","author":"吕陶","text":"流落文场晚得名，十年犹未脱铨衡。\n轩昂本为太平起，愤叹却因多难成。\n方略满怀期树立，尘埃蒙袂且将迎。\n由来不遇须藏器，岂是佯愚学宁生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43546,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送修孺归通泉用陈图南韵","author":"吕陶","text":"猿鹤皆飞昔日声，安车归去路岐平。\n高怀无累能知止，半禄虽微亦代耕。\n林下光阴尤觉永，环中气象有馀清。\n尘埃满抱华颠客，笑指泉山羡此行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43547,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵送人有感","author":"吕陶","text":"三月山城送客时，山头芳草又离离。\n红尘道路今犹古，清酒樽罍乐胜悲。\n乡外忽摇怀远意，坐中聊赋惜春诗。\n洛阳风景别来久，应属少年游侠儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43548,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送交代茹安礼二首 其一","author":"吕陶","text":"平日阳和已浃民，浪驰幽迹绍芳尘。\n芝兰秀品推前辈，桃李清阴及后人。\n谆诲有闻知契厚，纵谈无间觉情亲。\n去思从此凭何慰，待刻铭词上翠珉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43549,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送交代茹安礼二首 其二","author":"吕陶","text":"越溪春水碧迢迢，岷岫晴岚翠欲飘。\n故国风光频梦断，殊乡景物易魂销。\n何时执友无暌索，此日长亭倍寂寥。\n把酒送君同一醉，羡君东去客心摇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43550,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送曹宪州","author":"吕陶","text":"山头红日照红旌，祖席仍歌塞上行。\n慷慨有心终破敌，燕閒无事暂专城。\n朔风动色骅骝健，秋水澄光宝剑轻。\n万一羽书飞到郡，定烦方略取功名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43551,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送范庠博","author":"吕陶","text":"十载閒经紫塞秋，辟书连上得君留。\n一身已共冰壶洁，八法堪同墨宝收。\n寿几欢心怜綵服，诗庭虚席待良筹。\n古今京洛风埃甚，去有亨途莫倦游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43552,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和送李大夫","author":"吕陶","text":"莫听滩前涨水声，少迟樽酒话平生。\n堪嘉祁老初辞位，却笑樊须欲问耕。\n落日望君三舍远，西风惠我一襟清。\n江流自在悠哉兴，得得回船十里行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43553,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送永康司理张思纯东归","author":"吕陶","text":"曾把丛蓍叩大钧，少逢升渐屡逢屯。\n平生道在惟藏器，今日途穷耻问津。\n万事感怀归白发，九衢欺客是红尘。\n何须便作林泉计，未必文章误此身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43554,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送秭归胡宜甫","author":"吕陶","text":"京洛前年困客尘，孤舟今去楚江滨。\n位无高下在行己，邑有政刑宜福民。\n人子欢心怜白发，壮夫幽抱感青春。\n弦歌已治庭闱乐，休说穷通问大钧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43555,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送淳于温其","author":"吕陶","text":"五陵豪客揽归鞍，行矣休嗟蜀道难。\n世治不须专将阃，才雄自可陟诗坛。\n虎符金印亨途在，夜笛秋琴逸气安。\n至宝投人犹按剑，慎将骚雅载毫端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43556,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送道粹","author":"吕陶","text":"泛交如面颇纷纷，珍重贤豪有所存。\n高论向人须药石，壮心于俗不寒温。\n已怀忠孝归儒术，誓取功勋袭将门。\n蜀道阻长秦塞阔，夕阳芳草最销魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43557,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大享肆赦府帅赋诗次其韵","author":"吕陶","text":"运际重熙讲克禋，祖宗严配答慈仁。\n典章备物该三代，殿宝殊名应五辰。\n早岁侍祠曾受嘏，外方留镇屡颁春。\n皇恩更远皆宣布，自此祥风起八垠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43558,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答文通即席见及","author":"吕陶","text":"春华秾处客心阑，俗事劳劳近万端。\n嘉景良朋岂常遇，清诗浊酒暂相欢。\n飘零宦况诚非欲，烜赫名途未易干。\n惜别恋游深意在，寄声弦上约谁弹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43559,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"喜文通西归","author":"吕陶","text":"每记江头举别觞，别来如昨几炎凉。\n年华莫问当时水，鬓发皆添近日霜。\n伏枥已甘常蹭蹬，凌云犹滞远翱翔。\n羡君标韵终萧洒，恰是花开到故乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43560,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"喻明仲自成都宪使领漕湖北","author":"吕陶","text":"荆楚旬宣盛事誇，十年重复赋皇华。\n更弦已见调疏越，切玉犹须试镆铘。\n随手春风飘塞下，回头膏雨润天涯。\n亲闻父老慇勤说，沟壑沾恩数百家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43561,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄眉守黎希声","author":"吕陶","text":"千骑骎骎出锦城，乡人翘首望先生。\n二年为郡应须乐，数日游山已快晴。\n泉石有谁陪道话，云霞无限惬诗情。\n红尘拂袂良朋少，时向西风愿寄声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43562,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送戴正仲大夫归玉局","author":"吕陶","text":"请得琳宫别未央，西行行色重增光。\n官曹冷淡如逋客，风物鲜明类故乡。\n归去林泉谋已定，閒中诗酒味偏长。\n市桥侧畔邻居日，应许过从亦道装。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43563,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送陈正臣游昌元","author":"吕陶","text":"三月狂风不惜春，客愁千斛付行人。\n平生操履由吾道，何日安閒遂此身。\n陌上纷华空白昼，山中气味少红尘。\n归来必遇求贤诏，莫向穷途苦问津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43564,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答赵宾与同年见寄","author":"吕陶","text":"羡君方寸最澄清，何必沧浪更濯缨。\n玉麈纵谈聊入幕，锦衣归养自专城。\n交情久似乔松茂，诗兴浓如皎月明。\n阅味来章佩勤好，却惭尘耳听咸茎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43565,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和子瞻寄希声二首 其一","author":"吕陶","text":"通江山水甲岷川，和气融融满四边。\n儒者易成千里政，乡人近得两重天。\n金罍浅饮虽歌舞，玉麈高谈尽圣贤。\n不是春秋为冷学，借留何计及三年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43566,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和子瞻寄希声二首 其二","author":"吕陶","text":"海势茫茫会百川，一麾正在海西边。\n鸿收迅翮方栖渚，鹤吐清音自彻天。\n落笔尽降诗里将，放怀常对酒中贤。\n及锋急用应非晚，留滞红尘已数年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43567,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和信夫屯田疾间偶作二首 其一","author":"吕陶","text":"安居无事莫兴嗟，聊放高情喜溢涯。\n揽照不惊头染雪，读书未信眼生花。\n讴吟罢后诗筒减，方论搜来药剂加。\n见说道心从此壮，几因清梦到仙家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43568,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和信夫屯田疾间偶作二首 其二","author":"吕陶","text":"仕路浮沈不足嗟，到头何处是津涯。\n庭中度日多无事，湖上经年各有花。\n熟焙春芽香不散，轻澄腊醑味偏加。\n凭君莫赋思归引，一郡相欢似一家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43569,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和王霁太博见寄","author":"吕陶","text":"惜别心情彼此难，想君归去自能安。\n轻舟荡桨依平岸，快水流冰下险滩。\n梦到亲闻方岁晚，路迎江国少春寒。\n牡丹时节西园醉，不得相同一倚阑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43570,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送皇甫秉彝殿丞","author":"吕陶","text":"征车千里极关河，特遣离怀赋绿波。\n晚节不随华发变，归装还载异书多。\n云霄有约增攀望，文酒相逢异啸歌。\n若相清朝许投笔，生平孤剑愿重磨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43571,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戢武堂书事和韵","author":"吕陶","text":"永日华堂静掩扉，道腴深味敌珍肥。\n一轩有景诗求胜，十邑无尘寇慑威。\n雅性自高閒去乐，汎交难合信来稀。\n诵君清句知君意，祗任天真不任机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43572,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和董奉议喜雨","author":"吕陶","text":"需云廿泽为时来，间作雄风鼓迅雷。\n信有威灵周阖境，应无偏党限枯荄。\n满山和气卷舒易，一夜丰年消息回。\n愆亢霖霪皆吏责，幸凭神力庇凡材。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43573,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"提举道祖监丞爱灵隐泉之景因广其地可置坐席赋诗见贶极有雅味次韵奉谢","author":"吕陶","text":"巘溜涓涓在目前，更开馀地助宾筵。\n方池可鉴无深浅，樽酒相逢有圣贤。\n每为野情贪胜概，暂凭清味涤尘缘。\n何时学得琴书趣，一写林间石上泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43574,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登兜率寺阁次薛道祖韵","author":"吕陶","text":"乘閒极望兴悠哉，远眼宜于此处开。\n危磴直穿修竹径，虚窗深占白云堆。\n江湖有景侵平野，栋宇何年倚巨材。\n自是登高乃能赋，谁嗟古往与今来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43575,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"道祖访赵太宾旧居惜其荒毁慨然赋诗有怀贤念往之深意次韵","author":"吕陶","text":"经济书成秘府收，依然蓬荜在岩丘。\n凄凉往事慵开卷，想像高风合倚楼。\n山色无言终日见，泉声有恨为谁留。\n怀贤访古閒中味，宜与诗人作胜游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43576,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"道祖示及远祖刻像及唱和佳什次韵","author":"吕陶","text":"山深县古蜀江滨，往哲声华尚未湮。\n物外低昂应绝品，榜间廋硬亦通神。\n名称三凤古为瑞，书仿二家今有人。\n首唱继酬皆盛事，通泉从此识阳春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43577,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清风阁晚景","author":"吕陶","text":"晚际閒将景物看，郡人休笑苦凭阑。\n远山露色知晨霁，素月笼光报夜寒。\n野烧顺风穿绝顶，渔舟随浪转长滩。\n故乡回首七百里，归去不辞行路难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43578,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"伏承原伯安抚侍郎为江雨所阻未即会见远寄雅章深叙勤眷次韵奉答","author":"吕陶","text":"凭高日日望交游，方寸飘如一叶舟。\n文酒相从期赋咏，江山何事尚迟留。\n洲中橘熟辉晴昼，潭上花繁送暮秋。\n南路士民应有语，旌麾早晚到吾州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43579,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和寄景仁致政侍郎","author":"吕陶","text":"文章道德有源流，进退潇然信自由。\n身在禁林方倚望，年侵老景便归休。\n素云收雨还层岫，劲柏凌霜茂晚秋。\n何日家山纵吟赏，閒中情味更优游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43580,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"榴花","author":"吕陶","text":"十分红色占亭台，不恨春风不许开。\n摺叠染成随日丽，芳菲过后为时来。\n赋诗多是题千叶，酿酒谁能饮百杯。\n翠萼丹须无计学，佳人屡把绛纱裁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43581,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"残叶和韵","author":"吕陶","text":"秋光何事易陵侵，不许芳条展茂阴。\n晓色向风生别意，夜声随雨入愁吟。\n已嗟禽鸟幽栖浅，渐失园林几处深。\n荣谢循环都物理，肯将零落动予心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43582,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和礼部孔经甫斋宫三首 其一","author":"吕陶","text":"试思离合数光阴，日月消磨世累侵。\n晚岁心怀如止水，旧交情分敌兼金。\n相从不厌春坛远，共语谁知夜漏深。\n频阅来书谕勤意，愧无青玉报璆琳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43583,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和礼部孔经甫斋宫三首 其二","author":"吕陶","text":"读书到老应成癖，了事他人莫笑痴。\n敲印旧曹烦夜直，看花新句感春熙。\n已闻骐骥腾千里，应许鹪鹩附一枝。\n荐牍屡交虚席久，埙篪应喜共君吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43584,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和礼部孔经甫斋宫三首 其三","author":"吕陶","text":"尝驰别乘走龙沙，过尽春寒始到家。\n已置功名如外物，只凭诗酒作生涯。\n回头忽上青云路，洗眼重看紫禁花。\n百日丝纶君定掌，文章从此灿朝霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43585,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"瑞圣园斋宫","author":"吕陶","text":"苑钥重开不禁阑，眼前芳景未凋残。\n仙花笑日欲争媚，禁柳受风疑怯寒。\n诗兴似春多丽藻，斋心如水自澄澜。\n凭君赋尽园中景，免向绡图指点看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43586,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"致斋北园因记旧游书呈经甫","author":"吕陶","text":"斋馆深沈旧苑开，尝从祀事偶参陪。\n故人已步青云去，倦客还寻紫陌来。\n清景暂将尘虑涤，流年长恨物华催。\n唱酬不讲诗情懒，独对风光彊剪裁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43587,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与台中同饮答谏院王明叟","author":"吕陶","text":"休沐无多款聚难，暂留佳客解朝冠。\n虾头泛酒樽前乐，麈尾生风席上寒。\n陪集敢誇言路盛，诙谐渐觉醉乡宽。\n敲门又报青蒲信，捧得新诗似执桓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43588,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和","author":"吕陶","text":"温风一袖己董然，燕坐何须更整冠。\n沈李杯盘聊避暑，饮冰怀抱暂生寒。\n纵谈无间情相照，清句难酬韵不宽。\n莫笑未曛车马散，尝闻陈仲讽齐桓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43589,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同文馆诸君游金明池","author":"吕陶","text":"春风拂拂动轻阴，四望欢声杂雅音。\n人在华胥无限乐，路经蓬岛几重深。\n潜鳞可羡游灵沼，巧舌时闻转上林。\n况有赐樽堪一醉，百愁从此定消沈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43590,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和观瑞圣宫殿有感","author":"吕陶","text":"属车何日泛尘清，旧苑沈沈隔禁城。\n别殿未闻天跸响，华封常听宝鸾声。\n禽鱼欲遂灵台乐，燕雀终期大厦成。\n敢告冬官举常职，莫将池籞等閒轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43591,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵芸叟燕琼林苑","author":"吕陶","text":"御水休论九曲池，宫花争发万年枝。\n长虹驾浪人间去，大翼乘风海际垂。\n均被上恩容燕集，共怜嘉景事游嬉。\n愿公早献金明赋，纪述吾朝全盛时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43592,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和芸叟左司被资治通鉴之赐感事赋诗","author":"吕陶","text":"庙席词林一二臣，校雠撰述体惟均。\n圣心欲以古为鉴，史法有如王次春。\n神武略中书事类，天和览后得名新。\n羡君受此传家宝，遗与儿孙似昔人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43593,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和彦常舍人元夕扈从二首 其一","author":"吕陶","text":"东风将暖不鸣条，霁景曈曈薄雾销。\n五队绣衣华广陌，一声天跸振层霄。\n清尘少拂鸾旗动，紫气长随凤盖飘。\n向晚都人相与语，更誇明日似今朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43594,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和彦常舍人元夕扈从二首 其二","author":"吕陶","text":"羽卫森然翠辇平，仰瞻天步出西清。\n月行青道夜如昼，春入皇州花满城。\n三五良辰传盛观，九重归路沸欢声。\n君王已向龙楼望，喜奉慈颜酒数行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43595,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"己卯冬至后","author":"吕陶","text":"月律潜萌斗柄移，阳和气象等闲知。\n五云已验天心顺，一刻先添日脚迟。\n燕雁待时思北向，岭梅乘暖发南枝。\n人人尽有春台兴，料得东风不失期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43596,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵答何爽监簿二首 其一","author":"吕陶","text":"十年勤苦学诗骚，拟向篇章运短毫。\n废井心情伤汲绠，沈舟气象怯惊涛。\n参谋可法无如杜，常侍难攀独有高。\n自是土风忘不得，南音莫讶楚囚操。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43597,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵答何爽监簿二首 其二","author":"吕陶","text":"清才何事爱清吟，从古诗人误此心。\n按剑莫投随氏宝，骑驴难和有虞琴。\n赋成物外云无著，搜到天涯海不深。\n自顾巴词终鄙俚，愿从邻友听纯音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43598,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]