[{"title":"句","author":"王百朋","text":"诗书满肠腹，应笑带经人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19029,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"怀王龟龄","author":"姜大吕","text":"左原消息杳无闻，令我愁怀似乱云。\n多病废诗兼废酒，青春孤我亦孤君。\n要同学问文章乐，无奈东西南北分。\n况是一檐残雨后，落花飞絮两纷纷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19030,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句","author":"万椿","text":"剩栽桑柘教妻蚕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19031,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句","author":"李元翁","text":"玉华野人多病恼，独守寒炉煨芋魁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19032,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句","author":"越州幕僚","text":"莲幕风清不受梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19033,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句","author":"陈商霖","text":"生死交情谁念旧，炎凉世态竞迎新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19034,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"登历下古城员外新亭二首 其一","author":"王秬","text":"新亭结构罢，隐见清湖阴。\n迹籍台观旧，气溟海岳深。\n圆荷想自昔，遗堞感至今。\n芳宴此时具，哀丝千古心。\n主称寿尊客，筵秩宴北林。\n不阻蓬荜兴，得兼梁甫吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19035,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"登历下古城员外新亭二首 其二","author":"王秬","text":"吾宗固神秀，体物写谋长。\n形制开古迹，曾冰延乐方。\n太山雄地理，巨壑眇云庄。\n高兴泊烦促，永怀清典常。\n含弘知四大，出入见三光。\n负郭喜粳稻，安时歌吉祥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19036,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂九首 其七","author":"释玿","text":"与么文彩，甚生标格。\n直下承当，迥超言默。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19037,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈三首 其一","author":"释行机","text":"地炉无火客囊空，雪似杨花落岁穷。\n拾得断麻穿坏衲，不知身在寂寥中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19038,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游虎丘岩偶题壁韵叶因分字联句","author":"陈俊卿","text":"无正文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19039,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和虞智父登金陵清溪阁","author":"徐珩","text":"叶脱林梢处处秋，壮怀易感更登楼。\n日斜钟阜烟凝碧，霜落秦淮水慢流。\n人似仲宣思故国，诗如杜老到夔州。\n十年前作金陵梦，重抚栏干说旧游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19040,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"日暮望泾水","author":"徐珩","text":"导源经陇阪，属汭贯嬴都。\n下濑波常急，回圻溜亦纡。\n毒流秦卒毙，泥粪汉田腴。\n独有迷津客，怀归轸暮途。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19041,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夜听双瀑联句","author":"刘镇","text":"萧然山阁间，此兴何悠哉。\n子晋不复见，月白空萧台。\n夜静双瀑喧，遥闻疑雨来。\n涧壑生清风，襟宇捐纤埃。\n飞鸣撼半空，暗想飘琼瑰。\n前观阻步屧，侧耳成徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19042,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"对月联句","author":"刘镇","text":"与君坐阶除，遥望海上月。\n试举太白杯，借问几圆缺。\n人生易分散，动作隔年别。\n今宵对婵娟，莫放酣歌绝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19043,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"喜雨偈 其二","author":"释了思","text":"救旱无方种种求，老龙谁识隐岩湫。\n茅山居士兴慈愿，一叱风云四百州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19044,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"喜雨偈 其三","author":"释了思","text":"衲子相逢竞喜忻，应期甘雨一番新。\n了知润物无穷意，祇在维摩此念真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19045,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"喜雨诗 其一","author":"张昭远","text":"试将丹恳□青霄，还话田畴万里焦。\n不是湫龙解兴雨，元来滴滴自心苗。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19046,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"天台道中 其二","author":"林宪","text":"骄云压长郊，飞电见林嵨。\n震霆挟回风，捲海过白雨。\n东皇发生意，万物情可睹。\n门外小草色，嫩绿亦轩舞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19047,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂三十首 其五","author":"释印肃","text":"稽首摩耶大肚皮，无忧树下手攀枝。\n母子至今无觅处，落花啼鸟示全机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19048,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"百宝光明","author":"释印肃","text":"青黄赤白异尘寰，知音希得似寒山。\n丰干未辨争饶舌，光明不遍道应难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19049,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"證道歌 其一二六","author":"释印肃","text":"取舍之心成巧伪，夜枕髑髅浑说寐。\n与他南面乐非轻，不知自己无心地。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19050,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"證道歌 其一六○","author":"释印肃","text":"不可得中祇么得，更无魔党相欺嚇。\n狂怖自歇即菩提，真净妙明无间隔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19051,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"资深和光求颂","author":"释印肃","text":"同心实步叩南泉，云节空岩廓杳然。\n一室清风千古意，自非声色问玄玄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19052,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"重阳日颂","author":"释印肃","text":"去岁逢重九，风流主得宾。\n黄花谈般若，白法乐天真。\n今夕当良会，高峰没四邻。\n孤筇挑日月，何道不通津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19053,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"忆旧游 其二","author":"许必胜","text":"孤桐饱秋风，响作霜天鸿。\n手翻九嶷色，下堕潇湘中。\n谁言一寸路，不成西与东。\n谁言少年时，不成衰老翁。\n欲使胶漆意，通君山水衷。\n尝恐金石奏，复为郑卫工。\n所悲百年内，徒然羡华嵩。\n华嵩有终极，愁泪终难穷。\n愁泪一入地，春风无碧丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19054,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夜听双瀑联句","author":"毛宏","text":"夜静双瀑喧，遥闻疑雨来。\n润壑生清风，襟宇捐纤埃。\n飞鸣撼半空，暗想飘琼瑰。\n前观阻步屧，侧耳成徘徊。\n萧然山馆间，此兴何悠哉。\n子晋不复见，月白空箫台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19055,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"不欺堂","author":"苏邦","text":"室明室暗两相宜，方寸长存不可欺。\n勿谓天高鬼神远，要须常畏自家知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19056,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山鸡送范元通","author":"王灼","text":"无正文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19057,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"又和 其四","author":"王灼","text":"从军思上策，直谏赴贤科。\n抗志吾何敢，收功众孰多。\n清诗无竞病，小令有来罗。\n今日奇寒甚，明窗试偃波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19058,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"答李知几","author":"王灼","text":"无正文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19059,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"前五日赋重九","author":"邓深","text":"侵寻重九雨馀秋，采菊登高事事幽。\n偶尔见山忘日夕，颓然落帽自风流。\n二三日外追清赏，千百年间继旧游。\n烂漫赋诗兼酩酊，不然嘉节若为酬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19060,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古三十八首 其三","author":"释从瑾","text":"隔墙见角便骑牛，骑入红尘闹市游。\n游遍归来栏里卧，三更半夜失踪由。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19061,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟古十三首 其一 行行重行行","author":"洪适","text":"行行重行行，南北各倦游。\n昔人重别离，一日嗟三秋。\n如何三秋暮，相见尚悠悠。\n方寸正纡轸，何以写我忧。\n仰瞻衡汉移，俯对兰菊遂。\n臭味虽云同，光尘若为异。\n回风凄且发，飘我别时袂。\n欲知长相思，披衣不胜体。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19062,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟古十三首 其二 青青河畔草","author":"洪适","text":"青青河畔草，英英篱边菊。\n雅雅当窗女，濯濯手如玉。\n渊渊锦中意，粲粲未盈幅。\n藁砧天一涯，刀头误行卜。\n却鉴怨新眉，谁教远山绿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19063,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟古十三首 其三 青青陵上柏","author":"洪适","text":"青青陵上柏，橚橚庭中竹。\n人寿能几何，譬彼电过目。\n一觞命昵交，且以慰心曲。\n驾言长安游，川光晨可掬。\n神州何赫戏，高城矗延属。\n峣榭干星斗，彫栭错珠玉。\n鳞鳞王公第，华缨夹绣毂。\n放怀恣槃虞，端忧竟谁逐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19064,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟古十三首 其四 今日良宴会","author":"洪适","text":"今日良宴会，朋簪故人家。\n摇情绿绮琴，度曲渔阳挝。\n放歌掀醉髯，晤语粲春葩。\n列坐各知心，游扬相齿牙。\n芬芳须及时，东扶忽西斜。\n胡不厉逸翮，天津问仙槎。\n无为甘寂漠，痼疾守烟霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19065,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟古十三首 其五 西北有高楼","author":"洪适","text":"西北有高楼，偃蹇轶千门。\n绮栊纳飞月，璧珰碍翔云。\n上有弦歌女，哀声启莺唇。\n谁能为此曲，无乃返香人。\n一章三致志，脩蛾有馀颦。\n不惜饶清响，暗惊梁上尘。\n所悲听者心，中无泾渭分。\n愿作南冥鸟，夕饮玉池津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19066,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟古十三首 其六 涉江采芙蓉","author":"洪适","text":"涉江采芙蓉，芳蕤荫幽沚。\n相思不相见，芬香欲谁遗。\n秋容感人心，浪浪睫涵泪。\n不如膝上琴，哀音入君耳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19067,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟古十三首 其七 明月皎夜光","author":"洪适","text":"明月皎夜光，瑟瑟扇商籁。\n衡纪直西躔，云章斜左界。\n感彼林薄凋，岁律倏云迈。\n蜻蛚谁汝怜，悽悽鸣户外。\n昔我耐久朋，著鞭道方泰。\n尉藉缯缟轻，金兰旧盟改。\n东井不及泉，须女无俦配。\n君看贡公綦，白头愧倾盖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19068,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟古十三首 其八 冉冉孤生竹","author":"洪适","text":"冉冉孤生竹，成阴幽谷中。\n聿来君子室，葛藟施乔松。\n乔松千百寻，攀附犹可穷。\n思君江水深，褰裳难往从。\n同心而偏栖，愧彼摩霄鸿。\n灼灼芙蓉花，凌波媚芳风。\n非不努力爱，秋至无归鸿。\n昔盟傥不寒，谁叹久西东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19069,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟古十三首 其九 庭前有奇树","author":"洪适","text":"庭前有奇树，黄鸟巢其枝。\n之子不顾返，失此熙春期。\n采采未盈掬，夕风已纷披。\n路远怅莫致，虽多亦奚为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19070,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟古十三首 其十 迢迢牵牛星","author":"洪适","text":"迢迢牵牛星，奕奕停梭女。\n寻盟整瑶辔，缄情遵汉渚。\n欣宴未斯须，别愁眉已度。\n黄月不我留，残机忍重顾。\n翻羡巫山云，朝朝楚王遇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19071,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟古十三首 其十一 人生不满百","author":"洪适","text":"人生不满百，蟪蛄等春秋。\n花月多风雨，何不蜡屐游。\n朱光忽以驰，退舍未易留。\n生前一杯乐，难与昧者谋。\n临流羡芳沚，欢言泛轻舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19072,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟古十三首 其十二 孟冬寒气至","author":"洪适","text":"孟冬寒气至，冲风一何厉。\n宿楚失故阴，思虫柱哀喙。\n客来门冬冬，袖有尺书遗。\n一读泪先零，再读心已醉。\n妾如初开花，君如长流水。\n花挽水回难，水捐花去易。\n流水何时休，春荣难久恃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19073,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟古十三首 其十三 明月何皎皎","author":"洪适","text":"明月何皎皎，舒光瑩窗绮。\n宛转羞空床，披轩步庭际。\n故爱同一心，新愁今两耳。\n咫尺相会难，迢迢若千里。\n况复千里隔，忧端无穷已。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19074,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谢洪庆善提刑遗法帖","author":"洪适","text":"纷纷渴骥竞秋蛇，镌镵收拾俱名家。\n吾宗尺牍擅天下，年来野鹜谁肩差。\n庭前书带凝寒绿，架上牙签富新轴。\n中藏墨妙更奇奇，长物不留沾剩馥。\n生平小楷拘蝇头，岂知虿尾与银钩。\n从今已办笔成冢，学奇还许登门不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19075,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春思","author":"洪适","text":"自闻郊外景，多病负年光。\n沐雨桃容腻，耽春蝶兴狂。\n幽期知我背，迟日为谁长。\n一枕虚窗寂，炉烟续旧香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19076,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"晚望","author":"洪适","text":"古堞高亭暮，登临远眺时。\n菊房栖渥露，荷盖偃清漪。\n遵渚归鸿集，投林啸狖悲。\n关情聊绘句，独立自迟迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19077,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"欲雨","author":"洪适","text":"雨意泄琴床，桃笙骤觉凉。\n冲飙方贾勇，藻景荐韬光。\n去室怜鸠妇，封闾看蚁王。\n青灯可吾伴，黄卷任更长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19078,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"客至","author":"洪适","text":"闭关听剥啄，有客款蓬蒿。\n谭垒万人敌，词源八月涛。\n园蔬供菜甲，盘实饾桃毛。\n冷淡琴书味，由来属我曹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19079,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋怀二首 其一","author":"洪适","text":"送喜得新凉，秋情未憖忘。\n弱枝红皱重，平野碧滋长。\n林迥蝉初乱，篱疏菊自芳。\n吟成转萧瑟，径醉任苍苍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19080,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋怀二首 其二","author":"洪适","text":"愁绪苦萦人，寒螀殆叵闻。\n瓜畴残蔓去，兰畹秀蕤薰。\n远水涵秋态，馀霞冠夕曛。\n扬扬今夜月，独与广庭分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19081,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送人之姑苏","author":"洪适","text":"吴门千里役，别话不堪闻。\n暂发参商叹，长怀星斗文。\n菊丛黄彩乱，槐路绿行分。\n日冀书邮至，冥鸿接暮云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19082,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送吴傅朋知盱眙","author":"洪适","text":"龟山其下古淮濡，上驷骎骎稳著鞭。\n千里八年闻皂盖，九重一旦下青毡。\n名郎他日曾趋禁，静镇今朝叠典边。\n簪笔侍书公雅意，薰风殿阁待诚悬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19083,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"方福州生日行","author":"洪适","text":"雪峰高高雪如许，海门潮生浪吞浦。\n郎罢携囝街西东，到处欢然闻好语。\n旧日大官多养高，民词狱寄充官曹。\n横行阡陌喧夜鼓，唯征关市析秋豪。\n只今事事无长蠹，五月政成歌召父。\n尺一方来问凤仪，魁三快刷联鸳羽。\n三山岌嶪摩曾空，便是方丈蓬瀛中。\n他年图画凌烟了，却向山中访赤松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19084,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谢唐守送朱樱二绝句 其一","author":"洪适","text":"铃斋一树滴阶春，翻走髹盘赠野人。\n欲进曲生呼伯雅，却无樊素启丹唇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19085,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谢唐守送朱樱二绝句 其二","author":"洪适","text":"乳酪醍醐僻郡无，多酸梅子岂吾徒。\n香擎翠笼青冥出，旧事从谁说上都。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19086,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"答林神童","author":"洪适","text":"快睹终童英妙时，跫然衔袖出明玑。\n家声不诧大哉问，文律何愁知者希。\n益利锋铓临大敌，养成羽翼看高飞。\n红尘可厌忙车马，挹取西山爽气归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19087,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"海棠花二绝句 其一","author":"洪适","text":"雨濯吴妆腻，风催蜀锦裁。\n自嫌生较晚，不得聘寒梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19088,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"海棠花二绝句 其二","author":"洪适","text":"鸭壳非难致，鲛胎业已成。\n夜深宁觅睡，相照月偏明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19089,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"瑞香花","author":"洪适","text":"衮衮香毬次第开，结根幽独谢纷埃。\n芳蓉妒入鸳鸯社，异馥清传锦绣堆。\n睡里魂交非自衍，醒时心赏可无猜。\n品题盍在春林石，不是花王喜后来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19090,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题信州吴傅朋郎中游丝书","author":"洪适","text":"上饶氓俗醇且古，千室鸣弦方按堵。\n黄堂丈人今循良，河南治平追鼻祖。\n讼棠留景分清阴，炉篆方羊燕寝深。\n笑谈了却邦人事，游戏翰墨惟书林。\n自从真行易篆隶，草圣书绝驰极挚。\n游云惊龙初振奇，渴骥怒猊争作势。\n臣中第一兹谓谁，寥寥典则其几希。\n丈人尺牍妙天下，臧去收拾生光辉。\n作古要须从我始，直欲名家自成体。\n手追心摹前无人，一扫尘踪有新意。\n纵横经纬生胸中，落纸便与游丝同。\n缲瓮茧车飞白雪，织檐蛛网破清风。\n一行一笔相联属，姿态规抚骇凡目。\n临池漫劳三十年，千兔从教后人秃。\n旧闻吕向连锦书，百字环写萦发如。\n惜哉淟汩已无考，盍使北面称台舆。\n独步不复名相甲，端恨二王无此法。\n只今四海书同文，使者来求至将押。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19091,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪诗用晁无咎韵","author":"洪适","text":"密雪舞冬昼，祁寒反夏炎。\n竹枝低未湿，梅萼瑩先沾。\n怯冷昂肩立，欣繁矫首瞻。\n随风方北渡，际海必东渐。\n轩簸来如掺，缤纷势转严。\n枯荄新点缀，曲砌巧增添。\n伺隙花穿户，承隅箸插檐。\n高飞迷皎鹤，夜影逼清蟾。\n砧净绡横石，窗虚粉杂奁。\n昆丘千璧碎，武库五兵铦。\n烟径杨吹絮，香蹊蝶奋髯。\n鲸鲵陆骨腐，鹄鹭野翎爓。\n白发秦人遁，厖眉汉尉潜。\n渍蚕功孰及，平地瑞初占。\n窖卧行人节，门扃志士恬。\n已甘穿履困，奚避割毡嫌。\n醉慕双螯毕，寒怀五绔廉。\n飘飖疑宓女，刻画谢无盐。\n河阔凝新浪，峰高失旧尖。\n山阴宾欲返，淮右寇将歼。\n穆满三章著，宣温五板兼。\n君恩捐卫粟，天意绝齐痁。\n江上蓑堪画，篱间氅可觇。\n客观眸已眩，儿咀手频拈。\n足没寻萱屐，腰闲刈藿镰。\n马驰毛愈素，乌啄首难黔。\n冻折骚人笔，光临织妇幨。\n螟牟宁待火，疫疠讵烦砭。\n甲长寒蔬细，根肥宿麦纤。\n年丰虽欲颂，神助愧江淹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19092,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]