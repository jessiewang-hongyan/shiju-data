[{"title":"出郊","author":"李流谦","text":"颇爱晚凉出，适当秋霁初。\n丰年田父语，乔木野人庐。\n畦稻根根直，池荷叶叶疏。\n冷官无事业，归舍了残书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62703,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"平都山二首 其二","author":"李流谦","text":"福地何萧爽，真祠自杳冥。\n栋梁传曩昔，草木带仙灵。\n雾市朝仍合，云扉夜不扃。\n天风吹玉磬，应是诵黄庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62704,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"平都山二首 其一","author":"李流谦","text":"慇勤雪色鹿，报我上空濛。\n老鹤三山客，苍松百岁翁。\n洞云浮地出，池水与江通。\n仙榼无多酌，逡巡两颊红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62705,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用宇文龙图韵赠龙华印老","author":"李流谦","text":"少年一口吸西江，圣处端能走季咸。\n净观清泠横一水，远怀孤秀揖千岩。\n溪云卧久看频度，山日谈馀讶半衔。\n便欲瘦筇来问讯，上方应恐隔仙凡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62706,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用前韵呈照老","author":"李流谦","text":"吏部称文畅，愚溪进浩初。\n深惭诋佛奏，更著广交书。\n情契远犹合，义乖邻亦疏。\n诧予无騃习，固自起犁锄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62707,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用韵答王子苍","author":"李流谦","text":"圣道灰秦燎，残编出汉初。\n混茫千古意，破碎百家书。\n中镝无多语，操戈亦太疏。\n升堂得玄解，伴子带经锄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62708,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"石洞二首 其二","author":"李流谦","text":"香雾团成盖，茶花白胜酥。\n对书閒境界，觅句静工夫。\n客信因鱼得，归程约雁俱。\n庭前海棠树，尚及一看无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62709,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"石洞二首 其一","author":"李流谦","text":"春梦断不记，春游谁与同。\n竹斜过午日，池皱晚来风。\n柳已都齐绿，桃犹约略红。\n流莺啼未了，又过短墙东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62710,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仲明兄弟访别郊居","author":"李流谦","text":"眼远孤帆没，临流一怅然。\n分携惜此日，作恶验中年。\n惟有加餐祝，仍期得句传。\n相看俱四十，香火好因缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62711,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仲明留少城未还予将归矣留诗别之","author":"李流谦","text":"判袂四十日，望君君不来。\n过门先问讯，立马屡徘徊。\n正坐牵归梦，无缘把别杯。\n鹤山果西去，会面更悠哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62712,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仲甄见和复用韵","author":"李流谦","text":"坎止流行亦漫然，斯文未丧本关天。\n冥鸿云外知谁报，怨鹤山中不得眠。\n连榻故人非楚越，杖藜幽约在林泉。\n盛词终日供吟讽，骨换元知久学仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62713,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"任德广通判拉游长松以诗见贻次其韵 其一","author":"李流谦","text":"稽首头陀问八还，扬眉应已破玄关。\n苦无骨相侯千户，薄有生涯屋数间。\n笑读道书蒙绛帕，喜浇茗椀酌青山。\n从公一瓣薰知见，谷雾无心泽豹斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62714,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"任德广通判拉游长松以诗见贻次其韵 其三","author":"李流谦","text":"已成倦鸟不知还，碌碌无奇合抱关。\n五斗未供鸡鹜饱，一身长占簿书间。\n何妨使我留东阁，久自从公仰泰山。\n佳句传来浑舍喜，亟将病目洗斓斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62715,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"任德广通判拉游长松以诗见贻次其韵 其二","author":"李流谦","text":"鹭行鸳列几时还，虎豹何曾限九关。\n杂沓群公半天上，婆娑老子但尘间。\n平戎正倚二三策，招隐休论大小山。\n浯水断崖磨欲尽，凭君染笔续彪斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62716,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再用韵送印老","author":"李流谦","text":"抖擞孤怀十日谈，不将幽愤托巫咸。\n别来断雁虚秋信，梦破惊猿忆晓岩。\n脱叶趁风声互答，归鸦赴日影相衔。\n临分半偈无多惜，浊骨凭师为点凡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62717,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再用魏城驿韵贻白绵州","author":"李流谦","text":"多病相如故倦游，归逢清润麦天秋。\n回头渐远将军幕，飞梦先登帝子楼。\n磊落声称元古郡，醉吟家世自诗流。\n此身只拟春中老，莫问君平住益州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62718,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再游蒋山 其一","author":"李流谦","text":"系马松门竟日留，一灯深殿炯清幽。\n杖头犹识齐梁谶，屐齿曾经王谢游。\n瑟瑟新毛吃老树，娟娟眯目破红榴。\n风铃塔上知何语，应使行人估客愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62719,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再游蒋山 其二","author":"李流谦","text":"江南春晚见芳菲，雪白梨花照客衣。\n步步来求诸佛记，尘尘全现祖师机。\n不禁战伐山河老，犹说经纶俎豆非。\n共饮名园那惜醉，落红故故傍愁飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62720,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再赓佳什已致牵羊之请又辱不鄙垂教盖大巫困小巫欲视其颠踣为戏耳辄作二章以足小成之数 其二","author":"李流谦","text":"讲摩师友我尤须，此道今人已绝无。\n颇欲相从问奇字，故应未暇注阴符。\n竹嫌影薄乘春种，酒怕樽空带雪沽。\n杖屦往来忧不数，恐公早晚蹑华途。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62721,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再赓佳什已致牵羊之请又辱不鄙垂教盖大巫困小巫欲视其颠踣为戏耳辄作二章以足小成之数 其一","author":"李流谦","text":"鳞鳞新绿涨篙竿，飞雁声中岁已阑。\n梅蕊尚能供冷淡，酒杯那复问甜酸。\n徵招不入幽人梦，节物空惊壮士肝。\n趁取芳菲行乐去，丽词妍唱暖春寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62722,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吊无为照老三首 其二","author":"李流谦","text":"记得三溪溪上春，瘦筇容我夜敲门。\n一生几见此人物，十日九从师笑言。\n閒得得来非有意，冷湫湫去若为论。\n西山第一烟云窟，好驻高人雪月魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62723,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同邑寮饮望锦亭","author":"李流谦","text":"小亭挈榼共登临，濯锦城高隔暝阴。\n元有乾坤堪著眼，却因身世苦惊心。\n碧山已尽天犹阔，黄叶欲残秋更深。\n已把安危属王谢，酒阑不必泪沾襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62724,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宇文氏庄观海棠时海棠未甚开而余旦夕归矣赋此","author":"李流谦","text":"雨猛几终夕，风狂遂彻朝。\n眼缘春色醉，魂为客愁消。\n泽国空留滞，山房恐寂寥。\n平芜烟一望，乡梦太迢遥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62725,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宇文德济约游崇庆值客不果从德济有诗次韵二首 其一","author":"李流谦","text":"午枕风轻睡足时，起来閒掩竹间扉。\n登山剧欲君联臂，出户那堪客挽衣。\n失脚半生沈世网，掀髯一笑见天机。\n青山好去应须去，蘧瑗于今已觉非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62726,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宇文德济约游崇庆值客不果从德济有诗次韵二首 其二","author":"李流谦","text":"跨海仙人安在哉，幽寻款款不须催。\n云萝有约遽相失，杖屦几时能独来。\n半日清谈容易废，百年幽抱若为开。\n新诗小慰参差恨，快读聊将劝一杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62727,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"师仁再用韵复作一首","author":"李流谦","text":"室中元自有天游，海内如何止九州。\n送老只凭书万卷，传家不用橘千头。\n便当野服从逋客，未暇巍冠伴沐猴。\n一动天文儿戏耳，苦烦天子访羊裘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62728,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"早饭白崖铺净果院","author":"李流谦","text":"久客谙人事，身能到处安。\n炉深红一聚，竹瘦碧千竿。\n祗作临深恐，何辞行路难。\n几成晚来雪，唯有不胜寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62729,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次大人韵二首 其二","author":"李流谦","text":"六品官资叵厌卑，高怀自不入时宜。\n却寻清渭归垂钓，犹向钧天忆射麋。\n长日只凭诗遣闷，暮年全藉酒扶衰。\n早将鵩赋胸中了，贾谊何忧绛灌疑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62730,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次大人韵二首 其一","author":"李流谦","text":"盘礡谁知画史真，向来唯有宋元君。\n试除学道有底事，为问决科何等文。\n棋罢玉枰收碎雹，香残金鸭转微云。\n独骑一马悠悠去，閒访江头白鹭群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62731,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次子友竿字韵","author":"李流谦","text":"百战残兵但揭竿，每闻风鹤意先阑。\n怀中鼠腊元非璞，味外盐梅不止酸。\n细读知君应掩口，苦吟笑我已刳肝。\n中天赫日临无际，一点萤飞宿草寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62732,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次元尉伯言韵","author":"李流谦","text":"烛影红馀仆屡更，不知飞霰集前荣。\n终年客有刀头恨，半夜春从酒面生。\n华发风埃羞漫仕，废畴烟雨负深耕。\n诵君好句迎新岁，更醉屠酥最后觥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62733,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次仲甄韵二首 其二","author":"李流谦","text":"恻剥风枝恨，若为开我颜。\n索居诗社废，多病酒杯悭。\n本自便三径，何曾梦九关。\n临溪问鱼乐，知我是青山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62734,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次仲甄韵二首 其一","author":"李流谦","text":"大用不坚壁，等閒忧患侵。\n平生知学道，万事付无心。\n露苋锄晨甲，烟篁步夕阴。\n陶然宇宙内，鱼鸟听浮沈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62735,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次怀安骨肉自简池来会","author":"李流谦","text":"来往金涧道，寻常不隔年。\n异方何契阔，浑舍此团圆。\n老子风埃甚，孙儿玉雪娟。\n妻孥劳行役，争劝吸长川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62736,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次黄仲甄峡中韵","author":"李流谦","text":"九江度尽恶风波，峡口窥天一握多。\n亦爱吾庐觉归好，数乘此险奈亲何。\n响迎涛濑将愁上，青惜峰峦等梦过。\n不管行人听不得，暝猿和雨啸云萝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62737,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵大人书怀 其三","author":"李流谦","text":"何如莫莫与休休，分付烟波一钓裘。\n心向青山贪未了，梦随白鸟去无由。\n閒云犹阁为霖润，野水空横济物舟。\n安得杜陵诗老在，从渠每日醉江头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62738,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵大人书怀 其一","author":"李流谦","text":"万钧笔力等閒扛，占断溪山福已庞。\n扑鼻寒梅香树树，照人新酿绿缸缸。\n大严净社谁投足，小恕诗坛肯纳降。\n莫为不侯空叹息，将军才气自无双。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62739,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵大人书怀 其二","author":"李流谦","text":"云翻雨覆不须论，扪虱何妨坐对温。\n政恐移文邀俗驾，可能垂箔走高门。\n寒松卧雪不知老，脱叶经霜无几存。\n醉著锦袍堪一笑，翰林风月我诸孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62740,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵大人江上秋兴","author":"李流谦","text":"织水轻烟擘不开，晚峰浓翠积成堆。\n吹残黄叶风犹舞，飞尽青天鸟却回。\n万古关河空拊髀，半天风雨独持杯。\n欲将直道干侯印，政恐舟从陆地推。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62741,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵仲秉见寄二首 其二","author":"李流谦","text":"读书空有癖，学道苦无工。\n散策群峰近，穿溪小径通。\n此身犹客里，野性合山中。\n春水添新浪，烦君理钓筒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62742,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵仲秉见寄二首 其一","author":"李流谦","text":"别后年仍换，诗来语更工。\n音书恨不数，魂梦却相通。\n草木春风后，关河夕照中。\n飞鸿不可倩，此意付筠筒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62743,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵仲甄见贻","author":"李流谦","text":"向来出处有心期，未厌云霄戢翼飞。\n留滞兼旬空怅望，逡巡半路偶同归。\n却欣夜语仍连榻，尚忆朝回日典衣。\n里闬齐年班又接，世间如我与君希。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62744,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵朱饰之中秋玩月因以送之","author":"李流谦","text":"君理朝宗楫，吾乘上峡船。\n此杯同此地，明月又明年。\n怕作凌晨别，贪看彻晓圆。\n眉间有黄气，知近冕旒边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62745,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵何子闻安静观 其二","author":"李流谦","text":"日压茅檐醉拥蓑，静听寒溜奏云和。\n深藏本自身全露，瞪视元知语不多。\n紫府地严须一到，苍崖文古要重磨。\n新宫固是丛霄样，应有胎禽忆旧柯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62746,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵何子闻安静观 其一","author":"李流谦","text":"翩然逸想九霞间，仍是霓衣与鹿冠。\n尘劫三山元自近，神官一字固应难。\n云烟万瓦虹榱壮，冰雪千幢鹄辇寒。\n堪笑木强韩吏部，如何容易撮灵丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62747,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵宋德器春晚即事五首 其五","author":"李流谦","text":"柳老阴阴密，榴繁灼灼明。\n持杯了醒醉，拊槛置枯荣。\n谷旷箫笙杂，江空镜像呈。\n澄心著老眼，物物见真情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62748,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵宋德器春晚即事五首 其四","author":"李流谦","text":"楼迥支筇久，庭閒转榻频。\n松衰无直干，竹好但新筠。\n漫仕惭逋客，躬耕羡野人。\n可能千里意，端的为吴莼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62749,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵宋德器春晚即事五首 其三","author":"李流谦","text":"灵明观自己，纠错漫殊途。\n睨柱誇完璧，探怀失系珠。\n封侯真不愿，作佛尚堪图。\n解我无还语，根尘法本粗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62750,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵宋德器春晚即事五首 其二","author":"李流谦","text":"久习成衰怯，何方疗阔疏。\n柴车穷巷客，贝叶长年书。\n每愧沾沾喜，宁甘郁郁居。\n蓍神吾未暇，坚意听盈虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62751,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵宋德器春晚即事五首 其一","author":"李流谦","text":"室空超众止，理妙契无同。\n帘卷半规日，香吹一线风。\n草晴唯欲碧，花晚尚能红。\n老我閒居兴，清应到小童。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62752,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵杨文甫监茶名山新建学桥二首 其二","author":"李流谦","text":"赤栏画柱水光中，更爱丰碑笔吐虹。\n雾市溟濛鳌闯首，雪花错落马行空。\n关门近接俱天险，溪水平流亦海通。\n执朴笑渠忧诅者，不知说豫坐收功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62753,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵杨文甫监茶名山新建学桥二首 其一","author":"李流谦","text":"高栋浮空插万甍，来游谁是鲁诸生。\n规模要识鸣弦意，土苴犹消击柱争。\n驯垄雉骄佳气象，集林鸮恶好音声。\n白头老令能知此，莞尔相撩意未平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62754,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵陈彦博梅饮之什","author":"李流谦","text":"又向疏梅检校春，乾坤浩荡日趋新。\n一樽树下唤深酌，数岁天涯思远人。\n正倚交情论晚暮，直因臭味作疏亲。\n渊明嗜酒嵇康懒，只觉年来此是真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62755,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵彦博中秋不见月","author":"李流谦","text":"露华浸竹冷娟娟，想象嫦娥能少年。\n万事只堪搔短发，一杯不拟问高天。\n骎骎夜色投书幌，的的心期在钓船。\n可笑薄云工料理，何曾遮却一分圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62756,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵彦博游无为马溪并呈孙隆州","author":"李流谦","text":"块处无人语合头，出门猝猝又还休。\n缚茅晚岁欣同社，并辔名峰得胜游。\n松下一筇真可老，山中五月已如秋。\n未应斗粟全关念，更为先生几日留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62757,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵秋日书怀 其二","author":"李流谦","text":"微风吹叶脱，落日卷帘初。\n蛮榼行提酒，胡床卧读书。\n友朋元总好，气味不应疏。\n有暇须乘兴，溪中足鲤鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62758,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵程进孺书怀","author":"李流谦","text":"寸梗悠悠寄一城，主人留客亦多情。\n目穷断雁投空影，耳著清江彻晓声。\n浊酒半樽心易醉，远书一字眼偏明。\n无家更甚无鱼苦，付与先生好细评。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62759,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵德茂待仲甄巨卿未至","author":"李流谦","text":"飘零一月住，日望北来船。\n眼冷传书鲤，肠空吸露蝉。\n梦魂孤枕侧，行李畏途边。\n坚守蒲人信，嗟予苦未贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62760,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江上晚眺书所见","author":"李流谦","text":"云镕金错落，月挂玉盘盂。\n水退岸全缺，烟陈山欲无。\n沙晴鸥并集，林暝鸟争呼。\n不必求摩诘，分明是画图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62761,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自三池一日过灵池十五里头宿山险尽矣","author":"李流谦","text":"垄头停辔望龟城，元有夷途似掌平。\n厌把五更供客梦，猛将一日了山程。\n树连新绿千林暗，日转斜红半野明。\n稚子别来应念我，候门深喜马蹄声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62762,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自少城解职事还邑二首 其二","author":"李流谦","text":"胡床卯饮带馀酲，身世如天行白云。\n竹简读残聊一叹，水沉烧尽更三薰。\n痴心久绝临渊羡，老手唯便植杖芸。\n自有此生须自断，岂能曲折问灵氛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62763,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自少城解职事还邑二首 其一","author":"李流谦","text":"尘埃一出竟何为，白竹依然昼掩扉。\n只应为客重为客，便欲得归宁得归。\n独鹤静临寒沼立，游蜂閒趁落花飞。\n东君老大人消瘦，凭仗清樽一解围。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62764,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟中","author":"李流谦","text":"欲买一江碧，不知须几钱。\n舟轻故款款，酒好但涓涓。\n云脚他州雨，波光别岸天。\n渔讴与樵唱，同和小山篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62765,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟中","author":"李流谦","text":"一舸乘凉载夕晖，晚来白汗稍停挥。\n近人初月当头照，趁宿轻鸥直下飞。\n江国有天须恣买，岫云无雨莫空归。\n新秋渐到滩头树，先遣蓑童问钓矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62766,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]