[{"title":"叠嶂楼","author":"梅询","text":"谢公城上谢公楼，百尺阑干挂斗牛。\n碧瓦万家烟树密，苍崖一槛瀑泉流。\n波光滟滟前溪满，刹影亭亭古寺幽。\n此地近除新太守，绿窗明月为君留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69580,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"濠州四望亭閒眺","author":"梅询","text":"南北舟行互掷梭，长淮混混接天河。\n石梁景绝虹垂渚，桐柏春深雪作波。\n四望空明无俗翳，数声欸乃有渔歌。\n谁言此地殊幽僻，自我今来风味多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69581,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"阴陵","author":"梅询","text":"龙虎相驱逐，干戈事战争。\n千重汉围合，一夜楚歌声。\n凄凉七十战，散漫八千兵。\n失道欺田父，穷途遇灌婴。\n天亡终不悟，览古亦伤情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69582,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吴王墓","author":"梅询","text":"昔见虎眈眈，今为佛子岩。\n云寒不出寺，剑净求离潭。\n幽步萝随径，高禅雪闭庵。\n吴都十万户，烟瓦亘东南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69583,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"武林山十咏 其一 飞来峰","author":"梅询","text":"竺慧指此峰，飞来自灵鹫。\n猿鸟曾未知，烟岚尚依旧。\n兴亡谩千古，天地岂关纽。\n祇恐舟壑移，他年却西走。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69584,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"武林山十咏 其八 水台盘","author":"梅询","text":"鹤发山中人，疏泉凿幽石。\n如凭青玉案，分递白云液。\n泠泠溅雕俎，瑟瑟穿吟席。\n醉坐三伏中，烦襟自消释。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69585,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"武林山十咏 其四 龙泓洞","author":"梅询","text":"矫矫渊下龙，潜神在灵府。\n云卧虽有时，泥沙可长处。\n阴崖寒气腥，峭壁烟痕古。\n何当救旱暵，奋起为霖雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69586,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"武林山十咏 其六 冷泉亭","author":"梅询","text":"古窦鸣幽泉，苍崖结虚宇。\n六月期客游，披襟苦徂暑。\n开窗弄清浅，吹鬓疑风雨。\n不见白使君，烟萝为谁语。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69587,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"武林山十咏 其七 灵隐寺","author":"梅询","text":"千峰凌紫烟，中有梵宫阙。\n灵眄极幽栖，尘心自超越。\n松篁发春霭，桂实坠秋月。\n争得谢世人，兹焉老华发。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69588,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"武林山十咏 其三 呼猿洞","author":"梅询","text":"古涧飞白猿，寂历不知处。\n风激石上泉，僧疑月中树。\n微茫认松雪，髣髴横樵路。\n写望增尔思，苍苍奈烟雾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69589,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"武林山十咏 其五 炼丹井","author":"梅询","text":"仙翁道未成，栖神在岩石。\n酌彼山下泉，穷年炼金液。\n洞阴春始绿，苔甃秋涵碧。\n缅慕不可期，凭栏望凫舄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69590,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"武林山十咏 其二 莲花峰","author":"梅询","text":"巨石如芙蕖，天然匪雕饰。\n盘礴峰顶边，婵娟秋江侧。\n涉川试谁探，作砺当自惜。\n坐与荣落同，正心未尝易。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69591,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"武林山十咏 其十 高峰塔","author":"梅询","text":"高塔列远岑，亭亭几百载。\n铃声答夜风，轮影落沧海。\n闲云伴危级，曙日平烟彩。\n欲下生暮愁，千山闭轻霭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69592,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"武林山十咏 其九 翻经台","author":"梅询","text":"灵运曾此台，冥心住幽寂。\n重绎叶上书，深藏林中迹。\n遗文传竹素，野蔓侵苔壁。\n登览殊未休，苍山日将夕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69593,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诗一首","author":"梅询","text":"楚之襄王问宋玉，玉时对以郢中歌，歌为白雪阳春曲。\n始唱千人和，再唱百人逐。\n至此和者才数人，乃知高调难随俗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69594,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"桃源","author":"梅询","text":"武陵风景都然改，谷口桃花镇长在。\n自从改赐鼎州名，转觉桃源仙气灵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69595,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"真庙挽辞","author":"梅询","text":"愁烟暗鼎湖，龙驭入清都。\n陟降红云陛，陪歆赤帝雩。\n亮阴真圣嗣，遗诏尽嘉谟。\n尚见孤臣泣，蒙知直殿庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69596,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其三","author":"梅询","text":"茶煮鸦山雪满瓯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69597,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其二","author":"梅询","text":"我有集仙经始在，劳君一到为重脩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69598,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其四","author":"梅询","text":"鹤楼试望晴霞断，鹦渚行吟绿蕙春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69599,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"满庭芳 嘲杏俏","author":"梅娇","text":"一种阳和，玉英初纵，雪天分外精神。\n冰肌肉骨，别是一家春。\n楼上笛声三弄，百花都未知音。\n明窗畔，临风对月，曾结岁寒盟。\n笑杏花何太晚，迟疑不发，等待春深。\n只宜远望，举目似烧林。\n丽质芳姿虽好，一时取媚东君。\n争如我，青青结子，金鼎内调羹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69600,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"望江南/忆江南","author":"梅顺淑","text":"风渐软，暖气满天涯。\n莫道穷阴春不透，今朝楼上见桃花。\n花外碾香车。\n围步帐，羯鼓杂琵琶。\n压酒燕姬骑细马，秋千高挂彩绳斜。\n知是阿谁家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69601,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"五日公宴","author":"梅挚","text":"虎符新合晚芳天，良会难并乐与贤。\n心愧白公求治切，下车三月始开筵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69602,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"北轩敧枕","author":"梅挚","text":"苦无勤瘁补台纲，西院西头冷峭房。\n今日铃斋一敧枕，清风不敢傲羲皇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69603,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观旧题再书 其二","author":"梅挚","text":"二十年前扣寺阁，粉墙题记墨犹存。\n重来树老无花处，又见阇梨白首孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69604,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观旧题再书 其一","author":"梅挚","text":"方丈前诗映后诗，更无尘点碧纱围。\n老僧相顾应相笑，不似扬州刺史归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69605,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过白头桥","author":"梅挚","text":"白头桥奈白头何，旧德如存故老歌。\n不特舆梁起遗爱，大都才美服人多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69606,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"灵岩","author":"梅挚","text":"烟抱千峰碧玉堆，一岩一穴汉天开。\n畜云泄雨通灵派，长与苍生救旱来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69607,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秀峰院","author":"梅挚","text":"影借金田润，香随璧月流。\n远疑元帝植，近想志公游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69608,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"海仙花","author":"梅挚","text":"泥根捧入故吴宫，暖力迎随带渐红。\n栽近木兰殊有意，留连文酒系春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69609,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偶书小诗寄永叔内翰","author":"梅挚","text":"酒户棋兵孰与侪，月宵曾遇六天街。\n南燕到后怀君远，时入楼东画舫斋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69610,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"琵琶亭","author":"梅挚","text":"陶令归来为逸赋，乐天谪宦起悲歌。\n有弦应被无弦笑，何况临弦泣更多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69611,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登普贤阁观桄榔树留小诗","author":"梅挚","text":"壮年薄宦守西瓯，一瞬流光三十秋。\n今见桄榔两嘉树，恍如重到海边游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69612,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新橘","author":"梅挚","text":"千头霜熟摘来新，包贡虔修望紫宸。\n他日功成许高退，社中还结素封人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69613,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新繁县秘藏院留别乡知","author":"梅挚","text":"佛住三朝恐爱生，人归一岁岂无情。\n乡亲乡友销魂地，岷水分为陇水声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69614,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"酬张无梦","author":"梅挚","text":"一梦浮生无梦身，先生真是古之真。\n蕊函裁得瑶章秘，还寄吴门吏隐人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69615,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题南园 其一","author":"梅挚","text":"长洲茂苑足珍材，剩买前山活翠栽。\n客土不疏承帝力，几多臣节共安来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69616,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"归雁亭","author":"赵鼎臣","text":"东风杨柳杏花飞，曾伴先生酒一卮。\n前辈风流那复见，小亭烟雨漫相思。\n城边春草路南北，山下河梁人别离。\n一尺短书湘水阔，年年愁绝雁归时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69617,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自和寒食韵","author":"梅挚","text":"龟堞春游径路赊，青青踏去冒烟华。\n翠停舴艋客寻寺，红卸羃䍦人上车。\n亭落五重沽卓酒，钗行十二步潘花。\n乘欢醉尽高阳侣，倒载归来不认家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69618,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和王益留题清凉院","author":"梅挚","text":"一水明如罨画溪，清凉佳胜古标题。\n香随讲雨天花烂，声入幡风地籁齐。\n暂到已能知觉路，纵游何必理禅畦。\n谢公公退多行乐，五里鸣驺出县西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69619,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"昭潭十爱 其八","author":"梅挚","text":"我爱昭州乐，供官不在多。\n薰风齐乐圣，淑气且宣和。\n谒庙知神格，铺筵喜客过。\n声边无一事，对酒漫高歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69620,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"昭潭十爱 其九","author":"梅挚","text":"我爱昭州酒，千家不禁烧。\n醥醪一爵举，瘴雾四时消。\n红叶和云踏，青帘傍水招。\n化浓民自醉，鼓腹日歌尧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69621,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"昭潭十爱 其六","author":"梅挚","text":"我爱昭州角，呜呼古郡衙。\n万愁萦桂水，一曲阻梅花。\n调古湘云叶，声乾岭月斜。\n今愁并古恨，吹起落谁家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69622,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"昭潭十爱 其二","author":"梅挚","text":"我爱昭州士，平居富塾庠。\n兴贤遵汉诏，论秀美周乡。\n艺苑蒲开牒，书堂缥结囊。\n蟾宫前后进，一一手间香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69623,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"昭潭十爱 其五","author":"梅挚","text":"我爱昭州路，优游不险崎。\n九疑通舜野，八桂绕秦祠。\n亭堠相望处，渔樵有让时。\n政无牙虎斗，莫信义山诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69624,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"昭潭十爱 其七","author":"梅挚","text":"我爱昭州月，闲宵入绮楼。\n凉生荔浦树，冷熨桂江秋。\n朱户千家启，浮云万里收。\n谁誇魏公子，飞上邺门游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69625,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"昭潭十爱 其一","author":"梅挚","text":"我爱昭州水，湘漓共一源。\n本无泥滓污，去有棹歌喧。\n沃野藤溪道，浮琛玉海门。\n有时新雨涨，多半是君恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69626,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"昭潭十爱 其三","author":"梅挚","text":"我爱昭州观，裁基压大溪。\n一楼云驻隐，双表鹤归迷。\n金剜先朝语，鸾惊旧史题。\n皇恩新雨露，祈福为烝黎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69627,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"昭潭十爱 其四","author":"梅挚","text":"我爱昭州寺，东西占景开。\n门临九峰列，僧自五天来。\n讲次花飘席，斋馀鸟下台。\n万民共行乐，终宴首慵回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69628,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"留题重光寺罗汉院赠宪上人","author":"梅挚","text":"人尽游方證佛心，师心无着外三乘。\n莲花结社新吟远，玉纸抄经旧价腾。\n药杵半和铃索响，茶烟轻共衲云蒸。\n我来与话高僧事，冷笑支公学养鹰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69629,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新繁县法要院孙太古壁画罗汉","author":"梅挚","text":"绝艺知君少，谁怜太古踪。\n佳名吾党出，逸格彼苍钟。\n山狖遥偷果，田衣半剥茸。\n乡人当保此，此画世无重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69630,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新繁县显曜院","author":"梅挚","text":"绣地萦回宝势长，遍游宁倦徙胡床。\n禅斋不顾幡风影，讲席乱飞花雨香。\n苔阵暗连僧榻古，蕉旗低映佛窗凉。\n我来懒上东台上，目送霜楸感北堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69631,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"酬赠王益舜良殿丞 其二","author":"梅挚","text":"风度幽闲识宇高，暂分明寄握牛刀。\n贾生学赡思仪汉，李白才多合继骚。\n步武即看峨豸角，对扬几见掷麟毫。\n琴斋颂罢吟魂远，时梦钧天醉碧桃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69632,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"踏青","author":"梅挚","text":"绮场纷纷十里赊，望中烟景半春华。\n人游宝历青丝骑，路隘土桥金犊车。\n绿衬凤头垂径草，红攒鹢首照汀花。\n夕阳敲镫馀欢在，不惜鹴裘认酒家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69633,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和王益新繁县东湖瑞莲歌","author":"梅挚","text":"东湖七月湖水平，鳞波暗织箫籁声。\n中有植莲一万本，红漪相照摛繁英。\n地灵气粹不我测，双葩倏如同一茎。\n黄姑织女渡银汉，蜺旗凤葆罗空青。\n又认英皇立湘渚，翠华不返凝怨慕。\n五十哀弦顿晓声，骈首低昂泣珠露。\n是时主人集宴喜，湖光侵筵霞脚腻。\n朋簪峨峨尽才子，椽笔交辉云藻丽。\n酒酣倚栏惜红晖，炳素徘徊萦不飞。\n魏宫甄后昼方寝，彷佛有人持玉衣。\n此邑古来无异政，室家疮痏何由庆。\n三年鼠窃例皆然，以薪救火火弥盛。\n自公柅车政克和，载途鼓腹腾讴歌。\n歌公用心日皎皎，不独于今古应少。\n因感珍芳两两开，玉贯珠联当县沼。\n况我与公高适道，芝歌肯迹商山皓。\n嘉谋嘉猷思入陈，愿将此类归华勋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69634,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"昭潭十爱 其十","author":"梅挚","text":"我爱昭州果，西东此擅珍。\n荔枝登宴美，桂子荐盘新。\n映树珠含影，承牙玉溜津。\n二年游宦乐，满腹岭南春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69635,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"留别新繁县灵庆院僧智公","author":"梅挚","text":"粉里归来十二春，怜师心似我心淳。\n他时行满重相见，兜率天上第几人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69636,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"酬赠王益舜良殿丞 其一","author":"梅挚","text":"才地渊宏笔力恢，三年粉社幸游陪。\n八吟丽赋凭高得，三咏雕触选胜开。\n玉苑早容收朴樕，兰池尝许试虺尵。\n海棠风里甘棠政，只恐星趋节召回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69637,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题南园 其二","author":"梅挚","text":"长洲茂苑占幽奇，岩榭珍台入翠微。\n园李露浓三色秀，径桃烟暖一香飞。\n月临夕树乌频绕，风揭珠帘燕未归。\n弭盖暂欢成结恋，斜阳凭槛独依依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69638,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其一","author":"梅挚","text":"寺僧日扣妆钟起，园客时翻辇路耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69639,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其二","author":"梅挚","text":"堂有虚白闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69640,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其三","author":"梅挚","text":"珠峰塔影孤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69641,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西江月 泛湖","author":"梅窗","text":"雨过轻风弄柳，湖东映日春烟。\n晴芜平水远连天。\n隐隐飞翻舞燕。\n燕舞翻飞隐隐。\n天连远水平芜。\n晴烟春日映东湖。\n柳弄风轻过雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69642,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"阮郎归 元夕","author":"梅窗","text":"皇州新景媚晴春。\n春晴媚景新。\n万家明月醉风清。\n清风醉月明。\n人游乐，乐游人。\n游人乐太平。\n御楼神圣喜都民。\n民都喜圣神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69643,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 春晚二首 其四","author":"梅窗","text":"点点花飞春恨浅。\n浅恨春飞花点点。\n莺语似多情。\n情多似语莺。\n恋春增酒劝。\n劝酒增春恋。\n颦损翠蛾新。\n新蛾翠损颦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69644,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 其二 咏梅","author":"梅窗","text":"折来初步东溪月。\n月溪东步初来折。\n香处是瑶芳。\n芳瑶是处香。\n藓花浮晕浅。\n浅晕浮花藓。\n清对一枝瓶。\n瓶枝一对清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69645,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 其五","author":"梅窗","text":"曲屏春展山浮玉。\n玉浮山展春屏曲。\n香鸭瑞云翔。\n翔云瑞鸭香。\n醉深留客意。\n意客留深醉。\n凉枕怯宵长。\n长宵怯枕凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69646,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 其六 端午","author":"梅窗","text":"玉钗松鬓凝云绿。\n绿云凝鬓松钗玉。\n双翠碍枝长。\n长枝碍翠双。\n色丝添意密。\n密意添丝色。\n红映袖纱笼。\n笼纱袖映红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69647,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 其一 春闺","author":"梅窗","text":"碧窗纱透春寒极。\n极寒春透纱窗碧。\n谁送缕金衣。\n衣金缕送谁。\n玉肌生嫩粟。\n粟嫩生肌玉。\n温处坐香茵。\n茵香坐处温。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69648,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 其三 题锦机小轴","author":"梅窗","text":"浅红绡透春裁剪。\n剪裁春透绡红浅。\n机锦织情丝。\n丝情织锦机。\n意深凭远寄。\n寄远凭深意。\n波渺胜愁多。\n多愁胜渺波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69649,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]