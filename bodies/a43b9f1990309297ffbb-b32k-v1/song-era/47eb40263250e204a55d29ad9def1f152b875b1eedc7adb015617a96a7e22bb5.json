6":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题花十绝句 其三","author":"程公许","text":"杨花漠漠乱晴空，翠幰箯舆御晚风。\n试与徐园评绝品，紫毬曲柄状元红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1288,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题花十绝句 其十","author":"程公许","text":"饥肠可忍麦登场，寒索衣裘茧饫桑。\n莫为花残恨风雨，深恩何以答东皇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1289,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题花十绝句 其七","author":"程公许","text":"一栏养就数窠花，却辨牙牌定等差。\n我自色尘无染着，试将道眼看芳华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1290,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题花十绝句 其八","author":"程公许","text":"胭脂楼与瑞云红，叠萼重跗剪刻工。\n元利滋为人伪夺，不如倾倒付东风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1291,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题花十绝句 其二","author":"程公许","text":"谷雨犹赊半月期，禁烟花事已纷披。\n吏尘眯目春馀几，却被名花唤觅诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1292,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题花十绝句 其九","author":"程公许","text":"络绎筠篮为我分，古铜云罍井花温。\n无情风雨连宵恶，数朵窗纱故自存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1293,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题诗卷","author":"程公许","text":"嚼雪哦诗格外清，谁令失脚入红尘。\n锦囊二十篇中景，长与西山面目亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1294,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夔门邂逅同年汪丈奉议示诗和吟三首 其三","author":"程公许","text":"造朝敢不戒期程，鼍鼓明朝又趣行。\n好趁雪晴同访古，东屯诗老旧知名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1295,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夔门邂逅同年汪丈奉议示诗和吟三首 其二","author":"程公许","text":"鹏风九万是修程，驷马何妨缓辔行。\n圣治今方法元祐，白头尽耐立功名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1296,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夔门邂逅同年汪丈奉议示诗和吟三首 其一","author":"程公许","text":"万里吴天问去程，停桡峡口约偕行。\n苍颜相对曾相识，千佛经中记姓名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1297,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三高亭二首 其二","author":"程公许","text":"水仙要我小迟留，探借五湖风雨秋。\n三万顷波融一鉴，八千里客只孤舟。\n望迷渔荻荒寒境，思挟琴高汗漫游。\n模写自知才未称，天随有集更精搜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1298,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三高亭二首 其一","author":"程公许","text":"一棹松江朔雪饕，椒浆曾此酹三高。\n远游借与薰风便，伟观还如昔日遭。\n唤起玉龙嘘雾雨，饶教綵蜺战云涛。\n平生最爱登高赋，盍为丰碑续拟骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1299,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"七曲和魏校书韵","author":"程公许","text":"神理之公参造化，简书千古岂虚传。\n权衡无意物轻重，水镜何心人丑妍。\n天爵一身元不欠，人生万事且随缘。\n椒浆跪奠无馀祷，拟续离骚愧斐然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1300,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九月晦斋宿太一宫都监姚高士示刘长翁及汤仲能诸公唱酬诗轴因和韵二首 其二","author":"程公许","text":"孤云踪迹混风尘，蔼蔼阳和满一襟。\n招得鸳班同胜赏，肯教牛铎嗣清音。\n庵当黛面雪霜峭，洞锁玉台烟雨深。\n何日与师携手去，胎仙同看舞琴心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1301,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九月晦斋宿太一宫都监姚高士示刘长翁及汤仲能诸公唱酬诗轴因和韵二首 其一","author":"程公许","text":"扰扰东华车马尘，烟霞何日拂衣襟。\n空花想已销浮念，枯木犹能发至音。\n白鹤不来红日暮，金鳞自跃碧潭深。\n五千言外无馀旨，苦更研朱学洗心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1302,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"八月十日夜梦登青城最高峰醮仙官醮罢同羽士二三人散策月下濯足涧水意甚适也推枕惘然纪以唐律","author":"程公许","text":"崷崒孤岑碧四围，分明佳气是祠西。\n星坛醮罢天如水，羽褐追游月满溪。\n真境可容兵劫坏，天涯长恐梦魂迷。\n烟霞旧侣今谁在，还肯丹梯手共携。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1303,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三衢道士郑自得即天庆寮舍种梅疏池为小亭扁曰横清有诏住南岳道观复以此扁其亭解官事言归袖诗相访为次韵","author":"程公许","text":"高人久已悟空花，养就丹田日月华。\n方丈有谁来晤语，横枝相对虑无邪。\n云开衡岳重回首，雪满柯山迟到家。\n乞得归閒来叩户，摘将青子荐流霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1304,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上茶使邹郎中孟卿 其五","author":"程公许","text":"广文官独冷，博士冗不治。\n况此侯国泮，赘哉童子师。\n萧散非郑老，文章惭退之。\n可能冰雪地，一借春风吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1305,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"久旱祷雨罗仙有应使君再赋索和","author":"程公许","text":"未饶风伯怒吹云，且为仙翁荐宝熏。\n光夺钟山耕父室，令传古道阿香坟。\n流膏泫泫沟塍溢，喜气酣酣曲糵醺。\n太守同忧亦同乐，兵厨馀沥不难分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1306,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"久雨快晴侍杨尚书燕镇远楼","author":"程公许","text":"瘴雨弥旬快作晴，小山香馥晚风清。\n高秋幕府閒书檄，落日江山拥旆旌。\n形势自应专一面，关河犹未息交枰。\n雅知牧御须才望，盍早还朝洗甲兵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1307,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"子思赋中秋玩月词借韵作诗","author":"程公许","text":"山路相呼游冶盘，何妨月下更追欢。\n情知一夕秋无价，看彻三更酒未阑。\n衰鬓侵愁羞自照，回肠索句大应难。\n可能散发扁舟去，一到垂虹亭上看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1308,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"子春再约避暑和樊子思韵","author":"程公许","text":"忧端引起鬓丝长，喜报梁州复故疆。\n相约杨园舒野步，频呼竹叶沃刚肠。\n飕飕翠筱风生槛，滟滟红蕖水满塘。\n剩殖芳荣好看客，春风勿吝费除堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1309,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"小诗谢霅川使君帮祠庭薄俸","author":"程公许","text":"地行不必羡飞仙，骧首青云恐疾颠。\n但得一廛耕谷口，底须万骑战祁连。\n斋房尽日清如水，吾道从来直似弦。\n赖有故人供禄米，饱餐赢得枕书眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1310,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山中戏云端子","author":"程公许","text":"追路归山后，开关唤客眠。\n那知言在耳，已作醉逃禅。\n急雪浓筛瓦，中宵冷透毡。\n清愁分不尽，惜别意凄然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1311,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山中醮后一日雨雪仍留山中雾雨溟濛混然如一气未分也","author":"程公许","text":"香雾回翔八景舆，帝觞邀我适华胥。\n戏将馀沥作零雨，旋有六花飞太虚。\n意恐混沦凝祖气，心疑圆峤没归墟。\n题诗不作人间语，呵手残炉小楷书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1312,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"已尝早稻晚禾得雨亦骤长出城按行阡陌历诸寺而还成七言二章 其二","author":"程公许","text":"稻垄枫林锦缬文，秋郊乐事压芳春。\n为山谷访竹尊者，介卫公寻石丈人。\n午暑缓觞休北寺，夕曛趣驾度东津。\n胜游偶际文书暇，一笑溪山面目亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1313,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"已尝早稻晚禾得雨亦骤长出城按行阡陌历诸寺而还成七言二章 其一","author":"程公许","text":"欢谣千里庆西成，小队传呼略按行。\n雨足陈根重颖栗，眼明多稼尽坻京。\n灵君禅悦屏燔炙，乐岁人和喧送迎。\n老守何功享成事，祇凭一念辑和平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1314,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中秋节侍杨尚书待月南楼","author":"程公许","text":"羽扇风清夙霭收，元戎邀月上南楼。\n卷回天外连宵雨，借与人间一夕秋。\n六合扫清知有待，微云点缀故宜休。\n阑干直北频搔首，何限关山笛里愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1315,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"为王山尹子渚赋潜斋末句寄声叶新之","author":"程公许","text":"斯文宗绪自河南，妙处元非故纸钻。\n万里梦归伊阙远，一窗静对玉峰攒。\n林深雾豹南山隐，海阔风鹏北溟抟。\n刻楮自怜无一补，写心寄与故人看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1316,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"以西省斋事被差孟夏景灵宫朝饔跪进茶酒斋宿道山","author":"程公许","text":"承明三入笑陈人，药砌翻红又一春。\n英毂并驰惭领袖，斐章何自称丝纶。\n骏奔数幸天颜近，驽拙难胜宠渥频。\n月蠹腐红无以报，囊封敢不罄披陈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1317,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"以梨橙寄景韩景韩有诗来谢因和韵奉答","author":"程公许","text":"离肠不耐食张梨，并裹橙金遣使赍。\n薄馈羞同园吏菜，好词空费外孙齑。\n含消汉苑梦频渴，霜落洞庭书续题。\n莫遣楚娇多劝饮，怨歌难解太常妻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1318,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"元日即事四首 其四","author":"程公许","text":"屠苏最后釂银杯，岁月侵寻老景催。\n离坎新工几铢火，乾坤生意一声雷。\n君亲未报鬓惊雪，名业倘来心欲灰。\n一笑山头冰万仞，晓晴还见翠屏开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1319,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"元日即事四首 其三","author":"程公许","text":"憧憧行李不曾休，消遣年华古渡头。\n得似青衿专挟册，浪随黄帽熟操舟。\n归装趁得椒花颂，洗盏连呼柏叶浮。\n容易一年春又换，赏心可欠七年酬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1320,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"元日即事四首 其二","author":"程公许","text":"端居俄换岁华三，荼苦于吾若荠甘。\n照影菱花惊雪白，强颜柏叶借春酣。\n人间扰扰多岐路，圣世悠悠欠指南。\n一穟黄云晴昼永，叩门谁辨与同参。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1321,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"元日即事四首 其一","author":"程公许","text":"凤衔丹诏纪初元，馀恨难忘杞国天。\n贤路会当三接昼，宅家可卜中兴年。\n出车未可忘多难，覃耜尤须祝大田。\n千古逃吴称至德，有周笃庆更绵延。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1322,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"元正书怀","author":"程公许","text":"甲子循环六十年，手披新历意茫然。\n了知自性觉玄妙，宁与世间寒暑迁。\n寡过得如蘧瑗化，诺惺要了瑞岩禅。\n故园未卜西归日，遇好溪山且数椽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1323,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"元正和洪司令纪事二首 其二","author":"程公许","text":"兔魄乌轮西复东，流光那肯驻颜红。\n礼罗君不见温造，志广吾宁如孔融。\n难策材驽攀逸武，相期亲寿转方瞳。\n飞腾景暮何须问，圣处惭无一发功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1324,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"元正和洪司令纪事二首 其一","author":"程公许","text":"寸心炯炯水朝东，云绕通明一朵红。\n螭籀荐祥天眷顾，鸡竿衔赦日冲融。\n遥知万国趋尧彩，可使前旒隔舜瞳。\n京阙陵园须汛扫，圣心原不慕边功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1325,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]