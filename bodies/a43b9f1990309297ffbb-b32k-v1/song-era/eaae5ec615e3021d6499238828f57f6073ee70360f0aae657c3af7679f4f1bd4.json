[{"title":"信步","author":"罗与之","text":"信步独幽寻，春山野雾深。\n鸟啼如唤仆，泉响似鸣琴。\n日暖草争秀，风狂花不禁。\n却嫌荒僻地，无酒与春斟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30910,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"客行","author":"罗与之","text":"客行困泥潦，山堠不胜长。\n孰使雨点暴，更令风力狂。\n时危嫌店远，日暮觉程忙。\n身世摧颓甚，艰难已备尝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30911,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"客里","author":"罗与之","text":"客里愁浓处，秋宵月欲斜。\n雁声频到枕，蝶梦未还家。\n世有多歧苦，人因一念差。\n遥思林下去，蓑笠钓烟沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30912,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春残","author":"罗与之","text":"林端啼鴂损年芳，洞口空怜野水香。\n人与落英兼寂寞，蝶随飞絮两彷徨。\n不因花事荣枯易，未觉春工代谢忙。\n却爱晚来风日暖，绿阴十丈漾横塘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30913,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋林","author":"罗与之","text":"秋晏玄云瞀积阴，平芜气象极萧森。\n细看摇落风霜意，已见发生天地心。\n毕竟栽倾非外致，岂伊培覆自相寻。\n若教宋玉曾闻道，九辩悲思未遽深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30914,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绝知","author":"罗与之","text":"羁旅日骚骚，人间事若毛。\n绝知操笔误，深羡把犁高。\n百岁才能几，终朝强作劳。\n虚名竟何益，肯把换蒲萄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30915,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送春","author":"罗与之","text":"政是风光欲别时，可堪烟外雨丝丝。\n怕看太白馀春赋，嫌诵渊明止酒诗。\n昼短拟教持蜡炬，愁深悔不下书帷。\n自知无计能遮道，任作园林隔岁期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30916,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏雨","author":"罗与之","text":"飘忽回风起，差池高鸟翔。\n云攘千岭碧，雨献一天凉。\n饱意归田亩，欢悰入醉乡。\n忽思素秋气，萧瑟满空堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30917,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"旅思","author":"罗与之","text":"荏苒秋光老，空濛晓色奇。\n霜严雀语涩，风定雁飞迟。\n旅思荒烟底，乡心野水涯。\n梦归归未得，愁极祗颦眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30918,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"被酒","author":"罗与之","text":"人间笑口信难开，十事常嗟九不谐。\n忙里始知闲气味，老来方见少情怀。\n清商憭慄岁无几，玄发萧疏生有涯。\n谁谓伯伦闻见灭，却甘曲糵自沉埋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30919,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄企梅兄","author":"罗与之","text":"朱墨丛中不惮劳，騞然聊试发硎刀。\n得时行道官无小，与物为春政自高。\n闲对崆峒餐秀色，醉濡章贡助吟毫。\n自怜无计相从去，十八滩头泛一舠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30920,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄玉笥萧高士","author":"罗与之","text":"滴露誊真诰，萧然莫与群。\n新诗高似月，世念薄于云。\n俗走堪怜我，闲眠极羡君。\n唯馀绿绮韵，惆怅未曾闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30921,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梦回","author":"罗与之","text":"酒薄难成醉，轻寒袭破衾。\n梦回孤客枕，听彻草虫吟。\n寂莫三秋夜，凄凉一片心。\n山林与朝市，底处豁愁襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30922,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"黄鹤楼","author":"罗与之","text":"翚飞栋宇据城端，车马尘中得异观。\n双眼莫供淮地阔，一江不尽蜀波寒。\n老仙横笛月亭午，骚客怀乡日欲残。\n独抚遗踪增慨慕，徘徊不忍下层栏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30923,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游春","author":"罗与之","text":"春浓无处不相宜，草暖云昏二月时。\n蝶舞花梢风细细，莺啼柳底日迟迟。\n模将景物归诗卷，判得光阴付酒卮。\n个里各随人有得，五陵豪侠岂能私。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30924,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登玉笥山投龙洞","author":"罗与之","text":"扪萝入幽谷，眼界益峥嵘。\n石壁断人迹，泉流间鸟鸣。\n日高云未散，秋晚草犹荣。\n坐久无归意，悠然世念轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30925,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蛾眉亭","author":"罗与之","text":"悠悠飞露满汀洲，绝目蛾眉最上头。\n对此江山还有月，知他世界尽无秋。\n情怀杜老鄜州夜，景物坡仙赤壁游。\n长啸划然空谷应，风生浪涌不容留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30926,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"卫生","author":"罗与之","text":"屏去鸡壅与豕零，试听我诵卫生经。\n两忘宠辱心源净，一扫荣枯眼界明。\n酖毒不令生厚味，奸邪宁使出繁声。\n冥钧深养灵根固，四体调和血气平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30927,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山行愁思 其二","author":"罗与之","text":"明月印野水，暮色进旅愁。\n仆痡主亦疲，心口相怨尤。\n茅舍劣容膝，弛担聊小休。\n会当理归策，甘彼穷山囚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30928,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山行愁思 其一","author":"罗与之","text":"日落烟欲横，山寒翠将滴。\n荒村渺愁人，跬步触四塞。\n路遥两髀酸，颇恨身不翼。\n舍策还怅然，倦倚松下石。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30929,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中秋步月 其二","author":"罗与之","text":"幽人披襟来，步此一庭月。\n如渡滹沱冰，似泛山阴雪。\n谁将羌管急，间彼邻杵切。\n冉冉秋思生，令人欲愁绝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30930,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中秋步月 其四","author":"罗与之","text":"光阴若劈箭，行乐常恐迟。\n人生百岁客，扰扰竟何为。\n四美古难并，千年调亦痴。\n面生不我弃，邀月聊自怡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30931,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中秋步月 其五","author":"罗与之","text":"景物与意会，撚髯声悲鸣。\n一语得总持，万状就使令。\n以我诗思苦，赏此秋月明。\n今□月影里，几人同此情。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30932,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中秋步月 其一","author":"罗与之","text":"林间一叶秋，屏去三伏暑。\n凄然风露繁，絺绤莫能禦。\n炎凉相推移，胡为遽如许。\n孰知秋已半，今夕四十五。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30933,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中秋步月 其三","author":"罗与之","text":"空山本无尘，况复值良夜。\n风清月色佳，圭璧不当价。\n徐行苔径间，小立林影下。\n飘飘意欲仙，举手人世谢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30934,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"临流","author":"罗与之","text":"习习凉飔起素波，临流解带小婆娑。\n秋光已共芦花老，夜雨那胜落叶多。\n不觉儒酸同纠缠，极知妄想尽销磨。\n笈中班史犹堪质，肯作商声宁戚歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30935,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玉梁道中杂咏 其四","author":"罗与之","text":"峭壁围莽苍，荒蹊人削迹。\n时闻芦苇丛，野鸟话岑寂。\n浮生虽有涯，幽讨当无极。\n御风独长啸，此心谢鞿絷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30936,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玉梁道中杂咏 其三","author":"罗与之","text":"片石能邀人，憩此两足趼。\n忽逢黄冠师，对语白云巘。\n眼中景物饶，恨我蓬荜远。\n踌躇不忍去，泉石倘可剪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30937,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玉梁道中杂咏 其九","author":"罗与之","text":"濛鸿玉梁境，缥缈云霞仙。\n月坛白云洞，遗址空依然。\n千年唯乱石，蹲踞秋山烟。\n徘徊莫可觅，酌尽丹井泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30938,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玉梁道中杂咏 其八","author":"罗与之","text":"乾坤扫阴霾，晴色敞幽谷。\n山川荐秋容，奇秀若可椟。\n千岩寄一筇，万里付双目。\n行行翠烟中，日与清景逐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30939,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玉梁道中杂咏 其七","author":"罗与之","text":"支枕郁木山，月色瑩如洗。\n林幽枕席清，景胜魂梦伟。\n丁当鸟忽啼，令我惊欲起。\n金丹事可期，永愿供薪水。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30940,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玉梁道中杂咏 其二","author":"罗与之","text":"清商从西来，剌剌满林坞。\n草木倏变衰，柯叶不相顾。\n昔时翳空云，今作连山雨。\n菊花犹强项，篱边争媚妩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30941,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玉梁道中杂咏 其五","author":"罗与之","text":"晓霜媒薄寒，岩壑失故绿。\n轻飙振槁叶，唱彻阳关曲。\n秋光何足怜，嗟此岁事促。\n愁吟思无聊，日没西山麓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30942,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玉梁道中杂咏 其六","author":"罗与之","text":"泠泠涧底泉，破碎山根翠。\n似欲留佳客，曲折二十四。\n我行无定止，蜡屐信所诣。\n偶来倏舍去，乘兴聊复尔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30943,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玉梁道中杂咏 其一","author":"罗与之","text":"一别三会峰，转烛阅半纪。\n山根石上苔，已没旧屐齿。\n摩挲青青松，彼树犹如此。\n眷言枕清流，为洗嚣尘耳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30944,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玉梁道中杂咏 其十","author":"罗与之","text":"尘坌不可耐，飘然入林坰。\n稍觉道心胜，渐至诗脾清。\n静极生孤愁，耿耿难为情。\n喧寂两莫惬，吾意何由平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30945,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"动后","author":"罗与之","text":"莫作杨朱泣路岐，此心自被利名移。\n车奔宁是驾尼父，舟覆应非载伯夷。\n悔吝从来生动后，啸歌元祗在闲时。\n可怜秦晋功成者，欲避危机已太迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30946,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寻芳","author":"罗与之","text":"寻芳自勒青丝鞚，日暖烟浓春意重。\n晚来被酒卧花阴，流莺唤醒东风梦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30947,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"姑苏道中","author":"罗与之","text":"满眼菰蒲翠扑衣，双双沙鸟漾斜晖。\n闲愁一段如冰释，杨柳丛中出酒旗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30948,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"虎溪","author":"罗与之","text":"冲飙吹客襟，飘拂虎溪渡。\n远想三笑时，此意固有寓。\n孰知秘密藏，奚间笑默语。\n绳绳彻上下，绵绵贯今古。\n东林钟声幽，康庐山色嫭。\n是皆善知识，长时相警悟。\n世人自合尘，两耳聋莫觑。\n百千微妙义，堕在一毫许。\n我行发深省，如重睡忽寤。\n向人欲举似，有舌不能吐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30949,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"唤我","author":"罗与之","text":"晴空唤我出柴扉，山色留人倚落晖。\n春意已随流水去，晚风忍挟乱花飞。\n寻思乐事唯心在，惆怅良辰与愿违。\n尚有扁舟奇绝处，江南水暖鳜鱼肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30950,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"桂花烂熳一夕败于风雨呼僮扫落英以供香事戏作古句","author":"罗与之","text":"小山凉风高，秋意饶庭砌。\n江南山水秀，钟此数丛桂。\n亭亭苍虬蟠，磊磊栗玉缀。\n薰染风露香，摆脱脂粉媚。\n芙蓉已无秋，篱菊极羞愧。\n幽芳蕙百亩，香味亦琐细。\n孰知标格奇，自取造物忌。\n狂风挟怪雨，族灭无噍类。\n才怜金作屋，俄惊粟布地。\n姿容就枯槁，气骨尚奇异。\n如彼死诸葛，凛凛有生意。\n试炷博山火，来参烟一燧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30951,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谈道","author":"罗与之","text":"休将视听探希微，众妙何尝间险夷。\n舍一而求非忽恍，自三以究岂支离。\n试看瓦砾道宁隐，若外筌蹄思益奇。\n热即取凉寒向火，是中消息几人知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30952,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄衣曲 其一","author":"罗与之","text":"忆郎赴边城，几彀秋砧月。\n若无鸿雁蜚，生离即死别。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30953,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄远词","author":"罗与之","text":"寒梢萧索风振林，蟪蛄切切语欲噤。\n终宵展转不能寐，遥忆良人战场里。\n阳关一别归无期，翠烟几度秋萤飞。\n当时手种合欢树，今已苍苍云雨垂。\n蜀锦裁书凭雁寄，那能道人意中事。\n深秋倘得未移军，犹见幽闺数痕泪。\n居延城外刁斗声，无定河边霜月明。\n妾身虽老幸未死，何日中原贺太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30954,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"短歌行","author":"罗与之","text":"金谷桃李丛，畚插费培植。\n寒冰犹未泮，花叶已薿薿。\n贞松生南山，石老厥土瘠。\n春回气尚浅，生意几欲息。\n东皇本无私，托根异形色。\n曾谓天地功，不及粪壤力。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30955,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"潇湘道中","author":"罗与之","text":"客行适潇湘，凄其岁云晏。\n枯梢风骚劳，荒郊云漶漫。\n摵摵雨声急，皑皑雪花灿。\n抽萦泥途深，眇默山堠远。\n日莫欲税驾，天末扣孤馆。\n米尽甑生尘，薪湿火不暖。\n此意对三闾，似结两重案。\n人生如空华，百岁等抹电。\n那忍听客尘，日夜苦相煎。\n怀安名所败，饱食亲孰显。\n恭承古昔训，险阻庸敢惮。\n信知有此身，乃是一大患。\n愁深不能寐，歌长未及乱。\n门前车铎鸣，翰音复号旦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30956,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题采石李太白祠","author":"罗与之","text":"仙翁谪堕岷山下，逸气如虹耿林罅。\n万言倚马不作难，坐令神鬼皆惊嚇。\n翘翘车乘悬弓旌，畴咨时政肝胆明。\n和蕃书草金銮殿，清平词度沉香亭。\n声华视汉媲黄绮，宝床赐食龙颜喜。\n掉头歘作燕晋游，却笑卿相纡朱紫。\n开元盈成亦已极，屏间山水代无逸。\n未必脱靴恨尔深，自是见几不终日。\n锦袍错落浮扁舟，呼儿买酒盟江鸥。\n天公似悔夜郎祸，明月已起烟波愁。\n采石青青三尺墓，至今祠祭勤呵护。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30957,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"默坐","author":"罗与之","text":"厌调鞍马佩金壶，默坐空窗气晏如。\n已觉胸襟忘得丧，那知花草就荣枯。\n弦何庸绝琴宁有，声未曾销尘本无。\n此语倘教游子听，料应诮我一何愚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30958,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"商歌三首 其一","author":"罗与之","text":"东风满天地，贫家独无春。\n负薪花下过，燕语似讥人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30959,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"商歌三首 其二","author":"罗与之","text":"白屋釜生鱼，青楼行细脍。\n静思天地间，宁有私覆载。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30960,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"商歌三首 其三","author":"罗与之","text":"门前桑柘枝，中有千锦机。\n游人不回顾，桃李独成蹊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30961,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"资国院","author":"罗之纪","text":"倦逢磐石手摩挲，横压乌藤漫啸歌。\n烟崦坡陀青玉案，寺山缥缈白云窝。\n纸窗竹屋小盘礴，林影溪光相荡磨。\n试共老僧参此意，一声唤醒读书魔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30962,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"罗之纪","text":"吾道非耶真可耻，此君岂是折腰人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30963,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"罗大全","text":"愿挽玻瓈江，霈作东州雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30964,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王荆公","author":"罗大经","text":"错认苍姬六典书，中原从此变萧疏。\n幅巾投老钟山日，辛苦区区活数鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30965,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舟行野景","author":"罗大经","text":"数间茅屋带烟云，一片秋光惹翠蘋。\n鹤发渔翁犹结网，世间何处有闲人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30966,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和谢处厚","author":"罗大经","text":"杀胡快剑是清讴，牛渚依然一片秋。\n却恨荷花留玉辇，竟忘烟柳汴宫愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30967,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"猫捕鼠","author":"罗大经","text":"陋室偏遭黠鼠欺，狸奴虽小策勋奇。\n扼喉莫讶无遗力，应记当年骨醉时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30968,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"博浪沙","author":"罗大经","text":"不惜黄金募铁椎，祖龙身在魄先飞。\n齐田楚项纷纷起，输与先生第一机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30969,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"韩平原","author":"罗大经","text":"斋坛一钺底须悭，坐见诸贤散似烟。\n不使庆元为庆历，也由人事也由天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30970,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"韩范用兵","author":"罗大经","text":"奋髯要斩高邮守，攘臂甘驱好水军。\n到得绕床停辔日，始知心服范希文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30971,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题钓台二首 其二","author":"罗大经","text":"讲磨潜佐汉中兴，岂是空标处士名。\n堪笑史臣无卓识，却将周党与同称。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30972,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题钓台二首 其一","author":"罗大经","text":"平生谨敕刘文叔，却与狂奴意气投。\n激发潜龙云雨志，了知功跨邓元侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30973,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"濮议","author":"罗大经","text":"濮园议起沸乌台，传语欧公莫怨猜。\n须记上坡持橐日，也曾寻探好题来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30974,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"彤庭分帛","author":"罗大经","text":"赤子须摩抚，红尘几送迎。\n幕张云匼匝，车列鉴鲜明。\n岂是朘民血，空教适宦情。\n忍闻分竹者，竭泽自求盈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30975,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"从赵季仁游洞作","author":"罗大经","text":"瑰奇恣搜贝千趾，老仙遗祠邈谁始。\n后继述之□□李，异枝同根隆复祉。\n巨画更镵埒前美，紫气临关西未止。\n张留著书繄尹喜，末孙铭焉适当尔，附名崖端永不毁。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30976,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"茶声","author":"罗大经","text":"松风桧雨到来初，急引铜瓶离竹炉。\n待得声闻俱寂后，一瓯春雪胜醍醐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30977,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]