[{"title":"和颜长官百咏 其十 空门","author":"朱继芳","text":"灯灯相续古犹今，怪底门前立雪深。\n衣不得传关臂事，汝师轻发老婆心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38680,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和颜长官百咏 其六 空门","author":"朱继芳","text":"黄金栏护紫袈裟，禁苑恩深赐予奢。\n林下衲僧那有此，多年枯木对春华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38681,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和颜长官百咏 其八 空门","author":"朱继芳","text":"白莲有社一经过，会意由来不在多。\n满目庐山青未了，闻钟归去意云何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38682,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和颜长官百咏 其四 空门","author":"朱继芳","text":"四祖门庭寂寞秋，牛头只是旧牛头。\n如何一旦风光别，花落花开百鸟愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38683,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和颜长官百咏 其九 空门","author":"朱继芳","text":"我本三生兜率天，为差一念又尘缘。\n早知密意无多子，不著旁行贝叶边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38684,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和颜长官百咏 其二 空门","author":"朱继芳","text":"锡杖凌空去复还，片云缥缈伴身闲。\n春风错种醍醐草，引得牛来食雪山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38685,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和颜长官百咏 其三 空门","author":"朱继芳","text":"人居天地一樊笼，抚掌山家四壁空。\n不道今年空得尽，且无雀鼠到山中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38686,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和颜长官百咏 其五 空门","author":"朱继芳","text":"四卷楞伽几上安，而今老去懒能看。\n庭前桂树花开未，分别西风信鼻端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38687,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和颜长官百咏 其一 空门","author":"朱继芳","text":"闭口桐鱼勿复论，数间老屋枕云根。\n晓钟三板出山去，分付猕猴为守门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38688,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和颜长官百咏 其七 空门","author":"朱继芳","text":"结草为庐万仞头，人间蚁穴自王侯。\n客来借问穷通理，不意僧中有许由。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38689,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和颜长官百咏 其四 贫女","author":"朱继芳","text":"他家百两送于归，成匹鸳鸯作锦机。\n独守空闺愁不寐，一灯明灭补寒衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38690,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和颜长官百咏 其五 贫女","author":"朱继芳","text":"灯下穿针影伴身，懒将心事诉诸亲。\n阿婆许嫁无消息，芍药花开又一春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38691,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和颜长官百咏 其二 贫女","author":"朱继芳","text":"洗尽铅华净洁贫，嫁衣莫说为他人。\n绝怜父母穷相守，不为金多贱却身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38692,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和颜长官百咏 其七 贫女","author":"朱继芳","text":"少年荡子有黄金，投赠明珰结两心。\n不得良媒终不肯，一春风雨洞房深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38693,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和颜长官百咏 其三 贫女","author":"朱继芳","text":"枯木无枝可作花，门前度尽七香车。\n四邻日日笙歌里，背立东风有几家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38694,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和颜长官百咏 其九 贫女","author":"朱继芳","text":"问天乞巧看铜仪，再拜双星恨不随。\n尘世未知天上事，隔河相望一年期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38695,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和颜长官百咏 其六 贫女","author":"朱继芳","text":"卓家人富颇轻财，犊鼻堪依不用媒。\n只似侬家贫亦好，枯桐那得凤凰来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38696,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和颜长官百咏 其八 贫女","author":"朱继芳","text":"伯鸾不作怅谁从，凤尾香衾翠谩重。\n静对菱花匀泪粉，不知膏沐若为容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38697,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和颜长官百咏 其一 贫女","author":"朱继芳","text":"春风有分到儿家，也插花枝表岁华。\n但得作嫔君子室，随宜妆遣不须奢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38698,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和颜长官百咏 其十 贫女","author":"朱继芳","text":"纤手清闲理瑟工，高楼半在碧云中。\n行人岂是知音者，小立花阴待曲终。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38699,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和颜长官百咏 其三 城市","author":"朱继芳","text":"王孙公子少年游，醉里樗蒲信采投。\n指点某庄还博直，明朝酒醒到家求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38700,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和颜长官百咏 其一 城市","author":"朱继芳","text":"村翁生长在柴门，身有丁男犊有孙。\n为了官租才出市，归家夸说与乡村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38701,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和颜长官百咏 其九 城市","author":"朱继芳","text":"百人聚处小喧阗，析到秋毫似计然。\n见说天公还掠剩，鹄形怀宝度饥年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38702,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和颜长官百咏 其十 城市","author":"朱继芳","text":"身游城市发将华，眼见人情似槿花。\n惟有梁间双燕子，不嫌贫巷主人家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38703,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和颜长官百咏 其八 城市","author":"朱继芳","text":"芜城怀古最愁人，劫火烧残得此身。\n舞榭歌台何足道，秦宫汉苑尚流尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38704,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和颜长官百咏 其六 城市","author":"朱继芳","text":"相班士女狭邪间，总把喧啾卖却闲。\n人寿几何春不再，典衣沽酒强追攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38705,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和颜长官百咏 其四 城市","author":"朱继芳","text":"山人只合住山中，入得城来调不同。\n满面红尘无处避，手携白羽障西风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38706,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和颜长官百咏 其七 城市","author":"朱继芳","text":"春风日日柳年年，到老那知稼穑难。\n若见田家秋作苦，教人一饭不遑安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38707,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和颜长官百咏 其十 客路","author":"朱继芳","text":"高鸟翩翩去未穷，行人扰扰复西东。\n何须华表千年鹤，城郭重来便不同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38708,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和颜长官百咏 其一 客路","author":"朱继芳","text":"一曲长歌行路难，昏鸦归尽倚阑干。\n不知楚水巴山地，更有高楼鸟外看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38709,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和颜长官百咏 其九 客路","author":"朱继芳","text":"屈指秋风与雁期，阳关西去到何时。\n侧身一望肠堪断，天似穹庐碧四垂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38710,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和颜长官百咏 其三 客路","author":"朱继芳","text":"儿女伤悲士不为，健行童仆远相依。\n春风日日生芳草，未必啼鹃怨不归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38711,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和颜长官百咏 其八 客路","author":"朱继芳","text":"送穷不去奈穷何，山有荆榛水有波。\n万物得时人自老，梁鸿头白五噫歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38712,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和颜长官百咏 其七 客路","author":"朱继芳","text":"是处人家捣练忙，天寒日短路偏长。\n蛬声四壁无时歇，不遣羁人梦到乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38713,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和颜长官百咏 其五 客路","author":"朱继芳","text":"客里情怀更晚秋，雁烟蛬雨五更头。\n从前谙尽江湖味，不省神州作么愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38714,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和颜长官百咏 其六 客路","author":"朱继芳","text":"身如海燕傍谁门，别泪双垂不见亲。\n惟有一条邛竹杖，相随万里共艰辛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38715,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和颜长官百咏 其四 客路","author":"朱继芳","text":"侠客千金不称求，途穷相顾问因由。\n临分脱赠青萍剑，莫荡人间琐碎雠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38716,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和颜长官百咏 其二 客路","author":"朱继芳","text":"哀猿啼断暮云深，摸索床头未尽金。\n莫道他乡千万里，去家三日几般心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38717,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和颜长官百咏 其五 渔父","author":"朱继芳","text":"推起篷窗抱月眠，三三两两柳边船。\n不须听说文王事，孤负渔竿八十年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38718,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和颜长官百咏 其四 渔父","author":"朱继芳","text":"长作丝纶短短牵，一池汉水尽南天。\n谁知有客量江面，不是渔郎两板船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38719,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和颜长官百咏 其二 渔父","author":"朱继芳","text":"一曲清漪濯晚霞，钓竿斜插白鸥沙。\n傍人借问居何处，四海五湖都是家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38720,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和颜长官百咏 其六 渔父","author":"朱继芳","text":"传呼扶柁晚风前，一阵惊鸿没远烟。\n不是吾侬栖泊处，却回别港避官船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38721,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和颜长官百咏 其一 渔父","author":"朱继芳","text":"不踏长安十二门，鸬鹚飞处数家村。\n停桡试向滩头问，莫是严光末世孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38722,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和颜长官百咏 其七 渔父","author":"朱继芳","text":"五湖烟里我知鱼，属玉舂锄一处居。\n欲到垂虹风作恶，几株官柳向人疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38723,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和颜长官百咏 其八 渔父","author":"朱继芳","text":"秋声只在树中间，极浦斜阳更有山。\n卷却丝纶呼酒盏，鸥边聊得此身闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38724,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和颜长官百咏 其三 渔父","author":"朱继芳","text":"秋风淅淅猎菰蒲，如此江山其可孤。\n天与玻瓈三万顷，更添一半夕阳铺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38725,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和颜长官百咏 其十 渔父","author":"朱继芳","text":"璧月沧波上下天，秋风摇落四无边。\n玉龙尽唤眠鸥起，两岸芦花不见船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38726,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和颜长官百咏 其九 渔父","author":"朱继芳","text":"舟系蓬莱浅水傍，鳌头缩尽海生桑。\n百川日夜滔滔去，借问人间有底忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38727,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宜春台","author":"朱继芳","text":"定王米换长安土，北望长安日几回。\n更有筑台归未得，凭高却望定王台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38728,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"画舫","author":"朱继芳","text":"画舫茭中出，青山树上斜。\n浪醒孤客酒，尘盖万人家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38729,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"幽寻","author":"朱继芳","text":"幽寻兴不浅，归路故迟迟。\n猿断空山答，人行片月随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38730,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"柳","author":"朱继芳","text":"临水送将归，春风折赠时。\n而今三丈树，元是手中枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38731,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"草虫便面","author":"朱继芳","text":"蝶舞蜂歌倦，蜻蜓看未休。\n谁知织妇意，方夏已思秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38732,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鸥","author":"朱继芳","text":"采鱼秋江上，鸥鸟来相随。\n荡桨忽惊起，云天碧四垂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38733,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桥西","author":"朱继芳","text":"云澹风微日未低，瘦藤扶到小桥西。\n林花过雨相争发，谷鸟无人自在啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38734,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"调宜州冷官不赴","author":"朱继芳","text":"瘴海南边路浅深，客愁不待岭猿吟。\n无人唤得涪翁起，分我桄榔橄榄阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38735,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚眺","author":"朱继芳","text":"鸟飞欲尽暮烟横，一笛西风万里晴。\n山外有山青不见，微云映出却分明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38736,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"野望","author":"朱继芳","text":"帝青八万四千里，更著脩眉一两尖。\n古往今来愁得尽，不教我辈送愁添。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38737,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"疏山矮师叔道场","author":"朱继芳","text":"白云深处水茫茫，四百年馀古道场。\n我来不见矮师叔，手种树身今许长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38738,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"溪桥","author":"朱继芳","text":"云归洞府痴龙睡，日澹山椒倦翼还。\n桥上行人桥下水，如今日夜不曾闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38739,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题李秋堂盟鸥集","author":"朱继芳","text":"相逢已恨十年迟，买酒吴山一夜诗。\n明日送春仍送客，柳花风飏鬓丝丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38740,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蛬","author":"朱继芳","text":"一蛬何唧唧，吟落儿童心。\n只在竹篱外，篝灯无处寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38741,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十暑","author":"朱继芳","text":"十暑江湖客，尘缁白苧衫。\n人沿沙岛路，风捲海门帆。\n带雨厨烟重，通潮井脉咸。\n家书言不尽，重拆又重缄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38742,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"子规","author":"朱继芳","text":"自身归未得，却劝别人归。\n思妇心中事，征夫泪满衣。\n蜀天知近远，江树间稠稀。\n幸自安双翼，谁教不奋飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38743,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书窗夏日","author":"朱继芳","text":"南风伊轧语窗扉，团扇无功白日迟。\n长恨老来方学易，自从春去不吟诗。\n虫丝有力萦琴索，蛀粉无声点墨池。\n偶出门前行数步，石榴花过已多时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38744,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"六和塔","author":"朱继芳","text":"三百有馀年，潮头不敢颠。\n孤尖标白浪，层级上青天。\n铃隔山僧呗，灯通海客船。\n老来登眺眼，不道步难前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38745,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"反招隐","author":"朱继芳","text":"木末径微微，谁敲白板扉。\n缓行松叶滑，小摘药苗稀。\n山色自今古，尘寰多是非。\n昂昂千岁鹤，便肯傍人飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38746,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"失题","author":"朱继芳","text":"千年白蝙蝠，来往扑人衣。\n洞黑鬼相语，天寒僧未归。\n岩温生石乳，烟起作林霏。\n城里遥看处，唯应一翠微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38747,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"对酒","author":"朱继芳","text":"莫信樵人说，秦时有树存。\n青天浮渤澥，白日走昆仑。\n为有愁千斛，时须酒一尊。\n提壶亦相劝，花下绿阴繁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38748,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"旧游","author":"朱继芳","text":"两峰多少寺，分日去遨游。\n山翠横天目，湖光浴佛头。\n花朝骑马醉，月夜傍船讴。\n一被微官缚，重来不自由。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38749,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用前韵谢野水郎君招饮","author":"朱继芳","text":"为有台池无限娇，游人歌舞尚朝朝。\n清漪浴日开金面，晴哢调风衮绿腰。\n骚客五花唐殿马，主家七叶汉庭貂。\n丁宁红紫休开遍，约住春风待见邀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38750,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"示医卜逢松崖","author":"朱继芳","text":"我生八月十五夜，清浅斜河浸月华。\n顾兔捣残千岁药，牵牛引动半天槎。\n自抛蓬海传方处，曾过成都卖卜家。\n今日相逢圆昨梦，一杯松下醉流霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38751,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再拜阆风帅干宝谟郎中","author":"朱继芳","text":"家世蜀青城，抟扶几万程。\n神游应八表，骨鍊已三生。\n举酒呼麟脯，吹笙答凤鸣。\n欲将余马绁，蜷局不堪行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38752,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"有叹","author":"朱继芳","text":"与老本无期，相寻天一涯。\n履承双足茧，帽裹半头丝。\n路近行犹歇，乡遥梦岂知。\n酒酣增意气，忽忆少年时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38753,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"有怀鹫山次僧芳庭韵","author":"朱继芳","text":"一塔与云齐，寻僧路不迷。\n小舟沙鸟外，疏磬夕阳西。\n古树含云亚，春桥覆水低。\n鹫峰飞不去，夜夜子规啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38754,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次庸斋先生韵赠黄隆中","author":"朱继芳","text":"醒眼隆中阅逝川，茅茨为屋竹为椽。\n吟成梁父时当隐，炊熟邯郸客正眠。\n汉土一抔无处觅，白坟三尺有人怜。\n君归欲作千年计，只合躬耕一寸田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38755,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]