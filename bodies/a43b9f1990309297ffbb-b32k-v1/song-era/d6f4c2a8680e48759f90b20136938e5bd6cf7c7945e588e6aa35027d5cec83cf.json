[{"title":"吴江小寺","author":"林泳","text":"当门苔石草毵毵，傍水低墙树两三。\n邂逅老胡闻好语，禅还不识字人参。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28603,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"建溪道间 其一","author":"林泳","text":"白鹭沙头犊子眠，隔溪茅屋起炊烟。\n渔翁半醉斜阳里，?了柴门下钓船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28604,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"建溪道间 其二","author":"林泳","text":"三两渔舟竹影中，山禽相对哢晴风。\n小桥落日无人处，一树桃花照水红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28605,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春燕","author":"林泳","text":"鹊结巢随太岁移，蜂分房占吉时飞。\n好将说与青台史，社日祇凭燕子归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28606,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偶题","author":"林泳","text":"世间准拟转成痴，静里高人一笑时。\n无米竟无二丁传，有花却有四娘诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28607,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宿囊山怀坚师","author":"林泳","text":"伏虎岩头向上层，袈裟几度忆同登。\n薜荔石屋应无恙，风雨谁明彻夜灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28608,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"澹津园看梅","author":"林泳","text":"三嗅清香水月边，冷然著我玉虚天。\n何须白雪黄芽诀，只服梅花也解仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28609,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"白莲 其一","author":"林泳","text":"西湖万景惹诗狂，爱此孤高压众芳。\n大士化身衣未解，西施净面镜慵妆。\n岁寒却有花堪比，水种应无草敢香。\n茉莉素馨方用事，鼻参眼入细平章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28610,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"白莲 其二","author":"林泳","text":"泰华仙根不染尘，一枝冷淡种尤真。\n俗缘梦断承妃步，色相空来坐佛身。\n净比禅心月上女，妆羞丽质水边人。\n纻袍羽扇吟相对，笑杀思王赋洛神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28611,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"刘直夫之入道今复逢衣余饮之酒","author":"林泳","text":"脱了紫霞衣，琴书欲傍谁。\n焚香懒持咒，衔袖旋吟诗。\n无本穷应悔，知章梦已迟。\n梅寒不堪折，斗酒谩浇之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28612,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西湖无水","author":"林泳","text":"红云赤日煮清澜，涸蚌枯鱼不忍看。\n佛老因言沧海变，诗人曾赋洞庭乾。\n弄船渡子愁归去，枕鼓雷官唤醒难。\n谩道天仙司下土，绿章几度祝星坛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28613,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吟边","author":"林泳","text":"醉骑鹤背堕红尘，镜里常羞一幅巾。\n穷达底论身外事，英雄或是眼前人。\n岂无散木偏能寿，亦有名花不及春。\n三万六千长短日，吟边莫遣两眉颦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28614,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"咏尘","author":"林泳","text":"野马相吹生不尽，海犀能辟语成空。\n高埋旗鼓无边黑，暗染衣冠日下红。\n宁可濯缨歌浊水，莫教举扇障西风。\n浑无一点仙家殿，应在三韩漂渺中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28615,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岳王墓","author":"林泳","text":"天意只如此，将军足可伤。\n忠无身报主，冤有骨封王。\n苔雨楼墙暗，花风庙路香。\n沉思百年事，挥泪洒斜阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28616,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读老人近诗","author":"林泳","text":"泽国归来掩竹扉，千年知己十年诗。\n读书动地惊天事，得句吟风弄月时。\n纸上圣贤相唯诺，尘边老宿费思惟。\n纵誇万首龟堂集，乐处龟堂未必知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28617,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宿赤岸寄太初弟","author":"林泳","text":"橘树绕溪边，人家一簇烟。\n急滩听似雨，低阁坐如船。\n远客思亲语，痴儿望叔怜。\n愁来吟未了，灯火已催眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28618,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄题涉趣园","author":"林泳","text":"园中日涉趣云何，未老归来气亦豪。\n还有郡人携斗酒，可无社客著方袍。\n诗如信笔真难到，琴不安弦更自高。\n办取白头猿鹤畔，莫教松菊只归陶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28619,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蔬餐","author":"林泳","text":"山人藜苋惯枯肠，上顿时凭般若汤。\n折项葫芦初熟美，著毛萝卜久煨香。\n炊粱剪韭贫聊办，煮饼浇葱病未尝。\n晦叔十斋从客笑，空房巾钵似支郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28620,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题百五叔自得斋壁","author":"林泳","text":"矮屋匡床两鬓皤，逍遥委顺奈吾何。\n三千世界醉乡大，十二时中静坐多。\n疏懒对人如素隐，等闲出语似禅和。\n便须敕断子平事，来伴溪翁安乐窝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28621,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题进道西楼","author":"林泳","text":"买屋西楼好，诗中著卧龙。\n青山相对处，黄檗最高峰。\n小尽容书画，低犹俯竹松。\n市声不到耳，惊梦是邻钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28622,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠俞竹心","author":"林泳","text":"避雨君平肆，相亲一笑边。\n我歌大司命，君说小行年。\n倾盖多豪贵，掀帘半醉眠。\n自言谋竹隐，聊觅印山钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28623,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"仙都白鹿歌","author":"林泳","text":"山中白鹿老而灵，有客有客占鹿鸣。\n我寻石门不知处，道人出洞欢相迎。\n修行无力有我相，不应信息令渠惊。\n吁嗟至人离诸有，一切相自有心生。\n桃源意行花两岸，山阴兴尽雪三更。\n道人道人苦多事，尔自采药渠食萍。\n白云满洞不须扫，客去客来云无情。\n我闻神仙游处白鹤叫，试听夜半空中声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28624,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"白头吟","author":"林泳","text":"弹却眼中泪，自唱白头吟。\n借君向时耳，明妾今朝心。\n身苦尚可忍，心苦不可禁。\n妾心似妾镜，对景长相寻。\n君心似君琴，转手成别音。\n失身妾命薄，轻身妾恨深。\n再唱白头吟，击碎青玉簪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28625,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂述","author":"林泳","text":"俗士心胸塞，高人眼目醒。\n罗浮夜半日，南极海中星。\n观心无别法，问梦有前人。\n夜或长于夜，身还外此身。\n万种由心造，千灵并我生。\n病中闻蚁斗，悟处喜驴鸣。\n天因断鳌立，人共裸虫生。\n积气元无物，含灵总有情。\n坏衲归杜窖，还舟上玉天。\n莫疑佛富贵，不信鬼神仙。\n功名祇可笑，时命偶相当。\n鸡豕能为帝，蚍蜉亦有王。\n色界真魔界，仙乡半醉乡。\n错寻醒酒石，痴觅返魂香。\n生白灵观妙，飞玄隐韵奇。\n不嫌崇有论，却爱步虚词。\n叱诃郑玄日，挦扯义山时。\n谁信冢中易，人疑昆里诗。\n檐夫通笔意，海客悟琴心。\n禅法空中得，书生纸上寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28626,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读关尹子","author":"林泳","text":"杏坛之外圣人徒，千载遗编喜卷舒。\n一字名篇原易卦，万言论道广聃书。\n黄庭丹学分苗裔，紫府仙经得绪馀。\n正为文章太奇崛，寻常眼目亦痹渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28627,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂述 其六","author":"林泳","text":"坦腹东床佳婿，企脚北窗真人。\n谈笑眼前事业，风流膜外精神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28628,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂述 其七","author":"林泳","text":"祝柱客曾兴刺，斲窗史亦留名。\n我见诸相非相，天何不鸣善鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28629,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂述 其二","author":"林泳","text":"书生钻故纸里，衲子转法华时。\n易有九事未解，禅无一句可疑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28630,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂述 其十","author":"林泳","text":"徐无党注欧史，黄仙鹤刻邕书。\n身外谁为知己，眼前我正是渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28631,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂述 其三","author":"林泳","text":"谄道正为著相，谤禅未许知音。\n人无第一等眼，佛具若干种心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28632,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂述 其四","author":"林泳","text":"竺仙论五百劫，蒙叟誇八千春。\n但闻尧舜氏作，谁识羲黄上人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28633,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂述 其九","author":"林泳","text":"唐士有非国语，汉人曾反离骚。\n依本定非笔杰，爱奇自是人豪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28634,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂述 其五","author":"林泳","text":"毕方鹤而一足，鬼车鸺而九头。\n物怪不知谁使，人身又复何求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28635,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂述 其一","author":"林泳","text":"关令著黄帝曰，柱史称圣人云。\n俗学谩誇臆说，仙书犹述旧闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28636,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂述 其八","author":"林泳","text":"文章不宜命达，帝王亦忌时名。\n谩说赋求司马，曾闻诗杀道衡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28637,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽胡季昭","author":"林经德","text":"扶植纲常抗直声，白头不惮岭南行。\n书云惟孝友兄弟，臣罪当诛王圣明。\n削籍投荒从宝庆，陟阶录后赖端平。\n朝家赐谥今方举，凛凛孤忠死亦生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28638,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送退斋先生归武夷 其一","author":"林若存","text":"我未识退斋，虚生七十载。\n一旦过诸途，未语心先拜。\n堂堂眉睫间，礼乐见三代。\n正涂日以荒，良心日以坏。\n天不产斯人，吾道将畴赖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28639,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送退斋先生归武夷 其二","author":"林若存","text":"书院新鳌峰，五贤祠学宫。\n马邵独避席，将无道不同。\n专专论的派，此理谁当穷。\n独学无师友，前儒议温公。\n准绳规矩内，安得鞭霆风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28640,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送退斋先生归武夷 其四","author":"林若存","text":"大运何茫茫，海桑逝不留。\n武夷有乔木，虬枝尚相樛。\n自昔擢巍科，为今阐大猷。\n万里惮北上，三年喜南游。\n长身古衣冠，庞眉瞭双眸。\n虽与今人居，不与今人俦。\n和风颜子春，泰山邹孟秋。\n一双忧世泪，溅入银河流。\n相期入圣域，舍子谁当优。\n奈何弃我去，荦确归途修。\n我欲断中流，去棹何悠悠。\n我欲息天风，别袂何飕飕。\n明晨君已远，晚岁吾何求。\n恐无后会期，笑作来生谋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28641,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送退斋先生归武夷 其三","author":"林若存","text":"我七君六旬，从会知无期。\n但贪言议合，不误光景非。\n先生明当别，吾将俦决疑。\n欲言尚何限，记一十已遗。\n及其未溘先，幸无靳珍题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28642,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"天台邵明府履善遗牡丹各赋一绝 其三","author":"林表民","text":"可是东皇雨露深，不成一字亦腰金。\n世间大有麒麟楦，对此谁能起愧心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28643,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"天台邵明府履善遗牡丹各赋一绝 其二","author":"林表民","text":"一春苦雨又忧花，烂尽秧根谷再芽。\n见说云头红可喜，老农犹恐是朝霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28644,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同钱则父登郡城观予所和梅仲潜金山吊东鲁林表民逢吉诗淮民同赋一绝","author":"林表民","text":"水落寒沙晚照收，沙边谁复舣孤舟。\n鲍昭自作芜城赋，难写江南不尽愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28645,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同谢邹访平老","author":"林表民","text":"江湖包笠今闲却，默坐惟翻贝叶文。\n耳重懒闻时俗事，客来聊荐一瓯云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28646,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵王亚夫景存县尉送春二首 其二","author":"林表民","text":"登临长是爱清晖，晚岁知心亦自稀。\n永昼松斋掩书坐，却看梁燕引雏归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28647,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵王亚夫景存县尉送春二首 其一","author":"林表民","text":"欲劝东君尽一杯，临岐无语独迟回。\n晚风自有留连意，递得莺声过柳来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28648,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西湖","author":"林表民","text":"十三楼寺朝餐饭，六一泉亭晚举觞。\n千古湖山难模处，淡烟微雨更斜阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28649,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀仙桥","author":"林表民","text":"晴雷昼夜激奔湍，涧草岩花亦耐寒。\n刘阮茫茫空仰止，恐乘风月一鞭鸾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28650,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜登桐柏上清阁","author":"林表民","text":"雨过中宵夜满空，一山松竹韵溪风。\n披衣独上上清阁，身在半天云气中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28651,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送倪平仲高士归天台 其一","author":"林表民","text":"绿章封事步虚仙，来自东皇太乙边。\n满袖明珠出光怪，又随溪月上归船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28652,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送倪平仲高士归天台 其二","author":"林表民","text":"桐柏山高空翠寒，夜深星斗近仙坛。\n下宫银瀑三千丈，付与诗人雨后看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28653,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送宗镜上人归剡因寄声高九万孙季蕃 其二","author":"林表民","text":"神剜天划成岩洞，横亘危梁接应真。\n垂下玉虹三百丈，雪花飞溅一山春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28654,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送宗镜上人归剡因寄声高九万孙季蕃 其一","author":"林表民","text":"送师归隐镜山中，万壑千岩指顾间。\n菊涧花翁如见问，为言憔悴老江关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28655,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送宗镜上人归剡因寄声高九万孙季蕃 其三","author":"林表民","text":"一僧礼拜能行过，下面人看胆亦寒。\n月出幻成银色界，始知方广在林端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28656,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"剡中诗","author":"林表民","text":"遗踪曾记晋诸贤，乘兴今无雪后船。\n断堑毁垣难借问，砖文犹著太康年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28657,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梁民曹以二首为小园木香光宠次韵抒谢 其二","author":"林表民","text":"攀条折蕊属骚人，迟恐颠风扫玉尘。\n如付枕囊供醉寝，繁香薰骨解留春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28658,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梁民曹以二首为小园木香光宠次韵抒谢 其一","author":"林表民","text":"春风珠幰走青虬，清夜西园谁共游。\n十里水边浑似雪，唤船应是误王猷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28659,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新昌道中","author":"林表民","text":"残村时有两三家，缭绕清溪路更赊。\n客里不知春去尽，满山风雨落桐花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28660,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题六马图二首 其二","author":"林表民","text":"龙媒要是龙眠笔，意在能空冀北群。\n老我惟知赏神骏，何时变化上青云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28661,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题六马图二首 其一","author":"林表民","text":"骏影争驰意气雄，被尘晴苑碧溶溶。\n谁将妙笔开生面，雾鬣风鬃惨淡容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28662,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题方叔所藏马中远春牧晚归图","author":"林表民","text":"一抹东风树色新，牛羊莽莽散平原。\n微烟细草知归路，竹坞人家半掩门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28663,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山斋书事","author":"林表民","text":"掩卷听蝉韵，凭栏数雁行。\n井风梧叶雨，篱月菊花霜。\n又见秋将老，那堪夜更长。\n愁吟无语共，残灺落书床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28664,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵沈兴之税院岁暮即事二首 其二","author":"林表民","text":"穿云时有一鸿声，唤雪风来冷更清。\n腊意未教梅萼老，春风先放柳条成。\n乱离每叹兵难戢，贫贱还忧道不鸣。\n节物一番空自好，暗添年纪却堪惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28665,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵沈兴之税院岁暮即事二首 其一","author":"林表民","text":"一檐寒雨滴愁声，赢得松斋睡思清。\n急景不知年又谢，壮心空怅事无成。\n温存冻壁火初举，陵轹破窗风自鸣。\n多谢故交相慰藉，浪捐珠璧使人惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28666,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"访怀遇师","author":"林表民","text":"独隐重岩里，全无物役心。\n禅因秋月悟，诗对晚云吟。\n访古猿惊锡，抛生鸟上林。\n相知今十载，不惮远来寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28667,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏别墅","author":"林表民","text":"池馆春方谢，连朝雨似烟。\n乱荷藏睡鹭，繁木集嘶蝉。\n地僻观书乐，心清得句玄。\n野僧时过我，携手弄云泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28668,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"饯台倅王司令几叔参釐天府","author":"林表民","text":"黼坐颁泥检，黄图驾玉星。\n自应摅学业，端不藉门庭。\n冻日湖梅白，春风院柳青。\n从今亨路去，台岭记曾经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28669,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送天台李明府贯一归越","author":"林表民","text":"赤城谭旧令，为政且鸣琴。\n涧瀑知清操，山云识苦吟。\n自甘微贱拙，谁信勒碑深。\n归路春风近，烟花绕禁林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28670,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送王季和文知施州二首 其二","author":"林表民","text":"宿幸依刘表，时蒙说项斯。\n方为感知赋，遽作送行诗。\n万里通吴蜀，千山隔梦思。\n江头野梅发，应记共吟时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28671,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送王季和文知施州二首 其一","author":"林表民","text":"皂盖蚕丛去，青祗凤历颁。\n雪林猿叫峡，春院鸟啼山。\n文字传三楚，恩威化八蛮。\n政成明主召，九虎启天关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28672,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]