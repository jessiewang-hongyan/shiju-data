[{"title":"挽方孚若寺丞二首 其一","author":"刘克庄","text":"使君神隽似龙麟，行地飞空不可驯。\n诗里得朋卿与我，酒边争霸世无人。\n宝钗去尽中年病，珠履来疏晚节贫。\n昔共诛茅听瀑处，溪云谷月亦悲辛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32067,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽方宜人二首 其二","author":"刘克庄","text":"分断金钗股，全遮玉镜辉。\n竟令鸾独舞，愁见雉双飞。\n月照梁鸿案，尘凝孟母机。\n平生竺乾学，至此是真归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32068,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽方宜人二首 其一","author":"刘克庄","text":"贫道我儿孝，姑云此妇贤。\n诸郎丹穴种，夫子玉堂仙。\n□□□宁忍，煎胶法不传。\n多情潘骑省，应赋悼亡篇。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32069,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽方岳倅","author":"刘克庄","text":"昨解巴陵绂，将寻洛社盟。\n璧埋真可惜，玉立尚如生。\n旧辙冰天远，新茔雪濑清。\n惟应带来鹤，解作断肠声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32070,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽方武成二首 其二","author":"刘克庄","text":"丱角诗名出，流传海内誇。\n师称起予者，翁问倩人邪。\n惜未参诸老，犹堪擅一家。\n从今崖瀑上，谁共访梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32071,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽方武成二首 其一","author":"刘克庄","text":"颇有翁标致，唐衣折角巾。\n虽疑头小锐，极爱腹精神。\n阔矣云霄志，悲哉露电身。\n世间无妙质，一恸惜斯人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32072,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽方亲来伯","author":"刘克庄","text":"弆藏古物或千年，汉晋隋唐在目前。\n死有一孙堪付托，生惟四友共周旋。\n宝扶风簋如原甫，临永兴书逼米颠。\n占尽人间最清事，吾碑百世后方传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32073,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽方惠倅","author":"刘克庄","text":"家谱推贤裔，乡评号吉人。\n佩银成短梦，冠玉漫长身。\n朱轸鸾胶断，青林鹤表新。\n空令柱下史，反惜幕中宾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32074,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽方揭阳内子一首","author":"刘克庄","text":"雌燕营巢切，鸣鸠爱子均。\n荆练孟光饰，玉雪敬姜身。\n女史无其匹，宗姬有若人。\n里中多作诔，何况忝朱陈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32075,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽方倅岩仲二首 其二","author":"刘克庄","text":"身后青名在，辛勤卜此阡。\n书丹翰林笔，埋玉息庵钱。\n葛帔孤谁托，蒿簪妇亦贤。\n许丞无事业，千古以廉传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32076,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽方倅岩仲二首 其一","author":"刘克庄","text":"上世师朱氏，慈闱祖艾轩。\n惓惓纂遗绪，历历识前言。\n柳记多先友，迁书赖外孙。\n悲哉此奇士，寂寞向寒原。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32077,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽方倅景楫二首 其二","author":"刘克庄","text":"屡荐于诸老，斯人可在廷。\n不令客翘馆，仅使直都厅。\n史漫存融表，坟犹待愈铭。\n西风已萧瑟，哀铎更堪听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32078,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽方倅景楫二首 其一","author":"刘克庄","text":"上世曾通好，君尊昔托孤。\n初闻携一束，俄见赋三都。\n皆谓终童隽，安知董相迂。\n秃翁老无力，爱助尚区区。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32079,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽方德润宝学三首 其三","author":"刘克庄","text":"晚赐延和对，言公去国深。\n遂良垂白发，臣甫抱丹心。\n驰驿无银信，移麾有玉音。\n遥知遗奏上，未免动宸襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32080,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽方德润宝学三首 其二","author":"刘克庄","text":"忆被乌台劾，聃非传偶同。\n瞽言拚万死，明诏赦孤忠。\n全活皆英主，淹留各秃翁。\n伤心古遗直，不返瘴云中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32081,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽方德润宝学三首 其一","author":"刘克庄","text":"龚胜乘车晚，阳城伏閤初。\n自云臣语戆，不是上恩疏。\n黄壤全名节，青编载谏书。\n始知年与德，造物有乘除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32082,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽方孺人一首","author":"刘克庄","text":"壸范经亲授，笄年咏好逑。\n谓迎荷橐返，岂料蕣华休。\n断雁元方恨，离鸾小宋愁。\n邻翁惫无力，不及送原头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32083,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽方?贡士","author":"刘克庄","text":"秋赋曾宾送，春卿偶脱遗。\n离群嗟老境，同队记儿时。\n终制从家礼，高怀见墓碑。\n亦如陶处士，自作诔兼诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32084,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽水心先生二首 其二","author":"刘克庄","text":"所学如山海，吁嗟不一施。\n未闻访箕子，但见诔宣尼。\n空郡来陪哭，无人敢撰碑。\n纷纷门弟子，若个解称师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32085,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽水心先生二首 其一","author":"刘克庄","text":"一梦孝皇初，悽然四纪馀。\n国人莫知我，天下孰宗予。\n散地虽无柄，名山尽有书。\n乌虖传万世，犹足矫玄虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32086,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽王礼部二首 其二","author":"刘克庄","text":"曲学多希世，方穿竟忤时。\n麈谈巾垫角，燕处案齐眉。\n峙鹄非常秀，离鸾得许悲。\n残年有何乐，偏作故人诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32087,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽王礼部二首 其一","author":"刘克庄","text":"留滞身犹健，招延鬓已皤。\n竟无金实橐，虚有锦为窠。\n貂角传空响，蛾眉妒渐多。\n向来真率伴，回首半消磨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32088,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽王华甫提刑二首 其二","author":"刘克庄","text":"何必求佳传，家庭论自公。\n颍滨碑玉局，曲阜状南丰。\n辔远方追电，筝调每值风。\n深知有遗恨，不见捷旗红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32089,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽王华甫提刑二首 其一","author":"刘克庄","text":"丱角从诸老，麻衣客五侯。\n风云疑反手，江海不回头。\n寂寂生堪笑，皇皇死未酬。\n空馀老知识，闭户著穷愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32090,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽王助教","author":"刘克庄","text":"彼此俱丁未，相逢忆少时。\n工书有筋骨，嗜句入肝脾。\n鲁泮郎君秀，唐官助教卑。\n直须燎黄诰，方慰蓼莪悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32091,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽王居之寺丞二首 其二","author":"刘克庄","text":"忆昔陪真率，华居甫落成。\n坐宾来堕帻，侍女出弹筝。\n无复吴趋曲，空馀楚些声。\n九泉见忠简，应问老门生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32092,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽王居之寺丞二首 其一","author":"刘克庄","text":"元老登庸晚，同年召用初。\n惜哉武公耄，甚矣董生迂。\n汾曲庐旋返，平津閤寖疏。\n空令双鬓白，犹待两轮朱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32093,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽王简卿侍郎三首 其三","author":"刘克庄","text":"已矣孤知己，颜苍鬓发稀。\n虽曾参话柄，终未契禅机。\n尚欲扁舟访，俄传只履归。\n无因拜公墓，稽首忏前非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32094,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽王简卿侍郎三首 其二","author":"刘克庄","text":"末著尤奇特，杯行忽坐亡。\n无香分侍女，有砚遗诸郎。\n长乐旌旗改，平泉竹石荒。\n公今呼不应，浮议果何伤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32095,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽王简卿侍郎三首 其一","author":"刘克庄","text":"先帝初更化，公曾以谏闻。\n身虽迁柱史，袖尚有弹文。\n晚境图成佛，它山预作坟。\n那知非变幻，止在石桥云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32096,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽王孺人","author":"刘克庄","text":"贞洁如图史，纤微到米盐。\n辟纑穷亦乐，反鲊训尤严。\n封邑才纶诰，还乡尚绣帘。\n自惭铭笔拙，何以发幽潜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32097,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽长乐王明府","author":"刘克庄","text":"奉常龃龉坐刚肠，月旦评君小奉常。\n父子相传似孤竹，越鄞两处有甘棠。\n人间梦事一炊熟，宰上埋辞万丈光。\n曾识尊公与贤叔，薤歌吟罢意凄凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32098,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽丘大卿二首 其二","author":"刘克庄","text":"武仲孝标皆已矣，可堪又夺到丘迟。\n汉家卿将今能几，洛社耆英在者谁。\n作有道碑宁免愧，过乔公墓定何时。\n春风自绿原头草，不管人间殄瘁悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32099,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽丘大卿二首 其一","author":"刘克庄","text":"方喜辽天孤鹤返，忽惊蔡岭一牛鸣。\n理官未遣俦三后，拙宦才令至九卿。\n尽剪萑莆潢弄息，不囊薏苡粤装轻。\n厚诬岂待他人雪，自有尧言与辨明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32100,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽卢母黄太孺人","author":"刘克庄","text":"太孺贤声众论推，府君经学里人师。\n牛衣隐约能偕老，萤火凄凉自课儿。\n畴昔黄齑曾百瓮，只今丹桂已双枝。\n乌虖卢母哀荣甚，何必人题墓上碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry