[{"title":"李季允作吞云楼索诗和总漕韵答之 其一","author":"魏了翁","text":"栅新飞观走狐嘷，楼鹤洲鹦贺此遭。\n整暇旌旗登巀嶪，奔波舟楫笑嗷嘈。\n宅中平后规摹拓，烛理明时运量高。\n须信是间天地似，词人云梦特秋毫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32290,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李尚书被召过泸临发之日官吏以行香日分追送不及明日尚书自合江诘后期次韵以谢","author":"魏了翁","text":"黄鸡喔喔丑前催，拟效张侯夜半来。\n残梦方随僧梵去，挐音已听客帆开。\n江皋望极空留恨，陛下忧深正急才。\n已赋明伦相赠勉，更思桃李及时栽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32291,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李郎中挽诗 其二","author":"魏了翁","text":"解道公行止，江东老父兄。\n群州垂瘵死，肤使为更生。\n民裕身逾瘠，时危命亦轻。\n浔阳江上月，犹傍谏书明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32292,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李郎中挽诗 其一","author":"魏了翁","text":"太息金泉守，西归空好音。\n孳孳求友意，恳恳爱君心。\n谋道身多阨，忧时力不任。\n怀人今永已，为世一沾襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32293,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李顺庆挽诗","author":"魏了翁","text":"蜜绍方闻学，亲承太史传。\n才资元近厚，辈行最推贤。\n七任二千石，分符三十年。\n天廷无一迹，归伴壑龙眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32294,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李德迈挽诗","author":"魏了翁","text":"鸣嘤出谷邈难亲，断雁辞行不可群。\n论事期期钳在口，逢人额额齿穿龈。\n乾坤许阔犹有碍，风雨满前如不闻。\n肠断天津邵夫子，东篱掩泪立孤云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32295,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李德秀致政以其生日前一日约士友至长庆院访梅花山茶因以为寿","author":"魏了翁","text":"流年苦被雪霜催，惟有山中自四时。\n寒色慭花妆岁晚，晓阴挟雾放春迟。\n似嫌俗客不同调，留与高人共胜期。\n但愿多书冲祐考，与君长伴岁寒枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32296,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杨夫人挽诗","author":"魏了翁","text":"行应珩璜女子师，荐修蘋藻大夫妻。\n礼门总是行持地，宦海元非爱欲泥。\n翚翟相传犹白凤，鹓雏可伏胜黄鸡。\n柳州念妹嗟何及，令德章章银笔题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32297,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杨处士挽诗","author":"魏了翁","text":"丁年已分与时违，便把书棚嘱付儿。\n峨岭秋寒千古意，符溪春暖一筒诗。\n彩云来往吾何与，草露消磨我自知。\n含笑黄泉应不恨，桂华犹有未开枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32298,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杨仲远挽诗","author":"魏了翁","text":"属我铭先竁，元符事益光。\n十年黄壤梦，再世短松岗。\n楼外焄蒿集，阁前名节香。\n吴钩无处挂，刍束寄诸郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32299,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杨极父挽诗","author":"魏了翁","text":"高堂元祐脚，下泽少游乡。\n自得林泉趣，不登声利场。\n年方荣四豆，日已下三商。\n有子翁无咎，存心味更长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32300,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杨叔介挽诗","author":"魏了翁","text":"尚记少年场，英英兀老苍。\n鄂不齐挺秀，兰茁竟摧芳。\n老尽凌云气，悲成捉月狂。\n若人奇且折，此事费平章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32301,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杨尚书生日 其二","author":"魏了翁","text":"三边头绪正相寻，云气模糊尚积阴。\n已喜龙荒通汉使，更须帝梦起商霖。\n功名本自于人薄，家国相关此念深。\n共指岷峨祝公寿，鬓华未听晓霜侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32302,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杨经母范氏挽诗","author":"魏了翁","text":"大父生逢世，严君死守城。\n尊章全急义，娣姒得贤名。\n夫子行无玷，男儿学有成。\n典刑今已矣，风雨送红旌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32303,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杨修撰挽诗 其一","author":"魏了翁","text":"早辞天子诏，晚挂大夫车。\n文雅三朝旧，风流二祖馀。\n眼前甲乙石，胸次丙丁书。\n自古谁无死，前休得似渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32304,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杨修撰挽诗 其三","author":"魏了翁","text":"玉树擎双干，灵椿老一株。\n林泉閒富贵，屋漏静功夫。\n靖节自为传，耆英还有图。\n碑材徒镇石，此墓不须谀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32305,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杨修撰挽诗 其二","author":"魏了翁","text":"东都方枕奠，方镇尚根盘。\n不得裴中立，谁承田季安。\n威棱行阃外，声绩在朝端。\n犹使江阳隶，闻风亦胆寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32306,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杨隆庆挽诗","author":"魏了翁","text":"夜雨撼雍渠，春风载毕逋。\n畏途摇短梦，壮志束长湖。\n如此奇男子，终于朝大夫。\n鲜原千字诔，赖有少公苏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32307,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"泸贡士二十人端平元年手书增郡国贡士员泸增二人是岁贡于东西路转运司者各二人以五月庚戌合寮吏宴于郡之正牙歌鹿鸣以遣之 其二","author":"魏了翁","text":"天地中间着此身，合将位育入经纶。\n阴阳固自生成我，爵禄安能富贵人。\n利欲当权心退舍，诐淫得路俗迷津。\n诸君自此腾骧去，愿以先知觉此民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32308,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"泸贡士二十人端平元年手书增郡国贡士员泸增二人是岁贡于东西路转运司者各二人以五月庚戌合寮吏宴于郡之正牙歌鹿鸣以遣之 其一","author":"魏了翁","text":"皎日中天万国明，恢恢贤路庆端平。\n月正元日下书诏，二十六人登姓名。\n西泽射陈狸首节，东廉歌奏鹿鸣声。\n谬侯何幸身为驾，要示周行玉女成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32309,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陈寺丞挽诗 其二","author":"魏了翁","text":"圣主搜贤诏，愚臣荐士书。\n高冈看治凤，灵沼蛰潜鱼。\n时数自信诎，帝心谁戚疏。\n臧仓徒扰扰，穷达不关渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32310,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陈寺丞挽诗 其三","author":"魏了翁","text":"有子知乎否，苍生命益危。\n共伤周赫赫，谁叫庙嘻嘻。\n随处皆螗斧，何方不茧丝。\n斯人今已矣，抚事转伤悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32311,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陈寺丞挽诗 其一","author":"魏了翁","text":"人物晨星似，如公正献家。\n皂囊真相业，黄卷旧生涯。\n胡不慭遗老，而兴大耋嗟。\n天高那可问，泪眼为麻查。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32312,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陈总领挽诗 其三","author":"魏了翁","text":"闻诏弹冠日，颓然秃鬓翁。\n当肩百钧重，卷袂两拳空。\n既上供军最，方修给饟功。\n大钧那可问，曾不慭留公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32313,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陈总领挽诗 其二","author":"魏了翁","text":"举头西日远，满扇北尘污。\n病已关心腹，吾何爱发肤。\n变名逃越难，微服过商都。\n忽复天开霁，依然只故吾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32314,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陈总领挽诗 其一","author":"魏了翁","text":"士处宴安日，咸歆节谊名。\n范阳徒尔怵，河朔莽然平。\n仅识浅利害，恶知真重轻。\n开禧忠义传，吾得扈农卿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32315,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"制置丁少卿生日 其二","author":"魏了翁","text":"蜀道今行第几回，天西玉帐又宏开。\n鹤归华表人如旧，龟放长河独再来。\n屈处观伸霜后菊，消中见息雪前梅。\n泸江不解西流去，引领长空酌斗魁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32316,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"制置丁少卿生日 其一","author":"魏了翁","text":"皓皓陵霄独鹤飞，九芙蓉里烂生辉。\n青阳少府旧弓冶，白石先生新杼机。\n阅尽世纷磨不磷，听渠公论是邪非。\n恭惟陛下方亲政，小却犹应伴紫薇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32317,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和张大著颠字韵 其二","author":"魏了翁","text":"伥伥趋局晓衣颠，妙语飞来墨已鲜。\n太一藜然分夜隙，蓬莱海阔接风船。\n临邛词客虽末至，淮海签书非少年。\n独抱区区无我察，联篇重拜玉人怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32318,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和张大著颠字韵 其一","author":"魏了翁","text":"步弱扛丰分疾颠，不将臭腐易芳鲜。\n眼前富贵蚁奔垤，膜外功名鸥避船。\n忠愤无因尘乙夜，隐忧深觉负丁年。\n一窗风雨看书卷，三度京梅雪可怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32319,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和李参政正旦闻边报","author":"魏了翁","text":"羽檄连旬月，边尘换岁阴。\n捉衿忧见肘，补肉忍剜心。\n天远鸿飞急，林疏燕恨深。\n直将归往地，都作杀胡林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32320,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和李参政龙鹤庵庐二首 其二","author":"魏了翁","text":"古往今来一貉丘，行藏有道坎还流。\n凤凰池上春风梦，龙鹤山头夜月秋。\n閒曳深衣聊独乐，有怀连璧赋三游。\n何人得与余心会，野水黏天一片鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32321,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和李参政龙鹤庵庐二首 其一","author":"魏了翁","text":"落纸新诗万口传，逍遥旧梦记坡仙。\n明虹短雨下平楚，老雁长云横半天。\n涧底青松不改色，槛前流水谩安筌。\n寄声多谢无名子，莫搅诗翁秃鬓眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32322,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和杨仲禹送史子修特奏赴吏部注阙","author":"魏了翁","text":"科名宁较后先题，叹老嗟卑世所迷。\n须识是閒天地似，要知立处圣贤齐。\n人情一理涂涂附，古道千年印印泥。\n属子随时崇令德，窗前红日未全西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32323,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和杨尚书韵送蔺恭甫归永康","author":"魏了翁","text":"梦绕秦祠月半棱，归寻岷岭雪千层。\n傥来富贵垤藏蚁，尽大科名笔误蝇。\n须验家庭真事业，更追简册淡交朋。\n他年再出为时用，莫遣功夫似不曾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32324,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和范少才咏雪 其三","author":"魏了翁","text":"寒阴彫草木，枯叶委庭阑。\n苍耸孤松秀，青敷万竹蟠。\n封条才贴妥，见睍复攲宽。\n但使根长在，毋忧风哭酸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32325,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和范少才咏雪 其二","author":"魏了翁","text":"随踏晓岩去，殿头金井阑。\n路门圭璧委，双阙绛青蟠。\n拜手朝绅肃，忧心旰食宽。\n岁糜今有望，宁复厌菹酸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32326,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和范少才咏雪 其一","author":"魏了翁","text":"底处呼滕六，催将岁事阑。\n窗明朝采烂，枝瘦夜光蟠。\n炫晃山林老，模糊天地宽。\n晓琴弦欲折，难忍溧阳酸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32327,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和胡秘书学中释奠","author":"魏了翁","text":"祠官环邃殿，晰燎向晨光。\n工有歌咸夏，人无问国庠。\n豆笾陈吉飨，磬管奏和锵。\n盛事留篇什，赓酬愧不扬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32328,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和除夕前一日南叔兄会杨仲博杨季穆诗","author":"魏了翁","text":"玄里探幽识罔冥，易中观象见文明。\n心虚有友皆三益，宇静无时不四并。\n物理玩来成独笑，年华见惯渐忘惊。\n只馀亲友关天分，离合钟情不肯平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32329,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和崔侍郎送行诗韵 其一","author":"魏了翁","text":"昔岁阽危日，烦公疋马来。\n人心成胜势，天理是良媒。\n抖擞精神集，扶持气脉回。\n黄宫才一点，有许到葭灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32330,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和崔侍郎送行诗韵 其二","author":"魏了翁","text":"轧轧度空明，怀人梦不成。\n蜀天随处见，卮酒与谁倾。\n多事鬓毛改，长途髀肉生。\n随流浑未定，鼻息满船鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32331,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和蒋成甫见贻生日韵 其二","author":"魏了翁","text":"尚记春风酒满衣，数旬客馆掩空扉。\n双乌念哺归难忍，断雁辞行凝不飞。\n正念县弧成底事，有来连锦烂生辉。\n亟哦七字酬佳赠，归棹潇湘水正肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32332,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和蒋成甫见贻生日韵 其一","author":"魏了翁","text":"窗外浮云捲帝青，腰閒流水卧青萍。\n发挥孔孟真三代，补葺嬴刘破六经。\n理义本心如皦日，词章末伎谩流萤。\n独嗟弱步跻长阪，百岁期程过五亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32333,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和夔漕王韵 其二","author":"魏了翁","text":"成都别酒几何年，再见江漘岂偶然。\n胡不握兰居紫界，却来转粟上青天。\n鹏图海澨骞新味，雁断衡阳感旧联。\n国子先生书在笥，愿从熟路力加鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32334,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和夔漕王韵 其一","author":"魏了翁","text":"开济堂前送棹歌，渊渊船鼓伐灵鼍。\n云埋白帝千山小，浪拍青天一叶过。\n解后天涯惊易别，顾瞻水剂得如何。\n惟馀报国忠肝在，铁石云坚尚可磨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32335,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"建士施霆亨自夔以诗相迓","author":"魏了翁","text":"三峡云连白帝城，风波九死得馀生。\n虎头狼尾乱流济，猫面马肝缘壁行。\n中衍何妨需在险，心亨但见坎常平。\n况逢诗友慇勤问，宁复穷途哭步兵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32336,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"武康主簿吴挽诗","author":"魏了翁","text":"羯末誇群从，凝徽肖一之。\n风花摇切梦，梅雪照诗脾。\n日短乌声急，天寒雁影悲。\n广轮高隐地，千古一涟洏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32337,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"知广安军勾侯挽诗","author":"魏了翁","text":"突兀双楠树，翘枝照户青。\n春风吹湑湑，秋雨立亭亭。\n蚁梦迷符竹，牛涔兀屏篂。\n但令根本在，有茁媚阶庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32338,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"知合州赵侯挽诗","author":"魏了翁","text":"悃愊古循吏，宽和乡善人。\n鸾宫六老会，月墅四时春。\n转眼园松老，惊心宰木新。\n来迟伤杜牧，宾主总成尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32339,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"知叙州史侯挽诗","author":"魏了翁","text":"便乘龙岁去，吾党果何观。\n春味注眉睫，秋河悬舌端。\n仁心随处见，民事切身看。\n十载升堂梦，阶庭茁紫兰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32340,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"知崇庆府致政何君挽诗 其二","author":"魏了翁","text":"不把英雄彀，移为仕进媒。\n邑獒群怪吠，灶婢亦惊猜。\n且效功成退，宁须兴尽回。\n芸芸终有谢，赢得早归来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32341,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"知崇庆府致政何君挽诗 其一","author":"魏了翁","text":"外监名父子，元方难弟兄。\n鹤空黄壤梦，雁续紫霄声。\n山远玉无胫，春多天有情。\n至今溪上月，犹傍碧梧明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32342,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"罗承事挽诗","author":"魏了翁","text":"人为浮名若挂钩，夫君知命独休休。\n寒乌落日风林晚，老雁长云夜壑秋。\n宝剑装留松影里，黄金籯在架签头。\n便随丹旐堂堂去，宰木号寒起伏牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32343,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"罗监庙挽诗","author":"魏了翁","text":"春风擢擢秀阶庭，岁晚悠然物外身。\n不把簪缨伤野趣，肯迂剑骑拂天真。\n种成坟上一枝桂，空老堂前百岁椿。\n乡里善人今已矣，龙门送客一酸辛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32344,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"茂叔兄还乡北郊酌别","author":"魏了翁","text":"动是三年别，才堪十日留。\n苍头相与并，软语未能休。\n祇搅逍遥梦，真成浪泊游。\n相期各努力，岁月鬓边遒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32345,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"范圣问之母孺人史氏挽诗","author":"魏了翁","text":"是中无一物，快活不容言。\n以此行州里，留之遗子孙。\n寒泉鸿雁影，落日凤皇原。\n三复幽堂志，夫人不死存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32346,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鱼耶孙氏挽诗","author":"魏了翁","text":"可堪风撼木，不见雪盈簪。\n嫠纬愁春昼，儿书课夜深。\n米盐毋我累，茕独是予心。\n未报熊丸苦，寒堂服已廞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32347,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"临邛张夫人之葬某既先事为之识竁今日月有时而某俨在衰绖义不获往吊又不能为文以侑虞殡命儿冲代赋","author":"魏了翁","text":"殗叶重葩两大门，只凭道义世昏姻。\n养成气质槐为芷，发见仪容竹有筠。\n自是子能为国士，何须女必嫁官人。\n世衰俗薄昏成市，三复碑铭愤满巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32348,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"前利路运判冲佑李君挽诗 其二","author":"魏了翁","text":"从橐心知旧，枢庭肺腑亲。\n不从呼尔食，宁独曳其轮。\n吴子杰魁士，黄公忠荩臣。\n所知非所厚，亦足验为人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32349,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"前利路运判冲佑李君挽诗 其一","author":"魏了翁","text":"笃谨宁违俗，清淳不近名。\n几多岐上泣，独自吉中行。\n岁晚露沾草，山空霜满荆。\n南溪后月夜，的的为谁明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32350,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南郊祖帐赋五十六言呈刘左史","author":"魏了翁","text":"绿水青畦泼眼明，红英翠柏伴将迎。\n春怀拍拍浑无极，王事匆匆苦有程。\n迅驿星驰惊客梦，白袍鹄立唤人行。\n所嗟文物寥寥甚，况忍同时别两卿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32351,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"叙州弟挽诗 其一","author":"魏了翁","text":"与女为兄弟，前年五十年。\n并驱骖接革，偕立雁羞肩。\n此意春融泄，中年俗纠缠。\n每期身蚤退，白首对床眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32352,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"叙州弟挽诗 其二","author":"魏了翁","text":"祸我天何酷，子归自古诚。\n女孥俄别父，宗直亦辞兄。\n家难已稠叠，寇氛方满盈。\n分明天有眼，不照此时情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32353,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"叙州弟挽诗 其三","author":"魏了翁","text":"人物寂寥甚，天心分付谁。\n禦戎伤畜缩，讲学病支离。\n吏横民重足，时危命一丝。\n若人天亦靳，抚事转伤悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32354,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]