[{"title":"元日同麻万纪王振叔行南寺五首 其三","author":"周行己","text":"寒风昨夜动天起，春色今朝入眼浓。\n桥北斜斜柳垂绿，岸南细细草生茸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57724,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"元日同麻万纪王振叔行南寺五首 其四","author":"周行己","text":"南寺桥头缓缓归，却来高阁更迟迟。\n水边白鹭双双立，树杪乌鸦个个飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57725,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"元日同麻万纪王振叔行南寺五首 其五","author":"周行己","text":"出自西门入北门，南回东转逐村村。\n轻黄浅绿饱经眼，却得归来细细论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57726,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"哭吕与叔四首 其一","author":"周行己","text":"平生已作老蓝川，晚意贤关道可传。\n一篑未容当百涨，独将斯事著馀篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57727,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"哭吕与叔四首 其二","author":"周行己","text":"淹留也复可疑人，不向清朝乞此身。\n芸阁校雠非苟禄，每回高论助经纶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57728,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"哭吕与叔四首 其三","author":"周行己","text":"朝闻夕死事难明，不尽心源漫久生。\n手足启云犹是过，默然安得议亏成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57729,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"哭吕与叔四首 其四","author":"周行己","text":"朝廷依制起三王，叹惜真儒半已亡。\n犹有伊川旧夫子，飘然鹤发照沧浪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57730,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"睡起偶书二首 其一","author":"周行己","text":"晴日薰人午睡迷，轻舟小楫梦中归。\n觉来搔首窗前立，草绿花红燕子飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57731,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"睡起偶书二首 其二","author":"周行己","text":"炉香一炷满床书，野杏山桃三四株。\n食罢睡馀还独立，一身此外复何须。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57732,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"潇湘暮雪","author":"周行己","text":"冻云垂地雪纷飞，日暮天寒雁已归。\n犹有江头问津者，不知此去欲何依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57733,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春闺怨三首 其一","author":"周行己","text":"春尽辽阳无信来，花奁鸾镜满尘埃。\n黄莺恰恰惊人梦，欲到郎边却么回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57734,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春闺怨三首 其二","author":"周行己","text":"深院无人帘幕垂，漫裁白纻作春衣。\n停针忽忆当年事，羞见梁间燕子飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57735,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春闺怨三首 其三","author":"周行己","text":"燕子引雏来去飞，杨花漠漠草萋萋。\n窗前睡起浑无绪，倚遍栏干日又西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57736,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示负书","author":"周行己","text":"平生万卷漫多闻，一悟中庸得本真。\n从此尽将覆酱瓿，只于心地起经纶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57737,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"留题祇陀僧房","author":"周行己","text":"回舟小息取僧房，一枕春风意味长。\n江上鹁鸪啼雨罢，隔洲烟树日苍苍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57738,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"从姚毅夫乞酒","author":"周行己","text":"春来不饮动经旬，空戴陶潜漉酒巾。\n风雨恼春愁独坐，提壶无事故撩人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57739,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示提壶","author":"周行己","text":"藜杖芒鞋一幅巾，翛然无事可关身。\n一壶任醉春长在，南北东西作主人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57740,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"武陵烟雨","author":"周行己","text":"桃花流水武陵源，烟雨冥冥暗一川。\n试问山中避秦者，不知此景是何年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57741,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次邢元辅知府韵二首 其一","author":"周行己","text":"飘零南北道，祇为草堂留。\n佳句堪排闷，端居正复愁。\n何年寻旧壑，无路借前筹。\n拟访乘槎客，真仙不可求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57742,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次邢元辅知府韵二首 其二","author":"周行己","text":"高斋连大厦，安隐客心舒。\n每发难逢笑，时翻未见书。\n艰难恩意重，零落旧游疏。\n欲买西河地，终焉此荷锄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57743,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"香炉峰","author":"周行己","text":"护国门前似匡阜，云峰路上认香炉。\n重重妄想虽堪叹，也胜尘埃看画图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57744,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"坡南塘","author":"周行己","text":"荥阳居士居罕出，高堂华厦安于山。\n人自垫溺岂关我，乃复辛苦事所难。\n徒杠未成天欲寒，风吹溱洧波漫漫。\n安得亟语贤刺史，刺史爱民如赤子。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57745,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"古意","author":"周行己","text":"南山有玄豹，七日不下食。\n欲泽雨露洁，成彼文章饰。\n皮成为身菑，不如生羽翼。\n只愁羽翼成，复遭罗且弋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57746,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"钟离中散草书","author":"周行己","text":"学书如学禅，心悟笔自到。\n若非贤达人，安能字画妙。\n鸟迹不必传，篆籀亦异好。\n草圣实奇伟，变化不可料。\n张颠号神特，酒酣一脱帽。\n要识善用心，乃知皆同调。\n近世有钟离，笔力绝能绍。\n不必卫夫人，自是过逸少。\n浩如观波澜，划见鲸尾掉。\n宛转或游龙，突兀忽峰峭。\n精逸一何有，信是得其奥。\n岂但挥端毫，亦足见风操。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57747,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"出都门","author":"周行己","text":"攘攘宇宙内，经营固多端。\n有求皆劳生，此身岂能安。\n艰难出都门，所历百辛酸。\n秣马临远道，欲去复盘桓。\n久客人情深，决别泪汍澜。\n亲知无别语，劝我但加餐。\n去去忍回首，西望路漫漫。\n缅怀白云下，矫首时独看。\n平生扁舟兴，来此事征鞍。\n来时颜色好，归时衣裳宽。\n上马不能恨，下马不敢叹。\n但愿还家乐，不辞行路难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57748,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题永宁传舍","author":"周行己","text":"浩浩车马迹，往来各有求。\n而我亦何为，行役不得休。\n惊风吹沙砾，草木春不柔。\n荒山相经互，渭水日悠悠。\n下马古驿亭，开轩竹修修。\n飒飒爽气入，得慰征途忧。\n移床取一息，摵摵如清秋。\n永愿息鞍马，何当具扁舟。\n我生湖海间，筑居必清幽。\n城南五亩宅，山高水亦流。\n家园千木奴，不贵万户侯。\n既输东皋税，一饱亦易谋。\n藐然尘嚣外，荣贵如浮沤。\n咄咄狂痴子，胡为此淹留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57749,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢黄袭明吴君宝见访","author":"周行己","text":"平生敬爱人，经月不一面。\n出处各有道，淡泊终所愿。\n避喧繁台寺，稍息奔走贱。\n岂是蒋诩人，佳客来不倦。\n不责礼数优，草草具盘馔。\n为歌朱丝弦，知音我所恋。\n日暮翩然去，思君情如线。\n乘兴还一来，慎莫比秋扇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57750,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送王六簿康朝之长安","author":"周行己","text":"君官洛水北，门前是官路。\n官路尘土多，君行向何处。\n晨朝束行李，西望长安树。\n惨惨寒风吹，行人不敢顾。\n古来行路难，君行慎许与。\n故人日已新，新人即复故。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57751,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵张才叔蔡天复詹持国二月一日同步城南","author":"周行己","text":"人生本自得，苦为百虑疚。\n穷年灯火窗，郁没令人瘦。\n方春万物作，欣欣共晴昼。\n步履聊出郭，疏散忘隘陋。\n当时二三子，来往心疏透。\n欢然共携手，住处同一簉。\n弱柳分已绿，小桃红欲溜。\n细草软宜籍，急流清可漱。\n杯倾野桥边，酒从村店售。\n脱帽看晴云，击木杂鸣咮。\n或静欲寂默，或狂忽腾蹂。\n野老愕僵仆，村童怪惊走。\n恐是天上仙，无乃人间秀。\n潇洒羲皇上，磊落汉庭右。\n日暮欲返步，已行更引脰。\n此会得真率，他时涣邂逅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57752,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵林千之秋夜见怀","author":"周行己","text":"清夜炯不寐，虚窗入圆璧。\n鸿雁正南飞，庭柯已改色。\n四运无停景，欻见节序隔。\n百物自穰穰，吾心自寂寂。\n秋物本何悲，君悲当自适。\n楚玉非达士，泪苦为秋滴。\n不如陶渊明，浊醪度晨夕。\n以兹俟君子，须要生理得。\n一饮置君忧，再饮□君□。\n我感知己分，为子豁丹臆。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57753,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"述忆二十韵奉赠段公度欧阳元老","author":"周行己","text":"少小从结发，读书怀古人。\n年未十四五，出走京洛尘。\n当时黉堂士，教我文章新。\n气格一入俗，至今不复振。\n病骥思逸足，鞭策伤苦辛。\n切云漫崔嵬，惭愧席上珍。\n迩来二三子，论交偶情亲。\n以我忘疵贱，所得皆凤麟。\n念我勤服义，嘉我能仁亲。\n故此倾丹臆，诲我日谆谆。\n论诗到平淡，文师韩子纯。\n学道贵能行，卓尔非因循。\n生平志已定，不复顾狺狺。\n脱略尘累絷，逝将游广津。\n一披雾豹姿，豁然开我神。\n人生贵相知，愿言结近宾。\n颇恨相得晚，甚知二子真。\n乐此臭味同，缔好期终身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57754,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"巫山高","author":"周行己","text":"谁谓巫山高，朝言暮可期。\n而我有所思，邂逅藐无时。\n谁能心似石，见此月如眉。\n款款琴上声，此意人讵知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57755,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"有所思","author":"周行己","text":"春风应应至，寸草亦知时。\n人生非木石，谁能无所思。\n桃花乱愁眼，柳叶忆蛾眉。\n所思良不遂，愿言何可期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57756,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重游仙岩","author":"周行己","text":"此地一为别，风尘歧路赊。\n登临原有待，岩谷更重华。\n石窦寒凝髓，虹梁迥缀霞。\n仙源端可狎，飞辔绕林涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57757,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"石桥","author":"周之深","text":"地险知人特地来，猿禽意思也徘徊。\n遥瞻圣境真如在，休问石门开未开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57758,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游清果寺","author":"周之深","text":"西郊出郭未十里，寺在白云深处藏。\n僧为爱闲长闭户，客来无路自回廊。\n近松古瓦落夜子，傍水小池生暮光。\n指点依稀饭箩水，不知何处问兴亡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57759,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游虎丘","author":"阎与道","text":"高僧足一丘，门外漫维舟。\n车马倦尘境，林泉清晚秋。\n石分秦剑利，云伴女坟愁。\n回首群鸦暮，飞鸣丈室头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57760,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"白云亭","author":"郑道","text":"天风吹我上齐云，小涧清从石乳分。\n濯罢尘缨吾欲忘，白云满地未斜曛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57761,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同太守游东湖","author":"刘棠","text":"兀兀尘编日自迷，怪来春色转芳菲。\n吹嘘气象湖山远，点缀工夫草木微。\n挈榼不辞倾美酒，挥戈宁解住残晖。\n身闲官冷何欣幸，秉烛长随五马归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57762,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄张贶","author":"傅求","text":"利锁名缰脱者希，钟鸣漏尽尚忘归。\n独全至乐能齐物，未达高年遂拂衣。\n明月数声仙鹤唳，秋风一尺鲙鲈肥。\n赏心乐事知多少，只恐蒲轮到钓矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57763,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"傲暑栖霞洞","author":"李彦弼","text":"嵌窦栖霞，??转杓。\n左骖鸾翼，右耳凤箫。\n爽排酷烈，境邈氛嚣。\n静者多妙，于焉消摇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57764,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与曹圣延游风洞及七星观遂成长句","author":"李彦弼","text":"文英子建声华烜，少陵尝咏波澜阔。\n遐流亹亹钟宜春，观君紫芝真秀拔。\n华山騄耳汗血孙，奚取王良手刍秣。\n骎骎凌厉追遗风，胡为顿缨驰骆越。\n谁嗟长庚有老裔，壮龄直欲排紫闼。\n初从附凤矫飞翔，晚乃射虎耽疏豁。\n强颜方喜安斗筲，禀分何能愧圭撮。\n胸中琳琅茀埃?，自恧铅锋乏破割。\n时过西邻蕲发药，霤引玉泉浇胏渴。\n新商执矩早威令，甘霔腾虚摧虐魃。\n约君飘凫泛沧漪，背负青天□夭阏。\n风来空穴袭发毛，刷腋凉飙振絺葛。\n泠然便拟子列游，不待别起青蘋末。\n徐跻七星跐山椒，杓魁歊虚状旋斡。\n近君白雪热何有，高谈一激锥囊脱。\n扳肩作者古蹊径，馀事篇章随击钵。\n盘趺不减二华君，妙阅枯棋战挑捾。\n光驺摇纵莫可留，四序翩翩几箭筈。\n顷看金柳流莺鸣，俄听玉露丛蝉聒。\n清辉默韵无弦琴，乌用檀槽挥一抹。\n我方骚愁愁到骨，潜睨蠹蟫眉目繓。\n徒操诗穷拥鼻吟，□或酒酣将月喝。\n生平刚肠久已屈，赖尔匹夫难志夺。\n故交纷纭翱赤霄，大钧播物昭穷达。\n德尊一代元坎坷，儒腐百年决粗粝。\n南溟垂翅云翼收，北窗默卧霜须捋。\n病马犹期春草长，涸鱼终需江水活。\n君行趋觐长安日，轶兴横秋畴可遏。\n公卿倾风定援手，鸿造机缄由一拨。\n江湖要作迥相忘，静言可笑相濡沫。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57765,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闺怨二首 其一","author":"司马槱","text":"销尽轻寒不自禁，新愁唯向静中深。\n寻常曾入三更梦，咫尺空论万里心。\n人去凤帏云漠漠，雁回珠箔日沈沈。\n春风洞口花长在，只许刘郎一度寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57766,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闺怨二首 其二","author":"司马槱","text":"绣帘珠箔一重重，十里香风入眼浓。\n镜合紫鸾来有信，云深青鸟去无踪。\n楚王台下寻常见，宋玉墙头取次逢。\n可惜好花攀折尽，飘零芳蕊付游蜂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57767,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"风水洞","author":"司马槱","text":"藤梢蔓荒寒，藓花阴空青。\n窈窕石窦中，两耳风雨并。\n初闻声萧骚，活火急铜瓶。\n再听逗馀响，万羽起寒汀。\n我疑此山空，石脚连沧溟。\n中有蛟龙蛰，鼻息隐雷霆。\n又迓仙翁去，丹灶留岩扃。\n至今炉鼎中，水火争不停。\n山前老比丘，霜眉眼如萤。\n能传古老语，濯我耳昕醒。\n便欲慰尘凡，脱我随爽灵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57768,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蜕龙洞 其一","author":"司马槱","text":"雷雨何时起蛰龙，苍痕夭矫石岩空。\n不绿嗜好寻刘累，定向人閒试叶公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57769,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蜕龙洞 其二","author":"司马槱","text":"梅萼春前破，松髯雨后滋。\n石崖鸣野鹤，竹坞窜香狸。\n山脚重重转，溪流泯泯迟。\n慇勤窥洞府，又得濯龙池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57770,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题清泠轩","author":"司马槱","text":"石冷苔生晕，风高竹度凉。\n道人何处去，春色半沧浪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57771,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游九锁","author":"司马槱","text":"撩花踏水细寻香，閒逐孤云入翠冈。\n九锁已深看更好，七人相对话应长。\n百年空向尘埃老，五月聊乘洞府凉。\n可笑潜川狂道士，未逢玉室与金堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57772,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"洛春谣","author":"司马槱","text":"洛阳碧水扬春风，铜驼陌上桃花红。\n高楼叠柳绿相向，绡帐金銮香雾浓。\n龙裘公子五陵客，拳毛赤兔双蹄白。\n金钩宝玦逐飞香，醉入花丛恼花魄。\n青娥皓齿列吴娼，梅粉妆成半额黄。\n罗屏绣幕围寒玉，帐里吹笙学凤凰。\n细绿围红晓烟湿，车马騑騑云栉栉。\n琼蕊杯深琥珀浓，鸳鸯枕镂珊瑚涩。\n吹龙笛，歌白纻，兰席淋漓日将暮。\n君不见灞陵岸上杨柳枝，青青送别伤南浦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57773,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"司马槱","text":"身既事十主，女亦妃九龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57774,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江干小雪","author":"司马棫","text":"枫落吴江小雪天，三三两两捕鱼船。\n蹇驴瘦马何方客，眼看风波不著鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57775,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"妾薄命","author":"司马棫","text":"二月春风初不恶，后园桃李先春落。\n高堂去妇对花愁，君恩非轻妾命薄。\n忆昔三星光在天，煌煌车马朱门前。\n结缡幸得事君子，愿托丝萝千万年。\n履痕才遍君家地，相看已觉君心异。\n门外新欢一破颜，室中旧爱双垂泪。\n妾心比玉自坚贞，君眼如星到处明。\n女子睽离太山重，丈夫弃置鸿毛轻。\n莫誇绿发红颜好，女色由来何可保。\n君不见灞上銮舆祓禊回，阿娇已向长门老。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57776,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春晚独游凤林园","author":"司马棫","text":"红英乱点绿苔钱，林影扶疏翠可怜。\n飞蝶惹残花上露，戏鱼摇碎水中天。\n金羁不见寻芳马，兰棹空停载酒船。\n送尽春归人未老，莺啼花发又明年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57777,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"茅斋","author":"司马棫","text":"坐见茅斋一叶秋，小山丛桂鸟声幽。\n不知叠嶂夜来雨，清晓石楠花乱流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57778,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"哭兄","author":"司马棫","text":"谁教作雁破群飞，一舸南游遂不归。\n乍见音容悲且喜，不知魂梦是邪非。\n陟冈望远心犹在，携幼还家意已违。\n泪眼重寻丘壑去，可堪犹采故山薇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57779,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"华亭峡道中","author":"司马棫","text":"山似九折坂，河非八节滩。\n跻攀复揭厉，奈此行路难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57780,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题凤栖寺","author":"陈希伋","text":"千载传闻孰是非，高梧脩竹晚风微。\n欲知古寺曾栖凤，楼殿今无燕雀飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57781,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"吴习礼","text":"湖北封疆最上游，荆门中有惠泉流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57782,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"范温","text":"夷甫雌黄须倚阁，君卿唇舌要施行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57783,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"朴景绰","text":"胜事年年传习久，盛观全属远方宾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57784,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"罗可","text":"斜侵潘岳鬓，横上马良眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57785,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"紫竹","author":"张重","text":"颜色耐雪霜，桃李不能妒。\n但取节操高，莫起夺朱恶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57786,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"刘正夫","text":"紫宸朝罢衮衣闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57787,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]