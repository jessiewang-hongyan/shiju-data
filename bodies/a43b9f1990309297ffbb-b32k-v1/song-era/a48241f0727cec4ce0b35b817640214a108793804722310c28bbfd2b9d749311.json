[{"title":"句 其一","author":"张致远","text":"曾井有泉消毒瘴，程江无屋祠高贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55577,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和遗绡女子 其一","author":"张资","text":"浓麝应同琼体织，轻绡料比杏腮红。\n虽然未近来春约，已胜襄王魂梦中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55578,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"应约访遗绡女子","author":"张资","text":"何人遗下一红绡，暗遣情怀意气饶。\n勒马住时金?脱，亚身亲用宝灯挑。\n轻轻滴滴深深染，慢慢寻寻紧紧□。\n料想佳人初失却，几回纤手摸裙腰。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55579,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和遗绡女子","author":"张资","text":"香来著吾怀，先想纤纤手。\n果遇赠香人，经年何恨久。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55580,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和遗绡女子 其二","author":"张资","text":"自得佳人遗赠物，书窗终自独无寥。\n未能得会真仙面，时赏香囊与绛绡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55581,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"立春日禊亭偶成","author":"张栻","text":"律回岁晚冰霜少，春到人间草木知。\n便觉眼前生意满，东风吹水绿差差。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55582,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"八翁吟十首 其十","author":"张载","text":"篮舆多病八吟翁，云宾溪叟恣游从。\n清时无事青山醉，青山仍醉最青峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55583,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"八翁吟十首 其九","author":"张载","text":"褒斜谷口卧龙翁，量如江海风如虹。\n不应三顾逢先主，至今千载慕冥鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55584,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"八翁吟十首 其八","author":"张载","text":"一身无碍竺乾翁，遍圆身世戒身同。\n船师从我乘桴去，顽空中与指真空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55585,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"八翁吟十首 其七","author":"张载","text":"寓言豪诞漆园翁，夸谈名理浩无穷。\n早知悬解人间世，争知悬解不言中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55586,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"八翁吟十首 其六","author":"张载","text":"青牛西去伯阳翁，当年夫子叹犹龙。\n立言为恐真风丧，岂知言立丧真风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55587,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"八翁吟十首 其五","author":"张载","text":"龟山山下感麟翁，麟翁知己几时逢。\n自从颜孟希踪后，几人今日更希踪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55588,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"八翁吟十首 其四","author":"张载","text":"老原原上卜年翁，感天功业地天聪。\n流言未信成王悟，悟成全得起禾风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55589,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"八翁吟十首 其三","author":"张载","text":"磻溪溪畔钓鱼翁，濯缨溪水听溪松。\n龟猷未告非熊兆，渔蓑堪笑老龙钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55590,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"八翁吟十首 其二","author":"张载","text":"傅岩岩下筑岩翁，幽通心与帝心通。\n忧勤未感思贤梦，相霖何日见成功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55591,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"八翁吟十首 其一","author":"张载","text":"步虚声里八奇翁，八奇须信古英雄。\n宾朋未散山翁醉，听歌同入醉乡中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55592,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"土床","author":"张载","text":"土床烟足紬衾暖，瓦釜泉乾豆粥新。\n万事不思温饱外，漫然清世一閒人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55593,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书斋自儆","author":"张载","text":"画前有易不知易，玄上求玄恐未玄。\n白首纷如成底事，蠹鱼徒自老青编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55594,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贝母","author":"张载","text":"贝母阶前蔓百寻，双桐盘绕叶森森。\n刚强顾我蹉跎甚，时欲低柔警寸心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55595,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乐处","author":"张载","text":"乐处加功勉处行，事无甘苦必心亨。\n絅衣容有文章在，低首时人莫怨争。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55596,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"圣心","author":"张载","text":"圣心难用浅心求，圣学须专礼法修。\n千五百年无孔子，尽因通变老优游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55597,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"白发","author":"张载","text":"白发千梳昼景暄，乌瓶一啜夜窗寒。\n庙堂勤苦茅斋静，不见人心是两般。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55598,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"含云寺书事三首 其一","author":"张载","text":"山前咫尺市朝赊，垣屋萧条似隐家。\n过客不须携鼓吹，野塘终日有鸣蛙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55599,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吕不韦春秋","author":"张载","text":"秦市金悬鲁史修，措辞当日两难求。\n书传果在西迁后，锥口诸儒未必休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55600,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"有丧","author":"张载","text":"有丧不免道终非，少为亲嫌老为衰。\n举世只知隆考妣，切思不见我心悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55601,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江上夜行","author":"杨时","text":"冰壶潋滟接天浮，月色云光寸寸秋。\n不用乘槎厉东海，一江星汉拥行舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55602,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"老大","author":"张载","text":"老大心思久退消，倒巾终日面岧峣。\n六年无限诗书乐，一种难忘是本朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55603,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"克己","author":"吕大临","text":"克己功夫未肯加，吝骄封闭缩如蜗。\n试于清夜深思省，剖破藩篱即大家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55604,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吕子进知睦州予追送累日别后寄之","author":"张举","text":"篱鴳云鹏各有程，匆匆相别未忘情。\n恨君不在篷窗底，共听萧萧夜雨声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55605,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"别馆中诸公","author":"张载","text":"九天宫殿郁岧峣，碧瓦参差逼绛霄。\n藜藿野心虽万里，不无忠恋向清朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55606,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"我欲","author":"张载","text":"我欲庭前木叶疏，病枝衰蔓手披除。\n从今燕坐无通塞，来往风烟任卷舒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55607,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"芭蕉","author":"张载","text":"芭蕉心尽展新枝，新卷新心暗已随。\n愿学新心养新德，旋随新叶起新知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55608,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"卷耳解","author":"张载","text":"闺阃诚难与国防，默嗟徒御困高冈。\n觥罍欲解痡瘏恨，采耳元因备酒浆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55609,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诗一首","author":"张载","text":"学易穷源未到时，便将虚寂眇心思。\n宛如童子攻词赋，用即无差问不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55610,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诗上尧夫先生兼寄伯淳正叔 其一","author":"张载","text":"先生高卧洛城中，洛邑簪缨幸所同。\n顾我成年清渭上，并游无侣又春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55611,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"神功盛德诗 其三 亨龙","author":"华镇","text":"瞻彼亨龙，应时而作。\n维云维雷，以引以翼。\n大人有徽音，物被其泽。\n德馨孔昭，休命爰锡。\n蕞尔汾晋，秽我王路。\n天诛久稽，爰赫斯怒。\n大明继昭，晞彼朝露。\n文轨攸同，平平天步。\n朱干雕戈，包以虎皮。\n脱剑解胄，敦说书诗。\n钟鼓喤喤，俎豆仪仪。\n相我斯成，以永丕基。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55612,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"神功盛德诗 其四 猗欤","author":"华镇","text":"猗欤道真，厥心希微。\n我则道之，万物纷错，我摄之以无为。\n股肱良矣，心膂则奇。\n荡荡妙用，民莫之知。\n既绥寰中，亦静四夷。\n承休垂裕，维君维师。\n雍雍和声，召彼协气。\n散为丰年，凝为嘉瑞。\n三脊之茅，四海之美，惟帝王是致。\n岩岩太山，升于天中。\n鸾舆戾止，玉检金封。\n汾脽千里，亲飞六龙。\n上下昭报，神明以通。\n在昔图书，出于河洛。\n有龙有龟，前圣之作。\n惟天无亲，德侔斯格。\n我躬受之，宝符神筴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55613,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"兼山阁雨中","author":"朱熹","text":"两山相接雨冥冥，四牖东西万木青。\n面似冻梨头似雪，后生谁与属遗经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55614,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送苏修撰赴阙四首 其四","author":"张载","text":"出异归同禹与颜，未分黄阁与青山。\n事机爽忽秋毫上，聊验天心语默间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55615,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送苏修撰赴阙四首 其三","author":"张载","text":"阖辟天机未始休，袗衣胝足两何求。\n巍巍只为苍生事，彼美何尝与九州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55616,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送苏修撰赴阙四首 其二","author":"张载","text":"道大宁容小不同，颛愚何敢与机通。\n井疆师律三王事，请议成功器业中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55617,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送苏修撰赴阙四首 其一","author":"张载","text":"秦弊于今未息肩，高萧从此法相沿。\n生无定业田疆坏，赤子存亡任自然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55618,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梦中作","author":"张惇","text":"楚峡云娇宋玉愁，月明溪净印银钩。\n襄王定是思前梦，又抱霞衾上玉楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55619,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"神功盛德诗 其五 惟天","author":"华镇","text":"上天之载，引之惟逸。\n原民之生，天子之职。\n我安其止，弗扰弗刻。\n厥德罔愆，宜符帝则。\n我征既宽，我役不烦。\n息我干矛，审尔刑冤。\n井饮田食，日舒以闲。\n鸿化何为，淳风载还。\n俾尔息而庶，俾尔厚而富。\n黄发稚齿，既仁且寿。\n帝歆其馨，介我纯祐。\n其祐维何，如商之戊。\n天地其行，既长且久。\n宠绥下民，克念厥后。\n取我元良，锡之九有。\n不失其传，益羡三后。\n惟尧舜为难，惟我则不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55620,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"神功盛德诗 其六 德渊","author":"华镇","text":"世德之渊，庆流瀰瀰。\n笃生哲后，在宗之子。\n其积弥新，有闻不已。\n文考受之，以肖以似。\n人之攸归，天命爰止。\n天命靡常，惟德惟功。\n神圣有作，历数在躬。\n正位东朝，遂成大宗。\n协和万邦，万邦以雍。\n沈沈神机，其动其时。\n和柔以刚，克爱以威。\n肃之振之，俾无或隳。\n功则未既，思有宏规。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55621,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"神功盛德诗 其七 皇猷","author":"华镇","text":"皇有大猷，其成落落。\n文武不世，千载无作。\n圣人勃兴，积厚施博。\n作之新之，以底远略。\n既发我明，既达我聪。\n合变体经，神化无穷。\n长毓儒雅，蓄砺兵戎。\n无思不服，物有其容。\n夙夜不怠，济我丰功。\n济济朝廷，有名有实。\n多士在服，百工励翼。\n礼乐兴矣，刑政既达。\n郁乎有文，绍周之则。\n绵绵句丽，莽莽河湟。\n绝彼东海，逸于西疆。\n或剪或怀，德威孔扬。\n列我郡县，袭我衣裳，于前人有光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55622,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"萱草","author":"张载","text":"萱草花开十日馀，花繁日日倍于初。\n朝开暮落终非计，栽活青松渐剪除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55623,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"葛覃解","author":"张载","text":"葛蔓青长谷长迁，女工兴念忆归安。\n不将贵盛骄门族，容使亲心得尽欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55624,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题北村六首 其六","author":"张载","text":"渭南泾北已三迁，水旱纵横数顷田。\n四十二年居陕右，老年生计似初年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55625,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题北村六首 其五","author":"张载","text":"不堪烦暑病荒城，六月翛然寓野亭。\n珍重南山且归去，再来相望雨中青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55626,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题北村六首 其四","author":"张载","text":"风泉盈耳鬓斑斑，林下幽窗对万山。\n妇子职修簟食足，病身何幸亦安闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55627,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题北村六首 其三","author":"张载","text":"负郭吾庐二顷田，面山临水跨通川。\n苏秦妾妇无高识，盛诧腰间六印悬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55628,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题北村六首 其二","author":"张载","text":"求富诚非惮执鞭，安贫随分乐丘园。\n两间茅屋青山下，赢得浮生避世喧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55629,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题北村六首 其一","author":"张载","text":"陆轴呕哑麦上场，讴歌声韵满村坊。\n茅斋病叟安闲久，帝力民欢殆两忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55630,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题解诗后","author":"张载","text":"置心平易始通诗，逆志从容自解颐。\n文害可嗟高叟固，十年聊用勉经师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55631,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"孤宦","author":"张载","text":"孤宦殊方意自违，邻光兹幸托馀辉。\n人心识尽童心减，世事谙多乐事稀。\n直有岁寒甘柏说，终无春思惜花飞。\n岂同毛刺墦间客，向望他门卜所依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55632,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"契重","author":"张载","text":"契重金兰屈指谁，偶然倾盖接英辉。\n疏慵唱和应嫌晚，久淡封题莫厌稀。\n致主每思烹鼎说，剪戎何日檄书飞。\n安仁久识儒家乐，老大情怀渐有依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55633,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"集义斋","author":"张载","text":"小斋新创得新名，大笔标题字势轻。\n养勇所期肩孟子，动心那肯诧齐卿。\n川流有本源源听，月入容光处处明。\n此道几人能彷佛，浪言徒遣俗儒惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55634,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"睢阳五老图","author":"张载","text":"太平气象养高闲，宴赏诸公老致冠。\n朝野已闻亲相业，庙堂曾睹漆丹桓。\n形容杰出新图粲，德泽雄沾旧俗寒。\n一片忠心涵国史，桑田虽变迥谟看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55635,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和薛伸国博漾陂","author":"张载","text":"几年烟浪掩遗踪，今意扶持古意同。\n簪笏每游高圣世，莼鲈聊为快秋风。\n轻阴岛屿莓苔湿，夜雨蛟龙窟穴空。\n南浦云峰晴不乱，北窗溪木暗难通。\n春浓岸酰成行碧，日暖汀花取次红。\n岁月可悲唐废苑，山河终近汉离宫。\n归禽影转沙堤曲，处土居邻竹坞东。\n星斗已知天象富，菱蒲堪喜地毛丰。\n持竿幸有鱼充鼎，混浴须嗟鹤在笼。\n吏隐苟能游物外，江乡何必羡吴中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55636,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"忆别","author":"张载","text":"柳絮飞时与君别，南楼把酒看明月。\n月似当年离别时，柳絮如君何处飞。\n千书百书要相就，思君不见令人瘦。\n念君情意只如初，顾我形骸已非旧。\n朝来有信渡黄河，雁足系书多网罗。\n城南城北芳草多，月明如此奈愁何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55637,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"古乐府 日重光","author":"张载","text":"日重光，天际翔，愿言贞明永瞻望。\n月重轮，淡溟渊。\n愿犹月之恒，协帝仪中天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55638,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"古乐府 东门行","author":"张载","text":"古风出东门，我行乐巾綦。\n今歌东门行，牵衣强留甘餔糜。\n仗剑去，忽如遗，时清君去予心哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55639,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"古乐府 短歌行","author":"张载","text":"灵旗指，不庭方，大风泱泱天外扬。\n短箫歌，歌恺康。\n明廷万年，继明重光。\n曾孙稼，如茨梁。\n嘉与万邦，纯嘏有常。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55640,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"君子行","author":"张载","text":"君子防未然，见几天地先。\n开物象未形，弭灾忧患前。\n公旦立无方，不恤流言喧。\n将圣见乱人，天厌惩孤偏。\n窃攘岂予思，瓜李安足论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55641,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"古乐府 鸡鸣","author":"张载","text":"鸡鸣嘐嘐兮台怀忧，兄弟表里兮台心求。\n黄金门，白玉堂。\n置酒恺乐，荣华有光。\n桃伤李僵，尔如或忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55642,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"牧牛儿","author":"张载","text":"牧牛儿，放牛莫放涧水西，涧水流急牛苦饥。\n放牛莫放青草畔，牛卧得草儿亦懒。\n儿懒随牛莫着鞭，几年力作无荒田。\n雨调风顺租税了，儿但放牛相对眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55643,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诗一首","author":"张载","text":"昌谷五月稻，平田垂青玑。\n遥峦相压叠，颓绿互蔽芾。\n竹香满凄寂，粉节涂生卉。\n攒虫锼古柳，芳径生红纬。\n莺唱子夜歌，瀑悬楚被翡。\n昭华寒不粟，贵嫔暑无痱。\n桂蕊女几簪，蕙花神娥扉。\n碧锦帖花柽，香衾事残贵。\n霞巘殷嵯峨，烟岚互叆霼。\n璧月舒窈斗，元云为彷佛。\n阴?宛虹带，天空繁星衣。\n古桧拿屃赑，水华融觱沸。\n销声永薖轴，栖隐耽岑蔚。\n请事鸿宝元，至澹味无味。\n悲歌激流风，逸响迥秋气。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55644,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诗上尧夫先生兼寄伯淳正叔 其二","author":"张载","text":"病肺支离恰十春，病深樽俎久埃尘。\n人怜旧病新年减，不道新添别病深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55645,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"古乐府 度关山","author":"张载","text":"度关山，循九州，省耕宽徭询明幽。\n人为贵兮，哀我人斯敢予休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55646,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]