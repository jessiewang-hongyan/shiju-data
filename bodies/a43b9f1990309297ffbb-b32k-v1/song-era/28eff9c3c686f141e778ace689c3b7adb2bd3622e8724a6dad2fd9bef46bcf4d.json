[{"title":"甥馆 其五","author":"许月卿","text":"国士报国士，后人哀后人。\n万物邪胜正，一理屈终伸。\n秦暴二世灭，周仁八百春。\n紫云楼上语，亿载宋深仁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40148,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"甥馆 其四","author":"许月卿","text":"国士今为鬼，有棺空断肠。\n绿衣长至节，丹旐短松冈。\n父乃哭其子，天乎歼此良。\n伤情皋某复，挽些谩巫阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40149,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"甥馆 其三","author":"许月卿","text":"醉乡真广大，静夜绝嚣尘。\n月色明如昼，天涯总是春。\n鸟飞林不夜，蝶梦路无人。\n天地中间我，孤高谁与邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40150,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"甥馆 其二","author":"许月卿","text":"冬至思吾侄，樊川示阿宜。\n驱羊官易取，观象易难知。\n不远复三字，大音声一诗。\n屏山宗邵子，晦木不忘归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40151,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"甥馆 其一","author":"许月卿","text":"月色真图画，风声古瑟琴。\n月风天地职，风月圣贤心。\n竹砌水如璧，梧冈朋盍簪。\n不须联句得，天籁竹梧吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40152,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登慈恩绝顶有感","author":"许月卿","text":"为学平生不究源，未妨绝顶上慈恩。\n塔高俯视群山小，江阔能容巨浪喧。\n人每中登难脚力，谁于高处领天根。\n须信平生为基址，基址牢时德业尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40153,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赋廷玉菊存堂","author":"许月卿","text":"祖菊园翁孙菊存，君家菊谱傲兰孙。\n天随天问非他族，秋意秋怀自一门。\n白送绕篱从谷谷，黄飘流地彼村村。\n花应自贺三生遇，亲见渊明无此孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40154,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赋吴廷圭筼西亭","author":"许月卿","text":"竹西歌吹古扬州，分与延陵第一流。\n直节雪霜霜晓槛，虚心风月月明楼。\n东南直道辉青史，朔北虚怀动玉旒。\n立尽斜阳更新月，缠腰骑鹤此君游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40155,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赋新花竹","author":"许月卿","text":"花红竹绿两相当，绿竹红花在道傍。\n竹引花风心浪动，花含竹露面芬芳。\n须知竹恋花蝴蝶，喜见花贪竹凤凰。\n彼此莫嫌花共竹，他年花老竹苍苍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40156,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"遇黄先生","author":"许月卿","text":"策马沙头值此翁，恐成鸿燕啬相逢。\n归鞭亟指远峰碧，握手频看笑脸红。\n淡月一帘清坐处，高风千载慨歌中。\n渊源自昔崇师友，吴下应怜旧阿蒙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40157,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"辞贾徽州二首 其二","author":"许月卿","text":"岫云休怪此行徐，出处家风本俗如。\n当任宣尼无俟驾，肯辞孟子范驰驱。\n如金岁月人奔竞，似玉行藏我卷舒。\n极目冥鸿挥绿绮，忘情鱼鸟尽江湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40158,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"辞贾徽州二首 其一","author":"许月卿","text":"束书归去飨梅花，底事霏英故故斜。\n约住忙中千里鹤，羡渠如意两归鸦。\n家中见雪念为客，客里观梅不似家。\n园树暂时相斗白，明朝休向我侬誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40159,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题汪端翁庙","author":"许月卿","text":"端公碑石蔓萝扪，叹息双杉拔本根。\n将略传家自忠显，侍儿枭首亦平原。\n乘风飞去乾坤窄，踏月归来烟水昏。\n往事不堪重回首，青灯黄卷照芳樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40160,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题赵尉洞源泉","author":"许月卿","text":"归去来词书印历，高风千载汝南评。\n松间风影有地籁，林下炎天无水声。\n行客诗魂同石瘦，主人心事共泉清。\n明朝遮日长安去，君亦曹装趣上京。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40161,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题项横父临清亭时方生孙","author":"许月卿","text":"青梅如豆子，更可缓临清。\n倚杖闲花落，凭栏芳草生。\n逢人须说项，生子又添丁。\n千叶桃难实，山茶耐久盟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40162,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题德新堂","author":"许月卿","text":"同年吾忆郑盘翁，独向盘铭紧用工。\n似玉躬行勤淬砺，如棋世事极磨砻。\n初年晚节浑无斁，昨日今朝便不同。\n遗子贻孙新未已，盘铭须信有奇功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40163,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠王竹窗","author":"许月卿","text":"若欲相寻向竹边，开窗着屐更谁先。\n定有一轮穿密密，可无数点洗涓涓。\n茂林从昔于侬好，太极遥怜似我圆。\n钓竿莫惜分新绿，更割半窗潇洒天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40164,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠快霖","author":"许月卿","text":"有客闯东篱，星翁身姓支。\n快霖为道号，直术不支篱。\n试与谈灾福，断然无诡随。\n小溪天下士，持此往参之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40165,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠黄藻二章 其二","author":"许月卿","text":"星邑唐诗韵一天，参军生死别经年。\n君来佳句宾朋诵，我愿世科昆弟传。\n别语明晨绕朝策，秋风来岁祖生鞭。\n难兄难弟誇京邑，莫负当年梦惠连。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40166,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠黄藻二章 其一","author":"许月卿","text":"参军一梦到词场，难弟想应瞻圣皇。\n此去捷音来鼎鼎，向来诸老去堂堂。\n马头雪絮天街玉，人迹板桥茅店霜。\n君去世科传伯氏，钓舟留我住严光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40167,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠程惠子","author":"许月卿","text":"我朝诗道愧唐人，魏晋风流更勿论。\n庄子于今逢惠子，孔门自昔契程门。\n君宜莺出云霄路，我亦猿吟烟水村。\n趁取山人来离谷，梅花湖上返诗魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40168,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠墨士程云翁","author":"许月卿","text":"满地干戈正扰攘，君家犹自捣龙香。\n轻清披就烟云质，坚劲磨来金玉相。\n倚马喜资挥露布，飞鸾端藉发天章。\n山屋莫道浑无用，留写樵歌入锦囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40169,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"八角","author":"许月卿","text":"八角亭中天似水，七言城里夜未央。\n主人解榻贤材馆，门客避堂上下床。\n籁寂寂时星历历，泉涓涓处山苍苍。\n主人门客皆觞咏，羽扇纶巾独篆香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40170,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十二辰","author":"许月卿","text":"饥鼠檐行骄捷疾，蜗牛角立争奇崛。\n似闻猛虎今陆游，从以卧兔未飘忽。\n先生龙卧未风云，春蚓秋蛇供醉笔。\n萧萧马鸣旆悠悠，牧民如羊良率易。\n人言唐土愧二猴，汉使碧鸡真浪出。\n屠狗师还戒勿用，驱猪试问问王弼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40171,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三月","author":"许月卿","text":"三月春如少年时，了知造化最儿嬉。\n智行无事柳飞絮，道法自然花满枝。\n锦绣园林天富贵，神仙院落月清奇。\n老天长似春三月，游嬉人间不皱眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40172,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与陈宰","author":"许月卿","text":"到处逢人说大苏，一门兄弟古今无。\n吹埙林五黟山马，鼓瑟陈双婺水凫。\n定分有殊自鹏鴳，闲情无限尽龙猪。\n归来坐倚蓬窗下，少挹春风过里闾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40173,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山川","author":"许月卿","text":"山川长不老，人意欲如何。\n霜后蒹葭健，秋来洲渚多。\n河汾周旧典，洙泗鲁馀波。\n悽怆从陈蔡，令人涕滂沱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40174,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山近","author":"许月卿","text":"山近绿映日，山远青带烟。\n平生有山癖，梦亦山水边。\n山好水益媚，山老水连天。\n我家非洛中，亦非独乐园。\n只在山屋上，下亦有流泉。\n俯仰颇乐之，妙处无昔贤。\n今日来别墅，水满山四环。\n呜呼何处无山水，有酒且饮明月在前山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40175,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"允杰侄以诗来卒章和予生孙次韵一百首今存四 其三","author":"许月卿","text":"山已幽幽墅更幽，幽居别墅尽居由。\n数间屋想今岑寂，万斛船忻正拍浮。\n采药幽居怜闭户，围棋别墅梦归舟。\n明朝菊径归来处，二阮黄花插满头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40176,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"六月雨十一首 其三","author":"许月卿","text":"先集流传妙诗句，芃芃禾黍舞凉秋。\n九秋宝丽从天落，一雨赋兴矧若畴。\n月更风流写松竹，雨馀凉意满汀洲。\n客来且贳邻垆酒，家酿明朝尽可篘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40177,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"六月雨十一首 其二","author":"许月卿","text":"岫云已喜能成雨，不卜先知今有秋。\n作楫作霖三说命，时旸时雨九箕畴。\n数行竹树清风夜，万顷烟波明月洲。\n二客从予游赤壁，归谋正值酒堪篘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40178,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"历日","author":"许月卿","text":"历日从头又一新，直饶燕雀喜新晴。\n梅花献岁无边景，喜鹊今朝第一声。\n柳眼知时王幕绿，草心报国汉朝青。\n日晴夜雨丰年兆，雨过云开月满庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40179,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"天道","author":"许月卿","text":"天道尊高父道同，地亲如母祀先农。\n社翁不肯饮残水，野老犹能存古风。\n箫鼓村田聊击壤，鸡豚社酒好治聋。\n满庭芳曲还堪唱，一笑东坡鬓已翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40180,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"木犀","author":"许月卿","text":"诗到黄初上，高标不肯唐。\n分封在香国，筮仕得黄裳。\n锦昼累金印，瑶英案玉皇。\n黄香天下士，谁得并清芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40181,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"归涂","author":"许月卿","text":"望外云头日高挂，竹间亭子雪犹存。\n衔芦雁起潇湘暮，卖炭人行烟火村。\n绮疏月照窗如昼，宝鼎香销帐似云。\n欲转冰壶浑未暇，党家习气彼膻荤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40182,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用名世弟韵","author":"许月卿","text":"大圭白璧男儿事，小酌青灯兄弟情。\n倚阁烟云生别浦，高林风月满疏棂。\n人生功业何损益，外物本心须重轻。\n志节始终非易事，退之犹自怵天刑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40183,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吊程贡元","author":"许月卿","text":"洒泪陈情表，何心贡泽宫。\n波平看跃鲤，浪急不成龙。\n花诰荣孀母，蓝袍付画工。\n无人俦孝友，烟树惨新封。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40184,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同滕推游朱绯堂二首 其二","author":"许月卿","text":"此翁有山癖，曾此梦魂惊。\n慷慨思逾淡，郊行酒易醒。\n石苔和梦湿，归棹载诗轻。\n回首暮云碧，两贤沙碛行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40185,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同滕推游朱绯堂二首 其一","author":"许月卿","text":"当日朱绯梦，荒烟化鹤城。\n斜阳边草色，深树里禽声。\n欲雨路微湿，出云山半青。\n神游应故里，只欠爱翁亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40186,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"早起","author":"许月卿","text":"早起轻寒尚裌衣，饭馀春雨满行旂。\n春波绿处春草碧，晓露浓时晓日晞。\n桃李年年春富贵，桑麻事事道精微。\n诗情不在火炉畔，风雪灞桥烟景归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40187,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次胡伯凯韵","author":"许月卿","text":"作诗直欲到天悭，于蔿应如元鲁山。\n我隐自便甘曲渚，子来相与钓清湾。\n闲中日月诗书府，地上神仙人世间。\n寻柳问花千古意，窗前幽草不须芟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40188,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵","author":"许月卿","text":"临川老儒王半山，文章未肯班传间。\n亦有临淄晏元献，乐府一奏开天颜。\n我来此州嗟何晚，前哲风流挽不还。\n泉石黯淡山气瘦，芙蓉飘零秋意阑。\n有客携诗来过我，议论磊落文波澜。\n诗盟岂止寻宗派，理学犹规拜将坛。\n风雷凛凛三寸舌，招槌贤拂佐天悭。\n古来言行要相副，愿言大德不踰闲。\n秋月皎皎鹤蹲蹲，春风泄泄禽关关。\n江岷山兮溪嶓冢，天根蹑兮月窟攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40189,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵李制干赠行","author":"许月卿","text":"科举有衣钵，临行问细君。\n梅花入征梦，杨叶砺功勋。\n俨对丹墀日，捷排阊阖云。\n政须及边事，毋惜齿牙论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40190,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵汪敬子","author":"许月卿","text":"好善芝兰馨，恶恶鲍鱼腥。\n一心宰天地，万世流风霆。\n六经如元气，异端如氛埃。\n会往洙泗滨，传取心印回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40191,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵陈肇芳竿赠李相士","author":"许月卿","text":"相心然后相人形，试相何时可太平。\n集思广益真宰相，开诚布公肝胆倾。\n先相君子与小人，小人枉了君子赢。\n见吾善者笑局局，眼明黄山峰六六。\n何哉逆整干天诛，衰汉生灵已鱼肉。\n安得重见无极翁，光风霁月黄山谷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40192,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵春谷","author":"许月卿","text":"谷如三月间，屋向万山安。\n春谷与山屋，别有天地宽。\n枯淡风月皎，富贵莺花绕。\n大山表牡丹，此意殊未晓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40193,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵胡温升玉甫西野","author":"许月卿","text":"偶为西湖万山出，三省兴中歌四勿。\n中庸公子惠新诗，句里韩筋犹柳骨。\n文章感慨须和平，能泣鬼神风雨惊。\n和声似鸣国家盛，送东野序序文鸣。\n西野文鸣东野法，积中和顺英华发。\n我诗不作郊岛寒，曾诛莓苔随意踏。\n谁道杨花本无才，天展湖山图画开。\n何须更问逋之觅，夜深明月半窗梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40194,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵晋三侄招予及同年饮","author":"许月卿","text":"恋阙重阳不入都，菊英虽好不干渠。\n樽前丞相方行酒，花外尧夫恰小车。\n羯末封胡延客醉，雷陈张范预期酤。\n他年三径羊裘隐，君子应能范蠡图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40195,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵晓行","author":"许月卿","text":"主人别客屡挑灯，客喜乘凉月下行。\n暗露湿萤仍湿草，晓风残月更残更。\n柔情燕燕椒房夜，雅韵莺莺桂魄晶。\n朝往长沙成夜醉，宵征肃肃醉翁亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40196,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵谢君直赠李相士","author":"许月卿","text":"一年景让秋光奇，山水秋来皆有姿。\n君于何处相人物，谁为盗蹠谁伯夷。\n伯夷海滨待时清，秋空无云正清时。\n相人不若相时好，相时而动谈笑麾。\n笑杀冯道五季时，兴亡不喜而不悲。\n相师试相冯道相，视国传舍如弈棋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40197,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"迎谒刘朔斋□提举行部","author":"许月卿","text":"百城奔走候车尘，庾节光华婺水滨。\n人望朔斋春有脚，家传元祐水无心。\n天低日近霜华晓，地僻腊残梅蕊春。\n愿得刘家再忠肃，前为伊鼎后商霖。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40198,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"閒赋","author":"许月卿","text":"老大天谙练，殷勤月往还。\n岩峦有奇操，泉石亦清谈。\n隔浦飞秋叶，开窗看夕山。\n天心端正月，潭水夜深参。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40199,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闷来","author":"许月卿","text":"闷来时暂作儿嬉，沽酒溪边就买鱼。\n鸥鸟水云天一色，梅花雪月地三奇。\n水西何况景尤绝，雪后悬知画不如。\n安得扁舟更蓑笠，闷来时暂作儿嬉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40200,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"饭了","author":"许月卿","text":"饭了庵中坐，高情等寂喧。\n井泉春户口，篆火午香烟。\n句好堪呈佛，心空不问禅。\n一声天外雁，秋意满徽弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40201,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"京城看月","author":"许月卿","text":"几千万里碧琉璃，中有一圆光照之。\n更无一物可与对，部勒星宿光陆离。\n忆昔看月大江头，天地中间风吹衣。\n凡客无缘相宾主，独携杯酒独吟诗。\n祇今千门万户闭，良夜京华无人知，似我快活更有谁。\n故山今宵月更奇，明日懒人真个归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40202,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明月","author":"许月卿","text":"明月天双鉴，清湖地万弓。\n人行杨柳外，身在画图中。\n天阔双眸快，楼高万象融。\n故山应更好，杨柳映芙蓉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40203,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南堂","author":"许月卿","text":"南堂有客䅤秋旻，面面轩窗纳晓云。\n云入书檠无俗气，月来吟几有清芬。\n岂无绿竹诗淇澳，亦有苍苔书篆文。\n阁上桂枝宜努力，难兄难弟总由人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40204,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"故人","author":"许月卿","text":"故人归作山中相，老我聊乘雪夜舟。\n细君颇讶不入市，山中访友将何求。\n扉屦资粮夺之去，毁车截镫挽予留。\n一笑谓汝贤细君，无求我乃肯出游。\n宰相良解轩轾予，定难屈膝低我头。\n同云一色天欲雪，夜深云散月明楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40205,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日闲赋","author":"许月卿","text":"数行竹树鸣春雨，一簇人家带晓烟。\n省事山丹自篱落，亲人海燕并庭檐。\n楼高思远天无极，酒罢歌阑月正圆。\n新茗一瓯香一篆，与君清坐看风帘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40206,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送抚倅林评事归班","author":"许月卿","text":"分月年将满，朝天早戒严。\n芝函新紫诏，棘寺旧青毡。\n梅雨商岩谶，槐花宰路占。\n应留待漏院，挥翰属名贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40207,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送碧梧入府","author":"许月卿","text":"人劝公入相，我劝公早归。\n今以副枢入，好以元枢回。\n易为六经宗，学易贵知时。\n时止则时行，时义大矣哉。\n故尝论今日，两语见称奇。\n但且为执政，宰相未可为。\n若为伴食相，何如酒一杯。\n曾以语裕翁，裕翁为一咍。\n英雄见略同，明公试思之。\n文正为清献，何曾美鼎梅。\n史册香万古，日月名长在。\n时止时则行，宰相须时来。\n时来然后相，当传忠定衣。\n官职难名节，愿公玉无疵。\n壮节题初节，愿公玉无灰。\n耐久老柱石，身佩国安危。\n五福一曰寿，寿国身之枢。\n请君看老子，寡欲身寿眉。\n心清万里明，可杜倖时窥。\n寡欲善养心，轩鉴照魅魑。\n岁晚成二老，种蠡相埙篪。\n坐令四太平，太宗生光辉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40208,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"除月二十三日夜梦","author":"许月卿","text":"仙君重瞳衮衣明，红云一朵当殿楹。\n千官拜舞环佩鸣，中有一人摄齐升。\n琅琅敷诵百辟惊，首云有臣许月卿。\n合在帝所式群英，煌煌召节来帝廷。\n肤使奕奕华弓旌，我时荷边食芡菱。\n坐茅心涣俨不听，从天飞下苍葱珩。\n申传帝命通叮咛，亲授秘诀餐长生。\n提耳言言帝旨令，梦回题诗香枕屏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40209,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]