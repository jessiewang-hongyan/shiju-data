[{"title":"兴龙节","author":"毕仲游","text":"簪笏千官拱帝宸，四方同日燕君恩。\n五弦度曲南风应，万寿称觞北极尊。\n金奏无哗覃雨露，瑶图有算比乾坤。\n愿为善颂赓天保，如日如山万子孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54719,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"罗山即事","author":"毕仲游","text":"吏情临老盍偷閒，异县人风倦往还。\n古屋半摧元是冢，重冈相带不成山。\n升平是处容糊口，应接非心祗强颜。\n早晚骑鲸跨沧海，欲抛簪笏寄人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54720,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"信阳军筵设乐口号二首 其一","author":"毕仲游","text":"谈笑西州塞上春，归来不薄两朱轮。\n功名致主期三代，忠孝传家第一人。\n御史平生能许国，将军未老肯谋身。\n义阳今与淮阳比，汲孺当年亦谏臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54721,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"信阳军筵设乐口号二首 其二","author":"毕仲游","text":"曾将行事著成书，前世尝闻近世无。\n帝阙天门辞禁近，蜀山秦塞任崎岖。\n殿帷昔用书囊染，皮几今随道帽乌。\n忠孝成名生计懒，义田十顷近苏湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54722,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"至曹州值罗正之著作部夫河上有阻会合以诗见意","author":"毕仲游","text":"百里传书浪有期，到头樽俎恰相违。\n春回通沇花争发，冰泮明河客未归。\n年老无成今世有，身閒不饮古人稀。\n诸公怜我如相问，为道因循未拂衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54723,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"内中考进士","author":"毕仲游","text":"北风吹雪舞长廊，束带三千笔阵忙。\n地色不通金琐涩，天香未散玉炉光。\n龙墀暴涨词源涌，鹤驾迷空羽卫翔。\n三月汉庭重射策，几人弹帻待王阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54724,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"入内考进士同考官唱和三首 其一","author":"毕仲游","text":"早岁成名地已尊，徘徊五十始乘轩。\n官同长孺宁居后，疏似王阳独上言。\n道气郁纡灊岭秀，词源浩瀚峡江浑。\n研朱共较公孙策，坐觉文风似建元。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54725,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"入内考进士同考官唱和三首 其二","author":"毕仲游","text":"未得还家意不忙，日斜人散傍修廊。\n白头已向新吟懒，青眼相逢旧话长。\n高阁无声沉昼漏，侧门有路想天章。\n闻公自谓忘怀者，今日情怀岂易忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54726,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"入内考进士同考官唱和三首 其三","author":"毕仲游","text":"明光寓直偶然同，八百儒衣度汉宫。\n下笔春雷从地起，举头帝座在天中。\n条陈不啻三千牍，品藻今惟六七公。\n况是篇章容易得，好令编集附唐风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54727,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登瀛阁","author":"毕仲游","text":"穿池引水事清幽，水有寒鱼钓艇浮。\n惯识蓬莱好风月，装成沧海旧汀洲。\n波涵弱柳双行影，露裛衰荷半顷秋。\n从此东州富宾客，非才先得从公游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54728,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秦州道中","author":"毕仲游","text":"单车五月使西州，行入秦关鸟鼠秋。\n苏季金多才过洛，子房功大愿封留。\n新诗欲报难开口，旧物閒思若转头。\n边戍移书谢妻子，捣衣相寄不须愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54729,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"别从事","author":"毕仲游","text":"从事归来半白头，吾今便欲别南州。\n穿花载酒知难得，散发行歌且自由。\n官小恰为黄绶吏，兴浓思共赤松游。\n莫嫌颍上生涯少，会向焦陂买钓舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54730,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颍州道中有感","author":"毕仲游","text":"异乡闻说颍人贤，我到常疑地使然。\n江泛五程无险岸，马行千里尽平川。\n新禾狼籍团团穟，远树婆娑簇簇烟。\n寄语汝阴官长道，会须日上泛湖船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54731,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"临颍道中值雨","author":"毕仲游","text":"野气寒云漫不收，飘风送雨冷飕飕。\n路长马怯惊蹄滑，巢湿鸦飞打树稠。\n计拙甘为黄绶吏，途穷空敝黑貂裘。\n闭门坐卧真安稳，吾道东西不自由。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54732,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"暂居河上获从致政丈朝请之游仰慕高风因成拙句","author":"毕仲游","text":"葛巾攲侧鬓毛疏，安稳扬雄宅一区。\n纵酒偶然因客至，行歌浑不用人扶。\n秾花嫩蕊何曾歇，小榭幽亭亦胜无。\n春日出郊惟跨马，牡丹才发到西都。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54733,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清河閒居","author":"毕仲游","text":"书囊药笈付妻孥，解语娇儿戏坐隅。\n几净饱看新印史，壁高亲挂旧山图。\n待凭风月招佳客，岂有功名属腐儒。\n小睡接䍦巾自落，未甘散发号狂夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54734,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"望春宋公第","author":"毕仲游","text":"宋公池馆旧相招，人比青松更后凋。\n但怪麒麟犹素壁，不知祥凤已丹霄。\n宾筵揖让虽分散，儒馆风流未寂寥。\n不比填门并拥彗，百年才过即声销。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54735,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题崇因寺","author":"毕仲游","text":"閒游偶此共攀缘，胜事谁能为我传。\n山鸟无巢任来往，溪流有石更潺湲。\n路迷空谷寒生雾，目极平林远自烟。\n便是瀛洲与方丈，不知何处有飞仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54736,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过天清寺","author":"毕仲游","text":"收拾閒官作伴来，百年怀抱为君开。\n高标不数慈恩塔，迥眺如登单父台。\n料有神明扶岌嶪，恍疑星斗接崔嵬。\n不妨痛饮相牵率，待把生涯付酒杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54737,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"曹南贡父学士席上","author":"毕仲游","text":"真珠花小帖腮垂，不分苏州说杜韦。\n汉殿香新初著体，楚宫腰怯未胜衣。\n风林巢稳莺雏嫩，水阁梁高燕子飞。\n欲作清诗答清唱，恨无清思敌玄晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54738,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贺吕子进舍人告谢","author":"毕仲游","text":"金殿移班再拜归，门庭未冷又光辉。\n百年相府风流在，三世词臣际会稀。\n应复异时当化笔，莫留同甲弊朝衣。\n似观天上三阶正，又有文星入紫微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54739,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和子思舅","author":"毕仲游","text":"闻说幽居傍北溪，莫将归思作新诗。\n未为野客随翁去，应被山僧笑我痴。\n近日病中为酒敌，他年物外得禅师。\n林泉漫有花开约，借马相从能几时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54740,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和陈子思舅探梅","author":"毕仲游","text":"晓过东堂探早梅，山翁指处一枝开。\n只怜旧路无人到，谁为新诗有意裁。\n晚雪欺凌空自怨，春风吹拂似相猜。\n更须催问今朝客，有酒有花宜早来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54741,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵苏子瞻内翰入直锁院赐官烛法酒","author":"毕仲游","text":"兼金作带玉为郎，夜步花砖拜赐忙。\n绛蜡持来元未点，黄封才破已闻香。\n星随烬落花犹在，霜送杯深味更长。\n乞晓却穿丹凤入，白麻宣对殿中央。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54742,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和赵达夫入试院","author":"毕仲游","text":"不带书来倦日长，诗传新语似襄阳。\n工夫不比唐风集，气味如闻汉著香。\n醉酒典衣吾已老，赐袍夺锦子行将。\n凭诗更作骚人体，为说幽兰静处芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54743,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和赵尧夫晨起","author":"毕仲游","text":"留连夜色城中月，造作秋声雨后桐。\n残烛有花非目眩，宿酲无病似头风。\n未从丹灶游方外，且对黄粱说梦中。\n三十万家天欲晓，非烟非雾气葱葱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54744,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和应之判官宠示之作","author":"毕仲游","text":"青衫补绽发鬅松，未信无文可送穷。\n醉入南山题石虎，梦回西洛赋惊鸿。\n君才特起如秋鹗，我病微吟若夏虫。\n场屋旧游都老大，可怜乐事转头空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54745,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和吕纪常奉使契丹","author":"毕仲游","text":"雪压胡沙老上庭，春华虽减使华增。\n且看意气并人物，未说文章与吏能。\n靴淀早行围晓月，滹沱还渡坼春冰。\n红牙新下都司诰，异日应须五色绫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54746,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和钱穆父提刑九日登郓州乐郊","author":"毕仲游","text":"酒面吹花点客衣，茱萸采尽叶离离。\n苍苔不扫迷三径，绿竹长生任四时。\n文会难逢嗟已散，清欢易失却成悲。\n北垣龛石皆陈迹，赖有曹南慰我思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54747,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和钱穆父舍人","author":"毕仲游","text":"簪笏三人共一班，仙凡回首不相关。\n连名花判围宫砚，隔坐香焚暗博山。\n红药对开阶两畔，紫宸入侍殿中间。\n更知外省文书少，草罢词头阁老閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54748,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄郓州李常武兼简王希才先生须城王敦夫","author":"毕仲游","text":"胡髯洛面少知音，会爱清閒忙至今。\n负郭买田元有意，上书论事已无心。\n参军近日诗情老，居士从来理性深。\n若见须城王令尹，为言憔悴白头吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54749,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄欧蔡二家兄弟","author":"毕仲游","text":"人静身閒日月迟，酒来谁共倒玻璃。\n吟如岘首山前过，醉似武陵溪畔迷。\n新梦未曾离颍上，旧交长是忆淮西。\n郡城到处频行乐，驷马驴车理却齐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54750,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和夷仲寄仲纯叔弼","author":"毕仲游","text":"流水无声冻未销，故人何日许相招。\n霜花开遍城头树，月色应添淮上桥。\n十载尘埃身碌碌，百年杯酒意飘飘。\n弟兄已有东归意，早晚同来采药苗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54751,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和河南尹上清宫祈雪","author":"毕仲游","text":"旌旄十里驻邙山，夜醮琳宫太古坛。\n宝殿降真方隐隐，大田弥望已漫漫。\n抚封和气通为润，载路欢谣不避寒。\n琼苑玉楼扃大内，惟瞻银阙在云端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54752,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和董十二司户见寄","author":"毕仲游","text":"官居破屋两三间，佳客留连我厚颜。\n一月俸馀才有酒，十分地僻却无山。\n折腰州县慵来久，散发江湖愿未还。\n不是清朝甘吏隐，偶因多病伏安闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54753,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵魏承议","author":"毕仲游","text":"翠柏相交夹路深，闭门憔悴白头吟。\n晓风驾月粘天去，宿雨堆云接地阴。\n酒伴留连非北道，交情珍重比南金。\n近来发落牙仍缺，惟有如丹一寸心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54754,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和贡父学士游左山归泛北湖","author":"毕仲游","text":"带郭湖山归故丘，使君把作醉乡游。\n僧轩爱客长开户，沙鸟迎人不避舟。\n一塔清风来处远，三楼寒月影相留。\n酣歌想见江南路，野客溪禽好在不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54755,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和裴士杰库部对棋上贡父学士","author":"毕仲游","text":"吏散公堂讼已平，东轩一局晚窗明。\n风云不动星辰灿，樽俎无声玉石争。\n意外死生由巧拙，手中舒卷乍阴晴。\n自怜小数非秋格，坐久惟闻鸿鹄声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54756,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和褚恕通察推淮上有感","author":"毕仲游","text":"小床高枕卧书空，节物凄凉岁岁同。\n钱在杖头尝自醉，花开门外为谁红。\n君閒好事棋成癖，我病裁诗句不工。\n故国欲归归未得，东风随梦去匆匆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54757,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和梅德充见寄","author":"毕仲游","text":"前年离陕宴溪傍，白发苍颜各老郎。\n亲意百年杨仲武，友情千里晋真长。\n论诗手出都官藁，好事家传侍读香。\n书到并州何处觅，柳溪高会正传觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54758,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和欧阳伯和见寄","author":"毕仲游","text":"自笑无能与世疏，此身疑作野人居。\n穿花载酒虽难得，散发行歌许自如。\n赖有儿童守门户，不妨宾客到阶除。\n会须拂拭乌皮几，准拟虞卿共著书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54759,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和李文叔寄虢州孙元忠学士","author":"毕仲游","text":"病懒逢春不似春，已衰心力未閒身。\n入关胜迹都题汉，度陇方言漫计秦。\n人会一时亲贾马，交情千里属雷陈。\n渐知归计无多事，只待男婚女嫁人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54760,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和谷熟徐仲元著作监仓之什","author":"毕仲游","text":"行见东州山外山，却回河上醉春寒。\n新诗点检留心苦，旧事寻思觉鼻酸。\n上疏未能同主父，带经犹得学倪宽。\n只今欲作归休计，淮上田园累岁乾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54761,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"奉呈中叔仙翁觊永光和","author":"毕仲游","text":"两君相得富家声，书字题诗别有名。\n健笔九分张长史，苦吟再产谢宣城。\n门閒掩月居人少，木老凌风直舍清。\n顾我菲才空有愿，愿同吏隐过升平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54762,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和希鲁四兄奉议陪蒲守景叔学士宴名阃堂书事","author":"毕仲游","text":"大栋修梁城北楼，使君冠盖簇楼头。\n左山右水足清会，吊古怀贤非俗流。\n月出长天犹未夕，风来大暑顿成秋。\n登高能赋真吾事，未及相如死不休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54763,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和宋开叔韵游风穴山白云寺","author":"毕仲游","text":"人去人来半日间，徘徊绝顶觉身閒。\n风云不动心犹恐，星斗相辉手可攀。\n皂盖远如天上至，篮舆曾记月中还。\n防身一剑今谁倚，何必崆峒始是山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54764,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和僧圆益晚归三峰","author":"毕仲游","text":"昨朝分路指溪泉，今日怜师寄一篇。\n归去且看松径绿，重来应见杏花妍。\n风吹林杪声初闹，日晒墙阴影渐延。\n待得青春夜如昼，却烦相唤咏婵娟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54765,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和夷仲兄嵩山岳寺会宿","author":"毕仲游","text":"相迎终日踏泥沙，行过山南路更赊。\n虽有风光堪共赏，自怜诗酒属吾家。\n野僧好事招题壁，稚子无端爱折花。\n官冷囊空不须问，此身强健自生涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54766,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"悲陈子思","author":"毕仲游","text":"别后悲伤今已休，相逢泪散不能收。\n遗书欲问难开口，往事寻思若转头。\n李白才华都是梦，渊明牢落几经秋。\n草堂故地今存否，留作生祠记旧游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54767,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽欧阳文忠公三首 其一","author":"毕仲游","text":"夜梦钧天去不还，送车千乘出长安。\n醉翁亭远名空在，会老堂深壁未乾。\n墓草荒凉秋日暗，松林萧索晚风寒。\n北山有石谁能取，四十年名不易刊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54768,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽欧阳文忠公三首 其二","author":"毕仲游","text":"少师盛德书生服，居士高名数岁馀。\n清颍归来人事近，白云乘去夜堂虚。\n累朝旧籍刊成史，集古新编满载车。\n闻说使星来已晚，茂陵应复进遗书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54769,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽欧阳文忠公三首 其三","author":"毕仲游","text":"冠冕魁梧二府尊，义缘宗社不谋身。\n生前事业成三主，天下文章无两人。\n志与经纶埋厚地，道怀正直作明神。\n未年七十身先退，再使人间风俗淳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54770,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和陈子思游灵泉山","author":"毕仲游","text":"婆娑盘石大，狼籍野云多。\n借问山中客，桃源路几何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54771,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和十一舅题金虾蟆","author":"毕仲游","text":"石窟昔藏金，蟾光射百寻。\n今朝在何处，山景正阴阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54772,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和希之","author":"毕仲游","text":"幽禅吾不学，静处岂无心。\n日转眠双树，风和散两襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54773,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"月没","author":"毕仲游","text":"月没云生障，风和雪压沙。\n居家尝似客，行路却如家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54774,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过泗州赠同行","author":"毕仲游","text":"往来不绝千竿伞，头尾相衔两岸船。\n安得楼高三万丈，与君直上看云烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54775,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"将次六邑读子美诗有感","author":"毕仲游","text":"苏岚背日千盘曲，淝渚迎风四面吹。\n此水此山吾有恨，杜陵才子不同时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54776,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"从霍丘赴六邑道中即事","author":"毕仲游","text":"野塘无渡水潺潺，五月凉于八月间。\n传语弟兄今好在，有声相唤即西还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54777,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与信阳王君仪司理约游首山寺不遂","author":"毕仲游","text":"渡河五里列南山，僧阁连延半岭间。\n岁暮相招春晚去，出城风雨又空还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54778,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杜家溪","author":"毕仲游","text":"入山先到杜家溪，溪水长流不住泥。\n好作清新纪秋色，竹林深处为君题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54779,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江行","author":"毕仲游","text":"长航驾浪入烟空，大醉高吟天地中。\n快事平生未曾有，渡江才得一帆风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54780,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"枫桥寺读张祐诗碑云长洲苑外草萧萧却忆相从岁月遥惟有别时应不忘暮烟疏雨过枫桥是夜与温老语殊可人翼日又邂逅程梦良二人相送寺门因留一章纪事","author":"毕仲游","text":"茂苑春归花信空，黄梅渐熟麦摇风。\n今朝门外分携处，还是枫桥烟雨中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54781,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和陈子思谢见过","author":"毕仲游","text":"入城那复得逍遥，酒熟花开却见招。\n从此相思不须说，只将诗句写无聊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54782,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和陈子思宿陈家寺","author":"毕仲游","text":"诗老才多又好奇，吟来直欲压玄晖。\n帷子不奈思家意，梦逐山云一夜归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54783,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]