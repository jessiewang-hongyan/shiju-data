[{"title":"李商叟举似用南涧山字韵茶山星字韵数诗辄借韵呈商叟二首 其一","author":"赵蕃","text":"已悲傲吏失南山，尚喜王儦峙旧坛。\n感怆自应新发白，乖离可使旧盟寒。\n篙师径欲通宵发，我辈深嗟会面难。\n月底婆娑灯下语，恍然还是昔年看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48876,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杨录事以仆与孙温叟唱酬韵作诗见贻又用仆与吴梦与诗韵作诗赠梦与兼以见及并次韵二首 其二","author":"赵蕃","text":"了知人事近天机，苍狗斯须变白衣。\n逋客几回惊鹤怨，弋人终日慕鸿飞。\n由来灾怪自珠玉，不以贱贫安布韦。\n我鬓已霜君可料，况堪七十古来稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48877,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杨录事以仆与孙温叟唱酬韵作诗见贻又用仆与吴梦与诗韵作诗赠梦与兼以见及并次韵二首 其一","author":"赵蕃","text":"丹凤哀鸣领九雏，雀飞饱食下平芜。\n寒窗拥褐兹晨卧，急鼓穿鞋旧日趋。\n客至渠能劳剥啄，赋成我岂寓乌无。\n说天更拟愚溪去，荣辱端知可罢呼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48878,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杨谨仲和顷者三诗见贻复次韵六首 其六","author":"赵蕃","text":"不减浣花头，仍兼事事幽。\n浑忘帝城札，好在竹林游。\n有意求如愿，无机防海鸥。\n秋凉入吾树，旧读定能搜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48879,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杨谨仲和顷者三诗见贻复次韵六首 其五","author":"赵蕃","text":"江湖余所乐，岁月老于行。\n酒有杯中趣，诗无世上名。\n悠悠真自得，悄悄莫加评。\n尚要高交友，风期同死生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48880,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杨谨仲和顷者三诗见贻复次韵六首 其四","author":"赵蕃","text":"病骨觉难强，鬓华惊易彫。\n壮怀鲸访李，老习蚓同萧。\n久已思抛笏，悠哉曷泛瓢。\n东游穴探禹，西上石宾韶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48881,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杨谨仲和顷者三诗见贻复次韵六首 其三","author":"赵蕃","text":"功名误黑头，晚卧此山幽。\n落拓扬执戟，浮沉马少游。\n豆刍千里骏，烟草五湖鸥。\n早晚相从去，高深日纵搜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48882,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杨谨仲和顷者三诗见贻复次韵六首 其二","author":"赵蕃","text":"去年才一识，何意复兹行。\n隐墅全依郭，幽居亦占名。\n万金真国士，十室漫乡评。\n汉制谁绵蕝，且徵齐鲁生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48883,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杨谨仲和顷者三诗见贻复次韵六首 其一","author":"赵蕃","text":"江南秋得闰，草木向迟彫。\n正性失松桧，群生同艾萧。\n漂流又舟楫，隐约念箪瓢。\n剩暑犹须葛，谁能远致韶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48884,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"沅陵用在伯林字作诗见属次韵答之","author":"赵蕃","text":"畏寒终日卧窗阴，衰飒政如霜后林。\n勿谓官閒得厅冷，几因诗至启门深。\n酒才饮湿宁崇味，琴且无弦岂嗜音。\n政尔欲閒閒不得，和诗频改又频吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48885,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"社日风雨","author":"赵蕃","text":"坎坎连村鼓，喈喈隔墅鸡。\n云低天欲夜，雨合路平溪。\n酒为治聋饮，诗因排闷题。\n休嗟妨杖履，聊取便锄犁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48886,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秀奕以文编垂示简之","author":"赵蕃","text":"每念新疏阔，还思旧倡酬。\n年龄故相并，文事孰能优。\n愧乏闻多益，难支问不休。\n黄陈有正派，舍是复何求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48887,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"进之复有湘潭之役二诗见惜别意 其一","author":"赵蕃","text":"岁尽君当又一归，开正我亦具征衣。\n祇今湖北地非远，异日江东书恐稀。\n酬唱未能相数数，别离于此再依依。\n到家无事还宜早，柳弄色时梅片飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48888,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"进之复有湘潭之役二诗见惜别意 其二","author":"赵蕃","text":"君诗悟入已多年，信手拈来总自然。\n静似幽人居在谷，勇如壮士起临边。\n波澜收卷虽馀地，光艳发舒终属天。\n笑我饥吟空白首，乱蛩衰草晚风蝉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48889,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"进之雪中见过明日归湘潭再用前韵二首 其二","author":"赵蕃","text":"但见纷纷势莫收，要穷衮衮若为头。\n路迷界眼疑无地，水失汀洲仅比沟。\n我欲出郊思借蹇，君归乘艇喜冲鸥。\n畏寒自缩真衰矣，绝境明朝不更留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48890,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"进之雪中见过明日归湘潭再用前韵二首 其一","author":"赵蕃","text":"诗材满眼不能收，忽报君来为举头。\n寸铁不持难白战，污渠何敢映清沟。\n飞飞望绝千山鸟，浩浩心驰万里鸥。\n市远家贫乏供给，愧烦终日肯淹留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48891,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"远父往富沙兼简马庄父二首 其二","author":"赵蕃","text":"子过铅山县，知名有尉曹。\n谈端抽茧纴，文力壮波涛。\n见子心应识，思渠首屡搔。\n共为徐庶友，而独不能高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48892,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"远父往富沙兼简马庄父二首 其一","author":"赵蕃","text":"徐郎既吴越，王子又瓯闽。\n孰与还仍往，惟馀病与贫。\n尚寒花有信，欲尽雨催春。\n子去宁关抱，余留独损神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48893,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"远斋用常字韵见贻次韵","author":"赵蕃","text":"闲中未免和诗忙，忙里偷闲莫自妨。\n一梦江山惊草草，半春风雨自常常。\n桃花落去空流水，燕子归来非故乡。\n世事多端付醇酎，我知公不愧平阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48894,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"远斋和示疏字韵四诗复用韵并呈子肃 其四","author":"赵蕃","text":"竹经载伐似微疏，濩落犹能伴我居。\n自分举家长食粥，从渠厚禄绝无书。\n诸公漫仰苏门隐，吾辈还羞李武车。\n役役眼前何所直，百年终向梦中除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48895,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"远斋和示疏字韵四诗复用韵并呈子肃 其二","author":"赵蕃","text":"杖履过从每恨疏，何当有屋并门居。\n我疑奇字就公问，公赋新诗令我书。\n无事昼棋仍夜酌，有时溪楫更山车。\n从教老色侵双鬓，凭藉黄精为茀除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48896,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"远斋和示疏字韵四诗复用韵并呈子肃 其三","author":"赵蕃","text":"春风吹雨密还疏，门掩荒山数亩居。\n换米但须居士屩，入都宁倚子公书。\n安贫自足容高枕，处事时应念覆车。\n所恨卜邻非二仲，枉教三径草频除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48897,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"远斋和示疏字韵四诗复用韵并呈子肃 其一","author":"赵蕃","text":"交旧年来寖作疏，两翁频肯问林居。\n儿时已诵天台赋，老去思传秘府书。\n可使鸾凰栖枳棘，未应骐骥伏盐车。\n时平自是功名晚，莫叹江湖岁月除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48898,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"远斋顷寄在湖日所作三诗舟中次韵 其一","author":"赵蕃","text":"黜陟无新报，山川怀昔人。\n诗能言我志，贫不累吾身。\n登眺尽遗胜，经行那厌频。\n江头钓竿客，何物是玄真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48899,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"远斋顷寄在湖日所作三诗舟中次韵 其二","author":"赵蕃","text":"近日杭州见，殷勤蒙置樽。\n别来几朝夕，书问欠寒温。\n谭妙元超诣，诗高外语言。\n何当从杖履，底尽得深论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48900,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"远斋顷寄在湖日所作三诗舟中次韵 其三","author":"赵蕃","text":"向来吴楚隔，书札苦难通。\n信与衢相接，我归公亦同。\n寓怀须酒圣，适意岂诗穷。\n情性思陶冶，吾宁较拙工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48901,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"连日与邢伯言兄弟饮成四十字","author":"赵蕃","text":"江上风虽横，林间月自新。\n探囊看墨妙，酌酒话情亲。\n感叹思前日，飘零愧此身。\n未妨频夕醉，初不污车茵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48902,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"连日欲雨辄为风所败","author":"赵蕃","text":"不雨又一月，望霓空众心。\n雷师非敢怠，风伯故相侵。\n国祀居常典，天诛徯下临。\n谁能奋韩笔，并为丐商霖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48903,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"连雨","author":"赵蕃","text":"夜窗连晓枕，城郭与山林。\n旱苦七八月，雨欣三日霖。\n殊胜建武谷，更愈栎阳金。\n斗食端可直，胡为久滞淫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48904,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"连雨","author":"赵蕃","text":"窗外檐绝雨，槛前山返云。\n细听还摵摵，触眼又纷纷。\n旱昔晨昏望，淫今昼夜闻。\n平生忧国愿，敢废野人芹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48905,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"连雨书事","author":"赵蕃","text":"麦熟蚕将老，晴须雨不宜。\n频年荒已甚，一饱此为期。\n陛下故勤理，尔民无怨咨。\n磨镰亦装簇，晴日会当披。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48906,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"连雨有作","author":"赵蕃","text":"往晴忧小旱，今雨慰深望。\n细听林园响，如闻粳稻香。\n客来无褦襶，兴可傲羲皇。\n恨我疡居体，孤渠醉作乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48907,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"迟晓微雨已而复止","author":"赵蕃","text":"晓雨初传听，晨窗已断闻。\n日行将杲杲，云起更纷纷。\n不似岁且尽，直疑春向分。\n南方故谙此，北叟漫惊云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48908,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"邻居送梅子朱樱","author":"赵蕃","text":"山居蔬果少，口腹每劳人。\n梅子欣初食，樱桃并及新。\n供盐贫亦办，荐酪远无因。\n便可呼杯勺，数朝阴雨频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48909,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闰十一月十一日病酒不能扶头忽得成父弟书继又得叔异季承和诗偶成长句会有便先寄叔异季承","author":"赵蕃","text":"北风将雪昼成阴，冷屋閒窗偃卧深。\n百虑欲醒还皎皎，白头高拥更岑岑。\n诗从岭外来双璧，书自江东得万金。\n得友似斯真足慰，有兄如我竟何任。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48910,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闰月二十日离玉山八月到馀干易舟又二日抵鄱阳城追集途中所作得诗十有二首 其三","author":"赵蕃","text":"岸尽催撑渡，风横促解桥。\n传闻记常岁，伟观得今朝。\n时有疏钟度，谁云隔岸遥。\n明当绝溪去，应为好山招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48911,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闰月二十日离玉山八月到馀干易舟又二日抵鄱阳城追集途中所作得诗十有二首 其四","author":"赵蕃","text":"下水有放溜，溯流多哭滩。\n人能等迟速，事岂病艰难。\n返照千山赤，春风两鬓寒。\n生平惯行役，无复漫悲酸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48912,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闰月二十日离玉山八月到馀干易舟又二日抵鄱阳城追集途中所作得诗十有二首 其九","author":"赵蕃","text":"望望龟峰寺，行行番国船。\n林深寒日薄，沙迥晚风颠。\n能赋思孙楚，同行有惠连。\n好诗相拨触，才尽不能宣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48913,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闰月二十日离玉山八月到馀干易舟又二日抵鄱阳城追集途中所作得诗十有二首 其十二","author":"赵蕃","text":"草草天涯棹，悠悠江上鸥。\n琵琶千古恨，蓑笠十年游。\n莫向官亭泊，闲为佛界流。\n明朝更西去，依旧觅扁舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48914,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闰月二十日离玉山八月到馀干易舟又二日抵鄱阳城追集途中所作得诗十有二首 其十","author":"赵蕃","text":"唤渡风殊怀，穿林日向中。\n飞泉半崖落，峭壁与天通。\n往者名犹在，仙人事已空。\n徐岩不为远，归去若匆匆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48915,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闰月二十日离玉山八月到馀干易舟又二日抵鄱阳城追集途中所作得诗十有二首 其一","author":"赵蕃","text":"摧轮荒水磨，涨潦失连湖。\n纵使非长路，能忘去此都。\n未应为物役，真复坐饥驱。\n好在佳山水，悬应识故吾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48916,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闰月二十日离玉山八月到馀干易舟又二日抵鄱阳城追集途中所作得诗十有二首 其七","author":"赵蕃","text":"楼殿何年寺，樯帆别郡船。\n溪山妙图画，井邑盛人烟。\n未觉乡音改，空惊岁事迁。\n桃花知不远，底处觅真仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48917,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闰月二十日离玉山八月到馀干易舟又二日抵鄱阳城追集途中所作得诗十有二首 其二","author":"赵蕃","text":"草草朝成市，匆匆客系船。\n荒鸡乱人语，细雨杂炊烟。\n岁月真前梦，江山殆宿缘。\n沙鸥应笑我，疏鬓异当年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48918,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闰月二十日离玉山八月到馀干易舟又二日抵鄱阳城追集途中所作得诗十有二首 其十一","author":"赵蕃","text":"试登云锦阁，还上揖仙亭。\n栋宇虽摧落，江山自典型。\n冲风聊策杖，晚日更扬舲。\n要写吴江句，初无六尺屏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48919,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闰月二十日离玉山八月到馀干易舟又二日抵鄱阳城追集途中所作得诗十有二首 其八","author":"赵蕃","text":"不见千株树，空留百尺台。\n仙人定无有，行客自裴回。\n更欲危栏倚，生嫌莫色催。\n病僧多不出，门外长苍苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48920,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闰月二十日离玉山八月到馀干易舟又二日抵鄱阳城追集途中所作得诗十有二首 其五","author":"赵蕃","text":"汭口成孤泊，章岩说旧游。\n征商毋见挽，日暮自应休。\n烟暝栖鸦树，沙昏宿鹭洲。\n浮生真泛泛，吾道莽悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48921,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闰月二十日离玉山八月到馀干易舟又二日抵鄱阳城追集途中所作得诗十有二首 其六","author":"赵蕃","text":"借石谁为主，叫应呼莫应。\n楼高才隐约，树远更崚嶒。\n挂席凡三过，停桡欠一登。\n扁舟向何许，漂泊傍渔罾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48922,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陈丞以南安寨上所得二诗及到龙泉闻余戍地最远见怀二首为寄次韵 其四","author":"赵蕃","text":"剪茅仍伐木，去凸亦锄坳。\n响屐无惊谢，投金政拟郊。\n百年终显晦，一稔在肥硗。\n隐地两成隔，颓墙空长梢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48923,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陈丞以南安寨上所得二诗及到龙泉闻余戍地最远见怀二首为寄次韵 其三","author":"赵蕃","text":"问我能嗟远，如公肯见卑。\n十分期一见，四首仅蒙诗。\n傥许抄传可，何堪绝赠宜。\n虽然籍湜辈，附此姓名知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48924,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陈丞以南安寨上所得二诗及到龙泉闻余戍地最远见怀二首为寄次韵 其二","author":"赵蕃","text":"路穷千涧底，人绝万山旁。\n暝宿茅寮冷，晨炊土灶荒。\n多年布衾裂，倍觉夜蔬香。\n有底从军乐，题诗日在忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48925,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陈丞以南安寨上所得二诗及到龙泉闻余戍地最远见怀二首为寄次韵 其一","author":"赵蕃","text":"郴州何许是，山远水仍多。\n江徼重重栅，田夫户户戈。\n雷同嗟不早，叹我亦奔波。\n未必甘如此，而今敢谓何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48926,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陈严二先生和前诗见示次韵报之","author":"赵蕃","text":"梅蕊何曾见，诗筒已再开。\n如怜今岁尽，唤起好春来。\n咫尺花当动，侵寻老故催。\n不知荣悴阅，更得几何回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48927,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陈严二君频送蜡梅因以成咏","author":"赵蕃","text":"缀蜡为花荆作枝，列为梅种自何时。\n诗多草木初无与，贤比兰荃又见遗。\n祇道品题终不遇，岂期坡谷解相知。\n却怜二士空齐鲁，不及西都讲盛仪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48928,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陈择之经过以赣守留尚书得祠亟归别之其行甚遽途中有诗见寄次韵","author":"赵蕃","text":"过我不停轨，嗔公但忆归。\n民思河内借，士失荆州依。\n别去目易极，诗来寒益衣。\n今时未为贵，岁晚望荆扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48929,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"饭后独立寺门颇见摇落之境欲收以诗大费弹压仅得二首 其二","author":"赵蕃","text":"起望若有得，欲言殊费辞。\n冥搜累肝肾，凝想见须眉。\n此乐谁能愈，虽贫自勿疑。\n是身宁大谬，无事及诸儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48930,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"饭后独立寺门颇见摇落之境欲收以诗大费弹压仅得二首 其一","author":"赵蕃","text":"作诗无远到，伫立有深思。\n集此溪山趣，充吾耳目资。\n唐虞紫微论，苏李少陵诗。\n落落心虽在，茫茫力已疲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48931,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"饭枫桥铺","author":"赵蕃","text":"只堠复双堠，晨鸡仍午鸡。\n春风空浩浩，客意只凄凄。\n驱我因微禄，言归欠薄畦。\n有怀无与共，聊以命诗题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48932,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"饮袁州惠仰山茶","author":"赵蕃","text":"黄溪方辍供，顿有仰山来。\n久怕羊肠险，小听松吹回。\n喜能浇渴肺，愁柰走饥雷。\n何日俱君谒，香凝燕寝开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48933,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"侍郎周公不赴富沙士论推高以诗寄呈","author":"赵蕃","text":"人谁不慕直言名，未有保持终不倾。\n可使浊泾侵渭水，信于落月见长庚。\n要令国有九鼎重，自是身如一叶轻。\n常病此风今寂寞，古涂荆棘赖公行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48934,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"叔文见过且携赵祖文归来图来为赋四十字","author":"赵蕃","text":"蝉噪天边柳，鸠鸣雨外桑。\n江东千里远，湖北比年荒。\n画展归来赋，辞吟老至将。\n终焉莫陶写，醉帽晚风长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48935,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"周十三丈约同马三丈入青原山赋诗五首以记行 其一","author":"赵蕃","text":"渡江不待饷，胜士约三行。\n梦境故常在，重来年漫更。\n又成春雾扫，何日野田耕。\n要向思公问，灯明香缕横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48936,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"周十三丈约同马三丈入青原山赋诗五首以记行 其五","author":"赵蕃","text":"游山忘襆被，唤渡已无航。\n隔岸初更动，缘沙数里长。\n大呼空亟疾，小立更微茫。\n莫遣眠鸥觉，笑人朝夕忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48937,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"周十三丈约同马三丈入青原山赋诗五首以记行 其二","author":"赵蕃","text":"有见匪山色，所闻非市声。\n思公藏有塔，钓士隐无名。\n兀兀故林愿，悠悠流俗情。\n经禅虽未暇，樵牧念馀生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48938,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]