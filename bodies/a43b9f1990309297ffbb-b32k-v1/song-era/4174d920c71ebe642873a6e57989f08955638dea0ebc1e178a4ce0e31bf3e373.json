[{"title":"约圆机不至将出游鸡头山作二绝句 其二","author":"晁说之","text":"君知我亦有柴关，我岂输君独自閒。\n把笔何人凤尾诺，杖藜望我鸡头山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56018,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"约玄机来吃社饭以雨不果","author":"晁说之","text":"积雨晦沧溟，归期燕不灵。\n何能陪社饭，应为厌侯鲭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56019,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自延安回道中作 其三","author":"晁说之","text":"延州红胜洛州花，打剥工夫阿那家。\n我亦劳心添病骨，悔将黄卷负年华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56020,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自延安回道中作 其二","author":"晁说之","text":"多谢芳樽与献酬，只将万斛醉吾愁。\n春花来作人间梦，梦到鸦啼不得留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56021,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"行县途中读柳子厚诗","author":"晁说之","text":"征衣穷塞暮冬时，读尽龙城太守诗。\n若使生平诗尽在，濯缨无泪为君垂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56022,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西风","author":"晁说之","text":"秋风几日过秋关，直访畸孤海上山。\n为报故山都是旧，可怜留滞不知还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56023,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观明道先生桃花菊诗作","author":"晁说之","text":"叹息天工暂醉时，重阳物色艳阳姿。\n便生春思兼秋绪，当日董生宜一窥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56024,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观逋翁执花曲作","author":"晁说之","text":"万国归随尽细侯，阿?只解爱扬州。\n锦帆明日知何处，不得龙门洛水游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56025,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过汉武望仙宫在鄜寺之西三绝句 其一","author":"晁说之","text":"海外求仙事渺茫，却烦鹤驾访刘郎。\n修门自有偷桃客，好试低眉问帝乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56026,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过汉武望仙宫在鄜寺之西三绝句 其二","author":"晁说之","text":"山下时时闻凤箫，山中处处得蟠桃。\n刘郎仙去何难事，不用飞楼百尺高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56027,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过陜州赠苏仪掾仲滋 其二","author":"晁说之","text":"河拥秋声客恨新，谁能出语共轮囷。\n信知五采生丹穴，不许文章属外人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56028,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过荆轲冢四绝句 其一","author":"晁说之","text":"过华踰河势北倾，何人来此葬荆卿。\n千金匕首安知在，易水寒来尚有情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56029,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过荆轲冢四绝句 其四","author":"晁说之","text":"贯日白虹可奈何，书生容易笑荆轲。\n美新伾党临遗冢，惭愧绝无狐兔过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56030,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过荆轲冢四绝句 其二","author":"晁说之","text":"太子当年计不疏，虎狼有剑断头颅。\n逡巡不血荆轲手，自要辒辌费鲍鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56031,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过荆轲冢四绝句 其三","author":"晁说之","text":"刺客传中轲绝伦，后来尪怯寂无人。\n秦人更甚燕人恨，不葬燕台留葬秦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56032,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过雁和二十二弟韵 其二","author":"晁说之","text":"庄周口舌过平生，择雁何为贵不鸣。\n默默高飞宁有乐，人间生死本来轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56033,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过雁和二十二弟韵 其一","author":"晁说之","text":"我避胡尘淮海远，悠然问雁尔何来。\n中原消息须闻取，南岳峰头莫漫回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56034,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别一上人","author":"晁说之","text":"同游不二境，却有别离情。\n为日添香火，中原正用兵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56035,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即事","author":"晁说之","text":"几岁田园得隐沦，忍将秋泪湿红尘。\n一麾不得庐山去，何用他州寄此身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56036,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即事二首 其二","author":"晁说之","text":"药苗晚种已青青，应念尪羸与养形。\n肯为嵇生徒著论，便同玄晏剩翻经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56037,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即事二首 其一","author":"晁说之","text":"晚霭沈山月隐林，终朝好学仲长瘖。\n忍将老易供书画，更与何人得断金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56038,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即事谢公表二绝句 其二","author":"晁说之","text":"留君谈笑且从容，白发红尘阿那中。\n踉跄行藏莫相笑，枯鱼垂泪恨无从。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56039,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即事谢公表二绝句 其一","author":"晁说之","text":"碧嵩青颍肯相从，万事茅堂醉梦中。\n出到人前羞欲死，归轮不必问何从。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56040,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈华藏密印","author":"晁说之","text":"华藏有主人，百界转纤埃。\n主人顺唤客，低头不敢来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56041,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"我屋","author":"晁说之","text":"窈窕吾山好，栏杆我屋宜。\n胡然名未著，不得谢公诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56042,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杜诗","author":"晁说之","text":"古人愁在吾愁里，庾信江淹可共论。\n孰似少陵能叹息，一身牢落识乾坤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56043,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"狂风","author":"晁说之","text":"十日狂风不偶然，未教桃李斗婵娟。\n关西将士曾如此，直入齐宫斩小怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56044,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"私愿","author":"晁说之","text":"胡尘未动朔云浮，行在多欢见小侯。\n愿保三冬资我乐，更无一事使人愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56045,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"花开未几忽已落尽戏作","author":"晁说之","text":"天涯花信误心期，狼藉残红只往时。\n怪底小怜浑不睡，夜深惆怅梦周师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56046,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"近作小池颇有野意日晚临流吟柳浑独不见慨然有作","author":"晁说之","text":"无波枉渚若堪凭，白露青蘋更可陵。\n过尽秋风独不见，此时肠断柳吴兴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56047,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"还通叟年兄诗卷","author":"晁说之","text":"白头从事未抛诗，无奈才何复苦饥。\n我易吟愁归乐土，因君肠断邺中诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56048,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"远叹","author":"晁说之","text":"白发飘零远可嗟，百年居屋在京华。\n海涯更比天涯远，星斗沈沈入海涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56049,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"京居五更闻钟","author":"晁说之","text":"惯听山头五夜钟，忽惊孤枕景阳风。\n明朝乐事知何限，定自无人拜德公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56050,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"京居秋感五绝句 其三","author":"晁说之","text":"随蝶求官秋绪多，自甘老罢乐婆娑。\n枕边风雨五更梦，声在长衢朝马过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56051,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"京居秋感五绝句 其四","author":"晁说之","text":"江上高人未肯来，京华秋鬓独徘徊。\n饶渠看取潮头月，莫恋林香待放梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56052,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"京居秋感五绝句 其五","author":"晁说之","text":"河漘依棹得风期，秦树湘云枉梦思。\n也好归来君富贵，未容言语我悲伤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56053,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"京居秋感五绝句 其二","author":"晁说之","text":"雨助风声燕欲归，谁教我尚著征衣。\n自怜未读悯征赋，霜雪鬓间犹庶几。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56054,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"京居秋感五绝句 其一","author":"晁说之","text":"快雨薄寒一夕间，胡为百役自间关。\n秋怀更读甘陵赋，始信人人庾子山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56055,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵和蔡天启任四明绝句三首时暂来四明便还丹阳颇不乐此后篇为四明解嘲 其二","author":"晁说之","text":"真隐閒从鄮县来，三山仙蕊眼中开。\n此身自有华阳洞，肯学秉阳叹老槐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56056,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵和蔡天启任四明绝句三首时暂来四明便还丹阳颇不乐此后篇为四明解嘲 其一","author":"晁说之","text":"行尽三江失所誇，便教信美岂吾家。\n却回扬子江头去，看种瓜洲子母瓜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56057,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵和蔡天启任四明绝句三首时暂来四明便还丹阳颇不乐此后篇为四明解嘲 其三","author":"晁说之","text":"未识凉风宝殿西，宁惊海角有遗黎。\n玉筝无日尝瑶柱，金马何人赏木犀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56058,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵谢圆机送梅绝句二首 其二","author":"晁说之","text":"扬州梅发莫依依，曾得何郎一首诗。\n漫有渡江来小庾，始从今日得佳辞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56059,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵谢圆机送梅绝句二首 其一","author":"晁说之","text":"丹萼瑶英阆苑开，人间何处有琼台。\n妒嫌弄玉秦王女，讳说南山说楚梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56060,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"咋舌","author":"晁说之","text":"咋舌何堪妾一鸣，三年如梦寄江城。\n春江细雨添清思，渐近归期更有情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56061,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和二十二弟龟山寺三绝 其三","author":"晁说之","text":"海岸石龟恨未平，时时入海自冯陵。\n此山盘礴清淮上，宝塔分功更就曾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56062,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和二十二弟龟山寺三绝 其二","author":"晁说之","text":"龟山之操恨时危，语乐徒劳鲁太师。\n今日龟山无可恨，祥符年上御题诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56063,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和二十二弟龟山寺三绝 其一","author":"晁说之","text":"江边龟步亦平平，淮上龟山耸五兵。\n何但八公山草木，解令王国列金城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56064,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和十二弟见降羌过洛","author":"晁说之","text":"百代兴亡吐谷浑，圣主神谟不世恩。\n解缚再生有孙子，无劳倚笑上东门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56065,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和吕希哲","author":"晁说之","text":"渭滨人老钓纶中，晚达那知有早穷。\n顾我岩栖终作底，谩将病目送飞鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56066,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和陈叔易见寄","author":"晁说之","text":"终日焚香却袢暑，只此于君愧典刑。\n莫怪慇勤问元朗，此心要自渴沧溟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56067,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和季弟秋日即事","author":"晁说之","text":"五世衣冠盛本朝，宁论妻织与儿樵。\n顾予始就山居乐，未放诗书便泬寥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56068,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和资道登岱顶回","author":"晁说之","text":"蔼蔼天孙作晓岚，为嫌俗骨遣教还。\n仙儿堕处真堪惜，只在含眸一笑间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56069,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和新乡二十一弟华严水亭二首 其二","author":"晁说之","text":"荷盖点溪三数叶，藤稍绕树几千层。\n投閒更与高人约，重抱琴来听广陵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56070,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和新乡二十一弟华严水亭二首 其一","author":"晁说之","text":"渚蒲淅淅风犹急，岸柳纤纤雨尚馀。\n栖鹭宿鸥浑去尽，溯溪还有两三鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56071,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和蒲君刑曹佳作 其一","author":"晁说之","text":"独步当年贤士关，青衫初试□官閒。\n好怜归去龙钟者，五世题名在道山。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56072,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和蒲君刑曹佳作 其二","author":"晁说之","text":"志士何曾耻把关，忠臣本自不言閒。\n策勋他日阵间阵，莫忘今朝山上山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56073,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜听雨","author":"晁说之","text":"岐汴无烦和恊使，秦云送我入梁园。\n残灯半夜梦回雨，心事谁来恸哭论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56074,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜来枕上得四绝句因视王性之谢其相访也末专为渠作 其二","author":"晁说之","text":"皇祚中兴彻九垓，不烦犹道宋王台。\n归鸿特比常年少，应恋黄麾不忍来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56075,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜来枕上得四绝句因视王性之谢其相访也末专为渠作 其四","author":"晁说之","text":"井臼无供戢羽贫，未知何地老容身。\n更无一卷文书在，七录家藏许卜邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56076,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜来枕上得四绝句因视王性之谢其相访也末专为渠作 其三","author":"晁说之","text":"三川皆震大灾异，汴水绝流上帝仁。\n不使六龙远巡幸，兴王茜地福重新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56077,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜闻钟惜其不响","author":"晁说之","text":"宋都为客喜还惊，无数霜天归雁横。\n夜半钟声何太哑，由来石霣五无声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56078,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜闻乌啼 其一","author":"晁说之","text":"不眠无恨自悽悽，真听人间乌夜啼。\n明月未教尘镜掩，华堂歌舞乍高低。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56079,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜闻乌啼 其二","author":"晁说之","text":"义乌此夜一何啼，明日欢欣事不迷。\n定是军回蓟南北，宁论贼退关东西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56080,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉纸百番于姑夫主簿并以谢四诗之宠","author":"晁说之","text":"怯见诗千首，悭持纸百番。\n纸多诗剩到，费杀哑儿言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56081,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"孤雁","author":"晁说之","text":"风驱云卷一身微，慕侣高高急急飞。\n未许高人能远遁，梁王池馆故同归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56082,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"招圆机吃槐叶冷淘","author":"晁说之","text":"庭前枯树庾郎老，马首垂花太祝愁。\n槐叶冷淘来急吃，君家醪瓮却须休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56083,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"招圆机吃槐叶冷淘有狐泉之句辄复为谢","author":"晁说之","text":"野狐泉畔昔人集，朱亥墓南今日豪。\n惭愧曾槐谁细摘，暂抛汤饼属吾曹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56084,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"枕上","author":"晁说之","text":"人间百感未能休，欲语无情谩九州。\n楼上角声山上月，共人割据一端愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56085,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"枕上和圆机绝句梅花十有四首 其九","author":"晁说之","text":"天马锦轻谁得开，月儿罗薄挂香台。\n屈平宋玉浑无语，后辈何人敢咏梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56086,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"枕上和圆机绝句梅花十有四首 其十一","author":"晁说之","text":"汉骑蜀兵下辩开，今朝惟有凤凰台。\n瑶凰琼凤方为瑞，此地宜多白玉梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56087,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"枕上和圆机绝句梅花十有四首 其八","author":"晁说之","text":"织女机寒自失依，云霞扎扎似吟诗。\n女儿谢席雪无句，父子庾家梅有辞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56088,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"枕上和圆机绝句梅花十有四首 其一","author":"晁说之","text":"据渭浮泾雪浪开，一君五后醉高台。\n侍臣不解供吟笔，落尽南山万树梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56089,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"枕上和圆机绝句梅花十有四首 其二","author":"晁说之","text":"梨园弟子强因依，羯鼓声中学御诗。\n十月胡雏来唤仗，新梅谁复增新词。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56090,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"枕上和圆机绝句梅花十有四首 其五","author":"晁说之","text":"莫道梅花取次开，馨香须待百层台。\n不同碧玉小家女，宝策皇妃元姓梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56091,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"枕上和圆机绝句梅花十有四首 其七","author":"晁说之","text":"霜女月娥愁不开，萼君西母宴瑶台。\n总将芳意传英彩，下降人间得有梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56092,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"枕上和圆机绝句梅花十有四首 其十二","author":"晁说之","text":"东郭先生谁与依，雪中意气后夔诗。\n香添皎洁成梅咏，好视江边黄绢辞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56093,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"枕上和圆机绝句梅花十有四首 其四","author":"晁说之","text":"孤芳寒艳绝难依，邺下关中不赋诗。\n未必江南有才子，也应先是七三辞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56094,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]