[{"title":"句 其二","author":"刘克庄","text":"更高千万丈，还我上头行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29665,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其三","author":"刘克庄","text":"杨柳春风丞相府，梧桐夜雨济王家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29666,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"辞世偈","author":"释妙印","text":"六十九年，一场大梦。\n归去来兮，珍重珍重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29667,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"香城寺","author":"刘元刚","text":"末行陶令里，早自惯舁篮。\n米市呼干许，香城访晋昙。\n神游青黛岳，诗到碧云庵。\n不管冲寒去，乘风破晓岚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29668,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"登九会台","author":"于炳文","text":"今日重阳日，菊花开未开。\n飘飘风扫径，泛泛露迎杯。\n甚喜诸同□，相期九会台。\n临归逢胜赏，留句在岩隈。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29669,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"仲夏赏月次雪斋韵二首 其一","author":"司马述","text":"喜约当余望，开樽对月圆。\n一时如素定，四美复兼全。\n清影浮琼斝，高歌乐性天。\n主宾欢意洽，不惜且留延。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29670,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"仲夏赏月次雪斋韵二首 其二","author":"司马述","text":"停杯待明月，喜见十分圆。\n曩昔诗犹在，今宵事偶全。\n浩歌休问夜，至乐莫非天。\n愿侍金樽侧，时来接款延。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29671,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金陵怀古","author":"吴陵","text":"烟云莽莽对穷秋，六代雄豪见古丘。\n万里长波东赴海，千年闲客独登楼。\n山川冥漠天难问，运数推移地莫留。\n终信东南多王气，浙中今是帝王州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29672,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"盱眙郡楼","author":"吴陵","text":"风物凄凉天地秋，凭高不尽古今愁。\n关河北望三千里，淮泗东来第一州。\n日暮边声传画角，早寒霜气袭重裘。\n干戈澒洞何时静，王粲长吟独倚楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29673,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"登南浦亭","author":"吴陵","text":"飘泊豫章城，登临南浦亭。\n乾坤遗落羽，江海一浮萍。\n宿雨桃花水，春风杜若汀。\n古今离别地，那许客愁醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29674,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"古意","author":"吴陵","text":"莫结荡子心，恩情信难保。\n杨花纵可变，奈是浮萍草。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29675,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句","author":"戴衍","text":"源水不移当日岸，桃花犹是昔年春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29676,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"乡饮酒唱和诗","author":"童颐","text":"两轓来自殿东西，要使旴民习俗移。\n可但官条扶世教，更从乡饮叙伦彝。\n一堂礼乐情何厚，四面衣冠乐有仪。\n我老亦陪宾席后，蹒跚非据只心知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29677,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句","author":"桂如琥","text":"云气有时迷洞口，尘埃飞不到胸中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29678,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游宝相院","author":"林观过","text":"古人期年变，拙政愧格顽。\n触此三伏暑，招提解征鞍。\n好风随过雨，稻花秀可餐。\n南窗大榻凉，久输老僧閒。\n盘飧息万虑，竹梧凛相看。\n清阴交蔽芾，直节不可干。\n斯来结三友，欲去复盘桓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29679,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"棋盘山","author":"林观过","text":"山顶仙翁一局棋，不知人世几推移。\n玉枰石座今存否，空使朝猿暮鹤悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29680,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"天柱窟","author":"林观过","text":"六丁擎柱上天门，石窟空遗透地根。\n不是溪人严守护，灵踪那得至今存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29681,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其二","author":"林观过","text":"汉皇未下复雠诏，奈此匹夫匹妇何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29682,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"吊琼花","author":"赵炎","text":"名擅无双气色雄，忍将一死报东风。\n他年我若修花史，合传琼花烈女中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29683,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"虎跑泉","author":"杨端叔","text":"苍髯白甲深山龙，山门高高龙所宫。\n青苔夭矫绝可喜，满地狼籍抛顽铜。\n于菟殷勤水供养，道人回施无尽藏。\n匏樽一滴到陶泓，滩声浩浩西山涨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29684,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"浮远堂","author":"杨端叔","text":"万松相摩天籁作，一尘不留心镜空。\n毋庸宝焰照牛渚，已见浮涎吹龙宫。\n零丁沙洲抗水势，替泪塔铃语天风。\n贾胡惜钱不自惜，昼夜牙筹澎湃中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29685,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"悼步月","author":"赵崇滋","text":"雁过妆楼人不见，断肠又是一黄昏。\n不知天上婵娟影，能照人间寂寞魂。\n响屧廊深空认步，唾茸窗暖尚留痕。\n合将一把香酥骨，葬在巫阳云雨村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29686,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赵容州新居","author":"赵崇滋","text":"旧日水心路，新添赵倚楼。\n诗名不寂寞，此地合风流。\n隔浦荷花雨，当门杜若秋。\n有时清兴到，夜半唤孤舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29687,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春晚","author":"赵崇滋","text":"水边寂寂苍苔晚，犹有东风为掩扉。\n一砚落花人睡起，半帘微雨燕飞归。\n旧时小草尘侵户，隔日馀薰润入衣。\n客又不来吟又懒，小山相对拂金徽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29688,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"客舍","author":"赵崇滋","text":"巷深人寂静，蛩守客床鸣。\n夜半后风雨，一灯前弟兄。\n愁来无好梦，吟到有新声。\n不信看双鬓，萧萧白几茎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29689,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"求酒赵评事","author":"赵崇滋","text":"半老情怀睡不能，小檐霜月当寒灯。\n无人来问相如渴，敲碎梅花一夜冰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29690,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题飞霞观","author":"赵崇滋","text":"水上红云岸上风，玄都观里又相逢。\n世间是色皆为妄，好去桃花只种松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29691,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其一","author":"赵崇滋","text":"事才有意终须失，人到无求始自高。\n贫悟交游秋后叶，老看富贵雾中花。\n从来尽说天堪问，天到如今亦厌烦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29692,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"三台山","author":"刘子寰","text":"山木锁冥迷，山前无路歧。\n无端流菜叶，刚被世人知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29693,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"芙蓉花","author":"刘子寰","text":"晓妆如玉暮如霞，浓淡分秋染此花。\n终日独醒干底事，晚知烂醉是生涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29694,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金凤花","author":"刘子寰","text":"天霜凋九陵，梧桐日枯槁。\n凤德何其衰，惊飞下幽草。\n九苞空髣髴，众彩各自好。\n黄中独含章，见晚更倾倒。\n托根幔亭峰，弱质深自保。\n便翾金翅短，淡泊乃几道。\n俗眼迷是非，人间迹如扫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29695,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"杜若","author":"刘子寰","text":"钦州五月土如炊，满山杜若芳菲菲。\n素英绿叶纷可喜，劲烈不避炎歊威。\n采之盈掬荐蔬食，臧获失笑庖人讥。\n君不见屈平夕餐赋秋菊，魂兮无南盍来归。\n又不见坡公服食得枲耳，扣角自叹从前非。\n伊予假禄二千石，穷比二子犹庶几。\n餐花嚼蕊有真乐，一饱何必谋甘肥。\n尚馀升合渍生蜜，从他薏苡生珠玑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29696,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"贺宰相生日","author":"刘子寰","text":"天开名世五百年，运当启圣先储贤。\n威灵祥凤出奇瑞，十洲三岛高腾骞。\n为天立心民立极，续道命脉开真传。\n日生旸谷苍凉间，辅道王德充其全。\n辉光笃实君蒙著，一朝扶翊升虞渊。\n黄枢紫闼求甘盘，风云赫奕龙飞天。\n正君定国有根本，披腹造膝无拘挛。\n圣皇动息结师保，宫事府事咸咨焉。\n功业巍巍心翼翼，不白得君如此专。\n已知步武通霄汉，但视富贵如云烟。\n先生所乐非世权，要以道觉天民先。\n经纶尽信中庸旨，业履可稽儒行篇。\n指挥丙魏去痹陋，洗刷周召增光鲜。\n至诚待物微且及，未施而信民陶然。\n四方善类今徯志，直道共由无觉偏。\n惟天大任固有属，囊括四海空三边。\n九秋硕果标林端，天根已具阳萌前。\n六度芝耀启初度，颂声洋溢瞻霄跹。\n先知已契蓍百荚，久视更期椿八千。\n青衿学子愚且孱，龙门夙昔惭扳牵。\n愿依金鼎力薪水，庶与鸡犬同登仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29697,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寿周丞相益公 其一","author":"刘子寰","text":"小住人间五百年，因缘真是午桥仙。\n应期却笑河汾早，占节从教寇相先。\n独立青云高两地，曾扶红日见三天。\n封疆峻极连华岳，饮寿应宜吸锦川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29698,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寿周丞相益公 其二","author":"刘子寰","text":"济川功就等虚舟，恰似当年溪石游。\n月满东楼新啸咏，寿高西洛旧风流。\n蒲团看释千回夏，楸局观成几度秋。\n剩喜深衣归奉檄，分将风月荐金瓯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29699,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寿周丞相益公 其三","author":"刘子寰","text":"六月麟书雨作霖，生贤此际见天心。\n江都分洒虽名世，莘野商霖始见今。\n门馆无于仪表正，经纶有道本源深。\n正人命脉常家主，一念公□□盍簪。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29700,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"贺郑枢齐 其一","author":"刘子寰","text":"鄮峻鄞深巩会稽，气钟神秀半千期。\n龙飞虎变具元化，地辟天开衍庆基。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29701,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"贺郑枢齐 其二","author":"刘子寰","text":"身扶晹谷出升日，手引咸池更洗光。\n须信洪钓有根极，直从朱邸植忠良。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29702,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"贺郑枢齐 其三","author":"刘子寰","text":"中庸功用本明诚，心正身修久著刑。\n涵养君心三达国，图回天下九为经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29703,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"贺郑枢齐 其四","author":"刘子寰","text":"人间日月声名重，笔下波澜帝泽多。\n献纳渊衷资启沃，笑嚬寒谷转阳和。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29704,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"贺郑枢齐 其五","author":"刘子寰","text":"紫闼黄枢功已著，苍生黔首望逾深。\n公施政术施仁术，公得人心得士心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29705,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"贺郑枢齐 其六","author":"刘子寰","text":"已观瑚琏登宗庙，未觉龙渊露颖铓。\n好看和风将瑞露，更飞紫电极青霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29706,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"贺郑枢齐 其七","author":"刘子寰","text":"枢庭斋阁五云深，一穗炉薰静养心。\n雅志未先天下乐，两望钟鼎与山林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29707,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"贺郑枢齐 其八","author":"刘子寰","text":"盛丽纷华念不萌，位高心小古难能。\n祇今翘馆延人物，只似萧斋接友朋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29708,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"贺郑枢齐 其九","author":"刘子寰","text":"君臣鱼水方行道，德性鸾凰素服人。\n四海衣冠祈宋祚，万年基业系公身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29709,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"贺郑枢齐 其十","author":"刘子寰","text":"九秋硕果烂枝繁，中养蟠桃千岁根。\n政用斯时祝箕寿，永扶皇极正乾坤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29710,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闲日偶怀","author":"刘子寰","text":"欲将闲日课桑麻，徙倚无端易日斜。\n幽野情怀怜碧草，寂寥门馆称黄花。\n末年函席瞻先哲，几世绳枢守故家。\n今古有谁心事了，隙驹超忽是年华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29711,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"效王建从军后答","author":"刘子寰","text":"爱山无术住家贫，晚曳长裾傍主人。\n七十老亲抛菽水，二千长路逐风尘。\n瞻云望月怀三径，种药移花嗟一春。\n援笔谩题形语影，及时收取自由身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29712,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"严江舟次","author":"刘子寰","text":"烟弄晨光雨弄梅，浦痕微涨认潮来。\n棹随纤道青芦折，路入渔家碧草开。\n指点水程期买酒，追寻古迹谩登台。\n归舟不共商人载，便觉新诗得细裁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29713,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"玉隆宫","author":"刘子寰","text":"避地西山占一区，高风遥想列仙儒。\n云开异日人传见，天上如今宅在无。\n丹去一函空锁钥，柏枯千载尚支吾。\n逍遥峰外烟霞钥，犹恐冈峦落画图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29714,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"鼓山灵源洞天风海涛亭","author":"刘子寰","text":"路入灵源洞壑深，侧攀岩磴度嵚崟。\n凭陵万里烟尘外，虚豁一生江海心。\n鸡溆风涛长荡薄，雁湖岛屿半浮沉。\n兹游不减骑鲸背，莫为天涯叹滞淫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29715,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题梨山祠","author":"刘子寰","text":"庆源仙李蟠根大，形寄丛梨肖像真。\n畏垒一方尸祝地，桐乡千古子孙民。\n自时厥后来为牧，没世不忘知几人。\n正直不应私有祷，但吟歌乐送迎神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29716,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"当阳玉州城","author":"刘子寰","text":"隐隐层台际混茫，荆关形胜古当阳。\n登楼赋里山川在，抱玉岩前堑垒荒。\n思绕曲沮流脉脉，望迷平楚入苍苍。\n青林渐复升平旧，百里康庄夹绿杨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29717,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"当阳道间 其一","author":"刘子寰","text":"当阳楚名都，畴昔用武国。\n山馀磨剑石，陵有拖鎗谷。\n自从春秋来，纷纷几蛮触。\n霸主争盟会，盗贼逞杀戮。\n城郭递锄夷，生灵尽鱼肉。\n到今犹荒凉，旷野鬼昼哭。\n道途烟火绝，一驿数茅屋。\n盛衰相乘除，治乱有反覆。\n可怜江汉民，生比牛山木。\n灵禽避天风，高士弃周粟。\n遥望武陵源。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29718,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"当阳道间 其二","author":"刘子寰","text":"陵坡杳杳路如绳，缓逐杨花信马行。\n芳树晚馀红点缀，乱山春入翠纵横。\n平州废垒八九里，楚子古藏三四茔。\n宇宙不能无变灭，世间修饰欲何成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29719,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"稠岩","author":"刘子寰","text":"万里惊呼立画图，拍天云浪拥蓬壶。\n洞穿苍壁俄空阔，海入碧虚相有无。\n漠漠风帆迷宇宙，离离烟草失江湖。\n百年一饷逢真赏，从此沧洲兴转孤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29720,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"清溪","author":"刘子寰","text":"水作澄蓝可染衣，坐来巾屦湿烟霏。\n魶鱼时迸九泉出，鼯鼠暝缘千仞飞。\n鬼谷洞前春药遍，法师岩畔古藤围。\n故山不是白云念，长揖人间竟不归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29721,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"荆门蒙泉","author":"刘子寰","text":"郏石玲珑玉为骨，下有双泉深觱沸。\n珠泉凝白玉泉碧，含彩扬辉以其物。\n珠泉灵蚌夜出游，忽惊月色清如秋。\n一山木叶皆倒影，月轮却在泉间浮。\n玉泉潜珍閟莫测，木石但观皆润泽。\n卞和生长此山间，谷邃泉深求不得。\n泉心缓缓嘘浮珠，泉口急流深满渠。\n鱼虾蛭蚓不敢狎，始知下有龙神居。\n老龙动息有常定，朝昏泉涌如潮信。\n馀波派作九曲流，百折不能违水性。\n石池数顷琉璃浸，池底金莲铺绿锦。\n金碧晶荧射眼明，烦襟濯尽生寒凛。\n上古消沉不可知，唐贤往往已留题。\n莓苔剥落传师笔，沙砾灭没文饶碑。\n汴京往昔升平日，北上西来多墨客。\n东坡诗扁卧蚕书，鲁直门颜生铁画。\n向来虏寇抄荆门，城郭屋庐俱荡焚。\n黄头亦恐杀风景，岿然独有林亭存。\n古称神瀵疑兹是，到处涔蹄无此比。\n争得山头无戍垒，住向荆门弄泉水。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29722,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雁荡净名谷帘水","author":"刘子寰","text":"野客弄云水，翩翩信飞车。\n奇峰匹雁荡，出没随猿狙。\n苍苍叠云屏，下有白石庐。\n石庐故未足，洞腹开巢居。\n青藜小跻攀，路尽仍盘纡。\n呀然忽宽敞，云雾为支吾。\n天成与鬼凿，罔识造物初。\n笑问主者谁，我欲揽其须。\n耸身忽灭没，扳倒泊雁湖。\n天风复摩荡，簸洒生明珠。\n为帘复为帷，与客相嬉娱。\n倏然一挥霍，五色弥空虚。\n坐来怪事发，迸落随喧呼。\n大笑下山去，勿为山鬼愚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29723,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"月夜东池赏白莲","author":"刘子寰","text":"巉巉彼姝子，玉艳明清波。\n素云裁广袖，渌水覆青罗。\n秀色妙天质，清香凉思多。\n驾言从之游，夜蟾生庭柯。\n徘徊碧云暮，怅望采菱歌。\n常恐秋节晚，零落委寒莎。\n踌躇思折赠，达夕成长哦。\n非君盛才藻，如此粲者何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29724,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"杜宇","author":"刘子寰","text":"鲜鲜纹绶变毛衣，帝蜀繁华梦亦非。\n大好家居君不惜，到今飘泊更思归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29725,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"小蚋","author":"刘子寰","text":"乌蚋纳如尘，终朝恼杀人。\n聚来俄扰扰，挥去大频频。\n不办追忙客，偏能挠静身。\n衁池何限饱，笑汝自迷津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29726,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"武夷猴","author":"刘子寰","text":"猕猴群居时，得食互争夺。\n嚣哓以力胜，无复长幼别。\n及其有老病，同类争救活。\n嗛食置其旁，交来伺饥渴。\n死埋高崖巅，并力事窊掘。\n乃知禀元命，无间䎉与狨。\n质性有所偏，良能或焉阙。\n惟仁乃生理，恻隐由情发。\n鸟乌知反哺，报祭及豺獭。\n人心具中和，推此与天达。\n物欲为私蔽，真知反磨灭。\n利害怵于中，骨肉交朋绝。\n一从失本心，比兽乃反劣。\n武夷山多猴，此事樵者说。\n因书观□篇，惟日三省察。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29727,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"教犊偶作进退格","author":"刘子寰","text":"牛角才及茧，已须穿鼻耕。\n及兹方率性，过此失良能。\n人道事矫揉，物生殊苦辛。\n遂令禅学子，恐惧说无生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29728,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"沙溪田舍","author":"刘子寰","text":"急景萧萧黄叶风，野人篱落半烟中。\n天霜点染林峦出，田水悲鸣禾稻空。\n称贷有逋缘地瘠，偫储无政谩年丰。\n绿林豪客饶牛酒，自保冠山竹藤丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29729,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]