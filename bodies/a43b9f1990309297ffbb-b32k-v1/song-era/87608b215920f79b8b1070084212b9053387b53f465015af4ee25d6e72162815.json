[{"title":"谒金门 其四","author":"赵崇嶓","text":"春意薄。\n江上晚来风恶。\n帘外海棠花半落。\n睡深浑未觉。\n梦想当年行乐。\n新恨暗添金鹊。\n写就金笺无处托。\n去鸿天一角。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46502,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谒金门 其三","author":"赵崇嶓","text":"晴意早。\n帘外数声啼鸟。\n有约不来春梦杳。\n琐窗微弄晓。\n江上残梅未扫。\n叶底芳桃红小。\n天远断云尘不到。\n过春还草草。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46503,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"摸鱼儿","author":"赵崇嶓","text":"卷珠帘、几番花信。\n轻寒犹自成阵。\n一年芳事如朝梦，容易绿深红褪。\n寒食近。\n惟自有、断肠垂柳禁春困。\n琐窗深静。\n悄叠损缕衣，凝尘暗掩，金斗熨清润。\n章台恨。\n准拟芳期未稳。\n旧游细把重忖。\n鉴鸾钗凤平分久，留取年时心印。\n谁与问。\n待试写花笺，密寄教郎认。\n妒香怜粉。\n欲写却还羞，轻颦浅叹，字字搅方寸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46504,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝶恋花","author":"赵崇嶓","text":"一剪微寒禁翠袂。\n花下重开，旧燕添新垒。\n风旋落红香匝地。\n海棠枝上莺飞起。\n薄雾笼春天欲醉。\n碧草澄波，的的情如水。\n料想红楼挑锦字。\n轻云淡月人憔悴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46505,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其二","author":"赵崇嶓","text":"汉月通江白，秦云入塞黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46506,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其六","author":"赵崇嶓","text":"月入星辰大，山明天地秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46507,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其三","author":"赵崇嶓","text":"鹭依江渚冷，雁入楚云深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46508,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其四","author":"赵崇嶓","text":"湖海三生梦，乾坤一寸心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46509,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其五","author":"赵崇嶓","text":"天形低赴海，潮势直通吴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46510,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其一","author":"赵崇嶓","text":"苑墙当北斗，宫树近朝阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46511,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东风第一枝","author":"赵崇霄","text":"妒雪梅苏，迷烟柳醒，游丝轻扬新霁。\n卷帘看燕初归，步屧为花早起。\n春来犹浅，便做出、十分春意。\n喜凤钗、才卸珠幡，早换巧梳描翠。\n著数点、催花雨腻。\n更一番、递香风细。\n小莺忺暖调声，嫩蝶试晴舞翅。\n清欢易失，怕轻负、年芳流水。\n好趁闲、共整吟鞯，日日访桃寻李。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46512,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乌台古柏","author":"赵崇璠","text":"豸冠铁面气昂藏，古柏亭亭降异香。\n天挺孤姿培相业，风裁老干肃台纲。\n岁寒常捲珠帘雪，炎暑犹飞白简霜。\n夜半群乌惊宿处，恍疑骢马召归忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46513,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日山送客次赵循州韵","author":"赵崇皦","text":"苍松藏野寺，山以隐君灵。\n俛仰千年事，孤高九日亭。\n抗尘头渐白，吊古眼犹青。\n有客耽幽讨，吟情起鹤汀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46514,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游九锁","author":"赵崇缵","text":"九峰元不锁，俗驾自来稀。\n水石藏仙窟，烟霞护羽衣。\n夜猿窥月叫，晓鹤出松飞。\n拟结巢由伴，眠云隐翠微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46515,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题义门胡氏华林书院","author":"赵惟和","text":"华堂高启集儒英，地接仙乡景气清。\n苔径静铺修竹影，松窗虚透读书声。\n云飞吟阁诗怀冷，泉激层崖客梦惊。\n孝弟门风传祖德，圣朝清史独传成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46516,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谒金门","author":"赵淇","text":"吟望直。\n春在阑干咫尺。\n山插玉壶花倒立。\n雪明天混碧。\n晓露丝丝琼滴。\n虚揭一帘云湿。\n犹有残梅黄半壁。\n香随流水急。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46517,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元日","author":"赵淦夫","text":"凤历首春王，三元启运昌。\n衣冠充闾里，云物动笙簧。\n共舞椒花醉，真成机械忙。\n人生当此日，何必古羲皇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46518,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"辞家庙","author":"赵淮","text":"祖父有功王室，德泽沾及子孙。\n今淮计穷被执，誓以一死报君。\n刀锯置之不问，万折忠义常存。\n急告先灵速引，庶几不辱家门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46519,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"天台石梁","author":"赵清源","text":"何处觅灵踪，天台第一峰。\n云深唯见寺，夜静忽闻钟。\n卓锡随飞鹤，谈玄起蛰龙。\n石桥如有约，跨月坐从容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46520,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"昭孝道院","author":"赵菊庄","text":"云深户不开，竹屋两三间。\n野水浸官渡，低墙出远山。\n绝荤如鹤瘦，习懒惯童顽。\n我亦皈真者，来公半日闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46521,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"赵逵","text":"皇心未敢宴安图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46522,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冰斋","author":"赵鼎臣","text":"生于水而寒于水，都在君家燕座中。\n只个从来堪受用，何须更远挹清风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46523,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舫斋","author":"赵釴夫","text":"浮家泛宅谩区区，一阁安然特迥殊。\n题作舫斋还解否，登临寄傲在江湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46524,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"暮村","author":"赵鼎","text":"孤村烟树暝黄昏，一簇人家半掩门。\n看尽栖鸦啼噪后，牧童归去雨声繁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46525,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉和颜美中元夕绝句","author":"赵鼎","text":"年年人月喜团圆，好在诗边又酒边。\n莫道玄风只渔钓，也随世俗夜无眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46526,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"盘斋诗","author":"赵鼎臣","text":"退之送李愿，归欤两山间。\n而今乃有此，坐能悦吾颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46527,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠姜邦杰","author":"赵釴夫","text":"括苍水秀更山明，山水钟情故一行。\n黄卷本无闲事业，白头却有懒声名。\n幸逢哲匠求诗范，何用愁城战酒兵。\n三叹遗音今绝少，先生还须预兹盟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46528,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题环锦亭","author":"赵善卞","text":"百世垂芳在一经，茂林修竹读书声。\n园池日涉皆成趣，景物天然分外清。\n聊复垂纶藏渭钓，等閒释耒起莘耕。\n知君自有真良贵，岂羡斯亭锦得名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46529,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南峰山","author":"赵善正","text":"山上青天山下溪，白云流水两相宜。\n丹成共尔南山老，采采松枝亦疗饥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46530,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春辞","author":"赵善扛","text":"碧落初明月未收，露华香滴杏梢头。\n玉阑干外东风暖，人在重云第几楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46531,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"瑞云雀偈","author":"赵善扛","text":"日日飞鸣宣妙旨，幻华起灭复何疑。\n可怜多少风尘客，去去来来只自欺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46532,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题大安铺","author":"赵善扛","text":"行役何时歇，崇安复大安。\n已惊桥壹线，更畏岭千盘。\n过雨吹烟碧，近风落叶丹。\n僧闲吾每羡，今日共蹒跚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46533,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丽人行","author":"王庭圭","text":"桃叶山前宫漏迟，宫人傍辇持花枝。\n君王喜凭绛仙立，殿脚争画双长眉。\n欲抱琵琶弹出塞，结绮临春时事改。\n井边忽见张丽华，忍听后庭歌一再。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46534,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十拍子/破阵子 上巳","author":"赵善扛","text":"柳絮飞时绿暗，荼蘼开后春酣。\n花外青帘迷酒思，陌上晴光收翠岚。\n佳辰三月三。\n解佩人逢游女，踏青草斗宜男。\n醉倚画阑阑槛北，梦绕清江江水南。\n飞鸾与共骖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46535,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小重山 别情","author":"赵善扛","text":"汲水添瓶恰换花。\n蜂儿争要采，打窗纱。\n青春谁与度年华。\n弦索暗，无绪几曾拿。\n春思正交加。\n马蹄声错认，客还家。\n花笺欲写寄天涯。\n羞人见，罗袖急忙遮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46536,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"传言玉女 上元","author":"赵善扛","text":"璧月珠星，辉映小桃秾李。\n化工容易，与人间富贵。\n东风巷陌，春在暖红温翠。\n人来人去，笑歌声里。\n油壁青骢，第一番共燕喜。\n举头天上，有如人意。\n歌传乐府，犹是升平风味。\n明朝须判，醉眠花底。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46537,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"好事近","author":"赵善扛","text":"风动一川花，摇漾影迷红碧。\n人立杏花阴下，泛光风袭袭。\n琼枝碧月互相辉，春容泫将夕。\n罗盖暗承花雾，渍鲛绡香湿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46538,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"青玉案 春暮","author":"赵善扛","text":"一年陌上寻芳意。\n想人在、东风里。\n褪粉销红春有几。\n青翰飞去，紫云凝伫，往事如流水。\n烟横极浦山无际。\n暗解明珰问谁寄。\n乡在温柔何处是。\n轮囷香雾，静深庭院，帘影参差翠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46539,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贺新郎 夏","author":"赵善扛","text":"昼永重帘卷。\n乍池塘、一番过雨，芰荷初展。\n竹引新梢半含粉，绿荫扶疏满院。\n过花絮、蝶稀蜂懒。\n窗户沈沈人不到，伴清幽、时有流莺啭。\n凝思久，意何限。\n玉钗坠枕风鬟颤。\n湛虚堂、壶冰莹彻，簟波零乱。\n自是仙姿清无暑，月影空垂素扇。\n破午睡、香销馀篆。\n一枕湖山千里梦，正白蘋烟棹归来晚。\n云弄碧，楚天远。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46540,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重叠金/菩萨蛮 其三 春宵","author":"赵善扛","text":"一川花月青春夜。\n玉容依约花阴下。\n月照曲阑干。\n红绡挹露寒。\n袖香温素手。\n意铄金卮酒。\n香远绣帘开。\n画楼吹落梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46541,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重叠金/菩萨蛮 其二 春思","author":"赵善扛","text":"玉关芳草黏天碧。\n春风万里思行客。\n骄马向风嘶。\n道归犹未归。\n南云新有雁。\n望眼愁边断。\n膏沐为谁容。\n倚楼烟雨中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46542,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重叠金/菩萨蛮 其一 春游","author":"赵善扛","text":"楚宫杨柳依依碧。\n遥山翠隐横波溢。\n绝艳照秾春。\n春光欲醉人。\n纤纤芳草嫩。\n微步轻罗衬。\n花戴满头归。\n游蜂花上飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46543,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宴清都 饯明远兄县丞荣满赴调","author":"赵善扛","text":"疏柳无情绪。\n都不管、渡头行客欲去。\n犹依赖得，玉光万顷，为人留住。\n相从岁月如骛，叹回首、离歌又赋。\n更举目、斜照沈沈，西风剪剪秋墅。\n君行定忆南池，歌筵舞地，花晨月午。\n八砖步日，三雍奏乐，送君云路。\n别情未抵遗爱，试听取、湖山共语。\n便可能、无意同倾，一尊露醑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46544,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"烛影摇红 盱江有怀","author":"赵善扛","text":"桃李墙头，向人都似他年意。\n舞丝千丈飏晴光，骀青春无际。\n花气薰然自醉。\n傍垂杨、行行缓辔。\n倦游无奈，回首云山，归期犹未。\n玉锁楼空，鸟啼花外东风起。\n少年恩怨付波流，吟望朱阑倚。\n冉冉尘生客袂。\n对尊前、高情暂寄。\n洞天一笑，仙驭乘空，姑峰凝翠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46545,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谒金门 春情","author":"赵善扛","text":"新雨霁。\n开遍满园桃李。\n波暖池塘风细细。\n一双花鸭戏。\n唤起春融睡美。\n扶醉宿妆慵理。\n移步避人花影里。\n绣裙低窣地。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46546,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜迁莺 春宴","author":"赵善扛","text":"韶华骀荡。\n看化工尽力，安排春仗。\n薄雾霏烟，软风轻日，物态与人交畅。\n鸟声弄巧千调，楼影垂空十丈。\n乱花柳，粲宝钿缨络、彩丝帷帐。\n佳赏。\n辉艳冶，笑语盈盈，花面交相向。\n歌运长缫，酒凝深碧，和气盎然席上。\n好春易苦风雨，人意难逢舒放。\n但拍掌。\n醉陶然一笑，忘形天壤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46547,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"赵善扛","text":"相思情不极，有梦到愁边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46548,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"化成岩","author":"赵善坚","text":"低帽白蕉衫，跨马北岩路。\n为我撤炎歊，时有清风度。\n投策蹑游屐，扪萝穷幽趣。\n怪石鸣瘦筇，狭径窘危步。\n云间启深洞，玲珑天巧露。\n僧侣罗上下，钟声答晨暮。\n长笑排翠谒，围棋惊振鹭。\n陶写屏丝竹，恐为风景污。\n拂藓题苍崖，纵横醉中句。\n兹游岂易得，载酒莫辞屡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46549,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宁师西阁","author":"赵善应","text":"飘泊南来几岁寒，追谈往事漫心酸。\n云烟暮隔中原望，归折梅花忍泪看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46550,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵李长卿","author":"赵善应","text":"一别芳洲不计年，旧时攀折柳依然。\n故人似欲撩诗兴，剩折梅花向酒边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46551,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪","author":"赵善沛","text":"儿笑真珠满盘碎，女疑荷叶雨中来。\n道人心下无些事，三个柴头品字煨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46552,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"隆州","author":"赵善诏","text":"三山高峭拔，鼎峙各争雄。\n秀气钟英物，衣冠盛蜀中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46553,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其二","author":"赵善诏","text":"谁谓山城僻，伦魁此破荒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46554,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其一","author":"赵善诏","text":"仁寿州如斗，分符愧罔功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46555,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登虎丘寺","author":"赵善俊","text":"我有家山与茂林，闭门肯复事幽寻。\n偶来千古云岩寺，洗尽三生宦海心。\n竹绠不停泉溜响，苔花难掩剑痕深。\n秋晴借得重阳意，领客登高共醉吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46556,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南郊即景","author":"赵善信","text":"胜日觅芳行，白云朝露湿。\n沙头人过频，桥底湍流急。\n花在隔篱明，鹃于高树泣。\n青帘沽酒家，和气春风集。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46557,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"车辂院书怀","author":"赵善信","text":"地僻人稀到，兀然对百楼。\n墨花香入砚，诗草色倾瓯。\n昼迥抛书睡，雨馀著屐游。\n还须期报主，檀爇紫云浮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46558,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"步月池","author":"赵善信","text":"灯火黄昏尽，无家不掩门。\n为看桥上月，印破水中云。\n树影纵横见，蛙声杂遝闻。\n幽人思正苦，独坐更难论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46559,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题十咏堂","author":"赵善宣","text":"十咏名堂岁月深，我来访古辟荆榛。\n依村结屋临山址，种柳寻花傍水滨。\n珠玉旧传清唱在，沧浪初棹绿波新。\n此心乐与邦人共，要使浑如郡北春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46560,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和帅座劝农三首 其三","author":"赵善括","text":"投老归欤一草亭，荜门蕙帐对兰屏。\n自从滥吹红莲幕，孤负东风柳眼青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46561,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和帅座劝农三首 其二","author":"赵善括","text":"指日追锋数驿亭，论恩便合对丹屏。\n行看功业掀天地，陈迹俱堪入汗青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46562,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和帅座劝农三首 其一","author":"赵善括","text":"光风骀荡满春亭，岳麓云开九叠屏。\n珍重元戎奉明诏，一犁膏雨晓痕青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46563,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和阳运干见招集句","author":"赵善括","text":"漠漠穷阴断送秋，杖藜徐步向芳洲。\n但将酩酊酬佳节，一笑相从万事休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46564,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"隔凡石","author":"赵善括","text":"见说仙凡事不同，道旁先问石屏风。\n十洲三岛不须去，绛阙瑶台在此中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46565,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题壁","author":"赵善括","text":"平芜行尽又青山，水绕寒堤绿一湾。\n征客红尘自来去，碧林鸣鸟独幽闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46566,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中秋下浣次计幕诸公佳什之韵 其一","author":"赵善括","text":"驹隙匆匆不暂留，谁能宴坐学裴休。\n君携嘉客江亭醉，我泛扁舟楚泽秋。\n水浸斜阳红影湿，烟横叠巘翠光浮。\n何时再卜秋屏约，共踏西风烂熳游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46567,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中秋下浣次计幕诸公佳什之韵 其二","author":"赵善括","text":"短棹夷犹任去留，尘劳今日暂休休。\n飞觞莫问重城晚，揽镜须惊两鬓秋。\n千里归艎何日到，一眉晴绿与云浮。\n殷勤更问黄花信，准拟重阳一再游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46568,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"天宝洞天","author":"赵善括","text":"扳缘石磴入青冥，雾廓云开万象清。\n夭娇老杉龙欲舞，纵横卧石虎方狞。\n二仙昔被桃源误，四皓今馀橘隐情。\n拟入清都真洞府，一帘寒溜隔飞琼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46569,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王提举閤政钱夫人挽诗 其一","author":"赵善括","text":"阀阅由忠孝，闺门仰静专。\n俭勤天所赋，容德古难全。\n云诰疏华国，霓旌返洞天。\n风霜孤鹤恨，衔羽唳寒烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46570,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]