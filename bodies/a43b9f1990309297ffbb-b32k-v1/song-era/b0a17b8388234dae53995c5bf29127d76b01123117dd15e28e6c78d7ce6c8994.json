[{"title":"次张丞送菊韵二首 其一","author":"陈造","text":"粉身免泛杯中物，并驾容陪陇首花。\n况耐岁寒双干在，周旋三益羡君家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18577,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次张学录韵十首 其七","author":"陈造","text":"广文无酒钱，到官倏改火。\n清谭坐萧斋，惟子屡过我。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18578,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次张学录韵十首 其六","author":"陈造","text":"张子五车读，笔作蛟龙腾。\n百战气弥厉，依然短檠灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18579,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次张学录韵十首 其一","author":"陈造","text":"俗习有南北，交情无故新。\n得子班荆地，朴鲁俱淮人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18580,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次林子长教授韵 其二","author":"陈造","text":"豫章材成七年后，潢潦眼看三尺彊。\n山翁坐阅刺天翼，抱书亦耻崔嵬藏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18581,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次玩鞭亭小诗韵 其二","author":"陈造","text":"窃禄未辞官九品，归田止欠屋三间。\n著书他日藏岩穴，或继淮南大小山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18582,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次玩鞭亭小诗韵 其一","author":"陈造","text":"心事即今惊白发，世情从昔彀黄间。\n窦家锦上四百字，祇道藁砧山复山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18583,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次姜尧章饯徐南卿韵二首 其二","author":"陈造","text":"风调心期契钥同，谁教社燕辟秋鸿。\n莫年孤陋仍漂泊，可得斯人慰眼中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18584,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次姜尧章饯徐南卿韵二首 其一","author":"陈造","text":"姜郎未仕不求田，倚赖生涯九万笺。\n稛载珠玑肯分我，北关当有合肥船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18585,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次赵帅喜雪韵","author":"陈造","text":"府公忧国雪神知，三白呈祥不待祈。\n旧岁新年多乐事，一时分付笔如飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18586,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次赵帅韵三首 其三","author":"陈造","text":"诗仙催客共流霞，不待高城噪晚鸦。\n好竞春光醉良夜，即今庭院已飞花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18587,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次赵帅韵三首 其二","author":"陈造","text":"游人笑语问朝霞，处处相随攫肉鸦。\n上冢归来更乘兴，醉依柳影藉梨花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18588,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次赵帅韵三首 其一","author":"陈造","text":"眼眩如看九色霞，女肤侧理字栖鸦。\n挽回春事凭诗力，留住风林欲褪花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18589,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次梁教授见贻韵五首 其五","author":"陈造","text":"敝帚千篇漫手缄，分无三字入官衔。\n消磨不尽干云气，时作长虹贯夜岩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18590,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次梁教授见贻韵五首 其四","author":"陈造","text":"藏室仙经玉作函，一编当复翠鸾衔。\n即今尚喜观书眼，月射清池电耀岩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18591,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次梁教授见贻韵五首 其三","author":"陈造","text":"谁向仙曹接胜谭，金泥天篆署冰衔。\n如闻不惜蜚霞佩，乞与耕莘与筑岩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18592,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次梁教授见贻韵五首 其二","author":"陈造","text":"沐猴岂合缠章服，野马如今脱辔衔。\n屈指悔来坡下路，瘦筇随客上巉岩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18593,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次梁教授见贻韵五首 其一","author":"陈造","text":"红尘半世仅绯衫，白首官曹两换衔。\n羞见淮乡隐君子，紫芝黄独老嵌岩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18594,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次程平叔韵二首 其二","author":"陈造","text":"诗情对景可胜长，酒与鹅儿斗嫩黄。\n忠贯主人真好事，肯来訾省沈东阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18595,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次程平叔韵二首 其一","author":"陈造","text":"故人常叹别时长，一笑眉开色便黄。\n领略西园好风景，凭君更唤郭汾阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18596,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵王统制喜雨","author":"陈造","text":"公馀竞病挥诗笔，谁似风流老伏波。\n对雨肯来同把酒，当令阿素为君歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18597,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵吴守四首 其四","author":"陈造","text":"当日谪仙随凤诏，毫端写出禁园春。\n沉香亭北人沉醉，误认龙香在领巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18598,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵吴守四首 其三","author":"陈造","text":"莫管龙公懒放晴，主宾笑语自生春。\n不妨妃子天香面，满压林宗折角巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18599,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵吴守四首 其一","author":"陈造","text":"十日阴寒此日晴，归来趁赏大花春。\n主家千斛香泉碧，却自摩挲漉酒巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18600,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵张丞","author":"陈造","text":"官上绝无歌酒乐，堆豗了事孰非痴。\n开樽良省缠头费，却有新章赠雪儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18601,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵张守三首 其三","author":"陈造","text":"虐天子子是无天，谪一何妨惠亿千。\n闻道蝎中犹滑涣，可偕五细尚穷边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18602,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵张守三首 其二","author":"陈造","text":"平时漫诧跳梁去，末势宁逃死弃如。\n但遣鲸鲵绝吞噬，茫洋春泽尽嘉鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18603,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵张守三首 其一","author":"陈造","text":"频岁中田苦螟螣，为渠秉畀作丰年。\n只今鼠子诛求地，巷议街谈一粲然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18604,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵张守四首 其四","author":"陈造","text":"葱青嘉树被平岗，素艳丹葩半在亡。\n安得芳春并好客，一时难老倚玄霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18605,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵张守四首 其三","author":"陈造","text":"舟凌清泚转弯环，立鹭驯鸥拱挹间。\n还忆苕溪听鸣橹，归来清梦定家山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18606,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵张守四首 其二","author":"陈造","text":"新诗囊锦堕春窗，旋炷铜炉百和香。\n试握毛锥支劲敌，独怜赤手强扶疮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18607,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵张守四首 其一","author":"陈造","text":"画舫前头碧湛空，晴云低影更溶溶。\n横陈景物无央数，尽献诗翁阿堵中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18608,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵张守仲思食车螯","author":"陈造","text":"斤除介甲更加鞭，隽永丰腴旧所便。\n蛏弟蛤兄从倚市，车公酒处信光前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18609,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵杨宰汲泉浸栀子花","author":"陈造","text":"山行不识小人羹，但有清寒饷瓦罂。\n想见雪肤陪独夜，世间无比长官清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18610,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵杨宰思庭竹","author":"陈造","text":"数寻脆碧袅轻阴，岁不知寒暑不侵。\n属厌吟风仍啸雨，尽收县解入琴心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18611,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵杨宰食野莲","author":"陈造","text":"小尝绀菂掉吟头，甓社湖阴风露秋。\n仙实休誇华峰顶，吮霜咽蜜亦其流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18612,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵杨宰凌霄花","author":"陈造","text":"高花笑属赋花人，花自鲜明笔有神。\n可惜人间两清绝，不教媚妩对闲身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18613,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵杨宰捕蝗宿兑岩四首 其四","author":"陈造","text":"龙公私我雨霶浪，酿酒须防有乞浆。\n惭愧四邻千万室，略无笑语及时旸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18614,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵杨宰捕蝗宿兑岩四首 其三","author":"陈造","text":"去为民劳走险艰，停骖几问具茨山。\n祇今欲致贤劳谢，诗债徒能准数还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18615,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵杨宰捕蝗宿兑岩四首 其二","author":"陈造","text":"旱蝗蔽土翳云空，遥想驱驰逐转蓬。\n端坐赖君酬一饱，老颜可讳发惭红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18616,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵杨宰捕蝗宿兑岩四首 其一","author":"陈造","text":"归来闻道颇休闲，蝗事今随暑气残。\n我欲一樽供软脚，还能冲雨过苏端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18617,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵杨宰爱竹","author":"陈造","text":"看竹排门爱靓深，青青不受雪霜侵。\n谁知倦客幽寻去，老越风波亦此心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18618,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵赵帅","author":"陈造","text":"平山已自胜超然，况复莺花二月天。\n管领莺花属仙伯，不应草草赋归田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18619,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵赵帅二首 其二","author":"陈造","text":"妓台香里漏声残，金步摇歌闹作团。\n羯鼓更催银字管，等闲惊破一天寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18620,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵赵帅二首 其一","author":"陈造","text":"天公一笑晚云残，戏与璇穹贴白团。\n试问天风摇翠袖，玉肌何似玉笙寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18621,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵赵帅五首 其五","author":"陈造","text":"南游可待再书催，芍药酴醾陆续开。\n看自花开到花落，红蕖时候却归来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18622,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵赵帅五首 其四","author":"陈造","text":"红药主人修月手，渌樽许为故人开。\n肯教客子如王式，一听骊驹却悔来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18623,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵赵帅五首 其三","author":"陈造","text":"一昨波光修禊事，宾奁俯枕玉奁开。\n重游鸥鹭应偷眼，定记曾陪杖屦来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18624,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵赵帅五首 其二","author":"陈造","text":"前知红药翻阶处，别许金腰一朵开。\n名在金瓯花会得，即看飞诏下天来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18625,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵赵帅五首 其一","author":"陈造","text":"平时花酒费诗催，块坐愁城谁为开。\n六辈妖姬十从事，先生亲遣斩关来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18626,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵赵帅寒食四首 其四","author":"陈造","text":"夜雨勾芒正主臣，晴云暖霭晓来新。\n小軿径趁遨头去，共醉郊园烂熳春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18627,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵赵帅寒食四首 其三","author":"陈造","text":"散吏容陪汉鼎臣，隆隆恩意为谁新。\n重来画戟凝香地，烂醉琼枝璧月春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18628,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵赵帅寒食四首 其二","author":"陈造","text":"日佩诗囊侍贵臣，向人肯作白头新。\n自今歌酒追随去，犹有风烟一半春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18629,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵赵帅寒食四首 其一","author":"陈造","text":"瘦岛寒郊祇外臣，先生俊逸更清新。\n劝耕小出仍寒食，剩办新诗报答春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18630,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵赵帅蜡梅","author":"陈造","text":"窗底闲寻断续香，贴金谁此憩风裳。\n汉姬懒赴昭阳燕，宫额涂成却覆觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18631,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵袁宪打冰移舟三首 其三","author":"陈造","text":"东行定见野桥梅，望望花随驿使来。\n曾约南枝春信否，急烦好句与催开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18632,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵袁宪打冰移舟三首 其二","author":"陈造","text":"留滞何曾念奋飞，君恩已布得徐归。\n贤劳肯羡膏粱子，醉眼瞢腾坐妓围。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18633,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵袁宪打冰移舟三首 其一","author":"陈造","text":"倚柂扶篙待打冰，回思鹢首漱波声。\n定知行止非人计，料理诗愁唤曲生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18634,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵袁宪劳军许浦中路冰合二首 其二","author":"陈造","text":"细读清诗拟泣岐，问津平日几河湄。\n只今西去须遵陆，平地风波恐更危。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18635,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵袁宪劳军许浦中路冰合二首 其一","author":"陈造","text":"风声雪意恣冯陵，更挟霜华夜气凝。\n水伯护河银作板，欲留公斗玉壶冰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18636,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵诸公绝句 其一","author":"陈造","text":"琳宇无尘夜色鲜，露明丛菊月临渊。\n世间人境双清处，诵与西风更此编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18637,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵诸公绝句 其二","author":"陈造","text":"荆玉骊珠忽满前，未须攻石探涛渊。\n南帆自诧归装富，准拟重呼阿买编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18638,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵郭帅梅三首 其三","author":"陈造","text":"后乘从公访古梅，梢含笑脸未全开。\n不妨东閤撩诗兴，未分愁听起夜来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18639,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵郭帅梅三首 其二","author":"陈造","text":"薄游他日为寻梅，烂赏菁村十里开。\n冰影玲珑想仍旧，梦为庄蝶认香来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18640,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵郭帅梅三首 其一","author":"陈造","text":"客子徒烦赋忆梅，怯寒未肯腊前开。\n定知酒处频回首，有待江南信使来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18641,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵郭教授雪二首 其二","author":"陈造","text":"世纷长作眼中尘，酒力能回物外春。\n清论挟霜诗映雪，即今超俗赖斯人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18642,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵郭教授雪二首 其一","author":"陈造","text":"霏霏透隙上承尘，想见园林玉树春。\n明日银杯随宝马，城东应有探梅人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18643,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵钱倅诸公睡香花四首 其四","author":"陈造","text":"小篱护殷鲜，久厌杂芳眩。\n风烟桃李蹊，一付檀槐战。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18644,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵黄簿 其一","author":"陈造","text":"先生不著惠文冠，须信论才当价难。\n法律剡章真未尽，盍言粹学辈豪韩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18645,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵黄簿 其二","author":"陈造","text":"挥毫丽句得旁观，字字悬黎间木难。\n可但诗声高海内，有人金换过三韩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18646,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵答陈梦锡十首 其十","author":"陈造","text":"诗人锋铓不可触，瞢揽鲸牙撩虎须。\n飞来此编更作意，诗行快对夔州图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18647,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵答陈梦锡十首 其六","author":"陈造","text":"冰檗未肯执名卿，搔头自剔书窗灯。\n君家老人如椽笔，浙江鄞水倒泓澄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18648,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵答陈梦锡十首 其五","author":"陈造","text":"姜子嗜酒不良行，诸公俛顾惭登瀛。\n尚堪坚坐作周鼎，底用诗名满凤城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18649,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵答赵文卿四首 其四","author":"陈造","text":"帘疏财许客窥班，未得缠头小破悭。\n已结云愁蜚蝶梦，莫斜秋水蹙春山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18650,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵答赵文卿四首 其三","author":"陈造","text":"小燕招邀慰病颜，何曾雨涩与风悭。\n分明喜鹊先知得，未晓飞鸣闹屋山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18651,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵答赵文卿四首 其二","author":"陈造","text":"平日诗声不易班，联翩属我未应悭。\n得无纸贵咸阳市，当有人逢饭颗山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18652,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵答赵文卿四首 其一","author":"陈造","text":"才名一世未通班，天向诗人每坐悭。\n不作上书来北阙，可无携妓醉东山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18653,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵答璧侍者五首 其五","author":"陈造","text":"欲买青山贷寓居，时临绝顶瞰平湖。\n已容下榻烦重问，肯念吾贫折券无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18654,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]