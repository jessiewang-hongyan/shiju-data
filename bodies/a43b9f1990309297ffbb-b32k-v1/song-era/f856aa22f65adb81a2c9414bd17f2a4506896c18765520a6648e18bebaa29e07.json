[{"title":"次曾景建红泉碧涧韵 其一","author":"赵汝谈","text":"诗评明水好，笑我尚逶迤。\n丹穴三千仞，苍藤千万枝。\n谷耕闻好鸟，社饮见庞眉。\n他日烦君指，书堂与佛祠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44867,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次曾景建红泉碧涧韵 其二","author":"赵汝谈","text":"石不能言语，云如过去身。\n意求虽彷佛，事往或湮沦。\n洞壑龙离隐，池塘草得春。\n山民忽惊避，吾此岸乌巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44868,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次曾景建红泉精舍韵","author":"赵汝谈","text":"康乐秀髯长拂巾，伐山走鹿辟车尘。\n才毫并触当时祸，物色分留后代人。\n环涧已为僧去碣，红泉今与子通邻。\n著书万卷精庐里，成佛生天自致身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44869,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"灵谷山","author":"王益","text":"灵谷神仙宅，言归肆目新。\n山光远如画，秋色老于人。\n世事棋争劫，人心海变尘。\n功成思范蠡，湖上一闲身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44870,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"环锦亭 其一","author":"赵汝谈","text":"与子乡邻信有年，故王遗事到今传。\n爽鸠邑改风烟在，散骑园分水竹偏。\n高架插书供夜读，满堂成綵敌春妍。\n相如可是区区者，戏笔题桥亦偶然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44871,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"环锦亭 其二","author":"赵汝谈","text":"枌社交阴旧有缘，蹇驴那得到亭前。\n青山谢傅携樽地，白水钱王守冢田。\n尚友诗书廑暇日，养亲豚韭乐丰年。\n异时驷马荣归里，虚左相迎更可贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44872,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次曾景建和谢康乐华子冈诗韵","author":"赵汝谈","text":"君言华子冈，遗迹在兹山。\n阴雾虎啸谷，熙旸乌浴泉。\n划疑易区界，遐集古圣贤。\n丹井砂荡潏，玉林桂葱阡。\n或时吹箫子，来往倏飞烟。\n徵谢靡不验，叩玄发奇筌。\n先畴乐斯隐，荒始规后传。\n小子夙慕遁，驰心结绳前。\n仙路邈难期，矫首涕潺湲。\n谒予愿有术，投翰三喟然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44873,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南湖","author":"赵汝谈","text":"每忆西湖上，青帘卖酒亭。\n柳条鱼颊翠，花片马蹄馨。\n寒食经行路，晴窗入梦屏。\n因循春又晚，风絮搅空冥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44874,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"翠蛟亭和巩丰韵","author":"赵汝谈","text":"幽亭枕苍峡，云窦通曲水。\n百折如建瓴，㶁㶁鸣不止。\n客来一抽钥，白雾噀岩底。\n欻翕千丈蛟，拿空翠涛起。\n天开混沌窍，日洗盘古髓。\n谅匪畜池鳞，多应化雷尾。\n冯陵气易壮，怖荡辞难侈。\n日假金洞光，景逾瑶池泚。\n谁云游方外，巧异缁尘里。\n坡仙颇年数，觌面犹尺咫。\n采句贵自然，巩言良是已。\n琁题豁灵界，篆出蕃君里。\n物生亦倚数，有形必有靡。\n道人亦多事，浮念何时死。\n余生嗜泉薮，痼习牵研几。\n太息动静机，于何寄真理。\n醉倒和沧浪，烦君更详此。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44875,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"翠蛟亭酬和 其三","author":"赵汝谈","text":"衣上缤翂云欲生，一山果熟看猿登。\n亦闻鳌背通朱关，几拟追寻竟未曾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44876,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水心新居","author":"赵汝铎","text":"开扉待嘉客，沽酒解闲愁。\n半夜秋霖歇，满塘寒水流。\n风声生叶底，月色在沙头。\n忆著鲈鱼美，松江有旧游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44877,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游洞霄 其一","author":"赵汝唫","text":"细雨吹凉客袂分，青灯梦短苦思君。\n洞仙应快登临眼，尽向山边扫白云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44878,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山","author":"赵汝唫","text":"茅屋初寒夜，衾裯整未成。\n烹泉沙鼎快，读易纸窗明。\n菊上霜偏力，梅边日最清。\n孤吟谁与和，落叶上阶鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44879,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别朱子大苏召叟昆仲","author":"赵蕃","text":"薄宦尘埃易满襟，问盟犹喜盍朋簪。\n只今风月一杯酒，明日云山千里心。\n杨柳阴疏秋馆净，芙蓉香冷暮江深。\n潮回一信西兴渡，频寄相思别后吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44880,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"居苦","author":"赵汝唫","text":"去郭近一里，结茅才数间。\n红尘飞不到，幽事颇相关。\n凿石分流水，移松补断山。\n栖禽忙似我，日落未知还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44881,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送梅窗兄","author":"赵汝唫","text":"离歌休再叠，我亦不堪闻。\n山接诗愁去，云随别袂分。\n官閒宁问禄，命薄谩能文。\n怅望梅边屋，花开更忆君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44882,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"栖真洞","author":"赵汝唫","text":"幅巾洒松露，双袖抖衣尘。\n可耐人间暑，来寻洞里春。\n座分云骨冷，屐隐甃纹新。\n鹤近清尊舞，如留欲去宾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44883,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游洞霄 其二","author":"赵汝唫","text":"九锁扃仙窟，栖真隔茂林。\n地灵泉石秘，岩古薜萝侵。\n屐践东山胜，樽倾北海深。\n主人娱客兴，唤起玉龙吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44884,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游洞霄 其三","author":"赵汝唫","text":"昨日始骑驴，今朝共跨鱼。\n一官尘坎壈，三径木扶疏。\n童返还知白，身轻继寝虚。\n道传传便得，元乏枕中书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44885,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诗二首 其一","author":"赵汝域","text":"醉梦腾腾听打衙，三年踪迹类瓠瓜。\n如今不似穿云子，一钵随身到处家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44886,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题栽梅桃","author":"赵汝域","text":"梅花开尽桃花开，两朵春移小院栽。\n索笑索吟殊未已，浑浑疑是故人来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44887,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诗二首 其二","author":"赵汝域","text":"数叶梧桐落短廊，一泓秋水湛银塘。\n调琴独奏猗兰操，啜茗清飘茉莉香。\n涕泣两年同贾傅，痴梦千载笑君房。\n于今不作武宁客，蓑笠渔竿日月长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44888,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"契友夜酌联句","author":"赵汝域","text":"银烛清谈久，乡情异路真。\n醉能忘世故，狂欲静风尘。\n细踏梅花月，长讴栗里春。\n不知时节换，诗句得来新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44889,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹤林寺","author":"赵汝梅","text":"仙去当年寻旧迹，传来此日尚名山。\n花开花落朝昏事，唯有春风岁岁闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44890,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舟行","author":"赵汝淳","text":"归帆东泊胥门下，夜半菱歌起白蘋。\n今日平湖皆小艇，不知谁是唱歌人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44891,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"灵岩","author":"赵汝淳","text":"古寺疏钟隔断烟，馆娃宫殿草芊芊。\n多情却有松萝月，只与当时一样圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44892,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读夷坚志","author":"赵汝淳","text":"千古丘明法度书，豕啼蛇斗未为诬。\n后来更有无穷事，付与兰台鬼董狐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44893,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"燕","author":"赵汝淳","text":"衔得芹泥入画帘，江南门巷柳花天。\n分明社燕催春老，错向东风恨杜鹃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44894,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寿放翁 其二","author":"赵汝淳","text":"此老胸中几岁寒，天教长伴白云闲。\n有时自弄玉如意，无事更添金博山。\n越女棹歌清浅处，巴童吹笛翠微间。\n何须重问神仙府，鸾鹤随风自往还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44895,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寿放翁 其一","author":"赵汝淳","text":"问讯山阴老放翁，年来心事与谁同。\n疏疏翠竹攲明月，落落黄花立晚风。\n鬓雪只缘诗送白，脸霞不是酒留红。\n君王莫下蒲轮召，万壑千岩正要公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44896,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"桃源行","author":"赵汝淳","text":"武陵溪上栽桃花，儿童笑语成生涯。\n当初避地不知远，渔郎惊问疑仙家。\n年深忘却来时路，流水春风等闲度。\n龙翔鹿走自兴亡，不到花开花落处。\n江边雨暗蛮蓑湿，父老欲留留不得。\n隔林鸡犬渐萧然，啼鸟一声溪水碧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44897,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浩歌行","author":"赵汝淳","text":"堂堂楚汉多蛮触，天下今经几秦鹿。\n向非孔壁断遗编，安得西湖芳草绿。\n子规自失来时路，却唤青春早归去。\n山中刬地乱红来，不是东风扶杖处。\n浩歌起舞君莫猜，一樽幸遇桃花开。\n貂蝉珠履黄金钗，后五百年俱尘埃。\n宫袍仙人独不死，日日长江钓江水。\n飞乌走兔且莫忙，看我烟云生碧纸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44898,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"瓜","author":"赵汝绩","text":"冰泉浸绿玉，霜刃破黄金。\n凉冷消晚暑，清甘洗渴心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44899,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"迎庆避暑","author":"赵汝绩","text":"古寺无风地亦凉，人家难得此修廊。\n老僧贪说葛藤话，不觉山童上晚香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44900,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鸡冠花","author":"赵汝绩","text":"木鸡不与众鸡同，曾逐旌阳上碧空。\n学得仙家餐玉法，至今木血不能红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44901,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"林壑閒步二绝 其二","author":"赵汝绩","text":"参差台榭碧云中，柳北松南一径通。\n带得棋枰无敌手，与僧不语立薰风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44902,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"林壑閒步二绝 其一","author":"赵汝绩","text":"懒不看书不赋诗，树阴浓处坐移时。\n世间此等清闲福，问著渔樵却不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44903,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"姚江道中","author":"赵汝绩","text":"漉酒蒸糕馈岁时，纷纷儿女换新衣。\n邻翁七十看鹅鸭，日暮破船撑未归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44904,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"柬陈宗之","author":"赵汝绩","text":"略约东风客袖寒，卖花声里立阑干。\n有钱不肯沽春酒，旋买唐诗对雨看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44905,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送竹轩归越","author":"赵汝绩","text":"东风隔岸系归航，怕送君行重忆乡。\n为探山台墙下柳，新来添得几丝黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44906,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔父","author":"赵汝绩","text":"鱼满笭箵酒满壶，渚鸥汀鹤伴清孤。\n此身漂泊虽无定，能与人间作画图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44907,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菊花","author":"赵汝绩","text":"汛扫官厅顿菊栽，老兵怕碍客车来。\n费人早晚勤浇灌，何似篱边自在开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44908,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢高左藏惠墨竹","author":"赵汝绩","text":"幅笺幻墨起秋风，便与兰亭景致同。\n料得挥毫盘礴际，渭川千亩在胸中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44909,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"韩仲和墨竹","author":"赵汝绩","text":"墨晕生冰砚影寒，素毫幻出碧琅玕。\n寻常夜月窗前见，此度秋风纸上看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44910,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和牡丹韵","author":"赵汝绩","text":"园工巧栽接，树树品新奇。\n富觉春无厌，贫疑地有私。\n色须绡幄护，名记玉牌垂。\n若说能倾日，墙根有晚葵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44911,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南坡","author":"赵汝绩","text":"小园路口安柴户，日日山翁手自开。\n禽有色声皆可玩，花无香实不须栽。\n柳根著石宜安钓，岩罅通泉可泛杯。\n更向南坡临水处，参差纯种百株梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44912,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"将归","author":"赵汝绩","text":"拄笏西山一笑中，挂帆犹及楝花风。\n此身可是屠羊说，馀事宁非失马翁。\n不问鬓毛成早白，免将痴面发羞红。\n故人新寄虔州布，归制吟袍管钓篷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44913,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"峡江龙祠","author":"赵汝绩","text":"坐占山回抱，平看水怒流。\n丹青今古像，香火往来舟。\n石插青莎岸，云横夕照楼。\n扬灵相恐动，巫觋有深谋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44914,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送荷渚兄自永嘉归越 其二","author":"赵汝绩","text":"客鬓萧疏渐秃翁，归来恍与鹤仙同。\n山川米老画图上，风月放翁诗句中。\n邻圃有蔬羹釜满，私田无秫酒樽空。\n欲寻上灶云门路，湖水不多船未通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44915,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送荷渚兄自永嘉归越 其一","author":"赵汝绩","text":"荷渚盟鸥冷不飞，此番可与报归期。\n结庐虽小尚堪隐，负郭纵荒何虑饥。\n吟得四灵无避处，铸成一错在来时。\n吾家浸碧幸无恙，草梦何须必谢池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44916,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送荷渚归越","author":"赵汝绩","text":"湘湖莼线正宜羹，一舸涛江汎晓晴。\n屋破不妨从客借，田荒自欲课奴耕。\n不随不激真吾事，乍佞乍贤皆世情。\n从此一麾江海去，西风断雁冷无声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44917,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送蔡廉父赴赣辟 其二","author":"赵汝绩","text":"西山影淡水无声，知道扁舟破晓行。\n我欲梦魂随去棹，君应望眼断高城。\n红莲绿水官中事，白酒黄花客里程。\n从此郁孤台上月，十分知为故人明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44918,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送蔡廉父赴赣辟 其一","author":"赵汝绩","text":"同游两见菊花时，忍对西风话别离。\n官远人应观所主，心平事必得其宜。\n急流进进常思退，公事惺惺要带痴。\n执手羞为儿女语，此言或可当箴规。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44919,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"桧房","author":"赵汝绩","text":"老桧倚虚房，能生九夏凉。\n读书参句读，临字识偏傍。\n婢织蒲为履，童烧朮当香。\n兴来吟不就，频与月商量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44920,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"离越","author":"赵汝绩","text":"东关寒水深，游子别家心。\n棹急波鸣枕，篷疏月在衾。\n半生多道路，何日定山林。\n隔岸闻渔唱，离骚不敢吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44921,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔父","author":"赵汝绩","text":"换米活妻子，馀钱付酒家。\n身前舟似叶，世上事如麻。\n独鳖过深浦，伴鸥眠浅沙。\n旁人问醒醉，鼓枻入芦花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44922,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"道中登岭","author":"赵汝绩","text":"惭愧轻舆寄仆肩，蛇蟠小径入层巅。\n升高但觉少平地，视下方知在半天。\n尺垄寸田皆石级，堵墙椽屋即人烟。\n客程到此更风雪，闻一禽声恐杜鹃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44923,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雁山章君以江山无尽图求诗","author":"赵汝绩","text":"写此何人云梦胸，色尘真幻等成空。\n看君一轴画图上，在我半生行记中。\n剡水回舟乘夜雪，楚江燃烛听秋风。\n转蓬踪迹徒劳耳，心愧雁山头白翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44924,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"溪翁惠秋兰","author":"赵汝绩","text":"不梦灵均久，西风为返魂。\n顿忘千载远，但喜一香存。\n劲叶牵湘色，疏花洗露痕。\n勿嫌盆盎小，能贮雪霜根。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44925,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"忆昔一首","author":"赵汝绩","text":"忆昔三十气拂云，钺神纛鬼泣祃文。\n欲提河洛数千里，重收图版归明君。\n只今万事付孤愤，坐看江西竹生粉。\n苧丝成疋剪钓衣，一棹贺湖烟水远。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44926,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"无罪言","author":"赵汝绩","text":"哀哀民何辜，遭此凶歉厄。\n初闻数米炊，次复并日食。\n草根掘欲尽，木皮屑不给。\n疲老就枯僵，少壮作捐瘠。\n千百存什一，乌喙仍菜色。\n朝忧夕恐惧，不得见新麦。\n城市逐末徒，奔走困贵籴。\n剥床遂及肤，近半死于疫。\n吾皇素仁惠，一念轸饥溺。\n发粟通有无，宽逋已徵索。\n郡县乏宣化，鞭扑庭下赤。\n贪官猴而冠，健吏虎而翼。\n天灾偶参会，人意莫致诘。\n淮楚困烽尘，荆蜀毙锋镝。\n湘潭烦调戍，洪赣事供亿。\n昔闻惟内地，可以称乐国。\n岂料一年饥，狼狈如此极。\n公卿饱舆台，王侯罗第宅。\n私财足苞苴，公帑罄符籍。\n匪难活民命，何以寿国脉。\n子牟心徒劳，之武壮自惜。\n安得扣九关，玉阶面咫尺。\n天地本至仁，君臣愿一德。\n贤人斯在位，能者各效职。\n太守务循良，监司去姑息。\n智则谋朝野，勇则卫疆埸。\n自然风雨时，自然稼穑植。\n自然至和生，自然元气实。\n何忧乎驩兜，何畏乎强敌。\n勿罪狂斐言，斯言定金石。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44927,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"出郊","author":"赵汝绩","text":"难得晴如许，春游第一番。\n鸟啼花底树，云裹面前山。\n马跃平沙地，帆投落日村。\n戏呼渔子问，吾与汝谁闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44928,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别曹松山","author":"赵汝绩","text":"柳条能几长，袖手不忍折。\n东风恶作剧，客袂吹欲裂。\n男儿数寸管，平世三尺铁。\n何门无邹裾，有国驻孔辙。\n鹰鹯击飘风，不受锦鞲绁。\n骅骝踏飞电，宁顾黄金埒。\n中年易悲伤，浩叹弥激烈。\n常恐儿曹觉，况与我辈别。\n侏儒囊粟饱，壮士唾壶阙。\n子行亦何以，问口尚存舌。\n但惜新相知，未是古决绝。\n长安万花春，芦鞭袅晴雪。\n一第宜慁子，相期抱贞节。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44929,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陈老画牛","author":"赵汝绩","text":"老融弃发逃于禅，胸藏丘壑身林泉。\n时拈寸草幻墨汁，惨淡咫尺生风烟。\n尤工画牛古绝比，不特形似真神全。\n平生知己一攻愧，惜墨如命诗犹传。\n至今鄞人怀片纸，如护圭璧珠玑然。\n陈生少壮曾入室，妙处已觉墙及肩。\n岸痕树影彷佛地，云阴雨气冥濛天。\n寒禽立背渡浅水，野葑没足行淤田。\n砺角思斗力居尾，倚木揩痒势拥前。\n或沿草径逐群去，或傍茅檐抱犊眠。\n如何尽得此态度，前身想住桃林边。\n世人贵耳不贵目，呜呼此画空尔妍。\n我方求之不论钱，卷收更阅三十年。\n欲寻此老不可得，摩挲陈迹方争怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44930,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"环碧园饯信守赵兰皋分韵得燕字","author":"赵汝绩","text":"开窗俯平湖，折柳举离宴。\n五马迟未发，暗雨杂飞霰。\n江东古名州，广信今近甸。\n兵骄费纪律，民瘠易咨怨。\n硗田岁少登，孔道楮常贱。\n正须儒者事，毋愧循吏传。\n休辞一杯酒，往副千里愿。\n有语不敢留，低间愧樯燕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44931,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]