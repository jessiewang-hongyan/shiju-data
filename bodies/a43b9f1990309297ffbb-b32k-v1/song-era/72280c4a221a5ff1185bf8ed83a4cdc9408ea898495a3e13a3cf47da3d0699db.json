[{"title":"项似道眉子砚","author":"许月卿","text":"新安砚石旧多奇，砚入黄扉得所归。\n呵水浮云尤物视，传衣半夜伟人知。\n坡仙为欠十眉咏，李及何妨一砚持。\n堪笑泉田老居士，无端浑沌尽新眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40210,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽妹婿汪汻四首 其四","author":"许月卿","text":"亡恙壁岩日，媒云妇有依。\n世科君六世，时事彼一时。\n寂寞吾州隔，诸孤我妹慈。\n九京逢桂老，东坦愧羲之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40211,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽妹婿汪汻四首 其三","author":"许月卿","text":"一疾那知死，三朝竟不醒。\n遗羹真惨怆，分肉尚精明。\n玉树衣难綵，壁岩毡枉青。\n英魂千古在，稚子读书声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40212,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽妹婿汪汻四首 其二","author":"许月卿","text":"郎罢当年语，深闺婉娩三。\n有齐之季女，必得有奇男。\n满目呱呱泣，伤心切切弹。\n离鸾惊别鹄，何日泪痕乾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40213,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"涉世","author":"许月卿","text":"涉世如溪谷，只宜在浅处。\n一生如一日，未暮早归去。\n君不见伟哉男子韩淮阴，往往正坐涉世深。\n功成身退岂不好，当时何事归不早。\n人生少年须立事，生我不应负天地。\n了却君王事便休，去时莫待雨淋头。\n如今版图半烟雾，眼看流离无限子。\n取将旧物还君王，襁褓赤子寝之床。\n青天白日正亭午，归去弹琴鹤对舞。\n静与贤传不□□，春风吹袂浴沂天。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40214,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题张宗玉窗下庐山","author":"许月卿","text":"庐山移到龙溪东，两壁生云无数峰。\n梦与文渊三峡水，共参金露九秋风。\n万山恍对凝尘榻，五老仝携入室筇。\n更问濂溪风共月，又移窗下到脑中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40215,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅叟","author":"许月卿","text":"梅叟真佳客，冰壶贤主人。\n移樽随月饮，顾典到更深。\n蜡炬精神耐，梅花气象新。\n明朝山屋去，隐者讵能寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40216,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"野人","author":"许月卿","text":"野人方蠖屈，天子正龙飞。\n东阁翘林騪，北山□□移。\n鵩来贾生去，熊兆太公归。\n地主殷勤别，云霄万里期。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40217,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"新安","author":"许月卿","text":"新安别无奇，只有千万山。\n千山万山中，其奇乃出焉。\n下者为砚石，与世生云烟。\n高者无系累，飘然出神仙。\n忽生朱晦庵，追千万世前。\n示千万世后，如日月当天。\n呜呼新安生若人，不知再生若人是何年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40218,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"满城风雨近重阳","author":"许月卿","text":"满城风雨近重阳，一舸烟波入醉乡。\n心事已同鸥鸟白，眼界空有云山苍。\n酒安能管兴亡事，菊亦颇复时世妆。\n何似长歌明月里，月明天阔地更长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40219,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"暮春联句九首 其九","author":"许月卿","text":"贺公雅吴语，文靖咏唐风。\n我自儒多误，心惭佛六通。\n将焉用彼相，不肯为渠公。\n明月夜满目，晴云晓荡胸。\n马更骑东下，骝更入花中。\n无虑殊难老，有头能自翁。\n徜徉生计拙，潇散自谋忠。\n白酒杯中满，红尘门外讧。\n汉轮谩牧叟，鲁质不周丰。\n自诡冰坚渡，如新火浣同。\n青山青未了，绿水绿无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40220,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"暮春联句九首 其八","author":"许月卿","text":"燮调能十雨，具训微三风。\n希圣如颜子，何时笑叔通。\n明经徒为利，秽史不能公。\n落落经纶腹，悠悠锦绣胸。\n茶烟禅榻上，花蕊酒杯中。\n皇览方佳少，青衫已秃翁。\n凄凉语棐话，寂寞教咸忠。\n青嶂鹤仙返，白杨鸦夜讧。\n庭前双桂树，堂上六经丰。\n皇帝春秋盛，车书夷夏同。\n移忠聊士诺，独善未妨穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40221,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"暮春联句九首 其七","author":"许月卿","text":"寸心元有雨，八面更当风。\n精卫海能涸，杜鹃天可通。\n君臣知有义，褒贬岂无公。\n一展霹雳手，九吞云梦胸。\n狂澜障川外，砥柱横流中。\n曷不身伊尹，空教口晦翁。\n主忧臣不辱，世乱孰为忠。\n白日青天共，潢池渤海讧。\n居家移官理，忧国愿年丰。\n今古心符节，乾坤理勘同。\n普能知道大，院不虑途穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40222,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"暮春联句九首 其六","author":"许月卿","text":"徐字不晋帖，楚诗无国风。\n天边长剑倚，花外小车通。\n不肯吏文叔，谁能书子公。\n二三豪俊骨，数万甲兵胸。\n柳暗琴三叠，梅残酒一中。\n羡君屠龙技，笑我祝鸡翁。\n击瓮浮儿志，编桥度蚁忠。\n行春奉宽诏，佩犊弭兵讧。\n天阔吟边远，月明诗檐丰。\n秋光宦情薄，鸾鹤啸声同。\n清涧耳堪洗，深山目更穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40223,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"暮春联句九首 其五","author":"许月卿","text":"我似濂溪拙，人嗤凝式风。\n天连千障合，水可四溟通。\n我友二三子，他年十八公。\n逍遥吟弄趣，洒落霁光胸。\n傲睨芸香里，醉眠花影中。\n文章解迁史，诗律更涪翁。\n与酒交逾密，为花谋必忠。\n鹤琴清夜警，莺燕暮春讧。\n冰释契杜预，露晞询巩丰。\n几能知至至，学贵不同同。\n山水清音有，园林胜事穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40224,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"暮春联句九首 其四","author":"许月卿","text":"沃心裨帝学，古道畅皇风。\n天下真无敌，君前置一通。\n将拚龙尾砚，去作鱼头公。\n笔底澜翻舌，谈间磊块胸。\n通明云殿上，清切玉堂中。\n发轫同安簿，深衣独乐翁。\n孝经题幼志，沼鉴见精忠。\n元祐龙蛇杂，开禧蟊贼讧。\n隆冬老儒立，奸党一碑丰。\n三晋春秋在，千年纲目同。\n长天炤孤愤，清夜好研穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40225,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"暮春联句九首 其三","author":"许月卿","text":"祥云仍瑞日，霁月更光风。\n虹夜书船满，鸡林诗贾通。\n十行宽四海，一国咏三公。\n经史遮眵目，古今浇渴胸。\n太玄难准易，皇极辩非中。\n清夜谈玄处，盛时无极翁。\n乾坤涵奥学，日月照孤忠。\n自信区区者，遥怜处处讧。\n天无厌周德，年候克商丰。\n群后集班瑞，宗人宅受同。\n太平无以报，真意渺何穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40226,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"暮春联句九首 其二","author":"许月卿","text":"畏爱盾衰日，清和夷惠风。\n仁何如管仲，恩罔极王通。\n王必三微谨，天为一大公。\n五行应过眼，万字佛头胸。\n治国运掌上，经书满腹中。\n凭栏心尚壮，引镜鬓俄翁。\n锡屈天生德，教咸黄览忠。\n齐夷靡瞻骋，内外诅万讧。\n一酌泉流浊，四知囊匮丰。\n咏觞聊畅叙，羹水辨和同。\n不当陈三价，难逃黄九穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40227,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"暮春联句九首 其一","author":"许月卿","text":"清庙朱弦瑟，羔羊素緎风。\n钓竿渔艇小，园径李蹊通。\n白酒浑忘送，皇天似不公。\n风檐开秀色，雪岭现酥胸。\n王化殊无外，圣贤时复中。\n人称君子子，卿自密翁翁。\n从唤酒经癖，聊纾花史忠。\n前知安用卜，定见不访讧。\n橘仆使令熟，竹君家计丰。\n六年无不可，三语将无同。\n柳子惯乞巧，韩公不送穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40228,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"箕山","author":"许月卿","text":"箕山惟一瓢，襄邑亦四壁。\n古今一许氏，传家以清白。\n茶山与东莱，三诗映圭璧。\n后来二三贤，题品互紬绎。\n南轩推学授，晦翁要事实。\n亦有小东莱，经济亦何切。\n极意深源流，敷殖久大业。\n临川有二许，我来秋萧瑟。\n抚卷三叹起，寒花香的皪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40229,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题明皇贵妃上马图","author":"许月卿","text":"开元天宝号太平，快活三郎偏纵情。\n帝闲天骥云雷駃，回首绝怜妃子醉。\n海棠酣春睡未足，扶上马时颓山玉。\n二珰两边扶蹋?，群姬争扶不用命。\n万花丛，玉山花，花朝王，醉牡丹。\n共立马前黄幡绰，献笑颜容似嘲谑。\n三郎勒马频回头，两手按膝双凝眸。\n夹立两旁御弓箭，带御器械如行殿。\n二珰相语俨相向，贵妃未至龙颜望。\n龙颜不怡吾曹忧，昵昵私语双燕秋。\n御前两骥立仗俟，御龙整暇聊缓辔。\n卷中何止数十人，十人眼只在一身。\n朕能坠马替妃子，不忍花飞惊玉体。\n三郎但念妃子醉，岂知身醉误国事。\n傥知敬是常惺惺，提主人翁教醉醒。\n丑丑妇斟薄薄酒，丑妇添翁多少寿。\n无盐为后能彊齐，夙夜警戒鸡鸣诗。\n花钿安得纷委地，马嵬安得有坠时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40230,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题俞时琰杏山堂医","author":"许月卿","text":"妖冶来奔夜色昏，毅然绝谷有神明。\n春融庭畔一帘柳，秋满湖边万顷云。\n荡涤胃肠无秽浊，洞明空色有真清。\n陈楼相问胡卢处，本事方书世并行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40231,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题清足堂","author":"许月卿","text":"秀翁今又以光名，窗外琅玕不欠清。\n十八公松曾入梦，两三竿竹岂无情。\n红尘不近春风瑟，翠色能添夜雪灯。\n我欲钓竿蓑笠去，斸分烟雨子还能。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40232,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠李企","author":"许月卿","text":"雁湖曾是谪临川，谁道风流愧昔贤。\n共觉共兜乱尧世，何须虞芮质周田。\n三年迁客仅数舍，一日恩书落九天。\n归去来荒松菊径，勉旃忠节振家传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40233,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠胡菊轩","author":"许月卿","text":"好物不虽多，自悟方悟他。\n心迷法华转，心悟转法华。\n愿得无言经，尽度恒河沙。\n尽度一切已，依然无一物。\n籁鸣天河斜，清风共明月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40234,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"霜日","author":"许月卿","text":"霜日步行迟，云山履历长。\n芦花相逊揖，松树自宫商。\n竹动鸣珂里，桃成衣锦乡。\n水边篱落好，一夜玉为堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40235,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"露","author":"许月卿","text":"轻烟薄雾结凄迷，颗颗匀圆讶许齐。\n无雨无风闻叶响，如珠如粟压花低。\n飞来莲叶仙犹湿，吟过林稍蝉不饥。\n散洒刘郎金露掌，不垣不户总京低。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40236,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"月代","author":"许月卿","text":"月代太阳，太阳代月。\n君逸臣劳，职分无越。\n穆穆皇皇，明明在烈。\n光于四方，罔不秉哲。\n火明水清，坎离斯设。\n日月有明，容光靡阙。\n无非教也，教亦不屑。\n金取其清，分明之精。\n东有启明，西有长庚。\n金清月白，助天日明。\n日明相续，万物咸睹。\n匪今斯今，不瞽万古。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40237,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九江","author":"许月卿","text":"满目山川贤否异，对床风雨弟兄同。\n九江莫作淮西看，记得九江元是东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40238,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二芝兰","author":"许月卿","text":"一年三季炜煌煌，幽谷无风花自香。\n香水风声千鹤唳，佳儿未数谢家郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40239,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"人间","author":"许月卿","text":"人间潇洒柳塘仙，三遣诗来各四篇。\n安得左螯右杯酒，与君烂醉柳塘边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40240,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"入邑道中 其三","author":"许月卿","text":"天涵地育王公旦，德备才全范仲淹。\n万世直教悬日月，肯如秋雨谩廉纤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40241,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"入邑道中 其二","author":"许月卿","text":"鼎立三才名曰人，分明宇宙为经纶。\n不应雪虐风饕后，便作岩栖谷隐身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40242,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"入邑道中 其一","author":"许月卿","text":"苒苒岁除佳树少，行行高处烈风多。\n世间无若归田好，其奈吾生未老何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40243,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与郑婺源","author":"许月卿","text":"凄凉客舍岸维舟，明月清风古渡头。\n飞雁不来云欲暮，碧英一树十分秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40244,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"千年","author":"许月卿","text":"千年光景东西汉，一把春风大小乔。\n坐啸行吟芳草碧，杜鹃时节雨潇潇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40245,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"无山","author":"许月卿","text":"无山平野云天阔，有月高楼烟水微。\n渴睡车中莺一啭，愁吟路上蝶双飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40246,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"月明","author":"许月卿","text":"月明如昼好元宵，歌管楼台景色饶。\n鹤舞琴声相应答，梅花清福共谁消。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40247,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"月庵 其一","author":"许月卿","text":"羽人萧散月庵深，问月青天无古今。\n但放虚庵如月样，更教月住在庵心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40248,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"月庵 其二","author":"许月卿","text":"广寒只欠栽梅树，寄傲何须傍桂林。\n君尚有庵我无有，不遮明月半边阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40249,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乐天","author":"许月卿","text":"乐天歌里商人妇，子美诗中黄四娘。\n莫向痴人前说梦，世间万事海茫茫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40250,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用韵吴初邻","author":"许月卿","text":"沆瀣昆崙未晓霞，霞边何处着瑶花。\n初邻扁字光穿室，花外何时我小车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40251,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"休休","author":"许月卿","text":"休休何似禹行水，往往浑如宋揠苗。\n看到五行精妙处，月明溪上竹萧萧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40252,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"有感 其二","author":"许月卿","text":"日忽出天将有雪，雨将降地忽无风。\n阴阳二气循环耳，静入儒生一笑中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40253,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"有感 其一","author":"许月卿","text":"晴明佳思吟难尽，雨雪愁寒拨不开。\n天地中间许多事，不应暑往不寒来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40254,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵马枢密 其二","author":"许月卿","text":"年来闭户学崇深，邂逅论文悦我心。\n浊酒一杯茶一椀，坐看日影转桐阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40255,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵马枢密 其一","author":"许月卿","text":"卧听急雨半篙深，晓展芭蕉数尺心。\n携手方山行乐处，满林松竹翠阴阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40256,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵用学礼 其二","author":"许月卿","text":"跫然诗句慰空虚，拭目科名看到渠。\n了却科名诗未晚，殷勤圯上一编书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40257,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵用学礼 其一","author":"许月卿","text":"章泉姓字馥于梅，宅相相逢亦妙哉。\n见说章泉诗刻梓，幸分一本洗尘埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40258,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵胡同年女","author":"许月卿","text":"吴猛幽闺毓彩鸾，飞琼相约下人寰。\n老翁年复儿时貌，乞我灵丹驻玉颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40259,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"此行","author":"许月卿","text":"此行得得不虚行，两豸雌雄聚德星。\n忧国爱君吾辈事，嘱君当局唤惺惺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40260,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"访渭阳","author":"许月卿","text":"舅待甥如待大宾，玳筵致语厚词人。\n玉堂金马和风月，应有佳篇继后尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40261,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吟蛩","author":"许月卿","text":"吟蛩不管兴亡事，舞蝶那分梦觉身。\n别浦连墙归远客，高山小径过樵人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40262,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"呈翁司理名方子擢婺邑","author":"许月卿","text":"桃李春风山谷酒，河阳桃李更春风。\n风流建水翁承赞，樽酒论文千载同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40263,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"咸淳五年天下都散汉许月卿饮无算醉后吟诗秉笔达旦","author":"许月卿","text":"达旦吟诗达旦饮，半生信直半生贫。\n睡魔犹侮汪梅叟，何况悠悠俗累人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40264,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日","author":"许月卿","text":"夜雨昼晴花世界，晚风朝露柳精神。\n花花柳柳春何限，安乐窝中第一人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40265,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"荼縻","author":"许月卿","text":"玉质清绡爱道装，不嫌春暮越芬芳。\n宋□□□□风麝，空使微材恨海棠。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40266,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺杨司户庭玉","author":"许月卿","text":"阳关酒尽不成声，杨柳烟中一棹轻。\n日暮碧云烟水阔，梅花难寄此时情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40267,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺滕推入郡奉祀","author":"许月卿","text":"溪斋之后未多年，有子亲曾闻性天。\n助祭此行春满眼，沙明草暖白鸥眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40268,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送高安辛圣祥谒后林","author":"许月卿","text":"论相何如只论心，无心无相更难寻。\n清风独卧羲皇上，床下明朝拜后林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40269,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"首夏","author":"许月卿","text":"首夏清和如惠夷，心情熙洽似唐虞。\n竹梢巧送月到牖，荷叶乱迎风入湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40270,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"旅獒图","author":"许月卿","text":"戒獒式燕紫阳诗，展画如观作训时。\n我道非唐无此笔，宋人那解析豪厘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40271,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"朗湖道中因见二事信笔二首 其一","author":"许月卿","text":"屋下种花檐露满，窗前叠石岫云生。\n春风不解分疆界，本自无心却有情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40272,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄张立道","author":"许月卿","text":"故人华职又为州，当日商量今不谋。\n捷径终南共惭愧，今人莫遣后人羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40273,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"望中","author":"许月卿","text":"望中惟有山平远，山外更连天泬寥。\n好着个亭管烟水，夜凉明月举杯邀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40274,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]