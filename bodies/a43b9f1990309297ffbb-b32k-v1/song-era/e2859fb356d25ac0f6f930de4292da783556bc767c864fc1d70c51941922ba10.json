[{"title":"感皇恩 和才仲西山子","author":"王以宁","text":"千古洞庭湖，百川争注。\n雪浪银涛正如许。\n骑鲸诗客，浩气决云飞雾。\n背人歌欸乃，凌空去。\n我欲从公，翩然鹄举。\n未愿人间相君雨。\n笭箵短棹，是我平生真语。\n个中烟景好，烦公句。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11495,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"满庭芳 其二 邓州席上","author":"王以宁","text":"千古南阳，刘郎乡国，依约楚俗秦风。\n英姿豪气，耆旧笑谈中。\n珰佩来从帝所，许洲花、潭菊从容。\n霜秋晓，凉生日观，极目送飞鸿。\n主公。\n天下士，挥毫万字，一饮千钟。\n醉高歌起舞，唤醒人龙。\n我自人间漫浪，平生事、南北西东。\n辞公去，寒眸激电，曾识小安丰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11496,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"满庭芳 其四 重午登霞楼","author":"王以宁","text":"千古黄州，雪堂奇胜，名与赤壁齐高。\n竹楼千字，笔势压江涛。\n笑问江头皓月，应曾照、今古英豪。\n菖蒲酒，窊尊无恙，聊共访临皋。\n陶陶。\n谁晤对，粲花吐论，宫锦纫袍。\n借银涛雪浪，一洗尘劳。\n好在江山如画，人易老、双鬓难薅。\n升平代，凭高望远，当赋反离骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11497,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"满庭芳 其一","author":"王以宁","text":"山耸方壶，潮通碧海，江东自昔名家。\n玉真仙子，珰佩粲朝霞。\n一种天香胜味，笑杨梅、不数枇杷。\n难模写，牟尼妙质，光透紫丹砂。\n咨嗟。\n如此辈，不知何为，留滞天涯。\n料甘心远引，无意纷华。\n一任姚黄魏紫，供吟赏、银烛笼纱。\n南游士，日餐千颗，不愿九霞车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11498,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"满庭芳 其三 陈觉叟雪中见过","author":"王以宁","text":"五十七年，侵寻老矣，小庵初筑林坰。\n故人相过，喜雪舞祥霙。\n遍野跳珠溅玉，纵儿童、收满金瓶。\n明年待，洗光银海，袖手看升平。\n先生。\n齐物久，蚁丘罢战，蜗角休征。\n趁尊前身健，有酒须倾。\n随分村歌社舞，何须问、武宿文星。\n忘怀矣，未能忘酒，相与醉忘形。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11499,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蓦山溪 其二 游南山","author":"王以宁","text":"雕弓绣帽。\n戏马秦淮道。\n风入马蹄轻，曾踏遍、淮堤芳草。\n飞英点点，春事已阑珊，风雨横，别离多，断送英雄老。\n功名终在，休惜芳尊倒。\n谈笑下燕云，看千里、风驱电扫。\n男儿此事，莫待鬓丝棼，汉都护，万年觞，玉殿春风早。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11500,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蓦山溪 其一 如虞彦恭寄钱逊叔","author":"王以宁","text":"平山堂上，侧盏歌南浦。\n醉望五州山，渺千里、银涛东注。\n钱郎英远，满腹贮精神，窥素壁，墨栖鸦，历历题诗处。\n风裘雪帽，踏遍荆湘路。\n回首古扬州，沁天外、残霞一缕。\n德星光次，何日照长沙，渔夫曲，竹枝词，万古歌来暮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11501,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"虞美人 宿龟山夜登秋汉亭","author":"王以宁","text":"归来峰下霜如水。\n明月三千里。\n幽人独立瞰长淮。\n谁棹扁舟一叶、趁潮来。\n洞庭湖上银涛观。\n忆我烟蓑伴。\n此身天地一浮萍。\n去国十年华发、欲星星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11502,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"踏莎行 其二","author":"王以宁","text":"我自山中，渔樵冷族。\n一丘一壑平生熟。\n朅来江海寄馀生，心兵语阱频奔北。\n九里灵河，十分光烛。\n分辉借润须邻曲。\n柳家兄弟莫瞋人，狂奴小户元低促。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11503,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"踏莎行 其三","author":"王以宁","text":"位正三槐，光生九族。\n人间一梦黄粱熟。\n迩来荆楚地行仙，卜居深在延原北。\n笑问从前，谁调玉烛。\n当筵鲍老那能曲。\n山中饮酒是生涯，欲归未果成烦促。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11504,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"踏莎行 其一","author":"王以宁","text":"梦褥光宗，河东右族。\n向来到耳声华熟。\n游从两世记金兰，风流二阮居南北。\n今夕何辰，相亲灯烛。\n一廛我愿依韦曲。\n长君未可赋骊驹，山人莫为蒲轮促。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11505,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天 其三 寿张徽猷","author":"王以宁","text":"桃李纷纷春事催。\n桐花风定牡丹开。\n天麟下作人间瑞，玉燕清宵入梦来。\n红玉酎，紫霞杯。\n五云深处望三台。\n君家况有庭前柏，好个擎天八柱材。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11506,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天 刘运判生日","author":"王以宁","text":"瑞雪当空舞素英。\n玳筵收得满金瓶。\n洗教双眼明如镜，看取黄河几度清。\n龟畀寿，鹤为形。\n年年长愿见仪刑。\n他年林下逢彭祖，唤作谁家小后生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11507,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天 其二 寿杜士美","author":"王以宁","text":"帝乙何年骑玉龙。\n武夷仙伯笑相从。\n长庚瑞应游仙梦，碧藕花开解愠风。\n歌既醉，乐元丰。\n明良相悦寿无穷。\n野人更有深深祝，笑指三台十八公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11508,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天 其一 寿刘方明","author":"王以宁","text":"昔有书生荐寿杯。\n清词妙绝贺方回。\n黄花也欲为君寿，先向重阳六日开。\n跻楚俗，上春台。\n政成归去位三台。\n明年寿酒君王劝，知有传宣敕使来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11509,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"王以宁","text":"人情十里白头浪，世事几番黄叶风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11510,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"王以宁","text":"浩歌排两脚，蒙里横天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11511,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"王以咏","text":"剑水落霞晴熨绿，衍峰新月夜梳鬟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11512,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题大茅峰","author":"王元复","text":"五云金紫涌仙宫，十八湾尖第一峰。\n木石阴阴风飒飒，方池掬看小神龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11513,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花 其一","author":"王公炜","text":"枯霜剪尽千林叶，才放江头第一春。\n瘦影看来天爱画，孤根生处地无尘。\n夜郎岁晚逢羁客，谷口寒云见似人。\n绝是精神吟不尽，好枝和月插纱巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11514,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"王公亮","text":"足谷医还验，占桑梦已灵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11515,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送僧归护国寺 其二","author":"王化基","text":"岿然傍势浙江东，不羡金庭第一峰。\n法境常清五十里，妙莲今现几千重。\n清凉解洗枝头露，变现能飞钵底龙。\n平日旧游今复到，苍崖邃谷抱长松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11516,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送僧归护国寺 其一","author":"王化基","text":"振锡诣华京，频频答龙灵。\n玉阶前见佛，金口内开经。\n论道穷纲赜，深玄极杳冥。\n褒崇恩烂熳，教化语丁宁。\n传作心中印，镌为坐右铭。\n云飞来北阙，鹤梦去东冥。\n鼓棹辞梁苑，扬帆过洞庭。\n到山开御札，鸾凤满岩扃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11517,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"王化基","text":"美璞未成终是宝，精钢宁折不为钩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11518,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"王化基","text":"文章换桂一枝秀，清白传家两弟贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11519,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游王官谷","author":"王午","text":"耐辱幽人不愿名，一丘一壑遂高情。\n门前流水无冬夏，想见先生到骨清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11520,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"王太冲","text":"惟有杨花思空阔，正零落处是开时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11521,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"石门洞","author":"王开平","text":"层崖立水湄，绝壁万丝垂。\n长是烟云护，不分晴雨时。\n岚多琳宇湿，苔滑石桥危。\n得句停舟写，春衫润不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11522,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和答刘习之见赠","author":"王文孙","text":"先天奥学果何传，造化机缄存阖辟。\n精微惝恍入神范，天地谓可俄而测。\n粤从二画抉秘蕴，乾元庶物因首出。\n阳推阴荡六子成，致用坎离为月日。\n天人相与妙难诘，斯道岂容秦火息。\n九家分派流愈远，纬谶纷纷非所及。\n韦编三绝系圣经，微言尚切明作述。\n我生苦晚心好古，谩索图书考龟策。\n浩如烟海无津涯，自哂蓬心窥至赜。\n众言淆乱折以理，是非安敢决诸臆。\n吉凶前定信可推，人事堪怜空役役。\n优游姑乐环中趣，默参经世用皇极。\n较量得失心自知，议论无用形于笔。\n观君气宇元静定，何虑不优入圣阈。\n不鄙谓予可相友，愿凿浑沌以报德。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11523,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"以二十八字为吾婿他日嘱仲和书付梅隐袁庭植","author":"王文卿","text":"吾法元来不妄传，信知道法妙玄玄。\n君家自是神仙种，管取儿孙代代贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11524,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥峰","author":"王文卿","text":"耸汉仙峰一柱清，晴春登览四山明。\n祥云昼护神光现，瑞月宵临法乐鸣。\n华子冈头灵运赋，七星杉下蔡经盟。\n慨思今古无穷事，那得逍遥自在情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11525,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"麻姑坛","author":"王文卿","text":"漉酒巾笼五岳冠，懒携琴鹤上朝端。\n丹房昼睡烟霞暖，紫府夜归星斗寒。\n诗就几教山鬼泣，剑灵那许俗人看。\n麻姑报道桑田变，一曲仙棋尚未残。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11526,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题棺木","author":"王文卿","text":"我身是假，松板非真。\n牢笼俗眼，跳出红尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11527,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"王文卿","text":"报国有谁能仗节，升天由此可无梯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11528,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"王文卿","text":"红尘富贵无心恋，紫府真仙有志攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11529,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"云安监劝学诗","author":"王日翚","text":"云安古汤溪，□□□□滨。\n无室不盐烟，无民不樵薪。\n士子独希少，锥刀事艰辛。\n我因沿檄来，暇日聊咨询。\n溪山秀且清，湛碧高嶙峋。\n衣冠杳不报，敢问夫何因。\n盛言汉廷尉，有语诒乡邻。\n三牛对马岭，有井无贵人。\n斯言既笃信，诗礼不复闻。\n我闻为咨嗟，此语深非仁。\n儒风一旦扫，有甚遭烧焚。\n因言廷尉者，其生岂不神。\n既禀神灵姿，宁非贤圣伦。\n安得鄙俚语，千载愚斯民。\n斯民有幸氏，贵岂无足尊。\n唐皇上柱国，伪蜀掌丝纶。\n遗诰尚可考，苗裔亦诜诜。\n后生宜可畏，况逢尧舜辰。\n如何三百年，自弃甘煨尘。\n前贤不知慕，俚语常书绅。\n不知非格言，野老相因循。\n为言听我语，蜀氏初顽嚚。\n文翁为益州，化蜀与维新。\n英才出王马，继世扬子云。\n词章霭当世，至今耀清芬。\n自尔吾蜀士，文学多彬彬。\n乃知汤溪上，未必无国珍。\n琢磨始成器，匪即为荆榛。\n我虽非文翁，志使风俗淳。\n亦非好辩者，示劝聊谆谆。\n公侯宁有种，自致唯斯文。\n蜀学乃孤陋，师友须隆亲。\n又当听我言，既学须能勤。\n不勤如不学，勤学始成身。\n穷兮世巨儒，达兮国名臣。\n唯恐学不至，学必无沈沦。\n如不学为名，不如复煎熏。\n十室有忠信，见者希能遵。\n会观集岁后，俊造来訚訚。\n一成诗礼乡，举充观国宾。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11530,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"齐天乐","author":"王月山","text":"夜来疏雨鸣金井，一叶舞空红浅。\n莲渚收香，兰皋浮爽，凉思顿欺班扇。\n秋光苒苒。\n任老却芦花，西风不管。\n清兴难磨，几回有句到诗卷。\n长安故人别后，料征鸿声里，画阑凭遍。\n横竹吹商，疏砧点月，好梦又随云远。\n闲愁似线。\n甚系损柔肠，不堪裁剪。\n听著鸣蛩，一声声是怨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11531,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"荷花","author":"王月浦","text":"雨馀无事倚阑干，媚水荷花粉未乾。\n十万琼珠天不惜，绿盘擎出与人看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11532,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"琼花","author":"王月浦","text":"蕃釐观里琼花树，天地中间第一花。\n此种从何探原委，春风无处著繁华。\n千须簇蝶围清馥，九萼联珠异众葩。\n几见朱衣和露剪，金瓶先进帝王家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11533,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"城南","author":"王月窗","text":"早出城南路，江山总着题。\n林高楼似缩，岸远树疑低。\n鸲鹆噪乔木，桔槔鸣小畦。\n邮亭聊一憩，沽酒夕阳西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11534,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"普向山门","author":"王月窗","text":"来访山中景，亭阑鼠甘阴。\n客投孤寺宿，蝉趁夕阳晴。\n满树青苔湿，一村黄叶深。\n纳凉归去晚，湖月挂遥林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11535,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戏咏白罗系髻","author":"王氏","text":"香罗如雪缕新裁，惹在乌云不放回。\n还似远山秋水际，夜来吹散一枝梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11536,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄父","author":"王氏","text":"西风不入小窗纱，秋气应怜我忆家。\n极目江南千里恨，依然和泪看黄花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11537,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题清风岭崖石","author":"王氏","text":"君王不幸妾当灾，弃女抛男逐马来。\n夫面不知何日见，妾身还是几时回。\n两行怨泪频偷滴，一对愁眉怎得开。\n遥望家乡何处是，存忘两字苦哀哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11538,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 西湖曲","author":"王氏","text":"横湖十顷琉璃碧。\n画桥百步通南北。\n沙暖睡鸳鸯。\n春风花草香。\n闲来撑小艇。\n划破楼台影。\n四面望青山。\n浑如蓬莱间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11539,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吴下同年会诗","author":"王艺","text":"琼林春暖记分违，叙好如公在昔稀。\n鱼腹一书劳远寄，鹊枝三匝幸相依。\n初筵虽负兵厨约，馀爱终分赵日晖。\n从此吴门书盛事，即看丹诏凤衔飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11540,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"临终作","author":"王世宁","text":"翠羽旌幢仙子队，紫云楼阁玉皇家。\n人间风雨易分散，回首五陵空落花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11541,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"象州上元","author":"王安中","text":"二年白玉堂，挥翰供帖子。\n风生起草台，墨照澄心纸。\n三年文昌省，拜赐近天咫。\n红蓼朌御盘，金幡袅宫蕊。\n晚为日南客，环堵隐乌几。\n朝来闻击鼓，土牛出城市。\n幽怀不自闲，欲逐春事起。\n安得五亩园，种蔬引江水。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11542,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"真妃小娘子庙","author":"王仙客","text":"当日孤贞不可穷，邦人千载仰其功。\n而今汉上多游女，谁继巍巍烈女风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11543,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"口占示姊","author":"王令","text":"盎竭囊空且笑歌，更从吾命听如何。\n不须直有牛羊乐，只以无求富自多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11544,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"少年答春愁","author":"王令","text":"花枝袅袅笑当觞，且作春风几日狂。\n纵使春归犹有酒，酒酣春去亦何伤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11545,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"月蚀","author":"王令","text":"卢仝不作昌黎死，天目虽盲未见嗟。\n坐叹清光无惜处，一将吞吐听虾蟆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11546,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"木瓜花","author":"王令","text":"簇簇红葩间绿荄，阳和闲暇不须催。\n天教尔艳呈奇绝，不与夭桃次第开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11547,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"对花","author":"王令","text":"忧愁卒卒人无乐，花草纷纷物又春。\n安得无忧与无虑，对花还作笑歌人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11548,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"白鸡冠花","author":"王令","text":"如飞如舞对瑶台，一顶春云若剪裁。\n谁为移根蓂荚畔，玉鸡应为太平来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11549,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"龙池二绝 其一","author":"王令","text":"满目尘埃白日阴，皇天无命且深沉。\n终当力卷沧溟水，来作人间十日霖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11550,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"龙池二绝 其二","author":"王令","text":"尽道神龙此有灵，一池澄静暮痕清。\n如何蟠屈无飞志，却放鸣蛙有怒声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11551,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟中作","author":"王令","text":"杳杳波涛去莫穷，要须流合海天东。\n长帆百尺嗟无用，醉绝重湖笑逆风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11552,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观饮","author":"王令","text":"不饮虽然合众难，何妨众客自盘桓。\n已看手足互颠倒，更听人人自谓欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11553,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"别陈药院","author":"王令","text":"客居平日有谁亲，一别三年百病身。\n为道难言轻感慨，羡君无病更医人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11554,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诋燕","author":"王令","text":"金屋人娇奈燕何，暮帘好捲放来过。\n今年已见燕无数，何况明年燕更多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11555,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"叔孙通","author":"王令","text":"弟子从来学未纯，异时得失亦频频。\n一官所买知多少，便议先生作圣人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11556,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和束蒙初九日不见菊登高","author":"王令","text":"从来秋菊不曾栽，敢向西风怨不开。\n我自伤秋有高兴，非关特为菊花来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11557,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜月","author":"王令","text":"可嗟落日志悠然，便有群星出见天。\n夜月自明人自爱，不妨人亦闭门眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11558,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜归","author":"王令","text":"冲冲行路自多岐，已踏归途尚虑非。\n夜犬只知人是盗，不知人亦夜来归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11559,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜深吟","author":"王令","text":"叩几悲歌涕满襟，圣贤千古我如今。\n冻琴弦断灯青晕，谁会男儿半夜心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11560,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]