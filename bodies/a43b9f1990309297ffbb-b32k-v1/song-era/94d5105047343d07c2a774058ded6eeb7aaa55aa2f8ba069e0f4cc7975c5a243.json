[{"title":"送郡守张宗丞 其三","author":"萧元之","text":"本是诗书种，躬耕寂寞滨。\n倾家市鞍马，捐命犯风尘。\n幕府差功级，京华困旅贫。\n不如归去好，依旧号诗人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70197,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送郡守张宗丞 其二","author":"萧元之","text":"泪落乡邦事，民痍久未瘳。\n官收随亩券，人上运粮舟。\n寇起征方急，年饥籴未休。\n更闻来取楮，何以应需求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70198,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送郡守张宗丞 其一","author":"萧元之","text":"淮汉秋风起，边声不可听。\n九重选良牧，内地著郎星。\n土沃桑麻长，城荒草树青。\n民居多近水，一一是江亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70199,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻德音入蜀","author":"萧元之","text":"蜀山万里外，圣主得遥闻。\n归使愁无路，遗黎泣见君。\n千年文物郡，百战虎狼群。\n才退惭司马，无因写檄文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70200,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清明省扫归舟陆相半","author":"萧元之","text":"一径险仍修，沿溪去未休。\n薜萝春暗树，杨柳暮遮楼。\n荡桨渔舟驶，寒钟僧寺幽。\n倚篷赊浊酒，犹可洗诗愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70201,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"塞马歌答杨侍郎","author":"萧元之","text":"侍郎赠我六尺騟，矫矫龙性天骨殊。\n四蹄铁立目电闪，此其壮志畏长驱。\n牵来细观问厮养，何物有此权奇状。\n为言此是古孙龙，往往得之沙塞上。\n森张雾鬣碨礌鬉，萧稍骏尾摇朔风。\n冰河蹙裂蹄甲锐，竹批两耳双方瞳。\n向时淮西屡战胜，曾驮猛士敲金镫。\n帐前欲得不敢言，空悬宝珠光照乘。\n我有百发落雁鈚，前年引满射赤眉。\n功成万死不见赏，归骑驴子吟楚词。\n浮沈不作飞腾梦，感公赠我意勤重。\n旋蒙皋比作鞍鞯，更染青丝结缰鞚。\n祗今中原狐兔鸣，黄沙莽莽白骨腥。\n愿公急起扫欃枪，百万勋业一旦成。\n我当乘此载前旌，男儿报义要轻生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70202,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水龙吟 答沈壮可","author":"萧元之","text":"人生何必求名，身闲便是名高处。\n卧云衣袂，何因自染，修涂尘土。\n世路羊肠，人情狙赋，翻云覆雨。\n把从前旧梦，倚阑重省，休更错、添笺注。\n况是吾庐江上，也抵得、封侯千户。\n高眠闲听，邻舟渔唱，倚阑农语。\n休望当年，溪边俱载，隆中三顾。\n怕群鸥微觉，见人欲起，背人飞去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70203,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮","author":"萧元之","text":"断红流水香难觅。\n行云一去无踪迹。\n杨柳漫遮阑。\n闲愁付远山。\n玉筝弹未了。\n倚柱人空老。\n青子摘来酸。\n酸心有几般。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70204,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渡江云 和清真","author":"萧元之","text":"流苏垂翠幰，高低一色，红紫等泥沙。\n香山居士老，柳枝桃叶，飞梗属谁家。\n好音过耳，任啼鸟、怨入芳华。\n心情懒，笔床吟卷，醉墨戏翻鸦。\n堪嗟。\n雕弓快马，敕勒追踪，向夕阳坡下。\n休更忆，青丝络辔，红袖裁纱。\n司空见惯浑如梦。\n笑几回、索苇吹葭。\n山中乐，从渠恣赏莺花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70205,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和祖无择袁州东湖卢肇石","author":"萧元宗","text":"石是人非世所传，宜阳城郭古山川。\n和光瓦砾曾无累，委质泥沙积有年。\n地僻久为神物护，时来方遇使君贤。\n介然作镇东湖上，德政何当向此镌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70206,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"萧曰复","text":"民得食天全命脉，令从心地起根芽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70207,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"齐天乐","author":"萧东父","text":"扇鸾收影惊秋晚，梧桐又供疏雨。\n翠箔凉多，绣囊香减，陡觉簟冰如许。\n温存谁与。\n更禁得荒苔，露蛩相诉。\n恨结愁萦，风刀难剪几千缕。\n闲思前事易远，怅旧欢无据，月堕湘浦。\n软玉分裯，腻云侵枕，犹忆喷兰低语。\n如今最苦。\n甚怕见灯昏，梦游间阻。\n怨杀娇痴，绿窗还嚏否。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70208,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山行宿道院","author":"萧兰皋","text":"终朝穿翠微，投暮叩松扉。\n童子出相语，道人犹未归。\n寻香温纸被，拂石弄金徽。\n明发下山去，白云随马飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70209,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"卖花声 春雨","author":"萧汉杰","text":"湿逗晚香残。\n春浅春寒，洒窗填户著幽兰。\n惨惨凄凄仍滴滴，做出多般。\n和霰撒珠盘。\n枕上更阑。\n芭蕉怨曲带愁弹。\n绿遍阶前苔一片，晓起谁看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70210,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浪淘沙令 中秋雨","author":"萧汉杰","text":"愁似晚天云。\n醉亦无凭。\n秋光此夕属何人。\n贫得今年无月看，留滞江城。\n夜起候檐声。\n似雨还晴。\n旧家谁信此时情。\n惟有桂香时入梦，勾引诗成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70211,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 春雨","author":"萧汉杰","text":"春愁一段来无影。\n著人似醉昏难醒。\n烟雨湿阑干。\n杏花惊蛰寒。\n唾壶敲欲破。\n绝叫凭谁和。\n今夜欠添衣。\n那人知不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70212,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝶恋花 春燕和韵","author":"萧汉杰","text":"一缕春情风里絮。\n海阔天高，那更云无数。\n娇颤画梁非为雨。\n怜伊只合和伊去。\n欲话因缘愁日暮。\n细认帘旌，几度来还去。\n万一这回航可渡。\n共渠活处寻条路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70213,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偶成","author":"萧立之","text":"雨妒游人故作难，禁持闲了下湖船。\n城中岂识农耕好，却恨悭晴放纸鸢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70214,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"第四桥二首 其二","author":"萧立之","text":"自折孤樽擘蟹斟，荻花洲渚月平林。\n一江秋色无人管，柔橹风前语夜深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70215,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"第四桥二首 其一","author":"萧立之","text":"黄帽牵船客自摇，水花压岸送归潮。\n晚风忽断疏蓬雨，秋在烟波第四桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70216,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"茶陵道中","author":"萧立之","text":"山深迷落日，一径窅无涯。\n老屋茅生菌，饥年竹有花。\n西来无道路，南去亦尘沙。\n独立苍茫外，吾生何处家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70217,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春寒家","author":"萧立之","text":"一月春寒缩牛马，束桂薪刍不当价。\n去年霜早谷蕃熟，雨烂秧青无日晒。\n深山处处人夷齐，锄荒饭蕨填朝饥。\n干戈满地此乐土，不谓乃有凶荒时。\n今年有田谁力种，恃牛为命牛亦冻。\n君不见邻翁八十不得死，昨夜哭牛如哭子。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70218,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送人之常德","author":"萧立之","text":"秋风原头桐叶飞，幽篁翠冷山鬼啼。\n海图拆补儿女衣，轻衫笑指秦人溪。\n秦人得知晋已前，降唐臣宋谁为言。\n忽逢桃花照溪源，请君停篙莫回船。\n编蓬便结溪上宅，采桃为薪食桃实。\n山林黄尘三百尺，不用归来说消息。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70219,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送县宰赴召","author":"萧仲才","text":"出宰男邦过冉求，潦江木落四番秋。\n主恩父母朝天去，失哺婴孩伏地留。\n一片丹心深国虑，数茎白发为民愁。\n邑人共绘生祠像，不戴貂蝉官未休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70220,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"沁园春 寿春陵史君叔","author":"萧仲芮","text":"五马南来。\n一骑东驰，诏黄已催。\n正寻幽择胜，闲边点检，吟风弄月，忙处徘徊。\n玉井莲房，碧筒酒熟，趁得长年千岁杯。\n杯浮处，正芒寒南极，色映三台。\n明光殿北屏门，记御笔亲题名姓来。\n看河东召入，韩侯归觐，通班玉笋。\n稳上鸾台。\n作汉元功，继唐八叶，绿鬓依然昼绣回。\n安排了，待秋风先看，双桂联魁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70221,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"沁园春 庆宁乡令","author":"萧仲炳","text":"笑问鸥盟，所不同心，有如大江。\n念渊明漫仕，虽轻斗粟，弦歌有得，难慕柴桑。\n相业流芳，元枢新躅，拈作先生一瓣香。\n长生酒，仗西风桂子，吹到河阳。\n湘江。\n笑绾铜章。\n便好筑绵州六一堂。\n看千年辽鹤，重归故里，一般明月，又上潇湘。\n橐紫翻荷，官黄书诏，不待阴成蔽芾棠。\n中书考，更侯封酂国，汤沐宁乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70222,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"应景乐","author":"萧回","text":"金陵故国。\n极目长江浩渺，千重隔。\n山无际，临湍怒涛碛。\n俯春城苇寂。\n芳昼迤逦，一簇烟村将晚，严光旧台侧。\n何处倦游客。\n对此景惹起离怀，顿觉旧日意，魂黯愁积。\n幽恨绵绵，何计消溺。\n回首洛城东，千里暮云碧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70223,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西江月 其九","author":"萧廷之","text":"调燮火工非小，差殊只在毫厘。\n鼎炉汞走黑铅飞。\n从此恐君丧志。\n须共真师细论，无令妄动轻为。\n幽微玄妙最深机。\n言语仍须避忌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70224,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西江月 其三","author":"萧廷之","text":"要识真铅真汞，都来只一根源。\n烹煎火候妙中玄。\n不是知音难辨。\n采取莫差时日，仍分弦后弦前。\n玉炉一霎火烧天。\n无位真人出现。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70225,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西江月 其二","author":"萧廷之","text":"默运乾坤否泰，抽添妙在屯蒙。\n起于复卦剥于终。\n温养两般作用。\n沐浴要防危险，吹嘘全藉离风。\n工夫还返入坤宫。\n火足不宜轻弄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70226,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西江月 其七","author":"萧廷之","text":"一二复临养火，兔鸡沐浴潜藏。\n分明变化在中央。\n结就玄珠片饷。\n还返归根托体，守城抱一堤防。\n黄庭来往是寻常。\n恍惚之中纵放。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70227,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西江月 其五","author":"萧廷之","text":"鼎器法天象地，坎离运用无差。\n夫妻相会入黄家。\n共说无生妙话。\n雨意云情了当，领头驾动河车。\n搬归顶上结三花。\n牢闭玉关金锁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70228,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西江月 其十二","author":"萧廷之","text":"金液还丹大道，古人万劫一传。\n倾心剖腹露诸篇。\n接引直超道岸。\n莫怪天机泄尽，此玄玄外无玄。\n留传后代与名贤。\n有目分明觑见。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70229,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西江月 其十一","author":"萧廷之","text":"药产西南坤地，金丹只此根宗。\n学人著意细推穷。\n妙绝无过真种。\n了一万般皆毕，休分南北西东。\n执文泥象岂能通。\n恰似哑人谈梦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70230,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西江月 其六","author":"萧廷之","text":"拨动顶门关捩，自然虎啸龙吟。\n九还七返义幽深。\n出入不离玄牝。\n运用玉炉火候，鼎中炼就真金。\n强兵战胜便收心。\n妙在无伤无损。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70231,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西江月 十二首 其一","author":"萧廷之","text":"两手劈开混沌，坦然直露丹宗。\n日魂月魄自西东。\n牢捉莫轻放纵。\n外道邪魔缩项，相将结宝中宫。\n九还七返片时功。\n皆赖黄婆相送。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70232,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西江月 其四","author":"萧廷之","text":"莫问九三二八，无过阴偶阳奇。\n大都离坎结夫妻。\n要识屯蒙既未。\n若遇一阳起复，便堪进火无迟。\n只因差失在毫厘。\n野战更宜仔细。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70233,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西江月 其八","author":"萧廷之","text":"夹脊双关透顶，此为大道玄门。\n金丹只是此宗根。\n大要知时搬运。\n温养守城野战，华池玉液频吞。\n玉炉常使火温温。\n采药审他老嫩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70234,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西江月 其一","author":"萧廷之","text":"九曲江头逆浪，霎时冲过天心。\n昆崙顶上水澄澄。\n酝就琼浆自饮。\n便向此时采取，河车搬运无停。\n阴阳一气自浮沈。\n锁闭玉关牢稳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70235,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南乡子 其三","author":"萧廷之","text":"温养象周天。\n须要微微火力全。\n爱护婴儿惟藉母，三年。\n运用抽添象缺圆。\n牛斗会河边。\n拾取玄珠种玉田。\n定意如如行火候，精专。\n剖腹分明说与贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70236,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南乡子 其二","author":"萧廷之","text":"两手擘鸿濛。\n慧剑飞来第一峰。\n外道修罗惊缩项，神通。\n造化元来在掌中。\n锻炼玉炉红。\n橐龠吹嘘藉巽风。\n十月托胎吞入腹，坤宫。\n立见三清太上翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70237,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南乡子 其十二","author":"萧廷之","text":"尽净露天机。\n只恐时人自执迷。\n颔下藏珠当猛取，休迟。\n道在身中更问谁。\n尘网忽抛离。\n百岁年华七十稀。\n莫待老来铅汞少，堪悲。\n业报前途难自欺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70238,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南乡子 十二首西南乃产药之地，因此故为名 其一","author":"萧廷之","text":"真汞与真铅。\n产在先天与后天。\n大要知时勤采取，玄玄。\n得穴何愁不作仙。\n进火要精专。\n审究前弦与后弦。\n屯卦抽添蒙卦止，难传。\n毫发差殊不结丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70239,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南乡子 其六","author":"萧廷之","text":"鼎器法乾坤。\n上是天元下地元。\n若也更能颠倒运，交番。\n阖辟循环在八门。\n搬运上昆崙。\n龟与蛇儿自吐吞。\n百尺竿头牢把线，掀援。\n从此元神命永存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70240,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南乡子 其五","author":"萧廷之","text":"木兔与金鸡。\n刑德临门有偶奇。\n炉内丹砂宜沐浴，防危。\n神水溶溶满玉池。\n年月日并时。\n刻里工夫一例推。\n著意研穷丹造次，毫厘。\n十月殷勤自保持。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70241,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南乡子 其七","author":"萧廷之","text":"关锁自周天。\n升降循环三寸田。\n不在嘘呵并数息，天然。\n九转无亏火力全。\n胎息漫流传。\n要在阴阳不可偏。\n呼吸吹嘘皆赖巽，绵绵。\n妙在前弦与后弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70242,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南乡子 其一","author":"萧廷之","text":"长子到西方。\n少女归乾变六阳。\n便好下功修二八，堤防。\n至九方知道自昌。\n牛斗共商量。\n巧夺天工妙莫量。\n离坎夫妻交媾后，难忘。\n始觉壶中日月长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70243,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南乡子 其十一","author":"萧廷之","text":"白雪与黄芽。\n两味精华共一家。\n采择辨时衰与旺，堪夸。\n火候毫厘不可差。\n顶上结三花。\n驾动羊车与鹿车。\n乌兔往来南北面，交加。\n从此天河稳泛槎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70244,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南乡子 其八","author":"萧廷之","text":"复卦起潜龙。\n戊己微调未可攻。\n九二见龙临卦主，神通。\n从此炉中次第红。\n泰卦恰相逢。\n猛火烧乾藉巽风。\n炼就黄芽并白雪，奇功。\n还返归坤道始穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70245,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南乡子 其九","author":"萧廷之","text":"识得水中金。\n煅炼烹煎理更深。\n进退抽添须九转，浮沈。\n温养潜龙复与临。\n妙运自天心。\n托仗黄婆配丙壬。\n酝就醍醐山顶降，频斟。\n慢拨无弦一曲琴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70246,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题汪水云诗卷","author":"萧克翁","text":"旧时綵笺结绮，晚岁铜仙渭城。\n三十年来家国，吾琴无亏无成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70247,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题汪水云诗卷","author":"萧灼","text":"朔风卷雨东南昏，铜仙泪洒辞吴门。\n间关万里踏燕月，埃沙扑面愁人魂。\n携琴早晚随王母，不似瑶池旧歌舞。\n南冠岌岌操南音，此意此心千万古。\n十年归来两鬓霜，袖有诗史继草堂。\n西游苍梧北太华，笔端传入古锦囊。\n甫也再拜杜鹃血，颍乎冥入冰炭肠。\n一朝访我茅屋下，朔风易水为余写。\n黄金好铸钟子期，知君不是黄冠师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70248,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"萧固","text":"风变尉佗国，声欢舜帝民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70249,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"萧国梁","text":"名传玉陛星辰晓，泽霈金枝雨露春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70250,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题五龙庙","author":"萧注","text":"五龙兄弟古英名，今日拿舟过悦城。\n莫向草茅久盘屈，早施霖雨活苍生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70251,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春归二绝和高希远韵 其二","author":"萧炎","text":"厨供樱笋上春盘，把酒留春少住难。\n祇是檐花前夜雨，明朝便作酿梅看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70252,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春归二绝和高希远韵 其一","author":"萧炎","text":"晴窗如暝树云遮，红紫成埃减陌车。\n不信春归无绾系，尚存一架木香花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70253,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题汪水云诗卷","author":"萧炎丑","text":"听说西湖事，分明在目前。\n逋梅笼水月，坡柳弄风烟。\n春梦须臾里，旧游三十年。\n把君丙子集，读罢泪潸然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70254,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"齐山","author":"萧贯","text":"秋风秋浦断飞埃，路入齐山有梵台。\n黄菊绽时君始至，紫微去后我重来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70255,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清溪","author":"萧贯","text":"山开明月峡，水写武陵溪。\n地胜人堪隐，源深客自迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70256,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"萧贯","text":"十二峣关隐空绿，兽猊呼焰椒壁馥。\n渴乌涓涓不相续，辘轳欲转霏红玉。\n百刻香残陨莲烛，九龙吐水漫寒浆。\n红绡佩鱼无左珰，两两趋走瞻扶桑。\n红萍半圭山波面，回首觚棱九霞绚。\n鸣鞘声从天上来，大剑高冠满前殿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70257,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"萧庭直","text":"山势低连巫峡远，水流初放蜀江平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70258,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梁家渡","author":"萧彦毓","text":"远水环沙翠作湾，红尘飞不入青山。\n凉风一枕秋宵梦，梦绕千岩万壑间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70259,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清明日早出太平门","author":"萧彦毓","text":"江头杨柳暗藏鸦，江上鹅儿浴浅沙。\n早起一风如此恶，路旁落尽刺桐花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70260,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]