[{"title":"谢晓纯送衲袜","author":"黄庭坚","text":"刬草曾升马祖堂，暖窗接膝话还乡。\n赠行百衲兜罗袜，处处相随入道场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71949,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢益修四弟送石屏","author":"黄庭坚","text":"石似江沧落日明，鸬鹚乌鹊满沙汀。\n小儿骨相能文字，乞与班班作砚屏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71950,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢答闻善二兄九绝句 其三","author":"黄庭坚","text":"群猪过饮尚可醉，疥手轑瓮庸何伤。\n柳家兄弟太迫窄，狂药不容人发狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71951,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢答闻善二兄九绝句 其六","author":"黄庭坚","text":"公择醉面桃花红，人百忤之无愠容。\n莘老夜阑倾数斗，焚香默坐日生东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71952,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢答闻善二兄九绝句 其一","author":"黄庭坚","text":"身入醉乡无畔岸，心与欢伯为友朋。\n更阑骂坐客星散，午过未苏发鬅鬙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71953,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢答闻善二兄九绝句 其五","author":"黄庭坚","text":"阮籍醉睡不论昏，刘伶鸡肋避尊拳。\n至今凛凛有生气，饮酒真成不愧天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71954,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢答闻善二兄九绝句 其七","author":"黄庭坚","text":"椎床破面枨触人，作无义语怒四邻。\n尊中欢伯笑尔辈，我本和气如三春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71955,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢答闻善二兄九绝句 其二","author":"黄庭坚","text":"未尝顷刻可去酒，无有一日不吟诗。\n诗狂克念作酒圣，意态忽如少年时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71956,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢答闻善二兄九绝句 其九","author":"黄庭坚","text":"阮籍刘伶智如海，人间有道作糟丘。\n酒中无诤真三昧，便觉嵇康输一筹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71957,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢答闻善二兄九绝句 其四","author":"黄庭坚","text":"莫作叫号惊四邻，瓮中有地可藏真。\n渊明醉握远公手，大笑绝倒人不嗔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71958,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢答闻善二兄九绝句 其八","author":"黄庭坚","text":"陶令舍中有名酒，无日不为父老倾。\n四座欢欣观酒德，一灯明暗又诗成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71959,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢檀敦信送柑子","author":"黄庭坚","text":"色深林表风霜下，香著尊前指爪间。\n书后合题三百颗，频随驿使未应悭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71960,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"催公静碾茶","author":"黄庭坚","text":"雪里过门多恶客，春阴只恼有情人。\n睡魔正仰茶料理，急遣溪童碾玉尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71961,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"睡起","author":"黄庭坚","text":"彷佛江南一梦中，虚堂尽日转温风。\n春深稍觉裌衣重，昼永不知樽酒空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71962,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"睡起","author":"黄庭坚","text":"柿叶铺庭红颗秋，薰炉沈水度衣篝。\n松风梦与故人遇，同驾飞鸿跨九州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71963,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"睡起二首 其二","author":"黄庭坚","text":"古来志士愿不辱，少在朝廷多在山。\n寄食生涯无定止，此心长到白云间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71964,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"睡起二首 其一","author":"黄庭坚","text":"帘幕阴阴不见人，日斜窗影弄游尘。\n风和睡起鸟声乐，天地无私花柳春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71965,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谪居黔南十首 其二","author":"黄庭坚","text":"霜降水反壑，风落木归山。\n冉冉岁华晚，昆虫皆闭关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71966,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谪居黔南十首 其五","author":"黄庭坚","text":"冥怀齐远近，委顺随南北。\n归去诚可怜，天涯住亦得。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71967,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谪居黔南十首 其六","author":"黄庭坚","text":"老色日上面，欢悰日去心。\n今既不如昔，后当不如今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71968,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谪居黔南十首 其一","author":"黄庭坚","text":"相望六千里，天地隔江山。\n十书九不到，何用一开颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71969,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"暮到张氏园和壁间旧题","author":"黄庭坚","text":"邵平不见见园瓜，三径还寻二仲家。\n莫道暂来无所得，未秋先已碧莲华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71970,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"漫书呈几复三首 其三","author":"黄庭坚","text":"秋虫振羽惊寒梦，河汉西斜夜独兴。\n欲罢不能呼子起，新凉宜近读书灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71971,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"漫书呈几复三首 其二","author":"黄庭坚","text":"空名不系身轻重，此道当如命废兴。\n彷佛古人前日事，解衣扪虱对青灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71972,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"漫书呈几复三首 其一","author":"黄庭坚","text":"古人踽踽已先登，后学萧萧不再兴。\n顾我尪羸君勉强，百年漂忽甚风灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71973,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"漫兴","author":"黄庭坚","text":"肉食倾人如出凡，藜羹赋我是朝三。\n晓来不倦听衙鼓，云里捲帘山正南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71974,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蜡梅","author":"黄庭坚","text":"天工戏剪百花房，夺尽人工更有香。\n埋玉地中成故物，折枝镜里忆新妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71975,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"裴晋公书堂","author":"黄庭坚","text":"裴公入相便论兵，跃马淮西一战平。\n黄閤不须金印好，却来山下作书生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71976,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"酴醾","author":"黄庭坚","text":"汉宫娇额半涂黄，入骨浓薰贾女香。\n日色渐迟风力细，倚栏偷舞白霓裳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71977,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醇道得蛤蜊复索舜泉舜泉已酌尽官酝不堪不敢送","author":"黄庭坚","text":"青州从事难再得，墙底数樽犹未眠。\n商略督邮风味恶，不堪持到蛤蜊前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71978,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题子瞻寺壁小山枯木二首 其二","author":"黄庭坚","text":"海内文章非画师，能回笔力作枯枝。\n豫章从小有梁栋，也似郑公双鬓丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71979,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题子瞻寺壁小山枯木二首 其一","author":"黄庭坚","text":"烂肠五斗对狱吏，白发千丈濯沧浪。\n却来献纳云台表，小山桂枝不相忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71980,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题子瞻墨竹","author":"黄庭坚","text":"眼入毫端写竹真，枝掀叶举是精神。\n因知幻物出无象，问取人间老斲轮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71981,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题小景扇","author":"黄庭坚","text":"草色青青柳色黄，桃花零落杏花香。\n春风不解吹愁却，春日偏能惹恨长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71982,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题仁上座画松","author":"黄庭坚","text":"偃蹇松枝隔烟雨，知侬定是岁寒材。\n百年根节要老硬，将恐崩崖倒石来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71983,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题太和南塔寺壁","author":"黄庭坚","text":"熏炉茶鼎暂来同，寒日鸦啼柿叶风。\n万事尽还杯酒里，百年俱在大槐中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71984,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题文潞公黄河议后","author":"黄庭坚","text":"澶渊不作渡河梁，由是中原府库疮。\n白首丹心一元老，归来高枕梦河隍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71985,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题王居士所藏王友画桃杏花二首 其二","author":"黄庭坚","text":"凌云见桃万事无，我见杏花心亦如。\n从此华山图籍上，更添潘阆倒骑驴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71986,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题王居士所藏王友画桃杏花二首 其一","author":"黄庭坚","text":"凌云一笑见桃花，三十年来始到家。\n从此春风春雨后，乱随流水到天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71987,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题王晋卿平远溪山幅","author":"黄庭坚","text":"风流子晋罢吹笙，小笔溪山刮眼明。\n相倚鸳鸯得偎映，一川风雨断人行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71988,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题东丁水","author":"黄庭坚","text":"古人题作东丁水，自古东丁直到今。\n我为改名方响洞，要知山水有清音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71989,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题归去来图二首 其二","author":"黄庭坚","text":"人间处处犹崔子，岂忍更令三径荒。\n谁与老翁同避世，桃花源里捕鱼郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71990,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题归去来图二首 其一","author":"黄庭坚","text":"日日言归真得归，迎门儿女笑牵衣。\n宅边犹有旧时柳，漫向世人言昨非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71991,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题永首座庵颂","author":"黄庭坚","text":"夺得胡儿马便休，休嗟李广不封侯。\n分明射得南山虎，子细看来是石头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71992,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题刘氏所藏展子虔感应观音二首 其二","author":"黄庭坚","text":"群盗挽弓江簸船，丹青当在普通前。\n谁能与作赤挽板，老笔犹堪寿百年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71993,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题刘氏所藏展子虔感应观音二首 其一","author":"黄庭坚","text":"人间犹有展生笔，佛事苍茫烟景寒。\n常恐花飞蝴蝶散，明窗一日百回看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71994,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题刘将军雁二首 其二","author":"黄庭坚","text":"将军一矢万人看，雪洒晴空碎羽翰。\n乞与失群沙宿雁，笔间千顷暮江寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71995,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题刘将军雁二首 其一","author":"黄庭坚","text":"滕王蛱蝶双穿花，东丹胡马喷胡沙。\n祁连将军一笔雁，生不并世俱名家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71996,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题竹尊者轩","author":"黄庭坚","text":"平生脊骨硬如铁，听风听雨随宜说。\n百尺竿头放步行，更向脚跟参一节。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71997,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题邢惇夫扇","author":"黄庭坚","text":"黄叶委庭观九州，小虫催女献功裘。\n金钱满地无人费，百斛明珠薏苡秋。","collection":"宋","not