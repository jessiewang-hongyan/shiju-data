[{"title":"拟寒山寺 其一四○","author":"释怀深","text":"人生不满百，常怀千岁忧。\n犹嫌金玉少，更为子孙求。\n白日晓还黑，绿杨春复秋。\n无过富与贵，不奈水东流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1750,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其一四一","author":"释怀深","text":"入寺设僧斋，先且问客食。\n一味不可口，满座皆啾唧。\n回顾憍陈如，钵盂未尝湿。\n恁么说斋僧，有名而无实。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1751,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其一四二","author":"释怀深","text":"辛苦置田园，岁收五千斛。\n死了付儿孙，儿孙享其福。\n忌辰饭十僧，纸钱烧一束。\n人生为子孙，所得何纤粟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1752,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其一四三","author":"释怀深","text":"一年五千斛，十年计五万。\n不知十年间，所作何事办。\n暴殄天物多，也好自思算。\n福若不消磨，除君是铁汉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1753,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其一四四","author":"释怀深","text":"人人要便宜，个个觅小利。\n所争能几何，失却大人体。\n饶人福自来，瞒人祸自至。\n此理甚分明，尚犹不瞥地。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1754,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其一四五","author":"释怀深","text":"傅大士种瓜，瓜熟人偷窃。\n以篮热园中，与偷便提挈。\n偷儿感此情，再拜心服悦。\n无争与莫争，尽向慈门摄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1755,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"诫杀偈十首 其一","author":"释怀深","text":"利刀活斫当腰断，前脚犹能跳踯行。\n看著众生如是苦，异时果报不多争。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1756,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"诫杀偈十首 其二","author":"释怀深","text":"暇蟆蚵蚾形模丑，咂矢争蛆臭秽多。\n涴却娘生清净口，只应笑倒老维摩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1757,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"诫杀偈十首 其三","author":"释怀深","text":"蚬子师螺街市食，小人咀嚼绕台盘。\n近来豪贵尊荣者，嗜好成风总一般。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1758,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"诫杀偈十首 其四","author":"释怀深","text":"吴人信向更无加，可惜时中善愿差。\n手掐数珠忙念佛，一边叫唤买鱼虾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1759,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"诫杀偈十首 其五","author":"释怀深","text":"闻说刀兵已皱眉，贪生畏死是人知。\n如何不恤他身苦，斩斫烹炮无厌时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1760,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其一","author":"释怀深","text":"不奈诸人苦再三，薄缘终是自多惭。\n晨猿夜鹤应相笑，特地伸头人闹篮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1761,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其二","author":"释怀深","text":"尘埋古镜久偷安，匿耀潜辉度岁寒。\n今日光明藏不得，虚堂高挂任君看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1762,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其三","author":"释怀深","text":"摩竭当年独掩关，银山铁壁莫追攀。\n如今大施门开也，魔佛休分听往还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1763,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其四","author":"释怀深","text":"数间茅屋不堪忧，底事来为粥饭头。\n赖有劫初铃子在，随贫随富自风流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1764,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其五","author":"释怀深","text":"年年此日是重阳，篱菊如闻去岁香。\n莫笑枝条太枯槁，从今别有好商量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1765,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其六","author":"释怀深","text":"门福一著，商量即错。\n明眼衲僧，无绳自缚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1766,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其七","author":"释怀深","text":"资福一窍，最玄最妙。\n直下会得，教你冷笑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1767,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其八","author":"释怀深","text":"有问有答周遮，无言无说话堕。\n直饶顽石点头，争似归堂向火。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1768,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其九","author":"释怀深","text":"失却栏中白象儿，临风笑倒老峨嵋。\n街头措大无精鉴，一夜灯前赋雪诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1769,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其十","author":"释怀深","text":"春风扫尽庭前雪，暖日催开枝上花。\n物物头头皆漏泄，莫教心地乱如麻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1770,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其十一","author":"释怀深","text":"衲僧不用看他灯，自有从前一盏明。\n坏衲蒙头面壁坐，灵光射破铁围城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1771,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其十二","author":"释怀深","text":"万劫轮回妄想在，一心才歇死生休。\n佛魔是甚闲家具，撒手悬崖得自由。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1772,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其十三","author":"释怀深","text":"学道做工夫，正如人凿井。\n一日见泉源，平生用不尽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1773,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其十四","author":"释怀深","text":"仲春天气喜初晴，燕语彫梁有好声。\n曾得玄沙当日意，便能日午打三更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1774,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其十五","author":"释怀深","text":"沤生沤灭几千回，只为金刚眼不开。\n一日爱河波浪息，始知无去亦无来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1775,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其十六","author":"释怀深","text":"病瘳鹤骨瘦棱棱，说妙谈玄总不能。\n赖有同行木上座，是渠强健更惺惺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1776,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其十七","author":"释怀深","text":"古人贫不及，今人富太过。\n唯有慈受叟，家风不恁么。\n有油便点灯，有炭便向火。\n无油无炭时，大家黑处坐。\n坐得骨臀痛，长伸两脚卧。\n天明起来吃粥，说甚迷逢达磨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1777,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其十八","author":"释怀深","text":"道在何曾在间然，休分城市与林泉。\n重来痂法栖禅处，依旧清风满目前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1778,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其十九","author":"释怀深","text":"今朝一阳生，明日便数九。\n张三依旧肥，李四从来瘠。\n吃尽天下药，旧病依前有。\n用尽自家心，笑破他人口。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1779,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其二十","author":"释怀深","text":"一夜翻空大雪，玉殿银楼皎洁。\n晓来庭际无人，莫道山僧不说。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1780,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其二十一","author":"释怀深","text":"东风吹尽晓天云，大地山河总变春。\n不用当门书大吉，个中无鬼亦无神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1781,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其二十二","author":"释怀深","text":"云门劄，资福收。\n一擒一纵，各有来由。\n昨夜春风吹树尾，晓来红日上云头。\n翻笑双林傅大士，却道桥流水不流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1782,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其二十三","author":"释怀深","text":"夜来灯烛斗荧煌，多少众生彻晓忙。\n究竟不知灯是火，昧却灵台一点光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1783,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其二十四","author":"释怀深","text":"今朝吃粥太晚，徐六街头担饭。\n只知打鼓升堂，不觉又是吃饭。\n吃粥了吃饭，吃饭了吃粥。\n清风月下守株人，凉兔渐遥春草绿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1784,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其二十五","author":"释怀深","text":"太平山下曾相见，抚掌呵呵笑脸开。\n莫怪嘉声腾万口，杖藜方自日边来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1785,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其二十六","author":"释怀深","text":"金轮御世乾坤永，玉烛调时宇宙明。\n桃李无言春烂熳，不知何以报升平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1786,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其二十七","author":"释怀深","text":"流注真常几万回，虚空无去亦无来。\n个中何地容生死，打破当堂明镜统。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1787,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其二十八","author":"释怀深","text":"天面雁横七八点，海门日上两三竿。\n祖师心印分明在，自是时人不解看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1788,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其二十九","author":"释怀深","text":"心境顿消融，方明色与空。\n欲识本来体，青山白云中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1789,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其三十","author":"释怀深","text":"心境顿消融，方明色与空。\n欲识本来体，海里使风山上船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1790,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其三十一","author":"释怀深","text":"四维上下白漫漫，玉殿琼楼正好看。\n任是黑风吹海立，渠侬门户不相干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1791,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其三十二","author":"释怀深","text":"时人皆拜岁，山僧不贺年。\n孟春犹寒在，日月几曾迁。\n去年今日后，今日去年年。\n新旧不同者，谁后复谁先。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1792,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其三十三","author":"释怀深","text":"时人皆拜岁，山僧也贺年。\n光明一点在，从听二轮迁。\n顺俗高叉手，和光小说禅。\n个中如会得，佛祖本无传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1793,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其三十四","author":"释怀深","text":"三年住此空花相，今日归欤水月同。\n去住不须论彼此，人生万事转头空。\n修习空花万行，宴坐水月道场。\n降伏镜里魔军，成就梦中佛事。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1794,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其三十五","author":"释怀深","text":"九重天上官家敕，唤起西庵瞌睡人。\n为瑞为祥人莫问，金毛师子玉麒麟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1795,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其三十六","author":"释怀深","text":"口忻得计掩深关，口醭心灰一味闲。\n自笑行藏无料处，又随缘业过焦山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1796,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其三十七","author":"释怀深","text":"一室寥寥是何物，三贤十圣竭头参。\n衲僧不会风前句，拟欲思量落二三。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1797,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其三十八","author":"释怀深","text":"白蘋红蓼岸边秋，短桨轻帆与自由。\n要会到这一句子，长江依旧水东流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1798,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其三十九","author":"释怀深","text":"十一月二十，唤做大冬日。\n张三贺郑婆，李四拜王七。\n早辰到夜，费尽平生力。\n唯有衲僧家，不打者鼓笛。\n铁额昆崙儿，通身黑如漆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1799,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其四十","author":"释怀深","text":"瞿昙学道时，菩提树下坐。\n忽尔见明星，漆桶便打破。\n才打破始信，从前灯是火。\n今人学道不悟道，义路推寻外边讨。\n更说从来无悟迷，大似团圞吞却枣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1800,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其四十一","author":"释怀深","text":"今日端午谢街坊，时节因缘要举扬。\n莫问腕头缠百索，且将粽子吃沙糖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1801,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其四十二","author":"释怀深","text":"是柱不见柱，一句超今古。\n夜来石公山，有个欢喜处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1802,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其四十三","author":"释怀深","text":"焦山句句是药，祇要时人安乐。\n费尽巴豆砒霜，转见七零八落。\n诸人步步是病，终日头旋眼运。\n祇管以火救火，不解头正尾正。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1803,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其四十四","author":"释怀深","text":"宗门标致久凄凉，佛鉴山头又坐亡。\n昨夜灯前即屈指，不知谁解整颓纲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1804,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其四十五","author":"释怀深","text":"惆怅钟山老水牯，去住纵横无必固。\n拔禊抽钉二十年，咬尽生姜呷尽醋。\n有时贫，有时富，谁会南山狗咬虎。\n纷纷衲子数如麻，不知谁解吞蓬句，听取焦山重指注。\n若道钟山有句，大似如藤倚树。\n若道钟山无句，正是沈埋佛祖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1805,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其四十六","author":"释怀深","text":"江月照，松风吹，永夜清霄何所为。\n若是曹溪门下客，相逢不必更扬眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1806,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其四十七","author":"释怀深","text":"扁舟何事渡江来，林底相逢笑脸开。\n盐米不须重话会，要须舌上起风雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1807,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其四十八","author":"释怀深","text":"有一皆伎俩，尽是人妄想。\n少府打手力，笑杀韩官长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1808,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其四十九","author":"释怀深","text":"佛从大悲心，流出十二部。\n琅函与玉轴，遍满河沙数。\n言言皆妙药，字字超今古。\n譬如优昙花，百劫难遭遇。\n又如大明灯，能破黑暗处。\n又如智慧力，能断无明树。\n又如璎珞珠，能使人丰富。\n茫茫尘世人，急急走如兔。\n不觉老到来，未尝开眼觑。\n独有花评事，信向颇坚固。\n命我无心人，转此诸佛语。\n浮生一百年，正如草头露。\n上床鞋履别，保朝不保暮。\n少吃两块肉，多烧香一炷。\n羊鹿牛三车，皆行此条路。\n鹤态云踪不定居，白沙一别半年馀。\n焦山脚下重相见，记得当时事也无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1809,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其五十","author":"释怀深","text":"焦山热肺肠，有事便要了。\n今岁闰九月，来年春气早。\n顶门三只眼，常要光皎皎。\n照顾沩山水牯牛，莫教吃却他人草。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1810,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其五十一","author":"释怀深","text":"焦山僻在海门边，得到其中是夙缘。\n要会相逢一句子，春风依旧似当年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1811,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其五十二","author":"释怀深","text":"春色无高下，春雷动地音。\n翻空一夜雨，滴破祖师心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1812,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其五十三","author":"释怀深","text":"焦山无变豹，一味劝人休。\n众生颠倒甚，拨火觅浮沤。\n石巩驾弓箭，俱胝竖指头。\n直下歇得去，都如椀脱丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1813,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其五十四","author":"释怀深","text":"迷时境上千般有，悟去心中一物无。\n若会笑声还似哭，方知生与死同途。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1814,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其五十五","author":"释怀深","text":"动弦别曲，叶落知秋。\n隔墙见角，便知是牛。\n伶俐衲僧，才眨眼商量，已落第三筹。\n休休，不如无事挂心头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1815,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其五十六","author":"释怀深","text":"吾有一言，绝虑忘缘。\n巧说不得，祇要心传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1816,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其五十七","author":"释怀深","text":"我笑禅和子，茫茫能地头。\n随人语脉转，何日得心休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1817,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其五十八","author":"释怀深","text":"滔滔生死海无涯，绿鬓朱颜未足誇。\n五蕴山头云散后，不知明月落谁家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1818,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其五十九","author":"释怀深","text":"不是境，亦非心，唤作佛时也陆沈。\n个中本自无阶级，切忌无阶级处寻。\n总不寻，过尤深，打破云门饭袋子，方知赤土是黄金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1819,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其六十","author":"释怀深","text":"红杏枝头小雨乾，东风特地作春寒。\n祖师门户无遮障，祇要时人著眼看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1820,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其六十一","author":"释怀深","text":"四年两受官家敕，玉璨珠华耀海门。\n鼓舞尧风聊自愧，不知何以答君恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1821,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一百二十首 其六十二","author":"释怀深","text":"隈岩傍水养衰残，不谓虚名落世间。\n到此更无回避处，只应笑倒石公山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1822,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]