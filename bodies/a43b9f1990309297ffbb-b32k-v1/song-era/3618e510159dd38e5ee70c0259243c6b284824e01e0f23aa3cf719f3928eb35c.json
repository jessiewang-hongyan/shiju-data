[{"title":"累日不到中园晚步闲咏","author":"韩维","text":"南陌西陂趁物华，归来扶杖重咨嗟。\n绿罗浅淡新开叶，红玉玲珑半谢花。\n泉溜拍池初跳鲤，柳枝含雨不胜鸦。\n啼禽亦有伤春恨，百种鸣声到落霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24067,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谒汉高帝庙","author":"韩维","text":"魂魄应游沛，空嗟庙貌残。\n苍碑火剥裂，画壁雨阑干。\n帐幕虚风肃，松槐白日寒。\n升堂欲进拜，犹怯戴儒冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24068,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谒象之同诸君步之东禅院","author":"韩维","text":"二年憔悴走京尘，匹马归来访四邻。\n足滑旧谙城下径，眼明重见里中人。\n青蔬不没荒畦雪，翠柏常留野殿春。\n风物自如人事改，夕阳哀泪落衣巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24069,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"象之以山药见赠","author":"韩维","text":"龙山有游客，赠药满筠笼。\n叶渍沙泉碧，苗分石窦红。\n斸应侵晓露，来喜及春风。\n却笑丹砂远，卒勤勾漏翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24070,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"象之席上赋得寒字","author":"韩维","text":"爱子林亭胜，高秋驻马鞍。\n梨红先著露，竹碧自生寒。\n惨戚伤多事，淹留强一欢。\n所嗟怯杯酌，不得倒吾冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24071,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"野步","author":"韩维","text":"目倦风尘观，身疲鞍马行。\n春沙迎步润，山雪照怀清。\n冰水初消色，林鸦欲乳声。\n物华多感触，一动故园情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24072,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪中同邻几出游","author":"韩维","text":"絮糅琼霏浩满空，平明骑马入春风。\n九重城阙寒光外，百万人家喜气中。\n不学闭门徒自洁，且欣携酒与君同。\n柳梢花甲从今始，便好寻芳下苑东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24073,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"黄葵花 其二","author":"韩维","text":"春花夏蕊已飘零，秀出秋芳一朵倾。\n禀赋定应全得土，遮围须合尽彫琼。\n鹄衣照水匀颜色，仙袂无尘莫壮名。\n应笑菊花妍意少，篱边冷落伴渊明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24074,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"黄葵花 其一","author":"韩维","text":"池上朝来玉露零，檀心先向日边倾。\n侧金巧样新成盏，蒸栗温姿始号琼。\n芍药未应推艳品，牡丹须合避姚名。\n秋花碎琐谁能数，醉眼逢君亦自明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24075,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寒食出郊","author":"韩维","text":"都门气象雨馀佳，压尽风尘见草芽。\n日薄风和近郊路，朱红粉白远林花。\n堤开独去媻珊女，柳下相逢轻?车。\n丝鬓未催樽酒在，不须辛苦问年华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24076,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寓展江亭谢尧夫寄酒及花","author":"韩维","text":"措枉我先违陛石，均劳公亦下堤沙。\n已欣晚岁逢良友，更喜高秋见好花。\n旨酒芳新来似水，危亭清绝至如家。\n三杯举白歌相和，忘却风前两鬓华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24077,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"普明亭赋","author":"韩维","text":"杨柳飞花尽，樱桃结子成。\n蹊阴空净绿，野艳有孤明。\n访古重来地，伤春独望情。\n幽禽亦何恨，百种向人鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24078,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"景仁招况之闻用歌舞望门而反作此戏之","author":"韩维","text":"一夜严风结素波，盍簪宁避晓寒多。\n范滂揽辔方清俗，墨子回车岂恶歌。\n云外雁寒惊岁晚，林间鸦语弄春和。\n知君不久承宽诏，始奈红裙绿酒何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24079,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"棣华堂","author":"韩维","text":"锦衣赍钺耀当年，心在王家迹在边。\n论议每先诸将勇，规模仍袭仲兄贤。\n一朝华栋飞翚动，四坐清觞插羽传。\n欲赋酬章惭懦武，白头终日诵尘编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24080,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游北园赋","author":"韩维","text":"多病伤春客，经时独掩扉。\n偶随游骑出，已见落花飞。\n芳草微迎履，香风细弄衣。\n扁舟可载酒，便拟拍浮归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24081,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游龙门归","author":"韩维","text":"洛浦残芳尽，来寻关塞春。\n青林横石阁，翠壁涌金人。\n涧草薰衣晚，松风落面新。\n愁驱向城骑，还踏九衢尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24082,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游龙兴寺","author":"韩维","text":"空庭落叶赤，联步得幽寻。\n藓剥残碑字，尘昏古象金。\n菊烟凄晚秀，松日淡秋阴。\n南陌风埃满，禅关只自深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24083,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游象之葆光亭因以寄之","author":"韩维","text":"东亭不到久，双桂长新梢。\n窗静虫收网，檐低燕护巢。\n晚花红自照，繁笋翠相交。\n清景成虚委，知君叹系匏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24084,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"湖上饮","author":"韩维","text":"高秋水木变清光，荷叶乾枯䆉稏黄。\n习静久安融子懒，乘欢聊发次公狂。\n未甘浊酒欺人老，深喜寒花入坐香。\n更谢林端新月色，留连归舫尽三觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24085,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登城楼呈子华","author":"韩维","text":"麦苗黄熟稻苗青，饷妇耘夫笑语声。\n楼上清风帘箔静，田间白水鹭鸥轻。\n展亲会集从容乐，娱老讴吟放旷情。\n羽孽渐消民食足，更无馀事计亏成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24086,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登湖光亭","author":"韩维","text":"雪尽尘消径露沙，公家池馆似山家。\n翠痕满地初生草，红气通林未放花。\n匝岸平波清照雁，压城危榭斗回鸦。\n自惭白首犹圭组，此地年年赏物华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24087,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登楼书事","author":"韩维","text":"病起思遐眺，兹楼寓一欢。\n烟芜连雨脚，秋稼入云端。\n惊鹭衔鱼起，饥鸦啄果残。\n凭谁图好景，画手世无宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24088,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答外孙杨承务","author":"韩维","text":"享厚功微每愧颜，辞荣聊企汉疏贤。\n居民未睹黄公化，过客空疑绛老年。\n适用每惭龟手伎，全生真赖马蹄篇。\n从今风月知无负，鸭子陂中有钓船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24089,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答张念五","author":"韩维","text":"浮云名宦祗劳人，解组归来径杜门。\n继世命官联六傅，传家与子及诸孙。\n圣贤相对书千帙，闾里交欢酒一樽。\n荷芰满湖秋气早，待君方驾践诚言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24090,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答张念五见寄","author":"韩维","text":"林泉萧洒逸平生，不识人间宠辱惊。\n美质自全荆璞贵，嘉名长共洛波清。\n身虽贫约非原病，诗为穷愁似孟精。\n命驾高踪久无继，一时风义独归程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24091,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答李正议见贻","author":"韩维","text":"如公举世几何人，八十年龄自在身。\n处俗不绕诸有相，持心肯受一微尘。\n逢僧便出衣中宝，待士多陈席上珍。\n火宅未须生厌苦，不离当处岂非神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24092,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答杜孝锡观乡老堂","author":"韩维","text":"华发苍然亮直身，谁将綵笔欲传神。\n论功顾我常流汗，好事烦君为拂尘。\n汉阁寂寥班氏赞，伊川潇洒白公真。\n怀贤却坐酬嘉句，空觉中郎善愧人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24093,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答和叔见寄","author":"韩维","text":"清霜落堤水，知子戒归舟。\n蹭蹬蛟龙雨，翻飞鸿鹄秋。\n文章真自乐，得丧岂吾忧。\n南国江山好，裁诗寄少游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24094,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答临淄公见招","author":"韩维","text":"帝思元老付关西，公受兵符与命圭。\n应识疲羸须镇抚，便期愚散豫招携。\n汉家宫殿看龙首，秦地山川入马蹄。\n自愧不才多病者，空哦嘉句滞幽栖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24095,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答赵县丞","author":"韩维","text":"止足常佳汉二臣，早思幽退谢朝绅。\n奉藩终乏三年最，学道才知一日真。\n目病懒将书卷展，心闲得近酒杯频。\n朝吟夕啸无厌斁，正赖贤宾与德邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24096,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答唐州郑郎","author":"韩维","text":"先帝宫藩昔曳裾，便将狂直许倾舒。\n制分内外常更掌，省列东西亦预除。\n敢以功名为己任，自知谋议与时疏。\n归来粗足生生计，幸免乡邻厌乞诸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24097,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答寄广信六弟","author":"韩维","text":"才见高帆落归艑，又携轻剑逐戎麾。\n步兵厨里仍多酒，王粲军中不废诗。\n绝塞风烟通夕静，近关榆柳识春迟。\n花时不得同嬉赏，肠断东风把一卮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24098,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答微之","author":"韩维","text":"南圃携樽数，西陂纵棹同。\n除书褒晚岁，归驭觞西风。\n节物萧条后，交游寂寞中。\n何时还一笑，池上舞惊鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24099,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"筵上遇雪赠人","author":"韩维","text":"前贤遇雪方乘兴，何况雪飞欢兴时。\n自古难并惟美景，人生不饮是痴儿。\n颠狂故态无先舞，淡薄幽怀子独诗。\n安得琼花更飘洒，常令此物及蚩蚩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24100,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢尧夫寄新酒","author":"韩维","text":"故人一别两重阳，每欲从之道路长。\n有客忽传龙坂至，开樽如对马军尝。\n定将琼液都为色，疑有金英借密香。\n却笑当年彭泽令，篱边终日叹空觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24101,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢李公达惠诗再答","author":"韩维","text":"功名无得得闲身，位列东朝愧汉臣。\n空性屡捞潭底月，浮名那记禁中春。\n知音罕遇忘言士，绝学常思过量人。\n莫取无心心外道，此心生处即为尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24102,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢到水仙二本","author":"韩维","text":"黄中秀外干虚通，乃喜佳名近帝聪。\n密叶暗传深夜露，残花犹及早春风。\n拒霜已失芙蓉艳，出水难留菡萏红。\n多谢使君怜寂寞，许教绰约伴仙翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24103,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢厚卿载酒见过","author":"韩维","text":"黄花池馆雨馀清，载酒亲迂太守旌。\n交契早陪廊庙语，宾欢曲尽里闾情。\n尊前白发时间乐，烛下红妆分外明。\n今日始谙闲气味，十年枉却叹劳生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24104,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢微之送鸭脚","author":"韩维","text":"拔尔蒿莱际，微根仅自支。\n劳心勤一溉，拭目待三移。\n秾李惭同列，芳橙合并枝。\n绛囊如有惠，莫忘赠君时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24105,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赏梅花有怀曼叔","author":"韩维","text":"逍遥堂下去年梅，还向春来撩乱开。\n白发每思同泛客，红芳应怪久停杯。\n鸭头新浪暌游泛，鹭羽遗民寄剸裁。\n闻说铃斋多暇豫，何时度曲逐风来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24106,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颍桥会曼叔坐中写呈","author":"韩维","text":"朔雪清初霁，风生翠柏阴。\n星辰寒殿近，灯火夜堂深。\n坐爱温炉密，欢从浊酒斟。\n何当老吾里，杖屦日相寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24107,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"照邻从予假韦苏州集因以诗致之","author":"韩维","text":"都官郎署老，平淡古人如。\n更觅苏州集，长依释子庐。\n室中无净几，门外自华舆。\n为问萧疏意，如何善福居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24108,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬盈祖中散","author":"韩维","text":"勇脱尘冠尚壮年，高斋图史日萧然。\n不教歌舞家规在，善作文章世学传。\n道旧每思倾浊酒，仰高徒觉愧华颠。\n相君昔展西陂尽，好约春风放画船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24109,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"暮春游卞氏园","author":"韩维","text":"路出清阴下，残花著马蹄。\n过城春水静，度墅野桥低。\n池废青蘋合，林深绿笋齐。\n流莺知我恨，落日再三啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24110,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题卞大夫翠阴亭","author":"韩维","text":"新得亭名号翠阴，轩窗环合尽青林。\n定知野客先回顾，何处山禽自好音。\n池面有莲风气馥，城根多竹月华深。\n明年便作归来计，应许携樽与抱琴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24111,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题余山人壁","author":"韩维","text":"一室闭香林，萧然物外心。\n棋声敲月重，屐齿印苔深。\n竹径茶烟细，山园锻树阴。\n会当逃世网，尘事缔朋簪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24112,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠卞大夫","author":"韩维","text":"鍊得朱颜老不衰，归来三径有馀资。\n青林蔽日深开第，翠竹生寒密映池。\n明月泛觞频度曲，华灯照序未收棋。\n白头默坐公毋怪，独爱泉声入夜时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24113,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠香严敷老慧照上人","author":"韩维","text":"胜地名蓝代有人，惟公传得国师真。\n苍崖翠壁风流在，杰阁隆楼指顾新。\n半死半生排俗世，一颦一笑是家珍。\n欲知闻法诸天喜，庭下于今有瑞筠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24114,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"襄城道中怀曼叔","author":"韩维","text":"吾交作尉地，南望一淹留。\n岁月催人老，山川记子游。\n向城非昔勇，遇物更春愁。\n独喜高阳近，岚光逼马头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24115,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"襄柑分惠景仁以诗将之","author":"韩维","text":"荆州解绂十经春，回梦青林绕汉滨。\n霜气轻寒催柑实，渚波馀润作甘津。\n僧园采掇宁论数，客路奔驰竟占新。\n雪意垂收高会缺，分金聊助席间珍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24116,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同辛杨游李氏园随意各赋古律诗一首","author":"韩维","text":"腊近云容变，阳生日景添。\n偶然回晚辔，相与坐晴檐。\n水绿冰微泮，沙明雪尚沾。\n弄襟风力薄，著履土膏粘。\n惊鸟不成下，寒鱼犹在潜。\n翠深荒岸竹，黄折败池蒹。\n碍径藤梢曲，钩衣棘刺铦。\n辞锋怜子淬，閒癖讵予砭。\n自以清谈胜，宁非乐事兼。\n春芳有近信，频此醉厌厌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24117,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"依韵和冲卿槐花","author":"韩维","text":"翠葆连阴直，黄金布蕊齐。\n流尘一开眼，急节重含悽。\n蝶冷相携去，蝉清无数嘶。\n翻风随御水，带雨落秋泥。\n自喜凋零后，何嫌采掇稽。\n朝緌映晨入，游袂拂宵携。\n惨淡林烟早，轻明楼日西。\n临溪如有此，当似武陵迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24118,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"依韵和贡父见寄","author":"韩维","text":"早接英豪论，常多伯仲贤。\n风尘一会合，岁月几徂迁。\n禀性成樗散，干时类凿圆。\n论心谁合者，握手子欢然。\n经训开前古，谈辞屈老先。\n春游同烂漫，醉乐屡回旋。\n乐事嗟难久，离襟怅独偏。\n驱车清汝曲，佐幕紫嵩前。\n官兴惟高咏，人生得晏眠。\n丹铅涂旧史，杖屦接幽禅。\n叹息春期失，淹留夕梦牵。\n非因传丽唱，何以慰劳悁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24119,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和公美以诸家会集所赋诗","author":"韩维","text":"道在何非乐，官闲不近权。\n过从只闾里，真率易盘筵。\n捉麈躬千圣，衔杯慕八仙。\n清欢垂老得，佳句即时传。\n玉醴初醇日，琼花欲坠天。\n谁能于此际，华发问流年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24120,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和宋中散寄题景仁新池","author":"韩维","text":"北顾兴王府，东瞻象日畿。\n稻塍常借润，黍尺讵能晞。\n鹭浴菖芽短，鱼跳荇菜肥。\n乐亭初置酒，试舞旋裁衣。\n逸冀相从老，冥鸿自在飞。\n月游刳小艇，雨钓筑新矶。\n栽插期春事，追游惜晚晖。\n气同均我尔，道胜绝从违。\n安燕兴棠棣，艰勤陋采薇。\n如何宋中散，留滞不成归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24121,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和象之同孔宁极游石桥且简宁极","author":"韩维","text":"春风杖藜客，同到石桥边。\n引袖披云木，携樽俯涧泉。\n岩花聊采摘，野器不雕镌。\n俯仰元和内，熙恬太古前。\n草心柔可绾，蒲叶密于编。\n涧麀来窥坐，沙鸥不改眠。\n濛濛桃李雨，幂幂薜萝烟。\n舞类雩祠日，吟非楚泽年。\n鱼跳闻急管，鸟语似幺弦。\n紫翠羞薇蕨，清香袭蕙荃。\n乱流时揭厉，微径巧萦穿。\n德义心诚服，山林性所便。\n敢令然诺负，直以事为牵。\n圯下履终跪，溱边裳且褰。\n春醪可益酿，况有帛戋戋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24122,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和微之","author":"韩维","text":"早接忠贤论，常钦古学风。\n何期华发后，更得绿樽同。\n远水秋光外，高亭夕照中。\n芡盘凋晚翠，菊艳夺春红。\n歌放聊娱老，谈精本代工。\n欢馀笑张翰，迢递想江东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24123,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和微之尧夫作会","author":"韩维","text":"燕豆何频设，归鞍夜屡阑。\n敢言挥麈倦，惟怯釂觞难。\n就暖歌筵密，凭高绘境宽。\n未甘闲处卧，犹学少时欢。\n浮蚁凌山玉，飞花掩袖纨。\n幸同诸老醉，击壤颂安安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24124,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"奉同邻几对","author":"韩维","text":"时律迎阳近，天云带雪低。\n欲飞含气象，忽散失端倪。\n绛阙明先曙，清衢冻不泥。\n休祥占岁序，佳气动烝黎。\n矫若翔廱鹭，纷疑剥楚圭。\n晨昏檐影眩，壬丙辨方迷。\n贺瑞彤墀集，凌寒玉仗齐。\n御筵开省户，赐醴走宫奚。\n屋角悬珠网，林梢挂素霓。\n山号悲虎兕，渊伏怯龟蠵。\n哀响求群雁，喧啾得食鸡。\n饥鹰无近击，狂兔有新刲。\n感往悲时物，怀幽梦故栖。\n温炉期夜拥，杰阁想晨跻。\n验古闻牛目，投閒读马蹄。\n吾交情不薄，今日手同携。\n酒拨新醅酌，诗看本字题。\n优游无不可，何必剡中溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24125,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题刘仲更泽州家园","author":"韩维","text":"闻君有佳尚，买胜不论钱。\n径凿苍林藓，亭开翠壁烟。\n徙花穷洛谱，得石记唐年。\n数卷书盈万，言章木以千。\n晨昏板舆往，社腊燕觞传。\n予亦耽幽事，西风一慨然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24126,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游曲水园和景仁","author":"韩维","text":"楼峻城千堞，堤长竹万竿。\n草芽生戢戢，花蕊落漫漫。\n走笔狂吟放，扶筇醉步跚。\n屡回宜舞袖，甘著堕游冠。\n野老来窥坐，沙禽不避观。\n两行桃艳暖，一道柳阴寒。\n纵棹非寻戴，掀车免效栾。\n官曹嗟倥偬，农事闵艰难。\n急景三春好，浮生几日欢。\n康强直行乐，此兴不应阑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24127,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答杨之美春日书怀依韵","author":"韩维","text":"久宦怜官薄，端居惜岁芳。\n世情徒枳棘，吾操自松篁。\n铁擿敷经暇，檀槽度曲长。\n浮沈归浊酒，感激见新章。\n守道言何固，安时志不忘。\n惭无推挽者，祝子寿而康。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24128,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]