[{"title":"赵大资挽诗 其一","author":"林希逸","text":"先帝云公有相才，经帷曳履久徘徊。\n先调化瑟更弦去，却赞兵机杖节来。\n祀典空闻陪五使，宗臣不许位三台。\n白头遗老孤忠在，忽漫骑鲸亦惜哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32856,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赵大资挽诗 其二","author":"林希逸","text":"当年玉座语尤亲，荐士虽多不语人。\n天下短长才识尽，内中方寸纸来频。\n仆穷分作米盐吏，公许宜为翰墨臣。\n回首摛文今梦断，长怀知己泪沾巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32857,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"王太博挽诗 其一","author":"林希逸","text":"兰宫凡几上，直待晚成身。\n臣对三千字，君恩第一人。\n谈经居未久，岸帻请何频。\n风月分能几，空山骨已尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32858,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"王太博挽诗 其二","author":"林希逸","text":"以赋鸣虽早，襟怀实似虚。\n出弹齐士铗，归读乐轩书。\n丹桂攀殊苦，黄粱梦不如。\n在时同手足，入念每沾衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32859,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"卢汀州挽诗 其一","author":"林希逸","text":"名落江湖岁月多，白头还止梦三刀。\n胸藏千载心期远，识尽诸贤眼力高。\n慷慨当筵谈抵掌，淋漓满壁醉挥毫。\n空山埋去泥销骨，何日人间见此豪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32860,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"卢汀州挽诗 其二","author":"林希逸","text":"野涉来南岸帻时，我方为掾久追随。\n炉熏柳叶同清话，酒嚼梅花几赋诗。\n别后京华才一见，病馀山寺谩相期。\n为公一恸今踰纪，当日交游在者谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32861,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"百七弟挽诗","author":"林希逸","text":"我嗟孤日早，汝亦守偏亲。\n爱甚于诸季，年多似一轮。\n家虽老去足，身苦病来频。\n卜穴何时定，伤心历四春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32862,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"黄倅挽诗 其一","author":"林希逸","text":"蹇驴骖乘骥盐车，有士如君具眼无。\n唾手两科名淡墨，秃头半刺□纡朱。\n笔无见梦花何有，玉只空埋草已枯。\n摇膝向人吟不住，追思如见重嗟吁。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32863,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"黄倅挽诗 其二","author":"林希逸","text":"辈行交情似此稀，旧游追记每攒眉。\n桐花古郡为僚日，落叶长安谒选时。\n君去鸣琴曾别饮，我期煨芋更论诗。\n谁知俯仰成今古，偻指伤心二十期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32864,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"两舅氏挽诗","author":"林希逸","text":"吾舅虽潜德，人间两玉人。\n眼高俱迈俗，鬓秃共娱亲。\n场屋因缘薄，诗书趣味新。\n少公谈颇胜，伯氏奕尤神。\n门外相过少，樽中自酿醇。\n荆花同伴老，竹叶满怀春。\n寿秩皆踰七，堂封亦与邻。\n赠车伤作梦，华屋怅今颦。\n甥老头如雪，山空骨已尘。\n前年松下酹，语不尽酸辛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32865,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"王仓挽诗","author":"林希逸","text":"姓名早入文章箓，姿性宜生孝友家。\n视世故轻如枣叶，得时名重只皇华。\n白杨何处伤心远，紫帽同游饮泪嗟。\n向老伊谁同此意，独馀一友在东嘉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32866,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"九江朱长卿挽诗 其一","author":"林希逸","text":"精神满腹气英英，早岁宜登要路津。\n名是平原门下客，字同先汉蜀中人。\n已趋文石班犹浅，虽拥油幢志未伸。\n壮士不留强虏在，交游相吊泪沾巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32867,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"九江朱长卿挽诗 其二","author":"林希逸","text":"江番相望两年馀，度度书来有壮图。\n安已弹筝思海道，武空鸣剑说伊吾。\n公閒未久骑鲸去，我远先惭倩雁无。\n宿草不知秋几度，衰年何计奠生刍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32868,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"九江朱长卿挽诗 其三","author":"林希逸","text":"班行一见便欢然，意气相求似夙缘。\n得古鼎彝多鉴定，常时樽俎每招延。\n郊吟愈和曾成轴，晋帖唐碑不计钱。\n见说旧藏今散尽，传家犹幸子能贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32869,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"陈所斋挽诗 其一","author":"林希逸","text":"胸涵万卷笔如虹，四海应无两所翁。\n身老肯疑询有鬼，眼高不许宪交公。\n祇缘命薄非才薄，信是文穷与学穷。\n班路重来终一簿，予麾亦不到莆中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32870,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"陈所斋挽诗 其二","author":"林希逸","text":"三文堂上墨犹鲜，别几何时哭此仙。\n散发弄舟思往日，撚髭觅句是前年。\n理明洛学知翁少，表慕泷冈有子贤。\n人物如斯埋玉去，病违执绋泪潸然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32871,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"刘殿讲大卿挽诗 其一","author":"林希逸","text":"涉世风波恶，收身岁月长。\n再三持簜节，八十侍华光。\n边入筹如蔡，民怀惠有棠。\n两朝凡几奏，书不与人亡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32872,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"刘殿讲大卿挽诗 其二","author":"林希逸","text":"已分黄冠老，犹为白发卿。\n登朝耆寿俊，圣学缉光明。\n盛德兼和介，高怀了死生。\n柯山仙窟宅，笙鹤定相迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32873,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"莆守汪宗博挽诗 其一","author":"林希逸","text":"凝香据案几何时，事事传来昔见稀。\n生果神如包孝肃，死尤贫似尹翁归。\n谁知食少为身害，可恨才多与命违。\n见说满城人恸哭，交游那得不沾衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32874,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"莆守汪宗博挽诗 其二","author":"林希逸","text":"襟义如公世所难，南来一念十年间。\n喜时文石为乌石，未到壶山住道山。\n宿草故人酬愿毕，生刍有客吊丧还。\n清名虽在身何在，抆泪空嗟造物悭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32875,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"莆守汪宗博挽诗 其三","author":"林希逸","text":"天夺如公亦酷哉，遗民悲慕似婴孩。\n輤还夹道号啼送，寝祭诸村接续来。\n野录何年能入史，祠成他日转生哀。\n溪干旧友多弹泪，半月前书手自回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32876,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"吴理卿挽诗 其一","author":"林希逸","text":"风骨相期众，才名为底穷。\n策虽高似董，位却劣于洪。\n没世臣卿少，他年史笔公。\n赐诗宸训在，无愧是清忠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32877,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"吴理卿挽诗 其二","author":"林希逸","text":"二纪中年废，清时晚岁收。\n如斯封马鬣，谩尔跨鳌头。\n雅度人何忤，虚名世浪仇。\n论交思少日，文会饮榕楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32878,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"吴理卿挽诗 其三","author":"林希逸","text":"白首同收召，追随仅一冬。\n公由卿出使，我去掖为农。\n上节归曾见，携琴愿莫从。\n伤心湖水外，石兽倚长松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32879,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"陈判官挽诗","author":"林希逸","text":"师学亲闻正始音，半生为母欲投簪。\n游环璧水成名去，为念珠曹得誉深。\n贤比邺侯家有传，达如康节病先吟。\n宁需郡幕辞台幕，到死知君铁石心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32880,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"陈府判司令挽诗","author":"林希逸","text":"大科家世衮传芳，恨不峥嵘翰墨场。\n空郁壮图才半刺，合司帝籍便横翔。\n官称仅似浔阳白，早慧疑如江夏黄。\n曾向掖垣开荐口，眼看埋璧倍嗟伤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32881,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"郑令人挽诗","author":"林希逸","text":"具眼翁求婿，齐眉老耐贫。\n年如绛甲子，贤比鲍夫人。\n守诫居官舍，持经识幻身。\n亲邻恩意厚，谁不泪沾巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32882,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"陈橘山挽诗 其一","author":"林希逸","text":"昔侍先师席，西轩笔研同。\n晚为莲社客，私号橘山翁。\n内景经谁授，还丹诀自通。\n仙班催底急，吟此望方蓬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32883,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"陈橘山挽诗 其二","author":"林希逸","text":"数亩园虽小，斋居却有楼。\n木奴居半许，果子亦多收。\n閒日长趺坐，晴时间出游。\n自君之去矣，遥望只增愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32884,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"陈橘山挽诗 其三","author":"林希逸","text":"几年漫仕贫如故，半世投閒乐远谗。\n无八九椽多借宅，得三百户谩题衔。\n初留兰省交吟卷，再见芝山送别帆。\n何月得寻埋玉处，天南凄恻梦松杉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32885,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"郑子诚挽诗 其一","author":"林希逸","text":"执经师席下，于我是庚兄。\n袖手尘中老，灰心世上名。\n杖藜行竟日，杯酒度平生。\n终始交情在，无人解索铭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32886,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"郑子诚挽诗 其二","author":"林希逸","text":"住处虽邻曲，多惭寂寂居。\n间能驰手帖，时致以肩舆。\n我叹年相若，君衰日渐疏。\n人间梦先破，周蝶果何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32887,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"刘夫人挽诗 其一","author":"林希逸","text":"淑德生全美，深闺礼自防。\n训严今孟母，誓苦昔共姜。\n科欲传三世，儿令学四方。\n栖鸾吾所爱，千里索铭章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32888,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"刘夫人挽诗 其二","author":"林希逸","text":"独力持家老，真如烈丈夫。\n斋明供蕴藻，服饰厌金珠。\n甲子祗馀六，鸾雌叹久孤。\n悲笳讲山路，寒日澹霜芜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32889,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"庄丞内子挽诗 其一","author":"林希逸","text":"多门嫔贵族，何事喜摩诃。\n清比顾家妇，达如凌行婆。\n再来邻曲媪，独见女中娥。\n委化虽云乐，潘郎鬓柰何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32890,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"庄丞内子挽诗 其二","author":"林希逸","text":"死自知归处，生能孝养亲。\n真堪名烈妇，岂不胜痴人。\n新卜金沙竁，空埋玉雪身。\n佳铭求篆石，掺笔为酸辛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32891,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"郑仲升挽诗","author":"林希逸","text":"西轩同舍日，开爽莫如君。\n健笔疑淹笔，方巾似艾巾。\n壮年嗟斗粟，老日味羹芹。\n邻里交游尽，伤心宿草坟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32892,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"林甲父挽诗","author":"林希逸","text":"我有宗传未付衣，喜渠岁晚共吾伊。\n云胡丹旐鸣笳去，不见青衿问易时。\n生灵运前何太速，为文介后重堪悲。\n犀斜宰木今谁主，饮泪看君乳下儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32893,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"丘司理母挽诗","author":"林希逸","text":"三十年嫠未易禁，信眉才尔遽涔涔。\n断机有训名花帖，埋璧无惭见藁砧。\n剪发为圭供客馔，却蚶令侃职官箴。\n年兄事状夫人志，岁月追思泪满襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32894,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"李提举挽诗 其一","author":"林希逸","text":"荣涂久历似羊肠，蓬省归来发欲黄。\n麟笔正烦朱邸客，骃丝还要锦窠郎。\n观鱼濠上归思切，吟雁峰前遗爱长。\n金凤赓酬知乐甚，玉楼谁召去何忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32895,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"李提举挽诗 其二","author":"林希逸","text":"早岁声喧翰墨场，晚寻兰芷到湖湘。\n刘郎未得文章力，涪老空怀书传香。\n埋璧奈何从石衒，好竽滋甚况琴亡。\n山房宿处成终诀，怅忆交情四十霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32896,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"陈提举挽诗 其一","author":"林希逸","text":"三为一疏凤鸣阳，去国投閒两鬓霜。\n早有重名居豸府，晚因同姓误君王。\n恰还使事逢新政，已峻卿班入太常。\n止尼不知何物祟，清时竟失鲁灵光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32897,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"陈提举挽诗 其二","author":"林希逸","text":"岭海清声玉雪如，门庭尤峻是閒居。\n吹嘘昔日班扬赋，受用馀年老易书。\n亭列百间多筑圃，舟移数里自穿渠。\n春来红紫应岑寂，花外无因见小车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32898,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"陈提举挽诗 其三","author":"林希逸","text":"别无久近不相忘，见面虽疏意味长。\n向摧梁初驰唁疏，已埋玉后送铭章。\n我惭临穴诗黄鸟，儿报移阡谶白羊。\n絮酒何时浇宿草，些成三赋泪沾裳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32899,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赵通判挽诗 其一","author":"林希逸","text":"世守祗儒术，才优奏最频。\n官终半刺史，孝事两家亲。\n长葛碑仍在，甘棠爱尚新。\n赵公陂上下，遥想泣遗民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32900,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赵通判挽诗 其二","author":"林希逸","text":"碎剧更尝久，跻攀鬓已皤。\n题舆嗟命啬，制锦得名多。\n铭好传千载，梁摧付一窠。\n书丹惭钝笔，回恻甚于苏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32901,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山长陈刚父挽诗 其一","author":"林希逸","text":"名在江湖久，青袍鬓已霜。\n苕人师凿齿，莲幕客君房。\n甫为思芹去，还遭撼树伤。\n清朝公道厄，埋骨竟凄凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32902,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山长陈刚父挽诗 其二","author":"林希逸","text":"君本轻场屋，何心第太常。\n吟姿如岛瘦，直性似萧刚。\n已恨婵娟误，争知禅化忙。\n功名虽有命，诗在莫俱亡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32903,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"林宗院母挽诗","author":"林希逸","text":"鹤发贤哉母，冰清又玉温。\n早同夫傃隐，晚受子貤恩。\n箕笔营新竁，铭文托后村。\n登堂曾及拜，吟望暗伤魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32904,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"丘进道内子挽诗","author":"林希逸","text":"鸂鶒同看去，闺营不少须。\n幼痴儿哭母，死孝妇从姑。\n牛卧图形好，鸾栖镜影孤。\n藁砧铭石语，悽寄挽郎歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32905,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梁秘阁挽诗 其一","author":"林希逸","text":"江幕归来喜脱簪，当门小筑似山庵。\n名于世见林间一，爵以仁尊天下三。\n早失偏慈心已懒，晚虽漫仕性难堪。\n非无忧爱閒成僻，雷雨曾传旧奏函。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32906,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梁秘阁挽诗 其二","author":"林希逸","text":"白头姓字紫蓬仙，三径还公得乐全。\n八九十翁健如虎，等閒一蜕妙于蝉。\n何年重见风前树，此夜愁看月上弦。\n义合吊庐寒阻我，须携斗酒到冈边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32907,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梁秘阁挽诗 其三","author":"林希逸","text":"当年握手向番湖，岁晚交情不暂疏。\n安乐窝中三度宿，往来溪上几回书。\n凤游旧客彫零尽，龙窟新阡怅望初。\n人物如公应不死，有铭有诔果何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32908,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赵侯母葛氏挽诗","author":"林希逸","text":"盛德高年百福全，瑶池元是女中仙。\n慈民束吏如侯少，为国生材叹母贤。\n綵服俄更衰服去，襦歌还与薤歌传。\n民怀召父依依切，苦恨夫人不少延。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32909,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戴主簿挽诗 其一","author":"林希逸","text":"榕楼饮日君豪甚，岂料凄凉雪满头。\n横鹗几回宾上国，栖鸾一老殡南州。\n拜经传业源流在，作赋摩空取次休。\n诗卷旧人无十九，箫笳何去暮云愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32910,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戴主簿挽诗 其二","author":"林希逸","text":"有子能贤知孝甚，新磨铭石以贫迟。\n为君更作招魂些，此士无惭有道碑。\n身老梦思埋玉处，客游忆到共灯时。\n家成好入遗文去，乞与他年作瑞芝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32911,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"前住黄檗亮西山挽诗","author":"林希逸","text":"畴昔西山元有亮，师今名亮号西山。\n初修白业光时现，晚破玄关发已斑。\n缘熟不妨逢檗住，意阑忽漫杖藜还。\n雁湖未久跏趺去，汝蜕虽高我怆颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32912,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"黄倅内子挽诗","author":"林希逸","text":"岸帻生同誉，翻经老耐嫠。\n能贤儿似侃，爱客母如圭。\n有弟铭崔姊，何人传鲍妻。\n霜风吹旐去，笳咽筱塘西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32913,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"适轩黄革叟挽诗 其一","author":"林希逸","text":"翁昔南游日，看君玉雪如。\n晚凭居士几，死守乐轩书。\n圣处吟应到，原夫技岂疏。\n白头心自适，元不羡高车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32914,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"适轩黄革叟挽诗 其二","author":"林希逸","text":"闽谱虽华远，君于派得黄。\n铭宜买石待，诗岂入瓢藏。\n忆昔题吟稿，伤今赋一章。\n香峦序葬处，遥想暮笳长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32915,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽潘守 其一","author":"林希逸","text":"诗书家世事，公独妙兵筹。\n异质生三乳，时名放一头。\n万山丛里邑，五岭水边州。\n谩道登朝去，功多恨未酬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32916,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽潘守 其二","author":"林希逸","text":"广蜀为唇齿，双江直下舟。\n人知传干腹，公识到源头。\n袖入榻前疏，筹深岭外忧。\n慇勤参近事，字字比龟猷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32917,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽潘守 其三","author":"林希逸","text":"乡闾扶杖久，早岁誉兵间。\n谁信白头叟，能柔赤脚蛮。\n人言劳不报，公有道能閒。\n似是英雄骨，埋名向此山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32918,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽潘守 其四","author":"林希逸","text":"文武忧才尽，斯人为底穷。\n威声传境外，袖手老闽中。\n来往二三客，康宁九十翁。\n及门曾一识，铭笔愧难工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32919,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"同年赵左藏挽诗 其一","author":"林希逸","text":"登名三十载，岸帻去壶山。\n乍入离珠府，不留鸣玉班。\n同升君弱冠，久别我衰颜。\n及此吟哀些，伤哉数太悭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32920,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"同年赵左藏挽诗 其二","author":"林希逸","text":"客有南来者，云君病本无。\n信然身是梦，俄尔我非吾。\n甫脱登山屐，犹倾对月壶。\n人生太危脆，变幻止斯须。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32921,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]