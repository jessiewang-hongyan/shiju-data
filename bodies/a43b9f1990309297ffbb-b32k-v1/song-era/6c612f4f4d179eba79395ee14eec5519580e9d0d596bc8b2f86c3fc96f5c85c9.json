[{"title":"古意","author":"张耒","text":"楼上珠帘拂疏网，却匀愁黛对凌波。\n也知新旧争多少，敢话机头织素多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50935,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"古意三首 其三","author":"张耒","text":"橘犀如半月，何日是圆时。\n如何一种味，却有两人知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50936,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"古意三首 其二","author":"张耒","text":"金铺银屈膝，动处有人挨。\n棋盘作十字，中心为子来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50937,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"古意三首 其一","author":"张耒","text":"园中杨柳树，飞舞似含羞。\n如何风静处，尽放眼中愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50938,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"四月二十三日昼睡起","author":"张耒","text":"幽人睡足芭蕉雨，独岸纶巾几案凉。\n谁和薰风来殿阁，不知陋巷有羲皇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50939,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"失性","author":"张耒","text":"失性摧颓君子鹤，忘羞跳掷沐猴冠。\n须知六合枭鸾杂，供与閒人静处看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50940,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宁子","author":"张耒","text":"宁子阳愚饱谙事，贾生恸哭漫多愁。\n无言天道何须问，毕竟人间春复秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50941,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"对菊花二首 其二","author":"张耒","text":"躬耕遇岁真吾事，牛下齐儿妇妾歌。\n招饮风烟过閒日，绕篱栽菊可如何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50942,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"对菊花二首 其一","author":"张耒","text":"官閒身世两悠悠，种竹栽花一散愁。\n黄菊丛边对疏雨，一年怀抱此时秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50943,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"平生","author":"张耒","text":"平生壮节终难变，投老浮名信所遭。\n要路争先宁遽福，从来率野屈吾曹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50944,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戊寅正月八日早寒","author":"张耒","text":"浓淡春云夜雨乾，寂寥庭院裌衣寒。\n无人为发樽前笑，但把梅花似旧看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50945,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"末伏日五更小凉","author":"张耒","text":"幽人短梦不终宵，起步星河望泬寥。\n缺月低檐鸡一唱，露华秋色满芭蕉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50946,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"正月二十五日以小疾在告作三绝是日苦寒 其二","author":"张耒","text":"春色三分有尚多，且饶芳草占高坡。\n门前柳色如彭泽，争奈陶君止酒何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50947,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"正月二十五日以小疾在告作三绝是日苦寒 其三","author":"张耒","text":"见说樱桃已烂开，坐愁风雨苦相催。\n自怜华发伤春客，两见飞花未放回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50948,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"正月二十五日以小疾在告作三绝是日苦寒 其一","author":"张耒","text":"黄土冈头荠麦长，春阴蔽日午风狂。\n山前梅落无人见，只有幽禽啼暗香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50949,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"正月十八日四首 其四","author":"张耒","text":"山下书生业读书，荻篱葛蔓避人居。\n最怜无奈穷耽酒，时遣羸童致一壶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50950,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"正月十八日四首 其三","author":"张耒","text":"道旁兰若冷于秋，迎客开门一比丘。\n夜久无人风露冷，空廊饥鼠窃膏油。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50951,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"正月十八日四首 其二","author":"张耒","text":"收灯城市接荒村，翁媪耽眠日已暾。\n何事牧童能早起，缓驱白牯出柴门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50952,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"正月十八日四首 其一","author":"张耒","text":"幽人睡足闻春鸟，共喜晖晖日满篱。\n里巷收灯人寂寞，邻家夫妇赁舂归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50953,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"永宁赴晁应之见招赏花途中遇雨","author":"张耒","text":"行云浓淡日无辉，轻雨飘飘点客衣。\n马上漫郎醒复醉，一杯容易送春归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50954,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"生日赠潘郎","author":"张耒","text":"春雨萧萧江上城，论花与子酒同倾。\n恨君未到淮阳市，一见姚黄慰此生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50955,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"田家二首 其一","author":"张耒","text":"门外清流系野船，白杨红槿短篱边。\n旱蝗千里秋田净，野秫萧萧八月天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50956,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"立春三首 其三","author":"张耒","text":"苍龙阙角回金斗，文德门南散晓班。\n车马纷纷残雪里，镂银剪綵舞新幡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50957,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"立春三首 其二","author":"张耒","text":"风光先著竹间梅，和气应从九地回。\n桃李满园浑未觉，微红先向宝刀开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50958,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"立春三首 其一","author":"张耒","text":"天上春来谁报人，江山气象一时新。\n懒将白首簪幡胜，寿酒三杯慰逐臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50959,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"立秋二首 其二","author":"张耒","text":"对酒聊同楚人醉，哦诗惟听越吟声。\n洞庭北岸孤城下，落月西风听晓莺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50960,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"立秋二首 其一","author":"张耒","text":"西风袅袅木飕飕，身在江湖北岸州。\n自古楚人词最好，为君重赋竟陵秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50961,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"伤春","author":"张耒","text":"浮云冉冉送春华，怯见春寒日欲斜。\n一夜雨声能几许，晓来落尽一城花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50962,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"伤春四首 其四","author":"张耒","text":"高楼春昼独惊心，白日閒云亦自阴。\n风雨催花花已尽，满城新绿乱鸣禽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50963,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"伤春四首 其三","author":"张耒","text":"嫩紫妖红惜不得，乱随风雨点蓬蒿。\n荒田野草花开晚，主管春光输尔曹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50964,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"伤春四首 其二","author":"张耒","text":"红杏墙头最可怜，腻红娇粉两娟娟。\n晓来并逐东风尽，容易分飞又一年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50965,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"伤春四首 其一","author":"张耒","text":"晓雨催春不惜花，乱红飘泊委泥沙。\n伤心忆得年时事，白发风前只叹嗟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50966,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再谢周颙之句","author":"张耒","text":"烟飞小玉吴王国，柳暗朱楼铁瓮城。\n见说周颙经案外，亦闻荀粲并床声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50967,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同仲达雪后踰小山游蔡氏园得红梅数枝奇绝因赋二首 其二","author":"张耒","text":"北风凛凛留高树，融雪涓涓聚小塘。\n三亩山园半春草，无人为结小丁香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50968,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同仲达雪后踰小山游蔡氏园得红梅数枝奇绝因赋二首 其一","author":"张耒","text":"与君陟巘踏春泥，邂逅红梅得一枝。\n失却孤山风露格，却成卯酒醉冰肌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50969,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戏作雪狮绝句","author":"张耒","text":"六出装来百兽王，日头出后便郎当。\n争眉霍眼人谁怕，想你应无熟肺肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50970,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戏呈希古","author":"张耒","text":"半世辛勤守黄卷，白头容易过青春。\n枕前亦觉春晴否，试问东邻晚起人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50971,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"成帝","author":"张耒","text":"百华衣上渍馀香，夜照犹烦蚌有光。\n解道温柔胜武帝，不知壮发似元皇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50972,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"早起二首 其二","author":"张耒","text":"风鸣槁叶未辞枝，雨湿疏梅欲弄姿。\n地下一阳应蹀躞，世间浑未有人知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50973,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"早起二首 其一","author":"张耒","text":"沧江初夜雨翻盆，将晓风声战乱云。\n篱下寒鸡鸣晓苦，老人先起自开门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50974,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"有所叹","author":"张耒","text":"骈胁当车闟戟先，相君冠盖照秦川。\n六雄未灭君无苦，当念杜门公子虔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50975,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"有感","author":"张耒","text":"鬓毛已自秋来变，髀肉仍于马上消。\n满眼青山不归去，强颜微禄亦何聊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50976,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"有感二绝 其一","author":"张耒","text":"残雪微风冷透衣，柳黄梅破欲春时。\n年年景物常相似，满眼相思只自知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50977,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"有感二绝 其二","author":"张耒","text":"日暇凝云去复还，晚风不动自清寒。\n可怜庭雪无人扫，斜占墙阴独未残。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50978,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"朱云","author":"张耒","text":"直言请剑斩安昌，勿谓朱游只素狂。\n君看汉家文景业，张侯能以一言亡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50979,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杂诗二首 其二","author":"张耒","text":"病腹难禁七椀茶，小窗睡起日西斜。\n贫无隙地栽桃李，日日门前自买花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50980,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟中听大人弹琴","author":"苏轼","text":"弹琴江浦夜漏永，敛衽窃听独激昂。\n风松瀑布已清绝，更爱玉佩声琅珰。\n自从郑、卫乱雅乐，古器残缺世已忘。\n千家寥落独琴在，有如老仙不死阅兴亡。\n世人不容独反古，强以新曲求铿锵。\n微音淡弄忽变转，数声浮脆如笙簧。\n无情枯木今尚尔，何况古意堕渺茫。\n江空月出人响绝，夜阑更请弹《文王》。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50981,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杂题二首 其二","author":"张耒","text":"苍苍落月井梧西，睡觉幽人自卷帷。\n只有林莺知梦断，晓庭人静语移时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50982,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杂题二首 其一","author":"张耒","text":"寒雨萧萧桐叶惊，浪浪还作夜阶声。\n西风忽起幽人觉，枕簟凉时向五更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50983,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵子由舍人先生追读迩英绝句四首 其四","author":"张耒","text":"恭默谁聆金玉音，陶甄万物付无心。\n君王好学真天意，忧国论思不厌深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50984,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵子由舍人先生追读迩英绝句四首 其三","author":"张耒","text":"冠佩煌煌拱北辰，道人风骨自轩轩。\n茯苓松下龟鼋老，须乞灵丹一粒吞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50985,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵子由舍人先生追读迩英绝句四首 其二","author":"张耒","text":"联翩右史直西垣，旧墨螭头点未乾。\n自是退之平昔事，可须惭著进贤冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50986,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵子由舍人先生追读迩英绝句四首 其一","author":"张耒","text":"天寒书殿晓班清，气爽仙盘瑞露零。\n讲罢群公佩声散，一竿宫日转槐庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50987,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵王彦昭感秋三首 其三","author":"张耒","text":"尘埃容易点吴衣，泽国秋来信息稀。\n想见淮南初木落，秋云秋水雁初飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50988,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵王彦昭感秋三首 其二","author":"张耒","text":"年来诗酒最关身，满酌休论薄与醇。\n愁见洛阳秋夜月，无情偏照不眠人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50989,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵王彦昭感秋三首 其一","author":"张耒","text":"木落风高秋雁归，初晴野水涨清伊。\n东流会向淮南去，凭寄秋来无限悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50990,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵智叔三首 其三","author":"张耒","text":"今朝一见诗人诗，不用更寻黄绢词。\n深山一鹤自唱和，亦有松下童子知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50991,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵智叔三首 其二","author":"张耒","text":"公子风流更可人，仙家问讯柳湖春。\n烦公瓮下一杯水，洗我胸中百斛尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50992,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵智叔三首 其一","author":"张耒","text":"才似庖刀不待硎，思如流水更清泠。\n诗坛李杜谁为将，尽扫欃枪正国刑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50993,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江上二首 其二","author":"张耒","text":"纷纷浑是梦，黯黯只消魂。\n江上浪无限，舟中酒一樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50994,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江上二首 其一","author":"张耒","text":"相别亦何事，相逢尽偶然。\n愁肠贯綵笔，离梦绕朱弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50995,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自二月末苦雨寒食前一日始晴视园中花乃殊不败","author":"张耒","text":"春云霮䨴弄朝晖，清峭馀寒透裌衣。\n最喜园花浑似旧，十分春色一分归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50996,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自上元后閒作五首 其五","author":"张耒","text":"喧喧野县自笙歌，风卷高云天似波。\n谁谓楼前明月好，月明多处客愁多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50997,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自上元后閒作五首 其四","author":"张耒","text":"灯火人家夜不收，三更明月过南楼。\n风烟随处自能乐，何事客心还独愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50998,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自上元后閒作五首 其三","author":"张耒","text":"面冷春霜拂瓦乾，晓风吹雨冻阑干。\n柳梢黄弱梅苞破，更放东君几日寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50999,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自上元后閒作五首 其二","author":"张耒","text":"东风吹雨夜侵阶，楼角长烟晓未开。\n何事旧时愁意绪，一番春至一番来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51000,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自上元后閒作五首 其一","author":"张耒","text":"阊阖楼南粉署西，旧时种柳长应齐。\n如今冷落穷山县，卧听春风百鸟啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51001,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自遣四首 其四","author":"张耒","text":"浮世荣枯理易观，不劳重取朽龟钻。\n直应桃李繁华日，便把荆榛寂寞看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51002,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自遣四首 其三","author":"张耒","text":"谁云至理宗无相，大道由来万法兼。\n且以声音为佛事，晓敲清磬诵华严。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51003,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自遣四首 其二","author":"张耒","text":"谁云造化本无情，利害乘除理甚平。\n莫逐众情生愠喜，君看三四孰亏盈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51004,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自遣四首 其一","author":"张耒","text":"是非得失一区区，蚊蚋啾啾共一壶。\n不学退之求羽翼，惟凭一梦到华胥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51005,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"至后早赴馆二首 其二","author":"张耒","text":"城围残雪寒催晓，宫近晴云暖欲春。\n谁觉风光添一线，玉壶漏水报鸡人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51006,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"至后早赴馆二首 其一","author":"张耒","text":"红蜡妆梅冷未黏，柳条偷暖作纤纤。\n高楼残白谁家雪，尽日天寒不捲帘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51007,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟行六绝 其一","author":"张耒","text":"猎猎西风秋水清，野花寒草傍流生。\n沙边水鹤待鱼立，石底暗蛩先夜鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51008,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟行六绝 其三","author":"张耒","text":"落景秋云晚不开，天寒古岸野船回。\n初惊波面微澜起，已觉风前细雨来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51009,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟行六绝 其四","author":"张耒","text":"渡头风雨晚生寒，蓑笠渔翁坐钓船。\n为问篷中有鱼否，一双新鳜出笼鲜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51010,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟行六绝 其五","author":"张耒","text":"天寒野店断人行，晚系孤舟浪未平。\n半夜西风惊客梦，卧听寒雨到天明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51011,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西江","author":"张耒","text":"拂瓦轻霜铅粉轻，东南日出竹窗明。\n小楼下见西江水，日日风光无限情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51012,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]