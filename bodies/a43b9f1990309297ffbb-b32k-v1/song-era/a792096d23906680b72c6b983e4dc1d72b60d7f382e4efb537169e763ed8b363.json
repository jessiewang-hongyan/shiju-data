[{"title":"偈颂一百三十六首 其一○四","author":"释惟一","text":"一月复一月，此月又过五。\n两轮日月何奔忙，百年弹指如虚度。\n物不迁，还知否。\n不是佛，亦非祖。\n流水不腐，户枢不蠹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17859,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其一○三","author":"释惟一","text":"薰风南来，凉生殿阁。\n诸佛出身处，昭昭在心目。\n当机觌面回避无门，只要诸人披襟领略。\n其或未然，开眼也著，合眼也著。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17860,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其一○二","author":"释惟一","text":"二月初五，群花竞吐。\n或逞夭红，或誇雅素。\n月下精神，风前态度，明明祖意无回互。\n堪悲堪笑老灵云，错认桃花作眼睛，至今犹自不惺惺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17861,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其一○一","author":"释惟一","text":"初二出城，归来初五。\n十字街头撞见张三，元是山前旧时李四。\n面目如前，语言如故。\n再三道佛法浇漓，众生难度。\n不必按牛头吃草，不用将针合成斧。\n甜瓜彻蒂甜，苦瓠连根苦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17862,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其一○○","author":"释惟一","text":"衲僧家，无本据。\n鉴在机先，妙在转处。\n问沤堂上半座平分，集云峰前孤风绝侣。\n看看九万抟扶摇，垂天之翅摩云霄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17863,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其九十九","author":"释惟一","text":"四叶红莲，一音宣演。\n其语巧妙，其义深远。\n前印威音，一点不差，后證弥勒，不差一点。\n离四句，绝百非，即不无。\n只如一人恁么，一人不恁么，一人恁么中不恁么，一人不恁么中却恁么，又且如何。\n造作不同，一般米面。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17864,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其九十八","author":"释惟一","text":"集云不会禅，不会道。\n横画不识，竖画不晓。\n日里三餐，夜后一觉。\n年来老且病，转见不唧?。\n裙子褊衫个也无，袈裟形相些些有。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17865,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其九十七","author":"释惟一","text":"万法本无，一心何有。\n绝虑忘缘，默默自守。\n傥能朝于斯夕于斯，自然虚而灵空而妙。\n正当恁么时，我手何似佛手。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17866,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其九十五","author":"释惟一","text":"九月授衣，无衣可受。\n衲僧门下，别有要妙。\n新糊纸被烘来暖，一觉和衣到五更。\n闻得上方钟鼓动，又添一日在浮生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17867,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其九十三","author":"释惟一","text":"八月秋，何处热。\n稻花吹香，疏林减叶。\n三点五点不时雨，一声两声何处笛。\n若向这里，闻无有闻，證入圆通，斯为第一。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17868,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其九十二","author":"释惟一","text":"佛灭二千有馀载，五逆儿孙浑不采。\n一夜雷轰雨霶霈，诸天亦为之叵耐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17869,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其九十一","author":"释惟一","text":"仰山上元令节，笙歌且靠一壁。\n雪晴山色挼蓝，冻解溪流濑石。\n满眼看不尽，满耳听不彻。\n诸人若向这里知归，不须更授然灯记别。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17870,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其九十","author":"释惟一","text":"飞雪亭前，宜春台上。\n物有万殊，春无两样。\n住不顾去底，犹欠劈面拳。\n去不顾住底，好与拦腮掌。\n直饶去住两忘，如龙似象。\n未免卸下衲衣，连挥痛棒。\n棒折也不放，是罚是赏。\n为人须为彻，杀人须见血。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17871,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其八十八","author":"释惟一","text":"今朝腊月二十五，明朝腊月二十六。\n风前唱起仰山歌，人皆道是云门曲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17872,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其八十七","author":"释惟一","text":"谈玄谈妙，将油洗皂。\n行棒行喝，剜肉成疮。\n诸方多是誇张作说，集云只据见定商量。\n年年九日是重阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17873,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其八十六","author":"释惟一","text":"雁入高空，蛩吟古砌。\n剧谈不二门，单明第一义。\n瞎却眼，塞却耳。\n听得分明见得亲，不必龙华亲授记。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17874,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其八十五","author":"释惟一","text":"宝剑出匣，精金跃冶。\n色泽星辉，光芒斗射。\n投之重津而光愈发越，加之烈火而色无少假。\n行为人间报不平，定应索起辽天价。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17875,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其八十四","author":"释惟一","text":"赤肉团上，有一无位真人。\n眼里耳里，鼻里口里，频频出入，出入频频。\n能言能唤，能屈能伸。\n能好能恶，能喜能嗔。\n诸人若也未曾證据，便请證据，集云今日为汝保任。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17876,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其八十三","author":"释惟一","text":"六月中夏，诸方放假。\n大仰不然，绳头紧把。\n常住百无一有不能挂怀，只忧兄弟不会狗子无佛性话。\n常啼菩萨卖心肝，风前狼籍谁人买。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17877,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其八十一","author":"释惟一","text":"六年雪岭几番雪，不是今番彻骨寒。\n半夜三更禁不得，无端北斗面南看。\n瞿昙瞿昙，开得眼来天大晓，不知红日已三竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17878,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其八十","author":"释惟一","text":"九秋强半，不寒不暖。\n风细细雨霏霏，水冷冷云淡淡。\n一棹烟波，芦花两岸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17879,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其七十八","author":"释惟一","text":"三玄三要，五位君臣。\n说偏说正，分主分宾。\n未免重添眼里尘。\n尽情划断，空阔无垠。\n孤鸿杳杳知何处，门外萧萧落叶频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17880,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其七十七","author":"释惟一","text":"意句俱到，不入深村入荒草。\n意句不到，珊瑚树林日杲杲。\n只如一言道尽，意况不及时如何。\n到江吴地尽，隔岸越山多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17881,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其七十六","author":"释惟一","text":"一结一切结，一解一切解。\n结解两忘，通身潇洒。\n绝潇洒，脱罗笼。\n巨鱼纵大壑，一雁入高空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17882,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其七十五","author":"释惟一","text":"摩耶昔产一块铁，无可名之名悉达。\n拟铸金躯铸不成，无端铸成一大错。\n错错，至今累我东土人，年年转洗转埃尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17883,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其七十四","author":"释惟一","text":"含笑吟吟，怀毒深深。\n左搓芒绳生缚鬼子，倒拈蝎尾殃害平人。\n我虽蹉脚跨他门，幸不遭他毒气熏。\n如何见得，只此为凭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17884,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其七十三","author":"释惟一","text":"一明一切明，一了一切了。\n道无不是无，道有元非有。\n毗婆尸佛早留心，直至如今不得妙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17885,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其七十二","author":"释惟一","text":"心不是佛，智不是道。\n抛却深村，又入荒草。\n只如以一重去一重，不知转交涉转料掉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17886,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其七十一","author":"释惟一","text":"春雪乍晴，春光愈好。\n不必远讨幽探，不用谈空说有。\n村村自花柳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17887,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其七十","author":"释惟一","text":"这里如大火聚，近之则燎却面门。\n直饶佛祖到来，未免退身有分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17888,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其六十六","author":"释惟一","text":"此事没誵讹，人人不柰何。\n柰何不得处，合眼跳黄河。\n跳得后如何，元来佛法苦无多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17889,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其六十五","author":"释惟一","text":"诸佛不出世，亦无有涅槃。\n年年二月半，枉自衔悲酸。\n此意只今谁共委，令人拍碎玉栏干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17890,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其六十四","author":"释惟一","text":"百丈开田说大义，究竟宁免费脚手。\n松溪修田无可说，击鼓升堂但良久。\n知事头首俱欢颜，见者闻者皆失笑。\n好篇大义，一字不少。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17891,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其六十三","author":"释惟一","text":"名不得，状不得。\n取不得，舍不得。\n不可得，只么得。\n赵州东壁挂葫芦，观音院里有弥勒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17892,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其六十二","author":"释惟一","text":"摩诃衍法，离四句绝百非。\n香饭普熏，遍十方穷三际。\n我此一众，总是诸方罗笼不住底。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17893,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其六十一","author":"释惟一","text":"雨滴空阶，溪流新涨。\n风起天末，叶坠疏林。\n唤作物却非物，唤作心不是心。\n缺齿老胡会不得，九年面壁空沉吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17894,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其五十八","author":"释惟一","text":"一著高一著，一步阔一步，堕在平常。\n一著亚一著，一步却一步，失在巇崄。\n二俱不涉，七达八通。\n龙袖拂开全体现，象王行处绝狐踪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17895,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其五十七","author":"释惟一","text":"佛来不顾，祖来不顾。\n有三十棒，未敢分付。\n个中无肯路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17896,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其五十六","author":"释惟一","text":"风萧萧，雨萧萧。\n山云漠漠，庭叶飘飘。\n普天匝地，祖意活鱍鱍。\n满眼满耳，心印何昭昭。\n便与么去，衲僧门下，大故相辽。\n行到水穷山尽处，可中别有路通霄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17897,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其五十五","author":"释惟一","text":"人间月半，天上月圆。\n幸自一天明朗，何须万斛金莲。\n诸人睡眼豁开见得分晓，不起于座即超于然灯之前。\n其或未然，灯节元来是上元。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17898,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其五十四","author":"释惟一","text":"照而常寂，寂而常照。\n滟滪云开，玲珑月皎。\n巍巍玉殿与琼楼，已见翚飞拄杖头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17899,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其五十三","author":"释惟一","text":"今日如是，明日如是。\n一日复一日，一年复一年。\n百千万亿年，究竟只如是。\n月落乌啼霜满天，纷纷黄叶飘庭际。\n善男子起，法性如是。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17900,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其五十二","author":"释惟一","text":"古佛心，即如今。\n桂香满院，叶坠疏林。\n水沉寒雁影，露冷夜蛩吟。\n明眼衲僧会不得，江北江南徒访寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17901,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其五十一","author":"释惟一","text":"涅槃心，差别智。\n明之既难，会之不易。\n如千手异执千目异顾元同一身，似万派争流百川竞注皆归一水。\n差之毫釐，谬以千里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17902,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其五十","author":"释惟一","text":"雨注河倾，共谈无义。\n陈蒲鞋倒退三千，睡虎子让一头地。\n有问如何若何，不能以手夹鼻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17903,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其四十九","author":"释惟一","text":"诸人不是不将来，老僧不是不分付。\n将来既是分明，分付亦非莽卤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17904,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其四十八","author":"释惟一","text":"踞此室，坐此座。\n佛来祖来，一一按过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17905,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其四十七","author":"释惟一","text":"我与黄面老汉，有千古不忘之恨，甚欲烂槌一顿。\n今日因甚放过，老不以筋力为能。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17906,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其四十六","author":"释惟一","text":"岁尽年穷，多少人脚忙手乱，惟有宝峰恬然不管。\n来年更有新条在，恼乱春风卒未休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17907,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其四十五","author":"释惟一","text":"瞿昙未解这一著，雪岭六年空卜度。\n不知眼病见空花，认作明星一何错。\n自累犹可，更累儿孙。\n珊瑚枕上两行泪，半是思君半恨君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17908,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其四十四","author":"释惟一","text":"雨暗西山，云飞南浦。\n老卢仙腰缠骑鹤，朝度黄茅八凸。\n独秀峰草木泉石为之鼓舞。\n因甚如此，家贫愿邻富。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17909,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其四十二","author":"释惟一","text":"一月在天，影含众水。\n只如双剑峰头月，何似芙蓉溪上月。\n芙蓉溪上月，何似泐潭潭底月。\n若道同，东西各一涯，若道别，天无第二月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17910,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其四十一","author":"释惟一","text":"五五午时书，妖邪尽扫除。\n一堂风悄悄，千古意如如。\n蒲饮先春雪，粽餐明月珠。\n舌头如具眼，醉饱乐无馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17911,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其四十","author":"释惟一","text":"细不可减，大无以加。\n近在眼睫，远过天涯。\n是著即错，拟之又差。\n缺齿老胡会不得，空携只履返流沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17912,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其三十九","author":"释惟一","text":"去从闹市红尘去，归向白云深处归。\n因甚更无迎与送，去来寸步不曾移。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17913,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其三十八","author":"释惟一","text":"这老冻侬，惺惺懵懂。\n分明无一丝毫，刚道有三斤重。\n只知恁么脱空相诳，不知其雠甚于戴天之不共。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17914,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其三十七","author":"释惟一","text":"春风料峭，春雨连绵。\n桃花逐浪，新竹笼烟。\n香严已往灵云去，一度春深一怆然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17915,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其三十六","author":"释惟一","text":"六年雪岭竟无成，练得身形似鹤形。\n尽谓见明星悟道，何曾悟道见明星。\n入山何富，出山何贫，知心能几人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17916,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其三十五","author":"释惟一","text":"昨从天上去，元不离地下。\n今归地下来，亦不离天上。\n上下无间，来去无差。\n天河秋一雁，砧杵夜千家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17917,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其三十四","author":"释惟一","text":"今朝解制，且作么生。\n从前约束，一槩放行。\n万里秋天飞一鹗，东西南北任纵横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17918,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其三十二","author":"释惟一","text":"开门待知识，知识喜来过，两两不成双，一一无回互。\n共卧不共床，同行不同步。\n昭然在目前，目前不可睹。\n虽则不可睹，我独知其故。\n圣容菩萨来西天，卢仙夏人在东土。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17919,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其三十一","author":"释惟一","text":"德山拆殿，宝峰烧香。\n二俱不恶，一种不臧。\n瞿昙元自面皮黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17920,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其三十","author":"释惟一","text":"无禅不参，无道可学。\n只责诸人如醉而醒，如梦而觉。\n醉既醒，梦既觉。\n虽然只是旧时人，却与旧时相辽邈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17921,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其二十九","author":"释惟一","text":"夏热乘凉，冬寒向火。\n自古自今，总恁么过。\n不知二祖立雪齐腰，毕竟图个什么。\n以吾之不可，学柳下惠之可。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17922,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其二十八","author":"释惟一","text":"昼也惺惺，夜也惺惺。\n既不掉举，亦不昏沉。\n何须求白玉，只此是黄金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17923,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其二十七","author":"释惟一","text":"狮子吼，无畏说，百兽闻之皆脑裂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17924,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其二十六","author":"释惟一","text":"今朝结制，号令宜先。\n三章约法，普示人天。\n身不可妄动，亦不可块然。\n口不可妄开，亦不可默然。\n意不可妄举，亦不可罔然。\n依如是行如是住，圆觉伽蓝常现前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17925,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]