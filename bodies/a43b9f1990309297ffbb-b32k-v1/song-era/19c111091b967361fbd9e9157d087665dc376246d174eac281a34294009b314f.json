[{"title":"舍鞋","author":"释慧开","text":"验尽脚跟长与短，个中宽窄已先知。\n自从蹈著这些子，左右逢原显大机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21616,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"郁山主赞","author":"释慧开","text":"百尺竿头话最亲，一交桥断绝纤尘。\n死中得活珠离蚌，甘作驴前马后人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21617,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南剑州伏虎岩请师开山请赞","author":"释慧开","text":"个样村僧，也甚奇怪。\n身如椰子，胆似天大。\n蟒蛇窟里安禅，猛虎穴中劄寨。\n无端于微尘国里，转大法轮，击大法鼓。\n却向刀山剑树上，成等正觉，弄者一解。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21618,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"思大禅师赞","author":"释慧开","text":"一生讨头不见，二生骨露皮穿。\n三生造成地狱，全身活陷黄泉。\n七十二峰俱坐断，口吞佛祖在机先。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21619,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"持二十五轮顶弥陀蹈莲叶赞","author":"释慧开","text":"机轮才转，作者犹迷。\n顶?一著，独弄单提。\n自从蹈得这些子，便向风波险处施。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21620,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"持珠坐石赞","author":"释慧开","text":"手轮摩尼珠，身坐盘陀石。\n普请大地人，念彼观音力。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21621,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"退步","author":"释慧开","text":"未曾移定时，前脚让后脚。\n只这一步子，谁人蹈得著。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21622,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贺吴丞相生日","author":"释慧开","text":"大地春回是诞辰，松篁难改四时青。\n寿星不老福无尽，常在中天伴月明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21623,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"圆通大士赞","author":"释慧开","text":"足蹈双莲洒杨柳，面目端严世希有。\n梵音妙音海潮音，祇这而今谁动口。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21624,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"徒弟普山请赞","author":"释慧开","text":"头发鬔松，耳轮卓朔。\n踞坐当轩，权衡在握。\n任你德山临济棒喝交驰，到他面前一点用不著。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21625,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"徒弟普显请赞","author":"释慧开","text":"形如枯木倚岩隈，不拟天庭降蛰雷。\n忽遇东君行正令，昙华独显一枝开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21626,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"请行新桥","author":"释慧开","text":"云根架就笑谈中，凡圣如今一路通。\n个个脚跟亲蹈著，人人足下起清风。\n不似天台滑石，半巇半崄。\n胜如赵州略彴，度马度驴。\n虽然欲行千里，要知一步为初。\n从兹不用频题柱，来往都乘驷马车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21627,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"铁壁","author":"释慧开","text":"巍然一座黑金城，缝罅全无及户扃。\n堪笑英雄难进步，圣凡到此绝途程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21628,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十八首 其四十八","author":"释慧开","text":"未举步时先已到，未动舌时先说了。\n直饶著著在机先，更须知有向上窍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21629,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十八首 其四十七","author":"释慧开","text":"一念普观无量劫，无量劫事即如今。\n如今觑破个一念，觑破如今觑底人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21630,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十八首 其四十六","author":"释慧开","text":"瞎却顶门眼，错认定盘星。\n拚身能舍命，一盲引众盲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21631,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十八首 其四十四","author":"释慧开","text":"诸方深与浅，都在掌握中。\n撑天并拄地，随处振宗风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21632,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十八首 其三十八","author":"释慧开","text":"过去堕坑堑，回来却被坏。\n者些尾巴子，直是甚奇怪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21633,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十八首 其三十四","author":"释慧开","text":"天晴日头出，雨下地上湿。\n尽情都说了，只恐信不及。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21634,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十八首 其二十六","author":"释慧开","text":"卷起明明彻太空，太空犹未合吾宗。\n争似从空都放下，绵绵密密不通风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21635,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十八首 其二十四","author":"释慧开","text":"不露风骨句，未语先分付。\n进步口喃喃，知君大罔措。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21636,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十八首 其二十一","author":"释慧开","text":"闪电光，击石火。\n眨得眼，已蹉过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21637,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十八首 其二十","author":"释慧开","text":"抬脚踏翻香水海，低头俯视四禅天。\n一个浑身无处著，请续一句。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21638,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十八首 其十九","author":"释慧开","text":"春有百花秋有月，夏有凉风冬有雪。\n若无闲事挂心头，便是人间好时节。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21639,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十八首 其十三","author":"释慧开","text":"识得最初句，便会末后句。\n末后与最初，不是者一句。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21640,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十八首 其十一","author":"释慧开","text":"眼流星，机掣电。\n杀人刀，活人剑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21641,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十八首 其七","author":"释慧开","text":"只为分明极，翻令所得迟。\n早知灯是火，饭熟已多时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21642,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十八首 其三十六","author":"释慧开","text":"路逢达道人，不将语默对。\n拦腮劈面拳，直下会便会。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21643,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十八首 其五","author":"释慧开","text":"香严真杜撰，恶毒无尽限。\n哑却衲僧口，通身迸鬼眼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21644,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十八首 其十五","author":"释慧开","text":"狮子教儿迷子诀，拟前跳踯早翻身。\n无端再叙当头著，前箭犹轻后箭深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21645,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十八首 其三","author":"释慧开","text":"俱胝钝置老天龙，利刃单提勘小童。\n巨灵抬手无多子，分破华山千万重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21646,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十七首 其八十七","author":"释慧开","text":"烂柴头，火一团。\n急著眼，莫颟顸，星在秤兮不在盘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21647,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十七首 其四","author":"释慧开","text":"一著高一著，一步阔一步。\n拨转上头关，乾坤全体露。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21648,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十七首 其五十八","author":"释慧开","text":"六月炎炎如火聚，寂然不动于中住。\n炎炎火聚却清凉，清凉却是炎炎处。\n等闲坐断两头关，撞墙撞壁通霄路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21649,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十七首 其十八","author":"释慧开","text":"休分廛市与山间，静闹闲忙著眼看。\n静闹二途俱泯绝，如珠辘辘走金盘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21650,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十七首 其四十一","author":"释慧开","text":"拨转玄关，一弹指顷。\n看看平地起风云，门近洪崖千尺井。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21651,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十七首 其九","author":"释慧开","text":"闹市门头，有一句子。\n摆手出漳江，全身在里许。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21652,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十七首 其三十七","author":"释慧开","text":"参禅要真实，直造无疑地。\n闻非未必非，说是未必是。\n黄龙设三关，曹洞列五位。\n坐断主人公，且不落第二。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21653,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十七首 其五十五","author":"释慧开","text":"黄龙结制没规绳，超过诸方半月程。\n莫怪七颠并八倒，大家日午打三更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21654,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十七首 其二十二","author":"释慧开","text":"遇缘即宗云从龙，随处作主风从虎，大地撮来无寸土。\n倒岳倾湫，兴云致雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21655,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十七首 其七十七","author":"释慧开","text":"天阴性地昏，日出心光耀。\n拄杖笑呵呵，禅床也?跳。\n管甚岁馀闰，一任月大小。\n淈?几春秋，用处非常峭。\n可怜五十三知识，未曾梦见顶门窍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21656,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十七首 其五十一","author":"释慧开","text":"赞叹无门，也是这个。\n骂詈无门，也是这个。\n文彩未彰谁辨得，却烦首座通消息。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21657,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十七首 其十九","author":"释慧开","text":"一镞破三关，坐断江西路。\n佛祖到头俱罔措，至竟全凭这一步。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21658,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十七首 其六十六","author":"释慧开","text":"现种种形，说种种法。\n形法皆非，假名菩萨。\n更于诸相觅圆通，当人正眼俱戳瞎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21659,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十七首 其四十七","author":"释慧开","text":"无门为法门，三关何用立。\n熟处既难忘，又从这里入。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21660,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十七首 其二十六","author":"释慧开","text":"五日一番，赴个程限。\n有道可谈，有法可演。\n不顾碎身如微尘，只要瞎却众生眼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21661,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十七首 其五十四","author":"释慧开","text":"八两还他是半斤，陈年桃核旧时仁。\n大家出手共提掇，行看丛林气象新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21662,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十七首 其十三","author":"释慧开","text":"夫子眼睛，瞿昙巴鼻。\n不是四六文章，亦非仁义礼智，普请大家齐侧耳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21663,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十七首 其七十九","author":"释慧开","text":"威镇戎夷，扫清魔孽。\n群灵归敬，忠心如铁。\n破蔡灭金，守黄剿贼。\n雪百年二帝难雪之耻，成中兴四将未成之业。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21664,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十七首 其五十六","author":"释慧开","text":"薰风自南来，殿阁生微凉。\n百年浑似醉，三万六千场。\n休拟议，莫思量。\n锦鳞一跃化龙去，无限痴人戽夜塘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21665,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十七首 其四十六","author":"释慧开","text":"翠岩绝崄巇，元不涉阶梯。\n去来无窒碍，彼此更何疑。\n珍重洪源湖海众，个中不隔一毫釐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21666,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十七首 其三十三","author":"释慧开","text":"天下法窟丛林，四月初一结制。\n无门逐恶随邪，要效死心旧例，普请诸人脑门著地。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21667,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十七首 其四十","author":"释慧开","text":"春山叠乱青，春水漾虚碧。\n春光漏泄尽，谁识春消息。\n多年枯木再抽枝，撼动春风生八极。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21668,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十七首 其五","author":"释慧开","text":"昔年曾向山中去，千手大悲拦不住。\n今朝又向山中来，优昙华向半天开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21669,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十七首 其六十一","author":"释慧开","text":"动弦别曲，叶落知秋。\n禾山打鼓，雪峰辊毬。\n睦州担板，投子提油。\n赵州狗子，沩山牯牛。\n青原垂足，俱胝指头。\n一队破落户，各自逞风流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21670,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十七首 其六十四","author":"释慧开","text":"阴极阳生，日添一线。\n独有山僧拄杖子，不属阴阳迁变。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21671,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十七首 其十","author":"释慧开","text":"稽首老瞿昙，担头入闹蓝。\n炷香三拜了，天上与人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21672,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十七首 其八十二","author":"释慧开","text":"元正启祚，万物咸新。\n衲僧拄杖黑■皴，不属阴阳别是春。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21673,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十七首 其五十二","author":"释慧开","text":"不动脚头，青云独步。\n个是寻常行履处，须知更有通霄路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21674,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十七首 其六十二","author":"释慧开","text":"布袋头开今日始，满目江山秋色里。\n蓦然踏断草鞋跟，元来却是自家底。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21675,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十七首 其七十六","author":"释慧开","text":"老来无日不思闲，深隐西湖第一山。\n无奈退庵贤制置，远移公帖入松关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21676,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十七首 其四十二","author":"释慧开","text":"死心室内，移身移步。\n日日香灯，朝朝话堕。\n稽首齐安王，铁蛇横大道。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21677,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十七首 其二十","author":"释慧开","text":"殿里底是什么，千百化身无处讨。\n礼拜烧香，不勘自破。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21678,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十七首 其五十三","author":"释慧开","text":"掣断绳头欲自由，那知定业未容休。\n再偿拽杷拖犁债，鼓得西江水逆流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21679,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十七首 其五十九","author":"释慧开","text":"石跟常有千年润，海眼曾无一日乾。\n天下苍生待霖雨，不知龙向此间蟠。\n霹雳一声头角露，倾湫倒岳鼓波澜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21680,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十七首 其六十三","author":"释慧开","text":"信脚行去绝埃尘，信手拈来用得亲。\n信口道出惊天地，信心悟入独超群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21681,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十七首 其三十","author":"释慧开","text":"掀翻大地，打破虚空。\n口吞佛祖，凌蔑宗风。\n莫笑黄龙无伎俩，熨斗煎茶铫不同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21682,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十七首 其二十九","author":"释慧开","text":"格外一机，万灵莫测。\n向上一著，千眼难窥。\n青山白云父，白云青山儿。\n春风二三月，桃李自成蹊，笑杀灵云道不疑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21683,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十七首 其四十三","author":"释慧开","text":"春山叠乱青，春水漾虚碧。\n寥寥天地间，满眼皆相识。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21684,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十七首 其六十七","author":"释慧开","text":"咄这乾屎橛，生来太妖孽。\n堪笑老云门，一棒打不杀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21685,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十七首 其七十五","author":"释慧开","text":"铜沙锣里满盛油，故国山河在眼头。\n试向凤凰台上望，长江无日不东流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21686,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十七首 其七十八","author":"释慧开","text":"灵山大法王，末运希所遇。\n声名遍天下，乾坤恣独步。\n草鞋挂龙床，三宣浑不顾。\n凌灭曹源生，训徒参活句。\n宗门个样师，熟不生恋慕。\n天庭重降敕黄来，凌霄峰顶施甘露。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21687,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十七首 其三十四","author":"释慧开","text":"兜率未离尘满面，王宫才降垢通身。\n儿孙纵有沧浪水，洗到驴年也不清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21688,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十七首 其五十","author":"释慧开","text":"不是护身符，亦非断贯索。\n直饶鼻孔辽天，也被这个穿却。\n无门老汉还免得么，却请维那下个注脚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21689,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十七首 其二十七","author":"释慧开","text":"日月循环成底事，衲僧切忌眼麻迷。\n直饶透彻威音外，也落侬家第二机。\n急荐取，莫迟疑。\n坐看东君行正令，大鹏一举到天池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21690,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"馄饨","author":"释慧开","text":"宽著肚皮急叉手，镬汤里面翻筋斗。\n浑身糜烂转馨香，那个禅和不开口。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21691,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]