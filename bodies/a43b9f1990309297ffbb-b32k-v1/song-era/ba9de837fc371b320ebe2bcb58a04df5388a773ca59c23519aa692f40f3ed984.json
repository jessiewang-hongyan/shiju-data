[{"title":"题灵隐","author":"释绍嵩","text":"古刹藏幽胜，山门九里松。\n飞空花片片，落涧水淙淙。\n叶积池边路，云生户外峰。\n几因留我宿，吟到五更钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16083,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"憩窦园因题池亭","author":"释绍嵩","text":"午枕藜床梦忽惊，窦家园里有莺声。\n半生客路逢佳节，万瓦脚跟开化城。\n鸂鶒刷毛花荡漾，蒲萄上架月纵横。\n谁教并向此中见，清杀诗翁老不胜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16084,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠黄元吉","author":"释绍嵩","text":"此客非常客，搜诗病入神。\n锦囊称具眼，文学老于身。\n机息知名误，家因守道贫。\n仍闻猿与鹤，与尔转相亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16085,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"释绍慈","text":"我祖别行最上机，纵横生杀绝猜疑。\n虽然塞断群狐路，返掷须还师子儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16086,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"澹山岩","author":"释绍珏","text":"使君得佳句，简存如猗那。\n著之岩石中，千古不可磨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16087,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寿傅守 其七","author":"释若芬","text":"精藏烱目气藏神，笑语温然与物春。\n面骨如拳搀两耳，此公寿相等铜人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16088,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寿傅守 其九","author":"释若芬","text":"宁武堂中白日长，公庭讼息炷炉香。\n禅床不作蛾眉梦，一枕清风到寿乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16089,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寿傅守 其四","author":"释若芬","text":"十年泽国泛吴航，袖有新硎试未尝。\n聊把一麾施老手，便教千里作津梁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16090,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寿傅守 其六","author":"释若芬","text":"桃花綵绶俨仙衣，宝带垂金腹十围。\n五马人生真可贵，更欣桑梓共分辉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16091,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寿傅守 其十","author":"释若芬","text":"秋入东篱破晓霜，黄花不肯媚重阳。\n花神爱惜缘何事，要向今朝荐寿觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16092,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寿傅守 其一","author":"释若芬","text":"仙游舍人声建中，正论久矣排群雄。\n令子贤孙俱有耀，皇天两耳元非聋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16093,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寿傅守 其八","author":"释若芬","text":"堂前三凤戏斑衣，堂下三槐擢秀枝。\n一岁倦游归绿野，荣华鼎鼎看吾儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16094,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寿傅守 其二","author":"释若芬","text":"鹤发仙人年德尊，大贤之后更多闻。\n风流异日窥前辈，议论班班总不群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16095,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寿傅守 其三","author":"释若芬","text":"当年膴仕早标缨，不共儿曹校疾行。\n居易独能遵坦路，未妨六十到名卿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16096,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寿傅守 其五","author":"释若芬","text":"教令浮民一岁期，只将平易抗浇漓。\n朝廷若用循良课，换取樵川老吏归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16097,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"释若芬","text":"不是老僧亲写，晓来谁报平安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16098,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"临寂偈 其一","author":"释若愚","text":"本自无家可得归，云边有路许谁知。\n溪光摇落西山月，正是仙潭梦断时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16099,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"举赵州勘婆话颂","author":"释贤","text":"冰雪佳人貌最奇，常将玉笛向人吹。\n曲中无限花心动，独许东君第一枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16100,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"开涂田道者求语","author":"释亮","text":"大海波涛涌，道人愿力坚。\n当头一截断，万顷看平田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16101,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"古禅人乞语","author":"释亮","text":"底事完全亘古今，何劳特地遍参寻。\n草鞋蹋破知端的，悔涉山川恨转深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16102,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"光维那归乡","author":"释亮","text":"光境俱亡了，寒潭彻底清。\n溯流翻巨浪，五十四州惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16103,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"达上人乞语","author":"释亮","text":"达道应须并六贼，六贼并了何所得。\n十方坐断眼头空，观音院里无弥勒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16104,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"建康黄尚书请住清真曾以颂却之","author":"释亮","text":"彻骨穷来不厌穷，横眠倒卧白云中。\n饥餐一钵和罗饭，此外无能振祖风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16105,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"指三门","author":"释亮","text":"蹋断千差路，泼天门户开。\n抬头空荡荡，脚下起风雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16106,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四首 其四","author":"释亮","text":"一色通身白，天然绝点尘。\n吒沙当古路，不吼也惊人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16107,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四首 其二","author":"释亮","text":"几年湖海不知羞，一见桃花自点头。\n堪笑傍观犹眼热，也来趁队逞风流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16108,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七首 其六","author":"释亮","text":"九旬禁足今朝满，漆桶掀翻快活人。\n莫怪点胸夸独步，只缘过夏在清真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16109,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七首 其五","author":"释亮","text":"者僧问处绝誵讹，就便拈来付与它。\n嫩绿枝头红一点，动人春色不消多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16110,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄天童痴绝和尚","author":"释亮","text":"潦倒西山百不能，随身赖有一枝藤。\n东撑西拄消閒日，甘作荒山小院僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16111,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"碧云寄华藏故旧","author":"释亮","text":"碧云深处望湖山，时步松门独往还。\n眼底故人都不见，但闻幽鸟语关关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16112,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"藤簟","author":"释亮","text":"打成一片凝如水，风吹不动寒光起。\n饭饱齁齁快活眠，不知身在秋波里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16113,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"见侍者求语","author":"释亮","text":"三呼三应箭锋拄，不呼不应全体露。\n汝从雪窦到灵山，步步蹋著无差互。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16114,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"光上人求语","author":"释亮","text":"光明寂照遍河沙，认著依前满眼花。\n丧尽诸缘回首看，寥寥四顾绝周遮。\n绝周遮处未为是，更须知有祖师关。\n透得关，生死佛魔甚屎屁。\n时来平地一声雷，四海五湖如鼎沸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16115,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四首 其三","author":"释亮","text":"饥时定闻饥，饱时定闻饱。\n婆子在台山，赵州勘破了。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16116,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四首 其一","author":"释亮","text":"你有主丈与主丈，你无主丈夺主丈。\n拨乱乾坤几个知，莺啼不在花枝上。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16117,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七首 其七","author":"释亮","text":"说参禅，弥天过，缘是见成行货。\n可怜背觉合尘，饭箩边忍饥饿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16118,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七首 其四","author":"释亮","text":"今朝三月半，百花开烂熳。\n祖意甚分明，何妨著眼看。\n看看，忽然花谢树头空，又被风吹别调中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16119,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七首 其三","author":"释亮","text":"今朝十一月十五，光阴似箭岁将莫。\n参禅学道如何，切忌守株而待兔。\n若是金毛师子儿，翻身一掷无回互。\n无回互，惊杀南山白额虎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16120,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七首 其二","author":"释亮","text":"两个屎橛，合作一团。\n熏天炙地谁能嗅，千古丛林作话端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16121,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七首 其一","author":"释亮","text":"一叶落，天下秋，几人于此辨来由。\n衲僧冷地呵呵笑，南岳天台拄杖头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16122,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五首 其五","author":"释亮","text":"金风起，树叶落，体露堂堂活鱍鱍。\n报君知，快领略。\n回头转脑拟思量，错认笊篱作木杓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16123,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五首 其四","author":"释亮","text":"狂风暴雨轰霹坜，满庭撼动花狼籍。\n红红白白已周遮，何劳饭袋重拈出。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16124,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五首 其三","author":"释亮","text":"参学事，绝商量，急著眼，快承当，处处无非安乐乡。\n阿呵呵，好快活，万两黄金也消得。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16125,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五首 其二","author":"释亮","text":"柳缘花红春鸟啼，明明祖意报君知。\n个中直下知端的，已落吾家第二机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16126,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五首 其一","author":"释亮","text":"八十老婆心已灰，强颜抹粉与涂蚽。\n自知潦倒无羞耻，遇兴何妨舞一回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16127,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"悼遁庵","author":"释亮","text":"无端拗曲作直，平白换人眼睛。\n而今双履归去，且喜天下太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16128,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"巴江秋夕","author":"释保暹","text":"巴水寒声去渺茫，半空云树落秋光。\n离人此夜和愁宿，不听啼猿亦断肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16129,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送人自阙下归天柱","author":"释保暹","text":"却归天柱峰前去，高谢浮名似了心。\n林下孤灯一声磬，青猿啼断白云深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16130,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"磻溪","author":"释保暹","text":"不肯随波自直钩，一朝以道佐成周。\n后来亦有人于此，只把渔竿空白头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16131,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书派河徐希秀才别业","author":"释保暹","text":"渺渺渡头路，客心难解携。\n半空山远近，寒日水东西。\n漾浦渔罾小，飞沙雁阵低。\n霜风起深夜，只是欠猿啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16132,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书惟凤师壁","author":"释保暹","text":"草径通深院，秋来心更闲。\n城中无旧识，门外是他山。\n究寂生吟思，持斋得病颜。\n寒宵多约我，静话出人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16133,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"石席","author":"释保暹","text":"有状卷不得，闲斋惜夜长。\n坐来消暑气，睡去入秋乡。\n隐隐生寒骨，沈沈发冷光。\n何时遂深遁，移取置山房。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16134,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"早秋閒寄宇昭","author":"释保暹","text":"窗虚枕簟明，微觉早凉生。\n深院无人语，长松滴雨声。\n诗来禅外得，愁入静中平。\n远念西林下，相思合慰情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16135,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"老僧","author":"释保暹","text":"鬓毛垂似雪，无语答闲人。\n拥衲坐终日，浮生知几春。\n乘船应梦越，提锡记游秦。\n半夜寒堂掩，磬声闻四邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16136,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"金陵怀古","author":"释保暹","text":"石城秋月满，烟水冷萧萧。\n战气悲千古，歌声散六朝。\n萤飞宫草暗，霜白井桐凋。\n竟日秦淮上，思贤莫可招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16137,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋居言怀","author":"释保暹","text":"默默疏林下，独知秋气浓。\n半生犹是客，昨夜更闻蛩。\n吟苦人成癖，年衰自长慵。\n终期拂衣去，江上有诸峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16138,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋径","author":"释保暹","text":"杉竹青阴合，闲行意有凭。\n凉生初过雨，静极忽归僧。\n虫迹穿幽穴，苔痕接断棱。\n翻思深隐处，峰顶下层层。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16139,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送蒋白归越","author":"释保暹","text":"会稽连照水，归意两何亲。\n山影到平地，湖光生四邻。\n虚窗寒对晓，孤棹远浮春。\n未可从耕钓，青云懒致身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16140,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送简上人之洛阳","author":"释保暹","text":"闲身无所滞，独去背春城。\n望越乡心断，迎嵩隐思生。\n野禅依树远，中饭傍泉清。\n相府如投刺，分题有竺卿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16141,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重登文兆师水阁","author":"释保暹","text":"重来久凭栏，临水景多閒。\n高树下残照，寒潮平远山。\n夜吟长负宿，秋病几思閒。\n早晚离城里，从兹寄掩关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16142,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"途次望太行山","author":"释保暹","text":"盘影遮空黑，愁生入望赊。\n高来难客路，深去断人家。\n翠死寒溪水，香残别洞花。\n今宵何处宿，山口日将斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16143,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿宇昭师房","author":"释保暹","text":"与我难忘旧，多期宿此房。\n眠云归未得，静夜话空长。\n草际沈萤影，杉西露月光。\n天明共无寐，南去水茫茫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16144,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄从弟","author":"释保暹","text":"天外迹如萍，何人慰远情。\n烟霄滞秋荐，水国废春耕。\n旅梦寒应断，吟髭白恐生。\n无因话消息，一雁度江城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16145,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄行肇上人","author":"释保暹","text":"旧隐湖西寺，青青千万峰。\n来书度深雪，归梦断疏钟。\n开口与时避，论心似我慵。\n流年共衰鬓，昨夜又闻蛩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16146,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄洪州新建知县","author":"许及之","text":"远听弦歌乐部封，放衙乘醉半疏慵。\n家辞南越无千里，县管西山有几峰。\n人望废田禾影合，吏愁空狱藓痕重。\n孺亭应更悲前事，烟草萋萋叫夜蛩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16147,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄徐任","author":"释保暹","text":"乡园书久断，寒夜起归心。\n远路秦关外，啼猿剑树深。\n贫游年暗改，醉卧月空沈。\n几夕疏林下，相思废静吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16148,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书杭州西湖涉公堂","author":"释保暹","text":"孤舟孤鹤与孤云，湖上深居自不群。\n高卧可能容一榻，青山西岸且平分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16149,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"忆松江","author":"释保暹","text":"曾向长洲泛渺漫，沈青空阔鸟飞难。\n平沙杳杳夜潮落，别浦依依秋树寒。\n闲浸客亭浮去棹，冷淹渔屋漾垂竿。\n归心早晚悬帆到，是处僧楼更上看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16150,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江行","author":"释保暹","text":"渺渺沈清际，回头望即赊。\n幽禽飞共阔，野客泛无涯。\n浦暗微分树，滩遥半涨沙。\n今宵应有月，重得宿芦花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16151,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄白阁元贞","author":"释保暹","text":"一闻归白阁，更不入长安。\n绝顶无人上，西风彻夜寒。\n悬崖乘雪度，飞瀑过云看。\n应念驰名者，青门得路难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16152,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登芜城古台","author":"释保暹","text":"无处堪高望，城边上古台。\n穷秋人独立，落日雁空回。\n地险千峰出，霜严万木摧。\n迟吟不能下，满眼是尘埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16153,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"释修己","text":"羊肠鸟道无人到，寂寞云中一个人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16154,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂","author":"释修演","text":"未悟之日要参禅，一见石门便坦然。\n蒙师指个真消息，方知盐咸醋是酸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16155,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"悟赵州狗子无佛性话偈","author":"释南","text":"狗子无佛性，罗睺星入命。\n不是打杀人，被人打杀定。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16156,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"石佛寺","author":"释南越","text":"松竹行才尽，香城绝世尘。\n倚岩开半殿，凿石见全身。\n钟鼓中天晓，烟花上界春。\n出门重稽首，愿值下生辰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16157,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"见见之时见非是见","author":"释南雅","text":"见见之时非是见，见犹离见若为论。\n钱塘江上中秋后，风急潮声万马奔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16158,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七首 其四","author":"释南雅","text":"生是死之生，死是生之死。\n两路坦然平，无彼亦无此。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16159,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]