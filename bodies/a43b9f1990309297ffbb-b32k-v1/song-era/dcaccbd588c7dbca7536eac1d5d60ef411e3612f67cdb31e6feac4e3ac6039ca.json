[{"title":"乌尤山","author":"张方","text":"竹桥沙水乌尤渡，绝壁孤崖意气骄。\n故与凌云分半坐，僧窗假寐见金焦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50469,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"泊舟别故","author":"张方","text":"瓣香杓杜老先生，文艺林中许乞盟。\n埽叶岩幽酌泉窦，可能续赋洞箫声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50470,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"资水桥","author":"张方","text":"二里桥头车马行，灵龟背后玉龙横。\n涨泷往日惊河伯，砥柱千年要石兄。\n资水右旋江会合，天台西直卦文明。\n吾心怵惕便施手，事所当为无问名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50471,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"翠云山","author":"张宰","text":"未了人间朱墨缘，强颜荒邑又三年。\n填胸眯目皆尘土，直到峰头始豁然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50472,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二十一","author":"张商英","text":"水晶肉白壳皮红，色变香移味不同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50473,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"天台福圣观","author":"张无梦","text":"天台瀑布落青天，观在天台瀑布边。\n道士祇今烧药处，仙翁曾是种芝田。\n龙居古洞遗残雨，鹤出高巢点破烟。\n暂别灵溪游五岳，不知重到又何年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50474,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桐柏崇道观","author":"张无梦","text":"桐柏观周匝，千峰累翠螺。\n地高阴气少，天近日光多。\n三井云雷起，一坛鸾鹤过。\n谁言紫微后，无客继仙科。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50475,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"福圣观","author":"张无梦","text":"台山卜隐十馀秋，曾伴仙翁处处游。\n瀑布长流天上雪，翠屏高倚洞前楼。\n云堆华顶寻飙驭，月满灵溪狎海鸥。\n此地重归别得路，赤城玉府透瀛洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50476,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"凝真宫","author":"张无梦","text":"五云深锁洞门深，蹑屐攀萝特地寻。\n烟霭不藏尘外路，神仙遗下水中金。\n喜游汗漫华胥宅，重忆崆峒至道心。\n不得方平同一醉，红霞零落我樽琴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50477,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"张无梦","text":"壶中一粒长生药，待与苏州太守分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50478,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄天台王鍊师兼呈邑宰","author":"张日损","text":"百里凄清古县城，阮郎陶令自相应。\n非无柳影含彭泽，别有花光胜武陵。\n闲醉想同莎外石，冷吟知共夜深灯。\n红尘未得寻高兴，心过青山第几层。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50479,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诗一首","author":"张氏","text":"罗幕泥金窣地垂，夜香烧尽二更时。\n不知帘外溶溶月，上到梅花第几枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50480,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠人","author":"张氏","text":"云鬓慵梳睡不忺，倚阑听燕语虚檐。\n春愁自是无重数，生怕东风揭绣帘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50481,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"满庭芳","author":"张风子","text":"咄哉牛儿，心壮力壮，几人能可牵系。\n为爱原上，娇嫩草萋萋。\n只管侵青逐翠，奔走后、岂顾群迷。\n争知道，山遥水远，回首到家迟。\n牧童，能有智，长绳牢把，短梢高携。\n任从它，入泥入水无为。\n我自心调步稳，青松下、横笛长吹。\n当归处，人牛不见，正是月明时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50482,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"张世英","text":"霅溪深极地根清，四水交流激射声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50483,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"思维路","author":"张世美","text":"一来一往几车马，可北可南多路岐。\n莫待迷途重回首，未曾差处著思维。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50484,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题招提院静照堂","author":"张刍","text":"槜李旧禅扉，丛林自翠微。\n寺居天外静，僧向日边归。\n野水涵斋几，閒云宿钓矶。\n庭前祖来意，谁为相依依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50485,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"扫花游/扫地游","author":"张半湖","text":"柳丝曳绿，正豆雨初晴，水天朱夏。\n石榴绽也。\n看猩红万点，倚亭敧榭。\n锁闼深中，料想酒阑歌罢。\n日将下。\n是那处藕花，香胜沈麝。\n窗外风竹打。\n似戛玉敲金，送声潇洒。\n共观古画。\n唤石鼎烹茶，细商幽话。\n宝鸭烟消，天外新蟾低挂。\n凉无价。\n又丁东、数声檐马。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50486,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"满江红 夏","author":"张半湖","text":"新绿池塘，一两点、荷花微雨。\n人正静，桐阴竹影，半侵庭户。\n敧枕未圆蝴蝶梦，隔窗时听幽禽语。\n卷沙帏、随意理琴丝，黄金缕。\n鲛绡扇，轻轻举。\n龙涎饼，微微炷。\n向水晶宫里，坐消袢暑。\n剥啄谁敲棋子响，莺儿林里惊飞去。\n最好是、活水瀹新茶，醒春醑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50487,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游七星岩","author":"张去华","text":"桂林平地起山尖，独此奇峰个个圆。\n上应星辰三四点，中藏空洞几千年。\n乘槎客子频相访，骑鹤仙人竟不还。\n多少南来骢马客，品题诗句细磨镌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50488,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重建羊侯祠和王原叔句","author":"张去惑","text":"汉江千里清溶溶，惟此南夏奠其中。\n因山为城峙险固，一国形胜何高雄。\n嶷然巨首名曰岘，回压面势尊且崇。\n东扼迅流疑引翼，西峙群阜如盘龙。\n嵚巇峻拔不可拟，绝岸万丈凌长空。\n下阚澄潭迥无际，旁睨比屋几可封。\n天意造物岂虚设，控蛮镇楚舒隆隆。\n自昔登憩且非一，此山振动惟羊公。\n有志平吴运秘略，竭心卫晋推元功。\n绥怀远迩人所服，开垦田畴时以丰。\n慨然置酒适清旷，中郎幕府贤而通。\n语公令望高四海，当与斯山永无穷。\n自是绵绵岁历久，阅碑堕泪存遗踪。\n亭祠浸坏讵可究，山归民籍木以童。\n前知兴衰故有日，览者叹息追无从。\n龙图王公守兹土，修举废坠诘初终。\n感物思人但长息，剡章疾置闻四聪。\n圣宸动色可其请，兹山复兴气象融。\n耽耽大厦揭亭宇，肃肃真像严祠宫。\n遂使灵光享血食，禁樵复祀资恪恭。\n大抵有功及民物，盛德期兴天地充。\n今之视古皆一致，休哉千载怀清风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50489,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄罗惜惜","author":"张幼谦","text":"昔人一别恨悠悠，犹把梅花寄陇头。\n咫尺花开君不见，有人独自对花愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50490,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"一剪梅","author":"张幼谦","text":"同年同日又同窗。\n不似鸾凰，谁似鸾凰。\n石榴树下事匆忙，惊散鸳鸯，拆散鸳鸯。\n一年不到读书堂。\n教不思量，怎不思量。\n朝朝暮暮只烧香，有分成双，愿早成双。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50491,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"卜算子 和惜惜","author":"张幼谦","text":"去时不由人，归怎由人也。\n罗带同心结到成，底事教□舍。\n心是十分真，情没些儿假。\n若道归迟打棹篦，甘受三千下。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50492,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"长相思","author":"张幼谦","text":"天有神。\n地有神。\n海誓山盟字字真。\n如今墨尚新。\n过一春。\n又一春。\n不解金钱变作银。\n如何忘却人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50493,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题汪水云诗卷","author":"张弘道","text":"风樯阵马不可羁，我亦回首蓟北驰。\n为我援琴作商声，和以长吟商声悲。\n辽鹤一去不复返，茫茫天海秋雁飞。\n黯然十操发金石，掩卷忍读胡笳诗。\n相逢把臂不可别，白蘋洲渚菊花时。\n天涯地角聚复散，水云云水同襟期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50494,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贤令山","author":"张本中","text":"□□萦纡一径深，□看石壁起千音。\n雨□□□来春溜，雾霭留空□昼阴。\n坐对云山开远眼，静谐泉石会幽吟。\n山阴东武定何□，妙趣何曾间古今。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50495,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上元口号","author":"张正己","text":"绣车箫鼓动香街，铁锁龟城度晓开。\n仙凤传香留蜀国，夜龙衔烛上蓬莱。\n月如流水随天远，人似夭桃出洞来。\n无限风光追不尽，只惊信马到瑶台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50496,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"石仙观","author":"张汉彦","text":"苍崖如壁立，神仙好岩居。\n杖藜往佳招，还与胜境俱。\n寻幽憩真馆，访古得遗书。\n傍有千寻木，中藏蝉蜕躯。\n终然跻绝顶，眼界聊一舒。\n军峰散云雨，盱水带城隅。\n始知众山小，端欲隘寰区。\n达人等大观，笑彼形器拘。\n天寒风景暮，归兴促篮舆。\n幸兹及官闲，行色可徐徐。\n前修傥可作，微禄亦何须。\n眷言还故山，著论拟潜夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50497,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题太平兴国宫","author":"张汉彦","text":"神仙所居真福地，帝遣仙官下人世。\n开元圣主梦潜通，九天使者何灵异。\n绛节霓旌射紫霄，风吹仙袂还飘飘。\n群官再拜所共睹，至今传闻时未遥。\n眼前不见吴生笔，劫火俱焚馀败壁。\n当时壮丽为一空，每对荆蓁频叹息。\n谁人再造成奇功，巍巍宝殿尤瑰雄。\n我来祈福不为己，喜见气象升平中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50498,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨中花慢","author":"张生1","text":"事往人离，还似暮峡归云，陇上流泉。\n奈强分圆镜，枉断哀弦。\n常记酒阑歌畔，难忘月底花前。\n旧携手处，层楼朱户，触目依然。\n从来惯向，绣帏罗帐，镇效比翼纹鸳。\n谁念我、而今清夜，常是孤眠。\n入户不如飞絮，傍怀争及炉烟。\n这回休也，一生心事，为尔萦牵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50499,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小重山 寄郑云娘","author":"张生2","text":"杏火无烟烧断肠。\n织成春恨切，柳丝长。\n当时谁是种花郎。\n却不教，柳近杏花傍。\n柳道不须忙。\n春深须是有，絮飞扬。\n等闲扑着杏腮香。\n恁时节，选甚隔池塘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50500,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西江月","author":"张生2","text":"一望朱楼巧小，四边绣幕低垂。\n个人活脱似杨妃。\n倚遍阑干十二。\n最苦两双情眼，难禁四只愁眉。\n无言回首日沉西。\n不道一声安置。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50501,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"龙隐岩","author":"张田","text":"龙隐晦冥时莫考，龙骧拿攫迹堪惊。\n孔明久卧养全德，老子忽飞归太清。\n溪上一天常气胜，洞中六月自寒生。\n至人不得无情处，甘泽年年洒百城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50502,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜飞鹊/夜飞鹊慢 荷花","author":"张艾","text":"霓裳按歌地，凉影参差。\n还是佩解江湄。\n沧波正洗袜尘恨，流霞空沁铢衣。\n盈盈半输笑，向朱阑凝伫，欲诉心期。\n碧筒唤酒，恐娇娥、来下瑶池。\n未许西风吹断，环步障千重，镇护金猊。\n落晚文禽点镜，分香窃翠，却念幽羁。\n彩云惊散，暗伤情、不似芳时。\n待清歌招些，怜心问的，水杳舟移。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50503,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绕佛阁","author":"张艾","text":"渚云弄湿，烟缕际晚，江国遥碧。\n鸿过无迹。\n怕闻野寺孤钟动凄恻。\n小桥路窄。\n疏袖暗拂衰草，愁听蛩语还寂。\n可堪过了，龟纱负瑶席。\n荏苒露华白。\n一夜秋窗惊晓色。\n柳影孤危，残蝉空抱叶。\n想摇落关情，归梦频折。\n物华消歇。\n尽倒断寒塘，幽香先灭。\n怨红供、拒霜啼颊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50504,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"解语花","author":"张艾","text":"轻雷殷殷，小枕惊回，帘影摇庭户。\n嫩凉遥度。\n江云堕、结作西窗暗雨。\n闲阶静伫。\n叹疏袂、愁宽一缕。\n凭画栏，润叶鸣条，总是安秋处。\n因唤扁舟晚渡。\n渐闻歌招得，采菱俦侣。\n临平归路。\n花无数、应识汀洲倦旅。\n飞红怨暮。\n长趁得、断鸿南浦。\n闲枕衾，谁更无聊，应最怜纨素。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50505,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再游浯溪","author":"张仲","text":"一年两檄过浯溪，□上?亭□□□。\n笑□兴亡千古□，□□崖石与天齐。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50506,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉兔净居诗","author":"张仲尹","text":"何事回真馆，标名作净坊。\n金园存废趾，玉兔效殊祥。\n跃汉劳罝网，环山瑩雪霜。\n来疑昆岫出，去讶月轮藏。\n隐显经千载，薰修荫一方。\n宝坛隳道祖，华榜耀空王。\n奥域居全晋，灵祠接庆唐。\n烟霞生四面，楼殿起中央。\n映日杉阴合，飘空磬韵长。\n伊余闻胜槩，宁惜寄篇章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50507,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"如梦令 秋怀","author":"张仲宇","text":"送过雕梁旧燕。\n听到妆楼新雁。\n菊讯一何迟，倒尽清樽谁伴。\n魂断。\n魂断。\n人与暮云俱远。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50508,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"石淙","author":"张仲武","text":"二室盘游日，三阳宴喜心。\n分流来万壑，巨石拟千岑。\n玉殿烟芜在，金碑雨藓侵。\n翠华何处问，山水自清音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50509,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"万年宫","author":"张仲信","text":"频将衣食结圜圊，天乐旌幢降綵云。\n二十四年功行满，众真推让武夷宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50510,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"设醮灵仙观","author":"张仲威","text":"瑞气葱葱雨露边，璧门金阙倚层巅。\n青霓绛节严中夜，绿盖丹舆会九天。\n香染旧泥封宝洞，声传鸣鹤湛灵泉。\n分明步入烟霄上，何必餐霞驻少年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50511,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"柳梢青","author":"张任国","text":"挂起招牌。\n一声喝采，旧店新开。\n熟事孩儿，家怀老子，毕竟招财。\n当初合下安排。\n又不豪门买呆。\n自古道、正身替代，见任添差。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50512,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"张众","text":"伤心白雪阳春丽，极目朝云暮雨非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50513,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"子山再惠诗见和因又续成子山不以予不才两发章荐","author":"张先","text":"清卿恩德重鳌山，诗寄闲栖白首官。\n须信夜光谁可得，玉龙沉睡玉渊寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50514,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"飞仙岭","author":"张先","text":"路接晓天人近月，真仙去后只云归。\n岭头旧曰上升日，空有山禽自在飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50515,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"飞石岩","author":"张先","text":"石破重岩万客疑，不堪攻玉不支机。\n长江风雨来无定，时学零陵燕子飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50516,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"失题","author":"张先","text":"花落春禽啼晚枝，有时香蒂点人衣。\n多情尽不如蝴蝶，欲起遗红贴地飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50517,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和元居中风水洞上祖龙图韵","author":"张先","text":"水色风光近使君，浥尘轻雨逐车轮。\n暂来不宿宜无恨，多少行春不到人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50518,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"营妓张温卿黄子思爱姬宜哥皆葬宿州城东过而题诗","author":"张先","text":"好物难留古亦嗟，人生无物不尘沙。\n何时宰树连双冢，结就人间并蒂花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50519,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"酬发运马子山少卿惠与诗","author":"张先","text":"贡馀应惜点为山，绝唱兼遗致政官。\n嵰地雪甜多不识，吴人未食齿先寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50520,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"酬周开祖示长调见索诗集","author":"张先","text":"辩玉当看破石诗，泥沙有宝即山辉。\n都廛往往无真璞，误使人评鼠腊归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50521,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"漫天岭","author":"张先","text":"不独高明不可谩，仍知不似泰山安。\n五丁破道秦通蜀，却被行人脚下看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50522,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠妓兜娘","author":"张先","text":"十载芳洲抚白蘋，移舟弄水赏青春。\n当时自倚青春力，不信东风解误人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50523,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九月望日同君谟侍郎泛西湖夜饮","author":"张先","text":"清歌曲曲酒巡巡，一举金蕉五十分。\n山影与天都在水，风光为月不留云。\n节回路口千门待，乐过湖心四岸闻。\n莫笑闲官奉欢席，自来蒿艾近兰薰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50524,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬日郡斋书事","author":"张先","text":"铃索声闲按牒稀，怯寒肌骨望春晖。\n凝云垂地雪欲下，高树无风叶自飞。\n水落浅沙鱼队聚，草枯幽陇鹿群归。\n安人不信彤襜贵，上相还家是锦衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50525,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵清明日西湖","author":"张先","text":"新火飞烟上柳梢，天供好景助诗豪。\n江湖一处逢嘉月，溟海同时得巨鳌。\n白水更随春雨长，青云不及画楼高。\n千桡插羽鼙声动，十里惊雷夺暮涛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50526,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵蔡君谟侍郎寒食西湖","author":"张先","text":"飞飞画楫绕花洲，霁雨浮花出岸流。\n谁广金明为水战，自来银汉有霓舟。\n行从使节春尤盛，住买吴山老未由。\n人迟归轩香接路，一分新月管弦楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50527,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"李少卿宅除夜催妆","author":"张先","text":"裴李门头车马盛，斗杓临晓欲东回。\n天真都说妆前好，春色偷从夜半来。\n园里花枝灯树合，月中人影鉴奁开。\n诗家无自矜吟笔，不惜铅华不用催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50528,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"射","author":"张先","text":"射艺功多暮未疲，欲将庭火继西晖。\n弦声应手裂竹响，旗影翻风戏鸟飞。\n竟日中支矜互胜，傍人如堵见终稀。\n不知双烛沙河上，谁得牛心一割归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50529,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"润州甘露寺","author":"沈括","text":"丞相高斋半草莱，旧时风月满亭台。\n地从日月生时见，天到江山尽处回。\n三国是非春梦断，六朝城阙野花开。\n心随潮水漫漫去，流遍烟村半日来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50530,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"韵和上先顿首","author":"张先","text":"池上飞桥亭外山，野禽偷静上钩栏。\n晚花露重香偏细，春女衣轻体尚寒。\n曲水略殊今日事，南湖曾奉昔人欢。\n郡图可许增新致，几处模传画样看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50531,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"醉眠亭","author":"张先","text":"醉翁家有醉眠亭，为爱江堤乱草青。\n不听耳边啼鸟唤，任教风外杂花零。\n饮酣未必过此舍，乐甚应宜造大庭。\n五柳北窗知此趣，三闾南儗漫孤醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50532,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]