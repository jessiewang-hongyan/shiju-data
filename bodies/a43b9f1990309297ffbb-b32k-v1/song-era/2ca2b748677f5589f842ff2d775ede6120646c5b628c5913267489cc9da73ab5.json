ection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22249,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"周晦叔所宅之左一坡隐然而高有竹万个架小轩于翠雾苍雪间日弹琴读书其下轩外鸣泉清驶若与弦诵之声相答爱其境胜为赋一绝","author":"史弥宁","text":"竹根碧涧落寒声，竹外双溪抵镜明。\n满袖天风吟不彻，坡头直有许多清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22250,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和邵阳张茂才青莲花韵 其一","author":"史弥宁","text":"清标别是一家春，风帽飘飘翠染匀。\n贪向波间弄明月，谪仙居士□前身。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22251,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和邵阳张茂才青莲花韵 其二","author":"史弥宁","text":"昨夜群仙宴十洲，再三招我伴清游。\n酒酣忽跨长鲸去，碧玉杯盘散不收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22252,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和叔振晓上梅坡小亭","author":"史弥宁","text":"巡檐诗袖涨寒香，日炙南枝泫晓霜。\n净洗宫妆转明洁，恰如汤饼试何郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22253,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜窗书事","author":"史弥宁","text":"一烬银镫两架书，十年伴我夜窗虚。\n不因见性明心后，定自人呼作蠹鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22254,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"孤山","author":"史弥宁","text":"孤山数幅古名画，著在暗香疏影边。\n不是逋仙有梅癖，梅花清韵似逋仙