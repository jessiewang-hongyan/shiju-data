rneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22261,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"客舍瓦池","author":"史弥宁","text":"片石玲珑水抱根，巧栽松竹间兰荪。\n怕人触弄鱼儿活，疏织筠笼护瓦盆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22262,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春莫同社会饮张园小楼分韵得飞字","author":"史弥宁","text":"残红委地水平池，杨柳阴阴莺乱飞。\n山色满楼新雨后，一帘风絮卷春归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22263,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"看李成画","author":"史弥宁","text":"岩壑蟠胸秦太虚，辋川一见病全苏。\n可愁地僻无医药，绕屋营丘山水图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22264,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋兰三绝 其三","author":"史弥宁","text":"砌蜡成花浅带黄，紫茎绿叶媚秋光。\n不吟尚自清羸甚，怪得诗腰肖沈郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22265,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋兰三绝 其一","author":"史弥宁","text":"叶叶低垂翠带长，花清干瘦吐微香。\n西风劣相添寒色，簇立蜻蜓冻欲僵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22266,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋兰三绝 其二","author":"史弥宁","text":"杜若江蓠汝弟兄，楚骚经里总知名。\n虽然臭味略相似，毕竟还他骨格清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22267,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝湖","author":"史弥宁","text":"一湖春渌万山围，著我兰舟自在飞。\n老子行藏有神助，顺风出去顺风归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22268,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送邬文伯归侍临川 其二","author":"史弥宁","text":"易学寥寥一线然，谁人口里说先天。\n近来惟有朴斋老，白首焚芗尚草玄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22269,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送邬文伯归侍临川 其一","author":"史弥宁","text":"莫管东风归路长，但将绮句答春光。\n候门儿女应相讶，满袖离骚草木香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22270,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送苏道士","author":"史弥宁","text":"七十臞仙鬓未秋，肯来为我说真休。\n归欤恐负青山约，跨鹤吹笙挽不留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22271,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闻笛","author":"史弥宁","text":"卸帆沽酒荻花村，水色天光净不分。\n霜月凄凉何许笛，一声吹裂洞庭云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22272,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"香涧老衲示似玉林首倡极道竹溪宴月之乐玉林勉以属和 其二","author":"史弥宁","text":"孤令青莲欠所亲，月边和影是三人。\n何如洗盏溪光里，弟劝兄酬汎玉轮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22273,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"香涧老衲示似玉林首倡极道竹溪宴月之乐玉林勉以属和 其一","author":"史弥宁","text":"长松翠竹拱晴波，不饮其如月色何。\n珍重阿连能好事，高轩携酒夜深过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22274,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏日小酌","author":"史弥宁","text":"拓窗一粲俯晴川，尽放薰风到酒边。\n小待夜深清月上，藕花影里榜渔船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22275,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓发严濑舟中和戴叔振韵","author":"史弥宁","text":"子陵滩下放船开，老我经行知几回。\n别岸舂锄殊解事，冲烟冉冉送诗来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22276,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浮骖","author":"史弥宁","text":"天净风平水不痕，浮骖带雪系篱根。\n欺寒酒兴峥嵘甚，又访梅花过别村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22277,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"荷恩堂","author":"史弥宁","text":"不才只合老林丘，也玷班行也典州。\n惭愧一家都饱暖，君恩海样若为酬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22278,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读千岩续藁","author":"史弥宁","text":"诗老毫端别有春，岩前草木也精神。\n锦囊留得灵犀在，辟尽人间俗子尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22279,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读杜诗","author":"史弥宁","text":"满地干戈老厌逢，酒杯诗卷托孤忠。\n自从风雅离骚后，数到而今无此翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22280,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读楚骚","author":"史弥宁","text":"一蕊青镫手自挑，霜风木叶下亭皋。\n篆香销尽寒灰塌，细嚼梅花味楚骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22281,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶述","author":"史弥宁","text":"农忻膏泽了春耕，客免深泥阻去程。\n日里放晴终夜雨，天公两下做人情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22282,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"啜茗","author":"史弥宁","text":"瞢腾午困懒吟哦，鼎沸枪旗不厌多。\n战退睡魔三十里，安知门外有诗魔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22283,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄慥斋弟","author":"史弥宁","text":"鸥鹭逢人问归信，三年作客负沧洲。\n诗袍醉帽黄埃底，羞见扶风马少游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22284,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庵居","author":"史弥宁","text":"倒影晴溪蘸碧峰，庵居活计尽从容。\n懒能著眼看时事，相约梅花住过冬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22285,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"维则庵追凉题月湖屏间诗后","author":"史弥宁","text":"淋漓醉墨洒屏间，逃暑祇园闯一斑。\n小阮诗怀饱丘壑，可无只句饷江山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22286,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菊","author":"史弥宁","text":"癖好秋光劝不回，挥金一䴮买诗材。\n寒花也自矜前辈，曾与柴桑保社来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22287,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"萸","author":"史弥宁","text":"不入湘累俎豆閒，也分半席缀诗坛。\n杜陵老眼明于镜，醉撚西风子细看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22288,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"野塘秋鹭","author":"史弥宁","text":"玉立秋塘一振衣，竦肩莫是为寻诗。\n近来绝少元和样，岛瘦郊寒渠得之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22289,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"啼鹃","author":"史弥宁","text":"点检园禽谁口多，错嫌百舌逞喽啰。\n春归怪见难留驻，撺掇元来却是他。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22290,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晴江观鸭","author":"史弥宁","text":"鸭鸭新晴出翠蒲，春江水暖互相呼。\n避人深入苍烟去，莫是乔仙双履无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22291,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登雁峰","author":"史弥宁","text":"□□□□□□□，□句挥毫手不停。\n□雁旁观偷笔法，仓忙书破楚天青。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22292,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"紫笑","author":"史弥宁","text":"芳苞暗解紫罗囊，香杀东风一味狂。\n试问花神缘底笑，笑他莺蝶为春忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22293,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蛩螀","author":"史弥宁","text":"声作饥鸢吟未休，蛩螀斗合赋清秋。\n被他聒得浑无句，独力难胜众楚咻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22294,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赋栖真观月季","author":"史弥宁","text":"茶芗从臾访栖真，闯户蔫红绝可人。\n不逐群芳更代谢，一生享用四时春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22295,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赋雁","author":"史弥宁","text":"云惨胡天倦客程，西风失喜到江城。\n自传属国书来后，猎猎声名动汉京。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22296,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"催花","author":"史弥宁","text":"梅怨霜欺春未知，商量着蕊尚迟疑。\n戏将诗句催花看，催得花开转费诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22297,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"溪桥","author":"史弥宁","text":"冻吟肩耸学刘叉，痴坐山房井底蛙。\n财过溪桥风景别，淡烟和月罩梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22298,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"僧窗","author":"史弥宁","text":"朝市踆踆走利名，道人许样不关情。\n西窗梦破梅花晓，敲月数声钟磬清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22299,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"翟簿示似中秋高作命意着语殆与商素争清读至人与月忘年之句不觉击节借五言为韵赋诗答谢 其一","author":"史弥宁","text":"饮月漱吟齿，心事何轮囷。\n醉舞影凌乱，子其谪仙人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22300,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"静吟","author":"史弥宁","text":"居官役役簿书间，及到家山困往还。\n若欲静吟无俗累，算来却是客中闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22301,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题刘君鼎臣盘谷图","author":"史弥宁","text":"崖壁开张半幅悭，权名人见若为颜。\n那知别有真丘壑，不在区区纸上山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22302,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题清湘管善甫青云楼","author":"史弥宁","text":"湘山诗眼两争高，醉墨淋浪湿斗杓。\n说似元龙彻栏楯，恐妨纵武上曾霄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22303,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题萧氏竹坡","author":"史弥宁","text":"鲜碧缘坡古径深，夜窗风雨作龙吟。\n自从八叶传芳后，数到孙枝玉满林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22304,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题湘西廖次高水南真趣","author":"史弥宁","text":"买他磐石作比邻，谁道风烟不属君。\n占断好山犹可在，无端吞并一江云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22305,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"懒不作诗觉文房四友俱有愠色谩赋","author":"史弥宁","text":"一毛不拔管城子，冷眼相看石丈人。\n急性陈玄楮居士，未分皂白也生嗔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22306,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"燕","author":"史弥宁","text":"管鲍交情已矣夫，君看门上翟公书。\n茅檐不鄙频来往，叔末衣冠得似渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22307,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠苏道士","author":"史弥宁","text":"一卷麻衣易洗心，弦琴山水是知音。\n有时槃礴晴窗下，随手云烟喷晓林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22308,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠临汝曾医士","author":"史弥宁","text":"有客谭医惊四座，指下玄微应识破。\n药市栖迟三十年，安知不是伯休那。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22309,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"檐滴","author":"史弥宁","text":"过雨秋檐不住声，敲盆滴砌带诗清。\n料渠要学侬搜句，旋叠平平仄仄平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22310,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"霜柳","author":"史弥宁","text":"十分冬暖学春华，袅袅垂杨映日斜。\n一色淡黄霜染就，看来祇欠带栖鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22311,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹭鸶林","author":"史弥宁","text":"驿路逢梅香满襟，携家又过鹭鸶林。\n含风野水琉璃软，沐雨春山翡翠深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22312,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"醴陵道上饮别故人被酒困坐竹舆因赋","author":"史弥宁","text":"鸡声催起度江乡，病酒无憀客路长。\n掩上轿窗无只句，著何面目见春光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22313,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大阅","author":"史弥宁","text":"擐甲边城教即戎，三军锦绣晓光中。\n影摇澬水旌旗动，声震文山鼓角雄。\n马惯挥戈翻塞雪，雁惊鸣镝响天风。\n十行忍负君王意，同向燕然勒隽功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22314,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"云山诗境","author":"史弥宁","text":"天公收画底论钱，借与山人换样看。\n云巘浮春晴嶂暖，烟崖积雪晓屏寒。\n平林淡抹精神妩，小景横陈气象宽。\n定自米家船上买，不然那得许多般。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22315,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"六亭宴雪","author":"史弥宁","text":"雪天领客倚清狂，战退玄冥酒百缸。\n柳絮辊风粘冻壁，梨花撒雨响寒窗。\n琼田隐隐迷翘鹭，玉砌狺狺走吠尨。\n一稔明年宽万虑，更催三白瑞澬江。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22316,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"东还","author":"史弥宁","text":"及瓜剩喜发南州，纳纳春光销客忧。\n细麦风前蓝袖举，新秧水面绿针浮。\n行程又过山深处，归梦还寻天尽头。\n收拾怀乡旧诗藁，探先封寄与沙鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22317,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"灯夕","author":"史弥宁","text":"东风劫劫趁芳辰，调柳唆梅著处新。\n翠筦声中千里月，银花影里万家春。\n楼台拚饮夜不夜，罗绮飘香人看人。\n抖擞吟怀歌乐岁，江山分外长精神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22318,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟中","author":"史弥宁","text":"西风吹上木兰船，人讶今时李郭仙。\n一抹烟光粘远树，十分山翠滴晴川。\n夕阳半在寒鸦外，秋色全归过雁边。\n纵有清诗费摹写，楮生为我唤龙眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22319,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]