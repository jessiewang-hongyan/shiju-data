[{"title":"济河焚舟","author":"林希逸","text":"汔济焚舟去，秦兵意若何。\n深仇思必雪，信誓有如河。\n甲卒方停棹，将军怒指戈。\n连樯皆纵燎，劲气欲熬波。\n拜赐前言在，论功一炬多。\n至今临岸处，梦想发皤皤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32794,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"客星","author":"林希逸","text":"久要刘文叔，论交在阙庭。\n不为渠相汉，仅以客名星。\n鹤发兼霜白，羊裘近帝青。\n宫中聊款款，极下独荧荧。\n一点今霄汉，孤灯昔钓汀。\n灵台誇列宿，讵肯共图形。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32795,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"驻跸山","author":"林希逸","text":"万里君王跸，雷驱铁骑环。\n移来云下仗，远驻海东山。\n飞檄青丘外，鸣鞘怪石间。\n龙经占得耳，禽语喜违颜。\n似勒燕然去，如封岱岳还。\n铙歌模写遍，何不续东蛮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32796,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"乘月登楼","author":"林希逸","text":"铁骑围何急，登楼却自由。\n一轮秋夜月，百尺岳阳楼。\n老将凭栏怒，嫦娥为我留。\n功成长啸后，人在古城头。\n羽扇荣差可，胡床庾浪游。\n千年髯孰似，笛里梦并州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32797,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"饮马长城窟","author":"林希逸","text":"瘦马如乌渴，长驱傍古城。\n听他随窟饮，不暇择泉清。\n沙外追风骥，榆边积雨坑。\n花鬃摇汉骑，草血染秦兵。\n地脉千年恨，波腥万鬣鸣。\n思归频蹀躞，苜蓿满宸京。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32798,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雁足书","author":"林希逸","text":"中郎沙漠外，羝乳事何如。\n赖有云中雁，能传足上书。\n衔芦来内苑，系帛自穹庐。\n地说荒寒极，人称老病馀。\n史徒誇问犬，诗莫咏烹鱼。\n青鸟仙家使，吾今益信渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32799,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"无弦琴","author":"林希逸","text":"道外元无器，聊横膝上琴。\n本非弦可弄，自觉趣尤深。\n早向声前悟，何劳指下寻。\n昭文元不鼓，钟子谩知音。\n赜矣钟名哑，伤哉磬有心。\n退之如解此，十操不应吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32800,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"为郎牧羊","author":"林希逸","text":"卜式何为者，清班粉省郎。\n不骑沙苑马，只牧上林羊。\n谩诧窠名锦，何如屩曳芒。\n含香休向阙，挟册且随臧。\n列宿从嗤我，三星喜咏牂。\n尚怀肥报国，抗疏欲烹桑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32801,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"登单于台","author":"林希逸","text":"天仗祁连外，穷荒鸟雀呼。\n登台真帝子，绝幕遁单于。\n百级云中见，千官帐下趋。\n穹庐垂旷野，警跸近清都。\n汉地今无虏，秦城枉避胡。\n呼韩天日谒，却入渭桥图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32802,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"蒲鞭","author":"林希逸","text":"自古官刑在，如何只用蒲。\n贤哉知道者，陋矣执鞭乎。\n草草存笞责，拳拳爱体肤。\n教非刑可比，耻患免而无。\n舜扑书徒识，秦敲惨自愚。\n悲因挞黎庶，适意与宽俱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32803,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"被褐怀珠玉","author":"林希逸","text":"怀宝伊谁识，累然被褐夫。\n荆山宁泣玉，沧海任遗珠。\n宽博形何散，龙钟智似愚。\n藏渊祇自媚，韫椟肯求沽。\n雅志褰裳蹈，旁观按剑无。\n我知韦布乐，应不艳金朱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32804,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"堕泪碑","author":"林希逸","text":"叔子今何在，风流缓带时。\n伤心因睹物，堕泪遂名碑。\n剥落银钩古，凄凉玉箸□。\n生前驱万马，身后立双螭。\n人物襄阳记，莓苔太白诗。\n羊公岂无德，戎衍却堪悲。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32805,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"杏坛","author":"林希逸","text":"反袂伤麟后，凄凉旧日坛。\n尚为人爱惜，不使杏彫残。\n叶映缁林好，枝横泗水寒。\n一从梁木去，多把落花看。\n自昔棠思召，于今木有韩。\n遥知槐并并，根古似龙蟠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32806,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闻鸡起舞","author":"林希逸","text":"龙卧何时起，生涯厌鼓鼙。\n舞因随独鹤，闻偶为荒鸡。\n楚客长更梦，秦关未晓啼。\n竹风吹袂举，柳月傍楼低。\n我醉非无度，渠寒不奈栖。\n谁家小垂手，百啭听黄鹂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32807,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"围棋赌墅","author":"林希逸","text":"太傅筹边日，家庭赌墅时。\n淮淝千载事，秦晋一番棋。\n得算如翁妙，争先落子知。\n汝能输别业，我已笑胡儿。\n昙得山先喜，氐争局自痴。\n两军临水处，幼度著尤奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32808,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"西狩获麟","author":"林希逸","text":"西狩知何获，惊嗟遍国人。\n自怜方叹凤，何事又逢麟。\n伊昔追戎地，于今较猎频。\n三家如此僣，一角岂为珍。\n笔绝真伤鲁，书成已系秦。\n同时多虎辈，谁信兽能仁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32809,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"五言长城","author":"林希逸","text":"老子风骚将，雄豪霸一方。\n五言如壁立，万里此城长。\n气靡曹刘垒，声喧翰墨场。\n但令投帻去，谁诧撚须狂。\n羲笔图成阵，韩文喻倚墙。\n骚坛唯我擅，谁敢犯锋铓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32810,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"惜花春起早","author":"林希逸","text":"苦惜花能好，晴窗唤起频。\n只忧春去早，却要早寻春。\n一片飞愁我，千枝艳恼人。\n鸣鞭思晓月，化蝶逐香尘。\n醉卧狂谁子，吟看睡太真。\n每因风雨夜，不寝为渠颦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32811,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"爱月夜眠迟","author":"林希逸","text":"意爱多成癖，清秋怅望时。\n月能向人好，夜不恨眠迟。\n捣药何为者，停杯屡问之。\n貂裘蟾正恋，鸳枕蝶休痴。\n昼短何须烛，更寒且咏诗。\n婆娑无影处，料得梦相随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32812,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"登封泰山","author":"林希逸","text":"海畔山名泰，东封自昔曾。\n三千馀载记，七十二回登。\n冕辂陈金策，衣冠迫玉绳。\n秘书留岁月，立视俯丘陵。\n华盖行中阪，松官立几层。\n祖龙空刻石，千载笑冥升。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32813,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"棋声花院闭","author":"林希逸","text":"花院重重闭，香风拂面轻。\n游观多野趣，静听有棋声。\n松老藏孤寺，柯翁看几枰。\n反关从烂熳，落子自敲铿。\n得著僧应笑，栖枝鹊又惊。\n须臾闻剥啄，收局出相迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32814,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寒机晓犹织","author":"林希逸","text":"机上谁家女，更长睡不安。\n当窗祇自织，到晓不知寒。\n霜瓦凝威重，冰丝续断难。\n梭声随漏尽，妾意为衣单。\n锦字挑谁寄，银缸剔已残。\n姑留刀尺久，零落待输官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32815,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"肃时雨若","author":"林希逸","text":"肃肃存吾敬，冥冥若有期。\n人皆欣雨若，心为有天知。\n悃切忧民志，勤拳在庙时。\n片云催许急，三祝果伊谁。\n方寸来何易，吁嗟礼亦宜。\n虚中求造化，事应不须唯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32816,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"鼠须笔","author":"林希逸","text":"安得如椽笔，晴窗弄鼠须。\n知渠来某氏，为我作尖奴。\n熏窒搜罗尽，精粗简拔殊。\n香沾窗下墨，腥带瓮中腴。\n食肉非无相，挥毫且共娱。\n生因斯恨汝，莫把篆临模。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32817,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"僧敲月下门","author":"林希逸","text":"深夜沉沉寂，谁行下岭坳。\n寺深明月照，门闭老僧敲。\n剥啄林间寺，婵娟云外梢。\n山童破幽梦，人影并疏茅。\n殿冷存馀篆，窗明待解包。\n山虚传谷应，惊鹊亦离巢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32818,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"笛里关山月","author":"林希逸","text":"笛里愁千绪，更长忆故山。\n今人吹古曲，汉月照秦关。\n霜竹和声切，胡床倨坐閒。\n一轮秋塞外，万嶂野云间。\n此夜听渠弄，何时照我还。\n回思帝城角，花影映朝班。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32819,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"隔竹敲茶臼","author":"林希逸","text":"兴入卢仝椀，龙团旋解包。\n忽闻茶臼响，正隔竹窗敲。\n活水烹新茗，香风度绿梢。\n听知童落杵，惊起鹊离巢。\n香比云英捣，清无水厄嘲。\n林深留客处，未羡巳公茅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32820,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"门多长者车","author":"林希逸","text":"窄窄柴门下，多应隐士居。\n时人皆障面，长者竞迂车。\n罗雀宁辞客，瓜牛旧有庐。\n高轩诗李贺，都骑赋相如。\n痛饮宜投辖，何心更曳裾。\n辛勤有此室，鄙矣羡金鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32821,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"师直为壮","author":"林希逸","text":"古有征无战，堂堂整六师。\n直哉能用壮，敌者欲何为。\n道在周如矢，兵行汉有旗。\n天威雷在上，人喜雨如时。\n敷德苗归舜，干盟鲁却夷。\n淮淝知义胜，算入谢安棋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32822,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"星陈天行","author":"林希逸","text":"法驾谁摸写，形容比太清。\n星陈元肃肃，天运自行行。\n阊阖开黄道，璇玑映玉衡。\n盖明瞻帝近，旗动认参横。\n移得魁台下，如闻警跸鸣。\n流光知遣使，招我立通明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32823,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"叫舜苍梧云","author":"林希逸","text":"叫舜嗟何处，梧江去路长。\n天高心渺渺，云远地苍苍。\n我欲排阊阖，谁能访帝乡。\n泪沾潇水碧，梦入瘴烟黄。\n莫唤湘娥问，空怜老杜狂。\n重华何可就，骚笔更凄凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32824,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山上有泽咸","author":"林希逸","text":"彼泽卑而汇，维山峻且巉。\n上应无见有，气以感而咸。\n石隐虚中窍，春蒸润下咸。\n画前分艮兑，象外识机缄。\n野露浮江柳，溪云到岭杉。\n个中皆易理，具眼要非凡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32825,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"君王画阵看","author":"林希逸","text":"圣世忧边切，骚骚羽檄忙。\n凯歌来幕府，画阵奏君王。\n宸陛千官庆，军书一卷长。\n捲舒从御榻，想像到沙场。\n此日丹青笔，当时赤白囊。\n会看麟阁上，图写更辉煌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32826,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"洗砚鱼吞墨","author":"林希逸","text":"携砚临流洗，迎人戏小鱼。\n忘机知似我，吞墨喜看渠。\n案上研磨久，池边浣濯初。\n黑翻波里影，素染腹中书。\n水与烟俱落，香知饵不如。\n谁能图罩罩，点笔滴蟾蜍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32827,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"烹茶鹤避烟","author":"林希逸","text":"隔竹敲茶臼，禅房汲井烹。\n山僧吹火急，野鹤避烟行。\n入鼎龙团碎，当窗蚓窍鸣。\n紫云飞不断，白鸟去边明。\n云舍飘犹湿，风巢远更惊。\n通灵数椀后，骑汝访蓬瀛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32828,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"敲云问名氏 其一","author":"林希逸","text":"避喧谁氏子，远近不知名。\n踏雨来相问，敲云忽自惊。\n空濛迷处所，剥啄访平生。\n不是师严钓，应须学尹耕。\n深山无户籍，虚谷答人声。\n野服徐迎客，论文到月明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32829,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"敲云问名氏 其二","author":"林希逸","text":"何意逃名氏，祇缘避俗纷。\n有人来隔岭，问我独敲云。\n剥啄声虽急，朦胧唤未闻。\n严耕应似子，说筑岂非君。\n瞥去鸦惊起，谁来稚答云。\n日高才出户，对客却慇勤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32830,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"滩声起鱼眼","author":"林希逸","text":"酒醒闻敲云，呼童汲水烹。\n龙头琢山骨，鱼眼起滩声。\n活水催泉急，凝波与石争。\n鳞无游釜见，目有比珠明。\n车异羊肠绕，蝇嗤蚓窍鸣。\n磨刀谁氏子，对此忆鲈羹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32831,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"叶带露痕书","author":"林希逸","text":"拾得阶前叶，提携近玉蜍。\n自呵冰冻笔，犹带露痕书。\n秋兴题红日，霜寒坠绿初。\n珠凝光细碎，墨淡字稀疏。\n滴砚研朱易，渲毫汗竹如。\n更乾虔亦喜，勤扫入僧庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32832,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"不下带道存","author":"林希逸","text":"自外元无道，抠衣乐圣门。\n能因机以悟，不下带而存。\n身俯心何愧，腰垂手可扪。\n步趋如有见，左右自逢原。\n鞶锡殊三褫，绅书味数言。\n垂鱼何足羡，愈以训儿孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32833,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赵庸斋挽诗 其一","author":"林希逸","text":"金章虽贵岂公荣，一点孤忠百世名。\n字字清吟如太白，篇篇奏疏似更生。\n士缘气类归宗主，身为朝廷作重轻。\n当世共传书几种，最初曾见易先成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32834,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赵庸斋挽诗 其二","author":"林希逸","text":"品题人物妙权衡，在日江湖有重名。\n为国得贤八君子，登门执贽几书生。\n少游辇路心交久，晚见南华口义成。\n欲序未酬诗卷在，相知可独是同庚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32835,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"信庵赵少保挽诗 其一","author":"林希逸","text":"勋名已盛端嘉日，身佩安危三十年。\n自去鸿枢开督府，迄辞鸱阁老平泉。\n早看养马封侯将，晚作骑鲸捉月仙。\n纵道进贤冠最好，不须画此上凌烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32836,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"信庵赵少保挽诗 其二","author":"林希逸","text":"长淮当日事尤危，孤垒身当数月围。\n杨子江头如虎卧，平山堂下似羓归。\n二难千载为时出，一战三京与愿违。\n赍恨伯符投镜去，追怀到老泪沾衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32837,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"信庵赵少保挽诗 其三","author":"林希逸","text":"百万频年战虎貔，神驰漠北到洮西。\n空馀八阵江头石，未见一丸关上泥。\n守父训辞黄阁去，负时名与紫岩齐。\n河山收此英灵气，下马千年看墓题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32838,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"信庵赵少保挽诗 其四","author":"林希逸","text":"出语无多动造微，公于学问似生知。\n客游槐府珍遗帖，世诵樗翁序近诗。\n握手最先门下士，伤心谁勒墓前碑。\n匆匆四十年间梦，忆到庐江下榻时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32839,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赵虚斋挽诗 其一","author":"林希逸","text":"两朝人物号耆英，九折崎岖亦饱经。\n几度拂衣心似石，重来曳履发如星。\n争名可是因文字，转臂堪嗟失典刑。\n何处藏山犹有史，悲笳幽咽若为听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32840,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赵虚斋挽诗 其二","author":"林希逸","text":"奥学深功在易通，御题褒句圣恩隆。\n成书自讲前无例，异论难齐久始公。\n辞有所之端可据，文无不变论尤工。\n皋比定集诸仙听，独惜丁宽道不通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32841,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"恕斋洪尚书挽诗 其一","author":"林希逸","text":"定是仙从天目来，少曾吟咏到襄淮。\n才名词伯班常伯，学问平斋授恕斋。\n华盖谩云邻翰苑，衮衣不许上瑶阶。\n海山纵好归何处，叹惜人间事好乖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32842,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"恕斋洪尚书挽诗 其二","author":"林希逸","text":"秀骨清姿玉雪同，几多星宿入心胸。\n风流王谢谈谐胜，家数常杨制诏工。\n坐政事堂无六丈，登文章箓似三洪。\n年来人物萧疏甚，玉座东西欠此翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32843,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"恕斋洪尚书挽诗 其三","author":"林希逸","text":"伊昔宸京握手初，横经公未到三衢。\n早班玉笋还先去，晚侍金华却共趋。\n思老有馀知笔健，病成应是为诗癯。\n峰摧太华嗟何及，身远无因奠束刍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32844,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"陈节斋挽诗 其一","author":"林希逸","text":"诸贤名并端平见，一老音存正始遗。\n改纪重来时领袖，持荷独立右尊彝。\n心忘世易身难乞，家著书多人少知。\n省闼才辞留史馆，可怜便入八哀诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32845,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"陈节斋挽诗 其二","author":"林希逸","text":"国重穆陵蒐钜典，帝咨宿学进隆名。\n那知幻境空花散，不待藏山史草成。\n笔冢长存堪怅恨，书棺何益谩哀荣。\n西山门第今无几，落尽残星泪眼盈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32846,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"陈节斋挽诗 其三","author":"林希逸","text":"早岁登门叨赏异，暮年造阙喜追陪。\n每从省户供词去，多向都曹诵句来。\n逐客赠年今尚在，痴儿别饮恰方回。\n湖边握手如前日，身隔千山叹玉埋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32847,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"李斛峰尚书挽诗 其一","author":"林希逸","text":"公擢端平第，祥开日下云。\n乾坤钟直气，星斗瑞斯文。\n出处关时运，更尝厌俗氛。\n白头需旧学，何事靳吾君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32848,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"李斛峰尚书挽诗 其二","author":"林希逸","text":"论著千年计，崎岖二纪馀。\n人多仇直疏，公不羡除书。\n曳履归何晚，仪图事竟虚。\n早知天许啬，恨不守茅庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32849,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"李斛峰尚书挽诗 其三","author":"林希逸","text":"中朝更几局，鸣世独铮铮。\n奏疏如山稿，哀笳何处声。\n虽孤岩石望，何损斛峰名。\n应有遗书富，何时见集行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32850,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"李斛峰尚书挽诗 其四","author":"林希逸","text":"当年期集所，一榜上三人。\n晚节惟公在，交情独我亲。\n楚东分袂久，溪上得书频。\n曾共茅檐宿，因行部入闽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32851,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"李斛峰尚书挽诗 其五","author":"林希逸","text":"三领闽麾节，名高德度宽。\n苦寻盐利病，痛念郡凋残。\n拟有回天奏，相期对日看。\n入朝孤此意，闻者泪阑干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32852,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"朔斋中书刘礼侍挽诗 其一","author":"林希逸","text":"声名早日到宸几，自许凌空健翮飞。\n朔党家传真抱负，西州人老几招麾。\n长庚穷杀狂如故，韩愈疑为傲则非。\n岁晚虽为香案吏，白头终与壮心违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32853,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"朔斋中书刘礼侍挽诗 其二","author":"林希逸","text":"再造功成始趣还，又从薇省去长安。\n登车屡作澄清使，持橐还须文字官。\n子美八哀俄入此，贺公二命只书棺。\n不知庾亮埋何处，遥想悲笳泪雨潸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32854,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"朔斋中书刘礼侍挽诗 其三","author":"林希逸","text":"一识端平三十秋，北关重别见南州。\n紫薇阁下分房住，黄檗山前并辔游。\n碧水诗来秋后得，吴门书去病中投。\n交情不薄相期远，底料催归记玉楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32855,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]