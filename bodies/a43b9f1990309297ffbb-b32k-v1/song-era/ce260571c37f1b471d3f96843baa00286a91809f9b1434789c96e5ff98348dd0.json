[{"title":"湖南江西道中十首 其十","author":"刘克庄","text":"上封已失岳僧期，客问丹霞谢不知。\n懒到登山临水处，始惊筋力减来时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30562,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湖南江西道中十首 其九","author":"刘克庄","text":"派里人人有集开，竞师山谷友诚斋。\n只饶白下骑驴叟，不敢勾牵入社来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30563,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湖南江西道中十首 其八","author":"刘克庄","text":"茫茫衰草与云平，斗气千年不复明。\n惟有多情篷上月，相随客子过丰城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30564,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湖南江西道中十首 其七","author":"刘克庄","text":"每嘲介甫行新法，常恨欧公不读书。\n浩叹诸刘今已矣，路傍乔木日凋疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30565,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湖南江西道中十首 其六","author":"刘克庄","text":"丁男放犊草间嬉，少妇看蚕不画眉。\n岁暮家家禾绢熟，萍乡风物似豳诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30566,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湖南江西道中十首 其五","author":"刘克庄","text":"蛮府参军鬓发苍，自调欸乃答渔郎。\n从今诗律应超脱，新吸潇湘入肺肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30567,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湖南江西道中十首 其四","author":"刘克庄","text":"去年冬至投僧寺，今岁阳生宿店家。\n独夜无人堪晤语，青灯相对结寒花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30568,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湖南江西道中十首 其三","author":"刘克庄","text":"少陵阻水诗难继，子厚游山记绝工。\n断璧残圭零落尽，新碑无数满湘中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30569,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湖南江西道中十首 其二","author":"刘克庄","text":"贾生废宅草芊芊，路出长沙一怅然。\n今日洛阳归不得，招魂合在楚江边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30570,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湖南江西道中十首 其一","author":"刘克庄","text":"独醒公子去沉湘，未识人间有醉乡。\n酒与离骚难捏合，不如痛饮是单方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30571,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湘中口占四首 其四","author":"刘克庄","text":"津吏沙边立指呼，放船出锁要州符。\n书生行李堪抽点，薏苡明珠一例无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30572,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湘中口占四首 其三","author":"刘克庄","text":"江边金碧谩层层，户口稀疏塔庙增。\n楚俗不知黄面老，家家香火事湘僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30573,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湘中口占四首 其二","author":"刘克庄","text":"船头吹火卢仝婢，马后肩书颖士奴。\n安得世间名画手，写予出岭泛湘图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30574,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湘中口占四首 其一","author":"刘克庄","text":"少年裘马事清狂，晚看梅花到瘴乡。\n一任海风吹面黑，免教人谤作何郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30575,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湘潭道中即事二首 其一","author":"刘克庄","text":"败絮龙钟拥病身，十分寒事在湘滨。\n若非野店黏官历，不记今朝是立春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30576,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"琨逖","author":"刘克庄","text":"迁乔不与莺争出，殿后犹云马不前。\n越石早知无合杀，不如且让祖生鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30577,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登城五首 其五","author":"刘克庄","text":"郭外皆鲸浸，区中等蚁窠。\n若无西雁翅，客子奈愁何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30578,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登城五首 其四","author":"刘克庄","text":"漫费人蒸土，常如物溃堤。\n傍疑为息壤，下恐有蟠泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30579,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登城五首 其三","author":"刘克庄","text":"汉人称劲粤，累世不加兵。\n狂卒才三百，如何便缒城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30580,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登城五首 其二","author":"刘克庄","text":"已作南夷长，那为北面臣。\n未忘真定冢，毕竟是华人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30581,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登城五首 其一","author":"刘克庄","text":"尉佗故秦吏，堪执酂侯鞭。\n箕踞问使者，吾方帝孰贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30582,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"短章二首 其二","author":"刘克庄","text":"衰残齿易宿，陈腐意难新。\n安知痴老子，非复旧词臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30583,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"短章二首 其一","author":"刘克庄","text":"少日喜累句，暮年多短章。\n假令重盛壮，展拓不能长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30584,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答上饶江涛","author":"刘克庄","text":"赵叟万篇韩半之，江湖尤重两贤诗。\n不须负笈行千里，回首东家自有师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30585,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答妇兄林公遇四首 其四","author":"刘克庄","text":"挹君如玉雪，未易得亲疏。\n何日深山里，同灯共读书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30586,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答妇兄林公遇四首 其三","author":"刘克庄","text":"自笑如穷鬼，相从不记年。\n每烦诗饯送，不止办车船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30587,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答妇兄林公遇四首 其二","author":"刘克庄","text":"恨余行李速，愧子酒杯长。\n日暮于谁屋，天寒陟彼冈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30588,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答妇兄林公遇四首 其一","author":"刘克庄","text":"霜下石桥滑，蛩吟茅店清。\n梦回残月在，错认是天明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30589,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答杨公朝","author":"刘克庄","text":"昔抱遗编事悦堂，蟆陵宰树想荒凉。\n问君乡土生悲感，家住秦溪又姓杨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30590,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答郑闽清","author":"刘克庄","text":"多著襦裙少裹巾，形容苍槁意清真。\n旧时论语都忘记，难做深衣社里人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30591,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答惠州曾使君韵二首 其二","author":"刘克庄","text":"先贤平易以观诗，不晓尖新与崛奇。\n若似后儒穿凿说，占人字字总堪疑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30592,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答惠州曾使君韵二首 其一","author":"刘克庄","text":"潇洒使君风度峻，神仙谪堕在人间。\n只今坐啸凝香处，帝赐罗浮作镇山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30593,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"紫薇花","author":"刘克庄","text":"风标雅合对词臣，映砚窥窗伴演纶。\n忽发一枝深谷里，似知茅屋有诗人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30594,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"落花怨十首 其十","author":"刘克庄","text":"谢女吟边絮，英台去日衣。\n不应零落尽，惟见蝶儿飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30595,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"落花怨十首 其九","author":"刘克庄","text":"已费栽培力，又为膏沐容。\n花神浑忘却，将谓属东风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30596,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"落花怨十首 其八","author":"刘克庄","text":"徐庾空浮艳，何曾有一篇。\n我朝惟二宋，绝唱两三联。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30597,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"落花怨十首 其七","author":"刘克庄","text":"天女殷勤散，风姨僝僽空。\n儿童扫落叶，蜂蝶抱枯丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30598,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"落花怨十首 其六","author":"刘克庄","text":"开遍千红紫，东皇力最多。\n朱明笑青卉，无奈百花何。","collection":"宋","notice":"","pr