[{"title":"夜雨","author":"陈造","text":"窗声呼梦断，灯影尚微茫。\n忽扫蚊专夜，从知雨献凉。\n佳眠嗟莫续，残漏耿犹长。\n却忆檠三尺，冯书怯曙光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19499,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜宿商卿家","author":"陈造","text":"萑蒲无警南塘静，歉岁村讴鼓罢挝。\n更喜良宵共谭麈，几烦亲手剪灯花。\n酌无多酒仍馀味，懒不吟诗政自嘉。\n蝶梦蘧蘧才一霎，邻鸡啼罢又啼鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19500,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"官居二首 其二","author":"陈造","text":"官居不惜日，宰县动三年。\n忍事肠欲烂，为防头救燃。\n不应一饱计，长受众人怜。\n俛仰堪供笑，人间海易田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19501,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"官居二首 其一","author":"陈造","text":"磔磔初鸣晓，通通已报衙。\n拙勤知待旦，欺绐未停挝。\n漫役乡园梦，祇添老眼花。\n屈信庸敢计，斗禄倚生涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19502,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"定海四首 其四","author":"陈造","text":"官廨盐烟外，居人杂贾胡。\n听言须画字，讨海倚输租。\n习俗何妨陋，鲜肥颇不无。\n已甘三载住，畴昔计乘桴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19503,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"定海四首 其三","author":"陈造","text":"穫稻来硗埆，开篘荐碧香。\n地偏皆斥卤，汲井得甘芳。\n漫仕今千室，前人陋一乡。\n民安吾亦饱，相乐亦相忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19504,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"定海四首 其二","author":"陈造","text":"齿发今如此，东来料一寒。\n爱民平日事，宰县昔人难。\n稍得官租办，聊容坐席安。\n渠侬趋负挽，疑未厌儿宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19505,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"定海四首 其一","author":"陈造","text":"县境拖脩直，人家住土涂。\n三方鲸浪涌，一岛虎头孤。\n风物犹佳处，弦歌付老夫。\n平生虫篆意，或许间忧虞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19506,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"定海县厅事落成致语口号","author":"陈造","text":"翚飞华屋酒如池，宾主风流况一时。\n千杖敲春琼斝滑，九霞摇晚舞衫僛。\n轻飔泛座漂香远，纤月窥人转影迟。\n牛女多情应羡客，瓜华适已罥珠丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19507,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"念衰","author":"陈造","text":"心意彫残底自娱，每临清镜笑头颅。\n诗从多病难为好，官过中年劣胜无。\n急景驱秋著髭鬓，归鸿衔梦下江湖。\n更应载酒高阳伴，误辍歌呼话故吾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19508,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"房州到任交倅事筵致语口号","author":"陈造","text":"平时风义等肩差，况此周旋别乘衙。\n湛渌徐倾卜夜酒，攲红同插殿春花。\n成规灿备堪从事，殊渥便蕃定拜嘉。\n烂醉长吟答佳致，不妨宾主各诗家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19509,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"武昌","author":"陈造","text":"客子脩程未息肩，江山佳处小留连。\n醉临庾亮楼前月，梦闯回翁洞里天。\n形势盘萦蹲虎凤，轮蹄隐轸度丝弦。\n登高欲赋还东望，楚些无因唤谪仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19510,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"苦雨再次前韵 其一","author":"陈造","text":"席蚓堂蛙岂赵城，崩空急雨未休倾。\n青秧可复成坚皂，碧海渠能受浊清。\n田舍望秋犹万一，官曹需禄更征营。\n宝熏定有回天力，即看朝曦指顾生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19511,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"苦雨再次前韵 其二","author":"陈造","text":"底用诗名到凤城，未妨醉帽笑攲倾。\n日闻螟蠃讥狂率，目送鲲鹏簉紫清。\n谭客有时三不对，生涯除酒一无营。\n鸣鞭走送君能断，小印亲封定好生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19512,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"虎丘","author":"陈造","text":"长日萧斋类蠹鱼，出门春事半销除。\n快舒中散飞鸿眼，稳憩文公卧虎庐。\n尘外风光诗笔底，竹梢禅榻茗瓯馀。\n归涂定有行人问，底许空青润客裾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19513,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"试柘枝溪上","author":"陈造","text":"蕙风花气雨馀天，报答融和玉作船。\n壮岁自能鸲鹆舞，老狂犹有柘枝颠。\n群鸿翩度昆昭锦，双凤翔从玉井莲。\n起我少时豪侠兴，未甘诗客号臞仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19514,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"试院赠三同官","author":"陈造","text":"果饤茶瓯意未阑，独惭衰鬓映朱颜。\n聚头长作三更语，屈指惟馀两日闲。\n食叶蚕声行入听，探珠骊颔不应悭。\n预怜朱墨秋宵永，咫尺灯窗断往还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19515,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"述怀再次韵","author":"陈造","text":"高车驷马笑鸡栖，亦笑餔糟与汩泥。\n鲁酒得间聊复饮，晋舆投老偶然题。\n春冰自水收新悟，雨矢无乡悔旧迷。\n尚有平生山水癖，未妨游戏向京西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19516,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"金地寺","author":"陈造","text":"侧径崎岖去，飞萝次第扪。\n山横欲无地，路转却逢村。\n竹柏围荒寺，莓苔上缭垣。\n残僧不知客，芋火老云根。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19517,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨后病起二首 其二","author":"陈造","text":"小卧竹间斋，幽怀得好开。\n病从凉后减，雨及望时来。\n两屩山千叠，诸雏饭一杯。\n吾生计此耳，无梦到燕台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19518,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨后病起二首 其一","author":"陈造","text":"旱岁仍无麦，淮民食正艰。\n几时占雨信，今日破天悭。\n尽息田家叹，聊开病客颜。\n何由长岁稔，金火莫循环。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19519,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"饯赵伯卫赵有诗次其韵","author":"陈造","text":"雪后垂杨袅绿丝，邮亭折赠诉违离。\n明朝月地嗟分影，胜日风流此一时。\n白閤论诗成梦境，清湖载酒有心期。\n樽前拟倩如椽笔，细与邦人写去思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19520,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"复次韵寄程帅二首 其二","author":"陈造","text":"人家禊祓竞攀追，刺史春游正此时。\n羯鼓声中花作锦，壶筹多处酒为池。\n绝须丝竹娱安石，剩有篇章付雪儿。\n闻道续貂容下客，老无佳句坐荒嬉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19521,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"复次韵寄程帅二首 其一","author":"陈造","text":"节物匆匆可挽追，直须乐事趁芳时。\n行春倏喜花围屋，借景何殊月在池。\n对酒不无桃叶女，扣舷却笑木肠儿。\n山家有约须重到，定放游人张水嬉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19522,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"复程平叔","author":"陈造","text":"早岁雄文手自编，偶同闻喜听钧天。\n漫为官去吾何取，肯寄诗来子定贤。\n潘岳自怜头易白，士安况苦病相缠。\n羡君身健须如漆，万里亨衢稳著鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19523,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"客中","author":"陈造","text":"多夜淮濒梦，言归未有期。\n愁禁客舍雨，寒过杏花时。\n酒废无何饮，春如不自持。\n若为丹九转，能黑镜中丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19524,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"客次小憩","author":"陈造","text":"竹屋深明许息肩，田家延客解欣然。\n霜枝高挂赪虬卵，风砌初摇白玉钱。\n得饱祇疑珠作粒，汲深仍诧乳为泉。\n谭间更笑狂沮溺，政复知津未是贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19525,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"客路寄崔帅","author":"陈造","text":"笑语生春慰老怀，邹枚端复顾凡才。\n酒边徐罢长鲸吸，梦里还惊去鹢催。\n野渡水浑妨转柂，霜林寒浅未逢梅。\n神驰缥缈凝香地，却惜无人为挽回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19526,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"思归","author":"陈造","text":"薄宦随漂梗，流光任迅湍。\n家山蝶梦隔，节物雁空寒。\n抚事频回首，微吟小凭栏。\n多情但乌鹊，时肯报平安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19527,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日客中二首 其二","author":"陈造","text":"芳时已叹鬓毛斑，何况栖栖客路间。\n杯酒故人千里隔，锦囊著语一春闲。\n燕莺飞处频回首，桃李香前合厚颜。\n昨夜东风贷庭竹，少容归梦到家山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19528,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日客中二首 其一","author":"陈造","text":"平时谩说醉为乡，对景今如石作肠。\n老去犹兴客中叹，春来刚制酒边狂。\n露桃烟柳为谁好，蜂蜜燕泥徒自忙。\n红紫打围歌笑地，暮年多感怕思量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19529,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春雨赠陈主管","author":"陈造","text":"初宵微月尚窥檐，雨脚斜斜晓入帘。\n春谢欢悰风处减，愁将老色镜中添。\n颇思甫里陪觞咏，不叹周南更滞淹。\n倚赖宗盟慰牢落，得闲诗笔未妨拈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19530,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春晚郊外","author":"陈造","text":"轻云阁雨不成飞，稍喜行轩贷夹衣。\n帝里园林春欲老，人家帘幕燕初归。\n沧湾潮应沙痕瘦，碧陇烟生麦浪肥。\n眼底湖山聊著句，那忧乐事与心违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19531,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"皇孙寿诗二首 其二","author":"陈造","text":"曾簉蓬莱挹德风，日亲儒保罄寅恭。\n学穷奥阃包贤圣，人仰英明肖祖宗。\n綵服近天仍乐孺，帝觞拜赐更从容。\n应刘寿语年年事，九万香笺未阙供。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19532,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"皇孙寿诗二首 其一","author":"陈造","text":"宝祚煌煌羡帝祺，天潢馀润到孙枝。\n寿星良月占重见，振古熙朝此一时。\n椽笔纪祥芳草颂，龙楼开笑正含饴。\n萝图况与乾坤永，长款三宫奉玉卮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19533,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋日","author":"陈造","text":"梦蚁浪多忧，隙驹如许遒。\n凄凉一霜早，黄落万山秋。\n得失古青简，漂零予白头。\n不因多病过，始觉此生浮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19534,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贺二石登科","author":"陈造","text":"捷音西下亟蜚星，二隽辞锋旧莫京。\n桂树前宵减清影，棣华同日擅香名。\n谢家兰玉真门户，苏氏文章亦弟兄。\n此去提衡霄汉上，鹏抟鲲运更论程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19535,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贺程帅因任四首且言久缺诗筒之意 其一","author":"陈造","text":"恩纶蜚下汉江滨，特许襄民借寇恂。\n千里江山皆动色，列城条教再生春。\n灌瓜夙稔安边策，茹草宁无待哺民。\n方倚金城亲邵父，近君宁惜小逡巡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19536,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贺程帅因任四首且言久缺诗筒之意 其四","author":"陈造","text":"先生一笔将诗坛，庋匮珠玑底坐悭。\n平日鸥盟当未慭，于今雁足每空还。\n传抄可但闻平水，老瘦从知笑饭山。\n缓带轻裘祇常日，千篇破竹定乘闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19537,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贺程帅因任四首且言久缺诗筒之意 其三","author":"陈造","text":"肯优襄岘劣南徐，行止平时每裕馀。\n荷紫端宜冠鸳鹭，飞黄犹似顾蟾蜍。\n缅怀夜烛赓清唱，况许春郊载后车。\n从此追陪得如愿，重分膏馥泽空虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19538,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贺程帅因任四首且言久缺诗筒之意 其二","author":"陈造","text":"诗律宁惟似变风，姓名久矣御屏中。\n逢辰千载合致主，入梦九华仍插空。\n铁瓮倚听新号令，铜蹄终舞旧儿童。\n烦?叶气成丰岁，却簉皋夔侍舜瞳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19539,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赵使君淮春楼落成二首 其二","author":"陈造","text":"步帐高牙置下方，华筵云影入风裳。\n西山爽气珠帘外，北海芳樽锦瑟傍。\n宾主前闻无胜事，簪钿明日剩馀香。\n一天和气谁拘检，付与邦人作醉乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19540,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赵使君淮春楼落成二首 其一","author":"陈造","text":"五凤规模到眼中，摘星奇观欲争雄。\n客乘云气游三岛，人听歌声指半空。\n便拟瑶杯酌银汉，何妨醉面受天风。\n胡床不尽登临兴，未觉邦君后庾公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19541,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送七子赴省","author":"陈造","text":"旋转玑衡运化枢，嗣皇袭六待耆儒。\n斗南誉望俱难匹，邺下才华旧不孤。\n郡赋今推作者并，王庭可但诤臣趋。\n竹林昔隐休回首，四辅三公此首涂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19542,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送人赴试","author":"陈造","text":"之子是荆璞，温纯仍琢磨。\n诸公推大手，壮岁合贤科。\n豹雾三年隐，龙门一跃过。\n得诗应自慰，老子阅人多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19543,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送严上舍并寄诸公十首 其一 送严","author":"陈造","text":"啧啧雁声急，棱棱秋意深。\n行都旧新雨，独客短长吟。\n子肯怜衰病，时来慰滞淫。\n惜无移日酒，留照蜡灯斟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19544,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送严上舍并寄诸公十首","author":"陈造","text":"严子老且健，翩然湖外行。\n归来困一跌，悲啸念馀生。\n幸弃扶衰杖，几成折足铛。\n开笼出双鸟，身已御风轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19545,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送严上舍并寄诸公十首 其二 寄俞君任府判","author":"陈造","text":"交际论才业，何郎种种长。\n元推万人敌，况别四年彊。\n文看青钱中，诗须古锦藏。\n西归容盥读，老境借辉光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19546,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送严上舍并寄诸公十首 寄何解元","author":"陈造","text":"旧识追风足，低摧坂下车。\n长驱待云路，小捷已乡书。\n唾手须科第，差肩有诏除。\n公馀富佳句，记我浑樵渔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19547,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送严上舍并寄诸公十首 其一 寄张次夔县丞","author":"陈造","text":"闻道张夫子，还家俗累轻。\n两官终短袖，五字屹长城。\n龙断悲人世，烟云写物情。\n只今遥夜月，独许伴空明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19548,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送严上舍并寄诸公十首 其二 送严","author":"陈造","text":"自昔金陵幕，周旋未尽能。\n凄凉论阀阅，突兀擅声称。\n直己堪从事，公言不负丞。\n嗣当蜚鹗牍，留眼看依乘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19549,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送严上舍并寄诸公十首 其二 寄赵景安府判","author":"陈造","text":"忆访俞夫子，频烦挽袖留。\n酒边无俗物，尘外有高楼。\n未醉催歌扇，言归听漏筹。\n此欢谁与继，怊怅岁时遒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19550,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送严上舍并寄诸公十首 其一 寄俞君任府判","author":"陈造","text":"暇日诗成集，西来见未曾。\n金徽想流水，玉井定层冰。\n呵护山灵惜，流传纸价增。\n石湖千载托，密密续前灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19551,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送严上舍并寄诸公十首 其一 寄赵景安府判","author":"陈造","text":"已种河阳柳，将题晋客舆。\n论交记曩昔，因使问何如。\n拥烬应多暇，援毫不一书。\n诗成当属我，拜赐衮褒馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19552,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送严上舍并寄诸公十首 其二 寄张次夔县丞","author":"陈造","text":"赵子趋吴幕，予偕咏舞雩。\n迄今推毂力，不堕拾尘诬。\n鬓脚今全白，车轮欲半朱。\n何阶答知己，冰檗耐穷涂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19553,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送张文昌帅豫章二首 其二","author":"陈造","text":"谈间宾客重宣州，到后儿童敬细侯。\n薤本击彊休领揽，棠阴问俗见风流。\n湖连市屋疑丰乐，江绕城闉似石头。\n鸥鹭要盟公莫信，江湖祇许半年留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19554,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送张文昌帅豫章二首 其一","author":"陈造","text":"倚俟新年转化钧，昼方三接径抽身。\n平时但有凝香梦，盛世那无勇退人。\n滕閤宾筵时可醉，金华诗令看重新。\n盍思远迩商霖望，不但淮乡有涸鳞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19555,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送李元英还常熟从周宰读书","author":"陈造","text":"久趼寻师足，还家讫受经。\n可容轻日力，政使带朝星。\n高步须堂奥，它年看典刑。\n奉亲时得笑，馀事赐袍青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19556,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送学生归赴秋试因省别业三首 其三","author":"陈造","text":"食口几鹅雁，田收问菜麻。\n宁堪再揽减，又抱两呕鸦。\n投老怜漂泊，何时了贷赊。\n终惭陶靖节，归不计生涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19557,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送学生归赴秋试因省别业三首 其二","author":"陈造","text":"年事真无赖，官曹已惮烦。\n儿堪付门户，吾粗有田园。\n游旧因相问，襟怀为细论。\n此心归隐计，日日受风幡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19558,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送学生归赴秋试因省别业三首 其一","author":"陈造","text":"凉意苏残梦，催儿起问涂。\n功名数前辈，术业旧原夫。\n漫触烟楼破，应先老骥驱。\n蠲痾吾有待，端不倚岐卢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19559,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送诗陈惠伯","author":"陈造","text":"危楼深室桂为堂，题品端宜虎豹章。\n历数诸公皆大手，尚须此老索枯肠。\n驰神几夜层虚上，血指如今妙斲傍。\n聊复送君供覆瓿，未须传到郑公乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19560,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送高缙之归谋武林结课二首 其二","author":"陈造","text":"辐辏群英地，皇州异别州。\n能文才倚马，作意付焚舟。\n士价知名下，医门要担头。\n明年春雁足，询我贺书邮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19561,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送高缙之归谋武林结课二首 其一","author":"陈造","text":"眼底论人物，如君亦壮哉。\n作书犹乞米，造物不怜才。\n跋履妨诗笔，祛除近酒杯。\n飞尘栖剑室，归棹莫迟回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19562,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送臧汝舟楚州秋试","author":"陈造","text":"羡杀君家有两方，阿戎材干更昂藏。\n久知笔力能扛鼎，此去贤书定探囊。\n邻近玉渊尝借润，眼中珠树看争芳。\n旧陪众俊工飞动，老气因君尚激昂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19563,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"郝泽民主簿赠诗次韵二首 其二","author":"陈造","text":"薄宦年来尚转蓬，忍将荣悴问虚中。\n共怜杜老谙为客，不讶元忠厌作公。\n胜日笑谭方衮衮，残冬光景苦匆匆。\n棋枰得隽诗反水，谁信吾徒旧讳穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19564,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]