[{"title":"赵县丞挽词","author":"楼钥","text":"玉立佳公子，哦松始戍瓜。\n拳拳饬边琐，寸寸画江沙。\n慷慨志忧国，清修僧在家。\n送行诗尚湿，身世遽空华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25279,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赵待制挽词 其二","author":"楼钥","text":"诗近刘宾客，手追欧率更。\n双旌古良吏，万卷老书生。\n世谛浮云薄，生缘晓梦惊。\n吁嗟东向议，何日遂施行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25280,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赵待制挽词 其三","author":"楼钥","text":"半世谁知己，登门意气倾。\n交情忘父行，文会忝余盟。\n持论先忠厚，谈经叹老成。\n幽光谁为发，落笔泪纵横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25281,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赵待制挽词 其一","author":"楼钥","text":"明主昼三接，清班岁九迁。\n一居周柱史，径入汉甘泉。\n批敕严东省，抡材上小天。\n平生经国志，惜不冠貂蝉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25282,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赵资政园梅篆","author":"楼钥","text":"小径回环里许长，寒梅森列间疏篁。\n路如古茧萦缪篆，身似轻烟缭印香。\n九折坂中经蜀险，八盘岭上趁朝忙。\n归来游戏通幽处，笑看危途九太行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25283,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赵提荆挽词 其二","author":"楼钥","text":"处事才游刃，论文辩粲花。\n英姿凛熊豹，健华走龙蛇。\n持橐身终外，垂车梦到家。\n平泉花木在，愁绝旧生涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25284,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赵提荆挽词 其三","author":"楼钥","text":"客授早登龙，襟期一笑同。\n门清心似水，论正气如虹。\n近问书犹湿，重来迹遂空。\n无因送丹旐，老泪洒西风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25285,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赵提荆挽词 其一","author":"楼钥","text":"毓秀从天派，盱衡动至尊。\n使星方炳耀，卿月遽侵昏。\n已矣悲吴馆，谁欤护北门。\n庆源流未艾，文献蔼诸孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25286,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赵路铃挽词 其一","author":"楼钥","text":"蚤岁游金阙，霞冠拜紫宸。\n可堪天宝乱，及见会昌春。\n宛宛王孙态，飘飘物外身。\n灵光怆陈迹，遗老更何人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25287,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赵路铃挽词 其二","author":"楼钥","text":"诸父论交久，忘年许与盟。\n登山陪蹑屐，泛月共飞觥。\n来往开三径，安闲羡一生。\n山深凄薤露，愁忆醉歌声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25288,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送人之官池州","author":"楼钥","text":"春空吹雨作馀寒，去去扁舟不可扳。\n伊昔曾游三大水，到今独记九华山。\n想君脉脉征途远，属我悠悠梦境閒。\n回首江山固无恙，怀人倚待好诗还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25289,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送从子渊宰浦江","author":"楼钥","text":"谁云宦路足岖嵚，送子之官独放心。\n廉介有馀无矫亢，谦恭已甚自崇深。\n安舆何用资三釜，庆问时能抵万金。\n公退读书三子侍，县斋松竹已成林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25290,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送从子渊葬","author":"楼钥","text":"晨起霜如雪，天寒水欲冰。\n引舟拖急濑，扶杖历危层。\n北阮苦多事，二疏俄丧朋。\n山阿埋白璧，悲恸不能胜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25291,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送元积弟赴永嘉酒官 其一","author":"楼钥","text":"宦游五载住中川，似与邦人有夙缘。\n昔日江山知好在，旧游人物想依然。\n吾衰无复逢梅福，子去惟应梦阿连。\n或问故侯霜鬓未，为言潘令是齐年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25292,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送元积弟赴永嘉酒官 其二","author":"楼钥","text":"我家清白世相传，工部真清更有年。\n百口未曾营活计，一生惟喜种心田。\n吾方奉母耕绵上，子更移封向酒泉。\n兄弟凋零期自勉，只将家训作青毡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25293,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送元积弟赴淮东总属 其一","author":"楼钥","text":"南徐来往饱经过，总饷宾寮入礼罗。\n子去幸陪邹湛辈，君今还是伯休那。\n金闺通籍时方可，铁瓮名城景最多。\n我有净名遗记在，试从万井访维摩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25294,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送元积弟赴淮东总属 其二","author":"楼钥","text":"十人兄弟五人存，心事方欣得细论。\n可但衰迟怜远别，祇因喜惧有慈尊。\n倚门何止期吾子，发策还知望好孙。\n从此三年风雨夜，寂寥棋局与清樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25295,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送内弟汪作德赴建德主簿","author":"楼钥","text":"今日望春下，送春还送行。\n簿书须著意，家世有馀清。\n潇洒桐庐郡，文章陆士衡。\n公馀定多暇，无废读书声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25296,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送内弟汪耐翁随侍因赴临川推官","author":"楼钥","text":"之子长才盍要津，未知此别几经春。\n且为湓浦过庭子，径作临川入幕宾。\n生长外家身已老，周旋中表意尤亲。\n从今家问须情实，莫事虚文学外人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25297,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送王仲言添倅海陵 其二","author":"楼钥","text":"遂初陈迹遽凄凉，击叹青箱极荐杨。\n谈笑于侬情易厚，典刑使我意差强。\n重屏旧画论中主，古殿遗文话阿章。\n旧事从今向谁得，尺书时许到淮乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25298,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送王仲言添倅海陵 其一","author":"楼钥","text":"万卷诗书老雪溪，颀然二子和埙篪。\n绝怜伯氏久亡矣，犹幸夫君及见之。\n来上鹓行人谓晚，往舒骥足自嫌迟。\n他时还向云门否，布袜青鞋尚可期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25299,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送王伯奋守筠阳","author":"楼钥","text":"三槐名德萃清门，七叶为州赖有君。\n道院无忘山谷赋，郡斋当继颍滨文。\n君应膝上怜文度，我向东床忆右军。\n振起家声差易耳，便看奏最蹑青云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25300,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送乐清姚令行可","author":"楼钥","text":"长官清政玉无瑕，卓鲁循良不足誇。\n前席有期吾党喜，挽须无路邑人嗟。\n才高雁荡千峰石，惠足河阳一县花。\n欲信三年浑不扰，游山今日始携家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25301,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送吕周辅宗丞守崇庆 其一","author":"楼钥","text":"从昔传家学，当今良史才。\n声名冠西蜀，风节象东台。\n朝迹收何速，归心挽不回。\n一麾从此去，万里可能来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25302,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送吕周辅宗丞守崇庆 其二","author":"楼钥","text":"旧矣唐安郡，龙潜府号新。\n当年一绛帐，今日两朱轮。\n民意来何暮，仁声煖似春。\n剑南毋恋却，鳌禁要词人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25303,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送安行表兄葬次韵","author":"楼钥","text":"深沈仙洞锁神清，万壑松声不似晴。\n宿草它年空怅望，生刍今日寓精诚。\n山川气象浑如旧，剑佩风姿俨若生。\n犹记玉音称酷似，始知无忌乃其甥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25304,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送朱季公倅严陵","author":"楼钥","text":"朱家族裔甲龙舒，循吏清名史特书。\n止为啬夫恩所部，至今庙食盛乡闾。\n舍人曾赋严公濑，季子方题仲举舆。\n但向棠阴增蔽芾，桐乡今却在桐庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25305,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送李伯和吏部提举浙东伯珍寺丞将漕夔门","author":"楼钥","text":"奕奕君家好弟兄，皇华交映棣华明。\n几年并列金闺彦，同日俱持玉节行。\n万里往临夔子国，一江先到越王城。\n会闻归取青毡旧，都似当年老贰卿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25306,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送杓孙随侍上虞","author":"楼钥","text":"阿斗生来十五年，未曾一日去翁前。\n闻诗勿废家庭问，习吏仍求城旦篇。\n婚宦有涯真是幸，巾箱所蓄要相传。\n荣罍虽小性非鲁，口授诗书加爱怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25307,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送杨晦叔提举浙西并寄陈表道","author":"楼钥","text":"两两郎星映使星，老人星彩对晶明。\n褰帷共喜行畿甸，洗印仍欣就帝城。\n五马况当恩始拜，三吴从此政尤清。\n便看瑞庆来称寿，同听嵩呼万岁声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25308,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送汪庄仲赴江东仓幕彊仲荆门签判 其一","author":"楼钥","text":"不见适斋老，于今三四秋。\n弟兄登宦路，亲党驻行舟。\n老病无诗思，衰怀重别愁。\n外家门户盛，勉力绍箕裘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25309,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送汪庄仲赴江东仓幕彊仲荆门签判 其四","author":"楼钥","text":"之子游何许，平州更玉州。\n山川称胜绝，幕府信风流。\n翠巘寒逾秀，金莲夜不收。\n天涯念乡国，少上仲宣楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25310,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送汪庄仲赴江东仓幕彊仲荆门签判 其五","author":"楼钥","text":"见说荆门地，如门蔽楚荆。\n旧时为内郡，今日号边城。\n但守平平策，毋求赫赫名。\n勉哉关决际，从此振家声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25311,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送汪庄仲赴江东仓幕彊仲荆门签判 其二","author":"楼钥","text":"外氏蒙恩厚，文昌独我知。\n居惭酷似舅，喜有宁馨儿。\n遇事行方便，褆身谨护持。\n公馀定多暇，黄卷有馀师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25312,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送汪庄仲赴江东仓幕彊仲荆门签判 其三","author":"楼钥","text":"蚤岁过秋浦，贪程不入关。\n君今参俭幕，时得上齐山。\n肤使资关决，贤侯伴宴閒。\n好音频寄我，赖此一开颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25313,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送汪强仲还官所","author":"楼钥","text":"又向丹丘去，安书易往还。\n固应官事了，莫放旧书闲。\n问讯雪巢老，寄怀巾子山。\n经行皆梦境，自笑日苍颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25314,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送苏伯昌大卿 其一","author":"楼钥","text":"禁路岧峣欲问津，抗章便自乞閒身。\n闵劳剧部皇情厚，寓直中奎宠数新。\n飞挽正资经济手，典刑终念老成人。\n赤松未许长为伴，归取青毡继颍滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25315,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送苏伯昌大卿 其二","author":"楼钥","text":"甬东曾幸拜苏天，外府官僚复备员。\n前辈风流真在眼，名公谈笑辱忘年。\n浙江相对一卮酒，婺港欲行双桨船。\n门键马衔难作远，西风停立但茫然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25316,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送陈君举守桂阳","author":"楼钥","text":"重寻漫壁认题名，十五年来一梦惊。\n谁料今朝携客至，却成此地送君行。\n桂阳卧治真谈笑，鲁史遗编赖发明。\n文定南轩仙去后，湖湘又得一先生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25317,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送陈表道倅岳阳 其二","author":"楼钥","text":"闻说巴陵好，楼高占古城。\n湖光千顷白，山色一螺明。\n赤壁沈沙戟，苍烟老树精。\n好诗收拾取，寄我慰离情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25318,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送陈表道倅岳阳 其一","author":"楼钥","text":"垂上青云去，如何乘贰车。\n轻为千里别，时寄几行书。\n剸剧才无滞，传家学有馀。\n当涂足知己，应不费吹嘘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25319,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送叔韶弟赴官钱清","author":"楼钥","text":"蕞尔钱清镇，兹行正为贫。\n九夷犹可处，十室岂无人。\n官守毋卑小，城居缓卜邻。\n老夫平日事，所至若终身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25320,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送叔韶弟宰华亭","author":"楼钥","text":"试邑云间事最多，直将心力细砻磨。\n固知三泖五茸胜，其柰千疮百孔何。\n敏手未须施霹雳，疲民正欲听弦歌。\n规模稳作三年计，徐上青云鬓未皤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25321,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送季舅汪江州 其一","author":"楼钥","text":"清直如公天自知，晚年百顺了无亏。\n九成台下方还旆，五老峰前又拥麾。\n题坐喜逢陈仲举，据床好继庾元规。\n太平散吏无由到，倚听中和乐职诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25322,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送季舅汪江州 其二","author":"楼钥","text":"舅甥相与自垂髫，游宦归来鬓已凋。\n坐上可无车武子，酒酣时赖盖宽饶。\n喜公自此驱千骑，顾我从今守一瓢。\n间与适斋同怅望，草堂樽酒幸清朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25323,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送范文叔礼部守彭州","author":"楼钥","text":"忧国鬓先雪，爱君心似丹。\n旌麾虽自适，怀抱未全宽。\n直道任三黜，故人怜一寒。\n濛阳毋久驻，旋复簉鹓鸾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25324,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送春 其二","author":"楼钥","text":"花披催蝶舞，柳暗受莺迁。\n过眼忽新梦，回头谁少年。\n溪云随笋供，山雨近梅天。\n诗思正无赖，一声来杜鹃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25325,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送春 其一","author":"楼钥","text":"飞花一片减风光，不待红稀意已伤。\n今岁馀春能几许，浮生此日更须忙。\n陇头有雨麦初秀，林下无人兰自芳。\n夜倚疏棂诵佳句，好风如水月如霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25326,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送胡巨济宰湘潭","author":"楼钥","text":"君向潇湘忽语离，江城离思乱云飞。\n传闻楚俗尤凋瘵，勿以秦人视瘠肥。\n宰县要寻行志处，监州空有负丞讥。\n此行得句须频寄，直到衡阳有雁归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25327,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送赵子固吏部帅合肥 其三","author":"楼钥","text":"襟带长淮地望崇，勋名当继古英雄。\n吴人止解依濡坞，晋将才能过八公。\n可但绥怀边境静，直须经略朔庭空。\n折冲不必居遐徼，颇牧尤当在禁中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25328,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送赵子固吏部帅合肥 其一","author":"楼钥","text":"少年文价重神京，游宦还闻政有声。\n南省但推韩吏部，北方犹问赵先生。\n人传殿上三千牍，上喜胸中十万兵。\n暂辍望郎分帅阃，淮南草木更知名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25329,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送赵至道节推","author":"楼钥","text":"君来入幕恰三年，我幸投闲识此贤。\n婉画时时因事见，素风凛凛信家传。\n易林律本君须寄，月窟天根语未圆。\n问讯难兄无恙否，相忘千里各瀛壖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25330,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送赵伯藏添倅永嘉 其二","author":"楼钥","text":"分教分符恰五年，异乡几若故乡然。\n归来几作池塘梦，送别欲随驺御仙。\n目断甘林应饱熟，手栽栾实想芳鲜。\n邦人若问老州牧，为说清霜绕鬓边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25331,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送赵南仲丞溧水","author":"楼钥","text":"不用匆匆恨别离，版舆春昼綵衣随。\n往题斯立蓝田壁，更访清真溧上诗。\n公事毋庸蘖牙角，邻封真是和埙篪。\n日哦新句频相寄，明月清风慰所思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25332,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送赵振文主簿","author":"楼钥","text":"去去江西不作难，片帆双桨荡秋澜。\n已知官业非时样，尤喜情亲耐岁寒。\n志大自然羞附骥，官卑何用叹栖鸾。\n少卿膝上加文度，更比年时刮眼看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25333,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送赵德老观文东归 其一","author":"楼钥","text":"趣还宗老侍经筵，宿望吁谟信岿然。\n引疾屡烦颁汉制，赋归先已买吴船。\n去年趋召叨同传，今日求闲愧著鞭。\n未得相随出关去，羡公徒御若登仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25334,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送赵德老观文东归 其二","author":"楼钥","text":"往还不过酒三行，成败同观棋一枰。\n东海敢言成二老，西湖自足度馀生。\n朅来便觉废兹事，归去定须寻旧盟。\n锦里锦坊秋色里，梦魂先已到江城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25335,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送赵德老端明帅蜀","author":"楼钥","text":"身名俱泰老尚书，叱驭宁辞万里途。\n两地恩荣真赫奕，四川父老定欢呼。\n乖崖袍带今重见，清献琴龟我更无。\n频向筹边楼上望，归来方略上新图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25336,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送倪正父侍郎使虏","author":"楼钥","text":"经帷亲见犯天颜，口伐何劳抗可汗。\n故国应悲周黍稷，遗黎犹识汉衣冠。\n殊邻谍报终难测，累岁要盟恐易寒。\n驰至金城上方略，始知颇牧在金銮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25337,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送倪正父尚书守南徐 其一","author":"楼钥","text":"君如春柳我如松，晚岁重逢意愈通。\n日日公馀搜理窟，时时史暇乐谈丛。\n友朋罕有心相照，兄弟惟应姓不同。\n此别未知何日见，掺袪无语对西风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25338,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送倪正父尚书守南徐 其三","author":"楼钥","text":"几回去国向吴兴，出处虽高事不平。\n兹以优恩临北固，不妨禁直寓西清。\n羡君决去行何速，愧我求归计未成。\n浙水东西又千里，壮怀堂上未忘情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25339,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送倪正父尚书守南徐 其二","author":"楼钥","text":"满腔忠膜与嘉谟，空洞它无一物馀。\n有语莫非忧国志，欲行犹上荐贤书。\n已欣勇退成清节，更喜高眠即故庐。\n廊庙须公经济手，不应敛惠向南徐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25340,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送秦仲防通判 其一","author":"楼钥","text":"清德曾瞻启庆碑，孙曾清更畏人知。\n祇缘一介弗轻取，坐使斯民不忍欺。\n濑水家传御书卦，宣城手写送行诗。\n典刑尚继金銮旧，马氏一门谁白眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25341,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送秦仲防通判 其二","author":"楼钥","text":"题舆再到海东涯，嗜学深于入幕时。\n一字未通终不置，五行俱下尚嫌迟。\n情亲端有卜邻意，别后空劳望月思。\n老我无因可重见，祝君来此拥旌麾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25342,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送淳尉海陵并寄示潚 其二","author":"楼钥","text":"处己幸寡过，居官勿愿馀。\n动成经岁别，剩寄几行书。\n公退仍多学，心清任索居。\n但知行所职，通塞听何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25343,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]