[{"title":"又次韵五首 其五","author":"张嵲","text":"心知公及暮春归，犹自思公肠九回。\n门外春流已如黛，行看飞骑过桥来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56306,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又次韵五首 其四","author":"张嵲","text":"行衣叶叶马萧萧，快意宁知归路遥。\n海上尖峰青似染，却从云外望岧峣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56307,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又次韵五首 其三","author":"张嵲","text":"行尽炎荒路向东，蛮村戍鼓夜逢逢。\n惜无王朔同登望，骑气应须似白虹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56308,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又次韵五首 其二","author":"张嵲","text":"离尤南去本无因，阴骘忠嘉自有神。\n敌国犹强谗间露，君王宵旰忆良臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56309,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又次韵五首 其一","author":"张嵲","text":"建溪南去自悠悠，溪上愁思逐水流。\n欲寄平安数行字，秋鸿飞不到炎州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56310,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与陈去非夏致宏孙信道游南涧同赋四首 其一","author":"张嵲","text":"策杖南涧边，菖蒲如绿发。\n石乱水流分，山空鸟声歇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56311,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山中月夜闻杜鹃忆鹿门旧游","author":"张嵲","text":"阴阴绿柳子规啼，风送馀声夜转悲。\n山月笼明兰气馥，恍然如在鹿门时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56312,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五月二十四日宿永睦将口香积院僧轩东望甚远满山皆松桧声三首 其三","author":"张嵲","text":"峰峦绵亘几千里，半霁半阴轻霭中。\n僧房借榻睡初足，满谷笙篁松桧风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56313,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五月二十四日宿永睦将口香积院僧轩东望甚远满山皆松桧声三首 其二","author":"张嵲","text":"烟岚云树两微茫，迁客西来正望乡。\n若值秋风小摇落，祇应无奈九回肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56314,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五月二十四日宿永睦将口香积院僧轩东望甚远满山皆松桧声三首 其一","author":"张嵲","text":"远投僧舍青烟畔，夹路松音钟磬幽。\n试倚危轩望乡邑，三巴日暮远峰稠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56315,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元日","author":"张嵲","text":"摧颓那觉是华年，城郭衣冠竞彩鲜。\n寒雨连天无事出，卧听檐溜似山泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56316,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"内人斜二首 其二","author":"张嵲","text":"山色依依水自流，内人斜畔最堪愁。\n荒榛蔓草萦寒骨，更有何人吊杜秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56317,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"内人斜二首 其一","author":"张嵲","text":"当日承恩向壁门，今同伧鬼落荒村。\n丘坟埋没生秋草，人事如斯讵可论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56318,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"劝农六首 其六","author":"张嵲","text":"夭桃无力卧溪沙，杨柳阴阴胜士家。\n下马欲知留客意，棠梨故作后开花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56319,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"劝农六首 其五","author":"张嵲","text":"鸟声撩乱喜春晴，诗思知随笔下生。\n桃李连村向零落，出墙犹有数花明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56320,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"劝农六首 其四","author":"张嵲","text":"春到逢花犹眼乱，老来对酒便心降。\n须知渴肺难禁醉，鸭绿潾潾酌玉缸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56321,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"劝农六首 其三","author":"张嵲","text":"春泥滑滑不须愁，勉事深耕定有秋。\n沓障东南知更好，归来频上郡城楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56322,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"劝农六首 其二","author":"张嵲","text":"皇恩力本劝农耕，老稚争随刺史行。\n杨柳垂村曲尘色，殊乡时节近清明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56323,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"劝农六首 其一","author":"张嵲","text":"出郭循溪路向东，隼旟悠飏满春风。\n峰峦沐雾尚阴澹，桃李出墙能白红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56324,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"双楠送何致远归陕西二首 其二","author":"张嵲","text":"日落边城旌旆愁，汉家铁马正防秋。\n慇勤送子西征路，弩力班超万里侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56325,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"双楠送何致远归陕西二首 其一","author":"张嵲","text":"乱后生涯似转蓬，何堪送客值秋风。\n含悽试看东归路，只见青山绕汉中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56326,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"心老得法天柱修静能道黄龙会中诸耆旧及他宗派知名士辛酉秋应供兹院刻意行道讫无应者明年夏末一日弃去将适焦山图岩以栖老焉丐余诗以行为作三绝句 其三","author":"张嵲","text":"口如布谷本无语，身似虚空何所还。\n观音岩迥出云雨，好住幽窗望小山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56327,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"心老得法天柱修静能道黄龙会中诸耆旧及他宗派知名士辛酉秋应供兹院刻意行道讫无应者明年夏末一日弃去将适焦山图岩以栖老焉丐余诗以行为作三绝句 其一","author":"张嵲","text":"经年于此忍朝饥，又见秋山草木腓。\n满口阳春无和者，却将锡杖向空飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56328,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"心老得法天柱修静能道黄龙会中诸耆旧及他宗派知名士辛酉秋应供兹院刻意行道讫无应者明年夏末一日弃去将适焦山图岩以栖老焉丐余诗以行为作三绝句 其二","author":"张嵲","text":"道人别我焦山去，拟卜穹岩毕暮年。\n帆来帆去澄江阔，我亦心驰落照前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56329,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"无住坟山溪水","author":"张嵲","text":"转山溪溜碧涓涓，一勺芳甘信所便。\n盖代伟人今卜宅，敬君还似老翁泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56330,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冒小雨晚出","author":"张嵲","text":"霜稻收馀垄亩空，雨容和雾晚溟濛。\n出门忽见丹青树，肠断家山柿叶红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56331,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出见桃花盛开","author":"张嵲","text":"青林拥萧寺，况乃在山阴。\n出见桃花发，方知春已深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56332,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出峡","author":"张嵲","text":"牵舟已出峡，何旦复当还。\n蒲溪应渐近，已见宋平山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56333,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出微王峡读子厚诗恍然偶作二绝句 其一","author":"张嵲","text":"西来一水古今绿，峡里诸山天下奇。\n非是愚溪溪上客，未应轻作此山诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56334,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出微王峡读子厚诗恍然偶作二绝句 其二","author":"张嵲","text":"惊湍绝壁穷天险，山水如斯世莫知。\n林邑峰峦瘴江水，发挥须待柳州诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56335,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"永康山","author":"张嵲","text":"嵯峨千仞永康山，石路终朝转屈盘。\n政恐乘高伤远目，忽然烟雾锁峰峦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56336,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"生口","author":"张嵲","text":"牵舟四日程，屈曲萦山转。\n行行问居人，始知犹近县。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56337,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"甲子初夏复开北户","author":"张嵲","text":"已向魏塘经四白，又开北户纳凉飔。\n祇应长作窗中客，会见蓬莱清浅时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56338,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"石竹","author":"张嵲","text":"石竹为花品最微，当时曾入谪仙诗。\n新葩竞发迷形似，紫蝶翩翾缀碧枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56339,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"立春偶题","author":"张嵲","text":"昔年长恨春归晚，及到春来又恐残。\n今日摧颓萧寺里，闭门一任岁将阑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56340,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"龙洞二首 其二","author":"张嵲","text":"岩树交柯如有意，欲将密叶蔽溪门。\n紫府沿源应不远，未知相去几程云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56341,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"龙洞二首 其一","author":"张嵲","text":"瀑溜落岩冰柱碎，迸珠跳沫似飞埃。\n西风更与游人便，时送轻尘洒面来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56342,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"兴州看月上","author":"张嵲","text":"城下沧波去不停，城头吹角作边声。\n去年此夜深闺月，今向兴州山上明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56343,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再次前韵六首 其六","author":"张嵲","text":"晴空杳杳冥鸿远，阿阁沉沉社燕回。\n酬酢风光堪一醉，却虞蜂蝶浪相猜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56344,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再次前韵六首 其五","author":"张嵲","text":"野泉决决贯城来，红紫商量次第开。\n尚想梅横却月观，遥知云雨暗阳台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56345,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再次前韵六首 其四","author":"张嵲","text":"乱蕊晚迎晴日暗，疏枝迥映暮山长。\n萧然一榻安禅夜，细雨轻风为发香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56346,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再次前韵六首 其三","author":"张嵲","text":"齐国馈时堪出走，东山携处未生憎。\n道人莫谓全无念，行乐须知此日曾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56347,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再次前韵六首 其二","author":"张嵲","text":"若认诸空犹是妄，莫言众有便非真。\n今朝试遣木居士，问取头陀庵里人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_