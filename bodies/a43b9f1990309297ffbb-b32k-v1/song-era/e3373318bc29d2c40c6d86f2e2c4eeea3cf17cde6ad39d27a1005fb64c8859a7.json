[{"title":"偈二十首 其九","author":"释鼎需","text":"独枕孤峰忘岁月，梧桐叶落始知秋。\n若知扑落非他物，始解纵横得自由。\n万仞悬崖丝系腰，百尺竿头独打翘。\n大洋海里骤骅骝，须弥顶上驾扁舟。\n好个通天作略，自然脱体风流。\n今朝有酒今朝醉，明日愁来明日愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21387,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二十首 其八","author":"释鼎需","text":"在凡全凡，在圣全圣。\n各各据本位，通达事理竟。\n譬如钟中无鼓响，鼓中无钟声。\n钟鼓不相参，句句无前后。\n若能于此彻根源，一任金毛唤作狗。\n忙忙途路未归人，切忌面南看北斗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21388,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二十首 其六","author":"释鼎需","text":"我观鹞子抟天飞，乌龟水底逐鱼儿。\n三个婆婆六个奶，金刚背上烂如泥。\n诸仁者，知不知。\n伯牙虽会弹，善听须子期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21389,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二十首 其五","author":"释鼎需","text":"堂堂兮巍巍，威威兮蕤蕤。\n手携兔角杖，脚踏石乌龟。\n来莫可抑，去莫可追。\n而今到此，合掌趺跪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21390,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二十首 其三","author":"释鼎需","text":"子能承父业，赚杀几多人。\n家破人亡后，无门寄此身。\n愁人莫向愁人说，说向愁人愁杀人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21391,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈四首 其三","author":"释鼎需","text":"心如皎月连天照，性似寒潭彻底清。\n无价夜光人不识，梦中虚度几千春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21392,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈四首 其二","author":"释鼎需","text":"懒翁懒中懒，最懒懒说禅。\n亦不重自己，亦不重先贤。\n又谁管你地，又谁管你天。\n物外翛然无个事，日上三竿犹更眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21393,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十七首 其八","author":"释鼎需","text":"盐贵米贱，诸事成现。\n拟欲商量，脑后拔箭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21394,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二十首 其十九","author":"释鼎需","text":"横按吹毛，虚张意气。\n冲开铁壁，枉费精神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21395,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二十首 其十八","author":"释鼎需","text":"行罗汉慈，破结贼故。\n行菩萨慈，安众生故。\n行如来慈，续慧命故。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21396,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二十首 其十二","author":"释鼎需","text":"世尊拈花，迦叶微笑。\n师铁得金，一场富贵。\n马祖升堂，百丈卷席。\n为众竭力，祸出私门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21397,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二十首 其四","author":"释鼎需","text":"欲得现前，莫存顺逆。\n屙屎送尿，多少省力。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21398,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二十首 其二","author":"释鼎需","text":"奔流度刃，未是作家。\n疾燄过风，犹为钝汉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21399,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二十首 其一","author":"释鼎需","text":"隈严遁谷，败种焦牙。\n应物随形，拖泥带水。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21400,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈四首 其四","author":"释鼎需","text":"十四十五，明明已露。\n更问如何，西天此土。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21401,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十七首 其二十","author":"释鼎需","text":"三人證龟成鳖，刚把天机漏泄。\n木人岭上唱歌，石女眼中滴血。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21402,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈四首 其一","author":"释鼎需","text":"便请从东过西，不妨水云自若。\n如其稍涉迟回，直是一槌粉碎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21403,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"释鼎需","text":"顶门竖亚摩醯眼，肘后斜悬夺命符。\n瞎却眼，卸却符，赵州东壁挂葫芦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21404,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二十六首 其二十六","author":"释嗣宗","text":"妙圆金地绝纤尘，到者当观无相真。\n莫道玄门难近向，举头便是塔中人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21405,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二十六首 其二十五","author":"释嗣宗","text":"一镞三关俱透脱，从前汗马休拈掇。\n须知旧阁快龙舟，当年曾把锦标夺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21406,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二十六首 其十三","author":"释嗣宗","text":"万仞峰前握手时，清歌一曲少人知。\n但见瞎驴惊宇宙，不知法眼付传谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21407,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二十六首 其十二","author":"释嗣宗","text":"一路雄兵犯界河，烟尘塞路绝人过。\n安邦赖有张良在，画角城头唱楚歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21408,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二十六首 其十","author":"释嗣宗","text":"象外横该宇宙身，圣凡极尽不容尘。\n衲僧意气合如此，当场谁是夺标人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21409,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二十六首 其八","author":"释嗣宗","text":"石里藏金谁辨别，游人但见藓痕斑。\n却被石人窥得破，铁船载入洞庭山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21410,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二十六首 其四","author":"释嗣宗","text":"不是风幡不是心，祖师正眼只如今。\n如今不识山河碍，识得如今海岳沉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21411,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二十六首 其二","author":"释嗣宗","text":"一见明星梦便回，千年桃核长青梅。\n虽然不是调羹味，曾与将军止渴来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21412,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三首 其三 二祖得髓","author":"释嗣宗","text":"弟昆各自逞功能，独有家兄彻骨贫。\n三拜起来无一语，鼻孔累垂盖上唇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21413,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三首 其二 香严击竹","author":"释嗣宗","text":"粥饭随时养病躯，本无迷悟可关渠。\n无端击著庵前竹，直至如今在半途。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21414,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三首 其一 虔侍者","author":"释嗣宗","text":"石人不怕师子吼，须弥顶上翻筋斗。\n沧溟竭尽正三更，生铁昆崙云外走。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21415,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二十六首 其二十四","author":"释嗣宗","text":"不劳车马迹，文王去后无消息。\n月华影里钓鱼矶，万古清风长历历。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21416,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二十六首 其二十三","author":"释嗣宗","text":"古冢不为家，渔翁举棹出芦花。\n湛水无风江月迥，长空撒尽暮天霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21417,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二十六首 其二十二","author":"释嗣宗","text":"贝叶收不尽，一句无私万法印。\n千圣满口不能宣，岭梅漏泄春光信。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21418,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二十六首 其二十一","author":"释嗣宗","text":"新罗渤海，南岳天台。\n纤尘不碍，岂涉去来。\n回头敛念，解脱门开。\n反忆善财寻胜友，百城游遍不知回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21419,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二十六首 其二十","author":"释嗣宗","text":"舒无踪，卷无迹，日午晴空轰霹雳。\n衲子惊迷失路头，神号鬼哭知何极。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21420,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二十六首 其十九","author":"释嗣宗","text":"乌龟三眼红如火，一角麒麟快似锥。\n土宿夜游南赡部，泥牛脚下火星飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21421,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二十六首 其十七","author":"释嗣宗","text":"后园驴吃草，可怜无限虚生老。\n半夜盲人问故乡，不知身在长安道。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21422,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二十六首 其十六","author":"释嗣宗","text":"笊篱木杓，钱贯桶索，说妙谈玄俱是错。\n清平鼻孔塞乾坤，天下衲僧无处摸。\n明来握土成金，悟去百草皆药。\n拗折俱胝指头，踏断赵州略彴。\n平常一句用无穷，限量知见徒斟酌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21423,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二十六首 其十五","author":"释嗣宗","text":"明头落节，暗里吃交，毒手当渠痒处搔。\n雪里鹭鸶飞不见，一只银瓶挂树梢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21424,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二十六首 其十四","author":"释嗣宗","text":"午夜霜凝星斗寒，长空云尽山月落。\n青天吃棒人尽知，苍龙退骨谁能觉。\n金凤冲开玉锁关，麒麟掣断黄金索。\n迢迢劫外孰能拘，南北东西迥超卓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21425,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二十六首 其十一","author":"释嗣宗","text":"婆婆不在五台山，平地行人作易难。\n蓦直坦然今古路，区区却过赵州关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21426,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二十六首 其九","author":"释嗣宗","text":"妙净明心，一句全真。\n山河大地，日月星辰。\n舒肝沥胆，照彻古今。\n个中如不昧，遍界是黄金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21427,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二十六首 其七","author":"释嗣宗","text":"不是心兮不是物，那吒夜入苍龙窟。\n铁鞭击碎明月珠，从教大地如翻墨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21428,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二十六首 其六","author":"释嗣宗","text":"鬼子挂起那吒面，赤脚跨定须弥卢。\n铁牛鞭起黄河岸，大洋海底食珊瑚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21429,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二十六首 其五","author":"释嗣宗","text":"铁牛耕破洞中天，桃花片片出深源。\n秦人一去无消息，千古峰峦色转鲜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21430,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二十六首 其三","author":"释嗣宗","text":"过去心不可得，收纶罢钓秋江碧。\n扁舟古岸恣闲眠，明月芦华深稳密。\n现在心不可得，法王家法存今昔。\n谋臣猛将定封疆，说甚隋珠并赵璧。\n未来心不可得，不可得中只么得。\n石含玉兮地擎山，惟證乃知难可测。\n千古流芳谁共知，清风匝地有何极。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21431,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二十六首 其一","author":"释嗣宗","text":"千年石虎产麒麟，一角通身五彩明。\n金锁玉关浑掣断，毗卢界内鼓烟尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21432,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二首 其二","author":"释嗣宗","text":"少林坐，庾岭行，书偈传衣成战争。\n庾岭行，少林坐，得髓安心成话堕。\n两家公案未曾圆，后代儿孙作殃祸。\n这殃祸，可煞大，天下衲僧透不过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21433,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二十六首 其十八","author":"释嗣宗","text":"生死既不可求，根尘万病俱休。\n从此俱空独露，蟾轮一片清秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21434,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二首 其一","author":"释嗣宗","text":"翠岩不是不说，只为无个季节。\n今朝快便难逢，一句为君剖决。\n露柱本是木头，秤锤只是生铁。\n诸人若到诸方，莫道山僧饶舌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21435,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂","author":"释嗣宗","text":"涧底泥牛金贴面，山头石女著真红。\n系驴橛上生芝草，不是云霭香炉峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21436,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏月桂峰桂子","author":"释慈永","text":"丹桂生瑶宝，千年会一时。\n偏从天竺落，祇向月宫知。\n出海冰轮满，当轩玉树迟。\n清晖含远峤，接影下空墀。\n金气风初劲，银河露恐垂。\n婵娟应怅望，果尔见蛾眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21437,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春","author":"释楚峦","text":"滩漱金沙过枕前，雨丝斜织面尘烟。\n绿杨红杏宜寒食，紫燕黄鹂聒昼眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21438,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"隐逸","author":"释楚峦","text":"杖屦独游栽药圃，琴樽多在钓鱼船。\n晚来花下敲门者，不是神仙即酒仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21439,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"青城山观","author":"释楚峦","text":"静见门庭紫气生，前山岚霭入楼青。\n玉坛醮罢鬼神喜，金鼎药成鸡犬灵。\n岩下水光分五色，壶中人寿过千龄。\n何当一日抛凡骨，骑取苍龙上杳冥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21440,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"释楚峦","text":"临水鹤窥行道影，隔云僧认读书声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21441,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"舟中作偈","author":"释楚圆","text":"长江行不尽，帝里到何时。\n既得凉风便，休将舻棹施。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21442,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书行肇师壁","author":"释简长","text":"禅径秋苔合，寒窗带雨痕。\n心真冥自契，句好与谁论。\n露冷蛩声咽，风微叶影翻。\n白云如有意，终日在前轩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21443,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李氏山庄留别","author":"释简长","text":"鹤氅轻冠冕，谁人不羡君。\n松斋秋掩月，石窦醉眠云。\n远墅灶烟合，寒原驿路分。\n前行鞭瘦马，馀恨暂离群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21444,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送行禅师","author":"释简长","text":"南国山重叠，归心向石门。\n寄禅依鸟道，绝食过渔村。\n楚雪黏瓶冻，江沙溅衲昏。\n白云深隐处，枕上海涛翻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21445,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送居寿师西游","author":"释简长","text":"迢递咸秦路，东风送子游。\n几程看日落，孤影背河流。\n古戍烟微敛，遥峰雨半收。\n行行吟此景，应不念沧洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21446,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送僧南归","author":"释简长","text":"渐老念乡国，先归独羡君。\n吴山全接汉，江树半藏云。\n振锡林烟断，添瓶涧月分。\n重栖上方夜，孤狖雪中闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21447,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送僧游五台山","author":"释简长","text":"五峰横绝汉，寒翠倚苍冥。\n积雪无烦暑，高杉碍落星。\n碛雪檐外见，边角坐中听。\n师到栖禅夜，龙湫独灌瓶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21448,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿许山人别业","author":"释简长","text":"岚霁景初分，溪桥对石门。\n犬声知远客，烧影见前村。\n古木秋生菌，空山夜答猿。\n几因留我宿，静话极诗源。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21449,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄丁学士","author":"释简长","text":"想极南溟外，江园草树秋。\n浮生如寄梦，几夕是离愁。\n仙馆闲明月，星车背远流。\n祇应西掖吏，时复望沧洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21450,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄云水禅师","author":"释简长","text":"千峰耸寒翠，古刹凌秋云。\n高人敛幽迹，世事何由闻。\n禅石抱苍藓，祖衣含净氛。\n有时溪上步，自与鸟猿群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21451,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晚次江陵","author":"释简长","text":"楚路接江陵，倦行愁问程。\n异乡无旧识，多难足离情。\n落日悬秋树，寒芜上废城。\n前山不可望，断续暮猿声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21452,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"感王太守见访","author":"释简长","text":"行春拥隼旟，十里访禅居。\n煮茗沙泉白，调琴竹阁虚。\n致君公望重，对客宦情疏。\n向夕回轩冕，林僧识佩鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21453,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"暮春言怀寄浙东转运黄工部","author":"释简长","text":"花落前林春又残，舍深苍藓拥柴关。\n十年霜雪独为客，万里梦魂空到山。\n溪竹旧怜同性直，岭云终约伴身闲。\n遥思谢傅多公暇，应遍留题水石间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21454,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠郝礼丞","author":"释简长","text":"住近城西寺，门无俗客登。\n朝回帘捲雪，吟冷砚生冰。\n鸟影樽中过，茶烟竹际凝。\n遥思来夜月，虚阁与谁凭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21455,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠浩律师","author":"释简长","text":"浩也毗尼学，精于玉帐严。\n蚁酣停扫砌，燕乳记钩帘。\n茶鼎敲冰煮，花壶漉水添。\n梦回池草绿，忍践绿纤纤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21456,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"怀卢叔微","author":"释简长","text":"病起启秋匣，素琴生尘埃。\n朱弦愁零落，古意空徘徊。\n子期不我至，独上高高台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21457,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"步春谣","author":"释简长","text":"春景欲饶物，客心独优柔。\n藉兹徘徊芳，彊起寂寞游。\n新愁来易积，旧欢去难收。\n步春不得侣，不如步高秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21458,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜感","author":"释简长","text":"无眠动归心，寒灯坐将灭。\n长恐浮云生，夺我西窗月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21459,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送方仲荀","author":"释简长","text":"行客心如何，借剑为君歌。\n雨昏山未开，花尽春无多。\n欲知贫别情，涕泪空滂沱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21460,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]