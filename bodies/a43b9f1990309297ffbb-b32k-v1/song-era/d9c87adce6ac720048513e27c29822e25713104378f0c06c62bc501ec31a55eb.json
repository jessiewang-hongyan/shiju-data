[{"title":"顾城","author":"董嗣杲","text":"初闻春日水天迷，此际湖沙拥岸肥。\n炊甑有尘籼米腐，酒坊无壁纸旗飞。\n猿栖晓树青藤瘦，雀啄冬畦白菜稀。\n寂寞旅怀禁得否，断腔渔笛钓船归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4886,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"乾会圣节赐宴","author":"董嗣杲","text":"瑞霭薰风遍赤墀，共歌随佛下生时。\n报班立笋嵩呼远，接宴簪花拜舞迟。\n联坐不矜朝士贵，缀员深愧醴曹卑。\n山中雨露恩荣溥，赋得三宫万寿诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4887,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿浔阳馆","author":"董嗣杲","text":"病身归束缚，枫叶见飘零。\n云淡秋星白，天遥戍火青。\n旧盟无处续，閒梦有时灵。\n月色江声里，愁多酒易醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4888,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿雄江统制衙","author":"董嗣杲","text":"往分莲社供，归向草庐眠。\n山寨差更鼓，春江走战船。\n风光随处别，鬓影倩谁怜。\n花柳西湖曲，招邀忆去年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4889,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄别余明远","author":"董嗣杲","text":"别离临水阔，迤逦望城微。\n落日犹回首，空江独自归。\n遥峰攒石树，饥鸟立沙矶。\n谁悯貂裘敝，还家且掩扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4890,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄杨云静","author":"董嗣杲","text":"公藉椒涂成达宦，我传草檄守清贫。\n閒曹奔走徒云仕，薄俸沾濡不逮亲。\n饮水曲肱无此量，解衣推食有何人。\n凉风四壁蛩新咽，偏恼淹回独客身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4891,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄周堂长","author":"董嗣杲","text":"回首大江秋水西，杖藜閒步菊花篱。\n百年清白瓮中酒，万事安危枰上棋。\n梦入庄生迷蝶处，歌穷宁子饭牛时。\n西风徐榻独栖惯，屋枕濂溪云锦池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4892,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄湖口张监渡","author":"董嗣杲","text":"寂寞邮亭紫翠中，有怀不得远相从。\n渡头几发东西棹，西角长鸣上下钟。\n江晚燕鸿秋信杳，野凉桑枣绿阴重。\n天空水阔云查断，收拾新诗寄兴浓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4893,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄湖口茶局臧尚干","author":"董嗣杲","text":"酡颜探得洞玄真，老气摩霄岸角巾。\n案上押批呼局吏，津头酿酒谢江神。\n天寒茶课收征倍，雪霁梅吟寄驿频。\n何日此来联榻语，庐山几案却无尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4894,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄璹秋岩","author":"董嗣杲","text":"吟穷荒此地，静极省吾生。\n秋老肠丝断，江空月魄明。\n松檐嗔鸟聚，竹榻梦僧清。\n别后苍颜改，初逢慨暑程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4895,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"密友花","author":"董嗣杲","text":"此花谁谓结朋悭，点染繁枝怯手删。\n丛矮暗埋晴径秀，刺多横接露篱间。\n野香雨浥遗春态，茜艳风梢取醉颜。\n情似酒浓甘倚附，不教疏远晚芳閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4896,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"崇真道院","author":"董嗣杲","text":"蹁跹鹤聚水云中，云水相逢色色空。\n讲道无人知畏垒，集仙有阁想崆峒。\n柳堤风日斋钟散，蒲座尘埃食钵充。\n一老双丫离蜀久，西窗掩定读参同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4897,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"崔府君庙","author":"董嗣杲","text":"灵休远被卫行都，宿有元勋梦又符。\n引马拥羊昭景贶，立碑建庙述嘉谟。\n九陵荆棘年空往，十里笙歌景不殊。\n莫倚西斋阑槛去，斜阳无语满钱湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4898,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"得京友信问曾观三叠水否因寄","author":"董嗣杲","text":"破橐萧然不自休，芦黄苇白九江秋。\n抗尘狂作两年客，看水悭为三叠游。\n得酒问鱼愁入市，有书无雁却登楼。\n征裘几揾思家泪，两眼凝穷桑落洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4899,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"徘徊花","author":"董嗣杲","text":"叠萼黄心紫瓣柔，秾薰粉腻入香篝。\n应知上苑清和转，聊为东皇款曲□。\n拂拂靓香遗片异，鳞鳞刺叶矮丛抽。\n夜长还有人空度，花里相延月一钩。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4900,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"接泥渡头再遇雪","author":"董嗣杲","text":"几涉沙汀与水村，几看云物幻乾坤。\n渡头冲雪哦诗老，船尾乘风破酒昏。\n未晚橹声先傍岸，乍晴江色远侵门。\n白鸥无数西飞急，鸣落淮山不见痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4901,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"断桥","author":"董嗣杲","text":"绣毂青骢骤晚风，柳丝翠袅石阑红。\n彩篙刺水停飞鹢，华表侵云截卧虹。\n杖屦谁归瀛屿去，笙歌自补玉壶空。\n重招张祜商新咏，不与当时藓合同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4902,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晚立接泥渡边","author":"董嗣杲","text":"逍遥行乐立西风，多听秋声耳欲聋。\n供世难分心力异，浮家易感古今同。\n小花糁渡遗晴蓼，碎叶填津积冷枫。\n博望有槎撑不去，岸头横卧树心空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4903,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晚过张分司园","author":"董嗣杲","text":"偶乘意度过东邻，芳艳多情媚柳津。\n欢笑直邀云际月，酣歌狂惜雨馀春。\n亭台花木销官酒，城郭风烟老客身。\n回首庐山图画里，不知愁落软红尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4904,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晚过陈峰廨酒边怀旧","author":"董嗣杲","text":"相过失喜晚炊香，同坐閒曹况味长。\n江日下山云半赤，淮柑离土叶全黄。\n殊乡酒味聊濡口，吊古诗章易刺肠。\n忆得旧邀梅院醉，万灯环锦阁新装。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4905,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"曹家沙阻风与朱一夔步入庐江县","author":"董嗣杲","text":"剩浪淮南接，疏篷岸北留。\n联镳入荒市，扶杖涉虚洲。\n有侣同寻醉，无歌可遣愁。\n风花犹未息，却望隔江舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4906,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梅花","author":"董嗣杲","text":"水光月色最相宜，独结空林岁晚期。\n万国春回先有信，孤山人往绝无诗。\n吟风海鹤眠清影，敲雪村童认老枝。\n举世祇知调鼎贵，玄机谁向静中规。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4907,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梅坡园","author":"董嗣杲","text":"墙拥双扉锁锦窝，溪声不敌树声多。\n谁家种麦曾名岭，今日寻梅且陟坡。\n万厦栋梁巢燕雀，四山风日养松萝。\n园丁自饱栽花利，月给杨家得几何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4908,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梨花","author":"董嗣杲","text":"办取看花沽酒钱，素肌娇怯冷笼烟。\n愁遗弟子离园日，泪尽宫妃过驿年。\n缟夜露零啼恨湿，扶春雪压洗妆妍。\n鞦韆院落清明近，绝艳能期月黑天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4909,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"欲附蒲海云制干舟归","author":"董嗣杲","text":"江上楼高暝树连，壮游空慨禹山川。\n客中问醉当秋晚，梦里怀归在燕先。\n水送流年遗楚恨，风吹残雪上吴颠。\n几番谩附鳞鸿便，不若相依买去船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4910,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"欲脱榷司东归","author":"董嗣杲","text":"担尾心期有破琴，绝怜无地觅知音。\n形神怯冷犹迎客，风雨催春亟治任。\n眼落牛羊沙渡远，情凝江汉寺楼深。\n津津谁染鹅黄柳，想可挨排醉绿阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4911,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"淫祀","author":"董嗣杲","text":"水泛牌头五里亭，尚留破庙压空坰。\n松萝阴覆鸦群怪，里社声传土偶灵。\n幡袅攲竿三丈赤，溪分荒藻数丛青。\n头陀强解愚夫卜，瓶缶花香带肉腥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4912,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清明日怀孤山","author":"董嗣杲","text":"身寄湓城岁月奔，远怀仙苑自乾坤。\n梅林有影吟魂在，陈柏无枝古意存。\n独客此时思上冢，孤山今日定开门。\n西江不似西湖上，处处酬春把酒樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4913,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清穆乡农户","author":"董嗣杲","text":"山峭回峰紧，场空得雨忙。\n赤枫溪觜立，白草渡头荒。\n寒市虚声隘，秋畴喜气扬。\n野舂连屋响，瑞入雪匙香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4914,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"理公岩","author":"董嗣杲","text":"西来识得此云根，终此云根护法门。\n由晋尚传斯语在，到今休想旧岩存。\n天开教观香灯盛，人仰胡僧相貌尊。\n行果芟教荆棘尽，分明只手破沉昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4915,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菊花","author":"董嗣杲","text":"篱东佳友手曾删，莫把南山提眼看。\n荒径可供元亮采，落英惟许屈平餐。\n艳钟金气中分晚，香袅清霜独傲寒。\n谁插满头开笑口，翠微亭北倚阑干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4916,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菖蒲花","author":"董嗣杲","text":"开时可食胜餐松，应在神人守护中。\n九节自知遗种异，一花谁可斗香同。\n碧丛露养仙苗细，灵卉泉抽玉髓空。\n还有痴愚求见面，欲期颜貌亟还童。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4917,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菱花","author":"董嗣杲","text":"珠团绿锦趁晴摊，凉荫龟鱼六月寒。\n背日开花非芡比，荒年收实当蔬餐。\n一方锦里消清暑，五瓣阑干俯碧澜。\n漠漠水天谁唱晚，苕溪翠展夕阳残。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4918,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"铜陵县废寺","author":"董嗣杲","text":"铜官山下梵坊攲，谁为昭明太子悲。\n鹤去不归松下柱，龟埋空负草间碑。\n谁言象教无销歇，自剖鸿濛有乱离。\n独倚倾墙望淮水，残僧绝影立移时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4919,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"银树","author":"董嗣杲","text":"银树驿桥废，征车难久停。\n月沉孤店柳，雪掩败舟萍。\n野冢明荒燐，山田出断铭。\n甫能投宿去，历历过邮铃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4920,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"银树道上","author":"董嗣杲","text":"银林驿路雪离披，行迹茫茫自苦悲。\n不忍早梅经细雨，却欣折竹压枯篱。\n身嫌出陆肩舆破，足涉沿溪口岸迟。\n荒店无人尘满釜，岂堪独力任晨炊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4921,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪江讲堂","author":"董嗣杲","text":"索居占得藕花风，几字头衔迥不同。\n乌帽染纱裁一幅，锦囊分卷集群公。\n湖光长日侵比座，竹箨多时积鹤笼。\n系柳吟驴何处去，想应乘雪钓江空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4922,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪阻李家渡","author":"董嗣杲","text":"迹寄邮程冒冷云，病身染透客衣尘。\n攲倾茅店清眠雪，想像梅村远醉春。\n樵子独还衣卸湿，篙人相告酒赊频。\n荒鸡唱断天将曙，快解孤篷野渡滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4923,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"黄葵花","author":"董嗣杲","text":"天然嫩相烁秋明，淡染鹅裳结束轻。\n醉蕊强传金盏侧，赤心长向火轮倾。\n四娘蹊上能无种，一点眉间自有情。\n不照花根元藉叶，羡他卫足了孤生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4924,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"富池客中","author":"董嗣杲","text":"舍舟遵陆几程来，家事身谋两未谐。\n九地渺茫怜骨肉，四方轩豁畅襟怀。\n雨翻茶崦春离岳，风飐监旗晓渡淮。\n短景不延愁思远，只堪长醉向茅柴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4925,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"富池客中寄范药庄","author":"董嗣杲","text":"客子惊秋易断魂，江塘落叶雨纷纷。\n蔽江云势山头合，隔竹泉声屋尾分。\n无日不宜閒问酒，有怀犹且强摛文。\n灯窗几忆同居话，卷里新篇可得闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4926,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"富池晚兴","author":"董嗣杲","text":"江花迷望望，霜叶落纷纷。\n翠嶂明分烧，沧江远载云。\n聚舟应弭侮，营屋又屯军。\n欲遂平戎捷，须将旧砚焚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4927,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"富池寓怀","author":"董嗣杲","text":"求佚徒将意揣摩，临高又惜岁蹉跎。\n隔江山秃秋烟空，入树风号夜浪多。\n童子得钱思远引，邻翁借酒强高歌。\n谩传客路饶孤笛，若老山村只短蓑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4928,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"富池镇上感怀 其一","author":"董嗣杲","text":"富池镇上土风殊，谁悯流民涸辙鱼。\n樵子乞租营屋住，渡官强占庙门居。\n贾舟聚港传官点，鬼店扬沙托法袪。\n第把沽浆招社赛，垆头还有马相如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4929,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"富池镇上感怀 其四","author":"董嗣杲","text":"荒村风物几嗟吁，鬼笑陈人旅更孤。\n鸦黠待船抛食饱，骨灵撑岸蚀泥枯。\n酸肠百结攒年里，古镇三叉截路隅。\n平漠展残斜日赤，有书无雁过西湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4930,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"富池镇上感怀 其三","author":"董嗣杲","text":"流民土著两纷纷，朝暮惟知射利勤。\n隔县小家多钓弋，近沙虚地少耕耘。\n望中红叶秋何极，直北黄云路不分。\n僻处绝无佳客过，酒边安得有新闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4931,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"富池镇上感怀 其二","author":"董嗣杲","text":"髑髅如雪混涂泥，浪打沙填晚更凄。\n烽警上流兵未解，灰寒中土客徒栖。\n怀归日积思鲈切，歌凯风闻集雁齐。\n忧患转深头转白，江云不障夕阳西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4932,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寒泉","author":"董嗣杲","text":"照胆寒泓覆有亭，此泉曾入老坡评。\n八诗最得吟梅苦，一盏能消荐菊清。\n不拜韬光徵士诏，却传配食水仙名。\n银床响绝无人汲，墓在孤山木自荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4933,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寓江州西城","author":"董嗣杲","text":"奔忙梦落富池程，归托蘧庐恋灌城。\n有石醉乘新月坐，无家吟逐乱云行。\n衣遗母线寒针在，烧起公山晚阵鸣。\n邻屋酒香堪洗恨，拟栽松菊效渊明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4934,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寓城一首","author":"董嗣杲","text":"推枕萦残梦，开窗扫积尘。\n病深难禦酒，贫极莫依人。\n野树依山暗，春林受雨新。\n晨兴閒整履，休惜看花频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4935,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寓富池双泉寺三首 其三","author":"董嗣杲","text":"晚来抱懒炙孤灯，临水禅楼独自登。\n鸟道草深云宛宛，鱼湖波定月澄澄。\n诗联呈佛方堪读，俗语污人不可应。\n归隐南峰峰下宅，纵谈今日岂无僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4936,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寓富池双泉寺三首 其二","author":"董嗣杲","text":"丹枫叶叶委江塘，旅况空馀古锦囊。\n阙下有家劳梦寐，灯前无酒遣荒凉。\n陈踪浮泛栖僧舍，往事消磨落客床。\n世态自应酬酢懒，已拚双鬓受年光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4937,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寓富池双泉寺三首 其一","author":"董嗣杲","text":"蛰龙潜介入寒泓，极目沧江浪不生。\n沙渡解舟人语众，淮山纵火烧风鸣。\n身栖萧寺蓬窗久，雪压槃塘草店明。\n莫说此为孤陋地，白云流水助吟情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4938,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"散水花","author":"董嗣杲","text":"的皪繁英贴翠鞭，流波拂影自牵连。\n柔条袅画粘琼靥，小叶抽春垒玉钿。\n冷艳远疑冰剪处，秾华低灿月明天。\n莫欺露卉云丛乱，暗引迷香采蝶眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4939,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"暑中访平山坦上人","author":"董嗣杲","text":"遥遥殊积入山心，勇涉湖西且解襟。\n当暑行松探古迹，追凉踏藓入晴林。\n信知净境无三伏，犹幸悭囊有几金。\n白酒青衣随所遇，此来祗为此僧寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4940,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"暑中客怀","author":"董嗣杲","text":"飘蓬于此趣何迂，破却牢愁是酒壶。\n世上利名休羡有，胸中丘壑不应无。\n秋侵客鬓从添白，春满侯门亦谩朱。\n无地追凉身坐甑，藕花多处忆西湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4941,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"棕榈花","author":"董嗣杲","text":"碧玉轮张万叶阴，一皮一节笋抽金。\n胚成黄穗如鱼子，朵作珠花出树心。\n蜜渍可驰千里远，种收不待早春深。\n蜀人事佛营精馔，遗得坡仙食木吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4942,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"棠梨湖","author":"董嗣杲","text":"西城转地有湖光，矮矮荆榛出土冈。\n俎豆零星传野哭，舳舻联络急边防。\n夹壕杨柳犹秋色，贴屋桃花自晚妆。\n芳草不除生意在，此名谁命谩华堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4943,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游蛇岗岭庵","author":"董嗣杲","text":"游历贪行入暮惊，蛇岗岭北衲庵清。\n西风扫叶秋初劲，野火烧空晓尚明。\n尘役未能抛白日，仙家不独有青城。\n借眠熟睡全无梦，服了黄精体自轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4944,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"湖山堂","author":"董嗣杲","text":"彩槛雕阑倚地仙，南堂深架北堂先。\n湖光十里饶春日，山色三堤合霁烟。\n帘幕香传歌扇底，莺花影落酒旗边。\n红尘不受斜阳压，暗逐东风入画船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4945,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"琵琶亭","author":"董嗣杲","text":"艰难罹歉岁，寂寞向他州。\n分绝青云上，家遥沧海头。\n空江荡寒月，枯苇积荒洲。\n不奈谯城角，呜呜吹乱愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4946,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"琼花","author":"董嗣杲","text":"后土花呈绝世祥，瑶姿琪艳著惟扬。\n一株独擅无双誉，六月重开有异香。\n描作画图尊地产，酿成花露敌天浆。\n朱阑几曲围丛树，珠络悬虚翠凤翔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4947,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登云台","author":"董嗣杲","text":"吴越山川几落晖，登临转步入云扉。\n寺名曾侈天真锡，碑字空传武肃挥。\n灵洞土埋攒棘掩，古台石落借松围。\n龙旗鸾辂曾遮拥，有祀圆丘庆六飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4948,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登六和塔","author":"董嗣杲","text":"阑槛倚云汉，身疑出上方。\n乾坤一指顾，吴越两消亡。\n海接空江白，山分落日黄。\n伍胥遗恨在，秋草隔沙长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4949,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登临","author":"董嗣杲","text":"登临乘此暮江风，数尽南飞几字鸿。\n秋水已清天更碧，晓枫未赤枣先红。\n诸公轩冕留情处，万里山河拊髀中。\n壮志已销思拥衲，饱餐蔬饭想虚空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4950,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]