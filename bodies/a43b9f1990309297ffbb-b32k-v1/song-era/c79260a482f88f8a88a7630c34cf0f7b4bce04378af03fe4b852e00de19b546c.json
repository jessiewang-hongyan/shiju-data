[{"title":"送雍子方学士","author":"赵抃","text":"召节君趋禁掖中，请藩愚向浙江东。\n清时内外俱为乐，鹤有乔松凤有桐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37844,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题导江勾处士湖石轩","author":"赵抃","text":"水精宫里石奇哉，万里从容入蜀来。\n都与先生助吟赏，惹烟笼月一窗开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37845,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"张宪重阳中得大黄上芝草一本作金龟以负之为赋","author":"赵抃","text":"锦文瑞正孕灵芝，药市中惟此物奇。\n入手却容凡眼看，宝囊开处坐金龟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37846,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和诗僧栖诘求诗","author":"赵抃","text":"澄观未逢韩退之，当时佳句有谁知。\n蟠龙僧胆大如斗，直以诗求蜀守诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37847,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和荣学士长濆关所寄","author":"赵抃","text":"朅来忠力岂忧危，人似登仙马似飞。\n却是玉溪梅正发，未曾攀折候公归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37848,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢张遨先生惠诗","author":"赵抃","text":"怀想仙风甚渴饥，岷山潜德世谁知。\n愚今幸有真消息，先得曹溪五首诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37849,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠前人酒","author":"赵抃","text":"器洁泉香忻得醉，慇勤分与洞中人。\n知君一饮无穷乐，和气三田长似春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37850,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题御爱山","author":"赵抃","text":"岷峨西列华排东，馀纵峥嵘敢竞雄。\n不是当时经御爱，此山还与众山同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37851,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵文学士寄仲南长老四句","author":"赵抃","text":"休官休问几人曾，归约林泉有衲僧。\n况是本来安乐地，曹溪何用见南能。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37852,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄梓州才","author":"赵抃","text":"锦城匝地清风起，为得梓州书一纸。\n莫问分符隔两川，水月东西共千里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37853,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题五丈原二寄木","author":"赵抃","text":"古庭薜荔附长松，岁寒共有凌霜操。\n诸峰冻合万木彫，看取门外长安道。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37854,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和记长老道颂","author":"赵抃","text":"道妙无为无不为，从他是是与非非。\n更须进步如平地，百尺竿头向上机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37855,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渔父五首 其一","author":"赵抃","text":"一带寒波雪浪流，谢郎终日在孤舟。\n沙鸥数只和烟落，笑倚兰桡独点头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37856,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渔父五首 其二","author":"赵抃","text":"月印苍波入夜寒，寂寥灯火水天宽。\n儿孙未解谙风色，几度船头失钓竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37857,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渔父五首 其三","author":"赵抃","text":"莫笑生涯一叶舟，江湖来往自悠悠。\n丝头漫有潭中意，逐浪鱼儿不上钩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37858,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渔父五首 其四","author":"赵抃","text":"卧看虾鱼日几遭，蒹葭风起片帆高。\n任公信是宜渔者，只候垂钩钓巨鳌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37859,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渔父五首 其五","author":"赵抃","text":"轻波拍岸琉璃碧，落日衔山玳瑁红。\n一曲渔歌人不会，芦花飞起渡头空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37860,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"行甫索颂卷","author":"赵抃","text":"空生老病已忘言，何处如今有偈篇。\n要会从来无一字，溪边杨柳密笼烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37861,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠五岳观王道士二首 其一","author":"赵抃","text":"解蜀归吴十月行，出门无计别青城。\n凭师为上希夷殿，稽首烧香道姓名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37862,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠五岳观王道士二首 其二","author":"赵抃","text":"道士修真心地乐，域自逍遥乡寂寞。\n世间名利任纷纷，一弄清琴一炉药。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37863,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿房公湖偶成","author":"赵抃","text":"广汉园池蜀自无，却思房相未如吾。\n浙东归去君恩重，乞得蓬莱与鉴湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37864,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"眉山麻衣至德观真仙亭","author":"赵抃","text":"我愧无能使两川，龟琴为伴仅三年。\n清朝自是朝真客，何必登山更望仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37865,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"正信表询长老","author":"赵抃","text":"欲导群迷建法门，千言百句与谁论。\n入泥入水劳心力，不负黄龙五代孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37866,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送程给事过越不及口占以寄","author":"赵抃","text":"立马江头一黯销，晓光浮动十分潮。\n西陵送目仙舟去，铙鼓旌麾迤逦遥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37867,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杭州八咏 其一 有美堂","author":"赵抃","text":"城在东南诚第一，江湖只向坐中窥。\n斯堂占胜名天下，况有仁皇御制诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37868,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杭州八咏 其二 中和堂","author":"赵抃","text":"老来重守凤凰城，千里人心岂易平。\n乐职古贤形颂叹，中和诗不为虚名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37869,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杭州八咏 其三 清暑堂","author":"赵抃","text":"江上潮音晓暮闻，天饶风月地无尘。\n自怜清暑堂中景，容得衰翁未退身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37870,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杭州八咏 其四 虚白堂","author":"赵抃","text":"松萝潇洒似居山，宾退公馀半是閒。\n谁谓乐天虚白意，只传诗句落人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37871,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杭州八咏 其五 巽亭","author":"赵抃","text":"越山吴水似图屏，妙笔无缘画得成。\n閒上东南亭上望，直疑身世似蓬瀛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37872,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杭州八咏 其六 望海楼","author":"赵抃","text":"潮神千里若云雷，日月如期早暮来。\n景觅东楼天下少，帘帷长对海门开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37873,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杭州八咏 其七 望湖楼","author":"赵抃","text":"倚棹渔舠恣往还，澄波如鉴照群山。\n绕湖三百浮图寺，祇是凭楼一瞬间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37874,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杭州八咏 其八 介亭","author":"赵抃","text":"介亭群石似飞来，深插云林两两排。\n占得群峰最高地，翠姿何处有尘霾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37875,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵程给事会稽八咏 鉴湖","author":"赵抃","text":"阁下平湖湖外山，阴晴气象日千般。\n主人便是神仙侣，莫作寻常太守看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37876,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵程给事会稽八咏 望海亭","author":"赵抃","text":"倚栏曾此望沧溟，延颈移时类鹤形。\n别后几回关梦寐，终求精笔写丹青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37877,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵程给事会稽八咏 望秦楼","author":"赵抃","text":"纵观沧海陟高峰，巡幸无名是祖龙。\n留作后来真赏地，望秦楼阁一重重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37878,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵程给事会稽八咏 拂云亭","author":"赵抃","text":"青云随步觉身高，燕雀卑飞不敢巢。\n民屋万家都下瞰，栏干迢递出林梢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37879,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵程给事会稽八咏 邃亭","author":"赵抃","text":"小松幽石曲池清，欲退山翁构此亭。\n补外想公非久次，坐看严诏下明庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37880,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵程给事会稽八咏 妙乐庵","author":"赵抃","text":"三年时得憩圆庵，有客禅机不在谈。\n妙乐佳名人不会，府中无事昼潭潭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37881,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禹穴","author":"赵抃","text":"洞天三十六非虚，今古称奇事可书。\n深坎闭藏惟巨石，只应方士识龙居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37882,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戒珠寺","author":"赵抃","text":"乘暇登高百丈巍，羲之遗迹见丰碑。\n蕺山下视无穷景，况压山巅是佛祠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37883,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵前人长至有怀二首 其一","author":"赵抃","text":"诗美皇皇使者风，礼修戎馆致雍容。\n去年佳节辽东会，此日新阳湖上逢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37884,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵前人长至有怀二首 其二","author":"赵抃","text":"我昔间关出使胡，新春沙漠未昭苏。\n海东青击天鹅落，鸭绿江边曾见无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37885,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"元日偶成","author":"赵抃","text":"人生七十古云稀，加我新年复过期。\n住在三衢山好处，望中还赋式微诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37886,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵程给事自述","author":"赵抃","text":"稽山报政为和气，并入元丰第一春。\n况有德音曾面被，定归霖雨泽斯民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37887,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵前人怀阙下偶成三首 其一","author":"赵抃","text":"秘殿称觞上寿时，御香气馥晓风微。\n天颜密迩孤臣幸，四十年前一布衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37888,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵前人怀阙下偶成三首 其二","author":"赵抃","text":"陟降三公捧寿觞，群臣蕃汉下成行。\n天庭礼乐交修盛，委佩拖绅极巽床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37889,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵前人怀阙下偶成三首 其三","author":"赵抃","text":"鹓鸾班列内珰催，晓色鸣梢天上来。\n赐宴群臣醉归去，满身犹带御香回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37890,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵前人谒禹庙三首 其一","author":"赵抃","text":"治水开陈遂刻碑，钜贤留意向当时。\n主翁不作知音贺，妙绝如何见好辞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37891,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵前人谒禹庙三首 其二","author":"赵抃","text":"鉴水为功利一州，至今称颂古诸侯。\n渔樵早暮馀波及，耋老思贤尚涕流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37892,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵前人谒禹庙三首 其三","author":"赵抃","text":"春色湖光照锦衣，岸花汀草共芬菲。\n若耶溪上游人乐，举棹狂歌半醉归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37893,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄酬张致政","author":"赵抃","text":"安车高蹈十年馀，顾我临川独羡鱼。\n珍重蓝田良玉性，火中三日只如初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37894,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵程给事寄赵少师三首 其一","author":"赵抃","text":"去日莲花红朵朵，来时荷叶绿田田。\n临期更作四湖会，两两舟同李郭仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37895,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵程给事寄赵少师三首 其二","author":"赵抃","text":"来属元丰第一年，农歌凿井自耕田。\n惟公好事康宁福，更许杭民识寿仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37896,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵程给事寄赵少师三首 其三","author":"赵抃","text":"安车论别十馀年，睢水归思负郭田。\n浩浩胸襟涵渤澥，飘飘风骨是神仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37897,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵前人和许少卿见怀三首 其一","author":"赵抃","text":"望秦双耸郡楼前，佳气葱葱杂翠烟。\n太守风流诗力健，湖山无处不成篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37898,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵前人和许少卿见怀三首 其二","author":"赵抃","text":"故交德重镇轻浮，恨不来乘剡水舟。\n远寄蓬莱主人句，字褒华衮若春秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37899,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵前人和许少卿见怀三首 其三","author":"赵抃","text":"我守全吴公越东，宪台千里寄清风。\n何时共作同年会，烂饮狂歌三醉翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37900,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄前人二首 其一","author":"赵抃","text":"小蓬莱对望秦山，有会无边不解颜。\n太守新诗踰百首，迩来传诵满人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37901,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄前人二首 其二","author":"赵抃","text":"古祠曾记祷灵神，旱雨滂沱救越人。\n大禹恩深无以报，我惟朝夕退藏身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37902,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵前人题曹娥庙二首 其一","author":"赵抃","text":"天资孝友本生知，不愧周人七子诗。\n绝妙好辞旌至性，丰碑千古奉坟祠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37903,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题陶朱公庙二首 其一","author":"赵抃","text":"为国谋深身自谋，飘然归泛五湖舟。\n虽云文种知几晚，未必忠魂为蠡羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37904,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题陶朱公庙二首 其二","author":"赵抃","text":"不道夫差势独夫，因持越计败全吴。\n陶朱智则诚为智，欲把忠臣比得无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37905,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵程给事寄法云禅师重喜","author":"赵抃","text":"法云尝负没弦琴，有曲古名清夜吟。\n心指寂寥谁肯顾，遇公倾耳作知音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37906,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书圆通院水阁","author":"赵抃","text":"风送荷花香满栏，上人宴坐水云间。\n时中静极光通达，岂特浮生半日閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37907,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵程给事书院浣纱石二首 其一","author":"赵抃","text":"倾国铅黄不假施，吴兵勍敌顿凌夷。\n苧罗石在千馀载，好事公今尚作诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37908,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵程给事书院浣纱石二首 其二","author":"赵抃","text":"吴宫金玉似泥沙，西子东来举国誇。\n一日越兵声震地，夫差犹惑眼中花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37909,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九日湖上登高寄前人二首 其一","author":"赵抃","text":"九日湖楼把酒卮，拒霜黄菊斗芳菲。\n五逢吴越重阳节，白首柯山未许归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37910,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九日湖上登高寄前人二首 其二","author":"赵抃","text":"舣棹湖亭又访山，寺楼登赏十三间。\n更寻半隐先生迹，一拥朱轮未得还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37911,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和前人书僧正院壁","author":"赵抃","text":"为忧圆教祖风摧，雨坠天花夜讲开。\n会得王公题壁意，入尘摩诘是如来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37912,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宝林塔再成示诸僧","author":"赵抃","text":"禅家自利利他人，宝塔焚如复鼎新。\n扫地便高三百尺，只应澄观是前身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37913,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书道士虞安仁房壁","author":"赵抃","text":"日月精华有术餐，不烦辛苦礼星坛。\n葛仙公井甘泉近，应炼长生九转丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37914,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书道士张昌应庵壁","author":"赵抃","text":"绝离声尘二十春，飘然风骨鹤兼云。\n庵中澹泊无馀物，一颗仙丹酒百分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37915,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅僧重喜坚辞紫衣勉令承命","author":"赵抃","text":"道场清净绝纤埃，云水中间丈室开。\n莫把赐袍容易看，帝恩新自日边来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37916,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"六弟司户生日","author":"赵抃","text":"祖教双修日用间，芳醪不饮自朱颜。\n欲知难老真消息，曾饵融峰九转丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37917,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送杨监簿南归","author":"赵抃","text":"数随乡荐始登科，清白门中所得多。\n伯氏文章天下望，家风元是老维摩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37918,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登安乐山塔","author":"赵抃","text":"池有灵泉泉有龙，高僧深隐梵王宫。\n云林百里如屏障，安乐山西一望中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37919,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"瑞莲花示禅僧","author":"赵抃","text":"红莲携赠碧莲堂，一本双葩颇异常。\n珍重承天胁尊者，闻风晨夕是清香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37920,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送僧得赐经还永嘉","author":"赵抃","text":"志愿未如终未回，十年京洛走风埃。\n珍函宝藏五千轴，一日降从天上来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37921,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]