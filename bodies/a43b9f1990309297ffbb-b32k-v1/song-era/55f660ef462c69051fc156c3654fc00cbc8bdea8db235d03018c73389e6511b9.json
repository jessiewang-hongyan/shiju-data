[{"title":"子房庙","author":"陈荐","text":"博浪沙头触副车，潜游东夏识真符。\n风云智略移秦鼎，星斗功名启汉图。\n商老已来宁少海，赤松还约访仙都。\n雍容进退全天道，凛凛高风万古无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18089,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"范增墓","author":"陈荐","text":"藏名羞立虎狼朝，乘鹤东依项籍豪。\n愤失壮图撞玉斗，不知天命与金刀。\n还家落日埋英气，回首浮云委旧劳。\n百步西连陵母冢，峨峨先识泰山高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18090,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"垓下","author":"陈荐","text":"九里山南楚汉争，风波翻覆走长鲸。\n霸图欲断中宵失，帝业时来一战成。\n懒渡沧江惭父老，更无勍敌压韩彭。\n农人不识当时意，祗得春霖事耦耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18091,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"燕子楼","author":"陈荐","text":"仆射新阡狐兔游，侍儿犹住水边楼。\n风清玉簟慵攲枕，月好珠帘懒上钩。\n寒梦觉来沧海阔，新诗吟罢紫兰秋。\n乐天才思如春雨，断送残花一夕休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18092,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"陈荐","text":"尘静山川狂鹿死，雷惊天地老龙飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18093,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"海南气候与中州异群花皆早发至春时已尽独荷花自三四月开至穷腊与梅菊相接虽花头小而香色可爱顷岁苏端明谪居此郡尝和渊明诗其略云城南有荒池琐细谁复采幽姿小芙蕖香色独未改即此池也今五十馀年池益增广临川陈使君复结屋其上名宾燕堂今夏得雨迟七月末花方盛开因成此诗约胜日为采莲之集云","author":"李光","text":"秋来雨足溢方塘，华屋临流四面凉。\n风飐圆荷翻翠盖，水涵芳蕊艳红妆。\n淡烟难掩天真色，薄日时烘自在香。\n诗老未须讥琐细，解陪梅菊到冰霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18094,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"禅师塔","author":"陈贵诚","text":"旧到乌回寺，相迎识短筇。\n重来已无迹，今去欲安从。\n春晓空啼鸟，岩枯吼夜龙。\n诸天围绕处，重听一楼钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18095,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"陈贵谊","text":"行人自逐杨花去，不是杨花肯送人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18096,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"敬赞月林观禅师 其一","author":"陈贵谦","text":"示现人间忍辱仙，单提独弄祖师禅。\n生涯一钵无安处，惟有声名万古传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18097,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"敬赞月林观禅师 其三","author":"陈贵谦","text":"与师曾结宿生因，一笑吴门二十春。\n再见已忘标月指，无言可赞法王身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18098,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"敬赞月林观禅师 其二","author":"陈贵谦","text":"传得西林夜半衣，解将铁笛逆风吹。\n重重话堕全担荷，青出于蓝只自知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18099,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"大涤洞天留题 其二","author":"陈唐生","text":"肩臂成洼古石存，雨乾不受野苔痕。\n道人未用誇神力，自是山王不动尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18100,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"大涤洞天留题 其一","author":"陈唐生","text":"天下有力可移山，底事秦鞭不作难。\n我却笑渠精卫石，一生愁绝海漫漫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18101,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"铁瓮洞","author":"陈唐佐","text":"云端象鼻通，一瓮自冲融。\n岂是乾坤小，当知造化工。\n灵泉猿不饮，丹气鹤常充。\n仙子乘鸾去，何年返故宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18102,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游虎丘 其二","author":"陈埙","text":"碧玉千寻剑影寒，夜深光怪逼危阑。\n句吴霸略成尘土，空有青山覆石坛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18103,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游虎丘 其一","author":"陈埙","text":"老龙拖雨过平川，晓影初开树色鲜。\n有片白云收不尽，日高犹在讲堂边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18104,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"茅山","author":"陈埙","text":"三茅高出七山巅，顿隔尘沙道路千。\n灵籁萧萧风笛弄，奇形奕奕陇牛眠。\n人间已有嘉平帝，地下谁通句曲天。\n幸喜吾庐居在此，时从寄傲任悠然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18105,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢赵宪副使惠建茶","author":"陈埙","text":"贡馀自合到侯王，谁遣甘芳入苋肠。\n野客惊看龙凤銙，家人学试蟹鱼汤。\n题来谏议三封印，分到尚书八饼纲。\n尽洒从前腥腐气，时时浇取简编香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18106,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其二","author":"王居安","text":"祇教人种菜，莫误客看花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18107,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宿连云楼","author":"陈壶中","text":"自爱山楼宿，微吟此兴浓。\n凭阑最深处，见月在高峰。\n清唳来孤鹤，新凉生数松。\n葛坛名已远，何处觅仙踪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18108,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雁山","author":"陈壶中","text":"山川秘灵迹，海近气常阴。\n尊者何年在，樵人去路深。\n云龙归绝顶，花鸟傍禅心。\n十八前朝寺，哀猿空夜吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18109,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题浯溪中兴颂二首 其二","author":"陈容","text":"六等胜如诛独柳，二张纵活亦何颜。\n太师死后犹书法，水部刑章托颂间。\n最忆海青投乐器，绝怜甄济隐青山。\n中兴碑下奸臣惧，天道何尝不好还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18110,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题浯溪中兴颂二首 其一","author":"陈容","text":"银旗金甲渡巴西，灵武城楼已万几。\n一札祗闻元帅命，五笺合待使臣归。\n未闻请表更追表，且看黄衣换紫衣。\n天性非由人伪灭，何缘尚父结张妃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18111,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"为人赋横舟二首 其二","author":"陈容","text":"黄头子，捩柁听吾语。\n三老驾三翼，叠鼓峭帆看风色。\n一千水，归黄河，世无客星泛灵槎。\n恒河水，波斯匿王母将去，六十年间成坏故。\n性无生灭河水似，黄面瞿昙以筏谕。\n长淮水，一箭许，边城白骨多于土。\n年年调舟已成泥，寿蔡孤城付朝暮。\n岷江汉源天上来，一夕不保如风埃。\n重庆今为天下首，汉中不复言规恢。\n朽木为舟土为楫，白波如山水皆立。\n当时商家畚筑子，梦里撑船济川去。\n只今无梦岂无舟，水浅都非泊舟处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18112,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"为人赋横舟二首 其一","author":"陈容","text":"古悲歌，泪如血，渡河无船气欲绝。\n古非歌，泪如泉，河激汤汤声彻天。\n峨舸大艑载琛贝，锦缆迷楼催管弦。\n人生苦乐不相等，风波血刃蛟流涎。\n神虺九首能三足，巨鳌触怒群帝迁。\n纵有扁舟竟何往，乘桴意在沧洲上。\n祇缘辙朽无人知，入海居夷每惆怅。\n三间破屋名横舟，三呼不答江水流。\n一帆径渡溯天去，不系斜阳古渡头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18113,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题云龙图","author":"陈容","text":"骑元气，游太空。\n普厥施，收成功。\n抉河汉，触华嵩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18114,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题灵丰庙壁","author":"陈容","text":"紫马仙人跨白犀，翻经台映钓鱼矶。\n千年老树风雷坼，独有红泉洗断碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18115,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醒心亭","author":"陈宾","text":"亭以醒心名，心与亭何与。\n物各有感通，此理贵深喻。\n岘山峙丰碑，见者皆堕泪。\n推类尽其馀，庶表名亭义。\n我昨发莆阳，春光正明媚。\n肩舆撼顿间，思虑杂劳勚。\n行行复行行，至此若沾醉。\n振衣蹑斯亭，四顾足清致。\n芳树布繁阴，晴山荐空翠。\n时有幽禽来，且无俗驾至。\n物我方两忘，情景亦相会。\n天君始泰然，万境绝纤翳。\n后乐与先忧，虚灵良不昧。\n揭扁端在兹，夫岂无所试。\n尚期知我者，他时来作记。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18116,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水龙吟 浮翠山房拟赋白莲","author":"陈恕可","text":"素姬初宴瑶池，佩环误落云深处。\n分香华井，洗妆湘渚，天姿淡泞。\n碧盖吹凉，玉冠迎晓，盈盈笑语。\n记当时乍识，江明夜静，只愁被、婵娟误。\n几点沙边飞鹭。\n旧盟寒、远迷烟雨。\n相思未尽，纤罗曳水，清铅泣露。\n玉镜台空，银瓶绠绝，断魂何许。\n待今宵试探，中流一叶，共凌波去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18117,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"齐天乐 其二 同上","author":"陈恕可","text":"蜕仙飞佩流空远，珊珊数声林杪。\n薄暑眠轻，浓阴听久，勾引凄凉多少。\n长吟未了。\n想犹怯高寒，又移深窈。\n与整绡衣，满身风露正清晓。\n微薰庭院昼永，那回曾记得，如诉幽抱。\n断响难寻，馀悲独省，叶底还惊秋早。\n齐宫路杳。\n叹往事魂消，夜阑人悄。\n谩省轻盈，粉奁双鬓好。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18118,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"齐天乐 其一 馀闲书院拟赋蝉","author":"陈恕可","text":"碧柯摇曳声何许，阴阴晚凉庭院。\n露湿身轻，风生翅薄，昨夜绡衣初剪。\n琴丝宛转。\n弄几曲新声，几番凄惋。\n过雨高槐，为渠一洗故宫怨。\n清虚襟度漫与，向人低诉处，幽思无限。\n败叶枯形，残阳绝响，消得西风肠断。\n尘情已倦。\n任翻鬓云寒，缀貂金浅。\n蜕羽难留，顿觉仙梦远。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18119,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"桂枝香 天柱山房拟赋蟹","author":"陈恕可","text":"西风故国。\n记乍免内黄，归梦溪曲。\n还是秦星夜映，楚霜秋足。\n无肠枉抱东流恨，任年年、褪匡微绿。\n草汀篝火，芦洲纬箔，早寒渔屋。\n叙旧别、芳刍荐玉。\n正香擘新橙，清泛佳菊。\n依约行沙乱雪，误惊窗竹。\n江湖岁晚相思远，对寒灯、谩怀幽独。\n嫩汤浮眼，枯形蜕壳，断魂重续。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18120,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵答友","author":"陈恭","text":"竹枝歌忆楚江天，曾向浔阳久泊船。\n君过石钟寻旧韵，我知炉顶起新烟。\n故人寥落今谁在，好梦迢遥亦偶然。\n秋以为期犹未至，冷鸿疏草暮云边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18121,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吴山","author":"陈恭","text":"吴山烟树复如何，老去登临感慨多。\n似说怒涛仍白马，还看远嶂只青螺。\n三秋草色凌荷芰，万里閒云下薜萝。\n可惜江湖长浩荡，只供短发一高歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18122,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"感怀","author":"陈恭","text":"回首沧桑已数番，感怀无尽又何言。\n悲看世路皆危壑，喜共家人在故园。\n笔底有心神自远，来年多难骨犹存。\n连章句弗矜佳丽，风雅于今止一痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18123,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题张氏十咏图","author":"陈振孙","text":"平生闻说张三影，十咏谁知有乃翁。\n逢世升平百年久，与龄耆艾一家同。\n名贤叙述文章好，胜事流传绘素工。\n遐想盛时生恨晚，恍如身在画图中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18124,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉赠宫主许存道","author":"陈振甫","text":"我到洞天双眼明，凭虚不觉骨毛轻。\n更有清幽许存道，为写高山流水声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18125,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"大涤洞赠朱道士","author":"韩淲","text":"玉室金堂世有人，龙眠龟息鹤精神。\n暑风吹起尘三丈，城市出来閒采真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18126,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠张师","author":"陈振甫","text":"富贵不可絷，潇然脱尘羁。\n神气自涵养，岩壑方栖迟。\n山中有宰相，物外多仙师。\n蓬莱定不达，节操请坚持。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18127,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"行部仙游","author":"陈效","text":"碧山如画豁吟眸，信是神仙此地游。\n九鲤有人争乞梦，一麾无事独登楼。\n田中水白秧初雨，陇上云黄麦已秋。\n民困祇今苏息否，我来端不为花谋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18128,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和潘良贵三江亭","author":"陈晋锡","text":"神襟百虑不容侵，胜概乘閒偶访寻。\n趺坐岂无观水术，临流应有济川心。\n敛将蓬岛溶溶气，散作阳春字字金。\n郢曲调高人寡和，微生何敢缀雄吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18129,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"我爱淳安好 其一","author":"陈晔","text":"我爱淳安好，于民两尽诚。\n明伦喜知劝，有社敬皆生。\n开学群材进，翻经众说平。\n嗟予不如昔，徒尔景恢宏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18130,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"我爱淳安好 其十一","author":"陈晔","text":"我爱淳安好，都捐文墨拘。\n幽禽纵林薮，露柩掩荒芜。\n每积空餐愧，曾求实惠无。\n安车幸虞侍，南极近星弧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18131,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"我爱淳安好 其六","author":"陈晔","text":"我爱淳安好，能知义命方。\n育遗存后裔，刳腹奉高堂。\n隐节推承诏，儒官教有庠。\n胡为得祠奉，退省更徊徨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18132,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"我爱淳安好 其五","author":"陈晔","text":"我爱淳安好，忧民缺致盈。\n渠通庐避湿，滩凿浪难生。\n利涉津梁固，安行道路平。\n夙宵虽黾勉，终愧汉公卿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18133,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"我爱淳安好 其八","author":"陈晔","text":"我爱淳安好，流芳踵昔人。\n兴贤多上第，安老切怜贫。\n更荷雨旸若，再还风俗淳。\n燕毛过百岁，锡类奉君亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18134,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"我爱淳安好 其十","author":"陈晔","text":"我爱淳安好，百方民力宽。\n役胥遵大义，讼牒上狂澜。\n公赋争先入，穷阎可奠安。\n从今滋向化，为政不因难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18135,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"我爱淳安好 其九","author":"陈晔","text":"我爱淳安好，薰陶圣治馨。\n执呼民听命，期纵草生囹。\n栏栅虚长庑，桁杨卧一庭。\n国家仁泽厚，今日可无刑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18136,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"我爱淳安好 其四","author":"陈晔","text":"我爱淳安好，精能乐众工。\n群羊亡饮豫，大武护功隆。\n推此心俱善，貤生石可砻。\n浮游博六子，裒手亦从风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18137,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"我爱淳安好 其七","author":"陈晔","text":"我爱淳安好，先庚矢伏房。\n春秋武常阅，钟鼓今惟详。\n在在空三穴，家家保万箱。\n欢呼遍田里，既醉乐时康。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18138,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"汀州","author":"陈晔","text":"尝闻元丰间，元舆守兹土。\n别乘果为谁，青山郭功甫。\n二公德望尊，声名播今古。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18139,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"我爱淳安好 其三","author":"陈晔","text":"我爱淳安好，溪山壮县居。\n锦文光璀璨，雉羽泄轻徐。\n比屋兴弦诵，多田力耨锄。\n廓然无一事，林下自诗书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18140,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"我爱淳安好 其二","author":"陈晔","text":"我爱淳安好，群心息险奸。\n封郊广申画，车辙略周环。\n漏刻辰无爽，亭崇诏肃颁。\n恭思民易虐，退食敢言闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18141,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"服椒法歌","author":"陈晔","text":"青城山老人，服椒得妙诀。\n年过九十馀，貌不类期耋。\n再拜而请之，忻然为我说。\n蜀椒贰斤净，解盐六两洁。\n糁盐慢火煮，煮透滚菊末。\n初服十五圆，早晚不可辍。\n每月渐渐增，累之至二百。\n盐酒或盐汤，任君意所歠。\n服及半年间，胸膈微觉塞。\n每日退十圆，还至十五粒。\n俟其无碍时，数复如前日。\n常令气熏蒸，否则前功失。\n饮食蔬果等，并无所忌节。\n一年效即见，容颜顿悦泽。\n目明而耳聪，须乌而发黑。\n补肾轻腰身，固气益精血。\n椒温盐亦温，菊性去烦热。\n四旬方可服，服之幸毋忽。\n逮至数十年，功与造化埒。\n耐老更延年，不知几岁月。\n嗜欲若能忘，其效尤卓绝。\n我欲世人安，作歌故怛切。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18142,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南歌子","author":"陈晔","text":"腰下重金贵，眉间一点黄。\n定知从此庆非常。\n况有阴功宜寿、等天长。\n乞得仙家酒，来称诞日觞。\n乃翁阿母醉何妨。\n行见诸郎接武、上明光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18143,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"耍鼓令","author":"陈晔","text":"化日长。\n政莺语，啭新篁。\n到处园林垂绿幄，槐风细，梅雨凉。\n见庭户，瑞霭回翔。\n拥真仙，鸾驭临华堂。\n阗阗珠履争相庆，笙箫奏，绮筵张，捧玉觞。\n好深酌九霞浆，舞袖弓弯呈妙态，更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18144,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"满庭芳","author":"陈晔","text":"翠竹阴团，绿荷芗嫩，朝来和气盈盈。\n薰风楼阁，玉燕梦初成。\n便有功名壮志，持符节，麟虎频。\n更归来后，挂冠神武，四海□高名。\n今年，方八十，莱衣舞处，岨拜霞觥。\n想笙歌递奏，鼎沸欢声。\n何用渠渠颂祝，自应合、福禄安荣。\n丹台上，玉清山籍，金字注长生。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18145,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉蓬莱","author":"陈晔","text":"算当年紫府，乘兴霓车，世间游戏。\n符节功名，谩略儿小试。\n自挂衣冠，旋栽松菊，占水云佳致。\n九人年高，重重恩渥，丝纶光贲。\n十里西湖，九霞仙酿，举劝吾翁，诞辰一醉。\n窦氏阴功，筹彭篯久视。\n啸傲壶中，燕超尘外，此乐谁能继。\n庭砌年年，斑斓□济，朱颜见喜。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18146,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其二","author":"陈晔","text":"古驿森慈竹，莲城挺义松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18147,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其一","author":"陈晔","text":"朝看碧溪初腾日，暮对青山淡抹云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18148,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠方仁声","author":"潘良贵","text":"学道悠悠未见功，敢言凡质有仙风。\n他年一钵江湖去，先向苕溪访葛洪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18149,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和潘良贵题明州三江亭韵","author":"陈栖筠","text":"红尘一点不相侵，下瞰澄江几万寻。\n地接海潮分鼎足，檐飞凤翼峙天心。\n三山有路云收幕，午夜无风月涌金。\n欲识龚黄报新政，满城争唱使君吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18150,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寒瀑","author":"陈栩","text":"玄冥布令雨成雪，白瀑倾崖玉作花。\n坐爱奔声空谷窅，幽深方觉是仙家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18151,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"崖山六咏","author":"陈格","text":"战舰冲风起怒涛，北船晓挫暮犹多。\n强胡难满吞天欲，志士横罹伏海号。\n一剑挂腰随我去，万方引领奈君何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18152,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]