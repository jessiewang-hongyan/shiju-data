[{"title":"荷珠","author":"李光","text":"荷珠圆复碎，攲侧动相关。\n去似临江失，来如合浦还。\n贾人应误喜，莲女想轻攀。\n百斛倾梅雨，天公岂是悭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3312,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"观穫","author":"李光","text":"老农勤畚锸，岁暮阅星霜。\n相见如遗秉，安能助太仓。\n晚晴鸡鹜喜，蓐食妇姑忙。\n应有深村酒，招邀隔短墙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3313,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠林湘","author":"李光","text":"先君师建学，梅坞最交深。\n共探先天易，同哦正始音。\n亲亡友亦尽，人古道犹今。\n子续通家好，遗书幸细寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3314,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"九日登楼二首 其一","author":"李光","text":"久客惊秋意，天涯思不穷。\n三年犹北国，万里对西风。\n时序悲歌里，乾坤醉眼中。\n黄花一樽酒，千古此心同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3315,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"九日登楼二首 其二","author":"李光","text":"木落秋容静，时平国势雄。\n望云心自远，采菊兴谁同。\n诗酒浮生过，功名一笑空。\n留连凭痛饮，冠帻任高风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3316,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄吴元预","author":"李光","text":"出门怀抱恶，别我去游秦。\n季子黄金尽，潘郎白发新。\n一枰谁敌手，五字愈惊人。\n勉赴功名会，如公定不贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3317,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"人日","author":"李光","text":"人日灵川县，山深雪未融。\n谁知桂岭北，宛似浙江东。\n墟市人烟合，僧窗竹径通。\n杖藜闲信步，日暮怯溪风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3318,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"近传已有代者补之作诗见寄因次其韵","author":"李光","text":"清时民讼简，尺素半偷闲。\n岐路将迎里，人情喜怒间。\n舄凫随意远，辽鹤自知还。\n小艇春洲晚，归寻天姥山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3319,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"马上寄补之以急归不果追前约为恨","author":"李光","text":"归鞍乘月夕，度岭访灵真。\n路转山邀马，溪回水趁人。\n春残花院静，家近梦归频。\n回首追前约，犹如未了因。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3320,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠高端礼","author":"李光","text":"炎暑劳相过，清言扇为停。\n新吟舍瑟作，衰耳洗竽听。\n诸老子犹接，正音今已零。\n君家高记室，句法是仪刑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3321,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"同永嘉诸贤奠谒右丞许公少伊","author":"李光","text":"葱郁佳城秘，回环宅兆深。\n悬崖森翠柏，踊地布黄金。\n天下方云扰，斯人竟陆沈。\n尘侵徐孺榻，弦断伯牙琴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3322,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵师川见赠","author":"李光","text":"钧枢归雅望，邪志寝奸雄。\n雕鹗清秋急，豺狼当路空。\n经纶思妙手，谈辩想英风。\n未厌东山卧，沈机一局中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3323,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠陈谠二首 其一","author":"李光","text":"识字嗟逢晚，安贫未易招。\n儒冠走江浙，诗笥带衢饶。\n学贵参先觉，才须验后凋。\n诸贤书稳致，定不作洪乔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3324,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠陈谠二首 其二","author":"李光","text":"人物有兴废，山川无古今。\n匹夫空有志，四海孰知心。\n莫睹芝兰室，如游薝卜林。\n同行六七子，涕泪各沾襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3325,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵贺子忱喜雨","author":"李光","text":"天眷周王德，功归傅说霖。\n少宽边饷急，聊慰老农心。\n雷隐沧江转，阶喧玉漏沈。\n西山多爽气，拄笏助清吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3326,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"子忱告别忽改涂湖外迎护母夫人殡宫恻然念之作诗送行","author":"李光","text":"异县伤孤殡，慈颜念倚闾。\n旧阡无触鹿，新荐有跳鱼。\n舟楫踰江水，风霜迫岁除。\n归来一大事，莫忘剡溪居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3327,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"德起侍讲侍郎以亲老丐外章累数十上上虽察其诚至眷待方隆卒不许其去五月九日有旨令归觐且使迎奉以来一时士友莫不歆艳称叹为人臣子能使圣主敬爱贪恋如此诚千载之遇足以显其父母扬名后世矣上虞李某作诗送行","author":"李光","text":"别浦征帆速，归宁汉诏温。\n青云方得路，白发笑迎门。\n欲报慈亲意，难忘圣主恩。\n朝回奉温凊，忠孝两能存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3328,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"有怀念一兄三二弟","author":"李光","text":"晚堕容江侧，蛮蜑且杂居。\n怀兄频有梦，忆弟懒观书。\n忧国心徒切，谋身计已疏。\n归田傥有日，握手喜何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3329,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"城北江岸独行成此诗居人皆竹篱茅屋无壁可题归而书于此","author":"李光","text":"散策江村路，柴门欲访谁。\n榕根盘古岸，藤菜蔓疏篱。\n未办游春屐，闲寻敌手棋。\n天涯随处好，莫作楚囚悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3330,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"予始到琼众谓海南自来无大寒今岁腊月连日风雨殆不异北地因成小诗记之","author":"李光","text":"海国冬常燠，阴霾忽满山。\n飕飕北风劲，凛凛冻云顽。\n蟋蟀已无语，芭蕉犹强颜。\n江头梅柳色，春色几时还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3331,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"丙寅十月二十二日孟坚理旧箧见纯老送行诗有见及语因次其韵三首 其一","author":"李光","text":"南来偿宿债，一笑悟前身。\n白首痴顽老，清朝放逐臣。\n休传江左梦，愁见海南春。\n鲁叟乘桴意，他年莫问津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3332,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"丙寅十月二十二日孟坚理旧箧见纯老送行诗有见及语因次其韵三首 其二","author":"李光","text":"衣冠双阙远，烟瘴百蛮深。\n不记朝天路，难忘拱极心。\n任从生死病，莫问去来今。\n身似孤云远，闲飞不作霖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3333,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"丙寅十月二十二日孟坚理旧箧见纯老送行诗有见及语因次其韵三首 其三","author":"李光","text":"窜流今六载，无复望天朝。\n象魏阙云远，宝陀山匪遥。\n音书时有继，风义未全凋。\n只有猕猴性，年来亦渐调。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3334,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"八月十六夜江边对月","author":"李光","text":"水月交相映，江空净客衣。\n孤光凌象纬，倒影射窗扉。\n宿鸟依林动，流萤逐暗飞。\n兴来随杖履，难下董生帷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3335,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"连日以目疾不能躬课子侄辈枕上成四十言粗明汲古之意以勉之","author":"李光","text":"文史三冬足，窥寻究始终。\n夜窗捐末事，岁计见深功。\n古井家家有，灵泉处处通。\n随身具修绠，取给自无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3336,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"近买扁舟篷棹悉具戏示诸儿","author":"李光","text":"此生云水兴，今日买扁舟。\n着岸从人系，乘风逐处浮。\n山歌和渔子，净社结江鸥。\n夜泛寒潮稳，朝寻古寺幽。\n谢安空雅量，范蠡漫多谋。\n岂若吾无事，平湖尽日留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3337,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"琼士黄与善会友堂课诸生作移竹诗为赋一首","author":"李光","text":"绿竹名清友，书斋植最宜。\n根深知旧壤，叶密带新枝。\n寒暑时须易，冰霜操不移。\n影寒金琐碎，声振玉参差。\n引凤符周运，为龙待葛陂。\n诸生频扫径，琴海每相随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3338,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"泂酌亭诗","author":"李光","text":"投老几三黜，郊居更一迁。\n江山相映带，风物自清妍。\n妙墨移新榜，清诗失旧镌。\n地偏无俗辙，境胜赖前贤。\n气浃冈峦润，荣滋草木鲜。\n双泉今莫辨，异味岂虚传。\n馀润分畦圃，支流给市廛。\n幽嵌锵玉佩，石罅涌玑璿。\n沥漉闻朝汲，淙琤搅夜眠。\n甘寒通沆瀣，精洁秘蜿蜒。\n奔驶观洄洑，泓渟有折旋。\n滂沱苏旱岁，清冷变炎天。\n雁过空遗影，僧来忽误禅。\n澄澜涵璧月，暗谷响朱弦。\n梦想千岩秀，徜徉一壑专。\n使君常倒载，别乘屡加笾。\n隔竹闻茶臼，临池泛酒船。\n尘襟如可洗，来此弄潺湲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3339,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"三月三日康守燕严亭","author":"李光","text":"禊饮城西路，山翁岸幅巾。\n习池还倒载，曲水暗通津。\n鼓吹雄南国，旌旗照暮春。\n莫嫌娼妓拙，自有主人真。\n散策花迷径，随车雨洗尘。\n杖藜归兴晚，犹有浣纱人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3340,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"吾里桃花之盛不减武陵独东院一株色白而多叶跗萼皆碧世谓之碧桃主僧回公折以相赠置几砚间萧然有出尘之想因赋鄙句","author":"李光","text":"不作寻常好面皮，刘郎去后弄妆迟。\n唤回浓睡春方好，洗退残红晚更宜。\n薝卜有香陪冷艳，酴醾无力斗丰肌。\n最怜月下朦胧影，定起山僧莫皱眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3341,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"总持师示近诗一轴辄次最后神字韵梅花一篇","author":"李光","text":"水边难睹似梅人，且看垂垂一树新。\n独许玉妃陪寂寞，可须青女助精神。\n传杯冷艳愁闻笛，入户幽香已报春。\n抽尽空花经月雨，此心那复住根尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3342,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"重午食大麦","author":"李光","text":"春来斗米欲逾千，麦熟家家爨有烟。\n手磨旋推云子落，脚铛深煎蚌胎员。\n香闻并舍儿童喜，效录奇方胃海便。\n信是书生能说食，杜陵饥客漫流涎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3343,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"得之寓静斋敩学之暇不废吟咏甚自得也因其归省作诗送行","author":"李光","text":"数椽茅屋绝过从，窗户深明一径通。\n雨过竹丛增晚翠，风翻荷沼乱殷红。\n揩磨五字无瑕颣，鼓吹群经有折衷。\n敩学从来自强半，应怜时辈尚谈空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3344,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠李振祖","author":"李光","text":"儿时思致早飘然，便合高鶱在少年。\n下第令人感二鸟，上庠寄径应三鳣。\n义方永诀诗无恙，手泽珍藏墨尚鲜。\n识取前修显扬事，决科之外有流传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3345,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"向丞厅旧有小轩榜曰日哦庳隘不爽近彻墙向南植竹数竿改曰分翠与僚友邑之贤彦日游其间且索鄙句因赋二诗呈诸友 其一","author":"李光","text":"旋植修篁一径深，萧然便可涤尘襟。\n碧移湘浦千梢净，清借淇园十亩阴。\n晓槛秋声风撼玉，空庭寒影月筛金。\n造门赖有山阴客，酒熟时来伴醉吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3346,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"向丞厅旧有小轩榜曰日哦庳隘不爽近彻墙向南植竹数竿改曰分翠与僚友邑之贤彦日游其间且索鄙句因赋二诗呈诸友 其二","author":"李光","text":"先生活计未全贫，一径筼筜碧玉新。\n野趣近依陶令宅，幽姿深隔庾公尘。\n独馀世外冰霜操，不逐人间草木春。\n吏隐何妨成小筑，风流重见竹林人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3347,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题向丞竹轩","author":"李光","text":"琅玕新植觉深幽，顿使轩窗一夜秋。\n寒影静侵书幌冷，翠阴清逐桂花浮。\n蕙兰终许依霜操，桃李从教媚冶游。\n公子已多林下趣，更看仙吏落银钩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3348,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"诗悼德舆通判寺丞","author":"李光","text":"扁舟访我海边村，笑语俄惊隔九原。\n萧寺新题云有态，故乡清誉玉无痕。\n伤心姹女能传业，衔痛慈亲尚倚门。\n纼绋情乖临穴送，一尊聊酹若敖魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3349,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题藏春轩","author":"李光","text":"何必金丹访洞宾，壶中日月自长春。\n直疑帘幕遮藏得，未怕莺花漏泄频。\n摩诘神通移不去，桃园风景画难真。\n尊罍剩把笙歌拥，沉醉何妨垫角巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3350,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送知府提举出守虢略","author":"李光","text":"绣斧当年旧使星，却分符竹往专城。\n流风远继三堂咏，扶路争看五马迎。\n不独循良追汉吏，便应清切振家声。\n都门祖帐人多羡，袅袅春风动旆旌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3351,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵叔兴计议端午发家书感怀之诗","author":"李光","text":"细葛香罗罢赐衣，十年风雨暗蜗庐。\n浴兰纫佩怜儿女，悬艾题符徇井闾。\n地胜斗墟饶赋咏，日长莲幕少文书。\n欲凭尺素传深意，千里慇勤附雁鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3352,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠赵璚夫","author":"李光","text":"世间儿子总纷纷，属籍吾贤最不群。\n天在山中须畜学，风行水上自成文。\n操存有约要真见，记问夸多只謏闻。\n我与东岩情分腆，临分书此勉郎君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3353,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游破山通幽轩用前人韵呈同行诸友","author":"李光","text":"小轩佳致信通幽，爽气侵人挟九秋。\n暇日不妨寻旧隐，清时无用借前筹。\n能诗谁复追常建，爱竹吾今似子猷。\n已有琴书随杖履，更邀闲客伴清游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3354,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题无俗亭","author":"李光","text":"一榻萧然岸幅巾，寒梅为友竹为邻。\n清谭谢傅风流胜，倒载山翁气味真。\n独把琴棋消永日，未须歌管送馀春。\n簿书堆案应频扫，不学陶潜避俗尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3355,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"人日立春呈元成进道二兄二首 其一","author":"李光","text":"人日春风动琯灰，新年佳节并相催。\n金花巧向钗头见，和气潜随斗柄回。\n青入池塘频梦草，暖生官阁易寻梅。\n相从便好携炉铫，乳面新来胜撇醅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3356,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"人日立春呈元成进道二兄二首 其二","author":"李光","text":"新诗如律起寒灰，多谢邹郎着意催。\n清比金茎天上落，句生春草梦中回。\n才高可但空吟雪，心铁犹能强赋梅。\n山月欲圆人又好，羡君同泼瓮头醅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3357,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"校文毗陵经由见寄","author":"李光","text":"牵衣儿女最相关，节物催人岁欲阑。\n船落草声惊梦断，水涵山影照杯残。\n堂深空羡河阳集，被冷谁怜范叔寒。\n坐想归途花正好，杜鹃声里破愁颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3358,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"度黄陂岭","author":"李光","text":"肩舆渺渺历崎岖，自笑谋身老更迂。\n献策但知忧社稷，投荒那敢顾妻孥。\n南行已度黄陂岭，北去何愁青草湖。\n冒雨穿云信奇绝，玆游真岂是良图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3359,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次郊行韵","author":"李光","text":"森森巨麓蔽秋冈，薄日笼阴一味凉。\n散策绕溪闲觅伴，幅巾对客坐焚香。\n午潮暗长看平岸，野竹才添便出墙。\n岩壑自无南北异，不妨随处得相羊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3360,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"某近复得女补之有诗次韵为谢","author":"李光","text":"荆棘林中蛇虺惊，悬知不作凤雏鸣。\n维熊已误传佳梦，得女犹能继颂声。\n贫贱预求梁氏婿，才情敢擅谢娘名。\n囊中幸自全无物，更觉新来分外清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3361,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和胡德晖增明轩诗","author":"李光","text":"窗间列岫郁嵯峨，一寸遥岑已是多。\n跨海空青叠寒玉，浮天浓绿艳修蛾。\n漫传五岳归图画，坐想千岩见咏歌。\n从此闭门闲觅句，直将世事付依阿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3362,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵补之续思越吟","author":"李光","text":"俗轨纷纷正背驰，鉴中白发愧明时。\n致身何必营三窟，入仕聊同庇一枝。\n故里有怀松菊老，圣朝无用计谋奇。\n相从喜有忘形侣，杖屦山樊酒满卮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3363,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"奉和补之至日书怀","author":"李光","text":"薄宦伶俜祗自伤，捧卮无复献华堂。\n暗惊老去苍颜在，谁道阴铺白昼长。\n天际云烟成五色，尧阶鸳鹭列千行。\n悬知冻笔孤吟罢，徙倚南窗揖翠浪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3364,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵七夕","author":"李光","text":"犊鼻长挑竹杖头，未能免俗想清流。\n西来谁遣青禽至，仙去还乘白鹤游。\n天上欢娱才瞬息，人间恩爱漫绸缪。\n穿针乞巧真儿戏，曝腹庭中更可羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3365,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"又德循补之宠示七夕酬唱聊发狂言以当一笑","author":"李光","text":"好事多应与愿违，经年消息却如期。\n匆匆旧约重寻处，耿耿银河欲渡时。\n绰约肌肤云路远，低迷帘幕玉钩垂。\n夜凉风露非尘世，天外弯弯堕月眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3366,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"补之以鍊养之说勉德循眷眷之意并见二诗若惧其不我从者以待德循可也他人能无诮乎因次韵奉寄 其一","author":"李光","text":"漫道壶中别有春，枉教众楚笑齐人。\n本来妙说元无说，信是灵真未识真。\n佩剑携书如可继，杀鸡炊黍不妨频。\n相逢且说无生话，若问长生有大钧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3367,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"补之以鍊养之说勉德循眷眷之意并见二诗若惧其不我从者以待德循可也他人能无诮乎因次韵奉寄 其二","author":"李光","text":"不用休粮学隐沦，眼前无事即仙人。\n解官终作陶元亮，晦迹聊同郑子真。\n交友尽缘酬唱密，关山岂碍往来频。\n流行坎止平生志，寿夭还如泥在钧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3368,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"客醉而亟归不虑畏涂之可戒当为罪首丞令不行与吏慢丞命其罪均也以为不然则县令先入又何逃焉因次韵戏答德循且诮深山道人眷眷炬火非胥靡登危而不慄者遂并以寄之","author":"李光","text":"肩舆归去未全醒，倚户何人念远征。\n事在赦前皆可罪，过因酒后各原情。\n壶中未便乘风去，夜半何妨秘息行。\n不向险中求不死，却因何处觅长生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3369,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵补之瑶堂瑞莲","author":"李光","text":"映水双开带晚烟，丹葩浥露斗鲜妍。\n瑶堂地产金莲瑞，蒿里人归玉府仙。\n并立江皋珠佩冷，相亲汉苑晓妆偏。\n舜庭敷奏无虚日，潜德并遗柱史传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3370,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和睡起饮茶","author":"李光","text":"虚堂清簟午抛簪，人静疏帘映昼阍。\n身过中年心已倦，病因烦暑气常昏。\n紫烟碧月天初赐，乳窦寒泉世莫论。\n尘味暂忘惟嗜此，更无馀思到芳樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3371,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠高申","author":"李光","text":"夜半匆匆离府庠，那知造物相槐忙。\n直言贾祸翻成福，正论惊人竟擅场。\n庚戌抡魁卿有技，甲辰近榜士流芳。\n勉旃学问全名节，富贵傥来如探囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3372,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送韦子骏赴中书舍人召","author":"李光","text":"桃李成蹊竹径幽，几年依隐玩林丘。\n日边紫诏频催入，郭外青山故挽留。\n河右始知天子圣，淮南应寝叛臣谋。\n丝纶世掌真馀事，济难徐观用巨舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3373,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]