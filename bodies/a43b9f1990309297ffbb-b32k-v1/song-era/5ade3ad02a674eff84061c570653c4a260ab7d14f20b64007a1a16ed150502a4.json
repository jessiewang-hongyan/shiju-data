[{"title":"酬玉汝 其一","author":"吴汝一","text":"磔攘毕春气，长嬴换新绿。\n爽风吹凉光，纫饵钓山渌。\n鯈鱼噀水香，菰蒲削蓝玉。\n老景结清和，心花委濠濮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43142,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"朅来 其二","author":"吴汝一","text":"岭上朅来弄明月，千里银光寒不缺。\n虾䗫魍魉走死尽，直数秋毫上金阙。\n心如此月月如心，嗒然独据无弦琴。\n腾腾转空白日昼，诗带流星过南斗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43143,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"朅来 其一","author":"吴汝一","text":"岭上朅来观白云，翔鸾奋鹤浮天英。\n斜开锦绣春树满，溶溶半露遥山青。\n忽然变现成苍狗，万里长风霍无有。\n海龙塞气不敢吹，日照虚空无老时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43144,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题西隐 其三","author":"吴江赵主簿","text":"偶无公事独凭栏，领略风烟万顷宽。\n说似西廊曾懋父，倩君椽笔写郊寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43145,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题西隐 其二","author":"吴江赵主簿","text":"脚力穷时地更偏，瘦藤危石两苍然。\n山僧已识幽人意，借与禅床自在眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43146,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题西隐 其一","author":"吴江赵主簿","text":"草树低迷爱晚晴，江天表里玉壶清。\n平生心事无人会，惭愧沧波欸乃声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43147,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词四首 其三","author":"吴百生","text":"钧乐云中动，銮舆天上行。\n百花齐醉日，孤月独明更。\n玉漏频催酒，金炉细结甍。\n春秋有常幸，日日调清平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43148,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词四首 其一","author":"吴百生","text":"妙选昭阳进，羞花妒六宫。\n行阶莲落地，随御柳含风。\n按舞天光近，徵歌烛影红。\n夜深金殿合，环佩月明中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43149,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"莫釐远眺","author":"吴百生","text":"金庭隔尘耸，玉柱插天浮。\n石古不知岁，溪虚长欲秋。\n绣重红错翠，锦簇阁兼楼。\n望里三州远，吟边松月留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43150,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词四首 其四","author":"吴百生","text":"中使质明催，珠宫宝扇回。\n髻云双凤拥，歌雪百花堆。\n竞立徼殊宠，群趋望独魁。\n寿阳春夜额，贴尽一庭梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43151,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词四首 其二","author":"吴百生","text":"阿娇金屋闭，群玉奉龙舆。\n夜色明光酒，春风长信裾。\n传宣严仗合，应侍冶容虚。\n笑簇嫣然地，名花总不如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43152,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乌夜啼","author":"吴百生","text":"夜夜乌来啼未央，明月出户空飞霜。\n吹笳征夫不就寝，宫筵列烛声满堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43153,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"吴羽","text":"滁阳自昔称名垒，旧有东园枕滁水。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43154,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"吴达老","text":"水流丁字通地脉，人从甲第破天荒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43155,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"牧儿","author":"吴伯凯","text":"磊块胸怀漫不平，牧儿横草耤功名。\n韩彭不戴貂蝉死，牛背斜阳且意行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43156,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏夜书所见","author":"吴伯凯","text":"吴牛见月喘，引重不得休。\n孤萤出露草，意行凌九秋。\n形大苦见役，物微长自由。\n世无漆园吏，持问逍遥游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43157,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"吴伯凯","text":"平生五千卷，为方不为圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43158,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"吴寿翁","text":"六一文风属后生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43159,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大宁寺过舅书舍","author":"吴时显","text":"长怕山林勒驾回，幽寻空像栎山隈。\n乘闲特羡春风约，行乐宁论暮景催。\n情分一家欣满座，穷愁千斛厌成堆。\n白头甥舅今稀有，愿把清樽日醉陪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43160,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"法相寺可赋亭","author":"吴时显","text":"尘埃谁复识瞿昙，高座风生玉麈谈。\n露浥芙蓉心与净，香浮薝卜鼻先参。\n杜陵托兴歌茅屋，山谷留情赋草庵。\n试叩禅关闻密语，前三三与后三三。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43161,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其十","author":"吴沆","text":"寇残井邑困流离，回首欢娱一一悲。\n不厌儿童遭世乱，惟愁父老说清时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43162,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其九","author":"吴沆","text":"江淮十载警胡尘，底事磨崖未勒勋。\n闻道本朝还遣使，且令诸将各收军。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43163,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其十八","author":"吴沆","text":"樵歌催日晚，村乐见年丰。\n……雁阵横冲雾，酒军酣战风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43164,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"折花","author":"吴沆","text":"野花开处客徘徊，胡蝶抟飞敛复开。\n折得野花随手去，不知胡蝶逐人来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43165,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"临高台 其二","author":"吴沆","text":"高筑黄金贮俊才，云关玉锁问谁开。\n若非倚赖东风力，安得凭虚直上来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43166,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春游吟","author":"吴沆","text":"鸟语烟光里，人行草色中。\n池边忽分散，花下复相逢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43167,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"首夏","author":"吴沆","text":"积雨有馀润，游云无定阴。\n燕飞华屋静，莺啭碧窗深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43168,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三清山","author":"吴沆","text":"选胜园林兴未阑，拿舟飞出小溪湾。\n光摇一碧回环水，翠挹三清远近山。\n似惜雨晴天恰好，真忘名利日长闲。\n松筠不锁神仙境，携得烟霞满袖还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43169,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"友人趋宁化","author":"吴沆","text":"闻君早晚趋宁化，尚有新诗别故人。\n试问几程端可到，还忧半载不相亲。\n伤心岁律峥嵘暮，解事梅花摘索新。\n去去冰霜频莫厌，庭闱和气即如春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43170,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岳阳作","author":"吴沆","text":"岁暮怀家客，通宵不自娱。\n诸兄得意否，老母有欢无。\n已谢交朋远，犹思弟妹孤。\n吾身不足念，为此一嗟吁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43171,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓晴","author":"吴沆","text":"夜半雨忽作，朝来云又晴。\n林花洗幽艳，池水湛虚明。\n草色侵衣湿，山光入座清。\n茅檐正幽寂，啼鸟两三声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43172,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"野外","author":"吴沆","text":"野外望中阔，遥山宛转随。\n小溪芳草合，高树古藤垂。\n鸟过惊风疾，云行度岭迟。\n回头失归路，还问老农知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43173,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二十","author":"吴沆","text":"霜皮围四十，水击黑三千。\n……山河归整顿，天地入陶甄。\n……但存忠贯日，未问写凌烟。\n……远吸金茎露，高攀玉井莲。\n……风度优囊笏，恩光绕赐鞭。\n……李唐光夹日，炎汉赫中天。\n……共承天柱折，独斡斗杓旋。\n……怀古歌鸿雁，伤今拜杜鹃。\n……王气周旋内，胡尘笑语边。\n……浮云开斥堠，飞鸟避戈鋋。\n……蜀道开天险，雄誇亿万年。\n停空蟠瑞气，盖代出真贤。\n……国多艰难尽，公归早晚遄。\n愿为元结颂，磨石待高镌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43174,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"以易授玭有契于予心喜而成诗","author":"吴沆","text":"早日功名世背驰，拟将文字疗寒饥。\n虽无杜甫惊人句，庶免渊明责子诗。\n总角宜兴俱脱颖，含哺应惠尚儿痴。\n殷勤谢尔传心印，解后灵椿见五枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43175,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其十九","author":"吴沆","text":"羽卫连荆棘，衣冠杂虎狼。\n烟沉凫雁断，天阔水云黄。\n……风悲云动色，天惨日无光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43176,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"早行","author":"吴沆","text":"晨风集微和，晓色动佳气。\n溟溟四郊烟，漠漠一川水。\n前村鸡犬喧，远树鸟雀喜。\n山腰客行来，林下雉惊起。\n时闻牧童谣，不见骑牛至。\n回头望东隅，晓日粲光丽。\n胸襟倏暄烦，败我幽静意。\n行行载驰驱，已复到城市。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43177,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"临高台 其一","author":"吴沆","text":"高高轩楹日照东，扶桑柱植西昆崙。\n上有明真紫霞客，厮征伯侨役羡门。\n月驭叱前驱，风驷殿后奔。\n灵衣披披溘晻霭，玉斧断断除烦冤。\n虚皇下两耳，授以金简文。\n相观峻极不容步，拟轶清气排重阍。\n咽日诵黄庭，滴露抄韦编。\n羊歧之亡罔象得，蛮触之角醯鸡天，临台一笑俱超然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43178,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚归","author":"吴沆","text":"夕阳西欲没，宛转山气昏。\n独逝颇无累，时欣暗经林。\n栖鸟未稳集，归马无奔声。\n恍忽自得意，兴来谁与言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43179,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二十三","author":"吴沆","text":"春令乍来风掠地，寒威潜退雪消峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43180,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其三十四","author":"吴沆","text":"已经平子宜无憾，未见夷吾得不忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43181,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二十五","author":"吴沆","text":"叶稀林脱颖，沙现水分镳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43182,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二十二","author":"吴沆","text":"水流成独往，山势作朋来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43183,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二十七","author":"吴沆","text":"柔桑翠竹相倾倒，细草幽花自发明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43184,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其三十一","author":"吴沆","text":"挑灯倦夜羞黄里，置笔穷年对白间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43185,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其十六","author":"吴沆","text":"西风横吹雨脚断，秋云轻笼日花明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43186,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其十二","author":"吴沆","text":"乱石分开急流水，群山拥出最高峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43187,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其三十二","author":"吴沆","text":"空虚气象还生白，笔退工夫见杀青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43188,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其三十三","author":"吴沆","text":"中朝共惜无双士，绝塞贪看第一人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43189,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其八","author":"吴沆","text":"圣主思文德，元臣献武功。\n一言深悟主，五利且和戎。\n……天地包羞日，山河匿怨中。\n……儒生别有泪，不是哭途穷。\n……战伐功何有，和亲计未疏。\n将军休抵掌，隐忍待驱除。\n……氛祲埋金阙，尘沙暝梓宫。\n……古来尝胆事，泣血望群公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43190,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二十八","author":"吴沆","text":"草迷花径烦调护，波泊莲塘欠节宣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43191,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其十一","author":"吴沆","text":"万井火熬波里雪，十州雷送雨前春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43192,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"吴沆","text":"隙风无端吹我烛，满窗明月心更清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43193,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其十五","author":"吴沆","text":"行杯波动金莲侧，剪烬灯飘宝蜡残。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43194,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其十四","author":"吴沆","text":"木落青无影，荷枯澹有香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43195,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二十一","author":"吴沆","text":"厌看花笑客，忍受草欺人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43196,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其七","author":"吴沆","text":"水痕才破腊，云黯似知春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43197,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二十九","author":"吴沆","text":"新月辉辉动，黄云渐渐收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43198,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其十三","author":"吴沆","text":"山高不改自然色，水远能流无尽声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43199,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其三十","author":"吴沆","text":"吹断碧云春昼永，落残红雨晓风轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43200,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其五","author":"吴沆","text":"耳根静处水流村，眼界空时山在门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43201,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其十七","author":"吴沆","text":"君少作奇字，瘦硬得柳骨。\n墨净剪水匀，势健拗铁屈。\n……新诗更镌磨，劲绝与字匹。\n老蛟寒卧波，壮士努抉石。\n翻盆势动摇，诗与字俱力。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43202,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其三","author":"吴沆","text":"江流回转石不移，钓丝卷尽生须丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43203,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其四","author":"吴沆","text":"为兵不愿作刀锯，刑人未必皆不忠。\n为器不愿作钟鼎，铭勋未为皆有功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43204,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其六","author":"吴沆","text":"燕忙将入夏，蚕暖正眠春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43205,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"吴沆","text":"树头明月光欲吐，反眼仰面天恢恢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43206,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二十六","author":"吴沆","text":"起于怀素节，嘉乃伴虚心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43207,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二十四","author":"吴沆","text":"争屯未就云头合，结党欲成风势高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43208,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"茅屋","author":"吴肖岩","text":"茅屋三间小，春风长草芽。\n故园经积雨，老树不多花。\n黄发长垂钓，古书犹满车。\n近来人事别，亦懒问桑麻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43209,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七夕戏成二绝 其一","author":"吴芾","text":"时入三秋气已清，节临七夕露初零。\n如何老子临风坐，也望天河牛女星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43210,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七夕戏成二绝 其二","author":"吴芾","text":"寄语天河牛女星，人人乞巧望聪明。\n老夫养拙生憎巧，只要冥心度此生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43211,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九月二十六日同朝宗泽民游洞宫用刘使君韵二首 其二","author":"吴芾","text":"爱游此地已多年，今日身心始豁然。\n洞里真人虽羽化，苍苍乔木自参天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43212,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九月二十六日同朝宗泽民游洞宫用刘使君韵二首 其一","author":"吴芾","text":"云藏仙窟几何年，一旦来游岂偶然。\n造物应怜林下客，故令一睹洞中天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43213,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二十七日泛舟偶成","author":"吴芾","text":"小舟游漾小池中，偶与吾人笑语同。\n好把钓竿烟雨里，一蓑放我作渔翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43214,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"入界","author":"吴芾","text":"日炙风吹人倦乏，山重水复路萦回。\n一番行病思休息，且喜今朝入界来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43215,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十五夜南园纳凉","author":"吴芾","text":"兀坐铃斋困郁蒸，举头忽见月华明。\n兴来策杖园中去，聊复寻山听水声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43216,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十六夜见月","author":"吴芾","text":"连宵待月屡登城，特地遮藏不肯明。\n过了佳辰方皎洁，嫦娥何事太无情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43217,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又和黄清表惠早梅","author":"吴芾","text":"姑射风姿绝点埃，年年长是腊前开。\n方疑今岁无消息，多谢君能折取来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43218,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又登碧云亭感怀三十首 其三十","author":"吴芾","text":"晚上危亭喜有秋，民安物阜本无忧。\n铃斋坐啸虽多暇，争似归田得自由。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43219,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]