[{"title":"同刘孝若野步","author":"徐照","text":"杖屦相随步野田，坐临阶石和诗篇。\n要看隔水人家菊，试借系门渔父船。\n且缓归情知有月，不生酒兴为无钱。\n寒来莫问家中事，才得身闲即是仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54139,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同徐文渊登永州高山寺","author":"徐照","text":"画图旧识高山寺，今在高山寺里行。\n千古崄峰长自直，一春潇水未曾清。\n孤城吹角寒猿应，破屋寻碑野鼠惊。\n天遣二人来远地，要将新景就诗名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54140,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舟中","author":"徐照","text":"秋气清如水，推篷夜不眠。\n芦花新有雁，莎叶尚鸣蝉。\n心向征途老，诗凭物景全。\n渔童看月上，吹笛柁楼前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54141,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"访可公宿","author":"徐照","text":"枯株围古寺，长觉莫寒增。\n坐听吹风雪，吟移照佛灯。\n试茶铛则水，点笔砚生冰。\n门外营营者，谁人及似僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54142,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"访观公不遇","author":"徐照","text":"卧犬闻人出，门当青栎林。\n固知多不在，自欲远相寻。\n宵短馀香印，林疏出磬音。\n昨来曾寄茗，应念苦吟心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54143,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"访赵紫芝","author":"徐照","text":"意欲寻君忘路远，入城还又出城来。\n菊明紫色天霜下，鱼没圆痕水垢开。\n新背古碑藏素箧，冻研山砚滴香醅。\n竹林好著君名姓，只恐君为禄仕催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54144,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"访僧居","author":"徐照","text":"客至无他事，房门不厌敲。\n好山元带郭，损屋旋铺茅。\n静砌生灵药，高林出远郊。\n水禽冬不见，春暖渐营巢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54145,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"访潇岸黄仲立","author":"徐照","text":"长似在船里，松声如水声。\n门当岗路掩，云向井栏生。\n道进渔樵客，家空世俗轻。\n阶前桐叶响，云是白鹇行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54146,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"访奭公宿和其韵","author":"徐照","text":"枯株围古寺，长觉夜寒增。\n坐听风吹雪，吟移佛照灯。\n灰沉麟骨碎，茶沸蟹涎凝。\n何计从师老，生涯若履冰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54147,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀如顺上人","author":"徐照","text":"西湖湖上寺，一别二三年。\n旧住房长闭，新栽树已圆。\n空多相忆梦，不得寄来篇。\n喜见邻僧说，归期是腊前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54148,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"求邓叔珍画","author":"徐照","text":"画要天机到，常人学不成。\n胸中无世事，笔下有诗情。\n断岸孤村接，高林远岫平。\n不能求片幅，空自识先生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54149,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陈保之访宿","author":"徐照","text":"不作王侯客，一身如散仙。\n少闻人世事，多欠酒家钱。\n省语初如傲，高文旧已传。\n去灯烧蜡炬，相对坐茫然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54150,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"净光山四咏呈水心先生 其三 会景轩","author":"徐照","text":"不见日东上，西原雨一晴。\n逐时看景异，风物入诗清。\n立久飞云灭，身高去鸟平。\n石峰何处是，归思忽然生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54151,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"净光山四咏呈水心先生 其二 绝境亭","author":"徐照","text":"高顶宜登望，吾州见地形。\n水通蛮国远，山出海门青。\n藓径僧行迹，风枝鹤退翎。\n公能同众乐，私帑建官亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54152,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"净光山四咏呈水心先生 其四 茶山堂","author":"徐照","text":"片山唐国赐，茶有数根留。\n几番见人说，今朝还独游。\n远波分段白，宿霭向晴收。\n却有觉庵主，犹能学道州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54153,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"净光山四咏呈水心先生 其一 宿觉庵","author":"徐照","text":"公说曹溪事，经今六百年。\n庵基平地筑，碑记远人传。\n种竹初遮日，疏岩只欠泉。\n自当居鼎鼐，岂在学修禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54154,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和翁灵舒冬日书事 其三","author":"徐照","text":"十日南山雪，今朝又北风。\n烧冲崖石断，梅映野堂空。\n难语伤时事，无成愧野翁。\n一生吟思味，独喜与君同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54155,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和翁灵舒冬日书事 其二","author":"徐照","text":"秀句出寒饿，从人笑过清。\n步溪波逐影，吟竹鸟应声。\n酒里安天运，春边见物情。\n耕桑犹罄乐，何事可营生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54156,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和翁灵舒冬日书事 其一","author":"徐照","text":"石缝敲冰水，凌寒自煮茶。\n梅迟思闰月，枫远误春花。\n贫喜田新长，吟令鬓已华。\n城中寻小屋，岁晚欲移家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54157,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和潘德久喜徐文渊赵紫芝还里","author":"徐照","text":"故交南北去，谁复念幽人。\n夕别惊初见，相知乐似新。\n竹声当暑净，茶味得泉珍。\n贫与诗相涉，诗清不怨贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54158,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜听黄仲立弹广陵","author":"徐照","text":"月色照君琴，移床出木阴。\n数声广陵水，一片古人心。\n投剑功无补，冲冠怒亦深。\n踪能清客耳，还是乱时音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54159,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贫居","author":"徐照","text":"既与世不合，当令人事疏。\n引泉鱼走石，扫径叶平蔬。\n谁念交情浅，难如识面初。\n荣途多宠辱，未敢怨贫居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54160,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"信州水南","author":"徐照","text":"众寺临溪上，东西屋数间。\n诗传叔伦句，真认贯休颜。\n柳过深潭碧，人随白鸟还。\n斜阳三百里，高甚水晶山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54161,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南岳万年松","author":"徐照","text":"所高无二丈，盘折数枝悬。\n两树死一树，多年言万年。\n节坚全化石，根蠹半盛泉。\n便可招琴悟，相同把笔传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54162,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"括溪和徐文渊","author":"徐照","text":"隔乡山万叠，前路见新年。\n云雾寒疑雪，溪乾步当船。\n梅初开竹下，雁不至沙边。\n共向湘中去，诗将远地传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54163,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"相中别邓该","author":"徐照","text":"隔水鹧鸪鸣，一汀香草生。\n自怜为客久，谁忍送君行。\n后会期何日，归途喜乍晴。\n它春科甲上，必欲见题名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54164,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送木宗院","author":"徐照","text":"此职司天派，员分南与西。\n事稀从吏懒，诗好笑人低。\n丹荔开屏画，青榕盖鹤栖。\n必思随侍日，曾有旧留题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54165,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送尘老入广化米开田","author":"徐照","text":"行李冲冰雪，途程半是船。\n去从人乞米，归要海成田。\n遇景因开画，思茶自掬泉。\n好风名舶趠，相候立江边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54166,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送朱严伯","author":"徐照","text":"好别无愁思，风霜一岁残。\n去因贫事迫，归有暮年安。\n远水维舟晚，青山绕舍寒。\n又谁怜静者，得句不同看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54167,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送张真翁赴举","author":"徐照","text":"端修修德在，门族盛如初。\n常有人登第，今称尔读书。\n南风舟去疾，西墅客来疏。\n所著青衫旧，前官拟别除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54168,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送李伟归黄山","author":"徐照","text":"心和无白发，长带一琴行。\n几路到君屋，数峰当郡城。\n妻儿贫自乐，丹药岁烧成。\n未必圣明代，终令隐姓名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54169,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送陈郎中知严州","author":"徐照","text":"去作严光郡，前为列宿官。\n水程趋阙近，丰岁得民安。\n公暇行随鹤，宵寒卧听滩。\n千峰临旧榭，曾约野人看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54170,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送徐文渊赴省试","author":"徐照","text":"永州官满后，借屋静中居。\n两岁不参部，一心惟读书。\n孤经期榜首，行日离春初。\n即有杏花宴，题诗众弗如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54171,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送徐玑","author":"徐照","text":"一舸寒江上，梅花共别离。\n不来相送处，愁有独归时。\n去梦千峰远，为官三岁期。\n思君难可见，新集见君诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54172,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送翁诚之","author":"徐照","text":"又作巴陵县，南州旧有声。\n未凭湘水绿，能似长官清。\n笛冷君山月，帆轻夏浦晴。\n五言多好句，颜杜减诗名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54173,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送潘才叔倅新安","author":"徐照","text":"大臣曾列荐，声誉有人闻。\n古郡知临水，黄山望似云。\n道情因病长，公务被吟分。\n天上除书近，时危必用君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54174,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送奭上人化缘","author":"徐照","text":"专志事皆成，期师此一行。\n阁盛灵佛像，碑载施人名。\n江阔风催渡，村深雪废程。\n暂劳曾共说，终可遂闲情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54175,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送薛子舒福州省觐","author":"徐照","text":"一马背西风，斑衣与古同。\n暂时离膝下，邻郡是闽中。\n到日残秋兔，还期早塞鸿。\n即须同邑里，来迓黑头公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54176,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重题翁卷山居","author":"徐照","text":"山中白日无尘迹，只有啼禽在树头。\n土蚁上鞋行径叶，楝花黏手掬溪流。\n高吟未许常人学，清福多应积世修。\n新茗一瓶蒙见惠，家童言是社前收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54177,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"哭翁诚之 其二","author":"徐照","text":"高义似君稀，思量泪滴衣。\n公馀长对坐，路远未容归。\n橘井尝甘冷，兰亭辨是非。\n谁怜穷贾岛，临老失栖依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54178,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"哭翁诚之 其一","author":"徐照","text":"因识诗情性，为官亦是清。\n吉人天不祐，直道世难行。\n寄讽曾称菊，思归或上城。\n赠余诗一轴，追和隔今生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54179,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"哭鲍清卿 其二","author":"徐照","text":"一病居闲久，恩荣自及孙。\n真传未老貌，禅赞在山言。\n沙鸟巢庭树，渔舟泊水门。\n重来旧游处，空有竹舆存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54180,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽王大夫","author":"徐照","text":"两任身为郡，里中如不知。\n民归清净化，家似困穷时。\n秦木凄秋韵，湘云结暮姿。\n若无遗爱在，何得后人思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54181,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽陈夫人","author":"徐照","text":"平阳林给事，有女识经书。\n为妇极能孝，今人皆不如。\n得年非饵药，了葬自餐蔬。\n闽峤嗟埋骨，新碑到野庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54182,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽陈西老母","author":"徐照","text":"夫人年八十，头发未如银。\n有子缘能孝，居家不似贫。\n案头经尚在，箱内药初陈。\n至日西门外，无非送葬人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54183,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽陈益谦","author":"徐照","text":"先生胡不仕，高卧在林泉。\n忧国能先见，无人肯荐贤。\n月明新冢上，橘熟旧庐前。\n所著书成箧，多应后世传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54184,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽徐一之","author":"徐照","text":"生平空献赋，不得似相如。\n圣代无遗逸，深溪自隐居。\n僧传诗藁远，鸟宿墓林虚。\n有弟情还切，碑将谏笔书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54185,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"桂阳道中","author":"徐照","text":"官树标牌号，遮阴种已成。\n井乾人立久，芦密兽行鸣。\n接洞多空地，居城半是兵。\n未能忘好古，缺石认题名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54186,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病中作","author":"徐照","text":"一行三步歇，屋漏坐频移。\n妻欲藏茶鼎，僧能施药资。\n邻园梅尽发，河岸草生迟。\n天解怜贫病，难令不作诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54187,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病起呈灵舒紫芝寄文渊","author":"徐照","text":"唐世吟诗侣，一时生在今。\n不因吾疾重，谁识尔情深。\n解愿衣赊酒，更医药费金。\n天教残息在，安敢废清吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54188,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"衰柳","author":"徐照","text":"风吹无一叶，不复翠成窠。\n枝脆经霜气，根空入水波。\n寒栖江鹭早，暗出野萤多。\n废苑荒堤外，人嗟旧迹过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54189,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"途中","author":"徐照","text":"只影微阳外，青山自郁盘。\n未经千里远，欲寄一书难。\n堠碣苔侵字，鱼塘水过栏。\n西风吹树叶，不问客衣单。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54190,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"途中寄赵紫芝","author":"徐照","text":"筠永州同路，人如异约何。\n雪风吟不废，山水忆同过。\n仙去家长在，时平石可磨。\n梦知归路远，全觉梦君多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54191,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高山寺晚望","author":"徐照","text":"石路近门方不险，刺桐疏处见僧归。\n小坡重叠无平屋，四月阴寒尚裌衣。\n山到道州高莫比，水分湘口绿相围。\n暮云不隔东南望，一片遥兼白鸟飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54192,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宿永康","author":"徐照","text":"路有三千里，春容若水浓。\n浅塘饥鹭下，晴霭市烟冲。\n孤望生遥思，频过记昔踪。\n宿程知近县，闻打发灯钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54193,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宿吉州永庆寺","author":"徐照","text":"古邑溪边寺，吟人爱寂寥。\n少僧斋室废，乞食钓乡遥。\n钟韵含霜气，楼檐近斗杓。\n汉时铜铸佛，瞻礼到今朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54194,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宿寺","author":"徐照","text":"古殿清灯冷，虚堂叶扫风。\n掩关人迹外，得句佛香中。\n鹤睡应无梦，僧谈必悟空。\n坐惊窗欲晓，片月在林东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54195,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宿翁灵舒幽居期赵紫芝不至","author":"徐照","text":"江城过一雨，秋气入宵浓。\n蛩响移砧石，萤光出瓦松。\n月迟将近晓，角尽即闻钟。\n又起行庭际，思君恨几重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54196,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宿翁卷书斋","author":"徐照","text":"一山秋色同谁看，又复相寻出郭来。\n邻竹种成高碍月，井泉汲少近生苔。\n忽惊寒事砧初动，不辨晨光户尽开。\n君爱苦吟吾喜听，世人谁更重清才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54197,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄刘孝若","author":"徐照","text":"难得刘夫子，生平极爱予。\n有时吟好句，特地到贫居。\n远别宁无恨，平安莫问书。\n梦穿庭际菊，密叶过畦蔬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54198,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄徐文渊","author":"徐照","text":"别君一百一十日，喜听人传八句诗。\n只在邻州难得见，却思前任远相随。\n分名丹荔画成轴，出处子鱼糟过时。\n近日有谁论字法，似闻检法是同师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54199,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄翁灵舒","author":"徐照","text":"游远令人瘦，思君甚渴饥。\n恨无如意事，懒乞送行诗。\n帝陌喧车马，王门守鹿貔。\n何时借僧榻，切勿负幽期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54200,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄筠阳赵紫芝推官","author":"徐照","text":"府后岩峦众，何时访古仙。\n井甘邻室共，钟远雪风传。\n病去茶难废，诗多石可镌。\n蜀江春未动，犹得缓归船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54201,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄赠葛朴翁","author":"徐照","text":"头上一方巾，西湖住宅新。\n古今称句法，岛贺是僧身。\n买马因添口，将钱或施贫。\n有轩名数竹，还复属何人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54202,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔家","author":"徐照","text":"阿翁年纪老，生计在纶丝。\n野水无人占，扁舟逐处移。\n数鳞新柳串，一笛小儿吹。\n有酒人家醉，公卿要识谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54203,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"移家雁池","author":"徐照","text":"不向山中住，城中住此身。\n家贫儿废学，寺近佛为邻。\n雪长官河水，鸿惊钓渚春。\n夜来游岳梦，重见日东人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54204,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菊","author":"徐照","text":"气受一岁足，千花极后芳。\n蕊浮茶鼎沸，色染道衣黄。\n天上虚星落，人间寿水香。\n邓州兵革外，流种遍江乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54205,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜蒋德瞻还里","author":"徐照","text":"长作汤村梦，今来免所思。\n丹灵年命永，琴裂壁风吹。\n开户秋花发，终经午饭迟。\n岳阳何日去，后集要君诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54206,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"塔山作","author":"徐照","text":"东岸沙新淤，西村半失田。\n夕阳明望外，寒雁落愁边。\n懒下遮风帽，谁添买酒钱。\n小坡人不渡，灯火压潮船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54207,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游雁荡山 大龙湫瀑布","author":"徐照","text":"飞下数千尺，全然无定形。\n电横天日射，龙出石云腥。\n壮势春曾看，寒声佛共听。\n昔人云此水，洗目最能灵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54208,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]