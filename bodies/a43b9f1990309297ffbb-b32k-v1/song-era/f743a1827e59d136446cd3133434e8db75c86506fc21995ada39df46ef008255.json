[{"title":"次韵汪仁甫","author":"吴锡畴","text":"斜河炯炯雁飞飞，老却斯人天未知。\n三径秋光犹在菊，一年心事可无诗。\n岁华迅似离弦箭，愁思多于盈杼丝。\n寂寂空山明月里，谁拈霜竹倚风吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44977,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵逢原偶兴","author":"吴锡畴","text":"曾共清灯坐夜阑，依然故我只儒酸。\n昏眸但觉看山易，倦足方知行路难。\n扪虱坐谈思傲睨，闻鸡起舞叹衰残。\n閒中恰续无功记，以醉为乡尽自宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44978,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵答吴仲山","author":"吴锡畴","text":"声利驱人万毂忙，何如林下玩幽芳。\n一池草色春不尽，半树梅花月也香。\n古锦忽分诗眼巧，短笺难寄话头长。\n相望正恨相逢晚，莫惜来过剪韭黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44979,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵谢元寿","author":"吴锡畴","text":"曾被儒冠误，谋生事事疏。\n洲无千树橘，家有五车书。\n叠石和苔斸，移梅带雪锄。\n好非人所好，习气未能除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44980,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"老境","author":"吴锡畴","text":"老境已骎骎，功名负壮心。\n昏眸云雾隔，短鬓雪霜侵。\n身为贫长客，诗因病懒吟。\n春山归未得，门径藓花深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44981,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟中","author":"吴锡畴","text":"一笑起推篷，烟云望眼中。\n橹鸣无调乐，帆饱有情风。\n山近水偏绿，鹃啼花正红。\n前途足奇观，行色莫匆匆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44982,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"迂拙","author":"吴锡畴","text":"迂拙安吾分，炎凉任世情。\n箪瓢自钟鼎，风月即勋名。\n春树重重暗，晴云片片明。\n沧波山阁外，浩荡一鸥轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44983,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"严滩","author":"吴锡畴","text":"极目飞鸿外，苍茫一渺然。\n风清垂钓濑，月淡放梅天。\n展卷评诗句，探囊结酒缘。\n舟中无此乐，但只闭篷眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44984,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"别吴仲俊","author":"吴锡畴","text":"背人春事水趁东，浅紫深红次第空。\n宿霭未乾桑叶雨，薄罗初试楝花风。\n诗联锻鍊微吟里，豪气施行半醉中。\n此去相逢堪几度，别怀作恶老来同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44985,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"听雨","author":"吴锡畴","text":"细细檐花雨，青灯耿客魂。\n轻烟腾柏子，流水响桐孙。\n日月双车毂，乾坤一酒樽。\n蚁柯分已定，人自苦追奔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44986,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"还友人诗卷","author":"吴锡畴","text":"坛荒杜陵后，何以续诗名。\n千里江山秀，一襟风露清。\n淡中无浅短，豪处有和平。\n细读松间集，如闻雅奏声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44987,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"凭栏","author":"吴锡畴","text":"刘伯龙如鬼笑何，居然幻境蚁南柯。\n世间知止人应少，天下难言事最多。\n梧叶凄凉依节序，雁声依约自关河。\n凭栏莫起悲秋意，老色何妨借酒酡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44988,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜坐","author":"吴锡畴","text":"萧萧下庭叶，未晚闭柴门。\n故箧搜诗读，残灯唤酒温。\n砧鸣深巷月，犬吠隔溪村。\n人世如无夜，劳生事更繁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44989,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜感","author":"吴锡畴","text":"少年未识堤防老，不办坡翁大字书。\n犹有壮心耽万卷，其如昏目负三馀。\n睡迟祇怕中宵觉，交淡从教俗轨疏。\n瞑坐漫搜诗拨遣，灵台一片炯如初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44990,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"姑苏晚泊","author":"吴锡畴","text":"有味吟边景，无愁醉里身。\n如何连夜梦，只是到家频。\n更永迟留月，梅寒漏泄春。\n吴王台下泊，访古待清晨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44991,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"临川忆旧","author":"吴锡畴","text":"漫浪同为逆旅人，倏然离合入思频。\n清明上巳多愁雨，芍药荼蘼各殿春。\n不改交情山翠旧，渐添老色鬓华新。\n近来世念寒烟薄，已办青蓑理钓纶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44992,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"客枕闻鹃","author":"吴锡畴","text":"烟新寒食过，月皎子规来。\n万里他乡恨，千年故国哀。\n窗深敧枕听，梦短到家回。\n为尔添愁寂，春风不耐催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44993,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"客思","author":"吴锡畴","text":"淹留为客久，萧散与心违。\n妻病家缘废，奴逃书问稀。\n雨荒招鹤径，苔滑钓鱼矶。\n愧尔汀头鹭，沧波自在飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44994,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日","author":"吴锡畴","text":"韶光大半去匆匆，几许幽情递不通。\n燕未成家寒食雨，人如中酒落花风。\n一窗草忆濂溪老，五亩园思涑水翁。\n无赋招魂成独啸，且排春句答春工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44995,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日从伯氏领子侄郊行","author":"吴锡畴","text":"寒食清明共一时，柔红开遍野棠梨。\n繁禽声乐风光丽，弱柳阴浓日脚迟。\n身外生涯何似酒，人间局面只如棋。\n行春莫待花飞却，藉草开樽剩赋诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44996,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"洲上","author":"吴锡畴","text":"藜杖步芳洲，风花点碧流。\n诗情凫泛泛，心事水悠悠。\n有约山长翠，无名草自幽。\n声声啼布谷，夜雨足西畴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44997,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"独酌","author":"吴锡畴","text":"独酌悠然醉，应无语笑哗。\n百年柯上蚁，万事盏中蛇。\n诗定重删草，灯挑又作花。\n不烦眠遣客，长啸岸乌纱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44998,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"癸酉元日","author":"吴锡畴","text":"一声爆竹又惊春，荼垒中间写此心。\n忽忽行年周六甲，便便痴腹拟三壬。\n酒泉郡里宁甘饮，饭颗山头尚苦吟。\n强健得閒元是福，何妨终老住云林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44999,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋日","author":"吴锡畴","text":"西风吹雨故将寒，斗室盘旋宇宙宽。\n芦已成花衰鬓白，枫犹染叶醉容丹。\n人间岁月几羊胛，身外勋名一鼠肝。\n领略秋光无限意，东篱閒掇落英餐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45000,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋怀","author":"吴锡畴","text":"雁声叫断一天秋，寒气凭陵季子裘。\n莫恨蛾眉偏薄命，曾知猿臂自难侯。\n绕黄花有诗消遣，持紫螯兼酒拍浮。\n未用凄凉如宋玉，月明清思满前洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45001,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋来","author":"吴锡畴","text":"秋来病叶不禁风，渐觉虚檐坠片红。\n斜日半溪人唤渡，断云千里雁横空。\n诗情得似驯鸥子，世事徐观失马翁。\n忻戚莫将为我役，此怀拍拍自春融。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45002,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋夜","author":"吴锡畴","text":"寂寂虚堂风露凉，边声惊听雁南翔。\n短筇梦涉秋三径，长笛思乘月一航。\n老眼添昏如浊镜，吟怀多感类寒螀。\n久知拙不趁时样，肯羡东邻斗靓妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45003,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"荆溪舟中对月","author":"吴锡畴","text":"历眼旬馀半，终宵月在天。\n若将今岁看，仅有此番圆。\n寒逼鸿洲外，光摇蚁瓮边。\n家山千里远，应共一婵娟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45004,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郡侯奏请为先竹洲易名因送逢原入京","author":"吴锡畴","text":"一封奏入五云开，褒录儒先动九垓。\n生意欲回洲上竹，好风已递陇头梅。\n志铭标揭留幽隧，谥法昭彰在曲台。\n去去片帆春水滑，捧持飞诰看归来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45005,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闻笛","author":"吴锡畴","text":"乾坤沈万籁，风露杳双清。\n城近更初转，山空月正明。\n揽裘寒意重，看剑壮心惊。\n迢递谁家笛，凄凉此夜情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45006,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭赵成德","author":"吴锡畴","text":"鹤怅东岩夜，声悲不可闻。\n有图留水月，无句管烟云。\n身后空传稿，生前事作坟。\n忍思携手日，溅泪漫纷纷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45007,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏日","author":"吴锡畴","text":"雨作年丰计，凉为午睡媒。\n不烦思饮露，已可洗飞埃。\n延月帘高捲，看山牖尽开。\n心閒逢事懒，褦襶且休来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45008,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"烟波奇观写兴","author":"吴锡畴","text":"层楼一望立斜晖，三两人家出翠微。\n浅濑欲流山影去，疏帘不碍月明归。\n自来樵钓无荣辱，到底功名有是非。\n识得老天穷我意，免教世俗践危机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45009,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寂寂","author":"吴锡畴","text":"寂寂闭门坐，身閒心太平。\n豆花含雨重，梧叶坐秋鸣。\n道路风波恶，山林梦寐清。\n少狂无复在，未减是诗情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45010,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄漫客汪子美兼简竹牖东美","author":"吴锡畴","text":"雁断无书到笔峰，暮云空自满江东。\n漫郎一片襟期杳，子美三生习气同。\n身外有赀惟老砚，竹边无价是清风。\n何时共听檐花雨，小醉微吟夜烛红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45011,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"悼鹤","author":"吴锡畴","text":"乘化归辽海，双笼一不开。\n坠翎留片雪，遗迹印荒苔。\n月朗怜孤唳，琴閒忆共来。\n瘗铭为琢石，鸡鹜不须猜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45012,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚山","author":"吴锡畴","text":"晚山欣静对，杳杳碧无垠。\n病叶明残照，飞鸿带断云。\n自怜麋鹿性，宜入鹭鸥群。\n世路多殊辙，升沈迹已分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45013,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚步","author":"吴锡畴","text":"晚日弄晴阴，徐行野径深。\n山寒梅韵峭，林杳鹤声沈。\n缓水元无响，飞云岂有心。\n颇知閒最乐，天地入清吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45014,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚春","author":"吴锡畴","text":"书策炉熏了日閒，雨馀庭砌绿回环。\n一春又是寻常过，两鬓谁知容易斑。\n轻薄杨花芳草岸，凄凉杜宇夕阳山。\n不嫌贫有双飞燕，依旧衔泥自往还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45015,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚春喜友人至","author":"吴锡畴","text":"柳门竹巷静生苔，节序俄惊物物催。\n一雨拉将寒食过，百花让与牡丹开。\n若为缱绻留春日，正可淋漓纵酒杯。\n呼舞忽闻猿鹤喜，儿童忙报故人来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45016,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚晴","author":"吴锡畴","text":"雨脚风收断，斜阳漏晚天。\n径芜蛙张王，花霁蝶轻儇。\n画思平林外，诗情步屧边。\n无山将亦隐，底用买山钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45017,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菊边持螯","author":"吴锡畴","text":"奔火狂难改，横戈事已非。\n形模虽可怪，风味故应稀。\n玉斫双螯洁，金披一壳肥。\n持杯篱菊畔，又见醉忘归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45018,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"遇梅初花","author":"吴锡畴","text":"陇上无人寄一枝，疏花忽见喜生眉。\n岩棱面瘦霜明里，潇洒香寒月上时。\n比姑射仙同调度，与林逋老共襟期。\n孤芳不竞能坚守，肯向离骚怨未知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45019,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"新城","author":"吴锡畴","text":"短棹泊新城，江宽风易生。\n帆随潮共上，烟接岸俱平。\n冷蕊江南信，孤鸿塞北声。\n诗成休朗诵，怕有老龙惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45020,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"新荷","author":"吴锡畴","text":"园林春去后，幽景属池塘。\n过雨钿犹小，吹襟风已香。\n莫期包作馈，好待集为裳。\n太极翁何在，花时爱敢忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45021,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"楚东岁暮","author":"吴锡畴","text":"楼高霜冷漏声迟，独立阑干忆别离。\n明月一奁磨后镜，疏星几点劫残棋。\n岁寒时节难为客，老日头颅尽付诗。\n颇觉凄凉无晤语，临风说与冻梅知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45022,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蓝溪道中","author":"赵戣","text":"绿窈雨初歇，清和日正长。\n乳禽穿薄霭，弱蔓上颓墙。\n村市笋厨美，田家麰饵香。\n老翁扶杖出，小立看移秧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45023,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"僮谕","author":"吴锡畴","text":"小隐生涯无别事，护持蓑笠傍鸥沙。\n清泉频注吟边砚，活火随煎饭后茶。\n趁早须来添鹤料，便忙也去看梅花。\n焚香扫地齐书帙，客到邻墙有酒赊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45024,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"醉吟","author":"吴锡畴","text":"一径碧苔深，萧閒几醉吟。\n野花开自落，春色霁还阴。\n涉世谋多拙，逢人口欲瘖。\n门前流水净，洗尽利名心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45025,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"擘蟹","author":"吴锡畴","text":"寒蒲就缚失横行，已矣甘从五鼎烹。\n凭恃甲戈名以躁，贮藏风露败于清。\n芦花洲冷霜威健，竹叶杯深饮兴生。\n且与老饕成后赋，正须一笑付姜橙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45026,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山居寂寥与世如隔是非不到荣辱两忘因忆秋崖工部尝教以我爱山居好十诗追次其韵聊写穷山之趣 其三","author":"吴锡畴","text":"我爱山居好，乾坤自在身。\n林泉睎隐士，风月谥閒人。\n村酿添春困，庖蔬胜鼎珍。\n几携蓑笠去，保社在鸥津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45027,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山居寂寥与世如隔是非不到荣辱两忘因忆秋崖工部尝教以我爱山居好十诗追次其韵聊写穷山之趣 其二","author":"吴锡畴","text":"我爱山居好，蔬畦间莳花。\n笕泉归爨舍，篝火乞邻家。\n茁嫩猫头笋，焙芳雀舌茶。\n野人曾拜号，何用给黄麻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45028,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵写兴","author":"吴锡畴","text":"不学韩公咎斗牛，此心无愧许沙鸥。\n阴晴明日自难料，得失频年已熟筹。\n痴计空为千载虑，虚名翻误一生忧。\n閒中菘韭皆真味，绝胜羊腔进膳羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45029,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵题纯老房竹","author":"吴锡畴","text":"有竹便不俗，萧疏三数竿。\n云深茶灶湿，雨过佛灯寒。\n纪壁何年种，停经了日看。\n尘劳应可涤，几欲借薄团。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45030,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"竹洲重葺仁寿堂","author":"吴锡畴","text":"抗章当日勇辞荣，三咏循陔世念轻。\n娱悦高堂仁者寿，壅培遗植圣之清。\n云涵翠葆添新荫，秋逼青琅戛旧声。\n故址依然成栋宇，水心题扁尚晶明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45031,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春望","author":"吴锡畴","text":"春事今如此，凭高兴未阑。\n半帘疏雨过，一院落花閒。\n草色迷幽径，禽声出晚山。\n东风能育物，不改鬓毛斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45032,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"结屋","author":"吴锡畴","text":"结屋须教坐对山，把茅才此有三间。\n浇花抱瓮调停懒，洗砚裁笺准备閒。\n未问丹砂能蜕骨，久知绿酒可酡颜。\n江湖浪迹成何事，抖擞归囊句不悭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45033,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"旅舟度岁呈范尧臣","author":"吴锡畴","text":"柏盏椒盘且罢休，吕蒙城下泊孤舟。\n昏灯独照还乡梦，久客新添别岁愁。\n爆竹无声惊寂寞，梅花有意伴淹留。\n明朝例是加年事，不信公侯不白头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45034,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寻梅","author":"吴锡畴","text":"迤逦寻梅过别村，归来新月照黄昏。\n更无可觅春风面，撚断冰髭立断魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45035,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出历坪铺","author":"吴颐","text":"从来年少怯春寒，老大那堪行路难。\n已去邮亭重下马，少须朝日暖征鞍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45036,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江村","author":"吴颐","text":"前村笑语近黄昏，独向江头望故园。\n漂泊每怜归去晚，儿童各自解方言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45037,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闻寓舍之侧花盛开口占绝句 其二","author":"吴颐","text":"君嫌无伴懒看花，我向花时更忆家。\n欲趁芙蓉同一醉，秋江好为送归槎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45038,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闻寓舍之侧花盛开口占绝句 其一","author":"吴颐","text":"冶城西北似村家，每共寻春到日斜。\n闻说春来花更好，为怜无伴懒看花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45039,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次邦宪宣德红梅诗韵 其五","author":"吴颐","text":"绝品花逢绝俗人，吟看屡倒接䍦巾。\n剸烦自昔多馀刃，痛饮于今莫负春。\n喜事擅名虽有素，屡空此语恐非真。\n典衣贳酒犹非恶，醉任清歌落暗尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45040,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次邦宪宣德红梅诗韵 其一","author":"吴颐","text":"攀条弄蕊苧罗人，半亸金翘笑整巾。\n惯见冰肌斜映月，似惊酒面暗生春。\n诗翁思苦饶先醉，画史愁多恐失真。\n寄语东风为披拂，莫教容易惹芳尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45041,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次邦宪宣德红梅诗韵 其三","author":"吴颐","text":"玉骨冰肌冷照人，匀红轻浥绛罗巾。\n更无凡木能争艳，定向壶中别得春。\n久稔新诗能写物，须知樽酒可藏真。\n寄声闭户英夫子，体取居尘不染尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45042,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次邦宪宣德红梅诗韵 其二","author":"吴颐","text":"年来恼乱探花人，裂尽陶公漉酒巾。\n傅粉早工欺白雪，施朱更欲媚阳春。\n衣冠未怪多侪俗，花木无情亦丧真。\n他日和羹何所赖，纷纷行见满前尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45043,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次邦宪宣德红梅诗韵 其四","author":"吴颐","text":"留情赋咏尽闻人，似得吴姬为执巾。\n蝶翅稍应容辨色，桃腮无复敢娇春。\n似嫌素艳同姑射，著意新妆学太真。\n栽近华堂歌舞地，未容车马送纤尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45044,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]