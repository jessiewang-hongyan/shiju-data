[{"title":"秋暮书怀 其四","author":"张舜民","text":"濯濯荒山麓，娟娟孤女祠。\n晓泉开宝镜，秋月画蛾眉。\n拾翠来泾汭，行云过北池。\n犹胜青冢魄，埋恨九原悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56054,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋暮书怀 其三","author":"张舜民","text":"忆昔曾游处，俄经二十年。\n重来人不识，独想事依然。\n北海知刘备，荆州小仲宣。\n如何骑骏马，徼倖学开边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56055,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋暮书怀 其一","author":"张舜民","text":"秋日平凉客，栖迟泮水间。\n家贫思得禄，性懒要长閒。\n欹枕时闻雁，登城忽见山。\n征西旧时将，大半发毛斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56056,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋暮书怀 其二","author":"张舜民","text":"客舍无前后，分明似一舟。\n瓶罂生计小，儿女长年忧。\n糊口身将老，谋归岁聿周。\n布衣今复敝，莫问黑貂裘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56057,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋暮书怀 其七","author":"张舜民","text":"节物推移速，登临感慨多。\n寒云飞陇首，残叶下朝那。\n代北惭归马，洮西尚凯歌。\n惟怜鏖战骨，寂寞掩山阿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56058,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋暮书怀 其五","author":"张舜民","text":"旅鬓茎茎白，霜梨叶叶红。\n可怜非类者，同落有涯中。\n万物齐为马，劳生独转蓬。\n此行江海外，便作狎鸥翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56059,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送比部孙郎中将漕二浙","author":"张舜民","text":"前朝使节拥朱轩，乃是君家小状元。\n不独官资如令祖，更将学术付贤孙。\n上供旋捣新禾米，行部时惊旧水痕。\n游遍天台便归好，乔松翠竹满青门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56060,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送叶公义叟求宫祠归吴下","author":"张舜民","text":"把还使节请祠真，便作吴江渐退身。\n凭轼几州沾惠爱，归装一味是清贫。\n相思欲控琴高鲤，卜宅须邀李子邻。\n不是荐章论再起，朝廷自重老成人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56061,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送孙积中兄待次吴兴","author":"张舜民","text":"骅骝不惜换舟行，人到归时意气生。\n五马未来迎使节，四弦何事作离声。\n焚黄此去荣归里，垂老相看老弟兄。\n来岁北来如访我，寄书频到利陵城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56062,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送孙积中同年赴任陕府","author":"张舜民","text":"劭农使者岭南回，上佐题舆陕道开。\n河水已随浮世去，条山应喜故人来。\n雨摧苦笋催羹臛，风飐樱桃落酒杯。\n我欲函关更西去，不知令尹肯相陪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56063,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送何子温提刑奉使江东","author":"张舜民","text":"奉使江东知几春，此行重驾赤车轮。\n青绫故被留归我，白发祠郎便乞亲。\n老大岂堪愁桂玉，秋风依旧长鲈莼。\n宦途出处何须较，且与庐山作主人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56064,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送吴都曹还芜湖","author":"张舜民","text":"柳岭相从岁屡迁，南湖同泛又经年。\n斋前怪石曾为枕，门外长杨忆系船。\n白酒一壶贤圣乐，古书千卷弟兄传。\n九衢尘土忙如火，握手相看思黯然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56065,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送庞舅大夫","author":"张舜民","text":"外家门馆未应疏，舅氏多能作大夫。\n才命淹回犹半刺，舟船缭绕向三吴。\n兴公自有游山赋，郑老宁无过海图。\n去国长年宜自爱，不须频叩步兵厨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56066,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送郑平叔司勋之陕二首 其二","author":"张舜民","text":"憧憧大道两京来，千骑东方最上才。\n岂有甘棠存故国，空馀河水绕行台。\n松筠寂寂徵君宅，箫鼓匆匆过客杯。\n九陌风尘归未得，不知青眼为谁开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56067,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送郑平叔司勋之陕二首 其一","author":"张舜民","text":"忆昔垂髫里闬间，披云常睹一峰巑。\n青衫白发经忧患，珥笔含香最岁寒。\n梦寐依稀留北省，家山迤逦近长安。\n下车已接樱桃会，走马西归趁一盘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56068,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送章质夫同年","author":"张舜民","text":"同年事契最知名，众谓朝廷得老成。\n感慨共论平昔事，蹉跎还累故人情。\n节旄落尽髭仍黑，髀肉消残宠未惊。\n若过函关须北望，皑然依复俟河清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56069,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送鲍经句赴辟洮东幕府","author":"张舜民","text":"平昔通家子，今为幕府宾。\n宦游知几日，器业已成人。\n陇右从戎客，燕南老病身。\n军中想多暇，莫惜寄书频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56070,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送鞠十二朝散将漕二浙 其一","author":"张舜民","text":"关塞烟尘二十秋，适持使节海山头。\n行衙到处皆如寺，按部经年不离舟。\n公举所知当勿枉，上供易足更何求。\n若论安便无加此，秪恐旁求第一流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56071,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送鞠十二朝散将漕二浙 其二","author":"张舜民","text":"闻说长安苦戴星，公家无补秪劳形。\n每思肥羜心先写，今见淮山眼自青。\n岂乏寻常将漕挽，好留人物为朝廷。\n四明久已无狂客，欲问天工乞箳篂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56072,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"顺阳 其二","author":"张舜民","text":"隐隐来山远，茫茫去路平。\n舟车楚北户，城冢汉南京。\n小杏沾花摘，春醪对雨倾。\n士民留我住，强作少陵行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56073,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"顺阳 其一","author":"张舜民","text":"已免均房险，宽平喜博山。\n园林皆掩映，风俗自安闲。\n麻麦三春暮，人烟百里环。\n吾行半天下，难得此江关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56074,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"食杨梅荔枝思去年","author":"张舜民","text":"杨梅味已酸，荔子色能丹。\n火齐骊龙脱，江绡玉露团。\n谪居深不负，沈醉亦何难。\n今岁无人剥，吁嗟任满盘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56075,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"凌虚台","author":"张舜民","text":"岐山四合与台平，半露园林叶未成。\n是处芳菲皆可惜，晚来风雨太无情。\n山川不改秦云色，宫室长悬陇水声。\n唯有故园终不见，仓庚黄鸟向人鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56076,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"原州赠王补之洛苑同年","author":"张舜民","text":"汴上相从又几星，尚淹符竹守临泾。\n不须怪我头添白，且喜逢君眼暂青。\n旧任再游空寂寞，同年屈数半凋零。\n何当展尽平边策，图使秦民得敉宁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56077,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"徐刚中醴陵少府于山中寻出一洞有铭曰虬渊自然六室奇怪求诗以纪之醴陵多丁氏令威之后云","author":"张舜民","text":"重重翠筱蔽溪湾，石烂松枯不记年。\n但见桃花浮绿水，有时独鹤下青田。\n自然六室流钟乳，别隐三阶出洞天。\n身在故乡人不识，秪应徐令是丁仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56078,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"真州仪真观","author":"张舜民","text":"闻说仙乡接濑乡，閒游诗侣礼虚皇。\n三潮宝派通胥浦，万叶灵杉蔽蜀冈。\n天地杳冥供写像，江山回合助灵祥。\n五云送入蓬莱岛，留与人间作道场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56079,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"离山阳","author":"张舜民","text":"日日东南去，空劳北望魂。\n孤帆转城角，返照入船门。\n强饭甘鱼菜，随方学语言。\n蛙声不忍听，为似故山村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56080,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"离真州","author":"张舜民","text":"日日北风吹上水，年年客思搅新秋。\n山长水远连三楚，物态人情又一州。\n隔岸晚峰如见揖，并船孤鹜似相留。\n因知景略非前达，身后犹须具十牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56081,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"部役书怀","author":"张舜民","text":"近市铜章泊近郊，炯无尘虑挂秋毫。\n含宏品汇知天大，照鉴容光仰日高。\n匝舍柔桑围幄幕，弄风新麦泛波涛。\n巷歌野哭应听取，珍重吾家制锦刀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56082,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴州送许叔献员外赴道州","author":"张舜民","text":"岭下为迁客，人中得老成。\n传经汉丞相，授讲鲁诸生。\n五斗青衫色，三湘白发茎。\n话言犹未尽，要作道州行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56083,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿卢岩寺","author":"张舜民","text":"先生事业老空谷，弟子几多作绛纱。\n鹤板当年来上国，碧岩今日属僧家。\n松风生籁延虚室，瀑水喷珠缀鲜花。\n我有故山归未得，年年魂梦绕天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56084,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梁才甫自湖南移使广西自广西移使广东自广东复移湖外三年之间周历四路今者北还已越郴岭道次作诗见寄渴于会遇谨用赓和","author":"张舜民","text":"天际云帆百尺开，广西移去广东回。\n未成老大归朝计，且喜平安出岭来。\n竹马共迎新使节，松斋暗锁旧莓苔。\n回思托荫无多日，早至潇湘欲重陪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56085,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅子","author":"张舜民","text":"月破冥冥雨，枝摇闪闪黄。\n口中先水出，衣上带花香。\n肺疾须?醉，牙疏不耐尝。\n调羹无复用，山谷日倾筐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56086,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渔父","author":"张舜民","text":"家住耒江边，门前碧水连。\n小舟胜养马，大罟当耕田。\n保甲元无籍，青苗不著钱。\n桃源在何处，此地有神仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56087,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"萤","author":"张舜民","text":"江皋萤火故煇煇，仍解穿帘夜点衣。\n但取见时增意思，莫嫌生处太卑微。\n月明敢向星中乱，天黑偏能雨里飞。\n今日分明知我去，何年漂泊照吾归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56088,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"黄陵庙","author":"张舜民","text":"青草仍残照，黄陵一望中。\n壁书迁客泪，帘卷过湖风。\n斑竹痕犹浅，苍梧恨莫穷。\n年年秋水上，瑶瑟伴惊鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56089,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"黄陵题咏","author":"张舜民","text":"箫韶不返九疑愁，双凤追思楚水秋。\n袆翟飘摇摧画壁，佩环零落挂帘钩。\n春深兰芷供香案，日暮乌鸢送客舟。\n自是江湖清绝处，后人憔悴写离忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56090,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"焦君以锦鸡为赠文彩可爱性复驯狎终日为家猫所困因遂挈还仍嗣短句","author":"张舜民","text":"鲁恭感物性能驯，因把华虫赠里仁。\n虽有文章堪悦目，却无言语解谋身。\n只愁猫犬常窥汝，胡不山林远避人。\n好在旧笼还旧主，便当归放涧之滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56091,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登大岯","author":"张舜民","text":"东郡韩延寿，黎阳李魏公。\n一时推岂弟，累代想英雄。\n草木芳菲外，山河感慨中。\n但逢川上客，不见狎鸥翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56092,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赐资治通鉴呈范淳父学士","author":"张舜民","text":"通鉴初成赐近臣，不遗疏贱布恩均。\n我投淮水五千里，君滞周南二十春。\n东观汗青身是梦，西宫削藁事如新。\n细思当日修书者，祗有三人今一人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56093,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"碇斋独坐怀兄弟","author":"张舜民","text":"并桥冰乍泮，隔岸柳初黄。\n河上春犹浅，天涯日渐长。\n平时好行乐，往事入思量。\n最恨三年别，应添两鬓霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56094,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"裴纶著作见期行日延宿所居既至而裴已行因书寄此","author":"张舜民","text":"都城人事日烹煎，跳出都门意已仙。\n摩诘旧闻空一室，祖生何事忽先鞭。\n尘埃马上同看月，絺绤风中共听蝉。\n我复西还君北去，箕山颍水自萧然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56095,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹘岭","author":"张舜民","text":"度险仍逢雪，艰危顷步中。\n鹘飞犹自苦，人足故难通。\n九折羊肠外，三休箭筈东。\n西南望天柱，聊复慰途穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56096,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题三水县舍左几著作","author":"张舜民","text":"还乡去日正迟迟，枉道相过慰所思。\n历国聘君良自苦，敝衣怀组欲谁欺。\n白杨叶上三更雨，黄菊风前一酒卮。\n莫道相逢是容易，与君头鬓各丝丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56097,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题木居士","author":"张舜民","text":"波穿火透本无奇，初见潮州刺史诗。\n当日老翁终不免，后来居士欲奚为。\n山中雷雨谁宜主，水底蛟龙睡不知。\n若使天年俱自遂，如今已复长孙枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56098,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题王侍禁壁","author":"张舜民","text":"怪底临江有竹篱，便将江水当为池。\n心随鸥鸟沈浮去，眼看风波起灭时。\n我有碇斋新作记，人传画舫旧题诗。\n君恩几许生归北，与我閒人把钓丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56099,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠邻居陈焕处士","author":"张舜民","text":"福唐陈处士，与我对门居。\n生死一炉药，尘埃数箧书。\n但知尊有酒，莫叹食无鱼。\n若论浮生事，浮生事总虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56100,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和赵大监雪一首","author":"张舜民","text":"腊雪称为瑞，初春又不同。\n月藏灯市底，云泛綵山中。\n洒面犹堪数，连宵势莫穷。\n催花萦小槛，引絮舞低空。\n三径从谁扫，千门倏自通。\n䙰褷消酒力，料峭却东风。\n阔壅平戎幕，孤撑访戴篷。\n岂期麟趾客，并舍虎门东。\n郢国歌难和，梁园赋易工。\n何人知帝力，鼓腹颂清衷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56101,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋日燕山道中","author":"张舜民","text":"燕山秋更好，况复值新晴。\n一径幽花闹，千岩晚瀑明。\n寺危迂路入，水漫信船行。\n尝栗皱初破，开梨颊未赪。\n松萝扶斗上，剑戟插沙平。\n秦赵封疆密，岷峨气象清。\n五龙丹桂尽，万马蹛林横。\n韫玉人时得，埋钱事可惊。\n画图传辋水，醉倒恋增城。\n为报南归客，应须自作程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56102,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乡人言","author":"张舜民","text":"郴江有奇石，似牛伏岸侧。\n乡人久相传，过者有颠覆。\n我与乡人谋，凿去可勿留。\n祗消一日力，得弭千岁忧。\n乡人顾我笑，官必有闇拙。\n大者不能图，小者安用说。\n方今民閒事，颇有急于石。\n当官贵居事，能不闲采拾。\n我家本多田，今乃身无居。\n虽有儿女辈，售人为婢奴。\n破家不足吝，所恨骨肉离。\n官今将骨肉，好去将何之。\n我虽有田里，亦闻官念此。\n念此不能为，何用居官尔。\n乃指江中石，此物如有神。\n不覆廉善士，独倾贪虐人。\n官今幸过此，行李都无害。\n将我言日思，勿为贫贱懈。\n我闻乡人言，背颡俱汗流。\n欲问破家因，恐为明者羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56103,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大雪行","author":"张舜民","text":"晓辞洛水滨，暮宿河之涘。\n四野漫漫不见人，竟日止能行数里。\n浑然天地为一色，渭水南北复何似。\n五陵鹰犬争合围，十宅管弦初热耳。\n连宵耿耿照鬓发，迎马点衣犹未已。\n但得来年春麦熟，暂困泥涂复何耻。\n农夫南亩未厌多，却入长安作泥滓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56104,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山阳二首 其二","author":"张舜民","text":"古人急于仕，每择分所安。\n愿为赵魏老，不作滕薛官。\n今人不量力，临老当繁难。\n少见咏淇澳，甚多歌伐檀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56105,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山阳二首 其一","author":"张舜民","text":"山阳水陆冲，乐饵人所赴。\n寂寞先生门，车轮不少驻。\n贤哉彼二公，绰有尚贤风。\n恨不生羽翼，啸歌尊酒中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56106,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山药","author":"张舜民","text":"人无本则忧，物以地为贵。\n如何山芋辈，天下称宋卫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56107,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"为圃","author":"张舜民","text":"前人厌膏粱，志欲服贱事。\n若论区别功，为圃亦不易。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56108,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书节孝先生事实于先生诗编之后","author":"张舜民","text":"古人往矣名空存，尔来冠带谁其伦。\n语言渊骞行盗蹠，俯仰不愧何缤缤。\n先生道义完且洁，去彼取此非今人。\n事亲岂但綵衣戏，刻木省定长悲辛。\n抛官却扫醉经史，胸中无复留纤尘。\n履穿袍敝突不墨，辞币与粟甘清贫。\n自从秀发到白首，造次于是非一晨。\n当知有昊悯浇散，先生故出拔斯民。\n嗟余禀赋虽不敏，管窥偶幸知所因。\n讲闻先生亦已久，云为辄以书诸绅。\n朅来广陵两阅岁，所得比旧又加亲。\n此编雅什盈数百，覃思成诵惊余神。\n恍如听乐周太庙，黄钟大吕皦且纯。\n又如典瑞出圭璧，璀璨溢目非玞珉。\n伟哉固足信万一，髣髴想见容彬彬。\n吾皇图治急遗逸，空谷相望推蒲轮。\n先生高卧焉得遂，细札匪日颁严闉。\n重惭缰锁脱无计，洒扫犹阻致此身。\n愿言师法不少懈，异日有立逃湮沦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56109,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五王庙","author":"张舜民","text":"清汴河边五君子，身遏横流同日死。\n火炎曾是及池鱼，世变安能顾妻子。\n百尺高城不足凭，日月所照惟孤诚。\n当其杀身际，肯念身后名。\n呜呼，伯夷既死孔子不复生，身后是非谁与评。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56110,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"天爵山","author":"张舜民","text":"耕者志于食，否则馁继之。\n学者志于道，一为好爵縻。\n本自不营利，间或与利期。\n朝日入而处，暮日仰而思。\n浮云蔽蔀屋，见前当自知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56111,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"木瓜 其一","author":"张舜民","text":"商州楚地户，宛在江汉偏。\n草木已渐包，果实尤可怜。\n木瓜大如拳，橙橘家家悬。\n隔崖有宿叶，黄紫凝霜烟。\n高秋万嶂出，一望通郧川。\n都邑虽僻陋，来者多名贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56112,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"长沙遇雪赠何待制二首 其二","author":"张舜民","text":"由来地气本无天，致感中和报有年。\n拂槛穿帘初学舞，萦风带雨不成团。\n清光并入书仙府，寒色偏留逐客船。\n老杜题诗曾有乞，漂零今昔路人怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56113,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"长沙遇雪赠何待制二首 其一","author":"张舜民","text":"初过湖南正惨悽，朔风边雪远相随。\n林欺橘柚看零落，岸拆蒹葭倚倒垂。\n可是辋川真入画，须教梁苑遍题诗。\n莫言北客都无有，且与湘人当土宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56114,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"长盘岭遇张复乡人","author":"张舜民","text":"马头已匝三千里，故国轻抛二十春。\n一片青山双鬓白，长盘岭下见乡人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56115,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]