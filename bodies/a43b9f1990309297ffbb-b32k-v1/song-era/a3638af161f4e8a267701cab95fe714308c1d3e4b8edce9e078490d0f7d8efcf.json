[{"title":"休日不出闻西池游人之盛","author":"张耒","text":"三日春风尘涨天，沟泥愁污破鞍鞯。\n扫门静闭无来客，隐几深居学坐禅。\n薄雨掠尘时点点，细蟾窥夜独娟娟。\n都人解与残春竞，半在西池听管弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51617,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"伤春","author":"张耒","text":"山城夜来雨，卧病惜残春。\n暗暗鸟啼树，飘飘花去人。\n地偏佳客断，官冷酒钱贫。\n乘兴还骑马，田家乐更真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51618,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"刘景文许惠毡裘未至督之","author":"张耒","text":"塞上寒羊剪毡毛，软于春絮腻于膏。\n齑盐倦客愁无褐，诗礼将军许赠袍。\n雅服何妨冠苏帽，瘦腰兼称束郿绦。\n想公封寄应多憾，不挂长身衬佩刀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51619,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同七兄及崧上人自坟庄还寺","author":"张耒","text":"和风快人意，岸帻晚襟凉。\n日落野痕碧，月生淮际光。\n论诗得灵运，静语属支郎。\n不是耽閒散，从来懒性长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51620,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同无咎遐叔文叔同游凝祥得游字","author":"张耒","text":"客子长安尘满裘，道人门馆自深幽。\n东风拂地千条柳，春水平池数点鸥。\n俯首一官真底事，倒囊三百更何求。\n读书挟策君知否，失性还同博塞游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51621,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同李十二醉饮王氏牡丹园二首 其二","author":"张耒","text":"吹尽纷纷桃李尘，天香国艳一翻新。\n正过谷雨初晴日，分得西都大半春。\n旧态似推新艳好，红芳不似淡妆真。\n嗟予久得丘园意，何日相逢一幅巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51622,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同李十二醉饮王氏牡丹园二首 其一","author":"张耒","text":"东风穷巷只埃尘，谁见城南万朵新。\n不问主人聊一饮，为携佳客送馀春。\n比君意气三年老，贷我疏狂一味真。\n醉里尚能驰马去，看君倒著接䍦巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51623,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同陈器之题迎福院轩","author":"张耒","text":"东风吹面酒楹樽，腊后一番梅柳新。\n残雪作寒山向晚，横烟不动野浮春。\n地留京洛豪华气，川带秦韩战伐尘。\n今古悠悠君莫问，祇应沉醉是天真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51624,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同周楚望饮华园","author":"张耒","text":"杖藜携手踏青苔，潇洒池亭为客开。\n柳色渐经秋雨暗，荷香时与好风来。\n斜阳似欲妆诗句，新月邀将入酒杯。\n身世已甘长寂寞，忘形赖有子徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51625,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同袁思正诸公登楚州东园楼","author":"张耒","text":"杖藜萧飒对云沙，白首逢春只叹嗟。\n身老易伤千里目，眼惊还见一年花。\n地平旷野连云直，天带清淮向海斜。\n尚有风光供醉笔，我生诗酒是生涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51626,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同戚郎夜饮","author":"张耒","text":"云物岁将暮，风烟晚自凄。\n更人初授宿，晚翼已归栖。\n美酒浅深酌，新诗取次题。\n亲交尽在眼，幸不费招携。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51627,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同器之游大宋陂值雨","author":"张耒","text":"微云护日晓阴阴，春去馀芳尚可寻。\n诗倚醉豪连卷写，酒逢勍敌百分斟。\n山光左右双屏画，雨脚峥嵘万羽林。\n沙路晚晴归马疾，一梳新月上烟岑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51628,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吕郡君挽词","author":"张耒","text":"表海东侯长，分吴异姓王。\n世家端作合，华裔远相望。\n龙去孤神剑，雏成九凤凰。\n多情潘散骑，悼逝足文章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51629,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寺西閒步","author":"张耒","text":"闾里静无事，野塘春水生。\n好风时独立，芳草共闲行。\n闰月迟春候，轻阴弄晚晴。\n邻炊烟火动，下舍晚鸡鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51630,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岁暮","author":"张耒","text":"岁暮无聊客，端居如坐禅。\n薄霜犹衣裌，多雨急收田。\n落日乌鸢集，晴林橘柚悬。\n已无轩冕念，岑寂度残年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51631,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岁暮书事十二首 其十二","author":"张耒","text":"云去暮天迥，雁飞寒夜长。\n姮娥守孤月，青女恨连霜。\n不寐看银烛，长吟送羽觞。\n山炉与石鼎，伴我老他乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51632,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岁暮书事十二首 其十一","author":"张耒","text":"日落擎明烛，一杯千里心。\n骄儿惊醉舞，山仆怪悲吟。\n谷冷水流急，天昏云起阴。\n三更何处雁，急急尚哀音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51633,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岁暮书事十二首 其十","author":"张耒","text":"陈叶不肯堕，冻醪凝未融。\n寒林晴有影，霜日冷无风。\n许国片心壮，劳生双鬓蓬。\n功名任愚智，万事古今同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51634,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岁暮书事十二首 其九","author":"张耒","text":"千载伤顽俗，遗风耿未忘。\n陈荒丘击鼓，魏褊女缝裳。\n远客防猜嫉，官居备寇攘。\n妻儿怪多喜，清洛有归艎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51635,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岁暮书事十二首 其八","author":"张耒","text":"自昔周人俗，贪庸巧治生。\n千金不冠带，一饮起纷争。\n佩犊攻攘敚，通书为姓名。\n二南分陕化，寂寞久无声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51636,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岁暮书事十二首 其七","author":"张耒","text":"壮心常许国，平日讨论兵。\n天地身将老，山河意欲惊。\n病多缘痛饮，吟苦更伤情。\n斗酒新丰市，何人问马生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51637,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岁暮书事十二首 其六","author":"张耒","text":"北风吹马疾，石径上危基。\n野俎饱貆脯，山炉煮橡糜。\n寒耕敲冻石，猎火上风枝。\n留滞亲麋鹿，多惭发欲丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51638,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岁暮书事十二首 其五","author":"张耒","text":"原庙依冈起，传闻世祖营。\n南阳无雊雉，熊耳合投兵。\n霜日蓬原路，天风柏殿声。\n山川英气在，不负昔闻名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51639,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岁暮书事十二首 其四","author":"张耒","text":"牛羊已归去，残照满山陂。\n霜雁田中静，风鸢木杪悲。\n川原今自若，龙虎昔交驰。\n丘陇耕桑尽，千年不复知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51640,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岁暮书事十二首 其二","author":"张耒","text":"清洛鱼梁浅，霜鳞素鲫肥。\n供厨调鼎快，充腹此羹稀。\n老去只便饱，年来甘息机。\n寒江鲈鲙美，怅望未成归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51641,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岁暮书事十二首 其一","author":"张耒","text":"岁晏北风疾，山空万谷号。\n木枯随意折，鸿断不成高。\n深屋支蓬户，温炉煖缊袍。\n老夫原不寐，鸣竹鼓萧骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51642,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岁暮书事十二首 其三","author":"张耒","text":"风捲尘沙白，云垂雪意凝。\n夜山时叫虎，晚市早收灯。\n园栗炮还美，村醪醉不能。\n三年官况味，真是冷于冰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51643,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岁暮福昌怀古四首 其一 谷州故城","author":"张耒","text":"原北荒城旧谷州，文皇功业莽悠悠。\n天戈挥去开东夏，金甲归来献二囚。\n想像英姿辉日月，苍茫故国委林丘。\n山川惨惨空回首，落日悲风蔓草秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51644,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岁暮福昌怀古四首 其二 张子房","author":"张耒","text":"谋臣何处不知名，谁与留侯敢抗衡。\n筹下兴亡分楚汉，幄中谈笑走韩彭。\n惧诛老将争枭首，高卧成功更养生。\n戡乱直须希世哲，乘时儿女漫纵横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51645,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岁暮福昌怀古四首 其三 李贺宅","author":"张耒","text":"少年词笔动时人，末俗文章久失真。\n独爱诗篇超物象，祇应山水与精神。\n清溪水拱荒凉宅，幽谷花开寂寞春。\n天上玉楼终恍惚，人间遗事已埃尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51646,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岁暮福昌怀古四首 其四 连昌宫","author":"张耒","text":"欲问兴亡已惨颜，桑田沧海变人间。\n无情野水青春在，不动南山白日閒。\n伐木清溪寒剥啄，鸣禽高柳晓缗蛮。\n蛾眉皓齿终黄土，谁道仙宫有使还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51647,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戏二潘","author":"张耒","text":"眊氉柯山客，还家只醉眠。\n桂堂浑忘却，蝉室故依然。\n未用临书卷，聊须办酒钱。\n所欣家有弟，乡校首称贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51648,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戏同小儿作望南京内门","author":"张耒","text":"别都制度拟王畿，双阙岧峣望太微。\n万乘旂常难望幸，九天楼观自相辉。\n百年龙虎兴王气，万雉金汤却敌威。\n一梦江南尚淹泊，风尘似欲变征衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51649,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"早春","author":"张耒","text":"辉辉暖日弄游丝，风软晴云缓缓飞。\n残雪暗随冰笋滴，新春偷向柳梢归。\n可怜鬓发蹉跎老，每惜梅花取次稀。\n何事都城轻薄子，买欢酤酒试春衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51650,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"早秋感怀","author":"张耒","text":"永日付悠悠，年华逝不留。\n风声送残暑，云色淡新秋。\n吾道倘有待，穷通宁遽忧。\n朝来望清颍，一雁下汀洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51651,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"早起观雨","author":"张耒","text":"雨叶风枝日夜长，东园秾密欲生光。\n可怜积雨过初暑，更转馀寒作晓凉。\n蚕事已成家媪喜，麦畦初泼老农忙。\n綵丝结缕催端午，又见黄头鼓楫郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51652,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"早起偶成","author":"张耒","text":"枕席清如水，萧然一老僧。\n鸡声消壁月，晓日失窗灯。\n山叶寒逾响，江云薄易凝。\n老僧曾教我，任运且腾腾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51653,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"早登望嵩楼望少室雪畏风不敢招客","author":"张耒","text":"临汝城中春雪消，望嵩楼上对岧峣。\n已披氛雾呈孤秀，未许春寒上泬寥。\n子晋玉笙如不隔，浮丘仙袂欲相招。\n便思唤客同清赏，苦畏春风入敝貂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51654,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵孔舍人曝书","author":"张耒","text":"图书陈秘奥，樽俎肆雍容。\n玉殿朝回客，蓬山深处峰。\n探囊图轴旧，题壁姓名重。\n盛世年年事，新篇莫厌供。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51655,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵王敏仲池上","author":"张耒","text":"春晚馀芳尚可寻，晴雷沙岸走车音。\n苑分广乐和声度，池受晴天倒影深。\n席上宫花辉御醴，坐中琼树间瑶林。\n归人自畏严城鼓，却望桥西日未沉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51656,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵王敏仲至西池会饮","author":"张耒","text":"圣朝无复用舟师，戏遣艨艟插戟枝。\n沸浪有声黄帽动，春风无力彩旗垂。\n不胜杯酌宁辞醉，传语风光共此嬉。\n远比永和真继轨，临摹茧纸看他时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51657,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵邠老见贻","author":"张耒","text":"已嗟肮脏倚门边，况复归来灶不烟。\n观国未书攀桂籍，还家却上过淮船。\n瑰奇难售真当尔，凿枘相遭亦偶然。\n未死此生谁料得，且将见在斗尊前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51658,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵张公远二首 其二","author":"张耒","text":"平淡春云捧额浮，秋光剑戟近人流。\n无肠可断方为憾，有药能治不是愁。\n可待挑琴知有术，未传驱豆更无谋。\n遥知添得春窗梦，尤在樽前烛下羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51659,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵张公远二首 其一","author":"张耒","text":"襄王坐上微词客，子建车前步水妃。\n瞥过低鬟流盼处，争先含笑独来时。\n东边日下终无雨，阙上书时合有碑。\n肠断吴王烟水国，扁舟何日逐鸱夷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51660,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵李晋裕教授九日见赠","author":"张耒","text":"满酌聊酬菊蕊黄，登高仍在太山阳。\n笑谈佳节宾朋集，诗酒清欢兴味长。\n倦客得閒聊欲饮，老人虽醉不成狂。\n先生莫叹齑盐久，行见高才颖出囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51661,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵李德载见寄","author":"张耒","text":"头颅幸获免奸锋，甘分江湖老钓篷。\n老得一州聊自慰，相望千里与谁同。\n已欣台省登群俊，犹数湖湘卧病翁。\n诗就醉馀频走笔，待观云海戏群鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51662,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵和王彦昭九日湖园会饮","author":"张耒","text":"故人怜寂寞，九日共登临。\n天地客行远，山河秋已深。\n狂来能醉舞，兴罢独悲吟。\n莫怪凄凉甚，多忧损壮心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51663,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵秦七寄道潜","author":"张耒","text":"衰疲久厌五更朝，每愧冥鸿在泬寥。\n顾我尘冠彫旧鬓，爱君山桂长新条。\n文词画虎工逾拙，世味春冰老益消。\n只欲归依香火社，高堂时听法音潮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51664,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵寄赵伯坚二首 其二","author":"张耒","text":"相思何处望，月阁对南堂。\n念子犹记我，怀君时举觞。\n可能思颍好，端是种花忙。\n閒说河阳政，佳哉副所望。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51665,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵寄赵伯坚二首 其一","author":"张耒","text":"西湖望中潬，能有几多程。\n问讯懒不讲，篇章来愈清。\n为邦循旧政，把酒忆交情。\n祝子过新岁，春风入帝城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51666,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵盛居中夜饮","author":"张耒","text":"吴衣厌拂洛阳尘，梦寐一樽淮海滨。\n每愿脱巾常漉酒，况逢投辖苦留宾。\n苍龙挂斗寒垂夜，翡翠浮花暖作春。\n上界高真足官府，追随却属散仙人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51667,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵黄汝器与君谟唱和三首 其三","author":"张耒","text":"爱君退易似前贤，投劾归来不待年。\n世故饱谙真昨梦，道心不系学虚船。\n莫悲白雪凋玄鬓，自有丹砂暖寸田。\n两郡诗筒屡传寄，主盟骚雅定谁先。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51668,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵黄汝器与君谟唱和三首 其二","author":"张耒","text":"吴门韦白旧推贤，文雅相望数百年。\n千里江山留醉墨，五湖风月纵归船。\n书来远慰连镮梦，岁熟归收种秫田。\n仕禄及亲身早退，高名荣事更谁先。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51669,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵黄汝器与君谟唱和三首 其一","author":"张耒","text":"饮量平吞叔度陂，宣城风月旧相知。\n雪霜欺客凋新鬓，珠玉投人出好诗。\n门对洞庭书满架，饮翻云梦酒盈卮。\n江城少驻还乡棹，一伴山翁醉习池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51670,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵斯举送岩桂新酿","author":"张耒","text":"丛桂仙君子，小山幽处芳。\n□□□鄙素，汉殿略涂黄。\n有客怜衰病，新醅许撇尝。\n并将尘外物，助我北窗凉。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51671,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江亭别故人","author":"张耒","text":"津亭把酒燕西东，无复馀花一点红。\n农事一春荒积雨，长淮千里驾东风。\n休谈世事循环外，且寄骚愁醉眼中。\n船鼓已鸣篙缆起，客行何事亦匆匆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51672,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"竹堂","author":"张耒","text":"谁道清贫守冷官，绕家十万翠琅玕。\n直应流水深相与，不待清风已自寒。\n学得凤鸣真自许，化成龙去不终蟠。\n知君何世无来者，可是王郎独与欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51673,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"老舅寓陈诸况不能尽布以二诗代书得閒为和佳也 其二","author":"张耒","text":"浮生已老付悠悠，未免饥寒目下忧。\n全仗黄庭能却老，那堪白发更悲秋。\n所欣耳界常清净，渐放心君得自由。\n垒块苦消消未尽，每逢风月亦閒愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51674,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"耒将之临淮旅泊泗上属病作迎候上官不敢求告比归尤剧疏拙无以自振但自悯叹耳","author":"张耒","text":"谋身不解免飘蓬，零落孤舟西复东。\n双鬓虽青应早白，病颜更醉不成红。\n崎岖避俗人难合，憔悴多愁疾易攻。\n莼菜碧鲈秋正美，步兵终欲向江东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51675,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自巴河至蕲阳口道中得二诗示仲达与秬同赋 其二","author":"张耒","text":"浩浩浑流卷白沙，中流鼓棹四无涯。\n喜逢山色开眉黛，愁对江云起炮车。\n雨足郊原丰稻菽，日斜鸥鹭满蒹葭。\n长年怕作扁舟客，赖有高谈一笑哗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51676,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自海至楚途次寄马全玉八首 其八","author":"张耒","text":"紫蟹双螯荐客盘，倾来不觉酒壶乾。\n雨多泽国蒲鱼美，秋至楚天风露寒。\n老去论交嗟我晚，尊前一笑忆君欢。\n红莲幕下无书檄，剩寄新诗满卷看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51677,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自海至楚途次寄马全玉八首 其七","author":"张耒","text":"二年海角寄东城，岁久移居亦有情。\n去路山川嗟我远，旧时风月为谁清。\n一廛受地今难继，三径怀归久欲耕。\n何日山林有茅屋，百年无复问功名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51678,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自海至楚途次寄马全玉八首 其六","author":"张耒","text":"萧萧晚雨向风斜，村远荒凉三四家。\n野色连云迷稼穑，秋声催晓起蒹葭。\n愁如夜月长随客，身似飞鸿不记家。\n极目相望何处是，海天无际落残霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51679,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自海至楚途次寄马全玉八首 其五","author":"张耒","text":"少年居士正安禅，法是怀公门下传。\n已解出尘金里矿，何妨离欲火中莲。\n苦心参道嗟予晚，极口随机恃子怜。\n若许维扬傍仁里，一廛须买许行田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51680,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自海至楚途次寄马全玉八首 其四","author":"张耒","text":"生涯飘泊一航轻，浩荡晴川送我行。\n北望山川连海远，南来风月近淮清。\n人家稻熟丰年满，泽国天高秋意生。\n惟有羁愁消不得，登临清泪落如倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51681,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]