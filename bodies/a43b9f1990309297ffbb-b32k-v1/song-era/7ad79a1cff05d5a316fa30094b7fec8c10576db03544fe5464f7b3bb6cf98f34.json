[{"title":"点绛唇 其六 别代净众","author":"向子諲","text":"荆棘林中，浪夸好手曾穿过。\n不起于坐。\n畐塞虚空我。\n问路台山，婆子随声和。\n还知么。\n石桥老个。\n些子平窥破。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36291,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"点绛唇 其八 别代栖隐","author":"向子諲","text":"脱落皮肤，故人南岳峰前过。\n只知闲坐。\n千圣难窥我。\n明月澄潭，谁唱复谁和。\n还知么。\n锦鳞没个。\n莫触清光破。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36292,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"点绛唇 其七 别代香严","author":"向子諲","text":"春浪桃花，禹门三尺平跳过。\n死生不坐。\n变化须归我。\n山起南云，白雨声相和。\n还知么。\n点点真个。\n块土何曾破。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36293,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"点绛唇 王景源使君宠示岩桂长短句，拟和一首 其十五","author":"向子諲","text":"春蕙秋兰，断崖空谷终难近。\n何如逸韵。\n十里香成阵。\n倾盖论交，白首情无尽。\n因君问。\n新声玉振。\n更觉花清润。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36294,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"点绛唇 其十一 重九戏用东坡先生韵","author":"向子諲","text":"无热池南，岁寒亭上开新宴。\n青山芳甸。\n尽入真如观。\n举酒高歌，人在秋天半。\n晴空远。\n寒江影乱。\n何处飞来雁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36295,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"点绛唇 南昌送范帅","author":"向子諲","text":"丹凤飞来，细传日下丝纶语。\n使君归去。\n已近沙堤路。\n风叶露花，秋意浓如许。\n江天暮。\n离歌轻举。\n愁满西山雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36296,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"点绛唇 其四 代栖隐昙老","author":"向子諲","text":"折脚铛中，二时粥饭随缘过。\n东行西坐。\n不识而今我。\n坏尽田园，终日且婆和。\n还知么。\n锥也无个。\n肘露衣衫破。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36297,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"点绛唇 其九 别自和","author":"向子諲","text":"绿水池塘，笑看野鸭双飞过。\n正当呆坐。\n纫鼻须还我。\n尽日张弓，许久无人和。\n还知么。\n难得全个。\n不免须明破。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36298,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"点绛唇 其三 代香严荣老","author":"向子諲","text":"不昧本来，太虚明月流辉过。\n令行独坐。\n高下都由我。\n玉轸无弦，谁对秋风和。\n还知么。\n老庞一个。\n识得机关破。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36299,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"点绛唇 世传水月观音词，徐师川恶其鄙俗，戏作一首似之 其一","author":"向子諲","text":"冰雪肌肤，靓妆喜作梅花面。\n寄情高远。\n不与凡尘染。\n玉立峰前，闲把经珠转。\n秋风便。\n雾收云卷。\n水月光中见。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36300,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"点绛唇 其十六 再赋示王景源使君","author":"向子諲","text":"璧月光辉，万山不隔蟾宫树。\n金风玉露。\n水国秋无数。\n老子情钟，欲向香中住。\n君王许。\n龙鸾飞舞。\n送到归休处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36301,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"相见欢 其三","author":"向子諲","text":"腰肢一缕纤长。\n是垂杨。\n泥泥风中衣袖、冷沈香。\n花如颊。\n眉如叶。\n语如簧。\n微笑微颦相恼、过回廊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36302,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"相见欢 其二","author":"向子諲","text":"桃源深闭春风。\n信难通。\n流水落花馀恨、几时穷。\n水无定。\n花有尽。\n会相逢。\n可是人生长在、别离中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36303,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"相见欢 其一","author":"向子諲","text":"亭亭秋水芙蓉。\n翠围中。\n又是一年风露、笑相逢。\n天机畔。\n云锦乱。\n思无穷。\n路隔银河犹解、嫁西风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36304,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桂殿秋","author":"向子諲","text":"秋色里，月明中。\n红旌翠节下蓬宫。\n蟠桃已结瑶池露，桂子初开玉殿风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36305,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其七 堂前岩桂犯雪开数枝，色如杏黄，适当老妻生朝，作此以侑觞","author":"向子諲","text":"瑞气氤氲拂水来。\n金幢玉节下瑶台。\n江梅岩桂一时开。\n不尽秋香凝燕寝，无边春色入尊罍。\n临风嗅蕊共裴回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36306,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其八","author":"向子諲","text":"守得梅开著意看。\n春风几醉玉栏干。\n去时犹自惜馀欢。\n雨后重来花扫地，叶间青子已团团。\n凭谁寄与蹙眉山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36307,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其五 政和壬辰正月豫章龟潭作，时徐师川、洪驹父、汪彦章携酒来作别","author":"向子諲","text":"璧月光中玉漏清。\n小梅疏影水边明。\n似梅人醉月西倾。\n梅欲黄时朝暮雨，月重圆处短长亭。\n旧愁新恨若为情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36308,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其七 政和癸巳仪真东园作","author":"向子諲","text":"花样风流柳样娇。\n雪中微步过溪桥。\n心期春色到梅梢。\n折得一枝归绿鬓，冰容玉艳不相饶。\n索人同去醉金蕉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36309,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其六 连年二月二日出都门","author":"向子諲","text":"人意天公则甚知。\n故教小雨作深悲。\n桃花浑似泪胭脂。\n理棹又从今日去，断肠还似去年时。\n经行处处是相思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36310,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其六 老妻生日","author":"向子諲","text":"星斗昭回自一天。\n疏梅池畔斗清妍。\n蟠桃正熟藕如船。\n叶上灵龟来瑞世，林间白鹤舞胎仙。\n春秋不记几千年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36311,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其五","author":"向子諲","text":"醉里惊从月窟来。\n睡馀如梦蕊宫回。\n碧云时度小崔嵬。\n疑是海山怜我老，不论时节遣花开。\n从今休数返魂梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36312,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙","author":"向子諲","text":"一夜凉飔动碧厨。\n晓庭飞雨溅真珠。\n玉人睡起倚金铺。\n云髻作堆初未整，柳腰如醉不胜扶。\n天仙风调世间无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36313,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其二 赵总怜以扇头来乞词，戏有此赠。赵能著棋、写字、分茶、弹琴","author":"向子諲","text":"艳赵倾燕花里仙。\n乌丝阑写永和年。\n有时闲弄醒心弦。\n茗碗分云微醉后，纹楸斜倚髻鬟偏。\n风流模样总堪怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36314,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其三 王称心效颦，亦有是请，再用前韵赠之","author":"向子諲","text":"曾是襄王梦里仙。\n娇痴恰恰破瓜年。\n芳心已解品朱弦。\n浅浅笑时双靥媚，盈盈立处绿云偏。\n称人心是尽人怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36315,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其一 宝林山间见兰","author":"向子諲","text":"绿玉丛中紫玉条。\n幽花疏淡更香饶。\n不将朱粉污高标。\n空谷佳人宜结伴，贵游公子不能招。\n小窗相对诵离骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36316,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其二 渔父词，张志和之兄松龄所作也，有招玄真子归隐之意。居士为姑苏郡守，浩然有归志，因广其声为浣溪沙，示姑苏诸友","author":"向子諲","text":"乐在烟波钓是闲。\n草堂松桂已胜攀。\n梢梢新月几回弯。\n一碧太湖三万顷，屹然相对洞庭山。\n狂风浪起且须还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36317,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其十三 许南叔席上","author":"向子諲","text":"百斛明珠得翠娥。\n风流彻骨更能歌。\n碧云留住劝金荷。\n取醉归来因一笑，恼人深处是横波。\n酒醒情味却知么。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36318,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其八 和曾吉甫韵呈宋景晋待制。宋有二小姬，小桃、小兰","author":"向子諲","text":"绿绕红围宋玉墙。\n幽兰林下正芬芳。\n桃花气暖玉生香。\n谁道广平心似铁，艳妆高韵两难忘。\n苏州老矣不能狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36319,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其九 再用前韵寄曾吉甫运使","author":"向子諲","text":"霭霭停云覆短墙。\n夭夭临水自然芳。\n猗猗无处着清香。\n珍重蓦山溪句好，尊前频举不相忘。\n濠梁梦蝶尽春狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36320,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙","author":"向子諲","text":"爆竹声中一岁除。\n东风送暖入屠苏。\n瞳瞳晓色上林庐。\n老去怕看新历日，退归拟学旧桃符。\n青春不染白髭须。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36321,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其一 简王景源、元渤伯仲","author":"向子諲","text":"南国风烟深更深。\n清江相接是庐陵。\n甘棠两地绿成阴。\n九日黄花兄弟会，中秋明月故人心。\n悲欢离合古犹今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36322,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其十二","author":"向子諲","text":"云外遥山是翠眉。\n风前杨柳入腰肢。\n凌波微步袜尘飞。\n倚醉传歌留客处，佯嗔不语殢人时。\n风流态度百般宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36323,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其十一 绍兴辛未中秋，王景源使君乘流下萧滩，舍舟从陆。芗林老人以长短句赠行","author":"向子諲","text":"樽俎风流意气倾。\n一杯相属忍催行。\n离歌更作断肠声。\n衮衮大江前后浪，娟娟明月短长亭。\n水程山驿总关情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.