[{"title":"挽赵秋晓","author":"胡骏升","text":"父子同年录，云霄步武高。\n功名方梦蚁，宇宙适交鳌。\n岩壑淮南隐，诗文太白豪。\n九泉不可作，几些续离骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41812,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"卜居","author":"胡宿","text":"自致青云有壮图，且寻詹尹卜幽居。\n一杯谁置元王醴，三尺休弹上客鱼。\n足下已穿东郭履，胸中犹郁茂陵书。\n汉皇夜御金銮殿，岂便无人荐子虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41813,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"长卿","author":"胡宿","text":"买赋金钱出后宫，长卿文采冠诸公。\n梁园末至时名大，蜀道前驱使节雄。\n已托焦桐传密意，更因残札寄遗忠。\n如何一讽神仙事，却得飘云起赋中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41814,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"兵部尚书赠司空侍中晏元献公挽词三首 其三","author":"胡宿","text":"储极元寮宠，公貂盛策班。\n宁神依大騩，结冢近陉山。\n鼓吹春风里，麒麟夕照间。\n寄言川上水，何事不西还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41815,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"兵部尚书赠司空侍中晏元献公挽词三首 其二","author":"胡宿","text":"川岳沦精气，风华丧杰才。\n典刑留大雅，文象坼中台。\n聚窟香难破，钧天梦不回。\n只应之帝所，鸣玉侍丹台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41816,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"兵部尚书赠司空侍中晏元献公挽词三首 其一","author":"胡宿","text":"俊老三阶后，高华四纪中。\n朝廷用文治，廊庙得才雄。\n鸡树前阴改，鳣庭旧迹空。\n生存华屋处，零落恨无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41817,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别墅园池","author":"胡宿","text":"小池连曲圃，幽可涤烦襟。\n露菊凝秋艳，风荷结晚阴。\n碧芦巢鸟重，青藻宅鱼深。\n自是轮蹄外，嚣尘岂易侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41818,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"沧浪亭","author":"胡宿","text":"窜逐本无罪，羁穷向此忘。\n野烟含怅望，落日满沧浪。\n乱草荒来绿，幽兰死亦香。\n楚魂招不得，秋色似潇湘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41819,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"采莲女","author":"胡宿","text":"碧盖缃葩映素秋，此中兰棹好销忧。\n相将共挈青丝笼，一笑同回翠羽舟。\n日暮鸣榔随下濑，夜深归棹怯中流。\n东方自有罗敷婿，不顾江边越鄂州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41820,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"城东别墅寄怀天锡","author":"胡宿","text":"几日归心托暮云，半毡窗下久生尘。\n水天雨气霏霏断，竹阁山花点点新。\n小苑莺声偏破梦，大堤花艳欲迷人。\n岂无躞蹀青丝骑，不敢偷看城里春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41821,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晨入都省闻子奇内翰宿太常因寄口号","author":"胡宿","text":"相思禁林客，知奉太常斋。\n月落桐依井，风休絮满阶。\n欢娱疏胜集，申写寄长怀。\n遥望墙东隐，朋簪杳未谐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41822,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晨起马上口占","author":"胡宿","text":"马过津桥外，城临金斗傍。\n早霜浓著瓦，落月半衔墙。\n暗水澄寒底，初霞漏晓光。\n疏钟林下寺，烟景正苍凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41823,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"朝罢","author":"胡宿","text":"朝罢通中一觉眠，右银台路入西垣。\n日长易觉芝泥熟，风软频惊药树翻。\n朱槛带阴难可倚，紫薇当昼不胜繁。\n何须更寄陶窗傲，自有馀凉在此轩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41824,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"嘲蝶","author":"胡宿","text":"三春流寓寄花房，雌去雄飞过短墙。\n双翅薄匀何晏粉，一身偷带贾充香。\n风多苑后飞无数，日暖池边舞更狂。\n却为有情人爱惜，六宫皆作绣衣裳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41825,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"边思","author":"胡宿","text":"劲气初折胶，奔书闻插羽。\n寒金刁斗鸣，夕火兜零举。\n霜威画角雄，月思清笳苦。\n骠骑出鏖兵，轻车前确虏。\n一鼓系名王，三捷献英主。\n天山挂雕弓，玉塞休强弩。\n龙额近封侯，华堂盛歌舞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41826,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"池台","author":"胡宿","text":"层台迟夕娟，清池弄秋水。\n蟾明桂树间，鱼跃莲叶底。\n如何惠庄津，乃在蒲城里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41827,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陈生游金山兼简世昌师","author":"胡宿","text":"宝势岚光秀，浓春物景鲜。\n飞峰凌巨浸，精构起中天。\n鸟畏云涛险，僧安石室禅。\n贯花应作偈，望月定陈篇。\n不为青霄桂，同裁白社莲。\n羡君飘鹄舫，独自号神仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41828,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"碧楼","author":"胡宿","text":"中条何峨峨，映我缥碧瓦。\n汾水望飞云，参旂眺绿野。\n美哉山与河，河流疾于马。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41829,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"又和松碧轩三绝 其三","author":"胡寅","text":"新陂剩水沃良苗，想见当时相杵谣。\n尚有荒馀须快犊，何须塌具更悬腰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41830,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"又和松碧轩三绝 其一","author":"胡寅","text":"欣此幽居惜未深，时搴芳秀浣尘襟。\n栋梁自是君材器，铁石空馀我寸心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41831,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"又题草衣岩","author":"胡寅","text":"携手童乌三尺强，已知经术胜文章。\n可怜不见凌云日，迸洒西风泪几行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41832,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三月晦和唐人韵诗云三月正当三十日风光别我苦吟身共君今夜不须寐未到五更犹是春","author":"胡寅","text":"一气冲融转大钧，四时舒卷见全身。\n若云春向晨钟断，须信诗人未识春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41833,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"归次义彬老人廖康吉惠灵寿杖以二十八字谢之","author":"胡寅","text":"绿鬓投荒白发归，瘴馀浑欲不胜衣。\n烦将扶老殷勤赠，未怕登高足力微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41834,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题四画 石峰春霭","author":"胡寅","text":"腾龙纷野马，非雾亦非烟。\n心共春山远，诗凭淡墨传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41835,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"示黄冈长老二绝 其二","author":"胡寅","text":"落日溪桥伫立时，溪云归尽月生迟。\n溪声漏泄真消息，借问溪翁却不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41836,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再和 其三","author":"胡寅","text":"今年花是去年梅，又对春风一笑开。\n不似飞霙能顷刻，香中更有和羹才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41837,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再和 其五","author":"胡寅","text":"猛将谋臣气霭云，兴邦雪耻在奇勋。\n因思卫国琼瑶报，更忆吴人组练军。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41838,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再和 其二","author":"胡寅","text":"迥眺层台酒屡携，千峰攒玉映瑶溪。\n南枝更有东风面，未减争妍灿瓠犀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41839,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再和 其六","author":"胡寅","text":"剑峰犀利拙优伶，果听淮南奏凯声。\n阴翳便随朝雪尽，东风还放晓光清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41840,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再和 其一","author":"胡寅","text":"纷纷狼籍下天风，万里寒光镜色空。\n莫学袁安但高卧，也须斗酒醉新丰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41841,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再和 其四","author":"胡寅","text":"埋玉腰间觅性宗，儒冠谋道有谁同。\n笔尖冻折新诗就，但可徒收翰墨功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41842,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再和 其七","author":"胡寅","text":"自笑兵厨吏不虔，冻醅如蜜只年年。\n却思踏雪江头路，屡费诗人一斗钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41843,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再游岳麓示法光其邻道林人言陶士衡旧居也五绝 其五","author":"胡寅","text":"草堂何日傍云根，借问邻家两足尊。\n欲买渔舟系江树，先凭屐齿记苔痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41844,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再游岳麓示法光其邻道林人言陶士衡旧居也五绝 其四","author":"胡寅","text":"旧诗不省作何言，新句无奇墨乱翻。\n要是云山通宿契，故将文字寄深论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41845,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再游岳麓示法光其邻道林人言陶士衡旧居也五绝 其一","author":"胡寅","text":"雄城千雉压江横，倒影蛟龙十里明。\n欲倚危栏舒远眺，东风无力暮云平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41846,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同邢子晋范伯达游方广二绝 其一","author":"胡寅","text":"黄梅作雨暗朝曛，山北山南路不分。\n知我与君非俗驾，晓天收尽五峰云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poe