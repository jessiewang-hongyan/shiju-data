[{"title":"送悟侍者参育王偃溪和尚","author":"释绍昙","text":"茂阴深处击寒冰，洗得娘生两耳清。\n塞断不听呼小玉，顺风来听偃溪声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14958,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送悦兄归篆江省母","author":"释绍昙","text":"万叠秾阴衬落花，一江流水篆纹斜。\n娘生面目无遮护，见得分明始到家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14959,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送载上人往天童更依","author":"释绍昙","text":"教眼年深似拍盲，金篦刮了膜重生。\n说天童有翳睛药，妙手轻轻点即明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14960,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送绵袄与东冈","author":"释绍昙","text":"罗纹结角见踪由，翻著从教刺眼休。\n线路放开绵密密，瞿昙踢出脚尖头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14961,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送雪窦圆兄归疏山","author":"释绍昙","text":"锦镜浓妆蜀样花，没尘埃处惹尘埃。\n好归说与曹家女，已是当堂打破来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14962,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送舜侍者见万寿退耕和尚","author":"释绍昙","text":"湖山深处侍巾瓶，错认频呼小玉声。\n急掩耳待寻活路，司南车在阖闾城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14963,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送椿兄之蒋山","author":"释绍昙","text":"老倒凌霄彻骨穷，强书白契卖虚空。\n要将刀尺分长短，须向钟山问宝公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14964,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送鉴禅人自天童之江心","author":"释绍昙","text":"东谷生涯彻骨贫，烦君说与了师兄。\n一从凤宿龙巢后，宝殿无人步月明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14965,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送僧归岳麓印传灯","author":"释绍昙","text":"袖舞秋风尾瘦藤，南归岳麓看传灯。\n先寻古殿经行处，唤醒当年吃攧僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14966,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送僧参太白痴绝和尚并石溪和尚挂牌","author":"释绍昙","text":"前宝公兮后宝公，分身说法在玲珑。\n参寻不用论宾主，十二面门元一同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14967,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送辩兄归松江","author":"释绍昙","text":"听清猿罢啼烟霞，声色纯真未到家。\n一曲吴歌归棹稳，松江雪点白蘋花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14968,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送镜兄之虎丘","author":"释绍昙","text":"虎岩老虎太威狞，平地拿人死复生。\n背却西风行一转，髭须倒捋两三茎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14969,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻竺寺迎号服因成口号 其一","author":"释绍昙","text":"丝管纷纷鼓乱挝，两山迎接赐衣来。\n白云恐污山翁耳，重锁柴门不放开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14970,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻竺寺迎号服因成口号 其二","author":"释绍昙","text":"祖庭秋晚日增悲，见得芙蓉便展眉。\n不与狂花争琐细，淄川缘有拒霜枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14971,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"冢间","author":"释绍昙","text":"湖山倒影水吞空，鸥鹭忘机万境融。\n不用深深埋暗箭，活人全在死人中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14972,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"哭栅石壁","author":"释绍昙","text":"心镜交光十四年，谁知失照髑髅前。\n春风梦绕福城路，忍听乱啼花坞鹃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14973,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"涌泉阁","author":"释绍昙","text":"肆无碍辩若悬河，尺水能兴万丈波。\n平地无端立层级，登高人少逐流多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14974,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"烧笋","author":"释绍昙","text":"稚子相呼脱锦衣，饷春不减首山薇。\n翻身跳入炉中浴，透得山僧啮镞机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14975,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"爱山","author":"释绍昙","text":"酷将嗜好片闲心，散作千岩万壑春。\n拚得一生看不足，险崖句里要翻身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14976,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"破衲","author":"释绍昙","text":"通身百杂碎，谁解成褫得。\n鸡足紧收藏，当来问弥勒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14977,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蚬子和尚赞","author":"释绍昙","text":"除了捞波一窖无，逢人谩说走江湖。\n虾针取你性捞摝，不到得拿龙颔珠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14978,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十五首 其五十五","author":"释绍昙","text":"不依本分去担柴，负石黄梅验作家。\n半夜三更设分晓，和糠舂出古菱花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14979,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十五首 其五十四","author":"释绍昙","text":"身后身前不丈夫，钁头边事想含糊。\n不知费几苍松机，换得渠侬破钵盂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14980,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十五首 其五十二","author":"释绍昙","text":"通身红烂业非轻，血染千山草木腥。\n一阵西风捲黄叶，月华如水满空庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14981,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十五首 其五十一","author":"释绍昙","text":"平白将身入草窠，折娘生臂冻驴腰。\n一年一度嵩山雪，雪有消时恨不消。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14982,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十五首 其五十","author":"释绍昙","text":"竺乾窃得屠龙技，袖隐神锋入海南。\n弄巧不消人一笑，九年面壁好羞惭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14983,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十五首 其四十八","author":"释绍昙","text":"十年不作觚棱梦，一旦来从帝苑游。\n召对金鸾酬一问，布衣脱下便封侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14984,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十五首 其四十七","author":"释绍昙","text":"拍板门槌伎俩穷，人前偏要辱宗风。\n驴鸣狗吠成狼籍，瞒得梁王屈宝公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14985,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十五首 其四十六","author":"释绍昙","text":"道冠儒履佛袈裟，弄鬼精魂却有些。\n多谢宝公勤照拂，双梼枯尽再生花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14986,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十五首 其四十五","author":"释绍昙","text":"九十芳春日，游蜂竞采花。\n花归蜜房尽，残叶落谁家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14987,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十五首 其四十四","author":"释绍昙","text":"绿萝窗底枕肱时，梦绕华胥客路迷。\n听得烟村一声笛，醒来元是住居西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14988,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十五首 其四十三","author":"释绍昙","text":"霜风括地扫枯荄，谁觉东君令已回。\n唯有岭梅曾漏泄，一枝先向雪中开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14989,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十五首 其四十二","author":"释绍昙","text":"笼养翎毛不记名，春来巧弄百般声。\n临风放出丹山凤，多谢箫韶奏九成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14990,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十五首 其四十一","author":"释绍昙","text":"飞骑将军入虏庭，鎗旗未动死生分。\n战酣驰入中军寨，且听元戎议赏勋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14991,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十五首 其三十九","author":"释绍昙","text":"剪酥蹙锦上林花，晓怯春寒不放开。\n蓦听一声挝羯鼓，檀心远送异香来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14992,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十五首 其三十八","author":"释绍昙","text":"幼小勤书懒出门，春风花柳自村村。\n芳心不被笙歌引，时把唐虞子细论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14993,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十五首 其三十七","author":"释绍昙","text":"荒废人家命蹇迍，行年在坎鬼临身。\n烧钱远送他方去，转祸来为五福神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14994,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十五首 其三十六","author":"释绍昙","text":"爝火初经一线开，宝盘终日自萦回。\n也知物理关人事，历尽崎岖心始灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14995,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十五首 其三十五","author":"释绍昙","text":"飏下山藤设意深，嗅乌喙药祸沾身。\n脚跟未断红丝线，智鉴难逃明眼人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14996,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十五首 其三十四","author":"释绍昙","text":"八面玲珑逗月寒，要寻形影十分难。\n无端平地生层级，湘北潭南作样看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14997,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十五首 其三十三","author":"释绍昙","text":"十字街头铺席开，牛溲马勃尽收来。\n等闲落在名医手，贵贱无非是药材。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14998,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十五首 其三十二","author":"释绍昙","text":"吃粥吃饭过，听风听雨眠。\n风光俱买尽，不费一文钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14999,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十五首 其三十一","author":"释绍昙","text":"浊酒松醪吃两钟，醉拖长袖舞春风。\n天崩地裂谁能管，几见落花堆乱红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15000,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十五首 其三十","author":"释绍昙","text":"霜拂金鞍玉坠腰，鸡声催入紫宸朝。\n何如云壑饱清梦，残月半窗松影摇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15001,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十五首 其二十九","author":"释绍昙","text":"白发宫娃不解愁，满头犹自插花枝。\n曾缘玉儿君王宠，准拟人看似旧时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15002,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十五首 其二十八","author":"释绍昙","text":"村落谁家丑女儿，爱将苕帚画蛾眉。\n逢人掩鼻嫌腥秽，鸦臭当风自不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15003,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十五首 其二十六","author":"释绍昙","text":"赤穷王老卖浑身，贱似黄金贵似尘。\n不费分文收买得，一程送与采樵人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15004,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十五首 其二十五","author":"释绍昙","text":"胡饼朝朝供一僧，知他结了几生冤。\n甜瓜换得胡卢种，才出头来便灭门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15005,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十五首 其二十四","author":"释绍昙","text":"柳挂金丝莺织晓，花铺翠锦蝶眠春。\n见成一幅新图画，不待王维手眼亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15006,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十五首 其二十二","author":"释绍昙","text":"飞骑将军入虏庭，兵机炼得十分精。\n谁知败绩缘欺敌，致使凌烟易姓名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15007,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十五首 其二十","author":"释绍昙","text":"学得陶朱小术些，当场撮弄数般花。\n虽然过得常人眼，到底难瞒是作家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15008,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十五首 其十九","author":"释绍昙","text":"破镜生儿惜似金，晨昏不敢离烟林。\n羽毛长就飞求食，聚口纷争吃母心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15009,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十五首 其十八","author":"释绍昙","text":"鼻孔亲遭扭捏来，乞儿得食向人誇。\n雄峰独坐称奇特，断绠何曾是活蛇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15010,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十五首 其十七","author":"释绍昙","text":"闪电光中夺信旗，怒雷一击丧全机。\n从兹独据雄峰顶，佛祖低头听指挥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15011,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十五首 其十六","author":"释绍昙","text":"脱体无依是病由，直须大死一回休。\n西江吸尽无涓滴，便解人前不识羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15012,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十五首 其十五","author":"释绍昙","text":"送目群飞野鸭边，不胜情事与谁论。\n轻轻扭定娘生鼻，海月山云亦断魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15013,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十五首 其十四","author":"释绍昙","text":"南阳家法是人知，刚被丹霞教坏伊。\n致使亲生龙凤子，一时翻作鼠黏儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15014,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十五首 其十三","author":"释绍昙","text":"仙翁还旆武陵家，仙女欢迎步彩霞。\n贪弄玉箫频劝酒，不知凋尽碧桃花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15015,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十五首 其十二","author":"释绍昙","text":"苦恋京华不肯归，行装须待送穷时。\n茆船寂寞烟汀月，别后何人更有诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15016,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十五首 其十一","author":"释绍昙","text":"拟学鹏抟九万风，谁知折翅鸟窠中。\n至今秦望山前雨，血泪千林花泪红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15017,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十五首 其十","author":"释绍昙","text":"黄金肌骨铁心肠，晓出重城眩巧妆。\n赚入涅槃门路去，连天荒草看人忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15018,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十五首 其九","author":"释绍昙","text":"碧绿青红百样花，尽从春色巧安排。\n不知春色端倪处，平地危分万仞崖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15019,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十五首 其八","author":"释绍昙","text":"拂苔高卧白云根，梦绕春风锦绣园。\n蓦听采樵歌一曲，醒来月挂客愁村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15020,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十五首 其七","author":"释绍昙","text":"美如西子离金阙，娇似杨妃倚玉楼。\n犹把琵琶半遮面，不令人见转风流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15021,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十五首 其六","author":"释绍昙","text":"落赖儿郎自小愚，为贪花酒废诗书。\n当时早得严师训，破坏箕裘未到渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15022,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十五首 其五","author":"释绍昙","text":"势罢奴欺主，年衰鬼弄人。\n南泉招致得，冷泪湿衣巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15023,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十五首 其四","author":"释绍昙","text":"一块郴州铁，浑崙擘不开。\n轮槌轻击著，雪刃暗飞来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15024,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十五首 其三","author":"释绍昙","text":"收拾成都卖卜家，君平术肆独宏开。\n闹中人献支机石，掀倒卦盘归去来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15025,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十五首 其二","author":"释绍昙","text":"田库翁翁两鬓霜，苦贪浊酒弄觥觞。\n儿孙步步相随逐，扶得归家又发狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15026,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十五首 其一","author":"释绍昙","text":"古洞桃花发嫩枝，施朱施粉两相宜。\n要渠成结千年实，多谢春风著意吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15027,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"假庵","author":"释绍昙","text":"穿凿虚空幻架成，从来共住不知名。\n笑他借位明功底，错认檐头雨滴声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15028,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其一一六","author":"释绍昙","text":"六年偿债芝峰寺，费尽衣盂用尽心。\n今日杖藜行活路，笑看花木媚清阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15029,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其一一四","author":"释绍昙","text":"大地全荒总不忧，夺饥人食缚耕牛。\n衲僧举止合如是，百炼精金肯博鍮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15030,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其一○一","author":"释绍昙","text":"九旬禁足已嫌多，那更重加一月遥。\n不解六根门互用，蜡人铁做也应消。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15031,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其九十四","author":"释绍昙","text":"客路奔驰岁月深，朝游东鲁暮西秦。\n子规苦劝人归去，血溅岩花几见春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15032,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其八十九","author":"释绍昙","text":"茶迎过客无新旧，秤定须弥有重轻。\n活弄手头虽得妙，何如闻爆桶箍声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15033,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其八十四","author":"释绍昙","text":"绣閤新添一线长，金针斗巧制鸳鸯。\n不知这个长多少，莫把龟毛乱较量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15034,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其七十八","author":"释绍昙","text":"十二峰前傀儡棚，尽由行主线抽牵。\n编排科段无新旧，歌舞秋风乐管筵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15035,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]