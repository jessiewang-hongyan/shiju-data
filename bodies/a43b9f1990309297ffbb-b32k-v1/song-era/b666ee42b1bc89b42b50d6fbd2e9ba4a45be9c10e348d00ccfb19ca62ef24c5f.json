[{"title":"早起","author":"周文璞","text":"佛香才了换儒巾，身是人间自在身。\n一路野花清养目，半沟流水静怡神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23977,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"曲坊","author":"周文璞","text":"曲坊才尽上湖船，笑问云山欠酒钱。\n两行柳丝黄不断，不知身在御园边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23978,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江南曲四首 其二","author":"周文璞","text":"郎与新欢浓，侬与旧欢熟。\n懊恼对行人，当为歌艳曲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23979,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"至荆公墓 其四","author":"周文璞","text":"守法曾丞相，能文陆左丞。\n风流如未泯，应作寺中僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23980,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"至荆公墓 其二","author":"周文璞","text":"野老从余话，文公在半山。\n蹇驴追不及，落日寺深关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23981,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"至荆公墓 其三","author":"周文璞","text":"年少坐谈玄，钟山直北边。\n春风吹梦过，泪浥旧貂蝉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23982,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"至荆公墓 其一","author":"周文璞","text":"一丈荒坟上，悠悠落日斜。\n子孙来祭后，守墓扫松花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23983,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西湖小隐","author":"周文璞","text":"先帝何曾宠倖臣，家园籍没几经春。\n一丘赐与婵娟魄，教主西湖似洛神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23984,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西湖即事","author":"周文璞","text":"闲看浮鸠栖曲渚，倦随奔鹿上荒陵。\n松门雨过长廊静，一架藤花供病僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23985,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"访梅二首 其二","author":"周文璞","text":"幽花堕在石根傍，几欲移将近草堂。\n草草一尊聊尔尔，跨驴归去月荒凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23986,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"访梅二首 其一","author":"周文璞","text":"起看重雾白漫漫，略见春风在树间。\n傍水出篱犹未快，淡烟微雨又青山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23987,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"阴山","author":"周文璞","text":"阴山祠下月如霜，不为吟猿断杀肠。\n折得橙花无处赏，带枝分与棹船郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23988,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即事二首 其二","author":"周文璞","text":"龙护朝元阁，鹤栖封禅台。\n中原垂白叟，只望羽书来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23989,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即事二首 其一","author":"周文璞","text":"乐使金花鼓，蛮衣紫锦鞍。\n蕃官船过界，驿吏报平安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23990,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"听琴","author":"周文璞","text":"向人犹抱舜文弦，可煞书生不值钱。\n弹出履霜空作恶，一林风露已鸣蝉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23991,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寿星寺闻子规二首 其二","author":"周文璞","text":"莫向空山恼病僧，暮云台殿异乡人。\n多时不识巴江路，守著浓花哭过春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23992,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寿星寺闻子规二首 其一","author":"周文璞","text":"子规欲归归未得，啼向钱王寿星石。\n月明血尽人不知，只怪晓山深似碧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23993,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戒坛","author":"周文璞","text":"相君孙女小乘僧，身入祇园佛律行。\n三级戒坛秋色冷，个中蝼蚁亦长生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23994,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杜鹃花","author":"周文璞","text":"云树重重和泪吟，故宫遗庙有知音。\n秦吴万里皆芳草，染到山花恨最深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23995,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"孤山桃花二首 其二","author":"周文璞","text":"莫向蓬蒿恨不遭，梦魂曾钓海山鳌。\n当时不合轻仙事，惆怅灵风满碧桃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23996,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"孤山桃花二首 其一","author":"周文璞","text":"天上仙人休掷火，尘中道士莫烧香。\n可怜绛雪浑无赖，一簇千枝对草堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23997,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"法宝寺","author":"周文璞","text":"细竹千竿殿影斜，龙颜曾此著袈裟。\n寺楼杳杳钟声度，疑有宫娥出晚花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23998,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"金陵怀古六首 其六","author":"周文璞","text":"江水无情碧草春，北朝留住老词臣。\n子规啼向青枫树，为尔离乡去园人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23999,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"金陵怀古六首 其五","author":"周文璞","text":"琵琶未尽使人嗟，泪洒华林御苑花。\n今日闻韶无处所，雁烟蛩雨属他家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24000,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"金陵怀古六首 其四","author":"周文璞","text":"杳杳旧踪寻不得，茫茫遗恨有谁穷。\n长安败绩谁怜汝，灞上收声未到公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24001,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"金陵怀古六首 其三","author":"周文璞","text":"愁看幕府夕阳边，那更鸡笼在目前。\n跋扈飞扬只如此，登临那得不酸然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24002,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"金陵怀古六首 其二","author":"周文璞","text":"司马家儿持酒杯，天星亦下浇崔嵬。\n当时若便效牛饮，定有孟津师旅来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24003,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"金陵怀古六首 其一","author":"周文璞","text":"孙伯陵头水最悲，蒋侯庙下月来迟。\n夜深行客心惊恐，猿挂晋朝枫树枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24004,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"客中","author":"周文璞","text":"客中时序又匆匆，孤坐初春小雨中。\n弄水攀松去年事，令人忆杀洞霄宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24005,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宫人斜","author":"周文璞","text":"魂魄凄凉掩暮尘，野花山叶自精神。\n年年中使头边过，暗里相看似路人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24006,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绝句二首 其二","author":"周文璞","text":"入春便与僧为友，紫萼黄英见坐禅。\n昨日邻翁催入社，谢他只是说无钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24007,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绝句二首 其一","author":"周文璞","text":"皋伯通家琐夕晖，八年寒食数归期。\n江乡橘柚花如雪，不许离人戴一枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24008,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绝句四首 其四","author":"周文璞","text":"隔林八十厖眉叟，理竹疏泉过一生。\n见说石林身健日，把书只在石中行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24009,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绝句四首 其三","author":"周文璞","text":"解呼威羽归丹穴，可缚单于献汉宫。\n四面八方笼不住，许来分坐此山中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24010,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绝句四首 其二","author":"周文璞","text":"纱笼解散坐门畿，生怕逢人索接篱。\n朝雨洒来山更净，舂锄恰好到方池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24011,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绝句四首 其一","author":"周文璞","text":"巾车初扣槿花篱，物物来前总要诗。\n一句坐来模写了，雨鸠飞下老梅枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24012,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送人之武夷二首 其二","author":"周文璞","text":"终向名山度此生，此生吟骨要猿擎。\n洞宫终与人间别，六六峰高削紫琼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24013,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送人之武夷二首 其一","author":"周文璞","text":"精舍人归入内台，遗基处处有芳埃。\n小儒更合修壶史，刊落乾鱼说水苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24014,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送人之金陵","author":"周文璞","text":"江山不逐寒潮晚，陵墓犹含古木春。\n君入台城须访问，个中定有六朝人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24015,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送人之桐柏","author":"周文璞","text":"半溪松黄堆碧波，狂夫于此欲如何。\n洞天春晚归不得，司马悔桥芳草多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24016,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送人归苕溪","author":"周文璞","text":"愤王祠庙桃花下，愁苦看春又隔年。\n今夜白蘋风更恶，去时须傍采菱船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24017,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"哦松夏夜","author":"周文璞","text":"雅颂声流到楚词，更无人见独看时。\n池头五粒初摇动，却替幽人说旧诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24018,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏日偶题","author":"周文璞","text":"溪友相呼上钓舟，藕花菱叶思悠悠。\n好诗已在前山寺，写放参寥石井头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24019,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"桓野王画像","author":"周文璞","text":"胡床三弄清溪笛，叹息欷歔太极筝。\n怊怅斯人风味减，江花江草不胜情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24020,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偶题","author":"周文璞","text":"海气江声相与浮，今时帝里旧杭州。\n西湖寺里多金碧，自厌秾华不肯游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24021,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄山中道友三首 其三","author":"周文璞","text":"忆得寻山复出山，绿杨时候暮春间。\n至今只有游仙梦，长与松风自往还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24022,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄山中道友三首 其二","author":"周文璞","text":"匆匆山信寄来时，中有黄庭七字诗。\n已死华颠无觅处，几回吹断玉参差。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24023,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄山中道友三首 其一","author":"周文璞","text":"玉函捧上五云堆，著意通幽此一回。\n三十年来增怅望，更无人上望仙台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24024,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄华阳道侣","author":"周文璞","text":"羽扇临玄圃，霓裳上醮坛。\n九枝松叶冷，千叶杏花残。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24025,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄茅山道友三绝 其三","author":"周文璞","text":"蕊珠宫女傍瑶屏，自把韦编问姓名。\n回到人间无一事，紫阳花下白鸡鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24026,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄茅山道友三绝 其一","author":"周文璞","text":"伏事三茅过一生，痴心不望羽车迎。\n旧时手种黄龙子，今解升云入太清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24027,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄茅山道友三绝 其二","author":"周文璞","text":"九锡碑亭日欲曛，有人趺坐对炉薰。\n凭谁传语桓司马，句曲山中只白云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24028,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"逸士坟","author":"周文璞","text":"魂归魄散两逍遥，小小丘亭慰寂寥。\n守墓未须耘宿草，白蟾方护紫芝苗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24029,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"隐者居","author":"周文璞","text":"密竹缘坡便当篱，野泉入户自成池。\n床头一卷麻衣易，更有寒山拾得诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24030,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赏春二首 其二","author":"周文璞","text":"赏春社里鼓逢逢，尚恨声同调不同。\n我亦明朝苦无事，更来吹笛乱山中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24031,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赏春二首 其一","author":"周文璞","text":"满酌黄封都市酒，斜簪缥蒂御园花。\n半酣更乞跳珠水，独对风炉自煮茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24032,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"跋钟山赋二首 其二","author":"周文璞","text":"往在秦淮问六朝，江楼祇有女吹箫。\n昭阳太极无行路，岁岁鹅黄上柳条。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24033,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"跋钟山赋二首 其一","author":"周文璞","text":"丁年写了钟山赋，举向禅宫入定僧。\n僧却为余言未好，扶行同谒晋诸陵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24034,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新亭","author":"周文璞","text":"诸君收泪已无言，烟外中原草色昏。\n老子归来坐廊庙，短辕车上欲消魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24035,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"槜李道中二首 其二","author":"周文璞","text":"卧龙山下听吟松，细雨清明似梦中。\n柳荫朱栏三百尺，渴乌犹自泣春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24036,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"槜李道中二首 其一","author":"周文璞","text":"吹彻鹅笙醉碧桃，古城斜日泛轻舠。\n此行忆著经行处，绿树黄桑一样高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24037,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"濑上贞女祠","author":"周文璞","text":"估客征夫上野桥，锦缡玉瑱亦萧条。\n人间多少乘除事，到了英雄恨不消。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24038,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠孤山道士二首 其二","author":"周文璞","text":"清秋古洞无猿啸，自觉寻行幽意微。\n处士桥边增怅望，几回沽酒对斜晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24039,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠孤山道士二首 其一","author":"周文璞","text":"九霄象简手中擎，岂是闲人爱列卿。\n洞里石田春漠漠，有田多与种黄精。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24040,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"七言","author":"周文璞","text":"云竺前头即御园，小风斜雨入梅天。\n放歌偃蹇如圆泽，古貌昂藏若稚川。\n寻得数行天宝字，破他一夜草堂眠。\n此生更要穷经论，惆怅高人旧石筵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24041,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九溪十八涧","author":"周文璞","text":"九溪十八涧，冷见帝青苔。\n洗足僧书石，临流客放杯。\n案头松叶响，身畔野花开。\n百六辞歌吹，清游始一回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24042,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"下竺","author":"周文璞","text":"静看唐人刻，相连坐石阴。\n鸟啼留客意，果熟住山心。\n野水流诗叶，天香袭道林。\n云根有桂子，应待月中寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24043,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书事","author":"周文璞","text":"说战犹能听，闻尸不忍过。\n役人愁似鬼，病马瘦于驼。\n甚欲参经纬，其谁出揣摩。\n中原有遗老，亡柰檄书何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24044,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"壬戌春日","author":"周文璞","text":"自从忧患长精神，兀坐斋房过了春。\n凿落盏乾官烛暗，樗蒲齿龀旅囊贫。\n皇天老眼非尘世，白日闲愁自替身。\n一段风光好如画，未须全与路行人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24045,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王道士庵","author":"周文璞","text":"出家才二十，小筑契初心。\n水浸篱根冷，苔封井臼深。\n狖啼天惨惨，犬吠月阴阴。\n又踞藜床座，焚香鼓内琴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24046,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东阳道中","author":"周文璞","text":"野店梢头起灶烟，江云弄色半晴天。\n暗泉绕砌喧人语，远烧侵林照客鞯。\n晚日未收鸡上树，春风欲度鸟耘田。\n布帆无恙归心稳，才到家山又迫年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24047,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"归别墅","author":"周文璞","text":"幽栖久不到，猿鹤擅藤萝。\n丛筱生将遍，流泉咽更多。\n邻翁新酿熟，野寺暮钟和。\n亦有经行者，来观倚杖歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24048,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"归姑苏","author":"周文璞","text":"旧巢已是别人门，梅自萧疏柳自昏。\n河北谤来须混俗，江东谳就欲招魂。\n故王未纳耶溪女，越相先寻泽国村。\n怀古感今吟不尽，一双清泪落醨樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24049,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"归憩仁王寺","author":"周文璞","text":"重到招提未觉迟，钵单初副袷衣时。\n僧房斋院门门闭，梅子枇杷树树垂。\n蚁荫经幢求托化，龙缠佛座学慈悲。\n长年无事闲来此，坐对空山讽小诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24050,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再如金陵","author":"周文璞","text":"再踏江东路，词穷不复论。\n江泥沾苦泪，津鼓聚归魂。\n庾信因愁老，陶潜为酒存。\n孤踪虽落魄，不敢望明恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24051,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"华道士白胭脂","author":"周文璞","text":"萧史水银粉，番女红蓝花。\n狂奴爱风调，脂泽遂成家。\n镜开青峡月，衣近赤城霞。\n欲下人间世，槲林栖晚鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24052,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吊尧章","author":"周文璞","text":"相逢萧寺已累然，自咏离骚讲太玄。\n极目旧游犹白石，伤心孤冢只苍烟。\n儿从外舍收残稿，客向空山泣断弦。\n帝所修文与张乐，魂兮应是到钧天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24053,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]