[{"title":"无闻","author":"释广闻","text":"老胡密语已乖张，迦叶何曾解覆藏。\n口耳到君俱丧尽，又还家丑外边扬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30968,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"虚舟","author":"释广闻","text":"一从桡下失关津，寂寞空横断岸滨。\n夜夜芦花照明月，可怜不见谢家人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30969,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送林上人归湖南","author":"释广闻","text":"无端活业尽平沉，只为当时错用心。\n归路又从湖畔过，水深不似恨深深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30970,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送无言和尚赴枫林","author":"释广闻","text":"祸兮不入慎家门，除是知恩解报恩。\n只用五峰曾中底，要人吐了要人吞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30971,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"月岩","author":"释广闻","text":"光非照境境非存，恁么曾来二十年。\n话到乖崖峭壁处，令人特地忆南泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30972,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"示头陀过灵隐","author":"释广闻","text":"头颅如雪困风波，未到灵山未倒戈。\n百万人中笑花眼，元来犹有此头陀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30973,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠书华严","author":"释广闻","text":"南询曾不涉途程，写尽山云海月情。\n放笔看来亲到处，一场特地又愁生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30974,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上履斋吴丞相 其一","author":"释广闻","text":"合从龙首便黄扉，尽谓登庸十载迟。\n自是袖中霖雨手，肯令勋业颂皋夔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30975,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上履斋吴丞相 其二","author":"释广闻","text":"一新更化改弦初，人语驩声蔼道途。\n僧自深禅湖上寺，不知身世在唐虞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30976,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"答日本国丞相令公","author":"释广闻","text":"人言千里本同风，何似如今一信通。\n万浪千波浑不涉，新罗元在海门东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30977,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"坏庵","author":"释广闻","text":"壁倒篱坍第二筹，扶持不起转风流。\n只因一句随他语，未到吾宗扫土休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30978,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上秋壑贾丞相 其一","author":"释广闻","text":"宇宙全归掌握中，玄机制胜不言功。\n人将富范张韩比，何异丹青绘太空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30979,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上秋壑贾丞相 其二","author":"释广闻","text":"力挽天河洗甲兵，争如谈笑净胡尘。\n山东名并山西重，历数从来有几人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30980,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赵居士施丹结万人缘","author":"释广闻","text":"透瓶九转有馀香，阅世情忘有未忘。\n一万人缘何日了，明朝烟水又茫茫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30981,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送一彻二公再参无际和尚","author":"释广闻","text":"两公未见无际前，谓从本有成话堕。\n两公既见无际后，谓是不同成两个。\n明知见与未见时，苍龙终不澄潭卧。\n云岩晚归玲珑岩，老儿家有弥天祸。\n口皮边禅惯卖弄，动辄引人入荒草。\n不知两公竟何意，春风又问东南道。\n贫思旧债济北驴，再欲一顿憨作么。\n当时失却一只眼，赋过关门夹山老。\n后三十年有话在，珍重此行休放过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30982,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送东山源和尚归闽","author":"释广闻","text":"寻思六十蒿枝拂，如何再得一顿吃。\n此是临济住后时，黄檗棒头痛的的。\n寻思昔日曾行脚，未离南方已先错。\n此是天平住后时，西院清风顿销铄。\n此时人是彼时人，去时路是来时路。\n老源胸中只自知，却道古人恰相似。\n二月江湖春水生，拈得乌藤先我行。\n得大愚力黄檗力，且听住后真消息。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30983,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"释迦佛赞","author":"释广闻","text":"不即此座，成等正觉。\n不离此座，成等正觉。\n入雪山，悟明星，知之者必谓以慈示人。\n开空花，结空果，不知者将谓实有此作。\n皇天无亲，惟德是辅，此亦名言不及处。\n借水献花，不可当面讳却。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30984,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"出山相赞","author":"释广闻","text":"逾重城为何事，悟明星自欺谩。\n试问出山，何似入山。\n含元殿里，犹觅长安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30985,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"维摩赞","author":"释广闻","text":"机不可触，病不可医。\n说黄道黑，引蔓牵枝。\n要见众生不病时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30986,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"观音赞","author":"释广闻","text":"大士真慈念群生，有如慈母忆其子。\n尽尘毛刹世界海，一一具此一念中。\n惟此一念不退转，如子得母亦复然。\n眼声耳色互三昧，情与无情同證入。\n有能不作实證想，当知此相亦非实。\n忽若子母不相知，大士实相常现前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30987,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"血书心经为圆相赞","author":"释广闻","text":"色何从眼，声不到耳。\n耳色眼声，血滴滴地。\n出乎尔，反乎尔，全身不在圈里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30988,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"师子国相赞","author":"释广闻","text":"十方国土中，应身何彼此。\n春在花，月在水。\n要令当处不留情，好看翻身狮子子。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30989,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"水石上相赞 其一","author":"释广闻","text":"明月下，磐石上。\n以心中眼，观身外相。\n六根互用示慈门，无风平地生波浪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30990,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"水石上相赞 其二","author":"释广闻","text":"月印长江，风号万籁。\n随流入流，无在不在。\n百千三昧一毫头，贵价精神贱价卖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30991,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"鱼篮相赞","author":"释广闻","text":"风吹两鬓萧萧起，全身已是拖泥水。\n何人领取钩头意，明明不在鱼篮里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30992,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"布袋像赞","author":"释广闻","text":"牙关咬定，行又行不上。\n布袋紧靠，放又放不下。\n知他里许，有甚兜率内院底。\n十字街头，辽天索价。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30993,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"四睡图赞","author":"释广闻","text":"睡时递相枕藉，醒后互相热谩。\n笑中有刃，用处多奸。\n看来人斑，宁可虎斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30994,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"韦驮天变相赞","author":"释广闻","text":"横两腕中杵，现堆云里身。\n权中示权处，依旧是天人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30995,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"达磨赞 其一","author":"释广闻","text":"趁得江头航折苇，听教后面风波起。\n不负梁王所问来，只有此心如此水。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30996,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"达磨赞 其二","author":"释广闻","text":"对梁王突出全机，赚神光错礼三拜。\n熊耳月照嵩山云，填沟塞壑无人会。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30997,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"达磨赞 其三","author":"释广闻","text":"天寒京洛雪依然，三拜当时有底传。\n皇道无私太平日，行人犹说普通年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30998,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"五祖荷锄赞","author":"释广闻","text":"江上青山未老，钁头边事犹在。\n若能慎初护末，未到两重纳败。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30999,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"六祖挟担赞","author":"释广闻","text":"柴已落在谁家，此行不空来去。\n手中担子相随，心知应无所在。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31000,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"郁山主赞","author":"释广闻","text":"野水小桥外，诸峰凛寒色。\n被驴子一交，至今翻不得。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31001,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"政黄牛赞","author":"释广闻","text":"人牛两相忘，又向桥边去。\n眼明双鹭鹚，无非是熟处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31002,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"猪头和尚赞","author":"释广闻","text":"目前机，背后底。\n为复神通，为复游戏。\n直令换尽人眼睛，亦与悬羊卖狗而并案耳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31003,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"蚬子和尚赞","author":"释广闻","text":"酒台盘上，和声突出。\n钓螺江畔，捞摝得底。\n是则是以虾为目，不妨用活底祖师意。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31004,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"懒残和尚赞","author":"释广闻","text":"寒涕无暇收，高风自然足。\n客来知不知，吾芋恰新熟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31005,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"船子和尚赞","author":"释广闻","text":"一桡复一桡，打著打不著。\n至今华亭上，犹更风波恶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31006,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"朝阳赞","author":"释广闻","text":"摘不断，穿不透。\n宽作程，急著手。\n要从破后觅浑崙，当阳拈出谁知有。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31007,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"对月赞","author":"释广闻","text":"本无文，未曾说。\n一字字，生铁橛。\n欲了了时是了时，何须特地寻明月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31008,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"李源访圆泽赞","author":"释广闻","text":"相看已瞭然，安用频频举。\n长笛不禁闻，又随烟棹去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31009,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"熊公见西山赞","author":"释广闻","text":"一见能全机，隐身定无路。\n遇犹不遇时，病在回头处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31010,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"大道浴湫图赞","author":"释广闻","text":"腥风怒涛中，信手拿得起。\n触拨老慈明，撺出拄杖子。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31011,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"灵照卖笊篱赞","author":"释广闻","text":"手把长长竹摝篱，与爷同乐又同悲。\n轻如毫末重山岳，十字街头卖与谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31012,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"大慧佛日禅师赞","author":"释广闻","text":"闻薰风南来时，和赃捉获。\n向树倒藤枯处，覆水难收。\n勘破元禅，楪子饤底青虾蟆。\n脱得圆悟，胸次用底活马骝。\n横三尺竹篦，气索列祖。\n翻四河雄辩，贯通九流。\n薄四海内外，罔不中伤。\n旷百世上下，其谁与俦。\n区区作是说者，如一尘之微，又何能重轻乎山丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31013,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"妙峰和尚赞","author":"释广闻","text":"见之目明，气和如春，犹据妙峰顶时平等示人。\n望之心折，面冷如铁，犹坐莲峰堂时大默而说。\n奔走龙象，鞭斥风霆。\n不约而绳，不令而行。\n宜其谈笑兴起东庵正脉，廓清末流之辙。\n至于灵机绝唱，不堕常调，莫妙乎庚峰定穴者也。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31014,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"大川和尚赞","author":"释广闻","text":"握拳透爪，有临济体裁。\n轮珠示人，类大颠风格。\n不欲露全身，惯无赃考贼。\n十地吞声，二乘动色。\n聚一世精神，而用东山暗号。\n鼓大地波澜，而疏东涧正脉。\n宜乎百川倒流，天下暴白。\n如是模写，沧溟一滴。\n传金襕，倒刹竿，须是迦叶师兄始得。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31015,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"古云法师赞","author":"释广闻","text":"获旋陀罗尼，机轮转处风雷疾。\n入萨婆若海，舌头不动云涛翻。\n肆虚空讲，尽实头禅。\n以栗棘蓬，裹金刚圈。\n陶冶有学之学，而披剥万象。\n发挥不传之传，而朝宗百川。\n是为北峰真子，无愧竹庵嫡孙。\n后二千年，是真精进。\n所谓灵山未散之旨，至今一会俨然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31016,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"牧长老以其师立庵像请赞","author":"释广闻","text":"不禀释迦文，踏翻华藏界。\n由天台南觉城东，提苏州有常州有。\n立委羽重关，劄洪塘硬寨。\n如是三十年，起妙喜正派。\n若言老子见青山，行人更在青山外。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31017,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谢灵运赞","author":"释广闻","text":"平生几緉屐，自觉山招我。\n不知身入画，只贪山色好。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31018,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"陶渊明赞","author":"释广闻","text":"和露锄豆苗，不觉日又夜。\n飘然从何来，定在南山下。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31019,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"许宣平赞","author":"释广闻","text":"全肩担荷时，落日重回首。\n世无相逢人，先生不在酒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31020,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"孟东野赞","author":"释广闻","text":"人知琴无弦，无琴无人知。\n独立天地间，知音复是谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31021,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"人我担赞","author":"释广闻","text":"先我后人，为谁辛苦。\n三百六十骨节，透顶透底全露。\n穷鬼子，妨不下担将去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31022,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"阆州许居士画像请赞","author":"释广闻","text":"家在阆城南，阅浮生知其如寄。\n脚踏长安市，了万缘齐之一默。\n雅重甘贽风流，孤峻庞老标格。\n甘终身于澹泊，见古道之颜色。\n故其寓意于物，而不留意于物。\n胸中瞭然，一点谩渠不得。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31023,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"行素长老请自赞","author":"释广闻","text":"无狮子教儿之诀，无老猫上树之机。\n世无所容其拙，人或见谓之慈。\n知之已熟，画出何为。\n后三十年飏在??堆头，便令无光怪发现，未免起傍观按剑之疑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31024,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"端常副寺请自赞","author":"释广闻","text":"本分曾无买卖，动辄于人招怪。\n岂知父子之间，描画虚空著彩。\n端常与么无端，直是克由叵耐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31025,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"资寿牧长老请自赞","author":"释广闻","text":"铁牛去住之机，狮子反掷之诀。\n毫芒略露，崖崩石裂。\n无些子柔和，唯一味生灭。\n电光石火瞥转玄关，千圣顶头恣兴妖孽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31026,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"禅人请自赞 其一","author":"释广闻","text":"冷泉亭放闸，换尽时人眼睛。\n见山堂看云，甚处讨他巴鼻。\n认得完全，是则未是。\n手中黑竹篦，不能打得你。\n胡乱三十年，全无巴鼻。\n叨居六七刹，无补宗教。\n翻著梵志袜，疑之者多。\n倒用司农印，识之者少。\n出岭既不能跂步玄沙，入岭又何敢追踪雪老。\n上人担头不堪泊蝇，也能带得。\n老僧去那逢人展，似即不无。\n若谓起杨岐正宗，疏东涧正派，且莫谤渠好。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31027,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"禅人请自赞 其二","author":"释广闻","text":"北山云拥千岩秀，西子湖平万壑流。\n水石光中闲送目，无边刹海一毫收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31028,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"印维那请自赞","author":"释广闻","text":"眼看东南，意在西北。\n毗卢印倒用，辊动古井蓬尘。\n兴化棒不施，撒下青天雨雹。\n腾身一掷，而抹过万仞龙门。\n掉臂径去，而何有连云栈阁。\n祖师心印谁是亲传，麟兮龙兮峥嵘头角。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31029,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪牧","author":"释广闻","text":"整顿蓑衣禦苦寒，自家水牯自家看。\n白漫漫处无香草，笛弄梅花过别山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31030,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"针","author":"释广闻","text":"恶钳锤下现针锋，正眼开时一线通。\n百匝千重俱劄透，始知个是夜深工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31031,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"羲之故居","author":"释广闻","text":"亭前不改晋山河，亭下春风屈曲过。\n我自不知贤者事，细挼花片付流波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31032,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"蒸笼","author":"释广闻","text":"重重叠叠有来由，热汗通身未肯休。\n直得变生为熟去，方知胡饼是馒头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31033,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"函匮","author":"释广闻","text":"脱体分明类异常，自然函盖却相当。\n衲僧骨董多狼藉，收拾都归一处藏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31034,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"门钩","author":"释广闻","text":"弯弯曲曲个形骸，曾向红炉煅炼来。\n触著上头关棙子，千门万户一时开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31035,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"化楞严会香烛 其一","author":"释广闻","text":"椽烛炉香夏九旬，二千年事向谁论。\n人家十万春风里，尽是灵山会上人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31036,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"化楞严会香烛 其二","author":"释广闻","text":"玉磬轻敲紫篆清，金莲花绽烛荧荧。\n从教一百二十日，散作满天星斗明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31037,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题林司户寒斋","author":"刘克逊","text":"高绝寒斋虽未到，但观名扁定非虚。\n连床夜语炉无火，四壁秋声案有书。\n要与西塘同苦淡，更容东野伴萧疏。\n区区粗得归闲趣，每见高风愧不如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31038,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"三贤堂","author":"刘克逊","text":"堂成土木极精华，壮观先生处士家。\n只恐三贤还一笑，不留隙地种梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31039,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]