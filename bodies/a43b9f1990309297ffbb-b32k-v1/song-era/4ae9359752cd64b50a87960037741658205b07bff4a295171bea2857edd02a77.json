[{"title":"偶吟","author":"俞桂","text":"降伏吾心法，无如去外魔。\n苦吟诗愈拙，著意字犹讹。\n荏苒青衫旧，消磨白发多。\n不才为世弃，徒自咏卷阿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36448,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄陈芸居","author":"俞桂","text":"生长京华地，衣冠东晋人。\n书中尘不到，笔下句通神。\n江海知名日，池塘几梦春。\n精神长似旧，芸藁愈清新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36449,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寓归","author":"俞桂","text":"水激长江浪，风传远寺钟。\n宦情秋意薄，归兴客愁浓。\n捲箔迎新雁，喧篱厌旧蛩。\n何时旋故里，载酒插芙蓉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36450,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"惠山","author":"俞桂","text":"径入松关古，秋云带树烟。\n只疑山有雨，恰是涧流泉。\n骚客诗留壁，游人岸系船。\n凭谁招陆羽，瀹茗古栏边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36451,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"裴坟","author":"俞桂","text":"买船穿僻径，坟古最幽深。\n山近风常冷，松蟠昼亦阴。\n来时无速骑，归路有鸣禽。\n寄语城居者，何人肯访寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36452,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"豫章滕阁","author":"俞桂","text":"滕阁昔曾游，今无槛外楼。\n远山连树合，尽日对江流。\n古石空存记，骚人易感愁。\n夜深歌酒处，灯火灿渔舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36453,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和乐天初夏韵","author":"俞桂","text":"雨脚来山岫，溪痕涨岸沙。\n插旗多酒户，挂网尽渔家。\n地出绷儿笋，园收菜子花。\n春归莺啭懒，风急燕飞斜。\n杯泻青荷叶，瓯煎白玉茶。\n孤村流水晚，数点有归鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36454,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"古意","author":"俞桂","text":"无言情脉脉，美人久相隔。\n道阻脩且长，春草几番碧。\n凤钗冷鬓云，鸾镜轻云羃。\n昔为比翼鸟，今作孤飞翮。\n愁绝寄郎衣，腰瘦裁宜窄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36455,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"延祥观","author":"俞桂","text":"御园犹自有逋梅，约束游人莫肯开。\n听得老兵谈旧事，几年不见翠华来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36456,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"论诗","author":"俞桂","text":"大道本无体，何在文字间。\n易从先天画，诗自圣人删。\n流风传益远，后作莫可攀。\n推敲谁氏子，一字不可闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36457,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏","author":"俞桂","text":"蔷薇花已谢，芍药拟下坡。\n午阴有嘉树，景序犹清和。\n日得诗篇咏，门无俗客过。\n笋胎今岁少，荷叶小池多。\n春去馀旬日，夏云已嵯峨。\n吾年嗟老矣，身事笑蹉跎。\n但欲卧白石，幽岩扪青萝。\n已与心料理，不必问如何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36458,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即事","author":"俞桂","text":"东君无处不繁华，一雨才晴意便佳。\n客舍山梅开遍了，从今懒买檐头花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36459,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"灵隐","author":"俞桂","text":"回首得两年，曾入灵隐去。\n一路看不足，衣沾松上露。\n白云来相迎，涧泉飞瀑素。\n此景天下无，远胜庐山路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36460,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"居闲","author":"俞桂","text":"富贵人所愿，贫贱不堪忧。\n自有兰蕙清，非比萧艾羞。\n功名如露草，飘瓦若虚舟。\n千载傥相遇，皋夔及伊周。\n苟使穷未达，一壑营一丘。\n出处谨吾节，斯心已细筹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36461,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"采莲曲 其二","author":"俞桂","text":"西湖西畔荷花多，扣舷女儿娇唱歌。\n道旁骏马金叵罗，欲住不住横秋波。\n放船却入花深处，临流照妆噤不语。\n南山起云北山雨，折得荷花不归去。\n弄波惊起鸳鸯双，水珠溅湿芙蓉裳。\n恨无飞羽致汝旁，溯渑从之云路长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36462,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"采莲曲 其三","author":"俞桂","text":"女伴歌采莲，清声度流水。\n无意惊鸳鸯，鸳鸯自飞起。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36463,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"采莲曲","author":"李龏","text":"西风引袂凉云起，鸳桨扶船浮绿水。\n露沁花脂茜粉香，满柄蜂芒刺葱指。\n红绡半妥金钏明，堤上玉郎窥唱声。\n湘中暮雨欢期失，各自东西空目成。\n船荡波心烟漠漠，归路花从唱边落。\n绿艳红妖江水深，水底灵均应不觉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36464,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨吟","author":"俞桂","text":"轻轻烟雾失楼台，雨暗吴山锁不开。\n试与渔翁闲访问，落花几许泛溪来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36465,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋行吟","author":"俞桂","text":"西风紧兮叶脱枝，寒露瀼兮菊绕篱。\n芦花白兮蓼满湄，雁声急兮蛩转悲。\n乐吾浙兮殊兴思，况东淮兮落远陲。\n朝气肃兮夜漏迟，暮云黯兮山色衰。\n纷纷眯目黄埃吹，艰关千里徒驱驰。\n穷猿投林任所之，膏粱诸公那得知。\n从今休被微官缚，未若琴歌诗酒乐。\n岂无手足怀我情，当念行人多寂寞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36466,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"种竹","author":"俞桂","text":"门前槐已长，庭内草自生。\n所欠园中竹，多种渠几茎。\n此君真可爱，非独王猷情。\n有时吟咏暇，入园得闲行。\n所幸笋萌出，次第阴可成。\n□使神宇爽，渐觉眼界清。\n最是秋雨夜，风来□□□。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36467,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"阅名胜诗集","author":"俞桂","text":"买得山房数册诗，倚篷细读已移时。\n只贪眼底看冰玉，月上荷花更不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36468,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"惜春","author":"俞桂","text":"春事三分过二分，桃花水上觅红云。\n游人浪说春归去，柳外黄鹂尚自吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36469,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜雨上别大参","author":"俞桂","text":"爰立为霖仰望深，今朝一雨慰苍生。\n经纶久柬君心在，燮理还同天道亨。\n爱国虑勤宽玉带，筹边谋远捍金城。\n我公勋业难模写，但见皇家庆太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36470,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赏月","author":"俞桂","text":"天净无一云，地净无一尘。\n十六月圆满，皎皎白玉轮。\n古今同此月，照破世间人。\n夜久方浴出，露坐风满襟。\n清影入窗户，聊足尉我心。\n所欠一樽酒，所乏一张琴。\n如此好月色，惜乎在海滨。\n痴儿官事了，空自疲精神。\n不得赏新月，酬酢相与频。\n今宵诗兴动，狂吟渔溪民。\n独对犹复尔，况逢亲共宾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36471,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赓宋雪岩韵","author":"俞桂","text":"诗与梅花一样清，江湖久矣熟知名。\n未容便理趋朝计，行见相留入幕荣。\n照座精神澄玉宇，当官才刃压金城。\n星郎况是曾知己，刮目英游藻鉴明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36472,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"海棠","author":"俞桂山","text":"向晚鸾笺擘砑红，相烦归燕简东风。\n酬春未得偷閒力，迟放海棠花几丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36473,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"人影","author":"俞桂英","text":"身外复添汝，无言随去留。\n自从生便有，直到死方休。\n步月常相逐，临溪元不流。\n静中明道眼，总是一虚浮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36474,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其四","author":"俞桂英","text":"百无一事身为客，十有九分心在家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36475,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其一","author":"俞桂英","text":"一点梅香到，三分酒力消。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36476,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其二","author":"俞桂英","text":"母念子行远，儿云爷未归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36477,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其三","author":"俞桂英","text":"白云一树鹤孤宿，明月满楼钟鼓声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36478,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题东山","author":"俞烈","text":"文会得吾党，净居清昼长。\n平生爱山僻，暇日聊徜徉。\n风流谢康乐，肥遁计亦良。\n钟鼎成淹留，江湖晚相望。\n山色青未改，山名久愈彰。\n松风度晚曲，岩花弄晨妆。\n尚疑缥缈人，髻鬟下鸣珰。\n凄凉怀古恨，野水涵方塘。\n功名不作难，出处何可忘。\n人自草木腐，看渠日争光。\n香消酒力微，缘阴听圆吭。\n悠然发遐想，莞尔还成章。\n归途有清泚，濯缨咏沧浪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36479,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题净梵院清虚堂","author":"俞烈","text":"天清蚕麦馀，绿结桃李实。\n老僧诗衔袖，过我语言质。\n怀山意先行，如病梦芝朮。\n去□才一舍，鞭策不终日。\n堂筵新结束，空洞无长物。\n风来舞翠杉，土暖荣病橘。\n欲行意先清，舌评骥不及。\n何由解鞍卧，夜枕雨潇瑟。\n泉清韵磬远，林樾琅玕密。\n杯寒续飞斟，烟继香绕室。\n谈玄契参同，酒旨妙真一。\n怀新辜雅趣，意懒□健笔。\n亦如罢参僧，野禅缚枯律。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36480,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三岩","author":"俞掞","text":"三岩之下有贤良，暮史朝经万卷长。\n树老山空人已尽，烱然千古姓名香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36481,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"白华岩","author":"俞掞","text":"风剪飞丝雨脚残，半山虚旷九秋寒。\n洗开万里乾坤眼，更上苍岩顶上看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36482,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浯溪 其二","author":"俞掞","text":"宋朝一统旧江山，南北中分已百年。\n壮士不须誇此颂，健提椽笔上燕然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36483,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浯溪 其一","author":"俞掞","text":"大唐有颂到浯溪，翠藓苍崖古画垂。\n西望函关今万里，淡烟斜日几荒碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36484,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"六石峰","author":"俞掞","text":"斸石云边著著高，几经吟笔写风骚。\n山翁莫袖经纶手，好趁春风钓六鳌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36485,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"忆匡山","author":"俞跃龙","text":"匡庐一掬里，雪眼嗽天根。\n时落冻僧影，不逢飞鸟痕。\n梦中石门路，月照柴桑村。\n春水自兹远，幽期空复存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36486,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"俞野处","text":"郎罢耕归呼囝牧，阿翁眠起问姑蚕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36487,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游春黄胖","author":"俞朝士","text":"两脚捎空欲弄春，一人头上又安人。\n不知终入儿童手，筋骨翻为陌上尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36488,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"跋山谷书范滂传帖","author":"俞畴","text":"貂珰群雏擅天网，手驱名流入钩党。\n屯云蔽日日光无，卯金神器春冰上。\n汝南节士居危邦，志刬萧艾扶兰芳。\n致君生不逮尧舜，死合夷齐俱首阳。\n千年兴坏真暮旦，殷鉴讵应如许远。\n安知后人哀后人，又起诸贤落南叹。\n宜州老子笔有神，蝉蜕颜扬端逼真。\n少模龙爪已名世，晚用鸡毛亦绝人。\n平生孟博吾尚友，时事骎骎建宁旧。\n胸蟠万卷老蛮乡，独感斯文聊运肘。\n老子书名横九州，一纸千金不当酬。\n此书岂但翰墨设，心事悢悢关百忧。\n人言老子味禅悦，疾恶视滂宁尔切。\n须知许国本精忠，不幸为滂甘伏节。\n九原莫作令人悲，遗墨败素皆吾师。\n从君乞取宜州字，要对崇宁党籍碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36489,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水村闲望","author":"俞紫芝","text":"画桡两两枕汀沙，隔岸烟芜一望赊。\n翡翠閒居眠藕叶，鹭鸶别业在芦花。\n溪云漠漠迷渔屋，野旆翻翻露酒家。\n一幅江南真水墨，无人写得寄京华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36490,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"咏草","author":"俞紫芝","text":"满目芊芊野渡头，不知若个解忘忧。\n细随绿水侵离馆，远带斜阳过别洲。\n金谷园中荒映月，石头城下碧连秋。\n行人怅望王孙去，买断金钗十二愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36491,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"旅中谕怀","author":"俞紫芝","text":"白浪红尘二十春，就中奔走费光阴。\n有时俗事不称意，无限好山都上心。\n一面琴为方外友，数篇诗当橐中金。\n会须将尔同归去，家在碧溪烟树深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36492,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诉衷情令","author":"俞紫芝","text":"钓鱼船上谢三郎。\n双鬓已苍苍。\n蓑衣未必清贵，不肯换金章。\n汀草畔，浦花旁。\n静鸣榔。\n自来好个，渔父家风，一片潇湘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36493,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"苏幕遮","author":"俞紫芝","text":"地钟灵，天应瑞。\n簇簇香苞、团作真珠蕊。\n玉宇瑶台分十二。\n要伴姮娥，月里双双睡。\n月如花，花似月。\n花月生香，添此真奇异。\n不许扬州夸间气。\n昨夜春风，唤醒琼琼醉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36494,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"临江仙 题清溪图","author":"俞紫芝","text":"弄水亭前千万景，登临不忍空回。\n水轻墨澹写蓬莱。\n莫教世眼，容易洗尘埃。\n收去雨昏都不见，展时还似云开。\n先生高趣更多才。\n人人尽道，小杜却重来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36495,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"万杉寺","author":"俞献可","text":"栽培万杉树，延纳五峰云。\n莲社松门接，陶居柳径分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36496,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中山别墅","author":"俞瑊","text":"村居何所乐，我爱读书堂。\n阶草侵窗润，瓶花落砚香。\n凭栏看水活，出岫笑云忙。\n野客时相过，联吟坐夕阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36497,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"孙氏池亭","author":"俞瑊","text":"壁介山水间，幽栖愧尸禄。\n眠食行坐处，山光水声足。\n嗟我心未厌，出郊搜胜躅。\n尝闻隐者居，未为人所目。\n素商适丁序，天空老林麓。\n飞鞭走崇冈，惟恐到不速。\n扪萝出孤险，果得烟霞谷。\n神仙何玄怪，刻划乾坤腹。\n囊括幽绝景，所谓天下独。\n门前白石溪，丁当漱寒玉。\n山泉落云头，漫漫泛馀绿。\n静听宿乌吟，闲看浮鸥浴。\n万古仇池穴，何日此镌筑。\n欲探龙颔珠，潭深怯狞毒。\n瀑布想匡庐，香山葺茅屋。\n松窗风浪摇，石径苔藓覆。\n楼藏未见书，园挺耐寒木。\n清风谁共延，墙头万个竹。\n造化曲尽情，远引空江束。\n阴寂窟蛟蜃，雨雹生晴燠。\n孙氏何代贤，据此傲浮俗。\n崖留五君诗，尘埋不可读。\n殷勤补讹缺，磨写笔屡秃。\n开亭追古踪，仙游一朝复。\n自惭缚冠冕，暂到不得熟。\n何时酬素心，归来免荣辱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36498,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"俞瑊","text":"壁山僻陋户口少，两衙之外惟高眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36499,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"俞演","text":"残灯吟夜雨，破榻卧秋山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36500,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"俞肇","text":"石根行步转，耳畔水声移。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36501,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"疏山","author":"俞鼐","text":"路入千岩紫翠深，溪山好向梦中寻。\n松风洗净笙歌耳，泉石挽回花柳心。\n曲水流觞追禊事，茂林修竹是山阴。\n兰亭旧墨空磨灭，俛仰人间成古今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36502,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"庆元三年以职事至零陵访澹岩","author":"俞徵","text":"传闻此地稀，来为细搜奇。\n眩眼珠泉滴，抬头玉乳垂。\n虚明天广大，重叠石参差。\n坐久衣襟润，声翻语笑随。\n幽深多怪巧，高下复逶迤。\n历览仙君迹，难酬太史诗。\n自然千古意，形咏愧芜词。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36503,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"姑苏有赠","author":"俞德邻","text":"画楼珠翠列娉婷，辽鹤重来失故城。\n商女不知宁有恨，徐娘虽老尚多情。\n一帘花雨谈幽梦，双桨莼波急去程。\n却倚阊门重回首，笳声呜咽暮云横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36504,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"龙岩寺","author":"俞鼒","text":"虬须公子真奇物，曾把英灵寄此山。\n鼓鬣掀髯天上去，空留遗迹在人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36505,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"武康道中","author":"俞灏","text":"竹窗听雨自安眠，不道惊湍近屋前。\n省得去年桃叶渡，水痕只到树傍边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36506,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偶成","author":"俞灏","text":"白发黄尘一梦中，又将愁眼对春风。\n不知夜雨能多少，染得桃花到处红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36507,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"湖堤晚行","author":"俞灏","text":"暝色才从草色生，管弦罗绮尽归城。\n不应闲却孤山路，我自扶藜月下行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36508,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三高堂","author":"俞灏","text":"东华车马日滔滔，始觉三高分外高。\n吴越衣冠几春梦，古今身世一秋毫。\n临流久立迷烟艇，驾月归来认雪涛。\n琢句不成风又起，寒蒲霜鬓两萧骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36509,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"云海亭","author":"俞灏","text":"恋恋栏干去复留，恍然天地与身浮。\n水涵空界光无际，山在地州翠欲流。\n点破琉璃云表雁，足成图画柳边舟。\n岁阑却自忘归兴，更欲同为雪后游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36510,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病眼","author":"俞灏","text":"三分春色二分过，检校花程已下坡。\n近日顿然行乐少，今年分外负春多。\n闲身自在宁须禄，俗客相看只是魔。\n四百病中偏病眼，禁烟禁酒却如何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36511,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鸲鹆","author":"俞灏","text":"守黑元知分，能言亦任真。\n人知不可食，我得自全身。\n牛背烟村画，乌群野水春。\n从教鹦鹉贵，笼络媚宫嫔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36512,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"点绛唇","author":"俞灏","text":"欲问东君，为谁重到江头路。\n断桥薄暮。\n香透溪云渡。\n细草平沙，愁入凌波步。\n今何许。\n怨春无语。\n片片随流水。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36513,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"俞灏","text":"不知雨后理精神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36514,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]