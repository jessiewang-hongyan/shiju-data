[{"title":"次韵斯远喜予见过 其二","author":"韩淲","text":"望望公超市，烟云满眼过。\n经时不相见，此地复如何。\n物色真难识，情怀敢自多。\n喜君诗在手，吟讽亦婆娑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26122,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"同郑处晦尹子潜过赵十","author":"韩淲","text":"老去吟何味，分明水一杯。\n目前轻过节，身外待寻梅。\n尚以同盟至，宁云不速来。\n此时心寸折，犹幸小徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26123,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十一日过景瑜","author":"韩淲","text":"下郭山盘屋，轩亭景晏如。\n浅斟留把酒，细字见抄书。\n河洛无由返，江湖已定居。\n子孙皆土著，鱼米我还疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26124,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"子似见过","author":"韩淲","text":"门外梅枝晓，人来乃是君。\n冲风迎腊日，欲雪动寒云。\n禹穴山阴道，西湖处士坟。\n我怀何用寄，搔鬓白纷纷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26125,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"邢大声广声于去非携酒约解元衡毕叔文及蕃过陈叔尹值叔尹之出成四十字","author":"韩淲","text":"松竹连花树，田园带隐庐。\n青衫宁累我，黄卷不孤渠。\n载酒期问字，经邱逢命车。\n庞公虽浪出，且慰故人疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26126,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"添倅至因谒之来访乃故相郡侯之子也","author":"韩淲","text":"相国推前辈，通家复胜游。\n人知新别驾，我叹旧州侯。\n世数推迁远，时情展转休。\n衡山云冉冉，玉水日悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26127,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过王仲如林隐","author":"韩淲","text":"莫把闲情醉，空留野老诗。\n雷声梅雨过，日影竹风吹。\n林隐访前话，华阳非近知。\n相过二三友，比客更邀谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26128,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"昌甫携儿侄载酒来送分韵得房字","author":"韩淲","text":"春寺不寻芳，诗翁作醉乡。\n花香空夹径，草细恰通房。\n僧固枯禅寂，人非好句忙。\n出城惟怕晚，冉冉趁斜阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26129,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"二十七日周七载酒且怀春伯","author":"韩淲","text":"十载梅陂酒，青岩始共游。\n香传高树晚，凉映小塘秋。\n饮亦何劳醉，吟成苦未休。\n补陀山下客，能为此回头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26130,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"黄仁卿见过留之而无酒因要宋衡携酒以至得以款语已又酌仁卿携行之茶成四十字","author":"韩淲","text":"雨重乌臼树，风微萱草花。\n重携万安酒，再瀹建州茶。\n邂逅年何晚，情亲日自加。\n两君真玉立，而我愧无瑕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26131,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"施重益留夜饮","author":"韩淲","text":"秋閒得幽讨，竹涧款门时。\n绝壑通流水，横桥壅断陂。\n岩花已芬郁，山木未凋披。\n静夜持杯酒，人清更说诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26132,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"蹈中见过山间 其一","author":"韩淲","text":"贵贱曾何在，悲欢孰使然。\n如君真绝足，奈我已华颠。\n勋业谁彝鼎，文章自简编。\n中原有前辈，吾忆范忠宣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26133,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"蹈中见过山间 其二","author":"韩淲","text":"三月多风雨，门前涧水侵。\n岸花无一片，园柳忽成阴。\n有客因留饮，呼儿取次斟。\n桥南春郭外，珍重肯幽寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26134,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"小饮春山","author":"韩淲","text":"细雨初冬夜，溪山书院灯。\n闲来四五辈，留饮两三升。\n久坐形神定，高谈意气增。\n我归眠蕙帐，谁信在家僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26135,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"初十日黄仲明见过留饭却同至野趣饮茶 其一","author":"韩淲","text":"风力催云雪，比邻往复还。\n穿林踏黄叶，沿涧看青山。\n共饭因而款，煎茶益以閒。\n岁寒如此过，他事肯相关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26136,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"初十日黄仲明见过留饭却同至野趣饮茶 其二","author":"韩淲","text":"山空吹雪意，草树晚天寒。\n烟抹忽收起，风行时坐看。\n鸡声村店远，雁落市桥宽。\n尽道闲多病，老身还自安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26137,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"同昌甫陪朱虞卿约尹郑二士饮食艮堂","author":"韩淲","text":"到处逢春酌，闲吟过此生。\n落花亭上饮，芳草岸边行。\n我亦非无兴，人应不负情。\n风光共流转，楼外远山明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26138,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"朱虞卿以诗送家酿和韵","author":"韩淲","text":"绝叹交游落，何论比与周。\n座开今日酒，门款昔年秋。\n濯锦江头杜，玄都观里刘。\n相望风雅在，天地一虚舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26139,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"王校以诗送笋及一壶","author":"韩淲","text":"涧道迷蓬藿，山空且熟眠。\n雨多从蔽日，风横任吹烟。\n欢喜收笺翰，提携到酒泉。\n更逢初斸笋，急急和新篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26140,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"坐客竞置殽核因赋示尹子潜","author":"韩淲","text":"鱼蟹人人馔，柑橙盏盏诗。\n醪芳邻所借，情分客能知。\n城外溪山在，门前巷陌卑。\n寒虽欺木叶，春已报梅枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26141,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪寒钱","author":"韩淲","text":"加赐雪寒钱，欢声禁旅传。\n妻孥应盼盼，儿女定跹跹。\n醉熟千家酒，炊香万灶烟。\n何须谈挟纩，王道本通天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26142,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵昌甫分遗乌石茶","author":"韩淲","text":"茶经空烂读，读罢出溪头。\n竹杖虽流憩，藜床复倦投。\n寻思煎以吃，展转卧而游。\n乌石瓶能好，瓯牺底用忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26143,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"昌甫送艾叶饼","author":"韩淲","text":"我爱郊居者，春芽艾叶长。\n云舂和豆实，雾摘带麻香。\n杞菊天随旧，蓬蒿仲蔚常。\n近来关膈病，且得煖枯肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26144,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十三日至草衣院因上灵山阁","author":"韩淲","text":"塔院横塘草，阶梯大谷林。\n风声迷近渚，雨气暗遥岑。\n索面僧回钵，持醪客屡斟。\n依归从早出，静寄得幽寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26145,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谢乙翁上人","author":"韩淲","text":"雨后晚窗日，方杯燎竹炉。\n二茶劳见饷，一记又能摹。\n看了信何有，啜来昏更无。\n阿师莫作剧，我悔不逃儒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26146,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"访杰上人","author":"韩淲","text":"涧道湿冻雨，林扉藏断云。\n寒声肃肃起，暝色杳杳分。\n斋馀随动息，禅外失知闻。\n坐久催煎茗，炉深亦炷熏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26147,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"初二日大雪访杰上人","author":"韩淲","text":"山中知我老，雪里见僧清。\n物色添幽意，年华近俗情。\n树遥风共晚，岸窄水初生。\n一榻茶烟熟，更闻寒雀声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26148,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"王通叟自温之赣过门因得五字","author":"韩淲","text":"庵高一宿觉，不是二乘禅。\n露柱灯笼里，狸奴白牯边。\n前资钦戒腊，参学待机缘。\n吸尽西江水，从将此话传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26149,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"建阳连周宾幼入佛学近祝发江东真运副请住信鹅湖不出","author":"韩淲","text":"不住鹅湖寺，惟甘小隐堂。\n老来才祝发，静处久烧香。\n妙喜机缘峻，竹源滋味长。\n建阳桥下水，梦见亦清凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26150,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄天目僧文礼灭翁","author":"韩淲","text":"生怕人饶舌，诗吟不著题。\n飘零惊已晚，依约梦还迷。\n但愿乘风去，何言立雪齐。\n万缘谁百计，谷隐自岩栖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26151,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"柬宿之藏主","author":"韩淲","text":"雪观碧云合，檐花带女萝。\n磬清收梵呗，香净入禅那。\n粥饭门房少，经斋城市多。\n幽人邻近住，取次一相过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26152,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"乙上人来过","author":"韩淲","text":"恰自山岩转，又逢瓶锡过。\n风轩洒飞雨，云壑漾回波。\n且吃庐山饭，休论击壤歌。\n尘劳空恁么，禅悦竟如何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26153,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雨中过春山","author":"韩淲","text":"溪南上下郭，得得过春山。\n自叹欲何往，相从非等闲。\n波深鱼泼泼，竹静鸟关关。\n若个渔舟晚，延缘见苇间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26154,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十六日过万顷新田","author":"韩淲","text":"别墅能怀谢，开轩既有云。\n大田还筑室，小醉话知闻。\n叶县仙非俗，兰亭字不群。\n吾侪今老矣，随意度朝曛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26155,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山崦","author":"韩淲","text":"山崦昏濛雨，溪流冷落风。\n隔城须会友，闭户独衰翁。\n交气游谭外，存神燕息中。\n可容诸念起，应与此心同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26156,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"晚步东庵","author":"韩淲","text":"薄晚登山屐，霜林脱叶飞。\n中间看月上，低处觉烟霏。\n鸡犬近相接，人家远独稀。\n故园应好在，凝望客思归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26157,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"二十一日晴过山园 其一","author":"韩淲","text":"饭了小园间，乘晴享此闲。\n因行扫黄叶，随意看青山。\n取径嫌林密，为基惜地悭。\n绳床坐来久，一饮又徐还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26158,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"二十一日晴过山园 其二","author":"韩淲","text":"饮亦微微醉，归来睡思浓。\n身形方放脚，鼻息自填胸。\n熟美可嫌老，轻安只益慵。\n分明醒复寝，不觉到昏钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26159,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"幽艳","author":"韩淲","text":"幽艳人谁识，孤标我岂堪。\n水烟春淡淡，山日晚酣酣。\n纵以诗随看，其如把酒参。\n子游清兴发，半道记舆篮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26160,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十二月入城因步城东","author":"韩淲","text":"雾暖南溪路，日斜东郭门。\n老身愁近俗，闲步喜前村。\n访旧寻诗话，同来取酒尊。\n几多山树外，梅动影黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26161,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"二十日雪中入城","author":"韩淲","text":"不须深巷卧，懒学剡溪回。\n破轿身闲出，衡门手亟开。\n山林遽如许，人物岂他哉。\n桥过城东宅，朋从三两来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26162,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"一曲","author":"韩淲","text":"一曲寒城外，青山四五家。\n庭空鸣败叶，楼迥起清笳。\n市远兴逾逸，人来话亦佳。\n夜深残月澹，还有未栖鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26163,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"灵溪道中","author":"韩淲","text":"但觉村深好，青山分外多。\n连延俄耸拔，回复又坡陀。\n风冷平沙雁，天空上水鹅。\n晚时见鱼艇，吾欲借其蓑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26164,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"灵鹫道中","author":"韩淲","text":"历历山川旧，舆篮我为迟。\n偶同三友去，又作一篇诗。\n怀德樟丘远，阊门玉片思。\n僧窗攲梦枕，休问夜何其。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26165,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过吴淞","author":"韩淲","text":"敢有怀君意，人生任所从。\n千山才越楚，一水又吴淞。\n白发居头乱，青春入眼浓。\n乾坤随处好，诗酒自能供。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26166,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"震泽","author":"韩淲","text":"春风吹震泽，欲雪未多晴。\n转柁何忙去，停篙且缓行。\n柳摇田漠漠，草软岸平平。\n四十年前梦，心惊热眼生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26167,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋闲因小舟上南豅 其一","author":"韩淲","text":"老自转便静，闲谁不奈贫。\n山林无长物，天地有忙人。\n玉水时时急，灵山日日新。\n凉风吹四壁，吾忆坐忘真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26168,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋闲因小舟上南豅 其二","author":"韩淲","text":"野意不堪老，秋怀无用悲。\n更容书作祟，犹藉酒能医。\n去去孤云片，垂垂小雨丝。\n人生偶然尔，天地也如斯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26169,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋闲因小舟上南豅 其三","author":"韩淲","text":"暑退凉生处，新秋月满轩。\n僧坊从解夏，符箓竞中元。\n桂菊花将动，禾苗穟正繁。\n世间多俗节，投老且清言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26170,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋闲因小舟上南豅 其四","author":"韩淲","text":"涧谷惭真隐，溪山欲浪游。\n流长宜逸桨，滩浅可移舟。\n秋净云初薄，时丰雨未休。\n短篷吾自喜，知识有浮鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26171,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"除夕前一日溪岸晚步 其一","author":"韩淲","text":"春动高溪水，交游独有君。\n人情虽澹澹，物色已欣欣。\n香转梅梢日，光分岭外云。\n林亭同眺久，竟把一杯醺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26172,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"除夕前一日溪岸晚步 其二","author":"韩淲","text":"午步溪边路，谁家小筑幽。\n敲门问亭榭，迎我具觥筹。\n意适春光动，晴曛野色浮。\n一株梅更好，香艳发梢头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26173,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"除夕前一日溪岸晚步 其三","author":"韩淲","text":"小醉归来处，陶然度夕阳。\n一溪波汎汎，半岭树苍苍。\n岁晚身何用，春新意欲狂。\n只宜同判断，柳外百花光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26174,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪晴南圃放步","author":"韩淲","text":"腊闰春为早，梅花处处多。\n不知千树暗，无奈一枝何。\n雪后风初峭，霜前日已和。\n老人山涧曲，不饮亦婆娑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26175,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过野趣","author":"韩淲","text":"春涧涓涓水，山云放晚晴。\n捧身推户出，夷步过桥行。\n细草梅英嫩，崇桃柳线轻。\n人忻得芳事，禽鸟亦飞鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26176,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"晚步溪山堂下","author":"韩淲","text":"晓园经雨润，饮罢过溪边。\n灯火三家市，樯竿独客船。\n傍崖支径去，设席得茶煎。\n寄语同来者，兹游亦自便。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26177,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"香积寺闲步","author":"韩淲","text":"瀹茗幽窗下，围棋小槛旁。\n同来一寻胜，散坐共追凉。\n水竹元深茂，岩花已再香。\n长安尘土里，城外喜行藏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26178,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十三日自赵十家同诸友步至浮梁","author":"韩淲","text":"渌净偏浮月，清虚正得秋。\n半酣元有兴，投老却无愁。\n露气远犹见，烟光冷不收。\n孤城对萧寺，新雁便沧洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26179,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"同黄靖州闲步","author":"韩淲","text":"秋净晴原日，因行过屋东。\n归来三载后，犹得五人同。\n问讯荒园外，周游并舍中。\n留连一杯酒，还我旧家风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26180,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夜同处晦霞山","author":"韩淲","text":"灯影山窗淡，杯寒道院深。\n世尘心力弱，时俗鬓毛侵。\n烟莽开幽径，霜枝堕远林。\n地偏愁独往，邻近喜相寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26181,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"晚过灵室","author":"韩淲","text":"溪浅寒光合，山横夜气深。\n拥炉诗触拨，举白醉侵寻。\n话久销尘虑，情忘见道心。\n断霞明别渚，霏雾锁遥岑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26182,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"报昌甫青岩之游","author":"韩淲","text":"秋到青岩寺，山深眼为新。\n寻思曾宿客，笑我再来人。\n欲住苦违俗，便归愁染尘。\n争如两峰底，苔竹养吾真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26183,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"黄仲明同看池上菊一酌因出溪桥久之","author":"韩淲","text":"饮菊明山日，行林挟岸风。\n近霜虽落木，得雨自成丛。\n小醉情怀外，微吟步武中。\n幽闲有如我，邂逅复心同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26184,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"两倅约过南台","author":"韩淲","text":"别乘偷閒里，南台避暑初。\n招邀到班邴，宦达付严徐。\n贤相规尤远，灵山画不如。\n荆淮多战鼓，煮饼少踌躇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26185,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闻昌甫斯远成季下瓦窑滩又与伯皋回涂小集成季书院","author":"韩淲","text":"八月南豅夜，遥知聚德星。\n航溪不用楫，解榻卧长瓶。\n上下知何往，违离忆屡经。\n前檐扑山翠，梅叶映窗棂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26186,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"六月二日晨起","author":"韩淲","text":"雨足风尤润，岚深日未开。\n一山凉有树，四壁净无埃。\n鸡唱远仍密，鸟飞低复回。\n宁忧身已老，尚喜客能来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26187,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"晓起","author":"韩淲","text":"晓起百无营，山空一涧清。\n林霜知爽甚，檐日觉寒轻。\n静整遗编读，闲循古道行。\n嚣尘不到眼，禽鸟亦忘情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26188,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"听琴","author":"韩淲","text":"以彼发此意，因此知彼声。\n山川既闲远，天地亦清宁。\n独抚曲空奏，相宣调易成。\n何由俗子爱，宜是老夫惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26189,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"灵芝寺清坐听潘德久弄琴久之小酌而散","author":"韩淲","text":"秋晚灵芝寺，阴云阖复开。\n荷枯半倚草，柏老遍生苔。\n兴到容吾赋，闲知与客来。\n琴边更三叠，莫放酒船回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26190,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]