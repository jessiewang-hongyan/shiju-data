[{"title":"宿查濑","author":"杨万里","text":"寒流一带槛前横，落日诸峰霞外明。\n水断新洲添五里，客寻旧路却重行。\n江车自转非人踏，沙碓长舂彻夜鸣。\n畴昔稚桑今秃树，如何白发不教生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69441,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿牧牛亭秦太师坟庵","author":"杨万里","text":"函关只有一穰侯，瀛馆宁无再帝丘。\n天极八重心未死，台星三点坼方休。\n只看壁后新亭策，恐作栘中属国羞。\n今日牛羊上丘垄，不知丞相更嗔不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69442,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿金陵镇栖隐寺望横山","author":"杨万里","text":"再见横山滴眼新，山曾劝我脱官身。\n灯笼箫鼓年年社，酒盏莺花处处人。\n忽忆诸公牡丹会，转头五柞去年春。\n野云墟月空荒寺，两袖寒风一帽尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69443,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿新丰坊咏瓶中牡丹因怀故园二首 其二","author":"杨万里","text":"天下花王绝世无，侬家移得洛徽苏。\n花头每朵一千叶，亲手前春五百株。\n雪白猩红相映带，娇黄酽紫更敷腴。\n乡魂开眼归将去，飞过长江彭蠡湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69444,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿新丰坊咏瓶中牡丹因怀故园二首 其一","author":"杨万里","text":"客子泥涂正可怜，天香国色一枝鲜。\n雨中晚敛寒如此，烛底宵暄笑粲然。\n自觉玉容微婉软，急将翠掌护婵娟。\n江南也有新丰市，未羡宾王酌圣贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69445,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿横冈","author":"杨万里","text":"我岂忘怀一亩居，谁令爱读数行书。\n秋南春北雁相似，柳思花情莺不如。\n上市鱼虾村店酒，带花菘芥晚春蔬。\n长亭一醉非难事，造物相撩莫管渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69446,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄广东提刑林谦之司业","author":"杨万里","text":"玉节星槎下九天，祝融海若让云烟。\n故人一别还三岁，新句如今更几篇。\n忆昨待班南内否，论诗看雪未央前。\n梦中若个韶州路，庾岭梅花正可怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69447,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄马会叔","author":"杨万里","text":"影转郎官宿，春随刺史天。\n相从忽相别，同舍况同年。\n我爱吴儿说，兄如邵父然。\n赐金真浪费，唤取从甘泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69448,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄中洲茶与尤延之延之有诗再寄黄檗茶仍和其韵","author":"杨万里","text":"诗人可笑信虚名，击节茶芽意不轻。\n尔许中洲真后辈，与君顾渚敢连衡。\n山中寄去无多子，天上归来太瘦生。\n更送玉尘浇锡水，为搜孔思搅周情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69449,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄别何运判德献移闽宪二首 其一","author":"杨万里","text":"再岁三移节，千山一据鞍。\n梅花锦囊古，霜月绣衣寒。\n民欲刑几措，公于此岂难。\n谁令清庙器，未著侍臣冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69450,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄别何运判德献移闽宪二首 其二","author":"杨万里","text":"薄技工奚取，知音一已多。\n从公日几许，去我意如何。\n梦里闽山月，吟边楚水波。\n门阑万珠履，更试岁寒柯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69451,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄张功父","author":"杨万里","text":"问讯子张子，诗狂除未除。\n年时一健步，寄我数行书。\n旧矣哦招隐，谁欤诵子虚。\n江湖隔京洛，不是爱相疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69452,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄张钦夫二首 其二","author":"杨万里","text":"工瑟曾缘利，鸣琴岂负予。\n发于贫里白，诗亦病来疏。\n知己俱霄汉，孤踪且簿书。\n三年知免矣，一饱会归欤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69453,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄张钦夫二首 其一","author":"杨万里","text":"作郡才佳政，留中即好音。\n还将著书手，拈出正君心。\n岳麓风霜饱，脩门雨露深。\n登庸何恨晚，廊庙要山林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69454,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄陆务观","author":"杨万里","text":"君居东浙我江西，镜里新添几缕丝。\n花落六回疏信息，月明千里两相思。\n不应李杜翻鲸海，更羡夔龙集凤池。\n道是樊川轻薄杀，犹将万户比千诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69455,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄周子充察院二首 其一","author":"杨万里","text":"乡者豺当路，如今虎在山。\n百年诸老尽，一段好风还。\n谁谓永嘉末，人犹庆历间。\n班心公定可，更可押廷班。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69456,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄周子充察院二首 其二","author":"杨万里","text":"迹远公犹记，情亲势使疏。\n忽思参研席，如许遽龙猪。\n云步知无那，文盟肯弃予。\n只哦五个字，不愈一行书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69457,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄奉新钟宰","author":"杨万里","text":"传语清心阁，欣逢诗主人。\n莺花无恙否，风月一番新。\n旧日行吟处，今来迹已陈。\n应怜杨县尹，须鬓两如银。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69458,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄贺建康留守范参政端明二首 其二","author":"杨万里","text":"一生狂杀老犹狂，只炷先生一瓣香。\n不为渠侬在廊庙，无端将相更文章。\n江南海北三千里，玉唾银钩十万行。\n早整乾坤早岩壑，石湖风月剩分张。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69459,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄贺建康留守范参政端明二首 其一","author":"杨万里","text":"寄衣不是未教归，不合威名满四夷。\n天与中兴开日月，帝分万乘半旌旗。\n春生锦绣山河早，秋到江淮草木迟。\n卧护北门期月尔，却专堂印凤凰池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69460,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄袁起岩枢密贺新除仍谢送四缣并诗集兼恳求陈婿荐书二首 其二","author":"杨万里","text":"知己熙鸿化，阳和被九皋。\n自怜今老病，无分恼钧陶。\n独念东床客，犹沉左选曹。\n春风半张纸，立地作宜敖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69461,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄袁起岩枢密贺新除仍谢送四缣并诗集兼恳求陈婿荐书二首 其一","author":"杨万里","text":"枢相身通贵，恩书意转亲。\n四端香雪縠，一卷锦江春。\n公即专堂印，侬方理钓缗。\n五公今果六，诗谶也如神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69462,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄萧仲和","author":"杨万里","text":"贫里端何好，欣然肯不居。\n诗臞将到骨，室陋得关渠。\n我懒今仍老，谁能强著书。\n谈间可无子，独判一秋虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69463,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄谢蜀帅袁起岩尚书阁学寄赠药物二首 其二","author":"杨万里","text":"抛官归隐七经年，睡杀山云笑杀天。\n剩雨残风黄帽底，颠诗中酒白鸥前。\n少年行路今已矣，厚禄故人书寂然。\n只有锦城袁阁学，寄诗赠药意悁悁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69464,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄谢蜀帅袁起岩尚书阁学寄赠药物二首 其一","author":"杨万里","text":"卧雪先生冰雪胸，小迂星履领元戎。\n草堂衣钵风骚将，花屋笙箫造化工。\n杜宇催归波正绿，海棠不睡烛斜红。\n遨头未了词头下，四世重新六五公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69465,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题八桂张松卿义庄","author":"杨万里","text":"张氏避毡裘，邢迁来桂州。\n买田同族食，作计岂孙谋。\n公艺君今是，希文古罕俦。\n荆花再连理，萱草更千秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69466,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题万安县刘元袭横秀阁","author":"杨万里","text":"玉簪成阵雪成堆，秀气横空拨不开。\n楚岫苍寒五云外，赣江白写九天来。\n烟销日出皆诗句，月色波声唤梦回。\n早晚携家过高阁，寄诗聊当一枝梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69467,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题王梾德脩知县成都新居","author":"杨万里","text":"子美百花潭北庄，君今占作咏归堂。\n山分剑阁云根瘦，江送蓬婆雪汁香。\n漱石枕流红锦浪，浮家泛宅白鸥行。\n何人夜诵相如赋，给札兰台看堵墙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69468,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题周元吉左司山居三咏 其二 可止亭","author":"杨万里","text":"金印龙章属市朝，清风明月属渔樵。\n世皆蛮触君知止，渠自王公我岂骄。\n真个归田何必赋，自家甘隐不缘招。\n老夫三径都荒了，松菊虽存已半凋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69469,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题周元吉左司山居三咏 其三 适庵","author":"杨万里","text":"莫道莼鲈不近名，尽谈鹏鴳未忘情。\n醉中赌得苕溪月，醒后还输茂苑莺。\n岂但二豪俱不见，向来三杰亦何成。\n有人来问适庵趣，便是公荣也一觥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69470,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题周元吉左司山居三咏 其一 酣赋亭","author":"杨万里","text":"诗酒如今谁主盟，须还酣赋老先生。\n三杯两盏莺花底，一斗百篇谈笑成。\n太白自翻新乐府，小蛮度入妙歌声。\n生前身后名兼饮，二事何曾有重轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69471,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题南昌尉厅思贤亭","author":"杨万里","text":"有客栖霞外，无名涴党中。\n南州一高士，东汉独清风。\n旧国已禾女，荒阡犹石翁。\n更烦吹笛魄，端为洗榛丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69472,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题郭汉卿琴堂","author":"杨万里","text":"著眼飞鸿外，欹巾韵磬边。\n半忘今古操，岂校有无弦。\n自适何须妙，能听也则贤。\n如何划然里，犹露祖生鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69473,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题萧国贤佚我堂","author":"杨万里","text":"软红尘里几时休，重碧杯中且拍浮。\n坐看痴儿夸绝足，可怜到老不回头。\n幅巾藜杖聊三径，明月清风自一丘。\n我亦年来厌奔走，梦骑野鹤访沙鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69474,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题彭泽王尉名自适廨舍二境 其一 读书岩","author":"杨万里","text":"不遇黄山谷，那传石橘林。\n岩欺小孤顶，影落大江心。\n试听秋虫语，如闻夜诵音。\n梅仙癖嗜古，此外更幽寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69475,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题彭泽王尉名自适廨舍二境 其二 潜玉洞","author":"杨万里","text":"人道书岩好，谁知石洞奇。\n外才一径尽，中忽万峰欹。\n窍石天成屋，泓泉鬼斸池。\n弘中远孙子，宴喜又添诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69476,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题曾子与竞秀亭","author":"杨万里","text":"老夫上下蓼花滩，每过君家辄系船。\n尊酒灯前山入座，孤鸿月底水连天。\n暄凉书问二千里，场屋声名三十年。\n竞秀主人文似豹，不应雾隐万峰边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69477,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题程元成给事山居三咏 其二 秀野堂","author":"杨万里","text":"梅竹来禽带月栽，牡丹菡萏照江开。\n新安见底正如此，旧雨故人从不来。\n秀色野香供雪饮，名章俊语用云裁。\n无论独乐兼同乐，盏面春风翠作堆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69478,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题程元成给事山居三咏 其三 揽有亭","author":"杨万里","text":"葵心一岫卓南涯，秀野诸峰走北来。\n中起新亭双奄有，尽驱景物四边回。\n木居士作煨尘叹，孤竹君真梁栋材。\n知有此亭无此样，并烦与可洒松煤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69479,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题程元成给事山居三咏 其一 葵心堂","author":"杨万里","text":"人笑戎葵定自痴，不愁曦景蚤兼迟。\n便令隔雾光难到，也则倾心苦为谁。\n卫足平生非我志，向阳一点只天知。\n话头试问伯休父，休父丹衷便是葵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69480,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题福帅张子仪尚书禊游堂","author":"杨万里","text":"祖孙接武禊堂前，风物重新六十年。\n无恙钧衡旧棠荫，有光台斗继蒲鞭。\n手提西郭三山月，下照南湖万顷天。\n不要外人来作记，当家自有笔如椽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69481,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题儋耳东坡故居尊贤堂太守谭景先所作二首 其二","author":"杨万里","text":"先生初落海南垂，茅屋三间不到伊。\n更有高堂悬画像，幸无过客首新诗。\n古来贤圣皆如此，身后功名属阿谁。\n底事百年谭太守，却教宾主不同时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69482,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题儋耳东坡故居尊贤堂太守谭景先所作二首 其一","author":"杨万里","text":"东坡无地顿危身，天赐黎山活逐臣。\n万里鲸波隔希奭，千年桂酒吊灵均。\n精忠塞得乾坤破，日月伴渠文字新。\n祇个短檐高屋帽，青莲未是谪仙人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69483,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"得寿仁寿俊二子书皆以病不及就试且报来期二首 其二","author":"杨万里","text":"满望鹏飞上，谁令马不前。\n草玄真浪苦，曳白亦无缘。\n兄弟年二十，尘埃路四千。\n速来饮官酒，不用一铜钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69484,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"得寿仁寿俊二子书皆以病不及就试且报来期二首 其一","author":"杨万里","text":"二子何时到，三秋欲尽头。\n收渠半张纸，洗我一年愁。\n不得毛锥力，元非子墨羞。\n海山寒更碧，整驾待同游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69485,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"得亲老家问二首 其一","author":"杨万里","text":"节里难为客，家中数有书。\n慈亲问归否，意绪各何如。\n强酒那能尽，添愁不更除。\n旧来贫未仕，父子岂相疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69486,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"得亲老家问二首 其二","author":"杨万里","text":"济世吾无策，迎亲仕屡惊。\n乾坤裂未补，簪笏达何荣。\n三径犹须禄，群飞不复情。\n山林早回首，诗酒且平生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69487,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"族人同诸友问疾二首 其二","author":"杨万里","text":"摩诘沉痾未易排，文殊一问失妖灾。\n老夫何幸群贤集，倒屣出迎双眼开。\n语造极时全愈了，病知客去即重来。\n呼儿细拣新书策，体不佳时看一回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69488,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"族人同诸友问疾二首 其一","author":"杨万里","text":"老无星事可营为，政是长闲好病时。\n两脚倦行赢得坐，一生欠睡顿还伊。\n梦闻有客欣然起，儿道勤翁乃尔痴。\n抵掌纵谈天亦笑，此身安否更曾知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69489,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚兴","author":"杨万里","text":"老来怀抱向谁开，岁晚无花荐一杯。\n处分新霜且留菊，辟差寒日早开梅。\n只教诗句清如雪，看得荣名细似埃。\n管葛诸人端解事，也曾遭我笑渠来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69490,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚过侧溪山下","author":"杨万里","text":"看山妙处几曾知，落照斜明始觉奇。\n皱尽衣裳纹欲裂，争先头角远相追。\n松梢别放六峰出，江底倒将千嶂垂。\n一路诗篇浑漫与，侧溪端的不相亏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69491,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚泊杨州","author":"杨万里","text":"杨子桥西转綵航，粉城如练是维杨。\n百年旧观兵戈后，近岁新开草木荒。\n杰阁高台云上出，野梅官柳雪中香。\n史君领客周遭看，走马归船欲夕阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69492,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚酌","author":"杨万里","text":"暑天寒果饤来馊，水果清于木果休。\n莲入新秋何便瘦，菱沉到底竟能浮。\n山泉酿酒香仍冽，野蔌堆盘爽更幽。\n方丈食前非不爱，风蝉一腹饱诗愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69493,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚寒","author":"杨万里","text":"莫道今晨热，东风未得欺。\n晚来作恶甚，寒似禁烟时。\n约雨斜还整，吹花合且离。\n不应如许峭，故故恼吾衰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69494,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚寒炽炭","author":"杨万里","text":"老子平生不附炎，雪间炉炭晚间添。\n红光乱拆银花碎，翠燄双抽柳叶尖。\n爱惜麒麟牢禁手，驱除盐絮密垂帘。\n急分一炬牵船底，岸上霜风正似镰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69495,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晨炊旱塘","author":"杨万里","text":"一岁官拘守一州，天将行役赐清游。\n青山绿水留连客，碧树丹枫点缀秋。\n夜梦昼思都是景，左来右去不胜酬。\n我无韦偃丹青手，只向囊中句里收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69496,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晨炊泊杨村","author":"杨万里","text":"沙步未多远，里名还异原。\n对江穿野店，各路入深村。\n秋水乘新汲，春芽煮不浑。\n舟中争上岸，竹里有清樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69497,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晨炊泉水塘村店无肉只卖笋蕨嘲亭父","author":"杨万里","text":"屠门深闭底须愁，土锉无烟也莫羞。\n笋便落林犹胜肉，蕨才出土更烧油。\n万钱下箸今安在，一饭流匙饱即休。\n吾道藜羹元不糁，至今讳杀古陈州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69498,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晨炊横塘桥酒家小窗","author":"杨万里","text":"饥望炊烟眼欲穿，可人最是一青帘。\n双渠走水穿三店，独树欹流荫两檐。\n窗扇透明仍挂上，炉香未烬更多添。\n山村祗苦无良酝，嫌杀芳醪似蜜甜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69499,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"望姑苏","author":"杨万里","text":"旷野平中天四垂，冻云罅里日平西。\n水村人远看来短，茅屋檐长反作低。\n最爱河堤能底巧，截他山脚不胜齐。\n喜闻借得姑苏馆，百尺高台入杖藜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69500,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"望楚州新城","author":"杨万里","text":"已近山阳望渐宽，湖光百里见千村。\n人家四面皆临水，柳树双垂便是门。\n全盛向来元孔道，杂耕今是一雄藩。\n金汤再葺真长策，此外犹须子细论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69501,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花下小饮","author":"杨万里","text":"今年春在腊前回，怪底空山早见梅。\n数点有情吹面过，一花无赖背人开。\n为携竹叶浇琼树，旋折冰葩浸玉杯。\n近节雨晴谁料得，明朝无兴也重来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69502,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梦种菜","author":"杨万里","text":"背秋新理小园荒，过雨畦丁破块忙。\n菜子已抽蝴蝶翅，菊花犹著郁金裳。\n从教芦菔专车大，早觉蔓菁扑鼻香。\n宿酒未销羹糁熟，析酲不用柘为浆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69503,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梨","author":"杨万里","text":"挂冠大谷肯干时，饤坐风流特地奇。\n骨里馨香衣不隔，胸中冰雪齿偏知。\n卖浆碎捣琼为汁，解甲方怜玉作肌。\n老子醉来浑谢客，见渠倒屣只嫌迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69504,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]