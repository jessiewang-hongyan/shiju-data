[{"title":"秋夜示儿辈","author":"陆游","text":"吴下当时薄阿蒙，岂知垂老叹途穷。\n秋砧巷陌昏昏月，夜烛帘栊袅袅风。\n缩项鳊鱼收晚钓，长腰粳米出新砻。\n儿曹幸可团栾语，忧患如山一笑空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9477,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夜纪怀三首 其一","author":"陆游","text":"缺月淡欲尽，老鸡鸣苦迟。\n聊为待旦坐，不作感秋悲。\n鲁叟一王法，豳人七月诗。\n平生经世志，老死欲谁期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9478,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夜纪怀三首 其三","author":"陆游","text":"北斗垂莽苍，明河浮太清。\n风林一叶下，露草百虫鸣。\n病入新凉减，诗从半睡成。\n还思散关路，炬火驿前迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9479,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夜纪怀三首 其二","author":"陆游","text":"瞿昙起西域，老氏奋中州。\n谈理一家说，蠹民千载忧。\n横流当有自，独立岂相仇。\n垂世诗书在，儿童勿外求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9480,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夜即事","author":"陆游","text":"鸟宿牛归户欲扃，灯前老子影伶俜。\n湿云不散初闻雁，深竹微明尚有萤。\n一卷旧书开蠹简，半升浊酒倒馀瓶。\n乘闲欲拟归来作，小草斜行满曲屏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9481,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夜泊舟亭山下","author":"陆游","text":"逢水逢山到处留，可怜身世寄孤舟。\n一汀蘋露渔村晚，十里荷花野店秋。\n羽檄未闻传塞外，金椎先报击衙头。\n煌煌太白高千丈，那得功名取次休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9482,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夜思南郑军中","author":"陆游","text":"五丈原头刁斗声，秋风又到亚夫营。\n昔如埋剑常思出，今作闲云不计程。\n盛事何由观北伐，后人谁可继西平。\n眼昏不奈陈编得，挑尽残灯不肯明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9483,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夜独过小桥观月","author":"陆游","text":"湖上萧萧叶落频，小桥东畔岸纶巾。\n乍圆素月升寒璧，欲散微云蹙细鳞。\n有酒便应遗世事，得闲随处胜官身。\n笑谈但恨朋游少，安得幽人与卜邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9484,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夜独坐闻里中鼓吹声","author":"陆游","text":"收尽浮云见素娥，青天脉脉映明河。\n时平里巷吹弹闹，岁熟人家嫁娶多。\n高会不知清夜永，散归想见醉颜酡。\n小窗灯火晶荧处，也有人赓七月歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9485,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夜独醉戏题","author":"陆游","text":"敝袍羸马遍天涯，恰似伶优著处家。\n社瓮嫩醅初泛蚁，寒缸残烬自成花。\n幽窗照影乌巾折，醉手题诗淡墨斜。\n莫恨久为峨下客，江湖归去得雄誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9486,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夜斋中二首 其一","author":"陆游","text":"木落烟深江上村，暮秋萧瑟不堪论。\n雁如著意频惊枕，月似知愁故入门。\n营道数峰新石友，广陵一曲古桐孙。\n亦知长物终安取，聊与儿曹洗睡昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9487,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夜读书有感二首 其二","author":"陆游","text":"齿发凋残志有馀，一编聊复遂吾初。\n老来每恨无同学，梦里犹曾得异书。\n家世偏憎慕青紫，儿童切莫话龙猪。\n正令世世皆农圃，廉让何妨化里闾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9488,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夜读书有感","author":"陆游","text":"鬓毛焦秃齿牙疏，老病灯前未废书。\n卷里光阴能属我，人间声利久忘渠。\n穷山藏拙犹嫌浅，粝饭支羸不愿馀。\n雨露安能泽枯朽，故人枉是费吹嘘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9489,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夜读书有感二首 其一","author":"陆游","text":"妄意斯文力弗胜，苦心犹欲付云仍。\n数编鲁壁家传学，一盏吴僧夜讲灯。\n南犬固应多吠雪，夏虫那得解知冰。\n但令吾道常无坠，饮水何妨枕曲肱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9490,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夜登千峰榭待晓","author":"陆游","text":"万里秋风夜艾时，剡川孤客不胜悲。\n读书眼暗定谁许，忧国涕零空自知。\n欲坠高梧先策策，渐低北斗正离离。\n倚阑不觉鸡号晓，剪烛题诗寄所思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9491,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夜感遇十首以孤村一犬吠残月几人行为韵 其九","author":"陆游","text":"昔遇高皇帝，同朝多伟人。\n哀哉逝不留，焄蒿返苍旻。\n存者才一二，相望不得亲。\n秋风闻雁过，老泪沾衣巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9492,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夜遣怀","author":"陆游","text":"六年归卧水云乡，本自无闲可得忙。\n羸病岂知身尚健，迂疏真与世相忘。\n霜清水落年华晚，月黑枭鸣夜漏长。\n琐琐井蛙何足计，一篇秋水笑蒙庄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9493,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋雨三首 其二","author":"陆游","text":"赤日黄尘势已穷，凄风苦雨却匆匆。\n盛衰默定见天造，寒暑密移成岁功。\n柯叶凋零无茂木，羽翰憔悴有羁鸿。\n谁知病客悲秋意，尽在空阶点滴中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9494,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋雨三首 其三","author":"陆游","text":"冷雨萧萧涩不晴，丛篁遮尽小窗明。\n故衾独展成酣寝，新酿初尝得细倾。\n壁简积阴添蠹字，床琴生润咽弦声。\n此时怀抱真难遣，一首清诗信笔成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9495,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋雨二首 其二","author":"陆游","text":"秋晚兼旬雨，雨晴当有霜。\n颇思游近县，亦已戒轻装。\n珍䱹披绵美，寒醅拨雪香。\n菊花常岁有，所喜及重阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9496,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋雨二首 其一","author":"陆游","text":"雨滴何由止，人眠不复成。\n云深无雁影，村近有砧声。\n草草残年梦，寥寥后世名。\n太山并蚁垤，俱向酒中平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9497,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋雨","author":"陆游","text":"暮秋木叶已微丹，小雨萧萧又作寒。\n目送断云归谷口，身随新雁寄江干。\n浊醪易负寻常债，退士难叨本分官。\n谢尽浮名更无事，灯前儿女话团栾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9498,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋雨三首 其一","author":"陆游","text":"剡曲高秋一草亭，雨来迨我醉初醒。\n豪吞平野宜闲望，急打虚窗入静听。\n沙上湿云号断雁，篱根衰草缀孤萤。\n老人懒复亲灯火，卧看炉香掩素屏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9499,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋雨","author":"陆游","text":"雨声疏复密，窗影暗还明。\n赤米香炊饭，青蔬淡煮羹。\n闲中长棋格，病后减诗情。\n惟有桑麻事，邻翁与细评。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9500,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋雨","author":"陆游","text":"漫道秋来雨，那无一日晴。\n只供高枕卧，不放小窗明。\n书册频开阖，山瓢任浊清。\n长年谙世味，不是故逃名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9501,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋雨","author":"陆游","text":"久占烟波弄钓舟，业风吹作凤城游。\n不知苑外芙蕖老，但见墙阴苜蓿秋。\n黄把裹书俄复至，朱颜辞镜不容留。\n晚窗又听萧萧雨，一点昏灯相对愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9502,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋雨不止排闷","author":"陆游","text":"放翁愁坐茆斋里，泥潦连村不得行。\n夜夜湿星占雨候，时时老木送秋声。\n小诗旋录兼行草，薄酒新篘任浊清。\n身世正如萍在水，略无根柢也能生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9503,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋雨中作","author":"陆游","text":"灯前剧论与谁同，中岁朋侪亦已空。\n行道敢希千载上，会心聊付一编中。\n雨侵坏甃新苔绿，秋入横林数叶红。\n莫怪又生湖海兴，此身元自是孤篷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9504,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋雨书感二首 其一","author":"陆游","text":"新舂赤米摘青蔬，一饱从来不愿馀。\n门外久无温卷客，架中宁有热官书。\n浊醪未废时时啜，短发犹须日日梳。\n自笑少年风味在，满川烟雨正愁予。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9505,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋雨书感二首 其二","author":"陆游","text":"晨起开门雪满簪，东岗一径得幽寻。\n断云残雨岁华晚，丹实碧花秋意深。\n林下已悲身老病，人间犹与俗浮沉。\n床头小瓮今朝熟，又唤邻翁共浅斟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9506,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋雨北榭作","author":"陆游","text":"秋风吹雨到江濆，小阁疏帘晓色分。\n津吏报增三尺水，山僧归入万重云。\n飘零露井无桐叶，断续烟汀有雁群。\n了却文书早寻睡，檐声偏爱枕间闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9507,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋雨初晴有感","author":"陆游","text":"炎曦赫赫尚馀威，冷雨萧萧故解围。\n号野百虫如自诉，辞柯万叶竟安归。\n芼羹菰米珍无价，上钓鲂鱼健欲飞。\n散吏何功沾一饱，高眠仍听捣秋衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9508,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋雨初霁试笔","author":"陆游","text":"墨入红丝点漆浓，闲将倦笔写秋容。\n雨声已断时闻滴，云气将归别起峰。\n斜日半穿临水竹，好风遥送隔城钟。\n远游更动轻舟兴，太息何人解见从。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9509,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋雨初霁徙倚门外有作","author":"陆游","text":"三十馀年此结庐，客来不用笑迂疏。\n前身已预兰亭会，老眼曾窥禹穴书。\n浮瓮社醅香出屋，登场秋稼穗盈车。\n萧萧蓬鬓虽衰矣，追逐乡邻尚有馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9510,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋雨益凉写兴","author":"陆游","text":"秋气萧萧暑已归，晚云更送雨霏微。\n床收珍簟敷菅席，笥叠纤絺换熟衣。\n遣醉纵横驰笔阵，乘闲谈笑解棋围。\n出门未免流年叹，又见湖边木叶飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9511,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋雨顿寒偶书","author":"陆游","text":"羁怀不醉自昏昏，卧对青灯独掩门。\n沙雁带寒来古泽，林鸠催雨暗孤村。\n数椽蟹舍偿初志，九陌尘衣洗旧痕。\n自叹一生书里活，暮年无力济黎元。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9512,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋思六首 其三","author":"陆游","text":"残暑偏能著此翁，吹襟剩喜得西风。\n露滋小径兰苕冷，月射高梁燕户空。\n衰病呻吟真一洗，醉歌跌宕与谁同。\n从今日日增幽兴，水际先丹数叶枫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9513,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋思四首 其三","author":"陆游","text":"身似庞翁不出家，一窗自了淡生涯。\n山姜零落初成子，石竹凄凉半吐花。\n寒涧挹泉供试墨，堕巢篝火唤煎茶。\n掩关本意君知否，两耳衰年不耐哗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9514,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋思六首 其六","author":"陆游","text":"药畦蔬垄夕阳中，带落冠攲一病翁。\n步蹇每妨行乐兴，眼昏几废读书功。\n露浓乍警云巢鹤，风劲先凋玉井桐。\n欲赋悲秋却休去，鬓丝已是满青铜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9515,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋思六首 其四","author":"陆游","text":"半年闭户废登临，直自春残病至今。\n帐外昏灯伴孤梦，檐前寒雨滴愁心。\n中原形胜关河在，列圣忧勤德泽深。\n遥想遗民垂泣处，大梁城阙又秋砧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9516,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋思三首 其一","author":"陆游","text":"大面山前秋笛清，细腰宫畔莫滩平。\n吴樯楚柁动归思，陇月巴云空复情。\n万里风尘旧朝士，百年铅椠老书生。\n水村渔市从今始，安用区区海内名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9517,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋思二首 其二","author":"陆游","text":"十日秋阴满径苔，蓬门那有客敲推。\n水边丹叶已如许，篱下黄花犹未开。\n空见游僧衡岳去，难逢新雁杜陵来。\n溪云一片闲舒卷，恋著渔矶不肯回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9518,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋思二首 其一","author":"陆游","text":"乌帽翩翩九陌尘，杖藜谁记岸纶巾。\n遗簪见取终安用，弊帚虽微亦自珍。\n廊庙似闻怜老病，云山渐欲属闲身。\n墙隅苜蓿秋风晚，独倚门扉感慨频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9519,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋思二首 其一","author":"陆游","text":"门巷萧条秋色深，黄花始欲慰孤斟。\n久贫自笑不妨乐，过足固知非所钦。\n琴调已忘还渐省，诗联未稳更长吟。\n吾儿西上无多日，安得相从老故林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9520,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋思四首 其一","author":"陆游","text":"秋毫不受俗尘侵，随处悠然一散襟。\n天际挂虹初断雨，云头翳日又成阴。\n引泉北涧长浇竹，拂榻西窗自斫琴。\n药石扫空身便健，始知万事要无心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9521,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋思三首 其三","author":"陆游","text":"西风吹叶满湖边，初换秋衣独慨然。\n白首有诗悲蜀道，清宵无梦到钧天。\n迂疏早不营三窟，流落今宁直一钱。\n把酒未妨馀兴在，试凭丝管饯流年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9522,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋思四首 其一","author":"陆游","text":"湖边一夜霜，庭树无秋声。\n懒不近笔砚，何以纾幽情。\n但有一睡耳，展转无由成。\n起拥地炉暖，坐待天窗明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9523,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋思六首 其二","author":"陆游","text":"一生书剑遍天涯，两岁秋风喜在家。\n烂醉日倾无算酒，高眠时听属私蛙。\n园林夕照明丹柿，篱落初寒蔓碧花。\n便拟挂冠君会否，耳根不复耐喧哗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9524,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋思三首 其二","author":"陆游","text":"巢燕成归秋景奇，颇容老子醉哦诗。\n山晴更觉云含态，风定闲看水弄姿。\n痛饮何由从次道，并游空复忆安期。\n天涯又作经年客，莫对青铜恨鬓丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9525,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋思四首 其四","author":"陆游","text":"老怀不惯著闲愁，信脚时为野外游。\n过雁未惊残月晓，片云先借一天秋。\n村醅似粥家家醉，社肉如林处处留。\n七十已稀今又过，问君端的更何求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9526,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋思四首 其二","author":"陆游","text":"雨长苍苔满钓矶，坐令秋暑敛馀威。\n天高月破残云出，野旷风惊蠹叶飞。\n终岁锄犁犹不饱，万家砧杵独无衣。\n早知竟坐儒冠误，射虎南山未必非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9527,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋思","author":"陆游","text":"一径苔侵四壁空，北窗支枕听秋钟。\n故人去后登楼怯，白发多来览镜慵。\n狂忆射麋穷楚泽，闲思钓雪泛吴松。\n相如病渴年来剧，酿酒倾家畏不供。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9528,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋思二首 其一","author":"陆游","text":"少日猖狂不自谋，即今垂死更何求。\n简编不隔圣贤面，梦寐时为河岳游。\n浊酒未倾心已醉，长歌欲发涕先流。\n石帆射的烟岚晚，过雁声中又一秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9529,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋思","author":"陆游","text":"人生四十叹头颅，久矣心知负壮图。\n未死皆为闲日月，无求尽有醉工夫。\n风凋木叶流年晚，秋入窗扉病骨苏。\n信步出门湖万顷，季鹰不用忆莼鲈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9530,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋思六首 其五","author":"陆游","text":"雁阵横空送早寒，白头病叟住江干。\n风林脱叶山容瘦，霜稻登场野色宽。\n万里关河惊契阔，一尊邻曲话悲欢。\n书生饿死寻常事，那得重弹挂壁冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9531,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋思","author":"陆游","text":"诗人本自易悲伤，何况身更忧患场。\n乌鹊成桥秋又到，梧桐滴雨夜初凉。\n江南江北堠双只，灯暗灯明更短长。\n安得平生会心侣，一尊相属送年光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9532,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋思","author":"陆游","text":"利欲驱人万火牛，江湖浪迹一沙鸥。\n日长似岁闲方觉，事大如山醉亦休。\n衣杵相望深巷月，井桐摇落故园秋。\n欲舒老眼无高处，安得元龙百尺楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9533,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋思","author":"陆游","text":"烈日炎天欲不禁，喜逢秋色到园林。\n云阴映日初萧瑟，露气侵帘已峭深。\n衰发凋零随槁叶，苦吟凄断杂疏砧。\n雁来不得中原信，抚剑何人识壮心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9534,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋思","author":"陆游","text":"鱼复城边逢雁飞，白头羁客恨依依。\n远游眼底故交少，晚岁人间乐事稀。\n云重古关传夜柝，月斜深巷捣秋衣。\n官闲况是频移疾，药鼎荧荧卧掩扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9535,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋思","author":"陆游","text":"秋来情味更堪论，身寄城南五亩园。\n委辔看山无铁獭，拾樵煎茗有青猿。\n陂塘夜雨添新涨，原野烟芜减旧痕。\n岂是平生少亲友，略无人肯访孤村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9536,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋思六首 其一","author":"陆游","text":"南郑归来二十霜，背人岁月去堂堂。\n破裘不补知寒早，倦枕无憀厌夜长。\n年少若为评宿士，狂生曾是说高皇。\n慨然此夕江湖梦，犹绕天山古战场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9537,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋思","author":"陆游","text":"黄落梧桐覆井床，莎根日夜泣寒螀。\n老生窥镜鬓成雪，俊鹘掣韝天欲霜。\n破虏谁持白羽扇，从军曾拥绿沈枪。\n壮心自笑何时豁，梦绕祁连古战场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9538,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋思二首 其二","author":"陆游","text":"霜露初侵季子裘，山川空赋仲宣楼。\n梦回最怯闻衣杵，病起常忧负酒筹。\n日月往来双转毂，乾坤成坏一浮沤。\n书生事业无多许，二寸毛锥老未休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9539,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋晓","author":"陆游","text":"菅席多年败见经，布衾木枕伴残更。\n嗈嗈天际雁初度，喔喔舍傍鸡乱鸣。\n贷米未回愁灶冷，读书有课待窗明。\n一秋最恨空阶雨，滴破羁怀是此声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9540,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋晓书感","author":"陆游","text":"天公息我半生劳，寄傲江湖亦足豪。\n淡尽月痕知夜艾，飘残桐叶喜秋高。\n读书时亦挂牛角，对酒正须持蟹螯。\n纵有故人终自绝，安能从汝望绨袍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9541,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]