[{"title":"皎皎吟","author":"朱岩伯","text":"皎皎天心月，影落寒潭水。\n虽落寒潭水，照人千万里。\n皎皎机上丝，忽落淤泥底。\n一落淤泥底，河水不可洗。\n愿君作明月，晴阴不妨缺。\n莫作淤泥丝，客子徒伤悲。\n人心皎皎莫自欺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38470,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹤林寺次岳侍郎韵","author":"朱承祖","text":"鹤林古竹院，马素旧松关。\n草合门前路，云埋寺后山。\n花神千载去，僧话片时闲。\n满壁瑰奇句，惭窥豹一斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38471,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送新知永州陈秘丞瞻赴任","author":"朱昂","text":"赴郡逢秋节，晨征思爽然。\n过桥犹见月，临水忽闻蝉。\n野色藏溪树，香风撼渚莲。\n此行君得意，千里独摇鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38472,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"涪州江心有巨石隐于深渊石傍刻二鱼古记云鱼出岁必大丰端拱元年十二月十有四日昂自瞿塘回遵途于此知郡琅琊王公□云石鱼再出来岁复稔昂往而观之果如所说因歌圣德辄成一章","author":"朱昂","text":"欲识丰年兆，扬鬐势渐浮。\n只应同在藻，无复畏吞钩。\n去水非居辙，为祥胜跃舟。\n须知明圣代，涵泳杳难俦。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38473,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题义门胡氏华林书院","author":"朱昂","text":"数峰岚翠朝昏见，一径莓苔出入疏。\n宗炳不离庐岳社，戴逵原在剡州居。\n篱边旧种千竿竹，架上新添百帙书。\n弟侄一科双折桂，不劳人问道何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38474,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"因忆灊楼读书之乐呈介甫","author":"朱明之","text":"忆昨灊楼幸久留，乾坤谈罢论雎鸠。\n它时已恨相从少，此日能忘共学不。\n南去溪山随梦断，北来身世若云浮。\n行藏愿与君同道，祇恐蹉跎我独羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38475,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"尘土呈介甫","author":"朱明之","text":"尘土纷纷起处微，祇随风力乱嘘吹。\n高张白雾横宫阙，低引轻云暗路歧。\n坐客昏蒙归耳目，行人斑白上须眉。\n谁知霶霈天飞雨，洗涤轻浮会有时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38476,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渔家傲","author":"朱服","text":"小雨纤纤风细细，万家杨柳青烟里。\n恋树湿花飞不起，愁无比，和春付与东流水。\n九十光阴能有几？\n金龟解尽留无计。\n寄语东阳沽酒市，拚一醉，而今乐事他年泪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38477,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游九锁","author":"朱杰","text":"九天虎豹不守关，瑶京夜半堕尘寰。\n化为青山故曲折，中有玉殿开仙班。\n白龙天来三百丈，飞沫直下琉璃湾。\n神仙可望不可接，桃花伴我归人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38478,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次雪峰二小诗韵 其一","author":"朱松","text":"丽日疏烟破小春，双峰秀色一番新。\n要衔天上金鸡粟，莫问人间白眼人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38479,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次雪峰二小诗韵 其二","author":"朱松","text":"同参卷裓卧云根，倒屣相迎月下门。\n大耳识君游戏处，不应觅酒向前村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38480,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"报恩寺","author":"朱松","text":"道人足迹扫尘寰，坐看筇枝上藓斑。\n豢得箨龙千尺就，却教行水绕空山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38481,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日二首 其二","author":"朱松","text":"梦和残月两朦胧，饶舌幽禽苦唤侬。\n若说五更春睡好，绝胜骑马火城中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38482,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日二首 其一","author":"朱松","text":"一雷惊起箨龙儿，戢戢满山人未知。\n急唤苍头斸烟雨，明朝吹作碧参差。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38483,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春晚二首 其二","author":"朱松","text":"客路归来芳节阑，杖藜随处小盘桓。\n危红数点藏深绿，须作春风烂熳看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38484,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春晚二首 其一","author":"朱松","text":"梅子生仁柳絮催，春风尘迹只苍苔。\n繁华一梦年年事，长是初莺为唤回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38485,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蝉","author":"朱松","text":"阴阴叶底午蝉嘶，满腹春风寄一枝。\n下有行人正愁绝，不知幽咽自缘饥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38486,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次徐谢韵还江公诗卷","author":"朱松","text":"大条祠官闲日月，绝知圣处著功深。\n荣枯举世争卢白，枉直何人较尺寻。\n身比香山差得计，诗看正始有遗音。\n应容下客游东阁，要话朱游夙昔心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38487,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春晚五言寄梦得","author":"朱松","text":"美景足可惜，残春尤不堪。\n晚英馀燕蹴，熟颗坠莺含。\n岁月蓬双鬓，生涯粟一甔。\n唯思对公瑾，把酒话江南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38488,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"樊江观梅","author":"陆游","text":"莫笑山翁老据鞍，探梅今夕到江干。\n半滩流水浸残月，一夜清霜催晓寒。\n倚醉更教重秉烛，怕寒元自怯凭栏。\n谁知携客芳华日，曾费缠头锦百端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38489,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵酬求道人","author":"朱松","text":"听君话匡庐，风月妙无价。\n垆峰忽在前，俛仰疑幻化。\n新诗未出袖，光怪炯如射。\n悬知得力处，岛可不足跨。\n家山为谁留，铛粥香䆉稏。\n我亦怀秋江，波清鸿雁下。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38490,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陈仲仁止止堂","author":"朱松","text":"以我有限景，逐彼无涯知。\n失足践畏途，投身试危机。\n舟车日奔覆，定无丘与夷。\n万古践此辙，嗟我与谁归。\n仲仁古静者，怀璧照褐衣。\n名途尝一戏，回首羞前非。\n心如得坎水，不受狂风吹。\n功名忧不免，当复定所之。\n请观本无作，今复止者谁。\n筑堂市门侧，著书园不窥。\n蓬藋深一丈，图书周四围。\n时有好事人，载酒问所疑。\n攫金奋敏手，倚市誇妍姿。\n回光时自照，何者非吾师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38491,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陈伯辨为张氏求醉宾轩诗","author":"朱松","text":"前年溪上秋风时，主人酒熟烹黄鸡。\n归来醉倒睡便著，父老唤起牛羊蹊。\n此生一醉宁易得，未辨身为贵人客。\n征西将军尔何人，那用尊前惊堕帻。\n朅来闽越再经秋，闻道轩名涎已流。\n悬知得酒推不去，此客有辖何须投。\n今我正为奔走役，空想题诗满高壁。\n若逢落魄姓回人，为问何时定相觅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38492,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陈德瑞馈新茶","author":"朱松","text":"空山冥冥云雾窗，春风好梦攲残缸。\n朝来果得故人信，微凸而么犀銙双。\n贵人争买百璎珞，此心儿女久已降。\n坐观市井起攘袂，念之使我心纷庞。\n领君此意九鼎重，虽有笔力安能扛。\n何时来施三昧手，慰我渴梦思长江。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38493,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日与卓民表陈国器步出北郊","author":"朱松","text":"灼灼桃吐华，濯濯柳垂缕。\n芳菲挽人出，春力乃如许。\n嗟予闭门客，佳节过不数。\n不因可人呼，那得幽步举。\n客如山阴胜，诗作斜川语。\n谁言一尊酒，妙处合千古。\n归来读残书，耿耿霜月苦。\n空馀流落心，三叹非吾土。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38494,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春社斋禁连雨不止赋呈梦得","author":"朱松","text":"岁丰农犹饥，岁恶何可说。\n哀哉半菽氓，罪岁同一舌。\n年时旱尘涨，腊尽不见雪。\n青皇忽雨我，万顷麦苗活。\n令尹民父母，沟壑思手挈。\n祈年祓斋禁，有酒不忍设。\n那知桃李径，狼籍香泥滑。\n芳意倏如此，坐恐及鶗鴂。\n郊原伫开晴，出劳南亩馌。\n秋成已在眼，一醉宇宙豁。\n更呼湔裙人，劝此侧帽客。\n和公斜川诗，磨石镵岁月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38495,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答林康民见和梅花诗","author":"朱松","text":"寒崦人家碧溪尾，一树江梅卧清泚。\n仙姿不受凡眼污，风敛天香瘴烟里。\n向来休沐偶无事，谁从我游二三子。\n弯埼曲径一携手，冻雀惊飞乱英委。\n班荆劝客小延伫，酌酒赋诗相料理。\n多情入骨怜风味，依倚横斜嚼冰蕊。\n至今清梦挂残月，强作短歌传素齿。\n韵高常恨句难称，赖有君诗清且美。\n天涯岁晚感乡物，归欤何时路千里。\n枕楼一笛雪漫空，回首江皋泪如洗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38496,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"酬冯退翁见示之什","author":"朱松","text":"我家大江左，江水日夜东。\n遥瞻发源处，乃在西南穷。\n相望邈异境，正北一水通。\n故令我与子，迹远心自同。\n我生寡所谐，强颜红尘中。\n倦飞矫归翮，饥吟咽寒蛩。\n独欣得吾子，万虑一笑空。\n时时出秀句，醒我如风松。\n当知山泽臞，不鄙犀角丰。\n弹冠寔伊始，此生各飞蓬。\n卜邻固未必，即事聊从容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38497,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蝶恋花 醉宿郑氏阁","author":"朱松","text":"清晓方塘开一镜。\n落絮飞花，肯向春风定。\n点破翠奁人未醒。\n馀寒犹倚芭蕉劲。\n拟托行云医酒病。\n帘卷闲愁，空占红香径。\n青鸟呼君君莫听。\n日边幽梦从来正。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38498,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答讲僧","author":"朱炎","text":"四大不须先后觉，六根还向用时空。\n难将语默呈师也，只在寻常语默中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38499,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"朱炎","text":"古人不到处，吾子独留心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38500,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送程给事知越州","author":"朱肱","text":"四官江左皆才选，去爱存怀率在民。\n使者今持丹凤诏，使君新驾两朱轮。\n旧时再访钟陵草，和气重舒泽国春。\n解橐莫为迟久计，甘泉延阁待名臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38501,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丁巳春劝农","author":"朱诜","text":"劝农小队出东禅，春事平分花柳天。\n乱石藏云苍玉洞，小溪流水紫■田。\n农忙处处扶犁雨，社近家家煮酒烟。\n野兴未厌归兴促，公馀犹拟一横鞭。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38502,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"画不如亭","author":"朱诜","text":"环绕皆山远胜滁，地无炎瘴气清虚。\n十亭留咏誇前辈，八景搜奇出故墟。\n拍岸惊涛通海道，插天峭壁壮侯居。\n烟云变态无穷极，百幅生绡画不如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38503,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"瞧阳五老会诗","author":"朱贯","text":"各还朝政遇尧年，鹤发俱宜预道冠。\n乍到林泉能放旷，全抛簪绂尚盘桓。\n君恩至重如天覆，相坐时亲畏地寒。\n九老且无元老贵，莫将西洛一般看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38504,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"入京","author":"朱南杰","text":"客怀醉杀也醒醒，昨夜思家梦几惊。\n道阻且长无信息，只将喜鹊验安平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38505,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"尹楼岩久留华亭","author":"朱南杰","text":"风雷昨夜揭窗纱，未信楼岩不忆家。\n和靖山头春到了，莫因寻鹤负梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38506,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"延陵道中即事三绝 其一","author":"朱南杰","text":"笋舆取道自吴干，东作村村喜一般。\n已拜劝农田畯赐，旧租何似放令宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38507,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"延陵道中即事三绝 其三","author":"朱南杰","text":"小立青帘卖酒家，味虽薄薄胜空茶。\n今年春满疏篱外，数朵轻红出杏花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38508,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自库入镇十二里皆山径邢侯以马相招道间口占问梅","author":"朱南杰","text":"蹇驴突兀万山间，欲雨还晴雪又悭。\n一路梅花寻不见，多应开向小溪湾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38509,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"孤山观梅","author":"朱南杰","text":"费尽年年造化功，精神全在雪霜中。\n一枝映带窗前月，消得逋仙作主翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38510,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"摄事华亭归舟口占","author":"朱南杰","text":"挈来司市正花时，补陋支倾费品题。\n顾影自惭身是客，片帆又逐晓风西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38511,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"横林遇雨 其二","author":"朱南杰","text":"雨湿桅竿风飐帆，不禁篷漏滴衣单。\n苍头更说无眠处，始信人生行路难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38512,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"横林遇雨 其一","author":"朱南杰","text":"断当篙师到锡山，片云尼我竹林间。\n短篷展转浑无寐，祇听邮铃去复还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38513,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题吴梅庵和靖索句图","author":"朱南杰","text":"童寒鹤冷雪霏霏，正是先生得句时。\n一段孤清图不尽，梅花从此厌人诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38514,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七夕呈坐间诸友时留平江宿和靖书院次日","author":"朱南杰","text":"叶已鸣秋夜渐长，年年织女会牛郎。\n龙梭暂歇七襄驾，云袖轻飘百和香。\n输我晚凉和月饮，任渠明发渡河忙。\n要知工巧元无用，乐得身闲拙不妨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38515,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书考","author":"朱南杰","text":"人说宦途好，元来是险途。\n不亲真利害，难话细工夫。\n下考初书一，中心有愧无。\n官卑何展布，三载且糊涂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38516,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"东新桥值雪","author":"朱南杰","text":"间关入帝乡，飞雪断羁肠。\n天地皆明白，山川忽老苍。\n柳眉遮旧影，梅额上新妆。\n客里急先务，湖边问短航。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38517,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出嘉兴","author":"朱南杰","text":"舟出嘉禾五里城，僧楼山塔互峥嵘。\n酒旗密比随风舞，渔网横拖漾日晴。\n画舫贵人帆去稳，单衣游女著来轻。\n山歌已接长河堰，到得临平月又明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38518,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"甲辰入京春深犹雪和吴?岩二首 其二","author":"朱南杰","text":"掀髯论时事，莫问是邪非。\n绿句池边得，青阳柳外归。\n夜深嫌薄酒，春浅怯单衣。\n门巷雪撩乱，低头且掩扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38519,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"甲辰入京春深犹雪和吴?岩二首 其一","author":"朱南杰","text":"岁事客里过，今年祇去年。\n甘贫常寂寂，知己孰拳拳。\n花艳卑崇帐，江流羡祖鞭。\n家山芳意动，野骑盍言还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38520,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"刘直孺示拙逸诗编且命著语","author":"朱南杰","text":"拙自愚中来，逸与怠相比。\n限界固分明，差忒亦容易。\n人心自有机，天下本无事。\n更参大学章，终始一诚意。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38521,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同刘朋山游湖边作","author":"朱南杰","text":"谁立西湖造化功，峰分南北境相通。\n四时风物弦歌里，两岸人家图画中。\n堤柳送迎忘尔汝，棹声来往自西东。\n风波便作恩波看，此乐君王与众同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38522,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同陈明叔游湖作","author":"朱南杰","text":"四月湖边冷若秋，先贤堂下系扁舟。\n山头积翠来新意，波面飘红忆旧游。\n无柰杨花欺倦客，已多荷叶护轻鸥。\n堤边谁道春归了，犹有一声黄栗留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38523,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"朱知镇戎服警盗不惮雪夜酒库在镇外不得与戏呈","author":"朱南杰","text":"戎装元不碍儒冠，盗贼潜窥胆自寒。\n金鼓声闻三里外，旌旗影庇四民安。\n肯从叶力多君子，愧不同盟是酒官。\n和气酿成年可卜，晓来喜见雪漫漫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38524,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟行过平江","author":"朱南杰","text":"踪迹平生马少游，功名外物等虚舟。\n不多饮酒常成醉，自在吟诗祇遣愁。\n已幸一帆离锡邑，更宽两日到杭州。\n晓来忽见盘门塔，疑是西湖大佛头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38525,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟过吴江县","author":"朱南杰","text":"寺满吴江县，钟声两岸分。\n买鱼嫌少室，沽酒欠文君。\n平地桥边浪，无心岭外云。\n篙人添德色，为策过湖勋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38526,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过长河堰","author":"朱南杰","text":"帆指长河风力微，渔舟个个有鱼归。\n一声水际笛三弄，几处梅边竹四围。\n桑伐远扬蚕事熟，花消浓艳柳绵飞。\n西湖只在钱塘外，又见孤山梅子肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38527,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿实斋侍郎王先生","author":"朱南杰","text":"崧高维岳诵生申，整顿乾坤属旧臣。\n天下安危关出处，性中存养自真纯。\n便归紫橐酬公论，已草黄麻授正人。\n天为皇家锡难老，愿将霖雨福斯民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38528,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"张玉轩南园","author":"朱南杰","text":"南园不与昔时同，绵亘规模十里通。\n万石倚山如踞虎，一亭跨水似垂虹。\n虚堂旧占梅边月，曲径新添竹外风。\n诗料满前吟不尽，主人樽酒未应空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38529,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陈梅隐求诗","author":"朱南杰","text":"旱岁走江湖，那堪又岁除。\n隐梅非活计，行李盍宁居。\n自有珠玑集，不携朝贵书。\n酬君无好语，索笑谩踌躇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38530,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和吴梅庵同登白龙对月韵","author":"朱南杰","text":"秋容满目带微寒，帆稳兰舟驾碧澜。\n照我湖光天共色，袭人花气露初乾。\n笑谈红袖日中舞，惊动苍龙水底蟠。\n最是一清无著处，却惭狼籍草杯盘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38531,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和吴?岩韵","author":"朱南杰","text":"春回笔底露潜机，为怯高吟且遁肥。\n又见牛鞭春到日，羞披鹑结旧来衣。\n雪随著处分单厚，梅不关人自密稀。\n归计商量今始定，乐哉心事看云飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38532,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"垂虹亭","author":"朱南杰","text":"凭虚螮蝀逼人寒，中有危亭百尺宽。\n天接水腰呈绝景，风回帆脚涨狂澜。\n半篙落日吟将就，一抹晴烟画亦难。\n不是酒杯今日窄，直须邀月上栏干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38533,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"林竹翁求跋","author":"朱南杰","text":"何物耐交情，林翁竹借名。\n霜严不改操，风劲镇长清。\n袖里森珠玉，胸中富甲兵。\n江湖莫相笑，已播逸民声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38534,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]