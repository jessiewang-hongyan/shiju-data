[{"title":"赵敬贤送荔枝","author":"戴复古","text":"荔子固多种，色香俱不同。\n新来尝小绿，又胜擘轻红。\n大嚼思千树，分甘仅一笼。\n尝观蔡公谱，梦想到莆中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31202,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赵端行杜子野游虎丘有诗仆因思旧与赵子野同宿唱和留题","author":"戴复古","text":"出城十里许，有此一山门。\n丘在虎无迹，池清剑有痕。\n孤松冠岩顶，万竹绕云根。\n借问东轩壁，旧题存不存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31203,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送王仲彝制机宰浏阳 其一","author":"戴复古","text":"一身供世用，六月赴官忙。\n当此炎天热，知君心地凉。\n吏能师卓鲁，县界接潇湘。\n试饮浏阳水，清清滋味长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31204,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送王仲彝制机宰浏阳 其二","author":"戴复古","text":"浏阳谁谓小，桑柘万家春。\n远宦逢知己，推心在惠民。\n速宜还县债，闻早缀朝绅。\n说与诸公道，方岩后有人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31205,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送包使君入朝除左曹郎二首 其二","author":"戴复古","text":"金门行入奏，何以告君王。\n请下求贤诏，兼陈活国方。\n解纷□□□，救弊细思量。\n若见高常簿，言予病在床。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31206,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送包使君入朝除左曹郎二首 其一","author":"戴复古","text":"宏斋儒者政，赏罚自宜民。\n世欲无公论，天知有正人。\n侧身观宇宙，平步履星辰。\n试把安危事，从头问化钧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31207,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送刘镇叔安入京谪居三山二十馀年，真西山奏令自便，赵用父使君为唱饯其行，坐客二十八人分韵赋诗，得君字","author":"戴复古","text":"二十馀年谪宦身，此行便可上青云。\n西山一手为推毂，南浦几人争送君。\n横水流传无垢集，海神惊见老坡文。\n回头莫有关情处，别酒须教满十分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31208,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送别朱兼佥","author":"戴复古","text":"恰喜相逢又语离，愁于江上送君时。\n清谈未了风吹断，白发可怜天不知。\n樗木自肥伤竹瘦，海棠偷放笑梅迟。\n黄堂若问痴顽老，新有登楼二十诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31209,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送陈幼度运干 其一","author":"戴复古","text":"台幕三年最，云霄万里程。\n西山饯行色，南浦棹新晴。\n骨秀荆山璞，胸涵元气英。\n更携扛鼎笔，祇合上蓬瀛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31210,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送陈幼度运干 其二","author":"戴复古","text":"君是青云料，吾当白发年。\n驽骀傍骐骥，鱼鸟各天渊。\n他日难忘处，寒宵不忍眠。\n挑灯雪窗下，共读雁奴篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31211,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送季明府赴太平倅 其一","author":"戴复古","text":"黄岩号难治，能者治何难。\n桃李民心悦，风霜吏胆寒。\n公行无不可，私请莫相干。\n三尺儿童辈，皆知好长官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31212,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送季明府赴太平倅 其三","author":"戴复古","text":"庭闱定省外，都是坐厅时。\n尽日身无倦，对天心不欺。\n县花潘岳赋，池草惠连诗。\n磨取九峰石，刊成德政碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31213,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送季明府赴太平倅 其四","author":"戴复古","text":"通守太平州，金陵在上头。\n风寒当一面，江□□千艘。\n此日要人物，九天宽顾忧。\n诗书用处别，澼絖换封侯。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31214,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送季明府赴太平倅 其二","author":"戴复古","text":"人说陈胡蔡，合君为四贤。\n一廉官似水，三载吏无权。\n政自诗书出，民从教化迁。\n神明判事笔，一出万人传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31215,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送赵安仁之官上虞二首 其二","author":"戴复古","text":"远庵家学在，持此去为官。\n冰雪吾身白，风霜吏胆寒。\n一心毋妄用，百姓自相安。\n贤者妙为政，谁言宰剧难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31216,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送赵安仁之官上虞二首 其一","author":"戴复古","text":"表表魁梧相，面如田字方。\n早宜朝玉陛，犹自绾铜章。\n上挹叶丞相，近瞻商侍郎。\n风流接前辈，偃室有辉光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31217,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送晓山夏肯甫入京","author":"戴复古","text":"岁月频看镜，功名一据鞍。\n勿言行路恶，有志恋家难。\n芳草客程远，落花春夜寒。\n江湖旧时梦，相逐到长安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31218,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送黄教授日岩之官章贡","author":"戴复古","text":"久矣闻名不相识，江湖还有见君时。\n出人意表发高论，入我眼中多好诗。\n欲对春风开笑口，不堪世事上愁眉。\n凭谁寄语谢安石，莫为苍生起太迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31219,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送彭司户之官三山","author":"戴复古","text":"祭酒家风重，民曹官职卑。\n公勤为己任，清白取人知。\n腊月三山雪，梅花一路诗。\n旧时来往处，今有梦相随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31220,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送湘漕赵蹈中寺丞移宪江东","author":"戴复古","text":"持节复持节，因循霜鬓侵。\n盛衰关大数，豪杰负初心。\n宇宙虚长算，江湖寄短吟。\n番阳秋水阔，湘浦未为深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31221,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送蒙斋兄长游天台二首 其二","author":"戴复古","text":"山林胜处说天台，仙佛多从此地栖。\n司马八篇通道妙，丰干一语指人迷。\n时逢好酒从容饮，莫把新诗取次题。\n白日看云思我否，惠连无分共攀跻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31222,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送蒙斋兄长游天台二首 其一","author":"戴复古","text":"方丈蓬莱去渺茫，天台祇在白云傍。\n羽衣金策群仙过，珠阁琼楼八桂香。\n采药有时逢道侣，挑包遇夜宿僧房。\n寒山拾得如相见，指点人间笑几场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31223,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送滕审言归长沙别无聊","author":"戴复古","text":"折柳亭前送故人，平沙留得马蹄痕。\n云生渡北迷行路，烟起江南认别村。\n恨不与君同上道，归来无伴自开樽。\n西楼独倚黄昏月，欲倩飞鸿寄断魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31224,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送黎明府 其二","author":"戴复古","text":"县债三年了，乡心万里飞。\n一身如许瘦，百姓不妨肥。\n买宅凭谁办，抱琴何处归。\n诸公竞推毂，稳去著朝衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31225,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"郡圃寒食","author":"戴复古","text":"与民同乐一开园，佳节何曾禁得烟。\n拍岸绿波浮舴艋，翻空红袖打鞦韆。\n眼看花柳心如醉，身在蓬瀛我亦仙。\n明日徐翁坟上约，欲求竹帚恐无缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31226,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重阳舟中","author":"戴复古","text":"扁舟何寂寞，绝不见人家。\n无处沽村酒，何从问菊花。\n溪山澹相对，节序谩云嘉。\n牢裹乌纱帽，西风日又斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31227,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"钟春伯园林","author":"戴复古","text":"西风吹起莼鲈兴，八座归来有此山。\n林麓两峰亭榭外，潇湘一片水云间。\n天生景物四时好，人满乾坤几个闲。\n语唤石屏非浪语，常思蜡屐共跻攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31228,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻边事","author":"戴复古","text":"昨日闻边报，持杯不忍斟。\n壮怀看宝剑，孤愤裂寒衾。\n风雨愁人夜，草茅忧国心。\n因思古豪杰，韩信在淮阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31229,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻机上妇说蚕事之辛勤织未成缣往往取偿债家","author":"戴复古","text":"荷君问讯蚕家事，此是妇人辛苦媒。\n典尽衣裳酬叶价，忙无心绪向妆台。\n缲声未断机声续，私债未偿官债催。\n织未成缣分剪尽，妾身争得一丝来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31230,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻严坦叔入朝再用前韵 其一","author":"戴复古","text":"凄凉风雨日，强把瓮头春。\n独守空虚室，那逢耗磨辰。\n诗家青眼旧，世路白头新。\n每诵梅花句，一心思故人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31231,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻严坦叔入朝再用前韵 其二","author":"戴复古","text":"我本江湖客，归来二月春。\n居多闭门日，未卜赏花辰。\n绕树鹊声喜，隔帘鶑语新。\n可怜垂白叟，却羡踏青人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31232,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻时事","author":"戴复古","text":"雁岂关兵气，鱼常被火灾。\n御军先择将，立国可无财。\n济世须人物，忠言是福媒。\n西山今已往，更待鹤山来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31233,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻时事","author":"戴复古","text":"昨报西师奏凯还，近闻北顾一时宽。\n淮西勋业归裴度，江右声名属谢安。\n夜雨忽晴看月好，春风渐老惜花残。\n事关气数君知否，麦到秋时天又寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31234,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻李将军至建康","author":"戴复古","text":"匹马径趋府，将军意气多。\n来依汉日月，思复晋山河。\n边将惭尸素，朝臣奏凯歌。\n分明御徂诈，得失竟如何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31235,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻杜仪甫出台","author":"戴复古","text":"台官关系重，用舍一何轻。\n诸老多惭德，斯人有直声。\n傥来视轩冕，归去即功名。\n莫拜宽堂墓，伤心隔死生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31236,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"除夜","author":"戴复古","text":"扫除茅舍涤尘嚣，一炷清香拜九霄。\n万物迎春送残腊，一年结局在今宵。\n生盆火烈轰鸣竹，守岁筵开听颂椒。\n野客预知农事好，三冬瑞雪未全消。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31237,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"倚楼","author":"戴复古","text":"贤愚不同道，用舍要知机。\n涉世有臧否，倚楼无是非。\n鸦分枯树立，雁逐断云飞。\n朝暮寻常事，何须叹落晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31238,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"借韵书怀","author":"戴复古","text":"虚气撑枯腹，长身到老贫。\n高吟常骇俗，烂醉若骄人。\n京洛繁华梦，江湖浩荡春。\n布衣如雪白，不受庾公尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31239,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"哭赵紫芝","author":"戴复古","text":"呜呼赵紫芝，其命止于斯。\n东晋时人物，晚唐家数诗。\n瘦因吟思苦，穷为宦情痴。\n忆在藏春圃，花边细话时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31240,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夏日从子渊侄借茉莉一盆","author":"戴复古","text":"举眼惊如许，衰怀强自安。\n爱凉临水坐，遣病借花看。\n物物同天地，人人各肺肝。\n从来泾与渭，混作一流难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31241,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夏日雨后登楼","author":"戴复古","text":"夏日不苦热，病躯能少康。\n数峰楼上景，六月雨馀凉。\n今古两虚器，乾坤百戏场。\n人生如寄尔，聊以醉为乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31242,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夏日续题","author":"戴复古","text":"海近朝曦赫，山明宿雾消。\n紫云萦碧落，白鹭点青苗。\n避暑轩亭爽，凭虚眼界遥。\n时来一登眺，初不待招邀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31243,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"家中作","author":"戴复古","text":"四海飘零似落花，十年秋鬓带霜华。\n归无驷马空题柱，敝尽貂裘忙到家。\n触目半成愁境界，安心旋办老生涯。\n可怜持蟹持杯手，小圃携锄学种瓜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31244,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"家居复有江湖之兴","author":"戴复古","text":"寒儒家舍只寻常，破纸窗边折竹床。\n接物罕逢人可语，寻春多被雨相妨。\n庭垂竹叶因思酒，室有兰花不炷香。\n到底闭门非我事，白鸥心性五湖傍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31245,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽大溪姚祥叔即南","author":"戴复古","text":"庆门今独盛，旧族有光华。\n日坐不欺室，天兴积善家。\n山林娱晚境，书史是生涯。\n手种堂前桂，君看身后花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31246,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽立斋杜丞相","author":"戴复古","text":"邪正不两立，国家当再兴。\n有时须有命，称德不称能。\n方喜千年遇，如何一旦薨。\n世间无哭处，吾欲哭昭陵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31247,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽沙溪项公苔湖居士 其二","author":"戴复古","text":"一曲苔湖上，深居万竹间。\n自寻三径乐，早得一身闲。\n㶁㶁循除水，林林夹屋山。\n伤心白云际，遗迹尚班班。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31248,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽沙溪项公苔湖居士 其一","author":"戴复古","text":"读书不成事，何恨老山林。\n处世有容德，与人无诤心。\n友于兄弟乐，惠彼里闾深。\n细把丰碑读，怀贤泪满襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31249,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽赵县丞","author":"戴复古","text":"雅志思行古，幽居不爱官。\n倾家为义举，竭力奉亲欢。\n阅世开天镜，藏身作瓦棺。\n闻知捐馆日，有梦跨金鞍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31250,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽赵县尉","author":"戴复古","text":"十竹相依住，一官真漫为。\n狂来裂轩冕，穷不顾妻儿。\n疾世吟孤愤，伤时赋五噫。\n高名应不朽，自作墓中碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31251,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽唐吉林咏道","author":"戴复古","text":"博雅林夫子，隐居城市中。\n家贫书甚富，学苦字尤工。\n四海交名胜，诸文辨异同。\n阿戎谈更好，端不负家风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31252,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽温岭丁竹坡","author":"戴复古","text":"潇洒复潇洒，是为丁竹坡。\n生涯浑草草，诗句自多多。\n恨不识是叟，悲哉作此歌。\n数编遗稿在，不共葬烟萝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31253,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"海上鱼西寺","author":"戴复古","text":"北风三日弭行舟，登陆因为岛寺游。\n自笑奔驰如野马，本无拘束似沙鸥。\n人谁与语自缄口，山有可观频举头。\n小雨疏烟晚来景，老僧相对倚钟楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31254,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"海月星天之观","author":"戴复古","text":"巍然华屋似凌歊，下际沧溟上九霄。\n万顷波涛浴蟾兔，一天星斗转魁杓。\n征鸿有感人飘泊，宿鹤无声夜寂寥。\n谁似风流杨叔子，登临□□□□□。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31255,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"海陵光孝长老骥无称山谷后也共谈时事且说黄岩柑橘之美","author":"戴复古","text":"俗子避形影，僧家共往还。\n高谈犯时忌，妙语发天悭。\n霜后思新橘，梦中归故山。\n何时免奔走，终老白云关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31256,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"涂中见人家卖酒","author":"戴复古","text":"连岁遭饥馑，人无籴米钱。\n今秋好行路，到处说丰年。\n村酒新篘浊，溪鱼出网鲜。\n黄花留客醉，况近竹林边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31257,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"真州上官漕劝农","author":"戴复古","text":"小队出行春，旌旗带野云。\n草成平寇檄，翻作劝农文。\n幕府多奇士，诗书策异勋。\n请将边上事，一一奏明君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31258,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"真西山帅长沙祷雨 其二","author":"戴复古","text":"出郭问农事，家家笑语声。\n有田皆足水，既雨亦宜晴。\n山下溪流急，街头米价平。\n明朝闻领客，相见贺秋成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31259,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"真西山帅长沙祷雨 其一","author":"戴复古","text":"太守持斋戒，精诚动九天。\n骄阳变霖雨，凶岁转丰年。\n信是经纶手，行司造化权。\n唐时相房杜，斗米直三钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31260,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"聂侍郎领客观园林之胜饮中出示名贤书画","author":"戴复古","text":"烈士家风从橐尊，时容野客上朱门。\n如登东观图书府，又似西岩水竹村。\n自以一闲销日月，谁知万虑满乾坤。\n诸公衮衮成何事，不若花前对酒樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31261,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"莆中遇方□□邀出城买蛎而饮一僧同行","author":"戴复古","text":"出郭断虹雨，倚楼新雁天。\n三杯古榕下，一笑菊花前。\n入市子鱼贵，堆盘牡蛎鲜。\n山僧惯蔬食，清坐莫流涎。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31262,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"袁州化成岩李卫公谪居之地","author":"戴复古","text":"一岩端坐挹千峰，三两亭台胜概中。\n江水骤生连夜雨，松声吹下半天风。\n因思世故吾头白，独步林皋夕照红。\n欲吐草茅忧国志，谁能唤起赞皇公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31263,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诸侄孙登白峰观海上一景","author":"戴复古","text":"自有此山在，无人作此游。\n气吞云海浪，笑撼玉峰秋。\n开辟几百载，登临第一筹。\n诸郎莫高兴，刻石记风流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31264,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诸诗人会于吴门翁际可通判席上高菊涧有诗仆有客星聚吴会诗派落松江之句方子万使君喜之遂足成篇","author":"戴复古","text":"客星聚吴会，诗派落松江。\n老眼洞千古，旷怀开八窗。\n风流谈夺席，歌笑酒盈缸。\n杨陆不再作，何人可受降。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31265,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诸葛仁叟县丞极贫能保风节有权贵招之不屑其行","author":"戴复古","text":"时人谁识老聋丞，满口常谈杜少陵。\n俗辈众多吾辈少，素交零落利交兴。\n权门炙手炎如火，诗社投身冷似冰。\n堪笑皇天无老眼，相知赖有竹林僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31266,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读三学士人论事三书 其二","author":"戴复古","text":"黄屋见闻远，朱门富贵忙。\n屠沽思报国，樵牧解谈王。\n能转祸为福，毋令圣作狂。\n草茅垂白叟，尚拟见时康。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31267,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]