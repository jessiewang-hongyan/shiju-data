[{"title":"天台院有小阁下临官道予为名曰玉霄","author":"陆游","text":"竹舆冲雨到天台，绿树阴中小阁开。\n榜作玉霄君会否，要知散吏按行来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4529,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"天竺晓行二首 其二","author":"陆游","text":"笋舆咿轧水云间，惭愧忙身得暂闲。\n堪笑风中一黄叶，知看天外几青山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4530,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"天竺晓行二首 其一","author":"陆游","text":"三茆听彻五更钟，二竺穿穷九里松。\n无复官楼沽酒美，但烦湖水照衰容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4531,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"天祺节日饭罢小憩","author":"陆游","text":"卧听午漏隔花传，帘里花残有断烟。\n莫放辘轳鸣玉井，偷闲要补五更眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4532,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"太古","author":"陆游","text":"太古安知虙与尧，茹毛饮血自消摇。\n不须追咎为书契，初结绳时俗已浇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4533,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"太平花","author":"陆游","text":"扶床踉蹡出京华，头白车书未一家。\n宵旰至今劳圣主，泪痕空对太平花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4534,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"太息三首 其三","author":"陆游","text":"北陌东阡有故墟，辛勤见汝昔营居。\n豪吞暗蚀皆逃去，窥户无人草满庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4535,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"太息三首 其一","author":"陆游","text":"太息贫家似破船，不容一夕得安眠。\n春忧水潦秋防旱，左右枝梧且过年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4536,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"太息四首 其三","author":"陆游","text":"自古才高每恨浮，伟人要是出中州。\n即今未必无房魏，埋没胡沙死即休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4537,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"太息四首 其一","author":"陆游","text":"早岁元于利欲轻，但馀一念在功名。\n白头不试平戎策，虚向江湖过此生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4538,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"太息三首 其二","author":"陆游","text":"祷庙祈神望岁穰，今年中熟更堪伤。\n百钱斗米无人要，贯朽何时发积藏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4539,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"太息","author":"陆游","text":"闲将白发照清沟，太息年光逝不留。\n勋业无期著书晚，此生与世判悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4540,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"太息四首 其二","author":"陆游","text":"书生忠义与谁论，骨朽犹应此念存。\n砥柱河流仙掌日，死前恨不见中原。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4541,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"巴东遇小雨二首 其二","author":"陆游","text":"西游万里亦何为，欲就骚人乞弃遗。\n到此宛然诗不进，始知才分有穷时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4542,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"巴东遇小雨二首 其一","author":"陆游","text":"暂借清溪伴钓翁，沙边微雨湿孤蓬。\n从今诗在巴东县，不属灞桥风雪中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4543,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"忆天彭牡丹之盛有感","author":"陆游","text":"常记彭州送牡丹，祥云径尺照金盘。\n岂知身老农桑野，一朵妖红梦里看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4544,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"忆昨三首 其一","author":"陆游","text":"入蜀还吴迹已陈，兰亭道上又逢春。\n诸君试取吾诗看，何异前身与后身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4545,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"忆昨三首 其二","author":"陆游","text":"当年落魄锦江边，物外常多宿世缘。\n先主庙中逢市隐，丈人观里识巢仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4546,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"忆昨三首 其三","author":"陆游","text":"万里曾为汗漫游，岂知白首弄渔舟。\n会骑一鹤凌风去，何处人间无酒楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4547,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"文君井","author":"陆游","text":"落魄西州泥酒杯，酒酣几度上琴台。\n青鞋自笑无羁束，又向文君酒畔来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4548,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"文章","author":"陆游","text":"文章在眼每森然，力弱才疏挽不前。\n前辈不生吾辈老，恐留遗恨又千年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4549,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"无题","author":"陆游","text":"碧玉当年未破瓜，学成歌舞入侯家。\n如今憔悴蓬窗里，飞上青天妒落花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4550,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"无题二首 其一","author":"陆游","text":"半醉凌风过月旁，水精宫殿桂花香。\n素娥定赴瑶池宴，侍女皆骑白凤凰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4551,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"无题二首 其二","author":"陆游","text":"出茧修眉淡薄妆，丁东环佩立西厢。\n人间浪作新秋感，银阙琼楼夜夜凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4552,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"日用四首 其一","author":"陆游","text":"旧好疏毛颖，新知得曲生。\n幽居无一事，枕臂听松声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4553,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"日用四首 其二","author":"陆游","text":"舂谷灌园蔬，日长闲有馀。\n何妨忍挥汗，合药施乡闾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4554,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"日暮","author":"陆游","text":"朴学无关道废兴，更堪衰与病相乘。\n眼看白日西南去，绳系胶黏总不能。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4555,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"月下","author":"陆游","text":"月白庭空树影稀，鹊栖不稳绕枝飞。\n老翁也学痴儿女，扑得流萤露湿衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4556,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"月夜","author":"陆游","text":"小醉初醒月满床，玉壶银阙不胜凉。\n天风忽送荷香过，一叶飘然忆故乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4557,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"月岩","author":"陆游","text":"几年不作月岩游，万里重来已白头。\n云外连娟何所似，平羌江上半轮秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4558,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"比从人觅酒皆酸薄戏作此诗","author":"陆游","text":"酒尽聊凭折简求，不知人要博凉州。\n墙隅弃置空三叹，露下萤飞奈此秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4559,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水亭二首 其二","author":"陆游","text":"莫道山翁老病侵，静中理得旧传琴。\n朝来有喜君知否，雨展芭蕉二尺心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4560,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水亭二首 其一","author":"陆游","text":"水亭不受俗尘侵，葛帐筠床弄素琴。\n一片风光谁画得，红蜻蜓点绿荷心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4561,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王子猷谓竹为此君白乐天谓酒为此君余野处无客每对竹独酌得小诗","author":"陆游","text":"新种疏篁对小轩，旋沽薄酒实空尊。\n门无车辙亦何恨，有此两君堪与言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4562,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"见蜂采桧花偶作","author":"陆游","text":"来禽海棠相续开，轻狂蛱蝶去还来。\n山蜂却是有风味，偏采桧花供蜜材。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4563,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"见鹊补巢戏作","author":"陆游","text":"卧看衔枝鹊补巢，方知此老懒堪嘲。\n山村四十馀年住，未省曾添一把茅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4564,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"长溪东山容老索月谷幽赏诗二首 其一 月谷","author":"陆游","text":"人间底处无明月，只看青山为发挥。\n林里枝寒无鹊立，水边路白有僧归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4565,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"风云交作戏题","author":"陆游","text":"云脚如龙爪，空中挟雨来。\n何关风伯事，欲到却吹回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4566,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"风月","author":"陆游","text":"镜中日日鬓毛衰，八十还思七十时。\n风月不知人意绪，酒醒梦断又催诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4567,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"风雨","author":"陆游","text":"风摇北斗柄欲折，雨溢天河浪正生。\n一盏昏灯北窗下，腐儒未辍读书声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4568,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东冈樱桃已过殊不知","author":"陆游","text":"病著寒侵怕出门，萧萧烟雨暗江村。\n一樽阙与梅花别，过尽樱桃不足言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4569,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东关二首 其一","author":"陆游","text":"天华寺西艇子横，白蘋风细浪纹平。\n移家只欲东关住，夜夜湖中看月生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4570,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东阳观酴醾","author":"陆游","text":"福州正月把离杯，已见酴醾压架开。\n吴地春寒花渐晚，北归一路摘香来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4571,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东阳郭希吕吕子益送酒","author":"陆游","text":"山崦寻香得早梅，园丁又报水仙开。\n独醒坐看儿孙醉，虚负东阳酒担来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4572,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东阳道中","author":"陆游","text":"风攲乌帽送轻寒，雨点春衫作碎斑。\n小吏知人当著句，先安笔砚对溪山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4573,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东村二首 其一","author":"陆游","text":"野人知我出门稀，男辍锄耰女下机。\n掘得茈菇炊正熟，一杯苦劝护寒归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4574,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东村二首 其二","author":"陆游","text":"野人喜我偶闲游，取酒匆匆劝小留。\n舍后携篮挑菜甲，门前唤担买梨头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4575,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东轩","author":"陆游","text":"榴花零落满苍苔，薝卜忘忧亦已开。\n湖海片帆先已具，少安无躁待秋来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4576,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东偏纸阁初成","author":"陆游","text":"蚍蜉占雨解移穴，蟋蟀畏寒先近床。\n我亦联屏为燠室，一冬省火又宜香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4577,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东窗四首 其二","author":"陆游","text":"才薄常为世俗轻，还山力不给躬耕。\n即今赢得都无事，袖手东窗听雨声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4578,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东窗","author":"陆游","text":"萱草石榴相续开，数枝晚笋破苍苔。\n背人红练穿林去，直是无情不再来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4579,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东窗四首 其一","author":"陆游","text":"九折危途寸步艰，至今回首尚心寒。\n元来自有安身处，茆屋三间似海宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4580,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东窗四首 其三","author":"陆游","text":"俗事纷纷意不摅，兀如头垢念爬梳。\n东窗且复焚香坐，闲看微云自卷舒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4581,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东窗四首 其四","author":"陆游","text":"寂寂东窗午梦残，更堪春雨作春寒。\n蛮童未报煎茶熟，一卷南华枕上看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4582,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"仗锡平老具舟车迎前天衣印老印悉遣还策杖访之作二绝句奉送兼简平 其一","author":"陆游","text":"画舫篮舆不许前，白头行脚意超然。\n舜江禹穴千山水，尽在高人拄杖边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4583,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"仙鱼铺得仲高兄书","author":"陆游","text":"病酒今朝载卧舆，秋云漠漠雨疏疏。\n阆州城北仙鱼铺，忽得山阴万里书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4584,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"仙游阁","author":"陆游","text":"张公一去二百载，杰阁依然横霭中。\n徙倚看碑仍看画，时闻柏子落秋风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4585,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代邻家子作","author":"陆游","text":"社日淋漓酒满衣，黄鸡正嫩白鹅肥。\n弟兄相顾无涯喜，扶得吾翁烂醉归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4586,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"兰亭道上四首 其一","author":"陆游","text":"湖上青山古会稽，断云漠漠雨凄凄。\n篮舆晚过偏门市，满路春泥闻竹鸡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4587,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"兰亭道上四首 其二","author":"陆游","text":"兰亭步口水如天，茶市纷纷趁雨前。\n乌笠游僧云际去，白衣醉叟道傍眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4588,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"兰亭道上四首 其三","author":"陆游","text":"陌上行歌日正长，吴蚕捉绩麦登场。\n兰亭酒美逢人醉，花坞茶新满市香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4589,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"兰亭道上四首 其四","author":"陆游","text":"箭箙弓韬小猎回，壮心自笑未低摧。\n前身家近盘阊路，曾看吴王射雉来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4590,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬初出游二首 其二","author":"陆游","text":"蹇驴渺渺涉烟津，十里山村发兴新。\n青旆酒家黄叶寺，相逢俱是画中人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4591,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬初出游二首 其一","author":"陆游","text":"风声如雨晓飕飗，万叶丹枫满瓦沟。\n西望牛头三十里，一枝柔橹作闲游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4592,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬夜听雨戏作二首 其二","author":"陆游","text":"绕檐点滴如琴筑，支枕幽斋听始奇。\n忆在锦城歌吹海，七年夜雨不曾知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4593,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬夜听雨戏作二首 其一","author":"陆游","text":"少年交友尽豪英，妙理时时得细评。\n老去同参惟夜雨，焚香卧听画檐声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4594,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬夜炉边小饮","author":"陆游","text":"拥炉可使曲身直，饮酒能回槁面红。\n若使金丹真入手，飞腾亦在立谈中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4595,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬夜闻角声二首 其一","author":"陆游","text":"袅袅清笳入雪云，白头老守卧中军。\n自怜到死怀遗恨，不向居延塞外闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4596,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬夜闻角声二首 其二","author":"陆游","text":"忆在梁州夜雪深，落梅声里玉关心。\n山城老去功名忤，卧对寒灯泪满襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4597,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬夜读书示子聿八首 其二","author":"陆游","text":"易经独不遭秦火，字字皆如见圣人。\n汝始弱龄吾已耄，要当致力各终身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4598,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬夜读书示子聿八首 其一","author":"陆游","text":"宦途至老无馀俸，贫悴还如筮仕初。\n赖有一筹胜富贵，小儿读遍旧藏书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4599,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬夜读书示子聿八首 其七","author":"陆游","text":"读书万卷不谋食，脱粟在傍书在前。\n要识从来会心处，曲肱饮水亦欣然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4600,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬夜读书示子聿八首 其四","author":"陆游","text":"简断编残字欲无，吾儿不负乃翁书。\n绝胜锁向朱门里，整整牙签饱蠹鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4601,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬夜读书示子聿八首 其八","author":"陆游","text":"世间万事有乘除，自笑羸然七十馀。\n布被藜羹缘未尽，闭门更读数年书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4602,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬夜读书示子聿八首 其五","author":"陆游","text":"圣师虽远有遗经，万世犹传旧典刑。\n白首自怜心未死，夜窗风雪一灯青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4603,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬夜读书示子聿八首 其六","author":"陆游","text":"残雪初消荠满园，糁羹珍美胜羔豚。\n吾曹舌本能知此，古学工夫始可言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4604,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬夜读书示子聿八首 其三","author":"陆游","text":"古人学问无遗力，少壮工夫老始成。\n纸上得来终觉浅，绝知此事要躬行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4605,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬夜读书有感二首 其二","author":"陆游","text":"胸中十万宿貔貅，皂纛黄旗志未酬。\n莫笑蓬窗白头客，时来谈笑取幽州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4606,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬夜读书有感二首 其一","author":"陆游","text":"一指头禅用不穷，一刀匕药去凌空。\n汗牛充栋成何事，堪笑迂儒错用功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4607,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]