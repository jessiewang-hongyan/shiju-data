[{"title":"极相思令/极相思","author":"太尉夫人","text":"柳烟霁色方春。\n花露逼金茎。\n秋千院落，海棠渐老，才过清明。\n嫩玉腕托香脂脸，相傅粉、更与谁情。\n秋波绽处，相思泪迸，天阻深诚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九疑山","author":"无名氏","text":"溪山相似路人疑，众目详观固易知。\n厚貌深情怀险阻，离朱子羽谩扬眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二疏","author":"无名氏","text":"贤者多财应损智，愚而殖货易生嗔。\n二疏教子无他祝，愿向先畴加苦辛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三鸦镇题壁","author":"无名氏","text":"二年憔悴在三鸦，无米无钱怎养家。\n每日两餐唯是藕，看看口里出莲花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"义试诗 孔明草庐图","author":"无名氏","text":"南阳高卧屈将军，往事流传水墨昏。\n莫讶轴闲茅屋小，个中藏得汉乾坤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"义试诗 葡萄月","author":"无名氏","text":"春藤上架翠成窝，颗颗圆光得月多。\n疑是蕊珠开夕宴，结成珠帐待常娥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":76,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小桃源","author":"无名氏","text":"绰约去朝真，仙源万木春。\n要知窃桃客，定是会稽人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"月儿弯弯照九州","author":"无名氏","text":"月儿弯弯照九州，几家欢乐几家愁。\n几家夫妇同罗帐，几家飘零在外头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"讥贾平章","author":"无名氏","text":"戎马掀天动地来，襄阳城下哭声哀。\n平章束手全无策，却把科场恼秀才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":79,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仙迹岩题诗二十三首 其一 三清殿","author":"无名氏","text":"虚无混沌未分前，大道元居太极先。\n自一而三同祖气，澄清高上积阳天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":80,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仙迹岩题诗二十三首 其二十三 飞玉亭","author":"无名氏","text":"闲亭清憩觉情优，四顾岚光景色幽。\n湍玉飞帘侵座冷，璇源本自接天流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":81,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仙迹岩题诗二十三首 其十五 云根石","author":"无名氏","text":"一片轮囷迹严存，无心出岫瑞腾坤。\n不随风雨轻舒卷，触石凝然正性根。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":82,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仙迹岩题诗二十三首 其十六 天柱泉","author":"无名氏","text":"大涤之西一穷生，源高樵者只闻声。\n汲泉烹茗多甘味，内隐丹砂赤更清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":83,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仙迹岩题诗二十三首 其五 方丈后聚仙亭","author":"无名氏","text":"高敞山斋立乳巅，飘飖云驭聚群仙。\n百灵听讲开坛夜，大法将临报语宣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":84,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仙迹岩题诗二十三首 其十九 龙井","author":"无名氏","text":"鲮鳗环绕井楯间，两目神光状类丹。\n杖扑投渊阴雾锁，殿堂汹涌尽波澜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":85,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仙迹岩题诗二十三首 其二 佑圣殿","author":"无名氏","text":"挺锋镇北阐威权，剪伐魔精正法宣。\n化育黎民臻大道，安宁家国享长年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":86,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仙迹岩题诗二十三首 其十七 冷泉","author":"无名氏","text":"琳宫门外小桥东，石罅泉流细脉通。\n清似玉壶承沆瀣，游人掬饮凛生风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":87,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仙迹岩题诗二十三首 其十二 张真君祠","author":"无名氏","text":"圣像迁祠出禁扃，天恩遣使从神灵。\n奉安钦敬祈民福，应感昭彰佑帝庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":88,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仙迹岩题诗二十三首 其八 昊天殿","author":"无名氏","text":"游幸名山德寿存，鼎新大殿显仁恩。\n玉圭物物皆珍异，安奉严恭玉帝尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":89,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仙迹岩题诗二十三首 其十四 经阁","author":"无名氏","text":"宝阁庄严金玄耀，风铃震响玉丁东。\n甍飞杰出青霄上，道典珍藏在此中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":90,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仙迹岩题诗二十三首 其二十一 采芝朮即事","author":"无名氏","text":"仙芝灵朮总芳妍，野草闲花各变迁。\n古栎复荣松化石，药苗蕃植可延年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":91,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仙迹岩题诗二十三首 其十一 钟楼","author":"无名氏","text":"重楼高耸丹霄外，深夜声摩碧落中。\n神通无量鸿音远，永镇名山有显功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":92,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仙迹岩题诗二十三首 其三 斋堂","author":"无名氏","text":"辨道焚修练性根，应时粥饭益真元。\n斋馀有报君恩重，寿祝无疆帝道尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":93,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仙迹岩题诗二十三首 其二十二 祥光亭","author":"无名氏","text":"覆石为亭武肃成，有仙来此变棋枰。\n炷香五色祥光现，缥缈灵官朝玉京。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":94,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仙迹岩题诗二十三首 其六 道院","author":"无名氏","text":"幽栖枹朴古先精，宴坐参同元化并。\n一炷清香腾瑞霭，云端时透步虚声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":95,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仙迹岩题诗二十三首 其四 演教堂","author":"无名氏","text":"参稽道德本无言，不二门开阐古先。\n多谢师尊传演教，要令后学悟真诠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":96,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仙迹岩题诗二十三首 其七 精思道院","author":"无名氏","text":"精思名扁列金题，冲素斋居与道齐。\n德感天仙来听论，芝軿时降共参稽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":97,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仙迹岩题诗二十三首 其十 翠蛟亭","author":"无名氏","text":"湍激清泉舞翠蛟，幽亭跨涧对岩坳。\n我来憩此观嘉趣，一洗尘襟凡世抛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":98,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仙迹岩题诗二十三首 其九 璇玑殿","author":"无名氏","text":"众圣环拱位中天，统济乾坤妙转旋。\n高覆昆崙朝帝阙，注生回死福增延。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":99,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"归州竹枝词","author":"无名氏","text":"人鲊瓮头波放颠，两岸青山青插天。\n篙师力尽客破胆，茅屋老翁方醉眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":100,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"白鹤观题壁","author":"无名氏","text":"仙人未必皆仙去，还在人间人不知。\n手把白髦从两鹿，相逢聊问姓名谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":101,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"兴化沙溪驿题壁","author":"无名氏","text":"沙溪祇是旧沙溪，今日重来路欲迷。\n独有暮鸦知我意，白云深处尽情啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":102,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题织锦璇玑图 其五","author":"孔平仲","text":"前堂画烛残凝泪，半夜清香旧惹衾。\n烟锁竹枝寒宿鸟，水沉天色霁横参。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":103,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"回文 其二","author":"无名氏","text":"红手素丝千字锦，故人新曲九回肠。\n风吹絮雪愁萦骨，泪洒缣书恨见郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":104,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"何侯洞","author":"无名氏","text":"何氏因韩姓始传，无由与舜共升天。\n洞前九井皆湮没，唯有荆榛绕庙壖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":105,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初夏 其三","author":"赵葵","text":"樱笋方夭麦报秋，梅黄雨过水平畴。\n春归欲带春风韵，枝上一声黄栗留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":106,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"别题","author":"无名氏","text":"休说三江与五湖，平生心眼此中舒。\n人人总道浑如画，祇恐丹青画不如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":107,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"含笑花","author":"徐玑","text":"薄薄沈熏骨，英英玉炼颜。\n恼人风味别，斗帐梦中閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":108,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"咏古树","author":"无名氏","text":"四围乔木尽儿孙，曾见吴宫几度春。\n若使当年成大厦，也应随例作灰尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":109,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"斩蛇","author":"无名氏","text":"皇统承尧运，朱旗启汉家。\n未诛秦始鹿，先斩沛中蛇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":110,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"油污衣","author":"无名氏","text":"一点清油污白衣，斑斑駮駮使人疑。\n纵饶洗遍千江水，争似当初不污时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":111,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金鳌山善际寺题壁","author":"无名氏","text":"黄帽当年驾舳舻，东浮鲸海出三吴。\n中兴事业风波恶，好作君王坐右图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":112,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"钓台题壁","author":"无名氏","text":"生涯千顷水云宽，舒卷乾坤一钓竿。\n梦里偶然伸只脚，渠知天子是何官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":113,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"孩儿花","author":"无名氏","text":"纤秾初见似娇痴，鼓舞春风二月时。\n何事自开还自落，可怜造化亦儿嬉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":114,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宣圣墓","author":"无名氏","text":"灵光殿古生秋草，曲阜城荒噪晚鸦。\n惟有孔林残照里，至今犹属仲尼家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":115,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词十首 其九","author":"卢秉","text":"蓬莱风蹙水纹斑，月甃风廊四百间。\n云外跸声穿岭去，行宫簇马望骊山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":116,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词十首 其八","author":"卢秉","text":"迎春新燕尾纤纤，拂柳穿花掠翠檐。\n问道蕊宫三十六，美人争为卷珠帘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":117,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春 其二","author":"赵葵","text":"绿竹移阴抹画墙，倚栏红药殿春光。\n风开帘幕催香篆，坐听莺声春昼长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":118,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春 其三","author":"赵葵","text":"点点残红缬燕泥，画堂春暖日初迟。\n绿杨影里莺声碎，正是南窗梦觉时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":119,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春兴 其一","author":"白玉蟾","text":"草根未放晓霜稀，骤冷初暄蝶倦飞。\n行到碧桃花下看，新花良是旧枝非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":120,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春晚行乐 其一","author":"白玉蟾","text":"一点春山一点愁，一丝暮雨一声鸠。\n病中况更缘诗苦，夜去可堪无酒休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":121,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵王御带","author":"白玉蟾","text":"晓风吹醒桃花醉，暮雨添成柳叶愁。\n醉了又愁愁又醉，莺煎燕?过春休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":122,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春暮","author":"无名氏","text":"此春眼不到湖山，过了春光只等闲。\n愿有东君相管领，时收花絮入帘看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":123,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春暮","author":"无名氏","text":"三月湖天春昼长，东风飘暖草浮光。\n樱桃熟后游人倦，柳絮飞时燕子忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":124,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"海棠","author":"赵葵","text":"依依杨柳已藏鸦，风度莺声到碧纱。\n洗尽春光连夜雨，海棠赢得两三花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":125,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春暮","author":"无名氏","text":"麦髯豆荚雨生肥，闲绿园林粉蝶飞。\n剩置好花安四壁，不教人道是春归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":126,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春晚 其一","author":"方岳","text":"一樽无计遣春留，落日伤情独倚楼。\n柔绿拍堤如可染，老红满径为谁愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":127,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闺怨","author":"无名氏","text":"有约未归蚕结局，小轩空度牡丹春。\n夜来拣尽鸳鸯茧，留织春衫寄远人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":128,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"项羽庙灾","author":"无名氏","text":"嬴秦久矣酷斯民，羽入关中又火秦。\n父老莫嗟遗庙毁，咸阳三月是何人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":129,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"栖云阁","author":"无名氏","text":"倚天危阁贴重冈，细路萦纡石磴长。\n曲涧碧流疏宿雨，夹山红叶助斜阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":130,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥观","author":"无名氏","text":"昔设黄婆旧酒垆，如何今日似蓬壶。\n只因王郭仙人过，化作青城上帝都。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":131,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄家书","author":"无名氏","text":"南轩北牖又东扉，取次园林待我归。\n当路莫栽荆棘草，他年免挂子孙衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":132,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"望仙花","author":"无名氏","text":"风捲珠帘挂玉钩，綵云开处望仙俦。\n妍姿不逐东君去，日照斜晖上小楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":133,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"象耳山","author":"无名氏","text":"篮舆来自石苍路，喜得幽人陪杖屦。\n应是山灵泽旱苗，不关居士随轩雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":134,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寒亭","author":"无名氏","text":"朔风凛凛雪漫漫，未是寒亭分外寒。\n六月火云天不雨，请君来此凭阑干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":135,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"禽言二首 其二 著新脱故","author":"无名氏","text":"蚕茧方成四月初，鸟能早计巧相呼。\n谁知机杼声才息，已有王官来索租。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":136,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"禽言二首 其一 子规","author":"无名氏","text":"刚道故乡如许好，其如游子不归何。\n自从五柳先生死，空染千山泪血多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":137,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舒州下寨驿题壁","author":"无名氏","text":"北堂无老信来稀，十载秋风雁自飞。\n今日满头生白发，千山乡路为谁归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":138,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"翠微峰","author":"无名氏","text":"洞里乾坤世莫知，时闻啸鹤带云归。\n几回洞口乘风立，欲挟飞仙入翠微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":139,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"嘲张师雄","author":"无名氏","text":"昨夜阴山贼吼风，帐中惊起蜜翁翁。\n平明不待全师出，连著皮裘入土空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":140,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"嘲林洪","author":"无名氏","text":"和靖当年不娶妻，只留一鹤一童儿。\n可山认作孤山种，正是瓜皮搭李皮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":141,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送别","author":"左纬","text":"骑马出门三月暮，杨花无赖雪漫天。\n客情惟有夜难过，宿处先寻无杜鹃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":142,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题太行山石壁","author":"无名氏","text":"太行千里连芳草，独酌一杯天地小。\n醉卧花间人不知，黄莺啼破春山晓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":143,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题刘武僖题名后","author":"无名氏","text":"一入侯门海样深，漫留名字恼行人。\n夜来彷佛高唐梦，犹恐行云意未真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":144,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题严陵钓台","author":"无名氏","text":"范蠡忘名载西子，介推逃迹累山樊。\n先生政尔无多事，聊把渔竿坐水村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":145,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题岳阳飞吟亭","author":"无名氏","text":"觅官千里赴神京，钟老相传盖更倾。\n未必无心唐事业，金丹一粒误先生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":146,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题采石蛾眉山","author":"无名氏","text":"一岛烽烟斡怒流，燃犀捉月两悠悠。\n蛾眉中划三千丈，不著人间半点愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":147,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题峻极中院法堂壁","author":"无名氏","text":"一团茅草乱蓬蓬，蓦地烧天蓦地空。\n争似满炉煨榾?，慢腾腾地热烘烘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":148,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题鸳鸯浦溆图","author":"无名氏","text":"睡足鸳鸯各欲飞，水花攲岸两三枝。\n多情公子因乘兴，写出江春日暖时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":149,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]