[{"title":"咏西湖十洲 松岛","author":"刘珵","text":"耻随杨柳娇春色，厌近芙蕖透暗香。\n直干凌霜终偃蹇，愿为一柱壮明堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50574,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题虎丘次蒲章二公韵","author":"刘淑","text":"衮席频虚未赐环，游心暂寄水云间。\n霓旌初下姑苏苑，蜡屐先寻虎踞山。\n高兴不辞溪路险，幽情更羡野僧闲。\n留连景物慵回首，画舫寒侵暮角还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50575,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再至新定有感","author":"岑象求","text":"蜀地吴天各一涯，去来三纪亦云赊。\n乌龙绕郭俨如旧，白发满头良可嗟。\n老矣不堪多感慨，使乎何处是光华。\n周行历览犹疑梦，更问庭槠几度花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50576,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏县厅前古槠木","author":"岑象求","text":"三十年前宰一同，朝朝相对此庭中。\n如今翠叶樛枝好，依旧朱栏戒石东。\n潘岳河阳花立尽，陶潜彭泽柳随空。\n唯君独负坚刚操，何异灵椿与夏虫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50577,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"涤虑轩","author":"岑象求","text":"圣人重洗心，君子贵浴德。\n清心是道场，金仙有遗则。\n人言我虑不须涤，我谓几人能涤得。\n以此息万缘，以此销六贼。\n君不见水观月观成道人，尽向此门生妙识。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50578,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中岩","author":"岑象求","text":"潇洒监城隈，聊驱俗驾回。\n世尘飞不到，山色翠成堆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50579,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"剑门关","author":"岑象求","text":"当道双峰辟，凌空万仞酋。\n于秦置扃鐍，与蜀作襟喉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50580,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游定林院","author":"岑象求","text":"野阔莲宫迥，楼台半倚山。\n地联巴峡近，门对濮溪湾。\n柏径松烟湿，石房雨藓斑。\n白云邀客住，明月伴僧閒。\n经梵喧哗外，香灯杳霭间。\n胜游成邂逅，危搆喜跻攀。\n世路诚何极，尘心久欲还。\n輶车正催发，缓步出重关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50581,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"药洲","author":"许彦先","text":"花药氛氲海上洲，水中云影带沙流。\n直应路与银潢接，槎客时来犯斗牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50582,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再游阳春通真岩","author":"许彦先","text":"壁倚乾宁碣，龛笼大业僧。\n七年驰使路，两蹑石梯层。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50583,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游碧落洞二首 其一","author":"许彦先","text":"崖卷层霄阔，溪穿碧玉横。\n银河一派水，终日泻天声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50584,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游碧落洞二首 其二","author":"许彦先","text":"玉峰刳不尽，满室碧琅玕。\n太始藏灵气，寥寥五月寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50585,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南山宣圣庙窃见太守黄公题名有作 其一","author":"许彦先","text":"千仞岩岩涌白云，不教紫翠落尘氛。\n长留雨后凭栏意，堆叠清光伴使君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50586,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南山宣圣庙窃见太守黄公题名有作 其二","author":"许彦先","text":"数仞环分一径深，讲筵深处暮烟沈。\n金铃木舌新扬意，忠孝昭昭剌史心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50587,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"湖上十亭","author":"许彦先","text":"昔年曾看海阳图，巧状湖山恐见诬。\n今日登临真可爱，画图翻觉少工夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50588,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题舜井断碑","author":"许彦先","text":"一千二百馀年外，万古销磨不可寻。\n舜子井泉谁记古，随人闾巷祇如今。\n隶书字杂科虫体，氏爵名存乐石阴。\n登览时来醒醉眼，也胜他物在园林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50589,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"知府伯常度支宿熙春台辄成拙诗上寄","author":"张纮","text":"云藏雨意明还暗，水激溪声断复来。\n恨君不且留千骑，同折岩花对酒杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50590,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"郭汝贤","text":"万工填巨海，千古作良田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50591,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题迎薰阁","author":"张杲之","text":"虚阁势峥嵘，高陵涿鹿城。\n前瞻青巀嶭，下阚碧澄泓。\n弊宇随时去，雕甍不日成。\n佳莲供夏景，乔木送秋声。\n乳鹭欣双入，北鸿想万程。\n风生舜弦古，月射庾楼清。\n隐隐分行客，憧憧悯细氓。\n凭高愁自失，怀远恨难平。\n赏纵棋兼酒，吟羞石对瑛。\n炎蒸登览者，方爱此嘉名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50592,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赋得同江华令贯之黄兄游阳华岩一篇","author":"练潜夫","text":"万里苍山麓，阳华古洞天。\n晨光迎海日，昼暝入溪烟。\n穴窾蛟龙蛰，峰巉鬼魅镌。\n初筵堂半辟，末势霤孤穿。\n玉乳垂虚窦，金沙引漫泉。\n栏危浮绝壁，庋迥跨遥川。\n隐约烧丹灶，横斜种玉田。\n刿桐鱼烛烛，挝石鼓鼘鼘。\n翠羽岩蕉静，玄幢石桂圆。\n扪穹藤黝纠，衬步草茵绵。\n暂止苏门啸，来因叶县仙。\n篮舆收弱屐，桂楫荡轻舷。\n胜赏平生兴，寻幽最可怜。\n奇游陵宇宙，班坐馥兰荃。\n谷鸟酤新酿，松风韵古弦。\n祇应销永昼，何用蠹尘编。\n蒋赋初无得，元铭久更妍。\n留连资旷士，吟咏属高贤。\n尘土闲中厌，山林老更便。\n临分凉月白，回首正依然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50593,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游层岩","author":"练潜夫","text":"朝寻白鹅山，夕次层岩曲。\n中虚谷窈窕，一水流其腹。\n澄渟注渊奫，冬夏不盈缩。\n初疑有神物，毛骨森戚促。\n魂惊不敢吐，发腻不敢沐。\n跨梁怛临深，矧敢濯余足。\n闻昔宅秘怪，蒙鸿状河渎。\n黄昏嘷猩鼯，正昼飞蝙蝠。\n豚肩走巫觋，歌舞神所欲。\n寻幽到其趾，精爽戒托宿。\n张公熙宁初，曾是舒幽独。\n镌题百许字，焕烂夺人目。\n几呵护守严，百魅不敢触。\n往往风雨夜，啾啾鬼神哭。\n乃知正直士，所至即蒙福。\n往时元次山，今日蒋颖叔。\n或镵阳华铭，或刻舜祠录。\n与公成三人，万代仰高躅。\n因书岩石间，聊用美淇澳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50594,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"约东坡游金山","author":"徐畴","text":"黯淡滩头一艇横，夕阳西下大江平。\n与君不负平生约，同向金鳌背上行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50595,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"连都官祭歌","author":"王莘","text":"恂好善兮行以躬，完素履兮一初终。\n化邦乡兮革奸凶，出为政兮用其中。\n三钟山兮屹穹崇，与公德兮并其隆。\n岂独文兮耀幽宫，宜配社兮同勾龙。\n俾世世兮仿而从，里闾乐兮廉让风。\n刑罚措兮年屦丰，慱哉利兮垂无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50596,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"白云庵","author":"许仲蔚","text":"云本山家物，庵茅相就居。\n竹扉閒自掩，烟冻冷无馀。\n岭上来还去，风前卷复舒。\n禅僧却应笑，扰扰竟何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50597,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和许广渊南山","author":"许仲蔚","text":"青山叠叠水重重，古道才容匹马通。\n飞鸟自由啼晚照，落花无著趁春风。\n岩前积霭参差绿，天末馀霞点缀红。\n一一广陵如在眼，诗坛谁敢较豪雄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50598,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杜公井","author":"许仲蔚","text":"德地见图牒，神机发杜棱。\n寇围炎甚火，壶饮冽于冰。\n古邑桑田换，灵源鉴面澄。\n如今风月夕，煮茗诧山僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50599,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鍊丹井","author":"许仲蔚","text":"青云路在天，弃鼎亦徒然。\n九转果何物，一泓空旧泉。\n竞知丹可煮，不悟骨非仙。\n汲引殊无状，翻尤葛稚川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50600,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"放生池","author":"许仲蔚","text":"唐家旧佛祠，楼阁影参差。\n鱼散不知处，水流无断时。\n山光朝暮变，人事古今移。\n惟有好生德，恩波尚满池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50601,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"百丈山","author":"许仲蔚","text":"势擎霄汉直，根截乱山兼。\n云叶闲铺地，烟煤润洒尖。\n远疑题塞雁，高欲篆秋蟾。\n倒泻长江水，陶泓未足沾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50602,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"葛溪","author":"许仲蔚","text":"一道碧琉璃，灵源杳不知。\n寒通鍊丹井，润接放生池。\n钓叟相从处，仙翁有到时。\n徘徊无所见，月艇去犹夷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50603,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"广利庙","author":"许仲蔚","text":"遗靴存故事，碑断不知名。\n老木合双抱，荒祠间数楹。\n编民阴有赐，神像凛于生。\n箫鼓寒溪上，欢呼贺岁成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50604,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"碧治寺","author":"许仲蔚","text":"松竹森森匝四围，一回来此一忘归。\n猿攀东岭啼寒月，僧指西峰笑落晖。\n山色云含牵客思，池光风动射人衣。\n乐山乐水皆仁智，岂倦驱驰到翠微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50605,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"罗隐宅","author":"许仲蔚","text":"吟魂散何处，旧居荒可嗟。\n江山间白日，图籍落谁家。\n野烧寒煨■，春风暖自花。\n诗名蟠不得，埋没任桑麻。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50606,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"留题曹娥庙","author":"萧辟","text":"屈平以楚死，死浊不死清。\n伍员以吴死，死暗不死明。\n死者人所难，一死鸿毛轻。\n壮哉二子为，留得不死名。\n曹娥以父死，年龄童未成。\n抱尸出洪澜，非可二子并。\n二子谏不从，齐秦韩魏征。\n娥若不之死，父葬鳣与鲸。\n二子死以介，娥死以孝诚。\n于今会稽人，事之如事生。\n娥若生尧时，舜不妻女英。\n娥若逢孔子，娥名书孝经。\n娥父若罹辜，岂止为缇萦。\n蔡邕不知娥，但爱碑上铭。\n我来拜祠下，古木寒云横。\n往往大江水，犹作哀哀鸣。\n安得娥有知，为我神阴灵。\n鼓此大江波，注入四渎平。\n洗濯天下心，皆行娥所行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50607,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送程给事知越州","author":"陈康民","text":"五羊城郭一朝新，归作黄扉侍从臣。\n暂向天边辞禁闼，更于江外福吾民。\n锦衣上冢乡山晓，熊轼颁条驿路春。\n不待期年应报政，即看朝觐对严宸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50608,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题招提院静照堂","author":"张贲","text":"瓶锡为生久，门阑过客疏。\n于间见真寂，燕坐此清虚。\n事事皆身外，悠悠度岁馀。\n如何繁草木，还长旧庭除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50609,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"薛岭","author":"张翥","text":"衣冠陈氏族，桃李薛公园。\n场老遗文古，岩僧旧迹存。\n苔矶荒碛岸，金榜勒瑶琨。\n已怜松特异，尤喜石能翻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50610,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送王迪夫妇偕隐","author":"刘纯臣","text":"发如抹漆左参军，脱去青衫从隐沦。\n世上更无羁绊事，壶中别有自由身。\n鼎烹玉兔山前药，花看金鳌背上春。\n莫怪少年能决烈，蓝田夫妇总登真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50611,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏周贯","author":"刘纯臣","text":"八十西山作酒仙，麻鞋乳断布衣穿。\n形骸一脱尘缘尽，太极光阴不记年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50612,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游风水洞","author":"许遵","text":"水洞连风洞，精蓝两洞前。\n山高易藏日，树老不知年。\n板有华宗什，名留少傅篇。\n烟波门外境，寂寞变桑田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50613,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大雨联句","author":"杨咨","text":"无正文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50614,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赋新繁周表权如诏亭","author":"黎持正","text":"义教名亭梗概存，要将诗礼及云孙。\n当年偶出严君意，后日冥符内使言。\n座釂拨醅披茜绶，人观新榜驻高轩。\n汝南盛事谁能得，未独于公纳驷门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50615,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寿傅守","author":"黄革","text":"来日中元毓寇公，万年事业一朝同。\n入陪清切星辰履，出奏循良屏翰功。\n棣萼一时腾最治，棠阴两纪继遗风。\n阴功数卷书金简，遐算应须等岱嵩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50616,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东峰亭","author":"刘读","text":"黄尘数骑捷书来，啸入东峰醉倚台。\n遥看山川消杀气，同欣寰宇扫氛埃。\n当年岩谷碑千字，旷世功名土一抔。\n有美斯人风烈壮，故亭重葺画图开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50617,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"下第投荆公","author":"饶竦","text":"又还垂翅下烟霄，归指临川去路遥。\n二亩荒田须卖却，要钱准备纳青苗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50618,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"岑崎山","author":"朱素","text":"小洞隐遥岑，松萝翠复阴。\n游人曾到不，方信白云深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50619,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂 其一","author":"陈易","text":"密坐研穷省细微，到头须是自忘机。\n应无祖佛能超越，岂有冤亲更顺违。\n历历孤明犹认影，巍巍独步尚披衣。\n翻嗟会得昭灵者，也道寻师得旨归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50620,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂 其二","author":"陈易","text":"个中端的有谁知，知者归来到者稀。\n即见即闻还错会，离声离色转乖违。\n山青水绿明玄旨，鹤唳猿啼显妙机。\n有意觅渠终不遇，无心到处尽逢伊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50621,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游石所题于轩壁","author":"陈易","text":"酒吸阳春入肺肠，茶罢清风生肘腋。\n安知石所洞中人，不是武陵溪上客。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50622,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答有需禅师","author":"陈易","text":"年来多病爱栖禅，宝鉴慵将照丑妍。\n却忆南湖孤顶月，定回金磬落岩前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50623,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"石门歌","author":"释有需","text":"吾结草庵蔡溪侧，四顾峰峦皆峭壁。\n石门千仞锁天津，来者欲登那措足。\n住此庵中是何缘，不诗不颂亦不禅。\n饥来苦菜和根煮，叠石为床困即眠。\n日照诸峰阴羃羃，负暄孤坐情何适。\n驯伏珍禽趁不飞，猿猱扪我衣中虱。\n闲支瘦筇六七尺，山行野步扶危力。\n披云入草不辞劳，逢人打破修行窟。\n或停松，或坐石，静听溪泉漱鸣玉。\n源深洞邃来不休，声声奏尽无生曲。\n杂羽流商谁辨的，五音六律徒敲击。\n有时乘兴上高峰，大笑狂歌天地窄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50624,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄陈聘君体常","author":"释有需","text":"拂石跏趺树影宽，定回霜月照人寒。\n此时况味谁知得，写与秋藤居士看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50625,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游东禅寺","author":"张某","text":"好峰飞去后，流出乱云根。\n应为留僧住，□□□□门。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50626,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"澹山岩","author":"胡奕","text":"一景曲弯弯，初遗号澹山。\n崖边烟草乱，石上雨苔班。\n客往长时望，僧居永日闲。\n几回将欲去，心只在岩间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50627,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"释重喜","text":"行到寺中寺，坐观山外山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50628,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"投李珦庙三首 其一","author":"张芝","text":"风软潮生江水平，遥峰隐隐浸寒青。\n自从香骨沉波底，独我为诗吊尔灵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50629,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"投李珦庙三首 其二","author":"张芝","text":"轧轧橹声离远浦，萧萧帆影落寒涛。\n殷勤滴酒陈佳果，将此深心慰寂寥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50630,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"投李珦庙三首 其三","author":"张芝","text":"江雨初晴远岸低，心因啼鸟陡思归。\n尔如会我题诗意，魂梦相求一处飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50631,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十竹","author":"释清顺","text":"城中寸土如寸金，幽轩种竹只十个。\n春风慎勿长儿孙，穿我阶前绿苔破。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50632,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"林下","author":"释清顺","text":"久从林下游，颇识林下趣。\n纵渠绿阴繁，不碍清风度。\n闲来石上眠，落叶不知数。\n一鸟忽飞来，啼破幽寂处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50633,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西湖僧舍","author":"释清顺","text":"竹暗不通日，泉声落如雨。\n春风自有期，桃李乱深坞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50634,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿天竺","author":"释清顺","text":"昔人不可见，行路多长松。\n空遗炼丹处，井干绿苔封。\n月明还独宿，白云下疏钟。\n夜半桂子落，不知自何峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50635,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书景舒庵壁","author":"释清顺","text":"大布君能衣，始知蚕口非。\n冢间容一榻，身外但三衣。\n护戒避生草，净心观落晖。\n寂寥能自守，今世固应稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50636,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"留别句容簿","author":"高坦","text":"岩下相逢不忍还，狂歌醉酒且盘桓。\n仇香莫问神仙事，天上人间总一般。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50637,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"李颀","text":"但看青玉五枝灯，蟠螭火尽光欲然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50638,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题招提院静照堂","author":"陆伸","text":"闲房增缔构，宴坐隔嚣埃。\n屋木不加饰，庭花时自开。\n虚明殊止水，寂绝等寒灰。\n斋外无馀事，欣逢高士来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50639,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"神剑颂","author":"勇禅师","text":"提得神锋胜太阿，万年妖孽尽消磨。\n直饶埋向尘泥里，争奈灵光透匣何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50640,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂一首","author":"勇禅师","text":"胡孙儿子太惺惺，爱弄千年鬼眼睛。\n不现宰官身说法，时时来我顶头行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50641,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]