[{"title":"食鸡头","author":"苏辙","text":"风开芡觜铁为须，斧斫沙磨旋付厨。\n细嚼兼收上池水，徐咽还成沧海珠。\n佳客满堂须一斗，闲居赖我近平湖。\n多年不到会灵沼，气味宛然初不殊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":309,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"食菱","author":"苏辙","text":"野沼涨清泉，乌菱不直钱。\n蟹肥螯正满，石破髓初坚。\n节物秋风早，樽罍夜月偏。\n令人思淮上，小舫藕如椽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":310,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"食樱笋二首 其二","author":"苏辙","text":"林竹抽萌不忍挑，谁家盈束伴晨樵。\n箨龙似欲号无罪，食客安知惜后凋。\n不愿盐梅调鼎味，姑从律吕应箫韶。\n林间老死虽无用，一试冬深雪到腰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":311,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"食樱笋二首 其一","author":"苏辙","text":"一旱经春草木焦，朱樱结子独盈条。\n盘中宛转明珠滑，舌上逡巡绛雪消。\n仰嗫佳人露犹湿，偷衔啼鸟语尤娇。\n南方荔子争先后，羞见炎风六月烧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":312,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乘小舟出筠江二首 其一","author":"苏辙","text":"短舫漂浮真似叶，小蓬低浅仅如巢。\n幽吟但觉山川走，困睡不知风雨交。\n红饭白醪供醉饱，青蓑黄箬可缠包。\n一竿鹤发他年事，万斛龙骧任见嘲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":313,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乘小舟出筠江二首 其二","author":"苏辙","text":"宦游欲学林间鹊，每到新年旋叠巢。\n蓬箬笼船聊似屋，渔樵把臂便成交。\n不妨袖里携诗卷，尚可床头置药包。\n《古史》欲成身愈困，客来未免答讥嘲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":314,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"唐修撰义问挽词二首 其二","author":"苏辙","text":"我返南荒日，君临旧许初。\n笑谈宽老病，旌旆拥茅庐。\n酒盏开虽数，溪堂到尚疏。\n谁言生死隔，近在浃旬馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":315,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"唐修撰义问挽词二首 其一","author":"苏辙","text":"家风台柏老，遗直故依然。\n节见南迁后，神凝未瞑前。\n临民旧有法，训子适成篇。\n九转今犹在，参同岂妄传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":316,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"留守与宾客会开元龙兴寺观灯余有故不预中夜登南城","author":"苏辙","text":"灯引双旌万点红，倾城车马在城东。\n使君行乐人人共，倦客安眠夜夜同。\n梦想笑谈倾满坐，卧闻歌筦逐春风。\n三更试上南楼看，无限繁星十里中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":317,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"留滞高安四年有馀忽得信闻当除官真扬间偶成小诗书于屋壁","author":"苏辙","text":"数间茅屋久蹉跎，四见秋风入薜萝。\n北棹偶然追雁羽，南公谁复伴渔蓑。\n三年贾傅惊吾老，九岁刘郎愧尔多。\n此去仍家江海上，不妨一叶弄清波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":318,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病中郭尉见访","author":"苏辙","text":"偶成三日寒兼热，知是多闻力未全。\n却问药王求妙剂，惭非摩诘已虚圆。\n劳公强说修行渐，顾我方为病垢缠。\n应是床头有新酒，欲邀佳客故留连。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":319,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病后","author":"苏辙","text":"一经寒热攻骸骨，正似兵戈过室庐。\n柱木支撑终未稳，筋皮收拾久犹疏。\n芭蕉张王要须朽，云气浮游毕竟虚。\n赖有衣中珠尚在，病中点检亦如如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":320,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病后白发","author":"苏辙","text":"枯木自少叶，不堪经晓霜。\n病添衰发白，梳落细丝长。\n筋力从凋朽，肝心罢激昂。\n势如秋后雨，一度一凄凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":321,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病退","author":"苏辙","text":"冷枕单衣小竹床，卧闻秋雨滴心凉。\n此间本净何须洗，是病皆空岂有方。\n示疾维摩元自在，放身南岳离思量。\n病根欲去真元在，中夜梦游何有乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":322,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病愈二首 其二","author":"苏辙","text":"病退日身轻，身轻心转清。\n山空流水上，海静寸灯明。\n朝市谁留住，林泉自不行。\n筠溪惭丐士，流荡过平生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":323,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病愈二首 其一","author":"苏辙","text":"学道虽云久，沉疴竟未除。\n炎烝度三伏，晻暧觉中虚。\n嘉谷不自长，荒榛终费锄。\n何辞用兰石，梨枣得扶疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":324,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"除夕感怀","author":"唐庚","text":"永漏侵春已数筹，地炉犹拥木绵裘。\n无心岂畏三尸诉，爱日还惊一岁休。\n故国二千空醉眼，新年三十恰平头。\n光阴未用相敦迫，领取衰翁两鬓秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":325,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"竞渡","author":"苏辙","text":"史君欲听榜人讴，一夜江波拍岸流。\n父老不知招屈恨，少年争作弄潮游。\n长鲸破浪聊堪比，小旆逆风殊未收。\n角胜争先非老事，凭栏寓目思悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":326,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"索居三首 其三","author":"苏辙","text":"许蔡古邻国，风烟相杂和。\n萧然客舍静，不愿主人过。\n野荠春将老，淮鱼夏渐多。\n街南病居士，有酒对酣歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":327,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"索居三首 其二","author":"苏辙","text":"平生亦何事，十载苦颠隮。\n梦崄曾非崄，觉迷终不迷。\n客居兼壮子，别久愧良妻。\n稍讶音书阔，春阴道路泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":328,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"索居三首 其一","author":"苏辙","text":"索居非谪地，垂老更穷途。\n去住看人意，幽忧赖我无。\n小园花草秽，陋巷犬羊俱。\n近觉根尘离，忘言日益愚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":329,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蚕麦","author":"苏辙","text":"春旱麦半熟，蚕收仅十分。\n不忧无饼饵，已幸有襦裙。\n造化真怜汝，耕桑不谩勤。\n经过话关陕，贫病不堪闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":330,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蚕麦二首 其二","author":"苏辙","text":"三界人家多鲜福，一时蚕麦得难兼。\n锄耰已愧非吾力，汤火尤惊取不廉。\n贵客争誇火浣布，贫家粗有水精盐。\n薄衫冷面消长夏，扪腹当知百不堪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":331,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蚕麦二首 其一","author":"苏辙","text":"疏慵自分人嫌我，贫病可怜天养人。\n蚕眠已报冬裘具，麦熟旋供汤饼新。\n撷桑晓出露濡足，拾穗暮归尘满身。\n家家辛苦大作社，典我千钱追四邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":332,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诸子将筑室以画图相示三首 其三","author":"苏辙","text":"积因得果通三世，临老长闲自一时。\n久尔观心终未悟，偶然见道了无疑。\n南迁北返吾何病，片瓦尺椽天与期。\n自断此生今已矣，世间何物更如斯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":333,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诸子将筑室以画图相示三首 其二","author":"苏辙","text":"旧庐近已借诸子，新宅分甘临老时。\n万里松楸终独往，四方兄弟亦何疑。\n竹间疏户幽人到，林上长松野鹤期。\n已觉高轩惭卫赐，可怜黄犬哭秦斯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":334,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诸子将筑室以画图相示三首 其一","author":"苏辙","text":"还家卜筑初无地，随分经营似有时。\n多斫修篁终未忍，略存古柏更无疑。\n画图且作百间计，入室犹应三岁期。\n得到安居真老矣，一生歌哭任于斯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":335,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读传灯录示诸子","author":"苏辙","text":"大鼎知难一手扛，此心已自十年降。\n旧存古镜磨无力，近喜三更月到窗。\n早岁文章真自累，一生忧患信难双。\n从今父子俱清净，共说无生或似庞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":336,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"逢章户掾赴澧州","author":"苏辙","text":"江船不厌窄，船窄始宜行。\n风里长先过，滩头一倍轻。\n迎亲无恶处，禄养胜躬耕。\n澧上春兰早，犹堪吊屈生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":337,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陪毛君游黄仙观","author":"苏辙","text":"李叟仙居仍近市，黄公道院亦依城。\n定应昔日山林地，未有今时鸡犬声。\n白鹤翻飞终不返，黄冠憔悴只躬耕。\n试从车骑寻遗迹，恐有居人解养生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":338,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高邮赠别杜介供奉","author":"苏辙","text":"淮南鱼米年年贱，直便归休无俸钱。\n锦背图书何益事，尘生弦筦正参禅。\n逢人未废一樽酒，送客长随百里船。\n世上得如君自在，不须开府事开边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":339,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"堂成不施丹雘唯纸窗水屏萧然如野人之居偶作","author":"苏辙","text":"高栋虚窗五月凉，客来扫地旋焚香。\n白云低绕明月观，涨海东流清暑堂。\n病久渴心思沆瀣，梦回馀念属潇湘。\n老人夫妇修行久，此处从今是道场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":340,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄张芸叟","author":"苏辙","text":"老矣张芸叟，亲编乐府词。\n才高君未觉，手战我先衰。\n点?旧无对，吟哦今与谁。\n十年酬唱绝，欢喜得新诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":341,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄题江涣长官南园茅斋","author":"苏辙","text":"白发辛勤困小邦，尘劳坐使壮心降。\n河阳罢后成南圃，彭泽归来卧北窗。\n畦畔草生亲荷锸，床头酒熟自倾缸。\n因君遣我添归兴，旧有茅茨濯锦江。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":342,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄题陈宪郎中竹轩","author":"苏辙","text":"家有修篁绿满轩，趋庭诗礼旧忘言。\n凌霜自得良朋友，过雨时添好子孙。\n试剪轻筠扶野步，旋收凉叶煮清樽。\n风流共道胜桑梓，邻里何妨种百根。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":343,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄题武陵柳氏所居二首 其一 天真堂","author":"苏辙","text":"宦游阅尽山川胜，归老方知气味真。\n歌哭不移身自稳，往还无间语尤亲。\n永怀前辈无因见，犹喜诸郎有此人。\n千岁展禽风未改，不加雕琢世称珍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":344,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄题武陵柳氏所居二首 其二 康乐楼","author":"苏辙","text":"邑居欲尽溪山好，不作层楼无奈何。\n岩谷满前收蜡屐，漪涟极目卷渔蓑。\n安心已得安身法，乐土偏令乐事多。\n千里筠阳犹静治，还家一笑定无他。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":345,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄题赵㞦承事戏綵堂","author":"苏辙","text":"春晚安舆遍浙东，永嘉别乘喜无穷。\n橐装已笑分诸子，吏道何劳问薛公。\n堂上寿樽诸掾集，室中禅论衲僧通。\n兴阑却返林泉去，幕府长留孝弟风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":346,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄题蒲传正学士阆中藏书阁","author":"苏辙","text":"朱栏碧瓦照山隈，竹简牙签次第开。\n读破文章随意得，学成富贵逼身来。\n诗书教子真田宅，金玉传家定粪灰。\n更把遗编观得失，君家旧物岂须猜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":347,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"得告家居次韵贡父见寄","author":"苏辙","text":"君恩赐告许归来，雨后中庭有绿苔。\n起问日高三丈久，卧闻车过九门开。\n泥封连日传新语，腕脱知君有轶才。\n待得晴乾追后乘，未应尘土热如灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":348,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"曹郎子文赴山阳令","author":"苏辙","text":"囊空口众不堪闲，却喜平生得细论。\n鹤发进封偿旧德，彩衣听讼勉平反。\n楚风剽疾观新政，浙水萧条咏旧恩。\n记取老人临别语，茶瓢霜后早相存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":349,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梦中咏西湖","author":"苏辙","text":"谁凿西湖十里中，扁舟载酒飏轻风。\n草木蕃滋百事足，寒暄淡薄四时同。\n东邻适与吾庐便，西岸遥将岳麓通。\n闲游草草无人识，竹杖藤鞋一老翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":350,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"移竹","author":"苏辙","text":"墙阴竹蒙密，板筑念相妨。\n欲补园东缺，欣乘雨后凉。\n三年生笋遍，一径引风长。\n但恐翁弥老，筇枝懒复将。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":351,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"移陈州牡丹偶得千叶二本喜作","author":"苏辙","text":"小圃初开清潩岸，名花近取宛丘城。\n争言千叶根难认，忽发双葩眼自明。\n谪堕神仙终不俗，飞来鸾凤有馀清。\n细锄瓦砾除荆棘，未可令齐众草生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":352,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"章氏郡君挽词","author":"苏辙","text":"冯唐垂老郎潜后，李白风流罢直馀。\n解组同归荣故国，剖符仍得奉安舆。\n家声未替三公旧，葬客应倾数郡车。\n德映闺门人莫见，埋文子细列幽墟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":353,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绩溪二咏 其二 翠眉亭","author":"苏辙","text":"谁安双岭曲弯弯，眉势低临户牖间。\n斜拥千畦铺渌水，稍分八字放遥山。\n愁霏宿雨峰峦湿，笑卷晴云草木闲。\n忽忆故乡银色界，举头千里见苍颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":354,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绩溪二咏 其一 豁然亭","author":"苏辙","text":"南看城市北看山，每到令人意豁然。\n碧瓦千家新过雨，青松万壑正生烟。\n经秋卧病闻斤响，此日登临负酒船。\n径请诸君作佳句，壁间题我此诗先。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":355,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪后小酌赠内","author":"苏辙","text":"薄雪为灯止，和风应节来。\n出游吾已懒，小酌意难裁。\n竹径泥方滑，菁畦冻欲开。\n细君怜老病，加料作新醅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":356,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"黄几道郎中同年挽词二首 其一","author":"苏辙","text":"温恭天赋此心良，惠爱人知政术长。\n井水无波任瓶绠，牛刀投隙应宫商。\n分符出遍名城守，携被归从华省郎。\n不到汝阴遗恨远，坐令湖水减清光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":357,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"黄几道郎中同年挽词二首 其二","author":"苏辙","text":"早岁相从能几时，淮阳花发正游嬉。\n鸣弓矍相人如堵，席地沧浪柳作帷。\n十载旧游真是梦，一时佳客尚存谁。\n遥闻葬日车千两，渍酒绵中寄一悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":358,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"傅钦之学士济源草堂","author":"苏辙","text":"闻有高居直百金，西山南麓北山阴。\n园通济水池塘好，花近洛川颜色深。\n人去节旄分重镇，客来猿鹤感幽吟。\n潩溪雨过西湖涨，归兴萧然定不任。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":359,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"傅银青挽词二首 其二","author":"苏辙","text":"丹旐国西门，茅庐济水深。\n官清贫似旧，名重殁犹存。\n台阁传遗懿，交游拭泪痕。\n君恩不改故，延赏遍诸孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":360,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"傅银青挽词二首 其一","author":"苏辙","text":"名自乌台发，恩从凤沼深。\n盐梅和众口，金玉比诚心。\n澹泊平生事，弥留一病侵。\n遗言自无憾，朝野为沾襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":361,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜王巩承事北归","author":"苏辙","text":"同罪南迁惊最远，乘流北下喜先归。\n谓言一笑秋风后，却顾千山驿路非。\n岭外云烟随梦远，江边鱼蟹为人肥。\n还家嫁女都无事，卧读诗书尽掩扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":362,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜雨","author":"苏辙","text":"夏田已报七分熟，秋稼方忧十日乾。\n好雨徐来不仓卒，天公似欲救艰难。\n魃张鹰犬无遗力，社近鸡豚趁早寒。\n老病随人幸一饱，炉香无语只长叹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":363,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜雨","author":"苏辙","text":"一旱经春夏已半，好雨通宵晓未收。\n气爽暂令多病喜，来迟未解老农忧。\n力耕仅足公家取，遗秉休违寡妇求。\n时向林间数新竹，箨龙腾上欲迎秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":364,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜雪呈鲜于子骏三首 其一","author":"苏辙","text":"发函宽大一封书，卧阁雍容三日馀。\n旋见雪花投夜落，未应天意与人疏。\n瓦乾淅淅初鸣霰，畦润渐渐想没锄。\n高会梁园遗胜在，早知词赋似相如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":365,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜雪呈鲜于子骏三首 其二","author":"苏辙","text":"春秋无麦自当书，况复秋田水潦馀。\n一雪端来救焦槁，千箱乞与等亲疏。\n消残瘟疠曾非药，蚀遍陈根不用锄。\n犹恐远村沾未足，试呼农圃问何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":366,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜雪呈鲜于子骏三首 其三","author":"苏辙","text":"茧纸铺庭几误书，杨花糁径未春馀。\n积随平野分高下，舞信微风作密疏。\n解使游人似姑射，仍令飞鸟变舂锄。\n共惊天巧无能学，造物无心本亦如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":367,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寒雨","author":"苏辙","text":"江南殊气候，冬雨作春寒。\n冰雪期方远，蕉絺意始阑。\n未妨溪草绿，先恐岭梅残。\n忽发中原念，貂裘据锦鞍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":368,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寒食二首 其二","author":"苏辙","text":"寄住汝南怀岭南，五年一醉久犹酣。\n身逃争地差云静，名落尘寰终自惭。\n耳畔飞蝇看尚在，鼻中醇酢近能甘。\n今朝寒食唯当饮，买酒先防客欲谈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":369,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寒食二首 其一","author":"苏辙","text":"寒食今年客汝南，馀樽倾泻亦醺酣。\n道人久厌世间浊，僧舍犹存肉食惭。\n花折园夫时送客，饧留孙女尚分甘。\n欲游紫极谁为伴，长揖孤松对不谈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":370,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寒食前一日寄子瞻","author":"苏辙","text":"寒食明朝一百五，谁家冉冉尚厨烟。\n桃花开尽叶初绿，燕子飞来体自便。\n爱客渐能陪痛饮，读书无思懒开编。\n秦川雪尽南山出，思共肩舆看麦田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":371,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寓居二首 其一 东亭","author":"苏辙","text":"十口南迁粗有归，一轩临路阅奔驰。\n市人不惯频回首，坐客相谙便解颐。\n惭愧天涯善知识，增添城外小茅茨。\n华严未读河沙偈，偃仰明窗手自披。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":372,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寓居六咏 其一","author":"苏辙","text":"手植天随菊，晨添苜蓿盘。\n丛长怜夏苦，花晚怯秋寒。\n素食旧所愧，长斋今未阑。\n殷勤拾落蕊，眼暗读书难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":373,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]