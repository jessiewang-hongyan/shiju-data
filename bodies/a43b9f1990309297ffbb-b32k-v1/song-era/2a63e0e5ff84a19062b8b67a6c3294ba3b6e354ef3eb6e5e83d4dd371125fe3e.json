[{"title":"客中 其一","author":"丘葵","text":"孤客思家坐似瘖，溪风吹树为悲吟。\n溪中流水深千尺，未抵慈亲忆子心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20538,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"客中 其二","author":"丘葵","text":"晓起征衫瘦渐宽，可堪秋入鬓丝寒。\n客中万叶皆归本，自把床头易卷看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20539,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋夜有感","author":"丘葵","text":"万斛秋愁强自宽，夜深风露伴孤寒。\n可怜万里长空月，只得窗前一片看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20540,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋夜前韵","author":"丘葵","text":"触事嫌猜只一瘖，出门固羡砌虫吟。\n无情河汉西流去，惟有白云知此心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20541,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽心泉蒲处士 其一","author":"丘葵","text":"把钓秋风辱赠诗，伤心无路送灵輀。\n欲书诔语应难尽，独倚寒梅照石漪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20542,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽心泉蒲处士 其二","author":"丘葵","text":"欲持鸡絮立坟前，俗了青霞顶上仙。\n只合化为溪畔鹭，乘风飞去弄清泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20543,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚行书所见","author":"丘葵","text":"山涧雨初收，涓涓水乱流。\n树根一片石，童子坐牵牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20544,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅影","author":"丘葵","text":"山空年岁晚，老气寒峥嵘。\n耿耿霜月夜，相看直到明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20545,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"章法院堂中清坐","author":"丘葵","text":"到此人空法亦空，跏趺独坐夜方中。\n清还风去明还月，自己清明只在躬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20546,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜雨示儿侄 其三","author":"丘葵","text":"维天降灵雨，岂不雨石田。\n我自硗且确，枯悴莫怨天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20547,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游碧霄石镌一寿字今七十二年","author":"丘葵","text":"当时石上谁为镌，亭已荒芜字俨然。\n七十二年几陵谷，道人曾共字同年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20548,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"腊月二十九日陈万石石室吕潜心三兄相访夜坐分韵得年字","author":"丘葵","text":"二十年前旧师友，一灯相对坐谈玄。\n炉香茗椀不须睡，惟有今宵是旧年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20549,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"腊月二十九日陈万石石室吕潜心三兄相访夜来分韵得年字","author":"丘葵","text":"一年一度一除夜，趱得世人霜满颠。\n七十三年除过了，未知除尽是何年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20550,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"跋信中隐秋江捕鱼图","author":"丘葵","text":"逸兴寄沧洲，高风落木秋。\n欲携我蓑笠，渡口上渔舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20551,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"暗室","author":"丘葵","text":"一几善恶未分时，善本无为莫伪为。\n暗室休言人不见，此心才动鬼神知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20552,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"溪西李家","author":"丘葵","text":"秧针初出未全青，昨夜冈头冷雨晴。\n日暮采樵人去后，一痕淡月乱蛙鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20553,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鳌山阁","author":"丘葵","text":"阁上南薰声作秋，俯看木末翠光浮。\n倚窗忽见金鸡落，滚出前溪一线流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20554,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"一中","author":"丘葵","text":"莫把三才别立根，此身亦自一中分。\n四时环绕天包地，万片捲舒山出云。\n道在灵台常泼泼，气归元海自沄沄。\n百年保合太和内，老学无成恐有闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20555,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七月望日再游弥陀岩","author":"丘葵","text":"弥陀岩下苍榕树，借我今年两度游。\n客思凄凉无奈老，水光潋滟最宜秋。\n便思乘兴归沧海，却恨知心远白鸥。\n日暮强随年少去，溪山好处尽成愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20556,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九日","author":"丘葵","text":"乱后黄花空满篱，惊心节序屡推移。\n微吟聊续潘邠老，一笑难逢杜牧之。\n浮蚁共伴今日醉，食糕空忆太平时。\n牛山泪落龙山宴，付与西风一样吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20557,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九日","author":"丘葵","text":"海山秋索莫，不见菊花开。\n节与贫相弃，年将老共催。\n艰难思故里，牢落对残杯。\n旧日登高伴，今无一个来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20558,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"入冬半月馀二麦未种忽然一雨","author":"丘葵","text":"村庄三日雨，清晓怯凭栏。\n洒地纷纷白，随风阵阵寒。\n不愁客衣薄，且为老农欢。\n已有芃芃意，来春岁计宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20559,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"入忠轩书院咏兰","author":"丘葵","text":"阶庭暂托根，只与绿苔亲。\n自少枝条分，不争花卉春。\n轻寒青瘦硬，出槛紫鲜新。\n风雨时吹洗，含芬待主人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20560,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"八十","author":"丘葵","text":"一裘一葛一纶巾，包裹父生师教身。\n不见分毫裨世界，空遗八十有年人。\n老无闻道安可死，间得读书惟一贫。\n四万八千毛孔里，从头看得总皆仁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20561,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"八十四岁吟","author":"丘葵","text":"百年尚有一十六，天不穷人人自穷。\n未解寡尤并寡悔，若为知至又知终。\n如真可死何妨死，欲养不中那得中。\n无可奈何委诸命，狂澜终久必须东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20562,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"八十岁吟","author":"丘葵","text":"自愧身无济世才，茅斋高卧白云隈。\n堂堂玉立窗前竹，叠叠前铺砌上苔。\n白鸟去边春日落，青山断处晚潮来。\n逢人不必言时事，共把情怀对酒开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20563,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与可大水头闲望","author":"丘葵","text":"暧入纱巾淡淡风，倚楼客思话无穷。\n前山倒影摇春水，野火飞烟入暮空。\n无数舟人相尔汝，一群沙鸟自西东。\n江流不碍钟声度，和雨收来八句中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20564,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与汝翔池头清坐","author":"丘葵","text":"主人发兴在林泉，故凿方池翠竹边。\n波动日光翻素壁，水涵云影倒青天。\n蛙浮成字出复出，凫没有纹圆又圆。\n却意盘翁初到此，共看杨柳碧丝悬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20565,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与汝翔晚行","author":"丘葵","text":"偶值忘形友，田间步晚晴。\n四围山木合，一片夕阳明。\n倚杖数归翮，隔溪闻唤声。\n行来僧寺歇，又得问无生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20566,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与应得李洋归","author":"丘葵","text":"花时莫负此良辰，信杖閒行寂寞滨。\n日入山头成鹤顶，风吹沙碛皱鱼鳞。\n飞来白鹭全成雪，倒去枯松半树春。\n似此江山孤绝处，故应著此苦吟人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20567,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与所盘行溪边有一小屋可爱问之乃为南山主人盘翁欲买居越日诗来有孟光到老不晓事刚道还山活计非之句用韵以勉之","author":"丘葵","text":"相逢海上不须归，两鸟天教一处飞。\n何必盘中为子所，苟堪钓处是吾矶。\n主人合让泉边屋，吟友来敲月下扉。\n闻道山阳曾好隐，此回休道孟光非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20568,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与所盘诸君会石幡还和杜老曲江韵 其一","author":"丘葵","text":"絮云初擘未成衣，笑踏青莎桥上归。\n诗酒堪过春日永，莺花却恨海山稀。\n竹间弄笛留人住，麦外游丝绊鸟飞。\n满院东风不收拾，山僧何事苦相违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20569,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与所盘诸君会石幡还和杜老曲江韵 其二","author":"丘葵","text":"青禽竹上弄毛衣，飞上檐头唤不归。\n清景每于诗里见，羁愁惟到海边稀。\n僧回古殿山矾落，客散空斋蝙蝠飞。\n独对青山已惆怅，此情犹是月时违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20570,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小春","author":"丘葵","text":"落尽千林秋又冬，惭无生意岁将穷。\n是谁借得三春力，为我敷施十月中。\n种种草根含暖气，鳞鳞水面发和风。\n江梅剩放南枝蕊，欲策阳回第一功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20571,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山斋","author":"丘葵","text":"草色苔痕挟雨骄，山斋一巷似渔樵。\n三叉路口时时犊，一曲溪流片片桥。\n风木参差泉上庙，烟帆来往海西潮。\n飘然忽起云间想，白鹤高飞不可招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20572,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"门巷","author":"丘葵","text":"门巷萧条绝市声，吟肩终日耸崚嶒。\n瘦如华表秋来鹤，贫似丛林旦过僧。\n渴吻漫消茶一碗，枯肠不饱稻三升。\n交游岂是相违意，四十无闻自可憎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20573,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书山翁房壁","author":"丘葵","text":"山翁有山癖，尽日对山青。\n盂水晨煎茗，炉香夜诵经。\n雨畦蔬长甲，风径竹添丁。\n独有曾游客，清癯似鹤形。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20574,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书陈氏小轩壁","author":"丘葵","text":"一榻自徜徉，悠然古意长。\n地幽如佛舍，轩小似船房。\n萱草依堂绿，荆花夹树香。\n我来访幽隐，话里雨声凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20575,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元旦与可大江行","author":"丘葵","text":"日出潮回生紫烟，水光春色弄春妍。\n底须椒柏来为颂，且与鸥凫叙隔年。\n风动微波靴面皱，苔粘枯石佛头圆。\n老来须与溪童乐，争倚芦花学放船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20576,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"六十六岁吟","author":"丘葵","text":"维天于穆命无殊，人性皆由气与虚。\n贵贱何须为物役，芳菲祇合返吾初。\n读书自觉年年误，学道惟应念念除。\n辅世长民今已矣，某丘某水且樵渔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20577,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"六月寓章法寺","author":"丘葵","text":"暝色入招提，昏鸦已不啼。\n诸僧空院出，老子独山栖。\n堂面无人北，天形尽日西。\n寂寥应不恨，吾道与时睽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20578,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"天阴","author":"丘葵","text":"天阴尽日黯无光，白骨纵纵横地霜。\n真鞑未多多伪鞑，拒王不罪罪勤王。\n昔持耒耜今兵革，人食糟糠马稻粱。\n正似镬汤无冷处，年三十六死为长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20579,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"支筇","author":"丘葵","text":"天乎多往事，老矣负初心。\n病骨瘦又瘦，愁诗吟复吟。\n一生空碌碌，万绿自森森。\n多少关情处，支筇古树阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20580,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"日入","author":"丘葵","text":"日入川原暝，风悲草木枯。\n时逢迂孔氏，我自哭唐衢。\n市有虎求食，村无鸡引雏。\n乾坤空纳纳，何处著吾躯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20581,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"月中与诸友还在沙溪","author":"丘葵","text":"为爱江头月，回环宿鹭汀。\n露浓如泼水，天淡欲无星。\n树色依月黑，萤光出竹青。\n夜深幽兴极，瘦影自伶俜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20582,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"东归拟再访吕所盘不果所盘有诗因次韵","author":"丘葵","text":"何处啼鹃送落晖，江山信美不如归。\n子期死矣今安有，元亮来兮昨已非。\n世事悠悠春梦断，人才落落晓星稀。\n白头老伴惟君在，安得相随绕树飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20583,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"东归拟再访吕所盘舟便不果盘有诗因次韵以谢","author":"丘葵","text":"对酒殷勤问后期，出门一步便相思。\n自从剡曲回舟后，长忆巴山听雨时。\n鹤发无成应念我，貂裘已敝欲从谁。\n归途不向盘中过，却被清泉笑恶诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20584,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出院门閒步","author":"丘葵","text":"出爱前村景，归穿薄暮烟。\n鸟飞虚碧里，人在落红边。\n近晚山容淡，新晴稻色鲜。\n殷勤一溪水，清到院门前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20585,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"古藤","author":"丘葵","text":"古藤屈曲似龙蛇，飞上梢头故故遮。\n烟密真成一翠幄，风清不入五侯家。\n忽看落叶知秋早，偶坐吟诗到日斜。\n恐有飞仙林杪过，呼童为我整乌纱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20586,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"叶掌书","author":"丘葵","text":"阳复天心动，春回五叶中。\n梅梢足生意，柏府早清风。\n身任八州寄，手持三尺公。\n可怜芹泮士，空自献诗筒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20587,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"四月朔日晓起候吕之寿","author":"丘葵","text":"清辰未巾栉，远远望山阿。\n一夕已如此，长年其奈何。\n高斋空寂寞，今日始清和。\n可惜一樽酒，骊驹又欲歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20588,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"归侍","author":"丘葵","text":"村庄一樽酒，谁与语悲辛。\n衿佩空相负，诗书不救贫。\n天寒负米客，日暮倚门人。\n遥睇长江水，西风犹怆神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20589,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用伯恭次信儿韵因以示之","author":"丘葵","text":"老至如斯更不愆，此生自断总由天。\n丈夫事到盖棺定，男子生随堕地缘。\n误读银车知昶拙，点成珠唾赖勤贤。\n孤槎欲泛千寻海，常望龙骧万斛牵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20590,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用前韵寄几仲","author":"丘葵","text":"丈夫语意豁，不为别肠悲。\n有酒再醑我，缘君一中之。\n顾此风霜景，阔哉牛女期。\n梅花山馆里，谁问敝衣缁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20591,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"田间行乐","author":"丘葵","text":"一年又朱夏，残生如白鸥。\n未须愁热去，且得及清游。\n数点雨初下，千沟水尽流。\n谁家田万顷，绿到海西头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20592,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"田舍 其一","author":"丘葵","text":"久旱割丰穰，群童拾穗忙。\n早炊留客饭，新酿唤翁尝。\n庭上豆萁满，篱边蔬甲长。\n腰镰砍草木，准拟撑攲桑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20593,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"田舍 其四","author":"丘葵","text":"割馀田有鹤，食罢案多蝇。\n裒谷为秋赛，燃薪当夜灯。\n老牛背觳觫，爨妇髻鬅鬙。\n应是无心问，朝家发与兴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20594,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"白鹭","author":"丘葵","text":"众禽无此格，玉立一閒身。\n清似参禅客，癯如辟谷人。\n绿秧青草外，枯苇败荷滨。\n口体犹相累，终朝觅细鳞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20595,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"龙湖观人钓鱼","author":"丘葵","text":"野客双蓬鬓，溪童一钓竿。\n得鱼何与我，对境自成欢。\n日暮欲归去，支筇更一看。\n淡红千草烛，浓绿万花盘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20596,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"龙湖道中","author":"丘葵","text":"冬行缘底意，倚杖陟高冈。\n日色带霜淡，风声过海狂。\n林鸦山外黑，野菜麦中黄。\n腊月明朝是，栖栖尚异乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20597,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再次前韵呈吴天游居士","author":"丘葵","text":"心在江湖身在城，暂分禅座觉神清。\n秋深竹叶敲窗响，昼静蕉花照眼明。\n吟罢灯前窥佛偈，梦回枕上数钟声。\n未能参透庞居士，安得师门掉臂行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20598,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吕所盘已回故居月馀日忽忆旧时与游因约再访","author":"丘葵","text":"匆匆别后又秋凉，佳句遥知塞锦囊。\n闻道拾遗流落久，归寻小隐钓游乡。\n旧时邻曲浑如梦，此日江东欲断肠。\n拟待梅花携斗酒，访君船泊小溪傍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20599,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"尘世","author":"丘葵","text":"尘世无暇日，偷閒到晓亭。\n桥阴界水绿，烧迹断山青。\n石瘦牛磨角，檐空雀坠翎。\n暮笳风外响，愁坐若为听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20600,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次长卿韵","author":"丘葵","text":"秋尽始相见，宵残即语离。\n将归悲宋玉，不饮愧袁丝。\n送远意未惬，思家兴颇随。\n可怜镜山夜，未与小盘期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20601,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次吕之寿韵寄肯体","author":"丘葵","text":"甚矣吾衰也，时哉道亦然。\n诗书舆脱輹，岁月箭辞弦。\n所欠惟一死，斯须便百年。\n细思禽与犊，等是食和眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20602,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次吴文之韵","author":"丘葵","text":"江湖漫浪两狂生，别后相思月一庭。\n期子未来灯是伴，逐贫不去笔无灵。\n诗书东阁头空白，势利迷人眼孰青。\n安得世无黄口辈，遍游天下作蜻蜓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20603,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次所盘山村","author":"丘葵","text":"溪外青山山外村，数间茅屋掩柴门。\n青裙灶下偷窥客，白发堂中笑弄孙。\n乞火煮茶烧土锉，隔篱贳酒举匏尊。\n梅花不解留人住，山路归来已夕昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20604,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵吕之寿见忆","author":"丘葵","text":"日暮客送客，此情悲复悲。\n栖栖吾老矣，寂寂子何之。\n跬步便相忆，论心未有期。\n江湖成底事，空使素衣缁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20605,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵徐学正九日","author":"丘葵","text":"秋逢重九亦将阑，换得黄花青草颜。\n节物只能催我老，人生那得似云閒。\n有心采菊非知菊，无意看山却见山。\n欲识渊明得真趣，夕阳倦鸟正飞还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20606,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]