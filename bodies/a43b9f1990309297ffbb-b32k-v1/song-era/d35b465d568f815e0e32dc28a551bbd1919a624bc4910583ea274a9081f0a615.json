[{"title":"十咏图 其六 归燕","author":"张维","text":"社燕秋归何处乡，群雏齐老稻青黄。\n犹能时暂栖庭树，渐觉稀疏度苑墙。\n已任风庭下帘幕，却随烟艇过潇湘。\n前春认得安巢所，应免差池拣杏梁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55844,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十咏图 其三 玉蝴蝶花","author":"张维","text":"雪朵中间蓓蕾齐，骤开尤觉绣工迟。\n品高多说琼花似，曲妙谁将玉笛吹。\n散舞不休零晚树，团飞无定撼风枝。\n漆园如有须为梦，若在蓝田种更宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55845,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十咏图 其四 孤帆","author":"张维","text":"江心云破处，遥见去帆孤。\n浪阔疑升汉，风高若泛湖。\n依微过远屿，彷佛落荒芜。\n莫问乘舟客，利名同一途。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55846,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十咏图 其十 贫女","author":"张维","text":"蒿簪掠鬓布裁衣，水鉴虽明亦懒窥。\n数亩秋禾满家食，一机官帛几梭丝。\n物为贵宝天应与，花有秋香春不知。\n多少年来豪族女，总教时样画蛾眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55847,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十咏图 其二 庭鹤","author":"张维","text":"戢翼盘桓傍小庭，不无清夜梦烟汀。\n静翘月色一团素，闲啄苔钱数点青。\n终日稻粱聊自足，满前鸡鹜漫相形。\n已随秋意归诗笔，更与幽栖上画屏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55848,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十咏图 其七 闻砧","author":"张维","text":"遥野空林砧杵声，浅沙栖雁自相鸣。\n西风送响暝色静，久客感秋愁思生。\n何处征人移塞帐，即时新月落江城。\n不知今夜捣衣曲，欲写秋闺多少情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55849,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十咏图 其八 宿后陈庄","author":"张维","text":"腊冻初开苕水清，烟村远郭漫吟行。\n滩头斜日凫鹥队，枕上西风鼓角声。\n一棹寒灯随夜钓，满犁膏雨趁春耕。\n谁言五福仍须富，九十年馀乐太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55850,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘颖","author":"张维","text":"不贤那得似长城，偶向潢池盗弄兵。\n静沼何妨无事饮，幽寻聊记所居名。\n千山倒影湖新复，两洞潜珍景旋生。\n纪事还须武陵笔，亭成唯拟看题荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55851,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留守舍人张公安国闻维筑亭为题其榜曰朝阳既去而亭成复为赋诗次韵","author":"张维","text":"日边清切以文鸣，立对朝阳欲问程。\n笔落生春变寒谷，诗来将喜破愁城。\n檐前水到乘槎便，天际山横与槛平。\n准拟公归道过此，小留觞咏集簪缨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55852,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十咏图 其五 宿清江小舍","author":"张维","text":"菰叶青青绿荇齐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55853,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"静乐轩喜成","author":"张谔","text":"山县为官不见山，一朝列嶂忽当关。\n抽身牒诉时舒眼，领客杖藜聊解颜。\n常乐本来由我静，倦飞每尔愧知还。\n莫嫌邑小仍兼陋，曾有涪翁赏是间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55854,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"张逸","text":"一夜碧澜堂上坐，直疑身在水晶宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55855,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"张逸","text":"遥看山水有云处，便是人心无事乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55856,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"广胜寺","author":"张傅","text":"亭险高登畏力微，放怀堪此养天机。\n下窥平野遥无际，仰视危檐势欲飞。\n常日群猿偎槛戏，有时晴霭拂窗归。\n旌轩暂驻聊凝睇，应笑尘中万事非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55857,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"昭君怨 园池夜汎","author":"张镃","text":"月在碧虚中住。\n人向乱荷中去。\n花气杂风凉。\n满船香。\n云被歌声摇动。\n酒被诗情掇送。\n醉里卧花心。\n拥红衾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55858,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 芭蕉","author":"张镃","text":"风流不把花为主。\n多情管定烟和雨。\n潇洒绿衣长。\n满身无限凉。\n文笺舒卷处。\n似索题诗句。\n莫凭小阑干。\n月明生夜寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55859,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游洞霄宫 其二","author":"张巽","text":"新晴草木翠光流，麦陇清和四月秋。\n巽二风来山发冷，阿香雷过馨声幽。\n杜鹃鬨枕催归去，丁鹤攀辕欲借留。\n半夜忽闻岩壑响，小诗调戏鬼神愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55860,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游洞霄宫 其一","author":"张巽","text":"掣开九锁谒琳宫，物色真仙剑履踪。\n一朵云根生老涧，千寻天柱压群峰。\n功名秘略求黄石，呼吸微言敩赤松。\n我是康庐倦游客，朅来犹爱翠云重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55861,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游洞霄宫 其三","author":"张巽","text":"曜相偏羸足力强，不辞复岭与重岗。\n未穷仙隐千年迹，先炷宸游一瓣香。\n诗得好题难驻笔，酒逢佳趣便飞觞。\n梦回彷佛前身事，却认金庭是故乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55862,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题常山店壁","author":"张惠卿","text":"迢递投前店，飕飗守破窗。\n一灯明复暗，顾影不成双。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55863,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿灵岩寺","author":"张揆","text":"再见祇园树，流光二十年。\n依然山水地，况是雪霜天。\n阁影移寒日，钟声出暝烟。\n微官苦奔走，一宿亦前缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55864,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺新郎","author":"张敬斋","text":"卓茕欧阳子，是江山、毓秀钟灵，异才间世。\n恰则韶光三月暮，蓂叶尧阶有四。\n正天启、悬弧盛事。\n金鸭亭亭书云篆，散非烟、南极真仙至。\n来为尔，荐嘉瑞。\n神清洞府丹书字。\n拥笙歌、绮席高张，更罗珠翠。\n个里长春人不老，仙籍玉环暗记。\n但判取、醄醄沈醉。\n拟作新诗八千首，待一年、一献称俾尔。\n耆而艾，昌而炽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55865,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题董真人","author":"张景","text":"桃花谩说武陵源，误教刘郎不得仙。\n争似莲花峰下客，栽成红杏上青天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55866,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诗一首","author":"张景","text":"我非东方儿，不是牛耕土。\n欲识我踪迹，一气万物母。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55867,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"探梅","author":"张景","text":"跨蹇度溪桥，处处寻春信。\n青枝摊蓓蕾，唤仆频频认。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55868,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其三","author":"张景","text":"若以山形比人骨，此池应合似泥洹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55869,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"张景","text":"两岸绿杨遮虎渡，一番青草覆龙洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55870,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"张景","text":"新粟米炊鱼子饭，嫩冬瓜煮鳖鱼裙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55871,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"选冠子 其一","author":"张景修","text":"嫩水挼蓝，遥堤映翠，半雨半烟桥畔。\n鸣禽弄舌，蔓草萦心，偏称谢家池馆。\n红粉墙头，柳摇金缕，纤柔舞腰低软。\n被和风、搭在阑干，终日绣帘谁卷。\n春易老，细叶舒眉，轻花吐絮，渐觉绿阴垂暖。\n章台系马，灞水维舟，追念凤城人远。\n惆怅阳关故国，杯酒飘零，惹人肠断。\n恨青青客舍，江头风笛，乱云空晚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55872,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"虞美人","author":"张景修","text":"春风曾见桃花面。\n重见胜初见。\n两枝独占小春开。\n应怪刘郎迷路、又重来。\n旁人应笑髯公老。\n独爱花枝好。\n世间好景不长圆。\n莫放笙歌归院、且尊前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55873,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九月望夜与诗僧可久泛西湖","author":"张景脩","text":"山风猎猎酿寒威，林下山僧见亦稀。\n怪得题诗无俗语，十年肝鬲湛清辉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55874,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"延真秋屏轩","author":"张景脩","text":"鸟回山色隐如城，碧落人归依旧青。\n好向中间安一榻，何须更画绕床屏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55875,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"更高亭","author":"张景脩","text":"稚子山妻伴老翁，重阳寻遍菊花丛。\n明年把酒知何处，却忆高亭是梦中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55876,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贫居","author":"张景脩","text":"茅檐月有千金税，稻饭年无一粒租。\n生事萧条人问我，水芭蕉与石菖蒲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55877,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题开福院白莲堂","author":"张景脩","text":"玉色荷花自是仙，道人更慕远公贤。\n此生欲结东林社，求取新诗十八篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55878,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"崇教寺筠轩","author":"张景脩","text":"碧玉窗棂三四閒，一溪流水伴君閒。\n雪中惜取青青节，不用开林自见山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55879,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游栖霞宫","author":"张景脩","text":"偶先诸邑过栖霞，恰费卢仝七碗茶。\n此会果然□邂逅，转相寻觅到仙家。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55880,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题北山松轩","author":"张景脩","text":"雪天苍翠暑天风，珍重僧轩十八公。\n不是时人少吟咏，世閒花草易为工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55881,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三贤堂","author":"张景脩","text":"如是国清寺，宜乎天下闻。\n水声常夜雨，山气即朝云。\n今古三贤隐，仙凡两路分。\n唐人书画在，明日更慇勤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55882,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"石桥","author":"张景脩","text":"天与晴来抵万金，更逢诗伯共登临。\n辍公一夜楞严讲，慰我十年方广心。\n白雪阳春虽寡和，高山流水有知音。\n石桥天下无双景，好尽平生得处吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55883,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过桐庐邑二首 其二","author":"张景脩","text":"三载江南客，还吴东复西。\n潮贪两溪尽，云截众山齐。\n舟楫无空日，楼台半上梯。\n桐庐隐君子，应笑只留题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55884,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过桐庐邑二首 其一","author":"张景脩","text":"隐君无姓字，何代至今存。\n数里山为宅，两株桐是孙。\n人烟半峰碧，溪水带潮浑。\n多少来游客，茫茫蹋药根。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55885,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"钓台","author":"张景脩","text":"羊裘东汉客，归隐钓鱼滩。\n天子不能屈，先生非苟难。\n云藏古石在，风激世人寒。\n祠下青青竹，何妨把钓竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55886,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿清溪安乐山","author":"张景脩","text":"映窗犹剩雪馀痕，瓶里梅花枕上闻。\n一椀镫寒听夜雨，半床毡暖卧春云。\n诗成始觉茶销睡，香尽翻嫌酒带醺。\n我是挂冠林下客，山中安乐合平分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55887,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄湖南宪请祠叶公","author":"张景脩","text":"闻说年来请洞霄，江湖奉使久勤劳。\n有神仙处閒方得，用老成时退更高。\n借宅但知新种竹，寻真想见旧栽桃。\n浮梁居士尘埃甚，须发而今已二毛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55888,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清芬阁","author":"张景脩","text":"严子钓台畔，犹闻吟啸声。\n荣华付诸弟，萧洒继先生。\n自制茶枪嫩，新开酒面清。\n红尘不抛摆，那得白云名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55889,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游九锁山","author":"张景脩","text":"九锁山中多隐仙，洞门终古掩云烟。\n茶生东坞偏迎日，松老西岩不记年。\n翠箬久藏千岁药，碧池深纳半山泉。\n苍崖纵使秦驱得，未信能移一柱天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55890,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湖州觉海弥陀阁","author":"张景脩","text":"仙潭觉海唐兴善，像设瑰琦古至今。\n殿柱倒书雷部火，市桥横渡木观音。\n窗前竹影摇金翠，风外莲香散水沉。\n况有弥陀新建阁，动人无限往生心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55891,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"福应山","author":"张景脩","text":"南亭不减北邙高，美景因公见一朝。\n已看溪山如在画，更传风雅似闻韶。\n栽桃定有仙家住，种竹宁无隐者招。\n秀气当为多士福，未应都放与渔樵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55892,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"醉眠亭","author":"张景脩","text":"樽前从客笑，梦里任花飞。\n野鸟唤不醒，家童扶未归。\n有荣还有辱，无是即无非。\n万事藏于酒，先生亦见机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55893,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题永庆览胜亭","author":"张景脩","text":"衙城直上有烟峦，亭在悬崖绝壁间。\n几个白头忘岁月，一生青眼看江山。\n秋风落木楼台出，暮雨笼沙鸥鹭閒。\n珍重京西绣衣使，作书题榜许追攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55894,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题玉泉","author":"张景脩","text":"长疑数尺玉，乃是一方泉。\n粉色和云汲，茶香带石煎。\n鉴来诚美矣，闻处合铿然。\n白首惠山客，也须吟此篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55895,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题竹轩","author":"张景脩","text":"种竹才添十数竿，题诗已仅百馀篇。\n有时碎影摇金地，尽日清风伴玉泉。\n不与爱鱼人把钓，肯教骑马客求鞭。\n平生最喜此君子，一洒何当听雨眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55896,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送朱天锡童子","author":"张景脩","text":"黄金满籯富有馀，一经教子金不如。\n君家有儿不肯娱，口诵七经随卷舒。\n渥洼从来产龙驹，鸑鷟乃是真凤雏。\n一朝过我父子俱，自称穷苦世为儒。\n雪窗夜映孙康书，春陇昼荷儿宽锄。\n翻然西入天子都，出门慷慨曳长裾。\n神童之科今有无，谈经射策皆壮夫。\n古来取士凡数涂，但愿一一令吹竽。\n甘罗相秦理不诬，世人看取掌中珠。\n折腰未便赋归欤，待君释褐还乡闾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55897,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题无垢寺","author":"张景脩","text":"禅房闭深花，锡杖生古藓。\n秋山翡翠寒，春水玻瓈软。\n无嫌墙太低，但恐路不远。\n何人坐长松，令我思韦偃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55898,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题宁国县十全堂","author":"张景脩","text":"医莫以人试，药能生死人。\n十失为一次，望而知谓神。\n尝闻秦医和，诊君知其臣。\n岂无肘后方，埋没随埃尘。\n韫师以愈疾，犹如臂屈伸。\n华佗医之良，思邈医之真。\n谁能不服药，一一如朱云。\n斯堂名十全，全人亦全身。\n方公谙药性，勇退盖此因。\n金玉不足宝，人生系悲忻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55899,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题梅山","author":"张景端","text":"作尉南昌日，投书北阙频。\n忠言不悟主，直节耻为臣。\n汉室多灾异，吴门念隐沦。\n挂冠忘宠辱，蒙袂出埃尘。\n虹屈英雄气，鸥群自在身。\n永怀三洞诀，高谢九江春。\n择地开仙馆，看云剪寿巾。\n玄台秋步月，虚室夜凝真。\n无梦生芳草，留年养大椿。\n碧茸香不断，青鸟性偏驯。\n太液刀圭就，中黄道路新。\n武夷空坠马，郁木竟栖神。\n绛节虽朝帝，灵波尚济民。\n一名传旧史，千古事严禋。\n瑞气生仙药，清风付羽人。\n坛遗金鼎像，井锁玉华津。\n地接洪崖府，溪通剑水滨。\n鹤归云抖擞，龙起石鳞皴。\n已悟身为患，元期德有邻。\n青山不忘我，今日是天亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55900,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅","author":"严参","text":"何年流水恨，昨夜小桥春。\n纵有相逢地，都无可寄人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55901,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仙华重午","author":"张森","text":"空山值端午，采蒲南涧滨。\n蒲生裹白石，涧水清粼粼。\n蟠根寸九节，服食能通真。\n采之不盈掬，土洁含芳辛。\n行行登绝境，有花如车轮。\n奇哉世莫识，持扣山中人。\n山人耳垂肩，羽佩青衣巾。\n乘飙控玄鹤，汎景下苍岷。\n我行意其仙，再拜询所因。\n仙人揽花笑，见尔还千春。\n语我勿复道，倏去无留尘。\n归来有馀叹，三咽华池津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55902,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宁寿寺","author":"张湖山","text":"丹级才升四望赊，香销无复梦豪华。\n向来马氏殚禅力，要拟龙宫作佛家。\n树老烟霜台殿古，石封苔藓井栏斜。\n上人不用莲花漏，自有林梢报晓鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55903,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"张湜","text":"吴山空对越山明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55904,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"官柳","author":"张琰","text":"不见桥东黄布帘，树犹如此我何堪。\n袅袅亭亭忒无赖，又将春色误江南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55905,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出塞曲 其一","author":"张琰","text":"腰间插雄剑，中夜龙虎吼。\n平明登前途，万里不回首。\n男儿当野死，岂为印如斗。\n忠诚表壮节，灿烂千古后。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55906,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"失调名","author":"张琳","text":"持节助调羹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55907,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨中自万寿宫归","author":"张琼","text":"草草登临未拟回，烟昏雨湿赋归哉。\n山寒未放迁莺出，地胜先闻驾鹤来。\n老去春光都是梦，懒边心事总如灰。\n归寻药裹扶筋力，准拟东风得屡陪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55908,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"朱槿花","author":"张登","text":"甲子虽推小雪天，刺桐犹绿槿花然。\n阳和长养无时歇，却是炎州雨露偏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55909,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"洞石岩","author":"张登","text":"山断开元蝎，龛留大业僧。\n七年驰便路，三蹑石梯层。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55910,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留题熙春亭","author":"张登","text":"熙春亭建为民安，要识熙熙本不难。\n一日但能先克复，百年虽久亦胜残。\n满城和气薰天地，终岁长春忘暑寒。\n斯道古今无异路，独题待与后贤看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55911,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]