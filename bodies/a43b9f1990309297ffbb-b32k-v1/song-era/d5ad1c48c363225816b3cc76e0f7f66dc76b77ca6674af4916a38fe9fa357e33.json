[{"title":"登楼感事寄天台友人","author":"释智圆","text":"闲倚危栏思黯然，浮生谁共叹流年。\n愁催华发生无极，心许青山未有缘。\n冷淡空江澄暮色，参差归雁没寒烟。\n吟馀更羡林间客，高卧深云听瀑泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19745,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢可牧上人惠楞严般若二经并治脾药","author":"释智圆","text":"经妙荡烦惑，药灵医病身。\n道明无去住，方验有君臣。\n静玩知心寂，时餐觉气均。\n徘徊感知己，于我分弥亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19746,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢择梧律师惠竹杖","author":"释智圆","text":"剪自幽岩侧，高僧忽见遗。\n看云攲尽日，书雪握多时。\n节冷虫微蠹，根闲藓暗滋。\n旧山泉石在，归去赖扶持。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19747,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赋得送人自阙下还吴","author":"释智圆","text":"莼羹鲈脍美，张翰忽思归。\n烟水东南阔，风帆旦夕飞。\n静吟新月正，闲望旧山微。\n独羡长江上，遗名掩竹扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19748,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鍊丹井","author":"释智圆","text":"仙去遗踪在，泠泠翠岳边。\n泠光涵碧甃，暗脉泄寒泉。\n月映冰壶浅，秋澄古鉴圆。\n羽人居止近，闲汲灌芝田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19749,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雁","author":"释智圆","text":"岁岁随阳整羽翰，翱翔还见过云端。\n哀音断续霜风紧，群影参差夜月残。\n雕鹗已逃榆塞险，烟波初下洞庭宽。\n行人万里思归切，送目遥空寄信难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19750,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新栽小松","author":"释智圆","text":"新种孤松一尺馀，淡烟疏竹便相宜。\n闲来且玩凌霜貌，身后谁观合抱时。\n冷碧岂容尘染污，贞心宁共草凋衰。\n夜深庭际清风起，细韵难教俗耳知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19751,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬仁上人望湖山见寄次韵","author":"释智圆","text":"平波映危碧，清景异尘中。\n雪霁寒侵郭，秋澄冷照空。\n眠云徒自乐，浮棹约谁同。\n幽趣何人识，搜吟愧远公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19752,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬正言上人","author":"释智圆","text":"旅雁声孤过旧林，相怀无处共论心。\n眠云未负他年约，看雪难忘尽日吟。\n江上信稀寒浪阔，竹边房掩夕阳深。\n寂寥闲坐西窗下，空把馀情寄玉琴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19753,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"暮秋","author":"释智圆","text":"嗈嗈宾雁又随阳，兔走乌飞两共忙。\n露冷小池荷减绿，风高幽砌菊添黄。\n圆明自喜心如月，皓白谁愁鬓似霜。\n闲卧不堪思往事，星河耿耿夜偏长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19754,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"潮","author":"释智圆","text":"罗刹江心起，晨昏信不差。\n寒声喧极浦，秋势卷平沙。\n望立人心险，惊飞鸟影斜。\n来源争可问，沧海况无涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19755,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题湖上僧房","author":"释智圆","text":"深隐远城郭，平湖景色闲。\n苦吟终夜月，清梦彻寒山。\n径冷秋苔合，庭幽岳鸟还。\n红尘趋竞者，谁得扣松关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19756,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题静虑院","author":"释智圆","text":"下瞰诸峰顶，云泉绝四邻。\n暂游非俗客，深隐属闲人。\n石磴秋苔滑，萝龛夜月新。\n终期结幽侣，来此谢红尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19757,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题聪上人林亭","author":"释智圆","text":"四面远尘迹，吟过称野情。\n阶闲秋果落，池冷月华生。\n倚竹蝉声断，开琴鹤梦惊。\n却来还有约，未可厌逢迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19758,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠白莲社主圆净大师","author":"释智圆","text":"社客尽卿相，草堂云树间。\n景分庐岳秀，人类远公闲。\n夜定开明月，秋吟对暮山。\n唯应谢康乐，时得扣松关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19759,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠夷中师","author":"释智圆","text":"澹泊背时态，翛然尘外心。\n静吟霜月尽，归梦海云深。\n室冷苔生榻，窗闲鸟觑琴。\n幽栖共得趣，乘兴几相寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19760,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠守能师","author":"释智圆","text":"高卧湖山畔，尘机任万端。\n连云吟阁静，度水讲钟寒。\n幽户碧嶂闭，新书雪夜刊。\n却应趋竞者，相笑隐林峦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19761,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠邦上人","author":"释智圆","text":"深居饶野兴，门冷入杉松。\n鸟外闲频往，人间事罕逢。\n水轩吟片月，秋榻梦千峰。\n忆得看新雪，相招静话重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19762,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠进士叶授","author":"释智圆","text":"旅迹飘然与俗分，动时高价逐新文。\n寄眠僧舍扃秋雨，牵梦家山隔海云。\n学慕丘轲方共语，道归杨墨任离群。\n名场好应同人举，垂拱明堂有圣君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19763,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠林逋处士","author":"释智圆","text":"深居猿鸟共忘机，荀孟才华鹤氅衣。\n满砌落花春病起，一湖明月夜渔归。\n风摇野水青蒲短，雨过闲园紫蕨肥。\n尘土满床书万卷，玄纁何日到松扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19764,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠诗僧保暹师","author":"释智圆","text":"吟槛漾寒水，平湖烟景闲。\n无人识高趣，尽日对空山。\n晚树春禽语，晴窗夜月还。\n新编皆雅正，不待仲尼删。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19765,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠宣密大师不出院","author":"释智圆","text":"侯门休请谒，香火务真修。\n古院扃苍藓，他山空旧游。\n出禅庭月晓，开卷竹窗秋。\n已得栖幽趣，何须买沃洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19766,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠诵经僧","author":"释智圆","text":"寂淡无馀念，泠泠诵佛言。\n清香飘静夜，明月冷闲轩。\n幽壑来精怪，霜林息断猿。\n堪嗟浮世里，尘事竞暄暄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19767,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠郝逸人","author":"释智圆","text":"故国伊川远，深居碧嶂前。\n伴吟唯有鹤，高趣别无仙。\n岳信闲慵答，丹经秘不传。\n杖藜时访我，终日话南禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19768,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠闻聪师","author":"释智圆","text":"淡然尘虑绝，禅外苦风骚。\n性觉眠云僻，名因背俗高。\n水烟蒸纸帐，寒发涩铜刀。\n几宿秋江寺，闲吟听夜涛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19769,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠骆偃","author":"释智圆","text":"才高淹下位，圣代尚遗贤。\n贾谊方流涕，杨雄正草玄。\n开琴逢皓月，试茗选清泉。\n箧有文编在，时容后学传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19770,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠清义律师","author":"释智圆","text":"律藏精持世所稀，淡然高趣自忘机。\n禅开静室苍苔遍，饭起闲窗独鸟归。\n雪岳夜钟清度枕，水轩秋月冷侵衣。\n吟馀讲罢无他事，人外时容扣竹扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19771,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠清晓师","author":"释智圆","text":"道胜尘机息，讲馀林叶枯。\n清名高卧远，黑发苦吟无。\n庭静秋云澹，窗闲夜月孤。\n时闻适幽兴，上阁望平湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19772,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠简上人","author":"释智圆","text":"澹然人外趣，万事已无求。\n花院春深讲，云山夏满游。\n汲泉苔井晓，鸣磬竹窗秋。\n别有幽期在，香灯老沃洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19773,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠僧","author":"释智圆","text":"诸祖参寻遍，消摇发未华。\n旧房扃海外，孤迹寄天涯。\n琢句秋窗月，观空晚砌华。\n时来说高趣，终去隐烟霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19774,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠辩才大师","author":"释智圆","text":"两受皇恩万虑休，浙阳高卧谢诸侯。\n定回幽室苔痕老，讲彻闲庭树影秋。\n天竺云泉时挂梦，梁园风景懒重游。\n溪声柏子将谁说，默倚禅床自点头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19775,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鹭鸶","author":"释智圆","text":"烟雨苇森森，飞翔岂易寻。\n印沙踪自浅，傍水意还深。\n顶撼丝难断，翎飘雪未沈。\n终宜鸳作侣，宁肯杂凡禽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19776,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"远山","author":"释智圆","text":"堆青才数点，杳杳几千程。\n幽槛叶初落，高空雨乍晴。\n崔嵬微有状，窈窕莫知名。\n招隐谁长往，眠云自动情。\n文君眉易似，摩诘画难成。\n鸟去何曾到，泉流岂觉声。\n经秋弥冷淡，向晚更分明。\n仁者由来好，闲观意不轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19777,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"孤山诗二首 其一","author":"释智圆","text":"峭拔湖心起，湖心四望通。\n盘根入巨浸，叠翠点寒空。\n势迥侔蓬岛，层危敌阆风。\n僧楼笼淡雾，雁塔碍飞鸿。\n晓井金沙粲，晴坡玛瑙红。\n喷云春雨外，照影夕波中。\n野蔓垂枯柏，疏钟匝梵宫。\n闲泉澄极顶，幽径入深丛。\n古迹谈皆异，秋屏写未同。\n乐游非俗客，静望属渔翁。\n买去知无价，栖来思岂穷。\n翻嗟市朝里，尘土日濛濛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19778,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"试笔","author":"释智圆","text":"城市居无分，山林住有缘。\n语惭甘似荠，道贵直如弦。\n兀兀吟终日，羸羸病过年。\n静招湖畔鹤，闲泛雪中船。\n散闷虽无酒，怡情喜有禅。\n鬓根霜任点，心迹火休然。\n冷淡将谁合，消摇且自怜。\n闲来窗下坐，试笔偶成篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19779,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄所知","author":"释智圆","text":"宠辱不关念，扬名日更新。\n但怜君道在，宁顾谪官频。\n故国抛天外，全家寄水滨。\n堂空巢少燕，门冷谒无人。\n直气终干斗，刚肠肯泣麟。\n逍遥轻嗣立，乾没笑安仁。\n爱主长思阙，寻幽且养神。\n伴闲初种竹，出使旧埋轮。\n佞舌终期断，民冤必为伸。\n他年修史传，谁可继清尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19780,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上方院","author":"释智圆","text":"禅扉开绝顶，海色映层峦。\n刹影浸寥泬，钟声度渺漫。\n荒苔幽径滑，冬雪暮窗寒。\n吟罢慵回首，迟迟独凭栏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19781,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山中与友人夜话","author":"释智圆","text":"草舍闲宵坐，消摇事可评。\n澄心防有著，深隐贵无名。\n砌月移松影，风泉混磬声。\n共期吾道在，万事任营营。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19782,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山中自叙","author":"释智圆","text":"闭门业文翰，谁谓溪山陋。\n闲卧贵道肥，谁谓形容瘦。\n斯言欲无玷，内省庶不疚。\n深识浅江海，宽量窄宇宙。\n邻女少学嚬，海夫多逐臭。\n时来松下坐，清风满怀袖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19783,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山中行","author":"释智圆","text":"苒苒岩上云，潺潺涧中水。\n山鸟如唤人，喃喃深林里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19784,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居招友人诗","author":"释智圆","text":"结宇平湖滨，放意且闲逸。\n陵峰时采药，服饵蠲故疾。\n藜藿可供餐，茆茨可容膝。\n浮生贵适性，何须羡奢佚。\n清景况在目，万事安能恤。\n水天争冷落，林峦共盘郁。\n有时泛舟归，闲门晒残日。\n径荒人迹绝，庭静精怪出。\n春羹漾紫莼，冬盘列黄橘。\n坎井亦已乐，尺蠖谁云屈。\n外境莫我惑，贞心长抱一。\n涅槃终极典，虚堂每谈述。\n不顾知者希，庶欲己无失。\n齐物鄙庄周，见性师妙吉。\n翛然混生佛，湛尔无虚实。\n知音来不来，时时扫幽室。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19785,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中秋待月值雨","author":"释智圆","text":"一岁期今夕，高空雨忽零。\n虚窗沈素影，疏竹动秋声。\n已被云阴闭，徒怀永夜明。\n徘徊倚山阁，谁见此时情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19786,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"少年行","author":"释智圆","text":"儿奴屡背约，辱我汉天子。\n瞋目而语难，五陵年少子。\n举手提三尺，报国在一死。\n匹马立奇勋，壮哉傅介子。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19787,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"心交如美玉","author":"释智圆","text":"心交如美玉，经火终不热。\n面交如浮云，顷刻即变灭。\n对坐成参商，咫尺成胡越。\n我有心交者，不见几岁月。\n山叠水茫茫，含情向谁说。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19788,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"忆龙山院兼简蟾上人","author":"释智圆","text":"幽景远嚣俗，重来兴未穷。\n钟声翠微里，刹影碧溪中。\n地冷庭松瘦，门闲野径通。\n几因深夜话，密雪下寒空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19789,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"代书寄奉蟾上人","author":"释智圆","text":"君居武康山，昔年我曾游。\n崎岖松径寒，冷落竹房秋。\n握手既欢笑，拂榻且相留。\n一驻十旬馀，旦夕乐清幽。\n因话净名事，涤砚勉操修。\n蛮香爇古篆，山茶分越瓯。\n看雪同拥炉，乘月共浮舟。\n喻心指太虚，视世类浮沤。\n明春我归去，湖上隐林丘。\n杜门过五载，脾疾日少瘳。\n闲宵坐月下，往事来心头。\n书之将寄君，路远水悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19790,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"古人与今人","author":"释智圆","text":"古人与今人，禄仕一何异。\n古今贵行道，今人贵有位。\n古人贵及亲，今人贵说意。\n古人同白日，光明溢天地。\n今人如履险，动足易颠坠。\n古道如可行，斯言不遐弃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19791,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"古剑","author":"释智圆","text":"精刚经百鍊，可折不可柔。\n三尺青蛇活，一匣止水秋。\n解截蛟龙躯，能断佞臣头。\n下去苍生害，上除天子雠。\n在昔埋酆城，精光射斗牛。\n雷焕张华辈，得之亦悠悠。\n二贤既云亡，潭底化双虬。\n剑利人或爱，剑道人不求。\n剑道如之何，达者惟庄周。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19792,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"古琴诗","author":"释智圆","text":"良工采峄桐，斲为绿绮琴。\n一奏还淳风，再奏和人心。\n君子不暂去，所贵禁奢淫。\n后世惑郑声，此道遂陆沈。\n朱丝鼠潜齧，金徽尘暗侵。\n冷落横闲窗，弃置岁已深。\n安得师襄弹，重闻大古音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19793,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"古意","author":"释智圆","text":"登山伐樵柯忽折，临井汲泉绠仍绝。\n音信不来无处说，朔风飘飘满天雪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19794,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"古鉴","author":"释智圆","text":"土蚀菱花有微窍，悬向秋堂光照耀。\n写出人人妍丑姿，西施始免嫫母笑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19795,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"正月晦日作","author":"释智圆","text":"春晴残日照平川，老幼相携古岸边。\n富贵在天谁肯信，临流争放送穷船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19796,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同友人宿山院","author":"释智圆","text":"共依清境宿，话道复论文。\n潭月秋深见，山钟夜后闻。\n虫声沉古砌，萤影没残云。\n会约长栖此，炉香树下焚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19797,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"早秋","author":"释智圆","text":"雨歇变气候，空庭叶飕飕。\n闲听一夜风，乃知千里秋。\n百虫鸣四壁，新月生高楼。\n登楼看明月，清光满林丘。\n人生呼吸间，何为苦忧愁。\n发白不再黑，兔走难暂留。\n徘徊感古人，劝我秉烛游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19798,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自勉","author":"释智圆","text":"达人贵无念，市朝亦山林。\n曲士居山林，难息市朝心。\n坐驰一室中，纷然万境侵。\n纽兰羡佩玉，坐石思黄金。\n羊质虎其皮，隼翼凤其音。\n志在求世利，口唱无生吟。\n吾非斯人徒，夷旷期复古。\n去住既任缘，喧静亦随所。\n陶然且无求，相命何足语。\n人生百岁寿，稀得七十死。\n吾今四十五，气力渐无似。\n去年成二毛，今年动一齿。\n纵得至七十，光阴能几许。\n学道宜无疲，进善宜无止。\n自馀百杂就，克己尽除去。\n勉强扶幻躯，旦暮加药饵。\n此身乃外物，何况外于是。\n内外一如梦，勉矣当观此。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19799,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"舟归","author":"释智圆","text":"平湖渺渺澄寒水，孤舟静泛清光里。\n却惭未是狎鸥人，处处凫鹥尽惊起。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19800,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"舟次游乾元寺","author":"释智圆","text":"古树垂清阴，维舟暂登陟。\n闲吟尘想绝，久坐天籁息。\n幡影飏晴空，溪光澄暮色。\n挂帆寻去路，烟水查无极。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19801,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西施篇","author":"释智圆","text":"采莲越溪上，皆谓寻常女。\n正位吴中宫，众品方传美。\n视听厌歌舞，衣裳贱罗绮。\n贤哉邻家人，昔年知学嚬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19802,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"讲堂书事","author":"释智圆","text":"早玩台衡宗，佛理既研精。\n晚读周孔书，人伦由著明。\n达本与节躬，志在求同声。\n击蒙虽云劳，来学苦无成。\n杨雄玄尚白，仲尼道不行。\n青山梦中归，华发年来生。\n唯当照真空，万事从营营。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19803,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"吴山庙诗","author":"释智圆","text":"君子尚权变，权变贵合道。\n子胥荐专诸，子光专非好。\n父雠共戴天，乞师恨不早。\n子光既得志，入郢事征讨。\n报父既鞭尸，谏王仍杀身。\n孝子节方全，忠臣道且新。\n驰名天地间，岂是悠悠人。\n青史书盛烈，血食旌遗尘。\n庙堂耀晨曦，庙木荂阳春。\n往来无知俗，焚香勤祷祝。\n忠孝不敢行，神兮宁降福。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19804,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"怀保暹师","author":"释智圆","text":"高迹知何处，相怀早晚休。\n苦吟空对月，闭户更禁秋。\n砌隙寒虫切，林稍下叶稠。\n音书杳难寄，天阔水悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19805,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"拟洛下分题 茯苓人","author":"释智圆","text":"本自松根得，名因象物彰。\n为医君可信，除疾我偏良。\n济众应藏用，捐躯必自强。\n无劳问踪迹，名字在仙方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19806,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"拟洛下分题 递诗筒","author":"释智圆","text":"元白旧裁制，规模传至今。\n凌霜重高节，容物贵虚心。\n岂倦关河远，宁辩雨雪深。\n雅言如见托，终为报知音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19807,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]