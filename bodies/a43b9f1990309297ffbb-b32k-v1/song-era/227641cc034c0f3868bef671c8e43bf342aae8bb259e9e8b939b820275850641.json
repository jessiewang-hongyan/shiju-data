[{"title":"偈颂一百四十一首 其二十一","author":"释师范","text":"衲僧用处，了无定度。\n握土成金，握金成土。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29521,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十一首 其四十七","author":"释师范","text":"方交正月一，又过了五日。\n世事冗如麻，光阴劈箭急。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29522,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十一首 其一一七","author":"释师范","text":"无道可学，无禅可参。\n黄头碧眼，徒话指南。\n雾敛云收天宇宽，门前幸有千朵青山万朵青山，徘徊赢得倚栏干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29523,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送昙藏主雪峰见痴绝","author":"释师范","text":"世上有蛇皆可弄，南山鳖鼻不可动。\n动著冷口暗伤人，伤人至死未知痛。\n子今去也，当自著便宜。\n后日毒遭一口归来，莫道山僧不曾说与伊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29524,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"维摩居士赞 其二","author":"释师范","text":"示疾毗耶，平地风波。\n医不得处，病在口多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29525,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"破庵赞 其二","author":"释师范","text":"生平萧散，浑无羁绊。\n奋恶拳头，打会禅汉。\n我尝一见，口似匾檐。\n凡侍之者，莫知其几，往往瞠乎其后，终莫得其畔岸。\n是故不可毁，不可赞，至于不可奈何。\n但如今必要知其所窃之羊，谩去西边屋角头蜂桶里寻看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29526,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古三首 其二","author":"释师范","text":"晴空轰霹雳，官路栽荆棘。\n没兴遭逢著，前凶后不吉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29527,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"诗三首 其二","author":"无名氏","text":"妖魂受赐欲报郎，夜夜飞入重城里。\n幽诉千端郎不听，倾心吐肝犹不止。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29528,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"诗一首","author":"无名氏","text":"西出潼关客路迷，一葫芦酒一篇诗。\n葫芦酒尽兴未尽，坐看春山春尽时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29529,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"黄山","author":"无名氏","text":"三十六峰高倚天，瑶台金阙贮神仙。\n嵩阳若与黄山比，犹少灵砂一道泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29530,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"回文 其一","author":"无名氏","text":"春晚落花馀碧草，夜凉低月半枯桐。\n人随远雁边城暮，雨映疏帘绣阁空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29531,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"回文 其三","author":"无名氏","text":"羞看一首回文锦，锦似文君别恨深。\n头白自吟悲赋客，断肠愁是断弦琴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29532,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"开元寺留题 其二","author":"无名氏","text":"台阁相连驾远空，乱山烟霭夕阳中。\n眼前风物初非旧，惟有清凉一寺同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29533,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题蜕龙洞 其二 白茆洞","author":"无名氏","text":"白茆职此不知年，井窦回环会饮仙。\n遗迹空存春酒瓮，通天灵窍尚依然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29534,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送永嘉陈有辉","author":"真德秀","text":"深山读易如康节，白首谈玄似子云。\n肯学时流誇末技，却于圣处策奇勋。\n二图君已窥微指，十翼吾方愧浅闻。\n得意春风重过我，绿波清夜话羲文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29535,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"皇后阁端午贴子词五首 其四","author":"真德秀","text":"晓来金殿沐兰汤，因感骚人兴寄长。\n重劝君王勤采善，由来香草比忠良。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29536,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"通道朱宰求时斋字李肩吾赋诗次韵","author":"魏了翁","text":"朱君问时斋，为诵羲文书。\n夬终伏剥果，乾始函坤舆。\n坎离互藏宅，遇复更踦闾。\n物理消处息，人谋密中疏。\n即兹贯千古，何所非广居。\n是以无妄时，不耕穫菑畬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29537,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"昨有祷于社稷及境内山川是夕枕上闻雨 其二","author":"魏了翁","text":"中春天气似朱明，翕翕炎威恼乱人。\n一夜檐前天雨麦，晓来仍作本来春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29538,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夏至日祀阏伯于开元宫前三日省中斋宿 其三","author":"魏了翁","text":"朝罢归来政事堂，衣冠牣宇鹜成行。\n须臾排马还私第，一片閒庭锁夕阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29539,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵樊武仲致政见贻 其二","author":"魏了翁","text":"樊子诗来贺我迁，潮黄风节敢云班。\n长教下令流于水，岂愿高名重若山。\n霜过转愁天宇净，夜寒空载月明还。\n须知不遇非余欲，千载知言有辨奸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29540,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次李肩吾送安恕父回长沙韵 其四","author":"魏了翁","text":"自出脩门已及几，家人应赋柳依依。\n苟无饥渴吾何戚，见说齐东未解围。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29541,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和虞退夫韵 其三","author":"魏了翁","text":"假拙济奸真是拙，认奸作巧巧何曾。\n须知我自灵于物，一点光明万古镫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29542,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"冯校书挽诗","author":"魏了翁","text":"高志峥嵘局九州，直从人表着先筹。\n青囊书在鬼神泣，黄绢辞高冰雪羞。\n槐里但知矜折角，兰台无复问长头。\n玉棺夜入青云去，山是人非白鹤愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29543,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"李参政夫人张氏挽诗 其二","author":"魏了翁","text":"衔命龙荒日，危机呼吸閒。\n内言知勉正，时事迄多难。\n误国头颅去，和戎使节还。\n至今为厉梗，抚事不胜潸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29544,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"何府君挽诗 其二","author":"魏了翁","text":"橐装随宝剑，将水过荆州。\n世事云翻手，客程风打头。\n空回剡溪棹，莫挽海山舟。\n欲报何嗟及，堂堂閟一丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29545,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古十一首 其十","author":"释普济","text":"光境俱忘与未忘，杀人利剑活人鎗。\n太平时节浑无用，夜夜神光射斗旁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29546,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送梦窗和尚住净慈","author":"释普济","text":"志公有语问思大，东涧无言记梦窗。\n今日梦窗下山去，笑他思大舌头长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29547,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送李雁湖大参赴遂宁 其二","author":"吴泳","text":"恢恢大仪中，扶立惟三纲。\n国风怨以怒，王道荡无章。\n栖栖鲁东家，秉笔修天常。\n廉陛不乱纪，冠履不易方。\n斯今世运颓，礼义维楫亡。\n三边且病痱，群盗方鸱张。\n兵如溃堤蚁，民甚赪尾鲂。\n厉阶倘不夷，零露将侵裳。\n李侯世柱史，识此治乱防。\n挥袂别广筵，振衣登高冈。\n愿言茂远猷，挽河洒天狼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29548,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"小雪","author":"吴泳","text":"卧病连三月，起来几半人。\n腕柔妨草圣，目眩隔花神。\n颓魄岂常望，残芳不再晨。\n徘徊盼庭树，犹喜小阳春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29549,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和虞沧江赋梅 其五","author":"吴泳","text":"吟成亟取夜钟敲，淡月笼窗昏晓交。\n真态莫将形色看，当如相马得蒲梢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29550,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和虞沧江赋梅 其六","author":"吴泳","text":"万山春到直丛丛，谁省东皇有化功。\n生意溶溶呈露处，看随葵麦荡摇风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29551,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"嘉禾颂七章章四句","author":"吴泳","text":"翼翼嘉禾，在梁之亩。\n九穗离离，实栗实秀。\n其秀维何，奕叶有傩。\n春种秋实，备时中和。\n中和既时，重颖既垂。\n自向其本，岂不尔思。\n维昔唐叔，实施王命。\n伊今之人，惟唐叔是景。\n惟唐叔是景，献诸天子。\n天子不有，以归肇祀。\n芝生九茎，不可以为粳。\n狐生九尾，不可以为袂。\n实为我嘉谷，以谷我口腹。\n以妥以侑，式介多福。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29552,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过太行山 其一","author":"徐范","text":"茫茫远树隔烟霏，猎猎西风振客衣。\n山雨未晴岚气湿，溪流欲尽水声微。\n回车庙古丹青老，碗子城荒草木稀。\n珍重狄公千载意，马头重见白云飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29553,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过太行山 其二","author":"徐范","text":"路绕羊肠蹑屐跻，万山金碧总堪题。\n举头日月中天近，极目乾坤五岳低。\n自笑盐车骐骥厄，谁怜枳棘凤凰栖。\n欲投古寺禅房宿，喜见僧归落日西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29554,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其二","author":"黄梦得","text":"天意因以旌遗逸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29555,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅庄春间","author":"刘厚南","text":"最喜逍遥泉石间，幽居四面绕青山。\n苔迷荒径人稀到，花压重门昼自关。\n古刹风传钟磬远，平畴雨过桔槔閒。\n荷锄手摘园中笋，配酒三杯壮客颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29556,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠陈宗之 其二","author":"郑斯立","text":"羡君家阙下，不踏九衢尘。\n万卷书中坐，一生闲里身。\n贪诗疑有债，阅世欲无人。\n昨日相思处，桐花烂熳春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29557,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寿刘宰","author":"李刘","text":"制锦新城衣锦归，种桃遗爱满桃蹊。\n恩波淮水流不尽，福力螺山高与齐。\n天上已催班玉笋，日边行见月璇题。\n欢声都是长生曲，薰作香云覆宝猊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29558,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"登石台山与胡融李揆王度周仲卿联句","author":"刘倓","text":"无正文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29559,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"嘉禾百咏 其三十七 菩萨桥","author":"张尧同","text":"片云初出岫，南北自飞扬。\n旧日桥边路，犹闻舄履香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29560,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"晓色","author":"沈说","text":"晓色阑干外，翛然一欠伸。\n雨中无过鸟，烟际有行人。\n树湿清阴重，沙坍潦涨新。\n凭谁借蓑笠，整钓傍溪邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29561,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"冬半","author":"沈说","text":"岁逢冬欲半，心事更迢迢。\n细雨寒窗闭，孤灯长夜挑。\n远书和梦写，新酒带愁浇。\n明日有幽兴，寻梅到石桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29562,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拒霜","author":"陶梦桂","text":"消磨水上芙蓉了，岸上难兄正木彊。\n遭际东坡一题品，后来祇合字宜霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29563,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"衢州道中","author":"郑会","text":"生色蔷薇插鬓斜，闲随女伴摘新茶。\n回头见客低头笑，却拾残花贴面花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29564,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戊辰冬和汤南万韵 其二","author":"杜范","text":"春初走京华，秋杪归旧庐。\n简编废已久，开卷涩且疏。\n谁能击其蒙，石田或可腴。\n雁山有佳士，读尽天下书。\n足迹半九州，不惮道里迂。\n陋邦何足临，而亦来我居。\n相从一尊酒，未厌园中蔬。\n笑谭欣有合，浩若纵壑鱼。\n人生惟所适，所适各有途。\n胸中苟不迷，到处皆通衢。\n箪瓢有真乐，颜氏何其臞。\n没没嗟我生，未知终焉图。\n论交须论心，所论在不渝。\n愿君示一语，令我反三隅。\n君无金玉音，请诵一束刍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29565,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"别陈常簿埙五首","author":"杜范","text":"古道湮不续，遗直声以彰。\n良药见谓苦，不试徒有方。\n岂其盖世名，可浣忧国肠。\n视天方梦梦，令人歌慨慷。\n心理同一辙，世学何多门。\n倡徒各有植，成性非两存。\n习之到圣处，心小道自尊。\n工夫未易熟，毁誉何足论。\n空言漫浩渺，实行较分寸。\n为官志何在，监州民可问。\n以此百纸忠，解彼千里愠。\n有守矧更贤，往哉同令闻。\n菜畦绝夜雨，麦垄摇春风。\n板舆奉欢笑，意与物态同。\n路才百里近，水可一夕通。\n君其戒徒御，驾言无匆匆。\n义交味逾淡，心敬迹自疏。\n球玉世所贵，车马人交趋。\n性懒拙造请，独抱此区区。\n赠别我何有，珍重千金躯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29566,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"又和郑府判韵","author":"杜范","text":"荆璞照耀非常珍，天衢整步凌通津。\n与人轩辟破畦畛，满怀拍拍无非春。\n我如枥骥异远道，志在千里身未到。\n朅来此地寻文盟，平生心事为倾倒。\n饱德醉义乐有馀，况有兰玉芬庭除。\n谐笑云云殊未厌，盘飧夜半劳兵厨。\n依依此情那忍去，自恨尘鞍难久驻。\n伫看飞诏自天来，殿前剩作摩空赋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29567,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"昨访箳篂闻有绣帨之宴回车戏呈季茂","author":"岳珂","text":"惯闻娇小处，绕带觅银鱼。\n授雁定同瑞，弄獐应误书。\n生朝今日是，嘉宴早春初。\n无分陪汤饼，到门空返车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29568,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"病中未能访邓德载督参大监戏赠二首 其二","author":"岳珂","text":"老来病是恶因缘，白昼明窗思悄然。\n欲住又倾连夕雨，半醒似醉困人天。\n近拈吟笔尘欺砚，远想江楼浪拍船。\n满院杏花红欲放，何时长笛醉风前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29569,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词一百首 其一○○","author":"岳珂","text":"郁葱佳气蔼南都，共识彊华赤伏符。\n地纪已占江渡马，天心定见屋流乌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29570,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"吕参政示谕帖赞","author":"岳珂","text":"发知己之私书，谓其自隐于齐年。\n彼云云者，使或人亦指以诡秘之迹，夫孰曰不然。\n事君有义，本无党偏。\n当熙宁侧席以求贤，惜公之所芘赖，求诸人而不求诸天也。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29571,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"苏文忠归颍帖赞","author":"岳珂","text":"事师之情，期以百世。\n言虽不多，意则独至。\n识以岁月，越王之孙。\n式时览观，用考大伦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29572,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"邵仲恭展晤省见二帖赞","author":"岳珂","text":"宝晋大字之刻，尝同公游。\n必嗜好之素同，故忘情乎寻壑之与经丘。\n予尝陋贞观慰问之不收。\n得此帖于乡，考百年之风流。\n识者文曰：此吾宋之邵苏州也。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29573,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"苏养直留客诗帖赞","author":"岳珂","text":"予在京江，盖惯识江南之秋。\n一成之去，而虚作十年之留也。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29574,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其七十二","author":"释广闻","text":"客从远方来，遗我径寸璧。\n中有四个字，字字无人识。\n且道是甚么字，天子万年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29575,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"改作池亭子安弟赋二绝因和韵 其二","author":"程公许","text":"桤陇低风呈远碧，稻塍分溜溢方池。\n簿书课办心如水，独岸乌纱细琢诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29576,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"贺秀岩李工侍七首 其二","author":"程公许","text":"潇洒精庐此托家，暑风一幅岸乌纱。\n客来祇可烹茶待，旋督山童汲水花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29577,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"龙洞阁","author":"程公许","text":"峥嵘罅石蛟潭閟，偪仄悬崖阁栈危。\n横目不虞双足茧，子长心事未忘奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29578,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"季夏郊墅即事 其五","author":"程公许","text":"儒林冠冕国蓍龟，黄发同时二老归。\n出处古今难一槩，青天未可戴盆窥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29579,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"亲友招呼鼎至简以二绝句 其一","author":"程公许","text":"倦客归来住不多，颇思散策日相过。\n胶胶扰扰败人意，那得长閒共切磋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29580,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"九吟诗 九锁","author":"吴昌裔","text":"上界神仙住九华，故留灵锁护烟霞。\n云根欲断溪回处，流出常山几片花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29581,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"九吟诗 翠蛟","author":"吴昌裔","text":"苍松翠石束寒流，飞下长身白玉虬。\n吐出英云千尺雨，须臾雷霁水痕收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29582,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"三十二应赞","author":"释慧开","text":"现种种形，说种种法。\n形法皆非，假名菩萨。\n更于诸相觅圆通，当人正眼俱戳瞎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29583,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"达磨大师赞","author":"释慧开","text":"贼身未露罪全彰，搅得西乾沸似汤。\n项上铁枷无计脱，却来东土强摊赃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29584,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"净发","author":"释慧开","text":"锋铓未露鬼神号，能刬群牛顶?毛。\n四海聱头俱按下，岂容存著一纤毫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29585,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"枕头","author":"释慧开","text":"轮回根本，莫著相好。\n铁脊梁汉，因他放倒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29586,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古四十八首 其二十二","author":"释慧开","text":"问处何如答处亲，几人于此眼生筋。\n兄呼弟应扬家丑，不属阴阳别是春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29587,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"徐进斋得古铜香炉具象鼻眼博古图谓之象鬲属余赋之虽不足言诗聊记曾见 其二","author":"俞文豹","text":"愿得身游海外天，蓬莱顶上觅沈笺。\n为君唤起槐安梦，细读南华内外篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29588,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谢何察推鲫鲙","author":"王迈","text":"君家一箸万钱拚，分我银丝侑客欢。\n芳饵得来珍丙穴，金刀落处照辛盘。\n腹腴差迫诗肩瘦，鳞活能生酒面寒。\n玉手行厨如许巧，说教鱼婢学应难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29589,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]