[{"title":"肩吾生日 其二","author":"魏了翁","text":"力探上下三千载，行半东西二百州。\n有许豪雄都忘却，松窗棐几静中求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32089,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"肩吾生日 其三","author":"魏了翁","text":"馀晦越乡别临贺，郭君出竟送荆州。\n放麑心事人誇说，得似如今累岁留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32090,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"肩吾生日 其一","author":"魏了翁","text":"谁遣青龙日夜流，记经星纪已降娄。\n边城恰匝三寒暑，初度联翩四倡酬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32091,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"肩吾生日三绝句 其一","author":"魏了翁","text":"尚记联车入界头，廉安门外麦三秋。\n江山气度依前伟，简册功夫匪昔侔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32092,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"肩吾生日三绝句 其三","author":"魏了翁","text":"昔人年德位俱优，淇奥宾筵苦自脩。\n学至百年宁有厌，勉哉三十六春秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32093,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"肩吾生日三绝句 其二","author":"魏了翁","text":"世历嬴刘周典尽，经由孙沈古音休。\n更嗟书法开元坏，不易肩吾字字求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32094,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"肩吾生日以三绝为寿 其一","author":"魏了翁","text":"俗学场中蚤掉头，一窗书卷古人谋。\n东西日月自明耳，皇恤人间有喘牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32095,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"肩吾生日以三绝为寿 其三","author":"魏了翁","text":"宇静昼窗长似岁，心清夏簟冷于秋。\n是间消息君知得，看尽区中浪白头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32096,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"肩吾生日以三绝为寿 其二","author":"魏了翁","text":"穷檐小市百年州，浅濑平沙万古流。\n天运人谋镇如此，晚醺时上驿南楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32097,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"青玉峡","author":"魏了翁","text":"一派泉声万古悬，观澜叹逝意悠然。\n须知大化无穷已，莫赋银河落九天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32098,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"将入靖州界适值肩吾生日为诗以寿之 其一","author":"魏了翁","text":"肩吾名地古诚州，明日联车入界头。\n草草三杯酌初度，恍如赤壁伴元脩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32099,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"将入靖州界适值肩吾生日为诗以寿之 其三","author":"魏了翁","text":"道亨初不关穷达，身健何须问去留。\n但愿王明天地泰，此生长共国同休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32100,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"将入靖州界适值肩吾生日为诗以寿之 其二","author":"魏了翁","text":"滔滔今古满双鬓，纳纳乾坤归两眸。\n自有江山几千载，颇曾有此主宾不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32101,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"将至古渝虞宪以三绝同端午节见寄用韵为谢 其三","author":"魏了翁","text":"蓬窗暑雨气低垂，不记龙舟竞渡期。\n诗卷打门惊节序，满盘角黍正累累。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32102,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"将至古渝虞宪以三绝同端午节见寄用韵为谢 其二","author":"魏了翁","text":"鬓边忧绪已千端，谁唤扁舟下濮干。\n落日明船剑如电，勇心触拨到楼兰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32103,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"将至古渝虞宪以三绝同端午节见寄用韵为谢 其一","author":"魏了翁","text":"故山朱果恰离离，翠竹青蒲护众菲。\n梦里不知身造阙，閒随白鹤照江衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32104,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"将作监栽竹徐直翁清叟俾予书植贤亭三大字以诗见贻 其二","author":"魏了翁","text":"气端解使四时青，万物彫零独典刑。\n严子高风扶汉鼎，包胥劲节撼秦庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32105,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"将作监栽竹徐直翁清叟俾予书植贤亭三大字以诗见贻 其一","author":"魏了翁","text":"烈日严霜恣挟持，孤标荦荦肯随时。\n笑看世上閒桃李，一夕狂风失令姿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32106,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"将作监栽竹徐直翁清叟俾予书植贤亭三大字以诗见贻 其三","author":"魏了翁","text":"客梦时时绕故山，梦馀砉见玉孱颜。\n徐公本自无通介，自是时人醉眼斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32107,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春社日祀事既毕轿中得三绝 其一","author":"魏了翁","text":"风雨声中听李陵，起来被服对神明。\n歌钟才彻车轓动，归到谯楼恰六更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32108,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春社日祀事既毕轿中得三绝 其二","author":"魏了翁","text":"辗然冯轼受风吹，吏皂前惊雨湿衣。\n岂识主人非崛强，一川生意索褰帏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32109,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春社日祀事既毕轿中得三绝 其三","author":"魏了翁","text":"阴雾冥濛慢鼓鼙，田坡勃窣误轮蹄。\n居人闭户未忺起，太守车前一尺泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32110,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"昨有祷于社稷及境内山川是夕枕上闻雨 其一","author":"魏了翁","text":"郊宫方社诗攸重，川泽山林礼所崇。\n古祀不修牲币废，梵铙声里纸钱风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32111,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"舣舟琵琶亭次福士张元龙以诗代柬韵 其一","author":"魏了翁","text":"人生行止莫非天，万里风波一叶船。\n时有宾朋慰牢落，宁论远道困行躔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32112,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"舣舟琵琶亭次福士张元龙以诗代柬韵 其二","author":"魏了翁","text":"乐天未信果知天，枉为琵琶弦系船。\n须识屈信常事耳，暑寒代序月移躔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32113,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赵深甫年七十有亲九十贫无以养索赋","author":"魏了翁","text":"囝思郎罢久无炊，父曰子行胡不归。\n负米上堂宽带索，不妨逿地戏儿衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32114,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送从子令宪西归 其四","author":"魏了翁","text":"自尔南来岁再周，新功培养气扬休。\n且留数月须多益，归妹愆期母所忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32115,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送从子令宪西归 其一","author":"魏了翁","text":"弟兄亲友剑南州，别思如山浩不收。\n家问稀疏人迹绝，眼明从子慰羁愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32116,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送从子令宪西归 其三","author":"魏了翁","text":"古来明戒有弦钩，伯父胡为苦好脩。\n累尔南行数千里，我之自取尔何尤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32117,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送从子令宪西归 其五","author":"魏了翁","text":"古人为学戒悠悠，说命惟从务敏求。\n识此味时那可已，更从来处验吾脩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32118,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送从子令宪西归 其六","author":"魏了翁","text":"弘毅规摹本末周，既难分付又难酬。\n须知陋巷忧中