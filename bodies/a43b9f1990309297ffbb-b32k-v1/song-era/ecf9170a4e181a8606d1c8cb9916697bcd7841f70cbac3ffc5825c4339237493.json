宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32131,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"真除后谩记所见 其二","author":"魏了翁","text":"记注愆期已隔年，濡螭夹案谩云然。\n惟馀一事光千古，后殿前朝听直前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32132,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"袁都官同前韵赋二诗一章问易边赋唐律二章索奏劄录本 其二","author":"魏了翁","text":"一天西雨又东晴，唤作阴晴雨不成。\n朝睡着人浑未觉，鸣嘤枝上一声声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32133,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"袁都官同前韵赋二诗一章问易边赋唐律二章索奏劄录本 其一","author":"魏了翁","text":"那得閒功咏雪晴，风光自解凑诗成。\n须知精粗无非易，千古人心只一声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32134,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偶成","author":"洪咨夔","text":"沂水春风弄夕晖，舞雩意得咏而归。\n为何与点狂曾晢，个里须参最上机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32135,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"翌日约客有和者再用韵四首 其四","author":"魏了翁","text":"古来长恨难并四，今日相逢所就三。\n花里宾朋皆臭味，夜凉风月更清酣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32136,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"翌日约客有和者再用韵四首 其三","author":"魏了翁","text":"妙处和春莫遣知，晚尊随柳逐花移。\n落花绣地春深日，翠柳筛空月上时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32137,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"翌日约客有和者再用韵四首 其二","author":"魏了翁","text":"堆案文书长引睡，起来搔首乱鬅鬙。\n眼明嘉卉纷纨绮，竟是脩篁耸棘矜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32138,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"翌日约客有和者再用韵四首 其一","author":"魏了翁","text":"柳梢庭院杏花墙，尚记春风绕画梁。\n二十四番花信尽，只馀箫鼓卖饧香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32139,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登冠山次瞻叔兄壁间旧韵 其二","author":"魏了翁","text":"又到黄昏别有天，落霞明水月衔山。\n乱烟远树供诗卷，浊酒狂歌伴醉颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32140,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登冠山次瞻叔兄壁间旧韵 其一","author":"魏了翁","text":"芦花朴朴雪连天，枫叶椮椮日满山。\n似识游人非俗客，远峰呈露玉孱颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32141,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"韩少谟挽诗 其三","author":"魏了翁","text":"镜里孤鸾背影飞，庭前玉树向人稀。\n尚思别我成都去，忍听虞歌薤露归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32142,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"韩少谟挽诗 其二","author":"魏了翁","text":"据鞍新息困壶头，款段何如弟少游。\n马革裹尸吾愿足，不然肯向死前休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32143,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"韩少谟挽诗 其一","author":"魏了翁","text":"早年豪气盖区中，晚岁颓然一病翁。\n负许才华竟何事，有皇上帝岂梦梦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32144,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"虞退夫生日 其二","author":"魏了翁","text":"初度重逢巽上坤，庭闱应念子生孙。\n好将吉语传金母，更把归音报玉昆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32145,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"虞退夫生日 其二","author":"魏了翁","text":"雍公匹马立乾坤，善念熏蒸到子孙。\n富贵君家馀事耳，更将此念植仍昆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32146,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题上亭驿","author":"魏了翁","text":"红锦绷盛河北贼，紫金盏酌寿王姬。\n弄成晚岁琅当曲，正是三郎快活时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32147,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题归宗寺","author":"魏了翁","text":"愦愦深源与会稽，识时惟有一羲之。\n千年误作能书看，谩说鹅池与墨池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32148,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题石兴宗读书岩","author":"魏了翁","text":"岩头橘树经百黄，三少不生诸老亡。\n只馀石间元祐脚，谷虚尽日鸣当当。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32149,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题米南宫云山挂幅","author":"魏了翁","text":"漠漠云林小小山，谁家茅屋隐松间。\n石桥雨过天台远，采药仙人去未还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32150,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题余氏聚远楼","author":"魏了翁","text":"若向天机识得亲，是间看不尽青春。\n须知聚远惟方寸，说与楼前望眼人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32151,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题苏文忠与邓安惠西山唱和","author":"魏了翁","text":"春风吹屧上黄冈，独倚斜阳看武昌。\n城郭山川几兴废，祇留元祐姓名香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32152,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题罗年能六友堂","author":"魏了翁","text":"罗氏堂中六友图，要求纸尾数行书。\n若于此味真知得，着甚言词乞与渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32153,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题峡州三游洞 其二","author":"魏了翁","text":"可怪忠州与虢州，偶因起废得兹游。\n苏欧诸老亦何德，千古联芳未肯休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32154,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题峡州三游洞 其一","author":"魏了翁","text":"洞前日日客维舟，短咏长吟汗马牛。\n名迹都随形气尽，惟馀元白几人留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32155,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题赵昌父太社寄桃源何道士","author":"魏了翁","text":"八十六年彊健客，求余判断二苏诗。\n年来点检室中事，问着邻家总不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32156,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠术士龚恢乙","author":"魏了翁","text":"龚生来过我，极意论先天。\n自得环中趣，无言已十年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32157,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九月丁亥秋祀毕劳农北郊苏提干以疾不往以诗见寄因次其韵","author":"魏了翁","text":"秋尝事毕与宾游，神惠如临不敢留。\n骑吹一川松露晓，踏歌千里稻云秋。\n豳公堂上兕觥荐，郓使溪前经律诹。\n尽日临民看不足，归从苏子静中求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32158,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"二月二日遂宁北郊迎富故事","author":"魏了翁","text":"才过结柳送贫日，又见簪花迎富时。\n谁为贫驱竟难逐，素为富逼岂容辞。\n贫如易去人所欲，富若可求吾亦为。\n里俗相传今已久，谩随人意看儿嬉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32159,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"人日约李提刑李参政登蟆颐马上醉书","author":"魏了翁","text":"只从元日到人日，便觉新年胜故年。\n买酒买符酬旧社，宜蚕宜麦祝新田。\n般添和气开花柳，嗺送韶华入管弦。\n我本田间饭牛者，偶来解后亦犁然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32160,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"人日南山寺约汪宪","author":"魏了翁","text":"天开三十六宫春，又见阶蓂七叶新。\n雨足剪来齐麦垄，时和看不断游轮。\n记曾英簜为使客，却拥朱轓作主人。\n客主何常均寄耳，系边认取本来身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32161,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"八月十四日夜约客月下有赋","author":"魏了翁","text":"秋空和月卷玻瓈，清入肝脾触拨诗。\n元自生来全体具，只缘见处一分亏。\n俗情数日须圆候，识者先几畏满时。\n千古词人谁解道，拟将今夕当佳期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32162,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]