[{"title":"崇恩太后升祔十四首 迎神用《兴安》。四章。","author":"郊庙朝会歌辞","text":"閟宫有侐，堂筵屹崇。\n灵徽匪遐，精诚感通。\n苾芬维时，登兹明祀。\n泠然云车，有来其驭。\n羽旌风翔，翠蕤飘举。\n俨其音徽，登兹位处。\n笙镛始奏，合止柷敔。\n是享是宜，永求伊祜。\n枚枚閟宫，鼎俎肆陈。\n烝畀明灵，登其嘉新。\n鼓钟既戒，旨酒既醇。\n攸介攸止，纯禧荐臻。\n旨酒嘉肴，于登于豆。\n是享是宜，乐既合奏。\n衎我懿德，执事温恭。\n灵兮允格，有翼其从。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58200,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"崇恩太后升祔十四首 神主升殿用《显安》。","author":"郊庙朝会歌辞","text":"曰嫔于京，天作之配。\n进贤审官，克勤其志。\n于穆清庙，本仁祖义。\n亿万斯年，神灵攸暨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58201,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"常祀五享三首 其三 送神用《兴安》。","author":"郊庙朝会歌辞","text":"皇祖皇考，配帝配天。\n骏奔显相，神保言旋。\n祝以孝告，嘏以慈宣。\n去来永慕，宗事惟虔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58202,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"常祀五享三首 其二 太尉奠瓒用《嘉安》。","author":"郊庙朝会歌辞","text":"有秩时祀，匪怠匪渎。\n有来宗工，载祗载肃。\n厥作祼将，流黄瓒玉。\n是享是宜，永绥多福。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58203,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"常祀五享三首 其一 迎神用《兴安》。九变。","author":"郊庙朝会歌辞","text":"奕奕清庙，昭穆定位。\n霜露增感，粢盛洁祭。\n神灵来格，福祉攸暨。\n追孝奉先，本支百世。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58204,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"淳熙十五年上高宗徽号三首 其三 上徽号用《显安》。","author":"郊庙朝会歌辞","text":"中兴之烈，高掩商宗。\n揖逊之美，放勋比隆。\n字十有六，拟诸形容。\n威灵在天，裕后无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58205,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"淳熙十五年上高宗徽号三首 其二 册宝升殿用《显安》。","author":"郊庙朝会歌辞","text":"有瑑斯宝，有编斯册。\n导以麾仗，奏以金石。\n祲威盛容，煌煌赫赫。\n巨工奉之，高灵来格。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58206,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"淳熙十五年上高宗徽号三首 其一 册宝入门用《显安》。","author":"郊庙朝会歌辞","text":"于穆高皇，功德兼隆。\n称天以诔，初谥未崇。\n载稽礼典，扬徽垂鸿。\n涓日之良，登进庙宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58207,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"理宗明堂前朝享二首 其二 酌献用《考安》。","author":"郊庙朝会歌辞","text":"假哉皇考，必世后仁。\n嘉靖我邦，与物皆春。\n之纯之德，克配穹旻。\n馀庆渊如，佑我后人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58208,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"理宗明堂前朝享二首 其一 宁宗室奠币用《定安》。","author":"郊庙朝会歌辞","text":"皇矣昭考，圣灵在天。\n称秩宗祀，有严恭先。\n奉币以荐，见之僾然。\n仁深泽厚，厥光以延。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58209,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"理宗明堂前朝献景灵宫二首 其二 亚献宫架《冲安》。","author":"郊庙朝会歌辞","text":"庆云郁郁，鸣璆琅琅。\n澹其容与，申荐贰觞。\n奉承若宥，神其乐康。\n锡以多祉，源深流长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58210,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"理宗明堂前朝献景灵宫二首 其一 升殿登歌《乾安》。","author":"郊庙朝会歌辞","text":"我享我将，罄兹精意。\n陟降左右，维天与契。\n斋明乃心，祗肃在位。\n于万斯年，百福来备。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58211,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"理宗朝享三首 其三 宁宗室用《大安》。","author":"郊庙朝会歌辞","text":"帝德之休，恭俭渊懿。\n三十一年，谨终如始。\n升祔在宫，祖功并美。\n民怀有仁，何千万世。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58212,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"理宗朝享三首 其二 迎神用《兴安》。九奏。","author":"郊庙朝会歌辞","text":"秬鬯既将，黄钟具奏。\n瞻望真游，僾若有慕。\n于皇列圣，在帝左右。\n云车具来，以妥以侑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58213,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"理宗朝享三首 其一 皇帝升降用《乾安》。","author":"郊庙朝会歌辞","text":"于皇祖宗，清庙奕奕。\n威灵在天，不显惟德。\n垂裕鸿延，诒谋燕翼。\n孝孙格斯，受祉罔极。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58214,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"祭九鼎十二首 其十二 冬至，宝鼎奠币用《明安》。","author":"郊庙朝会歌辞","text":"秉心齐明，奉牲博硕。\n匏丝铿陈，冠佩俨饰。\n其肆其将，明神来格。\n执奠维何，猗欤币帛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58215,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"祭九鼎十二首 其十一 酌献用《成安》。","author":"郊庙朝会歌辞","text":"罍之初登，其仪昭陈。\n罍之既祼，其香升闻。\n神心嘉止，于焉欣欣。\n贻我有年，穰穰其仁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58216,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"祭九鼎十二首 其十 立冬，魁鼎迎神用《凝安》。","author":"郊庙朝会歌辞","text":"时运而冬，乃神玄冥。\n阴阳相推，丰年以成。\n越陈嘉肃，牲牢粢盛。\n来享来依，监于明诚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58217,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"祭九鼎十二首 其九 秋分，皛鼎亚、终献用《成安》。","author":"郊庙朝会歌辞","text":"神宫巍巍，庭燎有辉。\n声谐备乐，物陈丰仪。\n清酤既载，酌言献之。\n惟神醉止，聿来蕃釐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58218,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"祭九鼎十二首 其八 立秋，阜鼎酌献用《成安》。","author":"郊庙朝会歌辞","text":"明德崇享，磬筦锵锵。\n铿兮佩举，峨冠齐庄。\n肆陈有序，承箱是将。\n其牲伊何，笾豆大房。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58219,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"祭九鼎十二首 其七 夏至，彤鼎酌献用《成安》。","author":"郊庙朝会歌辞","text":"牺尊将将，徂基自堂。\n牲牷肥腯，鼓钟喤喤。\n肆予醴齐，椒馨飶香。\n聿来歆顾，天祚永昌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58220,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"祭九鼎十二首 其六 亚、终献用《成安》。","author":"郊庙朝会歌辞","text":"黄流在中，惟馨香祀。\n于荐于神，爰祗厥事。\n礼从多仪，以进为文。\n尊斝三献，昭示孔勤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58221,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"祭九鼎十二首 其五 立夏，冈鼎迎神用《凝安》。","author":"郊庙朝会歌辞","text":"我方东南，我日朱明。\n爰因其时，鼎以冈名。\n粢盛既馨，牲牷既盈。\n佑我皇家，巽令风行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58222,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"祭九鼎十二首 其四 春分，苍鼎亚、终献用《成安》。","author":"郊庙朝会歌辞","text":"法乾刚兮，铸鼎奠方。\n涓嘉旦兮，齐明迎祥。\n胡为持币，维箱及筥。\n胡为和羹，有锜维釜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58223,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"祭九鼎十二首 其三 亚、终献用《文安》。","author":"郊庙朝会歌辞","text":"工祝致辞，黄流协鬯。\n爰登清歌，载期神享。\n噫予诚心，精禋是虔。\n嘉予陈祀，丰盈豆笾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58224,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"祭九鼎十二首 其二 奉馔用《丰安》。","author":"郊庙朝会歌辞","text":"粢盛既丰，牲牢既充。\n展兹熙事，温温其恭。\n惟明欣欣，燔炙芬芬。\n保乎天子，繁祉荐臻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58225,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"祭九鼎十二首 其一 帝鼐降神用《景安》。","author":"郊庙朝会歌辞","text":"日号丙丁，方号中央。\n德惟其时，蠲吉是将。\n夫何饮之，黄流玉瓒。\n夫何食之，有陈伊馔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58226,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"祫享八首 送神用《兴安》。","author":"郊庙朝会歌辞","text":"合祭大事，因时发天。\n翼翼孝思，三献礼虔。\n神兮乐康，飙驭言旋。\n永福后人，于千万年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58227,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"祫享八首 光宗室酌献用《大承》。","author":"郊庙朝会歌辞","text":"于皇光宗，握符御极。\n昭哉嗣服，惟仁与德。\n勤施于民，靡有暇逸。\n万年之思，永奠宗祏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58228,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"祫享八首 翼祖酌献用《兴安》。","author":"郊庙朝会歌辞","text":"上天眷命，佑我丕基。\n翼翼皇祖，不耀其辉。\n积厚流长，福禄攸宜。\n祀事孔时，曾孙笃之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58229,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"祫享八首 初献、顺祖酌献用《大宁》。","author":"郊庙朝会歌辞","text":"于赫皇祖，浚发其祥。\n德盛流远，奕世弥昌。\n孝孙有庆，嘉荐令芳。\n神保是享，锡羡无疆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58230,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"祫享八首 其四 迎神用《兴安》。","author":"郊庙朝会歌辞","text":"苾芬孝祀，荐灌肃雍。\n致力于神，明信咸通。\n灵之妥留，惠我庞鸿。\n广被万宇，福禄攸同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58231,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"祫享八首 其三 迎神用《兴安》。","author":"郊庙朝会歌辞","text":"于昭孝治，通乎神明。\n寒暑不忒，熙事备成。\n牲牷孔硕，黍稷惟馨。\n以享以祀，来燕来宁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58232,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"祫享八首 其二 迎神用《兴安》。","author":"郊庙朝会歌辞","text":"于穆孝思，嘉荐维时。\n诚通兹格，咸来燕娭。\n神之听之，申锡蕃釐。\n于万斯年，永保丕基。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58233,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"祫享八首 其一 迎神用《兴安》。","author":"郊庙朝会歌辞","text":"时维孟冬，霜露既零。\n合食盛礼，以时以行。\n孝心翼翼，惟神来宁。\n肃倡斯举，神具是听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58234,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"景灵宫奉册宝一首 《登安之曲》。","author":"郊庙朝会歌辞","text":"穆穆真宗，锡羡蕃昌。\n飙轮临贶，谆诲洞彰。\n虔崇懿号，祗答景祥。\n至诚致享，降福无疆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58235,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"景祐以后乐章六首 其六 酌献用《昌安》。","author":"郊庙朝会歌辞","text":"内辅先猷，夙昭壶则。\n保祐之劳，慈惠其德。\n荣养有终，芳风无极。\n享献閟宫，载怀悽恻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58236,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"景祐以后乐章六首 其四 酌献用《衍安》。","author":"郊庙朝会歌辞","text":"翊佐先朝，章明壶教。\n淑顺谦勤，徽音在劭。\n树风不止，劬劳匪报。\n黍稷令芳，嘏兹乃告。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58237,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"景祐以后乐章六首 其三 章懿皇太后室奠瓒用《报安》。","author":"郊庙朝会歌辞","text":"青金玉瓒，祼将于京。\n永怀罔极，夙夜齐明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58238,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"景祐以后乐章六首 其二 酌献用《厚安》。","author":"郊庙朝会歌辞","text":"祥标曾麓，德合方仪。\n万邦展养，九御蒙慈。\n孝恭祊祏，美播声诗。\n淑灵顾享，申锡维祺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58239,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"景祐元年亲享景灵宫二首 其二 送真用《太安》。","author":"郊庙朝会歌辞","text":"椒浆尊享，珍馔精祈。\n睟容杳邈，瑶辂霞飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58240,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"景祐元年亲享景灵宫二首 其一 降真用《太安》。","author":"郊庙朝会歌辞","text":"真馆奉币，洁齐致馨。\n灵因斯格，社稷庆宁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58241,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"景祐亲享太庙二首 其一 迎神用《兴安》。","author":"郊庙朝会歌辞","text":"追养奉先，纳孝练主。\n金奏凤鸣，关雎乐舞。\n奠鬯恭神，肥腯展俎。\n积庆聪明，降景寰宇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58242,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"朝谒太清宫九首 其九 送神用《真安》。","author":"郊庙朝会歌辞","text":"醴盏在户，金奏在庭。\n笾豆有践，黍稷非馨。\n义尽蠲洁，诚通杳冥。\n言旋风驷，祚我修龄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58243,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"朝谒太清宫九首 其八 亚、终献用《大安》。","author":"郊庙朝会歌辞","text":"邈矣道祖，冥几惚恍。\n常德不离，至真无象。\n引位清穹，降祥神壤。\n酌醴荐诚，控飙来享。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58244,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"朝谒太清宫九首 其七 饮福用《大安》。","author":"郊庙朝会歌辞","text":"彼涡之壤，指李之区。\n千乘万骑，来朝密都。\n躬陈芳荐，款接仙舆。\n饮酒受福，永耀鸿图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58245,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"朝谒太清宫九首 其六 酌献用《大安》。","author":"郊庙朝会歌辞","text":"钦崇至道，肃谒殊庭。\n顺风而拜，明德惟馨。\n飙驭来格，尊酒斯盈。\n是酌是献，心通杳冥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58246,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"朝谒太清宫九首 其五 奉馔用《吉安》。","author":"郊庙朝会歌辞","text":"金奏以谐，飙游斯格。\n灵监章明，皇心励翼。\n肃奉雕俎，来升綵席。\n享德有孚，凝禧无斁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58247,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"朝谒太清宫九首 其三 降神用《真安》。","author":"郊庙朝会歌辞","text":"犹龙之圣，降生厉乡。\n教流清净，道符混茫。\n大君肃谒，盛仪允臧。\n森罗羽卫，躬荐萧芗。\n簪绂济济，钟石洋洋。\n高真至止，介福诞祥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58248,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"朝谒太清宫九首 其二 宝册升殿用《大安》。","author":"郊庙朝会歌辞","text":"图书昭锡，典礼绍成。\n烝民何幸，教父储灵。\n钦承景贶，祗奉崇名。\n致虔宝册，垂祐基扃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58249,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"朝谒太清宫九首 其一 太尉奉圣号册宝用《真安》。","author":"郊庙朝会歌辞","text":"上旻降监，介祉实繁。\n邦家修报，妙道归尊。\n增名霄极，奉册灵轩。\n茂宣圣典，永祐黎元。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58250,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"嘉祐祫享二首 其二 送神用《怀安》。","author":"郊庙朝会歌辞","text":"灵神归止，光景肃然。\n福祥裕世，明威在天。\n孝孙有庆，骏烈推先。\n佑兹基绪，弥万斯年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58251,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"嘉祐祫享二首 其一 迎神用《怀安》。","author":"郊庙朝会歌辞","text":"躬兹孝享，礼备乐成。\n神登于俎，祝导于祊。\n展牲肥腯，奏格和平。\n灵其昭格，肃僾凝情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58252,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"熙宁以后享庙五首 其五 英宗用《大康》。","author":"郊庙朝会歌辞","text":"赫赫英皇，总提邦纪。\n浚发神功，恢张圣理。\n仙驭虽遥，鸿徽不弭。\n永言孝思，竭诚躬祀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58253,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"熙宁以后享庙五首 其四 祫享仁宗用《大和》。","author":"郊庙朝会歌辞","text":"于穆仁庙，圣泽滂流。\n华夷用乂，动植蒙休。\n徽名冠古，奕世垂谋。\n帝躬祼献，盛典昭修。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58254,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"熙宁以后享庙五首 其三 禘祫孟享、腊享宗正卿升殿用《正安》。","author":"郊庙朝会歌辞","text":"进退有容，服章有仪。\n匪亟匪迟，降登孔时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58255,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"熙宁以后享庙五首 其二 送神用《兴安》。","author":"郊庙朝会歌辞","text":"钟鼓惟旅，笾豆孔时。\n衎我祖宗，既右享之。\n神亟来止，孝孙之喜。\n神保聿归，孝孙之思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58256,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"熙宁以后享庙五首 其一 酌献英宗室用《大英》。","author":"郊庙朝会歌辞","text":"在宋五世，天子嗣昌。\n躬发英断，若乾之刚。\n声容沄沄，被于八荒。\n垂千万年，永烈有光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58257,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"增上神宗徽号一首 升殿用《显安》。","author":"郊庙朝会歌辞","text":"于惟祢庙，乃圣乃神。\n秉文之士，作起惟新。\n建宫稽古，一视同仁。\n庶几备号，以享天人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58258,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水龙吟 春寿太守","author":"真知柔","text":"碧霄彩旆垂铃，应南极星躔光灿。\n巍巍名阀，芳传汉相，貂蝉炳焕。\n德莹冰壶，量包沧海，神钟岩电。\n向宝储内阁，英摽才华，声猷著膺宸眷。\n荐领名都屏翰，更循良、歌腾畿甸。\n峻专剧郡，荣登法从，光生尧殿。\n密勿论思，雍容启沃，才华独冠。\n愿年年长见，兰芽玉喷，柳梢金嫩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58259,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"长沙劝耕 其五","author":"真德秀","text":"闻说陂塘处处多，并工修筑莫蹉跎。\n十分积取盈堤水，六月骄阳柰汝何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58260,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"长沙劝耕 其二","author":"真德秀","text":"使君元起自锄犁，田野辛勤事总知。\n要为尔民除十害，肯容苛政夺三时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58261,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"长沙劝耕 其四","author":"真德秀","text":"田里工夫著得勤，翻锄须熟粪须均。\n插秧更要当时节，趁取阳和三月春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58262,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"长沙劝耕 其六","author":"真德秀","text":"田家拚取一春忙，男力菑畬女课桑。\n陇上黄云机上雪，暂时辛苦乐时长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58263,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"长沙劝耕 其九","author":"真德秀","text":"健讼翻成产祸胎，带刀却是杀身媒。\n争先好胜灾偏速，退步饶人福自来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58264,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"长沙劝耕 其七","author":"真德秀","text":"鞠育当知父母恩，弟兄更合识卑尊。\n孝心尽处通天地，善行多时福子孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58265,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"长沙劝耕 其十","author":"真德秀","text":"不教言语太艰深，为要人人可讽吟。\n把向田间歌几遍，儿童亦识使君心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58266,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]