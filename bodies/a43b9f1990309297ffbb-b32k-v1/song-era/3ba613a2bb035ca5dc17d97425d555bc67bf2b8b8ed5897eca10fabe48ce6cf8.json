[{"title":"和鲍昌朝湖上二首 其二","author":"吴芾","text":"一片湖光净见沙，晚来閒上钓鳊槎。\n山横平野堆寒玉，水绕孤城绾卧蛇。\n遥认茶烟知禁苑，忽闻机杼得人家。\n夕阳归路西风急，笑倩旁人整帽斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43924,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和鲍昌朝湖上二首 其一","author":"吴芾","text":"青山叠叠起汀沙，幽鸟惊人噪古槎。\n竹叶受风枞甲刃，松膏流地蛰龟蛇。\n爱閒正喜逢僧话，乘兴何妨到酒家。\n饮罢相携磨石壁，淋漓醉墨半攲斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43925,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和鲍昌朝韵","author":"吴芾","text":"参军长俊逸，醉里度流年。\n客路三千里，狂吟几百篇。\n贫宁贻俗笑，死不受人怜。\n别后知何处，相思夜不眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43926,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和鲍倅 其三","author":"吴芾","text":"人生出处苦难全，老矣安能了世缘。\n聊向此时看捉月，敢希他日上凌烟。\n行吟虽愧无新语，坐食犹欣有故廛。\n若得放归多种秫，不忧长欠酒家钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43927,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和鲍倅 其二","author":"吴芾","text":"参军已去作飞仙，俊逸声名久不传。\n千古家风期尔振，一时句法许谁先。\n心惟酷好佳山水，手不停披旧简编。\n想得锦囊应是富，年来知有几千篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43928,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和鲍倅 其一","author":"吴芾","text":"彯缨谁不是王臣，抗志如今有几人。\n坠典固尝深探讨，颓纲犹未许弥纶。\n拟归旧隐消残腊，旋买新田作好春。\n圣主搜扬方侧席，不应无术济生民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43929,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和管大老瑞麦","author":"吴芾","text":"别来长恨见无时，不谓相逢总泣岐。\n愧我滞留身已老，怜君偃蹇宦犹卑。\n思归正续孤松赋，溢美空传瑞麦诗。\n万事从今休更问，祇知痛饮是吾师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43930,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和薛丞","author":"吴芾","text":"归来林下恰年馀，喜对青山更面湖。\n野兴自来知不浅，宦情今日觉全无。\n任从俗目嗤吾老，未许山灵诮客逋。\n多谢新诗相慰藉，头风一读顿然苏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43931,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和魏签雪诗上赵守 其一","author":"吴芾","text":"腊尽东君已报春，雪花犹未敛轻尘。\n二天默祷浑如响，一夜呈祥觉有神。\n千里妖氛应洗涤，万家喜气欲轮囷。\n试询治行今谁最，屈指公为第一人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43932,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和魏签雪诗上赵守 其二","author":"吴芾","text":"透户穿帘到眼边，陡惊滕六逞威权。\n禦寒我独忧无褐，得饱人皆喜有年。\n已见欢声腾比屋，好将盛事被丹弦。\n此时且莫孤清赏，早晚除书下九天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43933,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"学中诸士子惠和篇复次韵为谢","author":"吴芾","text":"欲为多士劝，聊缀五言成。\n乃得琼瑶报，仍闻韶頀声。\n尘襟因顿豁，老眼为增明。\n有句能如此，何忧万里程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43934,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岩桂盛开感而有作","author":"吴芾","text":"抱痾三月未能瘳，乐事都无祇有愁。\n忽觉天香参鼻观，顿令病客展眉头。\n拟招宾佐同欢赏，奈怯壶觞且罢休。\n却忆向来无事日，年年花下醉千秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43935,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"拙者有重阳诗以阳字韵岁和一篇复继前作","author":"吴芾","text":"登临端欲赏秋光，病眼昏花怯太阳。\n老去不堪逢节物，愁来聊复近壶觞。\n沉迷有腼尘埃面，感慨空存铁石肠。\n已是思归无可奈，更来高处望家乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43936,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"拙者得归子仪喜而作诗见寄因次韵","author":"吴芾","text":"奉祠命下大明宫，尽室欢呼笑语同。\n但欲从容全晚节，敢言高尚激贪风。\n醉乡有约谁陪我，诗社无人赖有公。\n从此故山添胜事，未饶弘景相山中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43937,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"泽民见示游洞宫护圣二诗次来韵 其二","author":"吴芾","text":"山间安有此池塘，疑是天分一派江。\n万仞方如青玉案，千章森似碧油幢。\n檐前山色日侵座，屋角松声夜撼窗。\n游罢拥衾浑不寐，心清都把睡魔降。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43938,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"泽民见示游洞宫护圣二诗次来韵 其一","author":"吴芾","text":"洞府藏真锁碧峦，我来顿觉百忧宽。\n真人已去留遗像，古木犹存翳旧坛。\n清入杖藜襟抱豁，冷侵衣袂骨毛寒。\n何妨便作诛茅计，幸我年来已挂冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43939,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"泽民因诵乐天欲留年少待富贵富贵不来年少去之句慨然有感遂广此意作诗相示余以谓人之会遇各自有时年少固不可留而时亦何可待乐天自不应出此语而泽民亦不应为此诗因反其意以和之 其二","author":"吴芾","text":"劝君且醉瓮头春，休把升沉累此身。\n自古功名须遇主，到头富贵不由人。\n蟠胸器业元高世，落笔词章更出尘。\n道在何忧年少去，九重前席会相亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43940,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"范丞相生日","author":"吴芾","text":"郁郁葱葱瑞气新，中兴周室复生申。\n半千休运逢良月，十二祥蓂表庆辰。\n自有元勋书史册，漫留遗爱及邦人。\n愿同四海跻仁寿，剩赏蟠桃几万春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43941,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诗勉及门赴海棠之约","author":"吴芾","text":"君与吾游积有年，未曾同醉海棠前。\n如今君乃先春到，似赴花朝岂偶然。\n已是诗中参造化，何妨花里见神仙。\n暂归莫负重来约，未及春风便着鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43942,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨后","author":"吴芾","text":"朝来一雨洒炎光，陡觉园林处处凉。\n烟柳数行萦翠带，风荷十里拥红妆。\n莫忧镜里朱颜改，且喜壶中白昼长。\n只恐吾衰无此福，不容终老水云乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43943,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"临湖阁为向巨源郎中题","author":"吴芾","text":"胸襟洒落一尘无，晚岁归来足自娱。\n去国何须怀北地，卜居且喜面东湖。\n夕阳影里山相映，古木阴中鸟自呼。\n正好凭栏吟复醉，胡为止酒太拘拘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43944,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"前日小诗并呈鲁漕","author":"吴芾","text":"华发萧萧我与君，未能免俗尚驰奔。\n相看已是成三老，得暇何妨共一樽。\n我欲丐闲归故里，君行趣召入修门。\n亦知聚首无多日，且把交情更细论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43945,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"前日小集梅花犹在乘兴移其下杯行乐甚是夕风微月朗花飞入坐者纷纷如雪待制曾丈有四并之叹谓不可无作屡属唱之因成拙句","author":"吴芾","text":"老去逢春倍感时，兴来聊复对芳菲。\n月明更觉花枝好，风动还惊雪片飞。\n一笑休辞今夕醉，四并须信古来稀。\n乘闲莫惜频相过，要共携壶上翠微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43946,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"城上初作新亭犹未名也邦人閧然称为三槐殊不知所从来揣其意必以亭下有槐一根三干挺然秀出故有是号然非所宜言也余恐不知者谓出自我作数语以解之","author":"吴芾","text":"我心祇是忆天台，欲去无从首重回。\n若得此时追五柳，绝胜他日面三槐。\n年年白发催人老，夜夜青山入梦来。\n纵有万钟非我事，何如且覆掌中杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43947,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"复和怜字韵二首 其二","author":"吴芾","text":"春色撩人胜去年，莺啼燕语若相怜。\n一川烟水清还浅，万叠云山断复连。\n好景会心宜乐矣，故园回首却悽然。\n同僚赖有清新句，似听松风漱玉泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43948,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"复和怜字韵二首 其一","author":"吴芾","text":"拟归林下度馀年，底事天公不见怜。\n新岁已惊青鬓换，故园还想绿阴连。\n敢萌痴意贪非据，但欲冥心任自然。\n今日有谁闻此语，祇应白石与清泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43949,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"待史志道不至","author":"吴芾","text":"欲觌英标慰此怀，既推印绶尚裴回。\n心驰岩壑吾将老，目断云霄君不来。\n清夜漫劳蝴蝶梦，重阳已负菊花杯。\n傥能谅此拳拳意，胜似心颜相对开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43950,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"待雪不至呈子仪","author":"吴芾","text":"冬暖方忧雪意悭，俄然飘洒到人间。\n夜闻便谓迷三径，晓看依然在半山。\n明日既容残腊去，今朝已是迫春还。\n如何滕六浑无意，不上云霄叩九关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43951,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春阅偶成三首 其三","author":"吴芾","text":"肩摩袂属拥如山，夹道争看大阅还。\n无限儿童齐拍手，几多父老尽酡颜。\n八方共乐青春好，我亦常欣白昼闲。\n无奈老来归念重，梦魂夜夜绕乡关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43952,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春阅偶成三首 其二","author":"吴芾","text":"大阅归来日未西，柳丝摇曳草萋迷。\n桑开蝉翼枝方绿，麦露虾须穗半齐。\n池面新荷争出水，道傍飞燕竞衔泥。\n风光撩我归心动，犹喜初无杜宇啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43953,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春阅偶成三首 其一","author":"吴芾","text":"晓驱千骑出郊坰，极目江天万里晴。\n风入鼓鼙声益壮，日烘旗帜色增明。\n安边虽是难忘战，和众由来在戢兵。\n但愿从今烽燧息，早归林下看升平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43954,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"是日大雪际晚复晴月色辉映尤为可喜偶成数句","author":"吴芾","text":"满城着地折红莲，天使今宵乐事全。\n已是雪中千里白，更兼月色十分圆。\n胡为佳客犹辞醉，正恐明年未必然。\n我欲乞身归去也，悬知此酒是离筵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43955,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"洪景伯行县以不得相见寄诗道意因和其韵","author":"吴芾","text":"准拟君行县，相随入醉乡。\n何知旋旆速，空负倚楼望。\n室迩嗟人远，愁多觉夜长。\n后亭梅正发，谁共赏寒香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43956,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"癸巳夏秋旱七月十日得雨喜雨有作","author":"吴芾","text":"旱魃为灾害有秋，焦枯满目使人忧。\n片云忽向天边合，一雨俄惊地上流。\n尽道槁苗须半活，如云晚稻可全收。\n老农两手齐加额，且免流离过外州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43957,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺梁氏书楼初成","author":"吴芾","text":"于门高处许谁同，杰阁新成气象雄。\n辉映万家增壮观，峥嵘百尺耸层空。\n一天风月登临后，千里溪山指顾中。\n此地旧多仙窟宅，对君疑是老仙翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43958,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赵默卿用拙者所和乐天七旬诗赋二篇见寄因状山中之景复成一首以报之","author":"吴芾","text":"买山将近一由旬，若比渊明未是贫。\n万叠峰峦俱入眼，四时景物总宜人。\n花开自足供心赏，酒熟何妨与客亲。\n何日杖藜能过我，竹林深处共藏身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43959,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送人出使 其一","author":"吴芾","text":"天心轸念国西陲，妙选廷臣下赤墀。\n要布宽仁慰彫瘵，用资根本济艰危。\n九重眷遇风云会，万里威名草木知。\n此去愿罗天下士，归来共立太平基。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43960,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送人出使 其二","author":"吴芾","text":"驿骑骎骎犯露霜，定知遐俗喜生光。\n千官弩矢迎郊外，百姓壶浆夹道旁。\n要使远谋安井邑，尽令诸将守封疆。\n更将馀力筹边策，归日收功坐庙堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43961,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送方务德侍郎得请东归","author":"吴芾","text":"三抗封章未得归，故山归梦每飞驰。\n羡君却向林泉去，愧我犹为印绂縻。\n忙里光阴能自惜，静中气味许谁知。\n祇疑天靳清闲福，丹诏还催上赤墀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43962,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送王仲矜赴兴元倅","author":"吴芾","text":"有志男儿自不同，出门慷慨气如虹。\n远谋尚欲安天下，小试何妨佐汉中。\n此地从来为重镇，乃翁还更有遗风。\n一行莫起徒劳叹，看即人歌别驾功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43963,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送王龟龄得请还乡 其一","author":"吴芾","text":"两驰章奏叩天关，只愿归来老故山。\n愧我尚留牵吏役，羡君先去得身闲。\n冥鸿已逐高风举，倦鸟终随落照还。\n尚拟杖藜寻旧约，雁峰深处共跻攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43964,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送王龟龄得请还乡 其二","author":"吴芾","text":"和气融融动白蘋，欢传千里政方新。\n若为摆落游珍馆，不顾悲啼拥画轮。\n鲸海无津堪纵目，雁山如旧足怡神。\n愿言分我闲中趣，已问君王乞此身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43965,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送王舍人彦正奉祠东归","author":"吴芾","text":"去年趋召偶同时，每喜蒹葭玉树依。\n伟论峥嵘从古少，高怀恬退似君稀。\n身游紫禁方持橐，心著青山便拂衣。\n顾我滞留徒有愧，扁舟何日送东归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43966,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送王若夫造朝","author":"吴芾","text":"要路如公今著鞭，况逢圣主正需贤。\n长贫岂谓连三世，不调那知又十年。\n道在未应终困踬，时来看取即腾骞。\n此行会有知音者，送上通津岁九迁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43967,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送丘尉赴试南宫","author":"吴芾","text":"儒冠鼎盛缙绅多，海内如今数永嘉。\n士习艺文争擢第，君明经术合传家。\n莫言黄绶官犹小，须信青云路不赊。\n好上汉廷晁董对，要令吾道益光华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43968,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送任漕","author":"吴芾","text":"圣主方将大有为，有如二老盍来归。\n不应飞挽留江表，且使澄清向日畿。\n四海英豪从古少，一时耆旧似君稀。\n相将稳入修门去，直上云霄拱太微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43969,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送江朝宗之官","author":"吴芾","text":"芳草连天柳拂堤，怜君俯首去勾稽。\n赋成梁苑方同乐，唱彻阳关遽解携。\n指日鹍鹏当直上，待时鸾凤且卑栖。\n若逢访戴人乘兴，莫惜相随泛剡溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43970,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送江朝宗还乡","author":"吴芾","text":"欲留车骑少徘徊，归兴那知苦见催。\n只许霜前同把菊，不容雪里共观梅。\n今朝对酒休辞醉，明日有怀谁与开。\n别后愿言无爽约，菊花开日又重来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43971,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送江簿归括苍","author":"吴芾","text":"羁怀索寞苦难禁，赖有良朋与盍簪。\n同志自怜今日少，知心谁复似君深。\n哦诗喜得江天句，把酒愁分岁暮襟。\n莫恋故山乖素约，春来准拟共登临。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43972,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送许守 其一","author":"吴芾","text":"惯分符竹理疲民，来往贤星又两春。\n语到江山端有助，化行风俗自还淳。\n我知既去思何武，人叹无从借寇恂。\n别酒径须拚一醉，他时良会恐无因。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43973,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送许守 其二","author":"吴芾","text":"千里欢谣处处同，使君遗爱信无穷。\n不容昏垫为民患，解转凶荒作岁丰。\n治行好书循吏传，清声无愧古人风。\n九重想已知名久，看即黄麻出禁中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43974,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送张甥归上饶","author":"吴芾","text":"悲恼情怀未易除，相逢犹未免嗟吁。\n暂停丝竹虽云冷，只对江山亦足娱。\n我得退闲为上策，汝能勤苦是亨衢。\n欲行千里非难事，须作人间汗血驹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43975,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送汪枢帅福唐","author":"吴芾","text":"试数中兴社稷臣，独公名德冠簪绅。\n合依衮绣归双阙，却拥旌幢帅七闽。\n帝欲十连均雨露，人思四海静风尘。\n会须展尽经纶手，总把安危佩一身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43976,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送沈子寿","author":"吴芾","text":"孤城度日宛如年，赖有吾人慰眼前。\n把酒论文方累月，扬鞭别我遽朝天。\n长才合赴风云会，新渥行沾雨露边。\n帝里故人如见问，为言衰悴愈皤然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43977,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送陈泽民赴铜陵簿","author":"吴芾","text":"乡闾人物久凋零，辈行如君却老成。\n自合怀铅居册府，若为栖棘向江城。\n簿书且作三年计，事业当为万里程。\n林下贤人如未泯，尚期拭目看飞鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43978,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送侄赴廷试 其一","author":"吴芾","text":"经术传家几缙绅，孙吴决策旧无人。\n上将用武方留意，汝始程能遂发身。\n伫展六韬登上第，更资三釜及偏亲。\n两科自此增双美，何患衰宗不再振。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43979,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送侄赴廷试 其二","author":"吴芾","text":"昔年三榜偶联荣，人道吾家好弟兄。\n更喜鸰原俱有子，还来雁塔再题名。\n衰宗正恐儒风坠，晚景那知好事并。\n老子已为归去计，从今看汝奋鹏程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43980,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送孟世功","author":"吴芾","text":"男儿三十未成名，肯但区区事笔耕。\n王粲平时希负鼎，贾生今日请长缨。\n漫漫海内妖氛暗，策策腰间老剑鸣。\n会使苍生重奠枕，北山休顾小猿惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43981,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送二十七弟五三侄赴试南宫","author":"吴芾","text":"家世登科能几人，两人今岁奄沉沦。\n不应天遽衰吾族，会见时当发汝身。\n联辔莫辞金镫冷，夺标争斗锦袍新。\n还须益励青云志，门户何忧不再振。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43982,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送黄仲秉舍人赴湖南漕","author":"吴芾","text":"巧伪由来苦乱真，独持正论竦簪绅。\n身心赢得为君子，学术宁将杀世人。\n已向廷中伸此道，更来湖外济斯民。\n愿言恢作经纶业，会有功名遇合辰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43983,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送谢子肃之官","author":"吴芾","text":"吾乡人物苦彫零，赖子传家有典刑。\n仕宦方期行古道，姓名早已达天庭。\n致君事业须先办，涉世风霜要饱经。\n终不负丞宁久屈，会看感遇际千龄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43984,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送鲁漕四首 其四","author":"吴芾","text":"不贪燕寝日凝香，祇要归休深处藏。\n大火已流秋尚暑，商飙微动夜初凉。\n身縻官事老不止，心著家山梦更长。\n颇羡浙东新使者，如今衣锦更还乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43985,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]