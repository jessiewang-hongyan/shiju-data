[{"title":"减字浣溪沙/浣溪沙 其一","author":"贺铸","text":"秋水斜阳演漾金。\n远山隐隐隔平林。\n几家村落几声砧。\n记得西楼凝醉眼，昔年风物似如今。\n只无人与共登临。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43444,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"减字浣溪沙/浣溪沙 其九","author":"贺铸","text":"鹦鹉惊人促下帘。\n碧纱如雾隔香奁。\n雪儿窥镜晚蛾纤。\n乌鹊桥边河络角，鸳鸯楼外月西南。\n门前嘶马弄金衔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43445,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"减字浣溪沙/浣溪沙 其六","author":"贺铸","text":"莲烛啼痕怨漏长。\n吟蛩随月到回廊。\n一屏烟景画潇湘。\n连夜断无行雨梦，隔年犹有著人香。\n此情须信是难忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43446,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"减字浣溪沙/浣溪沙 其三","author":"贺铸","text":"鼓动城头啼暮鸦。\n过云时送雨些些。\n嫩凉如水透窗纱。\n弄影西厢侵户月，分香东畔拂墙花。\n此时相望抵天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43447,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"减字浣溪沙/浣溪沙 其二","author":"贺铸","text":"三扇屏山匝象床。\n背灯偷解素罗裳。\n粉肌和汗自生香。\n易失旧欢劳蝶梦，难禁新恨费鸾肠。\n今宵风月两相忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43448,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"减字浣溪沙/浣溪沙 其五","author":"贺铸","text":"梦想西池辇路边。\n玉鞍骄马小辎軿。\n春风十里斗婵娟。\n临水登山漂泊地，落花中酒寂寥天。\n个般情味已三年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43449,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"减字浣溪沙/浣溪沙 其七","author":"贺铸","text":"闲把琵琶旧谱寻。\n四弦声怨却沈吟。\n燕飞人静画堂深。\n欹枕有时成雨梦，隔帘无处说春心。\n一从灯夜到如今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43450,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"减字浣溪沙/浣溪沙 其四","author":"贺铸","text":"烟柳春梢蘸晕黄。\n井阑风绰小桃香。\n觉时帘幕又斜阳。\n望处定无千里眼，断来能有几回肠。\n少年禁取恁凄凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43451,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"减字浣溪沙/浣溪沙 其十四","author":"贺铸","text":"清浅陂塘藕叶乾。\n细风疏雨鹭鸶寒。\n半垂帘幕倚阑干。\n惆怅窃香人不见，几回憔悴后庭兰。\n行云可是渡江难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43452,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"减字浣溪沙/浣溪沙 其十三","author":"贺铸","text":"两点春山一寸波。\n当筵娇甚不成歌。\n动人情态可须多。\n金井露寒风下叶，画桥云断月侵河。\n厌厌此夜奈愁何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43453,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"减字浣溪沙/浣溪沙 其一","author":"贺铸","text":"宫锦袍熏水麝香。\n越纱裙染郁金黄。\n薄罗依约见明妆。\n绣陌不逢携手伴，绿窗谁是画眉郎。\n春风十里断人肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43454,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"减字浣溪沙/浣溪沙 其十一","author":"贺铸","text":"青翰舟中祓禊筵。\n粉娥窥影两神仙。\n酒阑飞去作非烟。\n重访旧游人不见，雨荷风蓼夕阳天。\n折花临水思茫然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43455,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"减字浣溪沙/浣溪沙 其八","author":"贺铸","text":"鹦鹉无言理翠襟。\n杏花零落昼阴阴。\n画桥流水半篙深。\n芳径与谁寻斗草，绣床终日罢拈针。\n小笺香管写春心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43456,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"古捣练子 剪征袍","author":"贺铸","text":"抛练杵，傍窗纱。\n巧剪征袍斗出花。\n想见陇头长戍客，授衣时节也思家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43457,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"剪朝霞/鹧鸪天 牡丹","author":"贺铸","text":"云弄轻阴谷雨乾。\n半垂油幕护残寒。\n化工著意呈新巧，剪刻朝霞饤露盘。\n辉锦绣，掩芝兰。\n开元天宝盛长安。\n沈香亭子钩阑畔，偏得三郎带笑看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43458,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"惜双双/惜分飞","author":"贺铸","text":"皎镜平湖三十里。\n碧玉山围四际。\n莲荡香风里。\n彩鸳鸯觉双飞起。\n明月多情随舵尾。\n偏照空床翠被。\n回首笙歌地。\n醉更衣处长相记。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43459,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"惜奴娇","author":"贺铸","text":"玉立佳人，韵不减、吴苏小。\n赋深情、华年韶妙。\n叠鼓新歌，最能作、江南调。\n缥缈。\n似阳台、娇云弄晓。\n有客临风，梦后拟、池塘草。\n竟装怀、□愁多少。\n绿绮芳尊，映花月、东山道。\n正要。\n个卿卿、嫣然一笑。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43460,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"踏莎行七首 其一 惜馀春","author":"贺铸","text":"急雨收春，斜风约水。\n浮红涨绿鱼文起。\n年年游子惜馀春，春归不解招游子。\n留恨城隅，关情纸尾。\n阑干长对西曛倚。\n鸳鸯俱是白头时，江南渭北三千里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43461,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"掩萧斋/浣溪沙 其三","author":"贺铸","text":"落日逢迎朱雀街。\n共乘青舫度秦淮。\n笑拈飞絮罥金钗。\n洞户华灯归别馆，碧梧红药掩萧斋。\n愿随明月入君怀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43462,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"断湘弦/万年欢 断湘弦","author":"贺铸","text":"淑质柔情，靓妆艳笑，未容桃李争妍。\n红粉墙东，曾记窥宋三年。\n不间云朝雨暮，向西楼、南馆留连。\n何尝信，美景良辰，赏心乐事难全。\n青门解袂，画桥回首，初沈汉佩，永断湘弦。\n漫写浓愁幽恨，封寄鱼笺。\n拟话当时旧好，问同谁、与醉尊前。\n除非是，明月清风，向人今夜依然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43463,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"太平时七首 其四 晚云高","author":"贺铸","text":"秋尽江南叶未凋。\n晚云高。\n青山隐隐水迢迢。\n接亭皋。\n二十四桥明月夜，弭兰桡。\n玉人何处教吹箫。\n可怜宵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43464,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"古捣练子 望书归","author":"贺铸","text":"边堠远，置邮稀。\n附与征衣衬铁衣。\n连夜不妨频梦见，过年惟望得书归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43465,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"凤栖梧三首 其三 望长安","author":"贺铸","text":"排办张灯春事早。\n十二都门，物色宜新晓。\n金犊车轻玉骢小。\n拂头杨柳穿驰道。\n莼羹鲈鲙非吾好。\n去国讴吟，半落江南调。\n满眼青山恨西照。\n长安不见令人老。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43466,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"望西飞/清商怨 望西飞","author":"贺铸","text":"十分持酒每□□。\n□□□□□。\n□计留春，春随人去远。\n东流□□□□。\n□□□、好凭双燕。\n望断西风，高楼帘暮卷。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43467,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"望湘人 春思","author":"贺铸","text":"厌莺声到枕，花气动帘，醉魂愁梦相半。\n被惜馀薰，带惊剩眼。\n几许伤春晚。\n泪竹痕鲜，佩兰香老，湘天浓暖。\n记小江、风月佳时，屡约非烟游伴。\n须信鸾弦易断。\n奈云和再鼓，曲终人远。\n认罗袜无踪，旧处弄波清浅。\n青翰棹舣，白蘋洲畔。\n尽目临皋飞观。\n不解寄、一字相思，幸有归来双燕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43468,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"添声杨柳枝","author":"贺铸","text":"九曲池头三月三。\n柳毵毵。\n香尘扑马喷金衔。\n涴春衫。\n苦笋鲥鱼乡味美，梦江南。\n阊门烟水晚风恬。\n落归帆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43469,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梦相亲/玉楼春","author":"贺铸","text":"清琴再鼓求凰弄。\n紫陌屡盘骄马鞚。\n远山眉样认心期，流水车音牵目送。\n归来翠被和衣拥。\n醉解寒生钟鼓动。\n此欢只许梦相亲，每向梦中还说梦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43470,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清平乐","author":"贺铸","text":"林皋叶脱。\n楼下清江阔。\n船里琵琶金捍拨。\n弹断么弦再抹。\n夜潮州渚生寒。\n城头星斗阑干。\n忍话旧游新梦，三千里外长安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43471,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清平乐","author":"贺铸","text":"沈侯销瘦。\n八咏新题就。\n惆怅酒醒兼梦后。\n带眼如何复旧。\n几时一叶兰舟。\n画桡鸦轧东流。\n新市小桥西畔，有人长倚妆楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43472,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清平乐","author":"贺铸","text":"阴晴未定。\n薄日烘云影。\n临水朱门花一径。\n尽日鸟啼人静。\n厌厌几许春情。\n可怜老去兰成。\n看取镊残双鬓，不随芳草重生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43473,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清平乐","author":"贺铸","text":"吴波不动。\n四际晴山拥。\n载酒一尊谁与共。\n回首江湖旧梦。\n长艚珠箔青篷。\n橹声鸦轧征鸿。\n泪□镂檀香枕，醉眠摇□春风。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43474,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清平乐 其三","author":"贺铸","text":"厌厌别酒。\n更执纤纤手。\n指似归期庭下柳。\n一叶西风前后。\n无端不系孤舟。\n载将多少离愁。\n又是十分明月，照人两处登楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43475,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清平乐","author":"贺铸","text":"小桃初谢。\n双燕还来也。\n记得年时寒食下。\n紫陌青门游冶。\n楚城满目春华。\n可堪游子思家。\n惟有夜来归梦，不知身在天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43476,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清平乐","author":"贺铸","text":"宋邻东畔。\n明月关深院。\n玉指金徽调旧怨。\n楚客归心欲断。\n城隅芳草初春。\n佳期重约临分。\n丽句漫题双带，也愁系住行云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43477,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清商怨 □□□","author":"贺铸","text":"扬州商女□□□。\n□□□□□。\n□寄扁舟，江南湖北道。\n津头龙祠屡□。\n□信指、半春前到。\n笑倚危樯，朝来风色好。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43478,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔家傲","author":"贺铸","text":"莫厌香醪斟绣履。\n吐茵也是风流事。\n今夜夜寒愁不睡。\n披衣起。\n挑灯开卷花生纸。\n倩问尊前桃与李。\n重来若个犹相记。\n前度刘郎应老矣。\n行乐地。\n兔葵燕麦春风里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43479,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"第一花/鹧鸪天","author":"贺铸","text":"豆蔻梢头莫漫夸。\n春风十里旧繁华。\n金缕玉蕊皆殊艳，别有倾城第一花。\n青雀舫，紫云车。\n暗期归路指烟霞。\n无端却似堂前燕，飞入寻常百姓家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43480,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"木兰花三首 其三 续渔歌","author":"贺铸","text":"中年多办收身具。\n投老归来无著处。\n四肢安稳一渔舟，祗许樵青相伴去。\n沧洲大胜黄尘路。\n万顷月波难滓污。\n阿侬原是个中人，非谓鲈鱼留不住。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43481,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"好女儿四首 其四 绮筵张","author":"贺铸","text":"绮绣张筵。\n粉黛争妍。\n记六朝、旧数闺房秀，有长圆璧月，永新琼树，随步金莲。\n不减丽华标韵，更能唱、想夫怜。\n认情通、色受缠绵处，似灵犀一点，吴蚕八茧，汉柳三眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43482,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"生查子三首 其二 绿罗裙","author":"贺铸","text":"东风柳陌长，闭月花房小。\n应念画眉人，拂镜啼新晓。\n伤心南浦波，回首青门道。\n记得绿罗裙，处处怜芳草。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43483,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 其五","author":"贺铸","text":"绿杨眠后拖烟穗。\n日长扫尽青苔地。\n香断入帘风。\n炉心檀烬红。\n兰溪修祓禊。\n上巳明朝是。\n不许放春慵。\n景阳临晓钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43484,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 其二","author":"贺铸","text":"章台游冶金龟婿。\n归来犹带醺醺醉。\n花漏怯春宵。\n云屏无限娇。\n绛纱灯影背。\n玉枕钗声碎。\n不待宿酲销。\n马嘶催早朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43485,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 其一","author":"贺铸","text":"彩舟载得离愁动。\n无端更借樵风送。\n波渺夕阳迟。\n销魂不自持。\n良宵谁与共。\n赖有窗间梦。\n可奈梦回时。\n一番新别离。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43486,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 其八","author":"贺铸","text":"虚堂向壁青灯灭。\n觉来惊见横窗月。\n起看月平西。\n城头乌夜啼。\n兰衾羞更入。\n敧枕偷声泣。\n肠断数残更。\n望明天未明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43487,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 其四","author":"贺铸","text":"绿窗残梦闻鶗鴂。\n曲屏映枕春山叠。\n梳□发如蝉。\n镜生波上莲。\n绛裙金缕褶。\n学舞腰肢怯。\n帘下小凭肩。\n与人双翠钿。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43488,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 其六","author":"贺铸","text":"粉香映叶花羞日。\n窗间宛转蜂寻蜜。\n欢罢卷帘时。\n玉纤匀面脂。\n舞裙金斗熨。\n绛襭鸳鸯密。\n翠带一双垂。\n索人题艳诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43489,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 其十一","author":"贺铸","text":"炉烟微度流苏帐。\n孤衾冷叠芙蓉浪。\n蟋蟀不离床。\n伴人愁夜长。\n玉人飞阁上。\n见月还相望。\n相望莫相忘。\n应无未断肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43490,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 其七","author":"贺铸","text":"子规啼梦罗窗晓。\n开奁拂镜严妆早。\n彩碧画丁香。\n背垂裙带长。\n钿筝寻旧曲。\n愁结眉心绿。\n犹恨夜来时。\n酒狂归太迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43491,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 其九","author":"贺铸","text":"芭蕉衬雨秋声动。\n罗窗恼破鸳鸯梦。\n愁倚□帘栊。\n灯花落地红。\n枕横衾浪拥。\n好夜无人共。\n莫道粉墙东。\n蓬山千万重。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43492,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 其三","author":"贺铸","text":"曲门南与鸣珂接。\n小园绿径飞胡蝶。\n下马访婵娟。\n笑迎妆阁前。\n鹧鸪声几叠。\n滟滟金蕉叶。\n未许被香鞯。\n月生楼外天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43493,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 其一","author":"贺铸","text":"朱甍碧树莺声晓。\n残醺残梦犹相恼。\n薄雨隔轻帘。\n寒侵白纻衫。\n锦屏人起早。\n惟见馀妆好。\n眉样学新蟾。\n春愁入翠尖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43494,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菱花怨","author":"贺铸","text":"叠鼓嘲喧，彩旗挥霍，苹汀薄晚，兰舟催解。\n别浦潮平，小山云断，十幅饱帆风快。\n回想牵衣，愁掩啼妆，一襟香在。\n纨扇惊秋，菱花怨晚，谁共蛾黛。\n何处玉尊空，对松陵正美，鲈鱼菰菜。\n露洗凉蟾，潦吞平野，三万顷非尘界。\n览胜情无奈。\n恨难招、越人同载。\n会凭紫燕西飞，更约黄鹂相待。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43495,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝶恋花 改徐冠卿词","author":"贺铸","text":"几许伤春春复暮，杨柳清阴，偏碍游丝度。\n天际小山桃叶步，白菽花满湔裙处。\n竟日微吟长短句，帘影灯昏，心寄胡琴语。\n数点雨声风约住，朦胧淡月云来去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43496,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"胜胜慢二首 其一 寒松叹","author":"贺铸","text":"鹊惊桥断，凤怨箫闲，彩云薄晚苍凉。\n难致祖州灵草，方士神香。\n寒松半敧涧底，恨女萝、先委冰霜。\n宝琴尘网，□□□□，□□□□。\n依□履綦行处，酸心□，□□□□□□。\n□□帘垂窣地，簟竟空床。\n伤春燕归洞户，更悲秋、月皎回廊。\n同谁消遣，一年年夜夜长。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43497,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"御街行 别东山","author":"贺铸","text":"松门石路秋风扫。\n似不许、飞尘到。\n双携纤手别烟萝，红粉清泉相照。\n几声歌管，正须陶写，翻作伤心调。\n岩阴暝色归云悄。\n恨易失、千金笑。\n更逢何物可忘忧，为谢江南芳草。\n断桥孤驿，冷云黄叶，相见长安道。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43498,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"太平时七首 其七 替人愁","author":"贺铸","text":"风紧云轻欲变秋。\n雨初收。\n江城水路漫悠悠。\n带汀洲。\n正是客心孤迥处，转归舟。\n谁家红袖倚津楼。\n替人愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43499,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"最多宜/浣溪沙 其六","author":"贺铸","text":"半解香绡扑粉肌。\n避风长下绛纱帷。\n碧琉璃水浸琼枝。\n不学寿阳窥晓镜，何烦京兆画新眉。\n可人风调最多宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43500,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"窗下绣/一络索 窗下绣","author":"贺铸","text":"初见碧纱窗下绣。\n寸波频溜。\n错将黄晕压檀花，翠袖掩、纤纤手。\n金缕一双红豆。\n情通色授。\n不应学舞爱垂杨，甚长为、春风瘦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43501,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雁后归/临江仙 其一 雁后归","author":"贺铸","text":"巧剪合欢罗胜子，钗头春意翩翩。\n艳歌浅拜笑嫣然。\n愿郎宜此酒，行乐驻华年。\n未是文园多病客，幽襟凄断堪怜。\n旧游梦挂碧云边。\n人归落雁后，思发在花前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43502,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雁后归/临江仙 其三 采莲回","author":"贺铸","text":"翡翠楼高帘幕薄，温家小玉妆台。\n画眉难称怯人催。\n羞从面色起，娇逐语声来。\n门外木兰花艇子，垂杨风扫纤埃。\n平湖一镜绿萍开。\n缓歌轻调笑，薄暮采莲回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43503,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雁后归/临江仙 其二 想娉婷","author":"贺铸","text":"鸦背夕阳山映断，绿杨风扫津亭。\n月生河影带疏星。\n青松巢白鸟，深竹逗流萤。\n隔水彩舟然绛蜡，碧窗想见娉婷。\n浴兰熏麝助芳馨。\n湘弦弹未半，凄怨不堪听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43504,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"兀令 想车音","author":"贺铸","text":"盘马楼前风日好。\n雪销尘扫。\n楼上宫妆早。\n认帘箔微开，一面嫣妍笑。\n携手别院重廊，窈窕花房小。\n任碧罗窗晓。\n间阔时多书问少。\n镜鸾空老。\n身寄吴云杳。\n想轣辘车音，几度青门道。\n占得春色年年，随处随人到。\n恨不如芳草。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43505,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"生查子三首 其一 愁风月","author":"贺铸","text":"风清月正圆，信是佳时节。\n不会长年来，处处愁风月。\n心将熏麝焦，吟伴寒虫切。\n欲遽就床眠，解带翻成结。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43506,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]