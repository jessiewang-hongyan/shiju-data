[{"title":"巴东书事","author":"寇准","text":"乡思终日有，孤淡厌琴樽。\n众木侵山径，寒江逼县门。\n浪沉滩见脊，雨过壁生痕。\n憔悴悲兰蕙，因思楚屈原。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63895,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"巴东县斋秋书","author":"寇准","text":"讼庭终日静，琴鹤亦长闲。\n晚树生凉吹，秋思在远山。\n水穿吟阁过，苔绕印床斑。\n幸有江云看，何须卜往还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63896,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"巴东驿秋日晚望","author":"寇准","text":"楚驿独闲望，山村秋暮天。\n数峰横夕照，一笛起江船。\n遣恨须言命，冥心渐学禅。\n迟迟未回首，深谷暗寒烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63897,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"巴东寒食","author":"寇准","text":"春雨萧萧寒食天，远行犹在楚江边。\n人思故国迷残照，鸟隔深花语断烟。\n薄宦未能酬壮节，良时空自感流年。\n因循未学陶潜兴，长见孤云倍黯然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63898,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"忆岐下旧游","author":"寇准","text":"二年岐下假诸侯，事简民安选胜游。\n花寺水村时驻马，暮天秋雪独登楼。\n静眠铃閤闻羌笛，闲酌松醪引越瓯。\n别后几回空有恨，叶飞蝉噪动离愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63899,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"月夜怀杜陵友生","author":"寇准","text":"一忝轺车命，三逢水国春。\n重看汉浦月，独忆杜陵人。\n旅宦违前计，归田失旧邻。\n年来更多绪，清泪满衣巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63900,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"月夜怀故人","author":"寇准","text":"清夜月初满，藓庭吟更幽。\n梧桐疏影老，蟋蟀乱声秋。\n旧国情何极，空江思欲流。\n故人今底处，危坐独凝愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63901,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水阁夜望书怀","author":"寇准","text":"水阁中宵动，寥寥起远思。\n秋风生折苇，星彩动寒池。\n白社孤前约，青云少旧知。\n苦吟空自叹，风雅道由衰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63902,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"长安书事","author":"寇准","text":"一从洛邑移秦甸，三见东郊绽早梅。\n莲府昼闲铃閤闭，柳营春暖射堂开。\n斋坛首冠惭诸将，相印兼营接上台。\n何事燕公轻仗钺，却言分阃是粗才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63903,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"长安春书","author":"寇准","text":"务闲公府都无事，骑吏前驱引马行。\n雨霁晚街官柳色，日长春寺讲钟声。\n云山已有终南秀，泉石犹思洛下清。\n闻道曲江新水满，欲携歌管出重城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63904,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东归再经峡口","author":"寇准","text":"复命经三峡，波澜极目愁。\n片云生断壁，孤石碍中流。\n道路连巴塞，风烟接楚丘。\n重来登望处，因念昔年游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63905,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东窗","author":"寇准","text":"徙倚东窗夜未明，悄然幽馆独凝情。\n灯摇古壁秋虫怨，露下疏林宿鹤惊。\n道在任从时态薄，年加潜觉睡魂轻。\n待酬北阙君恩了，归听冰泉落石声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63906,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬日偶书","author":"寇准","text":"户庭初过雪，鸟雀亦声稀。\n天淡云容结，林寒日影微。\n虚名何足道，前是旋成非。\n簪绂全忘念，终须扫涧扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63907,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬日偶成","author":"寇准","text":"正是旅愁悲远宦，况逢边塞向残年。\n轮蹄影绝冬深路，鸟雀声稀雪后天。\n探骑经旬无使客，戍楼终日有烽烟。\n病来无复拈樽酒，独向虚窗尽日眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63908,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬夜旅思","author":"寇准","text":"年少嗟羁旅，烟宵进未能。\n江楼千里月，雪屋一龛灯。\n远信凭边雁，孤吟寄岳僧。\n炉灰愁拥坐，砚水半成冰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63909,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"边城春望","author":"寇准","text":"独望原西路，离襟倍黯然。\n青山遮故国，绝塞度新年。\n风聚沙迷岸，烟开烧满川。\n归心正无际，骠骑莫留连。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63910,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再归秦川","author":"寇准","text":"阮路何方尽，西归兴未劳。\n河流经陕狭，山色入秦高。\n返照明秋垒，孤村接暮涛。\n还如丁令至，故里满蓬蒿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63911,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再到邺下有感","author":"寇准","text":"漳滨胜地皆牢落，晚岁重来恨莫收。\n极浦寺藏云树老，故人门锁雨苔秋。\n烟霄得路输时彦，泉石忘机阻旧游。\n今日重思昔年事，放怀惟上夕阳楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63912,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吊任瓘处士","author":"寇准","text":"一生长抱恨，终亦是贫居。\n遗信留孤鹤，营坟卖古书。\n竹斋无俗物，秋圃有寒蔬。\n福善何言昧，悠然望太虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63913,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"成安秋望有怀","author":"寇准","text":"年加心地转如灰，书箧经旬亦懒开。\n诗句偶吟皆感事，文章无用独伤才。\n秋蝉残韵摇疏树，夕照寒光下古台。\n闲绕岸莎看野水，暗流红叶不重回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63914,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"早春","author":"寇准","text":"星纪周天运，微阳气候新。\n郊原初度腊，梅柳暗惊春。\n故国无书久，孤峰入梦频。\n年加自多感，况复送归人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63915,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"早春","author":"寇准","text":"日暖经冰泮，潜回律管春。\n初惊柳色重，渐见草芽新。\n樽酒留欢少，云溪入梦频。\n惟应五侯地，行乐及芳辰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63916,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江上晚行","author":"寇准","text":"秦川不得却归耕，奉诏年来在楚城。\n孤寺残钟催夕照，汀洲疏苇送秋声。\n西风独起湖山思，久客应知寂寞情。\n野鹤渐无惊弋意，对人孤立水烟平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63917,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江上晚望怀所知","author":"寇准","text":"迟迟迷远信，闲立大江隅。\n游子在何处，秋风吹五湖。\n潮回沙鸟聚，岸阔钓船孤。\n归去还堪叹，田园半已芜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63918,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江行书事","author":"寇准","text":"孤棹沿流岸，凝怀似旧游。\n朝云生岳顶，斜月动江流。\n贱节难干世，离心易感秋。\n因思六朝事，千古有遗愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63919,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"池上秋书","author":"寇准","text":"虚斋独语复书空，闲对林塘思少同。\n霜叶声乾飘夕照，露荷香冷泣秋风。\n时平偶作青衫吏，心老浑如白发翁。\n昨夜渭川归好梦，一船烟雨打孤篷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63920,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初到长安书怀","author":"寇准","text":"荐承丹诏抚彫残，适值年丰万井安。\n旧职尚兼黄阁贵，前驱新拥碧油寒。\n静怜风竹经宵听，老爱山云尽日看。\n魂梦不知关塞外，有时犹得到金銮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63921,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初秋即事","author":"寇准","text":"古邑端居夏景移，炎飙经雨自收威。\n莲衰小渚秋光淡，蝉噪平林夕照微。\n冷句每招江客和，深心终约岳云归。\n晚凉却近南亭立，独看沙鸥向浦飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63922,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岐下西园秋日书事","author":"寇准","text":"务简群吏散，披襟幽兴长。\n松篁经晚节，兰菊有清香。\n水净澄秋色，山高见夕阳。\n身闲心自泰，何必濯沧浪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63923,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"应制太清楼观书","author":"寇准","text":"仙禁开书府，神毫纪格言。\n简编包舜禹，围范总乾坤。\n稽古崇邦教，斯文辟圣门。\n从游观奥秘，何以报宸恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63924,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"应制赏花","author":"寇准","text":"上苑经春雨，宸游属盛时。\n花光笼宝槛，柳色暗龙池。\n潋滟雕觞满，融和暖日迟。\n共歌成至乐，千载播声诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63925,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"应制赏花钓鱼","author":"寇准","text":"龙禁含佳气，銮舆下建章。\n碧波微荡漾，红萼竟芬芳。\n玉斝春醪满，金波昼漏长。\n逢时空窃抃，万宇正欢康。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63926,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"邺中和崔迈著作 其二","author":"寇准","text":"独倚空楼畏景残，凝眸魂断楚云端。\n猿清好杂江声听，山远宜和霁色看。\n鸟掠平芜堪入画，风来危槛欲生寒。\n萧萧前浦归帆静，落日长吟且凭栏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63927,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"邺北旅中怀友人","author":"寇准","text":"浮世多尘事，悠悠难定期。\n梦阑怀远夜，秋尽望乡时。\n道在应无闷，风浇自业诗。\n何当归钓渚，支肘一沉思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63928,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和李逢同年水阁闲望","author":"寇准","text":"务简凭危槛，凝然感物华。\n孤村经野烧，极浦见渔家。\n滩急舟难渡，山高日易斜。\n明时如道在，焉复痛怀沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63929,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和赵监丞赠隐士","author":"寇准","text":"不爱簪裾陪盛列，终年深隐养天机。\n静闻风雨眠渔艇，闲称林泉挂道衣。\n门接水村多野色，鹤当莎径立残晖。\n高吟幽赏无羁束，始觉趋时事事非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63930,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜坐有怀寄张士逊","author":"寇准","text":"清秋吟更僻，况复古亭间。\n少梦虫声碎，无风树影闲。\n月华澄曲沼，霜气满空山。\n不见张夫子，谁人共往还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63931,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜坐怀故友","author":"寇准","text":"西风起穷巷，众木又彫零。\n蕙浦月华白，竹窗灯影青。\n故人难重见，邻笛不堪听。\n行傍秋池上，孤吟对远星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63932,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜怀寄友生","author":"寇准","text":"遥夜独无趣，恍然思故交。\n泉声飞石壁，星影动林梢。\n志壮难低俗，情闲任献嘲。\n秋山虽入望，犹不似衡茅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63933,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜泊江上","author":"寇准","text":"岁暮峡中村，维舟古树根。\n群峰初落日，夜后独闻猿。\n流水自无尽，客愁那可论。\n平明离楚岸，迢递指吴门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63934,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉圣旨赋牡丹花","author":"寇准","text":"栽培终得近天家，独有芳名出众花。\n香递暖风飘御座，叶笼轻霭衬明霞。\n纵吟宜把红笺襞，留赏惟张翠幄遮。\n深觉侍臣千载幸，许随仙仗看秾华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63935,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉和御制郊外观稼","author":"寇准","text":"天苑清尘宿雨收，翠华观稼庆盈畴。\n气和玉烛成丰岁，露冷金茎凛素秋。\n日丽鲜原平杳杳，烟含嘉谷郁油油。\n共知省敛敦农事，信史腾芳纪圣游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63936,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"金陵怀古","author":"寇准","text":"极目望吴甸，野烟凝乱流。\n夜来榆塞雁，叫断石城秋。\n旧苑荒馀草，平川半古丘。\n迟迟独回首，落日一蝉幽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63937,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨中书事","author":"寇准","text":"一雨起前浦，霏微向暮秋。\n谁方眠钓艇，我独在江楼。\n山晦峰峦隐，烟凝岛屿幽。\n何当见晴旭，一得泛回舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63938,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨夜书事","author":"寇准","text":"离人听积雨，滴滴动乡心。\n故国程犹远，重门夜正深。\n气昏濛烬烛，巢冷语栖禽。\n遥想江南岸，馀花委故林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63939,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨夜许氏第会宿各赋四韵","author":"寇准","text":"雨夜销烦暑，林塘向夕幽。\n庭虚惟欠月，树冷欲生秋。\n河北嗟新别，樽前念旧游。\n若非逢胜会，何以解离忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63940,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"顶山","author":"寇准","text":"雨歇黄梅后，秋生麦熟前。\n偶同金马客，来访玉龙泉。\n竹叶一尊酒，榴花五月天。\n不妨扶拄杖，行到白云边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63941,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南阳夏日","author":"寇准","text":"绿杨阴密覆回廊，深院帘垂昼景长。\n人静独闻幽鸟语，风来时有异花香。\n世间宠辱皆尝遍，身外声名岂足量。\n闲读南华真味理，片心惟只许蒙庄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63942,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南亭","author":"寇准","text":"初夜南亭望，清吟露湿衣。\n雨馀群籁发，天淡数星稀。\n秋气又还至，故园犹未归。\n虚堂愁重入，烛白冷光微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63943,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南亭晨望寄唐知印","author":"寇准","text":"梦觉偶晨起，南轩还独过。\n晓光生远树，露气冷疏荷。\n窗白游尘少，风清静兴多。\n遥知江郡守，幽趣在烟波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63944,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南冠亭秋晚闲望","author":"寇准","text":"南冠亭外淡江天，久客登临更浩然。\n远浦秋深翻白浪，孤山日暮起苍烟。\n已嗟异国逢衰节，况复西风听乱蝉。\n倦鸟知还虽有意，故林无奈隔秦川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63945,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"峡中春感","author":"寇准","text":"二年穷峡外，不见帝城春。\n览照知年老，逢花感恨频。\n浮荣何足贵，幽别转难伸。\n终忆归清渭，林泉卜旧邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63946,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"帝城秋望","author":"寇准","text":"登临秋向尽，千里见王畿。\n过雨山逾翠，经霜菊渐稀。\n平原夕霭起，高树宿禽归。\n一望关河道，空令咏式微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63947,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日书怀","author":"寇准","text":"曾读前书笑古今，耻随流俗信浮沉。\n终期直道扶元化，敢为虚名役片心。\n默坐野禽啼昼景，闭门官柳长春阴。\n世间事了须先退，不待霜毛渐满簪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63948,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日长安故苑有怀","author":"寇准","text":"唐室空城有旧基，荒凉长使后人悲。\n遥村日暖花空发，废苑春深柳自垂。\n事著简编犹可念，景随陵谷更何疑。\n入梁朝士无多在，谁向秋风咏黍离。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63949,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日怀张曙","author":"寇准","text":"不见张夫子，岩花几度新。\n久闲空赋命，远别更伤春。\n雨艇愁天末，烟蓑隐渭滨。\n应嗟年未冠，已作异乡人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63950,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日闲望有感","author":"寇准","text":"水乡春气变新正，风物光荣异帝城。\n闲步偶寻芳草色，空林独听野莺声。\n烟霞未得从幽兴，吟赏潜悲减旧情。\n燕麦杨花自摇荡，不知离客困南征。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63951,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日登楼怀归","author":"寇准","text":"高楼聊引望，杳杳一川平。\n远水无人渡，孤舟尽日横。\n荒村生断霭，深树语流莺。\n旧业遥清渭，沉思忽自惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63952,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春望书事","author":"寇准","text":"因晴每日向吟台，纵目山城景象开。\n白鸟静投沙浦去，落花闲逐野泉来。\n客愁已被杨烟染，春色难甘蜀魄催。\n看即流芳无处问，但将馀兴殢黄醅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63953,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"残月 其一","author":"寇准","text":"半夜沉清影，宵残犹伴吟。\n已甘垂树杪，由得挂天心。\n淡色迷蓬户，馀光映宿禽。\n谁家伤早别，凝思共沉沉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63954,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"洛阳有怀岐山旧游","author":"寇准","text":"绿鬓年来已渐彫，旧游芳草路迢迢。\n山横远翠疑歌黛，柳拂轻梢认舞腰。\n秦甸梦回空有恨，洛城吟断独无憀。\n斜阳更上高楼望，始觉离情一倍饶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63955,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"省夏书事","author":"寇准","text":"窗户经初雨，风清野景饶。\n闲庭犹戏蝶，高树已鸣蜩。\n世态贫中觉，乡思醉里销。\n纵吟还独步，时复过溪桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63956,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夕书怀","author":"寇准","text":"官路时风渐识情，一悲前计远愁生。\n深秋寒气侵灯影，半夜疏林起雨声。\n县印终年拘吏役，烟蓑何日避浮名。\n穷通休问巢莲骨，大抵无徒是至清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63957,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋日","author":"寇准","text":"江天物候潜衰变，气爽初疑夏景馀。\n雨渍乱苔侵古壁，风飘红叶满荒渠。\n晚云连岳幽藏寺，秋水澄江静见鱼。\n昔岁一鸣无所恨，绿槐金蕊任萧疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63958,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋日怀友生","author":"寇准","text":"寂寂感离群，前期何足云。\n人从秦岭别，蝉向楚江闻。\n村送孤烟起，山空白日曛。\n更逢疏叶落，愁绪转纷纷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63959,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋日原上","author":"寇准","text":"萧萧古原上，景物感离肠。\n远峤收残雨，寒林带夕阳。\n溪声迷竹韵，野色混秋光。\n吟罢还西望，平沙起雁行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63960,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋气凛然庭木将坠道谦上人有南征之役赋诗祖行","author":"寇准","text":"洪府多佳致，师今欲此行。\n寒山连楚远，白浪浸吴平。\n烟雨经秋迥，霜鸿入夜鸣。\n到时春未暮，闲听鹧鸪声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63961,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋兴呈裴李二同年 其二","author":"寇准","text":"岁晚乱山外，野望谁能同。\n寒沙明夕照，败叶惊西风。\n孤烟暝汀树，霜气高秋空。\n徘徊念前事，旅恨良难穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63962,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]