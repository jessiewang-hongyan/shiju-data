[{"title":"戏靠安岩呈双溪大师","author":"释重显","text":"陜府铁牛却知有，春秋几几成过咎。\n一身还作二如来，黑白不分辨香臭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17058,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"早参示众","author":"释重显","text":"晓天云静浓霜白，千峰万峰锁寒色。\n骊龙失珠知不知，无限平人遭点额。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17059,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杂言送贤专使","author":"释重显","text":"使乎谁，老作者，百战场中飞铁马。\n秋水藏来人不知，笑李将军被擒下。\n阿呵呵，却归湖山唱凯歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17060,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自诲","author":"释重显","text":"麟龙不为瑞，草木生光辉。\n三尺一丈六，且同携手归。\n惭尔惩世师，巍巍何巍巍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17061,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"至人不器","author":"释重显","text":"谁当机，举不赚，亦还稀。\n摧残峭峻，销烁玄微。\n重关曾巨辟，作者未同归。\n玉兔乍圆乍缺，金乌似飞不飞。\n卢老不知何处去，白云流水共依依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17062,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观泉送演禅者","author":"释重显","text":"云根漱野泉，照空复照月。\n冷声曾未消，飞澜似相别。\n岩近生风雷，天遥新冰雪。\n演禅乘与知不知，源流依依共澄洁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17063,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"拟寒山送僧","author":"释重显","text":"择木有灵禽，寒空寄羽翼。\n不止蓬莱山，冥冥去何极。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17064,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"兔角拄杖","author":"释重显","text":"少室传来兔角杖，千圣护持为顶相。\n虎踞龙蟠势未休，云影山形冷相向。\n有时闲倚在虚堂，寥寥匝地凝秋霜。\n有时大作师子吼，德峤临际何茫茫。\n今日提来还不惜，分明普示诸知识。\n解拈天下任横行，高振风规有何极。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17065,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和范监簿 其二","author":"释重显","text":"品汇不自适，善政还可寻。\n县楼清夜上，岛月思云侵。\n谁有古菱花，照此真宰心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17066,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和颂","author":"释重显","text":"玲珑岩古寺，冠乎明越境。\n海眼通洌泉，天心耸危岭。\n尝游兴未阑，遐想神忽凝。\n彼士真觉雄，相邻不孤迥。\n吾爱济横流，孰云烦虑屏。\n吾爱整颓纲，岂止浮根静。\n栖梧瑞九包，追风骏十影。\n顾我不争衡，与谁闲斗茗。\n乘时既磊落，照世非昏暝。\n伫为王者师，三千统摩顶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17067,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"孤运铭","author":"释重显","text":"云根石圹，容身待老。\n南来北来，闲且寻讨。\n五叶一花兮堪对谁，寥寥万古兮空知有。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17068,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"往复无间 其七","author":"释重显","text":"晡时申，急急逃生路上人。\n草鞋踏尽家乡远，顶罩烧钟一万斤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17069,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"往复无间 其三","author":"释重显","text":"食时辰，大向那堪列主宾。\n维摩香饭本非设，怪他鹙鹭独生瞋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17070,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"往复无间 其四","author":"释重显","text":"禺中巳，荆棘园林遍大地。\n南北东西卒未休，金刚焰复从何起。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17071,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"往复无间 其六","author":"释重显","text":"日昳未，碧眼胡来欺汉地。\n九年计较不能成，刚有痴人求断臂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17072,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"往复无间 其十","author":"释重显","text":"人定亥，六合茫茫谁不在。\n长空有月自寻常，雾起云腾也奇怪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17073,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"往复无间 其八","author":"释重显","text":"日入酉，室内覆盆且依旧。\n尘尘彼彼丈夫儿，井中之物同哮吼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17074,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"往复无间 其九","author":"释重显","text":"黄昏戌，寰中不碍平人出。\n瓦砾光生珠玉闲，将军岂用驱边卒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17075,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"往复无间 其五","author":"释重显","text":"日南午，寥廓腾辉示天鼓。\n郁头蓝已定全身，何假周行誇七步。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17076,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"往复无间 其一","author":"释重显","text":"平旦寅，眹兆之前已丧真。\n老胡鹤树惭开口，犹举双趺诳后人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17077,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"往复无间 其十二","author":"释重显","text":"鸡鸣丑，贵贱尊卑各相守。\n忙者忙兮闲者闲，古今休论自长久。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17078,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"往复无间 其二","author":"释重显","text":"日出卯，万国香花竞头走。\n邯郸学步笑傍观，岂知凶祸逐其后。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17079,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"往复无间 其十一","author":"释重显","text":"半夜子，樵唱渔歌声未已。\n雨花徒说问空生，高枕千门睡方美。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17080,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"法尔不尔","author":"释重显","text":"夏云多奇峰，乾城冷相映。\n借问诸禅僧，那个堪凭定。\n乾城高锁月，夏云欲为雨。\n若谓非全功，子细看规矩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17081,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"经古堰偶作","author":"释重显","text":"出城四十里，古堰若天外。\n飞棹清浅中，孤影自相对。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17082,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"保福四谩人","author":"释重显","text":"竿木随身老作家，逢场作戏更难加。\n谩人谩我无人会，水长船高眼里沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17083,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"思归引 其一","author":"释重显","text":"一住翠峰顶，两见溪草绿。\n不知朝市间，几番生荣辱。\n萧条岩上云，冷淡水边竹。\n报谁归去来，向此空踟躅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17084,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"思归引 其三","author":"释重显","text":"时雨洒如膏，万卉皆滋益。\n枯根甘自休，也似春无力。\n耕夫晓尚眠，蚕妇夜多息。\n从兹家业荒，共落风尘迹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17085,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"思归引 其二","author":"释重显","text":"常忆在庐山，随时寄瓶锡。\n五百与一千，聚头同遣日。\n猿攀影未回，鹤望情还失。\n教他王老师，痴钝无处觅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17086,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春风辞寄武威石秘校","author":"释重显","text":"春风何萧萧，和雨复兼雪。\n坼花功未深，偃草势曾烈。\n毗城痴爱老，怯寒对清拙。\n襄岩影响士，难御同孤劣。\n鳌峰人不来，柴门亦休闭。\n松头栗鼠下，时把藤床齧。\n庭际霜禽归，屡啄苔钱缺。\n一旦春风息，暖日生林樾。\n幽径磐石上，拄筇行且歇。\n无弦兮莫弹，有语兮存舌。\n冷落流水声，古之若为说。\n凋残早梅树，今之若为别。\n俯仰身力轻，翻忆春风切。\n为吾吹却尘，欲革分岐辙。\n为吾吹却云，欲问辽空月。\n不知天地间，堪为谁交结。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17087,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋日送僧","author":"释重显","text":"边雁影邪，寒蝉声速。\n乘时毳流，远别岩谷。\n林惊一叶兮微风触袖，水肃百川兮片月在目。\n因忆象骨老师曾送人，行行不谓抽金镞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17088,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送久禅德归兰亭","author":"释重显","text":"右军墨池月，照我复照谁。\n千里忽相到，中峰多病师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17089,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送小师元贲","author":"释重显","text":"愧尔求师，为吾弟子。\n学虽无闻，道亦可拟。\n平飞辩月，照复流水。\n斯意斯言兮如不忘，行行??兮步兰芷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17090,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送小师元哲","author":"释重显","text":"老卢之子，四三二一。\n将欲振飞，卷比丛室。\n松凌霜兮运青，水带岩兮流急。\n南北东西，云开见日。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17091,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送小师元楚","author":"释重显","text":"道之冥机，一何相守。\n汝竞光阴，我亲蒲柳。\n毋厚弁之夺席，毋薄愚之诵帚。\n深思彼伐木丁丁之声，照古照今兮宜善求友。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17092,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送广华严归鹫峰","author":"释重显","text":"海山孤僻非蓬岛，雾冷云深松桂老。\n有客凝冬何太高，巨野宵征苦相讨。\n岩房杳杳凌寒空，冰霜落落分谭丛。\n谁云百城沉古月，自笑八面生清风。\n俄然别我还归去，惠理之徒望回驭。\n重重无尽楼阁门，到必为时略轻据。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17093,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送广教专使","author":"释重显","text":"峨峨石头，使乎让祖。\n己之匪存，圣之奚慕。\n或妄以山，或索云斧。\n音耗不通兮清源派分，吾斯语兮讵可论古。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17094,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送云禅德","author":"释重显","text":"古之送人，言作怀宝。\n我惭老病，困乏辞藻。\n熊岭迢迢兮曾立夜雪，谢池依依兮笑生春草。\n头角麟龙安可论，清风步步应相讨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17095,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送从吉禅者","author":"释重显","text":"君不见行路难，亦容易，握草为金不为贵。\n难曾平地涌波澜，易复到处列祥瑞。\n堪笑堪悲能几几，天上人间立高轨。\n兄弟十字越参星，一义同心淡秋水。\n因忆韶阳古风骨，石火雷光迟出没。\n隔身之句是程途，扣门之问非窠窟。\n殷勤报君君记取，方外周游看爪距。\n虎狼丛不遇知音，剔起眉毛便归去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17096,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送元安禅者","author":"释重显","text":"群峰杳蔼留不住，远道依依祇藤屦。\n旧隐萝龛付与谁，寒猿后夜啼高树。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17097,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送文佶归庐岳","author":"释重显","text":"春色未深，兴无迟早。\n瓶谢九江，峰寻五老。\n到日攀萝独上时，依依莫忘海山脑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17098,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送文政禅者","author":"释重显","text":"古有焦桐音，听寡不在弹。\n古有阳春曲，和寡不在言。\n言兮牙齿寒，未极离微根。\n弹兮岁月阑，未尽升沉源。\n少休几坐花木落，庾岭独行天地宽。\n因笑仲尼温伯雪，倾盖同途不同辙。\n麟兮凤兮安可论，许兮巢兮复何说。\n秋光澄澄蟾印水，秋风萧萧叶初坠。\n送君高蹈谁不知，如曰不知则为贵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17099,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送如香大师","author":"释重显","text":"栴檀叶落雨初歇，天外风清亦何别。\n后夜莲城溪月寒，孤光谁共倚寥泬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17100,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送师旻禅者","author":"释重显","text":"深岩寂寂披兰芷，碧雾红霞映流水。\n空生别我期未期，绝域殊方拟轻拟。\n堪笑归岭南，奔驰何鄙彼。\n危急乱抛下，尽云提不起。\n伊予本自不将来，相送奚凭挂唇齿。\n旻禅客，旻禅客，师子子，应须落落存终始。\n君不见古人有言兮，扑碎骊龙明月珠。\n大丈夫到如此，行行不用频弹指。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17101,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送庆颜禅者","author":"释重显","text":"岩桂风清香露滴，定起高秋映虚碧。\n断云不是归帝乡，飞落人间有谁识。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17102,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送廷利禅者","author":"释重显","text":"雷峰孤顶谁家路，上兮下兮复何故。\n曾列三千一半徒，我今独满当时数。\n鲸麟麟，龙鳞鳞，坤维高步生清尘。\n休云裴相慕黄檗，额有圆珠七尺身。\n利禅者，利禅者，倚天长剑应牢把。\n或谓风云不再来，谁为苍苍分昼夜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17103,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送百丈专使","author":"释重显","text":"大雄孤顶曾遐举，遍索诸方谁敢拒。\n乳窦峰前捋虎须，再得完全又归去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17104,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送别陈秘丞古意","author":"释重显","text":"悠悠层山云，断兮仍复续。\n离离双岸草，变兮且兼绿。\n如何苦雪霜，后凋蠹松竹。\n松竹有节操，雪霜无伎俩。\n敢折岁寒枝，赠君作嘉赏。\n行行天地间，清风在谁掌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17105,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送怀秀禅者","author":"释重显","text":"麻衣草座思灵彻，一食安闲更无别。\n倏忽迁流数百年，杳杳谁来继其绝。\n吾兮亦是疏慵辈，冷淡身心存慷恺。\n偶续灵峰照夜灯，遽泛铁船下沧海。\n深嗟知困不知休，奔驰骇浪空淹留。\n纵得长鳌拟何待，堪白头时好白头。\n因观坏衲秀禅客，清苦如冰复如檗。\n别我携筇步大方，为叶为花恣披拆。\n伏枕寥寥情意阑，率写狂歌赠行色。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17106,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送秀大师","author":"释重显","text":"岩窦宵寒拥山帔，月高古木霜禽睡。\n西庵禅者来扣门，别我凌晨下层翠。\n欲留不可留，写意不及意。\n屈眴迢迢安足云，花偈联联太容易。\n君不见刘阳叟，绝希冀，送人只道无他事。\n行行会有知音知，何必清风动天地。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17107,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送纯禅者","author":"释重显","text":"莎萝雨滴苍苔痕，前峰后峰啼断猿。\n携筇别我下层翠，何处静敲仁者门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17108,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送远尘禅者","author":"释重显","text":"衲卷残云，风高绝邻。\n倚天照雪，堪抗要津。\n八纮极目兮春山若黛，九野纵步兮汀草如茵。\n三十四老未轻识，凛然方外奚相亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17109,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送侃禅者之丹丘","author":"释重显","text":"石桥多古迹，路崄少人过。\n如同白日闲，冷拂青苔坐。\n寒老若相逢，为吾略嘲破。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17110,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送宗朴禅者","author":"释重显","text":"洞庭乳窦皆泉石，抱疾何缘寄幽迹。\n曾列狂机一二三，东山西岭非相识。\n屈指嚬眉不可寻，云飞雨散空沈沈。\n如今转觉流年隔，强把冥悰苦搜索。\n纵止言欺白雪辞，宁忘笑与黄梅客。\n朴禅者，朴禅者，珠月有光惭照夜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17111,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送宝相长老","author":"释重显","text":"奥域灵区存物外，独标台岭为绝槩。\n掩胜潜奇列作屏，堆青写碧深如黛。\n彤霞暖影生岩壁，香桂茂阴笼藓石。\n赤松子也浪虚闲，白道猷兮太轻掷。\n曹溪有叟归其中，风从虎兮云从龙。\n乘兴正值二三月，坐断还依千万峰。\n花飞飞，日迟迟，清飙??吹无时。\n玲珑八面自回合，峭峻一方谁敢窥。\n窥来须得乾坤眼，照古腾今谓非间。\n若能此去副全提，开发人天有何限。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17112,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送实山主","author":"释重显","text":"野水春山，风光极目。\n千里万里，太迟太速。\n绝域澄澄兮非犀炬可照，希声杳杳兮非凤胶可续。\n叶落花开知不知，人天景行为高躅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17113,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送法海长老","author":"释重显","text":"常爱裴相国，式芳尘，断际高风慕要伦。\n拟欲事师为弟子，不知将法付何人。\n常爱李相国，垂列星，药峤深源宅性灵。\n我来问道无馀说，云在清霄水在瓶。\n缅想当时二台辅，出镇藩维访诸祖。\n寥寥浮幻轻百年，落落宏规照千古。\n今闻仙都贤太守，入政褰帷声浩浩。\n英佐一一分化条，文经武纬亦难讨。\n远远笺函飞乳峰，选开士兮恢吾宗。\n觌夜光非震沧海，聆正音岂玩焦桐。\n徒誇麟龙，自西自东。\n应排罔象得象，必须觉雄让雄。\n今既塞请，还也奇别。\n茫茫普热，纷纷下雪。\n倒流四河，载发枯蘖。\n卷舒立方外乾坤，纵横挂域中日月。\n黄头碧眼知未知，去去凭谁继清绝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17114,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送知久禅者","author":"释重显","text":"霜竹凝寒携九节，铜瓶浪锁千溪月。\n天上人间不自知，行行谁共分清绝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17115,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送知白禅者","author":"释重显","text":"松不直，棘不曲，谁笑卞和三献玉。\n经天纬地太无端，迈古超今亦轻触。\n靡羁束，何必云，素范还还，真规复复。\n栴檀叶落香风清，千里万里长相逐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17116,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送亲禅者","author":"释重显","text":"万木带秋声，古今念睽别。\n我有赠行意，临行为君说。\n重岩休滞云，远水且观月。\n生生知不知，天风助清彻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17117,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送昭敏首座","author":"释重显","text":"君不见，鹫峰胜集，百万茫茫等闲过，坏衲之外皆清堕。\n君又不见，熊岭孤运，岁月索索艰难生，深雪之中有一个。\n宛转流落千馀年，危分崄布空平阗。\n弁龙蛇兮眼何正，擒虎兕兮机不全。\n石窗四顾沧溟窄，寥寥不许白云白。\n掣断金锁天麒麟，高举铁鞭击三百。\n犹轻舍，争知也，别有七星光斗射。\n风前把欲赠行人，将报不平绕天下。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17118,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送显冲禅者","author":"释重显","text":"聚散非常准，古今亦标格。\n如何无事人，还似未归客。\n秋风生群林，野水资寒色。\n谁兮谢寸阴，观彼青山白。\n冲禅行复行，五叶待时拆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17119,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送显冲禅者之霅上觐兄著作","author":"释重显","text":"选佛选官应在我，难兄难弟不唯他。\n汀花岸草芳菲日，远远清风争奈何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17120,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送胜因长老","author":"释重显","text":"黄梅散席三百载，续焰联芳事空在。\n宗兮派兮生异端，花兮叶兮太烦碎。\n韶阳间出多慷慨，权要雄雄曾绝待。\n曲木据位知几何，利刀剪却令人爱。\n近还有个披老衲，楚甸横身风飒飒。\n铁作一寻非等闲，壁立千仞须摧蹋。\n报君知，江南江北徒累累。\n鳌转海运兮纤鳞片甲，雷奔电驱兮寸毫尺氂。\n斯言勿谓存规矩，平不留兮险非取。\n周行独立如便休，谁振宏纲照千古。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17121,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送重郜禅者","author":"释重显","text":"春雨如膏，春云如鹤。\n忽此忽彼，乍休乍作。\n枯荄离离，维风太迟。\n幽石片片，辽空亦危。\n一花五叶兮不相似，独孤明兮还自知。\n还自知，历魏游梁徒尔为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17122,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]