[{"title":"次韵嵇仲春日 其二","author":"李弥逊","text":"花残爱日惟愁尽，病渴逢觞却厌多。\n不分闲中觉春老，强搜诗句逐阴何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60500,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵嵇仲春日 其一","author":"李弥逊","text":"欲挽馀芳近酒卮，丁宁红紫莫相违。\n纵无风雨飘零去，已是愁峰燕子归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60501,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵瑀老窗间","author":"李弥逊","text":"晴窗汲水养菖蒲，谁识前身是佛图。\n竟日不知园外事，耳明钟鼓唤斋盂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60502,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵谭彦成学士早春 其五","author":"李弥逊","text":"风絮萦寒昼拥炉，枝头犹得暗香馀。\n折来不拟供尊俎，静对翛然一榻书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60503,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵谭彦成学士早春 其四","author":"李弥逊","text":"渺渺家山水四涯，秋风曾忆醉黄华。\n马头不识南塘路，又看咸阳二月花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60504,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵谭彦成学士早春 其三","author":"李弥逊","text":"十二楼台白玉成，云车翻日上觚棱。\n太平何许同民乐，天阙双龙护一灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60505,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵谭彦成学士早春 其二","author":"李弥逊","text":"幽栖不寄绝交书，车马从喧卖酒垆。\n卧转午阴春睡足，却寻峰树数花须。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60506,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵谭彦成学士早春 其一","author":"李弥逊","text":"花蕾催红欲啭莺，新愁偏傍鬓毛生。\n犹怜稚子能赊酒，烂醉春盘碧涧羹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60507,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自大宁泛舟还泾川","author":"李弥逊","text":"岸梢浓染一溪青，山影归舟落叶轻。\n欲学渔郎飏纶手，雨蓑月笛了平生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60508,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"至化士自宣城归蒋陵求颂书此以赠","author":"李弥逊","text":"具足城中了胜缘，毗耶座上供无边。\n却收心迹归空洞，莫着俱胝一指禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60509,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟中风雨梅公择有不悦之色因用其韵与解之","author":"李弥逊","text":"清于明鉴绿于蓝，水色山容总一般。\n游子正怀羁旅恨，聊将目力解眉攒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60510,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟师谒祠回天风已霁信若有感姑以二绝道其事 其一","author":"李弥逊","text":"长芦山下隐龙宫，沥酒船回落照中。\n已有龟纹为传卜，不劳乌尾更占风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60511,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟师谒祠回天风已霁信若有感姑以二绝道其事 其二","author":"李弥逊","text":"水底明河碧浸星，琉璃不动一江平。\n横铺十幅指东去，坐看晓帆千里轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60512,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西山雨中独宿寄粹之","author":"李弥逊","text":"窈窕山房水样清，定回灯影暗还明。\n对床不见逃禅晋，竹雨声中梦不成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60513,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观月扬千寺门","author":"李弥逊","text":"背山灵利两松间，待月松前觌面山。\n云去月低松影落，倚天唯有碧回环。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60514,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过佛子岭","author":"李弥逊","text":"冈回岭转翠相重，觅语酬山未了工。\n却恐前生是摩结，此身今落花图中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60515,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过来贤阁有感","author":"李弥逊","text":"面熟前山小髻螺，綵衣竹马旧经过。\n回头四十年中事，清泪空如白发多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60516,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过岳冠山 其二","author":"李弥逊","text":"驾潮风急浪翻矶，舟子操舟不自持。\n若使畏涂知勇退，世间何处更乘危。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60517,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过铅山石井","author":"李弥逊","text":"抱石寒泉涌帝青，净涵窟宅驻鲵鲸。\n谁知润物功无尽，只见岩腰鉴样平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60518,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过铅山鹅湖登妙峰寺","author":"李弥逊","text":"松盖筠幢护石门，净居尘境此间分。\n不须更觅南行路，已向高峰见德云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60519,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"张从之许玉友辄用其七夕所赋韵以简之","author":"李弥逊","text":"四壁萧萧一味愁，了无从事到青州。\n殷勤独有张公子，为遣玉人宽鬓秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60520,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杨贯之提举挽诗 其二","author":"李弥逊","text":"锦衣人逐惊沤散，丹旐歌随落照低。\n它日扁舟江上路，酸风吹泪过姑溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60521,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杨贯之提举挽诗 其一","author":"李弥逊","text":"当年接翼上天池，旧事空存雁塔题。\n岂有新诗来渭北，谩令后学仰关西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60522,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"迎仙道中 其二","author":"李弥逊","text":"壶山孤秀似西山，道上归人洗眼看。\n到我西山山有伴，不知谁伴此山闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60523,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"迎仙道中 其一","author":"李弥逊","text":"枫林惨淡远山微，全是江南欲雪时。\n极目诸天云一色，只无六出上寒枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60524,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"近闻诸山例关堂石门老偶煮黄精以诗为寄次韵以戏之","author":"李弥逊","text":"束缚斋鱼昼掩关，长镵斸雪草泥间。\n竹炉石鼎甘香剩，分与衰翁却病颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60525,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和近思 其二","author":"李弥逊","text":"岩排绿树石相重，涨水交流失旧谼。\n细觅向来行历地，十年尘迹转头空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60526,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和近思 其一","author":"李弥逊","text":"风帆十日转长山，为送闲身到广寒。\n明月峰峦人境外，溪声一夜响前滩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60527,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和学士秋怀 其十五","author":"李弥逊","text":"漫漫长山去不分，欲于何处望阊门。\n寄声莲社还相忆，几日归鸿下故园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60528,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和学士秋怀 其十四","author":"李弥逊","text":"官居城郭枕山根，嬉语儿童亦带村。\n老子痴顽甘避俗，欲从社叟学方言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60529,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和学士秋怀 其十三","author":"李弥逊","text":"执手群歌田舍儿，年丰米价不嫌低。\n饱舂白雪已归市，晚割黄云犹枕畦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60530,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和学士秋怀 其十二","author":"李弥逊","text":"信手翻书老更便，卷书觅酒便颓然。\n一生百斛无馀事，只有残编未忍捐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60531,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和学士秋怀 其十一","author":"李弥逊","text":"饱饭茶瓯到手空，缓寻芳事夕阳风。\n旋移丝竹深藏笋，漫长秋风远避丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60532,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和学士秋怀 其十","author":"李弥逊","text":"便面南台缭绕山，晚云归尽远空闲。\n晴岚遍染参差玉，若比嵩阳季孟间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60533,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和学士秋怀 其九","author":"李弥逊","text":"灵均投老寄潇湘，身后声名日月光。\n被谤早知缘薏苡，引年谁复念菖阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60534,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和学士秋怀 其八","author":"李弥逊","text":"身世浮云任去留，老来于此更悠悠。\n却因削迹风波地，耳底风云得暂休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60535,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和学士秋怀 其七","author":"李弥逊","text":"秋净霜空露晓姿，水光山气总供诗。\n笔端幻出沧州趋，赖有骚人慰所思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60536,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和学士秋怀 其六","author":"李弥逊","text":"生涯自有餐霞法，归计新传种树书。\n人境不应容拓落，五松山脚是吾庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60537,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和学士秋怀 其五","author":"李弥逊","text":"十年行地一虚舟，过眼风烟几度秋。\n华发半从身外老，故山时得梦中游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60538,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和学士秋怀 其四","author":"李弥逊","text":"厚颜衰暑未甘衰，秋事于人却有期。\n怯雨垂蕉全披靡，受风疏苇强扶持。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60539,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和学士秋怀 其三","author":"李弥逊","text":"旋落檐花夜正喧，参横斗转有更传。\n了无人迹妨真梦，枕簟同参一味禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60540,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和学士秋怀 其二","author":"李弥逊","text":"雨滋时物各欣荣，小立方塘看水生。\n无数游鱼随去住，不容濠上有馀清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60541,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和学士秋怀 其一","author":"李弥逊","text":"却暑回飙入暮林，衰蝉无力尚微吟。\n不须更问秋多少，著蕊黄花已可簪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60542,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岳公来住涌泉愿为出化者十八人原上座因行袖诗谒筠溪老人风致清远可爱临行索偈书以赠之","author":"李弥逊","text":"屐声何土遣瞿昙，示病溪翁为扫庵。\n檐葡香中一盂饭，不妨归去饱同参。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60543,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"降虎峰慧慈塔","author":"李弥逊","text":"唤起田公趁晓耕，香云已带泻檐声。\n如何乞取摩空手，为挽天河洗甲兵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60544,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨中登北楼","author":"李弥逊","text":"白首登临海一隅，晚风吹雨上髭须。\n日边不见平安使，云影满川山有无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60545,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"复用前韵 其四","author":"李弥逊","text":"春半寒威不柰衰，一番细雨长青梅。\n惜花院落从风扫，待燕帘栊彻晓开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60546,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"复用前韵 其二","author":"李弥逊","text":"唤起春眠恨伯劳，一簪华发不禁搔。\n缓寻新绿偏疑竹，细数轻红错认桃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60547,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"复用前韵 其一","author":"李弥逊","text":"来辕去棹自惊频，七十无多半在陈。\n寸步家山不归去，空留猿鹤占青春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60548,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"复用前韵 其五","author":"李弥逊","text":"青精饭熟思留客，碧涧芹香可献君。\n睡起茶瓯风两腋，功名何啻等浮云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60549,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"复用前韵 其三","author":"李弥逊","text":"急雨残花绝可怜，花如鸡肋雨如拳。\n千金倘赎花枝怨，不为囊空惜一钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60550,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"将至水西登漠山休休庵少憩遂过白云","author":"李弥逊","text":"偶到灵山最上头，出檐高竹不知秋。\n杖藜欲趁西溪月，未放闲身尽日游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60551,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"将至黄山寺细雨微云戏作绝句呈一老禅师","author":"李弥逊","text":"试将千里看山眼，来访山中佛祖家。\n已识黄山真面目，主山犹放白云遮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60552,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"彦定知县府判池有双莲置酒其上坐客有诗姑以三绝塞责 其二","author":"李弥逊","text":"倾国从来少并芳，人间那得两巫阳。\n丹青不解传真态，恐是菱花对晚妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60553,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"彦定知县府判池有双莲置酒其上坐客有诗姑以三绝塞责 其三","author":"李弥逊","text":"蕙兰同气犹争长，姚魏齐名各一家。\n不似优昙照寒水，一茎能现四边花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60554,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"彦定知县府判池有双莲置酒其上坐客有诗姑以三绝塞责 其一","author":"李弥逊","text":"剪剪高荷舞翠阴，并游湘女驻波心。\n谁知罗袜无虚步，来听薰风百里琴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60555,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日书斋偶成 其五","author":"李弥逊","text":"清氛远俗推兰友，直节过人见竹君。\n慰我山城长寂寞，相期高卧敬亭云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60556,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日书斋偶成 其四","author":"李弥逊","text":"桃红半老杏红衰，乱委苍苔况是梅。\n不恨狂风取花去，一樽寒食为谁开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60557,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日书斋偶成 其三","author":"李弥逊","text":"柳花才落未成绵，海蕊初分半尚攀。\n鸭甲不鸣深院昼，一床真梦不论钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60558,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日书斋偶成 其二","author":"李弥逊","text":"渐老追芳苦厌劳，团蒲攲坐首慵搔。\n解将一笑醒人眼，多谢红稠屋角桃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60559,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日书斋偶成 其一","author":"李弥逊","text":"底急流光过眼频，斩新花蕊已成陈。\n手移红药东风里，着意流连背我春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60560,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春夜信笔书","author":"李弥逊","text":"枝上红残遍地香，沈郎瘦骨叹更长。\n东邻唤客笙歌闹，琥珀杯空夜未央。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60561,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春雨","author":"李弥逊","text":"濛濛烟雨网春晖，南陌清明二月时。\n细草养泥供燕子，好花藏蜜待蜂儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60562,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春晚舟行 其三","author":"李弥逊","text":"融融春日觉身闲，急水浮舟下石湾。\n此去知心唯杜宇，与君结伴老家山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60563,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春晚舟行 其二","author":"李弥逊","text":"病眼看花似梦中，可堪红紫半成空。\n一年三月春馀几，枕上那闻昨夜风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60564,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春晚舟行 其一","author":"李弥逊","text":"桑椹初生柳叶秾，薰风咄咄逼春工。\n物华过眼真堪恨，绿发今成一老翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60565,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋晚即事 其三","author":"李弥逊","text":"霜树今无一叶留，日边云暗使人愁。\n独怜扬子湾头岸，犹有黄花恋晚秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60566,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋晚即事 其二","author":"李弥逊","text":"华发鬅鬙一榻书，舟移斜日似籧篨。\n似闻载酒江边寺，更倒青钱留白鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60567,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋晚即事 其一","author":"李弥逊","text":"一水萦回两岸鸥，翩翩无数近行舟。\n十年不见浑如旧，有意随人天际浮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60568,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送庆侍者之净众","author":"李弥逊","text":"风摇顶笠晓山隈，觅法心如未熟梅。\n去路两肩担不起，会看撒手得空回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60569,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送昭亭李道士归闽","author":"李弥逊","text":"昭亭高隐倦淹留，归驭飘然下十洲。\n我亦半生随泛宅，故园空忆洞庭秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60570,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送玿公长老赴南剑光孝之请","author":"李弥逊","text":"好手逢场了不同，五家宗外立家风。\n玿师一句当机语，不道杨岐栗棘逢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60571,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闻子规","author":"李弥逊","text":"客里春秋过半生，子规枝上最关情。\n南来故国一万里，却笑子规犹乱鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60572,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"面壁庵","author":"李弥逊","text":"败壁纵横销翠烟，岩花犹落旧庵前。\n从来说法无人会，寂寂空山谩九年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60573,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"席上次邵文伯颜","author":"李弥逊","text":"月色漾明玉，花光扬素波。\n醉吟吾岂敢，能赋属阴何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60574,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"席上信笔 其六","author":"李弥逊","text":"老来万事耳边风，惭愧灯花未结红。\n欲把一尊聊自解，空花入眼暗濛濛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60575,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"席上信笔 其五","author":"李弥逊","text":"花神不管勒花风，开尽深红到浅红。\n未放游人偷眼看，已惊红雨乱濛濛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60576,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]