[{"title":"夏日三首 其二","author":"张耒","text":"黄帘翠幕断飞蝇，午影当轩睡未兴。\n枕稳海鱼镌紫石，扇凉山雪画青缯。\n廊阴日转雕栏树，坐冷风生玉碗冰。\n满案诗书尘蠹甚，故应疏懒过炎蒸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51882,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏日三首 其一","author":"张耒","text":"长夏江村风日清，檐牙燕雀已生成。\n蝶衣晒粉花枝午，蛛网添丝屋角晴。\n落落疏帘邀月影，嘈嘈虚枕纳溪声。\n久拚两鬓如霜雪，直欲樵渔过此生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51883,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏日杂兴四首 其四","author":"张耒","text":"蔬圃茅斋三亩馀，溪光山影动浮虚。\n病妻老去惟寻药，稚子年来解爱书。\n中散无堪心放荡，冯唐已老兴萧疏。\n全真养素安吾分，敢谓轩裳不我如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51884,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏日杂兴四首 其三","author":"张耒","text":"墙下溪流清且长，夹溪乔木雨苍苍。\n袅风翠果擎枝重，照水圆荷舞叶凉。\n蜗壳已枯黏粉壁，燕泥时落污书床。\n南山野客閒相过，赠我能携药满筐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51885,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏日杂兴四首 其二","author":"张耒","text":"无地从容解郁陶，寄怀林野散尘劳。\n含风槐柳参天合，足雨桑麻映露高。\n五斗得官迷簿领，一廛何处斸蓬蒿。\n致身富贵须年少，顾我衰迟已二毛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51886,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏日杂兴四首 其一","author":"张耒","text":"隔墙泉下是东溪，细溜涓涓入我池。\n一部笙箫寒竹响，百年风雨古槐姿。\n果悬幽槛朱初熟，蔓度空墙翠欲垂。\n野趣转深身愈老，故应寂寞畏人知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51887,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽李少卿","author":"张耒","text":"几年林下远埃尘，儒雅风流谁与邻。\n笔尾病来犹壮健，诗情老去更清新。\n幽斋昔日琴书换，新冢东风草木春。\n怀想只疑高兴在，一吟遗句泪沾巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51888,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽黄几道","author":"张耒","text":"异政颍川凤，遗风叔度陂。\n闻哀苦朋友，归葬束书诗。\n百岁乡人社，他年故吏碑。\n知公万金产，故在阿戎儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51889,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"效白体二首 其二","author":"张耒","text":"州贫须惜尊罍费，俗陋兼无妓乐名。\n幸有蒲团供燕坐，不妨藜杖助閒行。\n看炊香稻供斋饭，自采寒蔬试野羹。\n身外无营内无事，近来心气尽和平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51890,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"效白体二首 其一","author":"张耒","text":"功名富贵付悠悠，高卧山城又过秋。\n燕坐香灯为静侣，閒行麋鹿是同游。\n青黄草木新霜过，潇洒溪山夜雨收。\n回首十年梁苑客，枉教白却少年头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51891,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"效白体赠杨补之","author":"张耒","text":"青衫居士断荤血，一榻萧然如在山。\n堂下黄花惊岁晚，尊中绿酒觉官閒。\n胸中已了一事大，镜里莫惊两鬓斑。\n我亦久怀伊洛兴，烦君先为卜禅关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51892,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓作","author":"张耒","text":"静枕有远听，风声带晓江。\n寒云垂紞紞，严鼓已逢逢。\n功业惊残岁，江山隐陋邦。\n寒鸡憎客梦，呼日上低窗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51893,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"栾提举妻石氏挽词","author":"张耒","text":"和敬承夫顺，勤劬教子贤。\n平生积净业，仓卒叹无年。\n孤剑留耿介，九雏谁抚怜。\n尘埃旧脂泽，春草掩新阡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51894,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"润州书事","author":"张耒","text":"野蔓封城堞，疏松隔丽谯。\n楼临寒汹涌，门揖翠岧峣。\n客思闲易感，归心去莫招。\n何时送客处，看我理归桡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51895,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病肺齿痛对雪","author":"张耒","text":"拥庭晴雪照高堂，卧病悠悠废举觞。\n肺疾仅同园令渴，齿伤不为幼舆狂。\n交飞翠斝知谁醉，独嗅乌巾认旧香。\n惟有烹茶心未厌，故知淡泊味能长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51896,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"破幌","author":"张耒","text":"破幌一点白，卧知千里明。\n低窗通雪气，乔木尚风声。\n传警军城静，鸣钟梵刹清。\n高眠寻断梦，邻树已乌惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51897,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"离山阳入都寄徐仲车","author":"张耒","text":"孤城芳树碧层层，村落黄昏只见灯。\n回首事如前夕梦，出门心似下山僧。\n仕求行道时难偶，意欲谋閒力不能。\n寄语东皋多酿酒，待予归日解行縢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51898,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"离天长寄周重实","author":"张耒","text":"相逢握手便忘形，射策天门尽弟兄。\n浮世有谁尊道义，青衫自笑为功名。\n高谈未尽胸中意，作别犹如梦后惊。\n半夜叩门投野寺，天寒孤月更分明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51899,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"离光山驿","author":"张耒","text":"邮亭结束问残更，斜月西南鸡未鸣。\n草草劳人常少睡，绵绵远道苦无情。\n田家稔熟人情好，野路雨馀秋气清。\n老得一州藏拙去，鹓鸾台阁尽豪英。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51900,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"离陈至华西","author":"张耒","text":"落日照原隰，晚风吹客鞭。\n空巢霜后木，残蘖烧馀田。\n憔悴贫中客，苍茫岁暮天。\n远游轻道路，无地息劳肩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51901,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"离建雄涂中","author":"张耒","text":"远水悠悠静，孤樯袅袅迟。\n草深春已后，麦秀日长时。\n聚语条桑妇，行歌拾穗儿。\n年丰随处乐，飘泊我何为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51902,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"离宿州后寄兄弟","author":"张耒","text":"落日村桥涕泫然，东风匹马去翩翩。\n两行绿树当隋岸，一片春云限楚天。\n妄意致身常许国，强颜得禄废求田。\n幅巾会作淮南叟，白发相收一钓船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51903,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"离富池望庐岳是日入夹口直达浔阳遂舍大江之险示同行","author":"张耒","text":"山秀江清三百里，与君三宿一扁舟。\n饮残桑落溪云暮，卧冷桃笙楚雨秋。\n舟隐长江逢夹口，眼明五老立云头。\n几年泽国行将遍，归与亲朋说旧游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51904,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"离楚夜泊高丽馆寄杨克一甥四首 其三","author":"张耒","text":"客去水关闭，疏灯亦复收。\n川鸣半夜雨，卧冷五更秋。\n扁舟已寒暑，冉冉真乘桴。\n一灯照客睡，短梦良悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51905,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"离蕲阳守风林皇方虑风壮晚未知所止俄顷风息一食顷宿富池作诗示同行","author":"张耒","text":"老怕风波见辄惊，赖逢谈笑慰危情。\n纵观云岭屏风合，坐见江涛镜面平。\n淹速人生难预计，险夷世路不须营。\n尘埃老作东州守，得得扁舟作此行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51906,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秦兵部书堂","author":"张耒","text":"丈人怜我厚，许与过常情。\n身世已迂阔，功名何敢争。\n笑谈忘晚辈，樽俎罄生平。\n欲斸临淮地，从公老此生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51907,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读孙巨源经纬集","author":"张耒","text":"等閒咳唾烂成文，奏牍三千世共珍。\n不向人间调鼎鼐，却归天上作麒麟。\n侍游曲水欢何在，敷奏延英迹已陈。\n四辅当时曾避柱，熙宁天子属词臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51908,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读黄鲁直诗","author":"张耒","text":"江南宿草一荒丘，试读遗编涕不收。\n不践前人旧行迹，独惊斯世擅风流。\n一尊华发江边客，万里黄茅岭外州。\n虎豹磨牙九关邃，重华可诉且南游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51909,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"都梁夜景","author":"张耒","text":"浩浩黄流注渺漫，南山峰岭对巑岏。\n青灯覆地严城夜，白月当天淮上寒。\n酒市歌呼迷客醉，画楼灯火暗更残。\n扁舟老客无馀事，拥褐高眠夜未阑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51910,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"都梁亭下","author":"张耒","text":"金塔青冥上，孤城苍莽中。\n浅山寒带水，旱日白吹风。\n人事剧翻手，生涯真转蓬。\n高眠待春涨，鲑菜伴南公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51911,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"都梁雪天晚望","author":"张耒","text":"浮梁淮面欲飞腾，金碧浮屠间玉层。\n古岸萧条风捲雪，长河咽绝水浮冰。\n留连淮汴残年客，蹭蹬尘埃一老僧。\n闻道都梁梅未拆，可随桃李畏严凝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51912,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"钱仲珣追船及陈留","author":"张耒","text":"野岸南风百草长，沄沄汴水卷沙黄。\n扁舟转柁迷城市，送客追船罗酒浆。\n休唱阳关伤远别，所欣莼菜入新堂。\n宦名衰晚君无问，便得封侯鬓已苍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51913,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶成","author":"张耒","text":"却扫客不至，端为四国骚。\n杯寒荐园实，食俭煮溪毛。\n霜过橘柚熟，天晴鸿鹄高。\n幽斋高木近，不寝听鸡号。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51914,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶成二首 其二","author":"张耒","text":"绿遍长安树，春归空隔年。\n愁多落花地，情远倚楼天。\n河汉昆崙外，苍龙北极天。\n老知玄有味，羞更赋神仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51915,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶成二首 其一","author":"张耒","text":"鸟啼宫直散，归舍日犹长。\n暗树残春绿，回风欲雨凉。\n久知痴有绝，端为酒成忙。\n可是嘲须解，平生一漫郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51916,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶成题裴晋公祠","author":"张耒","text":"独持将钺静氛妖，后世英名日月昭。\n善听圣君非易遇，将亡凶竖不难枭。\n悲风蔓草移今古，野殿空庭锁寂寥。\n更有从军老司马，铭功文字配咸韶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51917,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿马庄寺","author":"张耒","text":"冲泥我马僵欲仆，空村落日不逢人。\n开门野寺净如扫，迎客老僧閒更真。\n佛案青黄园果细，斋厨汲洗野蔬频。\n年来到处无馀念，静对同龛金色身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51918,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿东鲁父居二首 其二","author":"张耒","text":"郡国何时极，羁愁触处生。\n望随天不尽，春共野兼平。\n烟树淮南阔，渔盐楚俗轻。\n飘零五年别，叹息鬓毛更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51919,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿东鲁父居二首 其一","author":"张耒","text":"夕阳低欲尽，春浅色萧萧。\n暝色催归牧，炊烟向晚樵。\n疏星临水际，远火隔村桥。\n黯黯柴门夜，栖鸦对寂寥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51920,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿故济阳城","author":"张耒","text":"夜色萧条寺，天寒老病身。\n空村惟有雪，远道更无人。\n不寐依炉暖，多愁赖酒醇。\n遥思双凤阙，雨露已先春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51921,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿柳子观音寺","author":"张耒","text":"黄尘满道客衣穿，古寺荒凉暂息肩。\n倦体收来便稳榻，汗颜濯去快寒泉。\n野僧治饭挑蔬至，童子携茶对客煎。\n夜久月高风铎响，木鱼呼觉五更眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51922,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿铜陵","author":"张耒","text":"山色日已远，问人归路长。\n碧天凉夜阔，秋物雨馀荒。\n人静路傍寺，鸟啼林下房。\n铜陵竟何就，空死汉吴王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51923,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寂寂","author":"张耒","text":"寂寂秋日暮，辉辉檐影斜。\n鸣虫隐衰蔓，晚蝶守馀花。\n雨急荷翻叶，墙崩竹引芽。\n不才非吏隐，鸡黍学山家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51924,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄子由二首 其二","author":"张耒","text":"丈席他年闻至言，艰难不敢坠周旋。\n文词老去真何益，道妙平生薄有缘。\n人事眼前惟欲睡，丹经肘后更难传。\n清秋一室林泉好，洒扫思为杖屦先。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51925,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄子由二首 其一","author":"张耒","text":"万里归来真得仙，七年瞻望漫悁悁。\n安閒旧得还丹诀，著论新成古史编。\n应接强颜聊复尔，是非袖手独超然。\n门人白首侯芭在，眷恋微官愧昔贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51926,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄文刚求蟹","author":"张耒","text":"遥知涟水蟹，九月已经霜。\n筐实黄金重，螯肥白玉香。\n尘埃离故国，诗酒寄他乡。\n苦乏西来使，何缘至洛阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51927,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄陈鼎","author":"张耒","text":"懒著青衫沉醉眠，近来沽酒困无钱。\n常忧送乏邻僧米，何啻寒无坐客毡。\n直道漫凭詹尹卜，浮生已付祖师禅。\n祇应居士无醒日，知有渊明种秫田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51928,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄陈履常二首 其二","author":"张耒","text":"故人犹念我，一笑向何人。\n老去唯佛祖，州闲如隐沦。\n残年河朔雪，近腊水乡春。\n何日相逢笑，天边白发新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51929,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄陈履常二首 其一","author":"张耒","text":"近闻彭泽令，旅饭寄招提。\n杜老不厌赋，韦郎犹愧妻。\n得州惭牧养，怀友负招携。\n祇学新诗好，高吟独醉泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51930,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄荣子雍三首 其三","author":"张耒","text":"家家新酒滴新醅，残岁峥嵘春欲回。\n霜野寂无新到雁，雪林寒有欲开梅。\n关河路永双横辙，天地身閒一举杯。\n酬答风光千点泪，怯将愁眼更登台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51931,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄荣子雍三首 其二","author":"张耒","text":"苍苍老柏古南禅，袅袅修篁泮水湾。\n此地笑谈惟我共，百年交友得君难。\n已甘心向诗书老，会与身图云水閒。\n年少功名须力致，看君朝佩日珊珊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51932,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄荣子雍三首 其一","author":"张耒","text":"东风三月洛阳城，倾盖相逢气倍增。\n看尽园花方信马，饮斜楼月更挑灯。\n年光飘忽双驰毂，心事萧条一老僧。\n酒病年来慵把笔，新文寄我苦凭陵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51933,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄晁应之二首 其二","author":"张耒","text":"瑜珥瑶环豁眼明，碧梧翠竹照人清。\n同车汲黯今难忮，挟弹潘郎旧有名。\n自是风流袭家世，行看谈笑取公卿。\n尘埃落魄谁如我，一事无成白发生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51934,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄晁应之二首 其一","author":"张耒","text":"强读诗书叹白头，一官飘泊寄东周。\n匏瓜有系身难去，人足无音境更幽。\n晚接贤豪宽病思，老将文字写离忧。\n相思一夕亲谈笑，梦断云山相对愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51935,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄滁州邵子发同年二首 其二","author":"张耒","text":"年来万事付禅宗，两鬓虽青心已翁。\n欲借一廛希许子，更将五斗继无功。\n春来行乐君应厌，老去裁诗我未工。\n闻道琅邪山色好，为题新句寄清风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51936,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄滁州邵子发同年二首 其一","author":"张耒","text":"夫子才豪官尚卑，穷城冷落有谁知。\n莫嫌五斗纡高兴，且与青山赋好诗。\n得失可齐陶令酒，功名休问蜀庄蓍。\n三年流落甘忧患，一笑何当慰别离。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51937,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄蔡彦规兼谢惠酥梨二首 其二","author":"张耒","text":"洛川北岸锦屏西，竹树萧萧面翠微。\n风月有情常似旧，山川信美不如归。\n文章送老甘无用，鱼鸟从游久息机。\n寄语长安倦游客，年来何事素书稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51938,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄蔡彦规兼谢惠酥梨二首 其一","author":"张耒","text":"自煮新酥笼旋开，秦霜犹污紫梨腮。\n旧园歌舞唐宫废，灌顶醍醐佛国来。\n寄我远传千里意，憾君不举百分杯。\n西来新味饶乡思，淮蟹湖鱼几日回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51939,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"探春有感二首 其一","author":"张耒","text":"出城但怪风光老，草色苍茫柳色深。\n烟树远浮春缥缈，风光不动日阴沉。\n芳郊未厌萦纡入，美酒何妨取次斟。\n羸马青衫亦何事，一生空负野人心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51940,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"探春有感二首 其二","author":"张耒","text":"柳萼蒙茸待放绵，樱桃新叶大如钱。\n深春冷落花残后，寒食朦胧月淡天。\n独坐每将诗作伴，遣愁安得酒如泉。\n伤心千里休凝望，城外东风早满船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51941,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"探梅有感","author":"张耒","text":"泽畔骚人未放回，江边又探腊前梅。\n已知无木相先得，固使凌寒特地开。\n杜老阁前劳赋咏，玉川窗外独惊猜。\n试思感旧伤千里，可以临风举一杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51942,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚卧","author":"张耒","text":"日落烦暑退，秋晴河汉明。\n微云映天白，纤月过林清。\n独卧谁晤语，幽怀殊未平。\n萧萧夜深冷，皓露满前楹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51943,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚泊襄邑","author":"张耒","text":"月暗风林静，斗垂霜夜清。\n疏灯隔树小，暗水历船鸣。\n学字声形苦，紬书卜祝轻。\n此身南北惯，随处有平生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51944,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚凉行稻畦间","author":"张耒","text":"草木秋微警，山川夏已深。\n迎风云卷幕，沉日水浮金。\n晚鸟吟高木，霏烟暝远林。\n杖藜循野泽，谈笑不行吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51945,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚晴","author":"张耒","text":"裛尘朝雨细，透竹夕阳明。\n鸟雀知春去，牛羊散晚晴。\n官闲端欲老，谋拙漫无成。\n堂下清溪水，三逢蘋芷生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51946,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚霁","author":"张耒","text":"山川收滞雨，乌鹊有和声。\n半岭日犹照，一天云尽行。\n人皆理墙壁，吾亦扫柴荆。\n鹅鸭何多喜，渠流漾浅清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51947,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]