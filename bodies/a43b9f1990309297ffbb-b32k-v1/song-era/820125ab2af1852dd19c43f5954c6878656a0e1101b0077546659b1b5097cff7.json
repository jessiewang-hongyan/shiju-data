[{"title":"临安道中二首 其一","author":"孙觌","text":"莽莽原野迥，练练沙水清。\n径封面苔滑，树陨风箨鸣。\n小立听鸟语，深寻见鱼行。\n夕阳红未敛，彷佛见参横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6299,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"临安道中二首 其二","author":"孙觌","text":"微流隐复见，一曲宛秋蛇。\n柳老虫巢叶，潮平鸟篆沙。\n青鞋踏雨滑，乌帽倚风斜。\n何处堪携手，宜城卖酒家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6300,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"将军树","author":"孙觌","text":"当年树下遂儿嬉，直到将军衣锦时。\n老干千年龙化后，如今空有寄生枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6301,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"广教寺种玉轩","author":"孙觌","text":"道人馀净业，种竹把云根。\n野色禅窗迅，秋声客枕喧。\n持锄掀鼠壤，插棘护龙孙。\n不放纤尘立，清风自满门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6302,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"广教寺涌翠阁","author":"孙觌","text":"高甍缥渺冠曾巅，一握孤云尺五天。\n试向堂前参翠柏，要看地底出青莲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6303,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"某送妻母章硕人之葬道过紫藤省拜妻祖庄敏公及妻伯叔诸公之墓题胜因寺壁","author":"孙觌","text":"宰树连山泪叶春，累累高冢卧麒麟。\n羊昙一恸西州去，华屋生存有几人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6304,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"临安罗氏占春轩","author":"孙觌","text":"扶疏绕屋树葱茏，一笑欢迎得此翁。\n燕麦兔葵俱扫地，只栽桃李占春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6305,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄题虞阳山周氏隐居五咏 其一 妙光庵","author":"孙觌","text":"孤烟抱水村，落日满云树。\n乱山如连环，杨柳是门处。\n青缭竹溪湾，翠点苔石路。\n钟鱼寂无声，白日掩僧户。\n茗碗酌云腴，香篆擢烟缕。\n坐稳不知夕，炯炯山月吐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6306,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄题虞阳山周氏隐居五咏 其二 佚老堂","author":"孙觌","text":"浮生知几何，闻道苦不早。\n过眼电掣云，转看露晞草。\n匆匆已解镳，马鬣翳蓬葆。\n夫君悟无生，不待须发皓。\n朝行清溪曲，暮宿白云道。\n柴门鸟迹绝，槁叶风自扫。\n竹间雨泠泠，花上日杲杲。\n坐对五大夫，自足休吾老。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6307,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄题虞阳山周氏隐居五咏 其三 柳堂渔舍","author":"孙觌","text":"老来厌朝市，静占五百弓。\n山棱瘦如削，水面清若空。\n行穿万盖青，卧戴一叶红。\n黄柑千头奴，白凫五尺童。\n银刀贯翠缕，象鼻卷碧筒。\n一醉百不知，渔父真家风。\n幽寻属无事，散此九节筇。\n空濛水云里，端生画屏中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6308,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄题虞阳山周氏隐居五咏 其四 环翠亭","author":"孙觌","text":"樵磴盘苍巘，渔矶俯碧潭。\n群尖清染黛，一曲翠挼蓝。\n冉冉松云细，娟娟竹露涵。\n春风万杨柳，绿影乱毵毵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6309,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄题虞阳山周氏隐居五咏 其五 五秀堂","author":"孙觌","text":"一干中柴立，交柯拥四垂。\n定知三世种，已长五孙枝。\n端是神明力，非关雨露私。\n踌躇三匝绕，为赋角弓诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6310,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"卓持者手持筇竹见遗书六言一偈","author":"孙觌","text":"滇池赤藤使者，太乙青藜老仙。\n如何一筇九节，拄到玉女盆边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6311,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"喜陈绍曾至","author":"孙觌","text":"雨苔荒径石，风叶拥门衡。\n破甑渠能顾，虚舟任自横。\n烛残无共影，谷应有同声。\n试问门前辙，多应是友生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6312,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"重阳前数日微暑小雨遂凉二首 其一","author":"孙觌","text":"小雨送残暑，新凉入郊墟。\n丹叶互明灭，玄云时卷舒。\n行蚁尚移垤，盘蜗已伏庐。\n翛翛风响变，零落扇思疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6313,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"重阳前数日微暑小雨遂凉二首 其二","author":"孙觌","text":"披衣趁鸡晨，耿耿残月曙。\n林表霁霞升，青红满云树。\n凉蝉犹抱叶，寒虫欲坏户。\n行行绕黄菊，狼藉衣上露。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6314,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"昆山道中二首 其一","author":"孙觌","text":"归鸟破烟没，飞泉隔陇分。\n松门挂疏雨，樵路蹋行云。\n独往随漫兴，高谈遗世纷。\n悠然一杯酒，可以傲人群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6315,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"昆山道中二首 其二","author":"孙觌","text":"日脚衔半璧，江面横匹素。\n一片黄芦秋，摵摵风景暮。\n闲枕曲肱眠，自琢撚须句。\n稍稍山月吐，已复草多露。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6316,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵叶首善龙图见寄","author":"孙觌","text":"十年流落卧漳滨，种秫畦蔬手自亲。\n心似疲牛犹喘月，身如病木岂知春。\n试弹长铗撩公子，忽解绨袍值故人。\n健笔纵横惊老眼，恍疑帝所梦韶钧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6317,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"吴汉逸家荆溪蓄古书奇器甚富余欲造观而未果赋小诗先之","author":"孙觌","text":"高人卧江海，烟雨三家村。\n白眼憎俗徒，青山自当门。\n披图望千载，耿耿尚自存。\n金铸騕袅蹄，漆书科斗文。\n虬螭盘六印，牺象刻四尊。\n剑包虎皮斑，琴漫蛇腹纹。\n犹吐星芒寒，尚带雷斧痕。\n我亦望古者，昂昂真戴盆。\n傥未倚门挥，应许置榻论。\n从公问奇字，载酒过子云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6318,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题删定侄画卷二首 其一","author":"孙觌","text":"笔下凿开混沌，眼中见此崔嵬。\n海上神鳌负出，天边灵鹫飞来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6319,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题删定侄画卷二首 其二","author":"孙觌","text":"水边两鹄语时，山下一牛鸣地。\n苍梧翠竹森然，长与闲云卧起。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6320,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄题四明吴协拙轩二首 其一","author":"孙觌","text":"分寸跻攀曳九牛，一锥无地拙于鸠。\n穿针结缕非吾事，不上天孙乞巧楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6321,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄题四明吴协拙轩二首 其二","author":"孙觌","text":"老罢谁当问喘牛，羁栖具作寄巢鸠。\n盖茆一把藏吾拙，便是元龙百尺楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6322,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄题临安王氏通幽轩","author":"孙觌","text":"翠樾两檐交复，紫苔一径微通。\n雨箨犹含夏绿，风苞已褪春红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6323,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"柳","author":"孙觌","text":"修纤似束楚腰支，杨柳春风二月时。\n金地化身千佛眼，锦江新样十宫眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6324,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雨二首 其一","author":"孙觌","text":"山空发清响，楼迥落馀霏。\n掩冉花头重，浑酣水面肥。\n喧豗沉地镜，飘洒净垣衣。\n数点苍茫里，饥乌接翅归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6325,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雨二首 其二","author":"孙觌","text":"淅沥珠跳瓦，淋浪绠缒檐。\n林园春寂寂，灯火夜厌厌。\n寒著衣棱起，愁牵酒户添。\n诗翁独无事，危坐撚衰髯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6326,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送僧德最","author":"孙觌","text":"剥啄动柴荆，相看两眼青。\n诗如云态度，人似鹤仪形。\n妙斲窥天巧，哀弹感梦灵。\n定知花雨里，乱石点头听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6327,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"朱彦直穹石堂","author":"孙觌","text":"拟把高天补，曾将巨海填。\n犹残如蜗练，尚带祖龙鞭。\n势重坤舆壮，根深粤峤连。\n孤骞抟鹫羽，突立冠鳌颠。\n锡号俄三品，论材但一拳。\n谁令此奇伟，偃卧独魁然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6328,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"小园春事二首 其一","author":"孙觌","text":"屋头唤雨泥滑滑，万瓦纷披土囊发。\n西园春事一时休，繁红浸乱烟脂雪。\n绿萝高张翠羽盖，苍巘中断青玉玦。\n不见枝上一点红，千顷桑麻光似泼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6329,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"小园春事二首 其二","author":"孙觌","text":"小园花柳争春发，风雨颠狂二三月。\n断梗梢空转若迷，细红糁径繁如缬。\n叵堪绕屋溜潺潺，可厌触途泥活活。\n不妨暂柅故人车，大似陈公井中辖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6330,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夏日田舍二首 其一","author":"孙觌","text":"断堑疏新碧，长林惊远扬。\n鱼跳蒲叶偃，鹊起树头昂。\n觅句投诗社，逃禅入醉乡。\n梦回残酒里，月可一庭方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6331,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夏日田舍二首 其二","author":"孙觌","text":"麦卧黄云垄，秧分绿锦畦。\n犬来迎客路，鸟去背人啼。\n虺虺饥雷吼，昏昏醉缬迷。\n只疑尘土涴，独自照清溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6332,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夏日京口道中二首 其一","author":"孙觌","text":"冉冉征途去，眈眈畏日长。\n枕流浣清泚，倚树憩苍凉。\n蝉抱风枝响，萤升露草光。\n不眠愁独夜，卧看月侵床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6333,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夏日京口道中二首 其二","author":"孙觌","text":"亭皋一雨过，清飙吹面凉。\n云绽微月吐，引杯吸空光。\n独诣敞神界，冥搜破天荒。\n扣舷歌小海，幽意满沧浪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6334,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"京口普照寺","author":"孙觌","text":"败屋茨生草，崩崖蔓老藤。\n布金无长者，持钵有残僧。\n拨刺鱼跳釜，睢盱鼠瞰灯。\n炎炎三伏暑，岑绝冷如冰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6335,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"都统刘侯筑新第不居供佛其中号布金庵遣骑入泉南迎山老主之","author":"孙觌","text":"群魔起为祟，百堵掀作灰。\n那闻五花叶，但见一莓苔。\n将军道南宅，万础蟠金堆。\n天瑞黄鹤下，地涌青莲开。\n老仙逃僧去，大士问疾来。\n龙天拥猊坐，百蛮奋春雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6336,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"吴门道中","author":"孙觌","text":"小桥分路各西东，寂寂松窗半掩同。\n客梦悠扬残酒里，一池荷叶雨声中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6337,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"魏江道上得小庵解装小愒","author":"孙觌","text":"老柳当门翠十寻，桑麻一曲窈然深。\n苍苔满地无人扫，只有酴醾一架阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6338,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"示鹤林山老二首 其一","author":"孙觌","text":"应化来江右，乘流出峤南。\n后身逢七七，前话续三三。\n坐见诸天绕，来听二士谈。\n更无木上坐，只有佛同龛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6339,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"示鹤林山老二首 其二","author":"孙觌","text":"一别三千里，重临二十年。\n霜蒹空老矣，雪柏自依然。\n习气诗情在，真心佛果圆。\n相看无一语，趺坐炷炉烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6340,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宜兴林尉山父巢仙亭二首 其一","author":"孙觌","text":"半篙渌涨狎鸥边，万点青尖拄笏前。\n水色山容斗清好，吴中关市有巢仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6341,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宜兴林尉山父巢仙亭二首 其二","author":"孙觌","text":"且可浮沉随俗里，更将强健斗尊前。\n悬知天上多官府，盍向人中作地仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6342,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"浮远堂","author":"孙觌","text":"月堕山城小，沙寒水国秋。\n云根拔地起，冰柱蹴天浮。\n紫翠分鳌岭，青红杂蜃楼。\n舟航通万里，城郭数三州。\n刺史冯熊贵，仙翁控鲤游。\n八龙追后骏，五马驻前驺。\n露舄迎门鹊，风帘压海牛。\n地偏馀胜迹，山好对冥收。\n雨为催诗至，云应度曲留。\n欢呼领百罚，跌宕散千忧。\n颠倒青霞帔，淋漓紫绮裘。\n谁镵岘山石，千载记风流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6343,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"连雪苦寒二首 其一","author":"孙觌","text":"霜气森森背有芒，风棱槭槭面疑创。\n破衾且作龟头缩，短褐愁牵鹤胫长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6344,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"连雪苦寒二首 其二","author":"孙觌","text":"怪底骑驴咏雪诗，东风有信在南枝。\n来麰已报丰年瑞，属国餐毡且耐饥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6345,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"大雪后喜晴二首 其一","author":"孙觌","text":"岭雪班班在，崖泉咽咽鸣。\n一州明晓霁，万壑贮春声。\n蹬滑藤枝健，沙晴屐齿轻。\n小儿修净供，酌茗慰孤清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6346,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"大雪后喜晴二首 其二","author":"孙觌","text":"雪净山容改，风回野意新。\n草根清漠漠，沙尾碧鳞鳞。\n有客推门版，呼童整角巾。\n风流杨柳似，一噱散千颦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6347,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送邹次贾归临川二首 其一","author":"孙觌","text":"不负丹鸡约，来寻白马盟。\n龙钟著帽进，爵跃倒衣迎。\n感慨追平昔，惊呼问死生。\n殷勤一樽酒，闲健且同倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6348,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送邹次贾归临川二首 其二","author":"孙觌","text":"徒步轻千里，重临贲一邱。\n留欢不暖席，索去忽扁舟。\n惜别犹班草，传声可置邮。\n踌躇搔白首，独上仲宣楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6349,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"南唐门道上见桃二首 其一","author":"孙觌","text":"一径青苔短短篱，小桃竹外两三枝。\n殷勤待得黄昏月，正见斜红卧酒卮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6350,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"南唐门道上见桃二首 其二","author":"孙觌","text":"细红如糁未全匀，洗雨梳风日日新。\n前度刘郎在何处，故林空锁一枝春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6351,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"惠楙吉水轩二首 其一","author":"孙觌","text":"演漾浮清樾，千凝漫绿莎。\n更无野鸟渡，自有窟蟾过。\n短绠飞苍雪，长缨卷素波。\n会须号一噫，霹雳起龙梭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6352,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"惠楙吉水轩二首 其二","author":"孙觌","text":"练练迎朝霁，漻漻卷夜氛。\n挽河半天落，贮月一瓢分。\n荡胸饱新授，洗耳浣昔闻。\n谁知望梅者，肺渴已如焚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6353,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送删定侄赴高安郡丞","author":"孙觌","text":"纷纷戏事扰真情，梦入槐宫一饷荣。\n莫向蜗庐分两国，只将蚁垤当专城。\n遨头定自污三顾，纸尾何妨署一名。\n南望崆峒堪拄笏，白云飞处眼偏明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6354,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄题杨元光黄岩清畏轩","author":"孙觌","text":"杨公相大历，独擅德爵尊。\n清渭贯泾浊，寸胶定河浑。\n高名冠朝伦，流风被仍昆。\n悠然向千载，凛凛尚目存。\n官闲拥黄紬，卧听衙集喧。\n萧萧凫鹥行，重糈不到门。\n蝗虎不待驱，闻风自惊奔。\n所贵知我希，已及鱼与豚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6355,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题致思庵二首 其一","author":"孙觌","text":"草径冲泥滑，松门隐雾深。\n潜鱼寒上窟，宿鸟暝投林。\n风树摇青冢，云萝倚碧浔。\n禅翁蒙一衲，寂寞海潮音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6356,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题致思庵二首 其二","author":"孙觌","text":"宿雨连村暗，春流隔陇分。\n樯乌吟外见，城角定中闻。\n石鼎涵苍润，铜炉涌翠芬。\n明朝南北路，相望两孤云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6357,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"焦山吸江亭二首 其一","author":"孙觌","text":"昔年携客寄僧龛，败屋疏篱一草庵。\n白首重来看修竹，连山楼观亦眈眈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6358,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"焦山吸江亭二首 其二","author":"孙觌","text":"万顷苍茫一岛孤，潭潭云海现毗卢。\n问君吸尽西江水，中有曹溪一滴无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6359,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再赋五至堂二首 其一","author":"孙觌","text":"猊坐诸天绕，龙龛百鬼神。\n扪萝穿窈窕，拄策上峥嵘。\n雨送秋声入，风迎夜气生。\n降肛壹鼍吼，撇烈两凫惊。\n独诣超神界，真游梦化城。\n微吟更有味，琢雪斗僧清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6360,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再赋五至堂二首 其二","author":"孙觌","text":"老衲僧中龙，得度佛三世。\n苴茅制不借，剖竹作如意。\n徵心讯空王，礼足依梵帝。\n住世无三宿，应缘有五至。\n百年杞国忧，四大偃师戏。\n应作如是观，浮云本无蒂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6361,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"胡恭夫勉斋","author":"孙觌","text":"为山在进篑，学海自盈科。\n但见拳石小，才容一苇过。\n骎骎拔地起，千丈青坡陀。\n漫漫拍天流，万顷翠错磨。\n勉斋何为者，直意慕山河。\n高视俯遗垤，孤清镇颓波。\n巨植蟠杞梓，修麟窘蛟鼍。\n谁能探高深，潜珍有随和。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6362,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"静节轩二首 其一","author":"孙觌","text":"红紫纷纷半在亡，一轩风雨送春忙。\n青梅著子浑无数，绿笋穿林已许长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6363,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"静节轩二首 其二","author":"孙觌","text":"莲叶平铺塘水满，栋花半落渚风清。\n无言独立苍茫里，更听黄鹂一两声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6364,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"滁守平远堂","author":"孙觌","text":"魏公大雅士，英英峙冰玉。\n平反廷尉府，共理滁阳牧。\n奋髯慑狐鼠，折箠行凫鹜。\n高眠日照廊，坐啸风生竹。\n度堂云雨上，斗柄高插屋。\n摆落区中缘，超摇尘外躅。\n遥苍拥鬟髻，漱碧韵琴筑。\n虽无花解笑，自有云树宿。\n王春亦已班，臣昼可屡卜。\n举目送归鸿，寄此千里目。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6365,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"龟潭二首 其一","author":"孙觌","text":"绕舍莳兰荪，褰帘对竹君。\n移床栖樾荫，脱屣护苔纹。\n钓影垂潭月，樵歌出岭云。\n殷勤一瓢水，侑此井中芹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6366,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]