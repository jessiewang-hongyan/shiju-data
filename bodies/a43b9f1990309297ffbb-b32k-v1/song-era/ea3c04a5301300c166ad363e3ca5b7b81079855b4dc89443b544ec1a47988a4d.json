[{"title":"题汪水云诗卷 其五","author":"刘师复","text":"杖藜引客入渔家，尽敞蓬窗作供茶。\n三面阑干诗思阔，湖光千顷浸荷花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28698,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题汪水云诗卷 其四","author":"刘师复","text":"此客清狂似季真，意行湖曲眺青春。\n橹声往往来来好，山色朝朝暮暮新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28699,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题汪水云诗卷 其三","author":"刘师复","text":"天造西湖锦绣堆，柳边渔父小篷开。\n能言景定年间事，公主鸾箫锦棹来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28700,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题汪水云诗卷 其二","author":"刘师复","text":"别港莺娇恰恰啼，苏公堤过赵公堤。\n水西云北春无赖，细柳新蒲绿未齐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28701,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题汪水云诗卷 其一","author":"刘师复","text":"万里归来葺故园，阚湖新结小船轩。\n双亲八十喜康健，七子侍劳三十孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28702,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题汪水云诗卷 其十一","author":"刘师复","text":"水流云在意，政不限西东。\n山泽秋如瘦，江湖道亦穷。\n浙音惟我听，冀眼独居空。\n甚惜匆匆别，西风落叶中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28703,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其四","author":"刘师道","text":"金谷路尘埋国艳，武陵溪水泛天香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28704,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其九","author":"刘师道","text":"逝波帝子魂何在，芳草王孙怨未归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28705,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"刘师道","text":"南浦未伤春草碧，北山仍愧晓猿惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28706,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"刘师道","text":"久师金马客，勍敌玉溪生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28707,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其八","author":"刘师道","text":"三千世界银成色，十二楼台玉作层。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28708,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其七","author":"刘师道","text":"青帝翠华沈物外，素娥孀影吊云端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28709,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其五","author":"刘师道","text":"晨瞻北斗天何远，梦断南柯日未沉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28710,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其三","author":"刘师道","text":"有路期奔月，无媒与嫁春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28711,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"子规","author":"刘延世","text":"一声迸裂青山竹，半夜沾残病客衣。\n还道离于天上去，不知何苦只思归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28712,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自题墨竹","author":"刘延世","text":"酷爱此君心，常将墨点真。\n毫端虽在手，难写淡精神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28713,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和孙公索酒","author":"刘延世","text":"紫貂寒拥鼻，绿蚁细侵唇。\n莲烛当时事，壶头此日春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28714,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"种竹","author":"刘延世","text":"梅蒸方过有馀润，竹醉由来自古云。\n掘地聊栽数竿竹，开帘还当一溪云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28715,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"翡翠","author":"刘延世","text":"避人忽起鸣衣桁，掠水飞来立钓矶。\n静处欲留看不足，翠光点破夕阳归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28716,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水帘","author":"刘延世","text":"冷筛千嶂雨，寒□一钩□。\n不放香烟出，长教隔画檐。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28717,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"刘延世","text":"静室焚香盘膝坐，长廊看画散衣行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28718,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游灵岩","author":"刘异","text":"药水标题不记年，奇花深洞旧通仙。\n山回巨荫常遮日，境绝纤埃别是天。\n碧照东西江浩渺，绿迷高下竹婵娟。\n凭栏周览翛然静，金像香残一炷烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28719,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送杨长卿任赣州知事","author":"刘有庆","text":"望郡推章贡，斯游趣不希。\n风清王俭幕，春满老莱衣。\n鲫沼迎秋月，螺亭览夕晖。\n政成如有句，肯寄北鸿飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28720,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"钟山","author":"刘有庆","text":"蟠龙垂顾饮江湄，卧护宗祧彼一时。\n马渡已嗟南国蹙，猿惊何暇北山移。\n郊坛曾祝千年运，塔庙空留异代悲。\n北望中原形势尽，太平草木亦熙熙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28721,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"效长吉体","author":"刘有庆","text":"穷庐夜雪没驼脊，黄沙号风冰结石。\n燕姬二八髻垂漆，柔荑斜抱箜篌立。\n老羌踏歌歌敕勒，黄金流星酒杯窄。\n红氍毹暖春云湿。\n缕金团衣猩血滴，玉钗醉滑茝弦急。\n角声满空霜裂骨，十万狞君掩襟泣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28722,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"敷浅原见桃花","author":"刘次庄","text":"桃花雨过碎红飞，半逐溪流半染泥。\n何处飞来双燕子，一时衔在画梁西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28723,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"凤凰台","author":"刘次春","text":"高台寥寞晚云深，故国山河万里心。\n若使当年真凤见，不教春燕亦巢林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28724,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与客九日游龙山以尘世难逢开口笑分韵得口字","author":"刘汝进","text":"纵步龙山颠，放舟龙荡口。\n群然雁鹜行，杂之牛马走。\n我拙不能诗，我病不能酒。\n试问赏花人，还有菊花否。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28725,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日田园杂兴","author":"刘汝钧","text":"年来梦断百花场，安分农桑万虑降。\n为喜麦青行暖径，因看蚕出倚晴窗。\n草坪閒见乌犍点，畬水飞来白鹭双。\n满饮茅柴拚烂醉，踏歌社下自成腔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28726,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"龙渊","author":"刘达","text":"岩岩白石嵌，深泉适此止。\n夜雨半山回，春风蛰龙起。\n清明无遁形，溥博有馀美。\n受浊不伤清，纳污非所耻。\n趣操比幽人，泓澄如得己。\n山林乃挺途，真复谁洗耳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28727,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冰泉洞","author":"刘达","text":"飞泉落巍巍，湍水去激激。\n未若洞中源，静渊如得适。\n清润挹千岩，冷凝涵四壁。\n幽讨会有时，烦襟聊与涤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28728,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绣岭亭","author":"刘达","text":"绝境隔嚣纷，烟霞张綵绘。\n远目入无中，高情驰物外。\n春田发英华，秋林横紫翠。\n何时杖屦游，利名聊委蜕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28729,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"惠山泉","author":"刘达","text":"灵脉发山根，涓涓才一滴。\n宝剑护深源，苍珉环甃壁。\n鉴影须眉分，当暑挹寒冽。\n一酌举瓢空，过齿如激雪。\n不异醴泉甘，宛同神瀵洁。\n快饮可洗胸，所惜姑濯热。\n品第冠寰中，名色固已揭。\n世无陆子知，淄渑谁与别。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28730,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三登径山而雨或曰龙王相迎予笑而戏以诗","author":"刘过","text":"细雨霏霏洒路尘，龙神有意迓佳宾。\n世间小节成姑息，尽念熬焦烈骨人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28731,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上吴居父 其一","author":"刘过","text":"时平无事清吟好，卫霍贪功未足奇。\n争似一篇人脍炙，四方传诵卧龙诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28732,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上吴居父 其二","author":"刘过","text":"庙堂陶铸人才尽，流落江淮老病身。\n尚踏槐花随举子，不知邓禹是何人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28733,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上益公十绝为寿 其六 丹桂","author":"刘过","text":"少壮东堂奏捷功，浮香仙籍继家风。\n年年占得中元景，一颗冰轮照九穹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28734,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上益公十绝为寿 其四 玄鹤","author":"刘过","text":"缑山橘井与青田，驱策风云友列仙。\n名号横空心万里，九皋声动九重天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28735,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上益公十绝为寿 其二 玉兔","author":"刘过","text":"雪淡星疏月有光，广寒仙府岁偏长。\n多应自制延年药，振古长同桂子香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28736,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上益公十绝为寿 其五 寿鹿","author":"刘过","text":"年永曾闻葛稚川，玉京何处锦纹鲜。\n赏花应制嘉宾宴，小雅当为第一篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28737,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上益公十绝为寿 其十 苍官","author":"刘过","text":"东封已受大夫封，又入丁公吉梦中。\n祗道济时作舟楫，茯神尤有济人功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28738,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上益公十绝为寿 其九 佳菊","author":"刘过","text":"寿客尤宜在寿乡，钿花的皪傲新霜。\n更歌华寿今归去，尚有渊明野趣香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28739,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上益公十绝为寿 其三 宝龟","author":"刘过","text":"纳锡曾看上九江，又闻詹事奉储皇。\n巢成荷上窥仙景，左顾溪中赐印章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28740,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山末","author":"刘过","text":"山末疏红尾尾霞，晚烟丛薄是人家。\n移船更喜吹香好，枸橘花开媚浅沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28741,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"弋阳渡头","author":"刘过","text":"车声尽日滑黄泥，怕听空桑叫竹鸡。\n风雨不知春早晚，柳条拖绿半江低。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28742,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书越州能仁寺壁","author":"刘过","text":"流年转眼一飞梭，如此头颅奈老何。\n狼籍落花春不老，竹鸡啼处雨声多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28743,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书僧舍壁 其二","author":"刘过","text":"雪汁融融溪棹回，此山林竹亦佳哉。\n看残未了槐岩在，笋蕨肥时又一来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28744,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书僧舍壁 其一","author":"刘过","text":"绿杨染水浓如画，天气欲晴风自和。\n二月杏花犹未放，一春分外觉寒多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28745,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闻莺","author":"刘过","text":"东风扶日上花枝，恰恰幽禽弄暖时。\n百啭忽惊春梦破，间关石上话相思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28746,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"代吴守与赵侯为寿 其五","author":"刘过","text":"夜上南楼望玉京，将星光底寿星明。\n不须便即骑黄鹤，且为皇家致太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28747,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"代吴守与赵侯为寿 其二","author":"刘过","text":"气运由来有盛衰，循环久已见天机。\n黄山云散无尘滓，上将腾光入紫微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28748,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"代吴守与赵侯为寿 其三","author":"刘过","text":"虎头燕颔足奇谋，玉帐兵形象水流。\n此去关河应不远，上方拟筑望英楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28749,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"代吴守与赵侯为寿 其四","author":"刘过","text":"文伟当年记鄂城，崎岖蜀道播英声。\n何如衣锦枌榆社，卧护元戎十万兵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28750,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"代吴守与赵侯为寿 其一","author":"刘过","text":"地蟠江汉节岿然，劲气扶舆几倍年。\n白玉丹砂浩无数，夜光随处见山川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28751,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"代欧阳丞上韩平章 其二","author":"刘过","text":"玉立堂堂社稷臣，人言忠献是前身。\n三生昼锦堂前梦，莫忘当年作记人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28752,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"代欧阳丞上韩平章 其一","author":"刘过","text":"当年欧富与韩范，戮力同心佐汉庭。\n今日故家浑似旧，醉翁之后独雕零。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28753,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自宣溪过早禾渡 其一","author":"刘过","text":"雨后斜阳未见晴，晓看红日报窗明。\n笋舆十里宣溪路，刬地浓云脚里行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28754,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自宣溪过早禾渡 其二","author":"刘过","text":"梅欲搀春菊送秋，早来渡口晚烟收。\n风从滩上催船过，滚起寒沙一并流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28755,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过无锡见李元德祭酒 其二","author":"刘过","text":"高门扫日鸣珂里，吹竹弹丝煖响中。\n寂寞一区如此宅，世间却有两扬雄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28756,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过无锡见李元德祭酒 其三","author":"刘过","text":"新变文章学未成，青云无路致吾身。\n应逢垫角诸生笑，欲效林宗却整巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28757,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过无锡见李元德祭酒 其一","author":"刘过","text":"恋树栖禽暖不飞，不如弓缴有危机。\n季鹰若悟莼鲈好，应悔江东不蚤归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28758,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初入平氏书院","author":"刘过","text":"雪屋弹琴泛作声，寂无人语纸窗明。\n倦游识破诸缘妄，心与梅花一处清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28759,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"听阮","author":"刘过","text":"绛蜡攒花夜气横，樽前更著许风情。\n却将江上风涛手，来听纱窗侧阮声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28760,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"呈王山父 其二","author":"刘过","text":"办得茅庐我便归，玉堂何处有梅枝。\n岁寒老树虽荒寂，会有腊残春到时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28761,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"呈王山父 其一","author":"刘过","text":"疏烟淡淡树重重，略得西南有路通。\n钟板不鸣山寺静，闭门人在月明中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28762,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"呈辛稼轩 其二","author":"刘过","text":"闭门翘足观山睡，松桧郁然云气高。\n说梦向人应不信，碧油幢下有旌旄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28763,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"呈辛稼轩 其一","author":"刘过","text":"精神此老健于虎，红颊白须双眼青。\n未可瓢泉便归去，要将九鼎重朝廷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28764,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"呈辛稼轩 其五","author":"刘过","text":"书生不愿黄金印，十万提兵去战场。\n只欲稼轩一题品，春风侯骨死犹香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28765,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"呈辛稼轩 其三","author":"刘过","text":"书来赐以兰溪酒，下视潘葑奴仆之。\n吾老尚能三百盏，一杯水不值吾诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28766,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"呈徐侍郎兼寄辛幼安 其一","author":"刘过","text":"当年今日误承恩，自倚容华托至尊。\n门外游丝难驻目，依然青草暗长门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28767,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"呈徐侍郎兼寄辛幼安 其二","author":"刘过","text":"猿臂将军战不休，当时部曲已封侯。\n夜深忽梦燕山月，犹幸君王晚更收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28768,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"投诚斋 其二","author":"刘过","text":"蓬莱东观是亨衢，经国文章要钜儒。\n顿著五花犹不判，却于注易下工夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28769,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"投诚斋 其四","author":"刘过","text":"智愚上下尔自异，尺寸不差公短长。\n毕竟昌黎仍旧好，何曾人说段文昌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28770,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"投诚斋 其三","author":"刘过","text":"画戟门边春昼长，鼎新模范宿淮阳。\n吏人傒眼报公事，一瓣浓薰班马香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28771,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"投诚斋 其六","author":"刘过","text":"夫子声名号浙西，作成文士欲何为。\n达人胸次元无翳，芥子须弥我独知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28772,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"投诚斋 其五","author":"刘过","text":"绫衾厌入承明直，却把一麾江上来。\n云气隔天迷望眼，不堪花落几宫槐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28773,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"投诚斋 其七","author":"刘过","text":"初政寰区望太平，黎民乐业喜更生。\n裴公用舍无轻重，天下从兹有重轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28774,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"村店 其一","author":"刘过","text":"林深路转午鸡啼，知有人家住隔溪。\n一鸟闹红春欲动，酒帘正在杏花西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28775,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]