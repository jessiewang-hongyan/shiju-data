[{"title":"和郡斋即事","author":"吕陶","text":"表里山河久镇绥，府无留事纵怀时。\n自将远业更中外，不向荣涂计速迟。\n冲谈本从天理得，安閒常有道心知。\n元元未尽跻仁寿，日望登庸为审思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43473,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"郡斋春暮","author":"吕陶","text":"自觉劳生万事非，宦心从此更迟迟。\n凄凉好饮悲春酒，閒暇犹吟送老诗。\n轩冕去来皆外物，云山早晚是归期。\n怀民报国终无术，空负惭颜对一麾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43474,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵张怀安题云顶浴室院","author":"吕陶","text":"山门渐近少凡尘，佛子长栖物外身。\n款户多因游寺客，倚栏时有羡鱼人。\n祥云结盖应非雾，法雨飘花别是春。\n数刻盘桓觉萧散，回头官事又劳神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43475,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵张怀安喜雨诗","author":"吕陶","text":"云密西郊末作霖，暂凭精祷快群心。\n望如至宝难搜索，来似嘉宾忽访临。\n古庙有灵惟响答，洪钧于物已恩深。\n春膏直待沾濡足，不使狂风取次侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43476,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过金堂偶记旧诗因赠宇文县宰","author":"吕陶","text":"尝闻县古槐根出，最爱官清马骨高。\n前辈有诗谈事实，今辰此景入风骚。\n飞云几处笼山顶，密雨连宵发土膏。\n公事稀疏吏归去，不妨欢侍对春醪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43477,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和野轩答李著作见寄","author":"吕陶","text":"公居何事葺幽轩，客味萧条称养閒。\n人笑规模犹物外，我怜风景胜花间。\n秾林斗影舒帷幕，浅溜馀声杂佩环。\n欲把郡图传向此，座中常得见岷山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43478,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登揽秀亭","author":"吕陶","text":"亭在西山积翠中，烟岚气象一重重。\n芟开檐际偏高竹，见得云间最后峰。\n野色为谁长郁茂，物情于我似从容。\n年来已有林泉兴，倚著阑干兴转浓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43479,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次辅元韵","author":"吕陶","text":"山岚秾秀望中青，路转松阴步步迎。\n十里晴郊供野意，万家和气发欢声。\n春台不觉残春景，乐国偏知众乐情。\n公向蜀人深有意，更怜风物暂閒行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43480,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"钟阳道中和酬辅元","author":"吕陶","text":"忽捧琼瑰俗眼惊，荷君深照旧交情。\n归心自喜双亲寿，拙计难酬厚禄荣。\n十舍路岐平野阔，几重村落霁烟生。\n羁游每忆家山乐，况是花时到锦城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43481,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送任遵圣之官富顺二首 其一","author":"吕陶","text":"千丈苍松出故林，乔枝成就古根深。\n栋梁须负平生用，霜雪难移此日心。\n月白曾经丹凤宿，风悲定有老龙吟。\n重岩复涧何缘幸，一旦家家得茂阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43482,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送任遵圣之官富顺二首 其二","author":"吕陶","text":"野鹤孤高旧羽仪，超然殊不事卑飞。\n有心云路翱翔去，回首芝田迤逦归。\n白日漫教罗网密，红尘堪笑稻梁肥。\n仙家自有千年约，应许先生学令威。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43483,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"竹枕","author":"吕陶","text":"不誇雕琢略磨砻，溪叟持来赠野翁。\n冰雪易侵毛发际，尘埃难到梦魂中。\n消除暑愠宜无价，安养慵閒似有功。\n富贵人家应笑我，水晶新样极玲珑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43484,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵家渠州承议春阴","author":"吕陶","text":"春工用意本华鲜，气候阴沉未逞妍。\n风色送寒无甚雨，云容垂远又非烟。\n迁延莺舌应嫌巧，抑遏花心恐占先。\n稍待新晴纤翳廓，秾芳齐媚艳阳天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43485,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"官舍东偏海棠开最晚落亦后时以诗嘲之","author":"吕陶","text":"花到春深半已过，此花犹见满枝柯。\n传来芳信虽为晚，占得韶光却是多。\n爱惜锦文愁雨急，留连妆脸笑风和。\n后先荣谢人休问，且伴樽前一醉歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43486,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送秦漕归淮南","author":"吕陶","text":"袭得芝兰一室薰，更将三美向谁论。\n光辉自可誇僚友，契爱犹能及子孙。\n金节暂求康尔俗，锦衣归去大吾门。\n西南终是天涯远，却羡鸾凰集九阍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43487,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄新宁黎叔茜","author":"吕陶","text":"平日论交重久要，每怀高谊寸心摇。\n君恩最是忧民社，吏隐偏宜远市朝。\n谆诲伫闻流尺素，嘉篇频为寄琼瑶。\n笑言契阔劳生甚，别后堪嗟壮气消。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43488,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄周才叔","author":"吕陶","text":"天涯羁宦落蓬蒿，漫说平时器业高。\n寒暖所逢皆物理，悲欢相较只秋毫。\n徒嗟壮士难行己，懒学风人便著骚。\n乐道养閒俱可羡，念君清谊甚魂劳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43489,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和周简州寄范蜀公三章 其一","author":"吕陶","text":"禁林元老忽西归，众谓西州此事奇。\n矰缴漫劳鸿去后，桑田未变鹤来时。\n一乡金帛皆沾惠，千载松楸得奉祠。\n预想年前至京国，子孙持酒献春祺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43490,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和周简州寄范蜀公三章 其二","author":"吕陶","text":"春深归到锦江头，笑傲光阴已晚秋。\n内相贵名虽烜赫，山翁行李甚优游。\n诗中气格超摩诘，方外情怀类子休。\n南下有期风月爽，乡人从此望仙舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43491,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和周简州寄范蜀公三章 其三","author":"吕陶","text":"法从深严宠禄荣，清标素节两难并。\n有心报国虽谋国，无意求名又得名。\n道服岂烦垂宝带，安居何用饰华缨。\n秋风一夜乔林减，惟见松篁不变更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43492,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"昨日","author":"吕陶","text":"昨日文书插羽毛，征夫连日整弓刀。\n云如野色随时惨，风作边声特地号。\n八阵威灵今可托，六州形势古称高。\n西南久不闻金鼓，莫遣人人著战袍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43493,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又赋二首 其一","author":"吕陶","text":"千里征蛮向不毛，坐筹先胜自三刀。\n井中蛙力狂虽跃，弓下猿声怯便号。\n草白见城羌蝶浅，月明闻角汉天高。\n将军几日当雄捷，速把功书上赭袍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43494,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又赋二首 其二","author":"吕陶","text":"忠胆轻生甚一毛，奇谋破贼锐于刀。\n横行容易平乌合，面缚须臾作犬号。\n霜甲共辉军帐冷，烟烽齐出戍楼高。\n羌酋若也投降早，定得君王瑞锦袍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43495,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪","author":"吕陶","text":"白金铺野玉堆檐，独上危亭喜再瞻。\n多积岂能填涧底，已高犹未累山尖。\n碎声著物飘来急，寒色侵人霁后添。\n时节霏霏未还役，贼平消息愿重占。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43496,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"岷峨王高士赍牟中秘墨帖来求跋自言能护真气鍊大丹罹兵祸而辍同辈有志于斯事者皆然又言老人村凡二三百岁者亦皆死于兵嗟夫兵之祸生灵甚矣祸蜀则尤惨祸及高士更不轻矣遂为之赋诗","author":"吕陶","text":"道人少日鍊神形，兵祸俄乘竟不成。\n欠为黄庭判一死，所酬丹事又三生。\n眼看残尽鸡窠老，胆破宁寒犬舐盟。\n豹养虎攻嗟尔似，却求翰墨作虚名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43497,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"石泉道中和绵州通判李朝散见寄","author":"吕陶","text":"深僻崎危不厌过，欲将涓滴助恩波。\n蹑云高步三休在，踏雪清寒一倍多。\n依约度溪投野店，逡巡扶杖历新坡。\n初春此去才旬日，屈指流年奈老何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43498,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"有触","author":"吕陶","text":"三十馀年齿士林，青纶一命鬓霜侵。\n策名虽动迟留叹，行已常存少壮心。\n月满涨潭清远梦，春归平野付长吟。\n前溪况亦称南浦，惜别情悰几倍深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43499,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"城西龙祠二首 其一","author":"吕陶","text":"市桥官柳翠阴垂，路向西郊驻彩旂。\n故事每从遐俗尚，清欢又送晚春归。\n留连野色迟迟去，珍惜年华苒苒飞。\n老杜有诗殊有味，风光流转莫相违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43500,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"城西龙祠二首 其二","author":"吕陶","text":"林密溪寒锦浦西，千年灵宇旧凭依。\n竹村迎路堪行乐，麦垄连云已应祈。\n诗将早从吟社去，游人暮到醉乡归。\n隼旟莫倦徘徊久，化日舒长未夕辉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43501,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和赏申氏园海棠","author":"吕陶","text":"谁裁锦段碎文章，凭借春工便吐芳。\n自是多花宜少叶，肯教仙格有凡香。\n妆容试酒偏增丽，舞兴迎春拟作狂。\n使幕县庭虽甲乙，更饶邻圃借馀光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43502,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和姚提举赏海棠","author":"吕陶","text":"晓雾笼花暖渐收，万枝难尽数花头。\n胭脂半为伤春淡，锦带翻因拂地羞。\n围饮旧风传乐国，纵吟清味属诗流。\n西园韶景真无价，红满池台月满楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43503,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和蜀守道中书事","author":"吕陶","text":"天恩流布下天津，沴气消除生气淳。\n昔虑早饥农失职，今逢赈惠泽如春。\n绥怀有术推儒者，全活为功类古人。\n贤杰一心沟壑起，翕然歌颂在生民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43504,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题友人西行杂诗","author":"吕陶","text":"一官一集古称贤，未似西征五十篇。\n雅颂纯音流管磬，风骚馀味到林泉。\n光生晓岫刊岷石，价踊春溪费锦笺。\n愧幸师门旧林教，得为家宝子孙传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43505,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读黜邪诏","author":"吕陶","text":"天诏丁宁逐佞柔，不须请剑复持矛。\n平生邪胆君前落，后世污名纸上留。\n宝鉴乍开消魍魅，正声才作罢离兜。\n便为菹醢何嗟及，贪得浮荣似食钩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43506,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晚倚南楼","author":"吕陶","text":"野情无限物无穷，一凭危楼又晚空。\n过雨郊原浑积翠，送春亭榭尚馀红。\n烟光已属绡图上，湖影初归宝鉴中。\n飞鸟潜鱼应自得，倚栏小憩豁双瞳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43507,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送张颖达屯田","author":"吕陶","text":"西风猎猎马骎骎，极目归途寄静吟。\n美玉自藏圭璧用，寒松偏有雪霜心。\n皆知旧德淹郎署，合宠耆儒镇士林。\n势利竞驰孤介少，为怀清谊动离襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43508,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和寄治之少卿","author":"吕陶","text":"荣路层层满眼开，家山在望懒徘徊。\n霜侵客鬓须归去，尘拂朝冠是傥来。\n一棹绿波游不厌，三竿红日梦初回。\n更闻觞咏同幽趣，应少閒人可预陪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43509,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送张静之少卿东归","author":"吕陶","text":"礼寺居卿宠搢绅，若求清议尚沈沦。\n三千里外甘投足，四十年前已化鳞。\n何必万钟如己欲，好将一笑寓天真。\n当时共献藏珠赋，寿考康宁有几人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43510,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"象棋二首 其一","author":"吕陶","text":"咫尺楸枰计虑深，偶缘嬉戏便交侵。\n纵横各有往来道，胜负岂无名利心。\n终局漫誇兵得地，在宫浑倚士如林。\n安危成败何殊此，付与閒人为讨寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43511,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"象棋二首 其二","author":"吕陶","text":"星布重重阵脚深，不须轻敌事相侵。\n渡河虽藉奇兵势，对垒难知老将心。\n酬酢巨杯宜燕席，消磨永日称山林。\n呼卢格五前贤有，莫笑年来共讲寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43512,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送杨圣愈口中赴益倅","author":"吕陶","text":"画辕曾记到西州，莫为题舆厌滞留。\n官况优如支郡乐，风光浑似昔年游。\n日无馀事知閒暇，时有清吟竞唱酬。\n政绩易成恩典在，天涯不觉两经秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43513,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寓意","author":"吕陶","text":"夕阳芳草自天涯，倦客何须感物华。\n无计可能逃世网，有心刚欲慕诗家。\n将烹谁惜能鸣雁，安足翻成强画蛇。\n白发渐多瞳渐翳，少年相见莫揄揶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43514,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋郊","author":"吕陶","text":"西风萧瑟动年华，村望犹将景物誇。\n山色半随云势断，浮光多被竹阴遮。\n社前归兴双飞燕，雨后新声几处蛙。\n万里桥南亦如此，十分有意作农家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43515,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄唐君益","author":"吕陶","text":"秋日晴如春日迟，山间水际尽光辉。\n江湖顿减骚人咏，父老争誇太守归。\n岁晚莫惊松易叶，时来又见锦为衣。\n门前行马虽崇峻，应许衰翁一叩扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43516,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"广安鹿呜燕送诸进士","author":"吕陶","text":"文章得隽自雄飞，平地青云有路岐。\n劝驾寂寥惭汉诏，升歌彷佛见周诗。\n九秋烟雨登临日，三月风雷变化时。\n回首不须题竞渡，锦标争胜已先知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43517,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵李才元舍人二首 其一","author":"吕陶","text":"求閒得请信贤哉，曾历星垣侍从来。\n标节向人清似玉，纷华于己冷如灰。\n仙坛露重吟怀爽，禅榻风轻睡眼开。\n昨日寻梅奉谈笑，竹轩松坞共徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43518,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵李才元舍人二首 其二","author":"吕陶","text":"当年累疏彻尧廷，不为虚名自得名。\n霜雪盛来松秀茂，风波散后水澄清。\n红尘渐与高情隔，绿发应随喜气生。\n否泰卷舒公自悟，不须端筴问君平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43519,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"致政侍郎知郡学士赓和诗凡数篇谨用元韵寄呈知郡学士","author":"吕陶","text":"玉色诸儿馥若兰，綵衣想见日承颜。\n尘缨远濯沧浪水，燕几深居畏垒山。\n俗眼漫讥身察察，人情方喜志閒閒。\n夕阳归兴随飞鸟，真意无人语此还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43520,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游交城石壁寺二首 其一","author":"吕陶","text":"十里萦纡路转山，山城深入翠微间。\n何年胜地云霞老，终日清风岁月閒。\n池上蛰龙方隐伏，岩前游客暂跻攀。\n却嗟鸾绰遗居在，难向空阶一叩关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43521,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游交城石壁寺二首 其二","author":"吕陶","text":"山僧何事下山迎，步彻山腰到寺庭。\n清梵一声沈夕籁，碧岚千幅展春屏。\n自惭缰锁非真赏，乍见林泉似独醒。\n回首暮钟留恨处，断烟层霭倍青青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43522,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题信相院林亭","author":"吕陶","text":"深静禅门秋复春，不知门外是红尘。\n满庭修竹有君子，终日好风如故人。\n曲径最宜巢翠羽，澄潭犹足养纤鳞。\n年年寓泊知閒味，每谢林泉作四邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43523,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"按视麋枣堰次韵","author":"吕陶","text":"郊原气象欲迎春，祠下乔林秀色匀。\n数里旧防能禦患，二江流水不迷津。\n舆言此日蒙深利，惠政当时念远人。\n公意勤勤议增筑，又逢贤杰继芳尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43524,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"麋枣道中","author":"吕陶","text":"藩政雍容虑在民，暂行千骑按江津。\n寒侵客袂逢轻雨，翠拂林梢觉浅春。\n极望风光迷绿野，纵吟怀抱脱红尘。\n愿公改作刘公堰，留得嘉名谕蜀人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43525,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"松","author":"吕陶","text":"游人何事种芳菲，试把庭松较盛衰。\n得地不将天质改，有心惟与岁寒期。\n一轩野色栽培后，十月霜华秀茂时。\n造化果能周及物，亦须千丈引乔枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43526,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"遣兴","author":"吕陶","text":"每嗟无计远红尘，愿读仙书学养真。\n收得寸心清似水，放教双鬓白于银。\n功名见误回头晚，风物相惊满眼新。\n一卷黄庭有深趣，诵持聊以爱吾身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43527,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和李宝文紫庭玉节花","author":"吕陶","text":"云枝玉蕊两难加，应是殊庭种此花。\n地产有时呈秀异，仙标无意竞繁华。\n已持宝瑞传君命，更拥香幢送道家。\n若预景文方物志，定先群卉赞祥葩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43528,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送李宝文还朝","author":"吕陶","text":"使华西指主恩深，又见鳌头此镇临。\n十载星霜皆化日，百城桃李尽秾阴。\n层霄自得翱翔路，止水难摇淡静心。\n全蜀苍黔共倾耳，即闻和气入薰琴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43529,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"古松馆","author":"吕陶","text":"大字新题重古松，标题不与众人同。\n何年直干藏山驿，半夜寒声满道宫。\n并秀雅宜云壑外，相逢最爱雪霜中。\n秋深纵使乔林减，未许坚姿坠晚风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43530,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和郤仲辅开化寺三首 其一","author":"吕陶","text":"寺在西山第几重，山僧相遇喜相容。\n寂无尘虑到禅室，瞥有秋声来野松。\n已恨夕阳催返辔，又过危磴听残钟。\n烟霞更约他时望，未必高怀负翠峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43531,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和郤仲辅开化寺三首 其二","author":"吕陶","text":"目前尘坌最重重，乍见名山喜动容。\n选胜道装堪著屐，谈禅麈柄亦挥松。\n千寻急欲攀秋径，十里犹闻击午钟。\n下得峦林又牵俗，特书归恨寄晴峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43532,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和郤仲辅开化寺三首 其三","author":"吕陶","text":"烟岚深处几千重，难向丹青写物容。\n层阁试凭窥百里，函经慵读倚双松。\n乔林乍响因秋籁，栖鸟频惊为晚钟。\n莫笑下山犹怅望，浪仙平昔爱三峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43533,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送钱端履归二曲","author":"吕陶","text":"君去金渊十五春，暂归翻是客中身。\n千年丘垄胜当日，两世亲朋无几人。\n麈尾幸能销白昼，马蹄还厌踏红尘。\n锦衣会有重来约，应笑衰翁漉酒巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43534,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晚饮","author":"吕陶","text":"霁景宜将远眼看，绿阴垂地已春阑。\n山巅日出方乘暖，峡口风来又作寒。\n老去心情非往事，閒中谈笑有馀欢。\n玉盘四照江如练，忍对澄辉不倚阑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43535,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]