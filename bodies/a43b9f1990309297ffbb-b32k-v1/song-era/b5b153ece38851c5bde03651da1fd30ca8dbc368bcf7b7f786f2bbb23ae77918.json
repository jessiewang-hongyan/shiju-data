[{"title":"与谦知藏二首 其二","author":"释德洪","text":"诸方法席慵抬眼，懒墯成群妒忌深。\n此老把茅如覆顶，却能努力捍丛林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62463,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"木上人久游归宗赠之二首 其一","author":"释德洪","text":"熏烝闻见有源流，诗学寒溪老比丘。\n勿讶谈禅太文彩，从来虎穴不生彪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62464,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"木上人久游归宗赠之二首 其二","author":"释德洪","text":"携诗过我亦翛然，百孔寒光坏衲穿。\n日与庐山对酬酢，故应妙语嚼芳鲜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62465,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游跫然亭","author":"释德洪","text":"道火何曾烧著口，问透法身藏北斗。\n当时我若见云门，一杖打杀乞与狗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62466,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"临济大师生辰","author":"释德洪","text":"靖康二年四月十，眼见耳闻信不及。\n三玄三要都揭开，露出法身赤吉力。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62467,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"潇湘八景 其一 山市晴岚","author":"释德洪","text":"朝霞散绮仗天容，无际山岚分外浓。\n风土萧条人迹静，林蹊花木自鲜秾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62468,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"潇湘八景 其二 洞庭秋色","author":"释德洪","text":"秋霁湖平彻底清，沧浪隐映曜光轮。\n寒光炯炯为谁好，倚岸凭栏兴最清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62469,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"潇湘八景 其三 江天暮雪","author":"释德洪","text":"长空暝色黯阴云，六出飘花堕水滨。\n万境沈沈天籁息，溪翁忍冻独垂纶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62470,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"潇湘八景 其四 潇湘夜雨","author":"释德洪","text":"岳麓甍檐苍莽中，萧萧江雨打船篷。\n一声长笛人何去，箬笠蓑衣宿苇丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62471,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"潇湘八景 其五 渔村落照","author":"释德洪","text":"目断青帘在水湄，临风漠漠映斜晖。\n渔郎笑傲芦花里，乘兴回家何处归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62472,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"潇湘八景 其六 远浦归帆","author":"释德洪","text":"水国烟光映夕晖，谁家髣髴片帆归。\n翩翩鸥鹭西风急，凝盻沧洲眼力微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62473,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"潇湘八景 其七 烟寺晚钟","author":"释德洪","text":"轻烟罩暮上黄昏，殷殷疏钟度远村。\n略彴横溪人迹静，幡竿缥缈插山根。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62474,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"潇湘八景 其八 平沙落雁","author":"释德洪","text":"寂寞蒹葭乱晚风，江波潋滟浸秋空。\n横斜倦翼归何处，一点渔灯杳霭中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62475,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春词五首 其一","author":"释德洪","text":"映门杨柳未全遮，才有柔条自在斜。\n不信春寒犹有雪，误惊飘舞作飞花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62476,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春词五首 其二","author":"释德洪","text":"春到梅梢雪未知，横斜初见过墙枝。\n暗香愁绝无人问，一再风前月上时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62477,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春词五首 其三","author":"释德洪","text":"昨夜江村雨一犁，白沙江路晓无泥。\n戏波拍拍凫雏暖，掠岸翩翩燕子低。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62478,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春词五首 其四","author":"释德洪","text":"晓霁晴湖已拍桥，桥边春色解相撩。\n分疏积雨饶莺舌，拘束东风倩柳条。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62479,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春词五首 其五","author":"释德洪","text":"郊原雨歇看春耕，茧栗能驼稚子行。\n青杏欲尝先齿软，海棠开遍恰新晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62480,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日作","author":"释德洪","text":"山前山后花半红，桥头桥尾柳摇空。\n流莺枝上未成语，始啭一声来去风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62481,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"残梅","author":"释德洪","text":"残香和雪隔帘栊，只待江头一笛风。\n今夜回廊无限意，小庭疏影月朦朦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62482,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵通明叟晚春二十七首 其一","author":"释德洪","text":"琴筑春流涨浅滩，圆吭幽鸟语林端。\n纤蒲水荇空凄寂，背立东风整钓竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62483,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵通明叟晚春二十七首 其二","author":"释德洪","text":"绿遍西园春正残，青梅小摘嗅仍看。\n单衣初试殊清爽，更爱凉风掠面寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62484,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵通明叟晚春二十七首 其三","author":"释德洪","text":"落花片片怨春阴，雾雨那堪更作霖。\n小院晚春犹惜扫，欲穿准拟倩金针。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62485,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵通明叟晚春二十七首 其四","author":"释德洪","text":"散衣行处雨初凉，庭院谁家柳暗墙。\n倚杖南轩看修竹，快人解箨玉苍苍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62486,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵通明叟晚春二十七首 其五","author":"释德洪","text":"居近幽林复碧江，水光林翠到西窗。\n鹧鸪啼竹声相应，鸂鶒眠沙只一双。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62487,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵通明叟晚春二十七首 其六","author":"释德洪","text":"落英寂寂草离离，天气清和得所宜。\n头面惺愡快清晓，可人惟有海棠枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62488,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵通明叟晚春二十七首 其七","author":"释德洪","text":"枝上啼禽毛羽光，商量密叶恰能藏。\n路旁垂柳阴堪歇，墙外樱桃小可尝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62489,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵通明叟晚春二十七首 其八","author":"释德洪","text":"题诗径欲挽春还，噪吻吟窗秃笔端。\n寂寞却怜当槛竹，嫩黄新袅出林竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62490,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵通明叟晚春二十七首 其九","author":"释德洪","text":"昼永呼童挂北轩，青山无数卧披看。\n独怜杜宇啼声晚，催发芭蕉战莫寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62491,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵通明叟晚春二十七首 其十","author":"释德洪","text":"桃李无言暗浅深，晓云惭愧不成霖。\n化工胜却耶溪女，绣遍园林不犯针。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62492,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵通明叟晚春二十七首 其十一","author":"释德洪","text":"去岁春游爱野棠，今年还复出东墙。\n行思往事心犹在，却照清溪鬓已苍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62493,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵通明叟晚春二十七首 其十二","author":"释德洪","text":"睡魔昼永不能降，一梦春晴赏北窗。\n只有敲门漫溪叟，也嫌疏懒世无双。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62494,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵通明叟晚春二十七首 其十三","author":"释德洪","text":"山桃喷火柳垂丝，野店溪桥处处宜。\n我作春游亦清散，榆钱聊挂瘦藤枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62495,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵通明叟晚春二十七首 其十四","author":"释德洪","text":"困人天气渴思浆，喜有人家密竹藏。\n稚子不知僧不饮，压糟醇酽劝人尝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62496,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵通明叟晚春二十七首 其十五","author":"释德洪","text":"春心百种竟衰残，幽事侵寻尚数端。\n清晚闲题记新竹，粉衣香滑一竿竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62497,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵通明叟晚春二十七首 其十六","author":"释德洪","text":"清晨花下露团团，飞鸟行吟仰面看。\n杰句天资人不及，勿嗔岛瘦与郊寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62498,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵通明叟晚春二十七首 其十七","author":"释德洪","text":"压枝万朵浓如绣，初歇连绵十日霖。\n穿蕊蝶须轻似线，刺香蜂尾快于针。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62499,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵通明叟晚春二十七首 其十八","author":"释德洪","text":"倦行放步卧垂杨，谁打鞦韆笑隔墙。\n风物恼人情不浅，归来山色更青苍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62500,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵通明叟晚春二十七首 其十九","author":"释德洪","text":"夜凉静话欣同榻，春晚分题喜共窗。\n解笑疏狂才莫敌，诗禅美誉旧传双。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62501,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵通明叟晚春二十七首 其二十","author":"释德洪","text":"红梅真是醉吴姬，浴罢偎风事事宜。\n吟次纷纷落红雨，小禽飞去动危枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62502,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵通明叟晚春二十七首 其二十一","author":"释德洪","text":"从游法侣意何长，况更深云僻处藏。\n共喜春山有新事，小窗晴试露芽尝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62503,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵通明叟晚春二十七首 其二十二","author":"释德洪","text":"南来还复见春残，历乱愁人恰万端。\n贾谊少年能肆笔，太公垂白始投竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62504,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵通明叟晚春二十七首 其二十三","author":"释德洪","text":"杨花满院掩深关，半摺文书偃卧看。\n幽鸟等闲回睡眼，暖风时复破春寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62505,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵通明叟晚春二十七首 其二十四","author":"释德洪","text":"春寒瘦骨病难禁，多谢新晴霁晚霖。\n自补衲衣矮窗下，黄鹂声好屡停针。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62506,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵通明叟晚春二十七首 其二十五","author":"释德洪","text":"剧笑自知跻奥室，好诗安敢望门墙。\n饶君丽句春难敌，输我朱颜鬓未苍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62507,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵通明叟晚春二十七首 其二十六","author":"释德洪","text":"深院无人得散衣，海棠经雨更相宜。\n若为化作翩翩蝶，绕此扶疏竹外枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62508,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵通明叟晚春二十七首 其二十七","author":"释德洪","text":"清绝新诗写硬黄，著签端为密收藏。\n自惊短拙知何限，爱子高才见未尝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62509,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"海棠","author":"释德洪","text":"酒入香腮笑未知，小妆初罢醉儿痴。\n一枝柳外墙头见，胜却千丛著雨时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62510,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和余庆长老春十首 其一","author":"释德洪","text":"野梅官柳不胜春，妒面愁眉各斗新。\n欲作清诗成瘦坐，生憎白雨解催人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62511,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和余庆长老春十首 其二","author":"释德洪","text":"叶欲藏禽花没腰，春愁叠叠觉难消。\n碧云新月谁梳鬓，翠浪柔风自织绡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62512,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和余庆长老春十首 其三","author":"释德洪","text":"凫鸥水暖聚圆沙，带雨春湖脉脉斜。\n翠线受风遮径柳，燕脂含雨隔篱花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62513,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和余庆长老春十首 其四","author":"释德洪","text":"叶云谁剪芘花身，花厎何人笑语频。\n应是流莺诉心事，窥墙欲见恨无因。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62514,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和余庆长老春十首 其五","author":"释德洪","text":"一盏露芽袪睡思，半帘疏雨作愁媒。\n似闻池馆花如海，杖策当为得得来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62515,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和余庆长老春十首 其六","author":"释德洪","text":"嫩寒清晓欲留春，睡足山中乐事新。\n珠玉等闲无胫至，风流全付茂陵人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62516,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和余庆长老春十首 其七","author":"释德洪","text":"柳如西子舞时腰，飞絮初狂雪未消。\n多谢余郎造化手，解拈春色写鲛绡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62517,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和余庆长老春十首 其八","author":"释德洪","text":"雨过清流走白沙，隔篱红杏一枝斜。\n可堪风日浓于酒，更爱君诗丽似花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62518,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和余庆长老春十首 其九","author":"释德洪","text":"旧游新事两关身，花下清晨吉?频。\n野步寻梅曾共乐，夜诗联鼎愿相因。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62519,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和余庆长老春十首 其十","author":"释德洪","text":"人笑才高真祸本，自惊诗好是穷媒。\n贪看百尺游丝转，忽见双飞乳燕来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62520,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游西湖北山二首 其一","author":"释德洪","text":"幽草青青绕竹扉，雨馀人在杏园西。\n无端黄鸟惊春梦，正向绿萝深处啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62521,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游西湖北山二首 其二","author":"释德洪","text":"春园南北笋过墙，墙下离离草更香。\n啼鸟野花无问处，苍山牢落下残阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62522,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵超然春日湘上二首 其一","author":"释德洪","text":"暮年身世极南边，病眼愁看北客船。\n忆著金明池上路，宝津晴瓦隔霏烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62523,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵超然春日湘上二首 其二","author":"释德洪","text":"年少无愁事业新，小诗写得楚江春。\n已知字字愈头痛，可是骎骎解逼人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62524,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春晚二首 其一","author":"释德洪","text":"方见柳条堪结纽，忽惊梅叶解藏禽。\n春归掣肘径不住，院落残红一寸深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62525,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春晚二首 其二","author":"释德洪","text":"闲愁一寸在垂杨，游丝百尺拖清晓。\n榆钱满地赎春归，山茶昨夜都开了。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62526,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"长春花","author":"释德洪","text":"人间花亦有仙骨，卯酉发妆呼不醒。\n醉里那知更岁月，韵高班草卧空庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62527,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上巳","author":"释德洪","text":"桃花落尽柳阴成，寒食风光小雨晴。\n半掩宝书凭几坐，满庭芳草为谁生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62528,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题黄山壁","author":"释德洪","text":"夜雨晓晴春盎盎，绿愁红醉思迢迢。\n独存滋味无人会，笑看柔风拂柳条。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62529,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初夏四首 其一","author":"释德洪","text":"嘒嘒新蝉绿叶遮，一声临晚到山家。\n未应春色全归去，犹有芳丛刺史花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62530,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初夏四首 其二","author":"释德洪","text":"野水稻苗青拂岸，柘冈麦穗熟分岐。\n前村父老胥欢甚，笑指桥边露酒旗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62531,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初夏四首 其三","author":"释德洪","text":"院落寥寥日正长，小梅初熟亚枝黄。\n午窗书引昏昏思，角簟宜开旧竹床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62532,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初夏四首 其四","author":"释德洪","text":"流莺声老绿杨中，栏槛萧疏堕晚红。\n二十四番花信重，园林又觉转熏风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62533,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南轩","author":"释德洪","text":"南轩日静小帘开，百舌无端唤梦回。\n莫为杨花不相识，随风还解过墙来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62534,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵方夏日五首时渠在禹溪余乃居福严 其一","author":"释德洪","text":"残书半摺立风檐，欲步还慵睡未忺。\n忽忆故人谈笑处，擘莲尝芡禦炎炎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62535,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵方夏日五首时渠在禹溪余乃居福严 其二","author":"释德洪","text":"声华籍甚浙东西，胸次玲珑绝坎蹊。\n那料南来遭白眼，强颜腰作偃松低。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62536,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵方夏日五首时渠在禹溪余乃居福严 其三","author":"释德洪","text":"山县萧条早放衙，莲塘无主自开花。\n三叉路口炊烟起，白瓦青旗一两家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62537,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵方夏日五首时渠在禹溪余乃居福严 其四","author":"释德洪","text":"水阁风微快葛衣，沙村返照淡馀晖。\n数声楚些无情思，不似吴中缓缓归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62538,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵方夏日五首时渠在禹溪余乃居福严 其五","author":"释德洪","text":"我忆西湖山水清，君诗说尽欲归情。\n何时京口同烟艇，柔橹咿哑短作程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62539,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]