[{"title":"宏父见招赏梅时范子芬欲行","author":"洪适","text":"翩翩画戟对春光，命客重登千仞冈。\n坐上行人倾别酒，花前小雨伴啼妆。\n雪肤不为轻寒瘦，玉骨何如昨夜香。\n丽句竞传新乐府，谁誇何逊在维扬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19226,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次日宏父携家出游而小雨新晴","author":"洪适","text":"山头霞彩发天光，初日曈昽射短冈。\n莫使吹箫寻古曲，直宜点额作新妆。\n不禁风雨飞来急，颇觉园林减却香。\n花下凌波奏奇舞，腰支尺六笑垂杨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19227,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"丁卯正月十六日作舞漪亭于池上尽废蔬畦植花数十本","author":"洪适","text":"二年倥偬缓归期，漫作新亭接舞漪。\n举郡定嗤推不去，故山已讶到何迟。\n园官不属藜苋腹，花史好呈桃李姿。\n待得浮萍是飞絮，谁能爱树一相思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19228,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"检校园花","author":"洪适","text":"往夏新阁成，拔去园中葵。\n万花间千蕊，十夫劳徙移。\n群香颇猗狔，密影初参差。\n烈日吁可畏，时雨不能滋。\n未秋叶先陨，欲冬柯已萎。\n虚蒙灌溉恩，无复嫣然姿。\n啅雀飞且止，不肯登空枝。\n寒螀守枯荄，未忍相弃离。\n永怀斩新日，岂料憔悴期。\n谁呼殷七七，来伴红裳儿。\n金鼎一剂药，返魂庸可追。\n春来作高亭，绿沼扬清漪。\n旧蹊类陈迹，远圃分芳蕤。\n结根旬浃间，生意浑熙熙。\n微白李赋质，小红桃入肌。\n柳条无颜色，已含烟雨眉。\n游蜂相召引，有底渠先知。\n地力固自若，大钧不偏私。\n竞秀非机巧，向衰非钝迟。\n万物理固然，飏芬须得时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19229,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"添竹","author":"洪适","text":"添竹乘春力，期君共岁寒。\n青青怀特操，碌碌愧粗官。\n尚有哦诗日，尤胜借宅看。\n他时谁检校，何处报平安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19230,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵景思谢送四时纂要并惠乳泉且许见顾 其一","author":"洪适","text":"断壶食郁遵时令，莲芡櫜韬辨土宜。\n若解养生供伏腊，自然卜筑数期颐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19231,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵景思谢送四时纂要并惠乳泉且许见顾 其二","author":"洪适","text":"我无卮茜等通侯，不作多田望蓐收。\n松菊漫成三径梦，烟蓑已失五湖秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19232,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵景思谢送四时纂要并惠乳泉且许见顾 其三","author":"洪适","text":"青编送似补山房，妙语相酬掩夜光。\n盗瓮不须睎吏部，将军何日命元方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19233,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送范子芬赴浙东机幕","author":"洪适","text":"男儿三十富春秋，况复才华出辈流。\n传家不坠右丞相，入幕少佐东诸侯。\n梅花颇惜诗人去，草色正牵行客愁。\n修禊兰亭访陈迹，应怀同醉仲宣楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19234,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送季元衡教授赴调","author":"洪适","text":"三年淹讲席，斗酒动离情。\n此去登台省，诸公熟姓名。\n骅骝看地绝，鸾凤为时鸣。\n春日西湖上，烦君一寄声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19235,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送石初平归四明","author":"洪适","text":"析别梁溪七换春，海边相过意能勤。\n裤襦不羡千金子，简策无惭万石君。\n豪气掀雷须给札，他时修月待挥斤。\n镂衢又揖东风去，情话无人可夜分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19236,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送李相之提干闽中十二韵","author":"洪适","text":"官柳讫春事，落絮东复西。\n门外高轩过，行行将何之。\n七闽绣衣属，非如州县卑。\n少留长者辙，酌酒语别离。\n五年官他壤，一面即故知。\n辩囿麈仍落，诗坛襟屡题。\n撞钟问今古，邃然五总龟。\n迢迢千里去，风过衫裳吹。\n我亦及更书，归耘楚江涯。\n河梁携手叹，参辰后难期。\n曼倩宁自衒，长卿固同时。\n征途慎勿遽，会看轺车驰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19237,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题左达功秀才桂香斋","author":"洪适","text":"小斋面蓬瀛，昂霄得双桂。\n黄卷对圣贤，欣然有馀地。\n笔端妙言语，挟此波澜势。\n荧荧百鍊刚，自是青萍器。\n冲星不我识，铅刀且争利。\n于今修月手，益振陵云气。\n明年广寒宫，声名郤诜似。\n归来八桂乡，浮丘挹仙袂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19238,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"还李举之太平广记","author":"洪适","text":"稗官九百起虞初，过眼宁论所失诬。\n午枕黑甜君所赐，持还深愧一瓻无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19239,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"酬光吉叔用前韵见寄","author":"洪适","text":"怨鹤今谁侣，驯鸥讵可亲。\n颇思同渌酒，久已厌红尘。\n归梦常通夕，微吟漫惜春。\n床头易在否，触手不应新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19240,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵蔡瞻明雨中书怀","author":"洪适","text":"梅雨冥冥晴复阴，小轩终日起归心。\n自怜宦业初何补，独喜交情久益深。\n忆得微醺看锦瑟，愧无好语比南金。\n青山千里江南路，它日邮签幸见寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19241,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠传神陈秀才","author":"洪适","text":"举世人心别，端如面不同。\n山川险难测，笔墨思何工。\n未索形骸外，聊先阿堵中。\n自怜无骨相，不到汉南宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19242,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵向宪见赠三首 其一","author":"洪适","text":"理财无管晏，言利析秋豪。\n吐论千人废，摩空六翮高。\n未簪安世笔，先佩吕虔刀。\n楚泽东风劲，宁辞揽辔劳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19243,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵向宪见赠三首 其二","author":"洪适","text":"四望荒楼观，登高动土思。\n山川相映带，桃李已纷披。\n汉节人重仰，黄陂世莫窥。\n三章堆锦绣，唐突古西施。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19244,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵向宪见赠三首 其三","author":"洪适","text":"河东空有赋，人不道扬雄。\n贵贱云泥隔，寅缘井邑同。\n平番依列宿，谈笑霁威风。\n终赖帡幪力，能成尺寸功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19245,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵向宪道中偶成","author":"洪适","text":"四牡驰原隰，侯邦害必除。\n疲民端可念，茅舍未如初。\n消息三春异，创痍二纪馀。\n君王心在远，谕意倚相如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19246,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闻景严弟迁西掖并寄景卢","author":"洪适","text":"俛仰梁溪岁几寒，向来墨沼已中乾。\n传家紫橐荣三子，得路青云喜二难。\n爵位方知稽古力，论思当使覆盂安。\n自怜骨相宜尘土，那得丝言动笔端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19247,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵向宪留题荆门惠泉卒章见及","author":"洪适","text":"对泉一洗心如水，诵诗三叹颡有泚。\n字比渴骥骎骎来，文如翠潋鳞鳞起。\n皇华辙迹环诸道，济物良筹载襟抱。\n双泉复见等故人，竹马儿童半羸老。\n吾君丰泽要下流，惭愧长澜力不侔。\n一方始此一滴润，千亩长有千钟收。\n去瘼未尽惠未施，可使剜肉生新痍。\n尘埃满面语甚恶，虚辱逢人统项斯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19248,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"独步惠泉用石刻中韵","author":"洪适","text":"拂崖看古字，倚策仰前英。\n雕章细细读，清思源源生。\n文传岘山石，句敌渼陂行。\n一字或华衮，五言有长城。\n林蝉众作噪，下里羞混并。\n坐令蕞尔国，宇内浑知名。\n兹泉发地脉，有玉潜山庭。\n神龙职何护，老蚌呈煌荧。\n楚人力水耨，倚沼仍畦瀛。\n觱沸昼复夜，输出无穷声。\n演迤清汉接，旋折数日程。\n膏润亘原陌，谷价年年平。\n非才忝敷惠，下考乃为荣。\n疲民未击壤，循吏难联横。\n独行挹清泚，谁与论丹诚。\n销忧赖季雅，遣兴烦客卿。\n信美非吾土，千古仲宣情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19249,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"杨元素题蒙泉诗云源有雌雄分碧白注谓南泉色白为雌因为之解嘲二绝句 其一","author":"洪适","text":"小孤宁有匹，织女自无家。\n浪比人间世，增添白玉瑕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19250,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"杨元素题蒙泉诗云源有雌雄分碧白注谓南泉色白为雌因为之解嘲二绝句 其二","author":"洪适","text":"雄风波不动，雌霓影空垂。\n欲洗蒙泉谤，须删蜀客诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19251,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"曲水","author":"洪适","text":"杯去浑无勇退时，偶然遇坎亦安之。\n不教坐有独醒客，便与投醪倒接篱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19252,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金莲","author":"洪适","text":"绿衣黄里水苍笄，朝暮凌波步武齐。\n一种清高乐泉石，移根不肯污涂泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19253,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"古柳","author":"洪适","text":"异时古木蔽岩阿，去盗来兵厄斧柯。\n老柳如龙寿千百，独全煨烬傲清波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19254,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"同姚当可胡元质钱舜仁张昭甫游上泉","author":"洪适","text":"避暑远簿书，寻幽踏菅蒯。\n寒泉浮玉根，巨石开眼界。\n灵湫几千年，洗尽尘土碍。\n老藤走长蛇，茂木攲翠盖。\n扫叶坐水旁，可喜此风快。\n炎云不能神，潜虬秘奇怪。\n满酌白玉钟，咽甘犹沆瀣。\n何如习家池，举鞭同倒载。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19255,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵朱宣州见寄","author":"洪适","text":"十载萧萧麋鹿姿，那知出守得同时。\n黄山白水空孤讽，叠嶂双溪属好诗。\n击柝晓传邾子国，举鞭春到习家池。\n只今霖雨思贤佐，会见丝纶下王墀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19256,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谢景高兄惠鱼蟹","author":"洪适","text":"霜风激水蟹舍寒，渔火献俘清夜阑。\n不烹五鼎若赊死，使之骨醉尤加餐。\n尺半之鱼鳞六六，同入糟丘随小牍。\n鼎来兼味口流涎，可使盘中食无肉。\n浔阳从事姿南金，高山调古谁知音。\n宁同娵隅作蛮语，生憎郭索多躁心。\n檐头雪消春有意，洗盏开尊宜一醉。\n持螯颇忆左手同，尺素不妨时遣使。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19257,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送唐左史纸墨","author":"洪适","text":"黄山奇峰三十六，耸壑寿松多节目。\n真工曲突扫芳煤，介圭拱璧陈玄玉。\n浙河千里兹滥觞，万谷之皮捣冰霜。\n肌理细腻色白皙，蜀网剡藤难雁行。\n使君来自岷峨麓，曾赋客卿朝奏牍。\n细字不作蝇头书，高文富有牛腰轴。\n向来平步第一螭，勇退宛在番之湄。\n陶泓毛颖幸旅进，快写元和圣德诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19258,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送李泉","author":"洪适","text":"周人九府有圜法，汉京金布在令甲。\n炊炭冶镕多乱真，纷纷轻薄如榆荚。\n即山不复私下臣，张官置吏几王春。\n君子谓之阿堵物，方兄不知何许人。\n十羊九牧其弊近，谈何容易趣销印。\n事权顿使归民曹，鼓铸伊谁察诸郡。\n诏书恳恳修废官，诸公争言隃度难。\n向来矫枉亦太过，畴咨英俊乘輶轩。\n鼎新能事推心计，贯朽不须夸古始。\n共瞻使者振绣衣，曾见真人兴白水。\n荀卿自有富国篇，高视管萧宜并肩。\n钱流地上小小尔，便合论思雨露边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19259,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"江州尘外亭","author":"洪适","text":"使君人物风尘表，亭下纤埃远白蘋。\n佳传缅怀方外友，漫郎端是社中人。\n山光水色长排闼，鹄侣鸿俦已卜邻。\n莫语软红车马客，香炉峰下有遗民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19260,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"喜景徐作小圃因怀东阁二绝句 其一","author":"洪适","text":"数顷澄湖练有光，小亭处处得疏篁。\n梦中春草多佳句，一洗尘埃速寄将。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19261,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"喜景徐作小圃因怀东阁二绝句 其二","author":"洪适","text":"白白朱朱手自栽，两年忆著满林开。\n莫教童稚轻攀折，惜取浓阴待我来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19262,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵董伯鲁","author":"洪适","text":"读破群书有远谋，逢时便可动凝旒。\n不辞岩邑千山险，肯作铃斋十日留。\n辩舌未容蠡测海，归心已梦蝶为周。\n松关万一逢佳友，为说相如故倦游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19263,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"端午日应贤小集戏用坐中语","author":"洪适","text":"短檠长忆桂岩东，翰墨新来莫论功。\n日日簿书成俗吏，星星鬓发逼衰翁。\n公祠难缓三人带，小垒聊吟一马骢。\n共饮昌蒲修故事，山肴野蔌是家风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19264,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵黄子馀惠双井茶二首 其一","author":"洪适","text":"荻花枫叶醉为乡，每忆临分一鼎香。\n枉费光阴惊老大，略无治行愧循良。\n归心来往鸡豚社，清思消磨雁鹜行。\n且喜弦歌馀乐地，好诗句句挟风霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19265,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵黄子馀惠双井茶二首 其二","author":"洪适","text":"峰横万仞临双井，调护旗枪春怕深。\n白雪有芽鹰作爪，黄粱无梦蝶何心。\n闻名可信非虚语，知味端如赏好音。\n祇欠谷廉一杯水，末能相就盍朋簪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19266,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送范至能","author":"洪适","text":"愁云暗千山，欲雪意未歇。\n雨脚侵夜分，鹢首勇朝发。\n软红英俊林，定不冗干谒。\n磊落胸中书，高谈倾上笏。\n结驷映天街，登瀛有仙骨。\n摩挲先友碑，姓名或湮没。\n却顾浮丘亭，寄声频日月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19267,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵王伟文二首 其一","author":"洪适","text":"山城碌碌负鱼符，尺五家园好坦途。\n可惜光阴迷簿领，漫无惠露到樵苏。\n鸡豚小社元相接，鸥鹭新盟不敢渝。\n莫话弹冠仍结绶，祇宜袯襫与夫须。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19268,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵王伟文二首 其二","author":"洪适","text":"衒石难夸和氏场，挥犀久避盖公堂。\n笔端风雨真无敌，纸上寒温细作行。\n结屋竞传千亩竹，奉祠聊对一炉香。\n朝中环赐无虚月，遥想眉黄已效祥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19269,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵程观过","author":"洪适","text":"山城寂寂簿书稀，梅际春风一夜归。\n忽喜烹鱼中有得，恍然挥麈久相违。\n折腰岂爱蕲州竹，问汉须寻织女机。\n奇绝黄山待佳句，何时小雨湿征衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19270,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和州","author":"洪适","text":"叹息和州事，腥膻未易除。\n惊涛饮胡马，壮士葬江鱼。\n列戍俱奔命，斯民不奠居。\n元戎犹拥钺，资斧定何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19271,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"三将","author":"洪适","text":"鼎立淮南将，胡来竞退师。\n折冲潜白羽，告捷闹黄旗。\n已报瓜洲败，还惊采石危。\n边防恃天堑，百万岂熊罴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19272,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"胡虏","author":"洪适","text":"胡虏猖狂甚，妖星近日畿。\n俄闻佛狸死，不得帝羓归。\n虎旅空增灶，狼狐为解围。\n人人说恢复，进退在投机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19273,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"詹氏仁寿轩","author":"洪适","text":"修竹林林贯四时，厖眉扶杖到期颐。\n子孙长忆当年事，留取轩楹客赋诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19274,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"道中怀景卢","author":"洪适","text":"宦路多睽别，春游隔弟兄。\n频年再登陛，十日又离京。\n吏责仓台少，官曹省闼清。\n床头何夕月，冷话听残更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19275,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"阐阳驿二绝句 其一","author":"洪适","text":"略略春晴天亦悭，雷惊雨作转头间。\n浮云又逐东风起，不见前山出髻鬟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19276,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"阐阳驿二绝句 其二","author":"洪适","text":"触石泉声高下闻，曾将两耳洗埃尘。\n相逢尊酒今谁侣，细草青花是故人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19277,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵范守翠微亭","author":"洪适","text":"带郭长堤十里春，是中佳处外风尘。\n层层危磴浑依旧，一一高亭已斩新。\n领略江山初纵目，剪除荆棘不劳神。\n携壶一笑须投隙，官事何时可脱身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19278,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵施德初游齐山","author":"洪适","text":"诗尘谁复数齐梁，小杜文章楚大邦。\n曾为黄花酬九日，至今陈迹擅三江。\n新亭高下依乔木，远岫参差进曲窗。\n著屐与君时茗饮，后车何必酒盈缸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19279,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再赋","author":"洪适","text":"向来胡马远跳梁，奔命纷纷不一邦。\n景物何期新斸壑，梦魂犹自怯防江。\n看山小隐红莲幕，批敕须临青琐窗。\n无事肯来文字饮，为将红酒倒鹅缸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19280,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"喻江宁欲遗蕲笛辞之","author":"洪适","text":"蕲州美竹今古名，白云吹裂笛一声。\n臞儒所对笔墨客，长物虚寻疏比僧。\n还君不用君莫怪，绮窗办得千金买。\n谁与移根到草堂，它日风来听天籁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19281,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"烈士","author":"洪适","text":"烈士死知己，交情重同心。\n反眼如不识，怨深恩更深。\n忆昔邂逅初，一诺百黄金。\n口血顾未乾，旧盟何许寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19282,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"景卢自右史假北门出疆再用前韵","author":"洪适","text":"汉节螭坳出，青毡映父兄。\n天方摧丑虏，人已望神京。\n使指今兹重，边尘定可清。\n归来陈口伐，莲烛问严更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19283,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闻应贤景高文特少张景孙同客景卢官舍","author":"洪适","text":"使回亲旧集，虎穴问穹庐。\n半夜枥喧马，高秋盘进鱼。\n真成聚东井，谁复话南徐。\n底事桃源客，新来书也疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19284,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"左举善求草堂诗","author":"洪适","text":"孤山佳处著茅庐，饱看云烟自卷舒。\n莫向淮南恋戎幕，松关恐有绝交书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19285,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵景裴赞喜农扈之除","author":"洪适","text":"北固金焦顾眄中，裴回于此再踰冬。\n徒劳金谷供诸将，未有田园问老农。\n且喜边亭罢欧脱，不须水战习蒙冲。\n九卿已愧班行忝，敢向明时叹不逢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19286,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"答木缊之用前韵见寄","author":"洪适","text":"魁星秀句挟东风，便觉阳春变盛冬。\n愧我供军侪绛灌，羡君汲古到羲农。\n北邻再讲衣裳会，京口今为冠盖冲。\n已具扁舟勇归去，粲花清论度难逢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19287,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]