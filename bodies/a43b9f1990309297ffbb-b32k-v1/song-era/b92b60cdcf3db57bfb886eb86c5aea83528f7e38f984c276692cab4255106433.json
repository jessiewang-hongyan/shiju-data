[{"title":"鹿伯可郎中园池杂咏 小东山","author":"楼钥","text":"安石东山志不渝，归来寻得静工夫。\n从教更为苍生起，携妓何妨且自娱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24797,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鹿伯可郎中园池杂咏 云龛","author":"楼钥","text":"浮云舒卷原无定，此意谁能为饱参。\n出岫无心归亦尔，不妨今日与同龛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24798,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鹿伯可郎中园池杂咏 月沼","author":"楼钥","text":"玉洁冰清一壑专，箨龙何处引涓涓。\n深知月满还亏缺，祇学蟾光一半圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24799,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鹿伯可郎中园池杂咏 止室","author":"楼钥","text":"流行坎止事无多，举世营营自网罗。\n珍重主人真止矣，直如古井更无波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24800,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鹿伯可郎中园池杂咏 见一堂","author":"楼钥","text":"灵澈清诗千载传，始闻林下有斯贤。\n傍人只道休官早，见一名堂已十年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24801,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鹿伯可郎中园池杂咏 松岭","author":"楼钥","text":"翠云深处曳枯筇，插碧堂堂十八公。\n全似华阳隐君子，挂冠归去听松风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24802,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鹿伯可郎中园池杂咏 星潭","author":"楼钥","text":"山头分下一泓清，石甃团团瞰小亭。\n身在赤城名绛阙，至今潭影照郎星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24803,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鹿伯可郎中园池杂咏 柑隅","author":"楼钥","text":"霜著芳苞翠作围，数椽潇洒映斜晖。\n木奴何必须千树，乞得閒身径且归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24804,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鹿伯可郎中园池杂咏 桂堂","author":"楼钥","text":"芳树丛生庭砌间，高枝更许后来攀。\n主人勿恋山中桂，招隐还应看小山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24805,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鹿伯可郎中园池杂咏 桃蹊","author":"楼钥","text":"几树桃花相映开，主人归路入天台。\n凭谁寄语玄都观，前度刘郎不更来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24806,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鹿伯可郎中园池杂咏 梅坡","author":"楼钥","text":"江梅留待主人还，见说归时得饱看。\n回首残花飞作雪，一峰当户正高寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24807,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渡扬子","author":"楼钥","text":"江豚吹浪雨飕飗，望断天涯人白头。\n一舸乘风渡扬子，数鸥导我过瓜州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24808,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游大梅山护圣寺 其二","author":"楼钥","text":"寒云片日忽吹开，历井扪参得得来。\n行尽高山天欲半，不知平地有楼台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24809,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游大梅山护圣寺 其一","author":"楼钥","text":"江东东畔更东山，又过东山数里间。\n试问招提在何处，万山深处白云环。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24810,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游金焦两山以雨而辍","author":"楼钥","text":"金山寺裹山，焦山山裹寺。\n风雨劝我归，也省两头事。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24811,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登马鞍岭","author":"楼钥","text":"轧轧轻舆上马鞍，半天岚翠逼人寒。\n从教宿霭迷清嶂，明日晴空取意看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24812,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答东山一老二偈 其二","author":"楼钥","text":"闭门深坐日知味，无限好山都懒游。\n城里山中俱是隐，江湖不若两忘休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24813,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答东山一老二偈 其一","author":"楼钥","text":"即心是佛本无难，挫却丝毫隔万山。\n知有毗卢五千卷，谁能分寸费跻攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24814,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答杖锡平老","author":"楼钥","text":"老我平生不愿馀，归来但欲赋闲居。\n灌园自足供朝膳，且奉夫人御版舆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24815,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢少微兄惠牡丹 其一","author":"楼钥","text":"乍观泉石分新种，想为黟山忆旧葩。\n病后不妨风韵在，此花之外更无花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24816,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢少微兄惠牡丹 其二","author":"楼钥","text":"方剪栏干第四花，玉人联袂过吾家。\n捻红玉翼皆名品，醉眼相看到日斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24817,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢少微兄惠牡丹 其三","author":"楼钥","text":"箫鼓声中醉九旬，落红万点正愁人。\n眼明忽见倾城色，更向尊前作好春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24818,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢林景思和韵","author":"楼钥","text":"黄昏门外六花飞，困倚胡床醉不知。\n冻合玉楼犹强项，拥衾方咏雪巢诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24819,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢袁起岩侍郎送盆栀奉老母","author":"楼钥","text":"翠绡飞盖拥生香，冰雪精神试晚妆。\n鹤发慈亲俄一笑，玉人何事晚升堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24820,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢舒景叔写照见赠","author":"楼钥","text":"谁写衰容入画图，本来面目旧形模。\n几年老瘦鬓如雪，不道今吾非故吾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24821,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢潘端叔惠红梅 其二十","author":"楼钥","text":"自昔梅花雪作团，红梅晚出可人看。\n江梅不解追时好，祇守冰姿度岁寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24822,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢潘端叔惠红梅 其十八","author":"楼钥","text":"只说梅花似雪飞，朱颜谁信暗香随。\n不须添上徐熙画，付与西湖别赋诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24823,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢潘端叔惠红梅 其四","author":"楼钥","text":"前身施粉忌太白，今日施朱恐太红。\n说似旁人刚不信，清香万斛在花中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24824,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢潘端叔惠红梅 其五","author":"楼钥","text":"殿后鞓红色漫秾，绛桃空自笑春风。\n何人击碎珊瑚树，恼得瑶姬面发红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24825,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢潘端叔惠红梅 其十二","author":"楼钥","text":"坡翁著意赋三诗，谩说秾香已透肌。\n若见此花应绝倒，惜君生晚不逢时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24826,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢潘端叔惠红梅 其十七","author":"楼钥","text":"诗老为花空自忙，想应未识此奇芳。\n青枝绿叶何须辨，桃杏安能如许香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24827,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢潘端叔惠红梅 其十三","author":"楼钥","text":"花品无庸定等差，国香国色属吾家。\n海棠正自惭粗俗，莫问漫山桃李花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24828,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢潘端叔惠红梅 其十五","author":"楼钥","text":"客来试与倚栏干，拂拂清香触鼻端。\n尽做北人浑不识，不应敢作杏花看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24829,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢潘端叔惠红梅 其三","author":"楼钥","text":"为君手种向南堂，误认昌州移海棠。\n元是玉妃生酒晕，帐中仍带返魂香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24830,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢潘端叔惠红梅 其九","author":"楼钥","text":"初移湘水一枝春，剩馥还欣为我分。\n梦入山房三十树，何时醉倒看红云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24831,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢潘端叔惠红梅 其十九","author":"楼钥","text":"缟裙练帨玉为肌，谁点微赪向北枝。\n若使罗虬见颜色，定须将此比红儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24832,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢潘端叔惠红梅 其十四","author":"楼钥","text":"不学江头玉树寒，寿阳红粉旧妆残。\n婵娟可是惭随俗，莫作金沙锁骨看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24833,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢潘端叔惠红梅 其二","author":"楼钥","text":"黄姑曾为点冰肌，亦有缁尘染素衣。\n何似烟脂天赐与，暗香犹在是耶非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24834,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢潘端叔惠红梅 其一","author":"楼钥","text":"旧家桃李种河阳，今日红梅自楚湘。\n根垡送春君意重，为移绝艳到吾乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24835,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢潘端叔惠红梅 其六","author":"楼钥","text":"旧见寒花蜡蒂红，宁知沁入雪肤中。\n绝怜金谷佳人坠，到地馀香散晓风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24836,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢潘端叔惠红梅 其七","author":"楼钥","text":"梅花几种尽相闻，老矣才欣见此君。\n相与对花文字饮，绝胜歌舞醉红裙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24837,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢潘端叔惠红梅 其十六","author":"楼钥","text":"全体江梅腊里芳，紫绵新拂汉宫妆。\n临川借得江梅句，倾国天教抵死香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24838,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢潘端叔惠红梅 其八","author":"楼钥","text":"人閒丹桂亦微黄，未见红葩解有香。\n惟喜此花兼众美，麝脐薰彻绛纱囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24839,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢潘端叔惠红梅 其十一","author":"楼钥","text":"少陵年后咏花开，未见烟脂一抹腮。\n可惜当时诗兴动，止因东阁看官梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24840,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"慈溪道中","author":"楼钥","text":"双橹真成鹅鹳鸣，客愁厌苦梦魂惊。\n须臾寖觉耳根熟，一觉醒来天已明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24841,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"殿上侍立寒甚","author":"楼钥","text":"小雪以来霜气清，今朝寒色倍严凝。\n榻前侍立无遮障，吹得半身真是冰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24842,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"殿上闻杜鹃","author":"楼钥","text":"衰晚三年侍玉墀，高梧又擢凤凰枝。\n封章屡上未容去，更向殿头闻子规。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24843,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蕉庵清坐","author":"楼钥","text":"薄晚归来烟已苍，蛮蕉一叶障斜阳。\n不须久住潭潭府，始觉山林兴味长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24844,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蕉庵暮归","author":"楼钥","text":"绿蕉阴下绕斑衣，饭了从容到夕晖。\n老子才携筇杖去，孙儿各捧竹团归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24845,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题从子浃娱亲","author":"楼钥","text":"阿戎筑屋为娱亲，野草闲花日日新。\n我奉版舆来举酒，祈君亲寿似夫人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24846,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题龙眠画西域圣僧","author":"楼钥","text":"放两不借叠双足，自在在心机在目。\n默然深入不二门，不知师唱谁家曲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24847,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题孙谷桥墦间图 其一","author":"楼钥","text":"墦间不足又之他，犹自施施骄室家。\n齐国一人如许尔，宁知后日事如麻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24848,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题孙谷桥墦间图 其二","author":"楼钥","text":"因知义利本殊途，莫笑墦间乞祭徒。\n正使往来多显者，此中尤要著工夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24849,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题老融归牛图","author":"楼钥","text":"薄宦六年辞故山，故山祇在梦魂间。\n簪绅何苦自缠缚，却羡归牛自在閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24850,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题宏老空谷","author":"楼钥","text":"君看空谷自然空，声有洪纤应则同。\n正为中虚声自应，莫将应处做神通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24851,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题汪宏甫三马图","author":"楼钥","text":"玉花流云照夜白，开元尚想行天街。\n韩李郑君俱已矣，健笔谁能如顺斋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24852,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题汪季路太傅所藏龙眠阳关图 其一","author":"楼钥","text":"离觞别泪为君倾，行李匆匆欲问程。\n不用阳关寻旧曲，图中端有断肠声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24853,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题汪季路太傅所藏龙眠阳关图 其二","author":"楼钥","text":"画出阳关古别离，萧疏柳质不胜悲。\n行人顾叹离人泣，柳下渔翁总不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24854,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题汪季路尚书所藏米元晖湖山瑞雪图","author":"楼钥","text":"笔力谁能似虎儿，思陵亲为御珍题。\n小臣不识湖山好，但欲扁舟泛剡溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24855,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题汪季路尚书所藏米元晖蒋山出云","author":"楼钥","text":"龙盘往昔名钟山，云起从龙意自闲。\n肤寸须臾成戴帽，坐看膏雨满人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24856,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题陈简斋寄夫人书","author":"楼钥","text":"行书满纸遗君文，可见闺门敬若宾。\n应与少文能协趣，定因元亮遂忘贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24857,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题林宗鲁校书所藏宣和御画","author":"楼钥","text":"周公多艺孔多能，徽庙才高更倍增。\n除却万机都不会，至今遗老话昭陵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24858,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题贺监李谪仙二像 其二","author":"楼钥","text":"斗酒浇诗动百篇，鉴湖牛渚两俱仙。\n早知今日犹相对，不向稽山回酒船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24859,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题贺监李谪仙二像 其一","author":"楼钥","text":"不有风流贺季真，更谁能识谪仙人。\n金龟换酒今何在，相对画图如有神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24860,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题施武子所藏老融二牛图 其一","author":"楼钥","text":"佳哉淡墨扫人牛，一笛横风各自由。\n平日深知焉用稼，如今但欲老西畴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24861,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题施武子所藏老融二牛图 其二","author":"楼钥","text":"乌犍离立意逶迟，鞭策俱忘取次归。\n騃犊跳风仍却顾，老融于此露天机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24862,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题赵睎远二画 其二 墨梅","author":"楼钥","text":"窗前惊见一枝斜，照眼英英十数花。\n千载简斋仙去后，何人更著好诗誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24863,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题赵睎远二画 其一 鱼扇","author":"楼钥","text":"藻翻数尾已如生，妙绝鱼儿作队行。\n不是深知濠上趣，未应笔底得纵横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24864,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题徐圣可知县所藏杨补之二画 其二","author":"楼钥","text":"梅花屡见笔如神，松竹宁知更逼真。\n百卉千华皆面友，岁寒祇见此三人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24865,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题徐圣可知县所藏杨补之二画 其一","author":"楼钥","text":"谁种疏梅古岸头，推蓬瞥见倍清幽。\n君看竹外一枝好，真有江南万斛愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24866,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题萝月上人送鸿小楼","author":"楼钥","text":"雨洗春山空翠新，登楼不见送鸿人。\n薜萝清夜月依旧，无复新诗泣鬼神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24867,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"潚自剡川寄水晶蒲萄","author":"楼钥","text":"马乳从他堆满盘，未如清嚼水晶寒。\n固知一县蒲萄熟，不用劳人数问安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24868,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠丁相士","author":"楼钥","text":"相形何似且论心，眼力工夫见浅深。\n古怪清奇任君说，灵台一片若为寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24869,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠于湖刘相士","author":"楼钥","text":"自笑今年卦气阑，壮心销尽鬓毛残。\n明知七十无多子，只问何时可挂冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24870,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠龙游术士胡杲","author":"楼钥","text":"方笑刘郎问大钧，从来祸福本无门。\n世閒生老病死苦，时至即行何足论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24871,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠别章茂献尚书","author":"楼钥","text":"我辈重来鬓已皤，贞元朝士苦无多。\n才堪柱石犹归去，柰此摧颓一老何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24872,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠陈居靖道人","author":"楼钥","text":"沩汭道人身御风，弃家求静慕仙踪。\n仙都有石立天半，特立要当如此峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24873,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠画梅吕生","author":"楼钥","text":"西湖处士赋疏影，未似希真好乐章。\n岂是无情甘澹泊，受它风月几凄凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24874,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]