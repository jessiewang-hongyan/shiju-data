[{"title":"采桑子 其一 三月晦必东馆大雨","author":"赵师侠","text":"连朝雨骤驱春去，瓦注盆倾。\n不记初春。\n润柳催花忒有情。\n春光解有重来日，宁耐休争。\n待得秋深。\n听你无聊点滴声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44684,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"采桑子 其二 樱桃花","author":"赵师侠","text":"梅花谢后樱花绽，浅浅匀红。\n试手天工。\n百卉千葩一信通。\n馀寒未许开舒妥，怨雨愁风。\n结子筠笼。\n万颗匀圆讶许同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44685,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"促拍满路花 其一 信丰黄师尹跳珠亭","author":"赵师侠","text":"栽花春烂漫，叠石翠巑岏。\n小亭相对倚，数峰寒。\n主人寻胜，接竹引清泉。\n凿破苍苔地，一掬泓澄，六花疑是深渊。\n向闲中、百虑翛然。\n情事寄鸣弦。\n炉香陪茗碗，可忘言。\n喷珠溅雪，历历听潺湲。\n尘世知何计，不老朱颜，静看日月跳丸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44686,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"促拍满路花 其二 瑞荫亭赠锦屏苗道人","author":"赵师侠","text":"连枝蟠古木，瑞荫映晴空。\n桃江江上景，古今同。\n忙中取静，心地尽从容。\n扫尽荆榛蔽，结屋诛茅，道人一段家风。\n任乌飞兔走匆匆。\n世事亦何穷。\n官闲民不扰，更年丰。\n箪瓢云水，时与话西东。\n真乐谁能识，兀坐忘言，浩然天地之中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44687,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南乡子 尹先之索净圆子词","author":"赵师侠","text":"元夜景尤殊。\n万斛金莲照九衢。\n锤拍豉汤都卖得，争如。\n甘露杯中万颗珠。\n应是著工夫。\n脑麝浓薰费小厨。\n不比七夕黄蜡做，知无。\n要底圆儿糖上浮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44688,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南柯子/南歌子 送朱辰州千方壶小隐","author":"赵师侠","text":"木落千山瘦，风微一水澄。\n清霜暖日快归程。\n唤渡沙头、款款话离情。\n傍岸渔舟集，横空雁字轻。\n凭阑凝望眼增明。\n一片潇湘、真个画难成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44689,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"柳梢青 其三 和赵显祖","author":"赵师侠","text":"漠漠轻阴。\n养花天气，乍暗还明。\n曲径风微，蜂迷红片，蝶趁游人。\n平芜极目青青。\n谩怅望、谁招断魂。\n柳外愁闻，莺雏唤友，鸠妇呼晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44690,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"柳梢青 其二 荼屏","author":"赵师侠","text":"红紫凋零。\n化工特地，剪玉裁琼。\n碧叶丛芳，檀心点素，香雪团英。\n柔风唤起娉婷。\n似无力、斜敧翠屏。\n细细吹香，盈盈浥露，花里倾城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44691,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"柳梢青 其五 富阳江亭","author":"赵师侠","text":"烟敛云收。\n夕阳斜照，暮色迟留。\n天接波光，水涵山影，都在扁舟。\n虚名白尽人头。\n问来往、何时是休。\n潮落潮生，吴山越岭，依旧临流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44692,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"柳梢青 其一 祭户立春","author":"赵师侠","text":"节物推移。\n青阳景变，玉琯灰飞。\n彩仗泥牛，星球雪柳，争报春回。\n丝金缕玉幡儿。\n更斜袅、东风应时。\n宜入新春，人随春好，春与人宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44693,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"柳梢青 其七 邵武熙春台席上呈修可叔","author":"赵师侠","text":"矫首遐观。\n崇台徙倚，心目俱宽。\n一水萦蓝，群峰耸翠，天接高寒。\n平生江北江南。\n总未识、闽中好山。\n雨暗前汀，云生衣袂，身倦跻攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44694,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"柳梢青 其六 聚八仙花","author":"赵师侠","text":"人间春足。\n一番红紫，水流风逐。\n戏蝶初闲，轻摇粉翅，高低飞扑。\n雨昏烟暝增明，似积雪、枝间映绿。\n后土琼芳，蓬莱仙伴，蕊粉香粟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44695,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"柳梢青 其一 和张伯寿紫笑词","author":"赵师侠","text":"浓碧抟枝，柔黄衬紫，独殿春风。\n菡萏轻盈，甘瓜馥郁，叶萼相重。\n人生一笑难同。\n更馀韵、都藏笑中。\n日助清芬，酒添风味，须与从容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44696,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"柳梢青 其八 壬子莆阳壶山阁","author":"赵师侠","text":"暑怀烦郁。\n危栏徙倚，凝情独立。\n榕叶连阴，横冈接秀，壶峰凝碧。\n海山云树微茫，更无数、归帆暮集。\n却忆潇湘，孤村烟渚，晚风斜日。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44697,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"柳梢青 其四 黄栀林送李粹伯","author":"赵师侠","text":"料峭馀寒。\n元宵欲过，灯火阑珊。\n宿酒难醒，新愁未解，摇兀吟鞍。\n深林百舌关关。\n更雨洗、桃红未乾。\n野烧痕青，荒陂水满，春事何堪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44698,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"柳梢青 其九 鉴止月下赏莲","author":"赵师侠","text":"水满方塘。\n菰蒲深处，戏浴鸳鸯。\n灿锦舒霞，红幢绿盖，时递幽香。\n天弓摇挂孤光。\n映烟树、云间渺茫。\n散发披襟，都忘身世，真在仙乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44699,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"洞仙歌 丁巳元夕大雨","author":"赵师侠","text":"元宵三五。\n正好嬉游去。\n梅柳蛾蝉斗济楚。\n换鞋儿、添头面，只等黄昏，恰恨有、些子无情风雨。\n心忙腹热，没顿浑身处。\n急把灯台炙艾炷。\n做匙婆、许葱油，麦灰画葫芦，更漏转，越㬠不停不住。\n待归去、犹自意迟疑，但无语空将，眼儿厮觑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44700,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"点绛唇 其一 和翁子西","author":"赵师侠","text":"日暖风暄，殿春琼蕊依台榭。\n雪堆花架。\n不用丹青写。\n莹彻精神，映月唯宜夜。\n幪香帕。\n倩风扶下。\n碎玉残妆卸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44701,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"点绛唇 其三 同曾无玷观沈赛娘棋","author":"赵师侠","text":"袅袅娉娉，可人尤赛娘风韵。\n花娇玉润。\n一捻春期近。\n占路藏机，已向棋中进。\n俱休问。\n酒旗花阵。\n早晚争先胜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44702,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贺圣朝 和宗之梅","author":"赵师侠","text":"千林脱落群芳息。\n有一枝先白。\n孤标疏影压花丛，更清香堪惜。\n吟情无尽，赏音未已，早纷纷藉藉。\n想贪结子去调羹，任叫云横笛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44703,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其四 螺川从善席上叙别","author":"赵师侠","text":"不比阳关去路赊。\n使君行即返京华。\n清江江上是吾家。\n聚散有时思夜雨，留连无计劝流霞。\n红愁绿惨一川花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44704,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其一 癸巳豫章","author":"赵师侠","text":"日丽风和春昼长。\n杏花枝上正芬芳。\n无情社雨亦何狂。\n一洗娇红啼嫩脸，半开新绿映残妆。\n画梁空有燕泥香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44705,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其三 鸣山驿道中","author":"赵师侠","text":"松雪纷纷落冻泥。\n栖禽犹困傍枝低。\n茅檐冰柱玉鞭垂。\n流水溅溅春意动，群山灿灿晓光迷。\n朔风寒日度云迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44706,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其二 滕王阁席上赠段云轻","author":"赵师侠","text":"落日沈沈堕翠微。\n断云轻逐晚风归。\n西山南浦画屏围。\n一目波光明欲溜，两眉山色翠长低。\n须知人与景相宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44707,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其五 鉴止宴坐","author":"赵师侠","text":"雪絮飘池点绿漪。\n舞风游漾燕交飞。\n阴阴庭院日迟迟。\n一缕水沈香散后，半瓯新茗味回时。\n翛闲万事总忘机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44708,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其六 鸳鸯红梅","author":"赵师侠","text":"本是孤根傲雪霜。\n肌肤不肯涴铅黄。\n要随尘世浅匀妆。\n似杏著花尤灿灿，比梅成实自双双。\n青枝巧缀碧鸳鸯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44709,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浪淘沙令 其三 柳","author":"赵师侠","text":"摇曳万丝风。\n轻染烟浓。\n鹅黄初褪绿茸茸。\n雨洗云娇春向晚，雪絮空濛。\n车马灞桥中。\n别绪匆匆。\n只知攀折怨西东。\n不道晓风残月岸，离恨无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44710,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浪淘沙令 其一 杏花","author":"赵师侠","text":"绛萼衬轻红。\n缀簇玲珑。\n夭桃繁李一时同。\n独向枝头春意闹，娇倚东风。\n飞片入帘栊。\n粉淡香浓。\n凤箫声断月明中。\n只恐明朝风雨恶，燕嘴泥融。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44711,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浪淘沙令 其二 桃花","author":"赵师侠","text":"桃萼正芳菲。\n初占春时。\n蒸霞灿锦望中迷。\n斜出繁枝临曲沼，鸾鉴妆迟。\n蜂蝶镇相依。\n天气融怡。\n空教追忆武陵溪。\n片片漫随流水去，风暖烟霏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44712,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清平乐 其二 阳春亭","author":"赵师侠","text":"一宵风雨。\n春与人俱去。\n春解再来花作主。\n只有行人无据。\n殷勤满酌离觞。\n阳关唱起愁肠。\n苦恨无情杜宇，声声叫断斜阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44713,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清平乐 其三 迎春花一名金腰带","author":"赵师侠","text":"纤秾娇小。\n也解争春早。\n占得中央颜色好。\n装点枝枝新巧。\n东皇初到江城。\n殷勤先去迎春。\n乞与黄金腰带，压持红紫纷纷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44714,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清平乐 其一 萍乡必东馆","author":"赵师侠","text":"无风轻燕。\n缭绕深深院。\n昼永人闲帘不卷。\n时听莺簧巧啭。\n清和天气阴阴。\n南风初奏薰琴。\n唤起午窗新梦，愁添一掬归心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44715,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 其二","author":"赵师侠","text":"娇花媚柳新妆靓。\n裙边微露双鸳并。\n笑靥最多情。\n春从两脸生。\n香罗萦皓腕。\n翠袖笼歌扇。\n馀韵遏云低。\n梁尘簌簌飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44716,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 其十二 辛亥二月雪","author":"赵师侠","text":"东皇不受人间俗。\n为嫌花柳纷红绿。\n特地閟春和。\n连延雨雪多。\n梅梢封玉蕊。\n春半开犹未。\n还恐怨韶华。\n吹绵作柳花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44717,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 其六 可人梅轴","author":"赵师侠","text":"琼英为惜轻飞去。\n可人妙笔移缣素。\n潇洒向南枝。\n永无开谢时。\n闺房难并秀。\n自是春风手。\n何必问逃禅。\n人间水墨仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44718,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 其七 韵胜竹屏","author":"赵师侠","text":"多情可是怜高节。\n濡毫幻出真清绝。\n雨叶共风枝。\n天寒人倚时。\n萧萧襟韵胜。\n堪与梅兄并。\n不用翠成林。\n坡仙曾赏音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44719,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 其五 瑞荫秋望","author":"赵师侠","text":"小春爱日融融暖。\n危亭望处晴岚满。\n江静绿回环。\n横陈无际山。\n清霜欺远树。\n黄叶风扶去。\n试探岭头梅。\n点红开未开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44720,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 其十三 鉴止莲花穿阑干开","author":"赵师侠","text":"水风叶底波光浅。\n亭亭翠盖红妆面。\n六月下塘春。\n平铺云锦屏。\n露凉轻点缀。\n绿映珍珠袂。\n浑似太真妃。\n倚阑娇困时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44721,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 其八 玉山道中","author":"赵师侠","text":"霜风落木千山远。\n护霜云散晴曦暖。\n潇洒小旗亭。\n山花照眼明。\n粉妆匀未了。\n一捻春风小。\n把酒恨匆匆。\n深情妩媚中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44722,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 其九 梅林渡寄兴伯","author":"赵师侠","text":"行舟荡漾鸣双桨。\n江流为我添新涨。\n指顾隔汀洲。\n人归心尚留。\n阳关三叠举。\n怨柳离情苦。\n何似莫来休。\n不来无许愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44723,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 其四 用三谢诗“故人心尚远，故心人不见”之句","author":"赵师侠","text":"故人心尚如天远。\n故心人更何由见。\n肠断楚江头。\n泪和江水流。\n江流空滚滚。\n泪尽情无尽。\n不怨薄情人。\n人情逐处新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44724,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 其三","author":"赵师侠","text":"晚风断送归帆急。\n重城回首天连碧。\n犹有小楼情。\n西山如旧青。\n故园今渐近。\n应卜灯花信。\n一喜一牵萦。\n平分两处心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44725,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 其一 癸巳自豫章檄归","author":"赵师侠","text":"扁舟又向萧滩去。\n危樯却系江头树。\n风送雨声来。\n凉生真快哉。\n电光云际掣。\n白浪天相接。\n不用怯风波。\n风波平地多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44726,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 其一 永州故人亭和圣徒季行韵","author":"赵师侠","text":"故人话别情难已。\n故人此别何时会。\n江上驻危亭。\n离怀牵故情。\n悠悠东去水。\n簇簇渔村市。\n应记合江滨。\n潇湘别故人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44727,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 其十一 春陵迎阳亭","author":"赵师侠","text":"西风又老潇湘树。\n翩翩黄叶辞枝去。\n斜日淡云笼。\n溪山烟霭中。\n危阑闲独倚。\n縠浪连天际。\n残角起江城。\n昼空征雁横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44728,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谒金门 其二 丁酉冬昌山渡","author":"赵师侠","text":"江水绿。\n江上数峰如簇。\n唤渡小舟来岸北。\n笋舆行太速。\n素艳窗纱笼玉。\n不负看花心目。\n今夜知他何处宿。\n断魂沙路曲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44729,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谒金门 其五 常山道中","author":"赵师侠","text":"风策策。\n山迥暮烟横白。\n淅沥穿林翻败叶。\n羁怀愁倦客。\n问宿荒村山驿。\n谁识离情脉脉。\n雁足无书孤夜色。\n音尘千里隔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44730,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谒金门 其四","author":"赵师侠","text":"风雨急。\n红紫又还狼藉。\n嫩绿团枝苔径湿。\n帘开双燕入。\n院静昼闲人寂。\n一缕水沈烟直。\n心事有谁能会得。\n阶前芳草碧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44731,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谒金门 其一","author":"赵师侠","text":"风和雨。\n又送一番春去。\n春去不知何处住。\n惜春无觅处。\n柳老空抟香絮。\n莺娇乍迁芳树。\n回念故园如旧否。\n不堪闻杜宇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44732,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谒金门 和从善二首 其六","author":"赵师侠","text":"花夜雨。\n渺渺绿波南浦。\n擘絮晴云山外吐。\n凝情谁共语。\n十二玉梯空伫。\n闲却琐窗朱户。\n久客念归归未许。\n寸心愁万缕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44733,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谒金门 其三 耽冈迓陆尉","author":"赵师侠","text":"沙畔路。\n记得旧时行处。\n蔼蔼疏烟迷远树。\n野航横不渡。\n竹里疏花梅吐。\n照眼一川鸥鹭。\n家在清江江上住。\n水流愁不去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44734,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"朝中措 其六 丁亥益阳贺王宜之","author":"赵师侠","text":"眉间黄色喜何如。\n花县拜恩初。\n五品荣颁命服，十行祗奉天书。\n萱堂绣阁，均封大邑，盛事同居。\n此日银章朱绂，行看玉带金鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44735,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"朝中措 其一 莆中共乐台","author":"赵师侠","text":"斜阳留照有馀红。\n烟霭淡冥濛。\n麦陇青摇一望，前山翠失双峰。\n高台徙倚，松飘逸韵，梅减冰容。\n俯视尘寰如掌，翩然我欲乘风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44736,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"朝中措 其三 乙未中秋麦湖舟中","author":"赵师侠","text":"西风著意送归船。\n家近总欣然。\n去日梅开烂熳，归时秋满山川。\n京华倦客，难堪羁思，历尽愁边。\n寄语姮娥休笑，月圆人亦团圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44737,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"朝中措 其五 月季","author":"赵师侠","text":"开随律琯度芳辰。\n鲜艳见天真。\n不比浮花浪蕊，天教月月常新。\n蔷薇颜色，玫瑰态度，宝相精神。\n休数岁时月季，仙家栏槛长春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44738,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"朝中措 其二","author":"赵师侠","text":"疏疏帘幕映娉婷。\n初试晓妆新。\n玉腕云边缓转，修蛾波上微颦。\n铅华淡薄，轻匀桃脸，深注樱唇。\n还似舞鸾窥沼，无情空恼行人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44739,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"朝中措 其四 山樊","author":"赵师侠","text":"乱山春过雪成堆。\n七里递香回。\n蕊簇玲珑金粟，花装碎屑玫瑰。\n兰衰梅谢，桃粗李俗，谁与追随。\n清绝殿春仙侣，清风吹破荼蘼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44740,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"满江红 其二 辛丑赴信丰，舟行赣石中","author":"赵师侠","text":"烟浪连天，寒尚峭、空濛细雨。\n春去也、红销芳径，绿肥江树。\n山色云笼迷远近，滩声水满忘艰阻。\n挂片帆、掠岸晚风轻，停烟渚。\n浮世事，皆如许。\n名利役，惊时序。\n叹清明寒食，小舟为旅。\n露宿风餐安所赋，石泉榴火知何处。\n动归心、犹赖翠烟中，无杜宇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44741,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"满江红 其四 丙辰中秋定王台即席饯富次律","author":"赵师侠","text":"凉入三湘，秋气爽、江澄沙白。\n人欲去、离愁黯黯，莫留行色。\n盍在中朝陪鹓鹭，暂来南楚分风月。\n与元枢、鹗荐共扶摇，朝天阙。\n皇华使，和戎策。\n西府赞，中兴业。\n有缁衣同美，武公勋烈。\n樯燕已知添别意，骊驹谁为歌新阕。\n恨此情、如月过中秋，圆还缺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44742,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"满江红 其三 壬子秋社莆中赋桃花","author":"赵师侠","text":"露冷天高，秋气爽、千林叶落。\n惊初见、小桃枝上，盛开红萼。\n浅淡胭脂经雨洗，剪裁玛瑙如云薄。\n问素商、何事斗春工，施丹艧。\n芙蓉苑，颜如灼。\n曾暗与，花王约。\n要乘秋名字，并传京洛。\n回首瑶池高宴处，桂花香里骖高鹤。\n但莫教、容易逐西风，轻飘却。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44743,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"满江红 其五 丁巳和济时几宜送春","author":"赵师侠","text":"去去春光，留不住、情怀索莫。\n那堪是、日长人困，雨馀寒薄。\n叶底青青梅胜豆，枝头颗颗花留萼。\n叹流年、空有惜春心，凭春酌。\n歌共酒，谁酬酢。\n非与是，忘今昨。\n且随时随分，强欢寻乐。\n世事燕鸿南北去，人生乌兔东西落。\n问故园、不负送春期，明年约。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44744,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"满江红 其一 甲午豫章和李思永","author":"赵师侠","text":"渺渺春江，迷望眼、蒲萄涨绿。\n春过也、萧疏庭户，寂寥心目。\n念远不禁啼鴂闹，愁多易遣修蛾蹙。\n向小窗、时把彩笺看，翻新曲。\n晴昼永，便新浴。\n相思泪，不成哭。\n空无言憔悴，暗销肌玉。\n目断碧云无信息，试凭青翼飞南北。\n听掀帘、疑是故人来，风敲竹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44745,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]