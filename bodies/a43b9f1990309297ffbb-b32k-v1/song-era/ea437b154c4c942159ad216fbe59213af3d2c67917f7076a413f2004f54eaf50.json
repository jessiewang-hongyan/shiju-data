[{"title":"吊王卿之丧次韵","author":"楼钥","text":"去岁同登百尺楼，相期春晚更重游。\n舟藏大壑夜俄去，桥跨清溪花自流。\n五纪情亲真是梦，四山风物总成愁。\n一朝千古尚何及，空使文皇叹薛收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25009,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"吊陈卫道墓","author":"楼钥","text":"平生学博更加详，和会三家尽较量。\n一觉可怜成梦蝶，多岐终是易亡羊。\n门前修竹连岩桂，道上芙蓉间海棠。\n何似刬除闲草木，青松一色荫高冈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25010,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同王原庆知道游天童","author":"楼钥","text":"旧游曾记梦中身，一日重来白发新。\n行尽杉松三十里，看来楼阁几由旬。\n狎鸥亭外波澜阔，宿鹭池边草木春。\n自笑赋归如许久，始来此地作闲人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25011,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同年翁处度招游北山次韵","author":"楼钥","text":"不嫌屐齿碎莓苔，祇要吾人得得来。\n见说飞泉高落涧，待寻曲水作流杯。\n竹林素约群贤集，鸡黍相过一笑开。\n政恐清游自忘返，不应空棹酒船回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25012,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"吕崇德挽词 其二","author":"楼钥","text":"回首情亲处，相过濑水阳。\n十年能几见，一疾痛云亡。\n县郭山空秀，家园橘自霜。\n主人今已矣，鸥鹭亦凄凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25013,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"吕崇德挽词 其一","author":"楼钥","text":"剸剧推才刃，临机妙斲轮。\n传家得清白，满腹是精神。\n未上金闺籍，空留花县春。\n善人阳报在，兰玉正诜诜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25014,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"孙子才挽词","author":"楼钥","text":"身后名何用，人亡意愈深。\n盖棺悲昨梦，挂剑答初心。\n潜德仍能发，遗言尚可寻。\n悼元情更切，接陇柏森森。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25015,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"安人郑氏挽词","author":"楼钥","text":"勤俭佐家肥，犹齐举案眉。\n锦封俱被宠，鸾鉴可胜悲。\n谢砌森群玉，郤林先一枝。\n木华文隽丽，铭德粲堂碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25016,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"安行表兄除华文阁直学士奉祠次韵为贺","author":"楼钥","text":"屡报银台给事中，忽闻唤渡浙江东。\n长安幸免手遮日，圆峤莫嗟船引风。\n廪继真祠身暂逸，班联内阁眷方隆。\n且归同伴适斋老，便看锋车召此翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25017,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"安恭皇后挽词 其三","author":"楼钥","text":"玉胜标祥兆，祎衣配至尊。\n柔仪高马邓，盛德迈娀嫄。\n鸾掖空陈迹，霓轩服厚恩。\n伤心临七夕，素柰已花繁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25018,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"安恭皇后挽词 其一","author":"楼钥","text":"天作周文合，祎褕礼可观。\n屡陪金辇幸，几奉玉卮欢。\n吴女簪新柰，梁房掩旧兰。\n春深蚕事起，谁复上桑坛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25019,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"安恭皇后挽词 其二","author":"楼钥","text":"郁郁南山路，伤心凤翣红。\n哀歌凄薤露，秘殿掩椒风。\n故剑恩虽厚，中珰事已空。\n但馀彤史笔，内传纪阴功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25020,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"安恭皇后挽词 其四","author":"楼钥","text":"图史怀规鉴，篇章妙剪裁。\n承欢方秘殿，委化已泉台。\n幽壤湖滨秀，清笳日暮哀。\n未央当月望，不见翟车来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25021,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寻春次韵 其二","author":"楼钥","text":"晓来陌上雨斑斑，同社相将便出关。\n席地亦堪寻酒所，得园径与坐花间。\n从教多病须行乐，任是清贫也破悭。\n门外红尘深几许，谁人能得此身闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25022,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寻春次韵 其一","author":"楼钥","text":"一自东皇天上来，坐看芽檗起枯荄。\n化工潜有洪钧转，春事何劳叠鼓催。\n晚景鬓凋宁再绿，去年花谢又重开。\n赏花携酒那容缓，走遍郊原莫便回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25023,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戏咏戎葵簇成芍药","author":"楼钥","text":"回首向来婪尾春，横风吹尽已成尘。\n戎葵簇就谁尝巧，红药当前太逼真。\n观洧赠人迷冶子，翻阶得句误词臣。\n园丁妙手有如许，犹胜隋园剪綵人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25024,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戏和淳诗卷 其二","author":"楼钥","text":"山色蓝初染，湖光镜始磨。\n竹梢轻坠雨，花片乱随波。\n麈尾挥东晋，龙舟吊汨罗。\n莫愁春易老，畅饮一春多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25025,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戏和淳诗卷 其一","author":"楼钥","text":"琴弈心偏好，丹铅手自磨。\n衰翁会同社，吾子揖馀波。\n歌动玉条脱，酒倾金叵罗。\n好为文字饮，行乐未宜多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25026,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戏和淳诗卷 其四","author":"楼钥","text":"暮年甘散诞，壮志久消磨。\n自愧今摩诘，谁怜老伏波。\n清新惭庾信，敏慧谢甘罗。\n惟有诗情在，犹能益办多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25027,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戏和淳诗卷 其三","author":"楼钥","text":"澄江如练净，新月似镰磨。\n老柳飘轻絮，良苗飐细波。\n歌声追古郢，诗价怯新罗。\n到处还成醉，芳醪旨且多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25028,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戏题十四弦","author":"楼钥","text":"十四朱弦欲动时，泛商流羽看瑶姬。\n弦疏不隔如花面，声急还同堕马儿。\n溪蟹霜馀萦密网，檐蛛雨后理轻丝。\n曲终劝客杯无算，一吐空喉醉不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25029,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戏题胆瓶蕉","author":"楼钥","text":"垂胆新瓷出汝窑，满中几荚浸云苗。\n瓶非贮水无由罄，叶解流根自不凋。\n露缀疑储陶令粟，风摇欲响许由瓢。\n相携同到绿天下，别是闽山一种蕉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25030,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"早行","author":"楼钥","text":"水馀枯蘖尚栖苴，催促征夫趁晓鸦。\n细路缭山穿乱石，轻舆掠树得飞花。\n柔桑弥望两三里，修竹深藏四五家。\n径处不容行客恋，可怜一步一天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25031,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"曲竹","author":"楼钥","text":"放出一头地，出墙梢更新。\n傍人为称屈，素志肯求伸。\n苦节变甘节，曲身成直身。\n青霄看直上，莫忘手援人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25032,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"朱坡史居士挽词 其一","author":"楼钥","text":"岩邑富人物，才惟史氏多。\n流传有丹桂，遗逸叹朱坡。\n学饱终难售，诗成祇自哦。\n空馀著书在，令子挹馀波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25033,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"朱坡史居士挽词 其二","author":"楼钥","text":"交友俱名士，仪曹礼意周。\n使华临夏口，诗兴共南楼。\n喜得江山助，还同汗漫游。\n更烦贤宅相，相与发潜幽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25034,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"朱南剑挽词 其三","author":"楼钥","text":"棋战久不对，诗盟亦寖寒。\n方期会真率，乃尔变悲欢。\n岁晚本无憾，情深那忍看。\n佳城何处是，东望涕汍澜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25035,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"朱南剑挽词 其二","author":"楼钥","text":"朔望第一客，巡寮意更亲。\n有诗欣和韵，不饮喜娱宾。\n名帖藏中古，珍茶试早春。\n据鞍犹矍铄，何遽迹成陈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25036,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"朱南剑挽词 其一","author":"楼钥","text":"再世文章伯，三朝侍从臣。\n传家推笃学，游宦肯谋身。\n别驾歌章水，甘棠想剑津。\n虚堂两遗像，谁不倍伤神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25037,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"朱婺州挽词","author":"楼钥","text":"治行古循吏，风棱真谏官。\n锄奸清远徼，持重息群欢。\n久弄赵尧印，重弹贡禹冠。\n去天才尺五，惜不见长安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25038,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次许深甫寄陈颐刚韵 其一","author":"楼钥","text":"博物曾经辨实沈，论兵更觉用功深。\n九阍未进六奇计，万卷空催一寸心。\n流水高山谁复会，寒松春柳解相寻。\n如君岂是长贫者，作计无令岁月侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25039,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次伯舅汪运干所寄韵","author":"楼钥","text":"遥忆牢之舅，功名志欲成。\n离思满方寸，望眼费双明。\n揽笔四愁咏，登楼千里情。\n贤劳休自叹，幢下本书生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25040,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次李季章监簿韵","author":"楼钥","text":"跪履巽岩今几年，见君风度喜跫然。\n长编固已翻青简，老墨犹能宝漆烟。\n游宦自欣天影近，思家犹在夕阳边。\n时从甥馆追清赏，剩写新诗继谪仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25041,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次周益公韵 其二","author":"楼钥","text":"六一先生葛稚川，两孙俱并相君年。\n词场鏖战今成梦，潭府齐盟望若仙。\n政路三公旧同甲，洛阳四老信差肩。\n坊名丙午真奇事，写入诗编盍并传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25042,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次周益公韵 其三","author":"楼钥","text":"顷尝假守向中川，公在黄扉已数年。\n每念夔龙容接武，自期鸡犬亦登仙。\n入朝终叹一交臂，问道几思偏祖肩。\n数仞宫墙天样远，此心何日遂亲传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25043,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次周益公韵 其五","author":"楼钥","text":"舅甥相与老鄞川，况值慈亲九十年。\n画舫时追唐贺监，笋舆联访汉梅仙。\n官名自愧偶同辙，才望如何敢并肩。\n误辱品题称酷似，此声梁楚更堪传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25044,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次周益公韵 其四","author":"楼钥","text":"别驾归来自赣川，相迎方叹别经年。\n为言相国珠玑语，寄问祠庭山泽仙。\n妙句耸观亲盥手，满城争玩日骈肩。\n退怜母子方偕隐，却恐虚名似此传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25045,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次周益公韵 其一","author":"楼钥","text":"天将间气孕山川，名世还当五百年。\n已是有官居鼎鼐，不妨平地作神仙。\n书林尚欲校三豕，笔力犹能驱两肩。\n前日勋名身既退，斯文留与后人传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25046,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次南真宫龚道士壁间韵","author":"楼钥","text":"幽舍足留客，疏篁不用林。\n相过几樽酒，清坐一瑶琴。\n野鹤伴仙隐，閒云寄此心。\n黄冠如有许，来者为低簪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25047,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次病足韵","author":"楼钥","text":"定数无过偶与奇，达人处顺更安时。\n不于椿菌量长短，岂为彭殇较疾迟。\n虽是一时身有疾，行开九秩寿无期。\n外生六十头先白，杖屦相从最得宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25048,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵十诗 其五","author":"楼钥","text":"甥舅相寻向酒边，相忘情话更怡然。\n人言难遇双延阁，自愧叨联两大天。\n只觉光阴诗里过，何妨枕簟醉时眠。\n此中别有真消息，莫为人间醒者传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25049,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵十诗 其六","author":"楼钥","text":"从来忧道不忧贫，晚向闲中得此身。\n直把宦途如梦过，任他世事似棋新。\n坐间可说旧时话，眼底幸多同社人。\n赓唱本求闲燕乐，莫夸末路费精神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25050,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵十诗 其十","author":"楼钥","text":"秋到先生旧草堂，凉飙林叶已飘黄。\n渐看天宇清霜肃，更觉人家白昼长。\n历世既经三折臂，坐愁何必九回肠。\n世间万事消磨尽，祇有诗情未遽忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25051,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵十诗 其四","author":"楼钥","text":"幸堪击壤乐清时，衰病情怀百不宜。\n祇好灌畦陪汉叟，更欣学圃慕樊迟。\n逢人草草须倾酒，得韵匆匆且和诗。\n琴意高低尤自适，高山流水久心知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25052,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵十诗 其二","author":"楼钥","text":"秋来病体费支吾，深闭柴门卧草庐。\n药裹多寻医者问，酒樽寖与故人疏。\n时须勉强陪来客，未免辛勤答远书。\n此外儒生真气习，简编犹欲趁三馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25053,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵十诗 其三","author":"楼钥","text":"大率舟行岸自移，机缄何必更深思。\n雨馀坐见水三尺，云净喜看天四垂。\n荷沼已残霜后盖，桂林初绽月边枝。\n闲中气味深长甚，问却西风总不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25054,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵十诗 其七","author":"楼钥","text":"自怜鹤发奉慈亲，家舅还欣托宝邻。\n已向云间收倦翼，甘从波底作潜鳞。\n幸然松菊连三径，谁谓神仙隔一尘。\n野服相从成二叟，不须更现宰官身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25055,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵十诗 其一","author":"楼钥","text":"懒学仙家炼大还，但欣晚节在林间。\n鸳行免奏三千牍，驽驾难参十二闲。\n短艇有时浮渌水，轻舆到处赏佳山。\n莫言冷淡为生活，冷淡终然无后艰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25056,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵十诗 其九","author":"楼钥","text":"秋宵坐到玉绳低，历历明蟾数桂枝。\n重露半翻蕉叶径，好风时飐豆花篱。\n不妨起舞弄清影，何用撞钟夸小诗。\n浊酒困人垂欲睡，更揩病眼一扬眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25057,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵十诗 见客","author":"楼钥","text":"车辙长多长者临，相过肯笑席门深。\n寒暄固有三分话，臭味还倾一寸心。\n客至自应闲不厌，年来寖觉老难禁。\n应酬既了无馀事，面壁何妨学少林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25058,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵十诗 老态","author":"楼钥","text":"舅甥身退不为迟，肥遁犹当未老时。\n东晋虽惭古元亮，晚唐知慕老天随。\n公开九秩身方健，我甫六旬心已疲。\n不敢自言成酷似，腹心惟喜两相知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25059,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵十诗 西山","author":"楼钥","text":"两岸杉松翠荫长，轻舆连日得彷徉。\n绝怜林下朝还莫，不问人间炎与凉。\n睡起闲情方自乐，斋馀归路未须忙。\n何时更向月溪去，愿著青鞋走侍旁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25060,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵十诗 即事","author":"楼钥","text":"旋插杉枝蔽晓曦，缓摇轻箑自融怡。\n调琴不用求成曲，得句何须凑作诗。\n无复趋炎同褦襶，但能寻睡学希夷。\n太仓日食五升米，老矣不嫌人更嗤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25061,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵十诗 昼寝","author":"楼钥","text":"才尽甘为世所捐，不如高卧了馀年。\n时逢毁誉心无诤，间有诗文手自编。\n老去已知身是梦，闲来更得酒中天。\n帘深午寂浑无念，只与白鸥相对眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25062,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵十诗 读香山诗","author":"楼钥","text":"诗到香山不计篇，想逢佳处辄欣然。\n明知无子可传业，每遇为文自入编。\n举世慕名多讽诵，惟公著句得纯全。\n胸中相似诗方似，一等不为名利牵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25063,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵十诗 晨朝懒起","author":"楼钥","text":"坐见一翁双鬓皤，只赢晓梦到无何。\n窗凉风透真成适，日出事生还更多。\n足弱已难堪蜡屐，齿摇初不为邻梭。\n回思螭陛班心处，日日奔趋向馺娑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25064,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵十诗 其二 喜闲","author":"楼钥","text":"杜陵郑老共襟期，门外红尘弗与知。\n近日颇荒攻愧课，多时不见适斋诗。\n竹深荷净相留处，月白风清偶会时。\n地僻衣裳俱自懒，黄冠野服澹相宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25065,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵十诗 其一 喜闲","author":"楼钥","text":"投闲时以醉为乡，人既相忘我亦忘。\n雨足已期南亩熟，风清更爱北窗凉。\n昼观碧落云千叠，夜看中庭月一方。\n时援素琴聊自遣，谁能更作凤求皇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25066,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵十诗 棋会","author":"楼钥","text":"归来乡曲大家闲，同社仍欣取友端。\n无事衔杯何不可，有时会面亦良难。\n少曾环坐坐长满，赖有主盟盟未寒。\n琴弈相寻诗间作，笑谈终日有馀欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25067,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵五诗 其一 山行野老问年","author":"楼钥","text":"田夫笑把褐衣牵，争问壶中别有天。\n齿发虽衰浑未觉，精神愈胜果何缘。\n公言已老偶能尔，我本无心只自然。\n再祷百分才及一，定应椿寿八千年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25068,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵五诗 其二 坚郑贵温棋社","author":"楼钥","text":"二公休致我来归，尽可同裁隐士衣。\n此已屡谋登竹所，君其无吝造城扉。\n人间厌见手翻覆，乐处但当颐指挥。\n凉气一新宜近酒，盍簪莫似向来稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25069,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵五诗 其三 秋凉有感","author":"楼钥","text":"公看鱼跃与鸢飞，鹤胫虽长断则悲。\n世事不容人苦较，秋风自有叶先知。\n青奴难免交新绝，素扇宁须手自持。\n宋玉赋篇终未达，不如老子笑成诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25070,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵五诗 其四 谕悲秋者","author":"楼钥","text":"黄云万顷一时收，喜见高空风露秋。\n岁事及今将告毕，人生到老盍归休。\n固知景物能兴感，亦有痴人苦过忧。\n胸次果然无一累，岂容秋月使人愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25071,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵五诗 其五 舅甥赓酬之乐","author":"楼钥","text":"神明未觉晋公衰，老母尤欣兄弟怡。\n范宁王枕无许寿，牢之无忌不闻诗。\n秋风对酒劝酬处，夜月乘桥来往时。\n但要两家同此适，不须更遣外间知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25072,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵伯父与心闻偈","author":"楼钥","text":"法器何妨待晚成，一朝点铁便成金。\n拽开鼻孔力无限，坐断舌头功更深。\n扬子江头言在耳，灵山会上笑传心。\n自怜钝置无香气，四十年来只似今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25073,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]