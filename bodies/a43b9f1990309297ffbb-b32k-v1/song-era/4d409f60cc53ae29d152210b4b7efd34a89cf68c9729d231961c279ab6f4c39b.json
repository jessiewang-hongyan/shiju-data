[{"title":"王大卿挽词 其五","author":"楼钥","text":"上世总儒先，犹传梦雪篇。\n惟应佳婿选，可配老姑贤。\n父行偏知我，交情不问年。\n槁梧谁共语，愁断伯牙弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24941,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王大卿挽词 其二","author":"楼钥","text":"麾节东南半，澄清冠一时。\n权舆周翰传，顶踵阜陵知。\n自谓二宜去，人称三不欺。\n卷怀终未尽，流庆称家儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24942,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王大卿挽词 其一","author":"楼钥","text":"少壮节先著，年侵气不衰。\n忠虽由父教，清亦畏人知。\n处世无求合，安时竟数奇。\n甘泉人物会，一老汉空遗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24943,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王大卿挽词 其四","author":"楼钥","text":"老去王摩诘，归来道更全。\n剩添天美禄，真得地行仙。\n日欲增三径，君胡欠百年。\n桃源不无路，重上惨风烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24944,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王大卿挽词 其三","author":"楼钥","text":"图史但环堵，江湖几问津。\n虽多暮年乐，谁忍半生贫。\n海内清名满，毫端秀句新。\n风流嗟顿尽，晋韵更何人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24945,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王夫人挽词","author":"楼钥","text":"淑质依名士，身期百不忧。\n藁砧家万里，蓬首日三秋。\n随母传遗业，嵇孤托旧游。\n幽原诵诗传，无愧柏为舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24946,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王夫人挽词","author":"楼钥","text":"妇德胜贤士，嫠居成大家。\n阴功宜有后，馀庆尚无涯。\n杨恽出司马，陶潜传孟嘉。\n文昌纪遗范，外氏倍增华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24947,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王夫人挽词 其一","author":"楼钥","text":"阃内谁无助，夫人事特明。\n倾囊资色养，勉学就清名。\n遁世期高节，辞风叹落英。\n丁宁犹在耳，伉俪若为情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24948,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王观国挽词","author":"楼钥","text":"晚识三珠树，方知独笑翁。\n旧游亏半面，遗恨想高风。\n小楷墨犹湿，残膏泽未穷。\n梅花缟寒夜，埋璧众香中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24949,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王伯齐染髭","author":"楼钥","text":"垂髫相见舜江滨，荏苒俄惊过五旬。\n顾我颓龄真似叶，讶君长鬣亦如银。\n万金安得神仙药，一笑重回旧日春。\n纵使星星还复出，不妨时作少年人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24950,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王县尉挽词 其二","author":"楼钥","text":"润屋公馀事，能为人所难。\n蓼莪遗恨在，夜雨旧盟寒。\n家有书堪读，囊无钱为看。\n情亲悲不那，望绝旐飞丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24951,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王县尉挽词 其一","author":"楼钥","text":"干蛊恢才刃，谁能货殖私。\n人皆竞毫发，我独破藩篱。\n风雨空残梦，池台怆昔时。\n板舆临穴处，行道亦兴悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24952,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王忠文公挽词 其二","author":"楼钥","text":"梁木今其壤，谁能问大钧。\n恩深两宫赙，哀动四州民。\n已矣天人策，伤哉社稷臣。\n吾生良可耻，不及见斯人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24953,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王武陵挽词","author":"楼钥","text":"胡虏久未殄，功名谁与同。\n惟公负才气，遇事等英雄。\n井井清边琐，骎骎有父风。\n惜哉天不慭，遗恨渺无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24954,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王修撰挽词 其一","author":"楼钥","text":"十载频褰刺史帷，名卿风裁映绅緌。\n庆门共仰联三凤，禁路咸嗟欠一夔。\n神武衣冠终遂志，平泉花木总成诗。\n伤心积翠楼前月，斜入栏干欲向谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24955,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王修撰挽词 其二","author":"楼钥","text":"贱子何能直一钱，夫君于我独知怜。\n樽罍谈笑几侵夜，琴剑周旋不计年。\n此去空悬徐孺榻，重来无复孝廉船。\n百身愿赎嗟何及，衰涕满襟如迸泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24956,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王给事挽词 其三","author":"楼钥","text":"自忝年家好，居惭雌甲辰。\n宾兴蒙异奖，客授喜同寅。\n别去时无几，年来意益亲。\n囿山觞咏地，回首重沾巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24957,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王给事挽词 其二","author":"楼钥","text":"宦学素称豪，仍闻吏事高。\n精神虽腹满，抚字亦心劳。\n藩辅连三组，沉痾见二毛。\n胡床庾楼在，残月堕江皋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24958,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王给事挽词 其一","author":"楼钥","text":"主眷逢千载，宠光倾一时。\n铨曹著官簿，禁掖粲英辞。\n论议推东省，威声憺北夷。\n平生经世意，怀卷竟何之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24959,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王通判挽词 其一","author":"楼钥","text":"世笃青箱学，骅骝更著鞭。\n半山分近派，岩壑诵新篇。\n竹马迎双舄，棠阴忆二天。\n黄扉伸谠论，风节尚翘然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24960,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王通判挽词 其二","author":"楼钥","text":"才具盍时用，拂衣俄去之。\n善藏经世手，回施称家儿。\n嬴博延陵恨，人琴子敬悲。\n连年事如许，天道杳难知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24961,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王敏肃公挽词 其二","author":"楼钥","text":"贱子惭生晚，龙门莫问津。\n词场沾剩腹，政地仰洪钧。\n古栝杏坛旧，东嘉棠荫新。\n九京无馥作，知己更何人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24962,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王检正挽词 其一","author":"楼钥","text":"到处称循吏，星轺复郡侯。\n威名致降虏，恩信感亡牛。\n省闼主公议，祠庭寻旧游。\n善人天不慭，愁绝岘湖秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24963,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王检正挽词 其二","author":"楼钥","text":"客授蒙倾盖，朝参喜缀班。\n开藩才一水，去国遂千山。\n晚遇名方重，言归鬓未斑。\n功名付诸子，含笑谢尘寰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24964,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王提刑挽词 其一","author":"楼钥","text":"廉白真家法，原由金紫贤。\n兄辞岭南赙，弟却澧阳钱。\n筑屋吾将老，藏书手自编。\n老成俄已矣，闻者为潸然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24965,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王提刑挽词 其三","author":"楼钥","text":"二广外台首，威棱著一门。\n志期诸郡肃，忍见匹夫冤。\n奋系犹鹰鸷，兴谗有兔爰。\n投閒了无恨，此意与谁论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24966,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王提刑挽词 其四","author":"楼钥","text":"伯仲三珠树，优为一世才。\n人琴先起恨，金玉遂俱摧。\n南阮方深痛，阿连尤可哀。\n桃花源上路，老眼更堪开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24967,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王提刑挽词 其二","author":"楼钥","text":"籍甚青箱学，醇乎赤子心。\n片言皆可复，一伪不容侵。\n处事几游刃，论交欲断金。\n诸郎传素业，桂子看成林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24968,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王遂安挽词 其一","author":"楼钥","text":"淮水占王氏，生平熟义方。\n三珠欣竞秀，两桂蚤联芳。\n才大用何啬，源深流自长。\n青毡传令子，一箭取双鸧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24969,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"长生草","author":"楼钥","text":"玻璃擢叶玉蟠根，千里提携寄海滨。\n雨泽不沾仍自润，土膏无著自长春。\n岁寒秀色镇依旧，日暖素英能一新。\n我欲饵之求久视，恐君灵己不灵人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24970,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"丘文定公挽词 其五","author":"楼钥","text":"同与隆兴第，嘉禾见两轓。\n瀛壖迂使节，蜀道送行轩。\n预草前须诏，惊传易箦言。\n不堪鸾镜舞，双旐怆丘原。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24971,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"丘文定公挽词 其一","author":"楼钥","text":"谋国规模阔，绝人才具高。\n三朝千载遇，四海一身劳。\n儒将通鸳序，枢庭握豹韬。\n皇家资柱石，天遽夺伊皋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24972,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"丘文定公挽词 其二","author":"楼钥","text":"初拟文翁化，谁知怀远图。\n庙谟专制阃，世将易兵符。\n养虎竟遗患，断蛇由不殊。\n宁同死诸葛，空恨失吞吴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24973,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"丘文定公挽词 其三","author":"楼钥","text":"十载庞居士，一朝裴晋公。\n宣威先抗虏，决策竟和戎。\n宥密行谁尼，规恢事已空。\n灰心更霜鬓，千载泣英雄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24974,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"丘文定公挽词 其四","author":"楼钥","text":"处事拘挛外，锄奸谈笑中。\n几年亡主将，全蜀赖明公。\n畏爱盾衰日，清和夷惠风。\n屡书终不尽，诗意亦何穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24975,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东谷","author":"楼钥","text":"旧说东柯谷，兹来到此山。\n树深烟冉冉，花落雨潺潺。\n有客礼师塔，何人叩祖关。\n天连秋水远，此意尚人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24976,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"令人王氏挽词 其二","author":"楼钥","text":"宦达方资助，家肥忽悼亡。\n一区终异室，千载尚高冈。\n奉倩神犹惨，安仁鬓欲苍。\n黄昏愁绝处，谁伴紫微郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24977,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"令人王氏挽词 其一","author":"楼钥","text":"嫁早仍知孝，夫贤自不贫。\n事姑如事母，忧物胜忧身。\n凤诰恩荣渥，鸠桑德意均。\n孺哀声不绝，泪柏不成春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24978,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"兰亭别丁杲卿","author":"楼钥","text":"山阴岩壑妙人寰，十载扁舟空往还。\n赞府端能慰牢落，连朝相与上孱颜。\n龙盘凤翥无奇画，霞蔚云蒸有旧山。\n吊古凄凉更离别，满怀秋思到眉间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24979,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"北行雪中渡淮","author":"楼钥","text":"风捲清淮夜不休，晓惊急雪遍郊丘。\n坐令和气三边满，便觉胡尘万里收。\n瑟瑟江头辉玉节，萧萧马上点貂裘。\n归来风物浑相似，二月杨花绕御沟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24980,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"史清翁谈诗走笔次韵","author":"楼钥","text":"公退门庭静，轻风辊絮毬。\n故人惊一见，小酌散千忧。\n西上不容久，东归又别愁。\n何当附舟尾，从此遂归休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24981,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"史敷文挽词 其二","author":"楼钥","text":"学问源流远，乐哉贤父兄。\n人琴亡旧曲，风木怆寒声。\n深痛几成毁，沉痾汔丧生。\n孝恭无可憾，犹得傍佳城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24982,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"史敷文挽词 其一","author":"楼钥","text":"八行诸孙盛，三公嗣子贤。\n连收四鹗荐，祇欠一青毡。\n郎省刑章肃，侯邦政誉传。\n平生忧国意，赍志入重泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24983,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宁海刘君挽词","author":"楼钥","text":"不识紫芝眉，空传有道碑。\n义方真可法，闇室肯容欺。\n未觉山川改，深明昼夜知。\n薤歌惭不称，冢子素能诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24984,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宁海骆君挽词","author":"楼钥","text":"古易人皆学，惟君志益坚。\n研朱滴秋露，读简断韦编。\n空谷甘无用，佳儿尚有传。\n清风谁得似，竹满卧床前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24985,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"永嘉天庆观","author":"楼钥","text":"斗口横安华盖山，茂林修竹路湾环。\n琳宫迥出沧瀛表，羽士如游昆阆间。\n东挹江山穷望眼，西临阛阓笑尘寰。\n自知去此无多日，著意来寻一饷閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24986,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"永嘉试院谢曾使君送酒 其二","author":"楼钥","text":"脱身场屋几春秋，故步重寻我自羞。\n闭置有如三日妇，画成应遣一生愁。\n与钱谁是老司业，送酒更无贤郡侯。\n掩卷出门花下坐，真成一酌散千忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24987,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"玉堂早起","author":"楼钥","text":"早起多奔走，旬休亦往还。\n偶因二士试，始得一朝閒。\n灵鹊花枝上，金鱼荇蒂间。\n素餐终有愧，只忆旧家山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24988,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"石南康挽词 其三","author":"楼钥","text":"伊昔为君御，儒流赖主盟。\n执经容后进，倾盖若平生。\n坐见埋黄壤，空劳望赤城。\n友朋相与泣，反袂不胜情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24989,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"石南康挽词 其一","author":"楼钥","text":"挺挺石可转，恂恂衣不胜。\n平生忧国志，长夜读书灯。\n大易窥三古，中庸进百能。\n惜哉天不慭，无复见川增。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24990,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"石南康挽词 其二","author":"楼钥","text":"家有春秋学，渊源更得师。\n风高盖公舍，泪落蔡邕碑。\n官早终难进，才全竟弗施。\n遗编属贤子，孝谨不应衰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24991,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"石通直挽词","author":"楼钥","text":"籍甚新昌族，真成万石家。\n源流端有自，悃愊更无华。\n奉职冰同洁，持身璧不瑕。\n庆门传未艾，兰玉茁新芽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24992,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"龙湫","author":"楼钥","text":"地耸峰峦秀，天开气象宽。\n九霄银汉落，千古玉龙寒。\n壮观供尊者，幽居称冷官。\n何时遂肥遁，不厌白头看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24993,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"仲观有诗来谢次韵","author":"楼钥","text":"危机屡见剑头炊，喜及挂冠神武时。\n从此含藏三寸舌，算来插得几张匙。\n读书窗下病勤旧，攻愧庵中老住持。\n速办小舟频往反，及今精力未全衰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24994,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"仲舅敷文阁学士汪公挽词 其一","author":"楼钥","text":"籍甚牢之舅，难追宅相风。\n惟公能爱我，独我最知公。\n潭府书无继，西州事已空。\n形容尽心力，庶或慰幽宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24995,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"仲舅敷文阁学士汪公挽词 其二","author":"楼钥","text":"外氏桂成丛，诸甥长养中。\n名称无酷似，宦达偶相同。\n澹室既长往，适斋俄考终。\n绝怜三学士，只剩一衰翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24996,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"伍主簿挽词 其三","author":"楼钥","text":"晚年朋旧益彫零，叹绝斯人奠两楹。\n不忍衔悲读佳传，可堪回首念平生。\n交情君独全终始，人物谁能继老成。\n清些楚魂招不得，朔风凄切泪纵横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24997,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"伍主簿挽词 其一","author":"楼钥","text":"好贤元不减缁衣，客到公家如所归。\n二浙声名三鹗荐，四山风物一翚飞。\n桑榆冉冉身先蜕，兰玉森森家正肥。\n人有百身宁可赎，发棠谁复济齐饥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24998,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"伍主簿挽词 其二","author":"楼钥","text":"由来风谊独穹然，坐享家肥不计年。\n堕帻何妨分百万，指囷宁复问三千。\n灵椿老去仁宜寿，玉树种成身已仙。\n衮衮公侯殊未已，正应含笑入重泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24999,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再过鹿伯可","author":"楼钥","text":"又上先生见一堂，澹然宾主两相忘。\n不知海内清风满，但觉山中白昼长。\n小雨络林妨蜡屐，靓妆环坐快瑶觞。\n曲终扶杖欲归去，即咏白驹三四章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25000,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"刘吏部挽词 其一","author":"楼钥","text":"总角异群儿，庭趋蚤学诗。\n一鸣登桂籍，百里静潢池。\n所至清民瘼，平生号吏师。\n郎闱方进用，何乃弃明时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25001,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"刘吏部挽词 其四","author":"楼钥","text":"兄长与慈恩，相亲色笑温。\n公方持使节，余忝代王言。\n共约游三径，俄悲作九原。\n佳城隔风浪，丹旐怆飞翻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25002,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"刘吏部挽词 其三","author":"楼钥","text":"谁扰奚山众，焚林兽已穷。\n徙薪能远虑，下濑得深攻。\n南峤肩随息，中朝论愈公。\n但知分谤喜，宁肯自论功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25003,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"刘吏部挽词 其二","author":"楼钥","text":"剸剧最云间，题舆上越山。\n洞庭王泽远，庾岭使星还。\n中道趋台治，名曹切近班。\n阴功多及物，阳报看循环。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25004,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"刘德修右史去国示所和从父东溪及杨子直诗走笔次韵 其三","author":"楼钥","text":"阁下相期久，山中把酒稀。\n未能容我去，又复送君归。\n柱史宁终隐，威颜暂咫违。\n壮心谁与语，看剑一灯微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25005,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"刘德修右史去国示所和从父东溪及杨子直诗走笔次韵 其二","author":"楼钥","text":"东溪诗似老弥明，倾盖论诗绝点尘。\n笔墨为供无尽藏，江湖乞得自由身。\n出门远送成惆怅，无计相留更主臣。\n但愿皇天开老眼，不应空谷滞斯人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25006,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"刘德修右史去国示所和从父东溪及杨子直诗走笔次韵 其一","author":"楼钥","text":"无人为辨乐羊书，却向空山问草庐。\n世上荣枯无定在，眼前毁誉竟何如。\n寸心未彻九重上，百口仍行万里馀。\n只恐君王思旧学，便看飞诏促严徐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25007,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"刘德脩赴遂宁示和篇改除荆南复寄之","author":"楼钥","text":"老矣思归铗屡弹，七旬望八合抛官。\n我将东去计安出，君欲西还事亦难。\n好向渚宫寻故迹，更从雄楚纵遐观。\n上游正倚公为重，莫向蓬溪更上滩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25008,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]