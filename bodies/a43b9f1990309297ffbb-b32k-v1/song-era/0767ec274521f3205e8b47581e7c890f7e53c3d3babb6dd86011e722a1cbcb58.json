[{"title":"别黔中赵尉","author":"阳枋","text":"好风吹雪点征衣，认得东君巧转机。\n北渚燕鸿从背立，前滩鸂鶒喜双飞。\n梅中有味不妨隐，莲本无心何待依。\n到处江山生意满，呼尊判倒是和非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40904,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿邓提干母 其一","author":"阳枋","text":"争似瑶仙捧玉觞，一堂四世聚簪裳。\n閒中尊俎江山久，静里襟怀日月长。\n蓂紫烂连庭桂紫，橘香浓引诰花香。\n陵溪种得桃无限，乞与渔郎半核尝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40905,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿邓提干母 其二","author":"阳枋","text":"尝桃不祇似东方，三度浓熏竹院香。\n眼底儿孙青琐客，镜中颜色碧琳房。\n山屏绣出方壶稳，峡线拖馀翠水长。\n醉问群仙休拍手，谁人翻得九霞觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40906,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿刘节判","author":"阳枋","text":"昨夜天香两袖中，转头人日又桑蓬。\n云龙风虎千年遇，圣主贤臣此际同。\n翠竹西来方嫩绿，夭桃栽后未繁红。\n人间正喜洪钧转，莫问天台有路通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40907,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿张方叔表弟","author":"阳枋","text":"闻说书台百世张，燕山来数窦家郎。\n含容寸念侔焚券，正直生平等发藏。\n丹桂香浮森驷马，碧梧翠织引双凰。\n松萝岁晚陪真喜，染得卿云烂有光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40908,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿绍庆王守谨礼","author":"阳枋","text":"燕寝凝香事自无，祝釐何用饮酴酥。\n裤歌雪外暖传曲，社酒人间春满壶。\n客到竞誇逢子晋，我来甚喜见夷吾。\n摩围山下閒摩诘，他日添归九老图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40909,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿绍庆金守","author":"阳枋","text":"神光高射斗牛墟，知是龙泉瑞气舒。\n彩映北堂霜后桧，辉连东馆月中书。\n江流丽水描来似，峡束棠溪画得如。\n为报鲸鲵休陆走，剑芒元是发硎初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40910,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿涪州李汉辅使君","author":"阳枋","text":"见得州如斗大轻，閒将五马系榕阴。\n两江波上千家月，万卷堂中一片心。\n尚笑龚黄为计浅，更寻伊洛问钩深。\n莫悭仙李盘根实，可与轻红种作林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40911,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和王季行制干昌溪即事 其一","author":"阳枋","text":"异境破清愁，狂吟日点头。\n前峰方极目，远岭又迎眸。\n石乱屡支舫，滩高常负舟。\n心亨行有尚，习坎自安流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40912,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和全父弟立秋喜雨","author":"阳枋","text":"造化仁民意，潇潇夜雨声。\n焦原欣得润，枯黍喜更生。\n染出林阴密，濯馀天气清。\n秋河从此挽，尽洗北来兵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40913,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和杨提刑喜雨 其一","author":"阳枋","text":"蝼蚁何能格上穹，况于三伏蕴隆中。\n瓣香载走神龙庙，法象俱来大梵宫。\n出岫金身能普济，临池玉醮可幽通。\n尚凭使者疏冤狱，歌舞丰年与众同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40914,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和苏提举喜雨 其一","author":"阳枋","text":"瞻仰虽勤隔壤穹，此诚何自达天中。\n幸凭今日皇华使，不假当年帝释宫。\n人道苏天真广大，岁逢商旱得流通。\n欲知八郡生灵喜，七月兴歌我稼同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40915,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和苏提举喜雨 其二","author":"阳枋","text":"皇上焦劳冠百王，精求肤使惠南方。\n驱驰靡惮周原隰，敛散尤高汉寿昌。\n属邑近方忧水涝，单车不复待秋凉。\n公馀更有惊人句，为解尘怀倥偬装。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40916,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和陈提举喜雨 其一","author":"阳枋","text":"愁叹何繇达灏穹，秋成恐堕渺茫中。\n五龙偃蹇藏深庙，六佛慈悲会一宫。\n帝敕名山诸洞闭，醮开太乙独函通。\n应怜赤子车中鲋，为激西江遍处同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40917,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和陈提举喜雨 其二","author":"阳枋","text":"周家重谷业陈王，天亦哀民救此方。\n一雨如倾过众望，三登可卜见时昌。\n固知福地长无歉，尤喜炎天预借凉。\n耆老首为乡曲贺，唾成珠玉巧于装。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40918,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三和知宗喜雨 其二","author":"阳枋","text":"江海人推百谷王，可无膏泽惠炎方。\n五龙行水苏将槁，万顷秧田喜寖昌。\n不用饮冰祛内热，急须沽酒做新凉。\n却愁好雨催诗句，愧乏良材取次装。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40919,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和桃源宰赵存礼韵","author":"阳枋","text":"三时不害试鸠工，筑凿轮舆职自攻。\n利器祇因盘错见，淳风须信古今同。\n野桃川谷逢人好，春草池塘待雪融。\n洞口果教花似旧，支筇未肯作衰翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40920,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和黄循斋送景正辅户曹之夔三首 其三","author":"阳枋","text":"浅见论成败，先几烛是非。\n端倪还眇眇，勋绩自巍巍。\n学僻门常掩，诗枯毫懒挥。\n何时住岩下，质问此心微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40921,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和黄循斋送景正辅户曹之夔三首 其二","author":"阳枋","text":"自脱樊笼役，潜心克己私。\n是求从此日，非莫问前时。\n郡改山元在，江流石不移。\n人心日澜倒，先觉仰扶持。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40922,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和黄循斋送景正辅户曹之夔三首 其一","author":"阳枋","text":"要路倦登临，渊明径好寻。\n卷收名利帜，揭示圣贤心。\n月使千家满，霜从两鬓侵。\n逃空三峡客，属耳听蛩音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40923,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"咏黄池诗","author":"阳枋","text":"姑苏平野入黄池，烟树重重绿涨迷。\n肆列门前喧坌俗，稻临屋背尽幽栖。\n路长车马南还北，水远帆樯东复西。\n小寺江心閒系缆，周回看尽柳盈堤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40924,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庚子叨第贽合州甘守 其一","author":"阳枋","text":"吴门捍蔽重夔渝，两地藩篱属钓鱼。\n自昔无城当蜀屏，从今有柱壮坤舆。\n军心铁石高深里，敌胆灰尘筑凿馀。\n看偃天戈閒夜月，朗声读破磨崖书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40925,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍庆罗巡检","author":"阳枋","text":"蕉溪烟水似罗浮，君著轩亭瞰碧流。\n东馆听鸡书伴月，南边休马铎沈秋。\n怜人得饱仓捐粟，送客登山岸倚舟。\n种玉前村春意早，梅花带雪满枝头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40926,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"癸亥守岁聪儿桃源黄溪村居 其二","author":"阳枋","text":"今年爆竹楚江滨，别岁迎春仅隔辰。\n小筑地偏聊尔尔，幽居心远自申申。\n儿从豹变当斯世，我得鸥閒着此身。\n学易假年天若许，横书长作傍梅人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40927,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"癸亥守岁聪儿桃源黄溪村居 其一","author":"阳枋","text":"贪看子舍筑溪滨，屈指除宵又及辰。\n七八再逢新甲子，十三重记旧庚申。\n一杯春酒红衰脸，四世斑衣悦老身。\n爆竹声听桃洞晓，举家疑是避秦人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40928,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺田都统再帅夔 其一","author":"阳枋","text":"十乘由夔入钓鱼，饮江无马雁安居。\n瞿唐催要金城壁，即墨争迎铁裹车。\n八阵旌旗蛇势整，九关风月虎符虚。\n白盐万丈齐天石，揭日奇功大字书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40929,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺李万州守夔 其二","author":"阳枋","text":"渊渊圣道浩津涯，万里寻师暮景斜。\n滥吹丛中情懒散，弹冠镜里发爬髿。\n苍龟已卜林间屋，青犊还逢关上车。\n未得乞符求换骨，借閒读易傍梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40930,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赴大宁司理贽俞帅 其二","author":"阳枋","text":"入手青衫愧壮颜，悠悠底事白云閒。\n有心文字几千卷，适意茅茨三两间。\n可奈红尘飞白羽，不容黄叟卧青山。\n欲从宁水成仙骨，趁得先生未出关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40931,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赴大宁司理贽俞帅 其一","author":"阳枋","text":"见说三关息虎貔，风高白帝卷旌旗。\n擎天砥柱瞿唐险，保蜀规模阵石奇。\n誓出祁山禽仲达，肯屯汉口学姜维。\n枕戈心事闻鸡起，未必閒眠听竹枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40932,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送田使君都统离夔赴合州","author":"阳枋","text":"英雄才略暂临夔，泛绿依红诧小儿。\n肯向稠人识毛遂，甘从走督得神师。\n鱼城人喜景星出，象滪猿惊仙仗移。\n七十老翁怕趋走，峡江亭上倍临歧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40933,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽心友李应之判县 其一","author":"阳枋","text":"书剑追随遍蜀西，归来窗月听朝鸡。\n相期岁晚林中约，忍见佳城石上题。\n锦里人稀烟冉冉，横川路迥草萋萋。\n黔南愧我催瓜戍，泪落巴山望欲迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40934,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽心友李应之判县 其二","author":"阳枋","text":"妙岁麟经得兴微，名成四十壮心违。\n半生于德归门驷，一节夷清在首薇。\n古礼事亲轮月晓，新诗易箦片云飞。\n九京他日如堪作，见说非公谁与归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40935,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽伏德华主簿 其一","author":"阳枋","text":"黉堂深惜昔，六典共寻源。\n合遂齐飞鹗，嘉逾竞化鹍。\n红颜君早去，白发我空存。\n方寸千年事，悽然谁与论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40936,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽何深甫","author":"阳枋","text":"羡君底事过时人，一点閒愁不到心。\n笑语屡陪桃李酒，诗书曾对竹松林。\n已惊别鹤江天远，何事骑鲸岁月侵。\n五桂联芳知有日，去寻萧侣碧云深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40937,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽武龙蹇巡检 其一","author":"阳枋","text":"仁者寿宜得，王臣忠可嘉。\n功名虽有约，云月自为家。\n义粟饥中粜，慈梁雨后斜。\n百年回首处，溪冷欲梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40938,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽南平赵化卿","author":"阳枋","text":"昔游曾到万山峰，赵氏楼台紫翠中。\n六艺近誇三世学，四贤争显一家风。\n不堪顾影怜孤雁，恰喜摩天有阿鸿。\n好是生香元不断，灵椿虽老桂成丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40939,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽垓山陈宣义","author":"阳枋","text":"升堂曾得话从容，骨相清癯七十翁。\n唧唧爱人皆语妙，迟迟留客屡杯空。\n眼分青白斯文外，手作推敲雅咏中。\n我忝金兰三世契，颇堪溪浒忆清风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40940,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽故人 其一","author":"阳枋","text":"公生百载下，学契五峰心。\n崇鼎屹重器，洪钟希太音。\n词源擅翻海，句律善舂金。\n材古谁人识，清歌和惨吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40941,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽故人 其二","author":"阳枋","text":"卓世轻财易，悬知种德难。\n有贫皆粟帛，无骼不衾棺。\n红树悲春早，孤松忍岁寒。\n轻飔生宰木，多少鼻成酸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40942,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽赵飞卿","author":"阳枋","text":"万翠亭边山郁葱，书声散出五云重。\n红萱色改宦情薄，绿酒杯深客话浓。\n雁起秋空从整整，鸥閒野水自溶溶。\n谁人为作坡仙传，弟似颍滨文似邕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40943,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽黄循斋 其二","author":"阳枋","text":"忆昔论文友，如今舐鼎仙。\n周经谈正印，易学话真传。\n一乐堂中语，三生石上缘。\n莲峰望昆岳，惆怅白云连。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40944,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽黄循斋 其一","author":"阳枋","text":"桂剩炉峰月，香飘字水春。\n姓名天下客，抱负洛中人。\n膴仕方三纪，徂年未六旬。\n循斋馀售用，何必叹穷民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40945,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读易书怀","author":"阳枋","text":"家家住坐长安道，日问长安何草草。\n春到骊山渭水深，拂石临流苦不早。\n万户千门镇日开，无边风月随人好。\n满城花柳断莺肠，芳菲易歇天难老。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40946,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贽何总领","author":"阳枋","text":"中兴赋用倚江淮，兼裕良筹仰隽才。\n民社有歌耕足雨，伍符无腹隐枵雷。\n塞边粟积汉而上，地上钱流唐以来。\n相业理财馀事耳，安能郁郁此居哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40947,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贽赵广安","author":"阳枋","text":"先生早矣袖薰弦，趁取南风入皛然。\n燕稳不妨辞阃幕，鱼枯应喜活民编。\n万家吟赏知微月，千里依栖刺史天。\n河汉定应思黼黻，大宗宁许久藩宣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40948,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贽袁茶使","author":"阳枋","text":"天隅把袖立春风，井络民情许上通。\n煖到夜郎安静里，寒消白帝抚摩中。\n摘山岂必溪芽尽，市骏何须冀种空。\n月渚扁舟书好读，琅琅声与大江东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40949,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贽鄂帅张仁简 其二","author":"阳枋","text":"不为名缰浪出山，朱门桃李恐阑珊。\n师寻湖海胸怀阔，道满乾坤耳目宽。\n水驿已终三楚尾，天阍犹向五云端。\n登楼便欲骑黄鹤，乞与书生换骨丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40950,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄桃源尉赵谦之","author":"阳枋","text":"桃源洞口送春归，欲换渔蓑傍钓矶。\n火着高林鸦又散，弦鸣中泽雁还飞。\n萧萧空雨晨光润，耿耿笼灯夜色微。\n休对痴人呆说梦，野花啼鸟恁天机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40951,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"曹都统诗","author":"阳枋","text":"胸中陈法久堂堂，卯岁边戎真漫狂。\n伫看胜齐归一鼓，未饶破魏说三当。\n弓刀早落风云会，衮绣行依日月光。\n已撰磨崖碑万字，为君题破碧苔苍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40952,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谒同年许使君德开 其二","author":"阳枋","text":"欲造诗坛夺锦标，几回蹑足愧还休。\n君提妙律都先手，我漫家吟浪出头。\n济世自怜无绝力，叩阍刚道有嘉猷。\n先生若动出关兴，便尔挑包逐去舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40953,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谒夔门桂帅 其二","author":"阳枋","text":"志欲商伊学欲颜，寻师梦绕五湖间。\n不违誓至仁三月，亲炙宁辞雪万山。\n流海浪浮蜗战角，排云应许豹窥斑。\n还丹知换尘凡骨，趁得先生未出关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40954,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜雨贺黄叔厚判县","author":"阳枋","text":"去年精祷雨随至，今日熏香雨便来。\n人事只从无伪见，天心端可至诚回。\n溜匙即此知翻雪，枵腹何由更隐雷。\n若使边臣充此意，凶残到处岂难摧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40955,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"遣季子寿黄循斋二首 其二","author":"阳枋","text":"自得遗书学子房，拟来辟谷并山阳。\n仙乡不秘眼前道，俗相惭无肘后方。\n经叶再传新雨露，桃花重发旧门墙。\n呼儿莫怕蓬莱远，勤爇南丰不尽香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40956,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"遣季子寿黄循斋二首 其一","author":"阳枋","text":"五峰高处五云新，黄石先生非避秦。\n圯上未容书出袖，岩前元自易无尘。\n烟霞窟冷苦留客，云雾窗虚亦可人。\n好为苍生彻蒸暑，天边散与一襟春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40957,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"瞿唐峡","author":"阳枋","text":"壁绝昼昏明，猿高髣髴音。\n不关天宇窄，自是峡流深。\n既晓迟朝日，未西还夕阴。\n扁舟平涉险，凭取有孚心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40958,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与存子侄王南运上风联句","author":"阳枋","text":"舟行缓东去，波蹙疑西流。\n尘扬频闭目，草偃付回眸。\n翩翩溯岸鹭，缓缓沿波鸥。\n聚沱留积滓，逆浪集浮沤。\n门窥雨斜入，窗望山相留。\n棹苦掌痕肿，烟回眦泪浮。\n客舟上急急，我楫去悠悠。\n一程分两日，半月仅三州。\n仆嗔粮易竭，客怨利难谋。\n柁斜横水面，人宿避沙头。\n啸想武陵虎，化催西海虬。\n欲寄风伯语，聊以吾诗投。\n何如还借顺，咫尺登瀛洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40959,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中秋黄池舟中独酌五首 其五","author":"阳枋","text":"一年十二月华圆，何事今宵到处看。\n春夏暖时无底白，雪霜凝处不胜寒。\n酒肠缓放金樽倒，诗兴何妨玉漏残。\n莫学时人贪酩酊，清光未澈已阑单。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40960,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中秋黄池舟中独酌五首 其四","author":"阳枋","text":"居家赏月天常雨，远客逢秋月倍明。\n世事美时难两得，化工好处少双成。\n诗如遇兴须重赋，酒若逢辰且再倾。\n不是衰迟废拘检，良心随寓自忘情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40961,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中秋黄池舟中独酌五首 其一","author":"阳枋","text":"秋深客棹倚吴头，喜见江乡素月浮。\n水墨画成洲渚远，神仙宅尽水云幽。\n心閒最与趣相会，句拙常怜景莫收。\n多少楼台罗绮席，未知真是赏中秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40962,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"云山避地","author":"阳枋","text":"依山茅屋两三间，与世相遗尽日閒。\n背拥蓝屏半天碧，面对参差横架山。\n径草蒙头云覆屋，泉甘土肥似盘谷。\n剑峰林密杳无边，绵峡潭深幽莫烛。\n有鲜可食美可茹，康乐和平长自饫。\n有时拂石弄泉声，有时策杖登山去。\n山中日沈山月出，岩暝林晦总佳适。\n平石如台倚山隈，准拟结茅閒读易。\n尚论古人得我心，商傅周姜汉子陵。\n好共栽桃艳长春，却恐渔父来相寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40963,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"少年看花行寄示谊儒侄","author":"阳枋","text":"少年看花日千遭，黄金买笑侠气豪。\n盏斟西凉绿蒲萄，燕歌赵舞纷绮罗。\n插花上马玉颜酡，鞭马如风花底过。\n九天阊阖手可摩，扬眉不怕金吾诃。\n杜鹃一声啼山阿，门掩绿苔愁秦娥。\n春树红颜能几何，万里封侯成蹉跎。\n河南布衣正婆娑，却笑因风想玉珂。\n未肯岩前扪翠萝，商丘不唱采芝歌。\n独深于易如邹轲，紫阳真人声相和。\n莲荡归来扬其波，我傍梅花读遗书，不知纷纷坐久落花多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40964,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]