[{"title":"晚春二首 其一","author":"范成大","text":"静极闻檐佩，慵来爱枕帏。\n隙虹飞永昼，帘影碎斜晖。\n燕踏花枝语，蜂萦柳絮归。\n轻飔宜白纻，时节近清微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32836,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚登木渎小楼","author":"范成大","text":"万象当楼黼绣张，阑干一士立苍茫。\n云堆不动山深碧，星出无多月淡黄。\n宿鸟尽时犹数点，归鸿惊处更斜行。\n松陵政有鲈鱼上，安得长竿坐钓航。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32837,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚集南楼","author":"范成大","text":"浪随儿女怨萍蓬，笑拍阑干万事空。\n宇宙勋名无骨相，江山得句有神功。\n掉头莫觑秋高鹗，留眼来宾日暮鸿。\n懒拙已成三昧解，此生还證一圆通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32838,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晨出蒋山道中","author":"范成大","text":"霜痕如雨沁东郊，乐岁家家一把茅。\n故国丘陵多麦垄，新晴篱落有梅梢。\n小山何在应招隐，北岭如今已献嘲。\n归计未成聊琢玉，飘飖风袖作推敲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32839,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"望金陵行阙","author":"范成大","text":"圣代规模跨六朝，行宫台殿压金鳌。\n三山落日青鸾近，双阙清风紫凤高。\n石虎蹲江蟠王气，玉麟涌地镇神皋。\n太平不用千寻锁，静听西城打夜涛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32840,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅林先生夫人徐氏挽词二首 其二","author":"范成大","text":"昔簉鲤庭后，尝瞻林下风。\n一从随地远，五度阅星终。\n教载恩勤在，惊呼梦幻空。\n送车知几两，独欠旧孤童。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32841,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅林先生夫人徐氏挽词二首 其一","author":"范成大","text":"择对鸣珂里，宜家驷马门。\n肃雍成孝敬，燕喜助平反。\n阅世弥三寿，还乡忽九原。\n松风摇草露，愁绝后堂萱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32842,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅根夹","author":"范成大","text":"辛苦凌波棹，平安入夹船。\n日明渔浦网，风侧瓦窑烟。\n老圃容挑菜，村巫横索钱。\n且投人处宿，终夜得佳眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32843,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"检校石湖新田","author":"范成大","text":"今朝南野试开荒，分手耘锄草棘场。\n下地若干全种秫，高原无几谩栽桑。\n芦芽碧处重增岸，梅子黄时早浚塘。\n田里只知温饱事，从今拚却半年忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32844,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"淳熙甲午桂林鹿鸣燕辄赋小诗少见劝驾之意","author":"范成大","text":"维南吾国最多儒，耸看招招赴陇书。\n竹实秋风辞穴凤，桃花春浪脱渊鱼。\n月宫移种新栽桂，江水朝宗旧凿渠。\n况有状头坊井上，明年应表第三闾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32845,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清明日试新火作牡丹会","author":"范成大","text":"再钻巴火尚浮家，去国年多客路赊。\n那得青烟穿御柳，且将银烛照京花。\n香鬟半醉斜枝重，病眼全昏瘴雾遮。\n锦地绣天春不散，任教檐雨捲泥沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32846,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清明日狸渡道中","author":"范成大","text":"洒洒沾巾雨，披披侧帽风。\n花燃山色里，柳卧水声中。\n石马立当道，纸鸢鸣半空。\n墦间人散后，乌鸟正西东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32847,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鄂州南楼","author":"范成大","text":"谁将玉笛弄中秋，黄鹤飞来识旧游。\n汉树有情横北渚，蜀江无语抱南楼。\n烛天灯火三更市，摇月旌旗万里舟。\n却笑鲈乡垂钓手，武昌鱼好便淹留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32848,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"阊门戏调行客","author":"范成大","text":"日夜飞帆与跨鞍，阊门川陆路漫漫。\n人生自苦身馀几，天色无情岁又寒。\n万事惟堪六如观，一杯莫信四并难。\n重阳虽过黄花少，尚有迟开玉雪团。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32849,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪寒围炉小集","author":"范成大","text":"席帘纸阁护香浓，说有谈空爱烛红。\n高饤膻根浇杏酪，旋融雪汁煮松风。\n康年气象冬三白，浮世功名酒一中。\n无事闭门渠易得，何人蹑屐响墙东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32850,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪意方浓复作雨","author":"范成大","text":"拟看飞花阵，翻成建水声。\n雨吾宁不识，雪汝几时成。\n三白从今卜，千仓待此盈。\n黄云如有意，青女莫无情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32851,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪霁独登南楼","author":"范成大","text":"雪晴风劲晚来冰，楼上奇寒病骨惊。\n雀啄空檐银笋堕，鸦翻高树玉尘倾。\n青帘闪闪千家静，黄帽亭亭一水横。\n坐久天容却温丽，一弯新月对长庚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32852,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹿鸣宴","author":"范成大","text":"岷峨钟秀蜀多珍，坐上儒先更逸群。\n墨沼不忧经覆瓿，琴台重有赋凌云。\n文章小技聊干禄，道学初心拟致君。\n富贵功名今发轫，愿看稽古策高勋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32853,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹿鸣席上赠贡士","author":"范成大","text":"登陆由来说四明，台星光处更魁星。\n海滨二老尊周室，馆下诸生右汉廷。\n秋赋重增人物志，春闱俱上佛名经。\n一飞好趁扶摇便，咫尺西兴是北溟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32854,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜沈叔晦至","author":"范成大","text":"澹若论交味，嘤其求友声。\n江湖几鱼沫，风雨一鸡鸣。\n旧事休重说，新诗莫细评。\n烦将忆勤梦，归对海山横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32855,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奠唐少梁晋仲兄弟墓下","author":"范成大","text":"当年连璧气如蜺，人许跻攀九列齐。\n黄壤一时埋玉树，青云何处用丹梯。\n生平书札频双鲤，岁晚交情但只鸡。\n眼底伤心难制泪，宁论宿草已萋萋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32856,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寒夜观雪","author":"范成大","text":"静极孤鸿响，寒疑万籁喑。\n眼花灯下字，髭断雪中吟。\n颇似偿前债，非关惜寸阴。\n可怜蝴蝶梦，翩作蠹书蟫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32857,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寒食郊行书事二首 其二","author":"范成大","text":"陇麦欣欣绿，山桃寂寂红。\n帆边渔蕝浪，木末酒旗风。\n信步随芳草，迷途问小童。\n赏心添脚力，呼渡过溪东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32858,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寒食郊行书事二首 其一","author":"范成大","text":"野店垂杨步，荒祠苦竹丛。\n鹭窥芦箔水，乌啄纸钱风。\n媪引浓妆女，儿扶烂醉翁。\n深村时节好，应为去年丰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32859,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寒食客中有怀","author":"范成大","text":"江郭花开也寂寥，不须绿暗与红凋。\n疾风甚雨过寒食，白日青春吟大招。\n芳景尚随流水去，故人应作綵云飘。\n烟波千里家何在，惟有溪声似晚潮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32860,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寓直玉堂拜赐御酒","author":"范成大","text":"归鸦陆续堕宫槐，帘幕参差晚不开。\n小雨遂将秋色至，长风时送市声来。\n近瞻北斗璿玑次，犹梦西山翠碧堆。\n惭愧君恩来甲夜，殿头宣劝紫金杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32861,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渡太湖","author":"范成大","text":"囊风阁雨半晴阴，惨淡谁知造化心。\n委命浮沉惟一叶，计身轻重亦千金。\n红尘犹道不胜险，白浪莫嗔如许深。\n晚得芗山堪寄缆，卧听鼍吼与龙吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32862,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"湘江洲尾快风挂帆","author":"范成大","text":"船头雪浪吼奔雷，十丈高帆满意开。\n我自只凭忠信力，风应不为世情来。\n儿童屡惜峰峦过，将士犹教鼓笛催。\n明日祝融天柱去，更烦先捲乱云堆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32863,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"湘阴桥口市别游子明","author":"范成大","text":"马首欲东舟欲西，洞庭桥口暮寒时。\n三年再别子轻去，万里独行吾蚤衰。\n遥忆美人湘水梦，侧身西望剑门诗。\n老来不洒离亭泪，今日天涯老泪垂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32864,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"犍为江楼","author":"范成大","text":"河边堵立看归篷，三老开头暮欲东。\n涨水稠滩连峡内，浅山浮石似湘中。\n无人驿路榛榛草，有客江楼浩浩风。\n种落尘消少公事，剩裁新语寄诗筒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32865,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登西楼","author":"范成大","text":"少年豪气合摧锋，青鬓朱颜万事慵。\n畴昔四愁无梦到，及时一笑有谁供。\n诗情饮兴如云薄，草色花光似酒醲。\n千里春心吟不尽，下楼分付晚烟钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32866,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蛮触","author":"范成大","text":"蛮触纷拿室未虚，心知惩忿欠工夫。\n腹须空洞方容物，事过清凉已丧吾。\n万仞我山高不极，一团心火蔓难图。\n从今立示寒灰观，笑看苍黄走郑巫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32867,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢江东漕杨廷秀秘监送江东集并索近诗二首 其二","author":"范成大","text":"秃翁衰雪涕垂颐，仿佛三生懒散师。\n浃髓沦肤都是病，倾囷倒廪更无诗。\n笑看笔格网丝遍，閒数窗棂花影移。\n事业光阴今若此，故人休说旧襟期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32868,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢江东漕杨廷秀秘监送江东集并索近诗二首 其一","author":"范成大","text":"远道悠悠日暮云，愁眉今日为君轩。\n残灯独照江东集，短梦相寻白下门。\n即事想多梅蕊句，有谁堪共桂花樽。\n斯文赖有斯人在，会合何时得细论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32869,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢范老问病","author":"范成大","text":"三椽一席度秋冬，造化儿嬉困此翁。\n帖有王书难治眩，文如陈檄不驱风。\n骨枯似蘖肤如腊，发织成毡鬓作蓬。\n点检病身还一笑，本来四大满虚空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32870,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢赐腊药感遇之什","author":"范成大","text":"鸿宝刀圭下九关，十年长奉玺封看。\n扶持蒲柳身犹健，收拾桑榆岁又寒。\n天地恩深双鬓雪，山川途远一心丹。\n疲氓疾苦今何似，拜手归来愧伐檀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32871,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赏心亭再题","author":"范成大","text":"天险东南重，兵雄百二尊。\n拂云千雉绕，截水万崖奔。\n赤日吴波动，苍烟楚树昏。\n向无形胜地，何以控乾坤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32872,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"道子教授奉祠诸生率余祖席如意院","author":"范成大","text":"暂移三席款云关，木末阑干暮紫间。\n绛帐莫贪江上路，青鞋先试水西山。\n伯阳有道来重趼，禦寇他年忆解颜。\n怪我抗尘驱俗驾，诸公何事许追攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32873,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"道中","author":"范成大","text":"月冷吟蛩草，湖平宿鹭沙。\n客愁无锦字，乡信有灯花。\n踪迹随风叶，程途犯斗槎。\n君看枝上鹊，薄暮亦还家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32874,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鲁如晦郎中挽词二首 其一","author":"范成大","text":"术业推游刃，功名苦溯洄。\n著鞭孤壮志，筹算老奇才。\n星省庞眉去，云山袖手来。\n知公了时命，何必诔馀哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32875,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鲁如晦郎中挽词二首 其二","author":"范成大","text":"自古归来引，于今遂隐篇。\n棋灯荧夜观，歌板聒春船。\n陈迹空华似，佳城露草边。\n寂寥鸡黍约，望眼一潸然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32876,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鲁家洑入沌","author":"范成大","text":"过尽巴东巫峡长，荆川鼓棹更茫茫。\n避风怕入三江口，乘月贪行百里荒。\n夜后逢人尽刀剑，古来踏地皆耕桑。\n可怜行路难如此，一簇寒芦尚税场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32877,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鼎河口枕上作","author":"范成大","text":"漂泊离巢燕，弯跧负壳蜗。\n瘦嫌莞席硬，老觉画屏奢。\n报道帆当落，传呼鼓已挝。\n且投人处宿，未到已闻蟆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32878,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"携家石湖赏拒霜","author":"范成大","text":"水上晴云綵蝀横，许多蜂蝶趁船行。\n渔樵引入新花坞，儿女扶登小锦城。\n艳粉发妆朝日丽，湿红浮影晚波清。\n谁知摇落霜林畔，一段韶光画不成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32879,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新安侯夫人俞氏挽词","author":"范成大","text":"蚤兆于凰卜，来嫔驷马车。\n夫君宜竹帛，子舍各诗书。\n露薤丹旌举，风杨组帐虚。\n空馀彤管训，他日照乡闾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32880,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新岁书怀","author":"范成大","text":"门阒知閒好，窗晴与睡宜。\n岁华书户笔，年例探梅诗。\n看长棋三著，量添饭两匙。\n豁除身外事，未是苦衰迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32881,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新作官梅庄移植大梅数十本绕之","author":"范成大","text":"腊前催唤主林神，玉树飞来不动尘。\n契阔西湖惭处士，飘零东阁似诗人。\n一天午梦空花碎，满地春愁月影新。\n扫净宣华藜藋径，他年谁记石湖滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32882,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新作锦亭程咏之提刑赋诗次其韵二首 其二","author":"范成大","text":"小筑聊锄草棘荒，游人错比召南棠。\n花边雾鬓风鬟满，酒畔云衣月扇香。\n灿烂吟笺烦索句，淋漓醉墨自成行。\n报章迟钝吾衰矣，终日冥搜谩七襄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32883,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新作锦亭程咏之提刑赋诗次其韵二首 其一","author":"范成大","text":"飞鸿衔子谩纷纷，万里西游始识真。\n不管吴霜微点鬓，来看蜀锦烂争春。\n倚阑定有司花女，秉烛仍留主夜神。\n异县赏心谁与共，故人新作坐中宾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32884,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"亲邻招集强往便归","author":"范成大","text":"乐天渐老欲谋欢，大似蒸砂不作团。\n已觉笙歌无煖热，仍嫌风月太清寒。\n气衰况复三而竭，心赏尤于四者难。\n却恐人嫌情太薄，聊将花作雾中看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32885,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新津道中","author":"范成大","text":"雨后郊原净，村村各好音。\n宿云浮竹色，清溜走桤阴。\n曲沼擎青盖，新畦艺绿针。\n江天空阔处，不受暑光侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32886,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新凉夜坐","author":"范成大","text":"吏退焚香百虑空，静闻虫响度帘栊。\n江头一尺稻花雨，窗外三更蕉叶风。\n日日老添明镜里，家家凉入短檠中。\n简编灯火平生事，雪白眵昏奈此翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32887,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"睡觉","author":"范成大","text":"漏箭声中断角哀，界窗犹有月徘徊。\n心兵休为一蚊动，句法却从孤雁来。\n漱罢玉池甘似醴，梦馀金鼓辩如雷。\n夜长展转添许事，推枕萧然一笑咍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32888,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"睡起","author":"范成大","text":"憨憨与世共儿嬉，兀兀从人笑我痴。\n閒里事忙晴晒药，静中机动夜争棋。\n心情诗卷无佳句，时节梅花有好枝。\n熟睡觉来何所欠，毡根香软饭流匙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32889,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"签厅夜归用前韵呈子文","author":"范成大","text":"簿书堆里解归鞍，我亦萧然辔勒宽。\n炉篆无风香雾直，庭柯有月露光寒。\n閒思喜鹊填河鼓，静数流萤绕井栏。\n明日又驱官里去，从教白鹭侣红鸾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32890,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舅母太夫人方氏挽词三首 其二","author":"范成大","text":"门户传清白，阶庭侍紫青。\n百年歌燕喜，五福用康宁。\n诀箓尝观妙，旒旌谩勒铭。\n神游定超绝，何必讯泉扃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32891,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舅母太夫人方氏挽词三首 其一","author":"范成大","text":"四德仪邦族，三迁奠里门。\n姑宁忧疾痛，子自乐平反。\n夏枕方供扇，薰堂甫种萱。\n那知秋暑退，无复御轻轩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32892,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舅母太夫人方氏挽词三首 其三","author":"范成大","text":"我愿延陵道，几如渭水阳。\n适传杯泛影，何意隙沉光。\n拟补兰陔雅，翻吟薤露章。\n支离妨执绋，雨泣望楸行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32893,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"嘉陵江过合州汉初县下","author":"范成大","text":"井径东川县，山河古合州。\n木根拿断岸，急雨沸中流。\n关下嘉陵水，沙头杜老舟。\n江花应好在，无计会江楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32894,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"槠洲道中","author":"范成大","text":"烟凝山如影，云褰日射毫。\n桃间红树迥，麦里绿丛高。\n客子叹游倦，田家甘作劳。\n乘除吾尚可，未拟赋离骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32895,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"翠峰寺","author":"范成大","text":"来从第九天，橘社系归船。\n借问翠峰路，谁参雪窦禅。\n应真庭下木，说法井中泉。\n公案新翻出，诸方一任传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32896,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"横溪驿感怀","author":"范成大","text":"行遍天涯与地隅，筋骸那比十年初。\n朱颜有酒且留住，白发无方能埽除。\n未得归田先作赋，专攻种树已成书。\n祗今飞到南山下，犹解清晨出荷锄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32897,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"豫章南浦亭泊舟二首 其二","author":"范成大","text":"闰岁花光晚，霜朝草色荒。\n趁墟犹市井，收潦再耕桑。\n客路东西懒，江流日夜忙。\n长歌情不尽，一酌酹沧浪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32898,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"豫章南浦亭泊舟二首 其一","author":"范成大","text":"绣槛临沧渚，牙樯插暮沙。\n浦云沉断雁，江雨入昏鸦。\n野旷天何近，春寒岁未华。\n来朝风一席，随处且浮家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32899,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题夫差庙","author":"范成大","text":"纵敌稽山祸已胎，垂涎上国更荒哉。\n不知养虎自遗患，只道求鱼无后灾。\n梦见梧桐生后圃，眼看麋鹿上高台。\n千龄只有忠臣恨，化作涛江雪浪堆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32900,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]