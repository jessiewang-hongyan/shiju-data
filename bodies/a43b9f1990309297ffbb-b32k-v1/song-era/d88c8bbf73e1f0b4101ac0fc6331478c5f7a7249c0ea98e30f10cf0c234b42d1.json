[{"title":"停帆","author":"赵师秀","text":"舟过梢人屋，停帆去未能。\n野梅皆是刺，滩水不为冰。\n里数讹难准，官称俗可憎。\n欲登岩石坐，有吏复无朋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44560,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄茅山温尊师","author":"赵师秀","text":"几度题诗寄入山，不知何处得书看。\n莓苔石上秋吟远，星斗坛中夜拜寒。\n鹤改新名呼未至，碑逢断刻打应难。\n忆师每欲寻师去，芝朮栽成自可餐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44561,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄赵昌父","author":"赵师秀","text":"逃名逃未得，几载住章泉。\n便使重承诏，多应不议边。\n高风时所系，新集世方传。\n忆就江楼别，雪晴江月圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44562,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄赵楚州","author":"赵师秀","text":"承明虽妙古云劳，小借临边却自豪。\n韩信所封兵尚劲，刘伶曾住酒应高。\n牵来宝马通言语，放去雕弓落羽毛。\n别有异时人忆处，万株杨柳绿春壕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44563,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄徐丞","author":"赵师秀","text":"病不窥园经一月，更无人迹损青苔。\n池禽引子衔鱼去，野蔓开花上竹来。\n亦欲鬓毛休似雪，争如丹汞只为灰。\n秋风昨夜吹寒雨，有梦南游到海回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44564,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄徐县丞","author":"赵师秀","text":"自尔为官去，吾扉亦返关。\n池成逢夜雨，篱坏出秋山。\n岁事登禾稼，朝纲去草菅。\n题书寄漳水，专俟好诗还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44565,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄新吴友人","author":"赵师秀","text":"每于楼上立，远远望新吴。\n春至山疑长，江空雨似无。\n怀才人尽爱，多病体常癯。\n若治东游策，舟行与子俱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44566,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄薛景石","author":"赵师秀","text":"虚窗风飒然，独卧听残蝉。\n家务贫多阙，诗篇老渐圆。\n清秋添一月，故里别三年。\n最忆君门首，黄花匝野泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44567,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"庵西","author":"赵师秀","text":"数里庵西路，东风去更吹。\n稻寒生叶细，松老作花迟。\n小憩嫌无侣，曾游忆有诗。\n新萤光尚小，未暗出空池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44568,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"移居谢友人见过","author":"赵师秀","text":"赁得民居亦自清，病身于此寄飘零。\n笋从坏砌砖中出，山在邻家树上青。\n有井极甘便试茗，无花可插任空瓶。\n巷南巷北相知少，感尔诗人远扣扃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44569,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜徐道晖至","author":"赵师秀","text":"嗜茶身益瘦，兼恐欲通仙。\n近作诗全少，闲成画亦传。\n潇江风雪渡，岳石姓名镌。\n自接来消息，朝朝问客船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44570,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答叶司理","author":"赵师秀","text":"寂寞坐高斋，兵来与讯偕。\n喜看君字画，癯似我形骸。\n颇欲徵陈作，遥知动远怀。\n梦魂思一遇，风雨暗长淮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44571,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答徐灵渊","author":"赵师秀","text":"弊庐补葺虽劳力，且得幽闲住此身。\n旧友误称吟笔长，诸亲争笑罢官贫。\n近檐竹密妨巢雀，当户花疏见路人。\n所虑久晴田事废，今闻高下雨皆匀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44572,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答曾景建","author":"赵师秀","text":"爱重吟来句，和经一处安。\n亦知将作佛，何讶不为官。\n楚塞烽烟静，淮波柳絮残。\n疑根深未指，欲往愧飞翰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44573,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢耕道犁春图","author":"赵师秀","text":"春雨年年有，良田岁岁无。\n何因将此事，须要画为图。\n野水寒初退，平林绿半敷。\n长谣谢沮溺，未必子知吾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44574,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雁荡宝冠寺","author":"赵师秀","text":"行向石栏立，清寒不可云。\n流来桥下水，半是洞中云。\n欲住逢年尽，因吟过夜分。\n荡阴当绝顶，一雁未曾闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44575,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"简同行翁灵舒","author":"赵师秀","text":"久晴滩碛众，舟楫后先行。\n终日不相见，与君如各程。\n水禽多雪色，野笛忽秋声。\n必有新成句，溪流合让清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44576,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"简孙正字","author":"赵师秀","text":"空斋兀兀难消日，况入中年睡亦疏。\n洗釜煮蔬留客饭，卷帘移菊看人锄。\n秋衣因病全更衲，晓鬓迎寒半脱梳。\n多谢贵交芸阁里，许令随意借官书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44577,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"缙云县宿","author":"赵师秀","text":"亲知因别久，具酒劳经过。\n古邑居人少，春寒入夜多。\n雨香仙地药，烛动石桥波。\n稍觉离家远，乡音一半讹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44578,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"暮春书怀寄翁十","author":"赵师秀","text":"帝里逢春雨不乾，才晴数日又春还。\n桐华半落官河水，榆叶全遮客舍山。\n未悔阔疏令事去，最怜乏绝坏身闲。\n菖蒲九节今堪采，思尔逍遥涧谷间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44579,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"翠岩寺","author":"赵师秀","text":"石岩看不见，翠色自重重。\n春雨生松叶，山风响铁钟。\n碑顽工费墨，草嫩绿添茸。\n住院吴僧老，相迎忆旧逢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44580,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"德安道中","author":"赵师秀","text":"餐馀行数步，稍觉一身和。\n蚕月人家闭，春山瀑布多。\n莺啼声出树，花落片随波。\n前路东林近，惭因捧檄过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44581,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题方兴化茔舍","author":"赵师秀","text":"晴檐方听夜淋浪，晚送儒臣别建章。\n但欲有言扶国是，不嫌无计作身防。\n轻舟过处猿频断，旧宅开时菊正黄。\n心事对床应细语，得归如此亦何妨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44582,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题方兴化茔舍","author":"赵师秀","text":"使君如玉不雕镌，可惜埋藏已十年。\n佳兆昔令人入梦，遗经今有子能传。\n紫藤附暖应生地，苍柏凌空欲到天。\n要识德源无尽处，一池清甚发渊泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44583,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"薛氏瓜庐","author":"赵师秀","text":"不作封侯念，悠然远世纷。\n惟应种瓜事，犹被读书分。\n野水多于地，春山半是云。\n吾生嫌已老，学圃未如君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44584,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠孔道士","author":"赵师秀","text":"生来还姓孔，何不戴儒冠。\n诗好逢人诵，琴清只自弹。\n访师行郡远，爱竹透庵寒。\n见说丹炉内，黄金化不难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44585,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠邓汉卿","author":"赵师秀","text":"单独一身长不定，亦无书卷得相随。\n忙过人世当闲日，老遇朝廷用少时。\n冲雪自言行路苦，看松长恨买山迟。\n萧萧白发寒灯下，写就诗篇欲寄谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44586,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠汤巾","author":"赵师秀","text":"黄金榜内人，枉刺忽相亲。\n怪得名差异，吟来句极新。\n独眠秋寺雨，罕踏帝城尘。\n何限高科客，因容不重身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44587,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠约老","author":"赵师秀","text":"一径入深竹，数楹临古沟。\n更无人共住，极喜客来游。\n白发长垂领，新茶绿满瓯。\n自言门外寺，皆是老僧修。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44588,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠达西堂","author":"赵师秀","text":"秋水数枝莲，在师房一边。\n固应通净理，不复念生缘。\n旧愿酬初满，灵方许尽传。\n闲询曾住寺，如梦已茫然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44589,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠张亦","author":"赵师秀","text":"相逢楚泽中，语罢各西东。\n天下方无事，男儿未有功。\n边风吹面黑，市酒到肠空。\n早作归耕计，吾舟俟尔同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44590,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠张亦","author":"赵师秀","text":"一别无书信，相逢各老苍。\n山川烽外远，岁月梦中长。\n空橐盛诗草，单衣涴酒香。\n因言瀼溪宴，同忆旧时狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44591,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠陈宗之","author":"赵师秀","text":"四围皆古今，永日坐中心。\n门对官河水，檐依绿树阴。\n每留名士饮，屡索老夫吟。\n最感书烧尽，时容借检寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44592,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠陈复道","author":"赵师秀","text":"自惜今年发，新添一半华。\n祇应如意事，不属苦吟家。\n忽暖天□雪，微香案有花。\n故人劳见念，相过教丹砂。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44593,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠易道士","author":"赵师秀","text":"仙帔画霞雪，多年侍玉宸。\n古于庄子貌，贵似吕公身。\n诗好当开板，丹灵不化银。\n旧山新筑观，惟梦得归频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44594,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠源长老归自湘中","author":"赵师秀","text":"白发半头寒未剃，形容清瘦异于常。\n为人作画衣添黑，对客围棋爪甚长。\n不染世间如菡萏，只留胸次著潇湘。\n住山亦自年来懒，竹阁门前借一房。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44595,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"壕上","author":"赵师秀","text":"远近人家住，过桥路尽通。\n野田行瘦马，浅渚聚群鸿。\n地静微泉响，天寒落日红。\n若非身作吏，不道是城中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44596,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九客一羽衣泛舟分韵得尊字就送朱几仲","author":"赵师秀","text":"人生苦形役，不定如车辕。\n况各异乡井，忽此同酒尊。\n此尊岂易同，意乃有数存。\n西湖雪未成，两山翠相奔。\n山根日照树，花放林逋村。\n野馔具蘼藿，一饱厌百飧。\n有客何多髯，吐气邻芳荪。\n慷慨念时事，所惜智者昏。\n砭疗匪无术，讳疾何由论。\n北望徒太息，归欤寻故园。\n哆然黄冠师，笑请子勿喧。\n东南守太乙，此宿福所屯。\n吾子且饮酒，酒冷为子温。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44597,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山路怀翁卷","author":"赵师秀","text":"幽溪晓无雨，野竹叶自湿。\n涓涓北流泉，风吹落花入。\n不见苦吟人，芳思将谁拾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44598,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"午困","author":"赵师秀","text":"午困因书又见寻，自添茶鼎候微吟。\n病身未觉春风暖，柳色无端日日深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44599,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"后哀","author":"赵师秀","text":"交交谷鸟哀，郁郁涧松折。\n山民无还期，春物失怡悦。\n平生感斯人，难以常理说。\n共智己则愚，忽巧众亦拙。\n芳名信可垂，在世何寂灭。\n含悽为卜兆，窀穸利兹月。\n行当宿草生，当使我泪歇。\n未知百年后，谁复耕此穴。\n寄言苦吟者，勿弃摄生诀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44600,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵赵正字蟹","author":"赵师秀","text":"嗔尔横行为多足，割尔两螯如割玉。\n怜尔有甲不自卫，评尔一身黄胜肉。\n吴江十月天霜寒，吴人微尔不举餐。\n萑蒲勿讶束尔急，与虎争强能上山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44601,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吹台曲","author":"周紫芝","text":"天门玉钥双龙开，霓旌羽盖天上来。\n管弦嘈杂入霄汉，美人侍燕黄金台。\n羽觞行酒欢未足，燕姬成行列红玉。\n梁王半醉起更衣，夜按玉箫亲度曲。\n曲终举袂俱争妍，拜舞樽前称万年。\n三山玉女朝群仙，当时弄玉飞上天，至今台下草如烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44602,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和陈水云湖庄韵","author":"赵师秀","text":"粼粼水增波，叠叠云弄影。\n昔誇春径妍，今爱秋塘静。\n芳筵集宾彦，清宴除艳靓。\n时当新雨馀，苍翠献林岭。\n既忻冲抱舒，复快远目骋。\n仰嘉钟鼎人，而乃眷箕颍。\n深营察高趣，雅咏发沉景。\n独使和者难，一夕愁欲瘿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44603,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"官田之集翁聘君失期陈伯寿赋诗率尔次韵","author":"赵师秀","text":"好水不厌阔，好风不厌凉。\n况有十顷荷，荷风媚波光。\n主人昔谓余，此境不可忘。\n举觞集群英，期以朝未央。\n清欢遣丝竹，善谑停优倡。\n快若鱼脱网，适比鸳在梁。\n搴芳衣履湿，饮渌肌骨香。\n操觚赋相联，妙续楚九章。\n苦吟堕饥蝉，巧咏发轻簧。\n常胜或倒戈，突出或擅场。\n或峙而遽蹴，或抑而载扬。\n所欠独巨翁，不使人意强。\n孱衲尔何为，竭飒立在傍。\n有间众稍默，谈辩忽汪洋。\n夕风亦损荷，万事付叵量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44604,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诗二首 其二","author":"赵师秀","text":"三年非一事，知尽爱人心。\n满任添新发，还家带旧琴。\n鹊声先棹去，柳色到都深。\n即日应冠豸，凭共记得沈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44605,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诗二首 其一","author":"赵师秀","text":"邑事多商榷，惟诗未暇论。\n母慈催扇枕，父老欲攀辕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44606,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"哀山民","author":"赵师秀","text":"忆君初病时，仓皇造君榻。\n知为寒所中，胫痹连左胛。\n蒋子丹有神，三日能屈伸。\n五日扶杖立，十日行逡巡。\n于时数相见，谈娱靡曾倦。\n啜茶犹满瓯，改诗忽盈卷。\n君亦疑勿药，春和可为乐。\n仙家桃最红，同践天台约。\n多愁积如山，令君心不闲。\n残疴故未去，涩啬肠腑间。\n岳僧有烈剂，倒箧得馀惠。\n服之汗翻浆，事与东流逝。\n啼妻无完裙，弱子犹哀麇。\n诗人例穷苦，穷死更怜君。\n君如三秋草，不见一日好。\n根荄霜霰侵，萎绝嗟何早。\n哭君日无光，思君月照床。\n犹疑君不死，猛省欲颠狂。\n昨者君未疾，相过不论日。\n晴窗春剪蒲，寒炉夜煨栗。\n石阶苔藓中，犹有旧行踪。\n忧心不能寐，无梦得相逢。\n君诗如贾岛，劲笔斡天巧。\n昔为人所称，今为人所宝。\n石峰云有地，葬从朋友议。\n须求侍郎铭，难见山民字。\n平生翁与徐，南去久无书。\n不知闻信后，涕泪当何如。\n写池烟水暮，宛是西川路。\n虚言楚客招，终感向生赋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44607,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋日游栖霞庵","author":"赵师秀","text":"乘兴入孤村，神凝秋水间。\n菊开嫌径小，荷尽觉池宽。\n林影悬崖屋，钟声何处山。\n清游殊未倦，初月照松关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44608,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"哭徐玑五首 其五","author":"赵师秀","text":"道晖爱江蓠，吾子思单老。\n生念死不灭，应会沅湘道。\n空山独灵舒，闭户守枯槁。\n风雪将岁阑，凋零此怀抱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44609,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"哭徐玑五首 其四","author":"赵师秀","text":"平生于所学，常若丧其敏。\n临池书未成，池水黑已尽。\n传来叶岭帖，遂与兰亭近。\n凡兹究极功，亦足损肝肾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44610,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"哭徐玑五首 其三","author":"赵师秀","text":"思君气实充，不与短折类。\n血死匪无由，恐是服椒罪。\n君于药自深，何独此乎昧。\n岂不闻仙人，饵菖得千岁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44611,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"哭徐玑五首 其二","author":"赵师秀","text":"昔吾与君游，嫌疏不嫌数。\n自为贫窭驱，十载九离索。\n前年会京都，勖我返林薄。\n吾贫未得归，君死不可作。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44612,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"哭徐玑五首 其一","author":"赵师秀","text":"君早抱奇质，获与有道亲。\n微官漫不遇，泊然安贱贫。\n心夷语自秀，一洗世士陈。\n使其养以年，鲍谢焉足邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44613,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"徐先辈挽词","author":"赵师秀","text":"岂谓声名早，番成不遇非。\n赋曾天子见，诗有世人知。\n忽种松三尺，终乖桂一枝。\n幽芳谁与志，御史念埙篪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44614,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宿徐灵晖山舍","author":"赵师秀","text":"分坐桥边石，同归原上村。\n窥灯禽出树，闻语仆开门。\n雪后挑蔬洁，更深贳酒浑。\n极知高卧久，吾贱不能伦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44615,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"敬谢章泉赵昌甫二十韵","author":"赵师秀","text":"耆旧半凋落，在者如晨星。\n与翁别豫章，十见草木青。\n人生几堪别，梦寐生羽翎。\n迢迢玉溪波，近昨尝再经。\n携家事多难，所至那得停。\n山中空望来，日夕不掩扃。\n岂独负兹约，尺书亦沈冥。\n逢人问消息，但喜言康宁。\n堕来两卷什，一以慰飘零。\n感此故意弘，不我迹以形。\n文章出晚岁，字画犹壮龄。\n诵之西湖滨，惊动孤山灵。\n翁卷游崆峒，一已烦邮铃。\n幸翁良未衰，吾党存典刑。\n遥闻曾入郛，谅为韩与丁。\n郡斋待且久，几宿涧上亭。\n今春少晴时，涧水应泠泠。\n归来安稳否，薰风入林坰。\n愿言爱玉骨，逍遥卧殊庭。\n会面虽未期，忽聚江湖萍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44616,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"葛翁小阁","author":"赵师秀","text":"树色对疏棂，横陈一片清。\n微风杨叶下，斜日竹稍明。\n此老无尘事，双姝亦道情。\n客来怜素壁，题句不题名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44617,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"筠州郡庠山亭","author":"赵师秀","text":"一来高处望，远近尽秋容。\n秀气归才子，清风属钓翁。\n溪晴分别港，山阙见他峰。\n独忆凉宵月，无因宿此中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44618,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其八","author":"赵师秀","text":"石畔长来枝易老，竹间瘦得萼全清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44619,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其三","author":"赵师秀","text":"恨不坐通宵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44620,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其九","author":"赵师秀","text":"教人知遁甲，笑客问勾庚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44621,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其一","author":"赵师秀","text":"病与西湖绝半年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44622,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其六","author":"赵师秀","text":"地僻传闻新事少，路遥牵率故人多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44623,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其二","author":"赵师秀","text":"况多秋藓色。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44624,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]