[{"title":"省事吟","author":"邵雍","text":"虑少梦自少，言稀过亦稀。\n帘垂知日永，柳静觉风微。\n但见花开谢，不闻人是非。\n何须寻洞府，度岁也应迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3750,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋日即事","author":"邵雍","text":"鸟声乱昼林，为谁苦驱逼。\n虫声乱夜庭，为谁苦劳役。\n嗟哉彼何短，一槩无休息。\n借问此何长，两能忘语默。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3751,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋日雨霁闲望","author":"邵雍","text":"水冷云疏霜意早，岁华虽晚黄花好。\n饶教四面远山围，奈何一片秋光老。\n上天生物固无私，圣人馀事人难晓。\n陈言生活不须矜，自是中才皆可了。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3752,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋日登石阁","author":"邵雍","text":"初晴僧阁一凭栏，风物凄凉八月间。\n欲尽上层尝脚力，更于高处看人寰。\n秋深天气随宜好，老后心怀只爱闲。\n为报远山休敛黛，这般情意久阑珊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3753,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋怀三十六首 其二十七","author":"邵雍","text":"惟南有美橘，惟北有美栗。\n厥包或颇同，厥味信不一。\n天地岂无情，草木皆有实。\n物本不负人，人自负于物。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3754,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋怀三十六首 其二十六","author":"邵雍","text":"饱霜梨多红，久雨榴自罅。\n此果世称珍，厥味是可诧。\n地有百物备，天无一言挂。\n我患尚有言，不得同造化。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3755,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋怀三十六首 其二十五","author":"邵雍","text":"九月气乍肃，衰柳犹有蝉。\n霜外疏钟断，风馀清籁传。\n千山乱远月，一鹗摩高天。\n自非出世人，而敢危行言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3756,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋怀三十六首 其二十四","author":"邵雍","text":"人老秋更老，山深水复深。\n高木已就脱，慧禽空好音。\n筋骸非曩日，道德负初心。\n赖有馀编在，时时尚可寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3757,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋怀三十六首 其二十三","author":"邵雍","text":"池荷日取败，篱菊日就荣。\n其于品汇间，自与节气争。\n盛衰不同时，贤愚难并行。\n安得松桂心，四时长青青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3758,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋怀三十六首 其二十二","author":"邵雍","text":"风柳散如梳，霜云淡如扫。\n高楼破危空，低烟袅寒草。\n此际兴不尽，何以战秋老。\n止可将酒瓶，同向西风倒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3759,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋怀三十六首 其二十一","author":"邵雍","text":"寒露缀衰草，凄风摇晚林。\n鸟声上复下，天气晴还阴。\n节改一时事，人怀千古心。\n谁云子期死，举世无知音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3760,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋怀三十六首 其二十","author":"邵雍","text":"良月满高楼，高楼仍中秋。\n午夜冷露下，千里寒光流。\n何人将此鉴，拂拭新磨休。\n照破万古心，白尽万古头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3761,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋怀三十六首 其十九","author":"邵雍","text":"中秋光景好，中州烟水奇。\n天重初寒候，人便半醉时。\n榻缘明月扫，襟待好风吹。\n一点胸中事，人间都不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3762,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋怀三十六首 其十八","author":"邵雍","text":"断续蝉声外，稀疏雁下前。\n年光空去也，人事益萧然。\n洗竹留新笋，翻书得旧编。\n谁知养心者，肯与世争权。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3763,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋怀三十六首 其十七","author":"邵雍","text":"塞鸿犹未来，梁燕已辞去。\n云山千万重，相逢在何处。\n岌嶪都城门，缭绕长亭路。\n风土败人衣，才新又成故。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3764,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋怀三十六首 其十六","author":"邵雍","text":"秋色日渐深，老心日益懒。\n倦即下阶行，闲来弄书卷。\n广陌多风尘，见说难开眼。\n侯门已是深，帝阍又复远。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3765,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋怀三十六首 其十五","author":"邵雍","text":"稻稌天所生，曲蘖人所制。\n酿之命为酒，饮之可成醉。\n刚者使之柔，懦者使之毅。\n善移造物权，其功亦不细。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3766,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋怀三十六首 其十四","author":"邵雍","text":"黄黍秋正熟，黄鸡秋正肥。\n此物剧易致，古人多重之。\n可以迓宾友，可以奉亲闱。\n有褐能卒岁，此外何足为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3767,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋怀三十六首 其十三","author":"邵雍","text":"八月炎凉均，气味亦自好。\n临虚乔木低，远望行人小。\n有迹事皆妄，无心物都了。\n何须更问辛，愿君自食蓼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3768,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋怀三十六首 其十二","author":"邵雍","text":"淡烟羃疏林，轻风袅寒雨。\n日暮人已归，群鸡犹啄黍。\n此心固不动，此事极难处。\n一言以蔽之，尚恐费言语。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3769,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋怀三十六首 其十一","author":"邵雍","text":"青蕉叶披敷，碧芦枝偃亚。\n风雨萧萧天，更漏沉沉夜。\n彼物固无嫌，此情又何讶。\n但念征路人，天涯尚留挂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3770,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋怀三十六首 其十","author":"邵雍","text":"清风无人兼，自可入吾手。\n明月无人并，自可入吾牖。\n中心既已平，外物何尝诱。\n馀事岂足论，但恐樽无酒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3771,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋怀三十六首 其九","author":"邵雍","text":"周诗云娶妻，周易云归妹。\n七夕世俗情，乞巧儿女态。\n日暮云雨过，人谓牛女会。\n云雨本无踪，牛女岂相配。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3772,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋怀三十六首 其八","author":"邵雍","text":"国命在乎民，民命在乎食。\n圣人虽复生，斯言固不易。\n虚惠岂足尚，教人以姑息。\n虚名岂足高，教人以缘饰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3773,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋怀三十六首 其七","author":"邵雍","text":"甘瓜青如蓝，红桃鲜若血。\n不忍以手拈，而况用齿齧。\n其色已可爱，其味又更绝。\n食此无珍言，哀哉口与舌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3774,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋怀三十六首 其六","author":"邵雍","text":"昨日思沃浆，今日思去扇。\n岂止人戈矛，炎凉自交战。\n利害生乎情，好尚存乎见。\n欲人为善人，必须自为善。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3775,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋怀三十六首 其五","author":"邵雍","text":"清湍文鸳鸯，寒潭绣鸂䳵。\n长天净如水，不废秋江碧。\n男子一寸心，壮士万夫敌。\n菡萏香风中，扁舟会相忆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3776,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋怀三十六首 其四","author":"邵雍","text":"疏雨滴高梧，微风挼弱柳。\n此景岁岁同，世人自白首。\n俗虑易萦仍，尘襟难抖擞。\n浮生已梦中，其间强为有。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3777,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋怀三十六首 其三","author":"邵雍","text":"明月生海心，凉风起天末。\n物象自呈露，襟怀骤披豁。\n悟尽周孔道，解开仁义结。\n礼法本防奸，岂为吾曹设。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3778,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋怀三十六首 其二","author":"邵雍","text":"晴窗日初曛，幽庭雨乍洗。\n红兰静自披，绿竹闲相倚。\n荣利若浮云，情怀淡如水。\n身非天外人，意从天外起。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3779,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋怀三十六首 其一","author":"邵雍","text":"七月夜初长，星斗争煌煌。\n庭除经小雨，枕簟生微凉。\n照物无遁形，虚鉴自有光。\n照事无遁情，虚心自有常。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3780,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋怀三十六首 其三十六","author":"邵雍","text":"饮酒不甚多，数杯醺心颜。\n未醺不可止，既醺劝亦难。\n谁云万物广，岂出天地关。\n谁云万事广，岂出人情间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3781,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋怀三十六首 其三十五","author":"邵雍","text":"草枯山川贫，木落天地瘦。\n土口风大行，云罅日微漏。\n既往不复追，未来尚可救。\n馀事不忍言，言之必成咎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3782,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋怀三十六首 其三十四","author":"邵雍","text":"万里晴天外，一片霜上月。\n长松挺青葱，群卉入消歇。\n有齿日益衰，有发日益脱。\n获罪固已多，此公难屑屑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3783,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋怀三十六首 其三十三","author":"邵雍","text":"草绿露沾衣，草衰风切肌。\n物情非作异，人意强生疑。\n岐动杨朱泣，丝添墨子悲。\n知之何太晚，徒自泪淋漓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3784,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋怀三十六首 其三十二","author":"邵雍","text":"水寒潭见心，木落山露骨。\n始信天无涯，万里不隔物。\n脱衣挂扶桑，引手探月窟。\n不负仁义心，区区五十一。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3785,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋怀三十六首 其三十一","author":"邵雍","text":"山横暮霭中，鸟逝孤烟外。\n残菊忧霜摧，幽兰惧风败。\n患难人不喜，富贵人所爱。\n我心自不有，爱憎岂能卖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3786,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋怀三十六首 其三十","author":"邵雍","text":"九日登高会，寻幽讲雅欢。\n俗风追故事，天气荐轻寒。\n白酒连醅饮，黄花带露观。\n消沉浮世事，何足重汍澜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3787,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋怀三十六首 其二十九","author":"邵雍","text":"红叶战西风，黄花笑寒日。\n天道有消长，人事无固必。\n静胜得遗味，梦去知馀失。\n利害不相沿，是非然后出。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3788,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋怀三十六首 其二十八","author":"邵雍","text":"蛱蝶绕寒菊，蟋蟀鸣空阶。\n门前有犬卧，尽日无客来。\n清波静中流，白云闲处堆。\n何以发天和，时饮酒一杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3789,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋怀吟","author":"邵雍","text":"一番春了未多时，云外征鸿又报归。\n节物眼前来若此，岁华头上去如斯。\n当年志意虽然在，今日筋骸宁不衰。\n赖有寸心常自喜，圣人难处却能知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3790,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夜","author":"邵雍","text":"耿耿银河秋夜长，起来无寐□思量。\n思量了后迷还闷，烦恼到头徒□□。\n□□□□□计较，梦中说梦转寻常。\n回头万事□□迹，空□语言争知长。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3791,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"种谷吟","author":"邵雍","text":"农家种谷时，种禾不种莠。\n奈何禾未荣，而见莠先茂。\n莠若不诛锄，禾亦未成就。\n又况雨霈时，沾及恩一溜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3792,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"览照吟","author":"邵雍","text":"其骨爽，其神清。\n其禄薄，其福轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3793,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"览照吟","author":"邵雍","text":"凌晨览照见皤然，自喜皤然一叟仙。\n慷慨敢开天下口，分明高道世间言。\n虽然天下本无事，不奈世间长有贤。\n自问此身何所用，此身唯称老林泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3794,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诫子吟","author":"邵雍","text":"善恶无它在所存，小人君子此中分。\n改图不害为君子，迷复终归作小人。\n良药有功方利病，白圭无玷始称珍。\n欲成令器须追琢，过失如何不就新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3795,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"选官图","author":"邵雍","text":"虚名虚利太无端，自方□□寸进难。\n大抵人生只如此，采来谁不做高官。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3796,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重九日登石阁三首 其二","author":"邵雍","text":"事出一时间，时过事莫还。\n当时深可爱，过后不堪看。\n夏去休言暑，冬来始讲寒。\n人能知此理，忧患自难干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3797,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重九日登石阁三首 其一","author":"邵雍","text":"人情见了多，世态谙来久。\n事过忧噬脐，物伤防掣肘。\n水浊更澄滤，衣尘须抖擞。\n必欲论主衡，何人为好手。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3798,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重病吟","author":"邵雍","text":"安乐五十年，一旦感重疾。\n仍在盛夏中，伏枕几百日。\n砭灸与药饵，百疗效无一。\n以命听于天，于心何所失。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3799,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重游洛川","author":"邵雍","text":"买石尚饶云，买山当从水。\n云可致无心，水能为鉴止。\n性以无心明，情由鉴止已。\n二者不可失，出彼而入此。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3800,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻少华崩","author":"邵雍","text":"变化无踪倏忽间，力回天地不为难。\n若教施展巨灵手，岂止轩腾少华山。\n六社居民皆覆没，九泉磐石尽飞翻。\n刍荛一句能收采，尧舜之时自可攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3801,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻少华崩","author":"邵雍","text":"熙宁壬子岁，少华忽然崩。\n七社民俱死，九泉神不宁。\n昔天无骇，旷古未之聆。\n燮理阴阳者，如何略不惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3802,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"食梨吟","author":"邵雍","text":"愿君莫爱金花梨，愿君须爱红消梨。\n金花红消两般味，一般颜色如烟脂。\n红消食之甘如饴，金花食之先颦眉。\n似此误人事不少，未食之前宜辩之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3803,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"首尾吟 其一○六","author":"邵雍","text":"尧夫非是爱吟诗，诗是尧夫慎独时。\n人寿百年无以过，心游万仞待何为。\n为谋须求心无愧，作事莫幸人不知。\n诚尽鬼神犹且惧，尧夫非是爱吟诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3804,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"首尾吟 其四十四","author":"邵雍","text":"尧夫非是爱吟诗，诗是尧夫春出时。\n一点两点小雨过，三声五声流莺啼。\n杯深似锦花间醉，车稳如茵草上归。\n更在太平无事日，尧夫非是爱吟诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3805,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"首尾吟 其一三○","author":"邵雍","text":"尧夫非是爱吟诗，诗是尧夫难老时。\n齿暮乍逢新岁月，眼明初见旧亲知。\n欢情此去未伏减，饮量近来差觉低。\n六十七年无事客，尧夫非是爱吟诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3806,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"首尾吟 其一一九","author":"邵雍","text":"尧夫非是爱吟诗，诗是尧夫诧老时。\n金玉过从旧朋友，糟糠欢喜老夫妻。\n瓦烧酒盏连醅饮，纸画棋盘就地围。\n六十六年无事客，尧夫非是爱吟诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3807,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"首尾吟 其六十六","author":"邵雍","text":"尧夫非是爱吟诗，诗是尧夫穷理时。\n语爱何尝过父子，讲和曾未若夫妻。\n恩多意思翻成恨，欢极情怀却似悲。\n何事人间不如此，尧夫非是爱吟诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3808,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"首尾吟 其九十八","author":"邵雍","text":"尧夫非是爱吟诗，诗是尧夫出入时。\n草软沙平月陂下，云轻日淡上阳西。\n花深柳暗铜驼陌，风暖莺娇金谷堤。\n尽是尧夫行乐处，尧夫非是爱吟诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3809,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"首尾吟 其六十二","author":"邵雍","text":"尧夫非是爱吟诗，诗是天津秋尽时。\n见惯不惊新物盛，话长难说故人稀。\n云疏烟淡山仍远，露冷天高草已衰。\n赖有馀樽自斟酌，尧夫非是爱吟诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3810,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"首尾吟 其一二六","author":"邵雍","text":"尧夫非是爱吟诗，诗是尧夫得意时。\n物向物中观要妙，人于人上看几微。\n物中要妙眼前见，人上几微心里知。\n且是有金无处买，尧夫非是爱吟诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3811,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"首尾吟 其六十四","author":"邵雍","text":"尧夫非是爱吟诗，诗是尧夫旷望时。\n一片园林拥京国，几层楼观犯云霓。\n朝昏天气屡变易，今古人情旋合离。\n欲问远山惟敛黛，尧夫非是爱吟诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3812,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"首尾吟 其四十八","author":"邵雍","text":"尧夫非是爱吟诗，诗是尧夫确论时。\n若以后时为失计，必将先手作知几。\n三千宾客成何梦，百二山河付阿谁。\n弄巧既多翻作拙，尧夫非是爱吟诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3813,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"首尾吟 其二十九","author":"邵雍","text":"尧夫非是爱吟诗，诗是尧夫咏史时。\n旷古第成千觉梦，中原都入一枰棋。\n唐虞玉帛烟光紫，汤武干戈草色萋。\n观古事多今可见，尧夫非是爱吟诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3814,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"首尾吟 其三十七","author":"邵雍","text":"尧夫非是爱吟诗，诗是尧夫喜老时。\n好话说时常愈疾，善人逢处每忘机。\n此心是物难为动，其志唯天然后知。\n诗是尧夫分付处，尧夫非是爱吟诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3815,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"首尾吟 其五","author":"邵雍","text":"尧夫非是爱吟诗，诗是尧夫可爱时。\n宝鉴造形难著发，鸾刀迎刃岂容丝。\n风埃若不来侵路，尘土何由得上衣。\n欲论诚明是难事，尧夫非是爱吟诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3816,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"首尾吟 其一○○","author":"邵雍","text":"尧夫非是爱吟诗，诗是尧夫晚步时。\n信意遂过高祖宅，因行更上魏王堤。\n设如终久全无托，何似当初都不知。\n料得鬼神知此意，尧夫非是爱吟诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3817,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]