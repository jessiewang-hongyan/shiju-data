[{"title":"孟享仰瞻圣驾","author":"阮秀实","text":"紫烟敛翠碧天长，柳阴旌旗午尚霜。\n一朵彩云擎瑞日，光华尽在舜衣裳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40681,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠郑稼田","author":"阮委心","text":"非稼亦非田，生香萃简编。\n所耕皆实地，何虑不丰年。\n华秀充诸己，收藏乐此天。\n揠苗求助长，毋若宋人然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40682,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹊桥仙 赠妓","author":"阮郎中","text":"东风捻就，腰儿纤细。\n系的粉裙儿不起。\n近来只惯掌中看，忍教在、烛花影里。\n更阑应是，酒红微褪。\n暗蹙损、眉儿娇翠。\n夜深著两小鞋儿，靠那处、屏风立地。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40683,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梨花","author":"阮南溪","text":"缤纷紫雪浮须细，冷淡清姿夺玉光。\n刚笑何郎曾傅粉，绝怜荀令爱薰香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40684,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送崇教大师回天台","author":"阮思道","text":"碧云高价彻天涯，圭璧清无一点瑕。\n双阙再承新雨露，三吴重赏旧烟霞。\n水轩散味朝贤句，松院分尝御府茶。\n闻说赤城终未见，画图何日寄京华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40685,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题义门胡氏华林书院","author":"阮思道","text":"北阙重旌表，西斋盛讨论。\n高阳旬爽里，通德郑玄门。\n选胜开松院，凭幽敞竹轩。\n灵泉飞洞壑，花树蔽郊原。\n露滴栖松鹤，风传隔岭猿。\n庭兰香醉步，山月冷吟魂。\n客爱清尘虑，僧怜避俗喧。\n几时清赏玩，啸咏与琴樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40686,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九峰","author":"阮阅","text":"九峰深处是禅关，依旧居人说了然。\n一句本来男女话，当时应为灌溪传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40687,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"万载县","author":"阮阅","text":"门横路断竹为篱，雪色漫漫瓦屋稀。\n黄领青腰墟市罢，尽沽红酒夕阳归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40688,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"分宜绝句","author":"阮阅","text":"扶疏碧树想吾庐，近隔清江几舍馀。\n少听光风吹剩水，未妨萧寺曝新书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40689,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"至上高邑","author":"阮阅","text":"上蔡人归古县封，蜀江依旧水流东。\n末山云散庵犹在，敖岭丹成井已空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40690,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过算陂二首 其二","author":"阮阅","text":"湖水随风洗岸沙，笋梢成竹荻生芽。\n不知谁唤春归去，留下子规啼晚花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40691,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过算陂二首 其一","author":"阮阅","text":"湖上千山山外天，寒光翠色混轻烟。\n篮舆路转重回首，疑是松江在目前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40692,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"佛惠寺","author":"阮阅","text":"细雨斜风入乱山，湿云堆里见东关。\n一筇来访林间寺，杜宇数声春又还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40693,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"苏仙山","author":"阮阅","text":"一溪清泚万峰环，人过重重紫翠间。\n绿竹乔松三十里，云中犹未见苏山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40694,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"往知袁州道经末山","author":"阮阅","text":"斜阳骑马末山隈，淡碧晴空雁字回。\n一片愁怀似黄叶，晚风吹送九峰来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40695,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"便县怀古","author":"阮阅","text":"兔葵燕麦撼春风，废址颓垣古县封。\n聚落已迁江上去，隔林已旧雨三峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40696,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓发上高","author":"阮阅","text":"城外斜溪踏水过，不沿危磴却扪萝。\n明朝又入宜春去，想近湖湘山更多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40697,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴江百咏 其九 三怀堂","author":"阮阅","text":"东京吏治孰称循，范晔才书十二人。\n前日桂阳三太守，许谁来此继芳尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40698,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴江百咏 其二 上仙阁","author":"阮阅","text":"曲槛危梯紫翠中，苏仙宅畔古城东。\n不须更著登山屐，万岫千峰一日穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40699,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴江百咏 其八十二 久留冈","author":"阮阅","text":"颍人间欲问郴人，卫飒如何似寇恂。\n只恐当时遮道者，不应皆是惜留人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40700,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴江百咏 其四 山阴堂","author":"阮阅","text":"修竹苍苍似剡川，浮觞可继永和年。\n不知谁有羲之笔，欲写兰亭第二篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40701,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴江百咏 其八十八 飞仙桥","author":"阮阅","text":"匮中飞出过辽天，楼上归来又几年。\n云物已閒松已老，芝田依旧在桥边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40702,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴江百咏 其三十九 马岭","author":"阮阅","text":"牛山日日夕阳红，鹿洞年年草色浓。\n更有当时马行处，郴人犹指旧骡踪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40703,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴江百咏 其四十七 中洲","author":"阮阅","text":"捲地江流绕古城，参天乔木一洲横。\n年年秋雨无情甚，沙嘴才高又压平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40704,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴江百咏 其三十三 五盖山","author":"阮阅","text":"五峰如盖色苍苍，隔断蛮陬与瘴乡。\n才见山中冬有雪，郴人预说岁丰穰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40705,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴江百咏 其七十三 太平寺","author":"阮阅","text":"石虎城西郴水边，支提突兀祖灯传。\n有人认得双岩桂，何必庭前柏子禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40706,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴江百咏 其七十一 开利寺","author":"阮阅","text":"修篁乔木水西涯，古屋颓垣达磨家。\n持钵但闻僧乞供，杜门不为客烹茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40707,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴江百咏 其七十 开福寺","author":"阮阅","text":"郴江东畔小禅林，谁见当年地布金。\n夜磬一敲僧定出，水声东去月西沉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40708,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴江百咏 其四十四 王履岩","author":"阮阅","text":"勾践因何渡楚川，苍苍双石卧寒烟。\n当时纵使为淫巧，片石安能作履穿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40709,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴江百咏 其三十二 东山","author":"阮阅","text":"藜杖芒鞋过水东，红裙寂寞酒樽空。\n郡人见我应相笑，不似山公与谢公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40710,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴江百咏 其七十二 东山寺","author":"阮阅","text":"竹外长桥过水西，林中钟磬旧禅扉。\n筇迎残月僧包去，帆背斜阳客艇归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40711,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴江百咏 其二十六 东园","author":"阮阅","text":"芳春閤外茂林中，池上新桥路径通。\n谁种松篁藏古意，我栽桃李引春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40712,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴江百咏 其一 东楼","author":"阮阅","text":"危城雉堞对东山，谁创高楼十二栏。\n独鹤不来松已老，春风动处日三竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40713,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴江百咏 其二十 北园","author":"阮阅","text":"一坞春风北苑芽，满川流水武陵花。\n溪东旧观仙人宅，城内高楼刺史家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40714,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴江百咏 其十七 北湖亭","author":"阮阅","text":"檐楹山影水光中，携酒来时伴钓翁。\n四岸烟云芳草绿，一栏风雨落花红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40715,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴江百咏 其七十六 永庆寺","author":"阮阅","text":"空庭生草路生苔，寂寂荆扉小径开。\n有客试泉方到此，须知不是为僧来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40716,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴江百咏 其七十八 白虎城","author":"阮阅","text":"楚人未筑上游城，千古冤声尚未平。\n雉堞已然无石虎，不知何用昔时名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40717,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴江百咏 其二十四 白莲亭","author":"阮阅","text":"石甃方池种白莲，庵僧欲绍远公禅。\n文皮麈尾来游处，谁似庐山十八贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40718,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴江百咏 其四十一 白鹿岩","author":"阮阅","text":"风驭云轩鹤羽轻，野麋常此望霓旌。\n当时岩下藏身处，依旧春来草自生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40719,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴江百咏 其七十九 石城","author":"阮阅","text":"郴江淼淼接湘天，层壁重崖北水边。\n数日东风春浪恶，渔舟不是莫愁船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40720,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴江百咏 其六十六 会胜寺","author":"阮阅","text":"灵寿山前古梵宫，粥鱼斋鼓白云中。\n衲僧若会蒙泉意，竟与曹溪一径通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40721,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴江百咏 其八十三 刘相国书堂","author":"阮阅","text":"疏林翠竹水沧沧，问是刘公旧隐堂。\n但得青编有完传，故居寂寞亦何伤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40722,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴江百咏 其三十五 百丈山","author":"阮阅","text":"萦迂鸟道少人通，只有豺狼夜过踪。\n自衒崚嶒逾百丈，安知七十二高峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40723,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴江百咏 其二十三 竹轩","author":"阮阅","text":"轩户萧条对北垣，谁来此地种檀栾。\n无人会得青青意，雨洗风吹叶叶寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40724,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴江百咏 其九十二 西湖","author":"阮阅","text":"岸草江花对夕阳，满船新月夜鸣榔。\n秋清菡萏红千柄，风静琉璃碧一方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40725,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴江百咏 其十四 西楼","author":"阮阅","text":"危楼百尺对东山，帘幕秋风捲暮寒。\n每向残阳新月看，几人曾此凭栏干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40726,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴江百咏 其七十五 妙胜寺","author":"阮阅","text":"谁营僧舍近西城，今与行人作短亭。\n庭下秋风花簌簌，门前春水竹青青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40727,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴江百咏 其八十一 孝妇冢","author":"阮阅","text":"国史班班有旧闻，欲将重说与郴人。\n教知蔡妇潸然意，可比神仙噀酒神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40728,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴江百咏 其六十四 灵寿木","author":"阮阅","text":"聊依枯木伴寒藤，曾为当年孔傅生。\n寂寞空山穷谷里，如今文杏又争名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40729,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴江百咏 其六 灵寿庵","author":"阮阅","text":"结茅编竹对高丛，不种修篁不植松。\n但得数枝花似雪，何须裁截伴枯筇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40730,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴江百咏 其四十六 灵湫","author":"阮阅","text":"老蛟力斗死池中，山下流泉暗谷通。\n风雨年年常十五，休将涓滴强邀功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40731,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴江百咏 其二十七 苏仙观","author":"阮阅","text":"寂寂星坛长绿苔，井边橘老又重栽。\n城头依旧东楼在，未见当时鹤再来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40732,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴江百咏 其八十 苏仙祠","author":"阮阅","text":"羽节云旌事已空，旧庵今在最高峰。\n拂坛不见当时竹，系马犹存旧日松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40733,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴江百咏 其四十二 坦山岩","author":"阮阅","text":"空山夜雨鬼神愁，怪石层崖虎豹忧。\n鸟道不通车马到，只供衲子羽人游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40734,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴江百咏 其三十六 孤山","author":"阮阅","text":"瘴山蛮岭斗嵯峨，高可跻登不可磨。\n万岫千岩皆阘茸，一峰孤秀不如多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40735,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴江百咏 其四十 话石","author":"阮阅","text":"人世哓哓已不根，更堪顽石亦纷纷。\n何如缄口藏长舌，道路如今已厌闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40736,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴江百咏 其六十一 贪泉","author":"阮阅","text":"玉洁冰寒彻底清，不因汲引有亏盈。\n廉泉让水贪无异，空使时人恶此名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40737,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴江百咏 其六十 剑泉","author":"阮阅","text":"太阿气在斗牛边，报惠论雠世有仙。\n黥贼东来携败铁，地灵安肯为生泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40738,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴江百咏 其七十四 南塔寺","author":"阮阅","text":"江岸南峰对石城，僧房高在乱云层。\n台前天阔秋多月，塔上风微夜有灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40739,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴江百咏 其二十五 南楼","author":"阮阅","text":"雉堞谯楼紫翠环，红尘扰扰白云閒。\n蛮烟瘴雨千峰外，邑屋人家十里间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40740,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴江百咏 其九十三 宣风道上","author":"阮阅","text":"马蹄西去夕阳催，浓淡寒山翠作堆。\n北雁无情怕秋热，带将寒信过江来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40741,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴江百咏 其四十九 怨溪","author":"阮阅","text":"溅溅溪水石磷磷，两岸山花野草春。\n流去前滩何处问，不知当日怨何人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40742,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴江百咏 其十三 砌台","author":"阮阅","text":"翠珉斜倚若危梯，上出高城下枕池。\n不但绮罗为戏事，又将台使补庐儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40743,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴江百咏 其六十五 茶山寺","author":"阮阅","text":"莽草寒芦事不经，八峰深在乱云层。\n只因一句鹅湖谶，直至于今有此称。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40744,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴江百咏 其八十五 迷桥","author":"阮阅","text":"林花岸柳草芊芊，山下长桥跨碧川。\n往事茫茫无问处，不知迷俗是迷仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40745,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴江百咏 其六十七 香山寺","author":"阮阅","text":"十里城南古道场，一泓寒水翠微傍。\n幽人衲子时来汲，疑是山中草木香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40746,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴江百咏 其五十七 香泉","author":"阮阅","text":"僧舍灵源静不流，只供斋钵与茶瓯。\n直应老衲投薰陆，石罅云根久未收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40747,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴江百咏 其三 俯春亭","author":"阮阅","text":"城上危亭可摘云，四边山色翠为邻。\n下窥城郭无馀蕴，草色花光尽是春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40748,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴江百咏 其五十五 圆泉","author":"阮阅","text":"清冽渊渊一窦圆，每来尝为试茶煎。\n又新水鉴全然误，第作人间十八泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40749,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴江百咏 其十 射圃亭","author":"阮阅","text":"不似投壶谩雅歌，纵贤无奈罚觥何。\n若知蓬矢桑弧意，不用穿杨中鹄多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40750,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴江百咏 其八十九 栖凤驿","author":"阮阅","text":"凤出明时欲览辉，栖桐食竹屡来仪。\n空山穷谷无丹穴，肯伴鸱鸮共一枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40751,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴江百咏 其八十六 桂门关","author":"阮阅","text":"恶名辨正可无疑，已有金华学士题。\n寄语往来荆广客，鬼门关在郁林西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40752,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴江百咏 其三十八 桄榔山","author":"阮阅","text":"休言鸟道与羊肠，鸟道羊肠不可方。\n却喜年年种麰麦，山中不用有桄榔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40753,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴江百咏 其五十二 浪井","author":"阮阅","text":"可畏人情与世途，险如波浪起江湖。\n岂知荆楚山川地，坎井泓泉无处无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40754,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴江百咏 其十五 真仙亭","author":"阮阅","text":"雕甍画栋对群山，远目增明尽日看。\n无奈人心多险伪，须求拳石作峰峦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40755,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴江百咏 其八十四 窊樽","author":"阮阅","text":"山中闻有酒官泉，复有窊樽在水边。\n荆楚人皆喜群饮，见时应有口流涎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40756,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴江百咏 其六十三 郴江","author":"阮阅","text":"不分涓滴溉田畴，只有重滩碍巨舟。\n险似瞿塘并赣水，岂能如鉴泻清流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40757,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]