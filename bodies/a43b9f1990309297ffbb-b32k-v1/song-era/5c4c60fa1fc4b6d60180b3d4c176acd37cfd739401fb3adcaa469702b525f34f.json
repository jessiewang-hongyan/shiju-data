[{"title":"忆秦望照湖二境","author":"吴径","text":"东南山水古驰名，合与骚人养性灵。\n秋色欲归云转白，潮痕不到草常青。\n岩房避暑堪长往，桂楫浮春几度经。\n何事深思无暇日，宿猿崖近狎鸥汀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54101,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雁荡山","author":"释惟一","text":"四海名山曾过目，就中此景难图录。\n山前向见白头翁，自道一生看不足。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54102,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十六首 其二十三","author":"释惟一","text":"檗山养子忒婆心，斫了摩挲不惮勤。\n悖逆儿郎浑不顾，钁头掣得气凌云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54103,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"物外生涯","author":"释惟一","text":"三十馀年海上游，未曾容易下金钩。\n等闲抛掷丝纶处，虾蟹鱼龙一网收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54104,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"仙鱼驿","author":"李处讷","text":"少年常诵少陵诗，寤寐城南天下稀。\n锦屏山色行看远，阆苑风光愿与违。\n回首玉台山下路，黄粱初熟梦成非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54105,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和王微之使君齐山怀古韵","author":"曹仁海","text":"临风眺远夕阳开，雁阵横江一送哀。\n为感千秋森棨戟，不知何处是蓬莱。\n谪仙豪放空馀韵，小杜风流擅治才。\n数点烟波今古思，尊前黄菊几低徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54106,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赋新繁周表权如诏亭","author":"罗登","text":"诗礼当年学此亭，先生题作义方名。\n岂知天诏加褒美，冥合君言被宠荣。\n银组郎曹新进秩，綵衣子舍贵专城。\n一门忠孝谁能继，官荫恩先及弟兄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54107,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题楼观南楼","author":"王工部","text":"常恨闲行少，匆匆忽解鞍。\n秋风尹家宅，更得暂盘桓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54108,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"至楼观作","author":"王工部","text":"罢归关令存遗宅，羽驾真人有旧丘。\n水石自含仙气爽，烟云常许世人游。\n悠悠天道推终始，扰扰尘缨滞去留。\n君看一官容易舍，老来栖止占山陬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54109,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"张献图","text":"吾今为奉职，子莫怨鸾孤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54110,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"陈智夫","text":"花笑似留客，鸟啼如唤人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54111,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"陈智夫","text":"野花临水数枝恨，芳草连天千里情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54112,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谐谑","author":"刘郛","text":"坐上若有一点红，斗筲之器成千钟。\n坐上若无油木梳，烹龙庖凤皆成虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54113,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜宿仙都山闻松声作","author":"胡志道","text":"仙都古洞天，云阙高嵲嵲。\n新宫欣然成，碧瓦灿鳞列。\n我时宿■房，六月失烦热。\n松声起中夜，梦枕忽惊辍。\n天籁鸣虚徐，玉箫递泠彻。\n凤歌谐律吕，鹤舞想应节。\n安知非群仙，宴罢摇佩玦。\n从来筝笛耳，一洗万想灭。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54114,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"黄帝祠宇","author":"胡志道","text":"李侯神仙才，宇宙在其手。\n古篆誇雄奇，铁柱贯金钮。\n标榜黄帝祠，字画气浑厚。\n想当落笔时，云梦吞八九。\n每传风雨夜，蜿蜿龙蛇走。\n光怪发岩窦，草木润不朽。\n鬼物烦撝诃，一旦忽失守。\n随烟遽飞腾，无复世间有。\n因访山中人，石刻尚仍旧。\n谁能一新之，易若运诸肘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54115,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"隐真堂","author":"胡志道","text":"休说神仙事眇茫，出游尘世且和光。\n谁知今日真栖地，便是他年羽化乡。\n朝罢玉坛云满袖，梦回金阙月侵廊。\n兹游似觉青冥上，隐隐微闻咏洞章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54116,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"望雪阁","author":"胡志道","text":"黄帝乘云至帝乡，空留辙迹锁穹苍。\n茫茫丹鼎知何在，曳曳霓旌不可望。\n乞得溪山增气象，真成草木被恩光。\n我来睇目凭栏久，是可无情忆楚襄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54117,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"可理室","author":"胡志道","text":"百年日月马上过，赢得闲中可理生。\n绛阙清都非渺漠，寸田尺宅得经营。\n默存长使三宫在，急守须防五岳倾。\n他日功成定仙去，愿随风驭到蓬瀛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54118,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"竞秀轩","author":"胡志道","text":"几年困尘鞿，厥状浸成俗。\n比来梦魂清，胜赏得林麓。\n群峰绾烟鬟，炯炯皆在目。\n寒碧冷相射，秀气还可掬。\n哦诗三伏中，清风起幽谷。\n只恐吹我衣，化为云锦服。\n汗流籍湜辈，上下相追逐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54119,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"撷芳轩","author":"胡志道","text":"仙家日月迟，春物长芳菲。\n欲撷琼瑶英，咀嚼云腴肥。\n只恐花雾深，香气湿我衣。\n坐哦心未惬，归梦绕岩扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54120,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"练玉轩","author":"胡志道","text":"晓诵黄庭经，暮歌紫芝曲。\n若欲童子颜，轩中勤练玉。\n羽衣络霞青，云鬓颓鬒绿。\n功用信如许，庶可追妙躅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54121,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"焕照室","author":"胡志道","text":"门外无俗驾，眼中有馀清。\n上登峣峣阙，八窗皆虚明。\n三光焕尔照，万象无隐情。\n试观弄丹笔，云篆俱天成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54122,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"仙水洞","author":"胡志道","text":"升巍蹑层巅，云陛近百尺。\n平生尘土足，到此还几历。\n有岩中枵然，斧凿若天划。\n玉泉出石罅，雨点散寒碧。\n我来供茗事，松鼎煮琼液。\n馀甘生齿颊，可以醒醉魄。\n永怀鹤发翁，四顾但空壁。\n似闻便仙去，山间谩留舄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54123,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"忘归洞","author":"胡志道","text":"好山如故人，欣然见眉宇。\n又如梳晓鬟，红绿相媚妩。\n况兹爱山者，握笔喜临赋。\n有岩巉然开，欲陟纵蹇步。\n清游亦不恶，胜境得饱饫。\n扫石坐晚凉，浓翠湿冠屦。\n好花续春迟，纷纷杂红雾。\n仙家在何许，恐入桃源误。\n竟为弥日留，直待山月吐。\n谩寻流水归，不记来时路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54124,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初旸谷","author":"胡志道","text":"山岚郁苍苍，溪水流浩浩。\n纷然世上人，换易如秋草。\n奇哉三洞天，连路极深窈。\n阳崖射朝曦，先见扶桑晓。\n谁能餐九华，颜色端使好。\n仙翁蝉蜕去，遗迹不可考。\n我来惬登临，幽事费寻讨。\n悲啸闻涧猿，啁哳听啼鸟。\n平生愤懑臆，到此始一扫。\n行将袖手版，汗漫游八表。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54125,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"龙泓洞","author":"胡志道","text":"兹山何巍巍，欲上扪萝茑。\n怪石虎踞蹲，老蘖虬夭矫。\n中有古洞天，劖然若天造。\n爰从开辟来，日月自昏晓。\n神龙此蛰蟠，雷玉吐淼淼。\n每逢岁旱乾，山老必见祷。\n顾盼层云生，撖舞百川倒。\n何时谢鱼虾，昂雷腾浩渺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54126,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宝林寺","author":"申屠炯","text":"欲共高僧话，幽寻入宝林。\n途分喧寂境，座息是非心。\n老鹤栖巢稳，灵鳗蛰井深。\n山中饶胜迹，岁月几登临。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54127,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题钱知监东皋别业","author":"封万里","text":"别墅连城郭，超然远垢氛。\n蚌明宵阁见，鹤唳晓堂闻。\n翠滴阶前露，红铺水上云。\n悠悠持禄者，应愧不如君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54128,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题巫山神女庙","author":"唐耜","text":"楚泽隐巫山，翠壁开鸿濛。\n万流束长峡，怒浪日簸舂。\n朝晖澹高唐，岩阿閟彤宫。\n罘罳散烟雾，荣光绕长虹。\n恭闻云华君，少阴体冲融。\n受道紫清阙，飞化凌三空。\n徜徉江海上，千骑驰苍龙。\n羽节回天津，央央弭层峰。\n悽恻下土人，昏垫无所容。\n宝书授神禹，百灵倏奔从。\n蛟螭委鞭策，山川奠西东。\n九州免为鱼，遂成万世功。\n嗟余晚闻道，蓬心蔽倥侗。\n维舟垂崖边，再拜望遗踪。\n嶙峋山头石，云衣尚溶溶。\n缥缈玉瑛台，如在指顾中。\n童律不可问，至言谁击蒙。\n仰首天坛下，松柏悲回风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54129,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十忆 忆行","author":"李元膺","text":"屏帐腰支出洞房，花枝窣地领巾长。\n裙边遮定鸳鸯小，只有金莲步步香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54130,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十忆 忆坐","author":"李元膺","text":"椅上藤花阚面平，绣裙斜绰茜罗轻。\n踏青姊妹频来唤，鸳履贪弓不意行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54131,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十忆 忆饮","author":"李元膺","text":"绿蚁频催未厌多，帕罗香软衬金荷。\n从教弄酒春衫涴，别有风流上眼波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54132,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十忆 忆歌","author":"李元膺","text":"一串红牙碎玉敲，碧云无力驻晴霄。\n也知唱到关情处，缓按馀声眼色招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54133,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十忆 忆书","author":"李元膺","text":"纤玉参差象管轻，蜀笺小研碧窗明。\n袖纱密掩嗔郎看，学写鸳鸯字未成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54134,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十忆 忆博","author":"李元膺","text":"小阁争筹画烛低，锦茵围坐玉相攲。\n娇羞惯被诸郎戏，袖映春葱出注迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54135,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十忆 忆颦","author":"李元膺","text":"漫注横波无语处，轻拢小板欲歌时。\n千愁万恨关心曲，却使眉尖学别离。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54136,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十忆 忆笑","author":"李元膺","text":"从来题目值千金，无事羞多始见心。\n乍向客前犹掩敛，不知已觉钿窝深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54137,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十忆 忆眠","author":"李元膺","text":"泥娇成困日初长，暂卸轻裙玉簟凉。\n漠漠帐烟笼玉枕，粉肌生汗白莲香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54138,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十忆 忆妆","author":"李元膺","text":"宫样梳儿金缕犀，钗梁水玉刻蛟螭。\n眉间要点双心事，不管萧郎只画眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54139,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观前古美人图","author":"李元膺","text":"璧月尘昏琼树秋，无从百媚一回眸。\n荼蘼香度梅妆冷，鹦鹉声低玉笛幽。\n吐袖但能知祸水，逢春辄莫上迷楼。\n归来安守无盐女，不宠无惊共白头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54140,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"李元膺","text":"蓼花无数入船窗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54141,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"邛徕关","author":"朱绂","text":"九折先驱叱驭行，此心岂是不思亲。\n忠臣孝子元同道，可是王阳独爱身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54142,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题南华竹轩","author":"葛敏修","text":"不用山僧供帐迎，世间无此竹风清。\n独拳一手支颐卧，偷眼看云生未生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54143,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"罗仙观","author":"葛敏修","text":"罗仙一去二百载，马迹飞桥今尚存。\n鹤驭不为缑氏岭，桃花空出武陵源。\n千年光景驰驹隙，三级波涛透禹门。\n欲见此翁论此事，夜深无梦入庄魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54144,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"葛敏修","text":"一泻三百里，列为十八滩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54145,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"葛敏修","text":"从今益勉为忠义，一噎如何便废餐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54146,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其三","author":"葛敏修","text":"章江来自西，贡水东其源。\n合流虎头下，共注鳖口村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54147,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"奉借子进接䍦","author":"欧阳棐","text":"奉借山公旧接䍦，最宜筇杖与荷衣。\n习家池上花初盛，醉后多应倒载归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54148,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"述怀","author":"任伯雨","text":"元符庚辰岁，孟冬十二日。\n任子丞大宗，碌碌奉朝籍。\n圣主访落初，听言劳日昃。\n谏路员有阙，求人恐不及。\n谁谓方遴选，邂逅首疏逖。\n诏旨忽中授，闻命旦夕惕。\n不是忧不合，爱君忧失职。\n既忧亦复喜，不是贪禄秩。\n平生慕古人，素愿或可毕。\n精神倍疏瀹，激昂登文石。\n青云开九天，清光亲咫尺。\n每见情益交，肝胆尽剖析。\n敬承丁宁训，重许以忠直。\n自喜千载遇，奋身遑他恤。\n志欲收主威，力先排巨室。\n切齿愤钦永，刻意望夔稷。\n不数千羊皮，岂让一狐腋。\n勤勤履霜戒，不复虑不密。\n问夜欲自劳，百疏意何益。\n哀哉爱君心，不能当众嫉。\n投湘为独醒，得罪因怀璧。\n尚赖天德广，阅岁已再谪。\n仇人意未厌，穷荒必投斥。\n转海仅万里，艰危备经历。\n有时遭飓风，天地如抹漆。\n雪浪山崩颓，轰豗飞霹雳。\n扁舟甚桔槔，俯仰颠倒立。\n双樯捲欲折，绳断水蘸席。\n鲸鳄口垂涎，喷咤烟雨集。\n万怪竞周章，腥臊助嘘吸。\n平生仗忠信，安敢保瞬息。\n寅缘脱鱼腹，岛屿稍登陟。\n天气郁欲流，土色焦成赤。\n草木蒸氛雾，亭午日未出。\n荒径少人行，窸窣走虺蜴。\n居民傍溪浒，横崖户百十。\n矮屋尽棚栏，臭秽如圈枥。\n家家啖菜粥，杂米无十一。\n小鱼与细虾，相尚珍鼎食。\n鸟言纷嘲哳，卉服坌蒙羃。\n颜色尽黄肿，太半抱瘴疾。\n其风贪以淫，其俗拙以僻。\n殆非人间世，宜尔太荒阒。\n我生本匹夫，赋性自真率。\n雅有江海志，仕宦特牵迫。\n一日偶遭际，用舍何敢必。\n但思忠邪分，于国系休戚。\n周嫠不恤纬，我意何穷极。\n漆女倚门啸，我情第堙郁。\n呜呼谋身者，所宜念阴骘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54149,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"元日","author":"任伯雨","text":"忆昔东班贺紫宸，和风佳气净无尘。\n龙墀初下觚棱日，雉扇齐开玉座春。\n接武九霄曾近侍，投荒三载作流人。\n穷通忤合虽天理，俯仰寻思不为身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54150,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自叹","author":"任伯雨","text":"当年言路亦逡巡，白简青蒲十一人。\n半斥炎荒半除籍，而今无一预朝绅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54151,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"感古二首 其一","author":"任伯雨","text":"一言借谕资钟会，意在张华亦已深。\n大抵知言由养气，可怜晋武有蓬心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54152,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"感古二首 其二","author":"任伯雨","text":"指鹿奸谋岂偶然，都缘人事不由天。\n要知左右皆言马，只为当时杀正先。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54153,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿西轩","author":"任伯雨","text":"茅檐不动晚风微，独对炉烟枕半攲。\n惟有多情沙上月，依然青琐照人时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54154,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"焚香有感","author":"任伯雨","text":"扫地焚香开竹扉，轻烟郁郁閒朝晖。\n却思昔日延和殿，对罢曾携满袖归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54155,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"独坐","author":"任伯雨","text":"得丧荣枯事，悠悠过耳风。\n此身犹是幻，何物不为空。\n酒圣心常醉，诗穷语更工。\n小轩搔首坐，斜日满窗红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54156,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登狼山","author":"任伯雨","text":"狼山青青迹已陈，惟馀楼阁向南薰。\n蓬瀛气象群峰在，吴楚封疆一水分。\n野色西南平接日，潮声东北怒穿云。\n登临更有超然兴，回首尘埃不足云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54157,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"任伯雨","text":"身投魑魅家何在，泽逮昆虫罪未除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54158,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"李夔","text":"紫微风韵谪仙身，曾此徘徊今几春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54159,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题仁乐亭","author":"吕南公","text":"真山蓄幽奇，伪山逞瑰怪。\n峰峦纷变现，座席疑广大。\n未穿披云屐，对此亦清快。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54160,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"虎泉","author":"吕南公","text":"昔闻孤女子，遇虎斯泉侧。\n高僧为追诃，弭耳不敢食。\n岁月几何时，称谈如宿夕。\n故知事可传，岂限涔泓窄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54161,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"虚假行","author":"吕南公","text":"虚假复虚假，名陶不知瓦。\n养子役于人，不如生犬马。\n公私严忌讳，势利关取舍。\n奉生既疏违，丧死更苟且。\n苴麻不敢服，桐竹何由把。\n未得久哀呼，方当勤唯喏。\n百年闻罔极，一瞬经庐下。\n岂不近冠裳，驱牵到乖寡。\n沾沾荷锄子，言动只山野。\n终制负凶缞，兴辞泪如泻。\n诸儒论鄙俗，不若都人雅。\n请问雨间民，谁为称情者。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54162,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游子篇","author":"吕南公","text":"游子朱门儿，行乐畏不足。\n遐方寒苦士，自赞乞随逐。\n朝驰锦鞯末，夕宴凤屏曲。\n雄豪弃残剩，声色化耳目。\n来时布素衣，羞耻见罗縠。\n几许膏粱味，嗜好讳水菽。\n劳劳车马尘，苒苒岁月速。\n家书懒拆封，旧业废编牍。\n间尝梦故国，惊觉如被辱。\n安知惬快馀，穷愁入皮肉。\n趋承偶踰节，况味稍?局。\n长年倚恩辉，积渐致轻渎。\n因逢故人语，始叹误程躅。\n都城名利场，岂不多所欲。\n从前入关客，无虑共贫毒。\n商廛聚珍赀，科举仰廪禄。\n神乎夺我魄，而独迷所属。\n何人不谋身，计虑自不淑。\n寄声风尘子，哀恨吾已酷。\n当知帝里游，有祸亦有福。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54163,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"莓莓原上田","author":"吕南公","text":"莓莓原上田，春至早已种。\n垡垡樊间圃，蔬好亦培壅。\n农家乐地利，倚此拟微俸。\n依随节序停，领略儿孙众。\n徒耕有欢语，各息无愁梦。\n冷看里诸生，焦心望乡贡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54164,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]