[{"title":"次韵朱德裕见赠时予病初起","author":"周孚","text":"盖世功名黍一炊，惊心岁月毂双驰。\n五浆先馈那须尔，二竖相凌少避之。\n种种鬓毛吾欲老，翩翩书札子能奇。\n黄花无语秋将暮，莫惜玄谈与解颐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23898,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"病中柬课会诸友二首 其一","author":"周孚","text":"橘绿橙黄岁已秋，疏篱戢戢上牵牛。\n无方可已愤懑疾，属子一来开此愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23899,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"病中柬课会诸友二首 其二","author":"周孚","text":"寒螀唧唧报更迟，秀目疏眉费梦思。\n须信愈风元是檄，可能袪疟不因诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23900,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"良臣和前韵见贻复次韵二首 其一","author":"周孚","text":"蒲团枯几度春秋，自笑沐猴骑土牛。\n奇病撩人仍止酒，问君何计可攻愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23901,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"良臣和前韵见贻复次韵二首 其二","author":"周孚","text":"久将农圃学樊迟，欲赋三都愧左思。\n尚喜彭城汉夫子，肯加湔祓与新诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23902,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"九日风雨谩兴","author":"周孚","text":"尝闻老潘句，今日复题诗。\n积潦朝犹浅，归云晓更迟。\n断无桃叶唱，数负菊花期。\n日莫还孤坐，寒灯颇见知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23903,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"即事次杜牧之韵","author":"周孚","text":"无正文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23904,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"龚良臣知状二首 其一","author":"周孚","text":"不向辛夷树下行，老来无意赋閒情。\n可能尚似韩夫子，犹有儿曹识姓名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23905,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"龚良臣知状二首 其二","author":"周孚","text":"昔时邺下刘公干，今日周南太史公。\n两鬓似霜须似戟，不应孤负北窗风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23906,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"郊行","author":"周孚","text":"江北江南岁已霜，老筇无伴自徜徉。\n冥冥小雨朝犹剧，寂寂残花晚更香。\n自古隙驹如岁月，只今刍狗是文章。\n虚名满世知何益，付与群儿自较量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23907,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"即事二首 其一","author":"周孚","text":"漠漠冥冥氛祲多，人间何地可婆娑。\n穷途正苦身为累，老境仍嫌病作魔。\n此日苍生望安石，向时老将忆廉颇。\n周宣汉武规摹在，谁为君王赋伐柯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23908,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"即事二首 其二","author":"周孚","text":"曀曀长空蔽夕云，杖藜徙倚莫江滨。\n孤城风土偏愁客，别岸烟埃欲污人。\n谩说一言能悟汉，久疑三户解亡秦。\n风饕雪虐銮舆地，湖海无能泣病臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23909,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄闾丘仲","author":"周孚","text":"曩哦佛狸谣，别我江上宅。\n不忧道里远，但恐生死隔。\n匆匆分袂去，悲风动悽恻。\n寄声来问我，何忍试锋镝。\n憔悴山泽间，藜苋尚可食。\n寒蜗恋馀涎，欲去我未得。\n作书思报子，霜雁正戢翼。\n迩来闻吉语，草木有佳色。\n惊雷毙枭獍，甘雨厌螟?。\n崎岖各不死，仰荷天地德。\n平生长卿舍，依旧立四壁。\n君归亦莫缓，岁晚霜露逼。\n相期津上亭，沥酒酹馀厄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23910,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次龚良臣韵有感予尝言一事而验","author":"周孚","text":"君家月旦擅新评，尚复常谈记老生。\n可但龙虾元异族，不妨箕斗是虚名。\n孤怀曩日谁能会，危语今年子不惊。\n更欲为渠倾底里，晓风涩雨未全晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23911,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄陈道人","author":"周孚","text":"瘦筇盘礴越江边，笑我孤灯照夜禅。\n当日期穿水牯鼻，莫年犹著野狐涎。\n忙中弦望惊三易，圣处阶庭让一先。\n曾约芒鞋践云雨，快来相见已新年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23912,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谢时卿见过作此谢之并简德瞻二首 其一","author":"周孚","text":"索寞干戈际，交游不弃遗。\n君真斲鼻手，我愧折肱医。\n末学穷何用，虚名老不宜。\n寒窗但尘稿，难疗十年饥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23913,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谢时卿见过作此谢之并简德瞻二首 其二","author":"周孚","text":"余发已种种，子来真枉生。\n深勤两凫集，何止一牛鸣。\n晚径泥犹滑，春江岸欲平。\n论诗方有味，为我老弥明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23914,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"兵定后寄仲时","author":"周孚","text":"忆昨传丹诏，寒盟罪羯胡。\n分攻自西蜀，指日会东都。\n圣虑虽天合，臣材与古殊。\n居安空矍铄，临难竟侏儒。\n骑病嘶枯蘖，兵寒隐败郛。\n积尸朝啸鵩，遗廪夜栖乌。\n汉水空滋楚，淮山不蔽吴。\n四方俱臬兀，一死在须臾。\n避地怜之子，传声唤病夫。\n摄衣俱邂逅，揽辔复踟蹰。\n疢动羸方甚，寒凌喘未苏。\n凄凉一抔土，牢落十年雏。\n生计哀难舍，交情愧不渝。\n深劳鱼喣沫，甘作鸟栖枯。\n咄咄形容变，骎骎岁月徂。\n尝疑冒顿恶，未受郅支诛。\n神武俄潜运，明徵果不诬。\n六龙才蹀躞，群鼠已雎盱。\n虿尾兴谈次，旄头落坐隅。\n造谋由肘腋，偿祸见头颅。\n佳气盘空极，妖氛扫地无。\n微生脱纷扰，一笑起疲驽。\n喜极翻搔首，狂深屡挽须。\n飘流免僮仆，团聚对妻孥。\n败简欣重缉，颓垣得再圬。\n残年贷蒲柳，馀庆望桑榆。\n短艇来何晚，明窗昼可娱。\n作诗嘲懒慢，唤酒濯艰虞。\n我病犹能此，君行莫厌迂。\n相思倚江阁，寒雁下平芜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23915,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夜坐有怀","author":"周孚","text":"冲风凛欲冰，积雪寒未扫。\n春光来何迟，双鬓倏已老。\n悲吟北窗下，孤坐对参昴。\n不忧釜生鱼，漫谓诗可饱。\n平生赏音人，团聚苦不早。\n陈翁气金玉，蔡子文斧藻。\n仓皇一骇散，各适千里道。\n悠悠残岁月，忽忽老怀抱。\n道腴虽自味，俗况固难好。\n无疑赵居士，欲刬佛殿草。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23916,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"元日怀陈道人并忆焦山旧游二首 其一","author":"周孚","text":"故人应白发，今我尚华颠。\n旧约鸥能记，新诗雁不传。\n功名画地饼，岁月下江船。\n回首题诗处，凄凉已去年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23917,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"元日怀陈道人并忆焦山旧游二首 其二","author":"周孚","text":"昨偕赵居士，同宿赞公房。\n树暗朝疑雨，山寒夜得霜。\n经营炼丹地，拂拭坐禅床。\n忽忽红尘里，深惭钵饭香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23918,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠朱德裕宋安民以学诗如学仙为韵五首 其一","author":"周孚","text":"大儒夔踸踔，小儒鹤俛啄。\n二子虽楚产，独不困俗学。\n我见三叹息，渭清泾自浊。\n祝君但默坐，岳岳须折角。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23919,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠朱德裕宋安民以学诗如学仙为韵五首 其二","author":"周孚","text":"材俊千里驹，学问五总龟。\n前辈为青眼，多士推白眉。\n属我病作祟，浊醪不同持。\n山林有成约，捧盘盟此诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23920,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠朱德裕宋安民以学诗如学仙为韵五首 其三","author":"周孚","text":"卒卒不会面，死生两蟾蜍。\n相望一牛鸣，可忍自作疏。\n沥酒不醉我，徵诗又遗予。\n胶漆自为坚，愧我今不如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23921,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠朱德裕宋安民以学诗如学仙为韵五首 其四","author":"周孚","text":"孰知诗穷人，而我乃妄学。\n殷勤平生友，馈我破瘕药。\n百年灯落炉，万事风陨雹。\n谁能强自苦，清坐亦差乐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23922,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠朱德裕宋安民以学诗如学仙为韵五首 其五","author":"周孚","text":"佐饭止三韭，庇身唯尺椽。\n永绝富贵想，薄有香火缘。\n尚忧贪嗔痴，更著后者鞭。\n定倾与援溺，稽首西方仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23923,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"怀焦山圜禅师赠赵居士","author":"周孚","text":"钟山一马驹，蹀躞九轨路。\n才高难为兄，质妙不愧父。\n顷尝造其室，握手宛如故。\n孤灯留我语，碧眼照窗户。\n寒珠湛尘源，朝日破昏雾。\n相期白莲社，此意何可负。\n当时座间客，子亦同此趣。\n匆匆不再见，忽复岁云莫。\n冲风战夜窗，山气想凝冱。\n扁舟欲问讯，恐触蛟鳄怒。\n吾侪晚闻道，岁月忍虚度。\n声名身外鸩，文采性中蠹。\n当求一转语，共證十载误。\n春江两涘平，偕子稽首去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23924,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"促赵彦章山行","author":"周孚","text":"传声赵居士，胜践不应迟。\n旧约梅开日，俄经麦秀时。\n残花犹可醉，小雨尚能诗。\n莫作京尘客，空成了事痴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23925,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再到焦山示度书记","author":"周孚","text":"雪埋断麓元曾到，风度疏棂始再来。\n春尽幽园尚红药，雨馀荒径自苍苔。\n短筇扶病吾犹力，古锦囊诗子合开。\n第恐平生老无著，不能缚律似宗雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23926,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送陈道人之金陵","author":"周孚","text":"一筇历遍海边山，每见钟鱼便破颜。\n瘦柏形骸虽已老，断云踪迹本来閒。\n向来危死干戈际，此去相望梦寐间。\n十载光阴已虚度，欲加诃斥待君还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23927,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题苏庭藻竹堂","author":"周孚","text":"三生石上老徽之，水竹风流自一时。\n春砌阴阴翻败箨，夜窗寂寂战寒枝。\n已专嵇阮生前境，尚记羊何别后诗。\n开径相从定何日，即今已恨十年迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23928,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵度上人窗下竹","author":"周孚","text":"漫漫疑争地，疏疏巧避墙。\n少纾黄落恨，聊贷白间凉。\n秀色浸朝几，寒声到夜床。\n何须渭川口，玉立万夫长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23929,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"读佛书","author":"周孚","text":"迷途谁解反三隅，半是骑驴更觅驴。\n一滈未逢师子吼，千章虚读野狐书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23930,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送日新之池州即席时苏庭藻行方一日庭藻所居名竹堂而梅室日新自号也日新求予旧诗事冗未暇写","author":"周孚","text":"衰老何萧索，亲朋半别离。\n未终梅室语，已赋竹堂诗。\n恶况吾方剧，来书子勿迟。\n寒藤绾蛇蚓，相记待他时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23931,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠宋安民失解","author":"周孚","text":"寒林经雨叶全彫，莫向茅斋怨寂寥。\n小杜科名纵濡滞，老元诗律尚嫖姚。\n穷营败屋堪容膝，病策寒藤胜折腰。\n紬史翻经有成约，不应从此厌招邀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23932,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"朱德裕隐轩","author":"周孚","text":"十年仲蔚蓬蒿宅，老屐今朝到此间。\n惊怪名驹甘伏枥，坐令倦鸟苦思山。\n婵娟未嫁犹遭妒，矍铄虽侯可胜閒。\n一首陶公旧诗赋，要须健笔挽令还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23933,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十月即事呈彦章 其一","author":"周孚","text":"衰病今年剧，阴寒此际频。\n烟溪长作暝，霜叶不成春。\n北贡来何缓，西师信未真。\n平生绕朝策，吾亦愧斯人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23934,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十月即事呈彦章 其二","author":"周孚","text":"须发五分白，相看倍怆然。\n死吾元有命，穷子定非天。\n蓬转甘今日，丝悬忆去年。\n遥怜清夜梦，亦堕白鸥边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23935,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"哭高伯庸","author":"周孚","text":"晚雨泽丛艾，惊风倒枯松。\n苍苍固无神，此语疑可从。\n十年江南岸，与君每从容。\n披翻俱败简，登眺同老筇。\n平生毁誉半，意子陈元龙。\n方期万里行，忽与二竖逢。\n哀音忆初闻，一恸几摧胸。\n岁月逝不留，炎曦已成冬。\n惟昔在世日，最厚庞与龚。\n联翩奇祸作，摧此西峙峰。\n凄然荷锄地，谁复伴老慵。\n稚儿亦可怜，见我犹能恭。\n勿说山巨源，吾今愧渠侬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23936,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"岁莫有怀存没次旧韵柬德裕安民","author":"周孚","text":"岁莫忽不乐，哦诗忆同裳。\n百忧从中来，孰谓酒可忘。\n昔我二三友，芳兰閟孤香。\n悠悠十载间，屈指略丧亡。\n搴花欲谁遗，怅然结中肠。\n二子后来秀，双凤鸣朝阳。\n胡不相暖热，矧我病在床。\n只应鹏与鴳，飞舞不并行。\n春圃可撷秀，晓陂可垦荒。\n会将两芒屦，同践林下霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23937,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄苏庭藻二首 其一","author":"周孚","text":"苏子文章旧起予，英英寒玉琢冰壶。\n十年不见空青眼，一日相逢各白须。\n可是封侯须望尉，只今著论又潜夫。\n青灯寂寞秋堂夜，叹息寒衾梦亦无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23938,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄苏庭藻二首 其二","author":"周孚","text":"双井原头秋草合，峨眉山下莫烟深。\n看人竞改元和格，期子重赓正始音。\n高论与时终落落，新诗过我太骎骎。\n著鞭一语君须记，世事由来畏有心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23939,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"喜日新至","author":"周孚","text":"冲风冲雨何时了，忽忽归来岁又冬。\n老弟世缘真嚼蜡，病兄术业亦屠龙。\n寒灯眩目何妨暗，浊酒浇胸莫厌浓。\n庞子高郎已芜没，两穷相对且从容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23940,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次崔端甫韵席上","author":"周孚","text":"寒窗一再雨，幽径两三花。\n老境吾犹健，春筵此最佳。\n清尊泛寒蚁，醉墨落栖鸦。\n笑语崔夫子，相逢即是家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23941,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠游元著","author":"周孚","text":"老去尘冠耻再弹，只将尊酒对青山。\n已忘穴蚁三生梦，长伴江鸥一味閒。\n止许傍城开竹径，会容扶策叩柴关。\n平生月旦乡评在，著我诸晁伯仲间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23942,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"代人张抚干母挽辞","author":"周孚","text":"自愧升堂旧，乡闾复外姻。\n那知伏枕日，正值辍舂辰。\n帉帨方长夜，蘋蘩忍独春。\n谁传绛帐学，季子本天麟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23943,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"龚良臣无恙日手抄圭粹中诗数十篇见遗良臣既没于书箧中见之怆然有感因次圭卒章韵以寓哀","author":"周孚","text":"老屋愔愔昼掩门，清才妙质苦思君。\n屠龙每叹平生学，下马谁寻此日坟。\n痛惜黄垆埋玉树，忆曾玄鹤困鸡群。\n西华牢落今安否，见说居莸不改薰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23944,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次间字韵送德裕太学试","author":"周孚","text":"人如景德咸平际，文到贞元大历间。\n种树有谁甘避世，著书喜子未藏山。\n自怜斥鴳空溟海，须信名驹合帝闲。\n十载天荒谁与破，政须力夺锦标还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23945,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次崔隐叟韵赠端甫","author":"周孚","text":"与子相从自小年，孰知术业是家传。\n胸中雄略堪推毂，笔下新诗近著鞭。\n共叹飘蓬真命尔，相看樗散却天然。\n紫萸黄菊何时办，要拍洪崖醉后肩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23946,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"清明日余与诸友游招隐山寺酌酒宋氏园亭谒苏才翁墓而归","author":"周孚","text":"小雨冥冥欲作泥，晨光不负老人期。\n绿阴苍藓初分坐，白石清泉共赋诗。\n酌醴焚鱼谩今日，卖刀买犊定何时。\n伤心紫阁飞杨老，千载茫茫只断碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23947,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"触目六言二首 其一","author":"周孚","text":"正似冉溪溪上，祇欠八愚老翁。\n陂外萦青缭白，风前骇绿纷红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23948,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"触目六言二首 其二","author":"周孚","text":"陂空凫鹜何在，寺古钟鱼或无。\n山气阴阴欲雨，仆姑端解欺予。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23949,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"朱德裕以言念君子为韵赋诗见寄次韵答之四首 其一","author":"周孚","text":"昔别柳未花，浓绿今映门。\n日月不吾淹，盗骥更惊奔。\n佳人渺天末，有志谁与言。\n床头觅尘编，遮此老眼昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23950,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"朱德裕以言念君子为韵赋诗见寄次韵答之四首 其二","author":"周孚","text":"句曲一老翁，早岁困铅椠。\n整冠缨为绝，晚境尤可念。\n闻君从之游，琢磨去瑕玷。\n何时雷夫子，斸此两龙剑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23951,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"朱德裕以言念君子为韵赋诗见寄次韵答之四首 其三","author":"周孚","text":"奏金蟋蟀间，子亦有异闻。\n引吭与相和，愧我言不文。\n交情谅石友，风味真曲君。\n可无一杯水，与我湔垢氛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23952,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"朱德裕以言念君子为韵赋诗见寄次韵答之四首 其四","author":"周孚","text":"夺薰以其莸，败素以其紫。\n古来辟世士，政复门扫轨。\n君看草玄翁，肯迩夸毗子。\n芳兰生深林，如此乃士耳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23953,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"焦山度书记以诗见寄因次韵","author":"周孚","text":"突兀苍崖百丈馀，忆曾随处小踌躇。\n江非滟滪吾何畏，山似楞伽子合居。\n当日胜游同转毂，迩来清境属舂锄。\n支郎不念平生友，华发刁骚已映梳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23954,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"勉洪致远龚良臣与致远善时已亡","author":"周孚","text":"人生多忧虞，此语传自古。\n诗书不赒饥，士亦倍龃龉。\n忆子少年时，落笔敏风雨。\n自言名家驹，朝冀夕秣楚。\n那知十载后，败甑不炊午。\n括囊经济策，郁郁卧环堵。\n呻吟谁与伴，坏壁响饥鼠。\n长松要霜雪，念子果如许。\n穷通何必较，人世几寒暑。\n生前千驷马，身后一丘土。\n那知五君咏，老魄弃大数。\n安得彭城生，从旁證吾语。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23955,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次德裕饷人参韵","author":"周孚","text":"参墟有神草，饱历雪霜寒。\n黄鹄何缘致，玄珠欲报难。\n仍烦一藜杖，来对两蒲团。\n卧病干戈里，劳君为控抟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23956,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雨自四月至七月暑热不能堪作此寄德裕安民二首 其一","author":"周孚","text":"一牛鸣地无多远，褦襶经过恐不宜。\n风雨潇潇自蚕月，光阴忽忽又瓜时。\n缅怀胜践真成梦，尚喜穷居不废诗。\n肯赴凉秋通夕约，短瓶储粟为君炊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23957,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雨自四月至七月暑热不能堪作此寄德裕安民二首 其二","author":"周孚","text":"才晴便有蒸炊厄，未雨先怀重膇忧。\n岂为形骸悲莫景，政因风土忆中州。\n雷麋老木谁能赋，鸢堕空江始欲愁。\n解洗新亭迩来恨，清谈还待贾长头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23958,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]