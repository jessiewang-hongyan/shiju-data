[{"title":"题县簿清心亭","author":"邹极","text":"君向池边展旧亭，坐临止水觉心清。\n暑风菡萏尘难染，霜月苍烝节更明。\n对酒独醒公外况，隔墙人语静中声。\n谁怜老凤堪栖棘，梦断韶音奏九成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52094,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游曹山","author":"邹极","text":"一到重来二纪馀，身閒方误昔迷途。\n龙回涧合木长润，圣隐岩空峰转孤。\n自放山林随处适，相逢云水有心无。\n野僧见我犹生敬，我即休官祇旧儒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52095,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赤松寺书事","author":"邹极","text":"宅畔池台景自幽，御风更作赤松游。\n岚光浓丽经梅雨，天气凄清正麦秋。\n插稻农夫晨赤脚，缫丝蚕妇昼蓬头。\n閒身免赴公家急，饱食无心为汝谋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52096,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"石䂬潺湲亭","author":"邹极","text":"危亭跨幽涧，涧水日潺湲。\n响与鼓钟应，静无车马喧。\n布金因利物，漱玉自澄源。\n练引千寻远，珠倾万斛繁。\n倚空横石壁，夹岸带山樊。\n涨骇天河决，湍流地轴翻。\n僧栖真梦觉，客至涤尘烦。\n不尽登临意，忘言愧有言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52097,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"邹极","text":"愿君早作归来计，同醉园林二十春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52098,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"邹极","text":"休缘招隐空生叹，自是中心悦美官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52099,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其三","author":"邹极","text":"如君报国须终老，閒健归来只一翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52100,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"释道楷","text":"吾年七十六，世缘今已足。\n生不爱天堂，死不怕地狱。\n撒手横身三界外，腾腾任运何拘束。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52101,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"妙唱不干舌偈","author":"释道楷","text":"刹刹尘尘处处谭，不劳禅子善财参。\n空生也解通消息，花雨岩前鸟不嗛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52102,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"死蛇惊出草偈","author":"释道楷","text":"日炙风吹草里埋，触他毒气又还乖。\n闇地若教开死口，长安依旧绝人来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52103,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"解针枯骨吟偈","author":"释道楷","text":"死中活得是非常，密用他家别有长。\n半夜髑髅吟一曲，冰河红燄却清凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52104,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"铁锯和三台偈","author":"释道楷","text":"不是宫商调，谁人和一场。\n伯牙何所措，此曲旧来长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52105,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"古今无间偈","author":"释道楷","text":"一法元无万法空，个中那许悟圆通。\n将谓少林消息断，桃华依旧笑春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52106,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄伊阳宰韩承议偈 其一","author":"释道楷","text":"老爱依山人事稀，虎驯庵畔怪来迟。\n寥寥石室尘埃满，不知何日是归期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52107,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄伊阳宰韩承议偈 其二","author":"释道楷","text":"数里无人到，山黄始觉秋。\n岩间一觉睡，忘却百年忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52108,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答僧","author":"释庆璁","text":"东山西岭青，雨下却天晴。\n更问个中意，鹁鸠生鹞鹰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52109,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂","author":"释玄本","text":"看经不识经，徒劳损眼睛。\n欲得不损眼，分明识取经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52110,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"释觉海","text":"碧落静无云，秋空月有明。\n长江瑩如练，清风来不歇。\n林下道人幽，相看情共悦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52111,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"释圆照","text":"片月浸寒潭，微云满空碧。\n若于达道人，好个真消息。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52112,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"释慧通","text":"从无入有易，从有入无难。\n有无俱尽处，且莫自颟顸。\n举来看，寒山拾得礼丰干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52113,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"释慧宪","text":"我有一条拄杖，寻常将何比况。\n采来不在南山，亦非昆崙西嶂。\n拈起满目光生，放下骊龙缩项。\n同徒若也借看，卓出人中之上。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52114,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"释元善","text":"君问西来意，马师踏水潦。\n若认一毛头，何曾知起倒。\n劫火才洞然，愚夫觅乾草。\n宁知明眼人，为君长懊恼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52115,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"释用机","text":"清平过水，投子卖油。\n一年三百六十日，不须频向数中求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52116,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"辞众偈","author":"释法明","text":"平生醉里颠蹶，醉里却有分别。\n今宵酒醒何处，杨柳岸晓风残月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52117,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"释真觉","text":"善慧遗风五百年，云黄山色祇依然。\n而今祖令重行也，一句流通遍大千。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52118,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈 其一","author":"释祖镜","text":"兰芳春谷菊秋篱，物必荣枯各有时。\n昔毁僧尼专奉道，后平道佞复僧尼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52119,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈 其二","author":"释祖镜","text":"吾顶从来似月圆，虽冠其发不成仙。\n今朝抛下无遮障，放出神光透碧天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52120,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈 其三","author":"释祖镜","text":"如来昔日贸皮衣，数载惭将鹤氅披。\n还我丈夫调御服，须知此物不相宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52121,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈 其四","author":"释祖镜","text":"为嫌禅板太无端，岂料遭他象简瞒。\n今日因何忽放下，普天致仕老仙官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52122,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈 其五","author":"释祖镜","text":"达磨携将一只归，儿孙从此赤脚走。\n借他朱履代麻鞋，休道时难事掣肘。\n化鹏未遇不如鹍，画虎不成反类狗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52123,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈 其六","author":"释祖镜","text":"今朝拄杖化为龙，分破华山千万重。\n珍重佛心真圣主，好将尧德振吾宗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52124,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"释祖镜","text":"一池荷叶衣无尽，数树松花食有馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52125,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"临终示偈","author":"释悟新","text":"说时七颠八倒，默时落二落三。\n为报五湖禅客，心王自在休参。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52126,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"淩云行","author":"张商英","text":"麻姑何代仙，南城有遗坛。\n双练飞绝巘，天风逼人寒。\n枯螺抱怪石，几见海水乾。\n清都在何许，烟雾不可干。\n宫阙镂白玉，辎軿驾朱鸾。\n念非粗浊质，可以超云端。\n冲虚尽尘滓，变化生羽翰。\n悠悠戚施子，汲汲营餔餐。\n颀然硕且大，躯干压马鞍。\n奉养恐不至，齿发忽已残。\n呼吸一时绝，枯骸积巑岏。\n膝行望碧落，霄露零衣冠。\n愿闻道之妙，不用掷米丹。\n人间宁足乐，弃去夫何难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52127,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过梁口","author":"张商英","text":"迢迢一水绕千山，桑柘阴阴聚落宽。\n好事莫传江上信，渔樵自不识衣冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52128,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠玉岩","author":"张商英","text":"四围岩谷上通天，岩底幽人抱腹眠。\n不羡庄鹏抟九万，肯随齐客列三千。\n养成白雪高歌调，散尽黄金有简编。\n野鹿今朝入城市，为余有意下林泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52129,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"睢阳五老图","author":"张商英","text":"德政调元向道閒，天朝诏许实辞冠。\n丹心耿耿悬象魏，青史昭昭照玉桓。\n晚节友贤阳凤暖，老年忧世谷驹寒。\n太平犹自存龟鉴，后进仪刑仰慕看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52130,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蒋坊寺赐老僧","author":"张商英","text":"九十光阴欠五年，寒灰枯木老云泉。\n眼明尚可穿针鼻，齿硬犹能嚼石莲。\n疑是合知诸佛印，果然别得一枝禅。\n不因看破真赃物，安得囊中出小编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52131,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"香林院","author":"张商英","text":"瑟瑟松上风，冥冥竹间露。\n窗虚簟色寒，石侧苍苔古。\n长廊寂无人，殿阁下铃语。\n此意两萧然，徘徊不能去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52132,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"金精山留题","author":"张商英","text":"秦亡项灭汉罢兵，分王宗室皆连城。\n西方女子不用事，张氏有妇怀金精。\n吴山之下吴水曲，石鼓峰峦翠相矗。\n山幽水邃闺阁严，二八芳年貌如玉。\n吴王闻知心欲狂，珠琲缯纩罗千箱。\n苦凭青翼致消息，陈说富贵誇膏粱。\n玉人冷笑吾当许，汝第为吾开洞府。\n洞成赋诗悲下土，悲哉下土人皆苦。\n飘飘仙袂淩上苍，天街昴毕腾辉光。\n使回千里涩进步，目极五云空断肠。\n吴王悒悒忽不乐，入顾后宫情索寞。\n仙凡会合竟何年，多谢君王凿洞天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52133,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"孤愤吟二首 其一","author":"张商英","text":"平津谀武帝，尧舜未为聪。\n归来东阁士，称颂比周公。\n势利变人心，上下交相蒙。\n低颜望眉睫，一喜生春风。\n优游卒兹岁，安知朝野空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52134,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"孤愤吟二首 其二","author":"张商英","text":"青青一本桑，下可百夫息。\n泠泠一井泉，上有千人汲。\n千里以为郡，百里以为邑。\n生齿岂不繁，教化繄尔力。\n何事北窗人，叹此徒劳职。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52135,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽老苏先生","author":"张商英","text":"近来天下文章格，尽是之人咳唾馀。\n方喜丘园空穗帐，何期箫吹咽轜车。\n一生自抱萧张术，万古空传杨孟书。\n大志未酬身已没，为君双泪湿衣裾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52136,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题关公像","author":"张商英","text":"月缺不改光，剑折不改铓。\n月缺白易满，剑折尚带霜。\n势利寻常事，难屈志士肠。\n男儿有死节，可杀不可量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52137,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"护国寺","author":"张商英","text":"薄宦区区可叹嗟，寂寥寒馆过村家。\n神锥岂向囊中出，宝剑聊凭醉后誇。\n就禄勉持毛义檄，读书空满惠生车。\n掩关不识青春好，一夜狂风已落花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52138,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与刘跛子饮市桥","author":"张商英","text":"迁客湖湘召赴京，轮蹄迎迓一何荣。\n争如与子市桥饮，且免人间宠辱惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52139,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游天平山","author":"张商英","text":"洞天金阙天平爵，层■石崖寒玉削。\n突兀云生缥缈间，鬅松树大侵寥廓。\n苍鹿挨摧北斗魁，耍猿弄损南辰角。\n碑文压破石鳌头，琅玕烂折玉兔脚。\n背岩松柏碧森森，向日杂花红灼灼。\n遮碍林虑半壁天，琢成云汉千里壑。\n宫宰炉烧延寿香，避秦采得长生药。\n风物依稀紫府宫，岚光缭绕朱陵阁。\n路转樵人目下迷，桃源仙子心无错。\n千形万状天平山，剖判玄黄天地作。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52140,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题天平山扑猪岭","author":"张商英","text":"玉皇不禁上天梯，半筑临崖与斗齐。\n昨日我因寻药到，祇疑惊起日中鸡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52141,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"见山亭","author":"张商英","text":"帘捲疏烟醉眼开，浮云飞尽见崔嵬。\n苦嗟霖雨遮藏久，深谢晴风列致来。\n丹桂有时明月满，旧山无路白猿哀。\n禅僧指我真空理，心火茫然一夜灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52142,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游青原山","author":"张商英","text":"所至纷纷簿领堆，也须风月洗尘埃。\n明朝相与寻师去，况是同行掉臂来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52143,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"华阳洞","author":"张商英","text":"素虎斑虬蹑紫烟，几看沧海变桑田。\n赤城玉笥寻真后，又到华阳第八天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52144,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"涢阴亭","author":"张商英","text":"驾言晨出涢台隅，涢上登临酒拍壶。\n不似岘山羊叔子，心随汉水欲吞吴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52145,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东台","author":"张商英","text":"迢迢云水涉峰峦，渐觉天低宇宙宽。\n东北分明睹大海，西南咫尺望长安。\n圆光化现珠千颗，耸日初升火一团。\n风雨每从岩下起，那罗洞里有龙蟠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52146,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南台","author":"张商英","text":"迢迢策杖上南台，北望清凉眼豁开。\n二片烟霞笼紫府，万年松径锁苍苔。\n人游灵境涉溪去，我访真容踏顶来。\n前后三三知者少，衲僧到此费徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52147,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西台","author":"张商英","text":"宝台高峻足穹苍，狮子遗踪八水傍。\n五色云中游上界，九重天外看西方。\n三时雨泪龙宫冷，一夜风飘月桂香。\n土石尚能消罪障，何劳菩萨放神光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52148,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"北台","author":"张商英","text":"北台高峻碧崔嵬，多少游人到便回。\n怕见目前生地狱，愁闻耳畔发风雷。\n七星每夜沾峰顶，六出长年积涧隈。\n若遇黑龙灵懆者，人间心念自然灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52149,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中台","author":"张商英","text":"中台岌岌最堪观，四面林峰拥翠峦。\n万壑松声心地向，数条山色骨毛寒。\n重重燕水东南阔，漠漠黄沙西北宽。\n总信文殊归向者，大家高步白云端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52150,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"净明塔","author":"张商英","text":"月满汾川宝铎寒，谁来此地葬金棺。\n育王得道行空际，尊者飞光出指端。\n天上凝云常覆定，人间劫火漫烧残。\n三千世界无留迹，聊向阎浮示涅槃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52151,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"圣灯","author":"张商英","text":"云贴西山日出东，一轮明相现云中。\n修行莫道无榜模，只恐修行落断空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52152,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"解脱禅师道场","author":"张商英","text":"圣凡路上绝纤痕，解脱文殊各自论。\n东土西天无着处，佛光山下一龛存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52153,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秘魔岩","author":"张商英","text":"阅尽龙宫五百函，三年不下秘魔岩。\n须知别有安身处，脱却如来鹘臭衫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52154,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宋老生殉难诗","author":"张商英","text":"血战保孤城，嗟哉宋老生。\n身甘殉隋难，义不屈唐兵。\n骨已尘埃尽，光犹日月争。\n裴刘等死耳，谁重复谁轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52155,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和前韵","author":"张商英","text":"东湖水落露堤沙，舟过湖心藻荇斜。\n野径小桥穿竹巷，烟村疏柳间芦花。\n新粳炊熟胭脂白，活鲫珍于丙穴嘉。\n饮散肩舆乘皓月，烛笼何用两行纱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52156,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠博士承议","author":"张商英","text":"南归迁客气平和，磊落胸中所得多。\n白日过从唯陆谞，清宵梦想适维摩。\n裴徊未忍捐鸡肋，寂寞犹能顾雀罗。\n好与乡人敦薄俗，莫因哺啜负岷峨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52157,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和孙右司沅州道上过元夕","author":"张商英","text":"三五皇州夜色鲜，使车方事武陵蛮。\n华灯邈想端门外，翠辇初临太一还。\n月满九衢闻舜乐，云开双阙见尧颜。\n自怜风雨新城道，陟彼崔嵬我马艰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52158,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"平阳道中过上元","author":"张商英","text":"元夕吾何处，吾行次晋郊。\n乐棚垂苇席，灯柱缚松梢。\n俚妇朱双脸，村夫赤两骹。\n春田誇积雪，酒胆醉仍嘐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52159,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上元秭归溪西社火点灯 其一","author":"张商英","text":"百丈游灯绕石坡，溪西保社事黄魔。\n草花灼灼迎新福，腰鼓鼕鼕踏旧歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52160,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上元秭归溪西社火点灯 其二","author":"张商英","text":"溪西灯社宝莲台，一点光明远更开。\n料得长杨宫里见，却疑仙火下云来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52161,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和刘尉赤岸上巳 其一","author":"张商英","text":"教池天气不胜情，携手聊同陌上行。\n洛禊嬉游修故事，楚歌欢笑集村氓。\n慕潘珍果盈车掷，挑卓幽琴满座倾。\n为报兰亭王逸少，且无今日管弦声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52162,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和刘尉赤岸上巳 其二","author":"张商英","text":"采兰时节近清明，朝野欢娱值太平。\n坦率从来如庾亮，穷愁素不学虞卿。\n三年阳渚成何事，一觉邯郸悟此生。\n把酒花前须醉倒，肯教风雨落繁英。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52163,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上巳舣舟汉口命驾凤栖成二绝句 其一","author":"张商英","text":"上巳嬉游集汉阳，云收雨霁日舒光。\n瑞烟和气横寥廓，何用兰亭祓不祥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52164,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]