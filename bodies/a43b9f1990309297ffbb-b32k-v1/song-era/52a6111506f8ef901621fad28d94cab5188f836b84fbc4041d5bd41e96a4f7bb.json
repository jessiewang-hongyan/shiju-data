[{"title":"伯兄新楼十首 其五","author":"王柏","text":"投西眼力拓天宽，收得烟林透入关。\n双鹜断霞飞不尽，九峰斜抹有无间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16767,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"伯兄新楼十首 其四","author":"王柏","text":"野色晴晖展画屏，绿槐古樾两娉婷。\n却嫌一带无情竹，只放金华半段青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16768,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"伯兄新楼十首 其三","author":"王柏","text":"东山护晓日葱昽，一簇楼台紫翠中。\n鸳瓦露漙鳞甲动，参差翚影挂斜红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16769,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"伯兄新楼十首 其二","author":"王柏","text":"不嫌陋巷据坡头，旋斸烟莱著小楼。\n面面有山殊不恶，倚阑销尽半生愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16770,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"伯兄新楼十首 其一","author":"王柏","text":"敛墙缩地保邻欢，巧作规模不见悭。\n初转层梯心似隘，一开窗了便宽闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16771,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"呆官人三绝 其三","author":"王柏","text":"呆本非嘉德，如何乐此名。\n能于呆外看，方见业之精。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16772,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"呆官人三绝 其一","author":"王柏","text":"直道难行久，前程岂易裁。\n逊斋姜辣口，奄有世间呆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16773,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"呆官人三绝 其二","author":"王柏","text":"冷面无惭色，真心不脱空。\n虽然呆在我，终是与人忠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16774,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"张子房","author":"王柏","text":"圯上相逢一老翁，诛秦蹙项笑谈中。\n报韩偶得刘郎用，更有商山听下风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16775,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赤松夜宿","author":"王柏","text":"香火悠长仙力重，山川布濩妙难控。\n诗魂飞绕翠屏中，冷雨疏风时入梦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16776,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和玉成书秋台诗卷韵","author":"王柏","text":"龙蛇笔底盘枯藤，两卷风骚泣鬼神。\n此是玉成衣钵处，他年出语定惊人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16777,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和叔崇清明后四绝 其一","author":"王柏","text":"把酒留春尚肯留，几多生意聚诗眸。\n可怜桃李无涵养，只有桑麻自进脩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16778,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和叔崇清明后四绝 其三","author":"王柏","text":"昌黎空作送春诗，只道门前柳絮飞。\n岂识一犁江上雨，春风于此大知非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16779,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和叔崇清明后四绝 其二","author":"王柏","text":"安期老子肯过从，每恨清尊不肯空。\n好句忽来今日雨，高情终是古人风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16780,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和叔崇清明后四绝 其四","author":"王柏","text":"缓步微吟竹一枝，情怀不比少年时。\n少年春思无归宿，却是如今老会嬉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16781,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和易岩木犀韵 其二","author":"王柏","text":"对花只是月宫游，浥彼黄流注玉舟。\n莫被清光虚度了，此生更有几中秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16782,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和易岩木犀韵 其一","author":"王柏","text":"昨夜西风作意凉，吹开粟粟绕枝黄。\n有时月窟閒来往，天上人间一样香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16783,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和前人韵 其一","author":"王柏","text":"屡作家书欲寄人，姓名愁堕软红尘。\n眼边忽见伤春句，屈指别来犹是春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16784,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和前人韵 其二","author":"王柏","text":"庭前日日见兰芽，谁把青山特地遮。\n雁影寂寥君又远，归期夜夜卜灯花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16785,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和前人韵 其一","author":"王柏","text":"名山终是欠徘徊，小队轻车决意来。\n他日相思无觅处，殷勤先赠岭头梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16786,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和前人韵 其二","author":"王柏","text":"山灵岂是少恩哉，两载从容自不来。\n羊石岂能留得住，和羹消息到寒梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16787,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和乘雪游山韵 其一 遥想清致","author":"王柏","text":"千丈层崖玉作堆，瑶林璀璨路萦回。\n寒光彻骨清无敌，第一轩中第一杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16788,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和乘雪游山韵 其二 自安清况","author":"王柏","text":"肃然穷巷冻堆堆，高卧袁生梦正回。\n拥鼻微吟烧榾柮，茅柴也荐两三杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16789,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"拜明招二先生墓有感 其三","author":"王柏","text":"一原英魄一山藏，回首怀忠道路长。\n天意未开南北限，要教北学王南方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16790,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"拜明招二先生墓有感 其六","author":"王柏","text":"研席尝栖一柏堂，至今鱼鼓诉凄凉。\n溪山不掩中和气，发见随时草木香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16791,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"拜明招二先生墓有感 其二","author":"王柏","text":"神皋王气点腥膻，爵命今年下日边。\n俎豆孔堂新剑佩，风烟晋国旧山川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16792,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"拜明招二先生墓有感 其九","author":"王柏","text":"束发家庭识所宗，平生心在瓣香中。\n白头始下券台拜，的的精诚自感通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16793,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"拜明招二先生墓有感 其一","author":"王柏","text":"忆昔龙门续断弦，荥阳一脉浚家传。\n谁知丽泽收声蚤，梦奠于今八十年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16794,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"拜明招二先生墓有感 其五","author":"王柏","text":"炯炯长空一片心，东南鼎立统斯文。\n卷藏万古春归去，只有馀光在此君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16795,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"拜明招二先生墓有感 其八","author":"王柏","text":"多少门人迹已空，后生久矣失遗风。\n圣贤立教无今古，时有污隆道不穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16796,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"拜明招二先生墓有感 其十","author":"王柏","text":"仲氏孤忠彻九天，青原淡月惨遗篇。\n摩挲朱子呜呼字，寂寂庭前重怆然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16797,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"拜明招二先生墓有感 其七","author":"王柏","text":"竹舆侵晓出山阿，宿露清圆忆旧哦。\n当日解衣盘礴意，明明分付一池荷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16798,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春雪两绝 其二","author":"王柏","text":"无端雨雪恣痴顽，弱甚东君太失权。\n一白但为群丑幸，雪消群丑只依然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16799,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春雪两绝 其一","author":"王柏","text":"开岁晴天亦太悭，六花日日舞檐端。\n浑然一色无分别，也把梅花作雪看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16800,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"独坐看海棠二绝 其二","author":"王柏","text":"沈香亭下太真妃，一笑嫣然国已危。\n当日杜陵深有恨，何心更作海棠诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16801,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"独坐看海棠二绝 其一","author":"王柏","text":"万翠千红各赋形，源源生意到春深。\n谁开锦帐藏妖艳，应是东皇有荡心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16802,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋兴 其一","author":"王柏","text":"年少荒唐德颇惭，了无佳客伴清谈。\n相亲幸有坡诗在，秋晚堂深灯一龛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16803,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋兴 其二","author":"王柏","text":"巷底萧萧绝市尘，供愁疏雨打黄昏。\n悠然一曲泉鸣调，烧了夜香深闭门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16804,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"除夜访杨此斋 其二","author":"王柏","text":"一别癯仙已八年，伶俜鹤骨尚弹冠。\n相逢逆旅欢然处，各著精神子细看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16805,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"除夜访杨此斋 其一","author":"王柏","text":"除夕家家整世氛，老来天赐一閒身。\n正当风雪翻空急，面拂冰花访故人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16806,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"涂中即景","author":"王柏","text":"溪边柳色露新芽，春透微波漠漠斜。\n一阵随风香颇异，定知前面有梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16807,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陶渊明","author":"王柏","text":"义熙鼎向寄奴轻，归去来兮绝宦情。\n特笔谁书晋处士，千年心事一朝明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16808,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿宁庵闻溪声","author":"王柏","text":"清溪泻出瀑泉鸣，记得昌黎语不平。\n要识中流多峙柱，故能千古振英声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16809,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题江山叶氏翠香亭 其二","author":"王柏","text":"遥想琅玕百顷强，旋栽应笑子猷忙。\n绝怜羽葆摇新绿，更有风来细细香。","collectio