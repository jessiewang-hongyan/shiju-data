[{"title":"次韵陈登父桃花","author":"俞德邻","text":"台隶群芳散绮葩，繁枝密干蔚交加。\n武陵溪畔秦人洞，濯锦江头杜老家。\n风搅乱红春过雨，露滋微艳晓笼霞。\n长安重到应惆怅，寂寞玄都燕麦斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35265,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠蒋文学三首 其一","author":"俞德邻","text":"车声马迹任营营，芦溆襄羊境最清。\n万卷图书双鬓老，五湖烟浪一舟轻。\n忘机已信驯鸥狎，洗耳那愁斗蚁惊。\n更喜瓯窭秧水足，倚风扶杖看春耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35266,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠蒋文学三首 其二","author":"俞德邻","text":"庞眉鹤发一诗翁，肯伴渔夫理钓筒。\n芦溆柳塘新涨外，竹篱茅舍晚烟中。\n乡书再捧衣犹白，村酒频沽颊借红。\n万事无言归一笑，仲车元不是真聋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35267,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠蒋文学三首 其三","author":"俞德邻","text":"忆昔携书衮绣堂，扁舟曾此濯沧浪。\n苍龙飞去未成雨，老鹤重来知几霜。\n人物半凋嗟世事，典刑犹在得诗章。\n何当去卜西枝隐，同汎渔舟夜击榔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35268,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"记梦","author":"俞德邻","text":"云封槐里黯平芜，无复鱼灯照玉凫。\n乐奏马惊犹奋鬣，鼎成龙去莫攀胡。\n老归燕国常悲陇，梦断荥河偶得图。\n淳景布衣今白发，西风搔首独踟蹰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35269,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"午睡","author":"俞德邻","text":"赤米黄齑雪白盐，图书满架绝韬钤。\n百年无补孔融愧，三叶不遭颜赐潜。\n去住任如巢幕燕，间关谁学上竿鲇。\n幽居暇日知何事，一半清谈半黑甜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35270,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"泛湖","author":"俞德邻","text":"閒居散人事，一舸泛长湖。\n夜雨半篙荇，春风十幅蒲。\n功名槐国梦，身世辋川图。\n舣岸逢林叟，清谈日又晡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35271,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金坛郊外","author":"俞德邻","text":"散屧过平堤，前村雨一犁。\n草荒翁仲立，树密鹧鸪啼。\n野色连天远，溪光隔岸迷。\n干戈犹未息，何处足幽栖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35272,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"八月十五夜","author":"俞德邻","text":"捲尽顽云玉漏中，月华如水浸层空。\n一轮圆缺常时见，万里阴晴此夜同。\n突兀楼台犹昔日，高低禾黍自秋风。\n转蓬地远归心折，尚想霓裳舞旧宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35273,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"观潮","author":"俞德邻","text":"彊弩驱潮水为东，昔年此地识英雄。\n素车白马空明上，青盖红旗灭没中。\n十万军声西塞月，三千鲲浪北溟风。\n乘槎有约终须去，见说银潢与海通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35274,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"古琴一张徽弦不具持赠刘汉卿经历因赋","author":"俞德邻","text":"枯桐三尺蹙龙纹，爨下薪焦偶未焚。\n七窍已开犹浑沌，一丝不挂绝声闻。\n至音澹薄何如默，大道希夷岂在文。\n持赠要知弦外趣，美哉斯意忆河汾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35275,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"閒居即事","author":"俞德邻","text":"尘外江村野老家，穷年兀兀笑盘蜗。\n素琴横膝一尊酒，纱帽笼头七椀茶。\n编竹作桥看蚁渡，种花成坞听蜂衙。\n閒中自有经纶事，寄语时人莫笑哗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35276,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵陈登父小楼述怀","author":"俞德邻","text":"慷慨悲歌续五噫，等閒观物倚筇枝。\n士龙瓦屋西头住，吏部霜螯左手持。\n湖海悠悠空拓落，风埃冉冉竟衰迟。\n登楼作赋羞王粲，寂寞归与理钓丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35277,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"通津田舍","author":"俞德邻","text":"汀葭江菼两依依，鸥鹭相亲寂不飞。\n僧入翠微云伴去，牛耕白水犊随归。\n古今贤圣多萧索，王伯干戈有是非。\n老病忧时心力弱，可能此地得渔矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35278,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游鹤林寺","author":"俞德邻","text":"步屧叩禅扉，春山碧四围。\n天高黄鹤远，仙去杜鹃非。\n拂石云生袖，扪松雾湿衣。\n几生通佛性，一昔遂忘归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35279,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"客怀","author":"俞德邻","text":"客怀元自恶，归思浩无垠。\n愁织窗前草，情凄岸曲蘋。\n十年纷战伐，四海暗风尘。\n故旧无消息，西风泪满巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35280,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夜坐","author":"俞德邻","text":"蒲团叠膝诵南华，莲勺灯明细吐花。\n客有可人期不至，邻无美酒夜难赊。\n湿星酿雨愁飞雁，枯木号风怨宿鸦。\n自笑不眠还不倦，城头呜咽又鸣笳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35281,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵陈登父送春有感","author":"俞德邻","text":"同谷歌残返旧蹊，园庐寂寞半蒿藜。\n忧时顿觉愁如海，对客何能醉似泥。\n春去春来人渐老，城南城北望犹迷。\n鼓鼙一概旌旗满，何日车书混僰鞮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35282,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"臂疾示儿","author":"俞德邻","text":"臂疾浸淫骨半枯，蒲团毯被学跏趺。\n宋清药券偿未了，司业酒钱来便无。\n湖海飘零销壮志，风霜荏苒上吟须。\n征辽挟矢知无分，老向新丰倩汝扶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35283,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"閒居遣兴","author":"俞德邻","text":"数间破屋玉川家，纱帽笼头自煮茶。\n万卷图书三尺剑，半窗风雨一池蛙。\n诗情寂寞腹无稿，老态浸寻眼有花。\n鼎鼎百年成底事，醉乡端的是生涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35284,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次陈登父中秋游古竹院韵","author":"俞德邻","text":"閒过竹院听华严，结愿清香发旧奁。\n灏气半空浮桂魄，凉风三径拂松髯。\n酒阑野兴归长笛，吟罢秋声落短檐。\n终日昏昏真醉梦，几时游屐更苔黏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35285,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋残","author":"俞德邻","text":"乐天老矣放樊蛮，鸥羡忘机鹤羡閒。\n缓步当车休下泽，浇愁得酒即中山。\n些骚岂敢奴仆命，伊吕元非伯仲间。\n兀兀支颐秋又晚，乱云斜日澹烟鬟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35286,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"养拙","author":"俞德邻","text":"养拙柴扉百虑疏，天光云影乱秋渠。\n一身摇动未妨酒，两眼眵昏犹嗜书。\n陶令但知归有菊，冯谖忍叹食无鱼。\n閒中滋味君休厌，门外纷纷几覆车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35287,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"无题二首 其一","author":"俞德邻","text":"杯酒河桥饯去篷，谁知此别竟西东。\n隙驹冉冉岁华改，楼燕飞飞春事空。\n佩冷江皋凄落月，笳吹朔漠动悲风。\n芳魂寂寞扬州路，后土琼姬恨略同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35288,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"无题二首 其二","author":"俞德邻","text":"花柳亭台半劫灰，故人沦落共徘徊。\n湖光山色西施舸，水影月香和靖梅。\n鸿蹋雪泥犹记迹，鹤归华表总成哀。\n一尊浊酒和愁酌，泪洒东风醉玉颓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35289,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"正月十日理发三首 其一","author":"俞德邻","text":"多病多愁鬓已星，更怜诗骨瘦崚嶒。\n百钱挑杖但求醉，五斗折腰良不能。\n徒步幸无官长骂，浩歌聊袭散人称。\n世情阅尽忘今古，一合乾坤几废兴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35290,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"正月十日理发三首 其二","author":"俞德邻","text":"寂历劳生叹转蓬，百年强半走西东。\n从师谩学屠龙技，报国元无汗马功。\n二顷有秋生计足，三杯近卯客愁空。\n儿童相见从相笑，两鬓丝丝一老翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35291,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"正月十日理发三首 其三","author":"俞德邻","text":"晨梳白发照青铜，叹息光阴过眼空。\n一市少年羞裤下，三朝新妇闭车中。\n酒逢知己犹堪醉，文不惊人莫送穷。\n天下士忧天下事，肯将飞伏较雌雄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35292,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送王舍人之燕山","author":"俞德邻","text":"柳媚花明二月天，金羁络马路三千。\n鳣鲸得意纵溟壑，蛙蚓无知闹坎泉。\n今古不磨惟正理，是非何必待他年。\n离骚已信多忠愤，珍重毋忘鸨羽篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35293,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游宣慰载酒泛溪即席有作","author":"俞德邻","text":"五载绨袍忆故人，春风吹鹤过湖滨。\n楼台冷浸两溪水，天地清无一点尘。\n棹底空觥今杜牧，井中投辖旧陈遵。\n万方一概吾安往，傥许诛茅竟卜邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35294,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"陪游宣慰游霅归赋","author":"俞德邻","text":"隃望平山碧四围，鹁鸪啼处见柴扉。\n白蘋风起雨初歇，绿叶成阴春又归。\n野外樵夫纷避道，溪边鸥鸟独忘机。\n深杯百罚人扶醉，一枕西轩月满衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35295,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵简林绍先诸友三首 其一","author":"俞德邻","text":"宦路风波渺望洋，几人赤马旦蒙霜。\n便便懒是誇经笥，嗑嗑从渠笑酒囊。\n花柳春风朝步屧，菰蒲春水夜鸣榔。\n人间别有桃源路，肯为浮荣替戾冈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35296,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵简林绍先诸友三首 其二","author":"俞德邻","text":"纳纳乾坤万汇滋，同声同气自相宜。\n江山今古几兴废，湖海交朋屡别离。\n落月照梁疑太白，西风挥扇障元规。\n老来万事如泥浊，一笑论文祇自知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35297,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵简林绍先诸友三首 其三","author":"俞德邻","text":"载酒湖山忆盛年，可怜风物竟凄然。\n杜陵野老哭春日，空谷佳人倚暮天。\n禾黍离离迷故国，旌旗杳杳遍南偏。\n虎皮何日包弓矢，老为羲皇受一廛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35298,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"客窗夜雨","author":"俞德邻","text":"世路驱驰力不任，老来世路转岖嵚。\n小窗一夜芭蕉雨，倦客十年桑梓心。\n黄纸红旗违壮志，青尊绿醑笑孤斟。\n故山何日真归隐，涧水松风直万金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35299,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"息寮王教授挽词二首 其一","author":"俞德邻","text":"黄鹤山前蜕骨仙，饱餐玉蕊漱珠泉。\n酒酣拓戟老工部，官冷无毡贫郑虔。\n四海风埃方坱莽，一生岐路几迍邅。\n公今得向扬州死，况复悬车过八年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35300,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"息寮王教授挽词二首 其二","author":"俞德邻","text":"昔年床下拜庞公，数树梅花一亩宫。\n寂寞吟情头尽鹤，摧颓病骨气如虹。\n祇今有子能传业，谁念无钱解送终。\n千古幽扃邻牧惰，遥怜环佩月明中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35301,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅雨","author":"俞德邻","text":"宇宙冥冥四月时，小斋吟眺苦低垂。\n江城地僻莓苔老，山径云深草木滋。\n密雾蒙蒙笼翠幄，轻烟冉冉散青丝。\n楚宫幽佩劳魂梦，西望巫阳祇自悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35302,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"老病","author":"俞德邻","text":"老病幽栖觉懒吟，眼观时态独关心。\n古今不泯春秋笔，天地难欺暮夜金。\n幸有别肠堪贮酒，未愁短发不胜簪。\n柴门一闭从春尽，桃李飞花叶又阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35303,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"遣怀","author":"俞德邻","text":"扰扰乾坤几战尘，南山北阙意逡巡。\n贫思隐语呼庚癸，病怯流年避巳辰。\n三顾恐无开济术，百年须了去来因。\n鹿门有约吾将隐，倚杖看云老此身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35304,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送刘伯宣尹松江府五首 其一","author":"俞德邻","text":"来往燕鸿异，逍遥鹏鴳同。\n古交千载上，馀论六经中。\n瓜渚茅檐月，芜城柳岸风。\n寸心谈未了，棹士莫匆匆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35305,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送刘伯宣尹松江府五首 其二","author":"俞德邻","text":"宦途昏抹漆，达士久悲丝。\n汲直世多忌，父清人不知。\n隆污俱合道，行止要随时。\n富贵真槐蚁，千年看鼎彝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35306,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送刘伯宣尹松江府五首 其三","author":"俞德邻","text":"兵燹三年久，疮痍百姓同。\n政须随日化，心要与天通。\n刻木期难对，屯膏施易穷。\n松江三万顷，盂水爱任公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35307,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送刘伯宣尹松江府五首 其四","author":"俞德邻","text":"事丛缘网密，意广忌才疏。\n浩浩皇风远，迟迟化日舒。\n俗移三纪后，德洽百年馀。\n擿伏非仁政，生民本一初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35308,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送刘伯宣尹松江府五首 其五","author":"俞德邻","text":"烹鲜知政理，履豨识民心。\n土壤分南北，诗书亘古今。\n遐方犹战伐，癃老正呻吟。\n三尺焦桐在，烦公发至音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35309,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵崔郎中游西湖","author":"俞德邻","text":"万顷湖光一苇杭，画桥横接旧堤长。\n松环九里烟云湿，梅压孤山水月香。\n梵宇琳宫增突兀，铜驼金谷自凄凉。\n悲吟一夜头添雪，惭愧崔鸿在洛阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35310,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"范仲山以涧谷居自号为赋二首 其一","author":"俞德邻","text":"山林朝市两相忘，寂寂幽居兴味长。\n雨过竹侵书帙净，风轻花落砚池香。\n三杯卯酒醉未醉，一枕午窗凉更凉。\n人境结庐元不俗，渊明何必定柴桑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35311,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"范仲山以涧谷居自号为赋二首 其二","author":"俞德邻","text":"丘壑中间著幼舆，何如此地卜幽居。\n棋声夜静客饮酒，花影昼閒儿读书。\n尘世覆蕉多得鹿，痴人缘木更求鱼。\n先生梦觉浑无事，一笑浮云指太虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35312,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山房遣兴","author":"俞德邻","text":"三径岚烟护碧苔，地无高下总栽梅。\n花随流水绕除去，云共好山排闼来。\n月冷蛙声諠鼓吹，风清蜃气耸楼台。\n过逢况有侯芭在，白首玄经未足咍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35313,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游灵岩","author":"俞德邻","text":"蹑石扪萝一径通，凭阑极目思无穷。\n川明竹树萧疏外，人语烟云杳霭中。\n风月五湖西子舸，楼台千古梵王宫。\n艰难隐遁寻幽憩，晤语无人忆赞公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35314,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵赵提举二首 其一","author":"俞德邻","text":"白首玄经病子云，感时怀旧独沾巾。\n十年战伐多新鬼，四海逢迎少故人。\n上苑莺花非昔日，曲江蒲柳为谁春。\n涌金香酒甜如蜜，满眼沽来莫厌频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35315,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵赵提举二首 其二","author":"俞德邻","text":"寂历谋生后计然，已将穷达付苍天。\n狙公枉自计朝暮，徐邈但知中圣贤。\n岁月催人如过隙，功名随世任先鞭。\n纷纷燕雀惊鹰隼，谁识图真在左绵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35316,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山林乐四首 其一","author":"俞德邻","text":"山林何所乐，忽忽遂忘归。\n江阔天低水，山深雾湿衣。\n青虫当户织，白鸟背人飞。\n野性因留滞，非干与世违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35317,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山林乐四首 其二","author":"俞德邻","text":"山林何所乐，佳兴四时同。\n琴罢庭留月，酒残松度风。\n鹤归苍汉外，猿叫碧萝中。\n却笑磻溪叟，区区理钓筒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35318,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山林乐四首 其三","author":"俞德邻","text":"山林何所乐，所乐在琴书。\n醉买中山酒，游乘下泽车。\n结交忘鹿豕，分席混樵渔。\n何必桃源路，方为隐者居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35319,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山林乐四首 其四","author":"俞德邻","text":"山林何所乐，幽处两三家。\n曲径新移竹，疏篱旧著花。\n岚烟千嶂合，野水一桥斜。\n谁道无音乐，渔阳有掺挝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35320,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"淮楚绝无行乐地万柳池边有开元小寺稍洁因载酒约淮上翁荀桂叔林绍先诸友同游","author":"俞德邻","text":"柳外澄波系小艖，玉皇宫畔梵王家。\n蚁浮腊味杯行酒，鹤避晴烟灶煮茶。\n客里招邀惭草率，座中沾洽笑兰阇。\n杖藜归路西风晚，一抹寒林万点鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35321,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵夏楚材登山阳故城有感","author":"俞德邻","text":"金粟松摧故国荒，春秋未作叹诗亡。\n十年漂泊家千里，百代兴衰梦一场。\n蠙浦风清波鸭绿，渔梁春暖酒鹅黄。\n相逢且尽尊前醉，莫遣愁多白发长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35322,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"初度留山阳","author":"俞德邻","text":"茫茫南国遍旌旗，九日明朝有所思。\n元亮暮年书甲子，灵均初度忆庚寅。\n鱼龙寂寞秋江阔，豺虎从衡客路危。\n归去白云堪共卧，万山深处结茅茨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35323,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"答淮上翁二首 其一","author":"俞德邻","text":"风雨凄凄战客衣，长淮东去雁南飞。\n碧山学士老复老，芳草王孙归不归。\n尊酒细论悲昨梦，囊书空负笑前非。\n木奴千辈侯千户，早晚应须赋式微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35324,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"答淮上翁二首 其二","author":"俞德邻","text":"京江语别十三春，宇宙茫茫几战尘。\n客路秋风欺白发，阴房夜雨湿青燐。\n杖藜叹世悲谁子，悬印朝天少故人。\n回首鹿门思旧隐，荒坟宿草更沾巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35325,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"怀林绍先三首 其一","author":"俞德邻","text":"长淮滚浊澜，春半尚严寒。\n久客愁无寐，怀人醉不欢。\n读书狂李白，忘事老师丹。\n何日归林下，悠然饭一箪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35326,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"怀林绍先三首 其二","author":"俞德邻","text":"岁岁苦担簦，飘然云水僧。\n星霜变玄鸟，天地有青蝇。\n留滞慵僮仆，怀归畏友朋。\n求田端有暇，谁复问陈登。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35327,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"怀林绍先三首 其三","author":"俞德邻","text":"羁怀不自憀，明日又花朝。\n我畏杖藜远，君难折简招。\n愁长怜发短，室迩叹人遥。\n剪尽西窗烛，凭谁慰寂寥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35328,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寓山阳天庆馆作","author":"俞德邻","text":"紫气浮关怅客情，琳宫羸卧绝逢迎。\n长廊夜静蛩吟苦，古殿秋深鹤唳清。\n勾漏丹砂何处问，蓝桥云液为谁倾。\n捲帘残月斜窥牖，街鼓鼕鼕又五更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35329,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]