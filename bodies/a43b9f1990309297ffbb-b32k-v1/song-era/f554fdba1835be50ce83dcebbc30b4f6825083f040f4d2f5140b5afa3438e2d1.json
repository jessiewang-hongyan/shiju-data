[{"title":"湖州","author":"周紫芝","text":"霅溪景物见歌诗，只有当年杜紫微。\n沽酒店穿斜巷出，采莲船傍后门归。\n翠沾城郭山千点，清蘸楼台水一围。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41700,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"钟山僧舍酬辟疆秘授","author":"俞紫芝","text":"同谒临川丞相时，不期颜色偶然披。\n绿葵自得山人味，绛帐难求俗士知。\n午磬唤回幽枕梦，夕阳催就小窗诗。\n松毛桂叶山中路，肯顾非公复是谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41701,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"俞紫芝","text":"莫怪野人经宿住，白蘋露落蟹螯肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41702,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"琼花","author":"俞澹","text":"因此琼花发，维阳胜洛阳。\n若无三月雨，占断一春香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41703,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"越山四见亭","author":"刘瑾","text":"山山能作雨，面面尽来峰。\n倚遍栏干曲，归心曲曲同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41704,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送程给事知越州","author":"熊本","text":"龙节颁新命，鸾台辍侍臣。\n诏开都督府，寄重老成人。\n四纪文章伯，三朝富贵身。\n指麾清剧部，谈笑动殊邻。\n丽正裁书久，承明厌直频。\n银黄乡路昼，襦裤属城春。\n冠盖倾吴会，旌旗照海濒。\n溪藤閒得句，雪舫夜留宾。\n梦想依青琐，风流喜紫莼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41705,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"休休亭","author":"乐沆","text":"贻溪澄澈玉峰寒，居士当年此考槃。\n访得遗基青华下，构成危栋白云端。\n人间日月双轮转，世外襟怀九鼎安。\n醉魄吟魂如未泯，也应谢我数盘桓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41706,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送程给事知越州","author":"王汾","text":"名藩从古任惟良，况复深严琐闼郎。\n夕拜更持仙殿笔，昼归仍绾会稽章。\n诗编岂愧微之富，杯酒应嗤贺监狂。\n惠政相承今邵杜，越人歌颂继南阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41707,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题陆子泉","author":"王汾","text":"泉品旧知名，澄源石甃盈。\n甘滋饱僧饭，润泽济农耕。\n漱玉人谁听，囊茶客自烹。\n久供鸿渐啜，曾奉赞皇羹。\n昨忝此邦守，令无诸县行。\n烦酲想岩壑，一日慰幽情。\n惭怍方堆面，尘埃正满缨。\n临流聊洗濯，心已识蒙亨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41708,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诗一首","author":"王汾","text":"暂到灵岩顷刻间，篮舆还促度前山。\n我今吏役羞前辈，胜地逢僧不得闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41709,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东台山","author":"王汾","text":"谁谓前人不可攀，金杯泛菊且开颜。\n但知落帽临风醉，未必龙山胜凤山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41710,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"松石峰","author":"彭次云","text":"同登云级上危巅，松石嵚崟挂晚烟。\n好是回头遥望处，海波如带石如拳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41711,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"曾公岩和曾子宣安抚","author":"彭次云","text":"目击烟霞昼卷舒，披榛敲石得蓬壶。\n洞天日月千年久，人世尘埃一点无。\n灵药难寻云缥缈，落花不见水萦纡。\n使君凤阁翱翔近，谩与东山作画图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41712,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"老君岩次刘谊韵 其一","author":"彭次云","text":"仙驭凌云去几年，九流空苦道家言。\n何人怀古求遗像，岩穴长蒙雨露恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41713,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"老君岩次刘谊韵 其二","author":"彭次云","text":"俨然鹤发与龙颜，谁道乘风不复还。\n浑俗何须穷变化，或来尘世或云间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41714,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"国清寺","author":"苏澥","text":"自嗟灵骨久埋沦，惆怅当年旧事存。\n青眼重开萧寺路，无人隔夜扫松门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41715,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大慈寺","author":"苏澥","text":"身去寥寥无朕迹，此时谁会真消息。\n黄金灵骨今尚存，指示世人人不识。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41716,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题石桥","author":"苏澥","text":"连云霭翠叠重重，直下双溪拥霁虹。\n荣辱自分山色外，利名不到水声中。\n清凉世界随心现，方广楼台遂感通。\n愿侍千僧共谈麈，拨开陈障出樊笼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41717,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和签判殿丞书仙台观壁","author":"费琦","text":"先生旧隐寄烟岑，丹灶仙台暂访寻。\n自叹不如鸡犬幸，偶沾灵药换凡心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41718,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和签判殿丞游山上一道观三佛寺","author":"费琦","text":"岩扉相望路纡盘，杉桧风高夏亦寒。\n游遍陡忘名宦意，恨无生计可休官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41719,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和签判殿丞宠示游山之作","author":"费琦","text":"平生癖爱林泉趣，名利萦人未许閒。\n不是儒流霁风采，登山游骑恐难攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41720,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"呈谢签判殿丞宠示游山之作","author":"费琦","text":"夫君落笔尽珠玑，不比相如意思迟。\n从此洛阳须纸贵，夜来新有爱山诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41721,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送程给事知越州","author":"程嗣弼","text":"华宗晚贵派虽殊，别圃留诗叙旧娱。\n导水决谋摧宦者，尊君抗礼屈单于。\n日疏宾閤容谈麈，秋过家山好鲙鲈。\n宸眷许来应暮召，不须久计恋东吴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41722,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送程给事知越州","author":"沈季长","text":"给事才名不记春，又麾双旆越江滨。\n厌看图牒评句践，惯把圭符笑买臣。\n身到游旧心更喜，诗逢绝境语争新。\n暂虚紫府云间直，去与蓬莱作主人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41723,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登骊山阁留诗","author":"吴雍","text":"山头羯鼓奏霓裳，断送君王入醉乡。\n凭阁无言念兴废，孤烟犹起泰陵傍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41724,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题司空表圣王官谷","author":"王临","text":"夫君久逐夜舟移，依旧岩扃锁翠微。\n位至文昌还避世，身甘幽谷是知机。\n清风未泯随流水，遗像空存伴落晖。\n百有馀年同俯仰，白云犹绕故亭飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41725,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游春","author":"杨绘","text":"倾城追逐艳阳天，上巳清明节序连。\n桃李光阴足骀荡，湖山风月更鲜妍。\n谷中答响飘新曲，波底妆光飏綵船。\n迟日未西人已醉，绿杨柔弱舞秋千。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41726,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"劫权","author":"杨绘","text":"对敌常观势，临机便得先。\n安危心不动，杀活手能专。\n勿以欺为行，须知劫是权。\n旁人烂柯看，当局是神仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41727,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"落花","author":"杨绘","text":"夜来经雨学啼妆，今日摧红怨夕阳。\n已落旋随春水急，强留还怯晚风狂。\n应将别恨凭莺语，更把归期趁蝶忙。\n谁谓多情消不得，梦魂犹惜满栏香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41728,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"荷花借字诗","author":"杨绘","text":"香艳怜渠好，无端杂芰窠。\n向来因藕断，特地见丝多。\n实有终成的，露摇争奈何。\n深房莲底味，心里苦相和。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41729,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诗寄东坡","author":"杨绘","text":"仙舟游漾霅溪风，三奏琵琶一舰红。\n闻望喜传新政异，梦魂犹忆旧欢同。\n二南籍里知谁在，六客堂中已半空。\n细问人间为宰相，争如愿住水晶宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41730,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中秋月","author":"杨绘","text":"素月玉寒空，乾坤灏气通。\n光华一夕满，节候九秋中。\n万里天衢峻，四方人望同。\n妖邪无处匿，方显照临功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41731,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"凌霄花","author":"杨绘","text":"直饶枝干凌霄去，犹有根原与地平。\n不道花依他树发，强攀红日斗鲜明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41732,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"柳花","author":"杨绘","text":"春光未老杨花飞，游子此情伤别离。\n扳折杨柳赠离别，骎骎匹马归何时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41733,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送淳用长老归邛州","author":"杨绘","text":"曾扣禅扉喜接陪，师将境物谕轮回。\n灯笼不灭心中火，香印空残死后灰。\n绵邑难留真锡驻，临邛还庆法堂开。\n临邛绵邑何分别，无去无来无去来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41734,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寿山","author":"杨绘","text":"寿山北耸侵隋碧，涢水南流接汉清。\n宋玉阳台犹暮雨，子虚梦泽半春耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41735,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"杨绘","text":"高骖黄鹤望天飞，千载谁能继费祎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41736,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"杨绘","text":"源有雌雄分碧白。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41737,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其三","author":"杨绘","text":"清香旧已亲陶令，红艳新能惑阮郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41738,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其四","author":"杨绘","text":"何必口辞山简醉，但教心似屈原醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41739,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其五","author":"杨绘","text":"烂紫妖红色尽卑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41740,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其六","author":"杨绘","text":"高唐神女兰供泽，姑射仙人雪瑩肌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41741,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"解雨送神曲 其一","author":"李常","text":"怒风兮扬尘，日烁石兮将焚。\n水泉竭兮厚地裂，嘉谷槁兮孰耨且耘。\n神龙兮灵壑，挹清波兮幽濆。\n鸣鼍鼓兮舞神觋，庶下鉴兮霈祥氛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41742,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"解雨送神曲 其二","author":"李常","text":"触石兮山巅，倏四骛兮天边。\n惊霆怒兮电炽，翻河汉兮绳悬。\n黍离离兮发嘉，穗垄高下兮水潺湲。\n欢吾人兮拜贶，请奉事兮无有穷年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41743,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"解雨送神曲 其三","author":"李常","text":"肃旂旆兮先驱，咽箫笳兮拥归舆。\n椒醑甘兮牲币洁，如肸蚃兮为之踌蹰。\n瞻前山兮嵯峨，指去路兮萦纡。\n神德大兮报无以称，徒感涕兮长吁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41744,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"醉眠亭","author":"李常","text":"陶公醉眠野中石，君醉辄眠舍后亭。\n人知醉眠尽以酒，不知身醉心常醒。\n众人清晨未尝饮，已若醉梦心冥冥。\n淫名嗜利到穷老，有耳亦不闻雷霆。\n醉石虽顽委山侧，苔昏日剥谁与扃。\n牧童樵叟亦能指，卒以陶令垂千龄。\n危檐弱栋倚荒渚，海雾江雨穿疏棂。\n勿谓幽亭易摧折，勉事伟节同明星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41745,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题招提院静照堂","author":"李常","text":"藻户面通漕，飞甍出重城。\n堂成未遑息，复作千里行。\n尘埃袖短褐，蒙暑踏寒冰。\n其求异求食，志欲诗编盈。\n宁辞阍吏慢，聊为一堂荣。\n都城竞名利，日出车马声。\n谁云方外士，奔走亦有营。\n惟静制众动，自照中乃明。\n胡为挠山水，风急帆更轻。\n岁阑去勿缓，恐负新堂名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41746,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"李常","text":"皖公山下开轩处，坐听龙吟十里长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41747,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"荐福院双柏","author":"李常","text":"当日双缣直万缗，买留柯叶拂星辰。\n上巢绝顶饶千鹤，下憩清阴可百人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41748,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题有美堂","author":"贾收","text":"自刊宸画入云端，神物应须护翠峦。\n吴越不藏千里色，斗牛常占一天寒。\n四檐望尽回头懒，万象搜来下笔难。\n谁信静中疏拙意，略无踪迹到波澜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41749,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送友人赴天台幕","author":"贾收","text":"天台仙籍上，又见姓刘人。\n入幕红莲晓，趋庭彩服春。\n鱼多知海熟，药少觉山贫。\n太守乡儒丈，何妨婉画频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41750,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和沈君与送蟹","author":"贾收","text":"彭越孙多伏下风，蝤蛑奴视敢称雄。\n江湖纵养膏腴紫，鼎镬终烹爪眼红。\n嗍称吴儿牙似镀，劈惭湖女手如葱。\n独怜盘内秋脐实，不比溪边夏壳空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41751,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"具区阁","author":"贾收","text":"轩窗尘不点，更在水云边。\n夜月鸣榔地，秋风斫鲙天。\n达人多傲世，清景易忘年。\n往往凭栏者，空高张翰贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41752,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"贾收","text":"洄洄流水抱横塘，兰芷无风也自香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41753,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂","author":"释法秀","text":"谁能一日三梳头，撮得根牢髻便休。\n大抵是他肌骨好，不施红粉也风流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41754,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈四首 其一","author":"释法秀","text":"山僧不会巧说，大都应个时节。\n相唤吃椀茶汤，亦无祖师妙诀。\n禅人若也未相谙，踏著秤锤硬似铁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41755,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈四首 其二","author":"释法秀","text":"秋云秋水，看山满目。\n这里明得，千足万足。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41756,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈四首 其三","author":"释法秀","text":"寒雨细，朔风高。\n吹沙走石，拔木鸣条。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41757,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈四首 其四","author":"释法秀","text":"少林九年冷坐，却被神光觑破。\n如今玉石难分，祇得麻缠纸裹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41758,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送僧游嘉禾","author":"释法秀","text":"楚天西首路，槜李记曾游。\n店宿灯悬梦，堤行草唤愁。\n玉澄湖水晓，画展囿亭秋。\n小艇枯杨趾，重来为系留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41759,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春帖子","author":"邓润甫","text":"晨曦潋滟上帘栊，金屋熙熙歌吹中。\n桃脸似知宫宴早，百花头上放轻红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41760,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送黄守解印","author":"邓润甫","text":"文雅登临谢守才，爱山今作别山来。\n知公未厌真仙境，早拥江南使节来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41761,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诗一首","author":"邓润甫","text":"闻说东南第一州，区区来访小蓬丘。\n湖光带日黄金拥，山色凝烟碧玉浮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41762,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"道中咏怀奉寄利州冯允南使君","author":"邓润甫","text":"交印夔人国，分襟汴水堤。\n十年难会合，一梦顿乖暌。\n官序潘生拙，诗文庾信齐。\n诸公多汲引，宪府屡提携。\n不肯乘骢马，那能出宝鸡。\n安恬轻世味，洒落见天倪。\n照物聪明决，为邦闻望跻。\n笑谈清岸狱，暇豫劝耕犁。\n不忍为钩距，何尝设町畦。\n燕堂传夜烛，游毂碾春泥。\n众服题鹦鹉，畴将食駃騠。\n草黄思隼击，梧碧值鸾栖。\n欲问无来使，开编有旧题。\n君方安玉垒，予亦远金闺。\n地隔江波阔，书传鸟翼稽。\n岂知双鬓白，相见两当西。\n内顾微他技，殊私牧远黎。\n辞亲愁不断，叱驭意空迷。\n吴苑飞云杳，春城北斗低。\n南山千里雪，剑阁万盘溪。\n夜宿星边驿，朝行石上溪。\n深疑窥地轴，高骇蹑天梯。\n看岫时攲帽，听泉或杖藜。\n萧萧黄叶下，袅袅冷猿啼。\n蜀道无艰险，人心漫惨悽。\n永怀持从橐，遥想缀朝圭。\n直北瞻天日，征西叠鼓鼙。\n相期郡斋冷，清话看挥犀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41763,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"邓润甫","text":"武昌山水诚佳哉，当年五柳亲栽培。\n家家开门枕江水，春风照耀桃与梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41764,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"邓润甫","text":"妙论出六合，微言破九流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41765,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"盘洲杂韵上 含笑","author":"洪适","text":"自有嫣然态，风前欲笑人。\n涓涓朝泣露，盎盎夜生春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41766,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江渎泛舟次吴中复韵","author":"韩宗道","text":"绿锦池塘藻荇芳，拿舟清泛水风凉。\n千珠翠飐圆荷雨，百和交销宝篆香。\n暂驻旌麾开燕豆，只凭谈笑乐杯觞。\n留连晚景殊多适，无奈黄昏送夕阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41767,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又和谢景初韵","author":"韩宗道","text":"萧洒丛祠古道旁，偶来乘兴兴何长。\n珊珊翠竹寒成韵，苒苒红蕖细度香。\n云暗尘头云雨急，风来水面葛衣凉。\n天涯一笑良难得，预借骊歌送别觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41768,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和吴中复游海云寺","author":"韩宗道","text":"茂林修竹翠烟收，寺枕清江江上头。\n好马啼春知客恨，落花浮水近人流。\n政閒不废登临赏，意适真成汗漫游。\n紫陌红尘归路远，夕阳回首重迟留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41769,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和母同州丁巳吟","author":"吕大防","text":"行高名并美，命否数皆殂。\n嗟尔百君子，贤哉二丈夫。\n世方敦薄俗，谁复距虚无。\n望道咸瞠若，脩梁遽坏乎。\n密章燔汉绶，环绖泣秦儒。\n赖有诸良友，能令绍不孤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41770,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]