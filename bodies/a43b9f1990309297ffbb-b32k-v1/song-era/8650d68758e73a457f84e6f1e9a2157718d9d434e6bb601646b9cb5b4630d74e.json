[{"title":"和枢密侍郎因看海棠忆禁苑此花最盛","author":"石延年","text":"君看海棠格，群花品讵同。\n娇娆情自富，萧散艳非穷。\n茜縠班吴苑，新罗碎蜀宫。\n锦窠杯里影，绣段隙前烘。\n心乱香无数，茎柔动满丛。\n意分巫峡雨，腰系汉台风。\n盛若霞藏日，鲜于血洒空。\n高低千点赤，深浅半开红。\n妆指朱才布，膏唇檀更融。\n色娇无可压，体瘦不成丰。\n枝重轻浮外，苞疏密间中。\n难胜蜂不定，易入蝶能通。\n杜甫句何略，薛能诗未工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26613,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送郑十学士戬通理越州","author":"石延年","text":"宸命陪分竹，仙资贵珥彤。\n入辞中殿閟，出贰左廉雄。\n过楚前封近，还吴旧业空。\n江山复清思，莼脍起高风。\n海阔悲秦望，陵荒叹禹功。\n楼澄鉴湖北，地险雪涛东。\n稽壑飞泉石，台基下桂丛。\n风流好吟醉，王谢有馀宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26614,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"莲花","author":"石延年","text":"含情默默向层漪，语语幽怀定未知。\n洛浦微波长映步，汉宫香水不濡肌。\n心通几点韬光藕，肠结千回托乱丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26615,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄尹师鲁","author":"石延年","text":"十年一梦花空委，依旧河山损桃李。\n雁声北去燕南飞，高楼日日春风里。\n眉黛石州山对起，娇波泪落妆如洗。\n汾河不断天南流，天色无情淡如水。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26616,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题上虞苏簿凝虚馆","author":"石延年","text":"越基擅岩壑，虚馆择其尤。\n丹甍煜孤飞，灵景邈四周。\n山高晴若阴，洞寒夏如秋。\n锦幄槛花发，玉环渠水流。\n闲卧真吏隐，乍登乃仙游。\n居之宜民思，毋为兹宇羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26617,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"筹笔驿","author":"石延年","text":"汉室亏皇象，乾坤未即宁。\n奸臣与逆子，摇岳复翻溟。\n权表分江域，曹袁斗夏坰。\n虎奔咸逐逐，龙卧独冥冥。\n从众非无术，欺孤乃不经。\n惟思恢正道，直起复炎灵。\n管乐韬方略，关徐骇观听。\n一言俄逆至，三顾已忘形。\n南既清蛮土，东期赤魏庭。\n出师功自著，治国志谁铭。\n历劫兵如水，临秦策若瓴。\n举声将溃虏，横势欲逾泾。\n仲达耻巾帼，辛毗严壁扃。\n可烦亲细务，遽见堕长星。\n战地悲陵谷，来贤赏德刑。\n意中流水远，愁外旧山青。\n想像音徽在，侵寻毛骨醒。\n迟留慕英气，沉叹抚青萍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26618,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"樱桃","author":"石延年","text":"蔗浆寒上器，羊酪冰中厨。\n细碎榴非匹，寻常荔可奴。\n还当生林下，笋食废朝餔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26619,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题萱花","author":"石延年","text":"移萱树之背，丹霞间金色。\n我有忧民心，对君忘不得。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26620,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠刘潜归陶丘","author":"石延年","text":"丈夫未大用，身与仁义闲。\n可宜更聚散，风尘摧厥颜。\n君今归柯泽，路出梁宋间。\n芒砀有吾庐，亲老待我还。\n羡子先谐愿，思亲头鬓斑。\n韶光苦不再，沟水长潺湲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26621,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"思归乐","author":"石延年","text":"匹马驱驰事薄游，异乡触目动牵愁。\n春禽劝我归休去，争奈功名未放休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26622,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹊桥仙 七夕词","author":"石延年","text":"一分素景，千家新月，凉露楼台遍洗。\n宝奁深夜结蛛丝，纴五孔、金针不寐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26623,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"燕归梁 春愁","author":"石延年","text":"芳草年年惹恨幽。\n想前事悠悠。\n伤春伤别几时休。\n算从古、为风流。\n春山总把，深匀翠黛，千叠在眉头。\n不知供得几多愁。\n更斜日、凭危楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26624,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二十二","author":"石延年","text":"水活冰无日，枝柔树有春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26625,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其十一","author":"石延年","text":"春菜红牙□，春盘黄雀花。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26626,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二十八","author":"石延年","text":"苔矶清镜里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26627,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"石延年","text":"月如无恨月长圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26628,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"石延年","text":"震出坤柔变，乾成太极虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26629,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二十一","author":"石延年","text":"蛇露根穿岭，龙眠影在潭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26630,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其十九","author":"石延年","text":"叶嫩藏修节，苞遗出绀肤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26631,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其五","author":"石延年","text":"多少楼台好风月，乐声香气更无空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26632,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二十四","author":"石延年","text":"平芜远更绿，斜日寒无辉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26633,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其十五","author":"石延年","text":"水尽天不尽，人在天尽头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26634,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其十六","author":"石延年","text":"弋下失溟鸿，网细遗巨鲲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26635,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"石延年","text":"檐重冰箸晴先滴，草屈金钩绿未回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26636,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二十六","author":"石延年","text":"繁萼香琼乱，残英绛雪遗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26637,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其十三","author":"石延年","text":"行人晚更急，归鸟夕无行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26638,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二十七","author":"石延年","text":"更被阴晴长睡魔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26639,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其七","author":"石延年","text":"孔雀罗衫窄窄裁，珠襦微露凤头鞋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26640,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二十三","author":"石延年","text":"海云含雨重，江树带蝉疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26641,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二十五","author":"石延年","text":"几为物象添诗僻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26642,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其十四","author":"石延年","text":"天寒河影淡，山冻瀑声微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26643,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其六","author":"石延年","text":"天醉笙歌外，风香罗绮馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26644,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其八","author":"石延年","text":"孟郊天地窄，杨朱歧路多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26645,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其十","author":"石延年","text":"月落松陵晓，风生笠泽秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26646,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二十","author":"石延年","text":"旁迷绿虫挂，近识翠禽呼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26647,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其十八","author":"石延年","text":"尽日携樽芳树下，何须佳酝得途林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26648,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其九","author":"石延年","text":"后庭兰蕙寒无色，虚阁图书夕有尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26649,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其三十","author":"石延年","text":"小萼裁成绛腊匀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26650,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其十七","author":"石延年","text":"中散向人疏懒甚，步兵因酒过差多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26651,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其十二","author":"石延年","text":"台高地迥出天半，瞭见皇都十里春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26652,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留题桐柏石道师妙声堂次曾史君韵","author":"石延庆","text":"一派奔湍响迅雷，喷云翻雪绕琼台。\n应通天上银潢路，准拟乘槎八月来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26653,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题鉴轩","author":"石延庆","text":"一轩曾揭鉴为名，轩下方池彻底清。\n坐客不须频拂拭，主人犹恐太分明。\n一尘不染原无物，万象俱涵岂有情。\n堪笑越湖三百里，等闲风浪不曾平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26654,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢文瑩师携琴见访","author":"石扬休","text":"郑卫湮俗耳，正声追不回。\n谁传广陵操，老尽峄阳材。\n古意为师复，清风寻我来。\n幽阴竹轩下，重约月明开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26655,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"海棠 其一","author":"石扬休","text":"化工裁剪用功专，濯锦江头价最偏。\n酷爱几思凭画手，难题浑觉挫诗权。\n艳凝绛缬深深染，树认红绡密密连。\n因想当年武平一，枝枝眷赐侍臣先。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26656,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"石扬休","text":"皇朝四十三龙首，身到黄扉止四人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26657,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"竹浦渔归","author":"石汝砺","text":"钓罢收纶日既残，扁舟一叶解登湾。\n长歌欸乃乘风去，鸣橹咿哑趁月还。\n翡翠跃飞红蓼内，鸳鸯惊起白蘋间。\n奔驰马足车尘者，回首烟波羡尔閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26658,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南明山","author":"石亨之","text":"祇因寻胜到林泉，四抱回峰万景连。\n僧过不知山隐寺，客来方见洞开天。\n浮屠照水光相映，古木临崖影倒悬。\n风露了非人世界，恍疑身似洞中仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26659,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题沃洲山字岩","author":"石余亨","text":"前辈高风不可追，自来陵谷互推移。\n却怜当日题名者，不及征南办两碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26660,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"钓台","author":"石孝友","text":"桐江波上一羊裘，钓得声名隘九州。\n天子曷尝遗故旧，先生不肯事王侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26661,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"一剪梅 送晁驹父","author":"石孝友","text":"萍水相逢无定居。\n同在他乡，又问征途。\n离歌声里客心孤。\n花尽园林，水满江湖。\n烟树微茫带岸蒲。\n何处长沙，何处洪都。\n要知安稳到家无。\n千里征鸿，一纸来书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26662,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"卜算子 其三","author":"石孝友","text":"折得月中枝，坐惜青春老。\n及至归来能几时，又踏关山道。\n满眼秋光好。\n相见应须早。\n若趁重阳不到家，只怕黄花笑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26663,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"卜算子 其四 孟抚干岁寒三友屏风","author":"石孝友","text":"冷蕊閟红香，瘦节攒苍玉。\n更著堂堂十八翁，取友三人足。\n惜此岁寒姿，移向屏山曲。\n纸帐熏炉结胜缘，故伴仙郎宿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26664,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"卜算子 其一","author":"石孝友","text":"人自蕊宫来，微步香云拥。\n小试樽前白雪歌，叶叶秋声动。\n一剪艳波横，两点愁山重。\n收拾眉尖眼尾情，作个鸳鸯梦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26665,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"卜算子 其二","author":"石孝友","text":"见也如何暮。\n别也如何遽。\n别也应难见也难，后会难凭据。\n去也如何去。\n住也如何住。\n住也应难去也难，此际难分付。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26666,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"千秋岁","author":"石孝友","text":"春工领略。\n点破群花萼。\n对流景，伤沦落。\n踏青心缕懒，病酒情怀恶。\n无奈处，东风故故吹帘幕。\n腕玉宽金约。\n一去音容邈。\n鱼与雁，应难托。\n从前多少事，不忍思量著。\n心撩乱，斜阳影在栏干角。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26667,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丑奴儿 次韵何文成灯下镜中桃花","author":"石孝友","text":"菱花镜里桃花笑，清影团团。\n月淡风寒。\n深夜移灯许细观。\n武陵溪上当时事，何处飞鸾。\n泪纸惊澜。\n飘尽红英不忍看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26668,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乌夜啼","author":"石孝友","text":"潇湘雨打船篷。\n别离中。\n愁见拍天沧水、搅天风。\n留不住。\n终须去。\n莫匆匆。\n后夜一尊何处、与谁同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26669,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"忆秦娥","author":"石孝友","text":"秦楼月。\n秦娥本是秦宫客。\n秦宫客。\n梦云风韵，借仙标格。\n相从无计不如休，如今去也空相忆。\n空相忆。\n尊前欢笑，梦中寻觅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26670,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"木兰花/玉楼春 其一 送赵判官","author":"石孝友","text":"阳关声里催行色。\n马惜离群人惜别。\n入怀风月记衔杯，迎步溪山供散策。\n阴飙断渡江吹白。\n晴壑吞云天放碧。\n悬知诗兴满归途，三四野梅开的砾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26671,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"木兰花/玉楼春 其二","author":"石孝友","text":"寻春误入桃源洞。\n草草幽欢聊与共。\n牢笼风月此时情，做造溪山今夜梦。\n柳蹊未放金丝弄。\n梅径已经香雪冻。\n春愁离恨重于山，不信马儿驼得动。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26672,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水龙吟","author":"石孝友","text":"旧游曾记当年，凤城雨露开晴昼。\n端门发钥，御炉烟暗，宫花影覆。\n帝念民劳，俾乘轺传，暂临牛斗。\n散阳和四照，春光万井，来小试、调元手。\n职业才华竞秀。\n汉廷臣、无出其右。\n九重眷倚，频虚槐鼎，争迎衮绣。\n爽气西山，绿波南浦，酿成芳酒。\n趁锋车未到，霞觞共祝，百千长寿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26673,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水调歌头 其二 赵倅生辰","author":"石孝友","text":"萧滩韵环佩，玉笥灿玲珑。\n仙源积庆，当日占梦兆维熊。\n学业肯先歆向，文焰已高白贺，飞步更蟾宫。\n秀色溢眉宇，雄辩倒心胸。\n作儿戏，为亲寿，捧霞钟。\n彩衣摇曳，光映怀橘堕双红。\n正好平分风月，且伴能言桃李，鲸吸海涛洪。\n行赴紫泥诏，归拜黑头公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26674,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水调歌头 其五","author":"石孝友","text":"高情邈云汉，长揖谢君侯。\n脱遗轩冕，簸弄泉石下清幽。\n心契匡庐猿鹤，泪染固陵松柏，一衲且蒙头。\n风月感平发，魂梦绕神州。\n漾一叶，横孤管，去来休。\n琵琶亭畔，正是枫叶荻花秋。\n点检诗囊酒碗，抬贴舞裀歌扇，收尽两眉愁。\n回望碧云合，相伴赤松游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26675,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水调歌头 其一 上清江李中生辰","author":"石孝友","text":"清霜洗空阔，黍管吹秋灰。\n七蓂馀翠，半月流素影徘徊。\n天遣蟠根仙李，世折一枝丹桂，积庆到云来。\n风骨峭冰玉，谈辩屑琼瑰。\n黄阁老，金闺彦，谪仙才。\n小分铜竹，遍洒雨露楚江隈。\n好把萧滩玉笥，变作嘉肴芳酒，为寿莫停杯。\n飞诏下霄汉，调鼎待盐梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26676,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水调歌头 其四","author":"石孝友","text":"美人在何许，相望正悠悠。\n云窗雾阖，遥想宛在海中洲。\n空对残云冷雨，何限重山叠水，一梦到无由。\n遗怨写红叶，薄幸记青楼。\n金乌掷，玉蟾缺，物华休。\n凤梧眢井，一夜风露各惊秋。\n唯有远山无赖，淡扫一眉晴绿，特地向人愁。\n敛袂且归去，回首谩迟留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26677,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水调歌头 送张左司","author":"石孝友","text":"君恩九鼎重，臣命一毫轻。\n出身事主，刚甚须作不平鸣。\n老却西山薇蕨，闲损南窗松菊，羞死汉公卿。\n豺狼敢横道，草木要知名。\n秋已素，人又去，若为情。\n长沙何在，风送呜咽暮潮声。\n举棹却寻归路，挥麈莫谈时事，得酒且频倾。\n一片古时月，千里伴君行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26678,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水调歌头 其三","author":"石孝友","text":"男儿四方志，岂久困泥沙。\n束书匣剑，依旧旅食在京华。\n蹭蹬青云未遂，奔走红尘何计，敛袂且还家。\n草木渐黄落，风月正清嘉。\n友猿鹤，宅丘壑，乐生涯。\n几时雷雨，轰磕平地起龙蛇。\n尺箠可鞭夷狄，寸舌可盂社稷，无路踏云车。\n今古万千事，洒泪向黄花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26679,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"长相思 其一","author":"石孝友","text":"你又痴。\n我又迷。\n到此痴迷两为谁。\n问天天怎知。\n长相思。\n极相思。\n愿得因缘未尽时。\n今生重共伊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26680,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"长相思 其四","author":"石孝友","text":"树槎牙。\n冰交加。\n冷艳疏疏瘦影斜。\n几枝梅放花。\n天一涯。\n语三叉。\n已是情多怨物华。\n那堪更忆家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26681,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"长相思 其二","author":"石孝友","text":"红依稀。\n绿依稀。\n寒勒花梢开较迟。\n蝶魂空自迷。\n怕人疑。\n使人疑。\n人道闲愁想未知。\n歌眉因甚低。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26682,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"长相思 其三","author":"石孝友","text":"蝶团飞。\n莺乱啼。\n陌上花开人未归。\n碧台歌舞稀。\n月入扉。\n风满帷。\n坐到黄昏人静时。\n清愁君不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26683,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]