[{"title":"三和 其二","author":"刘克庄","text":"岁晚文园渴疾深，相瞻北斗不堪斟。\n幸无封禅书留藁，岂有长门赋卖金。\n它日友人定郊谥，当时酒客诵雄箴。\n箕山未是逃名地，何处人间有密林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30856,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三和 其二","author":"刘克庄","text":"击磬何须入于海，括囊未免取诸坤。\n寻盟今已白鸥社，待诏昔曾金马门。\n鱼戏罕逢同队子，鸡窠会见二毛孙。\n两翁未易分优劣，一乐山村一水村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30857,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三和 其二","author":"刘克庄","text":"暂系金狨陪法从，长骑秧马杂耕夫。\n今红琥珀来村店，昔紫驼峰出御厨。\n阙里尚延瞽师冕，法筵谁起躄浮图。\n莫欺残秃毛锥子，几度曾将敕尾涂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30858,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三和 其二","author":"刘克庄","text":"同进多为蕡讼屈，薄徒苦与贺争名。\n从教雪犬吠所怪，肯学秋虫鸣不平。\n沙虱伺人阴发矢，虾䗫欲客化为坑。\n相逢莫说当时事，说著当时尚失惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30859,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三和 其一","author":"刘克庄","text":"自古名高易毁随，谁令俶傥更权奇。\n心知吾友必中鹄，眼见乃翁初梦罴。\n所幸解骖逢晏子，不须结客报袁丝。\n古人进德多因此，公冶台卿即汝师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30860,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三和","author":"刘克庄","text":"林下笋犹供采掘，门前草又欠芟除。\n绝无□□□三顾，时有僧来说六如。\n旧友寻盟将命驾，先□□□□垂车。\n今年田海俱中熟，处处人家足稻鱼。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30861,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三和 其一","author":"刘克庄","text":"高虚早被方心误，老退差贤曲学阿。\n私谥勿烦礼官议，自诗堪付挽郎歌。\n无衾覆首留名远，有锸随身觉事多。\n典午诸人空旷达，其如未了死生何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30862,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三和 其二","author":"刘克庄","text":"曾课山间种艺诗，自犹不记更谁知。\n岂无鼠盗食新笋，曾有凤来栖老枝。\n未敢名为真福地，便应唤做小仇池。\n篮舆祇合村夫举，儿子门生负笈随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30863,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三和 其三","author":"刘克庄","text":"交疏认鹿为山友，客少呼猿作野宾。\n藏手泽书惭忝祖，食躬耕粟耻求人。\n腹无点墨宁非懒，腰有重金未是贫。\n已把朝冠挂神武，终身一幅华阳巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30864,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三和二首 其一","author":"刘克庄","text":"岂有丝毫补圣朝，去来扰扰费麾招。\n不能履屐供群谢，未暇纶巾拥二乔。\n著老莱衣侔服冕，食于陵粟胜操瓢。\n臣之少也犹疏懒，何况头今插素标。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30865,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三和二首 其二","author":"刘克庄","text":"长剑拄颐刀纳靴，得如曝背趁阳和。\n买邻底用百万价，好事争为十二窝。\n异日史臣应有考，同时朝士欲无多。\n与君死守西山学，莫遣人讥末路蹉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30866,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三和二首 其一","author":"刘克庄","text":"身叠三绵凛似冬，老农不与壮丁同。\n饮泉吏鲜能清白，濒海民多有赤穷。\n晴雨幽人曾候鹳，水风闽囝亦占虹。\n汉家非有公私积，亨大毋庸说豫丰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30867,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三和二首 其二","author":"刘克庄","text":"世吏宽严若夏冬，欲安欲富此情同。\n楮先生贱难扶起，桑大夫生计亦穷。\n渐喜青规舒化日，更烦绛气导晴虹。\n若教子骏星常照，荒札从今可阜丰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30868,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三和二首 其二","author":"刘克庄","text":"厨人无职主君闲，春日惟供菜满槃。\n山下鸱肥聊共饱，堂中羊美得常餐。\n遍尝忧患肱三折，已过光阴指一弹。\n老去有巾宜漉酒，笑它楚客切云冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30869,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三和二首 其一","author":"刘克庄","text":"主圣时清万宇春，禽鱼花草各怀新。\n如何丹凤楼中手，未作金鸡竿下人。\n家有宁馨堪跨灶，囊无阿堵可通神。\n客谈江北狼烟息，暂展双眉不用颦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30870,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三和妆字韵陈魁载酒","author":"刘克庄","text":"荣途素定不须忙，羞作春妍爱古妆。\n众促夺袍诗进御，君宁微服夜归乡。\n怪来尊老升歌席，移就菩提养病坊。\n闻说重题新鹤表，分留印绶与诸郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30871,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三寄简叔","author":"刘克庄","text":"屡有诗贻田舍翁，灯花常至夜深红。\n莫嫌云榭文书冗，稍喜冰衔职任雄。\n健吏安知元结事，贪夫愧死伯夷风。\n得君厚禄吾何患，从此樽中酒不空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30872,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三叠","author":"刘克庄","text":"文字无穷才有穷，可能纤艳敌浑雄。\n蚤知大将坛场峻，晚作邻翁保社同。\n臣向雠书曾殿北，君公避世且墙东。\n男儿遇合由时命，岂必诗名满六宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30873,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七十四吟十首 其十","author":"刘克庄","text":"提鳌批凤霎时荣，身与浮名孰重轻。\n摩诘已为病居士，伯伦终是大先生。\n彼拳鸡肋恃朝气，此把蟹螯犹宿酲。\n未必颓然真茗艼，老人羞共少年争。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30874,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七十四吟十首 其九","author":"刘克庄","text":"游戏人间又一年，非儒非佛复非仙。\n历官甘出倚相后，序齿叨居绛老先。\n世难见花常溅泪，时平逢曲亦流涎。\n无端风月相勾引，不是先生爱放颠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30875,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七十四吟十首 其八","author":"刘克庄","text":"戍邕溃卒导蕃夷，闻说衡湘被祸奇。\n群盗忍残胜业柏，六丁应护中兴碑。\n赭君山木渠何罪，招国殇魂鬼亦悲。\n早晚岳云俱汛扫，挽天河水洗疮痍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30876,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七十四吟十首 其七","author":"刘克庄","text":"黠儿蒙蔽聚群阴，岂料云收杲日临。\n坏證遗忧与宗社，捷书分喜到山林。\n擎天毕竟还高手，偃月从初谬用心。\n客自京师传吉语，放歌不觉有和音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30877,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七十四吟十首 其六","author":"刘克庄","text":"翠华未可议时巡，自古安危系重臣。\n闻说紫岩亲督战，孰云赤壁后无人。\n诸公尽作钻天令，老子重为击壤民。\n万里阴霾冰霰合，一通露布挽回春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30878,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七十四吟十首 其五","author":"刘克庄","text":"养生之说要形劳，井臼何须晚自操。\n齿豁未须烦祝鲠，臂挛殊不碍持螯。\n除驱病祟无灵剂，禆补脾神赖老饕。\n尚有一襟哀郢泪，久疏夜饮省春遨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30879,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七十四吟十首 其四","author":"刘克庄","text":"万里当年慕建侯，而今痴坐衲蒙头。\n臭皮袋有形为累，古锦囊无句可收。\n拾穗翁饥歌不辍，散花人黠去难留。\n荒村不办肩舆者，未害先生策杖游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30880,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七十四吟十首 其三","author":"刘克庄","text":"儿萦薄宦女从夫，谁伴庞翁拥地炉。\n颇忆都尝煨芋否，肯归同卖漉篱无。\n春游捉辔惟宗武，晨起称觞仅阿奴。\n一句汝曹牢记取，家山差稳似江湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30881,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七十四吟十首 其二","author":"刘克庄","text":"邻鸡呼觉强冠簪，病起屠苏且浅斟。\n旋读生书无记性，冥搜警句有贪心。\n生惭族老封高尚，死慕先贤谥醉吟。\n自笑此翁迂阔甚，后千百世待知音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30882,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七十四吟十首 其一","author":"刘克庄","text":"早衰安敢望年高，镜里双眉有白毫。\n消夜赌棋张画烛，怯寒添絮入绨袍。\n百骸受病惟诗健，万事输人独饮豪。\n梨栗满山皆硕果，何须海上访蟠桃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30883,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上巳","author":"刘克庄","text":"樱笋登盘节物新，一筇踏遍九州春。\n似曾山阴访脩竹，不记水边观丽人。\n豪饮自怜非少日，俊游亦恐是前身。\n暮归尚有清狂态，乱插山花满角巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30884,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上冢","author":"刘克庄","text":"落梅万点晓泥乾，擘纸携家去上山。\n宁与先君游地下，肯随谄子乞墦间。\n墼墙渍雨颓偏易，沙土栽松长极艰。\n毕竟有惭庐墓士，林扉夜只付僧关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30885,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与北山陈龙图","author":"刘克庄","text":"小儿胆大说文章，萤火难争两曜光。\n侍讲先生今寂寂，龙图老子尚堂堂。\n邻无羊仲并求仲，家有元方与季方。\n想见瘦梅疏竹下，深衣如雪鬓须苍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30886,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与林中书李礼部同宿囊山三首 其三","author":"刘克庄","text":"二妙相从寂寞滨，山灵怪有此嘉宾。\n作桑下梦才三宿，比橘中翁少一人。\n剪截锦机输子巧，分张宝藏拔予贫。\n临歧但祝俱黄发，莫把华簪换角巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30887,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与林中书李礼部同宿囊山三首 其二","author":"刘克庄","text":"三儒夜话俱忘寝，户外纵横卧仆夫。\n椰腹拈来即书簏，芋头煨熟当行厨。\n谪仙岂是无诗种，处士相传有句图。\n师服何曾能把笔，短章吟就改还涂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30888,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与林中书李礼部同宿囊山三首 其一","author":"刘克庄","text":"儒林巨擘竹溪公，来憩棠阴访老农。\n刘子前身汉中垒，李侯今代柳南宫。\n约灵澈共游林下，爱涅槃常坐塔中。\n莫把两贤侪一叟，弹冠不与挂冠同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30889,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与客送仲白葬回登石室","author":"刘克庄","text":"绝顶荒寒断客过，偶携之子共扪萝。\n纵观天外皆鲸浸，下视城中等蚁窠。\n悼友孤怀方濩落，逢僧逆境暂销磨。\n夜归剩乞松明火，霜满前山滑处多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30890,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与零陵周倅子镕","author":"刘克庄","text":"满目山河异，南冠十六期。\n胡羝无乳日，辽鹤有归时。\n诇虏几齑粉，还朝不磷缁。\n汉家重名节，郎秩未为卑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30891,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"久不得池阳书","author":"刘克庄","text":"黑帜游魂尚未还，列城处处受风寒。\n遥知鲁女悲而啸，深愧庞公遗以安。\n道远家人无恙否，时危身世苟全难。\n何时火伴并邻里，沽酒刲羊贺木兰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30892,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"久雨","author":"刘克庄","text":"晴旭常难保，春寒未易禁。\n锋交马旋泞，室毁燕巢林。\n民望兵如雨，人言潦属阴。\n何当抉云雾，放出太阳临。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30893,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"久雨二首 其二","author":"刘克庄","text":"登高四望积云深，失了金乌底处寻。\n未可沤麻需潦退，临当晒麦辄天阴。\n宝开元画忧岚湿，惜善和书怕蠹侵。\n只道闲人无系累，岂知亦有事关心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30894,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"久雨二首 其一","author":"刘克庄","text":"倏暖俄寒气候偏，未梅一月雨连绵。\n移床自笑无乾处，鍊石渠能补漏天。\n风卷杜陵几重屋，江通甫里百弓田。\n谁言野老无忧责，据枕终宵不得眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30895,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"久客","author":"刘克庄","text":"久客长安市，人情薄似云。\n宁为绝交论，不著送穷文。\n白发长千丈，黄金尽百斤。\n故山春事动，深恐废耕耘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30896,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"千山观","author":"刘克庄","text":"西巘林峦擅一城，渺然飞观入青冥。\n于湖数字题华栋，阳朔千山献画屏。\n境胜小诗难写尽，天寒薄酒易吹醒。\n独游不恨无人语，满壑松声可细听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30897,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"卫生","author":"刘克庄","text":"卫生草草昧周防，小郡无医自处方。\n采下菊宜为枕睡，碾来芎可入茶尝。\n身因病转添萧飒，人到衰难再盛强。\n旧喜读书今亦懒，铜炉慢炷一铢香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30898,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"卫生一首","author":"刘克庄","text":"沙虱鬼车微物尔，偶然逢彼立灾身。\n朵颐唇吻中伤汝，射影疮疣点污人。\n读卫生书思解毒，持降魔咒竟无神。\n寄声禽大休轻出，莫向荒山点水滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30899,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大目寺","author":"刘克庄","text":"来人云虎出，留此到昏钟。\n寺小于诸刹，山高似众峰。\n未寒先得雪，已夏尚如冬。\n老子曾游浙，微微有辨锋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30900,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大行皇帝挽诗六首 其六","author":"刘克庄","text":"英鉴高千古，名尤不假人。\n周惟十夫哲，汉止一儒醇。\n圣笔严褒贬，臣材岂拟伦。\n骊珠六十九，谁谓橐中贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30901,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大行皇帝挽诗六首 其五","author":"刘克庄","text":"自惜孤寒士，栖栖到老休。\n生前浩然弃，殁后所忠求。\n臣草金鸡赦，帝临丹凤楼。\n追怀稀阔遇，恨不杀身酬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30902,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大行皇帝挽诗六首 其四","author":"刘克庄","text":"颇怪旄头异，何曾玉色怡。\n恶言闻佛耳，夷猾上尧眉。\n河岂无清日，天曾有坏时。\n嗣皇新缵禹，遗老喜还悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30903,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大行皇帝挽诗六首 其三","author":"刘克庄","text":"虏哨无宁处，龙颜有隐忧。\n未曾御戎服，已报走旃裘。\n地拓黄河土，天烧赤壁舟。\n奈何投柱斧，不待献俘囚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30904,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大行皇帝挽诗六首 其二","author":"刘克庄","text":"临照三千界，涵濡四十春。\n沙难量福寿，天不大尧仁。\n眇小坡诗案，优容濮议人。\n老臣偏恸绝，曾扈属车尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30905,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大行皇帝挽诗六首 其一","author":"刘克庄","text":"仁厚传嘉祐，重华继绍兴。\n方恢周境土，忽治汉山陵。\n俭匪珠襦殓，危犹玉几凭。\n遥知天上乐，难返白云乘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30906,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"子□林倅饷予双鸡","author":"刘克庄","text":"空谷跫然闻足音，殷勤通守致家禽。\n阴晴不爽司晨□，□暮全无起舞心。\n梦短那堪眠警枕，胫长稍已怯□衾。\n可怜一念尤迂阔，朗诵西山夜气箴。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30907,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小寺","author":"刘克庄","text":"小寺无蹊径，行时认藓痕。\n犬寒鸣似豹，僧老瘦于猿。\n涧水来旋磨，山童出闭门。\n城中梅未见，已有数株繁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30908,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小园即事五首 其五","author":"刘克庄","text":"稍转阳和解积阴，暂停汤熨事微吟。\n翠禽娱客有佳哢，金鲫知人无杀心。\n一片不留花著树，数竿忽见笋成林。\n野蹊滑滑泥平膝，荷锸奴扶试一寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30909,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小园即事五首 其四","author":"刘克庄","text":"拂拭桃笙设葛幮，床头老易卷还舒。\n惯听小子嘲师语，懒作痴人骂鬼书。\n无复出神游帝所，有时信脚到华胥。\n独怜短梦匆匆觉，不晓希夷睡月馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30910,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小园即事五首 其三","author":"刘克庄","text":"乍脱重裘试薄纨，绿阴多处小凭栏。\n李甘尚可分螬半，柿落何妨拾鸟残。\n贷粟监侯宁忍饿，借衣友婿不如寒。\n獠奴但怪沉吟久，肯信诗中字未安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30911,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小园即事五首 其二","author":"刘克庄","text":"灵椿难减菌难加，莫笑山翁两鬓华。\n不与公荣同饮酒，只留禹锡独看花。\n客来稍觉罍空耻，事去方知瓮算差。\n归老东陈无可恨，失侯不失故园瓜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30912,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小园即事五首 其一","author":"刘克庄","text":"投老诛茆水竹村，未论避谤且逃喧。\n屋低稳似于谁屋，园小贤于乐彼园。\n待小车来时上阁，有高轩过勿开门。\n蜗牛不晓虫鱼法，作意麻搽篆粉垣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30913,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小饮","author":"刘克庄","text":"暮年衰老读书慵，惟有杯中兴尚浓。\n枕曲惰人真远祖，看花跛子亦同宗。\n鲚鱼虾䱹何亏汝，螺蠃螟蛉妄议侬。\n帝赐醉乡为食邑，此生不必更移封。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30914,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小圃有双莲夏芙蓉之喜文字祥也各赋一诗为宗族亲朋联名得隽之谶 其一","author":"刘克庄","text":"一色双葩费剪裁，固知造物巧胚胎。\n机云乍自吴中出，坡颍初从蜀道来。\n佳谶似因先辈设，瑞苞不为老人开。\n集英明岁薰风里，席上英才即斗魁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30915,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小斋","author":"刘克庄","text":"小斋自理画并琴，匣贮香薰怕蠹侵。\n出塞已忘传檄梦，入山犹有著书心。\n南船不至城无米，北货难通药阙参。\n却为贫居还往少，门前留得绿芜深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30916,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小桃源","author":"刘克庄","text":"出山已不辨东西，新径多岐失故蹊。\n源里飘红无杂树，村中戴白有遗黎。\n略加蕝识认来路，似有茅茨遥隔溪。\n太守渔郎两痴绝，自迷岂解指人迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30917,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小雪后二日二首 其二","author":"刘克庄","text":"一苍头赞谒，两赤脚扶行。\n医柰毋吟咏，宾嗔不送迎。\n都忘虚室白，时梦小窗明。\n回首然藜地，谁怜老更生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30918,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小雪后二日二首 其一","author":"刘克庄","text":"吾评世间病，至惨莫如盲。\n亲友不觌面，子孙惟认声。\n根存神不死，食既魄难生。\n赖有鬳斋老，书来吊失明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30919,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]