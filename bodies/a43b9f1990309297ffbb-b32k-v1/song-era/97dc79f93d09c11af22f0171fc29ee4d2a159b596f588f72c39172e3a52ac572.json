[{"title":"偈二十二首 其七","author":"释子淳","text":"三德齐敷结净缘，十方僧宝世良田。\n愿将此日无为福，上祝皇图亿万年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6509,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二十二首 其六","author":"释子淳","text":"屈指忻逢腊月八，释迦成道是斯辰。\n二千年后追先事，重把香汤浴净身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6510,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二十二首 其五","author":"释子淳","text":"山上今冬少阴雪，晴和天气如春月。\n斯辰又喜一阳生，梅根占得先开发。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6511,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二十二首 其二","author":"释子淳","text":"萧索茅庵草乱埋，柴扉日午尚慵开。\n冥然独坐枯眼上，孰谓殊恩云外来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6512,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二十二首 其一","author":"释子淳","text":"骊珠未剖价难酬，灼烁寒光映碧流。\n罔象未能知去处，更凭子细说端由。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6513,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈五首 其五","author":"释子淳","text":"日照孤峰翠，月临溪水寒。\n祖师玄妙诀，莫向寸心安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6514,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈五首 其二","author":"释子淳","text":"我宗有语句，金刀剪不开。\n深深玄妙旨，玉女夜怀胎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6515,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄度兄道友","author":"释子淳","text":"寂照含虚未兆身，翛然那与物为邻。\n任经风月霜威重，枯木花芳不犯春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6516,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄随守向大夫三首 其三","author":"释子淳","text":"无弦琴上有希声，此遇知音作證明。\n不犯指端弹一曲，碧琉璃界月三更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6517,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄随守向大夫三首 其一","author":"释子淳","text":"岁寒木欲老林坰，兹沐恩光入翠层。\n再整丝纶垂钓手，随缘涢水且腾腾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6518,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢王宣教见访","author":"释子淳","text":"柴扉常对白云开，玉凤衔花去又回。\n不学东林远沽酒，渊明多谢入山来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6519,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢安抚张学士惠茸毡","author":"释子淳","text":"虚室更深冷不眠，翛翛孤坐几经年。\n昨宵又觉还耽睡，元是新铺白玉毡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6520,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬时于叔","author":"释子淳","text":"妙句灵然溢目寒，幽微旨趣曾还难。\n相逢更问无弦曲，风入松梢不在弹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6521,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬刘书记朝奉二首 其二","author":"释子淳","text":"应现宰官人不识，栖心祖域道情腴。\n不怜金印大如斗，自贵衣中无价珠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6522,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬寂道人","author":"释子淳","text":"言前无句拟何伸，妙语玄谈眼里尘。\n一邑毗耶金粟众，想应翻笑住山人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6523,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"静上人病以偈贻之","author":"释子淳","text":"火风地水合为身，犹若晴空一点尘。\n借问病从可处起，祇应谁是病中人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6524,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蠲上人求颂","author":"释子淳","text":"一九逢春信，梅花破雪开。\n个中如会得，千里不空来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6525,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居五首 其四","author":"释子淳","text":"兀坐镇长行，孰人知此情。\n竹风轻有韵，岩溜细无声。\n岌岌三山秀，依依片月明。\n门前枯树子，孤鹤梦难成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6526,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居五首 其三","author":"释子淳","text":"家近乱山根，日高懒启门。\n樵歌云外唱，胡曲句前论。\n路僻无人到，庭荒有藓痕。\n萧萧岩石畔，祇么老烟村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6527,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二十二首 其十一","author":"释子淳","text":"三月安居已半过，虚明心地又如何。\n有求宛然成机巧，无作方能不较多。\n炉里寒灰香旖旎，岩前枯木叶婆娑。\n白头人在千峰上，妙唱新丰一曲歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6528,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢蒙城善友惠米","author":"释子淳","text":"客到蒙城有信归，殷勤惠米助晨炊。\n老僧钵满慵相唤，长者恩深祇自知。\n粒粒圆成难著会，明明嚼碎更何疑。\n赵州遗语诚非谬，一饱元来忘百饥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6529,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"默曜堂访预监寺不遇","author":"释子淳","text":"昔年摩竭令，今日孰知恩。\n句外潜心体，言前密意论。\n松风清宇宙，桂月曜乾坤。\n出户虽无往，争如静掩门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6530,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"五位 其三","author":"释子淳","text":"正中来，一叶轻舟泛远滩。\n锦鳞不触香钩饵，何得丝纶更犯膻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6531,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"五位 其四","author":"释子淳","text":"偏中至，收丝却返芦花里。\n高攲龟枕恣情眠，长江信任波涛起。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6532,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"五位 其五","author":"释子淳","text":"兼中到，更阑六宅无音耗。\n纵横泽国路优游，樵人举步应难造。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6533,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"五位 其一","author":"释子淳","text":"正中偏，宝月光凝海底天。\n何事渔舟难满载，流辉争肯透波澜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6534,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"五位 其二","author":"释子淳","text":"偏中正，水云深锁渔家境。\n一派长法极目清，日照筠竿那露影。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6535,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居五首 其五","author":"释子淳","text":"不恋白云关，家山撒手还。\n玉炉香旖旎，石涧水潺湲。\n庭树烟笼合，窗轩雨洒斑。\n经行及坐卧，常在寂寥间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6536,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居五首 其二","author":"释子淳","text":"祇这一闲田，古今无变迁。\n泥牛耕不尽，宝月镇长圆。\n岩桂和烟翠，溪花含露鲜。\n甘藏青嶂里，懒更谒时贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6537,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居五首 其一","author":"释子淳","text":"林麓结茅庐，翛然称所居。\n松风惊破梦，涧水静涵虚。\n春老花犹媚，秋残叶未疏。\n良宵无限意，东岭月生初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6538,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"丹霞开山天然禅师","author":"释子淳","text":"丹山月冷，祖室穴清。\n瞻之仰之，千载扬名。\n古佛不存檀佛像，寒岩曾许铁牛耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6539,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"丹霞第二代无学禅师","author":"释子淳","text":"皎月流辉，景澄寒水。\n万有齐彰，太虚廓尔。\n禅版曾酬上上机，当锋未荐西来旨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6540,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"丹霞第三代安禅师","author":"释子淳","text":"龙准高不高，虎颐短不短。\n半夜昆崙儿，两手扶银椀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6541,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"丹霞第四代勋禅师","author":"释子淳","text":"寒风凛凛，古貌堂堂。\n俱卢日午，瞻部夜央。\n声前一句兮从尔商量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6542,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"五位 其三","author":"释子淳","text":"正中来，运步红炉遍九垓。\n宝月夜光随处静，披云终不露纤埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6543,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"五位 其五","author":"释子淳","text":"兼中到，及尽有无真个妙。\n披毛戴角火中行，纵横不落今时道。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6544,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"五位 其二","author":"释子淳","text":"偏中正，嫫母临妆羞照镜。\n三更玉户不挑灯，混融非露当年影。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6545,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"五位 其四","author":"释子淳","text":"偏中至，大用无私何拟议。\n当锋那肯落今时，他来自有超伦志。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6546,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"五位 其一","author":"释子淳","text":"正中偏，宝殿烟笼月色前。\n井底燃灯天未晓，暗中谁辨往来源。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6547,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"净因和尚","author":"释子淳","text":"即真非真，是假非假。\n语路未陈，言满天下。\n骊龙海卧彩云深，黑漆昆崙骑玉马。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6548,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和正可知藏适轩","author":"释子淳","text":"适轩新开非华饰，为爱清凉消暑湿。\n景象千般何处来，尘埃一点应难入。\n蒲团禅版静沉沉，松韵竹风常龚龚。\n香断炉寒坐夜深，苔墀月满无人立。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6549,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和净因老师渔父词 其二","author":"释子淳","text":"洪鳞每自藏深派，今朝钓得真奇怪。\n鼓棹惊波桑田改，三灾坏，恁时方称生涯在。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6550,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和净因老师渔父词 其四","author":"释子淳","text":"锦鳞吞饵浮丝摆，樵父两岸皆怜爱。\n直透龙门头角改，谁能怪，为霖方显灵通大。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6551,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和净因老师渔父词 其三","author":"释子淳","text":"潦倒渔翁一无解，苍苍雪鬓知何载。\n短棹轻舟泛沧海，抛钩在，碧波深处全无阂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6552,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和净因老师渔父词 其一","author":"释子淳","text":"四海无家何拘碍，垂丝坐对烟云霭。\n水急风和舟行快，严霜届莲裳，箨笠和烟戴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6553,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"钓者","author":"释子淳","text":"海际烟收欲暮天，扁舟轻泛出芦湾。\n丝纶夜掷清波里，晓得金鳞不犯竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6554,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赵州婆子勘破话","author":"释子淳","text":"木人岭上歌，石女溪边舞。\n明月共同途，无私照今古。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6555,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送化工","author":"释子淳","text":"春云不世情，滋泽兴还普。\n从龙向海飞，散作人间雨。\n幽洞无门任卷舒，悠悠莫忘青山父。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6556,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送升上人驰法嗣书","author":"释子淳","text":"飞花暖日轻相送，烈焰须凭作者通。\n觌面不劳伸语路，丹山千里事同风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6557,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送止维那作丐","author":"释子淳","text":"常思止禅者，返本如婴儿。\n一念万年去，春秋都不知。\n斫倒寒岩无影树，回头焰里再抽枝。\n春老别吾入郦去，缘生会有归山咦。\n净榻相看坐，清风起四维。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6558,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送汲助教医博","author":"释子淳","text":"未到毗耶城，不识维摩病。\n有客兮良医，妙术通神圣。\n金针针起髑髅吟，此曲千年谁与并。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6559,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送吴公裕","author":"释子淳","text":"天气暄妍三月春，青山垂访白头人。\n威仪雍肃披儒雅，语论清泠洗渴尘。\n道合圆常无异路，心空及第自通津。\n相逢相别休怀念，千里同风德及邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6560,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送庞婆","author":"释子淳","text":"刹刹西来意，尘尘古佛心。\n眉毛为道侣，鼻孔作知音。\n借问牛头何处去，衔花幽鸟杳难寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6561,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送环知客归省亲","author":"释子淳","text":"清风明月秋光半，环禅别我云南归。\n当堂子母相逢日，妙圆孰敢分离微。\n咦，拨转吾家向上机，回头触处生光辉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6562,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"般阳老人","author":"释子淳","text":"昔年颜似玉，今日鬓如霜。\n不挂金襕服，还衣白氎裳。\n彩凤夜栖无影树，晓天云绽露斜阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6563,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一○一首 其七十一","author":"释子淳","text":"一念萧萧不记年，皮肤脱落自完全。\n长天夜夜清如镜，万里无云孤月圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6564,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一○一首 其三十一","author":"释子淳","text":"妙峰孤顶偏肥腻，天产灵苗不触地。\n翠叶无风常自摇，清香那逐春光媚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6565,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一○一首 其八十五","author":"释子淳","text":"妙体堂堂相好全，青霄独步蹑金莲。\n千华台上犹慵坐，弊垢襕衫岂肯穿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6566,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一○一首 其六","author":"释子淳","text":"垂手还他作者机，寻常语里布鎗旗。\n重询拟进归方丈，一句分明更不疑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6567,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一○一首 其四十九","author":"释子淳","text":"月中玉兔夜怀胎，日里金乌朝抱卵。\n黑漆昆崙踏雪行，转身打破琉璃椀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6568,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一○一首 其六十","author":"释子淳","text":"三番白纸问寒暄，千里同风月满船。\n夺得高标全用处，盘蛇口内打鞦韆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6569,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一○一首 其一","author":"释子淳","text":"妙相圆明不可亲，奴儿婢子自殷勤。\n指天指地称尊大，也是传言送语人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6570,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二十二首 其二十二","author":"释子淳","text":"出家儿，无休暇，终日忙忙空搆架。\n临行一著太区区，眼见耳闻争不怕。\n百骸狼藉撒奚了，普请般柴用烧化。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6571,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二十二首 其十九","author":"释子淳","text":"残冬凛冽寒，滴水便成团。\n翻忆少林祖，齐腰立雪难。\n或谓将心与汝安，觅心不见一毫端。\n廓然记得来时路，顿觉壶中景象宽。\n琉璃光里一般般，午夜依依月正圆。\n最先三子得皮肉，末后一人得髓还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6572,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二十二首 其十二","author":"释子淳","text":"大洪拂子，非有名，非无名，七费前前本混成。\n非有相，非无相，渊而无下高无上。\n若论阴阳未兆时，卷舒俱在光明藏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6573,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二十二首 其九","author":"释子淳","text":"静极光通本妙圆，嘶风玉马过重关。\n回途不落威音世，妙用全彰化外看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6574,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二十二首 其四","author":"释子淳","text":"晓风吹散碧天云，日上长空景象分。\n寂照含虚无内外，当明一句若为论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6575,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二十二首 其三","author":"释子淳","text":"危峦萧洒古禅宫，信步重归趣无穷。\n风卷白云天界净，一轮红日正当空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6576,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈五首 其四","author":"释子淳","text":"宝月流辉，澄潭布影。\n水无蘸月之意，月无分照之心。\n水月两忘，方可称断。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6577,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈五首 其三","author":"释子淳","text":"亭亭日午犹亏半，寂寂三更尚未圆。\n六户不曾知暖意，往来常在三更前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6578,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄随守向大夫三首 其二","author":"释子淳","text":"道同曾未隔毫端，相别相逢会者难。\n偶此又蒙清照及，松风桂月袭人寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6579,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渔父子送齐明二化士 其二","author":"释子淳","text":"渔父从来性本宽，满船钓得未为欢。\n收丝了，望层峦，举头方觉天际晓星残。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6580,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渔父子送齐明二化士 其一","author":"释子淳","text":"凛凛严风彻骨寒，扁舟轻泛碧波澜。\n金线直，玉钩端，锦鳞无限，踊跃上琅玕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6581,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渔父词五首 其五","author":"释子淳","text":"钓尽江湖晓色分，数声羌笛韵凌云。\n波浩渺，雾氛氲，鼓棹回舟望海垠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6582,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渔父词五首 其四","author":"释子淳","text":"轻泛兰舟入海涯，抛钩掷线莫迟疑。\n骊龙子，巨鳌儿，不犯清波钓得伊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6583,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渔父词五首 其三","author":"释子淳","text":"青虚为钓复为钩，断索篮儿没底舟。\n随放荡，任横流，玉浪堆中得自由。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6584,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]