[{"title":"偈颂一一二首 其三十七","author":"释清远","text":"会既少，举尤难，丛林虽有日凋残。\n若欲明斯旨，应须离念看。\n一人如领解，大众尽心安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59569,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其三十八","author":"释清远","text":"狸奴白牯念摩诃，猫儿狗子长相见。\n诸禅客，荐不荐。\n若言自性本圆明，大似扪空追闪电。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59570,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其三十九","author":"释清远","text":"不动龙门内，行参古佛机。\n亲逢渠面目，肯话自容仪。\n凡圣心平等，高低路坦夷。\n丹霞烧木佛，院主落须眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59571,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其四十","author":"释清远","text":"正当恁么时，历劫不曾迷。\n步步超三界，归家顿绝疑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59572,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其四十一","author":"释清远","text":"几回生，几回死，生死悠悠无定止。\n自从顿悟了无生，于诸荣辱何忧喜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59573,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其四十二","author":"释清远","text":"五色灯光眚所成，但除其眚莫除尘。\n若言本眼何曾眚，乃是临河渴死人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59574,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其四十三","author":"释清远","text":"劫火威音前，虽有一壶天。\n御楼看射猎，不是刈茅田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59575,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其四十四","author":"释清远","text":"腊月扇子功勋绝，浩浩凉风动寥泬。\n岂止炎蒸六月天，暂时与君解烦热。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59576,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其四十五","author":"释清远","text":"泡幻同无碍，如何不了悟。\n眼里瞳人吹叫子，达法在其中。\n非今亦非古，六只骰子满盆红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59577,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其四十六","author":"释清远","text":"诸人未到龙门山，将道龙门在世间。\n既到龙门心自在，杉松拂拂水潺潺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59578,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其四十七","author":"释清远","text":"龙门三月半，大鼓声声唤。\n唤得一时来，特地生迷乱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59579,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其四十八","author":"释清远","text":"收得本名度牒，踏遍自己山川。\n闻有龙门长老，走来学道参禅。\n恁么惺惺汉子，如何立地瞌眠。\n忽然睡醒眼开，元来天生自然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59580,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其四十九","author":"释清远","text":"思无思思，万邪一正。\n不识玄旨，徒劳念静。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59581,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其五十","author":"释清远","text":"作无作作，贯色通声。\n水中盐味，不见其形。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59582,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其五十一","author":"释清远","text":"言无言言，不费唇舌。\n未说之法，林中之叶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59583,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其五十二","author":"释清远","text":"龙门潦倒，告报诸人。\n既然如是，何故因循。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59584,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其五十三","author":"释清远","text":"一叶飘瓢水上归，姑苏春色照岩扉。\n坐禅片石重来看，却笑山云拂藓衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59585,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其五十四","author":"释清远","text":"杜顺文殊事可知，定光如来老大隋。\n张三李四何王赵，问你渠今是阿谁。\n廛市卖鱼忘进趣，案头分肉露全机。\n男儿锁子黄金骨，苦痛无明堕污泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59586,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其五十五","author":"释清远","text":"登龙门下无凡客，不假风雷自有奇。\n三月进修从此始，经行宴坐可思议。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59587,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其五十六","author":"释清远","text":"十方世界龙门寺，大地山河是学徒。\n随顺众缘成解脱，算来全不费工夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59588,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其五十七","author":"释清远","text":"岂可唤钟作瓮，终不指鹿为马。\n善人难犯，水银无假。\n冷地忽然觑破，管取一时放下。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59589,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其五十八","author":"释清远","text":"龙门若为作端午，打动众人涂毒鼓。\n髑髅破后遣谁闻，鉴觉尽时敢言普。\n是谓南山鳖鼻蛇，好个大雄白额虎。\n可怜开眼觅眼人，嚇日光中寻入路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59590,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其五十九","author":"释清远","text":"飘飘飖飖杨柳花，红红赤赤远天霞。\n屈屈曲曲龙门路，僻僻静静野僧家。\n尚不心头怀胜解，谁能劫外算河沙。\n休粮方子斋兼粥，任运还乡苦涩茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59591,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其六十","author":"释清远","text":"七七四十九，面南看北斗。\n死去与生来，泥牛大哮吼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59592,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其六十一","author":"释清远","text":"骨还父，肉还母。\n何者是身，分明听取。\n山河国土现全躯，十方世界在里许。\n万劫千生绝去来，山僧此说非言语。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59593,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其六十二","author":"释清远","text":"总别同异兼成坏，祇是山僧与众人。\n高广须弥入芥子，无边刹海在微尘。\n昼复夜，秋复春，境寂心融事事真。\n七宝大车既如此，去来语默莫因循。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59594,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其六十三","author":"释清远","text":"■■鸟，守空池。\n鱼从脚下过，■■总不知。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59595,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其六十四","author":"释清远","text":"赵州不见南泉，山僧不识五祖。\n甜瓜彻蒂自甜，苦瓠连根自苦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59596,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其六十五","author":"释清远","text":"尊者憍陈如，九旬最亲切。\n老少幸相依，上下皆欢悦。\n瞻听离闻见，承览亦超绝。\n四海五湖人，勿谓真机泄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59597,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其六十六","author":"释清远","text":"开一片田，密密绵绵。\n两顿粥饭，其道自办。\n山僧一夏，与诸人相见。\n自是诸人不荐，若或荐成一片。\n是什么一片，看取当门箭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59598,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其六十七","author":"释清远","text":"一漏逗，二漏逗，三漏逗，用意搀前先在后。\n莫于佛祖结冤亲，好看衣珠常离垢。\n家中人，斗头走，淮南笑杀龙门叟。\n有人若会笑因由，眼似铜铃大如斗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59599,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其六十八","author":"释清远","text":"木平山里人，貌古言复少。\n相看陌路同，论心秋月皎。\n坏衲线非蚕，助歌声有鸟。\n城郭今日来，一沤曾已晓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59600,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其六十九","author":"释清远","text":"一沤未发时，宝盖向空垂。\n瑞色飘飘起，香风拂拂吹。\n何劳轻举拂，不假略扬眉。\n五百曾亲献，如来印可之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59601,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其七十","author":"释清远","text":"百丈说大义，辛勤事可知。\n龙门无道理，大众绝狐疑。\n帝力乾坤重，君恩雨露垂。\n有人相借问，云外略扬眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59602,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其七十一","author":"释清远","text":"鼓声才动，法义已周。\n大众上来，寻光而至。\n山野高提祖印，诸人共息狐疑。\n直须倒岳倾湫，切莫寻枝摘叶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59603,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其七十二","author":"释清远","text":"南阎浮提人，就中多闹乱。\n无想四禅天，根性最迟缓。\n迟速不同伦，染净难回换。\n两个五伯文，元来是一贯。\n贯贯，哑子拍手高声唤，聋人听得佯不管。\n天明日出是夜半，智者大师谭止观。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59604,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其七十三","author":"释清远","text":"死心心已死，心死死由生。\n拗折黄龙角，翻身卧地行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59605,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其七十四","author":"释清远","text":"虚名虚相，谷音鉴像。\n弃而不修，岂明幻妄。\n少不努力，老矣惆怅。\n静以思之，随机称量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59606,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其七十五","author":"释清远","text":"一叶落，天下春。\n无路寻思笑杀人。\n下是天，上是地，此言不入时流意。\n南作北，东作西，动而止，喜而悲。\n蛇头蝎尾一试之，猛虎口里活雀儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59607,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其七十六","author":"释清远","text":"眉毛眼睫最相亲，鼻孔唇皮作近邻。\n至近因何不相见，都缘一体是全身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59608,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其七十七","author":"释清远","text":"昔开正续铭，今示真归告。\n一路涅槃门，行说皆亲到。\n明然临济灯，妙唱黄龙道。\n空海久澄虚，云涛方浩浩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59609,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其七十八","author":"释清远","text":"西瞿耶尼打鼓，南瞻部州上堂。\n大众十方齐至，等閒野客称扬。\n此声遍满十方，照破闻见色香。\n堪笑释迦老子，等閒动地放光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59610,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其七十九","author":"释清远","text":"何处求通达，疑根自不凡。\n顿明心即佛，徒觉海非咸。\n善财楼阁路，日进丹霄步。\n凡夫云未然，我道常披露。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59611,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其八十一","author":"释清远","text":"虑而解，思而知，孤灯难并太阳辉。\n不是心，不是佛，为君扫荡精灵窟。\n摩天鹞子入云飞，千里万里祇一突。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59612,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其八十二","author":"释清远","text":"不起疏慵不进修，实无言说实无求。\n夺饥人口中之食，驱耕者手里之牛。\n真快活，百无忧。\n自是不归归便得，五湖风流拍天流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59613,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其八十三","author":"释清远","text":"若论佛，祇是当人更无物。\n若论顶，昼夜舒光照前境。\n若论心，看时无相用时深。\n若论经，解语能言不是声。\n若论斋，所为所作尽和谐。\n若论愿，犹如身在龙门院。\n若论了，无虑无疑心皎皎。\n心皎皎，增添福寿灾殃少。\n论量功德广难思，须弥未大沧溟小。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59614,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其八十四","author":"释清远","text":"一二三四五六七，讽诵受持皆秘密。\n如人亲入宝山中，一切珍奇从此出。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59615,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其八十五","author":"释清远","text":"道可学耶实不可学，心可悟耶实不可悟。\n不学不悟，真机全露。\n明月娑婆，浮生旦暮。\n眼若不睡诸梦除，古今出入无门户。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59616,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其八十六","author":"释清远","text":"山僧略升此座，大众永息狐疑。\n各各金毛师子，去来哮吼全威。\n临济高声连喝，德山拈棒痛槌。\n纵有一言半句，终不别作路歧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59617,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其八十七","author":"释清远","text":"出门便是草，闲杀龙门老。\n北去礼文殊，南来登五老。\n鬓发已苍浪，言归恨不早。\n独立秋风前，相思望江岛。\n好，好，不用更寻讨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59618,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其八十八","author":"释清远","text":"什么物，恁么来，休将明镜挂高台。\n什么物，恁么去，分明不用当头举。\n举得分明得更难，澄潭不许苍龙盘。\n便恁会，太无端，华藏毗卢世界宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59619,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其八十九","author":"释清远","text":"释迦世尊已成正觉，弥勒大士当来下生。\n老卢持过岭南，达磨携来东土。\n各谓度生已毕，我愿云周如何。\n六道四生犹在，土石诸山未殒。\n净妙国土不逢，为是愿力未充。\n为是业果难尽，为复别有道理。\n若不同床睡，焉知被底穿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59620,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其九十","author":"释清远","text":"空生不解岩中坐，春暖桃花树树红。\n漏泄天机无觅处，都缘露柱挂灯笼。\n灯笼灯笼，却有古风。\n露柱露柱，善解提举。\n一旦师姑是女儿，大悟堂中吃茶去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59621,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其九十一","author":"释清远","text":"心是根，法是尘，两种犹如镜上痕。\n痕垢尽时光始现，心法双亡性即真。\n根尘既谢，镜光现前。\n心法双亡，如何则是。\n赤??身无妄想，眼闻耳见离攀缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59622,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其九十二","author":"释清远","text":"迎日出门去，已觉披烟雾。\n冒月望山归，重露湿禅衣。\n心悄悄，步迟迟。\n无孔笛，再三吹。\n哩哩逻，逻逻哩。\n游子乍闻征袖湿，佳人犹唱翠眉低。\n君更听，莫狐疑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59623,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其九十三","author":"释清远","text":"海门山，长安道，茫茫烟水连芳草。\n楼头客，马上郎，一听落梅悲故乡。\n春风过眼花飞尽，蝴蝶翩翩过短墙。\n君更听，是何章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59624,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其九十四","author":"释清远","text":"帝力丘山重，君恩宇宙宽。\n不才何以报，处处得心安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59625,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其九十五","author":"释清远","text":"褒禅乍住太乾枯，月白风清入画图。\n人间纵有千般乐，不及今朝事事无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59626,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其九十六","author":"释清远","text":"云中石塔摩星斗，定明禅师大张口。\n是你之言若解参，不必腰包天下走。\n鸟对初阳自在啼，犬逢生汉连声吼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59627,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其九十七","author":"释清远","text":"祇知今日明朝，不觉今朝明日。\n事事一似安排，箭箭自然中的。\n甜者甜于黄连，苦者苦过白蜜。\n吃得者般滋味，不妨逻逻哩哩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59628,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其九十八","author":"释清远","text":"天得一，斗牛女虚危室毕。\n地得一，草木山河并土石。\n君得一，上下四维无等匹。\n万象森罗影现中，一颗圆明光的历。\n有欢荣，有愁戚。\n或冤亲，或顺逆。\n富且贵，贫且乞。\n万样千般谁运为，空谷之声随应出。\n鸳鸯绣了任君看，不露金针太绵密。\n褒禅奉劝各回头，莫待临行却啾唧。\n识取摩诃般若光，万古悠悠是今日。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59629,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其九十九","author":"释清远","text":"东西南北四方人，地阔天遥最是亲。\n衡岳天台连魏阙，轻轻弹指不劳神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59630,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其一○○","author":"释清远","text":"定明妙应禅师，说法如云如雨。\n不是时人不闻，又非不善其语。\n如斯一味灵通，过了几多寒暑。\n纵逢败种焦芽，方便一时救取。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59631,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其一○一","author":"释清远","text":"雨从何来，不须寻讨。\n遍满虚空，拔济枯槁。\n定明妙应灵通，知府舍人台造。\n真个是为雨为霖，莫不为忻为好。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59632,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其一○二","author":"释清远","text":"抵死要行云水脚，刚然求悟本来心。\n为蛇画足劳筋骨，辜负青山绿水深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59633,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其一○三","author":"释清远","text":"一去一来松上鹤，半开半合岭头云。\n支筇独立千峰外，唯把南山祝圣君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59634,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其一○四","author":"释清远","text":"君命重宣降薜萝，不容静处萨婆诃。\n襕衫席帽寒酸甚，又向人前唱哩啰。\n去年梅，今岁柳，颜色馨香依旧。\n人渐老，水长流，无心道合头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59635,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其一○五","author":"释清远","text":"尽力放不下，著力担不起。\n将谓一物无，元是自家底。\n见得自家底，心中大欢喜。\n自兹家业兴，一举九万里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59636,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其一○六","author":"释清远","text":"未达境惟心，起种种分别。\n达境唯心已，分别即不生。\n分别既不生，便舍外尘相。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59637,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]