[{"title":"游雪窦遣兴","author":"释绍嵩","text":"此地人来少，凭栏兴莫穷。\n云萝难透日，乔木易高风。\n书满闲窗下，云生闭目中。\n焚香赋诗罢，顿悟众缘空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16014,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"湖山堂晚坐","author":"释绍嵩","text":"木叶落时节，湖山向晚晴。\n移床桥上坐，看客海边行。\n寂寂饶孤兴，悠悠送此生。\n遣愁聊觅句，那敢谓长城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16015,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"疏山途次","author":"释绍嵩","text":"路曲山隈一径通，天开地辟幻金宫。\n溪桥袅袅穿黄落，雁字联联写碧空。\n唤客不须嫌酒恶，昔贤何必哭途穷。\n生涯淡淡随缘过，休把行藏问化工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16016,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登杖锡","author":"释绍嵩","text":"登寺寻盘道，那知是与非。\n冻泉依细石，寒日淡斜晖。\n村路飘黄落，山禽凌翠微。\n数声牛上笛，老泪欲沾衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16017,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登城","author":"释绍嵩","text":"奔走倦尘埃，登临亦快哉。\n江城含变态，踪迹共徘徊。\n古殿桐阴合，秋山晚翠开。\n相逢吟未足，更拟上高台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16018,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登楼","author":"释绍嵩","text":"二月春方好，登楼望欲迷。\n关情山簇簇，馀思草萋萋。\n小浦依林曲，长天向水低。\n乡心正无限，恰恰一莺啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16019,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登楼次朋上人韵","author":"释绍嵩","text":"落日生春色，桃花笑不休。\n鹤飞湖草迥，风止客帆收。\n树远天疑尽，江平水却流。\n愁来无处去，为子上高楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16020,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答一老","author":"释绍嵩","text":"散拙亦自遂，谁能泪堕巾。\n诗成聊疥壁，道在不嫌贫。\n老矣曾荣望，颓然只任真。\n拂衣从此去，四海作闲人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16021,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答仲宽","author":"释绍嵩","text":"强半年光属苦辛，生涯如在旧山贫。\n江南江北闲为客，人去人来恨转新。\n节里且追千载事，胸中别作一家春。\n明年此会知谁健，不问苍生问鬼神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16022,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答朋上人","author":"释绍嵩","text":"争渡行人簇晚沙，归舟天际暮云遮。\n波生野水雁初下，竹映寒原日已斜。\n剩欲出门追笑语，可堪垂白各天涯。\n知公颇有奇章病，戏墨贻嘲栖暝鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16023,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"道中自遣","author":"释绍嵩","text":"绿暗连村柳，江平不见滩。\n日烘花气暖，岸曲水流寒。\n世路今逾窄，客心须自宽。\n悠悠片云质，溪上更蹒跚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16024,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"道中即事","author":"释绍嵩","text":"饶水回回转，白云西复东。\n日斜喧急雨，天阔退飞鸿。\n薄暮沿西峡，隆寒正北风。\n兹行有胜事，未敢叹途穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16025,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"感山书事","author":"释绍嵩","text":"爱此栖心静，陶然度岁华。\n放慵真有味，化俗独无涯。\n隔沼连香芰，疏篱带晚花。\n细评清绝处，倚杖看蜂衙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16026,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"感恻","author":"释绍嵩","text":"路入南云下，江回隔近村。\n水深风浩浩，山远雾昏昏。\n仰首羡飞鸟，流年只断魂。\n客心兼暮色，感恻复何言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16027,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"溪上","author":"释绍嵩","text":"弄水春溪上，溪寒晚日红。\n舟行明鉴里，鸟度醉吟中。\n远岫千重耸，轻艘万派通。\n桃源在何处，笑语隔幽丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16028,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"解舟 其一","author":"释绍嵩","text":"落日放船好，波恬尔许平。\n水光浮棹碧，山意入诗清。\n世路方行险，江人莫问程。\n顺流风更顺，飒飒片帆轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16029,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"解舟 其二","author":"释绍嵩","text":"落日放船好，长河水接天。\n远林翻急吹，孤棹正悠然。\n风搅平云阵，波轻片雪连。\n前村鸦噪断，极目仰联翩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16030,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"遣怀 其二","author":"释绍嵩","text":"落拓无生计，放怀便所便。\n托心时散帙，即事偶成篇。\n此道欣逢泰，平生祗信缘。\n慇勤伴幽独，松亚小窗前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16031,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"遣怀 其四","author":"释绍嵩","text":"淹泊宁吾愿，年光送老来。\n只知闲说话，但觉旅怀开。\n此路方知己，唯天合是媒。\n冥搜无好语，也辱片云催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16032,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其六","author":"李兑","text":"何处不迟留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16033,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"遣怀","author":"释绍嵩","text":"巡礼诸方遍，无心问世缘。\n东西南北路，一十二三年。\n夜色临城月，猿声隔树烟。\n坐来幽兴在，对景觅诗联。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16034,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"遣怀 其一","author":"释绍嵩","text":"抱瘵便秋晚，无言祗自知。\n是身多落寞，半世足飘离。\n静阅王维画，闲围李远棋。\n慨然叹时命，转觉命堪疑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16035,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬胡圣闻","author":"释绍嵩","text":"别后沧波路几迷，竹风松雨共凄凄。\n十年依旧双瞳碧，四海仍传一角犀。\n池上溶溶浮日暖，山中物物是诗题。\n先生莫道心如铁，可忍红英半著泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16036,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬敬上人","author":"释绍嵩","text":"浙界残零处，相寻聊解颜。\n别桥连白石，移榻对青山。\n有恨春将晚，无机性自闲。\n天涯将野眼，时见一舟还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16037,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬颜圣闻监税","author":"释绍嵩","text":"地僻春来静，孤山夕照馀。\n深惭长者辙，新欠故人书。\n有酒招元亮，无人诵子虚。\n相从又相别，意绪各何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16038,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬颜仲华","author":"释绍嵩","text":"客子愁无柰，年来鬓已秋。\n尘埃自衮衮，勋业转悠悠。\n岛雾沉晴树，山鸡舞画楼。\n惠连有新作，一览病应休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16039,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其四","author":"李兑","text":"万壑初收雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16040,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鄮山道中答印上人游乳窦","author":"释绍嵩","text":"鸦啼古木乱云深，地带河声足水禽。\n檐雨滴秋残旅梦，夜堂疏磬发禅心。\n五年乳窦峰前路，十里尘媒溪上林。\n满目云山俱是乐，故人携客作幽寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16041,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"横翠亭书怀","author":"释绍嵩","text":"小葺茅茨紫翠间，门当宫道不曾关。\n剪裁风月聊堪醉，奔走尘寰出老颜。\n半局残棋消白昼，十年归梦满青山。\n江城今可徘徊处，莫怪频频此往还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16042,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题印上人关外山水图","author":"释绍嵩","text":"一源淳朴鄮山川，一簇人家起暮烟。\n世乱不妨松偃蹇，客程依旧水潺湲。\n云横新塞遮秦甸，树荫澄江入野船。\n闻说函殽犹险在，为师怀想几凄然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16043,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题白莲园亭","author":"释绍嵩","text":"塔影挂清汉，分明雨后山。\n云寒湖贴贴，钱样菊斑斑。\n有水园林活，无风溪树闲。\n临流兴不尽，复自竹中还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16044,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题刘唐臣新葺池亭","author":"释绍嵩","text":"刘郎潇洒水为居，水碧山青画不如。\n绿竹可供公子钓，紫鳞时掣季膺鱼。\n幽寻胜事鸟窥牖，闲卧临窗燕拂书。\n触目韶华总诗本，放怀端与世情疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16045,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题园庵","author":"释绍嵩","text":"地僻无宾侣，林疏露短篱。\n紫鳞冲晚浪，白鸟占闲池。\n柳色浓垂岸，桃花湿满枝。\n一僧年八十，邀我觅新诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16046,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题净众壶隐","author":"释绍嵩","text":"古院无僧住，含情更惘然。\n绿苔欺破阁，白鸟没飞烟。\n壶隐迟迟日，筒分细细泉。\n栏干聊小凭，取次缀诗篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16047,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题海智寺壁","author":"释绍嵩","text":"步步入山门，门前众水分。\n上潮吞海日，古庙聚寒云。\n树影中流见，秋涛隔岭闻。\n还应觅新句，不琢自成文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16048,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题德夫刘公江亭","author":"释绍嵩","text":"兄弟将知大自强，南山雾里晦文章。\n睡轻可忍风敲竹，语妙何妨石作肠。\n碧瓦朱甍占肃爽，紫兰红药共凄凉。\n渔舟去后天将夕，月入波心碎夜光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16049,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"憩江寺","author":"释绍嵩","text":"众岫耸寒色，长溪抱碧岑。\n波倾三峡急，树合四时阴。\n野寺江天豁，禅房花木深。\n幽帘宜永日，闲坐听春禽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16050,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"憩江亭","author":"释绍嵩","text":"花露湿晴春，坐无车马尘。\n江流青草岸，波闪白龙鳞。\n往事如今日，知心似古人。\n慇勤听渔唱，闲趣自相亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16051,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"憩灵隐写怀","author":"释绍嵩","text":"莫恨征途远，题诗记独游。\n十年行路饱，万里此生浮。\n宇宙知何极，山川慰久留。\n倚栏哦五字，不觉散人愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16052,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"憩颜子予海山别业","author":"释绍嵩","text":"群峰当户晓岚晴，杨柳风和日听莺。\n郭外春山明锦绣，门前弱水即蓬瀛。\n期登野阁闲应甚，来惯幽禽近不惊。\n独凭栏干意难写，绿桑疏处哺牛鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16053,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠刘信之","author":"释绍嵩","text":"四海刘居士，诗书论议深。\n苦吟天与性，醉卧月空沉。\n囊有壶公药，身无戚里心。\n高怀不我弃，他日重来寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16054,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠何知录","author":"释绍嵩","text":"青云直上路初通，白凤新词入圣聪。\n抵掌剧谈吾浪语，连城增价子何穷。\n共登小阁春风里，又解征帆落照中。\n此去优游益吟咏，公馀无惜寄诗筒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16055,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠别张西叔之丰城","author":"释绍嵩","text":"有客功名累，萧萧逐转蓬。\n丰城千里外，茅屋万山中。\n杨柳萦桥绿，秋梨绕地红。\n登临虽未并，谈笑会当同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16056,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠别性老","author":"释绍嵩","text":"此老殊清健，情忘发兴奇。\n异方惊会面，孤屿共题诗。\n聚散千江月，参差万里期。\n相看作离别，特地泪双垂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16057,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠别法仪","author":"释绍嵩","text":"四海欲行遍，心猿日渐驯。\n贫高一生行，衣故十年尘。\n如我如君者，无名无利身。\n慇勤讶此别，忍泪已沾巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16058,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠别显上人","author":"释绍嵩","text":"两浙寻山遍，依俙三十秋。\n征尘添老色，藜杖赋归休。\n落叶随杯渡，残虹带夕收。\n不知从此去，能寄短书不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16059,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠张炳","author":"释绍嵩","text":"怪服先生众骇闻，卖刀买犊便耕耘。\n棋功过却杨玄宝，赋咏思齐郑广文。\n直为篇章非动众，忽携书剑远辞群。\n行行快趁风烟阔，得句不妨时策勋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16060,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠李先辈","author":"释绍嵩","text":"饥食松花渴饮泉，寂寥芳草茂芊芊。\n岩边石室低临水，窟里阴云不上天。\n难与英雄论教化，等将身世付罤■。\n无由住得吟相伴，目送归鸿篱下眠。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16061,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠郎德父","author":"释绍嵩","text":"衣弊履穿不讳穷，篱门和竹夹西东。\n闲栖已合称高士，发兴真成继庾公。\n人世鹤归双鬓上，丹霄路在五言中。\n却须袖取经纶手，深入芦花作钓翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16062,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠闻人必大 其一","author":"释绍嵩","text":"未遂青云一挂科，科名成后竟如何。\n贫疑陋巷春偏少，学办痴龙艺最多。\n剩把文章鸣圣代，却思猿鸟共烟萝。\n高吟大醉三千首，他日阳春白雪歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16063,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠闻人必大 其二","author":"释绍嵩","text":"长日林皋独醉吟，久贫如得顾家金。\n属文想见翻新样，执卷犹闻惜寸阴。\n世上纷纷蛮与触，胸中历历古兼今。\n有时出纵风烟步，多谢携筇数访寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16064,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示德圆","author":"释绍嵩","text":"莫因居此与名疏，未可唐捐肘后书。\n昼短夜长须强学，青春不再汝知乎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16065,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"列岫亭书事","author":"释绍嵩","text":"极浦遥山合翠微，周回秀色自清机。\n长江淡淡吞天去，白鸟翩翩接翅飞。\n屐齿苔痕犹故迹，露沙霜树映斜晖。\n牧童何处吹羌笛，嚇得巢禽不敢归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16066,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同周湛二上人游西湖之北山天竺晚归得十绝 其八","author":"释绍嵩","text":"天竺横分景色宽，园林初日破朝寒。\n兴阑欲下山腰去，野径萦回路百盘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16067,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵朱国器秋夜之什","author":"释绍嵩","text":"二水奔奔鸣屋除，山川澄净九秋馀。\n故人相见自青眼，病叟中间已白须。\n风射破窗灯易灭，鹤归乔木月难呼。\n政须送与王摩诘，画我凭栏觅句图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16068,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵杨判院晚春","author":"释绍嵩","text":"杏褪残花点碧轻，残花含恨脱红英。\n树连翠筱围春昼，风入青山送雨声。\n不办扁舟访安道，何妨莲社醉渊明。\n如公自是銮坡具，盍与吾君致太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16069,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江上偶谒什上人","author":"释绍嵩","text":"在路日已久，此心谁与论。\n一言知具眼，万里独消魂。\n辍棹丹枫浦，扶筇白水村。\n纵情犹未已，吟扣野僧门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16070,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"泛湖","author":"释绍嵩","text":"久客欣无事，扶衰上野航。\n回云覆阴谷，初日放晨光。\n杨柳千寻色，荷花一路香。\n西湖天下胜，谁与共平章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16071,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏梅五十首呈史尚书 其十三","author":"释绍嵩","text":"小寺鸦鸣日午时，无人同趣独支颐。\n慇勤为注铜瓶水，只篸横斜一两枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16072,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏道中所见","author":"释绍嵩","text":"倚杖寒山暮，高杉韵细飔。\n归舟藏别浦，落日映荒陂。\n碧涧流红叶，黄猿领白儿。\n石桥南畔路，岑渚复幽奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16073,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"郊行 其二","author":"释绍嵩","text":"花落江堤簇晓烟，游人柳外蹙鞦韆。\n直须分付丹青手，画出清明二月天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16074,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"客中戏书 其二","author":"释绍嵩","text":"远笛招幽响，无人竹扫墀。\n马嘶游寺客，鸦护落巢儿。\n日转槐阴暮，天高秋气悲。\n还应重风景，时作一篇诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16075,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贺黄少府受辟 其二","author":"释绍嵩","text":"风流文采旧家声，玉麈高谈四座倾。\n他日亲知问官况，三年民戴尉曹清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16076,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"通判曾温伯生日 其二","author":"释绍嵩","text":"今代文章伯，长哦气吐虹。\n挥犀闻妙论，许国见深衷。\n美价方稀古，离骚继雅风。\n慇勤一双眼，看到火城红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16077,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偶成","author":"释绍嵩","text":"谁复知予懒是真，平生自信解甘贫。\n苦无名位高今世，为有烟霞伴此身。\n长掩柴荆避寒暑，犹将谈笑对风尘。\n只今那得王摩诘，状取江湖太古民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16078,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游西湖","author":"释绍嵩","text":"西湖招提三百六，佳处如春有眉目。\n一番雨过吞青空，万顷无波鸭头绿。\n望湖楼阁独自登，烟霏向背攒寒玉。\n想见襄阳孟浩然，此中有句不容续。\n道人长坐西山河，骨清气明韵出俗。\n久居京阙厌尘土，一夕归心俊如鹄。\n明窗为君研破砚，落笔转头风雨速。\n龙山深处如定居，就彼结邻容我卜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16079,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"道中闻百舌","author":"释绍嵩","text":"一径寻村渡碧溪，山花红紫树高低。\n如今天下无鸣凤，说与春乌自在啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16080,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬王主簿示道中所作","author":"释绍嵩","text":"蓼花红淡苇条黄，洛岸秋晴夕照长。\n雪羽䙰褷立倒影，酒旗摇曳出疏篁。\n云边雁断湖边月，圩上人牵水上航。\n输与能诗王主簿，每行吟得好篇章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16081,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题山寺","author":"释绍嵩","text":"江上山头寺，阴阶竹扫苔。\n舟横渔唱晚，松暮鹤飞回。\n野渡花争发，春荷叶半开。\n嬉游不可极，留眼要重来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16082,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]