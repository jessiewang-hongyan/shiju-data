[{"title":"书情奉寄蒋弋阳公 其二","author":"张良臣","text":"颓年去堂堂，白发新种种。\n崎岖造化久，败屦常决踵。\n从来万里意，不料乘崄恐。\n鸣鹤略九皋，未羡乘轩宠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53850,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"芳草复芳草","author":"张良臣","text":"芳草复芳草，有人孤倚楼。\n明月复明月，何处照离洲。\n相见渺无期，此恨讵相知。\n日暮天寒吹属玉，蛮江豆蔻重重绿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53851,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓行","author":"张良臣","text":"千山万山星斗落，一声两声钟磬清。\n路入小桥和梦过，豆花深处草虫鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53852,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清修岭","author":"张良臣","text":"丧胆岩上人，怖死岩下人。\n周道自砥直，何枉不问津。\n人生贵适意，毋容矫吾真。\n渊明兀馀年，漉酒乃一巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53853,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"失调名","author":"张良臣","text":"昨日豆花篱下过，忽然迎面好风吹。\n独自立多时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53854,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西江月","author":"张良臣","text":"四壁空围恨玉，十香浅捻啼绡。\n殷云度雨井桐凋。\n雁雁无书又到。\n别后钗分燕股，病馀镜减鸾腰。\n蛮江豆蔻影连梢。\n不道参横易晓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53855,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"采桑子","author":"张良臣","text":"佳人满劝金蕉叶，夜玉春温。\n别后黄昏。\n燕子楼高月一痕。\n年年依旧梨花雨，粉泪空存。\n流水孤村。\n不著寒鸦也断魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53856,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其七","author":"张良臣","text":"空掩玉楼先睡去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53857,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其九","author":"张良臣","text":"先到王城第一桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53858,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其五","author":"张良臣","text":"秦南燕北见君难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53859,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"张良臣","text":"愿同丑万辈，终老孟子门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53860,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其十","author":"张良臣","text":"长干白下相逢少。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53861,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其十一","author":"张良臣","text":"客子摇船绕画图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53862,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"张良臣","text":"客向愁中都老尽，祇留平楚伴销凝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53863,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其四","author":"张良臣","text":"老去青林又一霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53864,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其八","author":"张良臣","text":"肠断江南一百五。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53865,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其三","author":"张良臣","text":"流落荒郊道转孤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53866,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其六","author":"张良臣","text":"指似凤城烟月路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53867,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"张谷山","text":"可惜荼蘼都过了，近来犹自有蔷薇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53868,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"张进彦","text":"缚虎敢辞山路险，斩鲸终见海波澄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53869,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"澹山岩","author":"张远猷","text":"岩窦天下奇，黄诗天下稀。\n洞明无所隐，石势争欲飞。\n雷鼓今犹在，澹仙何未归。\n磨崖文断灭，苔藓却成衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53870,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送邓城令王该致仕","author":"张邵","text":"碌碌红尘三十年，一官今喜赋归田。\n此行正值鲈鱼美，好向鄞江买剑船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53871,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"张邵","text":"苏毡久绝寝衣想，姜被忽分挟纩春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53872,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"月上海棠","author":"张侃","text":"南枝消息凭谁送。\n北枝寒、清晓破馀冻。\n横溪浸疏影，月黄昏、暗香浮动。\n真仙种。\n不与梨花同梦。\n洛阳姚魏争先贡。\n妒纷纷、红紫眩新宠。\n尽雪压风欺，□和羹、此时须用。\n烦珍重。\n莫作桓伊三弄。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53873,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秦楼月/忆秦娥","author":"张侃","text":"冰肌削。\n水沈香透胭脂萼。\n胭脂萼。\n怕愁贪睡，等闲梳掠。\n花前莫惜添杯酌。\n五更嫌怕春风恶。\n春风恶。\n东君不管，此情谁托。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53874,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"感皇恩 元夕后二日，同彦敬郎中饮洪宣慰山园红梅下，得感皇恩二阕 其一","author":"张侃","text":"佳处记曾游，十年重到。\n罨画湖山最春早。\n红梅几树，一夜东风开了。\n矮松修竹外、依然好。\n玉色醺酣，香团娇小。\n消得金尊共倾倒。\n满怀风味，前度何郎今老。\n徘徊疏影里、花应笑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53875,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"感皇恩 其二","author":"张侃","text":"换骨有丹砂，阿谁传与。\n爱惜芳心不轻吐。\n客来烂熳，解得此情良苦。\n有时三两点、胭脂雨。\n旧说江南，红罗亭下，未必春光便如许。\n认桃辨杏，最是渠家低处。\n问花曾怨不、娇无语。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53876,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与进士宋严话别","author":"张咏","text":"人之相知须知心，心通道气情转深。\n凌山跨陆不道远，蹑屩佩剑来相寻。\n感君见我开口笑，把臂要我谈王道。\n几度微言似惬心，投杯着地推案叫。\n此事置之无复言，且须举乐催金船。\n人生通塞未可保，莫将闲事萦心田。\n兴尽忽告去，挑灯夜如何。\n弹琴起双舞，拍手聊长歌。\n我辈本无流俗态，不教离恨上眉多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53877,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"方竹 其一","author":"张咏","text":"笋从初箨已方坚，峻节凌霜更可怜。\n为报世间邪佞者，如何不似竹枝贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53878,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"方竹 其二","author":"张咏","text":"枝枝方直绿参参，林叶疏红始见心。\n却恐当时恶圆佞，结根遥向楚云深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53879,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"发冷水铺","author":"张咏","text":"冷水东南去路赊，水边山掩见人家。\n无端下马寻幽处，鸥鹭飞飞出荻花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53880,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再任益州回留题剑门石壁","author":"张咏","text":"剑门山势碧摩天，匹马重来鬓已斑。\n多赖皇明烛幽远，两川无事得生还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53881,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吊屈原","author":"张咏","text":"楚王不识圣人风，纵有英贤志少通。\n可惜灵均好才术，一身空死乱离中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53882,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同韦主簿祈雨","author":"张咏","text":"栖鸾声誉喧群口，掷地辞华众莫俦。\n此日舆君同祷处，万家瞻仰雨盈畴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53883,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"早发鄂渚","author":"张咏","text":"五里亭东晓色分，数峰连络倚青云。\n回头却愧公车役，孤负沧洲野鹤群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53884,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟行","author":"张咏","text":"江边烟草湿烟江，沙白频翘鹭一双。\n风细不知吟爱甚，雨中时起闭船窗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53885,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过华山怀白云陈先生","author":"张咏","text":"性愚不肯林泉住，强要清流拟致君。\n今日星驰剑南去，回头惭愧华山云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53886,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过武陵溪二首 其二","author":"张咏","text":"武陵山下水冲溶，往事追寻兴莫穷。\n欲就渔人问闲趣，叶舟齐过蓼湾东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53887,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过武陵溪二首 其一","author":"张咏","text":"生平苦爱山兼水，南国晴凝尽可携。\n即问世间谁见我，扁舟初下武陵溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53888,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"县斋感怀二首 其二","author":"张咏","text":"傍人休爱命皇华，即问何能报国家。\n长忆乡园旧庐舍，会须抛印自锄瓜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53889,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"县斋感怀二首 其一","author":"张咏","text":"前朝官政似无端，彭泽先生百日还。\n堪愧崇阳九河客，明时不敢自归山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53890,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和人牡丹","author":"张咏","text":"桃源分散恨无期，忽意江城见有时。\n歌绕醉围抛不得，几人终夜起题诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53891,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜坐","author":"张咏","text":"流水涓涓落砌莎，竹窗残月冷无多。\n傍人不念思乡苦，独奏南楼一曲歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53892,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杭州一百五日水心亭留题","author":"张咏","text":"湖边三月百花红，湖上游人处处通。\n莫怪此渠来便去，都缘心地似虚空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53893,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"苦热","author":"张咏","text":"赫日炎炎烁远空，泉边树底亦无风。\n行人莫便多辞苦，犹胜东郊炙背翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53894,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨夜 其二","author":"张咏","text":"帘幕萧萧竹院深，客怀孤寂伴灯吟。\n无端一夜空阶雨，滴破思乡万里心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53895,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"峡路阻风","author":"张咏","text":"嵩云草草失前期，佐主无才鬓有丝。\n牢落江滩阻风夜，峡猿声里坐多时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53896,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"柳枝词七首 其七","author":"张咏","text":"吴王爱重为游从，岁岁添栽后苑中。\n家国旋亡台榭毁，数株临水尚牵风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53897,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"柳枝词七首 其六","author":"张咏","text":"帐偃缨垂已有名，水边花外更分明。\n前贤可得轻词句，几变新声入郑声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53898,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"柳枝词七首 其五","author":"张咏","text":"海潮声里越溪头，谁种千株夹乱流。\n安得辞荣同范蠡，绿丝和雨系扁舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53899,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"柳枝词七首 其四","author":"张咏","text":"轻盈恰与地相宜，才种纤枝又引枝。\n不及垂阴向黎庶，春风一路送亡隋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53900,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"柳枝词七首 其三","author":"张咏","text":"远映天街近绕池，长条无力自相依。\n上阳宫女愁方绝，又是东风有絮飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53901,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"柳枝词七首 其二","author":"张咏","text":"青连远戍和烟重，静映疏栊窣缕轻。\n游子不归春梦断，南轩一树有啼莺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53902,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"柳枝词七首 其一","author":"张咏","text":"玉门关外絮飞空，破虏营前昼影浓。\n可便消兵无好术，忍教攀折怨春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53903,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"洛中","author":"张咏","text":"翠辇西巡未有期，玉楼烟锁凤参差。\n可怜三月花如锦，狂杀满城年少儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53904,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"相州官舍","author":"张咏","text":"林木千重闭郡楼，西山浓翠去无由。\n思量自古逃名者，多少清闲到白头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53905,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋日登美美亭","author":"张咏","text":"野人官职与心违，何况经年未得归。\n一夕秋风无限思，偶来凭槛到斜晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53906,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赴职荆湖途中作","author":"张咏","text":"阙下过从礼数频，到官忧事更劳神。\n每逢山驿连宵住，似待孤云悯此身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53907,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送别王秘丞","author":"张咏","text":"帝乡三十年前别，江外相逢鬓已衰。\n清论未穷行计速，为君临水立多时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53908,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送别李司直","author":"张咏","text":"亭下依微见远村，亭中离恨若为论。\n数声歌罢扬帆去，民吏相看有泪痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53909,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送魏道士","author":"张咏","text":"江上萧萧木叶飞，天台狂客杖藜归。\n莫嫌俗吏勤相顾，曾是嵩阳旧掩扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53910,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闻鹧鸪","author":"张咏","text":"画中曾见曲中闻，不是伤情即断魂。\n北客南来心未稳，数声相应过前村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53911,"sha256":"18413bf7