[{"title":"满庭芳 其六 寿妻","author":"曹彦约","text":"老子今年，年登七十，阿婆年亦相当。\n几年辛苦，今日小风光。\n遇好景，何妨笑饮，依前是、未放心肠。\n人都道，明明了了，强似个儿郎。\n幸偿。\n婚嫁了，双雏蓝袖，拜舞称觞。\n女随夫上任，孙渐成行。\n惭愧十分圆满，无以报、办取炉香。\n频频祝，百年相守，老子更清强。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66528,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过林和靖旧址","author":"曹既明","text":"短棹不归双鹤去，一邱烟草寄山阴。\n水边疏影黄昏月，无限风骚在客心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66529,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冷泉亭","author":"曹既明","text":"朱檐日转轩窗冷，碧嶂云低草树香。\n山影倒沈波底月，夜阑相对写寒光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66530,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜宿浙江亭","author":"曹既明","text":"夜半潮声撼客床，卧听柔橹闹空江。\n惊回倦枕乡关梦，海日烘山上晓窗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66531,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"胥山庙 其三","author":"曹既明","text":"堂堂武烈与文英，引剑呼天气未平。\n身后端知司祸福，生前直欲就功名。\n胥山未尽吴侬意，郢水犹伤楚客情。\n井里满前灵宇壮，长江千古带高情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66532,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"胥山庙 其一","author":"曹既明","text":"贯弓执矢一亡臣，未洗昭关客路尘。\n道上乞飧逢漂女，江边款渡得渔人。\n致君岂谓初无术，卖国由来别有因。\n文种墓空山胁冷，怒潮朝夕怨江滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66533,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"胥山庙 其二","author":"曹既明","text":"间关欲雪父兄雠，底用平生锡盖侯。\n冤骨未沈吴月晓，征魂初返楚云秋。\n西施正倚承恩貌，范蠡将移去国舟。\n尚向松陵亲却敌，藁砧依旧在层楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66534,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与同舍待浴灵芝寺","author":"曹既明","text":"一雨洗秋色，湖山增眼明。\n番番水中荷，作此凄凉声。\n我辈等憔悴，客饭千里程。\n愿言涤尘土，冠盖临华京。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66535,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"有怀湖山留题惠因院","author":"曹既明","text":"湖山平生亲，松竹亦瓜葛。\n深期说情话，跬步成契阔。\n岂无朝夕思，或以尘累夺。\n何当淡相从，长年席不割。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66536,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"壬寅七月二十二日予因过东□少休寿圣时秋阳炎亢大□可忧遂题是绝以谒灵岩如有其灵一霈膏泽以惠斯民","author":"曹省","text":"英灵何事卧云深，一举曾空万里阴。\n阡陌相望苗就槁，苍生应待作商霖。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66537,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"溪上赏芙蓉","author":"曹绛","text":"娇红腻绿暖生春，步绕清溪锦帐新。\n花意不须羞白发，五朝得见太平人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66538,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贫女","author":"曹衍","text":"自恨无媒出嫁迟，老来方始遇佳期。\n满头白发为新妇，笑杀豪家年少儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66539,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹭鸶","author":"曹衍","text":"波澜静处立身孤，氄雪攒霜腹转虚。\n尽日滩头延颈望，能销大海几多鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66540,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"午窗","author":"曹?","text":"午窗破梦角巾斜，自涤铜铛煮茗芽。\n满院绿苔春色静，冥冥细雨落桐花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66541,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水阳精舍","author":"曹?","text":"塔高铃自语，碑断苏成文。\n老树擎凉月，初荷卷湿云。\n萤飞临水见，犬吠隔篱闻。\n静对高僧坐，无眠到夜分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66542,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"灯市","author":"曹?","text":"春满天街夜色酣，绮罗香结雾漫漫。\n试灯帘幕深藏暖，扫雪楼台浅带寒。\n宝骑骄嘶金騕袅，翠翘醉倚玉阑干。\n江云忽断笙歌散，几点妆梅落舞鸾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66543,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南徐怀古呈吴履斋","author":"曹?","text":"匹马来逢塞草秋，淮云一片隔神州。\n黄昏灯火西津渡，白昼风烟北固楼。\n犹有断碑和晋宋，谁将遗石问孙刘。\n天荒地老英雄尽，落日长江万古愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66544,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄豫章诗社诸君子","author":"曹?","text":"向来心事剑能知，曾结仙人汗漫期。\n南浦看花春载酒，西园刻烛夜吟诗。\n凄凉风月随残梦，零落江湖似断棋。\n千里洪崖秋水隔，暮云无处说相思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66545,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"憩凉月观焦山在望","author":"曹?","text":"凉寻小径坐，心与大江闲。\n素月镜秋水，碧云巾暮山。\n残蝉移别树，吠犬出幽关。\n近对焦仙洞，飞霞不可攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66546,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"兰陵王 雨中登龟溪乾元寺阁赋","author":"曹原","text":"杏花坼。\n烟柳藏鸦翠陌。\n苏堤上、人正踏青，嫩草茸茸衬罗袜。\n游丝挂晴塔。\n十里酣红艳白。\n秋千外，娇靥笑春，一片笙箫绮霞碧。\n阿香妒倾国。\n把镜日深奁，丝雨愁织。\n崇桃积李无颜色。\n但蝶粉香渍，燕泥芹冷，紫钱芳晕翳宝瑟。\n怅还近寒食。\n岑寂。\n恨无极。\n更酒驿孤烟，棋院长日。\n梨花满地春狼藉。\n望凤阙波渺，燕楼云隔。\n凭阑干晚，吟袖湿，但笑拍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66547,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"齐天乐 和翁时可悼故姬","author":"曹原","text":"翠箫声断青鸾翼，心期破钗谁表。\n夜烛银屏，春风粉袖，犹记琵琶斜抱。\n瑶池路杳。\n恨巫女回云，月娥沉照。\n谩说蓬莱，玉环花貌梦难到。\n岩花亭院乍冷，更蛩吟风碎，鸿飞烟渺。\n绿玉弹棋，红牙按拍，乐事欢情终少。\n刘郎未老。\n要鬓翼堆玄，腕酥凝皓。\n莫忘香荐，绿罗裙带草。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66548,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玲珑四犯 被召赋荼","author":"曹原","text":"一架幽芳，自过了梅花，独占清绝。\n露叶檀心，香满万条晴雪。\n肌素净洗铅华，似弄玉、乍离瑶阙。\n看翠蛟、白凤飞舞，不管暮烟啼鴂。\n酒中风格天然别。\n记唐宫、赐樽芳冽。\n玉蕤唤得馀春住，犹醉迷飞蝶。\n天气乍雨乍晴，长是伴、牡丹时节。\n夜散琼楼宴，金铺深掩，一庭香月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66549,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宴山亭/燕山亭 被召赋玉绣球","author":"曹原","text":"香月玲珑，柔风镂刻，嫩绿枝头圆腻。\n绯桃院宇，絮柳池塘，独立万红尘外。\n戏舞千团，讶粉羽、留连春媚。\n非是。\n看滚雪抛琼，镜鸾相倚。\n唐昌仙观风流，有霞洞藏花，绀环玉蕊。\n雕阑占赏，禁苑承恩，难比太平瑶卉。\n遍插金瓶，更移近、宝猊烟翠。\n堪爱。\n只少个、鸳鸯绣带。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66550,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"惜馀妍 被如赋二色木香","author":"曹原","text":"同根异色，看镂玉雕檀，芳艳如簇。\n秀叶玲珑，嫩条下垂修绿。\n禁华深锁清妍，香满架、风梳露浴。\n轻盈，便似觉、酴醾格调粗俗。\n蜂黄间涂蝶粉，疑旧日二乔，各样妆束。\n费却春工，斗合靓芳浓馥。\n翠华临槛清赏，飞凤斝、休辞醉玉。\n晴昼，镇贮春、瑶台金屋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66551,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"瑞鹤仙","author":"曹原","text":"炉烟销篆碧。\n对院落秋千，昼永人寂。\n浓春透花骨。\n正长红小白，晕香涂色。\n铜驼巷陌。\n想游丝、飞絮无力。\n念绣窗、深锁红鸾，虚度禁烟寒食。\n空忆。\n象床沉水，凤枕屏山，殢欢尤惜。\n粉香狼藉。\n海棠下、东风急。\n自秦台箫咽，汉皋佩冷，断雨零云难觅。\n但杏梁、双燕归来，似曾旧识。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66552,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜迁莺 其一 冬寿太守","author":"曹宰","text":"岁华将近。\n得昨夜一枝，江南佳信。\n建水城中，武夷峰上，恰属老人星分。\n间世挺生贤哲，贾马文章清俊。\n推太守，想区区百里，难淹良骏。\n舆论怀报也，暂把玉山，寄与丹青晕。\n寿旦方临，祠堂其立，底事古今谁胜。\n自有养生妙诀，赢得朱颜芳鬓。\n犹更好，佩金鱼宝带，凌烟优选。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66553,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜迁莺 其二","author":"曹宰","text":"皇都春早，正媚景霁色，融和时候。\n宿霭初收，祥烟新布，桃李满林惟绣。\n挺生垩朝哲辅，风采独居人右。\n世希有，看陈思名族，平阳革裔。\n眷厚知已久，近辅名藩，符竹频分剖。\n一节趋朝，神京作镇，高掩昔年贤守。\n芝检异恩才下，玉笋清班须簉。\n寿龄远，与湖山同永，松椿同寿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66554,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜迁莺 其三","author":"曹宰","text":"梅含春信，冒北律严寒，南枝先暖。\n月上初弦，萱开九叶，嵩岳诞生英俊。\n冰玉丰姿莹彻，锦绣文章焕烂。\n人歌赞，是今朝卓鲁，他年伊旦。\n犹羡瓜期近，课春九重，优陟公卿选。\n列鼎鸣钟，乘轩袭冕。\n直把功名占断。\n好是宾僚会宴，争捧觥觞频劝。\n重重愿，与青青松柏，岁寒难变。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66555,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"漫成","author":"曹逢时","text":"学书须学颜真卿，作诗须作陶渊明。\n其它泚笔本骫骳，便有风骨非天成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66556,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"曹逢时","text":"撩我思家第一篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66557,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登九华山","author":"曹清","text":"浮生江路水茫茫，彭泽原非令故乡。\n为访子明寻玉涧，也因太白宿云房。\n诗摩古壁搜遗韵，井炼丹砂辨旧方。\n从此欲归情复结，拟移亭舍筑山傍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66558,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题忠悯公送婿邢得昭归婺女诗后","author":"曹稆孙","text":"路八千来婿亦艰，相看冰玉问平安。\n剪灯夜话思全蜀，五十四没天上宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66559,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贺新郎 题江心","author":"曹稆孙","text":"极目天如画。\n水花中、涌出莲宫，翠楹碧瓦。\n胜景中川金焦似，勒石□□□□。\n尚隔浦、风烟不跨。\n妖蜃自降真歇手，涨平沙、妙补乾坤罅。\n双寺合，万僧夏。\n东西塔影龙分挂。\n夜无云、点点一天，星斗相射。\n七十二滩声到海，括橹瓯帆上下。\n泣不为、琵琶声哑。\n故寝荒凉成一梦，问来鸥、去鹭无知者。\n烟树湿，怒涛打。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66560,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"曹公泉","author":"曹绩","text":"度岭汗如濯，渴尘生客心。\n清泉随念应，乞与涤烦襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66561,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"洗心堂","author":"曹翊","text":"清光秀发水云乡，不见骚人意未降。\n风压柳梢低酒舍，月移松影上僧窗。\n山泉涨起潮三尺，野老钓归鱼一双。\n更待练光斜趁日，坐看金斗熨秋江。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66562,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"松风亭","author":"曹翊","text":"亭前山影漾江流，亭外云霞碍举头。\n俯石下听松上籁，隔乡遥认水边舟。\n四檐寒送沙汀雨，一径烟笼寺竹秋。\n此曲此声应未变，抱琴期与故人游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66563,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自嘲落牙","author":"曹琰","text":"昨朝饭里有粗砂，隐落翁翁一个牙。\n为报妻儿莫惆怅，见存足以养浑家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66564,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题谢先生白云庵","author":"曹道冲","text":"桃源洞口武陵人，跳出红尘二十春。\n但喜白云深有趣，不知青眼近来亲。\n丹砂已向坤炉伏，玉汞先从坎鼎烹。\n活计一张焦尾外，碧坛三尺礼星辰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66565,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"献曹南院","author":"曹玮幕客","text":"贤守新成盖代功，临危方始见英雄。\n三都谷路全师入，十万胡尘一战空。\n杀气尚疑横塞外，捷音相继遍寰中。\n君王看降如纶命，旌节前驱马首红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66566,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"曹筠","text":"浩浩秦淮千万顷，好将馀浪到滩头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66567,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"长乐台","author":"曹颖叔","text":"蓝挼水谷与秋辉，疑作危棱磴翠微。\n向晚山僧苦留我，层层寒牖乱云归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66568,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"周侯德政谣","author":"曹粹中","text":"侯育我兮明淳，民感侯兮慈仁。\n筑河碶兮水粼粼，开池井兮水沄沄。\n我农耕兮河之漘，我农耘兮泉之濆。\n土田膏兮稻如云，岁功成兮德泽均。\n以食以餐兮，子孙诜诜。\n歌侯之勋兮，颂侯之勤。\n颂之勤兮，歌侯之勋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66569,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"内宴奉诏作","author":"曹翰","text":"三十年前学六韬，英名常得预时髦。\n曾因国难披金甲，不为家贫卖宝刀。\n臂健尚嫌弓力软，眼明犹识阵云高。\n庭前昨夜秋风起，羞睹盘花旧战袍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66570,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠缘德","author":"曹翰","text":"二十年来访道人，奔波寒暑备艰辛。\n谁知此日圆通会，便是今生出世因。\n炉里有丹欣得遇，法中无语幸相亲。\n如何至诀容传受，免向迷途强问津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66571,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上竿诗","author":"曹豳","text":"又被锣声送上竿，者番难似旧时难。\n劝君著脚须教稳，多少旁人冷眼看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66572,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"凤凰山","author":"曹豳","text":"凤去寥寥今几年，至今人唤凤凰山。\n只愁有凤无人识，却指凡禽误世间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66573,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杨柳","author":"曹豳","text":"春至风花各自荣，就中杨柳最多情。\n自从初学宫腰舞，直至飘绵不老成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66574,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春暮","author":"曹豳","text":"门外无人问落花，绿阴冉冉遍天涯。\n林莺啼到无声处，春草池边独听蛙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66575,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题括苍冯公岭二首 其二","author":"曹豳","text":"村南村北梧桐树，山后山前白菜花。\n莫向杜鹃啼处宿，楚乡寒食客思家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66576,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题括苍冯公岭二首 其一","author":"曹豳","text":"平芜千里绿迢迢，水宿山行好耐劳。\n最是愁人最奇崛，冯公之巘浙江潮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66577,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和徐清叟题会江驿","author":"曹豳","text":"未到桐江上，先寻旧隐栖。\n水光明月夜，山影夕阳西。\n道在行藏逸，身轻得丧齐。\n更从高处看，转觉路非迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66578,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元苏二公祠","author":"曹豳","text":"两公千载士，出处不须齐。\n好事赵明府，合祠元瀼溪。\n清芬兰馥馥，往事草萋萋。\n新额人瞻仰，知君手自题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66579,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"红窗迥","author":"曹豳","text":"春闱期近也，望帝乡迢迢，犹在天际。\n懊恨这一双脚底。\n一日厮赶上五六十里。\n争气。\n扶持我去，转得官归，恁时赏你。\n穿对朝靴，安排你在轿儿里。\n更选个、宫样鞋，夜间伴你。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66580,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西河 和王潜斋韵","author":"曹豳","text":"今日事。\n何人弄得如此。\n漫漫白骨蔽川原，恨何日已。\n关河万里寂无烟，月明空照芦苇。\n谩哀痛，无及矣。\n无情莫问江水。\n西风落日惨新亭，几人坠泪。\n战和何者是良筹，扶危但看天意。\n只今寂寞薮泽里。\n岂无人、高卧闾里。\n试问安危谁寄。\n定相将、有诏催公起。\n须信前书言犹未。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66581,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水调歌头 寿隐者十一月初七","author":"梁大年","text":"南极寿星现，佳气蔼庭除。\n谁为绛人甲子，为我一轩渠。\n恰喜亥成二首，还庆阳来七日，和气渐舒徐。\n敬为图南祝，一瓣问兴居。\n傲松筠，抚龟鹤，乐蓬壶。\n斑衣戏舞，春满兰玉正森如。\n却忆杜陵老子，因羡碧山学士，茅屋换银鱼。\n何似温柔地，丝竹伴琴书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66582,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"满江红 寿太守四月三十","author":"梁大年","text":"九十炎光，又过了、三分之一。\n记当年光际，诞生良弼。\n崧岳降神钟秀气，孕成间世真英杰。\n妙文章、拾芥立功名，谁能敌。\n周孔业，邹轲质。\n伊尹志，渊明节。\n袖经纶妙手，屡投班笔。\n富贵一朝知已逼，封侯谈笑真堪觅。\n信功名、管取出长年，看箕翼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66583,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"古木空烟","author":"梁子固","text":"淡烟漠漠古城头，老树拿云瞰碧流。\n鸦背夕阳添晚景，就中描出一天秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66584,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梁彭州与客登卧龙山送酒二尊 其一","author":"王十朋","text":"五马携壶上卧龙，四夔连骑与游从。\n山中古柏岁寒色，应为清流作意浓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66585,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"止水亭","author":"梁介","text":"惊涛渺半空，怒势突千里。\n此岂水性哉，物有激之耳。\n方塘寻丈间，一泓清且泚。\n镜面烛须眉，水壑绝尘滓。\n道人修净观，此心如此水。\n不从苦海中，更放波澜起。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66586,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"芙蓉桥","author":"梁介","text":"法?瘴疠乡，六月旱烁石。\n榆柳秋不枯，蛇虺冬不蛰。\n长桥坐清虚，足以度朝夕。\n汲井埋深盆，芙蕖间红白。\n幽香自氲氛，南薰为披拂。\n虽无十丈花，有藕亦如蜜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66587,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南定楼","author":"梁介","text":"堂堂百尺楼，制作极华丽。\n山围与水绕，秀色相妩媚。\n上无狐鼠窥，下有鱼龙畏。\n宾友升清虚，夷落耸瞻视。\n南陲粗安堵，北鄙方举燧。\n倚楼独何为，尚下忧国泪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66588,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"筹边堂","author":"梁介","text":"筹边无它长，幸此岁有秋。\n吏无打门宣，民无失业忧。\n史君来此邦，不但肉食谋。\n有言天命之，为汝消穷愁。\n夷蜑及生齿，各异风马牛。\n一醉堂上樽，莫运机与筹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66589,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"整暇堂","author":"梁介","text":"是邦无征科，为吏不劳力。\n今年到官初，牒诉颇纷集。\n大家张空簿，小家称倍息。\n弃责尔未能，义取犹可给。\n风晓便革心，老我多暇日。\n梦回黯空庭，小憩华胥国。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66590,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]