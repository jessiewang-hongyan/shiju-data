[{"title":"句","author":"魏几","text":"半白在梨花，","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23833,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽东莱先生 其一","author":"唐季度","text":"多士将安放，先生今则亡。\n正宗传道德，馀事见文章。\n遽作两楹梦，空遗百世芳。\n哲人胡不寿，天理竟难量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23834,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽东莱先生 其二","author":"唐季度","text":"交友昔尝与，真诚久愈孚。\n公虽推齿序，我实仰师模。\n提耳言犹在，终身誓不渝。\n神驰埋玉处，恸哭向长途。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23835,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"倩真观","author":"唐季度","text":"不记开山日，炼丹惟葛仙。\n清泉沿石滴，孤嶂与天连。\n只就岩为屋，何须木作椽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23836,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和林艾轩城山国清塘韵","author":"陈士楚","text":"山光一洗红尘眼，长松夹道摇青伞。\n回头下瞰百川溶，亭皋小立淩刚风。\n杰阁玲珑朱绿户，何年蓬莱移左股。\n山僧见客不敛眉，梵呗琅琅应鱼鼓。\n欲携三尺弹龟山，淳风一去不复还。\n仞墙草长章逢少，几百年来风月闲。\n嗟哉贤圣远复远，天高地下日易晚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23837,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题闻政堂","author":"李松龄","text":"先生敛经纶，筹帷赞西方。\n一朝去幕府，委佩朝明光。\n召见天叹晚，占对何琅琅。\n小试分顾忧，持麾来边疆。\n善政期必闻，明训思对扬。\n朝夕惧有阙，萧然坐斯堂。\n讼缿亦已空，燕寝凝清香。\n他年报政归，从渠爱甘棠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23838,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送僧还日本","author":"窦从周","text":"榜人理行舻，日出江水平。\n扶桑渺何许，万里浮沧溟。\n上人国之彦，夙悟最上乘。\n慕此中华风，一锡事游行。\n名山与奥谷，足迹已遍经。\n曰予处阛阓，幸矣识韩荆。\n论诗坐终日，问法天花零。\n相得臭味同，蔼蔼芝兰馨。\n岂比钱刀徒，市利纷以营。\n去去须臾间，何以展我情。\n江草色萋萋，江花亦冥冥。\n浮云聚复散，不能常合并。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23839,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵陈可复见赠","author":"周孚","text":"二年穷谷斸黄精，两见骚人赋落英。\n万事吾今负初愿，百年君亦厌虚名。\n花开花落春还夏，窗暗窗明雨又晴。\n莫读离骚但饮酒，从来前辈戒秋声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23840,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠萧光祖","author":"周孚","text":"之子固绝俗，少年甘寂寥。\n田园一蚊睫，书卷百牛腰。\n雪径晴犹冻，烟江晚不潮。\n个中勤著语，老耳欲闻韶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23841,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"哭杨虞臣丈","author":"周孚","text":"先君捐馆时，亲旧止四五。\n丁宁奉遗训，我没谁抚汝。\n孤生卧苫块，泣血诵此语。\n杨公十年旧，不见五年许。\n两萍忽相遇，握手涕如雨。\n高怀几骨肉，老语倾肺腑。\n生死见交情，公固不愧古。\n呜呼英锐气，又掩泉下土。\n我行田野间，陈迹时一睹。\n尚馀旧题壁，犹有所畦圃。\n二儿吾未识，必有称家主。\n寥寥先友记，文缺久不补。\n渠如能缀缉，吾敢惮覼缕。\n但得行实完，虽迟不犹愈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23842,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠萧希仁 其一","author":"周孚","text":"钟山昔游眺，苍翠莫崚嶒。\n不睹骑鲸像，空瞻下马陵。\n斯文今堕地，夫子独传灯。\n剩欲抠衣问，嗟予病未能。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23843,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠萧希仁 其二","author":"周孚","text":"赵子老岩壑，壮心轻世儒。\n曾无一湔祓，但看百喑呜。\n已作山头雀，谁怜屋上乌。\n知公主清议，试与一嘘枯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23844,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄日新","author":"周孚","text":"楚水茫茫觌面难，燕鸿冉冉寄书还。\n自知荒泽谁为雨，却怪孤云未出山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23845,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"病起次韵子和","author":"周孚","text":"不尽扬雄一鸱酒，却吟平子四愁诗。\n酒能作病终何益，诗解穷人亦漫为。\n便死正应如土偶，纵贫那可恨毛锥。\n如今只有荆卿在，能记田光少壮时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23846,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"别闾丘诸公之临安","author":"周孚","text":"久耽笔砚弃犁锄，石友申申或骂予。\n涉世何殊枕中梦，误人今信案头书。\n不堪秋菊彫荒径，欲趁春帆返敝庐。\n回首交游幸无辱，蒯缑虽短不弹鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23847,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"别仲时 其一","author":"周孚","text":"江山共清焕，鱼鸟亦萧散。\n归与三亩园，趁此秋未晚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23848,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"别仲时 其二","author":"周孚","text":"当年丘壑心，皎皎秋夜月。\n那知蹭蹬间，秋风彫壮发。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23849,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"别仲时 其三","author":"周孚","text":"童乌已黄土，其奈太玄何。\n尚喜熊儿在，能为田父歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23850,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"别仲时 其四","author":"周孚","text":"窗隙风微度，檐头月半攲。\n当君感秋日，是我到家时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23851,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"别仲时 其五","author":"周孚","text":"穷愁好著书，到此已绝笔。\n十年意外谤，庶可弭万一。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23852,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"哭畋","author":"周孚","text":"久识死为灭，正缘情未忘。\n宿因吾已断，恶债尔先偿。\n临老翻如衍，平生错笑商。\n莫风吹雨至，老泪并淋浪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23853,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偶成六言","author":"周孚","text":"筠簟攲眠露夜，蒲团趺坐花时。\n莫叹老骥千里，且喜鹪鹩一枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23854,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠宋公佐 其一","author":"周孚","text":"前人久零落，我亦老东南。\n阅士几千百，如君止二三。\n归耕持长策，祛病忆玄谈。\n何日相随去，诛茅共制庵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23855,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠宋公佐 其二","author":"周孚","text":"鬓发伤今白，艰难忆昨经。\n君犹厕跛鳖，我合弃流萤。\n老树秋凄瑟，寒风昼窈冥。\n山房半酣坐，差胜楚人醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23856,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送宋元辅","author":"周孚","text":"骎骎须鬓苍，冉冉岁月换。\n良田未易求，蠹简不喜看。\n君兮何为者，冠佩立宪宪。\n苦来湔祓我，丹绘施朽炭。\n深惭鸿鹄姿，肯作荆鸡伴。\n我穷岂中郎，君才实元叹。\n相从琢磨地，枯几媲尘案。\n尺书中夜至，索去不少缓。\n扁舟下东南，春水绿平岸。\n遥知醉吟处，词翰两璀璨。\n悲欢难一揆，欲别先自断。\n寄我子夜歌，酬君秋雨叹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23857,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"公佐座上分韵得楼字","author":"周孚","text":"谁谓子青眼，不嫌余白头。\n共穿康乐屐，来醉仲宣楼。\n风定江犹怒，云高雨欲休。\n西山多爽气，吾忍赋悲秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23858,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"岁莫不乐","author":"周孚","text":"铜瓶乌几伴栖迟，无复风流似旧时。\n病忆老亲空齧指，贫逢儿辈亦低眉。\n世涂何异两蜗角，士价今轻五羖皮。\n满眼云山不归去，问谁缚汝竟无辞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23859,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次前韵呈公佐仲贤","author":"周孚","text":"世态休论黠与痴，宾鸿社燕各随时。\n稍令有地堪容膝，可复从人再炙眉。\n不愤寒梅呈素面，自怜老桧剥苍皮。\n年来怀抱已如此，归对交游有愧辞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23860,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵洪致远春日绝句二首 其一","author":"周孚","text":"石友今年断不来，纷纷没马但黄埃。\n自怜老臂今三折，安得愁肠不九回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23861,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵洪致远春日绝句二首 其二","author":"周孚","text":"卧病尘尊久不开，知君新棹酒船回。\n似嫌白发非春事，不向东风遣信来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23862,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送张子和之金陵","author":"周孚","text":"转蓬相遇紫髯城，老眼昏昏喜再明。\n与世多违真俗债，于身无益是虚名。\n试将休歇偿前境，莫把文章眩后生。\n若相钟山有闲地，早令秋雁与传声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23863,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送仲时赴铨试","author":"周孚","text":"桑梓与君旧，来南更同州。\n虽云漂泊地，坠好敢不修。\n萧条霸陵饮，寂寞斜川游。\n相从能几何，岁月仅一周。\n未竟室中语，已促江上舟。\n舟行不宜冬，烈风无时休。\n非不欲挽君，恐郁活国谋。\n惰农不自安，乃亦岁有秋。\n力田苟逢年，一亩千钟收。\n富贵今其时，君行勿夷犹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23864,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"公佐索诗次别仲时小诗韵遗之五首 其一","author":"周孚","text":"兰焚以其香，樗寿以其散。\n万物无不然，愧我知之晚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23865,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"公佐索诗次别仲时小诗韵遗之五首 其二","author":"周孚","text":"莫竞梦中鹿，且视指端月。\n傥能心地明，万事一毫发。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23866,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"公佐索诗次别仲时小诗韵遗之五首 其三","author":"周孚","text":"朱丝徽黄金，问子用此何。\n从来履霜操，不及懊侬歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23867,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"公佐索诗次别仲时小诗韵遗之五首 其四","author":"周孚","text":"今年苦风雨，老屋半倾攲。\n投足犹无地，君来正此时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23868,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"公佐索诗次别仲时小诗韵遗之五首 其五","author":"周孚","text":"欲书归田具，请子试濡笔。\n先之蜡屐双，侑以藜杖一。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23869,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"洪致远屡来问诗作长句遗之","author":"周孚","text":"君不见伯伦平生老闭关，祗有一颂留人间。\n怀铅抱椠亦何益，惠子五车终不传。\n我今所见盖如此，堆案文书藏鼠矢。\n自知老境要灰心，却笑少时空血指。\n劳君日日来徵诗，试欲把笔心自疑。\n无盐已老稍识耻，安敢唐突西施为。\n古人作诗有成法，句欲圆转字欲活。\n始循规矩后变化，如以金丹蜕凡骨。\n君试停杯参此语，莫笑前人用心苦。\n祗今孰是前辈诗，风漪作文君看取。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23870,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"哭柳仲和","author":"周孚","text":"干时双落莫，触事两趑趄。\n意广子知我，命穷天丧予。\n哀音来涧壑，老泪湿衿裾。\n从此南冈下，经年独荷锄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23871,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"答闾丘仲时见寄","author":"周孚","text":"纤纤轻草不胜锄，忽有新诗来起予。\n十载光阴消蠹简，两家生计共蜗庐。\n久知吾子传真诀，试与衰翁辩赝书。\n何日一筇真过我，共炊香稻撷园蔬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23872,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠致远 其一","author":"周孚","text":"起踏寒溪雨，来尝老屋茶。\n论年我蒲柳，涉世子龙蛇。\n嫩绿初还水，娇红半著花。\n浇春可无酒，试与问西家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23873,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠致远 其二","author":"周孚","text":"世正矜投笔，人谁话濯缨。\n君穷犹鬼瞰，我病亦天黥。\n古寺云埋径，官濠柳暗城。\n便应从此去，已负白鸥盟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23874,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠致远 其三","author":"周孚","text":"小柳志超逸，病毛才崛奇。\n俱为一抔土，但有百篇诗。\n漠漠江山静，匆匆岁月移。\n黄尘没马首，赖子一伸眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23875,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠致远 其四","author":"周孚","text":"畋也颇丰下，本期渠克家。\n才令配晨月，又复摘秋瓜。\n寒泊堪秧稻，荒池足沤麻。\n熊儿幸无恙，聊伴老生涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23876,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"留别致远","author":"周孚","text":"堤边杨柳发新枝，叹息春工又一时。\n对景不为千日醉，语离还赋四愁诗。\n穷途至此空回首，老色如今各到丝。\n粗有一廛归去好，犁锄何地不相宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23877,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿崇福庵显上人房","author":"周孚","text":"潦收秋涧静，木落莫山稠。\n石路果能滑，杖藜聊此留。\n夜房憎豹脚，朝饭忆猫头。\n为语汤从事，无忘马少游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23878,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"同伯庸游甘露有感次仲贤韵二首 其一","author":"周孚","text":"故人同我去，清旦杖崇冈。\n寒日无留照，惊鸿有断行。\n聊将一日款，少洗十年忙。\n衰病不相弃，我庐今未荒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23879,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"同伯庸游甘露有感次仲贤韵二首 其二","author":"周孚","text":"纵谈四壁静，宴坐一铃鸣。\n老火渐消昼，寒窗忽报晴。\n凄凉鲁两士，赫奕汉三明。\n俱作南柯梦，令人骨亦惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23880,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"口占赠致远","author":"周孚","text":"柳絮翩翩燕子飞，小园风物总宜诗。\n今年已解穰侯印，输与三生杜牧之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23881,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵仲时春莫怀归","author":"周孚","text":"奕奕新诗饱琢磨，精灵如此竟谁过。\n共听鶗鴂春将老，旧记骊驹子试歌。\n坐病已孤新岁酒，忍穷思种故山禾。\n祇今石鼓文多缺，谁为铨量掘臼科。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23882,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵安民","author":"周孚","text":"肺病侵陵倦出游，寒窗棐几即菟裘。\n百年忽忽从渠转，万事昏昏只么休。\n学道几人能杜口，趋功谁子不焦头。\n留君试话人间事，翠竹黄花最耐秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23883,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠宋安民","author":"周孚","text":"閒阶尘没屦，隙户风翻裳。\n攲倾数椽屋，易知独难忘。\n为此室中人，久薰知己香。\n兰彫潘洪逝，璧碎韩吕亡。\n非渠妙语言，何以浣我肠。\n蒲团两默坐，寒窗堕斜阳。\n我炙彼能嗜，叹息时拊床。\n缅思争夺境，其险剧太行。\n病马已虺隤，三径可忍荒。\n相期荷锄归，岁晏天欲霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23884,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夜坐偶作","author":"周孚","text":"霜风振枯条，掩户日已夕。\n老屐不出游，畏此寒懔慄。\n挑灯对空炉，虫声喧四壁。\n翻书娱两眦，渺渺玄雾隔。\n爬搔馀倦酲，城鼓听历历。\n狸奴木上坐，相对成二客。\n殷勤谢尔曹，伴我此岑寂。\n干时悔前猛，学道饱新得。\n请看警露鹤，何似遇风鹢。\n怀情郁不语，檐月已半仄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23885,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"巫主簿挽词","author":"周孚","text":"正叹淹黄绶，俄惊启素车。\n生真元亮似，老更伯喈如。\n谁哭三年墓，空传万卷书。\n蚳蠓可无念，身世本蘧庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23886,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠陈道人","author":"周孚","text":"正谛危欲断，谁胶能续弦。\n要为师子吼，莫看野狐禅。\n小住真聊尔，相逢独岿然。\n同床有佳梦，或许老夫圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23887,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵赠林义之 其一","author":"周孚","text":"炎暑不可触，相逢正此时。\n初无一日雅，肯诵十年诗。\n语际倾心剧，忙中识面迟。\n幽贞可潜伏，君智固如龟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23888,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵赠林义之 其二","author":"周孚","text":"我已刘桢病，君仍屈子醒。\n俱为石碌碌，不改柏青青。\n吉语时占鹊，穷途耻聚萤。\n何时一杯酒，相对话飘零。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23889,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠朱德裕 其一","author":"周孚","text":"老弃泮宫籍，日与学子疏。\n英英佳公子，乃肯过我庐。\n触热生积疴，子意何勤渠。\n逐臭海夫癖，不幸今子如。\n惜无一尊酒，冰瓜配园蔬。\n持家今十年，但有数册书。\n斯文等圭璧，后生多璠玙。\n我田失耕耘，政欲赖子锄。\n晚雨湿不借，新凉到蘧蒢。\n勿嗔折柬邀，衰年出无舆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23890,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠朱德裕 其二","author":"周孚","text":"高冠岌云霓，修佩缀兰茝。\n潘洪已鬼录，尚喜之子在。\n平生诗作魔，见子始追悔。\n奕奕清圆句，极力有不逮。\n政缘一饭先，厚礼辱始隗。\n莫年专一壑，谤语溢四海。\n逢人欲话子，恐子重得罪。\n古学寒如灰，到此已千载。\n非无力学士，始励终则怠。\n子兮其勉旃，河清宁可待。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23891,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戏洪致远","author":"周孚","text":"不妨一斛贮槟榔，兰玉诜诜已雁行。\n可是誉儿元有癖，未应辟谷独无方。\n玉川此际贫虽甚，稠锡他年债已偿。\n世事乘除君记取，击鲜从古是诸郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23892,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵龚良臣见赠","author":"周孚","text":"楚国两名士，鹤居鸡鹜群。\n有谁沾剩馥，独子嗣清芬。\n到睡唯黄妳，扶衰祗紫君。\n犹胜驰宦子，挥汗读移文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23893,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠龚良臣并柬双融赵居士","author":"周孚","text":"平生四海龚夫子，昔日穷愁今尚尔。\n车如鸡栖马如狗，笑指尘编作知己。\n群儿不识老弥明，一语落纸惭且惊。\n森森老干苍桧耸，寥寥雅奏黄钟鸣。\n万牛不来羞自献，正与古人同此叹。\n霜髯雪鬓可奈何，但愿穷年常饱饭。\n北风凛凛冬欲残，日莫更复衣裳单。\n黄金如粟赵居士，傥有绨袍遮此寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23894,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送赵师孟","author":"周孚","text":"乃翁墓木已秋声，喜向诸郎识老成。\n舞拙固应缘短袖，诗高或许是长城。\n莫惊浊世还分袂，闻有清淮可濯缨。\n岁计不赢亲已老，肯因腰直厌逢迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23895,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"高仲威总管挽词二首 其一","author":"周孚","text":"今年岁在巳，公果闭佳城。\n竟不登三事，谁能作九京。\n群公谩推毂，故客独沾缨。\n遗德凭谁纪，平生不近名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23896,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"高仲威总管挽词二首 其二","author":"周孚","text":"忆在多艰日，君王叹鼓鼙。\n来从三晋远，独与二高齐。\n佳赋方惊鵩，流年已梦鸡。\n生前横槊手，还傍汉征西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23897,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]