[{"title":"次韵程公辟暮春","author":"苏颂","text":"日日寻春春欲还，园林游兴未应阑。\n间关莺啭冲牙韵，烂漫花开历绿团。\n须信马蹄随处健，肯教金盏暂时乾。\n休惊节物频更换，适意欢娱定一般。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77734,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵葛大卿题江氏寒光阁","author":"苏颂","text":"溪凝蓝黛合双川，阁在千岩万壑前。\n漱石我思清病齿，倚琴谁共听流泉。\n云生北岭横空白，春入东郊一望鲜。\n况是江南风物好，待君重咏四时天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77735,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵蒋颖叔游西湖入南屏山","author":"苏颂","text":"楼台高下满仙风，疑是蓬莱象帝宫。\n湖面涵虚云漾漾，山腰藏景石珑珑。\n松筠影出红尘外，钟梵声来碧落中。\n薄暮将归起馀思，落霞飞鹜正横空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77736,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵韩康公对雨即事有怀五弟","author":"苏颂","text":"燕閒谁伴泛金焦，注想鸰原望泬寥。\n接客后堂聊造适，偃藩临汝正逍遥。\n齐名孟季须爰立，一致夷聃异反招。\n笔札文章俱第一，风流今不数三萧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77737,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵签判太博谢府公新诗墨迹","author":"苏颂","text":"幕府雍容但省文，笔精诗格两难伦。\n临池得法毫端健，击钵成篇藻思新。\n征虏雅歌追乐事，兰亭赓唱掩芳尘。\n梁王宾友邹枚在，末至惭非赋雪人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77738,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵签判同登介亭","author":"苏颂","text":"纷纷尘事厌烦冥，何处能令爽气生。\n簿领欲迷头不举，烟霞才望眼偏明。\n门临沧海千重险，地压高丘一再成。\n若论三山方外境，须将此地拟浮瀛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77739,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵蔡资政答朱寺丞惠千叶桃花菊","author":"苏颂","text":"分得秾华质，依然苦薏香。\n繁红如上苑，密蕊胜南阳。\n不用寻根叶，须留过雪霜。\n殷勤送东阁，聊荐百年觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77740,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"行次塘堤","author":"苏颂","text":"淼淼寒流千里馀，带城襟垒似江湖。\n侯王设险古未有，夷狄窥边今遂无。\n数郡营屯归耒耨，万家生聚利菰蒲。\n长堤不绝才如线，南北冲冲是坦途。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77741,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观文殿大学士刑部尚书赠左仆射兼侍中刘公挽辞三首 其三","author":"苏颂","text":"蚤历平津馆，尝蒙鲍叔知。\n笑言忘位貌，论议切箴规。\n岂悟三秋别，遂成隔世期。\n英风今已矣，遗恨满江湄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77742,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观文殿大学士刑部尚书赠左仆射兼侍中刘公挽辞三首 其二","author":"苏颂","text":"星坠寝门夕，鵩来州舍辰。\n人悲丧遗爱，帝梦失良臣。\n勋业经纶远，文章气燄新。\n殁犹荣故里，宸笔镂坚珉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77743,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观文殿大学士刑部尚书赠左仆射兼侍中刘公挽辞三首 其一","author":"苏颂","text":"特起来南国，登庸历宰卿。\n立朝弦载直，遇物称如平。\n一梦荣华尽，千年封襚成。\n秋风暮江起，凄咽逝波声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77744,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观北人围猎","author":"苏颂","text":"莽莽寒郊昼起尘，翩翩戎骑小围分。\n引弓上下人鸣镝，罗草纵横兽轶群。\n画马今无胡待诏，射雕犹惧李将军。\n山川自是从禽地，一眼平芜接暮云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77745,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观潮三首 其三","author":"苏颂","text":"横江白浪涌崔嵬，应是波神羽卫来。\n陛戟百重驰道远，舳舻千里峭帆开。\n缓如积雪飞霜路，急似砯崖转石雷。\n惟有东西争渡者，暮还朝往任相催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77746,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观潮三首 其二","author":"苏颂","text":"尝观七发论涛篇，比物侔形恨未妍。\n声入闾阎家十万，势陵组练甲三千。\n冯夷海若凭深险，种魄胥神竟后先。\n纵使风波能鼓怒，终归漩澓作澄渊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77747,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观潮三首 其一","author":"苏颂","text":"海门双峙隔沧溟，潮汐翻波势若倾。\n万叠银山横一线，千挝鼍鼓震重城。\n来无源委逢秋盛，信有盈亏应月生。\n今古循环曾不涸，谈天闳辩岂能名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77748,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初过白沟北望燕山","author":"苏颂","text":"青山如壁地如盘，千里耕桑一望宽。\n虞帝肇州疆域广，汉家封国册书完。\n因循天宝兴戎易，痛惜雍熙出将难。\n今日圣朝恢远略，偃兵为义一隅安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77749,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"判秘阁何龙图赴职宴集诸公同赋诗以纪出入之盛","author":"苏颂","text":"一去鸿都岁始旬，职更河澳与言纶。\n出为戎阃蕃宣守，归作儒林典颂人。\n寓直重游唐丽正，翻书还上汉麒麟。\n参陪樽俎俱时彦，独愧非才踵后陈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77750,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即席分得秋字送张吉老学士移使京西","author":"苏颂","text":"赐对中楹喜暂留，驻旌聊复到蓬丘。\n朋游少别三周岁，尊酒相逢半白头。\n频拜恩光龙铸节，屡宣风力隼横秋。\n二邦已见澄清效，更尽宽平缓主忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77751,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宋中道都官挽辞二首 其二","author":"苏颂","text":"文章微婉气清遒，议论精通学赡优。\n方见璠玙为国器，忽经兰菊陨霜秋。\n梦中应讲阴堂奥，天上须刊白玉楼。\n闻道遗编已成帙，何人列上载蓬丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77752,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宋中道都官挽辞二首 其一","author":"苏颂","text":"儒雅名公子，风流粉署贤。\n精神清比鉴，论议直如弦。\n朝已期登俊，天胡不畀年。\n永怀三友益，一恸寝门前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77753,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"李公择尚书见示出郊奉雩祀马上口占七言四韵走笔继和","author":"苏颂","text":"雩郊几夕见龙星，盛乐初谐六变声。\n荐币礼同匏爵重，洁牲人比玉壶清。\n幕中闳辨通宵接，马上新诗顷刻成。\n精意预期甘泽应，随轩飞入凤凰城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77754,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杨君宠示嘉篇次韵奉和","author":"苏颂","text":"江湖一别岁经旬，携手重游上苑春。\n华发满头犹未仕，少年得意果何人。\n利名机浅贫奚恤，道义交深老益亲。\n清世怀文终有用，穷途宁久困无津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77755,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"沙陀路","author":"苏颂","text":"上得陂陀路转艰，陷轮推马苦难前。\n风寒白日少飞鸟，地迥黄沙似涨川。\n结草枝梢知里堠，放牛墟落见人烟。\n从来天地分中外，今作通逵近百年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77756,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"苏明允宗丈挽辞二首 其二","author":"苏颂","text":"尝论平陵系，吾宗代有人。\n源流知所自，道义更相亲。\n痛惜才高世，赍咨涕满巾。\n又知馀庆远，二子志经纶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77757,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"苏明允宗丈挽辞二首 其一","author":"苏颂","text":"观国五千里，成书一百篇。\n人方期远到，天不与遐年。\n事业逢知己，文章有象贤。\n未终三圣传，遗恨掩重泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77758,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"走笔次韵察推见别二篇 其一","author":"苏颂","text":"行藏无意但随时，不为人知我者稀。\n负壳蜗牛初就舍，驯鸥海客已忘机。\n缄收卷轴尘生蠹，合和丹丸醭有衣。\n久冒宠荣无所补，敢烦从事叹巍巍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77759,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"走笔次韵察推见别二篇 其二","author":"苏颂","text":"老爱诗书志益坚，不成鱼网谩临渊。\n幽居喜见新松菊，病目愁看旧简编。\n事任閒忙常自适，心忘毁誉敢求全。\n知君有意论骚雅，何日从容话极玄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77760,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"走笔奉酬签判殿丞游思上人院","author":"苏颂","text":"坐閤何时得少休，羡君乘兴喜寻幽。\n每逢幕府文书简，便作湖山佛寺游。\n岩畔挥毫传丽句，林间炊黍饫香羞。\n会须偷拨閒忙日，更上高轩看碧流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77761,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陆农师又示第五和篇褒借益勤辄复酬答","author":"苏颂","text":"讲序尝登虎观西，玺书对罢武都泥。\n前言往行推多识，细管纤锋不自携。\n信史已成知有法，好诗频寄更无题。\n就中醉墨人偏爱，应与南朝小谢齐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77762,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"使回蹉榆林侵夜至宿馆","author":"苏颂","text":"使还兼道趣南辕，朝出沙陀暮水村。\n雪岭迢遥人自少，冰天凄惨日长昏。\n鸦闻宿舍惊如闹，马识归途去似奔。\n屈指开年到京阙，梦魂先向九重阍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77763,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"侍读给事王公挽辞三首 其三","author":"苏颂","text":"经幄咨嗟旧学臣，诔章追册两优恩。\n平时宠禄由稽古，不朽声名在立言。\n驷马嘶鸣还故国，素车奔走送高原。\n诸儒师表今亡矣，惟有清风愯后昆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77764,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"侍读给事王公挽辞三首 其二","author":"苏颂","text":"禁序方尊宠，雍容侍紫宸。\n忽惊畴昔梦，遂失老成人。\n史稿留天阁，铭旌去国闉。\n龙门宾友散，挥涕想遗尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77765,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"侍读给事王公挽辞三首 其一","author":"苏颂","text":"当代儒林老，谁知蕴学精。\n典章推练达，经术号通明。\n簪橐何时去，堂坊一旦成。\n汉庭伤贾傅，仕不至公卿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77766,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刁节推郊居寄说晤二诗僧","author":"苏颂","text":"倦赋从军咏式微，山斋重此理松扉。\n春来园圃朱樱遍，霜后盘飧绿芋肥。\n瓶锡时邀高士驾，台缁多学野人衣。\n白莲诗社方求友，喜得支公与共归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77767,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刁推官蓼花二首 其二","author":"苏颂","text":"莲疏菊未破，野艳独敷荣。\n濯水红缨细，铺园步障平。\n露寒偏发色，风劲不摧茎。\n采掇聊供饵，丹房助气清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77768,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刁推官蓼花二首 其一","author":"苏颂","text":"烟雨寒塘外，萧条广隰中。\n花逢秋至盛，人爱水边红。\n碎缬排霜叶，纤蕤拂露丛。\n尊罍不见赏，留得伴溪翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77769,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和门下侍郎东台夜直见寄","author":"苏颂","text":"五年班缀望夔龙，曾托帡幪庇雨风。\n末路自矜黄发老，平时曾识黑头公。\n升沈不改交情见，出处虽殊趣舍同。\n谩叩芜音答高唱，终惭下管应清宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77770,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和门下相公从驾幸太学","author":"苏颂","text":"圣主恢儒率旧章，首冬鸣跸下胶庠。\n生师褒博趋鳣序，文武端严列雁行。\n承诏敷陈商戊甲，执经环立晋袁王。\n三千学者多才秀，定有同升孔子堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77771,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和王大观寄张仲巽","author":"苏颂","text":"内使名卿话昔游，高谈术略气横秋。\n边亭一别嗟淹久，故眼相看重唱酬。\n旧德朝端方见用，清才关外苦难留。\n腰间鞶绶频加宠，几见新头代故头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77772,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和王禹玉相公三月十八日皇子侍宴长句三首 其三","author":"苏颂","text":"奉宸班近殿中香，人在金銮日月旁。\n鱼藻君臣同恺乐，露萧遐迩荷龙光。\n已闻幼海歌重润，更得清风诵十章。\n嘉会古今应罕遇，未饶西母白云觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77773,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和王禹玉相公三月十八日皇子侍宴长句三首 其二","author":"苏颂","text":"从臣环极宴披香，帝子趋庭揖在旁。\n日御舒长延昼景，星辉明润照天光。\n沉沉殿幄三云邃，簇簇宫花五采章。\n四曲汉歌齐祝圣，九宾周卫尽班觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77774,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和王禹玉相公三月十八日皇子侍宴长句三首 其一","author":"苏颂","text":"紫云楼外拥天香，初见前星帝座旁。\n庭乐声长歌燕翼，朝簪色喜动明光。\n仙巾缥缈尊三弁，环带玲珑袭九章。\n遥听相君称贺语，心倾尧日荐霞觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77775,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和王察院竹筱巷阻风七言","author":"苏颂","text":"闻道扁舟下迅湍，怒涛惊浪拥前滩。\n岸迷津际居无定，人隔过从意少欢。\n风信未回聊对景，岁华将暮自凌寒。\n君才一日能千里，直上青云亦未难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77776,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和北轩薜荔","author":"苏颂","text":"分得岩枝带藓文，壁间延蔓密含春。\n摇风似展垂云翼，和雨疑骞化浪鳞。\n寒对竹轩陵霰雪，静陪犀柄辟埃尘。\n省闱不比山河远，休拟灵均咏若人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77777,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和北游","author":"苏颂","text":"衔命初开朔土游，故人威重肯回眸。\n旌旗在列千馀骑，棨戟遥临十一州。\n令尹投兵方秉羽，羊公临塞但轻裘。\n诸贤酬唱无閒日，卷轴今应束两牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77778,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和仲巽山行","author":"苏颂","text":"天险限南北，回环千里山。\n客亭依斗绝，胡地信偏悭。\n伴月驱行传，缘云度故关。\n林泉虽胜赏，无奈霫奚间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77779,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和仲巽过度云岭","author":"苏颂","text":"磴道青冥外，跻攀剧箭飞。\n朔风增凛冽，寒日减清晖。\n使者手持节，征人泪湿衣。\n此时仁杰意，心向白云归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77780,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和农师四和前韵仍有推奖鄙薄之句再次韵","author":"苏颂","text":"敬舆平日始来西，老拙方叨掌武泥。\n初见鱼龙起腾跃，从陪鹓鹭共牵携。\n儒林盛会沾恩饫，云阁新图预客题。\n更听高谈造名理，人间无物不均齐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77781,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘明仲都曹见别三首 其三","author":"苏颂","text":"幽居邻有万窠松，坐见京江四面峰。\n形若橛株随倚徙，愁如顽矿渐销镕。\n尚纡轩冕心颜厚，但觉林泉兴味浓。\n茗饮药苗留待客，时时宾友自过从。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77782,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘明仲都曹见别三首 其二","author":"苏颂","text":"久污朝宠老非宜，禄厚躬閒不尔亏。\n优诏还令使真室，特恩仍免觐京师。\n力疲都是垂头马，志适何殊曳尾龟。\n年事已高心虑息，山堂无俟德璋移。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77783,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘明仲都曹见别三首 其一","author":"苏颂","text":"二年为郡乐邗坡，喜遇丰年万物和。\n政拙未能观水薤，气衰时复咏烟萝。\n朱方亭下归心速，扬子桥边别泪多。\n禁职祠官容佚老，晚蒙恩泽更霶沱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77784,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和孙节推寄罗发运","author":"苏颂","text":"一瓢贤巷僻如山，十部文移日满前。\n辍得閒时常命驾，和来新什已盈编。\n交游莫逆心相照，出处虽殊道两全。\n能使清风激颓俗，世情谁得议高坚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77785,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和孙节推雪","author":"苏颂","text":"腊催时雪到江涯，云压寒空凝不飞。\n台榭风光先有意，山川秀色远相辉。\n人怀姑射清难见，诗似阳春和者稀。\n闻上高楼寻胜赏，缅怀嘉尚重依依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77786,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和安抚王临骐骥见寄","author":"苏颂","text":"十月河滨土未乾，行人裘褐苦沾汗。\n边侯顾遇劳纡轸，驿舍留连暂憩鞍。\n义贯雪霜松操古，气凌星斗剑光寒。\n待君早晚功名就，重约虚斋论隐桓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77787,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和次中双庙感事","author":"苏颂","text":"天宝黎民困贼庭，杞城睢社势相形。\n四公百战期歼虏，数载重围不启扃。\n当日捐躯全土境，至今遗貌载丹青。\n行人安得侵松槚，樵采从来禁有刑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77788,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和许秘校同游两天竺","author":"苏颂","text":"柳浦重城忝建旟，旧吴星分斗牛墟。\n鹫峰遗迹奇难状，大士灵光应不虚。\n游伴偶陪宾结驷，肴蔬深愧食无鱼。\n高谈终日穷幽赏，俗虑尘襟顿释除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77789,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和过打造部落","author":"苏颂","text":"奚夷居落瞰重林，背倚苍崖面曲浔。\n涧水逢春犹积冻，山云无雨亦常阴。\n田塍开垦随高下，樵路攀缘极险深。\n汉节经过人竞看，忻忻如有慕华心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77790,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和吴仲庶龙图寄德仁致政比部二首 其二","author":"苏颂","text":"倦游城阙厌纷华，一棹南归出白沙。\n簪绂弃来如释负，山林到处便为家。\n流泉绕舍锵金玉，仙饵盈槃泛露霞。\n珍重宗英嘉隐操，远裁清句重咨嗟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77791,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和吴仲庶龙图寄德仁致政比部二首 其一","author":"苏颂","text":"道骨仙风擅世华，肯将璠玉混泥沙。\n潜郎未老辞朝路，傲吏归来学道家。\n逸似子荆将漱石，清如中散本餐霞。\n应思平日市朝客，缰锁拘挛正可嗟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77792,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和吴仲庶待制见寄","author":"苏颂","text":"几日风沙结襟袖，忽传嘉惠眼重开。\n交情不改乘车约，和气先随掞藻来。\n元帅本由诗礼选，行人愧匪语言才。\n相逢且喜论平素，若校文章未易陪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77793,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和吴仲庶寄李子仪","author":"苏颂","text":"五纪修戎好，重关四向开。\n村郊纵牛马，战地长蒿莱。\n过客朝连暮，征轺去复回。\n元侯勤主礼，一一倒瓶罍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77794,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和宋次道戊午岁馆中曝书画","author":"苏颂","text":"鸿都清集秘图开，遍阅真仙暨草莱。\n气韵最奇知鹿马，丹青一定见楼台。\n宴觞更盛华林会，坐客咸推大厦才。\n久事簿书抛翰墨，文林何幸许参陪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77795,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张少卿过德清忆郎中五弟","author":"苏颂","text":"平昔知君兄弟名，籍随廉茂策通经。\n已伤荆木一枝折，重过桐乡双泪零。\n朝见鹡鸰诗思苦，夜听鸿雁睡魂醒。\n近闻阮巷有才子，异日轩昂看拾青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77796,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]