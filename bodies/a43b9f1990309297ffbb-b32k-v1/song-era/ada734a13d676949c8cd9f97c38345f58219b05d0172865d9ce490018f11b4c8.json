[{"title":"丰年谣五首 其五","author":"王炎","text":"稻如马尾覆沟塍，桑柘阴中鸡犬鸣。\n收穫登场便无事，输租人不入州城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15664,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丰年谣五首 其四","author":"王炎","text":"睡鸭陂塘水慢流，离离禾稼满平畴。\n共言官府催科缓，饱饭浑家百不忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15665,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丰年谣五首 其三","author":"王炎","text":"洞丁徭户尽归耕，篁竹无人弄寸兵。\n要识二天恩德广，黄云千里见秋成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15666,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丰年谣五首 其二","author":"王炎","text":"纵横南陌接东阡，妇饷夫耕望有年。\n前此丁黄饥欲死，今年米贱不论钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15667,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丰年谣五首 其一","author":"王炎","text":"满箔春蚕得茧丝，家家机杼换新衣。\n五风十雨天时好，又见西郊稻秫肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15668,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"从范秘监过城南陈亦颜读书楼 其二","author":"王炎","text":"轩冕浮夸不系情，山林清奥可逃名。\n如何结屋依庐阜，又却移家近玉京。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15669,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"从范秘监过城南陈亦颜读书楼 其一","author":"王炎","text":"客来挥麈对觥船，客去焚香阅简编。\n车马软红尘里走，不知委巷有壶天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15670,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"劝农出郊三绝 其二 劝农","author":"王炎","text":"桃花一笑弄春晴，布谷澜翻亦劝耕。\n十雨五风蒙帝力，愿同父老庆秋成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15671,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"劝农出郊三绝 其三 马驿","author":"王炎","text":"边头万马似云屯，准备秋风压战尘。\n何日将军收虎帐，道旁筑屋免勤民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15672,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"劝农出郊三绝 其一 古仙洞","author":"王炎","text":"小烦脚力上崔嵬，意为仙翁特地来。\n只有白云藏古洞，不知黄鹄几时回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15673,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"双溪种花 其二","author":"王炎","text":"苍头为我斸西山，扶病移花强自宽。\n纵不为花长作主，何妨留与后人看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15674,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"双溪种花 其一","author":"王炎","text":"双溪渐有杂花开，每日扶筇到一回。\n胜似名园空锁闭，主人至老不归来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15675,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬至日雪","author":"王炎","text":"日脚初添一线长，飞花撩乱压微阳。\n朱门满酌羊羔酒，谁念茅茨有绝粮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15676,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出郭视田讼三绝 其二","author":"王炎","text":"木末鹧鸪相应鸣，路危笑我不能行。\n湖光浅绿山容碧，颇觉心清境亦清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15677,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出郭视田讼三绝 其一","author":"王炎","text":"拨置文书小据鞍，举头历历见青山。\n老农指点黄云好，为驻双凫一解颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15678,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出郭视田讼三绝 其三","author":"王炎","text":"草生弃地没牛深，岂是膏腴亩一金。\n野老双蓬俱半脱，尚凭蜗角起争心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15679,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出游郊外七绝 其二","author":"王炎","text":"幽鸟共歌春意好，閒花巧笑客愁多。\n酒徒诗社俱疏隔，如此东郊景物何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15680,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出游郊外七绝 其一","author":"王炎","text":"漠漠野田新水生，花枝一笑欲倾城。\n孤村曲坞皆春色，信有东风不世情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15681,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出游郊外七绝 其七","author":"王炎","text":"云昏山色收图画，雨过泉声杂管弦。\n马上得晴春满眼，好花迎客亦嫣然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15682,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出游郊外七绝 其六","author":"王炎","text":"快马骎骎穿野径，春风处处见山花。\n不须举首看回雁，家在南头天一涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15683,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出游郊外七绝 其三","author":"王炎","text":"闭户不知春色佳，柳梢欲暗可藏鸦。\n鸭头新绿齐腰水，女颊轻红刺眼花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15684,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出游郊外七绝 其五","author":"王炎","text":"孤烟近见数椽屋，急水时行独木桥。\n入眼异乡风景别，脩眉一抹暮山遥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15685,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出游郊外七绝 其四","author":"王炎","text":"道上东风掠面轻，一犁雨足得新晴。\n草头蛱蝶自由舞，林下鶌鸼相对鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15686,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用十梅韵答冯簿 其三","author":"王炎","text":"尝试评公诗，崖岸极孤绝。\n同僚笔可焚，后学巾宜折。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15687,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用元韵答子大","author":"王炎","text":"桃花映面方留咏，藤刺缠身始悟禅。\n短发镜中霜薄薄，脩眉窗下月娟娟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15688,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用元韵答李郎中 其一","author":"王炎","text":"未问仙家九节蒲，且持茗碗对熏炉。\n黄冠也肯迎留客，咀嚼梅花费一壶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15689,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用元韵答李郎中 其二","author":"王炎","text":"冰玉谈清洗老怀，兴浓亦覆手中杯。\n平生蜡屐登山惯，岂必因花特地来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15690,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用元韵答铦老 其二","author":"王炎","text":"舐犊酸辛入客怀，何堪婪尾更传杯。\n却思拈拂谈名理，肯惮携筇数往来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15691,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用元韵答铦老 其一","author":"王炎","text":"人间得丧等樗蒲，何似翻经拥地炉。\n尚学汤休频觅句，傥逢元亮一倾壶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15692,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"田间閒步","author":"王炎","text":"春光挽我出柴扃，道上陈根换短青。\n尚怯东风寒料峭，已闻好鸟语丁宁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15693,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"田间麦秀因成绝句","author":"王炎","text":"老稚缘崖锄草根，炊烟不起自酸辛。\n东皋春到青青麦，屈指何时可食新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15694,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再和林宝文三绝 其一","author":"王炎","text":"要知好雨自何来，和气连云拨不开。\n廊庙为霖须妙手，即看力斡大钧回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15695,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再和林宝文三绝 其二","author":"王炎","text":"千里山川含秀色，四郊鸡犬散欢声。\n更呼屏翳从颐指，润泽无边浃属城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15696,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再和林宝文三绝 其三","author":"王炎","text":"阳开阴阖四时更，谁解均调玉烛明。\n画戟香中沛恩泽，祥风甘雨自流行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15697,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同李鲁二郎中游三茅观 其一","author":"王炎","text":"羽衣邀我坐团蒲，一穗香云绕竹炉。\n九陌红尘飞不到，疑从木末入悬壶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15698,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同李鲁二郎中游三茅观 其二","author":"王炎","text":"愁边无处寄幽怀，拟傍梅花把一杯。\n玉靥含香浑未吐，尝携欢伯为重来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15699,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吕待制所居八咏 其五 藤洞","author":"王炎","text":"空中一洞足清风，上有长藤翠蔓秾。\n说与山灵护持取，苍皮瘦骨恐为龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15700,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"如大坂二绝 其二","author":"王炎","text":"盘薄解衣方少休，青山白水挽吾留。\n一声杜宇唤归意，百啭黄鹂生客愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15701,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"如大坂二绝 其一","author":"王炎","text":"轻风掠面作微凉，尽日笋舆行涧冈。\n畦稻欲花新得雨，老农屈指计秋尝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15702,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戏江子大","author":"王炎","text":"莫年尚恋蛾眉斧，平日空谈蜡脚禅。\n应笑老夫甘寂寞，只将黄奶替婵娟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15703,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"早梅","author":"王炎","text":"似无还有暗香来，知是春风到早梅。\n一岁一番花似玉，老人见得几番开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15704,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次日快晴","author":"王炎","text":"曈曈晓日射窗明，急雪漫空快得晴。\n田父饭牛应喜甚，东皋泽泽可深耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15705,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵子大四绝 其二","author":"王炎","text":"一榻尘埃书满前，愧无丝竹宴彭宣。\n而今又断功名念，只拟躬耕郭外田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15706,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵子大四绝 其一","author":"王炎","text":"世路羊肠久惮行，归来自喜一身轻。\n故人零落今无几，独幸相逢底里倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15707,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵子大四绝 其三","author":"王炎","text":"抽身幸免坐毡针，镜里休怜白发新。\n杖屦消摇共来往，更添林下一閒人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15708,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵朱晦翁十梅 早梅","author":"王炎","text":"皎皎姑射仙，缟衣而黄里。\n一别如许时，见之先失喜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15709,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵朱晦翁十梅 岭梅","author":"王炎","text":"北枝未春风，南枝先暖雪。\n吹香祇自怜，驿使音尘绝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15710,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵朱晦翁十梅 野梅","author":"王炎","text":"迥野殊寂寥，孤芳太清绝。\n暗香疑有无，似亦畏攀折。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15711,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"池边梅花一株盛开 其一","author":"王炎","text":"天外青鸾不复归，萧萧短发日成丝。\n寒梅不管人憔悴，故著新花满旧枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15712,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"池边梅花一株盛开 其二","author":"王炎","text":"老来裘褐怯风吹，难傍花边把一卮。\n嚼蕊嗅香清兴在，尚呵冻笔欲题诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15713,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自南斋晚归二绝 其一","author":"王炎","text":"返照南山脚，西风古渡头。\n破烟双鹭晚，抱叶一蝉秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15714,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自南斋晚归二绝 其二","author":"王炎","text":"溪凉鱼发发，山静鸟飞飞。\n草笠儿驱犊，荆钗女浣衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15715,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"至灌溪予瑰老二首 其二","author":"王炎","text":"食肉定知非虎颈，腾身自笑不鸢肩。\n相逢莫话青云事，借我清风一枕眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15716,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"至灌溪予瑰老二首 其一","author":"王炎","text":"春风一路百花开，踏遍空山特地来。\n莫道沤麻池水浅，千寻飞瀑吼春雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15717,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟行到?莪和清老韵 其二","author":"王炎","text":"诗中巧手妙穿杨，便可阶升屈宋堂。\n句挟冰霜堪却暑，令人心地亦清凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15718,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟行到?莪和清老韵 其一","author":"王炎","text":"沙尾维舟傍水杨，主人延我坐中堂。\n山焦石裂方亭午，借得微风一霎凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15719,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过涪翁墓二首 其二","author":"王炎","text":"水行双井陆沉沉，洗我胸中三斗尘。\n人物只今虽寂寞，溪山依旧自清新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15720,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过涪翁墓二首 其一","author":"王炎","text":"千古诗中老斫轮，久埋玉树去修文。\n野人指点青山下，此是黄家鲁直坟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15721,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即事六绝 其二","author":"王炎","text":"半生飘泊将雏意，百感凄凉舐犊情。\n露电终非真实相，彭殇何者是长生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15722,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即事六绝 其三","author":"王炎","text":"布衣蔬食且随缘，睡起时参柏子烟。\n欲倚绳床拈白拂，何人真解意中玄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15723,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即事六绝 其五","author":"王炎","text":"拂拭青奴供昼眠，半晴半雨酿愁天。\n梦回不到南柯境，风过绿阴号晚蝉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15724,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即事六绝 其四","author":"王炎","text":"了无俗驾到蜗庐，隐几閒翻贝叶书。\n属付苍头休洒扫，绿苔随意上阶除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15725,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即事六绝 其一","author":"王炎","text":"焚香清坐对韦编，妙处悬知不可传。\n三画分明寄玄旨，谁将脩绠汲深泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15726,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即事六绝 其六","author":"王炎","text":"孙竹新添绿玉枝，稚禽学习绕檐飞。\n动中会取归根意，雨过白云横翠微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15727,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"呈游大冶","author":"王炎","text":"昔在桃溪少壮时，而今衰飒鬓成丝。\n悲欢三十年中事，付与寒窗酒一鸱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15728,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"拟古闺怨三首 其三","author":"王炎","text":"花开复花谢，堕在藩溷边。\n不惜花落尽，惜无长少年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15729,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"拟古闺怨三首 其二","author":"王炎","text":"良人久在外，想像裁香罗。\n放下金粟尺，无言颦翠蛾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15730,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"拟古闺怨三首 其一","author":"王炎","text":"为郎缝春衣，春尽郎未归。\n羞见庭下花，一双胡蝶飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15731,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"社日","author":"王炎","text":"日暖泥融燕子飞，海棠深浅注胭脂。\n一杯社日治聋酒，报答春光烂漫时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15732,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"到大坂","author":"王炎","text":"经年不踏鳙溪路，此日重来访旧游。\n溪上老人今不见，凉风细雨四山秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15733,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"到白石先妣新茔","author":"王炎","text":"泪滴松楸意转哀，欲归小立更徘徊。\n春风不管人间恨，溪上樱桃花自开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15734,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"到常清寺予哲师三绝 其二","author":"王炎","text":"寂寂松门古道场，暂容倦客拂横床。\n老僧欲尽殷勤意，林下春风茗椀香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15735,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"到常清寺予哲师三绝 其一","author":"王炎","text":"扣关解后老支郎，见我丁宁问故乡。\n自说病身归不得，花开叶落几凄凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15736,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"到常清寺予哲师三绝 其三","author":"王炎","text":"古井寒泉久不波，岂贪好梦到南柯。\n夜来雨过岩花落，好鸟留春自啸歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15737,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和九日尧章送菊 其一","author":"王炎","text":"对花懒举玉东西，孤负金钱满绿枝。\n短发不堪重落帽，枯肠何可强搜诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15738,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和九日尧章送菊 其二","author":"王炎","text":"花品若将人品较，此花风味似吾儒。\n秋英餐罢含清思，曾有离骚续笔无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15739,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和王右司游南岳三绝 其一","author":"王炎","text":"懒跨狨鞍趁晓班，却穿蜡屐小游山。\n山头草木生光彩，玉节曾行紫翠间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15740,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和王右司游南岳三绝 其三","author":"王炎","text":"祝融独秀压群峰，登览虽终兴未穷。\n人物与山争峻特，也宜班爵视三公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15741,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和王右司游南岳三绝 其二","author":"王炎","text":"乔岳雄于楚粤间，众丘迤逦酿高寒。\n青藜拄到云霄上，见得心如眼界宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15742,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]