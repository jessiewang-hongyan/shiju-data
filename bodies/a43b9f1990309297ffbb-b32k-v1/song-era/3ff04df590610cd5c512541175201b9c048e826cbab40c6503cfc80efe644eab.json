[{"title":"舟中与安道手谈遣日","author":"汪梦斗","text":"日长消困共枰棋，适兴何须苦用机。\n舟窄不妨眠对局，暑轻已觉汗沾衣。\n身如禅定一榻上，心似游丝千里飞。\n何似清吟发天籁，精神疏畅肉生肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34982,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夜泊宿迁上流","author":"汪梦斗","text":"旧国当年阔，暑风今日生。\n舟回溪几曲，人卧月三更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34983,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"下邳永丰桥舟过其下有感","author":"汪梦斗","text":"博浪沙中击副车，却来跪履受编书。\n欲从圯上寻黄石，今有何人孺子如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34984,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"吕梁洪读宣和碑","author":"汪梦斗","text":"水落石多舟去迟，乱河西渡读残碑。\n三亭二闸依然在，那得安流似旧时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34985,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"彭城有感","author":"汪梦斗","text":"河边不见旧黄楼，绿暗荒城四月秋。\n风捲黄沙尘拂面，有人尚忆老坡不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34986,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"吊后山","author":"汪梦斗","text":"生平不肯见王公，蒙被清吟道自尊。\n寂寞彭城非昔比，风流何处觅曾孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34987,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夜宿黄河","author":"汪梦斗","text":"轻舟自挽上危滩，不见黄河古水津。\n天上三更下弦月，梦中万里异乡魂。\n苦无浊酒浇劳役，喜有清飙濯暑袢。\n晓起掀篷明望眼，蹇驴载鹊过前村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34988,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"沛县道中","author":"汪梦斗","text":"谩著青鞋过小湾，偶然清暑变轻寒。\n山行却似江南景，更有群鹅浴碧澜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34989,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"汉高祖歌风台","author":"汪梦斗","text":"击筑长歌意始真，斩蛇元是感乡人。\n大风不起人非昔，台下滔滔泗水春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34990,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"沛城北有伍员庙碑露立荒郊有感","author":"汪梦斗","text":"吴若未亡齐未寒，辞人微意寓毫端。\n当时借为胥祠发，似诮诸人讣契丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34991,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"东行鱼台县界初闻莺","author":"汪梦斗","text":"新绿阴阴夏气清，犊车穿入别村行。\n家山今隔几千里，始听春莺第一声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34992,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"登鱼台读唐梁至金人碑有感","author":"汪梦斗","text":"石台突兀镇荒云，废寺凄凉石有文。\n鲁国遗风无彷佛，矢鱼以后几纷纷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34993,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"明发鱼台至古城或云即旧济州未详","author":"汪梦斗","text":"箕斗澄晖缺月升，茅花夹毂雪中行。\n晓风凛凛寒城冷，濠里荷钱无数生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34994,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"车行济州道中即事","author":"汪梦斗","text":"客里休歌行路难，未容归梦绕江南。\n荆筐蔽弩人媒雉，桃叶悬门女饭蚕。\n故国山河今尚在，残春道路暑先酣。\n新诗收拾中州事，归与乡人细细谈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34995,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"汶上县西门外有梁王彦章庙金人泰和中重修庙记存","author":"汪梦斗","text":"铁鎗战死后梁时，消得金人为葺祠。\n近岁江头几符节，过来须也读残碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34996,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"东平府登飞云楼啜茶","author":"汪梦斗","text":"过楼懒上最高梯，为爱茶香试上嬉。\n檐外众山供远碧，却思乡景下楼迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34997,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"道过茌平县感马周事","author":"汪梦斗","text":"卧驾驴车入博州，青山淡淡夕阳愁。\n翻思故国今何在，枉抱忠肝似马周。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34998,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"高唐州戏作","author":"汪梦斗","text":"错赋巫山十二峰，西南与北偶名同。\n便饶真是阳台路，行雨才收梦亦空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34999,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"道中不见山水","author":"汪梦斗","text":"有山无水山枯槁，有水无山水汗漫。\n此处无山亦无水，风砂捲地鼻生酸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35000,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过御河有感","author":"汪梦斗","text":"转漕东南由汴力，此河今日力犹多。\n隋疲民力亡天下，却为他人浚两河。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35001,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"景州道中","author":"汪梦斗","text":"驿路车声软，斜晖雨脚收。\n柳阴家晓鹊，桑椹醉春鸠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35002,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雄州北城外过白沟河","author":"汪梦斗","text":"手斧当年自画河，圣人微意不求多。\n如何王蔡忘前事，可谓贪他却著他。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35003,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"道中渴水","author":"汪梦斗","text":"辘轳无处汲甘泉，恼得相如肺疾生。\n忆著江南山里路，时时一酌骨毛清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35004,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"晓入涿州界看太行山","author":"汪梦斗","text":"晓风刮骨似严寒，漠漠吹沙塞鼻关。\n卧入范阳元不觉，醒来忽见太行山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35005,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"连日晓行就车拥衾不得卧","author":"汪梦斗","text":"处处风吹碧草生，流星时渡绛河明。\n上车却欲补残睡，无数树阴啼乱莺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35006,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宛平道中即事","author":"汪梦斗","text":"惊心卵石碍，劈面老沙吹。\n越见天阔处，不见云尽期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35007,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"入都门漫赋","author":"汪梦斗","text":"粉围万雉拱宸居，新邑由来草创初。\n省署朝衣杂狸鼠，市廛人迹混龙鱼。\n望时已近行难到，在处皆宽住似疏。\n草舞南风半黄碧，客窗幽坐恰便书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35008,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"简乡人丘同知舜臣","author":"汪梦斗","text":"不爱一身死，以全千里生。\n群言更廉洁，此事甚分明。\n心白天应见，官卑自莫争。\n于公厚阴德，尚欲子孙荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35009,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"见礼部尚书谢公昌言","author":"汪梦斗","text":"曾将鸿笔冠群英，自是峨眉第一人。\n执志只期东海死，伤心老作北朝臣。\n叔孙入汉仪方制，箕子归周范已陈。\n□□□□□□□，正须自爱不赀身。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35010,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"经行旧城过宣圣庙欲看石鼓不得入","author":"汪梦斗","text":"墙院人家少市声，高槐古柳绿初新。\n阴云犹阁西山雨，城郭常吹东海尘。\n杏颊簪花红照树，虫丝罗巷昼窥人。\n岐阳石鼓无由见，深锁儒宫碧草春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35011,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"端午","author":"汪梦斗","text":"辜负昌阳酒一杯，异乡节物苦相催。\n榴花未见已夏半，梅子空黄无雨来。\n下士蜀皇不复产，爱君屈子有馀哀。\n江南尽自多鱼米，好趁凉风及早回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35012,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"无题 其一","author":"汪梦斗","text":"涧边竹树绝幽香，燕坐云根写洞章。\n马上行人重回首，只知草软卧牛羊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35013,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"无题 其二","author":"汪梦斗","text":"海风吹上一天秋，独卧扁舟自在流。\n倾尽酒壶人已醉，却横长笛荻花洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35014,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上赵签推 其一","author":"汪梦斗","text":"名父由来产哲儿，一门忠孝蔼芳菲。\n自从藩府驰朱毂，久缺庭闱戏綵衣。\n兵筦少淹当遂相，樊川已得未容归。\n鲁公居外周公内，清夜相思魂梦飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35015,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上赵签推 其二","author":"汪梦斗","text":"我本郎君属部民，今朝堂上拜灵椿。\n闲闲而后无名手，寂寂之馀有此人。\n千里家书常训子，一言心事在褆身。\n仙翁若问吾州政，万碧楼空不染尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35016,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"富春方史君万里与之别七年矣离乱之后不意得聚首于此一见道旧有感 其一","author":"汪梦斗","text":"两边髯鬓雪交明，一笑何期在客京。\n此会向来随是梦，相逢喜定却还惊。\n清吟自足配严濑，狂语常忧沈石城。\n我定先还故山去，先生恰有北燕行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35017,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"富春方史君万里与之别七年矣离乱之后不意得聚首于此一见道旧有感 其二","author":"汪梦斗","text":"少年红烛照银卮，颇忆沙河共客衣。\n今说宣威麟可佩，争如华表鹤来归。\n秋香歙浦粳先熟，春早祁山笋更肥。\n茗饮萧斋客见过，旧游谈麈雪霏霏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35018,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"富春方史君万里与之别七年矣离乱之后不意得聚首于此一见道旧有感 其三","author":"汪梦斗","text":"衣冠屈辱但长吁，为笑吾徒事业迂。\n无救于亡焉用相，不知所任正非儒。\n天初生挚意有谓，人独存箕道未孤。\n迓续斯文难别诿，愿弘正学福寰区。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35019,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"暑中","author":"汪梦斗","text":"谩说江南暑郁蒸，渠知此处烈于焚。\n团蝇对面如楼子，虿蚤侵肌似锦文。\n病瘦带围宽一尺，事荒才思退三分。\n梦魂自有清凉处，还看冰衣水皱裙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35020,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书感","author":"汪梦斗","text":"驱驰万里且归休，三十馀年只漫游。\n已死舒何叫不起，霜松雪桂一山秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35021,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"丘舜臣遣人还乡托以家书时六月望因走笔寄主学胡君及士招学正诸同舍","author":"汪梦斗","text":"梦亦何曾渡白沟，今朝却作等閒游。\n横云鹤倦性犹野，嘶雨蝉哀信已秋。\n此事欲知诗尽有，西园才说肺先浮。\n归途亦及中秋月，乘兴同登何处楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35022,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"安道改授休宁尹令郎仲坦祁门尹再成小诗","author":"汪梦斗","text":"父子双飞对对凫，弦歌声接倚州闾。\n身同华表归家鹤，寿介庭闱泼瓮蛆。\n薯斸率山寒玉挺，笋披阊水小犀株。\n羹馀亲釜应分饷，为搅饥肠几卷书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35023,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"城中将相第宅树之以木殊多茂盛因忆家园有赋","author":"汪梦斗","text":"屋头花竹已成林，夺与燕山万里心。\n帝里虽云多胜宅，何须底事觅清阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35024,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"七月五夜枕上漫作悲秋一首时痔下犹未愈","author":"汪梦斗","text":"楚客悲秋已自愁，况于客病事悠悠。\n金灯对我吟清夜，苔研赚人空白头。\n犹许存名参释老，那知有道本伊周。\n风翻木叶露初下，笑指家林归去休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35025,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"巧节","author":"汪梦斗","text":"新凉溯晚风，一笑偶相同。\n有景如荒野，无云障太空。\n涓涓渠水绿，树树蓼花红。\n星会俄已过，风光叹转蓬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35026,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"羁燕四十馀日归兴殊切口占赋归 其一","author":"汪梦斗","text":"朝来收拾挂风蒲，肯效当年贱丈夫。\n尚有耕庐寄汾曲，岂无卜肆在成都。\n荷移凉意归红蓼，竹让秋声与碧梧。\n寂寞南朝亡国恨，当时为不用真儒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35027,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"羁燕四十馀日归兴殊切口占赋归 其二","author":"汪梦斗","text":"水畔斜阳万马行，柳边残雨一蝉鸣。\n催人老去何忙甚，觉我新来太瘦生。\n不死虽然如管仲，有生终是愧渊明。\n商飙愈紧归心切，莫把诗书博恶名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35028,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"羁燕四十馀日归兴殊切口占赋归 其三","author":"汪梦斗","text":"士节陵夷久可怜，谓宜作气一时伸。\n恰求谔谔廷中辩，亦似厌厌泉下人。\n身死首阳名不死，家贫陋巷道非贫。\n世推五运今何运，归去何如老海滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35029,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"羁燕四十馀日归兴殊切口占赋归 其四","author":"汪梦斗","text":"三间小屋枕山边，一缕沈烟谢老天。\n康节虽贫犹自乐，希夷当乱只高眠。\n道非日用常行外，心在吾身未有前。\n归去重参教透彻，何须更用羡神仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35030,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"羁燕四十馀日归兴殊切口占赋归 其五","author":"汪梦斗","text":"身到嬴秦古塞垣，茫茫禹迹故皆存。\n近来粤客通南货，旧日燕人祭北门。\n治极汉唐犹驳杂，功侔禹稷有根源。\n纪纲法度于何是，归醉床头老瓦盆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35031,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"羁燕四十馀日归兴殊切口占赋归 其六","author":"汪梦斗","text":"留连荒邸况栖栖，席地跧蹲四体胝。\n饮量素悭愁对酒，杀机元浅倦招棋。\n相传帝统须求正，莫使王风久下衰。\n归去林间洗双眼，暮年要看太平时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35032,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"羁燕四十馀日归兴殊切口占赋归 其七","author":"汪梦斗","text":"世道茫茫未解忧，新凉行色且归休。\n四年扰扰春如梦，五帙骎骎老转愁。\n禹贡九州行半矣，周家十乱有人不。\n浣纱云冷徽山月，不似林间乐一丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35033,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"羁燕四十馀日归兴殊切口占赋归 其八","author":"汪梦斗","text":"商量何必又商量，休笑吾人议论长。\n事欠剸裁多积压，心犹疑忌少担当。\n无由把袖舒衷愤，空负悬弧射四方。\n只恐秋风破茅屋，急归烂赏木犀香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35034,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵效都堂薰风诗","author":"汪梦斗","text":"轻飙鼓入五弦琴，都是重华育物心。\n唐殿微凉只专向，何如四海共清阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35035,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"问候赵签推","author":"汪梦斗","text":"龟畴五福属鸿儒，寿骨清强病应无。\n要识维摩今示病，当知涑水本来癯。\n心从空想尘无染，念到忘时气自苏。\n此说虽非儒所道，于中恐亦有工夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35036,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送江东李宣副之官建邺","author":"汪梦斗","text":"田里创残疚正深，望医起死息呻吟。\n神功那用千金药，妙处都由一寸心。\n剑外空遗乔木望，江东将有憩棠阴。\n十分存省新氓了，归转洪钧普作霖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35037,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"八月十四夜月食","author":"汪梦斗","text":"尽日阴云蔽太虚，夜深却见太阴亏。\n老天故露妖蟆恶，要索卢仝寸铁诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35038,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄安道","author":"汪梦斗","text":"世儒多误入旁门，默坐求心谓道尊。\n知不兼行无实力，体非有用是空言。\n穷探天命理为主，尽得人彝性自存。\n寄语寒毡分郑老，待提此话破昏昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35039,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"风起扬埃如天舞","author":"汪梦斗","text":"卷地飞埃逐晓飙，盘旋曲折势飘飖。\n筵前旧说回风舞，今见娉婷楚女腰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35040,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"别左司杜郎中","author":"汪梦斗","text":"相见匆匆即告归，江南鱼米尽堪娱。\n树林浩有秋声老，客路谁怜月影孤。\n班序自还君富贵，斋居犹著己工夫。\n他时重会无他说，敢问于仁已近无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35041,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"简杨治中","author":"汪梦斗","text":"当年北骑压杭城，奋起渡江寻旧盟。\n本拟郑侨成好去，宁知徐铉播文名。\n从班真是觉来梦，别驾犹如退步行。\n上介尚能分阃去，不应班爵独公轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35042,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"别方万里 其一","author":"汪梦斗","text":"异乡成邂逅，却是受恩深。\n白雪千丝发，青山一掬心。\n梦残横老泪，悲极辄高吟。\n此意都相似，钟期合铸金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35043,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"别方万里 其二","author":"汪梦斗","text":"门外桑乾水，我行君尚留。\n话长见恨晚，情苦意如秋。\n此道今垂绝，何人可与谋。\n临行重分首，吾教尚多忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35044,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"柯山赵公屡更麾节多在浙东西皆有美政德祐正为浙东宪入景炎犹为闽浙招捕今被召入觐从行幕客则吴元镇与朱景日武博景日向在上庠亦辱识此来所馆相去差远至是出旧城方能报元镇谒并言别故就访景日不遇却因得见招捕公蒙谦接元镇讶其无诗为贽口占三首奉呈资一笑 其一","author":"汪梦斗","text":"凄凉路入古神州，况复驱车渡白沟。\n蜀主未能重造汉，商孙不免亦侯周。\n九重注想闻犹告，五事开陈动冕旒。\n耿耿胸中有馀意，西山老碧不胜秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35045,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"柯山赵公屡更麾节多在浙东西皆有美政德祐正为浙东宪入景炎犹为闽浙招捕今被召入觐从行幕客则吴元镇与朱景日武博景日向在上庠亦辱识此来所馆相去差远至是出旧城方能报元镇谒并言别故就访景日不遇却因得见招捕公蒙谦接元镇讶其无诗为贽口占三首奉呈资一笑 其二","author":"汪梦斗","text":"遗爱曾留浙水濆，北方正自素相闻。\n长途赓唱多名笔，旧府宾僚尽富文。\n往昔知音有吴季，从来难吏是朱云。\n联镳向阙成严觐，拜得恩言定不群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35046,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"柯山赵公屡更麾节多在浙东西皆有美政德祐正为浙东宪入景炎犹为闽浙招捕今被召入觐从行幕客则吴元镇与朱景日武博景日向在上庠亦辱识此来所馆相去差远至是出旧城方能报元镇谒并言别故就访景日不遇却因得见招捕公蒙谦接元镇讶其无诗为贽口占三首奉呈资一笑 其三","author":"汪梦斗","text":"当年不得拜前呵，相遇今时可奈何。\n病骨已愁飞雪早，衰年敢谓见天多。\n既无上策裨朝论，惟有东还听壤歌。\n出处从知元有分，忍言兼善脱槃薖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35047,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]