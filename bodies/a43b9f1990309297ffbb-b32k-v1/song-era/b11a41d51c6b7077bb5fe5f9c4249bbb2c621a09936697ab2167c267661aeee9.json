[{"title":"喜晴 其四","author":"赵蕃","text":"两公贤比道州阳，总为勤民鬓已苍。\n喜雨喜晴俱有赋，乐忧宁止为诗昌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47997,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜晴 其一","author":"赵蕃","text":"雨脚昏昏扫不空，柴门未觉有春风。\n晚晴骤喜窗明处，犹倚蒲团附火红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47998,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"斯远兄入城见使君郎中且谒尚书韩先生提属李丈题诗以赠四首 其四","author":"赵蕃","text":"上饶耆旧无曾吕，月旦多称李德翁。\n闻道二难真顿有，盖公堂下求盍通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47999,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"斯远兄入城见使君郎中且谒尚书韩先生提属李丈题诗以赠四首 其三","author":"赵蕃","text":"永嘉别驾从渠说，为说钱晁好夙通。\n聊以吾云卜吾子，傥贤吾亦出蒿蓬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48000,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"斯远兄入城见使君郎中且谒尚书韩先生提属李丈题诗以赠四首 其二","author":"赵蕃","text":"南涧先生归几时，南溪如泛未传诗。\n君行为我殷勤录，并问茶山僧乞碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48001,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"斯远兄入城见使君郎中且谒尚书韩先生提属李丈题诗以赠四首 其一","author":"赵蕃","text":"雨后乘流绝快哉，眼中无适不诗材。\n诗成去觅骑鲸李，衔袖探将一笑开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48002,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"智门寺后梅开丛竹间斯远举坡公春来幽谷之句因成二绝 其二","author":"赵蕃","text":"朋游落寞每形悲，喜甚归来慰所思。\n况在水滨山崦里，两筇相对索梅诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48003,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"智门寺后梅开丛竹间斯远举坡公春来幽谷之句因成二绝 其一","author":"赵蕃","text":"花开的皪固难知，旧识黄州副使诗。\n政使尽开能尔盛，孰知将吐乃为奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48004,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"曾秀才送茶","author":"赵蕃","text":"正尔耽诗不耐閒，镜中频觉瘦栾栾。\n曾郎惠我尽清供，椀把春风香并兰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48005,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"曾相士约过意钓答以绝句","author":"赵蕃","text":"为竹作亭还斫竹，取诗名榜更题诗。\n归来十日未一往，聊待萧然雨后时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48006,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"曾裘父寄二绝并呈审知一再次韵前以寄曾后寄审知四首 其四","author":"赵蕃","text":"南丰鬓发已如翁，子盖他时冰雪容。\n长少结交端有道，我凡何处滥登龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48007,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"曾裘父寄二绝并呈审知一再次韵前以寄曾后寄审知四首 其三","author":"赵蕃","text":"安否别来端若何，尺书可是雁无过。\n南丰惠我新诗什，亦复怀君旧琢磨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48008,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"曾裘父寄二绝并呈审知一再次韵前以寄曾后寄审知四首 其二","author":"赵蕃","text":"纷纷竞说杜陵翁，此老真能数百容。\n我亦几同叶公好，骇然今日见真龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48009,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"曾裘父寄二绝并呈审知一再次韵前以寄曾后寄审知四首 其一","author":"赵蕃","text":"向来共和有羊何，今见公才十倍过。\n可念此身如垢镜，要须著手为揩磨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48010,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游叫岩用范元卿自普康归日留题韵","author":"赵蕃","text":"溪行又作叫岩登，凉冷端如快踏冰。\n所过有山成一访，是知我亦在家僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48011,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游仰山欲游兰若不果怀混融二首 其二","author":"赵蕃","text":"欲寻兰若尉知名，獭径桥头水乱鸣。\n引领白云人甚远，纵游谁解饮渊明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48012,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游仰山欲游兰若不果怀混融二首 其一","author":"赵蕃","text":"冒雨来看大仰山，不惟泉石意相关。\n混融时事谁能说，稍向诗碑见一班。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48013,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游思庵","author":"赵蕃","text":"路落林湾得小庵，轩窗都在万松间。\n兹游不为寻僧至，更拟缘云度一山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48014,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"湖州舟中","author":"赵蕃","text":"平生苕霅又扁舟，尚喜深盟不负鸥。\n忆昔诗篇浑漫兴，祇今翻觉费冥搜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48015,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"琛卿为梅置酒用前韵","author":"赵蕃","text":"背荫初疑星未融，细看真有映玲珑。\n兴深且约诸君往，明日当愁著土中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48016,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"琛卿论诗用前韵示之","author":"赵蕃","text":"活法端知自结融，可须琢刻见玲珑。\n涪翁不作东莱死，安得斯文日再中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48017,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登安仁云锦驿后挹仙亭三首 其三","author":"赵蕃","text":"对面雨来山欲移，援毫我亦赋新诗。\n扁舟纵是促行去，不废小亭筇一枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48018,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登安仁云锦驿后挹仙亭三首 其二","author":"赵蕃","text":"未解桃源果有无，树林楼阁世行图。\n此亭纵说空无物，犹有仙山来坐隅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48019,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登安仁云锦驿后挹仙亭三首 其一","author":"赵蕃","text":"古木阴中屋数椽，下临萦折几山川。\n晚来快雨仍新浴，端觉飘飘意欲仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48020,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登县楼有感二首 其二","author":"赵蕃","text":"见说南楼秋气多，夜凉槐竹影婆娑。\n满楼风月成辜负，奈此青州从事何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48021,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登县楼有感二首 其一","author":"赵蕃","text":"一水中分南北市，插天蒙末有佳山。\n太平官府元无事，聊放衰翁一日閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48022,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登岳阳楼 其四","author":"赵蕃","text":"晚风何许递参差，南望令人思九疑。\n渺渺烟波莫能极，谁云一苇可杭之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48023,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登岳阳楼 其三","author":"赵蕃","text":"几思假日赋登楼，风雨连连不肯休。\n待得晴时又成去，再三举手谢沙鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48024,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登岳阳楼 其二","author":"赵蕃","text":"自昔骚人半此州，不因放逐即淹留。\n我今毋负仍非客，何事汎然还一游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48025,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登岳阳楼 其一","author":"赵蕃","text":"太史南游上会稽，爱奇端欲助文辞。\n萧骚白发离骚国，不到巴陵终欠诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48026,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登清虚亭","author":"赵蕃","text":"步上危亭欲细看，忽惊风雨暗江干。\n此身不作蛮州鬼，犹拟扶筇再倚栏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48027,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答施荣甫","author":"赵蕃","text":"昨韵村中好客稀，今吟临水送将归。\n笑谈未了风吹断，何日重来款竹扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48028,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答简审知","author":"赵蕃","text":"早起难胜上水寒，为君还复念湖滩。\n泥滑蹇驴难跨去，七言聊遣问平安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48029,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"腊月十九日饮于周氏无尽藏雪作","author":"赵蕃","text":"卯饮君家江上楼，坐中风雪暗前洲。\n世间矰缴无空巧，我自归心没白鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48030,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舒村","author":"赵蕃","text":"有竹如椽故可佳，况于竹外隐鸥沙。\n不嫌官道多车马，此地端宜著钓车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48031,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"落叶","author":"赵蕃","text":"捲捲从何起，多因为晚风。\n飘飘久不下，还复反荒丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48032,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢人送水仙","author":"赵蕃","text":"珍重江南好事家，老将种莳作生涯。\n似怜寂寞书斋里，折赠盈篮栗玉花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06