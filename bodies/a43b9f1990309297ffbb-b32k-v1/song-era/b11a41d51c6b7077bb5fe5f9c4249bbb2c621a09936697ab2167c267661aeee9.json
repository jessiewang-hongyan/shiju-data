6858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48058,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"滩头寺怀莫升之","author":"赵蕃","text":"青衫县尹沈泉久，黄绶尉曹华发多。\n重到滩头旧游寺，一觞独举奈愁何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48059,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"简见可觅画三首 其三","author":"赵蕃","text":"少文忘却行山脚，收拾经行入坐中。\n我亦江山欲归去，自无画手得君工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48060,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"简见可觅画三首 其二","author":"赵蕃","text":"白头流落离骚国，香草虽多独嗜兰。\n犹恨芳时有衰歇，要须貌取四时看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48061,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"简见可觅画三首 其一","author":"赵蕃","text":"我居何有惟脩竹，一日真成不可无。\n别后平安久无报，为予十日写成图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48062,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"简全真二首 其二","author":"赵蕃","text":"我诗每觉就匆匆，君句由来咏叹中。\n爱我更能怜我友，谁云南北马牛风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48063,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"简全真二首 其一","author":"赵蕃","text":"捐弃悲歌咏白团，未忘卫霍内金盘。\n要知公子貂裘煖，孰若山人短褐寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48064,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"简邢公昭丈","author":"赵蕃","text":"梅园想见绿增深，竹径遥知笋出林。\n坐底未能成一出，祇缘多病与多阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48065,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"简严先辈","author":"赵蕃","text":"闻道君家绿萼梅，韵胜绛袂拥冰肌。\n夜来一雨应堪折，好寄尘窗伴觅诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48066,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"简严承务二首 其二","author":"赵蕃","text":"霜髭不摘老可憎，迹虽未然心已僧。\n舌根鼻观习气在，茗椀策勋香事仍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48067,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"简严承务二首 其一","author":"赵蕃","text":"玉梅遭旱颇萧然，清润思逢得水仙。\n出门一笑不易致，许送茅斋端可怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48068,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"简沈沅陵求潮州韩文公庙碑并抄山谷碑诗二首 其二","author":"赵蕃","text":"涪翁昔在黔戎贬，逸翰遗章久更多。\n字画公今元祐脚，拟烦妙手定如何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48069,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"简沈沅陵求潮州韩文公庙碑并抄山谷碑诗二首 其一","author":"赵蕃","text":"公曾数载潮阳掾，笔力怪来韩与苏。\n璧上庙碑当乞我，庶求涓滴润焦枯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48070,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"简陈择之索诗","author":"赵蕃","text":"游山闻说多诗句，久已传抄听小胥。\n屡戒应门老马走，门前驿递不为疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48071,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"简周允升三首 其三","author":"赵蕃","text":"君为乡校长，我政旅人居。\n借屋元相近，相过莫放疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48072,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"简周允升三首 其二","author":"赵蕃","text":"春来多睡思，茗椀亦时须。\n不敢家园乞，芭蕉有剩无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48073,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"简周允升三首 其一","author":"赵蕃","text":"相逢亡恙外，第一问书堂。\n为说当年树，如人出屋长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48074,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]