[{"title":"和费君乐游山之什","author":"周敦颐","text":"云树岩泉景尽奇，登临深恨访寻迟。\n长楼未得于何记，犹有君能雅和诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25965,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"牧童","author":"周敦颐","text":"东风放牧出长坡，谁识阿童乐趣多。\n归路转鞭牛背上，笛声吹老太平歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25966,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"剑门","author":"周敦颐","text":"剑立溪峰信险深，吾皇大道正天心。\n百年外户都无闭，空有关名点贡琛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25967,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"按部至潮州题大颠堂壁","author":"周敦颐","text":"退之自谓如夫子，原道深排释老非。\n不识大颠何似者，数书珍重更留衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25968,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春晚","author":"周敦颐","text":"花落柴门掩夕晖，昏鸦数点傍林飞。\n吟馀小立阑干外，遥见樵渔一路归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25969,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读易象","author":"周敦颐","text":"书房兀坐万机休，日暖风和草色幽。\n谁道二千年远事，而今只在眼前头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25970,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜同费君长官游","author":"周敦颐","text":"寻山寻水侣尤难，爱利爱名心少閒。\n此亦有君吾甚乐，不辞高远共跻攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25971,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游山上一道观三佛寺","author":"周敦颐","text":"琳宫金刹接林峦，一径潜通竹树寒。\n是处尘埃皆可息，时清终未忍辞官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25972,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题酆都观 仙都观","author":"周敦颐","text":"山盘江上虬龙活，殿倚云中洞府深。\n钦想真风杳何在，偃松乔柏共萧森。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25973,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题酆都观 读英真君丹诀","author":"周敦颐","text":"始观丹诀信希夷，盖得阴阳造化机。\n子自母生能致主，精神合后更知微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25974,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题酆都观 宿山房","author":"周敦颐","text":"久厌尘坌乐静元，俸微犹乏买山钱。\n徘徊真境不能去，且寄云房一榻眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25975,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"忆江西提刑何仲容","author":"周敦颐","text":"兰自香为友，松何枯尚春。\n荣来天泽重，殁去绣衣新。\n尽作百年梦，终归一窖尘。\n痛心双泪下，无复见贤人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25976,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"治平乙巳暮春十四日同宋复古游山巅至大林寺书四十字","author":"周敦颐","text":"三月山方暖，林花互照明。\n路盘层顶上，人在半空行。\n水色云含白，禽声谷应清。\n天风拂襟袂，缥缈觉身轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25977,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"思归旧隐","author":"周敦颐","text":"静思归旧隐，日出半山晴。\n醉榻云笼润，吟窗瀑泻清。\n闲方为达士，忙只是劳生。\n朝市谁头白，车轮未晓鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25978,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"按部至春州","author":"周敦颐","text":"按部广东经数郡，若言岚瘴更无春。\n度山烟锁埋清昼，为国天终护吉人。\n万里诏音频降下，一方恩惠尽均匀。\n丈夫才略逢时展，仓廪皆无亟富民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25979,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题冠顺之道院壁","author":"周敦颐","text":"一日复一日，一杯复一杯。\n青山无限好，俗客不曾来。\n往事已如此，朱颜安在哉。\n寄语地上客，历乱竟谁催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25980,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠虞部员外郎谭公昉致仕","author":"周敦颐","text":"清时望郎贵，白首故乡归。\n有子纡蓝绶，将孙著綵衣。\n松乔新道院，鹤老旧渔矶。\n知止自高德，宁为遁者肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25981,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"万安香城寺别虔守赵公","author":"周敦颐","text":"公暇频陪尘外游，朝天仍得送行舟。\n轩车更共入山脚，旌旆且从留渡头。\n精舍泉声清㶁㶁，高林云色淡悠悠。\n谈终道奥愁言去，明日瞻思上郡楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25982,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山北纪行十二章章八句 其五","author":"朱熹","text":"斯须暮云合，白日无馀晖。\n金波从地涌，宝燄穿林飞。\n僧言自雄誇，俗骇无因依。\n安知本地灵，发见随天机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25983,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"石塘桥晚钓","author":"周敦颐","text":"旧隐濂溪上，思归复思归。\n钓鱼船好睡，宠辱不相随。\n肯为爵禄重，白发犹羁縻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25984,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"任所寄乡关故旧","author":"周敦颐","text":"老子生来骨性寒，宦情不改旧儒酸。\n停杯厌饮香醪味，举箸常餐淡菜盘。\n事冗不知筋力倦，官清赢得梦魂安。\n故人欲问吾何况，为道舂陵只一般。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25985,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同石守游","author":"周敦颐","text":"朝市谁知世外游，杉松影里入吟幽。\n争名逐利千绳缚，度水登山万事休。\n野鸟不惊如得伴，白云无语似相留。\n傍人莫笑凭阑久，为恋林居作退谋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25986,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜雨书窗","author":"周敦颐","text":"秋风拂尽热，半夜雨淋漓。\n绕屋是芭蕉，一枕万响围。\n恰似钓鱼船，篷底睡觉时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25987,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题浩然阁","author":"周敦颐","text":"刘侯戴武弁，政则心吾儒。\n士茂先兴学，子贤勤读书。\n猷为莫不善，才力盖有馀。\n西北方求帅，浩然宁久居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25988,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题清芬阁","author":"周敦颐","text":"风雅久沦落，哇淫肆自陈。\n波澜嗟已靡，汗漫□无津。\n纷葩混仙蕊，谁可识清真。\n先生李郑辈，□态非拟伦。\n后生不识事，愈非句愈珍。\n至今桐庐水，相与流清新。\n蝉联十一世，奕叶扶阳春。\n十年问御史，邂逅章江滨。\n自惭无所有，衰叹徒欣欣。\n樽酒发狂笑，微言入典坟。\n稍稍窥绪馀，每每露经纶。\n因知相有术，源委本清淳。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25989,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"瀼溪书堂","author":"周敦颐","text":"元子溪曰瀼，诗传到于今。\n此俗良易化，不欺顾相钦。\n庐山我久爱，买田山之阴。\n田间有流水，清泚出山心。\n山心无尘土，白石磷磷沈。\n潺湲来数里，到此始澄深。\n有龙不可测，岸木寒森森。\n书堂构其上，隐几看云岑。\n倚梧或攲枕，风月盈中襟。\n或吟或冥默，或酒或鸣琴。\n数十黄卷轴，圣贤谈无音。\n窗前即畴囿，囿外桑麻林。\n芋蔬可卒岁，绢布足衣衾。\n饱煖大富贵，康宁无价金。\n吾乐盖易足，名濂朝暮箴。\n元子与周子，相邀风月寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25990,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游庐山南阜步月回寓馆","author":"周登","text":"不入山中不识闲，不因月上不知还。\n老僧长揖归方丈，只有钟声送出山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25991,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泛舟西湖","author":"周登","text":"湖边无日欠春风，金碧楼台面面同。\n白鸟惯随船上下，画桥分断水西东。\n百年乐事浮云外，一段伤心落照中。\n老尽风流无问处，藕花今是几番红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25992,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寒食前五日作二绝 其二","author":"周紫芝","text":"寒食风埃满客巾，西湖烟雨送愁频。\n日高未起鸟呼梦，春晚不归花笑人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25993,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"五禽言 其五 布谷","author":"周紫芝","text":"田中水涓涓，布谷催种田，贼今在邑农在山。\n但愿今年贼去早，春田处处无荒草。\n农夫呼妇出山来，深种春秧答飞鸟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25994,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"五禽言 其三 提壶卢","author":"周紫芝","text":"提壶卢，树头劝酒声相呼，劝人沽酒无处沽。\n太岁何年当在酉，敲门问浆还得酒。\n田中黍穗处处黄，瓮头新绿家家有。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25995,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"五禽言 其一 婆饼焦","author":"周紫芝","text":"云穰穰，麦穗黄，婆饼欲焦新麦香。\n今年麦熟不敢尝，斗量车载倾囷仓，化作三军马上粮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25996,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"一剪梅 送杨师醇赴官","author":"周紫芝","text":"无限江山无限愁。\n两岸斜阳，人上扁舟。\n阑干吹浪不多时，酒在离尊，情满沧洲。\n早是霜华两鬓秋。\n目送飞鸿，那更难留。\n问君尺素几时来，莫道长江，不解西流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25997,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"卜算子 其二 再和彦猷","author":"周紫芝","text":"霜叶下孤篷，船在垂杨岸。\n早是凄凉惜别时，更惜年华换。\n别酒解留人，拚醉君休管。\n醉里朱弦莫谩弹，愁入参差雁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25998,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"卜算子 其三 西窗见剪榴花","author":"周紫芝","text":"絮尽柳成空，春去花如扫。\n窗外枝枝海石榴，特为幽人好。\n密叶过疏篱，薄艳明芳草。\n剪得花时却倚阑，楼上人垂手。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25999,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"卜算子 其一 席上送王彦猷","author":"周紫芝","text":"江北上归舟，再见江南岸。\n江北江南几度秋，梦里朱颜换。\n人是岭头云，聚散天谁管。\n君似孤云何处归，我似离群雁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26000,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"千秋岁 其一 生日","author":"周紫芝","text":"小春时候。\n晴日吴山秀。\n霜尚浅，梅先透。\n波翻醽醁盏，雾暖芙蓉绣。\n持寿酒。\n仙娥特地回双袖。\n试问春多少，恩入芝兰厚。\n松不老，山长久。\n星占南极远，家是椒房旧。\n君一笑，金鸾看取人归后。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26001,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"千秋岁 其二 叶审言生日","author":"周紫芝","text":"当年文焰，蜀锦词华烂。\n年正少，声初远。\n手攀天上桂，书奏蓬莱殿。\n人尽道，洛阳盛事今重见。\n千尺青苍干。\n直节凌霄汉。\n天未识，应嗟晚。\n饮残长寿盏，归奉春皇燕。\n金叶满。\n擗麟且受麻姑劝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26002,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"千秋岁 其三 春欲去，二妙老人戏作长短句留之，为社中一笑","author":"周紫芝","text":"送春归去。\n说与愁无数。\n君去后，归何处。\n人应空懊恼，春亦无言语。\n寒日暮，腾腾醉梦随风絮。\n尽日间庭雨。\n红湿秋千柱。\n人恨切，莺声苦。\n拟倾浇闷酒，留取残红树。\n春去也，不成不为愁人住。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26003,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小重山 其二 方元相生日","author":"周紫芝","text":"碧玉山围十里湖。\n水云天共远，戏双凫。\n河阳花县锦屏铺。\n人不老，长日在蓬壶。\n一笑且踟蹰。\n会骑箕尾去，上云衢。\n十分深注碧琳腴。\n休惜醉，醉后有人扶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26004,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小重山 其一","author":"周紫芝","text":"溪上晴山簇翠螺。\n晓来霜叶醉，小池荷。\n琐窗秋意苦无多。\n帘绣卷，黄菊两三窠。\n小睡拥香罗。\n起来匀醉粉，玉垂梭。\n只愁无奈夜长何。\n你去也，今夜早来么。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26005,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"天仙子","author":"周紫芝","text":"雪似杨花飞不定。\n枝上冻禽昏欲暝。\n寒窗相对话分飞，箫鼓静。\n灯炯炯。\n一曲阳关和泪听。\n酒入离肠愁欲凝。\n往事不堪重记省。\n劝君莫上玉楼梯，风力劲。\n山色暝。\n忍看去时楼下径。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26006,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"忆王孙 绝笔","author":"周紫芝","text":"梅子生时春渐老。\n红满地、落花谁扫。\n旧年池馆不归来，又绿尽、今年草。\n思量千里乡关道。\n山共水、几时得到。\n杜鹃只解怨残春，也不管、人烦恼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26007,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"木兰花/玉楼春 其一 长安狭邪中，有高自标置者，客非新科不得其门，时颇称之。予尝语人曰：相马失之肥，相士失之瘦，世亦岂可以是论人物乎！戏作此词，为花衢狭客一笑","author":"周紫芝","text":"嫦娥天上人谁识。\n家在蓬山烟水隔。\n不应著意眼前人，便是登瀛当日客。\n双眸炯炯秋波滴。\n也解人间青与白。\n檀郎未摘月边枝，枉是不教花爱惜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26008,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"木兰花/玉楼春 其二","author":"周紫芝","text":"江头雨后山如髻。\n催送新凉风有意。\n月来杨柳绿阴中，秋在梧桐疏影外。\n小窗纹簟凉如水。\n岁岁年年同此味。\n眼前不忍对西风，梦里更堪追往事。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26009,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水龙吟 其二 题梦云轩","author":"周紫芝","text":"楚山千叠浮空，楚云只在巫山住。\n鸾飞凤舞，当时空记，梦中奇语。\n晓日曈昽，夕阳零乱，袅红萦素。\n问如今依旧，霏霏冉冉，知他为、谁朝暮。\n玉佩烟鬟飞动，炯星眸、人间相遇。\n嫣然一笑，阳城下蔡，尽成惊顾。\n蕙帐春浓，兰衾日暖，未成行雨。\n但丁宁莫似，阳台梦断，又随风去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26010,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水龙吟 其三 须江望九华作","author":"周紫芝","text":"楚山木落风高，暮云黯黯孤容瘦。\n天晴似洗，明霞消尽，玉峦排秀。\n九凤飞来，五云深处，一时轻矫。\n恨三山不见，六鳌去后，天空远，人将老。\n堪笑此生如寄，信扁舟、朅来江表。\n望中愁眼，依稀犹认，数峰林杪。\n万里东南，跨江云梦，此情多少。\n问何时还我，千岩万壑，卧霜天晓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26011,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水龙吟 其一 天申节祝圣词","author":"周紫芝","text":"黄金双阙横空，望中隐约三山眇。\n春皇欲降，渚烟收尽，青虹正绕。\n日到层霄，九枝光满，普天俱照。\n看海中桃熟，云幡绛节，冉冉度、沧波渺。\n遥想建章宫阙，□熏风、月寒清晓。\n红鸾影上，云韶声里，蒙天一笑。\n万国朝元，百蛮款塞，太平多少。\n听尧云深处，人人尽祝，似天难老。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26012,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水调歌头 其三 丙午登白鹭亭作","author":"周紫芝","text":"岁晚念行役，江阔渺风烟。\n六朝文物何在，回首更凄然。\n倚尽危楼杰观，暗想琼枝璧月，罗袜步承莲。\n桃叶山前鹭，无语下寒滩。\n潮寂寞，浸孤垒，涨平川。\n莫愁艇子何处，烟树杳无边。\n王谢堂前双燕，空绕乌衣门巷，斜日草连天。\n只有台城月，千古照婵娟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26013,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水调歌头 其二 王次卿归自彭门，中秋步月作","author":"周紫芝","text":"濯锦桥边月，几度照中秋。\n年年此夜清景，伴我与君游。\n万里相随何处，看尽吴波越嶂，更向古徐州。\n应为霜髯老，西望倚黄楼。\n天如水，云似扫，素魂流。\n不知今夕何夕，相对语羁愁。\n故国归来何事，记易南枝惊鹊，还对玉蟾羞。\n踏尽疏桐影，更复为君留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26014,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水调歌头 其四 雨后月出西湖作","author":"周紫芝","text":"落日在烟树，云水两空濛。\n澹霞消尽，何事依约有微红。\n湖上晚来风细，吹尽一天残雨，苍翠湿千峰。\n谁遣长空月，冷浸玉壶中。\n问明月，应解笑，白头翁。\n不堪老去，依旧临水照衰容。\n良夜几横烟棹，独倚危樯西望，目断远山重。\n但恨故人远，此乐与谁同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26015,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"风入松","author":"周紫芝","text":"禁烟过后落花天。\n无奈轻寒。\n东风不管春归去，共残红、飞上秋千。\n看尽天涯芳草，春愁堆在阑干。\n楚江横断夕阳边。\n无限青烟。\n旧时云去今何处，山无数、柳涨平川。\n与问风前回雁，甚时吹过江南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26016,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"永遇乐 五日","author":"周紫芝","text":"槐幄如云，燕泥犹湿，雨馀清暑。\n细草摇风，小荷擎雨，时节还端午。\n碧罗窗底，依稀记得，闲系翠丝烟缕。\n到如今、前欢如梦，还对彩绦无语。\n榴花半吐，金刀犹在，往事更堪重数。\n艾虎钗头，菖蒲酒里，旧约浑无据。\n轻衫如雾，玉肌似削，人在画楼深处。\n想灵符、无人共带，翠眉暗聚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26017,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"汉宫春 其二 别乘赵李成以山谷道人反魂梅香材见遗","author":"周紫芝","text":"香满箱奁，看沈犀弄水，浓麝含薰。\n荀郎一时旧事，尽属王孙。\n残膏剩馥，须倾囊、乞与兰荪。\n金兽暖，云窗雾阁，为人洗尽馀醺。\n依稀雪梅风味，似孤山尽处，马上烟村。\n从来甲煎浅俗，那忍重闻。\n苏台燕寝，下重帏、深闭孤云。\n都占得，横斜乱影，伴他月下黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26018,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"汉宫春 其一 己未中秋作","author":"周紫芝","text":"秋意还深，渐银床露冷，梧叶风高。\n婵娟也应为我，羞照霜毛。\n流年老尽，漫银蟾、冷浸香醪。\n除尽把，平生怨感，一时分付离骚。\n伤心故人千里，问阴晴何处，还记今宵。\n楼高共谁同看，玉桂烟梢。\n南枝鹊绕，叹此生、飘转江皋。\n须更约，他年清照，为人常到寒霄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26019,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"生查子 其四","author":"周紫芝","text":"清歌忆去年，共唱秦楼曲。\n门外月横波，帐里人如玉。\n秋风吹彩云，梦断惊难续。\n别调不堪闻，红泪销残烛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26020,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"生查子 其一","author":"周紫芝","text":"春寒入翠帷，月淡云来去。\n院落半晴天，风撼梨花树。\n人醉掩金铺，闲倚秋千柱。\n满眼是相思，无说相思处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26021,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"生查子 其六","author":"周紫芝","text":"轻云浅护霜，晓日红生砌。\n烟共宝薰浓，人与山长翠。\n银浪酒杯浓，锦幄双鸾戏。\n庭下彩衣郎，共祝千千岁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26022,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"生查子 其五","author":"周紫芝","text":"金鞍欲别时，芳草溪边渡。\n不忍上西楼，怕看来时路。\n帘幕卷东风，燕子双双语。\n薄幸不归来，冷落春情绪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26023,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"生查子 其三","author":"周紫芝","text":"新欢君未成，往事无人记。\n行雨共行云，如梦还如醉。\n相见又难言，欲住浑无计。\n眉翠莫频低，我已无多泪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26024,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"生查子 其二","author":"周紫芝","text":"青丝结晓鬟，临镜心情懒。\n知为晓愁浓，画得双蛾浅。\n柳困玉楼空，花落红窗暖。\n相对语春愁，只有春闺燕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26025,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"好事近 其二 谢人分似蜡梅一枝","author":"周紫芝","text":"香蜡染宫黄，不属世间风月。\n分我照寒金蕊，伴小窗愁绝。\n高标独步本无双，一枝为谁折。\n压尽半春桃李，任满山如雪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26026,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]