[{"title":"题赵团练画江干晚景四绝 其三","author":"秦观","text":"公子歌钟里，何从识渺茫。\n惟应斗帐梦，曾到水云乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58533,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题赵团练画江干晚景四绝 其二","author":"秦观","text":"鸟外云峰晚，沙头草树晴。\n想初挥洒就，侍女一齐惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58534,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题赵团练画江干晚景四绝 其一","author":"秦观","text":"本自江湖客，宦游常苦心。\n看君小平远，怀我旧登临。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58535,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题赵团练画江干晚景四绝 其四","author":"秦观","text":"晓浦烟笼树，春江水拍空。\n烦君添小艇，画我作渔翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58536,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题郴阳道中一古寺壁二绝 其二","author":"秦观","text":"哀歌巫女隔祠丛，饥鼠相追坏壁中。\n北客念家浑不睡，荒山一夜雨吹风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58537,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题郴阳道中一古寺壁二绝 其一","author":"秦观","text":"门掩荒寒僧未归，萧萧庭菊两三枝。\n行人到此无肠断，问尔黄花知不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58538,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九月八日夜大风雨寄王定国","author":"秦观","text":"长年身外事都捐，节物惊心一怅然。\n正是山川秋入梦，可堪风雨夜连天。\n桐梢摵摵增悽断，灯烬飞飞落小圆。\n湔洗此情须痛饮，明朝试就酒中仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58539,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与李端叔游智海用前韵","author":"秦观","text":"点目谁能化两龙，超然想见古人风。\n红尘稍与僧家远，白发偏于我辈公。\n休计浮名千载后，且欣汤饼一杯同。\n何时并筑邗沟上，引水浇花半亩宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58540,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"大行太皇太后挽词二首 其二","author":"秦观","text":"保扶明主自春宫，万国升平出至公。\n顾命一时聊共政，思齐千古遂同风。\n外家恩数仍长信，原庙蒸尝即治隆。\n欲叙圣功歌挽者，乾坤难入画图中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58541,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"大行太皇太后挽词二首 其一","author":"秦观","text":"东朝制诏九年称，烈武功高后世兴。\n坐举不周天柱正，亲扶旸谷日车升。\n班行尚想延和殿，羽卫俄趋永厚陵。\n洛水嵩峰霄汉外，百官西望涕难胜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58542,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"广陵五题 其一 次韵子由题九曲池","author":"秦观","text":"萧瑟通池閟茂林，岸傍无复属车音。\n涵春似恨隋家远，涨晓疑连蜀井深。\n斗草事空烟冉冉，司花人远树阴阴。\n劳生俛仰成陈迹，纵有遗声可用寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58543,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"广陵五题 其三 次韵子由题蜀井","author":"秦观","text":"蜀冈精气滀多年，故有清泉发石田。\n乍饮肺肝俱澡雪，久窥杖屦亦轻便。\n炊成香稻流珠滑，煮出新茶泼乳鲜。\n坐使二公乡思动，放杯西望欲挥鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58544,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"广陵五题 其五 次韵子由题光化塔","author":"秦观","text":"古佛悲怜得度人，应缘来现比丘身。\n水流月落知何处，花发莺啼又一春。\n方外笑谈清似玉，梦中烦恼细如尘。\n老僧自说从居此，却悔平时事远巡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58545,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"广陵五题 其四 次韵子由题摘星亭","author":"秦观","text":"昆崙左右两招提，中起孤高雉堞西。\n不见烧香成宿雾，虚传裁锦作障泥。\n萤流花苑飞星乱，芜满春城绿发齐。\n长忆凭栏风雨后，断虹明处海天低。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58546,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中书侍郎挽词二首 其二","author":"秦观","text":"守道无夷险，如公实寡仇。\n望从乌府重，官到凤池休。\n二品追褒峻，千金赙恤优。\n搢绅终有恨，王骏不封侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58547,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中书侍郎挽词二首 其一","author":"秦观","text":"崛起商岩后，清忠士论归。\n法知商鞅弊，议折董宏非。\n迁谪生华发，骞腾上紫微。\n又骑箕尾去，朝野涕空挥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58548,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中秋口号","author":"秦观","text":"云山檐楯接低空，公宴初开气郁葱。\n照海旌幢秋色里，激天鼓吹月明中。\n香槽旋滴珠千颗，歌扇惊围玉一丛。\n二十四桥人望处，台星正在广寒宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58549,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"文英阁二首 其二","author":"秦观","text":"流落天涯思故园，散愁郊外任蹒跚。\n云归邃谷知无雨，风卷寒溪没近滩。\n已见雁将归楚泽，遥知春又到长安。\n桑林垄麦依稀是，祇见秦川万里宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58550,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"文英阁二首 其一","author":"秦观","text":"都门将酒惜分携，归路骎骎望欲迷。\n千里又看新燕语，一声初听子规啼。\n春风天上曾挥翰，迟日江边独杖藜。\n回首三山楼阁晚，断云流水自东去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58551,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东平夫人挽章","author":"秦观","text":"相阀风流盛，王家地势雄。\n室中兰作佩，庭下玉成丛。\n啼鸟悲春槛，荒原入夜宫。\n遗芳得鸿笔，论次诏无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58552,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"对淮南诏狱二首 其二","author":"秦观","text":"淮海行摇落，文书亦罢休。\n风霜欺独宿，灯火伴冥搜。\n笳动朱楼晓，参横粉堞秋。\n更拚飞镜破，应得大刀头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58553,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"对淮南诏狱二首 其一","author":"秦观","text":"一室如悬磬，人音尽不闻。\n老兵随卧起，漂母给朝曛。\n樊雉思秋野，鞲鹰望暮云。\n念归忘食事，日减臂环分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58554,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"永寿县君挽词二首 其二","author":"秦观","text":"明世辞隆养，哀荣道路传。\n赙丧从上宰，歌挽出群仙。\n素幔伤秋泛，青缸惨夜船。\n玉峰归葬处，木拱雁连天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58555,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"永寿县君挽词二首 其一","author":"秦观","text":"廷尉蒙恩后，兰台就养初。\n大椿宜更寿，流水遽焉如。\n鸾锦封花诰，蛛丝网板舆。\n百年谁考德，琬琰在幽墟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58556,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"白鹤观","author":"黄庭坚","text":"复殿重楼堕杳冥，故基乔木尚峥嵘。\n银河不改三千尺，铁马曾经十万兵。\n华表故应终化鹤，谪仙未解独骑鲸。\n林泉一二儿童旧，白发衰颜只自惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58557,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"会蓬莱阁","author":"秦观","text":"冠裳盖座洒清风，轩外时闻韵箨龙。\n人面春生红玉液，银盘烟覆紫驼峰。\n天涵秋色山山共，树搅乡思叶叶重。\n便欲买船江北去，为怀明德更从容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58558,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吕与叔挽章四首 其二","author":"秦观","text":"数日音容隔，人琴遂已虚。\n门生应有谥，国史可无书。\n旧室悬蛛网，遗编走蠹鱼。\n定无封禅草，平日笑相如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58559,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吕与叔挽章四首 其一","author":"秦观","text":"举举西州士，来为邦国华。\n艺文尤尔雅，经术自名家。\n正有高山仰，俄成逝水嗟。\n贤人各有数，不独岁龙蛇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58560,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"庆张君俞都尉留后得子","author":"秦观","text":"天上吹箫玉作楼，蟠桃熟后更无忧。\n内家报喜车凌晓，太史占祥斗挂秋。\n龙得一珠应献佛，虎生三日便吞牛。\n鲁元福禄何人似，坐见张敖数子侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58561,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵子由题斗野亭","author":"秦观","text":"满市花风起，平堤漕水流。\n不堪春解手，更为晚停舟。\n古埭天连雁，荒祠木蔽牛。\n杖藜聊复尔，转盼夕烟浮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58562,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵子瞻赠金山宝觉大师","author":"秦观","text":"云峰一变隔炎凉，犹喜重来饭积香。\n宿鸟水干迎晓闹，乱帆天际受风忙。\n青鞋踏雨寻幽径，朱火笼纱语上方。\n珍重故人敦妙契，自怜身世两微茫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58563,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵马忠玉喜王定国还自滨州","author":"秦观","text":"淮海相逢一解颜，纷纷岁月梦魂间。\n初惊渔艇迷花去，忽认星槎拂斗还。\n桂岭暮登猿断续，槐堂春到鸟绵蛮。\n石渠旧议行当复，未信佳时得自闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58564,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵公辟会流觞亭","author":"秦观","text":"偷引湖光一派飞，咏觞还却似当时。\n吴歌送酒随流急，越艳浮花转曲池。\n山庙早因前守彻，冰盘元是故工遗。\n年年禊饮今非昔，不到兰亭到北池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58565,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵公辟会蓬莱阁","author":"秦观","text":"林声摵摵动秋风，共蹑丹梯上卧龙。\n路隔西陵三两水，门临南镇一千峰。\n湖吞碧落诗争发，塔涌青冥画几重。\n非是登高能赋客，可怜猿鹤自相容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58566,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵公辟州宅月夜偶成 其一","author":"秦观","text":"新秋过雨月如霜，缓足蓬莱彻上方。\n翠木玲珑藏宝界，白烟浓淡锁华堂。\n书名越艳谁兴发，角动单于自感伤。\n山似卧龙天似水，却疑身在海中央。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58567,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵公辟州宅月夜偶成 其二","author":"秦观","text":"缭绕千重雨后凉，月含秋色上东方。\n风催络纾归金井，月转檀栾荫画堂。\n游目骋怀佳兴发，感时抚事壮心伤。\n归来枕簟清无梦，卧看明星到未央。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58568,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵公辟即席呈太虚","author":"秦观","text":"与君邻并共烟霞，乘兴时时过我家。\n更漏一新闻晓角，门阑数级看秋花。\n湖山对值全如买，风月相期不用赊。\n赖有醉毫吟更苦，他年分作句图誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58569,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵公辟将受代书蓬莱阁","author":"秦观","text":"城连湖岸水为关，旦暮樵风自往还。\n龟负宝林新佛地，龙蟠使宅老仙山。\n平生仕宦今何得，终日登临独未闲。\n岁满徘徊难遽别，就中潇洒异人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58570,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵公辟闻角有感","author":"秦观","text":"一听胡笳动越吟，声潜地底气逾深。\n千宫月色单于曲，万里天光魏阙心。\n秉烛何人犹把盏，挑灯有女正穿针。\n早寒时节黄昏后，更逐西风应远砧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58571,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵太守向公登楼眺望二首 其二","author":"秦观","text":"庖烟起处认孤村，天色清寒不见痕。\n车辋湖边梅溅泪，壶公祠畔月销魂。\n封疆尽是春秋国，庙食多怀将相恩。\n试问李斯长叹后，谁牵黄犬出东门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58572,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵太守向公登楼眺望二首 其一","author":"秦观","text":"茫茫汝水抱城根，野色偷春入烧痕。\n千点湘妃枝上泪，一声杜宇水边魂。\n遥怜鸿隙陂穿路，尚想元和贼负恩。\n粉堞女墙都已尽，恍如陶侃梦天门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58573,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵孔彦常舍人曝书","author":"秦观","text":"上帝图书府，传观诏特容。\n嘉宾苍佩玉，盛馔紫驼峰。\n散帙牙签乱，开函锦袭重。\n君羹如可请，愿备北堂供。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58574,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵传道自适兼呈都司芸叟学士","author":"秦观","text":"楚国陈夫子，周南颇滞留。\n弊袍披槁叶，瘦马兀扁舟。\n药饵过三伏，文书散百忧。\n何人共禅悦，居士有浮休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58575,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵刘逊父以宁斋诗二轴作以还之","author":"秦观","text":"扬舲偶过海边州，一见名郎破百忧。\n荀氏诸龙俱俊伟，河东小凤最风流。\n明珠白璧俱投报，细草幽花入献酬。\n别驾旧斋何足念，文昌新府待公游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58576,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵安州晚行寄传师","author":"秦观","text":"投暮安州北，苍烟乱眼昏。\n茅茨人外路，砧杵月边村。\n野水飞云薄，空林噪雀繁。\n几人堪此乐，逢客莫轻论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58577,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵朱李二君见寄二首 其二","author":"秦观","text":"万古流空一鸟沉，衣冠常苦事违心。\n七行俱下知君旧，四者难并笑我今。\n梅已偷春成国色，云犹凭腊造天阴。\n美人绿绮烦遥赠，莫致南金增永吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58578,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵朱李二君见寄二首 其一","author":"秦观","text":"东阡北陌坐淹时，偶为高风振羽仪。\n十丈莲花开处远，三年楮叶刻成迟。\n鬓毛但速安仁老，钱粟难输曼倩饥。\n尚赖故人遥省忆，发挥春色有新诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58579,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵米元章斋居即事","author":"秦观","text":"庭木双株茂，盆池一掬悭。\n支颐鱼出乐，入眦鸟知还。\n老境行将及，仙书读未闲。\n因君歌凤过，通昔梦归山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58580,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵何子温","author":"秦观","text":"一星就起海隅傍，县弩前驱过射阳。\n行见斯民无重困，坐令吾道有馀光。\n簿书不碍诗人笔，猿鸟常窥使者章。\n谈笑自然群吏肃，何须酒后次公狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58581,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵宋履中近谒大庆退食馆中","author":"秦观","text":"翠华初到殿中间，三馆诸儒共一班。\n迎谒晓廷清跸近，退穿春仗綵旓闲。\n病来怕饮东西玉，老去惭陪大小山。\n知续春明退朝录，借观当奉一鸱还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58582,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵侍祠南郊","author":"秦观","text":"风马云车下九天，郊柴初告帝心虔。\n天如倚盖临坛上，星若连珠绕御前。\n缥缈佩环参雅奏，岧峣楼阁抱非烟。\n侍臣举酒欣相属，醉看参横左右肩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58583,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵罗正之惠绵扇","author":"秦观","text":"吴扇新翻制素绵，名郎持赠意俱圆。\n有人充户修明月，无女乘鸾向紫烟。\n供奉宜升清暑殿，动摇合作御风仙。\n谁知挥却青蝇辈，功在春蚕一觉眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58584,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵范纯夫戏答李方叔馈笋兼简邓慎思","author":"秦观","text":"楚山冬笋斸寒空，北客长嗟食不重。\n秀色可怜刀切玉，清香不断鼎烹龙。\n论羹未愧莼千里，入贡当随传一封。\n薄禄养亲甘旨少，满包时赖故人供。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58585,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵莘老初至汤泉","author":"秦观","text":"夹路山重复，参天树老苍。\n一区成小市，数埒引温汤。\n洗沐同幽客，餔餐就梵坊。\n未输朝市子，斗酒得西凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58586,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵答裴仲谟","author":"秦观","text":"十年淮海閒居草，偶遣儿童次第成。\n方愧贫家矜敝帚，忽蒙邻壁借馀明。\n文昌但愿花前老，张翰何须身后名。\n移病阖门参拜阻，卧听车马去来声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58587,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵谢李安上惠茶","author":"秦观","text":"故人早岁佩飞霞，故遣长须致茗芽。\n寒橐遽收诸品玉，午瓯初试一团花。\n著书懒复追鸿渐，辨水时能效易牙。\n从此道山春困少，黄书剩校两三家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58588,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵酬陈传道","author":"秦观","text":"白发三冬学，青衫八尺身。\n谁知人上杰，聊作吏中循。\n挥翰通元气，开编友古人。\n寄声张氏子，曲逆岂长贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58589,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵酬周开祖宣义","author":"秦观","text":"并州令尹古人风，淮海相忘十载中。\n丽句晓披花绰约，清谈初扣玉丁东。\n追攀昔共猗玕子，嗜好今同桑苧翁。\n所惜华船轻解繂，未窥笠泽故书丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58590,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵裴仲谟和何先辈二首 其二","author":"秦观","text":"汝南古郡寡参寻，兀兀长如鹤在阴。\n支枕星河横醉后，入帘风絮报春深。\n青山未落诗人手，白发谁知国士心。\n多谢名郎传绿绮，愧无佳句比南金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58591,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵裴仲谟和何先辈二首 其一","author":"秦观","text":"闻说何郎操行端，萧然环堵若为安。\n鸟啼花发阻携手，水远山高空凭栏。\n别后想多黄绢作，春来尤厌惠文弹。\n两章读罢知高义，贵贱交情自古难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58592,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵裴秀才上太守向公二首 其二","author":"秦观","text":"上客新从颍尾归，使君高会列南威。\n风将沉燎萦歌扇，雪带梅香上舞衣。\n翻样云团分御帑，如椽蜜炬出宫闱。\n食前方丈罗珍怪，却讶犀燃牛渚矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58593,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵裴秀才上太守向公二首 其一","author":"秦观","text":"东风已动北风归，寒气侵寻自霁威。\n何处管弦传腊酒，谁家刀尺制春衣。\n使君英妙开莲幕，别驾风流出粉闱。\n唯有广文官独冷，终年如坐水边矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58594,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西城宴集二首 其二","author":"秦观","text":"宜秋门外喜参寻，豪竹哀丝发妙音。\n金爵日边栖壮丽，彩虹天际卧清深。\n已烦逸少书陈迹，更属相如赋上林。\n犹恨真人足官府，不如鱼鸟自飞沉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58595,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西城宴集二首 其一","author":"秦观","text":"春溜泱泱初满池，晨光欲转万年枝。\n楼台四望烟云合，帘幕千家锦绣垂。\n风过忽闻花外笑，日长时奏水中嬉。\n太平谁谓全无象，寓在群仙把酒时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58596,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过六合水亭怀裴博士次韵","author":"秦观","text":"晚憩孤亭上，羸骖系断柯。\n荒门寒带路，空槛阔增波。\n往事青山在，馀生白鸟过。\n诵言成绝唱，亹亹迫阴何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58597,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]