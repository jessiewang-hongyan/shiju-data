[{"title":"苏老亭","author":"吴栻","text":"苏老行诸郡，多为洒落游。\n静心山共止，动意水俱流。\n赴社呼陶令，翻经约谢侯。\n高风谁复记，明月上西楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52960,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"越峰院","author":"吴栻","text":"野僧迎客笑开关，更拂残碑藓字班。\n徐姓仙归空碧洞，越封王去漫青山。\n影来秋月林千缺，声落春风水一湾。\n焙茗满瓯须强啜，过桥车马便人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52961,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"暑雪轩","author":"吴栻","text":"咒土台头寺，披襟笑语閒。\n千年云抱石，六月雪弥山。\n酒熟篘尝外，茶新辗试间。\n要须时点笔，来此赋跻攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52962,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和田望再赋暑雪轩","author":"吴栻","text":"石照台高暑不侵，雪横天际蜀西岑。\n但知赋客如梁苑，那得参徒似少林。\n月上便成银色界，风生兼作海潮音。\n可怜火宅人空老，谁解跏趺一解襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52963,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和周焘合江亭 其一","author":"吴栻","text":"使者风流照锦城，东郊揽辔更澄清。\n春江合处烟凝晓，秀岭横边日弄晴。\n石鼎煮茶浓有味，金钟注酒酾无声。\n何时却信桥南步，细读诗人古柏行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52964,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和周焘合江亭 其二","author":"吴栻","text":"闻公载酒合江亭，要使邦人识使星。\n宿雨乍晴聊信马，晓风初熟更扬舲。\n赋成不是缘鹦鹉，诗就当和为脊令。\n只欠湘灵来鼓瑟，渔歌声断数峰青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52965,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游南山","author":"吴栻","text":"但看都梁山拱北，莫寻浮磬水朝东。\n此间半筑瞿昙室，底处曾营炀帝宫。\n七眼泉边百无念，一襟披尽晚来风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52966,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"五峰岩 其一","author":"吴栻","text":"云烟杳霭环诸峰，石径诘曲穿疏松。\n更无飞埃趁短屐，祇有鸣溜迎修筇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52967,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"五峰岩 其二","author":"吴栻","text":"玲珑数窦明相通，造化恍惚真难穷。\n阳回三冬照暖日，阴纳九夏吹寒风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52968,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄智翁宣州知府乡兄","author":"吴栻","text":"使君真是十年兄，投老相看眼更明。\n入省早推何水部，作州今见谢宣城。\n应怜远岫云俱晓，定梦澄江月共晴。\n安得陪公觞咏后，春风桃李满交情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52969,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"钓台","author":"吴栻","text":"一水自东流，萧萧霜木秋。\n笑谈轻万乘，身世老扁舟。\n薄俗迷方饵，高人悟直钩。\n至今驯不散，沙上晚来鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52970,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"严陵怀古","author":"吴栻","text":"龙衮新天子，羊裘古野人。\n清名在林薮，高行动星辰。\n风月空齐国，烟霞自富春。\n沧浪秋更碧，不敢濯缨尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52971,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"佛岩塔","author":"吴栻","text":"洒落岩题宴寂高，旋添香火挂青袍。\n霜头不惧九侯剑，雪臂应□二祖刀。\n月照瓦棺服虎兕，风吹石室啸狷猿。\n檐前旧雨天花处，循想眉间两白毫。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52972,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登姜相台 其一","author":"吴栻","text":"满林红叶坠纷纷，耆老犹言别驾坟。\n旧府光华关右月，故乡萧索海南云。\n酒杯湖上同方伯，茶灶岩边共隐君。\n二百馀年真一梦，绕墙荒陇半耕耘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52973,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登姜相台 其二","author":"吴栻","text":"苑门北出祸匆匆，叩马何人独记公。\n葬厚欲裁宁诈直，谋南能利倍其忠。\n刚各腊后乔林雪，废迹秋来败叶风。\n华表千年相对鹤，长看碑锁旧亭中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52974,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题秦君亭 其一","author":"吴栻","text":"芸阁雠书谢建封，生涯潇洒一枝筇。\n曾为剡隐云横水，更作闽游月满峰。\n子美藩篱清可造，长卿城郭巧能攻。\n拂琴无复尘埃想，落落霜风一晋松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52975,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题秦君亭 其二","author":"吴栻","text":"秋日春风丽句亭，先生天上少微星。\n满炉松影随香碧，一砚苔痕带雨青。\n姜相笑中应斗酒，等公谈外祇函经。\n何人为我携毡蜡，来洗苍碑墨数厅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52976,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题清洋院","author":"吴栻","text":"潇洒堂中披晚襟，红蕉花里叶成阴。\n飘来无雨水长急，飞去有云山更深。\n苔藓细痕缘巨石，藤萝密影挂疏林。\n上人莫作人间想，此地人间不可寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52977,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题报劬院","author":"吴栻","text":"山列三峰来不断，水交双港送无穷。\n帆边洲渚潇潇雨，墙外园林淅淅风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52978,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"灵岩 其一","author":"吴栻","text":"三齐何处古丛林，石作门阑岱岳阴。\n云暗鸡鸣川谷浅，月明龟吐水泉深。\n未须赞叹袈裟铁，且可归依世界金。\n弹指上方还一梦，梦中聊续去年吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52979,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"灵岩 其二","author":"吴栻","text":"济南惊蛰隐新雷，底事阳关叠叠催。\n不称泺源涌觱沸，只堪崧阜上崔巍。\n他年发已千茎雪，今日心仍一寸灰。\n文雅台边蜗有舍，瓮头归去泼春醅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52980,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"灵岩 其三","author":"吴栻","text":"飞锡道人知几年，青蛇白兔亦茫然。\n焚香且上五花殿，煮茗更临双鹤泉。\n今日别栽庭下柏，当时曾种社中莲。\n證明佛事真何事，聊策藤枝结胜缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52981,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"吴栻","text":"晴开千障雾，翠落万家楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52982,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"桃花岩","author":"李通儒","text":"地势下临郧子国，山光遥射楚王城。\n惟有桃花岩上月，曾闻李白醉吟声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52983,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送程给事知越州","author":"范镗","text":"青门聊起濯缨歌，昼绣经从鬓已皤。\n越俗易谙缘地近，吴人奚独羡金多。\n要知新集馀民事，亦有东来使者过。\n今日轻帆到江浒，藩宣宜得似西河。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52984,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游浈阳峡","author":"范镗","text":"峡流触石石欲裂，峡舟溯水心寸拆。\n系缆心头夜向阑，惊浪沄沄写寒月。\n风餐水宿知几年，馀生可复瘴江边。\n愁绝不眠起披户，顾视海宇天茫然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52985,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书碧落洞","author":"范镗","text":"君不见英江碧落之洞之奇异，览遍堪舆无一二。\n乱石丛中孕粹精，万里荒崖启灵秘。\n飞来峰喜石玲珑，后人雕琢徂真风。\n通天岩穴亦幽敞，有山无水非吾从。\n锦石半空杳玄径，泉石犹怜未相应。\n星岩山泽本自佳，却被渔人苦深病。\n何如此洞妙神工，架空绝壑如长虹。\n一水中流抱青碧，群峰掩映迷仙迹。\n巨灵擘开神禹凿，怪石崆峒翳寥廓。\n云华缥缈闻箫笙，宝室光腾下鸾鹤。\n初疑河汉通天阍，欲泛星槎一问津。\n又疑误入桃源浒，源头恐有先秦民。\n我生癖性耽奇特，每遇胜游兴增逸。\n□来得此慰初心，积虑沈痾恍如失。\n吴罗二子亦豪英，溪头饮我双玉瓶。\n醉来晞发云霞外，一笑林壑生秋声。\n洞天福地遍天下，蓬岛三山终幻化。\n会当八极恣神游，小作行窝驻吾驾。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52986,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"碧落洞","author":"范镗","text":"玉削苍峦千碧虚，洞中杳杳真人居。\n绰约冰采颜如珠，一念不起终无如。\n我缘朴陋厌纷挐，心与幽致烦簪裾。\n九阳丹就括灵枢，飘然再访聊踟蹰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52987,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游惠山 其一","author":"蒋之美","text":"绝顶疑天设，重门一径深。\n泉清千古意，松老百年心。\n高阁窥平陆，危亭倚翠岑。\n胜游方自适，犹恐日西沈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52988,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游惠山 其二","author":"蒋之美","text":"九陇分形怪，苍龙据厚坤。\n洞寒清水脉，石润养云根。\n探远尘应断，穷高斗可扪。\n江湖倦行者，对此欲忘言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52989,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游惠山 其三","author":"蒋之美","text":"维舟上重巘，景物近斜晖。\n流水连珠落，残花碎锦飞。\n白云随步武，香鸟傍轩扉。\n拂井松倾盖，缘崖藓上衣。\n池光清可鉴，竹色翠成围。\n更接高僧话，林梢带月归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52990,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"飞来山","author":"叶棣","text":"乱山深处款禅扃，十里松阴步障行。\n翠竹黄花几开发，南星北斗自高明。\n楼台日转天边影，钟磬风回地底声。\n为问闽江船钓客，谢家谁更未知名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52991,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"叶棣","text":"闻说治平元太守，慇勤晚到凤皇池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52992,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"当阳寺","author":"林诰","text":"何处遇幽景，当阳绝顶寻。\n云霞千古态，松竹四时阴。\n岫列天边嶂，泉鸣涧底琴。\n高人不游此，应负爱山心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52993,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"林安道","text":"古甃千龄在，寒泉味最醇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52994,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"林安道","text":"海外蟠桃同永久，月中丹桂共参差。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52995,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"老人岩","author":"林嗣宗","text":"九月黄花次第开，带星约客上崔嵬。\n拟从老子岩前去，却入真仙洞里来。\n幸勉西风吹落帽，且陪东道引深杯。\n个中便见蓬莱境，何必龙山戏马台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52996,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"柳庭俊","text":"滁阳山水佳，幽谷尤胜绝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52997,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"吴江太湖笠泽虹桥","author":"梅灏","text":"水无浊浪地无尘，渺渺江湖天与邻。\n占得沧波输钓叟，吟穷清景属诗人。\n阴晴隐见山千叠，上下澄明月一轮。\n欲画为图随处看，风光变态状难真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52998,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题梅坛","author":"吕防","text":"封事悠悠即挂冠，苍烟古木锁空坛。\n当时不识蓬莱客，祇作南昌一尉看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52999,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题梅仙观","author":"吕防","text":"尝读子真传，掩卷屡长叹。\n如何忠正资，适在元成间。\n危言论时政，条畅穷根源。\n直节破奸胆，愤气冲儒冠。\n上书辄报罢，九九惭齐桓。\n是时公卿辈，曾不为厚颜。\n雄文灿方册，至今日星攒。\n深机识祸福，拂衣九江干。\n一朝弃妻子，变姓抱吴关。\n位卑而言高，自古为尤难。\n斯人能保身，出处何其艰。\n繄子偶得邑，驾言谒仙坛。\n坛侧千丈松，凛凛清风还。\n寿春下新诏，高蹈翠琰刊。\n壁间罗隐记，中理极可观。\n当年康乐公，游览遍名山。\n云何此佳迹，未被金石言。\n真人久怅望，伫看西飞鸾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53000,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"瀫波亭","author":"吕防","text":"王孙馀巧力，银汉亦经营。\n地轴卷不尽，风梭织又成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53001,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"元章好古过人书画惊世起余作歌","author":"刘泾","text":"天下爱奇人没量，奇不谀人奇解相。\n奇人奇物方合璧，乞与世间人物样。\n六朝唐盛始兼得，访古知名已萧爽。\n人亡物丧付衰梦，注想后来逢好尚。\n元章心自鉴秋月，一路仍行九霄上。\n家时菜色无斗粟，书画奇奇世人望。\n譬如大海沈百宝，尔辈乘风得之浪。\n二王褚陆已天作，老顾如来更天匠。\n其馀缇袭凡几重，但见光明烂垂象。\n珍犀瑞锦扶兰茝，龙跃鸾惊诃魍魉。\n金仙讵敢触以手，雪子玉人聊置掌。\n余家僻素最沈著，退舍还师觉难傍。\n世人往往力能干，未免目虾终惚恍。\n缄机伪谬各臣妾，未睹堂堂笔中王。\n袖间涩缩气如线，净几明窗谩瞻仰。\n从来所有万钱价，不即臭帤当火葬。\n倾心妙绝岂求胜，妄意临摹须杀谤。\n端居自号书一品，好事如封绘三藏。\n诸郎青出即护持，未肯充饥谬为驵。\n余衰二物拟高阁，子可专之世无两。\n书来诗往但悠悠，尘土欺人正惆怅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53002,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题韩溪","author":"刘泾","text":"豪杰相从意气中，怜才倾倒独萧公。\n后来可是无奇客，东阁投名尚不通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53003,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"留题钓台","author":"刘泾","text":"水绿山青人可知，不知生气得之谁。\n钓竿已属严公手，直到元英解道诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53004,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"青城山","author":"刘泾","text":"拔地山争秀，藏天谷受虚。\n云开西蜀后，木老避秦初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53005,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"仙都山","author":"刘泾","text":"石城云屋抱浮丘，正是真人旧括州。\n会掷仙图争少胜，不知身到洞天游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53006,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"石洞门 其一","author":"刘泾","text":"密竹流泉不居热，洞门深沉风雨歇。\n洗出清明快活天，醉弄江南谢家月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53007,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"石洞门 其二","author":"刘泾","text":"未逢仙手破天荒，我得披云第一章。\n它日爱奇思谢客，却须因事忆刘郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53008,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和米元章龙真行","author":"刘泾","text":"秦火荡焚天地赤，孔堂坏后无馀壁。\n不知科斗六书文，化作龙蛇二王迹。\n集贤他日作仙久，官姓篆章存历历。\n自怜黄眼未亲逢，一段因依徒夺魄。\n元章挥洒早惊动，秘箧墨皇曾敬识。\n孤标未要后生知，劣许下官论莫逆。\n好奇举世不多得，神物尤来终变易。\n神锋双合会有时，真玺一飞无处觅。\n颇闻秘箧作讹语，别有扰龙招异客。\n不如乾没归去来，胜在个家遭水厄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53009,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"天王寺","author":"刘泾","text":"金碧为家定化城，书床南偃略相迎。\n人间蝶梦正深黑，天上木鱼初发明。\n半里好风招隐士，一枝枯竹助闲行。\n已惭怀绂无高致，可更标门著姓名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53010,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登麻姑山 其一","author":"刘泾","text":"溪行爱宛转，石坐怜皴苍。\n白云起目前，如鹤两翼张。\n蜕我衣上尘，驾之以翱翔。\n欲揽恍不接，身在意飘扬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53011,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登麻姑山 其二","author":"刘泾","text":"石鼓埋入地，荆璧飞上天。\n呜呼鲁公碑，风雨三百年。\n爱字不爱石，磨灭安得传。\n不敢手触之，谓是甘棠篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53012,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"葛仙坛 其一","author":"刘泾","text":"天风吹馀晦，万木晴扶疏。\n寒云淡山色，水墨涨秋图。\n驾言寥廓中，一径渺盘纡。\n却首谢尘世，培塿而潢污。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53013,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"葛仙坛 其二","author":"刘泾","text":"谢公好登山，折屐第三谷。\n麻姑乃不到，颇负登山足。\n寒杉鸣古珰，涧道泻淙玉。\n筇竹白接䍦，吾将追往躅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53014,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"葛仙坛 其三","author":"刘泾","text":"空山万幽木，弹以终日风。\n无弦自秋曲，奏满天地中。\n爱之以心灵，听之以耳聪。\n道人抱琴来，此意不可通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53015,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"瀑布泉","author":"刘泾","text":"瀑布宜终宵，幽鸟时一吟。\n浩然太虚际，始识本来心。\n情闲日自长，步远意亦深。\n更携九节杖，插遍萧萧林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53016,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三岩游","author":"刘泾","text":"混成初造物，幽绝故离群。\n入户清容月，分栖淡借云。\n木阴阑暑气，泉滴厌秋闻。\n欲索秦人记，消磨篆不文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53017,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"混元峰","author":"刘泾","text":"青泥切石剑无迹，丹水含英鼎飞出。\n仙风绝尘鸡犬喧，杉松老大如人立。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53018,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题笼空岩","author":"刘泾","text":"苍崖如堂水如布，桥危如绳石如锯。\n不有樵夫踏破云，世间可复知深处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53019,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"溪雨亭","author":"刘泾","text":"尘土孤城空自忙，不知精舍早秋凉。\n林间曲折磬三里，天上金光月满堂。\n净饭打鱼刳老木，寒灰添火爇明香。\n鹁鸠山脚溪声好，流入人间雨意长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53020,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"刘泾","text":"初起褪红唇启绛，半沾斜绿眼横波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53021,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"刘泾","text":"晓来风入万花动，零落满头飞下时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53022,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诗一首","author":"俞括","text":"二十四峰尖，参差列郡南。\n半空擎梵宇，绝顶寄僧龛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53023,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"俞括","text":"岩排星斗七，石涌佛身三。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53024,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]