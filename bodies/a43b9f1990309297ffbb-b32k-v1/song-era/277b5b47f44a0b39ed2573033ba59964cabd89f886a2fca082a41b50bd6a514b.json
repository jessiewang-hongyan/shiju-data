[{"title":"代书寄北海幕赵充道太博","author":"邵雍","text":"自从终鲜罢吟哦，聊为临风一浩歌。\n别易会难情不已，登高望远兴如何。\n百年可惜时无再，千里相思事更多。\n今日樽罍真北海，况君雅重几人过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3039,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代书寄白波张景真辇运","author":"邵雍","text":"秋入山河气象雄，不堪闲望老年中。\n金兰契重思无限，手足情多感未终。\n半局残棋销白昼，一簪华发乱西风。\n唯君父子相知久，松桂心同色更同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3040,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代书寄吴传正寺丞","author":"邵雍","text":"敦笃情怀世所稀，昔年今日事难追。\n雪霜未始寒无甚，松桂何尝色暂移。\n洛邑士人虽我信，天津风月只君知。\n梦魂不悟东都远，依旧过从似旧时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3041,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代书寄前洛阳簿陆刚叔秘校","author":"邵雍","text":"洛城官满振衣裾，尘土何由浼远途。\n道在幸逢清日月，眼明应见旧江湖。\n知行知止唯贤者，能屈能伸是丈夫。\n归去何妨趁残水，三吴还似向时无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3042,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代书寄剑州普安令周士彦屯田 其一","author":"邵雍","text":"作官休用叹奚为，未有升高不自卑。\n君子屈伸方为道，吾儒进退贵从宜。\n即今彭泽归何地，他日东门去未迟。\n痛恨伊嵩景无限，一名佳处重求资。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3043,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代书寄商洛令陈成伯","author":"邵雍","text":"此去替期犹半岁，商山穷僻少医名。\n感伤多后风防滞，暑湿偏时疾易生。\n圣智不能无蹇剥，贤才方善处哀荣。\n斯言至浅理非浅，少补英豪一二明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3044,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代书寄程正叔","author":"邵雍","text":"严亲出守剑门西，色养欢深世表仪。\n唐相规模今历历，蜀民遨乐旧熙熙。\n海棠洲畔停桡处，金雁桥边立马时。\n料得预忧天下计，不忘君者更为谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3045,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代书寄鄞江知县张太博","author":"邵雍","text":"长忆当年扫弊庐，弟兄同受策名初。\n一生不记寻常事，千里犹通咫尺书。\n风月遥知四明好，江山况是九秋馀。\n片帆未得闲飞去，徒见严君问起居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3046,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代书寄濠倅张都官","author":"邵雍","text":"多惭吾亦未知音，天乐虽闻不许寻。\n惠子相时情自好，庄生游处意能深。\n闲来略记一春事，老去难忘千里心。\n洛社交朋每相见，为吾因掉白头吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3047,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代书答开封府推官姚辅周郎中","author":"邵雍","text":"世态其如与愿违，必须言进是无知。\n遍将底事闲思处，不若西街极论时。\n设有奇才能动世，奈何双鬓已如丝。\n天边新月从来细，不为人间爱画眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3048,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代书答朝中旧友","author":"邵雍","text":"少日治文章，亦曾观国光。\n山林虽不返，畎亩未尝忘。\n麋鹿宁无志，鹓鸿自有行。\n还知今日事，大故索思量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3049,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"击壤吟","author":"邵雍","text":"人言别有洞中仙，洞里神仙恐妄传。\n若俟灵丹须九转，必求朱顶更千年。\n长年国里花千树，安乐窝中乐满悬。\n有乐有花仍有酒，却疑身是洞中仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3050,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"击壤吟","author":"邵雍","text":"击壤三千首，行窝二十家。\n乐天为事业，养志是生涯。\n出入将如意，过从用小车。\n人能知此乐，何必待纷华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3051,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"半醉吟 其二","author":"邵雍","text":"半醉小车行，世间无此荣。\n凉风迎面细，垂柳拂头轻。\n意若兼三事，情如拥万兵。\n这般闲富贵，料得没人争。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3052,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"头风吟","author":"邵雍","text":"近日头风不奈何，未妨谈笑与高歌。\n人才相去不甚远，事体所争能许多。\n闭目面前都是暗，开怀天外更无他。\n若由智数经营得，大有英雄善揣摩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3053,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"对花","author":"邵雍","text":"花枝照酒卮，把酒嘱花枝。\n酒尽钱能买，花残药不医。\n人无先酩酊，花莫便离披。\n慢慢对花饮，况春能几时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3054,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"对花饮","author":"邵雍","text":"人言物外有烟霞，物外烟霞岂足誇。\n若用校量为乐事，但无忧挠是仙家。\n百年光景留难住，十日芳菲去莫遮。\n对酒有花非负酒，对花无酒是亏花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3055,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"对酒吟","author":"邵雍","text":"有酒时时泛一瓯，年将七十待何求。\n齿衰婚嫁尚未了，岁旱田园才薄收。\n客去有时闲拱手，日高无事静梳头。\n霜毛不止装诗景，更可因而入画休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3056,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"白头吟","author":"邵雍","text":"何人头不白，我白不因愁。\n只被人多欲，其如我不忧。\n不忧缘不动，多欲为多求。\n年老人常事，如何不白头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3057,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"立秋日川上作","author":"邵雍","text":"富贵固难爱，贫寒易得愁。\n休将少时态，移作老年羞。\n既有非常乐，须防不次忧。\n谁能保终始，长作国公侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3058,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"仿康节先生诗","author":"邵雍","text":"每日清晨一炷香，谢天谢地谢三光。\n所求处处田禾热，惟愿人人寿命长。\n国有贤臣安社稷，家无逆子恼爹娘。\n四方平静干戈息，我若贫时也不妨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3059,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"训世孝弟诗十首 其一","author":"邵雍","text":"子孝亲兮弟敬哥，训贤妯娌事翁婆。\n好遵孟母三迁教，须读张公百忍歌。\n孝友睦姻兼任恤，智仁圣义与中和。\n当时曾子同杨博，子孝亲兮弟敬哥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3060,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"训世孝弟诗十首 其二","author":"邵雍","text":"子孝亲兮弟敬哥，莫因微利遽伤和。\n黄金匮内休嫌少，阴德冥中要积多。\n私曲岂知公直在，刚强无奈善柔何。\n古今简籍多名誉，子孝亲兮弟敬哥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3061,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"训世孝弟诗十首 其三","author":"邵雍","text":"子孝亲兮弟敬哥，休伤和气忿争多。\n偏生嫉妒偏艰窘，暗积私房暗折磨。\n不孝自然生忤逆，无仁实是出妖魔。\n但闻孝弟传千古，子孝亲兮弟敬哥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3062,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"训世孝弟诗十首 其四","author":"邵雍","text":"子孝亲兮弟敬哥，怡声下气与谦和。\n难兄难弟名偏重，孝子贤孙贵自多。\n负米尚难为薄养，读书宁不擢高科。\n仲由陈纪皆如此，子孝亲兮弟敬哥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3063,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"训世孝弟诗十首 其五","author":"邵雍","text":"子孝亲兮弟敬哥，休残骨肉起风波。\n劬劳恩重须当报，手足情深要取和。\n公艺同居今古罕，田真共处子孙多。\n如斯遐迩皆称美，子孝亲兮弟敬哥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3064,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"训世孝弟诗十首 其六","author":"邵雍","text":"子孝亲兮弟敬哥，天时地利与人和。\n莫言世事常如此，堪叹人生有几何。\n满眼繁华何足贵，一家安乐值钱多。\n奇哉让梨并怀橘，子孝亲兮弟敬哥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3065,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"龙门石楼看伊川","author":"邵雍","text":"数朝从款走烟霞，纵意凭栏看物华。\n百尺楼台通鸟道，一川烟水属僧家。\n直须心逸方为乐，始信官荣未足誇。\n此景得游无事日，也宜知幸福无涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3066,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"龙门道中作","author":"邵雍","text":"物理人情自可明，何尝戚戚向平生。\n卷舒在我有成算，用舍随时无定名。\n满目云山俱是乐，一毫荣辱不须惊。\n侯门见说深如海，三十年来掉臂行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3067,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"仲尼吟","author":"邵雍","text":"仲尼生鲁在吾先，去圣千馀五百年。\n今日谁能知此道，当时人自比于天。\n皇王帝伯中原主，父子君臣万世权。\n河不出图吾已矣，修经意思岂徒然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3068,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"伊川吟","author":"邵雍","text":"休嗟流年随逝水，但将清景逐闲情。\n山河天下从来广，日月林间长自明。\n幸有园林供笑傲，岂无诗酒乐升平。\n如何更得烟霞侣，好向伊川老此生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3069,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"伤二舍弟无疾而化 其二","author":"邵雍","text":"肠断东篱何所寻，东篱从此事沉沉。\n差肩行处皆成往，吊影伤时无似今。\n清泪已乾情莫极，黄泉未到恨非深。\n不知何日能销尽，三十二年雍睦心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3070,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"伤二舍弟无疾而化 其一","author":"邵雍","text":"手足情深不可忘，割心犹未比其伤。\n急难畴昔尔相济，终鲜如今我遂当。\n韡韡棣开无并萼，邕邕雁去破初行。\n自兹明月清风夜，萧索东篱看断肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3071,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"伤足","author":"邵雍","text":"灾由无妄得，为患固非深。\n乖已摄生理，贻亲忧虑心。\n乍然艰步履，偶尔阻登临。\n逾月方能出，难忘乐正箴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3072,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"共城十吟 其七 春郊雨中","author":"邵雍","text":"九野散漫漫，连昏鸟道间。\n坐中迷远树，门外失前山。\n袯襫耕夫喜，屏幪居者閒。\n骚人正凝黯，天际意初还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3073,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"共城十吟 其九 春郊旧酒","author":"邵雍","text":"花开风雨后，忍病欲消磨。\n未是疏狂极，其如困顿何。\n梁间新燕乱，天外去鸿多。\n总是灰心事，冥焉昼午过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3074,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"共城十吟 其二 春郊閒步","author":"邵雍","text":"病起复惊春，携筇看野新。\n水边逢钓者，垄上见耕人。\n访彼形容苦，酬予家业贫。\n自惭功济力，未得遂生民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3075,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"共城十吟 其八 春郊雨后","author":"邵雍","text":"雨歇荡馀春，天光露太真。\n茵铺芳草软，锦濯烂花新。\n风触莺簧健，烟舒柳带匀。\n如何当此景，閒卧度昌辰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3076,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"共城十吟 其十 春郊花落","author":"邵雍","text":"春暮多风雨，离披满后园。\n晓馀残片拥，晴外乱红翻。\n香径难留裛，娇心绝弄繁。\n成蹊是桃李，狼籍尚无言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3077,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"共城十吟 其六 春郊晚望","author":"邵雍","text":"风暖啭鸣禽，天低薄薄阴。\n烟容凝垄曲，雨意弄河心。\n柳隔高城远，花藏旧县深。\n独怜身卧病，犹许后春寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3078,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"共城十吟 其四 春郊花开","author":"邵雍","text":"桃李正芬敷，花繁覆敝庐。\n乱香寻密牖，碎影下前除。\n静绕昼眠后，轻攀春醉馀。\n纵然观尽日，谁敢罪狂疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3079,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再和王不疑少卿见赠","author":"邵雍","text":"乍凉天气好，何处不堪游。\n鸿雁来宾日，鹰鹯得志秋。\n忘形终夕乐，失脚一生休。\n多少江湖上，舟船未到头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3080,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同王胜之学士转运赏西园芍药","author":"邵雍","text":"此物扬州素所闻，今于洛汭特称珍。\n雅知国色善移物，更著天香暗结人。\n欲殿群芳仍占夏，得专奇品不须春。\n日斜立马将归去，再倚朱栏看一巡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3081,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"名利吟","author":"邵雍","text":"名利到头非乐事，风波终久少安流。\n稍邻美誉无多取，才近清欢与剩求。\n美誉既多须有患，清欢虽剩且无忧。\n滔滔天下曾知否，覆辙相寻卒未休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3082,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"后园即事三首 其三","author":"邵雍","text":"年来得疾号诗狂，每度诗狂必命觞。\n乐道襟怀忘检束，任真言语省思量。\n宾朋款密过从久，云水优闲兴味长。\n始信渊明深意在，北窗当日比羲皇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3083,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"后园即事三首 其二","author":"邵雍","text":"天养疏慵自有方，洛城分得水云乡。\n不闻世上风波险，但见壶中日月长。\n一局闲棋留野客，数杯醇酒面脩篁。\n物情悟了都无事，未学颜渊已坐忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3084,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"后园即事三首 其一","author":"邵雍","text":"太平身老复何忧，景爱家园自在游。\n几树绿杨阴乍合，数声幽鸟语方休。\n竹侵旧径高低迸，水满春渠左右流。\n借问主人何似乐，答云殊不异封侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3085,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"团团吟","author":"邵雍","text":"如鉴又如钩，回旋莫记秋。\n难穷天上理，易白世间头。\n团处人人喜，亏时物物愁。\n有生无不喘，何必待吴牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3086,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"安乐窝中四长吟","author":"邵雍","text":"安乐窝中快活人，闲来四物幸相亲。\n一编诗逸收花月，一部书严惊鬼神。\n一炷香清冲宇泰，一樽酒美湛天真。\n太平自庆何多也，唯愿君王寿万春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3087,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"安乐窝中自贻","author":"邵雍","text":"物如善得终为美，事到巧图安有公。\n不作风波于世上，自无冰炭到胸中。\n灾殃秋叶霜前坠，富贵春华雨后红。\n造化分明人莫会，枯荣消得几何功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3088,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"安乐窝中吟 其十二","author":"邵雍","text":"生为男子偶昌辰，安乐窝中富贵身。\n大字写诗誇壮健，小杯饮酒惜轻醇。\n山川澄净初经雨，草木暄妍正遇春。\n造化功夫精妙处，都宜分付与闲人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3089,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"安乐窝中吟 其三","author":"邵雍","text":"安乐窝中弄旧编，旧编将绝又重联。\n灯前烛下三千日，水畔花间二十年。\n有主山河难占籍，无争风月任收权。\n闲吟闲咏人休问，此个功夫世不传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3090,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"安乐窝中吟 其四","author":"邵雍","text":"安乐窝中万户侯，良辰美景忍虚休。\n已曾得手春深日，更欲披衣年老头。\n晓露重时花满槛，暖醅浮处酒盈瓯。\n圣人吃紧些儿事，又省工夫又省忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3091,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"安乐窝中吟 其九","author":"邵雍","text":"安乐窝中甚不贫，中间有榻可容身。\n儒风一变至于道，和气四时长若春。\n日月作明明主日，人言成信信由人。\n唯人与日不相远，过此何尝更语真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3092,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"安乐窝中吟 其十一","author":"邵雍","text":"安乐窝中春欲归，春归忍赋送春诗。\n虽然春老难牵复，却有夏初能就移。\n饮酒莫教成酩酊，赏花慎勿至离披。\n人能知得此般事，焉有闲愁到两眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3093,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"尧夫何所有","author":"邵雍","text":"尧夫何所有，一色得天和。\n夏住长生洞，冬居安乐窝。\n莺花供放适，风月助吟哦。\n窃料人间乐，无如我最多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3094,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岁杪吟","author":"邵雍","text":"一日去一日，一年添一年。\n饶教成大器，其那已华颠。\n志意虽依旧，聪明不及前。\n若非心有得，亦恐学神仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3095,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岁除吟","author":"邵雍","text":"半百已华颠，如今更皓然。\n自知为士子，人讶学神仙。\n风月难忘酒，云山不著钱。\n行年六十六，明日又添年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3096,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"年老吟","author":"邵雍","text":"岁华头上不能惊，唯有交亲眼更明。\n皓皓月常因坐看，深深酒不为愁倾。\n苟于心上无先觉，却似人间小后生。\n欲约何人为伴侣，江湖泛去一舟轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3097,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"年老逢春十三首 其十三","author":"邵雍","text":"年老逢春认破春，破春不用苦伤神。\n身心自有安存地，草木焉能媚惑人。\n此日荣为他日瘁，今年陈是去年新。\n世间忧喜常相逐，多少酒能平得君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3098,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"年老逢春十三首 其十二","author":"邵雍","text":"年老逢春春不任，不任缘被老来侵。\n一身老去恶足惜，满眼春归何处寻。\n红日坠时风更急，落花流处水仍深。\n流莺不悟芳菲歇，犹向枝头送好音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3099,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"年老逢春十三首 其十一","author":"邵雍","text":"年老逢春莫惜狂，惜狂无那兴难当。\n园林恰到恶明媚，风雨便多闲中伤。\n花等半开宜速赏，酒闻才熟便先尝。\n大都美物天长惜，非是吾侪曲主张。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3100,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"年老逢春十三首 其十","author":"邵雍","text":"年老逢春兴未收，愿春慈造少迟留。\n既称好事愁花老，须与多情秉烛游。\n酒里功劳闲汗马，诗中罪过静风流。\n东君不奈人嘲戏，僝僽花枝恶未休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3101,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"年老逢春十三首 其九","author":"邵雍","text":"年老逢春莫厌频，更频能见几回春。\n须将酒盏强留客，却恐花枝解笑人。\n世态不堪新间旧，物情难免假疑真。\n谁云梁燕多言语，此个深冤都未伸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3102,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"年老逢春十三首 其八","author":"邵雍","text":"年老逢春春莫悭，春悭不当世艰难。\n四时只有三春好，一岁都无十日闲。\n酒盏不烦人诉免，花枝须念雨摧残。\n却愁千片飘零后，多少金能买此欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3103,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]