[{"title":"戏呈闻善二兄","author":"黄庭坚","text":"匏悬篱落鸦窥井，草上阶除雪衮风。\n想得尊前攲醉帽，浑家儿女笑山公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71566,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏和舍弟船场探春二首 其二","author":"黄庭坚","text":"百舌解啼泥滑滑，忽成风雨落花天。\n城南一段春如锦，唤取诗人到酒边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71567,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏和舍弟船场探春二首 其一","author":"黄庭坚","text":"雨馀禽语催天晓，月上梨花放夜阑。\n莫听游人待妍暖，十分倾酒对春寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71568,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏咏高节亭边山矾花二首 其一","author":"黄庭坚","text":"北岭山矾取意开，轻风正用此时来。\n平生习气难料理，爱著幽香未拟回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71569,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏咏高节亭边山矾花二首 其二","author":"黄庭坚","text":"高节亭边竹已空，山矾独自倚春风。\n二三名士开颜笑，把断花光水不通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71570,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏咏猩猩毛笔二首 其二","author":"黄庭坚","text":"明窗脱帽见蒙茸，醉著青鞋在眼中。\n束缚归来傥无辱，逢时犹作黑头公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71571,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏咏猩猩毛笔二首 其一","author":"黄庭坚","text":"桄榔叶暗宾郎红，朋友相呼堕酒中。\n正以多知巧言语，失身来作管城公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71572,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏咏零陵李宗古居士家驯鹧鸪二首 其二","author":"黄庭坚","text":"真人梦出大槐宫，万里苍梧一洗空。\n终日忧兄行不得，鹧鸪应是鼻亭公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71573,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏咏零陵李宗古居士家驯鹧鸪二首 其一","author":"黄庭坚","text":"山雌之弟竹鸡兄，乍入雕笼便不惊。\n此鸟为公行不得，报晴报雨总同声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71574,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏咏蜡梅二首 其二","author":"黄庭坚","text":"体薰山麝脐，色染蔷薇露。\n披拂不满襟，时有暗香度。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71575,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏咏蜡梅二首 其一","author":"黄庭坚","text":"金蓓锁春寒，恼人香未展。\n虽无桃李颜，风味极不浅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71576,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏招饮客解酲","author":"黄庭坚","text":"破卯扶头把一杯，灯前风味唤仍回。\n高阳社里如相访，不用闲携恶客来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71577,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏答仇梦得承制二首 其二","author":"黄庭坚","text":"横槊不为万骑先，传杯把笔过年年。\n怀中黄石闲三略，道上青旗漫百篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71578,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏答仇梦得承制二首 其一","author":"黄庭坚","text":"结发从征听鼓鼙，未曾一展胸中奇。\n弯弓如月落霜雁，谁道将军能赋诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71579,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏答王子予送凌风菊二首 其二","author":"黄庭坚","text":"王郎颇病金瓢酒，不耐寒花晚更芳。\n瘦尽腰围怯风景，故来归我一枝香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71580,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏答王子予送凌风菊二首 其一","author":"黄庭坚","text":"病来孤负鸬鹚杓，禅板蒲团入眼中。\n浪说閒居爱重九，黄花应笑白头翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71581,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏答王观复酴醾菊二首 其二","author":"黄庭坚","text":"吕园未肯轻沽我，且寄田家砌下栽。\n他日秋花媚重九，清香知自故人来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71582,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏答王观复酴醾菊二首 其一","author":"黄庭坚","text":"谁将陶令黄金菊，幻作酴醾白玉花。\n小草真成有风味，东园添我老生涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71583,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏答王居士送文石","author":"黄庭坚","text":"南极一星天九秋，自埋光景落江流。\n是公至乐山中物，乞与衰翁似暗投。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71584,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏答史应之三首 其三","author":"黄庭坚","text":"甑有轻尘釜有鱼，汉庭日日召严徐。\n不嫌藜藿来同饭，更展芭蕉看学书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71585,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏答史应之三首 其二","author":"黄庭坚","text":"老莱有妇怀高义，不厌夫家苜蓿盘。\n收得千金不龟药，短裙漂絖暮江寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71586,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏答史应之三首 其一","author":"黄庭坚","text":"先生早擅屠龙学，袖有新硎不试刀。\n岁晚亦无鸡可割，庖蛙煎鳝荐松醪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71587,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏答龙泉余尉问禅二小诗 其一","author":"黄庭坚","text":"重帘复幕锁蛾眉，银烛金荷醉舞衣。\n长为扶头欠㪷酒，不关禅病减腰围。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71588,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏答龙泉余尉问禅二小诗 其二","author":"黄庭坚","text":"翻头作尾掉枯藤，腊月花开更造冰。\n何似清歌倚桃李，一炉沈水醉红灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71589,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏答张秘监馈羊","author":"黄庭坚","text":"细肋柔毛饱卧沙，烦公遣骑送寒家。\n忍令无罪充庖宰，留与儿童驾小车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71590,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏答李子真河上见招来诗颇誇河上风物聊以当嘲云","author":"黄庭坚","text":"浑浑旧水无新意，漫漫黄尘涴白鸥。\n安得江湖忽当眼，卧听禽语信船流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71591,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏答陈季常寄黄州山中连理松枝二首 其二","author":"黄庭坚","text":"老松连枝亦偶然，红紫事退独参天。\n金沙滩头锁子骨，不妨随俗暂婵娟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71592,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏答陈季常寄黄州山中连理松枝二首 其一","author":"黄庭坚","text":"故人折松寄千里，想听万壑风泉音。\n谁言五鬣苍烟面，犹作人间儿女心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71593,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏答荆州王充道烹茶四首 其四","author":"黄庭坚","text":"龙焙东风鱼眼汤，个中即是白云乡。\n更煎双井苍鹰爪，始耐落花春日长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71594,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏答荆州王充道烹茶四首 其三","author":"黄庭坚","text":"香从灵坚垄上发，味自白石源中生。\n为公唤觉荆州梦，可待南柯一梦成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71595,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏答荆州王充道烹茶四首 其二","author":"黄庭坚","text":"茗椀难加酒椀醇，暂时扶起藉糟人。\n何须忍垢不濯足，苦学梁州阴子春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71596,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏答荆州王充道烹茶四首 其一","author":"黄庭坚","text":"三径虽锄客自稀，醉乡安稳更何之。\n老翁更把春风椀，灵府清寒要作诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71597,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏答晁深道乞消梅二首 其二","author":"黄庭坚","text":"北客未尝眉自颦，南人誇说齿生津。\n磨钱和蜜谁能许，去蒂供盐亦可人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71598,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏答晁深道乞消梅二首 其一","author":"黄庭坚","text":"青莎径里香未乾，黄鸟阴中实已团。\n蒸豆作乌盐作白，属闻丹杏荐牙盘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71599,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏答诸君追和予去年醉碧桃","author":"黄庭坚","text":"当时倒著接䍦回，不但碧桃邀我来。\n白蚁拨醅官酒满，紫绵揉色海棠开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71600,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏题大年防禦芦雁","author":"黄庭坚","text":"挥毫不作小池塘，芦荻江村落雁行。\n虽有珠帘藏翡翠，不忘烟雨罩鸳鸯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71601,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏题曾处善尉厅二首 其一 超然台","author":"黄庭坚","text":"鸡埘啄雁如鴐鹅，万里天衢且一波。\n宫锦络衫弓石八，与人同状不同科。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71602,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏赠元翁","author":"黄庭坚","text":"从来五字弄珠玑，忍负僧床锁翠微。\n传语风流三语掾，何时缀我百家衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71603,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏赠世弼用前韵","author":"黄庭坚","text":"盗蹠人肝常自饱，首阳薇蕨向来饥。\n谁能著意知许事，且为元长食蛤蜊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71604,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏赠米元章二首 其二","author":"黄庭坚","text":"我有玄晖古印章，印刓不忍与诸郎。\n虎儿笔力能扛鼎，教字玄晖继阿章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71605,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏赠米元章二首 其一","author":"黄庭坚","text":"万里风帆水著天，麝煤鼠尾过年年。\n沧江静夜虹贯月，定是米家书画船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71606,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"朱道人下世","author":"黄庭坚","text":"桑户居然同物化，青灯犹在读书檠。\n身如陌上狂风过，心似夜来新月明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71607,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂诗","author":"黄庭坚","text":"迷时今日如前日，悟后今年似去年。\n随食随衣随事办，谁知佛印祖师禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71608,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂诗","author":"黄庭坚","text":"古风萧索不言归，贫贱交情富贵非。\n世祖本无天下量，子陵何慕钓鱼矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71609,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂诗","author":"黄庭坚","text":"迷情淡荡不知津，老却平生梦幻身。\n满眼纷华心寂寞，长安市上酒家人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71610,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂诗七首 其七","author":"黄庭坚","text":"碧窗凉簟唯便睡，露井无尘荫绿槐。\n梦入醉乡犹病渴，辘轳声到枕边来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71611,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂诗七首 其六","author":"黄庭坚","text":"古屋清寒雪未消，小窗晴日展芭蕉。\n酸甘荔子尝春酒，更碾新芽荐菊苗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71612,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂诗七首 其五","author":"黄庭坚","text":"薰炉茶鼎偶然同，晴日鸦啼柿叶风。\n万事尽还曲居士，百年常在大槐宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71613,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂诗七首 其四","author":"黄庭坚","text":"少年不爱万金身，歌舞寻春愁送春。\n满眼纷华心寂寞，长安市上酒家人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71614,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂诗七首 其三","author":"黄庭坚","text":"馆甥宫里叹才难，当日同朝听百官。\n光武早知尧舜事，只今那得子陵滩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71615,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂诗七首 其二","author":"黄庭坚","text":"营巢燕燕几时休，在处成家春复秋。\n岁岁自来还自去，主人无厌客无求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71616,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂诗七首 其一","author":"黄庭坚","text":"此身天地一蘧庐，世事消磨绿鬓疏。\n毕竟几人真得鹿，不知终日梦为鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71617,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂诗四首 其四","author":"黄庭坚","text":"黄帝炼丹求子母，神农尝药辨君臣。\n如何苦思形中事，忧患从来为有身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71618,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂诗四首 其三","author":"黄庭坚","text":"小德有为因有累，至神无用故无功。\n须知广大精微处，不在存亡得失中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71619,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂诗四首 其二","author":"黄庭坚","text":"佛子身归乐国遥，至人神会碧天寥。\n劫灰沈尽还生妄，但向平沙看海潮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71620,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂诗四首 其一","author":"黄庭坚","text":"扁舟江上未归身，明月清风作四邻。\n观化悟来俱是妄，渐疏人事与天亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71621,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵子瞻子由题憩寂图二首 其二","author":"黄庭坚","text":"龙眠不似虎头痴，笔妙天机可并时。\n苏仙漱墨作苍石，应解种花开此诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71622,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵子瞻子由题憩寂图二首 其一","author":"黄庭坚","text":"松寒风雨石骨瘦，法窟寂寥僧定时。\n李侯有句不肯吐，淡墨写出无声诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71623,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵子瞻送穆父二绝 其一","author":"黄庭坚","text":"渺然今日望人材，每见紫芝眉宇开。\n又触惠文江海去，快帆谁与挽令回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71624,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵子瞻送穆父二绝 其二","author":"黄庭坚","text":"谪官犹得住蓬莱，抱牍人稀书卷开。\n张敞怃眉应急召，董宣强项莫低回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71625,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵中玉水仙花二首 其二","author":"黄庭坚","text":"淤泥解作白莲藕，粪壤能开黄玉花。\n可惜国香天不管，随缘流落小民家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71626,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵中玉水仙花二首 其一","author":"黄庭坚","text":"借水开花自一奇，水沈为骨玉为肌。\n暗香已压酴醾倒，只比寒梅无好枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71627,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵中玉早梅二首 其二","author":"黄庭坚","text":"折得寒香不露机，小窗斜日两三枝。\n罗帷翠幕深调护，已被游蜂圣得知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71628,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵中玉早梅二首 其一","author":"黄庭坚","text":"梅蕊争先公不嗔，知公家有似梅人。\n何时各得自由去，相逐扬州作好春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71629,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵元礼春怀十首 其十","author":"黄庭坚","text":"闻道邻家有酒瓶，三更不卧叩柴扃。\n我身便是鸱夷榼，肯学离骚要独醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71630,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵元礼春怀十首 其九","author":"黄庭坚","text":"冉冉光阴花柳场，红飘紫落便蔫黄。\n都无畔岸随风去，却是游丝意思长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71631,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵元礼春怀十首 其八","author":"黄庭坚","text":"老杜当年鬓发华，尚言春到酒须赊。\n不堪诗思相料理，恼乱街头卖酒家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71632,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵元礼春怀十首 其七","author":"黄庭坚","text":"穿花蹴踏千秋索，挑菜嬉游二月晴。\n已被风光催我老，懒随儿辈绕春城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71633,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵元礼春怀十首 其六","author":"黄庭坚","text":"春风也似江南早，梅与辛夷斗著花。\n自是无言桃李晚，莫嗔榆柳更萌芽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71634,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵元礼春怀十首 其五","author":"黄庭坚","text":"春来问字有谁过，颇觉闲销日月多。\n醉里乾坤知酒圣，贫中风物似诗魔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71635,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵元礼春怀十首 其四","author":"黄庭坚","text":"久无长者回车辙，仲蔚门墙映野蒿。\n稍觉春衣生虮虱，南窗晴日照爬搔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71636,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵元礼春怀十首 其三","author":"黄庭坚","text":"故园春色常年早，红紫知他破几苞。\n压帽花枝如可折，折花手版直须抛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71637,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵元礼春怀十首 其二","author":"黄庭坚","text":"春心分付酒杯销，勿为浮云妄动摇。\n试觅金张池馆问，几人能插侍中貂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71638,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵元礼春怀十首 其一","author":"黄庭坚","text":"渐老春心不可言，亦如琴意在无弦。\n新花准拟千场醉，美酒经营一百船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71639,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵公择雨后","author":"黄庭坚","text":"二圣勤民损膳羞，雨馀今见角田秋。\n碧酒尚堪遮眼醉，红榴不解替人愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71640,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵文潜立春日三绝句 其三","author":"黄庭坚","text":"江山也似随春动，花柳真成触眼新。\n清浊尽须归瓮蚁，吉凶更莫问波臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71641,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵文潜立春日三绝句 其二","author":"黄庭坚","text":"谁怜旧日青钱选，不立春风玉笋班。\n传得黄州新句法，老夫端欲把降幡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71642,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]