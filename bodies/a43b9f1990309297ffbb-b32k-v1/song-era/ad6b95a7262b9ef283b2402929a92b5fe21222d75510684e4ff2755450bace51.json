[{"title":"赠僧道澄","author":"孙谔","text":"闻说虞山有道澄，白云深处不闻扃。\n自言古佛何为者，只是无心一老僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48801,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"孙谔","text":"竹林藏月读书家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48802,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"资圣院","author":"孙谔","text":"四山藏一寺，方丈压诸峰。\n回首坐禅处，白云深几重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48803,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题江滨驿","author":"孙谔","text":"渡江始至长江县，返照雨馀村落明。\n此地曾经诗客到，九秋风月至今清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48804,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"文州","author":"孙谔","text":"烟笼合处日华明，龙女山横拥郡城。\n番马远随流水至，边人高入白云耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48805,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"孙谔","text":"秋空独见周王庙，夜月犹悬蜀将营。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48806,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闲咏","author":"查深","text":"门外声声叫卖鱼，囊空不问价何如。\n磁盆昨夜黄齑熟，淡饭时光乐有馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48807,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"啄木","author":"马道","text":"翠翎迎日动，红觜响烟萝。\n不顾泥丸及，唯贪得食多。\n才离枯朽木，又上最高柯。\n吴楚园林阔，忙忙争奈何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48808,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠仙翁三首 其一","author":"钱忠","text":"八十清翁今钓客，一纶一艇一鱼蓑。\n碧潭波底系船卧，红蓼香中对月歌。\n玉脍盈盘同美酒，锦鳞随手出清波。\n风烟幽隐无人到，俗客如何愿一过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48809,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠仙翁三首 其二","author":"钱忠","text":"小舟泛泛游春水，竹笠团团覆败蓑。\n盈棹长风三尺浪，满船明月一声歌。\n非干奔走厌浮世，自是情怀慕素波。\n惟有仙翁为密友，就鱼携酒每相过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48810,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠仙翁三首 其三","author":"钱忠","text":"吴江高隐仙乡客，衰鬓长髯白发乾。\n满目生涯千顷浪，全家衣食一纶竿。\n长桥水隐秋风软，极浦烟浮夜钓寒。\n因笑区区名利者，是非荣辱苦相干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48811,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠姑子王师孟","author":"钱忠","text":"水国神仙宅，吾今过此中。\n长桥千古月，不复怨春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48812,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和钱忠","author":"吴江老人","text":"向晚云晴无限好，船头又见乱堆蓑。\n却无尘世利名厌，尽是市朝兴废歌。\n全宅合来居水泽，此身常得弄烟波。\n肥鱼美酒尤丰足，自是幽人不愿过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48813,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与钱忠","author":"吴江女子","text":"昨日相逢小木桥，风牵裙带缠郎腰。\n此情不语无人觉，只恐猜疑眼动摇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48814,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又与钱忠","author":"吴江女子","text":"轻桡直入湖心里，渡入荷花窣窣鸣。\n何处渔谣相调戏，住船侧耳认郎声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48815,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题壁","author":"戴敷","text":"湖中烟水平天远，波上佳人恨未休。\n收拾鸳鸯好归去，满船明月洞庭秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48816,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠王幼玉","author":"柳富","text":"紫府楼阁高相倚，金碧户牖红晖起。\n其间燕息皆仙子，绝世妖姿妙难比。\n偶然思念起尘心，几年谪向衡阳市。\n阿娇飞下九天来，长在娼家偶然耳。\n天姿才色拟绝伦，压倒花衢众罗绮。\n绀发浓堆巫峡云，翠眸横剪秋江水。\n素手纤长细细圆，春笋脱向青云里。\n纹履鲜花窄窄弓，凤头翅起红裙底。\n有时笑倚小栏杆，桃花无言乱红委。\n王孙逆目似劳魂，东邻一见还羞死。\n自此城中豪富儿，呼僮控马相追随。\n千金买得歌一曲，暮雨朝云镇相续。\n皇都年少是柳君，体段风流万事足。\n幼玉一见苦留心，殷勤厚遣行人祝。\n青羽飞来洞户前，惟郎苦恨多拘束。\n偷身不使父母知，江亭暗共才郎宿。\n犹恐恩情未甚坚，解开鬟髻对郎前。\n一缕云随金剪断，两心浓更密如绵。\n自古美事多磨隔，无时两意空悬悬。\n清宵长叹明月下，花时洒泪东风前。\n怨入朱弦危更断，泪如珠颗自相连。\n危楼独倚无人会，新书写恨托谁传。\n奈何幼玉家有母，知此端倪蓄嗔怒。\n千金买醉嘱佣人，密约幽欢镇相误。\n将刃欲加连理枝，引弓欲弹鹣鹣羽。\n仙山只在海中心，风逆波紧无船渡。\n桃源去路隔烟霞，咫尺尘埃无觅处。\n郎心玉意共殷勤，同指松筠情愈固。\n愿郎誓死莫改移，人事有时自相遇。\n他日得郎归来时，携手同上烟霞路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48817,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又赠","author":"柳富","text":"临流对月暗悲酸，瘦立东风自怯寒。\n湘水佳人方告疾，帝都才子亦非安。\n春蚕到死丝方尽，蜡烛成灰泪始乾。\n万里云山无路去，虚劳魂梦过湘滩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48818,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏海","author":"刘大方","text":"沌元初一判，天地此居洼。\n今古乾坤腹，朝昏明月家。\n阔疑包地尽，势欲极天涯。\n誓斩鲸鲵辈，临风按镆铘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48819,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏泰山","author":"刘大方","text":"万古春之主，群山孰可曹。\n都因敦厚大，不是险㠊高。\n顶衬天地愁，根盘野□牢。\n坎离分背面，明月转周遭。\n仙馆鸾朝舞，神亭鬼夜号。\n云来诸夏雨，风去百川涛。\n东渭藏阴重，西秦抱势豪。\n龙蛇藏隙穴，草木立毫毛。\n陕谷三升土，黄河五尺壕。\n暂登临日观，直下钓灵鳌。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48820,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"病虎行","author":"刘大方","text":"海北愁云无从裂，风如追兵雪如撒。\n哀者老虎病无力，百尺泉源都冻绝。\n山中牛羊竟不来，牙爪寂寂伤饥渴。\n万里兵刃色惨悽，獐娇鹿倨豺狼悦。\n安得肉食复如初，平地纷纷羽毛血。\n一吼千年白日寒，群兽幽忧心骨折。\n如今缠病未能兴，长戈硬弩无相杀。\n世上青山不敢生，青山尽是狐狸穴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48821,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鼎湖","author":"张因","text":"有唐天子天宝初，礼官学士披图书。\n推本黄帝九云车，曾跨火龙升天衢。\n世传虢略留鼎湖，世传桥山晏神舆。\n真人起灭不异涂，霓来吹落火龙须。\n一须落处生万芜，春风秋霜荣复枯。\n顶峰千丈金芙蕖，一叶金华落婺墟。\n天子闻之为嗟吁，大封山川名仙都。\n姓刘天师半山居，修真自结草屠苏。\n始严祠宇辟一区，至今名篆存珷玞。\n上下万年变万殊，水云依旧本扶疏。\n事载咸通端不诬，世更五代迹不除。\n钜宋兴王握乾符，庆源尊祖礼何如。\n乃命天下严殿庐，治平天子榜玉虚。\n北客南来一字无，飘飘含蓼政如荼。\n崆峒童子真吾徒，心闲神应微嗫嚅。\n尽收胜概赋归欤，归去山东作画图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48822,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏沙","author":"龙太初","text":"茫茫黄出寒，漠漠白铺汀。\n鸟去风平篆，潮回日射星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48823,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"四皓吟","author":"释智孜","text":"忠义合时难，云林共掩关。\n因秦生白发，为汉出青山。\n不顾金章贵，终披白氅还。\n如今明圣代，高躅更难攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48824,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"释智孜","text":"五十春秋，如电如露。\n月映寒江，分明归去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48825,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄子","author":"洪浩父","text":"太学何蕃且一归，十年甘旨误庭闱。\n休辞客路三千远，须念人生七十稀。\n腰下虽无苏子印，箧中幸有老莱衣。\n归期定约春前后，免使高堂赋式微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48826,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诗一首","author":"王俊民","text":"寒窗一夜雪，纷纷来朔风。\n之子动归兴，轻袂飘如蓬。\n问子何所之，家在济水东。\n问子何所学，上庠教化宫。\n行将携老母，寓居学其中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48827,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重九","author":"邵睦","text":"衣如当日白，花似昔年黄。\n拟问东篱事，寒香入杳茫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48828,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"释道全","text":"一搥打透无尽藏，一切珍宝吾皆有。\n拈来普济贫乏人，免使波吒路边走。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48829,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋晓","author":"释道全","text":"飘飘枫叶草萋萋，云压天边雁阵低。\n何处水村人起早，橹声摇月过桥西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48830,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题法安院","author":"释道全","text":"半生梦想到山宫，此日殷勤兴莫穷。\n寺在烟霏空翠里，人游水墨画图中。\n青松夹道晓云合，黄叶满山秋露浓。\n满眼新诗酬未尽，再来宁愧锦囊空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48831,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题林景思权巢 其一","author":"释道全","text":"不嫌茅把盖头低，为爱平檐野雪迷。\n自与芦花梦明月，夜寒空误鹤来栖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48832,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题林景思权巢 其二","author":"释道全","text":"田地虚明不受尘，巢中人是个中人。\n勿言一色浑无迹，月到梅梢亦转身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48833,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题宝严寺","author":"释道全","text":"出郭二十里，过山三用村。\n竹深疑有寺，路僻不知门。\n万木辞穷腊，三峰佔落曛。\n灵源正脉在，惭愧有云孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48834,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登飞泉寺","author":"吴革","text":"石磴盘空逼汉槎，凭栏睇盼渺天涯。\n穹窿巧凿三千界，瀑泻狂飞百里家。\n歌鸟当檐喧丽日，薰风拂座舞岩花。\n不须更觅蓬莱胜，此地登临亦足誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48835,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题李进士连云玉山图像","author":"吴革","text":"玉山嵯峨白云里，翠楼鸿濛插天起。\n千丈芙蓉云作梯，玉龙翻然吼秋水。\n山中隐人云锦袍，掉头不受柯山招。\n玉手广寒修月斧，蹑云每向云间樵。\n朝采山花树，暮拾古木枝。\n俯仰隘六合，间与白云期。\n白云飞来归丹壑，山人揽之不盈握。\n袖怀五色朝天门，捧日絪缊散寥廓。\n左挟丹凤翱，右骖青龙翔。\n搜材尽作庙廊具，紫极出入生辉光。\n懒逐刍荛人，局促涅尘土。\n白衣苍狗徒纷纭，万变目前何足数。\n舒展岂无心，秪在深山处。\n四海苍生望太平，济旱终须霭霖雨。\n我亦巢云庐云山，看花早种东华莲。\n南归何日分半榻，抚掌一笑三千年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48836,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游碧落洞","author":"李兟","text":"遐迩开胜概，憧憧往来侵。\n共认融结意，独符仁智心。\n得侣赏清尘，弥日穷幽深。\n奇哉周羽皇，雄文无古今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48837,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游碧落洞同李兟诸公","author":"冯慜","text":"绝景尘不到，暂游神已清。\n云岫敛晴色，风桂含秋声。\n自得泉石兴，谁贪轩冕荣。\n巢由值兹室，必无箕颍名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48838,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"释子鸿","text":"一不守，二不向，上下四维无等量。\n大洋海里泛铁船，须弥顶上翻鲸浪。\n临济缩却舌头，德山阁却拄杖。\n千古万古独巍巍，留与人间作榜样。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48839,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"村老","author":"马存","text":"肉死皮乾垂鬓丝，寻暄扶杖向东篱。\n文王没后无人问，直至而今大半饥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48840,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"长淮谣为徐先生咏","author":"马存","text":"长淮之水青如苔，行人但觉心眼开。\n湘江岂无水，鱼腹忠魂埋，但见愁云结雨猿声哀。\n浙江岂无水，鸱革漂胥骸，但见潮头怒气如山来。\n孤臣词客到江上，何以宽心怀。\n长淮之水绕楚流，先生家住淮上头。\n黄金万斛浴明月，碧玉一片含清秋。\n酒花入面歌一曲，淮上百物无闲愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48841,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题梅仙观","author":"马存","text":"汉纲解宏纽，国命移权臣。\n太阿有神锋，颠倒柄在人。\n公卿虽满前，有语各自吞。\n张禹为帝师，此是祸乱根。\n天子辟左右，决机在一言。\n不为社稷计，祇乞儿女恩。\n上方斩马剑，当时负朱云。\n谷永对直言，天庭策灾氛。\n阴谋助元恶，归咎昭阳嫔。\n豺狼自此纵，白昼当路蹲。\n先生当是时，上书叩帝阍。\n耿耿祸福语，皎皎星与辰。\n天门锁九重，一门万夫屯。\n小臣江湖心，何由达至尊。\n贼莽果盗国，忠烈遭烹焚。\n先生变名姓，为卒吴市门。\n浮云去无踪，世人以为仙。\n蓬山在何处，此事且勿论。\n但爱清风高，凛凛久益新。\n我来拜遗像，旧宅荒基存。\n元丰发新诏，玉牒对寿春。\n老松益劲色，岁饱霜雪痕。\n直上绝顶坛，天风吹衣巾。\n细读壁间书，颇喜罗隐文。\n恨叹有鲠语，使我气益振。\n回视饱食徒，茫茫如埃尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48842,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"邀月亭","author":"马存","text":"亭上十分绿醑酒，盘中一箸黄金鸡。\n沧溟东角邀姮娥，水轮碾上青琉璃。\n天风洒扫浮云没，千岩万壑琼瑶窟。\n桂花飞影入盏来，倾下胸中照清骨。\n玉兔捣药与谁餐，且与豪客留朱颜。\n朱颜如可留，恩重如丘山。\n为君杀却虾蟆精，腰间老剑光芒寒。\n举酒劝明月，听我歌声发。\n照见古人多少愁，更与今人照离别。\n我曹自是高阳徒，肯学群儿叹圆缺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48843,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"燕思亭","author":"马存","text":"李白骑鲸飞上天，江南风月闲多年。\n纵有高亭与美酒，何人一斗诗百篇。\n主人定是金龟老，未到亭中名已好。\n紫蟹肥时晚稻香，黄鸡啄处秋风早。\n我忆金銮殿上人，醉著宫锦乌角巾。\n巨灵摩山洪河竭，长鲸吸海万壑贫。\n如倾元气入胸腹，须臾百媚生阳春。\n读书不必破万卷，笔下自有鬼与神。\n我曹本是狂吟客，寄语溪山莫相忆。\n他年须使襄阳儿，再唱铜鞮满街陌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48844,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄范安道","author":"马存","text":"西山石脚盘如城，芙蓉峰插龙泉精。\n有客高卧青云层，孤吟自作太古声。\n古声无味淡如水，今人有耳甜如饧。\n君不见登高山，泛流水，子期已没不复生，几世几年无此耳。\n恨君不到苍岩阴，不见此客摇头吟。\n千崖万壑群动息，相知唯有清泉音。\n春风捲野浓如波，着人如醉将奈何。\n几时见我铜鞮陌，为唱襄阳拍手歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48845,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浩浩歌","author":"马存","text":"浩浩歌，天地万物如吾何。\n用之解带食太仓，不用拂枕归山阿。\n君不见渭川渔父一竿竹，莘野耕叟数亩禾。\n喜来起作商家霖，怒后便把周王戈。\n又不见子陵横足加帝腹，帝不敢动岂敢诃。\n皇天为忙逼，星辰相系摩。\n可怜相府痴，邀请先经过。\n浩浩歌，天地万物如吾何。\n屈原枉死汩罗水，夷齐空卧西山坡。\n丈夫荦荦不可羁，有身何用自灭磨。\n吾观圣贤心，自乐岂有他。\n苍生如命穷，吾道成蹉跎。\n直须为吊天下人，何必嫌恨伤邱阿。\n浩浩歌，天地万物如吾何。\n玉堂金马在何处，云山石室高嵯峨。\n低头欲耕地虽少，仰面长笑天何多。\n请君醉我一斗酒，红光一面春风和。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48846,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"马存","text":"可怜一觉登天梦，不梦商岩梦邓郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48847,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"神宗皇帝挽词 其一","author":"王子韶","text":"宝饵方叽玉，金盘忽造冰。\n周人悲地坼，杞国怨天崩。\n杳雾霾阴月，鲵膏耿夜灯。\n伤心歌舞妓，洒血望西陵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48848,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"神宗皇帝挽词 其二","author":"王子韶","text":"脱屣人寰忽上天，投渊果熟会群仙。\n帐宫云暝龙为驾，缀幄天寒鹤记年。\n万里出师轻卫霍，一朝行事付谈迁。\n功名半古升遐早，独抱遗弓涕泫然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48849,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"王子韶","text":"孤云两角，去天一握。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48850,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诗一首","author":"曾布","text":"晓出东郊信马蹄，青梅墙角两三枝。\n竹鸡啼罢雨来急，杜宇声乾月落迟。\n山店煮烟缫丝日，野田锄水插秧时。\n农桑劝课非无力，为报新安太守知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48851,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"表海亭","author":"曾布","text":"表海风流旧所闻，青冥飞观一番新。\n山河十二名空在，簪履三千迹已陈。\n极目烟岚九霄近，满州楼阁万家春。\n由来兴废南柯梦，且喜登临属后人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48852,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"布作高阳台众乐园成被命与金陵易地兄弟待罪侍从对更方面实为私门之庆走笔记子开弟","author":"曾布","text":"楼台丹碧照天涯，塞北江南未足誇。\n十里烟波新种柳，万株桃李未开花。\n一麾同下西清路，两镇高迎上将牙。\n回首林塘莫留恋，风光还属阿连家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48853,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"灵泉寺","author":"曾布","text":"一掬寒泉照眼明，冰霜凛凛坐中清。\n生刍想见当时客，华屋空留后世名。\n晓日净涵金碧影，秋风暗动佩环声。\n他年卜筑南山下，白首何人共濯缨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48854,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"盱江","author":"曾布","text":"军山流泉初滥觞，缭绕东山为盱江。\n峰峦隐映渊源长，地灵物秀雄吾邦。\n麻源三谷神仙乡，高林远岫长相望。\n岿然飞观临沧浪，凝岚净练罗轩窗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48855,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和陈倩游曾公岩韵","author":"曾布","text":"从事区区厌独贤，寻幽深入翠微间。\n旋开榛莽东郊路，偶得神仙旧隐山。\n都峤三天临瘴水，灵岩十里接溪蛮。\n何如咫尺邻风穴，杖履时时一往还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48856,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和刘谊留题融州老君岩 其一","author":"曾布","text":"神仙遗像出天真，造化胚浑岂易言。\n访古寻幽空有意，白头轩冕感君恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48857,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和刘谊留题融州老君岩 其二","author":"曾布","text":"鹿龙高蹑九霄难，共驾仙车去不还。\n遗迹至今空有桧，不知蝉蜕此山间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48858,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"曾布","text":"惊嗟怪怪文人奇，缟衣蓝缕冰断肌。\n莓苔雪片冻不飞，玉饰其末玑衡攲。\n藐姑之仙下缥缈，苍虬为驾羽荷希。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48859,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"曾布","text":"海边憔悴多情客，想见一枝寒玉色。\n愿君攀折赠馀香，勿使随风自狼籍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48860,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其三","author":"曾布","text":"天际林峦压寿邱，夹江旁瞰两三州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48861,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]