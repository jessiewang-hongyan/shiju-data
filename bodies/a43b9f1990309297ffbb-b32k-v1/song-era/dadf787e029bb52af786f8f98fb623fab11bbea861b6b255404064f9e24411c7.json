[{"title":"端午帖子九首 其六","author":"曹勋","text":"曲槛榴花绛色鲜，博山一缕水沉烟。\n奉华窗户清无暑，习习香传远岸莲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65032,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端午帖子九首 其五","author":"曹勋","text":"朝下仙班晓景迟，步摇香认九华妃。\n花藏窈窕知金屋，亭照回波在翠微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65033,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端午帖子九首 其四","author":"曹勋","text":"日华露重疏疏竹，宝砌风回楚楚松。\n酪粉冰壶驱薄暑，瑶琴永日得从容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65034,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端午帖子九首 其三","author":"曹勋","text":"辟兵龙印篆神经，系臂香萦绣色轻。\n自有微凉生玉宇，池光静照午阴清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65035,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端午帖子九首 其二","author":"曹勋","text":"怡颜无暑到新宫，一样珠帘广殿风。\n角黍菖丝随节物，旨甘时下五云中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65036,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端午帖子九首 其一","author":"曹勋","text":"非烟苒苒上宫云，嘉木团团午影分。\n玉案琴书供燕适，五弦清韵助南薰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65037,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"聚景园看荷花","author":"曹勋","text":"四山收尽一天云，水色天光冷照人。\n面面荷花供眼界，顿如身不在凡尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65038,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蔡提举野望亭邀同赋","author":"曹勋","text":"饭了从容人岂知，一江风月入新诗。\n登临莫负野望处，更看冷云堆浦时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65039,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"德寿春帖子八首 其八","author":"曹勋","text":"袅袅柔风泮绿波，深沉甲馆已微和。\n新春玉带香罗薄，从此宫中乐事多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65040,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"德寿春帖子八首 其七","author":"曹勋","text":"向晓天中月一痕，春阳先到凤凰门。\n苑中斗草寻芳处，日日春熙奉至尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65041,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"德寿春帖子八首 其六","author":"曹勋","text":"露香栏槛已青青，梅萼惊春照坐明。\n天极元妃资内助，常年春首祝椿龄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65042,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"德寿春帖子八首 其五","author":"曹勋","text":"椒房懿德庆源同，环佩雍容冠六宫。\n妆罢朝元无一事，关雎诗咏二南风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65043,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"德寿春帖子八首 其四","author":"曹勋","text":"腊馀七日换年华，玉砌青萱半吐芽。\n竹色松声清似玉，未须剪綵作春花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65044,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"德寿春帖子八首 其三","author":"曹勋","text":"捲帘康寿丽朝曦，经卷龙香昼漏迟。\n闲暇瑶琴成雅奏，和风吹入万年枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65045,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"德寿春帖子八首 其二","author":"曹勋","text":"弄黄宫柳未齐匀，便觉风和淑景新。\n自是东君朝最贵，欣欣春事足颐神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65046,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"德寿春帖子八首 其一","author":"曹勋","text":"晓来帘幕捲东风，尚有春寒下绮栊。\n德满人间和气浃，卯山宫殿瑞云中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65047,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题丁掾钓雪图","author":"曹勋","text":"连鳌妙手舣前湾，蓑笠琴书得自安。\n更待一轮清月上，静看千顷玉光寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65048,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题人画扇十首 其十 雪景","author":"曹勋","text":"惨惨江天散六花，磷磷寒碧不藏砂。\n扁舟蓑笠撑何去，应向溪头问酒家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65049,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题人画扇十首 其九 竹禽","author":"曹勋","text":"野林物物适幽栖，春引风高裂石时。\n何处双禽飞不定，静宜翠竹亚寒枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65050,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题人画扇十首 其八 来禽","author":"曹勋","text":"烟苞绿叶拥祥云，一种芳菲秀色新。\n密蓓临风凝重露，横枝照眼觉浓春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65051,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题人画扇十首 其七 獐猿","author":"曹勋","text":"长沙笔墨妙山林，植立如听啸月音。\n岸槲不妨俱遂性，一溪闲与照清深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65052,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题人画扇十首 其六 末利绣蝶","author":"曹勋","text":"薰风栏槛送微凉，洁白南花玉蕊芳。\n倚径一枝殊楚楚，任教蜂蝶绕清香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65053,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题人画扇十首 其五 风柳黄莺","author":"曹勋","text":"柳已如眉拂上林，细风吹动绿烟深。\n东君巧欲装春色，更引黄鹂啭好音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65054,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题人画扇十首 其四 獐","author":"曹勋","text":"槲叶声乾雪尚浮，驯和群出映寒流。\n啼猿不在关山冷，相顾应无羽猎忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65055,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题人画扇十首 其三 羊","author":"曹勋","text":"宽围绿野正华滋，放牧横溪草软时。\n跪乳从兹富原隰，尚羔先喜咏来思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65056,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题人画扇十首 其二 牛","author":"曹勋","text":"一川芳草接浓云，拂地垂杨带雨昏。\n蓑笠不堪牛背湿，迎风呼犊趁柴门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65057,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题人画扇十首 其一 雁","author":"曹勋","text":"雪馀蒲苇衬沙黄，野水寒清雁半翔。\n柳下摇风云漠漠，飞鸣应喜下潇湘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65058,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题山景二首 其二","author":"曹勋","text":"乱山苍翠霭岚光，采药幽人凤子香。\n路转峰回茅舍静，好寻绝顶访僧房。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65059,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题山景二首 其一","author":"曹勋","text":"林薄空濛未见花，萦纡一径向溪斜。\n杖藜倚待船中客，山崦同寻卖酒家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65060,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题光武庙三首 其三","author":"曹勋","text":"九州思汉定雄夫，天下雄夫待一呼。\n冰亦复随人意合，从来大度自同符。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65061,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题光武庙三首 其二","author":"曹勋","text":"故人高卧枕严溪，香火纷纷俗不疲。\n倘赞提封如帝业，也分百户奉真祠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65062,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题光武庙三首 其一","author":"曹勋","text":"陇蜀趋风泣向隅，征途殊喜读双趺。\n他年新载碑中语，百万俱摧历古无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65063,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题张太尉画","author":"曹勋","text":"一带烟沙接冷云，平林寂历夕阳昏。\n轻舟急桨归何处，应住山前黄叶村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65064,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题李次仲庵中","author":"曹勋","text":"杖藜乘兴出江头，自挂青钱买小舟。\n祈问仙翁餐玉法，便风一日到严州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65065,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题岸老庵居","author":"曹勋","text":"唯庵无住老禅人，一坐中间远世纷。\n不讨毗耶方丈饭，应思雨满北山云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65066,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题建宁府分水岭铺","author":"曹勋","text":"三年闽海类飘萍，今近天枢第一星。\n虽是玉京犹万里，江南山已望中青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65067,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题钓台","author":"曹勋","text":"遐想先生后世名，常如山水四时青。\n因知功业成何事，归美惟消犯帝星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65068,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题俞㨷画八景 其六 赤壁扁舟","author":"曹勋","text":"轻舟短棹下安流，回首烟江望夕楼。\n却记阿瞒当日事，灰飞烟灭只供愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65069,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题俞㨷画八景 其一 浙江观潮","author":"曹勋","text":"吴越山高紫翠重，浙江东下竦双峰。\n峰前忽涌东西白，飞舞潮头万玉龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65070,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题俞㨷画八景 其二 鉴湖垂钓","author":"曹勋","text":"千秋人去水云空，只有荷花绕岸红。\n寄语阿溪垂钓处，莫教闲却一丝风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65071,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题俞㨷画八景 其七 鄂渚晴光","author":"曹勋","text":"上下天光一碧时，白蘋红蓼照晴晖。\n汉阳树远江烟起，黄鹤楼空燕子归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65072,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题俞㨷画八景 其四 庐山霁色","author":"曹勋","text":"兹山泉石压江西，肩衲枯禅万众栖。\n欲向南州理烟艇，香炉先望紫云低。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65073,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题俞㨷画八景 其五 海门夕照","author":"曹勋","text":"秋涛初过静鱼龙，海纳斜阳万顷红。\n待向焦山留夕月，一帆犹记挂西风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65074,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题信州月岩寺","author":"曹勋","text":"不长凡花不长松，山藏月影紫云中。\n巨灵巧凿如规玉，借与神仙上桂宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65075,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题显恩寺","author":"曹勋","text":"笋舆轧轧度林峦，投宿招提一枕宽。\n尚有山头半峰雪，助成清夜五更寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65076,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题泉州延福寺壁","author":"曹勋","text":"春深犹未试春衣，漠漠轻寒酒力微。\n堪笑杨花太轻薄，淡烟细雨不教肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65077,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题倚江图","author":"曹勋","text":"有客登临酒半酣，道人仍为扫烟岚。\n瘦筇更约风尘上，粥饭老同弥勒龛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65078,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题家园海棠小亭壁","author":"曹勋","text":"万点匀红上海棠，小亭无处著春光。\n放教晓日滋新彩，要问东君学醉妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65079,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题扇二十四首 其二十四","author":"曹勋","text":"燕尾溪头晚色分，蜂腰山断日斜曛。\n半篙碧静秋垂钓，一棹黄昏冷载云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65080,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题扇二十四首 其二十三","author":"曹勋","text":"秋风天净绝纤痕，且喜新凉莫更论。\n坐上捲帘人未醉，秋香满院月黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65081,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题扇二十四首 其二十二","author":"曹勋","text":"暂脱尘埃污履絇，白云坐看起天隅。\n笋梢解箨摇新翠，为作麾幢执万夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65082,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题扇二十四首 其二十一","author":"曹勋","text":"雨馀湖上数峰青，湖水连天似镜平。\n一棹迎凉快襟袖，香从蘋末晚风生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65083,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题扇二十四首 其二十","author":"曹勋","text":"残春已去不堪招，犹喜莺声破寂寥。\n花片片飞风弄蝶，柳阴阴下水平桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65084,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题扇二十四首 其十九","author":"曹勋","text":"老境惟期得醉歌，何能浩荡涉风波。\n关山月白闻归雁，风雨秋深想钓蓑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65085,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题扇二十四首 其十八","author":"曹勋","text":"小轩风景画图宽，一再闲寻绿绮弹。\n雨著梨花春已老，烟沉芳草梦犹寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65086,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题扇二十四首 其十七","author":"曹勋","text":"庭萱戢戢漏新春，槛外梅花冷带云。\n与客对床风撼竹，一灯殊喜细论文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65087,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题扇二十四首 其十六","author":"曹勋","text":"柳满长堤绿满池，藕花倚岸两三枝。\n文鸳扑鹿惊飞起，一棹高荷艇子移。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65088,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题扇二十四首 其十五","author":"曹勋","text":"小楼连苑碧山前，终日凉生枕簟边。\n自是西湖秋更好，水光山色接长天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65089,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题扇二十四首 其十四","author":"曹勋","text":"弄袖和风拂拂轻，众香迎面酒微醒。\n凉寻小径通幽处，花压栏干竹一亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65090,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题扇二十四首 其十三","author":"曹勋","text":"松篁交翠入幽深，道院萧闲每遣心。\n一炷清香宜燕坐，数声钟磬有馀音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65091,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题扇二十四首 其十二","author":"曹勋","text":"春去烟光绿已齐，阴阴栏槛晓晴时。\n新梢替尽残芳静，喜见馀花一两枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65092,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题扇二十四首 其十一","author":"曹勋","text":"瀰瀰水槛俯横桥，水面新荷影动摇。\n时向青空飞白鹭，不妨翡翠立兰苕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65093,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题扇二十四首 其十","author":"曹勋","text":"红槃花上绿烟微，风转天香暖著衣。\n行遍四桥闲伫立，碧波时有綵鸳飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65094,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题扇二十四首 其九","author":"曹勋","text":"草萦平碧柳舒金，春色融融积渐深。\n巢燕高低寻画栋，宿云浓淡作轻阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65095,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题扇二十四首 其八","author":"曹勋","text":"惯向青林与碧溪，幽居竹石自相宜。\n种成满眼花堆锦，开落如今总不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65096,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题扇二十四首 其七","author":"曹勋","text":"碧沼波澄拂柳条，坐来未觉水云遥。\n轻轻风絮迷新涨，一啭新声破寂寥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65097,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题扇二十四首 其六","author":"曹勋","text":"引睡文书堆棐几，穿帘燕子拣梅梁。\n好风弄袖湖山近，陇亩摇春禾黍香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65098,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题扇二十四首 其五","author":"曹勋","text":"东风已过晓天清，尚有飞来柳絮轻。\n捲起珠帘窗户静，一番新绿照人清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65099,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题扇二十四首 其四","author":"曹勋","text":"含笑殊名缥与缃，就中晕紫最芬芳。\n纤枝小摘涓涓露，鼻观须参著肉香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65100,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题扇二十四首 其三","author":"曹勋","text":"薰风过雨到池台，绿荫都无一点埃。\n傍架垂垂薇露重，糁枝已有橘花开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65101,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题扇二十四首 其二","author":"曹勋","text":"势凌空碧小嶕峣，秀木成阴映断桥。\n注意便为庐阜想，摇风最喜水芭蕉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65102,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题扇二十四首 其一","author":"曹勋","text":"霏微梅雨暗林塘，润逼琴丝草木香。\n捲箔钩帘无一事，篆烟终日伴清凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65103,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题清虚庵三首 其三","author":"曹勋","text":"松篁交映有无中，行近仙扉一水东。\n独上上清三洞妙，宝章云笈助真风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65104,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题清虚庵三首 其二","author":"曹勋","text":"拨云峰迥势岧峣，杰阁翚飞倚绛霄。\n扶翊道风千载遇，昭回奎画百神朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65105,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题清虚庵三首 其一","author":"曹勋","text":"清虚指出翠微旁，便涌流泉溉一方。\n更拜璇题作神力，源源千古出甘凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65106,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题雪景二首 其二","author":"曹勋","text":"四山吹雪洒沧浪，两两渔舟冷不妨。\n自是寒鱼依密藻，江深岸迥谩鸣桹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65107,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题雪景二首 其一","author":"曹勋","text":"雪满群山万类沉，幽人闭户寂无心。\n轻舟冲冷肯乘兴，情与剡溪寒意深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65108,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题董亨道画西湖","author":"曹勋","text":"湖上秋山翠作堆，湖光千顷漾涟漪。\n晓云贴水菰蒲冷，正是吴江枫落时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65109,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]