[{"title":"夜坐谨成小诗呈晦堂心老","author":"彭汝砺","text":"修鍊清彻骨，斡旋幽入神。\n寸丝缚九虎，一指挂三钧。\n丈室夜忽旦，寒崖冬自春。\n师乎何所命，学佛亦非人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49824,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和题真相院","author":"彭汝砺","text":"山色随行止，溪声满见闻。\n灯花秋寂淡，香火夜氛氲。\n野色迷修竹，厨烟长白云。\n大夫材力健，故宠寺僧勤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49825,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和题净慈寺","author":"彭汝砺","text":"已失禅关治，空严古殿尊。\n佛香尘草莽，僧饭饱鱼豚。\n万竹藏秋色，丰碑落烧痕。\n废兴俱物鉴，谁似语公孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49826,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"道中时有山水之遇因用林字韵","author":"彭汝砺","text":"我今倦尘土，邂逅得幽林。\n云外千山色，溪边万竹阴。\n还憎俗吏态，稍快野夫心。\n世事非樽酒，天寒不自禁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49827,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄公权","author":"彭汝砺","text":"灵源起幽谷，萧洒与秋宜。\n世事有穷处，泉声无尽时。\n流沾一山足，泽入万田滋。\n祇恐明朝别，清风到梦思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49828,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"欲雨","author":"彭汝砺","text":"车马冒蒸暑，道途伤久晴。\n云生蜀山静，风度远秋清。\n白蚁纷纷斗，鸤鸠在在鸣。\n微阴知雨意，失意问农耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49829,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"薄荷","author":"彭汝砺","text":"神农取辛苦，病客爱清新。\n寂淡花无色，虚凉药有神。\n烦心侵冰雪，眩目失埃尘。\n自是芝兰臭，非同草木春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49830,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄邹秘丞同赴京师","author":"彭汝砺","text":"马上梅曾赋，林边酒记赊。\n乾坤新帝业，山野旧人家。\n自昔馀篇翰，经年五岁华。\n诗成无雁寄，一梦入天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49831,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春秋成字韵 其一","author":"彭汝砺","text":"凤鸟知何处，麟经卒告成。\n人人无义战，岁岁有王正。\n秦楚空强力，桓文漫主盟。\n是非微旨在，终始愿深明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49832,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春秋成字韵 其二","author":"彭汝砺","text":"法为衰周起，文因旧史成。\n有权皆反正，无事亦书正。\n泣血葵丘会，伤心首止盟。\n三家自萤爝，未助太阳明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49833,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春秋成字韵 其三","author":"彭汝砺","text":"圣念周邦弱，经因鲁史成。\n尊王常谨始，罪隐不书正。\n弗义嗟频战，无常叹屡盟。\n幽微今焕若，宁复比丘明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49834,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春秋成字韵 其四","author":"彭汝砺","text":"赏罚陵迟久，春秋笔削成。\n称人讥楚僭，书月谨周正。\n国国强并弱，时时会复盟。\n前贤褒贬在，一览是非明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49835,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和深父伤字韵 其一","author":"彭汝砺","text":"郑弃非人弃，梁亡只自亡。\n危机交弊弱，血刃第争强。\n恃力虽千国，推尊独一王。\n衰微今已往，掩卷益增伤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49836,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和深父伤字韵 其二","author":"彭汝砺","text":"前史权衡在，当时法度亡。\n力扶周室弱，深抑楚人强。\n言战嗟无义，书元示有王。\n细推褒贬意，掩卷一悲伤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49837,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和深父伤字韵 其三","author":"彭汝砺","text":"战伐周纲替，春秋救已亡。\n缀旒忧主弱，问鼎叹臣强。\n萧斧惩当世，蓍龟鉴后王。\n最怜君学苦，能为古人伤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49838,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和深父伤字韵 其四","author":"彭汝砺","text":"春秋二百战，一一叙兴亡。\n书战皆非义，称人亦贬强。\n临文常抑楚，谨始必尊王。\n穷究当时事，应须发感伤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49839,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"深父学士示易诗四首某辄和韵 其一","author":"彭汝砺","text":"学易非吾敢，疲驽亦勉旃。\n冥心二篇策，皓首一韦编。\n忧患生拘羑，几微续草玄。\n相期须畛域，慎勿泥蹄筌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49840,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"深父学士示易诗四首某辄和韵 其二","author":"彭汝砺","text":"大易诚微矣，吾门敢舍旃。\n文虽重旧旨，孔亦断残编。\n道远为功骏，言微蓄意玄。\n江鱼如可得，朝夕自忘筌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49841,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"深父学士示易诗四首某辄和韵 其三","author":"彭汝砺","text":"圣意藏羲易，人心勿舍旃。\n玩爻知上古，经火叹遗编。\n六画功成简，三才道亦玄。\n兄今微大过，默默识真筌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49842,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"深父学士示易诗四首某辄和韵 其四","author":"彭汝砺","text":"易道更三古，愚心愿勉旃。\n研几甘白首，穷理自黄编。\n西伯爻于繇，扬雄准以玄。\n意先言象得，从此舍鱼筌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49843,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"毛诗 其一","author":"彭汝砺","text":"美刺诗之奥，予今得所归。\n议收天地远，心到圣贤微。\n雅颂藏兴废，虫鱼隐是非。\n篇章三百五，一一数珠玑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49844,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"毛诗 其二","author":"彭汝砺","text":"古诗皆有托，正道岂无归。\n风雅收功远，弦歌得趣微。\n王刘终少是，毛郑亦多非。\n儒氏潜深爱，篇篇尽玉玑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49845,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"毛诗 其三","author":"彭汝砺","text":"周鲁诗三百，篇篇自有归。\n人心散堙郁，物意露幽微。\n原本今无复，风华比益非。\n遒人不知采，空此缀明玑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49846,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和章承议通判来章","author":"彭汝砺","text":"近水班荆坐，缘山拄杖行。\n云烟窥胜概，风雨听寒声。\n久累维摩病，多惭卫玠清。\n波澜终未息，衮衮共劳生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49847,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"问侗","author":"彭汝砺","text":"知现维摩病，莫淫皇甫书。\n去归吾未可，调治尔何如。\n眼忌时时拭，头便日日梳。\n首先惩忿怒，次第学呵嘘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49848,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"云盖寺","author":"彭汝砺","text":"旧日蛇虺穴，今时薝卜林。\n寒泉三井旧，高阁五峰深。\n翠竹娟娟老，长松漠漠阴。\n凤凰池好在，谁得老师心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49849,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渔家","author":"彭汝砺","text":"小径通山坞，扁舟宿钓矶。\n儿童汲水上，妇女背樵归。\n腊月鱼虾足，丰年鸡鸭肥。\n是非人世事，应不到柴扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49850,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"道中","author":"彭汝砺","text":"湖天冬不雪，山地晚多风。\n岸草犹全绿，村花或自红。\n差池岁聿暮，寂寞雨其濛。\n南北随蓬转，浮生旅寓中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49851,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"马上读书寄君时 其一","author":"彭汝砺","text":"夜秣骎骎马，晨脂绎绎车。\n更行犹挟策，渐老欲捐书。\n漫意窥原委，非工辨鲁鱼。\n相知今亦少，舍汝更谁欤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49852,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"马上读书寄君时 其二","author":"彭汝砺","text":"独自鞭驽马，谁何惜后车。\n浮云看富贵，陈迹泥诗书。\n画虎岂类狗，忘筌在得鱼。\n田园须稍葺，吾与汝归欤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49853,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"某闻老母到叶未得平安家书作小诗寄君时弟","author":"彭汝砺","text":"慈闱闻及叶，坐待到天明。\n望月魂先往，闻更梦不成。\n花开灯有信，书少雁无情。\n欲往终多畏，迟留叹此生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49854,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和念一弟诗韵","author":"彭汝砺","text":"事如车转轴，日夜不曾周。\n固各有分定，疑皆非本谋。\n能鸣君似雁，不系我为舟。\n扰扰胶胶者，怜渠不自由。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49855,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"内乡招提寺","author":"彭汝砺","text":"淫雨宿萧寺，白云思楚山。\n病催颜色老，泪裛鬓毛斑。\n流水终何事，飞禽倦未还。\n梦归无别处，鹫岭凤林关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49856,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春阴呈兄长 其一","author":"彭汝砺","text":"春阴祇欲睡，世事固相寻。\n簿领粗官意，尘埃故国心。\n风吹花点点，雨压柳阴阴。\n几日城头步，乾坤共醉吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49857,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春阴呈兄长 其二","author":"彭汝砺","text":"春容猛狼藉，暑意已侵寻。\n寂寞悲时事，凄凉上客心。\n莺飞啼野色，蝶戏落花阴。\n喜有城隅望，乘风听苦吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49858,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春阴呈兄长 其三","author":"彭汝砺","text":"花开初熟醉，月上夜微吟。\n志节伤时序，诗书爱寸阴。\n未忘他日意，无用此时心。\n更约藏舟步，馀芳尚可寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49859,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"途中早起寄兄弟","author":"彭汝砺","text":"为惜庭闱别，方惊道路难。\n醉怜山月古，病怯野风寒。\n驻马询农耜，临溪问钓竿。\n新诗如有得，写染寄归翰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49860,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和岩夫如字韵","author":"彭汝砺","text":"霆声破幽郁，雨点散空虚。\n日夕分长短，阴阳竞惨舒。\n柳丝吹细细，花片落疏疏。\n试望孤城远，江山画不如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49861,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送岩夫庭佐归宁 其一","author":"彭汝砺","text":"花满春来路，云归雨后天。\n红尘一马去，白日寸肝悬。\n秀色歌棠棣，归心听杜鹃。\n东风吹眼尾，客泪滴涓涓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49862,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送岩夫庭佐归宁 其二","author":"彭汝砺","text":"春雨伤行色，秋风问后期。\n欲吟黄鸟意，更遗白华诗。\n客路看山色，亲帏有梦思。\n遥知到家日，正好采莼丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49863,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"武冈驿","author":"彭汝砺","text":"破屋山间驿，穷阎溪上村。\n云山能近郭，池水故当门。\n气象生诗笔，波澜动酒樽。\n夜长归梦远，凭尔与招魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49864,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"驿前人家小池","author":"彭汝砺","text":"黄茅前驿路，闇淡小池园。\n春近花林好，日斜凫鸭喧。\n幕云寒苒苒，眉月夜番番。\n莫笑村居僻，谁如拙养尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49865,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"武阳寨闻峒中作乐","author":"彭汝砺","text":"成康已措刑，文景不言兵。\n夷俗家家曲，蛮歌处处声。\n长腰筒拍鼓，细竹葫芦笙。\n物意惟安乐，人间共一情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49866,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"武阳寨见村中梅花","author":"彭汝砺","text":"茅屋蛮溪路，梅花亦自开。\n雪深忧思远，风静暗香来。\n故国春何似，孤城兴远哉。\n晚风吹片片，恣意点苍苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49867,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄二弟时在白彪庄 其一","author":"彭汝砺","text":"携箧戴星去，荷锄冲雨行。\n堤防询故老，铚艾倚新氓。\n移竹三千个，添松一万茎。\n但能逃冻饿，吾不慕公卿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49868,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄二弟时在白彪庄 其二","author":"彭汝砺","text":"伊尹初耕野，儿宽自带经。\n故须聊假手，无或甚劳形。\n曲曲水如带，峨峨山似屏。\n夜窗吟更老，不负读书声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49869,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"催君时归并寄君宜弟 其一","author":"彭汝砺","text":"命彼仆夫驾，晨鸡初一声。\n朔风不可渡，南径却堪行。\n贫莫甚今日，瘦无如尔兄。\n故惭鱼得计，最爱雁能鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49870,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"催君时归并寄君宜弟 其二","author":"彭汝砺","text":"三复棣华赋，俛焉怀古风。\n少时贪壮决，老去自童蒙。\n以病故有病，既空何用空。\n不须多问此，万劫刹那中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49871,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和君时弟","author":"彭汝砺","text":"老马青骢色，扁舟画鹢文。\n长烟横作带，叠浪似成纹。\n北岭夜收雨，南冈朝出云。\n赋诗知有意，畎亩不忘君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49872,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答君时弟 其一","author":"彭汝砺","text":"埙篪与鸿雁，一气更同声。\n鼓则与桴应，形惟从影行。\n无如我宜弟，颇笑尔难兄。\n洵美歌棠棣，仍须听鹤鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49873,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答君时弟 其二","author":"彭汝砺","text":"埙篪无俗韵，鸿雁有秋声。\n更类偲偲友，非同踽踽行。\n爱无踰玉季，名有愧龙兄。\n莫作升堂赋，相期以道鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49874,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答君时弟 其三","author":"彭汝砺","text":"梦觉山头月，归乘湖面风。\n远林寒寂寂，幽径晓蒙蒙。\n反哺乌鸣屋，成行雁贴空。\n物情缘底事，祇欲搅予中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49875,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答君时弟 其四","author":"彭汝砺","text":"是露复是电，非铃亦非风。\n应作如是解，无为彼所蒙。\n世累不见累，真空亦非空。\n欲知如是意，不在内外中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49876,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和子忠弟见寄元韵","author":"彭汝砺","text":"诗书非不乐，富贵竟何加。\n岁月流年晚，山川行路赊。\n学须千古到，行畏一毫差。\n阃阈相期远，宁惟效兔罝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49877,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和运干奉议见赠元韵","author":"彭汝砺","text":"沉碑万山脚，骑马习池头。\n元凯亦过虑，山公聊自谋。\n青烟鹿门净，黄竹凤林秋。\n兴废不可问，登临徒百忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49878,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"离武阳寨","author":"彭汝砺","text":"山谷多时雨，乾坤昨夜晴。\n经年淹坏舍，破晓出边城。\n青女吹风急，常娥伴月明。\n人间春到久，寂寞壮心惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49879,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和君时弟洗竹","author":"彭汝砺","text":"斩伐奚伤性，繁枝漫作阴。\n静留朝日暖，寒聚晚烟深。\n叶有禽栖息，根无蚁蠹侵。\n龙孙今转盛，终待凤凰音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49880,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和君时弟有感","author":"彭汝砺","text":"鬓发非蓬草，秋来亦自衰。\n简书公迫促，岁月细推移。\n见客簪裳懒，登楼杖履迟。\n故园松菊在，归计定何时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49881,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和君时弟生辰时八月十四日也","author":"彭汝砺","text":"月行正几望，露润欲为霜。\n箕斗能符契，桑蓬可感伤。\n少时材独出，老去德方将。\n看取华亭鹤，何嫌发鬓苍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49882,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示君时弟刈禾有感","author":"彭汝砺","text":"终朝风且息，五日雨奚妨。\n白嫩禾先老，黄花菊拟香。\n大夫誇作赋，公子恨无裳。\n曷日同舟去，白彪池水阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49883,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示君时弟","author":"彭汝砺","text":"天寒云不散，泱漭路犹迷。\n乌雀饱栖屋，苍鹰饥啄泥。\n乐耕莘氏媵，敬馌冀人妻。\n山色碧千仞，愿同君子跻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49884,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"承和途中四韵","author":"彭汝砺","text":"此身俱是客，何处合为乡。\n雨后春山好，天晴昼日长。\n三年穰下郡，一信赭陂阳。\n鸿雁非中泽，鸤鸠祇在桑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49885,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和君时寄叔韵","author":"彭汝砺","text":"屈首随温暖，低头避谴呵。\n灵根无挺拔，古鉴少揩磨。\n故里三千远，浮生四十过。\n汉江鱼不少，书寄莫嫌多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49886,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和致政侍郎书怀因寄赠侍亲及邓以中使计会刬刷军器改途先之唐因寄是诗","author":"彭汝砺","text":"雾露星轺湿，尘埃羽檄驰。\n君王非好武，天下合防危。\n乐事难并合，浮生易别离。\n赖知春好在，五日与君期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49887,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"桃李","author":"彭汝砺","text":"南阳多桃李，寂寞自成蹊。\n白雪千林阔，红云一片低。\n人非刘氏子，路近武陵溪。\n故国春相似，瞻观处处迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49888,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"老马","author":"彭汝砺","text":"今日衰翁马，当时御史骢。\n少尝更险阻，老更识西东。\n力惮驰驱远，恩从莝秣丰。\n不应思伯乐，未便误桓公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49889,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送和仲","author":"彭汝砺","text":"远宦无情思，君来慰病容。\n棣华开韡韡，鸣雁去雍雍。\n天上张公子，云间陆士龙。\n圣门多阃奥，更愿与君从。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49890,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"病起","author":"彭汝砺","text":"抱疾漳滨久，衰颜一倍增。\n发疏簪不稳，足蹇杖难凭。\n身病他何欲，家贫去不能。\n世缘知不早，今日似缠藤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49891,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送君时","author":"彭汝砺","text":"未晓乾坤大，能容此类蕃。\n连云障飞翼，穴石聚遗根。\n篮缕谁家子，奔忙几处村。\n焉知神圣意，饥渴念元元。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49892,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和君玉捕蝗杂咏 其一","author":"彭汝砺","text":"草木经春老，牛羊薄晚归。\n水痕长淡薄，花片巧菲微。\n感物愁盈斛，劳形带缓围。\n利名劳有此，今日已知非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49893,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]