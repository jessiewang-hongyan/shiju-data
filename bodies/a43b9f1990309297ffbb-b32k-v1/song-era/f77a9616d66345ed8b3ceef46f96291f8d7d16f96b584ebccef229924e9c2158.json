[{"title":"林道士故庐","author":"陈允平","text":"青城道士跨青牛，去作清都汗漫游。\n朝扣九关朝玉阙，暮回三岛宴金楼。\n丹随鹤舞缑山月，剑伴龙归洛浦秋。\n犹有石房云不散，晓风松柏两飕飗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14568,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"经冯将军墓","author":"陈允平","text":"同山半白云，此地葬将军。\n香火空遗像，朝廷纪旧勋。\n铁衣悬古塔，金钺镇荒坟。\n一涧清泠水，年年生紫芹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14569,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"虎丘即事","author":"陈允平","text":"西风剑佩轻，独立妙高亭。\n山吐岩头月，江涵水面星。\n石奔苍虎势，树结老龙形。\n何处吹箫客，扁舟过洞庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14570,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"城西杨梅","author":"陈允平","text":"炎炎火树照千山，南客应同荔子看。\n金谷人游红步障，玉房仙炼紫华丹。\n猩唇泣露珊瑚软，鹤顶迎风玛瑙寒。\n若使汉宫知此味，又添飞驿上长安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14571,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"客中怀友","author":"陈允平","text":"霜露湿征衣，行非少壮时。\n何堪万里役，动是一年期。\n高谊贫中见，深情别后知。\n相思相望处，云树碧参差。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14572,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋暮登太白","author":"陈允平","text":"飘飘短褐袍，倚杖立金鳌。\n桥束溪流急，树增山势高。\n白云连海峤，黄叶满亭皋。\n落日西风恶，尘埃两鬓毛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14573,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贺伯父大资休致","author":"陈允平","text":"不恋清时白玉珰，便将身世寄沧浪。\n三朝元老黄枢阁，四海闲人绿野堂。\n楚楚菁兰秋带雨，萧萧寒菊晚宜霜。\n拟成东甬耆英社，剩乐壶天日月长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14574,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送中上人游天台","author":"陈允平","text":"师作天台去，长亭复短亭。\n焚香参祖塔，振锡动山灵。\n石罅移菖歜，松根斸茯苓。\n何时白云下，相与话青青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14575,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送吴松溪过淮","author":"陈允平","text":"铁砚毛锥未策功，又携琴剑过临邛。\n荆山有玉鸣朝凤，沧海无珠走夜龙。\n浦口月来僧馆榻，渡头霜落客船钟。\n自君别后知音少，空忆雁山溪上松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14576,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"哭楼梅麓","author":"陈允平","text":"白玉楼成去作文，祇从西棘挂朝冠。\n生来病苦相如渴，没后人知范叔寒。\n野店春闲沽酒榼，溪堂月冷钓鱼竿。\n梅花麓上谁弹泪，岁岁东风吹不乾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14577,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"留鹤江有感","author":"陈允平","text":"抱玉归来泪满襟，世间何许觅知音。\n此生虽有噬脐悔，到死终无尝胆心。\n伏枥马思云路远，避钩鱼隐石潭深。\n故人若问淞江客，自采芙蓉学楚吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14578,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秦鸾曲","author":"陈允平","text":"盈盈白玉钿，袅袅黄金缕。\n拍拍水晶奁，皎皎珊瑚树。\n帘前双燕飞，门外桃花雨。\n无处说相思，羞对秦鸾舞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14579,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"郭西文孝庙","author":"陈允平","text":"帝子宸游白玉京，江南遗庙尚丹青。\n寝园月暗衣冠古，选阁云深笔砚灵。\n清卫有威森凤戟，娇嫔无语倚龙屏。\n太平天子尊儒学，锦帙黄封赐六经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14580,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"钱塘八月潮","author":"陈允平","text":"五丁椎碎烂银堆，注作东南水一杯。\n秋半忽疑天外雪，夜深俄听月中雷。\n大鹏击浪惊龙卧，老蜃嘘云误燕来。\n日日涛头多拱北，至尊元在郁箫台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14581,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"钱塘旅舍","author":"陈允平","text":"云山千万叠，身事恨悠悠。\n客鬓秋风急，乡心夜雨愁。\n蛩鸣邻寺壁，雁过隔湖楼。\n目送千帆远，长江空自流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14582,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宿大慈山悟真观","author":"陈允平","text":"终南道士学弹琴，门外松萝锁翠阴。\n濒海八龙朝出洞，隔山群鹿夜归林。\n琪花过雨金风澹，玉树笼烟璧月沉。\n三十六坛钟鼓寂，云璈声接步虚音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14583,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄翁宾旸","author":"陈允平","text":"历历长涂谒鲁侯，征尘宁复恋貂裘。\n江城露冷霜初滑，海谷冰消水欲流。\n夜月观书徐稚榻，春风听乐仲宣楼。\n料君频作西湖梦，曾忆孤山有旧游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14584,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄晚浦张观使","author":"陈允平","text":"不愿生封万户侯，归来却伴赤松游。\n琴书东里三椽屋，诗酒西湖一叶舟。\n雁过客楼秋雨急，乌栖江树暮烟愁。\n频年陡觉生华发，日日凭高望楚州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14585,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄模上人","author":"陈允平","text":"林下逢支遁，人疑是宿生。\n病怜诗力减，老觉世缘轻。\n短发吴霜净，归心剡雪明。\n相思听猿夜，幽梦隔重城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14586,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"曹娥庙","author":"陈允平","text":"汉碣嵯峨几百秋，曲坟遗庙越山头。\n潮声侵帐凤屏冷，云气绕台鸾镜愁。\n孝节棱棱双桧立，哀魂渺渺一江流。\n椒觞载奠灵风起，知我怀亲送远舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14587,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梁湖道上","author":"陈允平","text":"东风酒旆斜，浦口第三家。\n谷鸟鸣春树，江鸥起暮沙。\n故乡山渐近，曲岸柳初芽。\n客路归心切，孤帆带落霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14588,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅梁堰","author":"陈允平","text":"庙近云涛观，山遥翠欲重。\n祇应溪上木，便是洞中龙。\n堰折潮归海，楼迎浪答钟。\n断碑荒藓合，终古载灵踪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14589,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"淮西","author":"陈允平","text":"舟子解贪程，能知倦客情。\n断云微雨霁，远水落霞明。\n驿古如荒庙，山平接废城。\n游淮少年事，今祇叹劳生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14590,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清风阁","author":"陈允平","text":"巍巍楹槛逼星河，城上阑干野色多。\n天目水分波浩渺，大湖山点石嵯峨。\n罗窗夜气吹银烛，翠箔秋声动玉珂。\n我欲乘空呼列子，月明何处起蘋歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14591,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谒乌龙庙","author":"陈允平","text":"断碑犹纪唐时事，山气阴沉暗绿苔。\n松木已逾千岁寿，香烟知化几炉灰。\n廊深无月鬼神过，殿古有云风雨来。\n曲曲九溪春水落，子陵滩下复东回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14592,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鄂王墓","author":"陈允平","text":"鄂王墓在栖霞岭，一片忠魂万古存。\n镜里赤心悬日月，剑边英气塞乾坤。\n苍苔雨暗龙蛇壁，老树烟凝虎豹幡。\n独倚东风挥客泪，不堪回首望中原。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14593,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游阳明洞天","author":"陈允平","text":"万木阴沉锁石门，烟霞深处近昆崙。\n洞箫声接玉台磬，宝盖影摇金殿幡。\n湘浦有龙云气湿，越山无鹤露华昏。\n灵芝采尽归何处，溪上白蘋花正繁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14594,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"湖上","author":"陈允平","text":"流水断桥边，笙歌拥画船。\n日酣花半醉，春困柳三眠。\n策杖登云洞，观鱼上玉泉。\n凤城归去晚，山锁万重烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14595,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登吴山","author":"陈允平","text":"登高一展眺，宫树郁嵯峨。\n楼阁春风满，东南王气多。\n青天行日月，大地布山河。\n柳色沙堤路，时闻响玉珂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14596,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登招宝山","author":"陈允平","text":"宇宙初开辟，何神立此山。\n中流天柱石，大地海门关。\n浪恶蛟龙怒，云深虎豹闲。\n潮期与日月，千古一循环。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14597,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赋林景参梅屿","author":"陈允平","text":"结庐分得雁山云，屿上梅花是四邻。\n水月一天芗世界，冰霜千古玉精神。\n短檠夜雨西窗梦，长铗秋风北塞尘。\n我亦烟波纶钓侣，与君同作岁寒人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14598,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"酬同志","author":"陈允平","text":"风光易销歇，尊□足闲情。\n谷雨春江暮，茶烟晓寺晴。\n认巢归燕熟，辞树落花轻。\n湖上明朝约，初裁白苧成。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14599,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雷峰少憩","author":"陈允平","text":"倚塔看明月，寒光度玉绳。\n曲堤藏小艇，疏柳见孤灯。\n水竹映苔石，岩花缘涧藤。\n香云吹散后，猿鹤伴高僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14600,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"僧房薜荔","author":"陈允平","text":"寸草曾收药笼功，谁移野色近禅翁。\n甘同木石抛闲地，耻附松萝上碧空。\n旋长纤枝宜雨绿，未删宿叶待霜红。\n为衣或许湘人采，清彻崇兰两佩风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14601,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"暮秋游虎丘","author":"陈允平","text":"寂寞虚廊暗草莱，天风缭绕宝华台。\n江空露冷蛟龙伏，殿古云深鹳鹊来。\n山馆老松褰绿蔓，石坛芳桂落苍苔。\n寒钟敲断枫桥月，半夜禅僧入定回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14602,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"聚景园","author":"陈允平","text":"上苑韶光隔凤城，十分春事属流莺。\n雨馀芳草欲无地，风定落花如有声。\n柳榭云深栖鹳鹊，榉塘沙暖浴鵁鶄。\n年来翠辇经游少，七十二亭空月明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14603,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题李丹壶壁","author":"陈允平","text":"闲乘海上槎，来访谪仙家。\n风逆磬声短，日低幡影斜。\n猿攀高树果，蜂采半岩花。\n谁在丹台上，三更炼紫霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14604,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题胡月山吟屋","author":"陈允平","text":"苏公堤上路，日日课新吟。\n流水行花影，斜阳卧柳阴。\n断桥春听乐，矮屋夜鸣琴。\n皎皎山间月，如君一片心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14605,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠东皋恭行人","author":"陈允平","text":"重门临驿路，几向月中开。\n殿势江山合，钟声云水来。\n长吟松溅瀑，久定石生苔。\n九品金沙观，青莲次第栽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14606,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠讷行人","author":"陈允平","text":"诸方参请尽，秋晚别京畿。\n乞食一斋饱，随缘百念微。\n夜声鸣铁笛，寒色脆荷衣。\n久学南山律，终身不敢违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14607,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠佛光法师","author":"陈允平","text":"竺寺王城近，金门讲大乘。\n教中初有记，祖外久无僧。\n身被山河衲，心悬日月灯。\n南湖雨华座，十载复谁登。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14608,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠杜郎中","author":"陈允平","text":"草堂人远只存诗，几席临风入咏思。\n文印幸传同谷谱，祖灯犹照曲江碑。\n濡毫省闼春霖足，立马君门夜漏迟。\n憔悴江南老词客，柳边曾挹汉威仪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14609,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠杨子中","author":"陈允平","text":"凤梧鸾竹郁青葱，文气冲冲五色虹。\n囊里短歌唐李贺，酒边奇字汉扬雄。\n铜铺雨后芭蕉绿，石井霜前薜荔红。\n茶灶笔床随处有，等闲留客坐春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14610,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠明道者","author":"陈允平","text":"三衣终日护，白社踵东林。\n净业心无住，清斋力不禁。\n莲香秋观静，松吹石桥阴。\n见说溪南虎，时来听梵音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14611,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠罗知宫","author":"陈允平","text":"霞帔云巾占石床，磬声初引步虚长。\n拟朝碧落非无路，学煮黄金信有方。\n云暗石潭龙骨蜕，草肥山崦麝脐香。\n青城梦窅蓬莱近，沧海为田合种桑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14612,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠雪窦","author":"陈允平","text":"一从说法雨华台，棕叶蕉花几度开。\n春尽瀑泉犹溅雪，地幽篁竹亦生苔。\n临溪洗钵青猿过，背石持经白鸟来。\n笑指庭前双柏树，住庵时节手亲栽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14613,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠新罗僧","author":"陈允平","text":"便帆才过日东来，浅色伽梨短样裁。\n野鹤怨时心共远，海鲸降处定初回。\n长年守律因师戒，中土传经为国灾。\n几日应酬官事了，南湖听法雨华台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14614,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"避暑","author":"陈允平","text":"避暑入林扃，同僧坐竹亭。\n鸟飞晴地影，龙挂雨天形。\n扫叶铺椰簟，临流注石瓶。\n更无尘迹到，日落梦初醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14615,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"香奁体","author":"陈允平","text":"小院薰风满，闲庭白昼长。\n蜻蜓杨柳岸，鸂鶒芰荷塘。\n云合朱檐卸，山高翠阁凉。\n蔓滋青薜荔，芽长紫良姜。\n帘幕深深地，阑干曲曲廊。\n淡烟瑶草细，流水碧桃香。\n幡影重门静，苔痕小篆荒。\n螭盘丹鼎雪，龙吸露台浆。\n琴古翻新调，笙沉靘旧簧。\n雨声犀角枕，月色象牙床。\n掌上双鹦鹉，屏间两凤凰。\n石函藏宝剑，金钥启瑶箱。\n扇雉团清影，奁鸳试晓妆。\n霞绡衣窄索，云锦佩玎珰。\n鬓拢金蝉矗，钗横玉燕翔。\n袂飘天水碧，裙溅郁金黄。\n太液箫初远，蓬壶漏未央。\n流星飞碧落，零雨下银潢。\n去去人千里，迢迢天一方。\n断肠春洛浦，残梦夜潇湘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14616,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山中吟 其五","author":"陈允平","text":"山深春亦寒，野鸟声绵蛮。\n山花随处发，香风吹幽兰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14617,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山中吟 其六","author":"陈允平","text":"夏日飞火云，枕簟访深僻。\n坐此松竹林，冰泉嗽寒石。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14618,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山中吟 其八","author":"陈允平","text":"三冬气凛冽，独立千崖雪。\n横斜溪上梅，影落溪桥月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14619,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山中吟 其四","author":"陈允平","text":"东望泰岳松，西望苍梧竹。\n知心侣渔樵，忘情友麋鹿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14620,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山中吟 其九","author":"陈允平","text":"身在此山中，闲情薄太空。\n行歌白云里，白云连崆峒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14621,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山中吟 其一","author":"陈允平","text":"平生独爱山，日日频跻攀。\n自得山中趣，结庐万山间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14622,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山中吟 其十","author":"陈允平","text":"朝餐山上霞，暮采山下药。\n安得山中人，共跨山头鹤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14623,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山中吟 其二","author":"陈允平","text":"山西茂林麓，中有盘旋谷。\n飘飘双凤凰，飞立山上玉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14624,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"叹镜辞","author":"陈允平","text":"忆妾初嫁时，金屋藏窈窕。\n忽见洛阳人，鬻镜长安道。\n明月掌上寒，团团复皎皎。\n千金买得归，惜之如重宝。\n奁开双凤飞，带结青鸾袅。\n当时照妾颜，妾颜正年少。\n如今照妾颜，妾颜羞已老。\n对镜频叹嗟，掩镜徒懊恼。\n不恨妾嫁迟，惟恨妾生早。\n此恨空绵绵，天涯满芳草。\n君不见长江逝水无逆流，岁去年来多白头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14625,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"竹枝曲","author":"陈允平","text":"峨眉山头月如眉，画眉夬婿归不归。\n十日学德眉似月，眉成又是月圆时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14626,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冷泉亭","author":"陈允平","text":"西竺峰飞小朵来，闲僧曾共倚崔嵬。\n寒惊玉匣光初泻，晓怯冰壶冻未开。\n云外有香丹桂落，洞中无月白猿哀。\n当年洗耳人何在，拟勺清泠酹碧苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14627,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宛陵道院","author":"陈允平","text":"阙角溪城下，千年黑蟒蟠。\n云深仙宅窅，竹密醮坛寒。\n汉量铜花绿，隋钟火籀丹。\n天风步虚静，微月听鸣銮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14628,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"终日","author":"陈允平","text":"终日怀人凭曲栏，馀阴未放客衣单。\n祇缘二月风光澹，别作一般天气看。\n梅粉有香销夜雨，柳丝无力受春寒。\n闲情漠漠难拘管，自逐轻鸥下急滩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14629,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"采桑行","author":"陈允平","text":"妾本秦罗敷，家住曲江曲。\n门前杨柳青，春风啼布谷。\n树头桑初芽，家家蚕始浴。\n相呼出采桑，采桑如采玉。\n屈曲回高枝，攀条剪柔绿。\n朝晴采桑南，暮雨采桑北。\n采得桑归迟，小姑怨相促。\n陌上绮罗人，问妾眉何蹙。\n妾恨妾自知，问妾何所欲。\n消磨三十春，渐喜蚕上簇。\n七日收得茧百斤，十日缫成丝两束。\n一丝一线工，织成罗与縠。\n百人共辛勤，一人衣不足。\n举头忽见桑叶黄，低头垂泪羞布裳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14630,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"青龙渡头","author":"陈允平","text":"天阔雁飞飞，淞江鲈正肥。\n柳风欺客帽，松露湿僧衣。\n塔影随潮没，钟声隔岸微。\n不堪回首处，何日可东归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14631,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春闺","author":"陈允平","text":"终日怀人倚翠阑，别长愁觉钏金宽。\n颦眉钿叶抛鸳甃，弹泪灯花落凤盘。\n梅粉有香供夜雨，柳丝无力受春寒。\n阶前拾得相思子，自结罗囊绣合欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14632,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春游曲","author":"陈允平","text":"长安二月东风里，千红陌上香尘起。\n都人欢呼去踏青，马如游龙车如水。\n两两三三争买花，青楼酒旗三百家。\n长安酒贵人未醉，岸头芳草日半斜。\n谁家女子娇似玉，约莫青春十五六。\n郁金罗带苏合香，琵琶自度相思曲。\n相思曲，声断续，断续回文不堪读。\n回文断续有续时，离肠寸断无续期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14633,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]