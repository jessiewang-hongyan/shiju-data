[{"title":"和杨公济钱塘西湖百题 其四十一 朱崖","author":"郭祥正","text":"彤霞贯来久，赤石异诸崖。\n月照夜光发，风生云雾埋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48650,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和杨公济钱塘西湖百题 其四十二 青壁槛","author":"郭祥正","text":"仙家青壁槛，未见灵花发。\n我欲提碧壶，来斯挹明月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48651,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和杨公济钱塘西湖百题 其四十三 涡渚东屿","author":"郭祥正","text":"小屿春归后，青浦涡渚东。\n日高鱼鸟散，烟淡一林风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48652,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和杨公济钱塘西湖百题 其四十四 许先生书堂","author":"郭祥正","text":"丹井光长在，空堂貌亦存。\n邻僧深夜磬，时复与招魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48653,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和杨公济钱塘西湖百题 其四十五 石门涧","author":"郭祥正","text":"启闭何人见，湍流一涧分。\n仙家无路入，空锁石楼云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48654,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和杨公济钱塘西湖百题 其四十六 卧龙石","author":"郭祥正","text":"龙卧苍山下，岂知今古春。\n不忧雷雨作，头角本非真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48655,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和杨公济钱塘西湖百题 其四十七 连岩栈","author":"郭祥正","text":"鸟道出云巅，云深春更鲜。\n游人莫嗟险，一栈与岩连。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48656,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和杨公济钱塘西湖百题 其四十八 伏龙溅","author":"郭祥正","text":"潭心有伏龙，急溜和云溅。\n头角何时成，愿借风雷便。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48657,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和杨公济钱塘西湖百题 其四十九 西庵","author":"郭祥正","text":"释子能儒言，迥出惠远上。\n庵中阅遗编，光焰高万丈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48658,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和杨公济钱塘西湖百题 其五十 枫树林","author":"郭祥正","text":"一坞藏深林，枫叶翻蜀锦。\n寄语别家人，路遥霜霰凛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48659,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和杨公济钱塘西湖百题 其五十一 卧犀泉","author":"郭祥正","text":"有角翻害身，沉泉避刀剸。\n故依金地慈，非惮沧溟远。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48660,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和杨公济钱塘西湖百题 其五十二 青林岩","author":"郭祥正","text":"青帝留行迹，岩前春不归。\n尽从霜与雪，君看碧依依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48661,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和杨公济钱塘西湖百题 其五十三 醴泉","author":"郭祥正","text":"不为太平出，胡为名醴泉。\n兵戈方满眼，聊以慰凶年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48662,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和杨公济钱塘西湖百题 其五十四 西坞漾","author":"郭祥正","text":"漫漫西坞漾，青出秀菰蒲。\n源浅不通海，光寒稍映湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48663,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和杨公济钱塘西湖百题 其五十五 白沙泉","author":"郭祥正","text":"幽泉出白沙，流傍野僧家。\n欲试甘香味，须烹石鼎茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48664,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和杨公济钱塘西湖百题 其五十六 杨梅石门","author":"郭祥正","text":"颗颗龙睛赤，深深映石门。\n自怜非荔子，不得荐尧阍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48665,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和杨公济钱塘西湖百题 其五十七 西溪","author":"郭祥正","text":"西溪在湖外，一派濯残阳。\n游子托渔艇，却愁归路长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48666,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和杨公济钱塘西湖百题 其五十八 见山亭","author":"郭祥正","text":"游子一凭栏，遍看湖上山。\n不须飞潟去，已在画屏间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48667,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和杨公济钱塘西湖百题 其五十九 神尼塔","author":"郭祥正","text":"神尼凿一塔，杳在碧云端。\n舍利夜光现，君须正眼观。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48668,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和杨公济钱塘西湖百题 其六十 韬光庵","author":"郭祥正","text":"逢人寂无语，结草自栖禅。\n但见岩花笑，厖眉不记年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48669,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和杨公济钱塘西湖百题 其六十一 香林洞","author":"郭祥正","text":"幽香来近远，此洞接蟾宫。\n欲借飞翰去，聊乘桂子风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48670,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和杨公济钱塘西湖百题 其六十二 天竺峰","author":"郭祥正","text":"谁从天竺国，分得一峰来。\n占尽湖山秀，最宜烟雨开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48671,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和杨公济钱塘西湖百题 其六十三 鍊丹井","author":"郭祥正","text":"欲息丹中火，须沈井底泉。\n何如栽杏实，亦解上青天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48672,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和杨公济钱塘西湖百题 其六十四 香桂林","author":"郭祥正","text":"根托山中地，香分月里秋。\n游人莫攀折，风散一岩幽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48673,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和杨公济钱塘西湖百题 其六十五 重荣桧","author":"郭祥正","text":"人老不重少，桧枯还复荣。\n何时逢匠石，今日栋梁成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48674,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和杨公济钱塘西湖百题 其六十六 龙泓洞","author":"郭祥正","text":"洞口无凡木，阴森夏亦寒。\n谁知一泓水，曾有老龙蟠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48675,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和杨公济钱塘西湖百题 其六十七 理公岩","author":"郭祥正","text":"晋代胡僧理，开山第一人。\n欲寻岩下迹，猿鸟送馀春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48676,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和杨公济钱塘西湖百题 其六十八 客儿亭","author":"郭祥正","text":"翻经人已去，谁为立幽亭。\n一望野云白，半藏山骨青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48677,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和杨公济钱塘西湖百题 其六十九 石莲华峰","author":"郭祥正","text":"亭亭碧莲华，何年化为石。\n越女莫惊猜，岩猿自相识。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48678,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和杨公济钱塘西湖百题 其七十 翻经台","author":"郭祥正","text":"盥手天池水，熏毫海渚香。\n翻成多少帙，台石尚辉光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48679,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和杨公济钱塘西湖百题 其七十一 葛仙丹灶","author":"郭祥正","text":"丹成灶犹在，夜气接湖云。\n仙路何由问，刀圭幸见分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48680,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和杨公济钱塘西湖百题 其七十二 稽留峰","author":"郭祥正","text":"孤峰出天外，客到亦稽留。\n不觉月华晚，涧猿啼更愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48681,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和杨公济钱塘西湖百题 其七十三 流杯亭","author":"郭祥正","text":"斲石引溪水，杯行自劝人。\n试听林下鸟，啼血不留春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48682,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和杨公济钱塘西湖百题 其七十四 望海阁","author":"郭祥正","text":"客望海中日，窗开物外山。\n天形垂欲尽，飞鸟不知还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48683,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和杨公济钱塘西湖百题 其七十五 东冈塔","author":"郭祥正","text":"崒堵藏真骨，东冈气象殊。\n烟云扫不尽，苔藓一痕无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48684,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和杨公济钱塘西湖百题 其七十六 西岭草堂","author":"郭祥正","text":"应谶游尘世，湖边一草堂。\n松声半夜雨，花气四时香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48685,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和杨公济钱塘西湖百题 其七十七 葛公石径","author":"郭祥正","text":"谁来蹑高步，幽径已荒凉。\n落叶无人扫，哀猿空断肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48686,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和杨公济钱塘西湖百题 其七十八 灵石山","author":"郭祥正","text":"灵石山前路，山深寺更深。\n不知明月去，空惜白云沉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48687,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和杨公济钱塘西湖百题 其七十九 灵石西庵","author":"郭祥正","text":"欲问庵中事，人驯虎亦驯。\n杨梅几番熟，谁为惜馀春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48688,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和杨公济钱塘西湖百题 其八十 南高峰","author":"郭祥正","text":"岌岌穿南斗，层层瞰下方。\n揭为湖海镇，半夜挂朝阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48689,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和杨公济钱塘西湖百题 其八十一 暗竹园","author":"郭祥正","text":"篁竹无人洗，烟云暗不开。\n网罗无入处，豺虎莫惊猜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48690,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和杨公济钱塘西湖百题 其八十二 夏珠泉","author":"郭祥正","text":"入夏泉尝溢，光跳万斛珠。\n世人收得去，此景已应无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48691,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和杨公济钱塘西湖百题 其八十三 烟霞洞","author":"郭祥正","text":"玉像存深洞，烟霞分外多。\n焚香千骑入，猿鸟不经过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48692,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和杨公济钱塘西湖百题 其八十四 大慈坞","author":"郭祥正","text":"十刹密相望，林开一坞香。\n木鱼声渐急，山衲下云房。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48693,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和杨公济钱塘西湖百题 其八十五 虎跑泉","author":"郭祥正","text":"未见虎跑迹，窥泉试一吟。\n遗珠僧不取，密竹助泉深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48694,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和杨公济钱塘西湖百题 其八十六 翠樾堂","author":"郭祥正","text":"深堂待游客，老木竞留春。\n花发多临水，云开始见人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48695,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和杨公济钱塘西湖百题 其八十七 陟崖门","author":"郭祥正","text":"陟彼崖上门，门深路还绝。\n香草递仙风，怪林藏古雪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48696,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和杨公济钱塘西湖百题 其八十八 步月径","author":"郭祥正","text":"一步复一步，月华黏屐齿。\n不知山径深，疑到蟾宫里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48697,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和杨公济钱塘西湖百题 其八十九 夏凉泉","author":"郭祥正","text":"六月想冰雪，此泉清且深。\n相如方病渴，植杖故来寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48698,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和杨公济钱塘西湖百题 其九十 清隐阁","author":"郭祥正","text":"阁近山中寺，谁为清隐人。\n移文招不得，骑马入红尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48699,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和杨公济钱塘西湖百题 其九十一 樵歌岭","author":"郭祥正","text":"岭下听樵歌，歌声云外过。\n尽穷斤斧力，不道得樵多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48700,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和杨公济钱塘西湖百题 其九十二 华严塔","author":"郭祥正","text":"讲尽华严偈，摄衣辞世尘。\n泉淙死前语，玉凝塔中身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48701,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和杨公济钱塘西湖百题 其九十三 映发亭","author":"郭祥正","text":"吴越江分断，山光还映发。\n白鸟东飞来，应随渡江月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48702,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和杨公济钱塘西湖百题 其九十五 修竹轩","author":"郭祥正","text":"不作笙箫用，开花待凤凰。\n阴阴一轩里，谁识阮生狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48703,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和杨公济钱塘西湖百题 其九十六 南屏山","author":"郭祥正","text":"真山返如假，叠径入云屏。\n不借湖光洗，朝朝泼黛青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48704,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和杨公济钱塘西湖百题 其九十七 长桥","author":"郭祥正","text":"桥短故名长，路穿云水乡。\n游人欲归去，濯足弄残阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48705,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和杨公济钱塘西湖百题 其九十八 慈云岭","author":"郭祥正","text":"峻极分南北，见湖仍见江。\n游人倦登陟，飞鸟自双双。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48706,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和杨公济钱塘西湖百题 其九十九 清轩","author":"郭祥正","text":"轩压冰壶上，风生玉宇间。\n客来清彻骨，不待看湖山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48707,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和杨公济钱塘西湖百题 其一○○ 西水亭","author":"郭祥正","text":"湖添秋气净，鸟伴夕阳沉。\n呜咽城笳起，犹忘归去心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48708,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居绝句六首 其一 晓","author":"郭祥正","text":"柴门晓初启，晴气堆远峰。\n不知何处鹤，踏折一枝松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48709,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居绝句六首 其二 夜","author":"郭祥正","text":"夜阑窗户闭，黄庭看未终。\n西岩一声虎，四壁生清风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48710,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居绝句六首 其三 春","author":"郭祥正","text":"自扫松间叶，冰霜一半开。\n碧桃花未发，亭待漉香醅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48711,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居绝句六首 其四 夏","author":"郭祥正","text":"永日琴为伴，前村酒可酤。\n松阴拣磐石，赤脚踏冰壶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48712,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居绝句六首 其五 秋","author":"郭祥正","text":"有酒看云饮，无书寄雁回。\n数蛩鸣败草，一叶落青苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48713,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居绝句六首 其六 冬","author":"郭祥正","text":"黄昏鸟飞绝，夜半猿啼切。\n纸帐寒不眠，开门见猛雪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48714,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"桃源行寄张兵部","author":"郭祥正","text":"武陵溪上青云暮，昔人传有桃源路。\n时见落花随水流，咫尺神仙杳难遇。\n神仙有无何可量，但爱武陵山水强。\n松烟竹雾水村暗，鸟啼猿啸花雨香。\n车轮不来尘坌绝，日月自与乾坤长。\n闻君取身欲长往，禾熟良田给春酿。\n陶然一醉万事休，还我天真了无象。\n生胡为荣死奚戚，为笑纷纷避秦客。\n一身千岁何足论，更向渔家寄消息。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48715,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"广福禅寺","author":"郭祥正","text":"寺与人寰隔，西轩更远瞻。\n云烟生卷箔，星斗半垂檐。\n山对眉双碧，江空镜一奁。\n旅魂招不尽，愁向酒中添。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48716,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"马仁山","author":"郭祥正","text":"崔嵬山下石，如马亦如人。\n玉老龙蛇护，庵空岁月新。\n访僧非旧识，览壁但伤神。\n更恨无流水，难寻洞里春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48717,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诗一首","author":"郭祥正","text":"七十馀岁老朝郎，曾向元祐说文章。\n如今白首归田后，却与杨姝洗杖疮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48718,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重来桐城","author":"郭祥正","text":"碧水苍山照眼青，始知朱邑爱桐城。\n重来二十三年后，犹有斯民眷眷情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48719,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"五祖山拈香","author":"郭祥正","text":"白云岩畔旧相逢，往日今朝事不同。\n夜静水寒鱼不食，一炉香散白莲峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48720,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"云居山拈香","author":"郭祥正","text":"觉地相逢一何早，鹘臭布衫今脱了。\n要识云居一句玄，珍重后园驴吃草。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48721,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西方院","author":"郭祥正","text":"欲出西方更少留，云泉都占一岩幽。\n劝僧洗净阁前竹，要看南山十里秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48722,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"罗汉院","author":"郭祥正","text":"苍松夹径二十丈，碧殿藏云五百尊。\n金钟散响撼星斗，众灯续焰移朝昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48723,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和郡守西峰院","author":"郭祥正","text":"寺占西山第一峰，与君高步蹑云踪。\n西风吹尽霜林叶，放出亭亭十丈松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48724,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南安岩","author":"郭祥正","text":"汀梅之间山万重，南安岩窦何玲珑。\n青葱屹立敞四壁，巧匠缩手难为工。\n嗟予俗缚未能往，愿得结草与岩松。\n遂登彼岸达正觉，月落岩下松生风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48725,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"玩鞭亭","author":"郭祥正","text":"平芜春静水弥天，甚压危城驾广椽。\n骏马岂能追晚日，将军莫悔玩遗鞭。\n高才共倚新亭赋，逸翰重寻旧曲镌。\n千古英雄只如此，黄花修竹付幽禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48726,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]