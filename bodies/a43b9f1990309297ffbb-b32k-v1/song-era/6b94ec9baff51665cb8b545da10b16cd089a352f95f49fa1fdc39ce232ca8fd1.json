[{"title":"三衢舟次 其一","author":"白玉蟾","text":"柿叶翻黄枫叶红，一江涨起芦花风。\n水清石露沙痕瘦，日落雨来云意浓。\n诗思动摇帆影里，梦魂摇兀橹声中。\n黄昏有底愁如织，南外寄书无去鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25764,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乞纸寄诸葛桂隐","author":"白玉蟾","text":"翰墨膏肓二十年，才亲笔砚便垂涎。\n东阳鱼卵寒霜幅，嵊县溪藤妙雪笺。\n一日秃除千兔颖，霎时磨尽万松烟。\n洛阳市上今无价，直欲昂头写碧天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25765,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大都督制侍方岩先生召彭白饮于州治之春野亭因和苏子美韵","author":"白玉蟾","text":"夕阳花木丹青活，烟月山林水墨昏。\n碧缕倦飞萦宝鼎，红波惊涨溢金樽。\n掀髯醉接君谟笔，击缶吟招子美魂。\n因逐尚方双舄至，亦随桃李入春园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25766,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小桃源","author":"白玉蟾","text":"好事开三径，栽花满一园。\n前头平俯水，里面曲通村。\n自有鸠夫妇，仍多竹子孙。\n醉归迷去路，题作小桃源。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25767,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"不赴宴赠丘妓","author":"白玉蟾","text":"舞拍歌声妙不同，笑携玉斝露春葱。\n梅花体态香凝雪，杨柳腰肢瘦怯风。\n螺髻双鬟堆浅翠，樱唇一点弄娇红。\n白鸥不入鸳鸯社，梦破巫山云雨空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25768,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"为李县尉寿","author":"白玉蟾","text":"浪萍风絮客他乡，喜者青春鬓未霜。\n到处烟霞成莫逆，如今山水已相忘。\n子还真个为仙尉，我定终身作懒王。\n何似著鞭铅汞事，笑骑云外鹤翱翔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25769,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"云霄庵会宿","author":"白玉蟾","text":"春自如情暖，夜何如话长。\n酒醨成水淡，诗妙夺花香。\n月出星转闹，云行山似忙。\n起来携素手，拥被视农秧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25770,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五更解酲梅竹之间徘体","author":"白玉蟾","text":"宿鸟能传语，残风且点心。\n山情怜澹坐，月色笑孤斟。\n惊我梅花睡，闻他竹叶吟。\n清归无所得，得句贵如金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25771,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"午饭罗汉寺","author":"白玉蟾","text":"林间一径似惊蛇，中有禅关隐紫霞。\n烟锁苍松遮寺额，风摇翠竹撼檐牙。\n客来寂寞盘香穗，饭罢从容瀹茗花。\n到此徘徊归去晚，夕阳挂树一声鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25772,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"天谷庵","author":"白玉蟾","text":"半天突出一奇峰，小小茅檐滋味浓。\n夹道新松招夜月，满林幽竹唤秋风。\n迎人野鸟间关语，恼客岩花烂熳红。\n策杖且随流水去，柴门时倩白云封。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25773,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"天籁堂","author":"白玉蟾","text":"到此令人玉骨寒，四围紫翠玉回环。\n玲珑苍壁竹敲竹，重叠画屏山间山。\n猿笛晓闻冥漠外，松涛夜吼有无间。\n我将唤起陈知白，蜕却尘躯跨綵鸾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25774,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"太虚堂","author":"白玉蟾","text":"满堂冷静爽精神，不著人间一点尘。\n檐鹊噪风呼薄晚，庭花飘露落残春。\n华胥上国今无梦，龙汉元年古有身。\n香篆飞从窗外去，云梢孤鹤唳何人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25775,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"月岩","author":"白玉蟾","text":"素娥飞下碧霄间，别馆嵌空万仞寒。\n不是高悬青玉玦，直疑斜捧烂银盘。\n云根朴朔兔相似，灌木参差桂一般。\n说与长风休送上，千秋留与往来看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25776,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"月窗写闷","author":"白玉蟾","text":"不分庭前柳，长啼月下乌。\n半生嗟命薄，中夜正心孤。\n勋业看双鬓，歌吟在数须。\n从今闲草马，休得更江湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25777,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"见浙翁琰禅师","author":"白玉蟾","text":"谓师有道国人皆，何必文殊更五台。\n棒喝交驰聊复尔，离微不犯亦奇哉。\n且言风动还幡动，莫问船来与陆来。\n不道相逢不相识，尽教寒拾笑咍咍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25778,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"见懒翁 其一","author":"白玉蟾","text":"一掬精神迥出尘，懒翁自是不凡人。\n渊明松菊径犹绿，灵运池塘草正春。\n已把芝田栽枸杞，不将苔砌展蒲轮。\n家传衣钵归龙凤，自指冰壶嗣颍滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25779,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"见懒翁 其二","author":"白玉蟾","text":"坡仙何日跨鲸归，公是苏家老白眉。\n把剑舞残杯内酒，抚琴弹破笔头词。\n桂林种德不知岁，福海流长无尽时。\n他年翁若回蓬岛，稳把青毡付阿谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25780,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"北山","author":"白玉蟾","text":"驿酒沽来满满斟，现成诗句不须寻。\n轻云阁雨风声软，淡霁笼云日影沉。\n夹路栀花香野水，隔山杜宇响乔林。\n草庵饭了从容睡，门外通衢无古今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25781,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"归雁亭","author":"白玉蟾","text":"嗟予尚未发星星，今日杯茶归雁亭。\n几见霜翎巢白草，数行云足篆青冥。\n方将寄字来苕霅，莫便翻身过洞庭。\n握手亭前话今古，仇池仙墨有馀清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25782,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"归雁亭","author":"白玉蟾","text":"坡仙曾此缕归程，归雁因而扁此亭。\n草劲风刚苕水绿，水枯雪老弁山青。\n霜翎去去宾沙漠，云足翩翩影洞庭。\n渠亦偶来还自去，弋人何用慕冥冥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25783,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉壶轩","author":"白玉蟾","text":"玉壶四榻静无尘，琴上无徽笔有神。\n诗债已还休骨瘦，酒冤今醒但眉颦。\n清风吹鹤梧桐晓，明月啼猿杨柳春。\n见说玉楼新架就，紫皇有诏日来频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25784,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉壶睡起","author":"白玉蟾","text":"白云深处学陈抟，一枕清风天地宽。\n月色似催人起早，泉声不放客眠安。\n甫能蝴蝶登天去，又被杜鹃惊梦残。\n开眼半窗红日烂，直疑道士夜烧丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25785,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"白云庵","author":"白玉蟾","text":"宿雾恋乔木，落花粘瘦枝。\n鸟声人静处，山色雨来时。\n霁月成相约，凉风解见知。\n僧房安一枕，海气濯冰肌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25786,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"白石岩","author":"白玉蟾","text":"平野巉然石一拳，千崖万岫翠相连。\n鸟飞不到疑无路，云与齐高直接天。\n下面仰看岩是屋，上头仍有玉为泉。\n李仙丹熟山魈遁，尚有宸章寄紫烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25787,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"立秋有感","author":"白玉蟾","text":"流年急似箭，日月跳如丸。\n炎皇初解印，白帝又弹冠。\n方旦喜无暑，教人又怕寒。\n人生只如许，不觉鼻头酸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25788,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再会薛黄庭","author":"白玉蟾","text":"别来真梦耳，相对各潸然。\n一向于湖海，如今更市廛。\n知心能有几，顾影独兴怜。\n自叹吾衰矣，犹期子勉旃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25789,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"劣隐","author":"白玉蟾","text":"世态炎凉觉鼻酸，洞门空掩绿烟寒。\n仗三尺剑临风舞，把一张琴对月弹。\n斫竹数竿容水过，倚松半日执经看。\n山林心绪得闲处，好炼长生不死丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25790,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"华阳堂二咏 其二 会云堂","author":"白玉蟾","text":"不著人间一点尘，满堂尽是学仙人。\n衣衫总带烟霞色，杖屦相随云水身。\n铁笛横吹沧海月，纸袍包尽洞天春。\n而今会聚十方客，认看何人是洞宾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25791,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"华阳堂二咏 其一 华阳堂","author":"白玉蟾","text":"幕天席地做生涯，凡圣同居气象佳。\n拨过浮山供醉眼，斩新风月入诗怀。\n花间自舞三台鹤，竹外空歌两部蛙。\n不是道人多计较，是渠诸圣早安排。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25792,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"年踰弱冠又多锦瑟之一弦身堕尘樊未彻玉霄之半日醉怀无奈顾影自怜抱明月以兴悲向西风而思远谩拈秃兔姑慰心猿寄鹤林友","author":"白玉蟾","text":"夜凉莫听野猿哀，觉我枯肠转九回。\n淅淅秋风吹性水，淹淹暮雨滴心灰。\n自怜孤影青灯下，曾作神霄故吏来。\n若待此生尘债足，凤凰閤下已青苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25793,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戏联回文体","author":"白玉蟾","text":"水连天渺渺，山映月亭亭。\n尾棹依凫渚，头船过蓼汀。\n鬼神号暝壑，烟雾霭疏棂。\n美酝浮觞玉，轻衣拂剑星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25794,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"早秋诸友真率相聚","author":"白玉蟾","text":"白帝如今已有权，骄阳退壁渐凉天。\n兑支一霎风来享，供送三更月与眠。\n山水秋来浑是画，宾朋酒后总成仙。\n暗蛩弹镊知何处，远树长川忽眇绵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25795,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"有怀","author":"白玉蟾","text":"紫绮轻裘稳，青绫广被长。\n明珠怀夜月，孤剑匣秋霜。\n气魄今诸葛，襟期旧子房。\n西风一长啸，草木正凄凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25796,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"有赠","author":"白玉蟾","text":"云锁蓬莱海接天，琪花瑶草簇春烟。\n三千年里桃初实，十二楼前月正圆。\n白日尘埃飞不到，青冥风露冷无眠。\n共君既饱胡麻饭，一棹归欤弱水船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25797,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次水帘洞韵","author":"白玉蟾","text":"天上真珠直下垂，更无钩箔惹尘埃。\n青鸾白鹤从教入，紫诏黄封不用来。\n夜月祇为苏邝照，晚风端与葛黄开。\n纵饶展挂长千尺，莫掩罗浮紫翠堆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25798,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次李侍郎见赠韵","author":"白玉蟾","text":"家居琼馆海山隅，腹内包藏三教书。\n明月清风为活计，蓬头跣足走寰区。\n玉炉丹熟斟琼醑，金阙朝回唱步虚。\n要识我侬真面目，广寒宫里看蟾蜍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25799,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次黄提刑雪韵","author":"白玉蟾","text":"久晴忽尔雨丝丝，既雨还晴亦不疑。\n滕六假宁催入局，赵衰回避乞寻医。\n捣霜碾雹些来个，剪水雕冰片子时。\n一夜悄然飞到晓，满天满地化琉璃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25800,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵王将仕","author":"白玉蟾","text":"诗坛勍敌我何堪，只把新诗著意参。\n韵险有如行栈閤，句香何止食馀甘。\n江寒风落馀章谬，鸟过身轻一字惭。\n饭了相陪閒笑语，锦囊非我许谁探。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25801,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵东坡蒲涧寺 其二","author":"白玉蟾","text":"陈踪行览寺门前，自取椰瓢酌冷泉。\n山下果然无白地，洞中尽自有青天。\n更谁识得安期事，且去参他景泰禅。\n冠盖如云自来往，如今何处有神仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25802,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵东坡蒲涧寺 其一","author":"白玉蟾","text":"满山红白福桑花，蒲涧深中尽可家。\n景泰得泉从卓锡，安期种枣说成瓜。\n岂无仙化羊如石，尚有书踪壁似鸦。\n一饭招提共僧语，法华经里问牛车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25803,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵宋秀才","author":"白玉蟾","text":"昼弄朱曦夜弄蟾，知他何处地行仙。\n殿前昔奏三千字，腰下曾缠十万钱。\n得句直疑无李白，草书真个过张颠。\n有时兴发临风舞，饮似长鲸吸百川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25804,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵彬上人见惠","author":"白玉蟾","text":"象轮何事过毗耶，诗窍禅关事一家。\n自古行春难尽美，非风即雨辄成差。\n我文柔似三眠柳，君句清如六出花。\n应悟己公茅屋下，拟之早已涉河沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25805,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵紫岩潘庭坚 其二","author":"白玉蟾","text":"何人皮里有阳秋，谁绢能包得许羞。\n早趁黄书丞相押，莫空白了少年头。\n既无顾恋于人己，便请清闲袖手休。\n岂必灭秦安汉后，始来寻个赤松游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25806,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵紫岩潘庭坚 其一","author":"白玉蟾","text":"人情不似吴笺厚，世路常如蜀道难。\n两鬓已将沾雪白，寸心尚自炳枫丹。\n君还有意凭谁说，我亦无言把剑看。\n相对一窗风打雪，通红榾柮谩烧残。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25807,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"红梅","author":"白玉蟾","text":"人赋红梅少，予诗为补遗。\n霞融姑射面，酒沁寿阳肌。\n太洁遭时妒，独醒为众疑。\n漫随春色媚，自保岁寒姿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25808,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟中遣兴二首 其二","author":"白玉蟾","text":"暮树烟凝翠，秋花雨著黄。\n万松罗谷口，一鹤点山阳。\n霜叶梦零乱，云山望杳茫。\n眼稍林下寺，髣髴数支郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25809,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟中遣兴二首 其一","author":"白玉蟾","text":"江水皱寒绿，山花蓓淡黄。\n断云漫远浦，归雁背斜阳。\n客恨何凄寞，诗怀堕渺茫。\n人生本萧散，我欲问渔郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25810,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟行西湖诗赠诸友","author":"白玉蟾","text":"二十年来云水身，今凡七度踏京尘。\n丝长岁月能多少，粟大功名徒苦辛。\n白日戏陪人世事，绿烟锁断洞门春。\n云岩月岫今何处，一听猿声一怆神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25811,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟行适兴","author":"白玉蟾","text":"天知一舸过扶胥，排办千山作画图。\n暮霭催诗归彩笔，秋光入酒透冰壶。\n篙头点水月破碎，云脚行天星有无。\n岸柳江枫共招手，西风吹我出贲隅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25812,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过林灵素坟","author":"白玉蟾","text":"众僧莫怨赵归真，此是容成太玉君。\n始末四年曾就日，相将五秩即腾云。\n帝心俾立神霄教，州额由升应道军。\n泉石依然冠剑冷，至今雷电禦松坟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25813,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初冬即事","author":"白玉蟾","text":"支颐默默靠柴扉，顿放诗题塞翠微。\n三径寒松含宿雨，一川衰草卧斜晖。\n孤烟白处丫峰露，乱叶红边个鸟归。\n触目园林已如洗，菊花犹著郁金衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25814,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初至肇庆府砚岩","author":"白玉蟾","text":"峡口青门束碧流，天生双剑割清秋。\n可怜柳叶黄如此，曾见芦花白也不。\n本意买舟归楚国，此行为砚访端州。\n渴来欲吸三江水，洗出胸中万斛愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25815,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"别句呈庚契吴高士","author":"白玉蟾","text":"一笑相逢在翠微，绿槐高柳借凉时。\n只将水竹烟云兴，说与风花雪月知。\n日落三杯无事酒，人闲八句自然诗。\n来朝云过青山外，回首空闻猿鹤悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25816,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"别李仁甫","author":"白玉蟾","text":"君向星江结草庐，我来抵掌笑相于。\n三杯碧液涨瓷盏，一缕青烟缠竹炉。\n剑舞春风花烂熳，琴弹夜雨竹萧疏。\n明朝拄杖知何处，猿叫千山月满湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25817,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"别蒋都辖用归雁韵","author":"白玉蟾","text":"别来不觉八周星，过尽长亭又短亭。\n霜雁贴天飞去去，弋人何事慕冥冥。\n梅开春信宾南国，草劲秋声警虏庭。\n我亦年来还慷慨，亭前一笑万山青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25818,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即事寄紫元","author":"白玉蟾","text":"老雨饯秋菊，孤烟酝暮岚。\n雁惊十月北，梅早一枝南。\n往事风吹帽，良宵月挂簪。\n时哉亦难得，我已到无参。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25819,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"呈万庵十章 其四 火候","author":"白玉蟾","text":"无位真人炼大丹，倚天长剑逼人寒。\n玉炉火煅天尊胆，金鼎汤煎佛祖肝。\n百刻寒温忙里准，六爻文武静中看。\n有人要问真炉鼎，岂离而今赤肉团。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25820,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"呈万庵十章 其一 归山","author":"白玉蟾","text":"生死轮回第几番，尘尘劫劫不曾闲。\n一潭湛绿是非海，千尺粉青人我山。\n性地灵苗思水国，心天明月掩云关。\n衣中珠子无寻处，今且随邪炼大还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25821,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"呈万庵十章 其九 冲举","author":"白玉蟾","text":"自从踏著涅槃门，一枕清风几万年。\n弱水蓬莱虽有路，释迦弥勒正参禅。\n谁将枯木岩前地，放出落花啼鸟天。\n两个泥牛斗入海，至今消息尚茫然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25822,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"呈万庵十章 其五 沐浴","author":"白玉蟾","text":"药炉丹鼎火炎炎，六贼三尸怕令严。\n无去无来无进退，不增不减不抽添。\n爱河浪静浮朱雀，觉海波深浸白蟾。\n一自浴丹归密室，太阳门下夜明帘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25823,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"呈万庵十章 其十 参同","author":"白玉蟾","text":"道人家在海之南，来访庐山老万庵。\n露柱灯笼同请举，僧堂佛殿总和南。\n山河大地自群动，蠢动含灵共一龛。\n齑瓮里鱼淹未死，此香炷向活瞿昙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25824,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"呈万庵十章 其三 炉鼎","author":"白玉蟾","text":"须信先天事事无，阴阳陶铸此形模。\n真空平等朱砂鼎，虚彻灵通偃月炉。\n九窍可风坛墠暖，二时失火药材枯。\n只兹一点无明燄，炼出人间大丈夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25825,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"呈万庵十章 其二 采药","author":"白玉蟾","text":"五蕴山头多白云，白云深处药苗芬。\n威音王佛随时种，元始天尊下手耘。\n石女骑龙攀雨㼌，木人驾虎摘霜芸。\n不论贫富家家有，采得归来各一斤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25826,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"呈万庵十章 其八 金丹","author":"白玉蟾","text":"佛与众生共一家，一毫头上现河沙。\n九还七返鱼游网，四谛三空兔入罝。\n混洗何年曾结子，虚空昨夜复生花。\n阿谁鼎内寻丹药，枯木岩前月影斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25827,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"呈万庵十章 其七 脱胎","author":"白玉蟾","text":"青天白日一声雷，撒手悬崖了圣胎。\n有眼如盲光烁烁，无绳似缚笑咍咍。\n黄金殿下千株柳，碧玉堂前万树梅。\n辜负鸳帏人寂寞，秦楼宴罢盍归来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25828,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]