:"宋"}},{"title":"偈颂一百四十一首 其一二三","author":"释师范","text":"浅闻深悟，深闻不悟。\n迷逢达磨，赵婆呷醋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12396,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其五十八","author":"释师范","text":"一冬二冬，叉手当胸。\n珠钻九曲，直在其中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12397,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其二","author":"释师范","text":"祖师巴鼻，衲僧巴鼻。\n有些巴鼻，全没巴鼻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12398,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其二十","author":"释师范","text":"谷熟豆熟，粥足饭足。\n仰面看天，两手扪腹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12399,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其七十","author":"释师范","text":"纵无所畏，说大脱空。\n虽有希求，辨最上供。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12400,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其一三四","author":"释师范","text":"二月十五，瞿昙灭度。\n诸天悲泣，群魔鼓舞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12401,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其三十八","author":"释师范","text":"三门佛殿，一见便见。\n踢倒净瓶，撼动门扇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12402,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其二十九","author":"释师范","text":"安居结制，现前三昧。\n普化摇铃，老卢踏碓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12403,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其一","author":"释师范","text":"前三后三，今日明日。\n达磨不会，九年面壁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12404,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其三","author":"释师范","text":"灵山话月，曹溪指月。\n递代相传，證龟成鳖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12405,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其八","author":"释师范","text":"瞿昙瞬目，迦叶破颜。\n山僧闻得，咬定牙关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12406,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其七十四","author":"释师范","text":"扰扰匆匆，晨鸡暮钟。\n瑞岩不会，唤主人翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12407,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其七十","author":"释师范","text":"一夏已满，无事不办。\n遂府钵盂，邛州磁碗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12408,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其六十八","author":"释师范","text":"龙蛇混杂，凡圣交参。\n儱儱侗侗，颟颟顸顸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12409,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其六十四","author":"释师范","text":"一见便见，更不再见。\n张颠草书，李广神箭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12410,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其五十六","author":"释师范","text":"户牖见通，墙壁生碍。\n簸箕有唇，洞庭无盖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12411,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其三十九","author":"释师范","text":"佛祖命脉，洞然明白。\n黑漆屏风，松萝亮隔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12412,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其三十四","author":"释师范","text":"二由一有，一亦莫守。\n文殊普贤，泥猪疥狗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12413,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其二十七","author":"释师范","text":"一阳来复，万汇发生。\n寒谷回春，冰河解冻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12414,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其二十一","author":"释师范","text":"倾盖相逢，已成多事。\n侧鞭回首，早涉繁词。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12415,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十七首 其十一","author":"释师范","text":"机不离位，沉乎醉乡。\n语不离窠，滞在金网。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12416,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十七首 其八","author":"释师范","text":"面门一思，长时无间。\n见成句子，百味完全。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12417,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十七首 其七","author":"释师范","text":"六爻既穷，阴魔自殄。\n一阳来复，吾道大亨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12418,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十七首 其三","author":"释师范","text":"滴水滴冻，浑无罅缝。\n明眼衲僧，失却鼻孔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12419,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寒山持经拾得手接 其二","author":"释师范","text":"自有一经，不肯受持。\n却从他觅，可煞愚痴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12420,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寒山持经拾得手接 其一","author":"释师范","text":"手持经卷，付与同伦。\n己所不欲，勿施于人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12421,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"达磨祖师赞 其二","author":"释师范","text":"满面尽是胡须，当门却无版齿。\n纵不画影图形，东土有人识你。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12422,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其一○五","author":"释师范","text":"瞿昙你自瞿昙，达磨从他达磨。\n佛法有底商量，各自归堂向火。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12423,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其九十六","author":"释师范","text":"人皆竞赏中秋，惟有山僧不管。\n大都天上月圆，只是寻常月半。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12424,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其一○○","author":"释师范","text":"二月春光明媚，是处花酣柳醉。\n五湖四海禅流，切忌开眼瞌睡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12425,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其六十","author":"释师范","text":"径山不敢相谩，开口便见心肝。\n今朝十月十五，下元解厄水官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12426,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"普化赞","author":"释师范","text":"恣意放颠放呆，走遍前街后街。\n就中一处叵耐，大悲院里有斋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12427,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送僧归凤山","author":"释师瑞","text":"凤凰山下凤凰儿，文綵才彰羽翼齐。\n铁网漫天拦不得，归心已在碧梧枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12428,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游碧落洞","author":"释延吉","text":"碧落有仙躅，回溪限尘迹。\n虎穴建空岩，鸟道齐峭壁。\n苍松动寒吹，孤云触幽石。\n物外诣所乐，高谈混儒释。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12429,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"金鸡峰","author":"释延寿","text":"松萝高镇夏长寒，透出群峰画恐难。\n造化功成彰五德，洞天云散露花冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12430,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈一首","author":"释延寿","text":"孤猿叫落中岩月，野客吟残半夜灯。\n此境此时谁会意，白云深处坐禅僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12431,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"野游","author":"释延寿","text":"独步出衡茅，寒云著地交。\n烧平多败穴，叶落见危巢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12432,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蛾眉峰","author":"释延寿","text":"盘空势险露岩根，深洞声寒落石泉。\n好是雨馀江上见，水云僧出认西天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12433,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居诗 其五十一","author":"释延寿","text":"名利梯媒事已忘，唯凭拙直定行藏。\n探玄休炼长生药，助道时抄歇食方。\n溪汲古痕山雨涨，树摧残蘖野风狂。\n一言欲寄休回首，尘路如今事正忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12434,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居诗 其三十六","author":"释延寿","text":"抱拙藏锋过暮年，高名何必指前贤。\n祇于心上标空界，谁说壶中别有天。\n郁密远林停宿雾，萧骚疏竹埽寒烟。\n从兹不更移瓶锡，身外无馀意了然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12435,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居诗 其三十","author":"释延寿","text":"何如深谷一遗人，宴坐经行不累身。\n废宅可嗟频换主，凋丛愁见几回春。\n尖尖石笑烟笼碧，点点苔钱雨洗新。\n堪笑古人非我意，居山多是避强秦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12436,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居诗 其六十二","author":"释延寿","text":"绿柳堤边春色多，数树重重袅翠萝。\n红白花枝争斗发，晴阴天气半相和。\n中山谩醉千壶酒，易水徒悲一曲歌。\n尘世无凭唯道外，荣枯瞬息尽消磨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12437,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居诗 其四十七","author":"释延寿","text":"豪贵从他纵胜游，多欢终是复多愁。\n茅茨舍宇偏安稳，粪埽衣裳最自由。\n数片云飞书案上，一条泉路卧床头。\n分明自有安身处，争柰人閒不肯休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12438,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居诗 其五十八","author":"释延寿","text":"养性摅情不记年，免寻云水更参禅。\n有心用处还应错，无意看时却宛然。\n析法尚嫌灰断果，烧丹堪悯地行仙。\n欲知此理谁人会，水自朝东月自圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12439,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居诗 其二十九","author":"释延寿","text":"幽栖岂可事徒然，昼讽莲经夜坐禅。\n吟里有声皆实相，定中无境不虚玄。\n直教似月临千界，还遣如空度万缘。\n从此必知宏此志，免教虚掷愧前贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12440,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居诗 其三","author":"释延寿","text":"祇园閒适乐箪瓢，莫讶烟霞道路遥。\n龙穴定知潜碧海，鹏程终是望丹霄。\n拨云岩下来泉脉，嚼草坡边辨药苗。\n门锁薜萝无客至，庵前时有白云朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12441,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居诗 其五十五","author":"释延寿","text":"退迹何人继昔贤，凡途终是事谋先。\n只知竞逐浮云富，谁解惊嗟逝水年。\n寒影半疏霜后树，秋声千点雨中禅。\n千般不更经营得，一榻无馀任自然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12442,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居诗 其四十","author":"释延寿","text":"遁迹无图匿姓名，万重山后葺茅亭。\n随情因事搜新偈，探妙穷微阅古经。\n与道交时心绝念，从缘感处物通灵。\n应须长远存高节，屹屹乔松老更青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12443,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]