[{"title":"耕","author":"翁森","text":"村北村南叫杜鹃，蓑披春雨掏含烟。\n不辞辛苦秋成熟，会见黄云遍野田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59189,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宿山中田家","author":"翁森","text":"攲坐颓檐醉浊醪，松油烧尽夜萧骚。\n儿童十岁能吹笛，嘹亮一声山月高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59190,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔","author":"翁森","text":"三月桃花浪暖初，隔溪人问有鱼无。\n回言未纳官租税，不敢私将网下湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59191,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"落花呈王如山监簿","author":"翁森","text":"满地飞花锦作堆，休言落后不如开。\n爱渠不逐波流去，自在阴崖覆绿苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59192,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"樵","author":"翁森","text":"妻出叮咛夫转听，采薪须束担头轻。\n夜来雨过苍苔滑，莫向巉岩险处行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59193,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"方岩次李学补韵","author":"翁森","text":"散策松边寺，无心任去留。\n山昏云欲暝，地迥月涵秋。\n细响鸟惊树，孤吟僧倚楼。\n重阳明日是，又作十天游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59194,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过天台","author":"翁森","text":"日落千山外，悠然一望赊。\n黄檀六七里，绿竹两三家。\n幽步窥残雪，孤愁入远霞。\n今宵何处宿，茆屋有梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59195,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春暮即事","author":"翁森","text":"啼鹃春已暮，徙倚念流光。\n雨涨溪舂急，山晴火种忙。\n寻芳知兴浅，怀远觉愁长。\n两月无来客，青苔满石床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59196,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"柬陈南园","author":"翁森","text":"自昔贤哲士，遭运每多屯。\n世途自屈曲，难揉胸轮囷。\n终夜起太息，所忧非贱贫。\n相望各努力，勖哉追古人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59197,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送行可和尚游雁宕","author":"翁森","text":"灵运平生屐，如何一瘦藤。\n夕阳红叶寺，秋雨白头僧。\n阅世三兵火，传心几佛灯。\n讵罗还记我，曾向此山登。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59198,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏日书怀","author":"翁森","text":"孤坐衲蒙头，岩扉花竹幽。\n山明云罢雨，天迥月悬秋。\n煮茗猿分饮，藏蔬鼠或偷。\n道人方睡去，梦入五台游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59199,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄怀吕六松","author":"翁森","text":"西风吹薄暝，万叶赋秋声。\n高鹄云边少，孤蝉雨后清。\n年光凄短思，世态重离情。\n石壁沧洲阔，休寒白鹭盟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59200,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"四时读书乐 其二","author":"翁森","text":"新竹压檐桑四围，小斋幽敞明朱曦。\n昼长吟罢蝉鸣树，夜深烬落萤入帏。\n北窗高卧羲皇侣，只因素稔读书趣。\n读书之乐乐无穷，瑶琴一曲来薰风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59201,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"四时读书乐 其四","author":"翁森","text":"木落水尽千崖枯，迥太吾亦见真吾。\n坐对韦编灯动壁，高歌夜半雪压庐。\n地炉茶鼎烹活火，一清足称读书者。\n读书之乐何处寻，数点梅花天地心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59202,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"四时读书乐 其三","author":"翁森","text":"昨夜庭前叶有声，篱豆花开蟋蟀鸣。\n不觉商意满林薄，萧然万籁涵虚清。\n床前赖有短檠在，及此读书功更倍。\n读书之乐乐陶陶，起弄明月霜天高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59203,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"四时读书乐 其一","author":"翁森","text":"山光照槛水绕廊，舞雩归咏春风香。\n好鸟枝头亦朋友，落花水面皆文章。\n蹉跎莫遣韶光老，人生唯有读书好。\n读书之乐乐何如，绿满窗前草不除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59204,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次古堂岁寒杂书韵","author":"翁森","text":"清新如修竹，月露洗琅玕。\n爱之不能舍，一月三四看。\n伊人伟识量，文字馀波澜。\n出处早见几，在汉申屠蟠。\n风雨江村暮，门掩清灯寒。\n所抱寸心在，千载重不刊。\n满前炽子孙，已足遗以安。\n会当骖白鹿，华顶炼还丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59205,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吴烈女","author":"翁森","text":"士习与世换，一堕不自持。\n宁如二女子，至性不自移。\n人之能为人，所惧大节亏。\n吾父死汝手，吾身岂汝随。\n匪云随我节，义合同其归。\n空山雨流血，白日寒无辉。\n女子有是哉，道旁为嗟咨。\n北风飒万类，始见青松姿。\n有女焯其行，发潜可无诗。\n死其身不顾，身后遑所知。\n伤心复伤心，风味日以漓。\n寄语读书者，曷不愧于斯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59206,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"采桑","author":"翁森","text":"采桑子，采桑子。\n朝去采桑日已曙，暮去采桑云欲雨。\n桑叶郁茂寒露眉，桑枝屈曲勾破衣。\n大妇年年忧蚕饥，小妇忙忙催叶归。\n东邻女，对西乡，道蚕眠起较迟早。\n已觉官吏促早缲，新丝二月已卖了。\n卖了新丝更栽桑，桑栽还似去年长，岂知城中花囿花压墙。\n朱楼旭日映红妆，不识桑树有罗裳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59207,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄陈古堂 其一","author":"翁森","text":"往来几兴亡，古今一天地。\n而人生其中，云胡不自贵。\n渺予寸心孤，浩发千载喟。\n残夜抱遗编，青灯照无寐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59208,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题陶渊明临流赋诗图","author":"翁森","text":"閒居淡无事，临流忽有得。\n平生诗外心，滩上一鸥白。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59209,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅溪铺","author":"翁赐坡","text":"村北村南春水，山前山后人家。\n夜来何处飞雨，流出碧桃数花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59210,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寿刘上舍将仕 其二","author":"翁溪园","text":"英声璧水早年蜚，官样文章价久驰。\n汉殿紫荷应有种，燕山丹桂又传枝。\n名驹行作铨闱冠，文虎因须锁试知。\n他日汪黄推榜首，立身事业尽优为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59211,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寿刘上舍将仕 其一","author":"翁溪园","text":"鲁台昨夜已书云，喜报今朝纪绂麟。\n五色祲呈迎瑞气，一阳道长庆亨辰。\n定知昴宿钟英质，须信长庚现后身。\n敢效髯秦诗格献，蓂敷十一寿千春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59212,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠易数胡一鉴","author":"翁溪园","text":"招牌名一鉴，数学得来真。\n以子胸中易，照他天下人。\n穷通窥见影，贤佞写成神。\n莫但为人监，回光监子身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59213,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠谈命江文魁","author":"翁溪园","text":"四十头颅昨自知，行年懒问斗牛箕。\n才如昭纬甘居下，命若夏侯徒抵疑。\n蟠屈尚怀云雨志，坚刚犹励雪霜姿。\n阶前松已围三尺，一笑仍烦季主推。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59214,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠谈命江文魁","author":"翁溪园","text":"刮眼相逢四五秋，知君艺出万人头。\n但看巨轴藏盈袖，不信行囊尚弊裘。\n建阁程生藏瑞墨，买田张衍寄英游。\n从来有术高天下，莫但人谋当自谋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59215,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"紫姑仙为诗索和因用其韵赠范法官 其一","author":"翁溪园","text":"五云楼阁阆风高，玉女轻轻月下敲。\n軿御为人催凤驾，功名报我在螭坳。\n寒灰草出千言妙，爇烬诚由一念交。\n何事赋诗徵速和，一吟聊解子云嘲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59216,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水龙吟 代寿制师贾参政","author":"翁溪园","text":"镇淮楼下旌旗，晶明辉映云山阁。\n宸旒倚重，折冲千里，无逾秋壑。\n缓带轻裘，纶巾羽扇，从容筹略。\n使毡裘胆破，丁宁边吏，无生事，空沙漠。\n二十四桥风月，称迷楼、卷尽帘箔。\n绂麟华旦，饱吟玉蕊，款簪金药。\n驿骑朝驰，宝鞍赍赐，御筵宣押。\n更赐环促召，中书入令，作汾阳郭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59217,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水调歌头 寿常州刘守","author":"翁溪园","text":"丹鹤结青士，玄鹿侍苍官。\n寿仙堂下，应伴凫舄戏莱斑。\n麟记当年绣绂，燕剪今朝彩胜，淑气逐椒盘。\n孕毓阳和粹，独占一春先。\n平淮了，勋业盛，傲东山。\n中原犹待经略，趣诏凤池还。\n更数尧阶五荚，又上华封三祝，千载圣须贤。\n即拜玉枝赐，长冠紫宸班。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59218,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"沁园春 代寿宗室","author":"翁溪园","text":"记得花筵，巧夕星河，初度女牛。\n更四双蓂荚，十分桂魄，中元佳致，妆点初秋。\n蔼蔼非烟，濛濛如雾，锦水郁葱佳气浮。\n人人道，是王孙帝胄，今日生朝。\n银潢万叶源流。\n见一点长庚辉绛霄。\n似东平为善，河间献雅，风流酝藉，西汉诸刘。\n恰遇称觞，蓬壶歌缓，满酌蒲萄双玉舟。\n椿松等算，年年醉傲，花马金裘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59219,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"洞仙歌 代寿李尉儒人","author":"翁溪园","text":"几番梅雨，蒲风过、端阳后。\n细数月轮，犹待双蓂秀。\n戏彩华堂宴，设帨朱门右。\n酌金荷，争献寿。\n蟠桃新熟，阿母齐长久。\n一门奋建，攀桂客、无双手。\n好事来春在，杏苑联蓝绶。\n应继琼林董，却胜燕山窦。\n夸盛事、真罕有。\n金花封诰，管取重重受。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59220,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"踏莎行 寿人母八十三","author":"翁溪园","text":"蓂荚飞双，桂分缺二。\n金风已肃深秋意。\n萱庭戏彩恰称觞，蕊宫仙子天台裔。\n鹤发童颜，龟龄福备。\n孩儿书额添三字。\n常将机训付儿孙，取青行拥潘舆侍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59221,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"华胜寺题壁","author":"翁蒙之","text":"高阁登临佛国春，逍遥聊复话前因。\n老来白业渐欲近，兴到青山相与新。\n扰扰簿书抛旧梦，迢迢钟磬著闲身。\n笑他车马临官道，不及朝耕暮读人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59222,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送水云归吴","author":"翁懿淑","text":"金门夜醉紫霞觞，乞得黄冠还故乡。\n一似陈抟归华岳，又如李泌过衡阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59223,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"耿仙芝","text":"浅水短芜调马地，淡云微雨养花天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59224,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其一","author":"耿时举","text":"露压蔷薇金井栏。\n辘轳声断碧丝乾。\n辽阳无信带围宽。\n花落池塘春梦静，月生帘幕夜香寒。\n闲愁无力凭阑干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59225,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其二","author":"耿时举","text":"独鹤山前步药苗。\n青山只隔过溪桥。\n洞宫深处白云飘。\n碧井卧花人寂寞，画廊鸣叶雨潇潇。\n漫题诗句满芭蕉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59226,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜迁莺","author":"耿时举","text":"暮春清昼。\n政莺啭夏林，棠阴初秀。\n鼓角欢雄，旌旗明灭，宝马又还西骤。\n山水六朝堪画，宫阙千门如绣。\n印悬斗。\n盛元戎小队，花间迎候。\n芳酎。\n为公寿。\n带雨梨花，未用啼红袖。\n玉帐风前，胡床月下，谈笑要清群丑。\n桃叶渡船应在，太白酒楼依旧。\n暂回首。\n看槐班爰立，沙堤成就。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59227,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"满江红 中秋泛月太湖","author":"耿时举","text":"问月杯空，谪仙去、无人重举。\n兰台旧、扁舟乘兴，处留奇语。\n洞府初疑仙骨瘦，樽前尚爱纶巾舞。\n信前身、太白尚何疑，词高古。\n盟后会，偕真侣。\n黄叶渡，丹枫渚。\n道五湖烟浪，胜游湓浦。\n念我神闲鸥样度，似海山共去君应许。\n但只愁、岳牧要人□，□撑住。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59228,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽崔舍人","author":"耿秉","text":"足蹑修门甫十年，惟馀篇翰富流传。\n横经趣得陈编外，草制雄誇落笔先。\n争美冰衔尘不染，忍观华□□随迁。\n忠输丹扆箴犹在，一鉴云亡共黯然。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59229,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题丹灶 其四","author":"耿南仲","text":"过客空寻访，飞仙已杳冥。\n他山多可买，归去读黄庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59230,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题丹灶 其三","author":"耿南仲","text":"始知勾漏地，犹胜步兵营。\n往躅今谁继，游人空慕名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59231,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题丹灶 其二","author":"耿南仲","text":"金鼎交龙虎，当年想闭扃。\n一丸丹既就，五色土犹灵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59232,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题丹灶 其一","author":"耿南仲","text":"稚川初隐地，山邃枕如城。\n宝鼎丹何在，云衣骨亦轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59233,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"延祥寺","author":"耿南仲","text":"罗浮仙客隐，准拟访丹台。\n为国身将老，逢山眼倍开。\n月依松上过，风自竹间来。\n僧欲延清话，茶香屡拨灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59234,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和邓慎思未试即事杂书率用秋日同文馆为首句三首 其三","author":"耿南仲","text":"蔼蔼儒冠至，恢恢贤路开。\n才须金鉴别，人自玉山来。\n谢客书千卷，嵇康酒一杯。\n如君富术业，当与雉为媒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59235,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和邓慎思未试即事杂书率用秋日同文馆为首句三首 其二","author":"耿南仲","text":"大轴累千箱，凫中见鹤长。\n静临窗几读，爽入肺肝凉。\n誇咤争求胜，疲劳忽自忘。\n由来京邑贡，正合冠多方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59236,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和邓慎思未试即事杂书率用秋日同文馆为首句三首 其一","author":"耿南仲","text":"败叶扫还飞，秋容肃粉闱。\n青钱如已选，白璧会须归。\n燕坐书横案，孤吟月满衣。\n还同潘散骑，鱼鸟性都违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59237,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和邓慎思同舍问及故山景物用钟字韵诗以答","author":"耿南仲","text":"草庐高卧对千峰，白眼谁能顾万钟。\n仄席不因天子诏，藏诗未许世人逢。\n他年社稷勋如立，归老烟霞志会从。\n五柳一松应好在，月明空自结阴浓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59238,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和邓慎思初入试院","author":"耿南仲","text":"昭回云汉九天横，冠带彬彬尽俊英。\n梁国有珠光照乘，赵人怀璧价连城。\n道山邃处分群彦，文律持来考正声。\n秋晚定知谁入彀，叔通还进鲁诸生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59239,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和邓慎思诗呈同院诸公三首 其三","author":"耿南仲","text":"秋日同文馆，新凉逐雨回。\n棘垣婴吏局，蕙帐忆山隈。\n射为巧狙发，田因文豹来。\n西城随分锁，夫我室多才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59240,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和邓慎思诗呈同院诸公三首 其二","author":"耿南仲","text":"秋日同文馆，袖然观国光。\n泗滨何限磬，岱麓易求梁。\n剑气频冲斗，锥锋定出囊。\n于余惭拙匠，操尺预量长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59241,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和邓慎思诗呈同院诸公三首 其一","author":"耿南仲","text":"秋日同文馆，閒无一事依。\n斗羊谁得隽，倦鸟客思归。\n寝处还相向，过从不患稀。\n何当有星聚，谁为问璇玑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59242,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和邓慎思秋日同文馆诗三首 其三","author":"耿南仲","text":"翠幕春云合，场登看舞鸡。\n冥搜人不到，惊盼日沉西。\n瞢学愁精鉴，英材喜巨题。\n何人当首选，双觡起蚖泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59243,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和邓慎思秋日同文馆诗三首 其一","author":"耿南仲","text":"诏命连催发，英髦一日齐。\n周瑜醇似酒，崔远爽于梨。\n高馆清无梦，寒灯坐赋题。\n还同宿山驿，风雨闭重闺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59244,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和邓慎思秋日同文馆诗三首 其二","author":"耿南仲","text":"槐市任花黄，赓歌且辟场。\n醒心流水曲，警耳白云章。\n冷竹枝枝翠，芳兰叶叶香。\n满前皆俊彦，何但有三康。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59245,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和邓慎思重九考罢试卷书呈同院诸公","author":"耿南仲","text":"贡珍已选茂良充，犹被拘縻类缚钟。\n渌酒强陪高馆饮，黄花不似故园逢。\n棋枰苦战挑灯坐，藓壁閒题捧砚从。\n风叶满庭秋索寞，更筹向尽睡方浓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59246,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和余樗年试院即事呈诸公","author":"耿南仲","text":"重门键钥阻山河，顾有良朋不厌过。\n唾落如珠倾巨斛，袂挥成幕散轻罗。\n惭分处士吹竽俸，谩学东人掩鼻歌。\n笑语哄堂俄又夜，客愁还奈我曹何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59247,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用功成韵赋外舅短项翁","author":"耿镃","text":"君不见王绩非狂生，笔墨扫尽惟酒经。\n又不见志和非漫尉，江湖醉咏渔歌耳。\n文章得失两梦事，一醉从渠俱不理。\n人间自有行秘书，此翁聊为山泽儒。\n平生斟酌自饱满，宁复有欠宁有馀。\n可怜蹒跚挽不前，属车岂识从甘泉。\n不矜万卷腹空洞，渴梦只恐东溟乾。\n莫疑此翁拘器穷，此翁有用非哑钟。\n浊醪作贤清作圣，翁不异味同其空。\n我方畏缩立下风，伸颈一笑短项逢。\n脱冠与翁共醉倒，从人笑此两秃翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59248,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用彦平韵赋石外舅短项翁","author":"耿镃","text":"人生何地逃奇耦，白发转头成宿莽。\n百年同尽草一丘，谁见乘槎上牛斗。\n不如醉倒三万场，何必龙山岁重九。\n先生元是古达人，身外所忻惟有酒。\n石交自得短项翁，燕颔鸢肩非我友。\n迩来带眼宽绿筠，结喉不造鸳鹭群。\n十年孛窣墙下尘，仰面讵识高昆崙。\n先生取人略形貌，翁获展尽终不浑。\n我欲挽翁归翠微，手栽杞菊如天随。\n愿翁醉客莫嫌扰，买山政赋淮南小。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59249,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西楼","author":"耿镃","text":"西楼一曲旧笙歌，千古当楼面翠峨。\n花发花残香径雨，月生月落洞庭波。\n地雄鼓角秋声壮，天迥阑干夕照多。\n四百年来逢妙手，要看风物似元和。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59250,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"曾公道夫出示先世手泽敛衽拜观之馀敬题二小诗 其二","author":"聂子述","text":"一门翰墨森圭璧，诸老题评粲锦花。\n珍重云仍好收拾，夜虹贯月定君家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59251,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]