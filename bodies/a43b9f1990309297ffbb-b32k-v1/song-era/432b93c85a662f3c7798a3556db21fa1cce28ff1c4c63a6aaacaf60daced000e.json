ommit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6369,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蔬圃绝句七首 其四","author":"陆游","text":"瓦叠浮屠盆作池，池边红蓼两三枝。\n贪看忘却还家饭，恰似儿童放学时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6370,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蔬圃绝句七首 其三","author":"陆游","text":"青青蔬甲早寒天，想像登盘已堕涎。\n更欲锄畦向东去，园丁来报竹行鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6371,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蔬圃绝句七首 其一","author":"陆游","text":"拟种芜菁已是迟，晚菘早韭恰当时。\n老夫要作斋盂备，乞得青秧趁雨移。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6372,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蔬圃绝句七首 其六","author":"陆游","text":"冲雨冲风不怕寒，晚来日出短蓑乾。\n绕畦拾块真为乐，莫作陶公运甓看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6373,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝶","author":"陆游","text":"庭下幽花取次香，飞飞小蝶占年光。\n幽人为尔凭窗久，可爱深黄爱浅黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6374,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉中作四首 其一","author":"陆游","text":"晚途豪气未低摧，一饮犹能三百杯。\n烂烂目光方似电，齁齁鼻息忽如雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","poi