a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉归二首 其二","author":"陆游","text":"乌桕阴中把酒杯，山园处处熟杨梅。\n醉行踸踔人争看，蹋尽斜阳蹋月来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6388,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉归二首 其一","author":"陆游","text":"夜分饮散酒家垆，归路迢迢月满湖。\n小竖窃言翁未醉，入门犹记露菖蒲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6389,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉吟三首 其一","author":"陆游","text":"少日沉迷汗简青，如今毁誉两冥冥。\n书生弄笔如何信，只合花前醉不醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6390,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉吟三首 其三","author":"陆游","text":"牵经引礼人谁听，是古非今世共憎。\n何似对花倾绿酒，自歌一曲醉腾腾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6391,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉吟三首 其二","author":"陆游","text":"驱使难凭赤丁子，传呼底用苍头儿。\n世间如梦身如寄，春去花空欲泥谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6392,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉歌二首 其二","author":"陆游","text":"百骑河滩猎盛秋，至今血渍短貂裘。\n谁知老卧江湖上，犹枕当年虎髑髅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6393,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉舞","author":"陆游","text":"渭城朝雨不须歌，烂醉江头舞短蓑。\n自是先生眼根钝，天狐伎俩本无多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6394,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题三茆邵道士云隐二首 其一","author":"陆游","text":"兴尽当年句曲秋，却归罨画弄扁舟。\n有时信脚来沙际，拾得残云补破裘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6395,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题三茆邵道士云隐二首 其二","author":"陆游","text":"尚嫌勾漏养丹砂，况种刘郎去后花。\n罨画溪头云万顷，不知何处是君家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6396,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题王仲信画水石横幅","author":"陆游","text":"王郎书逼杨风子，画亦凭陵蜀两孙。\n岂是天公憎绝艺，一生憔悴向衡门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6397,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题四仙像四首 其三 张果","author":"陆游","text":"曾看四岳荐虞鳏，阅岁三千一瞬间。\n归卧青山孤绝处，白驴常伴白云闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6398,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题四仙像四首 其一 梅福","author":"陆游","text":"反虏鲸鲵世共雠，汉公勋业过伊周。\n市门洒泪尘埃里，谁与朝廷植委裘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6399,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题四仙像四首 其二 蓟子训","author":"陆游","text":"世上年光东逝波，咸阳铜狄几摩挲。\n神仙不死成何事，只向秋风感慨多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6400,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题四仙像四首 其四 陈抟","author":"陆游","text":"莲花峰下张超谷，此老何曾有死生。\n闻道清风明月夜，至今鼻息乱松声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6401,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题传神","author":"陆游","text":"湿云生两屦，细雨暗孤篷。\n悔不桐江上，从初作钓翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6402,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题庐陵萧彦毓秀才诗卷后二首 其二","author":"陆游","text":"法不孤生自古同，痴人乃欲镂虚空。\n君诗妙处吾能识，正在山程水驿中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6403,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题庐陵萧彦毓秀才诗卷后二首 其一","author":"陆游","text":"诗句雄豪易取名，尔来闲澹独萧卿。\n苏州死后风流绝，几许工夫学得成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6404,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题张几仲所藏醉道士图二首 其二","author":"陆游","text":"卧听床头压酒声，起行篱下摘新橙。\n一尊久欠敲门客，风味何人似曲生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6405,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题张几仲所藏醉道士图二首 其一","author":"陆游","text":"千载风流贺季真，画图髣髴见精神。\n迩来祭酒皆巫祝，眼底难逢此辈人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6406,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题张野夫监簿大招图","author":"陆游","text":"此生只合老渔樵，扶病谁令趁早朝。\n开卷未终三太息，羁魂零落恐难招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6407,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题陈伯予主簿所藏秦少游像","author":"陆游","text":"晚生常恨不从公，忽拜英姿绘画中。\n妄欲步趋端有意，我名公字正相同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6408,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题拓本姜楚公鹰二首 其二","author":"陆游","text":"弓面霜寒斗力增，坐思铁马蹴河冰。\n海东俊鹘何由得，空看绵州旧画鹰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6409,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题拓本姜楚公鹰二首 其一","author":"陆游","text":"忆昔呼鹰塞草枯，妖狐狡兔笑谈无。\n明窗见画空三叹，恍若霜郊遇猎徒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6410,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题画薄荷扇二首 其二","author":"陆游","text":"一枝香草出幽丛，双蝶飞飞戏晚风。\n莫恨村居相识晚，知名元向楚辞中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6411,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题画薄荷扇二首 其一","author":"陆游","text":"薄荷花开蝶翅翻，风枝露叶弄秋妍。\n自怜不及狸奴黠，烂醉篱边不用钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6412,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题直舍壁","author":"陆游","text":"文书那得废哦诗，羞作群儿了事痴。\n付与后人评此老，一丘一壑过元规。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6413,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题驿壁","author":"陆游","text":"轮囷古柳驿门前，籴米归迟突未烟。\n随计入都今四纪，驴寒仆瘦只依然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6414,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题城侍者岘山图","author":"陆游","text":"汉水沉碑安在哉，千年岘首独崔嵬。\n平生不作羊公计，但欲无名死草莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6415,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]