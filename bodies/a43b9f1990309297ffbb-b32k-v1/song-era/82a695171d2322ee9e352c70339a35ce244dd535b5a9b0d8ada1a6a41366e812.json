[{"title":"乡举鹿鸣劝驾","author":"吴潜","text":"上苑春光已探来，诸公逸驾莫迟回。\n点头定有文惊坐，烧尾何妨酒吸杯。\n自是功名难躲避，须知气节要壅培。\n老夫亲手传衣钵，来岁图经用再开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45235,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小至三诗呈景回制干并简同官 其二","author":"吴潜","text":"莫嫌一点稚阳微，化育工夫自此推。\n履袜已无亲可献，黍羔犹与俗相宜。\n数千里外萦心事，四五更头攲枕时。\n恳恳对天香一炷，定知人愿必天随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45236,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小至三诗呈景回制干并简同官 其一","author":"吴潜","text":"六十三馀七十翁，颇从静里得些工。\n阴阳理向尘尘见，天地心于物物同。\n荔挺生来元不死，葭灰塞处自能通。\n古今宇宙浑如此，康节何烦企下风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45237,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小至三诗呈景回制干并简同官 其三","author":"吴潜","text":"劝君莫望楚云飞，一片云飞两泪垂。\n去岁尚传鸿雁信，今年空念鹡鸰诗。\n大刀折处心尤苦，半臂添来体更羸。\n鼓笛谩将厅事聒，谁知里面有人悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45238,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中秋无月和曾仪吉制干","author":"吴潜","text":"见说琼楼忒煞寒，云衣特地护霄端。\n也应齿发十分老，自是嫦娥一笑难。\n此夜不妨留客醉，明年未卜共谁看。\n归与丘壑无穷趣，何惜相从乐且盘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45239,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五用出郊韵三首 其三","author":"吴潜","text":"冥鸿本拟与鸡连，一笑西风沆瀣前。\n放步退来元有地，从头算去莫非天。\n可怜高举抟风翮，争似低飞饮露蝉。\n若使危机能彻底，盈虚消息岂其然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45240,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五用出郊韵三首 其二","author":"吴潜","text":"看他南亩十分收，归去来兮事尚悠。\n梦里便寻青栎社，生来几过白蘋洲。\n向前七帙无多岁，更后三朝即半秋。\n如电如阴如幻境，还知生熟路头不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45241,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五用出郊韵三首 其一","author":"吴潜","text":"寄语头衔水利官，堤防莫作等闲看。\n田畴虽幸收成早，沟浍犹疑灌溉残。\n劝课农桑心独苦，丁宁父老吻应乾。\n米从布袋痴儿事，我辈须知稼穑难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45242,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五用喜雨韵三首 其三","author":"吴潜","text":"家家穫稻积如岑，不问山椒与谷阴。\n沽去村醪醽醁味，吹来陇笛筦弦音。\n餔儿喜笑迎郎罢，馌妇欢欣就藁砧。\n雨玉雨珠无此景，须知造物用情深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45243,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五用喜雨韵三首 其二","author":"吴潜","text":"痴风盲雨骤难禁，撼壁掀窗夜向沈。\n百种已灰当世念，一团都是故乡心。\n伏鴽扑堕床头幔，饥鼠衔翻镜上簪。\n闲打无为坐空寂，谯楼五鼓已侵寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45244,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五用喜雨韵三首 其一","author":"吴潜","text":"暗云泼雨土生香，不假琮黄与璧苍。\n天道从来关感应，人閒此际换炎凉。\n青灯可近聊凭案，缃帙堪翻谩启箱。\n窗外候虫声更急，坐看斜月照堂皇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45245,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"六用喜雨韵三首 其三","author":"吴潜","text":"云霾几日障危岑，户牖绸缪要背阴。\n又是撩空孤雁唳，那堪穴壁乱蛩音。\n潘郎寂寞嗟轻箑，楚女凄凉起断砧。\n大抵人生嫌老大，一回秋思一回深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45246,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"六用喜雨韵三首 其二","author":"吴潜","text":"毋烦符祝不祥禁，并遣商羊旱魃沈。\n自诡何关太守力，谁知最切老婆心。\n苦身见说汤诛发，沾体曾闻禹堕簪。\n乾溢两无年大有，君王德泽海千寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45247,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"六用喜雨韵三首 其一","author":"吴潜","text":"午窗随分理残香，扫地关门付小苍。\n连夜月无昨夜色，今朝雨有几朝凉。\n白头凝望家千里，黄耳寄归书一箱。\n遍问西畴全熟否，还乡百口免忧皇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45248,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"六用喜雪韵二首 其二","author":"吴潜","text":"梵宫楼阁正横虚，俯瞰平畴一幅书。\n宿鸟投林迷所自，野獾寻穴失其初。\n茅柴熟处功非细，榾柮烧来计未疏。\n回首少年观校猎，忽飞一骑射山狙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45249,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"六用喜雪韵二首 其一","author":"吴潜","text":"白战从来号令难，不知此令孰抽端。\n开仓自有齐相国，排户何烦汉县官。\n坐觉阎浮尘世隔，便同佛度化成看。\n遥思苏武囚深窖，气力虽微志自胖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45250,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水云乡和制机刘自昭韵三首 其三","author":"吴潜","text":"水高只合汎归舟，老大何须说壮猷。\n乐事尚堪葵麦候，丰年已兆黍禾秋。\n西曹久负平平考，东郡今称上上州。\n不待子规相劝督，衰翁何止四宜休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45251,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水云乡和制机刘自昭韵三首 其二","author":"吴潜","text":"问君身世欲如何，付与渔翁欸乃歌。\n未酩酊时须酩酊，得磨驼处且磨驼。\n声名草木知谁是，功业旂常在古多。\n百尺危楼聊吊往，薰风首夏正清和。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45252,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水云乡和制机刘自昭韵三首 其一","author":"吴潜","text":"不禁归梦五更长，出见宽闲若故乡。\n天外惨舒云黑白，陇头大小麦青黄。\n水虽四泽无芦苇，地不多山少柘桑。\n却有一般堪爱赏，虬髯老桧郁苍苍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45253,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出郊用劭农韵三首 其三","author":"吴潜","text":"怕见书空雁字连，可堪清泪落尊前。\n谩因上浣休闲日，出见初秋瑩净天。\n人正慕膻争似蚁，谁能换骨蜕如蝉。\n细思回客吾徒尔，而我何为独不然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45254,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出郊用劭农韵三首 其二","author":"吴潜","text":"水光山色尽兜收，老子穿林兴尚悠。\n眼底有诗皆锦野，心头无事即瀛洲。\n鴳鸠岂较物和我，蟪蛄何知春与秋。\n所谓人生行乐耳，如斯逝者可追不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45255,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出郊用劭农韵三首 其一","author":"吴潜","text":"连樯载米去输官，只得将为乐土看。\n饷互豚蹄秋愿了，饱均鸡犬午舂残。\n门前扫刮犁锄净，屋上铺添槁秸乾。\n识字田夫充长吏，了知图易在思难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45256,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出郊再用韵赋三解 其二","author":"吴潜","text":"山朋水友讯频收，怪我明农事转悠。\n南墅麋猿专一壑，东溪凫鹜据三洲。\n人閒颠倒舟移夜，客里凄凉坐阅秋。\n六十馀翁何所恋，金鸡赦了可归不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45257,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出郊再用韵赋三解 其四","author":"吴潜","text":"平生惯作牧民官，不作朱幡画戟看。\n惟有寸心存恻隐，谁怜只手补创残。\n树蔬人要畦畦润，种麦农便陇陇乾。\n乍雨乍晴都恰好，老天谁道叫呼难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45258,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出郊再用韵赋三解 其一","author":"吴潜","text":"此时尉候迭专官，木落郊空最好看。\n海桧不为时节改，岩花未觉色香残。\n明堂柱下捐樗散，清庙笾中荐豆乾。\n天地无私能物物，飞蚊终是负山难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45259,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出郊再用韵赋三解 其七","author":"吴潜","text":"老大头皮捉出官，转头重九又看看。\n莫愁客里黄花负，只恐尊前白日残。\n喜得赐封天燧息，愿他入塞帝巴乾。\n丰年喜色眉尖上，一笑相携肯作难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45260,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出郊再用韵赋三解 其八","author":"吴潜","text":"午香一缕篆烟收，攲枕方床此景悠。\n便觉梦寻桃叶渡，不知身在菊花洲。\n簿书堆里挨排日，砧杵声中断送秋。\n坏户蛰虫犹识候，人生知觉似渠不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45261,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出郊再用韵赋三解 其九","author":"吴潜","text":"窗草池莲乐意连，一帆直到太虚前。\n拈来瓦砾无非道，触处鸢鱼共此天。\n鹑固珍羞元是鼠，蜣虽秽物却为蝉。\n神奇臭腐相更禅，妙理谁知所以然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45262,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出郊再用韵赋三解 其六","author":"吴潜","text":"水聚山环旺气连，荣华富贵各搀前。\n劫从无始认为我，数到有终还是天。\n晓月园林空唳鹤，晚风亭树谩鸣蝉。\n寄言世上耽迷者，所美当知非美然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45263,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出郊偶赋","author":"吴潜","text":"聊驱小队出郊圻，天遣凉风却午曦。\n雨脚似披千疋练，山容如障数层帷。\n并岸低畴苗颔长，近坡高陇稻头垂。\n因他景物思吾土，还是黄鸡白酒时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45264,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"古剑","author":"吴潜","text":"何年神物为堙幽，时见虹光射斗牛。\n出匣试来霜刃暗，倚天立处土花浮。\n鸊膏新淬冰泉洁，锦带横悬鬼魅愁。\n不是张华能博物，黄尘满眼欲何求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45265,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"四五用喜雪韵四首 其四","author":"吴潜","text":"覆盖无分实与虚，太平有象史官书。\n园林底用誇末至，山水惟应访遂初。\n润到青蔬尤脆美，老添苍桧更扶疏。\n是中广莫天同大，□□何妨有傲狙。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45266,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"四五用喜雪韵四首 其三","author":"吴潜","text":"战退妖狐是不难，飞毛散羽息争端。\n瓮眠但愿为逋客，靴没何须慕大官。\n化化形形随物付，平平坦坦与人看。\n闭门独有袁夫子，穷饿难磨气象胖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45267,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"四五用喜雪韵四首 其二","author":"吴潜","text":"富贵家家遣五虚，不须乞米效颜书。\n垢除与物重更始，朴散于今暂复初。\n狡兔迷藏罝谩设，游鱼潜伏网应疏。\n此恩个个当沾被，莫逐林閒窃芋狙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45268,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"四五用喜雪韵四首 其一","author":"吴潜","text":"不数玄真与木难，也休剪綵缀林端。\n五车自有神朝阙，万宝非因贾送官。\n老大已残洄曲梦，推敲且作灞陵看。\n忍寒袖手青灯畔，解字闲书胖与胖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45269,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"四用出郊韵三首 其三","author":"吴潜","text":"一望平湖万顷连，恍如身在鹫峰前。\n筑涂成宅能移地，叠石为山欲夺天。\n绿萼枝方停晓凤，白杨树已咽寒蝉。\n达人大观缘如此，万事都来付且然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45270,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"四用出郊韵三首 其二","author":"吴潜","text":"四望青山宿雾收，白鸥浩荡意悠悠。\n红旗不用穿三市，画舸何妨访十洲。\n台榭装成多样景，水云占却几分秋。\n洛阳耆旧名园记，般入明州志可不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45271,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"四用出郊韵三首 其一","author":"吴潜","text":"惭愧曾尸一品官，如今已作倒盆看。\n但干驰逐心都歇，只有登临兴未残。\n欲扫云烟忧笔秃，拟浇尘土怕壶乾。\n傍人莫把衰翁笑，追趁跻攀尚不难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45272,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"四用喜雨韵三首 其三","author":"吴潜","text":"北岑飞雨过南岑，远嶂晴明近嶂阴。\n老桧婆娑方午色，孤桐摇落忽秋音。\n庭稀雁鹜飞符檄，海绝鲸鲵伏斧砧。\n此是老臣聊报国，仁声敢谓入人深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45273,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"四用喜雨韵三首 其二","author":"吴潜","text":"背人岁月苦难禁，乌兔相追互起沈。\n点检平生如梦事，保全晚节是真心。\n围腰减削那胜带，种发萧疏不上簪。\n久悟盈虚消息理，香山莲社拟追寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45274,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"四用喜雨韵三首 其一","author":"吴潜","text":"园林过雨宿荷香，犹挂轻綀佩水苍。\n老去只应休去好，秋来方是晚来凉。\n倦翎网已离三面，病颡车难服两箱。\n多幸时和岁丰美，只将心念报虚皇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45275,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宁川道中","author":"吴潜","text":"十日为山客，今朝问水程。\n沙横疑港断，滩迅觉舟轻。\n远近村舂合，高低渔火明。\n回头忽苍莽，一望一关情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45276,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"平山堂","author":"吴潜","text":"尽日西风捲地狂，只堪吹雁过潇湘。\n黄沙万里暮天远，白水一杯秋井香。\n杨柳年年人老大，江山处处客凄凉。\n朅来无限兴亡事，泪落淮南古战场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45277,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再用出郊韵三首 其一","author":"吴潜","text":"父老休惊作长官，只将田畯一般看。\n汝应西墅功将毕，我亦南柯梦向残。\n夕照拖云枫影乱，秋风扫地叶声乾。\n瀛仙岛客知何处，策杖相从正不难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45278,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再用出郊韵三首 其三","author":"吴潜","text":"屈曲蜂房蚁户连，秦筝羯鼓绿窗前。\n尽教迫窄无馀地，谁道虚空有剩天。\n是处画堂馀燕雀，几家高屋画貂蝉。\n闲阶细草蛩声急，极目烟波正渺然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45279,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再用出郊韵似延庆老三首 其三","author":"吴潜","text":"普殊难叶一钩连，勘到释迦文佛前。\n口里巴巴缘十地，眼中盼盼是诸天。\n泥涂烂处藏头鳖，高树梢头脱壳蝉。\n各自身躯各自性，谁知各自本同然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45280,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再用出郊韵似延庆老三首 其二","author":"吴潜","text":"工夫全在放时收，鹞过新罗路太悠。\n世网爱河千渤泡，人寰苦海一浮洲。\n要知坐卧并行住，只在春冬与夏秋。\n昨日亭前柏树子，分明说法听闻不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45281,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再用出郊韵似延庆老三首 其一","author":"吴潜","text":"菩提只在摄心官，日观元同月观看。\n万种因缘都是结，一花根蒂几曾残。\n祖师曾誓疮脓坏，讲主能参屎橛乾。\n百硕麻油摊树上，得来元不见难难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45282,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再用前韵二首 其二","author":"吴潜","text":"中夜怀归梦趁虚，柰无黄耳寄家书。\n高人不问闭门后，征士应思遣戍初。\n压栋排檐能拉朽，穿帘入隙解乘疏。\n遥知山谷皆封路，食绝肠饥有怒狙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45283,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再用前韵二首 其二","author":"吴潜","text":"不假焦仙把酒喷，须臾澍雨若翻盆。\n官应可了劭农事，天岂终悭及物恩。\n无复绝粮忧鲁叟，何须进食念王孙。\n只愁撩得秋声动，老客他乡易断魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45284,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再用前韵二首 其一","author":"吴潜","text":"剪水工夫入细难，筛尘屑末粲豪端。\n司寒便合修年谱，凌室何妨践世官。\n惠可立时师受记，焦先卧处众争看。\n只缘一窍丹成熟，四体那拘瘠与胖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45285,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再用前韵二首 其一","author":"吴潜","text":"行雨龙公屡易方，魃妖谁敢扇馀殃。\n田畴接得三年熟，枕簟供来几夜凉。\n更喜征夫无减灶，定应行旅不赍粮。\n寄声鄞土黄承事，有粟何须更窖藏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45286,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再用前韵各赋三解 其六","author":"吴潜","text":"床头酒熟气烝喷，嘉饭何妨置瓦盆。\n醉饱不知身世事，思量难报后皇恩。\n垂髫牧子行牵父，戴白山翁坐拥孙。\n却笑东征西讨客，龙堆万里欲飞魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45287,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再用前韵各赋三解 其三","author":"吴潜","text":"密云能雨自西方，不假巫■解息殃。\n地产固应滋物产，天凉那更挟心凉。\n未忧悬釜供苏爨，何事量沙作糗粮。\n临得颜公乞米帖，从今岁岁只珍藏。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45288,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再用前韵各赋三解 其四","author":"吴潜","text":"赤米炊香两鼻喷，白盐不用置牢盆。\n家家已了收藏计，物物何知造化恩。\n衣褐宽来姑唤妇，垣墉补处祖将孙。\n江乡此际鸡豚社，俚舞村歌入梦魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45289,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再用前韵各赋三解 其五","author":"吴潜","text":"先生粗有辟邪方，不怕鱄鱼解降殃。\n今雨收功真溥博，早秋得势已凄凉。\n豳场栗栗方登谷，汉甬陈陈可峙粮。\n此是边筹居第一，贾生表饵且韬藏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45290,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再用前韵各赋三解 其一","author":"吴潜","text":"九天膏泽沛群方，尽扫螟蝗蝥?殃。\n即刻焦烦成爽垲，何时繁富换荒凉。\n涤场定是多遗秉，栖亩爰知有剩粮。\n却笑荜门穷措大，瓶罂脱粟正深藏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45291,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再用前韵各赋三解 其二","author":"吴潜","text":"神虬捲水向空喷，沟浍充盈到盎盆。\n天上只消些少力，人閒知受几多恩。\n江沱乐意鱼夫妇，淇澳生涯龙子孙。\n无限槁枯皆被泽，阿香一击尚惊魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45292,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再用喜雨韵三首 其三","author":"吴潜","text":"雨脚如奔冒远岑，须臾六合变层阴。\n坐回物物昭苏意，想见村村喜笑音。\n翁诧稻粱营米栈，妇思裘褐拂衣砧。\n定知一熟酬诸愿，击壤歌中此感深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45293,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再用喜雨韵三首 其二","author":"吴潜","text":"热恼烦蒸正不禁，火轮忽向半空沈。\n屯中信有云雷象，复处方知天地心。\n便拟新秋先上印，何须晚岁始投簪。\n江山信美非吾土，栗里时从蝶梦寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45294,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再用喜雨韵三首 其一","author":"吴潜","text":"古说云香雨亦香，天工岂是色苍苍。\n寸瓢假手何烦靖，斗酒开眉不换凉。\n?■已欣登杵臼，绤絺渐可纳巾箱。\n拟赓周雅鱼丽什，堆案文书未暇皇。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45295,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再赋喜雪二首 其二","author":"吴潜","text":"夜深如水泼衣衾，晓看皑皑冒碧岑。\n以洁藏污窥物理，由仁行义见天心。\n但教南亩多呈瑞，何必东夷屡献琛。\n麦熟吾时归印绶，不能者止念周任。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45296,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再赋喜雪二首 其一","author":"吴潜","text":"黑风剪水作瑰琦，散落人閒贱似泥。\n万象直教还朴素，千岐何幸尽平夷。\n征人奔路昏投店，戍士乘城夜守陴。\n不识艰难惟党二，销金帐底饮羔儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45297,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]