[{"title":"丞相王公挽词 其二","author":"喻良能","text":"维岳钟英粹，兴王有俊良。\n文章周卫武，书考郭汾阳。\n调燮民庸茂，弥缝主道昌。\n中台一宵坼，四海泪滂滂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75043,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丞相王公挽词 其三","author":"喻良能","text":"畴昔翘材馆，疏庸获屡游。\n衮衣无傲色，吐握有勤求。\n辅弼十年久，雍容片善收。\n至今天下士，语及泪交流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75044,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"买舟至九里松游三天竺","author":"喻良能","text":"解维凌皱玉，辍棹理孤筇。\n游遍三天竺，行穷九里松。\n泉声依石细，山色共秋浓。\n佳处吾能识，幽岩倚秀峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75045,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"亦好园江梅变红仲文季直二弟有诗因次韵","author":"喻良能","text":"萧萧亦好耐寒枝，天与风流一段奇。\n刻玉不惟工傲雪，施朱端欲妙凝脂。\n佳人赪颊今才见，公子酡颜顷未知。\n便好作轩名顿有，二难连璧赋清诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75046,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"亦好园即事","author":"喻良能","text":"谁将春色到山家，湖绿平堤草满沙。\n细刻真酥水仙蕊，匀搓绛蜡海红花。\n芳林得日莺还啭，香径无风蝶自斜。\n聊与后生修故事，未妨诗酒作生涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75047,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"亦好园春晚再用前韵","author":"喻良能","text":"境净山明别一家，几多垂柳袅平沙。\n閒中牵梦一池草，空里愁人万点花。\n细雨朝朝兼暮暮，淡烟整整复斜斜。\n绿阴青子真堪画，满意春风磬水涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75048,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"亦好园海棠秋开红英满树","author":"喻良能","text":"微云澹日映寒流，画出西园一幅秋。\n白帝幻成红玉蕊，金风吹绽碧枝头。\n睡馀艳艳真妃子，梦罢愔愔一解愁。\n熟赏细看须著句，为君重赋紫绵揉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75049,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"亦好园梅花","author":"喻良能","text":"一别经年见未曾，冲寒相值意凌兢。\n肌肤姑射仙人雪，品格中山孺子冰。\n清浅池塘春未动，黄昏篱落月初棱。\n从来自倚心如铁，被恼如今似少陵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75050,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再用前韵","author":"喻良能","text":"晚驱羸马背重城，晓度层峦淡月明。\n醉与别愁相唤醒，秋兼诗思一齐清。\n舞风繁蓼堤边影，泣露寒蛩草际声。\n欲驻征鞍聊小憩，敢将王事徇私情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75051,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再用前韵呈参议李郎中","author":"喻良能","text":"独冷官曹有底忙，经旬不得造门墙。\n雨添垂柳丝丝碧，风搅飞花片片香。\n顾我摧颓如病颡，羡公腾踏胜飞黄。\n新诗迥出南丰右，不是无香似海棠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75052,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再用彝公长老韵赠嗣宗教授","author":"喻良能","text":"居易青衫旧，安仁素发新。\n愁思中酒圣，贫忍论钱神。\n白也诗谁敌，潮乎笔更亲。\n生辰宿南斗，同是数奇人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75053,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同德坊寓居","author":"喻良能","text":"天地方摇落，江湖入梦思。\n三为京辇客，十见岁华移。\n亹亹金闺直，萧萧素发垂。\n残年饱吃饭，细诵少陵诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75054,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"安抚大资李参政生辰 其一","author":"喻良能","text":"仙李盘根几百秋，我公勋业比伊周。\n推恩已解宏元化，戢患犹能庇七州。\n不日定为黄閤老，他年应伴赤松游。\n三江愿得浑为酒，寿斝年年给献酬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75055,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"安抚大资李参政生辰 其二","author":"喻良能","text":"崧岳生申占腊前，预将和气作春妍。\n蟠桃结实三千岁，莲叶成巢几百年。\n聊向蓬莱开燕寝，即纡衮绣画凌烟。\n只应便是神仙事，方丈瀛洲却未然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75056,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"州宅","author":"喻良能","text":"古栝提封接日畿，专城皓首有光辉。\n全家饱煖君恩重，属邑丰登公事稀。\n一簇楼台居洞府，四时风景对屏帏。\n多惭郎省无裨补，丐外犹能占翠微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75057,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏綵堂有作","author":"喻良能","text":"捧檄及偏亲，斑衣聊效颦。\n旨甘贫有味，温凊静无尘。\n北户足萱草，南风宜棘薪。\n版舆多喜色，庶不愧安仁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75058,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"有感二首 其二","author":"喻良能","text":"再有淮南乱，纷纷几战场。\n血腥官道雨，骨映野田霜。\n行阵青黄气，朝廷赤白囊。\n何时洗兵甲，四海重耕桑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75059,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"有感二首 其一","author":"喻良能","text":"冉冉新华发，飕飕敝黑裘。\n一官方半剌，六十已平头。\n稠叠耶溪泛，崎岖禹穴游。\n未能江海去，聊作稻粱谋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75060,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次马抚干韵赠黄泰之状元","author":"喻良能","text":"袖然射策向明光，紫禁春深日正长。\n风细御炉烟冉冉，天晴宫柳絮茫茫。\n玉阶亲奉唐虞问，綵笔浓薰班马香。\n千佛经中名第一，鸿文端不数长杨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75061,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次陆务观韵题姚复之秀才适斋","author":"喻良能","text":"姚子神情处处便，床头周易杖头钱。\n逢僧与语閒终日，遣客归休醉欲眠。\n应觉此生如寄耳，何妨一室且萧然。\n无心更觅封侯事，纳履谁能博一编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75062,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵卫知机秀才梅花","author":"喻良能","text":"东君调护亦多情，瘦比夷齐彻骨清。\n有韵绿毛时倒挂，无尘白鹭可同盟。\n未应桃叶能称姊，若齿山樊定是兄。\n何事故园频入梦，疏枝新赏玉溪晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75063,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵马叔度再用前韵见寄","author":"喻良能","text":"善弈从来数弈秋，胜游今作子长游。\n才多已觉悬河似，诗妙无劳入海求。\n画月裁云宁底巧，奔泉抉石一何遒。\n谁知倾盖成胶漆，笑杀如新到白头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75064,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵木蕴之状元义乌道中一首","author":"喻良能","text":"奔走尘埃老未休，每思上下两岩稠。\n关心簿领三书考，回首家山两换秋。\n支腹自怜鹪鼹小，江湖谁计雁凫留。\n又遮西日长安去，惭愧平生马少游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75065,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵木蕴之状元见寄之作","author":"喻良能","text":"水绕星山木绕庐，江城孤绝政愁予。\n鸟言为吏居篁竹，乌鬼得鱼欢里闾。\n照眼梅花寒皎皎，关心烟雨晚疏疏。\n真山多谢遥相忆，长句新诗细字书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75066,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵王龟龄春日湖上","author":"喻良能","text":"春老花茵积，云开天镜磨。\n暖风今日好，细雨向来多。\n柳荫青丝障，湖明金叵罗。\n何时成醉倒，烟草藉晴坡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75067,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵王龟龄谒大禹祠酌菲饮泉","author":"喻良能","text":"不到稽山已十年，梦中物色故依然。\n忆寻绝境经幽寺，曾向东风酌妙泉。\n书穴雨馀云扑地，鉴湖春昼水连天。\n别来乔木高多少，想见娇莺自在迁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75068,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵王侍御夜宿高牙","author":"喻良能","text":"相别三时久，相望万里赊。\n携书期过雁，徙倚至昏鸦。\n风雨番君国，云烟夔子家。\n何时趣归觐，重许拜高牙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75069,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵王侍御题诗史堂","author":"喻良能","text":"欲识当年泣鬼神，诗皆绢妇与齑辛。\n洗空千古无凡马，称到于今有几人。\n肯与齐梁充后乘，只应苏李是前身。\n丰碑更著最佳处，传示宜过一万春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75070,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵王宫教见贻之什","author":"喻良能","text":"家住涛江东复东，渺然云浪接晴空。\n半生仕路崎岖里，十亩家山杳霭中。\n来往未成三径乐，笑谈还喜一樽同。\n强将俚语赓妍倡，曹郐端惭齿卫风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75071,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵王待制刘侍郎倡和","author":"喻良能","text":"衮衣犹未趣东归，吴会先传蜀道诗。\n急峡高江追子美，清风明月笑严维。\n花围白帝行春日，香蔼黄堂坐啸时。\n顾我迂疏堪底用，强颜薪粟效支离。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75072,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵叶省干重九楼上言怀","author":"喻良能","text":"水落鱼龙已退藏，小楼萧爽裌衣凉。\n山云雨过无穷态，岩桂风来不断香。\n已分文章成白豕，拟将富贵等黄粱。\n嵇康潦倒浑无取，岂复眉开一点黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75073,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵外舅黄虞卿为爱山园好八首 其八","author":"喻良能","text":"为爱山园好，红尘半点无。\n自应成小隐，谁复叹将芜。\n香秫五十亩，黄柑二百株。\n何必随俯仰，归去亦良图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75074,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵外舅黄虞卿为爱山园好八首 其七","author":"喻良能","text":"为爱山园好，林塘十亩宽。\n露深花脸湿，春浅柳眉攒。\n只拟希高隐，那能缚小官。\n寿山谁问讯，太白正虬蟠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75075,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵外舅黄虞卿为爱山园好八首 其六","author":"喻良能","text":"为爱山园好，投閒日日来。\n花时长夜饮，雪后煖寒杯。\n一径松篁影，满畦桑柘栽。\n未能湖海去，幽兴亦悠哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75076,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵外舅黄虞卿为爱山园好八首 其五","author":"喻良能","text":"为爱山园好，萧斋竹径通。\n疏帘捲雌霓，曲槛倚雄风。\n爱酒杜陵老，煎茶桑苧翁。\n菟裘真得计，踪迹免飘蓬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75077,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵外舅黄虞卿为爱山园好八首 其四","author":"喻良能","text":"为爱山园好，都无尘世喧。\n穗禾临芰沼，绳草对苔垣。\n去就随佳酝，穷通付寓言。\n还同李长吉，来过有高轩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75078,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵外舅黄虞卿为爱山园好八首 其三","author":"喻良能","text":"为爱山园好，年年草色新。\n醉眠攲柳幄，吟坐俯苔茵。\n栗里风烟古，樊川花木春。\n谁云无伴侣，对影共三人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75079,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵外舅黄虞卿为爱山园好八首 其二","author":"喻良能","text":"为爱山园好，芳篱占一涯。\n自耘三径草，不断四时花。\n柳絮风中雪，芙蓉水上霞。\n银潢何处是，不拟问仙槎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75080,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵外舅黄虞卿为爱山园好八首 其一","author":"喻良能","text":"为爱山园好，芒鞋步步高。\n绿针挦露韭，碧箸剪春蒿。\n但得林泉趣，谁能州县劳。\n何惭王孝伯，痛饮读离骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75081,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵刘淳叟见寄二首 其二","author":"喻良能","text":"出处双青鬓，生涯一钓舟。\n浅深山远近，浓淡树稀稠。\n隐几昼逾静，捲帘春更幽。\n何当乘兴去，舣棹向汀洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75082,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵刘淳叟见寄二首 其一","author":"喻良能","text":"九万垂云翼，胡为乃倦飞。\n丘园聊偃息，岩阜故因依。\n蝶栩新酣睡，鸥驯久息机。\n祇应与风景，相赏莫相违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75083,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵宇文舍人见贻之作","author":"喻良能","text":"不见褚公今二年，重来青眼尚依然。\n偃松篇美天犹和，正殿班清人孰先。\n今日赤墀烦暂立，他年黄阁径须迁。\n白头宾客无聊甚，只待吹嘘送上天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75084,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵戏綵老人重阳怀故园作","author":"喻良能","text":"潇洒秋容雨后天，丹青端似倩龙眠。\n故园绿竹应今日，异县黄花又一年。\n微禄祇堪供菽水，菲材安敢拟渊骞。\n日来王事欣多暇，聊向樽前一粲然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75085,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵伯寿兄中秋玩月","author":"喻良能","text":"中秋自古月华好，何况浮云扫碧天。\n不比寻常三五夕，须知潋滟十分圆。\n画檐影转犹宜饮，银汉辉斜未忍眠。\n却忆年时今夜里，独将醒眼对婵娟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75086,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵伯寿兄见寄","author":"喻良能","text":"江国疏梅吐玉英，故园想见木欣荣。\n二年鸿雁碧云阔，千里江湖春水生。\n冉冉池塘应入梦，潇潇风雨若为情。\n行看戏綵青萱发，准拟芳樽相对倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75087,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵伯寿兄秋日偶题","author":"喻良能","text":"渐老良多感，悲秋强自宽。\n鬓惊潘掾白，衣怯范生寒。\n径合荒苔碧，窗明落叶丹。\n浇愁须暂醉，忍放酒杯乾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75088,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵伯寿兄宿华藏有感","author":"喻良能","text":"水净溪空峰更青，目虽未到已先明。\n栋浮万缕晴云细，轩拥千重夏木清。\n幽兴入门应自适，残樽下马与谁倾。\n老僧斋罢唯须睡，不信人间有月评。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75089,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵何茂恭永新见寄之什 其一","author":"喻良能","text":"起家从吏役，宁为食无鱼。\n游乐废山泽，怀归畏简书。\n文章簿领外，风采折腰馀。\n卧辙从兹始，为谋未觉疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75090,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵何茂恭重阳前二日见过","author":"喻良能","text":"西风篱落兴悠然，秋影横江雁贴天。\n短发未成吹帽饮，高吟先赠把茱篇。\n黄花一笑小重九，青眼相看又四年。\n欲试烟波钓竿手，南湖同上月明船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75091,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵宋嗣宗梅花 其一","author":"喻良能","text":"野外江头一树垂，正当霜后腊前时。\n清如弘景松临阁，韵似渊明菊映篱。\n铁石广平曾作赋，风流水部亦哦诗。\n却愁折向妆台下，莫遣佳人取次知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75092,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵宋嗣宗梅花 其二","author":"喻良能","text":"洗尽红妆见玉颜，一年相别此时看。\n房陵粉水休争白，姑射冰肌巧耐寒。\n自爱一枝横竹外，未须千树绕江干。\n东风也是相欺得，已作和羹一点酸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75093,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵张持荷桂花","author":"喻良能","text":"别驾风流继竹林，名园幽榭水云深。\n匀铺叶底森森碧，细糁枝头粟粟金。\n酒酌香浮杯面蚁，诗成霜洒月中砧。\n清芬冉冉仍多韵，不比晴窗一穗沉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75094,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵李大著春日杂诗十首 其十","author":"喻良能","text":"二载违枌社，全家客帝都。\n浊醪充上顿，清俸付中厨。\n亲老唯须养，皇恩讵敢孤。\n逍遥处山泽，未忍学仙臞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75095,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵李大著春日杂诗十首 其九","author":"喻良能","text":"素发已垂领，故园犹未归。\n鸟声思磴道，柳色忆荆扉。\n嫩绿枝边暗，残红叶底稀。\n几多新乳燕，一一出巢飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75096,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵李大著春日杂诗十首 其八","author":"喻良能","text":"屯云初解驳，晓日有晶辉。\n城郭红尘软，江湖春水肥。\n小舟浮绿净，芳径步熹微。\n起我故山思，多惭未拂衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75097,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵李大著春日杂诗十首 其七","author":"喻良能","text":"帝里春仍好，风和昼漏迟。\n但怀三釜乐，遑恤北山移。\n老大谙斑戏，空疏愧色丝。\n平生杜陵老，耿耿寸心知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75098,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵李大著春日杂诗十首 其六","author":"喻良能","text":"借居仍种菊，往往似天随。\n日味三春酒，灯明午夜棋。\n閒临永和帖，细诵建安诗。\n潦倒同中散，欢欣似启期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75099,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵李大著春日杂诗十首 其五","author":"喻良能","text":"花日浅明牖，竹风低度墙。\n举头空弱絮，转盼堕危芳。\n兴遣凭毛颖，愁消赖羽觞。\n阴阴繁夏木，故里耿难忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75100,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵李大著春日杂诗十首 其四","author":"喻良能","text":"偏亲须寸禄，匠院敢辞留。\n颇愧花经眼，还应草唤愁。\n身唯亲布被，交已绝牙筹。\n诗兴抽毫足，无劳入海求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75101,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵李大著春日杂诗十首 其三","author":"喻良能","text":"贱子知何幸，莱衣老更斑。\n白头居杜曲，清梦到香山。\n琢句愁雕肾，衔杯喜渥颜。\n此身惭暮翼，飞倦未知还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75102,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵李大著春日杂诗十首 其二","author":"喻良能","text":"漫仕叹迟暮，卜居城北偏。\n已教山白石，祇欠沼清泉。\n帘透一檐月，窗横数尺天。\n杂花还映竹，故故自芳妍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75103,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵李大著春日杂诗十首 其一","author":"喻良能","text":"春晚饶芳景，官閒得细看。\n隔窗黄鸟并，开卷壁鱼乾。\n过雨苍苔湿，迎风翠竹寒。\n发华搔更短，斗酒自相宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75104,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵陈鲁望郎中","author":"喻良能","text":"笔底词华盛，宁论大小山。\n敷腴建安际，古澹贞元间。\n未许窥三昧，时容见一斑。\n草堂诗律在，风味唤仍还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75105,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵侍御晚宿三叉口","author":"喻良能","text":"故里频怀梓，新堤未筑沙。\n文章真吏部，吟咏许刘叉。\n酒盏孤风物，诗筒隔岁华。\n相思江路远，烟雨茁芳葭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75106,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵周希稷咏芭蕉","author":"喻良能","text":"经年不接故人书，开户逢渠了不殊。\n谁运七轮风里扇，时跳千斛雨中珠。\n退之有意吟山石，摩诘无心作画图。\n为爱青青无俗韵，故教移植傍庭隅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75107,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]