[{"title":"北归次盰江疏山宗瑞长老来迓且言山巅有亭俯视群山犹培塿也求佳名大书以榜之取少陵句为目之曰一览亭成两绝句 其一","author":"李纲","text":"居士新从海上回，劳烦竹杖与芒鞋。\n故人何用将迎远，明月清风常往来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10746,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"北归次盰江疏山宗瑞长老来迓且言山巅有亭俯视群山犹培塿也求佳名大书以榜之取少陵句为目之曰一览亭成两绝句 其二","author":"李纲","text":"千里林峦紫翠环，孤亭缥缈白云端。\n登临一览众峰小，始见疏山境界宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10747,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"往返踰万里首尾涉五年幸无惊忧归次贵溪仙岩新罹寇盗焚荡孑然始见兵火之迹感怆有作二首 其一","author":"李纲","text":"梦里幽人独往来，仙岩依旧碧崔嵬。\n伤心二百载涵养，极望皆成瓦砾堆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10748,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"往返踰万里首尾涉五年幸无惊忧归次贵溪仙岩新罹寇盗焚荡孑然始见兵火之迹感怆有作二首 其二","author":"李纲","text":"辽海归来丁令威，山川虽是事多非。\n衣冠南渡奔崩极，始信六朝犹足依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10749,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"靖康丙午冬道江南宿龟峰寺建炎庚戌秋北归再过行遽不果到长老智光见访成三绝句以遗之 其一","author":"李纲","text":"散策曾游瑞相峰，烟霞深处翠成丛。\n清江使者今安否，五换星霜一梦中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10750,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"靖康丙午冬道江南宿龟峰寺建炎庚戌秋北归再过行遽不果到长老智光见访成三绝句以遗之 其二","author":"李纲","text":"去国翻成汗漫游，迢迢云海六鳌愁。\n归来又踏江南土，都在当年拄杖头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10751,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"靖康丙午冬道江南宿龟峰寺建炎庚戌秋北归再过行遽不果到长老智光见访成三绝句以遗之 其三","author":"李纲","text":"兰若松林物外居，羡师一住十年馀。\n奔驰万里心灰冷，借我峰前使结庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10752,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自海外归间关万里经涉五载初抵家与诸季会饮成长句兼简邹德久昆仲","author":"李纲","text":"楚氛未静狼烽起，翠华摇摇无定止。\n谋臣猛将如云屯，坐视胡雏渡江水。\n我归自南时正艰，缭络间关万馀里。\n问津处处皆战场，访旧往往成新鬼。\n伤心不忍顾浙河，故园已在荆棘底。\n幸然家寓大江东，窈窕精庐山谷里。\n当时百口还满前，况复添丁长童稚。\n衣冠南渡多流离，骨肉无虞能有几。\n生还已荷皇天慈，见汝更使清愁洗。\n夜阑秉烛疑梦中，破悲为笑且欢喜。\n在原真赴鹡鸰难，玉树还许蒹葭倚。\n眷言兄弟同友生，风雨鸡鸣未云已。\n闽山深处是吾乡，携幼扶衰又将徙。\n安得庙社固根基，一使寰区尽蒙祉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10753,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"中秋与诸季及德久昆仲望月同饮","author":"李纲","text":"五年客里过中秋，今夕安知无此愁。\n共喜银云开碧落，坐看蟾魄过西楼。\n清光著物殊他夜，好景于人散百忧。\n人月皆圆那易得，莫辞大白十分浮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10754,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送季言弟还锡山省先垄四首 其一","author":"李纲","text":"四年谪去远桑梓，万里归来纷甲兵。\n却恨此身方抱病，扫坟不与汝同行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10755,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送季言弟还锡山省先垄四首 其二","author":"李纲","text":"胡雏南牧浙河空，多幸依然马鬣封。\n劳汝遥传一掬泪，霜前为洒万株松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10756,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送季言弟还锡山省先垄四首 其三","author":"李纲","text":"每忧吴会太繁雄，虏骑凭陵掌股中。\n若到新经兵火地，莫将有限悼无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10757,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送季言弟还锡山省先垄四首 其四","author":"李纲","text":"连年瘴海鬓成丝，多荷君恩特放归。\n邂逅故人相问讯，为言蘧瑗久知非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10758,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"同诸季及邹德久昆仲游龙潭","author":"李纲","text":"避地寓江左，精庐极深幽。\n驾言穷胜赏，遂作龙潭游。\n暑气敛以退，轻云蔼而浮。\n疏林未摇落，山色宜清秋。\n萝磴穿窈窕，松风散飕飗。\n铁花秀石壁，玉韵锵溪流。\n谁将三峡桥，断取来岩陬。\n会心得佳趣，浊酒相献酬。\n嫩菊青可摘，寒蔬郁堪羞。\n乐哉山林间，乃尔远世忧。\n岂知江淮濆，杀气横戈矛。\n幽讨未云已，散策层冈头。\n天绅拖脩瀑，落此万丈湫。\n空濛杳霭中，时有飞鱼游。\n神物不可见，下隐长黄虬。\n百谷正焦枯，胡为此淹留。\n会乘风雷便，一起泽九州。\n我与二三子，于世初无求。\n萧然岩壑姿，正可擅一丘。\n愿言假吾居，聊作潜珍谋。\n玉函畀思邈，贝阙归灵脩。\n何须挟白羽，共逐青绡牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10759,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"九日登山亭会饮","author":"李纲","text":"渊明避世士，酷爱九日名。\n独酌东篱下，悠然得此生。\n我辈正羁旅，佳节安可醒。\n相携陟翠巘，置酒松间亭。\n菊蕊弄新黄，橘苞破微馨。\n鬓边插茱萸，未觉巾帻倾。\n云山蔼佳色，风林动疏声。\n慷慨念平昔，醉舞属群英。\n国步方缀旒，衣冠正漂萍。\n山河举目异，望远若为情。\n方期汗漫游，天池濯吾缨。\n何必楚囚泣，牛山良可轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10760,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"九日示诸季时会饮者八人","author":"李纲","text":"海外频年怀棣萼，江南九日共茱萸。\n莫愁群盗惊邻壤，且作新诗慰老夫。\n坐上岂无吹帽客，饮中况是谪仙徒。\n不将酩酊酬佳节，肯信黄花解笑无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10761,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"冬至后四日脩供罗汉岩因访丹霞本老成四绝句 其一","author":"李纲","text":"道人眼静绝空花，岩壑萧然物外家。\n十载闻名今始到，庞公真是访丹霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10762,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"冬至后四日脩供罗汉岩因访丹霞本老成四绝句 其二","author":"李纲","text":"篮舆清晓叩禅扉，山路云深翠湿衣。\n谁家峰头双练瀑，空濛散作玉花飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10763,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"冬至后四日脩供罗汉岩因访丹霞本老成四绝句 其三","author":"李纲","text":"碧山深处敞层岩，中有幽人默自参。\n休指天云与瓶水，烦师试说后三三。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10764,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"冬至后四日脩供罗汉岩因访丹霞本老成四绝句 其四","author":"李纲","text":"岩峦鼎足缭回廊，泉石幽奇草木香。\n幸有峰前方丈地，可能为筑读书堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10765,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"叶梦授龙图同游丹霞见和四绝句再次前韵 其一","author":"李纲","text":"岩窦嵌空南宝花，玲珑楼阁衲僧家。\n兴来结客穷幽讨，冲破晴山几段霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10766,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"叶梦授龙图同游丹霞见和四绝句再次前韵 其二","author":"李纲","text":"渡水扪萝款石扉，杖藜同著旧缁衣。\n犹嫌林下諠僮仆，欲学孤云野鹤飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10767,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"叶梦授龙图同游丹霞见和四绝句再次前韵 其三","author":"李纲","text":"烟霞绚彩染幽岩，紫翠葱茏云木参。\n幸有幽人共清赏，岂惟风月友成三。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10768,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"叶梦授龙图同游丹霞见和四绝句再次前韵 其四","author":"李纲","text":"夜寒月影照虚廊，境寂心清发妙香。\n藜藿山林有馀乐，未应肉食念华堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10769,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"叶梦授送家园梅花且以绝句十五章见示次其韵 其一","author":"李纲","text":"天欲春光一点回，素英先识化工裁。\n恼人不作铅华态，愿下当年玉镜台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10770,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"叶梦授送家园梅花且以绝句十五章见示次其韵 其二","author":"李纲","text":"道人宴坐得圆通，妙观年来等色空。\n结习已销花不染，何妨镶丽伴衰翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10771,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"叶梦授送家园梅花且以绝句十五章见示次其韵 其三","author":"李纲","text":"枝头数点雪初残，折置冰壶分外寒。\n烟蕊轻盈未全拆，国香暗淡已欺兰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10772,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"叶梦授送家园梅花且以绝句十五章见示次其韵 其四","author":"李纲","text":"慇勤剩作送梅诗，撚断霜髭不为棋。\n只恐苦吟令太瘦，个中风味有谁知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10773,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"叶梦授送家园梅花且以绝句十五章见示次其韵 其五","author":"李纲","text":"傍雨移梅趁小寒，探春几度独凭栏。\n不知冷淡缘何事，偏得幽人带笑看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10774,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"叶梦授送家园梅花且以绝句十五章见示次其韵 其六","author":"李纲","text":"坐来寒谷变阳春，雪里开花若有神。\n多作新诗咏尤物，知君最是爱花人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10775,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"叶梦授送家园梅花且以绝句十五章见示次其韵 其七","author":"李纲","text":"超然标格冠群芳，妙质天教彻骨香。\n烂熳开时何足道，最怜新蕊半涂黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10776,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"叶梦授送家园梅花且以绝句十五章见示次其韵 其八","author":"李纲","text":"疏篱烟雨数枝斜，行路于今五见花。\n又向闽山和月摘，坐令流寓叹年华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10777,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"叶梦授送家园梅花且以绝句十五章见示次其韵 其九","author":"李纲","text":"山路相逢若有情，折来书幌愈轻明。\n何须更道能调鼎，小啄微酸已解醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10778,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"叶梦授送家园梅花且以绝句十五章见示次其韵 其十","author":"李纲","text":"天生丽质绝尘埃，肯把胭脂漫污腮。\n幸有清香过于雪，对人何止白皑皑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10779,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"叶梦授送家园梅花且以绝句十五章见示次其韵 其十一","author":"李纲","text":"萧疏竹外袅烟梢，清浅溪流映小桥。\n不似僧房静中看，月明风细夜寥寥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10780,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"叶梦授送家园梅花且以绝句十五章见示次其韵 其十二","author":"李纲","text":"小轩幽槛最相宜，对酒难禁绰约姿。\n莫讶落英飘万点，待看青子缀疏枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10781,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"叶梦授送家园梅花且以绝句十五章见示次其韵 其十三","author":"李纲","text":"云裳缟带步摇冠，谁遣瑶姬下广寒。\n默侍先生浑不语，风枝时听佩珊珊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10782,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"叶梦授送家园梅花且以绝句十五章见示次其韵 其十四","author":"李纲","text":"广平援笔赋梅花，富艳清便底死誇。\n况有西湖隐君子，句中能道影横斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10783,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"叶梦授送家园梅花且以绝句十五章见示次其韵 其十五","author":"李纲","text":"草木冻死山中村，惟有梅花解返魂。\n弱植孤根傲霜霰，玉奴终不负东昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10784,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上元日同王丰甫叶梦授会饮","author":"李纲","text":"当年玉辇侍端门，岂意风尘四海奔。\n正恐溪山太寥落，也将灯火照黄昏。\n月华清切人千里，曲调凄凉酒一樽。\n多谢故人相煖热，感时抚事祗销魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10785,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闻建寇逼境携家将由乐沙县以如剑浦","author":"李纲","text":"我来寓杉江，客馆未煖席。\n纷然群盗起，环境暗锋镝。\n束装呼仆夫，又复事远适。\n峨峨章源岭，峻峭初未识。\n攀援仅能进，十步九倾侧。\n风吹雾雨冰，草木尽矛戟。\n朝登暮始降，落日半天赤。\n儿童饥屡啼，徒御疲已极。\n薄游玉华洞，庶可稍休息。\n东郊遽不开，蜂蚁迭吞食。\n避寇如避弩，吾敢惮行役。\n驱车适沙阳，颇喜田野辟。\n虽经兵火馀，邑屋幸如昔。\n旧游疑梦中，一一有遗迹。\n寓轩存佛宫，脩竹自春色。\n峥嵘凝翠阁，尚对七峰碧。\n故人皆避地，谁与道胸臆。\n理舟剑浦行，稍就宽旷域。\n溪流正湍暴，恶子亦充斥。\n脱身险阻中，恊济藉众力。\n吟哦杜陵诗，妙语皆中的。\n丧乱古今同，临风意如织。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10786,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次沙阳留题寓轩","author":"李纲","text":"一纪重来一梦中，寓轩脩竹自春风。\n故人散去因群盗，旧意相亲惟七峰。\n溪上偶存凝翠阁，圃中安往乐全翁。\n感时不用频惆怅，万法从来本是空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10787,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"留题凝翠阁二绝 其一","author":"李纲","text":"重到沙阳十二春，新罹兵火为伤神。\n欲论旧事无知者，只有青山是故人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10788,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"留题凝翠阁二绝 其二","author":"李纲","text":"山秀波平望不穷，此身浑堕翠光中。\n兵戈满眼栖何地，注目溪头群玉峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10789,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过罗畴老故居有感二首 其一","author":"李纲","text":"凤去梁摧忽十年，空馀文翰世间传。\n池台春色仍依旧，几杖遗音犹隐然。\n把酒屡陪高阁醉，挥毫几和白云篇。\n追寻旧事如畴昔，泪湿幽花曲槛前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10790,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过罗畴老故居有感二首 其二","author":"李纲","text":"一别那知生死分，乱离重到德公门。\n雷张莲社旧同约，询惠沧洲徒有言。\n江海凄凉人已远，园林萧瑟剑空存。\n我来痛恨匆匆去，宿草无因奠一樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10791,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"兴国璨老浴堂新成以伽佗见示戏成三绝句 其一","author":"李纲","text":"湛然定水满新池，试浴金毛狮子儿。\n普愿众生尽无垢，此身何惜汗成泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10792,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"兴国璨老浴堂新成以伽佗见示戏成三绝句 其二","author":"李纲","text":"汤泉海涌气云蒸，垢去心安身倍轻。\n谁道圆通非外护，却因妙触得宣明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10793,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"兴国璨老浴堂新成以伽佗见示戏成三绝句 其三","author":"李纲","text":"池中已具八功德，浴处还敷七净华。\n妙体本来尘不染，何妨痒处与抓爬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10794,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿开平寺去剑浦二十里有泉石之胜曩与郡守谢德夫同游今一纪矣溪山草木依然住持犹旧人也感叹有作二首 其一","author":"李纲","text":"旧游浑似梦，佳处每难忘。\n地僻溪山秀，春深草木香。\n世途方梗棘，老景自凄凉。\n衲子那知此，闲中气味长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10795,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿开平寺去剑浦二十里有泉石之胜曩与郡守谢德夫同游今一纪矣溪山草木依然住持犹旧人也感叹有作二首 其二","author":"李纲","text":"往年同谢老，胜赏到开平。\n步屧山云细，回舟溪月清。\n光阴双转毂，身世两浮萍。\n愿卜幽栖地，翛然得此生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10796,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"道延平适风雨雷电大作土人谓之剑归有感","author":"李纲","text":"干将未发埋酆城，光气上腾干列星。\n张雷博识各有得，神物终合归延平。\n没人下视不可取，天矫已作虬龙形。\n至今千载有肸蚃，往往出入驱雷霆。\n我来弭棹双溪上，正昼云雾忽晦暝。\n金蛇掣电起潭底，霹雳荐作声轰轰。\n土人谓是剑归候，连日风雨资芽萌。\n嗟嗟尔剑诚有灵，胡不奋飞辅助讨不庭。\n群凶塞路盗贼横，夷狄外侮方骄狞。\n佩之其人得所托，蠹国害民奸腰佞领逦迤皆削平。\n何为终日但长啸，时出光怪惊动无知氓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10797,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题王氏志嘉堂二首 其一","author":"李纲","text":"秀岭云屏拥，湍流玉佩锵。\n竹光深锁翠，兰气暗腾芳。\n岂谓兵戈日，来登君子堂。\n美才方世用，嘉遁自难忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10798,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题王氏志嘉堂二首 其二","author":"李纲","text":"茗饮过溪阁，萧然泉石幽。\n雨馀空翠湿，春老碧鲜浮。\n行止随时运，笑谈销客愁。\n遁亨真我事，暮景付沧洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10799,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"追次东坡和郁林王守韵","author":"李纲","text":"盖世文章妙语言，谁令骨相似虞翻。\n玉堂大手空遗迹，海岛幽栖有断垣。\n仙去公宁怀此土，生还我亦荷宽恩。\n龙虬满纸疑飞动，尚想挥毫气象轩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10800,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游包道士山居","author":"李纲","text":"何日养铅丹，幽居紫翠间。\n架岩开户牖，隐几俯溪山。\n昔到浑如梦，今游更觉閒。\n兵戈知满地，佳处且跻攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10801,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自剑浦乘舟至水口溪流方涨备见湍激奔猛之状赋诗以纪其事","author":"李纲","text":"避地适南土，舍车登叶舟。\n春溪浑带雨，霁石出如牛。\n诘曲知操妙，飘腾觉去遒。\n烟笼岚翠滴，滩激浪花浮。\n廉利森排戟，盘回巧转辀。\n轻生真可戒，快意且销忧。\n滟滪过三峡，蓬壶访十洲。\n平生志江海，暮景侣巢由。\n易象观嘉遁，骚经赋远游。\n扁舟入吾手，此外更何求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10802,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"温泉二绝 其一","author":"李纲","text":"温冷泉源各自流，天教施浴雪峰陬。\n众生尘垢何时尽，汩汩人间几度秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10803,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"温泉二绝 其二","author":"李纲","text":"玉池金屋浴兰芳，千古华清第一汤。\n何似此泉浇疾病，不妨更入荔枝乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10804,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵周元仲见寄二首 其一","author":"李纲","text":"凌云健笔有神锋，抵掌高谈久不同。\n江上过从犹宿昔，峤南游历遍西东。\n山川多助新诗里，花鸟愁添老眼中。\n万里归来好同隐，竹林今祗欠王戎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10805,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵周元仲见寄二首 其二","author":"李纲","text":"五年奔走敝征衣，海上相亲半是黎。\n望断故园无旅雁，心惊中夜听荒鸡。\n岂知南渡能还北，更笑东来又向西。\n多谢故人寻访意，千山万水不曾迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10806,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]