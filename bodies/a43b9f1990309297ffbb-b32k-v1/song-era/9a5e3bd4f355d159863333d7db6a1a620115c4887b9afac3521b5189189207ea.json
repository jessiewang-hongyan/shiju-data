[{"title":"酴醾","author":"欧阳修","text":"清明时节散天香，轻染鹅儿一抹黄。\n最是风流堪赏处，美人取作浥罗裳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30682,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"欧阳景","text":"清明时节正稼芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30683,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其三","author":"欧阳景","text":"遍向蜀都呈巧样，被人翻入锦纹头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30684,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"摸鱼儿 寿柴守，八月二十七日生，正是夫子绂麟之日","author":"欧阳朝阳","text":"正当绂麟时候，秋香还弄清晓。\n双旌五马人间贵，千里共腾欢笑。\n人未老。\n看绿鬓朱颜，赢得花簪帽。\n兽炉篆袅。\n听檀板轻敲，歌珠一串，依约似蓬岛。\n青云步，九万论程未了。\n芹宫多世仪表。\n提封晋郡重拈出，留样他年称好。\n书上考。\n怕种满棠阴，丹诏催归早。\n安期献枣。\n对鹤健丹香，龟轻莲叶，起舞醉清醥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30685,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题铁作池上亭","author":"欧阳程","text":"凿开幽境泛流萍，回合波閒小洞庭。\n寒影倒吞凌汉树，冷光高浴半天星。\n鱼翻锦鬣波纹皱，鹭洗霜翎水气腥。\n昨夜蛟龙忽飞去，满天风雨震雷霆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30686,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题睢阳五老图","author":"欧阳谦之","text":"厚德良多积善根，贤才他日在儿孙。\n当知相里非凡婿，岂有陈平久席门。\n五老绘图千载誉，群公诗礼百年存。\n凭君挟取传家学，青史贤良有后昆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30687,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和伍武仲","author":"欧阳鈇","text":"未知一岁于此水，几回照影惭栖栖。\n失身竟堕管城计，错路不为田舍儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30688,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绝句 其一","author":"欧阳鈇","text":"恋树残红湿不飞，杨花雪落木生衣。\n年来百念成灰冷，无语送春春自归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30689,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绝句 其四","author":"欧阳鈇","text":"篷窗卧听疏疏雨，却是芭蕉夜半声。\n烟浪蔽天天倚盖，略容一点白鸥明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30690,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绝句 其二","author":"欧阳鈇","text":"桑麻得雨更青葱，芍药留春结晚红。\n怪得鸟声如许好，此身还在乱山中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30691,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绝句 其三","author":"欧阳鈇","text":"为怜红杏亚枝斜，看到斜阳送乱鸦。\n又是一春穷不死，天教留眼看莺花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30692,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"禾山秋兴 其一","author":"欧阳鈇","text":"生计嗟乌有，谁人问子虚。\n西风五更雨，南雁数行书。\n衰朽儿童笑，飘流岁月馀。\n秋深新病起，吾志在吾庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30693,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"禾山秋兴 其二","author":"欧阳鈇","text":"夜起集万感，胡为淹此留。\n诗成夔子国，人在仲宣楼。\n络纬声中泪，芭蕉雨里愁。\n遥知屡门倚，应念有方游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30694,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"卜居","author":"欧阳鈇","text":"此生老矣益飘零，汤饼来年又何所。\n是身如寓敢求安，更筑小轩名以寓。\n凭谁叫阍与帝语，有客多艰乃如许。\n水花为客啼红雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30695,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"示二子","author":"欧阳鈇","text":"先君以官贫，我仍遗以安。\n但愿两儿健，扶持一翁孱。\n何须待门生，悠然柴桑閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30696,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游愚堂","author":"欧阳鈇","text":"闻说名园尚修竹，花压颓垣笋穿屋。\n雨痕半掩壁间题，饥鼠跳梁狐昼啼。\n前人已为后人笑，后人更使谁人悼。\n呜呼全盛几时奈衰何，古人兴废何其多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30697,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其十五","author":"欧阳鈇","text":"爱山如爱酒，畏暑如畏虎。\n出门寻旧游，缺月四更吐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30698,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其四","author":"欧阳鈇","text":"故人惊会面，新恨说从头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30699,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其十八","author":"欧阳鈇","text":"心清时自暑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30700,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其十二","author":"欧阳鈇","text":"扰扰征人相顾语，萧萧落木不胜秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30701,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其十四","author":"欧阳鈇","text":"千里归来人事改，十年犹幸此身存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30702,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其六","author":"欧阳鈇","text":"月白玄猿哭，更残络纬悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30703,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其十七","author":"欧阳鈇","text":"读书岂为官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30704,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其八","author":"欧阳鈇","text":"巷南巷北人招饮，一雨一晴花耐看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30705,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其十一","author":"欧阳鈇","text":"青山如故情非故，芳草唤愁诗遣愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30706,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其十","author":"欧阳鈇","text":"梦回金马玉堂上，文在冰瓯雪碗中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30707,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其十三","author":"欧阳鈇","text":"风色似传花信到，夕阳微放柳梢晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30708,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其三","author":"欧阳鈇","text":"谁知花过半，才与酒相寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30709,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其二","author":"欧阳鈇","text":"梦回千里外，灯转一窗深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30710,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其十六","author":"欧阳鈇","text":"更阑待月华，风露寒欲僵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30711,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其七","author":"欧阳鈇","text":"语离遽何许，话旧复何时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30712,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其一","author":"欧阳鈇","text":"细雨双飞鹭，寒蓑独钓船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30713,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其九","author":"欧阳鈇","text":"有客过门湖海士，隔篱呼酒咄嗟间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30714,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠田端彦","author":"欧阳献","text":"守节固穷匪易事，铁中谁许斗铮铮。\n闻道新除右仆射，难留高卧老先生。\n能令馀党留残息，必有昌言佐盛明。\n我欲效颦嗟老矣，西风回首涕纵横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30715,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答田端彦","author":"欧阳献","text":"莫嗟骐骥老，不识云台仗。\n此骥天所月，未易论得丧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30716,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"公宇芦","author":"欧阳詹","text":"渔家分得两三茎，公退徐吟思倍清。\n官满不将归旧隐，萧萧留与后人听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30717,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其一","author":"欧阳詹","text":"啼猿非有恨，行客自多悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30718,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"临江仙 九日登碧莲峰","author":"欧阳辟","text":"涧碧山红粉烂漫，烟萝远映霜枫。\n倚阑人在暮云东。\n遥天垂众壑，平地起孤峰。\n大好家山重九日，尊前切莫匆匆。\n黄花消息雁声中。\n寻芳须未晚，与客且携筇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30719,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小重山","author":"欧阳澈","text":"红叶伤心月午楼。\n袭人风细细，远烟浮。\n瞢腾醉眼不禁秋。\n追旧事，拍塞一怀愁。\n心绪两悠悠。\n东阳消瘦损，甚风流。\n拟凭仙枕梦中游。\n无眠久，通夕数更筹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30720,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玉楼春 其二","author":"欧阳澈","text":"年时醉倚温温玉。\n妒月精神疑可掬。\n香丝篆袅一帘秋，潋滟十分浮蚁绿。\n兴来笑把朱弦促。\n切切含情声断续。\n曲中依约断人肠，除却梨园无此曲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30721,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玉楼春 其一","author":"欧阳澈","text":"个人风韵天然俏。\n入鬓秋波常似笑。\n一弯月样黛眉低，四寸鞋儿莲步小。\n绝缨尝宴琼楼杪。\n软语清歌无限妙。\n归时桂影射帘旌，沈水烟消深院悄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30722,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"虞美人","author":"欧阳澈","text":"玉楼缥缈孤烟际。\n徙倚愁如醉。\n雁来人远暗消魂。\n帘卷一钩新月、怯黄昏。\n那人音信全无个。\n幽恨谁凭破。\n扑花蝴蝶若知人。\n为我一场清梦、去相亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30723,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝶恋花 拉朝宗小饮","author":"欧阳澈","text":"红叶飘风秋欲暮。\n送目层楼，帘卷西山雨。\n解榻聚宾挥玉麈。\n风流只欠王夷甫。\n质剑为公沽绿醑。\n涤濯吟魂，拟摘黄花句。\n醉眼瞢腾携手处。\n谢池风月谁分付。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30724,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"踏莎行","author":"欧阳澈","text":"罗幕风轻，水沈烟细。\n杯行笑拥东山妓。\n酬歌何惜锦缠头，清音暗绕梁尘起。\n银甲弹筝，碧桃荐味。\n举觞飞白拚沈醉。\n花窗弄月晚归来，门迎蜡炬笙箫沸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30725,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"踏莎行","author":"欧阳澈","text":"雁字书空，橘星垂槛。\n江天水墨秋光晚。\n香丝袅袅祝尧年，公庭锡宴挥金碗。\n醉索蛮笺，狂吟象管。\n珠玑灿灿惊人眼。\n遏云更倩雪儿歌，从教拍碎红牙板。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30726,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"状元峰","author":"欧阳麟","text":"一峰高耸上参天，地势钟灵出状元。\n雪霁乍疑抽紫笋，云开忽见吐青莲。\n平明远捧金乌小，薄暮高擎玉兔圆。\n独羡唐家贤父子，芳名留得后人传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30727,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题旅舍","author":"武夷","text":"去日春蚕吐雪丝，归时霜菊剥金衣。\n沙鸥不入鸳鸿侣，依旧沧浪绕钓矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30728,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"买鞭","author":"武成","text":"初买虽怜价甚微，驽骀便已化骦騛。\n干长却想穿阶直，节密应知受土肥。\n金赐夜寒敲月落，玉丝春袅拂花飞。\n提携莫笑无他用，万里旌旗更指挥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30729,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"赵必橦","text":"昔时说易希程氏，今日传经愧伏生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30730,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"武宣徽","text":"尊前依约认三公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30731,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"七夕","author":"武衍","text":"金针插并玉搔头，月落河倾尚倚楼。\n细认双星还自感，别离同是一般愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30732,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日","author":"武衍","text":"倒尽鸱夷酒更沽，西风吹兴渺江湖。\n客中剩喜身强健，岁岁秋香看紫萸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30733,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小院","author":"武衍","text":"小院秋声动碧梧，飒然凉思满籧篨。\n年来懒结青镫伴，却课儿曹读夜书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30734,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小游仙词","author":"武衍","text":"天风吹上碧嶙峋，鸾鹤声清草木薰。\n金阙玉楼行欲遍，却携明月出红云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30735,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书吴江塔院水月","author":"武衍","text":"叠叠沧波隔乱山，白鸥飞去复飞还。\n吟边好思无多子，祇在孤舟落照间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30736,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书画扇","author":"武衍","text":"双成午夜约飞琼，齐驾红鸾看月明。\n缥缈碧云归去晓，洞天霜冷玉箫清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30737,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"双鹭","author":"武衍","text":"谁惊双鹭起蘋汀，蹴裂玻瓈细有声。\n飞入白云浑不辨，碧山横处忽分明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30738,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"开元广寒词","author":"武衍","text":"桂华珠殿水精楼，柘袖笼香乙夜游。\n飞下银桥人不觉，月明三十六宫秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30739,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"长桥月夕","author":"武衍","text":"捲来沧海黄银浪，飞出层云白玉团。\n千古垂虹奇绝处，独凭三百赤阑干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30740,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"正元二日与菊庄汤伯起归隐陈鸿甫汎舟湖上二首 其二","author":"武衍","text":"棹转逋山舣落晖，春风深锁恨依依。\n松间一鹤俄飞起，疑是先生出未归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30741,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"正元二日与菊庄汤伯起归隐陈鸿甫汎舟湖上二首 其一","author":"武衍","text":"春云漠漠雨疏疏，小?冲烟入画图。\n除却淡妆浓抹句，更将何语说西湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30742,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"立春","author":"武衍","text":"蓼滴辛盘色斗鲜，已将春到酒尊前。\n金幡不用吴娃祝，自唱新词插鬓边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30743,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"立秋夕","author":"武衍","text":"水花香弄晚风清，閒立梧桐看月生。\n夜漏向深秋始觉，一天星湿露华明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30744,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寻昔游","author":"武衍","text":"碧水青山旧路迷，刘郎怊怅阮郎悲。\n仙桃一别人间去，洞里春风自四时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30745,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次平小景","author":"武衍","text":"一拂残烟暝不收，作成溪上十分秋。\n空林落日西风急，红叶无诗水自流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30746,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"老宫人 其一","author":"武衍","text":"宝髻无光玉貌昏，悲歌空感旧承恩。\n君王喜问先朝事，时许车儿到殿门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30747,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"老宫人 其二","author":"武衍","text":"侍辇观花上苑春，太皇宣索凤笙频。\n如今犹记当时曲，对谱閒教小内人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30748,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"老将","author":"武衍","text":"几回梦里到边陲，马上犹能磨战旗。\n弹泪对人偏爱说，建炎随驾渡江时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30749,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西陵观梅","author":"武衍","text":"障霜篝日夺天机，九月梅花赏玉蕤。\n到了不如春意胜，水边风韵两三枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30750,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"阮客","author":"武衍","text":"粉靥娇春掌上轻，玉琴声里见深情。\n花边临别重回首，犹恐丝弦说未明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30751,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"阳复","author":"武衍","text":"一变阳爻七日初，窗閒测影弄徐徐。\n不知曾未添宫线，但觉多翻数叶书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30752,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杏花","author":"武衍","text":"柳店春风酒旆斜，紫绡团萼数枝花。\n香肌元是多丰腻，错把红梅看作他。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30753,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宜永观雨","author":"武衍","text":"池上泠泠过雨声，绿荷风走万珠明。\n天公未欲从群望，作了晚凉俄便晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30754,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"明妃曲 其一","author":"武衍","text":"中国无人虏肆轻，六宫挥泪别倾城。\n当时谁议诛延寿，益重君王好色名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30755,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"明妃曲 其二","author":"武衍","text":"马上风沙乱鬓蝉，膻乡同地不同天。\n琵琶何用弹深怨，出降乌孙更可怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30756,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"枕边","author":"武衍","text":"枕边清坐散馀酲，惨淡西窗月半明。\n燕子梦回帘未捲，楝花风信晓寒轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30757,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"采桑曲 其一","author":"武衍","text":"粉光薄薄髻云垂，叶满湘笼独步时。\n女伴未来归未得，水边閒照插花枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30758,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"采桑曲 其二","author":"武衍","text":"道是蚕忙未是忙，日长犹得事梳妆。\n罗敷有语何曾解，倚树偷窥马上郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30759,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"客去","author":"武衍","text":"晋人冠子羽人衣，客去移床傍小池。\n扇影不摇蕲竹净，藕花风里看唐诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30760,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]