[{"title":"李士举见寄次韵为谢二首 其二","author":"晁公溯","text":"想见山灵喜，如看柱史来。\n江清无急硖，野润失飞埃。\n行揽孟博辔，再然安国灰。\n相过忍遽别，莫放锦帆开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54868,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"李士举见寄次韵为谢二首 其一","author":"晁公溯","text":"忽鼓硖中棹，来从渝上城。\n何为向南亩，本合侍西清。\n树色行相引，滩声鸣不平。\n青城有仙伯，往矣授长生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54869,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"李仁甫将至郭下以诗迎之","author":"晁公溯","text":"公馆可休舍，良宵宜对床。\n肯污白云屦，来过碧澜堂。\n置馔同三饭，开筵累十觞。\n凉秋当泛菊，小住撷微芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54870,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"李悦夫刘文潜坐上醉归作","author":"晁公溯","text":"将老尚逐食，相逢聊举觞。\n贫非原宪病，酒发次公狂。\n未至世臣国，先登君子堂。\n谁能更拘束，短发已沧浪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54871,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杨参政挽章二首 其二","author":"晁公溯","text":"亟上疏封印，空驰会葬车。\n山川浑不改，气象比何如。\n德行太常议，功名惇史书。\n平生所荐士，岂复减严徐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54872,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杨参政挽章二首 其一","author":"晁公溯","text":"学海波澜阔，人间爵齿尊。\n南宫冠多士，东海起高门。\n请去三公府，归休五亩园。\n何须篆幽石，天下有师言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54873,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杨复先寄荔子仍和予昨所赠二诗因次韵 其三","author":"晁公溯","text":"遥想载酒客，时来从子云。\n山高去天咫，日永惜阴分。\n秋稼田亩接，夏弦闾里闻。\n草堂无数出，猿鹤有移文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54874,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杨复先寄荔子仍和予昨所赠二诗因次韵 其四","author":"晁公溯","text":"野色正如此，废书时出游。\n山吞落日尽，硖束大江流。\n俗驾谢逋客，郊居如隐侯。\n爱君吐佳句，落纸不能休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54875,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杨复先寄荔子仍和予昨所赠二诗因次韵 其一","author":"晁公溯","text":"林间熟丹实，叶底缀红云。\n并舍皆好事，绝甘能劝分。\n扣门知使至，登俎觉香闻。\n更与诗争丽，纷披锦绣文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54876,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杨复先寄荔子仍和予昨所赠二诗因次韵 其二","author":"晁公溯","text":"嘉果喜三嗅，名园思一游。\n骈头丹壳皱，绕指玉浆流。\n味压乾?子，韵高萧洒侯。\n安居日啖此，边堠幸兵休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54877,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"沙寒","author":"晁公溯","text":"沙寒兼白石，瀼断入青溪。\n硖雾连山暗，江云出水低。\n远游殊俗倦，归路故乡迷。\n日落荒原上，城乌已复啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54878,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和郭安道","author":"晁公溯","text":"水落滩声急，风来树影移。\n懒穷千里目，空诵四愁诗。\n白帽何妨隐，黄粱未遣炊。\n要令乡国梦，暂向枕中迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54879,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜","author":"晁公溯","text":"树合春城暗，江鸣夜硖喧。\n艰难犹此地，漂泊更何言。\n冉冉轻烟集，辉辉列宿繁。\n巡檐望南斗，无路入脩门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54880,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"官舍","author":"晁公溯","text":"得閒谁更傍人门，且喜深居少送迎。\n杨柳春风垂地影，芭蕉夜雨隔窗声。\n病宽束带围应减，愁搅枯肠睡苦轻。\n明日公庭有官事，又须持板候鸡鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54881,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"官舍","author":"晁公溯","text":"雨径苍苔滑，风帘翠筱斜。\n邑居藏万室，驿道接三巴。\n晓堞调清角，春庭放早衙。\n归休幸无事，随意酌流霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54882,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"细雨","author":"晁公溯","text":"细雨真宜麦，轻阴似养花。\n人烟随土断，村径逐溪斜。\n大道能方轨，春泥欲溅车。\n归来洗靴裤，城郭未吹笳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54883,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"视通济堰二首 其二","author":"晁公溯","text":"往年初堰坏，乐岁亦民饥。\n再见龙尾水，如兴鸿却陂。\n名同召伯埭，人立许杨祠。\n祝史有祀事，歌予迎送诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54884,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"视通济堰二首 其一","author":"晁公溯","text":"野树皆绿叶，清江初白蘋。\n偶来无筮日，小出当行春。\n人颂勾龙社，恩沾佩犊民。\n横江三百丈，遥见石嶙峋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54885,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"郊外","author":"晁公溯","text":"草尽春泥绿，花乘晚照明。\n遥山先暝色，平野易风声。\n归沐休形役，深居感物情。\n据鞍聊一出，佳处得徐行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54886,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨中过祁门十里不能进宿旅次","author":"晁公溯","text":"今日祁门县，冲泥怯远行。\n含风云叶细，间雨雪花轻。\n溪晚白鸥下，草寒黄犊鸣。\n吾今更何往，漂泊愧平生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54887,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨罢风大作","author":"晁公溯","text":"燕寝真宜雨，卧闻风有声。\n莫惊无碍睡，宁为不平鸣。\n折笋低行蚁，飞梅暗打莺。\n最怜两岐麦，攲倒乱纵横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54888,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"侯革以诗见示次韵","author":"晁公溯","text":"少陵有幽事，止共阮生论。\n把酒与贤乐，为邦惭主恩。\n欻倾宾客坐，知出聘君门。\n胜识中郎面，区区对虎贲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54889,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"修觉寺","author":"晁公溯","text":"山绕象耳北，堰横龙爪西。\n遥瞻蜀玉垒，不减汉金堤。\n未合三江水，仍通百社溪。\n春流已可爱，散乱浴凫鹥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54890,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南州","author":"晁公溯","text":"久矣吾人愧白鸥，尘埃无路入南州。\n愁横蜀岭何年断，梦绕吴江尽日流。\n病骨本无轩冕相，微官端为稻粱谋。\n与君共约东归日，江总还家要黑头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54891,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"庭下荔子熟","author":"晁公溯","text":"脩枝密叶总扶疏，小摘登盘置坐隅。\n翠盖高垂张葆羽，赤缯全皱裹明珠。\n不劳汉候十五里，可压越人三百株。\n欲与铨量立题品，岂惟当使橘为奴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54892,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日","author":"晁公溯","text":"花发春连屋，山晴昼满楼。\n所过皆异县，何处是皇州。\n颃颉莺衔逐，呢喃燕聚谋。\n物生各有累，于世孰无求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54893,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春回","author":"晁公溯","text":"城郭初瞻北斗移，春回冰壑已流澌。\n石林背日垂寒旆，江藻舒风引细丝。\n物色徐看催岁换，形容先拟驻年衰。\n天涯草木虽无赖，亦复欣欣及圣时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54894,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春晚 其二","author":"晁公溯","text":"野树交新叶，春江上晚潮。\n花泥粘落蕊，麦陇散疏苗。\n轻籁因风发，游尘著雨消。\n遥怜小山桂，久负楚辞招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54895,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春畦","author":"晁公溯","text":"水满春畦白，云连晚照黄。\n野花时结子，溪柳不成行。\n客礼容吾懒，酣歌与世忘。\n晚来得新句，吟罢立苍茫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54896,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浔阳","author":"晁公溯","text":"渺渺苍江绕郭流，菰蒲杜若满汀洲。\n山云不动飞黄鹤，春水无边没白鸥。\n日落荒城闻戍鼓，天清绝浦见行舟。\n老夫旧有湘吴兴，聊复今年作远游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54897,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋日","author":"晁公溯","text":"秋日淡无光，晴云閒不行。\n空中散白石，仰看天宇明。\n时闻败叶下，摵摵微风生。\n季月当泛菊，栽培园中英。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54898,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋阴","author":"晁公溯","text":"出林云未断，入坐雨初沾。\n急点鸣高瓦，寒声泻坏檐。\n悬墙閒玉麈，散帙乱牙签。\n谁道幽居胜，吾今吏隐兼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54899,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绕树","author":"晁公溯","text":"绕树行百匝，临池把一杯。\n白知茶蕊上，红对烛花开。\n已作寻芳去，何辞尽夜回。\n恶风无藉在，明日满苍苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54900,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赵主簿护贡篚至吴下有诗见示用诗为谢","author":"晁公溯","text":"轴舻千里薄枞阳，未数当年汉省方。\n勿为催归啼望帝，且看奉引驾乘黄。\n四边每报风尘静，万国同瞻日月光。\n我愿与民歌击壤，求田当卖橐中装。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54901,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送王章赴长宁通判","author":"晁公溯","text":"仰事各黄发，今为闾里荣。\n共看朱绂贵，更益綵衣明。\n泥轼幸小驻，羽觞当缓行。\n期君如石建，烜赫汉西京。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54902,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送王和甄窦公瑞归鱼洞","author":"晁公溯","text":"壁挂凝尘榻，苔生啸月楼。\n喜闻佳客至，能为故人留。\n雨积山川暝，风传鼓角秋。\n沙边晚相别，留眼送归舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54903,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送刘文潜如吴下","author":"晁公溯","text":"已聚粮三月，聊为客数旬。\n吾难留逸驾，此去立通津。\n圣主坐中具，嘉谋思上陈。\n请言尧舜道，第一在安民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54904,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送汤子才","author":"晁公溯","text":"江湖此去水连空，万贾连樯浩渺中。\n帆影浸斜青草月，笛声吹尽碧芦风。\n未论魏阙功名近，不与巴山气象同。\n更到临平看辇路，沙堤十里软尘红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54905,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送李绍祖通判宁江","author":"晁公溯","text":"此去夔州气倍增，白盐赤甲两崚嶒。\n喜看司隶李校尉，往事高人王右丞。\n若使主公登紫殿，亦归郎省卧青绫。\n老夫只拟安田亩，他日烝民颂中兴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54906,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送梁子辅赴召 其三","author":"晁公溯","text":"汉廷日徵召，舟楫去纷纷。\n行路子所见，成功吾未闻。\n故人期此去，圣代用斯文。\n会使如椽笔，书勋继典坟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54907,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送梁子辅赴召 其二","author":"晁公溯","text":"今日朝廷议，如闻少及民。\n诸侯无患楚，三户可亡秦。\n但使诛求减，常令贡赋均。\n荒年免离散，率土尽王臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54908,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送梁子辅赴召 其一","author":"晁公溯","text":"始见擢高第，即当登赤墀。\n今闻一节召，已恨十年迟。\n圣主图兴造，诸儒合论思。\n此行宜努力，勿复负清时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54909,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"郡县","author":"晁公溯","text":"郡县纷纷数代更，循良少似汉西京。\n未闻子产能宽服，谁见翁归有急名。\n所望家无空杼柚，常令天不害粢盛。\n打门不怕催科吏，愿与君王竭地征。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54910,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻伯初兄从周宣谕往两京","author":"晁公溯","text":"闻道西从使者车，殷勤问讯武侯庐。\n卧牛已去多新冢，化鹤重来失旧居。\n草木久荒门外径，尘埃应化壁中书。\n遥知流落归无处，未免悲歌问孟诸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54911,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻笛","author":"晁公溯","text":"落日卧郿坞，忽闻吹笛声。\n天清孤鹤唳，江净蛰龙鸣。\n谷响风时下，山高月未生。\n谁能永今夕，呼酒与同倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54912,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻虞参政至玉屏山 其二","author":"晁公溯","text":"乡党敬前辈，朝廷尊大儒。\n公无念丘墓，人自禁樵苏。\n此去居衡轴，长留执事枢。\n求贤养邦本，深为赞吁俞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54913,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻虞参政至玉屏山 其一","author":"晁公溯","text":"宣室思贤久，锋车促召还。\n去调金铉鼎，来别玉屏山。\n拱木雨露下，丰碑天地閒。\n九原凛如在，想足慰慈颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54914,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"哭盘石墓下","author":"晁公溯","text":"种木已大拱，今年初一过。\n方持斗酒奠，其若下泉何。\n寒日墟中淡，悲风冢上多。\n一为知己恸，泪湿石盘沱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54915,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"恭州教授宋师民有诗次韵","author":"晁公溯","text":"但闻两庑读书声，学馆无尘地更清。\n岁久缁林皆木拱，春来泮水有芹生。\n剩令龙虎登高第，再赋凫鹥美太平。\n我老循行才不称，愧君刻画与虚名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54916,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挈榼","author":"晁公溯","text":"挈榼吾何往，閒临积水边。\n晚红看落日，春碧爱晴川。\n蜂蝶低窥酒，凫鹥狎近船。\n平生五湖兴，见此一欣然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54917,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"旅宿","author":"晁公溯","text":"漠漠硖云乱，冥冥汀露微。\n鸦喧得食喜，鸥近畏人飞。\n旅宿天涯滞，心期岁暮违。\n沧江闻已涨，似欲劝吾归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54918,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晓望","author":"晁公溯","text":"城上高楼出女墙，遥看初日尚苍凉。\n松边淅沥风成响，草际晶荧露有光。\n乐岁共歌羊考牧，新春不与雁还乡。\n圣时愿报收舆地，快自襄阳下洛阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54919,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病中","author":"晁公溯","text":"官冷经过少，门寒亦懒开。\n雨馀苔及榻，病起研生埃。\n客泪随猿落，家书想雁来。\n似闻溪上柳，一一报春回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54920,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"离南平","author":"晁公溯","text":"晨光惨惨杂微霄，寒水溅溅更断桥。\n风陨栗房开紫玉，烟蒙萝幄叠青绡。\n官曹已毕三年考，客路深嗟万里遥。\n从此扬舲下巴硖，新年当及未央朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54921,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"郭外","author":"晁公溯","text":"脩林绕屋尚扶疏，绀叶樛枝老不枯。\n晴庑无风乌自语，秋场落日雉相呼。\n一区未有子云宅，半世空看摩诘图。\n终拟买田阳羡去，肯浮沧海远乘桴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54922,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偶成","author":"晁公溯","text":"离离树影晓仍疏，寂寂禽声暖自呼。\n雨垤蓄粻来聚蚁，风檐坏网落悬蛛。\n十年空诵归田赋，万里试披舆地图。\n老向人间定何许，只今湖海更南隅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54923,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偶作","author":"晁公溯","text":"官居复何有，幽事亦堪誇。\n高树行春蔓，疏篁上晚花。\n常年皆作客，随地即为家。\n尚想关山路，伤心故国赊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54924,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄李仁甫","author":"晁公溯","text":"守地难越境，吊生宁及哀。\n自伤转蓬远，莫致束刍来。\n惨日熙夏屋，悲风号夜台。\n遥知倚庐处，流泪渍苍苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54925,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄李悦夫时监成都军资库茶马司檄兼僚属闻近治胥吏数辈","author":"晁公溯","text":"宾筵聊可乐，筦库亦何劳。\n近已尸鼠辈，果能清马曹。\n晴郊堪挈榼，春事助挥毫。\n借问浣花水，只今深几篙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54926,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄泸南子止兄","author":"晁公溯","text":"杖钺知何处，看云望欲迷。\n真同阮南北，各寄蜀东西。\n峡崄水增急，楼高山为低。\n春来日行乐，桃李想成蹊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54927,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄查元章","author":"晁公溯","text":"一别三十载，再来闻未闻。\n割鲜烦啖我，举酒欲浮君。\n辩口霏木屑，醉颜生缬纹。\n相从能几日，明发重离群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54928,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚望","author":"晁公溯","text":"迟日高楼上，江山引望长。\n浮鸥轻浩渺，飞鸟灭苍茫。\n洲渚蘋初白，陵陂麦未黄。\n流年太匆促，转烛过春光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54929,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清明","author":"晁公溯","text":"便觉近长夏，温风蚕欲成。\n冠攲知发少，衣薄喜身轻。\n初荻青穿水，繁阴绿满城。\n朝来试新火，茶鼎听松声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54930,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清秋","author":"晁公溯","text":"清秋独立望殊方，粉堞遥瞻埤堄长。\n水满苍江平巨硖，风交翠木乱寒塘。\n滞留晚岁违公府，准拟明年入帝乡。\n多病早衰才不振，豫惭无赋奏长杨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54931,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"硖内","author":"晁公溯","text":"硖内收多雨，沙边惨积阴。\n龙吟殷地远，虹饮入江深。\n不作山林去，非忧荆棘侵。\n经年困奔走，无力更登临。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54932,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"野亭","author":"晁公溯","text":"兴发寻春去，宁知生路赊。\n檐牙啄晴汉，屐齿散平沙。\n风偃陵陂麦，云垂间道花。\n芳菲看即过，留滞改年华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54933,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"隆州道中","author":"晁公溯","text":"冉冉晨雾重，晖晖冬日微。\n草黄迷犊卧，水白见鸥飞。\n在野樵牧少，闭关商旅稀。\n妻孥属长至，遥想望吾归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54934,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜王志夫来","author":"晁公溯","text":"懒观南土化，归勒北山铭。\n蜡屐乃相过，巾车何不停。\n复回千里驾，去食五侯鲭。\n想见知君到，传呼閤下铃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54935,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜见吕元锡闻往谒李仁甫奉简短作","author":"晁公溯","text":"关塞三峨北，山川五渡西。\n喜逢连璧友，来自钓璜溪。\n先世施行马，高才滞割鸡。\n平生李元礼，好士必提携。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54936,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]