[{"title":"无量寿佛赞","author":"释崇岳","text":"四十八弘誓愿，百千万亿弥陀。\n水鸟树林开正眼，为人亲切不消多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17562,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示丁都院 其一","author":"释崇岳","text":"镬汤炉炭三禅乐，剑树刀山大觉场。\n此日拨开心地印，了无佛法可商量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17563,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示丁都院 其二","author":"释崇岳","text":"三千条法为今时，一性圆明要自知。\n会得自知知底事，人间何处不光辉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17564,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示如净禅人","author":"释崇岳","text":"劈面三拳，连腮两堂。\n撒手悬崖，丧尽伎俩。\n德云不在别峰上。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17565,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示汪居士","author":"释崇岳","text":"参禅悟道染泥沙，见佛与祖生冤家。\n破尘破的栽荆棘，壁立万仞有誵讹。\n也大差，也大差，一刀两段，火里莲花。\n十分无伎俩，处处有生涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17566,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示智弼礼混源塔","author":"释崇岳","text":"相逢不相识，去后空相忆。\n灵骨撒长江，清风有何极极识，滔滔浪里休寻觅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17567,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"兴密","author":"释崇岳","text":"密在汝边，诸法亦然。\n一举两得，无党无偏。\n赵州八百个中玄，箕裘事业尤堪传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17568,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"师肇首座请赞","author":"释崇岳","text":"这个汉，太愚痴。\n一句子，佛不知。\n临济老，客作儿。\n四天下，更有谁。\n拟开口，劈胸椎。\n肇首座，莫学伊，学伊彼此落便宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17569,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"师警维那请赞","author":"释崇岳","text":"冤有头，债有主。\n鳖鼻蛇，白额虎。\n活捉生擒，当阳直举，发机须是千钧弩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17570,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"芝山智默长老请赞密庵先师","author":"释崇岳","text":"击石火里穿辽天鼻孔，妙转机前打凤罗龙。\n正法眼，瞎驴边。\n灭却破沙盆，扶临济正宗。\n门庭峭峻，孰敢当锋，铁壁银山一线通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17571,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观音赞","author":"释崇岳","text":"月团团，星斗寒。\n风振海，雷破山。\n圆通大士，瑞应人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17572,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"达磨赞 其三","author":"释崇岳","text":"一苇渡江，无处埋藏。\n分皮分髓，瞒神謼鬼。\n忙忙直向西归，不知失却只履。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17573,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"达磨赞 其一","author":"释崇岳","text":"凤凰城阙，不通水泄。\n少室岩前，话作两橛。\n赚它人家男女，开眼唤龟作鳖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17574,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"达磨赞 其二","author":"释崇岳","text":"直指西来，分明祸胎。\n渡江面壁，偷心未息。\n从兹皮髓分张，轰起青天霹雳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17575,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"祐水头","author":"释崇岳","text":"风吹不入，水洒不著。\n捩转玄关，随缘自若。\n任是碧眼胡儿，从头与汝一杓。\n著不著，谁言过水不湿脚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17576,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"孜侍者行乞","author":"释崇岳","text":"不学文章不学书，孜孜于道自忘躯。\n黄尘堆里挨身转，一任清风捲太虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17577,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"希琏书记请赞","author":"释崇岳","text":"腊长年高，甚生风彩。\n南来北来，无可相待。\n黑漆竹篦聊一挥，看你当人在不在。\n琏书记，甚叵耐。\n镇海明珠，悬空扑碎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17578,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"应庵师祖赞 其二","author":"释崇岳","text":"虎口里转身，拳头上捏怪。\n胡乱三十年，起东山正派。\n不知过犯弥天大。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17579,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"应庵密庵同日忌","author":"释崇岳","text":"冤有头，债有主，撞破砂盆眼卓竖。\n不是佛，不是祖，太白峰前只如许。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17580,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"庞居士赞","author":"释崇岳","text":"心空及第，深根固蒂。\n共说无生，异类中行。\n恼乱禅家至今日，不知日午打三更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17581,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南侍者还莆阳","author":"释崇岳","text":"若将此语定宗纲，任是灵山未厮当。\n大地撮来无粟粒，令人翻忆老曾郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17582,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送化主 其四","author":"释崇岳","text":"百亿分身利有情，驴腮马颔实难明。\n有时闹里聊伸手，意在钩头不在星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17583,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送聪首座之弋阳兼呈陈郎中","author":"释崇岳","text":"当头一著没巴鼻，坐断诸方成忌讳。\n此心不向白云闲，一锡飘然下层翠。\n晦庵过犯弥天大，居士无端也捏怪。\n至今落赚有谁知，也要大家偿夙债。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17584,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送悟藏主还姑苏","author":"释崇岳","text":"玲珑岩畔瞥不瞥，竖起脊梁生铁橛。\n无端林下错商量，携手相随入虎穴。\n瓮里蓦然失却鳖，个事明明向谁说。\n彼时只是此时人，谁知眼里重添屑。\n我携拄杖奔南北，君入西山恣轻忽。\n放下蛇头捋虎须，翻身便作白拈贼。\n太虚全布目前机，生杀交驰谁敢窥。\n我来一笑重相见，鼻孔由来向下垂。\n密庵家风彻骨贫，密庵有眼且无筋。\n将无作有这些子，透这些子能几人。\n西风落木天宇迥，君兮不住别峰顶。\n曹溪一滴杖头挑，涨起吴江千万顷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17585,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送琉书记还长乐 其三","author":"释崇岳","text":"迢迢故国三千里，忽忆萓堂送别时。\n拄杖生风兴何极，楚天辽邈远山低。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17586,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送鹿野珍禅友还七闽 其一","author":"释崇岳","text":"共处十年真岁寒，山边水边相盘桓。\n拶倒几回扶不起，未尝说著祖师关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17587,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送谦侍者还乡省亲","author":"释崇岳","text":"有句无句藤倚树，铁壁银山没回互。\n三千里外面尊堂，一毫头上全体露。\n睦州谩说编蒲屡，新丰卖峭不归去。\n今人不比昔时人，出门便是还乡路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17588,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"能仁光睦长老画师顶相请赞","author":"释崇岳","text":"恣拍盲性，用劈胸拳。\n并荡三玄三要，管甚栗棘金圈。\n渠侬已是灭胡种，不知将底付儿孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17589,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二十五首 其二十五","author":"释崇岳","text":"莫莫，拈出一条断贯索。\n任从我佛及众生，撩天鼻孔都穿却。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17590,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二十五首 其二十一","author":"释崇岳","text":"百丈狸奴面，沩山鬼眼睛。\n见人空解笑，弄物不知名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17591,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二十五首 其二十","author":"释崇岳","text":"出水何如未出水，莲花荷叶有来由。\n定光金地遥招手，智者江陵暗点头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17592,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二十五首 其十七","author":"释崇岳","text":"赵州吃茶去，毒蛇横古路。\n踏著乃知非，佛也不堪做。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17593,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二十五首 其十六","author":"释崇岳","text":"闪电光中宾主分，虚空背上立纲宗。\n祖师活计只如此，后代儿孙扫地空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17594,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二十五首 其十五","author":"释崇岳","text":"云门小厮儿，作大狮子吼。\n鼻孔得半边，不知失却口。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17595,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二十五首 其九","author":"释崇岳","text":"京师出大黄，见贼便见赃。\n竹杖化龙去，痴人戽夜塘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17596,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二十五首 其七","author":"释崇岳","text":"大梅梅子熟，庞老已先知。\n正眼验深要，相逢拍手归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17597,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二十五首 其六","author":"释崇岳","text":"出得出不得，攧落精灵窟。\n何处不风流，祖师无妙诀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17598,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二十五首 其五","author":"释崇岳","text":"分明写出与君看，意在钩头不在盘。\n纵使石人开得口，不知犹被舌头瞒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17599,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二十五首 其二","author":"释崇岳","text":"平生心胆向人倾，过犯弥天已不轻。\n带累马师胡乱后，至今错认定盘星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17600,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古六首 其六","author":"释崇岳","text":"家家尽看野狐儿，铁笛横拈撩乱吹。\n吹罢不知何处去，夕阳已挂柳梢西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17601,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古六首 其一","author":"释崇岳","text":"地狱天堂，八字打开，谁知无去亦无来。\n若言已得三禅乐，未免将身自活埋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17602,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古六首 其四","author":"释崇岳","text":"狗子佛性无，门上钉桃符。\n千邪俱不入，百怪尽消除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17603,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其一二一","author":"释崇岳","text":"一二三四五，五四三二一。\n风过树头摇，天晴日头出。\n会得日头出，不会而自屈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17604,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其一一九","author":"释崇岳","text":"有你不有我，有我不有你。\n咬定牙关，齐之以礼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17605,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其一一六","author":"释崇岳","text":"识不识，见非见。\n说易说难，如油入面。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17606,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其一一五","author":"释崇岳","text":"梵志翻著袜，摩耶生悉达。\n声迹不相干，今朝四月八。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17607,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其一一四","author":"释崇岳","text":"从门入者，不是家珍。\n拶倒灯笼露柱嗔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17608,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其一一三","author":"释崇岳","text":"绝罗笼，脱羁锁。\n虽是善因，而招恶果。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17609,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其一一二","author":"释崇岳","text":"不著佛求，不著法求，不著僧求。\n扬帆鼓棹，任性优游。\n收舍南州与北州，都卢无有一丝头。","collection":"宋","notice":""