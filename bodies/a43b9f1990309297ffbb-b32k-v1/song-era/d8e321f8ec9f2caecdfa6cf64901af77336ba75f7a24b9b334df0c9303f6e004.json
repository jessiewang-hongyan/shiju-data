[{"title":"江楼写望 其一","author":"释文珦","text":"危栏朝独倚，千里望中閒。\n旭日穿层浪，明霞际断山。\n京华襟带里，于越有无间。\n鼓枻知谁子，长歌去不还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7643,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江路","author":"释文珦","text":"江路何迢远，乘舟亦自劳。\n篷疏霜气入，港狭水声高。\n旅食无兼味，行装祇缊袍。\n楫师催客起，初日上林皋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7644,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"池上别友人","author":"释文珦","text":"今朝携手处，高榭俯风漪。\n正尔俱衰暮，宁堪又别离。\n柳长深映马，荷弱未胜龟。\n它日遥相忆，还应话此时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7645,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"百年 其一","author":"释文珦","text":"百年如大梦，梦中谁到老。\n贫贱固可怜，富贵亦何好。\n举世尽蚩蚩，醒寤苦不早。\n自古知几人，独在商山皓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7646,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"竹坡旧隐","author":"释文珦","text":"路转新塘曲，舟通别墅幽。\n觉华严佛地，梵放杂渔讴。\n粳稌连畴晚，菱渠四泽秋。\n竹坡今不作，清泪落菟裘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7647,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"老人","author":"释文珦","text":"老人方外人，观物又观身。\n得性无今古，随时亦故新。\n梅容微笑腊，柳意暗藏春。\n除是同怀者，知予此语真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7648,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"老大","author":"释文珦","text":"老大偏多感，那堪客路中。\n凄凉经月病，安忍半生穷。\n衰草凝霜白，高枫借日红。\n今朝方暂起，先问菊花丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7649,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"老子","author":"释文珦","text":"老子深栖趣已成，尘鞿何计可相萦。\n寒泉一道知来脉，灵木多年产寄生。\n云外暗藏龙虎穴，风中清度鹤猿声。\n过从等是无心侣，同吃山厨芋颗羹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7650,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"老去 其二","author":"释文珦","text":"老去玄衣敝，归来白屋寒。\n故书多散失，时事转艰难。\n背日松悭长，经霜菊尽乾。\n邻翁犹念旧，扶杖数相看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7651,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"老去 其一","author":"释文珦","text":"老去寡交游，孤吟倚石楼。\n风生云渐散，虹见雨初收。\n苍莽天将暮，凄清气似秋。\n玄猿慰岑寂，长啸碧峰头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7652,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"老身","author":"释文珦","text":"老身到此合称翁，双足蹒跚两耳聋。\n聊托迂疏居世表，幸无名字到官中。\n生期槁木寒灰尽，性与孤猿野鹤同。\n去岁有锥无地卓，今年锥地并皆空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7653,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自爱","author":"释文珦","text":"衣裳唯毳衲，饮啄祇箪瓢。\n翻为生涯薄，能令世虑消。\n寒花香不远，病木叶先凋。\n自爱秋风里，云山共寂寥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7654,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自爱","author":"释文珦","text":"自爱予生爱性真，真存浑不管渠嗔。\n从来有水有山处，著得无名无利人。\n腾踏岂须誇驵骏，幽潜端可养精神。\n尽向云边寻隐迹，谁知云是老夫身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7655,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自鄞江东泛舟至黄山桥度岭游白云寺","author":"释文珦","text":"望望白云居，崔嵬在碧虚。\n水穷方度岭，石峻不容车。\n旧爱松萝顶，重来笋蕨馀。\n却怜清绝景，无地著吟庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7656,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"行止吟","author":"释文珦","text":"行止定如何，江湖岁月多。\n情真疑近傲，语直似伤和。\n野馔甘藜藿，山衣爱薜萝。\n因同田父熟，学得饭牛歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7657,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"行石林苍莽间颇多幽致有思归隐","author":"释文珦","text":"离城才一舍，已得近樵渔。\n秀石云松路，荒篱水竹居。\n阳坡收早粟，烧地长新蔬。\n便好为兹隐，吾生不愿馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7658,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"行窝吟","author":"释文珦","text":"了无一事可相拘，布袜青鞋信所如。\n乱石荒苔樵子径，竹篱茅舍隐人居。\n山林真乐须还我，朝市闲名不问渠。\n颇谓行窝安乐法，远胜叔夜养生书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7659,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西风","author":"释文珦","text":"西风落叶间，孤客有馀閒。\n寒水皆归壑，秋云不离山。\n鹘翻枯草去，鸦带夕阳还。\n幽趣何人共，柴门祇自关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7660,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西风","author":"释文珦","text":"西风吹鬓鬓成霜，变异无端那有常。\n交友后先同昨梦，老人八十尚他乡。\n书空雁字行疏密，泣砌虫吟韵短长。\n尽是客中秋意绪，谁能对此不凄凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7661,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观禹贡九州历代帝王国都地理图","author":"释文珦","text":"万里江山几废兴，览图真合拊吾膺。\n三王二帝皆难问，两汉六朝何所称。\n此日中原全拱北，异时深谷或为陵。\n看来今古皆如梦，梦境虚无岂足凭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7662,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过山家","author":"释文珦","text":"世外无尘累，幽居趣味长。\n深蹊竹影薄，小圃药苗香。\n水气浮溪壁，山风扫石床。\n频来从此始，莫怪老夫狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7663,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过逸人居","author":"释文珦","text":"尚此高闲久，空林旧径存。\n掩关防俗驾，登阁俯邻园。\n植竹惊初笋，移花过别根。\n幽怀在自得，勿易与人言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7664,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闭户","author":"释文珦","text":"闭户秋风里，寥寥绝往还。\n菊开无俗艳，木落见真山。\n心比孤蟾净，身同野鹿閒。\n困来虽就枕，无梦到人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7665,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"严维石端研诗","author":"释文珦","text":"端溪下岩石，缒凿出重渊。\n温泽非人力，精华得自然。\n龙涎紫霞聚，鹆眼碧光圆。\n玉德终无变，斯文万古传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7666,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初三夜月","author":"释文珦","text":"新月似蛾眉，娟娟止片时。\n辉光虽有缺，轮廓未曾亏。\n三五还应满，寻常那得知。\n人生亦如此，穷达信难期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7667,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初春赓李筼房韵","author":"释文珦","text":"飘零长是客，节物更催人。\n前日方辞腊，今朝又得辛。\n一天回暖气，九陌动游尘。\n心爱青藜杖，多年伴老身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7668,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初夏同赵东阁西里诸公山行闻莺分韵得隔字","author":"释文珦","text":"今日天气清，聊试登山屐。\n共看云外峰，分坐涧边石。\n绝境不逢人，啼莺似留客。\n一声无处寻，还被青林隔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7669,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"别馨桂山","author":"释文珦","text":"与君相见各华颠，握手松间感变迁。\n能记灵山同听日，不疑绛县老人年。\n难寻旧梦悲蝴蝶，替说新愁赖杜鹃。\n无奈匆匆又还别，有诗须寄武康船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7670,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"吴中灵岩寺","author":"释文珦","text":"离宫今作寺，往事日荒芜。\n越女承恩宠，吴王失霸图。\n屧廊斜带岭，香径直通湖。\n莫上琴台望，风烟满旧都。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7671,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"吾心","author":"释文珦","text":"吾心偏向静，物外寄柴荆。\n山意深方好，溪源远自清。\n馀生惟欠死，众虑已皆平。\n隐者宜无迹，人休问姓名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7672,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"吾性","author":"释文珦","text":"吾性本疏狂，难教住帝乡。\n看心忘世界，濯足爱沧浪。\n往事皆如梦，浮生底用忙。\n到头华衮服，不及芰荷裳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7673,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宋氏林园","author":"释文珦","text":"径穿荒草入，门向断河开。\n不是君居此，应无人到来。\n种花逢雨活，接树待春回。\n冷笑求名者，衣间有俗埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7674,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宋饮冰晚过林居","author":"释文珦","text":"山晚少人行，萧萧陨箨声。\n阳光沈树杪，暝色起柴荆。\n过我论幽事，知君无宦情。\n虚名是何物，浊酒且须倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7675,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"忘己","author":"释文珦","text":"身荣如美疢，身退是良方。\n云月皆成趣，悲欢不入肠。\n闲门清昼永，宴坐绿阴凉。\n昔者惟忘物，今焉己亦忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7676,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"忘归","author":"释文珦","text":"久作馀英客，溪山似有缘。\n柳堤便野步，竹寺称幽禅。\n结伴寻沙鹭，忘归笑杜鹃。\n翛然绳检外，颇觉胜神仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7677,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"怀归西国","author":"释文珦","text":"此世为何世，吾身亦幻身。\n固应常邈邈，其可效频频。\n饯日怀乡国，闻莺忆故人。\n得归方始乐，久客厌风尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7678,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"怀安养 其一","author":"释文珦","text":"净土虽周遍，标方必在西。\n一心无彼此，九品自高低。\n久别情无奈，重归路不迷。\n依凭法藏愿，名字欲先题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7679,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"怀安养 其二","author":"释文珦","text":"惟吾与西佛，天性本相关。\n怊怅迷方久，浮沉苦海间。\n三心终不退，上辈必容攀。\n慈念应尤切，提携早共还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7680,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"怀别越中友人","author":"释文珦","text":"白首苍山里，生涯旧已空。\n别离人易远，江海意无穷。\n夜月悲新蛩，秋烟落断鸿。\n遥思来往处，朝暮有樵风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7681,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"怀寄同志","author":"释文珦","text":"垂垂当莫景，每每忆同参。\n金石敦风谊，云山异北南。\n道机应已熟，世梦莫教酣。\n路远难相语，裁诗寄短函。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7682,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"怀寄南陵尉沈道正","author":"释文珦","text":"南陵初作尉，应亦似南昌。\n名在神仙籍，才优翰墨场。\n盗闻无欲止，吏化不欺良。\n交旧如君少，怀思未易忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7683,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"怀隐者","author":"释文珦","text":"逸步脱讥谗，高踪不混凡。\n独甘巢绝谷，人似说游岩。\n自制幽人笔，妻裁隐士衫。\n世交空见忆，无处寄书函。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7684,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"怀溪云壑","author":"释文珦","text":"夜深台殿闭，空室自安禅。\n松顶挂寒月，竹根鸣暗泉。\n理方因静胜，道不在言传。\n溪友同知此，今居何处边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7685,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"旱雨","author":"释文珦","text":"骤雨幡然下，风雷驾疾威。\n乌兼巢穴堕，龙挟水云飞。\n物象回生意，神功解旱围。\n田间喜相语，点点胜珠玑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7686,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"时当末伏暑气愈隆老者殊不能堪而旧业荒残清凉石室无由归隐因赋是诗","author":"释文珦","text":"踽踽复睘睘，谁知远客情。\n衰龄馀六甲，酷暑畏三庚。\n旧业今何有，秋衣亦未成。\n东邻弄羌管，休作断肠声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7687,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"泛富春江","author":"释文珦","text":"梦寐羊裘客，清游乐此邦。\n一篙残腊雨，千古富春江。\n岸转青螺合，烟明白鸟双。\n洗除名利迹，滩濑日舂撞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7688,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"身老","author":"释文珦","text":"身老心仍懒，深栖乐此园。\n饮冰难变节，卧雪不开门。\n八尺藜床软，三重纸被温。\n伤怀惟一事，冻破石陶尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7689,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"身闲 其一","author":"释文珦","text":"身閒日日日高眠，疏牖开于叠嶂边。\n巨竹拂云知地力，细泉鸣玉自天然。\n墙头卢橘金丸重，篱角杨梅火齐圆。\n只与禽猿同此乐，莫教马迹到门前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7690,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"身闲 其二","author":"释文珦","text":"身閒更喜交游绝，三径寥寥草树荒。\n但觉空门无住著，不知尘世有炎凉。\n吟残海月生松壁，定起山云满石床。\n何缘饥渴犹相累，拟觅幽人断谷方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7691,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"远尘","author":"释文珦","text":"忘名忘利人，傲岸孰能驯。\n老去身犹健，閒中乐最真。\n洁修松体貌，清劲竹精神。\n日夕常相对，无缘更有尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7692,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"远游","author":"释文珦","text":"林憩无完室，舟行避恶滩。\n异乡为客久，浮俗定交难。\n草引春愁长，霜侵晓梦残。\n忽闻城角动，归思若为安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7693,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"閒人","author":"释文珦","text":"不求富贵不嫌贫，天地悠悠任此身。\n飞步任教趋要路，好怀到底属閒人。\n自归白屋交游远，认得青山面目真。\n平地退藏知是宝，太行从古有摧轮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7694,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"閒乐","author":"释文珦","text":"祇以閒为乐，宁论是与非。\n安身唯草座，终岁掩柴扉。\n水蓏收菱芡，山粮采蕨薇。\n几回清梦去，还共白云飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7695,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"閒居","author":"释文珦","text":"影不落人间，空门断往还。\n心如灰已死，身与石同顽。\n洗耳清?瀑，支筇静对山。\n老僧閒甚富，谁欲贾予閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7696,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"閒居遣兴","author":"释文珦","text":"无情日月互相磨，万古悠悠一逝波。\n六十四年成事少，八千馀卷费功多。\n山林有志知难变，毁誉无根听自讹。\n近问野人安稳法，教予祇学采樵歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7697,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"閒房","author":"释文珦","text":"閒房近竺岑，四面是清阴。\n涉物皆成趣，无因废得吟。\n蛇蟠枯树腹，雀乳古亭心。\n倘或游人见，犹疑隐欠深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7698,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"麦秋游兴","author":"释文珦","text":"心喜麦秋晴，贪游举步轻。\n泬寥无点翳，山水有馀清。\n怕入红栏队，来寻白社盟。\n应门童子熟，认得老夫声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7699,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和人晚秋客思","author":"释文珦","text":"双毂苦难留，江城又晚秋。\n故乡难寄讯，倦客独登楼。\n衰草重重恨，征鸿字字愁。\n渔翁却萧散，吹笛过前洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7700,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和林静学双兰","author":"释文珦","text":"一本两花新，重滋旧畹春。\n难教入凡梦，唯共保天真。\n沮溺终称隐，夷齐又得仁。\n临风如欲笑，笑著独醒人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7701,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏梅 其一","author":"释文珦","text":"仙姿孤洁甚，不与众芳期。\n的皪临寒涧，凄清闯短篱。\n祗愁风作恶，最与雪相宜。\n野叟心偏爱，莓苔古怪枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7702,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏梅 其三","author":"释文珦","text":"怪怪复奇奇，照溪三两枝。\n首阳清骨骼，姑射静丰姿。\n桃李应非伍，松筠素有期。\n凭他伴幽寂，玉笛且休吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7703,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏梅戏效晚唐体","author":"释文珦","text":"古今人共爱，不独是林逋。\n树老枝方怪，花开叶已无。\n月中香冷澹，雪后意清孤。\n长忆山房外，临溪有一株。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7704,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜气","author":"释文珦","text":"夜气正冥冥，閒人梦已醒。\n上方风磬断，小室雨灯青。\n照镜诸心静，忘缘四体宁。\n胜他名利客，骑马戴寒星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7705,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜归 其二","author":"释文珦","text":"生唯净命食，持钵向人境。\n莫夜归茅庐，月出山愈静。\n处处闻泉声，行行踏松影。\n洗足便安禅，云深石床冷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7706,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜读太玄","author":"释文珦","text":"虚室冷云边，消閒读太玄。\n未须求甚解，聊复竟馀篇。\n夜永残膏薄，天高列宿悬。\n有蓍还懒揲，休咎已俱捐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7707,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"孤山怀圆法师","author":"释文珦","text":"湖水绕孤峰，知曾住此中。\n既伤遗塔变，重惜讲台空。\n鹅护晴池乳，鹰呼古树风。\n唯闻林处士，清节与师同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7708,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"孤客","author":"释文珦","text":"众人皆汲汲，孤客自俞俞。\n方外居来久，囊中物尽无。\n行将筇作伴，讲以石为徒。\n若问何宗旨，饥来饭一盂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7709,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"孤雁","author":"释文珦","text":"孤雁如贞妇，馀生不再双。\n避寒辞北塞，随日到南邦。\n倦翼堪怜影，哀音自满腔。\n空闺人听得，离思转难降。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7710,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"孤踪","author":"释文珦","text":"孤踪不择地，陵上即安陵。\n聊自存吾道，其他无异能。\n禅衣皆芰制，斋钵但藜蒸。\n更喜交游绝，閒房冷似冰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7711,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"废宅","author":"释文珦","text":"昔年誇富贵，磨灭等流尘。\n应是重归燕，难寻旧主人。\n径莎空泣露，门柳不成春。\n唯有同游客，经过感慨频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7712,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]