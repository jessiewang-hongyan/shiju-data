[{"title":"学道","author":"姜特立","text":"学道不须奇，无为胜有为。\n气平无间断，心静自清夷。\n意钓非关饵，行歌不为诗。\n随缘皆自在，何患不期颐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37852,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岩泉别诸弟","author":"姜特立","text":"久矣忘乡井，归人问故蹊。\n无金随力散，有柱把诗题。\n初见心增喜，临分意转迷。\n人生重恩意，去住两含悽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37853,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"林钦之主簿挽章","author":"姜特立","text":"敬读铭镌语，遥知磊落胸。\n义襟如郭震，豪气似元龙。\n万里摧车轴，三春折涧松。\n天虽不可问，馀庆后人钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37854,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"苦热二首 其二","author":"姜特立","text":"寸炬已如灼，积冰殊未凉。\n禦寒终有具，治热更无方。\n坐溜午时汗，狂寻子夜浆。\n如何得邹律，吹下九秋霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37855,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"苦热二首 其一","author":"姜特立","text":"天地无情处，青林不动时。\n扇车热炉鞴，竹簟煖琉璃。\n蝉喘烟生树，蚊饕汗浃肌。\n不知秋后鬓，留得几茎丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37856,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"范大参入觐颇爱鄙作以诗谢之","author":"姜特立","text":"问句石湖老，如将月指标。\n枯中说滋润，高处戒虚憍。\n颇许唐音近，宁论汉道遥。\n正声今在耳，万乐听箫韶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37857,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诗送谯知閤","author":"姜特立","text":"一去丹墀六换春，追寻旧事晃如新。\n屡烦携酒来青邸，相伴同班上紫宸。\n自分此生成死别，岂知今日更情亲。\n飞腾已向风云会，得意应须记故人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37858,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诗悼刘夫人","author":"姜特立","text":"淑德生从积庆门，父兄隐耀更全真。\n共推蜡屐亭前女，雅称玄都观里人。\n鸾镜菱花千叶冷，蟾宫桂树一枝新。\n人生百岁今才半，会有重封贲后身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37859,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"青奴","author":"姜特立","text":"正堪休手足，好事降为奴。\n具眼感君惠，无心真我徒。\n耐寒曾得友，蒙耻恐非夫。\n却羡木居士，盘鸠赐策扶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37860,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"客中元夕","author":"姜特立","text":"病起春工渐有涯，烧灯时节未还家。\n老无筋力追年少，闲有诗篇纪物华。\n风暖欲吹残雪尽，月明不着片云遮。\n山中儿女应思我，孤负江梅几树花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37861,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"幽事","author":"姜特立","text":"幽事春来早，晨兴即启阍。\n扫梁延燕子，插楥护龙孙。\n数日招宾友，先期办酒尊。\n淋漓衣袖湿，不管渍春痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37862,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋晴得雨","author":"姜特立","text":"片云飞白雨，万壑变清秋。\n瓮蚁思新酒，河鱼失旧愁。\n嫩凉生枕簟，爽气入梧楸。\n喜得平安报，天如为我谋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37863,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"胡郎中挽章","author":"姜特立","text":"鸡窗同隶习，雁塔独飞翔。\n荐牍盈丹扆，封章列皂囊。\n锦衣荣梓里，符竹耀江乡。\n三径方谋适，琴尊忽破亡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37864,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"胡彦功挽章中间家事少贬遂谢宾客绝馈饷者三十年已而复振","author":"姜特立","text":"祖风文采秀儒林，父德幽遐玉有音。\n廷尉何妨谢诸客，鸱夷还复致千金。\n门前舆马多英贵，架上图书浩古今。\n欲识遗芳传不朽，伯喈文字在球琳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37865,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"茧庵 初营","author":"姜特立","text":"万物有终始，吾生如幻泡。\n辛勤蚕作茧，来往燕成巢。\n不作蔂梩掩，宁须马革包。\n刘伶行带锸，未免达人嘲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37866,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贺王季发提举挂冠","author":"姜特立","text":"明主尚书识履声，君持闽节复仪形。\n八年可仕不谋禄，七秩及时斯引经。\n肯把清名誇薄俗，只将厚德养脩龄。\n新诗祖送三千首，疏傅当时得宁馨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37867,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贺叶枢密得孙","author":"姜特立","text":"鸾凤难为种，寻常羽族繁。\n共期公入相，又见子生孙。\n衣钵传亲手，箕裘付后昆。\n韦平今远矣，衮衮属高门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37868,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"追送虞察院","author":"姜特立","text":"夜半小溪饮，酒深增别情。\n客随舟共远，诗与雪俱清。\n严濑云木冷，富春烟水平。\n故人相忆处，应过凤凰城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37869,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送丁大卿知庐州","author":"姜特立","text":"寄迹双溪喜盍簪，剖符庐子遽分襟。\n伏波威著羌夷界，叔子恩怀江汉心。\n万里烟尘入长算，二边风月待清吟。\n促归早晚飞丹诏，新雁回时有好音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37870,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送双林益老","author":"姜特立","text":"老鹤精神不受羁，今朝何事又孤飞。\n不依大士双林住，却向东峰小隐归。\n野色草堂开泱漭，晨光日观接熹微。\n此时四脚棋盘上，坐断人间第一机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37871,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送方叔","author":"姜特立","text":"九日相携上翠微，安仁悼内不胜悲。\n琴中只弄无弦曲，歌里聊陈鼓缶辞。\n来岁须为汤䴵约，今朝空过菊花时。\n君家兄弟如相问，为报颐间已素丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37872,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送卢漕","author":"姜特立","text":"昔忝二三子，今俱七十翁。\n西州十年别，南部一尊同。\n我已三径具，君还双鬓蓬。\n便须轻世事，留眼送飞鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37873,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送光孙崇元读书","author":"姜特立","text":"吾儿毛骨已森然，会见排风上紫烟。\n但把文章博科第，便成陆地作神仙。\n胸中滔裕书多读，笔下纵横业要专。\n卜者相期非止此，后生进学在丁年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37874,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送邦达邦操弟同恪赴省","author":"姜特立","text":"二陆平时誉望长，近来小阮亦文章。\n共排云路升天府，稳坐仙舟入帝乡。\n去日渐惊梅萼破，归时同带桂枝香。\n老夫已办酒千斛，细斫菖蒲作贺觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37875,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送邦佐弟归乡","author":"姜特立","text":"昔时俱是一儿童，今日相看两秃翁。\n旧约对床心自喜，新诗入梦句仍工。\n吾衰已觉身如幻，汝老犹疑气吐虹。\n南北相望才数舍，何时更卜一尊同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37876,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送枣阳军使刘似之兼枣阳令 其一","author":"姜特立","text":"四方男子志，当在壮年时。\n民社非轻畀，才猷且小施。\n附庸今列邑，大国古称随。\n莫谓朝廷远，行看召驿驰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37877,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送枣阳军使刘似之兼枣阳令 其二","author":"姜特立","text":"去去樯乌远，何时到汉东。\n官期应岁腊，客路尚秋风。\n大楚风声混，三苗土壤通。\n边头有新句，莫惜寄飞鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37878,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送胡守","author":"姜特立","text":"括苍都志勒坚珉，贤守推公第一人。\n政似龚黄专恺悌，诗如李杜更清新。\n诸司交荐动旒冕，七邑争留号吏民。\n此去定须登省户，老成人物表朝绅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37879,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送徐抚干二首 其二","author":"姜特立","text":"莫嗟骨相未封侯，美恶穷通本不侔。\n文似陈琳须草檄，赋如王粲好登楼。\n时平上幕宜多暇，酒贱清欢亦易谋。\n荔子丹时簪末利，可能无句寄中州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37880,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送徐抚干二首 其一","author":"姜特立","text":"便便满腹贮诗书，狗监何人荐子虚。\n半世一官供偃蹇，群公极力藉吹嘘。\n莫辞去佐芙蓉幕，犹胜閒乘觳觫车。\n文雅风流府中望，它时合在玉堂居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37881,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送谢叔光","author":"姜特立","text":"青阳迫残腊，寒色满江干。\n我有采薪疾，君方行路难。\n来无十日款，去作一程宽。\n翌晚解鞍罢，亲庭足笑欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37882,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送潘叔昌主教清湘","author":"姜特立","text":"酝藉金闺客，风流粉署郎。\n文尝追屈贾，身合到潇湘。\n经术东莱学，才名上国光。\n遐方岂淹泊，云路看腾骧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37883,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重午和巩教授韵","author":"姜特立","text":"屈子沈渊日，年年旧俗忙。\n佳人誇綵缕，稚子竞新裳。\n铙鼓喧渔步，杯盘列象床。\n山翁独无事，燕坐只焚香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37884,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重题八咏楼","author":"姜特立","text":"每到楼中忆沈郎，碑间文字烂生光。\n四时山色藏烟雨，两派波光下夕阳。\n湛辈仅能登岘首，召南元自爱甘棠。\n英游已远空追想，附骥犹堪托短章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37885,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻常伯韩公下世感赋 其一","author":"姜特立","text":"逸轨高标不可扳，风流人物晋唐还。\n胸襟磊落尘埃外，尊酒淋漓笔砚间。\n英气一朝归碧落，高文千古映青山。\n穗帷莫奠知音泪，极目楼边有愧颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37886,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻常伯韩公下世感赋 其二","author":"姜特立","text":"六义湮沦吾道东，敢将见处与人同。\n后生不遇东坡老，前辈今无南涧翁。\n四偈真能垂具眼，瓣香端欲嗣宗风。\n遗编一见如生面，怅望新阡恨不穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37887,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闽中元夕","author":"姜特立","text":"晴色动春晖，春宵三五时。\n无风开菡萏，有月瑩琉璃。\n老境逢佳节，他乡赋小诗。\n囝妻浑勿药，灶妇亦开眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37888,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"恭和御制玉津园诗","author":"姜特立","text":"辇路云开雨脚疏，君王游乐万几馀。\n沧波不尽烟中景，清唱忽来江上渔。\n此日丹青须立本，何人词赋似相如。\n小臣赓载无他语，但咏山河壮帝居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37889,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"旅怀","author":"姜特立","text":"寄迹双溪上，秋声动远林。\n断云流影薄，过雁去痕深。\n旧馆生离思，新愁阙寄音。\n到头俱梦事，俯默一长吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37890,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"烘被诗","author":"姜特立","text":"烘被龟藏六，焞焞梨枣春。\n不唯匀踵息，且以煖腰身。\n扪虱閒寻句，听鸡怕及晨。\n是中有真味，不羡北窗人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37891,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"留题雪峰","author":"姜特立","text":"雪峰未到意先猜，只恐冰崖冻不开。\n多谢天公怜倦客，故将暖律入疏梅。\n龙湫惨淡惊神物，象纬峥嵘逼斗魁。\n顾我区区亦何者，扶藤能为此山来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37892,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"罢刘岩酒库","author":"姜特立","text":"世事升沈侔蝶化，吾生来往更蝇营。\n归心有愧陶元亮，家事当如尚子平。\n岂是木鸡犹有变，故令鸥鸟尚相惊。\n老夫本自无城府，抱瓮何妨过此生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37893,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"致政张教授晚而买妾有女戏赠","author":"姜特立","text":"隐君无妇几经时，暮景鳏居却未宜。\n且喜中郎新有女，岂容白傅老无儿。\n闺中不著玉川婢，天下应传京兆眉。\n无计去陪汤饼客，花卿有子待歌诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37894,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"通守田太尉生辰二首 其二","author":"姜特立","text":"吴头楚尾几名邦，公以循良达舜廊。\n未把勋庸齐寇邓，直将教化继龚黄。\n蠹蠲前政人云乐，最上诸司议曰臧。\n只恐周庐赖弹压，芝泥趣召觐清光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37895,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"通守田太尉生辰二首 其一","author":"姜特立","text":"犀庭渊角凛英姿，褒鄂凌烟想画时。\n建武堂深閒缓带，筹边楼迥静哦诗。\n曾乘神骥参天仗，还插宫花赐宝卮。\n今日北门方借重，九重久已结深知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37896,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄方叔","author":"姜特立","text":"二老论交日，真成百岁期。\n同行双野鹤，得意一山雌。\n病起怜加饭，书来渴寄诗。\n已添新蜡屐，此兴报公知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37897,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄方叔","author":"姜特立","text":"懒过醒心亭，无人作伴行。\n禽鱼皆命侣，松竹亦同声。\n只作留时意，那思别后情。\n连宵怀晤语，心恻未能平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37898,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄恪","author":"姜特立","text":"忽得平安信，新知进学功。\n虑深心更苦，趣静句仍工。\n所贵身无玷，何忧禄未丰。\n望云休作念，正要尔移忠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37899,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄韩判院南涧常伯之子","author":"姜特立","text":"每思南涧一凄然，不见风骚二十年。\n子厚犹能记先友，审言且喜有家传。\n蜩螗声乱无遗响，山水人亡有绝弦。\n海内可能无法眼，直须参取祖师禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37900,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"得雨乍凉","author":"姜特立","text":"老火忽西流，凉飙应蓐收。\n倦怀辞浊暑，爽意入清秋。\n得句新逾洁，炊粳香正浮。\n身閒仍有酒，此外更何求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37901,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"悼何求卿内子王氏川人王丞相夫人母之妯娌","author":"姜特立","text":"名父飞凫席庆长，良人傅粉旧传芳。\n篮舆曾带阳台雨，花院俄沉婺宿光。\n表表门眉看列倩，诜诜兰玉有诸郎。\n不唯綵诰生前宠，更有丰碑自玉堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37902,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"扈驾青城呈刘建昌","author":"姜特立","text":"阊阖门开紫禁通，金栀千炬蜡花红。\n胡为白水渔竿客，也在黄幡豹尾中。\n三径只今荒未了，一尊何日属相同。\n寒儒不恨遭逢晚，犹胜书窗老蠹虫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37903,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚步阡陌见水珠逡逡上沿苗叶月华露彩相映清发倘非真在田间孰知此趣因赋 其一","author":"姜特立","text":"水珠捲苗叶，夕气转阴机。\n浩露添璀璨，明蟾坐发挥。\n静窥关物理，行拂上人衣。\n除却长沮伴，能知此意稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37904,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚步阡陌见水珠逡逡上沿苗叶月华露彩相映清发倘非真在田间孰知此趣因赋 其二","author":"姜特立","text":"月璧上遥巘，水珠生晚苗。\n田家足清旷，野步自超摇。\n有叟谈耕凿，无人说市朝。\n却怜膏火地，车马客尘嚣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37905,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚起喜晴","author":"姜特立","text":"老翁喜晴色，屋角候晨曦。\n圆影才明隙，方晖已鉴帷。\n呼童聊拥褐，得火即舒眉。\n盥栉浑无事，看山就小诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37906,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔舍","author":"姜特立","text":"渔舍枕沧湾，如游赤壁间。\n羡鱼虽迹似，匪钓却心閒。\n松古龙千尺，溪清玉一环。\n无人相伴醉，沙觜弄潺湲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37907,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔舍新成","author":"姜特立","text":"旋规渔舍傍溪山，山转溪回翠竹间。\n閒看羽觞行诘曲，戏拈竿线弄潺湲。\n浮家不入分风浦，归棹休寻落照湾。\n谩说五湖烟浪好，几人险处得心閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37908,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"野步","author":"姜特立","text":"晚来行野色，晴意满江山。\n旧得贫中乐，今于老后閒。\n渊明五柳下，颜子一瓢间。\n此道如能会，孤标不可攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37909,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"野蔷薇","author":"姜特立","text":"拟花无品格，在野有光辉。\n香薄当初夏，阴浓蔽夕晖。\n篱根堆素锦，树杪挂明玑。\n万物生天地，时来无细微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37910,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜岁丰","author":"姜特立","text":"六月禾将槁，天公一雨苏。\n旱时苗化草，稔后米如珠。\n食足安田里，年饥死路衢。\n丰凶才反手，扪腹愧微躯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37911,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜陆少监入京","author":"姜特立","text":"昔人思李杜，长恨不相随。\n遥寄有刘白，同吟惟陆皮。\n物睽终必合，句妙却难追。\n试问长安陌，何如灞岸时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37912,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜雪","author":"姜特立","text":"阴宰弄精神，空中舞玉尘。\n入檐灯影乱，折竹晓声频。\n照幌光侵曙，欺梅气压春。\n老夫贪快赏，呵冻拂乌巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37913,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜晴","author":"姜特立","text":"日出天开眼，云收见物华。\n不餐还自饱，无酒却须赊。\n绿遍千丝柳，红添几树花。\n如何酬造物，烂醉是生涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37914,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"暑退","author":"姜特立","text":"归卧林间十二春，心安日日是良辰。\n家居佛界清凉国，人住仙宫自在身。\n无事入山寻阮客，有时击壤助尧民。\n虽无高行追先隐，毕究田园乐亦真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37915,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渡淮喜而有作","author":"姜特立","text":"船过淮南岸，心如已到家。\n何常异风景，正尔辨戎华。\n病体辞深辙，征衣脱旧沙。\n江南即仙国，何必上星槎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37916,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢杨诚斋惠长句","author":"姜特立","text":"平生久矣服时名，况复亲闻玉唾声。\n便拟近师黄太史，不须远慕白先生。\n巨编固已汗牛积，长句尤能倚马成。\n今日诗坛谁是主，诚斋诗律正施行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37917,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赋莲城堂","author":"姜特立","text":"此是吾邦别洞天，楼台高下白云边。\n鸟声人语相酬答，山影溪光共接连。\n便欲弃家来学道，不须航海去求仙。\n愧无冰雪清新句，且读骚经点易编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37918,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]