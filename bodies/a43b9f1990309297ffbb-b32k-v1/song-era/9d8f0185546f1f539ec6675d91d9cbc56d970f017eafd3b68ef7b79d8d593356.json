[{"title":"憩田家","author":"严粲","text":"昼问田家憩，相呼隔短篱。\n负薪髽引犊，挑菜跣携儿。\n沙井和虾汲，村舂夹稻炊。\n老翁评贵粜，覼缕旧年时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33060,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过江东","author":"严粲","text":"落花时节过江东，浓绿山头间小红。\n野店日长春寂寂，柳阴摇飏酒旗风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33061,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"骑牛图","author":"严粲","text":"乃翁骑牛驴驮儿，松间提挈群童随。\n驴逢短桥儿回顾，牛背推敲了不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33062,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戏友人","author":"严粲","text":"今朝有清兴，无处觅诗人。\n寺占房空锁，窗窥榻有尘。\n寻芳知尚早，报谒未应频。\n只在城中醉，烟云满澹津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33063,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"孤雁","author":"严粲","text":"一雁度岑寂，流空音响哀。\n云沙天地阔，霜雪羽毛摧。\n力小知机早，心危见影猜。\n芦洲迷处所，飞绕正徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33064,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"蒙斋先生赋张通守佚老堂次韵","author":"严粲","text":"拂衣归共白云间，佚老堂中天地宽。\n黄发可教供鞅掌，青山聊足对高寒。\n杖藜行乐春风软，纸帐佳眠晓日团。\n林下未应忘世事，并烦寄语谢家安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33065,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"菊","author":"严粲","text":"寒林色枯槁，粲粲篱菊鲜。\n冷艳无俗韵，孤芳弄秋妍。\n金晶与高絜，未觉阳和偏。\n岂无儿女花，谁能制颓年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33066,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"欧阳道士归自临安","author":"严粲","text":"洞穴云生窗户凉，道人宴坐但焚香。\n向来游遍王侯第，还似山林意味长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33067,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"张辑冯去非话别","author":"严粲","text":"此夕真成别，幽怀欲语谁。\n梅花霜月晓，独起咏君诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33068,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夜读晋书","author":"严粲","text":"南来未省有良图，可更清谈傲五胡。\n抚卷兴怀千载事，一窗风露夜檠孤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33069,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"午憩僧房","author":"严粲","text":"黄尘吹不到禅房，窗纸风翻叶叶凉。\n触热行来牵昼梦，孤蓬听雨下潇湘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33070,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"忆山中","author":"严粲","text":"山中桂香满，无复向来游。\n官事何时了，一年孤负秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33071,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"即事","author":"严粲","text":"僧屋藏深坞，渔舟带远汀。\n谁教双白鸟，来点暮山青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33072,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"野兴","author":"严粲","text":"身闲归未得，野兴日翛然。\n抱牍无来吏，寻诗即散仙。\n杯明松罅月，座引石根泉。\n有客知余意，清风三两弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33073,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"重九后五日游齐山","author":"严粲","text":"官痴缚辰酉，节物如相负。\n兹游未觉晚，黄花落吾手。\n没鸥江自迥，脱叶山新瘦。\n凄凉千载心，西风一搔首。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33074,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"湘中","author":"严粲","text":"千古怀沙恨，凄凉何处论。\n坐看宗国事，安用一身存。\n落叶西风岸，孤舟半夜猿。\n年年江月白，为照独醒魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33075,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寓京城和曾左曹韵 其一","author":"严粲","text":"日日思君君不知，京尘染尽带来衣。\n客心正自伤飘泊，更看湖边花片飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33076,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寓京城和曾左曹韵 其二","author":"严粲","text":"车马声中又日斜，可堪芳草思天涯。\n来时忆别山中桂，今见长安栀子花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33077,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"閒居","author":"严粲","text":"尽日门前草，青青不染尘。\n生书方破卷，幽鸟忽啼春。\n失意成高兴，多閒信懒身。\n不须忧世事，廊庙有经纶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33078,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"观北来倡优","author":"严粲","text":"见说中原极可哀，更无飞鸟下蒿莱。\n吾侬尚笑倡优拙，欲唤新翻歌舞来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33079,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"李贾携诗卷见访贾与严沧浪游","author":"严粲","text":"石屏新卷里，曾得见君诗。\n大册烦来教，平生慰梦思。\n高标去尘远，古调少人知。\n汝与吾宗好，风骚更属谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33080,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"新竹","author":"严粲","text":"树头不动天无风，六月还当日正中。\n唯有满林新长竹，别生凉意袭帘栊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33081,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"月","author":"严粲","text":"只道今宵月出迟，云间不觉上多时。\n夜深花影如清昼，何处山头一笛吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33082,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"二水闻角","author":"严粲","text":"少日乡闾不解愁，閒听画角起谯楼。\n西风依旧阑干月，独自潇湘万里秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33083,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"军行","author":"严粲","text":"野人自说老为农，旧识戎装纸画中。\n近日军行浑见惯，儿童嬉戏学刀弓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33084,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"子陵滩 其一","author":"严粲","text":"西风吹雨暮江寒，想见当年独把竿。\n不是君王思故旧，何人知有子陵滩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33085,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"子陵滩 其二","author":"严粲","text":"一榻从容话岁寒，相忘共作布衣看。\n云台诸子成何事，万古清风一钓竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33086,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"汎湖","author":"严粲","text":"四边天共水漫漫，身在鸿濛缥渺间。\n忽见浮空青一抹，舟中人说是湖山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33087,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"慈湖墨竹 其一","author":"严粲","text":"先生万虑尽空时，元气浑沦可得窥。\n还有发生消息在，挥毫烟雨一枝枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33088,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"慈湖墨竹 其二","author":"严粲","text":"戏笔偶然成此耳，直将造化论锱铢。\n不知茂叔庭前草，有此风烟一段无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33089,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"客里","author":"严粲","text":"客里还来此，寒灯耿独吟。\n一官江国梦，十载草堂心。\n木落秋声小，蛩孤夜思深。\n驱驰空自许，冉冉鬓霜侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33090,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戏诗友谈仙","author":"严粲","text":"君期汗漫游，不敢问所适。\n赠别亦何有，当办鹤一只。\n还疑是凡羽，不任载仙质。\n乘烟宁假此，聊以壮行色。\n淹留非牵俗，应未得良日。\n空令施肩吾，久待问诗律。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33091,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋怀","author":"严粲","text":"秋怀不到梦，历历数寒更。\n坐得楚天白，吟教湘水清。\n残灯摇壁影，片叶坠阶声。\n起看孤城雾，人间事又生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33092,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"初注清湘令寄冯深居","author":"严粲","text":"深居定何处，无便寄声频。\n旧别芝山月，相思楚水春。\n白云生梦远，华发折腰新。\n料得今书到，看题笑故人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33093,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上饶界首伤曾殊","author":"严粲","text":"故人曾此赋梅诗，人共梅花一梦非。\n欲唤青山话前事，西风吹泪湿征衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33094,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋风","author":"严粲","text":"门与姑山对，溪边有故庐。\n别来三径菊，閒却一楼书。\n水碓长腰米，村船巨口鱼。\n秋风归去好，留滞意何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33095,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戏友人","author":"严粲","text":"怪得诗情减一分，知君为学有新闻。\n尘中毕竟閒人少，独自开樽对白云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33096,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"早行","author":"严粲","text":"脩程避昼炎，中夜征夫起。\n虫声荒郊迥，犬吠衡门闭。\n行行月色淡，微霞露天际。\n永怀高卧人，幽梦绕苍翠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33097,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"西湖","author":"严粲","text":"何处春晴好，西湖元巳朝。\n马嘶堤上路，船过柳阴桥。\n敲竹鹤声起，弄泉花影摇。\n坐看游客尽，烟水思迢迢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33098,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闰九","author":"严粲","text":"前月登高去，犹嫌菊未黄。\n秋风不相负，特地再重阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33099,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颜范祠堂","author":"严粲","text":"颜范新祠番水阳，邦人来此识纲常。\n海波澒洞孤峰峭，天宇清明一凤翔。\n英迹重寻馀古帖，高情犹想赋秋香。\n奸谀骨朽今安在，三叹前贤死不亡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33100,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"张德庆挽诗 其一","author":"严粲","text":"擢第家声在，通班宦路亨。\n为亲迟受邑，未老谢专城。\n活计诗书富，岁寒梅竹清。\n閒中将道眼，醉梦笑功名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33101,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"张德庆挽诗 其二","author":"严粲","text":"九秩犹身健，联麾见子荣。\n笏床欢节序，鸠杖话平生。\n世久伤零落，吾犹及老成。\n酸风吹苦泪，一为典刑倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33102,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"调古","author":"严粲","text":"调古人能听，眉长世共妍。\n家山夕阳外，心事落鸥边。\n弟妹知何在，风尘祗自怜。\n孤灯照危坐，不是少林禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33103,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"道傍木犀","author":"严粲","text":"路人攀折半成荒，何似山中自在芳。\n可耐西风相料理，为谁消得许清香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33104,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"示园丁","author":"严粲","text":"种竹宜疏延夜月，浇花须早趁晨阴。\n溪边钓石勤时扫，恐有诗人来醉吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33105,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"舟中夜酌别邓均","author":"严粲","text":"共对船头月，通宵语未终。\n乡关几岁别，笔墨小时同。\n江影高低树，秋声断续鸿。\n相逢浑草草，明日又西东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33106,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"发清湘 其一","author":"严粲","text":"归棹将秋色，三湘是胜游。\n湾回仍小屿，滩过尽平流。\n临水闻僧磬，隈岩隐钓舟。\n江头每佳处，沽酒小夷犹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33107,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"发清湘 其二","author":"严粲","text":"花树移方活，丁宁莫损残。\n待逢春气暖，开与后人看。\n酒任随车载，诗从就柱刊。\n料应吟赏处，说著种时难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33108,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"发清湘 其三","author":"严粲","text":"栽树未花开，其如行色催。\n遥怜今岁雪，谁看一庭梅。\n馀俸刊诗卷，归程卖酒杯。\n轻舟下滩稳，鸥鹭莫惊猜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33109,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"系舟","author":"严粲","text":"古岸人家少，苍茫此系舟。\n闺中今夜月，江上晚风秋。\n一水萦寒梦，双鸿乱远愁。\n湘源知不恶，吾意肯淹留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33110,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夜行舟","author":"严粲","text":"忽报风波息，梢人倚柁看。\n开船星斗转，吹笛水云寒。\n犬吠知村近，乌啼觉夜阑。\n儿童将白石，敲火趁晨餐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33111,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"道中","author":"严粲","text":"客思晓寒凝，初阳树外升。\n气蒸茅屋雪，声裂野池冰。\n倦路行偏远，思山隐未能。\n仆夫愁过岭，遥指最高层。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33112,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"冬日同赵与臻閒过雷园","author":"严粲","text":"地幽元在郭，景好即为春。\n相约同来者，能閒有几人。\n风池行坠叶，晴隙走游尘。\n共尔烟霞契，交情深更亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33113,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄邓均","author":"严粲","text":"题书对残烛，几日到江濆。\n故里经年别，清秋此夜分。\n月昏斜映雨，风细慢移云。\n数雁声初过，知君不寐闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33114,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"任机宜新圃","author":"严粲","text":"小斸烟苔地，春生一笑间。\n亭邀邻圃树，台挹隔城山。\n幽梦壶天晓，清时幕府閒。\n旋移花尽活，容我醉来攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33115,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"岳麓寺 其一","author":"严粲","text":"几层攀石磴，高寺白云边。\n台旧怀人古，泉幽想鹤仙。\n远帆湘浦树，暮角楚城烟。\n长是登临处，沧洲意惘然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33116,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"岳麓寺 其二","author":"严粲","text":"吟到湘江倚钓篷，秋风日日望空濛。\n偶来上到阑干处，却指孤城夕照中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33117,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵菊花山人沈庄可见过之作","author":"严粲","text":"借得山中集，尘埃一半侵。\n读来知句好，老去向谁吟。\n高义先投刺，忘怀肯抱琴。\n茅斋亦相约，樽酒要同斟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33118,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"重过雷园","author":"严粲","text":"静处人来少，园扉本不关。\n寒丛凄古径，落日思空山。\n倚树吟情远，临池立影閒。\n晚林看更好，一抹冷烟还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33119,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"湘川逢故人","author":"严粲","text":"少小□同巷，分携知几年。\n乍逢如未识，相问转悽然。\n月色秋看好，潮声夜听圆。\n醉来共乡语，不觉是湘川。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33120,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"兵火后还里","author":"严粲","text":"十载青山几战尘，还家何处访情亲。\n儿时巷陌今难认，却问新移来住人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33121,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿泽心","author":"严粲","text":"自从孤棹背乡关，几度麻姑梦里山。\n此地不知何洞府，石间松荫水潺潺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33122,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夜发湘城","author":"严粲","text":"西风吹客衣，一舸载书归。\n肯为身谋便，而令心事违。\n橹声江月碎，人影水烟微。\n渐觉寒城远，沈沈击柝稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33123,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪梅","author":"严粲","text":"报道梅边雪未休，披衣晨起上帘钩。\n孤根清健元如许，空为花寒一夜愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33124,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"定王台观雪","author":"严粲","text":"清晨吟思独凭栏，十二楼中白玉寒。\n此地古来风雪里，有人惆怅望长安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33125,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"有客","author":"严粲","text":"有客华阳巾，□□□园竹。\n傲睨若无人，风神动岩谷。\n主人延客语，山中酒新熟。\n饮酣出素书，鸟篆不可读。\n欲问度世诀，长啸振林木。\n轩然别我去，举头但黄鹄。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33126,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"乐斋","author":"严粲","text":"颜巷当年事，同门自少知。\n谁言公子贵，心与古人期。\n望柳寻花意，吟风弄月时。\n人琴无处问，空想考亭诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33127,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"琴","author":"严粲","text":"孤松风下弦秋清，湘江湛湛湘山青。\n一声吹入天冥冥，何处白鹤飞来听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33128,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"菊","author":"严粲","text":"秋篱霜露寒，独立尔良难。\n不作过时恨，从教耐久看。\n风流沾腊蕊，臭味忆骚兰。\n孤淡逢心赏，幽香故未阑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33129,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"大虎头滩","author":"严粲","text":"闻说前滩大虎头，行人愁绝欲回舟。\n世閒多有虚名误，不见钱塘海逆流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33130,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"到清湘","author":"严粲","text":"客里今年月，相逢九处圆。\n行穷湘水际，愁到楚云边。\n屋内烟明路，椽閒瓦见天。\n州城何处是，人指隔山烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33131,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"旋摘盆柑","author":"严粲","text":"金丸手自摘，色味香三绝。\n从来天者全，风韵迥然别。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33132,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"参蒙斋先生","author":"严粲","text":"陋巷颓然号庶几，更无言说最精微。\n何人参了。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33133,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句","author":"严粲","text":"南来知寄谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33134,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]