[{"title":"游稚周和余韵见示复答之","author":"曾丰","text":"韦布穷无滥，轩裳贵莫淫。\n一家兄弟学，千古圣贤心。\n去道不能寸，持身肯枉寻。\n它年凤鸣处，百鸟定皆瘖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77906,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登会稽蓬莱阁读唐宋士大夫诗","author":"曾丰","text":"盘盘矫矫卧龙峰，杰阁峥嵘龙腹中。\n柱脚下悬危踏软，檐牙高豁巧衔空。\n江山互以青相绕，云雾时翻黑自蒙。\n物态任呈千百种，倚栏吾自啸清风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77907,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登浴日堂","author":"曾丰","text":"五更起望大洋东，远水摇苍日涌红。\n旸谷初开群蛰起，咸池一洗万尘空。\n顿令秽浊河沙界，都入光明宝藏中。\n事了不知功小大，列仙谁是狄梁公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77908,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登滕王阁","author":"曾丰","text":"落霞未厌我来频，一度来观一度新。\n出没无时鸥弄暖，飞鸣不禁鹊思春。\n物华几换江如故，沙界常空世自尘。\n料得西山仙隐辈，且怜且笑倚栏人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77909,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答厉季平投诗有怀归乡之意","author":"曾丰","text":"词场凡马洗之空，学海波中得老龙。\n尚韵许人赓白雪，正声惟我识黄钟。\n素王不作无明主，贱子何之可附庸。\n乌鹊正兹徒绕树，鹪鹩还更乞相容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77910,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"腊月被檄下豫章至南安简曹宰 其一","author":"曾丰","text":"拥卧听衙鼓，传呼辍坐曹。\n庭前人迹扫，门外市声鏖。\n馁立雁行少，寒攲马骨高。\n宁教循吏传，书拙不书劳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77911,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"腊月被檄下豫章至南安简曹宰 其二","author":"曾丰","text":"日月迎春急，江山送腊愁。\n岁穷犹被檄，途远更乘舟。\n家累已相逼，官身那自由。\n欲从公款愬，公自郁眉头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77912,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"落南二年无人相牵挽诗几于废罗子琳跫然至止喜而赋长韵","author":"曾丰","text":"冷落江西香火缘，岭南人少问吾传。\n一行水陆馀千里，两岁风花仅百篇。\n句眼竟谁知落处，古囊长是挂闲边。\n獶人常试斲泥手，客里相逢喜欲颠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77913,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢宜黄乐奇卿投诗","author":"曾丰","text":"大初分气入三才，诗与吾生一处来。\n胸次融教成乐国，笔头点出是春台。\n摘君句眼诗三复，撩我吟肠月久回。\n机械相投意相得，交盟不结自陈雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77914,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢黄秀才则惠诗","author":"曾丰","text":"义根理密有馀功，更学商周雅颂风。\n收拾江山开辟后，归藏情性混成中。\n天私北道君心足，鬼发其藏我眼空。\n归与友朋笑相贺，江西后社有人同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77915,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赋桃李花 其二","author":"曾丰","text":"春风已畅上林枝，况得连朝雨发挥。\n越女娇红纯任白，杨妃惩瘦少教肥。\n微风远送难言意，乱蝶潜生不肖机。\n本是钟山瀛渚骨，犹容蜕浊刺空飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77916,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赋桃李花 其一","author":"曾丰","text":"盘根玉岭气形全，擢秀霜林雨露偏。\n倾国笑容斜媚日，恼人香气上薰天。\n禅僧悟道疑为佛，渔父迷途似得仙。\n印可几人成白业，自身宁久垫尘缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77917,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赋梅 其三","author":"曾丰","text":"素妃勇作探春行，红紫踌躇不及争。\n万物莫移天性淡，一毫无累世缘轻。\n雪霜得伴成三白，松竹为群免独清。\n中压群芳外相混，有名常处以无名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77918,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赋梅 其一","author":"曾丰","text":"万物丛中要独行，荣枯不爱与时争。\n翛翛水性云情重，栩栩仙风道骨轻。\n饭颗一时工部瘦，首阳千古伯夷清。\n未言鼎鼐功犹在，虽竟无功也有名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77919,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赋梅 其二","author":"曾丰","text":"作意偷春破队行，横翔捷出不容争。\n窗前纳月神光白，水上乘风縠漏轻。\n违物行归廉士洁，傲时身中圣人清。\n赏音不遇林和靖，也是花经第一名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77920,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"道旁有松为人所刳伐因自吊且慰焉","author":"曾丰","text":"稚时蔚蔚老椮椮，羞与其他木作林。\n独以高风资众望，终为明德累初心。\n不容节抗皇天峻，犹幸根盘后土深。\n自有茯苓堪自寿，愿言黄帝勿幽寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77921,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"韩尚书南涧公之从弟德文为东广常平上幕丙寅八月上旬护印迎新使长李监丞先五日会客于翼然亭余与焉赋三诗 其一","author":"曾丰","text":"西清人表表，南涧迹陈陈。\n麟笔可无托，雁行犹有人。\n姓名知子旧，闻见与吾新。\n自分宁攻苦，相期勿抗尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77922,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"韩尚书南涧公之从弟德文为东广常平上幕丙寅八月上旬护印迎新使长李监丞先五日会客于翼然亭余与焉赋三诗 其三","author":"曾丰","text":"山乡仍水国，玉露更金风。\n置印龟?上，扬鞭马首东。\n勤渠莲幕客，款曲绣衣翁。\n言我坐诗累，至今依旧穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77923,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"韩尚书南涧公之从弟德文为东广常平上幕丙寅八月上旬护印迎新使长李监丞先五日会客于翼然亭余与焉赋三诗 其二","author":"曾丰","text":"白露一旬后，秋分三日前。\n幕中馀暇日，城上肆华筵。\n卓立参天木，横陈扑地烟。\n主人非独答，客笔不如椽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77924,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"感梅有作","author":"曾丰","text":"浪尔逢时早，终然受命孤。\n性便行所独，物忌与之俱。\n巢许耳难浼，夷齐肠莫污。\n十分要相称，太素可为徒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77925,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新淦陆伯仁过我钱塘逆旅中漫出诗篇辄蒙赏音敬赋短章相谢","author":"曾丰","text":"自从删变雅，谁复许离骚。\n顾我知音少，逢君著眼高。\n江山成疾锢，笑语破愁牢。\n勿浪相镌切，姑从痒处搔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77926,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"暇日集越王台","author":"曾丰","text":"著脚卧云室，回头盖海亭。\n水为三面白，山作四围青。\n野鸟馀清哢，幽人得醉听。\n篮舆不容款，馀思渺南溟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77927,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"简艮斋 其一","author":"曾丰","text":"广东漕臣重，本朝名士多。\n梁题年月古，壁记姓名讹。\n画象初何补，濂溪自不磨。\n闻名犹起敬，况睹大冠峨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77928,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"简艮斋 其二","author":"曾丰","text":"得古濂溪派，惟今谢艮斋。\n冥搜穷骨髓，燕坐黜形骸。\n晚景登乌府，秋风立玉阶。\n狐狸无暇问，阊阖莫空排。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77929,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"简艮斋 其三","author":"曾丰","text":"梦里常门下，诗中半广南。\n句成还自诵，愁到与谁谈。\n菊又黄无抵，头今白不堪。\n剩分新著作，洗我瘴边岚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77930,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"简寄幼能弟","author":"曾丰","text":"愧无毫发补于公，老不相饶病见攻。\n夜雨灯窗清苦后，春风枕席黑甜中。\n频餐粥饭长教健，仅活妻儿不管穷。\n饱计须粳醉须秫，为吾蚤策买田功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77931,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"简寄郑将使","author":"曾丰","text":"经史旧家风，薰陶磊块胸。\n书堪干乙夜，学未辍三冬。\n豹略得无用，虎头能不封。\n汉勋留我颂，相许细形容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77932,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"简寄游稚牧昆仲","author":"曾丰","text":"或许伊川到圣贤，弟兄今又学伊川。\n会将不二心传印，还出无双手续弦。\n当道书中无大道，后天易外有先天。\n更思犹合下功处，有一毫遗未大全。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77933,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"简隐居陈公俦伯英","author":"曾丰","text":"士人臭味自薰兰，一度相逢一破颜。\n随牒抗尘吾著急，弄花踏月子偷闲。\n熟眠无梦到槐国，佯醉有人扶玉山。\n李杜吟魂已长往，兴来时以笔追还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77934,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"解任登舟离胥口","author":"曾丰","text":"挈挈离胥口，骎骎到峡中。\n江平无骇浪，船稳不惊风。\n逆水从难上，兼程与易同。\n家人解吾意，呼酒犒篙工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77935,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"解馆归至永丰继善伯熊宝臣敦礼昆仲皆化去","author":"曾丰","text":"新自梅关返葛溪，天心不与我心违。\n市廛城郭依元在，亲戚交游过半非。\n纸上衔犹仍旧署，腰间带已减初围。\n候门童稚倚庐老，幸不空教赋式微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77936,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"触目","author":"曾丰","text":"无我那虞物所侵，从教物与我相寻。\n云头翻墨任浓淡，山顶泼蓝随浅深。\n春色若空疑有著，天工虽巧实无心。\n可怜杜宇空多泪，更笑黄鹂强好音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77937,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"触目","author":"曾丰","text":"笔头纸上两无功，拥被开篷眼自空。\n石脉直寻江脉去，山光元与水光同。\n春随草木高低到，气并乾坤里外通。\n反顾有吾即无物，卓然独立太虚中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77938,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"触兴","author":"曾丰","text":"山向南逾秃，江归下转清。\n鸟那容久立，鱼不及潜行。\n云外雁机动，沙头鹭意萌。\n信为吾道计，切忌太分明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77939,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"路见","author":"曾丰","text":"沿途羁况恶，触鼻野花香。\n贾酒行如失，搜诗坐似忘。\n不能为醉圣，宁敢放酲狂。\n家圃含风蕊，垂聊祇自芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77940,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"辞东庙途中作","author":"曾丰","text":"海近微茫白，山穷次第平。\n固然天远大，加以眼高明。\n草木惊秋意，松先挠客情。\n西风莫相恼，归计此回成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77941,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"颓春涉途","author":"曾丰","text":"曾谓东风意向偏，也从僻处放春妍。\n山山长草青无间，树树成阴绿不专。\n黠兽幽居疑辟地，俊禽高举欲登天。\n物情不一吾何择，出处升沉任自然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77942,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"颓腊献岁之交出赣向韶缅怀偏亲简介弟幼能","author":"曾丰","text":"水出犹谙赣，车行未习韶。\n忍看鸢跕跕，愁听雨潇潇。\n岂不欲歌棣，宁无工颂椒。\n妻儿环坐外，笑语与谁聊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77943,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"嘉泰改元季夏中浣经从武仙尉仙袁君摄县事载酒相劳苦敬赋小诗呈似 其二","author":"曾丰","text":"言别富沙士，回头五六年。\n试询今健否，见谓尚依然。\n效意倾新酿，忘怀诵近篇。\n尚其频记忆，曾此一留连。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77944,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"嘉泰改元季夏中浣经从武仙尉仙袁君摄县事载酒相劳苦敬赋小诗呈似 其一","author":"曾丰","text":"道出武仙县，因依识尉仙。\n貌相交以礼，心自许其贤。\n学问追前辈，功名付晚年。\n汉庭偏用老，归路在凌烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77945,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端午家集 其二","author":"曾丰","text":"戏缠朱綵索，争带赤灵符。\n踏草仍悬艾，包菰更结芦。\n都还痴子弟，半出騃僮奴。\n老病无他好，惟餐朮与蒲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77946,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端午家集 其一","author":"曾丰","text":"自我生壬戌，于今到戊申。\n殊无送端午，独不负嘉辰。\n裹黍金膏冻，糜蒲玉屑匀。\n未能全免俗，杯酒飨家人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77947,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端月上浣","author":"曾丰","text":"玄冬连日太阴凝，酝酿开年满意晴。\n槁植惊春荣意动，孤飞触暖偶情生。\n心无外慕溪南牧，眼不旁观陇上耕。\n桀溺长沮渠辈是，休教知我为将迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77948,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"管文彻通易学自冠入场屋垂老未谐文公诗人品题至成轴","author":"曾丰","text":"世业馀方册，生涯只短檠。\n韦编闲里绝，髀肉暗中生。\n憎达终难免，忧贫似不情。\n诸公题品价，自可比连城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77949,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"静听鸟相喧","author":"曾丰","text":"静听鸟相喧，其中有意存。\n提壶爱宾客，脱裤惜儿孙。\n气结辽城怨，声衔蜀帝冤。\n阿谁能细译，收拾入方言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77950,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"静坐","author":"曾丰","text":"履岁投正月，携家到五羊。\n清明郊外好，朱墨幕中忙。\n得病疑风土，逢人问药方。\n所传非所信，静坐得心凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77951,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"增城丞嘉禾张元辅才过郡辄去未及款曲已而同校艺晋康 其一","author":"曾丰","text":"易学渊源出义方，绪馀犹作汉文章。\n名高未急蓬莱岛，心远宁专雁鹜行。\n纸尾固无勋可策，松间殊有味难忘。\n诸公论荐休闻早，且候珠玑满一囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77952,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"增城丞嘉禾张元辅才过郡辄去未及款曲已而同校艺晋康 其二","author":"曾丰","text":"随牒相逢瘴海边，经从不为小留连。\n蓝田昼短子姑去，彭泽春浓我欲眠。\n近境曾无携具日，殊乡却有对床缘。\n天知道大话长意，借我黄花节以前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77953,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"德庆府城绕以荷池叶楙花繁时环望之红绿无间断号为荷城记以唐律遗后来使君","author":"曾丰","text":"中置金城外玉池，池荷挺拔效芳菲。\n叶争以绿环三匝，花逞其红曳四围。\n龙国缋人供佛座，蛟宫缝氏献仙衣。\n使君未佛且仙去，紫橐朝真红炬归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77954,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"潮到看人发舟","author":"曾丰","text":"潮信犹为小，风声未至雄。\n船轻争向上，江阔敢当中。\n持后柁宣力，当先帆用功。\n区区篙艕桨，罪与素餐同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77955,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"豫章舟中夜坐自遣","author":"曾丰","text":"初月多情出，西山故意遮。\n更遭风激水，而乱客吹笳。\n梦入翩翩蝶，惊闻阁阁蛙。\n违多谐偶少，物理固然邪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77956,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题文晋卿明斋","author":"曾丰","text":"磨砻抆拭费诗书，一点灵光与道俱。\n不缺不圆涵霁月，无中无表澈冰壶。\n真机已熟虚生白，幻法宁容紫乱朱。\n照物之馀时反照，故吾殊不似今吾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77957,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题李子权江月亭","author":"曾丰","text":"太阴元是水之精，与水相宜妙莫名。\n霁夜悬芒翻浪白，澄秋逗彩涌流清。\n冰轮影里山河见，玉鉴光中星斗明。\n万象主人收拾尽，一樽酬罢一诗成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77958,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题李达先静晖轩","author":"曾丰","text":"潇洒一区山四围，朱帘高捲昼阴移。\n三竿已上其谁报，一线初长也自知。\n鼓腹晒书春拍拍，蓬头晞发暖垂垂。\n晴窗大得志机趣，渴爵窥盆更不疑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77959,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题陈宗元拂云轩","author":"曾丰","text":"滩西地不爱其珍，虎豹文章善自陈。\n缥节犹储何尉粉，缃苞不纳庾公尘。\n性高霜雪摧难折，气直风雷拔易伸。\n寄语箨龙无傲主，主家今有似龙人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77960,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题建宁府丹青阁","author":"曾丰","text":"杰观安之险处佳，两崖几欲薄檐牙。\n犹馀隙地盛泉滴，不碍长天放物华。\n缥蚀以缃霜后叶，朱渝其碧水中霞。\n有声画里难为色，色即谓空又一家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77961,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题南浦万乘寺瀑布","author":"曾丰","text":"缅止银崖泻玉泉，似乎有以使之然。\n素虹挟雨斜抢地，澄练披风倒倚天。\n山不曾分青自断，月犹未落白相连。\n掬清咽冷吾能事，老不禁多凛欲颠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77962,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题南康吕丞哦松轩","author":"曾丰","text":"位嫌旁见逼，权忌暗相侵。\n李下无留迹，松间可寄音。\n不平风吊古，无赖雨伤今。\n尽数归君律，随机写此心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77963,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题贵州南山岩","author":"曾丰","text":"崒嵂穷头与汉齐，谽谺深处著招提。\n居焉若寝琼为室，登者如仙玉作梯。\n云窍旁通吞日月，烟萝倒拔挂虹蜺。\n我来已落葛翁后，姑拾其馀细品题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77964,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题戴主簿德成尽得楼","author":"曾丰","text":"楼与主人俱卓然，主人步更与楼迁。\n面前加辟山河地，头上增高日月天。\n指顾大千俄可度，拊循方寸浩无边。\n校雠所得孰多寡，万物支离我混全。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77965,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题盘古山 其二","author":"曾丰","text":"清风扑袂冷飕飕，吹到盘山最上头。\n石室少开嫌俗看，莲花时落任僧收。\n铜人阅世几寒暑，木客嘲风谁唱酬。\n故老相传半疑信，粥盂茶碗慰吾游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77966,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题盘古山 其一","author":"曾丰","text":"太初盘古造乾坤，鬼力神筋擘混元。\n妙果虽圆心不有，凡身已蜕迹独存。\n女娲石带补天色，波利岩馀飞锡痕。\n想与南安白衣老，三生元是一精魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77967,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题谌氏奉先亭","author":"曾丰","text":"大协龟?兆，新成马鬣封。\n雨馀生乱草，霜后拱孤松。\n泣酹春秋酒，颦撞旦暮钟。\n若无翁仲在，谁鉴答恩胸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77968,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题黄武子齐云楼","author":"曾丰","text":"禔栋重檐矫欲飞，与天相近可扪奎。\n晴宵拄月轻烟漠，暝昼撑虹小雨凄。\n燕客乐催雷响落，照筵灯压电光低。\n驭风骑气非渠事，万里青云可以梯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77969,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题曾见卓时思亭","author":"曾丰","text":"自幸知韦布，相期到庙堂。\n一朝天夺鉴，千古地埋光。\n春雨松凝郁，秋风草萎黄。\n德公三酹罢，顷刻九回肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77970,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]