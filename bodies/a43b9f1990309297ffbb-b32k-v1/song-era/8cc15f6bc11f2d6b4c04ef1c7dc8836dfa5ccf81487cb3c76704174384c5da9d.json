[{"title":"与广汉舜山寺分题得申字","author":"彭汝砺","text":"溪山幽隐一闲身，憔悴今随逆旅尘。\n南国浸辽愁似织，北音不至别如新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50248,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鸣佩","author":"彭汝砺","text":"鸣佩即朝天北阙，杖藜且遍水云山。\n周爰所得知无限，更有新诗满箧还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50249,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和都官看雪 其一","author":"彭汝砺","text":"孤城带雪望天涯，潇洒风情自一家。\n景物尚嗟春意满，雨枝零落不成花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50250,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和都官看雪 其二","author":"彭汝砺","text":"朔风吹雪落云端，腊意春容尽苦寒。\n收拾浊醪成一醉，怅无丝竹借馀欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50251,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梅子","author":"彭汝砺","text":"道上人家梅子枝，背春还复叶离离。\n诗翁触物俱归思，不用风前叫子规。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50252,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浮沤","author":"彭汝砺","text":"物物自然非所忧，笑君叹息及浮沤。\n恨无清丽惊人句，尽破凄凉满目愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50253,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"藏舟浦","author":"彭汝砺","text":"花明肥上藏舟浦，水照淮边梦蝶台。\n千里悠悠各春色，可嗟无计共尊罍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50254,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"愁思岭","author":"彭汝砺","text":"少狂千兔秃诗毫，醉看真珠酒滴槽。\n白首不堪论往事，清尊祇可慰徒劳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50255,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"板桥","author":"彭汝砺","text":"西山曲折北溪横，百里中无十里平。\n道路雨馀多可喜，高田一半有秋成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50256,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和仲子中谢寄福州荔圆","author":"彭汝砺","text":"五月南州荔子花，道山杳霭路歧赊。\n谁将长乐陈生笔，写寄于陵仲子家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50257,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"琴渚","author":"彭汝砺","text":"自有澄波照眼明，偶题琴渚亦强名。\n今君应得弦歌趣，愿听渔樵一曲成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50258,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"子育见冰开因去雄州南池想亦泮矣","author":"彭汝砺","text":"应是南湖冰已开，云中想见小蓬莱。\n东君且莫催花发，留待朱颜使者来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50259,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"到雄州不得家书","author":"彭汝砺","text":"马头不是病风埃，相别相望眼不开。\n祇有瓦桥书可附，何缘不寄一声来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50260,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"马上据鞍熟睡","author":"彭汝砺","text":"横槊赋诗人健杀，据鞍著睡我閒生。\n芭蕉居士身犹健，蝴蝶庄周梦不成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50261,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和子育","author":"彭汝砺","text":"殊方无处问平安，怅望衡阳雁未还。\n归马不知山远近，北山未尽过南山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50262,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"妇人面涂黄而吏告以为瘴疾问云谓佛妆也","author":"彭汝砺","text":"有女夭夭称细娘，真珠络髻面涂黄。\n华人怪见疑为瘴，墨吏矜誇是佛妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50263,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"望云岭自古北口五十里至岭上南北使者各置酒三盏乃行 其一","author":"彭汝砺","text":"今日日如昨日日，北方月似南方月。\n天地万物同一视，光明岂复华夷别。\n更远小人褊心肝，心肝咫尺分胡越。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50264,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"望云岭自古北口五十里至岭上南北使者各置酒三盏乃行 其二","author":"彭汝砺","text":"投老不堪行路难，衰迟久合老田间。\n雪霜一意催蓬鬓，尘?多方污病颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50265,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"望云岭自古北口五十里至岭上南北使者各置酒三盏乃行 其三","author":"彭汝砺","text":"白首功名意已阑，正如飞鸟倦知还。\n苍茫杳霭云深处，说是燕然旧勒山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50266,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"望云岭自古北口五十里至岭上南北使者各置酒三盏乃行 其四","author":"彭汝砺","text":"朱颜使者黄金带，铁面将军紫罽袍。\n会道因缘非一日，忘怀彼是即忘劳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50267,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"望云岭自古北口五十里至岭上南北使者各置酒三盏乃行 其五","author":"彭汝砺","text":"五更风雪霁层霄，残月寒星共泬寥。\n道路长如之字转，胡人能以近为遥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50268,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"记使人语呈子开侍郎深之学士二兄","author":"彭汝砺","text":"往来道路好歌谣，不问南朝与北朝。\n但愿千年更万岁，欢娱长祇似今朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50269,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"黎阳大佛高七十尺和颖叔侍郎韵","author":"彭汝砺","text":"百千妙法寄微尘，更向人间见大身。\n何怪黎阳七十尺，当时广倍百由旬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50270,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"途中作","author":"彭汝砺","text":"清晨四句偈，午夜一炉香。\n有见即心境，无时非道场。\n华夷初一致，彼是两兼忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50271,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"记京中伶人口号","author":"彭汝砺","text":"伶人作语近初筵，南北生灵共一天。\n祝愿官家千万岁，年年欢好似今年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50272,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和子育韵 其一","author":"彭汝砺","text":"使者东来说契丹，翠舆却似上京还。\n绣旗铁甲兵三万，昨夜先朝木叶山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50273,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和子育韵 其二","author":"彭汝砺","text":"日夜归心折大刀，羔裘貂鼠岂无袍。\n利名毕竟拟何用，身世由来空自劳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50274,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和子育韵 其三","author":"彭汝砺","text":"玉立风生供奉班，少时绿发照行间。\n今时大半成霜雪，莫把青铜照面看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50275,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和子育韵 其四","author":"彭汝砺","text":"朔风吹雪著人寒，行尽千山复万山。\n旅思乡愁两无奈，不须诗债更相关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50276,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和子育韵 其五","author":"彭汝砺","text":"夜寒灯火照长宵，祇有尘编慰寂寥。\n南北可怜身汎汎，梦归亦苦路遥遥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50277,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"长垣路中寄同官","author":"彭汝砺","text":"七千馀里未百里，一百二程今两程。\n更远此身须会到，长垣明日是危城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50278,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晚风","author":"彭汝砺","text":"晚风吹月上天涯，一夜光寒独自知。\n始信花开俱有意，可言云淡独无思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50279,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次文渊兄韵","author":"彭汝砺","text":"风雨正开棠棣枝，尘埃复隔老莱衣。\n南北分人心欲碎，不堪频望白云飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50280,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同文渊夜坐怀伯兄","author":"彭汝砺","text":"月外征鸿自北飞，溪边流水亦东归。\n相思欲往还多畏，自笑浮生事事非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50281,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寒食日李卿仲求宴芝山刘丞子先以诗献李卿坐客皆和","author":"彭汝砺","text":"急雨不闻枝上莺，春风祇度管弦声。\n花梢日拥千兵出，柳叶低遮五马行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50282,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清明之游子先不与仲求有诗寄之使某次韵 其一","author":"彭汝砺","text":"天上归鸿林外莺，去留各自有离声。\n须知野竹山花拙，不会迟留县尹行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50283,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清明之游子先不与仲求有诗寄之使某次韵 其二","author":"彭汝砺","text":"谁学枝头百啭莺，故临风作断肠声。\n欲迟游骑从容住，还惜征车取次行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50284,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"汴上呈祖道 其一","author":"彭汝砺","text":"扁舟日夜去程谙，道路应须笑我贪。\n月照病身犹汴北，风吹归梦已江南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50285,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"汴上呈祖道 其二","author":"彭汝砺","text":"扁舟暮宿水声中，梦入沧浪狎钓翁。\n柳叶系船留夜月，芦花吹笛倚秋风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50286,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和祖道京淮道中","author":"彭汝砺","text":"马头一日对青山，万里归心插羽翰。\n暮雨晚晴风转急，京淮亦自苦春寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50287,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和祖道募耕者赴西北","author":"彭汝砺","text":"朝廷今日重农耕，劝募招怀有度程。\n四海田畴须垦辟，万箱菽粟看流行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50288,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"舟中载芍药数本 其一","author":"彭汝砺","text":"数枝分得广陵春，行李相看意亦亲。\n风急吹香浑似旧，露浓染色更争新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50289,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"舟中载芍药数本 其二","author":"彭汝砺","text":"御衣黄淡名先贵，襭子红多格已尘。\n归去欲为图画看，却嗟无似赵昌人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50290,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和颖叔游宗华并一绝奉呈","author":"彭汝砺","text":"回环万竹锁烟霞，步履迟留问故家。\n我向利名心最薄，青云合得旧生涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50291,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和游双泉 其一","author":"彭汝砺","text":"投明一雨见年丰，此乐知君与我同。\n左右水声长不绝，却疑身在钓船中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50292,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和游双泉 其二","author":"彭汝砺","text":"薄疑身世近蟾宫，步武虚凉在在同。\n山色远追诗句上，泉声双落酒卮中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50293,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和游双泉 其三","author":"彭汝砺","text":"松柏疏疏吹晚风，清凉分与众人同。\n泉声出自尘埃外，更在千崖万壑中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50294,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过石头镇寄文渊 其一","author":"彭汝砺","text":"夕阳却度石头溪，万事伤怀欲泪垂。\n谢氏游山行着屐，严公送酒立还诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50295,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过石头镇寄文渊 其二","author":"彭汝砺","text":"容颜不少如前日，景物犹多似旧时。\n匹马瞻相无尽意，双泉想像不胜悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50296,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西山道中","author":"彭汝砺","text":"行尽钟陵西北山，篮舆恣意取峰峦。\n明朝未必无风雨，便泼浮云子细看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50297,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"临江驿中庭有大柏因寄颖叔","author":"彭汝砺","text":"林麓山头屋数椽，中庭翠柏上参天。\n庙廊岂不须梁栋，偶置荒幽亦偶然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50298,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"永兴道中有感","author":"彭汝砺","text":"古人何计亦何思，世俗纷纷错自疑。\n天地百年俱梦幻，可能于尔较毫丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50299,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"承示及寄提举大丞相高韵大丞有三点明星半轮月之句因次元韵","author":"彭汝砺","text":"三星半月露孤圆，天地秋深夜气闲。\n光遍三千大千界，即非内外及中间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50300,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"舟行","author":"彭汝砺","text":"长恨城中不见山，舟行饱满看孱颜。\n数家樵舍波澜上，十里钟陵烟霭间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50301,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨霁","author":"彭汝砺","text":"荷花十丈出尘埃，鸥鸟双飞近酒杯。\n雨霁黄云收拾尽，青山还会逐人来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50302,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"月夜","author":"彭汝砺","text":"江湖秋夜月纷纷，溪水吹风作簟纹。\n渔父疑如傲世者，孤舟吹笛入青云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50303,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿舒州境上","author":"彭汝砺","text":"江淮五月水涵涵，稍系扁舟宿翠岚。\n半夜月明风转北，五湖归思满双帆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50304,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨中望皖公山不见因寄提举马大丞 其一","author":"彭汝砺","text":"泊舟欲近皖公山，山在青云烟雨间。\n苍翠不容尘俗见，祇应留着待公还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50305,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨中望皖公山不见因寄提举马大丞 其二","author":"彭汝砺","text":"啼猿飞鹤近孱颜，想见仙翁步履还。\n贾谊行须对宣室，谢安未用忆东山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50306,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"运使仲谋去年冬入钟陵后八日予有鄱阳之行至仲春壬子归后七日仲谋有庐陵之行至孟夏戊申归前端午一日予有丹阳之行书呈运使仲谋丈","author":"彭汝砺","text":"游从每笑未经旬，祇有为僚分已亲。\n自古论交何待久，白头往往却如新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50307,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寒芦","author":"彭汝砺","text":"长芦一片倚江皋，叠叶低枝压怒涛。\n晚雾蔽云寒惨淡，晚风吹雨急萧骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50308,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"泊真州新河亭","author":"彭汝砺","text":"鬓毛垂雪欲毵毵，道路风波老不堪。\n系缆短亭聊自慰，青山数点见江南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50309,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游真州东园惜其将废运使兵部子正近止因寄小诗 其一","author":"彭汝砺","text":"欢声忽自满江淮，知是公车匪日来。\n霖雨会当苏岁旱，薰风正欲长民财。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50310,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游真州东园惜其将废运使兵部子正近止因寄小诗 其二","author":"彭汝砺","text":"公才酬酢有馀闲，六路从容指顾间。\n仁泽但令民共乐，不妨清赏遍江山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50311,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游真州东园惜其将废运使兵部子正近止因寄小诗 其三","author":"彭汝砺","text":"不见当年花木春，丹青台榭欲荆榛。\n簿书到日应无事，会与江山作主人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50312,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游真州东园惜其将废运使兵部子正近止因寄小诗 其四","author":"彭汝砺","text":"渌水荷花一片开，池塘终日少尘埃。\n鸬鹚鸂鶒无穷喜，总拟将迎画舫来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50313,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登山亭","author":"彭汝砺","text":"孤亭叠石入云间，尽见江南近北山。\n羁旅此身长扰扰，不如飞鸟会知还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50314,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"移舟泊通济亭","author":"彭汝砺","text":"隔溪杨柳绿毵毵，晚色迟迟认夕岚。\n细细乱山浑不见，渔灯数点照沙南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50315,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"张君父归家有感","author":"彭汝砺","text":"河可以竭山可徙，我翁不归行不已。\n三往三复翁归止，翁行尚壮今老矣。\n儿昔未生今壮齿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50316,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"予十一月甲申以使来武冈坐茅茨之室逼闾阎之陋无故人往来之乐怀羁旅不足之情于是有游古山之寺在县西十五里而山水俊拔深秀亦有可爱者因留置酒抵暮还驿而作是诗","author":"彭汝砺","text":"淡日沙村晚，霜晴溪路遥。\n蛮人瞻虎节，田父看星轺。\n使指勤咨问，君恩费养调。\n畏途谙跋涉，遗策问刍荛。\n腊近云长暝，春迟雪未消。\n远空低幕帟，叠嶂露琼瑶。\n板屋谁家舍，茅檐何处桥。\n梅香浮远水，藤古上重霄。\n细草眠黄犊，巅崖落皂雕。\n儿童晴出牧，妇女晚归樵。\n樵髻骑吹笛，斑衣行踏谣。\n封疆连五岭，习俗带三苗。\n狐鼠藏溪老，豺狼脱洞骄。\n今当蒙润泽，久已静氛妖。\n歌舞随乡地，耕桑托圣朝。\n威仪欣用夏，姓氏耻称猺。\n僧至不千里，寺名非一朝。\n小亭浮草莽，高阁出苕荛。\n泉细能沾润，峰危欲动摇。\n会观禅味足，还见讲花飘。\n茶汎波无迹，香深篆未消。\n远游贪物象，久客厌尘嚣。\n子美诗千首，渊明醉一瓢。\n倘来淹白昼，轻去恨连宵。\n野色随行李，滩声逐画桡。\n舄归烟漠漠，旌旋雨萧萧。\n淡月生昭旷，青灯照寂寥。\n岁时惟箭激，江海祇萍漂。\n洪井连庐阜，蒲山近斗杓。\n且从周梦去，莫作楚辞招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50317,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"人日","author":"彭汝砺","text":"道衡人日独牵愁，南北胡为一处囚。\n学士诗成应属和，寿阳梅落殆神谋。\n醉思侍宴登丹殿，寒想开箱睹黑裘。\n佳句缤纷飞白雪，雪天宜饮亟来休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50318,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江花四首 其一","author":"彭汝砺","text":"江水挼蓝绿，江花泼火红。\n夕阳幽鸟下，浑似画屏中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50319,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江花四首 其二","author":"彭汝砺","text":"鸥鸟来何事，渔舟到亦迷。\n落花流更远，疑是武陵溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50320,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江花四首 其三","author":"彭汝砺","text":"水近花逾碧，花临水更红。\n鸥飞锦城外，人立画屏中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50321,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]