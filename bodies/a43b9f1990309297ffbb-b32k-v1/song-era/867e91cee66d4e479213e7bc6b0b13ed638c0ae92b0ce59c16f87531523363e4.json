[{"title":"丙戌元夕","author":"晁公溯","text":"刺史敢云乐，今非耆旧初。\n香醪秋露薄，膏火晓星疏。\n岂止君不足，谁能财有馀。\n近闻宽赋敛，明诏议亏除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54802,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"他乡","author":"晁公溯","text":"故国山川安在哉，他乡今复见春来。\n蓬蒿并兴草益茂，桃李不言花自开。\n催促年华似推毂，较量筋力试登台。\n归田尚可扶犁在，明岁当驱俗驾回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54803,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"出郊","author":"晁公溯","text":"寒江多石出，危岸有沙摧。\n短绿行穿麦，高红仰嗅梅。\n故人能共往，胜日可频来。\n春事从兹始，群花次第开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54804,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"出郭","author":"晁公溯","text":"出郭花相引，寻荒草欲迷。\n绿低怜独卧，红缺见莺啼。\n溪石皆堪坐，山醪亦偶携。\n淹留送落日，直过石城西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54805,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"去八月同张文饶考试始遂言集执经问道至今不敢忘因成二诗 其二","author":"晁公溯","text":"通变莫如易，韦编存至今。\n如传仲尼手，尽见伏羲心。\n此去被清问，岂惟蒙赏音。\n要通天下志，观象得惟深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54806,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"去八月同张文饶考试始遂言集执经问道至今不敢忘因成二诗 其一","author":"晁公溯","text":"属者俱被命，敕书黄札光。\n同将舜权量，与较蜀文章。\n投分虽已晚，传经何可忘。\n对床风雨地，长记此升堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54807,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"去通义按刑汉嘉至中岩师伯浑临别于此因成二诗 其二","author":"晁公溯","text":"相送自崖返，忍看骑马回。\n故情真独厚，叠鼓未须催。\n此去无三舍，相留尽一杯。\n风林如惜别，摵摵暮声哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54808,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"去通义按刑汉嘉至中岩师伯浑临别于此因成二诗 其一","author":"晁公溯","text":"惭愧居士屩，远来尊者岩。\n深知烦露宿，径为落风帆。\n潭净鱼堪唤，花残鹿罢衔。\n堂中有耆老，禅病说呢喃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54809,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"四月一日舟中","author":"晁公溯","text":"渺渺无风浪自平，顺流乘晓放舟行。\n汀蘋不与春同老，池草能随梦复生。\n山色向人元不改，年华转景未须惊。\n故人相会无多日，有酒何妨为我倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54810,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"正月二日至九江过陈汉卿","author":"晁公溯","text":"行路伤徂岁，思家伫远情。\n云迷五尺道，春动九江城。\n耆旧无元亮，交游得仲卿。\n尊前见芳草，已似唤愁生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54811,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"汉川","author":"晁公溯","text":"道路通襄野，风烟近楚天。\n地卑荒巨泽，山断见平川。\n舟楫自此去，音书谁与传。\n西南是巴峡，应尽落霞边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54812,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用薛郎所寄示诗三韵 其二","author":"晁公溯","text":"阿传议酒食，察贰更廉空。\n开瓮鸭头绿，磨刀鱼眼红。\n报功他日在，食淡暂时同。\n富贵行自致，圣时无道穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54813,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用薛郎所寄示诗三韵 其三","author":"晁公溯","text":"薛君昔在日，才可齿诸任。\n继世能传业，为文有嗣音。\n千秋当却老，六籍更钩深。\n何以寿吾子，高才无陆沈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54814,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用薛郎所寄示诗三韵 其一","author":"晁公溯","text":"子勿诮毛颖，渠言何使余。\n遥知生白室，谁助杀青书。\n巴墨漆相似，蜀笺霜不如。\n殷勤遣分寄，吾汝与同车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54815,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"白日","author":"晁公溯","text":"白日寒无色，黄流涨未平。\n云低催夕暝，江浊污秋清。\n尚觉物多累，敢期诗有声。\n穷愁今至骨，书或似虞卿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54816,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"白宋瑞","author":"晁公溯","text":"圣主思献纳，诸公专讨论。\n吾生端有命，此去勿多言。\n往泛碧万顷，归来朱两轓。\n江湖自可乐，不必上龙门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54817,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"石判官惠诗用韵为谢","author":"晁公溯","text":"吾宗衰谢尚斯文，长抱遗经教子孙。\n海内世家惭卫史，壁中编简即齐论。\n交游幸得二三子，毁誉当如六四坤。\n肯为清谈饮一石，绝胜杂坐独留髡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54818,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"示犍为李令君","author":"晁公溯","text":"悻直每疾恶，淹留无徙官。\n性虽与物忤，吾独惜才难。\n垂老须闻道，为邦贵在宽。\n君宜念此语，衰鬓各霜残。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54819,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"立春","author":"晁公溯","text":"我来伫立望晴空，目极苍茫万壑中。\n树色昏昏酣霁雾，江纹细细织柔风。\n一行殊俗犹为吏，三揖今年拟送穷。\n闻道东田耕帝藉，惭无赋奏大明宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54820,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"立春有感","author":"晁公溯","text":"岁尽无人访汴州，东风应到未央楼。\n荒垣草没牛羊入，废苑春生雉兔游。\n万里艰难炊剑首，十年流落梦刀头。\n一官何事不归去，空戴南冠泣楚囚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54821,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"节往","author":"晁公溯","text":"节往天始肃，地炎霜尚微。\n静闻木叶下，晴见荻花飞。\n积水蛤犹吠，并邻鸡正肥。\n孤云吾所羡，独有故山归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54822,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"刘文潜以荔子并诗见寄","author":"晁公溯","text":"十里为一候，奔腾南海来。\n封章伯游切，诗句少陵哀。\n异县岁月改，前年霜雪摧。\n筠笼今远寄，珍重手亲开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54823,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"合江舟中作","author":"晁公溯","text":"云气昏江树，春流没钓矶。\n如何连夜涨，似欲送人归。\n乱石水声急，片帆风力微。\n舟师且停橹，鸥鹭畏人飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54824,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岁尽","author":"晁公溯","text":"岁尽馀一候，年侵怀百忧。\n人生汉南树，节物剑西州。\n风榭梅花委，春杯柏叶浮。\n峨眉有佳色，领览为登楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54825,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岁暮","author":"晁公溯","text":"晴峡开寒祲，沧波逗远光。\n年华已衰谢，春意尚微茫。\n久污功曹掾，终惭谒者郎。\n南方诚瘴疠，经月或无霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54826,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"师伯浑用韵复次 其六","author":"晁公溯","text":"筋力何堪道路遥，难陪诸彦侍同朝。\n初无计上三年最，况敢功思万里要。\n北塞单于皆入贡，西山赞普不劳招。\n传闻已卧清边鼓，堑垒长閒守木樵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54827,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"师伯浑用韵复次 其七","author":"晁公溯","text":"日翻蠹简书斋里，往往编摹自汉朝。\n鸡距束毫来武信，马肝琢砚出高要。\n时因抚事歌成相，更复怀人作大招。\n知子山中富吟咏，纵横文力到孙樵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54828,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"师伯浑用韵复次 其二","author":"晁公溯","text":"风俗相传三近古，作成况自圣明朝。\n藏家文字本苍史，继世子孙非黑要。\n近报汉廷频诏下，时闻蜀士有旌招。\n怪君尚尔衣逢掖，独向空山伴采樵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54829,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"师伯浑用韵复次 其三","author":"晁公溯","text":"背郭深通一径遥，奔流坐看百川朝。\n飞来黄鹄陂已复，归去白鸥盟可要。\n益部官曹宁久处，津乡书札近相招。\n此生若有躬耕地，白首甘心老负樵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54830,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"师伯浑用韵复次 其五","author":"晁公溯","text":"东望行都绛阙遥，老来筋力倦趋朝。\n谁能作吏沈簿领，但欲买田书质要。\n雅意庶同高士传，不才难望大夫招。\n津乡旧有先贤宅，过者刍荛莫敢樵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54831,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"师伯浑用韵复次 其一","author":"晁公溯","text":"束书归隐不辞遥，庠序懒陪耆老朝。\n野外卜居无鬼瞰，山中誓墓以神要。\n暂来同作荔枝社，安可轻违桂树招。\n已遣官奴理琴瑟，岂惟百戏但歌樵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54832,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"师伯浑用韵复次 其四","author":"晁公溯","text":"古者诸侯今牧守，衰迟难强岁相朝。\n惟须稚子理蓑笠，兼有老妻缝襋要。\n来岁定从田父去，飞书不待故人招。\n平生最爱津乡聚，江小可渔山可樵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54833,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"师袭卿来权摄峨眉县禄东之来乃去送以诗乃元日也","author":"晁公溯","text":"白水诸山翠作堆，岂令飞舄著尘埃。\n勿嫌屈子峨眉县，正得同吾婪尾杯。\n淑日升堂迎昼永，和风排闼送春来。\n还家尚可为亲寿，柏叶清尊手自开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54834,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"年侵","author":"晁公溯","text":"年侵慵更甚，帙乱卷还舒。\n衰白愁看镜，雌黄倦校书。\n临风知地爽，映日爱窗虚。\n近报畬田粟，洿邪亦满车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54835,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"扫径","author":"晁公溯","text":"扫径通春屐，开林启夕扉。\n浮鸥避人去，轻燕引雏飞。\n尊俎深留客，风尘渐息机。\n不妨坐至晚，少待月同归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54836,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次刘机将仕韵","author":"晁公溯","text":"承平玉烛四时和，处处惟闻击壤歌。\n富国不须搜粟尉，劝民当应力田科。\n使君身似社樗老，故里贤如乔木多。\n今日九原诚可作，吾谁归者有东坡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54837,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次师瑰韵","author":"晁公溯","text":"迩来才力愈衰迟，说向诸公笑脱颐。\n来对老夫何所见，归求文字有馀师。\n相期要作后彫柏，自献当同前列龟。\n莫学一官今潦倒，白头深愧伐檀诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54838,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵李仁甫","author":"晁公溯","text":"北牖厌高卧，西山思胜游。\n诗人少题咏，物色尽分留。\n小憩青城夜，幽寻丹景秋。\n何人与同往，二老实风流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54839,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵杜主簿","author":"晁公溯","text":"平生有志欲归休，老向殊方尚转流。\n五亩桑今如卜宅，千章荻可比封侯。\n几经峡口江水夜，往看峨眉山月秋。\n终恐官曹败人意，不如一笠钓沧洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54840,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵程愿以十诗见示篇中多及故起居舍人程子山老懒姑取其一用韵答之","author":"晁公溯","text":"故乡乔木莫知年，闻道端居似玉川。\n勿谓鲁侯吾不遇，试言卫政子奚先。\n传家学问三冬足，插架文书四库全。\n颇复因君怀柱史，当时高会有群贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54841,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵谢石教授喜雨","author":"晁公溯","text":"天子斋居坐法宫，万方都属指挥中。\n敢安无事思乐泮，方戒有司归在丰。\n每念三农皆望岁，直期九月始休工。\n知君亦喜连宵雨，与涨词源更不穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54842,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵谢张德粹主簿","author":"晁公溯","text":"久知经籍总皆通，万卷纵横在腹中。\n占雨正当求管辂，藏冰更欲问申丰。\n每惭列爵来分土，未办通商与惠工。\n君自还家歌乐职，大碑深刻示无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54843,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵鲜于晋伯清明日过水南 其二","author":"晁公溯","text":"又赋斜川五日诗，行将去此欲何之。\n一年春事仓庚报，万里乡心杜宇知。\n笔力早衰无痛快，词源渐老乏经奇。\n文章子骏惟君似，学到扬州刺史时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54844,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江上","author":"晁公溯","text":"岸冷霜排草，川明月上梅。\n清游诚可爱，深夜孰能来。\n不作寻山去，难成访剡回。\n此生惭野老，过往只田莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54845,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江上","author":"晁公溯","text":"江浅晴沙见，山高细路分。\n老藤维堕石，远树挂残云。\n燕雁遥难到，巴莺暖遂闻。\n花飞少颜色，委地自纷纷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54846,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江上春事","author":"晁公溯","text":"春来江上解霜严，群柏周庐笋出檐。\n突兀狸头蒙紫箨，参差龙甲长苍髯。\n閒思井臼高人宅，懒傍车舆刺史幨。\n留滞殊方忧鵩入，今年试为发书占。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54847,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江上春涨","author":"晁公溯","text":"久坐思行乐，兹晨强出门。\n菰蒲荒少岸，桑柘远知村。\n波急春涛大，山晴午树昏。\n每来成独往，佳处与谁论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54848,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江边 其一","author":"晁公溯","text":"素石寒沙共眇然，荒城古木暮云悬。\n空山静答钟声远，落日晴随树影圆。\n屡报传烽沈塞外，时来倚杖立江边。\n东南耆旧今安否，欲寄新诗谁为传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54849,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江边 其二","author":"晁公溯","text":"江边日日强登台，越柁吴樯久不来。\n投迹东巴留万里，侧身南极望三台。\n公朝遣使丁年去，丞相疏恩甲第开。\n圣主得贤如作颂，微臣愧乏子渊才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54850,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江行","author":"晁公溯","text":"泸南道穷复剑西，桃花浪生行苦迟。\n百丈牵舟上春水，三尺为邦逢圣时。\n平芜细麦绿相映，老树杂花红已衰。\n峨眉山月今始见，令人绝叹谪仙词。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54851,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江雨","author":"晁公溯","text":"江草被霜槁，江云随雨飞。\n稍看沾径湿，故作映空微。\n晓浪初吹浦，春泥未污衣。\n南征羡鸿雁，独有故乡归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54852,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江流","author":"晁公溯","text":"江流日日上平芜，细径侵沙渐欲无。\n袅袅紫苞开露笋，森森青节乱风蒲。\n晴川默数千艘过，深硖遥看一水趋。\n传道南樯有归使，晚来失喜问扬都。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54853,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"池上与师伯浑饮酒","author":"晁公溯","text":"冉冉烟生树，溶溶水满池。\n藻寒鱼不食，花暖蝶先知。\n相对饮凿落，不妨歌接䍦。\n还山何用遽，同过艳阳时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54854,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自恭州之眉阳相送者六客意不可忘以诗为谢","author":"晁公溯","text":"所得乃三益，相从非一朝。\n龙方卧陇底，鱼肯似阳桥。\n月看玉奁满，风吹金烬销。\n少留吾亦住，不待楚词招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54855,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"至日留滞荆渚同邓氏兄弟饮酒","author":"晁公溯","text":"今日当长至，穷年尚远行。\n野晴春草细，江晚夕阳明。\n衰病依僮仆，经过得友生。\n浊醪来近市，坚坐且徐倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54856,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"至汉嘉简李悦夫","author":"晁公溯","text":"一别相望费岁时，盛山父老至今思。\n才高方朔三千牍，名配韦郎十二诗。\n论荐久闻章奏上，推迁独怪玺书迟。\n少留剩看平羌水，更继风流太白词。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54857,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"行役","author":"晁公溯","text":"胡为行役尚殊方，已觉春容近艳阳。\n石齿漱江翻翠浪，蒋牙穿渚出青芒。\n艰难去国成淹泊，老大逢辰倍感伤。\n幕府吾归具朋酒，兕觥犹及享公堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54858,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"行李","author":"晁公溯","text":"路出苍江上，云生乱石间。\n中年幸强健，今日试跻攀。\n湍硖寒鸣地，颓阳暮隐山。\n仆夫问行李，早晚遂东还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54859,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西山","author":"晁公溯","text":"万州城西何所有，高山其下俯寒塘。\n浮鸥藉草溪沙暖，飞鸟冲花野树香。\n他日拟从南岳隐，平生尤爱北窗凉。\n道人为我收松子，剩种清阴十亩长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54860,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观雨","author":"晁公溯","text":"高阁前临野外村，坐看急雨洒山根。\n黑云合沓奔崖暗，白水崩腾赴硖喧。\n已快脩渠通草径，稍清瘴土净柴门。\n晚来更报沧江涨，津北津南没旧痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54861,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过圆觉院简照上人","author":"晁公溯","text":"一洗糟粕地，再闻钟梵音。\n前身老东院，具体小西林。\n自昔知味少，于今无巷深。\n是中有妙理，直下试参寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54862,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别郭安道卢能甫","author":"晁公溯","text":"客路悲秋落木边，江流滚滚尚连天。\n病来懒著登山屐，归去聊乘下濑船。\n回首关河嗟去国，伤心风雨送残年。\n相逢又作匆匆别，拟续阳关第二篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54863,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即事","author":"晁公溯","text":"故国边声静鼓鼙，依然宫阙泪沾衣。\n端门晓日乌声乐，别殿春风燕影归。\n目断楚天嗟树隔，梦回梁苑逐云飞。\n里中父老今谁在，闻说比邻半是非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54864,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"层楼","author":"晁公溯","text":"独立层楼上，遥看众壑中。\n山头冠落日，谷口吸长风。\n云雾吴天接，江湖蜀柁通。\n只今洞庭岸，白浪没青枫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54865,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀子兼弟时在宁江赴试 其一","author":"晁公溯","text":"霸国山河在，秋风草树疏。\n羁游今几日，旅食定何如。\n梦想池塘句，愁消鸿雁书。\n细思治安策，勉力献公车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54866,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀子兼弟时在宁江赴试 其二","author":"晁公溯","text":"江晚微收潦，乘流久已归。\n沈郎正多病，水帝有馀威。\n鸿雁几时到，脊鸰相背飞。\n题书问行李，东望独依依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54867,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]