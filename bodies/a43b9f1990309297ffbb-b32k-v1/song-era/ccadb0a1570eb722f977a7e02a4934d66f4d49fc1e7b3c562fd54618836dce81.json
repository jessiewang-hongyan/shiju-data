[{"title":"世尊乞食归放拄杖以手拄颐坐眠赞","author":"释绍昙","text":"雪岭曾经苦，勤行七佛仪。\n持钵不得食，诈道不闻饥。\n六环锡重，无力扶持。\n飏下拄颐眠一觉，梦中消息许谁知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15188,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"代赞罗汉 其二","author":"释绍昙","text":"靠葛藤桩，握龟毛拂。\n绝学无为，黑山鬼窟。\n直饶瞥转机轮，眼里闻香，耳中观色。\n我且问，瓶内底是何物。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15189,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"代赞罗汉 其一","author":"释绍昙","text":"古桧含烟，青山展画。\n题目分明，何须管带。\n待你炷得香来，鸣磬一下。\n蹉过了也。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15190,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"出山相赞","author":"释绍昙","text":"半夜逾城，六年栖雪。\n饿得眼花，冻得骨折。\n死伎穷时走出山，儿孙开眼被渠瞒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15191,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"出山相赞","author":"释绍昙","text":"六年雪冻不死，见明星便说悟。\n走出山来一窖无，被人唤作赤须胡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15192,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宁藏主省师兄求语","author":"释绍昙","text":"橘州文学石桥书，妙画雄才举世无。\n宗说俱通心眼活，奇哉老蚌出双珠。\n百年凛有遗风烈，行处同途不同辙。\n痴翁真得虎头痴，月峰清照峨嵋月。\n分飞雁影各东西，几对秋风叹离别。\n去去吴天净如洗，淡墨联书形字义。\n且教人道渠和侬，好对难兄与难弟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15193,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"对月了残经赞","author":"释绍昙","text":"是甚经，欠翻译。\n用尽心，看不出。\n看得出，月挂松梢，烟笼藓石。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15194,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"布袋浴江图赞 其一","author":"释绍昙","text":"柳烟羃羃浪粼粼，脱体无依尚染尘。\n辊得通身是泥水，小儿戏剧诳谁人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15195,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"布袋赞","author":"释绍昙","text":"驮布袋，握藤枝。\n一肚皮恶毒，好使你门知。\n转脑回头望阿谁，髯公知此意，冷笑贼风吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15196,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"布袋赞 其三","author":"释绍昙","text":"赤脚走红尘，道是真弥勒。\n买弄臭皮囊，大地无人识。\n无人识，急急回头，已迟八刻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15197,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"布袋赞 其二","author":"释绍昙","text":"紧捉布袋头，片时放不下。\n用尽恶机关，难瞒铁奉化。\n重重败缺几曾知，犹自回头望阿谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15198,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"布袋赞 其三","author":"释绍昙","text":"杖挑布袋，冷笑訚訚。\n肚皮无窖，眼里无筋，走长汀等个人。\n败阙了也，贼精贼精。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15199,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"布袋赞","author":"释绍昙","text":"破布囊，无一窖。\n靠著便憨眠，全不知天晓。\n若言弥勒分身，你且莫来謼我。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15200,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"布袋赞 其一","author":"释绍昙","text":"臭布囊，有甚底。\n才倚靠，便瞌睡。\n不知何日下生，屈数尚馀一指。\n浣盆浣盆，我识得你。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15201,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"布袋赞","author":"释绍昙","text":"内院不肯安店，长汀分甘落泊。\n拄杖不解拈提，布袋徒然倚托。\n肚中计较百般，要睡何曾睡著。\n睡得著，铁奉化人须软脚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15202,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"布袋赞","author":"释绍昙","text":"靠布袋坐，听岩瀑笑。\n手把轮珠，数个什么。\n内院抛离岁月深，忘却来时道。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15203,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"布袋赞 其二","author":"释绍昙","text":"驮布袋，笑訚訚。\n智无一两，肉重千斤，转脑回头等个人。\n率陀归路远，满面是埃尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15204,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"布袋赞 其一","author":"释绍昙","text":"驮布袋，放痴憨。\n回头一笑，捏怪千般。\n走遍长汀人不识，诳言弥勒示人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15205,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"玄峰","author":"释绍昙","text":"极尽幽微裂万差，天然鸟道绝安排。\n欲穷顶?翻身句，妙密中防有险崖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15206,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"石室和尚赞","author":"释绍昙","text":"面孔得人憎，脑中秋月皎。\n做处没瘢痕，用时成要妙。\n见明极透出夜明帘，依圆照烂煨文武火。\n几处移场弄险机，电卷风旋人绝倒。\n夫是之谓石室道人，前身后身，一梦两觉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15207,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"石壁","author":"释绍昙","text":"一方峭峻绝安排，立处还同万仞崖。\n卢老倩人书不得，春日濈濈长莓苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15208,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示日本景用禅人","author":"释绍昙","text":"日本国与大唐国，一片皇风无间隔。\n如将枣叶置针锋，破草鞋跟天地窄。\n上人满腹?疑团，夷夏区分扣牧间。\n老懒不能分说得，隔林春鸟语绵蛮。\n当机为汝分明举，不涉离微急荐取。\n佛祖玄关错踏翻，金乌飞上珊瑚树。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15209,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示宝头陀之径山打钟","author":"释绍昙","text":"劳生梦寐分途辙，深省一声何处发。\n客系枫林半夜舟，僧敲烟寺黄昏月。\n争似凌霄峰顶头，怒鲸吼彻千林秋。\n饱噇眠汉不知晓，有眼如盲还听否。\n我侬会得无闻性，说与头陀终不信。\n不信试归撞击看，风递落花山意寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15210,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"礼云门千岁塔","author":"释绍昙","text":"越山清绝无尘翳，不到胡僧取次埋。\n辄莫更加千岁寿，也须和骨洗将来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15211,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"吕洞宾见黄龙图赞","author":"释绍昙","text":"铛煮乾坤，粟藏世界。\n纵得长生，终成败坏。\n不是黄龙盖覆伊，太阿补履岂如锥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15212,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"延庆化禅观地平","author":"释绍昙","text":"屏息诸缘入定时，脚跟下事烂如泥。\n睦州片板轻担出，禅病蠲除不用医。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15213,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江西宝兄乞东际","author":"释绍昙","text":"当阳一路没途程，剖破藩篱即觉成。\n震旦心宗凌灭尽，到家犹自隔重溟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15214,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西水净土庵奉寄具足孤松老师","author":"释绍昙","text":"闻道虚空曾解讲，信疑往决西山亮。\n烟雨溟濛藓石温，六藏影迹难寻访。\n小径披榛扣竹扉，道人一见笑掀眉。\n布衲横肩瘦如削，口持密语没停时。\n云檐扫榻延居夏，白莲香散东林社。\n涧水松风说苦空，不资中有生清泰。\n殷勤寄问老孤松，具足门中有正宗。\n灼然嫌佛不肯做，凤栖不在梧桐树。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15215,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观知客归葬亲求语","author":"释绍昙","text":"道人观方知彼去，入门要验宾中主。\n吃一杯茶即转身，谁能掉舌论今古。\n危机俊逸旱雷轰，苍鹰折翅猎狗烹。\n老明觉举手加额，韩大伯敢搀先行。\n秋深拨草天台路，灵骨要寻亲父母。\n破钁头边掘窖埋，断猿哭月风号树。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15216,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"达磨赞","author":"释绍昙","text":"远离竺国见梁王，五鬼临身讨苦噇。\n面面相看言不识，秋风一苇急横江。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15217,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"达磨赞","author":"释绍昙","text":"竺乾窃虱屠龙伎，袖隐神锋入南海。\n暨见真龙元不识，九年面壁好羞惭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15218,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"达磨赞","author":"释绍昙","text":"一苇横江，九年面壁。\n直指单传，人信不及。\n面对梁王言不识，泥团乱抛掷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15219,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"佛鉴禅师赞","author":"释绍昙","text":"奸豩顽蛮，更加白㑃。\n文武火煨石要香，麻皮头缠人必倒。\n五处开场弄活机，是龙升天蛇窜草。\n千不合，万不合，凤口山前，乞指路头。\n被老破庵凌辱不少，至今忘却来时道。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15220,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"别山和尚赞","author":"释绍昙","text":"严冷面皮，软顽肠肚。\n对同参唱菩萨蛮，与行家说无义语。\n纵苍鹰搏物机，辟狮子翻身路。\n医衲僧病下天王补心圆，移睹史宫换长庚大火聚。\n虽潜行密用处鹘眼迷踪，点捡将来也是果州饭布。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15221,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"听乌槛角有感送衍上人归乡","author":"释绍昙","text":"黄牛背上乌槛角，声声吹作村田乐。\n低入重渊高入云，拟别宫商都是错。\n断烟明灭柘岗西，这呜咿唤那呜咿。\n天地豁空群动息，野花惊秀不萌枝。\n古今酬唱知何限，记得完全忘一半。\n木人巧弄没弦琴，石女细呈毡柏板。\n年来节奏总输君，听彻无声自返闻。\n一曲还乡人错听，聚头唤作梅花引。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15222,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李翱见药山图赞","author":"释绍昙","text":"天本藏云，瓶元贮水。\n不会看经，那堪指示。\n寄语唐朝李相公，只须著眼听松风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15223,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"灵叟小师悟垓侍者求语","author":"释绍昙","text":"碧落一碑无赝本，非草非真非隶篆。\n镜样渝江彻底清，字义炳然人少见。\n灵叟珍藏岁月深，南来吴越人争寻。\n瘗鹤铭辞匪同调，寒山诗句非知音。\n纷纷问字谁亲切，勾不成勾丿不丿。\n争得卢公赛子云，一肩担荷柴冲折。\n临行密付阿谁边，妙处休云子不传。\n索性扫除元字脚，义天云净月孤玄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15224,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"邻峰艮上人 其一","author":"释绍昙","text":"四十馀年别故乡，梦魂时复到藏王。\n春风九曲溪头寺，桃花翻霞柳弄黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15225,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"净妙室为竹院可都正说","author":"释绍昙","text":"一尘不立所依亡，脱体灵明自放光。\n巨辟三玄三要语，接人无力下禅床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15226,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"周上人求语","author":"释绍昙","text":"忆昔周当仁，手握金刚杵。\n愤气向南方，誓灭诸魔子。\n老婆蓦劄点三心，走入龙潭恨转深。\n扫荡家私无一窖，胡挥白棒到平人。\n牧閒冷坐思高躅，断弦争得鸾胶续。\n扣门听得简州人，倒屐相迎几折足。\n略寒温外问来端，叉手丁宁觅指南。\n未举纸灯明说了，隔窗春鸟语绵蛮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15227,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"坦老求题真歇宏智竹庵同游雁山酬唱真迹轴后","author":"释绍昙","text":"天生三个老冤魔，狭路相逢没柰何。\n□把肚肠搂抉看，曲于四十九盘多。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15228,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宝公赞","author":"释绍昙","text":"折杖头，闲骨董。\n惑梁王，少卖弄。\n鹰巢不至生鸾凤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15229,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"居士看日灵照先化去图赞","author":"释绍昙","text":"这豆娘儿，短头折脚。\n弄鬼精魂，搀先一著。\n看日庞公监本呆，深深好与一坑埋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15230,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"庞婆报儿儿即倚锄立化图赞","author":"释绍昙","text":"小姝先行，老爷踵去。\n无意奔丧，急寻死路。\n哭煞孤孀这老娘，钁头边事难分付。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15231,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"拗云","author":"释绍昙","text":"出头天外便纵横，谁信无心个样生。\n捩调不从龙驾御，要渠西去却东行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15232,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"明月谷血书华严蒙恩宣入内庭","author":"释绍昙","text":"一回?破娘生指，血染春风开杂花。\n香喷龙王宫殿满，胡僧嗅得鼻头喎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15233,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"肩袋过水布袋赞","author":"释绍昙","text":"这汉一生弄险，爱向风波里辊。\n肩个布袋截流，脚下不知深浅。\n劈箭机先，路通一线。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15234,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南山","author":"释绍昙","text":"寿岳名标自古今，万年松矮翠成阴。\n东篱采菊悠然见，珍重渊明眼有筋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15235,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南杨判镇以诗问安次韵","author":"释绍昙","text":"拙养自林泉，鏖战惊蛮触。\n心灰百念寒，虐焰肯停蓄。\n猗欤子云翁，惜我如龟玉。\n无复献楚庭，终期毁于椟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15236,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南桥","author":"释绍昙","text":"渡驴渡马已多时，踏断何妨入水泥。\n赡部洲人争弄险，要渠知有截流机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15237,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"待月赞 其二","author":"释绍昙","text":"末后句，如何举。\n眨得眼来，月圆当户。\n何曾知落处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15238,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"待月赞 其三","author":"释绍昙","text":"末后句，忒分晓。\n眼无筋，觑不破。\n觑得破，心月孤圆，千差一照。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15239,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"律宗玉维那三人礼石佛求语","author":"释绍昙","text":"老倒南山犯真律，三生凿破寒岩石。\n不立名中强立名，弗狼籍处成狼籍。\n儿孙膝下有黄金，拨草瞻风远访寻。\n三拜起来发一叹，方知老子错留心。\n天真自性佛不管，顽石头边讨甚椀。\n费尽钳锤多破绽，乌藤紧捉从头看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15240,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"拾得磨墨赞","author":"释绍昙","text":"面皮顽恶发须松，磨墨元来也不中。\n冷看他人书淡字，不知污得布裙浓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15241,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"拾得磨墨赞","author":"释绍昙","text":"可怜拾得，侧望徒劳。\n墨有消时恨不消。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15242,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挑荠","author":"释绍昙","text":"小奚挑荠携篮去，寻遍颓垣与荒圃。\n根染微黄怯晓霜，叶铺嫩绿滋春雨。\n沙瓶鸣井?寒泉，膏泥濯尽誇芳鲜。\n松风飋飋沸茶鼎，晴窗唤醒幽人眠。\n细嚼甘香凝齿颊，味与首阳薇不别。\n茆舍清贫乐未涯，搜吟况有梅梢月。\n五陵玉箸耽膏腴，岂知菜味天渊殊。\n茶罢筇枝发清兴，山后山前行一转。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15243,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"政黄牛赞","author":"释绍昙","text":"一生孤苦窃诗名，沉醉风烟两眼青。\n黄犊不曾知稼穑，引渠吟得瘦竛竮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15244,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"泉大道赞","author":"释绍昙","text":"赤身跳入毒龙潭，血战知他死几番。\n诤撰出来噇钵酒，郴州六月火云寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15245,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浒眼","author":"释绍昙","text":"万派奔流触断崖，涡漩一窍绝安排。\n渊深彻见灵源底，里许如何著得沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15246,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"草衣文殊赞","author":"释绍昙","text":"被发袒肩，全身入草。\n是真文殊，何须恁么。\n手里底拈不出，觑不破。\n七佛之师，败缺不少。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15247,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贺天童灭翁和尚","author":"释绍昙","text":"老饕八十再生牙，烂嚼虚空吐出滓。\n点缀玲珑岩下草，枝枝叶叶是昙花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15248,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贺顽极和尚住越州光孝","author":"释绍昙","text":"越王城北唐朝寺，千间老屋摧风雨。\n塔影凌空落鉴湖，劫初铃子丁东语。\n久无本色住山人，愁杀檀门许元度。\n剥否穷时复泰来，选差铁面顽翁住。\n倒携无柄苕帚桩，积世狐踪尽扫去。\n就翻鳗井逗曹源，浩浩汤汤流溢江湖无著处。\n岂不胜越人歌来何暮，平生无襦今五裤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15249,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送东川本之太白","author":"释绍昙","text":"万松关险路萦纡，门掩深云窄有馀。\n佛过低头不妨得，且图人见额边珠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15250,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送节操翁住阎寺","author":"释绍昙","text":"早年教海已驰名，破衲青灯究一经。\n不借虚空开口说，肯教顽石点头听。\n宸奎锡命旌梅坞，丹桂飘香供柏庭。\n指日白云禅坐稳，献花无地著山灵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15251,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送老闻归安公","author":"释绍昙","text":"楼至一双粗脚踪，分明弄假却成真。\n去将锹子从跟刬，免踏春泥惑乱人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15252,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送林荆州归蓬莱","author":"释绍昙","text":"蓬莱山翁抱仙骨，稳跨长鲸游八极。\n玉壶深贮海山云，十载穷幽归未得。\n年来骨蜕壶倒空，长鲸又化为苍龙。\n了无一物可依倚，卷舒出没云无踪。\n而今返旆蓬莱去，直欲追寻赤松子。\n与渠击碎大还丹，为渠塞断长生路。\n示之肘后符，佛魔敛衽龙蛇趋。\n授之不传诀，珊瑚枝枝撑著月。\n阿呵呵，胸次风流知几何。\n我分岩扃饱黄独，佳音听取到烟萝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15253,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送勉华严见本师","author":"释绍昙","text":"秦望山前撞老爷，一拳打得鼻头喎。\n衲僧气息都忘了，无复寻香嗅杂华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15254,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"栖岩","author":"释绍昙","text":"拗折瘦藤枝，靠倒险崖句。\n佛祖谩寻踪，无你凑泊处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15255,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"涌溪","author":"释绍昙","text":"平地忽翻千尺浪，吞空沃日势滔滔。\n截流机峻无人荐，谩说茶陵踏断桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15256,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]