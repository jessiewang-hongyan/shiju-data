[{"title":"张子为园林八咏 其八 曲塘","author":"孙觌","text":"一曲清深五月寒，不知中有老蛟蟠。\n雷挝半夜惊飞去，已见天南九万抟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6629,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"巴东使君王梦得挽词","author":"孙觌","text":"谷口声名动帝庭，芝涂一札下西清。\n安车倍道徵杖叔，前席通宵问贾生。\n俊辩澜翻惊辟易，长身玉立看峥嵘。\n飘然比夕骑箕去，那见麒麟地上行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6630,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"枢密周府君挽词","author":"孙觌","text":"少日声名冠两科，弁星争看切云峨。\n回翔禁路联三组，独步枢庭拥万戈。\n饮马直须临瀚海，洗兵端欲挽天河。\n壮怀落落今休矣，急景骎骎可奈何。\n蚁动忽听床下斗，驹跳已向隙中过。\n泉原一闭成千古，有客哀吟只浩歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6631,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"信安郡夫人挽词二首 其一","author":"孙觌","text":"蝉联女公子，汤沐郡夫人。\n籍著金闺密，纶褒衮字新。\n千葩朝阆苑，双剑化平津。\n唧唧虫吟夜，梁空落暗尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6632,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"信安郡夫人挽词二首 其二","author":"孙觌","text":"夫拥侍臣櫜，儿乘刺史轺。\n涧蘋借采采，风棘盛夭夭。\n尚想莱班戏，空留楚挽招。\n魌头引丹旐，千古閟山椒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6633,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"致政沈通直挽词二首 其一","author":"孙觌","text":"门大联三虎，途穷曳九牛。\n一官投绂去，万事盖棺休。\n寂寂兰亭月，寥寥蕙帐秋。\n羊昙他日泪，恸哭过西州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6634,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"致政沈通直挽词二首 其二","author":"孙觌","text":"小隐疏三径，浮荣寓一沤。\n岁阴驹隙过，文采豹皮留。\n不踏邯郸道，聊追汗漫游。\n菟裘应好在，千载寄风流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6635,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和州饯交代赵朝议乐语","author":"孙觌","text":"天涯万里一尊同，醉眼愁看月堕空。\n画角孤吹千嶂晓，綵舟横曳半江红。\n啼妆尽带梨花雨，舞袖犹翻柳絮风。\n只有邦人颂遗爱，棠阴绕屋自茏葱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6636,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"平江燕张节使乐语","author":"孙觌","text":"秋风猎猎卷法旌，贼垒匆匆唾手平。\n笑倚柁楼天上坐，卧闻鼓角地中声。\n九门合遝追锋去，千里欢呼负弩迎。\n从此三吴传胜事，一时草木尽知名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6637,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题琅邪亭","author":"孙觌","text":"十里云烟山绕郭，一川风雨树参天。\n渐看绿笋穿林出，已见新荷弄水圆。\n逐客讵堪分竹使，疲氓正合用蒲鞭。\n郡僚若得岑公孝，便欲烧香闭閤眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6638,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"王相生辰 其一","author":"孙觌","text":"了了三生梦，松根冷锻炉。\n四山朝鹤驾，五老奉龟图。\n萱殿披敷策，星躔焕六符。\n玉笙歌綵凤，革履堕飞凫。\n命世千龄合，承天一柱扶。\n堂堂白虎殿，却走汉单于。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6639,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"王相生辰 其二","author":"孙觌","text":"审象膺商卜，占熊协渭祥。\n金汤蟠万里，杞梓荫千章。\n独斡堪舆大，垂鸿带砺长。\n解弦参虎变，调烛验金穰。\n鼎重开周历，岩瞻拱舜裳。\n太平如有象，仪凤舞跄跄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6640,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"致政朝奉挽词 其一","author":"孙觌","text":"出岫孤云自卷舒，平生心事付樵渔。\n便抽手板还丞相，独把鸱夷载后车。\n扫轨更无云外辙，传家尚有枕中书。\n百年大梦行当觉，日月浑将一醉除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6641,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"致政朝奉挽词 其二","author":"孙觌","text":"床头蚁斗两牛鸣，起起谁呼寝梦惊。\n不用沉文招九死，曾因叩角悟三生。\n取毡卧看偷儿入，折券羞同贾竖争。\n天定胜人端可必，坐看骥子籋云行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6642,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"虎丘","author":"孙觌","text":"冬温阳久亢，一雪意颇快。\n乘兴泛扁舟，出郭信如迈。\n放棹得虎丘，恍然银色界。\n瑶山夹细径，琼树偃曲盖。\n引步到层楼，极目吴城隘。\n飞鸾翔空中，千峰幂天外。\n暗虚云可凌，寒重酒易解。\n群儿庆老翁，于此气不惫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6643,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"帝城上巳","author":"孙觌","text":"宿雾消神沼，晴曦照碧峰。\n祓除周故事，环宴楚遗风。\n画舸低摇鹢，浮梁冷亘虹。\n五陵驱群少，三殿锡鹢公。\n浪射簪缨润，花迎剑佩红。\n舞迟歌袂稳，飞急酒觞空。\n淑气雕轩外，祥光禁籞中。\n敢赓元首咏，上记帝尧功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6644,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"端午日帖子词 皇帝閤六首 其一","author":"孙觌","text":"薰琴应律南风暖，漏箭添筹昼刻长。\n谁识广寒天上景，铜乌未午送微凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6645,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"端午日帖子词 皇帝閤六首 其二","author":"孙觌","text":"炎日曈曈照殿楹，幅员万里塞氛清。\n汉家自有安边术，不是灵符解辟兵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6646,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"端午日帖子词 皇帝閤六首 其三","author":"孙觌","text":"方更仲律清和节，正是南讹化育时。\n无限元元齐歌舞，恤刑新诏下天墀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6647,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"端午日帖子词 皇帝閤六首 其四","author":"孙觌","text":"露畹撷兰苕，金波丽碧霄。\n早闻彫辇降，还待紫宸朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6648,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"端午日帖子词 皇帝閤六首 其五","author":"孙觌","text":"内苑属嘉辰，初收百药新。\n预知氛疠息，天意在生民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6649,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"端午日帖子词 皇帝閤六首 其六","author":"孙觌","text":"浅囿含桃老，雕盘角黍香。\n九重端扆处，星火正离方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6650,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"端午日帖子词 皇后閤五首 其一","author":"孙觌","text":"蟠桃映砌晨烟薄，紫桂凌霄昼露晞。\n窈窕汉宫三十六，齐将綵缕祝坤闱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6651,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"端午日帖子词 皇后閤五首 其二","author":"孙觌","text":"暑服初颁五柞宫，内墀佳气郁葱葱。\n须知海宇升平事，半是关雎辅佐功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6652,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"端午日帖子词 皇后閤五首 其三","author":"孙觌","text":"方均宝笈千龄药，又赐金盘五色瓜。\n从此仙源深福远，绵绵不独颂周家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6653,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"端午日帖子词 皇后閤五首 其四","author":"孙觌","text":"浴兰同故事，戏草楚遗风。\n不是天家意，勤劳念女红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6654,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"端午日帖子词 皇后閤五首 其五","author":"孙觌","text":"洞户花阴浅，天阶日景迟。\n粽成八九子，缕结就千丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6655,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"端午日帖子词 夫人閤五首 其一","author":"孙觌","text":"杳杳画梁巍架杏，沉沉香壁静涂椒。\n宫前夜祝君王寿，日上黄炉炷未消。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6656,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"端午日帖子词 夫人閤五首 其二","author":"孙觌","text":"交飞寿斝长生殿，竞泛仙舟太液池。\n不似世间多暑气，天风淅淅万年枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6657,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"端午日帖子词 夫人閤五首 其三","author":"孙觌","text":"辟恶何须荆楚艾，蠲炎不待邵平瓜。\n仙飙昨夜来阊阖，玉宇清凉大帝家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6658,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"端午日帖子词 夫人閤五首 其四","author":"孙觌","text":"画阁方裁扇，寒塘又凿冰。\n蓬壶山四彻，何处是炎蒸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6659,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"端午日帖子词 夫人閤五首 其五","author":"孙觌","text":"仙宇赐符时，仙蓂叶尚稀。\n晓来金屋静，同侍玉皇归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6660,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过沈仲嘉园亭题赠","author":"孙觌","text":"包山美人构亭子，岿然屹立深园里。\n窗近断岩见怪石，壁临绝涧闻流水。\n亭中一架古人书，知是群经及诸史。\n桐叶滴露下阴砌，橘花随风飘静几。\n美人素厌世俗语，有语利名须洗耳。\n衡门反关高枕眠，红日三竿犹未起。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6661,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠善庆堂主人夏元富","author":"孙觌","text":"居士藏修洞庭野，新架虚堂殊潇洒。\n闲门开傍橘柚林，万颗千株映青赭。\n居士优游每不出，左列图书右盏斝。\n逢迎自觉青眼众，来往应知白丁寡。\n莓苔经雨上石砌，萝薜迎风拂檐瓦。\n素闻平生剩积善，馀庆当传累世下。\n醉挥健笔赋新诗，辄赠堂中乐居者。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6662,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句","author":"孙觌","text":"噬脐有愧平燕日，尝胆无忘在莒时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6663,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 艮岳","author":"李质","text":"势连坤轴近乾冈，地首东维镇八方。\n江不风波山不险，子孙千亿寿无疆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6664,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 介亭","author":"李质","text":"云栈横空入翠烟，跻攀端可蹑飞仙。\n介然独出诸山上，磊磊排衙石满前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6665,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 极目亭","author":"李质","text":"千里飞鸿坐上看，山川风月在凭栏。\n不知地占最高处，但觉恢恢天宇宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6666,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 圌山亭","author":"李质","text":"轩楹正在翠微中，欲雪云生四面峰。\n璀璨地铺红玛瑙，巑岏山耸碧芙蓉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6667,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 跨云亭","author":"李质","text":"地高天近怯凭栏，下视浮云咫尺间。\n只怪轻雷起岩际，不知飞雨过前山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6668,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 半山亭","author":"李质","text":"凭高玉辇每从容，中路尝闻憩六龙。\n尘外有人如到此，便须行彻最高峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6669,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 萧森亭","author":"李质","text":"晓日玲珑宿雾开，四檐时有好风来。\n不应班竹林中见，却似松根琥珀堆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6670,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 麓云亭","author":"李质","text":"山下深林起白云，白云飞处断红尘。\n伴行直到高峰上，舒卷纵横不碍人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6671,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 清赋亭","author":"李质","text":"四海熙熙万物和，太平廊庙只赓歌。\n欲追林下骚人意，却是临流得句多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6672,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 散绮亭","author":"李质","text":"断虹飞雨过天涯，碧落浮云不复遮。\n明日阴晴真可卜，倚栏来此看馀霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6673,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 清斯亭","author":"李质","text":"天波万斛泻镕银，跨水横桥丽构新。\n但取真堪濯缨意，玉阶金阙本无尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6674,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 炼丹亭","author":"李质","text":"药炉龙虎正交驰，五色云生固济泥。\n凡骨欲逃三万日，君王曾赐一刀圭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6675,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 璿波亭","author":"李质","text":"水影摇晖动碧虚，日华凌乱上金铺。\n安知不是鲛人宝，往往渊中得美珠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6676,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 小隐亭","author":"李质","text":"古木回环石路横，居山初不在峥嵘。\n圣人天下藏天下，小隐聊为戏事名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6677,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 飞岑亭","author":"李质","text":"微云将雨洗层峦，石磴莓苔路屈盘。\n正是江南最佳处，仰看苍翠俯澄澜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6678,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 草圣亭","author":"李质","text":"落笔纵横走电光，近臣时得赐云章。\n龙盘凤翥皆天纵，渴骥惊蛇不足方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6679,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 书隐亭","author":"李质","text":"吾皇圣学自天衷，载籍源流一一通。\n宵旰万机营四海，更将心醉六经中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6680,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 高阳亭","author":"李质","text":"仙舟时倚碧溪湾，花外青旗映浅山。\n不醉阆风缘底事，要看豪饮似人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6681,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 噰噰亭","author":"李质","text":"圣主从来不射生，池边群雁恣飞鸣。\n成行却入云霄去，全似人间好弟兄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6682,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 忘归亭","author":"李质","text":"玉景金霞长不夜，松篁泉石更留人。\n广寒宫殿秋偏好，待看林梢月色新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6683,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 八仙馆","author":"李质","text":"蟠桃初熟玉京春，圆屋如规户牖新。\n尽是瑶池高会客，岂容尘世饮中人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6684,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 环山馆","author":"李质","text":"峰峦回合耸云屏，岩霭溪光面面横。\n开户忽惊千仞翠，凭高方见九重城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6685,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 芸馆","author":"李质","text":"玉堂金马尽名儒，黄本牙签付石渠。\n向此别藏三万卷，不忧中有蠹书鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6686,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 书馆","author":"李质","text":"莲烛词臣在外庭，青钱学士已登瀛。\n回廊屈曲随岩阜，挟策何妨取次行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6687,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 萧闲馆","author":"李质","text":"书草吹来种种香，好风移韵入松篁。\n丹台紫府无尘事，倚觉壶中日月长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6688,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 漱琼轩","author":"李质","text":"浅碧分江入众山，山深无处不潺潺。\n开轩最近寒溪口，喷薄松风响佩环。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6689,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 书林轩","author":"李质","text":"甲乙森然尽宝书，校雠曾授鲁中儒。\n万几多暇时来此，玉轴牙签自卷舒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6690,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 云岫轩","author":"李质","text":"山上飞云片片轻，云山相似倚空明。\n从龙本合封中去，触石光从望处生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6691,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 梅池","author":"李质","text":"玉钿匀点鉴新磨，香逐风来水上多。\n应为横斜诗句好，故教疏影泻平波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6692,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 雁池","author":"李质","text":"暮天飞下一行行，浅渚平沙足稻粱。\n有此恩波好游泳，何须辛苦去衡阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6693,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 砚池","author":"李质","text":"黑云凌乱晓光凝，气接昆崙冷不冰。\n龙饼麝元皆御墨，游鱼吞却化鲲鹏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6694,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 林华苑","author":"李质","text":"连云复道映楼台，茂苑奇花日日开。\n但得如春天一笑，芳菲何必晓风吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6695,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 绛霄楼","author":"李质","text":"翼瓦飞甍跨阆风，捲帘沧海日曈昽。\n佳时自有群仙到，笑语云霞缥缈中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6696,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 倚翠楼","author":"李质","text":"梯空窗户半山间，滴滴岚光照画栏。\n六月火云挥汗日，云来唯觉石屏寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6697,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 奎文楼","author":"李质","text":"龙蟠鳌负出风云，镂玉填金圣制新。\n自与六经垂日月，更令群目仰星辰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6698,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 巢凤阁","author":"李质","text":"朝阳鸣处有亭梧，争似珠帘映绮疏。\n丹穴来仪听九奏，不妨于此长鹓雏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6699,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 竹冈","author":"李质","text":"苍云蒙密竹森森，无数新篁出翠林。\n已有凤山调玉律，正随天籁作龙吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6700,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 梅岗","author":"李质","text":"阔连峰岭玉崔嵬，春逐阳和动地来。\n不似前村深雪里，夜寒唯有一枝开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6701,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 万松岭","author":"李质","text":"苍苍森列万株松，终日无风亦自风。\n白鹤来时清露下，月明天籁满秋空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6702,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]