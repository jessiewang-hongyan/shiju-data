[{"title":"凝翠堂 其一","author":"刘攽","text":"檐前老竹生无数，座上清风处处来。\n俗客不知看好鸟，红尘无复污苍苔。\n儿童戏扫黄金影，茗饮时倾碧玉杯。\n会待秋霜坚草木，简书羌管倩人裁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41103,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"凝翠堂 其二","author":"刘攽","text":"绿竹参差平拂檐，疏阴掩映似重帘。\n留径人谁识蒋诩，开窗吾拟学陶潜。\n古墙莓苔有石色，长夏江山如火炎。\n避地真宜近幽僻，悠悠笑谢岁华淹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41104,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"刘九经","author":"刘攽","text":"白首儒先困一经，此君年少独声名。\n早知刘氏无蚩者，深信宣尼畏后生。\n贾谊尚为门下掾，终军仍许出关行。\n限年选举今留滞，跃马赢粮见子情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41105,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送隐直","author":"刘攽","text":"齐楚分飞岁月迁，微官落拓竟依然。\n青云可愿已三仕，白首几何频十年。\n自昔弹冠深有意，到今同病祇相怜。\n阴风朔雪河梁别，乘兴仍思访戴船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41106,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送李士宁山人","author":"刘攽","text":"帝城车马日喧喧，物外相从意爽然。\n自有药壶容到客，独摩金狄叹流年。\n高秋天幕收零雨，清露风林嘒暮蝉。\n曾愧丹砂为狡狯，更谈沧海变桑田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41107,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄彦猷移镇钱塘","author":"刘攽","text":"紫垣清切拥钩陈，阁道分明绝汉津。\n未怪灵槎滞吴会，祇堪藏剑动星辰。\n怀金纡组临乡社，酾酒椎牛宴里人。\n行乐从来多壮观，秋风莫使鬓华新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41108,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"平山堂","author":"刘攽","text":"危栋层轩不易攀，万峰犹在户庭间。\n长空未省浮云碍，积翠如遮去鸟还。\n寡和阳春随白雪，知音流水与高山。\n吴中辩士嗤枚叟，漫说观涛可慰颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41109,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和秘书省林舍人校书寓兴五首 其一","author":"刘攽","text":"客尘作业通三世，儒墨分流至九家。\n投阁何妨惟寂寞，起予仍自悦纷华。\n梦缘酒食逢刍狗，兆应钱财属火花。\n安见高人捐外累，独超无有蹑云霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41110,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和秘书省林舍人校书寓兴五首 其二","author":"刘攽","text":"百缘不信皆前定，千古相矜尽小才。\n梦月豫占沙麓袭，建章如待柏梁灾。\n朱英强欲希无妄，苌叔空劳射不来。\n闻道蓬莱更清浅，便应沧海起尘埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41111,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和秘书省林舍人校书寓兴五首 其三","author":"刘攽","text":"勇夫常作三军获，辩士多从五鼎烹。\n到了是非皆妄想，不缘侥倖亦无名。\n小山丛桂容招隐，负郭良田任耦耕。\n倚伏会应齐北叟，朱愚那复问南荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41112,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和秘书省林舍人校书寓兴五首 其四","author":"刘攽","text":"事缘难易始相成，楹直宁当企栋横。\n坐论岩廊从自贵，退栖林壑未为轻。\n俗情熠耀阴中火，世路摴蒱马外坑。\n要使襟怀似云月，太虚无处不偕行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41113,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和秘书省林舍人校书寓兴五首 其五","author":"刘攽","text":"缩手旁观哂汗颜，未知才与不才间。\n劳生精卫填东海，多事愚公移北山。\n语道此身甘发白，息机他日赖心閒。\n良金百炼才成器，跃冶无如铁石顽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41114,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"黄朝议赐紫","author":"刘攽","text":"长年金紫最相宜，晚达非干入手迟。\n白发闵劳官职事，赤松元作帝王师。\n鱼衔印钮丹鳞舞，鹘勘袍花烂椹垂。\n少似主恩崇旧德，挂车无异立朝时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41115,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"回致仕董中允","author":"刘攽","text":"富贵致身良独难，寄书空复走长安。\n谁能东郭双穿履，径出都门一挂冠。\n家事田庐随几杖，君恩班序接鹓鸾。\n颜生尚少时无用，长铗因公慨屡弹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41116,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵酬濮倅李郎中见寄","author":"刘攽","text":"相见无期得寄声，更怜诗语独丁宁。\n驱之老马尚知道，行矣泥龟甘不灵。\n半百光阴头总白，二三朋旧眼偏青。\n芳春樽酒何由共，怅望东郊长短亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41117,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答仲冯宿兴庆池作","author":"刘攽","text":"车马还城君肯留，通宵欢语破离愁。\n水风杨柳猛消暑，沙雨芰荷潜造秋。\n惊月禽栖时落树，避灯鱼鬣暗冲舟。\n天明红日骊山道，陈迹依稀似梦游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41118,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游凝祥池饮","author":"刘攽","text":"柳绿蒲新小曲江，洞门岑寂闭仙幢。\n波心殿影遥相况，花底禽声各自双。\n薄俸犹能偿酒券，老年无事守书窗。\n街头月色缓归去，调笑相随白玉缸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41119,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同都官游左山晚归泛舟城濠呈座客","author":"刘攽","text":"忆过西湖上虎丘，雪霜乘兴偶来游。\n苍崖古木见僧刹，落日微波迎画舟。\n从道前尘都妄想，亦逢清境为淹留。\n座中同是东南客，试说风烟似彼不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41120,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初春后园","author":"刘攽","text":"杂树无行小径开，新阳留客去频回。\n梅花著蕊南枝暖，柳带牵丝春事催。\n池面水光如照镜，城头山色胜登台。\n长年慵懒遗诗句，无奈风烟引兴来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41121,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄人","author":"刘攽","text":"子云投阁为奇字，君山杀身非谶书。\n埋狱谁能知匣剑，焚城何意祸池鱼。\n赐玦应知谢冠佩，杖藜自尔就田庐。\n丈夫盖棺事乃已，白发勿羞樵与渔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41122,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重次新字韵寄子瞻公择","author":"刘攽","text":"古来苏李有三人，今复齐名事亦新。\n秀出文华喧右蜀，指挥能政接东秦。\n定交笑我将迎拙，垂老于君意气亲。\n似向荆山逢珏玉，如从渥水就骈驎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41123,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晁美叔前寄知字韵诗别求予诗既已和前篇因复用前韵作一篇寄晁","author":"刘攽","text":"促轸危弦音最悲，伤心那得世人知。\n由来入室升堂者，意在高山流水时。\n与子径为竹林宴，到今长记角弓诗。\n文昌近极官清贵，不负羔羊及素丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41124,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄熊伯通","author":"刘攽","text":"窜逐衡湘一病翁，望乡愁对祝融峰。\n不同桂管为元帅，闻道苍髯益壮容。\n岭水分流清注北，雪花成片更宜冬。\n丈夫生死论交地，书札宁当向我慵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41125,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"原父兄近别入都寄此诗","author":"刘攽","text":"水乡春尽事何如，绿树阴成谷雨初。\n杯里尚馀寒食酒，城中已卖鲙残鱼。\n近来慵懒非常甚，别后嬉游益便疏。\n省事只图千日醉，劳心不读五车书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41126,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄王宗杰","author":"刘攽","text":"谋拙材疏懒是真，岂堪为吏走风尘。\n已知富贵非吾望，欲以诗书老此身。\n为问折腰从斗米，何如白眼看时人。\n闻君高卧辞冠冕，多幸佯狂亦有邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41127,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄张四","author":"刘攽","text":"天下风尘日可叹，岂惟西域与南蛮。\n举世相争蜗角里，此身无事马蹄间。\n力耕可以得饱食，从仕于今真厚颜。\n相劝休官勿待漏，卜居终近虎丘山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41128,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"嘉祐末予始为学官同舍六人后二年间钱醇老为秘阁校理杨之美出判颍州刘隐之姜至之麻仙夫李景真相次为王宫教授曩游无复留者初秋夜直偶书寄杨之美","author":"刘攽","text":"夷路驱车势易奔，青冥纵翼自孤骞。\n求为散木甘无用，正似灵光幸独存。\n汗简老生跻璧府，曳裾贤傅遍王门。\n子云寂寞经同病，会待庭枝看有孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41129,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄仲冯","author":"刘攽","text":"终南秋雨色如新，旧国登临易思人。\n废塞池台馀气象，埋藏金玉见精神。\n三公七相空丘垄，万户千门尽棘薪。\n安得身随飞鸟翼，相从谈笑折西宾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41130,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄馆中僚旧","author":"刘攽","text":"落帆江浦念睽携，远迹勾吴不自知。\n鼠穴祇缘衔窭薮，属车空羡载鸱夷。\n黄云海色迷仙境，丹叶秋风感鬓丝。\n为诵延年五君咏，敢论平子四愁诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41131,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄刁景纯","author":"刘攽","text":"使君归老意逍遥，黑发苍眉见后凋。\n自力登山不扶杖，等閒留客亦通宵。\n万松乔木参云日，百顷春苗浸海潮。\n径欲从公十日饮，艳歌清绝舞妖娆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41132,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄胡完夫","author":"刘攽","text":"去国那无鬓发华，白沙犹觉胜长沙。\n晴云乱眼江枫色，宿雨销魂野菊花。\n过客谁能问名姓，加餐自不厌鱼虾。\n海陵仓粟年丰熟，吾亦惭为饱煖家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41133,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄韩持国","author":"刘攽","text":"承明不许曳朝衫，流落江湖默避谗。\n海气无时成雾雨，鱼租终岁杂腥咸。\n喜逢晴日听鸣鹤，却倚津亭数去帆。\n可是绛侯轻贾谊，自无张禹托萧咸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41134,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵钱虞部九日乐郊有感","author":"刘攽","text":"前日吟君九日诗，名园兴尽复伤离。\n浮云色变曾千古，黄菊花开又一时。\n钟子绝弦谁与听，羊公堕泪不堪悲。\n孤生长抱吹埙感，何况池塘昔梦思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41135,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄王安国时复官大理寺丞监江宁粮料","author":"刘攽","text":"招隐长吟丛桂诗，赐环欢奉玺书归。\n东郊瘦马骅骝在，南海明珠薏苡非。\n宾客重寻廷尉寺，官曹不远故山薇。\n须还长孺银青绶，聊看翁思博士衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41136,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬王定国","author":"刘攽","text":"卧读群言起欲行，壮夫为不负平生。\n上书略数三千牍，掉鞅何烦七十城。\n筑室曾同老农计，寄诗犹见故人情。\n病躯懒厌金门步，长愧彤廷午漏声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41137,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬晁美叔","author":"刘攽","text":"此身敢与世峥嵘，秃发衰颜太丑生。\n长愧使君心匪石，每因佳句赠连城。\n病来筋力惟求卧，老去文章不近名。\n酒量消除百无一，未尝酣畅若为酲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41138,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬章质夫","author":"刘攽","text":"晚悟头陀尘不侵，何妨居士著朝簪。\n故人自是相忘者，秀句依然莫逆心。\n翠柏高松存茂悦，潜鳞羁羽任飞沈。\n万缘起灭空花喻，可向空花拟重寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41139,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵酬韩三相公见寄","author":"刘攽","text":"自昔羊公岘首游，谯涡开府祇千秋。\n韦平继相闻诗礼，鲁卫提衡绝辈流。\n功与荣名逾响捷，福随阳报似言酬。\n孤生承乏曾何数，玉铉龙文顾瓦瓯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41140,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬王平甫","author":"刘攽","text":"黯澹流云索莫风，晓瞻双阙望苍龙。\n秋还鹰隼非无意，凉入枫槐不变容。\n寓直鬓毛悲骑省，雠书编简待陈农。\n黄花黄叶催时节，倩问谁家酒最醲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41141,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵酬孙少述见寄","author":"刘攽","text":"退尺无缘复枉寻，信书那免不通今。\n争评玉价应输厚，能为鱼谋岂厌深。\n待得散人如散木，敢论机械有机心。\n子荆诗笔兴公赋，万事惭君早息阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41142,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵酬顾子敦见寄","author":"刘攽","text":"丹砂未化不成仙，白发衰容五十年。\n已自灰心当世事，更能回首大夫贤。\n对棋可待矜无敌，读易聊须记绝编。\n寄语山阴顾元叹，人今同病始相怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41143,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵酬曹极司法","author":"刘攽","text":"越纸题诗寄我来，君家八斗定多才。\n冰清玉润高风旧，白雪阳春病眼开。\n长见夔龙参浚哲，不闻徐乐避雄猜。\n自缘衰老无能解，战胜方当去剪莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41144,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵酬孙少述","author":"刘攽","text":"使节皆穷浊水源，降羌系踵慕称藩。\n强颜假守真无补，取笑高人不惮烦。\n岂有天池容斥鴳，莫将沟断比牺樽。\n南山若许堪归老，二顷平田十亩园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41145,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬韩相公","author":"刘攽","text":"病卧湘山念所亲，惟公长记可怜人。\n寄书不啻从容语，问舍仍惭消息真。\n半死孤松函徵羽，恋轩瘦马强精神。\n祁奚鲍叔宁欺我，三入今看总四邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41146,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬刘宜甫","author":"刘攽","text":"万价睢盱倚市平，百工纷糺待宫成。\n神仙亦有丹台籍，壮士当为猛虎行。\n毕娶幸能同尚子，敝衣终不效唐生。\n洞天欲到先能说，十二楼前列五城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41147,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬王定国五首 其一","author":"刘攽","text":"放逐朝恩本自优，衡山犹是古荆州。\n百年生计羞蜗角，九品人情看马头。\n炎瘴还归君不恙，风波别去我离忧。\n柔姬一唱阳关曲，独任刚肠亦泪流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41148,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬王定国五首 其二","author":"刘攽","text":"岂有多方书五车，尔来留意就丹砂。\n谁将饱食仓中鼠，换取红莲火里花。\n三顾祇能矜彼善，万钟多不悟堪嗟。\n蟠桃结实何难俟，况值安期枣似瓜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41149,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬王定国五首 其三","author":"刘攽","text":"贵公孙子族关西，失路青冥翅羽垂。\n当世朋游皆父行，古人方略足肩随。\n薄材老去欢倾盖，直气交新喜尽规。\n满目江山屡回首，白云流水付心期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41150,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬王定国五首 其四","author":"刘攽","text":"江岸青枫连白蘋，片帆如箭射千钧。\n风烟何处喧嘘市，箫鼓谁家赛水神。\n雁鹜陂湖争就暖，杉松庐舍不知贫。\n滞淫何必多离恨，譬似生为泽国人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41151,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬王定国五首 其五","author":"刘攽","text":"愿赐支离不肖身，幅巾田野任天真。\n我行三径一廛地，君即东阡南陌人。\n晏卧自轻车结驷，食薇从使甑生尘。\n漳滨卓荦桓公健，盛德由来必有邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41152,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"承天寺翠景亭 其一","author":"刘攽","text":"一山篁竹间松杉，伏虎犹存居士庵。\n钟磬有时闻绝壁，渔樵将晚会平潭。\n薄云未解成春雨，返照偏能破夕岚。\n我所思人桂林外，凭高惆怅赠双南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41153,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"承天寺翠景亭 其二","author":"刘攽","text":"松有乔林桂有丛，石梯苔壁兴无穷。\n快心叠嶂云如扫，会意澄波日正中。\n修竹缘崖高竦竦，早梅飘雪细珑珑。\n狂吟大叫青冥外，惊看渔郎下钓筒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41154,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"遣怀","author":"刘攽","text":"六年长病每愁予，末疾风淫岂易除。\n彳亍何曾暂忘屦，拮据空恨不能书。\n苦遭白发无他术，常得中医亦自如。\n欲向明廷乞骸骨，角巾藜杖整柴车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41155,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"种竹重寄子瞻","author":"刘攽","text":"官曹何独异吾庐，修竹成林手种初。\n未必七贤皆纵逸，因从三昧得无馀。\n风声似水还成韵，日影填金尚觉疏。\n旧事喜君能记忆，兴来当复埽墙书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41156,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"周橦兄弟得解寄王教授察推","author":"刘攽","text":"今秋乡里荐贤书，年少周郎智有馀。\n全得凤毛增意气，正联鸿翼上空虚。\n汝南月旦评无愧，诸老先生谢不如。\n衰白惭居丈人行，长风犹欲助吹嘘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41157,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"济阴县新成官廨赠知县著作","author":"刘攽","text":"鼠牙雀角穿垣屋，墨绶铜章愧吏民。\n制锦可无容膝地，戴星亲作执柯人。\n奋飞翚雉檐双翼，积叠鱼龙瓦万鳞。\n若比治蒲增四善，种花仍欲笑安仁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41158,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送学正李秀才归蜀","author":"刘攽","text":"金马书来信不违，相如独授七经归。\n郡迎徐孺知悬榻，家望苏秦想下机。\n峡底奔雷江乱涌，岭头如雨石交飞。\n丙鱼郫酒欢闾里，悔杀京尘化素衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41159,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清门 其一","author":"刘攽","text":"清门早日素风传，正在图书翰墨间。\n惠子应输五车富，相如才授七经还。\n朱栏碧瓦森华屋，乔木浮云满旧山。\n渥水丹丘远千里，凤雏神骥落人寰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41160,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清门 其二","author":"刘攽","text":"蜀山漠漠水溶溶，高阁经营得我公。\n万轴铅黄无脱简，千寻清白有遗风。\n地留神苑逍遥外，天占仙壶缥缈中。\n公是蓬莱真学士，故应乘此问鸿蒙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41161,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西省种竹偶书呈同省诸公并寄邓苏二翰林","author":"刘攽","text":"五月十三竹迷日，今年仍自晏阴初。\n分将池籞千竿翠，就得枫槐一雨馀。\n红叶苍苔相映带，南荣北户顿萧疏。\n欲为林下诸君咏，便是涛戎亦尽书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41162,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"长安城南","author":"刘攽","text":"三百离宫何处寻，秦山相向昼阴阴。\n城南地去天尺五，杜曲田皆亩一金。\n源发清泉随种稻，稆生脩竹自成林。\n老年欲为五陵客，射猎往来长纵心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41163,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送陈成伯出牧陕府","author":"刘攽","text":"陈公六十丐朱轮，豪气谁怜亦为贫。\n原上鹡鸰深涕泪，枥间骐骥发精神。\n山违折坂皆夷路，河透酾渠即要津。\n千岁海棠死铁色，因君光彩会如新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41164,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵苏子瞻观范景仁新乐","author":"刘攽","text":"大儒高论本升堂，物外光阴更不忙。\n乐预请观同季子，书虽未见属黄香。\n正声仍许三人和，古尺应无一黍长。\n鹤舞凤仪时莫识，勾陈武帐省中央。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41165,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]