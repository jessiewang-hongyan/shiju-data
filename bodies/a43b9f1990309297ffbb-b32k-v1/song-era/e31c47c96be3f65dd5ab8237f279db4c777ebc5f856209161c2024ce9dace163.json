[{"title":"句 其二","author":"张镃","text":"断桥斜取路，古寺未关门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58133,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"张镃","text":"自笑从来痴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58134,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"张镃","text":"一棹径穿花十里，满城无此好风光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58135,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其三","author":"张镃","text":"梨花风骨杏花妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58136,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其六","author":"张镃","text":"吹杀梅花影里灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58137,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其十五","author":"张镃","text":"燕子初归已识面，牡丹未放已知名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58138,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其四","author":"张镃","text":"已从槐借叶，更染菊为裳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58139,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其五","author":"张镃","text":"何时重来桂隐轩，为我醉倒春风前。\n看人唤作诗中仙，看人唤作饮中仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58140,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偈","author":"张镃","text":"钟一击，耳根塞，赤肉团边去个贼。\n有人问我解何宗，瞬若多神面门黑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58141,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"飞来峰","author":"张履信","text":"飞来何处峰，木杪夜千尺。\n愁猿唤不应，月色同一白。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58142,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"访丹阳玉乳泉已变昏黑因赋诗","author":"张履信","text":"观音寺里泉经品，今日唯存玉乳名。\n定是年来无陆子，甘香收入柳枝瓶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58143,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"翠微亭","author":"张履信","text":"朝朝乌北出，夜夜乌南归。\n所谋在一食，所息在一枝。\n人生竟何得，与乌同此机。\n身世忽过虑，泉石良自怡。\n月上飞来峰，更谁登翠微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58144,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"柳梢青","author":"张履信","text":"雨歇桃繁，风微柳静，日淡湖湾。\n寒食清明，虽然过了，未觉春闲。\n行云掩映春山。\n真水墨、山阴道间。\n燕语侵愁，花飞撩恨，人在江南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58145,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"朝天宫成纪怀","author":"张德兴","text":"崒律千寻玉垒开，龙盘虎踞拥金台。\n云中双阙天颜近，塞上孤臣铁骑回。\n砂壁朝疑烽火动，松风夜杂鼓笳哀。\n愿将只手扶红日，扫尽狼烟御辇回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58146,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙","author":"张磐","text":"习习轻风破海棠。\n秋千移影上回廊。\n昼长蝴蝶为谁忙。\n度柳早莺分暖绿，过花小燕带春香。\n满庭芳草又斜阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58147,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绮罗香 渔浦有感","author":"张磐","text":"浦月窥檐，松泉漱枕，屏里吴山何处。\n暗粉疏红，依旧为谁匀注。\n都负了、燕约莺期，更闲却、柳烟花雨。\n纵十分、春到邮亭，赋怀应是断肠句。\n青青原上荠麦，还被东风无赖，翻成离绪。\n望极天西，惟有陇云江树。\n斜照带、一缕新愁，尽分付、暮潮归去。\n步闲阶、待卜心期，落花空细数。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58148,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"不寐","author":"张蕴","text":"空床展转对孤檠，寒漏年长更雨声。\n如此乾坤閒岁月，明朝华发满头生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58149,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丹阳道中流寓人","author":"张蕴","text":"累土编茅古制庳，官田种秫得沽私。\n自言身健无徭役，犹胜平生江北时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58150,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"凤鹤鹊三题与江社同赋 其一","author":"张蕴","text":"一去朝阳寂不闻，西康台北起寒云。\n梧花竹实年年事，柰此喧啾百鸟群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58151,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"凤鹤鹊三题与江社同赋 其二","author":"张蕴","text":"立雪精神两瘦芦，天风入羽思江湖。\n逋仙梅下曾相识，千载归来一语无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58152,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"凤鹤鹊三题与江社同赋 其三","author":"张蕴","text":"月树争枝影共寒，楂楂飞过屋头山。\n五陵年少多春闷，一弹千金落等闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58153,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"归雁亭","author":"张蕴","text":"青云影里自由身，几倚阑干看不真。\n又是江湖春雪尽，年年肠断玉关人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58154,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"瓜洲","author":"张蕴","text":"如此江涛更有人，佛狸竟死不能兵。\n幅巾短棹鸥前梦，未省当时有此城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58155,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵月中闻鹤 其一","author":"张蕴","text":"月明华表语霜清，万籁沉沉静有声。\n一自别来璚树长，几回飞梦到曾城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58156,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵月中闻鹤 其二","author":"张蕴","text":"孤影徘徊且月中，流离满贮酒如空。\n东皇太一应来下，笑指梅花一信通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58157,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"至后","author":"张蕴","text":"阳生七日验飞葭，衮衮天机岁载华。\n江草未圆青帝梦，香芸漏泄与梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58158,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"京口运河上","author":"张蕴","text":"荒荒永岸水如沟，翁仲无言立上头。\n日日餫舟衔尾去，东南民力尚支不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58159,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"垂虹 其二","author":"张蕴","text":"忆著前游十四年，三高祠下夕阳船。\n无钱买得鲈鱼鲙，吟就橘花香里眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58160,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"垂虹 其一","author":"张蕴","text":"四岸俱无只有天，烟樯如雨落鸥前。\n不知笠泽翁何许，波上清风一万年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58161,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"姑苏台","author":"张蕴","text":"故址耕残草树秋，无人曾见鹿来游。\n甬东亦是当时月，不照笙歌只照愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58162,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"虎丘","author":"张蕴","text":"曼陀石上无根树，历历生公说法馀。\n剑水一泓清澈底，至今人说有龙居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58163,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金山","author":"张蕴","text":"江身台殿切空云，夜月鱼龙影不分。\n八十老僧相引说，潮痕不上郭公坟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58164,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋思","author":"张蕴","text":"暑退凉生体气佳，卷帘听雨感年华。\n西风叶叶梧桐冷，开尽庭前白鹤花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58165,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"斋宫偶题","author":"张蕴","text":"众绿扶疏雨气清，柳花吹作小池萍。\n文窗昼寂斋房邃，三漱华池诵玉经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58166,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄鹤田","author":"张蕴","text":"鹤向孤山去未归，片云行雁与心期。\n新诗不著工夫得，雪外看花独立时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58167,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"维扬即事 其三","author":"张蕴","text":"茅屋芦门半市坊，居民无事亦军装。\n愁来莫上城头望，西北浮云接太阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58168,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"维扬即事 其一","author":"张蕴","text":"牛斗星边禹贡州，东南屏蔽大江流。\n向来明月珠帘梦，不信秋风夜柝愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58169,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"维扬即事 其四","author":"张蕴","text":"月明城上响边笳，一枕三更梦到家。\n不耐楚氛真僻性，赋诗酌酒与琼花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58170,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"维扬即事 其二","author":"张蕴","text":"皂角林前野地宽，新塘路口草泥乾。\n天乎如此功名事，成败观人自昔难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58171,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"维扬即事 其五","author":"张蕴","text":"土雾如蒸暴暑天，烛龙偏驻柳边船。\n三清观里风廊午，满意题诗借榻眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58172,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜李鹤田至次阮云心韵兼寄 其一","author":"张蕴","text":"月树秋来碧几寻，古芗熏彻紫芝吟。\n无因得去陪清赏，祇寄山君一寸心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58173,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜李鹤田至次阮云心韵兼寄 其二","author":"张蕴","text":"浇酒逋梅又几回，愁吟旧雨独登台。\n星星鹤语山窗晓，割得云心古锦来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58174,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"惠山","author":"张蕴","text":"石苔滑汰屋连斜，第二泉边古佛家。\n一壑松风听不了，却留僧坐自煎茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58175,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"道中观戽水戏书","author":"张蕴","text":"秧马泥深茧犊閒，烛龙顾影桔槔间。\n寻常六月江南雨，不比君王帑藏悭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58176,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"楝花","author":"张蕴","text":"绿树菲菲紫白香，犹堪缠黍吊沉湘。\n江南四月无风讯，青草前头蝶思狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58177,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"翠蛟亭呈孙元素鍊师","author":"张蕴","text":"剡剡星虹白日寒，山香一曲落云端。\n乘虬道士排空去，怒雨声摇碧玉峦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58178,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九日","author":"张蕴","text":"细看黄花把一枝，东篱犹是昔人非。\n题糕酒外豪心在，吹帽风前素发稀。\n雁叫霜天悲故国，鸦翻溪树背寒晖。\n百年独有閒居乐，可怪东山事竟违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58179,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上海","author":"张蕴","text":"梦断三更鹤，芦边系短篷。\n听潮看海月，坐石受天风。\n物至秋而化，年来我亦翁。\n长歌相劳事，犹喜此樽同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58180,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"午日次韵池袭父","author":"张蕴","text":"小泊蘋香柳下矶，重逢佳节感年时。\n束蒿偶作人形想，采药须供国手医。\n江镜愿为明主监，楚菰愁赋逐臣词。\n酒边听尽敲篷雨，数日淮南去未迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58181,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"东庵与道者语有感","author":"张蕴","text":"瘦策松间日又斜，更过东崦吃僧茶。\n丹青岭树明寒叶，水墨江天噪乱鸦。\n付酒一杯真乐事，读书万卷是愁涯。\n更尝世故知閒味，河水依然鬓自华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58182,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"平山和韵鹤田","author":"张蕴","text":"琼花应自笑南翁，白发栖栖逐断蓬。\n兵后百年城郭是，尘间多事古今同。\n孤烟远堠如常夜，五月穷边尚冷风。\n可待莼鲈归兴尽，长吟且复付杯中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58183,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"平山堂吊古","author":"张蕴","text":"隔江山色画图中，故址荒来与庙通。\n画地雄吞淮海水，占星高直斗牛宫。\n试评蜀味长泉变，欲唱欧词古柳空。\n往事茫茫增感慨，聊凭戍卒指西东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58184,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"正月二日雪","author":"张蕴","text":"雨送冬雷了，如筛堕晓晴。\n萦盈溪树色，骚杀纸窗声。\n著瓦消还易，因风冻不成。\n纷纷门外屦，犹自贺元正。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58185,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同寮约游香林分韵得林字","author":"张蕴","text":"约我当休沐，同过支道林。\n棋边翻覆手，酒外太平心。\n石漱晴湍细，猿吟夏木深。\n归帆带疏雨，凉意满幽襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58186,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"多景楼","author":"张蕴","text":"假日此登临，凄凉北望心。\n戍烽孤障杳，塔影一江深。\n黠虏投鞭想，将军誓楫吟。\n所嗟人事异，天险古犹今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58187,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岁晏用赵谊父访云心韵以寄","author":"张蕴","text":"看春知几度，玄发故应非。\n世事真犹梦，人生瘦胜肥。\n竹边随意入，梅下得诗归。\n缅想羊何友，湖山乐所依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58188,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"朱柿","author":"张蕴","text":"慈恩分种远，骈实渥如丹。\n垂野华星大，然云火树寒。\n蟹螯徵有忌，狌血讶难抟。\n七绝虽堪赏，无劳把核钻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58189,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西湖清明","author":"张蕴","text":"芳天新霁惠风和，软绿平堤凝不波。\n桃李无言看客惯，楼台如画占山多。\n游裾匝路填车马，翠榜开筵斗绮罗。\n寂寂寒烟生水面，白鸥柰此月明何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58190,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"何山","author":"张蕴","text":"山因人得姓，人去佛来居。\n邻有天章墓，碑无玉局书。\n幽蹊通古郭，荒涧入春畬。\n客子吟须冷，高峰夕照馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58191,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"祀事","author":"张蕴","text":"误被鸡催起，隃听漏鼓稀。\n书檠风展卷，香碗火生衣。\n困嗅茶犹病，吟餐菊可肥。\n月明天路靓，亲到帝旁归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58192,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"录录","author":"张蕴","text":"录录竟何为，衣尘日以缁。\n故人閒入梦，久雨颇妨脾。\n燕履登巢息，蜂程载蜜亏。\n独斟莲子酒，愁绝杏花诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58193,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春朝偶题","author":"张蕴","text":"忙里偷閒答物华，一官随分是生涯。\n春风酒棹湖堤柳，晓月吟鞯辇路花。\n报喜忽闻枝上鹊，忘机时下屋头鸦。\n残年钝闷今朝尽，重对菱花拂帽纱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58194,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送晏桂山赴高沙郡 其二","author":"张蕴","text":"接武容台彼一时，溪乡重幸得追随。\n鸥前心事沧浪影，梅下吟情汗漫期。\n感慨中年无近别，徘徊明月有相思。\n殷勤劝醉阳关晓，受尽耶歈只自知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58195,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送晏桂山赴高沙郡 其一","author":"张蕴","text":"青衫赴阙已三迁，红旆临州不五年。\n旧吏侉荣从事府，新民迎拥使君鞯。\n牡丹池馆春融日，莼叶汀洲水涨天。\n自是边筹谈笑办，归来仍侍玉皇前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58196,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重游大涤洞天","author":"张蕴","text":"涧水泠泠石发新，松花香靓翠崖深。\n云生不没仙人迹，丹化犹啼捣药禽。\n洗眼人多求圣水，醒心吾独爱清音。\n杖藜更欲过新洞，无柰春空又作阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58197,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"除夕","author":"张蕴","text":"京国逢除夕，栖迟鬓欲霜。\n春声生竹爆，岁色动椒香。\n戒睡听鸡早，占诗探茧忙。\n烛花频送喜，儿女笑烘堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58198,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"食蛎次韵芸隐","author":"张蕴","text":"相黏成什伯，峰耸若山王。\n攻处须犀铁，持来出蟹汤。\n梅花霜后味，竹色酒边香。\n坐忆游闽乐，今年始得尝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58199,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"钱氏东皋","author":"张蕴","text":"百年钟鼓园林在，人物萧疏更海乡。\n藤络湖嵌山解长，花移邺本土犹香。\n棋声靓昼松阴淡，扇影閒秋水气长。\n莫道官忙行乐少，也分物色到奚囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58200,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"顾径","author":"张蕴","text":"海水还清浅，停杯问二豪。\n雨来江色暝，沙长岸容高。\n吏鞅何能脱，王程敢惮劳。\n秋风柁楼底，短发不禁搔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58201,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"祷雪天竺由灵鹫过冷泉","author":"张蕴","text":"降香天竺去，瀹茗冷泉来。\n新径石间过，危亭木杪开。\n烟山晴若画，霜叶湿如灰。\n点检经行处，今年未见梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58202,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"道场山","author":"张蕴","text":"访碑无古迹，丹碧覆嵯峨。\n塔向城中共，山从寺右多。\n疏松小溪路，远溇太湖波。\n何锴书堂在，犹嫌隔翠萝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58203,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"酥","author":"张蕴","text":"兼味醍醐外，分身乳酪中。\n江南鸣稚犊，塞上寄飞鸿。\n乾雨看如幻，生盐讶渐融。\n臈残犹有待，煎取牡丹红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58204,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"霅川次韵鹤田","author":"张蕴","text":"苕霅双流合，帆樯万里通。\n连山黄独雪，一雁白蘋风。\n酒户春醅浅，鱼村晚市同。\n旧游蕉鹿外，未老已成翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58205,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹤田还江右","author":"张蕴","text":"欲留云共住，云去楚天长。\n此日吾犹惜，中年别易伤。\n搜吟梅下影，赌弈橘中香。\n谨勿移山诺，春风入帝乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58206,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"云间","author":"张蕴","text":"倦倚柁楼闻鹤唳，半生此地一经过。\n机云故月荒凉宅，湖海新秋浩荡波。\n晓?红莲商客市，夜窗白苧女儿歌。\n吟边冷被沙鸥笑，衣化京尘鬓亦皤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58207,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]