[{"title":"次韵王子植见寄","author":"汪炎昶","text":"心亲迹难前，视曩勇不逮。\n梦往谓知路，佶屈迷晻暧。\n俄锵涧中作，如爪痒爬背。\n语抵珠颗圆，落祇剩磊磊。\n岂去陶韦遥，一切铲华彩。\n宁辞咏情性，责有庭帏在。\n寸禄足为娱，迟子董晁配。\n磨砻蓄精锐，坚忍勿少退。\n济时我所懵，有腼类沈晦。\n孤怀郁不平，倾写尚子待。\n三山讵云遥，风帆渺云海。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72927,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵戏族兄存耕翁再纳宠姬 其二","author":"汪炎昶","text":"香风轻漠绣帘春，乐事从来不厌新。\n已有昭华君未惬，若逢嫫母我犹珍。\n虚烦设醴长为客，幸不闻歌足恼人。\n欲赋高唐追宋玉，终嫌想像未如亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72928,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵竹米","author":"汪炎昶","text":"天灾集午未，岂意非虚传。\n忽从坦夷中，如堕崔嵬巅。\n年年稻半穫，间日民一饘。\n性命毫毛轻，骨肉草芥捐。\n惟类偶遗脱，此君所安全。\n春花簇坠露，夏实攒荒烟。\n陟危虎豹怒，缒峻萝葛缠。\n采揉簸壳净，蒸曝舂粒坚。\n捉筐儿裸股，力杵妇耸肩。\n功与稻粱并，状如牟麦然。\n俚语漫纪实，敢希辑为编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72929,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵补柳子厚八愚诗 其七 咏愚堂","author":"汪炎昶","text":"晨兴气澄穆，池影涵幽堂。\n泉从松下来，漱齿生微香。\n内揣澹无得，外检倏已忘。\n即此冥其愚，乐如还故乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72930,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵补柳子厚八愚诗 其二 咏愚邱","author":"汪炎昶","text":"故邱堕苍茫，得兹赖居人。\n竹氛净媚晓，藓绩绿染春。\n藤萝设野幕，猿鸟卜近邻。\n岂不惬吾愚，弥使怀所亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72931,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵补柳子厚八愚诗 其六 咏愚岛","author":"汪炎昶","text":"海仙怜憨痴，相嬉幻蓬岛。\n池悬孤影直，云增危势好。\n鹤盘意欲下，树滋色难老。\n春风慎披拂，勿俾生凡草。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72932,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵补柳子厚八愚诗 其八 咏愚亭","author":"汪炎昶","text":"拂翳藤袅风，洒澡松助雨。\n幽抱逼池光，妙趣味禽语。\n愚岂异曩日，优惟绝浮慕。\n当有来者知，泉石良可抚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72933,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵补柳子厚八愚诗 其五 咏愚池","author":"汪炎昶","text":"愚泉我所爱，规此须其来。\n但因坳窐势，不以智巧开。\n鸥驯如故知，鱼浮了无猜。\n感激平生怀，与尔同徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72934,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵补柳子厚八愚诗 其四 咏愚沟","author":"汪炎昶","text":"何以施吾愚，沟泉甃苔石。\n涡溢分冷光，池呀注晴碧。\n箕颍计已失，沧浪远难即。\n敢慕洗耳翁，聊为濯缨客。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72935,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵补柳子厚八愚诗 其三 咏愚泉","author":"汪炎昶","text":"撞玉锵断石，溅珠悬稚松。\n色资耳目净，声碎尘土空。\n静窥发奇趣，饱饮生异容。\n讵知愚所乐，适与智者同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72936,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵补柳子厚八愚诗 其一 咏愚溪","author":"汪炎昶","text":"嗜幽猎奇閟，身忘落天涯。\n光吸泛霞濑，清弄浸月陂。\n襟怀屡荡涤，性情渐愉怡。\n孱颜谢往惑，晃朗还澄思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72937,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵俞伯初古松篇","author":"汪炎昶","text":"挺植今几世，追数邈不逮。\n盘古始分画，已见数抱大。\n繁荄茁朽壤，力窃孕贞外。\n灵椿尔何知，诧阅寒暑代。\n深根谢撼拔，毅色支挫败。\n心坚素蕴直，貌古自类怪。\n梢优轴厚地，皮是船下濑。\n五岳空峥嵘，可纳枯窍内。\n绿狞攒磔髯，纹皴蹙腥背。\n萝茑获引援，萧艾藉覆盖。\n枝抽尚未已，著恐宇宙隘。\n馀韵落尘寰，海涛让砰■。\n此岂臃肿贱，莫肯发众快。\n材大固难容，不伐岂怜爱。\n阿房得附枝，岂见亟圯坏。\n卑魏若遁藏，丑惰事恬退。\n枯柏不自量，小器竞衒卖。\n负荷力不给，摧折自贾害。\n造化久培植，亦以邦国赖。\n山灵慎爱惜，勿使妄剪拜。\n大物不虚生，天意终有在。\n赋才巧尔殊，落落出行辈。\n所希亟遭逢，叶卷云影碎。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72938,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵胡庭芳别考亭夫子祠下","author":"汪炎昶","text":"与易俱遁无何乡，紫阳风采犹堂堂。\n伊洛诸老前慷慨，字落琬琰嗅有香。\n馀或闯首藩篱傍，占辞象例终茫洋。\n公剪蓁棘披羊肠，后顾万世不能忘。\n攘却异论拓我疆，片言只字挥琳琅。\n安定嗣法兀老苍，渔猎四裔搜中央。\n蹴孔跞郑倾文场，霜刀与劂玉版方。\n姓名无翼已四翔，锵然孤凤鸣朝阳。\n不忝考亭斯故邦，再□足慰公所望。\n笋鞋踏穿山雨凉，九曲烟霞落锦囊。\n曩吾有易腾青箱，乍惊幽渺出炜煌。\n湛弼愧遁遗赍装，子云未许窥邻墙。\n不独暗陋分馀光，后来企慕心徬徨。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72939,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵寄俞伯初","author":"汪炎昶","text":"足茧问津路，肩才息奚跛。\n醉乡托一廛，学海浮单舸。\n观心竦前瑕，敛躁入危坐。\n犹欣未穷极，早获挫刚果。\n愚徒巧掩拙，语每泄魇卧。\n所须补罅隙，亦才废星琐。\n智不给筹运，力难任败裸。\n汲汲欲为谋，政恐无时可。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72940,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵游山寺","author":"汪炎昶","text":"龛晕描轻藓，檐阴幂翠藤。\n追凉时有客，避难昼无僧。\n法界魔为祟，宗风冷欲冰。\n不知缘底事，还复有传灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72941,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵答伯初","author":"汪炎昶","text":"世网无端巧见遮，路岐何处出褒斜。\n游山断合先庐阜，筑室宁当舍若耶。\n此事岂难吾未遂，中年渐近累仍加。\n还应倏尔貌如雪，病眼新来似有花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72942,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"访人不遇 其二","author":"汪炎昶","text":"东林笋蕨香更肥，西林鹁姑鸣复飞。\n厨烟渐冷饭已过，骤雨欲作翁未归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72943,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过往岁避地之所屋燬人迁","author":"汪炎昶","text":"依旧苍苔小径斜，当时从此入山家。\n心疑谬误还疑是，雨湿棠梨一树花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72944,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吴氏碧松亭","author":"汪炎昶","text":"娱亲何烦羡三釜，种松筑亭真自贤。\n昔人固愿甘旨具，有子正须名节全。\n月摹碎影当奇画，风送寒声供醉眠。\n庭前雨露挟和气，明年定有枝相连。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72945,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"张子京扁其先大父居琴之竹轩曰琴琅玕","author":"汪炎昶","text":"自停伶伦双凤鸣，阴分嶰谷凉幽庭。\n淫哇不能屈其贞，睨霜节坚挺疏茎。\n骨含五音堪九成，欲泄未得郁不平。\n峄阳孙枝感精诚，檿丝与俱徽玉明。\n为引虞薰发其声，却寄猗兰和䪫韺。\n陶弦在趣非耳听，韩腹曾思披以呈。\n厥妙可蕴求无形，必与俱传物斯荣。\n张公之孙馀典刑，所宝不忝贻嘉名。\n彼局耳目尘满缨，泥琴琅玕挹馀清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72946,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"拟唐臣春苑池应制","author":"汪炎昶","text":"圣君垂拱殿，游豫及时和。\n辇驻花边静，舟攒柳外多。\n泛遥齐解缆，载重密垂河。\n傅楫轻篙手，夔韶谱棹歌。\n鱼方充镐沼，禽亦感殷罗。\n唼藻翎频刷，看云首屡峨。\n大疑鹏与似，瑞比凤来过。\n鹓鹭欣相狎，凫鹥许继哦。\n微臣亦□幸，共尔沐恩波。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72947,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"汪颜复秋江堂","author":"汪炎昶","text":"拂衣何必归沧洲，黟水不减沧江流。\n本有渔矶带苍藓，且无叠鼓惊眠鸥。\n风漾霞光笛声晚，云压雁影芦花秋。\n客子还能念乡土，今年更作新安游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72948,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"里人俞退翁自号南山南菊逸尝赋诗以道其志继有和者一日示两钜编则有故文丞相长句冠于其首盖君谒丞相于燕京时所赠也谨次韵以归之","author":"汪炎昶","text":"山人旧隐南山南，家具惟存赋诗笔。\n瓮浮清酝夜□云，菊泛寒香秋满室。\n模放已逼东篱真，经营况似南村宅。\n懒从乾藓洒窗户，豪厌湿云黏几席。\n铜鞭敲□秋韵铿，蕙帐围寒晓光寂。\n张公十策未风云，周家六典姑泉石。\n此与渊明亦何似，似处难将语凡客。\n世间尘土涴人衣，明日云深惆怅极。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72949,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"咀丛间新茶二绝 其一","author":"汪炎昶","text":"湿带烟霏绿乍芒，不经烟火韵尤长。\n铜瓶雪滚伤真味，石硙尘飞泄嫩香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72950,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"咀丛间新茶二绝 其二","author":"汪炎昶","text":"卢仝陆羽事煎烹，谩自誇张立户庭。\n别向人间传一法，吾诗便把当茶经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72951,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"咏友人竹","author":"汪炎昶","text":"拂云何日种，萧洒傍茅堂。\n翠重烟分渭，痕乾泪染湘。\n堑鞭枝倒发，径筱笋斜行。\n地紧根相络，茎高箨渐长。\n山僧冬觅种，邻叟夏偷凉。\n泛户阴开阖，掀风势簸扬。\n杖侵铿瘦玉，爪刮聚浮霜。\n禽踏枝毵屋，松添影压墙。\n箾韶如不弃，或可佐宫商。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72952,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"奉和江冲陶隐居二十韵 其十九","author":"汪炎昶","text":"窈窕东北峰，到眼佳有馀。\n行人日攀缘，岂知供我娱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72953,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"奉和江冲陶隐居二十韵 其二十","author":"汪炎昶","text":"截断浙东云，朝昏变奇状。\n平生采芝心，复此一惆怅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72954,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"奉和江冲陶隐居二十韵 其三","author":"汪炎昶","text":"入谷但杳冥，欲忘人寰近。\n烟霞谁与娱，烦君赋招隐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72955,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"奉和江冲陶隐居二十韵 其十三","author":"汪炎昶","text":"看云已堪眠，待月兼宜坐。\n谁令作棋局，却使苍苔破。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72956,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"奉和江冲陶隐居二十韵 其九","author":"汪炎昶","text":"山鸟戛曙烟，扶桑挂初日。\n岩栖学仙侣，应试餐霞术。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72957,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"奉和江冲陶隐居二十韵 其十二","author":"汪炎昶","text":"石壁倚苍峭，香荪湿蒙茸。\n闻名九歌里，识面此山中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72958,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"奉和江冲陶隐居二十韵 其十","author":"汪炎昶","text":"前浮芙蓉翠，后汎石耳云。\n君欲竟幽讨，绝壁更一扪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72959,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"奉和江冲陶隐居二十韵 其六","author":"汪炎昶","text":"昭崖泫泉液，勃勃上云气。\n未遂朝宗愿，先有为霖意。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72960,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"奉和江冲陶隐居二十韵 其五","author":"汪炎昶","text":"雪瀑下平地，便作人间去。\n石潭如有情，少遣潺湲住。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72961,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"奉和江冲陶隐居二十韵 其十五","author":"汪炎昶","text":"数点庐峰雪，吹入冲陶云。\n山灵定惊怪，佳景被子分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72962,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"奉和江冲陶隐居二十韵 其七","author":"汪炎昶","text":"苍然隔尘世，正对幽人家。\n绝宜疏雨馀，斜阳点寒鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72963,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"奉和江冲陶隐居二十韵 其一","author":"汪炎昶","text":"云深行欲迷，但逐樵夫去。\n遥闻鸡犬声，人家在何处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72964,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"奉和江冲陶隐居二十韵 其十六","author":"汪炎昶","text":"人世纷喧嚣，空山自茅栋。\n烦君固扃鐍，保此曲肱梦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72965,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"奉和江冲陶隐居二十韵 其十八","author":"汪炎昶","text":"朅来雪矼头，眼随林麓转。\n意定众境生，一笑前峰远。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72966,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"奉和江冲陶隐居二十韵 其二","author":"汪炎昶","text":"断石倚枯柳，古色凝空青。\n落日借猿坐，清晨同鹤登。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72967,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"奉和族祖紫岩翁谩兴十首 其十","author":"汪炎昶","text":"兀兀守陋说，依依望奇功。\n适秦辙东首，欲至当何从。\n为谋止一身，茫然如捕风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72968,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"奉和族祖紫岩翁谩兴十首 其九","author":"汪炎昶","text":"桃李贵以色，兰蕙贵以香。\n蚌胎秘奇彩，萤火耀寸光。\n中心固了了，竟莫辨否臧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72969,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"奉和族祖紫岩翁谩兴十首 其八","author":"汪炎昶","text":"寒士励苦行，不能动邻里。\n彼或外貌饰，即与时髦齿。\n激奖道已微，孰振颓波起。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72970,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"奉和族祖紫岩翁谩兴十首 其七","author":"汪炎昶","text":"愚夫恬其愚，智者役于智。\n宁为坎井蛙，勿作盐车骥。\n扰扰誇健捷，才堪一噱耳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72971,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"奉和族祖紫岩翁谩兴十首 其六","author":"汪炎昶","text":"气节固难量，出处已可视。\n一挽即致之，定非栋梁器。\n文王不亲屈，渔竿老于渭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72972,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"奉和族祖紫岩翁谩兴十首 其五","author":"汪炎昶","text":"众心异向背，如口纷嗜好。\n竞守一隅僻，不悟竟至老。\n何由破其惑，所贵皆为宝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72973,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"奉和族祖紫岩翁谩兴十首 其四","author":"汪炎昶","text":"地卑山故崇，河黄济故清。\n彼岂超世才，但愧吾无能。\n我家壁中书，不如相牛经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72974,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"奉和族祖紫岩翁谩兴十首 其三","author":"汪炎昶","text":"铿锵国风始，孰云堕微茫。\n祇今寂寥中，满耳犹洋洋。\n聋俗自无闻，此音初不亡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72975,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"奉和族祖紫岩翁谩兴十首 其二","author":"汪炎昶","text":"古圣道虽周，莫能保兴废。\n鼎中著乾坤，堂上纳边鄙。\n万古递相扇，征伐与侈靡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72976,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"奉和族祖紫岩翁谩兴十首 其一","author":"汪炎昶","text":"九州落编简，愁来得眺望。\n古人果有无，名存实全丧。\n去古日已邈，来期方浩荡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72977,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨夜言怀","author":"汪炎昶","text":"淅淅复淅淅，雨微声不休。\n蛩长远村夜，风早疏棂秋。\n委蛇世路窄，隐忍吾道羞。\n时逢一笑适，岂足偿多忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72978,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"俞氏朝爽轩","author":"汪炎昶","text":"西山入拄颊，终带板绶累。\n悠悠轩中人，心闲得真趣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72979,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"俞伯初见访示吴体诗既去而江和叔至甚恨相后先也是夕用韵寄二君子","author":"汪炎昶","text":"一日二子各两屐，踏碎一径松花黄。\n人好禽鱼亦光耀，山空水石逾荒凉。\n胸次似涤冰雪瑩，笑语欲染烟霞香。\n痴绝犹嫌不联袂，此已天幸宽愁肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72980,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南山","author":"汪炎昶","text":"宣平隐处今始过，烟霞城郭路几何。\n野渡谁浮夕阳艇，空山尚响樵人歌。\n石坛荒凉叠苔藓，谷鸟啁哳深松萝。\n何当更值买酒至，一笑使我朱颜酡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72981,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"复热","author":"汪炎昶","text":"昨暮北窗雨，未辨攲枕声。\n今晨东郊日，依作□炎□。\n神龙伏窟宅，独忍遗吾民。\n却恐空山雷，散入饥肠鸣。\n皇天亦何意，水旱频相仍。\n疲羸易凋瘵，可使失岁登。\n忧民岂吾责，畎亩心未宁。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72982,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋怀","author":"汪炎昶","text":"白露洗空河汉湿，耳目瑩净无纤埃。\n秋声溢出涧谷外，野色迸入轩窗来。\n多感间吟亦凄婉，自谋有策常迂回。\n傲然高视万物表，黄花浊酒聊一咍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72983,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送斗山兄隐居石耳山","author":"汪炎昶","text":"遥望石耳山嶙峋，咆哮虎豹林涧深。\n山屏倚翠障残日，石剑攒锋锼太阴。\n岂有渔人可问讯，苦怜木客长哀吟。\n似闻更欲住绝顶，他日瘦筇何处寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72984,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闻笛","author":"汪炎昶","text":"荒村犬吠人犹行，惊乌乱啼山月明。\n南邻捣砧适复罢，何处吹笛秋更清。\n疑含白龙堆外怨，恨不黄鹤楼中听。\n萤飞露下百草湿，倚风激烈思平生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72985,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"食笋","author":"汪炎昶","text":"乃□蓦跃玻璃寒，体被顽甲流腥涎。\n苏槁为穰功莫论，帝曰报汝后嗣蕃。\n或居渭水或淇园，一派逃入荒矶湾。\n厥后生子子生孙，头角崭然闯吾藩。\n拂云力郁数寸间，精液不泄真味全。\n祝融玄冥效骏奔，茭心芦芽腼以惭。\n竹叶与汝本同根，以胶投漆无间言。\n当家清风洒乾坤，不敢涴以荤与膻。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72986,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭俞伯初","author":"汪炎昶","text":"母老妻单妾稚年，一朝无主泪潺湲。\n终身在困庸非命，遗腹承家尚系天。\n门户故应终有托，琴书可得遂无传。\n不知造物端何意，祸惨吾徒不少怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72987,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"悯旱","author":"汪炎昶","text":"一身兼百虑，旱暵最关心。\n稻穫饥逾甚，民贫祸转深。\n偷生庸可必，此咎杳难寻。\n苦被浮云恼，时时谩作阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72988,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽毕宰二首 其一","author":"汪炎昶","text":"奥学深探本，亨衢早著鞭。\n浮云时事改，皦日大名全。\n馥荦霜篱菊，清瓢雪窦泉。\n善人终不起，犹谓有苍天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72989,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读书感愤四首 其四","author":"汪炎昶","text":"四载即五十，无闻了可知。\n身有俯仰责，书无毫发裨。\n痴犹未能弃，嗜若可疗饥。\n彼哉一何智，莫或效我为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72990,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]