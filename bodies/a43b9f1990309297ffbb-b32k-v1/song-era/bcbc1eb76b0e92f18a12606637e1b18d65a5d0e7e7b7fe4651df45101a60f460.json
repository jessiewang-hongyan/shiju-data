[{"title":"至郑州望故陈子思灵泉旧居怆然有感诗以述怀","author":"毕仲游","text":"夫子尝招隐，鸡鸣汝上川。\n饮徒随手散，诗草任人传。\n甥舅元相好，妻儿也可怜。\n有魂招不得，呜咽问灵泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54657,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"忤俗","author":"毕仲游","text":"忤俗真堪笑，谋生又不能。\n放怀衣落拓，高卧发鬅鬙。\n面垢常挥汗，牙衰怕嚼冰。\n床头鬃拂弊，不会逐青蝇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54658,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书怀","author":"毕仲游","text":"高城垒脩竹，小舍似山居。\n痛饮谋身懒，高歌与世疏。\n拂衣惭国士，买钓梦江鱼。\n可笑虞卿老，穷愁强著书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54659,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"永日","author":"毕仲游","text":"永日梅空发，夜眠分作题。\n不因怀北客，未折向南枝。\n渡岭朝云断，缘江春路迟。\n如何梦中作，常胜觉来诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54660,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋风","author":"毕仲游","text":"天地东南远，秋风万里来。\n青云如漫语，白日会相催。\n头带千茎雪，心阑一寸灰。\n说归归未得，江海路悠哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54661,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜雨","author":"毕仲游","text":"夜雨洗残暑，秋风应候来。\n庭柯色未减，黄菊意将开。\n布被已思夹，霜钟渐欲催。\n岁华空向晚，心事日成灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54662,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"破屋","author":"毕仲游","text":"破屋风千穴，棂疏日一竿。\n长巾笼短发，旧褐怯新寒。\n道路形容改，悲啼骨髓乾。\n乾坤非不大，无地得閒官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54663,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"疏檐","author":"毕仲游","text":"疏檐团鸟雀，画壁饱风霜。\n汲水三村远，诛茅半亩强。\n斋钱随客意，佛事寄僧堂。\n月落人相对，阴阴塔影长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54664,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"早起","author":"毕仲游","text":"起作南楼望，山河在我傍。\n春风入河济，晓雾合嵩行。\n带郭名园少，穿云古岸长。\n留连成皓首，何处是吾乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54665,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"策杖","author":"毕仲游","text":"策杖西原上，东风意浩然。\n山河思旧隐，日月换新年。\n径曲穿林巧，樽移席地偏。\n野花谁饤饾，故故簇平川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54666,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"乱水二首 其一","author":"毕仲游","text":"乱水号新港，颓云蘸古城。\n山楼遥出没，野日自昏明。\n树冷禽声灭，霜高鹘翅轻。\n梦归今未得，寂寞寸心惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54667,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"乱水二首 其二","author":"毕仲游","text":"水落芙蕖老，山高薜荔长。\n野云吹不断，晚雨气先凉。\n信笔题诗逸，停杯漉酒忙。\n酣歌露双足，有意濯沧浪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54668,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"恭挽神宗皇帝二首 其一","author":"毕仲游","text":"御极三宸正，调元一气淳。\n铜台漳水夜，玉匣汉陵春。\n地拓山河旧，天升日月新。\n自今遗老内，有是四朝人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54669,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"恭挽神宗皇帝二首 其二","author":"毕仲游","text":"北极回天象，西陵法帝居。\n松门黄道直，帐殿紫宸虚。\n宴罢千秋节，哀缠六尺舆。\n御诗兼手诏，新见睿思书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54670,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"恭挽哲宗皇帝二首 其一","author":"毕仲游","text":"遍覆仁无外，尊居道可名。\n就尧方日出，过杞忽天倾。\n海阔金凫下，宫开玉锁鸣。\n早知龙竟去，铸鼎不须成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54671,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"恭挽哲宗皇帝二首 其二","author":"毕仲游","text":"容卫千官出，攀号万国同。\n新名西下垒，空定北郊宫。\n天泣时零雨，神游恐御风。\n孤臣如在列，应许抱遗弓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54672,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"恭挽宣仁圣烈太皇太后四首 其一","author":"毕仲游","text":"受遗开嗣圣，约礼避前人。\n听览从公议，艰难付老臣。\n宫车闾阖晚，帐殿巩原春。\n似待吾君长，云轩即上宾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54673,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"恭挽宣仁圣烈太皇太后四首 其二","author":"毕仲游","text":"听朝惊屡辍，端拱异平居。\n垂殿帘初彻，因山道已除。\n书遗长乐记，音断濯龙车。\n诰下犹加惠，华夷定宴如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54674,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"恭挽宣仁圣烈太皇太后四首 其三","author":"毕仲游","text":"因革功兼至，权宜道可称。\n力扶天步稳，端拱太阳升。\n椒寝移彤管，泉关付漆灯。\n须知天子孝，不独改园陵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54675,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"恭挽宣仁圣烈太皇太后四首 其四","author":"毕仲游","text":"勋业三朝盛，哀荣万国同。\n人疑无外戚，家不选中宫。\n天泣时零雨，神游恐御风。\n忧劳如治水，九载亦成功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54676,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"恭挽钦圣宪肃皇太后二首 其一","author":"毕仲游","text":"维昔艰难际，安危属母慈。\n元龟犹不豫，大策更谁咨。\n搴雾云方合，当空月遽迷。\n圣君常泣慕，常以舜为师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54677,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"恭挽钦圣宪肃皇太后二首 其二","author":"毕仲游","text":"嗣圣当天日，权宜道不居。\n力明当辟事，豫下撤帘书。\n备物端门远，神游武帐虚。\n不知任与姒，较德定何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54678,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"恭挽钦慈皇后二首 其一","author":"毕仲游","text":"神考当天日，宫闱祝燕禖。\n日符元有感，坤轴欻先摧。\n追册音容閟，攀号吉葬哀。\n行知九虞祭，钦圣仗同回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54679,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"恭挽钦慈皇后二首 其二","author":"毕仲游","text":"缅怀章懿事，圣孝代相传。\n比上钦慈册，还同明道年。\n玉衣晨不整，帐殿日相连。\n闻说词多感，哀容可动天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54680,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽司马温国公丞相二首 其一","author":"毕仲游","text":"黄发来虽暮，丹心病未休。\n艰难天下事，际会老臣谋。\n似觉浮风返，空嗟白日留。\n定知名汹汹，万岁与千秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54681,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽司马温国公丞相二首 其二","author":"毕仲游","text":"礼绝非因贵，哀深却有荣。\n世间都画像，海外亦闻声。\n后事虽从老，前贤是友生。\n故应房魏辈，泉下定交情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54682,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽范丞相忠宣公六首 其一","author":"毕仲游","text":"曳杖三朝老，持衡一品尊。\n忽同秦逐客，几见楚冤魂。\n公衮方还第，輀车已及门。\n遗言不须记，一一表中存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54683,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽范丞相忠宣公六首 其二","author":"毕仲游","text":"出处从来定，荣华取次休。\n尝看居相府，只似在安州。\n不事千金产，能捐万户侯。\n哀哉天报施，仅免葬江流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54684,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽范丞相忠宣公六首 其三","author":"毕仲游","text":"伏枕言虽少，遗书志可哀。\n尚谋裨国事，犹欲尽人材。\n白日空垂照，悲风亦自来。\n更惊诸老尽，吾道信悠哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54685,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽范丞相忠宣公六首 其四","author":"毕仲游","text":"大节谁堪拟，危言每可惊。\n不牵身外物，宁向泽边行。\n近阙官皆复，还家没亦荣。\n升堂谁恸哭，知是老门生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54686,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽范丞相忠宣公六首 其五","author":"毕仲游","text":"忠义传三世，衣冠盛百年。\n功名富贵地，父子弟兄贤。\n被放长如往，生归岂偶然。\n至家还不起，无处问苍天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54687,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽范丞相忠宣公六首 其六","author":"毕仲游","text":"挥泪西原上，晴云为我阴。\n谁知如望岁，竟不复为霖。\n主圣空撝己，民思未绝吟。\n已休还一恸，非但哭知音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54688,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽司空申国吕公六首 其一","author":"毕仲游","text":"浩荡风云地，哀荣属老臣。\n两朝尊柱石，三世擅经纶。\n际会看前辈，安宁付后人。\n不须论制作，风俗近还淳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54689,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽司空申国吕公六首 其二","author":"毕仲游","text":"骑吹西城晓，衣冠一望中。\n尚疑归郑国，还似葬温公。\n道在民先定，兵销岁自丰。\n故知伊吕事，千载有遗风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54690,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽司空申国吕公六首 其三","author":"毕仲游","text":"试论司空事，还如庆历年。\n盐梅虽国论，衣绣是家传。\n二圣知人望，三公托世贤。\n奚须论燕处，无事不超然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54691,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽司空申国吕公六首 其四","author":"毕仲游","text":"岁月还箕尾，风云暗上台。\n定超三界外，元自九天来。\n冰木逡巡合，泉门飒沓开。\n太平虽已见，吾道亦悠哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54692,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽司空申国吕公六首 其五","author":"毕仲游","text":"位与诸公绝，恩逾上相尊。\n朝廷惟再拜，论道掩诸昆。\n体貌传三世，光华聚一门。\n苍天苦难料，端坐读招魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54693,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽司空申国吕公六首 其六","author":"毕仲游","text":"道继三贤后，名成六相齐。\n气摩南斗直，功盖北山低。\n背日衣冠祖，穿云卤簿迷。\n道旁谁白首，坚卧作儿啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54694,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽王元之相公二首 其一","author":"毕仲游","text":"门风清可尚，有道付陶甄。\n旧载传家榜，新承顾命篇。\n遗文星转斗，定策日升天。\n东府功名地，安居十五年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54695,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽王元之相公二首 其二","author":"毕仲游","text":"道与风云会，思留雨露滋。\n小心黄阁老，大手白麻词。\n家有衣冠盛，朝无故旧私。\n不须三寸舌，终号帝王师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54696,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽欧阳伯和三首 其一","author":"毕仲游","text":"不起斯人疾，哀歌未是哀。\n泪流千点血，心死一团灰。\n白日空垂照，悲风亦自来。\n半涂成永诀，天道信悠哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54697,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽欧阳伯和三首 其二","author":"毕仲游","text":"恸哭西原迥，晴云为我阴。\n山河一长剑，生死两知心。\n世谱传来久，天文验自今。\n此名埋不得，未信九原深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54698,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽欧阳伯和三首 其三","author":"毕仲游","text":"纯孝慈颜感，悲啼令季伤。\n凫飞元傍母，雁少不成双。\n寿夭从开辟，贤愚竟渺茫。\n不须论甲子，未省鬓毛苍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54699,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽履中学士二首 其一","author":"毕仲游","text":"孝悌由家法，词章亦世传。\n婚姻甥舅好，门户弟兄贤。\n问疾犹樽俎，遗文谩简篇。\n平生惟一辙，何事不长年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54700,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽履中学士二首 其二","author":"毕仲游","text":"漫向蓬丘老，都无一遣车。\n家人新买道，吊客旧通书。\n乐事生来少，兼官病后除。\n苍苍吾欲问，生理竟何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54701,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽晁端友著作二首 其一","author":"毕仲游","text":"好学五车富，轻财四壁贫。\n风流汉家令，文物晋诗人。\n门户青毡旧，穷途白发新。\n招魂谁解意，惭愧屈灵均。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54702,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽晁端友著作二首 其二","author":"毕仲游","text":"试问生何事，清诗七百馀。\n父兄无旧产，妻子有遗书。\n散诞谋生懒，高情与世疏。\n苍天高莫问，长短竟何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54703,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽李成之待制六丈三首 其一","author":"毕仲游","text":"高论嵇中散，行吟楚大夫。\n笑谈虽自若，放逐竟何辜。\n浮世终难料，苍天不可呼。\n莫论身后事，忠义付诸孤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54704,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽李成之待制六丈三首 其二","author":"毕仲游","text":"西帅旌幢旧，东州几杖新。\n偏裨尝破胆，徒弟盍书绅。\n雄略浑无敌，沈机妙若神。\n不须锄盗贼，公在本良民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54705,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽李成之待制六丈三首 其三","author":"毕仲游","text":"道孤存白眼，骨朽任黄泉。\n不与今人合，空为后世怜。\n文章还误己，穷达竟归天。\n遗藁知犹在，应容手自传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54706,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽卢革通议","author":"毕仲游","text":"耆宿今多少，惟公景德人。\n家邻吴市卒，名重汉庭臣。\n路在犹耕月，门閒似送春。\n才知图画好，时见旧精神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54707,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"代范忠宣挽中散某公三首 其一","author":"毕仲游","text":"平日书生贵，中年使者尊。\n绣衣虽去国，珠履会填门。\n奏疏皆民事，遗言为国恩。\n哭君无好句，端坐独招魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54708,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"代范忠宣挽中散某公三首 其二","author":"毕仲游","text":"宿昔函关路，游人作上官。\n鸡鸣轩盖入，马到吏民安。\n苦节摧头白，清名过齿寒。\n生平弹与挂，只是一朝冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54709,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"代范忠宣挽中散某公三首 其三","author":"毕仲游","text":"解组将安适，无何乃故乡。\n门庭虽取次，诗酒是寻常。\n车过音犹在，琴閒调已亡。\n因居悟生理，天地只茫茫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54710,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"代范德孺挽李稷运使四首 其一","author":"毕仲游","text":"倥偬军中事，飞腾使者尊。\n龙冈虽有地，马革返无门。\n未见朝廷诔，空遗子弟恩。\n不如行楚泽，先自作招魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54711,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"代范德孺挽李稷运使四首 其二","author":"毕仲游","text":"万里魂应返，沙场血未乾。\n幽明新雨露，恩怨旧衣冠。\n声作虞歌易，词赓楚些难。\n莫怜归骨晚，吊奠只空棺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54712,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"代范德孺挽李稷运使四首 其三","author":"毕仲游","text":"吾道何伸屈，斯人忽已亡。\n梦妖非二竖，风变哭三良。\n室有千言记，尘无一窖藏。\n举头天色在，今古自苍苍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54713,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"代范德孺挽李稷运使四首 其四","author":"毕仲游","text":"遗札何堪问，知无封禅书。\n杀身今已矣，报国事何如。\n人去衣冠在，魂来户牖虚。\n应同广川记，惟见玉蟾蜍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54714,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送太师潞国文公致仕赴阙朝觐归洛","author":"毕仲游","text":"事业观前辈，河汾出异人。\n擎天为柱石，盖代服经纶。\n早岁登黄阁，群公会紫宸。\n指挥平大盗，咳唾福生民。\n契合由天意，威行静塞尘。\n饱闻鸣鸑鷟，久已画麒麟。\n阴德归宗社，昌言启圣神。\n功成绝能口，道在不谋身。\n自昔规模定，于今风俗淳。\n立廷山不动，容物海无津。\n文力挥南斗，台光拱北宸。\n英姿元岌嶪，雄略只逡巡。\n慷慨遗轩冕，光华被缙绅。\n十年三册命，四海一师臣。\n贵极多齐物，名高却任真。\n气完神洒落，骨老石嶙峋。\n正殿需云合，初筵醴酒淳。\n异恩非故事，全美劝朝伦。\n高卧鹓鸿集，忘怀鸟雀驯。\n鬻熊心益壮，尚父德逾新。\n行色严舟御，荣光照席珍。\n二疏翻小节，九老尽佳宾。\n坐上文章士，田间道义邻。\n曹刘不难致，园绮会相亲。\n颖脱居尘外，逍遥占水滨。\n孔光灵寿杖，山简接䍦巾。\n贱子登门晚，微官侍坐频。\n倦游心落拓，多难骨酸辛。\n怀古悲寥廓，低颜任屈伸。\n邹裾羞扫地，墨突自营薪。\n饿死犹思洛，当年偶过秦。\n填沟知幸免，弹铗更何因。\n宦况淳于贱，交情鲍叔贫。\n废书顽度日，逃饮病酬春。\n请谒衣冠弊，留连体貌均。\n不堪名碌碌，尚辱诲谆谆。\n器小甘无用，词繁耻重陈。\n綵衣围鹤氅，寿酒吹鱼鳞。\n江海新归计，乾坤旧化均。\n终篇怀感激，肝胆觉轮囷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54715,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送交代杨应之判官归洛","author":"毕仲游","text":"借问杨夫子，还家洛浦春。\n两为黄绶吏，双健白头亲。\n乌帽斜攲面，斑衣稳称身。\n鹊灵方报喜，龟梦久方神。\n高卧今贤相，居閒旧老臣。\n上堂从隐几，侍坐好书绅。\n存没空怀感，交游素耐贫。\n先生坟上泪，御史甑中尘。\n嵩顶饶穿屐，伊流惯幅巾。\n直弦歌太尉，曲学笑平津。\n自滞心元懒，偷閒味却真。\n折腰陶靖节，散发屈灵均。\n王屋风鸣籁，龙门月漾银。\n白芽烹涧水，绿笋当江莼。\n折鹿诸儒喜，骑驴大尹嗔。\n赠人袍已弊，赊酒券常新。\n小子元疏放，忘归任屈伸。\n马肝嗟屡食，犬吠脱无因。\n文史惭方朔，形骸谢伯伦。\n耻同珠履客，宁作醉乡人。\n瓜熟叨为代，情亲愿卜邻。\n乞笺金踯躅，试研玉麒麟。\n祖道无供帐，停车有吐茵。\n心胸两倾倒，轇轕动星辰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54716,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送郓州杨子安教授由京归洛","author":"毕仲游","text":"好去嵩阳客，清河稳放船。\n东州新学校，南郭富林泉。\n悟道先生敏，为文子弟传。\n乌皮常隐几，黄绢动成篇。\n太尉风流在，裴休理性玄。\n老松生干直，大海得珠圆。\n肆笔君房好，论才贾傅传。\n尚书行给札，博士久虚员。\n献策诸公喜，谈经众手编。\n长鲸鳞鬣就，仪凤羽毛鲜。\n小子甘环堵，穷途懒著鞭。\n家贫门外辙，酒价杖头钱。\n官冷虽知命，身閒学问禅。\n功名看异日，交契懒同年。\n明月行梁苑，凉风度颍川。\n叫阍宜上疏，负郭莫归田。\n散饮杯投地，更阑斗挂天。\n离怀吟不足，弹断古琴弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54717,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"早寒","author":"毕仲游","text":"十月清宵永，空斋已怯寒。\n霜篱飞叶密，风案拂沙乾。\n晏叔狐裘稳，公孙布被完。\n檐澌方缀瓦，井冻渐封干。\n饱食留鹰距，虚惊落雁翰。\n谁来沽酒饮，自笑典衣难。\n想望存心曲，嘻吟恣笔端。\n河冰思泽国，路雪寄长安。\n邑邑炉灰冷，荧荧烛烬阑。\n门前生计在，苇席称车单。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54718,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]