[{"title":"雨楼即事","author":"顾逢","text":"客久颜容改，羞开古镜奁。\n瘦添清骨相，老减白髭髯。\n云暗山无塔，楼空雨一帘。\n休官归去后，疏散似陶潜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62769,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冠胜轩","author":"顾逢","text":"六桥多少景，尽在倚栏中。\n佳处无如此，看来总不同。\n湖光四时别，山影半江空。\n图尽天开出，人间笔未工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62770,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夜宿山寺","author":"顾逢","text":"静夜留山寺，清谈对老庞。\n树声如有雨，秋气欲无窗。\n檐马随风走，楼钟带月撞。\n何人呼渡急，隔水吠村厖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62771,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夜宿僧房","author":"顾逢","text":"白云分半榻，正在涧声边。\n一夜山中宿，三生石上缘。\n听猿推枕坐，爱月近窗眠。\n不觉天将晓，疏钟度暝烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62772,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋扇","author":"顾逢","text":"明月藏尘箧，曾归掌握中。\n得时思酷暑，袖手怯西风。\n用舍人相似，炎凉心不同。\n汗流沾背处，蔽日岂无功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62773,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋晚与许端甫山行","author":"顾逢","text":"山行多妙处，妙在倚筇中。\n到此兴难尽，吟成诗不同。\n松涛鸣绝壑，叶雨下晴空。\n钟鼓云边寺，应知有路通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62774,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"茜水道中","author":"顾逢","text":"半世客孤篷，惊心景不同。\n路危人自恐，港涩橹无功。\n折树龙眠水，长桥虹跨空。\n潮来通海道，争趁一帆风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62775,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"觉报和蒲溪方丈送友归","author":"顾逢","text":"汶阳诗板在，拂拭剑池前。\n欲识无由得，相逢岂偶然。\n溪蒲凉雨后，塞雁断云边。\n又作家山计，巴陵有便船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62776,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送徐阎二游洞霄","author":"顾逢","text":"洞天三十六，大涤景犹希。\n楼阁仙人宅，云霞羽士衣。\n风号松虎啸，雨卷瀑龙飞。\n捣药禽犹在，时闻出翠微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62777,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"候仙亭即事","author":"顾逢","text":"一峰飞到此，胜景幻幽林。\n苍径望不尽，白云行渐深。\n钟声传日午，笠影卸松阴。\n候得神仙否，神仙不可寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62778,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"倚篷","author":"顾逢","text":"山光远近青，尽入倚篷吟。\n夜雨一番过，春流几寸深。\n车声惊睡犊，帆影闪飞禽。\n村舍偏潇洒，家家杨柳阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62779,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"圆池","author":"顾逢","text":"一片水环璧，分明镜可窥。\n游鱼吹白沫，浴鹭扑清漪。\n有月有星夜，无云无雨时。\n倚栏相对处，如看浑天仪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62780,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏菊","author":"顾逢","text":"粲粲发幽芳，何愁午夜霜。\n花先开六月，节不待重阳。\n彭泽应无种，东篱未有香。\n王弘如此见，必遣白衣忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62781,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"徐容斋庭下竹","author":"顾逢","text":"碧玉黄金竹，求来此种难。\n数竿真可爱，几度共相看。\n月影画半幅，风声雨一般。\n岁寒心不改，日日报平安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62782,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"息心","author":"顾逢","text":"诗酒无穷乐，功名陌上尘。\n息心长寿药，瞑目后生身。\n白日一回梦，青山万古春。\n不知天地里，谁是悟空人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62783,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"海东青","author":"顾逢","text":"相传产海东，不与众禽同。\n两翅飞腾去，层霄顷刻中。\n转眸明似电，追马疾如风。\n坠得天鹅落，人皆指远空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62784,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"留别干月亭","author":"顾逢","text":"客中愁送别，临别转伤心。\n最是情相得，犹教老不禁。\n离怀空记忆，远信有浮沉。\n争似长携手，山边水际吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62785,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病中怀邓觉非","author":"顾逢","text":"卧病寂寥中，浮生悟得空。\n半床清夜月，一枕破窗风。\n旅思闻孤笛，秋声过断鸿。\n可人常入梦，簪盍几时同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62786,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鸳鸯梅","author":"顾逢","text":"似厌沙头睡，来栖陇树中。\n一花飞夜雨，双子倚东风。\n冰雪芳心共，池塘旧梦同。\n只愁羌笛响，惊散晓林空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62787,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄王巨卿御史","author":"顾逢","text":"虽然居宪府，只似在家时。\n年老扶筇出，官清借马骑。\n布袍安素分，白发结相知。\n长日关门坐，弹琴与赋诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62788,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄王脩竹","author":"顾逢","text":"小楼分袂后，别久忆君多。\n逆境诗排遣，残躯病折磨。\n静闻花落几，闲看蚁移窠。\n几夜窗前梦，携筇竹下过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62789,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄四明史雪汀","author":"顾逢","text":"每见江湖友，相逢说项斯。\n未能通去信，先得寄来诗。\n汀上雪晴日，山中梅放时。\n何当携手出，同谒老逋祠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62790,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄四明赵秋汀","author":"顾逢","text":"作别踰三纪，飘蓬更陆沉。\n一汀秋夜月，千里故人心。\n有梦长如昔，无书直至今。\n传闻辞禄后，教子老山林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62791,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄宁海诗社诸友","author":"顾逢","text":"旧有诗筒在，读来醒睡魂。\n绿林多事后，白社几家存。\n明月人千里，远山云一痕。\n书成无便寄，心事若为论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62792,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄田润斋道录","author":"顾逢","text":"锐志休官去，皆缘道法灵。\n一符方落笔，万怪已潜形。\n柳下犬迎客，花边鹤听经。\n结交三十载，我醉独君醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62793,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄白莲寺隆虚岩","author":"顾逢","text":"人自菁山出，先须问老师。\n未痊张籍眼，不废贯休诗。\n课佛轮珠滑，翻经破帽攲。\n几年修净业，喜近白莲池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62794,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄宏叟恢上人","author":"顾逢","text":"留吴几两月，每见若亲知。\n却恨临行日，相寻不见师。\n黄花篱下酒，白发坐中诗。\n别后频思忆，书成欲寄谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62795,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄张山居隐君","author":"顾逢","text":"卖卜山中去，逃名竟不闻。\n始终全一节，今古少如君。\n拨火烧黄叶，枕书眠白云。\n恨无薇可采，只食水中芹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62796,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄杜北山","author":"顾逢","text":"住与老逋邻，空湖隔市尘。\n布衣安破屋，白发守清贫。\n引鹤风穿袖，听猿月满身。\n五言吟得苦，一字不投人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62797,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄陈石窗林石田老友","author":"顾逢","text":"典刑惟二老，利禄等鸿毛。\n士行贫中见，诗名犯后高。\n苦心亲笔砚，冷眼看儿曹。\n肥马轻裘辈，多应笑弊袍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62798,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄径山首座","author":"顾逢","text":"双径平分席，丛林总下风。\n东西两班首，兄弟几人同。\n地涌溪云白，潮推海日红。\n不须思出世，只合老山中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62799,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄林平山","author":"顾逢","text":"登高先一日，扶病强相辞。\n几度怀君处，孤灯独坐时。\n炉温馀篆在，鸡唱和声随。\n安得相同醉，狂歌别后诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62800,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄林石田老友","author":"顾逢","text":"西湖惟二老，乍别更伤情。\n诗与何人说，酒无知己倾。\n病躯添药债，夜影对灯檠。\n喜有僧相访，门前日送迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62801,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄金华方养晦","author":"顾逢","text":"懒对青铜镜，羞看两鬓丝。\n自怜垂老日，多有未刊诗。\n短策山林里，孤灯雨雪时。\n苦吟心欲呕，读著转伤悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62802,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄金坛汤进卿","author":"顾逢","text":"几度野窗下，看君所寄诗。\n识韩虽未遂，说项已先知。\n独鹤留晴影，残花怕雨时。\n苦无千里远，每恨纳交迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62803,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄俞半村","author":"顾逢","text":"他无事役心，祇是苦于吟。\n结屋能终隐，入山何必深。\n雨中看瀑布，月下听松琴。\n有此幽居乐，须当一访寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62804,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄秋江许端甫","author":"顾逢","text":"妙年亲雅道，诸老日从游。\n师法林和靖，家声许郢州。\n江湖千里志，风月一襟秋。\n好句人传志，诗名不待求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62805,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄赵西皋先生","author":"顾逢","text":"居官但欲归，每恨去官迟。\n天下苍生福，朝中宰相时。\n龙蛇三寸笔，风月百篇诗。\n此去除书至，难言以病辞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62806,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄赵碧澜 其二","author":"顾逢","text":"琴诗山水乐，顿与世情疏。\n每到相思际，还看所寄书。\n春风肥野蕨，晓雨润园蔬。\n此地能容我，同君一处居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62807,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄赵碧澜右之 其二","author":"顾逢","text":"移家归故第，只在霅溪边。\n旧别无旬日，今回恰数年。\n莺花晴暖际，风雨晦冥天。\n总是思君处，孤吟每日怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62808,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄赵碧澜右之 其一","author":"顾逢","text":"二十年朋友，同吟五字诗。\n琴精毛敏仲，字逼晋羲之。\n多听诸公说，堪为后辈师。\n苕溪深隐好，不欲仕明时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62809,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄徐雪江珦潜山老友","author":"顾逢","text":"雪江连雪巘，天目一般清。\n三老真希有，几年能再生。\n琴中弹自谱，讲外著诗声。\n岂独笺庄老，犹于翰墨精。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62810,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄徐雪江温日观老友","author":"顾逢","text":"诗画琴三绝，乾坤只一身。\n生前长聚首，死后更无人。\n材大身犹寿，名高分合贫。\n自怜传五字，造物亦相嗔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62811,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄损益川","author":"顾逢","text":"休已灯难续，相传喜有师。\n好诗谁共语，妙趣自能知。\n步月频看影，听松无厌时。\n山中名已出，莫悔出山迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62812,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄真觉庵","author":"顾逢","text":"百年如闪电，未可百年期。\n少见回头者，能思瞑目时。\n山林忙不歇，猿鹤冷相窥。\n千里求名客，多应恶子规。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62813,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄黄直斋别驾","author":"顾逢","text":"不道还吴去，知心有故人。\n残灯时对榻，一室夜生春。\n天下襟怀士，诗家骨肉亲。\n槐阴多第宅，谁肯纳闲宾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62814,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄蒋自庵","author":"顾逢","text":"破屋依萧寺，仅能容此身。\n无心长自笑，一语不言贫。\n议论思诸老，交游择好人。\n名门谁解识，帽破与衣鹑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62815,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄谢李雪林","author":"顾逢","text":"日本僧高谊，劳君序拙吟。\n名虽传海外，价不及鸡林。\n白发消豪气，青灯见苦心。\n岂无钟子耳，但欠伯牙琴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62816,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄集庆寺闻碧溪","author":"顾逢","text":"达者古来少，贪心竟莫医。\n尘中何了日，梦里亦忙时。\n富贵人无足，膏肓病不知。\n黄金身外物，万事且随宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62817,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄韩梅居","author":"顾逢","text":"去载书来日，曾回一卷诗。\n每当孤坐处，长忆共吟时。\n春酒花朝曲，秋灯雨夜棋。\n人间无聚散，安得有相思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62818,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄韩简斋","author":"顾逢","text":"年来衰飒甚，伛偻较前增。\n顾影如枯木，梳头似老僧。\n酒杯辞满劝，山路怯先登。\n仅免愁风雨，欢颜得少陵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62819,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄僧钟山净珏","author":"顾逢","text":"忘怀独有师，每恨会时稀。\n作别不得见，相寻闻已归。\n两鸡花下斗，一蝶雨中飞。\n想在陈湖寺，纫衣掩竹扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62820,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄僧珦潜山","author":"顾逢","text":"讲道未凋零，犹堪续祖灯。\n谁知青嶂里，自有白头僧。\n老貌松根石，闲心月下冰。\n往来车马者，应笑倚枯藤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62821,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄碧澜赵右之","author":"顾逢","text":"交游岁月深，彼此各知音。\n佳句不离口，可人长在心。\n多愁悲白玉，一笑弃黄金。\n流水高山乐，床头自有琴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62822,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄题翠侍轩","author":"顾逢","text":"华轩居地隐，尘世总相忘。\n白发坐来久，青山立在旁。\n两峰如拱手，一鹤自升堂。\n唯诺疑相应，松琴奏羽商。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62823,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"断碑","author":"顾逢","text":"此地何时立，相传岁月多。\n仅留残刻在，免得后人磨。\n剥处补苍藓，断痕穿细莎。\n欲知前代事，几度读来讹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62824,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晞渊仲斋避暑","author":"顾逢","text":"避暑来高寺，终朝脱帽翁。\n四檐青嶂下，一枕绿阴中。\n云意看无尽，禽声听不同。\n楼台城市有，何地觅凉风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62825,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅影","author":"顾逢","text":"最喜孤山夜，斜枝月下清。\n透窗疑笔写，映地若天生。\n鹤步踏不动，蜂腰时自横。\n几回云聚散，晦后再分明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62826,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绿阴","author":"顾逢","text":"夏木千重裹，春无迹可窥。\n静如云聚处，动似雨来时。\n坐对清相逼，行吟暑不知。\n幽禽啼复歇，难认著巢枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62827,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"阎静轩先生还吴","author":"顾逢","text":"湖山重作记，当代得名公。\n多有前时事，皆归片石中。\n船头擎白浪，帆腹饱秋风。\n共载还吴□，樽前笑语同。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62828,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪中同郑所南访赵溪梅","author":"顾逢","text":"移宅虽然远，携筇到两回。\n只知相别去，不道又重来。\n溪鲫和冰煮，邻醅带雪开。\n诗家堪入画，满眼玉楼台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62829,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪夜怀赵存我碧澜潜心三昆仲","author":"顾逢","text":"坐久冰生砚，无聊撚白髭。\n友朋上心处，风雪打头时。\n夜永孤灯共，天寒一雁知。\n儿童来膝下，拨火觅蹲鸱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62830,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪夜枕上","author":"顾逢","text":"客楼临水际，转觉夜寒生。\n攲枕天将晓，搜诗睡不成。\n雪多添月色，风近远钟声。\n却喜心无事，梅花纸帐清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62831,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"黄医谕求菊存诗","author":"顾逢","text":"门前三径在，潇洒傍林塘。\n何事惟栽菊，其家本姓黄。\n严霜坚晚节，细雨润幽香。\n指下谁能及，多收起死方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62832,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"堤上","author":"顾逢","text":"堤上喧丝竹，风流几少年。\n衣冠虽较别，山水只如前。\n绿柳阴中马，斜阳影里船。\n晚云眉一抹，横翠断霞边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62833,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寓拥叶精舍","author":"顾逢","text":"禅房静掩扃，长日勘传灯。\n身健高飞鹤，心空入定僧。\n炭烟生湿瘿，檐水滴晴冰。\n从此无依恋，相随只瘦藤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62834,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"斯岩庵","author":"顾逢","text":"舣棹水之涯，重来访可师。\n磬声连古寺，僧语隔疏篱。\n果熟时抛地，花繁欲堕枝。\n三年前到此，不记旧题诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62835,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"湖上","author":"顾逢","text":"湖边春已过，正是绿阴时。\n独步无人处，微吟得意诗。\n斜阳浮舴艋，远水立鸬鹚。\n物命真堪惜，游鱼脱钓丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62836,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"湖上观钓","author":"顾逢","text":"每见湖堤畔，持竿立柳阴。\n不多吞饵者，空起羡鱼心。\n严濑山林石，磻溪岁月深。\n何如池馆上，倚槛看浮沉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62837,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"湖舟","author":"顾逢","text":"箫鼓别船鸣，吟边酒自倾。\n远山多少意，幽鸟两三声。\n风急浪争起，云开雨不成。\n断桥归已晚，塔杪夕阳明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62838,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"湖舟即事","author":"顾逢","text":"楼阁青山里，阑干几处凭。\n乐同湖上酒，清在坐中僧。\n水影飞双蝶，风声磨一鹰。\n夕阳堪入画，金蚓走春冰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62839,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]