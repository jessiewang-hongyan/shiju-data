[{"title":"追记题诗助楼","author":"何梦桂","text":"独自吟诗独倚楼，江山与我两悠悠。\n诗成更不知诗力，烟雨栏干看暮鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34546,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠地理从玉峰","author":"何梦桂","text":"铁鞋踏破问眠牛，茧足归来已倦游。\n四世五公身后事，前冈已分首狐丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34547,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠安禅僧如师","author":"何梦桂","text":"一庵许大且休休，世界三千海一鸥。\n大地山河容不得，住持只在一毛头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34548,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠同舍生","author":"何梦桂","text":"炉亭曾忆看梅花，摇落江湖两鬓华。\n梦断罗浮寒月堕，见梅不认是谁家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34549,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"饯林子敬还闽葬母","author":"何梦桂","text":"几度思亲不见亲，连江万里见南云。\n归来云逐江潮去，却负江头土作坟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34550,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春日出行","author":"何梦桂","text":"浅涧沙平泉脉脉，芳林风软雨垂垂。\n无情落絮知谁管，得意鸣禽各自私。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34551,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"约徐云屿游山中","author":"何梦桂","text":"曾拟幽寻采蕙蘅，开樽奈有主人争。\n明朝重约呼猿鹤，到处云山得散行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34552,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"翌日以触热不及如约再用韵寄之","author":"何梦桂","text":"招得秋风入杜蘅，阴阳金火尚相争。\n雪山冰井清凉界，应笑人间苦热行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34553,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"三用韵","author":"何梦桂","text":"荪壁辛楣屋缭蘅，閒人一榻少人争。\n君来特地平分破，镇断山云不敢行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34554,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠寿岩星学","author":"何梦桂","text":"甘石谈天学不传，谁从太史访星躔。\n阶符色正欃枪伏，试把璇玑测盖天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34555,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠无方普禅师 其一","author":"何梦桂","text":"一喝雷奔万镜空，河沙诸佛落机锋。\n顶门只眼人难觑，山色溪声处处逢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34556,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠无方普禅师 其二","author":"何梦桂","text":"一劄当头奇复奇，箭锋不堕有无机。\n踢翻玉女头盆水，夜半泥牛跨海归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34557,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"禅机四首 其一 俊鹰搏兔","author":"何梦桂","text":"霜风一掣下云霄，两翅雷奔眼电牢。\n狡兔当场难亸避，却教大地鬼神号。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34558,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"禅机四首 其二 一箭双雕","author":"何梦桂","text":"当风劄断二边机，背手乌号鬼莫窥。\n一箭双雕俱堕落，古梅枝上雪参差。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34559,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"禅机四首 其三 一剑倚天","author":"何梦桂","text":"将军一剑倚天开，镇断三军不许回。\n转盼刹那都丧命，机锋直指万人摧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34560,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"禅机四首 其四 金钲一击","author":"何梦桂","text":"一声钲响弭弓刀，万旅归营寂不嚣。\n霜月满城天正午，悠悠旌旆马萧萧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34561,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"伤春志感 其一","author":"何梦桂","text":"陌上花飞春又归，春归人老发垂垂。\n离鸾一去无归路，岁岁花开上故枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34562,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"伤春志感 其二","author":"何梦桂","text":"春归陌上落花多，往事伤心可奈何。\n此意寻常禁不得，九仙山下那堪歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34563,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"感兴","author":"何梦桂","text":"梨花院宇十分春，一片飞花减一分。\n不似山翁头上发，年年添雪上黟云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34564,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"望夫石二首 其一","author":"何梦桂","text":"夫君千里妾重闱，哭尽秋天无雁飞。\n夫不归来身化石，朝朝风雨望夫归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34565,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"望夫石二首 其二","author":"何梦桂","text":"夫不归来误妾身，望夫心未化为尘。\n归来不见生前面，空向山头哭石人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34566,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送分水簿领高君 其一","author":"何梦桂","text":"山泉洗耳澈琼瑩，解听行碑说政声。\n君到汲泉聊一歃，此泉的的似君清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34567,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送分水簿领高君 其二","author":"何梦桂","text":"谁向清溪种柳林，年年送客短长亭。\n亭前系马人多少，独到君来眼倍青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34568,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"早梦初回","author":"何梦桂","text":"天籁刁刁万窍间，几回欲听隔千山。\n蓦然入耳知何处，撞破三生梦觉关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34569,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"安乐窝吟 其一","author":"何梦桂","text":"安乐山前安乐窝，问君安乐意如何。\n黄粱饭饱葵根滑，山北山南听牧歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34570,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"安乐窝吟 其二","author":"何梦桂","text":"安乐山前安乐窝，一窝深处白云多。\n云来云去无人管，閒看虚檐燕葺窠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34571,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄邵琴山","author":"何梦桂","text":"百岁颓波去不还，谁人能铸铁门关。\n世间只有閒中福，不许忙人得自閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34572,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偶成","author":"何梦桂","text":"坐定炉烟歇麝煤，落花飞絮自徘徊。\n闭门尽扫无人迹，尚放营巢燕子来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34573,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠姜墨卿","author":"何梦桂","text":"老尽头颅被墨磨，到头墨更被磨多。\n满堂玉玦今磨尽，尚有閒年买石螺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34574,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠李梅仙谈命","author":"何梦桂","text":"老树孤根占一坡，雪霜奈此白头何。\n自怜南北枝先后，更看人间冷暖多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34575,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"入庵偶成 其一","author":"何梦桂","text":"满园桃李手亲栽，开遍东风藉绿苔。\n惟有木兰情意重，留花犹待主人来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34576,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"入庵偶成 其二","author":"何梦桂","text":"去年燕到主归迟，今日人来燕亦归。\n岁岁成家长孙子，更将短翅傍谁飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34577,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"入庵偶成 其三","author":"何梦桂","text":"春色三分过二分，归来触目见山青。\n鸣鸠乳燕村村闹，不似山中好细听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34578,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"入庵偶成 其四","author":"何梦桂","text":"如此春光冉冉何，青山亦笑发皤皤。\n门前修竹独欢舞，今岁儿孙长最多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34579,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"又四閒 其一","author":"何梦桂","text":"世间万事不如山，老入山来得懒閒。\n岩日三竿才睡觉，不知山外有人寰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34580,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"又四閒 其二","author":"何梦桂","text":"世间万事不如山，趁得渔樵似我閒。\n山上拾薪山下钓，青蓑箬笠暮歌还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34581,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"又四閒 其三","author":"何梦桂","text":"世间万事不如山，输与山中事事閒。\n薇菜藤羹南烛饭，落花涧底弄潺湲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34582,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"又四閒 其四","author":"何梦桂","text":"世间万事不如山，分得心閒眼更閒。\n终日看云閒不去，暮云阅尽鸟飞还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34583,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"四禽吟 雁","author":"何梦桂","text":"云水悠悠万里身，芦花明月落江城。\n从来不带苏郎信，莫与人间受浪名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34584,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"四禽吟 鸥","author":"何梦桂","text":"海边元不为鱼来，力怯江风薄岸回。\n白水苍烟随分足，连云鸷鸟不须猜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34585,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"四禽吟 燕","author":"何梦桂","text":"羽翮冲天势转危，衔泥莫笑尔身卑。\n风雕要避云中箭，祇托梁间不用疑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34586,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"四禽吟 山鸡","author":"何梦桂","text":"自分皋林饮啄宜，犹怜锦绶锦毛衣。\n文华恐被虞罗妒，莫向山前照水飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34587,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"木兰","author":"何梦桂","text":"木兰元是女郎身，千载香魂落软尘。\n曾学男儿解征战，祇今相见似羞人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34588,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"柬王德甫 其一","author":"何梦桂","text":"自入重云深处深，山寒云出已无心。\n自怜鹤骨今憔悴，欲制颓龄少朮参。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34589,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"柬王德甫 其二","author":"何梦桂","text":"蛾眉霜雪隔重闱，采采云英望未归。\n青鸟不来春又去，门前数尽落花飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34590,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"柬王德甫 其三","author":"何梦桂","text":"闻说平安倚竹听，裁书无雁寄云程。\n加餐愿得身强健，尚见藜烟照夜明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34591,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"警世","author":"何梦桂","text":"花颜云鬓眼波秋，元是虚皮裹髑髅。\n黄壤纷纷青草窟，少年曾共醉红楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34592,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自述","author":"何梦桂","text":"妄从缘起本非真，妄里求真妄转深。\n真妄等来无一物，如如自在是真心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34593,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"见李察判竹溪四首 其一","author":"何梦桂","text":"十年江浙说明公，节钺青冥山万重。\n春住钱塘还有脚，新年移得到千峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34594,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"见李察判竹溪四首 其二","author":"何梦桂","text":"千古双台一钓竿，台前阅尽过关船。\n公来满载西湖水，清似山头十九泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34595,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"见李察判竹溪四首 其三","author":"何梦桂","text":"十载风霜敝黑裘，悠悠身世逐浮鸥。\n东陵老去瓜田熟，敢向人间说故侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34596,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"见李察判竹溪四首 其四","author":"何梦桂","text":"百不如人万事休，白头独欠识荆州。\n相逢不觅封侯印，但问君王乞一丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34597,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和何逢原寿母六诗 其一","author":"何梦桂","text":"申国家庭作世程，教儿元不为肥轻。\n高堂鹤发需荣养，捧檄归来一笑生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34598,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和何逢原寿母六诗 其二","author":"何梦桂","text":"九霞斟玉醉淋漓，芝草琅玕青鹿肥。\n庭下阿儿寿慈母，簪花拜舞笑牵衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34599,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和何逢原寿母六诗 其三","author":"何梦桂","text":"春风霞袂玉堂前，绿发童颜谢自然。\n令子重孙拜家庆，阿㜷迎笑掷金钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34600,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和何逢原寿母六诗 其四","author":"何梦桂","text":"千钟三釜异甘酸，此事难同肉眼看。\n多少有羹无母遗，只鸡羞馔亦檀栾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34601,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和何逢原寿母六诗 其五","author":"何梦桂","text":"一官羁缚阻称觞，千里归来足力强。\n潘令閒居元不恶，摘蔬沽酪钓池塘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34602,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和何逢原寿母六诗 其六","author":"何梦桂","text":"六诗称寿祝期颐，子和孙书更两宜。\n四世相看真乐事，他年补作白华诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34603,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和何逢原南山八咏 其一 观颐堂","author":"何梦桂","text":"南山住对北山阳，十亩皋田种稻粱。\n粗饭浊醪随分足，焚香读易日偏长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34604,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和何逢原南山八咏 其二 遐观楼","author":"何梦桂","text":"閒倚阑干水竹间，浮云尽处见青山。\n山前万古行人老，日日林鸦入暮还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34605,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和何逢原南山八咏 其三 涌泉庵","author":"何梦桂","text":"一泓寒碧浸青天，夜静天虚月在泉。\n洗耳莫听人世事，自弹流水和潺湲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34606,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和何逢原南山八咏 其四 濯缨亭","author":"何梦桂","text":"清泉白石此丘隅，谁解尘缨漱玉壶。\n歌罢沧浪千古意，祇今曾见似人无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34607,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和何逢原南山八咏 其五 月坡","author":"何梦桂","text":"一镜天公妒不容，妖蟆食堕此山中。\n琼楼玉宇知何在，空忆明皇到月宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34608,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和何逢原南山八咏 其六 松峦","author":"何梦桂","text":"宰松千尺四时青，松下丰碑马鬣平。\n满地松花人不扫，东风吹老杜鹃声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34609,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和何逢原南山八咏 其七 方池","author":"何梦桂","text":"白藕花飞上玉栏，菰漂黑黍浸云寒。\n鯈鱼自乐鸥忘我，背立西风尽日看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34610,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和何逢原南山八咏 其八 栖云坞","author":"何梦桂","text":"住入山深涧水穷，白头梦不到侯封。\n巴邛橘老人应换，二老如今不再逢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34611,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠松坡","author":"何梦桂","text":"千丈苍龙雪峤孤，翠髯森戟紫鳞枯。\n有心不愿明堂柱，消得人间号大夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34612,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅友竹山居图诗 其一","author":"何梦桂","text":"伐木诗亡冷友盟，交情是处薄秋云。\n寡谐自笑冰霜操，独向天寒见此君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34613,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅友竹山居图诗 其二","author":"何梦桂","text":"自是君家旧托根，君行谁与护重门。\n画图空记筼筜谷，不道如今长子孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34614,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠鹰猎提领刘主簿","author":"何梦桂","text":"平生壮志执金吾，俛首鸾栖岂丈夫。\n鞲上有鹰韬有犬，上林政要打于菟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34615,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送沙溪寓居何翔仲四首 其一","author":"何梦桂","text":"夜半舟移世事非，回头沧海劫尘微。\n千年辽鹤归来晚，畜眼何人识令威。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34616,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送沙溪寓居何翔仲四首 其二","author":"何梦桂","text":"千里关山望白云，归来聊寄倚闾心。\n人生谁解空桑出，感此汍澜泪满襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34617,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送沙溪寓居何翔仲四首 其三","author":"何梦桂","text":"一枕黄粱梦里身，东陵合是种瓜人。\n相逢不用歌招隐，恐被山林唤孔宾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34618,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送沙溪寓居何翔仲四首 其四","author":"何梦桂","text":"自笑衰鸿病起低，更怜落树夜乌啼。\n月明好认南飞去，剩有高枝可择栖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34619,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"郊行即事","author":"何梦桂","text":"东风马耳拂轻寒，柳眼新青雨未乾。\n留客野花遮略彴，狎人溪鸟上阑干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34620,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"忆亡马","author":"何梦桂","text":"垂杨古路策东风，忽忆霜蹄失旧踪。\n白发重来鞯?在，尔应行雨去为龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34621,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠懒然子刘高士二首 其一","author":"何梦桂","text":"翻却丹炉灶息然，青蛇挂壁日高眠。\n玄玄参遍头如雪，始信人间懒是仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34622,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠懒然子刘高士二首 其二","author":"何梦桂","text":"一坞閒云懒出关，惭无肤寸雨人寰。\n君今占断云间卧，却笑游云未得閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34623,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]