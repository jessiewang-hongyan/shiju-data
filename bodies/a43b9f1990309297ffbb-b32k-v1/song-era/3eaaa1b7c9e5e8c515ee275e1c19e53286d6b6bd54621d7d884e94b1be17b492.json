[{"title":"醉落魄 其二 浙江送人，时子振之官越幕","author":"史达祖","text":"江痕妥帖。\n日光熨动黄金叶。\n阑干直下愁相接。\n一朵红莲，飞上越人楫。\n鲤鱼波上丁宁切。\n诗筒如线不曾别。\n明年好个春风客。\n五鹗交飞，身在玉皇阙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22170,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"醉落魄/一斛珠 其一","author":"史达祖","text":"鸳鸯意惬。\n空分付、有情眉睫。\n齐家莲子黄金叶。\n争比秋苔，靴凤几番蹑。\n墙阴月白花重叠。\n匆匆软语屡惊怯。\n宫香锦字将盈箧。\n雨长新寒，今夜梦魂接。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22171,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"燕归梁","author":"史达祖","text":"楚梦吹成树外云。\n乍雁影斜分。\n黄花心事一帘尘。\n但频忆、小腰身。\n今宵素壁冰弦冷，怕弹断、沈郎魂。\n秋衣因甚满愁痕。\n是干预、几黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22172,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"燕归梁","author":"史达祖","text":"独卧秋窗桂未香。\n怕雨点飘凉。\n玉人只在楚云傍。\n也著泪、过昏黄。\n西风今夜梧桐冷，断无梦、到鸳鸯。\n秋钲二十五声长。\n请各自，奈思量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22173,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天 其四 卫县道中，有怀其人","author":"史达祖","text":"雁足无书古塞幽。\n一程烟草一程愁。\n帽檐尘重风吹野，帐角香销月满楼。\n情思乱，梦魂浮。\n缃裙多忆敝貂裘。\n官河水静阑干暖，徙倚斜阳怨晚秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22174,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天 其三","author":"史达祖","text":"搭柳阑干倚伫频。\n杏帘胡蝶绣床春。\n十年花骨东风泪，几点螺香素壁尘。\n箫外月，梦中云。\n秦楼楚殿可怜身。\n新愁换尽风流性，偏恨鸳鸯不念人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22175,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天 其一","author":"史达祖","text":"睡袖无端几摺香。\n有人丹脸可占霜。\n半窗月印梅犹瘦，一律瓶笙夜正长。\n情艳艳，酒狂狂。\n小屏谁与画鸳鸯。\n解衣恰恨敲金钏，惊起春风傍枕囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22176,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"史达祖","text":"遗像人犹思后主。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22177,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送歙砚与裴唐卿","author":"史伯强","text":"平生足迹遍九州，知子笔端回万牛。\n歙砚故持赠，夜光非暗投。\n兹实旧坑子坑尾，远胜洮州绿鸭头。\n清淑之德隐于石，珉中玉表非其俦。\n惨淡风漪生，葱茏云气浮。\n故人初赠我，千金未为酬。\n久磨土灰实砚耻，况拙辞章为砚羞。\n奇宝岂可穷士收，定为神夺鬼所偷，物得其托复何求。\n所以椟而致，贱子不敢留。\n摛藻可以丽春华，学书亦足森银钩。\n百氏之学资芟修，六经之文资校雠。\n虽然吾不愿子以之属文如曹刘，吾不愿子以之奏赋如枚邹。\n愿子提携与之登瀛洲，献可替否近冕旒。\n力陈治安活国谋，以宽吾君宵旰忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22178,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"苏幕遮","author":"史佐尧","text":"柳垂金，梅褪玉。\n昴宿呈祥，符应生公族。\n盖世功名夸九牧。\n黼衮褒扬，庆阀辉南北。\n赐宫醪，分笃。\n天与长生，谩把仙椿祝。\n好继平阳腾茂躅。\n富贵千秋，饮听瑶池曲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22179,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送别严希孟","author":"史声","text":"岁暮送行舟，寒烟古渡头。\n渚禽冲客起，野水带冰流。\n经史探深趣，江山属壮游。\n莫将和氏璧，轻向暗中投。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22180,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题定慧院","author":"史声","text":"寺名定慧知何代，桥古碑横不记年。\n古树乱鸦啼晚照，故园新蝶舞春烟。\n十层宝塔化尘路，五色云衢散上天。\n惟有玉莲池内水，沧浪深处老龙眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22181,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"史声","text":"施食池腥龙戏钵，长明灯暗鼠偷油。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22182,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"独脚令/忆王孙","author":"史远道","text":"墙头梅蕊一枝新。\n宋玉东邻算未真。\n折与冰姿绰约人。\n怯霜晨。\n桃李纷纷不当春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22183,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鼓山","author":"史季温","text":"上到瑶峰第几间，御风骑气渺人寰。\n天高陡觉星辰近，地迥偏饶日月閒。\n去海茫茫疑十里，望州隐隐见三山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22184,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和周丞丈游洞霄韵","author":"史宗恺","text":"苕溪之源流洞天，中有福地寿可延。\n山盘九锁到空谷，石间隐迹知其仙。\n悬崖险阻不易到，来者悚观须有缘。\n道边兽石卧狮虎，庭下镜沼流潺湲。\n东游大涤阻天柱，西至石室飞寒泉。\n云房石磴络苔藓，疑是霞玉留花钿。\n嵌空上下不可数，晓猿夜鹤惊人眠。\n西林诗伯□仙裔，落笔妙句今青钱。\n历穷巘崄事幽讨，不畏蔓草矜蛇蜒。\n皈来诗篇壮青谷，好句屹崛参天全。\n何当□约素秋晚，与公共醉洪崖巅。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22185,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游洞霄和坡仙韵","author":"史宗恺","text":"水非凡浊石非顽，水石萦回九锁间。\n游客步随清浪起，道人身似白云闲。\n仙岩泉滴琼音碎，古木风轻宝盖翻。\n共酌翠蛟亭上酒，翠光相与映红颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22186,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵唐太博重过西湖（尧封嘉猷）","author":"史浩","text":"红尘汩汩解穷年，试说西湖思豁然。\n上下层楼涵倒影，联翩飞鸟没寒烟。\n未须梅萼催诗兴，长有春风在日边。\n安得扁舟去招隐，云窗相对听鸣泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22187,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"史定之","text":"一堤杨柳月，十里芰荷风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22188,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽崔舍人 其二","author":"史弥大","text":"忆昨登瀛日，相亲意最深。\n耽书加我癖，体国见君心。\n遽就黄粱梦，空遗丹扆箴。\n堂堂那复有，衰涕泫沾襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22189,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽崔舍人 其一","author":"史弥大","text":"在昔誇三喜，于今萃一门。\n周还陪帝学，终始代王言。\n晋擢倾人望，规陈悉治原。\n彼苍无处问，才大合调元。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22190,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谒越公墓","author":"史弥大","text":"满眼松楸护石茔，此来倍觉暗伤情。\n烟云深处眠翁仲，俎豆香时荐特牲。\n一寺近回溪水曲，万山青向墓门横。\n杨花无限萦春思，送我轻舟十里程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22191,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丁丑岁中秋日劭农于城南得五绝句 其一","author":"史弥宁","text":"楚俗秋来也劝耕，西风招我出郊坰。\n此行不负寻诗眼，队队云山拥画屏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22192,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丁丑岁中秋日劭农于城南得五绝句 其五","author":"史弥宁","text":"箯舆幸自到山南，尚有清杯可共衔。\n何似更行三二里，大家相伴看云岩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22193,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丁丑岁中秋日劭农于城南得五绝句 其四","author":"史弥宁","text":"家家童稚笑迎门，接得翁归酒半醺。\n邻舍相呼来屋里，听翁解说劝农文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22194,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丁丑岁中秋日劭农于城南得五绝句 其三","author":"史弥宁","text":"人事当先莫靠天，蚤修陂堰贮清泉。\n来年未必晴明久，万一晴明溉得田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22195,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丁丑岁中秋日劭农于城南得五绝句 其二","author":"史弥宁","text":"说似田家好著忙，剩培宿麦接青黄。\n定知不落薰风后，万垄晴催煮饼香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22196,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又次韵杨梅三绝句 其二","author":"史弥宁","text":"桃李漫山等俗流，诸杨汝是荔支俦。\n当时若贡长生殿，又得真妃笑点头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22197,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又次韵杨梅三绝句 其一","author":"史弥宁","text":"财到南村六月时，累累红紫玉低垂。\n筠笼送似露犹湿，更费支郎七字诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22198,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又次韵杨梅三绝句 其三","author":"史弥宁","text":"酿蜜搓成绛雪团，莫嫌风味欠儒酸。\n此诗此果君知么，一样骊珠粲玉盘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22199,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丫头岩","author":"史弥宁","text":"山前露立几时休，老大垂髫羞不羞。\n与汝云冠别梳洗，免教人唤作丫头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22200,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小轩窠石","author":"史弥宁","text":"密傍轩窗开小池，巧安窠石俯清漪。\n道人不爱闲花草，祇种瓶蕉和水栀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22201,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书苏道士江行图后 其三","author":"史弥宁","text":"飘然云鹤老江湖，匠出烟波绝世无。\n一见昏眸为渠豁，半生空挂辋川图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22202,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书苏道士江行图后 其一","author":"史弥宁","text":"叟也胸中天地宽，云烟衮衮出毫端。\n如何万里经行处，不费晴窗半日看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22203,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书苏道士江行图后 其二","author":"史弥宁","text":"诗酒漂零自在身，吴樯楚柂往来频。\n拂开数匹临川纸，一一江山是故人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22204,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"无诗","author":"史弥宁","text":"合向青林岸幅巾，却来闹里著吟身。\n竹君门外私相语，两日无诗羞杀人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22205,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"木犀 其二","author":"史弥宁","text":"寿藤伴我倚秋风，老去无诗意转慵。\n只是看花非觅句，清香错认恼冲龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22206,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"木犀 其一","author":"史弥宁","text":"一段长长寂寞秋，著鞭芙菊尚包羞。\n搀先饱绽黄金粟，不落西风第二筹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22207,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"木犀重开","author":"史弥宁","text":"不见岩犀整一秋，厌厌对我诉清愁。\n公筵馀沥何曾见，两度开花只暗投。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22208,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"火云","author":"史弥宁","text":"酷甚骄阳似杜周，火云焰焰雨悠悠。\n平畴龟兆何曾润，蒸得田夫汗转流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22209,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"东林云上人见过","author":"史弥宁","text":"瘦藤十载别康庐，五老山中安稳无。\n霜后诗禅来访我，为言面目带清臞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22210,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"东湖汎舟","author":"史弥宁","text":"扁舟去稳似乘槎，瞥眼轻鸥掠浪花。\n绝爱陶公山尽处，淡烟斜日几渔家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22211,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"归航","author":"史弥宁","text":"春岸移舟雪半消，长年忍冷转塘坳。\n数声鸦轧催归橹，属玉惊飞上柳梢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22212,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"伊谁","author":"史弥宁","text":"伊谁闯我小窗关，偷却西楼一面山。\n谇语白云猜是汝，秋风出意急追还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22213,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再入湖南境","author":"史弥宁","text":"我本人间有发僧，只堪林下续传灯。\n君恩强遣司民社，千里江山笑不能。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22214,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再赋晏子直百花林","author":"史弥宁","text":"为报风流元献家，丁宁百卉驻春华。\n侬归载酒溪园去，一首诗吟一种花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22215,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吊和靖","author":"史弥宁","text":"风林辊雪冷惊鸦，来吊孤山处士家。\n只有寒泉欠秋菊，一杯聊复荐梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":