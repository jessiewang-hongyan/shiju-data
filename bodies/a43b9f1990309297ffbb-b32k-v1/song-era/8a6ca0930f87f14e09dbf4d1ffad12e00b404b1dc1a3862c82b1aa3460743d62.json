e":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78371,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"洁泉","author":"曾协","text":"绝爱泓然一鉴渟，肯教尘土犯清泠。\n祇缘较德先生似，不为争名陆羽经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78372,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送王炎弼赴山阳守以兵卫森画戟宴寝凝清香为韵十首 其十","author":"曾协","text":"壶矢新油幕，春芜旧战场。\n候亭閒夜柝，归袖著天香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78373,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送王炎弼赴山阳守以兵卫森画戟宴寝凝清香为韵十首 其九","author":"曾协","text":"复旦风云合，丹心日月明。\n江神回朗照，霁色向来清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78374,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送王炎弼赴山阳守以兵卫森画戟宴寝凝清香为韵十首 其八","author":"曾协","text":"疆事须长算，朝家得实能。\n坐来酬万务，心地自虚凝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78375,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送王炎弼赴山阳守以兵卫森画戟宴寝凝清香为韵十首 其七","author":"曾协","text":"楚国尚勇力，秉羽而甘寝。\n虽无倒载名，胜饮怀安鸩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78376,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送王炎弼赴山阳守以兵卫森画戟宴寝凝清香为韵十首 其六","author":"曾协","text":"平生功名心，不肯事酣宴。\n向来话淮南，山川眼中见。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78377,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送王炎弼赴山阳守以兵卫森画戟宴寝凝清香为韵十首 其五","author":"曾协","text":"公家西州烈，武事冠方册。\n祖孙世有人，要足门三戟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78378,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送王炎弼赴山阳守以兵卫森画戟宴寝凝清香为韵十首 其四","author":"曾协","text":"诗成啸诺馀，谋出壶觞暇。\n却整进贤冠，麒麟要图画。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78379,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送王炎弼赴山阳守以兵卫森画戟宴寝凝清香为韵十首 其三","author":"曾协","text":"公材如武库，剑槊方森森。\n亦复擅风流，坐继正始音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78380,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送王炎弼赴山阳守以兵卫森画戟宴寝凝清香为韵十首 其二","author":"曾协","text":"别兄今几时，邦人指难弟。\n莫诵海沂康，两冯如鲁卫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78381,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送王炎弼赴山阳守以兵卫森画戟宴寝凝清香为韵十首 其一","author":"曾协","text":"盛世须材杰，高名动圣明。\n一麾淮海去，青旆拥千兵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78382,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"荻华渚","author":"曾协","text":"摇摇小渚荻初成，远意浑疑接洞庭。\n准拟秋来看积雪，更和风雨醉时听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78383,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偶作二首 其二","author":"曾协","text":"世人言语尽君房，一一班联玉殿香。\n解识逍遥浑一致，水凫非短鹤非长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78384,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偶作二首 其一","author":"曾协","text":"身閒赢得闭斋房，不向尘中染色香。\n静处试寻真面目，光阴非短亦非长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78385,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]