[{"title":"送张无梦归天台","author":"曾会","text":"九重留不住，乘兴返天台。\n青嶂未为静，彤庭应更来。\n御歌编隐诀，卧榻近丹台。\n衣袂含香气，蓬莱醉几回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78311,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"香积寺","author":"曾会","text":"松门石径乱云粘，四顾蓝光冷射檐。\n锁雾楼台阴自润，啸风猿鸟韵相兼。\n寒岩路僻凭僧指，古篆香残待客添。\n须信苾刍堪爱处，满阶芳草正纤纤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78312,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题法华山天衣寺","author":"曾会","text":"十里湖光十里松，松阴路到十高峰。\n窗看渡口随湖月，楼听云门度岭钟。\n梁帝钵含山雨润，普贤台锁藓花重。\n谁人的是忘机子，香稻寒蔬养瘦容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78313,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题仙都山二首 其一","author":"曾会","text":"时常展画图，今喜到仙都。\n尽得烟霞景，方知手笔粗。\n擎天成一柱，镇地出三吴。\n苔片封车辙，莲香泛鼎湖。\n占风来海国，迎日上云衢。\n似笋千寻直，如蓝四面铺。\n秀能通造化，高岂碍抟扶。\n雷雨生岩窦，星辰绕药炉。\n金华惭叱石，玉女望投壶。\n观古坛尤在，碑荒字半无。\n未曾迷阮肇，何倦醉麻姑。\n尘外标名异，空中立影孤。\n笑秦铭泰岳，嫌舜葬苍梧。\n夏月风长满，秋霜草不枯。\n步虚吟羽客，滴翠湿樵夫。\n独称瀛洲侣，吟看典郡符。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78314,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重登萧相楼","author":"曾会","text":"不见当年李翰林，江天为我结层阴。\n九华门外柳三尺，萧相楼前松千寻。\n物在人亡空有泪，时殊事变独伤心。\n只鸡斗酒江干市，白首风前楚些吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78315,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄泉僧定诸","author":"曾会","text":"赤城山去刺桐城，还往都无一月程。\n日日焚香遥稽首，五更河露湿人衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78316,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"曾会","text":"松间忽被青童指，金箓犀仙第二人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78317,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"金精山","author":"曾兴宗","text":"投老筼筜幸卜邻，蜗蝇更不累闲身。\n烟霞已作仙凡隔，洞户蟠桃不计春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78318,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水竹幽居堂","author":"曾兴宗","text":"山深景最幽，正为幽人设。\n获此一段奇，天意亦特达。\n水清濯吾缨，竹劲抱高节。\n凿池为延客，筑室相娱悦。\n故人来清风，莫逆友明月。\n雅与仙境连，迥隔红尘绝。\n此乐只自知，切勿与人说。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78319,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"筼筜谷","author":"曾兴宗","text":"渭川千亩竹，可比万户侯。\n我有筼筜谷，此岂为食谋。\n南山与北山，清绝真胜游。\n飞泉助萧爽，怪石添清幽。\n娱亲自足乐，捧檄良可羞。\n日从抱节君，崎岖经林丘。\n有酒对尔酌，得句为尔讴。\n共结岁寒心，肯学炎凉俦。\n笑指亲密友，不独王子猷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78320,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上平江徐侍郎十绝句 其九","author":"曾协","text":"拥麾仗节往来频，抚字澄清处处新。\n想见兹辰介眉寿，遥应驩动几州人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78321,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上平江徐侍郎十绝句 其八","author":"曾协","text":"雅歌字字巧安排，争颂君王治道谐。\n好把抉猊奔骥手，大书深刻著悬崖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78322,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上平江徐侍郎十绝句 其六","author":"曾协","text":"绕郭旧称家十万，朝天常恨驿三千。\n而今已是繁华倍，更觉旌麾近日边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78323,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上平江徐侍郎十绝句 其二","author":"曾协","text":"声华奕世擅江南，谁似公家伯仲间。\n想见当年育英物，高秋爽气满西山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78324,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上平江徐侍郎十绝句 其四","author":"曾协","text":"并列西京侍从多，吾丘司马岂同科。\n孤忠祇有囊书在，独见丁宁为偃戈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78325,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上平江徐侍郎十绝句 其三","author":"曾协","text":"盛德由来自邈绵，偃王功德至今传。\n朱弓赤矢符嘉瑞，留得阴功不计年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78326,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上平江徐侍郎十绝句 其七","author":"曾协","text":"不但宽平似有功，笔端重睹建安风。\n邦人竞劝金钟釂，愿见君侯圣一中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78327,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上平江徐侍郎十绝句 其五","author":"曾协","text":"五湖城郭带重楼，幕府初开第一州。\n燕寝香凝了无事，四郊禾穗自盈畴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78328,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上平江徐侍郎十绝句 其十","author":"曾协","text":"槐鼎虚班侧席求，已应难遂寇恂留。\n不如黄发貂蝉底，长占青云最上头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78329,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上平江徐侍郎十绝句 其一","author":"曾协","text":"露华先遣曲尘收，要产英豪奠九州。\n织女槎回逢八月，老人星见恰中秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78330,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小山丛桂","author":"曾协","text":"暗绿团团树，浮苍浅浅山。\n不须吟些些，幽韵已班班。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78331,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山云","author":"曾协","text":"自耸干霄势，应怜望岁心。\n试将肤寸泽，来作济时霖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78332,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"月夜再和","author":"曾协","text":"月当亭午憩纤阿，拟逐香风到大罗。\n急作新诗报天上，更凭阿监一声歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78333,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再和前韵三首 其三","author":"曾协","text":"猛士相逢亦破颜，恰如组练壮师干。\n谁令野宿三更月，缀铁成衣彻骨寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78334,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再和前韵三首 其二","author":"曾协","text":"幽姿健骨两相看，二绝真成聚莫干。\n好学纫兰供楚佩，琼琚端可胜金寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78335,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再和前韵三首 其一","author":"曾协","text":"骚人岂作腐儒酸，逸气清霄坐可干。\n东阁只今诗兴动，韩豪元不似郊寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78336,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"老农十首 其十","author":"曾协","text":"淮上营屯尽偃戈，官军从此罢经过。\n且书太史丰年瑞，不数周公异亩禾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78337,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"老农十首 其九","author":"曾协","text":"儿孙力作莫辞勤，仁政如天四海春。\n尽说干汤功已就，泽流莘野并耕人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78338,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"老农十首 其八","author":"曾协","text":"饱食丰年酒不空，水村山崦老于农。\n囷仓在眼心无事，邻里经过乐岁穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78339,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"老农十首 其七","author":"曾协","text":"归牛将犊茅檐晚，饥鸟窥人稻圃秋。\n准拟明年大作社，鸡豚须养秫须留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78340,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"老农十首 其六","author":"曾协","text":"敢将体足惮沾涂，日日高原带雨锄。\n乞与丰年酬作苦，也知天意解乘除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78341,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"老农十首 其五","author":"曾协","text":"田畴总是十分苗，处处逢人意气骄。\n不问神祠赛箫鼓，君臣有道四时调。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78342,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"老农十首 其四","author":"曾协","text":"闻说边隅长草莱，汉家肤使漠南回。\n黍苗正自归仓廪，不怕西风卷地来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78343,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"老农十首 其三","author":"曾协","text":"朝家宽诏年年下，天上秋阳日日明。\n租税入官公事了，壤歌递与子孙赓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78344,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"老农十首 其二","author":"曾协","text":"荷笠腰镰醉里回，和衣卧处息如雷。\n定无门外催租吏，赢得柴荆日晏开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78345,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"老农十首 其一","author":"曾协","text":"雨带好风匀净绿，云开暖日染娇黄。\n今年不识农家苦，总把阴晴属上苍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78346,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西溪冬夜","author":"曾协","text":"并堤松柏与云齐，月夜青山一望低。\n山鸟不惊人迹绝，步随流水到前溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78347,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"李粹伯命赋枕流已读佳篇不容著语戏书二伽陀问之 其一","author":"曾协","text":"六尺玲珑日日开，个中那解著纤埃。\n主人无耳谁求洗，试问声从何处来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78348,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"李粹伯命赋枕流已读佳篇不容著语戏书二伽陀问之 其二","author":"曾协","text":"水轩宴坐死灰同，一息呼号万窍风。\n纵有溪流清似镜，不知何处洗虚空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78349,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"芭蕉","author":"曾协","text":"炎蒸谁解换清凉，扇影摇摇上竹窗。\n准拟小轩添睡美，梦成风雨夜翻江。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78350,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和史侍郎游澹岩韵六首 其六","author":"曾协","text":"眼看岩石千寻起，面对炉烟一缕轻。\n顿觉世缘无染著，个中消息有谁明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78351,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和史侍郎游澹岩韵六首 其五","author":"曾协","text":"我公得入如来室，心镜常明不用磨。\n好倚悬崖结趺座，任从来者问云何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78352,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283