[{"title":"阙题","author":"王禹称","text":"□□□□□□□，□□□□□□□。\n□□□□带嫩芽，不是贰车无此兴。\n此□□□□□□，□□□□□□□。\n□□□□□□□，□□□□□□□。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34951,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"阙题 其一","author":"王禹称","text":"□□□□□□□，□□□□□□□。\n□□□□□□□，□负秾华一句无。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34952,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其三","author":"王禹称","text":"诗情不负齐安郡，杜牧当年与我齐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34953,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其十一","author":"王禹称","text":"一回酒渴思吞海。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34954,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二十九","author":"王禹称","text":"绣服霍嫖姚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34955,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题张公洞","author":"张维","text":"年来行乐与民同，探穴追踪太史公。\n幽洞初开名易著，苍崖新刻句难工。\n风驱俗驾松扉外，云锁仙丹石室中。\n付与山僧司管钥，勿教胜地草蒙茸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34956,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵同经略舍人登七星山","author":"张维","text":"列岫凌虚滃翠岚，龙泓澄澈七星涵。\n岩瞻好向西湖看，飞去何妨自岭南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34957,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"睢阳五老会诗","author":"王涣","text":"分曹归政养耆年，李下何由更正冠。\n贤相赋诗同啸傲，圣君优诏去盘桓。\n庞眉老叟俱称寿，凌雪乔松岂畏寒。\n屈指五人齐五福，乡人须作二疏看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34958,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"昭庆寺看芍药","author":"王涣","text":"一半春光过牡丹，又开芍药遍禅关。\n久辜佳约违莲社，今续清欢到宝阑。\n垂露几团花面湿，东风一阵燕泥寒。\n酒边何味呈奇供，绿笋朱樱正满盘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34959,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其三","author":"苏易简","text":"虾须半卷天香散。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34960,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"暮秋过沈齐别业","author":"赵湘","text":"暮蝉频响胜闻歌，白石床清藓色和。\n径冷独留寒菊在，树疏分得夕阳多。\n沙泉月澹曾栖雁，篱落烟微半著莎。\n谁问寂寥诗景趣，竹扉时有野僧过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34961,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送李主簿之任南陵","author":"魏野","text":"无叹徒劳向宦途，不群气岸有谁如。\n南陵暂掌仇香印，北阙终行贾谊书。\n且喜江山寻胜境，莫辞韦杜别幽居。\n少年跃马同星使，免得诗中道跨驴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34962,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"远行","author":"胡宿","text":"古有悲秋篇，远行第三句。\n人情重辞家，客意倦长路。\n征马陟前冈，栖乌集乔树。\n惨淡层阴生，号呼劲风怒。\n匣琴徒自携，杯酒与谁遇。\n衣带缓于前，衣香非复故。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34963,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"百舌鸟","author":"魏野","text":"长截邻鸡叫五更，数般名字百般声。\n饶伊饶舌争先晓，也待青天明即鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34964,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游瞩","author":"胡宿","text":"旻宇斗澄霁，池台始登临。\n幽芳无艳质，爽籁有真音。\n閒云乍明灭，寒鶒忽浮沈。\n青山晴好望，白道细堪寻。\n疏蝉嘒急管，跃鲤应鸣琴。\n微风猎椒桂，快哉一披襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34965,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"野庐","author":"胡宿","text":"休舍松石间，外物不可必。\n一马究微言，五禽治生术。\n仁智得所庐，吉祥来此室。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34966,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"珍禽亭","author":"胡宿","text":"仁人坐高斋，忘机宅真粹。\n鱼鸟沐馀恩，树石蒙善气。\n珍哉岛上禽，托身良得地。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34967,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"静斋","author":"胡宿","text":"铃阁侍卫稀，幕府文书省。\n石上试真茶，松间移小鼎。\n吏师所至清，仁者本便静。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34968,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"惜花亭","author":"胡宿","text":"层阴养花天，亭榭多春色。\n午气入衣香，东风吹酒力。\n眷恋冶城游，黄金良易得。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34969,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题斋馆","author":"胡宿","text":"东南有仙人，玉案经近侍。\n为爱飞来峰，翻然下平地。\n白云相与栖，绛雪居尝饵。\n日作冷泉游，时寻径山醉。\n径山有五峰，参差标紫翠。\n西山玉芝岩，缥缈多云气。\n岩间名胜僧，除馆待公至。\n施树得楩楠，开轩对松桂。\n啼鸟傍檐楹，鸣泉落阶砌。\n藓径阔三条，篮舆时一诣。\n汲井试茶腴，援琴和松吹。\n荣启老来歌，华胥午间睡。\n追随支许游，啸咏羲皇治。\n武林贤主人，官仪斗枢贵。\n同是老成人，俱怀方外志。\n流水与断墁，神交复心契。\n数幅伻山图，三伏挂厅事。\n长谣紫芝曲，远寄青霞意。\n他年羾赤霄，定挹浮丘袂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34970,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题饮光亭","author":"胡宿","text":"林风引石溜，席上清且寒。\n主人白羽扇，觞客水精盘。\n弦歌泛宫羽，酒面生波澜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34971,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送客","author":"胡宿","text":"秋意不自适，况复登河梁。\n眷言送归客，徙倚见斜阳。\n杂佩解席上，斑骓嘶路傍。\n风云感素节，弦管思清商。\n菊残馀老蕊，蕙晚非新香。\n何以致叩叩，临行持一觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34972,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"李维","text":"故宫芳草在，往事暮江流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34973,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春睡","author":"寇准","text":"春力著人春睡重，叶底黄鹂鸣自送。\n绿幕朱栏日观明，回廊侧户风帘动。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34974,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"唐施肩吾山居有感","author":"陈尧佐","text":"幽居正想餐霞客，夜久月寒珠露滴。\n千年独鹤两三声，飞下岩前一枝柏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34975,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"洞霄宫 其四","author":"陈尧佐","text":"萧萧红树碧峰前，为爱桃花入洞天。\n偶逐霓旌才百步，却忧人世已经年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34976,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"张公洞","author":"陈尧佐","text":"空山杳杳鸾凤飞，神仙门户开翠微。\n主人白发云满衣，松间留我谈玄机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34977,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"陈尧佐","text":"莫愁调鼎事无功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34978,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其五","author":"陈尧佐","text":"君恩来万里，客路出千山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34979,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其五","author":"李堪","text":"海月随帆落，溪花绕驿流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34980,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"柳 其一","author":"丁谓","text":"杨柳郁氤氲，金堤总翠氛。\n庭前花类雪，楼际叶如云。\n列宿分龙影，芳池写凤文。\n短箫何以奏，攀折为思君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34981,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄孙仲簿公","author":"林逋","text":"低折沧洲簿，无书整两春。\n马从同事借，妻怕罢官贫。\n道僻收閒药，诗高笑古人。\n仍闻长吏奏，表乞锁厅频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34982,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠任懒夫","author":"林逋","text":"未肯求科第，深坊且隐居。\n胜游携野客，高卧看兵书。\n点药医闲马，分泉灌晚蔬。\n汉廷无得意，谁拟荐相如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34983,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"尝茶次寄越僧灵皎","author":"林逋","text":"白云峰下两枪新，腻绿长鲜谷雨春。\n静试恰如湖上雪，对尝兼忆剡中人。\n瓶悬金粉师应有，箸点琼花我自珍。\n清话几时搔首后，愿和松色劝三巡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34984,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其七","author":"刘筠","text":"捲衲城钟断，支筇岳雨寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34985,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"药名诗","author":"陈亚","text":"地居京界足亲知，倩借寻常无歇时。\n但看车前牛领上，十家皮没五家皮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34986,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"彭山赠贯之","author":"胡宿","text":"彭山隔重湖，落日见孤塔。\n扬舲入空旷，烟树散鹅鸭。\n山中老臞仙，万顷纤芥纳。\n乘风落珠唾，暝色远相答。\n平生尔汝分，磁铁契已狎。\n万缘一笑空，个处无剩法。\n方舟过谷隐，风雨寒霎霎。\n黎明带星归，尚及斋鼓踏。\n临岐戒后会，梅熟新秧插。\n期我散缣楮，莫忘鸥盟歃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34987,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"太常乐章又七首 其五 奉币","author":"杨亿","text":"醴齐良洁，有牲斯纯。\n大采玄冕，乃昭其文。\n王宫定位，粢盛苾芬。\n民事以叙，玄德升闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34988,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"长洲 其二","author":"杨备","text":"花光带露柳凝烟，茂苑笙歌已沸天。\n有客寻春拚一醉，青楼红粉洞中仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34989,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秦淮","author":"杨备","text":"一气东南王斗牛，祖龙潜为子孙忧。\n金陵地脉何曾断，不觉真人已姓刘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34990,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"直渎","author":"杨备","text":"昼役人功夜鬼功，阳开阴阖几时终。\n不闻掷土江中语，争得盈流一水通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34991,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"北渠","author":"杨备","text":"金殿分来玉砌流，黑龙湖撒凤池头。\n后庭花落恩波断，翻与南塘作御沟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34992,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"半阳湖","author":"杨备","text":"江南龙节水为乡，水不纯阴有半阳。\n一片湖光共深浅，两般泉脉异温凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34993,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"石头城","author":"杨备","text":"五城楼雉各相望，山水英灵宅帝王。\n此地定由天造险，古来长恃作金汤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34994,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄刘处士","author":"释惟凤","text":"度月阻相寻，应为苦雨吟。\n井浑茶味失，地润屐痕深。\n鸟背长湖色，门间古树阴。\n想君慵更甚，华发昼方簪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34995,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠维阳吕为处士","author":"释惟凤","text":"为儒师古道，清苦少人知。\n心散暂因酒，鬓班多为诗。\n著书秋阁静，晒药夕阳迟。\n何必文明代，垂钩渭水湄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34996,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"效古","author":"释惠崇","text":"清都绿玉树，灼烁瑶台春。\n攀花弄秀色，远赠天仙人。\n香风送紫蕊，直到扶桑津。\n取掇世上艳，所贵心之珍。\n相思传一笑，聊欲示情亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34997,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二十","author":"释惠崇","text":"白浪分吴国，青山隔楚天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34998,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其四十五","author":"释惠崇","text":"松风吹发乱，岩溜溅棋寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34999,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其七十一","author":"释惠崇","text":"圭窦先知晓，盆池别见天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35000,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其八十七","author":"释惠崇","text":"远屿迎樯出，寒林带岸回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35001,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"草","author":"释怀古","text":"漠漠更离离，闲吟笑复悲。\n六朝争战处，千载寂寥时。\n阵阔围空垒，丛疏露断碑。\n不堪残照外，牧笛隔烟吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35002,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"池上","author":"曹修古","text":"荷叶罩芙蓉，员香映嫩红。\n佳人南陌上，翠盖立春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35003,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"早梅","author":"王曾","text":"雪压乔林冻欲摧，始知天意欲春回。\n雪中未问和羹事，且向百花头上开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35004,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其五","author":"王曾","text":"欲谢君恩却无语，心前笑指赤灵符。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35005,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题山宫法安院 其二","author":"章得象","text":"山家门径锁寒松，更向烟萝第几重。\n幽鸟啼花归旧谷，应龙飞雨过前峰。\n分持皂盖歌千骑，入冠黄扉禄万钟。\n一见高吟重兴感，清名长在木阴浓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35006,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其六","author":"章得象","text":"千寻练挂双流瀑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35007,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"长平","author":"杜衍","text":"冯亭献地豹言非，秦间廉颇又不疑。\n四十万兵降死后，浑输括母一先知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35008,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送毛得一秀才归淮上 其二","author":"穆脩","text":"君归迢递淮西路，我客萧条秋浦城。\n恻恻相看复恻恻，行行送别重行行。\n途中猿鸟哀声断，马上云山远碧横。\n富贵穷通俱未决，直倾樽酒沃离情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35009,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"一百五日同周越陈永锡游吉祥僧舍","author":"穆脩","text":"痛饮方期数百杯，寻芳何事又空回。\n花愁酒困春无著，却讶野僧萧寺来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35010,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"思边","author":"穆脩","text":"去年何时君别妾，南园绿草飞蝴蝶。\n今岁何时妾忆君，西山白雪暗秦云。\n玉关此去三千里，欲寄音书那可闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35011,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"忆越州 其二","author":"吕夷简","text":"云门雪窦阻清赏，恍然目想心如遗。\n前溪后溪月上处，千山万山花发时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35012,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"吕夷简","text":"自恨捲帘人已老。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35013,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"僧问四宾主因而有颂颂之 其二","author":"释重显","text":"宾中之宾，少喜多瞑。\n丈夫壮志，当付何人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35014,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"僧问四宾主因而有颂颂之 其四","author":"释重显","text":"宾中之主，玄沙猛虎。\n半合半开，唯自相许。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35015,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"僧问四宾主因而有颂颂之 其六","author":"释重显","text":"主中之宾，温故知新。\n互换相照，师子嚬呻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35016,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"僧问四宾主因而有颂颂之 其八","author":"释重显","text":"主中之主，正令齐举。\n长剑倚天，谁敢当禦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35017,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"赵世长","text":"玉清仙子下云逵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35018,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诗一首","author":"晁宗悫","text":"鍊矿成金得宝珍，鍊情成性合天真。\n相逢此理交谈者，千百人中无一人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35019,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其八","author":"夏竦","text":"气凌云梦吞八九，欲与溟渤争雌雄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35020,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"虎啸岩","author":"黄鉴","text":"探奇乍入升真洞，泛度先来觅虎溪。\n劈立高岩容广厦，纡回流水称幽栖。\n楼台错落通窗牖，石磴参差藉杖藜。\n无数风光供骋望，更闻山鸟向林啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35021,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送僧偈","author":"释惟政","text":"山中何所有，岭上多白云。\n祇可自怡悦，不堪持赠君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35022,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"经照湖方干旧居","author":"吴遵路","text":"磻溪垂钓者，终得展其才。\n何事先生隐，不逢明主来。\n泉声秋雨歇，月色夜云开。\n对此空惆怅，吟魂早晚回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35023,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其九","author":"齐唐","text":"唯有梅花报春早，雪中传信过江干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35024,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"苏州十咏 其三 洞庭山","author":"范仲淹","text":"吴山无此秀，乘暇一游之。\n万顷湖光里，千家橘熟时。\n平看月上早，远觉鸟归迟。\n近古谁真赏，白云应得知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35025,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"依韵酬府判庞醇之见寄 其二","author":"范仲淹","text":"吴门歉岁减繁华，萧索专城未足誇。\n柳色向秋迎使馆，水声终夜救田车。\n丘山在负思朝寄，毫发经心愧道家。\n不似桐庐人事少，子陵台畔乐无涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35026,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]