[{"title":"留题翠峰","author":"王洋","text":"陶朱山下金仙宅，云是当年故相家。\n去国岂知传貌象，扁舟端自访烟霞。\n平吴霸越功何在，吊古伤今事可嗟。\n早是登临饶客泪，几行征雁落寒沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17599,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留赠太平刘道士","author":"王洋","text":"早岁希夷合道真，八年静默已全神。\n收还赤子无为境，留得丹霄自在身。\n独与老庄谈妙理，不分儒释是殊伦。\n有时醉露真消息，流水桃花不误人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17600,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留赠道场老慧苦眼疾","author":"王洋","text":"云中白鹤塔千寻，为众同南古到今。\n五百年来一声锡，四禅天外百花林。\n长眉白黑归宗眼，苦口因缘黄蘖心。\n方见道场多胜境，尽情呈现付知音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17601,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病眼","author":"张方平","text":"飞花无复数，遇物辄成双。\n书画疏幽阁，屏帏恋北窗。\n懒开辞俗客，写望忆秋江。\n椒菊供朝饵，犹须发酒缸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17602,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"酒熟未酌乡人次第固未及伯氏伯氏因失酒以诗谪之谨继韵解嘲","author":"王洋","text":"满盎浓薰霭绿云，可怜珍韵不长存。\n病妻功罢初尝液，壮士酣馀更破樽。\n千日留春传古昔，一宵遗爱有瓶盆。\n明朝试榜扬雄宅，恐有壶车忽到门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17603,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"高民瞻以前韵作诗因酬","author":"王洋","text":"钓叟生涯止一舠，兴来犹复醉陶陶。\n知君自欲营新筑，继世那闻有旧皋。\n野性素来便野趣，春山唯恐欠春醪。\n果能过我论文字，且拟张帆看怒涛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17604,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄丁执中","author":"王洋","text":"米盐煎蹙意何如，尽日逍摇不费书。\n债作拘留身莫赎，诗成困痼力难除。\n事钱不谨兄移爱，与世留心客有馀。\n幸各身闲好同伴，相思如许却相疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17605,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄永新元老元书云已辞广孝复归禾山白云矣","author":"王洋","text":"已尚清高久，须教去住艰。\n强分云出岫，终放鹤归山。\n烟带重岚润，衣侵雾雨斑。\n轻身如有药，犹恐费跻攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17606,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄刘行简","author":"王洋","text":"西来有客解归装，先说东台白首郎。\n颜貌宛如周柱史，须眉皆是汉冯唐。\n百年未觉强弓满，新历还添漏箭长。\n欲寄平安恐烦报，桃花川里漾舟忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17607,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄朱仰之","author":"王洋","text":"年齐甲子性同宜，相见论文更不疑。\n小约同行先具酒，且推独步放君棋。\n庭前雁鹭能堪否，堂下龟鱼暂付谁。\n好向蓝田报消息，多栽松竹待哦诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17608,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄朱德茂","author":"王洋","text":"生涯非富亦非贫，恰好容君放旷身。\n种竹种松须傍水，有花有酒不求人。\n功名梦幻吾无与，豁达襟怀德有邻。\n半醉捋须天地窄，玲珑峰顶看红尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17609,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄何子楚","author":"王洋","text":"冬馀春晚未收书，一棹相过两日馀。\n久拟从容来语旧，岂期盟约未寻初。\n风随双鹿樵中隐，人似三闾泽畔居。\n樱笋厨烟茶焙火，从来心事不相疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17610,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄张文彦","author":"王洋","text":"扫叶林间一梦回，别来秋物已惊催。\n书通意外殷勤语，诗寄闲中气味来。\n花木成阴如结幄，庭除自转不蠲埃。\n俱生北地俱流落，谁得杨枝送一杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17611,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄李元叔","author":"王洋","text":"北台御史共推贫，饥走三吴几阅春。\n繻裤远闻歌政绩，江山应复助诗神。\n乡尊耆旧多遗事，地有神山得近邻。\n料得新篇满中箧，好分风月寄闲人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17612,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄李叔飞","author":"王洋","text":"襟怀荦荦久沈沦，念子令人白发新。\n苏季揣摩虽未试，陈平容貌不长贫。\n要须业履能追古，不信儒冠解误身。\n早达才名未为贵，王杨卢骆愧前人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17613,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄李叔飞见振叔云叔飞尝见访不遇","author":"王洋","text":"难逢易别景如梭，恋恋思君可奈何。\n烦舍朱黄曲寻访，偶穿城市直经过。\n簪朋恨阻陪吟啸，文会知难听琢磨。\n何处恰如长对面，遇心无事便高歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17614,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄陈元载","author":"王洋","text":"太丘传祖道，作邑兴何如。\n著意招风月，随缘遣簿书。\n吏参名例外，诗托笑谈馀。\n偏忆当樽酒，论文意不疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17615,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄周表卿 其一","author":"王洋","text":"不见秘书久，经时失寄书。\n交情犹缱绻，遣讯问何如。\n郡籍藏昆府，班行近玉除。\n自怜无藉在，不敢梦华胥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17616,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄周表卿 其二","author":"王洋","text":"簿领正尘埃，天边驿使来。\n姓名传宝琰，朋旧集兰台。\n始望岂及此，故人安在哉。\n曾陪丞相幕，抚事勿惊猜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17617,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄郑公老","author":"王洋","text":"一投鱼目得双珠，恍觉光寒照坐隅。\n郡政已知先岁课，高文何不副时须。\n法官属籍忠劳久，吊死伤孤里俗苏。\n已分漂流寄江海，甘从父老啖蒸壶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17618,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄彦文","author":"王洋","text":"张子萧条后，空山十五年。\n瓶无粟遮眼，门有客求钱。\n折补经纶手，拘留褊短缘。\n寻诗有情否，旋送两三篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17619,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄夏孝叔","author":"王洋","text":"夏子赋分浅，凄凉不喜看。\n星星脱兵火，岁岁独饥寒。\n世若均如子，人应不羡官。\n如何闰月底，怨泪亦阑干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17620,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄徐稚山","author":"王洋","text":"曾揽轺轩一整冠，江西吏胆至今寒。\n疲民仰德方为贵，野老言公不似官。\n身必静休犹是病，心无拣择始知安。\n高情未得真消息，试仗诗筒一问看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17621,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄熊叔雅","author":"王洋","text":"天上郎官宿，人间又几年。\n莫思华毂贵，好种锦溪田。\n山色青盈眼，梅花雪满川。\n傥因鱼雁信，时寄两三篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17622,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题韩勉夫枝巢 其三","author":"王洋","text":"适时非履险，足分不忧贫。\n须信人间世，宜思物外身。\n荣柯堪叹蚁，饱露可怜螓。\n更谢东方朔，能安一老臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17623,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题韩勉夫枝巢 其一","author":"王洋","text":"万物各有性，逍摇即自安。\n均鸠得巢易，躁蟹寄身难。\n莫羡高头树，须防静处丸。\n如今洛阳第，谁到子孙看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17624,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"崇寿印师以诗见惠次韵答之","author":"王洋","text":"客问王居士，如何是半僧。\n祛缘都未尽，学道又无能。\n身世随忙业，妻儿饱岁登。\n时逢方外士，陪奉说心灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17625,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庸斋薛微之里居时与仆为莫逆交乱后寓洛西时来关中每相见必诧郝婿之为人岁辛未秋绍先沿檄至长安始得因杯酒接殷勤观其气概知庸斋之不予欺也今因其归诗以饯之","author":"王洋","text":"玉润冰清久著名，长安一见眼增明。\n笑谈已了关中事，慷慨还成灞上行。\n桑落酒边还适意，渭城歌里莫伤情。\n寄身琴鹤堂中相，早为皇家致太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17626,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"得小儿书寄二陈学颜字有楷法","author":"王洋","text":"前代风流颜太师，英风烈烈动朝仪。\n危身已著当时节，正笔犹开百世疑。\n儿作此书真识路，翁因忆汝念临岐。\n殷勤莫改平原脚，庆及门闾会有时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17627,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"得周朋诗云方为秘府书石渠二字作诗美之","author":"王洋","text":"斡地排天力有馀，倚空金榜称华胥。\n快兼长史三杯酒，优重中郎六体书。\n字向云门增瑞彩，思从天陛听传胪。\n集贤学士相惊顾，应道挥毫古不如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17628,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚宿村居","author":"王洋","text":"早趁林鸦泊，荒篱四面同。\n田夫留古意，野水识和风。\n倦仆欺予远，疲舆念汝功。\n尔嫌冬日促，吾兴在寒空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17629,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"望山间西际寺","author":"王洋","text":"闻说林间寺，攀萝一径斜。\n有僧眠雪月，无客赏风花。\n丈室虚名在，方袍岁事赊。\n空王无系著，破屋便传家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17630,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谹父出示赵倅木犀诗次韵","author":"王洋","text":"黄姑斸月种文犀，落向三秋月满时。\n岩邑疏封兄弟国，铜瓶分派子孙枝。\n汉宫明艳涂娇额，仙鼎珍丹散漉篱。\n好趁灯花同报喜，黄间金粟正相宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17631,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谹父得洞庭柑分送往往难遇赏者因成小诗","author":"王洋","text":"绿玉波心耸绛台，丹霞道士日传胎。\n仙人不惜黄金贵，海蜃摇惊驿使来。\n玉食光辉天著力，主家春色雪融腮。\n手中三日香犹在，不是吴姬乞打回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17632,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谹父望日欲载酒过南池且云已得潘风酒郑顾道亦作诗再叙南池风物以酬曾使君吟赏之意","author":"王洋","text":"尽意妆成出晓窗，燕脂颊浅绿云长。\n水仙卤簿三千女，瓦影龟鱼一味凉。\n鸡舌旧传仙客句，芬陀长带梵天香。\n使君玩物无留物，为尔临流欲泛觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17633,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪中赴季文集","author":"王洋","text":"会因率集转殷勤，扫径宽迎陌上春。\n恩解讯书红粉恋，寒消酒力玉花新。\n盘堆青菜春回律，瓯泛琼珠月借神。\n浮白自怜偏户小，醉归全是梦中人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17634,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪晴","author":"王洋","text":"墙角寒梅未试盐，熬波何事被凝严。\n解教炉火添馀烬，似妒阳乌到短檐。\n幽谷但期回暖律，交光何用映疏帘。\n朝来一扫穷阴处，先照群峰最上尖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17635,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜二曾一郑归","author":"王洋","text":"木叶黄时拂两轮，马前同看蚤梅春。\n旧游踏遍千山月，新岁迎归三老人。\n梳洗楼前酬鹊语，琴书案上扫蛛尘。\n只愁凤诏联翩下，又指天边问去津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17636,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜仰之至","author":"王洋","text":"江东幕客江西吏，各是年过五十时。\n一去尘中劳梦约，重来物外有心期。\n烟中艇子花前酒，竹里棋声月下诗。\n景物不妨俱是旧，只添须发白如丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17637,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜雨","author":"王洋","text":"去年秋日百神求，岁度春风尚未优。\n补贴稀疏三日泽，栽培饱满一年秋。\n已乾桑柘蚕多饱，待济舟航水接流。\n云雨算来多少力，夕阳处处听渔讴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17638,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"曾侍郎挽章 其二","author":"王洋","text":"未下蒲轮诏，先惊柏府寒。\n九州方镇节，万里使华冠。\n岁晚一庵密，风流百世宽。\n永怀函丈训，泣涕自汍澜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17639,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"曾法师尝寄蒲萄追作一篇","author":"王洋","text":"自分蔬肠甘苜蓿，那烦远骑送蒲萄。\n青条自有悠扬势，甘液多因灌溉劳。\n坐见满盘堆马乳，全胜千里惠鹅毛。\n病来苦不胜杯杓，今日思君饮浊醪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17640,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游吕庵偶题","author":"王洋","text":"结屋得胜处，群山簇画屏。\n春城花覆白，野路麦铺青。\n趁暖鸠呼妇，先时柳化萍。\n年年寒食近，心自叹飘零。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17641,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游纯房见李叔颖郎中诗因思叔颖聊继其韵赠淳化禅师","author":"王洋","text":"衲衣处处逐浮云，法乳何妨长子孙。\n室有巾瓶留祖意，门无车马露苔痕。\n名高楚泽多新侣，梦入苕溪有旧言。\n谁与隐峰居士说，曾参一句是同门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17642,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"煮泉亭","author":"王洋","text":"昔人来去本无情，世自贪贤为结亭。\n身在云间天缭绕，梦无尘事性疏灵。\n撑肠大欠五千卷，拄眼今看万叠青。\n景物却因闲处见，前贤诗已说丁宁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17643,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"琴枕","author":"王洋","text":"琢石髹池省练弦，寂尘不动五音全。\n应嫌杂奏妨人乐，正可常携对客眠。\n投倦乍如倾耳听，起醒惟欠籁声传。\n舞云家范升堂席，寂寞依稀万古贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17644,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"琼花","author":"王洋","text":"爱奇造物剪琼瑰，为镇灵祠特地栽。\n事纪扬州千古胜，名居天下万花魁。\n何人斲却依然在，甚处移来不肯开。\n浪说八仙模样似，八仙安得有香来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17645,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答秀实见招","author":"王洋","text":"此身初不敢图安，老去偏忧行路难。\n欲调舟车难用法，偕行仆从只宜宽。\n已持食节多虞病，嫌重装囊少虑寒。\n且替疲兵充守宅，诗成莫惜寄来看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17646,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"葛秘校和予关字韵诗两篇再以一篇奉酬","author":"王洋","text":"数州形胜共乡关，江浦淮堧一望间。\n长恨崎岖千里隔，那知邂逅两身闲。\n稻粱要足几时足，闾井欲还何日还。\n犹胜拘牵名利客，心无一事看春山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17647,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢吕令子卿雪中遣人惠酒初令人置酒于祝舜俞吕令以酒为惠云","author":"王洋","text":"也知谋醉胜谋闲，户小都忘满腹悭。\n晚得曲生投老伴，长邀玉友访空山。\n初贪雪里香宜倍，忽报瓶中酒自还。\n全胜朱提双饮盏，亲教从事送酡颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17648,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢运属秘书惠诗","author":"王洋","text":"雪扑征鞍岸涨沙，不辞天阙去程赊。\n江梅笑处人为客，仙桂香时雁到家。\n秦地少年应办酒，江南词客好酬花。\n锦衣綵仗还乡路，欲访萍踪问钓槎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17649,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢邵武危秀才惠长笺","author":"王洋","text":"须知秋日胜春朝，一鹤凌空振羽毛。\n满轴文章慰衰病，十年灯火困英豪。\n良医先为肱三折，合负终看钓六鳌。\n郑老襟期幸同调，新诗时与寄亭皋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17650,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢筠守赵从周寄黄蘖中洲茶","author":"王洋","text":"道院文书静，传签报两衙。\n笼山疏药圃，祖寺摘春茶。\n珍品少为贵，佳名远更誇。\n要知清白德，盏面看浮花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17651,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谦仲好古携酒见过伯氏以诗谢之次韵","author":"王洋","text":"我生南北本殊津，邂逅相逢若聚蘋。\n故纳破愁成一笑，应怜对影只三人。\n居嫌共邑犹分袂，醉觉同心只异身。\n送客溪边一惆怅，新欢过眼又前尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17652,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赋洞庭柑","author":"王洋","text":"两潮船上别苏台，岁历侵人鹤化胎。\n霜实可怜今入眼，佳人何日问重来。\n黄金丸逐惊飞肉，白露团凝别恨腮。\n重待扁舟落吾手，为君先报柳郎回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17653,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"曾吉父以诗招客次韵","author":"王洋","text":"醉吟居士桃李曲，忠孝相家鹦鹉杯。\n情随兰畹碧香注，诗送茶山烟雨来。\n溪边官柳意欲尽，枝上海棠红半开。\n不应物色相携手，惊唤南池春梦回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17654,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"曾吉父出示和郑固道病中诗次韵","author":"王洋","text":"行药萧晨放步迟，啸台秋色饱秋时。\n乐天何意病为伴，樊素不收春自随。\n旧雨故人频问疾，茅君使者净窥棋。\n拂衣身健丹枫路，积压风光剩费诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17655,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"慈相寄居同院何子感寒仆已似安何尚未出似闻亦以冬至人事动摇疾困未解亦成小诗","author":"王洋","text":"分僧半坐小僧圆，世故犹寻未了缘。\n小大不同俱示病，穷通有命只听天。\n愁看药裹推难去，愿见香醪骋不前。\n比若扶头却因酒，甘言苦口定谁贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17656,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"新隐四首 其四 南峰","author":"王洋","text":"郭外溪流溪外山，山峰长在白云间。\n开怀幸对百年友，屈指何忧一日颜。\n烦燠尚宽秋占野，林峦欲暮鸟知还。\n夜归犹隔溪桥水，不记重门欲上关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17657,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"新隐四首 其三 荷池","author":"王洋","text":"香分净社色专城，冠盖如云照乘明。\n晓露一妆秋艳曳，凉风吹月夜经营。\n戏荷鱼小波纹近，戛玉船低笑响轻。\n闻说笠乾烧供夜，无边华烛竞欢迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17658,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"辟方丈地供香火","author":"王洋","text":"全家共寄一庵中，庖涤因连奥胙通。\n穴不容身衔窭籔，芥分馀地结斋宫。\n几瓯粥借邻僧饭，一瓣香寻祖佛风。\n十笏比邱居有限，包罗眷属要无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17659,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"酬凌季文过杨仲诚","author":"王洋","text":"慢绿迟红静不争，小梯斜倚上空明。\n日筛竹影花奴睡，人度禾场吠犬惊。\n散帙未甘书效晚，携筇独喜病骸轻。\n排芳穿密多幽处，后日相期子细行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17660,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"僧自临安归说远信","author":"王洋","text":"幻形变灭困须臾，晚景尤惊岁易徂。\n满目交游多故物，伤心风雨对今吾。\n逝波昨日方追霅，覆篑今朝又过衢。\n旋打青梅新荐酒，且须耳热听歌呼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17661,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"臧夫人挽诗二首 其二","author":"王洋","text":"义有臧侯者，寥寥几百年。\n岂唯君子贵，亦有女郎贤。\n宁舍家藏富，先归宿贷钱。\n自然难到处，风烈是家传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17662,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]