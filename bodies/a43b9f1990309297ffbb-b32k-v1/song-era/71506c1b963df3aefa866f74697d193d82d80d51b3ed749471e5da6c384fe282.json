[{"title":"书怀","author":"蔡戡","text":"扁舟东下自夷犹，胸次浑无一物留。\n世味横陈如嚼蜡，人生变灭似浮沤。\n休休且毕山林愿，去去空怀畎亩忧。\n自念秋毫皆帝力，衔环结草若为酬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28311,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"介卿送方竹杖以诗谢之","author":"蔡戡","text":"何必穷搜到大宛，仰山龙种出天然。\n直方自得坤爻动，坚瘦宜居灵寿先。\n剩喜登山扶病足，不妨倚壁伴清眠。\n故人若问今无恙，不似山僧故削圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28312,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"水栀","author":"蔡戡","text":"谁移花本瓦盆中，怪底幽香度晓风。\n白石清泉助潇洒，疏枝瘦叶缀玲珑。\n晴窗坐对情无那，午枕清眠梦亦通。\n小品纷敷生意足，信知人力夺天工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28313,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"水阁偶成二首 其二","author":"蔡戡","text":"徙倚危楼久，无言对夕晖。\n野花随处发，水鸟傍人飞。\n自觉身无累，那知世有机。\n何劳战蜗角，万事转头非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28314,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"水阁偶成二首 其一","author":"蔡戡","text":"小阁枕横塘，荷花渡晚香。\n月华秋更白，水气夜偏凉。\n地僻人稀到，心閒梦亦长。\n北窗聊寄傲，身世两相忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28315,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王季立安抚挽诗 其一","author":"蔡戡","text":"世袭枢庭贵，仍专帅府权。\n公忠由性禀，清白自家传。\n剖决神明速，安怀畏爱全。\n功名方迫逐，天不假长年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28316,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王季立安抚挽诗 其二","author":"蔡戡","text":"相门叨下客，帅幕得佳宾。\n玉树连阶砌，芙蕖泛水滨。\n通家仍有契，论世岂无人。\n埋玉空遗恨，潸然泪满襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28317,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"丙辰罢郡得祠","author":"蔡戡","text":"世论可怜哉，无心任去来。\n狙公徒自喜，鸥鸟浪相猜。\n塞马宁非福，池鱼枉见灾。\n扁舟从此去，回首谢氛埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28318,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东归喜而有作","author":"蔡戡","text":"投老何堪再落南，病躯宁敢望生还。\n空惭马援标铜柱，自分班超老玉关。\n万里梅花愁思外，五湖烟水梦魂间。\n诏恩幸喜归田里，旋筑新堂榜爱閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28319,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"代赵仪可挽刘叔丙","author":"蔡戡","text":"此士不可得，乡人今始思。\n迎宾多事日，教子废科时。\n望屋讼自止，弄丸争者谁。\n京华携手处，忆著最伤悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28320,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"先人尝宰贵池今二十五年矣舟行经此不胜黯然","author":"蔡戡","text":"夜泊贵池口，此情殊黯然。\n思亲空有泪，感旧不成眠。\n棠舍清阴在，桐乡旧政传。\n终天成永感，忍听蓼莪篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28321,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"刘公实以淮白为饷喜而作诗","author":"蔡戡","text":"食指朝来应吉占，淮鱼远寄喜开奁。\n肥鲜正自资糟粕，甘美何劳佐酪盐。\n未信鹿头堪并进，定知熊掌不能兼。\n慈闱一笑尝珍味，留与儿童例属餍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28322,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"刘公实母夫人董氏挽诗 其二","author":"蔡戡","text":"列寺名卿重，慈闱寿母尊。\n眼中看五世，膝下拥重孙。\n九九登遐算，三三达妙门。\n哀荣极终始，全福更何言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28323,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"刘公实母夫人董氏挽诗 其一","author":"蔡戡","text":"杏圃仙游远，桃源往事亏。\n名高孝妇传，词掞外孙碑。\n孟鼎方知贵，莱衣不复嬉。\n生男有如此，天道岂无知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28324,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同顾广文游西湖","author":"蔡戡","text":"老来多病盍归休，祇为江山得少留。\n万顷澄波环胜境，千峰倒影漾中流。\n十年两作西湖长，一日同为北牖游。\n预约他时官事了，与君重醉百花洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28325,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"岁暮有感","author":"蔡戡","text":"久困京尘厌剧烦，一麾江海养衰残。\n簿书丛里身空老，鼓角声中岁又阑。\n赢得星星双鬓白，空馀耿耿寸心丹。\n自怜憔悴今如许，盍向明时早挂冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28326,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次蔡介卿雪中见寄 其一","author":"蔡戡","text":"玄冥作意逞雄豪，陵压东君惨不骄。\n一气回春何太晚，群阴见睍未全消。\n漫誇呈瑞宜新麦，那似为霖救旱苗。\n造物深机虽莫测，愿言六气自均调。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28327,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次蔡介卿雪中见寄 其二","author":"蔡戡","text":"等閒栽遍小园花，剩拟春来赏物华。\n不觉琼英先满树，更看缟带暗随车。\n光摇玉镜冰初泮，冻屈金钩草未芽。\n料得小桥人不到，江梅欺压任横斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28328,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江行阻风","author":"蔡戡","text":"雁峰飘泊又经年，却忆槎头缩项鳊。\n三伏炎光真烁石，重湖骇浪远连天。\n快风坐阅千帆过，上水徒劳百丈牵。\n坎止流行随所遇，便当归去访林泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28329,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"灯夕不出偶成","author":"蔡戡","text":"晚岁光阴只自惊，眼中乐事叹何曾。\n雕鞍绣幰多游子，纸帐蒲龛一病僧。\n尘翳扫除方寸地，光明散作百千灯。\n维摩丈室跏趺坐，千息调匀唤不应。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28330,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"芍药","author":"蔡戡","text":"自古维扬厥草夭，露红烟紫不胜娇。\n郑风已久名溱洧，洛品犹堪压魏姚。\n痛饮莫辞金凿落，清标偏爱玉逍遥。\n楚狂小子嗟多病，坐对珍丛不自聊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28331,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观雪 其二","author":"蔡戡","text":"乾坤浩荡渺无涯，龙凤纵横落万家。\n似与宓妃矜态度，未应姑射并容华。\n排檐巧缀纤纤玉，著树齐开种种花。\n料得琼瑶天不惜，等閒狼籍委泥沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28332,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观雪","author":"蔡戡","text":"卧听跳珠落瓦沟，晓来飞雪冻云稠。\n晃观佛国三千界，幻出仙家十二楼。\n公子休誇梁苑宴，高人空泛剡溪舟。\n何如缚取吴元济，夜半衔枚入蔡州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28333,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过鄱阳湖适遇便风湖面如镜喜而有作","author":"蔡戡","text":"多谢江神不世情，为怜逐客送归程。\n一帆风力如飞疾，千里湖光似掌平。\n要是吾生仗忠信，自然此意格神明。\n反思宦路风波恶，屡触危机梦亦惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28334,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"齐子馀母太夫人王氏挽诗 其二","author":"蔡戡","text":"向来小宗伯，日侍太夫人。\n地占梁溪胜，风流岘首春。\n版舆随处乐，綵服逐时新。\n欻断萱堂梦，居然迹已陈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28335,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"齐子馀母太夫人王氏挽诗 其一","author":"蔡戡","text":"江左推门地，华阳接洞天。\n嫔夫成宅相，教子作时贤。\n富贵三从备，哀荣五福全。\n平生勤事佛，兜率是良缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28336,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"齐子馀母太夫人王氏挽诗 其三","author":"蔡戡","text":"石窌恩虽渥，兰陔事已非。\n升堂人不见，执绋泪频挥。\n树竞晚风急，草明朝露晞。\n他年黄閤宴，不及奉慈闱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28337,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"齐子馀侍郎挽诗 其二","author":"蔡戡","text":"哀荣终始冠当时，何况人生七十稀。\n岘首正思羊叔子，宣城还忆谢玄晖。\n松阶方俟甘泉对，蒿里俄惊朝露晞。\n他日西州忍重过，为公回首一沾衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28338,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"齐子馀侍郎挽诗 其一","author":"蔡戡","text":"玉笋班中第一人，堂堂风采照公卿。\n箕裘四世儒科贵，簪橐三朝法从荣。\n广厦细旃多启沃，黄扉青琐罄忠诚。\n经纶未了犹遗恨，信史空留后世名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28339,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"即席和端约韵","author":"蔡戡","text":"竹溪追胜槩，得侣最为多。\n自觉功名懒，空嗟岁月磨。\n梦惊风落叶，心破雨鸣荷。\n无此杯中物，其如良夜何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28340,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"孝宗皇帝灵驾发引诗 其一","author":"蔡戡","text":"历数承尧禅，讴歌戴舜仁。\n规模自宏远，法度谨持循。\n俭约身先下，忧勤志在民。\n万方无以报，雨泣但沾巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28341,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"孝宗皇帝灵驾发引诗 其二","author":"蔡戡","text":"舜禹相传日，元非倦万几。\n慈闱躬至养，别殿奉遗衣。\n易月心何忍，通丧礼不违。\n煌煌新庙号，万古播音徽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28342,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李粹伯侍御挽诗 其二","author":"蔡戡","text":"犹记当年玉笋班，凛然风采动朝端。\n壮怀漫拟麒麟阁，直气曾缨獬豸冠。\n太白风姿图像见，卫公英爽梦魂寒。\n四州巷哭多遗爱，留取甘棠勿剪残。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28343,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李粹伯侍御挽诗 其一","author":"蔡戡","text":"妙龄才气已无双，军阵飞扬翰墨场。\n白简空馀遗藁在，锦囊应有近诗藏。\n生前且尽杯中物，死去犹堪地下郎。\n逸气不应埋宿草，会看千丈吐光芒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28344,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"沈朝议之渊挽诗 其一","author":"蔡戡","text":"早擅云间誉，唯公伯仲贤。\n谏篇馀祖烈，经学自家传。\n出处无馀恨，哀荣得两全。\n善人今已矣，埋玉向新阡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28345,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"沈朝议之渊挽诗 其二","author":"蔡戡","text":"仕至二千石，年馀七十秋。\n长生应有诀，勇退复何求。\n耆旧凋零尽，功名取次休。\n莫陪蒿里饯，东望陇云愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28346,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和李子真八月十四日夜赏月之什","author":"蔡戡","text":"西园清夜喜追随，唯恐冰轮出海迟。\n不但旷怀皆我辈，要知痛饮是吾师。\n十分未放蟾盈魄，三匝先惊鹊绕枝。\n此夕清欢那复有，世间能得几人知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28347,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"奉祠东归 其二","author":"蔡戡","text":"书生贱分动多奇，浪得声名毁亦随。\n绝口不须谈世事，扪心唯有仗天知。\n人间变态浑如戏，眼底风光总是诗。\n白石清泉无限好，挂冠神武未为迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28348,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"奉祠东归 其一","author":"蔡戡","text":"老来不复叹飘零，游宦真如水上萍。\n绵力何堪分阃寄，宽恩犹许奉祠庭。\n休誇仙去骑鲸李，剩喜归来化鹤丁。\n料得亲朋相慰藉，还惊双鬓失青青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28349,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"奉酬介卿惜春之什","author":"蔡戡","text":"屈指骎骎向六旬，每于春事尚关情。\n病逢时节还虚度，老去光阴只暗惊。\n剩喜清新诗句好，休辞潋滟酒杯盈。\n荣枯代谢年年事，怪底莺声诉不平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28350,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"盱眙","author":"蔡戡","text":"自古东南第一山，于今无异玉门关。\n乱云衰草苍茫外，赤县神州指顾间。\n击楫何人酬壮志，凭栏终日惨愁颜。\n中原父老应遗恨，祇见旃车岁往还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28351,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"金坛灯市甚盛介卿见招不能往以诗谢之","author":"蔡戡","text":"可堪回首少年强，灯夕追游得许忙。\n老去情怀甘寂寞，年来节物转凄凉。\n出门有碍身如绊，异县相望道且长。\n漫想故人行乐处，水晶宫里醉霞觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28352,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"金陵道中","author":"蔡戡","text":"蚤年游历遍诸方，触处无心是道场。\n三已不须形喜愠，两来宁肯异炎凉。\n落霞孤鹜仍秋水，衰草残云又夕阳。\n天假一帆风力便，回头五日到家乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28353,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南昌大阅","author":"蔡戡","text":"自昔洪都地望雄，剑光直与斗牛通。\n角声悲壮秋风里，旗影横斜晚照中。\n帘幕万家观小队，弓刀千骑拥元戎。\n此身虽老心犹壮，自笑凭鞍矍铄翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28354,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"思归 其二","author":"蔡戡","text":"久留瘴岭苦思归，安得身如越鸟飞。\n老去宦情真是薄，年来乐事觉全稀。\n衰颜得酒还如少，病骨添衣却似肥。\n只为莼鲈动归思，非关勇退早知几。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28355,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"思归 其一","author":"蔡戡","text":"世事端如一局棋，光阴还若掷梭飞。\n亡弓休问人得失，佩剑那知孰是非。\n每对西山看不厌，何当南浦送将归。\n不如从此扁舟去，江上秋高蟹正肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28356,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"故庐陵府君葛公挽诗 其一","author":"蔡戡","text":"家风惟孝友，世系本神仙。\n丹药能延寿，衣冠不乏贤。\n享龄馀七十，积行满三千。\n存殁无遗恨，青毡有子传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28357,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"故庐陵府君葛公挽诗 其二","author":"蔡戡","text":"耆旧如公少，明时岂弃材。\n一麾聊出守，三径即归来。\n白璧人何在，黄粱梦已回。\n秋风正摇落，楚挽不胜哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28358,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"独立","author":"蔡戡","text":"独立寒江上，萧然一秃翁。\n梦魂惊雪浪，病骨怯霜风。\n远树斜阳外，荒村暮霭中。\n閒身无一事，樽酒与谁同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28359,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋日书怀 其二","author":"蔡戡","text":"刻意搜诗句，清心玩易爻。\n几尘留鼠迹，窗影印梅梢。\n泉石频招隐，壶觞已绝交。\n横挑一楖栗，在处寄僧包。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28360,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋日书怀 其一","author":"蔡戡","text":"游宦轻千里，閒愁度一秋。\n衰颜慵揽镜，病足怯登楼。\n事业因循废，功名取次休。\n人生聊复尔，一饱更何求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28361,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"胡长文给事挽诗 其一","author":"蔡戡","text":"中庸天下有胡公，儒者端宜给事中。\n华国高文推大手，回天谠论罄孤忠。\n晨班玉笋人何在，夜赐金莲事已空。\n惆怅故园招隐地，唯馀猿鹤怨西风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28362,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"胡长文给事挽诗 其二","author":"蔡戡","text":"大才深结九重知，亲洒宸章出禁闱。\n壶遂暮年非不遇，谢公雅志或相违。\n虎龙倍觉钟山重，龟鹤还从蜀道归。\n故吏门生半天下，空垂老泪一沾衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28363,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"胡端约挽诗 其二","author":"蔡戡","text":"长卿多酒病，子美太诗癯。\n谈笑随时乐，风标绝代无。\n遗编应百卷，怪石漫千株。\n赖此青毡物，传家有凤雏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28364,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"胡端约挽诗 其一","author":"蔡戡","text":"一代风流尽，如公能几人。\n病来犹笔健，老去更诗新。\n握手言无间，伤心迹已陈。\n墨君时一玩，感慨泪沾巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28365,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"荆溪即事","author":"蔡戡","text":"我爱荆溪拟卜居，万家人物在蓬壶。\n湖光潋滟新磨镜，山色葱茏罨画图。\n顾渚茶甘风袂爽，石亭梅老月轮孤。\n功名已矣君休问，一舸从教寄五湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28366,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送九兄佥书归二首 其二","author":"蔡戡","text":"中年仍再别，归意苦难留。\n风雨伤心夜，江山满目秋。\n西堂诗入梦，东阁酒添愁。\n他日荆溪上，无违具一舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28367,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送九兄佥书归二首 其一","author":"蔡戡","text":"离别一何久，漂流不记年。\n昔君犹壮岁，今我亦华鬋。\n隔阔疑如梦，从容喜欲颠。\n弟兄能有几，及此对床眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28368,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送介卿之官金台 其二","author":"蔡戡","text":"渊明去彭泽，斯立佐蓝田。\n家近真良便，官閒任左迁。\n相望虽百里，此别又三年。\n拟办登山屐，从君访洞天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28369,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送介卿之官金台 其一","author":"蔡戡","text":"四海皆兄弟，情亲能几人。\n相看青眼旧，总作白头新。\n直道何妨拙，微官祇为贫。\n老来仍惜别，把酒话酸辛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28370,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送张子仪尚书起镇东阳","author":"蔡戡","text":"自古双溪山水乡，风流仍继沈东阳。\n禁庭久曳尚书履，辅郡方怀太守章。\n再世甘棠留勿剪，百年乔木郁相望。\n公家况有青毡在，会见登庸坐庙堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28371,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送胡季玉还毗陵","author":"蔡戡","text":"瘴雨蛮烟昼不开，问君底事亦南来。\n外台总计惭无术，内府输珍信有才。\n我去雁峰同北乡，子行梅岭带春回。\n故园花竹平安否，何日从容共一杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28372,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送蒋子立赴河南试 其二","author":"蔡戡","text":"平生天上张公子，一旦翻从地下游。\n不特文章传籍湜，定知礼乐付程仇。\n高山流水无真赏，白璧明珠勿暗投。\n他日大廷承顾问，好将忠谠荐宸旒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28373,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送蒋子立赴河南试 其一","author":"蔡戡","text":"槐花拂拂弄轻黄，白纻云趋翰墨场。\n鲁国儒冠能有几，长沙舞袖颇相妨。\n英材自是千人敌，小试犹争一日长。\n来岁皇都春色好，马蹄应带百花香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28374,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽胡通判","author":"蔡戡","text":"胡公家学本中庸，挺挺云来有祖风。\n但得年皆馀八十，何妨位不至三公。\n方期束帛迎申老，忽举空衣葬葛洪。\n江左祇今推甲族，庆源衮衮自无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28375,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"爱閒堂","author":"蔡戡","text":"归来筑室傍城阴，旋揭新名雅意深。\n因病爱閒多得趣，逢场作戏亦何心。\n鸟鱼飞泳全真性，水石风流有至音。\n衰朽自知无所用，量才祇合在山林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28376,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]