[{"title":"恭进理宗皇帝挽词 其一","author":"马廷鸾","text":"仁孝初闻代，讴歌早戴虞。\n多能天与圣，大度祖同符。\n恻怛钦刑诏，严恭事帝图。\n初终两甲子，经远有宏模。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4357,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"恭进理宗皇帝挽词 其四","author":"马廷鸾","text":"神册方增授，龙髯遽莫攀。\n千秋思沛邑，七月葬稽山。\n春暗觚棱影，星回羽卫班。\n寝门如昨日，无复侍威颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4358,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"恭和御制诗 其一","author":"马廷鸾","text":"圣作巍巍泰华高，淋漓赐笔洒春膏。\n奎文河汉天垂象，藻思波澜海驾鳌。\n淳化罕逢休叹昉，大中亲遇不誇绹。\n骊珠数十光盈把，何啻春秋一字褒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4359,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"恭和御制诗 其二","author":"马廷鸾","text":"直庐峻在九霄高，雨露恩光切仰膏。\n夜炬恩浓超赐锦，春船思涩怯提鳌。\n日砖有影占花隐，风铎无声引索绹。\n昭代崇儒逢圣主，小臣待诏愧王褒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4360,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"恭和御制赐进士韵","author":"马廷鸾","text":"熙朝道化聿求成，龙衮天临策俊英。\n清问详延敷乃听，嘉犹入告底于行。\n尧章焜耀欣承渥，汤训丁宁戒近名。\n圣主得贤功烈盛，小臣稽首愿升平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4361,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽李楼峰 其二","author":"马廷鸾","text":"短椠传边警，长篇罄亩忠。\n危邦韬昼锦，剧盗剪春葱。\n地隔几庐舍，天怜两秃翁。\n而今吾后死，作传岂能工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4362,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽李楼峰 其一","author":"马廷鸾","text":"万选胶庠上，三长渠观中。\n端从绣衣使，直拟黑头公。\n柯烂全枰换，舟移绝壑空。\n素交与年尽，老眼视天梦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4363,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽陈本斋","author":"马廷鸾","text":"擢第韩欧上，论交涧浦边。\n声名宁我后，官职逊人先。\n徐广生多戚，龚宾死独贤。\n拊膺前劫事，雪涕大招篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4364,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽费洁堂 其一","author":"马廷鸾","text":"井络璠玙瑞，江干英簜驰。\n万屯孤宿饱，一旅共时危。\n行地嗟蓬转，呼天泣黍离。\n百年公有尽，一恸我非私。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4365,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽费洁堂 其二","author":"马廷鸾","text":"共事咸淳帝，俱生嘉定年。\n江湖正寥阔，梁楚忽姻连。\n不作武担掾，翻成葛水仙。\n岂忘渠剑阁，来闭此荒阡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4366,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽徐朝奉 其二","author":"马廷鸾","text":"儿罢金华讲，翁从林下归。\n清时伯夷粟，愉色老莱衣。\n洛社风流在，襄阳耆旧稀。\n泷冈有名笔，字字独幽辉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4367,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽徐朝奉 其一","author":"马廷鸾","text":"海内嗟遗老，诸公表逸民。\n过庭忠训在，攀槛直声新。\n谏草频尊主，绯花与显亲。\n一门名父子，千载庆君臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4368,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病中修实录","author":"马廷鸾","text":"明圣当阳四十春，十年供奉感孤臣。\n云龙幄幕天容迩，河汉篇章帝墨新。\n正始遗音危绝缕，贞元旧曲恸沾巾。\n焚膏痛记乌号旦，目断稽山欲叫旻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4369,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读史有感","author":"马廷鸾","text":"永嘉直数到贞明，三百年间宇宙倾。\n草草梁陈貂尾续，纷纷云代犬牙争。\n谁知普六茹坚者，已向重光作噩生。\n毕竟开皇能混一，天公愦愦岂无情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4370,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"饯朱婿","author":"马廷鸾","text":"哀郢那能拾穗歌，卧陶谁复杖藜过。\n白头老我已如此，青眼看君馀几何。\n风雨夜吟蛩满砌，云山寒影雁横坡。\n暮年亲友临分苦，小酌村醪借脸酡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4371,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿屺瞻夜赋 其二","author":"马廷鸾","text":"六十年前我已孤，婴儿抱母泣呱呱。\n昊天罔极幽明隔，良月就盈今昔殊。\n云塞断行悲独雁，风林反哺感群乌。\n澄江只似洹河水，一碧寒泓照白须。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4372,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿屺瞻夜赋 其一","author":"马廷鸾","text":"咿轧篮舆度晓岑，抚今怀昔泪淋淫。\n蓼莪老去仍追诵，常棣新来又废吟。\n有恨台瓜随蔓尽，无情涧藻与波沉。\n僧窗月苦夜无寐，莫咏儿寒动母心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4373,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿斋和同僚韵","author":"马廷鸾","text":"群玉峰头一望赊，枕书旧监忆乘槎。\n自从芸蠹三分席，何啻槐龙五见花。\n大典奏篇文综覈，清吟落笔字横斜。\n绝怜名辈诸公□，鞙璲如何趁佩霞。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4374,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"得熊静程主簿书且诲以二父庚甲用旧韵奉寄","author":"马廷鸾","text":"负米无亲不忍尝，谁为故老在邻墙。\n百年宁复知耆旧，六甲犹能记岁阳。\n襟佩书生联讲席，鼓旂骚将角名场。\n斯文未敢荒先绪，白首遗孤腼最良。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4375,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"御书道山堂次林竹溪韵","author":"马廷鸾","text":"芒玉平云玺印红，洛龟图画五三隆。\n壁奎星聚来时彦，河汉天垂仰化工。\n文治正应淳化似，恩华重与绍兴同。\n何须飞白人人赐，始悟君王欲教忠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4376,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游荷溪西禅寺","author":"马廷鸾","text":"髣髴招提寄远村，缁郎草草佛灯昏。\n水将绿绕萦如带，山送青来列在门。\n句里风骚耆旧远，胸中丘壑典刑存。\n满怀孤愤几株石，欲起当年两达尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4377,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"程楚翁访考亭旧居著闽山集为题其后","author":"马廷鸾","text":"有客传吟藁，知渠来自闽。\n四书犹在鲁，六籍不忧秦。\n太史经邹峄，离骚感楚臣。\n谁知梦奠日，曾忆后庚申。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4378,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次龙山韵 其二","author":"马廷鸾","text":"窗间莫问唤祁嘉，望断宗周黍稷华。\n斗帐高眠聊避客，深衣暂到漫为家。\n我怀荒草同元亮，君悼空弦谢伯牙。\n老矣悲欢总无奈，仙书频读览荒遐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4379,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答赵心游与梭","author":"马廷鸾","text":"亦有猗那颂，从谁说象贤。\n振振麟趾族，煜煜锦袍仙。\n礼乐三雍对，神明百世传。\n王孙何处隐，芳草自连天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4380,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢毛子文见寿","author":"马廷鸾","text":"编排老朽我为魁，绿鬓朱颜可得回。\n周雅辍吟悲顾复，楚骚长叹诵恢台。\n鸿飞灭没孤身在，燕逐炎凉几客来。\n苜宿黎祁汤饼供，一浇眊氉强持杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4381,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"德寿宫古松太上爱之尝持御香酾酒祠土神以祈屏蟊贼云时绍兴壬午思陵馘亮之岁也于今百二十年矣仆生六十年后而十月八日又思陵上仙之晨感而有赋 其二","author":"马廷鸾","text":"南来天马总辛勤，内禅经今历再壬。\n复汉赤符还旧宇，法尧黄屋本非心。\n思成门外衣冠尽，德寿宫前茨棘深。\n叹息馀生孤露甚，匪莪彼黍涕淋淫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4382,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"德寿宫古松太上爱之尝持御香酾酒祠土神以祈屏蟊贼云时绍兴壬午思陵馘亮之岁也于今百二十年矣仆生六十年后而十月八日又思陵上仙之晨感而有赋 其一","author":"马廷鸾","text":"六龙亲御奠神州，甲子如今甫再周。\n百世尚瞻虞帝祀，五传遽抱杞天忧。\n臣民莫废瓜华敬，今古长悲禾黍秋。\n叹息馀生孤露甚，门弧弓棘总成愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4383,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠汪泰轩","author":"马廷鸾","text":"万言朝凤阙，一笑落渔舟。\n把我葱珩解，从公款段游。\n东来迎羽服，西去羡羊裘。\n挥手谢汉使，蒲轮公所羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4384,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠程楚翁","author":"马廷鸾","text":"汗竹丹铅侧，空花粉黛中。\n尚怀丞相亮，肯署大夫雄。\n有客来今雨，誇予迈古风。\n幽情倾不竭，渺渺碧云东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4385,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"恭进明堂大礼庆成诗","author":"马廷鸾","text":"钜典崇邦祀，精禋展国阳。\n泰元神授筴，癸亥日宣光。\n艺祖郊天始，高皇受命长。\n后庚基再造，先甲迓殊祥。\n率育歌时夏，仪刑咏我将。\n天街澄析木，农扈庆金穰。\n筑塞惩獯鬻，梯山谢越裳。\n宗祈严美报，亲享荐嘉尝。\n周士咸奔走，尧民共颂扬。\n青冥收夕雨，华耀炳朝阳。\n月御金波穆，星流珠幄黄。\n九重纷羽卫，十二驾龙骧。\n鋗玉琳琅展，轩朱磬管锵。\n时行肃天步，安坐集神鴹。\n圣孝昭初祼，元良俨贰觞。\n旗常森娿娜，黼黻罢周张。\n柴燄千灵堕，兰膏百末香。\n金鸡初日丽，丹凤德风翔。\n薄海乾施博，垂云解泽滂。\n批周仍蹋晋，蹴汉亦超唐。\n臣浅来蓬户，君仁点玉堂。\n恩书容稿进，嘉颂愧辞荒。\n有道帝能享，难谌圣敢康。\n畏威勤夙夜，万寿祝君王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4386,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"八月十四日记梦","author":"马廷鸾","text":"断鳌立极有前闻，郁郁昌陵颠檗春。\n起自郇瑕形自著，晓然入梦匪纷纭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4387,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十月二十六日有感","author":"马廷鸾","text":"宾空后甲再经壬，香断金炉已七春。\n四十一年民父母，谁知今日帝乘云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4388,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十月望日泛舟鹅塘感坡翁后赤壁赋有作","author":"马廷鸾","text":"浮浮短艇水风微，一枕清溪绕曲崎。\n篷底镕金斜日碎，天边散绮暮霞飞。\n霜凝水落黄泥坂，月小山高赤壁矶。\n等是初冬一风景，感今怀昔自歔欷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4389,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"久雨潦涨未已","author":"马廷鸾","text":"一雨遂踰月，连朝仍彻宵。\n雷公自收麦，田父不耘苗。\n时见危垣堕，仍闻比屋漂。\n愧无援溺手，穷巷有持桡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4390,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用大东莱临川诗韵示诸儿","author":"马廷鸾","text":"惠子五车书，彼富吾何慊。\n滔滔岁峥嵘，濯濯木荏苒。\n前荣悼虚誇，新懦就退敛。\n东邻有硕师，簦箧孰云远。\n斯文岂终穷，小子宜黾勉。\n寒檠炷老膏，此兴复不浅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4391,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用清秋鹤发翁韵赋小书招洁堂 其二","author":"马廷鸾","text":"月照窗炯炯，虫鸣室幽幽。\n策杖柴门晓，菰蒲半沼秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4392,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用清秋鹤发翁韵赋小书招洁堂 其三","author":"马廷鸾","text":"火中寒暑退，造物其犹醵。\n老身不茧蚕，清夜独警鹤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4393,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用清秋鹤发翁韵赋小书招洁堂 其一","author":"马廷鸾","text":"幽居抱孤明，怀古思旧京。\n渴望宝连山，老桂不胜清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4394,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用清秋鹤发翁韵赋小书招洁堂 其四","author":"马廷鸾","text":"老蟾明孤心，凉飙苏病骨。\n保此中夜存，微阳有毫发。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4395,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次龙山韵 其一","author":"马廷鸾","text":"新来霄汉冥鸿客，旧日风云振鹭行。\n脱下戏衫优便散，惊回客枕梦何长。\n莫将吴蜀分岐路，政把乾坤作醉乡。\n惟有葵倾心不死，清魂几到殿中央。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4396,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次李改卿韵","author":"马廷鸾","text":"丽句费敲推，清吟出竞病。\n日长简编丛，春老蓬蒿径。\n志士苦忧时，高人思缮性。\n山房读道书，晚花红艳静。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4397,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次胡玉叟韵","author":"马廷鸾","text":"莫学前人索送诗，我无姱节可提撕。\n忍听世上新翻曲，堪笑山中老古锥。\n人境炎凉过驹隙，天边日夜走蟾规。\n穷阎又度纯坤月，谁识初阳变一奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4398,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵汤叔逊谢笔墨长句","author":"马廷鸾","text":"南屏翁，斯文千古何终穷，清辉灵气斗牛充。\n我从公家二老话此事，寒更支坐烛跋红。\n哀哉人琴俱亡天地覆，有刀有玉谁错砻。\n翁今岿然鲁灵殿，砥柱一叶万仞中。\n朅来访我维摩室，我起于坐欣迎公。\n惊呼绝叹吾道厄，客卿颖士委蒿蓬。\n灶煤苇管不足用，宣城黟水无良工。\n奈何盲卒乘钝马，欲写杰作称词雄。\n赠公撒雷挥电施敏手，馀事渲染文字如飞虫。\n我生哀伤所欠死，十年破砚烟雨濛。\n一朝洗眼获玉句，金膏水碧浸方瞳。\n翰墨场中身老大，期公盛气晚霞同。\n峥嵘素论犹激烈，始信迂儒曲学如发蒙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4399,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵周公谨见寄 其一","author":"马廷鸾","text":"十年思美人，渊沦抑天飞。\n辛勤种青门，竟作抱蔓归。\n日月老宾送，霜露沾人衣。\n沾衣何足云，八表笼烟霏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4400,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵周公谨见寄 其五","author":"马廷鸾","text":"退之怀桂林，药物珍陆离。\n物情恶衰歇，义心感亲知。\n我生欠一死，不死当语谁。\n与我制颓龄，悠悠白云期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4401,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵周公谨见寄 其三","author":"马廷鸾","text":"涪翁雪堂仙，分谊故不疏。\n投之孤芳篇，托根岂云虚。\n报以蟠桃实，一尝千载馀。\n洗髓蹑阆苑，游于物之初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4402,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵周公谨见寄 其四","author":"马廷鸾","text":"射洪高蹈翁，哀歌泪盈盈。\n幽居观元化，悼此岁月更。\n感遇三十篇，读之慨余情。\n白露号玄蝉，春日鸣仓庚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4403,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵周公谨见寄 其二","author":"马廷鸾","text":"空山学仙子，满耳笙箫听。\n谁知九天上，云扉本不扃。\n度世同御风，蓬蓬随飘零。\n又如芬陀花，出火而青青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4404,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵谢洁斋惠春膏纸","author":"马廷鸾","text":"霜毫秃尽千枝竹，铜雀台荒死潘谷。\n哀哉四宝并成空，犹有老崖藤捣玉。\n青钱学士将相科，黑头刺史朱丹毂。\n怀银早去镇湖湘，掞藻端如起巴蜀。\n天乎岁晚椓斯文，往往长吟书短幅。\n云昏雨暗白龙笺，林密山深紫芝曲。\n凤楼谁助斧斤修，鱼网不禁尘土辱。\n我驰家畔楮先生，越薄吴腴此粗俗。\n铿金戛玉新有声，缝雾裁云岂堪录。\n向来交友文字间，矢往湍奔如撒菽。\n薄材那敢派江西，一寸诗肠愁万斛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4405,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"纪梦","author":"马廷鸾","text":"夜梦嬉游到古陂，翻菱剥芡不知归。\n野田没膝泥三尺，拔足污渠自一奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4406,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"余氏心晖堂","author":"马廷鸾","text":"客从银山来，遗我骊龙珠。\n高文伟大册，至宝耀室隅。\n一读心为眩，再读目为盱。\n夫记者为谁，颍封人之徒。\n人生天地间，母怀靡知愚。\n至恩嗟莫报，大节尤可吁。\n柏舟谅人只，蓼莪生子劬。\n所以茅季伟，鸡半馔设腴。\n所以王休證，鱼双甘旨需。\n此理有俱有，此心无息无。\n儿寒衣芦花，母在足欣娱。\n儿罪履中野，母怜自噫呜。\n高高心晖堂，申旦所依于。\n俨然其若存，何可离须臾。\n我吟方区区，我步方于于。\n起看物所性，因悟理不诬。\n怀哉反哺者，城头尾毕逋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4407,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和许膝啸韵 其二","author":"马廷鸾","text":"前年儤直玉堂庐，下直归迟母倚闾。\n早识千钟误三釜，斑衣换得锦衣无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4408,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和洁堂见寿十章 其十","author":"马廷鸾","text":"祝公千龄寿，小我五月生。\n如何山林槁，得并江汉英。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4409,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和洁堂见寿十章 其九","author":"马廷鸾","text":"山哀兮浦思，月诸兮日居。\n伊谁百岁期，迟汝十年书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4410,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和洁堂见寿十章 其八","author":"马廷鸾","text":"道义挹亲仁，诗书仰邻富。\n翠蓬羞排门，骊珠惊满袖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4411,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和洁堂见寿十章 其七","author":"马廷鸾","text":"丧乱属何辜，吁吁者谁子。\n生来乏远猷，死去忧良史。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4412,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和洁堂见寿十章 其六","author":"马廷鸾","text":"琅琅金薤篇，慰此暮年癯。\n诵我徵咎赋，誇君摘句图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4413,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和洁堂见寿十章 其五","author":"马廷鸾","text":"大冬严寒至，病骨裹粗纩。\n羸然祝鸡翁，不识山中相。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4414,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和洁堂见寿十章 其四","author":"马廷鸾","text":"风雨倾燕巢，波涛涨鲸海。\n茅檐得此生，其谁为尔宰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4415,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和洁堂见寿十章 其三","author":"马廷鸾","text":"我生嘉定间，宝运稽炎隆。\n当时贡珍祥，今日泣麟穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4416,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和洁堂见寿十章 其二","author":"马廷鸾","text":"早知无廊庙，胡不素丘园。\n挥手谢世氛，保此中夜存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4417,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和洁堂见寿十章 其一","author":"马廷鸾","text":"老色上尺宅，灵气亏三田。\n怀我长房翁，授汝鸡犬仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4418,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"披云堂歌","author":"马廷鸾","text":"痴云压陇如坚城，猛风击破如雄兵。\n寒溪古洞收不彻，有如奔车白旆归空营。\n林稍划划露微碧，玉匣渐见青铜精。\n影转西风流日脚，万斛黄金散空落。\n宝篦刮尽重瞳膜，倒盛一海春冰薄。\n世界倾在琉璃屏，神豪气爽肌骨清。\n便欲垂羽翰，飞上朝玉京。\n不须七椀秋江波，两腋自有清风生。\n长忆当年玉川子，慇勤会问苍生事。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4419,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诗谢赵南冈","author":"马廷鸾","text":"早从诸暨厚相于，郭史能书也忆渠。\n万事只今同去鹤，十年依旧爱前鱼。\n试尝小缶烹莼玉，旋泼新醅漉酒酾。\n故旧不遗风韵在，犹存越绝几编书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4420,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]