[{"title":"生查子 其四 富阳道中","author":"毛滂","text":"春晚出山城，落日行江岸。\n人不共潮来，香亦临风散。\n花谢小妆残，莺困清歌断。\n行雨梦魂消，飞絮心情乱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9861,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"如梦令","author":"毛滂","text":"深苑重调弦管。\n不觉银台烛短。\n相对有金波，天畔杯中都满。\n人远。\n人远。\n醉倚阑干玉冷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9862,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西江月 其四 侑茶词","author":"毛滂","text":"席上芙蓉待暖，花间騕袅还嘶。\n劝君不醉且无归。\n归去因谁惜醉。\n汤点瓶心未老，乳堆盏面初肥。\n留连能得几多时。\n两腋清风唤起。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9863,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西江月 其三 长安秋夜与诸君饮，分题作","author":"毛滂","text":"雨后夹衣初冷，霜前细菊浑斑。\n觚棱清月绣团环。\n万里长安秋晚。\n槽下内家玉滴，盘中江国金丸。\n春容著面作微殷。\n烛影红摇醉眼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9864,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西江月 其一 次韵孙使君赏花见寄，时仆武康待次","author":"毛滂","text":"花下春藏五马，松间风落双凫。\n兵厨玉帐卷酃湖。\n人醉碧云欲暮。\n归去聊登文石，翱翔便是天衢。\n雅歌谁解继投壶。\n桃李无言满路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9865,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西江月 其二 县圃小酌","author":"毛滂","text":"烟雨半藏杨柳，风光初到桃花。\n玉人细细酌流霞。\n醉里将春留下。\n柳畔鸳鸯作伴，花边蝴蝶为家。\n醉翁醉里也随他。\n月在柳桥花榭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9866,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"阮郎归 其一 惜春","author":"毛滂","text":"映阶芳草净无尘。\n新晴隔柳阴。\n绿丝步障碧茸茵。\n遮藏欲尽春。\n寒未了，酒须深。\n残花无处寻。\n年来陪尽惜春心。\n闲愁渐不禁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9867,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"阮郎归 其二","author":"毛滂","text":"雨馀烟草弄春柔。\n芳郊翠欲流。\n暖风时转柳花球。\n晴光烂不收。\n红尽处，绿新稠。\n秾华只暂留。\n却应留下等闲愁。\n令人双鬓秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9868,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"更漏子 其一 熏香曲","author":"毛滂","text":"玉狻猊，金叶暖。\n馥馥香云不断。\n长下著，绣帘重。\n怕随花信风。\n傍蔷薇，摇露点。\n衣润得香长远。\n双枕凤，一衾鸾。\n柳烟花雾间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9869,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"更漏子 其二 初秋雨后闻鹤唳","author":"毛滂","text":"绿窗寒，清漏短。\n帐底沈香火暖。\n残烛暗，小屏弯。\n云峰遮梦还。\n那些愁，推不去。\n分付一檐寒雨。\n檐外竹，试秋声。\n空庭鹤唤人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9870,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"更漏子 其三 和孙公素泛舟观竞渡","author":"毛滂","text":"柳藏烟，云漏日。\n寒满雕盘玉食。\n风卷旆，水摇天。\n鱼龙挟彩船。\n水边人，波面乐。\n太守与民同乐。\n春好处，总随轩。\n花中谁状元。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9871,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"沁园春 其二","author":"毛滂","text":"秀禀元精，灵钟崧岳，命世大贤。\n自飞英任路，承流百里，郎官星彩，辉映经躔。\n劲柏凌霜，香梅娇雪，圭月弯弯新上弦。\n垂弧节庆，麒麟古梦，此夜初圆。\n罗川。\n父老欣然。\n算善政、古来谁与肩。\n念桃阴浓密，瓜期咫尺，双凫难驻，便欲朝天。\n争把丹青，绘成芝宇，立作生祠千载传。\n仍知道，看它时画像，别有凌烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9872,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"沁园春 其一","author":"毛滂","text":"左元仙伯，旧从当日，太一下生。\n念道尊德贵，体隆貌重，盖天勋业，出世才名。\n父子一时，君臣千载，侍宴通宵留太清。\n衣冠盛事，满床象简，隔坐云屏。\n年年此夜寒轻。\n正在东风下，不夜城。\n看御杯重劝，宸章屡赐，盛传歌舞，高会簪缨。\n桃李玉姬，芝兰子舍，尽向三台瞻寿星。\n从今去，愿千春献祝，午夜观灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9873,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诉衷情令 其二 七夕","author":"毛滂","text":"短疏萦绿象床低。\n玉鸭度香迟。\n微云淡著河汉，凉过碧梧枝。\n秋韵起，月阴移。\n下帘时。\n人间天上，一样风光，我与君知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9874,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诉衷情令 其一 三月八日仲存席上见吴家歌舞","author":"毛滂","text":"花阴柳影映帘栊。\n罗幕绣重重。\n行云自随语燕，回雪趁惊鸿。\n银字歇，玉杯空。\n蕙烟中。\n桃花髻暖，杏叶眉弯，一片春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9875,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜行船 其二 馀英溪泛舟","author":"毛滂","text":"弄水馀英溪畔。\n绮罗香、日迟风慢。\n桃花春浸一篙深，画桥东、柳低烟远。\n涨绿流红空满眼。\n倚兰桡、旧愁无限。\n莫把鸳鸯惊飞去，要歌时、少低檀板。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9876,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜行船 其一 雨夜泊吴江，明日过垂虹亭","author":"毛滂","text":"寒满一衾谁共。\n夜沈沈、醉魂朦松。\n雨呼烟唤付凄凉，又不成、那些好梦。\n明日烟江□暝曚。\n扁舟系、一行螮蝀。\n季鹰生事水弥漫，过鲈船、再三目送。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9877,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜游宫","author":"毛滂","text":"长记劳君送远。\n柳烟重、桃花波暖。\n花外溪城望不见。\n古槐边，故人稀，秋鬓晚。\n我有凌霄伴。\n在何处、山寒云乱。\n何不随君弄清浅。\n见伊时，话阳春，山数点。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9878,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"武陵春 其三","author":"毛滂","text":"银浦流云初度月，空碧挂团团。\n照夜珠胎贝阙寒。\n光彩满长安。\n春风为拂新沙路，珂马款天关。\n篆印金窠红屈盘。\n嵬ㄝ押千官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9879,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"武陵春","author":"毛滂","text":"维岳分公英特气，万丈拂长虹。\n丙魏萧曹总下风。\n千载友夔龙。\n宝熏袅翠昏帘绣，嘉颂佩绅同。\n不用黄精扫鬓中。\n元是黑头翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9880,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"武陵春 其二 正月十四日夜孙使君席上观雪，继而月复明","author":"毛滂","text":"风过冰檐环佩响，宿雾在华茵。\n剩落瑶花衬月明。\n嫌怕有纤尘。\n凤口衔灯金炫转，人醉觉寒轻。\n但得清光解照人。\n不负五更春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9881,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"武陵春 其二","author":"毛滂","text":"迎得春来闻好语，贺燕立帘钩。\n转蕙风光柳弄柔。\n喜气与春游。\n万钱珍鼎期公饭，天自寿留侯。\n文物升平速置邮。\n江左属风流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9882,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"武陵春 其三 正月七日，武都雪霁立春","author":"毛滂","text":"春在前村梅雪里，一夜到千门。\n玉佩琼琚下冷云。\n银界见东君。\n桃花髻暖双飞燕，金字巧宜春。\n寂寞溪桥柳弄晴。\n老也探花人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9883,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"武陵春","author":"毛滂","text":"城上落梅风料峭，寒馥逼清尊。\n爽兴天教属使君。\n雪意压歌云。\n插帽殷罗金缕细，燕燕早随人。\n留取笙歌直到明。\n莲漏已催春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9884,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"河满子 夏曲","author":"毛滂","text":"急雨初收珠点。\n云峰巉绝天半。\n辘轳金井卷甘冽，帘外翠阴遮遍。\n波翻水精重帘，秋在琉璃双簟。\n漏永流花缓缓。\n未放崦嵫晼晚。\n红荷绿芰暮天好，小宴水亭风馆。\n云乱香喷宝鸭，月冷钗横玉燕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9885,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨中花/夜行船 其二 武康秋雨池上","author":"毛滂","text":"池上山寒欲雾。\n竹暗小窗低户。\n数点秋声侵短梦，檐下芭蕉雨。\n白酒浮蛆鸡啄黍。\n问陶令、几时归去。\n溪月岭云红蓼岸，总是思量处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9886,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨中花 其一 下汴月夜","author":"毛滂","text":"寒浸东倾不定。\n更奈橹声催紧。\n堤树胧明孤月上，暗淡移船影。\n旧事十年愁未醒。\n渐老可禁离恨。\n今夜谁知风露里，目断云空尽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9887,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"青玉案 其四","author":"毛滂","text":"今宵月好来同看。\n月未落、人还散。\n把手留连帘儿畔。\n含羞和恨转娇盼。\n恁花映春风面。\n相思不用宽金钏。\n也不用、多情似玉燕。\n问取婵娟学长远。\n不必清光夜夜见。\n但莫负、团圆愿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9888,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"青玉案 其二 竹间戏作","author":"毛滂","text":"玉婴初有排云分。\n向晚色、娟娟静。\n秋入风枝清不尽。\n月和粉露，徘徊孤映，独夜扶疏影。\n子猷风调全相称。\n是彼此、无凡韵。\n玉勒前头花柳近。\n水边石上，冷依烟雨，时有幽人问。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9889,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"青玉案 其一 新凉","author":"毛滂","text":"芙蕖花上濛濛雨。\n又冷落、池塘暮。\n何处风来摇碧户。\n卷帘凝望，淡烟疏柳，翡翠穿花去。\n玉京人去无由驻。\n恁独坐、凭阑处。\n试问绿窗秋到否。\n可人今夜，新凉一枕，无计相分付。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9890,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"青玉案 其三 戏赠醉妓","author":"毛滂","text":"玉人为我殷勤醉。\n向醉里、添姿媚。\n偏著冠儿钗欲坠。\n桃花气暖，露浓烟重，不自禁春意。\n绿榆阴下东行水。\n渐渐近、凄凉地。\n明月侵床愁不睡。\n眉儿吃皱，为谁无语，阁住阳关泪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9891,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"临江仙 其二 客有逢故人者，代书其情","author":"毛滂","text":"莫恨那回容易别，不妨久远情肠。\n为人留下旧风光。\n花枝长好在，馥馥十年香。\n便是旧时帘外月，却来小槛低窗。\n朦胧影里淡梳妆。\n相看如梦寐，回首乍思量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9892,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"临江仙 其一 宿僧舍","author":"毛滂","text":"古寺长廊清夜美，风松烟桧萧然。\n石阑干外上疏帘。\n过云闲窈窕，斜月静婵娟。\n独自徘徊无个事，瑶琴试奏流泉。\n曲终谁见枕琴眠。\n香残虬尾细，灯暗玉虫偏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9893,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"临江仙 都城元夕","author":"毛滂","text":"闻道长安灯夜好，雕轮宝马如云。\n蓬莱清浅对觚棱。\n玉皇开碧落，银界失黄昏。\n谁见江南憔悴客，端忧懒步芳尘。\n小屏风畔冷香凝。\n酒浓春入梦，窗破月寻人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9894,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南歌子 其三 席上和衢守李师文","author":"毛滂","text":"绿暗藏城市，清香扑酒尊。\n淡烟疏雨冷黄昏。\n零落酴醾花片、损春痕。\n润入笙箫腻，春馀笑语温。\n更深不锁醉乡门。\n先遣歌声留住、欲归云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9895,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南歌子 其一 正月二十八日定空寺赏梅","author":"毛滂","text":"暮霰寒依树，娇云冷傍人。\n江南谁寄一枝春。\n何似珑璁十里、更无尘。\n雨萼胭脂淡，香须蝶子轻。\n碧山归路小桥横。\n谁见暗香今夜、月胧明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9896,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南歌子 其二 东堂小酌赋秋月","author":"毛滂","text":"庭下新生月，凭君把酒看。\n不须直待素团团。\n恰似那人眉样、秀弯环。\n冷射鸳鸯瓦，清欺翡翠帘。\n数枝烟竹小桥寒。\n渐见风吹疏影、过阑干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9897,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"点绛唇 其六 醉中记游一处，复寻不果","author":"毛滂","text":"小院重帘，那回来处花相向。\n迟迟一饷。\n记得春模样。\n昨夜月明，应照芙蓉帐。\n空凝望。\n蜂劳蝶攘。\n谁在花枝上。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9898,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"点绛唇 月波楼中秋作","author":"毛滂","text":"高柳横斜，冷光凌乱摇疏翠。\n露荷珠缀。\n但见鸳鸯睡。\n□□□□，□□□□□。\n□□□。\n□□□□。\n□□□□□。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9899,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"点绛唇 其二 家人生日","author":"毛滂","text":"柏叶春醅，为君亲酌玻璃盏。\n玉箫牙管。\n人意如春暖。\n鬓绿长留，不使韶华晚。\n春无限。\n碧桃花畔。\n笑看蓬莱浅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9900,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"点绛唇 其七 惠山夜月赠鼓琴者，时作流水弄","author":"毛滂","text":"绣岭横秋，玉螭吹暑迎凉气。\n碧崖流水。\n流入春葱指。\n半倚朱弦，微亸连环珥。\n通深意。\n月明风细。\n分付知音耳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9901,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"点绛唇 其三 月波楼重九作","author":"毛滂","text":"手抚归鸿，坐临烟雨帘旌润。\n气清天近。\n云日温阑楯。\n压玉浮金，一醉留青鬓。\n风光胜。\n淡妆人靓。\n眉黛生秋晕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9902,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"点绛唇 其四 家人生日","author":"毛滂","text":"何处君家，蟠桃花下瑶池畔。\n日迟烟暖。\n占得春长远。\n几见花开，一任年光换。\n今年见。\n明年重见。\n春色如人面。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9903,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"点绛唇 其五","author":"毛滂","text":"秀岭寒青，冷泉凌乱催秋意。\n佩环声里。\n无限真珠碎。\n叹我平生，识尽闲滋味。\n来闲地。\n为君一醉。\n万事浮云外。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9904,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"相见欢 秋思","author":"毛滂","text":"十年湖海扁舟。\n几多愁。\n白发青灯今夜、不宜秋。\n中庭树。\n空阶雨。\n思悠悠。\n寂寞一生心事、五更头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9905,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绛都春 其一 太师生辰","author":"毛滂","text":"馀寒尚峭。\n早凤沼冻开，芝田春到。\n茂对诞期，天与公春向廊庙。\n元工开物争春妙。\n付与秾华多少。\n召还和气，拂开霁色，未妨谈笑。\n缥缈。\n五云乱处，种雕菰向熟，碧桃犹小。\n雨露在门，光采充闾乌亦好。\n宝熏郁雾城南道。\n天自锡公难老。\n看公身任安危，二十四考。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9906,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"剔银灯 同公素赋，侑歌者以七急拍七拜劝酒","author":"毛滂","text":"帘下风光自足。\n春到席间屏曲。\n瑶瓮酥融，羽觞蚁闹，花映酃湖寒绿。\n汨罗愁独。\n又何似、红围翠簇。\n聚散悲欢箭速。\n不易一杯相属。\n频剔银灯，别听牙板，尚有龙膏堪续。\n罗熏绣馥。\n锦瑟畔、低迷醉玉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9907,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其十二 九月十二夜务亭作","author":"毛滂","text":"碧浸澄沙上下天。\n曲堤疏柳短长烟。\n月明不待十分圆。\n凿落未空牙板闹，阑干久凭夹衣寒。\n婵娟薄幸冷相看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9908,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其七 咏梅","author":"毛滂","text":"月样婵娟雪样清。\n索强先占百花春。\n于中烛底好精神。\n多恨肌肤元自瘦，半残妆粉不忺匀。\n十分全似那人人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9909,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其十七 访吴中朋友","author":"毛滂","text":"锦里无端无素书。\n长安秋晚忆家无。\n故人来此尚踟蹰。\n旧事殷勤休忘了，老来凄断恶消除。\n小楼雪夜记当初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9910,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其二十三 月夜对梅小酌","author":"毛滂","text":"蜡烛花中月满窗。\n楚梅初试寿阳妆。\n麒麟为脯玉为浆。\n花影烛光相动荡，抱持春色入金觞。\n鸭炉从冷醉魂香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9911,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其四 仲冬朔日，独步花坞中，晚酌萧然，见樱桃有花","author":"毛滂","text":"小圃韶光不待邀。\n早通消耗与含桃。\n晚来芳意半寒梢。\n含笑不言春淡淡，试妆未遍雨萧萧。\n东家小女可怜娇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9912,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其二十二","author":"毛滂","text":"滟滟金波暖做春。\n疏疏烟柳瘦于人。\n柳边半醉不胜情。\n未解画船留待月，缓歌金缕细留云。\n将云带月入东门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9913,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其十五","author":"毛滂","text":"本是青门学灌园。\n生涯浑在乱山前。\n一犁春雨种瓜田。\n别后倩云遮鹤帐，来时和月寄渔船。\n旁人莫做长官看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9914,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其一 宴太守张公内翰作","author":"毛滂","text":"碧雾朦胧郁宝熏。\n和风容曳舞帘旌。\n花间千骑两朱轮。\n金马天材文作锦，玉堂仙骨气如冰。\n湖山何似使君清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9915,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其八 初春泛舟，时北山积雪盈尺，而水南梅林盛开","author":"毛滂","text":"水北烟寒雪似梅。\n水南梅闹雪千堆。\n月明南北两瑶台。\n云近恰如天上坐，魂清疑向斗边来。\n梅花多处载春回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9916,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其十八 松斋夜雨留客，戏追往事","author":"毛滂","text":"记得山翁往少年。\n青楼一笑万金钱。\n宝鞍逐月玉鞭寒。\n老对冻醪留客话，醉爬短发枕书眠。\n伴人松雨隔疏帘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9917,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其五 家人生日","author":"毛滂","text":"日照遮檐绣凤凰。\n博山金暖一帘香。\n尊前光景为君长。\n不信腊寒雕鬓影，渐匀春意上妆光。\n梅花长共占年芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9918,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其九 寒食初晴东堂对酒","author":"毛滂","text":"小雨初收蝶做团。\n和风轻拂燕泥乾。\n秋千院落落花寒。\n莫对清尊追往事，更催新火续馀欢。\n一春心绪倚阑干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9919,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其十一 八月十八夜东堂作","author":"毛滂","text":"晚色寒清入四檐。\n梧桐冷碧到疏帘。\n小花未了烛花偏。\n瑶瓮孛堆春这里，锦屏屈曲梦谁边。\n熏笼香暖索衣添。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9920,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其十三 武康社日","author":"毛滂","text":"碧户朱窗小洞房。\n玉醅新压嫩鹅黄。\n半青橙子可怜香。\n风露满帘清似水，笙箫一片醉为乡。\n芙蓉绣冷夜初长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9921,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其十四","author":"毛滂","text":"松菊秋来好在无。\n寄声猿鹤莫情疏。\n渊明不老久踟蹰。\n打鼓枫林谁作社，枕溪茅屋忆吾庐。\n去年醉倒倩人扶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9922,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其三 新春四夜松斋小饮，微雪复止","author":"毛滂","text":"谢女清吟压郢楼。\n楼前风转柳花球。\n学成舞态却多羞。\n半落琼瑶天又惜，稍侵桃李蝶应愁。\n酒家先当翠云裘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9923,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]