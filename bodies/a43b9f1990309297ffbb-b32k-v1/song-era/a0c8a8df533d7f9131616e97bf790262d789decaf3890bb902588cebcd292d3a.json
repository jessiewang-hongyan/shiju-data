[{"title":"南海","author":"文天祥","text":"朅来南海上，人死乱如麻。\n腥浪拍心碎，飙风吹鬓华。\n一山还一水，无国又无家。\n男子千年志，吾生未有涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5962,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宣州罢任再赠","author":"文天祥","text":"贫贱元无富贵思，泥涂滑滑总危机。\n世无徐庶不如卧，见到渊明便合归。\n流落丹心天肯未，峥嵘青眼古来稀。\n西风为语岩前桂，若更多言却又非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5963,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"将母赴赣道西昌","author":"文天祥","text":"重来鸥阁晓，帆影涨新晴。\n倚槛云来去，闭帘花送迎。\n江湖春汗漫，岁月老峥嵘。\n手把忘忧草，夔夔绕太清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5964,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"思蒲塘","author":"文天祥","text":"扬旌来冉冉，捲旆去堂堂。\n恨我飞无翼，思君济有航。\n麒麟还共处，熊虎已何乡。\n南国应无恙，中兴事会长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5965,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"拜罗氏百岁母之明日主人举酒客张千载心赋诗某喜赞不自已见之趁韵","author":"文天祥","text":"翠微三岛近，画阁五云横。\n春水鸥声滑，夕阳鸦背明。\n尊前持一笑，花下卧馀酲。\n曾见瑶池母，不为虚此生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5966,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"某叨臬衡湘蒙恩以便郡归养肯斋大卿实寓衡我十年前邦君也一再见间即分南北五言启之所以致今旧雨缱绻云","author":"文天祥","text":"潇湘一夜雨，湖海十年云。\n相见皆成老，重逢便作分。\n啼鹃春浩荡，回雁晓殷勤。\n江阔人方健，月明思对君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5967,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贵卿","author":"文天祥","text":"天高并地迥，与子独牢愁。\n初作燕齐客，今为淮海游。\n半生谁俯仰，一死共沉浮。\n我视君年长，相看比惠州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5968,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赴阙","author":"文天祥","text":"楚月穿春袖，吴霜透晓鞯。\n壮心欲填海，苦胆为忧天。\n役役惭金注，悠悠叹瓦全。\n丈夫竟何事，一日定千年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5969,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送人往湖南","author":"文天祥","text":"雁拖秋月洞庭边，客路凄凉野菊天。\n云隔酒尊横北海，风吹诗史落西川。\n夜深鬼火千山雪，春后鹃花一树烟。\n为我祝融峰上看，朝暾白处礼蓬仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5970,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送朱制干象祖","author":"文天祥","text":"一官聱漫任如何，屡疏笺天气不磨。\n宋祚万年陈大计，周图五字订前讹。\n重寻范老忧时箸，旁竖文公卫道戈。\n投匦近年殊不少，有人说似此君么。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5971,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送张宗甫兄弟楚观登舟赴湖北试","author":"文天祥","text":"金螺晓气照人寒，手把天浆领佩环。\n夜月送鱼来赤壁，秋风吹雁发衡山。\n东南折处旗花见，牛女光中槎影还。\n见说青年文赋好，士龙一笑共云间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5972,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送曹大著知广德军","author":"文天祥","text":"暂屈瀛州客，来临汭水民。\n山川归史记，岳牧属词人。\n馆舍朋簪旧，都门祖帐新。\n儒林官可纪，何止吏称循。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5973,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送曹倅岩山官满归里","author":"文天祥","text":"春陵光霁落苍苔，葛水神仙立翠槐。\n万里云霞麒骥路，三年风月凤凰台。\n兴同老子复不浅，歌曰先生归去来。\n庾岭梅花开渐遍，一枝就与寄蓬莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5974,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重阳","author":"文天祥","text":"万里飘零两鬓蓬，故乡秋色老梧桐。\n雁栖新月江湖满，燕别斜阳巷陌空。\n落叶何心定流水，黄花无主更西风。\n乾坤遗恨知多少，前日龙山如梦中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5975,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闻鸡","author":"文天祥","text":"军中二十日，此夕始闻鸡。\n尘暗天街静，沙长海路迷。\n铜驼随雨落，铁骑向风嘶。\n晓起呼詹尹，何时脱蒺藜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5976,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"除夜","author":"文天祥","text":"乾坤空落落，岁月去堂堂。\n末路惊风雨，穷边饱雪霜。\n命随年欲尽，身与世俱忘。\n无复屠苏梦，挑灯夜未央。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5977,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"除夜 其二","author":"文天祥","text":"岁暮难为客，天涯况是囚。\n乾坤还许大，岁月忽如流。\n梦过元无梦，忧多更不忧。\n屠苏儿女态，肯作百年谋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5978,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"除夜 其一","author":"文天祥","text":"门掩千山黑，孤灯伴不眠。\n故乡在何处，今夕是穷年。\n住世真无系，为囚已自然。\n劳劳空岁月，得死似登仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5979,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"借道冠有赋","author":"文天祥","text":"病中萧散服黄冠，笑倒群儿指为弹。\n秘监贺君曾道士，翰林苏子亦祠官。\n酒壶钓具有时乐，茶灶笔床随处安。\n幸有山阴深密处，他年炼就九还丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5980,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭金路分应 其二","author":"文天祥","text":"明朝吾渡海，汝魄在它乡。\n六七年华短，三千客路长。\n招魂情黯黯，归骨事茫茫。\n有子应年长，平生不汝忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5981,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭金路分应 其一","author":"文天祥","text":"我为吾君役，而从乃主行。\n险夷宁异趣，休戚与同情。\n遇贼能无死，寻医剧不生。\n通州一丘土，相望泪如倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5982,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭秘书彭止所","author":"文天祥","text":"人物孤中秘，神山返异仙。\n目穿陪绋处，梦断曝书年。\n玉质应无死，韦编岂不传。\n奠刍和泪遣，此月向谁圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5983,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭崖山","author":"文天祥","text":"宝藏如山席六宗，楼船千叠水晶宫。\n吴儿进退寻常事，汉氏存亡顷刻中。\n诸老丹心付流水，孤臣血泪洒南风。\n早来朝市今何处，如悟人间万法空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5984,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宴交代宁国孟知府致语口号","author":"文天祥","text":"玉堂学士催班鹭，粉省潜郎趣佩麟。\n来往神仙同碧落，后先岳牧总词人。\n阳坡共喜瓜时及，朝路相期柳色新。\n握手论交拚一醉，东风散作满城春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5985,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宴交代湖南提刑李运使致语口号","author":"文天祥","text":"河汉双星会使槎，分明彻夜照长沙。\n辔丝晓转全龟影，衣绣春随锦鹊花。\n云杏旧阴凉绿净，野萍新韵度朱华。\n明年共侍蓬莱宴，回首丹墀日未斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5986,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宴朱衡守致语口号","author":"文天祥","text":"翩翩紫马绚银潢，春入梅花新雨香。\n牛斗剑芒浮翼轸，岷峨佩影度潇湘。\n东南麾节精神合，上下风云意气长。\n且为绿?拚一醉，传呼联辔觐明光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5987,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宴湖南董提举致语口号","author":"文天祥","text":"西风八月楚江滨，争看星槎会汉津。\n露湿红绫旗影旧，云连翠簜辔华新。\n东西杜若洲连月，先后瑞芝堂上春。\n回首琼林拚一醉，使还总是凤池人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5988,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽太博朱古平 其一","author":"文天祥","text":"白氏贤司马，昌黎真学官。\n江湖惊落笔，朝野望弹冠。\n天马高风骨，秋鹰折羽翰。\n莱庭人白发，烟雨万松寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5989,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽太博朱古平 其二","author":"文天祥","text":"铁砚伤同志，青灯忆旧游。\n临轩朝凤阙，驰道听鸡筹。\n魏野神仙宅，元龙湖海楼。\n西风一挥泪，世事盖棺休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5990,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽刘知县","author":"文天祥","text":"玉海渊源懿，金闺步武高。\n功名千载意，翰墨一时豪。\n天马含风骨，秋鹰折羽毛。\n相逢俱白发，流涕湿征袍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5991,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽朱尚书貔孙","author":"文天祥","text":"一代文昌贵，千年谏议名。\n天球声浑厚，玄酒韵和平。\n岩穴思风采，朝廷惜老成。\n东西生死别，江水泪为倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5992,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽李制帅二首 其一","author":"文天祥","text":"上下荆淮剑气雄，进担全蜀凛英风。\n将坛歃血金汤志，白腹填天竹帛功。\n治法征谋关世道，精忠定力简皇衷。\n伤哉生出瞿塘险，翻落黄粱一梦中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5993,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽李制帅二首 其二","author":"文天祥","text":"世变江河渺未涯，如公真是济时危。\n几年荆益龙骧誉，一日潇湘鵩谶悲。\n天下皆传清献节，人心自有武侯碑。\n郎君昔共慈恩约，抆泪西风寄些词。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5994,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽高邮守晏桂山","author":"文天祥","text":"淮南已仙去，桂树郁青青。\n五马贤声望，三丞旧典刑。\n邦人多感叹，诸老半凋零。\n何日持鸡酒，伤心请葬铭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5995,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽萧帅机虎溪","author":"文天祥","text":"世以千金重，谁能学隐君。\n一门名似雨，满座客如云。\n志愿生无憾，声华死有闻。\n韩碑照原草，含笑有斯文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5996,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽龚用和","author":"文天祥","text":"结屋南陵三十秋，田园旧隐隔江流。\n鄜州避乱杜工部，下泽乘车马少游。\n名利无心付隍鹿，诗书有种出烟楼。\n长淮清野难归玉，魂魄犹应恋故丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5997,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽湖守吴西林 其一","author":"文天祥","text":"凛凛千军笔，堂堂一面威。\n荆流春浪涌，峡树莫云飞。\n素壁琴犹在，中桥鹤不归。\n剑亭遗迹古，丰石照山辉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5998,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽湖守吴西林 其二","author":"文天祥","text":"倾盖岁年晚，相知江海深。\n春天思北树，夜雨话西林。\n五岭生前梦，中原地下心。\n英雄凋落尽，慷慨一沾襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5999,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽鄢晋叔主簿","author":"文天祥","text":"此君何坦坦，回首杏园游。\n魂魄湘潭去，声名彭泽休。\n百年中道短，千里故乡愁。\n六子三方幼，遗言可泪流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6000,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽黎致政","author":"文天祥","text":"楚峰天地阔，四世百年家。\n鹤发垂袍叶，龙孙上榜花。\n诗书新雨露，松柏老烟霞。\n白马苍山路，斯人忽已遐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6001,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓起 其一","author":"文天祥","text":"梦破风烟迥，衾寒不自由。\n钟声到枕曙，月影入帘秋。\n雁过江山老，蛩吟草树愁。\n整冠人共笑，两月不梳头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6002,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓起 其二","author":"文天祥","text":"远寺鸣金铎，疏窗试宝熏。\n秋声江一片，曙影月三分。\n倦鹤行黄叶，痴猿坐白云。\n道人无一事，抱膝看回文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6003,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桃源县","author":"文天祥","text":"清野百年久，中原千里赊。\n火烟新聚落，山水旧生涯。\n种麦十数亩，诛茅千百家。\n我来行正倦，何处觅桃花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6004,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桃源道中","author":"文天祥","text":"漠漠地千里，垂垂天四围。\n隔溪胡骑过，傍草野鸡飞。\n风露吹青笠，尘沙薄素衣。\n吾家白云下，都伴北人归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6005,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"泰州","author":"文天祥","text":"羁臣家万里，天目鉴孤忠。\n心在坤维外，身游坎窞中。\n长淮行不断，苦海望无穷。\n晚鹊传佳好，通州路已通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6006,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"泰和","author":"文天祥","text":"书生曾拥碧油幢，耻与群儿共竖降。\n汉节几回登快阁，楚囚今度过澄江。\n丹心不改君臣谊，清泪难忘父母邦。\n惟有乡人知我瘦，下帷绝粒坐蓬窗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6007,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"海上","author":"文天祥","text":"天边青鸟逝，海上白鸥驯。\n王济非痴叔，陶潜岂醉人。\n得官须报国，可隐即逃秦。\n身事盖棺定，挑灯看剑频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6008,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病中作","author":"文天祥","text":"岁月侵寻见二毛，剑花冷落鸊鹈膏。\n睡馀吸海龙身瘦，渴里奔云马骨高。\n百忌不容亲酒具，千愁那解减诗豪。\n起来大作屠门嚼，自笑我非儿女曹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6009,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病中作","author":"文天祥","text":"六月廿四夜，人间热欲炊。\n病怀如酒困，倦睫似书痴。\n梦与千年接，心随万里驰。\n客来相问讯，寄语有新诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6010,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病目二首 其二","author":"文天祥","text":"向来岩下电，无故眩生花。\n达磨面向壁，卢仝□塌沙。\n灯前心欲碎，镜里鬓空华。\n何日看明月，沈沈斗柄斜。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6011,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病目二首 其一","author":"文天祥","text":"近来烦恼障，左目忽茫茫。\n聂政心虽碎，刘伶醉未忘。\n问天天不应，食日日何伤。\n万想由来假，收拾太乙光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6012,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病甚梦召至帝所获宥觉而顿愈遂赋","author":"文天祥","text":"卧听风雷叱，天官赦小臣。\n平生无害物，不死复为人。\n道德门庭远，君亲念虑新。\n自怜蝼蚁辈，岂意动苍旻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6013,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病愈简刘小村 其一","author":"文天祥","text":"秋光沁人骨，意气晓来新。\n古鼎龙团雪，虚檐麈尾春。\n商山弈棋老，赤壁洞箫宾。\n风月真仓扁，招呼入屋频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6014,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病愈简刘小村 其二","author":"文天祥","text":"倦馀心似醉，病起首如蓬。\n黄竹断桥雨，白蘋长笛风。\n仙仙鸥屡舞，咄咄雁书空。\n孤负秋来眼，闲挑爨下桐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6015,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"真州驿","author":"文天祥","text":"山川如识我，故旧更无人。\n俯仰干戈迹，往来车马尘。\n英雄遗算晚，天地暗愁新。\n北首燕山路，凄凉夜向晨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6016,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秘省再会次韵","author":"文天祥","text":"蓬莱春宴聚文星，多荷君恩锡百朋。\n四座衣冠陪贺监，一时梁栋盛吴兴。\n图书光动青藜杖，人物温如古玉升。\n好是木天新境界，萤窗容我种金灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6017,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读史","author":"文天祥","text":"自古英雄士，还为薄命人。\n孔明登四十，韩信过三旬。\n壮志摧龙虎，高词泣鬼神。\n一朝事千古，何用怨青春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6018,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读赤壁赋前后二首 其二","author":"文天祥","text":"一笑沧波浩浩流，只鸡斗酒更扁舟。\n八龙写作诗中案，孤鹤来为梦里游。\n杨柳远烟连北府，芦花新月对南楼。\n玉仙来往清风夜，还识江山似旧不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6019,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读赤壁赋前后二首 其一","author":"文天祥","text":"昔年仙子谪黄州，赤壁矶头汗漫游。\n今古兴亡真过影，乾坤俯仰一虚舟。\n人间忧患何曾少，天上风流更有不。\n我亦洞箫吹一曲，不知身世是蜉蝣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6020,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贾家庄","author":"文天祥","text":"行边无鸟雀，卧处有腥臊。\n露打须眉硬，风搜颧颊高。\n流离外颠沛，饥渴内煎熬。\n多少偷生者，孤臣叹所遭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6021,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"饯新班弟","author":"文天祥","text":"送君天上去，当户理瑶琴。\n万里白鸥远，千山黄叶深。\n江空行路影，日暮倚门心。\n若见西湖雪，霸桥人正吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6022,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"铁错","author":"文天祥","text":"貔貅十万众，日夜望南辕。\n老马翻迷路，羝羊竟触藩。\n武夫伤铁错，达士笑金昏。\n单骑见回纥，汾阳岂易言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6023,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"高邮怀旧","author":"文天祥","text":"借问曾游处，高沙第几山。\n潜行鹰攫道，直上虎当关。\n一命虚空里，三年瞬息间。\n自怜今死晚，何复望生还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6024,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶赋","author":"文天祥","text":"苍苍已如此，梁父共谁吟。\n袖有忠臣传，床无壮士金。\n收心归寂灭，随性过光阴。\n一笑西山晚，门前秋雨深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6025,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿山中用前韵","author":"文天祥","text":"南山之隩北山阳，羽扇轻风共影双。\n画桨菰蒲明月笛，青灯蟋蟀白云窗。\n半生游子成行债，一夜佳人作别腔。\n倚钓重来此蓑笠，梅花十里雪空江。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6026,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄惠州弟","author":"文天祥","text":"五十年兄弟，一朝生别离。\n雁行长已矣，马足远何之。\n葬骨知无地，论心更有谁。\n亲丧君自尽，犹子是吾儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6027,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"崔镇驿","author":"文天祥","text":"万里中原役，北风天正凉。\n黄沙漫道路，苍耳满衣裳。\n野阔人声小，日斜驹影长。\n解鞍身似梦，游子意茫茫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6028,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"常州","author":"文天祥","text":"山河千里在，烟火一家无。\n壮甚睢阳守，冤哉马邑屠。\n苍天如可问，赤子果何辜。\n唇齿提封旧，抚膺三叹吁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6029,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]