[{"title":"送进士孙磻赴举","author":"魏野","text":"半生养锐向棠郊，此去深宜夺锦标。\n莫叹迁莺方出谷，只看一鹗迥冲霄。\n送诗吟恨冰生砚，别酒携从雪濯瓢。\n驴蹇童羸山路险，他时贵不忘今朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33184,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送武屯田赴峡路均输兼简臧殿院","author":"魏野","text":"旌旗如火马如风，十二峰前去少同。\n锦帐选抡为漕使，绣衣交代是家翁。\n蛮儿亦在提封内，神女犹居畏爱中。\n好继金陵丁太尉，留题尽著碧纱笼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33185,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送陕尉邵国华南归","author":"魏野","text":"召棠阴里邵梅仙，守选南归路七千。\n辛苦已伤过岭外，别离那忍向花前。\n到京店舍逢新火，度越封疆入瘴烟。\n相顾与君头尽白，不知后会是何年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33186,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送俞极山人归太华","author":"魏野","text":"三峰倚太虚，四岳境难如。\n云向中方起，人归绝顶居。\n道全忘世态，诗必答天书。\n不待辞荣去，还应笑二疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33187,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送赵寺簿东归","author":"魏野","text":"官满犹如下第贫，轩车迎赖旧田文。\n九皋禽畔偏辞我，六出花中独送君。\n易把当杯唯俗物，难持赆路是溪云。\n孝终且觅甘棠倅，谈笑还图得再闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33188,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送赵侍郎移镇长安","author":"魏野","text":"千骑萧萧晓发时，雨先一夜洒长岐。\n尽知暂去临鹑野，即看重来向凤池。\n函谷乱花明剑佩，灞桥垂柳拂旌旗。\n不同调鼎民皆乐，秦甸欢呼陕服悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33189,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送党宣员外赴阙兼呈刘小谏","author":"魏野","text":"行装堪入画何如，马更羸于到任初。\n棠树喜抛州部籍，兰台宜掌国图书。\n草芽绿未侵官道，柳眼青先近帝居。\n愿共耀卿来旧地，飘缨拥旆过吾庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33190,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送唐肃察院赴阙兼呈府尹孙大谏","author":"魏野","text":"东郊祖帐惨西风，愁听阳关曲调终。\n赤子泣皆牵绣袂，白驴鸣亦恋花骢。\n触邪暂立龙墀下，儤直将归凤阁中。\n大尹相逢凭仗说，官高不敢寄诗筒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33191,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送唐殿院罢蜀中提刑赴诏兼呈孙大谏","author":"魏野","text":"花骢出蜀瘦行难，急诏乘轺定峻迁。\n清雪人如辞父母，白云客似别神仙。\n堪晓望晴霞烂熳，伴宵征暑月团圆。\n寄语集贤孙大谏，莫嫌未和旧诗篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33192,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送徐道士赴阙","author":"魏野","text":"捧诏异常伦，无官岂累真。\n瓢知空似性，琴想重于身。\n卧必思云切，行应待鹤频。\n林间起相送，渐觉世还淳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33193,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送润上人南游","author":"魏野","text":"山水兴如烧，难留住陕郊。\n五湖携磬去，几夜在船敲。\n犀迹来沙岸，蝉声起树梢。\n南方未回日，何处暂编茆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33194,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送秘丞王利通倅阆州","author":"魏野","text":"到想行仁政，民间岂复言。\n冤思雪蜀魄，哀欲吊巴猿。\n山水州城僻，烟岚路径昏。\n遥思上事日，正值海棠温。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33195,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送贾注归蜀","author":"魏野","text":"将为干名入帝都，却言归隐蜀乡闾。\n永抛丹桂辞京辇，深入青山侍板舆。\n囊里几般仙药草，杖头数卷道经书。\n相门亲友应相羡，富贵终难复旧居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33196,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送钱中舍移任洋州兴道县兼呈知郡李屯田","author":"魏野","text":"鸳鸿出宰去如何，莫为辞亲发浩歌。\n淹抑暂因民制锦，骞翔终预帝搜罗。\n樽前老泪流虽尽，林下离肠断已多。\n却羡使君为旧友，公馀开宴日相过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33197,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送钱国博知坊州","author":"魏野","text":"遥为坊民贺一方，寿星偏去照光芒。\n解携朋友龙三处，随侍儿孙雁两行。\n芳草路中车突兀，落花风里旆悠飏。\n眠云客恨难陪从，空遣吟魂倍惨伤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33198,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送高生归青社","author":"魏野","text":"去指沧溟畔，来辞翠霭间。\n程遥过凤阙，家近见牛山。\n红叶飘行色，清溪照别颜。\n蹇驴看上处，拄杖出柴关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33199,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送萧咨下第西归","author":"魏野","text":"驴瘦懒加鞭，迟迟念独还。\n听鸡行晓月，叹雉过春山。\n渭入黄河浊，云归紫阁闲。\n明年公道在，莫便掩松关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33200,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送紫微孙舍人赴镇长安","author":"魏野","text":"长安千古帝王城，镇选词臣自圣情。\n三字带来天上贵，双旌拥出世间荣。\n朱衣尚列神仙步，红药宜吟雅正声。\n预想前春游赏处，九龙池上百花明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33201,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送鲍大监赴阙","author":"魏野","text":"紫诏徵黄下碧虚，棠郊人送去何如。\n深宜我后尊三老，未许伊川学二疏。\n到想烟霞侵几杖，行愁花雨湿图书。\n归期野客难陪从，空有吟魂逐后车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33202,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送端上人南归","author":"魏野","text":"相寻如有事，独去似无依。\n海内山游遍，江边寺始归。\n题诗当路少，乞食入城稀。\n肯学寻常辈，忙忙为紫衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33203,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送臧奎之宁州谒韩使君","author":"魏野","text":"路远邠郊外，严冬去若何。\n时平防贼少，山险下驴多。\n塞色晴犹惨，蕃音译尚讹。\n贤侯虽礼待，陟屺愿频歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33204,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送薛奎殿院赴阙","author":"魏野","text":"谪监陕郡滞贤才，清雪忻将紫诏开。\n缓步未亲龙扆去，回车愿拥隼舆来。\n辞蒙得得过三径，送合迢迢到柏台。\n秋霁山川行色好，乘骢策蹇恨难陪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33205,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送薛端公赴右蜀均输兼呈司理刘大著二首 其二","author":"魏野","text":"旌旆悠悠出陕时，白头人送倍依依。\n蜀川尚忆蒲芦政，蛮洞先惊獬豸威。\n祖席香浓花未老，行厨味简笋初肥。\n公馀若荐相如赋，郫县梅仙好发挥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33206,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送薛端公赴右蜀均输兼呈司理刘大著二首 其一","author":"魏野","text":"金鱼新跃绣衣边，暂委均输出剑关。\n九折路危骢马怯，一方尘静木牛闲。\n诸侯迎送威风下，赤子歌谣喜气间。\n更羡锦城刘大著，海棠花里恣追攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33207,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送蹇藏用之平阳","author":"魏野","text":"蜀客贫游晋，山川木落空。\n军闲无虏寇，俗俭有尧风。\n雁急长天外，驴迟落照中。\n圣君方选士，莫便叹途穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33208,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送蹇藏用省兄","author":"魏野","text":"迢递西南路，山多水莫穷。\n波涛千里远，风雪一船空。\n海兽形难识，蛮僧语不通。\n此行忘险阻，义与在原同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33209,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送魏庄赴举","author":"魏野","text":"再战去何如，羸僮逐蹇驴。\n路贫多捧刺，学富少担书。\n已念离家晚，仍忧取事疏。\n西风酒旗下，欲别更踌躇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33210,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻王衢王专下第因有所感","author":"魏野","text":"忽见僧来说，千愁集病颜。\n闻君俱下第，使我转思山。\n疑欲钻龟卜，穷应叹雉还。\n此怀何处写，月上太虚閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33211,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻王衢王辟登第因有寄贺","author":"魏野","text":"人间第一荣，初得好科名。\n万乘登楼看，三台让路行。\n搜罗空草泽，宴会敌蓬瀛。\n榜眼兼衣钵，偏依野客情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33212,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻李安下第因有所感","author":"魏野","text":"客携春榜至，开处倚柴荆。\n未看御题目，先寻君姓名。\n本期邻状首，敢叹滞文明。\n不会玄穹意，默然空怆情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33213,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻周孟下第","author":"魏野","text":"乙巳暮春天，端居忽怆然。\n一名伤圣祖，三榜作遗贤。\n我自空弹指，君谁可比肩。\n何由销此恨，独坐落花前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33214,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻雷宣徽薨背敕葬归乡","author":"魏野","text":"圣代贤臣丧，何人不惨颜。\n新祠民祭祀，旧债帝填还。\n卤簿尘侵暗，铭旌泪洒斑。\n功名谁复继，敕葬向家山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33215,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"值雨宿谔师房","author":"魏野","text":"信步闲游处，妨归路岂赊。\n因琴避山寺，和鹤宿僧家。\n语直非关酒，眠迟不为茶。\n共论尘世里，夜亦事如麻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33216,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"哭岐贲从事","author":"魏野","text":"君丧重堪悲，才高位竟卑。\n寄孤偏嘱我，知己更求谁。\n祭德宜脩庙，传名不在碑。\n何人与为传，愿录野人诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33217,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"哭钱观察","author":"魏野","text":"操麾授钺器纵横，尽说长城指顾成。\n岳既孕灵偏有意，天何促寿太无情。\n明堂欲建栋梁折，巨海将浮舟楫倾。\n未得四旬馀四载，龙旌不觉变铭旌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33218,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夏日书事","author":"魏野","text":"寻常苦出门，况复在炎蒸。\n短褐披犹懒，长裾曳岂能。\n松风轻赐扇，石井胜颁冰。\n只此贫无事，常愁不易胜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33219,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夏日怀寄西川峡路淮南薛臧王三运使","author":"魏野","text":"运使幽人酷暑时，江边林下两何为。\n信旗君逐舟车动，懒架吾随枕簟移。\n绣袂几经梅雨洒，葛衣一任竹风吹。\n蜀山淮甸棠郊外，早晚相逢豁所思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33220,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夏日雨中题谔师房","author":"魏野","text":"夏雨下如绳，虚廊减郁蒸。\n溅琴移榻避，添砚就檐承。\n暗喜同田父，闲听共野僧。\n苦吟题壁上，欲改更慵能。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33221,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽王平甫二首 其二","author":"魏泰","text":"今日临风泪，萧萧似绠縻。\n空怀徐稚絮，谁立郑玄碑。\n无力酬推毂，平时愤抵巇。\n何人令枉状，路粹岂能为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33222,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"留题华山陈先生旧隐","author":"魏野","text":"先生亡不朽，太华合为碑。\n至道虽无迹，玄言尚有诗。\n乱飞云似觅，不食鹤应悲。\n独绕空坛下，山风动紫芝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33223,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陪乔职方泛舟之三门谒禹祠","author":"魏野","text":"波浪溅旌旗，东浮谒禹祠。\n千秋花发日，两院狱空时。\n城里闲棠树，船中舞柘枝。\n晋公曾禊洛，不召野人随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33224,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陪留台李学士筵上赋得文石酒杯分得杯字","author":"魏野","text":"知自何山得，磨砻作酒杯。\n斟疑五色动，醉认一拳开。\n洼似泉舂出，痕如藓渍来。\n主人心朴素，爱惜过璚瑰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33225,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偶作呈谔闰二上人","author":"魏野","text":"老虽无闷向茅堂，忽忽还因物感伤。\n积雾易迷平地水，孤云难护满天霜。\n祥麟可向清时见，惊鹤那于黑处藏。\n信意偶然成此咏，祇堪闲写与支郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33226,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"啄木鸟二首 其二","author":"魏野","text":"乱绕园林啄，终朝意若何。\n莫因饥不足，翻爱蠹偏多。\n渴映邻溪下，惊从别树过。\n辛勤咏还嘱，无损好枝柯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33227,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"啄木鸟二首 其一","author":"魏野","text":"爪利嘴还刚，残阳啄更忙。\n千林蠹如尽，一腹馁何妨。\n形小过槐陌，声高近草堂。\n岂同闲燕雀，唯解占雕梁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33228,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄王谷推官","author":"魏野","text":"登科二十载，佐幕尚如初。\n官为诗磨折，家因酒破除。\n青衫应懒补，白发想慵梳。\n别后常相忆，何缘得共居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33229,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄用晦上人","author":"魏野","text":"帝里如何忘旧山，却因知己得名贤。\n司仓道合唯无可，吏部交游祇大颠。\n紫色袈裟无蕙带，清斋衬施有苔钱。\n诗中琴里偏相忆，用晦还应信仲先。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33230,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄陈越学士托附魏仲容","author":"魏野","text":"取次升沈论等差，云霄独不忘泥沙。\n常流对面如千里，密友终身似一家。\n魂梦因君游辇毂，书题为我寄烟霞。\n仲容到日还应说，半纪相思两鬓华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33231,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄河中王专推官兼呈知府孙学士","author":"魏野","text":"风流官职称红莲，花发多同太守筵。\n绿醑十分倾玉斝，清商一部列金钿。\n池塘闲咏陪灵运，楼阁时登异仲宣。\n更想清明倚公暇，栖岩万固到应偏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33232,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄河中田沃兼呈李渎徵君","author":"魏野","text":"未遂去蓬瀛，閒居在舜城。\n七弦调似性，万卷记如名。\n下榻留山相，敲门认竺卿。\n中条与太华，窗里见峥嵘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33233,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄唐异山人","author":"魏野","text":"不见琴书友，相思二十秋。\n能消几度别，便是一生休。\n未得云迎步，还应雪满头。\n何时各携杖，竟去会嵩丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33234,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄逸人陈孟","author":"魏野","text":"姑射山前住，朝昏事若何。\n炉消文火疾，琴断武弦多。\n绝粒身弥健，酬杯性转和。\n相思与僧约，春暖杖藜过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33235,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题阌乡李氏茅亭","author":"魏野","text":"阌乡右邑有吾亲，河上茅亭结构新。\n五老分明为北里，三峰咫尺是西邻。\n儿孙不厌闲游客，鸥鹭偏谙醉主人。\n彼此眠云相隐梦，从今应更往还频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33236,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄赠三门漕运卞寺丞二首 其二","author":"魏野","text":"三门闲想六龙家，多少春来事可誇。\n阁道寻僧同鹫岭，楼船载妓胜仙槎。\n送迎几拂新亭柳，巡历时穿旧县花。\n野客寻常思重谒，却愁诗酒势难加。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33237,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄赠三门漕运卞寺丞二首 其一","author":"魏野","text":"威权自与转输同，仆从衙庭事事雄。\n十郡山河关职务，一门忠孝是家风。\n图书半在仙舟里，碑板多留禹庙中。\n闲想春堤游赏处，桃花浪照舞筵红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33238,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄赠长安孙紫微","author":"魏野","text":"带掌丝纶出镇时，乐天当日未如之。\n九迁官职光鹓鹭，百二山河壮虎貔。\n汉殿旧题司马赋，秦楼新唱舍人诗。\n相思大欲相寻处，酒户如何敌酒卮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33239,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄赠西川御史薛端公益州司理刘大著陕路运使臧殿院梓州提刑唐察院","author":"魏野","text":"四贤同在两川时，不独民间斗察微。\n蜀魄血流啼亦少，巴猿肠断叫应稀。\n文君酒旨停红旆，神女云从慝绣衣。\n雪尽沉冤题尽景，齐看诏向十州归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33240,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄赠陈越兼简臧奎","author":"魏野","text":"君游帝里共喧喧，我向溪边独悄然。\n工部声华穷委地，翰林风骨醉看天。\n朱门想少投封状，两制应多借盛编。\n伫听彤庭呈试罢，龙头相让一人前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33241,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄赠河中孙大谏兼简刘大著李渎处士","author":"魏野","text":"暂出皇州路不赊，莫同梦得动咨嗟。\n双旌况镇重华国，五府犹为大尹家。\n刘耀卿方知属邑，李长源旧寄生涯。\n相逢应是星频聚，岂独山河势可誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33242,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄赠河中表兄李渎","author":"魏野","text":"早年声誉压群公，耻与浮华斗竞同。\n似我枉教縻好爵，如君方信是冥鸿。\n轩车少见权门下，图籍多于秘阁中。\n岂独圣朝无贺监，退藏自怯达尧聪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33243,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄赠知洋州李泽屯田","author":"魏野","text":"一种分符命最优，翠微深处是洋州。\n白云绕座疑山相，红旆随行表郡侯。\n禅定僧疑陪静话，音声鸟称伴閒游。\n更输属邑钱希圣，四季花前共倡酬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33244,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄赠桃林尉史温","author":"魏野","text":"知韫才能负壮心，莫嗟作尉尚湮沉。\n幽求起去登台席，居易徵来入翰林。\n望气台边桑柘密，弃繻关畔水云深。\n怜君况是徵君后，闲拟秋凉策杖寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33245,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄赠蓝田王辟寺丞","author":"魏野","text":"蓝田名冠古京华，诗匠移风更可誇。\n解使射生人改业，能令逐熟客安家。\n韩文公记存厅壁，王右丞居对县衙。\n见说偷闲偏往处，悟真寺最好烟霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33246,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寇相公生辰二首 其二","author":"魏野","text":"弈世英髦命世贤，悬弧时节早秋天。\n蟾光望处将三五，凤历推来恰半千。\n功向清朝终突兀，寿同皇祚合连延。\n预愁来岁逢今日，不得中书献此篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33247,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寇相公生辰二首 其一","author":"魏野","text":"岳渎精英气，来钟积庆门。\n何时生上相，明日是中元。\n仙药宁无种，灵椿别有根。\n伫期三入后，一品见玄孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33248,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寇相公生辰因有寄献","author":"魏野","text":"宋朝元老更谁先，已咏功成二十年。\n好去上天辞将相，归来平地作神仙。\n坐看云岫资闲兴，卧听霓裳引醉眠。\n多少年辰献诗者，应无真祷似狂篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33249,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]