[{"title":"冬至日归自天庆观二首 其二","author":"杨万里","text":"节里人家笑语饶，日高犹自烛光交。\n霜林遮眼八九叶，露竹出墙三四梢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66815,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬至日归自天庆观二首 其一","author":"杨万里","text":"逗晓清寒未苦严，轻霜随分点茅檐。\n雾中失却溪边寺，不见浮屠只见尖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66816,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬至前三日","author":"杨万里","text":"故山千里几时回，又见初阳动琯灰。\n酒不逢人还易醉，诗如得句偶然来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66817,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬暖绝句","author":"杨万里","text":"今岁无寒祇有暄，腊前浑似半春天。\n醉中苦有薰香癖，烧得春衫两袖穿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66818,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出永丰县西石桥上闻子规二首 其二","author":"杨万里","text":"怨笛哀筝总不如，一声声彻九天虚。\n若逢雨夜如何听，幸得花时莫管渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66819,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出永丰县西石桥上闻子规二首 其一","author":"杨万里","text":"花愁月恨只长啼，雨夕风晨不住飞。\n自出锦江归未得，至今犹劝别人归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66820,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出城途中小憩","author":"杨万里","text":"未到江城已日斜，山烟白处是人家。\n秋风毕竟无多巧，只把燕支滴蓼花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66821,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出蛱二首 其二","author":"杨万里","text":"船行尽缓底须忙，诗卷聊堪度日长。\n瓶里柚花偷触鼻，忽然将谓是烧香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66822,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出真阳峡十首 其十","author":"杨万里","text":"未必阳山天下穷，英州穷到骨中空。\n郡官只怨无供给，支与真阳数石峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66823,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出真阳峡十首 其九","author":"杨万里","text":"春光浓里更江行，画舫分明是水亭。\n出了真阳恰惆怅，数峰如笋雨中青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66824,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出真阳峡十首 其八","author":"杨万里","text":"今岁春流涨又销，水痕犹印石间茅。\n浮槎却被春流误，长挂江边小树梢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66825,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出真阳峡十首 其七","author":"杨万里","text":"只言英石冠南中，未识真阳一两峰。\n遮莫坡陀将不去，将诗描取小玲珑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66826,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出真阳峡十首 其六","author":"杨万里","text":"入峡长思出峡行，出来却忆峡中清。\n一江碧水供诗砚，两岸青山作砚屏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66827,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出真阳峡十首 其五","author":"杨万里","text":"江枫新染绿衣衫，知费春风几把蓝。\n道是春光在桃李，试除桃李尽教参。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66828,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出真阳峡十首 其四","author":"杨万里","text":"峡中出了又逢滩，破浪牵船分外难。\n只是峡山临欲别，此滩留我再看山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66829,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出真阳峡十首 其三","author":"杨万里","text":"峡岭分明是假山，乱堆怪石入云间。\n上头更种青琼树，下照春江玉镜寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66830,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出真阳峡十首 其二","author":"杨万里","text":"细雨初来刺水纹，三针两线未教繁。\n不知忽有何忙处，急洒千千万万痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66831,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出真阳峡十首 其一","author":"杨万里","text":"过尽危矶出小潭，回头失却石峰巉。\n春寒料峭元无事，知我犹藏一布衫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66832,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出惠山遥望横山","author":"杨万里","text":"三日横山反覆看，殷勤送我惠山前。\n常州更在横山外，只望横山已杳然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66833,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"半山寺三首 其三","author":"杨万里","text":"日边赐额寺名新，鸡犬犹迎旧主人。\n见说小儿齐拍手，半山寺主裹头巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66834,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"半山寺三首 其二","author":"杨万里","text":"老无稚子为应门，病有毗耶伴此身。\n相府梵宫均是幻，却须舍宅即离尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66835,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"半山寺三首 其一","author":"杨万里","text":"霜松雪竹老重寻，南荡东陂水自深。\n凤去宅存谁与住，不如作寺免伤心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66836,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"去瑞香病叶","author":"杨万里","text":"紫蕤落尽长青枝，政是添新换旧时。\n辛苦为渠耘病叶，殷勤挽住是游丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66837,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"发孔镇晨炊漆桥道中纪行十首 其十","author":"杨万里","text":"水夹横堤柳万株，雨馀新沐更新梳。\n柔条如线长而细，不贯双鱼只贯珠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66838,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"发孔镇晨炊漆桥道中纪行十首 其九","author":"杨万里","text":"清晓新凉惬老怀，只愁傔从可怜哉。\n泥行寸步无由到，雨去前山却复回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66839,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"发孔镇晨炊漆桥道中纪行十首 其八","author":"杨万里","text":"雨入秋空细复轻，松梢积得太多生。\n忽然落点拳来大，偏作行人滴伞声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66840,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"发孔镇晨炊漆桥道中纪行十首 其七","author":"杨万里","text":"行穿诘曲更崔嵬，野店柴门半未开。\n皂荚树阴黄草屋，隔篱犬吠出头来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66841,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"发孔镇晨炊漆桥道中纪行十首 其六","author":"杨万里","text":"君看人迹蝶来轻，踏得林间路作坑。\n古路今人行不得，一时移上上头行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66842,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"发孔镇晨炊漆桥道中纪行十首 其五","author":"杨万里","text":"斫地烧畬旋旋开，豆花麻荚更菘栽。\n荒山半寸无遗土，田父何曾一饱来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66843,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"发孔镇晨炊漆桥道中纪行十首 其四","author":"杨万里","text":"不但秋原雨冒田，坐看平地路成川。\n隔田山下青松外，不见人家只见烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66844,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"发孔镇晨炊漆桥道中纪行十首 其三","author":"杨万里","text":"雨入秋田恰及时，禾头相枕卧相依。\n路南路北皆秋水，净洗行人屦上泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66845,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"发孔镇晨炊漆桥道中纪行十首 其二","author":"杨万里","text":"可堪衰病两相缠，更苦悬车尚五年。\n羡杀雨中山上水，留它不住竟归田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66846,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"发孔镇晨炊漆桥道中纪行十首 其一","author":"杨万里","text":"梦中一夜雨浪浪，晓过田间尚雨香。\n塘水溉田能几许，雨馀田水却归塘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66847,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"发通衢驿见梅有感","author":"杨万里","text":"忙中掠眼雪枝斜，落片纷纷点玉沙。\n虚过一冬妨底事，不曾款曲是梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66848,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"发慈湖过烈山望见历阳一带山二首 其二","author":"杨万里","text":"一出还添二百诗，风光投到费推辞。\n江湖物色休吟尽，留取西归一半题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66849,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"发慈湖过烈山望见历阳一带山二首 其一","author":"杨万里","text":"梦绕天津月再湾，慈湖解缆已开颜。\n淮山到眼浑相识，直北青梢是定山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66850,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"四月一日三衢阻雨二首 其二","author":"杨万里","text":"小诗苦雨当云笺，寄似南风一问天。\n漏得银河乾见底，却将什么作丰年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66851,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"四月一日三衢阻雨二首 其一","author":"杨万里","text":"无朝无夕雨翻盆，村北村南水接天。\n断却市桥君莫笑，前头野渡更无船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66852,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"四月中休日闻蝉","author":"杨万里","text":"荔枝叶底暑阴清，已有新蝉一两声。\n荷露柳风餐未饱，怪来学语不分明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66853,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"左藏南库西庑下纸閤负暄戏题","author":"杨万里","text":"水衡仙客住冰天，雪齧风餐更禁烟。\n不是移来小旸谷，老夫冻折两诗肩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66854,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"归云三首 其三","author":"杨万里","text":"坐看山头托宿云，一云才动万云奔。\n霍然散作千村雾，远处昏来近处昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66855,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"归云三首 其二","author":"杨万里","text":"三足鸦儿出海东，飞光一朵染天红。\n只销半点归云动，立地濛濛暗太空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66856,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"归云三首 其一","author":"杨万里","text":"可杀归云也爱山，夜来都宿好山间。\n偶看一絮翩然起，引得崩腾相趁还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66857,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"归自豫章复过西山","author":"杨万里","text":"一眼苕花十里明，忽疑九月雪中行。\n我行莫笑无驺从，自有西山管送迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66858,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"归途轿中读参寥诗","author":"杨万里","text":"车中无作惟生睡，卷里何佳却胜闲。\n会意贪看三五句，回头悔失数重山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66859,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"归路过南溪桥二首 其二","author":"杨万里","text":"爱它风物重徘徊，归路迟迟却快哉。\n曲折缘溪非细好，忽逢断岸却回来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66860,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"归路过南溪桥二首 其一","author":"杨万里","text":"霜风一动岭云开，云外樵歌暮更哀。\n童子隔溪呼伴侣，并驱水牯过溪来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66861,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戊戌正月二日雪作二首 其二","author":"杨万里","text":"梦回纸帐怪生寒，童子传呼雪作团。\n已被晓风融作水，头巾不裹起来看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66862,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戊戌正月二日雪作二首 其一","author":"杨万里","text":"雪与新春作伴回，捣霜为片雹为埃。\n只愁雪虐梅无奈，不道梅花领雪来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66863,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"正月二十八日峡外见燕子二首 其二","author":"杨万里","text":"不宿青枫学子规，不穿绿柳伴莺啼。\n双飞只爱清江水，自喜身轻照舞衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66864,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"正月二十八日峡外见燕子二首 其一","author":"杨万里","text":"社日今年定几时，元宵过了燕先归。\n一双贴水娇无奈，不肯平飞故仄飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66865,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"正月二十四夜朱师古少卿招饮小楼看灯二首 其二","author":"杨万里","text":"南北高峰醒醉眸，市喧都寂似岩幽。\n君言去岁西湖雨，城外荷声到此楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66866,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"正月二十四夜朱师古少卿招饮小楼看灯二首 其一","author":"杨万里","text":"光射琉璃贯水精，玉虹垂地照天明。\n风流谁似朱夫子，解放元宵过后灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66867,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"正月三日骤暖多稼亭前梅花盛开四首 其四","author":"杨万里","text":"却缘腊雪勒孤芳，等待晴光晒麝囊。\n小立树西人不会，东风供我打头香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66868,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"正月三日骤暖多稼亭前梅花盛开四首 其三","author":"杨万里","text":"初开犹见蒂和心，今日来看花满林。\n日照一团都是雪，更无红蜡与黄金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66869,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"正月三日骤暖多稼亭前梅花盛开四首 其二","author":"杨万里","text":"绝爱西湖疏影诗，要知犹是未开时。\n如今开尽浑无缝，只见花头不见枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66870,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"正月三日骤暖多稼亭前梅花盛开四首 其一","author":"杨万里","text":"春被梅花抵死催，今年春向去年回。\n春回十日梅初觉，一夜商量一并开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66871,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"正月五日以送伴借官侍宴集英殿十口号 其四","author":"杨万里","text":"千官拜舞仰虚皇，奉上瑶池万寿觞。\n殿上双传送御酒，槛前一曲绕虹梁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66872,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"正月五日以送伴借官侍宴集英殿十口号 其三","author":"杨万里","text":"金鬣狻猊立玉台，双瞻御坐首都回。\n水沉山麝蔷薇露，漱作香云喷出来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66873,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"正月五日以送伴借官侍宴集英殿十口号 其二","author":"杨万里","text":"一点胡行朝汉天，英符来自玉门关。\n旧时千岁琵琶语，新学三声万岁山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66874,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"正月五日以送伴借官侍宴集英殿十口号 其九","author":"杨万里","text":"广场妙戏斗程材，未得天颜一笑开。\n角抵罢时还宴罢，卷班出殿戴花回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66875,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"正月五日以送伴借官侍宴集英殿十口号 其一","author":"杨万里","text":"殿下鞭声再掣雷，玉皇徐下九天来。\n阴晴不定朝来定，五色祥云霍地开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66876,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"正月五日以送伴借官侍宴集英殿十口号 其八","author":"杨万里","text":"赐花新剪茜香罗，篸遍乌纱未觉多。\n花重纱轻人更老，抬头不起奈春何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66877,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"正月五日以送伴借官侍宴集英殿十口号 其七","author":"杨万里","text":"猛士缘竿亦壮哉，踏空舞阔四裴回。\n一声白雨催花鼓，十二竿头总下来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66878,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"正月五日以送伴借官侍宴集英殿十口号 其五","author":"杨万里","text":"太极重开万物新，绍熙天子宴群臣。\n梨园好语君须听，玉历初颁第一春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66879,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"正月五日以送伴借官侍宴集英殿十口号 其十","author":"杨万里","text":"贺老如何尾从班，真官也作借官看。\n君恩至重无真假，赐酒何曾味两般。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66880,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"正月将晦繁星满天","author":"杨万里","text":"兔冷蟾寒不出时，群仙无睡尚游嬉。\n可怜深夜无灯火，碧玉枰前暗著棋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66881,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"永丰驿逢故人赵伯庭过叔","author":"杨万里","text":"同官赣水总青春，消息中间两不闻。\n道我未衰君莫戏，不须看我只看君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66882,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"永和放船二首 其一","author":"杨万里","text":"永和不到又经秋，淡日微风好放舟。\n最是可怜江上路，人来人去几时休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66883,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"永和放船二首 其二","author":"杨万里","text":"濒江楼阁祇遥看，却恐登临不足观。\n已是老来无眼力，更供两岸万峰寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66884,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉山道中","author":"杨万里","text":"村北村南水响齐，巷头巷尾树阴低。\n青山自负无尘色，尽日殷勤照碧溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66885,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉壶饯客独赵达明末至云迓族长于龙山且谈道中事戏为纪之二首 其二","author":"杨万里","text":"公子从来火伞中，解衣未定语匆匆。\n山行触热端何事，夹路杨梅树树红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66886,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉壶饯客独赵达明末至云迓族长于龙山且谈道中事戏为纪之二首 其一","author":"杨万里","text":"南山行尽到西湖，却上扁舟赴玉壶。\n十里便成三十里，暑中何处不长涂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66887,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"甘瓠","author":"杨万里","text":"笑杀桑根甘瓠苗，乱它桑叶上它条。\n向人更逞廋藏巧，怪道桑梢挂一瓢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66888,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"田家乐","author":"杨万里","text":"稻穗堆场谷满车，家家鸡犬更桑麻。\n漫栽木槿成篱落，已得清阴又得花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66889,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"甲子初春即事六首 其六","author":"杨万里","text":"人怨花迟发，天教暖早催。\n不知要催落，却道是催开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66890,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]