[{"title":"初晴","author":"赵友直","text":"久雨初收霁，开窗动我情。\n野花含宿泪，山鹊弄新声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43737,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"承友携琴见访","author":"赵友直","text":"三尺丝桐太古音，清风明月是知心。\n伯牙去后无消息，会见君家契此深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43738,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋晚登眠牛冈偶赋","author":"赵友直","text":"满路尘嚣不耐愁，眠牛冈上自清秋。\n霜高木叶流丹冷，宜为黄花一举瓯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43739,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送春","author":"赵友直","text":"宿雨淹无霁，落花翠点苔。\n东君今日去，借问几时回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43740,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"耕","author":"赵友直","text":"布谷声中雨一犁，绿蓑青笠两相宜。\n陇头枉费驱牛力，旱潦年来未可期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43741,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"望海尖望海","author":"赵友直","text":"天悬一柱郁崔嵬，海若遥看出不回。\n叠岸犹疑鞭石起，独惭无计觅蓬莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43742,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寒食","author":"赵友直","text":"人道芳辰载酒行，予心翻起古今情。\n纸钱烧罢归来后，犹有原头杜宇声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43743,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登五龙尖晚归鼓琴","author":"赵友直","text":"绝巘淩风驾白云，登临兴后鼓南薰。\n朱弦一到无心处，自觉人间无可闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43744,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赋友授徒","author":"赵友直","text":"孤竹清风迥，尼坛化雨淋。\n群英公乐育，何必羡华簪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43745,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端午","author":"赵友直","text":"节遇端阳日，蒲觞满自斟。\n兴怀多感旧，吊古漫成吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43746,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题壁","author":"赵良埈","text":"三北何人知管仲，五湖何处觅陶朱。\n壁间遗墨还堪睹，吊罢灵魂一束刍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43747,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠行","author":"赵友直","text":"无酒不成别，无诗别不成。\n别君诗一首，马上酒三行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43748,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"瞻兰芎山","author":"赵友直","text":"兰芎围绝嶂，图画望中悬。\n几度令人慕，登临学葛仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43749,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山中即景四首 其四 冬","author":"赵友直","text":"茅屋冻将压，柴门寒自拴。\n掘炉煨芋栗，呵笔写诗篇。\n策杖深山里，寻梅古洞边。\n谁知居士乐，翻受俗人怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43750,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山中即景四首 其三 秋","author":"赵友直","text":"故园秋雨后，足迹遍溪山。\n月入芦花冷，风磨柳叶残。\n群乌乱木末，独雁咽云端。\n此景堪谁遣，村醪味带酸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43751,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山中即景四首 其二 夏","author":"赵友直","text":"趁此清和景，荷筒酒一吞。\n围棋开北墅，羽扇取南薰。\n兰雨清传馥，鸥波绿涨纹。\n枕书鼾睡处，忽梦到陶君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43752,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山中即景四首 其一 春","author":"赵友直","text":"谷风吹我户，襟抱豁然开。\n雪向梅边尽，春从柳上来。\n花瓶长绿草，茶碗泛香醅。\n逸兴难拘缚，寻诗屐破苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43753,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"立夏","author":"赵友直","text":"四时天气促相催，一夜薰风带暑来。\n陇亩日长蒸翠麦，园林雨过熟黄梅。\n莺啼春去愁千缕，蝶恋花残恨几回。\n睡起南窗情思倦，闲看槐荫满亭台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43754,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"创泳泽书院初成","author":"赵友直","text":"万古湖山一望央，紫阳道脉壮宫墙。\n佳朋鳞集互联榻，多士云从相共堂。\n地有金罍非福瑞，天将玉汝任纲常。\n要知学问无他术，只在工夫不怠荒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43755,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寿黄有司诞日","author":"赵友直","text":"天挺英才佐庙廊，千年懋绩炳旗常。\n悬弧偏喜民生寿，报国还期道体康。\n庭有芝兰呈晚秀，门多桃李毓春芳。\n微吟聊助冈陵祝，鹤发乌纱映鬓霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43756,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"咏兰","author":"赵友直","text":"晓来一雨忽初收，九畹分香绕碧流。\n裛露灵苗凝浅翠，迎风素质拂轻柔。\n自甘深谷同巢许，不羡巍阶并管周。\n物类尚知羞媚世，污名秽节岂吾俦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43757,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重九对菊","author":"赵友直","text":"霜压危檐冷，萧条秋满林。\n青云知己惠，黄菊故园心。\n百虑凭祛遣，颓龄仗制禁。\n缅思彭泽叟，履运□怀深。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43758,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻莺","author":"赵友直","text":"闷坐书斋学诉春，漫思黄鸟转伤神。\n惟知弄舌娇和巧，不管行人喜与嗔。\n侵晓爱趋红树暖，移时又向绿杨新。\n始知春燕情何厚，日日相依旧主人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43759,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病中感友不至","author":"赵友直","text":"侬家好观水，结屋傍西湖。\n荒径人踪少，苍苔鸟迹无。\n交情穷始见，世态燠斯孚。\n病懒疏迎接，偏宜客不呼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43760,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢徐隐君屡见惠","author":"赵友直","text":"慷慨论交日，情深即故知。\n金兰敦古道，松柏挺奇姿。\n屡辱分嘉惠，何繇致我私。\n临风无限思，搔首一嗟咨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43761,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"释闷","author":"赵友直","text":"槛外山花照眼明，独怜幽抱向谁评。\n因寻乐处诗为友，欲破愁城酒作兵。\n歌罢倦吟多少句，醉馀强进两三觥。\n春光容易催人老，莫把污名玷此生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43762,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"暮春即景","author":"赵友直","text":"衡门三月景，万顷浩无穷。\n堤柳轻浮碧，野花净落红。\n小桥溪水涨，曲径峪云笼。\n牧子横牛背，前村一笛风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43763,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"漫兴二首 其二","author":"赵友直","text":"南轩梅雨晚来频，雨霁轩清尽可人。\n不著东山双屐齿，偏宜渭水一丝纶。\n愁中托酒无辞醉，梦里看花莫认真。\n行乐随时吾事耳，乾坤何地不容身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43764,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"漫兴二首 其一","author":"赵友直","text":"偃息林皋与世违，兴来长啸不妨痴。\n素怀欲辟留侯谷，僻性耽茹角里芝。\n漫谓五湖真乐事，须誇三径足幽栖。\n时人何用讯名氏，久矣迂疏不自知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43765,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"七夕","author":"赵友直","text":"一叶井梧飘，双星忽相值。\n却怜参与商，晤会当何夕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43766,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"卜居二首 其二","author":"赵友直","text":"吾宗本郊居，勤俭历几世。\n礼失于野求，力耕真吾事。\n古称识时务，必在贤与智。\n用贻厥孙谋，无为忽去此。\n去此亦不难，安居亡所恃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43767,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"卜居二首 其一","author":"赵友直","text":"出郭虽超俗，尘嚣亦蕃骈。\n以此感日蹙，拟耕牛山田。\n溪湖相输灌，扁舟恣洄沿。\n似兹安乐径，允可置一椽。\n匪自耽寥寂，与彼坟墓牵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43768,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"己卯岁除夜","author":"赵友直","text":"刚迎新岁至，俄惊岁复分。\n烧灯明万户，爆竹响千门。\n愁对梅花咏，强将柏叶吞。\n经年心底事，明日付东君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43769,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"忆攒宫","author":"赵友直","text":"山河绕故封，常照旧时月。\n独有会稽陵，萧然成狐窟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43770,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"见乳燕","author":"赵友直","text":"梅雨初晴绿满陂，忽然乳燕脱巢飞。\n诗成高枕惟鼾睡，不向人间怨索离。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43771,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"长短句四时问四首 其四","author":"赵友直","text":"试问冬满面，朔风何猎猎。\n雪里梅花度暗香，骚人颇有诗相狎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43772,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"长短句四时问四首 其三","author":"赵友直","text":"试问秋疏檐，落叶何萧萧。\n黄花如有故人意，相对篱边共浊醪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43773,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"长短句四时问四首 其二","author":"赵友直","text":"试问夏祝融，何事苦凭陵。\n安得金风起天末，大驱凉雨涤炎蒸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43774,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"长短句四时问四首 其一","author":"赵友直","text":"试问春韶光，何事容易老。\n一点丹心死不灰，馀生未便委芳草。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43775,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丙戌春雾","author":"赵友直","text":"忽逢阴浊气氤氲，四顾山河尽已昏。\n窗外霏霏成细雨，檐端渺渺缀浮云。\n朦胧咫尺人难辨，混沌东西路不分。\n若得一番风扫后，依然再觌旧乾坤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43776,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"兰边晚酌","author":"赵友直","text":"深谷笼幽色，超然味更长。\n薰人先欲醉，对客漫斟尝。\n初触来歌席，犹疑扑酒觞。\n主人困坐久，寂寂不闻香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43777,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"归田园居和陶渊明韵","author":"赵友直","text":"举世堕尘网，我独爱丘山。\n旧业久荒芜，不去待何年。\n栖乌恋故枝，潜鱼乐深渊。\n物类各有托，予盍归田园。\n决水渠双注，藏书居数间。\n孤松挺后檐，五柳栽门前。\n渺渺缀浮云，淡淡笼轻烟。\n蛙鼓池塘畔，鹤唳溪山巅。\n微躯足为乐，稚子堪陪闲。\n不受樊笼系，灵台复自然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43778,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"龙冈歌","author":"赵友直","text":"龙兮龙兮何时兴，云行雨施天下平。\n湫兮湫兮龙之据，龙今去兮留空名。\n苍松倒影肖鳞角，根盘石壁徒崚峥。\n当时旱魃为暴虐，苗禾焦卷皆枯茎。\n嗷嗷下民发虔祷，嗟尔无神扬威灵。\n予今歌罢龙冈曲，翻令两腋清风生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43779,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"仲夏即景","author":"赵友直","text":"五月憩孤村，幽情夐不群。\n鹭飞天上雪，鸥渡渚中云。\n翠麦刚才刈，青苗又复芸。\n浮生行乐耳，世事不须论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43780,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"拟古二首 其二","author":"赵友直","text":"堂堂谷中室，草木恒相邻。\n顷缘出游衍，室内虚无人。\n犬羊窥我间，蹄迹分扰驯。\n秽我衣裳区，安所置其身。\n翘然起遐思，结屋依湖滨。\n手执羲皇卷，门栽五柳春。\n春风一披拂，意恐缁泥尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43781,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"拟古二首 其一","author":"赵友直","text":"圣王创立制，先务正经界。\n群侯肆兼并，井田随破坏。\n经界紊其坊，曷所辨中外。\n三王化邈矣，五霸迭相代。\n仲父作内政，兵与农胥赖。\n列辟已无周，重俾宗且戴。\n伟哉九合功，愿执鞭相待。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43782,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杜宇行","author":"赵友直","text":"君不见四更五更月，杜宇口流望帝血。\n何为生子寄别巢，毛羽摧残悲哽咽。\n将亡皎皎贾廉名，而今怨望未休歇。\n天运自古有废兴，金瓯屹然亦伤缺。\n尧舜受禅夏商衰，夷齐孤竹如敝鞋。\n且须有酒拚颜赤，莫向东风空戚戚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43783,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"搆竹楼初成","author":"赵友直","text":"竹楼新搆喜初成，为检遗编课子程。\n山近砚池云自湿，门无辙迹草偏青。\n光团霁月盘书案，翠煖香风透画屏。\n旧业深怀期远大，心田寸许欲耘耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43784,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"牧","author":"赵友直","text":"相呼相唤出烟堤，冒雨前村膝没泥。\n万斛愁怀人不解，呜呜桐角倚牛吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43785,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南源庙","author":"赵友直","text":"乾坤何处不披图，觅胜谁从此地过。\n三相神功垂舜治，千秋庙貌壮勾湖。\n衢通瑞象无尘境，山隔眠牛有坦途。\n伏腊岁时同到此，祠前瞻拜一諠呼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43786,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"待友不至","author":"赵友直","text":"自与吾朋聊外期，心旌切切望容仪。\n闻言回首非因错，欲语恁栏岂是痴。\n春酒破愁难作喜，莺花供兴不成诗。\n有时会晤情何限，握手论文到日西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43787,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夜宿瑞象寺写怀","author":"赵友直","text":"秋高天宇肃，草际霜华冷。\n明月流清光，徘徊薜萝影。\n予抱千古怀，其将为谁骋。\n兴衰感人事，代谢悲流景。\n长歌紫芝篇，醉卧赤松径。\n斯亦聊且娱，荣华非所竞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43788,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"种田行","author":"赵友直","text":"春雨一犁足郊原，南村北村齐种田。\n抛秧落水时竞捷，老者在后少者前。\n日暮天寒完未得，比邻来相助插田。\n比邻亦来相助插，如何独行之士任迍邅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43789,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"倦来归","author":"赵友直","text":"驰驱数载倦来归，一任流光暗里催。\n缩首愿情忘势利，敛踪甘不受轻肥。\n动于沼上观鸥侣，静在松间共鹤栖。\n此外嚣嚣无别事，编茅插棘护幽扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43790,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读靖节集","author":"赵友直","text":"羲皇世远矣，圣道久秕糠。\n纵有鲁中叟，弥缝犹未遑。\n况复经秦火，烬末谁能匡。\n赤帝按剑起，犄角重傍徨。\n天运如此耳，不饮之何方。\n壶觞辄自引，未肯须臾忘。\n匪苟好沉湎，逃名托醉乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43791,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"悬剑歌","author":"赵友直","text":"家徒四壁何所有，横悬三尺电光溜。\n床头醉看白虹飞，中夜犹惊玉龙吼。\n潜倚空山泣鬼神，寒芒逼人动牛斗。\n无乃干将是前身，莫邪清淬浑天授。\n今者羞为妇女看，霜棱蟠蛰匣中久。\n何日露拔斩长鲸，启函一展剸犀手。\n豪曹湛卢祇自珍，雷焕张华世莫遘。\n傥尔识取英雄眸，此时挥霍任驰骤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43792,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔","author":"赵友直","text":"垂竿终日坐苔矶，两岸芦花作雪飞。\n鱼在深波刚不食，蓑披一片冻云归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43793,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"悲千二弟","author":"赵友直","text":"哀哉我弟兮，一梦竟何归。\n堂前紫荆萎，天边鸿雁离。\n曩尔有志青云技，兹尔回头万事非。\n黄卷窗前不再展，瑶琴月下谁复挥。\n我今为尔写哀词，花笺滴泪声歔欷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43794,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"景物","author":"赵友直","text":"景物撩人□，兴思百念攒。\n亨屯原有定，呼酒拚红颜。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43795,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"墓庐追亲","author":"赵友直","text":"万古维乾坤，一生资父母。\n乾坤春复春，父母恩难补。\n瞻彼林中乌，犹能怀反哺。\n矧兹六尺躯，不念劬劳苦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43796,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"樵","author":"赵友直","text":"踏破芒鞋力已疲，朝还砺斧采薪儿。\n云深迷却山头路，戴笠回来雨湿衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43797,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"甑山","author":"赵友直","text":"湖心一凸起金峦，举目浑如甑底看。\n偃月苍松多少树，敲风翠竹两三竿。\n石头苔藓痕常湿，叶底杨梅味带酸。\n谁学林君来结屋，风光应不让孤山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43798,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠别二首 其二","author":"赵友直","text":"年来聚首情何乐，今日匆匆又解携。\n千里故交惟藉酒，劝君更把手中卮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43799,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠别二首 其一","author":"赵友直","text":"千里论交情累累，尊酒话别临溪水。\n江南为有一枝春，愿寄故人好相慰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43800,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠表弟陈莱寿","author":"赵友直","text":"尔自髫?年，期已领鹗荐。\n两浙多贤豪，论交皆北面。\n徊翔踰几春，尚未输夙愿。\n匪无才与猷，良乏明时眷。\n力田逢少年，处囊陡尔见。\n事绩炳寰区，声华流海甸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43801,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠徐樵隐","author":"赵友直","text":"天命靡有常，空视时运覆。\n珍重山间翁，抱道庸自玉。\n掀髯发清兴，开轩恣遐瞩。\n空谷阒无人，惟有云相逐。\n山翁为有知，恋恋情绻缛。\n绻缛林中薪，歌已禽声续。\n勿谓有倾颓，维心常位育。\n顾我无依归，犹然嗜幽独。\n愿结金兰交，共兹南山麓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43802,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"避暑","author":"赵友直","text":"寰区皆是火，何地避炎官。\n散发松阴下，挂巾石壁间。\n诗题疏竹润，酒入碧筒寒。\n不必频挥羽，清风无汗颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43803,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"有美人兮四章","author":"赵友直","text":"有美人兮，在天之东。\n瞻之勿及，我心憧憧。\n有美人兮，在天之西。\n见之勿遂，我心悽悽。\n有美人兮，在天之南。\n思之勿得，我心惔惔。\n有美人兮，在天之北。\n怀之勿已，我心恻恻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43804,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]