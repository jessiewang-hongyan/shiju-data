[{"title":"遣兴四首 其一","author":"廖行之","text":"贱宜人弗齿，贫遣日劳心。\n不著新诗句，春愁那可禁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27393,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题云梯石和王东卿壁间韵","author":"廖行之","text":"客里春愁万绪长，归心宛转九回肠。\n鸟声啼破刀头梦，似是晓人犹异乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27394,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠舅氏授室","author":"廖行之","text":"不须种玉向蓝田，不用吹笙学凤仙。\n试看玉郎亲迎处，梯云挈得月婵娟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27395,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"七夕","author":"廖行之","text":"从昔人传鹊作桥，一年牛女会清宵。\n几家乞巧罗瓜果，是处开樽沸管箫。\n云雨暂成银汉约，风雷催趁玉晨朝。\n凭谁与问支机石，好上仙槎款碧霄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27396,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"七夕","author":"廖行之","text":"目切云垂望，心驰枕扇凉。\n两年违色养，七夕又他乡。\n坐想斑衣戏，胡为捧檄忙。\n何人翟方进，将母冠岩廊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27397,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又次韵二首 其二","author":"廖行之","text":"年来那复不时须，斗酒珍藏敢罪孥。\n安我馈浆穷逆旅，有谁携榼访幽居。\n粗粱何择皆庚癸，题品宁当辨酪酥。\n自笑悲辛惭杜老，却愁人不食吾馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27398,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又次韵二首 其一","author":"廖行之","text":"几日春寒似禁烟，杜门浑欲任流年。\n得钱相觅非难办，载酒来过定孰先。\n无奈梅边虚胜践，遥怜柳外涨晴川。\n佳时纵意须从事，莫笑幽人也化缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27399,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上湖北赵司仓三首 其二","author":"廖行之","text":"黼扆天高德意深，恩言临遣重丁宁。\n九霄雨露新英节，一日风雷遍洞庭。\n财力定能均息耗，米盐因得裕常经。\n如今想见南翁喜，长望吴头认使星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27400,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上湖北赵司仓三首 其一","author":"廖行之","text":"君侯德业简渊衷，亟上朝端望寖隆。\n鹓鹭羽仪从北阙，骖騑礼乐正西风。\n六条郡国褰帷里，万里沅湘揽辔中。\n早晚诏书归衮舄，由来周召合三公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27401,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上湖南孙漕四首 其四","author":"廖行之","text":"湘雨湘田处处同，谁知公意与天通。\n爱民天亦忧民事，望岁公应喜岁丰。\n自古强兵先足食，从今积粟可平戎。\n关中事业非难办，要看他时第一功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27402,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上湖南孙漕四首 其三","author":"廖行之","text":"湘俗湘人百不忧，口无异论只歌讴。\n皆言此日孙夫子，还是当年郭细侯。\n不信民情容易得，可能仁闻镇长流。\n而今九郡皆膏泽，看取黄云万顷秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27403,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上湖南孙漕四首 其二","author":"廖行之","text":"湘水湘江衮衮流，南连五岭北荆州。\n造船行粟无遗算，自叶流根皆运筹。\n国计已多刘晏策，民情滋欲寇恂留。\n善刀莫起庖丁念，何止恢恢十二牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27404,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上湖南孙漕四首 其一","author":"廖行之","text":"湘郡湘城四十馀，赋租无爽岁无虚。\n三年自是澄清泽，一吏何能抚字书。\n底事古人勤劝课，由来国计在阎闾。\n南阳谁守蒲谁宰，更赖褰帏使者车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27405,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中秋日简同盟诸公","author":"廖行之","text":"风囊啸谷猎尘衫，雨鬣行天驾玉骖。\n一洗蛮烟浑逐北，全提商令似征南。\n佳时不负中秋约，双桂能同一夜谈。\n我亦兰陔奉馨膳，与君欢事喜相参。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27406,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"丰城舟中","author":"廖行之","text":"踏遍江湖路几千，买舟因得憩江天。\n不嫌烟水牵离恨，要狎沙鸥伴醉眠。\n南浦春深波涨岸，长芦风寝浪平川。\n生涯喜近长年老，夜半挐音月满船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27407,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书怀","author":"廖行之","text":"莱衣喜气著青衫，世路从渠裂两骖。\n试问虚名空斗北，何如荣养乐陔南。\n邻墙饱听新诗句，尊酒相从几笑谈。\n闻道秋郊足佳趣，好奇谁复似岑参。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27408,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"无题","author":"廖行之","text":"州牧谁能举，邦人愿借情。\n声名简宸扆，恩信著湘城。\n庞统才何陋，班超策故平。\n何如今别驾，膏泽与江横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27409,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"无题 其二","author":"廖行之","text":"逸兴飘飘鹤九皋，凉州那得费蒲萄。\n一从卜筑东山胜，便觉声名北斗高。\n手种百花从日涉，心澄万虑弭汤鏖。\n主人已作骑鲸去，谁与鸿濛共胜遨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27410,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"月夜有怀二宋兄","author":"廖行之","text":"云容冉冉碧于衫，蟾影腾腾稳胜骖。\n万壑凉声生木末，一天秋色满江南。\n闻鸡漫起狂夫舞，扪虱谁从隐士谈。\n坐想诗翁搜好句，初机还许学人参。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27411,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"水仙","author":"廖行之","text":"擢擢琼簪秀，盈盈玉颊新。\n陇梅真季孟，洛浦是精神。\n好在临江佩，遥怜步月尘。\n对花恼诗思，何必霅溪莼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27412,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"代送王守赴湖北漕","author":"廖行之","text":"紫泥芝检下遥天，绣斧荣更竹使权。\n六辔周王新礼乐，重湖楚国旧山川。\n澄清风采生麾节，眷倚精神跂邃綖。\n早晚沙堤归步稳，二台齐色耀星躔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27413,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"用韵杂兴","author":"廖行之","text":"夏葛冬裘等一衫，飞黄跛鳖谩同骖。\n人情展转怜风月，世路沈迷泣北南。\n我已灰心忘厚味，谁其缄口罢游谈。\n如今欲问西来意，便挂僧牌报放参。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27414,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"田舍杂兴怀长兄四首 其四","author":"廖行之","text":"遥知此日黄初起，颇忆平生马少游。\n薄有田园奉甘旨，苦无机械与沈浮。\n如今官事真谁了，底事周南独子留。\n白发倚门还念否，令人翻动北山讴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27415,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"田舍杂兴怀长兄四首 其三","author":"廖行之","text":"去城靳靳路一驿，故岁迢迢今甫来。\n桃李阴成真绿野，溪山清绝胜章台。\n青衫手板徒劳尔，竹杖芒鞋亦快哉。\n莫向红尘深著脚，而今毛鸷苦相猜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27416,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"田舍杂兴怀长兄四首 其二","author":"廖行之","text":"不到田家又夏初，试从野老访耕锄。\n稻畦高下水皆足，天意雨晴时自如。\n学稼我犹惭孔子，问津君且向长沮。\n宦游何似团栾好，更念怀归畏简书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27417,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"田舍杂兴怀长兄四首 其一","author":"廖行之","text":"少休廛市喧嚣耳，来听田农应和歌。\n畟畟耕畴皆帝力，欣欣时物自天和。\n山云亭午半未敛，溪雨黄昏清更多。\n但得长年饱禾稻，也胜官里厌风波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27418,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示梦龙侄","author":"廖行之","text":"小验文场粗慰心，读书从此更谆谆。\n要令大敌尤能勇，须索新功又过人。\n得力无过亲翰墨，致身端可上星辰。\n秋风春浪鳌头好，拭目吾宗尽国珍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27419,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同伯潜诸公联骑出城东次衫字韵","author":"廖行之","text":"怯晓征衣袭小衫，山头淡月照联骖。\n晴光忽散湘江上，秋色疑连梦泽南。\n后约吹香舒藻思，同游载酒款犀谈。\n遥知坚卧朱文季，倦听朝鸡趁六参。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27420,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"向氏归来园","author":"廖行之","text":"十亩江头地，今时靖节园。\n辋川惭画古，绿野谩名存。\n自有菊成径，何须花满原。\n是间无俗物，不用闭松门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27421,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"如新墙宿于刘叟逆旅","author":"廖行之","text":"一雨洗残暑，初秋生嫩凉。\n寸岑馀黛绿，多稼已云黄。\n早觉宦情薄，可能诗兴长。\n空惭赋囊粟，持底报君王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27422,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"岁晚寄罗舜举","author":"廖行之","text":"岁晚旅怀恶，云平东望赊。\n故人空眼底，别恨忆江涯。\n尺素形声画，萍踪溷齿牙。\n襟期定何许，归梦恼胡笳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27423,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戏咏白发","author":"廖行之","text":"与愁添悴色，为老出孤标。\n髣髴生银缕，依微散玉苗。\n摘除犹茁茁，晞沐更萧萧。\n相见函关路，应符物色邀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27424,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"有禽声急而似可晓乡人以催税目之其声亦颇类焉因感而成诗","author":"廖行之","text":"怪底微禽似有知，区区舌吻竟奚为。\n欲将终日能鸣巧，深为当时远害思。\n布谷尚应勤播种，春畦何事较公私。\n谁如独占催科考，无复阳城恨拙迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27425,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次纲官王簿韵兼简伯潜二首 其二","author":"廖行之","text":"柳岸流莺两两黄，风光浑在一帘香。\n休辞老去追随懒，莫遣春归倥偬忙。\n满地芳茵犹胜践，漫天飞絮漫轻狂。\n溪园早有同游约，准拟杯行引兴长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27426,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次纲官王簿韵兼简伯潜二首 其一","author":"廖行之","text":"江上晴光照眼浓，十分春色满城东。\n客怀何限湘波绿，漕事方殷汉粟红。\n雅有诗情添兴远，可无酒力破愁攻。\n舳舻早晚蒲帆稳，长啸东南万里风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27427,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次陈颐刚与许拾遗酬唱之作","author":"廖行之","text":"奇谋端合赞几沈，何事山林意味深。\n引类古人方厚禄，忧时百念可灰心。\n会看览德翔千仞，未信干霄老百寻。\n却笑疏慵真漫仕，閒中赢得二毛侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27428,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵酬宋伯潜三首 其三","author":"廖行之","text":"老懒渠能更倔强，邻墙可恋瓮头香。\n卷舒自我聊全璧，非笑从人亦大方。\n日永游丝随望远，春深乳燕趁晴忙。\n閒来不入邯郸梦，未厌区区白首郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27429,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵酬宋伯潜三首 其二","author":"廖行之","text":"百拙无堪不自强，身谋犹得学黄香。\n青衫良助君衣綵，圆凿何嫌我枘方。\n旧雨故人相得甚，浮云苍狗可怜忙。\n从君更许闻诗律，唤醒风骚起夜郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27430,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵酬宋伯潜三首 其一","author":"廖行之","text":"诗坛得隽敌无强，独立南丰一瓣香。\n我欲句中闻妙法，君应肘后出神方。\n陶镕景色春长好，流转风光物自忙。\n珍重三薰更三沐，全胜汤饼试何郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27431,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江楼雪望","author":"廖行之","text":"几日凝空雪未阑，江头乘兴一凭栏。\n瑶池宫阙连天迥，琼圃山川特地宽。\n极目龙沙千里远，倚空冰柱数峰寒。\n望中浑觉蟾宫近，便欲乘风寄羽翰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27432,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观潮","author":"廖行之","text":"江接东溟阔，潮从八月高。\n祇应风捲浪，谁遣怒成涛。\n舟楫乘流迅，鱼龙得意豪。\n瀛洲今不远，好去钓金鳌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27433,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宋伯华趋朝用川字衫字韵作二诗送之 其二","author":"廖行之","text":"驰名衮衮甚长川，君独乘风万里船。\n得意正看期汗漫，趋时宁肯媚连娟。\n升沈百辟方公道，扶植斯文要众贤。\n元献景文今棣萼，还须柱石汉中天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27434,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宋伯华趋朝用川字衫字韵作二诗送之 其一","author":"廖行之","text":"微雨轻寒透客衫，十分秋色相征骖。\n人占逸驾应空北，君自良图已运南。\n须信由来非枉尺，谁云领取勿多谈。\n而今吐握逢知己，会听新除趁六参。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27435,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寿巴陵朱宰","author":"廖行之","text":"万里沅湘浩荡秋，秋来佳致日清遒。\n湖平一碧波光静，雨足千崖暑气收。\n底事欢声腾下隽，祗今贤宰在中牟。\n民情天意归仁寿，看到三公尚黑头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27436,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"弃屣有感","author":"廖行之","text":"蹈遍关山日几西，周旋步武镇相依。\n居贫原宪履长决，战罢吴王屦不归。\n已类惫靴无复召，空惭释屩顿成非。\n尘劳弃屣今何有，纵尔双凫自在飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27437,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"怀程正翁","author":"廖行之","text":"江上送君归，灯前凝我思。\n源流嗟世远，师友不吾欺。\n此道无今昔，人生易别离。\n江湖几千里，从此尚心期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27438,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"社日雨","author":"廖行之","text":"一年好乐九十日，底事天工力作难。\n自古惜春晴有几，只今连夕雨犹?。\n朝来已报山城社，客里那知花信寒。\n遥想故园田父乐，伐豚酾酒树团栾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27439,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"还十五弟文稿","author":"廖行之","text":"文府高扃守鬼神，蔽亏那掩艳华春。\n屠门肯作朵颐过，龙颔轻攘照海珍。\n十袭莫论藏弆宠，双眸姑浣向来尘。\n从兹染指谙腴味，藜苋难甘诳腹贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27440,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和长兄席间书事","author":"廖行之","text":"穷山二月无多乐，犹作春来料峭寒。\n常恐花枝暗萧索，却教诗句漫艰难。\n寻芳赖有城西角，泥饮休论日几竿。\n他日山僧纪清集，阁中应作画图看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27441,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和丙午衡州鹿鸣宴诗","author":"廖行之","text":"丹诏飞来万国春，抡才美意属贤臣。\n几年志气风云壮，一旦声名日月新。\n好把良筹裨负扆，莫贪香饵堕垂纶。\n来年上国风光好，喜帖西驰沸路尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27442,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和蔺仰之咏含笑花","author":"廖行之","text":"何物包藏欲媚谁，千金难售惜光仪。\n空凝巧倩如羞靥，晴吐浓薰已透肌。\n一夕举烽徒自苦，三年射雉若为奇。\n无情草木欣欣意，却恼多情为赋诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27443,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和四十五叔庆谦子过省二首 其二","author":"廖行之","text":"长笑痴儿恋戏衫，拖泥带水漫卑凡。\n何如一动君王听，不入徒劳簿尉衔。\n细水循除空㶁㶁，泰山终古镇岩岩。\n可怜司马身华宠，晚作谀书拟奏函。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27444,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和四十五叔庆谦子过省二首 其一","author":"廖行之","text":"行年五十尚青衫，耿耿胸中负不凡。\n那意宁馨联桂籍，祇知清白映冰衔。\n平生济叔耽周易，何日商宗起傅岩。\n好上公车治安策，绿缇飞诏下方函。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27445,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和石鼓宴士二首 其二","author":"廖行之","text":"江头秀木碧参空，喜见新晴到眼中。\n秩秩北林筵有序，潭潭东阁礼尤崇。\n广平元老今贤杰，江左夷吾正祖风。\n况复赣君崇教养，清阴到处绿成丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27446,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和石鼓宴士二首 其一","author":"廖行之","text":"几年蓬藋翳儒宫，文物新还俎豆中。\n幸甚诸生初见武，欢然置酒更亲崇。\n晴收楚峤千峰雨，薰奏虞弦万籁风。\n须信廉平汉循吏，可能齐鲁化蚕丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27447,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和芍药","author":"廖行之","text":"牡丹摧尽蕊初成，花谱还应压后生。\n右掖昔年陪俊赏，幽兰今日助诗情。\n当阶镇日翻红艳，傍砌何人玩秀英。\n国色要须归第一，花王从此浪收名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27448,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和张王臣","author":"廖行之","text":"词伯今犹从事衫，追风才轶谢羸骖。\n浪传齐己声江左，不见弥明隐岳南。\n骚读正堪供痛饮，篪音那许接高谈。\n君家况有輶轩法，乞与新编得细参。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27449,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和张王臣郊游韵三首 其三","author":"廖行之","text":"秀句清圆掩百家，锦心幽思定餐霞。\n风骚谁敢窥严律，诵数惟应满洛叉。\n已有文名肩杜曲，却怜羁旅赋彭衙。\n自嗟下里陪高唱，羞说花时鼓子花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27450,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和张王臣郊游韵三首 其二","author":"廖行之","text":"山头笑语落千家，晓入登临引暮霞。\n极目未应烦笏拄，招朋端不羡鱼叉。\n归来皓月明于烛，睡熟黄紬卧放衙。\n幕府官闲诗思敏，赓酬亹亹笔生花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27451,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和张王臣郊游韵三首 其一","author":"廖行之","text":"君访西郊古佛家，还因烧佛问丹霞。\n可能同住依弥勒，应是前身悟木叉。\n林杪危亭供宴坐，门前翠袖俨排衙。\n纷纷廛市何时了，静看优昙浩劫花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27452,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和张王臣登清斯亭韵三首 其三","author":"廖行之","text":"海棠冬暖亦狂花，步绕畦区羡物华。\n微雨苍茫低塞雁，寒声寂历到汀葭。\n映人清绝梅松竹，照眼黄垂橘柚楂。\n自喜闲中足幽兴，不妨时理醉生涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27453,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和张王臣登清斯亭韵三首 其二","author":"廖行之","text":"一夜寒窗剪烛花，细寻诗派忆京华。\n爱人欲赠两溪竹，吊古谁荒大泽葭。\n味永黄鸡羹苦菜，香清沈水煮榠楂。\n拈来信手皆佳句，浩叹东洋渺际涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27454,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和张王臣登清斯亭韵三首 其一","author":"廖行之","text":"一年好景负黄花，洗眼江梅傲岁华。\n把酒欲从天问月，知时谁解管飞葭。\n人情似水多泾渭，世味如禅说蜜楂。\n祇可高吟酬节物，莺声早晚又天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27455,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和杨公维二首 其二","author":"廖行之","text":"杨侯胸中万卷书，澜翻骚兴轧三闾。\n文成素藁富柱腹，词有馀锋须贾予。\n俊逸进追新轨辙，温纯端拟古璠玙。\n我渐不作池塘梦，徒羡清沟愧浊渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27456,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]