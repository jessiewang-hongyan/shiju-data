[{"title":"与致明对榻","author":"刘子翚","text":"胜会尝连榻，还欣与子同。\n一灯寒夜永，残梦雨声中。\n道旧惊身老，谈玄了性空。\n卜邻今有约，泉石兴何穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28059,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"子静阅仆旧举子文有诗因次原韵","author":"刘子翚","text":"雪縠乌纱气似云，摇毫不瞬已成文。\n儿时追逐无三捷，老去荒唐更十分。\n木里液樠将底用，韶边朋肯岂堪闻。\n却惭锓板能流恶，一付焚如政赖君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28060,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山寺见牡丹","author":"刘子翚","text":"倦游曾向洛阳城，几见芳菲照眼新。\n载酒屡穿卿相圃，傍花时值绮罗人。\n十年客路惊华发，回首中原隔战尘。\n今日寻芳意萧索，山房数朵弄残春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28061,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山源","author":"刘子翚","text":"汩汩山源水，分流去若驰。\n有声知尚浅，得势转徂卑。\n苇棘连荒浦，鱼虾聚小泜。\n起予湖海兴，惆怅念前期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28062,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书事","author":"刘子翚","text":"三年玉帛走稽山，万骑凌江稍北还。\n绝塞风烟连魏阙，千官戎服立朝班。\n皇图凤历讴歌里，紫色蛙声倔强间。\n露布更传原上捷，王师早晚下潼关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28063,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"井泉","author":"刘子翚","text":"石井水溅溅，寒莎映碧藓。\n雨声添溜急，天影入波圆。\n晓汲连山寺，春耕润野田。\n杖藜三咽罢，毛发更萧然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28064,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"劝六四叔卜居","author":"刘子翚","text":"便合诛茅隐旧陂，乱来吾里独熙熙。\n年丰禾黍侵山上，地僻杉松傍涧攲。\n涉世有求俱瓮算，归田得计莫狐疑。\n竹林杖屦从兹始，二阮风流傥可追。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28065,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"双庙","author":"刘子翚","text":"无复连云战鼓悲，英风凛凛在双祠。\n气吞骄虏方张日，恨满孤城欲破时。\n幽鸟自啼檐际树，夕阳空照路傍碑。\n平生不作脂韦意，倚棹哀吟两鬓丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28066,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"无诸策题问颜亡绝好轲没无传","author":"刘子翚","text":"孔林黄玉化飞埃，一派渊源有自来。\n具体好时心似谷，厉辞传处口如雷。\n闻声尽是缁帷客，见色无非古市槐。\n却讶文公迷圣户，不知灵钥有人开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28067,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"长句寄尚明学士","author":"刘子翚","text":"短褐沉潜不近名，只今长乐郑康成。\n酒中贤圣无多酌，琴里宫商一再行。\n翰墨放怀新水石，烽烟回首旧蓬瀛。\n四愁不为思君作，怀抱何因得暂平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28068,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出郊","author":"刘子翚","text":"路转囊山北，扶舆忆旧过。\n乾坤征战久，游宦别离多。\n瘴树馀红叶，春江又绿波。\n平生豪横气，未老半消磨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28069,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"北风","author":"刘子翚","text":"雁起平沙晚角哀，北风回首恨难裁。\n淮山已隔胡尘断，汴水犹穿故苑来。\n紫色蛙声真倔强，翠华龙衮暂徘徊。\n庙堂此日无遗策，可是忧时独草莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28070,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"古松","author":"刘子翚","text":"手植知何代，枞枞万盖齐。\n韵清琴易写，干直鸟难栖。\n惨淡连云坞，鬅鬙荫石溪。\n刳明虽小用，曾照路人迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28071,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"叶集之举士特唱和因次韵","author":"刘子翚","text":"漂泊分携后，艰难会面时。\n夜灯初献酒，春草旧题诗。\n游宦君虽厌，才名众所期。\n不应如倦翼，寂寞恋南枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28072,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"龙眼","author":"刘子翚","text":"幽株旁挺绿婆娑，啄咂虽微奈美何。\n香剖蜜脾知韵胜，价轻鱼目为生多。\n左思赋咏名初出，玉局揄扬论岂颇。\n地极海南秋更暑，登盘犹足洗沈痾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28073,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"会兵","author":"刘子翚","text":"羽檄西来趣会兵，秋风胡虏更纵横。\n烽明石岭塞垣迥，马渡分河波浪生。\n使者谩传苏武节，君王频幸亚夫营。\n百年信誓明如日，何事纷纷起战争。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28074,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"会蔡子思张叔献二教授","author":"刘子翚","text":"胶庠夙昔记追随，物变时移万事非。\n晓阙风烟胡骑满，夜窗灯火故人稀。\n中郎秉德无瑕颣，平子谈经有旨归。\n独我衰迟愧朋友，蹉跎已觉壮心违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28075,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"刘处士坟山礼亭","author":"刘子翚","text":"风马云车怅莫寻，祠亭空锁古原阴。\n豆觞三献礼经事，霜露四时人子心。\n世尽浮云同渺渺，名高拱木共森森。\n平生积善身徒老，赖有家儿敌万金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28076,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同张守谒蔡子强观砚论琴偶书","author":"刘子翚","text":"共造中郎室，明窗玩好奇。\n砚珍镌子石，琴古斲孙枝。\n篆鼎飘香远，茶瓯转味迟。\n自惭尘土累，清话得移时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28077,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同李汉老登高斋","author":"刘子翚","text":"飞梯百级转层峦，政喜登临著眼宽。\n海上波涛连阆苑，日边尘土暗长安。\n乱来世事终无定，春尽羁愁岂一端。\n赖有谪仙能喜客，时陪杖屦得雄观。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28078,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同詹明诚傅茂元游晞真馆有诗因次其韵","author":"刘子翚","text":"橘柚垂红古观秋，归途邂逅得寻幽。\n晴沙散策随山远，夜月回船信水流。\n胜处无诗端可恨，它时有酒更来游。\n相陪二妙平生友，老矣襟期共一丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28079,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吕丞相挽诗二首 其二","author":"刘子翚","text":"慎□重调鼎，宣威屡干方。\n夷吾欣在晋，尚父果兴唐。\n剑佩凌烟阁，笙歌逸老堂。\n犹闻病乘驲，遗恨隔清光。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28080,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吕丞相挽诗二首 其一","author":"刘子翚","text":"黄发三朝老，勤劳险阻中。\n十年流马策，一日断鳌功。\n汛扫乾坤静，扶持庙社隆。\n璜溪今寂寞，彷佛见英风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28081,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吕尚书挽诗二首 其二","author":"刘子翚","text":"国步多艰棘，忠诚誓翼扶。\n据鞍方矍铄，骂贼已含糊。\n义在光惇史，人亡失壮图。\n因公感家世，愤气欲吞胡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28082,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吕尚书挽诗二首 其一","author":"刘子翚","text":"昔在贤关日，雄飞接俊髦。\n家因登第起，名为谏君高。\n荷橐论思旧，牙旗出入劳。\n伤心淝水变，遗恨激秋涛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28083,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吕居仁挽词三首 其三","author":"刘子翚","text":"江左欣初见，倾输便豁然。\n挽留尝一粥，契阔已三年。\n老去无新得，书来每自鞭。\n幽明虽永绝，凛若在吾前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28084,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吕居仁挽词三首 其二","author":"刘子翚","text":"皓首犹贪学，谦虚德益丰。\n潜神无朕际，悟物不言中。\n虽处持荷贵，常安捽茹穷。\n笑谈惊委蜕，儒事有英雄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28085,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吕居仁挽词三首 其一","author":"刘子翚","text":"粹美元功畀，风流相国传。\n有文光圣道，无物累心渊。\n侃侃常春气，堂堂忽逝川。\n东莱一点秀，冥漠楚山边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28086,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"曲倚","author":"刘子翚","text":"器成因揉木，偃月势相侔。\n适用形虽巧，论材性本柔。\n倦凭观秘箓，趺坐接禅流。\n莫效愚溪戮，时多曲似钩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28087,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"有酒","author":"刘子翚","text":"谁家好事许相过，有酒何妨醉面酡。\n兄弟偶同词馆逸，林泉偏傍故园多。\n晨钟屡趁伊蒲饭，晚艇时听欸乃歌。\n莫遣是非来到耳，只应憨睡奈閒何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28088,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"有感三首 其三","author":"刘子翚","text":"孝感柔强敌，和盟定一朝。\n龙輴来瀚海，鹤驾返神霄。\n歌吹仍祠禹，羹墙若见尧。\n稽山同峻极，从此百神朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28089,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"有感三首 其二","author":"刘子翚","text":"运属宣和末，干戈变故仍。\n倦勤修内禅，流泽启中兴。\n雎水千麾集，胡沙八骏腾。\n尺书传讳日，寰宇泪如渑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28090,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"有感三首 其一","author":"刘子翚","text":"八叶炎图茂，千龄圣主昌。\n农桑开汉域，礼乐焕周庠。\n晏粲三登乐，讴吟七闰长。\n徽名辞镂玉，盛举冠前王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28091,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次六四叔青字韵","author":"刘子翚","text":"写出吴中胜，平生历历经。\n露窥烟渚静，山入柁楼青。\n老气何由逸，奔晖不肯停。\n北潭摇梦否，渌面照轩棂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28092,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次六四叔韵","author":"刘子翚","text":"笋舆沾汗每苍黄，今日追随得快凉。\n水落不知沙径改，风微如靳橘林香。\n我缘新病仍添懒，君不时来有底忙。\n只恐家山诮人去，十年秋兴在殊方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28093,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次张守韵四首 其四","author":"刘子翚","text":"泣怀三献玉，廉拒四知金。\n势利焚和猛，诗书汲古深。\n贵无长得意，闲有自由心。\n岣嵝丹砂在，盟寒傥可寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28094,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次张守韵四首 其三","author":"刘子翚","text":"瓦白霜封缟，波清月漾金。\n柝沈秋垒静，人语夜堂深。\n故国归何日，寒衾事满心。\n庭松怜手植，擢干已弥寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28095,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次张守韵四首 其二","author":"刘子翚","text":"促席山堂夜，寒灯吐碎金。\n酒分邻瓮美，栗爆地炉深。\n疏懒难堪事，纷华易坏心。\n自怜贪寸禄，双鬓老侵寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28096,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次张守韵四首 其一","author":"刘子翚","text":"久分闽郡竹，屡赐汉庭金。\n才刃硎新发，恩波海并深。\n寇销乘间祸，民有不欺心。\n祇恐锋车起，云霄路莫寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28097,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次居仁韵","author":"刘子翚","text":"是身如树槁穷冬，一点心华自闭封。\n久矣吹嘘存泛爱，偶于迟暮得相从。\n颇闻妙用纵横是，深愧真源左右逢。\n白雪黄芽计虽下，可能无意起龙钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28098,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次明仲勤字韵","author":"刘子翚","text":"苦无聊赖忆披云，曳杖宁知四体勤。\n握手便成忘适适，纵谈终愧自闻闻。\n浮蛆酿熟贻彭泽，斫鲙图成想右军。\n莫为冷风发归兴，石峰秋月许平分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28099,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次翁来借诸家易解闻已有新说以诗借观","author":"刘子翚","text":"天庭吐气作青红，警逻犹烦小试中。\n政使著鞭无暇日，惟应读易有清风。\n昼评一卦纷然异，夜梦三爻廓尔通。\n闻说新笺极玄妙，可无残剩到衰翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28100,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次彭资深韵","author":"刘子翚","text":"林下相从多胜友，谁如吾子妙才华。\n曳裾所至成师席，射策由来有世家。\n意气胸中千里骏，文词笔下九光霞。\n邮亭一见倾怀抱，投分金兰不足誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28101,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵上梅岭","author":"刘子翚","text":"鞭粳红入臼，剪菜玉登盘。\n是处喜相挽，我来如许难。\n沙清才㶁㶁，陟翠入磻磻。\n勃窣乾坤里，伊谁不自安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28102,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵士特赠别","author":"刘子翚","text":"客舍愁分袂，梅花小雪前。\n夜看牛渚月，春别剡溪船。\n丽句光行色，悲歌惨别筵。\n后期相约处，双阙五云天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28103,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵六四叔兰诗","author":"刘子翚","text":"疏疏绿发覆清浔，漠漠微香起夕阴。\n无复风流追九畹，空馀烟雨暗深林。\n谁分秀色来幽室，独写遗声入素琴。\n还似高人远尘俗，争辉玉树亦何心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28104,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵文殊五言","author":"刘子翚","text":"小雨贻新句，端如印印泥。\n凝眸方过鸟，倚杖忽横溪。\n老态犹堪强，真豪已觉低。\n钟声隔林寺，惭愧有幽栖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28105,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵方学士万卷楼","author":"刘子翚","text":"渊然推量德为循，酷爱收书定可人。\n刘向讨论称好古，退之学问美藏身。\n箕裘有子能传业，俎豆于今叹不辰。\n我亦平生讥传癖，可怜朱墨费精神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28106,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵长汀壁间韵","author":"刘子翚","text":"窜鼠惊残梦，萧萧老屋虚。\n风声传远濑，寒意入秋蔬。\n客路漂摇久，归身憔悴馀。\n西窗满残照，彷佛似吾庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28107,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵卢赞元喜雪","author":"刘子翚","text":"六花初逐晓风繁，五裤那忧岁晚寒。\n杖屦客迷村径远，笙歌人在小楼看。\n也知近郭梅将动，只恐行春路未乾。\n授简梁园休惜醉，银台列烛妓围宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28108,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵白水雪梅二诗 其二","author":"刘子翚","text":"豪气无根老自摧，尚留馀习爱寻梅。\n苦寒扶病也须去，薄暮微吟垂欲开。\n静纳长芬风外坞，醉临高白水边台。\n无言自得幽贞意，莫吐肝肠锦绣才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28109,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵白水雪梅二诗 其一","author":"刘子翚","text":"闽雪少曾栖瓦白，怪来浩浩拥寒滨。\n严威故作敝裘厄，淡彩潜催幽幌晨。\n眼观醉中迷有色，心华净处照无垠。\n摇松旋拾晶荧煮，已觉肥生齿颊津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28110,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵刘宪诗二首 其二","author":"刘子翚","text":"已筑高城受虏降，盟言端的有如江。\n翠华回跸清驰道，绣指观风绝犬庞。\n凯奏花卿初卷甲，诗成草圣屡题窗。\n还朝有策裨聪听，纳谏那忧以杖撞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28111,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵刘宪诗二首 其一","author":"刘子翚","text":"吾宗三凤久心降，一见端如渴饮江。\n好客襟怀直绝倒，封侯骨相自耆庞。\n知名夙昔惭惊座，袖手雍容笑斲窗。\n岂谓诗盟容我辈，哑钟无韵若为撞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28112,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵吴教授题子应山斋","author":"刘子翚","text":"芒鞋竹杖日随身，所向逍遥乐任真。\n强健挂冠非矫俗，荣华得路转迷人。\n爱山兀兀常心醉，与世悠悠只貌亲。\n最晚论交欣得子，一樽犹足慰漂沦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28113,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵张守立春","author":"刘子翚","text":"把酒酬佳节，遨头乐未央。\n池冰犹涩舫，岸柳已笼墙。\n晓院帘帏卷，春盘饼饵香。\n慇勤分彩胜，为掩鬓边霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28114,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵张守同往华严","author":"刘子翚","text":"浅水荷花开傍桥，晚钟楼殿碧山椒。\n林松绕路行不彻，野鸟避人飞更遥。\n喜有高情共丘壑，应须长啸混渔樵。\n老僧好事能延客，未觉山房苦寂寥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28115,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵张守述怀","author":"刘子翚","text":"避地漂流更海隅，一身难料岂知馀。\n晚楼独上非吾里，几日西来绝羽书。\n虏未息兵由运数，力难康世昧孤虚。\n郡侯恺悌忧民切，鲁史无因讽失鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28116,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵张守秋怀四首 其四","author":"刘子翚","text":"岁事何仓卒，微吟寄客情。\n野耕方刈熟，邻酿已沽清。\n归雁年年急，寒烽处处明。\n予衰倦流转，梦想玉阶平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28117,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵张守秋怀四首 其三","author":"刘子翚","text":"失计萦尘网，栖栖厌不情。\n兴随凫舄远，官比绮曹清。\n大案韦编古，深房纸瓦明。\n圣贤聊晤对，事业只平平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28118,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵张守秋怀四首 其二","author":"刘子翚","text":"徙倚山堂晚，悲秋万古情。\n雨蔬犹擢秀，风沼自扬清。\n野迥归牛小，沙寒白鸟明。\n凄凄枫柳树，汝意亦难平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28119,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵张守秋怀四首 其一","author":"刘子翚","text":"杖藜乘兴出，佳处每关情。\n白石溪流浅，黄花篱落清。\n林烟经雨薄，野日傍山明。\n赖有杯中物，愁怀得暂平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28120,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵张守壶山诗","author":"刘子翚","text":"松根系马望巑岏，乘兴攀跻不作难。\n日出渐看林雾散，潮来先觉海风寒。\n遥连钓石多红树，半出僧垣尽绿竿。\n不见双旌来视稼，忆君对酒岂能欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28121,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵张守梅诗","author":"刘子翚","text":"破雪梅初动，南枝更北枝。\n傍墙应折尽，背日较开迟。\n晓角惊残梦，春愁占两眉。\n狂风将落蕊，故入画楼吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28122,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵张守梅诗","author":"刘子翚","text":"草棘萧萧野岸隈，暗香消息已传梅。\n雪欺篱落遥难认，暖入枝条并欲开。\n愁向天涯今度见，老随春色暗中来。\n似闻诗社多何逊，盍试招邀共一杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28123,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵张守酴醾二首 其二","author":"刘子翚","text":"退食黄堂喜自公，不妨幽兴嘱芳丛。\n双旌不出閒春昼，大笔微吟缀祖风。\n老矣交朋今日少，飘然游宦异乡同。\n杖藜约我过南浦，贤圣时时为一中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28124,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]