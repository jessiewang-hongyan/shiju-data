[{"title":"南乡子 其一","author":"蔡伸","text":"天外雨初收。\n风紧云轻已变秋。\n邂逅故人同一笑，迟留。\n聚散人生宜自谋。\n去路指南州。\n万顷云涛一叶舟。\n莫话太湖波浪险，归休。\n人在溪边正倚楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28044,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南乡子 其二","author":"蔡伸","text":"木落雁南翔。\n锦鲤殷勤为渡江。\n泪墨银钩相忆字，成行。\n滴损云笺小凤皇。\n陈事费思量。\n回首烟波卷夕阳。\n尽道凭书聊破恨，难忘。\n及至书来更断肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28045,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南歌子 其二","author":"蔡伸","text":"远水澄明绿，孤云黯淡愁。\n白蘋红蓼满汀洲。\n肠断圆蟾空照、木兰舟。\n节物伤羁旅，归程叹滞留。\n佳期已误小红楼。\n赖得今年犹有、闰中秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28046,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南歌子 其一","author":"蔡伸","text":"萧寺疏钟断，虚堂夜气清。\n凉蟾偏向小窗明。\n露井碧梧寒叶、颤秋声。\n幽恨人谁问，孤衾泪独横。\n此时风月此时情。\n拟倩蓝桥归梦、见云英。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28047,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南歌子 其三","author":"蔡伸","text":"恨入眉峰翠，寒生酒晕红。\n临期凝泪洒西风。\n须信世间无物、似情浓。\n玉蹬敲霜月，金钲伴晓钟。\n凄凉古驿乱山重。\n今夜拥衾无寐、与君同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28048,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春光好","author":"蔡伸","text":"鸾屏掩，翠衾香。\n小兰房。\n回首当时云雨梦，两难忘。\n如今水远山长。\n凭鳞翼、难叙衷肠。\n况是教人无可恨，一味思量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28049,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"昭君怨","author":"蔡伸","text":"一曲云和松响。\n多少离愁心上。\n寂寞掩屏帷。\n泪沾衣。\n最是销魂处。\n夜夜绮窗风雨。\n风雨伴愁眠。\n夜如年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28050,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"柳梢青 其三","author":"蔡伸","text":"联璧寻春，踏青尚忆，年时携手。\n此际重来，可怜还是，年时时候。\n阴阴柳下人家，人面桃花似旧。\n但愿年年，春风有信，人心长久。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28051,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"柳梢青 其一","author":"蔡伸","text":"数声鶗鴂。\n可怜又是，春归时节。\n满院东风，海棠铺绣，梨花飘雪。\n丁香露泣残枝，算未比、愁肠寸结。\n自是休文，多情多感，不干风月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28052,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"柳梢青 其二","author":"蔡伸","text":"子规啼月。\n幽衾梦断，销魂时节。\n枕上斑斑，枝头点点，染成清血。\n凄凉断雨残云，算此恨、文君更切。\n老去情怀，春来况味，那禁离别。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28053,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"洞仙歌","author":"蔡伸","text":"莺莺燕燕。\n本是于飞伴。\n风月佳时阻幽愿。\n但人心坚固后，天也怜人，相逢处、依旧桃花人面。\n绿窗携手，帘幕重重，烛影摇红夜将半。\n对尊前如梦，欲语魂惊，语未竟、已觉衣襟泪满。\n我只为、相思特特来，这度更休推，后回相见。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28054,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"点绛唇 其九","author":"蔡伸","text":"绿萼冰花，数枝清影横疏牖。\n玉肌清瘦。\n夜久轻寒透。\n忍使孤芳，攀折他人手。\n人归后。\n断肠回首。\n只有香盈袖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28055,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"点绛唇 其一 送常守陈正同应之还朝","author":"蔡伸","text":"解绂朝天，满城桃李繁阴布。\n彩舟难驻。\n忍听骊歌举。\n协赞中兴，圣意方倾注。\n从今去。\n五云深处。\n稳步沙堤路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28056,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"点绛唇 其四","author":"蔡伸","text":"月缺花残，世间乐事难双美。\n夜来相对。\n把酒弹清泪。\n一点情钟，销尽英雄气。\n樊笼外。\n五湖烟水。\n好作扁舟计。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28057,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"点绛唇 其十一","author":"蔡伸","text":"云雨匆匆，洞房当日曾相遇。\n暂来还去。\n无计留春住。\n宝瑟重调，静听鸾弦语。\n休轻负。\n绮窗朱户。\n好做风光主。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28058,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"点绛唇 其二 和安行老韵","author":"蔡伸","text":"香雪飘零，暖风著柳笼丝雨。\n恼人情绪。\n春事还如许。\n宝勒朱轮，共结寻芳侣。\n东郊路。\n乱红深处。\n醉拍黄金缕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28059,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"点绛唇 其七 丙寅","author":"蔡伸","text":"梅雨初晴，画栏开遍忘忧草。\n兰堂清窈。\n高柳新蝉噪。\n枕上芙蓉，如梦还惊觉。\n匀妆了。\n背人微笑。\n风入玲珑罩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28060,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"点绛唇 其八","author":"蔡伸","text":"帐外华灯，翠屏花影参差满。\n锦衣香暖。\n苦恨春宵短。\n画角声中，云雨还轻散。\n河桥畔。\n月华如练。\n回首成肠断。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28061,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"点绛唇 其三","author":"蔡伸","text":"背壁灯残，卧听檐雨难成寐。\n井梧飘坠。\n历历蛩声细。\n数尽更筹。\n滴尽罗巾泪。\n如何睡。\n甫能得睡。\n梦到相思地。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28062,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"点绛唇 其一 登历阳连云观","author":"蔡伸","text":"水绕孤城，乱山深锁横江路。\n帆归别浦。\n苒苒兰皋暮。\n人在天涯，雁背南云去。\n空凝伫。\n凤楼何处。\n烟霭迷津渡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28063,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"点绛唇 其六","author":"蔡伸","text":"人面桃花，去年今日津亭见。\n瑶琴锦荐。\n一弄清商怨。\n今日重来，不见如花面。\n空肠断。\n乱红千片。\n流水天涯远。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28064,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"点绛唇 其五","author":"蔡伸","text":"玉笋持杯，敛红颦翠歌金缕。\n彩鸳戢羽。\n未免群鸡妒。\n我为情多，愁听多情语。\n君休诉。\n两心坚固。\n云里千条路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28065,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"看花回 和赵智夫韵","author":"蔡伸","text":"夜久凉生，庭院漏声频促。\n念昔胜游旧地，对画阁层峦，雨馀烟簇。\n新诗暗藏小字，霜刀刊翠竹。\n携素手、细绕回塘，芰荷香里彩鸳宿。\n别后想、香销腻玉。\n带围减、钏宽金粟。\n虽有鳞鸿锦素，奈事与心违，佳期难卜。\n拟解愁肠万结，唯凭尊酒绿。\n望天涯断魂处，醉拍阑干曲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28066,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浣溪沙 其五 昆山月华阁","author":"蔡伸","text":"沙上寒鸥接翼飞。\n潮生潮落水东西。\n征船鸣橹趁潮归。\n望断碧云无锦字，谩题红叶有新诗。\n黄昏微雨倚阑时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28067,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浣溪沙 其十二","author":"蔡伸","text":"浅褐衫儿寿带藤。\n碾花如意枕冠轻。\n凤鞋弓小称娉婷。\n约略梳妆随事好，出尘标韵出尘清。\n一枝梅映玉壶冰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28068,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浣溪沙 其九","author":"蔡伸","text":"且斗尊前见在身。\n昔游如梦可销魂。\n玉容依约旧精神。\n千里重来人事改，一杯相属意还新。\n韶华不减洞中春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28069,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浣溪沙 仙潭二首 其三","author":"蔡伸","text":"苹末风轻入夜凉。\n飞桥画阁跨方塘。\n月移花影上回廊。\n粲枕随钗云鬓乱，红绵扑粉玉肌香。\n起来携手看鸳鸯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28070,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浣溪沙 赋向伯恭芗林木犀二首 其一","author":"蔡伸","text":"木似文犀感月华。\n寸根移种自仙家。\n春兰秋菊浪矜夸。\n玉露初零秋夜永，幽香直入小窗纱。\n此时风月独输他。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28071,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浣溪沙 其十一","author":"蔡伸","text":"叶剪玻璃蕊糁金。\n清香端不数琼沈。\n独将高韵冠芗林。\n千里江山新梦后，一天风露小庭深。\n主人归兴已骎骎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28072,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浣溪沙 其七","author":"蔡伸","text":"紫燕双双掠水飞。\n廉纤小雨未成泥。\n篱边开尽野蔷薇。\n会少离多终有恨，暂来还去益堪悲。\n后期重约采莲时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28073,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浣溪沙 其二","author":"蔡伸","text":"玉趾弯弯一折弓。\n秋波剪碧滟双瞳。\n浅颦轻笑意无穷。\n夜静拥炉熏督耨，月明飞棹采芙蓉。\n别来欢事少人同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28074,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浣溪沙 其六","author":"蔡伸","text":"漠漠新田绿未齐。\n柳阴阴下水平堤。\n竹间时有乳鸦啼。\n云敛屏山横枕畔，夜阑璧月转林西。\n玉芝香里彩鸳栖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28075,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浣溪沙 其八","author":"蔡伸","text":"窄窄霜绡稳称身。\n强临歌酒惨离魂。\n故人相遇益伤神。\n断雨残云千里隔，琼枝璧月四时新。\n为君留取镜中春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28076,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浣溪沙 其四","author":"蔡伸","text":"窗外疏篁对节金。\n画桥新绿一篙深。\n沈沈清夜对横参。\n酒晕半消红玉脸，云鬟轻制小犀簪。\n梦回陈迹杳难寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28077,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浣溪沙 其十三","author":"蔡伸","text":"窗外桃花烂熳开。\n年时曾伴玉人来。\n一枝斜插凤皇钗。\n今日重来人事改，花前无语独徘徊。\n凄凉怀抱可怜哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28078,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浣溪沙 其一 壬寅五月西湖","author":"蔡伸","text":"双佩雷文拂手香。\n青纱衫子淡梳妆。\n冰姿绰约自生凉。\n虚掉玉钗惊翡翠，缓移兰棹趁鸳鸯。\n鬓鬟风乱绿云长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28079,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浪淘沙令","author":"蔡伸","text":"楼下水潺湲。\n楼外屏山。\n淡烟笼月晚凉天。\n曾共玉人携素手，同倚阑干。\n云散梦难圆。\n幽恨绵绵。\n旧游重到忍重看。\n负你一生多少泪，月下花前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28080,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"减字木兰花 其五","author":"蔡伸","text":"锦屏人醉。\n玉暖香融春有味。\n今日兰舟。\n魂梦还随绿水流。\n高城望断。\n无奈城中人不见。\n斜倚妆楼。\n恨入眉峰两点愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28081,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"减字木兰花 其二","author":"蔡伸","text":"船回沙尾。\n几误红窗听鹊喜。\n尺素空传。\n转首相逢又隔年。\n寒灯独守。\n玉笋持杯宁复有。\n秀水南州。\n徒使幽人作梦游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28082,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"减字木兰花 癸亥元日，秀守刘卿任有词。时余适至秀，因用其韵二首，时初用乐 其一","author":"蔡伸","text":"彤庭龙尾。\n礼备天颜知有喜。\n九奏初传。\n耳冷人间十七年。\n盈成持守。\n仁德如春渐九有。\n三辅名州。\n好整笙歌结胜游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28083,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"婆罗门引 再游仙潭薛氏园亭","author":"蔡伸","text":"素秋向晚，岁华分付木芙蓉。\n萧萧红蓼西风。\n记得当时撷翠，拥手绕芳丛。\n念吹箫人去，明月楼空。\n遥山万重。\n望寸碧、想眉峰。\n翠钿琼珰谩好，谁适为容。\n凄凉怀抱，算此际、唯我与君同。\n凝泪际、目送征鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28084,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"惜奴娇","author":"蔡伸","text":"隔阔多时，算彼此、难存济。\n咫尺地、千山万水。\n眼眼相看，要说话、都无计。\n只是。\n唱曲儿、词中认意。\n雪意垂垂，更刮地、寒风起。\n怎禁这几夜意。\n未散痴心，便指望、长偎倚。\n只替。\n那火桶儿、与奴暖被。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28085,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"望江南 感事","author":"蔡伸","text":"花落尽，寂寞委残红。\n蝶帐梦回空晓月，凤楼人去谩东风。\n春事已成空。\n闲伫立，□□水溶溶。\n云锁乱山横惨淡，烟笼绿树晚溟濛。\n却在泪痕中。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28086,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清平乐 其三","author":"蔡伸","text":"明眸秀色。\n肌理凝香雪。\n罗绮丛中标韵别。\n捧酒歌声清越。\n不辞醉脸潮红。\n却愁归骑匆匆。\n回首绿窗朱户，断肠明月清风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28087,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清平乐 其二","author":"蔡伸","text":"南窗月满。\n绣被堆香暖。\n苦恨春宵更漏短。\n应讶郎归又晚。\n征帆初落桥边。\n迎门一笑嫣然。\n今夜流霞共酌，何妨金盏垂莲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28088,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清平乐 其一","author":"蔡伸","text":"彩舟双橹。\n六月临平路。\n小雨轻风消晚暑。\n绕岸荷花无数。\n玉人璨枕方床。\n遥知待月西厢。\n昨夜有情风月，今宵特地凄凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28089,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渔家傲","author":"蔡伸","text":"烟锁池塘秋欲暮。\n细细前香，直到双栖处。\n并枕东窗听夜雨。\n偎金缕。\n云深不见来时路。\n晓色朦胧人去住。\n香覆重帘，密密闻私语。\n目断征帆归别浦。\n空凝伫。\n苔痕绿印金莲步。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28090,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮 其十一","author":"蔡伸","text":"花冠鼓翼东方动。\n兰闺惊破辽阳梦。\n翠被小屏山。\n晓窗灯影残。\n并头双燕语。\n似诉横塘雨。\n风雨晓寒多。\n征人可奈何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28091,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮 其二","author":"蔡伸","text":"杏花零落清明雨。\n卷帘双燕来还去。\n枕上玉芙蓉。\n暖香堆锦红。\n翠翘金钿雀。\n蝉鬓慵梳掠。\n心事一春闲。\n黛眉颦远山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28092,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮 其一 沐发","author":"蔡伸","text":"鸳鸯枕上云堆绿。\n兰膏微润知新沐。\n开帐对华灯。\n见郎双眼明。\n锦衾香馥郁。\n槛竹敲寒玉。\n何物最无情。\n晓鸡咿喔声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28093,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮 其七","author":"蔡伸","text":"金铺半掩银蟾满。\n个人应恨归来晚。\n轧轧橹声迟。\n那知心已飞。\n迎门一笑粲。\n娇困横波慢。\n偎倚绿窗前。\n今宵人月圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28094,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮 其四 广陵盛事","author":"蔡伸","text":"水光山影浮空碧。\n柳丝摇曳春无力。\n柳岸系行舟。\n吹箫忆旧游。\n旧游堪更忆。\n望断迷南北。\n千古恨悠悠。\n长江空自流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28095,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮 其一","author":"蔡伸","text":"凝羞隔水抛红豆。\n嫩桃如脸腰如柳。\n心事暗相期。\n阳台云雨迷。\n玉楼花似雪。\n花上朦胧月。\n挥泪执柔荑。\n匆匆话别时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28096,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮 其三","author":"蔡伸","text":"飞英不向枝头住。\n等闲又送春归去。\n云幄翠阴浮。\n长随日脚流。\n玉箫吹凤怨。\n惊起楼中燕。\n飞去自双双。\n恼人空断肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28097,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮 其五","author":"蔡伸","text":"当时携手今千里。\n可堪重到相逢地。\n触目尽关心。\n流莺尚好音。\n无人知我意。\n只有涓涓泪。\n寂寞到斜阳。\n罗衣裛旧香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28098,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮 其八","author":"蔡伸","text":"双双紫燕来华屋。\n雨馀芳草池塘绿。\n一夜摆花风。\n莺花满树红。\n杯深君莫诉。\n醉袖歌金缕。\n无奈惜花心。\n老来情转深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28099,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮 其六","author":"蔡伸","text":"鸣笳叠鼓催双桨。\n扁舟稳泛桃花浪。\n别泪洒东风。\n前欢如梦中。\n梦魂无定据。\n不到相逢处。\n纵使梦相逢。\n香闺岂解同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28100,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮 其九","author":"蔡伸","text":"朝来一阵狂风雨。\n春光已作堂堂去。\n茂绿满繁枝。\n青梅结子时。\n攀枝惊晼晚。\n乐事孤心眼。\n正是惜春归。\n那堪怨别离。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28101,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谒金门 其一","author":"蔡伸","text":"溪声咽。\n溪上有人离别。\n别语叮咛和泪说。\n罗巾沾泪血。\n尽做刚肠如铁。\n到此也应愁绝。\n回首断山帆影灭。\n画船空载月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28102,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谒金门 其二","author":"蔡伸","text":"相思切。\n触目只供愁绝。\n好梦惊回清漏咽。\n烛残香穗结。\n长恨南楼明月。\n只解照人离缺。\n同倚朱栏飞大白。\n今宵风月别。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28103,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"喜迁莺","author":"蔡伸","text":"青娥呈瑞。\n正惨惨暮寒，同云千里。\n剪水飞花，渐渐瑶英，密洒翠筠声细。\n邃馆静深，金铺半掩，重帘垂地。\n明窗外。\n伴疏梅潇洒，玉肌香腻。\n幽人当此际。\n醒魂照影，永漏愁无寐。\n强拊清尊，慵添宝鸭，谁会黯然情味。\n幸有赏心人，奈咫尺、重门深闭。\n今夜里。\n算忍教孤负，浓香鸳被。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28104,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"御街行","author":"蔡伸","text":"东君不锁寻芳路。\n曾是莺花主。\n有情风月可怜宵，犹记绿窗朱户。\n十年空想，春风面杳，无计凭鳞羽。\n凄凉怀抱今如许。\n天与重相遇。\n不应还向楚峰前，朝暮为云为雨。\n算来各把，平生分付，也不是、恶著处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28105,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"朝中措 其二","author":"蔡伸","text":"雨馀清镜湛秋容。\n屏展九华峰。\n万里闲云散尽，半规凉月当空。\n楼高夜永，凭阑笑语，此际谁同。\n端有妙人携手，翛然归路凌风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28106,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"朝中措 其一","author":"蔡伸","text":"章台杨柳月依依。\n飞絮送春归。\n院宇日长人静，园林绿暗红稀。\n庭前花谢了，行云散后，物是人非。\n唯有一襟清泪，凭阑洒遍残枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28107,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"愁倚阑/春光好 其一","author":"蔡伸","text":"伤春晚，送春归。\n步云溪。\n绿叶同心双小字，记曾题。\n楼外红日平西。\n长亭路、烟草萋萋。\n云雨不成新梦后，倚阑时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28108,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]