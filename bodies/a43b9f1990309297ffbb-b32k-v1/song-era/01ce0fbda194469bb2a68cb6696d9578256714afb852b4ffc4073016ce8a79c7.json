[{"title":"富文和诗复用前韵","author":"王十朋","text":"四上祠章郡得湖，真同起废躄浮图。\n路经秋浦人如玉，洞入齐山天在壶。\n人物宜居国士选，吏民聊作使君呼。\n还乡说与贾君子，官比广昌风更孤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18578,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"子长招游齐山","author":"王十朋","text":"路经秋浦上崔嵬，不负孤舟万里回。\n峰比九华微具体，洞疑三竺远飞来。\n胜穷岩石玲珑地，秀吸江湖浩渺杯。\n先却紫微期一月，菊花未放桂花开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18579,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"富文赠桂花","author":"王十朋","text":"夔有百花无此香，两年官舍负秋光。\n使君元是蟾宫客，赠我数枝金粟黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18580,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"泛清溪","author":"王十朋","text":"清者未必贵，贵者或不清。\n胡为贵池内，却有清溪名。\n清贵两俱足，造物如有情。\n溪有夷屈风，池非赵孟荣。\n三秋冷浸月，十里光涵城。\n真可弄兹水，更堪濯吾缨。\n天亦知我意，故令居水精。\n水精岂吾居，龙湫老馀生。\n满壁画清溪，坐觉名利轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18581,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"子长见示汪枢密游齐山诗因次其韵","author":"王十朋","text":"莫莫休休祇欲闲，贵池误照野人颜。\n好诗如见元枢面，佳境仍逢相国山。\n谈笑从容禅榻畔，翠微彷佛梦魂间。\n吾侪相勉崇名节，岘首风流庶可攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18582,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"富文送鹿肉","author":"王十朋","text":"太尉前军得活鹿，使君慇勤分我肉。\n定知应是秦失馀，苗裔仍为世人逐。\n使君好客今平原，秋浦楼头罗水陆。\n青州从事嘉屡拜，白鹿山人赐新沐。\n社风留客去未得，清溪山头两经宿。\n频将口腹溷使君，大嚼戏吟诗一幅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18583,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"朱仲文和诗用齐山韵以酬","author":"王十朋","text":"蜀山同我上崔嵬，峡水相随共载回。\n秋月迎人霅川去，义风吹客浙江来。\n山游未尽无穷力，酒兴应嫌有限杯。\n准拟吴中作重九，菊花休道不须开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18584,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"子长和诗并馈饮食再用泛清溪韵","author":"王十朋","text":"秋浦天作秋，清溪风更清。\n三宿不忍去，山以齐为名。\n天台李御史，倾盖即钟情。\n怜我峡中归，笑谈洗枯荣。\n携壶上翠微，举首望赤城。\n相期老岩壑，便欲遗簪缨。\n赠我十首诗，字字工且精。\n从今似杜老，对酒怀李生。\n何当细论文，万户侯可轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18585,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"溪口阻风寄子长富文","author":"王十朋","text":"风知主人意，吹浪留客舟。\n客子念行役，形留心不留。\n回望月峡月，坐悲秋浦秋。\n从今怀人梦，飞绕清溪楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18586,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"子长和汪枢齐山诗复用前韵","author":"王十朋","text":"腐儒无用分投闲，吴蜀分符祇强颜。\n去访少陵三峡水，来寻太白九华山。\n小舟载酒清溪口，健卒传诗白浪间。\n风伯相留作吟社，愿低笔力许追攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18587,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"池阳阻风留十日","author":"王十朋","text":"舟楫何濡滞，秋深风未西。\n五旬从白帝，十日尚清溪。\n匈次泽吞楚，眼中山见齐。\n主人殊未厌，壶榼屡提携。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18588,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"子长携具至溪口复用前韵","author":"王十朋","text":"有客双蓬鬓，归从滟滪西。\n符分三竹使，地见两梅溪。\n舟遇先逢李，杯行酒到齐。\n他年石桥路，归去手应携。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18589,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄林黄中","author":"王十朋","text":"郎星夜照贵池口，渐见祥光烛牛斗。\n甘棠遗爱留浔阳，尽道前无此太守。\n我亦弭楫清溪滩，秋风吹浪高于山。\n与君相去才咫尺，形影隔绝烟波间。\n晨起扬帆欲东去，风伯江神两俱怒。\n吾侪行止端由天，天气未佳聊且住。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18590,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"望舒山","author":"王十朋","text":"舟阻清溪十日风，旅怀秋思渺无穷。\n开编细读舒王句，一点舒山在眼中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18591,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"出清溪","author":"王十朋","text":"归舟十日阻池阳，风伯相留意亦良。\n长喙参军初荐熟，无肠公子正输芒。\n齐山却向江南好，秋浦尤于社后凉。\n明日解维苕霅去，梦魂犹在水云乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18592,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"舟至梅根子长寄诗复用前韵","author":"王十朋","text":"使节淹江左，鱼符换浙西。\n诗筒犹在道，客棹已移溪。\n戒险疑浮峡，行徐类去齐。\n壶觞更何日，重向翠微携。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18593,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"淮山","author":"王十朋","text":"淮山无数不知名，山色遥看点点青。\n二百馀年仁草木，莫令污染犬羊腥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18594,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"九华山 其一","author":"王十朋","text":"九芙蓉自九天来，太史南游山未开。\n仙境曾经谪仙眼，佳名杰句两崔嵬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18595,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"九华山 其二","author":"王十朋","text":"舟出清溪尚逆风，观山却得少从容。\n浮云不碍天边眼，放出神仙八九峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18596,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"九华山 其三","author":"王十朋","text":"我在芙蓉山下家，四年秋色隔天涯。\n如今渐觉乡山近，已见芙蓉吐九华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18597,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"九华山 其四","author":"王十朋","text":"江南一岳占青阳，多少神仙此地藏。\n闻说仙翁捣药处，鸟声依旧克丁当。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18598,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"九华山 其五","author":"王十朋","text":"九华山下化成寺，太白书堂高处开。\n想见江山无此境，故宜头白懒归来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18599,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"九华山 其六","author":"王十朋","text":"峰峦列峙神仙境，子母相依孝义山。\n莫向山中摘花果，惜春啼鸟怒人攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18600,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"九华山 其七","author":"王十朋","text":"郡楼初见一奇峰，深恐烟霞无路通。\n神母遥遥将九子，总将山色到舟中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18601,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"九华山 其八","author":"王十朋","text":"曾见齐山小九华，梦游缥缈羽人家。\n灵山面目忽相见，舟系梅根秋日斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18602,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"九华山 其九","author":"王十朋","text":"曰华曰子数俱九，细看峰峦何许多。\n今古画工图不足，冠卿诗奈九华何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18603,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"铜陵阻风 其一","author":"王十朋","text":"两年官绝塞，万里下瞿唐。\n秋浦浪方息，铜陵风又狂。\n五松人忆白，双竹句思黄。\n今夜舟中月，中秋何处光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18604,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"铜陵阻风 其二","author":"王十朋","text":"江入铜陵县，舟藏芦苇间。\n邮亭危压浦，佛屋陋依山。\n月出乌将绕，风高雁欲还。\n江山不贫处，一览见尘寰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18605,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"黄池对月","author":"王十朋","text":"白帝去年月，黄池今夜看。\n风将清玉宇，云不碍金盆。\n明镜飞边远，霓裳舞处寒。\n论文一尊酒，欣对旧同官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18606,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宣城道中闻雁","author":"王十朋","text":"蝉噪景如夏，鸟鸣山似春。\n数声云外过，却是雁来宾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18607,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿新丰驿","author":"王十朋","text":"小驿数椽屋，夜深风雨中。\n邻家有鸡犬，不是汉新丰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18608,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"涂中遇雨","author":"王十朋","text":"江流渺渺风吹浪，驿路迢迢雨作泥。\n好把金章换蓑笠，故山深处把锄犁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18609,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过宛陵陪汪枢密登双溪阁叠嶂楼游高斋望敬亭山诵谢元晖李太白诗用枢公游齐山韵","author":"王十朋","text":"天将大任未容闲，清峭依然御史颜。\n谢客能吟练江句，谪仙不厌敬亭山。\n双溪风月壶觞里，叠嶂烟霞几案间。\n天下苍生望公起，归辕行见郡人攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18610,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"离宣城天色阴晦望群山不见枢公和诗见寄复用前韵","author":"王十朋","text":"圣恩犹未许投闲，遥访蘋洲柳与颜。\n羿妇解将风送月，麻姑莫遣雨遮山。\n心游孤屿题诗处，名玷元枢荐墨间。\n旦夕公归首台鼎，高斋遗躅倘容攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18611,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过麻姑山","author":"王十朋","text":"出郭群山四望无，故将诗句祷麻姑。\n忽然云破山开面，天色如春有鸟呼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18612,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿红林驿遇交代王给事","author":"王十朋","text":"路入红林林未红，相逢俱是白头翁。\n邮亭灯火一尊酒，明日君西我向东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18613,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"广德途中观刈稻","author":"王十朋","text":"田父欣相语，今年幸有秋。\n深忧水后烂，急向雨馀收。\n穗尽穴移鼠，畦空童放牛。\n何当速归去，吾亦有西畴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18614,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"祠山","author":"王十朋","text":"秋风吹客过祠山，水出平原碍往还。\n呼吸雨旸神有力，扫除云雾见天颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18615,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"桐川三绝 其一 遇太学三友","author":"王十朋","text":"归从三峡过三峰，益友三人忽此逢。\n行李稽留三日雨，天教我辈得从容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18616,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"桐川三绝 其二 驿中阻雨","author":"王十朋","text":"浸淫秋雨阻桐川，无术那能补漏天。\n传舍终宵不成寐，点灯重读旧诗篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18617,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"桐川三绝 其三 文籍遭水","author":"王十朋","text":"文书随我下瞿唐，准拟家添万卷藏。\n水厄那知在平地，从今既济要须防。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18618,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"九月一日自道场山如临安周德载夏廷茂自菁村乘舟来访既别寄以小诗","author":"王十朋","text":"二十年前旧友生，扁州来访见交情。\n相看容鬓俱非昔，记得炉亭笑语声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18619,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"待对仙林九日登佛阁时寄家道场山思去年游卧龙山遂用旧韵","author":"王十朋","text":"浮家东下路间关，地近家乡尚未还。\n风雨满城欣已过，星霜入鬓早宜闲。\n去年嘉客同吹帽，今日仙林独侍班。\n遍插茱萸忆兄弟，更添北望道场山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18620,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"九月十三日离仙林","author":"王十朋","text":"重入脩门鬓已华，君恩犹未许还家。\n木鱼声动催行李，蜡炬向人空自花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18621,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过东林","author":"王十朋","text":"地入东林眼界奇，神仙遗迹在榴皮。\n湖山如旧无东老，酒为嘉宾酿者谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18622,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"郡中久雨入境而霁","author":"王十朋","text":"积雨喜初霁，湖山清更嘉。\n船船渔晒网，岸岸稻烘芽。\n水涨鱼虾乐，年凶道路嗟。\n人言新太守，头白似苕花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18623,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"六客堂","author":"王十朋","text":"水晶宫中刺史宅，月□□堂游六客。\n中有一客为主人，万卷诗书李公择。\n元□□挥玉堂手，令举声蜚制科策。\n五劝使君古遗直，三□郎官老词伯。\n眉山有客何等人，退之少陵李太白。\n直道高才时不容，天遣数子为游从。\n吴兴清绝山水国，五百年过人中龙。\n健峭银钩逼颜鲁，点化湖山出奇语。\n高压白蘋洲上诗，更肯区区谈小杜。\n端如竹溪逢谪仙，并游逸士名俱传。\n飘飘乘风鼓长翮，两两照坐成台躔。\n苕霅交流卞山碧，一代名贤已陈迹。\n我后百年登此堂，咀嚼姓名牙颊香。\n坐上何曾欠佳客，苏仙一去难再得。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18624,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送朱仲文运干还蜀 其一","author":"王十朋","text":"分阃滥曾游蜀口，得朋深喜遇坤爻。\n澹台至室必公事，平仲与人能久交。\n一叶共乘夔到霅，四方相逐愈随郊。\n姓名已在诸公齿，引类行看似拔茅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18625,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送朱仲文运干还蜀 其二","author":"王十朋","text":"君归应过无喧室，我梦遥驰无隐斋。\n带得江山在诗卷，种成杨柳系离怀。\n定先春到夔门里，莫遣音疏霅水涯。\n故旧相逢倘相问，为言老欲乞残骸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18626,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"读喻叔奇游庐山诗 其一","author":"王十朋","text":"前年我亦到庐山，杖屦烟霞缥缈间。\n万里东归如倦鸟，不知飞过只知还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18627,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"读喻叔奇游庐山诗 其二","author":"王十朋","text":"路经湓浦叹匆匆，不及从君访远公。\n忽见庐山真面目，在君二十一时中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18628,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十月晦日会凌季文沈德和二尚书刘汝一大谏于六客堂","author":"王十朋","text":"梦寐思贤愿与齐，一麾来守浙江西。\n星躔旧识尚书履，玉府曾亲太一藜。\n天遣门生依坐主，心随峡水注苕溪。\n邦人异日谈遗事，名姓应同六客题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18629,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"沈书和诗再用韵","author":"王十朋","text":"先生名与卞山齐，贱子来归自瀼西。\n自愧蒹葭难倚玉，暂教松柏俯同藜。\n万言谠论惊天阙，八咏高才压婺溪。\n柳恽苏仙旧吟处，愿陪杖屦遍留题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18630,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"凌书和诗复用韵","author":"王十朋","text":"人物堂堂大国齐，难窥赐履地东西。\n心才遇日即倾藿，身或在山谁采藜。\n隐德犹能及枯骨，安车行见起磻溪。\n后生何幸依先达，误辱山公一字题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18631,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"刘汝一和诗复用韵","author":"王十朋","text":"鲁酒三杯却到齐，诗坛老将胜山西。\n气馀殿上欲折槛，清见胸中不糁藜。\n聊复忘机对禅榻，未应采药赴桃溪。\n吾侪会合真天意，清绝湖山尽共题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18632,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十一月十日会于六客堂者十人宋子飞徐致云章茂卿邓叔厚莫子登俞仲明许子齐沈虞卿郑寿淑酒三行予得诗","author":"王十朋","text":"六客高风不可追，吾侪生恨百年迟。\n星光月满旧游处，簪盍蓂开盈数时。\n访古已仙图上鹤，得朋今遇易中龟。\n吾夫子道欲坠地，不是四科谁与持。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18633,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"汝一和十客诗语及贡院复用前韵","author":"王十朋","text":"洙泗家风尚可追，未应吾道便陵迟。\n要令士有欢颜地，如见公为举首时。\n山绕苕溪翻振鹭，水通震泽锡神龟。\n眼中突兀行将见，大厦端由众木持。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18634,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"晦日会于六客堂者十二人","author":"王十朋","text":"湖山清绝多佳士，暇日壶觞得共携。\n堂上合成前后客，诗中分得建除题。\n不容闰位参卿月，坐觉巫山在霅溪。\n麟阁功名属公辈，老夫惟愿把锄犁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18635,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵张叔清见寄","author":"王十朋","text":"太学年时识一夔，婺溪掺别越三期。\n闽中大府子为掾，峡内孤城予把麾。\n去隔关山共明月，归逢鱼雁寄新诗。\n苕溪昨夜梅花发，目对清标有所思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18636,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵林明仲见寄","author":"王十朋","text":"忆昔相逢未白头，别来岁月迅如流。\n自从江左分符去，长念城南载酒游。\n君似老松姿耐雪，我犹弱柳叶经秋。\n梅溪梅屿不相远，归去定乘寻戴舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18637,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"贡院上梁","author":"王十朋","text":"清绝湖山映白蘋，翚飞梁栋眼中新。\n雪花先作晓来瑞，桂魄正圆天上轮。\n夫子庙还元气象，水晶宫发旧精神。\n书生战艺真馀事，移孝为忠要致身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18638,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"诸公和诗再用韵并简沈虞卿教授","author":"王十朋","text":"来采汀洲柳恽蘋，要观草色赐袍新。\n士由德行首科第，木就方圆在梓轮。\n山峙浮图耸千佛，水迎仙子上三神。\n耽耽广厦荣归日，应话林泉老病身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18639,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄夔州张君玉抚干","author":"王十朋","text":"天上张公子，同僚半载馀。\n令人思滟滪，有客泛芙蕖。\n一自离夔子，频蒙寄鲤鱼。\n江山元不远，面目在来书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18640,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送张光大赴长沙簿","author":"王十朋","text":"同舍张公子，长沙远宦游。\n读书真有用，谋道了无忧。\n赋鵩休悲贾，栖鸾暂屈仇。\n荐章行引类，文帅是鳌头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18641,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送柑姚子才","author":"王十朋","text":"少年怀橘献慈亲，今见黄柑泪满巾。\n同舍故人堂有母，可能罗帕不分珍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18642,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过孺人挽词 其一","author":"王十朋","text":"扁舟昔访戴逵居，早识奇儿骨相殊。\n不是剡溪能蕴秀，祇应蚌腹解生珠。\n家从机断知为学，身自鸡鸣起奉姑。\n儒术登科有犹子，大书遗懿照龟趺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18643,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过孺人挽词 其二","author":"王十朋","text":"过从有夏孕遗芳，作配于周妇德良。\n目不泛观惟贝叶，舍无他物有天香。\n鱼轩欲动喜家近，乌冢忽归惊夜长。\n年到古希子孙足，人生如此尚何伤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18644,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]