th":"宋_2.csv","pointer":50703,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠别周文显三首 其二","author":"赵蕃","text":"有别动五六载，相过才一二朝。\n白首我方糟曲，素风君欠箪瓢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50704,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠别周文显三首 其一","author":"赵蕃","text":"苦节虽非中道，清风要激贪夫。\n寂寞掩关高卧，纷纷顿辔长途。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50705,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小重山 寄刘叔通先生序云：小重山一阕，传","author":"赵蕃","text":"何地无溪祗欠人。\n有翁年八十，住其滨。\n直钩元不事丝缗。\n优游尔，聊以遂吾身。\n陶令赋归辰。\n未尝轻出入，犯风尘。\n江洲太守独情亲。\n庐山醉，谁主复谁宾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50706,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"失调名","author":"赵蕃","text":"春浦雪，涧泉梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50707,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 送游季仙归东阳","author":"赵蕃","text":"鸡声茅店炊残月。\n板桥人迹霜如雪。\n此是古人诗。\n身经老忘之。\n君行当此境。\n令我昏成醒。\n乘月犯霜来。\n诗真误尔哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50708,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其一","author":"赵蕃","text":"王家碧香酿，刘尹建安诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50709,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其二","author":"赵蕃","text":"青云道远龙媒老，白雪词高鬼胆寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50710,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"临安还游金龙洞志感","author":"赵镇","text":"几年岩径违清赏，今日云萝蹑旧踪。\n刹阁春阴宜燕雀，天池雷雨起蛟龙。\n崖流玉液空莲座，风激筼筜送梵钟。\n洞口不愁迷去路，樽前聊与话从容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50711,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题妙庭观玉泉池","author":"赵镇","text":"一脉泠泠绝点埃，方池幽洞自潆洄。\n源从白石云边出，流向青莲座下回。\n禹穴鳞游残雪喷，祗园花堕暗香来。\n可人最是清秋夜，月白沙青宝镜开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50712,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游戒珠寺","author":"赵諴","text":"欲游城郭应难遍，每访湖山亦自劳。\n坐致眼前无限景，僧房寄处蕺峰高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50713,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和孔司封题蓬莱阁","author":"赵諴","text":"龙卧山形滴翠微，翚飞阁势搆空危。\n六鳌不是湖中蛰，一岛疑从海上移。\n屏障笺毫吟咏处，神仙罗绮燕游时。\n自惭为吏非香案，又蹑云梯从使麾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50714,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游云门寺","author":"赵諴","text":"竟夕雨声寒，黎明日气暄。\n峰峦添积润，溪涧涨新痕。\n钟鼓连三寺，杉松共一村。\n不须游赏遍，丽句满清轩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50715,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游天衣寺","author":"赵諴","text":"世称幽景属金仙，若是精蓝岂妄传。\n涧涌双泉雷出地，山围四面管窥天。\n唐僧手泽神毫健，梁帝宸恩宝器妍。\n今日喜偿平昔志，更逢闽客此安禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50716,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送张达道还山","author":"赵璩","text":"剩借红尘一日閒，有劳妙语彻幽关。\n岂知隐几如南郭，也愧移文向北山。\n有意清风怜我住，无心孤月伴君还。\n三茅若问今消息，为报逍遥天地间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50717,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水调歌头 和平湖","author":"赵磻老","text":"梅仙了无讼，拄笏看西山。\n山涵秋晓，水光磨荡有无间。\n自是灵襟空洞，更望风云吞吐，浩渺白鸥闲。\n高诵远游赋，独立桂香阑。\n谩常谈，如观水，要观澜。\n物情长在，人生何用苦求难。\n随我一觞一咏，任彼非元非白，唯放酒杯宽。\n富贵傥来事，天道管知还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50718,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"永遇乐 寿叶枢密","author":"赵磻老","text":"香雪堆梅，绣丝蹙柳，仙馆春到。\n午夜华灯，烘春艳粉，月借今宵好。\n衮衣摇曳，簪缨闲绕，共祝大椿难老。\n望台躔、明星一点，冰壶表里相照。\n诞弥令节，欣欣物态，共喜重生周召。\n八鼎勋庸，九夷姓字，策杖孤鸿杳。\n鸦啼鹊噪，兰馨松茂，把酒共春一笑。\n管如今、盐梅再梦，夜铃命诏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50719,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"生查子 其一 答洪丞相谢送小冠","author":"赵磻老","text":"章甫不如人，翠绾垂杨缕。\n纤手送来时，罗帕缄香雾。\n貂蝉懒上头，渭水知何处。\n风月共垂竿，脱帽须亲付。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50720,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"生查子 其二 洪舍人用前韵索冠答谢，并以冠往","author":"赵磻老","text":"朝路进贤归，厌听歌金缕。\n不恋玉堂花，豹隐南山雾。\n漉酒未巾时，暑槛披风处。\n子夏不兼人，并与诗筒付。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50721,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"生查子 其三 再和丞相","author":"赵磻老","text":"金门一免时，离绪纷如缕。\n想像切云高，晓日罗昏雾。\n峨冠补衮人，不是无心处。\n欲效贡公弹，衣钵知谁付。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50722,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"生查子 其四 再和舍人","author":"赵磻老","text":"斜日下平川，楼角销霞缕。\n摆尽浊尘缨，画栋萦非雾。\n平生许子穷，今到知音处。\n约伴玉簪游，好梦从天付。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50723,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"念奴娇 中秋垂虹和韵","author":"赵磻老","text":"冰蟾驾月，荡寒光、不见层波层碧。\n几岁中秋争得似，云卷秋声寂寂。\n多谢星郎，来陪贤令，快赏鳌峰极。\n广寒宫近，素娥不靳馀力。\n夜久露落琼浆，神京归路，有云翘前迹。\n当日仙人曾驭气，只学神交龟息。\n今夜清尊，一齐分付，稳是乘槎客。\n天津重到，霓裳何似闻笛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50724,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南柯子/南歌子 其二 和谢洪丞相送竹妆奁","author":"赵磻老","text":"体质娟娟静，花纹细细装。\n翠筠初得试新忙。\n睡起鬓云撩乱、趣泉汤。\n多病心常捧，新词字带香。\n管教涂泽到云窗。\n办下谢君言语、巧如簧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50725,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南柯子/南歌子 其一 和洪丞相约赏荷花","author":"赵磻老","text":"世上渊明酒，人间陆羽茶。\n东山无妓有莲花。\n隐隐仙家鸡犬、路非赊。\n积霭犹张幕，轻雷似卷车。\n要令长袖舞胡靴。\n须是檐头新霁、鹊查查。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50726,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其二 和洪舍人","author":"赵磻老","text":"刘氏风流设此冠。\n今谁将去伴珠鬟。\n君家兄弟二俱难。\n驰去请观流汗马，钓时休等烂银盘。\n明朝吟咏有方干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50727,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其一","author":"赵磻老","text":"懒画娥眉倦整冠。\n笋苞来点镜中鬟。\n承恩容易报恩难。\n鬒发未饶青箬笠，素鳞行簇水晶盘。\n流觞元自不相干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50728,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"满江红 其三","author":"赵磻老","text":"潇洒星郎，吹绿鬓、胜游霞举。\n秋又半，月磨云翳，籁传风语。\n太一青藜光对射，中流荡漾莲舟舞。\n戏人间、今夜水精宫，前无古。\n吾家是，蓬山侣。\n歌舞袖，蘋花渚。\n拟问津斜汉，乘槎南浦。\n谒帝通明今得便，素娥拍手心先许。\n笑画阑、三十六宫秋，花如土。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50729,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"满江红 其二 用前韵","author":"赵磻老","text":"西郭园林，湖光净、暮寒清溢。\n明月上，近环山翠，远摇天碧。\n粉泽兰膏违俗尚，岩花磴蔓从谁觅。\n问近来、铛脚许何人，吾其一。\n欢乐事，休教毕。\n经后夜，思前日。\n想无心不竞，水流云出。\n物外烟霞供啸咏，个中鱼鸟同休逸。\n又何须、浮海访三山，寻仙迹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50730,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"满江红 其一","author":"赵磻老","text":"见说春时，新波涨、二川溶溢。\n今底事、沙痕犹褪，石渠悭碧。\n人意不须长作解，兴来便向杯中觅。\n纵茂林修竹记山阴，千年一。\n薰吹动，春工毕。\n桥上景，壶中日。\n况梅肥笋嫩，雨微鱼出。\n只恐延英催入觐，不教绿野长均逸。\n任多情、胡蝶满园飞，狂踪迹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50731,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉蓬莱 其一 寿叶枢密","author":"赵磻老","text":"听都人歌咏，便启金瓯，再登元老。\n山色溪声，与春风齐到。\n补衮工夫，望梅心绪，见丹青重好。\n鹊噪晴空，灯迎诞节，槐堂欢笑。\n正是元宵，满天和气，璧月流光，雪消寒峭。\n今夜今年，表千年同照。\n万象森罗，一奁清莹，影山河多少。\n玉烛调新，彩眉常喜，寰瀛春晓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50732,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉蓬莱 其二 寿叶枢密","author":"赵磻老","text":"记青蛇感异，后日扶颠，太平人瑞。\n壮岁弹冠，有经邦高志。\n晚上文墀，载严霜简，便云龙交际。\n紫极旋枢，金蝉映衮，乾坤开霁。\n底事当时，饮江胡马，一望云旗，倒戈投贽。\n此片丹心，几风声鹤唳。\n烟息尘收，水明山丽，只五湖相记。\n今夜华灯，火城信息，千年荣贵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50733,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其一 寿叶枢密","author":"赵磻老","text":"堂上年时见烛花。\n青毡还入旧时家。\n芝函瑞色回春早，绿野东风转岁华。\n催召传，稳铺沙。\n罍尊今日枣如瓜。\n诞辰更接传柑宴，莲炬通宵唤草麻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50734,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其二 寿叶枢密","author":"赵磻老","text":"白日青天一旦明。\n旧时勋业此时情。\n延英再许裴公对，商鼎须调傅说羹。\n千万载，辅宗祊。\n擎天八柱愈峥嵘。\n将军犁却龙庭后，岁傍鳌山奏太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50735,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]