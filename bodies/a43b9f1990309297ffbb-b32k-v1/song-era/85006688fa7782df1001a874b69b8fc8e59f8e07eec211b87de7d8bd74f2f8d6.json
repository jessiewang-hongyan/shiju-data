commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50679,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"幽居即事八首 其二","author":"赵蕃","text":"笋迸阶石欲落，树成窗影疑深。\n未能作有画句，聊且弄无弦琴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50680,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"幽居即事八首 其一","author":"赵蕃","text":"游丝落花春尽，绿叶青阴夏来。\n雨润苔钱更积，风清竹户频开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50681,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送刘公求还庐陵兼属张元亨五首 其五","author":"赵蕃","text":"张子虽习旧识，近来乃读新篇。\n寄谢青原白鹭，何当共刺江船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50682,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送刘公求还庐陵兼属张元亨五首 其四","author":"赵蕃","text":"雪后梅增炯炯，风前柳政徐徐。\n道上有诗堪写，人回不用空书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50683,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送刘公求还庐陵兼属张元亨五首 其三","author":"赵蕃","text":"得见虽能数日，晤言每恨匆匆。\n曷日竹斋重过，更期汗简同功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50684,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送刘公求还庐陵兼属张元亨五首 其二","author":"赵蕃","text":"中垒西京儒士，魏唐变作文章。\n源委祇今安在，萧滩滩水深长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f7968