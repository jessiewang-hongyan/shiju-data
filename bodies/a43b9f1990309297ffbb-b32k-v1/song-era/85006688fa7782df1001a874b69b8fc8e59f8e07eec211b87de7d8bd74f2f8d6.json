[{"title":"次韵斯远重别六言四首 其四","author":"赵蕃","text":"君才绝出辈流，语不惊人不休。\n莫叹阳春寡和，会逢知我春秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50667,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵斯远重别六言四首 其三","author":"赵蕃","text":"不惮舆篮百里，要成对榻深论。\n论自衷怀易感，况因远别伤魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50668,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵斯远重别六言四首 其二","author":"赵蕃","text":"微禄我嗟趋走，穷苦君厌荒凉。\n谋道与之谋食，未知何计为长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50669,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵斯远重别六言四首 其一","author":"赵蕃","text":"欲语动怀抱恶，重吟生肝肾愁。\n平生几为此别，今年又作南游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50670,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵蔡叔清六言二首 其二","author":"赵蕃","text":"窗户初乾宿雨，林园已报秋声。\n欲访残僧野寺，未妨水宿山程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50671,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵蔡叔清六言二首 其一","author":"赵蕃","text":"陶潜必遗俗患，侯喜新有诗声。\n容我深藏蹇步，看君大展修程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50672,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"远意","author":"赵蕃","text":"不待苍然暮色，可应万里须论。\n要悟须弥芥