[{"title":"龙门偶作五首 其三","author":"释清远","text":"呜呜鼯鼠啼，时人皆不喜。\n得意即相呼，意去当自止。\n吉凶由之生，吾未见其理。\n此言如未闻，大梅有宗旨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59423,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"龙门偶作五首 其四","author":"释清远","text":"初夜凉生早，微云卷太空。\n灯悬松竹露，帘捲薜萝风。\n可笑千年事，能将一念通。\n相逢禅客间，细细话吾宗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59424,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"龙门偶作五首 其五","author":"释清远","text":"每念心中事，频开掌内珠。\n欲凭天上雁，待寄水中鱼。\n此意终难写，斯言不可书。\n含毫竟寂寞，绕屋树扶疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59425,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题灵光台壁 其一","author":"释清远","text":"吾初欲作真常语，更恐真常暗流注。\n不如不语人共知，人欲知之反劳虑。\n崖头浮图示其相，台上野云飞不住。\n周游独步或可追，锦绣谷中归舍去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59426,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题灵光台壁 其二","author":"释清远","text":"百骸溃散此日言，一物长灵异时语。\n此日长灵犹可知，异时溃散凭谁举。\n可知所以有生灭，解举方能忘取与。\n光明寂照遍河沙，慎勿于中论尔汝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59427,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"花山","author":"释清远","text":"石龟不念岁月古，旧记已灭名尚留。\n道傍苍木老霜雪，涧畔野草随春秋。\n讹传细读华阳传，灵迹独闻姚比丘。\n可凭定力验今昔，人间万事徒悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59428,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"木鱼","author":"释清远","text":"无端击此沟中断，钟鼓相参无杂乱。\n能闻所闻非二缘，以此及此通回换。\n凡夫何故作追攀，达士若为成智观。\n可怜流入萨婆若，醉眠尚尔排鱼贯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59429,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读经","author":"释清远","text":"不染而染妄本虚，染而不染悉无馀。\n本虚自是能成事，体净何妨应万殊。\n断妄證真心岂息，非真非妄智还迂。\n了真了妄如无碍，自在圆明始是珠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59430,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"不寐","author":"释清远","text":"毗耶离城居士家，环堵十笏容河沙。\n八万四千高座众，咄嗟已办熏天花。\n迢迢不到迷是障，念念常入心无差。\n须弥卢山四大海，我见如一粟与麻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59431,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"早起","author":"释清远","text":"老来愈见心无事，夜永偏知胆更凉。\n浅浅地炉犹有火，依依山月尚临墙。\n试将寂灭那伽定，暗写雕虫篆刻章。\n刚被啼鸡忽惊断，一时归入正思量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59432,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"起晚","author":"释清远","text":"展脚缩脚饥鼠啼，合眼开眼重露晞。\n觉来始了梦时事，梦处宁容觉后知。\n瞬息黄粱犹未熟，翩翻蝴蝶正狂飞。\n披衣独坐日正午，试问何如半夜时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59433,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游定明塔院作二颂 其一","author":"释清远","text":"大士安禅地，千松塔院春。\n门深松桧老，事古岁时新。\n人礼香灯夜，鸟啼花雨晨。\n祇应禅石上，去住亦通神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59434,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游定明塔院作二颂 其二","author":"释清远","text":"白塔云中路，晴空鸟外檐。\n好山长入望，终日坐无厌。\n几个竹生石，数枝花映帘。\n长安曾未到，神力动飞潜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59435,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"因举楞严经七处徵心成颂","author":"释清远","text":"善逝明知直不邪，要穷妄识是空花。\n故令庆喜推心目，胜相初观始出家。\n在内何缘昧肝胃，相知在外又成差。\n琉璃比眼还同境，闭障开明未有涯。\n合处随生难定体，根尘兼带转蓬麻。\n世间一切都无著，水陆空行作翳瑕。\n七处无归全失措，从兹始得遍河沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59436,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"述怀示学者","author":"释清远","text":"细思五十三年事，并入初中后夜心。\n须信刹那通过未，更无毫发作追寻。\n随消旧业根先断，永绝新殃道已深。\n此是安身立命处，故吹一曲报知音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59437,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"病中示光道者","author":"释清远","text":"我病无形不可见，曼殊室利得深知。\n再三若欲通消息，推出床头木枕儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59438,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蒋山送无著道人归舒州","author":"释清远","text":"已礼云中塔，更瞻堂上师。\n方思江水北，共集定林西。\n一句无多子，千差永不疑。\n到家勤爱护，此道少人知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59439,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送禅人入京","author":"释清远","text":"千人丛与万人丛，无喜无嗔耳目通。\n要识太原孚上座，六街钟鼓闹鼕鼕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59440,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再得旨退褒山成三偈代违和守钱公 其一","author":"释清远","text":"住山久有烟霞疾，得请放还麋鹿群。\n厚意于公殊未报，深禅聊复对炉薰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59441,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再得旨退褒山成三偈代违和守钱公 其二","author":"释清远","text":"公家忠靖有遗德，乃与定明开道缘。\n异世今时岂人意，一麾千里是家传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59442,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再得旨退褒山成三偈代违和守钱公 其三","author":"释清远","text":"出岫油然亦乘兴，倦飞随意即知还。\n有心知到无心域，鸟恋故林云在山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59443,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"释迦如来出山像赞","author":"释清远","text":"妙色非身，形容乃普。\n阎浮未下，双林已睹。\n旷济功深，六年行苦。\n尘沙相好，万亿刹土。\n众生心净，佛日常午。\n正念蒙光，迷人外取。\n雕檀写氎，像未孩乳。\n今兹范模，传从乃古。\n象步出山，智珠河吐。\n水月顿澄，豁开觉户。\n瞻之仰之，岂敢自侮。\n常在不灭，此言手舞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59444,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观音像赞二首 其一","author":"释清远","text":"旷大劫来离众苦，心心永断诸分别。\n闻处真闻实不闻，说时虽说常无说。\n法身普现凡圣等，耳根采听音声绝。\n娑婆最有大因缘，一念清凉除恼热。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59445,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观音像赞二首 其二","author":"释清远","text":"旷大劫来不虚妄，言言故得皆真实。\n应念蒙光迅电飞，寻声救苦奔风疾。\n千章万句离文字，异韵殊音垂秘密。\n现相宣扬遇此时，见闻颖脱欣今日。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59446,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"天台三大士像赞","author":"释清远","text":"岩岩天台，旷阔寰宇。\n大士不我，毫端莫取。\n蜀客心狂，纤尘一缕。\n屈指拊掌，松石猛虎。\n生涯何有，流传今古。\n静对虚堂，非谓无补。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59447,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"达磨大师赞","author":"释清远","text":"振摇梁魏，斟酌皮髓。\n孰云西来，空椁而已。\n素壁虚堂，少林熊耳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59448,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"百丈大师赞","author":"释清远","text":"慧灯续传，福庭宜敞。\n常住世间，水月镜像。\n是谓丛林，大智百丈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59449,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杨岐和尚赞","author":"释清远","text":"闹市竿头呈戏，众眼曾惊。\n栗棘蒲上横吞，诸方尽畏。\n宜阳秀水，萍实杨岐。\n雨过云横，天高地下。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59450,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"白云端和尚赞","author":"释清远","text":"纲纪著明，不忘付授。\n净空无际，如日处昼。\n欲究根源，瞻之龙岫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59451,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"五祖演和尚赞","author":"释清远","text":"遇冤则亲，传虚果当。\n刚硬齿牙，生铁肠脏。\n风清淮楚，道实宗匠。\n不有智悲，子孙安向。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59452,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浮山圆鉴和尚赞","author":"释清远","text":"并汾铁骑，老息荒丘。\n云施雨罢，花落水流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59453,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"褒山定明禅师赞","author":"释清远","text":"四海称唐，师出华阳。\n不起燕坐，翱翔帝乡。\n名与山俱，道逐时芳。\n济民助国，能雨能旸。\n贫者获富，热者得凉。\n群蒙所归，实在不亡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59454,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"悟首座图余幻质复求为赞","author":"释清远","text":"廓然无圣，俨尔有容。\n明明绝眹，密密垂踪。\n昔也怀宝，枯木藏龙。\n今其示人，巨岳乔松。\n龙吞万类，松茂三冬。\n神而不改，风云必从。\n吾形既得，尔道自钟。\n褒斜路险，汉水朝宗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59455,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"圭首座求赞","author":"释清远","text":"如圭如璋，惟子非我。\n且陋且拙，在余是可。\n子今传余，拙则成奇。\n物感神会，形动心随。\n凝云不飞，寒月下映。\n孰谓之凡，孰谓之圣。\n余犹尔也，奇拙同贯。\n嘻嘻期文，大朴未散。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59456,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"顺知藏求赞","author":"释清远","text":"色里胶青不见形，影中所以邈吾真。\n吾真定有非形碍，为对凡夫显幻尘。\n尘既显，道弥新，不贵西来彼上人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59457,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渊禅人求赞","author":"释清远","text":"似余似余，类我类我。\n我复谓谁，如火与火。\n描邈不就，迎随不果。\n写出龙门，衲僧灾祸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59458,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"如大师求赞","author":"释清远","text":"比类则疏，现形仍普。\n得在一瞬，照穷千古。\n云起吟龙，风生啸虎。\n赞之绝辞，瞻焉奚睹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59459,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贤监院求赞","author":"释清远","text":"遍界不藏，毫端独妙。\n纵未嚬呻，已先微笑。\n吾子识也，水月斯照。\n纤尘不遗，是为宗要。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59460,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"肱维那求赞","author":"释清远","text":"识余者谁，请观端的。\n孰云丹青，谩劳寻觅。\n断云架巘，皎月在壁。\n昭尔惺惺，悟兹寂寂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59461,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"勤禅人求赞","author":"释清远","text":"沧溟一滴咸无际，厚地纤尘广有馀。\n何事陋容人写得，祇缘踪迹在龙舒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59462,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"昕侍者求赞","author":"释清远","text":"吾行尔随，吾唤尔应。\n唯随与应，不欠不剩。\n因吾识尔，此像果亲。\n静而瞻之，道实绝伦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59463,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"元侍者求赞","author":"释清远","text":"道虽光明，形则山野。\n提折脚铛，住深兰若。\n拙韵无取，陋容谁写。\n常在左右，觉元侍者。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59464,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"小师崇戒求赞","author":"释清远","text":"似即疏，比仍失。\n廓尔空，皎然日。\n顾丹青，写容质。\n谁使之，省寻觅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59465,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"无著道人求赞","author":"释清远","text":"植杖望云何处，空山独立凝情。\n愧我萧然无物，谢伊装点相成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59466,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"冯济川教授求赞","author":"释清远","text":"天地无物我无物，隐显空云随出没。\n此间谁是悟玄人，霹雳光中轰一咄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59467,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"吴公明求赞","author":"释清远","text":"欲识坦然老，乃是龙门人。\n声名落四方，坐卧今十春。\n会见移庵去，何妨邈形真。\n平生香火缘，对比即神通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59468,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"张公寿求赞","author":"释清远","text":"首到东山，晚亲龙岫。\n岁经寒暑，人非新旧。\n涂毒长鸣，优昙勿嗅。\n静对终日，弟子公寿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59469,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戴巨济求赞","author":"释清远","text":"画出人皆识，相逢道更亲。\n起云峰后路，记得往来频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59470,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"龙门常住图师真知事求赞","author":"释清远","text":"寥廓无状，孰为龙门。\n有指南路，绝刀斧痕。\n因缘去住，任物所论。\n黄竹寒湫，晓而复昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59471,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古六十二首 其一","author":"释清远","text":"杲日连天照有无，孰云善逝坐跏趺。\n如今要见当年事，邪正犹来在半途。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59472,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古六十二首 其二","author":"释清远","text":"法王法令若为酬，潦倒文殊强出头。\n负累释迦犹可事，至今千古闹啾啾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59473,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古六十二首 其三","author":"释清远","text":"百万人天望举扬，拈花微笑大乖张。\n几多业识茫茫者，问著劳生沸似汤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59474,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古六十二首 其四","author":"释清远","text":"若有丝毫付与人，可师何得更全身。\n人间天上迷逢处，八两元来是半斤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59475,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古六十二首 其五","author":"释清远","text":"非风幡动唯心动，大海波澜常汹涌。\n鱼龙出没任升沉，生死圣凡无别共。\n无别共底怎么样，祖佛傍观空合掌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59476,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古六十二首 其六","author":"释清远","text":"潦倒江湖上，竿头事可咍。\n一回浮子动，又是上钩来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59477,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古六十二首 其七","author":"释清远","text":"草里寻常万万千，报云飞去岂徒然。\n鼻头是甚闲皮草，十字纵横一任穿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59478,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古六十二首 其八","author":"释清远","text":"一回思想一伤神，不觉翻然笑转新。\n云在岭头闲不彻，水流涧下太忙生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59479,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古六十二首 其九","author":"释清远","text":"挂得帆来遇便风，须臾千里到家乡。\n临门上岸逢妻子，欢喜情怀不可当。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59480,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古六十二首 其十","author":"释清远","text":"挂拂遭呵耳便聋，衲僧奚若验宗风。\n金刚脑后抽生铁，华岳三峰倒卓空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59481,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古六十二首 其十一","author":"释清远","text":"家肥生孝子，国霸有谋臣。\n拳头劈口槌，未到无儿孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59482,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古六十二首 其十二","author":"释清远","text":"开田说大义，后人莫容易。\n百丈总持门，淡而还有味。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59483,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古六十二首 其十三","author":"释清远","text":"打面还他州土麦，唱歌须是帝乡人。\n现成财本成家者，多见饥寒在子孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59484,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古六十二首 其十四","author":"释清远","text":"大雄山下斑斑虎，触著伤人谁敢顾。\n亲遭一口老婆心，何曾用著腰间斧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59485,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古六十二首 其十五","author":"释清远","text":"相见言谈理不亏，等闲转面便相辉。\n毕竟水须朝海去，到头云定觅山归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59486,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古六十二首 其十六","author":"释清远","text":"大唐国里无禅师，不许会兮祇许知。\n著肉汗衫如脱了，方知棒喝诳愚痴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59487,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古六十二首 其十七","author":"释清远","text":"彼此老来谁记得，人前各自强惺惺。\n一坑未免俱埋却，几个如今眼子青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59488,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古六十二首 其十八","author":"释清远","text":"问答分明是切磋，几人于此见詨讹。\n少年俱决龙蛇阵，潦倒同吟稚子歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59489,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古六十二首 其十九","author":"释清远","text":"相见锦江头，相携上酒楼。\n会医还少病，知分不多愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59490,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古六十二首 其二十","author":"释清远","text":"八面当风祇这是，拂袖之谈动天地。\n堪爱卖身王老师，不作贱兮不作贵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59491,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古六十二首 其二十一","author":"释清远","text":"南北东西无不利，令人深爱老南泉。\n眉毛撕系如相似，鼻孔辽天不著穿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59492,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古六十二首 其二十二","author":"释清远","text":"禅床惊震被搽糊，惹得儿孙不丈夫。\n拄杖劈头连打出，也教知道赤须胡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59493,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古六十二首 其二十三","author":"释清远","text":"祖佛场中不展戈，后人刚地起詨讹。\n道泰不传天子令，时清休唱太平歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59494,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]