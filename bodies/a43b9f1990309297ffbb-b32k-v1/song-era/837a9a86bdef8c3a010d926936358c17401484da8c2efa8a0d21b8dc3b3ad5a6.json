[{"title":"宿雁荡能仁寺","author":"林季仲","text":"万壑千岩簇马蹄，羞将尘鬓照清溪。\n晚云带雨东风急，无数飞花过竹西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28342,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"萧德起诸人约游西湖小疾不赴","author":"林季仲","text":"倚杖臞然一病夫，羡君联骑出西湖。\n若逢佳处能相忆，寄与新诗作画图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28343,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"富季申赋梅次韵四首 其四","author":"林季仲","text":"未知何处是真梅，雪拥溪桥拨不开。\n莫讶行人数回首，西风十里送香来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28344,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"富季申赋梅次韵四首 其三","author":"林季仲","text":"谁将消息报江梅，一点先从雪里开。\n怪见逢迎有深意，我家曾与写真来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28345,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"富季申赋梅次韵四首 其二","author":"林季仲","text":"雪意商量欲放梅，破寒先遣一条开。\n去年花下人何在，策我蹇驴归去来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28346,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"富季申赋梅次韵四首 其一","author":"林季仲","text":"容易烦公问讯梅，昨宵还有几花开。\n窗寒月落知相忆，细细吹香过竹来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28347,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题护国院竹光轩","author":"林季仲","text":"茶罢移床就竹眠，泠然风起和流泉。\n山禽未绝东归客，时送清音到枕边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28348,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游智者寺","author":"林季仲","text":"一径萦迂上翠微，乱红无数扑人衣。\n匆匆来往成何事，不似山禽自在飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28349,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登张知省溪楼 其二","author":"林季仲","text":"雁横霜渚水痕收，檐外微云去复留。\n多谢西风解人意，尽驱爽气入溪楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28350,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登张知省溪楼 其一","author":"林季仲","text":"木落霜清橘柚香，榜歌迢递起沧浪。\n来鸿去鹜纷无数，怕上西楼望夕阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28351,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登望湖楼","author":"林季仲","text":"胡尘漠漠暗中州，无力持颠漫自忧。\n花鸟相逢非昔日，不堪重上望湖楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28352,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"墨梅","author":"林季仲","text":"一枝炯炯照人寒，绝似溪桥立马看。\n祇恐春风解相怨，漏他消息入毫端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28353,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题广照院壁","author":"林季仲","text":"晚溪飞出小桥斜，流水萦迂带落花。\n生怕人来问时事，杖藜聊复过僧家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28354,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题外兄毛国器壁","author":"林季仲","text":"尊酒相逢海一涯，娟娟妙月照人衣。\n重来时节君须记，流水桃花鱼正肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28355,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题康侍郎所居二首 其二 止鉴亭","author":"林季仲","text":"莫道水清偏得月，须知水浊亦全天。\n请看风定波平后，一颗灵珠依旧圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28356,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题康侍郎所居二首 其一 一径堂","author":"林季仲","text":"閒居正怕门庭杂，学道仍嫌歧路多。\n仲蔚当时开一径，问渠初意果如何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28357,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日诸人集于资福阁次高季应韵三首 其三","author":"林季仲","text":"戏马台前草自妍，英雄何在竟茫然。\n江河犹带重阳恨，父老空将旧事传。\n去雁来鸿波浩荡，夕阳流水树芊眠。\n休休世味从来恶，细嚼霜英慰暮年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28358,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日诸人集于资福阁次高季应韵三首 其二","author":"林季仲","text":"隔竹通晖月自妍，樽前宝炬不须然。\n毫飞阁上千林湿，句落云间万井传。\n佳节敢辞通夕醉，宿酲还傍小窗眠。\n鬓边黄菊应相笑，白发较多似去年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28359,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日诸人集于资福阁次高季应韵三首 其一","author":"林季仲","text":"秋入江山晚更妍，登高临远意凄然。\n且浮绿蚁眼前乐，底用虚名身后传。\n旧隐未教幽鹤怨，清溪终伴白鸥眠。\n老来举措多羞涩，强插黄花趁少年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28360,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"又用前韵二首 其二","author":"林季仲","text":"遗迹榛芜四十年，使君跋马独依然。\n要将旧观还骚客，幻出新亭倚半天。\n井邑参差图障里，烟霞明灭酒尊前。\n我今不是贫居士，买断江山莫计钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28361,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"又用前韵二首 其一","author":"林季仲","text":"雕甍华栋照晴空，更忆檐前十八公。\n四望川流何富有，一时歌咏许谁同。\n海吞万壑苍烟外，地涌双峰白浪中。\n洞接仙都春色早，桃花认得鹤溪翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28362,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三椽休斧陈开祖有诗次韵","author":"林季仲","text":"经营草舍得能难，甫及斜川八九间。\n傍砌更移墙后竹，钩帘独盼雨馀山。\n月投窗隙如相觅，云过檐端却复还。\n长忆少陵规画远，要令寒士总欢颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28363,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中秋次韵","author":"林季仲","text":"一叶下庭木，初敲窗户秋。\n阴云偏妒月，衰病懒登楼。\n勋业头先白，江河泪未收。\n停桡是吾土，休梦野堂游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28364,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乐寿阁","author":"林季仲","text":"看山玩水适吾情，此语从来误后生。\n唤起万端因好乐，静观一理本圆成。\n与人不竞春长在，对物无心境自清。\n更就阿谁求乐寿，当时分付最分明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28365,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"卢守携酒过薛直老草堂次韵","author":"林季仲","text":"画戟森森转水湄，草堂颜色带恩私。\n乱离海上多簪绂，槃礴风前卸马羁。\n醉帽半敧花近眼，赓歌间发墨翻池。\n诸公明日朝天去，且为南阳借杜诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28366,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用前韵酬高仲贻见赠","author":"林季仲","text":"杖藜谷口伫归云，生理萧条一葛巾。\n未敢轩眉焚芰制，更期晚节伴霜筠。\n江山约我盟犹在，风月于人意自新。\n木落寒林水清浅，小桥共看雪梅春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28367,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次前韵","author":"林季仲","text":"野性由来爱水云，强将麋鹿著冠巾。\n救时或用鲁连子，谈古空如司马筠。\n胡雁惊心双泪落，吴霜点鬓二毛新。\n腐儒无用终羞死，只合归耕垄上春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28368,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次前韵书怀","author":"林季仲","text":"两眼昏花近十年，简编惟见字斑斑。\n养生正合师黄石，招隐宁须待小山。\n薄宦本无朱组愿，高眠得伴白云閒。\n清风却似怜孤寂，时送禽声到枕间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28369,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次前韵酬赵宝学","author":"林季仲","text":"佳章一见一开颜，读向寒窗到日斑。\n笔阵知公来似雨，诗肩笑我耸如山。\n皂雕气欲凌千里，老骥身犹绊六闲。\n闻说汉庭思祭酒，诏书相继促河间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28370,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"州将设宴诸荐士","author":"林季仲","text":"化蜀文翁竟好文，坐令风物一番新。\n争飞方朔三千牍，何止平原十九人。\n棫朴伫观周室富，茅芹先傍鲁宫春。\n使君劝驾无多语，莫学公孙只为身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28371,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"早春有怀","author":"林季仲","text":"青春无语到天涯，百舌枝头漫自誇。\n红破轻寒入桃萼，香和宿雨落梅花。\n风吹杖屦千山晚，水照林塘两鬓华。\n万事萧条兵革里，北飞愁见雁行斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28372,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次高季应韵","author":"林季仲","text":"杖屦相从秋水滨，便将公作社中人。\n酒行苦要深浮白，醉去那知倒著巾。\n把手共怜江国月，回头休忆野堂春。\n太平未见身先老，看取吴霜点鬓新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28373,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次高承宣韵题刘知言郊居","author":"林季仲","text":"荷锄归伴陇头云，懒傍侯门更整巾。\n卜筑君能如沈约，题诗吾亦效王筠。\n湖光皛皛千山合，竹色娟娟一径新。\n酒后笑歌应耳热，西园惊破海棠春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28374,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次曾谹甫韵寄贺子忱","author":"林季仲","text":"狂客当年隐四明，至今孙子爱林坰。\n挂冠无愠亦无喜，抱膝自歌还自听。\n时弄清琴怀贺若，何妨后乘载樵青。\n结邻能践前言否，春色方深绝境亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28375,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵刘敷言咏梅四首 其四","author":"林季仲","text":"霜清木脱峭寒侵，惊见佳花吐远林。\n冷落自怜池上影，孤高谁赏月边心。\n简文剪綵谈何易，杜老巡檐意最深。\n寂寂溪桥断行迹，吹香独与我追寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28376,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵刘敷言咏梅四首 其三","author":"林季仲","text":"粉痕欲破雪相禁，如妒孤英点暮林。\n九陌未传花底信，一枝先寄陇头心。\n月横瘦影池塘浅，风度微香院落深。\n插向鬓边犹得在，未须笑我老浸寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28377,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵刘敷言咏梅四首 其二","author":"林季仲","text":"江空木落出遥岑，何处佳人独倚林。\n不负雪期如有信，偶先花事本无心。\n日低修渚云容薄，路转寒塘暝色深。\n莫怪山翁数回首，暗香十里更相寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28378,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵刘敷言咏梅四首 其一","author":"林季仲","text":"梅花笑我无佳句，惭愧诗翁亦姓林。\n细看窗前陨秋叶，谁知雪底得春心。\n断桥斜径光将夕，淡月疏云趣更深。\n何处清香恼行客，江头跋马试教寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28379,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵吴清叟书怀","author":"林季仲","text":"误落樊笼二十年，苍颜白发意颓然。\n解纷无用空弹铗，揣分唯堪备执鞭。\n乘雁去来何足数，涸鱼濡沫自相怜。\n扁舟东下虽云晚，及见梅花破腊前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28380,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵宋待制晚春书怀","author":"林季仲","text":"春事何曾解有穷，枝头寻觅漫匆匆。\n去来燕认谁家户，开落花因一夜风。\n万古英雄残照里，半生勋业醉魂中。\n骚人往往多诗瘦，却怪老夫颜色红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28381,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵希父见寄二首 其二","author":"林季仲","text":"腊前墙角见梅花，雪后墙头见月华。\n满引浊醪无一事，尽收好处入吾家。\n结庐君待归安固，抱瓮侬今老永嘉。\n莫道青山便遮断，春风浩荡没津涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28382,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵希父见寄二首 其一","author":"林季仲","text":"晚窗落莫雪飞花，点缀山翁两鬓华。\n好办青铜买村酒，共撑小艇访渔家。\n觉非便合如陶令，得趣何劳问孟嘉。\n只怕故人腾踏去，短檠谁与话天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28383,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵张子猷赋凯旋之什","author":"林季仲","text":"十万貔貅拥鼓鞞，云间听得一声齐。\n祥开虎帐妖氛落，威叠鲸江怒浪低。\n晓日彩旌沙外转，春风归马柳边嘶。\n幕中自有燕公笔，合把奇功勒建溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28384,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵沈叔权书怀","author":"林季仲","text":"忽思身世怆然惊，漫学雕龙艺未成。\n尸素空糜太仓粟，辛勤有愧老农耕。\n只须鬓上看勋业，休向人前道姓名。\n岁晚相从白岩下，一樽芳酒话深情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28385,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵陈明锡见寄 其三","author":"林季仲","text":"卑栖安故里，薄宦倦他邦。\n依社愿为栎，涤牲宁用庞。\n利名蛾赴烛，身世蚁浮缸。\n多谢江边月，相寻到小窗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28386,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵陈明锡见寄 其一","author":"林季仲","text":"一别从京洛，相逢向海邦。\n倦游怜舌在，多病觉眉庞。\n佳处随山屐，馀生付酒缸。\n新诗眩老眼，细读傍寒窗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28387,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵陈明锡见寄 其二","author":"林季仲","text":"合去趋华阙，难教滞陋邦。\n悲鸣怜老骥，迎吠厄群庞。\n便腹书千箧，濡头酒一缸。\n怀君夜不寐，落叶打空窗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28388,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵和康丈真率之集","author":"林季仲","text":"行步敧危老病身，胜游那敢厕荀陈。\n试思珠履三千客，何似风雩六七人。\n雪意迟疑终未决，诗筒来往莫辞频。\n晓窗新得东君讯，已放梅梢一点春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28389,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵和康侍郎游仙岩","author":"林季仲","text":"林峦争入马蹄来，宿雾残云拨不开。\n石卧松根横碧玉，瀑悬天外转晴雷。\n仙家长锁青春好，老子犹堪竟日陪。\n收拾此身知有所，一间茅屋傍山隈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28390,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵林楙南见寄 其二","author":"林季仲","text":"阴阴松竹满东山，闻说君家六月寒。\n若得封胡同里巷，底须屈宋作衙官。\n酒中有趣谁能识，琴上无弦我亦弹。\n试问庐江何彦德，貂蝉孰似鹿皮冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28391,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵林楙南见寄 其一","author":"林季仲","text":"转首今吾非故吾，问君何用惜居诸。\n流年已作悠悠梦，往事徒劳咄咄书。\n浊酒半壶时自酌，醉头一月不曾梳。\n阿谁似我浑无事，睡到日高三丈馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28392,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵赵表之郊行","author":"林季仲","text":"看取吴霜点鬓新，利名场里合抽身。\n去从宦路谋多拙，归伴田夫味最真。\n落木正饶窗外月，小梅犹靳腊前春。\n他时更有郊行句，远寄臞溪独卧人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28393,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵追和钱穆父内翰协赵伯坚大卿令铄游颍湖呈正字宝学即伯坚子也","author":"林季仲","text":"颍水如闻得月多，黄金万顷漾微波。\n登临未送平生目，赓唱空传故老歌。\n宦意请看头上雪，杯行且覆掌中荷。\n吾乡亦有西湖好，舴艋相从意若何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28394,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵康侍郎咏雪","author":"林季仲","text":"天公昨夜醉如泥，擘碎浮云散漫飞。\n谢女饶他歌柳絮，曹人堪笑比麻衣。\n平铺宝贝知何限，豫表丰祥不待祈。\n最是松林难画处，晚晴犹吐玉霏霏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28395,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵梁守登富览亭 其二","author":"林季仲","text":"绛人老矣休问年，万事灰心宁复然。\n有客雅知林下趣，怜渠独得酒中天。\n摩空雁影沈波底，照眼梅花破腊前。\n雪意方浓君且住，行歌同挂杖头钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28396,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵梁守登富览亭 其一","author":"林季仲","text":"朝来爽气自横空，蹑屐宁须学谢公。\n似此江山何处有，合分风月与人同。\n消磨万古潮声里，摇兀千林酒浪中。\n欲和阳春无好语，尊前莫笑嗫嚅翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28397,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵萧德起见寄","author":"林季仲","text":"漫求三釜禄，浪走十年尘。\n白发不饶我，虚名能中人。\n溪山閒始见，鱼鸟静相亲。\n共对一庭月，谁非吾近邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28398,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵婺州萧教授见寄","author":"林季仲","text":"不到双溪久，浑疑一梦间。\n把君诗在手，见我别来山。\n薄宦故不恶，危涂难自閒。\n翩翩出林翼，飞倦合知还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28399,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵酬刘延仲","author":"林季仲","text":"门翳蒿莱谁往还，忆君更觉鬓毛斑。\n何时共对吟边月，相别犹怜雪后山。\n清夜忍闻庭鹤怨，馀年应伴海鸥閒。\n有人问我今何似，兀兀长如醉梦间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28400,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵酬赵宝学","author":"林季仲","text":"高轩曾过我柴关，笑看莓苔满地斑。\n隐约谁怜许居士，风流得倚谢东山。\n诗锵金石音尤古，笔走龙蛇意自閒。\n后日陪公那可得，飘然身在五云间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28401,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"许厚之挽词","author":"林季仲","text":"跋马西州路，山川泪眼傍。\n看君有遗范，如我见横塘。\n寒日低瓜步，浮云接建康。\n隔江多少恨，付与雁南翔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28402,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"沈朝议挽词","author":"林季仲","text":"擢第繇元祐，封侯迨绍兴。\n旷怀初不竞，薄俗漫多能。\n勋业一壶酒，交游八尺藤。\n诸生话乡老，挥泪湿寒灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28403,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"迎华观落成苏侍郎赋诗次韵","author":"林季仲","text":"乱山争挟我先登，拭眼还惊见未曾。\n不为游观事斤筑，可怜撑拄费薪蒸。\n竹依窗牖秋鸣玉，月堕樽罍夜饮冰。\n说与溪船莫吹笛，断肠人在最高层。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28404,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陈升仲挽词","author":"林季仲","text":"莫叹交情大署门，交情如子复何云。\n友恭便是能为学，朴讷由来自少文。\n曾解绨袍怜范叔，当留宝剑报徐君。\n雪梅时节尤相忆，长话平生到夜分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28405,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"周希父见寄次韵","author":"林季仲","text":"松菊荒三径，风尘走十年。\n家山忆到骨，世路厌摩肩。\n懒计诗工拙，宁分酒圣贤。\n从他诮便腹，老去只贪眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28406,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"周希父赋梅次韵三首 其三","author":"林季仲","text":"岁寒谁复慰栖迟，篱落初横一二枝。\n试问春从何处去，又凭梅报有来期。\n巡檐索笑如相识，倚竹怀新却自悲。\n花瘦恼教人共瘦，月明风定酒醒时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28407,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]