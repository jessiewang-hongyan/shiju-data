[{"title":"歌一首","author":"谯宝","text":"使君来兮父母鞠我，礼化行兮民无寒饿。\n使君去兮不可复留，人意伥伥兮泪双堕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41624,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送程给事知越州","author":"王诲","text":"清班经岁侍凝旒，宠寄稽山第一州。\n琐闼风规丹扆侧，蓬莱烟霭碧江头。\n诗豪谁敢雷门过，乡老争陪昼锦游。\n行路光华浮画鹢，浩然佳思鉴湖秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41625,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"听琴","author":"岑宗旦","text":"琴中太古意，方外无为心。\n弹之道颇散，不弹理弥深。\n所以陶元亮，何须弦上音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41626,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈七首 其一","author":"释守端","text":"鸟有双翼，飞无远近。\n首出一隅，行无前后。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41627,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈七首 其四","author":"释守端","text":"佛身充满于法界，普现一切群生前。\n随缘赴感靡不周，而常处此菩提座。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41628,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈七首 其五","author":"释守端","text":"他人住处我不住，他人行处我不行。\n不是为人难共聚，大都缁素要分明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41629,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈七首 其六","author":"释守端","text":"诸人法眼藏，千圣莫能当。\n为君通一线，光辉满大唐。\n须弥走入海，六月降严霜。\n法华虽恁道，无句得商量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41630,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈七首 其七","author":"释守端","text":"丝毫有趣皆能进，毕竟无归若可当。\n逐日退身行兴尽，忽然得见本爷娘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41631,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答郭祥正居士","author":"释守端","text":"藏身不用缩头，敛迹何须收脚。\n金乌半夜辽天，玉免赶他不著。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41632,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"为郭功甫偈 其一","author":"释守端","text":"牛来山中，水足草足。\n牛出山去，东触西触。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41633,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"为郭功甫偈 其二","author":"释守端","text":"上大人，丘乙己。\n化三千，可知礼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41634,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"释守端","text":"一文大光钱，买得个油糍。\n吃放肚里了，当下便不饥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41635,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"北斗藏身因缘偈","author":"释守端","text":"九衢公子游花惯，未第贫儒感慨多。\n冷地看他人富贵，等闲无奈幞头何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41636,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蝇子透窗偈","author":"释守端","text":"为爱寻光纸上钻，不能透处几多般。\n忽然撞著来时路，始觉平生被眼瞒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41637,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"释守端","text":"异乡风俗客不恶，但欲南音来耳边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41638,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"释守端","text":"不似大梅老，贪随鼯鼠声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41639,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈八首 其一","author":"释仁勇","text":"秋风凉，松韵长。\n未归客，思故乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41640,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈八首 其三","author":"释仁勇","text":"古人底今人用，今人底古人为。\n古今无背面，今古几人知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41641,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈八首 其四","author":"释仁勇","text":"有手脚，无背面。\n明眼人，看不见。\n天左旋，地右转。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41642,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈八首 其五","author":"释仁勇","text":"风鸣条，雨破块，晓来枕上莺声碎。\n虾䗫蚯蚓一时鸣，妙德空生都不会。\n都不会，三个成群，四个作队。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41643,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈八首 其六","author":"释仁勇","text":"有个汉，怪复丑。\n眼直鼻蓝镵面，南看北斗。\n解使日午金乌啼，夜斗铁牛吼。\n天地旋，山河走。\n羽族毛群，失其所守。\n直得文殊普贤出此没彼，七纵八横，千生万受。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41644,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈八首 其七","author":"释仁勇","text":"大方无外，大圆无内。\n无内无外，圣凡普会。\n瓦砾生光，须弥粉碎。\n无量法门，百千三昧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41645,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈八首 其八","author":"释仁勇","text":"真相无形，示形现相。\n千怪万状，自此而彰。\n喜则满面光生，怒则双眉陡竖。\n非凡非圣，或是或非。\n人不可量，天莫能测。\n直下搆得，未称丈夫。\n唤不回头，且莫错怪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41646,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送程给事知越州","author":"黄君俞","text":"夕郎清贯籍殊材，曾宠南州刺史回。\n通职更联群玉府，分符仍得小蓬莱。\n民间威爱龚黄政，笔下文章李杜才。\n天子鼎新天下法，和羹方是用盐梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41647,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"王文淑","text":"草草杯盘供语笑，昏昏灯火话平生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41648,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"祠南海神","author":"陈之方","text":"汤汤南溟，百川所潴。\n有赫其灵，有严其居。\n神宅于幽，诚格者应。\n其应维何，皇帝仁圣。\n幢旄鼓铙，畴往祇祠。\n揭揭程公，神之听之。\n祀事之既，神明欢喜。\n飙驰龙翔，一息万里。\n衍涸濡焦，既盈既优。\n庙社亿年，血食均休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41649,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送程给事知越州","author":"陈睦","text":"孔戣佳政在番禺，严助终年厌直庐。\n欲解尘缨临曲水，忽惊计吏拜高车。\n行归天上参鹓侣，暂向江边驻隼旟。\n正想题诗凭郡阁，秋波绿净落芙蕖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41650,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题东老庵","author":"陈睦","text":"忆昔曾来访隐沦，潇然云水隔凡尘。\n画船祇载溪中月，白酒长添座上春。\n昼掩山扉无俗客，夜吟石鼎有高人。\n飘飘洒落青衫子，共话平生泪满巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41651,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"临终偈","author":"源禅师","text":"雪鬓霜髭九九年，半肩毳衲尽诸缘。\n廓然笑指浮云散，玉兔流光照大千。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41652,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈五首 其一","author":"释悟真","text":"师子儿哮吼，龙马驹絙跳。\n古佛镜中明，三山孤月皎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41653,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈五首 其四","author":"释悟真","text":"寂照常照本来照，草鞋底下常絙跳。\n更会针锋上须弥，眉毛中水常渺渺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41654,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈五首 其五","author":"释悟真","text":"手提巴鼻脚踏尾，仰面看天听流水。\n天明送出路傍边，夜静还归茅屋里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41655,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"释真净","text":"二十馀年用意猜，几番曾把此心灰。\n而今潦倒逢知己，李白元来是秀才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41656,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送程给事知越州","author":"曾孝宽","text":"承明厌直怀乡日，适得当年严助州。\n况是北归持节倦，喜闻东去典城优。\n长江风月消残暑，故国莼鲈近早秋。\n遥想下车民讼简，不妨乘兴剡溪游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41657,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"史院席上奉和首相吴公元韵","author":"曾孝宽","text":"御府颁醇酿，君恩锡馂馀。\n赐筵遵故事，紬史重新书。\n燕饮难偕此，风流不伟欤。\n素餐非所职，愧附相君车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41658,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送程给事知越州","author":"章衡","text":"雅留威爱在南昌，又拜新恩指旧棠。\n一节帝颁严使旆，十州人喜拥壶浆。\n彯缨自结凝旒眷，揽辔思澄插笔乡。\n刘晏有材将大用，豫章楼上急飞觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41659,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南禅师圆寂日偈二首 其一","author":"释祖心","text":"去年三月十有七，一夜春风撼筹室。\n三角麒麟入海中，空馀片月波心出。\n真不掩伪，曲不藏直。\n谁人为和雪中吟，万古知音是今日。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41660,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南禅师圆寂日偈二首 其二","author":"释祖心","text":"昔人去时是今日，今日依前人不来。\n今既不来昔不往，白云流水空悠哉。\n谁云秤尺平，直中还有曲。\n谁云物理齐，种麻还得粟。\n可怜驰逐天下人，六六元来三十六。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41661,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送吴恂","author":"释祖心","text":"海门山崄绝行踪，踏断牢关信已通。\n自有太平基业在，不论南北与西东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41662,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初退黄龙院作","author":"释祖心","text":"不住唐朝寺，闲为宋地僧。\n生涯三事衲，故旧一枝藤。\n乞食随缘过，逢山任意登。\n相逢莫相笑，不是岭南能。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41663,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈三首 其一","author":"释克文","text":"云门抽顾，自有来由。\n一点不到，休休休休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41664,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈三首 其二","author":"释克文","text":"先师昔住金轮日，有偈君家结净缘。\n我住金轮还有偈，却应留与子孙传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41665,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈三首 其三","author":"释克文","text":"佛性天真事，谁云别有师。\n罔明弹指处，女子出禅时。\n不费纤毫力，何曾动所思。\n众生总平等，日用自多疑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41666,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"遗偈","author":"释克文","text":"今年七十八，四大相离别。\n火风既分散，临行休更说。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41667,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"释克文","text":"诸佛出身处，东山水上行。\n目前一弹指，变现自分明。\n日面月面过，佛手驴脚呈。\n皆承此恩力，言外度迷情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41668,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"吊黄龙和尚塔","author":"释克文","text":"示灭师何速，空遗塔此中。\n僧闲四海锡，谁复九年风。\n鸟外千峰绕，人间一径通。\n寥寥朝与暮，唯有白云同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41669,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"云鹤","author":"释克文","text":"旦过晚应宿，山堂任去留。\n孤云能自在，只鹤更优游。\n楖栗开青眼，袈裟伴白头。\n未明西祖意，萍迹谩悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41670,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈四首 其一","author":"释守智","text":"紧峭离水靴，踏破湖湘月。\n手把铁蒺藜，打碎龙虎穴。\n翻身倒上树，始见无生灭。\n却笑老瞿昙，弹指超弥勒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41671,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈四首 其二","author":"释守智","text":"昨日高山看钓鱼，步行骑马失却驴。\n有人拾得骆驼去，重赏千金一也无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41672,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈四首 其三","author":"释守智","text":"不离当处常湛然，觅即知君不可见。\n虽然先圣恁么道，且作个模子搭却。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41673,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈四首 其四","author":"释守智","text":"法门不幸法幢摧，五蕴山中化作灰。\n昨夜泥牛通一线，黄龙从此入轮回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41674,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题清辉堂","author":"刘宗孟","text":"曙光伦紫翠，秋气莫争青。\n山近岚同润，堂虚日共生。\n断霞云去接，夕照月来迎。\n翻想鲛人室，珠盘亦让明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41675,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"刘宗孟","text":"万山攒地窄，四气得春偏。\n分野侵秦壤，星河共楚天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41676,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"刘宗孟","text":"气润梅蒸雨，阴浓柳郁烟。\n夏深卢橘熟，花尽海棠妍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41677,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"俞仲昌","text":"白云来去本无踪，占定仙山四六峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41678,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠俞仲昌","author":"李某","text":"家对南山第一峰，谁知大隐隐松蓬。\n閒身悟道持心得，俗事随缘见性通。\n门外高居无俗客，箧中灵药是阴功。\n年来更喜儿孙盛，俊笔香名绍素风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41679,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"澹山岩","author":"尹瞻","text":"岌嶪元化精，崭岩大块坼。\n骇若盘古时，呀然巨灵擘。\n状怪呕风雷，势邈吞山泽。\n寒暑中外分，居僧甘窟宅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41680,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"火星岩","author":"尹瞻","text":"郡古时和诤讼销，使君乘兴忽相招。\n画船载妓游岩寺，红旆摇风过野桥。\n就石开樽偎树脚，拨云策杖上山腰。\n鸣驺未许归城去，更望寒林隔□遥。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41681,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"邱与权","text":"念往曾高枕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41682,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜宿垂虹亭舟中有感而作","author":"庞元英","text":"离家无数里，客思便侵凌。\n久拨炉无力，频翻被有棱。\n孤蟾如得伴，哀雁拟伤矰。\n怪底寒清冽，推篷露气凝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41683,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"集句 其一","author":"胡归仁","text":"一第知何日，无端意不移。\n欲为青桂主，谁与白云期。\n傍架齐书帙，翻瓢作酒卮。\n文明终有托，休把运行推。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41684,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"集句 其二","author":"胡归仁","text":"白沙溪绕白云堆，但有何人把酒杯。\n专慕圣贤知志气，可怜谈笑出尘埃。\n碧山终日思无尽，清世难群好自猜。\n风满老松门昼掩，可怜高尚仰天才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41685,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题传舍","author":"张唐英","text":"先帝昭陵土未乾，又闻永厚葬衣冠。\n小臣有泪皆成血，忍向东风看牡丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41686,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈一首","author":"张唐英","text":"言生本不生，言灭本不灭。\n觉路自分明，勿与迷者说。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41687,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"张唐英","text":"西掖词臣旧处游，南隆隐客敞庐幽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41688,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南涧月夕","author":"俞紫芝","text":"华发念秋晚，青灯怜夜长。\n香团菊花露，寒著橘林霜。\n月在北窗底，人行南涧傍。\n婆娑不知去，身世两相忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41689,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"岁杪山中","author":"俞紫芝","text":"石乱云深客到稀，鹤和残雪在高枝。\n小轩日午贪浓睡，门外春风过不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41690,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿蒋山栖霞寺","author":"俞紫芝","text":"独坐清谈久亦劳，碧松燃火暖衾袍。\n夜深童子唤不起，猛虎一声山月高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41691,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山中琴兴","author":"俞紫芝","text":"野客调琴玉一枝，薰风滋味自家知。\n夜深断送鹤先睡，弹到山空月落时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41692,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"无题","author":"俞紫芝","text":"深深尽陌倚朱门，腮粉轻红湿泪痕。\n寂寞绣屏人未见，杏花疏雨立黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41693,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"口占","author":"俞紫芝","text":"相君高卧朝天阙，立损阶前白玉麟。\n此去定生狮子国，却来重载法王身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41694,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"松风","author":"俞紫芝","text":"万壑摇苍烟，百滩度流水。\n下有骑驴人，萧萧吹冻耳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41695,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戏作","author":"俞紫芝","text":"郁郁襟怀怨别离，凤楼西角正斜晖。\n洞房风细春华暖，落尽碧桃人未归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41696,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄杜宣卿长官","author":"俞紫芝","text":"长忆逢君历水隅，坐中谈笑见醇儒。\n当年许我入诗社，别后有谁为酒徒。\n头想白如潘骑省，家应贫似范莱芜。\n相思不可能相得，蝉老西风海树枯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41697,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋阁晨兴","author":"俞紫芝","text":"远寺一声钟，檐楹惊宿鸟。\n拂衣风露清，月落千山晓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41698,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"冬日","author":"俞紫芝","text":"茆舍竹篱短，梅花吐未齐。\n晚来溪径侧，雪压小桥低。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41699,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]