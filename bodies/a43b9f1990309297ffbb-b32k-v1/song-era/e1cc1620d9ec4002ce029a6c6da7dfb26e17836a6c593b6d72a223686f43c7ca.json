[{"title":"横山寺楞伽塔诗 其二","author":"周南","text":"姑苏台畔千年土，斸作牛羊出没行。\n惟有江山怀故国，五湖犹绕越东城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25484,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"横山寺楞伽塔诗 其三","author":"周南","text":"吴越台池大业城，如今花鸟故时春。\n思量却是楞伽塔，曾见苏州六代人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25485,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"横山寺楞伽塔诗 其一","author":"周南","text":"白傅游春得几回，寺门还对海门开。\n行人莫问横山塔，曾见开皇混一来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25486,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠上人","author":"周南","text":"上人梦里营诗思，比似看经僧更忙。\n包山寺里秋晴后，霜未浓时橘正香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25487,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乙卯之秋送项秘书倅池阳是时教官之阙尚在来春","author":"周南","text":"诸老纷纷去不留，之人也作翠微游。\n要看绿字封苍藓，须趁黄花插满头。\n秋水隔人犹有恨，春山得伴更何求。\n九华楼上新风月，不学诗人赋隐忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25488,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日祁城外","author":"周南","text":"清晨驱马出重闉，渐有狂花似小春。\n草市丰年声泄泄，官河霁色水粼粼。\n山林送老无予罪，物色愁人逐岁新。\n便拟移家去城郭，可无萸菊慰慈亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25489,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"入梅","author":"周南","text":"地湿衣生醭，天凉葛未裁。\n暴暄偏坏药，微洒似成梅。\n苦笋相将尽，良朋久不来。\n若无书作伴，那得好怀开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25490,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十月十日立冬","author":"周南","text":"立冬前一夕，聒地起寒风。\n律吕看交会，衣裳出褚中。\n骭疡时作尰，怀抱岁将终。\n汗手污牙笔，晴檐共秃翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25491,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居晚步 其二","author":"周南","text":"步担腰镰急，平畴沥稻稀。\n水云漫白道，烓灶起青霏。\n缝塔随烟暝，巢乌择木飞。\n年丰閒正少，乘屋匠人归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25492,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居晚步 其一","author":"周南","text":"蔬肠消谷暖，拄杖出林深。\n犊背斜阳在，蛩声暮气侵。\n岗峦舒伏脉，松菊会归心。\n墟落函寒早，山曛日未沉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25493,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"太平州陈大监挽章 其二","author":"周南","text":"人称扁画更传诗，飞到青冥却自迟。\n今代人门能有几，伤心年寿遽如斯。\n百年乔木虬枝在，千里棠阴晓角悲。\n日暮佳城春草碧，生刍遥奠野人卮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25494,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"太平州陈大监挽章 其一","author":"周南","text":"老去无成久索居，尚能林下听除书。\n百年门地推鸿绪，三月春江照隼旟。\n云路脩程惊折轴，昔游风谊记回车。\n绿阴春草佳城暮，无计亲陈野客蔬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25495,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丘都督枢密挽章 其一","author":"周南","text":"曩时威凤览辉初，独对丹霄耸万夫。\n千载阜陵嗟见晚，百年乔木有神扶。\n只将囊底安江左，不见天中运斗枢。\n圣主恩深臣命薄，悔今强敌尚逋诛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25496,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丘都督枢密挽章 其二","author":"周南","text":"淮水尘清小使归，坏梁俄叹哲人萎。\n江山收泪还风景，草木知名怖鼓旗。\n生惜勋庸专管葛，死馀忠信压边陲。\n南州十月停砧杵，料得闻丧处处悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25497,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"石湖","author":"周南","text":"作者看胸臆，泠然接大荒。\n云溪收浩荡，海观度沧凉。\n故国馀丘壑，春船落艳阳。\n百年看俯仰，越燕又空梁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25498,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"示子","author":"周南","text":"编轴初黏饰，窗堂略净蠲。\n师前无脱履，弟幼与随肩。\n苦柰休多食，精絺不耐撋。\n迟明吾语汝，欲睡更来前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25499,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同年葛签挽章 其一","author":"周南","text":"杏园张饮上晴湖，忆在团司识面初。\n二纪年光何忽忽，五更春梦已蘧蘧。\n彯缨曾识飞凫舄，折狱争驰荐鹗书。\n可惜佳城萦蔓草，只教绿水泛红蕖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25500,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同年葛签挽章 其二","author":"周南","text":"少年并马曲江游，曾到慈恩塔上头。\n过眼流光真露电，惊心宦海半沉浮。\n君今又隔重泉梦，世事嗟伤逝水流。\n独立东风数华发，不堪春草起离愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25501,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岁杪送同官趋朝","author":"周南","text":"异县飘零兴已阑，更来楼上说加餐。\n不知壮日消磨已，也似中年赋别难。\n酒尽沙头悲夜永，书来日脚是春残。\n人生涂辙嗟何限，好在分携恰岁寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25502,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"扫地","author":"周南","text":"滑几悬游气，磨砖出寸光。\n及时须敝帚，措影见胡床。\n拱揖延书入，澄收得虑庄。\n苍头拥箕袂，持礼老夫旁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25503,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过田家","author":"周南","text":"得麦儿今喜，无梅雨又愆。\n翁身今七十，眼见几般年。\n连年增口数，再世种人田。\n机上畸零绢，今当数百钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25504,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过虎丘 其二","author":"周南","text":"狐埋狐搰已无成，春去春来几度登。\n海涌名山真幻出，酒酣看剑已尘凝。\n鸥陂人远台空在，莺谷声残鸟倦应。\n越绝兴亡俱一梦，为君同吊剡溪藤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25505,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过虎丘 其一","author":"周南","text":"勾吴霸业竟谁成，留得崇丘岁一登。\n玉雁已随黄壤尽，铁花空向碧潭凝。\n空中有塔掀铃语，台上无僧唤石应。\n踏尽苍苔春老去，但馀落日与寒藤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25506,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀友人赵蹈中 其一","author":"周南","text":"妙质端能劲，除官正尔迟。\n和歌谁与共，掺别可无饥。\n俗学訾豪夺，家人怨绝痴。\n相看又秋暮，未敢叹余衰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25507,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀友人赵蹈中 其二","author":"周南","text":"虚想怜神怒，端颐护暑侵。\n父兄宽众责，寝饭验初心。\n夜气收肝膈，晨窗得笑吟。\n生年推我长，蓺殖可能深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25508,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泛舟游虎丘","author":"周南","text":"水绕朱门宿海槎，山沉海月上晨霞。\n鸟啼烟树雨初歇，钟度云楣日未斜。\n僧俯剑池看贝叶，人追寒食衮杨花。\n西子年侵丘谷换，女墙还有旧宫鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25509,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"驱傩","author":"周南","text":"高明纾鬼责，奥渫费谁何。\n儿女今无恙，街坊又进傩。\n流年荧惑过，队仗史巫多。\n求福吾能记，门前不用呵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25510,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"刮釜","author":"周南","text":"刮釜嗟邻母，经旬值湿薪。\n煎磨知物性，丰大转民贫。\n康食心知愧，哀嚣听颇亲。\n稻花伤昼雨，愁杀看书人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25511,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和史君喜雨 其一","author":"周南","text":"通宵奠玉乞移灾，阊阖天门午夜开。\n屏翳不随风伯住，雷车争逐阿香来。\n送神曲奏争加额，喜雨诗成巧夺胎。\n闻说阪田犹未插，更须精意斡天回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25512,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和史君喜雨 其二","author":"周南","text":"蚕筐无叶不成眠，眯眼黄沙障麦天。\n谁遣炉烟生湿雾，立翻江水沃桑田。\n雹飞邻壤同时事，春入民襦赖吏贤。\n欲把丰年占覆斗，寸心应向碧霄悬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25513,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉问座主丘侍郎 其一","author":"周南","text":"早岁虚仁鉴，频年阔素书。\n斯文谁后死，甲子正安居。\n公馆初阳动，江沙海气淤。\n近传肝液少，岁晚更何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25514,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉问座主丘侍郎 其二","author":"周南","text":"故老凄其甚，嗟余尚庶几。\n勋庸迟琬琰，顾盼有晶威。\n伯氏供为子，诸生记摄衣。\n凄凉葑菲恨，图得诲言归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25515,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"姑苏台","author":"周南","text":"辍杵馀千祀，丛台此旧都。\n冰花销窳瓦，组练入瀰湖。\n浩荡春风在，荒亡霸业芜。\n往来吴父老，藉草话城郛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25516,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"孟良甫别一岁无书有怀寄之","author":"周南","text":"孟氏好兄弟，相从邻巷居。\n一穷吾得忍，千里意何如。\n夜雨看僵仆，家儿不詈予。\n丰年民瘼少，莫厌故人书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25517,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"庭燎","author":"周南","text":"种发看如约，松明又送寒。\n颇哀黧老健，慨我穫薪乾。\n小市街声沸，明河小雾漫。\n卖痴儿女唤，更作夜来看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25518,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日即事","author":"周南","text":"料理清明天气催，搀先几日柁船开。\n六朝事往馀簪塔，百草春回上舞台。\n巢燕争迎华屋去，海潮犹傍故城来。\n主人两鬓千丝雪，更斸青冥出稚栽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25519,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"追送友人李季允归蜀三首并寄所怀 其三","author":"周南","text":"西州馀一老，六月上穷山。\n仲子何时到，三吴说鬓斑。\n土风添药费，圣代有生还。\n归梦商于近，音书报是间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25520,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"追送友人李季允归蜀三首并寄所怀 其一","author":"周南","text":"独往知心在，晨风忆缆开。\n江涛宽屡涉，山鬼讯重来。\n甲子悲麟去，林庐有雁回。\n赠言吾岂敢，遗药可无猜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25521,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"追送友人李季允归蜀三首并寄所怀 其二","author":"周南","text":"保终无智力，丽泽慨重湖。\n白水当门户，清秋送舳舻。\n他山藏实录，稚子狎长途。\n自古多零落，空悲永夜徂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25522,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送江陵牧次对贰卿","author":"周南","text":"梦断江湖绝寄声，不图犹见老成人。\n白头未觉相从晚，青眼何繇此会频。\n自古荆襄俱重镇，今公羊陆是前身。\n六千里地无非郢，宽著恩波浸远人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25523,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送邻守邂逅祭酒李公","author":"周南","text":"早作将吴守，临分御李侯。\n清醇瞻耇老，省素共晨羞。\n乡里终全活，人家更小留。\n腐儒疏懒意，白水看行舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25524,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送林潮州","author":"周南","text":"谁把科名误寘君，不教献纳近华勋。\n一麾暂远长安日，六月先清瘴海氛。\n马首喜无泷吏问，笔端应有鳄鱼文。\n明年胜日知无限，还记江东日暮云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25525,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送项倅 其二","author":"周南","text":"昨者搜贤诏下来，旌蒲纷遝起蒿莱。\n谁人肯厌承明直，我辈休污世俗埃。\n天近须回宣室召，时难倍怆渭城杯。\n殷勤为诵江湖句，少立斜阳舟未开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25526,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送项倅 其一","author":"周南","text":"衡岳山头唤下来，高人不肯住蓬莱。\n先秋手得平分月，当暑身无半点埃。\n世事相逢休挂口，吾侪一见且衔杯。\n夜阑约立银河表，阊阖天门次第开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25527,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻馆客病侵晓得小马亟归","author":"周南","text":"濛濛露气白，耿耿东方明。\n马捉步犹碎，乌营食又鸣。\n倏过黄岘岭，遥见阖闾城。\n欲问儿曹懒，前虞禄命轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25528,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"哭同年友冯校书 其二","author":"周南","text":"病父沈挛久，扶行未有孙。\n寡妻持酹酒，巴月旅归魂。\n摧落收威暑，兢危过峡门。\n铭旌今远近，到日败垣存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25529,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"哭同年友冯校书 其一","author":"周南","text":"叔常双骭骨，客死汉江中。\n忆昨烦忧甚，知吾友道穷。\n远游那知已，即愿得纯终。\n他日论巴产，东西有二冯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25530,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏中兄病关心复了一二小书稍凉薾然有白发坐念力衰而学晚慨然有感","author":"周南","text":"凉飔侵病榻，鬒发减玄膏。\n长得承亲健，宁辞煮药劳。\n书程贪昼永，心量怯年高。\n艾耋犹知礼，昏明在所操。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25531,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏日游太湖 其一","author":"周南","text":"荒莽残唐寺，前通霸越江。\n茭芦私井税，钟鼓助舂撞。\n大壑容渔户，残碑寄石幢。\n好山三四十，浮入两僧窗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25532,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏日游太湖 其二","author":"周南","text":"气逼梅天溽，衣沾溜雨篷。\n暗潮留地灢，阔水架天风。\n黯黑初星出，颠狂一瓠空。\n孙翁无片纸，说得五湖同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25533,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽秘撰赵郡运子固","author":"周南","text":"旧学虚蒙一字褒，暮年曾得拜江皋。\n丹砂雅意成前约，玩印连章避左曹。\n事业略曾随手见，死生应叹有身劳。\n只今蜕迹西林去，始得先生蚤退高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25534,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽耿侍郎","author":"周南","text":"给事初为畿县令，姓名直彻阜陵前。\n后来佩尽名藩印，死去家无数顷田。\n留与道涂歌长者，未调鼎铉合长年。\n龚黄只取优称去，更有云台论百篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25535,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读史","author":"周南","text":"条综都遗忘，翻收乱贮储。\n据梧甘抵滞，抚卷涉伸歔。\n老去从萤槁，昏来著茗祛。\n缅怀千载上，知读几年书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25536,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登阊阖城","author":"周南","text":"阊阖开城郭，东南见此州。\n尊安山体奠，柔静土田收。\n易野曾兴国，崩台早得秋。\n閒民无职事，力食愧锄耰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25537,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢友人见过","author":"周南","text":"岁暮寒风易中人，对床谁与话情真。\n平生知我无如子，此度相看又隔旬。\n世味惯看如嚼蜡，寒窗痴坐正痴尘。\n只今便拟高轩过，饮水毋嫌仲叔贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25538,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"阙题 其二","author":"周南","text":"天怜羁迹寄诸侯，差近危栏付与秋。\n风物捲帘都在眼，湖山如画恰当头。\n征鸿已作随阳计，社燕能为几日留。\n赖有楚天凉夜月，二年相伴上谯楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25539,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"阙题 其一","author":"周南","text":"天怜羁迹寄诸侯，付与危栏早得秋。\n相见便知悬榻意，阚亡时得挟书游。\n山容老去苍崖在，水潦痕存浅碧收。\n高我儒冠无用世，不应更蹑九华楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25540,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"余杜门兀坐三年壬申六月九日出吊平望归途阻风第四桥余曰是特偶相值尔不然岂造物者出门即相料理耶舟人曰然因识之","author":"周南","text":"地借沮龙宅，堤横海蜃楼。\n马蹄翻震雹，沙觜更生洲。\n云壑悬绳渡，天风激箭抽。\n湿霖平衍沃，暗井灭夫沟。\n蹴起争桥齿，撺来似海鳅。\n浪花将岸飐，塔影听桴浮。\n却忆衔枚地，曾驱缟练舟。\n谩云天设险，岂是水为柔。\n无事人千古，逃荣茗一瓯。\n川灵工阅世，翻覆几时休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25541,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"八月七日与吴沈二道人同过书坞时山堂初成","author":"周南","text":"暋阳收晶荧，清舫度林汇。\n坡陀认槿篱，屋角初涂塈。\n入门露荫竹，走鞭土为沸。\n橘栾尚小涩，菊柄已幽毅。\n少纾趺坐筋，渐出穹隙味。\n疏丛石贞瘦，密樾尘髣髴。\n成余独往愿，劳我慈亲费。\n亲年合几何，倏已近喜畏。\n我发白满把，晚食迟下胃。\n一岁能几来，每来时自慰。\n不雨已经旬，长道熠饥蜚。\n竹檐出山泉，草根坌土气。\n长愿居此劳，州里未为贵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25542,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"又题伍相庙","author":"周南","text":"废堞披榛旧，羁臣毕命心。\n江湖吞故壑，貌相匪斯今。\n激烈功名在，低徊岁月深。\n胥门沙衍浅，碑首未应沉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25543,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居","author":"周南","text":"燏火烧乌桕，敲冰煮石楠。\n烈风冬日夜，短褐野人庵。\n麦地宜秧谷，香栾记接柑。\n山中无槷具，日影渐移南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25544,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山家","author":"周南","text":"小麦连湖熟，黄梅作弹飞。\n穿林青犊过，触柁白鱼肥。\n子男输绢急，姑妇插秧归。\n枳花茶似雪，留客共湘瓷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25545,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"伍相庙","author":"周南","text":"封域依神保，遗哀记属镂。\n荒庭垂白露，古屋换爰乌。\n配食虚神果，除坛欠阖闾。\n向来存二庙，犹得慰三吴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25546,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"后过书坞夜坐","author":"周南","text":"下驾官桥黄岘东，二十五里名新丰。\n慈竹色如芦苇白，石楠顶结樱朱红。\n纸灰养火冬将尽，趺坐看书暖渐融。\n且蓄春雷归地底，放令晴雪满山中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25547,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈南安孟使君","author":"周南","text":"使君四十铜虎符，一矢曾识金仆姑。\n唐三百年进士举，不再鼓之终非夫。\n西风笼槐桂扶疏，笔势汹如涛江驱。\n知君三昧等游戏，我欲一言口嗫嚅。\n元凯登庸用谱系，稷契虽贤名第无。\n当时未有明光赋，致君大略到唐虞。\n君家六戟联椒涂，身无一点薰香污。\n颇疑膏粱逼寒畯，顾欲场屋争分铢。\n高山深林百年馀，大夏生殖雨露濡。\n其间吾疑有栝柏，根蟠拟作轮囷株。\n尚能尔雅注虫鱼，下同年少争得途。\n极知文章君之馀，何爱漏刻收桑榆。\n但疑入山见成鐻，可惜弹雀烦明珠。\n大夫当据要地居，仕宦须作执金吾。\n治经博士苟无命，不妨饿死同侏儒。\n君不见德裕生无不读书，死不肯与诸生俱。\n期君事业如韩吕，何嫌门地用崔卢。\n我尝一掷色得卢，盘中双陆万人呼。\n只今欲学支离疏，徒嗟七十战匈奴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25548,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]