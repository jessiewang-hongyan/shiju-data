[{"title":"富阳妙庭观董双成故宅，发地得丹鼎，覆以铜盘，承以琉璃盆，盆既破碎，丹亦为人争夺持去，今独盘鼎在耳，二首 其一","author":"苏轼","text":"人去山空鹤不归，丹亡鼎在世徒悲。\n可怜九转功成后，却把飞升乞内芝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75202,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"富阳妙庭观董双成故宅，发地得丹鼎，覆以铜盘，承以琉璃盆，盆既破碎，丹亦为人争夺持去，今独盘鼎在耳，二首 其二","author":"苏轼","text":"琉璃击碎走金丹，无复神光发旧坛。\n时有世人来舐鼎，欲随鸡犬事刘安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75203,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"新城道中二首 其一","author":"苏轼","text":"东风知我欲山行，吹断檐间积雨声。\n岭上晴云披絮帽，树头初日挂铜钲。\n野桃含笑竹篱短，溪柳自摇沙水清。\n西崦人家应最乐，煮芹烧笋饷春耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75204,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"新城道中二首 其二","author":"苏轼","text":"身世悠悠我此行，溪边委辔听溪声。\n散材畏见搜林斧，疲马思闻卷旆钲。\n细雨足时茶户喜，乱山深处长官清。\n人间岐路知多少，试向桑田问耦耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75205,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山村五绝 其一","author":"苏轼","text":"竹篱茅屋趁溪斜，春入山村处处花。\n无象太平还有象，孤烟起处是人家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75206,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山村五绝 其二","author":"苏轼","text":"烟雨濛濛鸡犬声，有生何处不安生。\n但令黄犊无人佩，布谷何劳也劝耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75207,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山村五绝 其三","author":"苏轼","text":"老翁七十自腰镰，惭愧春山笋蕨甜。\n岂是闻韶解忘味，迩来三月食无盐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75208,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山村五绝 其四","author":"苏轼","text":"杖藜裹饭去匆匆，过眼青钱转手空。\n赢得儿童语音好，一年强半在城中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75209,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山村五绝 其五","author":"苏轼","text":"窃禄忘归我自羞，丰年底事汝忧愁。\n不须更待飞鸢堕，方念平生马少游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75210,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"癸丑春分后雪","author":"苏轼","text":"雪入春分省见稀，半开桃李不胜威。\n应惭落地梅花识，却作漫天柳絮飞。\n不分东君专节物，故将新巧发阴机。\n从今造物尤难料，更暖须留御腊衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75211,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湖上夜归","author":"苏轼","text":"我饮不尽器，半酣味尤长。\n篮舆湖上归，春风洒面凉。\n行到孤山西，夜色已苍苍。\n清吟杂梦寐，得句旋已忘。\n尚记梨花村，依依闻暗香。\n入城定何时，宾客半在亡。\n睡眼忽惊矍，繁灯闹河塘。\n市人拍手笑，状如失林獐。\n始悟山野姿，异趣难自强。\n人生安为乐，吾策殊未良。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75212,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同曾元恕游龙山，吕穆仲不至","author":"苏轼","text":"青春不觉老朱颜，强半销磨簿领间。\n愁客倦吟花似酒，佳人休唱日衔山。\n共知寒食明朝过，且赴僧窗半日闲。\n命驾吕安邀不至，浴沂曾点暮方还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75213,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵孙莘老见赠，时莘老移庐州，因以别之","author":"苏轼","text":"炉锤一手赋形殊，造化无心敢望渠。\n我本疏顽固当尔，子犹沦落况其馀。\n龚、黄侧畔难言政，罗、赵前头且眩书。\n惟有阳关一杯酒，殷勤重唱赠离居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75214,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠别","author":"苏轼","text":"青鸟衔巾久欲飞，黄莺别主更悲啼。\n殷勤莫忘分携处，湖水东边凤岭西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75215,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵代留别","author":"苏轼","text":"绛蜡烧残玉斝飞，离歌唱彻万行啼。\n他年一舸鸱夷去，应记侬家旧住西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75216,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"月兔茶","author":"苏轼","text":"环非环，玦非玦，中有迷离玉兔儿。\n一似佳人裙上月，月圆还缺缺还圆，此月一缺圆何年。\n君不见斗茶公子不忍斗小团，上有双衔绶带双飞鸾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75217,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"薄命佳人","author":"苏轼","text":"双颊凝酥发抹漆，眼光入帘珠的皪。\n故将白练作仙衣，不许红膏污天质。\n吴音娇软带儿痴，无限闲愁总未知。\n自古佳人多命薄，闭门春尽杨花落。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75218,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吉祥寺花将落而述古不至","author":"苏轼","text":"今岁东风巧剪裁，含情只待使君来。\n对花无信花应恨，直恐明年便不开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75219,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"述古闻之，明日即至，坐上复用前韵同赋","author":"苏轼","text":"仙衣不用剪刀裁，国色初酣卯酒来。\n太守问花花有语，为君零落为君开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75220,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"李钤辖坐上分题戴花","author":"苏轼","text":"二八佳人细马驮，十千美酒渭城歌。\n帘前柳絮惊春晚，头上花枝奈老何。\n露湿醉巾香掩冉，月明归路影婆娑。\n绿珠吹笛何时见，欲把斜红插皂罗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75221,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"于潜令刁同年野翁亭","author":"苏轼","text":"山翁不出山，溪翁长在溪。\n不如野翁来往溪山间，上友麋鹿下凫鹥。\n问翁何所乐，三年不去烦推挤？\n翁言此间亦有乐，非丝非竹非蛾眉。\n山人醉后铁冠落，溪女笑时银栉低。\n我来观政问风谣，皆云吠犬足生氂。\n但恐此翁一旦舍此去，长使山人索寞溪女啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75222,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"于潜僧绿筠轩","author":"苏轼","text":"可使食无肉，不可使居无竹。\n无肉令人瘦，无竹令人俗。\n人瘦尚可肥，俗士不可医。\n旁人笑此言，似高还似痴。\n若对此君仍大嚼，世间那有扬州鹤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75223,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"于潜女","author":"苏轼","text":"青裙缟袂于潜女，两足如霜不穿屦。\n{舟奢}沙鬓发丝穿柠，蓬沓障前走风雨。\n老濞宫妆传父祖，至今遗民悲故主。\n苕溪杨柳初飞絮，照溪画眉渡溪去。\n逢郎樵归相媚妩，不信姬、姜有齐、鲁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75224,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自昌化双溪馆下步寻溪源，至治平寺，二首 其一","author":"苏轼","text":"乱山滴翠衣裘重，双涧响空窗户摇。\n饱食不嫌溪笋瘦，穿林闲觅野芎苗。\n却愁县令知游寺，尚喜渔人争渡桥。\n正似醴泉山下路，桑枝刺眼麦齐腰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75225,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自昌化双溪馆下步寻溪源，至治平寺，二首 其二","author":"苏轼","text":"每见田园辄自招，倦飞不拟控扶摇。\n共疑杨恽非锄豆，谁信刘章解立苗。\n老去尚贪彭泽米，梦归时到锦江桥。\n宦游莫作无家客，举族长悬似细腰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75226,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与临安令宗人同年剧饮","author":"苏轼","text":"我虽不解饮，把盏欢意足。\n试呼白发感秋人，令唱黄鸡催晓曲。\n与君登科如隔晨，敝袍霜叶空残绿。\n如今莫问老与少，儿子森森如立竹。\n黄鸡催晓不须愁，老尽世人非我独。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75227,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宝山昼睡","author":"苏轼","text":"七尺顽躯走世尘，十围便腹贮天真。\n此中空洞浑无物，何止容君数百人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75228,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"僧清顺新作垂云亭","author":"苏轼","text":"江山虽有馀，亭榭苦难稳。\n登临不得要，万象各偃蹇。\n惜哉垂云轩，此地得何晚。\n天公争向背，诗眼巧增损。\n路穷朱栏出，山破石壁很。\n海门浸坤轴，湖尾抱云巘。\n葱葱城郭丽，淡淡烟村远。\n纷纷鸟鹊去，一一渔樵返。\n雄观快新获，微景收昔遁。\n道人真古人，啸咏慕嵇、阮。\n空斋卧蒲褐，芒屦每自捆。\n天怜诗人穷，乞与供诗本。\n我诗久不作，荒涩旋锄垦。\n从君觅佳句，咀嚼废朝饭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75229,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五月十日，与吕仲甫、周邠、僧惠勤、惠思、清顺、可久、惟肃、义诠同泛湖游北山","author":"苏轼","text":"三吴雨连月，湖水日夜添。\n寻僧去无路，潋潋水拍檐。\n驾言徂北山，得与幽人兼。\n清风洗昏翳，晚景分秾纤。\n缥缈朱楼人，斜阳半疏帘。\n临风一挥手，怅焉起遐瞻。\n世人骛朝市，独向溪山廉。\n此乐得有命，轻传神所歼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75230,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"会客有美堂，周邠长官与数僧同泛湖往北山，湖中闻堂上歌笑声，以诗见寄，因和二首，时周有服 其一","author":"苏轼","text":"霭霭君诗似岭云，从来不许醉红裙。\n不知野屐穿山翠，惟见轻桡破浪纹。\n颇忆呼卢袁彦道，难邀骂座灌将军。\n晚风落日元无主，不惜清凉与子分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75231,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"会客有美堂，周邠长官与数僧同泛湖往北山，湖中闻堂上歌笑声，以诗见寄，因和二首，时周有服 其二","author":"苏轼","text":"载酒无人过子云，掩关昼卧客书裙。\n歌喉不共听珠贯，醉面何因作缬纹。\n僧侣且陪香火社，诗坛欲敛鹳鹅军。\n凭君遍绕湖边寺，涨绿晴来已十分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75232,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"席上代人赠别三首 其一","author":"苏轼","text":"悽音怨乱不成歌，纵使重来奈老何。\n泪眼无穷似梅雨，一番匀了一番多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75233,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"席上代人赠别三首 其二","author":"苏轼","text":"天上麒麟岂混尘，笼中翡翠不由身。\n那知昨夜香闺里，更有偷啼暗别人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75234,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"席上代人赠别三首 其三","author":"苏轼","text":"莲子劈开须见臆，楸枰著尽更无期。\n破衫却有重逢处，一饭何曾忘却时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75235,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"唐道人言，天目山上俯视雷雨，每大雷电，但闻云中如婴儿声，殊不闻雷震也","author":"苏轼","text":"已外浮名更外身，区区雷电若为神。\n山头只作婴儿看，无限人间失箸人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75236,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"追和子由去岁试举人洛下所寄五首，暴雨初晴楼上晚景 其一","author":"苏轼","text":"秋后风光雨后山，满城流水碧潺潺。\n烟云好处无多子，及取昏鸦未到间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75237,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"追和子由去岁试举人洛下所寄五首，暴雨初晴楼上晚景 其二","author":"苏轼","text":"洛邑从来天地中，嵩高苍翠北邙红。\n风流耆旧消磨尽，只有青山对病翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75238,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"追和子由去岁试举人洛下所寄五首，暴雨初晴楼上晚景 其三","author":"苏轼","text":"白汗翻浆午景前，雨馀风物便萧然。\n应倾半熟鹅黄酒，照见新晴水碧天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75239,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"追和子由去岁试举人洛下所寄五首，暴雨初晴楼上晚景 其四","author":"苏轼","text":"疾雷破屋雨翻河，一扫清风未觉多。\n应似画师吴道子，高堂巨壁写降魔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75240,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"追和子由去岁试举人洛下所寄五首，暴雨初晴楼上晚景 其五","author":"苏轼","text":"客路三年不见山，上楼相对梦魂间。\n明朝却踏红尘去，羞向清伊照病颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75241,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过广爱寺，见三学演师，观杨惠之塑宝山、朱瑶画文殊、普贤 其一","author":"苏轼","text":"寓世身如梦，安闲日似年。\n败蒲翻覆卧，破裓再三连。\n劝客眠风竹，长斋饮石泉。\n回头万事错，自笑觉师贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75242,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过广爱寺，见三学演师，观杨惠之塑宝山、朱瑶画文殊、普贤 其二","author":"苏轼","text":"妙迹苦难寻，兹山见几层。\n乱峰螺髻出，绝涧阵云崩。\n措意元同画，观空欲问僧。\n莫教林下意，终老叹何曾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75243,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过广爱寺，见三学演师，观杨惠之塑宝山、朱瑶画文殊、普贤 其三","author":"苏轼","text":"朱瑶唐晚辈，得法尚雄深。\n满寺空遗迹，何人识苦心。\n长廊欹雨脚，破壁撼钟音。\n成坏无穷事，他年复吊今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75244,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"韩子华石淙庄","author":"苏轼","text":"绛侯百万兵，尚畏书牍背。\n功名意不已，数与危机会。\n我公抱绝识，凛凛镇横溃。\n欲收伊、吕迹，远与巢、由对。\n誓言虽未从，久已断诸内。\n区区为怀祖，颇觉羲之隘。\n此身随造物，一叶舞澎湃。\n田园不早定，归宿终安在。\n彼美石淙庄，每到百事废。\n泉流知人意，屈折作涛濑。\n寒光洗肝膈，清响跨竽籁。\n我旧门前客，放言不自外。\n园中亦何有，荟蔚可胜计。\n请公试回首，岁晚馀苍桧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75245,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠上天竺辩才师","author":"苏轼","text":"南北一山门，上下两天竺。\n中有老法师，瘦长如鹳鹄。\n不知修何行，碧眼照山谷。\n见之自清凉，洗尽烦恼毒。\n坐令一都会，男女礼白足。\n我有长头儿，角颊峙犀玉。\n四岁不知行，抱负烦背腹。\n师来为摩顶，起走趁奔鹿。\n乃知戒律中，妙用谢羁束。\n何必言法华，佯狂啖鱼肉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75246,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"立秋日祷雨，宿灵隐寺，同周、徐二令","author":"苏轼","text":"百重堆案掣身闲，一叶秋声对榻眠。\n床下雪霜侵户月，枕中琴筑落阶泉。\n崎岖世味尝应遍，寂寞山栖老渐便。\n惟有悯农心尚在，起占云汉更茫然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75247,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病中独游净慈，谒本长老，周长官以诗见寄，仍邀游灵隐，因次韵答之","author":"苏轼","text":"卧闻禅老入南山，净扫清风五百间。\n我与世疏宜独往，君缘诗好不容攀。\n自知乐事年年减，难得高人日日闲。\n欲问云公觅心地，要知何处是无还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75248,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病中游祖塔院","author":"苏轼","text":"紫李黄瓜村路香，乌纱白葛道衣凉。\n闭门野寺松阴转，攲枕风轩客梦长。\n因病得闲殊不恶，安心是药更无方。\n道人不惜阶前水，借与匏樽自在尝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75249,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"虎跑泉","author":"苏轼","text":"亭亭石塔东峰上，此老初来百神仰。\n虎移泉眼趁行脚，龙作浪花供抚掌。\n至今游人盥濯罢，卧听空阶环玦响。\n故知此老如此泉，莫作人间去来想。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75250,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"佛日山荣长老方丈五绝 其一","author":"苏轼","text":"陶令思归久未成，远公不出但闻名。\n山中只有苍髯叟，数里萧萧管送迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75251,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"佛日山荣长老方丈五绝 其二","author":"苏轼","text":"千株玉槊搀云立，一穗珠旒落镜寒。\n何处霜眉碧眼客，结为三友冷相看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75252,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"佛日山荣长老方丈五绝 其三","author":"苏轼","text":"东麓云根露角牙，细泉幽咽走金沙。\n不堪土肉埋山骨，未放苍龙浴渥洼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75253,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"佛日山荣长老方丈五绝 其四","author":"苏轼","text":"食罢茶瓯未要深，清风一榻抵千金。\n腹摇鼻息庭花落，还尽平生未足心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75254,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"佛日山荣长老方丈五绝 其五","author":"苏轼","text":"日射回廊午枕明，水沉销尽碧烟横。\n山人睡觉无人见，只有飞蚊绕鬓鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75255,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吊天竺海月辩师三首 其一","author":"苏轼","text":"欲寻遗迹强沾裳，本自无生可得亡。\n今夜生公讲堂月，满庭依旧冷如霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75256,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吊天竺海月辩师三首 其二","author":"苏轼","text":"生死犹如臂屈伸，情钟我辈一酸辛。\n乐天不是蓬莱客，凭仗西方作主人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75257,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吊天竺海月辩师三首 其三","author":"苏轼","text":"欲访浮云起灭因，无缘却见梦中身。\n安心好住王文度，此理何须更问人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75258,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"孤山二咏，并引 其一 柏堂","author":"苏轼","text":"道人手种几生前，鹤骨龙筋尚宛然。\n双干一先神物化，九朝三见太平年。\n忽惊华构依岩出，乞与佳名到处传。\n此柏未枯君记取，灰心聊伴小乘禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75259,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"孤山二咏，并引 其二 竹阁","author":"苏轼","text":"海山兜率两茫然，古寺无人竹满轩。\n白鹤不留归后语，苍龙犹是种时孙。\n两丛恰似萧郎笔，十亩空怀渭上村。\n欲把新诗问遗像，病维摩诘更无言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75260,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与述古自有美堂乘月夜归","author":"苏轼","text":"娟娟云月稍侵轩，潋潋星河半隐山。\n鱼钥未收清夜永，凤箫犹在翠微间。\n凄风瑟缩经弦柱，香雾凄迷著髻鬟。\n共喜使君能鼓乐，万人争看火城还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75261,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"有美堂暴雨","author":"苏轼","text":"游人脚底一声雷，满座顽云拨不开。\n天外黑风吹海立，浙东飞雨过江来。\n十分潋滟金樽凸，千杖敲铿羯鼓催。\n唤起谪仙泉洒面，倒倾鲛室泻琼瑰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75262,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"八月十五日看潮五绝 其一","author":"苏轼","text":"定知玉兔十分圆，已作霜风九月寒。\n寄语重门休上钥，夜潮留向月中看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75263,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"八月十五日看潮五绝 其二","author":"苏轼","text":"万人鼓噪慑吴侬，犹是浮江老阿童。\n欲识潮头高几许，越山浑在浪花中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75264,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"八月十五日看潮五绝 其三","author":"苏轼","text":"江边身世两悠悠，久与沧波共白头。\n造物亦知人易老，故教江水向西流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75265,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"八月十五日看潮五绝 其四","author":"苏轼","text":"吴儿生长狎涛渊，冒利轻生不自怜。\n东海若知明主意，应教斥卤变桑田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75266,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]