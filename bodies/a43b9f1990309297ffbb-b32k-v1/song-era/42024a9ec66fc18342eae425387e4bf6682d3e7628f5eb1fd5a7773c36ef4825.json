[{"title":"谢惠瓦墩","author":"韦骧","text":"百尺危亭旧路榛，自公呼吸变兰荪。\n更怜数奉亲舆到，分惠芳斋碧瓦墩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46386,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢惠山花菜","author":"韦骧","text":"铃下雕盘送，山蔬雅惠沾。\n乱丝银鲫鲙，交叠玉龙髯。\n日膳荣分美，晨羞荷见添。\n题诗授来使，珍重岂知餍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46387,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和见招游城东园","author":"韦骧","text":"东城老圃扫青苔，竹柏深中一径开。\n桃蕊柳芽俱有意，安排春态待公来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46388,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赋新笋","author":"韦骧","text":"竹里行厨洗玉盘，旋寻新笋捃檀栾。\n柔鞭乍断泥犹湿，嫩箨初苞藓未乾。\n象箸偶存遗样短，琼林才拆冷光寒。\n如何且缓雕觞荐，留作青林虎豹看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46389,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"迎春花","author":"韦骧","text":"欺梅压柳肯相然，佳号迎春岂浪传。\n细叶茸茸垂绿发，繁英璨璨簇金钿。\n先时不入林莺妒，晚节唯容露菊鲜。\n绣在罗衣真有趣，不将红紫累婵娟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46390,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"以前韵作春寒攀迓","author":"韦骧","text":"春寒山色似昏烟，风度谯门昼漏传。\n露柳软条金缀纽，雨苔圆点翠遗钿。\n登楼引领情方远，行帐来诗墨尚鲜。\n坐想琅邪归路晚，两行红蜡代婵娟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46391,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和春寒次来韵","author":"韦骧","text":"云迷晓日山头闇，风落春梅水面香。\n十里郊原皆有趣，一番歌吹从寻芳。\n佳辰浩荡情怀惬，化国优游晷刻长。\n更把高才酬胜景，他年吟诵倍难忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46392,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赋石棋子以机字韵","author":"韦骧","text":"灵岩山下石，采拾比珠玑。\n圜璞生难小，文楸数可围。\n纷纭星并霣，黑白玉争辉。\n值赋神工妙，磨砻俗巧非。\n透关经手耐，争道转心稀。\n落落无情甚，谁为胜负机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46393,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和观新历 其一","author":"韦骧","text":"玉琯初回太簇春，新颁中朔到淮滨。\n眼前节物南来雁，出处知时似智人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46394,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和观新历 其二","author":"韦骧","text":"龙蛇蛰久待春雷，鸿雁图南去却回。\n山国不惊时节改，九天新赐历书来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46395,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和答代简二绝 其一","author":"韦骧","text":"远想阴云锁碧山，坐听檐溜响潺潺。\n却惊漏泄洪钧妙，变化风雷顷刻间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46396,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和答代简二绝 其二","author":"韦骧","text":"晓风吹聚几山云，掩抑朝晖气候昏。\n想望城头飞盖阻，郡斋应乐旧书温。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46397,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和城头相望","author":"韦骧","text":"雨馀山溜涨春沟，欲上危亭奉燕游。\n前望篮舆转城角，恍疑仙步在鳌头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46398,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"画舫泛春偶联一绝","author":"韦骧","text":"近郭风光日日新，城头溪上互寻春。\n欲知昨日篮舆客，便是今朝画舫人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46399,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和野步自幽谷之寺庄","author":"韦骧","text":"出郭爱暄韶，芳蹊接涧桥。\n轻车侵草色，飞盖拂林梢。\n自得行春乐，且无眠昼嘲。\n浅黄看柳嫩，淡碧辨山遥。\n此院游曾记，他林隐倦招。\n放怀天地阔，落日听歌樵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46400,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"茅亭观雨中杏花得中字","author":"韦骧","text":"茅亭高对杏花丛，漠漠阴云小雨中。\n蜀锦濯来添润色，燕脂洗出变轻红。\n幽香肯怯残梅妒，腻艳尤便弱柳笼。\n不放晴阳老芳态，令人曲意度春工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46401,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"幽谷谢惠新酿家馔奉亲","author":"韦骧","text":"花里深深使语传，银壶乘酒副珍鲜。\n翰林旧德垂情至，鹤发慈亲荷惠偏。\n寿盏此时添乐只，綵衣今日倍忻然。\n却吟鄙句通铃阁，匪报尤惭木李篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46402,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和樱桃花开帐饮口占","author":"韦骧","text":"樱桃花里置行厨，一榼琼浆数尾鲈。\n勇趁红芳集宾履，玉山倾倚照冰壶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46403,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又和行字二韵","author":"韦骧","text":"东风如酒醉朱樱，终日酣酣弄秀英。\n天上谪仙乘兴赏，一番歌吹傍云行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46404,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和正闰晦日","author":"韦骧","text":"孟陬闰晦半春光，夜刻初消昼刻强。\n谷鸟有声皆得意，林花无处不飘香。\n池经夕雨添新渌，柳舞东风发故狂。\n亭压高城延过躅，湛然清兴引杯长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46405,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和春晚过幽谷口占","author":"韦骧","text":"先春当日探芳芽，瞬息而今已落花。\n碧实有心应见笑，岂须新艳引流霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46406,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又和至丛山堂口占","author":"韦骧","text":"残红新绿媚朝晴，脚到丛山眼倍明。\n春老物情皆有趣，只应犹欠早莺声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46407,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和小雨乘兴游城西竹园","author":"韦骧","text":"冷逼林坳笋未筠，润通花底砌无尘。\n且倾文举盈樽酒，莫惜林宗折角巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46408,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和会饮牡丹丛间","author":"韦骧","text":"移樽近槛就香多，辄效花前小子歌。\n愿扩酒肠无惜醉，淡红楼子独嵯峨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46409,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"倒用前韵","author":"韦骧","text":"宛转眉山效蜀峨，花前执板为清歌。\n歌声暗与春风合，催折芳心不厌多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46410,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和前韵仍以峨字为首尾","author":"韦骧","text":"峨冠莫惜插花多，多插名花壮醉歌。\n歌罢襟怀肆夷旷，愿平群险刬嵯峨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46411,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和山行回坐临清桥啜茶","author":"韦骧","text":"云軿回处引笙箫，疑向春宵度鹊桥。\n桥上茗杯烹白雪，枯肠搜遍俗缘消。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46412,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和 其一","author":"韦骧","text":"醉向溪头按洞箫，夜瞻略彴似星桥。\n清欢未足班荆坐，一任纱笼蜡炬消。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46413,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和 其二","author":"韦骧","text":"暮角清声杂凤箫，一时冠带似圜桥。\n谪仙诗句春泉涌，万斛量愁顷刻消。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46414,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偶疾未平不得预龙蟠之游辄成诗以迓还旆","author":"韦骧","text":"小城春物已阑珊，病肺朝来强自宽。\n疲苶未堪随骥尾，高明空想到龙蟠。\n日烘栏楯花枝卧，风滚阶除柳絮团。\n索笔题诗待回驭，肯将尘语累清欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46415,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"牙城话别口占","author":"韦骧","text":"移节名藩去有期，牙城重上思依依。\n落花也似人情恋，扑袂飘香不浪飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46416,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"饯别劝饮","author":"韦骧","text":"垂杨楼上卷珠帘，歌扇轻摇落絮黏。\n邦伯指期移绛节，州人终日拥彤襜。\n危弦脆筦催金盏，芳草青山照画檐。\n酩酊愿公无惜醉，祗应羲驭驻峰尖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46417,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送别回作","author":"韦骧","text":"祖饯初还重仳违，懒鞭款段入城扉。\n旌旂人去山川晚，台榭春归花药稀。\n鼓吹渐遥空望望，旄倪相顾共依依。\n自怜无以纾诚恋，唯有诗筒殆庶几。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46418,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和耿天骘剪綵梅花得开字","author":"韦骧","text":"根如芝草不因栽，叶似春云容易开。\n应有靓妆偷艳去，且无狂蝶为香来。\n殷勤玉盏频飞举，酬酢金刀巧剪裁。\n烂赏更于何处好，蟾光雪色在瑶台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46419,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"元日","author":"韦骧","text":"蔟律新声应，寅杓旧观还。\n三朝思北阙，万寿祝南山。\n谬忝金闺籍，遐违玉笋班。\n山城濡滞迹，望日想天颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46420,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"席上劝仲元著作勿辞酒","author":"韦骧","text":"百盏先尝一盏醇，三分才破一分春。\n花间剔火香烟细，竹外垂缣画笔新。\n落日穿林照檐额，绪风吹草动阶唇。\n莫愁酩酊辞公劝，金斝空时迹已陈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46421,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和苏正甫劝饮之作","author":"韦骧","text":"芳陌草萋萋，相逢又解携。\n柳梢迷酒绿，歌韵怨春低。\n兰菊时难一，鹪鹏乐自齐。\n送君须满饮，未放锦障泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46422,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赋迎赏欲开杏花得花字","author":"韦骧","text":"闰月春光助物华，杏园迎赏欲开花。\n昼慵闺绣工犹浅，晓起宫妆色渐佳。\n袅袅风枝偏弄送，酣酣烟蕊自交加。\n对君安得辞昏醉，更作狂歌恣所夸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46423,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又用花字为即席","author":"韦骧","text":"春色漫漫不可涯，谪仙亭馆最幽佳。\n歌声闇逐风中絮，酒算旁看盏里花。\n击钵题诗助清旷，藏阄传令止喧哗。\n他年追念从真适，炊熟黄粱一梦赊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46424,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陪秋叔游幽谷即席赋一川花","author":"韦骧","text":"城南幽谷去非赊，踏石穿云境趣佳。\n门下车鱼情浃洽，道旁旌旆影鬖髿。\n笙箫宛转随风远，台榭参差对日斜。\n白玉为船载琼醑，未容轻负一川花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46425,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和社日小饮","author":"韦骧","text":"挑菜佳辰过夕醺，又逢春社举清樽。\n不为归遗东方态，且对韶妍一醉昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46426,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赋牡丹黄齑","author":"韦骧","text":"依栏凋谢若为情，旋拾残红入鼎烹。\n吞秀嚼香须细细，送春唯此一杯羹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46427,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和范子功学士留题二贤堂","author":"韦骧","text":"屹然榱桷傍云烟，榜揭堂名以二贤。\n翰苑钜公存往躅，集仙肤使出新篇。\n寒光共杳山椒月，幽韵相投陇下泉。\n一等声辉惊海内，后先踪迹似忘年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46428,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"真守侯公辅见留之勤因辞以诗言欲遽往早还之意","author":"韦骧","text":"洗涤炎蒸夕雨凉，瞥然行役过邻邦。\n旅怀耿耿通秋漏，征舸萧萧倚暮江。\n礼豆辄辞蕲义许，绪言倾听祇心降。\n莫疑迹以便奔走，云下孤亲雪鬓双。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46429,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜宿淤丘","author":"韦骧","text":"古岸维舟夜向深，胡床踞坐绝嚣音。\n烟林隐隐成孤垒，水月辉辉滉碎金。\n勉强官途情易厌，冲蒙狙诈力难任。\n予心欲道从谁语，祗有清宵一苦吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46430,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"泛滁河","author":"韦骧","text":"十里之间五六湾，行舟终日绕青山。\n更为先后枫林翠，互出东西古屋閒。\n酒为孤斟心易倦，诗非共赋思仍悭。\n秋风飒飒吹襟袂，可是无情促鬓斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46431,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"出滁口入江峡","author":"韦骧","text":"逆风吹浪雪花翻，舟出滁河浩荡间。\n柁转一声鸣似鼓，橹摇数丈漩如环。\n路通淮右千源水，望断江南一带山。\n莫恨区区缘吏役，此时清旷亦开颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46432,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和徐仲元以诗见送","author":"韦骧","text":"火云涌起势崔巍，行舸纱窗一一开。\n自是宦途无定迹，莫嫌台檄属非材。\n往还倏忽南柯梦，离合殷勤北海罍。\n更谢□人为吉语，果然朝夕得归来。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46433,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"吴六合道原席上","author":"韦骧","text":"单舸西来六月初，偶逃远役且踌躇。\n幽寻古寺情怀放，高会虚堂暑气除。\n地主延留情已厚，故人邂逅乐何如。\n回头陈迹无寻处，姓字閒于壁上书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46434,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李白祠堂","author":"韦骧","text":"祠宇前临姑熟溪，溪流湛湛清无泥。\n春来秋去几百载，朝云夜月长相繄。\n堂间画像冰玉质，高风爽气何凄凄。\n文章光燄本万丈，来此寂寞由谗挤。\n当时放荡沉清骨，因有声名不漂没。\n莫论楚屈与吴胥，谁有高才追彷佛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46435,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"姑熟州宅后泛舟清饮","author":"韦骧","text":"古郡萧萧草木秋，牙城北出上扁舟。\n乔林有隙山微见，曲岸无风水自流。\n竹色雅如侵筦研，鸟声时似劝觥筹。\n勿咍吏役能拘束，酒兴诗肠亦自由。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46436,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过九华山","author":"韦骧","text":"旌骑前头是九华，未能游历已咨嗟。\n好将秀色开尘眼，又被浮云一半遮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46437,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"冠帻峰","author":"韦骧","text":"渡江行役走埃尘，路过名山兴味新。\n冠帻危峰勿相笑，俨然云外亦辛勤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46438,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"阅九华录","author":"韦骧","text":"仙居岩巘几千重，秀入青冥气势崇。\n他日却来寻胜境，且将图录记诸峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46439,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿九华驿阻雨","author":"韦骧","text":"喜无檐溜滴空阶，秣马轻装入夜催。\n一阵松风惊晓枕，又疑天外雨声来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46440,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又过九华山","author":"韦骧","text":"昔年尝慕此山游，今日经行不暇留。\n好意尚为尘迹累，碧鸡山凤勿相尤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46441,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登齐山","author":"韦骧","text":"临岐跋马向齐山，苒苒烟萝试一攀。\n怪石何年居物表，白云终日伴僧閒。\n气吞城郭纷嚣外，势接江湖浩荡间。\n况是重阳时节近，紫微前咏好开颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46442,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"弄水亭","author":"韦骧","text":"清溪翠巘两相宜，雄构峥嵘压贵池。\n弄水得名应有谓，登山留咏想同时。\n角声北起秋云动，桥影西横晚照迟。\n佳趣古今看不尽，前人遗美后人思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46443,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"离池州过长围岭","author":"韦骧","text":"孤城西出夕阳偏，岭上行行思渺然。\n草木高低共秋色，江湖左右各天边。\n凌风短鬓无由掠，投宿轻蹄不用鞭。\n一簇人烟紫岩驿，解鞍聊看月婵娟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46444,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"别滕元发侍郎","author":"韦骧","text":"尘役间关旅思收，幸瞻旌戟少淹留。\n多年目断丹霄步，再拜心轻万户侯。\n三节行催虎符去，双毛将近凤池游。\n门阑欲别徒惆怅，吟对江山迥不休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46445,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿杨梅驿","author":"韦骧","text":"两壁万千嶂，一村三四家。\n度桥逢古驿，下马踏秋花。\n夜永蛩尤苦，云空月自华。\n冷官无好趣，安用五书车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46446,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"早行","author":"韦骧","text":"鸡声喔喔似相催，秣马登途酒一杯。\n海日欲升山顶赤，林霏初散岭头开。\n自怜旅梦经千变，谁谓离肠祇九回。\n苟禄奔驰还窃笑，未能容易赋归来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46447,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晓离杨梅驿","author":"韦骧","text":"长坡峻阪足崎岖，晓出杨梅古驿孤。\n山腹带云如曳练，稻梢垂露欲流珠。\n穿篱鸭脚深深碧，近水鸡冠小小株。\n行役虽劳遇佳境，且将幽句慰瘏痡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46448,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"即事","author":"韦骧","text":"舞蝶双飞穿宿露，鸣禽相唤弄朝暾。\n涧盘石径长蛇转，山入秋空翠凤骞。\n枫叶园林看自好，菊花时节兴难论。\n高怀不为尘劳减，安用笙箫簇酒樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46449,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过面山渡","author":"韦骧","text":"碧溪深水不胜篙，船尾呕哑一橹摇。\n岸北岸南秋色好，西风吹叶马萧萧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46450,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"食鳜","author":"韦骧","text":"踰尺秋江鳜，赀轻愧自深。\n穿腮窥秣赪，引鬣讶涂金。\n捂鼎情虽锐，飞刀爱不任。\n何须鲈满箸，始动季鹰心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46451,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"对鉴","author":"韦骧","text":"寒光满尺馀，拂拭在朝晡。\n敌面知相应，纤毫肯见诬。\n壮颜随岁老，短发任秋枯。\n皦皦胸中事，君能照得无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46452,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"建德道中感兴","author":"韦骧","text":"穿云度水涉修程，日日长亭复短亭。\n秋老声音闻过雁，夜凉精彩见飞萤。\n羁怀遇物如萦絮，诗思投閒似建瓴。\n却羡野人收刈毕，寂然无事掩柴扃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46453,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"思侍","author":"韦骧","text":"旅宦经秋厌路尘，家书累日寂无闻。\n劳身江左驰单傅，目极淮东望白云。\n俚听难将至音悦，天和不学众人焚。\n趋庭往往逢寒律，叱驭回辕两未分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46454,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"感怀","author":"韦骧","text":"埃壒满袛裯，谁矜意气豪。\n独知安履坦，宁复叹屯膏。\n剑气藏秋匣，弓声闭古韬。\n临风浩歌罢，短发不胜搔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46455,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]