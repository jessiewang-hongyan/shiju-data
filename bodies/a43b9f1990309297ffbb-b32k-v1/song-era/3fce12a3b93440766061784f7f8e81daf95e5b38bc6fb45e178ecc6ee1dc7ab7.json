[{"title":"二十四日回泊东阜和旧题酬唱十九年矣","author":"韩淲","text":"海棠枝上日，依旧照窗明。\n文会惊犹在，重来咏转清。\n林庐记经始，花径已栽成。\n良友仙山去，空留百世名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26052,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"初六日过尹家再和西轩韵赠子文 其一","author":"韩淲","text":"制宅思前绪，轩名到处幽。\n不须论梦蝶，只是合盟鸥。\n北望刘琨啸，南游庾信愁。\n百年五字在，吾岂为诗谋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26053,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"初六日过尹家再和西轩韵赠子文 其二","author":"韩淲","text":"家学流风懿，成才世自豪。\n出群能秀发，何独类贤髦。\n紬绎遗编富，规模古训高。\n青青秋桂子，馀事等毫毛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26054,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"郑一病中见寄和韵答之","author":"韩淲","text":"爱酒阮宣杖，倦行陶令舆。\n閒投本无意，垂老亦何居。\n万事付杯水，一贫唯饭蔬。\n秋怀苦相望，幽寺挟残书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26055,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"元立复和伯皋送行诗次韵并答之 其一","author":"韩淲","text":"倒载临离日，搜吟出饯时。\n老身犹藉酒，亲意不徒诗。\n山水东西去，园池上下随。\n凝香兵卫戟，应复野人思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26056,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"元立复和伯皋送行诗次韵并答之 其二","author":"韩淲","text":"半隐平生句，年来果谓何。\n轲雄墙已及，李杜垒终摩。\n籍籍须传远，纷纷何足多。\n斯文千古事，自笑得如么。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26057,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵所东因有感答之","author":"韩淲","text":"筹边须善策，是古肯非今。\n名士自江左，丈人谁汉阴。\n敝庐清昼永，幽磴白云深。\n可在唱酬句，岂多陶写心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26058,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和卿赠别次韵答之","author":"韩淲","text":"两岸春风暖，山花水喷泉。\n归期虽较晚，行乐肯输先。\n来燕知犹未，宾鸿信欲遄。\n故人诗送我，吟思满江天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26059,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵赵理丞","author":"韩淲","text":"相去如霄壤，寒吟只短歌。\n春前知岁早，腊里见时和。\n待把閒情赋，空将老眼摩。\n年年愿强健，江海有披蓑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26060,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵昌甫九峰留诗 其一","author":"韩淲","text":"远峙山常峻，幽泉水自泠。\n几回灵井曲，如入九峰屏。\n雅以平生旧，空怀万古灵。\n诗成霜露湿，原上草青青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26061,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵昌甫九峰留诗 其二","author":"韩淲","text":"每恨居山浅，扶舆过九峰。\n几年无恃怙，常此痛音容。\n风雨寒垂点，云烟晚复重。\n市廛多汩没，忽尔脱尘踪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26062,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵昌甫九峰留诗 其三","author":"韩淲","text":"每恨居山浅，扶舆过九峰。\n溪清通乱石，路暗失长松。\n须鬓时时换，身心事事慵。\n雨寒樵牧断，朝暮听鸣钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26063,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵昌甫九峰留诗 其四","author":"韩淲","text":"每恨居山浅，扶舆过九峰。\n尘销草色淡，岚染木阴浓。\n瓢饮真堪羡，盘飧粗得供。\n一庵饥渴外，何事入心胸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26064,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵吴推官","author":"韩淲","text":"楚雨黄梅熟，卑枝易积阴。\n山园三径少，涧水一沟深。\n萧飒寒犹起，低回老亦侵。\n寻诗为君和，绝唱有遗音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26065,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵赵景伯南岩","author":"韩淲","text":"披藿南岩寺，无僧林荡虚。\n崖悬徒可望，泉滴又何居。\n时世悠悠转，心情落落疏。\n山行有吟啸，佳处莫踌躇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26066,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"昌甫自衢送客入城得其诗次韵呈之 其一","author":"韩淲","text":"霜风散焦暵，雾日照寒凉。\n影迹连山白，声华落木黄。\n俗情难以澹，幽事不关忙。\n我觉年逾迈，君吟诗益昌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26067,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"昌甫自衢送客入城得其诗次韵呈之 其二","author":"韩淲","text":"三见木樨开，香传好客来。\n庞公隐能出，杜老句欣陪。\n市近心终远，交亲语易谐。\n柯山玉溪水，人道谓何哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26068,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"昌甫自衢送客入城得其诗次韵呈之 其三","author":"韩淲","text":"蓬户为君开，荒园少旧栽。\n犹存小篱落，不比一轩苔。\n前月访彼矣，今朝同此哉。\n人间花草地，终古岁寒梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26069,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵昌甫见寄","author":"韩淲","text":"相逢虽数数，共话祇匆匆。\n不觉中秋过，还当九日中。\n登台嗟往事，觅句忆高风。\n人物方彫谢，吾侪孰与同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26070,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵昌甫见诒","author":"韩淲","text":"屏迹丘园矣，秋来事亦忙。\n开林朝斧钝，钻纸夜灯煌。\n一潦屋殊损，屡空饥易忘。\n俄而对时菊，种种发能长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26071,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵昌甫归后所寄","author":"韩淲","text":"祇怪深居简，徒希逸驾攀。\n风清玉田路，云白瑞峰山。\n心事吟章外，情文作帖间。\n相望初若远，一出本非艰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26072,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"二十日入章泉次韵昌甫所赠","author":"韩淲","text":"老梦困其独，微吟惬所同。\n閒中徒著句，高处尽归翁。\n一代文章志，诸方风俗通。\n息交惟士贱，尚友则师隆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26073,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵昌甫别后所寄","author":"韩淲","text":"居山更入山，百事不相关。\n只有猿狙外，更无鸡犬间。\n渊泉得沿濯，岩岫要跻攀。\n最是高人语，时容见一斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26074,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"徐仁甫建阳一别忽已二十五六年见过惘然次韵道院池上所作","author":"韩淲","text":"逃暑身何寄，池荷竹院间。\n交朋如玉洁，名字饮冰閒。\n吹雨馀毫发，鸣泉落佩环。\n长年葑村路，往日考亭山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26075,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵成季病中见寄","author":"韩淲","text":"閒意忽不惬，秋声隔市门。\n千林空白昼，一叶下黄昏。\n归马正修睦，捕蝗俄讨论。\n愿丰穰虑歉，相望数家村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26076,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵仲至","author":"韩淲","text":"能道意中事，诗来看复嗟。\n春风殊作恶，春雪固能佳。\n引玉下梅萼，输金上柳芽。\n睡翁山水县，隔竹定敲茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26077,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵黄崇道","author":"韩淲","text":"长夏得閒趣，无过里社中。\n往来三径日，舒写一襟风。\n幸与陶潜醉，从渠阮籍穷。\n人家莺燕里，犹记淡烟笼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26078,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"马庄甫经过留五字次韵","author":"韩淲","text":"老却溪山眼，荒寒不见人。\n草深多烂旧，梅浅易尖新。\n岁事谁嗟晚，年龄自惜春。\n相逢既相识，聊借酒精神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26079,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"卢教授约周县丞来访次周丞韵","author":"韩淲","text":"今古山阴道，谁吟雪下船。\n久将随俗好，便拟作春妍。\n朝市无閒日，山林有瀑泉。\n薰风吹两鬓，蚕事欲三眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26080,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵仲至","author":"韩淲","text":"腊向残年去，春从元日回。\n急搔双鬓发，浑染几尘埃。\n诗话惊频改，杯停喜更催。\n椒盘随綵胜，金柳带琼梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26081,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵赵将","author":"韩淲","text":"箯舆来涧谷，话久不知还。\n自是无人到，谁能有我閒。\n绿阴晴树外，清馥野花间。\n客去鸡鸣午，呼儿又掩关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26082,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵德久","author":"韩淲","text":"澄净清秋夜，诗成两眼明。\n佳人千古意，浊酒一杯情。\n湖水鱼龙舞，天风鸿雁鸣。\n菊花九日近，便合上峥嵘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26083,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵刘召虎","author":"韩淲","text":"论交贵知己，相与可忘年。\n久旱为霖日，馀凉畏暑天。\n浮沉非识治，用舍不因贤。\n只有青山好，分明阿那边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26084,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"昌甫念某生朝寄诗来次韵谢之","author":"韩淲","text":"俾寿情何重，酬吟报恐迟。\n拜嘉诚自喜，友谊尚谁为。\n醑我遥相命，思翁不独诗。\n晚生头已秃，敬长眼空窥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26085,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵昌甫 其一","author":"韩淲","text":"相知新固乐，人物易如林。\n游爱郭同许，衰思范与吟。\n放歌能共和，会约待重斟。\n还我晏斋隐，何尝枉尺寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26086,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵昌甫 其二","author":"韩淲","text":"相送思前日，同吟忆此时。\n情亲五字句，意妙一篇诗。\n长夏看榴火，薰风入鬓丝。\n西湖渺何许，终愧北山移。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26087,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵昌甫 其三","author":"韩淲","text":"古道定谁成，庄周与净名。\n劳哉秦外趣，甚矣颍阳清。\n并舍披衣去，行桥拄杖声。\n遥知园列树，新好看初荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26088,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵昌甫 其四","author":"韩淲","text":"别后忽逢雪，岁寒殊惘然。\n自怜疏酒盏，谁识寄诗编。\n老矣思离阔，遐哉漫属联。\n金仙玉田路，来往记今年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26089,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵昌甫 其五","author":"韩淲","text":"章泉泉上屋，茅补定牵萝。\n意象时间少，心思古处多。\n暑风今夏矣，凉雨奈秋何。\n顾我颠毛白，门閒亦养疴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26090,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵昌甫 其六","author":"韩淲","text":"老叹交情少，閒知友道难。\n何堪武夷曲，更近子陵滩。\n绝口谈龙肉，从渠食马肝。\n敢云栖择木，随世一枝安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26091,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵昌甫 其七","author":"韩淲","text":"秋风过秋雨，眇眇正愁予。\n望断嗟何寄，吟成懒自书。\n齿摇诚有数，鬓秃恐无馀。\n几载章泉水，山深只晏如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26092,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵景瑜","author":"韩淲","text":"尽道今年煖，冬来十月中。\n更无霜共雪，时有雨随风。\n薄宦其如拙，浮生乃奈穷。\n衰颜负清镜，犹借酒能红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26093,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"同周次公步寻起云旧基次韵","author":"韩淲","text":"起云亭不见，立尽水边人。\n满眼高情少，惊心得句频。\n龟毛真兔角，凤翼漫龙鳞。\n山泽行吟久，渊明漉酒巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26094,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵见诒","author":"韩淲","text":"倦作京华梦，秋霖失旱乾。\n故人相见后，不觉话悲酸。\n酒盏还更酌，诗盟复肇端。\n如翁真老大，莫数郑都官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26095,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵盖友","author":"韩淲","text":"林外山平远，衰颜落笔难。\n风声催日晚，云物转霜寒。\n京邑九衢盛，江湖千里宽。\n交游尽诗社，名誉得苏端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26096,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵潘文","author":"韩淲","text":"小试登山屐，因閒见野僧。\n谈禅还静憩，望远得虚凭。\n分韵吟心适，归来醉梦腾。\n酒醒深夜起，推枕只寒灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26097,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵伯皋","author":"韩淲","text":"易别难相聚，倾怀语未终。\n敝庐才郭外，高隐远乡中。\n天地常年在，溪山触处同。\n营营非我事，有句欲乘风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26098,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵斯远见赠","author":"韩淲","text":"剥啄君家去，同为两县来。\n赵施元保社，徐郑亦尊罍。\n便做壮心已，须饶老眼开。\n交游容易别，十日重徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26099,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵希之","author":"韩淲","text":"山远飞晴霭，春江景有馀。\n推窗风浩荡，凭几日徐舒。\n何计用休沐，忘怀得燕居。\n从容话千载，随饭只盘蔬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26100,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵石鲁瞻","author":"韩淲","text":"髣髴徂徕老，因诗只溯风。\n胡为犹尔健，应怪懒能工。\n此道今皆弃，高情自不同。\n和成千里梦，题寄欲归鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26101,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵昌甫镌歙砚","author":"韩淲","text":"圆泽三生石，陈登百尺楼。\n砚因铭共永，诗与字俱锼。\n此老非徒耳，閒人更点头。\n魏铜那敢拟，朱锡盍为侔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26102,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵叔向","author":"韩淲","text":"君在南湖住，我同东郭游。\n陈蕃无下榻，王粲有登楼。\n吟苦诗陶写，酣沉酒拍浮。\n德辉天外凤，机静水边鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26103,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵赵清江","author":"韩淲","text":"烟禁凭谁会，杯寒只自斟。\n几多原上恨，犹记少年心。\n领略因初见，经行或重临。\n攀花问杨柳，丝竹也清音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26104,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵上饶 其一","author":"韩淲","text":"有句閒中得，应知百虑休。\n麦天连涧冷，梅月夹山稠。\n唤起陶潜醉，能消庾信秋。\n朝端富鹓鹭，边琐少貔貅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26105,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵上饶 其二","author":"韩淲","text":"官事人人衮，谁怜寂寞乡。\n卑高多贵贱，寒暑易炎凉。\n叹息弦歌美，殷勤篇翰长。\n閒民为兴起，交道得其详。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26106,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵成季 其一","author":"韩淲","text":"短短长长柳，红红白白梅。\n溪浮何处棹，山对别时杯。\n春事还应尔，人情有是哉。\n却因嘉树底，浑见好花开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26107,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵成季 其二","author":"韩淲","text":"畎亩秋来雨，村村不厌多。\n暑应无热恼，凉可起沉疴。\n花动门中桂，叶浮池上荷。\n南豅诗到手，想像与同哦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26108,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵周五哥","author":"韩淲","text":"莫道春犹远，连阴初未曦。\n振衣行复阻，岸帻坐成痴。\n芳事诚须酒，交情岂为诗。\n清明翻手是，常记旧相随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26109,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵子任","author":"韩淲","text":"城郭秋风晚，人来自远山。\n荒荒行硌确，浅浅渡潺湲。\n虎尾休论履，龙鳞且愿攀。\n过从因煮饼，惜取片时閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26110,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"小酌饯耿干运赵推官分韵复和韵 其一","author":"韩淲","text":"潜鱼空浪藻，倦翼漫风林。\n邂逅留连饮，从容取次吟。\n名言惊思苦，离话惜情深。\n昔尔那知此，他还未必今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26111,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"小酌饯耿干运赵推官分韵复和韵 其二","author":"韩淲","text":"雨歇收朝润，风回起夕凉。\n君今过澧浦，客有到钱塘。\n落涧高槐影，浮檐细竹光。\n寻思须浪赋，杂伯更谈王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26112,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"二十四日昌甫斯远子功集雪观次韵斯远","author":"韩淲","text":"閒将诗句和，凉自雨中来。\n可是不相聚，那能得此回。\n香炉连笔格，茶椀更山罍。\n一架蒲阴绿，残阳晚又开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26113,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"示棐矩茶","author":"韩淲","text":"乃祖文名在，群儿好读书。\n愁深我将去，恨不汝同居。\n风俗随时薄，人情莫自疏。\n传家诗礼学，勤苦要三馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26114,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"亨中之孙求诗","author":"韩淲","text":"团源古君子，老去孰追随。\n隐约孙能奉，高深我却知。\n家传无自画，乡荐有谁为。\n成立须勤苦，清哉是祖师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26115,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"柬乙翁上人 其一","author":"韩淲","text":"草树随时长，城春雨易蒸。\n閒人来入市，官舍却逢僧。\n觌面非竿木，何心是葛藤。\n吃茶看洗钵，忘却老昏瞢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26116,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"柬乙翁上人 其二","author":"韩淲","text":"山玉冰溪地，常年衲子过。\n杖挑明月重，笠戴白云多。\n洞远今无鹫，湖高旧见鹅。\n与君三叹息，佛法付天魔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26117,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"九月四日黄子功林德久自柳州共汎访铦师","author":"韩淲","text":"閒得琴尊胜，寻诗约俊游。\n欲穷山下寺，旋买水边舟。\n谁悟牵黄犬，自应盟白鸥。\n野晴秋意思，浑付碧云休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26118,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄乙上人","author":"韩淲","text":"盂兰盆会日，元自目犍连。\n摄化应无量，追修亦有缘。\n荒荒谁正令，的的漫单传。\n业报众生苦，三涂对四禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26119,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过沙坑留遗余子任","author":"韩淲","text":"约我沙坑外，南豅共说诗。\n山林已黄叶，篱菊尚青枝。\n良晤真难事，相期若旧知。\n翩翩乘果下，想像入城时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26120,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵斯远喜予见过 其一","author":"韩淲","text":"无地寻明月，因人且出游。\n猖狂疑有谓，拓落信何求。\n山水知回薄，杯觞得献酬。\n秋情吾卜夜，垂老未为羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26121,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]