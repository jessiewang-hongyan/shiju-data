[{"title":"花心动 落梅","author":"黄子行","text":"谁倚青楼，把谪仙长笛，数声吹裂。\n一片乍零，千点还飞，正是雨晴时节。\n水晶帘外东风起，卷不尽、满庭香雪，画阑小，斜铺乱飐，翠苔成缬。\n袅袅馀香未歇。\n空怅望音尘，两眉愁切。\n翠袖泪乾，粉额妆寒，此恨有谁同说。\n江南春信无痕迹，馀情在、冷烟残月。\n梦魂远，兰灯伴人易灭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70614,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贺新郎 冰箸","author":"黄子行","text":"开遍寒梅萼。\n正东皇、排酥砌玉，幻成楼阁。\n十万琼琚仙女队，来趁春光游乐。\n向醉里、玉簪轻落。\n零乱不知何处去，甚人间、一夜东风恶。\n吹起在，画檐角。\n参差向晓森如削。\n似吴姬、妆残粉指，向人垂著。\n好似西园春笋瘦，红锦䙀儿乍剥。\n且莫遣、儿童敲却。\n拟办羔儿香瓮酒，唤刘叉、来醉尊前约。\n吟好句，再描摸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70615,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"满江红 归自湖南题富春馆","author":"黄子行","text":"津鼓匆匆，犹记得、故人相送。\n春江上、鸟啼花影，马嘶香鞚。\n情逐阳关金缕断，泪和杨柳春丝重。\n算别来、几度月明时，相思梦。\n山万叠，愁眉耸。\n春一点，归心动。\n问风俦月侣，有谁游从。\n百里家山明日到，一尊芳酒今宵共。\n任楼头、吹尽五更风，梅花弄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70616,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其三","author":"黄子实","text":"月穿篷席罅，风轧舵牙声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70617,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其四","author":"黄子实","text":"旅梦难安枕，村酤不满瓶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70618,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其二","author":"黄子实","text":"履痕莫辨阴王迹，敢去多题汉晋年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70619,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其一","author":"黄子实","text":"剩携尊酒斟蓝尾，惜不杯羹荐墨头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70620,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"归时作","author":"黄子信","text":"笑倩西风拂旧埃，归时行李似初来。\n也知三载清贫好，博得一家强健回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70621,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"投杨帅长孺","author":"黄子信","text":"六年两度拜宸旒，换得青衫白上头。\n飞鹊祇因无树绕，穷猿何暇择林投。\n明知著脚当来误，几欲抽身不自由。\n安得有钱了官债，便无三径也归休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70622,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题涌月亭二首 其二","author":"黄子善","text":"星河耿耿障云披，剑气峥嵘彻紫微。\n轮辗碧空凌象纬，波翻清影射窗扉。\n寒光照夜潜蛟动，皓色穿林宿鸟飞。\n草树无烟衣有露，夜深吟赏欲忘归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70623,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题涌月亭二首 其一","author":"黄子善","text":"沧波空碧接青天，潮满江平月正圆。\n风飐浪花来不尽，水涵轮影去无边。\n舟中赏客方酣寝，窗下书生犹未眠。\n我欲携琴频访戴，越吟应许夜深传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70624,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题所居","author":"黄子棱","text":"青衫木笏尚初官，未老金鱼是等闲。\n世上几多名将相，门前谁有此溪山。\n市楼晚日红高下，客艇春波绿往还。\n人过小桥频指点，全家都在画图间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70625,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"又用前韵谢叶宰 其一","author":"黄干","text":"谁推双毂绕天飞，短发萧疏蚤是迟。\n肠断金钱门外月，晓天秋露稻花时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70626,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"又用前韵谢叶宰 其二","author":"黄干","text":"明招古木叶千层，山自浮云溪自横。\n春树莺藏无觅处，遗编灯火屡吞声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70627,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"双髻峰","author":"黄干","text":"万山环立两山起，伯仲埙篪风味多。\n轩冕直能惊俗子，采薇千古不消磨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70628,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"甲子语溪闵雨四首 其四","author":"黄干","text":"老夫年来百不悲，夜听群儿声吾伊。\n呼儿握手长太息，不见侬家数口饥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70629,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"甲子语溪闵雨四首 其三","author":"黄干","text":"牛女盈盈河汉傍，清风肃肃吹罗裳。\n朱门达旦听歌曲，莫遣浓阴蔽夜凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70630,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"甲子语溪闵雨四首 其二","author":"黄干","text":"塘中龙骨高数层，龟坼田中纵复横。\n青裙箬笠倚车卧，但有空车无水声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70631,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"甲子语溪闵雨四首 其一","author":"黄干","text":"樯头五两摇空飞，船头百丈牵何迟。\n数篙塘水清可涉，故乡千里归何时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70632,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"会南禅游邹氏园和知丞韵","author":"黄干","text":"杯酒联翩臭味同，横枝疏影费天工。\n千林落木人烟绝，独倚斜阳对晚风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70633,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绍熙庚戌十月偕赵仲宗舜和潘谦之曾鲁仲游九峰芙蓉寿山纪行十首 其八 过翠微院","author":"黄干","text":"古寺残僧少，孤村碧树围。\n明朝山下路，愁绝望烟归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70634,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绍熙庚戌十月偕赵仲宗舜和潘谦之曾鲁仲游九峰芙蓉寿山纪行十首 其十 寿山","author":"黄干","text":"石为文多招斧凿，寺因野烧转荧煌。\n世间荣辱不足较，日暮天寒山路长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70635,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读史记荆卿传","author":"黄干","text":"说与男儿莫爱身，箪瓢陋巷不为贫。\n古来亭士君知否，拚得头颅斫与人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70636,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宿庐阜归宗题正觉禅师","author":"黄干","text":"稽首归宗正觉师，长怀千里鬓如丝。\n早知具眼番成闇，不作人间了事痴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70637,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄郑维忠叶云叟诸友","author":"黄干","text":"村村箫鼓竞龙舟，萸菊岩前倚晚秋。\n老懒焚香书一卷，淡烟疏竹月侵楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70638,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谒陆宣公祠于嘉兴府学门外二首 其二","author":"黄干","text":"徘徊无处谒精庐，义胆忠肝一卷书。\n昏主乱时公尚尔，清朝平世合何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70639,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谒陆宣公祠于嘉兴府学门外二首 其一","author":"黄干","text":"年来风俗软如绵，再拜公祠气凛然。\n莫是平生太忠鲠，只今犹斥学宫前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70640,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜雨用前韵 其四","author":"黄干","text":"山中书生休浪悲，燮调自有皋与伊。\n清香一瓣来天竺，更把民饥作己饥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70641,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜雨用前韵 其三","author":"黄干","text":"睡觉歌声古道傍，有人中夜揽衣裳。\n床头斗酒聊自酌，不为书窗一夜凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70642,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜雨用前韵 其一","author":"黄干","text":"莫愁尘土压天飞，六月栽田未是迟。\n待得麦麻收拾后，通宵好雨定知时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70643,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜雨用前韵 其二","author":"黄干","text":"云霓天外起层层，毕月相随彻夜横。\n费得天公能几力，数州愁苦变歌声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70644,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答刘正之见招四绝 其二","author":"黄干","text":"昔年曾学屏山下，炯炯胡刘风味长。\n满目青山非故国，人生熟处尚难忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70645,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答刘正之见招四绝 其一","author":"黄干","text":"求田问舍两参差，木坏山颓万古悲。\n多谢刘郎能馆我，短檠疏雨听清规。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70646,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答刘正之见招四绝 其三","author":"黄干","text":"君因戆直招时论，我以疏愚厌俗纷。\n万事不须开著眼，苍山白醑对西曛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70647,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答刘正之见招四绝 其四","author":"黄干","text":"石马台边森古木，昼寒亭下锁晴烟。\n紫阳不作远庵死，一醉同君话昔年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70648,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢潘谦之二首 其二","author":"黄干","text":"绨袍恋恋故人情，寒谷潇潇春意生。\n寂寞穷儒应易足，床头鼻息便雷鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70649,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢潘谦之二首 其一","author":"黄干","text":"生平不作温饱计，岁晚宁愁衣褐无。\n一夜娇儿啼彻晓，始知寒色已侵肤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70650,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"嘉兴道间二首 其二","author":"黄干","text":"征途不寐辄终夕，故里无书今几时。\n离别因知双鬓改，饥寒解使寸心悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70651,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代王维谨挽李察院二首 其二","author":"黄干","text":"牛角短歌头半白，龙门峻级眼常青。\n一官多是春风力，千里俄惊秋泪零。\n坐想德容今寂寞，梦回耳语尚丁宁。\n夜台虽闭公长在，有子能存旧典刑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70652,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代王维谨挽李察院二首 其一","author":"黄干","text":"关洛萧条南渡日，龟山往事属龙津。\n过庭诗礼传宗旨，盖世功名付后人。\n风宪只身中与外，清忠壮节晚如新。\n崇兰香歇玉刚折，定与天皇作侍臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70653,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代良夫人二首 其二","author":"黄干","text":"闻道夫人遣子时，丁宁捧檄是归期。\n青衫到手非难事，白发惊心祗自悲。\n长翣忍听蒿里句，短檠休唱蓼莪诗。\n九原精爽应长在，列戟松楸莫恨迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70654,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代良夫人二首 其一","author":"黄干","text":"早岁为儒读国风，夫人高节有谁同。\n至今桑梓传家法，便说蘋蘩力妇功。\n闺内衾裯长自苦，堂前滫瀡得能丰。\n欲知淑德碑何在，只听乡人叹息中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70655,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代曾鲁仲挽蒋同叔母二首 其二","author":"黄干","text":"不乐何蕃岁一归，欧阳越客饱京师。\n腰间未许印如斗，堂上还惊鬓已丝。\n男子但知三釜计，人生合是百年期。\n他时此恨凭谁说，见著鱼轩心转悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70656,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代曾鲁仲挽蒋同叔母二首 其一","author":"黄干","text":"釜灶朝晡百俭艰，卮匜滫瀡悦慈颜。\n欲知妇顺妻贤处，尽在姑啼夫哭间。\n庭下芝兰方擢秀，堂前松桧未应悭。\n空馀马鬣崔嵬在，及见春风衣锦还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70657,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和江西王仓中秋赏月韵","author":"黄干","text":"明晦从渠造物悭，好天佳月静时看。\n一轮天外长明彻，万象胸中自屈盘。\n星逐使来随处见，霜侵台迥逼人寒。\n休观玉免频频捣，活国须公九转丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70658,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绍熙庚戌十月偕赵仲宗舜和潘谦之曾鲁仲游九峰芙蓉寿山纪行十首 其四 十日值雨","author":"黄干","text":"催粥华鲸彻翠微，觉来屋瓦白差差。\n初疑淡月霜天晓，忽失前山云幕垂。\n田父腰镰禾欲耳，行人策杖足如锥。\n老僧莫笑芒鞋苦，破釜生尘侬更悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70659,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绍熙庚戌十月偕赵仲宗舜和潘谦之曾鲁仲游九峰芙蓉寿山纪行十首 其五 早观龙湫","author":"黄干","text":"夜宿群峰里，朝游大石湫。\n寒潭飞薄雾，叠障泻洪流。\n侧径苍苔滑，丛祠古木幽。\n神龙好高卧，云雨不胜愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70660,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绍熙庚戌十月偕赵仲宗舜和潘谦之曾鲁仲游九峰芙蓉寿山纪行十首 其三 夜宿九峰寺","author":"黄干","text":"冥逐归云入远山，九峰环立似人间。\n摩挲石刻元和体，矍铄僧谭宣政间。\n往古来今浑昨梦，只鸡斗酒强开颜。\n明朝酌取龙湫水，直上层霄不复还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70661,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绍熙庚戌十月偕赵仲宗舜和潘谦之曾鲁仲游九峰芙蓉寿山纪行十首 其六 宿芙蓉寺","author":"黄干","text":"万叠云山踏雨来，白云依旧冒山隈。\n尊罍罄尽客怀恶，衣屦沾濡僧意猜。\n默坐香炉烟起伏，喜闻灵洞石崔嵬。\n五更清磬丁东响，参斗横空天四开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70662,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽云门郑君","author":"黄干","text":"结友云门日，曾闻谷口翁。\n松肥三径雨，鲈熟一丝风。\n行业乡闾敬，诗书子姓同。\n论心独馀恨，秋草对碑丰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70663,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽李尚书母太淑人 其二","author":"黄干","text":"紫橐光先烈，青衫拾世科。\n家声今益振，母训昔应多。\n方听焚舟誓，俄闻鼓缶歌。\n定非孙与祖，一战一言和。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70664,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽李尚书母太淑人 其一","author":"黄干","text":"少壮闻忠教，生平阅险夷。\n篆烟长寂寞，驺从任驱驰。\n尘俗浑无染，湖山每自怡。\n儒冠惭佛学，列妇胜男儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70665,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽新市张监酒三首 其三","author":"黄干","text":"淡薄心无累，行藏惠及人。\n诗书长孙子，雍睦化比邻。\n我亦尘中客，来司瓮底春。\n从公得遗范，惆怅重书绅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70666,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽新市张监酒三首 其二","author":"黄干","text":"捧檄来新市，逢人说旧官。\n腊残千盏熟，春到万家欢。\n不见文移急，惟闻酒禁宽。\n摩挲石梁柱，俛仰叹才难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70667,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽新市张监酒三首 其一","author":"黄干","text":"曲江人已矣，风采独依然。\n薄宦何曾显，英名到处传。\n诸公交荐士，造物竟遗贤。\n穷达君应悟，怡神向九泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70668,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽潘孺人 其二","author":"黄干","text":"红云照水春将暮，皓月盈盈院落深。\n正是佳人行乐地，翻令公子独伤心。\n床头琴瑟空长在，眼底音容无处寻。\n寒食纸钱飞满野，一声薤露涕沾襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70669,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"又用前韵谢叶宰 其四","author":"黄干","text":"世事年来最可悲，开口不得洛与伊。\n两君论交大左计，芋栗不足充人饥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70670,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与胡西园","author":"黄干","text":"白露下百草，玄云翳崇冈。\n游子暮何之，倏若孤雁翔。\n朝发长沙渚，夕息湘山阳。\n飞鸣念俦侣，慷慨增悲伤。\n故人怀我深，远寄金玉章。\n开缄且疾读，慰此饥渴肠。\n是时焞中火，朔风扫枯黄。\n岁月能几何，皋兰结微霜。\n静观天地间，至理何昭彰。\n乾行固不息，坤应还无疆。\n两曜各循环，皦皦临四方。\n人道政如斯，愿君勉其常。\n脂车策良马，日暮道正长。\n徒仆审驱驰，前途畏榛荒。\n劣质苦难任，白云怀故乡。\n南山一舍隔，动若参与商。\n大舶漾中流，矫首空西望。\n昆弟真可人，行乐毋相忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70671,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"凡今之人莫如兄弟诗","author":"黄干","text":"物理须深玩，人心定不凡。\n棣华春竞秀，鸿影暮相衔。\n天性人为贵，同胞岂异心。\n疾行迷后长，思昔更伤今。\n忆昔孩提日，堂前聚戏嬉。\n利心驱逸马，分背欲何之。\n富贵真馀事，儿孙亦后身。\n四支先自贼，骈拇若为人。\n矢束折应难，叶密根无托。\n斯道固昭然，叹息人何莫。\n儒衣而儒冠，满口谈诗书。\n君看阋墙心，异类诚不如。\n我行箕山颠，上有贤弟兄。\n高节振颓俗，馀芳丐后生。\n二父及诸郎，异世真一体。\n赋诗岂遗君，自以警不弟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70672,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代季亨二首 其二","author":"黄干","text":"慇勤慈母手中线，缝作行人身上衣。\n待换青衫朝日去，谁知白帽带星归。\n别时早觉终天诀，底事能堪跬步违。\n一路显亲须努力，九原荒草恨依依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70673,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代季亨二首 其一","author":"黄干","text":"枌榆接影一牛鸣，淑德相传到后生。\n三世只身长婉娩，两儿双泪遽纵横。\n蘋蘩春涧情何切，机杼秋堂眼倍明。\n细读古今贤妇传，谁家騃女亦书名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70674,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"生平","author":"黄干","text":"生平因寡合，岁晚交更少。\n非干世俗薄，自是志量小。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70675,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"石门","author":"黄干","text":"吴越天下富，京畿游侠乡。\n陇亩尽膏腴，第宅皆侯王。\n世言苏湖熟，沾丐及四方。\n自我来石门，触目何凄凉。\n清晨开务门，有酒谁复尝。\n累累挈妻子，汲汲求糟糠。\n父老称近年，十载尝九荒。\n聚落成丘墟，少壮争逃亡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70676,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再和实之喜雨呈正之","author":"黄干","text":"苦海渺无涯，火宅常自焚。\n青衫不疗饥，白首非工文。\n勉策疲驽姿，舍己为人耘。\n造物真小儿，苦乐胡不均。\n突如四月时，梅雨成炎蒸。\n安得玉烛调，一晦复一明。\n中夜忽自悟，感慨若有神。\n有名汝不趋，有利汝不奔。\n独与迂阔友，卜邻向东屯。\n燕坐想羲皇，浩歌发商声。\n床头有浊醪，啸咏聊自倾。\n又如苦旱中，一雨涧壑盈。\n草木回春姿，万象皆更新。\n君今东屯成，拙寝复几兴。\n我亦侧西流，草阁时共凭。\n长想千载上，依依耦耕人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70677,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"刘正之宜楼四章 其四","author":"黄干","text":"山以静故高，水以静故深。\n福禄岂外求，万感皆人心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70678,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"刘正之宜楼四章 其三","author":"黄干","text":"君家两宁馨，翠竹栖鸾凤。\n筦簟燕新居，孔释复抱送。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70679,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"刘正之宜楼四章 其二","author":"黄干","text":"屏山重回首，日暮起长思。\n鸿雁来翩翩，共赋棠棣诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70680,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]