[{"title":"颂一百则 其五十一","author":"释重显","text":"钵里饭，桶里水，多口阿师难下嘴。\n北斗南星位不殊，白浪滔天平地起。\n拟不拟，止不止，个个无裈长者子。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17190,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂一百则 其八十八","author":"释重显","text":"咄这维摩老，悲生空懊恼。\n卧疾毗耶离，全身太枯槁。\n七佛祖师来，一室且频扫。\n请问不二门，当时便靠倒。\n不靠倒，金毛师子无处讨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17191,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂一百则 其六","author":"释重显","text":"去却一，拈得七，上下四维无等匹。\n徐行踏断流水声，纵观写出飞禽迹。\n草茸茸，烟羃羃，空生岩畔花狼藉。\n弹指堪悲舜若多，莫动著，动著三十棒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17192,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂一百则 其九十三","author":"释重显","text":"遍身是，通身是，拈来犹较十万里。\n展翅崩腾六合云，搏风鼓荡四溟水。\n是何埃垲兮忽生，那个毫釐兮未止。\n君不见网珠垂范影重重，棒头手眼从何起。\n喝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17193,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂一百则 其三十一","author":"释重显","text":"镇州出大萝卜，天下衲僧取则。\n只知自古至今，争辨鹄白乌黑。\n贼贼，衲僧鼻孔曾拈得。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17194,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂一百则 其四十","author":"释重显","text":"花药栏，莫颟顸，星在秤兮不在盘。\n便与么，太无端，金毛师子大家看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17195,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂一百则 其五","author":"释重显","text":"牛头没，马头回，曹溪镜里绝尘埃。\n打鼓看来君不见，百花春至为谁开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17196,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂一百则 其五十六","author":"释重显","text":"兔马有角，牛羊无角。\n绝毫绝釐，如山如岳。\n黄金灵骨今犹在，白浪滔天何处著。\n无处著，只履西归曾失却。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17197,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂一百则 其三十八","author":"释重显","text":"三界无法，何处求心。\n白云为盖，流泉作琴。\n一曲两曲无人会，雨过夜堂秋水深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17198,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂一百则 其七十三","author":"释重显","text":"却请和尚道，虎头生角出荒草。\n十洲春尽花凋残，珊瑚树林日杲杲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17199,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂一百则 其八十一","author":"释重显","text":"呼即易，遣即难，互换机锋子细看。\n劫石固来犹可坏，沧溟深处立须乾。\n乌臼老，乌臼老，几何般，与他杓柄太无端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17200,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂一百则 其六十七","author":"释重显","text":"问曾不知，答还不会。\n月冷风高，古岩寒桧。\n堪笑路逢达道人，不将语默对。\n手把白玉鞭，骊珠尽击碎。\n不击碎，增瑕颣，国有宪章，三千条罪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17201,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂一百则 其八十二","author":"释重显","text":"尽机不成瞎，按牛头吃草。\n四七二三诸祖师，宝器持来成过咎。\n过咎深，无处寻，天上人间同陆沉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17202,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂一百则 其八十七","author":"释重显","text":"麈中麈，君看取。\n下一箭，走三步。\n五步若活，成群趁虎，正眼从来付猎人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17203,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂一百则 其六十","author":"释重显","text":"水洒不著，风吹不入。\n虎步龙行，鬼号神泣。\n头长三尺知是谁，相对无言独足立。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17204,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂一百则 其四十七","author":"释重显","text":"虚堂雨滴声，作者难酬对。\n若谓曾入流，依前还不会。\n会不会，南山北山转滂霈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17205,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂一百则 其四十五","author":"释重显","text":"一拽石，二般土，发机须是千钧弩。\n象骨老师曾辊毬，争似禾山解打鼓。\n报君知，莫莽卤，甜者甜兮苦者苦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17206,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂一百则 其六十六","author":"释重显","text":"机轮曾未转，转必两头走。\n明镜忽临台，当下分妍丑。\n妍丑分兮迷云开，慈门何处生尘埃。\n因思良马窥鞭影，千里追风唤得回。\n唤得回，鸣指三下。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17207,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂一百则 其十八","author":"释重显","text":"无缝塔，见还难，澄潭不许苍龙蟠。\n层落落，影团团，千古万古与人看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17208,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂一百则 其五十二","author":"释重显","text":"末后句，为君说，明暗双双底时节。\n同条生也共相知，不同条死还殊绝。\n还殊绝，黄头碧眼须甄别。\n南北东西归去来，夜深同看千岩雪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17209,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂一百则 其五十八","author":"释重显","text":"似海之深，如山之固。\n蚊虻弄空里猛风，蝼蚁撼于铁柱。\n拣兮择兮，当轩布鼓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17210,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂一百则 其一○二","author":"释重显","text":"要平不平，大巧若拙。\n或指或掌，倚天照雪。\n大冶兮磨砻不下，良工兮拂拭未歇。\n别别，珊瑚枝枝撑著月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17211,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂一百则 其十","author":"释重显","text":"两喝与三喝，作者知机变。\n若谓骑虎头，二俱成瞎汉。\n谁瞎汉，拈来天下与人看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17212,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂一百则 其九十七","author":"释重显","text":"泥佛不度水，神光照天地。\n立雪如未休，何人不雕伪。\n金佛不度炉，人来访紫胡。\n牌中数个字，清风何处无。\n木佛不度火，常思破灶堕。\n杖子忽击著，方知辜负我。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17213,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂一百则 其九十二","author":"释重显","text":"盲聋音哑，杳绝机宜。\n天上天下，堪笑堪悲。\n离朱不辨正色，师旷岂识玄丝。\n争如独坐虚窗下，叶落花开自有时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17214,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂一百则 其九十六","author":"释重显","text":"头兮第一，第二卧龙。\n不鉴止水，无处有月。\n波澄有处，无风浪起。\n棱禅客，棱禅客，三月禹门遭点额。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17215,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂一百则 其八十三","author":"释重显","text":"超谭禅客问偏多，缝罅披离见也么。\n糊饼?来犹不住，至今天下有淆讹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17216,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂一百则 其八十","author":"释重显","text":"列圣丛中作者知，法王法令不如斯。\n会中若有仙陀客，何必文殊下一搥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17217,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂一百则 其十四","author":"释重显","text":"对一说，太孤绝，无孔铁锤重下楔。\n阎浮树下笑呵呵，昨夜骊龙拗角折。\n别别，韶阳老人得一橛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17218,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂一百则 其八十五","author":"释重显","text":"投子投子，机轮无阻。\n放一得二，同彼同此。\n可怜无限弄潮人，毕竟还落潮中死。\n忽然活百川，倒流闹??。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17219,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂一百则 其五十","author":"释重显","text":"透网金鳞，休去滞水。\n摇乾荡坤，振鬣摆尾。\n千尺鲸喷洪浪飞，一声雷振清飙起。\n清飙起，天上人间知几几。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17220,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂一百则 其二","author":"释重显","text":"至道无难，言端语端。\n一有多种，二无两般。\n天际日上月下，槛前山深水寒。\n髑髅识尽喜何立，枯木龙吟消未乾。\n难难，拣择明白君自看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17221,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂一百则 其三十二","author":"释重显","text":"此错彼错，切忌拈却。\n四海浪平，百川潮落。\n古策风高十二门，门门有路空萧索。\n非萧索，作者好求无病药。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17222,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂一百则 其七十四","author":"释重显","text":"和尚也并却，龙蛇阵上看谋略。\n令人长忆李将军，万里天边飞一鹗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17223,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂云门九九八十一 其二","author":"释重显","text":"九九八十一，大勋不竖赏。\n若谓无詨讹，金刚曾合掌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17224,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂药山师子话送僧","author":"释重显","text":"厇诉金毛师子子，栴檀林下青莎里。\n置也置也威自全，一出六出眉剔起。\n非拟拟，知几几，星流不问三千里。\n天外风清哮吼时，为君吸尽西江水。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17225,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄于秘丞 其二","author":"释重显","text":"飞瀑千万层，五月状冰雪。\n将期云雾开，永夜对孤月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17226,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄白云长老","author":"释重显","text":"八纮云静明寥泬，夜永松堂对寒月。\n凋残片叶坠虚庭，冷寂何人立深雪。\n因忆钱唐郜禅者，十载岩栖曾未下。\n分飞谁谓绝相同，远念冥冥欲奚写。\n忽闻赴请之仙都，声光蔼蔼登清途。\n孰云天骥骤方外，自笑大鹏离海隅。\n乾坤窄，乾坤窄，湛卢潜射斗牛白。\n茫茫无限未归人，到必为时除点额。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17227,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄灵隐惠明禅师 其二","author":"释重显","text":"海峤生片云，有时忽如盖。\n不挂飞来峰，悠悠拟何待。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17228,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄钱唐观音朋山主","author":"释重显","text":"远念依依阙附书，还同秋水淡相于。\n冲云况是曾无定，几掩寒蟾出太虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17229,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄崇寿怀长老歌","author":"释重显","text":"寂住峰兮触星斗，寂住师兮古为道。\n死中得活未轻酬，不许夜行投晓到。\n蔼蔼声光一百年，吾其后兮吾其先。\n振领提纲笑多事，掩扉塞路空依然。\n龙朔老卢同兀兀，土为貌兮金作骨。\n万国争求肯便行，我要重新敲铁佛。\n东西南北休云识，枯槁冥冥颇相忆。\n天外清风结阵来，狂歌远寄从抛掷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17230,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答天童新和尚","author":"释重显","text":"中峰深且寒，攲接海边岛。\n松凋不死枝，花坼未萌草。\n飞瀑吼蛟宫，幽径分鸟道。\n伊余空寂徒，浮光寄枯槁。\n冥游天地间，谁兮可寻讨。\n孤立云霞外，谁兮可长保。\n兹来仁者来，还称太白老。\n荷策扣岩扃，重席展怀抱。\n示我商颂清，休誇郢歌好。\n报投惭抒辞，难以论嘉藻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17231,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答忠禅者","author":"释重显","text":"一字七字三五字，万象穷来不为据。\n夜深月白下沧溟，搜得骊珠有多许。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17232,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赋冲云鹞送僧","author":"释重显","text":"侧翼雄飞天势阔，电闪星流太轻脱。\n南北东西相对看，千里万里阿喇喇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17233,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赋病鹤送奉伦禅者","author":"释重显","text":"欲飞飞未得，冷泊杉松枝。\n如何垂天云，远远同一涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17234,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬行奯长老","author":"释重显","text":"黄金为骨松为姿，道高曾鄙天人师。\n有言遗我千古奇，无人知，石虎吞却木羊儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17235,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"僧问四宾主因而有颂颂之 其七","author":"释重显","text":"如何是主中主。\n云大千捏聚，又曰揭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17236,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"僧问四宾主因而有颂颂之 其三","author":"释重显","text":"如何是宾中主。\n云兆分其五，又曰引。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17237,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"僧问四宾主因而有颂颂之 其五","author":"释重显","text":"如何是主中宾。\n云月带重轮，又曰收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17238,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"僧问四宾主因而有颂颂之 其一","author":"释重显","text":"如何是宾中宾。\n云满面埃尘，又曰噫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17239,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"暮冬夜坐寄岫禅者","author":"释重显","text":"碧落无片云，虚庭积深雪。\n负舂还有谁，彻曙对孤月。\n岩松影拂翠不断，瀑水声来听忽绝。\n岫禅岫禅知也如未知，八面清风远远待时说。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17240,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"暮冬感怀寄瑞岩禅师","author":"释重显","text":"雪水绕松槛，迟迟结清浅。\n病眼时懒开，幽情况难遣。\n故人久相别，飞文屡惭腼。\n仰谢十二峰，分照月如剪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17241,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"歌纪四明汪君信士","author":"释重显","text":"古君子兮道诸己，道器用兮合天理。\n同尘还若待时生，观象不知何处起。\n荆丛丛袭莪丛丛，孝兮悌兮非沚中。\n聚应落落滴仙露，散或泠泠扬士风。\n风之上兮风之下，近一指兮远一马。\n秋水澹交无限情，夜光照乘胡为者。\n伊予匪谓存馀力，咏高义兮困胸臆。\n巴歌百字岩叶书，飞寄汪门旧知识。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17242,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"歌送范阳卢君","author":"释重显","text":"范阳居士来鄞水，动地仙飙向人起。\n乳峰直上云霞开，步骤天衢到如此。\n茫茫尘世谁知交，当场问我非相饶。\n禅家毕竟无他事，古雪岩前曾未消。\n俄然怅望辞丛室，荷负难兮泪深溢。\n远幸流方且莫论，再得从容又何日。\n迢迢故国殊存想，冷碧柯山分指掌。\n况有觉雄华藏师，归去百城共游赏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17243,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"歌寄留英禅德","author":"释重显","text":"当时临际辞黄檗，或指河南或河北。\n英禅此日下中峰，机案曾焚笑仍则。\n九包一角惭称瑞，导月观星亦非意。\n争似韶阳振古风，半途未肯还希冀。\n归去来，归去来，飞泉浩浩声如雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17244,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠别太臻禅者","author":"释重显","text":"武陵山水何秘邃，元化功兮不容易。\n坛曾善卷韬龙光，洞亦桃花副麟趾。\n仍思昔日吾祖浩浩提纲宗，消息旷断寰宇空。\n又闻高大舜让公器，祥瑞却生芦苇丛。\n人由境兮冥道德，境有人兮分玉石。\n臻禅本自偃殊方，忽向其中诞孤迹。\n迢迢海甸来寻我，一十二年同冷坐。\n羽翼抟风今是时，拂尽天云乃飞过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17245,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"刘禹端公问云居雨从何来东平问官人风作何色 其一","author":"释重显","text":"雨从何来，风作何色。\n龙门万仞，曾留宿客。\n进退相将，谁遭点额。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17246,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"刘禹端公问云居雨从何来东平问官人风作何色 其二","author":"释重显","text":"风作何色，雨从何来。\n不用弹指，楼阁门开。\n波波棱棱，南方未回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17247,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"因香严和尚","author":"释重显","text":"我有一机，禅子须知。\n烁迦罗眼，总是胶黐。\n若人借问，伏惟伏惟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17248,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送仲卿禅德","author":"释重显","text":"高兮竺卿，秋水虚明。\n夫何之象，堪云指程。\n知吾不知，笑伽耶城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17249,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送尚辞","author":"释重显","text":"浮图之子，履道为贵。\n天兮地兮，何泰何否。\n动无饰非，静还雕伪。\n辞也云行，后生可畏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17250,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂一百则 其九十八","author":"释重显","text":"明珠在掌，有功者赏。\n胡汉不来，全无伎俩。\n伎俩既无，波旬失途。\n瞿昙瞿昙，识我也无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17251,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂一百则 其八","author":"释重显","text":"翠岩示徒，千古无对。\n关字相酬，失钱遭罪。\n潦倒保福，抑扬难得。\n唠唠翠岩，分明是贼。\n白圭无玷，谁辨真假。\n长庆相谙，眉毛生也。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17252,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂一百则 其五十九","author":"释重显","text":"象王嚬呻，师子哮吼。\n无味之谭，塞断人口。\n南北东西，乌飞兔走。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17253,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"疏古","author":"释重显","text":"我有面镜，到处悬挂。\n凡圣不来，谁上谁下。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17254,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"疏黑白无从","author":"释重显","text":"天地不仁，万化蠢蠢。\n若谓非缘，竹何从笋。\n发兮发兮，黑白是准。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17255,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬海宗二侍者 其一","author":"释重显","text":"荪之得兰，其道匪难。\n扶吾病起，如珠在盘。\n一兮二兮，自看谁看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17256,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬海宗二侍者 其二","author":"释重显","text":"兰之得荪，其道必存。\n扶吾病起，古风入门。\n二兮一兮，且论勿论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17257,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"静而善应 其一","author":"释重显","text":"觌面相见，不在多端。\n龙蛇易辨，衲子难瞒。\n金槌影动，宝剑光寒。\n直下来也，急著眼看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17258,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宗门三印 其三","author":"释重显","text":"印水印泥印空，衲子不辨西东。\n拨开向上一窍，千圣齐立下风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17259,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]