[{"title":"香山塔院","author":"范端杲","text":"招提登览处，野客兴偏浓。\n路入千层翠，窗涵万叠峰。\n溪声来小院，云影落长松。\n幸对老僧榻，焚香话苦空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33936,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春","author":"范镇","text":"绛萼梅初蕊，青条柳未阴。\n群芳自先后，一气本无心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33937,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"虎丘山僧","text":"昨夜虎丘山上望，一轮明月照苏州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33938,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"诗客","text":"翡翠列成千嶂碧，琉璃泻出两溪寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33939,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送程给事知越州","author":"郎淑","text":"三朝藩屏宠光频，四纪清名动搢绅。\n肯效怀章惊邸吏，独能持节屈戎人。\n千岩秀气归华藻，五岭殊功简紫宸。\n他日会居衡石地，荆州虽老实台臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33940,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"访徐冲晦","author":"郎简","text":"湖上访高士，径深行绿苔。\n应闻山犬吠，知是野人来。\n岸帻出相接，柴门自为开。\n林閒清话久，薄暮榜舟回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33941,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"访淩峰贤上人","author":"郏侨","text":"步入淩峰阁，寻师师未归。\n凭栏寂无语，唯见白云飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33942,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"访翠微邈上人","author":"郏侨","text":"行客倦奔驰，寻师到翠微。\n相看无俗语，一笑任天机。\n曲沼淡寒玉，横山锁落晖。\n情根枯未得，爱此几忘归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33943,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"为简公约赋素琴堂","author":"郏侨","text":"素琴之堂虚且清，素琴之韵沦杳冥。\n神闲意定默自鸣，宫商不动谁与听。\n堂中道人骨不俗，貌庞形端颜瑩玉。\n我尝见之醒心目，宁必丝桐弦断续。\n呜乎靖节已死不复闻，成亏相半疑昭文。\n阮手钟耳相吐吞，素琴之道讵可论。\n道人道人听我语，纷纷世俗谁师古。\n金徽玉轸方步武，虚堂榜名无自苦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33944,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"隐潭","author":"郏修辅","text":"在昔知何人，凿破青山骨。\n飞泉直下来，千尺泻倏忽。\n两壁苍翠间，一阵风雷突。\n傍无尘埃踪，中有蛟龙窟。\n寒气不可向，猛势岂能屈。\n安得当旱年，为霖济群物。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33945,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"失鹤","author":"郏亶","text":"久锁冲天鹤，金笼忽自开。\n无心恋池沼，有意出尘埃。\n鼓翼离幽砌，凌云上紫台。\n应陪鸾凤侣，仙岛任徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33946,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈王荆公","author":"郏亶","text":"十里松阴蒋子山，暮烟收尽梵宫宽。\n夜深更向紫微宿，坐久始知凡骨寒。\n一派石泉流沆瀣，数庭霜竹颤琅玕。\n大鹏汎有抟风便，还许鹪鹩附羽翰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33947,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"太仓隆福寺创观音院以诗百韵寄妙观大师且呈乡中诸亲旧","author":"郏亶","text":"珍重妙观师，书来再三读。\n不蒙促归计，乃忧旷笺牍。\n疑师未相知，待我尚尘俗。\n窃闻构新殿，东畔建廊屋。\n圣像已完布，舍利应祈祝。\n其馀虽未备，想亦渐周足。\n凡事在臻牢，慎勿尚遄速。\n堂基不厌高，磉窠须剩筑。\n閒架莫求大，却须择良木。\n椽桷贵稠直，楣栱要恒笃。\n但得规摹成，不忧无人续。\n五年纵未就，十年亦未蹙。\n今生不能了，后世亦修复。\n中庭要宽广，从舍须团簇。\n堂前种杉桧，方丈植慈竹。\n冬青绕周遭，夏初香馥郁。\n松篁又次之，潇洒快胸腹。\n园中开数径，晚步散蜷局。\n沿阶种药苗，乘閒采盈掬。\n川芎并地黄，幽兰间甘菊。\n泡水须麦门，熬汤要莺粟。\n蘘莪并狗杞，可以备蔬蔌。\n葵藿及鸡冠，可以悦心目。\n橘柚耀金苞，鎗旗资茗粥。\n四时皆要用，一奴长灌沃。\n地形或褊隘，后墙可展扑。\n东荣有园池，幽小类棋局。\n长土可裁削，凡材宜斩斸。\n使之稍清旷，可以蠲烦溽。\n秋至芙蕖红，春来鸭头渌。\n拨剌有鲂鲤，优游栖雁鹜。\n菱芡交加生，藻荇参差畜。\n采嚼齿牙香，牵挽襟裾绿。\n可以娱宾朋，可以施水陆。\n穿渠绕吾院，高下相联属。\n畎引发新声，潺湲若山谷。\n细事宜先治，大道在勤督。\n晨经劝群庶，夜讲诲幽独。\n午间略行道，睡魔可降伏。\n智灯照昏迷，慧刀破贪欲。\n若夫润泽事，在师更崇肃。\n为山贵覆篑，弹冠重初沐。\n荤膻勿放入，酒会当远逐。\n诸宅或相混，此诗可约束。\n庶令百里人，外悦更心服。\n从善若转圜，慕义如凑辐。\n悟者味醍醐，昧者隔纱縠。\n病者解颠倒，强者销忿毒。\n昆虫与草芥，一一沾慧福。\n顾此区区心，提孩已怀蓄。\n十三听先训，观音为眷属。\n二十学于寺，有意重盖覆。\n诵书小松下，夜惊老僧宿。\n老僧睡不稳，冥心生毁讟。\n梦一白衣人，戒言勿轻触。\n淩晨来谢我，道此颇惭恧。\n因知此大缘，圣心已潜属。\n故余昔欲仕，先此治轩塾。\n无端赴辟书，万里走炎燠。\n因缘论时事，乍荣复深辱。\n连延未能归，非敢恋方谷。\n上欲荣二亲，次欲芘诸族。\n妻封子可任，行将谢微禄。\n屯邅累见迫，神灵若相促。\n前日除永宁，君恩殊委曲。\n风物似京华，民醇无犴狱。\n月给五十千，岁租三百斛。\n兹事为未了，力辞求倅睦。\n尚念虽近乡，官身甚羁拲。\n黾勉终此任，庶几堪退缩。\n驱驰六十年，今朝方自赎。\n可为林下游，放旷比麋鹿。\n幽园创书馆，诸子弄黄轴。\n静室爇名香，与师评梵竺。\n寺僧必钦向，师应勤训育。\n童蒙傥来叩，我亦当善告。\n四季饭乡人，三冬办民浴。\n老姑与老姊，就可报恩鞠。\n季弟与群侄，日可讲驩穆。\n人生能几何，此乐难尽录。\n惟师本英豪，少小已良淑。\n传经建精蓝，饭众迈高躅。\n飘然西北来，声华满京毂。\n名山及钜院，诸公意勤缛。\n师皆力辞避，许我归林麓。\n兹惟吾二人，密约有昔夙。\n然能蹈此语，沙金石中玉。\n吾身方困踬，师誉正彪襮。\n吾归不为艰，师退良难卜。\n飞云谩出山，至宝欣还椟。\n素志幸已酬，忘言目相瞩。\n幽显若相佑，成就在忽倏。\n内外期两立，缁素更纯熟。\n惟吾二人者，可以共藏六。\n松江多波涛，西山鸣橡桷。\n台岭誇石梁，庐阜诧飞瀑。\n与师结真赏，轻举效鸿鹄。\n相将老此身，啸歌随寝餗。\n数终或归去，任缘顺所欲。\n却观今日事，犹如梦中烛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33948,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"早梅","author":"郑硕","text":"纷纷蜂蝶莫教知，竹外疏花一两枝。\n待得枝头春烂熳，便如诗到晚唐时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33949,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅氏梅楼","author":"郑上村","text":"山云楼头彻夜明，天风吹下读书声。\n劝君莫把离骚读，见说梅花恨未平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33950,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"牡丹亭","author":"郑士洪","text":"绿杨深处两三家，几度凭阑看紫霞。\n云锦已空烟水阔，转教人忆旧时花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33951,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"卧羊山","author":"郑士懿","text":"见羊疑是已叱石，见石翻疑未叱羊。\n非石非羊何所见，这些意思难商量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33952,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和徐梦发题超览亭","author":"郑士懿","text":"几年江海客，复此预筵宾。\n地胜山川别，天晴草树新。\n高歌千佛骇，一笑万家春。\n珍重梁间扁，时时为扫尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33953,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玉簪花","author":"郑大惠","text":"玉色瓷盆绿柄深，夜凉移向小窗阴。\n儿童莫讶心难展，未展心时玉似簪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33954,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"哀夏孝女","author":"郑大惠","text":"射生户，北山有虎何不射。\n岂不闻夏家有女年十五，随父樵薪入山坞，父行在前忽遭虎。\n女见父伤奋不惧，号泣逐之为虎语。\n逐之不已虎反顾，弃其父□衔女去。\n人言其父死亦苦，我言最苦是其女。\n想女失父逐虎时，眼不见虎惟见父。\n射生户，我今重告汝。\n汝之生，岂无父与母。\n勿谓官差尚犹豫，被尔甲兮张尔弩，况虎杀害人多天已怒。\n呜呼，虎害人多天若怒，天又何必使渠生下土。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33955,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"八声甘州","author":"郑子玉","text":"渐莺声近也，探年芳、河畔扼轻轮。\n旋东风染绿，绵绵平野，无际烟春。\n最苦夕阳天外，愁损倚阑人。\n无奈潇湘杳，留滞王孙。\n冷落池塘残梦，是送君归后，南浦消魂。\n赖东君能客，醉卧展香茵。\n尽教更、行人远，也相伴、连水复连云。\n关山道，算无今古，客恨长新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33956,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"郑子信","text":"古人随水去不返，此字与山留无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33957,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三贤祠","author":"郑子思","text":"飞凤屹立万仞壁，下有深渊不可测。\n问讯深渊有何物，骄然桀鷔护巢穴。\n寻常任意自出没，砥柱中流喷涛雪。\n舟人偶有毫厘失，挫手婴鳞即粉骨。\n每到王正上七日，昂头掉尾见金脊。\n霁严收怒了无迹，共与邦人供踏迹。\n滩头鸡卜人得吉，鼓吹鞦韆总春色。\n但见五采文焕发，尽是前贤醉鸦墨。\n今来古往几风月，要之勿用果何益。\n莫邪尚不终磨灭，筇杖一跃肯局蹐。\n我龙会见乘霹雳，起作甘霖沛天泽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33958,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题苕溪道观壁","author":"郑子覃","text":"纷纷红雨入苍苔，密荫新成莺友来。\n拟逐幽人梦蓬岛，一声裂竹故惊回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33959,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上众官","author":"郑广","text":"郑广有诗上众官，文武看来总一般。\n众官做官却做贼，郑广做贼却做官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33960,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"芍药","author":"郑云林","text":"与春相识亦多年，今岁春胡不到园。\n一任阶前无芍药，免教蜂蝶两争喧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33961,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"海棠","author":"郑云林","text":"贪诗闲费一生心，水际云崖到处寻。\n可惜春花吾老矣，海棠烟雨闭门深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33962,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西江月 寄张生","author":"郑云娘","text":"一片冰轮皎洁，十分桂魄婆娑。\n不施方便是何如。\n莫是嫦娥妒我。\n虽则清光可爱，奈缘好事多磨。\n仗谁传与片云呵。\n遮取霎时则个。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33963,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"调笑转踏 其二","author":"郑仅","text":"双桨。\n小舟荡。\n唤取莫愁迎叠浪。\n五陵豪客青楼上。\n不道风高江广。\n千金难买倾城样。\n那听绕梁清唱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33964,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"调笑转踏 其十二","author":"郑仅","text":"声切。\n恨难说。\n千里潮平春浪阔。\n梅风不解相思结。\n忍送落花飞雪。\n多才一去芳音绝。\n更对珠帘新月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33965,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"调笑转踏 其六","author":"郑仅","text":"相慕。\n酒家女。\n巧笑明眸年十五。\n当垆春永寻芳去。\n门外落花飞絮。\n银鞍白马金吾子。\n多谢结裙情素。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33966,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"调笑转踏 其十一","author":"郑仅","text":"调笑。\n楚江渺。\n粉面修眉花斗好。\n擎荷折柳争相调。\n惊起鸳鸯多少。\n渔歌齐唱催残照。\n一叶归舟轻小。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33967,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"调笑转踏 其九","author":"郑仅","text":"梦悄。\n翠屏晓。\n帐里薰炉残蜡照。\n赏心乐事能多少。\n忍听阳关声调。\n明朝门外长安道。\n怅望王孙芳草。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33968,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水调歌头 其二","author":"郑元秀","text":"园林夸富贵，红绿簇枝头。\n阳和毓秀，气劘屈贾压曹刘。\n翰墨场中独步，洒落胸中万卷，横截百川流。\n邈视青云侣，俯首看瀛洲。\n到如今，萦扃务，尚淹留。\n庙堂应得好语，早晚觐宸旒。\n从此立登要路，便可羽仪台阁，指日凤池游。\n岁岁蟠桃会，椿算八千秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33969,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"郑内翰","text":"西风吹得一枝生，昂首风前飞不去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33970,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江西宗派","author":"郑天锡","text":"西江一水活春茶，寒谷青灯夜拨花。\n人比建安多作者，诗从元祐总名家。\n宫商迭奏弦边雁，鼓吹都惭井底蛙。\n身在天南心太史，几番搔首夕阳斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33971,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄茅处士知至","author":"郑少连","text":"世争趋捷径，君独掩柴关。\n名利红尘老，诗书白日闲。\n情恬神气逸，琴淡古风还。\n谁识冥冥意，轩裳咳唾间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33972,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"思越人/朝天子 集句","author":"郑少微","text":"欲把长绳系日难。\n纷纷从此见花残。\n休将世事兼身事，须看人间比梦间。\n红烛继，艳歌阑。\n等闲留客却成欢。\n劝君更尽一杯酒，赢得浮生半日闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33973,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天","author":"郑少微","text":"谁折南枝傍小丛。\n佳人丰色与梅同。\n有花无叶真潇洒，不问胭脂借淡红。\n应未许，嫁春风。\n天教雪月伴玲珑。\n池塘疏影伤幽独，何似横斜酒盏中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33974,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"忆秦娥","author":"郑文妻","text":"花深深。\n一钩罗袜行花阴。\n行花阴。\n闲将柳带，细结同心。\n日边消息空沈沈。\n画眉楼上愁登临。\n愁登临。\n海棠开后，望到如今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33975,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"双笋石","author":"郑文宝","text":"流水惊前事，清风似昔时。\n重吟金谷咏，如见岘山碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33976,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过信阳军白雪驿","author":"郑文宝","text":"得罪先朝出粉围，五原功业有谁知。\n年馀放逐无人识，白雪关头一望时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33977,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绝句三首 其二","author":"郑文宝","text":"一夜西风旅雁秋，背身调镞索征裘。\n关山落尽黄榆叶，驻马谁家唱石州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33978,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绝句三首 其三","author":"郑文宝","text":"江云薄薄日斜晖，江馆萧条独掩扉。\n梁燕不知人事改，雨中犹作一双飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33979,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"香木槽","author":"郑文宝","text":"沉檀香植在天涯，贱等荆衡水面槎。\n何必为槽饲鸡犬，不如煨烬向豪家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33980,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"爽约","author":"郑文宝","text":"吟绕虚廊更向阑，绣窗灯影背栏干。\n燕栖莺宿无人语，一夜萧萧细雨寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33981,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寒食日经秀上人房","author":"郑文宝","text":"花时懒看花，来访野僧家。\n劳师击新火，劝我雨前茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33982,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题松滋东禅院","author":"郑文宝","text":"百花深处小危楼，千步苍苔到叶舟。\n一夜楚江寒食雨，离人白尽未归头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33983,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题缑氏山王子晋祠","author":"郑文宝","text":"秋阴漠漠秋云轻，缑氏山头月正明。\n帝子西飞仙驭远，不知何处作吹笙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33984,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送枝江秦长官罢秩","author":"郑文宝","text":"众论才名外，亲人似古人。\n官嫌容易达，家爱等闲贫。\n解印诗权在，移风泽国春。\n政声交不得，惭见数乡民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33985,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送曹纬刘鼎二秀才","author":"郑文宝","text":"旦夕春风老，离心共黯然。\n小舟闻笛夜，微雨养花天。\n手笔人皆有，曹刘世所贤。\n郴侯重才子，从此看莺迁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33986,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"郢城新亭","author":"郑文宝","text":"每到新亭即厌归，野香经雨长松围。\n四檐山色消繁暑，一局棋声下翠微。\n冰片角巾簪涧月，锦文拳石砌苔矶。\n近来学得笼中鹘，回避流莺笑不飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33987,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读江总传","author":"郑文宝","text":"行人慵过景阳宫，宫畔离离禾黍风。\n庭玉有花空怨白，井莲无步莫愁红。\n吟诗功业才虽大，亡国君臣道最同。\n争忍暮年归故里，纶竿回避钓鱼翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33988,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寒食访僧","author":"郑文宝","text":"客舍愁经百五春，雨馀溪寺绿无尘。\n金花开处鞦韆鼓，粉颊谁家斗草人。\n水上碧桃流片段，梁间新燕语逡巡。\n高僧不饮客携酒，来劝先朝放逐臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33989,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"温泉","author":"郑文宝","text":"潺湲如燎岭云阴，玉石鱼龙换古今。\n只见开元无事久，不知贞观用功深。\n笼无解语衣无雪，堆有黄沙粟有金。\n惆怅群邪负恩泽，始知夷甫少经心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33990,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绝句","author":"张耒","text":"亭亭画舸系春潭，直待行人酒半酣。\n不管烟波与风雨，载将离恨过江南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33991,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其六","author":"郑文宝","text":"杜曲花光浓似酒，灞陵春色老于人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33992,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其二","author":"郑文宝","text":"百草千花路，华风细雨天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33993,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其七","author":"郑文宝","text":"满帆西日催行客，一夜东风落楚梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33994,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其八","author":"郑文宝","text":"失意惯中迁客酒，多年不见侍臣花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33995,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其三","author":"郑文宝","text":"过关已跃樗蒲马，误喘犹惊顾兔屏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33996,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其十","author":"郑文宝","text":"人辞碧落春风晚，花老朱陵古渡头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33997,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其十一","author":"郑文宝","text":"承露气清驹送日，觚棱人静鸟呼风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33998,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其九","author":"郑文宝","text":"旧井霜封仙界橘，双溪晴落海边鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33999,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]