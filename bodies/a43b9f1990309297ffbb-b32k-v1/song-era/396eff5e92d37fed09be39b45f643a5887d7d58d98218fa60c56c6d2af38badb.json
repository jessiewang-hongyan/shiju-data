[{"title":"书怀","author":"李彭","text":"未作终焉计，怀哉兴不疏。\n逢人问息耗，阅岁叹乘除。\n老境来颜面，归家识此渠。\n攀缘俱断绝，何暇羡严徐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":660,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游石镜溪","author":"李彭","text":"石镜溪边树，金轮峰上云。\n贪看鱼弄影，不觉鸟迷曛。\n山态迤迤好，泉声细细分。\n银钩怀柱史，谁复振斯文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":661,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"怀秦处度","author":"李彭","text":"淮海紫髯叟，长吟独倚风。\n稍将芸辟蠹，应罢手书空。\n拄策旧寒涧，含毫馀老松。\n观云每怅望，苦念小安丰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":662,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"留题壁间","author":"李彭","text":"远意在丘壑，篮舆同此寻。\n干云绝壁秀，落涧幽泉音。\n卷祴尽开士，听法多珍禽。\n烟横半峰暝，信是忘归心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":663,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过蕲州故居","author":"李彭","text":"系马金沙树，衡茅俨暝途。\n沾襟问邻老，携手忆于菟。\n意逐前云远，情随归路迂。\n霜风吹晓角，梦听小单于。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":664,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄文若","author":"李彭","text":"仲氏客淮上，蓬窗忆聚星。\n云从望中密，雨逐去边零。\n赤壁念存没，怡亭几醉醒。\n归欤勤著脚，莫负读书萤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":665,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"用韦苏州神静师院韵寄微公","author":"李彭","text":"云卧衣裳冷，岩幽钟磬微。\n秋虫留雾牖，夕鸟下烟扉。\n无人瀹茗椀，坐我语斜晖。\n分携复经岁，长嗟志愿违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":666,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"将到九江先寄王环中","author":"李彭","text":"鹿门真大隐，不减远人村。\n净供维摩室，邻居祗树园。\n秦淮挥别泪，楚岸倒芳樽。\n牢落还相见，定能颜色温。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":667,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"新篘浊醪味严劲饮数盏大醉醉中作此诗","author":"李彭","text":"我生怜曲蘖，刚置自中年。\n破屋鸣春溜，阴崖响夜泉。\n兴来犹味著，饮罢剩狂颠。\n但病无风韵，聊堪栩栩眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":668,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"佚老堂为柳仲辉题","author":"李彭","text":"小隐寄岩谷，堂成笑傲中。\n虽无黄阁相，不羡黑头翁。\n倚杖鸥边雨，营诗雁背风。\n好闲多病处，清兴略相同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":669,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自宝峰还过长坑涧谷胜绝处","author":"李彭","text":"㶁㶁水循涧，悠悠山放云。\n关河元未远，境界有谁分。\n幽树花无赖，轻鸥声念群。\n个中须著句，传与世间闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":670,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"蓺玉轩","author":"李彭","text":"短李江南秀，虬须让帝孙。\n开怀仍好客，爱画复堪论。\n蓺玉风烟外，蓝溪气象存。\n他年多结绿，会看有乘轩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":671,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"豫章董瞿老求诗","author":"李彭","text":"珍重胶西相，风流后叶孙。\n退藏羞射策，旷远颇窥园。\n韵绝五峰秀，句奇三峡喧。\n羌山多胜践，周礼鲁俱存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":672,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"漫书","author":"李彭","text":"欧峰秋色外，一上一回高。\n践华谁云险，扪参未觉劳。\n云扉留野客，雾牖卧方袍。\n拄颊非吾事，何须似马曹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":673,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"钱盱眙赴上因乞诗","author":"李彭","text":"君自金张侣，从予嵇阮游。\n祗园分客袂，星渚系归舟。\n楚国烟霞晚，隋河榆柳秋。\n中州多汲引，行矣亦封侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":674,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次瑛上人韵","author":"李彭","text":"鼻祖真消息，风流出当家。\n观门亲杜顺，蹙指悟玄沙。\n顾我晚闻道，参同今未涯。\n悬知饮光笑，初不为拈花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":675,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题吴少冯听雨堂","author":"李彭","text":"碧涧寒侵屋，幽云夜度墙。\n贪看山入坐，惯听雨鸣廊。\n苦乏阴铿句，聊登孺子床。\n君非无汲引，寄傲学潜郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":676,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"喜得京师书信","author":"李彭","text":"檐间噪乌鹊，窗下集邕渠。\n喜有大梁使，能携小陆书。\n南烹饱薇蕨，北馔到庭除。\n得隽传消息，更看双鲤鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":677,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"追凉对酒","author":"李彭","text":"袢暑晚来歇，追凉聊解颜。\n星移团扇底，月动缥瓷间。\n蝉噪断仍续，鸟喧栖复还。\n幽人嗜清旷，只合卧湖山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":678,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上黄太史鲁直诗","author":"李彭","text":"扈圣当元祐，雄名独擅长。\n群公调玉烛，延阁近扶桑。\n挥洒惊雷雨，观瞻列堵墙。\n密云来北苑，珍果出明光。\n柱下惟青史，银台无露章。\n胡为随逐客，不作瑞斋房。\n岑寂金华省，萧条玉笋行。\n长庚万里去，大雅百夫望。\n老觉丹心壮，闲知清画长。\n珍蔬时入馔，荔子喜传芳。\n世故跏趺远，生涯啸傲傍。\n甘为剑外客，谁念太官羊。\n宣室二天诏，遗弓万国伤。\n老臣还召毕，陛下过成康。\n泽笏皆忠谠，弹冠多俊良。\n力辞佳吏部，直作老潜郎。\n忆在金华日，宁扶八座床。\n未能窥绛帐，颇识戏罗囊。\n候雁随阳去，奔驹度隙忙。\n千秋铜狄泣，万古玉人藏。\n诸阮衅犹在，蕲春痛未央。\n群雏极鹅雁，众口叹蛩螀。\n恨乏一廛地，归来屡择乡。\n亲交标鬼录，卜筑近僧坊。\n宿鸟频窥牖，行蜗每画梁。\n著渠上麟阁，耻学赋高唐。\n勤我十年梦，持公一瓣香。\n聊堪比游夏，何敢似班扬。\n尚愧管中见，应须肘后方。\n他时解颜笑，何止获升堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":679,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"观画山水","author":"李彭","text":"不爱边鸾爱李成，胸中成画自峥嵘。\n数行岛屿随人去，一段风烟向腕生。\n猿啼巫峡殷勤啸，雁到衡阳嘹唳鸣。\n我与群山成保社，直疑俱是旧经行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":680,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"远明阁饮","author":"李彭","text":"百尺游丝入座来，浮岚空翠入樽罍。\n谈谐自得江山助，觞咏不劳丝管催。\n滕阁风流今未远，南楼气味唤仍回。\n城鸦欲曙众客醉，木末阑干悬斗魁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":681,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"城上","author":"李彭","text":"城上栖乌尾毕逋，寒塘乌影过相呼。\n一天欲放山阴雪，六幅如观栗里图。\n问老自应师粲忍，扶衰初喜得封胡。\n香醪已熟糟床注，唤客无劳满眼酤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":682,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿万松兼示庆首座","author":"李彭","text":"步屧欣逢释梵宫，馀霞尚带日归红。\n峰前晚霭晚来积，岫外秋天秋满空。\n独鸟深藏攲牖树，幽花香逐下山风。\n青灯耿耿照无睡，赖有能诗老赞公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":683,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"邹天锡见过","author":"李彭","text":"议郎梁狱坐口语，置散投閒今放回。\n令节由来迫吹帽，幽园寻胜独登台。\n共歌昭代得银瓮，何暇著书名玉杯。\n此口惟堪饮醇酎，人间万事要寒灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":684,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次驹父游孺子亭韵","author":"李彭","text":"平居懒与慢相亲，寄傲行歌似隐沦。\n水退荷花饥残暑，秋来山色挽幽人。\n从雌鸂鶒窥黄帽，旁母凫雏映白蘋。\n兴罢归来去高卧，诗成聊复寄雷陈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":685,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"余久不饮酒偶饮殊适因和九弟韵","author":"李彭","text":"年侵畏病酒尊空，矧复听歌盛小丛。\n烟际鸟呼云际雨，花边蝶舞柳边风。\n向来怀抱愁眉外，今日欢娱醉眼中。\n何用花奴鸣羯鼓，新诗解秽思无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":686,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游云居三首 其一","author":"李彭","text":"山林投老更疏慵，尚有跻攀兴不穷。\n绝壑久忘蛇起陆，寒窗聊食雁来红。\n人方嵇阮似无愧，诗比阴何或未工。\n永夜不眠茶作祟，一灯明暗鸟呼风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":687,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游云居三首 其二","author":"李彭","text":"故岁新芽约略黄，重来败叶带飞霜。\n寻幽少脱尘劳梦，访旧颇熏知见香。\n深谷鸣钟云暗淡，半峰斜照树微茫。\n去天尺五今应是，璧月珠星挂上方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":688,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游云居三首 其三","author":"李彭","text":"群峰罗立紫崔嵬，无复市声蚊聚雷。\n远峤云屯飞鸟没，寒江烟敛健帆开。\n暖眠犊子阳关草，香逐蜂须阴谷梅。\n散策扪萝觅归路，摩挲苍石更裴回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":689,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵答董彦速","author":"李彭","text":"疏山翠气连眉妩，云外飞鸿点点愁。\n只在吴头并楚尾，非关张掖至幽州。\n著书繁露想成癖，待诏公车安足求。\n何日芒鞋寻旧约，兰旌荪楫共优游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":690,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过鹅湖怀师川","author":"李彭","text":"宝峰嵚崎青未了，枕下滩声走白沙。\n谷口不应无小隐，桃源真恐有人家。\n寒猿饮水避帆影，槁叶随波上桨牙。\n苦忆南州徐孺子，归舟天际暮云遮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":691,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春夜奉怀苏仲豫次陈无己韵赠仲豫","author":"李彭","text":"云外头陀是去年，已看汀草涨晴川。\n梦中未觉关河远，枕底忽闻钟鼓传。\n但可马曹聊拄颊，看渠凤阁竞加鞭。\n蓬窗想得司春瓮，一夜糟床酒注泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":692,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"季敌检校南村田","author":"李彭","text":"风吹䆉稏半传黄，准拟中厨云子香。\n潮水忽生添野水，山光便可接湖光。\n难求尘外餐霞侣，未试囊中辟谷方。\n径遣阿连聊检校，饥雷已复殷枯肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":693,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自豫章归书斋题壁","author":"李彭","text":"鸟乌声乐客还家，僮仆欢迎日未斜。\n小径潜筠新长笋，幽斋茂树晚多花。\n深惭曲蘖留春住，尚觉年颜老去赊。\n出处由来非细事，弄泉莫忘饱烟霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":694,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"泮宫曝书恭览御书故事行乡饮酒礼诸老率诸生皆在杨先生病足独不至赋诗见寄次韵答之","author":"李彭","text":"云汉昭回泮水边，诸生拜舞鳣堂前。\n老翁七十荷衣绿，弟子三千桂魄圆。\n乐正足伤何必虑，伏生口授尚能传。\n墨池载酒容他日，门外侯芭也可怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":695,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寒食日","author":"李彭","text":"幽人衣带病馀宽，终日萧然懒正冠。\n柳絮野莺春向晚，榆羹杏粥食犹寒。\n倦于杯杓生新兴，频有邻仪救老残。\n试把一尊招近友，放歌聊复罄交欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":696,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"李成德求乃翁挽诗","author":"李彭","text":"养疴丘壑玩寒藤，领略鸡园最上乘。\n射虎已惊生李广，登龙行复见元膺。\n九原烟雨悲埋玉，一代功名定伐冰。\n安得董狐南史笔，发扬潜德到云仍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":697,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戏次居仁见寄韵","author":"李彭","text":"长芦老人半圣号，眉毛不惜为谈空。\n静委耽禅如缚律，悬知选佛胜封公。\n影沉寒水雁无意，春入幽园花自红。\n欲向池阳参百问，却惭勾贼乱家风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":698,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄如壁上人","author":"李彭","text":"平生刚直隐长虹，收卷波澜说苦空。\n翰墨场中无李广，苾刍园里有支公。\n未应雪浪侵头白，想见丹砂入颊红。\n骢马他年焚谏草，看君妙手试宗风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":699,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵寄居仁二弟","author":"李彭","text":"老觉馀生如过鸟，何宁留迹寄长空。\n一丘一壑应还我，三沐三薰尽付公。\n病懒自知玄尚白，醉馀贪看碧成红。\n荀家兄弟俱奇绝，时听淮南好国风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":700,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵寄山伯萧老二弟","author":"李彭","text":"平原翁仲草蒙茸，种竹当年语竟空。\n群从嗟予真漫叟，象贤期女继汧公。\n别来江草唤愁碧，书到山阴称意红。\n瘗鹤银钩光照坐，行书正欲乞杨风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":701,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"卜居","author":"李彭","text":"有宅一区聊解嘲，清风历历自鸣瓢。\n买山作隐吾无取，为黍杀鸡何用招。\n鱼托么荷障斜日，箨随新竹上层霄。\n个中已了一生事，倒屣安能求度辽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":702,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄刘壮舆将赴唐州仪曹","author":"李彭","text":"五柳先生同旧科，壶觞终日盼庭柯。\n一行作吏事皆废，三径就荒君若何。\n问字有谁堪载酒，谈经许我或操戈。\n平生独自赏音者，听此殷勤劳者歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":703,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"奉赠瑛明发","author":"李彭","text":"上人霜鹘气横秋，法界重重幻笔头。\n已泛毗卢真觉海，戏裁佳句比汤休。\n云开鹤岭露兰若，波起洞庭霜橘洲。\n华发萧骚濒老境，多情猿鸟替人愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":704,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"驹父次予旧韵见贻复次韵","author":"李彭","text":"玉人皮里有阳秋，句入丹青顾虎头。\n压倒何劳讥陆陆，老衰得懒欲休休。\n支床梦破严城角，决眦风回落雁洲。\n遣兴竟须桑落酒，谈间莫著畔牢愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":705,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"用韵戏呈仲诚","author":"李彭","text":"蒲萄政复得凉州，底事微官章水头。\n早岁已能交北海，高怀乃肯顾韩休。\n手妙他时扫银夏，胸蟠佳处协沧州。\n谁言京兆画眉妩，后院悬知多莫愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":706,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄何斯举","author":"李彭","text":"传诗句句烂生光，妙手殷红入象床。\n本自奉常参定脉，定从儋耳悟神方。\n玉花自合归天厩，黄鹄应须下建章。\n见说年来真欲隐，转身一路直须强。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":707,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄张圣源","author":"李彭","text":"豪气向来回万牛，笔端衮衮楚江流。\n拾遗已见传三赋，平子不应吟四愁。\n柱后许时淹阔步，石渠看即副旁求。\n老夫病著苍崖底，细和尧民击壤讴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":708,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"还家寄吴世长兼简潘子真","author":"李彭","text":"江头杨柳曲尘姿，弄日晴空百尺丝。\n骑省风流还有赋，吴筠英妙更能诗。\n杀鸡为黍相期处，问雁呼卿政此时。\n下榻深惭徐孺子，非关劳者作歌辞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":709,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠九峰长老","author":"李彭","text":"已透韶阳向上关，蔬盂茗椀每开颜。\n头颅无意扫残雪，毳衲徒来着坏山。\n瘦节直疑青嶂立，道心常与白鸥闲。\n归来天末一回首，应在孤峰烟霭间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":710,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵答宝峰仁书记","author":"李彭","text":"袖手脱鞋悲太白，搴旗缚敌笑光颜。\n自知日面与月面，莫问南山与北山。\n独秀峰前云不隔，莲花洲下水长閒。\n还乡一曲真奇绝，与子终朝谈笑间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":711,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄抚州谢幼槃","author":"李彭","text":"别去鹧鸪思日寒，书来鹎鵊语林端。\n我怀求仲径方扫，君向山阴兴已阑。\n细读清诗如艳雪，何时痛饮剧奔湍。\n悬知作草非卖菜，要自心期礼数宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":712,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赋高明大使神功妙济真君祠","author":"李彭","text":"杨柳江头星宿疏，呼船梢子散林乌。\n烟横云捲树出没，天澹波平山有无。\n稚子总参三洞箓，病躯长佩五灵符。\n步虚声里瞻风马，颇觉神清到蕊珠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":713,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"代虚中作","author":"李彭","text":"晓悟无生贝叶经，起宗真喜得人英。\n风流定自压全楚，文物由来继两京。\n谢传平生处华屋，滕公俄忽掩佳城。\n哀荣赠典他年在，翁仲何知泪满缨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":714,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"听王散人琴","author":"李彭","text":"花边犹舞旧时蝶，屋角还鸣他日禽。\n但讶镜中颜色改，讵知门外岁华侵。\n一杯相属步兵酒，三叠共听中散琴。\n有慨余怀聊复写，雨馀汀草自青深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":715,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"南至","author":"李彭","text":"邻鸡戒晓暮钟催，老境俱从里许来。\n但喜书云占嗣岁，讵知缇室暗飞灰。\n和风欲上千门柳，协气先传五岭梅。\n弟劝兄酬真乐事，灯前细酌莫停杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":716,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"葺茅屋戏成","author":"李彭","text":"朔风卷我屋间茅，乌鹊含将去作巢。\n执扑鸠工课奴客，巡檐长啸望江郊。\n谢公五亩似能保，扬子一区聊解嘲。\n欲学参谋怀广厦，苦无凤觜续弦胶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":717,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"鸡冠","author":"李彭","text":"景纯机上为裁剪，浅碧深藏称意红。\n要与飞鸿同保社，肯随凡鸟在樊笼。\n鸣阶鼓翼何劳尔，介羽登场略未工。\n赤帻漫多安足数，尸乡反笑祝鸡翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":718,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"七夕用东坡韵","author":"李彭","text":"老火微微迹已陈，稚金稍稍欲亲人。\n蛛丝曲缀当时态，旧叶频浇见在身。\n女隶不堪严侍立，天孙谁识靓妆新。\n柳州太巧何须乞，怜汝题诗正角巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":719,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"早发开先入城至中道亲旧约予复还薄晚复自归宗入郡中","author":"李彭","text":"细听㶁㶁水流涧，静看悠悠山放云。\n涧底游鱼随叶下，岩间独树藉云分。\n残星已发招隐寺，落日愿低耶舍坟。\n却背孤村入城市，沙边深愧白鸥群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":720,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过广济","author":"李彭","text":"不到梅川已十年，市桥官柳尚依然。\n追寻耆旧知谁在，触拨清愁不欲眠。\n兰若霜钟犹唤睡，平阳宰木上参天。\n倦游客子心无际，眼尽岗原起暮烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":721,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"种仙茅","author":"李彭","text":"闻说仙茅胜钟乳，移根远自西山阿。\n岂独客来尘意少，更觉夜眠幽气多。\n避谤何须求薏苡，去家不减食藦萝。\n候门稚子成群后，矍铄仍看马伏波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":722,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"王子张以诗见报次其韵","author":"李彭","text":"卧看云生舍北篱，起来临镜慰衰迟。\n欲投未落鹤盘屿，将去还留鹊绕枝。\n天上汉庭劳梦寐，峤南殷鉴恐羁縻。\n蓝田丘壑仍孙在，胜日勤来赋好诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":723,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]