[{"title":"浣溪沙 其一","author":"欧阳修","text":"云曳香绵彩柱高。\n绛旗风飐出花梢。\n一梭红带往来抛。\n束素美人羞不打，却嫌裙慢褪纤腰。\n日斜深院影空摇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30560,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其三","author":"欧阳修","text":"湖上朱桥响画轮。\n溶溶春水浸春云。\n碧琉璃滑净无尘。\n当路游丝萦醉客，隔花啼鸟唤行人。\n日斜归去奈何春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30561,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其二","author":"欧阳修","text":"堤上游人逐画船。\n拍堤春水四垂天。\n绿杨楼外出秋千。\n白发戴花君莫笑，六么催拍盏频传。\n人生何处似尊前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30562,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其九","author":"欧阳修","text":"十载相逢酒一卮。\n故人才见便开眉。\n老来游旧更同谁。\n浮世歌欢真易失，宦途离合信难期。\n尊前莫惜醉如泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30563,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其六","author":"欧阳修","text":"红粉佳人白玉杯。\n木兰船稳棹歌催。\n绿荷风里笑声来。\n细雨轻烟笼草树，斜桥曲水绕楼台。\n夕阳高处画屏开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30564,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其四","author":"欧阳修","text":"叶底青青杏子垂。\n枝头薄薄柳绵飞。\n日高深院晚莺啼。\n堪恨风流成薄幸，断无消息道归期。\n托腮无语翠眉低。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30565,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浪淘沙令 其四","author":"欧阳修","text":"万恨苦绵绵。\n旧约前欢。\n桃花溪畔柳阴间。\n几度日高春垂重，绣户深关。\n楼外夕阳闲。\n独自凭阑。\n一重水隔一重山。\n水阔山高人不见，有泪无言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30566,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浪淘沙令 其一","author":"欧阳修","text":"把酒祝东风，且共从容。\n垂杨紫陌洛城东。\n总是当时携手处，游遍芳丛。\n聚散苦匆匆，此恨无穷。\n今年花胜去年红。\n可惜明年花更好，知与谁同？","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30567,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浪淘沙令 其二","author":"欧阳修","text":"花外倒金翘。\n饮散无憀。\n柔桑蔽日柳迷条。\n此地年时曾一醉，还是春朝。\n今日举轻桡。\n帆影飘飘。\n长亭回首短亭遥。\n过尽长亭人更远，特地魂销。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30568,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浪淘沙令 其三","author":"欧阳修","text":"五岭麦秋残。\n荔子初丹。\n绛纱囊里水晶丸。\n可惜天教生处远，不近长安。\n往事忆开元。\n妃子偏怜。\n一从魂散马嵬关。\n只有红尘无驿使，满眼骊山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30569,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浪淘沙令 其五","author":"欧阳修","text":"今日北池游。\n漾漾轻舟。\n波光潋滟柳条柔。\n如此春来春又去，白了人头。\n好妓好歌喉。\n不醉难休。\n劝君满满酌金瓯。\n纵使花时常病酒，也是风流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30570,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"盐角儿 其一","author":"欧阳修","text":"增之太长，减之太短，出群风格。\n施朱太赤，施粉太白，倾城颜色。\n慧多多，娇的的。\n天付与、教谁怜惜。\n除非我、偎著抱著，更有何人消得。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30571,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"盐角儿 其二","author":"欧阳修","text":"人生最苦，少年不得，鸳帏相守。\n西风时节，那堪话别，双蛾频皱。\n暗消魂，重回首。\n奈心儿里、彼此皆有。\n后时我、两个相见，管取一双清瘦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30572,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"减字木兰花","author":"欧阳修","text":"伤怀离抱。\n天若有情天亦老。\n此意如何。\n细似轻丝渺似波。\n扁舟岸侧。\n枫叶荻花秋索索。\n细想前欢。\n须著人间比梦间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30573,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"减字木兰花 其四","author":"欧阳修","text":"画堂雅宴。\n一抹朱弦初入遍。\n慢捻轻笼。\n玉指纤纤嫩剥葱。\n拨头憁利。\n怨月愁花无限意。\n红粉轻盈。\n倚暖香檀曲未成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30574,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"减字木兰花 其五","author":"欧阳修","text":"歌檀敛袂。\n缭绕雕梁尘暗起。\n柔润清圆。\n百琲明珠一线穿。\n樱唇玉齿。\n天上仙音心下事。\n留往行云。\n满坐迷魂酒半醺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30575,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"减字木兰花","author":"欧阳修","text":"去年残腊。\n曾折梅花相对插。\n人面而今。\n空有花开无处寻。\n天天不远。\n把酒拈花重发愿。\n愿得和伊。\n偎雪眠香似旧时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30576,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"减字木兰花","author":"欧阳修","text":"年来方寸。\n十日幽欢千日恨。\n未会此情。\n白尽人头可得平。\n区区堪比。\n水趁浮萍风趁水。\n试望瑶京。\n芳草随人上古城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30577,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"减字木兰花 其三","author":"欧阳修","text":"楼台向晓。\n淡月低云天气好。\n翠幕风微。\n宛转梁州入破时。\n香生舞袂。\n楚女腰肢天与细。\n汗粉重匀。\n酒后轻寒不著人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30578,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"惜芳时/思归乐","author":"欧阳修","text":"因倚兰台翠云亸。\n睡未足、双眉尚锁。\n潜身走向伊行坐。\n孜孜地、告他梳裹。\n发妆酒冷重温过。\n道要饮、除非伴我。\n丁香嚼碎偎人睡，犹记恨、夜来些个。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30579,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚泊岳阳","author":"欧阳修","text":"卧闻岳阳城里钟，系舟岳阳城下树。\n正见空江明月来，云水苍茫失江路。\n夜深江月弄清辉，水上人歌月下归。\n一阕声长听不尽，轻舟短楫去如飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30580,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"望江南/忆江南","author":"欧阳修","text":"江南蝶，斜日一双双。\n身似何郎曾傅粉，心如韩寿爱偷香。\n天赋与轻狂。\n微雨后，薄翅腻烟光。\n才伴游蜂来小院，又随飞絮过东墙。\n长是为花忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30581,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"望江南/忆江南 其一","author":"欧阳修","text":"江南柳，花柳两相柔。\n花片落时粘酒盏，柳条低处拂人头。\n各自是风流。\n江南月，如镜复如钩。\n似镜不侵红粉面，似钩不挂画帘头。\n长是照离愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30582,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梁州令","author":"欧阳修","text":"红杏墙头树。\n紫萼香心初吐。\n新年花发旧时枝，徘徊千绕，独共东风语。\n阳台一梦如云雨。\n为问今何处。\n离情别恨多少，条条结向垂杨缕。\n此事难分付。\n初心本谁先许。\n窃香解佩两沈沈，知他而今，记得当初否。\n谁教薄倖轻相误。\n不信道、相思苦。\n如今却恁空追悔，元来也会忆人去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30583,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清平乐","author":"欧阳修","text":"小庭春老。\n碧砌红萱草。\n长忆小阑闲共绕。\n携手绿丛含笑。\n别来音信全乖。\n旧期前事堪猜。\n门掩日斜人静，落花愁点青苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30584,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清商怨","author":"欧阳修","text":"关河愁思望处满。\n渐素秋向晚。\n雁过南云，行人回泪眼。\n双鸾衾裯悔展。\n夜又永、枕孤人远。\n梦未成归，梅花闻塞管。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30585,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔家傲","author":"欧阳修","text":"叶有清风花有露。\n叶笼花罩鸳鸯侣。\n白锦顶丝红锦羽。\n莲女妒。\n惊飞不许长相聚。\n日脚沈红天色暮。\n青凉伞上微微雨。\n早是水寒无宿处。\n须回步。\n枉教雨里分飞去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30586,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔家傲 其六","author":"欧阳修","text":"六月炎蒸何太盛。\n海榴灼灼红相映。\n天外奇峰千掌迥。\n风影定。\n汉宫圆扇初成咏。\n珠箔初褰深院静。\n绛绡衣窄冰肤莹。\n睡起日高堆酒兴。\n厌厌病。\n宿酲和梦何时醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30587,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔家傲 其七","author":"欧阳修","text":"七月新秋风露早。\n渚莲尚拆庭梧老。\n是处瓜华时节好。\n金尊倒。\n人间彩缕争祈巧。\n万叶敲声凉乍到。\n百虫啼晚烟如扫。\n箭漏初长天杳杳。\n人语悄。\n那堪夜雨催清晓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30588,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔家傲 其十四 七夕","author":"欧阳修","text":"喜鹊填河仙浪浅。\n云軿早在星桥畔。\n街鼓黄昏霞尾暗。\n炎光敛。\n金钩侧倒天西面。\n一别经年今始见。\n新欢往恨知何限。\n天上佳期贪眷恋。\n良宵短。\n人间不合催银箭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30589,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔家傲 其一","author":"欧阳修","text":"正月新阳生翠琯。\n花苞柳线春犹浅。\n帘幕千重方半卷。\n池冰泮。\n东风吹水琉璃软。\n渐好凭阑醒醉眼。\n陇梅暗落芳英断。\n初日已知长一线。\n清宵短。\n梦魂怎奈珠宫远。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30590,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔家傲 其八","author":"欧阳修","text":"八月微凉生枕簟。\n金盘露洗秋光淡。\n池上月华开宝鉴。\n波潋滟。\n故人千里应凭槛。\n蝉树无情风苒苒。\n燕归碧海珠帘掩。\n沈臂冒霜潘鬓减。\n愁黯黯。\n年年此夕多悲感。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30591,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔家傲 其十一","author":"欧阳修","text":"十一月新阳排寿宴。\n黄钟应管添宫线。\n猎猎寒威云不卷。\n风头转。\n时看雪霰吹人面。\n南至迎长知漏箭。\n书云纪候冰生研。\n腊近探春春尚远。\n闲庭院。\n梅花落尽千千片。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30592,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔家傲 其三","author":"欧阳修","text":"三月清明天婉娩。\n晴川祓禊归来晚。\n况是踏青来处远。\n犹不倦。\n秋千别闭深庭院。\n更值牡丹开欲遍。\n酴醾压架清香散。\n花底一尊谁解劝。\n增眷恋。\n东风回晚无情绊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30593,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔家傲 其九","author":"欧阳修","text":"九月重阳还又到。\n东篱菊放金钱小。\n月下风前愁不少。\n谁语笑。\n吴娘捣练腰肢袅。\n槁叶半轩慵更扫。\n凭阑岂是闲临眺。\n欲向南云新雁道。\n休草草。\n来时觅取伊消耗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30594,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔家傲","author":"欧阳修","text":"妾本钱塘苏小妹。\n芙蓉花共门相对。\n昨日为逢青伞盖。\n慵不采。\n今朝斗觉凋零㬠。\n愁倚画楼无计奈。\n乱红飘过秋塘外。\n料得明年秋色在。\n香可爱。\n其如镜里花颜改。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30595,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔家傲 其十","author":"欧阳修","text":"十月轻寒生晚暮。\n霜华暗卷楼南树。\n十二阑干堪倚处。\n聊一顾。\n乱山衰草还家路。\n悔别情怀多感慕。\n胡笳不管离心苦。\n犹喜清宵长数鼓。\n双绣户。\n梦魂尽远还须去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30596,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔家傲 其十七","author":"欧阳修","text":"九日欢游何处好。\n黄花万蕊雕阑绕。\n通体清香无俗调。\n天气好。\n烟滋露结功多少。\n日脚清寒高下照。\n宝钉密缀圆斜小。\n落叶西园风袅袅。\n催秋老。\n丛边莫厌金尊倒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30597,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔家傲 其四","author":"欧阳修","text":"四月园林春去后。\n深深密幄阴初茂。\n折得花枝犹在手。\n香满袖。\n叶间梅子青如豆。\n风雨时时添气候。\n成行新笋霜筠厚。\n题就送春诗几首。\n聊对酒。\n樱桃色照银盘溜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30598,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔家傲 其四","author":"欧阳修","text":"四月芳林何悄悄。\n绿阴满地青梅小。\n南陌采桑何窈窕。\n争语笑。\n乱丝满腹吴蚕老。\n宿酒半醒新睡觉。\n雏莺相语匆匆晓。\n惹得此情萦寸抱。\n休临眺。\n楼头一望皆芳草。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30599,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔家傲 其十八","author":"欧阳修","text":"青女霜前催得绽。\n金钿乱散枝头遍。\n落帽台高开雅宴。\n芳尊满。\n挼花吹在流霞面。\n桃李三春虽可羡。\n莺来蝶去芳心乱。\n争似仙潭秋水岸。\n香不断。\n年年自作茱萸伴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30600,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔家傲 其十九","author":"欧阳修","text":"露裛娇黄风摆翠。\n人间晚秀非无意。\n仙格淡妆天与丽。\n谁可比。\n女真装束真相似。\n筵上佳人牵翠袂。\n纤纤玉手挼新蕊。\n美酒一杯花影腻。\n邀客醉。\n红琼共作熏熏媚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30601,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔家傲 其二","author":"欧阳修","text":"二月春耕昌杏密。\n百花次第争先出。\n惟有海棠梨第一。\n深浅拂。\n天生红粉真无匹。\n画栋归来巢未失。\n双双款语怜飞乙。\n留客醉花迎晓日。\n金盏溢。\n却忧风雨飘零疾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30602,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔家傲","author":"欧阳修","text":"为爱莲房都一柄。\n双苞双蕊双红影。\n雨势断来风色定。\n秋水静。\n仙郎彩女临鸾镜。\n妾有容华君不省。\n花无恩爱犹相并。\n花却有情人薄倖。\n心耿耿。\n因花又染相思病。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30603,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔家傲 其十五","author":"欧阳修","text":"乞巧楼头云幔卷。\n浮花催洗严妆面。\n花上蛛丝寻得遍。\n颦笑浅。\n双眸望月牵红线。\n奕奕天河光不断。\n有人正在长生殿。\n暗付金钗清夜半。\n千秋愿。\n年年此会长相见。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30604,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔家傲 其十二","author":"欧阳修","text":"十二月严凝天地闭。\n莫嫌台榭无花卉。\n惟有酒能欺雪意。\n增豪气。\n直教耳热笙歌沸。\n陇上雕鞍惟数骑。\n猎围半合新霜里。\n霜重鼓声寒不起。\n千人指。\n马前一雁寒空坠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30605,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔家傲","author":"欧阳修","text":"幽鹭谩来窥品格。\n双鱼岂解传消息。\n绿柄嫩香频采摘。\n心似织。\n条条不断谁牵役。\n珠泪暗和清露滴。\n罗衣染尽秋江色。\n对面不言情脉脉。\n烟水隔。\n无人说似长相忆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30606,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔家傲 其十二","author":"欧阳修","text":"腊月年光如激浪。\n冻云欲折寒根向。\n谢女雪诗真绝唱。\n无比况。\n长堤柳絮飞来往。\n便好开尊夸酒量。\n酒阑莫遣笙歌放。\n此去青春都一饷。\n休怅望。\n瑶林即日堪寻访。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30607,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔家傲","author":"欧阳修","text":"战胜归来飞捷奏。\n倾贺酒。\n玉阶遥献南山寿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30608,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔家傲 其二","author":"欧阳修","text":"二月春期看已半。\n江边春色青犹短。\n天气养花红日暖。\n深深院。\n真珠帘额初飞燕。\n渐觉衔杯心绪懒。\n酒侵花脸娇波慢。\n一捻闲愁无处遣。\n牵不断。\n游丝百尺随风远。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30609,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔家傲 其五","author":"欧阳修","text":"五月榴花妖艳烘。\n绿杨带雨垂垂重。\n五色新丝缠角粽。\n金盘送。\n生绡画扇盘双凤。\n正是浴兰时节动。\n菖蒲酒美清尊共。\n叶里黄鹂时一弄。\n犹瞢忪。\n等闲惊破纱窗梦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30610,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔家傲","author":"欧阳修","text":"暖日迟迟花袅袅。\n人将红粉争花好。\n花不能言惟解笑。\n金壶倒。\n花开未老人年少。\n车马九门来扰扰。\n行人莫羡长安道。\n丹禁漏声衢鼓报。\n催昏晓。\n长安城里人先老。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30611,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔家傲 其十一","author":"欧阳修","text":"律应黄钟寒气苦。\n冰生玉水云如絮。\n千里乡关空倚慕。\n无尺素。\n双鱼不食南鸿渡。\n把酒遣愁愁已去。\n风摧酒力愁还聚。\n却忆兽炉追旧处。\n头懒举。\n炉灰剔尽痕无数。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30612,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔家傲 其五","author":"欧阳修","text":"五月薰风才一信。\n初荷出水清香嫩。\n乳燕学飞帘额峻。\n谁借问。\n东邻期约尝佳酝。\n漏短日长人乍困。\n裙腰减尽柔肌损。\n一撮眉尖千叠恨。\n慵整顿。\n黄梅雨细多闲闷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30613,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔家傲","author":"欧阳修","text":"昨日采花花欲尽。\n隔花闻道潮来近。\n风猎紫荷声又紧。\n低难奔。\n莲茎刺惹香腮损。\n一缕艳痕红隐隐。\n新霞点破秋蟾晕。\n罗袖挹残心不稳。\n羞人问。\n归来剩把胭脂衬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30614,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔家傲 其六","author":"欧阳修","text":"六月炎天时霎雨。\n行云涌出奇峰露。\n沼上嫩莲腰束素。\n风兼露。\n梁王宫阙无烦暑。\n畏日亭亭残蕙炷。\n傍帘乳燕双飞去。\n碧碗敲冰倾玉处。\n朝与暮。\n故人风快凉轻度。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30615,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔家傲","author":"欧阳修","text":"红粉墙头花几树。\n落花片片和惊絮。\n墙外有楼花有主。\n寻花去。\n隔墙遥见秋千侣。\n绿索红旗双彩柱。\n行人只得偷回顾。\n肠断楼南金锁户。\n天欲暮。\n流莺飞到秋千处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30616,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔家傲","author":"欧阳修","text":"妾解清歌并巧笑。\n郎多才俊兼年少。\n何事抛儿行远道。\n无音耗。\n江头又绿王孙草。\n昔日采花呈窈窕。\n玉容长笑花枝老。\n今日采花添懊恼。\n伤怀抱。\n玉容不及花枝好。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30617,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔家傲 其一","author":"欧阳修","text":"正月斗杓初转势。\n金刀剪彩功夫异。\n称庆高堂欢幼稚。\n看柳意。\n偏从东面春风至。\n十四新蟾圆尚未。\n楼前乍看红灯试。\n冰散绿池泉细细。\n鱼欲戏。\n园林已是花天气。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30618,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔家傲","author":"欧阳修","text":"荷叶田田青照水，孤舟挽在花阴底。\n昨夜萧萧疏雨坠，愁不寐，朝来又觉西风起。\n雨摆风摇金蕊碎，合欢枝上香房翠。\n莲子与人长厮类，无好意，年年苦在中心里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30619,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔家傲 其三 与赵康靖公","author":"欧阳修","text":"四纪才名天下重。\n三朝构厦为梁栋。\n定册功成身退勇。\n辞荣宠。\n归来白首笙歌拥。\n顾我薄才无可用。\n君恩近许归田垄。\n今日一觞难得共。\n聊对捧。\n官奴为我高歌送。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30620,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔家傲","author":"欧阳修","text":"一夜越溪秋水满。\n荷花开过溪南岸。\n贪采嫩香星眼慢。\n疏回眄。\n郎船不觉来身畔。\n罢采金英收玉腕。\n回身急打船头转。\n荷叶又浓波又浅。\n无方便。\n教人只得抬娇面。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30621,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]