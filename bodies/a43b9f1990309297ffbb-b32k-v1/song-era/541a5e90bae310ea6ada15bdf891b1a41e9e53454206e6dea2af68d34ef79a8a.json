[{"title":"金陵杂兴二百首 其一四三","author":"苏泂","text":"周颙宅作阿兰若，娄约身归窣堵波。\n今日丹青拜荆国，草堂香火已无多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74061,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其四十八","author":"苏泂","text":"日日花光乱酒光，青帘绿树映红妆。\n今年幸得元戎伴，三到钟山共草堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74062,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其一一八","author":"苏泂","text":"车声辘辘马萧萧，山色何如换六朝。\n要识相传风俗在，居人道得语音娇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74063,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其一三八","author":"苏泂","text":"钟山阁上看朝曦，玉作遥山碧四围。\n云气茫茫疑是水，人间无此米元晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74064,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其一七七","author":"苏泂","text":"小虹桥上看朝曦，云里钟山一带微。\n忆在山中望宫阙，淡烟朱碧转依稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74065,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其一○七","author":"苏泂","text":"四畦芍药间葱花，五月春风便有涯。\n闾巷萧条生意少，隔墙谁信内官家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74066,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其八十七","author":"苏泂","text":"十分生聚九流亡，鬼面鸦形仰太仓。\n指望淮南大麦熟，夫妻子女得归乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74067,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其一六八","author":"苏泂","text":"青帝言归速驾忙，荼蘼架底静年芳。\n轻风乍染阴阴绿，微月低笼淡淡香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74068,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其一○九","author":"苏泂","text":"始见拖金复散丝，风吹雨打一枝枝。\n灵和殿前好杨柳，争如张绪少年时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74069,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其六十六","author":"苏泂","text":"三月春归未是归，绿阴端的胜花时。\n绝怜首夏清和句，一字其间几个知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74070,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其一八六","author":"苏泂","text":"安榴朵朵簇巾红，数曲阑干掩映中。\n寻得冰纨题小草，浅新还爱绿荷风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74071,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其五十五","author":"苏泂","text":"白日桥边白字碑，康王神道定为谁。\n路傍借问无人识，自滴村醪酹藓龟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74072,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其三十二","author":"苏泂","text":"子高去后我方来，两地参差笑口开。\n赖有尊前似人喜，为渠想像饮三杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74073,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其一二六","author":"苏泂","text":"半山松菊略能存，犹有荆公旧墨痕。\n佳处不缘谁属我，只应牛首正当门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74074,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其一三九","author":"苏泂","text":"山南山北冢累累，僧寺多承旧宅基。\n兴废相仍真若此，死生常事不须悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74075,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其一五九","author":"苏泂","text":"一派娇波入翠溟，垂杨只似古来青。\n未能草草归家去，怕上劳劳送别亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74076,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其三十六","author":"苏泂","text":"石头城上更高层，与客携壶试一登。\n屈曲江流学秦篆，春风应是李阳冰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74077,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其一九○","author":"苏泂","text":"旂帜精明鼓角雄，江淮草木尽闻风。\n面门神王须如戟，鼠子无轻怒我公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74078,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其六十四","author":"苏泂","text":"不见乌纱紫绮裘，至今英气满沧洲。\n秦淮半夜棹歌发，明月清天江水流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74079,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其一○六","author":"苏泂","text":"细叶如云绿渐敷，玉人晨起换金壶。\n就中一朵紫中贵，除却扬州天下无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74080,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其一六○","author":"苏泂","text":"城上黄花散漫生，溪头绿树忽阴成。\n浓春自欲烘人醉，却忆秋风一味清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74081,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其四十二","author":"苏泂","text":"春韭夏菘谁复种，绿葵红蓼尚堪羹。\n山存虎踞龙盘势，谷隐猿惊鹤怨名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74082,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其三十五","author":"苏泂","text":"城头士女出笆篱，喜色争瞻大使旂。\n尽道去年那有此，今年粥饭不曾饥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74083,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其一六二","author":"苏泂","text":"张硕风流隐钓缗，渔郎回首漫纷纷。\n杜兰香去知何在，惆怅西江一浦云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74084,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其一三六","author":"苏泂","text":"溪上鸳鸯避画船，船中妓女列婵娟。\n使君爱日留连客，同醉江家旧宅边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74085,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其一五八","author":"苏泂","text":"清明过了日晴佳，九十韶光便有涯。\n恨杀东风太豪横，夜来吹尽海棠花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74086,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其一八二","author":"苏泂","text":"青山绿水思悠悠，见说蛾眉万古愁。\n斗酒百篇能漫浪，白乎吾与女同游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74087,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其一五七","author":"苏泂","text":"北门缭绕出东门，一处亭台酒一巡。\n景物欣欣乐知己，柳容花貌越精神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74088,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其四十三","author":"苏泂","text":"前日东园一看梅，昨朝重看杏花开。\n从今尽有花时节，判得从公日日来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74089,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其一三○","author":"苏泂","text":"旋结穹庐作露亭，疏枝阑入更轻盈。\n今年客思撩人甚，欲共梅花笑不成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74090,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其一七五","author":"苏泂","text":"金城杨柳绿毵毵，摇落殊非昔汉南。\n一语莫因人遂废，树犹如此我何堪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74091,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其一七六","author":"苏泂","text":"桃花园作芳林苑，濛汜池通祓禊堂。\n前以骄奢为晋宋，后无规鉴亦齐梁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74092,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其一九三","author":"苏泂","text":"三月更当临尽头，升元阁畔一閒游。\n偶因花会逢花面，半日僧房得少留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74093,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其一九一","author":"苏泂","text":"放散边头武定军，卖刀买犊做农人。\n向来忧国多浮议，谁省官家亿万缗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74094,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其一九七","author":"苏泂","text":"阅武堂前杨柳枝，如今是隔几多时。\n至尊屠肉潘妃酒，问著垂杨总不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74095,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其七十九","author":"苏泂","text":"到郡今朝半月日，离家两个许多时。\n知他阿柏无他否，忆我何因我得知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74096,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其三十","author":"苏泂","text":"二月风和日暖时，淡黄杨柳一丝丝。\n向人无限隋唐意，犹是桥南杨柳枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74097,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其一","author":"苏泂","text":"玉麟堂下柳丝丝，过了春风一半时。\n行到水乡应底事，黄莺飞上杏花枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74098,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其六十八","author":"苏泂","text":"临春何在只桑麻，法宝丛篁间杏花。\n旧日此间同泰寺，曾将龙衮换袈裟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74099,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其九十一","author":"苏泂","text":"幕府攒眉为至忧，公堂三五运兵筹。\n归之不得吾何用，独自方桥看水流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74100,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其八十九","author":"苏泂","text":"四十之年又过一，春光回施少年人。\n如丝杨柳看如絮，昼锦堂中又一春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74101,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其十二","author":"苏泂","text":"万钥深深待驾临，府藏戈甲库黄金。\n规恢画饼翻增弊，孤负先皇一片心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74102,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其九十五","author":"苏泂","text":"短褐钟山不跨驴，杖藜横笛野僧俱。\n虽无字说烦清老，犹恐龙眠画作图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74103,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其十九","author":"苏泂","text":"去年夜半草军书，今岁平安一事无。\n且愿吾皇千万寿，早教车马会东都。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74104,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其一六六","author":"苏泂","text":"不及卢家有莫愁，君恩如水向东流。\n从今相送东流后，地下伤春亦白头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74105,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其三十九","author":"苏泂","text":"白鹭洲前白鹭飞，人间还阅几斜晖。\n春风不与苏郎便，浩荡沧溟一舸归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74106,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其四十七","author":"苏泂","text":"沟水泠泠韵玉琴，樱桃花下宿珍禽。\n龙车自向思陵掩，三十六宫春色深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74107,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其一五五","author":"苏泂","text":"纸钱吹挂树枝风，积李崇桃白间红。\n但见牛羊上丘垄，忽看禾黍出蒿蓬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74108,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其五十二","author":"苏泂","text":"城脚粼粼水一陂，水边杨柳映旌旂。\n青郊绿野无穷意，寒食清明三月时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74109,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其一二一","author":"苏泂","text":"平生英俊邢刍父，酷爱闽中一卷诗。\n落笔文章有如此，因何不到秣陵嬉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74110,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其一八三","author":"苏泂","text":"莲花博士去骑鲸，镜曲回瞻一怆情。\n少待诗成附河伯，愿加涂乙始流行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74111,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其一一○","author":"苏泂","text":"琪树三朝种已成，绿阴回合啭宫莺。\n伤心辇路生春草，不见素娥花底行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74112,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其一一七","author":"苏泂","text":"安石风流苦未遥，重来遗迹尚山椒。\n一丘元自无花草，底事令人觉意消。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74113,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其七十七","author":"苏泂","text":"一万强人犯海陵，可怜谈笑陷官兵。\n张韩刘岳今何在，塞上将军漫有名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74114,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其二十九","author":"苏泂","text":"春风动地卷红旌，人在清溪阁上行。\n歌舞洗空亡国恨，风流太守亦多情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74115,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其四十四","author":"苏泂","text":"白沙翠竹长干寺，绿水朱楼白下城。\n燕子飞来春又晚，去年曾此看清明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74116,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其一六三","author":"苏泂","text":"扁舟乞得自由身，烂漫金陵作好春。\n桃叶桃根双姊妹，清风明月我三人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74117,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其一八一","author":"苏泂","text":"不论城外与城中，时节欢然一笑同。\n棠棣花残紫荆老，可无书札问孤鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74118,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其十八","author":"苏泂","text":"江风吹面雪漫漫，二月东风特地寒。\n四十病身谁役汝，小车摇兀过长干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74119,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其二十八","author":"苏泂","text":"去年十二里新亭，尅复当时事未成。\n爽气不随秋露尽，犹闻神鬼夜论兵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74120,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其六十一","author":"苏泂","text":"羊车洗马好谈玄，玉立风姿一少年。\n不枉当时人看杀，如今何处觅幽阡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74121,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其十七","author":"苏泂","text":"五陵歌舞换埃尘，地下黄金出尚新。\n碑字已漫青草死，酸风吹杀石麒麟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74122,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其八十二","author":"苏泂","text":"七宝装成射雉场，人间还阅几齐梁。\n潘妃自踏金莲去，不见年年春草长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74123,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其五十七","author":"苏泂","text":"白日相思可奈何，青春三月已无多。\n桃花风急鲤鱼老，独上台城听踏歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74124,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其一七四","author":"苏泂","text":"立夏连朝刬地寒，看承芍药倩园官。\n秋千拆罢无聊赖，轩槛周遭绿一般。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74125,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其五十","author":"苏泂","text":"花底翩翻燕子风，杏园何止万株红。\n亭轩包裹浑如锦，见说风流似禁中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74126,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其七十四","author":"苏泂","text":"缚屋牵牛旋旋归，淮边绿野尽耕犁。\n弓刀武备何曾识，只是当初田舍儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74127,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其一三三","author":"苏泂","text":"扫地须臾架屋成，风流尤胜拂庐亭。\n吹来一片杯中雪，看著花枝醉忽醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74128,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其七十三","author":"苏泂","text":"元帅中军展将旂，军中新刺好男儿。\n风云阵法秋毫识，前日兵兴使不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74129,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其七十八","author":"苏泂","text":"多少横尸叠似楼，官人早晚解红头。\n淮南已是无聊甚，行到江东刬地愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74130,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其一一九","author":"苏泂","text":"凤凰台上凤凰游，山自青青水自流。\n千载谪仙元不死，相逢一笑不能休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74131,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其一二七","author":"苏泂","text":"川原膴膴树斑斑，十里春风一望间。\n野马不羁天地阔，孤鸿无奈水云閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74132,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其一三五","author":"苏泂","text":"冶城迤逦过清凉，城脚连云一带长。\n佛寺仙宫更游苑，杖藜知费几诗章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74133,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其五十九","author":"苏泂","text":"燕子蜂儿各自忙，玉魂谁返杜秋娘。\n人间抵死无殊丽，免唤分司御史狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74134,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其一五六","author":"苏泂","text":"白下城东送客时，同来何事不同归。\n君归说似西园柳，遮莫轻绵一片飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74135,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其十六","author":"苏泂","text":"三山掺别是前年，除夜还家翁已仙。\n少小知怜今老矣，每因得句辄潸然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74136,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其一九二","author":"苏泂","text":"表里江淮四十州，稍回饥盗事田畴。\n得公数十分天下，庶矣斯民疾痛瘳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74137,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]