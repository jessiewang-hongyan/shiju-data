[{"title":"即事二首 其一","author":"刘克庄","text":"秃翁未敢佚馀生，洗竹浇兰立课程。\n辛苦谋身无瓮算，殷勤娱耳有瓶笙。\n垆寒烧叶回春意，烛尽携书就月明。\n一欠伸间分梦觉，何须它日曲池平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31427,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即事三首 其三","author":"刘克庄","text":"陌上鸣钲夜向晨，缀行花锦照城闉。\n湔裙未免多游女，舍耒深忧有惰民。\n史载孝娥今列祀，骚云帝子没为神。\n腊傩固匪儒家法，居鲁安能异鲁人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31428,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即事三首 其二","author":"刘克庄","text":"家世相传逢掖衣，如今结果亦随时。\n二三子遂舍瑟作，七十翁方扶杖嬉。\n野老忧晴妨宝穑，社人怕雨湿灵旗。\n遥知铃阁无歌管，一点青灯照董帷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31429,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即事三首 其一","author":"刘克庄","text":"抽簪脱裤满城忙，大半人多在戏场。\n膈膊鸡犹金爪距，勃跳狙亦衮衣裳。\n湘累无奈众人醉，鲁蜡曾令一国狂。\n空巷冶游惟病叟，半窗淡月伴昏黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31430,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即事四首 其四","author":"刘克庄","text":"待凿新池引一湾，更规高阜敞三间。\n缩墙恐犯邻家地，减树图看屋后山。\n身隐免贻千载笑，书成犹要十年闲。\n门前蓦有相寻者，但说翁今怕往还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31431,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即事四首 其三","author":"刘克庄","text":"墙角新开白版扉，时寻樵牧弄烟霏。\n代耕岂若收躬稼，赐帛何如出自机。\n湖海浪游今已倦，山林独往未全非。\n百年只愿身强健，长为慈亲负米归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31432,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即事四首 其二","author":"刘克庄","text":"目为诗客不胜惭，唤作园翁定自堪。\n抱瓮荷锄非鄙事，栽花移竹似清谈。\n野人只识羹芹美，相国安知食笋甘。\n晚觉齐民书最要，惜无幽士肯同参。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31433,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即事四首 其一","author":"刘克庄","text":"买得荒郊五亩馀，旋营花木置琴书。\n柳能樊圃犹须种，兰纵当门亦不锄。\n无力改墙姑覆草，多方存井要浇蔬。\n区区才志聊如此，谁谓先生广且疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31434,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即席用实之郎中韵","author":"刘克庄","text":"偶临群彦宴公堂，老去斯庄莫遣荒。\n东道主人如谢守，西阶重客欠王郎。\n不能席上题鹦鹉，争免池边夺凤凰。\n圣世英贤俱入彀，岂论狗监与鹰坊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31435,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"君畴仰晦茂功蒙仲和余差须韵二诗再答二首 其二","author":"刘克庄","text":"衡与脩皆捋虎须，不论公干与元瑜。\n讥弹山寺诗为谤，指点沧洲疏似谀。\n毛垢人将吹洗汝，涅磨渠不磷缁乎。\n劝君刊落闲枝叶，佩服高柴一字愚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31436,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"君畴仰晦茂功蒙仲和余差须韵二诗再答二首 其一","author":"刘克庄","text":"懊悔平生择术差，誓将秋实代春华。\n幸无大节污青史，曾有狂言坏白麻。\n已约宗雷同入社，且饶燕许自成家。\n傍人不必争残线，秃笔何因肯再花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31437,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"君畴仲晦蒙仲再和余差须二诗警斋侍郎又继之趁韵走谢 其二","author":"刘克庄","text":"垢衣忘浣虱游须，岂有村情似长瑜。\n作圣德诗无乃怪，进文鉴序近于谀。\n热中人有谗余者，殿后天将寿我乎。\n晚觉陶翁嗔子懒，不如坡老愿儿愚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31438,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"君畴仲晦蒙仲再和余差须二诗警斋侍郎又继之趁韵走谢 其一","author":"刘克庄","text":"丹炉爆裂话头差，揽镜颜苍两鬓华。\n不记省中咏薇药，径归韦曲问桑麻。\n卿云方荐汉郊庙，郊岛难鸣唐国家。\n谁向玄都君子说，有春风处有桃花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31439,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"听蛙方君作八老诗效颦各赋一首内三题余四十年前已作遂不重说倡言别赋二题足成十老 老农","author":"刘克庄","text":"身已龙钟不出村，尚能抱瓮灌蔬园。\n瓦盆甚朴常盛酒，茅屋虽低可负暄。\n锄倦扶藜访邻叟，祭归怀肉遗诸孙。\n后生记取耆年语，世世休思入县门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31440,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"听蛙方君作八老诗效颦各赋一首内三题余四十年前已作遂不重说倡言别赋二题足成十老 老医","author":"刘克庄","text":"刘叟衣装绛老年，市中卖药且随缘。\n驰名最久经三世，阅病虽多未十全。\n龟手有方俄贵矣，乌髭无诀独皤然。\n卧闻鹊噪扶筇起，偶有邻翁送谢钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31441,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"听蛙方君作八老诗效颦各赋一首内三题余四十年前已作遂不重说倡言别赋二题足成十老 老道","author":"刘克庄","text":"炼不成丹死不休，岂知岁月竟悠悠。\n老于蒙叟仍黄馘，丑似弥明亦结喉。\n尚隔蓬莱三万里，浪云椿树八千秋。\n暮年却羡邻儿黠，阿母蟠桃也去偷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31442,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"听蛙方君作八老诗效颦各赋一首内三题余四十年前已作遂不重说倡言别赋二题足成十老 老僧","author":"刘克庄","text":"半间古屋冷飕飕，死尽同参偶独留。\n昔已寻师远行脚，今惟见佛小低头。\n旧绫无用聊收取，破衲难缝且著休。\n年少还知贫道不，曾同王谢二公游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31443,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"听蛙方君作八老诗效颦各赋一首内三题余四十年前已作遂不重说倡言别赋二题足成十老 老儒","author":"刘克庄","text":"向来岁月雪萤边，老去生涯井臼前。\n举孝廉科非复古，给灵寿杖定何年。\n空蟠万卷终无用，专巧三场恐未然。\n犹记儿时闻绪论，白头不敢负师传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31444,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吴大帝庙","author":"刘克庄","text":"露坐空山里，英灵唤不回。\n久无祠祭至，曾作帝王来。\n坏壁虫伤画，残炉鼠印灰。\n今人浑忘却，江左是谁开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31445,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吾里前辈林删定甫六十挂冠夹漈艾轩诸老皆为赋诗追次其韵","author":"刘克庄","text":"□定飞仙去不留，惜余生晚欠从游。\n种明逸后屈二指，范景仁边放一头。\n有鹿门栖堪遁去，无菟裘计径归休。\n却怜荷蓧非真隐，鸡黍殷勤止仲由。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31446,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"呈袁秘监","author":"刘克庄","text":"近日频闻有峻除，人传君相重师儒。\n细旃坐稳方轮讲，群玉峰高未要扶。\n别后曾过东閤否，新来亦乞鉴湖无。\n几时供帐都门外，真写先生作画图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31447,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"呈黄建州","author":"刘克庄","text":"当年虎穴挺身临，匹马平欺万绿林。\n余欲关弓常掩涕，汝能卖剑即回心。\n歌廉民已嗟来暮，微管吾安得至今。\n欲谒铃斋参嫡派，管蠡何敢测高深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31448,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宋侯和灯夕诗再用韵二首 其二","author":"刘克庄","text":"近传桂管置行营，想见临淮号令明。\n书载舞干文德远，曲名破阵武功成。\n小儿队整遗风在，大将坛荒旧址平。\n未得军前实消息，强歌安得有欢声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31449,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宋侯和灯夕诗再用韵二首 其一","author":"刘克庄","text":"茜袂黄眉出满城，贤侯游豫顺民情。\n鼓声足验村田乐，月色遥占辇路晴。\n定有儒臣映藜仗，又闻京尹折莲棚。\n祠官一瓣无它祝，但愿旄头尽扫清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31450,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿计院族兄","author":"刘克庄","text":"晏温全不似霜天，开遍芙蓉蜀锦鲜。\n昔我父兄悭上寿，今君翁媪各稀年。\n清狂尚欲簪花舞，答飒无端据槁眠。\n闻道日边消息好，除书断在一阳前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31451,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿建宁太守 其一","author":"刘克庄","text":"珥貂不爱爱凭熊，似喜闽山入眼浓。\n燕寝香渍公事简，围腰金重宦情慵。\n颇闻昭代洵黄发，未许先期访赤松。\n十万人家同祝颂，衮衣从此入登庸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31452,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿建宁太守 其二","author":"刘克庄","text":"官府升平戟卫严，退衙惟与客清谈。\n宽和却笑闽溪急，苦硬翻嫌建茗甘。\n南国只今歌召伯，汉庭早晚相曹参。\n情知金鼎催调燮，驿路梅开雪意酣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31453,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"张丽华墓","author":"刘克庄","text":"台上柏萧萧，空堂闭寂寥。\n芳魂三尺土，往事几回潮。\n堕翠寻难见，埋红恨未销。\n犹胜江令在，白首入隋朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31454,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"忧爱","author":"刘克庄","text":"脱发清晨雪满簪，把茅不恨入山深。\n安能更作皱眉事，但可聊为拥鼻吟。\n鞭算难权鹿皮币，害藏谁发袅蹄金。\n暮年未敢忘忧爱，喜听三边奏凯音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31455,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"怀友","author":"刘克庄","text":"老鹤孤飞久失群，天涯怀友寸心勤。\n狂生似腻宁堪近，佳士如香故可熏。\n无复拿舟乘大雪，有时倚杖送停云。\n秋来径草深三尺，谁伴青灯缉旧闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31456,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"怀王制参","author":"刘克庄","text":"因交明允知坡颍，喜少公文更雅醇。\n方幸儒林得吾子，奈何宰相失斯人。\n未挥潞国告廷制，久作河阳入幕宾。\n自古埙篪宜送奏，开元张垍与张均。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31457,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"怀旧","author":"刘克庄","text":"蚤从南浦晚南塘，二老联翩返帝旁。\n天上庆云谁属和，斗间紫气久无光。\n已埋玉树难扶起，所宝银钩永袭藏。\n老去悲欢排遣尽，犹于师友未能忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31458,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"怀旧二首 其一","author":"刘克庄","text":"盛名岂敢侪三俊，痛饮犹堪入八仙。\n屈指淳熙遗老少，到头元祐几人全。\n松为明误夭千岁，薰与莸并臭十年。\n立传臣僚宜自爱，追怀此语一悽然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31459,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"怀旧二首 其二","author":"刘克庄","text":"昔掌纶言提史笔，心思目力两徒劳。\n藏山书可秃千兔，钓海力能连六鳌。\n空有风号陵上柏，更无春到观中桃。\n苍梧云暗重华远，泪落当年旧锦袍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31460,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"怀旧二首 其一","author":"刘克庄","text":"陌上传宣学士声，旋施席帽拂华缨。\n催誊制草依时进，多点宫莲彻夜明。\n五相一翁真薄命，三君八俊总虚名。\n世间妙物无过酒，浇得胸中磊块平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31461,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"怀安道中","author":"刘克庄","text":"闽溪瘴岭客程赊，晓泊怀安喜近家。\n大屋书旗夸酒米，小舟鸣橹竞鱼虾。\n溪移驿已临高岸，潮退帆多聚浅沙。\n快著征衫鞭瘦马，要看二十里梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31462,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"怀李敬子","author":"刘克庄","text":"此士今徐孺，柴扉肯妄开。\n空闻羔雁去，不见凤麟来。\n庐阜寻僧出，东湖赴讲回。\n何由操杖屦，林下再相陪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31463,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"怀保宁聪老","author":"刘克庄","text":"秣陵一见叹魁梧，每恨斯人不业儒。\n几度剧谈俱抵掌，有时大醉劝留须。\n探梅尚忆陪山屐，煨芋何因共地炉。\n我已休官师退院，肯来林下卓庵无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31464,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"怀晦岩一首","author":"刘克庄","text":"免呼鉴义与尚书，师卸金栏我佩鱼。\n扈豹尾车侬老矣，升狮子座者谁欤。\n草鞋曾遍三千界，雪顶今皆八十馀。\n台岭壶山隔脩阻，可无一字问何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31465,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"怀曾景建二首 其二","author":"刘克庄","text":"曾有舂陵逐客篇，流传哀动紫阳仙。\n安知太白长流处，亦在重华野葬边。\n碎板一如坡贬日，盖棺不见桧薨年。\n谁云老眼枯无涕，闻说临川即泫然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31466,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"怀曾景建二首 其一","author":"刘克庄","text":"造物生才自昔难，此君夭矫类龙鸾。\n圣贤本柄藏椰子，佛祖机锋寓棘端。\n畴昔诸人多北面，暮年万里著南冠。\n伤心海内交游尽，箧有遗书不忍看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31467,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"抄戊辰十月近稿七首 其七","author":"刘克庄","text":"畴昔荣途分寸跻，危机不合上云梯。\n凤皇池有人争夺，鹦鹉洲无客敢题。\n早不修真坏丹灶，晚方受箓脱金闺。\n羽毛只可如鸦雀，谁遣君为吐绶鸡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31468,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"抄戊辰十月近稿七首 其六","author":"刘克庄","text":"少狂费尽一生心，丛稿如山雪满簪。\n杨子雕镌誇赋丽，唐人锻鍊说诗深。\n寒来尚可披裘钓，穷杀何妨带索吟。\n社友萧疏吾老大，安知来者不如今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31469,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"抄戊辰十月近稿七首 其五","author":"刘克庄","text":"户外跫然闻足音，或怀漫刺袖新吟。\n樽空愧不能觞客，绠短如何敢汲深。\n薄俗求疵谁掩恶，先贤虑患或阳瘖。\n国人岂待侬箴儆，持在萤窗且自箴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31470,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"抄戊辰十月近稿七首 其二","author":"刘克庄","text":"识之无字忆髫年，霍地红颜变雪颠。\n求狗监人难复得，如鸡林相岂非贤。\n鲤庭闻处才三百，蚓窍吟来忽五千。\n寄语毛韩并卫卜，不烦序亦不烦笺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31471,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"抄戊辰十月近稿七首 其一","author":"刘克庄","text":"后学鲜能舍瑟作，古人未免假韶鸣。\n不劳左辖诵新句，却爱老婆呼旧名。\n史馆谁徵段公事，雠家妄作武侯评。\n人间安得忘忧物，为窭儒生浇不平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31472,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"改诗","author":"刘克庄","text":"推敲觅句浑如故，卧起诗人始觉衰。\n送老聊题□□颂，逢辰曾和柏梁诗。\n今无鲍叔谁知我，后有扬雄必好之。\n丛藁麻搽鸦蚓黑，匹如墨蜡打残碑。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31473,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"旱莲","author":"刘克庄","text":"晴久方池可跣行，萍枯惟有草纵横。\n朱葩未见丛丛拆，绿柄才看寸寸生。\n悴若放臣临楚泽，厄于学士蹈秦坑。\n输他杭越花如锦，画舫名姝夜按笙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31474,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"李术士善医卜","author":"刘克庄","text":"西汉君平莫是渠，萧然闭肆或旬馀。\n青囊系肘藏仙诀，黑子如毛录谶书。\n屡倩揲蓍爻每验，近闻咒枣病皆除。\n闲时更取离骚看，怕有灵均犹卜居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31475,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"李园有怀孚若","author":"刘克庄","text":"曾与山公醉不归，李园水竹尚依稀。\n钿车疾取春莺唱，铁笛潜惊宿鸟飞。\n昔把蟹螯同酒盏，今持马策叩城扉。\n溪头一片无情月，偏照愁人泪满衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31476,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"村校书","author":"刘克庄","text":"短衣穿结半瓢空，所住茅檐仅蔽风。\n久诵经书皆默记，试挑史传亦旁通。\n青灯窗下研孤学，白首山中聚小童。\n却羡安昌师弟子，只谈论语至三公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31477,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"村墅","author":"刘克庄","text":"村墅溪亭处处嬉，新年海岱悉清夷。\n盗平四野无惊柝，虏去三边有捷旗。\n子美间关离乱际，尧夫生死太平时。\n从今一洗穷愁语，多赋看花饮酒诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31478,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杜丞","author":"刘克庄","text":"忆冒重围入，孤城赖不亡。\n战功何日赏，檄草至今藏。\n旧事归诗卷，新寒入箭创。\n江边逢杜杲，鬓发各苍苍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31479,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"东岩寺避暑","author":"刘克庄","text":"若非来寺里，无地避炎蒸。\n经雨房基润，依山井气冰。\n榻虚凉睡客，松湿滴归僧。\n对此专宜静，为诗亦不应。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31480,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"来至桂州叶潜仲以诗相迎次韵一首","author":"刘克庄","text":"柘冈西路别君时，几见天涯柳弄丝。\n横草壮心空忼慨，覆蕉残梦懒寻思。\n羞将白发趋新府，却忆青山领旧祠。\n犹有南来奇特事，马头先得故人诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31481,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"灵石日长老访留之樗庵","author":"刘克庄","text":"妄念已知今世错，勤脩别结后身缘。\n尺三汗脚踏龙尾，丈六金身坐象筵。\n昔趁蛾眉班谒帝，今从牛矢路归田。\n未知葱岭何边去，且向庵中伴老禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31482,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"灵石日长老拂衣退院连帅陆尚书比之石霜小诗赞叹","author":"刘克庄","text":"我结小庵犹舴艋，师抛大刹似蘧庐。\n菩提身外更无物，椰子腹中惟有书。\n不踏一芦堪去矣，许分半芋竟何如。\n元来又被寒翁引，径指坟山作退居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31483,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"灵宝道院","author":"刘克庄","text":"两行松绕垣，数个竹当轩。\n山主出何处，道人知不言。\n只携诗草至，尚觉磬声烦。\n俗奉医仙谨，儒家亦舍幡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31484,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"牢落","author":"刘克庄","text":"牢落吾何恨，先贤未免穷。\n宁为田舍子，不作国师公。\n萤影穿窗隙，蛩声出壁中。\n残书殊有味，读到角吹终。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31485,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"狂吟","author":"刘克庄","text":"两轮屋角走如梭，争奈樗翁老病何。\n富贵时来年少去，神仙者少死人多。\n形羸全赖儿扶掖，诗退犹须友切磋。\n莫嗟狂吟无律吕，古人不废饭牛歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31486,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"纵茟一首","author":"刘克庄","text":"不与人争鹿，常留客脍鲸。\n遍参埋雪立，轻举御风行。\n鸣止三千岁，游观数十城。\n前篇方出喙，又报后篇成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31487,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"纵笔二首 其一","author":"刘克庄","text":"忽忽韶颜变老苍，叵堪屋角两轮忙。\n群花独菊香尤晚，大木惟樗寿最长。\n眉有白毫垂过眼，腹无墨汁苦搜肠。\n荒村偶有优旃至，且伴儿童看戏场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31488,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"纵笔二首 其一","author":"刘克庄","text":"虚费灯窗一世勤，老师曾许与斯文。\n玉台不善谐新咏，金匮犹堪记旧闻。\n浅学安能演繁露，华堂苦爱诵微云。\n史香骚艳无穷尽，叹息何人共摘熏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31489,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]