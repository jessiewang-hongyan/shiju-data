[{"title":"酬阁皂山碧崖道士甘叔怀赠美名人不及佳句法如何十古风二首 其一","author":"杨万里","text":"桂林户掾旧能文，有弟抛家作道人。\n诗似道人人似鹤，看来若个觅纤尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68438,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹊营巢既成为鸠所据","author":"杨万里","text":"乾鹊平生浪苦辛，一年卜筑一番新。\n如何月下空三匝，宅子还将住别人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68439,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"暮立荷桥","author":"杨万里","text":"欲问红蕖几莟开，忽惊浴罢夕阳催。\n也知今夕来差晚，犹胜穷忙不到来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68440,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"暮行田间二首 其二","author":"杨万里","text":"水满平田无处无，一张雪纸眼中铺。\n新秧乱插成井字，却道山农不解书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68441,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"暮行田间二首 其一","author":"杨万里","text":"布谷声中日脚收，瘦藤叫我看西畴。\n露珠走上青秧叶，不到梢头便肯休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68442,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"暮坐中庭","author":"杨万里","text":"蚊子因凉减，蝉声入暮多。\n有愁无处著，不饮欲如何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68443,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"暮春小雨","author":"杨万里","text":"宿酒微醒尚小醺，似痴如病不多欣。\n深深池沼轻轻雨，独倚栏干看水纹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68444,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"暮春即事","author":"杨万里","text":"花时追赏夜将朝，花过痴眠日尽高。\n又与山禽争口腹，执竿挟弹守樱桃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68445,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"暮热游荷池上五首 其五","author":"杨万里","text":"空中斗起朵云头，旋旋开来旋旋收。\n初作䰒松松树子，忽成髣髴柳花毬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68446,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"暮热游荷池上五首 其四","author":"杨万里","text":"也不多时便立秋，寄声残暑速拘收。\n瘦蝉有得许多气，吟落斜阳未肯休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68447,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"暮热游荷池上五首 其三","author":"杨万里","text":"细草摇头忽报侬，披襟拦得一西风。\n荷花入暮犹愁热，低面深藏碧伞中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68448,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"暮热游荷池上五首 其二","author":"杨万里","text":"寒甃千寻汲井花，病身一浴不胜佳。\n追凉不得浑闲事，烧眼生憎半幅霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68449,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"暮热游荷池上五首 其一","author":"杨万里","text":"玉砾金沙一径长，暑中无处可追凉。\n独行行到荷池上，荷不生风水不香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68450,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"凝露堂前紫薇花两株每自五月盛开九月乃衰二首 其二","author":"杨万里","text":"似痴如醉弱还佳，露压风欺分外斜。\n谁道花无红十日，紫薇长放半年花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68451,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"凝露堂前紫薇花两株每自五月盛开九月乃衰二首 其一","author":"杨万里","text":"晴霞艳艳覆檐牙，绛雪霏霏点砌沙。\n莫管身非香案吏，也移床对紫薇花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68452,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"碧落洞四首 其四","author":"杨万里","text":"际会诸滩吼怒雷，遭逢江势更萦回。\n今宵不到英州定，何用山云送雨来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68453,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"碧落洞四首 其三","author":"杨万里","text":"洞里仙人枉费功，凿江屈曲做神通。\n千萦万绕留江住，毕竟奔流入峡中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68454,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"碧落洞四首 其二","author":"杨万里","text":"梦中曾泊洞前船，落絮飞花是去年。\n今日来寻泊船处，一江风雨草连天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68455,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"碧落洞四首 其一","author":"杨万里","text":"碧落诸峰是碧簪，忽于平地插瑶岑。\n洞中定有神仙宅，玉室金堂不可寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68456,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"碧落洞前滩水三首 其二","author":"杨万里","text":"石峰背后即英州，只不教人到岸头。\n罗带春风吹不直，故将数摺恼行舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68457,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"碧落堂晚望","author":"杨万里","text":"暮笳声里暮云生，白白非烟覆一城。\n祇有青林遮不得，兜罗绵上绿琴横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68458,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"碧瑶洞天","author":"杨万里","text":"青松万树竹千竿，苍翠中间别一天。\n从此洞天三十七，初头且数碧瑶仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68459,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"端午后顿热","author":"杨万里","text":"只今新暑已歊然，作么禁当六月天。\n飞上风前最凉处，年年输与柳梢蝉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68460,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蜜渍梅花","author":"杨万里","text":"瓮澄雪水酿春寒，蜜点梅花带露餐。\n句里略无烟火气，更教谁上少陵坛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68461,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蜡烛","author":"杨万里","text":"未夜身先卧，不春花已开。\n泣残双泪雨，愁得寸心灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68462,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蜡梅四首 其四","author":"杨万里","text":"江梅珍重雪衣裳，薄相红梅学杏装。\n渠独小参黄面老，额间艳艳发金光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68463,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蜡梅四首 其三","author":"杨万里","text":"莟头元不是花房，融蜡熬酥戏滴将。\n忽见微舒金爪甲，不知中有紫香囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68464,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蜡梅四首 其二","author":"杨万里","text":"眉间蜜酒发轻黄，对著诗人不惜香。\n金作仙衣元自冷，月中仍带一身霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68465,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蜡梅四首 其一","author":"杨万里","text":"蜜蜂底物是生涯，花作糇粮蜡作家。\n岁晚略无花可采，却将香蜡吐成花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68466,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"酴醾初发","author":"杨万里","text":"一春长是怨春迟，过却春光总不知。\n已负海棠桃李了，再三莫更负酴醾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68467,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"静坐池亭二首 其二","author":"杨万里","text":"荷边弄水一身香，竹里招风满扇凉。\n道是秋来还日短，秋来闲里日偏长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68468,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"静坐池亭二首 其一","author":"杨万里","text":"胡床倦坐起凭栏，人正忙时我正闲。\n却是闲中有忙处，看书才了又看山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68469,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鲊鱼潭登舟","author":"杨万里","text":"船阁寒沙待晚潮，行人舟子各相招。\n银山一朵三千丈，隔海飞来对面销。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68470,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"嘲报春花","author":"杨万里","text":"嫩黄老碧已多时，騃紫痴红略万枝。\n始有报春三两朵，春深犹自不曾知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68471,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"嘲稚子","author":"杨万里","text":"雨里船中不自由，无愁稚子亦成愁。\n看渠坐睡何曾醒，及至教眠却掉头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68472,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"嘲蜂","author":"杨万里","text":"薰笼供药较香些，引得蜂儿绕室哗。\n笑死老夫缘底事，蜂儿专用鼻看花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68473,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"嘲蜻蜓","author":"杨万里","text":"饵花春蝶即花仙，饮露秋蝉怕露寒。\n只道蜻蜓解餐水，元来照水不曾餐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68474,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"德寿宫庆寿口号 其一","author":"杨万里","text":"长乐宫前望翠华，玉皇来贺太皇家。\n青天白日仍飞雪，错认东风转柳花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68475,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"德寿宫庆寿口号 其五","author":"杨万里","text":"帝捧瑶觞玉座前，綵衣三世祝尧年。\n天皇八十一万岁，休说庄椿两八千。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68476,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"德寿宫庆寿口号 其三","author":"杨万里","text":"春色何须羯鼓催，君王元日领春回。\n牡丹芍药蔷薇朵，都向千官帽上开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68477,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"德寿宫庆寿口号 其六","author":"杨万里","text":"天父晨兴未出房，君王忍冷立风廊。\n忽然鸣跸珠帘捲，万岁声传震八荒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68478,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"德寿宫庆寿口号 其十","author":"杨万里","text":"甲戌王春试集英，小臣曾是老门生。\n苍颜华发鹓行里，也听钧天九奏声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68479,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"德寿宫庆寿口号 其四","author":"杨万里","text":"双金狮子四金龙，喷出香云绕殿中。\n太上垂衣今上拜，百王曾有个家风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68480,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"德寿宫庆寿口号 其二","author":"杨万里","text":"清晓鞭声出禁中，惊开剩雨及残风。\n金鸦衔取红鸾扇，飞上玻瓈碧海东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68481,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"德寿宫庆寿口号 其八","author":"杨万里","text":"甘露祥风天上来，今回恩数赛前回。\n都将四海欢声里，酿作慈皇万寿杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68482,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"德寿宫庆寿口号 其九","author":"杨万里","text":"尧舜同时已甚都，祖孙四世古今无。\n谁将写日摹天手，画作皇王盛事图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68483,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"德远叔坐上赋肴核八首 其六 人面子","author":"杨万里","text":"喜时能笑醉能歌，眉映青山眼映波。\n旧日美如潘骑省，只今瘦似病维摩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68484,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"德远叔坐上赋肴核八首 其二 牛尾狸","author":"杨万里","text":"琼瑶风骨褐衣裘，野果初红玉露秋。\n僧孺唤渠登榜尾，季狸只合隐山头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68485,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"德远叔坐上赋肴核八首 其八 银杏","author":"杨万里","text":"深灰浅火略相遭，小苦微甘韵最高。\n未必鸡头如鸭脚，不妨银杏伴金桃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68486,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"德远叔坐上赋肴核八首 其一 糟蟹","author":"杨万里","text":"横行湖海浪生花，糟粕招邀到酒家。\n酥片满螯凝作玉，金穰镕腹未成沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68487,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"樊系","author":"杨万里","text":"册文不做也由伊，做了何须死不辞。\n可惜一杯金屑酒，饮来祗较早些时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68488,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"横林望见惠山寄怀尤延之三首 其三","author":"杨万里","text":"平生玉树伴蒹葭，晚岁春兰隔菊花。\n咫尺遂初堂下水，寄诗犹自怨人遐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68489,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"横林望见惠山寄怀尤延之三首 其二","author":"杨万里","text":"惠山孤绝未为孤，下有诗仙伴却渠。\n占断惠山妨底事，无端更占洞庭湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68490,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"横林望见惠山寄怀尤延之三首 其一","author":"杨万里","text":"惠山一别十年强，雪后精神老更苍。\n白玉屏风三万丈，半天遮断太湖光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68491,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"樱桃花","author":"杨万里","text":"樱桃花发满晴柯，不赌娇饶只赌多。\n落尽江梅馀半朵，依前风韵合还他。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68492,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"豫章江皋二绝句 其一","author":"杨万里","text":"幸自轻阴好片秋，如何馀热未全休。\n大江欲近风先冷，平野无边草亦愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68493,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"豫章江皋二绝句 其二","author":"杨万里","text":"只今秋稼满江郊，犹记春船掠屋茅。\n可是北风寒入骨，荻花争作向南梢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68494,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"醉后撚梅花近壁以灯照之宛然如墨梅","author":"杨万里","text":"老子年来画入神，凿空幻出墨梅春。\n壁为玉板灯为笔，整整斜斜样样新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68495,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"醉眠夜闻霜风甚紧起坐达旦二首 其二","author":"杨万里","text":"雪花旋落旋成融，横作清霜阵阵风。\n一夜急吹君会否，妒它残叶恋丹枫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68496,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"醉眠夜闻霜风甚紧起坐达旦二首 其一","author":"杨万里","text":"玉酒醺人底易醒，月低梅影恰三更。\n只嫌老眼清无睡，不道松声听到明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68497,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"镊白","author":"杨万里","text":"莫把菱花镊白髭，劝君留取伴吟诗。\n锦囊若要添新句，绣口如何减素丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68498,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"镊白","author":"杨万里","text":"五十如何是后生，呼儿拔白未忘情。\n新年只道无功业，也有霜髭六十茎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68499,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"霅溪","author":"杨万里","text":"道场山背是吴兴，只不教人到德清。\n霅水相留别无计，却将溪曲暗添程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68500,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题山庄小集","author":"杨万里","text":"莫笑山庄小集休，篇篇字字爽于秋。\n向来枫落吴江冷，一句能销万古愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68501,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题山庄草虫扇","author":"杨万里","text":"风生蚱蜢怒须头，纨扇团圆璧月流。\n三蝶商量探花去，不知若个是庄周。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68502,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题太和宰卓士直寄新刻山谷快阁诗真迹二首 其二","author":"杨万里","text":"太史留题快阁诗，旧碑未必是真题。\n六丁搜出严家墨，白日青天横紫蜺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68503,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题太和宰卓士直寄新刻山谷快阁诗真迹二首 其一","author":"杨万里","text":"快阁江鸥远避人，西昌山月暗吹尘。\n百年卓茂传诗印，印出风光色色新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68504,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题文发叔所藏潘子真水墨江湖八境小轴 其五 太湖秋晚","author":"杨万里","text":"水气清空外，人家秋色中。\n细看千万落，户户水精宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294