[{"title":"李抚州挽词 其一","author":"楼钥","text":"与物初无忤，台评反谓倾。\n麾符成漫仕，林壑寄平生。\n跪履嗟何晚，挥犀空复情。\n天台隔风浪，无地拜佳城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25142,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李度支挽词 其二","author":"楼钥","text":"孰匪同升素，君于我最亲。\n词章传自旧，翰墨恍犹新。\n别去情逾笃，归来迹遽陈。\n无从效经纪，悲结泪沾巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25143,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李度支挽词 其一","author":"楼钥","text":"忽作堂堂去，门前爵已罗。\n梦随弹指断，事向盖棺多。\n心系六州铁，身倾千丈坡。\n喑喑昼夜哭，柰此敬姜何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25144,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李起宗舍人悠然亭","author":"楼钥","text":"远游蜀道历艰难，径上甘泉豹尾间。\n荷橐忽思辞北省，拂衣自喜见南山。\n当时旁舍基犹在，回首垂髫鬓已斑。\n先友碑阴尽陈迹，寒空依旧湿烟鬟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25145,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杨圣可棋集余方归自桃源不及预次韵","author":"楼钥","text":"屏处尤便野性慵，故人何幸总相逢。\n赋归敢慕陶彭泽，自免犹睎邴曼容。\n棋酒交欢情正洽，江山得助景方浓。\n嗟余误入桃源去，归路满城闻晚钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25146,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"扬州琼花","author":"楼钥","text":"回忆灵根六十年，秋深恨不见芳鲜。\n兹从淮上来千里，非比人间聚八仙。\n曾有画图称小异，谅应后土爱孤妍。\n或言天杖诚虚语，荣悴中分亦偶然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25147,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杨武恭王挽词 其四","author":"楼钥","text":"王爵报元勋，临危更致身。\n鲸波飞战舰，狼子叹江神。\n木落淮南暮，尘清塞外春。\n功臣谁第一，图画在麒麟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25148,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杨武恭王挽词 其三","author":"楼钥","text":"父祖成完节，丹心激懦夫。\n枕戈枭逆虏，抚剑志伊吾。\n忠孝公何愧，哀荣世所无。\n从今紫荷橐，接武上亨衢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25149,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杨武恭王挽词 其二","author":"楼钥","text":"勇气真虓虎，仁心剧放麑。\n推锋多折馘，解缚屡招携。\n细柳门坚闭，长杨马不嘶。\n夜深星忽堕，何处问撑犁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25150,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杨武恭王挽词 其一","author":"楼钥","text":"历数中兴将，谁为第一功。\n两朝忠卫上，四海雅推公。\n富贵无危溢，哀荣有始终。\n吾知尚遗恨，不见朔庭空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25151,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杨待制挽词 其四","author":"楼钥","text":"事契因同荐，交情晚益亲。\n半生文会少，万里宦游频。\n别后书犹湿，归来迹遽陈。\n何能发潜德，空有泪沾巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25152,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杨待制挽词 其一","author":"楼钥","text":"望重威无怒，仁深勇有馀。\n百年忧国志，满箧荐贤书。\n德政不胜载，才猷未尽摅。\n佳儿人物似，真可大门闾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25153,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杨待制挽词 其三","author":"楼钥","text":"蜀用东南彦，皇家属意深。\n贰卿频报政，上相最知心。\n泛宅俱杭苇，同朝拟断金。\n庙廊期引类，疾病两侵寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25154,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杨待制挽词 其二","author":"楼钥","text":"蜀道名天险，驰驱敢惮劳。\n剑头悬六印，梦里益三刀。\n汉殿联簪橐，燕山拥节旄。\n惜哉觇国意，不得试龙韬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25155,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"求参议挽词 其二","author":"楼钥","text":"玉立期清贵，厖眉望寿龄。\n父兄嗟奄忽，姑姊亦凋零。\n厚德今谁在，佳城惨欲扃。\n孙曾闻竞爽，兰玉在阶庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25156,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"求参议挽词 其一","author":"楼钥","text":"累世朱陈旧，宦游多向鄞。\n飞凫观政美，展骥愈情亲。\n久草归田赋，欣迎入幕宾。\n斯人忽千古，望断剡溪滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25157,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"汪达可招游臧园次韵 其二","author":"楼钥","text":"满架酴醾惬雅怀，更添林下紫徘徊。\n平湖不怕重门阻，胜赏何妨后日来。\n酒兴已随斜照远，诗情无待片云催。\n黄昏鼓棹欲归去，望望烟林首重回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25158,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"汪达可招游臧园次韵 其一","author":"楼钥","text":"城下名园称老怀，乳莺飞燕共低徊。\n寒梅送腊曾先到，嫩绿留春喜再来。\n眼底芳时能几许，楼头衙鼓谩相催。\n主人好事不嫌客，素壁挥毫又一回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25159,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"沈宪敏公挽词 其一","author":"楼钥","text":"天使魁乡荐，上令卿改官。\n蚤峨乌府豸，终著侍臣冠。\n持节威行惠，专城猛济宽。\n绍熙多旧学，胡不相宫端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25160,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"沈宪敏公挽词 其三","author":"楼钥","text":"徐邈今非介，申枨焉得刚。\n立朝无附丽，受谪更芬香。\n戏綵衣冠盛，围棋日月长。\n典刑今已矣，无复岿灵光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25161,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"沈宪敏公挽词 其五","author":"楼钥","text":"晚出荷公知，登门未觉迟。\n通班依汉橐，试郡守萧规。\n藻翰犹频寄，宫墙不再窥。\n新阡何处是，西望不胜悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25162,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"沈宪敏公挽词 其四","author":"楼钥","text":"持论真遗直，操心本至公。\n赢赀宁市宠，平寇不言功。\n光禄文阶峻，嘉兴色养丰。\n谁能死生际，犹得教之忠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25163,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"沈宪敏公挽词 其二","author":"楼钥","text":"仕宦接王杨，诸公叹老苍。\n门生多紫禁，子舍屡黄堂。\n自得垂车乐，谁传却老方。\n桃花千树满，空忆旧刘郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25164,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"沈朝奉挽词","author":"楼钥","text":"相业富青箱，丁年稔义方。\n生儿有如此，与世遂相忘。\n终老三牲养，凌晨一炷香。\n浮休了无恨，流庆尚深长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25165,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"灵芝寺","author":"楼钥","text":"送客灵芝寺，恁阑山有无。\n自从朝北阙，始得见西湖。\n烟外移轻桨，波间浴野凫。\n清寒不可驻，回首又神都。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25166,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"灵峰","author":"楼钥","text":"老筇扶我转林丘，直到僧房最上头。\n地拥双峰遮胜境，天分半石閟灵湫。\n空中大士澹相对，山罅清泉空自流。\n人谓石崖宜置我，不知来此有缘不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25167,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"灵壁道中","author":"楼钥","text":"古汴微流绝，馀民尚孑遗。\n高丘祠汉祖，荒草葬虞姬。\n垓下空陈迹，鸿沟怆近时。\n膏腴满荆棘，伤甚黍离离。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25168,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"苏江阴挽词 其二","author":"楼钥","text":"伊昔初倾盖，摛文已甚工。\n亲闻南涧语，谓有魏公风。\n既往言多验，归来道更穷。\n诲言非教佞，后裔报宜丰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25169,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"苏江阴挽词 其一","author":"楼钥","text":"万卷蟠胸次，千篇秀笔端。\n朝行期奋迅，贤路竟艰难。\n虽号循良守，欠为文字官。\n遗编幸无恙，留与后人看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25170,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贡闱对砚盘发叹","author":"楼钥","text":"老去未忘黄与朱，琢成三砚乐閒居。\n岂能更作诸生业，但欲频看后世书。\n视草北门才已尽，持衡南省计尤疏。\n便须再挂衣冠去，约汝同归故草庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25171,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陆参议挽词 其二","author":"楼钥","text":"饰吏先儒雅，低徊五十霜。\n萑蒲扫韶石，桑柘满黄冈。\n知己平津老，传家删定郎。\n八龙无半在，风雨夜侵床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25172,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陆参议挽词 其一","author":"楼钥","text":"中外衣冠盛，流传识后凋。\n声名三语掾，身世半僧寮。\n宝晋书尤逸，坡仙隐可招。\n梅溪残月堕，芜没旧风标。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25173,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陆郎中挽词 其二","author":"楼钥","text":"从弟忝东床，相从二十霜。\n人琴一何苦，冰玉两俱伤。\n别久成今昔，归来失老苍。\n稽阴终反葬，西望倍凄凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25174,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陆郎中挽词 其一","author":"楼钥","text":"壮岁联双捷，衰年困百罹。\n肉身心佛子，霜发貌婴儿。\n万事几樽酒，百年千首诗。\n浮生成梦觉，吾道竟何之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25175,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陆宣城挽词","author":"楼钥","text":"奕世承家学，诸公荐吏能。\n政传花县美，心与练江澄。\n易箦去何远，攀辕悲不胜。\n伤哉嬴博葬，泪尽老延陵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25176,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陆提刑挽词 其一","author":"楼钥","text":"数马谦恭甚，挥犀色笑温。\n风流士龙裔，文采左丞孙。\n晚幸成三径，身胡遽九原。\n素钦仁者勇，大狱竟平反。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25177,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陆提刑挽词 其二","author":"楼钥","text":"早岁擅词场，夷途列雁行。\n一麾分楚甸，双节照江乡。\n莲社容寒晚，葭莩接老苍。\n八旬俱已矣，回首倍凄凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25178,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陈夫人挽词 其一","author":"楼钥","text":"族姓甲休阳，夫人懿范彰。\n奇男已南省，快婿更东床。\n珍锡人加叹，佳城神所藏。\n平生阴德在，馀庆尚难量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25179,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陈夫人挽词 其二","author":"楼钥","text":"雅有幽閒操，来嫔清白家。\n相夫全礼敬，见子致清华。\n方享乘轩乐，俄兴陟屺嗟。\n谁将彤史纪，大笔为雄誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25180,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陈夫人挽词","author":"楼钥","text":"作配知名士，周旋内则篇。\n宜家兼四德，训子见三迁。\n就养荣方逮，归宁病忽缠。\n庆源流未已，佳兆得牛眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25181,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陈文恭公挽词 其三","author":"楼钥","text":"辅赞藏诸用，庸人自扰之。\n惟公知好静，与物尽忘私。\n德望仪群辟，威名憺远夷。\n伤心白鸡梦，梁木有馀悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25182,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陈文恭公挽词 其四","author":"楼钥","text":"致主唐虞上，东山志不渝。\n衮衣重入觐，胡骑敢长驱。\n梦已商楹奠，朝犹汉殿趋。\n哀荣极终始，何止渡江无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25183,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陈文恭公挽词 其二","author":"楼钥","text":"德量汪汪万顷陂，直将去就佩安危。\n干戈虽在相寻日，休沐宛如无事时。\n奏罢未闻宫漏转，归来俄见哲人萎。\n哀荣终始谁能及，百世旌忠颂德碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25184,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陈文恭公挽词 其一","author":"楼钥","text":"唐虞千载道重光，奕奕元臣任赞襄。\n谢傅风流冠江左，晋公威誉比汾阳。\n折冲曾不劳声色，辅政惟先振纪纲。\n天意高高谁可问，坐令邦国叹云亡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25185,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陈文懿公挽词 其二","author":"楼钥","text":"文最宜为诰，尤能简上心。\n周旋銮掖久，惆怅玉堂深。\n去国身仍远，还朝病已侵。\n三山风引去，云海竟沉沉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25186,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陈文懿公挽词 其四","author":"楼钥","text":"宅相惟公久，伊余忝后尘。\n十年追桂籍，两禁踵词臣。\n接武参吾舅，承颜奉老亲。\n幸成三学士，何意失斯人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25187,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陈文懿公挽词 其五","author":"楼钥","text":"一别屡经岁，归舟已及门。\n方期情话悦，空讶语音存。\n善行传千载，芜词愧九原。\n伤心歌楚些，无地可招魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25188,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陈文懿公挽词 其一","author":"楼钥","text":"众口推文伯，何人识吏师。\n义襟惟古有，心地只天知。\n至死终无玷，平生本不欺。\n在公亡可憾，犹恨哲人萎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25189,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陈文懿公挽词 其三","author":"楼钥","text":"珍馆径归鄞，人犹望秉钧。\n邮传千里讣，哀动五州民。\n躄踊森贤嗣，攀号感路人。\n公乎不亡矣，衮衮看簪绅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25190,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陈君举既亡汪文子携其所作春秋后传及送行诗来次韵","author":"楼钥","text":"名盛望尤备，枝披实亦繁。\n无由究贤业，犹幸立斯言。\n书在经逾显，人亡道更尊。\n九京如可作，与子共南辕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25191,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陈秘撰挽词 其一","author":"楼钥","text":"陈氏多名德，兹来慕典刑。\n宫端惊宿草，冷撰又泉扃。\n自古有遗直，祇今谁独醒。\n苍苍何可问，耆旧日彫零。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25192,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陈秘撰挽词 其二","author":"楼钥","text":"跬步不忘孝，掇皮皆是真。\n移忠思致主，务实见临民。\n三谏言犹炳，平生迹遽陈。\n清风凛衰俗，自足荡秋旻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25193,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陈崇道挽词 其二","author":"楼钥","text":"未第声先振，才官节已奇。\n精诚与神合，隐行畏人知。\n晚境终无玷，遗文尚可师。\n功名赍志殁，回施称家儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25194,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陈崇道挽词 其一","author":"楼钥","text":"学造龟山蕴，诗传汝水馀。\n于公足阴德，陶令竟闲居。\n白业追莲社，丹经授寝虚。\n平生了无恨，善类勿欷歔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25195,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"具美堂","author":"楼钥","text":"明光殿里早催班，亭午天街从驾还。\n已听欢声传市井，更看喜气满湖山。\n联镳远去閒寻胜，烂醉归来夜叩关。\n但愿两宫千万寿，退公时得过云间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25196,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"净明方丈","author":"楼钥","text":"云深宿雨未忺晴，短艇还来叩晓扃。\n山溜拥溪侵石磴，天风吹雾暗空庭。\n茵铺野草滋新绿，玉立修篁洗旧青。\n老我时时假僧榻，梦魂直向醉中醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25197,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"叔韶弟以退堂洪老诗来寄谢","author":"楼钥","text":"不受人天供，甘心乐隐居。\n坐穷千里目，笑拥一楼书。\n攻愧老无用，退堂闲有馀。\n相望可杭苇，何日访吾庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25198,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"周太博挽词","author":"楼钥","text":"雨涨双溪水，风高五柳堂。\n论交成莫逆，抚事祇堪伤。\n访雪无回棹，面山空夕阳。\n乱莺穿绿树，谁复为传觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25199,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"周左司挽词 其一","author":"楼钥","text":"从政心无愧，敢言人所难。\n精忠忧世切，清节照人寒。\n交臂失持橐，乞身终考槃。\n老成今已矣，西望涕汍澜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25200,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"周左司挽词 其二","author":"楼钥","text":"乙丑慈恩会，今几六十霜。\n轺车来握节，相府记传觞。\n诗薮怀高隐，邮筒见短章。\n不堪千里隔，丹旐想飞扬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25201,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"周路分挽词 其二","author":"楼钥","text":"台岭论交契，天街惜别离。\n飞书能几到，埋璧遽成悲。\n旧识归樵句，愁看结局诗。\n紫髯无复梦，空有泪交颐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25202,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"周路分挽词 其一","author":"楼钥","text":"蚤负功名志，从戎岂素心。\n治军先肃靖，游艺亦精深。\n湖海开豪气，云天廓义襟。\n高门尚馀庆，兰玉正森森。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25203,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"周德远挽词","author":"楼钥","text":"家世传儒业，乡邦耸义风。\n将迎无倦色，交友尽名公。\n太学飞声早，浮生转首空。\n怡如堂下月，犹照紫荆丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25204,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"国仲观迁居尹隩访别","author":"楼钥","text":"晚年来定一枝巢，到处盖头无把茅。\n又欲浮家过尹隩，何殊乐道向莘郊。\n君今去此难招隐，老更从谁可定交。\n见说衡门临野水，秋深容我去推敲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25205,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"国清寺","author":"楼钥","text":"夹道青松引客来，五峰双涧拥楼台。\n丰干饶舌留公案，隋帝遗书暗古煤。\n最喜亲知来里社，真成春月上天台。\n阴云扫尽寻幽去，佳处端疑为我开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25206,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜坐","author":"楼钥","text":"晚凉徐步出柴扃，万变浮云在窈冥。\n浓似铁山擎缺月，薄于春絮透疏星。\n正欣夜久沉天籁，尤喜空明郁帝青。\n雨气未平龙欲动，电光前后射中庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25207,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜坐","author":"楼钥","text":"重云烟雨日冥冥，柱础流津意未晴。\n赖得溪风送云出，放开山月照人明。\n纷纭世态长松影，荏苒时光流水声。\n坐久萧然转琴轴，为君更作九皋鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25208,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜坐烧香台","author":"楼钥","text":"长昼苦炎热，夜分凉始生。\n电中千嶂立，琴外一蛩鸣。\n急雨催诗思，遥空答鼓声。\n谁知一府地，得此意凄清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25209,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜携家登南渡桥","author":"楼钥","text":"几过长桥下，清宵得意行。\n风高江水急，月上海潮生。\n空迥寒逾峭，更深境过清。\n扁舟难久驻，转柂问归程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25210,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]