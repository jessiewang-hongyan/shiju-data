[{"title":"以庐山三叠泉寄张宗瑞","author":"汤巾","text":"九叠峰头一道泉，分明来处与云连。\n几人竞赏飞流胜，今日方知至味全。\n鸿渐但尝唐代水，涪翁不到绍熙年。\n从兹康谷宜居二，试问真岩老咏仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39885,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠久轩提刑江东二首 其二","author":"汤中","text":"晨登鹤岭俯平川，暂辍鸣驺看瀑泉。\n自有此山无此客，愧非真隐枉真贤。\n精庐岂但荣三顾，憩木犹应咏百年。\n独愧庵无煨芋老，邺侯虽过莫留连。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39886,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠久轩提刑江东二首 其一","author":"汤中","text":"三年饮得大江中，更枉輶轩到里中。\n访旧不辞山路险，居今谁有古人风。\n汉胡隐遁藏清叟，瑞节欢迎走野童。\n赖有良朋共樽酒，雍容不与孙文同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39887,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过罗首","author":"汤中","text":"山势迢迢万马奔，就宽平处著祇园。\n门无俗驾真堪隐，院有禅僧便不村。\n百顷霜黄收■稏，一泓寒绿养兰荪。\n我来访道连宵宿，共拨炉灰仔细论。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39888,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"汤中","text":"金堂玉室相掩映，珠帘翠箔谁褰开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39889,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题灵鹫四首 其四","author":"汤汉","text":"问禅去灵隐，听讲去天竺。\n还有无求人，来寻灵鹫宿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39890,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄刘后村","author":"汤汉","text":"唐朝空自贵宏词，科目何尝得退之。\n掌制徒闻誇子厚，残篇仅见命敦诗。\n堪嗟实录无完传，太息淮西有后碑。\n寄语莆田紫薇老，文章盖世例如斯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39891,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠久轩提刑江东二首 其二","author":"汤汉","text":"向来廷诤伟堂堂，不负西山与紫阳。\n尽道拾遗当召黯，不应清诏久烦滂。\n真儒事业谁能测，忧国忠纯不谩狂。\n一上蓬莱看云海，细毡归去论虞唐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39892,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠久轩提刑江东二首 其一","author":"汤汉","text":"江右皇华溯浙东，按行特地到山中。\n柴门忽有高轩过，衰俗久无前辈风。\n嵩岳气摇消息长，祝融开霁鬼神通。\n荒崖绝谷留光彩，长使人怀太极翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39893,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观鱼亭","author":"汤汉","text":"有亭翼然山之阿，源头活水养鱼多。\n云山四面如画图，金梭上下光相摩。\n池上木深阴翳地，池下荷生香扑鼻。\n携酒邀朋池上观，圉圉洋洋真得意。\n咄，东海鲤，南溟鱼，自信时人莫浅窥，神灵岂是池中物。\n变化成龙会有期，一朝烜赫雷声壮。\n翻身直透三层浪，扬鬐鼓鬣横千丈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39894,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿孔野云丹房","author":"汤汉","text":"天师炼丹时，丹鼎见龙虎。\n丹成天师去，龙虎名万古。\n溪深松杪风，山明夜来雨。\n雨后丹凤鸣，风前黄鹄举。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39895,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题灵鹫四首 其三","author":"汤汉","text":"南涧静者徒，小试扶颠手。\n期毕栋宇工，拂衣入岩岫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39896,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题灵鹫四首 其二","author":"汤汉","text":"引泉已成沼，对石宜破窗。\n他年涧上桥，为子书春淙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39897,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题灵鹫四首 其一","author":"汤汉","text":"灵鹫古道场，摄乎大国间。\n一日忽翚飞，四顾无腼颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39898,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自儆","author":"汤汉","text":"春秋责备贤者，造物计校好人。\n一点莫留馀滓，十分成就全身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39899,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梁宝寺","author":"汤乔年","text":"田舍风光迥，僧房意象深。\n未穷千里目，聊慰一时心。\n远树轻烟入，孤村落日侵。\n自非真静者，谁复有幽寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39900,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山行","author":"汤志道","text":"攀藤缘绝壑，野鹿场边去。\n鸟衔山果来，落在鹿眠处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39901,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"咏石僧","author":"汤思退","text":"云作袈裟石作僧，岩前独立几经春。\n有人若问西来意，默默无言总是真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39902,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 游水月寺","author":"汤思退","text":"画船横绝湖波练。\n更上雕鞍穷翠巘。\n霜橘半垂黄。\n征衣尽日香。\n钟声云外听。\n金界青松映。\n何处是华山。\n峰峦杳霭间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39903,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"汤思退","text":"虞妃从醒野，启母袝稽山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39904,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二郎神 用徐斡臣韵","author":"汤恢","text":"琐窗睡起，闲伫立、海棠花影。\n记翠楫银塘，红牙金缕，杯泛梨花冷。\n燕子衔来相思字，道玉瘦、不禁春病。\n应蝶粉半销，鸦云斜坠，暗尘侵镜。\n还省。\n香痕碧唾，春衫都凝。\n悄一似荼，玉肌翠帔，消得东风唤醒。\n青杏单衣，杨花小扇，闲却晚春风景。\n最苦是、蝴蝶盈盈弄晚，一帘风静。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39905,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二郎神","author":"汤恢","text":"碧崖倒影，浸一片、寒江如练。\n正岸岸柳花，村村修竹，唤醒春风笔砚。\n溯水舟轻轻如叶，只消得、溪风一箭。\n看水部雄文，太师健笔，月寒波卷。\n游倦。\n片云孤鹤，江湖都遍。\n慨金屋藏妖，绣屏包祸，欲与三郎痛辩。\n回首前朝，断魂残照，几度山花崖藓。\n无限都付窊尊，漠漠水天远。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39906,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"八声甘州","author":"汤恢","text":"想当年、龙舟凤艒，乐宸游、摇曳锦帆斜。\n伤心是，御香染处，树树栖鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39907,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"八声甘州","author":"汤恢","text":"摘青梅荐酒，甚残寒、犹怯苎萝衣。\n正柳腴花瘦，绿云冉冉，红雪霏霏。\n隔屋秦筝依约，谁品春词。\n回首繁华梦，流水斜晖。\n寄隐孤山山下，但一瓢饮水，深掩苔扉。\n羡青山有思，白鹤忘机。\n怅年华、不禁搔首，又天涯、弹泪送春归。\n销魂远，千山啼鴂，十里荼蘼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39908,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"祝英台近 其一","author":"汤恢","text":"宿酲苏，春梦醒，沈水冷金鸭。\n落尽桃花，无人扫红雪。\n渐催煮酒园林，单衣庭院，春又到、断肠时节。\n恨离别。\n长忆人立荼蘼，珠帘卷香月。\n几度黄昏，琼枝为谁折。\n都将千里芳心，十年幽梦，分付与、一声啼鴂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39909,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"祝英台近 其二 中秋","author":"汤恢","text":"月如冰，天似水，冷浸画阑湿。\n桂树风前，醲香半狼藉。\n此翁对此良宵，别无可恨，恨只恨、古人头白。\n洞庭窄。\n谁道临水楼台，清光最先得。\n万里乾坤，原无片云隔。\n不妨彩笔云笺，翠尊冰酝，自管领、一庭秋色。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39910,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"倦寻芳","author":"汤恢","text":"饧箫吹暖，蜡烛分烟，春思无限。\n风到楝花，二十四番吹遍。\n烟湿浓堆杨柳色，昼长闲坠梨花片。\n悄帘栊，听幽禽对语，分明如剪。\n记旧日、西湖行乐，载酒寻春，十里尘软。\n背后腰肢，彷佛画图曾见。\n宿粉残香随梦冷，落花流水和天远。\n但如今，病厌厌、海棠池馆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39911,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"汤夏","text":"净瓶常带水，破衲任生尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39912,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"马上吟","author":"汤莘叟","text":"宿雨洗山新绿嫩，晓风吹杏浅红乾。\n沙头路暖日欲上，行客扬鞭不觉难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39913,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登宜春台","author":"汤莘叟","text":"草径无边绿，江空见底清。\n遥峰横晚色，古木自秋声。\n客舍孤云远，乡心一雁鸣。\n凭高寄吴楚，倚杖独含情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39914,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题舫斋","author":"汤莘叟","text":"谁人能使陆行舟，涉水宁无险覆忧。\n日照檐楹帆影动，风摇窗户橹声柔。\n梦回渭水清新句，歌罢浯溪欸乃愁。\n更看霜天晴夜月，幌然如过洞庭秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39915,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"汤莘叟","text":"葛巾簪下无多发，茅舍门前有好山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39916,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"四贤堂","author":"汤起岩","text":"猗与四公，棠棣之华。\n秀韡一时，茂兴两家。\n宋公联翩，鄂不相鲜。\n万里风云，上负青天。\n连公戾契，渊冰澄结。\n进而蹩躄，砥砺其节。\n其光晔晔。\n追惟平生，法兴是仪。\n邑人之思，右史之词。\n雨箔风楹，岁环几经，筑此特堂。\n吾今令君，令君勤民。\n民燕其德，振滞补弊，此焉居一。\n于时四公，序集其觞。\n生气津津，冠佩有光。\n古之为政，崇德尚贤。\n居今笃古，令君有焉。\n君系陇西，绍祖维名。\n起岩作诗，辑和厥声。\n敢告典者，毋替其承。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39917,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夹竹桃","author":"汤清伯","text":"芳姿劲节本来同，绿荫红妆一样浓。\n我若化龙君作浪，信知何处不相逢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39918,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"汤黄中","text":"近人方贺厦，如客已惊秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39919,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诀别偈","author":"汤道亨","text":"八十一年饶舌，终日化缘不歇。\n重阳时节归家，一路清风明月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39920,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽谢叠山 其一","author":"汤雷奋","text":"向老逢危乱，投军复欲东。\n九迁徒有命，一战不成功。\n楚狂言犹在，韩雠事已空。\n风尘长苍莽，身世转飘蓬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39921,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽谢叠山 其三","author":"汤雷奋","text":"怀哉千古事，百炼不为柔。\n汉祖尤封齿，殷臣不事周。\n宁随文相国，真匹李潭州。\n浩荡江相接，东西万古愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39922,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽谢叠山 其二","author":"汤雷奋","text":"芒鞋初就道，慷慨不辞难。\n滚滚长江尽，萧萧易水寒。\n风霜欺汉节，尘土上南冠。\n无复加餐饭，旁人掬泪看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39923,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游练湖题甘露南庄壁","author":"汤模","text":"极目湖光里，招提万顷田。\n庭荒无马迹，木落见炊烟。\n今日山林畔，他年香火缘。\n烦师瀹春茗，为说小乘禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39924,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"牟及","text":"何日脊令还并影，旧时豚犬已成空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39925,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题帜","author":"牟大昌","text":"大宋忠臣牟大昌，义兵今起应天祥。\n赤城虽已降为虏，黄山不愿为之氓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39926,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"风瀑竹 元宵","author":"牟子才","text":"阁住杏花雨。\n便新晴、等闲勾引，香车成雾。\n璧月光中箫凤远，袅袅馀音如缕。\n诮一似、群仙府。\n天意乍随人意好，渐星桥、度汉珠还浦。\n又何啻、列千炬。\n晚来乍觉阴盘固。\n笑人间、玉瓶瑶瑟，锦茵雕俎。\n无限升平宣政曲，回首中原何处。\n慨鸣镝、已无宫武。\n扑面胡尘浑未扫，强欢讴、还肯轩昂否。\n萦旧恨，为谁赋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39927,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"牟孔锡","text":"天池十里如鉴湖，荷花可折鱼可脍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39928,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"百七丈","text":"尽道温柔别有乡，谁知绛阙水茫茫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39929,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨中花慢 贺欧文建楼与桥","author":"百兰","text":"饤斗云山，挨排烟水，六丁午夜文移。\n道滁翁孙子，欲寄游嬉。\n高趁鹜霞舒啸，低群鸥鹭忘机。\n牢笼两下，楼乘汗漫，桥枕清漪。\n灞陵吟畅，岳阳登览，百色都副襟期。\n还好是、行天马渡，探月人归。\n倚柱荷香扑面，凭栏桂影侵衣。\n索梅无便，春风不碍，容我追随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39930,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"满庭芳 贺晚生子","author":"百兰","text":"有分非难，是缘终合，采来还换须臾。\n少年培植，春意已敷腴。\n毕竟花多驻果，坚牢是、蚌老生珠。\n君知否，今番定也，颠不破璠玙。\n遥知纷瑞霭，十分郎罢，黄溢眉须。\n便何妨燕喜，剩买欢娱。\n况侍北堂难老，庭阶映、玉树森如。\n金荷劝，从教酩酊，扶醉看孙株。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39931,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"醉蓬莱","author":"百兰","text":"怪柳吟翻雪，梅笑冲寒，郁葱如彩。\n还是瑶池，宴神仙俦侣。\n罗幕轻掀，绣帘低揭，按霓裳宫羽。\n宝炷熏浓，佩环声颤，凤飞鸾舞。\n犹记年时，玉箫吹彻，并驾萧郎，共骖赢女。\n旋捧麒麟，种旧家前武。\n政了摘星天上，早约个、嫦娥住。\n妆点华堂，双扶醉玉，黑颠如许。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39932,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"百醉老人","text":"中原戎马场，故国虎狼窟。\n言归成默伤，念之中心慄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39933,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"不执宝大师房","author":"祁彭年","text":"枯槁形容七十馀，见人无力出禅居。\n萧然丈室常扃户，一炷清香万虑除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39934,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"锡杖泉","author":"祁彭年","text":"昔有高人示化权，曾随杖锡涌甘泉。\n岩穿细孔成池沼，香积僧庖待涤蠲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39935,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"百家岩","author":"竹林吟叟","text":"明月池边酌玉罍，玉罍未倒玉山颓。\n秋风吹断华胥梦，卧看飞云过岭来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39936,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小重山","author":"米友仁","text":"雨过风来午暑清。\n榴花红照眼，向人明。\n一枝低映宝钗横。\n菖蒲酒，玉碗十分斟。\n引满听新声。\n小轩帘半卷，远山青。\n几人闲处见闲情。\n醒还醉，为趣妙难名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39937,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小重山","author":"米友仁","text":"醉倚朱阑一解衣。\n碧云迷望眼，断虹低。\n近来休说带宽围。\n人千里，还是燕双飞。\n深院日初迟。\n绮窗帘幕静，恨生眉。\n不堪虚度是花时。\n鸿来速，争解寄相思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39938,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"念奴娇","author":"米友仁","text":"洞天昼永，正中和时候，凉飙初起。\n羽扇纶巾，云流处，水绕山重云委。\n好雨新晴，绮霞明丽，全是丹青戏。\n豪攘横卷，楚天应解深秘。\n留滞。\n字学书林，折腰缘为米，无机涉世。\n投组归来欣自肆，目仰云霄醒醉。\n论少卑之，家声接武，月旦评吾子。\n凭高临望，桂轮徒共千里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39939,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"阮郎归","author":"米友仁","text":"小舟载酒向平湖。\n新凉生晓初。\n乱山烟外有还无。\n王维真画图。\n风遽起，动襟裾。\n雨来荷溅珠。\n一尊相对喜君俱。\n醉归红袖扶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39940,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"阮郎归","author":"米友仁","text":"碧溪风动满文漪。\n雨馀山更奇。\n淡烟横处柳行低。\n鸳鸯来去飞。\n人似玉，醉如泥。\n一枝随鬓攲。\n夷犹双桨月平西。\n幽寻归路迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39941,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诉衷情令 渊明诗","author":"米友仁","text":"结庐人境羡陶潜。\n车马不来喧。\n胜处自多真趣，飞鸟日相还。\n心既远，地仍偏。\n见南山。\n手持菊颖，山气常佳，欲辨忘言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39942,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"念奴娇 裁成渊明归去来辞","author":"米友仁","text":"阑干倚处。\n戏裁成、彭泽当年奇语。\n三径荒凉怀旧里，我欲扁舟归去。\n鸟倦知还，寓形宇内，今已年如许。\n小窗容膝，要寻情话亲侣。\n郭外粗有西畴，故园松菊，日涉方成趣。\n流水涓涓千涧上，云绕奇峰无数。\n窈窕经丘，风清月了，时看烟中雨。\n萧然巾岸，引觞寄傲衡宇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39943,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"念奴娇 村居九日","author":"米友仁","text":"九秋气爽，正溪山雨过，茅檐清暇。\n篱菊妍英，知是为，佳节重阳开也。\n色妙香殊，匀浮瓯面，俗状卑金斝。\n歌狂饮俊，满簪还更盈把。\n村外草草杯盘，边尘不动，欲买应无价。\n端使晴霄风露冷，云卷烟收平野。\n向晚婵娟，半轮斜照，想见成清夜。\n玉山颓处，要看攲帽如画。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39944,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"临江仙","author":"米友仁","text":"野外不堪无胜侣，笑谈安得君同。\n四时景物一壶中。\n醉馀临望处，远岫数重重。\n溪上新荷初出水，花房半弄微红。\n晓风萧爽韵疏松。\n娟娟明月上，人在广寒宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39945,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"临江仙","author":"米友仁","text":"一曲阳关肠断处，临风惨对离尊。\n红妆揭调十分斟。\n古来多聚散，正似岭头云。\n昨夜晴霄千里月，向人无限多情。\n娟娟今夜满虚庭。\n一帆随浪去，却照画船轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39946,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"临江仙","author":"米友仁","text":"昨夜扁舟沙外舣，淮山微雨初晴。\n断云飞过月还明。\n一天风露重，人在玉壶清。\n水际不知何许是，遥林□辨微青。\n醉迷归梦强□凌。\n谁言东去雁，解寄此时情。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39947,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"临江仙","author":"米友仁","text":"宝晋轩窗临望处，山围水绕林萦。\n不堪回首到江城。\n墙趺围瓦砾，鸥鹭见人惊。\n日愿太平归旧里，更无馀事关情。\n小营茅舍倚云汀。\n四时风月里，还我醉腾腾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39948,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南歌子","author":"米友仁","text":"遇酒词先举，逢山眼暂明。\n一川风雨纵留人。\n不道此郎归兴、欲兼程。\n客久情深□，寻欢恨不能。\n绳床顿睡梦纵横。\n赖□□□□□、□□□。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39949,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]