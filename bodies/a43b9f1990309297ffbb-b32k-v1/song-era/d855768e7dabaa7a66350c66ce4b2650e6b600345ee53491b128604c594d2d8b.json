[{"title":"咏梅五十首呈史尚书 其二十一","author":"释绍嵩","text":"官梅一树小池头，绕著瑶芳看不休。\n为语邻舟莫吹笛，冰肌香骨未禁愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15797,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏梅五十首呈史尚书 其二十五","author":"释绍嵩","text":"舍南舍北雪犹存，诚对东风问小园。\n一夜小园开似雪，暗香浮动月黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15798,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏梅五十首呈史尚书 其四十六","author":"释绍嵩","text":"郊原空阔净无尘，且放千林自在春。\n借问梅花何处落，翠苔苍藓石磷磷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15799,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏梅五十首呈史尚书 其三十七","author":"释绍嵩","text":"风饕雪虐长精神，冷叶疏花次第匀。\n今日含毫与题品，更无篇什写清新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15800,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏梅五十首呈史尚书 其四十九","author":"释绍嵩","text":"木落霜空眼底宽，一枝相映竹丛寒。\n不须更觅吴州画，镜里云山且共看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15801,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏梅五十首呈史尚书 其三十九","author":"释绍嵩","text":"小瓶春色一枝斜，天下无双独此花。\n冰玉精神霜雪操，寂寥相对是仙家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15802,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜闻杜鹃","author":"释绍嵩","text":"竹坞无尘水槛清，一更更尽到三更。\n杜鹃不管人残梦，雨外飞来头上声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15803,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"放舟戏书 其二","author":"释绍嵩","text":"两岸萧萧芦荻秋，斜风细雨转船头。\n年来频作江湖梦，须向山阴上小舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15804,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"放舟戏书 其一","author":"释绍嵩","text":"放缆山溪一叶轻，树头半落半犹青。\n竹间飞下双鸂鶒，天作人间小画屏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15805,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"知府黄寺簿生日 其三","author":"释绍嵩","text":"文章士海已多传，供奉班中须此贤。\n美化事多难讽诵，自宜松鹤伴长年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15806,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"知府黄寺簿生日 其五","author":"释绍嵩","text":"邦伯由来有令名，修持清苦振佳声。\n至尊仄席思耆旧，即看徵黄侍紫清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15807,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"知府黄寺簿生日 其七","author":"释绍嵩","text":"惠爱如春威似霜，家传活国有良方。\n平章风物诗无敌，玉唾银钩十万行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15808,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"知府黄寺簿生日 其六","author":"释绍嵩","text":"笔端风雨发天悭，应有清名动九关。\n正直早年闻苦节，只今文翰许谁攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15809,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"知府黄寺簿生日 其十","author":"释绍嵩","text":"自笑无机触事真，衰迟犹许望光尘。\n此邦若有诛茆地，乞借风波起涸鳞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15810,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"知府黄寺簿生日 其九","author":"释绍嵩","text":"文星渐见射台星，仙籍高标第一名。\n为语邦人休眷恋，北门卧护要耆英。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15811,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"知府黄寺簿生日 其一","author":"释绍嵩","text":"绿杨红杏满城春，杂树含芳让锦茵。\n天为吾皇宗社计，老君亲送石麒麟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15812,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"知府黄寺簿生日 其四","author":"释绍嵩","text":"器度风标合出尘，高贤应总贵全真。\n野僧何以伸谣咏，鹤算三千别有春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15813,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"知府黄寺簿生日 其八","author":"释绍嵩","text":"从容此日见清规，玉佩琼琚杜拾遗。\n槜李转闻风教好，苍生从此得伸眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15814,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"知府黄寺簿生日 其二","author":"释绍嵩","text":"春来何事谪蓬瀛，自是山河应数生。\n尚父年龄子仪考，请君从此振朝缨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15815,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"郊行 其三","author":"释绍嵩","text":"出门纵步细哦诗，正是山中多景时。\n顾我于兹诗有兴，流莺百啭最高枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15816,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"郊行 其一","author":"释绍嵩","text":"默默看云旋旋行，风光清美日华明。\n愁肠断处春何限，勾引诗人太瘦生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15817,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨后登吸江亭","author":"释绍嵩","text":"吸江亭下雨初晴，中有樵夫跣足行。\n时作微吟清彻骨，兹游无乃太清生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15818,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"城西野行 其二","author":"释绍嵩","text":"细草疏花自在春，悠悠烟水似天津。\n垂杨一径深深去，白鸟双飞不避人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15819,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"城西野行 其一","author":"释绍嵩","text":"三月西城淑景多，晓烟清露暗相和。\n晚钟未用催归客，闻道新亭更可过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15820,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日","author":"释绍嵩","text":"风流尽付小园春，浓麝分香入四邻。\n何事晚来微雨后，山花如绣草如茵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15821,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日郊行 其六","author":"释绍嵩","text":"高竹重林接翠微，夕阳分手柘冈西。\n莫忧世事兼身事，且逐东风进杖藜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15822,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日郊行 其四","author":"释绍嵩","text":"春送人家入画屏，草香沙暖水云晴。\n凝眸不觉斜阳尽，闲恨闲愁触处生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15823,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日郊行 其五","author":"释绍嵩","text":"忽惊春色二分空，满地榆钱逐晓风。\n黄四娘家谁敢道，古来唯有杜陵翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15824,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日郊行 其一","author":"释绍嵩","text":"稠花乱蕊裹江滨，小雨疏疏向晚晴。\n逋客未能忘野兴，春来无处不闲行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15825,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日郊行 其二","author":"释绍嵩","text":"城外春风满酒旗，吟怀长恨负芳时。\n东林夫子知予意，载我而今唱和诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15826,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日郊行 其三","author":"释绍嵩","text":"芳草斜铺翡翠茵，旧游如梦苦伤神。\n寒山带郭穿松路，柳絮梨花寂寂春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15827,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"柳","author":"释绍嵩","text":"江头杨柳曲尘姿，斜压渔家短短篱。\n日暖游丝飞絮落，和风得路合偏吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15828,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"胡伯圆尚书以松山虚席力招补其阙辄辞以小诗遂获免","author":"释绍嵩","text":"懒性如今成野人，苍颜白发不时新。\n自知潦倒无馀事，乞取山林放旷身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15829,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贺黄少府受辟 其一","author":"释绍嵩","text":"天下无双双井黄，妙龄联辔战文场。\n东南一尉臞仙外，请试君家肘后方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15830,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贺黄少府受辟 其三","author":"释绍嵩","text":"一鹗新收荐士书，从今价重百车渠。\n麒麟步舞开天上，会见含香近紫虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15831,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"桐庐理舟","author":"释绍嵩","text":"桐庐江上晚潮生，帆挂秋风一信程。\n万里归船弄长笛，断肠重看白鸥盟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15832,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"桐庐道中","author":"释绍嵩","text":"钱塘江上到桐庐，一带溪山画不如。\n对景由来诗句丽，夕阳无语淡烟初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15833,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浩西堂见和因再用韵 其八","author":"释绍嵩","text":"道方时险拟如何，今古疏愚似我多。\n否去泰来终可待，尚须客里访蹉跎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15834,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浩西堂见和因再用韵 其七","author":"释绍嵩","text":"笑杀人来断杀肠，可怜赢得鬓成霜。\n人情易变乃如此，祇有江山不改常。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15835,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浩西堂见和因再用韵 其五","author":"释绍嵩","text":"每惭疏散为吟诗，说破当知未大奇。\n似此误人多少事，如何两鬓不成丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15836,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浩西堂见和因再用韵 其十","author":"释绍嵩","text":"沙边鸥鹭日相亲，老去光阴非我春。\n百巧从来知是妄，独援诗笔得天真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15837,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浩西堂见和因再用韵 其二","author":"释绍嵩","text":"老景人情一羽轻，绊身何用尚浮名。\n备尝世事灰心久，更问侬当作么生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15838,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浩西堂见和因再用韵 其四","author":"释绍嵩","text":"镜中老色日侵寻，更有江湖万里心。\n心许故人知此意，为吾因掉白头吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15839,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浩西堂见和因再用韵 其三","author":"释绍嵩","text":"萧条四壁是闲居，老子而今非故鱼。\n大抵人生只如此，只消如此看何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15840,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浩西堂见和因再用韵 其六","author":"释绍嵩","text":"行尽天涯西复东，大家闲作卧云翁。\n纷纷燕雀休相羡，得丧悲欢尽是空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15841,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浩西堂见和因再用韵 其九","author":"释绍嵩","text":"小园和雨扫莓苔，个个圆如济世财。\n丘壑同盟从已定，莫谈休咎动寒灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15842,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浩西堂见和因再用韵 其一","author":"释绍嵩","text":"无钱使鬼故宜休，已失装怀万斛愁。\n况有西湖好山水，一帆还自上归舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15843,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"钱清登舟","author":"释绍嵩","text":"日落相携上小舟，客程难尽水空流。\n潇潇细雨蓬初闭，万里一帆随白鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15844,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿山居","author":"释绍嵩","text":"中庭淡月照三更，环堵翛然表里清。\n深夜欲眠眠未得，一溪秋水枕边声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15845,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿天童","author":"释绍嵩","text":"太白山头月欲低，鹊栖不稳绕枝飞。\n坐来客子浑忘倦，却听松声联翠微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15846,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿绍兴","author":"释绍嵩","text":"小舟夜宿越州城，卧看星河尽意明。\n漏鼓乍听连岸响，好风佳月总同盟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15847,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿疏山","author":"释绍嵩","text":"竹舆穿雨上疏山，寒涕垂颐独掩关。\n病客欲眠浑不寐，白猿啼在白云间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15848,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"野眺 其二","author":"释绍嵩","text":"柳绕平湖绿映堤，堤边柳色更相宜。\n风来众绿一时动，不为愁人住少时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15849,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"野眺 其一","author":"释绍嵩","text":"道是东风不世情，树头吹得叶冥冥。\n凭栏一笑斜阳里，贪看春山如许青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15850,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪中舟泊五夫","author":"释绍嵩","text":"天遣今年到五夫，琼田千里玉平铺。\n波中船舫来还去，载取烟云作画图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15851,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"散策 其二","author":"释绍嵩","text":"江上云亭霁景鲜，画屏展尽一山川。\n迟迟欲去犹回首，目尽孤烟白鸟边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15852,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"散策 其一","author":"释绍嵩","text":"杨柳斜牵一岸风，驿楼高倚夕阳东。\n无穷涧草纵横绿，入我香奁境界中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15853,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登盘陀石","author":"释绍嵩","text":"盘陀石上少从容，秋色偏宜晚望中。\n欲赋胜游无杰句，独搔蓬鬓立西风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15854,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"越上即事","author":"释绍嵩","text":"禹穴生云朝暮奇，青山断处夕阳垂。\n莺声政好还飞去，独倚枯筇无限时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15855,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"道中即事","author":"释绍嵩","text":"南浦东冈二月时，迸流穿树堕花随。\n春风掩映千门柳，多少长条拂地垂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15856,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"解嘲十绝呈浩西堂 其一","author":"释绍嵩","text":"残骸已废自知休，少不愁穷老岂愁。\n坎止流行聊尔耳，一身随世作虚舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15857,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"解嘲十绝呈浩西堂 其八","author":"释绍嵩","text":"不知经世竟如何，转看人情败意多。\n赖有好山供客眼，此生吾亦未蹉跎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15858,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"解嘲十绝呈浩西堂 其四","author":"释绍嵩","text":"可堪时序苦侵寻，留滞谁知此日心。\n万事转头如堕甑，忘怀未得是微吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15859,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"解嘲十绝呈浩西堂 其五","author":"释绍嵩","text":"中年养病只吟诗，心迹悬知两崛奇。\n莫笑吾侬耽此癖，镜中赢得鬓成丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15860,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"解嘲十绝呈浩西堂 其七","author":"释绍嵩","text":"?巇世路九回肠，两鬓年深一镜霜。\n身事龙钟应是分，谁知贫乐异寻常。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15861,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"解嘲十绝呈浩西堂 其九","author":"释绍嵩","text":"杜门芳草与苍苔，况是囊无挑药财。\n莫汉劳生三十九，人间万事要寒灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15862,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"解嘲十绝呈浩西堂 其二","author":"释绍嵩","text":"世缘自觉逐时轻，可要王侯知姓名。\n未合白头今已白，知渠何事太忙生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15863,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"解嘲十绝呈浩西堂 其十","author":"释绍嵩","text":"平居懒与慢相亲，养拙藏愚春复春。\n已信此心安此命，世情奈值不容真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15864,"sha256":"ed4f9