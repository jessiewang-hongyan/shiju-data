[{"title":"偈颂三十六首 其二十八","author":"释如珙","text":"粪堆头上，无人觑著。\n万法纷纭，自起自灭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11606,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十六首 其二十四","author":"释如珙","text":"施供养者，受供养者。\n俱无住著，获波罗蜜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11607,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十六首 其十六","author":"释如珙","text":"拈槌竖拂，好肉剜疮。\n举今举古，开眼尿床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11608,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人画师像请赞 其四","author":"释如珙","text":"持刀杀人，人心不死。\n赤手杀人，人心不死。\n伎俩俱尽，人心自死。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11609,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人画师像请赞 其八","author":"释如珙","text":"道远乎哉，触事而真。\n罗公照镜，李婆映水。\n鼻孔各别，娘生一般。\n会与不会，福州使铁钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11610,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"拄杖歌","author":"释如珙","text":"老龙蜕骨空山，樵人惠我作杖。\n靠在绳床角头，团团围绕万象。\n打狗打雨敲风，总是颠倒妄想。\n有人拗作两橛，伏惟方外尚飨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11611,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十五首 其二十九","author":"释如珙","text":"蝼蚁皆有佛性，为甚狗子却无。\n赵州观音院里，壁上挂个胡芦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11612,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十五首 其二","author":"释如珙","text":"是定出得不得，关捩初无多子。\n文殊神通太过，罔明轻轻弹指。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11613,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十六首 其七","author":"释如珙","text":"尽大地冷啾啾，逼十方闹浩浩。\n放过布袋和尚，穿却解空鼻孔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11614,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人画师像请赞 其五","author":"释如珙","text":"一喝从马师起，临济承虚接响。\n病叟本无气力，不能学这般承。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11615,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人画师像请赞 其三","author":"释如珙","text":"黄檗不是临济，争打六十拄杖。\n较之七佛已前，都无许多劳攘。\n即是吾真种草，何须特地写像。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11616,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅月大师画罗汉像赞","author":"释如珙","text":"禅月罗汉应身，画出罗汉形像。\n丝毫无得渗漏，虚空捏作一团。\n拈来挂虚空中，咄咄咄咄咄咄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11617,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"辞住持偈","author":"释如庵主","text":"三十年来住此山，郡符何事到林间。\n休将琐琐尘寰事，换我一生闲又闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11618,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五首 其五","author":"释如琰","text":"赵州老汉热心肠，一盏粗茶验当行。\n回首路傍桥断处，白蘋红蓼映斜阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11619,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五首 其四","author":"释如琰","text":"夹峤当年错用心，贪他香饵被他擒。\n点头三下无言说，水阔山遥恨转深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11620,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五首 其二","author":"释如琰","text":"问处分明答处端，还同双剑倚天寒。\n一从楼阁门开后，满面惭惶无处安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11621,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五首 其三","author":"释如琰","text":"蹉过跨门一机，昧却见成公案。\n子湖指处太亲，直须急著眼看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11622,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东皋弹琴","author":"释逊","text":"落叶秋满庭，夜深月临沼。\n独坐弹素琴，知音有鱼鸟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11623,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上集贤钱侍郎","author":"释宇昭","text":"解职因求养，清名冠集贤。\n优游书府里，谈笑板舆前。\n鹤氅朝时脱，山图卧处悬。\n江僧闲独访，时得话林泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11624,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夕阳","author":"释宇昭","text":"向夕江天迥，微微接水平。\n带帆归极浦，随客上荒城。\n云外僧看落，山西鸟过明。\n何人对幽景，苒苒败沙并。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11625,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"废井","author":"释宇昭","text":"古院无僧住，荒凉树石间。\n停污寒甃缺，废汲远泉悭。\n雨涨蛙疑聚，宵晴月自还。\n因寻成独感，吟绕见衰颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11626,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"幽居即事","author":"释宇昭","text":"扫苔人迹外，渐老喜深藏。\n路僻闲行远，春晴昼睡长。\n馀花留暮蝶，幽草恋残阳。\n尽日空林下，孤禅念石霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11627,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送从律师","author":"释宇昭","text":"病起辞吟社，出京无旧房。\n关中行半月，诗外祇空囊。\n白道沿嵩直，青芜夹渭长。\n胜游多杜曲，风景似吾乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11628,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送曹商之宿州兼简骆偃","author":"释宇昭","text":"病起春城暮，行心暗结愁。\n全吴无旧业，半世祇羁游。\n岛雾沈晴树，汀烟入夜舟。\n故人应老大，佐幕久淹流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11629,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿丁学士宅朱严希昼不至","author":"释宇昭","text":"幽期不可见，牢落望君情。\n坐久诗源寂，谈馀井浪平。\n月依寒木尽，蛩背冷灯鸣。\n空听沟西寺，宵钟出禁清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11630,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄保暹师","author":"释宇昭","text":"吟会失秋期，荒山寄病时。\n客髭生白早，丛木落青迟。\n渴狖窥莎井，阴虫占菊篱。\n归心何以见，霜月下天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11631,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"喜惟凤师关中回","author":"释宇昭","text":"孤锡依京侍，诗愁上鬓新。\n迹离三辅晚，梦落九江频。\n草入松根井，磬通花外邻。\n重来知未倦，闲趣自相亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11632,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"塞上赠王太尉","author":"释宇昭","text":"嫖姚立大勋，万里绝妖氛。\n马放降来地，雕闲战后云。\n月侵孤垒没，烧彻远芜分。\n不惯为边客，宵笳懒欲闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11633,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠魏野","author":"释宇昭","text":"别业唯栽竹，多闲亦好奇。\n试泉寻寺远，买鹤到家迟。\n药就全离母，诗高祇教儿。\n未能终住此，共有海山期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11634,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"松柄","author":"释宇昭","text":"涧底分贞干，宁将麈尾同。\n坐闲长滴翠，话次忽生风。\n影落孤灯外，声寒静室中。\n有谁知此意，林下石丛丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11635,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"台山婆话颂","author":"释守仁","text":"开个灯心皂角铺，日求升合度朝昏。\n只因风雨连绵久，本利一空愁倚门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11636,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古","author":"释守仁","text":"多方窃得破衣裳，壁倒篱坍没处藏。\n更有一般无赖汉，不曾同伴要分赃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11637,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五首 其五","author":"释守仁","text":"凉宵爱月上危楼，几处笙歌几处愁。\n歌管未阑愁未歇，忽然天晓一时休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11638,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五首 其三","author":"释守仁","text":"相逢陪酒又陪歌，醉倒家中要我驼。\n驼到家中犹骂詈，不知醒后又如何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11639,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五首 其二","author":"释守仁","text":"气直语直，眼亲手亲。\n峰峦竞秀，红紫争春。\n神通妙用施呈尽，要见国师犹隔津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11640,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五首 其一","author":"释守仁","text":"如舍利弗与么去，千人万人拦不住。\n优游自在涅槃城，步步莲华随足举。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11641,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二首 其二","author":"释守仁","text":"云从龙，风从虎，吹散江村寒露雨。\n丽天杲日绝纤埃，有路明明吞佛祖。\n物见主，眼卓竖。\n天边白雁送寒归，篱下黄华香半吐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11642,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二首 其一","author":"释守仁","text":"百千三昧，无量妙门。\n今日日庵不惜穷性命，只做一句子说与诸人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11643,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五首 其四","author":"释守仁","text":"锯解秤锤，油煎石磉。\n两手擎来，有功者赏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11644,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂","author":"释守芝","text":"北斗挂须弥，杖头挑日月。\n林泉好商量，夏末秋风切。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11645,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈 其三","author":"释守芝","text":"翠岩路崄巇，举步涉千溪。\n更有洪源水，滔滔在岭西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11646,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈 其四","author":"释守芝","text":"沙里无油事可哀，翠岩嚼饭喂婴孩。\n他时好恶知端的，始觉从前满面埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11647,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈 其二","author":"释守芝","text":"大愚相接大雄孙，五湖云水竞头奔。\n竞头奔，有何门，击箭宁知枯木存。\n枯木存，一年还曾两度春。\n两度春，帐里真珠撒与人。\n撒与人，思量也是慕西秦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11648,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈 其一","author":"释守芝","text":"一击响玲珑，喧轰宇宙通。\n知音才侧耳，项羽过江东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11649,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四首 其四","author":"释守净","text":"涅槃偿债更无殊，劈破长沙肘后符。\n一句全提无话会，钱塘八月浪花粗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11650,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四首 其三","author":"释守净","text":"不知此土何为验，拈起新罗人草鞋。\n汉祖殿前樊哙怒，鸿门一踏为谁开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11651,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四首 其二","author":"释守净","text":"普请开田力已齐，纷纷带水又拖泥。\n展开两手人休问，昨夜三更月落西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11652,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四首 其一","author":"释守净","text":"析尽尸骸没一些，从兹遍界是那吒。\n直饶见得无纤翳，未免重添眼里花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11653,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二十七首 其二十七","author":"释守净","text":"梦幻空花六十七，临行犹自老婆心。\n鸳鸯绣出与人看，谁知元不犯金针。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11654,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二十七首 其二十一","author":"释守净","text":"三十六旬穷此夕，定盘星上转风车。\n放开结角罗纹处，须信风流出当家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11655,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二十七首 其二十","author":"释守净","text":"日日波波走，夜夜不曾停。\n走到岁穷夜，依旧定盘星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11656,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二十七首 其十四","author":"释守净","text":"念念舍离诸恶趣，心心克取佛菩提。\n取舍二途如脱得，永嘉元不识曹溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11657,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二十七首 其四","author":"释守净","text":"堂前露柱久怀胎，长下婴儿颇俊哉。\n未解语言先作赋，一操直取状元来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11658,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二十七首 其三","author":"释守净","text":"传来铁钵盛猫饭，摩衲袈裟入墨盆。\n祖翁活计都坏了，不知将底付儿孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11659,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二十七首 其八","author":"释守净","text":"定光金地遥招手，智者江陵暗点头。\n已是白头千万里，那堪于此未知休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11660,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈三首 其三","author":"释守净","text":"若欲正提纲，直须大地荒。\n欲来冲雪刃，未免露锋铓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11661,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"调空首座","author":"释守净","text":"山龟有壳藏头尾，七十二钻不奈何。\n恰似秀峰空首座，嘉招不肯出烟萝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11662,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古","author":"释守净","text":"比谓拈来伸一问，如何举众尽茫然。\n不因一扑百杂碎，定作人间丑妇冤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11663,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈一首","author":"释守净","text":"闭却口，时时说。\n截却舌，无间歇。\n无间歇，最奇绝。\n最奇绝，眼中屑。\n了了了时无可了，玄玄玄处亦须呵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11664,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二十七首 其二十五","author":"释守净","text":"一叶落，便知秋，颟顸佛性。\n一尘起，大地收，儱侗真如。\n若是衲僧门下客，不用更踌躇。\n曾向华山图上看，又添潘阆倒骑驴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11665,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二十七首 其二十三","author":"释守净","text":"常州有，福州无，江风作恶浪花粗。\n不用刻舟徒记剑，片帆已过洞庭湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11666,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二十七首 其二十二","author":"释守净","text":"我有懒庵兄，夤缘真有在。\n从东复过西，两处成交代。\n去矣无遗恨，所欠唯睡债。\n难忘手足情，特来为渠赛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11667,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二十七首 其十八","author":"释守净","text":"今朝十二，鼓声动地。\n云水上来，讨甚巴鼻。\n直饶天雨四花，争似归堂打睡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11668,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二十七首 其十七","author":"释守净","text":"我有折脚铛，三子共提掇。\n一著一著高，一步一步阔。\n从此活业兴，清风动寥泬。\n夜半放乌鸡，头上一点雪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11669,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二十七首 其十六","author":"释守净","text":"流水下山非有意，片云归洞本无心。\n人生若得如云水，铁树开花遍界春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11670,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二十七首 其十五","author":"释守净","text":"佛祖顶?上，有破天大路。\n未透生死关，如何敢进步。\n不进步，大千没遮护。\n一句绝言诠，那吒擎铁柱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11671,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二十七首 其十三","author":"释守净","text":"瞿昙鼓动三寸舌，四十九年无法说。\n达磨不立一字脚，列派分枝无处著。\n青山不锁长飞势，沧海合知来处高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11672,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二十七首 其十","author":"释守净","text":"石门深且幽，好住不肯住。\n翻身入城隍，却向闹市去。\n闹浩浩处冷湫湫，冷湫湫处看扬州。\n四五百条花柳巷，二三千处管弦楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11673,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二十七首 其八","author":"释守净","text":"正炊折脚铛安隐，无奈公文抵死催。\n硬把死蛇头不得，随时之义大矣哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11674,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二十七首 其六","author":"释守净","text":"一念得心，顿超三界。\n得无所得，贪瞋烂坏。\n野草閒花满地愁，将军战马今何在。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11675,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二十七首 其五","author":"释守净","text":"文殊普贤谈理事，临济德山行棒喝。\n东禅一觉到天明，偏爱风从凉处发。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11676,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈三首 其二","author":"释守净","text":"今朝腊月九，穷汉外边走。\n虽然不还家，却是他好手。\n陋巷不骑金色马，回途却著破襕衫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11677,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二十七首 其二十六","author":"释守净","text":"梦幻空花，六十七年。\n白鸟烟没，秋水连天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11678,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二十七首 其十一","author":"释守净","text":"慧不厌修，福不厌作。\n福慧双收，如虎戴角。\n作既无作，修亦无修。\n青山绿水，短棹孤舟。\n格外之谈，迥出常流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11679,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二十七首 其二","author":"释守净","text":"谈玄说妙，撒屎撒尿。\n行棒行喝，将盐止渴。\n立主立宾，花擘宗乘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11680,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二十七首 其十九","author":"释守净","text":"达磨不来东土，二祖不往西天。\n老卢不识五祖，谁云夜半衣传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11681,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]