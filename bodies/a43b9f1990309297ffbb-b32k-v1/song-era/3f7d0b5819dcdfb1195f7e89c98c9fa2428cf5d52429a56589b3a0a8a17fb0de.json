[{"title":"次韵李通直题慈相寺雪月亭","author":"沈与求","text":"曲槛飞甍界碧空，尽供胜览属禅翁。\n苍藤翠木四围外，远水平芜一望中。\n幽鸟林梢鸣不断，乱云天末去无穷。\n素娥青女今何在，归步聊乘两腋风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14457,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"扈御舟泊钱清江口值雨 其一","author":"沈与求","text":"打窗悉窣连江雨，吹柁呕哑拍岸风。\n篷底醉眼那得隐，时闻鸡唱梦魂中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14458,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"扈御舟泊钱清江口值雨 其二","author":"沈与求","text":"法驾亲巡海上还，钩陈万骑列江干。\n潮生风熟楼船过，雨助洪涛失故滩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14459,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过平望","author":"沈与求","text":"未办扁舟挂绿蓑，人间何处不风波。\n终须径为鲈鱼去，笠钓归寻张志和。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14460,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次吴江 其一","author":"沈与求","text":"水阔风豪浪拍天，鱼龙戏舞堕馋涎。\n寻常行处多翻覆，看我孤舟得隐眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14461,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次吴江 其二","author":"沈与求","text":"小邑萧条兵火馀，狐狸入市自相呼。\n茅墙竹户斜阳里，十室生涯久已无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14462,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"冬至遇雪题明因寺僧房 其一","author":"沈与求","text":"宦学差池已倦游，一犁真欲老西畴。\n天公为作丰年信，更喜将军入蔡州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14463,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"冬至遇雪题明因寺僧房 其二","author":"沈与求","text":"遥想燕山落大花，更堪直北渡龙沙。\n六师挟纩怀轻煖，取日谁能反翠华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14464,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"方允迪隐鸬鹚谷江子我子之刘希颜行简皆往依焉为此诗寄赠","author":"沈与求","text":"脱叶惊飞海角秋，君王虚伫急良筹。\n列仙山泽底无用，孺子沧浪渠不忧。\n百鸷可能如一鹗，二江知复带双流。\n渺然相望暮云碧，兀坐蒲团搔白头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14465,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"八月十七日扁舟渡钱塘江 其一","author":"沈与求","text":"一言初欲寤明君，去矣终缘丞相嗔。\n凫雁江湖真我辈，龙蛇山泽定何人。\n市中未识冯延寿，门外已呼祁孔宾。\n尚有忧时心未歇，西风吹泪湿纶巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14466,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"八月十七日扁舟渡钱塘江 其二","author":"沈与求","text":"沙觜波生柁脚开，扁舟老去许归来。\n风帆一点日边下，雪浪千堆天际回。\n城郭荒芜迷旧隐，江山寂寞写馀哀。\n此心元自无机事，寄语轻鸥莫见猜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14467,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"允迪招行简卜居鸬鹚谷仆意羡之作诗送行兼以自见 其一","author":"沈与求","text":"严陵滩下鸬鹚谷，闻道元英旧隐庐。\n鼻祖名高诗格在，耳孙才杰宦情疏。\n漫山松桂雁行立，入坞茅茨星散居。\n知为刘郎赋招隐，莫教花落到通渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14468,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"允迪招行简卜居鸬鹚谷仆意羡之作诗送行兼以自见 其二","author":"沈与求","text":"少日长怀社稷忧，怪来饶舌漫多仇。\n风尘冉冉百年老，霜雪萧萧两鬓秋。\n不办痴床供一笑，方营隐谷赋三休。\n添丁护得金鸦觜，佳处端能著我不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14469,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"维心过邵子非溪亭夜话有伤时感旧之作索余次韵 其一","author":"沈与求","text":"官仪全复汉，盟会竞尊周。\n郊野多戎垒，衣冠半客游。\n地偏朋旧鲜，人老岁时遒。\n莫厌经过数，相看又麦秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14470,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"维心过邵子非溪亭夜话有伤时感旧之作索余次韵 其二","author":"沈与求","text":"朝廷策数马，寇盗谷量牛。\n世乱思奇画，身闲喜胜流。\n鹓鸾霄汉侣，凫雁稻粱谋。\n得趣皆为达，那能陆荡舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14471,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"维心过邵子非溪亭夜话有伤时感旧之作索余次韵 其三","author":"沈与求","text":"闻道津亭集，青灯夜色浮。\n鹳鸣惊独鹤，鱼伏避群鹙。\n月澹帆归浦，风腥网挂洲。\n语深投匕立，此意得无忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14472,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"维心过邵子非溪亭夜话有伤时感旧之作索余次韵 其四","author":"沈与求","text":"虏帐师频衄，民穷粟屡搜。\n会须夷丧乱，宁敢厌征求。\n黄屋中天立，彤弓几日酬。\n寸心终耿耿，不独为春愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14473,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"维心过邵子非溪亭夜话有伤时感旧之作索余次韵 其五","author":"沈与求","text":"心事空牢落，身名盍罢休。\n得闲羞彊聒，避谤巧淹留。\n老矣嗟如此，谁欤问以不。\n傥容亲杖履，不拟向丹丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14474,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"刘希颜持节按县招维心舟中小酌次维心韵 其一","author":"沈与求","text":"大艑浮溪曲，华旌映道周。\n劳农才彻警，问俗偶成游。\n王事今云棘，官称古号遒。\n正须哀疾苦，辄莫诧防秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14475,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"刘希颜持节按县招维心舟中小酌次维心韵 其二","author":"沈与求","text":"随处喧铜马，何人炫木牛。\n轻捐小山句，急捍大江流。\n行迈心疑醉，周爰事喜谋。\n招呼隐君子，高浪兀虚舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14476,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"刘希颜持节按县招维心舟中小酌次维心韵 其三","author":"沈与求","text":"故国真如寄，馀生宛若浮。\n巢鸠不护鹊，池凤肯容鹙。\n老木低春水，孤花带晚洲。\n杯行应酹我，知复念幽忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14477,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"刘希颜持节按县招维心舟中小酌次维心韵 其四","author":"沈与求","text":"山林怀独往，图史纵旁搜。\n此士俗间忌，吾侪句里求。\n大篇终寡和，小酌漫相酬。\n脚踏溪流乱，端能醒客愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14478,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"刘希颜持节按县招维心舟中小酌次维心韵 其五","author":"沈与求","text":"大邦通间道，小县得中休。\n交分伤离合，王程惜去留。\n索居垂老矣，剧饮尚能不。\n倦夜评今古，谁怜貉一丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14479,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"子虚航重湖之险远过山中辄次维心韵以谢 其一","author":"沈与求","text":"客里伤为别，相望岁一周。\n冕旒存异顾，丘壑老英游。\n忧国心长折，惊人语太遒。\n年来有公事，合眼注春秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14480,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"子虚航重湖之险远过山中辄次维心韵以谢 其二","author":"沈与求","text":"小窗眼蠍虎，败壁上蜗牛。\n老树阴垂合，前山翠欲流。\n狂言违世用，彊饭了身谋。\n不谓轻千里，能迂访戴舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14481,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"子虚航重湖之险远过山中辄次维心韵以谢 其三","author":"沈与求","text":"此客今那有，迎门喜气浮。\n心闲清似鹄，眼净凛如鹙。\n尘榻开蓬室，风帆卷橘洲。\n襟期适相契，一笑发群忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14482,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"子虚航重湖之险远过山中辄次维心韵以谢 其四","author":"沈与求","text":"宝历方重启，英才必尽搜。\n题舆偶淹泊，榜道会营求。\n浪漫贫逾适，经纶老未酬。\n云林得携手，切勿志穷愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14483,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"子虚航重湖之险远过山中辄次维心韵以谢 其五","author":"沈与求","text":"暮云凝远碧，觅句拟汤休。\n不分千山隔，才为十日留。\n高风谁继者，清梦自惊不。\n闻说星躔动，何人识太丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14484,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵学士兄见一亭 其一","author":"沈与求","text":"自称居士拟香山，只影江湖得暂闲。\n大隐可能追褦襶，小亭聊欲对孱颜。\n持杯有月同歌舞，策杖无人共往还。\n闻道修篁解新箨，密遮门径不须删。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14485,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵学士兄见一亭 其二","author":"沈与求","text":"尘土败名如败敌，云山招隐似招降。\n漫倾鲁酒醒犹独，聊发吴讴调本双。\n谁念佳人在空谷，自同渔父老清江。\n它年对榻分馀地，风雨萧萧夜打窗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14486,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵学士兄述怀 其一","author":"沈与求","text":"故国风烟素已谙，结茅端欲占重岚。\n聚蚊那肯追金谷，号虎真成赋石龛。\n阨运经过度阳九，幻生颠倒识朝三。\n它年自有鸡豚约，小阮新居卜道南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14487,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵学士兄述怀 其二","author":"沈与求","text":"葱麦推还井大春，拂衣归伴卧云人。\n胸中历历蟠三略，肘后时时校六淳。\n已作移文排俗士，更将要术混齐民。\n知闲聊复求闲地，岁晚功名恐逼身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14488,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵黄子虚所居随缘堂","author":"沈与求","text":"应羡扁舟泛五湖，随缘卜筑伴樵苏。\n青山衮衮成嘉遁，华发萧萧负壮图。\n松桧鶱腾元自植，鱼龙吟啸巧相娱。\n清宵背立岩前月，大叫三高更疾呼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14489,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次律兄饷鱼鱼不至而诗至颇类南海使君送酒辄成三绝一笑而已赐茗少分以报厚意 其一","author":"沈与求","text":"凭虚公子骑鲸后，乌有先生控鲤初。\n可是凡鱼亦仙去，空馀一纸腹中书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14490,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次律兄饷鱼鱼不至而诗至颇类南海使君送酒辄成三绝一笑而已赐茗少分以报厚意 其二","author":"沈与求","text":"先生远饷锦鳞鲜，剥啄扣门惊阿连。\n只有珠玑落窗几，空教口角堕馋涎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14491,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次律兄饷鱼鱼不至而诗至颇类南海使君送酒辄成三绝一笑而已赐茗少分以报厚意 其三","author":"沈与求","text":"尚方小凤睗精芽，戏比琼瑶报木瓜。\n梦境纷纷非实相，往烦钩起睡中蛇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14492,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"晓过邻村","author":"沈与求","text":"推枕梦初断，篮舆踏露行。\n岁登人意乐，风急雁行惊。\n曲涧哀湍泻，危桥独木横。\n清霜莫欺客，云日自晶明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14493,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"即事 其一","author":"沈与求","text":"鹊噪空庭晓，霜明百尺楼。\n连耞响晴日，遗穗落平畴。\n黄菊疏篱晚，丹枫别岸秋。\n怡情有底计，开瓮玉蛆浮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14494,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"即事 其二","author":"沈与求","text":"竹树参差合，溪流半隐扉。\n雨昏鸠妇闹，风急雁奴归。\n策杖循沙步，褰裳到石矶。\n游鱼吾共乐，身世自依违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14495,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过梅知宫东轩","author":"沈与求","text":"舍南舍北花无数，眼看游蜂上下狂。\n风信晚来帘额动，黄庭相对一炉香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14496,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"允迪遣书问讯并寄示与子我唱酬佳句猥及微踪辄用庐字韵为二诗以报嘉惠 其一","author":"沈与求","text":"泛爱何人枉素书，银钩奕奕到田庐。\n朋游久许贫方耐，宦学空怜老更疏。\n回雁峰前应梦到，放龟池上也斋居。\n相期保社同香火，口祷功名乞与渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14497,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"允迪遣书问讯并寄示与子我唱酬佳句猥及微踪辄用庐字韵为二诗以报嘉惠 其二","author":"沈与求","text":"不从吏议污丹书，恩许怀章返故庐。\n投老有缘知分溢，排奸无术愧才疏。\n胜流踊跃闻归棹，妙语吹嘘慰索居。\n怀望北辕心已折，忍将时事付轩渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14498,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书怀三首 其一","author":"沈与求","text":"应俗由来懒，谋身尚敢先。\n栖栖从见嫉，仆仆岂能贤。\n骏马常追日，方舟可济川。\n人生各有趣，心目慎相怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14499,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书怀三首 其二","author":"沈与求","text":"暗中人易记，名下士非虚。\n此道凭谁办，它时或自如。\n真能食万户，定复愧三闾。\n富贵虽吾有，当令功可书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14500,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书怀三首 其三","author":"沈与求","text":"事业贵不苟，声名难预期。\n功非宜食肉，道岂忘羹藜。\n政恐仪无舌，那论纬有髭。\n汉庭今用少，览镜独何为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14501,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"刘希颜提举见过出示卞山居二诗次其韵 其一","author":"沈与求","text":"偪仄风尘际，分携岁月赊。\n向来闻避地，胜处偶为家。\n对客谈锋锐，忧时酒量加。\n中觞莫辞醉，回首又天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14502,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"刘希颜提举见过出示卞山居二诗次其韵 其二","author":"沈与求","text":"小别千山隔，相看一笑温。\n丹心猎风旆，华发粲霜根。\n鸭鸭争呼伴，鸦鸦自识村。\n更须判剧饮，落月倒洼尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14503,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"张仲宗有诗怀归因次其韵勉之","author":"沈与求","text":"相逢无日不怀归，又是春山听子规。\n休叹豺狼迷道路，似闻貔虎仆旌旗。\n那从薄俗求青眼，还向高堂念白眉。\n南望孤云应目断，殊方岁月易推移。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14504,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"南北山探梅俱未花维心从家圃折数枝以饷坐客盖半开矣会次律兄有诗辄次韵","author":"沈与求","text":"山北山南雪意忙，梅花未肯斗寒芳。\n悬知小圃争前发，为折疏枝分外香。\n故国年华惊晼晚，老人心事伴摧藏。\n更看陌上传春信，倚杖空怀迟暮伤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14505,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵郑维心探梅未花 其一","author":"沈与求","text":"木落空山不著行，寒梅长是占年芳。\n未容霜女窥孤艳，定恐花神啬旧香。\n竹杖穿林聊问讯，槿篱萦路巧遮藏。\n谁能折寄江南恨，北客相看总可伤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14506,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵郑维心探梅未花 其二","author":"沈与求","text":"闻道年时醉一觞，野梅飘几荐馀芳。\n兵尘不碍含生意，花骨犹存底死香。\n入夜从教月浮动，争春空被雪埋藏。\n凭君妙句先催发，调护高枝莫中伤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14507,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"复次韵呈维心拙涩不工当为抵掌 其一","author":"沈与求","text":"岐亭幽梦堕微茫，百草先春自不芳。\n山雨压低临涧影，天风吹下满林香。\n梨花少韵非俦匹，竹叶多情故敛藏。\n长记江桥闲立马，落英谁扫重情伤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14508,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"复次韵呈维心拙涩不工当为抵掌 其二","author":"沈与求","text":"粲粲疏梅短短墙，骚人长恨失遗芳。\n低徊草棘精神透，彷佛关山魂梦香。\n月淡乍看清影乱，春深终恐绿阴藏。\n岁寒为尔添愁绝，倚树微吟亦自伤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14509,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵维心忆梅","author":"沈与求","text":"野花飘尽江梅发，为报先春一信芳。\n近水疏林风格老，故山归路梦魂香。\n雪霜贸贸添愁绝，蜂蝶纷纷预屏藏。\n折寄凭君呼健步，生枝莫放手痕伤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14510,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵行简怀次律兄","author":"沈与求","text":"门对青山水缭墙，隔畦花卉尽流芳。\n浇胸快泻鹅儿酒，袭鼻长闻柏子香。\n夜雨对床成契阔，晚云归岫识行藏。\n抽身未试平戎略，空为忧时倍感伤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14511,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"邵子非谓予有天台之行见贻以诗次其韵","author":"沈与求","text":"巉巉老气郁青霞，过我依然醉帽斜。\n为说惊魂招楚些，忍闻悲曲动胡笳。\n扁舟犯雪来何许，健笔凌云语益嘉。\n莫笑海山风引去，要寻源上问桃花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14512,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵刘希颜蜡梅二绝 其一","author":"沈与求","text":"仙衣曳紫练裙黄，天遣清臞胜国香。\n月上小窗寒影动，不禁风味恼刚肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14513,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵刘希颜蜡梅二绝 其二","author":"沈与求","text":"剪成香蜜缀疏枝，度腊争春已恨迟。\n清夜无人花睡去，小园风露更相宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14514,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵雪","author":"沈与求","text":"紫箫吹断玉梅魂，梦入江南几处村。\n半夜落英飞不定，旋添清绝到柴门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14515,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"月下独步","author":"沈与求","text":"娟娟微月小庭西，月下幽人影自随。\n赖有寒梅伴愁绝，一枝清艳耿疏篱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14516,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵次律兄除夜述怀 其一","author":"沈与求","text":"此身传马与时移，过尽三馀又一归。\n野炬占风迷夜色，村肴宿岁待晨晞。\n鬓华老去能馀几，心赏春来转觉非。\n惭愧君恩许闲佚，食蔬那比首阳薇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14517,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵次律兄除夜述怀 其二","author":"沈与求","text":"饯岁邻翁席屡移，拍歌犹听夜深归。\n尊浮冻蚁霜逾重，林噪寒鸦日未晞。\n剩叹飞腾怜杜老，过为孤愤陋韩非。\n干戈满眼伤时节，遣戍长闻赋采薇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14518,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次律兄以芦菔见饷并有诗次其韵","author":"沈与求","text":"岁晚嘉蔬已向萎，独馀芦菔老霜畦。\n收随芧栗供山谷，赠比蘋蘩撷涧溪。\n菹乱金钗入珍馔，羹融玉糁脱污泥。\n程春定觉人彊饭，功校蹲鸱自不齐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14519,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次律兄以鼠盗防风感而作诗命某同赋","author":"沈与求","text":"嘉蔬灵卉两纷纷，小摘山花自出群。\n芽茁短根红玉卷，叶敷疏节翠旟分。\n细看药谱镌遗录，终拟骚经补缺文。\n堪笑饥鼯穿败箧，宁知野彘力跑云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14520,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戏酬尝草茶","author":"沈与求","text":"惯看留客费瓜茶，政羡多藏不示夸。\n要使睡魔能偃草，肯惭欢伯解迷花。\n一旗但觉烹殊品，双凤何须觅瑞芽。\n待摘家山供茗饮，与君盟约去骄奢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14521,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]