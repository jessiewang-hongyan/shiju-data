[{"title":"虎暴二首 其二","author":"刘克庄","text":"噬至饱而止，出为饥所驱。\n东邻栈失羖，西舍厩亡驹。\n浪说裴旻射，难施抱朴符。\n雌雄已堪畏，况挟小于菟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31678,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"虎暴二首 其一","author":"刘克庄","text":"趫捷超山径，咆哮啖土墙。\n昔无当道卧，今有税人场。\n班特归栏早，韩卢入窦忙。\n四方多伏弩，未可恃雄强。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31679,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"表弟方时父寄荔子名草堂红若欲与吾家玉堂红争名者次韵谢之","author":"刘克庄","text":"忽有尺书来委巷，断无半颗奉权门。\n且为锦荔支联句，不记金莲烛代言。\n颇羡綵毫摛老作，未应丹实减初元。\n明年倍熟平分吃，畅杀兹溪与后村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31680,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"试笔二首 其二","author":"刘克庄","text":"老子归来作么生，扫空诸有觉身轻。\n触蛮大战两蜗角，甫白相酬二鸟鸣。\n煨芋僧高曾约话，负苓者黠不传名。\n世间无过村田乐，莫怪庞公懒入城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31681,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"试笔二首 其一","author":"刘克庄","text":"商山昔有卑辞召，傅野今无审象求。\n世态众狙更喜怒，市声百鸟各喧啾。\n力耕且趁农东作，懒出难陪知北游。\n九万里天浑是月，夜深无伴独登楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31682,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诗境楼观月","author":"刘克庄","text":"人世应无第二楼，暮云飞不到帘钩。\n未开宝鉴青冥里，先涌冰轮碧海头。\n白似雪涛翻赤壁，壮如夜日出罗浮。\n酒醒何处吹横玉，径欲乘风万里游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31683,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诘旦思之世岂有不押之韵辄和北山十首 其十 龟","author":"刘克庄","text":"未必灵于己，徒令厌我龟。\n元君虚见梦，太卜不能知。\n偶活因涂尾，宁饥勿朵颐。\n会携渠与鹤，海上访安期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31684,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诘旦思之世岂有不押之韵辄和北山十首 其九 蝉","author":"刘克庄","text":"所谓善鸣者，泠然入耳清。\n为谁弦雅奏，举世赏繁声。\n露可充渠腹，泉堪濯我缨。\n直令抱枝槁，终不肯蝇营。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31685,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诘旦思之世岂有不押之韵辄和北山十首 其八 萤","author":"刘克庄","text":"忽忽聚还散，荧荧暗复明。\n去嫌灭烛秽，来照读书清。\n不必烦罗扇，何妨屏铁檠。\n蚌珠大如月，不及尔身轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31686,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诘旦思之世岂有不押之韵辄和北山十首 其七 蜂","author":"刘克庄","text":"出穴营新邑，分房定嗣君。\n共为绵蕝礼，各效采花勤。\n暮返宜修夕，晨趋每辨昕。\n逢人施毒虿，宁比细腰云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31687,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诘旦思之世岂有不押之韵辄和北山十首 其六 蚕","author":"刘克庄","text":"姑妇晨妆废，其他务未遑。\n愁逢桑叶贵，贫共织灯光。\n战士支衣众，宫嫔剪綵忙。\n可怜功最大，不待华清汤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31688,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诘旦思之世岂有不押之韵辄和北山十首 其五 蛙","author":"刘克庄","text":"嘈杂乘阴雨，跳梁占废池。\n张唇谁不厌，磔腹帝宁私。\n足踏银床险，身蒙锦袄痴。\n世方多吻士，吾有感于斯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31689,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诘旦思之世岂有不押之韵辄和北山十首 其四 蜚","author":"刘克庄","text":"闽人尤惜荔，鲁史首书灾。\n秽德非常臭，鲜装若自媒。\n今年暂枵腹，来世勿投胎。\n安得清风扫，何忧绛实隤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31690,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诘旦思之世岂有不押之韵辄和北山十首 其三 蚋","author":"刘克庄","text":"绝喜有肉汉，何嫌逐臭夫。\n形悭一粒粟，口遍四方糊。\n鲁叟袗絺绤，荆卿袖匕图。\n朝来询酒瓮，莫已变酸无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31691,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诘旦思之世岂有不押之韵辄和北山十首 其二 蝇","author":"刘克庄","text":"了不分芳臭，营营浪自喧。\n士为女听惑，溷比帝居尊。\n鱼馁庖难脍，瓜香圃欠樊。\n冰霜不恕汝，卦义取诸坤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31692,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诘旦思之世岂有不押之韵辄和北山十首 其一 蚊","author":"刘克庄","text":"细比蝇须类，凶加豹脚名。\n飞飏新得势，么喝远闻声。\n抱怨芳筋露，惊眠玉颊赪。\n天公许姑息，长养更生成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31693,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贫居自警三首 其三","author":"刘克庄","text":"客过吾庐语至晡，旋营盐酪刈薪刍。\n酒兼麟脯不时有，饭与鱼羹何处无。\n力穑勿忘家世俭，堆金能使子孙愚。\n俗儿未识贫中乐，妄议书生骨相臞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31694,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贫居自警三首 其二","author":"刘克庄","text":"赤粟黄齑味最深，此生不恨老云林。\n鬼神每瞰高明室，天地皆知暮夜金。\n夸士燃脐犹殉货，先贤覆首或无衾。\n一瓢千驷同归尽，莫为浮云错动心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31695,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贫居自警三首 其一","author":"刘克庄","text":"昨者匆匆掷印归，六年岑寂闭柴扉。\n岁荒奴仅拾残穗，日晏婢方羹苦薇。\n宁渴莫赊邻近酒，尽寒不著借来衣。\n中年但祝身强健，要卧松风坐钓矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31696,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贫病","author":"刘克庄","text":"默默守柴荆，人间事颇更。\n病方知养性，贫始欲谋生。\n尚有狂奴态，元无老婢声。\n迩来尘虑尽，勿怪小诗清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31697,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郊行","author":"刘克庄","text":"薄有西风意，郊行得自娱。\n山晴全体出，树老半身枯。\n林转亭方见，江侵路欲无。\n何妨桥缆断，小?故堪呼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31698,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郊行","author":"刘克庄","text":"一雨饯残热，忻然思杖藜。\n野田沙鹳立，古木庙鸦啼。\n失仆行迷路，逢樵负过溪。\n独游吾有趣，何必问栖栖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31699,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郊坰","author":"刘克庄","text":"所住在郊坰，田园事遍经。\n浅沟晴后塞，高垄雨馀青。\n屋润邻翁富，祠新社鬼灵。\n南州无酒禁，十户九旗亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31700,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郑宁示边报走笔戏赠","author":"刘克庄","text":"曾客嫖姚与伏波，惯骑生马拥雕戈。\n金台有命终须筑，铁砚无功亦且磨。\n见说帛书来汝洛，又传毡帐迫淮河。\n只今西北多机会，吾子南归意若何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31701,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郑甥有大西上","author":"刘克庄","text":"岁晚亲朋少，何堪远别离。\n人谁念原父，甥勿似牢之。\n宗伯惊文卷，慈亲望捷旗。\n饯行应满袖，不欠病翁诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31702,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨华台","author":"刘克庄","text":"昔日讲师何处在，高台犹以雨华名。\n有时宝向泥寻得，一片山无草敢生。\n落日磬残邻寺闭，晴天牛上废陵耕。\n登临不用深怀古，君看钟山几个争。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31703,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"顷净慈伦老将示寂以其师无准塔铭见属后三年竹溪中书君以诗速铭次韵一首","author":"刘克庄","text":"丛林老宿川无准，不钓纤鳞钓大鱼。\n抱佛脚多同学者，得吾髓有几人欤。\n难呼兜率谈宗旨，且问狐山乞绪馀。\n自笑余文无用处，热瞒俗眼说真如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31704,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"饯乡守宋监丞二首 其二","author":"刘克庄","text":"牛屋渔矶在履封，晚将身世托春风。\n荒原拾穗谁怜我，小队寻花屡屈公。\n耄有须眉如盖老，衰无歌诵美文翁。\n明时各遂飞潜性，去矣鞭鸾碧落中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31705,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"饯乡守宋监丞二首 其一","author":"刘克庄","text":"束起蒲鞭教令清，郡人未识疾呼声。\n瓯闽莫不兴于学，虞芮忘其所以争。\n父老见棠思旧爱，儿童骑竹若初迎。\n何须更说郎官省，小却犹当拜水衡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31706,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"饯送高大著出镇严陵","author":"刘克庄","text":"抗疏鸣阳易，翻身出昼难。\n无家归蜀道，有敕管严滩。\n席藁臣言戆，分茅圣度宽。\n空令同馆士，极目认帆竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31707,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"饯潘使君二首 其二","author":"刘克庄","text":"一念拳拳帝所临，士民皆谅使君心。\n随车雨每孚精祷，下濑船多出俸金。\n两载公真茹檗苦，百年人尚爱棠阴。\n从今紧闭袁安户，庭雪平腰径草深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31708,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"饯潘使君二首 其一","author":"刘克庄","text":"送去迎来两毂朱，如侯治行极稀疏。\n清惟薄采闽山荔，仁不曾苞丙穴鱼。\n遗爱验于还印后，归装贫似下车初。\n汉廷尚有公卿阙，颇怪龚黄欠玺书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31709,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"齿落","author":"刘克庄","text":"愈悲第二牙辞去，况我今亏第一牙。\n嚼比牛饲衰毕现，豁如狗窦丑难遮。\n宴陈麟脯真虚设，庖进鱼?不必嗟。\n岁晚鲁公惟食粥，断无仙骨饭胡麻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31710,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"临江使君陈华叟哀诗二首 其二","author":"刘克庄","text":"去岁相过寂寞滨，心如符券迹参辰。\n骨香万死何曾腐，膝屈千生不复伸。\n哀仲行诗谁续古，补中丞传岂无人。\n短歌虽愧招魂作，或可留传达史臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31711,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"临江使君陈华叟哀诗二首 其一","author":"刘克庄","text":"众闻鸣镝惊麇散，独奋空拳跃马迎。\n嚼齿骂声殊未绝，归元血面尚如生。\n睢阳合祀无南八，河北诸城有杲卿。\n可惜援师来已晚，当时巷战只州兵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31712,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"信庵丞相为余作墨梅二轴谢以小诗","author":"刘克庄","text":"天畀村翁一段奇，发函虹气贯茅茨。\n肯移金鼎调元手，为作玉龙檠雪枝。\n绝艳从教百花妒，秘藏莫遣六丁知。\n信庵丞相亲分付，么去花光与补之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31713,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"前辈","author":"刘克庄","text":"前辈日以远，斯文吁可悲。\n古人皆尚友，近世例无师。\n晚节初寮集，中年务观诗。\n虽云南渡体，俗子未容窥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31714,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南唐一首","author":"刘克庄","text":"建隆事得之遗老，畴昔曾参野史看。\n后阁夜犹歌玉树，陈桥日已涌金盘。\n可怜李主归朝晚，专靠江神立国难。\n谁道齐兵当十万，一身杌隉不能安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31715,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南浦亭寄所思","author":"刘克庄","text":"只是从前瘦病身，官卑活计大清贫。\n买来晋帖多成赝，吟得唐诗转逼真。\n生拟弃家寻剑客，死当移冢近骚人。\n秋风烂熳吹双鬓，目送停云欲怆神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31716,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南康赵明府赠予四诗和其首篇二首 其二","author":"刘克庄","text":"二老风流接见闻，馀香未远尚堪薰。\n明师岂不使人巧，老仆安能重子文。\n策蹇何由追抹电，化龙吾亦愿为云。\n从来作圣功夫处，不在生知在积勤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31717,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南康赵明府赠予四诗和其首篇二首 其一","author":"刘克庄","text":"曾掌兰台纂旧闻，亦瞻玉座和来薰。\n戆愚漫有诛奸笔，疏拙元无乞巧文。\n执简自知愧南董，免冠谁肯救朱云。\n消磨不尽惟诗在，社友寻盟意尚勤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31718,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"咸淳龙飞大魁之归卿大夫以某兄弟有一日之长俾主其事水村农卿谓某当为诗为壶山唤回百年英灵之气客散诗成翌早录呈且约同社属和 其一","author":"刘克庄","text":"倾城迎侯锦归忙，儿女鲜衣妓晓妆。\n龙首榜来春满郡，鸡栖车已夕还乡。\n团司局结慈恩寺，一炬灯传旧弼坊。\n莫作寻常先辈看，淳熙相府甲科郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31719,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"咸淳龙飞大魁之归卿大夫以某兄弟有一日之长俾主其事水村农卿谓某当为诗为壶山唤回百年英灵之气客散诗成翌早录呈且约同社属和 其二","author":"刘克庄","text":"射策人如射利忙，岂知世有古来妆。\n汉庭儒半坏科举，天下士宁论国乡。\n但诧高标广寒殿，谁能更读善和坊。\n观君毛羽真鸾凤，羞杀粗豪白面郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31720,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哀二僧 其一","author":"刘克庄","text":"送迎懒更下禅床，撑拄犹堪坐道场。\n大众□□□□病，小师忽报惠休亡。\n庵荒空复留遗偈，□□□□□厚藏。\n吾老此诗聊赠别，塔铭合属紫薇郎。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31721,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哀仲妹","author":"刘克庄","text":"壸范班班在里闾，始知列女传非虚。\n室无遗桂空花妄，溪有新茔宰树疏。\n弟忆雪中联汝句，兄行雷岸寄家书。\n自怜戴白龙钟叟，犹向原头驾素车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31722,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哀江帅张常二首 其二","author":"刘克庄","text":"昔我居戎幕，为侯论战勋。\n斋旄俄烜赫，书札尚殷勤。\n国难忠方见，天高事未闻。\n九江残部曲，暗哭故将军。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31723,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哀江帅张常二首 其一","author":"刘克庄","text":"关破垒犹坚，伤心援不前。\n生居诸将下，死在众人先。\n愤极拳双握，创多体少全。\n岂无人策应，拥纛坐江边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31724,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哀陈璹","author":"刘克庄","text":"满怀干世策，自请戍边城。\n不得兵书力，翻成礼部名。\n妓方调锦瑟，客已吊丹旌。\n都下人来说，还因喜丧生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31725,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"城坏复修又赋","author":"刘克庄","text":"补罅扶倾手段新，举头千丈又嶙峋。\n主谋何止堪尸祝，妄议真当抵鬼薪。\n见说传更增逻卒，已闻犯夜少奸民。\n小偷不办公输械，遥望须惊彼有人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31726,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"客中作","author":"刘克庄","text":"漂泊何须远，离乡即旅人。\n吹薪尝海品，书刺谒田邻。\n家寄寒衣少，山来晓梦频。\n小儿仍病疟，诗句竟无神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31727,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"容堂生日","author":"刘克庄","text":"玉守清无一点尘，泠泠笙鹤下青旻。\n大期爵德尊三者，上界神仙第一人。\n经画中原皆向化，燮调四序总如春。\n自怜九帙须眉老，笼鸽难陪祝寿宾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31728,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"幽居寺","author":"刘克庄","text":"相传有儒者，唐季隐兹峰。\n电已收遗藁，云方锁暮钟。\n木碑无世次，石洞断人踪。\n此士何曾死，林深不可逢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31729,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"待制赵公伯泳哀诗二首 其二","author":"刘克庄","text":"忆昔鹓行接武趋，与君肝胆素相孚。\n孤忠不忍欺明主，健论真堪立懦夫。\n公是意林曾续否，退之手注尚存无。\n暮年数出交游泪，莫怪星星满鬓须。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31730,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"待制赵公伯泳哀诗二首 其一","author":"刘克庄","text":"赵氏源流自副枢，至公清节亢门闾。\n绪言犹接淳熙际，亲擢何惭庆历初。\n班马定为廉吏传，韩欧无责谏臣书。\n可怜衮斧忠邪学，仅向甘泉扈属车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31731,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"总戎徐侯伯东远访田舍赠诗二首次韵 其一","author":"刘克庄","text":"内辞狨橐外菟符，巾褐萧然一老儒。\n床上乱书眠当枕，卷中警句摘为图。\n雨寒裹饭故人少，雪夜扁舟今世无。\n惟有徐君真好事，高轩肯自福之莆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31732,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"总戎徐侯伯东远访田舍赠诗二首次韵 其二","author":"刘克庄","text":"博览彊通千载事，冥搜谬用一生心。\n乾坤劫数有成毁，风月性情无古今。\n君似得吾之骨髓，俗方求我以声音。\n若非生处殊闽浙，把臂相邀共入林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31733,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"总管徐侯和余梅百咏辄课七言一章以答来贶","author":"刘克庄","text":"作者肩摩似堵墙，君侯殿后独轩昂。\n搀先太皞露消息，笑杀书生泥色香。\n能令曹瞒兵渴止，谁云开府□肠刚。\n骚坛甚矣荒芜久，评小徐陵合擅场。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31734,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"故宅","author":"刘克庄","text":"恰则炎炎未百年，今看枯柳著疏蝉。\n庄田置后频移主，书画残来亦卖钱。\n春日有花开废圃，岁时无酒滴荒阡。\n朱门从古多如此，想见魂归也怆然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31735,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春寒一首","author":"刘克庄","text":"拨尽寒灰转凛然，抛书数息煖丹田。\n蛩吟近作胜前作，鲸吸今年减去年。\n薄粥聊糊鲁公口，重裘犹耸孟生肩。\n几时风日妍和了，乱插山花藉草眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31736,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春寒二首 其二","author":"刘克庄","text":"百艺惟诗老始工，未应冻死杜陵翁。\n耸肩偏怯春衣薄，曝背尤贪晓日红。\n草鼓煖于狨坐子，蒲龛清似肉屏风。\n几时天地回生意，只费阳和一点功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31737,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春寒二首 其一","author":"刘克庄","text":"东皇太乙漫行春，无赖封姨未霁嗔。\n薄酒不红皱靴面，湿薪难直曲钩身。\n埋腰健羡单传者，堕指深惭远戍人。\n莫笑布衾如铁冷，也胜去傍相君茵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31738,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春暮","author":"刘克庄","text":"一亩青苔半落英，蜂忙蝶懒互卿卿。\n燕泥乾后儿初落，鱼尾轻时子遍成。\n閒拂午窗惊野马，梦游天竺听华鲸。\n舍南有柳纤纤在，不奈双蝉占取鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31739,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"柬人求驴子","author":"刘克庄","text":"闻在江宁得小驴，价高人说是名驹。\n行时亦肯过桥否，饥后还能饮涧无。\n不称金鞍驮侍女，只宜席帽载贫儒。\n灞陵雨雪诗家事，乞与它年做画图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31740,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"柬方寺丞病足","author":"刘克庄","text":"西北名山未遍经，讵宜倚杖立竛竮。\n脉通气数医难晓，病在皮肤药易灵。\n昔走战场常纵靶，今居内屋更施屏。\n平生受用嵇康论，欲献公为座右铭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31741,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]