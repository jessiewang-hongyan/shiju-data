[{"title":"东皋十首 其二","author":"晁补之","text":"郭外朝阳一卷斜，青槐厅事带丘麻。\n路逢扶辔双童问，不是城东太尉家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55183,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东皋十首 其一","author":"晁补之","text":"屋名尽挂陶家榜，人物应惭菊畔身。\n解作文章肯归去，不应陶后说无人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55184,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"出城三首 其三","author":"晁补之","text":"堆案文书无了毕，并堤船舫且萦回。\n非关董役年年事，自为春郊得得来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55185,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"出城三首 其二","author":"晁补之","text":"故国龙舟休水调，高城雉堞尚云间。\n蜀冈朝雨如轻雾，不见春江草外山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55186,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"出城三首 其一","author":"晁补之","text":"桃欲呈红柳弄阴，麦田青已没鞋深。\n春堤细雨篮舆湿，婆饼焦声在竹林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55187,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"出游龙虎山舟中望仙岩壁立千仞者不可上其高处穴中往往如囷仓棺椁云盖仙人所居也余意大水人宅山上所作","author":"晁补之","text":"稽天巨浸洗南荒，尚有千峰骨立强。\n民未降丘应宅此，举头天壁有囷仓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55188,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"外舅杜寺丞永城守水作诗寄呈","author":"晁补之","text":"雪消冰动看通津，草长江南岸岸春。\n莫唱龙舟五更曲，扬州杨柳解愁人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55189,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"旧说庐山有紫芝田百亩人莫得见偶于开先栖贤林中步两日各得一枝正紫如玉戏成一首","author":"晁补之","text":"千古芝田人不到，深林继日拾琼瑰。\n从今为记晁夫子，曾到芝田百亩来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55190,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"甘雨","author":"晁补之","text":"晻晻轰轰有物催，端如鬼驾北溟来。\n百昌一种得甘雨，蛇不耆乾苕卵摧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55191,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"由开先万杉栖贤罗汉入城南康守云惜君未至紫霄峰也因以此答","author":"晁补之","text":"南康南麓江州北，五百伽蓝似蜜脾。\n万室千门俱面势，不应独是紫霄奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55192,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"示张仲原秀才二首 其一","author":"晁补之","text":"去年钜野张狂澜，黄河水不到鱼山。\n焦城有屋仲子筑，它日能来相往还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55193,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"仲光寄纻袍","author":"晁补之","text":"手裁白纻制新袍，犊鼻应怜犬子劳。\n倚仗衡门聊服此，良人身不属临洮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55194,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"先茔治事归","author":"晁补之","text":"先人昔慕栖山乐，贱子今怀陟岵悲。\n柏叶初生石墙短，况无金带买丰碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55195,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"守蒲过洛思十岁时侍先君寓居泣涕成诗二首 其一","author":"晁补之","text":"建春门外柳依依，迸泪当年綵服嬉。\n穷子更无逢父日，匿王空记看河时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55196,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"守蒲过洛思十岁时侍先君寓居泣涕成诗二首 其二","author":"晁补之","text":"先君欲筑伊川意，四十年间万事非。\n他日一廛从可卜，白头持此欲安归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55197,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"安陶舟中","author":"晁补之","text":"缭绕春堤去欲穷，参差烟坞到还通。\n依依润柳侵晨雨，细细吹花傍午风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55198,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"扬州杂咏七首 其三","author":"晁补之","text":"欲穿九曲通淮子，只费春夫数日工。\n但见荷花三十里，何须更有大雷宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55199,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"扬州杂咏七首 其二","author":"晁补之","text":"雷陂新作麦田荒，曾说风兴没两郎。\n谁似当年李刺史，春波还引句城塘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55200,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"扬州杂咏七首 其一","author":"晁补之","text":"舶商不入古盐沟，疏凿才争土一抔。\n未说兴圩灌田事，且还歌吹旧扬州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55201,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"扬州杂咏七首 其七","author":"晁补之","text":"杨徐僭盗雄图炽，高吕陵夷霸气阑。\n犹有昆冈作龙虎，千秋原庙奉衣冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55202,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"扬州杂咏七首 其六","author":"晁补之","text":"龙兴寺里青云干，后土祠中白雪葩。\n五百年间城郭改，空留鸭脚伴琼花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55203,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"扬州杂咏七首 其五","author":"晁补之","text":"皂荚村南三里许，春江不隔一程遥。\n双堤斗起如牛角，知是隋家万里桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55204,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"扬州杂咏七首 其四","author":"晁补之","text":"蜀冈茶味图经说，不贡春芽向十年。\n未惜青青藏马鬣，可能辜负大明泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55205,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵无极以道寄金山寺佛鉴五绝 其一","author":"晁补之","text":"埋头尘土欲忘年，重过初禅第一天。\n唯有儿童见河性，不将老面共苍然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55206,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵无极以道寄金山寺佛鉴五绝 其二","author":"晁补之","text":"不应无手是无拳，且看毛端现四天。\n似向吾家得消息，鼓山馀响尚轰然。","collection":"宋",