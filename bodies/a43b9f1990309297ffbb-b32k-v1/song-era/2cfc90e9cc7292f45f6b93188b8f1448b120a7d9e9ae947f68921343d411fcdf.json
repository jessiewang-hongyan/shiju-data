ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"汴堤暮雪怀径山澄慧道人","author":"晁补之","text":"朔风吹雪乱沾襟，走马投村日向沉。\n遥想道人敲石火，冷杉寒竹五峰深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55232,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"身世谩悠哉","author":"晁补之","text":"身世谩悠哉，田园首重回。\n春来亦何事，忽忽叹庭槐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55233,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"连日顺风","author":"晁补之","text":"昔日肩吾上国行，鱼龙黑浪自堪惊。\n我今憔悴西风稳，却是江神不世情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55234,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"叔与戏云谓我穷我尝伤食从而嘲之","author":"晁补之","text":"羊踏胸中昨夜蔬，不应扪腹怪如壶。\n妇家得餔犹须忍，莫索槟榔笑尔臞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55235,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和文潜二首 其二","author":"晁补之","text":"索米强知当世策，种芝欲访隐人书。\n未应只有邻邦约，投老相看事事如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55236,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和文潜二首 其一","author":"晁补之","text":"阮籍空贪步兵酒，阳城犹恋集贤书。\n饱知世事非人力，可是因玄更泊如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55237,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和文潜试院道旧","author":"晁补之","text":"璧月照歌淮上舫，姚花引醉福昌城。\n何如阊阖门西北，卧听秋风枕畔声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55238,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和王拱辰观梨花二首 其一","author":"晁补之","text":"海棠十韵诧芬芳，惭愧梨花冷似霜。\n赖有乐天春雨句，寂寥从此亦馨香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55239,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和王拱辰观梨花二首 其二","author":"晁补之","text":"压沙寺里万株芳，一道清流照雪霜。\n银阙森森广寒晓，仙人玉仗有天香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55240,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和洛笋小发","author":"晁补之","text":"叔夜青山肯长往，不应石髓化山坚。\n君会箨龙才小发，恐君心未老伊川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55241,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和胡戢七首 其七","author":"晁补之","text":"少时豪气恨沉沦，缪意诗书可庇民。\n长笑壮年无一事，微吟只有故人亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55242,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和胡戢七首 其六","author":"晁补之","text":"千首清诗竞夜长，真成蝴蝶为春忙。\n莫教流落人间少，雷电它时下取将。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55243,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和胡戢七首 其五","author":"晁补之","text":"时平未用入山深，岁晚何妨木秀林。\n闻说熊罴参后乘，可容牛下有哀吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55244,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和胡戢七首 其四","author":"晁补之","text":"住近苏门有白云，闭关却埽道逾尊。\n相逢不语忽长啸，今日岂无人姓孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55245,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和胡戢七首 其三","author":"晁补之","text":"闻说归心已浩然，苏门况有子云廛。\n广文不去惭官长，系马堂阶要酒钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55246,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和胡戢七首 其二","author":"晁补之","text":"相逢樽酒未辞深，握手盱眙十载心。\n车马凄凉人夜别，出门落月与横参。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55247,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和答曾敬之秘书见招能赋堂烹茶二首 其一","author":"晁补之","text":"玉泉吟鼎月隳轮，姑射风标两绝尘。\n只欠何郎窗畔雪，戎葵为我作馀春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55248,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和答曾敬之秘书见招能赋堂烹茶二首 其二","author":"晁补之","text":"一碗分来百越春，玉溪小暑却宜人。\n红尘它日同回首，能赋堂中偶坐身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55249,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和雒酒十二弟见降羌赴阙","author":"晁补之","text":"二鸟蒙恩岂有知，车书混一是昌期。\n知君不化伊川祭，右倚门墙恐见麾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55250,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"国子监暮归","author":"晁补之","text":"杖屦清晨往，缣囊薄暮归。\n闲官厅事冷，蝴蝶上阶飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55251,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜闻慎思吟讽","author":"晁补之","text":"疏林小雨月胧明，商颂琅琅半夜声。\n邓子弓强殊未发，欲驰桑本犯坚城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55252,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"松菊堂读史五首 其五","author":"晁补之","text":"当年伏地全杨李，公亦何知爱恶间。\n千古论心许公近，百年归意与谁闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55253,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"松菊堂读史五首 其四","author":"晁补之","text":"平生精爽皋夔内，一世功名贝锦间。\n再梦令狐亦何事，可能到死未心闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55254,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"松菊堂读史五首 其三","author":"晁补之","text":"明光甲挫三言内，悉怛谋亏一算间。\n成败关心不瞑目，我今无此只应闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55255,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"松菊堂读史五首 其二","author":"晁补之","text":"吾慕斯人不以官，会昌一梦中兴间。\n何须更作穷愁志，秋雨长时睡正闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55256,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"松菊堂读史五首 其一","author":"晁补之","text":"不作文饶将相官，野人亦挂党人间。\n筹边措国俱无用，空对平泉草木闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55257,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泊舟山阳偶题","author":"晁补之","text":"五岁淮山一梦新，扁舟曾系市桥春。\n津亭石磴双垂柳，见我依依似故人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55258,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泊思禅寺呈廖明略其地盖干越寺在琵琶洲上","author":"晁补之","text":"迟君干越思禅寺，弥月忘归住翠岚。\n忽见琵琶洲上月，始惊全室在天南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55259,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]