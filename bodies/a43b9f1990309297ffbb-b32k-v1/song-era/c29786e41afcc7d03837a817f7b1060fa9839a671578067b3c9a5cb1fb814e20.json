[{"title":"论语绝句 其二十四","author":"张九成","text":"仁智从来不可分，动中机向静中存。\n自然形体难增损，不要犹添斧凿痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49650,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"论语绝句 其二十三","author":"张九成","text":"算来此亦是寻常，不比其他味较长。\n孔子弦歌颜子乐，大家相见没商量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49651,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"论语绝句 其二十一","author":"张九成","text":"三千七十固多哉，好学如何独有回。\n若论不迁并不贰，更无人向此中来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49652,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"论语绝句 其二十","author":"张九成","text":"愿乘车马衣轻裘，便与颜回论不投。\n更得预闻夫子志，天高地下果难俦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49653,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"论语绝句 其十九","author":"张九成","text":"武子人皆指作愚，不知愚意竟何如。\n虽愚到底无人识，始觉从来智者疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49654,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"论语绝句 其十八","author":"张九成","text":"文子平生不妄为，仲尼想亦喜闻之。\n或能再矣斯犹可，何况加之以三思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49655,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"论语绝句 其十七","author":"张九成","text":"须知有欲不为刚，血气乘之反类狂。\n所以孟轲言直养，要令无助亦无忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49656,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"论语绝句 其十六","author":"张九成","text":"子路何尝肯不情，从人姑尔事虚名。\n所行唯恐复闻耳，既已闻之且力行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49657,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"论语绝句 其十五","author":"张九成","text":"贫即无聊富即骄，回心独尔乐箪瓢。\n个中得趣无人会，惆怅遗风久寂寥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49658,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"论语绝句 其十四","author":"张九成","text":"朽固难雕粪莫圬，于予材美亦何诛。\n欲令顾此深为戒，言语之科首宰予。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49659,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"论语绝句 其十三","author":"张九成","text":"岂是于回果弗如，只缘闻处尚多疏。\n若还真个能闻一，安得其他更有馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49660,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"论语绝句 其十二","author":"张九成","text":"行道嗟吾已矣夫，仲由从我去乘桴。\n果然子路闻之喜，好勇如由亦自无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49661,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"论语绝句 其十一","author":"张九成","text":"所长孰不愿施之，岂肯言吾未信斯。\n大是此心真不昧，断知天地不容欺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49662,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"论语绝句 其十","author":"张九成","text":"须知道体亦常虚，君子安能一器拘。\n赐也但知瑚琏贵，岂闻天地亦蘧庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49663,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"论语绝句 其九","author":"张九成","text":"白首穷经恨不知，书生辛苦竟何为。\n一朝闻道无馀事，若较寻常死亦迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49664,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"论语绝句 其八","author":"张九成","text":"于时舍瑟方铿尔，岂意吾师亦喟然。\n此际风流人不识，只应潇洒得心传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49665,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"论语绝句 其七","author":"张九成","text":"此理寻常岂不如，奈何人不反思之。\n故应指掌从君示，想亦于斯勿更疑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49666,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"论语绝句 其六","author":"张九成","text":"门人唯诺亦寻常，彼此如何较短长。\n自是旁人不曾识，指为鸣凤在朝阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49667,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"论语绝句 其五","author":"张九成","text":"机缄固尔寓弦歌，不是知音不肯过。\n夫子闻之方莞尔，未知言偃意如何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49668,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"论语绝句 其四","author":"张九成","text":"见得分明乃谓如，分明如此尚为疏。\n莫于见处留形迹，方信心斋万象虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49669,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"论语绝句 其三","author":"张九成","text":"虽然此影不离形，莫向形中便认真。\n形影两亡都不见，当于此处认斯人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49670,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"论语绝句 其二","author":"张九成","text":"算来只是弄精神，识破于时始悟真。\n表里分明都见了，区区何必更书绅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49671,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"论语绝句 其一","author":"张九成","text":"既是文章可得闻，不应此外尚云云。\n如何夫子言天道，肯把文章两处分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49672,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜起","author":"张九成","text":"昔日尝惊堕俗尘，今朝始觉是閒人。\n夜窗睡起无人见，万里青天月一轮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49673,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岭下桃花作澹红色绝可爱因作绝句","author":"张九成","text":"江北桃花色颇秾，不堪凡陋也春风。\n谁知岭下新来样，故作宫妆澹水红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49674,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南安宝戒院作","author":"张九成","text":"苦无人事扰闲居，赢得终年学著书。\n今日欣然出门去，秋风吹意满芙蕖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49675,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏日即事 其四","author":"张九成","text":"云开日出四窗明，恰到犹馀梦自生。\n一枕觉来人寂寂，时闻儿子读书声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49676,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏日即事 其二","author":"张九成","text":"心瑩是非都不入，神清魂梦亦无多。\n年来借问生何似，梅雨寒塘飐露荷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49677,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏日即事 其三","author":"张九成","text":"日长院落迥无人，忽悟犹馀此老身。\n只拟一时都忘了，放教桃李四时春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49678,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏日即事 其一","author":"张九成","text":"阴阴庭院静无声，只有黄鹂绕树鸣。\n午睡觉来何所见，玉炉风细碧烟横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49679,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏日即事 其三","author":"张九成","text":"萱草榴花照眼明，冰厅水阁晚风清。\n萧然终日无人到，帘外时闻下子声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49680,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏日即事 其一","author":"张九成","text":"寂寂柴门可设罗，唯馀柳色许相过。\n重帘半卷鸟声乐，閒看炉烟篆髻螺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49681,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏日即事 其二","author":"张九成","text":"日长廊迥思悠悠，自视真如不系舟。\n欲趁好风河汉去，玉楼银阙剩遨游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49682,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"颂一首","author":"张九成","text":"春天夜月一声蛙，撞破虚空共一家。\n正恁么时谁会得，岭头脚痛有玄沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49683,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庾岭旧传有梅往往诗人借此为江南春信予到此数年因登岭上不见一枝遂成一绝","author":"张九成","text":"诗人常说岭头梅，往往春风自此来。\n我到岭头都不见，空将春梦又空回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49684,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"惜花","author":"张九成","text":"数日生寒紧杜门，今朝步屧到前村。\n可怜桃李都飞尽，细雨斜风更断魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49685,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜晴","author":"张九成","text":"数日阴霖气不舒，江流作涨吾其鱼。\n晚来风起云头散，夜半星辰满太虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49686,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"酴醾 其二","author":"张九成","text":"昨夜姮娥到万山，更携青女散山间。\n天明欲去归不得，化作此花来破颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49687,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"酴醾 其一","author":"张九成","text":"蜀锦年来可作衣，西园春色故芳菲。\n天工成此新翻样，翡翠机中玉唾飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49688,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题郡斋壁","author":"张九成","text":"吏散兵休文案静，数竿脩竹隔疏帘。\n嗟予老矣欲归去，肯对江山叹滞淹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49689,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二月二十四日即事","author":"张九成","text":"春来寻胜事，此兴亦何穷。\n夜雨乱江渌，朝花褪日红。\n雷声惊岭北，云气涨溪东。\n蓑笠冲泥去，谁知与我同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49690,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"八月十四日偶成","author":"张九成","text":"物情犹惝恍，门户更萧然。\n勿念客来往，何妨吾醉眠。\n北园肥菜甲，南浦鲙鱼鲜。\n一酌馀妻子，此生休问天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49691,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十一日咏梅","author":"张九成","text":"一年胜事又相亲，数树寒香巧斗新。\n拥鼻独来江上晚，行吟忽见渡头春。\n孤标不入千花伴，冷艳初无一点尘。\n翻笑渊明太多可，千秋作好菊花人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49692,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十二月初七日述怀","author":"张九成","text":"谪居寂寞岁将阑，几案凝尘酒盏乾。\n落落雨声檐外过，愔愔雪意座中寒。\n孤飞只影人谁念，万里长途心自安。\n世事悠悠君莫问，雪芽初碾试尝看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49693,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三月十一日不出","author":"张九成","text":"老罢慵人事，柴门尽日扃。\n春江入幽想，夜雨涨前汀。\n何日当晴霁，西山云眇冥。\n江头无限好，见说柳深青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49694,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三月晦城门晚景","author":"张九成","text":"雨涨春江浪，沄沄日夜奔。\n群山落云里，万壑吼岩根。\n沙际人呼渡，烟中牧入村。\n萧然何处士，终日掩柴门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49695,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山蝉","author":"张九成","text":"浴罢风来玉宇凉，山蝉吟咏送斜阳。\n长缫独茧来还去，九折升车短更长。\n窈眇笙箫云汉冷，凄清风露月华香。\n看君定是神仙侣，且择高枝深处藏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49696,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"六月十四日观云有作","author":"张九成","text":"深深萧寺足幽居，寝饭行藏亦自如。\n仰识白云天外意，俯看青史古人书。\n摩挲方寸生无愧，周览山川气有馀。\n不用棹舟江海去，清风明月是吾庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49697,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"双秀峰","author":"张九成","text":"且向城西去，休惊雨溅空。\n乱山明灭外，古刹有无中。\n笑指双峰翠，回看落日红。\n中兴喜无事，歌管莫匆匆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49698,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"见菊花呈诸名胜","author":"张九成","text":"勿谓重阳把一枝，嗟予何限古人思。\n灵均自著离骚日，元亮长歌归去时。\n未晓只疑犹泫露，开门忽见满疏篱。\n要呼四海平生友，来醉花前金屈卮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49699,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再用前韵 其一","author":"张九成","text":"野涧江湾三两枝，一时清绝破愁思。\n纤纤弄蕊霜秋里，滴滴开花叶落时。\n借问哦诗记幽梦，何如把酒对东篱。\n不然采向林逋庙，并与寒泉荐一卮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49700,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再用前韵 其二","author":"张九成","text":"凭谁为斲凤凰枝，欲寄朱弦写我思。\n著叶浪同烟雨里，开花独向晚霜时。\n羞随燕麦争春色，故伴乔松栖败篱。\n唤取老嵇挥数弄，不辞满引帐前卮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49701,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次单推韵","author":"张九成","text":"七载离家梦亦惊，春来又是听仓庚。\n熟谙世味心如水，忽见吾人眼尚明。\n青镜不堪看白发，长镵何处觅黄精。\n只思归去西湖上，饱吃东坡玉糁羹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49702,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次单推韵 其三","author":"张九成","text":"每思乡里秀，日日听新除。\n愁苦千行泪，清贫一束书。\n端溪元秀爽，梅蕊正萧疏。\n公事多馀暇，箪瓢亦晏如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49703,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次单推韵 其二","author":"张九成","text":"庾岭三江外，相过车马勤。\n孤吟清庙瑟，愁思楚江云。\n寂寞林逋宅，凄凉伍相坟。\n何时定归去，摸索断碑文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49704,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次单推韵 其一","author":"张九成","text":"执别动经岁，年光挽莫留。\n壮心今已老，雅志自无求。\n白日将诗遣，生涯著醉酬。\n颓然烟瘴里，一饱更何忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49705,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次施彦执韵","author":"张九成","text":"新诗宛见故人面，思入江山气象雄。\n几岁不堪青草瘴，今朝还喜鲤鱼风。\n高秋木落雁为伴，久雨江深吾欲东。\n他日樽前如把臂，莫惊我已白头翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49706,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"竹","author":"张九成","text":"帘外谁家竹，凉风日日生。\n凌霜惊节老，带月出云明。\n色映樽罍绿，声传钟磬清。\n葛陂看变化，甘雨满寰瀛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49707,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过报恩","author":"张九成","text":"篮舆访萧寺，烟暝涨春空。\n远树楼头绿，残霞山外红。\n昏钟发林杪，人语殷桥东。\n回首都无迹，人生真梦中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49708,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即事","author":"张九成","text":"幽事晚山色，幽斋春雨馀。\n乱红攲涧水，浮绿涨郊墟。\n北牖迸新笋，西园生野蔬。\n槿篱绕茅屋，已分老樵渔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49709,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"到白石寺次壁间郑如圭韵","author":"张九成","text":"寺古僧多老，云深水自流。\n鸟声惊客梦，山色到江楼。\n落日千林迥，清风一径幽。\n幽怀终未已，归去辄回头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49710,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"咏梅 其二","author":"张九成","text":"已知节物向春荣，篱下溪边照眼明。\n夜雪压枝生冷艳，晓寒入骨耿飞英。\n长条直上姿尤媚，斜朵横来思更清。\n疑是玉皇传诏急，群妃委佩赴仙京。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49711,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜雨","author":"张九成","text":"春阴正愁绝，夜雨复淋漓。\n楚客南冠日，湘累去国时。\n千山花尽落，万壑水东之。\n脉脉灯前意，夫君知不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49712,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"松棚","author":"张九成","text":"炎炎暑气若为当，旋买松枝庇草堂。\n一望翠阴何爽快，暂来吾室变清凉。\n直疑仙去冰壶里，岂是生居汾水阳。\n向晚薰风香入座，为君一再奏文王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49713,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨","author":"张九成","text":"已止还复作，泻檐声更长。\n苔钱添晚翠，梅子试新黄。\n屋里图书润，庭前兰芷香。\n倚栏閒觅句，水阁夜生凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49714,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"前日偕长文赴大庾饭坐中见黄菊盛开故有前作新诗既三复矣最后乃云黄菊尚未之见间有一二株白菊耳且有閒傍短篱寻嫩蕊忽惊孤蝶绕幽篱之句黄花岂得无语辄发一笑","author":"张九成","text":"曾向华筵折数枝，不知心正阿谁思。\n却怜弄玉吹箫伴，忘了小桥同醉时。\n和泪盈盈凄晓露，含情脉脉怨东篱。\n孙郎风味年来减，且对西风罚满卮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49715,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"客有谈嘉祐间事者一客瞪目不应及闻介甫新事则心目开明殊可怪也聊作诗以纪之","author":"张九成","text":"吾道何衰只怆神，六经文字变仪秦。\n魏侯酷喜听新乐，中尉生来好杀人。\n海鸟错将金奏眩，叶公元爱画龙真。\n不逢伯乐休骧首，忽遇长沮莫问津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49716,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"某还故里过括苍谢景思少卿示及诸公和诗次韵为谢","author":"张九成","text":"朝随落月东郊去，暮逐归云北浦还。\n岂但劳农勤稼穑，要知为郡足清閒。\n家传诗句东山谢，学到精微陋巷颜。\n今日倚栏聊解带，欲看烟雨四边山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49717,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"柑花","author":"张九成","text":"群芳落尽只青青，独有柑花照眼明。\n已许江梅来结友，未容岩桂擅清名。\n芬芬兰麝三春底，濯濯冰霜一座倾。\n更待秋风资爽气，垂黄篱落伴金橙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49718,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送单普赴肇庆节推","author":"张九成","text":"岁穷情错莫，吾子欲何之。\n庾岭梅今见，端溪石自奇。\n瘴深宜饮酒，公退好哦诗。\n莫谓无征雁，而忘酌别时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49719,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闻沈元用帅南海喜而有作","author":"张九成","text":"与公相别五经年，忧患流离理固然。\n怅望故园江渚外，还惊横浦瘴烟边。\n喜闻金节专南海，行看锋车上九天。\n顾我不才仍老矣，只思归棹五湖船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49720,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"倅车送海棠","author":"张九成","text":"瘴雨蛮烟西复东，海棠岭下占春风。\n清肌本自同梅洁，晕脸应知是酒红。\n澹著燕脂春未透，半匀胡粉日初烘。\n此花不与凡花并，桃李休矜造化工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49721,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]