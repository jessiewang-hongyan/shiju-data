[{"title":"步屧","author":"陆游","text":"名山有志未能酬，步屧东冈当出游。\n小阁捲帘惊鹭起，清池投饵看鱼浮。\n西风吹叶空多感，落日衔山尚小留。\n儿老戍边归未得，淮南新雁又经秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8344,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"汪茂南提举挽词二首 其一","author":"陆游","text":"学已三冬富，书犹万卷藏。\n名场虽蹭蹬，朝论极揄扬。\n小试襦裤咏，遂辞鹓鹭行。\n秋风九原路，挽铎倍凄凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8345,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"沉绵","author":"陆游","text":"沉绵久未平，寂寞闭柴荆。\n危叶先霜坠，残萤冒雨明。\n记书由默诵，得食出躬耕。\n此事吾亲验，方当告后生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8346,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"沔阳夜行","author":"陆游","text":"夜发沔阳驿，坡陁冈阜重。\n月斜攲帽影，霜重湿裘茸。\n野岸鸣枯叶，烟林度晓钟。\n梁州明日到，一笑解衰容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8347,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"沙头","author":"陆游","text":"游子行愈远，沙头逢暮秋。\n孙刘鼎足地，荆益犬牙州。\n鼓角风云惨，江湖日夜浮。\n此生应衮衮，高枕看东流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8348,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泛三江海浦","author":"陆游","text":"鳌负三山碧海秋，龙骧万斛放翁游。\n少舒我辈胸中气，一扫群儿分外愁。\n醉斩长鲸倚天剑，笑凌骇浪济川舟。\n悠然高咏平生事，龌龊宁能老故丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8349,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泛舟","author":"陆游","text":"女墙齾齾带斜晖，短棹还从剡曲归。\n木叶经霜浑欲尽，人家近水自相依。\n逢迎俗客言多忤，颠沛穷途计易非。\n雪里闭门殊不恶，故貂虽弊胜无衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8350,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泛舟","author":"陆游","text":"水乡元不减吴松，短棹沿洄野兴浓。\n郁郁冬青森翠葆，离离夜合散红茸。\n村深初度穿林笛，寺近先闻出坞钟。\n归路夕阳犹满岸，凭舷一笑览衰容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8351,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泛舟","author":"陆游","text":"水长芳洲没，风生钓艇横。\n偶寻东埭去，却作北村行。\n宿鸟昏方定，流萤雨更明。\n归来未觉晚，传漏下重城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8352,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泛舟","author":"陆游","text":"去去泛轻舠，飘然兴自豪。\n叶凋山寺出，溪瘦石桥高。\n草径牛羊下，烟村鹳鹤号。\n还家一杯酒，未畏暮风饕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8353,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泛舟自中堰入湖","author":"陆游","text":"水缩沙洲出，霜清木叶丹。\n鹭群横澹霭，鸦阵报初寒。\n冷落人情见，衰迟世念阑。\n惟留一句子，村舍话团圞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8354,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泛舟至东村","author":"陆游","text":"野水如天远，渔舟似叶轻。\n飕飕风渐冷，淡淡月初生。\n沙际樵苏路，篱间语笑声。\n还家已薄暮，灯火照柴荆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8355,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泛舟至近村茅徐两舍劳以尊酒","author":"陆游","text":"小舸悠飏亦乐哉，迢迢故取北村回。\n山从树外参差出，水自城阴曲折来。\n乐岁共忘东作苦，残租不待急符催。\n旧邻父老睽离久，唤取开颜把一杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8356,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泛舟至鲁墟","author":"陆游","text":"南荡东陂弄夕霏，葛巾鹤氅试秋衣。\n纤纤新月迎船出，两两珍禽背水飞。\n病思渐苏开酒戒，宦情已绝谢尘鞿。\n郊居是处堪乘兴，不怕城笳苦唤归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8357,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泛舟至蜻蜓浦小泊渔村","author":"陆游","text":"醉泛蜻蜓浦，咿哑一橹声。\n陂塘秋水瘦，墟落暮烟生。\n野店曾留醉，樵翁不记名。\n相逢虽惘惘，怀抱已先倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8358,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泛舟至镜湖旁小市","author":"陆游","text":"久著朝衫负此湖，扁舟剩喜补东隅。\n市楼合乐醅新熟，寺壁残诗字欲无。\n常日不堪愁宛转，此行犹得笑须臾。\n夕阳鸥鹭皆相识，更觉人间是畏涂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8359,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泛舟泽中夜归","author":"陆游","text":"无穷烟海接空濛，秦望稽山醉眼中。\n虹断已收千嶂雨，鹤归正驾九天风。\n渔舟容与横沙际，水鸟号鸣傍苇丛。\n兴尽还家忽三鼓，半轮残月斗杓东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8360,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泛舟湖山间有感","author":"陆游","text":"我似人间不系舟，好风好月亦闲游。\n归来华表千年鹤，灭没烟波万里鸥。\n岁晚客貂那复叹，时艰嫠纬未忘忧。\n野人只欲安耕钓，江左夷吾可见不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8361,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泛富春江","author":"陆游","text":"双橹摇江叠鼓催，伯符故国喜重来。\n秋山断处望渔浦，晓日升时离钓台。\n官路已悲捐岁月，客衣仍悔犯风埃。\n还家正及鸡豚社，剩伴邻翁笑口开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8362,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泛湖","author":"陆游","text":"白鹭双飞导我前，自疑身是水中仙。\n放舟汉客樵风里，掷钓秦皇酒瓮边。\n山寺云间传讲鼓，渔家浦口起炊烟。\n个中得意君知否，买尽烟波不用钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8363,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泛湖至东泾三首 其三","author":"陆游","text":"细细桃枝竹，疏疏麂眼篱。\n雪霜烧葑夜，月露采菱时。\n腰斧登山早，移罾出浦迟。\n关心尽幽事，恨汝不能诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8364,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泛湖至东泾三首 其二","author":"陆游","text":"湖光分别浦，岭路过前村。\n泉石相萦带，云烟互吐吞。\n耕犁无易业，邻曲有通婚。\n试觅诛茆地，吾将遗子孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8365,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泛湖至东泾三首 其一","author":"陆游","text":"春水六七里，夕阳三四家。\n儿童牧鹅鸭，妇女治桑麻。\n地僻衣巾古，年丰笑语哗。\n老夫维小艇，半醉摘藤花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8366,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泛溪船至巴东","author":"陆游","text":"溪船莫嫌迮，船迮始相宜。\n两桨行何驶，重滩过不知。\n荒村寇相县，破屋屈平祠。\n不奈新愁得，啼猿挂冷枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8367,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"狂夫","author":"陆游","text":"狂夫与世本难谐，醉傲王侯亦壮哉。\n奕奕方收岩际电，酣酣已起枕间雷。\n回天力在人终叹，入月星来敌自摧。\n千载鬼雄皆国士，直令穷死未须哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8368,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"狂吟","author":"陆游","text":"浮世何须宇宙名，一狂自足了平生。\n秋风湘浦纫兰佩，夜月缑山听玉笙。\n学剑惯曾游紫阁，结巢终欲隐青城。\n年来自笑弥耽酒，百斛蒲萄未解酲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8369,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"社日","author":"陆游","text":"百谷登场酒满卮，神林箫鼓晚清悲。\n蝉依疏柳长言处，燕委空巢大去时。\n幼学已忘那用忌，微聋自乐不须医。\n伤心故里鸡豚集，父老逢迎正见思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8370,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"社饮","author":"陆游","text":"东作初占嗣岁宜，蚕官又近乞灵时。\n倾家酿酒无遗力，倒社迎神尽及期。\n先醉后醒惊老惫，路长足蹇叹归迟。\n西村渐过新塘近，宿鸟归飞已满枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8371,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"社饮","author":"陆游","text":"世上升沉一辘轳，古来成败几樗蒱。\n试看大醉称贤相，始信常醒是鄙夫。\n起舞非无垂白伴，暮归仍有髧髦扶。\n即今不乏丹青手，谁画三山社饮图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8372,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"社前一夕未昏辄寝中夜乃得寐","author":"陆游","text":"祠事当行惧不任，未昏强卧拥孤衾。\n三更自笑元无睡，万事从来忌有心。\n檐角河倾秋耿耿，床头虫语夜愔愔。\n若耶溪上蘋花老，倦枕何人听越吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8373,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"穷老","author":"陆游","text":"穷老宁须叹，吾生得已多。\n风埃弃朝帻，烟雨弄渔蓑。\n富屋乌爰止，闲门爵可罗。\n人生只此是，得酒且高歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8374,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"穷居","author":"陆游","text":"仕宦初何得，穷居半士农。\n清宵叔夜锻，平旦伯鸾舂。\n马磨犹支日，牛衣亦过冬。\n湖中有啸父，何计得相从。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8375,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"穷居","author":"陆游","text":"半世伥伥信所之，穷居仍抱暮年悲。\n烧金术误囊衣薄，种黍年凶酒味醨。\n大厦万间空有志，后车千乘更无期。\n掩书常笑城南杜，麻屦还朝授拾遗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8376,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"穷居","author":"陆游","text":"阨穷心自乐，寂寞道常尊。\n老病频辞客，嬉游不出村。\n淖糜均列鼎，徒步当华轩。\n不但终吾世，犹堪遗子孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8377,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"穷居","author":"陆游","text":"羸病无时已，穷居只自悲。\n巾偏非雨垫，衣弊岂尘缁。\n米尽时炊稗，樽空惯啜漓。\n逐贫虽有赋，乞食未成诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8378,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"穷居戏咏","author":"陆游","text":"赋分虽云薄，谋生亦自疏。\n但令书有种，敢恨食无馀。\n身病慵行立，庭荒废扫除。\n寒温虽泛礼，犹辱问何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8379,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"穷居有感","author":"陆游","text":"孤村烟草暮凄迷，笠子蓑衣自架犁。\n生计似蛛聊补网，弊庐如燕旋添泥。\n人亡耆旧多时学，地废陂湖失古堤。\n迂阔自知无著处，敢因穷厄怨推挤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8380,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"穷途","author":"陆游","text":"穷途多感慨，老境少知闻。\n酒里闲消日，书中自策勋。\n全躯希碌碌，扫轨厌纷纷。\n每愧吾乡老，头童念致君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8381,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"系舟平水步","author":"陆游","text":"舟尾参差野岸横，屐声穿市得闲行。\n雨昏茆店炊烟湿，人语蓬窗绩火明。\n枝上橙香初受摘，担头菰脆正堪烹。\n渔樵自是平生意，不为衰迟薄宦情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8382,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"系船","author":"陆游","text":"高树滴残雨，丛芦生夕风。\n惰游贫有自，老钝学无功。\n岁月诗编里，江湖旅色中。\n烟村系船处，邂逅得渔翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8383,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"纵步近村","author":"陆游","text":"病去身轻试杖藜，满村荞麦正离离。\n照溪自叹尚微瘦，趁渡人言殊未衰。\n草塞瓶头沽浊酒，花簪笠顶引群儿。\n裴回不恨归差晚，正爱青灯映竹篱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8384,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"纵笔二首 其一","author":"陆游","text":"冻研笑臞儒，雕弓隐猎徒。\n不成平赵魏，正可老江湖。\n憔悴头虽秃，轮囷胆尚粗。\n咸阳呼五白，何遽不能卢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8385,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"纵笔四首 其一","author":"陆游","text":"莫笑畸翁迫耄期，从来不许俗人知。\n系船惯听巴东雨，画策曾从渭北师。\n袖剑客同楼上醉，烂柯人看洞中棋。\n如今更欲沧溟去，鲸浪浮天信所之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8386,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"纵笔四首 其二","author":"陆游","text":"一点湛空明，居然万事轻。\n菜元胜肉食，车岂异徒行。\n幻境终何在，金丹本自成。\n信能如是解，土苴亦长生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8387,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"纵笔二首 其二","author":"陆游","text":"故国吾宗庙，群胡我寇雠。\n但应坚此念，宁假用它谋。\n望驾遗民老，忘兵志士忧。\n何时闻遣将，往护北平秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8388,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"纵笔四首 其三","author":"陆游","text":"拖得乌藤到处行，看山看水眼犹明。\n但期少健游潼华，岂必长生似老彭。\n一緉青鞋吾事了，半甔绿酒万缘轻。\n安知不作希夷叟，生长兵间老太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8389,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"纵笔四首 其三","author":"陆游","text":"薙草除枯叶，劳人亦动心。\n无愁疏把酒，习懒罢弹琴。\n濯垢临溪水，追凉就木阴。\n常寻省力处，外物孰能侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8390,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"纵笔二首 其一","author":"陆游","text":"天下本无事，吾生行且休。\n关心惟酒盏，入眼独渔舟。\n雁过三湘晓，云开二华秋。\n殷勤驿楼柱，小草记曾游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8391,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"纵笔三首 其一","author":"陆游","text":"老眼轻千乘，枯肠却八珍。\n直令身潦倒，未害胆轮囷。\n酒里遗浮世，书中见古人。\n平生笑园绮，老蹋帝城尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8392,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"纵笔","author":"陆游","text":"气本充天地，书非汗马牛。\n人人见尧舜，世世有巢由。\n朝市红尘闹，山村白发稠。\n所欣吾道在，江汉古东流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8393,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"纵笔三首 其三","author":"陆游","text":"行省当年驻陇头，腐儒随牒亦西游。\n千艘冲雪鱼关晓，万灶连云骆谷秋。\n天道难知胡更炽，神州未复士堪羞。\n会须沥血书封事，请报天家九世雠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8394,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"纵笔四首 其二","author":"陆游","text":"常笑相如赋上林，肯为子政铸黄金。\n心光自发谁能障，踵息无声不厌深。\n摇齿复牢堪决肉，枯颅再茁已胜簪。\n老松涧底虽终弃，霜雪元知不解侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8395,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"纵笔三首 其二","author":"陆游","text":"壮岁志天下，崎岖无一施。\n高谈对邻父，朴学付痴儿。\n补栅怜鸡冷，分粮悯雀饥。\n吾生忽至此，惆怅镜中丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8396,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"纵笔三首 其一","author":"陆游","text":"闲经月下白蘋洲，半脱风前紫绮裘。\n曾值东风谒鸾驾，却因南渡看龙舟。\n年光已付瞢腾醉，天宇谁从汗漫游。\n莫怪又成横笛去，故人期我玉华楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8397,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"纵笔","author":"陆游","text":"山合水将穷，真宜著放翁。\n醉嫌天地迮，老觉岁时公。\n偃蹇松逃世，翩仙鹤驾风。\n旧交零落尽，一笑与谁同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8398,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"纵笔四首 其一","author":"陆游","text":"兀兀一无为，冥冥百不知。\n倦多惟嗜睡，食晚遂忘饥。\n开卷浑如梦，逢人不省谁。\n何须觅知识，木石即吾师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8399,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"纵笔四首 其四","author":"陆游","text":"未说无功爵位叨，昔人所畏在功高。\n印如斗大宁常保，剑拄颐长祇自劳。\n酒社极知身可隐，猎场犹得气差豪。\n世间见透浑无事，狐貉安能诧缊袍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8400,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"纵笔三首 其三","author":"陆游","text":"天道何时定，人生固有涯。\n壮年行出塞，晚岁病还家。\n积愤凭谁豁，孤忠祇自嗟。\n今朝茅屋底，隐约听霜笳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8401,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"纵游","author":"陆游","text":"人事元知不可谐，名山踏破几青鞋。\n百钱挂杖无时醉，一锸随身到处埋。\n驿壁读诗摩病眼，僧窗看竹散幽怀。\n亦知诗料无穷尽，灯火萧疏过县街。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8402,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"纵游归泊湖桥有作","author":"陆游","text":"西蜀东吴到处游，千岩万壑独吾州。\n短篷载月娥江夜，小蹇寻诗禹寺秋。\n村酒可赊常痛饮，野人有兴即相求。\n何由唤得王摩诘，为画湖桥一片愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8403,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"芳华楼夜饮二首 其一","author":"陆游","text":"春风射雉苑城旁，走马还来入醉乡。\n夜暖酒波摇烛焰，舞回妆粉铄花光。\n浮生一笑常难必，此乐它年未易忘。\n莫作五陵豪侠看，奚奴归路有诗囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8404,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"芳华楼夜饮二首 其二","author":"陆游","text":"结客追游亦乐哉，城南城北古池台。\n香生赭汗连钱马，光溢金船拨雪醅。\n难觅长绳縻日住，且凭羯鼓唤花开。\n一春政使浑无事，醉到清明得几回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8405,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"芳华楼夜宴","author":"陆游","text":"射虎将军老不侯，尚能豪纵醉江楼。\n笙歌杂沓娱清夜，风露高寒接素秋。\n少日壮心轻玉塞，暮年幽梦堕沧洲。\n人间清绝沅湘路，常笑灵均作许愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8406,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"苏韬光节推挽歌词","author":"陆游","text":"才名京兆掾，门阀魏公孙。\n遇事虽肮脏，接人终静温。\n宁吟灞桥雪，不扫舍人门。\n二妙凋零尽，衰翁慨独存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8407,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"言怀","author":"陆游","text":"莫笑生涯似断蓬，向来诸侠避豪雄。\n报仇使气风尘里，吹竹弹丝锦绣中。\n乐事眼看成昨梦，倦游心伏作衰翁。\n论交尚喜筇枝在，白鹿泉边溯晚风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8408,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"识喜","author":"陆游","text":"本自怕沾京洛尘，固应不吐相君茵。\n偶逃鼍作鲸吞地，幸保诗狂酒病身。\n傲世曾歌楚人凤，著书久绝鲁郊麟。\n山村且试筇枝兴，风月秋来正一新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8409,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"识喜","author":"陆游","text":"齿摇徐自定，发脱却重生。\n意适簪花舞，身轻舍杖行。\n僧招决棋战，客让主诗盟。\n尚欲潇湘去，烟帆不计程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8410,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"识愧","author":"陆游","text":"几年羸疾卧家山，牧竖樵夫日往还。\n至论本求编简上，忠言乃在里闾间。\n私忧骄虏心常折，念报明时涕每潸。\n寸禄不沾能及此，细听只益厚吾颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8411,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]