[{"title":"二月十日","author":"谢翱","text":"山居少四邻，槠叶半为薪。\n野色生遥念，空江滞此身。\n风涛春忆越，亲旧晚游秦。\n独拟寻鸡犬，云萝挂葛巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36168,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"九日韶卿子善有约不至子静亦归桐庐与景云饮瀑下作","author":"谢翱","text":"揉蓝染钓缗，欲老此江滨。\n九日寒泉水，他年白发身。\n邻州曾约客，别业未归人。\n嗅菊知吾事，那能更问津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36169,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山阴道中呈郑正朴翁","author":"谢翱","text":"杨柳远天色，野风来水涯。\n异乡同梦客，今雨故人家。\n越树夜啼鸟，禹陵冬落花。\n悠悠江海意，为尔鬓先华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36170,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送毛耳翁之湘南","author":"谢翱","text":"湘草碧于水，王孙尚此留。\n一身行万里，双鬓集诸愁。\n月落岳云曙，龙逃海雨秋。\n可能无事业，相见竟悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36171,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寒食姑苏道中","author":"谢翱","text":"频年感烟草，荒冢几人耕。\n吴楚逢寒食，山村见独行。\n天阴月不死，江晚汐徐生。\n到海征帆影，悠悠识此情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36172,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"哭肯斋李先生","author":"谢翱","text":"落日梦江海，呼天野水涯。\n百年唯此死，孤剑托全家。\n血染楚花碧，魂归蜀日斜。\n能令感恩者，狼籍慰荒遐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36173,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"至日忆山中客","author":"谢翱","text":"山村云物外，至朔闰年愁。\n独客语茅屋，樵人共白头。\n驿花残楚水，烽火到交州。\n欲隐裂裳帛，春来重结裘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36174,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"怀峨眉家先生","author":"谢翱","text":"露下湿百草，病思生积愁。\n窟泉春洗屐，毡雪莫过楼。\n魂梦来巴峡，衣冠老代州。\n平生仗忠信，心自与身仇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36175,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"哭广信谢公","author":"谢翱","text":"自尔逃名姓，终丧哭水滨。\n海僧疑见貌，山鬼旧为邻。\n客死留衣物，囊空出告身。\n他年越乡值，卖卜有斯人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36176,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雨夜呈韶卿","author":"谢翱","text":"相看陇水云，一夕几回分。\n预恐今宵雨，他年独自闻。\n野花同楚越，江霭杂朝曛。\n不得锄芝朮，逢樵却寄君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36177,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"莫春感兴","author":"谢翱","text":"天涯芳草梦，此意未应泯。\n独对风烟老，虚为江海人。\n渔樵分落日，樱笋过残春。\n举世无知己，他生应逐臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36178,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋日忆过秦国公主园","author":"谢翱","text":"野影林柽尽，山昏瓦塔齐。\n凉宵风雨过，一雁西南啼。\n岚雾洗巾帨，井泉生蒺藜。\n伤心拂尘麈，衣泪湿空绨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36179,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送道士归赤松","author":"谢翱","text":"閒身可得仙，诸妄觉他年。\n夜气浮秋井，阴花冷碧田。\n礼星逢鹤下，咒食待人眠。\n叩齿通悬解，祠堂山影边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36180,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送僧之天台","author":"谢翱","text":"石桥南北路，师到动经旬。\n尊者定中影，凡人回去身。\n戴经支锡重，作礼纳巾频。\n杯海归何日，长眉问四邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36181,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪水","author":"谢翱","text":"寒英涨碧沉，浴鹄冷难禁。\n太白消秦日，中?接蜀阴。\n频汤清洗瘴，入茗味如参。\n人世淄渑口，应疑别未深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36182,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"用韵酬友人忆寄","author":"谢翱","text":"麻衣拂市尘，外事不干贫。\n野气生寒井，天阴压莫春。\n闲身分楚鞠，白发作吴人。\n已斸蘼芜径，青鞋忆寄频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36183,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"鼓子花","author":"谢翱","text":"尘湿西风泪，沟西影见君。\n碧衣羞远日，天梦冷秋云。\n蔓引山精径，篱依楚女坟。\n海边逢卖药，采实故应分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36184,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山寺送翁景芳归觐","author":"谢翱","text":"弱云竹水湄，叶影碧离离。\n野别如秋梦，他宵独尔思。\n林残西域果，钟动下方棋。\n可得朝还莫，相看长在兹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36185,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄朱仁中","author":"谢翱","text":"闻君经乱后，居处畏山颠。\n家在聚如客，粮馀食带烟。\n戍鸦分落日，烧草共残年。\n因忆先丘垄，于今是极边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36186,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"僧舍避暑分韵得入字","author":"谢翱","text":"故人隔天风，海水吹不立。\n聊将尘渴心，远赴山中汲。\n晴香芝菌生，暝翠雾露湿。\n唯应鸡犬深，幽林听经入。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36187,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游钓台","author":"谢翱","text":"古台临钓渚，遗像在苍烟。\n有客随槎到，无僧依树禅。\n风尘侵祭器，樵猎避兵船。\n应有前朝迹，看碑数汉年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36188,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"江上别友","author":"谢翱","text":"相看仍恸哭，欲学晋诸贤。\n戍近风鸣柝，江空雨送船。\n朔云侵别色，南雪忆归年。\n拟共锄青朮，无为俗事牵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36189,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"除夜闻雷","author":"谢翱","text":"牢落长为客，残年独拥衾。\n灯分寒夜火，雨过震馀阴。\n捣药滋玄发，书符狷黑祲。\n相看故乡泪，不敢效吴音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36190,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"元日枕流亭听雨","author":"谢翱","text":"征铎残年雨，吟听忆到城。\n愁云侵歙尽，梦日向吴生。\n药产难离性，滩流不掩声。\n他宵桦烛饮，因想此中行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36191,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春日寄书代乡人答","author":"谢翱","text":"沧江失钓缗，白社苦吟身。\n风雨他年别，干戈旧国贫。\n春祠占远梦，腊市忆行人。\n故垒夫差地，遥知哭为亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36192,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"人日雪","author":"谢翱","text":"连年逢此日，寂寞在山居。\n故国云归尽，高杉雪下初。\n阴霾占户口，雷电失天书。\n可得俱无事，清吟始晏如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36193,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"早春寄岭海流人","author":"谢翱","text":"短褐随南贾，衰年异壮游。\n龙旂虚左个，鸿影别中州。\n晚避高丽使，春乘百济舟。\n王孙与芳草，相忆可能留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36194,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过孙君文旧避地处","author":"谢翱","text":"相逢还自失，相见尽天涯。\n邻壤初移戍，空山此寄家。\n剪茸春过鹿，伐竹旧烧畬。\n去后馀荒槿，依沟结影斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36195,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春日迟子芳游乌龙山","author":"谢翱","text":"乌龙烟霭北，君去为亲留。\n綵舞初离席，音书缺寄邮。\n雨登人日冢，槎别客星洲。\n应有他宵约，相从及此游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36196,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"奉和毛益乱后经太白坟","author":"谢翱","text":"遥知风雨后，明月湿江蓠。\n几处如寒食，荒流空莫思。\n雨耕侵坏冢，春网得沈碑。\n若起论兹世，先生何所为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36197,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"忆过徐偃王祠下作","author":"谢翱","text":"徐王遗迹地，花落旧岩阿。\n山鬼下茅屋，野鸡啼苧萝。\n别祠江路见，疑冢草间多。\n寒食思家客，空村记所过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36198,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山驿送春","author":"谢翱","text":"逢春忆旧时，爱著旧春衣。\n雨别如知处，天涯应共归。\n驿花留客尽，帆日聚鸦微。\n岁岁子规鸟，寄巢于此飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36199,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"蜂","author":"谢翱","text":"蛹黑春如翳，寒崖举族悬。\n扑香粘絮落，采汗近僧禅。\n聚暗移花幄，分喧割蜜烟。\n闲房无处著，应架井泉边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36200,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雨中感怀","author":"谢翱","text":"幽斋蒲稗里，夜色入柴荆。\n坐久雨声绝，水深荷刺生。\n听猿思楚宿，失鹤梦南征。\n白屋青山下，何年返旧耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36201,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"桐华","author":"谢翱","text":"随风泊钓楂，弄日色侵霞。\n烧地不锄草，荒池旧沤麻。\n偶寻僧坐石，见落鸟衔花。\n饧粥春寒后，多逢楝树家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36202,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"僧池青蛙","author":"谢翱","text":"隐见多无定，时开一道萍。\n瘿分荷背白，身带藓文青。\n吐雹收寒井，随僧入净瓶。\n柏坛祠后稷，应想作龙灵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36203,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夜宿江山寺","author":"谢翱","text":"寺图接异境，僧影湿香烟。\n落月安禅处，翻经置县年。\n天河当夏白，泉水入杉悬。\n到此怀瓯越，空家寄海边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36204,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪榻瀑布","author":"谢翱","text":"漱石清尘暑，云深畏解携。\n寒岩萧寺下，县水薜阴西。\n鸟浴湿栖树，花流晴下溪。\n谪龙闻咒起，奇服反初笄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36205,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"虎石","author":"谢翱","text":"寺深留片石，山雨长苔新。\n昔日栖禅处，遗风想至人。\n锡前行虎独，钟后到猿频。\n越客因逃暑，于兹喜挂巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36206,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寺南小池","author":"谢翱","text":"寺南疏小沼，堤隐獭行踪。\n杉影动寒水，夕阳藏半峰。\n清涵落鸟毳，寒怯病僧容。\n闻说初开日，钵盂盛养龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36207,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夏夜山房会宿赋得竹禽","author":"谢翱","text":"入竹云初翳，馀更警露禽。\n羁雌迷故侣，凉意满西林。\n雨宿移枝暗，明翻下箨深。\n微吟触幽兴，离思不能任。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36208,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"中秋龙井玩月","author":"谢翱","text":"逢秋月再圆，不与复休眠。\n脑满鱼龙夜，精藏树石年。\n嗅衣腥在水，窥户影疑禅。\n长啸望参伐，行来精舍边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36209,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夜坐呈韶卿","author":"谢翱","text":"修行吴楚间，鹤去杳难攀。\n衰世已如此，愁身更入山。\n巢居避太岁，药饭救羸颜。\n故友在江海，相思不得还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36210,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"韶卿往乌伤寄刘元益","author":"谢翱","text":"他日忆逢君，林中访惠勤。\n鹿麛行处见，流水别时闻。\n草没秦人冢，山通越国云。\n音书年岁失，莫讶白鸥群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36211,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄赠王佥判龙泽新之官广陵","author":"谢翱","text":"多君孝子里，云物尚依然。\n岁晏木叶下，月明湖水边。\n看图须女分，对策亮阴年。\n到此若为别，犹言赠马鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36212,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十日菊寄所思","author":"谢翱","text":"篱菊是秋邻，青蕤几日新。\n忽逢初过节，相忆早衰人。\n囊枕离湘湿，分杯度岭贫。\n想应无事业，遥念更沾巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36213,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"野霞观瀑","author":"谢翱","text":"他年疏上浮，早日此中投。\n汲饮当鱼入，垂纶即?游。\n净祠无血食，噀雨不腥流。\n僧语皆前事，人来尽别州。\n草谙长过雪，沙犯欲捐湫。\n至竟何依止，苍茫难祷求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36214,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"己丑除夜","author":"谢翱","text":"鬓丝残雪影，况复在尘埃。\n暮色随钟尽，年光逐水来。\n邻逋灯下索，乡梦戍边回。\n明日听春雨，渡江登越台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36215,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"元旦立春","author":"谢翱","text":"椒柏多年树，闲庭忆粤乡。\n发春当献岁，为客未休粮。\n饮后怜衰齿，行南避忌方。\n星周元朔历，时运可能忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36216,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寒食同方行父明中往渌渚舟中作寄东安方子仁","author":"谢翱","text":"自食屿云薇，闻君白接篱。\n谒灵随社到，为客寄音迟。\n瓢入新城水，舟回故渚祠。\n南衣离火浣，垢敝禁烟时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36217,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"万松道中望南太白","author":"谢翱","text":"笋舆行万山，中有十里亭。\n老树祇一色，野公逾百龄。\n柴关当太白，药气近樵青。\n罔草粘枯翼，巢枝落退翎。\n期探幽谷水，共斸松根苓。\n艾纳下天雨，尘风吹冥冥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36218,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雨宿太白","author":"谢翱","text":"城中家斧冰，此地绝炎蒸。\n天食青童捧，龙居白气升。\n暗灯犹宿火，寝服尚衷缯。\n客话从前事，书传入内僧。\n风流今独尽，云物老相仍。\n净榻搜凉卧，危阑入醉凭。\n雨师行下界，鸟梦识中乘。\n明发甬南去，他山逢智弘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36219,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄育王贤上人","author":"谢翱","text":"于今祇老身，从昔少埃尘。\n失蜀年为客，居山石作邻。\n南游宗竺法，西语问巴人。\n开户藤花落，多浮茗椀春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36220,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"海亭夜坐","author":"谢翱","text":"孤身滞海垠，暑溽上南云。\n归日喜秋近，愁人畏夜分。\n坐凉依井气，眠湿动星文。\n故友在山北，音书不得闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36221,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夜宿雪窦上方","author":"谢翱","text":"眠山枕斧柯，独客爱盘阿。\n畏日生尘梦，寻仙到鸟窠。\n下方闻夕磬，南斗挂秋河。\n寝服侵云卷，颒泉通瀑和。\n窦分沧海月，禅入沃洲歌。\n此地精灵聚，中宵弄薜萝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36222,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"鲁国图诗","author":"谢翱","text":"秋风岳下城，海客见图新。\n树入舞雩里，水来浮磬滨。\n东封馀辇路，西狩问虞人。\n被发逢夫子，狂歌作放民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36223,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"董孝子墓","author":"谢翱","text":"修修古孝子，家移来水旁。\n母病食此水，母死葬其乡。\n杀人自白吏，就家起为郎。\n至今庙下草，犹带食水香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36224,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"重过二首 其一","author":"谢翱","text":"复道垂杨草欲交，武林无树著凌霄。\n野猿引子移来住，覆尽花枝翡翠巢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36225,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"重过二首 其二","author":"谢翱","text":"隔江风雨动诸陵，无主园池草自春。\n闻说就中谁最泣，女冠犹有旧宫人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36226,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"野望","author":"谢翱","text":"心游太古后，转觉此生浮。\n天外知何物，山中著得愁。\n岸花低草色，潮水逆江流。\n消尽盈虚里，令人白尽头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36227,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"无题","author":"谢翱","text":"天风下黄叶，山树挂绿蓑。\n世情逐流水，东去无回波。\n可与语人少，不成眠夜多。\n湿云黏短发，漂泊奈愁何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36228,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春闺词","author":"谢翱","text":"手触残红头懒梳，香随蝴蝶上衣裾。\n暖风吹睡无言语，又向床头看梦书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36229,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"四皓","author":"谢翱","text":"冷却秦灰鬓已翁，紫芝歌罢落花风。\n若教一出无遗恨，莫入留侯准拟中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36230,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"散发","author":"谢翱","text":"乾坤一楚囚，散发向沧洲。\n诗病多于马，身閒不似鸥。\n因看东去水，都是夜来愁。\n晚意落花觉，残枝香更幽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36231,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"友人自杭回建寄别三首 其一","author":"谢翱","text":"同来不同去，离别暗销魂。\n闽浙若同水，遍舟送到门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36232,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"友人自杭回建寄别三首 其二","author":"谢翱","text":"潮信到岩濑，水色过衢城。\n寄潮不寄水，潮去有回程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36233,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"友人自杭回建寄别三首 其三","author":"谢翱","text":"水到衢城尽，梅花上岭生。\n不如寄明月，步步送君行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36234,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"孤山","author":"谢翱","text":"又冒晴丝向水涯，寒云冉冉护巾纱。\n能知绿鬓几回至，欲行黄冠此处家。\n已把掖垣等茅舍，不愁封禅对梅花。\n晚风吹袂过船去，看鹤上天冲碧霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36235,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪","author":"谢翱","text":"片片知何似，无根零乱花。\n任随飞到处，不拣是谁家。\n缝密天如翳，擎深树半斜。\n城中新酒贵，羁旅若为赊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36236,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"画秦宫人","author":"谢翱","text":"结草为衣类鹤翎，初来一味服黄精。\n宫莺几处衔花出，犹向山中认得声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36237,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"织妇叹","author":"谢翱","text":"待得?蚕茧上丝，织成送女去还归。\n支机本是寒砧石，留取秋深自捣衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36238,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]