[{"title":"和范迁善见寄三首 其三","author":"吴芾","text":"新诗劳远寄，深识子怜余。\n句法追元白，交情笑耳馀。\n飘零疏酒盏，离乱足兵车。\n何日相从去，白云深处居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43860,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和范迁善见寄三首 其二","author":"吴芾","text":"平生誇志气，妄意语功名。\n自顾心无歉，谁知道不行。\n霜蹄从暂蹶，嘉木会重荣。\n愿守焚舟志，他年学孟明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43861,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和范迁善见寄三首 其一","author":"吴芾","text":"苍生未苏息，谁与任安危。\n腾蹋思千里，栖迟尚一枝。\n谩劳男子志，空忆太平时。\n读罢君诗句，愁端愈上眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43862,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和范希孟韵","author":"吴芾","text":"急隐归来趣转深，静中不放一尘侵。\n日长宴坐风敲竹，夜久澄心月满林。\n诗句每从佳境得，酒杯长为故人斟。\n时危莫用计然策，身在五湖空铸金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43863,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和采石诗韵寄韩无咎","author":"吴芾","text":"野性从来爱水云，合耕岩下钓溪滨。\n宦游愧负平生志，临按欣逢我辈人。\n奎阁雄文光照日，锦囊佳句艳争春。\n外台况上三年计，一节行看诏墨新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43864,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和金克孝韵","author":"吴芾","text":"天公放我作閒人，宠辱无缘到我身。\n浊酒兴来宁惜醉，小园日涉不嫌频。\n祇知丘壑追元亮，敢望京师说子真。\n渐近青春尤可乐，有花如锦草如茵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43865,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和金克孝韵","author":"吴芾","text":"长嗟轩冕累吾身，幸得归来见此君。\n晚出渔樵呼作伴，行随鹿鹤与同群。\n浮光喜踏山前月，弄影贪看水底云。\n还有江梅通信息，一枝暗里递清芬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43866,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和昝通彦早梅韵","author":"吴芾","text":"岁岁梅花破腊开，赏花尝记坐苍苔。\n今年似觉寒犹未，昨夜不知春已回。\n喜有暗香供雅客，可无佳句助深杯。\n须知不比闲桃李，莫把金刀取次裁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43867,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和津喜雪二首 其二","author":"吴芾","text":"我爱平湖绕碧山，山光倒碧到樽前。\n同云何事迷千嶂，飞雪俄然蔽一川。\n纵使玉楼从地涌，便教银阙与天连。\n到头幻化非真实，争似湖山耐岁年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43868,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和津喜雪二首 其一","author":"吴芾","text":"六花一夜降中天，飞绕吾庐顿满前。\n幻出仙家新窟宅，疑非尘世旧山川。\n但惊岩上青松老，不见天边白雁连。\n赖有瓮头新酿熟，何妨沉醉度残年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43869,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和胡宗泽见寄 其二","author":"吴芾","text":"故人皮里贮阳秋，爱我身如不系舟。\n羞向人间为谄首，喜来林下作遨头。\n虽无仙骨能骑鹤，尚有閒心可狎鸥。\n乘兴惠然时过我，一樽相对笑言稠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43870,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和胡宗泽见寄 其一","author":"吴芾","text":"湖边策杖步新晴，陡觉胸襟万虑平。\n老去不须防意马，静中已是息心兵。\n閒来绿树阴中坐，懒去红尘闹里行。\n赖与故人供一醉，不辜今夜月华明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43871,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和胡经仲即事二首 其二","author":"吴芾","text":"雨脚转前湾，烟蓑带雨还。\n清诗陶野色，薄酒散愁颜。\n檐鸟下苔径，溪云媚屋山。\n世途方扰扰，谁得似君闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43872,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和胡经仲即事二首 其一","author":"吴芾","text":"世事凭谁论，羁怀只自谙。\n风烟悲蜀魄，桑柘老吴蚕。\n晚步惜残照，春衫怯晓岚。\n日来鼙鼓近，牢落愈无堪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43873,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和赵观使喜雨","author":"吴芾","text":"膏泽愆时愧已深，敢期诚意达天垠。\n片云忽送千峰雨，一气潜回万壑春。\n顿觉老农生喜色，坐令凶岁变佳辰。\n忧民虽切功何有，坱圠无私荷大钧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43874,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和闾丘省干喜雨韵 其二","author":"吴芾","text":"铃斋坐啸不为颇，愁叹翻然变咏歌。\n千里正忧无旧谷，一朝俄喜浃新禾。\n云师蔽日如张帜，雨阵横空似拥戈。\n我忝郡丞何所补，但将新句对松哦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43875,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和闾丘省干喜雨韵 其一","author":"吴芾","text":"良田方苦莠骄骄，甘雨如何閟九霄。\n贤守治声喧道路，圣君德泽播黎苗。\n宁容赤地炎威炽，果见青天旱气消。\n昨夜东皋已沾足，康衢满耳沸歌谣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43876,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和闾丘莘叟","author":"吴芾","text":"此时狂敌合灰飞，致我天王下紫微。\n士马生风增锐气，旌旗蔽日耀皇威。\n愧无一策裨黄屋，滥逐千官扈赭衣。\n智略如君宜有用，周行指日看来归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43877,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和逐年九日阳字韵","author":"吴芾","text":"天上恩来解郡章，人间那复是重阳。\n老身已许归三径，佳节何妨醉百觞。\n但有笑容生面目，更无閒事挠心肠。\n旁人不信吾归去，今日真成返故乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43878,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和郭教授立春除夜之作二首 其二","author":"吴芾","text":"意广才高困谤伤，又还客里换年光。\n驱驰道路风霜苦，放荡江湖日月长。\n纵未致身登凤阁，也应平步入鹓行。\n胡为尚郁骞腾志，无地栖迟寄寺廊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43879,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和郭教授立春除夜之作二首 其一","author":"吴芾","text":"儿童争喜岁时新，老去方知感此辰。\n始具杯盘来送腊，又簪幡胜去鞭春。\n满斟蕉叶休辞醉，且对桃花痛饮醇。\n况有故人能过我，相看岁晚更情亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43880,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和钱倅秋晚登帢帻亭","author":"吴芾","text":"满目悲凉意，凭谁断送秋。\n寻僧求竹舍，俯槛得江流。\n天末高低雁，波间出没鸥。\n时危身局促，却羡汝无愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43881,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和陶读山海经十三首韵送机简堂自景星岩再住隐静 其七","author":"吴芾","text":"扶疏岩下树，入夏总成阴。\n几年荆棘地，一旦为丛林。\n我方与衲子，共听海潮音。\n人生多聚散，离别忽惊心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43882,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和高簿 其二","author":"吴芾","text":"家家门外与墙头，叠足排肩看我游。\n出郭不应祇独乐，劳农端欲与同忧。\n偶逢佳处宁空过，纵迫归时亦暂留。\n惭愧高轩远相过，聊持杯酒当茶瓯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43883,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和高簿 其一","author":"吴芾","text":"不惮驱驰半驿间，劝耕聊复到禅关。\n耳根暗泻潺潺水，眼界横陈叠叠山。\n已喜新来春事好，还嗟老去世涂艰。\n洪崖幸尔心相契，此后何妨数往还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43884,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和梁大谏望亭述怀","author":"吴芾","text":"屡试乘轺与把麾，笑谈自可解重围。\n暮年强健人争羡，平日刚方世所稀。\n国步尚艰端有赖，君恩方渥未须归。\n时清益展经纶手，直上岩廊秉政机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43885,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和梁次张得酒之作","author":"吴芾","text":"在处人争馈五浆，风标端是紫微郎。\n已能遣兴追工部，更欲消忧对杜康。\n阐教暂烦临水泮，趋朝行见裛天香。\n老夫素乏惊人句，徒叹辞锋未易当。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43886,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和梁次张韵","author":"吴芾","text":"妙龄才藻擢文犀，声价何须待品题。\n独狍孤衷长拱北，拟摅妙画欲平西。\n五年不见心如渴，一笑相逢醉似泥。\n我老已为林下计，看君平步上云梯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43887,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和章德文侍郎题晞浣堂韵寄张法师","author":"吴芾","text":"丹成人去几经年，怪石峻嶒树曲拳。\n超脱每思攀逸驾，沉迷无奈缚尘缘。\n胜游徒有骚人咏，绝景难凭妙笔传。\n投绂归来应未晚，尚期一访洞中仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43888,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和隐老咏梅韵","author":"吴芾","text":"不惮行行雪满巅，要看与雪斗清妍。\n开花虽在三冬杪，结子还居万木先。\n水浅横斜聊自见，夜寒幽独有谁怜。\n君诗况与梅相亚，传写惭无十样笺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43889,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和黄作霖董伯玉东山岭上及崇相沙头会饮二首 其二","author":"吴芾","text":"杖藜寻古寺，把酒俯长流。\n节物尚三月，风流似十洲。\n且看花满眼，休说锦缠头。\n但得陶陶醉，何妨守旧丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43890,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和黄作霖董伯玉东山岭上及崇相沙头会饮二首 其一","author":"吴芾","text":"寒日传佳节，联镳出近坰。\n预忧宾骑散，欲驻日车停。\n坐上人颓玉，灯前酒尽瓶。\n但知修故事，三日不能醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43891,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和曾吉甫九日","author":"吴芾","text":"龙山陈迹已成灰，尚忆当年戏马台。\n我幸偶陪黄菊醉，君应亦向白衣来。\n风高日朗三秋霁，野旷天清万象开。\n好对良辰成乐事，若为不饮竟空回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43892,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和曾吉甫四明见寄二首 其二","author":"吴芾","text":"风烟浩荡甬东州，方羡公为烂漫游。\n岂料连宵垂雨脚，未容杲日出云头。\n扶藜登眺心应在，隐几吟哦趣更幽。\n遥想乍晴须痛赏，诗成还肯寄来不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43893,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和曾吉甫四明见寄二首 其一","author":"吴芾","text":"老矣何堪剖竹符，频年强出应时须。\n腰间谩佩买臣印，月下同游贺老湖。\n白雪已知人寡和，清风还忆醉相扶。\n十洲三岛登临处，能记稽山病守无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43894,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和曾吉甫寄韵呈李相之二首 其二","author":"吴芾","text":"早已相从海上州，朅来鉴水又同游。\n驱驰官路俱华发，缱绻交情异白头。\n公即横翔层汉去，我将归卧故山幽。\n连宵月色如明昼，乘兴还能过我不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43895,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和曾吉甫寄韵呈李相之二首 其一","author":"吴芾","text":"千龄景运适相符，况复才华世所须。\n腾蹋自应登馆殿，滞留谁谓尚江湖。\n从来太瘦缘诗苦，想见闲行信杖扶。\n闻道朝来病良愈，高轩还解出门无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43896,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和紫岩老雪中观梅","author":"吴芾","text":"清寒池馆静沉沉，惨淡江梅弄晚阴。\n雪里有谁能载酒，花前无语自伤心。\n低枝似欲迎人笑，清赏何妨倚树吟。\n况有争妍佳句在，愈撩诗思不能禁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43897,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和董伯玉读当涂小集","author":"吴芾","text":"昔时乘障楚江边，信笔题诗度岁年。\n岂敢嘲风仍咏月，祇思问舍与求田。\n归心虽似陶元亮，句法宁窥孟浩然。\n多谢君诗过褒拂，愈令惭汗出如泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43898,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和董伯玉韵","author":"吴芾","text":"野性耽閒昼掩扉，坐看斜日上书帷。\n不妨挟册从吾好，亦学吹竽笑昨痴。\n鬓发星星行且老，胸襟碌碌苦亡奇。\n与君正欲论心事，又恐分携各一涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43899,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和蒋无退怀湖山","author":"吴芾","text":"多谢君恩许引年，容亲白石与清泉。\n不来山下寻诗社，即向湖中棹酒船。\n意适更穿花坞去，兴阑还傍竹林眠。\n那闻高士飘然句，陡觉身轻似得仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43900,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和蒋无退咏雪","author":"吴芾","text":"腊中三白几年无，今岁呈祥事可书。\n披得一蓑方入画，翻成双带又随车。\n共惊飞絮迷清昼，更觉同云满太虚。\n忆昔读书灯火少，喜穿窗牖映吾庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43901,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和蒋宣卿韵 其二","author":"吴芾","text":"不将有限逐无涯，聊为寻幽驻使华。\n千古山川埋剑气，半空台阁雨天花。\n终期香火参同社，且赋新诗寄作家。\n归晚不须添列炬，预愁惊散暮林鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43902,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和蒋宣卿韵 其一","author":"吴芾","text":"丐闲章上早知还，卓荦高风岂易攀。\n阔步未归龙尾道，胜游先到虎丘山。\n千寻古木轩窗外，一缕沉烟几席间。\n况是登临有佳客，何妨终夕对孱颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43903,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和道叟韵","author":"吴芾","text":"自怜涉世太迂疏，岂料今朝得自如。\n老去不知官况好，归来顿觉道心舒。\n湖山深处非凡景，松竹阴中有旧庐。\n静坐忽闻乌鹊喜，开门还得故人书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43904,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和韩子云见寄二首 其二","author":"吴芾","text":"世态无常似暮霞，人生难久类春花。\n已堪入谷携樵斧，还好临湖把钓车。\n对酒未能忘酒伴，哦诗尤更忆诗家。\n何由会面论心曲，两地相望天一涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43905,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和韩子云见寄二首 其一","author":"吴芾","text":"投绂归来意适然，从今免咏式微篇。\n但令晚岁胸中适，安用虚名身后传。\n顾我只宜乘载月，如君端合上凌烟。\n功成或欲寻真去，莫惜驭风来揖仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43906,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和韩子云见寄四首 其四","author":"吴芾","text":"当时邂逅已心倾，别后逢人问去程。\n顾我拙疏非世用，喜君明悟自天成。\n十年不见怀芝宇，一笑相逢付曲生。\n暂尔就闲宜自爱，上方着意擢豪英。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43907,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和韩子云见寄四首 其三","author":"吴芾","text":"有花须折酒须倾，少日追欢不计程。\n老去自怜心易懒，时过还恐道难成。\n城头又是暮云合，江上何时春水生。\n早理扁舟归去好，故园犹有万红英。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43908,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和韩子云见寄四首 其二","author":"吴芾","text":"日在桑榆势欲倾，此时那可更贪程。\n屡凭熊轼惭无补，新葺燕巢欣有成。\n便好弃官还故里，不妨把酒乐馀生。\n经纶事业须公等，看即持荷侍迩英。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43909,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和韩子云见寄四首 其一","author":"吴芾","text":"郁郁愁怀不自倾，时时倒指勘归程。\n情知岁月来无几，心着湖山去未成。\n恶语岂能赓绝唱，故人聊欲话平生。\n颇思共索梅花笑，点检枝头半吐英。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43910,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和韩子云韵留沈子寿","author":"吴芾","text":"一雨连宵继日倾，岂容吾子语归程。\n我为千里政方暇，子寓三年学已成。\n要把老怀倾倒尽，忍令别恨等闲生。\n江城先自伤牢落，况失一时人物英。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43911,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和鲁季钦别后寄","author":"吴芾","text":"盍簪经岁遽分襟，夜夜相思梦里寻。\n寄远正惭无好语，开缄忽喜得高吟。\n感君不替绸缪意，使我还销鄙吝心。\n他日相逢重把酒，莫辞蘸甲十分深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43912,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和鲁宪见寄","author":"吴芾","text":"一笑同登卷雨楼，相欢曾记昔年不。\n几凭诗句论心曲，屡折花枝作酒筹。\n醉里忘形俱可乐，别来握手两无由。\n何时倾倒还如旧，月下花前恣献酬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43913,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和鲁宪见寄二首 其二","author":"吴芾","text":"向来三老楚江滨，一笑相欢气味真。\n君向越溪持使节，我归台岭作閒人。\n颇思花下酒无算，尚记诗成笔有神。\n何日轺车能过我，开怀一洗渴心尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43914,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和鲁宪见寄二首 其一","author":"吴芾","text":"厌直承明老从臣，不将人事挠天真。\n几年欲作山中相，今日得为林下人。\n竹里醉吟聊遣兴，水边宴坐足怡神。\n回思当日游从地，过眼浑如陌上尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43915,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和鲁漕节中见示","author":"吴芾","text":"天时又是一番新，顾我犹为逆旅人。\n诗酒情怀聊自遣，山林志愿几时伸。\n羡君职事有馀暇，赠我篇章不厌频。\n一读洒然忘鄙吝，浑胜笑语得相亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43916,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和鲁漕春雨有感三首 其三","author":"吴芾","text":"我心虽老尚如童，春到惟思笑语同。\n正欲对花歌且舞，那知通夕雨兼风。\n千畴固喜俱沾足，百卉还愁一扫空。\n安得晴天开万里，缓行花下豁胸中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43917,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和鲁漕春雨有感三首 其二","author":"吴芾","text":"自叹苍颜不复童，幸然三老此时同。\n登高能赋多佳咏，把酒论文有古风。\n可恨雨师频作恶，直疑春事遂成空。\n愁来不用殷勤劝，已判花前为一中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43918,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和鲁漕春雨有感三首 其一","author":"吴芾","text":"自怜齿豁与头童，心事都非少壮同。\n那更闭门听夜雨，不容步屧趁东风。\n胜游尚喜朋簪盍，痛饮宁辞酒盏空。\n只恐酒醒归兴动，愈令倦客忆山中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43919,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和鲁漕喜雨二首 其二","author":"吴芾","text":"秋来日日困骄阳，正欲斋心问彼苍。\n倏尔四郊云气合，霈然一夜雨声长。\n三农已有仓箱庆，万室还欣枕簟凉。\n幸值故人来过我，尊前莫惜醉淋浪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43920,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和鲁漕喜雨二首 其一","author":"吴芾","text":"冬暖曾无欲雪天，正忧饥馑在新年。\n忽闻夜滴檐前雨，便觉春归郭外田。\n千里已知俱乐只，一尊亦拟共陶然。\n其如使者拘台制，不肯花间听管弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43921,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和詹守二首 其二","author":"吴芾","text":"特迂千骑访柴门，多谢清朝皂盖臣。\n肯为衰翁留竟日，顿令寒谷暖生春。\n论心便觉尘襟豁，刮目仍观妙句新。\n转盼又还成远别，相思后夜定伤神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43922,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和詹守二首 其一","author":"吴芾","text":"一日相逢喜有馀，对谈胜读十年书。\n欢声已溢枌榆社，和气还蒸蓬荜居。\n敢道高标攀靖节，或疑胜致到华胥。\n愿言莫惜留连醉，看我东皋带雨锄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43923,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]