[{"title":"偈颂六十五首 其五十五","author":"释咸杰","text":"今朝三月十五，天色半晴半雨。\n十分春色在枝头，满眼觑见没可睹。\n报诸人，莫莽卤，甜瓜彻蒂甜，苦瓠连根苦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16234,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十五首 其五十四","author":"释咸杰","text":"一手不独拍，两手鸣掴掴。\n豁开三要三玄，捏碎佛祖标格。\n村歌社舞得人憎，胜似当年白拈贼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16235,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十五首 其五十三","author":"释咸杰","text":"持钵去，持钵归。\n草鞋根断通消息，玲珑八面尽光辉。\n游魔宫，入虎穴。\n当机撞著恶聱头，直教心地顿休歇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16236,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十五首 其五十二","author":"释咸杰","text":"虚空可量风可系，无能尽说佛功德。\n佛功德海既难量，吾君圣寿亦如是。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16237,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十五首 其五十一","author":"释咸杰","text":"四月十五日结，七月十五日解。\n六只骰子满盆红，大都只是看头米。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16238,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十五首 其四十九","author":"释咸杰","text":"有佛处，不得住，陕府铁牛双角露。\n无佛处，急走过，南海波斯鼻孔大。\n三千里外摘杨花，种豆由来生稻麻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16239,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十五首 其四十八","author":"释咸杰","text":"五月五日端午节，阴云叆叇，甘雨未决。\n君王降赐宝香，林下祈求恳切。\n孚祐龙，善时节，好将一雨润焦枯，匝地清凉消恼热。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16240,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十五首 其四十六","author":"释咸杰","text":"油煎石磉盘，风吹毛毬走。\n虚空背上白毛生，拈得鼻孔失却口。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16241,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十五首 其四十三","author":"释咸杰","text":"六月炎炎如火热，谁知冷处胜冰雪。\n红尘闹市等个人，七佛轨仪都漏泄。\n报龙王，须福护，大千捏聚为檀度。\n一言劄住万机通，自然光壮少林风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16242,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十五首 其四十一","author":"释咸杰","text":"佛法无人说，虽慧不能了。\n去却上头关，面南看北斗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16243,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十五首 其四十","author":"释咸杰","text":"今朝十五日，丛林皆结制。\n径山有条攀条，无条攀例。\n逼拶露柱灯笼，尽要心空及第。\n现前普请證明，不妨神通游戏。\n下座各叙时暄，便是灵山受记。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16244,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十五首 其三十九","author":"释咸杰","text":"一手不独拍，众手鸣掴掴。\n豁开三要三玄门，堪与人天为轨则。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16245,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十五首 其三十六","author":"释咸杰","text":"拳来拳应，踢来踢应。\n拳踢交参，孰负孰胜。\n摇头摆尾过牢关，刖足之言谁肯信。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16246,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十五首 其三十五","author":"释咸杰","text":"秋江清浅时，白鹭和烟岛。\n良哉观世音，全身入荒草。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16247,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十五首 其三十四","author":"释咸杰","text":"利剑斩虚空，万象鸣嚗嚗。\n年年向斯辰，令人倍发恶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16248,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十五首 其三十二","author":"释咸杰","text":"狮子教儿迷子诀，拟前跳掷早翻身。\n罗纹结角交锋处，鹘眼临时失却踪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16249,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十五首 其三十","author":"释咸杰","text":"一切数句非数句，与吾灵觉何交涉。\n毒蛇钻入你鼻孔，虾蟆咬破你眼睛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16250,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十五首 其二十九","author":"释咸杰","text":"虽与我同条生，不与我同条死。\n稔闻在七闽，扬尘兼簸土。\n凌茂宗风不奈何，今朝喜见清平路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16251,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十五首 其二十七","author":"释咸杰","text":"一叶落，天下秋，南来北往竟悠悠。\n一句通，万机息，上下四维无等匹。\n西天人不会唐言，独坐少林痴面壁。\n带累儿孙不丈夫，被人唤作白拈贼。\n云门念七好参详，宝公不是闲和尚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16252,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十五首 其二十六","author":"释咸杰","text":"月生一，万像不能逃影质。\n月生二，东行不见西行利。\n月生三，无言童子口喃喃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16253,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十五首 其二十五","author":"释咸杰","text":"今佛放光明，助发实相义。\n希有诸比丘，是中难比况。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16254,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十五首 其二十四","author":"释咸杰","text":"诸佛不说说，祖师不闻闻。\n留下一转语，千古镇乾坤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16255,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十五首 其二十三","author":"释咸杰","text":"因我得礼你，穷源亲到底。\n礼拜了烧香，自倒还自起。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16256,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十五首 其二十二","author":"释咸杰","text":"生铁铸牛头，牵犁还拽杷。\n智者笑忻忻，愚人惊怪差。\n古往今来几百年，更向鬼门重贴卦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16257,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十五首 其二十一","author":"释咸杰","text":"贤劫千佛数，末后最慇勤。\n倒握降魔杵，高标利物拳。\n心肝无屈曲，肠胃有区分。\n神通愿力虽无尽，且为山僧护法门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16258,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十五首 其二十","author":"释咸杰","text":"元正一旦，万事成办。\n大乘小乘，井索钱贯。\n更问佛法如何，也是秦时?轹钻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16259,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十五首 其十九","author":"释咸杰","text":"日南长至，庆无不利。\n石笋暗抽条，寒岩增暖气。\n东村王老半醉半醒，林下道人没巴没鼻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16260,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十五首 其十八","author":"释咸杰","text":"一新一旧，跳出窠臼。\n一出一入，胡饼里呷汁。\n一擒一纵，开眼作梦。\n一照一用，鳝鱼走入麻油瓮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16261,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十五首 其十七","author":"释咸杰","text":"月生一，无角铁牛眠少室。\n月生二，赤脚波斯入闹市。\n月生三，冰生于水，青出于蓝。\n文殊堂里万菩萨，夜来尽向此中参。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16262,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十五首 其十六","author":"释咸杰","text":"静悄悄处跳得出，闹浩浩处可横身。\n闹浩浩处挨得行，静悄悄处堪驻足。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16263,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十五首 其十五","author":"释咸杰","text":"在眼曰见，在耳曰闻。\n在手执捉，在足运奔。\n豁开则东西南北，把住则毫发不存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16264,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十五首 其十","author":"释咸杰","text":"乌巨今日解夏，乃遵黄面老子二千年前话霸。\n验蜡人彻底冰清，护戒珠了无缝罅。\n唯有露柱灯笼，不肯入遮保社。\n从来心似铁，端不受差排。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16265,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十五首 其十四","author":"释咸杰","text":"少室单传，衲僧巴鼻。\n碓觜生花，驴鸣狗吠。\n厕坑筹子念摩诃，惊起法身无处避。\n无处避，若为论，我行荒草里，汝又入深村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16266,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十五首 其二","author":"释咸杰","text":"满目纷纷呈瑞雪，填沟塞壑谁辨别。\n文殊无处顿浑身，普贤失却真妙诀。\n乌鸦变作白头鸦，铁树翻成银线结。\n报诸人，瞥不瞥，庭际无人立片时，便是太平底时节。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16267,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十五首 其一","author":"释咸杰","text":"一进一退，一动一静，须信那伽常在定。\n一擒一纵，一杀一活，四方八面活鱍鱍。\n嘉州大象吃盐多，陕府铁牛添得渴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16268,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四首 其三","author":"释咸杰","text":"眼里耳里绝纤尘，铁眼铜睛觑不破。\n蚊子排头咬铁钉，上下四维俱匌匝。\n只将此语报深恩，朵朵红莲火里发。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16269,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四首 其二","author":"释咸杰","text":"山河大地不是幻，日月星辰不是幻。\n明暗色空不是幻，四圣六凡不是幻。\n山僧说底不是幻，诸人听底不是幻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16270,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四首 其一","author":"释咸杰","text":"释迦不说说，迦叶不闻闻。\n天河风浪静，星斗位区分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16271,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"隆报著长老请赞","author":"释咸杰","text":"据虎头，收虎尾，第一句下明宗旨。\n了无禅道与人参，滴水便见波澜起。\n太醒醒，难比拟。\n分付隆报著长老，好向丛林振纲纪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16272,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人请赞 其二","author":"释咸杰","text":"天无私盖，地无私载。\n如何形容，生此奇怪。\n为僧不禀僧仪，学佛力破佛戒。\n鼓舌摇唇，丛林殃害。\n若无伽梨裹浑身，便是当年屈突盖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16273,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人请赞 其一","author":"释咸杰","text":"五戒不持，威仪破尽。\n空腹高心，言不足信。\n徒将朽木乱涂糊，衲僧添得膏肓病。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16274,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人请赞 其六","author":"释咸杰","text":"德山临济，棒喝交驰。\n云门顾鉴，总是愚痴。\n唯有径山无伎俩，握拳端坐眼如眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16275,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人请赞 其五","author":"释咸杰","text":"入室爱用拳头，佛来也不放过。\n知他是圣是凡，便敢如此乱做。\n识得破，海坛马子似驴大。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16276,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人请赞 其三","author":"释咸杰","text":"在家不读书，行脚不参禅。\n随流闲打閧，掘地觅青天。\n而今老矣方知悔，捏人痛处力加鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16277,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赞大慧和尚","author":"释咸杰","text":"戳瞎顶门三只眼，是非佛法一齐刬。\n竹篦头上放无端，正是徐六担片板。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16278,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赞开明禅师","author":"释咸杰","text":"江郎入定，乌巨开山。\n林深路迥，火冷云寒。\n道大不知谁辨的，帝王亲手付金襕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16279,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赞木庵和尚","author":"释咸杰","text":"面目森严，语言希差。\n不出飞猿岭，道声蔼天下。\n活懒庵不传之宗，死衲僧虚头话霸。\n五坐道场，丛林增价。\n稽首拜手，虚空贴卦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16280,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赞布袋和尚","author":"释咸杰","text":"禅不参，道不会，终日忙忙。\n弄个布袋，十字街头道等人。\n阿谁知渠绻缋，稽首弥勒世尊。\n国有宪章，三千条罪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16281,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赞应庵和尚","author":"释咸杰","text":"眼大如环，头匾似扇。\n从来不省己非，偏笑漳泉福建。\n著实处用无七纵八横，脱空时曰有万化千变。\n焚香稽首赞扬，也是神头鬼面。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16282,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赞径山音首座","author":"释咸杰","text":"气宇云闲，身心木槁。\n顶门正眼，红日杲杲。\n早投长芦刬草之机，晚分双径人天之座。\n名山屡招而不赴，一庵超然其高卧。\n夫是谓丛林前辈典刑，宜与赵州同年而并操者也。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16283,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赞绣宝公","author":"释咸杰","text":"针锋上直入，线缝里跳出。\n剪刀尺子自随身，号令乾坤齐万物。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16284,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠何神童","author":"释咸杰","text":"父母未生时，文章在何许。\n及乎跳出来，光明照寰宇。\n傍观眼难瞒，收录奏明主。\n一览赞希奇，杨晏堪为伍。\n赐笏与绿袍，以显其宗祖。\n人生天地间，休将年纪数。\n纵饶生百岁，无闻亦何补。\n伟哉英特大丈夫，君臣嘉会今合符。\n行看赤手扶宗社，大千捏聚一蘧庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16285,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示善应道人","author":"释咸杰","text":"善应无私，当阳有准。\n直下承当，入佛祖阃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16286,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十五首 其三十七","author":"释咸杰","text":"呼猿洞口，虚空迸裂。\n鸦飞不度，如行如说。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16287,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十五首 其二十八","author":"释咸杰","text":"月圆月缺，循途守辙。\n打破牢关，天宽地宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16288,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十五首 其十三","author":"释咸杰","text":"世尊拈花，勾贼破家。\n迦叶微笑，声前失照。\n雪峰辊毬，双放双收。\n玄沙未彻，眼中拔屑。\n云门顾鉴，递相脱赚。\n俱胝竖指，全无巴鼻。\n遮一队汉，敌国家财。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16289,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十五首 其十二","author":"释咸杰","text":"天上月圆，人间月半。\n槌鼓升堂，理旧公案。\n车不横推，理无曲断。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16290,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十五首 其七","author":"释咸杰","text":"有句无句，如藤倚树。\n石裂崖崩，毒蛇当路。\n树倒藤枯，悉哩苏嚧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16291,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十五首 其六","author":"释咸杰","text":"即心即佛，铁牛无骨。\n非心非佛，空山突兀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16292,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十五首 其四","author":"释咸杰","text":"久雨忽晴，天清地宁。\n寒山抚掌，拾得忻忻。\n恁么会得，旱地遭钉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16293,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人请赞 其七","author":"释咸杰","text":"水黑染成，恰似真个。\n据坐胡床，胡挥乱做。\n三十年后，此话大行。\n籍没乃翁，胶黏滞货。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16294,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"径山茶汤会首求颂二首 其一","author":"释咸杰","text":"径山大施门开，长者悭贪俱破。\n烹煎凤髓龙团，供养千个万个。\n若作佛法商量，知我一状领过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16295,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送会侍者开应庵塔铭","author":"释咸杰","text":"三十馀年沙魇，一十五处脱空。\n欲彰从前家丑，何妨刻石流通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16296,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十五首 其五十六","author":"释咸杰","text":"南泉起模画样，长庆披砂拣金。\n云门鼻孔先穿，雪窦据款结案。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16297,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人请赞 其四","author":"释咸杰","text":"眼横鼻直村僧，肚里浑无一窖。\n两奉诏旨住持，添得丛林热闹。\n若论直指单传，正是睡梦未觉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16298,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"五泄山三学院十题 其一 五泄","author":"释咸润","text":"飞泉成五级，一级一龙湫。\n削出万仞秀，讵让蓬莱丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16299,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"五泄山三学院十题 其八 俱胝岩","author":"释咸润","text":"昔人持此咒，岩坐岁寒深。\n梵言不复闻，雅名流至今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16300,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"五泄山三学院十题 其九 祷雨潭","author":"释咸润","text":"尝闻越邑民，祷雨碧岩畔。\n神龙如有期，为霖通旱暵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16301,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"五泄山三学院十题 其六 石门","author":"释咸润","text":"双峰起云际，髣髴五侯门。\n烟霞锁不开，曾无车马奔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16302,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"五泄山三学院十题 其七 石屏","author":"释咸润","text":"峭石状危屏，截断诸峰青。\n白云触不飞，仙掌空遗名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16303,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"五泄山三学院十题 其五 石鼓","author":"释咸润","text":"巨石平如掌，天然状鼙鼓。\n击之还有声，分明含太古。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16304,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"五泄山三学院十题 其四 龙井","author":"释咸润","text":"寒井深无极，人谓藏虬龙。\n尝闻救炎旱，丝雨洒长空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16305,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"五泄山三学院十题 其三 夹岩","author":"释咸润","text":"一径数里间，巉岩镇幽谷。\n中夹清溪流，白云长断续。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16306,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]