[{"title":"即事二首 其一","author":"陆游","text":"秃尾驴嘶小市门，侧篷帆过古城村。\n此生感慨知何限，斗酒新丰不足论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5079,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即事八首 其二","author":"陆游","text":"楸垂落索槐吐花，溪女采莲童抱瓜。\n一年光景又将半，愈老愈知生有涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5080,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即席四首 其二","author":"陆游","text":"醉中起舞递相属，坐上戴花常作先。\n要知吾辈不凡处，一吸已乾双玉船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5081,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"听事前紫薇花二本甚盛戏题绝句","author":"陆游","text":"红药紫薇西省春，从来惟惯对词臣。\n问囚自是粗官分，无奈名花解笑人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5082,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"听事望马目山","author":"陆游","text":"官身早暮不容闲，尘土堆胸愧满颜。\n也有向人誇说处，坐衙常对水南山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5083,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"听雨","author":"陆游","text":"老态龙钟疾未平，更堪俗事败幽情。\n纱幮笛簟差堪乐，且听萧萧暮雨声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5084,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"听雨","author":"陆游","text":"发已成丝齿半摇，灯残香尽夜迢迢。\n天河不洗胸中恨，却赖檐头雨滴消。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5085,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吴娃曲 其三","author":"陆游","text":"二月镜湖水拍天，禹王庙下斗龙船。\n龙船相似年年好，人自今年异去年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5086,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吴娃曲 其四","author":"陆游","text":"臂上烧香拜佛前，愿郎安稳过新年。\n多情已是长多病，莫要留心在妾边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5087,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吹笛","author":"陆游","text":"吴江楚泽闲游遍，未豁平生万里心。\n醉里独携苍玉笋，岳阳楼上作龙吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5088,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"道石三首 其一","author":"陆游","text":"秋风袅袅雨斑斑，身隐幽窗笔砚间。\n小试壶公缩地术，数峰闲对道州山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5089,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"道石三首 其二","author":"陆游","text":"林虑灵壁俱尤物，散落人间不复还。\n投老东归风味在，舂陵小岫伴身闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5090,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"道石三首 其三","author":"陆游","text":"误因禄米弃莼鲈，一落尘埃底事无。\n布袜青鞋虽兴尽，此峰聊当卧游图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5091,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"园中","author":"陆游","text":"霜凋榉柳枝无叶，风拆安榴子满房。\n冬日园林元自好，老人怀抱自多伤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5092,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"园中杂书四首 其四","author":"陆游","text":"残花委地笋掀泥，香椀诗囊到处携。\n幽梦欲成谁唤觉，半窗斜日鹧鸪啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5093,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"园中杂书四首 其三","author":"陆游","text":"笋生密密复疏疏，来看偏宜晓雨馀。\n乞与人间作图画，幅巾短褐小篮舆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5094,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"园中杂书四首 其二","author":"陆游","text":"北窗看镜意凄然，梦断梁州已七年。\n猎猎綵旗春日晚，不堪花外见鞦韆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5095,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"园中杂书四首 其一","author":"陆游","text":"萧萧慈竹鸟呼风，宛似山光小阁东。\n剩欲杖藜寻昨梦，更添红绽绿阴中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5096,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"园中绝句二首 其二","author":"陆游","text":"溪北溪南飞白鸥，夕阳明处见渔舟。\n凭谁为剪机中素，画取天涯一片秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5097,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"园中绝句二首 其一","author":"陆游","text":"梅花重压帽檐偏，曳杖行歌意欲仙。\n后五百年君记取，断无人似放翁颠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5098,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"园中偶题四首 其四","author":"陆游","text":"九日春阴一日晴，不堪风驾浪花生。\n画船欲解还归卧，寂寂窗扉听鸟声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5099,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"园中偶题四首 其三","author":"陆游","text":"忆向彭州取牡丹，蜡封驰骑露初乾。\n如今历尽人间事，纵有姚黄亦懒看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5100,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"园中偶题四首 其一","author":"陆游","text":"绿衣粲粲咮微丹，映叶穿枝立画栏。\n莫恋主人惊不去，五陵年少有金丸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5101,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"园中偶题四首 其二","author":"陆游","text":"春深无处不春风，数树桃花乃尔红。\n莺蝶纷纷自常事，不应也著白头翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5102,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"弄笔","author":"陆游","text":"少学文章竟不成，暮年腕弱字攲倾。\n抽毫欲下还休去，棐几空怜似砥平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5103,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀友","author":"陆游","text":"酒家旗下分携久，山驿灯前感慨频。\n人事已随双鬓改，柳条又见一年新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5104,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀旧三首 其一","author":"陆游","text":"扇子峡中有隐士，清江一曲照柴荆。\n当时船急失一见，至今空忆暮猿声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5105,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀旧六首 其六","author":"陆游","text":"嶓冢山头是汉源，故祠寂寞掩朱门。\n击鲜藉草无穷乐，送老那知江上村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5106,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀旧六首 其二","author":"陆游","text":"骏骡西过雨漫天，千里江山在眼边。\n二十四年如昨梦，凭谁问讯带枷仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5107,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀旧六首 其三","author":"陆游","text":"狼烟不举羽书稀，幕府相从日打围。\n最忆定军山下路，乱飘红叶满戎衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5108,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀旧六首 其五","author":"陆游","text":"回龙寺壁看维摩，最得曹吴笔意多。\n风雨尘埃昏欲尽，何人更著手摩挲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5109,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀旧六首 其一","author":"陆游","text":"鹤鸣山下竹连云，凤集城边柳映门。\n当日不知为客乐，如今回首却消魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5110,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山园草木四绝句 其三 拒霜","author":"陆游","text":"满庭黄叶舞西风，天地方收肃杀功。\n何事独蒙青女力，墙头催放数苞红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5111,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"李允蹈判院送酒四斗予答书乃误以为二斗作小诗识愧","author":"陆游","text":"冷官谁顾雀罗门，一纸惟君肯见存。\n堪笑放翁昏至此，乘壶误写作朋樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5112,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"村东","author":"陆游","text":"村西行药到村东，沙路溪流曲折通。\n莫问梅花开早晚，杖藜到处即春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5113,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"村饮二首 其一","author":"陆游","text":"雪前雪后梅初动，街北街南酒易赊。\n身健不妨随处醉，有家未必胜无家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5114,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"村饮四首 其三","author":"陆游","text":"买来新兔不论钱，钓得鲜鳞细柳穿。\n野店浑头更醇酽，一杯放手已醺然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5115,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"村饮二首 其二","author":"陆游","text":"醉插江梅老更宜，犹能小树拣繁枝。\n假令住世十小劫，应爱此花无厌时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5116,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"村饮四首 其一","author":"陆游","text":"不来东舍即西家，野老逢迎一笑哗。\n试说暮年如意事，细倾村酿听私蛙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5117,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"村饮四首 其二","author":"陆游","text":"无念无营饱即嬉，老翁真个似婴儿。\n昏钟未动先酣枕，日上三竿是起时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5118,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"村饮四首 其四","author":"陆游","text":"淡烟孤榜系村桥，叠叠沙痕印落潮。\n最是一年秋好处，踏泥沽酒不辞遥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5119,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"村居书事六首 其六","author":"陆游","text":"文辞苦思徒妨睡，官职虚名不疗饥。\n垂老始知安乐法，纸鸢竹马伴儿嬉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5120,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"村居书事六首 其二","author":"陆游","text":"矮瓶煮粥犹难继，小甑蒸糕岂解常。\n偶得盐醯便豪侈，晨餐满舍野蔬香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5121,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"村居书事六首 其五","author":"陆游","text":"修身世世诗书业，营利明明市井人。\n安得后生俱自好，百年门户本来贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d19