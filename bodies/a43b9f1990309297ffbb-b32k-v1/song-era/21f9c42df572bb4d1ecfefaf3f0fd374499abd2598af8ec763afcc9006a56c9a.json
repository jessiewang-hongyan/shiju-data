[{"title":"春暮有感二首 其一","author":"张耒","text":"午枕消暗永，春裘御晓清。\n砌红多近采，园绿有深鸣。\n窗破斜光入，炉消断碧横。\n白头为吏苦，高卧笑浮生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51815,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"昼卧怀陈三时陈三卧疾","author":"张耒","text":"睡如饮蜜入蜂房，懒似游丝百尺长。\n陋巷谁过居士疾，春风正作国人狂。\n吟诗得瘦由无性，辟谷轻身合有方。\n欲饷子桑归问妇，一瓢过午尚悬墙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51816,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"柘城道中","author":"张耒","text":"欲雪日易晚，不寒风更清。\n崩桥断官路，积水入空城。\n屏翳野初烧，降丘民始耕。\n冬晖疾如马，汲汲暝犹征。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51817,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"柯山闻鹎鵊","author":"张耒","text":"三年不听早朝鸡，惭愧高林鹎鵊儿。\n满眼山林春已去，五更风露月沉西。\n厌听田舍驱牛苦，想见天门宝马嘶。\n独我朦胧贪晓睡，故园门巷梦中迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51818,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"神宗皇帝挽词三首 其二","author":"张耒","text":"三百年成玉鼎丹，缟帷惊变紫宸班。\n遗弓有泪哀何及，嘶马无踪去不还。\n霜露无情金阙暗，山川常在石麟閒。\n青衫曾赐当年桂，欲附龙髯不可攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51819,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋日","author":"张耒","text":"陨叶鸟不顾，枯茎虫莫吟。\n野荒田已穫，江暗夕多阴。\n夜语闻山雨，无眠听楚砧。\n敝裘还补绽，披拂动归心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51820,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋日忆家","author":"张耒","text":"汩汩流光长远客，年年秋至是离家。\n孤城入夜寒更迥，霜月满天归梦赊。\n摵摵老桐风后叶，娟娟疏菊雨残花。\n茅檐布被犹无力，长走尘埃真可嗟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51821,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋日游柯市","author":"张耒","text":"柯市渔樵暮，游人落落稀。\n肩禾新穫野，炷火欲鸣机。\n草木经寒雨，川原淡夕晖。\n北归吾敢必，身世正多违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51822,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋日登海州乘槎亭","author":"张耒","text":"海上西风八月凉，乘槎亭外水茫茫。\n人家日暖樵渔乐，山路秋晴松柏香。\n隔水飞来鸿阵阔，趁潮归去橹声忙。\n蓬莱方丈知何处，烟浪参差在夕阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51823,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋兴","author":"张耒","text":"薄云蔽日晚悠悠，檐雨萧萧急未收。\n佳树已彫今岁叶，西风还是去年秋。\n蹉跎不奈时惊客，牢落惟凭酒散愁。\n多病支离欣得睡，晚来凉气满衾裯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51824,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋怀次韵晁应之三首 其三","author":"张耒","text":"清秋万里兴，力疾上层台。\n岁熟雉兔饱，风高榆柳摧。\n晚篁元自绿，幽菊为谁开。\n寂寞无人问，乡书久不来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51825,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋怀次韵晁应之三首 其二","author":"张耒","text":"衰鬓不堪洗，病躯先觉阴。\n天寒白日短，岁暮乱山深。\n薄酒醒无力，危弦奏不禁。\n谋身老逾拙，三听洛阳砧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51826,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋怀次韵晁应之三首 其一","author":"张耒","text":"木落晚风急，宵凉侵暑衣。\n有期惟向老，无计未成归。\n只益颠毛脱，还从髀骨肥。\n感时仍吊古，回首意多违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51827,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋夜","author":"张耒","text":"月到啼蛩壁，风摇睡鹊枝。\n秋来客不寐，遥夜漏何迟。\n已近风霜节，寂无蚊蚋时。\n天时只自尔，浪遣宋生悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51828,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋雨","author":"张耒","text":"阶下梧桐树，芳菲亦已休。\n岁时惊病客，风雨送清秋。\n栖鸟归何晚，鸣虫响渐收。\n萧萧寒色暮，吹作夜深愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51829,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋雨二首 其二","author":"张耒","text":"陋巷柴门掩寂寥，一窗风雨晚萧萧。\n清秋渐冷尤宜懒，閒日苦长无处消。\n乌几青筇扶病弱，素琴黄卷伴逍遥。\n交朋南北音书隔，虽有芳樽谁可招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51830,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋雨二首 其一","author":"张耒","text":"急雨凄风未肯晴，墙阴先报候虫鸣。\n扫除暑气驱三伏，催促秋声向五更。\n美酒若能斟靖节，二毛偏解著潘生。\n醉来真有无穷意，老去何劳浪自惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51831,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋宫","author":"张耒","text":"帐额斓斑暗旧金，玉猊香重暖沈沈。\n秋风宫殿梧桐老，暮雨楼台帘幕深。\n银箭漏迟鸡唱晓，绮窗人睡昼生阴。\n无眠惯滴班姬泪，听尽长安夜夜砧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51832,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋晓","author":"张耒","text":"老人不睡秋夜长，五更鼓角鸣东堂。\n悲蛩床下欲无语，黄叶瓦清新有霜。\n雁声相应江南北，斗杓欲下天中央。\n老人山尊有美酒，岸巾先酌一杯尝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51833,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋晚","author":"张耒","text":"鸟栖林已静，门掩吏家归。\n黄叶雨中尽，鸣虫霜后微。\n尘凝经暑扇，貂敝早寒衣。\n赖有清尊酒，山炉彻夜围。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51834,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"种芭蕉","author":"张耒","text":"幽居玩芳物，自种两芭蕉。\n空山夜雨至，滴滴复萧萧。\n凉叶泛朝露，芳心展夕飙。\n东堂日虚静，秀色慰无聊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51835,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"种圃","author":"张耒","text":"僦舍亦为圃，从人笑我痴。\n自求佳草木，仍补小藩篱。\n吾事正如此，人生聊自怡。\n霜松未及尺，独我见奇姿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51836,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赴官寿安泛汴二首 其二","author":"张耒","text":"落泊云随宿雨开，西风似与早寒催。\n晓天雁起平沙去，霜岸风鸣败叶来。\n扰扰劳生移岁月，纷纷过眼旋尘埃。\n求田问舍真良策，功业应须与命偕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51837,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赴官寿安泛汴二首 其一","author":"张耒","text":"西来秋兴日萧条，昨夜新霜缉缊袍。\n开遍菊花残蕊尽，落馀寒水旧痕高。\n萧萧官树皆黄叶，处处村旗有浊醪。\n老补一官西入洛，幸闻山水颇风骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51838,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赴宣城守吴兴道中","author":"张耒","text":"秋野连云静，三吴稻熟时。\n风江客帆疾，晴野雁行迟。\n草木霜天晚，山川泽国卑。\n宣城不负汝，好继谢公诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51839,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送丁秀才侍竹之邕州","author":"张耒","text":"五岭天南极，扁舟到几时。\n山川故国远，猿鸟异乡悲。\n书史传家旧，功名及壮期。\n相携有佳客，莫负锦囊时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51840,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送丁宣德赴邕州佥判","author":"张耒","text":"邕南亭障久消兵，莫厌扁舟万里行。\n岭外山川从古秀，幕中谈笑属时平。\n天连涨海鹏飞近，风卷孤城飓母生。\n勿为跕鸢思款段，古来男子重功名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51841,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送刘南夫赴任京师","author":"张耒","text":"却扫楚山根，相过唯有君。\n齐年未白发，不日上青云。\n送别悲秋早，伤离赖酒醺。\n青衫老司马，落泪独纷纷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51842,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送江瞻道之汝阴尉","author":"张耒","text":"少年相见已蹉跎，千里分携可奈何。\n世路险艰知子少，人间忧患属予多。\n二年穷巷山阳客，一棹清风颍水波。\n我为离居感身世，援琴西望独悲歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51843,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送李公辅赴宰宣城","author":"张耒","text":"与君骑竹即同游，抱子相看发已秋。\n莫惜往来勤马足，未须容易转船头。\n君方搜句窗间岫，我已悬情天际舟。\n抱椠石渠无所欲，劳君时致管城侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51844,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送杨念行监簿侍行赴鄂渚","author":"张耒","text":"楚天南去水冥冥，鄂渚悠悠到几程。\n京洛信稀千里隔，江湖春尽一帆轻。\n莫辞送别青春满，会是相逢白发生。\n饱读诗书取卿相，不应如我老无成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51845,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送复守张坰朝奉罢归","author":"张耒","text":"一梦西都十二年，竟陵相遇各华颠。\n风流家世仁人后，恺悌歌谣楚俗传。\n学道爱君甘淡薄，倦游嗟我久留连。\n自怜江上伤春眼，不待琵琶已泫然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51846,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送春","author":"张耒","text":"莽莽平原绿，悠悠晚树红。\n巢成莺哺子，柳老絮飞空。\n碧草长亭路，青旂野店风。\n伤心对千里，无酒奈愁攻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51847,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送徐任","author":"张耒","text":"白发青衫困宦游，相逢不复话封侯。\n少年壮气青云上，投老生涯一醉休。\n献璞谁怜藏美玉，恶声不至为虚舟。\n从来满卷新诗句，写取淮天万里秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51848,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送曹子方赴福建运判","author":"张耒","text":"平生邺下曹公子，家世风流合有文。\n横槊尚传瞒相国，紫髯不是画将军。\n诏书宽大民何怨，刺史威严吏合勤。\n好作楚词更下俚，云中一降武夷君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51849,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送婿陈景初还钱塘","author":"张耒","text":"乃翁风节老弥坚，嗣子清修学有传。\n为爱诗书贤事业，肯羞葛练拙包缠。\n经年上国劳归梦，一棹寒流放去船。\n饱读陈编勤笔砚，书来寄我好文编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51850,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送蔡彦规之任风泉主簿","author":"张耒","text":"四十曳青袍，功名晚未遭。\n贤人固难进，小邑且徒劳。\n秦俗讴谣口，雍州形势豪。\n凭君怀古意，一一寄风骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51851,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重九考罢试卷书呈同院诸公","author":"张耒","text":"回首登高行复冬，后时只合叹龙钟。\n愁须白酒来酣战，诗为黄花吊不逢。\n十日飞腾过眼疾，万签甲乙定谁从。\n共应净扫氍毹榻，深炷炉香午睡浓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51852,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重到临淮寿圣院","author":"张耒","text":"陈迹不可访，旧游三十年。\n相逢非故物，大半已沈泉。\n世界扬尘海，浮生不系船。\n老人无固必，醉即掩篷眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51853,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"钦慈皇后挽词二首 其二","author":"张耒","text":"淑德承明旧，徽音固有来。\n据龙符圣嗣，合剑会轩台。\n玉冷衣销馥，鸾昏镜集埃。\n伤心国西道，寂寞送车回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51854,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"钦慈皇后挽词二首 其一","author":"张耒","text":"畴昔熙宁盛，远同麟趾时。\n内敦勤俭德，阴辅太平基。\n馀烈光彤史，追荣备母仪。\n遗民怀永裕，箫鼓不胜悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51855,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闻邠老下第作诗迎之","author":"张耒","text":"淡墨高张动禁城，风驰电落走寰瀛。\n从来万卷贮便腹，可得千人无一名。\n且向江边伴逐客，会须天上冠群英。\n遥思匹马千山里，孤店村深听晚莺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51856,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"食薇","author":"张耒","text":"岁穷阴不解，短日过墙微。\n幽鸟穿林小，寒乌啄树饥。\n冰霜崖岭壮，烟火井闾稀。\n老拙安閒僻，无心厌食薇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51857,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"倚声制曲三首 其三","author":"张耒","text":"山未高兮水不深，此情此意薄千金。\n今朝酒伴双垂泪，明夜灯前独拥衾。\n玉箸异时空见迹，麈犀千里亦通心。\n桃源路绝无人到，应许刘郎再访寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51858,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"倚声制曲三首 其二","author":"张耒","text":"不恨因缘不恨天，强持牙板向樽前。\n阳关一曲动山月，别泪千行盈酒船。\n薄命有情今已矣，傍人无意亦凄然。\n愿君学取梁间燕，秋去春来到妾边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51859,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"倚声制曲三首 其一","author":"张耒","text":"春丝惹恨鬓云垂，媚态愁容半在眉。\n早是思深难语别，可堪肌瘦不胜衣。\n眼前有恨景尤速，门外无情车载脂。\n自笑不如天上月，尊前犹有见郎时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51860,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭蔡彦规二首 其二","author":"张耒","text":"文章不用世，沦落掩山阿。\n命也人无奈，悲哉天谓何。\n至交嗟我少，双泪为君多。\n遥想山阳墓，秋风吹薜萝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51861,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭蔡彦规二首 其一","author":"张耒","text":"青衫未白首，已叹掩新阡。\n哭别自今日，书来才去年。\n功因钟鼎记，名赖友朋传。\n平昔围棋笑，临枰更泫然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51862,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哲宗皇帝挽词四首 其四","author":"张耒","text":"七月宫车驾，西陵观阙新。\n风云悲厚夜，羽卫异时巡。\n落月低金爵，秋芜暗石麟。\n威灵凛如在，善继有天伦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51863,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哲宗皇帝挽词四首 其三","author":"张耒","text":"万世兴王业，千年极治辰。\n泽丘还北祭，玉检议东巡。\n汗竹人间事，因山地下春。\n云天不可望，髯断泣遗臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51864,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哲宗皇帝挽词四首 其二","author":"张耒","text":"秦地蟠螭纽，细阳玉象光。\n升歌陈备乐，信史记多祥。\n夺邑公无怨，开边义侮亡。\n威灵对三后，常在白云乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51865,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哲宗皇帝挽词四首 其一","author":"张耒","text":"端拱循尧道，无为十六年。\n偏师擒颉利，上将勒燕然。\n梦损周王寿，丹催黄帝仙。\n凄凉旧载笔，恸哭抱残编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51866,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庚辰腊八日大雪二首 其二","author":"张耒","text":"东州逢腊雪，却忆竟陵梅。\n客路人方远，天涯雁欲回。\n遥怜檐外白，还点砌边苔。\n久是无人过，谁知照酒杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51867,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庚辰腊八日大雪二首 其一","author":"张耒","text":"平生腊八日，借钵受斋糜。\n客路岁将晚，旅庖晨不炊。\n持杯从破律，遣兴自吟诗。\n何日依禅宿，钟鱼自有时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51868,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏日二首 其二","author":"张耒","text":"重云卷雨过山来，遍洒中田到晓回。\n错落晴山移斗极，阴森暗峡宿风雷。\n佳人夜夜齐纨恨，骚客年年鹎鵊哀。\n欲见清秋近消息，月明白露湿苍苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51869,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏日二首 其一","author":"张耒","text":"诗书老去信无功，偷得閒官许养慵。\n山影当庭初转日，水声穿竹自来风。\n晚催萱蕊昏还敛，日射榴房午更红。\n览物赋诗成底事，萧萧双鬓欲衰翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51870,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏日十二首 其十一","author":"张耒","text":"蛩怨青莎老，萤飞秋水深。\n庭除延夜色，砧杵发秋心。\n雄剑鸣初匣，寒衣补硬针。\n老来词赋懒，从使二毛侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51871,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏日十二首 其十","author":"张耒","text":"陶令抛官易，庞公去隐深。\n由来浮世事，可见昔人心。\n卜筑閒多思，奔驰病不禁。\n檐楹来燕雀，鸾鹤自山林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51872,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏日十二首 其九","author":"张耒","text":"种药幽人事，还披本草经。\n出山抛旧翠，过雨有新青。\n术受壶中秘，方传肘后灵。\n不辞勤服饵，为变发星星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51873,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏日十二首 其八","author":"张耒","text":"久与山川约，那无风月情。\n经营原阔略，疏放自平生。\n山友招相见，乡书向远征。\n殷勤语归计，贫苦病难成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51874,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏日十二首 其七","author":"张耒","text":"谢守常搜句，陶潜亦效官。\n傍溪分水细，过巘得天宽。\n布种随蔬陇，寻香到药栏。\n野装儿稚笑，绳屦鹿衣冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51875,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏日十二首 其六","author":"张耒","text":"养拙贫无事，深幽乐更真。\n檐巢偷哺子，树啄巧藏身。\n窃果莺知主，移居蚁过邻。\n老夫朝食美，荐俎有溪鳞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51876,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏日十二首 其五","author":"张耒","text":"细径依原僻，蓬蒿四五家。\n山田来雉兔，溪雨熟桑麻。\n竹笼晨收果，茅庵夜守瓜。\n颇知农事乐，彼此问生涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51877,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏日十二首 其四","author":"张耒","text":"朝雨来还密，村墟一望间。\n远声惟野竹，润色但青山。\n书史供高卧，莓苔只闭关。\n萧萧觉秋兴，飘飒近衰颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51878,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏日十二首 其三","author":"张耒","text":"山雨晴来暑，溪云暗复兴。\n林塘阴不解，巾帻润还蒸。\n书帙慵披蠹，盘餐厌扑蝇。\n老来疲薾甚，多病日侵陵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51879,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏日十二首 其一","author":"张耒","text":"过雨芰荷乱，繁阴竹树多。\n雏声知鸟哺，萍动见鱼过。\n细径饶苔藓，阴墙引薜萝。\n角巾从倒侧，疏懒欲如何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51880,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏日三首 其三","author":"张耒","text":"枣径瓜畦经雨凉，白衫乌帽野人装。\n幽花避日房房敛，翠树含风叶叶香。\n养拙久拚藏姓氏，致身安事巧文章。\n汉庭卿相皆豪俊，不遇何妨白发郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51881,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]