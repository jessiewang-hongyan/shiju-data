[{"title":"题山寺","author":"苏泂","text":"白云飞绕寺楼钟，点滴清声露打松。\n童子开门还报我，鹤眠犹在最高峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74296,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题兴旅亭","author":"苏泂","text":"舟行竟日雨冥冥，晚饭凄凉送客亭。\n云羃乱山看不见，隔江惟有一堆青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74297,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠草","author":"苏泂","text":"一阵春风起，依然故旧情。\n墙根霜下草，吾与汝更生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74298,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠耕堂栀子花","author":"苏泂","text":"六出英英九夏寒，短丛香玉映清湍。\n主人自出无人管，输与泠然隔岸看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74299,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠梅","author":"苏泂","text":"不作梅花一句诗，今年参透老禅机。\n忽然吹堕纷纷雪，又挽寒香探落晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74300,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠韩雪蓬","author":"苏泂","text":"平生未信简斋诗，一见韩君更不疑。\n六月掀篷问溪雪，眼明开遍两三枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74301,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"镜湖","author":"苏泂","text":"苍苍烟霁塔，了了月明山。\n坐久忽不见，濛濛杳杳间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74302,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"镜湖怀古","author":"苏泂","text":"镜湖湖水滑如油，狂客归来上钓舟。\n惆怅无因见李白，西风吹老芰荷洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74303,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"檐雪","author":"苏泂","text":"檐雪无风久未消，贫家昨夜有琼瑶。\n明朝却与邻人笑，只作清斋水一瓢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74304,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"濯锦江","author":"苏泂","text":"机丝波影借光华，巴女临流住几家。\n争向芳菲偷锦样，织成平白溅江花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74305,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"一室","author":"苏泂","text":"一室星辰入，平居社稷忧。\n萤飞原有夜，蝉远不胜秋。\n短发千方误，中年万事休。\n摩挲门外柳，坎止亦乘流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74306,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二十三弟丧偶慰之","author":"苏泂","text":"汝妇真良偶，吾家无间言。\n生来诸澹泊，夺去几烦冤。\n室想羸鳏慕，床馀稚乳存。\n羁游违一奠，何日送丘原。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74307,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"八月十二日再入都","author":"苏泂","text":"野色连山碧，时光似水流。\n邹阳仍是客，李广不封侯。\n业已诗中老，何须病始休。\n草根萤一点，寂照万端忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74308,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"八月十五日游禹祠告成观","author":"苏泂","text":"度密穿青且意行，穷居谁识万人英。\n山当凿处终须好，水到平时自不鸣。\n夏德真应参太始，禹功那复告其成。\n登临遗庙秋风里，不尽今来古往情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74309,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十月二十八日迁入赵氏借屋适有名酒及延致内黄侯约兄弟共醉颍季有诗次韵一首","author":"苏泂","text":"黄花已判一年休，短褐无端又去秋。\n环堵肯云原宪病，卜居那免屈平愁。\n交情白发知难有，故里青山未拙谋。\n醑我横戈陪季孟，人间棠棣薄公侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74310,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十二月二十八夜至此怅然继和","author":"苏泂","text":"病马犹依枥，饥鸿更著行。\n深宵风雨后，万里道途长。\n骨立难看镜，愁来怕举觞。\n少年轻聚散，曾笑客思乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74311,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又叹庭前杂花草","author":"苏泂","text":"十年屡作花开想，开尽凡花独未开。\n祝付化工应念此，保全根拨待时来。\n为梅自合和羹鼎，是菊终须上酒杯。\n莫笑凄凉周茂叔，窗前生意草成堆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74312,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又约赵大再游小阳明其山全似峡中点烟一亭可为吴越之冠","author":"苏泂","text":"客路心常慰，归栖气苦低。\n经行天柱北，梦想雪峰西。\n翠壁千岩长，苍烟半点迷。\n何当同拄杖，重此听猿啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74313,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三山放翁先生生朝以筇竹杖为寿一首","author":"苏泂","text":"信手公侯八十年，言归山泽更臞仙。\n声名固自盖天下，耆老所当留日边。\n满腹诗书真我有，一门簪笏自家传。\n持来筇杖非无意，窃比东坡寿乐全。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74314,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三界 其二","author":"苏泂","text":"风日催曛暮，江溪半浊清。\n春寒归雁急，沙远落鸥惊。\n有志诗书误，无家去就轻。\n短篷扃不寐，高枕念平生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74315,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三游洞","author":"苏泂","text":"悬崖三百丈，五里到松门。\n路尽始佳处，苔深无屐痕。\n细泉牛乳滴，亭午艾香温。\n舟楫经行疾，无劳具酒尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74316,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上楼大参 其一","author":"苏泂","text":"贞元朝士久成空，故国灵光但有公。\n四海已迟三日雨，八荒同在一春风。\n耆年盛德天应相，大册高文老更工。\n且为商家了梅事，未须海道觅舟东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74317,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上楼大参 其二","author":"苏泂","text":"四朝相业旧仪刑，今代衣冠类晓星。\n青眼更谁怜后裔，白头空复抱遗经。\n冲霄有路开笼鹤，槁案无时泣卷萤。\n吏部观文均所爱，因声廊庙一丁宁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74318,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与赵监簿","author":"苏泂","text":"昔我离家日，今皇即位年。\n同时辞北极，共载入西川。\n雪里赓诗句，江边醉酒船。\n重来一访旧，风景故依然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74319,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中秋扶病对月","author":"苏泂","text":"久病头如石，中秋月似盆。\n起瞻惟一色，归卧只空村。\n信有鄜州见，曾同秘省论。\n微吟到河汉，桂树忽飞翻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74320,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书张氏壁","author":"苏泂","text":"潮水迟朝渡，湖村竟日留。\n肯从沽酒饮，故作挟书游。\n得句因题壁，逢人问买州。\n双凫应不远，知道客来不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74321,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书愤","author":"苏泂","text":"黄叶冷飕飕，临风搔白头。\n江湖无老伴，天地有新愁。\n橐禁行鸳晓，榆关战马秋。\n平生忠孝意，到死不能休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74322,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"予顷时有一联云太饱伤清气微寒最好诗葛天民极爱之偶再续成","author":"苏泂","text":"太饱伤清气，微寒最好诗。\n轻鸥怜野性，垂柳让风姿。\n智巧从天赋，疏狂听我为。\n极知贫者病，未许药能医。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74323,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"云门寺诗","author":"苏泂","text":"重冈落日思依依，地老天荒阅盛衰。\n万古烟萝千古寺，唐朝诗句晋朝碑。\n鹤贪清气随僧住，松引寒声助客悲。\n十载重来衫鬓改，笋舆回路独移时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74324,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五次韵送蹈中造朝","author":"苏泂","text":"镜曲春帆远，延和晓仗穿。\n已更新历日，休问小行年。\n用我书三箧，从渠食万钱。\n功名今古意，留眼看苍天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74325,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五和堆字韵呈孟漕","author":"苏泂","text":"十年但有书题问，今日亲逢幕府开。\n薤本自迎公始到，桃花应笑我重来。\n何妨邂逅评诗句，不用殷勤治酒杯。\n办取篮舆共吟赏，石头秋晚乱云堆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74326,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"太息","author":"苏泂","text":"生物趋功日夜忙，中年转觉事茫茫。\n时情何限刀边蜜，岁晚偏多叶上霜。\n屺岵增悲谁覆载，桃梅结实几青黄。\n读书不办关门计，又著麻鞋走四方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74327,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"忆朱子大学士一首","author":"苏泂","text":"翠麓晚萧骚，无风树亦号。\n官荣归若辈，诗态忆吾曹。\n信有忧能死，应无酒可陶。\n平生相照地，不隔半秋毫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74328,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"忆黄观复","author":"苏泂","text":"地远过从少，天多眼界宽。\n晓书翻卷白，秋桂绕亭丹。\n小雨妨相觅，幽花孰与看。\n平生杜陵老，到此赋诗难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74329,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"无题","author":"苏泂","text":"爱酒陶彭泽，能诗陈后山。\n浮沉将底用，长大若为颜。\n镜面舟一叶，梅边屋数间。\n饶君双鬓白，还我半生閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74330,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"见子大后寄","author":"苏泂","text":"相过自一奇，归去复相思。\n柳上已春意，屏间如杜诗。\n山川佳甚处，人物眇然时。\n爱重非金玉，微君不我知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74331,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"见放翁退","author":"苏泂","text":"住所真容膝，谈间便解颐。\n胡能万事足，直作一生痴。\n密雨惊荷叶，微风吹竹枝。\n回舟吾自慊，应赋此翁诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74332,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"长江二首 其二","author":"苏泂","text":"处暑无三日，新凉直万金。\n白头更世事，青草印禅心。\n放鹤婆娑舞，听蛩断续吟。\n极知仁者寿，未必海之深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74333,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"长江二首 其一","author":"苏泂","text":"长江无六月，大地绝纤埃。\n暑向风前退，秋从雨后来。\n问桐知叶落，修桂待花开。\n畴昔扁舟兴，分明欲唤回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74334,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"东墅次高秘书韵","author":"苏泂","text":"累土就川池，螂蝉半黠痴。\n神仙愚谷赋，图画史君诗。\n石磴春风酒，松窗夜雨棋。\n仲谋真有子，㹠犬定吾儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74335,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"代书寄应之舅","author":"苏泂","text":"故人天一方，鸿雁已南翔。\n世乱各生死，年饥无稻粱。\n丁宁机上锦，爱惜橐中装。\n莫作孤飞想，冥冥忌弋伤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74336,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"代书寄赵处州公甫","author":"苏泂","text":"苕霅无来使，如今又几时。\n案馀分惠笔，室有寄来诗。\n豁达偏怜我，风流更许谁。\n怀哉括苍小，安用借留为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74337,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出婺城","author":"苏泂","text":"万顷平田雪，前村昨夜梅。\n梦还荆国旧，吟欠兔园才。\n只作寻诗去，何曾为酒来。\n兹行得奇事，夹道有琼瑰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74338,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"北苑","author":"苏泂","text":"北苑心无壮，南窗眼费明。\n病因杯酒见，花值客愁生。\n落落知谁合，纷纷讵不情。\n未成幽处宅，且逐众人行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74339,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"四月二十四日喜雨次振之韵","author":"苏泂","text":"朝来骤雨郁烦蒸，晚见疏星挂汉青。\n大点忽随风信入，好声先觉梦魂听。\n春过种失农犹及，喜极诗成语未停。\n每恨买山无酝藉，不知肝胆露青萍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74340,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"归自陶山舟中示暹侄","author":"苏泂","text":"钟声四山晚，一舸镜中归。\n远舍火明树，寒天露湿衣。\n塔高城不禁，林暗鸟畴依。\n有句传犹子，吾疏合世违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74341,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"归棹","author":"苏泂","text":"形役何时已，凄凉莫更论。\n雁啼云背月，人语水边村。\n十月冬犹暖，三杯酒易昏。\n悠悠信归棹，今夜宿谁门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74342,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"正月二十七日陪唐子耆登卧龙时稼轩已去令人怀之","author":"苏泂","text":"晴雨烟云态，高深会见闻。\n乱山依越定，一水向吴分。\n元白诸侯表，杨王俊士群。\n春风到红绿，花草总能文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74343,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉麟堂上偶成","author":"苏泂","text":"雨燕飞仍集，池荷密复疏。\n无心应人事，随意数游鱼。\n碑字千年冷，薰风五月初。\n玉麟堂上客，曷日赋归欤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74344,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"白鸥","author":"苏泂","text":"白鸥相见忽相猜，居士星星似我哉。\n习懒更无诗一句，浇愁惟有酒三杯。\n看梅仿雪行过去，玩月如霜弄影来。\n学得平生安乐法，等闲不受鬓毛催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74345,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仰屋","author":"苏泂","text":"仰屋无穷事，甘心未遇时。\n雨花明燕羽，风叶堕蛛丝。\n农务从人说，光阴类箭移。\n早知霜白鬓，那免一生痴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74346,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"先寄观复","author":"苏泂","text":"老去真无几，为官又不成。\n慇勤驱病体，端的为交情。\n人以风姿胜，梅将雪意争。\n知君定怀我，株坐或遐征。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74347,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再次送刍父韵寄之二首 其二","author":"苏泂","text":"当时马首东，追送苦匆匆。\n对我藕花雨，思君榕叶风。\n畏途迷白黑，醉眼眩青红。\n曷日归相问，江湖一钓翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74348,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再次送刍父韵寄之二首 其一","author":"苏泂","text":"君到知何日，书来未可疏。\n旅情难是久，别意重于初。\n时暑方遵涉，斋居少自如。\n梁空明月梦，只有不关渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74349,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再省剡姊","author":"苏泂","text":"短景催长至，冬温为小春。\n昔游今更省，母逝姊为亲。\n风木悲吟楚，晴沙巧籀秦。\n扁舟君莫羡，未必自由身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74350,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"刘振之访别举似喜雨诗次韵","author":"苏泂","text":"尺泽霏微起寸阴，稍苏焦槁见青青。\n便疑菽粟中天降，绝喜阶除半夜听。\n访我尚期新旧雨，话归还忆短长亭。\n交游若问今何似，世味谙来似楚萍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74351,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"名节","author":"苏泂","text":"了知名节重于山，谁信今人古谊存。\n百草前头梅萼秀，群飞之内凤凰尊。\n有身合下阳城拜，无些能招宋玉魂。\n公道世间犹我辈，未妨归卧掩柴门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74352,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"团扇","author":"苏泂","text":"团扇光阴有一年，楚骚心事忽凄然。\n风高碧落无穷雁，日暮青山欲断蝉。\n老去极思顽似石，古来元忌直如弦。\n吾庐咫尺金沙地，聊与僧伽话夙缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74353,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"在昔","author":"苏泂","text":"在昔西游日，飘然入剑关。\n酒醒天外驿，诗爽峡中山。\n天地羁栖久，乡园缟素还。\n不堪明镜里，重觅旧朱颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74354,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"地壁道中","author":"苏泂","text":"落日宜平野，回车憩薄阴。\n羸牛归径险，寒雀聚枝深。\n足未伤和玉，文曾卖蜀金。\n百年渠未已，出处遂何心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74355,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"安隐寺诗","author":"苏泂","text":"樟树何年种，娑娑满寺门。\n金身虚像设，画壁尽尘昏。\n龙虎青山远，冰霜碧甃存。\n坊官敬人客，顷刻具肴尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74356,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"有叹 其一","author":"苏泂","text":"古屋残僧住，孤坟乱蚁穿。\n山棱人踏减，滩石浪搓圆。\n毁誉无终日，功名有百年。\n予方辜壮岁，渠得恋华颠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74357,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"有叹 其三","author":"苏泂","text":"杵臼梁鸿事，人间欠此人。\n痴儿号饭少，愁妇厌家贫。\n雨障雪来晚，梅催柳迓春。\n平生兼善意，孤独叹沉沦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74358,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"有感","author":"苏泂","text":"众木晓森森，孤松自百寻。\n绝知根气大，能受雪霜深。\n草草供时役，悠悠匪力任。\n春风遍红紫，啼鴂便惊心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74359,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次九兄秋句","author":"苏泂","text":"愁多端的似无愁，何况周行苦滞留。\n芦簄月连银界晓，榆关寒护玉峰秋。\n挑灯屡作闻鸡舞，看剑长思跃马游。\n从古封侯欠英杰，幽燕终欲笑谈休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74360,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次知县兄曹娥渡句","author":"苏泂","text":"自绝双鱼养，愁登老桧亭。\n断云知意绪，流水付年龄。\n抚稚头空白，逢人眼未青。\n贪生不既晚，无地学威灵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74361,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次知县兄韵","author":"苏泂","text":"市少全依郭，人稀却似村。\n湖山春气早，烟雨画图昏。\n倚树花微落，吟诗酒屡温。\n亲朋各南北，步屐款谁门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74362,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次颍叟弟送行韵","author":"苏泂","text":"相传衣钵已分明，早觉诗含鲍谢情。\n心腹于人惟有弟，襟怀无我独非兄。\n偶随江路帆孤往，便忆梅窗酒对倾。\n岁晚勉旃无废学，他年夷惠看双清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74363,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵七首 其七","author":"苏泂","text":"废田为屋宇，困士学农桑。\n来者或相问，耕焉安得堂。\n为言吾欲醉，且去客无妨。\n信有痴人梦，宁甘草径荒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74364,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵七首 其六","author":"苏泂","text":"茅茨依橘柚，邻舍即烟波。\n更与山为伴，何忧屋不多。\n功名元有命，嗤笑亦从他。\n但愿年年熟，杯来尔汝歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74365,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]