[{"title":"英宗皇帝挽词 其二","author":"文彦博","text":"厥初丕命集，咸庆长君贤。\n恭俭敦尧德，忧勤损舜年。\n象耕苍野地，龙御鼎湖天。\n帝锡宣英号，鸿休耀信编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35865,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"英宗皇帝挽词 其三","author":"文彦博","text":"在隐推龙德，重明协帝华。\n蓼萧均泽及，四海詟威加。\n就日心方切，腾天驭已赊。\n攀髯不可跂，泪目送云霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35866,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"濮安懿王夫人挽词 其一","author":"文彦博","text":"令淑王藩表，恩荣代邸尊。\n笃生为圣嗣，善述在神孙。\n吉兆凭崧麓，真归傃濮园。\n宾天虽日远，国本自灵源。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35867,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"濮安懿王夫人挽词 其二","author":"文彦博","text":"昔重间平乐，中推辅佐功。\n德容咸有裕，善庆果无穷。\n以义情虽夺，于亲礼更崇。\n洛郊春向晚，薤挽变凄风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35868,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"神宗皇帝挽词 其一","author":"文彦博","text":"千龄逢圣旦，六叶嗣昌辰。\n睿智天攸纵，章程日又新。\n车书通绝域，雨露洽殊邻。\n民罄华封祝，帝思苍野巡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35869,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"神宗皇帝挽词 其二","author":"文彦博","text":"龙髯攀不及，凤翼附无因。\n望断乔山路，忧深杞国人。\n含生蒙舜德，率土被尧仁。\n罔极何由报，徒能损百身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35870,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"神宗皇帝挽词 其三","author":"文彦博","text":"元丰圣政洽隆平，溢牍联篇载颂声。\n皇武惟扬昭七德，帝华克协丽重明。\n乔山去日乘龙驭，苍野巡时见象耕。\n忆兆臣民蒙泽久，陨身思报一毫轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35871,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"神宗皇帝挽词 其四","author":"文彦博","text":"老臣逢圣运，受眷特优隆。\n觐礼超群后，官仪极上公。\n皇慈矜旧物，帝念录微功。\n一酌尧樽异，三篇说命同。\n斯心期检玉，不意遂遗弓。\n声暨要荒外，哀缠普率中。\n凄凉石门路，惨淡柏城风。\n血泪盈襟陨，何由报昊穹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35872,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宣仁圣烈皇太后挽词 其一","author":"文彦博","text":"九年四海被清晖，瑞彩重轮照殿帏。\n间日视朝觐旰食，未明思政事宵衣。\n存心庶务劳千虑，决意真游厌万机。\n下土颙颙望霄汉，仙舆直指厚陵归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35873,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宣仁圣烈皇太后挽词 其二","author":"文彦博","text":"老臣八十惭尸素，挂了貂冠归洛阳。\n芝诏荐临优眷注，蒲轮促起预平章。\n重辞禁幄犹如昨，今迓灵舆益自伤。\n勉策衰羸来巩固，临风洒泪厚陵傍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35874,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"故相国元宪宋公挽词 其一","author":"文彦博","text":"天圣收群彦，惟公独出群。\n两朝推旧德，一代仰高文。\n得位才康世，逢时道佐君。\n云胡天不慭，抚几悼勋勤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35875,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"故相国元宪宋公挽词 其二","author":"文彦博","text":"念昔为寮契，周旋一纪馀。\n佐时君望重，谋国我才疏。\n雾露常蒙润，阳秋每借嘘。\n忽焉伤殄瘁，陨泪满襟裾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35876,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"故相国元宪宋公挽词 其三","author":"文彦博","text":"名遂营身退，高风近古稀。\n台司脱屣去，空土挂冠归。\n仁寿宜难老，朝阳叹易晞。\n宸篇学丘祷，恩耀贲泉扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35877,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"故宣徽惠穆吕公挽词 其一","author":"文彦博","text":"奕世韦平族，经时管葛才。\n苍生方仰望，大厦忽倾颓。\n不慭皇情悼，如仁士论哀。\n刑山赴真宅，应见国侨来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35878,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"故宣徽惠穆吕公挽词 其二","author":"文彦博","text":"蚤预朋从谈燕熟，晚陪枢筦岁时多。\n心如金石坚无改，声似埙篪久更和。\n丹凤临池犹未浴，白驹逢隙已先过。\n相门馀庆簪缨盛，继述皆同谷与傩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35879,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"故尚书懿敏王公挽词 其一","author":"文彦博","text":"盛德三槐旧，论交二纪深。\n帝聪闻曳履，人望在为霖。\n没世犹赍志，康时未称心。\n孤怀伤殄瘁，清泪满衣襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35880,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"故尚书懿敏王公挽词 其二","author":"文彦博","text":"上台三品位非轻，秘殿论思职更清。\n频倚壮猷为屏翰，合从佥议秉钧衡。\n颓然处顺君无怛，恸矣怀贤我有情。\n不独九原埋宝玉，人琴从此绝遗声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35881,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"尚书令魏国忠宪韩公挽词 其一","author":"文彦博","text":"平生投分比金兰，莫逆论心最岁寒。\n唱第枫宸陪骥尾，秉钧槐府并貂冠。\n潘阳事契常脩睦，相魏亲邻正讲欢。\n冰井台边星陨后，百身何赎但汍澜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35882,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"尚书令魏国忠宪韩公挽词 其二","author":"文彦博","text":"出入三朝共，周旋四纪同。\n论交最知我，经世独推公。\n观水惊川逝，升堂失栋隆。\n悲怀与声泪，远寄绋讴中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35883,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"尚书令魏国忠宪韩公挽词 其三","author":"文彦博","text":"三朝光辅致升平，九叙咸熙入颂声。\n独运鸿钧成大业，亲扶英主继重明。\n圣贤自昔推同德，忠献于今重易名。\n清庙已闻从配飨，哀荣不独在佳城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35884,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中书令鲁国宣靖鲁公挽词 其一","author":"文彦博","text":"三朝辅翊秉鸿钧，功在旂常泽在民。\n黄石授来为帝傅，赤松游去保天真。\n达生优享高年福，出世轻遗大梦身。\n自古陉山多吉宅，国侨裴令继芳尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35885,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中书令鲁国宣靖鲁公挽词 其二","author":"文彦博","text":"二府陪游垂二纪，服公哲范每思齐。\n留心旧典皆驯致，从事新书悉顺稽。\n言发清风常穆若，心停止水更渊兮。\n先朝付嘱非无谓，必为其仁在放麑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35886,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中书令鲁国宣靖鲁公挽词 其三","author":"文彦博","text":"龟蒙启土世传荣，犹倚耆英作政卿。\n及见伯禽亲拜后，方知遗爱在元成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35887,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中书令鲁国宣靖鲁公挽词 其四","author":"文彦博","text":"穆穆罢朝嗟不慭，冲冲停市叹如仁。\n生刍絮酒难亲致，薤曲书成泪满巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35888,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王太师挽词 其一","author":"文彦博","text":"贤书蚤入英雄彀，冠岁高驰贾马声。\n一纪玉堂司大笔，两朝金鼎主和羹。\n天边遽失骑箕象，川上犹思用楫名。\n欲识圣恩优异处，密章重叠贲佳城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35889,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王太师挽词 其二","author":"文彦博","text":"去春解组遂西征，曾辱都门出饯行。\n席上诗成光退迹，樽中酒满叙离情。\n经年方叹音容隔，此日俄惊柱石倾。\n羸老不能亲引绋，临风洒泪湿襟缨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35890,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"司马温公挽词 其一","author":"文彦博","text":"莫逆论交司马丈，君心知我我知君。\n同谋同道殊无间，一死一生今遂分。\n八十衰翁如槁木，一千馀日是残曛。\n前途若有相逢处，尚以英灵解世纷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35891,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"司马温公挽词 其二","author":"文彦博","text":"留滞周南十五年，成书奏牍过三千。\n东山方起为霖雨，大厦俄倾叹逝川。\n密有忠言如药石，别加优礼赐貂蝉。\n两宫痛悼皆临奠，祗为皋夔志未宣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35892,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"司马温公挽词 其三","author":"文彦博","text":"昔有乡贤阳道州，亦闻比近有松楸。\n新阡便合开三径，同气相求好并游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35893,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"司马温公挽词 其四","author":"文彦博","text":"傅岩旧迹今犹在，兼与安平祖庙邻。\n贤相裔孙还卜宅，先畴吉土是归真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35894,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"司马赠太傅康国韩公挽词 其一","author":"文彦博","text":"朝路相从三纪馀，更陪国论对钧枢。\n康时远术推贤业，造膝嘉猷协帝俞。\n盘结方资庖刃解，旱乾犹望傅霖苏。\n寝门遽有人琴叹，老伴调零道转孤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35895,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"司马赠太傅康国韩公挽词 其二","author":"文彦博","text":"洛城曾与公相别，已为人生老别难。\n今作绋讴成永诀，满襟悲泪转汍澜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35896,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"司马赠太傅康国韩公挽词 其三","author":"文彦博","text":"西豪居在许东偏，丹旐遥遥过许田。\n欲问相君真宅处，高平吉地是新阡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35897,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中书侍郎傅公挽词 其一","author":"文彦博","text":"友会朋情二纪馀，金兰投分更无殊。\n凤池晚接经邦论，龙陛晨陪步武趋。\n起副民瞻方倚赖，用为霖雨待昭苏。\n如何奄忽公先逝，自叹灵光老益孤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35898,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中书侍郎傅公挽词 其二","author":"文彦博","text":"贤业虽长命不融，从来此恨古今同。\n为霖作砺君家事，未尽舒张数已穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35899,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中书侍郎傅公挽词 其三","author":"文彦博","text":"常爱龙潭龟岛上，移床醉卧绿髯中。\n茂林脩竹皆如旧，惟叹人琴遂一空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35900,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"致政仲损工部哀词　 其一","author":"文彦博","text":"自昔朋游今五纪，断金连璧附英翘。\n学通经史蒙三益，心类松筠见久要。\n白首郎潜甘寂寞，清时吏隐甚逍遥。\n年逾九九诚无慊，惟叹人亡与道消。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35901,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"致政仲损工部哀词　 其二","author":"文彦博","text":"金兰取友务端良，仲损于余极久长。\n蚤岁倾怀论管鲍，晚年脩好结潘阳。\n人琴忽起芝焚叹，箫鼓俄随薤挽伤。\n不到寝门亲一恸，临风老泪独浪浪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35902,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"太尉韩国文忠富公哀词 其一","author":"文彦博","text":"蚤擅才名重，天资德望崇。\n大勋缘定策，美利在和戎。\n一代推人杰，三朝倚栋隆。\n音容虽已矣，永誉更无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35903,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"太尉韩国文忠富公哀词 其二","author":"文彦博","text":"鼌董经邦策，皋夔济世贤。\n频坚挂冠请，未及纵心年。\n蚤遂赤松伴，晚参黄檗禅。\n悬车垂一纪，筑室冠三川。\n潇洒山中相，优游地上仙。\n尊荣兼寿考，五福在公全。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35904,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"太尉韩国文忠富公哀词 其三","author":"文彦博","text":"我愧才无取，公常问不能。\n白麻曾并命，黄阁遂同升。\n调燮彝伦叙，将明庶绩凝。\n如仁今奄忽，昭代失良肱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35905,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"太尉韩国文忠富公哀词 其四","author":"文彦博","text":"去年春作耆英会，一坐簪绅仰典刑。\n今日共嗟天不慭，惟瞻英范在丹青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35906,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"太尉韩国文忠富公哀词 其五","author":"文彦博","text":"达观定知无怛化，常情未免怆离魂。\n邛山土厚虽埋玉，遗烈馀芬万古存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35907,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"故开府太师王公挽词太子太师 其一","author":"文彦博","text":"蚤岁驰声犹未冠，锦标独得冠词林。\n四朝出处身名泰，五纪游从事契深。\n居守北郊依旧德，退休西洛负初心。\n白龙泉畔青乌兆，引绋悲讴泪满襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35908,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"故开府太师王公挽词太子太师 其二","author":"文彦博","text":"昔年壶洛赴三城，华发青云叙故情。\n今日人琴俱已矣，犹传乐府沁园声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35909,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"故开府太师王公挽词太子太师 其三","author":"文彦博","text":"天圣年中始得朋，后陪孟洛两交承。\n追思往事浑如梦，老泪如倾自不胜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35910,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"故开府太师王公挽词太子太师 其四","author":"文彦博","text":"前岁公图归洛中，待君同赏状元红。\n人间万事难如意，须把兴亡付坏空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35911,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"楚正议挽词三章 其一","author":"文彦博","text":"出处交游五十春，洛城晚岁卜亲邻。\n东斋锦襻清谈处，今日重来泪满襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35912,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"楚正议挽词三章 其二","author":"文彦博","text":"大抵神存体不留，万安山下宅松楸。\n平生燕集歌欢友，伯寿应同泉下游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35913,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"楚正议挽词三章 其三","author":"文彦博","text":"每读龟书鸿范篇，人间五福是高年。\n公年九九虽无慊，散尽耆英我屹然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35914,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初知榆次县题新衙鼓上","author":"文彦博","text":"置向谯楼一任挝，挝多挝少不知他。\n如今幸有黄紬被，努出头来道放衙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35915,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠李戡","author":"文彦博","text":"昌元建邑几经春，百里封疆秀气匀。\n鸭子池边登第客，老鸦山下著棋人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35916,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"依漾园池上即事","author":"文彦博","text":"莫问竹风来不来，竹间已自绝尘埃。\n贪看池上能言鸭，小立桥边称意苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35917,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诗一首","author":"文彦博","text":"楚泽荃蘅尽化蓬，自须高谢脱池笼。\n从知鸠鸟真无赖，犹使瑶台关有娀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35918,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"睢阳五老图","author":"文彦博","text":"辅政何时退省闲，清平告老谢簪冠。\n两朝耆宿真英武，一代谋谟实柱桓。\n太史尚瞻星有烈，小民犹念德无寒。\n谁知我辈登枢要，严貌冰威祗肃看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35919,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"双泉","author":"文彦博","text":"长剑并弹霜气豪，白虹半折秋云高。\n濯缨洗耳更何处，世人回看轻鸿毛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35920,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"溴水","author":"文彦博","text":"潺湲北山水，缭绕南城皋。\n晴滩锦石乱，击触春湍高。\n谁谓溴梁大，不能容鲂鱽。\n临流自缩手，揭厉应徒劳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35921,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"草堂肖遥寺","author":"李章","text":"罗什留真嗣，重扉掩碧松。\n邻僧来紫阁，远径接圭峰。\n雨气晴先润，庭阴午后浓。\n依稀祖师意，瘦倚一枝筇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35922,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"李章","text":"愿求裴令一篇诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35923,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和气致祥诗","author":"裴湘","text":"君德奉天道，冲融协太和。\n卿云呈瑞早，膏泽应时多。\n煦集连枝木，嘉扶异颖禾。\n五星还聚井，丹凤更巢阿。\n薮泽无遗士，边防久息戈。\n黔黎逢至化，稽首载赓歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35924,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"杨士彦","text":"江气南吞吴分野，海波北撼楚封陲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35925,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"跨鳌亭","author":"李楫","text":"紫金高处是鳌头，独负华堂几百秋。\n形势平吞北梦泽，规摹雄峙南司州。\n三关设险知无敌，八相风流孰与俦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35926,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"车盖亭","author":"李楫","text":"白兆山光相掩映，紫金气象转深幽。\n水西咫尺无人到，乘兴何妨一叶舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35927,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"李楫","text":"令人却忆保宁寺，二水三山李白诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35928,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"钱仙芝","text":"乘秋张翰思归国，垂老龟蒙毕著书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35929,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送张无梦归天台","author":"慎镛","text":"暂御飙轮谒冕旒，却思挥袂揖浮丘。\n日边已奉崆峒问，尘外还随汗漫游。\n玉座荣颁天藻丽，石桥危过雨苔秋。\n吾皇清净延高蹈，云水无心本自由。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35930,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题桐柏观","author":"元积中","text":"九峰巍绝乱云屯，石室琼台旧址存。\n山险密盘之字径，洞深高辟丙方门。\n碧桃花烂春溪暖，紫玉箫沉月榭昏。\n未觉壶中光景晚，人间归去见来孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35931,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题安国寺","author":"元积中","text":"绕县江山翠剪裁，舣舟亭下重徘徊。\n昔承官乏因曾到，今按刑章得再来。\n井邑半迷新巷陌，园林犹认旧亭台。\n静思三十年前事，恍若邯郸一梦回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35932,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"元积中","text":"江东一十州，宜城名善地。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35933,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送钤辖馆使王公二首 其一","author":"张靖","text":"保塞昔年尝闭垒，甘陵今岁又劳师。\n将军镇蜀功多少，不见干戈出虎皮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35934,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]