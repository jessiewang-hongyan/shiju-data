[{"title":"瑞鹧鸪 为婶寿","author":"赵彦端","text":"芙蓉池馆一重重。\n留得黄花寿斝中。\n春到小春如有信，月临良月正相同。\n芝兰美应瑶阶瑞，苹藻香吹翠沼风。\n此夜隔墙闻凤管，人间元自胜蟾宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46232,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"虞美人 其一","author":"赵彦端","text":"断蝉高柳斜阳处。\n池阁丝丝雨。\n绿檀珍簟卷猩红。\n屈曲杏花蝴蝶、小屏风。\n春山叠叠秋波慢。\n收拾残针线。\n又成娇困倚檀郎。\n无事更抛莲子、打鸳鸯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46233,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"虞美人 其三 罢官嘉禾，张忠甫、曾彦思置酒舟中作","author":"赵彦端","text":"兰畦梅径香云绕。\n长恨相从少。\n相从虽少却情亲。\n不道相从频后、是行人。\n行人未去犹清瘦。\n想见相分后。\n书来梅子定尝新。\n记取江东日暮、雨还云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46234,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"虞美人 其二","author":"赵彦端","text":"凌虚风马来无迹。\n水净山光出。\n松间孤鹤睡残更。\n唤起缑箫飞去、与云平。\n新亭聊共丰年悦。\n一醉中秋月。\n江山拟作画图临。\n乐府翻成终胜、写无声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46235,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"虞美人 其一 九月饮乘风亭故基","author":"赵彦端","text":"烟空磴尽长松语。\n佳处遗基古。\n道人乘月又乘风。\n未用秋衣沈水、换薰笼。\n两峰千涧依稀是。\n想像诗翁醉。\n莫惊青蕊后时开。\n笑倒江南陶令、未归来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46236,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"虞美人 其二 刘帅生日","author":"赵彦端","text":"疏梅淡月年年好。\n春意今年早。\n迎长时节近佳辰。\n看取衮衣黄发、画麒麟。\n酒中倒卧南山绿。\n起舞人如玉。\n风流椿树可怜生。\n长与柳枝桃叶、共青青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46237,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹊桥仙 其三 送路勉道赴长乐","author":"赵彦端","text":"留花翠幕，添香红袖，常恨情长春浅。\n南风吹酒玉虹翻，便忍听、离弦声断。\n乘鸾宝扇，凌波微步，好在清池凉馆。\n直饶书与荔枝来，问纤手、谁传冰碗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46238,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹊桥仙 其四 二色莲","author":"赵彦端","text":"藕花亭上，无尘无暑，滟滟一池秋韵。\n绿罗宝盖碧琼竿，翠浪里、亭亭月影。\n一家姊妹，两般梳洗，浓淡施朱傅粉。\n夜深风露逼人怀，问谁在、牙床酒醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46239,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹊桥仙 其二 正月二十三日秀野堂作","author":"赵彦端","text":"江梅仙去，蜡梅蜂化，只有缃梅呈秀。\n不知春在阿谁边，试与问、青青杨柳。\n小园幽事，中都风味，斗草分香依旧。\n东风莫谩送扁舟，为管取、轻寒罗袖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46240,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹊桥仙 其一","author":"赵彦端","text":"来时夹道，红罗步障，已换青丝翠羽。\n春愁元自逐春来，却不肯、随春归去。\n千觞美酒，十分幽事，归到只愁风雨。\n凭谁传语牡丹花，为做取、东君些主。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46241,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"滴滴金 送路彦捷赴仪真","author":"赵彦端","text":"澄溪暝度轻澌白。\n对平湖、澹烟隔。\n我与征鸿共行人，更张灯留客。\n东园半是馀花迹。\n料仙帆、到时发。\n若倚江楼望清淮，为殷勤乡国。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46242,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蕊珠闲","author":"赵彦端","text":"浦云融，梅风断，碧水无情轻度。\n有娇黄上林梢，向春欲舞。\n绿烟迷昼，浅寒欺暮。\n不胜小楼凝伫。\n倦游处。\n故人相见易阻。\n花事从今堪数。\n片帆无恙，好在一篙新雨。\n醉袍宫锦，画罗金缕。\n莫教恨传幽句。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46243,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝶恋花 其一 赠别赵邦才席上作","author":"赵彦端","text":"堂外溪桥杨柳畔。\n满树东风，更著流莺唤。\n时节清明寒暖半。\n秦筝欲妒歌珠贯。\n一寸离肠无可断。\n旧管新收，尽记双帷卷。\n赖得今年春较晚。\n送人犹有馀红乱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46244,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝶恋花 其二","author":"赵彦端","text":"雪里珠衣寒未动。\n雪后清寒，惊损幽帷梦。\n风撼海牛帘幕重。\n画檐冰箸如流汞。\n一穗香云佳客共。\n溜溜金槽，政尔新词送。\n酒戏诗阄忘百中。\n烛间有个人非众。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46245,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉蓬莱 梅","author":"赵彦端","text":"向蓬莱云渺。\n姑射山深，有春长好。\n香满枝南，笑人间惊早。\n试问寒柯，镂冰裁玉，费化工多少。\n东阁诗成，西湖梦觉，几番清晓。\n好是罗帏，麝温屏暖，却恨烟村，雨愁风恼。\n一一清芬，为东君倾倒。\n待得明年，翠阴青子，荫凤皇池沼。\n更把阳和，从头付与，繁花芳草。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46246,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其七 文秀","author":"赵彦端","text":"绰约娇波二八春。\n几时飘谪下红尘。\n桃源寂寂啼春鸟，蓬岛沈沈锁暮云。\n丹脸嫩，黛眉新。\n肯将朱粉污天真。\n杨妃不似才卿貌，也得君王宠爱勤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46247,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其三 欧懿","author":"赵彦端","text":"月□金□□□□。\n素娥何事下天衢。\n翩翩舞袖穿花蝶，宛转歌喉贯索珠。\n帘翡翠，枕珊瑚。\n锦衾冰簟象床铺。\n春光九十羊城景，百紫千红总不如。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46248,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其五 刘雅","author":"赵彦端","text":"醉捻花枝舞翠翘。\n十分春色赋妖娆。\n千金笑里争檀板，一搦纤围间舞腰。\n行也媚，坐也娇。\n乍离银阙下青霄。\n檀郎若问芳笄记，二月和风弄柳条。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46249,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其六 欧倩","author":"赵彦端","text":"梅粉新妆间玉容。\n寿阳人在水晶宫。\n浴残雨洗梨花白，舞转风摇菡萏红。\n云枕席，月帘栊。\n金炉香喷凤帏中。\n凡材纵有凌云格，肯学文君一旦从。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46250,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其一 羊城天下最号都会，风轩月馆，艳姬角妓，倍于他所，人以群仙目之，因赋十阙鹧鸪天萧秀","author":"赵彦端","text":"一□青春正及笄。\n蕊珠仙子下瑶池。\n箫吹弄玉登楼月，弦拨昭君未嫁时。\n云体态，柳腰肢。\n绮罗活计强相随。\n天教谪入群花苑，占得东风第一枝。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46251,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其一 白鹭亭作","author":"赵彦端","text":"天外秋云四散飞。\n波间风艇一时归。\n他年淮水东边月，犹为登临替落晖。\n夸客胜，数星稀。\n晚寒拂拂动秋衣。\n酒行不尽清光意，输与渔舟睡钓矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46252,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其四 桑雅","author":"赵彦端","text":"云暗青丝玉莹冠。\n笑生百媚入眉端。\n春深芍药和烟拆，秋晓芙蓉破露看。\n星眼俊，月眉弯。\n舞狂花影上栏干。\n醉来直驾仙鸾去，不到银河到广寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46253,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其九 杨兰","author":"赵彦端","text":"两两青螺绾额傍。\n彩云齐会下巫阳。\n俱飞蛱蝶尤相逐，并蒂芙蓉本自双。\n翻彩袖，舞霓裳。\n点风飞絮恣轻狂。\n花神只恐留难住，早晚承恩入未央。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46254,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其二 萧莹","author":"赵彦端","text":"花动仪容玉润颜。\n温柔袅娜趁清闲。\n盈盈醉眼横秋水，淡淡蛾眉抹远山。\n膏雨霁，晓风寒。\n一枝红杏拆朱阑。\n天台迥失刘郎路，因忆前缘到世间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46255,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其三 为韩漕无咎寿","author":"赵彦端","text":"忆醉君家倚翠屏。\n年年相喜鬓毛青。\n谁知缓步从天下，犹许清弹此地听。\n挥羽扇，写鹅经。\n使星何似老人星。\n几时一试薰风手，今日桐阴又满庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46256,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其八 王婉","author":"赵彦端","text":"未有年光好破瓜。\n绿珠娇小翠鬟丫。\n清肌莹骨能香玉，艳质英姿解语花。\n钗插凤，鬓堆鸦。\n舞腰春柳受风斜。\n有时马上人争看，擘破红窗新绛纱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46257,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其一 总咏","author":"赵彦端","text":"一簇神仙会见奇。\n誓夸苏小与西施。\n怜轻镂月为歌扇，喜薄裁云作舞衣。\n牙板脆，玉音齐。\n落霞天外雁行低。\n看看各得风流侣，回首乘鸾旧路归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46258,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其四 上元孙长父郎中坐上次仲益尚书赠玉奴韵","author":"赵彦端","text":"拂拂深帏起暗尘。\n清歌缓响自回春。\n月知灯市云间堕，人对梅花雪后新。\n杯掌露，舞衣云。\n酒慵微觉翠鬟倾。\n洞房不压阳台雨，乞与游人弄晚晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46259,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其二 送王漕侍郎奏事","author":"赵彦端","text":"渺渺东风拂画船。\n不堪临雨落花前。\n清歌只拟留春住，好语频闻有诏传。\n秦望月，镜湖天。\n养成英气自当年。\n两山总是经行处，献纳雍容定几篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46260,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其二","author":"赵彦端","text":"水暖池塘閒睡鸭，烟深村落自鸣鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46261,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其一","author":"赵彦端","text":"新梢渐变鹅黄色，浅水遥添鸭绿纹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46262,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其三","author":"赵彦端","text":"来日泥香催燕子，归时桑老趁蚕收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46263,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋声","author":"赵彦镗","text":"纷纷败叶扑西风，呖呖征鸿度碧空。\n咿咿菱歌烟暝外，丁丁衣杵月明中。\n潇潇细滴蕉窗雨，唧唧悲鸣草砌蛩。\n忽忽有怀如宋玉，行行搔首思冲冲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46264,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游虎丘","author":"赵彦橚","text":"文书穷日几时休，得得寻幽到虎丘。\n望处平芜迷远近，林端飞鸟去夷犹。\n吴王事古遗人恨，西子名存逝水流。\n从昔邦君多赋咏，可无一事继前修。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46265,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游裴公亭 其二","author":"赵恒","text":"溶溶春水碧生池，上相临观许从随。\n万姓歌呼喜游豫，几人出处佩安危。\n雨馀空谷云归早，风满长林鸟下迟。\n笳鼓明当催晓发，柳烟花露湿旌旗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46266,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游裴公亭 其一","author":"赵恒","text":"昔年曾此远风尘，盘谷烟霞每见分。\n万里江河还壮观，一时冠盖属元勋。\n海鸥春暖眠沙草，辽鹤秋高度岭云。\n今日重来倍惆怅，草堂应是勒移文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46267,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送梁府教赴括苍任","author":"赵恬斋","text":"闻得官期三月初，此行最喜奉潘舆。\n杏花风暖好觅句，槐影日长宜读书。\n垂世文章星有斗，随缘富贵水成渠。\n少须岁月朝天去，半夜金莲归直庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46268,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杨十七应之兄学士挽辞","author":"赵挺之","text":"廓落襟怀德艺优，身名曾不问沈浮。\n当年册府曾同命，早岁文场每并游。\n寂寂旧庐东观晓，翩翩归旐北邙秋。\n都城犹记樽前别，精爽今随逝水流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46269,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"朱氏天和堂","author":"赵挺之","text":"华亭山水佳，秀色宛如画。\n前贤有隐迹，卜筑俟来者。\n高人养天和，放浪寄林野。\n安知岁月徂，但喜名利舍。\n传家得之子，流辈推博雅。\n春风振客衣，逸棹东南下。\n赋诗台阁彦，落落珠玑泻。\n持觞拜亲膝，喜色动乡社。\n都城十二衢，尘土翳车马。\n一梦逐君行，兹怀已潇洒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46270,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送罗正之年兄出使二浙","author":"赵挺之","text":"相逢三十春，欢宴殊未足。\n都门今见君，行意一何速。\n正之南国秀，德业素所畜。\n才名振京师，贤达竞推毂。\n当年诸邑政，惠爱春兰馥。\n惟思结恩信，几欲弛鞭扑。\n一朝使王畿，茂草鞠圜狱。\n高怀富经纶，馀事归简牍。\n风骚入冥搜，落笔动盈幅。\n忠诚人所怀，正直神介福。\n轻舟扬高旌，锦袂耀乡服。\n西风浙江远，秋色方在目。\n欢声溢闾巷，喜气沾僮仆。\n东南岁仍饥，仁主意方属。\n君才固有馀，足以振疲俗。\n行闻变潢潦，千里尽平陆。\n功成办归装，来赴严君促。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46271,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"妙峰亭","author":"赵䈣夫","text":"尘世有仙境，清绝不可言。\n寒江露沙迹，晚嶂埋云根。\n暇日推吏案，呵道穿僧门。\n来饮岩下水，何必携芳樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46272,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"大小寒","author":"赵某","text":"蹇卫冲风怯晓寒，也随举子到长安。\n路人莫作皇亲看，姓赵如今不似韩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46273,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游都梁 其二","author":"赵某","text":"才入都梁郡，愁登第一山。\n不堪高处望，未得故疆还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46274,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游都梁 其一","author":"赵某","text":"暮烟迷海戍，远水接淮天。\n拍塞凭栏恨，神京在北边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46275,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"休官","author":"赵某","text":"欲知赵子休官了，贫似扶风马少游。\n借得琴樽留待月，从教帘幕不胜秋。\n自携仆出閒寻药，因载书多却买舟。\n昨日老农来告我，万千乐事在西畴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46276,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杏村闻其友谢昌元及二赵一家俱入翰苑","author":"赵某","text":"归来白鹿岩边屋，清得门庭冷似冰。\n公事中原双短鬓，帝乡孤梦一青灯。\n带烟锄菊閒教仆，和月折梅时寄僧。\n见说道山应咫尺，同时俊彦尽先登。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46277,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"述怀","author":"赵某","text":"得鹿归来一梦中，半生事业总成空。\n饭牛岂意干西伯，寻马何须访北翁。\n赵既有辞难夺璧，楚将无事叹忘弓。\n南薰正解吾民愠，且弄朱弦奏晚风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46278,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"眉峰水陆寺","author":"赵某","text":"贪观眉妩翠，舣棹碧云间。\n萧寺前临水，丁家旧住山。\n苔深僧迹静，松冷鹤巢鳏。\n拜手先祠下，奔驰觉汗颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46279,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄高善胜","author":"赵某","text":"雨窗思昔日，不见半年馀。\n别后几回梦，中间三寄书。\n兵戈吾幸免，踪迹尔何如。\n世事难如意，同心却异居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46280,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清发轩","author":"赵某","text":"许多清意思，都在此乡间。\n有石半枕水，无窗不面山。\n侵衣青霭润，拥钓白云閒。\n未许嫌幽寂，古人曾闭关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46281,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题浯溪","author":"赵某","text":"元颂颜书□□□，好风吹我过三吾。\n倚空□□烟云□，□古兴亡草木枯。\n读尽□□留□□，□□□□较锱铢。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46282,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"失调名","author":"赵某","text":"□□□□皆乃，□□流垂□，断崖依旧横碧。\n□□独有千古文章，铿鍧炳耀，不与名□。\n□□□□□□，□□□□，□尽□□远□。\n□□□□□□，不□□拳石。\n举杯相属，坐还有此客。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46283,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜警","author":"赵济","text":"满城警柝喧深夜，半壁青灯动客心。\n烽火未除眠不得，欲将长剑倚危岑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46284,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赏莲","author":"赵济","text":"芒鞋竹杖踏晴沙，云白山青老岁华。\n太极一丸融造化，赏心应不为荷花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46285,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"兴庆池禊宴","author":"赵济","text":"抚封占清境，禊宴协良辰。\n物态随春秀，歌声洽政淳。\n撷芳寻陌绮，泛棹击波鳞。\n天幸陪开府，非才愧席宾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46286,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"大涤洞天留题","author":"赵珂夫","text":"九锁山藏一洞天，栖真大涤洞巍然。\n云根石出仙人迹，天柱峰流漱玉泉。\n丹凤岩前游熟路，翠蛟亭上揖来贤。\n我儿祷旱朝龙井，一雨昭苏大有年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46287,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"赵绛夫","text":"取水观为政。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46288,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题义门胡氏华林书院","author":"赵赴","text":"家隐西山下，华林地绝尘。\n门旌千古义，学聚四方人。\n道致清云富，名随白日新。\n他年应许我，猿鹤一相亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46289,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"感怀","author":"赵轸","text":"群鳞戏清波，天青云影白。\n濯足歌沧浪，一笑天地窄。\n山色秀而深，都言秘神物。\n眼底有真龙，何必云中觅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46290,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠令狐使","author":"赵郡守","text":"□城昔有山，登临倚空阔。\n震淩谁负舟，荆榛披雉堞。\n朅来亦期年，每每念陈迹。\n虽当补苴时，忍使胜览绝。\n度材仿飞翚，开径通游辙。\n盍簪领嘉宾，举酬及良夕。\n风清无规尘，夜寒听伊笛。\n茫渺挹天根，淡荡浮月魄。\n景色逐时新，诗联怀古刻。\n楼成且志喜，平畴剩秋穑。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46291,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"千秋岁","author":"赵闻礼","text":"莺啼晴昼，南国春如绣。\n飞絮眼，凭阑袖。\n日长花片落，睡起眉山斗。\n无个事，沉烟一缕腾金兽。\n千里空回首。\n两地厌厌瘦。\n春去也，归来否。\n五更楼外月，双燕门前柳。\n人不见，秋千院落清明后。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46292,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水龙吟 水仙花","author":"赵闻礼","text":"几年埋玉蓝田，绿云翠水烘春暖。\n衣薰麝馥，袜罗尘沁，凌波步浅。\n钿碧搔头，腻黄冰脑，参差难剪。\n乍声沉素瑟，天风佩冷，蹁跹舞、霓裳遍。\n湘浦盈盈月满。\n抱相思、夜寒肠断。\n含香有恨，招魂无路，瑶琴写怨。\n幽韵凄凉，暮江空渺，数峰清远。\n粲迎风一笑，持花酹酒，结南枝伴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46293,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"风入松","author":"赵闻礼","text":"曲尘风雨乱春晴。\n花重寒轻。\n珠帘卷上还重下，怕东风、吹散歌声。\n棋倦杯频昼永，粉香花艳清明。\n十分无处著闲情。\n来觅娉婷。\n蔷薇误罥寻春袖，倩柔荑、为补香痕。\n苦恨啼鹃惊梦，何时剪烛重盟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46294,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]