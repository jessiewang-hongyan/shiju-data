[{"title":"丁卯秋八月奉檄住嘉兴先福寺","author":"释行海","text":"无端檄下白云中，水国迢迢宋梵宫。\n草入空斋随意绿，花开野地向人红。\n夕阳每感皈巢鸟，秋色偏怜出塞鸿。\n一个闲身闲不彻，风霜添得鬓成翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12741,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"丁未昏 其一","author":"释行海","text":"异乡芳草故乡情，闻道烟烽满旧京。\n林下岂无贤圣迹，城中唯有管弦声。\n水流云散成寥落，花笑莺啼做太平。\n今日已无荣辱念，此山深处寄浮生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12742,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"丁未昏 其二","author":"释行海","text":"极目东南王气浮，雨馀春色满皇州。\n看花不饮翻如醉，听角无心亦自愁。\n吴越是非残客梦，山川今古白人头。\n殷勤更向楼中望，只有孤云得自由。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12743,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"丁未","author":"释行海","text":"独住云边旧草堂，恨无微力答吾皇。\n又惊烽火交丁未，暗惜山河到靖康。\n塞马病衔秋草白，乡兵泣对野花黄。\n年来喜报残金灭，歌舜歌尧入乐章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12744,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十月吴中感怀","author":"释行海","text":"耳热酣歌向朔风，山河泽国旧吴宫。\n人生莫羡仓中鼠，世事须知塞上翁。\n大雪风光寒草绿，小春天气野花红。\n高堂白首无来信，一点乡心逐塞鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12745,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与中上人至云间话别","author":"释行海","text":"寒云漠漠浦悠悠，短棹同登八月秋。\n一寸不磨心似铁，四方无定迹如鸥。\n江乡雁过蒹葭冷，雨馆人分蟋蟀愁。\n相见有期还惜别，百年能得几交游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12746,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"云泉禅师哀词","author":"释行海","text":"一片禅心无用处，蘋花溪上看垂纶。\n也知白璧黄金贵，何似青鞋布袜贫。\n吟畔山川生哭泣，笔头兰竹露精神。\n如今云散泉流去，淡日凄风杂野尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12747,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"元日","author":"释行海","text":"北山猿鹤久为邻，闲里生涯梦里人。\n旅思经时偏感旧，物华今日又从新。\n棹歌堤上水烟晚，笛奏江南梅柳春。\n五道寂寥先辈尽，自惭无补面生尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12748,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"壬子七月","author":"释行海","text":"茫茫宇宙事如何，夕菊朝兰宛转歌。\n陌上柳条谁折尽，客中秋思夜来多。\n阳春欲奏朱弦断，江水长流白鸟过。\n一自五湖人散后，更无魂梦出烟萝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12749,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"壬申春寓旧馆偃山房有感而作","author":"释行海","text":"旧馆迟留春欲暮，小山林石带平原。\n自怜萍迹随流水，每到花时感故园。\n鸟啄雨墙红落杏，蝶翻风砌绿抽萱。\n十年未遂东归计，白发慈亲独倚门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12750,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"天竺书怀","author":"释行海","text":"满山风露正秋深，石井栏边蛩夜吟。\n黄叶随流如有约，白云归岫亦无心。\n拟同猿鸟消闲日，别卜烟霞入远林。\n毕竟一荣还一辱，百年何用觅知音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12751,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"天竺有怀","author":"释行海","text":"白日闭门亦懒开，门前日日起尘埃。\n人无旧分言难托，道有同心信不来。\n黄菊一篱秋冷淡，碧云千里暮徘徊。\n去年忆得寒江畔，君上孤舟我独回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12752,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"天竺浮寻小楼","author":"释行海","text":"楼倚飞来小朵峰，每因动业思重重。\n三千日月欺王母，百二山河误祖龙。\n石浅易知丹井味，洞深难见白云踪。\n自惭半座分花雨，无复人听夜讲钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12753,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"天竺谢竹心陈通判见访 其二","author":"释行海","text":"三十馀年别剡川，一瓢分饮葛洪泉。\n当时玄度寻支遁，今日昌黎欠大颠。\n游宦石头怀往事，伤心瓜步梗来船。\n盍应借箸趋前列，北面风寒快著鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12754,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"天竺谢竹心陈通判见访 其一","author":"释行海","text":"紫袍乌帽马蹄轻，晓浥秋山桂露清。\n慷慨剧谈当世事，艰难方见故人情。\n杏园旧宴魁麟笔，莲幕重开佐凤城。\n青琐玉堂殊有待，江淮何日可休兵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12755,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"太后永寿寺方丈紫芝","author":"释行海","text":"方丈山中草亦灵，参差小朵结菁英。\n玉团紫气晴霞淡，金缕红光晓日明。\n四皓自餐商谷稳，九茎曾见泰阶平。\n蟠桃春色应同永，香比蟾枝此更清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12756,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"风浪阻行再获聚首故作是诗","author":"释行海","text":"鱼龙吹浪阻行舟，又得相寻暂聚头。\n不是于君多惜别，自缘今日少交游。\n斜风细雨吴天远，芳草垂杨越路愁。\n昨夜不知人未去，误教魂梦过南州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12757,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东掖怀天竺","author":"释行海","text":"十年心事已蹉跎，吴越兴亡付绿波。\n衰鬓又惊黄叶落，故乡遥认白云多。\n葛洪井畔三生石，处士梅边十里荷。\n总是平生快心处，夜长无奈月明何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12758,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"归剡 其五","author":"释行海","text":"处处溪山得趣真，不曾富贵不曾贫。\n梦中觅句浑如醒，秋后看花亦似春。\n未许黄金酬苦节，祇应白鸟伴闲身。\n门前一径苍苔色，终岁喜无车马尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12759,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"归剡 其四","author":"释行海","text":"流水东流竟不回，已将心事作寒灰。\n窗前白鸟寻常过，篱下黄花寂寞开。\n玉佩金鞍浑是梦，凤箫龙管只堪哀。\n多时不得中原信，暮雨西风雁自来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12760,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"归剡 其三","author":"释行海","text":"天地宽闲鼓角疏，江南烟景忆当初。\n乍归故里仍如客，偏爱沧洲不为鱼。\n草木有心知雨露，楼台回首作丘墟。\n夕阳咏罢餐秋菊，又放青山入弊庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12761,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"归剡 其二","author":"释行海","text":"三十将成道未成，菱花频照意频惊。\n百年得趣非容易，万事无心是太平。\n白雪阳春谁欲听，青鞋布袜世相轻。\n天台庐岳难忘处，泉石皆知旧姓名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12762,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"归剡 其一","author":"释行海","text":"此生书剑学无成，癖爱林泉梦亦清。\n甘苦已知浮世味，亲疏尽见旧交情。\n五湖风月随闲客，十载冰霜对短檠。\n归得又思沧海去，是谁堪结岁寒盟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12763,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戊辰闰正月书怀 其二","author":"释行海","text":"茅屋风光总入诗，今年何事燕归迟。\n繁花犹未竞春色，百舌最先啼晓枝。\n深导竹渠防雨涨，密扶花架恐风攲。\n人生三万六千日，莫负芳菲少壮时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12764,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戊辰闰正月书怀 其一","author":"释行海","text":"一年风景两逢新，老去情怀最惜春。\n未有鸧鹒传好语，岂无蛱蝶报芳辰。\n花林淑气蒸香蔼，柳岸游丝惹曲尘。\n今日晴明聊引兴，倚楼翻作望乡人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12765,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戊辰闰正月书怀 其三","author":"释行海","text":"年年风雨作春愁，天气晴明便出游。\n陌上野梅飘趁屐，水边杨柳碍行舟。\n踏青尚可酬佳节，拾翠如今愧白头。\n近日贪眠长失晓，鸦啼犹拥黑貂裘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12766,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次徐相公韵十首 其六 入塞","author":"释行海","text":"血战胡儿尽堕鞍，一番奏凯一封官。\n兵枭铁鹞威方猛，酒赐金蕉胆不寒。\n雁塞月阴青燐淡，渔阳雪苦紫茸乾。\n胡亡未必胡无种，韬略萦心不放宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12767,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次徐相公韵十首 其四 少马","author":"释行海","text":"龙堪斗健铁为鞍，频载将军战得官。\n逐北蹄奔胡雪滑，嘶边鬣耸朔风寒。\n金镮辔上红缨乱，火印轮中白汗乾。\n草满沙场无暇吃，阵前缰勒不曾宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12768,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次徐相公韵十首 其三 少将","author":"释行海","text":"满身铁甲据金鞍，百战功成始拜官。\n尽阵解围兵势活，分旗夺地戟光寒。\n并吞北虏心长勇，未捷中原泪不乾。\n建立太平终有日，扁舟已爱五湖宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12769,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次徐相公韵十首 其五 出塞","author":"释行海","text":"红罗抹额坐红鞍，阵逐黄旗拨发官。\n秋戍卢龙番鼓哑，夜屯白马虏星寒。\n铁毬步帐三军合，火箭烧营万骨乾。\n兵器徒知是凶器，止戈为武帝心宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12770,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次徐相公韵十首 其一 老将","author":"释行海","text":"战曾无甲马无鞍，谏猎书生贱武官。\n每忆云中擒虏健，几番雪里枕戈寒。\n箙留响箭机心在，袍损团花血点乾。\n间拍旧弓怜臂力，更怜西北战场宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12771,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次徐相公韵十首 其九 李显忠","author":"释行海","text":"五丈高原跃战鞍，同州太守旧藩官。\n路挑野斗皈南急，旗猎风鸣带北寒。\n采石盘中兵胆涌，橘红袍上箭痕乾。\n鸡豚放却西元帅，只要当时国步宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12772,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次徐相公韵十首 其十 魏胜","author":"释行海","text":"第一山东逐虏鞍，平淮命作守淮官。\n英雄内比黄金贵，死斗牙穿毒箭寒。\n雨洒红刀胡血滴，风披斑甲虎皮乾。\n功高孤竹今如此，旧恨茫茫沧海宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12773,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"纪感","author":"释行海","text":"吴楚经年杀气凝，艰难国步涉春冰。\n义旗东下谁相似，誓楫中流我不能。\n水到南徐围铁瓮，山从北固抱金陵。\n捷音尚隔苍茫外，貂尾良弓足股肱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12774,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自嘉兴归天竺怀同友","author":"释行海","text":"九月游吴菊盛开，洞庭不去为君回。\n病归故里留书在，约到明年看驾来。\n宾客过门题姓字，菖蒲别主染尘埃。\n谁知独向秋风里，静倚山窗对绿苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12775,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西湖早春","author":"释行海","text":"多时不向柳边来，每个幽亭坐一回。\n春哢未容莺燕闹，芳心犹待杏桃开。\n飘摇水面渔舟稳，宛转风前玉笛哀。\n太乙清都五云表，冷香空锁御园梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12776,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"吴中作","author":"释行海","text":"吴王废苑又逢秋，门外沧江日夜流。\n有泪不同儿女态，此心多为圣贤愁。\n蓼开南浦雁离塞，月上前峰客倚楼。\n金户玉堂无梦到，云山亦足比封侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12777,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"怀方山人","author":"释行海","text":"养花天气雨濛濛，意欲相寻去未通。\n自少江湖同苦乐，如今灯火各西东。\n百年总是难忘日，一信无由托便风。\n曾共月明岩上坐，思君还在月明中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12778,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"怀珦潜山","author":"释行海","text":"楚雨吴烟动客思，江梅发后失归期。\n传来踪迹浑无定，飘泊情怀已可知。\n鼓角每惊多事日，莺花空度少年时。\n与君如此长相别，苦乐同心更有谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12779,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"时在临云寄虎溪侃直山","author":"释行海","text":"白首归看旧种松，十年相别此相逢。\n近疏面会因多雨，似隔天涯只一峰。\n数树绿烟铺薜荔，半池红露泣芙蓉。\n故乡迢递故人少，江北江南思万重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12780,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"言诗","author":"释行海","text":"句织天机字字难，冥搜长在寂寥间。\n每惊白雪阳春变，未放光风霁月闲。\n子美到今谁是史，仲尼亡后不曾删。\n衰吾欲话平生志，安得重逢饭颗山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12781,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赤城","author":"释行海","text":"玉京仙额篆封苔，密密春云洞不开。\n白蟒降时凭铁锡，红霞飞处接瑶台。\n林幽怪石如人立，夜静空山有鬼哀。\n一曲凤箫声已断，释签岩下独徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12782,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"辛亥春别湖上诸友","author":"释行海","text":"江南花信厌春寒，乡路迢迢去亦难。\n不解趋时人笑拙，每怀归计自求安。\n明朝芳草空相忆，何处青山复共看。\n二十八年清苦志，独歌白雪对幽兰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12783,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和汤秘书见寄韵","author":"释行海","text":"书剑冲寒到日边，烟霞曾结几生缘。\n醉邀明月逢梅醒，啸入青山对竹眠。\n老晤庄周为蝶后，谁思腐草化萤前。\n新诗自有经纶志，乘兴莫将红叶偏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12784,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和浩师书事","author":"释行海","text":"平原漠漠带晴川，秋草秋风又一年。\n尧舜不知今日事，烟霞同结几生缘。\n未闻世道如弦直，应怪鸥身似雪鲜。\n临水登山情亦懒，枕书闲向北窗眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12785,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和馨果二友见寄韵","author":"释行海","text":"几度怀归浙水东，无端又下白云中。\n当窗石色寒留雨，出洞猿声静带风。\n崖底碧烟生暮景，树头红子落晴空。\n酷怜后夜芗林月，照我思君处不同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12786,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏梅","author":"释行海","text":"跨蹇寻芳带雪晴，几番溪驿又山程。\n可怜岁晚心偏苦，忽见春风眼倍明。\n浅涧石边留野趣，矮篱竹外托幽情。\n繁华满地凋零尽，难写夷齐一种清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12787,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"庚午春作 其一","author":"释行海","text":"相逢处处说干戈，又报天骄走渡河。\n乡国不知音问少，友朋无奈别离多。\n杨花漠漠迷春思，芳草萋萋感暮歌。\n猿鸟亦移深树隐，野人只在旧烟萝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12788,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"庚午春作 其二","author":"释行海","text":"槜李当年是越乡，客情何事忽清凉。\n霜催燕子归南国，露逼虫声上北堂。\n野外几重秋水白，天涯一片暮云黄。\n年年有雁书难寄，无梦到家空夜长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12789,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"明晖阁","author":"释行海","text":"霁色空明宇宙宽，江南佳趣在栏干。\n云蒸列岸青山晓，露湿眠沙白鸟寒。\n极浦风帆侵树杪，夕阳烟景聚檐端。\n目前有句吟难尽，几度登临月下看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12790,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"松","author":"释行海","text":"一树乔乔迥出林，兔丝千尺附清阴。\n怒枝伸缩苍龙臂，翠顶盘桓老鹤心。\n古藓皴皮藏冻蜕，细风入叶转幽琴。\n婆娑独秀青山里，定有茯苓无处寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12791,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"经旧游","author":"释行海","text":"望望东西草色新，杖藜曾逐少年身。\n风烟半是亲题处，泉石多非旧主人。\n黄鸟有情频唤侣，野花无语自伤春。\n闲心一片闲如水，心管悠悠陌上尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12792,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"临清楼","author":"释行海","text":"楼影斜侵贺鉴湖，月随天远极苍梧。\n青山不受秦封禅，白鸟犹惊越霸图。\n烟带夕阳笼野树，雨生春涨没平芜。\n好诗都在栏干上，最喜红尘一点无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12793,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"前之十首次诗 其一","author":"释行海","text":"十五游方今五十，骎骎白尽少年头。\n看来造物真儿戏，忆著平生冷汗流。\n宇宙何须三兔窟，山川总是一菟裘。\n眼前不见江湖处，终是相忘欠白鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12794,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"前之十首次诗 其五","author":"释行海","text":"十五游方今五十，翻思四十九年非。\n守株林下头添雪，掩卷灯前泪滴衣。\n过隙寸阴真可惜，流芳百世不如归。\n沐兰几度弹乌帽，又欲冲天放鹤飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12795,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"前之十首次诗 其四","author":"释行海","text":"十五游方今五十，久将孤锡挂山林。\n平生不作可怜色，是事但求无愧心。\n陌上春回青草暖，天涯人去碧云深。\n满园风滚梅花雪，更有幽禽弄好音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12796,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"前之十首次诗 其二","author":"释行海","text":"十五游方今五十，风霜历尽几风波。\n雌雄自古乌难辨，鱼鲁如今字转讹。\n白日消磨英雄尽，青山埋葬故人多。\n乌啼花发茆庐暖，更喜春风长薜萝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12797,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"前之十首次诗 其三","author":"释行海","text":"十五游方今五十，异乡偏感故乡春。\n吴樯语燕频留客，楚谷蛮莺苦唤人。\n柳瘿冷悬芳信雨，花须暖污阿香尘。\n如今又在长安别，夜夜天边望北辰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12798,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日写怀","author":"释行海","text":"三十馀年吴楚客，如今方觉负初心。\n凌霄神骏怀支遁，高屐貂裘怪惠琳。\n洛浦春光花满树，渭川风景竹成林。\n归来不用鸣长铗，时复一吟梁甫吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12799,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春游","author":"释行海","text":"芳菲时节思悠悠，快与风光汗漫游。\n万物不如花富贵，一春唯有蝶风流。\n仙曾许我黄金骨，天不饶君白雪头。\n随处是家随处客，夜来何事梦沧洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12800,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"洞微翁挽章","author":"释行海","text":"凄凉木末搴芙蓉，万里鹰扬路忽穷。\n箭到红心翻堕地，花成绿子又随风。\n可怜玉兔沉沧海，却放寒乌占碧桐。\n万事看来都是梦，山林犹忆旧英雄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12801,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"癸酉春侨居无为寺归云阁以十五游方今五十为题信笔十首终在五首 其五","author":"释行海","text":"十五游方今五十，几番坎止又流行。\n生来不作千年调，死亦何须五鼎烹。\n周室黍离狼虎国，尧天花蔼凤凰城。\n看山欲跨山中马，却怪一春无好晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12802,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"癸酉春侨居无为寺归云阁以十五游方今五十为题信笔十首终在五首 其四","author":"释行海","text":"十五游方今五十，每嫌屈蠖苦求伸。\n许由不肯为天子，文叔犹能念故人。\n几处池塘初解冻，一时桃杏又争春。\n五湖烟景虽然好，萱砌难忘白发亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12803,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]