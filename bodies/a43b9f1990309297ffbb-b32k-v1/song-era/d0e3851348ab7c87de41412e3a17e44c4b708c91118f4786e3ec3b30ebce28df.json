[{"title":"汉地","author":"赵崇嶓","text":"汉地文书密，胡天岁月深。\n但高苏武节，不察李陵心。\n过雁西风急，荒台朔气沉。\n同生不同恨，万里一沾襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46438,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"立春日舟次藕池阻雪有怀","author":"赵崇嶓","text":"楚泽多芳草，春风昨夜生。\n空江寒欲冻，乱雪洒无声。\n独坐孤舟稳，能忘万里情。\n手持新岁酒，空绕落梅行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46439,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"立春后三日山行喜雨","author":"赵崇嶓","text":"穷冬阳为沴，旱气蒸黄埃。\n春风三夜动，春雨随风来。\n万类萌甲喜，愁人生意开。\n我行竟何事，欣尔登崔嵬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46440,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"立春夜宿西充山驿闻雪","author":"赵崇嶓","text":"独宿西充馆，云雰洒竹关。\n薄寒生永夜，乱响度空山。\n残月犹共白，春风相与还。\n一枝梅未寄，归梦越巴蛮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46441,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"龙翔宫","author":"赵崇嶓","text":"地辟金光界，龙飞析木津。\n指麾开辇路，祠祀拜元辰。\n天近云光煖，花浓雨脉春。\n君王自仁寿，閒杀华封人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46442,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"地僻","author":"赵崇嶓","text":"地僻逢迎少，吾生信杳冥。\n清谈养生论，兀坐太玄经。\n性拙贫逾乐，神清梦数灵。\n亭亭岁寒友，相对眼终青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46443,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过鄱阳湖","author":"赵崇嶓","text":"烟波三万顷，著我木兰船。\n望际疑无地，寰中别有天。\n长空孤鸟没，四海一云连。\n浩荡平生意，南风正渺然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46444,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"识得","author":"赵崇嶓","text":"识得聱牙字，三生拙未除。\n闲居两疏传，馀事二王书。\n老任衣冠古，贫从俎豆疏。\n农人适相告，早晚出犁锄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46445,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"咫尺","author":"赵崇嶓","text":"咫尺越山海，其如千里何。\n祗应怜命薄，不道赋情多。\n坠绾交枝玉，纤围百叠罗。\n清宵无限思，枕席起微波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46446,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"幽居","author":"赵崇嶓","text":"不作无舆叹，幽居体自胖。\n能贫蔬食足，投老敝裘安。\n浊酒融春意，青灯话岁寒。\n外头无限事，忙杀不相干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46447,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"除日万州临江亭","author":"赵崇嶓","text":"南浦逢除日，天涯有去舟。\n蛮城和雨闭，峡水带春流。\n不负新年感，唯多故国愁。\n宁无贺亲酒，徒此事羁囚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46448,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"难忘曲","author":"赵崇嶓","text":"弱花低绣槛，月满绿杨津。\n一笑领深意，过于三月春。\n樽前停妙舞，堂上设华裀。\n上客不须醉，相将夜向晨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46449,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寅卯二年八月十五夜皆不见月","author":"赵崇嶓","text":"万里不自照，清光随雨休。\n可堪幽魄死，还似去年秋。\n有笛悲遥夜，无人在远楼。\n共谁高枕卧，相与梦沧洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46450,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"翠云寺","author":"赵崇嶓","text":"杖屦入云端，天空眼力宽。\n地因山气湿，窗带瀑声寒。\n隐几俗氛远，捲帘僧梦残。\n相逢隐沦者，妙语亦翻澜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46451,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"一莲","author":"赵崇嶓","text":"一莲瓶中枯，一莲池中子。\n结子心虽苦，而犹胜枯死。\n赏心一日期，讵非得生理。\n君看千岁樗，荒郊永沦弃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46452,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"人生叹","author":"赵崇嶓","text":"壮老互沦谢，百年如奔霆。\n竞将无穷忧，劳此有尽形。\n生时一幻化，死即归杳冥。\n亦有贤达人，视死如未生。\n亦有醉梦人，既死心未平。\n逆旅朝暮閒，八风无时停。\n扰扰安足计，熙然慰吾情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46453,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"反挽歌二首 其二","author":"赵崇嶓","text":"死生虽异涂，昭晰本一理。\n崦嵫落圆景，一诀非永逝。\n达人随元化，生死一剧耳。\n生生常痴冥，安知非真死。\n死当安吾归，生当适吾意。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46454,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"反挽歌二首 其一","author":"赵崇嶓","text":"生人送死人，哀哀泪如霰。\n生人阅寒暑，冉冉亦如电。\n来去递相送，展转不可见。\n丘樊谨封殖，陵谷犹有变。\n万古长如斯，何庸致深辩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46455,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"忆昔一首","author":"赵崇嶓","text":"忆昔城南会，佩马轻春风。\n芳华感人心，折赠以为容。\n俯仰一相失，去若南飞鸿。\n青青女萝衣，蔚蔚石上松。\n岁寒无夕秀，安得长相从。\n愿为日月光，落君怀袖中。\n三五如循环，千里宛可同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46456,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代赠","author":"赵崇嶓","text":"双绾玉钗垂，相逢暗敛眉。\n红潮初上脸，未语两心知。\n罗袜凌波拂暗尘，露桃烟柳不胜春。\n珊瑚枝下重相见，曾是鸳鸯梦里人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46457,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"古意","author":"赵崇嶓","text":"阿母带儿出，儿行自回皇。\n儿不倦行路，遣儿心内伤。\n问儿何所伤，儿语不敢详。\n将儿雇织作，不忍织鸳鸯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46458,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"失题","author":"赵崇嶓","text":"白玉谁家郎，红粉何处女。\n秀色总堪怜，春风密相许。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46459,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"失题","author":"赵崇嶓","text":"云台会功臣，际会若风虎。\n独有严子陵，垂竿富春渚。\n相求对幽藐，相知有平素。\n吾寝惟吾真，君意应勿忤。\n归来拂苔石，整我竿上缕。\n煌煌道义间，足以照今古。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46460,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用看云体","author":"赵崇嶓","text":"上有悬石崖，下有滑石道。\n中有观空人，容颜半枯槁。\n坐息穷年岁，抱此希世宝。\n虽然欠奇俊，尘翳已一扫。\n或云大道初，不剩亦不少。\n用力勤修为，苦辛坐中老。\n新州有樵人，此意极了了。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46461,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"田家","author":"赵崇嶓","text":"方春事锄犁，晚节多黍稌。\n鸡豚乐丰岁，一饱轻万事。\n少长情熙熙，呼唤相尔汝。\n虽无礼节拘，气象应近古。\n先进不可期，无怀在农圃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46462,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"白莲","author":"赵崇嶓","text":"池上白莲花，秋风洗香雪。\n坐令红黛皆尘俗，一种凄凉不堪折。\n微波脉脉露光漙，姑射仙人步烟月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46463,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"拟人生不满百","author":"赵崇嶓","text":"人生不满百，譬如朝露晞。\n白日入虞渊，胡不秉烛嬉。\n大耋嗟晷短，多忧亦奚为。\n君看玄庐道，輀车无停时。\n伺晨当及旦，佳会当及期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46464,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"进酒行","author":"赵崇嶓","text":"玉槽夜压葡萄碧，石溜寒泉响凌历。\n水精壶中澄琥珀，醉呼酒星下瑶席。\n小鬟春风花满头，堂堂一曲真珠喉。\n六国三朝春江流，眼花落井消千愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46465,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"饮少","author":"赵崇嶓","text":"平生不善饮，饮少醉已极。\n恨不如渊明，陶陶少虚日。\n桑嵫无停景，寸晷足可惜。\n今人与古人，展转不相识。\n孰能制颓龄，扰扰竟何益。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46466,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"咏竹生花","author":"赵崇嶓","text":"竹老方作花，清气应自结。\n结实成琅玕，中心抱冰雪。\n世人弗肯食，欲献终不屑。\n凤凰在高冈，音响方节节。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46467,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"咏梅","author":"赵崇嶓","text":"大雅终不群，古心应自许。\n对之鄙吝消，疑是黄叔度。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46468,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"征妇怨","author":"赵崇嶓","text":"梧桐叶叶生凉秋，燕山早寒已知遒。\n则则力力叹不休，堂前月光使人愁。\n停针罢线泪沾裳，朔风渐高天雨霜。\n妾忧欲死幸未死，未死犹堪寄衣去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46469,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"松柏","author":"赵崇嶓","text":"松柏生高冈，不依贵者门。\n松柏长青青，却荫贵者坟。\n生非门墙交，而与丘陇亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46470,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"画花歌与曾舜贤","author":"赵崇嶓","text":"小曾与花为莫逆，梦作花神住花国。\n分将天巧入画图，花不役君君自役。\n东风一夜入芳丛，春在烟尘雾雨中。\n披香阅红会花趣，工与造化相流通。\n闭门三月芳事退，马嵬春泥葬香佩。\n临邛道士神不灵，约束丹青驻光彩。\n朱门种花锦作窠，画花绝少种花多。\n百金花价千金画，羞死当年郭橐驼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46471,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"故人","author":"赵崇嶓","text":"故人西南风，遗我一束诗。\n长哦结幽想，慌惚若见之。\n游云霭层霄，聚散安可期。\n虚空闻妙音，意重千金赀。\n相思若行月，一夕天之涯。\n闲窗穿梦魂，碧草春离离。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46472,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日","author":"赵崇嶓","text":"勾芒畅生意，惠风改繁霜。\n日月天清明，桃李春辉光。\n庶情悉萌达，众羽同飞翔。\n乘时各有适，皞皞齐康庄。\n山人感物化，欣惬殊未央。\n回视元气初，万端一微茫。\n我欲观其微，因之问鸿荒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46473,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"美人貌如花","author":"赵崇嶓","text":"美人貌如花，独立古道边。\n芳年抱幽思，艳裔春风前。\n春风固无情，桃李终欲言。\n不剪红豆枝，相思独悬悬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46474,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"适趣","author":"赵崇嶓","text":"赋资在山林，适趣非任放。\n乾坤入我牖，得此一昭旷。\n雨露日以深，禾黍日以长。\n妻儿喜相谓，一饱知可望。\n饭蔬适我愿，此意应勿爽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46475,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读陶诗 其二","author":"赵崇嶓","text":"有篱可种菊，有琴可无弦。\n适趣不待声，种菊真偶然。\n南山有佳气，得意终忘言。\n薄酣空庭中，一笑凉风前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46476,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读陶诗 其一","author":"赵崇嶓","text":"端居洗尘虑，细读渊明诗。\n畴昔慕此翁，寤寐忘调饥。\n此翁非诗人，而有天然姿。\n纷纷世事中，采采黄菊枝。\n此语人共赏，此意畴复知。\n知即翁之徒，高风接皇羲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46477,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高楼曲","author":"赵崇嶓","text":"高楼漠漠东风尘，花须落溪生绿云。\n艳歌美酒消好春，千金难解青娥颦。\n燕莺语言凤凰意，画空不成天似水。\n潮红晕脸浓蛾低，门前采蘩春正迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46478,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偶成","author":"赵崇嶓","text":"负郭二顷田，贸易办丧祭。\n丧祭幸已周，啼饥坐终岁。\n长贫固非病，时运矧复尔。\n幽居日月闲，糜粥胜甘腻。\n明日春风生，它山蕨薇紫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46479,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"皎皎","author":"赵崇嶓","text":"皎皎白玉堂，有女白于玉。\n门前车马任西东，门里苔痕四时绿。\n春风撩乱飞伯劳，樱桃花重红夭夭。\n夜深扑落金剪刀，乌龙睡稳蟾蜍高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46480,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秾华","author":"赵崇嶓","text":"秾华侈春艳，松柏凌霜雪。\n芳时若转盼，万族畏销歇。\n人生金石交，所贵在黄发。\n同衾异寒燠，抱蕴应未察。\n贫贱张与陈，利达胡与越。\n安得皎洁心，长年似明月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46481,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"野马","author":"赵崇嶓","text":"野马纷驱驰，竞此光一隙。\n世事若颔髭，朝摘暮还出。\n惟应壮与老，冉冉如过客。\n岁寒山上松，稍稍见其实。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46482,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寒食雨晴书事","author":"赵崇嶓","text":"如何夜来雨，欲妒清明天。\n皎皎日华晓，千门罗管弦。\n风吹绮襦艳，深入杨柳烟。\n我与君子意，归心皆浩然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46483,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游金精山","author":"赵崇嶓","text":"飞泉洒灵雨，玉田閟青芝。\n中有神仙人，宛然姑射姿。\n天巧从古今，虚窦开烟霏。\n岁深语亦诞，目极神为驰。\n我亦泉石人，夙昔梦见之。\n登临悟三生，毛发何森縰。\n未脱区中缘，玉颜畏磷缁。\n仙春醉青桃，萝风吹轻丝。\n凡事俱尔尔，居然骇痴儿。\n留诗遗仙灵，讵解山中疑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46484,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉起","author":"赵崇嶓","text":"醉起西窗日欲斜，新烟初试雨前茶。\n川原春意无聊赖，开尽桐花到柿花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46485,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题弹枭","author":"赵崇嶓","text":"弹枭莫弹鹤，惜此孤飞翰。\n鹤举即千里，渺在青云端。\n弹之固无益，瘦不充君盘。\n却恐梧桐枝，无复栖凤鸾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46486,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"归朝欢","author":"赵崇嶓","text":"翠羽低飞帘半揭。\n宝簟牙床凉似雪。\n窗虚云母澹无风，隔墙花动黄昏月。\n玉钗鸾坠发。\n盈盈白露侵罗袜。\n记逢迎，鸿惊燕婉，灯影弄明灭。\n蜀雨巫云愁断绝。\n罗带同心留绾结。\n交枝红豆雨中看，为君滴尽相思血。\n染衣香未歇。\n夜阑天净魂飞越。\n正销凝，一庭秋意，烟水浸空阔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46487,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"如梦令 其一","author":"赵崇嶓","text":"日日酒围花阵。\n画阁红楼相近。\n残月醉归来，长是雨羞云困。\n低问。\n低问。\n独自绣帏睡稳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46488,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"如梦令 其二","author":"赵崇嶓","text":"窗外燕娇莺妒。\n窗下梦魂无据。\n梦好却频惊，不到彩云深处。\n无绪。\n无绪。\n红重一帘花雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46489,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"选冠子 和美成韵","author":"赵崇嶓","text":"隐枕轻潮，拂尘疏雨，幽梦似真还断。\n莺雏燕婉，依约年时，花下试翻歌扇。\n憔悴鬓怯春寒，慢掠轻丝，柳风如箭。\n甚阳台渺邈，行云无准，楚天空远。\n应唤觉、当日琴心，祗今诗思，惆怅客衣尘染。\n钗留股玉，袜袭钩罗，荏苒腻寒香变。\n问讯多情，别后笑巧颦娇，对谁长倩。\n但晚来江上，眼迷心想，越山两点。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46490,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"更漏子","author":"赵崇嶓","text":"玉搔头，金约臂。\n娇重不胜残醉。\n留粉黛，晕胭脂。\n浅寒生玉肌。\n待归来，浑未准。\n疑杀那回书信。\n春又好，思无穷。\n卷帘花露浓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46491,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"沁园春","author":"赵崇嶓","text":"紫陌芳尘，烟缕收寒，雨丝过云。\n羡交阴桃叶，窗前曲槛，认巢燕子，柳底朱门。\n回首年时，雾鬟风袖，袅袅娉娉娇上春。\n逢迎处，尽芳华缱绻，玉佩殷勤。\n谁知此际销魂。\n漫隐约人前笑语温。\n记掌中纤细，真成一梦，花时怨忆，应为双文。\n载酒心情，教眉诗句，空悔风流曾误人。\n凭谁去，待寄将恨事，两处平分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46492,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"金明池 素馨","author":"赵崇嶓","text":"桂海云蒸，瘴山雾暖，片雪何曾到地。\n羡长日、岛仙清暑，自学得、剪冰裁□。\n把岁寒、五出工夫，别妆点薰风，尽成清致。\n尽虹雨翻晴，暮霞焦土，一种凄凉如洗。\n酝藉丰标浑无比。\n应似惜、潇湘蕙疏兰弃。\n纵未入、众芳题品，终自倚、一涯风味。\n待等闲、留取遗芬，伴檐卜芳菲，蔷薇清泚。\n看佩贯胡绳，心灰宝燎，到了未输兰蕙。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46493,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南柯子/南歌子 其一 小姝","author":"赵崇嶓","text":"丝发风轻掠，酥胸冷不侵。\n背人小立卸瑶簪。\n一缕柔情、系得几人心。\n曲槛花方蓓，河桥柳未阴。\n红羞绿困不能禁。\n恼乱东风、无计等春深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46494,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南柯子/南歌子 其二","author":"赵崇嶓","text":"掩笑轻抬袖，慵妆浅画眉。\n嫩晴帘箔玉梅飞。\n门外寒轻、疏柳趁黄时。\n绾带香罗结，交钗绿玉枝。\n看看又误踏青期。\n倚遍栏干、心事只春知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46495,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"恋绣衾 梅","author":"赵崇嶓","text":"江烟如雾水满汀。\n早梅花、偏占浅清。\n倚翠竹、寒无力，想潇湘、斜日暮云。\n几回梦断阳春面，问百花、犹隔几尘。\n趁月夜、霜风峭，约彩鸾、同载玉笙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46496,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"望海潮 泛舟","author":"赵崇嶓","text":"轻云过雨，炎晖初减，楼台片片馀霞。\n曲径通幽，小阑斜护，水天薄暮人家。\n暝色趣归鸦，竹风交立玉，清透窗纱。\n断岸涟漪，乱萍芳苇绕烟沙。\n依稀画艇莲娃。\n掩鲛绡微沁，急桨咿哑。\n香雾霏微，冷光摇曳，娅红深映低花。\n天际玉钩斜。\n矶边菱唱答，惊断鸣蛙。\n满棹白蘋归去，幽兴绕天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46497,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清平乐 其一 怀人","author":"赵崇嶓","text":"莺歌蝶舞。\n池馆春多处。\n满架花云留不住。\n散作一川香雨。\n相思夜夜情悰。\n青衫泪满啼红。\n料想故园桃李，也应怨月愁风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46498,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清平乐 其二","author":"赵崇嶓","text":"妒红欺绿。\n轻浪潮温玉。\n鸾袖卷香金。\n娇怯未消寒粟。\n锦衾初罢承欢。\n宿妆微褪香弯。\n醉眼乍松还困，断云犹绕巫山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46499,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮","author":"赵崇嶓","text":"桃花相向东风笑。\n桃花忍放东风老。\n细草碧如烟。\n薄寒轻暖天。\n折钗鸾作股。\n镜里参差舞。\n破碎玉连环。\n卷帘春睡残。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46500,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谒金门 其二","author":"赵崇嶓","text":"春意泄。\n香重一枝梅雪。\n寒透玉壶冰暗结。\n玉奴情更劣。\n似语还羞奇绝。\n妒白怜红时节。\n酒力未醒双眼缬。\n一帘风弄月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46501,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]