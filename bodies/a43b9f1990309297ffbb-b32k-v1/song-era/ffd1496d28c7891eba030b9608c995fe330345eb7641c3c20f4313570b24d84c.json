[{"title":"和傅彦济知县","author":"释德洪","text":"句法疑君每太高，湘南山水助挥毫。\n暂临小邑聊观政，未见全牛可受刀。\n珠玉光难藏瓦砾，芝兰香岂掩蓬蒿。\n坐令百里清如镜，吏猾民奸岂易逃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61965,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题刘居士环翠庵","author":"释德洪","text":"平生不识刘居士，想见茅庵枯瘁姿。\n百八珠轮红玛瑙，万千峰绕碧琉璃。\n笑人经卷钻故纸，彼世金珠似笊篱。\n折脚铛中谁共过，小庞真是出家儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61966,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵思禹兄见怀","author":"释德洪","text":"刺桐花映野蔷薇，湘水侵门过客稀。\n此日音书经岁隔，何时麈尾对君挥。\n楼高三楚天空阔，夜久千岩月正晖。\n我托丛林如越鸟，南枝虽稳亦思归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61967,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵思禹题方竹","author":"释德洪","text":"不改平生岁寒操，近来随世解方圆。\n知君出异惊群听，显我寻常是一偏。\n但见苍官遭宠锡，那知青士亦超迁。\n水花院落春风晚，庭种连蕉怪石前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61968,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蜀道人明禅过余甚勤久而出东山高弟两勤送行语句戏作此塞其见即之意","author":"释德洪","text":"众中闻语识巴音，京洛沅湘久访寻。\n张口茹拳君聚落，垂膺拭涕我山林。\n碧岩花堕鸟飞去，蒲坐叶飘针正纴。\n袖里两勤太饶舌，丈夫声价老婆心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61969,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送珠上人重修五宗语要","author":"释德洪","text":"五宗抄语挟风雷，佛日将倾赖取回。\n薝卜花香已零落，旃檀塔坐更尘埃。\n钝根厌看摩挲去，妙手端能拂拭开。\n当有异人来荷法，丛林因子见奇瑰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61970,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"光上人送墨梅来求诗还乡","author":"释德洪","text":"南岳有云留不住，东归结伴过湘湄。\n解将疏影横斜句，不换垂珠的皪诗。\n癯甚鸢肩寒入画，清哉鹤骨老难医。\n定知入岭风烟暮，正及追胥馈岁时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61971,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送琼大师归禅寂","author":"释德洪","text":"近闻禅寂似丛林，总众能为世所钦。\n百巧难磨真实行，两涂不改岁寒心。\n衣今椹色如栗色，语未吴音变楚音。\n盛夏入城缘厎事，扁舟湘水独相寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61972,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠道法师","author":"释德洪","text":"道公胆大过身躯，敢逆龙鳞上谏书。\n独欲袒肩担佛法，故甘引颈受诛锄。\n三年窜逐心无愧，万里归来貌不枯。\n他日教门纲纪者，近闻靴笏趁朝趋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61973,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谷山沙弥求诗","author":"释德洪","text":"十里松风长不老，一庭秋色为谁闲。\n偶逢此日休新夏，偏见耆年忆故山。\n贫里有秋同举箸，法中添口共开颜。\n偶然弄笔成诗句，乘兴留题屋壁间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61974,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠罗道人","author":"释德洪","text":"蜕尘标韵矫翔鸾，鬓发楼飕风露寒。\n脱舄骨飞何日见，解衣沐浴万人看。\n肯来从我翛然住，皆说他人屈致难。\n戏作猫声行聚落，自忘身是晋郎官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61975,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵张司录见寄","author":"释德洪","text":"不曾识面已倾倒，便觉胸中泾渭分。\n句精不减李长吉，才高大类沈休文。\n看山诗眼湛如水，拄笏爽气高摩云。\n他年竹屋夜连榻，妙语悬知过所闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61976,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"郭伯成荣登","author":"释德洪","text":"快马东风走帝京，归来门巷绿阴成。\n顷知一第文章贵，能致三公衮冕荣。\n子涉风波方箠探，我闲几砚觉尘生。\n赠诗谁似王摩诘，翰墨场中独策名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61977,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题天王圆證大师房壁","author":"释德洪","text":"闭户不妨依聚落，开轩随分有山林。\n残经半掩世情断，好鸟一声村意深。\n篱外霜筠森束玉，屋头露橘欲垂金。\n能营野饭羹红酱，渡水何辞数访寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61978,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题达轩","author":"释德洪","text":"羊肠世路替人愁，袖手归来事事休。\n只有信缘唯得计，不过随分复何求。\n数声属玉沧浪晚，一坞黄云?稏秋。\n寄语封侯塞垣外，何如高卧小轩幽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61979,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题云岩筠轩","author":"释德洪","text":"雨叶风枝小径通，拂砧清坐有谁同。\n粉衣香滑秋丛瘦，泉佩丁东夜壑空。\n半世已归弹指内，前途都付枕肱中。\n堤防老境犹多事，折脚铛炊腐颗红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61980,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"逍遥游山归见示唱和诗轴口占和之","author":"释德洪","text":"游遍名山过水西，夜谈奇语尽横机。\n君如槛鹿犹思奋，我似栖禽已倦飞。\n闻道老禅能眷旧，更烦诸衲借馀辉。\n欲知胜践多佳思，怀得新诗满袖归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61981,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送谊叟归北山","author":"释德洪","text":"南台山浅北山深，深处开轩更茂林。\n作夏悬知成契阔，扁舟乘兴一相寻。\n灯青竹屋风雨夕，溪绕石门乡井心。\n投老都忘身是客，坐中谈笑尽吴音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61982,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偶书寂音堂壁三首 其一","author":"释德洪","text":"巾瓶挂壁亦翛然，无所营为地自偏。\n句法不能医老病，梦游时解到林泉。\n扶持瘦玉筇随步，堆叠荒云衲半肩。\n小住閒庭数归鸟，从教人作画图传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61983,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偶书寂音堂壁三首 其二","author":"释德洪","text":"寂音閒杀益风流，寒涕垂膺懒更收。\n得失是非都放却，死生穷达信缘休。\n湘中戏剧三千首，海上归来十二秋。\n斋罢展单吾自课，暮年眠食更何求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61984,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偶书寂音堂壁三首 其三","author":"释德洪","text":"霜须瘴面老垂垂，瘦搭诗肩古佛依。\n灭迹尚嫌身是累，此生永与世相违。\n残经倦读闲凭几，幽鸟独闻常掩扉。\n寝处法华安乐行，荡除五十二年非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61985,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"元正一日示阿慈","author":"释德洪","text":"季真少俨三十岁，俨入新年五十三。\n疑我满怀揣佛法，解腰抖擞破裙衫。\n大瞻终老同香火，小朗平生共石岩。\n深炷垆香待清旦，偶闻残雪落高杉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61986,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上元夜病起欲写法华安乐行品无力呼阿慈为录作此","author":"释德洪","text":"重城车马气成雾，隔水岩丛冷欲冰。\n昨夜窥窗先有月，今宵对语偶无僧。\n腊高鹤骨柴崖露，病起霜须逐旋增。\n欲写宝书惊力乏，阿慈能为扫寒藤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61987,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上元后候季长不至作此寄之","author":"释德洪","text":"和风冻雨上元后，断岸橘洲春水生。\n村寺独归江路熟，竹篱谁系小舟横。\n偶成诗句长哦罢，谩折梅花一嗅清。\n想见连床成夜语，此篇先慰远来情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61988,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夏日偶书","author":"释德洪","text":"草树扶疏夏簟清，梦惊斗雀堕空庭。\n过墙雌竹已数子，出屋耄蕉终百龄。\n雷后怒云鱼尾赤，林梢剩水鸭头青。\n都无伎俩酬闲寂，谩搭伽梨自诵经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61989,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与忠子晚步登台有作","author":"释德洪","text":"僧残寺僻游人少，草满池塘笋过篱。\n卢橘带酸春去后，榴花出叶雨晴时。\n一年事办秧齐遍，连日江寒水退迟。\n偶上高台成远眺，兹游更得子追随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61990,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和人雁字","author":"释德洪","text":"划然斜去和天晓，夜火相惊事已虚。\n春信写来无款识，东君胸次亦恢疏。\n最难读似成文蠹，不乱行如水上鱼。\n勿讶羲之笔神骏，换鹅瘗鹤是临书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61991,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大雪","author":"释德洪","text":"今年未雪今日雪，地迥眼新人不嚣。\n永巷扫除闻屐响，暮林翔集看鸦娇。\n韵高雒下应难画，兴发山阴未觉遥。\n想见茅斋已摧压，曲肱清梦到山椒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61992,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宣和四年十二月二十四日大雪珠禅客忽至渠以谷山退院来审是否作此示之","author":"释德洪","text":"翻空渐密呵不止，刷我当门螺髻峰。\n银椀满盛谈类堕，径松深覆示藏锋。\n因徒逃去宁知褊，显自何来不见踪。\n独拥衲衣成坐睡，地垆瓶泣伴疏慵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61993,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题鹿苑虎岑堂","author":"释德洪","text":"平生文彩照诸方，暗谷行藏草木光。\n要使丛林想高韵，故将名字挂虚堂。\n笑拈倚壁过头杖，闲坐当年折脚床。\n进步竿头如不荐，草深门径未相妨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61994,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵湖山居士见过","author":"释德洪","text":"平昔云岑在怀抱，而今怀抱在云岑。\n闻泉偶尔成诗句，班草相看坐木阴。\n古鼎自然无俗韵，朱弦真是有遗音。\n羊欣不肯踏城市，背郭江村独见寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61995,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题使园眄柯亭","author":"释德洪","text":"吏散东园胜践多，落花起舞鸟能歌。\n故应毛颖曾同泛，不独龙文惯自磨。\n弄影风枝空掩冉，困人天气近清和。\n倚栏欲去犹回首，奈此霄晴月色何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61996,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题翠霭堂","author":"释德洪","text":"虚檐碧瓦临无地，吐月吞风六月寒。\n帘捲烟光摇户牖，雨馀岳色堕阑干。\n侍儿自炷真龙脑，座客同分小凤团。\n谁谓太平本无象，规模堪入画图看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61997,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"迎爽楼","author":"释德洪","text":"危楼华构倚青冥，卷尽晴岚独自登。\n去雁横斜纷点点，好峰青碧露层层。\n胜游与客同清赏，佳处题名在翠筠。\n凭槛不堪衰眼力，候船津渡见归僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61998,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送太淳长老住明教","author":"释德洪","text":"三玄三要古难分，劈破从教剔突崙。\n父母未生前一笑，言诠不到处重论。\n椎开临济百年意，推出汾阳六世孙。\n何用老婆更饶舌，暗中五色自成文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61999,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送英长老住石溪","author":"释德洪","text":"三玄三要沈埋久，正令重烦振此宗。\n陷虎机关须毒手，活人眼目贵藏锋。\n真诚莫负丛林志，大愿当追佛祖风。\n覆顶把茅休取相，同安曾著老黄龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62000,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵李方叔水宿","author":"释德洪","text":"高视世波增眼寒，公如砥柱捍惊湍。\n市中一虎成三口，醉里扁舟过百滩。\n佳处每烦诗句写，胜游宜作画图看。\n遥知二老相逢处，拾得风前一笑欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62001,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵曹彦清教授见寄","author":"释德洪","text":"泮宫授道最驰名，想见经筵玉麈横。\n学问有源堪景仰，行藏无地受讥评。\n门前江浪银山攧，醉里诗篇锦段明。\n远宦不须嗟白眼，只今台阁半书生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62002,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"胥启道次韵见寄复和之","author":"释德洪","text":"少年翰墨擅时名，老爱江乡翠巘横。\n闻道异书常自校，近来佳句与谁评。\n幽寻湘水映衣碧，小寝晴窗泼眼明。\n寄我三诗争妙丽，疑公曾梦笔花生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62003,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄黄龙来道者","author":"释德洪","text":"问讯黄龙来道者，住山况味定何如。\n齿牢未怯和沙饭，眼倦应嫌夹注书。\n但见衣胜寒薜荔，不妨心赛白芙蕖。\n都疑生近楂田市，时觉淮南语未除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62004,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅首座自海公化去见故旧未尝忘追想悼叹之情季真游北游大梁闻其病忧得书辄喜为人重乡义久要不忘湘西时访史资深亦或见寻此外闭门高卧耳宣和二年三月日风雨有怀其人戏书寄之","author":"释德洪","text":"前时无际曾入梦，近日真游又得书。\n一味岁寒甘淡薄，十分欢喜说乡闾。\n闲寻老俨台南寺，更过史髯湖上居。\n想见朝来闭深閤，卧听檐雨滴阶除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62005,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵阎资钦提举东安道中","author":"释德洪","text":"父老扶携看使华，那知勋业在咨嗟。\n人生安得颜长少，岁暮今惊日欲斜。\n谩有清诗敏风雨，空馀醉墨走龙蛇。\n应怜妙语如芝菌，不吐青林吐卧槎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62006,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵游福严寺","author":"释德洪","text":"下临烟雨凭危栏，游客新辞禁从班。\n露湿衣巾近云汉，风吹笑语落人间。\n曾闻诗律如彭泽，想见风神似鲁山。\n何日三人成品坐，夜窗参论到更阑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62007,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵宁乡道中","author":"释德洪","text":"夹道传呼部曲奔，遥知秋色动吟魂。\n黄柑绿橘平芜路，剩水残山夕照村。\n似镜此心清自迥，如云往事去无痕。\n钟声有寺藏烟翠，忽见林间窈窕门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62008,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵题云峰齐云阁","author":"释德洪","text":"绿玉霜筇喜自提，芒鞋初试得攀跻。\n欲穷深谷一区胜，更上齐云百级梯。\n物外名山长好在，人间乐事自难齐。\n遥知太息出山去，一笑无人悟过溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62009,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵题必照轩","author":"释德洪","text":"曈昽晓日出苍凉，草木欣欣露叶光。\n千里秾纤上眉睫，一区形胜发天藏。\n有诗摹写江山美，无计遮拦岁月忙。\n韵险暗惊才力短，坐令毛颖秃锋铓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62010,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿资钦楚山堂","author":"释德洪","text":"故人持节在三湘，白首相逢话更长。\n挂锡曾怜道林寺，携衾来宿楚山堂。\n意消忽觉风敲竹，梦断空惊月转廊。\n常恨出门无所诣，敢辞时此夜连床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62011,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵资钦元府判见寄","author":"释德洪","text":"茗盌闲窗不厌过，暮年归计定如何。\n我思杖履游嵩少，公辈家山近洛河。\n具茨功名关意少，颖皋丘壑赋情多。\n二诗俱可镌崖石，乞与云烟相荡摩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62012,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵王觉之裕之承务二首 其一","author":"释德洪","text":"问法能来浑圣凡，毗耶丈室未曾关。\n解分钵饭如摩诘，欲散天花欠阿蛮。\n属稿新诗追鲍谢，抗行醉墨似杨颜。\n遥知穿市听归驭，及我昏鸦落照间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62013,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵王觉之裕之承务二首 其二","author":"释德洪","text":"兄弟令人眼倍明，六经心醉几时醒。\n韵高山岳横南极，机妙鲲鹏化北溟。\n丽句重逢天下白，俊才今见海东青。\n数篇秀色凌千嶂，来慰摧颓病掩扃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62014,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宣和五年四月十二日余馆湘阴之兴化徐质夫自土山来一昔夜语甚颠倒且日前尝梦见东坡今复见子何清事相联耶吾所居有亭名闲美尝有白燕巢梁间屡见鹤翔舞于层霄嘱予为诗纪其事质夫大梁人贤而有文佳公子也","author":"释德洪","text":"徐侯官舍土山边，颇为看书废昼眠。\n偶见画梁巢雪乙，更惊云汉舞胎仙。\n致坡入梦殊堪纪，与俨忘形亦自贤。\n闻道小亭时纵目，江山信美似斜川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62015,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送丕上人归黄檗","author":"释德洪","text":"万身马鬣转龙腰，十里风声捲海潮。\n翠霭晴时飞画栋，苍崖断处见朱桥。\n老惊乡井心空在，说著岩丛意已消。\n惭愧东风知此恨，夜来吹梦到山椒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62016,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同希先游石巩","author":"释德洪","text":"良辰美景古难并，且趁身闲稻雨晴。\n鸟语猿歌留我在，水声山色益人清。\n得幽诗句聊题壁，遇好峰峦即住程。\n回首十年尘事里，与君今日梦魂惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62017,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题胥大夫欣欣堂","author":"释德洪","text":"议郎粹和色无求，绕屋江山秀气浮。\n弱柳娇眠禽唤起，异花含笑草忘忧。\n闭门不放青春去，解榻长令佳客留。\n摹写高情无好句，谩横诗眼付冥搜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62018,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵嘉言机宜","author":"释德洪","text":"幽寻野外兴何如，蚕市村嚣忆故墟。\n煮茧生涯春老大，饷田时节意苏舒。\n吹开麦浪南风至，落尽花房小雨馀。\n暂借僧窗聊假寐，梦惊身世两蘧蘧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62019,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"玉池禅师以纸衾见遗作此谢之","author":"释德洪","text":"纸衾来自玉峰前，旋坼封题一粲然。\n便觉室庐增道气，不忧风雨搅闲眠。\n就床堆叠明如雪，引手模苏软似绵。\n拥被并垆和梦暖，全胜白氎紫茸毡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62020,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"立秋日偶书","author":"释德洪","text":"秋入纱厨夏簟空，颓然瘦坐一衰翁。\n声凉乱叶红蕉雨，香暗分丛紫菊风。\n清境净缘惭独享，幽怀佳句与谁同。\n平生垢习消磨尽，只有文章气吐虹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62021,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游太平古寺读旧题用惠上人韵","author":"释德洪","text":"步尽长廊觉倦游，丛蕉出屋小轩幽。\n壁间诗在红埃满，窗下香残碧缕浮。\n喜有绳床容我借，更因茗盌为君留。\n忽惊林杪湘山露，谁作江天数笔秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62022,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"岁穷僧众米竭自往湘阴乞之舟载夜归宿桥口寒甚未寝时侍者智观坐而假寐作此诗有怀资钦提举","author":"释德洪","text":"老去生涯无窖子，隔城荒寺到人稀。\n岁穷百里扣门乞，夜棹孤舟载米归。\n隅坐小僧寒附火，联拳羸仆睡和衣。\n故人醉里闻芗泽，应背银缸照翠帏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62023,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"正月一日送璿维那之新昌乞","author":"释德洪","text":"春水初生湘岸边，阴晴城郭上元前。\n暖消积雪成檐滴，火烈残香发篆烟。\n念旧十年乡井梦，试新一首送行篇。\n翛然路入江南去，想见归时及杜鹃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62024,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"二月二十一日奉陪季长游岳麓饭罢登法华台赋此","author":"释德洪","text":"法华台上凭栏久，吹鬓东风晚雨晴。\n断岸平横千雉堞，道林远在一牛鸣。\n喜餐水饼清明近，开遍山茶杜宇声。\n想见京尘遮便面，应思携手此中行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62025,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送兴上人之归宗","author":"释德洪","text":"紫霄峰下鸾溪上，幻出宝坊金碧开。\n沃野不辞常自献，暮云无事解归来。\n永怀香火三生旧，想见松风万壑哀。\n阿上笑中如问我，为言诗胆尚崔嵬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62026,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]