[{"title":"汉武","author":"杨亿","text":"蓬莱银阙浪漫漫，弱水回风欲到难。\n光照竹宫劳夜拜，露漙金掌费朝餐。\n力通青海求龙种，死讳文成食马肝。\n待诏先生齿编贝，那教索米向长安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70755,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"石殿丞通判濮州","author":"杨亿","text":"龙虎游从分不疏，忽闻新命佐鱼符。\n经旬苦雨淹行旆，几曲洪河贯郡图。\n浮蚁酒浓频举白，折胶风劲好弯弧。\n贤侯东道欢相得，期月民谣待裤襦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70756,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"龙图阁会宴应制","author":"杨亿","text":"册府藏书在紫微，退朝稽古助论思。\n中天召宴衢樽满，乙夜观文列象垂。\n綵凤翩翻巢绮阁，灵龟夭矫冠金碑。\n大风发唱群臣和，元首康哉庶绩熙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70757,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"休沐述怀寄秘阁钱少卿","author":"杨亿","text":"风号电笑雨平阶，纨素微凉暗入怀。\n昼枕乍成园吏梦，晨蔬聊学太常斋。\n名惭引籍通丹地，心愧移文刻翠崖。\n大隐金门犹自适，日亲方朔听诙谐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70758,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"休沐端居有怀希圣少卿学士","author":"杨亿","text":"凝尘满榻素琴横，岸帻孤吟意未平。\n茗粥露芽消昼夜，柘浆云液浣朝酲。\n水沈朱李金瓶涩，风猎幽兰羽扇轻。\n独忆当筵试汤饼，谪仙冰骨照人清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70759,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再次首唱韵和","author":"杨亿","text":"碧树银塘接画楼，天人谁肯降琼辀。\n三山密信传青雀，五日归鞍跃紫骝。\n郢酒泛冰星弁侧，吴歈倚瑟黛娥愁。\n云峰得句怀真赏，瘦尽东阳沈隐侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70760,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再赋七言","author":"杨亿","text":"翠幄飘香映绮襦，钿盘清晓露成珠。\n休啼为近鲛人室，欲笑谁投玉女壶。\n云气乍回巫峡梦，水嬉犹记曲池图。\n金花却荐何人步，枉遣凌波袜缕濡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70761,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"刘校理属疾","author":"杨亿","text":"北窗风劲雪云繁，移疾端居避世喧。\n载酒谁过杨子宅，张罗休署翟公门。\n多才最许飘飘气，少别还销黯黯魂。\n促尔徘徊忆真赏，远天新月照黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70762,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同诸公寄阆州隆灵山王处士","author":"杨亿","text":"玄晏先生早著书，圣朝未降软轮车。\n满头霜雪机心息，三径蓬蒿俗客疏。\n千首好诗传辇毂，一枝仙桂耀门闾。\n汉庭得意真知己，应为清宵诵子虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70763,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"后苑赏花应制","author":"杨亿","text":"云罗霞绮媚芳辰，琼圃花开烂漫春。\n风递清香随凤辇，波涵倒影落龙津。\n仙葩四照烘初日，浓艳千苞赐近臣。\n向晚天街戴归处，游蜂舞蝶自随人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70764,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"后苑赏花应制","author":"杨亿","text":"宫花如锦水连漪，翠辇寻芳正是时。\n禁苑定知人未识，朱栏除有蝶偷窥。\n艳烘晓日迷天仗，香逐轻风落酒卮。\n何幸微臣陪镐宴，蓬壶春漏正迟迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70765,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"后苑赏花钓鱼应制","author":"杨亿","text":"宜春小苑斗城旁，锡宴群仙奉紫皇。\n汉沼乳鱼偏傍钓，青陵舞蝶自寻芳。\n波平鳌背浮昆阆，日转金茎艳赭黄。\n满酌流霞侍臣醉，暖风宫蕊杂炉香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70766,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"因人话建溪旧居","author":"杨亿","text":"听话吾庐忆翠微，石层悬瀑溅岩扉。\n风和林籁披襟久，月射溪光击浪归。\n露畹荒凉迷草带，雨墙阴湿长苔衣。\n终年已结南枝恋，更羡高鸿避弋飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70767,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"因与西厅参政侍郎奕棋予输纸笔砚三物以诗见徵属宣毫适尽但送蜀笺端砚继以此章","author":"杨亿","text":"多年燥吻苍苔砌，秃尽江南石上毫。\n五色蛮笺犹有剩，一拳端砚岂胜劳。\n萧斋幸预谈宾末，谢墅深降奕思高。\n微物供堂方犹豫，丹青笔下枉风骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70768,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"孙寺丞知考城县","author":"杨亿","text":"早得东堂桂一枝，凌云词赋汉皇知。\n从军久在红莲幕，对策曾临白玉墀。\n霰雪陪游应不晚，弦歌为政莫嫌卑。\n春官宗伯大京兆，喜见门生趋府时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70769,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"并州王谏议","author":"杨亿","text":"锁闱聊辍皂囊封，昼锦还乡意气雄。\n别墅挥金延父老，近郊骑竹见儿童。\n蒲卢善化终成政，蟋蟀深思未变风。\n更待出师平黠虏，戎衣献捷大明宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70770,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戏赠颍州万寿尉吴待问","author":"杨亿","text":"宦途南北最情亲，岁晏相逢颍水滨。\n旧日青衿同学校，暂时黄绶困埃尘。\n樽中满酌香醪美，门外高悬綵棒新。\n鸡黍留欢已慵发，可堪经雨折纱巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70771,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"成都","author":"杨亿","text":"五丁力尽蜀川通，千古成都绿酎浓。\n白帝仓空蛙在井，青天路险剑为峰。\n漫传西汉祠神马，已见南阳起卧龙。\n张载勒铭堪作戒，莫矜函谷一丸封。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70772,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"成都凤道人游终南山谒种徵君","author":"杨亿","text":"何年出蜀访南宗，深锁闲房翠藓重。\n振锡忽闻游地肺，题门兼得谒人龙。\n行吟一路高秋月，投宿斜阳远寺钟。\n到日弥天清论罢，遍寻紫阁与圭峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70773,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"早秋","author":"杨亿","text":"楚客悲秋至，庭柯一叶凋。\n鹤天惊晓露，兰畹怯凉飙。\n团扇流尘暗，单衣爽气饶。\n江东菰米熟，归梦隔寒潮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70774,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵和中书李舍人勉元氏道宗奉宗兄弟之什","author":"杨亿","text":"二难文彩少人过，落笔寻常只患多。\n兔苑暂游冲霰雪，龙门曾上困风波。\n一囊负米犹为客，百步穿杨待决科。\n更得词臣赠诗句，机云入洛拟如何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70775,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵和太仆钱少卿寄赠编修主人宋承旨李舍人之什","author":"杨亿","text":"春官宗伯鲁诸生，翰苑纶闱占大名。\n一代典谟资润色，满朝文物仰悬衡。\n分班月殿趋金马，侍宴天池见石鲸。\n即日云屏应隔坐，不须东观待书成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70776,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵和主人喜诸客见过之什","author":"杨亿","text":"金鸭喷香绕烛台，轻云散尽月光来。\n三千宾客连宵醉，十二城门彻晓开。\n何幸紫微容托乘，更烦红袖与传杯。\n明朝犹自放朝谒，心喜当关不见催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70777,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵和右巡李端公见寄之什","author":"杨亿","text":"首夏修时祭，斋居贵洗心。\n神光浮汉畤，薰吹发虞琴。\n偃树枝成盖，丰碑字有金。\n秘文窥宝箓，荣路厌朝簪。\n捉麈思嘉话，烹鱼得好音。\n回瞻柏台署，佳气九门深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70778,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵和守邦道人寄编修诸学士之什","author":"杨亿","text":"修书何幸佐铅黄，日接群英道自光。\n署近承明叨谒帝，赋成平乐谬为郎。\n孟坚已分酬宾戏，严助还思佩郡章。\n共忆东林社中客，满池莲叶吐清香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70779,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵和并州钱大夫夕次丰州道中见寄","author":"杨亿","text":"汉将从天下，胡兵值月残。\n孤烟戍楼迥，密雪战袍乾。\n向暮三吹角，临风一据鞍。\n边城赖经略，重取地图看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70780,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵和李光丞见惠长绦之什","author":"杨亿","text":"貂裘已敝洛阳尘，空有陶家漉酒巾。\n双阙金章奉朝请，小斋纱帽养天真。\n久持梵行称居士，犹掌王言作侍臣。\n惠我长绦识君意，欲教莲社伴遗民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70781,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵和李寺丞寄石同院之作","author":"杨亿","text":"子云常在草玄台，不觉春风满眼来。\n闻道后车长载酒，无因曲水共流杯。\n石渠尽日芸签拥，金谷何时绮席开。\n珍重主人偏爱客，乞逢休沐便追陪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70782,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵和李舍人忆北园寻春之作","author":"杨亿","text":"谢公别墅枕城闉，萧洒都无紫陌尘。\n五色丝纶贪草诏，一园桃李阻寻春。\n早朝禁漏犹传点，下直残阳已满身。\n除是禁烟容洗沐，直须偷暇赏芳辰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70783,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵和李舍人拜命书怀寄馆殿旧僚之什","author":"杨亿","text":"拜命入星垣，偏承圣主恩。\n黄扉陪汉相，彩笔代尧言。\n佩玉天颜近，籯金世望喧。\n下僚今隔品，云路仰高轩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70784,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵和宗人安期见贺恩命之什","author":"杨亿","text":"分班晓入翔鸾阙，直阁旁连浴凤池。\n彩笔闲批五色诏，好风时动万年枝。\n勒移钟阜惭归晚，称疾文园恨思迟。\n何事吾宗心倍喜，春塘梦彻寄新诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70785,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵和承旨侍郎宿斋太乙宫之什","author":"杨亿","text":"北斗城南太乙祠，羽人多著九霞衣。\n竹宫肃穆珠旒拜，华表飘飖鹤驭归。\n绕殿步虚幢影密，登坛酌献佩声微。\n质明礼毕还台去，厩马翩翩速似飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70786,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵和表弟张湜秋霁之什","author":"杨亿","text":"轻飙习习起青蘋，宿雾全开霁色新。\n高阁晴曦射疏牖，虚堂润气彻华茵。\n垫馀巾角曾冲雨，晦尽琴徽旋拂尘。\n楚泽潦收湖水白，归舟遥忆洞庭人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70787,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵和昭收寄银台李舍人之什","author":"杨亿","text":"柱下方书掌事机，深严侍从接论思。\n归鞍通德香街迥，前席延英昼漏迟。\n菊径顿疏陶靖节，月楼偏忆庾元规。\n华堂宴集应难去，玉斝醇醪满劝谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70788,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵和昭侯立秋见寄","author":"杨亿","text":"云峰半敛火西流，桃簟微凉忽报秋。\n饮露吸风齐女怨，登山临水楚人愁。\n珠喉倚瑟华堂暮，桂烬薰衣别院幽。\n美疢已平休沐近，会应投辖一相留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70789,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵和阁长李舍人喜薛梁二舍人及予同时拜命之什","author":"杨亿","text":"西垣清切本无伦，虚薄将何缀侍臣。\n承露盘高云际晓，栖鸡树绿省中春。\n言成纶綍终非称，室蔼芝兰幸得亲。\n从此烟霄连步武，宸游长奉属车尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70790,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵和阁长修书毕退朝下直寄诸学士之什","author":"杨亿","text":"名园甲第接康衢，国典新成下直初。\n庭竹碧鲜吟不足，盘飧方丈食无馀。\n炉中九转神仙药，案上百函亲故书。\n仍说颜回今饮酒，秋来宁遣宴游疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70791,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵和润州刘度支见寄之什","author":"杨亿","text":"卜隐林泉未有期，春田耕事欲凭谁。\n一辞左掖鸳鸾侣，两见南州橘柚垂。\n酌醴不妨留客醉，饮冰长是畏人知。\n颁条求瘼无他术，深恨期年报政迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70792,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵和钱少卿早春对景有怀诸学士","author":"杨亿","text":"草树欣欣暖律回，谢家池沼冻纹开。\n晴天独向高台望，春色先从上苑来。\n且待郢人歌白雪，莫听羌笛怨残梅。\n乞逢休沐便须去，引满何曾诉玉杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70793,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵和钱崇班见寄之什","author":"杨亿","text":"蘋末风轻不动尘，承明朝罢见閒身。\n从容退食收芝检，迢遰驱车访玉人。\n酒贳十千那惜醉，丹封六一已应真。\n春塘丽句偏相寄，传诵朝来满缙绅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70794,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵和钱崇班再寄之什","author":"杨亿","text":"祖祢勤王国史褒，传家自有吕虔刀。\n雄豪结客欺燕侠，憀慄悲秋笑楚骚。\n奕世勋名金钺贵，出群风格玉山高。\n诗中敏手兼无敌，射落霜雕钓得鳌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70795,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵和族弟日华寄编修诸学士之什","author":"杨亿","text":"锁闱漫喜尘通籍，蓬巷无人肯顾庐。\n天禄解嘲才答客，集仙置使又修书。\n非烟缭绕萦珠网，流水潺湲逗石渠。\n何必银台号三昧，此中更好味真如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70796,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵和盛太博寄赠阁长宿斋太乙宫之什","author":"杨亿","text":"汉武亲祈太乙坛，国朝特祭领祠官。\n羽旗摇曳晨曦上，素瑟凄清夜漏寒。\n驾鹤浮丘应暂下，偷桃方朔合留残。\n斋居数宿遍蔬食，定忆中厨政事餐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70797,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵和盛博士寄许州任从事之什","author":"杨亿","text":"射策曾攀郤桂枝，从军犹赋仲宣诗。\n陈琳草檄应非久，贡禹弹冠素有期。\n梁苑胜游思霰雪，浔阳旧隐废茅茨。\n初筵樽斝不须恋，正好公车自荐时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70798,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵和盛博士寄赠李四寺丞因以述怀","author":"杨亿","text":"钱郎满腹贮精神，坐上诗成压倒人。\n相识只从抛竹马，留欢长是鲙金鳞。\n西园宴喜期清夜，曲水追随约暮春。\n不到门墙欲旬浃，已应悬榻满埃尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70799,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵和盛博士雪霁之什","author":"杨亿","text":"六花新霁白皑皑，爽气飕飕拂面来。\n梁苑酒浓寒力减，谢池风细冻文开。\n天边几阵闻归雁，江外千家见早梅。\n此际何人能访戴，剡溪清景好衔杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70800,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵和盛博士喜梅大丞授户部判官","author":"杨亿","text":"新来乘传抵秦川，会府须才果峻迁。\n应见流钱从地上，特闻聚米向君前。\n声华南国推高士，名姓丹台缀列仙。\n每话官曹苦拘束，归家长是夕阳天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70801,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵和章频下第书怀之什","author":"杨亿","text":"春闱三上败垂成，白雪新吟思转清。\n修竹园中曾献赋，慈恩塔下未题名。\n禹门烧尾他年事，楚客悲秋此日情。\n道在不须忧晚达，抟风九万是前程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70802,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵和章頔见寄","author":"杨亿","text":"鸡窗十载共论文，兰室依然有旧薰。\n雨雪共抛修竹苑，烟霞独访武夷君。\n随珠照乘元无类，天骥追风定不群。\n犬子赋成犹未献，飘飘词气已凌云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70803,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵和集贤李学士寒食即事之什","author":"杨亿","text":"九逵初旭满辎軿，寒食东风二月天。\n陌上垫巾谁傲睨，江边解佩自婵娟。\n新妆几处登墙见，沉醉何人藉草眠。\n豪侠追欢殊未足，归蹄躞蹀夕阳前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70804,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵和慎大詹中秋待月寄西掖三舍人之什","author":"杨亿","text":"凉飙送残暑，秋色望中新。\n天迥迷星斗，宵寒待月轮。\n境同牛渚上，诗寄凤池人。\n僚友东床客，冰清合许亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70805,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵和慎詹事述上元宵会之欢寄诸同舍之什","author":"杨亿","text":"休沐忻逢上元节，华堂高宴且盘桓。\n峨冠屡舞人多醉，刻烛狂吟夜向阑。\n月上珠帘侵坐白，霜飞碧瓦透衣寒。\n铜壶漏彻东方曙，归骑纷纷未尽欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70806,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵和酬永嘉聂从事除夜之什","author":"杨亿","text":"三百六旬今夜尽，寥寥虚室独凝神。\n莲城五鼓欲催晓，梅岭一枝先报春。\n邹律渐吹阴谷暖，尧蓂看傍土阶新。\n海隅留滞年华长，坐对寒釭浩叹频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70807,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵和翰林师学士赠伦上人新居之什","author":"杨亿","text":"一径雨苔深，新居雅称心。\n天花飘昼讲，池草伴春吟。\n施食山禽下，题门野客寻。\n此中堪宴坐，何必在双林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70808,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵和衢州席刑部早秋","author":"杨亿","text":"朱火荧荧向夕流，林间一叶忽惊秋。\n风来野渡闻渔笛，雾敛晴天见蜃楼。\n艳爱芙蓉开幕府，香怜杜若老汀洲。\n使君鬓畔多玄发，临水登山不用愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70809,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"此夕","author":"杨亿","text":"此夕秋风猎败荷，玉钩斜影转庭柯。\n鲛人泪有千珠迸，楚客愁添万斛多。\n锦里琴心谁涤器，石城桃叶自横波。\n程乡酒薄难成醉，带眼频移奈瘦何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70810,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"灯夕寄献内翰虢略公","author":"杨亿","text":"琼楼十二玉梯斜，乾鹊南飞转斗车。\n有客郢中歌白雪，几人天上醉流霞。\n金吾缇骑章台陌，素女繁弦太帝家。\n秦痔未痊齐阁掩，梦回宫树已啼鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70811,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"竹答柳","author":"杨亿","text":"我自虚心者，君能百尺芳。\n未闻凌雪秀，唯解刺天长。\n叶密招禽宿，皮枯任蠹藏。\n他年丹穴凤，恐不集垂杨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70812,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"至郡累旬恶风","author":"杨亿","text":"邓禹功曹器，马周令长才。\n叨临万室郡，骤致五风灾。\n大木行将拔，繁云黯不开。\n自知蒙闇极，民吏窃相咍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70813,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"行次颍州值雨留驻数日因贻郡守秘阁刁公","author":"杨亿","text":"梦想苍龙阙，盘桓汝水滨。\n郡侯偏爱客，秋雨更留人。\n馔盛尝鲈鲙，樽空倒角巾。\n羁愁不能遣，唯恐二毛新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70814,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丽水甄殿丞手植朱李繁实盈枝折以贶予感而成咏","author":"杨亿","text":"五年为邑鬓霜侵，吏隐由来得趣深。\n不独弦歌长满耳，兼闻桃李已成阴。\n晨昏我有南陔恋，江海君怀北阙心。\n早晚飞沉俱遂志，愿将初服敌华簪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70815,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丽水甄殿丞移疾请告","author":"杨亿","text":"数日不逢黄叔度，胸中鄙吝一时生。\n如何民瘼偏能疗，却是诗魔未得平。\n夏景清和妨命驾，玄台寂寞阻飞觥。\n欲亲高论无由得，须作文殊问疾行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70816,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"何大博知晋州","author":"杨亿","text":"平明东省发鱼书，便拥彤襜出上都。\n别酒金英泛篱菊，去程黄叶堕关榆。\n叔孙旧礼妨绵蕝，廉范新歌待裤襦。\n满腹经纶殊未展，归来看践赤墀涂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70817,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]