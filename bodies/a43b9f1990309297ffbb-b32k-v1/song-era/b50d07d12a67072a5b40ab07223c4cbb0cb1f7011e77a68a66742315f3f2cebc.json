[{"title":"闻寺中晓鼓","author":"施枢","text":"灵鼍一鼓振潮音，征梦迢遥枕畔闻。\n语断频伽天正晓，松风吹散满山云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38683,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻雁","author":"施枢","text":"飞尽沙田到水乡，年年来往为谁忙。\n只贪月夜芦花宿，不是将身傍稻粱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38684,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻鹤","author":"施枢","text":"谁家嘹唳九皋声，客梦初回晓帐清。\n华表不知仙路远，刚随寒角转残更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38685,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"唐园","author":"施枢","text":"幽居已似水中仙，更有亭台在屋边。\n拟作小图难画处，一年两驻内家船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38686,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晓寒","author":"施枢","text":"曲曲屏山忆梦中，峭寒成阵入帘栊。\n宿香销尽金猊冷，一树梅花怯晓风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38687,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"桃花","author":"施枢","text":"武陵人去水横陈，独向玄都管领春。\n日暖风轻尘扑面，刘郎空老苦吟身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38688,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"涌金门外","author":"施枢","text":"柳丝舞困起炊烟，罗绮相催欲上船。\n贵冶亦知春有夜，煖沙还付白鸥眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38689,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"通真观 其二","author":"施枢","text":"桃源事已成荒幻，那更形容学避秦。\n欲访旧踪无处觅，满山花落不知春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38690,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"通真观 其一","author":"施枢","text":"不到凝安二十年，丹青一幅尚依然。\n青牛已去仙踪远，却有山禽下玉田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38691,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宿龙泉寺","author":"施枢","text":"既济功成列左玄，馀波犹作世间泉。\n苔荒碧甃龙宫寂，庭老梅花月在天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38692,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚望","author":"施枢","text":"芳草迢迢客路长，柳边吹絮燕泥香。\n桐花拆尽春归去，犹倚危阑问夕阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38693,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梦回","author":"施枢","text":"银漏迢迢箭缓传，梦回月在早梅边。\n小池冻合寒芦折，应是鸳鸯夜不眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38694,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绿字韵","author":"施枢","text":"晓帐香销闲画烛，梦回山断屏风曲。\n轻烟细雨客情多，南浦草随新涨绿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38695,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菊潭赋小窗睡香次韵","author":"施枢","text":"兀兀蒲团万虑除，定回寒月满康庐。\n幽香自有禅心会，春不相知亦任渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38696,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"道间见桃李花","author":"施枢","text":"东风到处竞繁华，不问穷檐与大家。\n垂柳丝中深院宇，隔廧时有出来花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38697,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雷崖屋","author":"施枢","text":"不徒卓屋在岩阿，前后丹成亦已多。\n三十馀年勤累行，几时跨鹤上空歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38698,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"墙外竹","author":"施枢","text":"森森新竹亚墙屏，箨解馀斑粉泪零。\n幸入诗家穷相眼，可能不为此君青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38699,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端平除夕","author":"施枢","text":"宦游来此亦随缘，过了新冬又馈年。\n今夕桃符犹自写，明朝柏酒让谁先。\n但令世道皆平地，此外身名任老天。\n春与诗家如有意，早传清梦谢池边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38700,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蜡梅送东畎先生并寓探梅之意","author":"施枢","text":"泽国寒深未见梅，东风何日到南枝。\n玉堂应有新消息，恐是人间未得知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38701,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"横渎岸边梅花方开 其二","author":"施枢","text":"竹篱茅舍本相安，谁与移根入画栏。\n尽道重帘妨暖日，疏枝却得护春寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38702,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"横渎岸边梅花方开 其三","author":"施枢","text":"风标夐与万花殊，可有尘埃染得渠。\n把住琼枝相晤语，只疑身在玉堂居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38703,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"横渎岸边梅花方开 其一","author":"施枢","text":"雪染梅花倚道傍，亭亭野水弄幽芳。\n东风似赏孤高意，未许飘零一片香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38704,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题龙首图","author":"施枢","text":"变化成来体势高，坐令幽思起云涛。\n春雷一鼓惊头角，碧海风轻衮绛桃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38705,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题至道宫云巢轩","author":"施枢","text":"碧霄路底作生涯，云亦何曾定有家。\n月印天池心宇净，水鸣环佩出松花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38706,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题桃源图","author":"施枢","text":"山中与世不相关，鸡犬桑麻尽日闲。\n傍水桃花春烂熳，误传消息到人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38707,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题朝阳洞中","author":"施枢","text":"一吸龙泉万虑清，更寻古洞入柴荆。\n桃花落尽春无路，独许骑鸾上玉京。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38708,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠湖边柳","author":"施枢","text":"乱撒鹅黄拂晓晴，天涯多少故人情。\n游船空逐轻阴转，半属春风半属莺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38709,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"檐玉鸣","author":"施枢","text":"哓窗风细响檐铃，一曲云璈枕上闻。\n梦断不知仙路杳，鹤衔松露入青云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38710,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"霸国祠","author":"施枢","text":"瓶笙惊昼睡，此意有谁知。\n蛙井成何事，鸿图岂易窥。\n一身虽戮辱，万姓免疮痍。\n茅土今何在，惟存霸国祠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38711,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"一春屡有阳明之约雨辄尼之将旋幕侍外舅来游解后二羽衣一能参上道一能知大丹竟日留话喜赋二解时清明日也 其二","author":"施枢","text":"裂石未尝关，毋将俗眼观。\n虚中元有受，造蕴亦何难。\n羽客能谈道，云房识候丹。\n只应仙有分，风响步虚坛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38712,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"入京","author":"施枢","text":"何期又泛玉京船，行止于人不偶然。\n寒力胜如前两夜，世情熟似近三年。\n只将兴味留诗里，苦乏工夫到酒边。\n万事看来忙不得，只须委顺乐吾天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38713,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上司谏曹先生","author":"施枢","text":"声名满世重于山，果见延登左掖班。\n天子虚心求国是，先生著手济时艰。\n要看出处诸公上，只在精神一转间。\n前此极言虽引去，安危理乱正相关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38714,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"大能仁寺","author":"施枢","text":"规模应甲刹，殿阁拥金仙。\n岁歉炊烟绝，城低野色连。\n客僧皆散去，主者独安眠。\n成毁难逃数，山门八百年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38715,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"马上","author":"施枢","text":"只为溪山有宿盟，两旬两度此经行。\n马嘶险径霜蹄滑，鸥舞平沙雪羽轻。\n豪气不从尘外减，新诗偏向道间成。\n梅花似有相迎意，野水篱边数蕊明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38716,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中秋日虎丘呈庾使东畎先生","author":"施枢","text":"蹇步接輶轩，于山亦有缘。\n剑锋遗断石，阁影倒平田。\n紫日穿林暝，黄云共野连。\n清辉无著处，月伴使星圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38717,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"五到洞霄兼似冲妙","author":"施枢","text":"多谢名山不厌人，五来此地著闲身。\n泉声带雨驱烦暑，空翠萦风绝点尘。\n金鼎火能知应候，玉壶花自占长春。\n何时许證三生约，乞借烟霞与卜邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38718,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"双路","author":"施枢","text":"王命驱驰不敢轻，文书要覈去来情。\n青山步步生幽意，碧涧悠悠趁远程。\n春浅禽声犹自小，泥酥马迹正宜晴。\n地名见说名双路，便舍崎岖就坦平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38719,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"开炉次夕以不禁离抱来访宏庵挑灯细语漏促忘归即事有赋时黄澹翁在焉","author":"施枢","text":"客里情怀不自如，夜深来访子云居。\n挑灯细按新翻曲，拂案同看旧架书。\n梧叶敲风蛩砌冷，菊香销雨鹤庭虚。\n相逢且与开眉笑，莫遣吟边酒盏疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38720,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"忆孤山","author":"施枢","text":"孤山不是远，只隔凤城门。\n争赏诗家句，谁招隐士魂。\n秋风林下冢，寒月水边村。\n拟待梅花发，长吟酹一尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38721,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水次秋蚊可畏","author":"施枢","text":"利觜似花鹰，针肤不暂停。\n有生何蠢蠢，藏毒在冥冥。\n乱舞迷昏水，喧声接晓汀。\n风威秋晚劲，看汝易飘零。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38722,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"风雨","author":"施枢","text":"入夏惟忧旱，秋来却浸霪。\n风声连海响，山气与云深。\n望岁丹心切，忧时白发侵。\n旅中无别事，隐几自长吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38723,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东天目 其二","author":"施枢","text":"不谓山行得此晴，有名胜处必须经。\n玉田草满春无极，石室人稀夜不扃。\n自料俗情应厌倦，谁知幽意在空冥。\n碧桃却似传消息，一曲琼歌月满庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38724,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东天目 其一","author":"施枢","text":"不辞巇险访龙潭，潭底无穷碧似蓝。\n乱石鸣滩溪过九，飞泉泻瀑堑分三。\n虽然道士能相引，不比樵人得尽谙。\n怊怅飞桥无路到，乘风应许御云骖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38725,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"出西门寄呈外舅姑","author":"施枢","text":"自从依监宅，不似□时亲。\n义重难为别，情同久更真。\n一箫思去凤，双璧倚灵椿。\n只等中除报，相迎辇路尘。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38726,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"祇园寺许询旧宅有戚公水","author":"施枢","text":"应天曾建塔，又此结精庐。\n释氏缘何熟，诗人念总疏。\n壁荒遗画水，僧老学医书。\n笑我重来者，经年不定居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38727,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"对雪","author":"施枢","text":"怪得连阴不放晴，直教飞雪试轻盈。\n风回冉冉霓裳舞，云暗纷纷鹤羽明。\n大似梅花饶一出，薄于柳絮更多情。\n披衣端为诗催起，吟得诗成分外清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38728,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"正月十四夜","author":"施枢","text":"羁游偶值上元时，莲艳烧空照锦溪。\n堂上珠帘如水浸，庭前鳌架与山齐。\n风传鼓吹春声闹，雨遏笙歌夜语低。\n自笑蓬窗勤苦士，何当太乙为燃藜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38729,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玉泉","author":"施枢","text":"水迹无增减，从知地有灵。\n群鱼潜异窟，一芥纳沧溟。\n济隐新留咏，超师旧讲经。\n圣时调玉烛，龙睡不须醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38730,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玉蕈","author":"施枢","text":"幸从腐木出，敢被齿牙和。\n真有山林味，难教世俗知。\n香痕浮玉叶，生意满琼枝。\n饕腹何多幸，相酬独有诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38731,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用梅溪镜湖韵","author":"施枢","text":"畎亩镜中分，沧波杂断云。\n向来官里赐，今属野人耘。\n怀古天难问，贪吟日易曛。\n羽衣遗传本，起诵想馀芬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38732,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用雪坡春色韵","author":"施枢","text":"才出城门兴便浓，晴光野色两俱融。\n柳方染得三分绿，桃已熏成一半红。\n山涌林峦荒寺隐，湖分港汊小舟通。\n相携各自论年事，几度春风上鬓蓬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38733,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"立春","author":"施枢","text":"雪花风细拂春旗，一色云边漏暖曦。\n群吏守文行故典，长官书祝致新祠。\n土牛底事遭身碎，綵胜随时把鬓欺。\n争似野人闲可睡，枕边搔发自吟诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38734,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再雪","author":"施枢","text":"投晓又翻飞，春风亦被欺。\n须知寒彻夜，胜似腊残时。\n艳粉同梅落，轻花替柳吹。\n浑然成片玉，冻合在前池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38735,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再赋酬吴鞠潭","author":"施枢","text":"酌酒酬春醉晚红，谁知书剑两无功。\n渔竿冷浸半丝月，牛背闲消一笛风。\n仙梦不随狂蝶乱，家书只倩素鱼通。\n友声更拟迁乔去，底似人情较异同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38736,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"早起","author":"施枢","text":"早起看花露，西风把鬓欺。\n心清多在道，梦好亦成诗。\n过但思求己，生无事皱眉。\n功名缘底事，到手却如迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38737,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次蒙斋至日韵","author":"施枢","text":"试检清台历，黄宫气已回。\n功名难强致，岁月任渠来。\n雨径犹存菊，烟村可问梅。\n为贪吟有伴，到此又徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38738,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"老僧念佛","author":"施枢","text":"身世皆空境，知空自不悲。\n何须临暮日，逐急念阿弥。\n裴相安心际，维摩忏罪时。\n同归无有地，明月在秋池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38739,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"至日谒庙吴山见日初出","author":"施枢","text":"曦龙浴海上扶桑，云表辉芒烛万方。\n史观缤纷书瑞色，禁城奕烨锁祥光。\n从知绣线添红影，独喜丹心向太阳。\n节里官闲无一事，谛观易道静焚香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38740,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"芍药 其一","author":"施枢","text":"虽殊桃李竞年芳，色相惟应付梦乡。\n纶阁曾看金缕艳，蕊宫初试玉楼妆。\n露凝深浅烟中泪，日汎温柔雨后香。\n幸蜀归来花正好，可怜不忍看嫔嫱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38741,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"芍药 其二","author":"施枢","text":"天女霜刀剪亦难，露红烟紫碧阑干。\n步摇衣袂飘霞佩，钿合钗梁间宝冠。\n枝上任他无力笑，灯前还作有情看。\n采根若可苏民病，始信无经载牡丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38742,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西天目","author":"施枢","text":"苕水之源出此山，地如邾鲁始跻攀。\n三池浚泽高冈上，一勺为霖反掌间。\n著脚不知苍汉近，无心直共白云闲。\n何时结屋枕泉玉，涤尽尘根学大还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38743,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西兴寄呈东畎先生","author":"施枢","text":"生平未始识东州，不谓招邀得漫游。\n南镇门前秦望晓，西兴浦口浙江秋。\n风搏怒气潮初落，山涌青冥雨乍收。\n岂为登临重回首，使星只在五云头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38744,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别天目","author":"施枢","text":"东尖森洞穴，西目浚渊庭。\n三日若为霁，群龙亦有灵。\n立依松作盖，坐倚石为屏。\n犹恨归鞍急，回头望远青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38745,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别高家店","author":"施枢","text":"独抱朱弦识者稀，湖山与我独相知。\n烟迷柳岸经行少，月照梅窗做梦迟。\n酒价寒高谁与贳，衾绵夜薄自多思。\n归舟又值商量雪，好似清溪访戴时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38746,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀友人","author":"施枢","text":"锦野重来已秀葽，雨肥梅杏粉痕销。\n晚山四面子规叫，晓树一声婆饼焦。\n耐久交当如水淡，惯游身亦似蓬飘。\n老莺不省春归久，犹自教雏学徙乔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38747,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杨蟾川铁佛普度会 其二","author":"施枢","text":"炜烨神光烛素屏，苦魂蒙度语堪听。\n但知实相皆非相，自證无形入有形。\n火炼赤炉超上景，水流华沼荡寒庭。\n功成试问谁能似，元子真人旧典刑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38748,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杨蟾川铁佛普度会 其一","author":"施枢","text":"重阴九垒几曾开，广布阴功亦异哉。\n八景定中朝十极，五云深处步三台。\n烟腾绿字鸾初下，月照黄坛鹤未来。\n去地一珠如黍米，天人竞凑郁罗台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38749,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"沧浪","author":"施枢","text":"长史遗踪二百年，直教名字到今传。\n渚香细浥莲须雨，野色轻团竹尾烟。\n但得幽情关水石，何须隐迹痼林泉。\n客中正有尘缨在，来此清游亦是缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38750,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"牡丹","author":"施枢","text":"天然贵格镇群芳，细雨丛中试宝妆。\n肯与乱红争国色，甘同柔绿挽春光。\n玉阑倚困娇无力，金鸭沉烟不敢香。\n可惜承恩亭北赋，苦无妙语告君王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38751,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和东圃郑震见寄","author":"施枢","text":"薄宦来京洛，相逢久更亲。\n丹心期为国，白发易催人。\n月冷乌惊夜，霜明鸡唤晨。\n呤边频自感，还染九衢尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38752,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和菊潭韵题秋潭买山图后","author":"施枢","text":"身世如萍漫浪休，机心谁遣误沙鸥。\n从来风月惊人句，即是湖山买屋谋。\n访友定寻云外寺，携壶须上竹边楼。\n知音自有渔樵侣，莫被人称第一流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38753,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]