[{"title":"句 其六","author":"释祖可","text":"清霜群木落，尽见西山秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59047,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杨梅","author":"释祖可","text":"五月杨梅已满林，初疑一颗价千金。\n味方河朔葡萄重，色比泸南荔子深。\n飞艇似闻新入贡，登盘不见旧供吟。\n诗成欲寄山中友，恐起头陀爱渴心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59048,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其十六","author":"释祖可","text":"有时罗袜步微月，想见江妃相与娱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59049,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其十七","author":"释祖可","text":"茅檐攲送晚，苔径曲邀春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59050,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其十八","author":"释祖可","text":"乱山争夕阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59051,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"绝句","author":"何正平","text":"坐见茅斋一叶秋，小山丛柱鸟声幽。\n不知叠嶂夜来雨，清晓石楠花乱流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59052,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"何正平","text":"一枝春瘦雪初消。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59053,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏石菖蒲","author":"释蕴常","text":"细水围棋石，纤纤手自移。\n几年离雁荡，万里到天池。\n浮玉春风后，小姑烟雨时。\n它年怀胜绝，魂梦亦清奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59054,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏兰","author":"释蕴常","text":"目断山河恨莫裁，折芳犹记小徘徊。\n细看叶底春风面，疑自幽篁影下来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59055,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送空上人","author":"释蕴常","text":"过了梨花春亦归，小窗新绿正相宜。\n白头更作西州梦，细雨青灯话别离。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59056,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"知止亭晚望寄清大师","author":"释蕴常","text":"柳绕平湖绿映堤，栏干人静夕阳迟。\n归鸦欲尽千林暝，白鸟飞来一段奇。\n短发缘愁分壮志，断云含雨入新诗。\n不堪更作怀人恨，歌罢竹枝成别离。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59057,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"别苏养直","author":"释蕴常","text":"老去难为别，愁边更著秋。\n碧芦围野水，落日满行舟。\n雁断西风急，天寒古寺幽。\n两乡无百里，能寄短书否。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59058,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登虎丘即事","author":"释蕴常","text":"九月凭栏已怯风，鬓霜留我客愁中。\n夕阳看尽烟生树，野水无情天四空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59059,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日","author":"释法具","text":"烧灯过了客思家，独立衡门数暝鸦。\n燕子未归梅落尽，小窗明月属梨花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59060,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江村","author":"释蕴常","text":"江村风急苇花飞，漠漠吹烟树影稀。\n亦有人家沙际住，夕阳鸡犬傍人归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59061,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游天台赤城山","author":"释蕴常","text":"拄藜扶我过桥东，便觉晴岚翠扫空。\n紫府百年藏玉简，丹崖千丈挹仙风。\n释签书到新罗国，卧佛岩连旧梵宫。\n稽首导师悲愿在，我宁辛苦守诗穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59062,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"覆射辞","author":"钟传客","text":"太岁当头立，诸神不敢当。\n其中有一物，犹带洞庭香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59063,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈三首 其一","author":"释元静","text":"君王了了，将帅惺惺。\n一回得胜，六国平宁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59064,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈三首 其二","author":"释元静","text":"行年七十老躘踵，眼目精明耳不聋。\n忽地有人欺负我，一拳打倒过关东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59065,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈三首 其三","author":"释元静","text":"自己田园任运耕，祖宗基业力须争。\n悟须千圣头边坐，用向三涂底下行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59066,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古六首 其一 即心即佛。","author":"释元静","text":"即心即佛，铁牛无骨。\n戏海狞龙，摩天俊鹘。\n西江吸尽未为奇，火里生莲香拂拂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59067,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古六首 其二 狗子无佛性。","author":"释元静","text":"赵州狗子无佛性，七佛如来合掌听。\n须弥岋崿舞三台，海水腾波行正令。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59068,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古六首 其三 野狐。","author":"释元静","text":"长蛇偃月，铁旗铁鼓。\n坐断乾坤，辉腾今古。\n曾骑铁马入重城，手握金鞭贺太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59069,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古六首 其四 女子出定。","author":"释元静","text":"怀藏日月，八面玲珑。\n袖里金锤，鲜血通红。\n香风拂拂，华雨濛濛。\n兵随印转处，万里长虹。\n将逐符行时，些子神通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59070,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古六首 其五 僧问琅琊清净本然。","author":"释元静","text":"清净本然云何，忽生山河大地。\n大小琅琊禅师，借人鼻孔出气。\n出得气，有巴鼻，昨夜那吒生八臂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59071,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古六首 其六 无缝塔。","author":"释元静","text":"皎洁天心月，朦胧遍九垓。\n三秋黄叶落，二月牡丹开。\n每睹南来雁，常询北方五台。\n均提童子报，拾得在天台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59072,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"呈法演偈答倩女离魂话","author":"普融知藏","text":"二女合为一媳妇，机轮截断难回互。\n从来往返绝纵由，行人莫问来时路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59073,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示李朝请偈","author":"释吉","text":"家贼恼人孰奈何，千圣回机祇为他。\n遍界遍空无影迹，无依无住绝笼罗。\n贼，贼，猛将雄兵收不得，疑杀天下老禅和，笑倒闹市古弥勒。\n休，休，不用将心向外求，回头瞥尔贼身露，和赃捉获世无俦。\n世无俦，真可仰，从兹不复誇伎俩。\n怗怗安家乐业时，万象森罗齐拊掌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59074,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"藕","author":"胡致隆","text":"平生冰雪姿，七星罗心胸。\n岂无有丝毫，上裨天子聪。\n而不自荐达，胡为乎泥中。\n沈痾政无赖，安得君从容。\n其子亦可怜，风味如乃翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59075,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"瘗鹤铭诗","author":"胡致隆","text":"当年谁为裹玄黄，潮打孤城草木荒。\n华表竟无新信息，断碑空有碎文章。\n云埋紫盖峰何在，烟锁青田道正长。\n遥想华亭披道氅，夜随明月过钱塘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59076,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题吴生画桃源图","author":"胡致隆","text":"王宰五日画一石，左思十年赋三都。\n谁似今时吴道子，咄嗟能办武陵图。\n武陵不与人间隔，可怜旧日无寻觅。\n苍苍烟水只依然，试倩渔舟问消息。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59077,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"冬寒","author":"胡致隆","text":"倚天松骨冷，背日海云高。\n淮上人垂櫜，阁中客赠袍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59078,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登铁瓮城","author":"胡致隆","text":"雉堞巍然岁月长，古今知阅几兴亡。\n吴王殿里笙歌罢，炀帝城边草木荒。\n万里烟霞归洞急，一川风月渡江忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59079,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"星子楼","author":"胡致隆","text":"葛中藤杖竹籧篨，静夜江楼纵目初。\n海兽擎山出彭蠡，玉龙衔水下匡庐。\n三更云尽猿啼露，十里月寒人捕鱼。\n已问湖山借圭角，他年来此老樵渔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59080,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"仰山","author":"胡致隆","text":"山下清泉迸石流，山前松竹自春秋。\n猿吟古寺偏深处，云集诸峰最上头。\n一老有灵飞窣堵，二神无语锁寒湫。\n诸天更在藤萝外，欲到峰前恨未由。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59081,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"玉山道中","author":"胡致隆","text":"江南江北水茫茫，水阔山遥道路长。\n细雨来时麋角解，春风归去马蹄香。\n市桥落日明官柳，古渡行人上野航。\n景物端宜入图画，孤城回首带斜阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59082,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"喜曹刘二从事见过","author":"胡致隆","text":"萧萧细雨锁柴门，喜见风流二使君。\n俊逸万春犹录事，清新子建尚参军。\n飘零世路诗千首，寥落江湖酒一尊。\n多病扬雄谢来往，暮年谁更可论文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59083,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"胡致隆","text":"金山顶上看回雁，铁瓮城西听杜鹃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59084,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"胡致隆","text":"细雨滕王阁，春风孺子亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59085,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"太华山","author":"谭纶","text":"楼阁凭天起，山门傍斗开。\n香烟凝碧落，瑞气压苍苔。\n古殿藏金屋，仙人卧玉隈。\n泉飞千涧雪，风送万峰雷。\n星辰光满袖，疑是法镫来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59086,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"方勺","text":"三十年前曾见梦，兹游端可冠平生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59087,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"广胜寺","author":"王荀","text":"重游萧寺十年过，四望风烟景若何。\n东北岭高明月绕，西南川远夕阳多。\n地饶胜概连灵岳，民足丰年藉绿波。\n却笑山僧无忌惮，一生安处在巍峨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59088,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游白鹤观","author":"李昭玘","text":"春归数十朝，八九不暇出。\n萌芽日夜发，百觜竞撑突。\n驾言谒仙祠，古像怀彷佛。\n白鹤来何时，苍桧暮萧窣。\n云霞断人世，往事已荒忽。\n解缨濯泉流，深澈几照骨。\n毛寒不敢视，下必有神物。\n昔人斯徜徉，音影讵磨没。\n嗟予质污下，见亦被呵咄。\n仰惭逍遥游，未忍尘土汩。\n时须挹高风，为我一吹拂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59089,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"从张圣涂乞石","author":"李昭玘","text":"先生筑高隐，趣好清且独。\n云龙峰上石，跋草自錾斸。\n发窍号阴怪，穷根揽坤腹。\n山灵不敢爱，鞭叱满崖谷。\n危跻已穿履，大载几折轴。\n直欲起岩岩，未容买碌碌。\n心营合天造，指化出神速。\n突兀傲中巅，凭陵勇双矗。\n兽蹲目睥睨，龙攫腰回蹙。\n缩脰立幽鸟，擎颅卧孤犊。\n鲸鳞老廉利，相角怒撑触。\n轩昂鹤引咮，赑屃鳌跂足。\n腾空快高思，排峭惊醉目。\n伊余朅来游，步百吟周复。\n愿从乞其馀，伴我东墙竹。\n猿鹤莫相嗔，此客意非俗。\n常令月色照，敢使尘土辱。\n日待风雨来，起看空绕屋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59090,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送王子中南归筠州","author":"李昭玘","text":"荆山美璞昔未发，鬼神诃守谁可夺。\n妙工伐石强剖抉，试之烈火皎冰雪。\n长虹射天昼不灭，夜堂流光堕明月。\n坚厚粹温函正气，不许时人巧雕砺。\n羞与佩环争细碎，直登丘坛荐天帝。\n世无琅玕来作贡，楚人未售空长恸。\n索价当高勿轻用，缇囊十袭须珍重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59091,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送徐州举人赴省试","author":"李昭玘","text":"淮夷之珠照夜明，泗滨之石声泠泠。\n昔时大禹致方物，神光玉色罗广庭。\n比年入献多豪英，褒雄妙思相凭陵。\n飘飘束书去观国，瘦马踏雪须垂冰。\n长廊白昼天宇清，落笔冉冉风云生。\n千官拱笏赭袍近，碧沟新柳黄鹂鸣。\n金挝虎士传姓名，鱼龙卷尾随雷声。\n州人洗眼望归期，会约春风载酒迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59092,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪堂诗寄子瞻","author":"李昭玘","text":"愁云蔽日昏风发，鹅毛大片舞空阔。\n阴崖冰压木枝折，一鸟不飞人足绝。\n山翁口掉肩拥褐，斫竹撑茅劳架结。\n堂成不用巧丹涅，却画东坡四山雪。\n群石崭崭争皎洁，门外堂间两清洌。\n万境一心同瑩彻，石床云生湿肌发。\n布被飕飕冷于铁，半夜哀猿叫山月。\n山翁高哦响修越，不道妻啼忧米竭。\n世事薰膏付灰灭，长安高门奔请谒。\n赤日炙背沙埋辙，仆夫汗流马吐舌。\n三谒不逢腹欲爇，怒气恐成疽毒裂。\n狂走不须求扇暍，此堂一登能濯热。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59093,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢刘主簿见和乞石诗","author":"李昭玘","text":"官居太疏冷，门外少车迹。\n萧萧此君轩，为我慰穷寂。\n贪饕起馀慕，远乞南山石。\n形模太诡陋，此咏费搜摭。\n虾蟆欲上瓮，作气屡跳踯。\n心知不可强，怒瘿犹鼓息。\n但劳旁者观，笑尔不量力。\n君能惠然来，抵鹊轻尺璧。\n明月投我怀，坐上光彩溢。\n神心巧镌凿，变化出胸臆。\n高言写豪壮，健读口终吃。\n冲风卷海涛，荡潏迷四极。\n阵马脱重围，战士皆辟易。\n使人魂魄沮，三日不敢食。\n嗟余性顽闇，兀兀寡知识。\n臃肿终天年，不愿借雕饰。\n翻怜孤僻中，趣味得所适。\n拂石云生手，诵诗风满腋。\n此应长不饥，富贵乃毒腊。\n人生多苦辛，嗜好须自择。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59094,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"昂昂千里驹","author":"李昭玘","text":"昂昂千里驹，逸气吞九区。\n东驰越夕兔，西走穷朝乌。\n关山一息过，踯躅疑有无。\n快哉穆天子，远驾周四隅。\n嘶声想云海，弄影有天衢。\n昆丘距赤水，度足才须臾。\n眷言刍粟恩，岂敢论形躯。\n雄心忽摧顿，倦步成踌躇。\n日暮路途远，天寒毛鬣疏。\n此时垂耳心，可复轻疲驽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59095,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"泛泛水中凫","author":"李昭玘","text":"泛泛水中凫，上下声相呼。\n徜徉信波浪，澡濯羞泥污。\n晴洲漾蘋荇，雨岸眠菰蒲。\n饮啄亦自足，飞游谁我拘。\n侯门大池籞，富屋夸庖厨。\n何惭久垂翅，未愿轻投躯。\n虽非黄鹄举，幸与白鹭娱。\n逃烹笑穷雁，啄腐嗟饥乌。\n三秋熟粱稻，万里开江湖。\n寄言泽中子，何用张罗□。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59096,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"飞鸿亭","author":"李昭玘","text":"平野浩空阔，危甍兀岧峣。\n腊尽风日好，春回冰雪消。\n朱弦试挥手，度响何翛翛。\n此意复谁共，古人今寂寥。\n眷彼泽中鸿，欻起如回飙。\n悠然薄天末，去去不可招。\n愧无双羽翰，万里同飘飖。\n人生本萧散，知虑劳煎烧。\n恈恈觇声利，伛偻随纷嚣。\n安知出世间，造适皆逍遥。\n帝乡果何在，久愿追松乔。\n行歌归去来，五斗空折腰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59097,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"驱雀行","author":"李昭玘","text":"田间小儿杖驱雀，雀飞上枝不敢落，绕树咒骂语声恶。\n三时耕锄一时穫，老牛力尽石田薄。\n五龙作嗔风吐雹，赤乌烧云龙见逐。\n南村卖桑北村熟，狐尾毵毵穗齐屋。\n县门大书催赋粟，南关飞挽夜摩毂。\n扫舂缚箕十指秃。\n一米未炊汝先啄，直须杀汝偿我腹。\n田父坐语儿，雀不暴人人亦饥。\n但令家雀千群饱，莫使征西战马肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59098,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日游西池","author":"李昭玘","text":"雨馀风日暖，野塘春水满。\n天影倒浮人，镜光环射眼。\n兰船不可上，漠漠低烟晚。\n归路已埃尘，沧波凫鹄远。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59099,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观江都王画马","author":"李昭玘","text":"落落名王唐帝孙，笔端飞洒只逡巡。\n风云绝足知何在，粉墨馀姿若有神。\n可信权奇尽龙种，不应腲鮾失天真。\n骅骝寂寞龙眠死，更复何人接后尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59100,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"暮冬书怀赠次膺四首 其一","author":"李昭玘","text":"一气推迁星复回，人生常苦岁华催。\n冻云欲雪雁声过，腊酒正香梅信来。\n昼梦每因啼鸟唤，柴门独为故人开。\n自怜衰晚无多事，心地都成一寸灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59101,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"暮冬书怀赠次膺四首 其二","author":"李昭玘","text":"不住寒岩不姓庞，亦无短艇钓清江。\n门庭昼寂人攲枕，几案春生日上窗。\n五鼎甘心争逐兽，万夫落胆看寻橦。\n何如种取东皋秫，烂醉床头酒百缸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59102,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"暮冬书怀赠次膺四首 其三","author":"李昭玘","text":"多病犹凭药可医，若为换却镜中丝。\n人生得意一搔痒，世事循环千弈棋。\n幸有归来陶令计，何须惆怅杜秋诗。\n慇勤田父劳相语，天命吾今不复疑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59103,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"暮冬书怀赠次膺四首 其四","author":"李昭玘","text":"惭愧儒冠误此身，涂穷何假问通津。\n门前罗雀正吾事，墙角负暄非世人。\n自喜小槽长有酒，独惊华发不便春。\n知君泽畔成新筑，拟荷锄犁去卜邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59104,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"出郭閒步","author":"李昭玘","text":"城市不在眼，始知天宇宽。\n田园休岁事，风物似江干。\n茅屋上斜照，水烟生晚寒。\n径须追野老，笑语暂盘桓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59105,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寇彦时自历下归携古铁刀白石压尺见赠因以二诗答之 其一 白石压尺","author":"李昭玘","text":"素质并琳琅，磨砻若截肪。\n动摇风莫虑，点污墨须防。\n色带泉流润，声含磬韵长。\n愿登青玉案，时助写云章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59106,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寇彦时自历下归携古铁刀白石压尺见赠因以二诗答之 其二 古铁刀","author":"李昭玘","text":"战地久埋没，洪炉为再烧。\n曾因土花缺，不逐血魂销。\n拟借庖丁手，宁悬笔吏腰。\n柔铅勿多忌，一割定相饶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59107,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵庭玉弟暮春作","author":"李昭玘","text":"小雨廉纤春欲归，桃花吹尽燕来迟。\n闭门却有宜人处，帘幕阴阴睡起时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59108,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戏赠阎汉臣庙令","author":"李昭玘","text":"香火馀金月十千，指呼巫觋示威权。\n如何报得君王赐，沥酒慇勤祝万年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59109,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又戏赠汉臣","author":"李昭玘","text":"萧散官资近十千，不须亲旧祝无权。\n虎头食肉非虚语，可待谁人报有年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59110,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"睡起","author":"李昭玘","text":"病夫无酒破春愁，扫榻焚香作睡谋。\n梦觉不知身是蝶，午鸡声里思悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59111,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]