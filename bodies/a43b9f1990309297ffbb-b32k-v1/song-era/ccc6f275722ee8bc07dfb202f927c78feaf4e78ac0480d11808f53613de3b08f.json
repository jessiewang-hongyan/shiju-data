[{"title":"社日诸人集西冈","author":"朱熹","text":"郊原暧芳物，细雨青春时。\n前冈遐敞地，登览情无遗。\n农亩怀岁功，壶浆祝神釐。\n我惭里居氓，十载劳驱驰。\n今朝幸休闲，追逐聊嘻嘻。\n笑语欢成旧，尽醉靡归期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20072,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"久雨斋居诵经","author":"朱熹","text":"端居独无事，聊披释氏书。\n暂释尘累牵，超然与道俱。\n门掩竹林幽，禽鸣山雨馀。\n了此无为法，身心同晏如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20073,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"新竹","author":"朱熹","text":"春雷殷岩际，幽草齐发生。\n我种南窗竹，戢戢已抽萌。\n坐获幽林赏，端居无俗情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20074,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雨中示魏惇夫兼怀黄子厚二首 其一","author":"朱熹","text":"读书春日晏，雨至满郊园。\n一洒幽丛竹，蔼蔼清阴繁。\n斋居无还往，镇日空掩门。\n欲将冲静趣，与子俱忘言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20075,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雨中示魏惇夫兼怀黄子厚二首 其二","author":"朱熹","text":"暄风变春馀，卉木日葱茜。\n林间一雨来，满庭寒草遍。\n寂寞谢朋俦，晤语怀隽彦。\n良无一水遥，阻阔何由见。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20076,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夜闻子规","author":"朱熹","text":"幽林欲雨气含凄，春晚端居园径迷。\n独向高斋展衾卧，南山夜夜子规啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20077,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"杜门","author":"朱熹","text":"杜门守贞操，养素安冲漠。\n寂寂閟林园，心空境无作。\n细雨被新筠，微风动幽箨。\n聊成五字句，吟罢山花落。\n浩然与谁期，放情遗所托。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20078,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿山寺闻蝉作","author":"朱熹","text":"林叶经夏暗，蝉声今夕闻。\n已惊为客意，更值夕阳曛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20079,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"晨登云际阁","author":"朱熹","text":"晨起踏僧阁，徙倚望平郊。\n攒峦夏云晓，苍茫林影交。\n暂释川途念，憩此烟云巢。\n聊欲托僧宇，岁晏结蓬茅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20080,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"池上示同游者","author":"朱熹","text":"藕叶盖波面，池花犹未红。\n聊承晓露馀，散步咏凉风。\n香气已飘忽，客怀谁与同。\n唯应同游子，芳意更匆匆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20081,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过黄塘岭","author":"朱熹","text":"屈曲危塍转，沉阴山气昏。\n蝉声高树暗，石濑浅流喧。\n已过黄塘岭，欲觅桃花源。\n无为此留滞，驱马踰山樊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20082,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿白芒畬","author":"朱熹","text":"早发招贤里，夜宿白芒畬。\n川暝前山雨，风惊涧树花。\n途陆绵异县，曛黑泊田家。\n逢人聊问路，犹恨去程赊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20083,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"濯足涧水二首 其一","author":"朱熹","text":"濯足涧边石，山空水流喧。\n行旅非吾事，寄此一忘言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20084,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"濯足涧水二首 其二","author":"朱熹","text":"涧边濯足时，脩途倦烦燠。\n振策欲寻源，山空无往躅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20085,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自溪口买舟至顺昌示同行者","author":"朱熹","text":"时燠倦长途，买舟至西郭。\n烟波方渺然，坐此溪上阁。\n子留且欢宴，我去成萧索。\n同行不同调，此意谁与托。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20086,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿筼筜铺","author":"朱熹","text":"庭阴双树合，窗夕孤蝉吟。\n盘礴解烦郁，超摇生道心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20087,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"倒水坑作","author":"朱熹","text":"穷幽鲜外慕，殖志在丘园。\n即此竟无得，空恨岁时迁。\n川陆绵半载，烦燠当归缘。\n憩此苍山曲，洗心闻涧泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20088,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夏日二首 其一","author":"朱熹","text":"夏景已逾半，林阴方澹然。\n鸣蝉咽馀响，池荷竞华鲜。\n抱痾守穷庐，释志趣幽禅。\n即此穷日夕，宁为外务牵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20089,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夏日二首 其二","author":"朱熹","text":"云臻川谷暝，雨来林景清。\n斋舍无馀事，凉气散烦缨。\n望山怀释侣，盥手阅仙经。\n谁怀出尘意，来此俱无营。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20090,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"对雨","author":"朱熹","text":"虚堂一游瞩，骤雨满空至。\n的皪散方塘，冥濛结云气。\n势逐风威乱，望穷山景翳。\n烟霭集林端，苍茫欲无际。\n凉气袭轻裾，炎氛起秋思。\n对此景凄凄，还增冲澹意。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20091,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"斋居闻磬","author":"朱熹","text":"幽林滴露稀，华月流空爽。\n独士守寒栖，高斋绝群想。\n此时邻磬发，声合前山响。\n起对玉书文，谁知道机长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20092,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"又闻琴作","author":"朱熹","text":"瑶琴清露后，寥亮发窗间。\n韵逐回风远，情随玄夜阑。\n端居独无寐，林扉空掩关。\n起望星河落，哀弦方罢弹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20093,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"读道书作六首 其二","author":"朱熹","text":"失志堕尘网，浩思属沧洲。\n灵芝不可得，岁月逐江流。\n碧草晚未凋，悲风飒已秋。\n仰首鸾鹤期，白云但悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20094,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"读道书作六首 其三","author":"朱熹","text":"白露坠秋节，碧阴生夕凉。\n起步广庭内，仰见天苍苍。\n东华绿发翁，授我不死方。\n愿言勤脩学，接景三玄乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20095,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"读道书作六首 其四","author":"朱熹","text":"四山起秋云，白日照长道。\n西风何萧索，极目但烟草。\n不学飞仙术，日日成丑老。\n空瞻王子乔，吹笙碧天杪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20096,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"读道书作六首 其五","author":"朱熹","text":"郁罗耸空上，青冥风露凄。\n聊乘白玉鸾，上与九霄期。\n激烈玉箫声，夭矫餐霞姿。\n一回流星盻，千载空相思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20097,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"读道书作六首 其六","author":"朱熹","text":"王乔吹笙去，列子御风还。\n至人绝华念，出入有无间。\n千载但闻名，不见冰玉颜。\n长啸空宇碧，何许蓬莱山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20098,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋雨","author":"朱熹","text":"一雨散林表，清阴生广庭。\n喜兹新秋夜，起向高斋行。\n烦歊获暂祛，凉氛集华缨。\n沉沉远林气，惬此端居情。\n节物坐如此，抚世襟方盈。\n归当息华念，超遥悟无生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20099,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋夕怀子厚二首 其一","author":"朱熹","text":"雨歇林气爽，月华湛遥晖。\n斋居玩物变，廓落沧洲期。\n焚香散碧虚，抚节陈清诗。\n抗志属云端，非君谅谁知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20100,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋夕怀子厚二首 其二","author":"朱熹","text":"凉气沉斋宇，夕阴未渠央。\n寒栖属遥夜，长簟卷单床。\n浮云蔽中天，愁霖隔秋窗。\n思君一晤对，耿耿何能忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20101,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"病中呈诸友","author":"朱熹","text":"穷居值秋晦，抱疾独斋居。\n行稀草生径，一雨复旬馀。\n交亲各所营，旷若音尘疏。\n始悟端居乐，复理北窗书。\n读诵兴已阑，起坐方踌躇。\n绿树满空庭，策策凉飙初。\n良时不复停，烦吝未云祛。\n还思对君子，日夕伫轩车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20102,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"川上见月归示同行者","author":"朱熹","text":"川上偶携手，皓月起林端。\n一舒临流望，玄露已先漙。\n归掩荒园扉，更怯裳衣单。\n清夜可晤言，独处谁为欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20103,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"月夜述怀","author":"朱熹","text":"皓月出林表，照此秋床单。\n幽人起晤叹，桂香发窗间。\n高梧滴露鸣，散发天风寒。\n抗志绝尘氛，何不栖空山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20104,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠仰上人","author":"朱熹","text":"涧谷秋云晓，飘飖无定姿。\n氛氲升远树，凌乱起寒飔。\n雨罢成孤鹤，天高逐散丝。\n上人归别岭，心迹但如斯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20105,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"即事偶赋","author":"朱熹","text":"白烟竟日起，雨晦苍山深。\n老菊不复妍，丹枫满高林。\n抱病寝斋房，窗户结愁阴。\n起望一舒情，遐眺豁烦襟。\n人生亦已劳，世路方崎嵚。\n且咏招隐作，无为名迹侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20106,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"作室为焚修之所拟步虚辞","author":"朱熹","text":"归命仰璇极，寥阳太帝居。\n翛翛列羽幢，八景腾飞舆。\n愿倾无极光，回驾俯尘区。\n受我焚香礼，同彼浮黎都。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20107,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄题咸清精舍清晖堂","author":"朱熹","text":"山川佳丽地，结宇娱朝昏。\n朝昏有奇变，超忽难具论。\n千岚蔽夕阴，百嶂明晨暾。\n穹林擢遥景，回涧荡秋氛。\n览极惭未周，穷深遂忘喧。\n欲将身世遗，况托玄虚门。\n境空乘化往，理妙触目存。\n珍重忘言子，高唱绝尘纷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20108,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"冬日二首 其一","author":"朱熹","text":"萧索时序晚，已复度高秋。\n回涧白波起，通川绛树稠。\n晨风散清霜，嘉稻卷平畴。\n独怀志士感，岁事幸将休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20109,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"冬日二首 其二","author":"朱熹","text":"清霜染涧树，萧索向严冬。\n密雨有时集，寒云无定容。\n波明横濑出，风急远林空。\n一极窗间眺，高旻矗乱峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20110,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春日即事","author":"朱熹","text":"郊园卉木丽，林塘烟水清。\n闲栖众累远，览物共关情。\n憩树鸟啼幽，缘原草舒荣。\n悟悦心自遣，谁云非达生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20111,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"诵经","author":"朱熹","text":"坐厌尘累积，脱躧味幽玄。\n静披笈中素，流味东华篇。\n朝昏一俯仰，岁月如奔川。\n世纷未云遣，仗此息诸缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20112,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春日言怀","author":"朱熹","text":"春至草木变，郊园犹掩扉。\n兹晨与心会，览物遍芳菲。\n桃萼破浅红，时禽悦朝晖。\n泉谷暖方融，原田水初肥。\n东作兴庶氓，岁功始在兹。\n端居适自慰，世事复有期。\n终然心所向，农亩当还归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20113,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"晚步","author":"朱熹","text":"东原郁已秀，嘉树蔼初绿。\n众卉发春阳，前山可遐瞩。\n端居日康倦，涉涧步墟曲。\n景幽恣所寻，悟悦何由足。\n鸟鸣华薄深，泉响乱流续。\n握手一同忻，吾生讵幽独。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20114,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"怀友","author":"朱熹","text":"山夕烟景乱，林空鸟啼幽。\n怀人隔春江，梦想积离忧。\n览物怀悄悄，临觞但悠悠。\n徘徊东西步，悟叹复何求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20115,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山馆观海棠作二首 其一","author":"朱熹","text":"景暄林气深，雨罢寒塘渌。\n置酒此佳辰，寻幽慕前躅。\n芳树丽烟华，紫绵散清馥。\n当由怀别恨，寂寞向空谷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20116,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山馆观海棠作二首 其二","author":"朱熹","text":"春草池塘绿，忽惊花屿红。\n乱英深浅色，芳气有无中。\n置酒宾朋集，披襟赏咏同。\n若非摹写得，应逐綵云空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20117,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题画","author":"朱熹","text":"青鸾凌风翔，飞仙窈窕姿。\n高挹谢尘境，妙颜粲琼蕤。\n登霞抗玉音，结雾吹参差。\n神钧舞空洞，玄露湛霄晖。\n山中玉斧家，胡不一来嬉。\n真凡路一分，冥运千年期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20118,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过武夷作","author":"朱熹","text":"弄舟缘碧涧，栖集灵峰阿。\n夏木纷已成，流泉注惊波。\n云阙启苍茫，高城郁嵯峨。\n眷言羽衣子，俛仰日婆娑。\n不学飞仙术，累累丘冢多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20119,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"同安官舍夜作二首 其一","author":"朱熹","text":"官署夜方寂，幽林生月初。\n闲居秋意远，花香寒露濡。\n故国异时节，欲归怀简书。\n聊从西轩卧，尘思一萧疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20120,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"同安官舍夜作二首 其二","author":"朱熹","text":"窗户纳凉气，吏休散朱墨。\n无事一翛然，形神罢拘役。\n暂愒岂非闲，无论心与迹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20121,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄山中旧知七首 其一","author":"朱熹","text":"结茅云壑外，石涧流清泉。\n涧底采菖蒲，颜色永芳鲜。\n超世慕肥遁，鍊形学飞仙。\n未谐物外期，已绝区中缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20122,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄山中旧知七首 其二","author":"朱熹","text":"客子归来晚，江湖欲授衣。\n路岐终寂寞，老天足伤悲。\n慷慨平生志，冥茫造物机。\n清秋雕鹗上，万里看横飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20123,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄山中旧知七首 其三","author":"朱熹","text":"晨兴香火罢，入室披仙经。\n玄默岂非尚，素餐空自惊。\n起与尘事俱，是非忽我营。\n此道难坐进，要须悟无生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20124,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄山中旧知七首 其四","author":"朱熹","text":"故园今夜半，林影澹逾清。\n曳杖南溪路，君应独自行。\n潺湲流水思，萧索早秋声。\n尽向琴中写，焉知离恨情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20125,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄山中旧知七首 其五","author":"朱熹","text":"采药侵晨入乱峰，宿云无处认行踪。\n归来应念尘中客，寄与玄芝手自封。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20126,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄山中旧知七首 其六","author":"朱熹","text":"凄凉梧叶变，芬馥桂花秋。\n日夕湖皋胜，哦诗忆旧游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20127,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄山中旧知七首 其七","author":"朱熹","text":"秋至池阁静，天高林薄疏。\n西园有佳处，那得与君俱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20128,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"述怀","author":"朱熹","text":"夙尚本林壑，灌园无寸资。\n始怀经济策，复愧轩裳姿。\n效官刀笔间，朱墨手所持。\n谓言殚蹇劣，讵敢论居卑。\n任小才亦短，抱念一无施。\n幸蒙大夫贤，加惠宽箠苔。\n抚己实已优，于道岂所期。\n终当反初服，高揖与世辞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20129,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"释奠斋居","author":"朱熹","text":"理事未逾月，簿书终日亲。\n简编不及顾，几阁积埃尘。\n今辰属斋居，烦局一舒伸。\n瞻眺庭宇肃，仰首但秋旻。\n茂树禽转幽，忽如西涧滨。\n聊参物外趣，岂与俗子群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20130,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"试院杂诗五首 其一","author":"朱熹","text":"斋宇夜沉寂，凄凉群物秋。\n卧听檐泻尽，心属故园幽。\n了事知何日，分曹喜胜流。\n笑谈真暂尔，不敢恨淹留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20131,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"试院杂诗五首 其二","author":"朱熹","text":"寒灯耿欲灭，照此一窗幽。\n坐听秋檐响，淋浪殊未休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20132,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"试院杂诗五首 其三","author":"朱熹","text":"穷秋一雨至，暂止复萧萧。\n曲沼寒流满，空庭凉叶飘。\n闻钟怀故宇，览物属今朝。\n一咏归来赋，顿将形迹超。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20133,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"试院杂诗五首 其四","author":"朱熹","text":"长廊一游步，爱此方塘净。\n急雨散遥空，圆文满幽镜。\n阶空绿苔长，院僻寒飙劲。\n长啸不逢人，超摇得真性。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20134,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"试院杂诗五首 其五","author":"朱熹","text":"艺苑门禁肃，长廊似僧居。\n偶来一散步，暂与尘网疏。\n文字谢时辈，铨衡赖群儒。\n伊予独何者，偪仄心烦纡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20135,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"岩桂","author":"朱熹","text":"山中绿玉树，萧洒向秋深。\n小阁芬微度，书帷气欲侵。\n披怀清露晓，遇赏夕岚阴。\n珍重王孙意，天涯泪满襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20136,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋怀","author":"朱熹","text":"井梧已飘黄，涧树犹含碧。\n烟水但逶迤，空斋坐萧瑟。\n端居生远兴，散漫委书帙。\n爱此北窗闲，时来岸轻帻。\n微钟忽迢递，禽语破幽寂。\n赏罢一悁然，淡泊忘所适。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20137,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"喜晴","author":"朱熹","text":"冲飙动高柳，渌水澹微波。\n日照秋空净，雨馀寒草多。\n放怀遗簿领，发兴托烟萝。\n忽念故园日，东阡时一过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20138,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夜赋","author":"朱熹","text":"暗窗萤影乱，秋帏露气深。\n群籁喧已寂，青天但沈沈。\n恻怆怀高侣，幽默抱冲襟。\n遥忆忘言子，一写山水音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20139,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"晓步","author":"朱熹","text":"初日丽高阁，广步爱脩廊。\n重门掩秋气，高柳荫方塘。\n闽海冬尚温，晏阴天未霜。\n坐悲景物殊，亦念岁时荒。\n故园属佳辰，登览遍陵冈。\n宾游尽才彦，萧散屏壶觞。\n别来时已失，怀思宁暂忘。\n宦游何所娱，要使心怀伤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20140,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]