[{"title":"次韵裴库部雪二首 其二","author":"刘攽","text":"似薄凝霜不振威，端凌爱日夺光辉。\n变成盐浦风沙乱，卷起涛江海上飞。\n西望屯云瞻魏阙，正思鸣佩贺端闱。\n孤城牢落无来客，坐待山明见翠微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40977,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"太一宫奉安后得雪","author":"刘攽","text":"八通除道接层霄，五日同云映泬寥。\n灵贶那从天马下，积阴疑有海神朝。\n润生尘陌无穷远，甘入原田不待消。\n陋巷苦寒方昼卧，静无人迹到琼瑶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40978,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪中呈通判库部宋职方","author":"刘攽","text":"冬雪并今早两回，无风韵腻白皑皑。\n麦根得润萌芽绿，瘴气逢寒雾露开。\n官为劝农知我喜，心缘爱客望君来。\n城头甚有登临境，群玉排峰银作台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40979,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"钱穆甫杨康功使高丽还为中书舍人书此为寄","author":"刘攽","text":"天子边人二使星，沧波一笑已扬舲。\n大明照海阳乌近，黑雾迎潮水怪腥。\n北貊左肩输策略，西垣右掖付仪刑。\n授诗三百成专对，更看黄麻似六经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40980,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬狄奉议","author":"刘攽","text":"病卧湘滨面岳山，每听鸣鹤忆苏仙。\n三苗地阔横千里，五岭泉分会一川。\n门有雀罗甘弃置，人今舞袖足回旋。\n梁公孙子丹青似，倾盖欢然秀句传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40981,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬张伯常朝议","author":"刘攽","text":"郢人兰雪有馀风，尽在君家七字中。\n白发尘缨深念我，青郊藜杖不如公。\n乡心正想千年鹤，老计终须一亩宫。\n不讳求田并问舍，景山何必晚为通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40982,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬黄朝议 其一","author":"刘攽","text":"自无筹略预材难，非有文华聚笔端。\n涉历羊肠迷坦坦，穿联鱼目愧珊珊。\n岳猿听久堪头白，林实尝来厌齿酸。\n葵藿倾心由物性，日边依约见长安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40983,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬黄朝议 其二","author":"刘攽","text":"蘧公四十九年非，万事当须向老知。\n材者不如愚者乐，前人多作后人资。\n羡君黄发初倾盖，矜我迷津数赠诗。\n听话朱陵仙府事，慨然清啸一伸眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40984,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬魏朝议","author":"刘攽","text":"莺谷相从列俊英，四朝容许滥虚名。\n忍将百老言存没，乍喜三人咏合并。\n春入芳菲皆意思，酒随衰朽即心情。\n新诗不怪烦先唱，犹向君前畏后生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40985,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠黄朝议","author":"刘攽","text":"黄公八十健精神，远近推为五福身。\n樽酒不曾轻贱士，炉丹时复遇幽人。\n晚夸乡里拖金紫，早见儿孙列搢绅。\n一事世儒难学处，弟兄归老乐相亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40986,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和孔朝议","author":"刘攽","text":"自愧专城无到客，今晨锡宴喜君同。\n诗言泮水始可与，酒胜邯郸长不空。\n但有葵心倾日下，待看云瑞起封中。\n高车清兴底易尽，怪似林间束缊翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40987,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和张给事喜雨","author":"刘攽","text":"勿惊四野连宵雨，尽是诸山触石云。\n雷响透空如欲坠，电光划暗总成纹。\n祝官陈信无虚语，梵宇凝香不断薰。\n帝力由来人莫识，始知延誉属夫君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40988,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵韩康公","author":"刘攽","text":"行马门阑与古同，客车连轸响隆隆。\n定知醉饱能容士，当信康宁尽属公。\n剽得新声夸耳性，传将佳句愈头风。\n文人桃李多无数，珠玉旁边愧此翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40989,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵韩康公二首 其一","author":"刘攽","text":"叠石疏篁浅药苗，淡云清雨意寥寥。\n酂侯僻地规摹别，荀令西濠步武遥。\n绕砌芝兰欢内集，满蹊桃李慰佳招。\n原情独恨飞鸿远，怅望三秋咏采萧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40990,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵韩康公二首 其二","author":"刘攽","text":"清汝泱泱紫逻深，绿车红旆付重临。\n圣朝不逆原鸰意，达士俱存塞马心。\n日赤报衙容晏枕，夜兰留宴纵清斟。\n凤池何必全胜此，薄暮归休客万簪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40991,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王史馆园","author":"刘攽","text":"鸣泉傍舍水翻车，修竹连云曲径斜。\n谢傅东山非独往，酂侯避地此传家。\n丹椒红桂随时实，绿芰绯薇触处花。\n到客可能忘外事，断年相与玩芳华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40992,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过柏林院僧吉长老有古殿吴道子画维摩居士又有断碑是宝历年中记义岑禅师住院事","author":"刘攽","text":"灵光岁久独岿然，岘首遗碑亦未迁。\n会向三生记前佛，暂从方丈识诸天。\n篆香徐刻黄金印，梵宇时开贝叶篇。\n门外霜风正摇落，庭前翠柏自安禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40993,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"馆宿有怀平甫","author":"刘攽","text":"铜壶上水掖门扃，岑寂回廊起独行。\n日下屋山三面赤，月临天井四方明。\n校经灯火初无禁，汗简文书不计程。\n坐忆故人清夜语，淡云飞去隔层城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40994,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"曲阜宣圣庙夫子手植桧二首 其一","author":"刘攽","text":"秀色拿空四十围，问年今已倍千斯。\n移根信假杓关力，息荫宁无煖席时。\n文字鲁恭经改观，履綦钟意想攀枝。\n季孙亦自誉佳树，漫负甘棠蔽芾诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40995,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"曲阜宣圣庙夫子手植桧二首 其二","author":"刘攽","text":"伐树商丘去被围，似于庭桧特勤斯。\n禹腰尧颡应遗魄，柏叶松身异曩时。\n恭梓二三千学士，爱棠四十六孙枝。\n摄衣下马低回久，更就清风一诵诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40996,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"城濠泛舟同毕长官","author":"刘攽","text":"绿水环城十二里，茅茨带郭百馀家。\n侵云柳影不见日，过雨荷香全胜花。\n幽事围棋翻局势，清欢煮雪试茶芽。\n眼前景物自萧散，何必青溪向若邪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40997,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵酬姚都官时会堂见寄","author":"刘攽","text":"百里昆冈半草莱，画梁危栋一朝开。\n清川去水萦回渚，乔木浓阴映绿苔。\n子献人琴俱不幸，武侯营垒信奇才。\n断鸿牢落情愁绝，闻笛那堪赋七哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40998,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游船","author":"刘攽","text":"太液沧波北下流，依然清浅可胜舟。\n浴凫鸣鹤辉辉日，折苇衰荷澹澹秋。\n胜境陈前终不厌，机心去尽了无愁。\n宋生善赋登临兴，华发相从免独游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40999,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和晁金部感秋","author":"刘攽","text":"秋来无闷亦无悲，世味年华老遍知。\n黄叶暮蝉携杖处，断霞鸣雁倚楼时。\n淮阳汲守容多病，水部何郎最解诗。\n咫尺音书那度岁，春风已复柳垂丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41000,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"双桧","author":"刘攽","text":"双桧森森高出檐，忆昨卜邻逢吉占。\n清风似主我为客，冠盖相向何凝严。\n爱棠不能如召伯，种柳自觉胜陶潜。\n春晖渐永群芳丽，翠影看花一寸添。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41001,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题王金吾园亭","author":"刘攽","text":"乌衣里巷接城隅，东第名园冠上都。\n家事从前贵公子，宦游当世执金吾。\n旧蹊桃李春相续，满地芝兰德不孤。\n故有鼎彝传盛烈，况闻图史自为娱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41002,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"负暄","author":"刘攽","text":"闻道帝师仍负暄，遥知爱景满维垣。\n鹰扬肯顾踆乌逝，龙衮尤怜夸父奔。\n赤舄正宜随步武，白驹那敢离庭轩。\n野人皆欲献天子，他日期公助一言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41003,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陈通议园亭","author":"刘攽","text":"聚星休沐事依然，社腊安车不计年。\n五福何妨兼第宅，一壶元自有神仙。\n种来珍木如人立，移取名花夺地偏。\n闻道都城曾问卜，始知机石不虚传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41004,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杜介供奉园亭","author":"刘攽","text":"侧径群芳经荷锄，小窗明日喜观书。\n下床便得山居乐，深巷仍多长者车。\n省事即知长脱洒，养生元不待赢馀。\n客来一醉聊相向，莫问经年甔石储。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41005,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬黄安期推官见寄","author":"刘攽","text":"郴江清澈照毫毛，吹笛平阳舍有蒿。\n乡信不嫌无过雁，宦游正复长儿曹。\n青枫雨后如人立，南极秋来出地高。\n齐难楚称何日就，钓竿元自欲连鳌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41006,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬黄推官","author":"刘攽","text":"既将鱼目换骊珠，富润囊箱足贾馀。\n顾我能知天下马，呼儿藏作箧中书。\n老羞流辈为千诺，狂守初心付两如。\n相助飞鸣竟何力，祇宜空手讲玄虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41007,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"予所居本章丞相旧第他日友人杨彦文为余道丞相时事因作一篇予杨丞相以郎官始卜此宅不出都门二十馀年遂至台衮故末句及之","author":"刘攽","text":"酂侯常以俭为师，僻地依然草满蹊。\n却指旧池曾浴凤，更攀乔树忆栖鸡。\n清泉恶石皆吾有，樽酒囊书得自携。\n谁道为郎多白首，已看霖雨出蟠泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41008,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与成太博九同年会饮成四韵","author":"刘攽","text":"江海分龙不计年，异方倾盖意欢然。\n壮夫白首惊相问，浊水清尘默自怜。\n万事过前都是梦，一杯相属独非天。\n得朋正复同心士，赋咏能忘垂陇篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41009,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游玉仙观寄王四十","author":"刘攽","text":"紫府仙真冰雪颜，丹梯岑寂试来攀。\n翠鬟濯玉交团扇，浓雾喷香闇博山。\n不信异人能到此，正怜春意已归还。\n吹笙化舄知君事，犹恨来游先后间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41010,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"京北流人","author":"刘攽","text":"嗟尔流人亦可悲，白头老叟抱中儿。\n不羞远作投荒客，自恨生迟外户时。\n鱼失江湖相喣沫，鸟囚笼槛苦啼饥。\n乡原日日生荆棘，说似旁人犹涕垂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41011,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观灌园偶书","author":"刘攽","text":"一叟汲泉摇辘轳，老妻分水亦携锄。\n青青宿草知春入，浥浥苍苔过雨初。\n劳力不应嗤强勉，养生何必待赢馀。\n白头当作于陵子，身教儿孙种树书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41012,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和宋次道三馆晒书","author":"刘攽","text":"天禄图书一岁开，五云迟日近蓬莱。\n后生得见灵兰策，贵客都倾内外台。\n不似羽陵残蠹简，正如金谷聚英材。\n论诗老去无情思，况是阳春未易陪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41013,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送张器判官","author":"刘攽","text":"平吴旧族仕中朝，汤乐徐冯已寂寥。\n吾子白头趋幕府，同年黄绶亦云霄。\n著鞭跨马须争道，奋臂呼卢更叱枭。\n颜驷冯唐俱晚遇，不妨青紫老垂腰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41014,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和张舍人北使归","author":"刘攽","text":"饮冰重见古人心，绝幕仍当暮雪深。\n朝出穹庐随拜日，夜鸣刁斗候横参。\n胡儿射雁争娱客，羌女听笳却走林。\n闻说虏情亲博望，一言珍重万黄金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41015,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"两府新第","author":"刘攽","text":"圣世诸公起草莱，君恩东第一时开。\n排门画戟交行马，转肘沙堤接上台。\n卫国名亭缘伐叛，平津虚馆为翘材。\n犹分长史待天下，衰老讵能忘傥来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41016,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"乙巳早春再游玉仙观赠陈道士","author":"刘攽","text":"十里平郊不值人，解鞍依约记前春。\n问年已复惊身老，遇境犹能发兴新。\n泉涨池冰舒雁爪，霜团庭桧叠龙鳞。\n种桃道士长无恙，自愧刘郎病滞身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41017,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新广柏悦堂后轩作七言","author":"刘攽","text":"南荣曝日足娱客，北牖来风亦在予。\n聊以维摩开丈室，便知陶令爱吾庐。\n神龟大蔡昂头际，泽雉名翚矫翼初。\n戏问庭前双古柏，阅人无算我谁如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41018,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"立春谢赐幡胜口号呈子瞻冲元内翰子开器资舍人","author":"刘攽","text":"立春幡胜紫宸朝，正以金珰插右貂。\n便觉阳和生暖律，俱承庆泽下层霄。\n奇零雪片依楼角，容易风威转柳条。\n七十无能不归去，强将衰白向颜韶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41019,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和前韵","author":"刘攽","text":"雪寒常怯月边朝，乍起东风拂敝貂。\n银胜綵幡分节物，宿云晨雾凝璇霄。\n君为特达千金璧，我是衰迟百尺条。\n叩缶乌乌聊快耳，宁知报响得咸韶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41020,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王正仲林子中联舟西上过睢阳寄书率尔成诗为报","author":"刘攽","text":"大帆如翼画江来，鼙鼓声乾虺虺雷。\n洛水登仙惟李郭，兔园延客得邹枚。\n寄书上有加餐饭，倾盖何时数举杯。\n想到石渠寻旧境，秋花著子遍庭槐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41021,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"吕舍人北使","author":"刘攽","text":"汉德舟车万里通，赤心持节复平戎。\n空同气色连穷发，当户君臣聚引弓。\n马酒禦寒朝伴冻，貂裘冲雪昼禁风。\n清蒲固有安边画，可待甘陈傅郑功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41022,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"仲冯北使","author":"刘攽","text":"极北空同戴斗星，越疆犹有短长亭。\n汉朝正朔原无外，边地山河不见经。\n雪拥旃裘绵欲折，冰生湩酪酒初醒。\n我家四世俱持节，送尔皇华却涕零。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41023,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王仲至使北","author":"刘攽","text":"朔雪如沙万里程，幽阴戴斗正严凝。\n终军何必功横草，沈尹无烦夕饮冰。\n茗粥迩来誇湩酪，毡裘仍自愧绵缯。\n岁寒拜日穹庐外，想见东南瑞气升。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41024,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"早春郊外","author":"刘攽","text":"满城尘土无穷极，出郭风烟顿扫除。\n春浅暗泉流脉脉，日长归雁影疏疏。\n强将拙计仍谋野，等复劳生愧荷锄。\n安得面山临水地，种花移竹一茅庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41025,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠杨次公秘丞","author":"刘攽","text":"莫将阳九归时数，自为乾封致吉祥。\n必若中兴待云汉，枉教流议及桑羊。\n相望冠盖交驰传，躬作牺牲属奉常。\n肤寸崇朝看变化，吾农从此万斯箱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41026,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬潘及甫同年秘丞","author":"刘攽","text":"困学那知三代英，定交良愧十年兄。\n断鸿陈迹悲朝露，乔木孤飞念友生。\n樽酒相逢开口笑，风波远别使人惊。\n海边春色青青柳，泪落阳关最后声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41027,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"省宿","author":"刘攽","text":"开旦文书整日劳，漏传门掩谢诸曹。\n小庭待月久不下，乔木降风空自高。\n旧学荒芜多梦寐，微官补益抵分毫。\n秋来鬓发看成雪，不似潘生始二毛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41028,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和陈学士八月十六日省宿","author":"刘攽","text":"疏帘珍簟倚通中，落烬飘香堕玉虫。\n信宿依然十分月，黄昏正尔一番风。\n流萤暗逐星过水，惊鹊时翻叶堕空。\n诗兴不禁头已白，醉乡祇有面微红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41029,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和登州张使君","author":"刘攽","text":"层城表海势嵯峨，车骑雍容乐事多。\n八月潮平占候火，三更日上看涛波。\n閒留方士谈迂怪，醉听齐讴起艳歌。\n莫以高材厌留滞，功名从古喻裘蓑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41030,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和陈五祠九宫致斋","author":"刘攽","text":"帝家三正付惟清，岑寂容台最古厅。\n长日斋居空旦旦，几年华发欲星星。\n霜风洒叶都成赤，篱菊疏花杂间青。\n多少旧溪招隐兴，暂因釐事绕林坰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41031,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题所种梧楸","author":"刘攽","text":"曲槛层檐与树宜，三年初见绿阴垂。\n声随白雨凉生疾，影夺朱炎暑到迟。\n傍倚辘轳看汲井，下留閒客坐围棋。\n会须百尺参天直，白发空嗟拱把诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41032,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"还家","author":"刘攽","text":"草径茅庐不远城，归来松竹已秋声。\n鄙人倦客方招隐，弱女非男亦慰情。\n薄愿自甘随老圃，短才无用至名卿。\n闾里相见成幽熟，他日禽鱼尚不惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41033,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"城上新亭","author":"刘攽","text":"野芳乔木共回环，步到西城五里间。\n值有丛祠休足力，就为幽境慰心颜。\n鸥声远水连晴日，刹影高台似浅山。\n胜事本来容易集，可怜人自不能閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41034,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵王介甫金陵怀古四首 其一","author":"刘攽","text":"虎踞群山带绕江，为谁为国为谁降。\n高台麋鹿看无数，废沼凫鹥去自双。\n万里朝云随逝水，百年西月过虚窗。\n白门酒美东风快，笑数英雄尽一缸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41035,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵王介甫金陵怀古四首 其二","author":"刘攽","text":"楼船西下势横江，元帅旌旗就约降。\n旋报前师覆张悌，亟传单骑馘王双。\n燕焚正自当烟突，蚁溃何堪值水窗。\n回首三军欢奏凯，万牛行炙酒千缸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41036,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵王介甫金陵怀古四首 其三","author":"刘攽","text":"楚贡来迟诡问江，汉收群策士心降。\n一言已重黄金百，再见仍蒙白璧双。\n漂客脱身甘马革，老儒投笔谢书窗。\n岂知三阁酣诗酒，浩唱庭花倒玉缸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41037,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵王介甫金陵怀古四首 其四","author":"刘攽","text":"颓垣落水半平江，乔木风呼不易降。\n耕出珠玑时得一，道逢麟凤不成双。\n潮声半夜来寒渚，月色深秋照旧窗。\n唯有鱼盐城下市，樯乌想望集瓶缸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41038,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送冯当世移金陵","author":"刘攽","text":"满城携酒驻高轩，楚老沾衣共一言。\n何幸期年无吏事，方从歉岁识君恩。\n潮迎綵鹢来瓜步，山映朱旗转白门。\n早晚使星还北极，溥看霖雨济乾坤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41039,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]