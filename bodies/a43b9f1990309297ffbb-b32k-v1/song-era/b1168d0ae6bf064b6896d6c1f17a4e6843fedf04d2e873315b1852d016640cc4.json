[{"title":"倾杯乐  仙吕  席上赏雪","author":"曾觌","text":"锦帐寒添，画檐雀噪，冻云布野。\n望空际、瑶峰微吐，琼花初绽，江山如画。\n裁冰剪水装鸳瓦。\n杳旗亭路，依稀管弦台榭。\n倚小楼佳兴，一行珠帘不下。\n随缕板、歌声閒暇。\n傍翠袖云鬟、怜艳冶。\n似佯醉、不耐娇羞，浓欢旋学风雅。\n向暝色、双鸾舞罢。\n红兽暖、春生金斝。\n但殢饮，香雾捲、壶天不夜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":782,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"壶中天慢","author":"曾觌","text":"素飙漾碧，看天衢稳送、一轮明月。\n翠水瀛壶人不到，比似世间秋别。\n玉手瑶笙，一时同色，小按霓裳叠。\n天津桥上，有人偷记新阕。\n当日谁幻银桥，阿瞒儿戏，一笑成痴绝。\n肯信群仙高宴处，移下水晶宫阙。\n云海尘清，山河影满，桂冷吹香雪。\n何劳玉斧，金瓯千古无缺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":783,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浣溪沙  郑相席上赠舞者","author":"曾觌","text":"元是昭阳宫里人。\n惊鸿宛转掌中身。\n只疑飞过洞庭云。\n按彻凉州莲步紧，好花风袅一枝新。\n画堂香暖不胜春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":784,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浣溪沙","author":"曾觌","text":"绮陌寻芳惜少年。\n长楸走马著金鞭。\n玉楼春醉杏花前。\n憔悴如今谁作伴，别离还近养花天。\n碧云凝处忆婵娟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":785,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浣溪沙","author":"曾觌","text":"一扇熏风入座凉。\n轻云微雨弄晴光。\n绿团梅子未成黄。\n渐近日长愁闷处，更堪羁旅送归艎。\n乱山重叠水茫茫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":786,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浣溪沙  奉诏次韵张池州赏杏听琵琶","author":"曾觌","text":"艳杏红芳透粉肌。\n沈香亭宴太真妃。\n新晴庭馆燕来迟。\n试抹么弦妆半掩，满斟绿醑袖交飞。\n九重天上捧金卮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":787,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浣溪沙  樱桃","author":"曾觌","text":"谷雨郊园喜弄晴。\n满林璀璨缀繁星。\n筠篮新采绛珠倾。\n樊素扇边歌未发，葛洪炉内药初成。\n金盘乳酪齿流冰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":788,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浪淘沙  观潮作","author":"曾觌","text":"一线海门来。\n雪喷云开。\n昆山移玉下瑶台。\n捲地西风吹不断，直到蓬莱。\n羯鼓噪春雷。\n鼍舞蛟回。\n歌楼鼓吹夕阳催。\n今古清愁流不尽，都一樽罍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":789,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"绣带儿  客路见梅","author":"曾觌","text":"潇洒陇头春。\n取次一枝新。\n还是东风来也，犹作未归人。\n微月淡烟村。\n谩伫立、惆怅黄昏。\n暮寒香细，疏英几点，尽奈销魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":790,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"减字木兰花  席上赏宴赐牡丹之作","author":"曾觌","text":"一声杜宇。\n满地落红愁不语。\n国色春娇。\n不逐风前柳絮飘。\n珠帘休捲。\n爱惜龙香藏粉艳。\n胜友俱来。\n同醉君恩倒玉杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":791,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清平乐","author":"曾觌","text":"艳苞初拆。\n偏借东君力。\n上苑梨花风露湿。\n新染胭脂颜色。\n玉人小立帘栊。\n轻匀媚脸妆红。\n斜插一枝云鬓，看谁剩□春风。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":792,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清平乐","author":"曾觌","text":"松姿不老。\n独立蓬莱杪。\n风捲流苏香雾晓。\n又是江梅开了。\n丹青早画麒麟。\n貂蝉自属王门。\n闻道碧桃花绽，一枝枝祝千春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":793,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"眼儿媚  闺思","author":"曾觌","text":"花近清明晚风寒。\n锦幄兽香残。\n醺醺醉里，匆匆相见，重听哀弹。\n春情入指莺声碎，危柱不胜弦。\n十分得意，一场轻梦，淡月阑干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":794,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"眼儿媚","author":"曾觌","text":"重劝离觞泪相看。\n寂寞上征鞍。\n临行欲话，风流心事，万绪千端。\n春光漫漫人千里，归梦绕长安。\n不堪向晚，孤城吹角，回首关山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":795,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮","author":"曾觌","text":"云烟漠漠秋容老。\n茅檐映水人家好。\n林叶未凋疏。\n远山横有无。\n平生耕钓事。\n若个安身是。\n劝君早归来。\n碧香新瓮开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":796,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮  次韵龙深甫春日即事","author":"曾觌","text":"杏花寒食佳期近。\n一帘烟雨琴书润。\n砌下水潺潺。\n玉笙吹暮寒。\n阳台云易散。\n往事寻思懒。\n花底醉相扶。\n当时人在无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":797,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"喜迁莺  福唐平荡海寇宴犒将士席上作","author":"曾觌","text":"七闽形胜。\n镇南纪会府，山川交映。\n箫鼓喧天，绮罗盈市，不负四时风景。\n共喜太平无事，岂料潢池不逞。\n殄群丑，看一鼓雷奔，沧溟波静。\n指纵诗书帅，曾到凤池，密勿陪几政。\n暂淹筹帏，催分战舰，总出智谋先定。\n想见捷书初上，尽道臣贤主圣。\n正图旧，听重宣丹诏，归调金鼎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":798,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"朝中措  同前代御带作","author":"曾觌","text":"功名虽未压英游。\n一种旧风流。\n人世百年须到，如今七十春秋。\n当时帷幄，貂珰贵重，誉蔼朋俦。\n赢得尊前沈醉，浮华付去悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":799,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"朝中措  赵知閤生日","author":"曾觌","text":"画堂帘捲兽香浓。\n花上雪玲珑。\n平地十洲三岛，蟠桃已试春红。\n清朝旧德，仙姿难老，主眷方隆。\n烂醉笙歌丛里，年年先占春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":800,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"朝中措  山父赏牡丹，酒半作","author":"曾觌","text":"画堂栏槛占韶光。\n端不负年芳。\n依倚东风向晓，数行浓淡仙妆。\n停杯醉折，多情多恨，冶艳真香。\n只恐去为云雨，梦魂时恼襄王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":801,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"朝中措","author":"曾觌","text":"金沙架上日璁珑。\n浓绿衬轻红。\n花下两行红袖，直疑春在壶中。\n如今尚觉，惜花爱酒，依旧情浓。\n无限少年心绪，从教醉倒东风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":802,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"朝中措  维扬感怀","author":"曾觌","text":"雕车南陌碾香尘。\n一梦尚如新。\n回首旧游何在，柳烟花雾迷春。\n如今霜鬓，愁停短棹，懒傍清尊。\n二十四桥风月，寻思只有消魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":803,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"朝中措","author":"曾觌","text":"休论社燕与秋鸿。\n时节太匆匆。\n海上一番微雨，朱门浓绿阴中。\n主人情厚，金杯满泛，且共从容。\n莫问莺花俱老，今朝犹是春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":804,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"朝中措","author":"曾觌","text":"西湖南北旧游空。\n谁料一尊同。\n回首四年间事，浑如飞絮濛濛。\n林花谢了，明年春到。\n依旧芳容。\n惟有朱颜绿鬓，暗随流水常东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":805,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"朝中措  席上赠南剑翟守","author":"曾觌","text":"双溪楼上凭栏时。\n潋滟泛金卮。\n醉到闹花深处，歌声遏住云飞。\n风流太守，鸾台家世，玉鉴丰姿。\n行奉紫泥褒诏，要看击浪天池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":806,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"隔浦莲  咏白莲","author":"曾觌","text":"凉秋湖上过雨。\n作意回商素。\n暗绿翻轻盖，萧然姑射俦侣。\n妆脸宜淡伫。\n红衣妒。\n步袜淩波去。\n异香度。\n天教占断，风汀月浦烟渚。\n纤尘不到，梦绕玉壶清处。\n多少芳心待怨诉。\n无语。\n飞来一片鸥鹭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":807,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"感皇恩  重到临安","author":"曾觌","text":"依旧惜春心，花枝常好。\n只恐尊前被花笑。\n少年青鬓，耐得几番重到。\n旧欢重记省，如天杳。\n绮陌青门，斜阳芳草。\n今古销沈送人老。\n帝城春事，又是等閒来了。\n乱红随过雨，莺声悄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":808,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"满庭芳  赏牡丹","author":"曾觌","text":"冶态轻盈，香风摇荡，画栏淑景初长。\n彩霞深处，明艳夺昭阳。\n试问沈香旧事，应劝我、莫负韶光。\n多情是，低徊顾影，云幕淡微凉。\n人间，春更好，一枝斜插，犹记疏狂。\n到如今潘鬓，暗点吴霜。\n乐事直须年少，何妨拚、一饮千觞。\n醺醺醉，壶天向晚，春思正悠扬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":809,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"瑞鹤仙","author":"曾觌","text":"陡寒生翠幕。\n冻云垂，缤纷飞雪初落。\n萦风度池阁。\n袅馀妍，时趁舞腰纤弱。\n江天漠漠。\n认残梅、吹散画角。\n正貂裘乍怯，黄昏院宇，入檐飘泊。\n依约。\n银河迢递，种玉群仙，共骖鸾鹤。\n东君未觉。\n先春绽，万花萼。\n向尊前、已喜丰年呈瑞，人间何事最乐。\n拥笙歌、绣阁低帷，纵欢细酌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":810,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蓦山溪  坤宁殿得旨次韵赋照水梅花","author":"曾觌","text":"催花小雨，轻把香尘洒。\n帘捲水亭风，梅影转、夕阳初下。\n靓妆窥鉴，鸳甃湛清漪，浮暗麝，剪芳琼，消得连城价。\n玉楼十二，寒怯铢衣挂。\n曾是绿华仙，眷馀情、新词如画。\n花随人圣，须信世无双，腾凤吹，驻銮舆，堪与瑶池亚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":811,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蓦山溪  暮秋赏梨花","author":"曾觌","text":"凋红减翠，正是清秋杪。\n深院袅香风，看梨花、一枝开早。\n珑璁映面，依约认娇颦，天淡淡，月溶溶，春意知多少。\n清明池馆，芳信年年好。\n更向五侯家，把江梅、风光占了。\n休教寂寞，辜负向人心，檀板响，宝杯倾，潘鬓从他老。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":812,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"虞美人  中秋前两夜","author":"曾觌","text":"芙蓉池畔都开遍。\n又是西风晚。\n霁天碧净暝云收。\n渐看一轮冰魄、冷悬秋。\n闽山层叠迷归路。\n把酒宽愁绪。\n旧欢新恨几凄凉。\n暗想瀛洲何处、梦悠扬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":813,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鹊桥仙  同舍郎载酒见过，醉后作","author":"曾觌","text":"菊花小摘，西风斜照，帘影轻笼暝色。\n玉尊侧倒莫辞空，□满座、宾朋弁侧。\n乡邦万里，北来年少，几个如今在得。\n扶头一任且留连，叹人世、光阴半百。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":814,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鹊桥仙","author":"曾觌","text":"娇波媚靥，尊前席上，只是寻常梳裹。\n温柔伶俐总天然，没半搯、教人看破。\n从来可恁，痴迷著相，百计消除不过。\n烟花不是不曾经，放不下、唯他一个。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":815,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蝶恋花  惜春","author":"曾觌","text":"翠箔垂云香喷雾。\n年少疏狂，载酒寻芳路。\n多少惜花春意绪。\n劝人金盏歌金缕。\n桃李飘零风景暮。\n只有閒愁，不逐流年去。\n旧事而今谁共语。\n画楼空指行云处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":816,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蝶恋花  三月上巳应制","author":"曾觌","text":"御柳风柔春正暖。\n紫殿朱楼，赫奕祥光远。\n十二玉龙迎凤辇。\n香腾锦绣闻弦管。\n扇却双鸾开宝宴。\n绿绕红围，宣劝金卮满，万岁千秋流宠眷。\n此身欲备昭阳燕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":817,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"踏莎行","author":"曾觌","text":"翠幄成阴，谁家帘幕。\n绮罗香拥处、觥筹错。\n清和将近，奈春寒更薄。\n高歌看簌簌、梁尘落。\n好景良辰，人生行乐。\n金杯无奈是、苦相虐。\n残红飞尽，袅垂杨轻弱。\n来岁断不负、莺花约。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":818,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"踏莎行  和材甫听弹琵琶作","author":"曾觌","text":"凤翼双双，金泥细细。\n四弦斜抱拢纤指。\n紫檀香暖转春雷，嘈嘈切切声相继。\n弱柳腰肢，轻云情思。\n曲中多少风流事。\n红牙拍碎少年心，可怜辜负尊前意。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":819,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"醉落魄","author":"曾觌","text":"情深恨切。\n忆伊诮没些休歇。\n百般做处百厮惬。\n管是前生，曾负你冤业。\n临岐不忍匆匆别。\n两行珠泪流红颊。\n关山渐远音书绝。\n一个心肠，两处对风月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":820,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"醉蓬莱  侍宴德寿宫应制赋假山","author":"曾觌","text":"向逍遥物外，造化工夫，做成幽致。\n杳霭壶天，映满空苍翠。\n耸秀峰峦，媚春花木，对玉阶金砌。\n方丈瀛洲，非烟非雾，恍移平地。\n况值良辰，宴游时候，日永风和，暮春天气。\n金母龟台，傍碧桃阴里。\n地久天长，父尧子舜，灿绮罗佳会。\n一部仙韶，九重鸾仗，年年同醉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":821,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"燕山亭  中秋诸王席上作","author":"曾觌","text":"河汉风清，庭户夜凉，皓月澄秋时候。\n冰鉴乍开，跨海飞来，光掩满天星斗。\n四捲珠帘，渐移影、宝阶鸳甃。\n还又。\n看岁岁婵娟，向人依旧。\n朱邸高宴簪缨，正歌吹瑶台，舞翻宫袖。\n银管竞酬，棣萼相辉，风流古来谁有。\n玉笛横空，更听彻、裳霓三奏。\n难偶。\n拚醉倒、参横晓漏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":822,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"燕山亭  杨廉访生日","author":"曾觌","text":"玉立明光，才业冠伦，汉历方承休运。\n江左奏功，塞垒宣威，紫绶几垂金印。\n岁晚归来，望丹极、新清氛祲。\n忠愤。\n著挠节朋俦，便成嘉遁。\n千载云海茫茫，记举目新亭，壮怀难尽。\n蝴蝶梦惊，化鹤飞还，荣华等閒一瞬。\n七十尊前，算畴昔、都无可恨。\n休问。\n长占取、朱颜绿鬓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":823,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鹧鸪天  了堂净惠师示予寒食感怀二阕，因次其韵 其一","author":"曾觌","text":"每上春泥向晓乾。\n花间幽鸟舞姗姗。\n年华不管人将老，门外东风依旧寒。\n投簪易，息机难。\n鹿门归路不曾关。\n羡君早觉无生法，识破南柯一梦间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":824,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鹧鸪天  了堂净惠师示予寒食感怀二阕，因次其韵 其二","author":"曾觌","text":"故乡寒食醉酡颜。\n鞦韆綵索眩斓斑。\n如今头上灰三斗，赢得疏慵到处閒。\n钟已动，漏将残。\n浮生犹恨别离难。\n镬汤转作清凉地，只在人心那样看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":825,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鹧鸪天  选德殿赏灯，先宴梅堂，侍两宫，沾醉口占","author":"曾觌","text":"龙驭亲迎玉辇来。\n江梅枝上雪培堆。\n东风上苑春光到，更放金莲匝地开。\n腾凤吹，进瑶杯。\n两宫交劝正欢谐。\n父慈子孝从今数，准拟开筵一万回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":826,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鹧鸪天  奉和伯可郎中席上见赠","author":"曾觌","text":"桃李飘零春已深。\n可怜轻负惜花心。\n尊前赖有红千叠，窗外休惊绿满林。\n灯灼灼，醉沈沈。\n笙歌丛里酒频斟。\n留欢且莫匆匆去，怅望春归何处寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":827,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"乡饮酒倡和诗","author":"曾颖茂","text":"异席宾阶愧上西，喜观微俗顿风移。\n一堂酬酢古冠屦，千里循良世鼎彝。\n诗继绍兴贤守句，教明直讲太平仪。\n辽辽旷典今重举，从此愚夫可与知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":828,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"沔鄂","author":"曾慥","text":"渺渺阳台去，茫茫鹦鹉洲。\n干戈迷大别，烟雨瞑南楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":829,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"白帝城","author":"曾慥","text":"白帝城头路，逶迤一径遥。\n高堂临峡口，暴水没山腰。\n隔岸鱼施网，横江铁贯桥。\n神妃翻覆手，愿赐雨连宵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":830,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"到夔州","author":"曾慥","text":"众水归三峡，悠悠万古情。\n白盐无路到，赤甲罕人行。\n西瀼泉尤胜，东屯谷有名。\n丰年公事少，饱暖荷恩荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":831,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题苏养直词翰巨轴","author":"曾慥","text":"元祐文章绝代无，为盟主者眉山苏。\n旧闻宗匠为诗匠，今见东湖说后湖。\n寂寞香山老居士，浩荡烟波古钓徒。\n澜翻翰墨惊人眼，一段清冰在玉壶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":832,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"巫山","author":"曾慥","text":"巫山不可见，翠岫几重重。\n云外藏三岛，江头认九峰。\n淡烟迷暝色，疏雨浥秋容。\n目断凝贞路，松风传暮钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":833,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"临江仙","author":"曾慥","text":"子后寅前东向坐，冥心琢齿鸣鼍。\n托天回顾眼光摩。\n张弓仍踏弩，升降辘轳多。\n三度朝元九度转，背摩双摆扳弩。\n虎龙交际咽元和。\n浴身挑甲罢，便可蹑烟萝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":834,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浣溪沙","author":"曾慥","text":"别样清芬扑鼻来。\n秋香过后却追回。\n博山轻雾锁崔嵬。\n珍重芗林三昧手，不教一日不花开。\n暗中错认是江梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":835,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"调笑令 其一 并口号","author":"曾慥","text":"佳友。\n金英辏。\n陶令篱边常宿留。\n秋风一夜摧枯朽。\n独艳重阳时候。\n剩收芳蕊浮卮酒。\n荐酒先生眉寿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":836,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"调笑令 其三 净友莲","author":"曾慥","text":"净友。\n如妆就。\n折得清香来满手。\n一溪湛湛无尘垢。\n白羽轻摇晴昼。\n远公保社今何有。\n怅望东林搔首。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":837,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"调笑令 其四 玉友酒","author":"曾慥","text":"玉友。\n平生旧。\n相与忘形偏耐久。\n醉乡径到无何有。\n莫问区区升斗。\n人生一笑难开口。\n为报速宜相就。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":838,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"调笑令 其二 清友梅","author":"曾慥","text":"清友。\n群芳右。\n万缟纷披兹独秀。\n天寒月薄黄昏后。\n缟袂亭亭招手。\n故山千树连云岫。\n借问如今安否。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":839,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"曾慥","text":"云连三峡苍茫外，人在千峰紫翠间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":840,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"曾慥","text":"秋风三度发孤妍，扑面幽香十里传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":841,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"曾槃","text":"还持病眼将昏力，来看仙山未了青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":842,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"好事近 亳州秩满归江南别诸僚旧","author":"曾肇","text":"岁晚凤山阴，看尽楚天冰雪。\n不待牡丹时候，又使人轻别。\n如今归去老江南，扁舟载风月。\n不似画梁双燕，有重来时节。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":843,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]