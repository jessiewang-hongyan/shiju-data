[{"title":"建宁郡斋","author":"刘子寰","text":"鸣禽依约似山家，只欠园林好物华。\n城角日高春寂寂，小庭行遍拾桐花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29730,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"石井亭","author":"刘子寰","text":"一树疏桐蔽夕阳，也教客子久徬徨。\n隔溪可惜谁亭馆，闲却竹阴无限凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29731,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"当阳新店","author":"刘子寰","text":"桑坡麦垄行百里，解鞍夜宿清漳湄。\n清漳悠悠引通浦，茅庐竹屋相因依。\n米盐一鬨商估集，舍人夺席厨争炊。\n试登高阜望陶牧，平原沃野何逶迤。\n俗传范子计然地，民生卤莽今如斯。\n荆关四冲古战国，往往赤子多歼夷。\n土人客户几更变，向之昭屈馀几希。\n欲从故老问遗迹，百年而上无能知。\n地名多与载史合，荒城大冢犹依稀。\n沮漳二水楚之望，以此取證他无疑。\n古称锡穴最深阻，方城汉水为城池。\n奈何形胜不足恃，豪杰杀尽名都隳。\n自从秦汉至今日，率不百年逢乱离。\n隰皋衍沃但茅苇，时康尚欠人扶犁。\n焉得英雄守四极，封殖生齿令繁滋。\n玉州平州古砖甓，令人想见升平时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29732,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"忆篁㟳山居","author":"刘子寰","text":"客毡静拥炉煴坐，恍惚神游篁㟳山。\n岩路依依寻曲折，石泉历历记潺湲。\n药畦道者多慵灌，花蔓猕猴定恣攀。\n今夜山寒松子落，居人应合梦吾还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29733,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"晚宿张坂庵","author":"刘子寰","text":"问宿樵夫指翠微，溪穷路转扣庵扉。\n深沉山木日先晚，寂寞野棠春自归。\n客路经过殊草草，旧规牢落重依依。\n劳生暂此逢休适，一饷中林笋蕨肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29734,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题灵梵院壁","author":"刘子寰","text":"世故婴拂人，逃荒伴禅寂。\n莓苔一古寺，尘土四立壁。\n百年诸名贤，不复见陈迹。\n旧题风雨剥，废寝莎蔓积。\n夕阳乔木外，怅望惊独立。\n去去勿复言，浮生尽游客。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29735,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"灵梵院夜起","author":"刘子寰","text":"寺古居人稀，林高暑气薄。\n露鸣青松枝，夜半有惊鹊。\n飞星远长汉，白云平大壑。\n客子开西窗，心空山月落。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29736,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"九峰庵偶书","author":"刘子寰","text":"山栖白云表，高卧息烦倦。\n正夏谷风凉，长日岚阴半。\n樵人归路远，亭午各已散。\n犬静眠松檐，鸟下浴泉涧。\n杖藜随兴往，卷帙从风乱。\n远我遗世情，方能涉忧患。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29737,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偶成 其一","author":"刘子寰","text":"游从旧分唯三径，依倚新交只瘦筇。\n红叶碧花诗满眼，秋来多病苦无悰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29738,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偶成 其二","author":"刘子寰","text":"云本无心尽自闲，捲舒无碍在空山。\n终然未免形为役，也逐风波浪往还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29739,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偶成 其三","author":"刘子寰","text":"蛛丝纤巧得飞虫，鸠拙营巢子堕空。\n才与不才天分定，一身劳逸未应同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29740,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"续桃符句","author":"刘子寰","text":"腊雪冲风得快晴，闲檐日暖引经行。\n旧山忽趁林疏出，新水还从冻解生。\n村巷岁除声寂寞，花梢春到色精明。\n桃符只被诗催换，自笑衰翁未老成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29741,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"跋旧题","author":"刘子寰","text":"溪楼逆旅棣华西，窗扇烟埃暗旧题。\n久视字书差可认，初然吟玩是谁诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29742,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寿侍郎","author":"刘子寰","text":"阳萌两日寿星光，天祐生贤侍玉皇。\n上世勋庸满钟鼎，后昆风骨总侯王。\n朝回绛阙清都晓，梅发断桥流水香。\n政自调羹相门事，伫看衮绣作衣裳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29743,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寿赵守","author":"刘子寰","text":"参横斗转五更寒，春入黄堂酒盏宽。\n幕客更赛千岁颂，家人羊荐五辛盘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29744,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寿张仓","author":"刘子寰","text":"乔木端由有世臣，传家事业饱经纶。\n鹓行稍厌承明直，熊轼来颁建水春。\n暖入东君新听朔，祥开南极庆生申。\n沙堤消息人来说，紫诏催□入秉钧。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29745,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠写神陈光甫 其一","author":"刘子寰","text":"写照无因画隐微，不差毫发似君稀。\n正须著我岩石底，是殆见我神气机。\n行到逼真人却恶，精于悬鉴物难违。\n朱铅莫惜饶颜色，众目不求公是非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29746,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠写神陈光甫 其二","author":"刘子寰","text":"不论道貌与天形，才入毫端便逼真。\n幻出千般人面目，只凭一点自精神。\n云台人去丹青歇，月鉴方来事业新。\n寝陋可能当审象，且将粉泽付斯人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29747,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送刘篁㟳","author":"冯取洽","text":"来似孤云出岫闲，去如高月耿难攀。\n若为化作修修竹，长伴先生篁㟳山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29748,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自淮梱代归领累偕亲友游虎丘偶成数语以纪岁月时淳祐庚戌七月廿五日","author":"丘岳","text":"一目四苍莽，突然见林丘。\n飞来灵鹫峰，幻出蓬莱洲。\n浮图高崒嵂，石径通深幽。\n生公讲经台，曾闻石点头。\n剑池杳无底，脩绠汲寒流。\n千古诧奇传，兹事还是不。\n我来秋向深，良苗匝平畴。\n忧国愿年丰，一稔销百忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29749,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句","author":"康南翁","text":"塔何曾动谁留影，石不能言自点头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29750,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"磊石","author":"郑良臣","text":"轩辕奏乐洞庭滨，乐罢齐呼万岁声。\n留得伶伦钟一个，山僧日夜祝皇明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29751,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其一","author":"张仲节","text":"蝴蝶似知春梦熟，穿巷飞度画屏东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29752,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其二","author":"张仲节","text":"夜夜月明金苑里，如何照不到长门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29753,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其三","author":"张仲节","text":"凯歌四面动地来，斩得名王归献阙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29754,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其四","author":"张仲节","text":"一朝骠骍先论功，封侯佩印授齐钺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29755,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其五","author":"张仲节","text":"不知去年征战时，妾家良人在还没。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29756,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赋笔","author":"方武裘","text":"貌出中山骨欲仙，何人拔颖缚尖圆。\n拙夫堪笑堆成冢，豪客曾闻扫似椽。\n窗下玉蜍涵夜月，几间雪茧涌春泉。\n当时定远成何事，轻掷毛锥恐不然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29757,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"古乐府 其一","author":"程垣","text":"长安花如锦，不堪制郎衣。\n拾得并州剪，剪花花忽飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29758,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"古乐府 其二","author":"程垣","text":"清溪彩鸳鸯，野性不可驯。\n君心空爱渠，渠无爱君心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29759,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"古乐府 其三","author":"程垣","text":"莫嫌秋后扇，明年还六月。\n凄凉暂离别，恩情难断绝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29760,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"探赜 其一","author":"程垣","text":"一气自盘礴，万物自倏忽。\n盘礴运高厚，倏忽祝生没。\n高厚固冥冥，生没亦汩汩。\n愿言握金镜，以祛我之惑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29761,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"探赜 其二","author":"程垣","text":"庄周一妄诞，丘明一浮夸。\n两都绣春英，三京组朝霞。\n楚骚哀灵均，鵩赋凄长沙。\n律以素王经，春蛙与寒鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29762,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"杂兴 其一","author":"程垣","text":"抛抛机中梭，婉婉机中淑。\n兰膏媚鬓蝉，笋纤润红玉。\n织成锦绣段，光耀绮霞幅。\n世无黄钟尺，何以制华服。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29763,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"杂兴 其二","author":"程垣","text":"青青琅玕竹，节直中心虚。\n风月与相忘，雪霜不能欺。\n斸之献良工，堪葺黄金舆。\n悲哉渭水滨，空抱岁寒姿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29764,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"杂兴 其三","author":"程垣","text":"南山有孤松，夭矫苍龙质。\n亭亭耸华盖，清风自永日。\n珍重栋梁材，甘心跧崖石。\n梓匠持规矩，大器匪易得。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29765,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"樵家","author":"程垣","text":"深溪藏毒蛟，樵家冰灶口。\n结侣腰弯刀，破衲补更厚。\n持担俯清流，勇往不回首。\n褰裳望青采，岂暇寻枯朽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29766,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"樵叟","author":"程垣","text":"苍苍双鬓银，矍铄不惮勤。\n背曲行步迟，徐徐溪水滨。\n群儿喧南山，踏起南山尘。\n翁跣负薪回，换得一壶春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29767,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"樵子","author":"程垣","text":"头蓬面萎黄，身轻步忽逮。\n方斫柴薪回，又带刀斧去。\n戏笑茅根掘，时暂松根踞。\n间道后山归，人寻不知处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29768,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"樵径","author":"程垣","text":"扪萝登峻坂，不避岚霾冒。\n拔茅过山䧆，壮者为前导。\n阴湿留步迹，叶滑无人扫。\n谁言此地幽，亦有春风到。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29769,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"樵风","author":"程垣","text":"樵夫识雨候，风起装樵归。\n只顾担重轻，无心问是非。\n才观六鹢退，随知少女机。\n同行采樵人，先后不相违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29770,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夏日下闻溪渡","author":"程垣","text":"溪桥架木度人行，人影溪中步步生。\n真水真山皆旧识，时来时去几关情。\n鱼惊鸥立无闲意，鸟逐蝉飞有遁声。\n暂止笋舆生仆力，可人时至午风清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29771,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅花 其一","author":"黄祖润","text":"天籁消沈斗柄斜，绕枝忽起护巢鸦。\n素娥青女新梳洗，来斗寒梅半夜花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29772,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅花 其二","author":"黄祖润","text":"白氎禅巾白石龛，跏趺无迹越山庵。\n朝朝拱立罔明手，昨夜看梅废小参。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29773,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅花 其三","author":"黄祖润","text":"林间翠羽啄枯槎，邂逅孤筇次水涯。\n飞过小溪留数语，殷勤报有隔桥花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29774,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其一","author":"黄祖润","text":"何须更辨伤春谤，岁岁飘零不及春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29775,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其二","author":"黄祖润","text":"效颦可丑张元妹，竞爽宜为束皙兄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29776,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宣公祠 其一","author":"林逢子","text":"仁义百篇唐孟子，排奸劲节凛秋霜。\n人生一死固不免，死落忠州骨也香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29777,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宣公祠 其二","author":"林逢子","text":"千年往事随流水，一缕香烟吊蜀魂。\n门掩落花人不到，野风邀月照黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29778,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送胡季昭窜象郡","author":"翁定","text":"应诏书闻便远行，庐陵不独诧邦衡。\n寸心祇恐孤天地，百口何期累弟兄。\n世态浮云多变换，公朝初日盍清明。\n危言在国为元气，君子从来岂顾名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29779,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"贺带湖六十三","author":"翁定","text":"风吹仙梦落江南，忽忽今年六十三。\n嗜酒引壶倾腊蚁，挥毫落纸食春蚕。\n行观仙籍香浮桂，荣看恩袍色斗蓝。\n他日投簪松径下，摩挲铜狄对清谈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29780,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春","author":"翁定","text":"睡起庭前立片时，寂无人到乱云飞。\n杨花吹尽莺声懒，小雨廉纤春已归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29781,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"知县","author":"翁定","text":"来时人指拙为谋，出手方知刃解牛。\n有病黄堂怀药问，丐归紫橐列衔留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29782,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"垂虹桥","author":"翁定","text":"虹桥影倒中边月，蟾镜光浮上下磨。\n未易丹青知画少，苦难题品费诗多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29783,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"舟航","author":"翁定","text":"晚风乘兴出溪边，小立斜阳待钓船。\n唤仆去寻赊酒店，倩人来认买鱼钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29784,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其一","author":"翁定","text":"雍容陪大政，密勿赞洪钧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29785,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其二","author":"翁定","text":"在朝但觉民瞻耸，参政从知国势高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29786,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其三","author":"翁定","text":"有少园池仅蔬竹，无多屋宇欠楼台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29787,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其四","author":"翁定","text":"唤仆过林寺，逢僧问石桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29788,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其五","author":"翁定","text":"雨馀便涉岭，风定稳行船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29789,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"杜鹃花 其一","author":"赵戣","text":"春山未有杜鹃啼，花发杜鹃知不知。\n寄语催归尽哀怨，莫将啼血污仙姿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29790,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"杜鹃花 其二","author":"赵戣","text":"冰肌玉骨擅无双，不与山花斗艳妆。\n欲染啼红冤杜宇，争如傅粉伴何郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29791,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"北窗伊吾 其一","author":"赵戣","text":"伊吾维吾，椎鲁株愚。\n友资其深，片雪洪垆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29792,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"北窗伊吾 其二","author":"赵戣","text":"伊吾维吾，瓮牖绳枢。\n爰升其华，秋月冰壶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29793,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"北窗伊吾 其三","author":"赵戣","text":"伊吾维吾，缉柳编蒲。\n爰席其珍，尺璧珊瑚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29794,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"北窗伊吾 其四","author":"赵戣","text":"伊吾维吾，朝饘暮糊。\n爰餔其■，醴酪醍醐。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29795,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"北窗伊吾 其五","author":"赵戣","text":"伊吾维吾，何以为娱。\n爰心其声，钟磬笙竽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29796,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"北窗伊吾 其六","author":"赵戣","text":"北窗伊吾，吾谁与俱。\n融融沂风，怀哉舞雩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29797,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"阅浯溪集用山谷韵","author":"赵戣","text":"花间小阁临清溪，绿窗坐阅三吾碑。\n恍如登高俯绝壑，倚杖松阴挽兔丝。\n幽寻胜赏客思奇，一声欸乃谁家儿。\n浯溪映带湘东西，碧山曾看漫郎栖。\n银钩玉箸苔藓古，神剜天画非人为。\n忆昔储皇披舆图，白衣山人称帝师。\n汾营老将智勇俱，阴霾四塞天戈挥。\n至今老石励庸懦，野水亦解扶颠危。\n后来吊古者为谁，涪翁清响车攻诗。\n当时寡和孤白雪，我故欲尾春风辞。\n恨不插羽西南飞，山前更著小艇随。\n夜阑忽梦访遗址，月色惨淡猿声悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29798,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雨中见花","author":"赵戣","text":"细雨敛轻尘，枝间态度新。\n春疑天雨宝，寒怯地铺裀。\n叶底含羞女，阑边倚醉人。\n休将脂粉涴，一一是天真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29799,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"咏史二十二首 其一 唐尧","author":"赵戣","text":"圣德光天下，岁功成闰馀。\n百篇推帝典，一半是农书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29800,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"咏史二十二首 其二 虞舜","author":"赵戣","text":"遁迹陶渔久，论功纳麓多。\n已传精一语，更作敕天歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29801,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"咏史二十二首 其三 夏禹","author":"赵戣","text":"地已还三壤，彝方次九畴。\n基图天与子，典则我贻谋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29802,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"咏史二十二首 其四 商汤","author":"赵戣","text":"罪己桑林六，仁心祝网三。\n只应宽代虐，何事德怀惭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29803,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]