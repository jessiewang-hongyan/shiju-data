[{"title":"建德道间","author":"赵蕃","text":"妇并蚕筐候蚕浴，儿眠牛背趁牛行。\n要知比屋俱无事，看取人家尽乐生。\n麦畦就熟黄云委，秧垄初齐绿浪生。\n快活收声闻布谷，可怜鸟语近人情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49006,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"录去冬舟行诗一编呈陈丞并作四十字致见而不款之恨","author":"赵蕃","text":"旧诵流传句，今逢訾謷丞。\n不除湖海气，何急簿书仍。\n秃麈期相对，归车顾已乘。\n井眢诚漫汲，城壮敢轻登。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49007,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"念欲春游春既莫矣而在伯微恙不近杯勺作小诗代简便呈沅陵何邓二尉曹","author":"赵蕃","text":"屡有一杯约，况今三月来。\n属君翻药裹，而我欠诗材。\n楚塞稀红蕊，僧坊剩绿苔。\n几时能出郭，分韵与徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49008,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"招谢丈签判出郊","author":"赵蕃","text":"桃李竞芳春，晨妆故斩新。\n周遭遍晴野，络绎动游人。\n闭户端无事，命车当及辰。\n澄流带修竹，足以奉清真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49009,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"放舟始作","author":"赵蕃","text":"扁舟落吾手，远役怆余心。\n道路经过数，秋风日夜深。\n青林向摇落，白发益侵寻。\n况说潇湘去，仍怀屈贾吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49010,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"明日雨不止风加甚","author":"赵蕃","text":"大雨晓未止，疾风朝更颠。\n茅飞疏我屋，禾偃病民田。\n未可专时戾，多繇得地偏。\n虽然岂无念，衣薄尚无绵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49011,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"明日复出城","author":"赵蕃","text":"夜雨更连明，篮舆偶出城。\n田畴蓑笠事，江海鹭鸥盟。\n少小规微禄，侵寻愧老生。\n茝兰春渚满，桃李绿阴成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49012,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"明叔今日不过书斋","author":"赵蕃","text":"竹屋深深昼亦阴，病多无复短长吟。\n三年肯住见君意，一日不来关我心。\n蝉噪未知秋日晚，雀投如识故枝深。\n残书乱帙慷能整，倚赖残樽尚可斟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49013,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杭桥道间二首 其二","author":"赵蕃","text":"安稳侵晨发，杭桥薄暮休。\n山穷多石峙，渡涉乱川流。\n野性安猿马，归心逐鹭鸥。\n时平从路险，吾在岂人谋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49014,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杭桥道间二首 其一","author":"赵蕃","text":"屡起瞻云物，频成听雨声。\n与忧明所历，咸谓晓当晴。\n一水通高下，千山杂晦明。\n逢人问前路，为报已堪行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49015,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"松湖和曾文清公韵","author":"赵蕃","text":"有水可为湖，栽松欲以呼。\n不贪鱼鳖数，无取芰荷都。\n老杜论能拟，陶翁兴不孤。\n风吟与雪钓，曾有画图无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49016,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"枕上 其一","author":"赵蕃","text":"鼠上书檠暗，巢惊瓮牖明。\n不眠知夜久，欲起怕寒生。\n城与江山近，秋添鼓角清。\n经营才五字，展转欲残更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49017,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"枕上 其二","author":"赵蕃","text":"风雨杂荒更，晨鸡不暇鸣。\n客程难去住，秋感易凄清。\n强说骚为仆，那知钱是兄。\n长贫自吾事，未用悔平生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49018,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秉文以田事入村归而寄之二首 其二","author":"赵蕃","text":"屡雨不濡土，凉风兹已秋。\n不知今岁事，定获几分收。\n日籴每怀虑，岁馀当逭忧。\n题诗才纸尾，又起望云头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49019,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秉文以田事入村归而寄之二首 其一","author":"赵蕃","text":"村村穫稻急，得得跨驴行。\n别野片时役，好诗无数成。\n羸躯难并出，病眼待渠明。\n落日斜犹挂，凉风晚更生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49020,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秉文同成父问屋普圆过予而归","author":"赵蕃","text":"朝响疏疏不晻光，暮檐浏浏亦无长。\n胡然可救焦枯厄，政尔能成湔祓方。\n堆案文书小盘礴，并溪草树一徜徉。\n君方问隐我思去，异日相望何有乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49021,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"经旬不作诗示明叔","author":"赵蕃","text":"春风著物已熙熙，枯木无心亦自知。\n径欲殷勤辞故絮，却怜窘束欠新诗。\n老来政怯花经眼，游倦翻成鸟绕枝。\n同病同忧有如子，更堪相对两霜髭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49022,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"觅应氏庵","author":"赵蕃","text":"祇知嫌湫隘，何意落崎岖。\n问路因居者，褰裳愧仆夫。\n恸曾怜阮籍，泣岂效杨朱。\n不费幽寻胜，宁思捷径趋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49023,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"郊居书事","author":"赵蕃","text":"物意因人喜，人情与物和。\n家家缲茧火，处处插秧歌。\n麦熟黄疑委，桑馀路尚多。\n我居虽偪仄，度日亦婆娑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49024,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"郊居秋晚五首 其五","author":"赵蕃","text":"霜雨飞何密，穷秋易作悲。\n长身竹孤瘦，短发草黄萎。\n渐迩风霜迫，谁无裘褐思。\n向惟逃夏日，今已念朝曦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49025,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"郊居秋晚五首 其四","author":"赵蕃","text":"松柏有正性，风霜无横侵。\n南方异摇落，众木共青森。\n曲士应怀悦，我曹尝感心。\n诗成谁和者，弦绝未忘琴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49026,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"郊居秋晚五首 其三","author":"赵蕃","text":"庭菊种匪晚，秋风开尔迟。\n人嗟地力薄，我有岁寒期。\n兰芷元同类，蒿莱敢肆欺。\n怀哉非失所，社老谩衔悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49027,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"郊居秋晚五首 其二","author":"赵蕃","text":"祇道秋萧索，木犀能再开。\n惊看倚修竹，便恐满苍苔。\n花瘦非畴昔，香深有自来。\n微吟真浪尔，细折为谁哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49028,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"郊居秋晚五首 其一","author":"赵蕃","text":"旧岁旱为虐，今年雨以时。\n如闻诸郡国，可脱半寒饥。\n我自无田者，空成乐岁诗。\n谁官太史氏，直笔要无遗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49029,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨入丈七坳","author":"赵蕃","text":"信是长安远，休疑蜀道难。\n千崖悬尽斗，万石列皆攒。\n举足无非仄，扪心每为寒。\n不堪天更雨，政欲助吾官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49030,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨中与公择对饮已而大醉既醒作此","author":"赵蕃","text":"身世一飘摇，羁愁两寂寥。\n怨歌空耿耿，晚雨况萧萧。\n饮强真能醉，诗成或当谣。\n明朝对清镜，鬓恐十分凋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49031,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨中不出呈斯远兼示成父四首 其四","author":"赵蕃","text":"兄发久已白，弟颜那得红。\n从今喜朝夕，不复恨西东。\n耕稼真吾事，诗书是祖风。\n扶犁有馀暇，把卷不妨同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49032,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨中不出呈斯远兼示成父四首 其三","author":"赵蕃","text":"湖外频年客，江东迩日归。\n欲知年事迫，看取鬓毛非。\n寄意虽梅柳，关心在蕨薇。\n令余倒芒屦，须子叩柴扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49033,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨中不出呈斯远兼示成父四首 其二","author":"赵蕃","text":"岁事今无几，来归略未安。\n若为佳抱发，赖有好诗看。\n剩欲江村访，却遭天气寒。\n雪犹思剡曲，雨亦过苏端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49034,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨中不出呈斯远兼示成父四首 其一","author":"赵蕃","text":"燠甚宜为雨，晴来又复阴。\n霜风吹不变，雪霰已相侵。\n寒且依炉密，泥防著屐深。\n未能从子去，何暇复梅寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49035,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨中四首 其四","author":"赵蕃","text":"稍稍风头变，侵侵雨脚来。\n峰峦忽成暗，云雾亦旋开。\n谩易炎凉候，无矜狡狯才。\n天高独鸟度，林合乱蝉哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49036,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨中四首 其三","author":"赵蕃","text":"浏浏檐雨暮，萧萧窗竹秋。\n蚊雷宵罢响，萤火暗停流。\n政尔具絺绤，又当营褐裘。\n桑麻岂无地，卒岁负悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49037,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨中四首 其二","author":"赵蕃","text":"古屋先知雨，空林易得风。\n阶除滋绿草，门巷拥丹枫。\n衣褐从兹迫，稻粱安得丰。\n病来方止酒，愁绝若为攻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49038,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨中四首 其一","author":"赵蕃","text":"积此檐间雨，骤兹山下溪。\n真成乱昏昼，何止碍轮蹄。\n云变看苍狗，泥深听竹鸡。\n不能同愦愦，政尔合栖栖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49039,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨中有怀","author":"赵蕃","text":"春风吹雨暗连朝，闻道溪南欲断桥。\n忍使碧桃抛密蕊，更堪高柳折轻条。\n成都旧日空存壁，陋巷归来只挂瓢。\n想见诸公方痛饮，坐看云脚度山腰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49040,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨中怀竹隐","author":"赵蕃","text":"还因今夜雨，忆著故山凉。\n野水循除急，脩筠出屋长。\n萤光侵蕙帐，鼠迹乱书囊。\n岂不念归去，怀哉方绝粮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49041,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨中简章令","author":"赵蕃","text":"夜雨仍朝雨，知时复后时。\n禾囷愆黍稌，麦地及耘耔。\n屡起瞻行旆，频成阅赠诗。\n渠方谨期会，君自念疲羸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49042,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨中遣兴呈远斋父子孙丈昆仲","author":"赵蕃","text":"睡思昏然昼掩门，觉来山雨已翻盆。\n黄梅应熟骚人念，绿野可耕田父言。\n林外竹鸡时自语，阶前花鸭故相喧。\n诗材满眼费驱使，此事合输刘与孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49043,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨后","author":"赵蕃","text":"前朝呼蜥蜴，今雨跳虾蟆。\n听罢僧钟击，停闻庙鼓挝。\n长饥逭游子，乐岁慰田家。\n未得江东信，频看天外鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49044,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨后呈斯远","author":"赵蕃","text":"已是霜凝更雨温，春其渐起但无痕。\n莫嗟草色有垂死，定自梅花当返魂。\n小驻要须穷日日，细寻无惜遍村村。\n揩摩病目从兹始，并待君诗洗睡昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49045,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨阴未解成长句","author":"赵蕃","text":"一日舒晴十日阴，春来时节更萧森。\n徐行索句茅檐静，孤坐焚香书屋深。\n少日饥寒真累己，莫年勋业已无心。\n先贤遗传时披读，颇怪山王在竹林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49046,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨馀","author":"赵蕃","text":"雨馀还返照，墙面亦高林。\n独坐残书卷，支颐谷鸟吟。\n百年今半过，三径岂遐心。\n日莫重萧瑟，悲歌不自任。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49047,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨作","author":"赵蕃","text":"晚泊鱼虾聚，蚤行葭苇丛。\n纷纷腥落日，袅袅乱长空。\n风既滞游子，雨仍愁社公。\n真成才欲尽，有句不能工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49048,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨夜怀明叔并忆成父","author":"赵蕃","text":"放竹近轩窗，地方中对床。\n非贪起居适，乐是话言长。\n已解萧骚味，仍忧摆撼伤。\n去君才数驿，忆弟更他乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49049,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨望偶题","author":"赵蕃","text":"漠漠青山雨，霏霏白鹭烟。\n诗材来远近，画本极中边。\n流落虽天外，登临赖目前。\n浮生才几日，此地欲三年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49050,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨脚","author":"赵蕃","text":"雨脚才能驻，风头倏又高。\n未成曾点服，犹衣仲由袍。\n斗食尘埃愧，束书灯火劳。\n丁丁几樵斧，汎汎一渔舠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49051,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"顷与公择读东坡雪后北台二诗叹其韵险无窘步尝约追和以见诗之难穷去岁适无雪春正月二十日乃雪因遂用前韵呈公择 其一","author":"赵蕃","text":"相思不是冬无雪，留待春风斗冷严。\n病骨未忧衣乏絮，早餐宁叹食无盐。\n梅添凿落元同色，竹拥参差半入檐。\n坐守地炉应不厌，破窗平见北山尖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49052,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"顷与公择读东坡雪后北台二诗叹其韵险无窘步尝约追和以见诗之难穷去岁适无雪春正月二十日乃雪因遂用前韵呈公择 其二","author":"赵蕃","text":"雪埋老屋无薪卖，晨起谋炊自毁车。\n觅饱预期千顷麦，破悭先试一春花。\n便营野屐寻茶户，更约绨袍当酒家。\n处士祇今宜姓贾，壁间但没挂钱叉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49053,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与世美奉诏旨分督决狱甲戌判袂之武阳壬午还宿中兴寺而得世美自延平所寄诗因次韵","author":"韦骧","text":"盛暑宵忧动邃旒，敕催诸道决累囚。\n承流宣泽弥兢惕，履险航湍敢滞留。\n南北分驰才数夕，重轻释繫已三州。\n高材想尽哀矜意，美疢当从勿药瘳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49054,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"俗有社日不饮酒变为猪之说作诗示儿曹","author":"赵蕃","text":"雨势来相续，阴霾郁不舒。\n举觞随楚俗，酌醴从枯鱼。\n宰肉非吾事，祈田顾岁储。\n龙猪自有分，社饮不关渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49055,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"俗有雪上加霜之谚今日之谓也二诗呈知县契丈教授尊兄 其二","author":"赵蕃","text":"雨雪欣能霁，冰霜苦未和。\n体孱寒有相，絮败暖无多。\n二妙今谁敌，有诗皆可歌。\n暗中知沈谢，灰里拨阴何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49056,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"俗有雪上加霜之谚今日之谓也二诗呈知县契丈教授尊兄 其一","author":"赵蕃","text":"叹我贫兼病，当渠雪上霜。\n忍饥无异术，炙背有奇方。\n重忆茅檐下，还嗟楚水傍。\n官曹竟疏阔，诗病得商量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49057,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"信题","author":"赵蕃","text":"假日成愒日，朝酲还暮酲。\n馀寒犹未去，破褐尚留情。\n野树梅花落，空庭春草生。\n得闲聊信笔，不复强为名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49058,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"叙浦簿吕公用沅陵韵见贻次韵","author":"赵蕃","text":"一经蚤已愧家传，三尺犹思绝并缘。\n位下故知难及物，业荒空复度流年。\n要求庙令作归计，未必上公能记怜。\n多谢为僚不相弃，连朝枉赠有诗篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49059,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"复次韵呈沅陵诸丈并怀在伯二首 其二","author":"赵蕃","text":"佳诗如隽永，馀论敢雌黄。\n幸甚官同府，怀哉居择乡。\n江湖身固远，风月兴何长。\n勿作湘累吊，行赓殿阁凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49060,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"复次韵呈沅陵诸丈并怀在伯二首 其一","author":"赵蕃","text":"逸兴犹鸥白，残驱异犊黄。\n青衫漫蛮府，黄帽合鲈乡。\n既自老将至，何由心甚长。\n倘能藏斗酒，未暇博西凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49061,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"客中遇雪不胜家山之思催晦庵写诗及书","author":"赵蕃","text":"旅枕骤疑风彻屋，晓窗还见雪填渠。\n梅花未放腊前蕊，雁足浑无别后书。\n故意谁其哀范叔，倦游身自困相如。\n赠言故愈绨袍赐，载路何须驷马车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49062,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"客长沙邢园堂下梅花一萼先开有怀成父斯远二首 其二","author":"赵蕃","text":"亦到溪南否，还能念我不。\n梅花今次第，客子政飘浮。\n师法真难得，微官盍罢休。\n饥寒还累我，寤寐只关忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49063,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"客长沙邢园堂下梅花一萼先开有怀成父斯远二首 其一","author":"赵蕃","text":"老树发青枝，晴多雨亦奇。\n一花成独破，病眼得先窥。\n又作殊方见，还成寄远诗。\n不知闽与浙，何处念乖离。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49064,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"将至信州二首 其二","author":"赵蕃","text":"溪日照人明，溪风著鬓清。\n一生长是客，半日讵留程。\n绿水浮梁贴，青林古塔擎。\n虽然异乡国，聊尔寄归情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49065,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"将至信州二首 其一","author":"赵蕃","text":"长年遇百艰，十步九逢滩。\n龙湫平渊蓄，灵山列岫寒。\n庖厨朝饭薄，絺绤晚衣单。\n独抱高深意，知音谁为弹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49066,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"将至豫章","author":"赵蕃","text":"棹落归云底，帆飞夕照间。\n起予为白社，极目是西山。\n芦雪新须鬓，枫丹昔面颜。\n炊迟饿已惯，酒贵醉能悭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49067,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"将宿天心寺以失路遂止野人家","author":"赵蕃","text":"一出有百阻，吾生何太艰。\n问途迷野寺，积淖落前山。\n势以鸡晨待，聊安虎落间。\n浊醪无路觅，破衲与渠关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49068,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"峡江舟中怀徐审知","author":"赵蕃","text":"峡江江上晓乘风，人语鸡声宿雾中。\n自入江西此差胜，有如吾子乃无同。\n未怜终岁数行役，可料此生长困穷。\n独是嗜诗馀习在，耸肩搔发愿求工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49069,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"待成父不至","author":"赵蕃","text":"晚日下前村，呼儿候荜门。\n屡惊邻犬吠，频问路人言。\n准拟翻诗卷，经营置酒尊。\n此怀无与共，愁坐虱空扪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49070,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"斫病竹","author":"赵蕃","text":"采掘宁悭供，护持期有成。\n时今阅春夏，尔独意枯荣。\n琐碎日无影，萧骚风罢声。\n樵苏勿怀辱，而我岂无情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49071,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"施进之见过二首 其二","author":"赵蕃","text":"鹭影投山背，蝉声满树头。\n千峰雪未释，四野雨初周。\n甚矣厌馀暑，欣然当早秋。\n半年才此见，一夕可辞留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49072,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]