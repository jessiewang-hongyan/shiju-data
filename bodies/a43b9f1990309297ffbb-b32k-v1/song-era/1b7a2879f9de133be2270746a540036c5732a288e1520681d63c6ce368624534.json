[{"title":"偈颂五十一首 其三十八","author":"释道冲","text":"释迦出世拿空塞空，达磨西来将错就错。\n带累后代儿孙，一例随处卜度。\n休卜度，四海浪平，百川潮落。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20734,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五十一首 其三十七","author":"释道冲","text":"龙床一绕定纲宗，四海从兹信息通。\n但见皇风成一片，不知何处是疆封。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20735,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五十一首 其三十六","author":"释道冲","text":"秘魔擎杈，赵州吃茶。\n禾山打鼓，归宗斩蛇。\n惯钓鲸鲵沉巨浸，却嗟蛙步?泥沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20736,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五十一首 其三十五","author":"释道冲","text":"群阴剥尽，一阳来复。\n万汇咸亨承化育，拄杖机轮转辘辘。\n转天关，回地轴。\n百亿分身遍刹尘，应时纳祐从人欲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20737,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五十一首 其三十四","author":"释道冲","text":"圆觉伽蓝，尘尘有路。\n坐断去来，顿空今古。\n那里十三，这边十五，后先不差毫发许。\n可笑黄面瞿昙，至今不知落处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20738,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五十一首 其三十三","author":"释道冲","text":"正法眼，破沙盆。\n贵时倾国不换，贱时不直分文。\n不作贵，不作贱。\n分付石溪老子，共结佛祖深冤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20739,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五十一首 其三十二","author":"释道冲","text":"面皮擘破，喝散钟山之云。\n拄杖横挑，穷尽天台之境。\n玲珑岩下忽相逢，一笑令人发深省。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20740,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五十一首 其三十一","author":"释道冲","text":"从上佛祖无法与人传，后代儿孙会得是障碍。\n碍不碍，竹山铁鹞刺天飞，笑倒明州憨布袋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20741,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五十一首 其三十","author":"释道冲","text":"一径直，二周遮。\n辽天射飞鹗，平地摝鱼虾。\n堪笑秘魔岩不会，见人一味只擎叉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20742,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五十一首 其二十九","author":"释道冲","text":"心随万境转，转处实能幽。\n汉地不收秦不管，不风流处也风流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20743,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五十一首 其二十八","author":"释道冲","text":"有一物，名不得，状不得，取不得，舍不得。\n突出天童拄杖头，倒用横拈无轨则。\n戳瞎达磨鬼眼睛，靠倒临济白拈贼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20744,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五十一首 其二十七","author":"释道冲","text":"坐断十方国土，天上天下独尊底，一步也行不得。\n口吞三世诸佛，世出世间俱透底，一句也说不得。\n堪与衲僧为轨则。\n普化何似一头驴，临济未是白拈贼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20745,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五十一首 其二十五","author":"释道冲","text":"天童用底，来育王用不著。\n育王用底，归天童用不著。\n用不著处用有馀，一箭双雕随手落。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20746,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五十一首 其二十四","author":"释道冲","text":"德山棒如雨点，一棒棒痛彻骨髓。\n临济喝似雷奔，一喝喝轰破髑髅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20747,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五十一首 其二十三","author":"释道冲","text":"衲僧家，不著佛求，不著法求。\n然虽如是，在佗烟焰里，争敢不低头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20748,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五十一首 其二十二","author":"释道冲","text":"佛高一丈，魔高一丈。\n月落寒潭，云生碧嶂。\n不识慈氏如来，唤作布袋和尚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20749,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五十一首 其二十一","author":"释道冲","text":"高抛不至天，低掷不到地，南北东西无处避。\n带累雪峰老人，唤作南山鳖鼻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20750,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五十一首 其十九","author":"释道冲","text":"我与释迦老子，有不共戴天之雠。\n今日为什么烧香礼拜，不是冤家不聚头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20751,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五十一首 其十八","author":"释道冲","text":"是著即错，不是犹乖，一击万重关锁开。\n老卢不会转身句，便道明镜亦非台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20752,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五十一首 其十七","author":"释道冲","text":"枯木龙吟，一切音响俱绝。\n髑髅眼活，一切色相皆空。\n觑著即瞎，听著即聋。\n堪笑观音大士，无端也證圆通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20753,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五十一首 其十六","author":"释道冲","text":"方丈屋损，寝处不得。\n常住乏粮，著众不得。\n旧逋积如海，无钱还不得。\n大道在目前，有口说不得。\n若人透此四重关，堪与诸方为轨则。\n赵州亲见老南泉，观音院里有弥勒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20754,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五十一首 其十四","author":"释道冲","text":"振法雷，击法鼓，布慈云兮洒甘露。\n只将此法为全提，世世愿为诸佛母。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20755,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五十一首 其十一","author":"释道冲","text":"坐断毗卢顶，踏翻千差路。\n须弥灯王，无插足处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20756,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五十一首 其九","author":"释道冲","text":"古释迦不先，今弥勒不后。\n礼拜烧香一线通，从教笑破衲僧口。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20757,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五十一首 其八","author":"释道冲","text":"要入此门，初无方便。\n须是诸人，脚尖具眼。\n苟或未然，客情步步随人转。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20758,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五十一首 其七","author":"释道冲","text":"一不得向，二不得背。\n丝毫及不尽，古镜生瑕颣。\n拈起铁蒺藜，一时俱击碎。\n从教大地黑漫漫，它家自有通人会。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20759,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五十一首 其六","author":"释道冲","text":"凡所有相，皆是虚妄。\n怀州牛吃禾，益州马腹胀。\n若见诸相非相，即见如来。\n一切难舍，无过己财。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20760,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五十一首 其五","author":"释道冲","text":"今日中秋节，拄杖为人切。\n拨开千嶂云，放出一轮月。\n光未生时荐得亲，依然眼里重添屑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20761,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五十一首 其四","author":"释道冲","text":"十字街头，有条活路。\n没量大人，不知落处。\n无落处，拟欲追踪，西天此土。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20762,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五十一首 其二","author":"释道冲","text":"孰名为佛，礼者是谁。\n设或未辨端倪，看四棱塌地。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20763,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"曹源和尚赞 其二","author":"释道冲","text":"父曹源，祖密庵。\n碧落碑，无赝本。\n破沙盆，正法眼。\n清庙瑟有遗音，坐者立者，以心印心。\n不肖之子，作如是赞。\n非特旌于往古，亦乃诏于来今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20764,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"曹源和尚赞 其一","author":"释道冲","text":"遭密庵骂，恨入骨髓。\n此恨难忘，充塞天地。\n四海五湖无处避，能有几人著它底。\n著它底，冤冤相报无穷已。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20765,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"临终偈","author":"释道冲","text":"末后一句，无可商量。\n只要个人，直下承当。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20766,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五十一首 其二十六","author":"释道冲","text":"摩竭掩室，净名杜口。\n天网恢恢，疏而不漏。\n是汝诸人，作么生透。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20767,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五十一首 其十五","author":"释道冲","text":"须弥可裂，海水可竭。\n若论此事，宁可截舌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20768,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五十一首 其十","author":"释道冲","text":"摩竭提国，亲行此令。\n尽大地人，丧身失命。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20769,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五十一首 其一","author":"释道冲","text":"我此一门，全无肯路。\n是汝诸人，如何进步。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20770,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"面桶","author":"释道冲","text":"做时不费工夫，用处全无渗漏。\n任是鼻孔辽天，未免低头相就。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20771,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题永明智觉寿禅师顶相","author":"释道和","text":"慧日峰高秋色冷，钱塘江静月华明。\n寒光一烁周沙界，笔下看来未十成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20772,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈三首 其三","author":"释道和","text":"欲渡巨海，必假方舟。\n橹棹俱全，风帆两便。\n夜观星月，昼视云山。\n万里之遥，一瞬可到。\n人心尽畏波涛险，未必被涛险似心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20773,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈三首 其一","author":"释道和","text":"一二三，四五六，碧眼胡僧数不足。\n泥牛入海过新罗，木马追风到天竺。\n天竺茫茫何处寻，补陀岩上问观音。\n普贤拍手呵呵笑，归去来兮秋水深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20774,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈三首 其二","author":"释道和","text":"观身实相，观佛亦然。\n这里见得，黄面瞿昙。\n隐身无地，其或渺漫。\n不分照顾，眉毛鼻孔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20775,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂二首 其二","author":"释道行","text":"我不会兮不如你，堪笑千花生碓觜。\n善财谩说百城游，何曾踏着自家底。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20776,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂二首 其一","author":"释道行","text":"我不会兮不如你，达磨当门缺两齿。\n满堂无限白蘋风，明明不自秋江起。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20777,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十七首 其十三","author":"释道行","text":"棒下血淋淋，真鍮不博金。\n鸳鸯亲绣出，休更觅金针。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20778,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十七首 其十一","author":"释道行","text":"新年佛法晢真风，笑杀街头贺岁翁。\n三级浪高何处去，谩将双剑定雌雄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20779,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十七首 其八","author":"释道行","text":"苍龙带雨离深洞，彩凤衔花入帝关。\n一句古今无渗漏，祖师不在东西山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20780,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十七首 其六","author":"释道行","text":"赵州放下著，碓觜忽生花。\n虽然无一事，验尽当行家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20781,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十七首 其五","author":"释道行","text":"不立孤危机本峻，赵州老子玉无瑕。\n当头指出殿里底，刬尽茫茫眼里花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20782,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三首 其三","author":"释道行","text":"白云山出复山没，寒涧日西还日东。\n长老不归予又去，唯留萝月与松风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20783,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三首 其二","author":"释道行","text":"不于三界现身意，谁谓维摩谈不二。\n山空昼永鸟无声，春光不在千花里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20784,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三首 其一","author":"释道行","text":"紫罗抹额绣腰裙，倾国风流宛胜秦。\n玉笛插藏人不见，夜深吹起凤楼春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20785,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五首 其一","author":"释道行","text":"西天屠子气雄豪，欺负神洲罪莫逃。\n武帝当头轻一拶，果然提起活人刀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20786,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈一首","author":"释道行","text":"溪声广长舌，山色清净身。\n八万四千偈，明明举似人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20787,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠禅者","author":"释道行","text":"句下出诸碍，翻身古剑寒。\n欲明如上事，须是髑髅乾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20788,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十七首 其十七","author":"释道行","text":"江南江北勿同伦，疑了还疑笑杀人。\n谁信一盘油煠底，古今塞断是非门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20789,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十七首 其十六","author":"释道行","text":"堂堂白日上刀梯，任是昆崙眼亦迷。\n多谢门前案山子，春来秋去泄天机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20790,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十七首 其十二","author":"释道行","text":"古人一莫，切忌啖啄。\n临济权寄库，德山顿萧索。\n截断佛祖机关，显出顶门一著。\n子细审思量，分明欠一著。\n且道欠那一著？","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20791,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十七首 其十","author":"释道行","text":"因我得礼你，昆崙卧潭底。\n虽然浪拍天，身上无滴水。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20792,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十七首 其九","author":"释道行","text":"天生白额南山虎，牙爪曾当八面风。\n月落三更穿市过，痴人投晓觅行踪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20793,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十七首 其七","author":"释道行","text":"土埋处处铁菱角，半夜经由未觉难。\n于晓岭根伤中倒，方知行过铁门关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20794,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十七首 其四","author":"释道行","text":"赵州庭前柏树子，昆崙眼睛如点漆。\n笑他法眼谤先师，觉公心苦口如蜜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20795,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十七首 其三","author":"释道行","text":"用尽自己心，笑破他人口。\n八角磨盘空里走，金毛师子变作狗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20796,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十七首 其二","author":"释道行","text":"落叶归根，铁牛当路。\n来时无口，索盐得醋。\n金槌不动落群机，列圣丛中第六祖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20797,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十七首 其一","author":"释道行","text":"枯树云充叶，凋梅雪作花。\n击桐成木响，蘸雪吃冬瓜。\n长天秋水，孤鹜落霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20798,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五首 其二","author":"释道行","text":"生死自怜同室穴，因何中路关山。\n一朝忽得亲儿证，趯踏方知盖覆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20799,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五首 其四","author":"释道行","text":"金不博金，水上洗水。\n二祖脑后露腮，达磨当门无齿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20800,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五首 其三","author":"释道行","text":"一语离窼窟，千生出盖缠。\n夜来风雪恶，木折古岩前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20801,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五首 其二","author":"释道行","text":"不是风幡动，天生李老君。\n出胎头上发，寸寸白如银。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20802,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈十首 其八","author":"释道行","text":"从上宗门事，直是少时辈。\n兔子不吃窼边草，象王走入野狐队。\n若是少林禅，达磨自不会。\n为甚如此，苦瓠苦连根，甜菰甜彻蒂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20803,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈十首 其七","author":"释道行","text":"门前石塔子，八白与九紫。\n方道既分明，免被巡官使。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20804,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈十首 其六","author":"释道行","text":"狗子佛性无，韶石不相辜。\n为君重决破，秋至雁衔芦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20805,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈十首 其五","author":"释道行","text":"一不成，二不是。\n三不定，四不可。\n拗折弓箭，踏翻射垛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20806,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈十首 其四","author":"释道行","text":"金乌急，玉兔速，天上星兮地下要。\n衲僧要透祖师关，劝君拈却面前大案山，自然会得五祖把火入牛栏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20807,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈十首 其三","author":"释道行","text":"正宗法眼，历古昭彰。\n大因因缘，此时成现。\n迅机掣电处密密绵绵，绵绵密密中迅机掣电。\n更问如之若何，我面何殊佛面。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20808,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈十首 其一","author":"释道行","text":"动则万丈悬崖，不动则当处沈埋。\n千重万重关锁，一锤当面击开。\n伎死禅和无数，依前似鸭闻雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20809,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]