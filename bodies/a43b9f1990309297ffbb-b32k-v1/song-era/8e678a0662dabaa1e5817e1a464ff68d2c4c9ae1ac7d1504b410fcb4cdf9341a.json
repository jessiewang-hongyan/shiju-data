[{"title":"偈颂六十七首 其三十一","author":"释原妙","text":"昔年瞎却我眼，今朝穿却你鼻。\n冤冤相报无休，莫若克己复礼。\n非惟和尚同尘，免得递相钝置。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17407,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十七首 其四十五","author":"释原妙","text":"三千世界作炉，百亿须弥为炭。\n生铁铸就禅和，炙得通身红烂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17408,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十七首 其五十九","author":"释原妙","text":"今年龙象颇多，权作三堂结夏。\n虽然名字不同，是法本无高下。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17409,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示徒三戒 其一","author":"释原妙","text":"开口动舌，无益于人，戒之莫言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17410,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示徒三戒 其三","author":"释原妙","text":"举足动步，无益于人，戒之莫行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17411,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示徒三戒 其二","author":"释原妙","text":"举心动念，无益于人，戒之莫起。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17412,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"释圆","text":"新缝纸被烘来暖，一觉安眠到五更。\n闻得上方钟鼓动，又添一日在浮生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17413,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二首 其二","author":"释圆日","text":"倒腹倾肠几个知，更无丝发可相依。\n直饶彻底承当去，也落他家第二机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17414,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二首 其一","author":"释圆日","text":"悟无不无，得无不得，九年面壁空劳力。\n三脚驴儿跳上天，泥牛入海无踪迹。\n为甚么如此，九九八十一。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17415,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"方海丰诗境楼分赋得春风","author":"释圆悟","text":"暖袭游人陌上尘，不知花信几番新。\n莫教吹到荼蘼处，吹到荼蘼是晚春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17416,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送壁上人归承天寺","author":"释圆悟","text":"城寺思归兴忽生，又携筇杖出云扃。\n月明后夜空山里，绕屋泉声只自听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17417,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿友人白云庵三首 其三","author":"释圆悟","text":"城里秋犹热，山中寒已浓。\n紫檀时小炷，危坐听晨钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17418,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿友人白云庵三首 其二","author":"释圆悟","text":"万籁夜俱寂，蒲团清可禅。\n林疏窗过月，岩远竹通泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17419,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿友人白云庵三首 其一","author":"释圆悟","text":"不到岁时久，重来人事疏。\n扫云僧亦去，谁伴主翁居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17420,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题宝山寺二首 其二","author":"释圆悟","text":"去腊应差暖，今春定有寒。\n涧梅花半树，侵晓又凋残。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17421,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题宝山寺二首 其一","author":"释圆悟","text":"寓此曾三夏，重来隔五年。\n溪山亦良是，怀想转凄然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17422,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大帽山","author":"释圆悟","text":"众山皆弭伏，独让此峰尊。\n绝顶时犹雨，中林昼亦昏。\n逆风松势偃，触石水声喧。\n定有幽栖者，何因得晤言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17423,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"小立","author":"释圆悟","text":"小立当清晓，一筇吟影孤。\n兰香和雾湿，竹老带藤枯。\n野水流将合，春山淡欲无。\n雨晴犹未卜，劳尔鹁鸠呼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17424,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山中四首 其四","author":"释圆悟","text":"暝色敛平川，云归日已夕。\n閒行信杖藜，倦坐憩苔石。\n花亦满意红，草自无心碧。\n吾亦乐吾年，人生不满百。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17425,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山中四首 其三","author":"释圆悟","text":"雅怀无所拘，偶行度前岗。\n长松发佳色，澄潭閟幽光。\n而我亦何幸，于此得相羊。\n低头心语口，兹游那可忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17426,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山中四首 其二","author":"释圆悟","text":"疏林过微雨，西岭收残晖。\n草露湿我屦，松风吹我衣。\n坐久四山暝，吟馀独鸟飞。\n归来不知晚，萝月盈窗扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17427,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山中四首 其一","author":"释圆悟","text":"飞瀑挂高崖，幽禽响虚谷。\n怜此一片景，借得数椽屋。\n涧木卧槎牙，岩花散芳馥。\n策杖从所之，偶到南山麓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17428,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山中夜归","author":"释圆悟","text":"一鹤候柴关，林空境自閒。\n竹房秋后冻，病叟夜深还。\n树密疑无路，月明犹在山。\n幽居便所适，已是十年閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17429,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次姜秦祠和胡教授韵","author":"释圆悟","text":"晓谒崇祠雾霭深，行藏因识二贤心。\n榻前自有孤忠疏，林下谁赓招隐吟。\n寂寂精庐苍藓入，堂堂遗像暗尘侵。\n客中莫致生刍奠，聊汲山泉荐菊斟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17430,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和黄瑞玉山庵","author":"释圆悟","text":"偶寻孤隐处，幽僻远腥荤。\n结屋聊依石，栽松却傍坟。\n山深长雾雨，海近渺风云。\n不必称昏聩，自然疏见闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17431,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"承天寺寻勤上人","author":"释圆悟","text":"古寺多陈迹，幽花祇自开。\n净无秋后暑，远绝市中埃。\n苔色侵碑石，松阴蔽月台。\n山人迟未至，欲去重徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17432,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赵山神祠","author":"释圆悟","text":"山中虽隐迹，名被世人知。\n无策欲干主，有诗还立祠。\n水云通别渚，枳槲荫空墀。\n多少能吟者，焚香为拂碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17433,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重游清源洞","author":"释圆悟","text":"此地今重到，藤萝长碧阴。\n缅思仙去后，长有客来吟。\n出鸟江涛白，连云岭树深。\n杖藜宜少驻，灵迹尚堪寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17434,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"真人洞","author":"释圆悟","text":"扪葛敲幽户，空山得遍观。\n云离朝拜石，苔积上升坛。\n秋晚涧声涩，月明松影寒。\n真人不可遇，谁复此烧丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17435,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄方俊甫","author":"释圆悟","text":"市桥劳送别，转影又经时。\n几度月圆夜，独行谁共时。\n菊寒开欲遍，书远到应迟。\n西瀑成庵未，幽楼莫负期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17436,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晚渡","author":"释圆悟","text":"桥巷低临水，数家深掩门。\n路穷生寂寞，人渡更黄昏。\n风色占帆席，潮痕认柳根。\n岸回林影暝，渔火满沙村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17437,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游静真观","author":"释圆悟","text":"古观门幽寂，来游亦夙缘。\n林堪巢老鹤，坛可礼真仙。\n秋晚寒生屋，雨深苔印砖。\n旧藏多御赐，应识尚留传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17438,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"瑞兴寺","author":"释圆悟","text":"路僻今芜翳，寒厨尚起烟。\n僧依三佛住，门与数峰连。\n雨润苔封塔，年深竹覆泉。\n创时灵异事，犹有断碑传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17439,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题泉州张许祠","author":"释圆悟","text":"泉与睢阳隔，事闻犹涕零。\n人虽死忠义，祠自活英灵。\n坏砌寒云聚，空庭古柏青。\n功名见信史，何必更碑铭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17440,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题秦君亭","author":"释圆悟","text":"昔只为吟隐，偶然依佛居。\n路逢阴壑尽，云抱晓岩虚。\n亭在因人重，山深与世疏。\n倘怀名利念，到此欲何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17441,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和胡教授山庵见访归韵","author":"释圆悟","text":"因赴山中约，归途带暝痕。\n禽声沉众树，人影背孤村。\n雾起寒城里，江流古岸根。\n行吟多得句，知欲与谁论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17442,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"海云阁","author":"释圆悟","text":"天风来海门，惊浪作飞雨。\n岸云过已尽，陇树青可数。\n挂帆鸥鸟外，清吟正凝伫。\n欲去犹未能，渔灯粲烟渚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17443,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游清源洞","author":"释圆悟","text":"清旦寻幽洞，攀跻有同游。\n雾雨藏诸峰，万窍响飕飕。\n树杪飞磴悬，岩外见客舟。\n藓藤垂翠琰，风叶随清流。\n百丈崖班驳，千尺木耸修。\n乌啼旸谷晓，云淡海城秋。\n莓苔蚀丹灶，山房花竹幽。\n疏烟生墟落，远水浮汀洲。\n朝斗空坛在，升仙往事悠。\n倚阑吟未就，归屐少迟留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17444,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"释圆悟","text":"独怜万木凋零后，屹立风霜惨澹中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17445,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送义青偈","author":"释圆鉴","text":"须弥立太虚，日月辅而转。\n群峰渐倚他，白云方改变。\n少林风起丛，曹溪洞帘卷。\n金凤宿龙巢，宸苔岂车碾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17446,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"释悟","text":"一切声，是佛声，檐前雨滴响泠泠。\n一切色，是佛色，觌面相呈讳不得。\n便恁么，若为明，碧天云外月华清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17447,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浴佛","author":"释悟本","text":"今日当年佛降生，当年今日不多争。\n若言八十还归灭，有眼分明特地盲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17448,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"遣僧通嗣书","author":"释悟本","text":"射杀南山老大虫，行人从此路头通。\n年来猎犬浑无用，卧对千峰与万峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17449,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"释悟本","text":"乾闼婆王曾奏乐，山河大地皆作舞。\n争如跛脚老云门，解道腊月二十五。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17450,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂","author":"释晓纯","text":"轩昂师子首，牛足马身材。\n三道如能入，玄门叠叠开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17451,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"释晓纯","text":"有个汉自从旷大劫，无住亦无依。\n上无片瓦盖头，下无寸土立足。\n朝到西天，暮归东土。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17452,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答僧慧文 其二","author":"释晓荣","text":"一念周沙界，日用万般通。\n湛然常寂灭，常展自家风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17453,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答僧慧文 其一","author":"释晓荣","text":"般若大神珠，分形万亿躯。\n尘尘彰妙体，刹刹尽毗卢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17454,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南昌道中","author":"释晓瑩","text":"东游心渺渺，趼足步迟迟。\n马驿黄茅路，人家白竹篱。\n归云横断岭，落日映荒陂。\n何地可容足，长哦招隐诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17455,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"释晓莹","text":"放怀便所便。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17456,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"释晓莹","text":"平生只信缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17457,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"释晓莹","text":"支筇聊小立。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17458,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"释晓莹","text":"陶泛一船东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17459,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"释晓莹","text":"如公自是鉴坡具。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17460,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"释晓莹","text":"隆寒正北风，飘飘任此身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17461,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"释晓莹","text":"寒窗安著清相向。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17462,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示众偈","author":"释晓聪","text":"天晴盖却屋，乘乾刈却禾。\n早输王税了，鼓腹唱巴歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17463,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"法身颂","author":"释晓聪","text":"参禅学道莫茫茫，问透法身北斗藏。\n余今老倒尪羸甚，见人无力得商量。\n唯有钁头知我意，栽松时复上金刚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17464,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"释晓聪","text":"大地雪漫漫，春风依旧寒。\n说禅说道易，成佛成祖难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17465,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"释晓聪","text":"晨鸡报晓灵，粥后便天明。\n灯笼犹瞌睡，露柱却惺惺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17466,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"释海印","text":"道本无为，法非延促。\n一念万年，千古在目。\n月白风恬，山青水绿。\n法法现前，头头具足。\n祖意教意，非直非曲。\n要识庐陵米价，会取山前麦熟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17467,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄冲退处士章察","author":"释真一子","text":"未遂山中吟，时闻世上音。\n笑言失真诠，尘秽浊神襟。\n归植南园芝，驰他北溟金。\n千日勤耕耘，自然生瑶琳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17468,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送人之南岳","author":"释真净","text":"境幽南岳寺，路向碧岩分。\n远近松相接，高低钟共闻。\n灵禽时奏乐，香石日笼云。\n想到经行处，超然趣不群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17469,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送张签判游开先","author":"释真净","text":"步入青松里，迢迢一径通。\n渐分华藏界，深隐法王宫。\n道与神仙别，人非世俗同。\n欲知西祖意，庭柏老春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17470,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"留题绍公寂照轩","author":"释真净","text":"幽轩名寂照，四海坐中閒。\n景物有迁色，主人无异颜。\n野泉澄槛外，香蔼起檐间。\n凉夜谁相问，寥寥月满山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17471,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄无为居士","author":"释真净","text":"世俗事无尽，养高心自閒。\n蔬园通绿野，林坞带青山。\n丹灶忘添火，云庵懒著关。\n别应修省术，七十见朱颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17472,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂尘尘三昧","author":"释真慈","text":"钵里饭，桶里水，别宝昆崙坐潭底。\n一尘尘上走须弥，明眼波斯笑弹指。\n笑弹指，珊瑚枝上清风起。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17473,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"听讲圆觉经有省作颂","author":"释真慈","text":"一颗明珠，在我这里。\n拨著动著，放光动地。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17474,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂","author":"释真慈","text":"拨尘见佛，佛亦是尘。\n问了答了，直下翻身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17475,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书光化军寺壁","author":"释秘演","text":"万家云树水边州，千里秋风一锡游。\n晚渡无人过疏雨，乱峰寒翠入西楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17476,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山中","author":"释秘演","text":"结茅邻水石，澹寂益闲吟。\n久雨寒蝉少，空山落叶深。\n危楼乘月上，远寺听钟寻。\n昨得江僧信，期来此息心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17477,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"洛阳春","author":"释秘演","text":"雨霁园林宿霭微，暖风迟日荐芳菲。\n池蒲露剑惊鱼跃，帘额翻波碍鸟飞。\n好景正繁春未半，小桃初放蝶仍稀。\n闲中两两高阳辈，醉泥东君夜不归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17478,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贾希德","author":"释秘演","text":"山东持木铎，高识世难群。\n览照惊秋鬓，看碑见旧文。\n救时曾抗牍，退迹欲眠云。\n帐外横经者，清朝已立勋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17479,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄四明教主","author":"释秘演","text":"古疏传深旨，清流照瘦颜。\n四方来问道，半世不离山。\n养鹤怜终洁，看云许共闲。\n仍闻焚幻质，几欲别人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17480,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"淮上","author":"释秘演","text":"危桥当古寺，闲倚喜同僧。\n极浦霁秋雨，扁舟明夜灯。\n风沈人语远，潮涨月华升。\n万事空凝念，其如总未能。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17481,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游古观","author":"释秘演","text":"参差宫殿倚青天，一别重来四十年。\n老桧挂巢时有鹤，乱云藏洞久无仙。\n春移草色抽新带，雨养苔痕压旧钱。\n两两相逢皆不合，落花流水石炉烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17482,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈四首 其一","author":"释继昌","text":"五陵公子争誇富，百衲高僧不厌贫。\n近来世俗多颠倒，只重衣衫不重人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17483,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]