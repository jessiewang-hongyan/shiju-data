[{"title":"清平乐 三白图","author":"周密","text":"静香真色。\n花与人争白。\n属玉双飞烟月夕。\n点波一奁秋碧。\n翠罗袖薄天寒。\n笛声何处关山。\n手捻一枝春色，东风怨入江南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25709,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清平乐 其二 再次前韵","author":"周密","text":"晚莺娇咽。\n庭户溶溶月。\n一树湘桃飞茜雪。\n红豆相思渐结。\n看看芳草平沙。\n游鞯犹未归家。\n自是萧郎飘荡，错教人恨杨花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25710,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清平乐 横玉亭秋倚","author":"周密","text":"诗情画意。\n只在阑干外。\n雨露天低生爽气。\n一片吴山越水。\n宫烟醉柳春晴。\n海风洗月秋明。\n唤取九霞飞佩，夜凉跨鹤吹笙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25711,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清平乐 其二 杜陵春游图","author":"周密","text":"锦城春晓。\n苑陌芳菲早。\n可是杜陵人未老。\n日日酒迷花恼。\n归鞯困倚芳酲。\n醒来还有新吟。\n人与杏花俱醉，春风一路闻莺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25712,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清平乐 其一","author":"周密","text":"小桥萦绿。\n密翠藏吟屋。\n千顷风烟森万玉。\n依约辋川韦曲。\n临流照影何人。\n悠然倚仗看云。\n柳色翠迷山色，泉声清和蝉声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25713,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"眼儿媚","author":"周密","text":"飞丝半湿惹归云。\n愁里又闻莺。\n淡月秋千，落花庭院，几度黄昏。\n十年一梦扬州路，空有少年心。\n不分不晓，恹恹默默，一段伤春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25714,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绿盖舞风轻 白莲赋","author":"周密","text":"玉立照新妆，翠盖亭亭，凌波步秋绮。\n真色生香，明珰摇淡月，舞袖斜倚。\n耿耿芳心，奈千缕、情丝萦系。\n恨开迟、不嫁东风，颦怨娇蕊。\n花底谩卜幽期，素手采珠房，粉艳初退。\n雨湿铅腮，碧云深、暗聚软绡清泪。\n访藕寻莲，楚江远、相思谁寄。\n棹歌回，衣露满身花气。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25715,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮","author":"周密","text":"霜风渐入龙香被。\n夜寒微涩宫壶水。\n滴滴是愁声。\n声声滴到明。\n梦魂随雁去。\n飞到颦眉处。\n雁已过西楼。\n又还和梦愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25716,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谒金门 次西麓韵","author":"周密","text":"芳事晚。\n数点杏钿香浅。\n恻恻轻寒风剪剪。\n锦屏春梦远。\n稚柳拖烟娇软。\n花影暗藏深院。\n初试轻衫并画扇。\n牡丹红未展。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25717,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谒金门","author":"周密","text":"花不定。\n燕尾剪开红影。\n几点露香蜂赶趁。\n日迟帘幕静。\n试把翠蛾轻晕。\n愁满宝台鸾镜。\n屈指一春将次尽。\n归期犹未稳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25718,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"朝中措 东山棋墅","author":"周密","text":"桐阴薇影小阑干。\n昼永琐窗闲。\n当日清谭赌墅，风流犹记东山。\n犀奁象局，惊回槐梦，飞雹生寒。\n自有仙机活著，未应袖手旁观。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25719,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"效颦十解 朝中措 其八 茉莉拟梦窗","author":"周密","text":"彩绳朱乘驾涛云。\n亲见许飞琼。\n多定梅魂才返，香瘢半掐秋痕。\n枕函钗缕，熏篝芳焙，儿女心情。\n尚有第三花在，不妨留待凉生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25720,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"疏影 梅影","author":"周密","text":"冰条木叶。\n又横斜照水，一花初发。\n素壁秋屏，招得芳魂，彷佛玉容明灭。\n疏疏满地珊湖冷，全误却、扑花幽蝶。\n甚美人、忽到窗前，镜里好春难折。\n闲想孤山旧事，浸清漪、倒映千树残雪。\n暗里东风，可惯无情，搅碎一帘香月。\n轻妆谁写崔徽面，认隐约、烟绡重叠。\n记梦回，纸帐残灯，瘦倚数枝清绝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25721,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"楚宫春/楚宫春慢 为洛花度无射宫","author":"周密","text":"香迎晓白。\n看烟佩霞绡，弄妆金谷。\n倦倚画阑，无语情深娇足。\n云拥瑶房翠暖，绣帐卷、东风倾国。\n半捻愁红，念旧游、凝伫兰翘，瑞鸾低舞庭绿。\n犹想沈香亭北。\n人醉里，芳笔曾题新曲。\n自剪露痕，移取春归华屋。\n丝障银屏静掩，悄未许、莺窥蝶宿。\n绛蜡良宵，酒半阑、重绕鸳机，醉靥争妍红玉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25722,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"满江红 寄剡中自醉兄","author":"周密","text":"秋水涓涓，情渺渺、美人何许。\n还记得、东堂松桂，对床风雨。\n流水桃花西塞隐，茂林修竹山阴路。\n二十年、历历旧经行，空怀古。\n评砚品，临书谱。\n笺画史，修茶具。\n喜一愚天禀，一闲天赋。\n百战徵求千里马，十年饾饤三都赋。\n问何如、石鼎约弥明，同联句。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25723,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"满庭芳 赋湘梅","author":"周密","text":"玉沁唇脂，香迷眼缬，肉红初映仙裳。\n湘皋春冷，谁剪茜云香。\n疑是潘妃乍起，霞侵脸、微印宫妆。\n还疑是，寿阳凝醉，无语倚含章。\n绛绡，清泪冷，东风寄远，愁损红娘。\n笑李凡桃俗，蝶喜蜂忙。\n莫把杏花轻比，怕杏花、不敢承当。\n飘零处，还随流水，应去误刘郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25724,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"献仙音/法曲献仙音 吊雪香亭梅","author":"周密","text":"松雪飘寒，岭云吹冻，红破数椒春浅。\n衬舞台荒，浣妆池冷，凄凉市朝轻换。\n叹花与人凋谢，依依岁华晚。\n共凄黯。\n问东风、几番吹梦，应惯识当年，翠屏金辇。\n一片古今愁，但废绿、平烟空远。\n无语消魂，对斜阳、衰草泪满。\n又西泠残笛，低送数声春怨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25725,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"瑞鹤仙","author":"周密","text":"翠屏围昼锦。\n正柳织烟绡，花易春镜。\n层阑几回凭。\n看六桥莺晓，两堤鸥暝。\n晴岚隐隐。\n映金碧、楼台远近。\n谩曾夸、万幅丹青，画笔画应难尽。\n那更。\n波涵月彩，露裛莲妆，水描梅影。\n调朱弄粉，凭谁写，四时景。\n问玉奁西子，山眉波盼，多少浓施浅晕。\n算何如、付与吟翁，缓评细品。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25726,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"解语花","author":"周密","text":"晴丝罥蝶，暖蜜酣蜂，重檐卷春寂寂。\n雨萼烟梢，压阑干、花雨染衣红湿。\n金鞍误约，空极目、天涯草色。\n阆苑玉箫人去后，惟有莺知得。\n馀寒犹掩翠户，梁燕乍归，芳信未端的。\n浅薄东风，莫因循、轻把杏钿狼藉。\n尘侵锦瑟。\n残日绿窗春梦窄。\n睡起折花无意绪，斜倚秋千立。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25727,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"瑶花慢","author":"周密","text":"朱钿宝玦。\n天上飞琼，比人间春别。\n江南江北，曾未见，谩拟梨云梅雪。\n淮山春晚，问谁识、芳心高洁。\n消几番、花落花开，老了玉关豪杰。\n金壶剪送琼枝，看一骑红尘，香度瑶阙。\n韶华正好，应自喜、初识长安蜂蝶。\n杜郎老矣，想旧事、花须能说。\n记少年，一梦扬州，二十四桥明月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25728,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"酹江月 中秋对月","author":"周密","text":"奁霏净洗，唤素娥睡起，平分秋色。\n雁背风高孀兔冷，露脚侵衣香湿。\n银浦流云，珠房迎晓，鬓影霜争白。\n玉尊良夜，与谁同醉瑶席。\n忍记倚桂分题，簪花筹酒，处处成陈迹。\n十二楼空环佩杳，惟有孤云知得。\n如此江山，依然风月，月底人非昔。\n知间何许，泪痕空沁愁碧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25729,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"徵招 九日登高","author":"周密","text":"江蓠摇落江枫冷，霜空雁程初到。\n万景正悲凉，奈曲终人杳。\n登临嗟老矣，问今古、清愁多少。\n一梦东园，十年心事，恍然惊觉。\n肠断，紫霞深，知音远、寂寂怨琴凄调。\n短发已无多，怕西风吹帽。\n黄花空自好。\n问谁识、对花怀抱。\n楚山远，九辩难招，更晚烟残照。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25730,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"踏莎行 题中仙词卷","author":"周密","text":"结客千金，醉春双玉。\n旧游宫柳藏仙屋。\n白头吟老茂陵西，清平梦远沈香北。\n玉笛天津，锦囊昌谷。\n春红转眼成秋绿。\n重翻花外侍儿歌，休听酒边供奉曲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25731,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"踏莎行 与莫两山谭邗城旧事","author":"周密","text":"远草情钟，孤花韵胜。\n一楼耸翠生秋暝。\n十年二十四桥春，转头明月箫声冷。\n赋药才高，题琼语俊。\n蒸香压酒芙蓉顶。\n景留人去怕思量，桂窗风露秋眠醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25732,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉落魄 洪仲鲁之江西，书以为别","author":"周密","text":"寒侵径叶。\n雁风击碎珊瑚屑。\n砚凉闲试霜晴帖。\n颂菊骚兰，秋事正奇绝。\n故人又作江西别。\n书楼虚度中秋节。\n碧阑倚遍愁谁说。\n愁是新愁，月是旧时月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25733,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"效颦十解 醉落魄 其七 拟参晦","author":"周密","text":"忆忆忆忆。\n宫罗褶褶消金色。\n吹花有尽情无极。\n泪滴空帘，香润柳枝湿。\n春愁浩荡湘波窄。\n红阑梦绕江南北。\n燕莺都是东风客。\n移尽庭阴，风老杏花白。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25734,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉落魄/一斛珠 醉落魄 其九 拟二隐","author":"周密","text":"馀寒正怯。\n金钗影卸东风揭。\n舞衣丝损愁千褶。\n一缕杨丝，犹是去年折。\n临窗拥髻愁难说。\n花庭一寸燕支雪。\n春花似旧心情别。\n待摘玫瑰，飞下粉黄蝶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25735,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"糖多令/唐多令","author":"周密","text":"丝雨织莺梭。\n浮钱点细荷。\n燕风轻、庭宇正清和。\n苔面唾茸堆绣径，春去也、奈春何。\n宫柳老青娥。\n题红隔翠波。\n扇鸾孤、尘暗合欢罗。\n门外绿阴深似海，应未比、旧愁多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25736,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"霓裳中序第一 次筼房韵","author":"周密","text":"湘屏展翠叠。\n恨入宫沟流怨叶。\n釭冷金花暗结。\n又雁影带霜，蛩音凄月。\n珠宽腕雪。\n叹锦笺、芳字盈箧。\n人何在，玉箫旧约，忍对素娥说。\n愁切。\n夜砧幽咽。\n任帐底、沈烟渐灭。\n红兰谁采赠别。\n洛汜分绡，汉浦遗玦。\n舞鸾光半缺。\n最怕听、离弦乍阕。\n凭阑久，一庭香露，桂影弄栖蝶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25737,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 清明","author":"周密","text":"燕子时时度翠帘。\n柳寒犹未褪香绵。\n落花门巷家家雨，新火楼台处处烟。\n情默默，恨恹恹。\n东风吹动画秋千。\n拆桐开尽莺声老，无奈春何只醉眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25738,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天","author":"周密","text":"相傍清明晴便悭。\n闭门空自惜花残。\n海棠半坼难禁雨，燕子初归不耐寒。\n金鸭冷，锦鹓闲。\n银缸空照小屏山。\n翠罗袖薄东风峭，独倚西楼第几阑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25739,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"露华 次张云韵","author":"周密","text":"暖消蕙雪，渐水纹漾锦，云淡波溶。\n岸香弄蕊，新枝轻袅条风。\n次第燕归将近，爱柳眉、桃靥烟浓。\n鸳径小，芳屏聚蝶，翠渚飘鸿。\n六桥旧情如梦，记扇底宫眉，花下游骢。\n选歌试舞，连宵恋醉珍丛。\n怕里早莺啼醒，问杏钿、谁点愁红。\n心事悄，春娇又入翠峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25740,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"淳祐七年丁未十一月朔蔡久轩自江东提刑归抵家时三馆诸公以风霜随气节河汉下文章分韵赋诗送别得气字","author":"周梅叟","text":"九峰洪范篇，雅是书之纬。\n顷尝一读之，懵然云雾蔚。\n晚校中秘藏，讲此愧犹未。\n喜逢尚书郎，家传得之既。\n何以名内篇，一扣倘知味。\n无几即语离，匆匆怪何谓。\n天子仁圣心，闻过未常讳。\n岂嫌有直疏，斥彼恶之汇。\n矧兹龙卷前，正欠王与魏。\n得见丹凤鸣，士党意乃慰。\n黯也不居中，物论几鼎沸。\n虽然上所命，所重在民事。\n暨淑问皋陶，持平尔廷尉。\n突使江东人，德泽尽沾溉。\n惟公有古心，所守至弘毅。\n我不畏孔壬，污吏必我畏。\n所愿敷好生，物物皆吐气。\n回思揽味甘，诏书登七贵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25741,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再宿次前韵","author":"周焘","text":"重来端复解征鞍，清夜溪风六月寒。\n欲写经行二年事，平林须入画图看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25742,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诗一首","author":"周焘","text":"东山蜡屐坏车轮，小草青知山外春。\n园柳鸣禽唤幽梦，惠连诗句更何人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25743,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游天竺观激水","author":"周焘","text":"拳石耆婆色两青，竹龙驱水转山鸣。\n夜深不见跳珠碎，疑是檐间滴雨声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25744,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题罗汉院小阁","author":"周焘","text":"匹马招提晚憩鞍，前村箫鼓饯馀寒。\n谁知小阁栏干曲，却得梅花正面看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25745,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和吴拭暑雪轩","author":"周焘","text":"崇台穷石照，气味乐偷闲。\n南陆朱明驭，西阑白雪山。\n茶瓯回舌本，麈尾落谈间。\n欲缀风烟句，弥高不可攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25746,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"合江亭 其一","author":"周焘","text":"共思赤脚踏层冰，聊适江皋兴自清。\n昨夜雨云驱浊暑，晓来烟水快新晴。\n山疑九叠张云势，滩激千岩落布声。\n巾履从来在丘壑，愿陪闲日此间行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25747,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书事","author":"周绪","text":"北客乐驰驱，髀肉浑不生。\n轻风入马蹄，一瞬万里平。\n朝发长安都，暮抵受降城。\n阴山闻鬼哭，征人昼夜行。\n黄尘虽染衣，紫翠堪夺睛。\n男儿平生游，壮志多屡惊。\n荆楚岂不佳，舟楫非吾情。\n休誇鱼稻乡，莫恋烟波清。\n幸能脱毛锥，侧听匣中鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25748,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水帘泉","author":"周绪","text":"群峰峨峨冲北极，一水如帘泻层碧。\n岳神自古不许捲，留在眼前蒙怪石。\n綵霞倒影朝为缘，缺月遥挂当幽夕。\n非惟只助小山景，却入民田作膏泽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25749,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蓦山溪","author":"周铢","text":"松陵江上，极目烟波缈。\n天际接沧溟，到如今、东流未了。\n吴樯越橹，都是利名人，空扰扰，知多少，只见朱颜老。\n故园应是，绿遍池塘草。\n家住十洲西，算随分、生涯自好。\n渔蓑清贵，休羡谢三郎，红蕖月，白蘋风，何似长安道。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25750,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偈颂一百二十三首 其三十六","author":"释祖钦","text":"是亦刬，非亦刬。\n令下无私，棒头有眼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25751,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"下渚秋暮","author":"周弼","text":"浅滩近渚沙相接，水落渔人朝暮涉。\n摵摵风鸣若雨来，绕堤吹散乾荷叶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25752,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"大洲湖","author":"周弼","text":"人居泽国胜居陵，十月陂塘未结冰。\n残苇乱茭收拾后，断筐分晒折腰菱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25753,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"女坟湖","author":"周弼","text":"石龟无语对东风，海鹤曾迷晓市中。\n三十六鳞朝夜月，玉钗人在水晶宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25754,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山崦早梅","author":"李龏","text":"晴逼寒笆春满邻，汉奁芳额渐轻匀。\n东风未放全消息，雨萼愁香不见人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25755,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"风恶偶成二首 其二","author":"周弼","text":"三日要行还止住，冷沙寒水暗消春。\n一千四百芜湖路，怨雨愁风多少人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25756,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"风恶偶成二首 其一","author":"周弼","text":"柔橹双随下水船，乱帆轻舵递相先。\n无端系著山村岸，高枕芦芽对雨眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25757,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"出关偶题","author":"周弼","text":"一曲长歌浙水寒，绨袍空往又空还。\n咸阳若有山东志，莫放苏秦又出关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25758,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"四圣观","author":"周弼","text":"小园宽占一山孤，别有墙遮古观居。\n到了恩波拦不住，水窗游出放生鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25759,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"龙井道中杂纪 其一","author":"周弼","text":"白发宫人频笑谑，罗衣昔对君王著。\n夜惊春雨洗桃花，梦魂犹挂鞦韆索。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25760,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"龙井道中杂纪 其二","author":"周弼","text":"老僧病久声嘶喝，屡说紫衣胜短褐。\n莫嫌两手渐拘挛，曾把御前供奉钹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25761,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"回山僧书就题书尾","author":"周弼","text":"忆昔同行题落叶，寺前枯树鹤巢边。\n不知今度苔枝上，多少秋虫已化蝉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25762,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"延山渡","author":"周弼","text":"解帆登岸作山游，林木茅茨共一丘。\n数日骤寒消不尽，尚馀残雪护松瘤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25763,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"收家信","author":"周弼","text":"渺渺秋风生白波，故乡归梦隔山河。\n可怜一纸平安信，不及衡阳雁字多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25764,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"早春","author":"周弼","text":"连朝微雪暗消凝，始觉春风逐旋增。\n今早画檐偏有意，数条吹折晒残冰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25765,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舟次黄鹤矶","author":"周弼","text":"俯为江山特地来，势须时暂走尘埃。\n稍闲便著携官酒，一酹吴王旧钓台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25766,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西湖初夏","author":"周弼","text":"花飞春减绿阴成，不住风光绕禁城。\n山寺晚晴蝉欲噪，柳林犹啭数声莺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25767,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"许市罩鱼","author":"周弼","text":"网边分得尾纤纤，腥却莼丝莫厌嫌。\n自有野人相料理，柳阴茅店一包盐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25768,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冷泉幽憩","author":"周弼","text":"水源穷不尽，垢腻生春袜。\n未敢辄揭流，且向幽亭歇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25769,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吴门送同行者之毗陵","author":"周弼","text":"布帆何处定逢春，身是归人又送君。\n明日隔城回首望，冷花寒叶满秋云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25770,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"咏史二首 其二","author":"周弼","text":"碧树童童荫屋庐，分明青盖画龙车。\n南阳病叟成何事，便谓枯池活得鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25771,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]