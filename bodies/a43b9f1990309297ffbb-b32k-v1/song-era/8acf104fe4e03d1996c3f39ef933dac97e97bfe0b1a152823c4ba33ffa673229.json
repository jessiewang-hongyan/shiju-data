[{"title":"绝句六十四首 其四十九","author":"张伯端","text":"雪山一味好醍醐，倾入东阳造化炉。\n若过昆崙西北去，张骞方得见麻姑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53288,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句六十四首 其四十八","author":"张伯端","text":"徒施巧伪为功力，认取他家不死方。\n壶内旋添留命酒，鼎中收取返魂浆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53289,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句六十四首 其四十七","author":"张伯端","text":"要知金液还丹法，须向家园下种栽。\n不假吹嘘并著力，自然丹熟脱真胎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53290,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句六十四首 其四十六","author":"张伯端","text":"华池饮罢月凝辉，跨个金龙访紫微。\n从此众仙相识后，海潮陵谷任迁移。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53291,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句六十四首 其四十五","author":"张伯端","text":"四象会时玄体就，五行全处紫金明。\n脱胎入口通身圣，无限龙神尽失惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53292,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句六十四首 其四十四","author":"张伯端","text":"恍惚之中寻有象，杳冥之内觅真精。\n有无从此自相入，未见如何想得成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53293,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句六十四首 其四十三","author":"张伯端","text":"黑中有白为丹母，雄里藏雌是圣胎。\n太一在炉宜守慎，三田聚宝应三台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53294,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句六十四首 其四十二","author":"张伯端","text":"始之有作无人见，及至无为众始知。\n但见无为为要道，岂知有作是根基。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53295,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句六十四首 其四十一","author":"张伯端","text":"异名同出少人知，两者玄玄是要机。\n保命全形明损益，紫金丹药最灵奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53296,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句六十四首 其四十","author":"张伯端","text":"玄牝之门世罕知，休将口鼻妄施为。\n饶君吐纳经千载，争得金乌搦兔儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53297,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句六十四首 其三十九","author":"张伯端","text":"要得谷神长不死，须凭玄牝立根基。\n真精既返黄金室，一颗灵光永不离。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53298,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句六十四首 其三十八","author":"张伯端","text":"天地盈虚自有时，审观消息始知机。\n由来庚甲申明令，杀尽三尸道可期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53299,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句六十四首 其三十七","author":"张伯端","text":"卦中设象本仪形，得象忘言意自明。\n后世迷徒惟泥象，却行卦气望飞升。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53300,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句六十四首 其三十六","author":"张伯端","text":"否泰才交万物盈，屯蒙二卦受生成。\n个中得意休求象，若究群爻谩役情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53301,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句六十四首 其三十五","author":"张伯端","text":"日月三旬一遇逢，以时易日法神功。\n守城野战知凶吉，增得灵砂满鼎红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53302,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句六十四首 其三十四","author":"张伯端","text":"兔鸡之月及其时，刑德临门药象之。\n到此金砂须沐浴，若还加火必倾危。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53303,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句六十四首 其三十三","author":"张伯端","text":"长男乍饮西方水，少女初开北地花。\n若使青娥相见后，一时关锁住黄家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53304,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句六十四首 其三十二","author":"张伯端","text":"前弦之后后弦前，药味平平气象全。\n采得归来炉里锻，锻成温养似烹鲜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53305,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句六十四首 其三十一","author":"张伯端","text":"玄珠有象逐阳生，阳极阴消渐剥形。\n十月霜飞丹始熟，恁时神鬼也须惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53306,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句六十四首 其三十","author":"张伯端","text":"一阳才动作丹时，铅鼎温温照幌帷。\n受气之初容易识，抽添运用且防危。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53307,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句六十四首 其二十九","author":"张伯端","text":"八月十五玩蟾辉，正是金精壮盛时。\n若到一阳来起复，便堪进火莫延迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53308,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句六十四首 其二十八","author":"张伯端","text":"契论经歌讲至真，不将火候著于文。\n要知口诀通玄处，须共神仙子细论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53309,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句六十四首 其二十七","author":"张伯端","text":"纵识朱砂及黑铅，不知火候也如闲。\n大都全藉维持力，毫发差殊不作丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53310,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句六十四首 其二十六","author":"张伯端","text":"姹女游从自有方，前行须短退须长。\n归来却入黄婆舍，嫁个金翁作老郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53311,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句六十四首 其二十五","author":"张伯端","text":"金翁本是东家子，送向西邻寄体生。\n认得唤来归舍养，配将姹女作亲情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53312,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句六十四首 其二十四","author":"张伯端","text":"火生于木本藏锋，不会钻研莫强攻。\n祸发只因斯害己，要须制伏觅金翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53313,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句六十四首 其二十三","author":"张伯端","text":"用将须分左右军，饶他为主我为宾。\n大凡临阵休轻敌，恐丧吾家无价珍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53314,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句六十四首 其二十二","author":"张伯端","text":"先且观天明五贼，次须察地以安民。\n民安国富方求战，战罢方能见圣君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53315,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句六十四首 其二十一","author":"张伯端","text":"月才天际半轮明，早有龙吟虎啸声。\n便好用心修二八，一时辰内管丹成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53316,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句六十四首 其二十","author":"张伯端","text":"华岳山头雄虎啸，扶桑海底牝龙吟。\n黄婆自解相媒合，遣作夫妻共一心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53317,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句六十四首 其十九","author":"张伯端","text":"西山白虎正猖狂，东海青龙不可当。\n两兽捉来令死斗，鍊成一块紫金霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53318,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句六十四首 其十八","author":"张伯端","text":"赤龙黑虎各西东，四象交加戊己中。\n复姤自兹能运用，金丹谁道不成功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53319,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句六十四首 其十七","author":"张伯端","text":"震龙汞自出离乡，兑虎铅生在坎方。\n二物总因儿产母，五行全要入中央。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53320,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句六十四首 其十六","author":"张伯端","text":"取将坎位中心实，点化离宫腹里阴。\n从此变成乾健体，潜藏飞跃尽由心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53321,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句六十四首 其十五","author":"张伯端","text":"日居离位翻为女，坎配蟾宫却是男。\n不会个中颠倒意，休将管见事高谈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53322,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句六十四首 其十四","author":"张伯端","text":"离坎若还无戊己，虽舍四象不成丹。\n只缘彼此怀真土，遂使金丹有返还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53323,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句六十四首 其十三","author":"张伯端","text":"坎电烹轰金水方，火发昆崙阴与阳。\n二物若还和合了，自然丹熟遍身香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53324,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句六十四首 其十二","author":"张伯端","text":"道自虚无生一气，便从一气产阴阳。\n阴阳再合生三体，三体重生万物昌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53325,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句六十四首 其十一","author":"张伯端","text":"梦谒西华到九天，真人授我指玄篇。\n其中简易无多语，只是教人鍊汞铅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53326,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句六十四首 其十","author":"张伯端","text":"虚心实腹义俱深，只为虚心要识心。\n莫若鍊铅先实腹，且教守取满堂金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53327,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句六十四首 其九","author":"张伯端","text":"用铅不得用凡铅，用了真铅也弃捐。\n此是用铅真妙诀，用铅不用是诚言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53328,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句六十四首 其八","author":"张伯端","text":"竹破须将竹补苴，覆雏当用子为之。\n万般非类徒劳力，争似真铅合圣机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53329,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句六十四首 其七","author":"张伯端","text":"未鍊还丹莫入山，山中内外尽非铅。\n此般至宝家家有，自是愚人识不全。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53330,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句六十四首 其六","author":"张伯端","text":"调和铅汞要成丹，大小无伤两国全。\n若问真铅是何物，蟾光终日照西川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53331,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句六十四首 其五","author":"张伯端","text":"咽津纳气是人行，有药方能造化生。\n鼎内若无真种子，犹将水火煮空铛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53332,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句六十四首 其四","author":"张伯端","text":"偃月炉中玉蕊生，朱砂鼎内水银平。\n只因火力调和后，种得黄芽渐长成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53333,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句六十四首 其三","author":"张伯端","text":"休泥丹灶费工夫，鍊药须寻偃月炉。\n自有天然真火用，不须柴炭及吹嘘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53334,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句六十四首 其二","author":"张伯端","text":"安炉立鼎法乾坤，锻鍊精华制魄魂。\n聚散氤氲为变化，敢将玄妙等闲论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53335,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句六十四首 其一","author":"张伯端","text":"先把乾坤为鼎器，次抟乌兔药来烹。\n既驱二物归黄道，争得金丹不解生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53336,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"圆通","author":"张伯端","text":"见了真空空不空，圆明何处不圆通。\n根尘心法都无物，妙用方知与物同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53337,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"随他","author":"张伯端","text":"万物纵横在目前，随他动静任哗欢。\n圆明定慧终无染，似水生莲莲自乾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53338,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七言四韵十六首 其十六","author":"张伯端","text":"万卷仙经话总同，金丹只此是根宗。\n依他坤位生成体，种向乾家交感宫。\n莫怪天机俱漏尽，都缘学者尽迷蒙。\n若人了得诗中意，立见三清太上翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53339,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七言四韵十六首 其十五","author":"张伯端","text":"不识真铅正祖宗，万般作用枉施功。\n休妻谩遣阴阳隔，绝粒徒教肠胃空。\n草木金银皆滓质，云霞日月属朦胧。\n更饶吐纳并存想，总与金丹事不同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53340,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七言四韵十六首 其十四","author":"张伯端","text":"三五一都三个字，古今明者实然稀。\n东三南二同成五，北一西方四共之。\n戊己自居生数五，三家相见结婴儿。\n婴儿是一含真气，十月胎圆入圣基。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53341,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七言四韵十六首 其十三","author":"张伯端","text":"不识玄中颠倒颠，争知火里好栽莲。\n牵将白虎归家养，产个明珠似月圆。\n谩守药炉看火候，但看神息任天然。\n群阴剥尽丹成熟，跳出凡笼寿万年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53342,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七言四韵十六首 其十二","author":"张伯端","text":"草木阴阳亦两齐，若还缺一不芳菲。\n初开绿叶阳先唱，次发红花阴后随。\n常道只斯为日用，真源返覆有谁知。\n报言学道诸君子，不识阴阳莫强嗤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53343,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七言四韵十六首 其十一","author":"张伯端","text":"黄芽白雪不难寻，达者须凭德行深。\n四象五行全藉土，三元八卦岂离壬。\n鍊成灵质人难识，消尽阴魔鬼莫侵。\n欲向人间留秘诀，未闻一个是知音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53344,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七言四韵十六首 其十","author":"张伯端","text":"好把真铅著意寻，莫教容易度光阴。\n但将地魄擒朱汞，自有天魂制水金。\n可谓道高龙虎伏，堪言德重鬼神钦。\n已知永寿齐天地，烦恼无由更上心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53345,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七言四韵十六首 其九","author":"张伯端","text":"莫把孤阴为有阳，独修一物转羸尪。\n劳形按引皆非道，鍊气餐霞总是狂。\n毕世谩求铅汞伏，何时得见虎龙降。\n劝君穷取生身处，返本还元是药王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53346,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七言四韵十六首 其八","author":"张伯端","text":"休鍊三黄及四神，若寻众药便非真。\n阴阳得类归交感，二八相当自合亲。\n潭底日红阴怪灭，山头月白药苗新。\n时人要识真铅汞，不是凡砂及水银。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53347,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七言四韵十六首 其七","author":"张伯端","text":"要知产药川源处，只在西南是本乡。\n铅遇癸生须急采，金逢望远不堪尝。\n送归土釜牢封闭，次入流珠厮配当。\n药重一斤须二八，调停火候托阴阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53348,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七言四韵十六首 其六","author":"张伯端","text":"人人尽有长生药，自是愚迷枉摆抛。\n甘露降时天地合，黄芽生处坎离交。\n井蛙应谓无龙窟，篱鶠争知有凤巢。\n丹熟自然金满屋，何须寻草学烧茅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53349,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七言四韵十六首 其五","author":"张伯端","text":"虎跃龙腾风浪粗，中央正位产玄珠。\n果生枝上终期熟，子在胞中岂有殊。\n南北宗源翻卦象，晨昏火候合天枢。\n须知大隐居廛市，何必深山守静孤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53350,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七言四韵十六首 其四","author":"张伯端","text":"此法真中妙更真，都缘我独异于人。\n自知颠倒由离坎，谁识浮沉定主宾。\n金鼎欲留朱里汞，玉池先下水中银。\n神功运火非终夕，现出深潭日一轮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53351,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七言四韵十六首 其三","author":"张伯端","text":"学仙须是学天仙，惟有金丹最的端。\n二物会时情性合，五行全处虎龙蟠。\n本因戊己为媒聘，遂使夫妻镇合欢。\n只候功成朝北阙，九霞光里驾祥鸾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53352,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七言四韵十六首 其二","author":"张伯端","text":"人生虽有百年期，寿夭穷通莫预知。\n昨日街头犹走马，今朝棺内已眠尸。\n妻财遗下非君有，罪业将行难自欺。\n大药不求争得遇，遇之不鍊是愚痴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53353,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七言四韵十六首 其一","author":"张伯端","text":"不求大道出迷涂，纵负贤才岂丈夫。\n百岁光阴石火烁，一生身世水泡浮。\n只贪利禄求荣显，不顾形容暗悴枯。\n试问堆金等山岳，无常买得不来无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53354,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"沐浴","author":"张伯端","text":"刑德同生杀，加临二八门。\n丹砂宜沐浴，神水灌灵根。\n闭兑留金汞，禁关养魄魂。\n不须行火候，炉里自温温。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53355,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"性地颂 其一","author":"张伯端","text":"佛性非同异，千灯共一光。\n增之宁解溢，减著且无伤。\n取舍皆为过，焚漂总不妨。\n见闻知觉法，无一可猜量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53356,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"抱一","author":"张伯端","text":"国富民安后，修成体属乾。\n凝神归妙道，抱一守丹田。\n去住浑无碍，升腾任自然。\n九年功满日，独步大罗仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53357,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五言","author":"张伯端","text":"女子著青衣，郎君披素练。\n见之不可用，用之不可见。\n恍惚里相逢，杳冥中有变。\n一霎火焰飞，真人自出现。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53358,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"火记六百篇","author":"张伯端","text":"火记六百篇，十月如转毂。\n朝昏各一卦，屯蒙相趁逐。\n子时发阳火，二百一十六。\n午时起阴爻，十八八个足。\n铅消汞自乾，熏蒸丹已熟。\n阴尽变纯阳，体貌如琼玉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53359,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"见物便见心","author":"张伯端","text":"见物便见心，无物心不现。\n十方通塞中，真心无不遍。\n若生知识解，却成颠倒见。\n睹境能无心，始见菩提面。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53360,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]