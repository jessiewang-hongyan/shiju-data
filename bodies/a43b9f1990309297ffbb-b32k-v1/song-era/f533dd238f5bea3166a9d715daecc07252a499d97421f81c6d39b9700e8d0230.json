[{"title":"瑞鹤仙","author":"周邦彦","text":"暖烟笼细柳。\n弄万缕千丝，年年春色。\n晴风荡无际，浓于酒、偏醉情人调客。\n阑干倚处，度花香、微散酒力。\n对重门半掩，黄昏淡月，院宇深寂。\n愁极。\n因思前事，洞房佳宴，正值寒食。\n寻芳遍赏，金谷里，铜驼陌。\n到而今、鱼雁沈沈无信，天涯常是泪滴。\n早归来，云馆深处，那人正忆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25344,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"瑞鹤仙 高平","author":"周邦彦","text":"悄郊原带郭，行路永、客去车尘漠漠。\n斜阳映山落，敛余红犹恋，孤城阑角。\n凌波步弱，过短亭、何用素约？\n有流莺劝我，重解绣鞍，缓引春酌。\n不记归时早暮，上马谁扶？\n醒眠朱阁。\n惊飙动幕。\n扶残醉，绕红药。\n叹西园已是花深无地，东风何事又恶？\n任流光过却，犹喜洞天自乐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25345,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蓦山溪 大石","author":"周邦彦","text":"湖平春水，菱荇萦船尾。\n空翠入衣襟，拊轻桹、游鱼惊避。\n晚来潮上，迤逦没沙痕，山四倚。\n云渐起。\n鸟度屏风里。\n周郎逸兴，黄帽侵云水。\n落日媚沧洲，泛一棹、夷犹未已。\n玉箫金管，不共美人游，因个甚，烟雾底。\n独爱莼羹美。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25346,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蓦山溪 其一","author":"周邦彦","text":"楼前疏柳，柳外无穷路。\n翠色四天垂，数峰青、高城阔处。\n江湖病眼，偏向此山明，愁无语。\n空凝伫。\n两两昏鸦去。\n平康巷陌，往事如花雨。\n十载却归来，倦追寻、酒旗戏鼓。\n今宵幸有，人似月婵娟，霞袖举。\n杯深注。\n一曲黄金缕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25347,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蓦山溪 其二","author":"周邦彦","text":"江天雪意，夜色寒成阵。\n翠袖捧金蕉，酒红潮、香凝沁粉。\n帘波不动，新月淡笼明，香破豆，烛频花，减字歌声稳。\n恨眉羞敛，往事休重问。\n人去小庭空，有梅梢、一枝春信。\n檀心未展，谁为探芳丛，消瘦尽，洗妆匀，应更添风韵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25348,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"虞美人 三首正宫 其二","author":"周邦彦","text":"疏篱曲径田家小。\n云树开清晓。\n天寒山色有无中。\n野外一声钟起、送孤蓬。\n添衣策马寻亭堠。\n愁抱惟宜酒。\n菰蒲睡鸭占陂塘。\n纵被行人惊散、又成双。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25349,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"虞美人 其一 正宫","author":"周邦彦","text":"金闺平帖春云暖。\n昼漏花前短。\n玉颜酒解艳红消。\n一面捧心啼困、不成娇。\n别来新翠迷行径。\n窗锁玲珑影。\n砑绫小字夜来封。\n斜倚曲栏凝睇、数归鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25350,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"虞美人 三首正宫 其一","author":"周邦彦","text":"灯前欲去仍留恋。\n肠断朱扉远。\n未须红雨洗香腮。\n待得蔷薇花谢、便归来。\n舞腰歌版闲时按。\n一任傍人看。\n金炉应见旧残煤。\n莫使恩情容易、似寒灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25351,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"虞美人 三首正宫 其三","author":"周邦彦","text":"玉觞才掩朱弦悄。\n弹指壶天晓。\n回头犹认倚墙花。\n只向小桥南畔、便天涯。\n银蟾依旧当窗满。\n顾影魂先断。\n凄风休飐半残灯。\n拟倩今宵归梦、到云屏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25352,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"虞美人","author":"周邦彦","text":"淡云笼月松溪路。\n长记分携处。\n梦魂连夜绕松溪。\n此夜相逢恰似、梦中时。\n海山陡觉风光好。\n莫惜金尊倒。\n柳花吹雪燕飞忙。\n生怕扁舟归去、断人肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25353,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"虞美人 其二 正宫","author":"周邦彦","text":"廉纤小雨池塘遍。\n细点看萍面。\n一双燕子守朱门。\n比似寻常时候、易黄昏。\n宜城酒泛浮香絮。\n细作更阑语。\n相将羁思乱如云。\n又是一窗灯影、两愁人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25354,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"解连环 商调","author":"周邦彦","text":"怨怀无托。\n嗟情人断绝，信音辽邈。\n纵妙手能解连环，似风散雨收，雾轻云薄。\n燕子楼空，暗尘锁一床弦索。\n想移根换叶，尽是旧时手种红药。\n汀州渐生杜若。\n料舟依岸曲，人在天角。\n漫记得、当日音书，把闲言闲语，待总烧却。\n水驿春回，望寄我江南梅萼。\n拼今生、对花对酒，为伊泪落。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25355,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"解语花 高平元宵","author":"周邦彦","text":"风销绛蜡，露浥红莲，灯市光相射。\n桂华流瓦。\n纤云散、耿耿素娥欲下。\n衣裳淡雅。\n看楚女纤腰一把。\n箫鼓喧，人影参差，满路飘香麝。\n因念都城放夜。\n望千门如画，嬉笑游冶。\n钿车罗帕。\n相逢处、自有暗尘遂马。\n年光是也。\n唯只见旧情衰谢。\n清漏移，飞盖归来，从舞休歌罢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25356,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"解蹀躞 商调","author":"周邦彦","text":"候馆丹枫吹尽，面旋随风舞。\n夜寒霜月，飞来伴孤旅。\n还是独拥秋衾，梦馀酒困都醒，满怀离苦。\n甚情绪。\n深念凌波微步。\n幽房暗相遇，泪珠都作，秋宵枕前雨。\n此恨音驿难通，待凭征雁归时，带将愁去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25357,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹊桥仙令/鹊桥仙 歇指","author":"周邦彦","text":"浮花浪蕊，人间无数，开遍朱朱白白。\n瑶池一朵玉芙蓉，秋露洗、丹砂真色。\n晚凉拜月，六铢衣动，应被姮娥认得。\n翩然欲上广寒宫，横玉度、一声天碧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25358,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蕙兰芳引 仙吕","author":"周邦彦","text":"寒莹晚空，点清镜、断霞孤鹜。\n对客馆深扃，霜草未衰更绿。\n倦游厌旅，但梦绕、阿娇金屋。\n想故人别后，尽日空疑风竹。\n塞北氍毹，江南图障，是处温燠。\n更花管云笺，犹写寄情旧曲。\n音尘迢递，但劳远目。\n今夜长，争奈枕单人独。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25359,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝶恋花 其四","author":"周邦彦","text":"叶底寻花春欲暮。\n折遍柔枝，满手真珠露。\n不见旧人空旧处。\n对花惹起愁无数。\n却倚阑干吹柳絮。\n粉蝶多情，飞上钗头住。\n若遣郎身如蝶羽。\n芳时争肯抛人去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25360,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝶恋花 其一 商调柳","author":"周邦彦","text":"爱日轻明新雪后。\n柳眼星星，渐欲穿窗牖。\n不待长亭倾别酒。\n一枝已入骚人手。\n浅浅挼蓝轻蜡透。\n过尽冰霜，便与春争秀。\n强对青铜簪白首。\n老来风味难依旧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25361,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝶恋花 其三 商调柳","author":"周邦彦","text":"蠢蠢黄金初脱后。\n暖日飞绵，取次粘窗牖。\n不见长条低拂酒。\n赠行应已输先手。\n莺掷金梭飞不透。\n小榭危楼，处处添奇秀。\n何日隋堤萦马首。\n路长人倦空思旧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25362,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝶恋花 商调秋思","author":"周邦彦","text":"月皎惊乌栖不定。\n更漏将残，轣辘，牵金井。\n唤起两眸清炯炯。\n泪花落枕红棉泠。\n执手霜风吹鬓影。\n去意徊徨，别语愁难听。\n楼上阑干横斗柄。\n露寒人远鸡相应。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25363,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝶恋花 其四 商调柳","author":"周邦彦","text":"小阁阴阴人寂后。\n翠幕褰风，烛影摇疏牖。\n夜半霜寒初索酒。\n金刀正在柔荑手。\n彩薄粉轻光欲透。\n小叶尖新，未放双眉秀。\n记得长条垂鹢首。\n别离情味还依旧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25364,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝶恋花 其五","author":"周邦彦","text":"酒熟微红生眼尾。\n半额龙香，冉冉飘衣袂。\n云压宝钗撩不起。\n黄金心字双垂耳。\n愁入眉痕添秀美。\n无限柔情，分付西流水。\n忽被惊风吹别泪。\n只应天也知人意。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25365,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝶恋花 其三","author":"周邦彦","text":"晚步芳塘新霁后。\n春意潜来，迤逦通窗牖。\n午睡渐多浓似酒。\n韶华已入东君手。\n嫩绿轻黄成染透。\n烛下工夫，泄漏章台秀。\n拟插芳条须满首。\n管交风味还胜旧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25366,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝶恋花 其二 商调柳","author":"周邦彦","text":"桃萼新香梅落后。\n暗叶藏鸦，苒苒垂亭牖。\n舞困低迷如著酒。\n乱丝偏近游人手。\n雨过朦胧斜日透。\n客舍青青，特地添明秀。\n莫话扬鞭回别首。\n渭城荒远无交旧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25367,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝶恋花 其一","author":"周邦彦","text":"鱼尾霞生明远树。\n翠壁黏天，玉叶迎风举。\n一笑相逢蓬海路。\n人间风月如尘土。\n剪水双眸云鬓吐。\n醉倒天瓢，笑语生青雾。\n此会未阑须记取。\n桃花几度吹红雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25368,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝶恋花 其二","author":"周邦彦","text":"美盼低迷情宛转。\n爱雨怜云，渐觉宽金钏。\n桃李香苞秋不展。\n深心黯黯谁能见。\n宋玉墙高才一觇。\n絮乱丝繁，苦隔春风面。\n歌板未终风色便。\n梦为蝴蝶留芳甸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25369,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉桃源 其二 大石","author":"周邦彦","text":"菖蒲叶老水平沙。\n临流苏小家。\n画阑曲径宛秋蛇。\n金英垂露华。\n烧蜜炬，引莲娃。\n酒香薰脸霞。\n再来重约日西斜。\n倚门听暮鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25370,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉桃源 其一 大石","author":"周邦彦","text":"冬衣初染远山青。\n双丝云雁绫。\n夜寒袖湿欲成冰。\n都缘珠泪零。\n情黯黯，闷腾腾。\n身如秋后蝇。\n若教随马逐郎行。\n不辞多少程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25371,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉落魄/一斛珠","author":"周邦彦","text":"葺金细弱。\n秋风嫩、桂花初著。\n蕊珠宫里人难学。\n花染娇荑，羞映翠云幄。\n清香不与兰荪弱。\n一枝云鬓巧梳掠。\n夜凉轻撼蔷薇萼。\n香满衣襟，月在凤凰阁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25372,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹤冲天 其一 溧水长寿乡作","author":"周邦彦","text":"梅雨霁，暑风和，高柳乱蝉多。\n小园台榭远池波，鱼戏动新荷。\n薄纱厨，轻羽扇，枕冷簟凉深院。\n此时情绪此时天，无事小神仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25373,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹤冲天 其二","author":"周邦彦","text":"白角簟，碧纱厨。\n梅雨乍晴初。\n谢家池畔正清虚。\n香散嫩芙蕖。\n日流金，风解愠。\n一弄素琴歌舞。\n慢摇纨扇诉花笺。\n吟待晚凉天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25374,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"燕归梁 高平晓","author":"周邦彦","text":"帘底新霜一夜浓。\n短烛散飞虫。\n曾经洛浦见惊鸿。\n关山隔、梦魂通。\n明星晃晃，回津路转，榆影步花骢。\n欲攀云驾倩西风。\n吹清血、寄玲珑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25375,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"霜叶飞 大石","author":"周邦彦","text":"露迷衰草。\n疏星挂，凉蟾低下林表。\n素娥青女斗婵娟，正倍添凄悄。\n渐飒飒、丹枫撼晓。\n横天云浪鱼鳞小。\n似故人相看，又透入、清辉半饷，特地留照。\n迢递望极关山，波穿千里，度日如岁难到。\n凤楼今夜听秋风，奈五更愁抱。\n想玉匣、哀弦闭了。\n无心重理相思调。\n见皓月、牵离恨，屏掩孤颦，泪流多少。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25376,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其三","author":"周邦彦","text":"夹辇司花百士人，绣楣琼璧写宜春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25377,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其一","author":"周邦彦","text":"化行禹贡山川外，人在周公礼乐中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25378,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其二","author":"周邦彦","text":"明朝春仗当行乐，刻燕催花掷万金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25379,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其六","author":"周邦彦","text":"人从生处乐，谁向死前休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25380,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其四","author":"周邦彦","text":"裁幡小废藏钩戏，生菜仍□宿岁□。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25381,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其五","author":"周邦彦","text":"对花今日柰天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25382,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"周伯仁","text":"照天不夜梨花月，落地无声柳絮风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25383,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春从天上来 武昌秋夜","author":"周伯阳","text":"浩荡青冥。\n正凉露如洗，万里虚明。\n鼓角悲健，秋入重城。\n彷佛石上三生。\n指蓬莱云路，渺何许、月冷风清。\n倚南楼、一声长笛，几点残星。\n西风旧年有约，听候蛩语夜，客里心惊。\n红树山深，翠苔门掩，想见露草疏萤。\n便乘风归去，阑干外、河汉西倾。\n笑淹留，划然孤啸，云白天青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25384,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"摸鱼儿 次韵送别","author":"周伯阳","text":"又匆匆、月鞭露镫，梅花江上归路。\n海图破碎来时线，何似彩衣低舞。\n风雪暮。\n正望断青山，一发云横处。\n浩歌独举。\n便想见迎门，牵衣儿女，总是旧眉妩。\n阳关曲，挥洒紫薇花露。\n妙音清远高古。\n经寒杨柳休轻折，摇动一溪霜雾。\n邯郸步。\n笑布袜青鞋，去住知何许。\n汀鸥沙鹭。\n若问我重来，明年有约，今日是前度。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25385,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蒿","author":"周吟轩","text":"野蔬山芋惯寒酸，羹绿齑黄顿顿餐。\n直到新年立春日，却无生菜上春盘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25386,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送僧有言之天台","author":"周启明","text":"进寺金庭远，香文玉篆连。\n船中鸣夜磬，雪里见新年。\n山尽城临岸，云空海照天。\n莫嫌通剡客，僧舍枕花川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25387,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其一","author":"周启明","text":"一丸童子药，五返使臣车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25388,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其二","author":"周启明","text":"鸱夷江上畬田稔，牛斗星边贯索空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25389,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"木兰花慢 富州道中","author":"周孚先","text":"访梅江路远，喜春在、剑川湄。\n正雁碛云深，渔村笛晚，茸帽斜敧。\n旧游不堪回首，更文园、多病减腰围。\n惟有秋娘声价，风流仍似前时。\n依稀壁粉旧曾题。\n烟草半凄迷。\n叹单父台荒，黄公垆寂，难觅佳期。\n谁家歌楼催雪，遣夜来、风雨紧些儿。\n醉后唾壶敲缺，龙光摇动晴漪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25390,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝶恋花","author":"周孚先","text":"舟舣津亭何处树。\n晓起珑璁，回首迷烟雾。\n江上离人来又去。\n飘零只似风前絮。\n倦倚蓬窗谁共语。\n野草闲花，一一伤情绪。\n明日重来须记取。\n绿杨门巷深深处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25391,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 禁酒","author":"周孚先","text":"曾唱阳关送客时。\n临岐借酒话分离。\n如今酒被多情苦，却唱阳关去别伊。\n欢会远，渺难期。\n黄垆门掩昼阴迟。\n青楼更有痴儿女，谩忆胡姬捧劝词。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25392,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"庆南楼居士 其三","author":"周应合","text":"南极垣头现一星，辉光特著老人名。\n不随东壁西庚照，要对南楼夜夜明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25393,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"庆南楼居士 其四","author":"周应合","text":"万古南山耸翠屏，岧峣上拂斗牛星。\n不随北华西崧见，要对南楼岁岁青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25394,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"庆南楼居士 其二","author":"周应合","text":"净土何如乐土真，金莲开处善根成。\n西来孰谓南无佛，今见南楼一佛生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25395,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"望江楼","author":"周应合","text":"澄江如练正高秋，一笛吹秋上此楼。\n有客乘风来纵酒，长歌远送下滩舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25396,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"庆南楼居士 其一","author":"周应合","text":"阻寿南楼恰二年，此心恧甚思依然。\n今朝喜遇称觞日，袖里新诗再办□。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25397,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"汤泉","author":"周沔","text":"雁门泉水热于汤，清净源从古道场。\n应笑骊山山下水，至今犹带粉脂香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25398,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"周沔","text":"萤火不知人已去，夜深犹傍竹窗明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25399,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 题梅扇","author":"周纯","text":"梅花韵似才人面。\n为伊写在春风扇。\n人面似花妍。\n花应不解言。\n在手微风动。\n勾引相思梦。\n莫用插酴醾。\n酴醾羞见伊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25400,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"满庭霜/满庭芳 墨梅","author":"周纯","text":"脂泽休施，铅华不御，自然林下真风。\n欲窥馀韵，何处问仙踪。\n路压横桥夜雪，看暗淡、残月朦胧。\n无言处，丹青莫拟，谁寄染毫工。\n遥通。\n尘外信，寒生墨晕，依约形容。\n似疏疏斜影，蘸水摇空。\n收入云窗雾箔，春不老、芳意无穷。\n梨花雨，飘零尽也，难入梦魂中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25401,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"瑞鹧鸪","author":"周纯","text":"一痕月色挂帘栊。\n梅影斜斜小院中。\n狂醉有心窥粉面，梦魂无处避香风。\n愁来梦楚三千里，人在巫山十二重。\n咫尺蓝桥无处问，玉箫声断楚山空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25402,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蓦山溪 墨梅、荆楚间鸳鸯梅、赋此","author":"周纯","text":"江南春信，望断人千里。\n魂梦入花枝，染相思、同心并蒂。\n鸳鸯名字，赢得一双双，无限意。\n凝烟水。\n念远教谁寄。\n毫端写兴，莫把丹青拟。\n墨客要卿卿，想临池、等闲梳洗。\n香衣黯淡，元不涴缁尘，怜缟袂。\n东风里。\n只恐于飞起。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25403,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"周良臣","text":"却从谷口问归樵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25404,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"施岩","author":"周坦","text":"人烟断处逢仙迹，草木深时听鸟悲。\n记取画工描一幅，出山长若在山时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25405,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题招提院静照堂","author":"周孟阳","text":"羡师遗世网，旧隐敞新堂。\n月白秋庭小，风清昼榻凉。\n倦游轻势利，归梦在沧浪。\n满箧朝贤句，孤云出帝乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25406,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"周孟阳","text":"地高多与风云会，天近尝为日月邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25407,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]