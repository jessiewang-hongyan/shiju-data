[{"title":"登岳寺悦亭","author":"李曾伯","text":"十年两度看山来，云琐融峰特地开。\n办取篮舆穷胜处，南边无事岭头回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63682,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登桂林宜楼和李帅柱间韵","author":"李曾伯","text":"谁言南服远王畿，面面青山总是诗。\n桂后梅前正清淑，倚楼但觉九秋宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63683,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赋新茶","author":"李曾伯","text":"建岭人誇第一纲，湘中热后已先尝。\n虽然声价殊官焙，反觉山家气味长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63684,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题利州道上江月轩","author":"李曾伯","text":"何用朝朝夜夜钟，一拳打透彻虚空。\n诗僧不见禅僧老，月自西沉江自东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63685,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题宜兴庵壁 其二","author":"李曾伯","text":"秋尽菊都荒，蜂犹采蜜忙。\n何如龟缩壳，此际已深藏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63686,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题宜兴庵壁 其一","author":"李曾伯","text":"禅榻一觉睡，冬宵五更长。\n窗递清风入，枕边松柏香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63687,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题宜兴庵壁 其三","author":"李曾伯","text":"拂石坐小桥，临流俯清泚。\n松声与禽声，可以醒吾耳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63688,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题范蠡五湖图 其三","author":"李曾伯","text":"江湖存魏阙，翰墨寓规箴。\n君看龙眠画，当识鸱夷心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63689,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题覃怀吕充隐和陶诗卷","author":"李曾伯","text":"数诗盘谷友人钦，一片柴桑处士心。\n几十年间南北事，祗令三叹有遗音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63690,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"衡阳道间 其三","author":"李曾伯","text":"风著征裘怯晚寒，一番春事在征鞍。\n羞听后骑鸣笳鼓，赢得儿童夹道看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63691,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"衡阳道间 其二","author":"李曾伯","text":"听彻山鸡唤雨声，东风未肯放新晴。\n行人莫叹泥涂苦，且幸田家得水耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63692,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"衡阳道间 其一","author":"李曾伯","text":"满林松竹翠交加，路过衡阳得几家。\n门傍粉墙人寂寂，一陂春水数株花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63693,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠相士钱懒溪","author":"李曾伯","text":"塞北烟氛扫未开，何劳青眼过江来。\n道人已办游山屐，福将谁胜上马杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63694,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"天基节静江祝圣乐语口号","author":"李曾伯","text":"五叶尧蓂纪诞弥，庆流文祖已垂基。\n星明南极老人寿，春布东皇太乙时。\n红入仙桃千岁实，青归御柳万年枝。\n岭民喜见升平象，拜手同赓天保诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63695,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乙巳题制参萧应父袭芳亭","author":"李曾伯","text":"细揽群英入此亭，重开八叶付公门。\n无穷真意侵书架，不断清香对酒樽。\n由实又花花又实，看孙生子子生孙。\n主人不用平泉誓，自有根源六艺存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63696,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乙未渡淮点军登寿春南楼","author":"李曾伯","text":"曾向春秋识此州，西风吹袂过淮头。\n人还故老衣冠喜，我为中原草木愁。\n屹若长城今重镇，弃如敝屣昔轻谋。\n功名不是吾曹事，且对空山徙倚楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63697,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丁巳闰月六日登岳阳楼","author":"李曾伯","text":"二十年前典此州，经行中又几春秋。\n青山面目元无恙，白发形骸祗自羞。\n客子登临知有酒，古心忧爱在斯楼。\n凭栏慨想飞吟过，水视杯坳芥视舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63698,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丁巳到宜兴坟庵","author":"李曾伯","text":"归来闲未久，老去役何堪。\n未远蜀天北，又之湘水南。\n奔驰缘未足，辛苦分当甘。\n徒羡林泉适，长年任住庵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63699,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丁未效八窗叔赋黄郎","author":"李曾伯","text":"夙悟金仙空色教，化生千百对青春。\n强颜翁媪栀为貌，取悦儿童丝系身。\n立仗无言开口甚，当筵何事掉头频。\n笑他鲍郭经年舞，我过莺花即问津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63700,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丁亥沔阳春时即事简吴叔永","author":"李曾伯","text":"朝来渐可试春衣，弩末轻寒力已微。\n木叶未繁山尚瘦，桃花欲落水初肥。\n疆陲虏逐征鸿去，庭馆人随社燕归。\n紫陌青门无恙在，不妨携酒问芳菲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63701,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九日登寿沙城楼","author":"李曾伯","text":"偶因萸菊到城头，手揽潇湘一片秋。\n西北黄尘清远徼，东南紫气盛中州。\n众山环拱皆衡麓，一水横陈是橘洲。\n且酌芳樽酹千古，去来鸥雁自沉浮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63702,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"入兴安界","author":"李曾伯","text":"路入兴安境，风光异昔年。\n山川虽好在，井邑顿凄然。\n雨打半颓屋，烟荒未辟田。\n起丁征籴急，官府为防边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63703,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"入祁阳县界即事","author":"李曾伯","text":"境入祁阳驿堠迢，道旁烟火顿萧萧。\n茅冈丛筱路磊砢，蓬舍扃柴人寂寥。\n市粒颇艰缘岁俭，野芳交发自春饶。\n扶藜勇过黄罴岭，知竭精忠答圣朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63704,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"入郢访张学宾因睹旧句有感","author":"李曾伯","text":"此君尝识面，阅八载重来。\n倦鸟欣曾宿，栖鸾去不回。\n墙阴馀旧墨，砌下长新苔。\n多谢东屏主，时时为拂埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63705,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"入清湘界","author":"李曾伯","text":"渐近湘山境，土风清且饶。\n林峦接墟市，水竹带溪桥。\n焙出新茶煮，帘垂老酒招。\n春和民气乐，几日是花朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63706,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"入蜀垫江道间 其二","author":"李曾伯","text":"驿路交游熟，江山契分生。\n故人梅扑面，薄倖柳忘情。\n马跃霜桥步，鸡啼月店声。\n豹狼俱敛迹，应避使车行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63707,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"入蜀垫江道间 其一","author":"李曾伯","text":"纸被夜受用，布袍朝奏功。\n光阴半行客，气象一衰翁。\n何事朝伊夕，才非雨即风。\n年华苦相背，归去又匆匆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63708,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"八公山忆廉颇","author":"李曾伯","text":"在楚犹在赵，始终同一颇。\n晚年犹矍铄，劲气肯消磨。\n非老无能也，如时不利何。\n汉皇还拊髀，用壮莫蹉跎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63709,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"八窗叔用前韵相寄时留村舍和以谢之 其二","author":"李曾伯","text":"洛川已矣不复见，斯地岿然犹独存。\n九仞成功忍亏篑，百年种德在深根。\n依稀旧燕空梁语，俯仰飞鸿踏雪痕。\n多少名园富花石，争如书圃付儿孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63710,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又和八窗叔见寄","author":"李曾伯","text":"寂寞寒枝问故栖，柳疏梧老影熹微。\n炊烟冷落犁荒垄，篷雨廉纤缆断矶。\n拟阅旧书成懒癖，旋篘新酒解愁围。\n家人不惯田园趣，刚道天寒盍早归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63711,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又和梅韵","author":"李曾伯","text":"千里诗来字字香，品题著意到孤芳。\n以千林表丈人行，洗万古凡儿女妆。\n自是精神凌雪月，不妨风骨饱冰霜。\n撚髭聊以酬清思，病笔攲斜愧小王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63712,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"久雨之馀隔窗闻雪简书院诸丈 其二","author":"李曾伯","text":"玉龙飞下太清境，粉雉凝成不夜城。\n眩得穷儿犹暴富，照教暗室亦强明。\n来朝细挹千林色，竟夕都忘万籁声。\n不愿衔枚蔡州去，铁衣早撤戍边兵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63713,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"久雨之馀隔窗闻雪简书院诸丈 其一","author":"李曾伯","text":"雨覆云翻越月馀，苦疑滕六欠工夫。\n倏敲窗竹清成玉，细剪檐花碎作珠。\n已喜新冬三白有，不愁嗣岁二红无。\n地炉纸帐杯行了，呼起诗翁为撚须。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63714,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小亭闲止","author":"李曾伯","text":"草草家林适，时时步屐过。\n跨流通略彴，枕岸拟䍧牱。\n墙外千竿竹，亭阴数亩荷。\n年丰遂闲止，老境足婆娑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63715,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山中即事","author":"李曾伯","text":"手挼岩菊嗅寒香，陡觉轻飙透薄裳。\n自是苍官添老色，不因青女眩寒妆。\n新篘未熟啜茶去，晚稻才收种麦忙。\n愿学老农惟苦懒，荷锄归去卧斜阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63716,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"己未元日寄子","author":"李曾伯","text":"子在衡州我桂州，两州相望共承流。\n天回北斗又华旦，人立东风正黑头。\n新岁五更三节序，老夫六十二春秋。\n何时共对屠苏饮，应念孤云为倚楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63717,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"己酉八桂劝驾","author":"李曾伯","text":"快束行装稳著鞭，梅边已报小春天。\n程开鹏翼三千里，名继龙头二百年。\n花插一枝趋燕喜，云占五色对胪传。\n丈夫自许当如此，举酒相期共勉旃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63718,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"己酉六月阻水于宜春道间枫树","author":"李曾伯","text":"去国二千里，离家五十程。\n炎歊无计避，忧患以身更。\n误矣骖鸾句，伤哉舐犊情。\n何时拂衣去，藜藿保馀生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63719,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"己酉庆周子将寿八十","author":"李曾伯","text":"华龄八帙庆朋簪，贵老崇师喜见今。\n绛帐先生从白发，金闺诸彦尽青衿。\n冰寒水见源流盛，玉在山知润泽深。\n厚德作人宜寿艾，永传文献纪枌阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63720,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"己酉赴桂过抚州樟原得雨","author":"李曾伯","text":"夜来一雨洗骄阳，轧轧篮舆趁晓凉。\n过眼几多山应接，转头二十里相望。\n烟横夹道松交翠，水拍连畴稻半黄。\n辙迹平生今始到，元知乐土是江乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63721,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"己酉赴桂初宿会江驿用徐意一韵","author":"李曾伯","text":"江海三吴会，萍途一昔栖。\n路迎来阜北，船趁长潮西。\n鱼鸟随情适，鹏蜩付物齐。\n羊裘人底处，烟雨故踪迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63722,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书院诸客登仲宣楼以诗寄之","author":"李曾伯","text":"指点层云气可干，官身浩叹不如闲。\n几回落日诗怀古，一半春风酒破悭。\n许我婆娑从白发，于人妩媚有青山。\n前身王粲重拈笔，惜欠胡床著席间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63723,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五月闻蛩有感","author":"李曾伯","text":"南风先自作秋声，蛩尔何知亦早吟。\n慵妇机边重到耳，征人塞上顿惊心。\n索裘应解寒将晚，彻土须乘天未阴。\n闻此休将儿戏看，盍图远略备当今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63724,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"从制垣观阅和韵","author":"李曾伯","text":"春风小试被庐蒐，抵掌功名一战收。\n万里关河走狐兔，五更笳鼓肃貔貅。\n星驰列骑看腾跃，云合嘉宾乐献酬。\n机会不来人易老，故都惆怅麦油油。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63725,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"以劝分出伏龙因谒武侯庙","author":"李曾伯","text":"庐存龙去迹成非，草木空山圣得知。\n成败论人陈寿史，功名馀恨少陵诗。\n初心何只三分汉，伟略徒誇十倍丕。\n半夜松声捲风雨，犹如抱膝啸吟诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63726,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"劝驾桂林乡举","author":"李曾伯","text":"十年复此主文盟，喜得名邦岁贡英。\n宴启鹿鸣珠照乘，堂开鹏运玉连城。\n梅花雪里传魁信，桂子风前送客程。\n若到天庭问南事，细陈长策为销兵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63727,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"午行即事","author":"李曾伯","text":"数日征行喜即晴，山明溪秀翠为屏。\n竹门梅出数枝白，松外山横几叠青。\n人渐采茶登陇阜，家多酿秫市邮亭。\n短舆午困几成梦，两两枝禽为唤醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63728,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"壬子劝驾","author":"李曾伯","text":"人物从来盛楚南，新元诏士奉芝函。\n身逢熙运千之一，名占巍科十有三。\n好趁驿梅催骑策，归来官柳映袍蓝。\n池边相祝趋闻喜，剩取宫花一朵簪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63729,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"壬子江陵寄闻人松庵","author":"李曾伯","text":"不见松庵又几年，书来云欲卜新椽。\n我方北寨愁供戍，君盍西湖喜结缘。\n多谢烹鱼勤客遗，薄言骑鹤寓腰缠。\n惜无广厦欢颜力，姑用长安作酒钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63730,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"壬子夏偶成","author":"李曾伯","text":"心已灰如鬓已皤，迫人桑荫疾于梭。\n更尝万事不为少，恍悟一身犹是多。\n田里乞身斯可矣，功名到手竟如何。\n公馀幸喜边烽静，且对樽前浩浩歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63731,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"壬辰过鄂渚简张子直总干 其二","author":"李曾伯","text":"三载三来汉水湄，做成底事又空归。\n尘埃暂解微官缚，雨雪犹存战士衣。\n黄鹤喜寻诗侣约，白鸥还悟海翁机。\n掀髯一接春风笑，便觅渔蓑老钓矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63732,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"忆幼子","author":"李曾伯","text":"膝下相随五阅秋，意其可以付箕裘。\n祗缘老子身无福，致使佳儿命不修。\n宿业结来知有自，暑行坏会复奚尤。\n灵台一点知何处，痛入肝肠死则休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63733,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"月峡城楼偶作","author":"李曾伯","text":"云羃前溪洞，烟荒隔岸城。\n秋旗杂山色，晓角带江声。\n驻骑须边静，维舟待峡平。\n掀髯聊徙倚，一雁楚天横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63734,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"月峡重九感怀","author":"李曾伯","text":"落帽寻盟鬓久皤，今朝于此上嵯峨。\n云收谷净山新霁，风定沙平水不波。\n对菊使人怀古尔，思莼如我感时何。\n明年把酒知何处，归到东篱更莫它。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63735,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"王母致语口号","author":"李曾伯","text":"碧虚飞信入蓬莱，约我骖鸾伴侣来。\n蔼蔼祥云射虹渚，缤缤香雾下龟台。\n喜乘莲叶经琼海，笑指梅花荐玉杯。\n圣算自应天地久，蟠桃不计几回开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63736,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"长沙郡斋中夜闻雨不寐","author":"李曾伯","text":"檐花窗叶和灯前，全似江南雁到天。\n渐老弗堪秋意早，不眠那为雨声然。\n学儒不力冠非误，善舞何心袖足旋。\n唤醒几番关塞梦，蛩吟四壁只年年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63737,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丙子登岘山","author":"李曾伯","text":"汉江为带楚山维，多少兴亡此地知。\n万里边风寒故垒，千年陇月老残碑。\n尘迷柏土龙根幻，水绕檀溪马骨悲。\n举世岂无羊叔子，草莱犹未起男儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63738,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丙午九日将过阳羡偶成","author":"李曾伯","text":"年年秋晚对风沙，今近重阳喜在家。\n自断此生甘皓首，能消几度看黄花。\n闲身颇觉便筇竹，醉态都忘脱帽纱。\n且问小舟溪上去，飞鸥数点夕阳斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63739,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丙午冬徐衍道见访于可斋","author":"李曾伯","text":"甫能锄月种梅归，竹外欣闻客扣扉。\n天近城南宁去缓，人闲水北肯来稀。\n风云迅步新班笋，雨雪休思旧戍薇。\n别后毋廑问名氏，杜门终老但知非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63740,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"东西正阳献捷和傅山父凯歌韵","author":"李曾伯","text":"一从授钺俾来旬，却敌无谋效不神。\n士用命焉何有力，臣今老矣不如人。\n谁能河北平三晋，犹虑关中启一秦。\n留取功名待来者，归欤抗疏告严宸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63741,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"代为其亲寿 其二","author":"李曾伯","text":"两星相比映文昌，戏綵蹁跹戟卫香。\n鬓底公因民事白，眉边人卜诏书黄。\n五千文字为家计，百万阴功即寿乡。\n要学元和同九老，未誇耆旧传襄阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63742,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"代为其亲寿 其一","author":"李曾伯","text":"十载青油驻岘山，屹如一柱倚人寰。\n秧畴雨足春犁乐，榆塞风清夜柝闲。\n威望龙堆毡帐外，勋名麟阁鼎彝间。\n命圭指日催裴度，乐府无烦唱玉关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63743,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"代饯蜀阃赴召乐语口号","author":"李曾伯","text":"自拥雕旂运阃筹，星霜四历玉关秋。\n深培根本安全蜀，直用精神定远陬。\n琴鹤公将离峡口，樵渔我亦访吴头。\n溪山好处俱堪饮，江路相衔醉未休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63744,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"代益昌宪运两司宴制帅乐语口号","author":"李曾伯","text":"春风旗鼓拥元戎，万马方嘶一洗空。\n不惮八千来剑北，始知十二小齐东。\n将扶灞上真人业，未说隆中宰相功。\n整顿乾坤谈笑事，归来置酒未央宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63745,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"代蜀总赴召宴制帅乐语口号","author":"李曾伯","text":"晓来微雨过前溪，见说桃花水正肥。\n人送风帆还紫闼，客随星履近黄扉。\n昔陪关上青牛到，今趁辽东白鹤归。\n留得春风满全蜀，尚知杨柳赋依依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63746,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"代襄阃宴新除史制卿乐语口号","author":"李曾伯","text":"一从棋折佐筹帷，凛凛威名塞汉知。\n大范老今归去矣，小申公为易新之。\n檀溪春草轻车熟，苕霅秋莼短艇宜。\n千载岘山磨不朽，重添羊杜两丰碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63747,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出郊劭农口占","author":"李曾伯","text":"小约宾僚集，相招老父耕。\n寺依青带住，人在翠帷行。\n叠嶂堆春色，微云护午晴。\n时康田里乐，归骑踏花轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63748,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]