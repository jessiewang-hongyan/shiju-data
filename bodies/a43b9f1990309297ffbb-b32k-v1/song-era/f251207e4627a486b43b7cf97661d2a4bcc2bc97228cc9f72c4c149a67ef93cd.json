283ba061d3","dynasty":"宋"}},{"title":"菩提寺","author":"罗公升","text":"一亩方池几劫灰，哭声未了笑声催。\n六桥烟柳相逢处，半是菩提拭泪来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31027,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"禽言 夜鹤","author":"罗公升","text":"月黑众慝起，夜鹤乘时呼。\n悬知不足畏，奈此渊中□。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31028,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢松野叔惠菊","author":"罗公升","text":"囷粟分公瑾，千金寿仲连。\n山人不须此，再拜菊花前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31029,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新秋","author":"罗公升","text":"团扇初辞暑，虚檐恰受风。\n帘花孤月冷，秋在不声中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31030,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"溪上","author":"罗公升","text":"往岁贪奇览，今年遂考槃。\n门前溪一发，我作五湖看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31031,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"演福寺","author":"罗公升","text":"祎翟当年让福人，早知何用羡长春。\n帝乡抔土真无憾，怨绝龙沙万里身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31032,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端午夫人阁","author":"罗公升","text":"黄金角黍照盘明，秋月弓湾斗彩赢。\n应是君王方右武，内家仙子亦知兵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31033,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端午皇帝阁","author":"罗公升","text":"化日舒长万国陶，南风古韵入弦高。\n天心广大乾坤小，添得神游一两遭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31034,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蔡州 其二","author":"罗公升","text":"臣子应思累世雠，况凭朽壤捍狂流。\n今人不恨南兵弱，却恨南兵入蔡州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31035,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蔡州 其一","author":"罗公升","text":"中国衣冠礼乐先，国亡那得更求全。\n凄凉青盖端诚殿，何似幽兰一炬烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31036,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"燕城读史 其一","author":"罗公升","text":"主父变服强公叔，魏武迁都违众臣。\n战国犹有知礼士，后世还同问俗人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31037,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"燕城读史 其九","author":"罗公升","text":"石虎父子恃兵刀，卜世谓与天地期。\n那知喋血宫庭者，尽是怀中抱弄儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31038,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乙酉元日游长春宫奚真人所居之地雕砌文础皆汴都宫殿旧物","author":"罗公升","text":"元日能关一日开，解鞍杖策访云端。\n树冲剑气千秋老，泉遇松声六月寒。\n朝市未妨閒野乐，山村犹恨世途难。\n凄凉龙德宫中石，装点琳宫处道冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31039,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日","author":"罗公升","text":"客楼坐阅帝居移，强赋愁边九日诗。\n称寿无从辜菊把，避灾何处愧茱枝。\n兴如陷贼蓝田日，吟到闻兵汉北时。\n万里朔风将梦去，故园鸥鹭诉相思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31040,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日言怀","author":"罗公升","text":"木落湖山万叶黄，乱愁深处见重阳。\n絺衣只惯诗人体，酒盏全乖病客肠。\n只道事随人意改，如何花作旧时香。\n孤楼不作还家梦，卧听松风响夜长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31041,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山背道中","author":"罗公升","text":"是间定可著吾家，流水深林一径斜。\n天下独清惟雪色，客中旧识是梅花。\n妍媸颠倒惊时事，战伐纷纭老岁华。\n风雨穷山为谁苦，故人何处岸乌纱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31042,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"世故","author":"罗公升","text":"世故年年别，人烟处处非。\n诗从出山俗，客已及门稀。\n凯入犹闻警，场登更苦饥。\n乾坤多事在，未许制荷衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31043,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东平府文庙规模颇壮其中亦有儒生十数然无一可语者","author":"罗公升","text":"当年邹鲁地，弦诵久无声。\n刀笔迂颜闵，章缝羡甲兵。\n谷陵朝暮改，日月古今明。\n岁晚高皇帝，犹难致两生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31044,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代前清江守滕大著赠李吉州","author":"罗公升","text":"福星又见出虚危，螺浦千山亦展眉。\n八邑命悬循吏传，万家春在道州诗。\n旌旗已变河阳色，布粟犹怜蔡土饥。\n只恐九天归诏急，去思还似凤洲时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31045,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"安庆府","author":"罗公升","text":"金城图上各论功，弹压江流势自雄。\n但使老熊当道左，宁愁游骑入回中。\n幕间客解称杨子，席上伶谁赋皖公。\n禾黍渐多青燐歇，郡人犹忆降元戎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31046,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江州寒食","author":"罗公升","text":"旅食逢寒食，风声佐雨声。\n野坟犹有主，客舍若为情。\n家近心逾切，囊空眼便生。\n庐山如不过，此去信无名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31047,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过表湖逢彭奇山","author":"罗公升","text":"入眼溪山亦世情，故人无复旧家声。\n卖刀未得逢龚遂，置醴那知为穆生。\n相鼠聊为庆封赠，巨牛应待老瞒烹。\n倘无听雨连床乐，惭愧先□冒暑行。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31048,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过嘉兴雪中","author":"罗公升","text":"天末雄风捲白波，玉舟既晓泛银河。\n不知瑞入耕畴未，但觉寒生客路多。\n四海尽宽胡至此，一丘无分欲如何。\n只因岁晚嘉禾道，剩要先生赋七歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31049,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别次山馆中诸客","author":"罗公升","text":"德星光照斗牛野，我亦沙鸥尾凤鸾。\n聚首自怜我辈在，画眉莫与世人看。\n正平幸作忘年好，灵运那知入社难。\n明日回头别群玉，乱山何处兀孤鞍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31050,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"牢落","author":"罗公升","text":"牢落岁时晚，天寒游子悲。\n相几如赵壹，舌不救张仪。\n梦短鸡声急，心飞雁足迟。\n乱愁已堪织，零雨更如丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31051,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和罗菊潭","author":"罗公升","text":"六月茫茫天昼昏，泾清渭浊不须分。\n安能夜踏文城雪，只合朝看太华云。\n异日亲曾拜黄石，他年应有好玄文。\n人间无著掀髯处，天姥峰头一唤君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31052,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]