[{"title":"周南仲挽词","author":"翁卷","text":"志以古人期，今人焉得知。\n学非无用处，命自不逢时。\n华省官如梦，闲居谤亦随。\n丧君于此日，师友最相悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59055,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岳麓宫道房","author":"翁卷","text":"借问经行处，群仙第几家。\n晴檐鸣雪滴，虚砌影梅花。\n香爇何年柏，芽煎未社茶。\n道人三四辈，相对诵南华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59056,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泊舟龙游","author":"翁卷","text":"未得桥开锁，去船难自由。\n渚禽飞入竹，山叶下随流。\n忽见秋风喜，还成早岁愁。\n卧闻舟子说，明日到衢州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59057,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"信州草衣寺","author":"翁卷","text":"檐多山鸟啼，山外玉为溪。\n林树若又长，塔峰应更低。\n数僧归似客，一佛坏方泥。\n宴坐当时事，廊碑具刻题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59058,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南涧寻韩仲止不遇","author":"翁卷","text":"树树有佳阴，山蝉不住吟。\n掬来南涧水，清若主人心。\n屋上云飞冷，篱根藓积深。\n留诗在岩壁，明日更相寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59059,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日和刘明远","author":"翁卷","text":"不奈滴檐声，风回昨夜晴。\n一阶春草碧，几片落花轻。\n知分贫堪乐，无营梦亦清。\n看君话幽隐，如我愿逃名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59060,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春雪","author":"翁卷","text":"疑是梨花发，满园惊乍看。\n不能为腊瑞，空自作春寒。\n远遁营巢鹊，深埋吐叶兰。\n从教艳阳晒，流去作波澜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59061,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋日闲居呈赵端行","author":"翁卷","text":"闲居观物化，几叶又飞东。\n清气全归月，寒声半是风。\n病多怜骨瘦，吟苦笑身穷。\n折得邻家菊，还思靖节翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59062,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋居寄西里君","author":"翁卷","text":"每日看山山上立，满山风日又秋来。\n贫家岁计惟收菊，幽径时常不扫苔。\n新得酒方思欲试，旧存吟轴见还开。\n凉天在处清如水，能赋惭无宋玉才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59063,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送人游天台","author":"翁卷","text":"暂游行李少，几日到天台。\n船带落潮发，月从前浦来。\n花源香不断，药地绿成堆。\n莫学他刘阮，经年忘却回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59064,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送于君锡节推","author":"翁卷","text":"历历渡遥程，仙山向赤城。\n同为忆家者，岂不羡君行。\n岁晚梅花白，天寒楚塞清。\n野人诗一首，相送莫言轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59065,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送卢主簿归吴","author":"翁卷","text":"湖波长浩荡，苑绿遍幽奇。\n皆是全吴地，今非昔代时。\n鸱夷无旧舸，泰伯有新祠。\n吟苦曾游客，因君动远思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59066,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送刘成道","author":"翁卷","text":"客中仍送客，羸病若为心。\n沿路万千景，费君多少吟。\n出门梅雨滑，浮棹浙河深。\n莫放旅愁起，闻蝉思旧林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59067,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送吉水包长官","author":"翁卷","text":"不耻身为令，惟存济物心。\n离家春雨足，入境夏苗深。\n吉字水初识，洞岩仙可寻。\n知君修净化，白日只弹琴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59068,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送陈嘉父为彭泽主簿","author":"翁卷","text":"昔时陶令弹琴县，今日君为主簿官。\n地胜不嫌清俸薄，政公还得众人欢。\n江分九派潮常到，岳沓千峰夏亦寒。\n闲客欲游游未得，画成图轴乞予看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59069,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送周子静桂阳教官","author":"翁卷","text":"魁名人共说，直节世间闻。\n远地今崇学，诸生久待君。\n三湘鸿不到，五岭路初分。\n闲日登临作，应题赠屈文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59070,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送姚主簿归龙溪","author":"翁卷","text":"三考今批足，应无愧此心。\n只将零月俸，买得一张琴。\n归处路犹远，到时冬必深。\n邑丞诗极好，闲暇可相寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59071,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送赵明叔明府","author":"翁卷","text":"随行惟一琴，前路足幽寻。\n今夜维舟处，何村隔树林。\n鸿声秋浦冷，雨气海山深。\n若问三年政，知君尽此心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59072,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送赵紫芝为江东从事","author":"翁卷","text":"非惟篇翰奇，吏道更深知。\n山水六朝地，登临三考时。\n泥沙多旧物，风日少全碑。\n正属黄花发，愁闻有别离。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59073,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送赵嗣勋","author":"翁卷","text":"休思孤屿峰，且往看吴中。\n一片太湖色，远涵秋气空。\n藕塘南北棹，芦港去来鸿。\n入幕多僚属，惟君事不同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59074,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送赵嗣勋签书昭庆军幕","author":"翁卷","text":"当时一万言，亲擢自临轩。\n况有从前例，难辞不次恩。\n下峰云带寺，震泽水浮村。\n多少闻名者，争来识状元。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59075,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送徐灵渊永州司理","author":"翁卷","text":"君向零陵日，分携又雪天。\n地遥行几郡，官小度三年。\n兰芷芳条洁，潇湘翠色连。\n从来苦吟思，归赋若多篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59076,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送徐评事赴省试","author":"翁卷","text":"早年通法后，已是立朝身。\n更道明经好，须为擢第人。\n马寒村驿暮，灯暖帝城春。\n花气多时节，高门有贺宾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59077,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送翁应叟","author":"翁卷","text":"逢君亦姓翁，莫即是吾宗。\n远自刺桐里，来看孤屿峰。\n虽云相识晚，宛若故情浓。\n回首秋风路，闽山复几重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59078,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送曹西士宰建昌","author":"翁卷","text":"买得秋风棹，江行不问程。\n谁知书判笔，中有惠慈情。\n旧治川僧说，新衔楚吏迎。\n名山皆在望，应费好诗评。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59079,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送蒋德瞻节推","author":"翁卷","text":"八百里重湖，长涵太古波。\n君山云出少，梦泽雨来多。\n才子今方去，名楼必屡过。\n楚辞休要学，易得怨伤和。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59080,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送薛子舒赴华亭船官","author":"翁卷","text":"君到云间日，应分二陆名。\n县图山色少，井味海潮并。\n剡局三年印，春风半月程。\n野人因买鹤，曾向此中行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59081,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闽中秋思","author":"翁卷","text":"客愁无定迹，几处冒风埃。\n逢得家乡便，凭将信息回。\n海烟蛮树湿，秋雨瘴花开。\n旧日越王国，吾今身再来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59082,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"哭徐山民","author":"翁卷","text":"已是穷侵骨，何期早丧身。\n分明上天意，磨折苦吟人。\n花色连晴昼，莺声在近邻。\n谁怜三尺像，犹带瘦精神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59083,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"哭徐玑","author":"翁卷","text":"前时官上归，感怆失灵晖。\n不料三年后，俱随万化非。\n塔峰长入座，池色自临扉。\n无复乘闲屐，观棋访衲衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59084,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"旅泊","author":"翁卷","text":"几日溪篷下，低垂困水程。\n喜因山县泊，略向岸汀行。\n闻笛生羁思，看松减宦情。\n遥知此夜月，必照故山明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59085,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晓对","author":"翁卷","text":"独对晓来晴，天寒景物清。\n梅花分地落，井气隔帘生。\n曾是吟招隐，何时遂耦耕。\n萧疏头上发，已白二三茎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59086,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"留别吴中诸士友","author":"翁卷","text":"羁游虽不闲，幽思亦相关。\n今日经行处，他宵梦寐间。\n松江云在水，茂苑树成山。\n况复多吟客，令人懒欲还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59087,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"留别南昌诸友","author":"翁卷","text":"衰颜怕被青铜见，病骨堪同瘦鹤群。\n出久并荒幽径菊，未归长忆满山云。\n春风岂识吟人恨，夜雨频于客舍闻。\n万柳百花好时节，别君愁绪乱纷纷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59088,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"能仁寺","author":"翁卷","text":"芙蓉峰入天，寺与此峰连。\n得见是冬月，要来从昔年。\n寒潭盛塔影，古木带厨烟。\n偶值高僧出，禅床坐默然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59089,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偶题","author":"翁卷","text":"绿树何稠叠，清风稍羡馀。\n枕萦云片片，帘透雨疏疏。\n脩笕通泉壑，残碑出野锄。\n丘陵知几变，耕稼学陶渔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59090,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宿寺","author":"翁卷","text":"一宿此禅宫，身同落发翁。\n深窗难得月，老屋易生风。\n灯冷纱光淡，香残印篆空。\n独怜吟思苦，妨却梦西东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59091,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宿邬子寨下","author":"翁卷","text":"已谒龙君庙，明朝早过湖。\n傍沙船尽泊，经火地多枯。\n秋至昏星易，空长楚月孤。\n萧条村戍内，更点有如无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59092,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄山友徐灵晖","author":"翁卷","text":"若非殊俗好，那肯爱幽居。\n深径无来客，空山自读书。\n树蝉经雨少，门柳望秋疏。\n相忆何时去，闲园共尔锄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59093,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄从善上人","author":"翁卷","text":"数载不相见，师应长闭关。\n香烟前代寺，秋色五峰山。\n棋进僧谁敌，琴馀鹤共閒。\n几时重过我，吟话此林间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59094,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄永州徐三掾曹","author":"翁卷","text":"闻说居官处，千峰近九疑。\n合流皆楚水，高石半唐碑。\n香草寒犹绿，清猿夜更悲。\n其中多隐者，君去得逢谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59095,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄张直翁","author":"翁卷","text":"若向筠州去，惟消一日宽。\n又无他事阻，自欲访君难。\n露下秋山洁，鸿飞楚水寒。\n近诗凡几首，专待写来看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59096,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄沈洞主","author":"翁卷","text":"想当清夜醮，带月叩仙钟。\n指上雷霆诀，庵前虎豹踪。\n药收阳地草，薪采故枝松。\n拟即寻师去，茅峰叠几重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59097,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄远人","author":"翁卷","text":"秋气日凄清，秋衣纫未成。\n在家犹不乐，行路若为情。\n几处好山色，暮天群雁声。\n分明相忆梦，夜夜出江城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59098,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄赵灵秀","author":"翁卷","text":"千山落叶深，高树不藏禽。\n游子在何处，故人劳此心。\n闲灯妨远梦，寒雨乱愁吟。\n僧奭曾相约，花时共一寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59099,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄葛天民","author":"翁卷","text":"常日已清癯，那兼疾未除。\n传来五字好，吟了半年馀。\n铁柱仙人观，梅花处士庐。\n江湖正相隔，岁晚更愁予。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59100,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄筠州张录事","author":"翁卷","text":"每到友朋相会地，未尝一日不思君。\n小诗曾托乡僧寄，善政因逢故客闻。\n山上仙踪丹鼎在，郭边溪色市桥分。\n公馀若起吟游兴，游处多应见白云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59101,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"悼雪庵禅师","author":"翁卷","text":"悟了无生妙，归空若故乡。\n竹房三尺像，石榻一炉香。\n坏衲犹悬树，新松忽过墙。\n僧中留不得，几日为凄凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59102,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚秋送徐玑赴龙溪丞因过泉南旧里","author":"翁卷","text":"卷中风雅句，名匠亦难如。\n远邑亲微禄，他乡过旧庐。\n程途多见菊，行李半担书。\n未信文明代，无人荐子虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59103,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梦回","author":"翁卷","text":"一枕庄生梦，回来日未衙。\n自煎砂井水，更煮岳僧茶。\n宿雨消花气，惊雷长荻芽。\n故山沧海角，遥念在春华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59104,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜蒋德瞻还里","author":"翁卷","text":"为官三载馀，所得是清虚。\n学就金丹法，修成玉检书。\n乍归人客满，久出竹林疏。\n怪我吟髭白，相欢相见初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59105,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寓南昌僧舍","author":"翁卷","text":"突兀禅宫何代馀，闲同衲客听钟鱼。\n身如野鹤栖无定，愁似顽藤挽不除。\n旧隐定多新长竹，远交全乏近来书。\n炉香椀茗晴窗下，数轴楞伽屡展舒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59106,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"道上人房老梅","author":"翁卷","text":"孤高不受埃，老怪昔谁栽。\n仙魄乘槎去，龙身带雪来。\n数枝寒照水，一点净沾苔。\n头白狂诗客，花时屡往回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59107,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"福州黄檗寺","author":"翁卷","text":"天下两黄檗，此中山是真。\n碑看前代刻，僧值故乡人。\n一宿禅房雨，经时客路尘。\n将行更瞻礼，十二祖师身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59108,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"酬杜子野","author":"翁卷","text":"千葩开欲休，独客思悠悠。\n江水能相隔，春风不共游。\n数篇诗未答，一幅信重收。\n多少怀君意，莺声高树头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59109,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鲍使君闲居","author":"翁卷","text":"吟楼影在湖波上，吟景长从望处生。\n叠石拟成幽嶂色，种松移得远滩声。\n多谙药品曾因病，却著荷衣欲避名。\n闻说近来心更静，案头惟有一琴横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59110,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题王法师房","author":"翁卷","text":"应有列仙至，观当灵洞安。\n月萝春长蔓，风竹暮生寒。\n印下鬼神役，鼎交龙虎欢。\n寻常应缘外，多把异书看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59111,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题江心寺","author":"翁卷","text":"名与金山并，僧言景更幽。\n寺无双屿近，地占一江浮。\n曾是龙为宅，还疑蜃吐楼。\n他乡远归者，望此得停舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59112,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题竹","author":"翁卷","text":"偶种得成阴，翛翛过别林。\n月寒双鸽睡，风静一蝉吟。\n映地添苔碧，临池觉水深。\n贫居来客少，赖尔慰人心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59113,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题武义赵提干林亭","author":"翁卷","text":"武陵诸胜状，如列在檐前。\n一郭楼台日，数村桑柘烟。\n鸟啼春满谷，秧绿水平田。\n中有渔樵影，吾诗咏不全。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59114,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题常州独孤桧","author":"翁卷","text":"此桧何时种，相传是独孤。\n年深成古物，名重入州图。\n老节坚难蠹，皴皮裂似枯。\n托根列帝庙，应不虑樵夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59115,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠九华李丹士","author":"翁卷","text":"行遍东南地，曾看江水源。\n袖藏勾漏药，身是老君孙。\n去住云相似，枯荣事不论。\n九华峰最碧，相对旧柴门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59116,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠不食姑","author":"翁卷","text":"嫁时衣尚著，忽自欲通仙。\n终日常持咒，经年只饮泉。\n瘦形非是病，怪语却如颠。\n金母还知尔，招邀归洞天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59117,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠东庵约公","author":"翁卷","text":"问今年八十，退院久清闲。\n白雪髭慵剃，青松户早关。\n取泉来煮茗，与客话游山。\n弟子何僧是，缁衣多往还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59118,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠刘高士","author":"翁卷","text":"灵境康庐上，师曾此处家。\n今游在京国，谁为管烟霞。\n觅句行逢鹤，持经坐对花。\n笑予非酒户，相劝满瓯茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59119,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠孙季蕃","author":"翁卷","text":"立谈飞絮中，相遇在吴宫。\n以我为生拙，怜君失计同。\n醉酣花落月，吟苦竹摇风。\n自作庐山记，幽奇欲遍穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59120,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠张亦","author":"翁卷","text":"兴兵又罢兵，策士耻无名。\n闲见秋风起，犹生万里情。\n借窗临水歇，沽酒对花倾。\n示我新诗卷，如编众玉成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59121,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠陈管辖","author":"翁卷","text":"一拂清风一袖云，紫阳容貌鹤精神。\n诗因道进言辞别，丹得师传火候真。\n庐岳峰前吟瀑布，浑仪图上礼星辰。\n我来暂作闲人歇，多谢仙翁相访频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59122,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠普觉院道上人","author":"翁卷","text":"病来形转瘦，老忘出家年。\n对客多无语，贪闲懒赴缘。\n一斋能过日，几世已修禅。\n住傍观音阁，门前有井泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59123,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠葛天民","author":"翁卷","text":"燕本昔如此，清名千载垂。\n谁将囊米施，自拾束薪炊。\n柳影连山阁，湖波浸竹篱。\n朝昏无别事，只是欲吟诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59124,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]