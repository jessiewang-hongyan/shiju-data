[{"title":"自湘赴广道间杂咏 永州晓行","author":"李曾伯","text":"推枕月微明，登车才五更。\n啼破千山暝，枝禽三两声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63604,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自湘赴广道间杂咏 李花","author":"李曾伯","text":"昨夜孤村宿，春深人寂寥。\n庭前一株李，为我缟中宵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63605,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自湘赴广道间杂咏 桃李","author":"李曾伯","text":"仙李明炫夜，夭桃艳当春。\n便将花作主，聘与玉为人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63606,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自湘赴广道间杂咏 湘竹","author":"李曾伯","text":"纹竹起嫔虞，因怀二女居。\n君泪夫人泪，思欤抑怨欤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63607,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自湘赴广道间杂咏 蟠松","author":"李曾伯","text":"红紫竞芳丛，中蟠一古松。\n春风自来去，吹不动苍龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63608,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟过霅川 其二","author":"李曾伯","text":"水绕眉峰碧一湾，荻花枫叶暮生寒。\n呼船催向渔村宿，要买鲜鲈荐晚餐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63609,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟过霅川 其一","author":"李曾伯","text":"一簇楼台锁翠烟，雨疏溪阔晚秋天。\n西风吹老芙蓉院，两两鸥凫傍水眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63610,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"访阆州读书岩","author":"李曾伯","text":"从来廊庙出山林，师友相资好弟兄。\n料得至今风雨夜，山神犹记读书声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63611,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过邻水道间","author":"李曾伯","text":"竹新得雨笋争绿，蕉不知霜花自红。\n时候江南二三月，调胹元气此杯中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63612,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过黄州和共山高寒韵","author":"李曾伯","text":"千古江山一览间，老瞒于此胆曾寒。\n凭高要起乘风志，肯把闲情作鸭栏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63613,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"阮梅峰举似题高沙郡圃醉醒亭绝句因继元韵并简萧使君 其三","author":"李曾伯","text":"所寓皆同一旅亭，纷纷万事细如萍。\n醉翁能解邦人乐，时一中之勿太醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63614,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"阮梅峰举似题高沙郡圃醉醒亭绝句因继元韵并简萧使君 其二","author":"李曾伯","text":"杨柳依依拂短亭，看看飞絮又成萍。\n老来世味都尝遍，不待邻鸡唤梦醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63615,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"阮梅峰举似题高沙郡圃醉醒亭绝句因继元韵并简萧使君 其一","author":"李曾伯","text":"客有谈君制小亭，旋栽轩竹荫池萍。\n应怜春色浓于酒，醉得园花睡不醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63616,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"邻水寺有竹数百竿中有孤梅可爱","author":"李曾伯","text":"萧萧劲竹古君子，凛凛孤梅节妇人。\n不作东风蝴蝶梦，短篱流水一家春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63617,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和尤帅长赠郑通庵韵 其二","author":"李曾伯","text":"此别何年此会重，翁无占我我占翁。\n我官翁卜无相远，闻早归欤计则同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63618,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和尤帅长赠郑通庵韵 其一","author":"李曾伯","text":"生涯休问粟储瓶，有酒盈樽不用醒。\n已分我生箕斗直，车船奚用命奴星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63619,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和水竹梅烛韵 其二","author":"李曾伯","text":"谁将花烛聘东风，与海棠时恨不同。\n意已不求真会合，何妨一白对千红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63620,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和水竹梅烛韵 其一","author":"李曾伯","text":"南枝肯领众芳随，一点冠名在处知。\n摸索暗中香自别，底须绛蜡逼轻肌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63621,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和王潜斋韵送闻人松庵 其二","author":"李曾伯","text":"子之为术我为官，以易占之火在山。\n同在双湖湖上住，大家携手故乡还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63622,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和王潜斋韵送闻人松庵 其一","author":"李曾伯","text":"田园芜矣好东归，今昨从渠较是非。\n荷子远来无所问，江湖雅志莫相违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63623,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘制参遗梅 其二","author":"李曾伯","text":"感君寄我一枝春，雨虐风饕苦不仁。\n羞得玉奴浑不放，含香犹待浣溪人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63624,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘制参遗梅 其一","author":"李曾伯","text":"群玉峰头惯见春，此花常寓雪霜仁。\n东风又促孤山去，应向香边念故人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63625,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘清叔襄阳草庐韵 其二","author":"李曾伯","text":"万壑长松几岁寒，老龙曾向此中蟠。\n而今肯为苍生起，何止编方蜀顾宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63626,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘清叔襄阳草庐韵 其一","author":"李曾伯","text":"白马盟存矢弗寒，玩其肆矣肯泥蟠。\n风云未合星先陨，输与江东日月宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63627,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和江陵阙干风雨问讯虚舟韵 其二","author":"李曾伯","text":"无人载酒到联辔，有客携琴午扣扉。\n却羡渚宫鱼为乐，菰蒲深处日相依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63628,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和江陵阙干风雨问讯虚舟韵 其一","author":"李曾伯","text":"使君帘幕锁香篝，方把千金制一裘。\n好是孤灯风雨梦，夜深直度野人舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63629,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和袁提刑咏雪 其二","author":"李曾伯","text":"剪出瑶英顷刻飞，欠加天女锦云机。\n虚皇瑞报调羹信，添得梅花略似肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63630,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和袁提刑咏雪 其一","author":"李曾伯","text":"羽卫鬖髿万玉然，元从绣斧下青天。\n分明要与荆人看，苍桧擎枝一节坚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63631,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和傅山父小园十咏 其五","author":"李曾伯","text":"苍苔迹在堂无燕，绿水痕生沼自鱼。\n回首钓游徒感慨，何时复古喜而书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63632,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和傅山父小园十咏 其九","author":"李曾伯","text":"剩种秫粳供靖节，要餐杞菊学天随。\n不知底事池塘梦，犹到边城月暗时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63633,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和傅山父小园十咏 其八","author":"李曾伯","text":"宜琴宜弈尤宜酒，种竹种梅仍种莲。\n意得无时不堪适，可人不只是荷天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63634,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和傅山父小园十咏 其七","author":"李曾伯","text":"一室扫除才斗许，几番醉梦与梅清。\n雕戈翠节成何事，纸帐蒲团了此生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63635,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和傅山父小园十咏 其六","author":"李曾伯","text":"招来暇日频呼酒，买得清风不用金。\n月姊水妃无老态，天光野色有遗音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63636,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和傅山父小园十咏 其一","author":"李曾伯","text":"剖破藩篱出一头，要追岩壑老人游。\n知他栽得花和竹，髣髴旧时风度不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63637,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和傅山父小园十咏 其十","author":"李曾伯","text":"蜡英要占菊天破，玉树须乘梅雨培。\n金粟如来还出世，清香不许别花开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63638,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和傅山父小园十咏 其四","author":"李曾伯","text":"竹边闻鹤思高举，松下观禽觉倦飞。\n幸有故书千帙在，呼儿共读嗣前徽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63639,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和傅山父小园十咏 其二","author":"李曾伯","text":"乔木岂能忘故国，结茅聊复纪新亭。\n此君玉立傍无友，犹有幽禽静可听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63640,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和傅山父小园十咏 其三","author":"李曾伯","text":"著我数椽浮翠碧，借公一水漾琉璃。\n心闲境乐镇长好，拈起风光总是诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63641,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和傅山父红梅韵 其二","author":"李曾伯","text":"节士耻随时世妆，若为妩媚著春裳。\n何如清淡甘天分，莫与儿曹较色香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63642,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和傅山父红梅韵 其一","author":"李曾伯","text":"独立千林压众葩，正由风骨傲烟霞。\n谁教群玉峰头客，也染红裙一幅纱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63643,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜坐用韵简刘朔斋洪云岩 其一","author":"李曾伯","text":"一线春从地脉回，工夫先是到江梅。\n雪边竟觉丰标别，曾向玉堂堂上开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63644,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜坐用韵简刘朔斋洪云岩 其二","author":"李曾伯","text":"风撼松梢夜作声，月昏水浅岁将更。\n江头不用嫌凄冷，滕六分明玉汝成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63645,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"定花阻风 其五","author":"李曾伯","text":"边湖六六片时程，况可篮舆度岸行。\n西舫东船从此办，任他风浪与阴晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63646,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"定花阻风 其四","author":"李曾伯","text":"夜色昏昏带远烟，谁家灯火待归船。\n小迟月上风须息，且伴白鸥今夕眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63647,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"定花阻风 其三","author":"李曾伯","text":"绿柳桥头旧酒炉，几番舣棹劳篙夫。\n恍疑风撤青帘去，敲尽荆扉闭不酤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63648,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"定花阻风 其二","author":"李曾伯","text":"准拟新烟定到家，可怜漂泊对风沙。\n见他红雨飞篱落，忆杀小园桃杏花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63649,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"定花阻风 其一","author":"李曾伯","text":"客缆相衔系柳边，不禁雪浪苦粘天。\n寻常溪口鱼虾贱，今度船留倍索钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63650,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宜兴山房十首 其十","author":"李曾伯","text":"稚子敲门唤起休，金乌早照屋山头。\n饭馀欲看蟠松去，可是今朝作雨不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63651,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宜兴山房十首 其九","author":"李曾伯","text":"俄顷钟声到枕边，朦胧晓色试霜天。\n披衣欲起浑无事，赢得平明一觉眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63652,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宜兴山房十首 其八","author":"李曾伯","text":"薄薄新寒透被轻，醒来窗隙弄微明。\n山中不用梅花角，自有枝禽报五更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63653,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宜兴山房十首 其七","author":"李曾伯","text":"四壁寒蛩作苦吟，唤回旅梦约三更。\n不知身在禅房宿，误听松风做雨声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63654,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宜兴山房十首 其六","author":"李曾伯","text":"月暗山空夜倍长，清谈消遣睡毋忙。\n山中新酒幸堪饮，何惜一杯相共尝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63655,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宜兴山房十首 其五","author":"李曾伯","text":"烧罢天香月半昏，掩扃才了便呼灯。\n窗前诵彻渊明赋，却傍禅床听葛藤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63656,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宜兴山房十首 其四","author":"李曾伯","text":"薄霭垂垂欲暮时，渐生霜气著征衣。\n山深不见牛羊下，惟有樵人荷担归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63657,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宜兴山房十首 其三","author":"李曾伯","text":"檐影亭亭日正中，莓苔不扫绝尘踪。\n闭门相共蒲团坐，看读华严一卷终。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63658,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宜兴山房十首 其二","author":"李曾伯","text":"斋罢鸡声转午天，地虚人寂境萧然。\n两三衲子自来去，时取茶芽煮涧泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63659,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宜兴山房十首 其一","author":"李曾伯","text":"晓起炉烟一缕清，梵音缭绕槛轩行。\n须臾日上松梢了，又听斋钟相应鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63660,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"茅山玉晨观和壁间韵","author":"李曾伯","text":"天风吹我上高峰，上到山头日未中。\n便可高眠莫归去，人间易得鬓成童。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63661,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宣公祠 其一","author":"李曾伯","text":"相唐德丛复兴隆，仁义条陈百奏中。\n正欲谏君今别驾，延龄更不念孤忠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63662,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宣公祠 其二","author":"李曾伯","text":"双湖真泽国，千载相公祠。\n中有钓鱼者，问之俱不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63663,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"洪云岩有和谢之 其一","author":"李曾伯","text":"春近衡峰雁又回，老怀休忆故山梅。\n花期自是江南早，早晚湘南也解开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63664,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"洪云岩有和谢之 其二","author":"李曾伯","text":"听彻虚檐蔌蔌声，铁衣冰骨记身更。\n如今休忆鹅池路，纵竭龙钟做不成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63665,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"禹柏 其二","author":"李曾伯","text":"星岳钟为一木奇，霜皮剥落类骈胝。\n生从洚水初平日，阅尽青山无老时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63666,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重庆阃治十咏 其三 一廉堂","author":"李曾伯","text":"九重怀井络，一字侈奎章。\n来者思冰檗，其毋顷刻忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63667,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重庆阃治十咏 其十 六角亭","author":"李曾伯","text":"四维风折势，一片雪同规。\n花竹丛间著，开樽瀹茗宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63668,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重庆阃治十咏 其五 生意堂","author":"李曾伯","text":"硕果食难尽，其机运不停。\n岷峨几霜雪，依旧草青青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63669,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重庆阃治十咏 其六 龙虎屏","author":"李曾伯","text":"不逐风云去，盍求山泽安。\n祗怜当笔者，空作画屏看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63670,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重庆阃治十咏 其一 华明堂","author":"李曾伯","text":"要识披图际，还同枉驾时。\n未应成否论，汉德有兴衰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63671,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重庆阃治十咏 其八 吟啸","author":"李曾伯","text":"坐却并州骑，行思楚泽渔。\n斯亭著斯客，斯意竟何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63672,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重庆阃治十咏 其二 尊安堂","author":"李曾伯","text":"尧舜君民学，吾儒共讲磨。\n一毫如有愧，其若此堂何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63673,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重庆阃治十咏 其四 集思堂","author":"李曾伯","text":"先以一诚格，斯能众正招。\n要来堂下蔑，勿徇帐中超。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63674,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重庆阃治十咏 其九 横舟","author":"李曾伯","text":"不早浮槎去，焉能罔水行。\n叩舷谁共语，载不尽高情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63675,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪夜不寐偶成 其二","author":"李曾伯","text":"窗外风声又雪声，初更展转到三更。\n枕边自作推敲态，吟得诗成梦亦成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63676,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湘潭道间农家 其一","author":"李曾伯","text":"三两人家松柏林，翁垂霜发媪钗荆。\n儿耕妇织输官了，山茗村醪乐此生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63677,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湘潭道间农家 其二","author":"李曾伯","text":"竹外流泉绕屋鸣，田头有水不忧晴。\n春来岂问芳菲事，只办犁锄要早耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63678,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登寿沙楼和抑斋韵 其三","author":"李曾伯","text":"江湖已老犹为吏，心境俱清即是仙。\n聊挹层峦荐湘菊，一时人在小壶天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63679,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登寿沙楼和抑斋韵 其一","author":"李曾伯","text":"黄叶满林霜尚轻，蓼花披岸水犹生。\n坐邀一段潇湘胜，元出钧陶手作成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63680,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登寿沙楼和抑斋韵 其二","author":"李曾伯","text":"白鹭洲边多古寺，翠微阴里尽人烟。\n当时曾对掀髯笑，今问老龙何处眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63681,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]