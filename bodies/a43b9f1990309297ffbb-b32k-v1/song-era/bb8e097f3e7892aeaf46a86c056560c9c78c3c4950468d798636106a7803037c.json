[{"title":"三高祠","author":"姜夔","text":"不贪名爵伐功劳，勇退深虞祸患遭。\n甫里閒居耕钓乐，范张高处陆犹高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25197,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和王秘书游水乐洞","author":"姜夔","text":"自是瀛洲客，还因野趣来。\n解衣吟寂寞，携酒上崔嵬。\n石洞山山秀，栀花树树开。\n只应岩下水，相送上船回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25198,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寺中","author":"姜夔","text":"幸自不居城，西风觉又生。\n空山多雨气，废寺少人声。\n发为忧时白，吟因入夜清。\n推窗问天色，犹有佛灯明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25199,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"有送","author":"姜夔","text":"怜君归橐路迢迢，到得茅斋转寂寥。\n应叹药栏经雨烂，土肥抽尽缩砂苗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25200,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"于越亭","author":"姜夔","text":"松尾飕飕石浪寒，胡啼番曲转声酸。\n人间无此春风手，应是江妃夜夜弹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25201,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百三十三首 其七十二","author":"释居简","text":"日可冷，月可热，众魔不能坏真说。\n且道如何是真说，三人證龟，定不是鳖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25202,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百三十三首 其一○四","author":"释居简","text":"诸佛不出世，四十九年说。\n祖师不西来，少林有妙诀。\n是假易除，是真难灭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25203,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春雪","author":"陈洪","text":"光映妆楼月，花承歌扇风。\n欲妒梅将柳，故落早春中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25204,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"郊坛斋宫七首 其六","author":"任希夷","text":"帝籍傍连茧馆桑，禁林乔木昼阴凉。\n却从射殿临江阁，中有通衢夹苑墙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25205,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赤壁观泉","author":"朱庆朝","text":"渺渺长流自古今，凭高凝眸几回深。\n欲知最上源头处，只在工夫着意寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25206,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"应试渡江","author":"朱庆朝","text":"旭日澄江新气齐，登舟直上武林西。\n桂花香发正秋月，隔岸渔歌相唤啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25207,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句","author":"湖州士子","text":"可怜戴工部，独树不成林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25208,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"县郭新居人家","author":"曹彦约","text":"苟简诛茅胜野盘，托身城郭爱平安。\n五更人语惊鸡犬，壁漏檐疏共一寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25209,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闻莺","author":"危稹","text":"天上金衣侣，还能贶草莱。\n风流晋王谢，言语汉邹枚。\n公等久安在，今从何处来。\n山禽正嘈杂，慰我日徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25210,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"司马温公帝魏","author":"金朋说","text":"春秋大义经中史，司马当年失董狐。\n昭烈本为炎汉后，何书僣国列于吴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25211,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"郊行即事","author":"裘万顷","text":"病来多日废将迎，试命巾车作此行。\n稻实满田秋事了，松阴堆径午凉生。\n数山见我争倾盖，一水邀人请濯缨。\n却忆吾庐南浦外，何时得与白鸥盟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25212,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"黄陵题咏二首 其一","author":"李壁","text":"南云哭重华，水死悲二女。\n天边九点黛，白骨迷处所。\n朦胧波上瑟，清夜降北渚。\n万古一双魂，飘飘在烟雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25213,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂十八首 其十","author":"释如净","text":"今朝五月正清和，榴花诗句入禅那。\n浓绿万枝红一点，动人春色不须多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25214,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自赞 其二","author":"释如净","text":"突出娑婆世界，一枚真个村头。\n行脚都无用处，推倒只好做牛。\n钉双角，插条尾，绿杨芳草春风里。\n可杀有力会耕田，卖与阎王还饭钱。\n不然掣电几先吃，痛拳无明业识幢。\n竖起漫天黑，一句不相当。\n拳头飞霹雳，咦，老婆心切血滴滴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25215,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古五首 其一","author":"释如净","text":"无忧树下浴婴孩，清晓蔷薇带露开。\n转过衲僧相见处，后槽驴马出胞胎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25216,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古五首 其二","author":"释如净","text":"六年落草野狐精，跳出浑身是葛藤。\n打失眼睛无处觅，诳人刚道悟明星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25217,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春昼","author":"韩淲","text":"青春白昼永，一日如两日。\n平心得淑景，佳思入诗律。\n湖山气姿媚，海汐声荡潏。\n回旋且回旋，杨花满书室。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25218,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春阴","author":"韩淲","text":"春雨发山溜，花事回绿阴。\n东家举杯酒，为我成芳斟。\n蝶绕莺流音，轻云晚沉沉。\n挥手惜素心，入林惊未深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25219,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"苦阴","author":"韩淲","text":"梅熟麦秀时，浓阴多转晴。\n础润雷掣电，沟壑须臾平。\n清风四起处，郁蒸或不轻。\n今兹冷气深，经旬压檐声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25220,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"正月二十七日","author":"韩淲","text":"晨兴启蓬门，绿树有啼莺。\n山风远远来，墟烟低低横。\n水写蔽芾影，岸束湍濑声。\n春事曾几何，孤花尚含情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25221,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春晚","author":"韩淲","text":"馀霭净麦岐，流晖转兰皋。\n燕垒落梁尘，渔舠激埼涛。\n芳斟竞飞斝，绮思归摇毫。\n良燕气清和，物色如春韶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25222,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春分前一日 其一","author":"韩淲","text":"沉沉听雨坐，瓶花养香梅。\n鼻观得此供，息定本气回。\n春阳已大壮，阴云尚难开。\n小窗千叶黄，眼尘一清哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25223,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春分前一日 其二","author":"韩淲","text":"青青叶中兰，庭幽有馀芳。\n新葩明轻茎，知我春昼长。\n安得滋九畹，命骚与争光。\n风泛不须纫，深林宜永藏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25224,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春分前一日 其三","author":"韩淲","text":"细雨桃树枝，依流欲舒红。\n水深相发挥，倍觉多春工。\n从渠武陵源，不与人迹通。\n冯生天地间，我汝俱樊笼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25225,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春分前一日 其四","author":"韩淲","text":"柳已绿可爱，溪风更摇之。\n人居春气中，安知物熙熙。\n常年二三月，醉眼不自持。\n摩挲此瞢腾，老去今其时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25226,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春分前一日 其五","author":"韩淲","text":"草色老春荠，气数戚已分。\n流光生鬓丝，日暮江东云。\n故交本不多，零落那忍闻。\n墙阴雨凄凄，夕阳何时熏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25227,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"避暑","author":"韩淲","text":"亭午暑未凉，竹阴访泉石。\n泉源彻底清，石色半痕碧。\n幽处鸟声流，闲中人意适。\n风微一幅巾，林深转虚寂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25228,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋意","author":"韩淲","text":"秋意不堪老，宦情惟自悲。\n萧萧风雨中，吟哦漫寻诗。\n古来骚雅士，常恐归计迟。\n此事不难办，无语王谢儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25229,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"二十九日寒食","author":"韩淲","text":"花间雨未乾，强饮食犹寒。\n山涧得名流，岂曰俗相看。\n晋文绵上田，往事今鼻酸。\n江南好风景，且取文酒欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25230,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"清明","author":"韩淲","text":"既喜寒食晴，复值清明雨。\n山空洗雨花，零落蔽泥土。\n脩林发新叶，青绿粲莫数。\n虽云风日异，景物俱可睹。\n犁锄动远村，愈觉爱农圃。\n形迹欣得闲，持醪醉为主。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25231,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上饶禊饮","author":"韩淲","text":"流芳报花信，畅叙记东晋。\n何知胸崔嵬，未觉景急峻。\n泛觞河阳春，庶且雅俗镇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25232,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"九日钱塘江","author":"韩淲","text":"九日风凄紧，扁舟发龛山。\n龛山正自佳，况复江水间。\n吴歌动两桨，溯洄过沧湾。\n虽无菊可把，矫首云斑斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25233,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"九日次前韵答赋德久","author":"韩淲","text":"客里素秋节，谁复同襟期。\n黄花虽满眼，何意采摘之。\n古今旷达人，把此颜为怡。\n谓可制颓龄，属兴深于兹。\n渊明南山下，放浪东篱枝。\n白衣纵莫至，自惜草木姿。\n斯辰天阴阴，云深翳晴曦。\n更想杜陵老，抱病登台时。\n我欲事啸歌，舒忧以娱悲。\n悠悠时序心，摇毫漫致词。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25234,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"九日次陶韵","author":"韩淲","text":"草木易黄落，倏然时序交。\n岂无素心人，松柏不改凋。\n今日我重九，惘然风度高。\n起寻得良觌，南雁将横霄。\n夸毗信谁子，短世亦已劳。\n旱暵乃天运，惔焚禾谷焦。\n一歌百世苏，重歌千载陶。\n唱予而和汝，其雨复崇朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25235,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"九日 其一","author":"韩淲","text":"悠悠两高峰，眇眇见落木。\n病馀老身倦，登楼谩伸蹜。\n兹晨有何味，酒面欲汎菊。\n常年得重九，高兴必徵逐。\n谁知懒出门，搔发鬓已秃。\n子云虽识字，君平唯卖卜。\n坐久风颇怒，新霜夜来肃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25236,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"九日 其二","author":"韩淲","text":"野色荒荒白，岚光隐隐青。\n家乡未千里，客路复长亭。\n绝景诗难状，多愁酒易醒。\n西风搅黄叶，兴寄托鸿冥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25237,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"除夕前两日示秉","author":"韩淲","text":"雪风吹溪云，昼刻催岁律。\n欢传颂椒花，饯岁欲何出。\n举头荒山庐，冰涧溜凄瑟。\n两鬓已颠童，种种不满栉。\n题舆得斯文，爱士欲黼黻。\n团呼一樽酒，清言了人物。\n四座各尽情，烛跋屡剪拂。\n如愚于席间，踸踔倍勃窣。\n授简而供令，古兴亦岂不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25238,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"二十五日","author":"韩淲","text":"焚香得深居，清风养幽抱。\n杜鹃来何迟，鸿雁去常早。\n微澜响沟流，积润滑磴道。\n绵绵百草长，春风雨中老。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25239,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"三月八日 其一","author":"韩淲","text":"昼闲春婉婉，草树转花事。\n人谁用吾情，我自顺吾意。\n江山不徒吟，城郭亦可醉。\n阴阴起晴风，相赏岂云易。\n方斋既虚清，山堂亦深翠。\n来燕翩翩归，啼鹃眇眇至。\n时物付芳华，所惜者风谊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25240,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"三月八日 其二","author":"韩淲","text":"春浓自徘徊，我歌亦其事。\n峥嵘眼中人，磊磈言外意。\n何哉非达也，拂石醒小醉。\n棋枰随圆方，目击胜败易。\n冷斋芹泮地，坐久湿空翠。\n了无官曹尘，所以野老至。\n汎乎不系舟，未数长沙谊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25241,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"三月八日 其三","author":"韩淲","text":"所贵知者希，初不与人事。\n飘风击坠瓦，彼岂有本意。\n百尔我所思，岂必待熟醉。\n烈士徒殉名，归洁似图易。\n鳣鲸困蝼蚁，兰苕巢翡翠。\n广心之昭融，巽语之极至。\n何若于燕閒，相与谈仁谊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25242,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"初九日","author":"韩淲","text":"山空草木长，明日欲立夏。\n俄顷一蝉鸣，节物便相亚。\n平心阅四时，益觉运而化。\n残杯了清昼，新香度深夜。\n风雨阴阳间，悠悠懒悲咤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25243,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十月初十日","author":"韩淲","text":"南窗午逾暖，日气烘人衣。\n徒有苍蝇声，甚无鸿雁飞。\n老身漫自伸，老眼其畴依。\n摩挲根尘间，瓦沟霜已晞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25244,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"晦日即事示同游","author":"韩淲","text":"閒居谁与娱，寂历满黄叶。\n冬晴日气午，乘暖得步屧。\n儿仆为游园，俛仰才自惬。\n亲朋忽过我，少坐情意浃。\n烹茶味既爽，穿林景逾接。\n纵游星居寺，僧房颇稠叠。\n随流觉路熟，更见沙觜涉。\n道院出香鼎，春山弄书箧。\n留连一两杯，设饭羹用筴。\n亭虚列峰峦，溪净映城堞。\n跻攀重阁晚，览句费目睫。\n归欤语河梁，分手兴未帖。\n吾衰子俱壮，岁莫何术业。\n从来评道德，亦必在耕猎。\n好恶空纷拿，利害漫慑怯。\n郡国有惠养，朝家有调燮。\n孙膑为断足，范雎至折胁。\n尚能变轩昂，未信祇萎苶。\n庄知冥灵春，佛说恶浊劫。\n无视雾气蒸，飞鸢堕跕跕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25245,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十二月二十八日","author":"韩淲","text":"寂寂园中林，脉脉林下泉。\n萧闲岁云暮，老身欲何言。\n不畏日月驶，但笑霜雪繁。\n人生本非恶，往往迷宿愆。\n昏明夜复旦，寒云满空山。\n瓶储粟粒罄，交旧无往还。\n尘埃岂不知，冠緌易牵缠。\n五鼎食与烹，寸景能几年。\n心境互生灭，雅俗相移迁。\n危坐明檠灯，炉香更清然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25246,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"日长","author":"韩淲","text":"日长林影聚，早暮气弥清。\n既自罕人迹，而犹闻市声。\n物生各有态，境异俱忘情。\n门前酒谁来，吾其撞馀醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25247,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"落日","author":"韩淲","text":"落日青松间，疏明山翠寒。\n谁于元气中，弄此赤玉丸。\n我心本清阳，阴浊不可干。\n虞渊下可取，快饮杯勿乾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25248,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"喜晴","author":"韩淲","text":"积日困秋雨，晓起天开明。\n披轩纳晴光，树影当阶横。\n遥闻玄蝉急，忽见翠羽轻。\n整衣聚足坐，似觉天籁清。\n身形百年尔，衣食苦强营。\n运化有理道，超然得此生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25249,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"晚晴","author":"韩淲","text":"两年元日阴，今年元日晴。\n微霜起清寒，人物多欢声。\n行都占江海，鱼盐易经营。\n何时复三京，万世开太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25250,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"掩关月色满窗宴坐久之","author":"韩淲","text":"云窗月当午，小醉人未眠。\n儿童鼻鼾雷，听息方绵绵。\n万籁一以虚，性地开其天。\n入林山自深，金涧通瑶泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25251,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"对月","author":"韩淲","text":"璇霄荡凉飔，静夜却团扇。\n幽人醉未醒，月色窗户转。\n起舞步高寒，借我蟾宫便。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25252,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十六夜看月","author":"韩淲","text":"夜久群动息，巡檐尚何观。\n庭空叶忽坠，琤若摧琅玕。\n芒寒星彩动，霜气尤瀰漫。\n谁知太虚中，运此宝月团。\n须臾一雁叫，飞下溪流滩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25253,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"月过林端清甚","author":"韩淲","text":"月出双树间，营魄何流光。\n初弦还当午，净极涵莽苍。\n溪虚响城角，露重天欲霜。\n送客出篱门，共立古道长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25254,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"玉溪楼看月","author":"韩淲","text":"山晴夜自明，草树遥可瞩。\n楼头春已非，尚有月如玉。\n胡为乎来哉，可谓万事足。\n沟流杂蛙黾，信阅人代速。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25255,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夏夜玩月","author":"韩淲","text":"夜气生微凉，山空步明月。\n飞光入人家，流影到林樾。\n零零白露滴，冉冉清思发。\n乘云度罡风，天上有宫阙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25256,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"方斋启窗见月","author":"韩淲","text":"我岂不解饮，风轩乘月开。\n细细春酌动，徐徐秋兴来。\n俄而弄清影，自尔却氛埃。\n谁信城市居，野老为裴回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25257,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"中夜危坐雨声清甚","author":"韩淲","text":"倦卧一榻上，展转不能寐。\n更听蟋蟀吟，时时风雨至。\n披衣起趺坐，数息存妙寄。\n其生何用观，夜气吾已志。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25258,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雨后骤冷凄然","author":"韩淲","text":"天高气萧瑟，薄薄寒中人。\n登山兮临水，贫士志不平。\n惆怅徒自怜，羁旅谁友生。\n申旦耿不寐，淹留可无成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25259,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅雨","author":"韩淲","text":"山溪绕寒城，林园眇荒隅。\n南枝小春梅，意似醉眼舒。\n云阴冒霏霏，欲步雨如涂。\n人閒压芳槽，洗酌留我娱。\n易斋诵铭语，耆英几年无。\n吾侪老孙子，交契岁月徂。\n速饮付丘壑，微吟对江湖。\n何当暗香底，花影相持扶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25260,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"微雨","author":"韩淲","text":"云间度微雨，沾洒草木净。\n披衣未盥栉，失却体中病。\n屋角鸠鸣阴，是亦彼情性。\n今我睡既醒，岂不有孤咏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25261,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夜雨","author":"韩淲","text":"卧听空山雨，愁人春夜长。\n田蛙与水鸣，聒聒来耳旁。\n缅怀千载遥，贤达多遁藏。\n岂无命世才，所抱或沮伤。\n离家脱尘役，且憩云水乡。\n时运不我留，老去空彷徨。\n但恐壮志销，放浪宜自彊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25262,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"午窗骤雨","author":"韩淲","text":"日暖石础润，雷雨响空山。\n草木尽披霏，云气满窗间。\n我方岸帻坐，与客谈笑间。\n会当乘少霁，午阴听潺湲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25263,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"急雨","author":"韩淲","text":"淫淫夏暑雨，小民惟曰怨。\n连朝浸田塍，一夜倒河堰。\n寻常已食麦，积久况少饭。\n钱币易低昂，亦合利商贩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25264,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]