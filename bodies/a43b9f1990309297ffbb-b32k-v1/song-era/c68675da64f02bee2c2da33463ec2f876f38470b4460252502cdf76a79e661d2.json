[{"title":"题吕城接待院","author":"释怀深","text":"我来暂解包，困就长床歇。\n叮咛木上座，莫苦多饶舌。\n一身同逆旅，三界若空花。\n勉尔水云客，当求见作家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1972,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"初至包山大雪戏题","author":"释怀深","text":"老僧昨夜包山宿，茅屋青灯火满炉。\n料得山神心喜我，晓来岩树雪模糊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1973,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次日有鹊巢于庵前枣树上树高数尺因笔戏题","author":"释怀深","text":"鹊巢低树绝惊猜，可验庵僧心已灰。\n与汝林间缄口过，不须虚喜报人来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1974,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"栽松","author":"释怀深","text":"栽松须觅曲松栽，养就山林拥肿材。\n直是无人著眼看，岁寒方得老岩偎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1975,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"手植小松","author":"释怀深","text":"小松盈尺已凌云，肯学芬芳桃李春。\n想汝龙鳞合抱日，老僧应是再来人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1976,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题一笑庵 其一","author":"释怀深","text":"旋转茅茨蔽雨风，土床蒲荐自雍容。\n荣枯过眼人间事，尽付山僧一笑中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1977,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题一笑庵 其二","author":"释怀深","text":"老觉形骸渐渐衰，放怀终日眼如眉。\n畏人知处闲名出，犹喜归庵未甚迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1978,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题也休庵 其一","author":"释怀深","text":"曲木为庵土作床，有门不闭且无妨。\n时人莫笑家风拙，歇得心时事事忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1979,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题也休庵 其二","author":"释怀深","text":"唱歌楼上语风流，你既无心我也休。\n打著郎君心里事，从前恩爱冷啾啾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1980,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"睡起戏题","author":"释怀深","text":"吃粥吃饭过，听风听雨眠。\n莫将安乐法，容易与人传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1981,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题寒食花","author":"释怀深","text":"寒食花无数，寂寥草莽同。\n只因颜色少，留得老山中。\n少艳人稀赏，无香蝶不知。\n人心尚红紫，争看醉西施。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1982,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题纸袄","author":"释怀深","text":"新成纸袄著彭亨，掉臂何妨雪里行。\n我既不怜人不爱，世间从此免相争。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1983,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"师初到包山见小池瑩如冰玉父老云池中昔有白龟已进之因命为白龟泉","author":"释怀深","text":"任是流金铄石时，此泉澄湛满幽池。\n白龟闻已献天子，何似蹒跚在淤泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1984,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题隐泉","author":"释怀深","text":"泉隐甘无竭，人闲道转高。\n涓涓清自足，休苦作波涛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1985,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"包山开井","author":"释怀深","text":"山骨凿深六十尺，石中泉眼始方开。\n后人饮水知来处，曾费山僧心力来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1986,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"小师般砖造塔","author":"释怀深","text":"伛偻山头自负砖，要成小塔立云烟。\n聚沙也似儿童戏，且为湖山结少缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1987,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"入定观音","author":"释怀深","text":"那伽常在定，无有不定时。\n为彼散乱人，故现如是相。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1988,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"广瑞岩和尚呼主人公诺 其一","author":"释怀深","text":"主人公诺听我语，死生流转无停住。\n今日忙兮明日忙，灵光一点何时悟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1989,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"广瑞岩和尚呼主人公诺 其二","author":"释怀深","text":"主人公诺听我道，贪名逐利何时了。\n争如识取自家珍，灵光灼灼无边表。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1990,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"广瑞岩和尚呼主人公诺 其三","author":"释怀深","text":"主人公诺听我劝，浮生莫作欺瞒汉。\n暗里虽然瞒得来，明中依旧还消散。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1991,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"广瑞岩和尚呼主人公诺 其四","author":"释怀深","text":"主人公诺听我说，百岁光阴如电掣。\n四十五十不回头，问君更待何时节。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1992,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"广瑞岩和尚呼主人公诺 其五","author":"释怀深","text":"主人公诺听我嘱，今年已是五十六。\n为人终是费分疏，何日口边生白醭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1993,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"劝食素","author":"释怀深","text":"吃肉何如咬菜根，且图身口戒香薰。\n莫言死后无因果，八两须还他半斤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1994,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"劝晨朝食素","author":"释怀深","text":"未能遽断荤和酒，且结晨朝清净因。\n省费省缘兼惜福，灵岩此语太饶人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1995,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"怀净照禅师","author":"释怀深","text":"一别芦江后，千峰雁影沉。\n闻回天子诏，方见老师心。\n筹室应将满，禅关转见深。\n秋来瓯顶夜，时扰梦投针。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1996,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"阅佛鉴禅师语录","author":"释怀深","text":"说禅要似钟山老，有口无心几个知。\n要我舌端轰霹雳，就渠眼里下钳锤。\n平时却出活人剑，险处聊为死马医。\n惭愧丛林宗匠在，与人扫尽百生疑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1997,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"乞退慧林寄佛果禅师","author":"释怀深","text":"单丝系住老牛脚，心欲东西未自由。\n凭仗东风齐著力，早教船子下扬州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1998,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄寿春沂和尚","author":"释怀深","text":"闻把东禅木杓柄，放开布袋好流传。\n后人薄己符言行，壁立家风要斩然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1999,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"答天宁讷和尚","author":"释怀深","text":"老来多睡胜春蚕，五蕴山头卓个庵。\n随分饥餐渴饮过，不知何地见同参。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2000,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄东禅玿和尚","author":"释怀深","text":"闻坐天童上板头，深挑痛劄未应休。\n吾门直截无窼臼，家破人亡始自由。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2001,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"答广灯禅师退翠峰","author":"释怀深","text":"有经遮眼明窗下，无事干怀白昼长。\n自拾松枝烧歙钵，看人终日竞头忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2002,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送庆善圭和尚","author":"释怀深","text":"道人门冷如秋色，竟日曾无俗驾来。\n近为耽诗成癖好，寒窗夜作老猿哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2003,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"中秋寄瑰和尚","author":"释怀深","text":"秀岭高峰咫尺间，青松常伴白云闲。\n中秋同玩洞庭月，谁道山家不往还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2004,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和规和尚 其一","author":"释怀深","text":"老来心地烂如泥，卜得胥湖作虎溪。\n七十二峰烟浪阔，听他游子路头迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2005,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和规和尚 其二","author":"释怀深","text":"去年西坞得相寻，雪竹霜竹一径深。\n圆屋青灯闻妙语，使人灰尽一生心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2006,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和规和尚 其三","author":"释怀深","text":"但得茅檐春睡足，何须石室较筹盈。\n遥知别后多萧散，坐听松风万壑清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2007,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和规和尚 其四","author":"释怀深","text":"镜像魔军方满目，浮云世事急抽头。\n倚蒲痴坐慵开口，诗债还能饶我不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2008,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和信和尚 其一","author":"释怀深","text":"一身彼此转蓬样，百岁光阴交臂间。\n底事石梁成邂逅，烽烟影里得馀闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2009,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和信和尚 其二","author":"释怀深","text":"喜君胸次冰壶净，道富身贫只我谙。\n利火名汤方鼎沸，看人终日手争探。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2010,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"示高维那兼简宝华鉴和尚初出世","author":"释怀深","text":"石上三生梦已非，人间万事眼如眉。\n归家更问宝华老，何似板头端坐时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2011,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"会源首座","author":"释怀深","text":"高踪不负当年约，时忆翻然命驾来。\n世味任教甜似蜜，道心终使冷如灰。\n茅茨款我三椽小，石榻缘君一笑开。\n倚杖春风话平昔，寄言猿鸟莫惊猜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2012,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"会吉上人","author":"释怀深","text":"晚岁欣逢彼上人，诛茅约我老江滨。\n世间声利空翻覆，林底交游无故新。\n学力几年淹讲席，真风一扫尽情尘。\n近来百鸟无寻处，开尽岩花烂熳春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2013,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"示纯禅者","author":"释怀深","text":"故园我别已多时，见子犹能略展眉。\n乡语每闻聊发笑，客情无复更生悲。\n寻师慎勿贪眠食，立雪终教彻髓皮。\n毕竟禅家外文字，之乎者也不须知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2014,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"示敏禅者","author":"释怀深","text":"寻师问道岂徒然，休似痴夫饱睡眠。\n白日西倾如箭息，红颜暗去若绳牵。\n断肱立雪思吾祖，刺股悬头效昔贤。\n此语叮咛须记取，莫教容易过流年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2015,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"示昙禅者","author":"释怀深","text":"数椽茅屋海门边，云水生涯祇任缘。\n逸足懒收支遁马，清香聊种远公莲。\n欲干世上千钟禄，何似林间一觉眠。\n异日果来期款曲，为君芥子纳三千。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2016,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"示求禅者","author":"释怀深","text":"灵光一点自分明，照破众生违顺情。\n拶看通身开正眼，方能日午打三更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2017,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"示襄禅者","author":"释怀深","text":"古人得后便休休，茅屋青灯百不求。\n遮眼谩将黄卷展，不风流处却风流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2018,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"示表禅者","author":"释怀深","text":"放下千斤重担子，重归岩谷旧三椽。\n不须苦觅扬州鹤，伴我林间骨碖眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2019,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"示皎禅者","author":"释怀深","text":"世事不中回首看，湖山他日为吾来。\n草衣木食相陪过，肯把柴门取次开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2020,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"侩道成于金山住破屋一间有不下山戒喜其孤洁赠之以偈","author":"释怀深","text":"歇得心时自少魔，山头孤坐养天和。\n莫嫌茅舍不宽广，茅舍才宽事便多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2021,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"安正阇梨求偈","author":"释怀深","text":"黄叶止啼知即已，敲门瓦子亦休留。\n虚空讲得真经后，解笑当年石点头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2022,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"因首座求偈","author":"释怀深","text":"衣底明珠本自圆，个中无正亦无偏。\n蒲团纸帐坐终日，体取先师苦口禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2023,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"至禅者求偈 其一","author":"释怀深","text":"探竿影草闲家具，独弄单拈破笊篱。\n口醭心灰诸漏尽，菱花不拭自光辉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2024,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"至禅者求偈 其二","author":"释怀深","text":"玉偈金言一扫休，已灵不重圣何求。\n无常煞鬼难吞处，祇为渠侬得自由。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2025,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"道智更衣参学求偈 其一","author":"释怀深","text":"未见虚空解讲经，个中切忌计工程。\n蒲团七个坐不破，岂可等闲明死生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2026,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"道智更衣参学求偈 其二","author":"释怀深","text":"妙句玄言一切休，只看露地一头牛。\n忽然鼻孔芒绳断，吼月耕云便自由。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2027,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"刚监院遣小师子文包山下书文别求偈兼示刚公","author":"释怀深","text":"一叶轻舟泛太湖，西山来觅老僧居。\n归家好为力生说，林底安闲是坦途。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2028,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"法照大师求偈","author":"释怀深","text":"戴角披毛老牸牛，牵犁拽杷几经秋。\n脚跟终不随人转，鼻孔辽天得自由。\n得自由，洞庭湖里冷啾啾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2029,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"老僧慧因唱尽衣钵欲舍身火化二偈诫之 其一","author":"释怀深","text":"衣钵老来都唱却，赤条条地更身安。\n但教留得娘生裤，雪打风吹不解寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2030,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"老僧慧因唱尽衣钵欲舍身火化二偈诫之 其二","author":"释怀深","text":"好死何如且恶活，随缘随分傍岩隈。\n直饶野火烧残后，依旧春风吹出来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2031,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"因禅者欲编语录以偈止之","author":"释怀深","text":"吾祖初来字脚无，儿孙后代竞编书。\n子今莫苦著文字，秘取圆明顶?珠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2032,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"安禅者为思溪国觉专使远至国清以偈却之","author":"释怀深","text":"丰干端是饶舌汉，引惹闾丘特特来。\n累及寒山无雪处，岩门从此不应开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2033,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"慧林诫禅徒入浴","author":"释怀深","text":"浴时少使一瓢汤，受用浮生日子长。\n薪桂未言京国贵，辘轳百尺几夫忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2034,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"诫参徒睡不脱衣","author":"释怀深","text":"孤舟共渡有夤缘，一众相依岂偶然。\n但我住山随处所，不令衲子脱衣眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2035,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄邃首座","author":"释怀深","text":"投老西山百不为，把茅是处可幽栖。\n太湖三万六千顷，天与山僧作虎溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2036,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄国清光长老兼示诸衲子 其一","author":"释怀深","text":"寒拾长谈苦口禅，无人领解许多年。\n如今拽转家风也，好把泥牛痛下鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2037,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄国清光长老兼示诸衲子 其二","author":"释怀深","text":"丰干漏泄因饶舌，描邈虚空总是渠。\n翻笑闾丘无鼻孔，灶前礼拜觅文殊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2038,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄国清光长老兼示诸衲子 其三","author":"释怀深","text":"聚头作相都休问，那事如何为举扬。\n放得肚皮沧海阔，世间无物不包藏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2039,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄实相院主","author":"释怀深","text":"乞得包山古寺基，竹窗松桧作幽栖。\n何时一棹来相访，说尽人间万事非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2040,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送炬禅者归宁亲","author":"释怀深","text":"出门烟水正茫茫，体露金风木叶黄。\n父母未生前一句，不知何地是家乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2041,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送正禅者归为本师起塔","author":"释怀深","text":"先师骨冷已多时，千里迢迢特地归。\n要会去来无间断，个中一步不曾移。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2042,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送暹禅者出京","author":"释怀深","text":"毕竟归山是胜游，道人阅世本无求。\n小舟东下轻如叶，回首红尘一笑休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2043,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送珍禅者","author":"释怀深","text":"湖边看子上归舟，林底初惊一叶秋。\n要似羚羊长挂角，莫教猎犬得踪由。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2044,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送全禅者为普慧胜长老专使下书回","author":"释怀深","text":"独秀峰前一朵春，为传消息岂辞辛。\n归祏觅取住山斧，作个丛林向上人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2045,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送印禅者","author":"释怀深","text":"要如璞玉深藏器，莫比囊锥立露尖。\n随处关门安稳坐，不妨终日口如钳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2046,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送广法初长老下乡","author":"释怀深","text":"偎岩傍水我甘老，垂手入廛公正时。\n异日归来同粥饭，折铛不用倩人提。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2047,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谒法报庵主不值","author":"释怀深","text":"道人云出山，轩窗有佳趣。\n松竹自说法，客来点头去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2048,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]