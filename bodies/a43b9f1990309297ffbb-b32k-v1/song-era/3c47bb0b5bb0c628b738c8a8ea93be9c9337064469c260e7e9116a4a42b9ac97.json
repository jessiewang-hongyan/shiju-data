[{"title":"送程给事知越州 其二","author":"毕仲连","text":"铙鼓喧喧逐迅流，旆旌明灭拥行舟。\n三吴作镇侯藩重，一道提兵帝泽优。\n锦里江山归兴逸，鉴湖风月到时秋。\n祇应图任须元老，促召犹能驻虎丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56244,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送程给事知越州","author":"谢惇","text":"夕郎暂去赤墀班，宠佩藩符出汉关。\n江国正逢鲈味美，里闾先著锦衣还。\n赏追贺监湖边月，醉陟秦王瓮畔山。\n万壑千岩常在眼，诗情应喜讼庭闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56245,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诗一首","author":"仵磐","text":"太一峰前是我家，满床书籍旧生涯。\n春城恋酒不归去，老却碧桃无限花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56246,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"四景楼","author":"李愿","text":"纵目有佳处，须登四景楼。\n输蹄喧市井，桑谷暗郊丘。\n翠盖云生里，沧溟天尽头。\n阑干知几曲，徙倚恣清愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56247,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"望仙门","author":"李愿","text":"楼影空门里，门开望众仙。\n绿鬟云漠漠，翠黛月娟娟。\n烟驾知何处，星槎记昔年。\n夕阳孤鸟畔，缈缈海浮天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56248,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题吕元圭诗后","author":"喻陟","text":"黄鹤楼边横笛吹，石亭窗上更题诗。\n世人不识还归去，江水云山空渺瀰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56249,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贺种太守破鬼章 其一","author":"喻陟","text":"捷报下岷洮，威传万里遥。\n渠魁咸面缚，氛祲即时销。\n圣算百王上，神功千古超。\n从兹荒忽地，无复恣凶骄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56250,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贺种太守破鬼章 其二","author":"喻陟","text":"黠卤方千轨，王师薄有征。\n摧枯祇俄顷，破竹不留行。\n杀气收貔虎，清风捲旆旌。\n遥瞻紫宸阙，称贺浃欢声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56251,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贺种太守破鬼章 其三","author":"喻陟","text":"周后持盈日，戎夷负固年。\n庙谟期必胜，阃略制于先。\n不假天山箭，行闻杕杜篇。\n凯还俘馘献，图像有凌烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56252,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"喻陟","text":"黄鹤仙人隔千古，太白英灵在何许。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56253,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"喻陟","text":"费祎丁令亦何之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56254,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其三","author":"喻陟","text":"游蜂与狂蝶，无计旁檀心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56255,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游终南山杂咏 草堂","author":"李騊","text":"入门脩竹耸琅玕，坐久香风拂画栏。\n春色正秾双桧静，朝光初上一峰寒。\n翠萦虚室尘襟阔，冷逼疏窗夜梦残。\n物外闲心殊未惬，殷勤重上白云端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56256,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游终南山杂咏 宿紫阁","author":"李騊","text":"石磴溪桥傍翠峦，分明深入画图间。\n远绕禅刹疑无景，迥出群峰别有山。\n微雨欲来云影乱，轻风不断鸟声闲。\n岚光可是清人骨，更待中宵一梦还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56257,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游终南山杂咏 雨后紫阁晚望","author":"李騊","text":"小雨初回作暮寒，断崖壁立夕阳间。\n一襟清兴无人语，旋拂禅床卧看山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56258,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游终南山杂咏 云际院","author":"李騊","text":"蔽日芳林迷去路，被蹊落叶误行踪。\n转岩却见层峦出，知是仙山第几重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56259,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游终南山杂咏 长啸洞","author":"李騊","text":"西风壁立苍崖瘦，一水湍流怒浪翻。\n云外不须求紫府，祇应此景是桃源。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56260,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游终南山杂咏 宿重云山寺","author":"李騊","text":"渐侵晚景尤便静，不出忙中岂爱闲。\n休问骅骝与蛙黾，会须投绂老青山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56261,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游终南山杂咏 重云道中海棠","author":"李騊","text":"万点梢头烂晓霞，谩随闲世斗春华。\n孤根自是生穷僻，未必轻输别圃花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56262,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游终南山杂咏 宿白云明日之鄠县","author":"李騊","text":"蔽空秾绿门前路，匝地疏苗户外村。\n暂宿云房叩虚寂，红尘意味不堪论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56263,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游终南山杂咏 渼陂","author":"李騊","text":"望极空蒙清满怀，更寻遗迹步高台。\n日斜林杪增光去，风静山尖倒影来。\n万顷澄澜春涨碧，一川秀色暝阴开。\n坐中自有江湖兴，未放陂南画舸回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56264,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送程给事知越州","author":"莫渊","text":"北虏分庭正，东藩得郡优。\n兼曹抛玉殿，重阁指蓬邱。\n节制连江海，封疆直斗牛。\n地虽邻故里，人始识元侯。\n合浦珠还日，长河虎渡秋。\n溪山归胜览，风月入冥搜。\n使旆天边去，楼船鉴里游。\n茶枪香泛泛，竹箭绿修修。\n乐苑花犹卉，兰亭水尚流。\n千寻经石篑，八月看潮头。\n萧寺逢支遁，山阴忆子猷。\n昔贤尝纵乐，太守好销忧。\n倒载何妨作，扁舟未可谋。\n朝纲须急治，民瘼俟全瘳。\n青琐从虚位，朱幡且少留。\n行当宣室召，还应傅岩求。\n德望终归用，愚蒙祇自愁。\n官资卑执戟，身势类浮鸥。\n每玷乡人荐，长思国士酬。\n那堪闻叠鼓，惆怅送行辀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56265,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游虎丘","author":"赵知章","text":"神光在牛斗，空赋白云篇。\n地坼龙泓冷，天分锦石圆。\n悠悠蕉鹿梦，的的露牛禅。\n再见窗中雪，应知宿有缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56266,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵奉和杨圣咨题李长者旧居","author":"郭时亮","text":"李氏当年著佛书，此邦犹记旧居庐。\n因公寻访松生语，不识何人为守株。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56267,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观稼阁","author":"郑永中","text":"公馀乘兴步危楼，十里如云翠欲流。\n多稼芃芃天外阔，平湖渺渺望中浮。\n方忻民乐庭无讼，更听农歌岁有秋。\n吏责已宽聊自得，待凭诗酒寓优游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56268,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重修岳阳楼","author":"郑民瞻","text":"偏历江山祇此楼，名传自古又今修。\n却观湘水浮新景，重对君山记旧游。\n风月依然如故友，轩窗今复冠南州。\n远迢张相滕侯迹，幸蹑前规壮胜游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56269,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"朱戴上","text":"官闲无一事，蝴蝶飞上阶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56270,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送苏录事赴虢州","author":"郭霖","text":"白首旧相知，茅津此去时。\n马骄青草色，柳绾绿烟丝。\n落日曹瞒垒，荒城虢仲祠。\n圣朝深雨泽，宁必叹衰迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56271,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西耕","author":"郭霖","text":"凿田喜得傍湖堤，湖水春来好灌畦。\n躬稼自甘名姓没，不妨寂寞老岩栖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56272,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"繇三茅直抵紫阳观","author":"郭霖","text":"一上云山思便幽，长松怪石坐淹留。\n乘风直造神仙窟，零落烟霞满杖头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56273,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"张楚民","text":"香山正在岷山麓，一派流泉万竿竹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56274,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"泊舟","author":"吴公敏","text":"潭影静沈沈，维舟傍竹林。\n乡心寄孤雁，寒信起疏砧。\n犬吠人家近，灯明树影侵。\n客愁元不寐，夜雨更蛩吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56275,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"提刑都讲颁赐题古楠寺佳篇伏读玩味词旨豪肆感叹战汗不揆浅拙仰次严韵","author":"杨庭杰","text":"城南古寺旧林泉，使驭观游绝顶巅。\n幸缀华轩到清境，深惭凡骨逐真仙。\n不愁落日归鞍促，更许新诗翠石镌。\n犹有题名千载后，与他巴水字相连。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56276,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"后月馀因用前韵","author":"杨庭杰","text":"谷隐楩楠涧有泉，烟村幽旷远□□。\n□□□□□难尽，鸡犬时来亦恐仙。\n危壁谩□□□□，□□□是五丁镌。\n回归未出深岩半，□□□□□□□。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56277,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵庞茶使郫县塔","author":"杨天惠","text":"平生阅巨丽，兹塔咤何雄。\n因地如无地，平空不碍空。\n宁从佛土徙，几历劫灰穷。\n落趾鸡关北，明标玉垒东。\n经营本龙象，负挽僦烟虹。\n畚筑才驱石，觚棱欻倚风。\n妙高分绝域，峻极倒中嵩。\n已幻花台巧，并规鹫岭嵷。\n仰窗平月殿，横级俯蛟宫。\n未觉诸天隔，惟看一气融。\n恒沙寸眸摄，多寡片心通。\n澒洞遗凡界，虚疏彻外幪。\n身边揖先圣，眼外洗尘雺。\n井直参连壤，秦开汉拓功。\n真乘对时出，休运与天崇。\n缔构虽人力，扶持亦化工。\n长生老西崦，诸葛死南隆。\n但了薰香灺，姑储氎布筒。\n狂歌留白日，醉舞属冥鸿。\n莫漫百年事，空成一秃翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56278,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵吴帅题保福壁二首 其一","author":"杨天惠","text":"净瓶犹贮近颁冰，拄杖还扶旧醉藤。\n遮莫簪花倩天女，未妨燕坐折谈僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56279,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵吴帅题保福壁二首 其二","author":"杨天惠","text":"由来世谛即菩提，吾道元东祖自西。\n恰似苍圆好头相，可容破裂作阿梨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56280,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送孙正忠臣移成都小漕","author":"杨天惠","text":"升平芝菌效神奇，况乃贤豪用世资。\n人物熙宁中兴日，风流荆国适同时。\n起家便作三公客，乘传何为九折驰。\n少府但分新赐节，石渠犹借旧官仪。\n素心久辨经纶计，妙意前知遇合期。\n聊与西南成胜事，暂将清献续良规。\n桥横万里重开府，水接双流共去思。\n怊怅参卿无限意，道旁索笔强题诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56281,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"多病简出偶成呈郫令张盘公大夫","author":"杨天惠","text":"相从一笑忘蹉跎，三过秋风锦水波。\n游子依人仰眉睫，令兄爱客费弦歌。\n思归仙鹤方惊露，欲起病凫还避罗。\n共感乌纱能爱老，长长遮护两苍皤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56282,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"温江县二瑞颂","author":"杨天惠","text":"于皇御极，百志惟叙。\n曰农而农，曰士而士。\n尔安乃宫，尔宁乃亩。\n恩诏数下，仁滂德膴。\n农饱以歌，士喜式舞。\n协气从之，祥嘏如雨。\n乃产嘉禾，以庆农扈。\n乃降甘露，以幸士子。\n其庆伊何，珠穗纷举。\n俾尔瓯窭，户有亿秭。\n其幸维何，云液醲湑。\n俾尔膏馥，濡及婴孺。\n维明明后，博临下土。\n相彼多禾，均此灵露。\n道拜稽首，诞告奔走。\n惠拜稽首，盱衡语语。\n敢献稗官，以赞矇瞽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56283,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次吕给事安昌岩避暑","author":"杨天惠","text":"恳乞鱼书得梓潼，曾司紫诰駮斜封。\n江山似解邀康乐，傅瑞时来访彦龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56284,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"杨天惠","text":"清凉洞里无蚊蚋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56285,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"杨天惠","text":"鱼虾敢涴方池洁，蚊蚋谁禁胜地寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56286,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其三","author":"杨天惠","text":"北郭云山接巴阆，东城雪水泻文龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56287,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其四","author":"杨天惠","text":"道闻资水灵山高，仙人羽客时相遭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56288,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"段高","text":"寸心如画笔，到处写江山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56289,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送程给事知越州","author":"谢忱","text":"垂髫骑竹戏江滨，束发区区走路尘。\n忆别稽山无去梦，乐闻鉴水欲归人。\n棹歌停楫千诗送，帆影乘风百尺伸。\n行矣东南寄滋重，越民远尔待颁春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56290,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"灵岩","author":"鲜于颉","text":"松门十里苍山曲，宫殿参差倚岩腹。\n盘盘一径入云中，又登绝顶最高峰。\n石壁苍然起秋色，远溪深处时闻钟。\n磴道崎危达岩下，几派清泉在涧泻。\n月色朦胧出远山，忽惊星斗在檐前。\n倦客游来不知返，清光皎皎严霜寒。\n一出禅林复回顾，白云已满山头路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56291,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题楼观南楼","author":"大中","text":"纷纷尘事日婴怀，一见南山眼暂开。\n好是晚云收拾尽，半天苍翠望中来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56292,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"伏睹适公诗赞观世音菩萨果应所恳具述于前拱不揆浅拙谨吟一章同赞圣德","author":"黄拱","text":"菩萨慈悲行愿深，遍游沙界拯枯沉。\n众生得度随形化，说法开迷震梵音。\n眉现毫光同率土，手持杨柳摄群心。\n我今稽首虔诚礼，愿赐慈光与照临。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56293,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"绝句","author":"三朵花","text":"戴花三朵镇长春，谁识玄中不二门。\n醉里自传神似活，终当不老看乾坤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56294,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"灵岩十二景 其一 置寺殿","author":"释仁钦","text":"青蛇引路破樵径，二虎驮经莫厌频。\n周汉魏时于此住，年过八百又重新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56295,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"灵岩十二景 其二 般舟殿","author":"释仁钦","text":"般舟古殿最先风，运载含灵不可穷。\n生死海中波浪险，莫教沉溺失前功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56296,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"灵岩十二景 其三 铁袈裟","author":"释仁钦","text":"我佛慈悲铁作衣，谁知方便示禅机。\n昔年庾岭家风在，直到如今识者稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56297,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"灵岩十二景 其四 朗公山","author":"释仁钦","text":"万象森罗古此峰，传来几世朗公容。\n知音会遇无先后，今日依前旧日踪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56298,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"灵岩十二景 其五 明孔山","author":"释仁钦","text":"凿开灵岩玲珑晓，一窍圆光似月明。\n照古照今传万代，不知谁向此安名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56299,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"灵岩十二景 其六 绝景亭","author":"释仁钦","text":"四顾林峦似列屏，一源流水响泠泠。\n游人到此忘归去，名称虚堂绝景亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56300,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"灵岩十二景 其七 甘露泉","author":"释仁钦","text":"甘露香泉竟日流，有时天旱四方求。\n随缘赴感无偏党，古往今来不记秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56301,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"灵岩十二景 其八 石龟泉","author":"释仁钦","text":"团团特石凿灵龟，口内喷流世莫疑。\n造化始知心所有，几人到此乱针锥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56302,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"灵岩十二景 其九 锡杖泉","author":"释仁钦","text":"历历金镮振一声，滔滔千古迸流清。\n香厨日用无穷竭，饮者甘和悦众情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56303,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"灵岩十二景 其十 白鹤泉","author":"释仁钦","text":"云鹤双飞去几年，遗踪依旧涌灵泉。\n澄澄皎洁无增减，石铫煎茶味更全。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56304,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"灵岩十二景 其十一 鸡鸣山","author":"释仁钦","text":"鸡鸣欲晓惊行路，回首思量却再来。\n两两三三皆省觉，一人独上妙高台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56305,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"灵岩十二景 其十二 證明殿","author":"释仁钦","text":"万丈岩前作證明，十方檀信等空平。\n一针一草无遗漏，百劫千生果自成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56306,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寒食饮梨花下得愁字","author":"侯穆","text":"共饮梨花下，梨花插满头。\n清香来玉树，白蚁泛金瓯。\n妆靓青蛾妒，光凝粉蝶羞。\n年年寒食夜，吟绕不胜愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56307,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"黄知微","text":"溪云拂地送残雨，谷鸟向人啼落花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56308,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"黄知微","text":"万里碧云开暮色，一条银汉在秋天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56309,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠县令","author":"建阳举子","text":"寒儒登第十三年，冲替归来卖尽田。\n除却职田清俸外，不知何处遇神仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56310,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和李巨川清风楼","author":"吕当","text":"祁阳要郡冠边州，池垒深高北控幽。\n攲岸绿杨浮水面，衔山红日照檐头。\n立功慷慨思投笔，鬻己卑污耻饭牛。\n独使燕然铭汉德，百年忠愤遣人愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56311,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"石太傅","text":"芝兰相照皆佳士。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56312,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪霁月明独步梅花下","author":"曲贞","text":"雪晴月白梅花芬，朗行恍在琼瑶京。\n光摇灿灿玉宇净，香浮霭霭银河明。\n乾坤元气正澄澈，林峦景色何晶荧。\n风神顾我精爽逼，襟怀顿觉尘嚣清。\n凭高忽尔发长啸，千山响振鸾凤鸣。\n夜深一望五湖白，何当跨鹤游蓬瀛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56313,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]