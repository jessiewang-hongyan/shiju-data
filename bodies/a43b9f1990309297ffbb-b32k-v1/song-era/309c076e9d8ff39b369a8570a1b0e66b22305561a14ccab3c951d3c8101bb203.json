[{"title":"江城子","author":"曹良史","text":"夜香烧了夜寒生。\n掩银屏。\n理银筝。\n一曲春风，都是断肠声。\n杜宇欲啼杨柳外，愁似海，思如云。\n背灯暗卸乳鹅裙。\n酒初酲。\n梦初醒。\n兰炷香篝，谁为暖罗衾。\n二十四帘人悄悄，花影碎，月痕深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64529,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"为王钦若作命书 其一","author":"曹谷","text":"七十年中一一加，弄珠滩上事堪誇。\n碧油幢下闻啼鸟，千日招还上汉槎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64530,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"为王钦若作命书 其二","author":"曹谷","text":"周匝将临壬戌岁，定鼎门前春色异。\n一千日上少三镮，再入和羹宜尽瘁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64531,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送张无梦归天台","author":"曹谷","text":"几载仙山下，无机世莫分。\n因为天市客，方识帝乡云。\n鍊气壶中见，还元海内闻。\n名高赤城洞，歌赐紫皇君。\n步逐飙轮健，香随斗极焚。\n何当挹蓬阆，鸾鹤自成群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64532,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"曹谷","text":"临去尚犹闻禁漏，异姓嘉名在史书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64533,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"通玄洞","author":"曹叔远","text":"遨游倦听水声潺，却爱灵岩引憩间。\n树拥倒晖穿嶂曲，风牵斜雨洒藤弯。\n半袈裟里须弥现，隙滹阿中法界宽。\n为纳千僧浑不见，欲于此地扣禅关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64534,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题锦浪亭","author":"曹叔远","text":"泸江东山山更奇，骑鲸飞仙归未归。\n桃花千树烂春昼，莫作韩子荒唐讥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64535,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"曹坤","text":"宝源天富国，咸脉海分潮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64536,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"剑门关","author":"曹宗旦","text":"凿开千里地，通得一隅天。\n叠嶂连三峡，重门扼两川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64537,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次胡馀学同年四首 其四","author":"曹泾","text":"力田元不怵凶饥，瘠者为谁谁是肥。\n但得高堂翁媪健，定知奕世子孙宜。\n追风骐骥骤仍蹶，览德鸾凤栖或飞。\n有酒急须频对月，桂枝香了到梅枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64538,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次胡馀学同年四首 其三","author":"曹泾","text":"桃花柳絮及春敷，壹是浮轻匪壮图。\n幸有田耕并井饮，犹胜身屦与妻纑。\n郎君竞爽贤声起，老子尊安道味腴。\n便是当年正考父，是间饘粥口堪糊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64539,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次胡馀学同年四首 其二","author":"曹泾","text":"金明池上共扬鞭，豪气宁求许祀田。\n不道福碑轰忒早，相逢颓景稳为便。\n牙牌刻处谩誇贵，蓝绶披来难敌鲜。\n千岁尽长公论在，于中定有好官员。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64540,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次胡馀学同年四首 其一","author":"曹泾","text":"对看中秋是好天，健来欣为子分田。\n只消菽水欢无尽，况有经书腹可便。\n家事既传情思稳，吟篇谩写墨痕鲜。\n惟馀学课随年挨，共我艰劬知几员。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64541,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次胡济鼎同年三律 其二","author":"曹泾","text":"共是金明衣绿郎，梅仙风致压仇香。\n人如紫凤仪丹阁，谁则青蚨涴锦囊。\n洛社菜羹时不禁，雪堂斗酒夜宜良。\n至尊端肯怜芹曝，臣罪当诛自恐惶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64542,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次胡济鼎同年三律 其三","author":"曹泾","text":"费却长吟复短吟，投瓜投李愧何深。\n吾人只记钱留纸，此老能令户作金。\n掷地有声知处处，如兰斯臭见心心。\n柏梁体后八仙赋，趾美重光未陆沉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64543,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次胡济鼎同年三律 其一","author":"曹泾","text":"五经为笥腹便便，千佛名高此作缘。\n贵仕直堪梅和鼎，贫交猥为酒供钱。\n连章秋月雁回翅，贮袖天香龙吐涎。\n旧话新情如觌面，同年真是我同年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64544,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代柬济鼎同年约其早饭","author":"曹泾","text":"小人难与作缘，恶食不妨志道。\n犹胜杜陵岳阳，一饭欲从人讨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64545,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夹竹桃花","author":"曹组","text":"晓栏红翠净交阴，风触芳葩笑不任。\n既有柔情慕高节，即宜同抱岁寒心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64546,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻鸠鸣有感","author":"曹组","text":"鸣鸠一声斑竹林，怀远感时惊寸心。\n却忆南园春半夜，荠花如雪草初深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64547,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"翡翠","author":"曹组","text":"窥鱼潜立小荷圆，照水飞鸣更碧鲜。\n斗草人归寻坠翼，绮窗归去补花钿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64548,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"竹间见梅","author":"曹组","text":"霜雪俱怜节操奇，碧鲜红润两相宜。\n渭滨初种谩千亩，陇上寄来惟一枝。\n酸实不供饥凤啄，暗香翻许此君知。\n佳人零落空山久，况是天寒日暮时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64549,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夜宿学","author":"曹组","text":"促织声中破月悬，水生寒气近湖边。\n城头三鼓夜方半，窗下一灯人未眠。\n辛苦诗书怜此日，奋飞功业定何年。\n太平干禄无他径，只有乡书可荐贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64550,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寒食辇下","author":"曹组","text":"海棠时节又清明，尘敛烟收雨乍晴。\n几处青帘沽酒市，一竿红日卖花声。\n綵毬时向梭门过，绣毂遥随辇路行。\n日暮人人醉归去，熙熙春物见升平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64551,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赏心亭","author":"曹组","text":"白鹭洲边芦叶黄，石头城下水茫茫。\n江山不管事兴废，今古坐令人感伤。\n六代豪华空处所，千秋城阙委荒凉。\n空馀眼外无穷景，助我凭栏到夕阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64552,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜归曲","author":"曹组","text":"饥乌哑哑啼暮寒，回风急雪飘朱阑。\n琐窗绣阁艳红兽，画幕金泥摇彩鸾。\n吴妆秀色攒眉绿，能唱襄阳大堤曲。\n酒酣横管咽孤吟，吹裂柯亭傲霜竹。\n远空寒云浑不动，老狐应渡黄河冻。\n暗回微煖入江梅，何处荒榛挂幺凤。\n归来祇誇青连钱，貂茸拥鼻行翩翩。\n笼纱蜜炬照飞霰，十二玉楼人未眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64553,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鸳鸯","author":"曹组","text":"蘋洲花屿接江湖，头白成双得自如。\n春院有时描一对，日长消尽绣工夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64554,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"卜算子 兰","author":"曹组","text":"松竹翠萝寒，迟日江山暮。\n幽径无人独自芳，此恨凭谁诉。\n似共梅花语。\n尚有寻芳侣。\n著意闻时不肯香，香在无心处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64555,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小重山","author":"曹组","text":"深拥熏篝倏已冥。\n寂寥山枕畔，梦难成。\n谁堪三两夜乌声。\n银缸灺，花影上围屏。\n犹记旧时情。\n帘边人似月，月如冰。\n从今张眼到天明。\n衣带缓，谁与问伶俜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64556,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小重山 其一","author":"曹组","text":"帘卷东风日射窗。\n小山庭院静，接回廊。\n疏疏晴雨弄斜阳。\n凭栏久，墙外杏花香。\n时节好寻芳。\n多情怀酒伴，忆欢狂。\n归鸿应已度潇湘。\n音书杳，前事忍思量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64557,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小重山 其二","author":"曹组","text":"陌上花繁莺乱啼。\n骅骝金络脑，锦障泥。\n寻芳行乐忆当时。\n联镳处，飞鞚绿杨堤。\n春物又芳菲。\n情如风外柳，只依依。\n空怜佳景负归期。\n愁心切，惟有梦魂知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64558,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"忆少年","author":"曹组","text":"年时酒伴，年时去处，年时春色。\n清明又近也，却天涯为客。\n念过眼、光阴难再得。\n想前欢、尽成陈迹。\n登临恨无语，把阑干暗拍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64559,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"忆瑶姬","author":"曹组","text":"雨细云轻，花娇玉软，于中好个情性。\n争奈无缘相见，有分孤零。\n香笺细写频相问。\n我一句句儿都听。\n到如今，不得同欢，伏惟与他耐静。\n此事凭谁执证。\n有楼前明月，窗外花影。\n拚了一生烦恼，为伊成病。\n只恐更把风流逞。\n便因循、误人无定。\n恁时节、若要眼儿厮觑，除非会圣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64560,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水龙吟 牡丹","author":"曹组","text":"晓天谷雨晴时，翠罗护日轻烟里。\n酴醾径暖，柳花风淡，千葩浓丽。\n三月春光，上林池馆，西都花市。\n看轻盈隐约，何须解语，凝情处、无穷意。\n金殿筠笼岁贡，最姚黄、一枝娇贵。\n东风既与花王，芍药须为近侍。\n歌舞筵中，满装归帽，斜簪云髻。\n有高情未已，齐烧绛蜡，向阑边醉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64561,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"扑蝴蝶","author":"曹组","text":"人生一世。\n思量争甚底。\n花开十日，已随尘共水。\n且看欲尽花枝，未厌伤多酒盏，何须细推物理。\n幸容易。\n有人争奈，只知名与利。\n朝朝日日，忙忙劫劫地。\n待得一晌闲时，又却三春过了，何如对花沈醉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64562,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"好事近","author":"曹组","text":"茅舍竹篱边，雀噪晚枝时节。\n一阵暗香飘处，已难禁愁绝。\n江南得地故先开，不待有飞雪。\n肠断几回山路，恨无人攀折。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64563,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"如梦令","author":"曹组","text":"门外绿阴千顷。\n两两黄鹂相应。\n睡起不胜情，行到碧梧金井。\n人静。\n人静。\n风动一枝花影。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64564,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"阮郎归","author":"曹组","text":"檐头风佩响丁东。\n帘疏烛影红。\n秋千人散月溶溶。\n楼台花气中。\n春酒醒，夜寒浓。\n绣衾谁与同。\n只愁梦短不相逢。\n觉来罗帐空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64565,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"声声慢","author":"曹组","text":"重檐飞峻，丽彩横空，繁华壮观都城。\n云母屏开八面，人在青冥。\n凭栏瑞烟深处，望皇居、遥识蓬瀛。\n回环阁道，五花相斗，压尽旗亭。\n歌酒长春不夜，金翠照罗绮，笑语盈盈。\n陆海人山辐辏，万国欢声。\n登临四时总好，况花朝、月白风清。\n丰年乐，岁熙熙、且醉太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64566,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"青门饮","author":"曹组","text":"山静烟沈，岸空潮落。\n晴天万里，飞鸿南渡。\n冉冉黄花，翠翘金钿，还是倚风凝露。\n岁岁青门饮，尽龙山、高阳俦侣。\n旧赏成空，回首旧游，人在何处。\n此际谁怜萍泛，空自感光阴，暗伤羁旅。\n醉里悲歌，夜深惊梦，无奈觉来情绪。\n孤馆昏还晓。\n厌时闻、南楼钟鼓。\n泪眼临风，肠断望中归路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64567,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"青玉案","author":"曹组","text":"田园有计归须早。\n在家纵贫亦好。\n南来北去何日了。\n光阴送尽，可怜青鬓，暗逐流年老。\n寂寥孤馆残灯照。\n乡思惊时梦初觉。\n落月苍苍关河晓。\n一声鸡唱，马嘶人起，又上长安道。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64568,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"青玉案","author":"曹组","text":"碧山锦树明秋霁。\n路转陡、疑无地。\n忽有人家临曲水。\n竹篱茅舍，酒旗沙岸，一簇成村市。\n凄凉只恐乡心起。\n凤楼远、回头谩凝睇。\n何处今宵孤馆里。\n一声征雁，半窗残月，总是离人泪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64569,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"临江仙","author":"曹组","text":"青琐窗深红兽暖，灯前共倒金尊。\n数枝梅浸玉壶春。\n雪明浑似晓，香重欲成云。\n户外马嘶催客起，席间欢意留人。\n从他微霰落纷纷。\n不妨吹酒面，归去醒馀醺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64570,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"品令","author":"曹组","text":"乍寂寞。\n帘栊静，夜久寒生罗幕。\n窗儿外、有个梧桐树，早一叶、两叶落。\n独倚屏山欲寐，月转惊飞乌鹊。\n促织儿、声响虽不大，敢教贤、睡不著。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64571,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"点绛唇","author":"曹组","text":"沈醉归来，洞房灯火闲相照。\n夜寒犹峭。\n信意和衣倒。\n春梦虽多，好梦长长少。\n纱窗晓。\n凤帏人悄。\n花外空啼鸟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64572,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"点绛唇 其一 咏御射","author":"曹组","text":"秋劲风高，暗知斗力添弓面。\n靶分筠干。\n月到天心满。\n白羽流星，飞上黄金碗。\n胡沙雁。\n云边惊散。\n压尽天山箭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64573,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"点绛唇 其一 水饭","author":"曹组","text":"霜落吴江，万畦香稻来场圃。\n夜村舂黍。\n草屋寒灯雨。\n玉粒长腰，沈水温温注。\n相留住。\n共抄云子。\n更听歌声度。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64574,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"点绛唇","author":"曹组","text":"一片南云，定知来做巫山雨。\n歌声才度。\n只向风中住。\n恼乱襄王，无限牵情处。\n长天暮。\n又还飞去。\n目断阳台路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64575,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"点绛唇","author":"曹组","text":"疏柳残蝉，助人离思斜阳外。\n淡烟疏霭。\n节物随时改。\n水已无情，风更无情㬠。\n兰舟解。\n水流风快。\n回首人何在。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64576,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"点绛唇","author":"曹组","text":"密炬高烧，宝刀时剪金花碎。\n照人欢醉。\n也照人无睡。\n待得灰心，陪尽千行泪。\n笼纱里。\n夜凉如水。\n犹喜长成对。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64577,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"点绛唇 其一","author":"曹组","text":"小小朱桥，柳边人过横塘路。\n细风时度。\n□浪痕痕去。\n草软沙平，稳衬寻幽步。\n□□处。\n乱红飞舞。\n回首春城暮。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64578,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"点绛唇","author":"曹组","text":"云透斜阳，半楼红影明窗户。\n暮山无数。\n归雁愁还去。\n十里平芜，花远重重树。\n空凝伫。\n故人何处。\n可惜春将暮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64579,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"相思会/千年调","author":"曹组","text":"人无百年人，刚作千年调。\n待把门关铁铸，鬼见失笑。\n多愁早老。\n惹尽闲烦恼。\n我醒也，枉劳心，谩计较。\n粗衣淡饭，赢取暖和饱。\n住个宅儿，只要不大不小。\n常教洁净，不种闲花草。\n据见定、乐平生，便是神仙了。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64580,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙","author":"曹组","text":"柳絮池台淡淡风。\n碧波花岫小桥通。\n云连丽宇倚晴空。\n芳草绿杨人去住，短墙幽径燕西东。\n攀条弄蕊得从容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64581,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"婆罗门引 望月","author":"曹组","text":"涨云暮卷，漏声不到小帘栊。\n银河淡扫澄空。\n皓月当轩高挂，秋入广寒宫。\n正金波不动，桂影朦胧。\n佳人未逢。\n叹此夕、与谁同。\n望远伤怀对景，霜满愁红。\n南楼何处，想人在、长笛一声中。\n凝泪眼、泣尽西风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64582,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔家傲","author":"曹组","text":"水上落红时片片。\n江头雪絮飞缭乱。\n渺渺碧波天漾远。\n平沙暖。\n花风一阵蘋香满。\n晚来醉著无人唤。\n残阳已在青山半。\n睡觉只疑花改岸。\n抬头看。\n元来弱缆风吹断。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64583,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"脱银袍","author":"曹组","text":"济楚风光，升平时世。\n端门支散，碗遂逐旋温来，吃得过、那堪更使金器。\n分明是。\n与穷汉、消灾灭罪。\n又没支分，犹然递滞。\n打笃磨槎来根底。\n换头巾，便上弄交番厮替。\n告官里。\n驼逗高阳饿鬼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64584,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蓦山溪","author":"曹组","text":"草熏风暖，楼阁笼轻雾。\n墙短出花梢，映谁家、绿杨朱户。\n寻芳拾翠，绮陌自青春，江南远，踏青时，谁念方羁旅。\n昔游如梦，空忆横塘路。\n罗袖舞台风，想桃花、依然旧树。\n一怀离恨，满眼欲归心，山连水，水连云，怅望人何处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64585,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蓦山溪","author":"曹组","text":"洗妆真态，不在铅华御。\n竹外一枝斜，想佳人、天寒日暮。\n黄昏小院，无处著清香，风细细，雪垂垂，何况江头路。\n月边疏影，梦到销魂处。\n结子欲黄时，又须著、廉纤细雨。\n孤芳一世，供断有情愁，销瘦却，东阳也，试问花知否。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64586,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝶恋花","author":"曹组","text":"帘卷真珠深院静。\n满地槐阴，镂日如云影。\n午枕花前情思凝。\n象床冰簟光相映。\n过面风情如酒醒。\n沈水瓶寒，带绠来金井。\n涤尽烦襟无睡兴。\n阑干六曲还重凭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64587,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉花阴","author":"曹组","text":"九陌寒轻春尚早。\n灯火都门道。\n月下步莲人，薄薄香罗，峭窄春衫小。\n梅妆浅淡风蛾袅。\n随路听嬉笑。\n无限面皮儿，虽则不同，各是一般好。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64588,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天","author":"曹组","text":"浅笑轻颦不在多。\n远山微黛接横波。\n情吞醽醁千钟酒，心醉飞琼一曲歌。\n人欲散，奈愁何。\n更看朱袖拂云和。\n夜深醉墨淋浪处，书遍香红拥项罗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64589,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天","author":"曹组","text":"辇路薰风起绿槐。\n都人凝望满天街。\n云韶杳杳鸣鞘肃，芝盖亭亭障扇开。\n微雨过，绝纤埃。\n内家车子走轻雷。\n千门不敢垂帘看，总上银钩等驾来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64590,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其一","author":"曹组","text":"茅屋萧然野水东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64591,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和范公希文怀庆朔堂","author":"曹经","text":"池馆名公旧日栽，几番零落又春开。\n谁人解识红芳意，犹有多情五马来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64592,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]