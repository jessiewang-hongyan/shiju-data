[{"title":"菩萨蛮 其二 别恨","author":"姚宽","text":"梦中不记江南路。\n玉钗翠鬓惊春去。\n午醉晚来醒。\n暝烟花上轻。\n红绡空浥泪。\n锦字凭谁寄。\n衫薄暖香销。\n相思云水遥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37255,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"踏莎行 秋思","author":"姚宽","text":"蘋叶烟深，荷花露湿。\n碧芦红蓼秋风急。\n采菱渡口日将沈，飞鸿楼上人空立。\n彩凤难双，红绡暗泣。\n回纹未剪吴刀涩。\n梦云归处不留踪，厌厌一夜凉蟾入。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37256,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送钤辖馆使王公","author":"姚涣","text":"家传勋力世能贤，四载坤维领帅权。\n南诏酋豪弥款附，西州士庶赖蕃宣。\n输忠感慨由诚府，接下恩勤自意筌。\n月夕过从多命席，花时酬唱旋成编。\n雅歌馀暇军容肃，陟状升闻帝愿延。\n驰驿遽趋三召节，执圭俄觐九重天。\n汉廷仪卫咸祗若，蜀郡朋僚共黯然。\n赐封定应留晷刻，畴庸当便进班联。\n圣神倚注期蕃锡，宥密崇高待九迁。\n下客尘劳遇知己，愿言攀附跂英躔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37257,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题义门胡氏华林书院","author":"姚秘","text":"南纪仙乡景最佳，林泉幽致有儒家。\n门旌孝义为人范，殿试贤能是国华。\n物象四时供野兴，图书万卷益生涯。\n遥思竹阁凭虚槛，下瞰章江浸晓霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37258,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"曹娥庙碑","author":"姚铉","text":"箫鼓声中浪渺瀰，古枫阴砌藓封碑。\n行人到此自恭肃，不似巫山云雨祠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37259,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过松江","author":"姚铉","text":"句吴奇胜绝无俦，更见松江八月秋。\n震泽波光连别派，洞庭山影落中流。\n汀芦拥雪藏鱼市，岸橘风香趁客舟。\n清兴不穷聊一望，烟空云霁倚层楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37260,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赏花钓鱼侍宴应制","author":"姚铉","text":"上苑烟花迥不同，汉皇何必幸回中。\n花枝冷溅昭阳雨，钓线斜牵太液风。\n绮萼惹衣朱槛近，锦鳞随手玉波空。\n小臣侍宴惊凡目，知是蓬莱第几宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37261,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冷泉亭","author":"姚铉","text":"水石一栏杆，僧归四山静。\n携琴谱涧泉，月浸夜深冷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37262,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"翻经台","author":"姚铉","text":"康乐悟玄机，寂寥此栖息。\n经翻贝叶文，台近莲华石。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37263,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"姚铉","text":"疏钟天竺晓，一雁海门秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37264,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"投戴岷隐分教","author":"姚寅","text":"重席先生间世才，相逢青眼必须开。\n手遮红日汗如雨，不是雪中乘兴来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37265,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"养蚕行","author":"姚寅","text":"南村老婆头欲雪，晓傍墙阴采桑叶。\n我行其野偶见之，试问春蚕何日结。\n老婆敛手复低眉，未足四眠那知得。\n自从纸上扫青子，朝夕喂饲如婴儿。\n只今上筐十日许，食叶如风响如雨。\n夜深人静不敢眠，自绕床头逐饥鼠。\n又闻野祟能相侵，典衣买纸烧蚕神。\n一家心在阴雨里，只恐叶湿缲难匀。\n明朝满簇收银茧，轧轧车声快如剪。\n小姑促汤娘剥纰，嬉嬉始觉双眉展。\n缲成白雪不敢闲，锦上织成双凤团。\n天寒尺寸不得著，尽与乃翁输县官。\n君不见长安女儿嫩如水，十指不动衣罗绮。\n我曹辛苦徒尔耳，依旧绩麻冬日里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37266,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"汴京","author":"姚望之","text":"蛇豕腥膻经几年，故都宫阙尚巍然。\n八陵苍莽知何地，九庙英灵如在天。\n重整六军严宿卫，旋兴百堵慰氓编。\n微臣董役惭无补，拟绘新图献榻前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37267,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"龟山禅寺","author":"姚望之","text":"万山深处远轮蹄，古寺雍熙诏赐题。\n坐望竺乾诸佛近，徙凭菌阁十方低。\n灵岩频见玄猿度，琪树应招白鹤栖。\n不觉胜游天已晚，一痕新月印前溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37268,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"琅珰驿","author":"姚清叔","text":"弄臣宁复解输忠，偶契琅珰一语中。\n富贵难亲贫易感，西来方忆曲江公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37269,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢客岩","author":"姚揆","text":"不见古君子，空馀旧林峦。\n翠色媚车马，爽气严衣冠。\n天水交影碧，松竹声相寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37270,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"姚揆","text":"独上西楼四望赊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37271,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游大涤","author":"姚舜元","text":"此是名山第一宫，仙人何在独遗踪。\n玲珑两洞通玄境，突兀一山为柱峰。\n水泛红云出幽谷，风吹苍雪落长松。\n何时觅得人间暇，遍踏烟岚翠万重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37272,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杨高士听弹琴","author":"姚舜陟","text":"我来请雨谒龙公，日脚已敛云冲融。\n解衣盘礴暂小憩，清谈对此两相翁。\n霏霏锯屑引意静，爇鼎忽闻弹丝桐。\n少年水师貌颇古，十指捲袖如剥葱。\n初为宫声变羽调，雅澹更觉神雍容。\n是时昼晷屋角转，汹涌万木鸣西风。\n吹蝉得志竞清啸，恍异人境如天宫。\n兹山颇疑洞府外，地有奇石皆玲珑。\n是何美韵惬振玉，意欲直造无何中。\n尘埃自叹百僚底，谁谓一日欣遭逢。\n更须霖雨起焦旱，兹游可记传无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37273,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题常乐寺五云台","author":"姚舜陟","text":"虚空本无云，一气谁所主。\n云空两无碍，起灭自散聚。\n吾闻心归源，空殒亦无所。\n应知不空者，物感自如雨。\n君看贤首师，自视木与土。\n与云亦奚期，况问色有五。\n云何坐说法，瑞应乃如许。\n休疑诸天集，未必众龙吐。\n云空法如是，我说无说故。\n堂中嫡孙在，客至当问取。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37274,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书驿壁 其二","author":"姚嗣宗","text":"百越干戈未息肩，九原金鼓又轰天。\n崆峒山叟笑不语，静听松风春昼眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37275,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书驿壁 其一","author":"姚嗣宗","text":"踏碎贺兰石，扫清西海尘。\n布衣能效死，可惜作穷鳞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37276,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"畅岩怀古","author":"姚嗣宗","text":"寒谷长留□秋气，畅岩别是一壶天。\n清风不断名犹在，还继宣尼出圣贤。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37277,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题闽中驿舍","author":"姚嗣宗","text":"欲挂衣冠神武门，先寻水竹渭南村。\n却将旧斩楼兰剑，买得黄牛教子孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37278,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"畅岩","author":"姚嗣宗","text":"石作峒房势，水随人意流。\n两岩长溅雨，五月便惊秋。\n此景多深趣，吾心真乐游。\n山翁中宿酒，欲醉五更头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37279,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其二","author":"姚嗣宗","text":"井邑倦炎酷，西岩境独清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37280,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其一","author":"姚嗣宗","text":"大开双白眼，只见一青天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37281,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九姑山最高亭","author":"姚?","text":"一亭重构冠崇冈，下瞰千岩拱四旁。\n作意祇图分野景，凌空因得近天光。\n银河入夜侵衣冷，玉桂乘秋泛席香。\n我辈公馀堪燕集，登临何必待重阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37282,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"净土院","author":"姚愈","text":"劲节摩云岁月深，冰霜不改旧时阴。\n静浮香篆度幽径，冷滴翠光生茂林。\n明月满窗横好墨，清风入指接黄金。\n个中领取西方意，梦落人间何处寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37283,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宝岩寺","author":"姚愈","text":"浮图插云表，列嶂环古刹。\n平湖眇澄波，万态天光发。\n我来陟层巅，秀气助毫末。\n扁舟返明月，万顷玻璃滑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37284,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽老苏先生 其二","author":"姚辟","text":"羁旅都门十载中，转头浮宦已成空。\n青衫暂寄文安籍，白社长留处士风。\n万里云山归故国，一帆江月照疏篷。\n世间穷达何须校，只有声名是至公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37285,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽老苏先生 其一","author":"姚辟","text":"持笔游从已五年，忽嗟精魄去茫然。\n茂陵未访相如藁，宣室曾知贾谊贤。\n薤露有歌凄晓月，绛纱无主蔽寒烟。\n平生事业文公志，应试乡人白玉镌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37286,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"望文脊怀瞿硎先生","author":"姚辟","text":"文脊山中姓已逃，江城争美少微高。\n应知司马来窥鼎，便学秦人去种桃。\n海上音书断鸿雁，洞中吟啸伴猿猱。\n鹿裘谁识先生志，却把虚词倚伏滔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37287,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"灵岩","author":"姚辟","text":"泉石平生性所耽，谢公延我到东南。\n红莲幕下烦佳客，文脊山中访旧岩。\n剪竹扫花寻鸟道，扪萝随衲问龙潭。\n图经未尽幽潜事，待向仙家起玉函。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37288,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"涟漪洞","author":"姚辟","text":"五门高险势摩天，洞底清泠泻碧涟。\n蘋藻鱼游知暮雨，薜萝人去锁寒烟。\n山樱已熟垂朱实，岩竹新抽露玉鞭。\n只恐游人归马急，野僧何惜白云眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37289,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游山门呈知府大卿","author":"姚辟","text":"春风到宛陵，太守遇康乐。\n隐几坐高斋，清风媚林壑。\n语我诸峰峦，道人古栖托。\n幽潜远江汉，秀耸类衡霍。\n一日赆我游，大府辍高幕。\n命车载酒醪，行人饬巾櫜。\n蓝舆渡前溪，野饭即高阁。\n笑著乌纱巾，行背青山郭。\n嵇吕重契旧，皮陆索酬酢。\n幽花弄紫翠，鸣琴唱宫角。\n灵气浮融融，蒸风纷漠漠。\n晚宿黄渡馆，泉声自伊洛。\n溪童学流觞，盘花递清酌。\n归火破昏街，拥衾闻夜柝。\n诘朝振衣坐，缫车厌啼?。\n东壁有旧诗，三贤据安作。\n笔迹既讹谬，尘版复皴皵。\n伊人已黄泉，来者谁丹雘。\n徐徐到山门，青苍洗昏膜。\n两山擘大道，造化自橐籥。\n绿蒂凌空飞，江云半天落。\n二岩与四洞，灵仙旧淹泊。\n丹凤今不归，双门失扃钥。\n云髓凝为乳，石柱垂如铎。\n峭壁断行路，薜萝阴附著。\n秉烛寻龙潭，昏冥认头角。\n欲窥心已惊，暂进足还却。\n不探骊珠渊，安得长生药。\n又上齐云亭，诸山露崖崿。\n或涌如波涛，或沸如鼎镬。\n幡幢或飞动，塔庙或缨络。\n盛如明堂朝，衣冠势纷错。\n尊者不避卑，强者不凌弱。\n严如武库兵，雪霜饰锋锷。\n柔顺就赦宥，刚顽即侵掠。\n或齐如季孟，或比如媒妁。\n连如鱼缀钩，猛如兽相搏。\n横如斗东西，勇如龙潜跃。\n欲尽听眺心，疲羸厌芒屩。\n野僧又语我，文脊倚寥廓。\n我思鹿裘人，不惮路硗确。\n左瞻右已迷，前登后皆邈。\n攀高猿臂引，入险腰■缚。\n辛勤到深幽，祠宫冷萧索。\n金丹已无传，石室俨如昨。\n咨嗟两台高，日月互盘礴。\n石豹鸣阴崖，鹰龟露金壳。\n天河泻云潭，千丈不见浊。\n众指佛子堂，神灵重然诺。\n我坐谢公亭，归舟阻溪涸。\n爇萧阴祷祈，暮雨过山脚。\n善济虽未通，神变已可愕。\n蠢蠢尘中人，回首重惭怍。\n屈曲归杜迁，复结三天约。\n傍楫清溪行，万象皆洗濯。\n石苔散青丝，玉笋解新箨。\n路回滩流淙，洒面散雨雹。\n鱼禽遂天性，浮沉随饮啄。\n行行明镜中，两岸翠如幄。\n停桡到妙显，洞府谁开拓。\n我知巨灵斧，神妙止一削。\n狻猊俨守卫，琼瑶出追琢。\n幽兰香自知，褊茗甘可嚼。\n老木卧深坞，不肯就工度。\n苍石通元精，温润抱天璞。\n古有智琰师，逍遥寄冥寞。\n四兽虽吾降，一性奚所恶。\n天子赐诏勤，香象与醍酪。\n徘徊想遗风，愚迷仰真觉。\n又疑无为人，其来非力学。\n洞门有磨崖，唐贤盛镌凿。\n姓名今尚存，苔藓已斑驳。\n游者来无穷，居者日益数。\n人事竟糠秕，尘缘易糟粕。\n唯有稽亭峰，巍峨不销铄。\n仁智乐山水，小大等拳勺。\n养心即自然，玩物乃浮薄。\n我今还海涯，身不挂缯缴。\n世无丹青人，为我一图貌。\n试作山中吟，高情寄鸾鹤。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37290,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其三","author":"姚辟","text":"潮捲乱峰横几席，沙填重险变桑麻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37291,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其一","author":"姚辟","text":"京洛黄尘久倦游，一官来寄海边州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37292,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其二","author":"姚辟","text":"初日光回天尚暝，暮潮声落地先秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37293,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"姚颖","text":"六典未新周礼乐，三河正想汉官仪。\n平生作计非温饱，可但区区诧郤枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37294,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题絜斋书院","author":"姚颖","text":"鹅湖鹿洞两优游，吾道南来谁与俦。\n鄮地传心化已洽，堇山遗教泽长留。\n空阶向日春风度，栋宇凌云化雨周。\n声誉已垂百世后，长江虹水不空流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37295,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽赵秋晓 其二","author":"姚燃","text":"一枕春婆梦，如君亦可悲。\n人间无著处，天上有归期。\n光岳失英气，江湖欠好诗。\n莫愁身后事，跨灶有诸儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37296,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽赵秋晓 其一","author":"姚燃","text":"已矣嗟麟趾，青衫正少年。\n才优合芸阁，时异倏桑田。\n雨散伤同辈，风流瘗九原。\n何当刍一束，挥泪玉人前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37297,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"访中洲","author":"姚镛","text":"踏雨来敲柳下门，荷香清透紫绡裙。\n相逢未暇论奇字，先向水边看白云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37298,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谒金门","author":"姚镛","text":"吟院静。\n迟日自行花影。\n熏透水沈云满鼎。\n晚妆窥露井。\n飞絮游丝无定。\n误了莺莺相等。\n欲唤海棠教睡醒。\n奈何春不肯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37299,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"霓裳中序第一 春晚旅寓","author":"姜个翁","text":"园林罢组织。\n树树东风翠云滴。\n草满旧家行迹。\n时听得声声，晓莺如觅。\n愁红半湿。\n煞憔悴、墙根堪惜。\n可念我、飘零如此，一地送岑寂。\n龟石。\n当年第一。\n也似老、人间风日。\n馀葩选甚颜色。\n羞撚江南，断肠词笔。\n留春浑未得。\n翻些入、啼鹃夜泣。\n清江晚，绿杨归思，隔岸数峰出。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37300,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"洪遂良自京师东归赠以诗","author":"姜大民","text":"故山西郭有园林，之子东归抱短琴。\n衣锦未论当日事，首丘聊慰阿翁心。\n春风桑梓欢娱极，秋雨松楸感慨深。\n莫写渭阳图画里，令人披阅重沾襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37301,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游枋口","author":"姜正","text":"山如削玉水涵秋，人在冰壶月底游。\n劫火半空尘世换，不知此处几登舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37302,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送张无梦归天台","author":"姜屿","text":"鲲鹏运海涯，岂复顾泥沙。\n龙虎常为畜，乾坤不定家。\n玉泉生白石，紫府种黄芽。\n此境人难到，归程自有槎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37303,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西湖竹阁寺","author":"姜竹野","text":"来此琅玕影里吟，更于何处觅山林。\n千年清事无人管，独有香山领此心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37304,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"船子和尚西亭","author":"姜竹野","text":"船翻亭迹尚依然，动有风波静有天。\n人世不知行实地，每于船上又安船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37305,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"简高澹轩","author":"姜竹野","text":"西风篱下菊班班，想得吟肩正耸山。\n急遣曲生陪杖履，要传好句出人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37306,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贺兄得节二首 其二","author":"姜邦达","text":"夜雨当年旧话空，草庐应记乱山重。\n归来若上松楸望，前对南屏巾子峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37307,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贺兄得节二首 其一","author":"姜邦达","text":"难兄位品亚司空，腰下金章指日重。\n昼锦荣归何太晚，举头何啻仰高峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37308,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贺兄得节寄诗二首 其二","author":"姜邦佐","text":"老气峥嵘薄远空，才名一世许谁重。\n已将功业酬身了，却把梅山作隐峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37309,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贺兄得节寄诗二首 其一","author":"姜邦佐","text":"千年华表插高空，归日呼声彻九重。\n城郭人民俨如昨，不应忘却白云峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37310,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪夜问梅","author":"姜补之","text":"一年春事五更初，梦觉寒香乍有无。\n门外不知深浅雪，只应消瘦玉肌肤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37311,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过黄花渡","author":"姜迪","text":"回首潇湘二十春，江南投老未安身。\n如今再过黄花渡，遥想湘山是故人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37312,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乙卯春自郡归赏牡丹适有故竟回唯魏紫略放二头 其一","author":"姜特立","text":"归早开迟两寂寥，经年不见董妖娆。\n芳心未展缘何事，半是閒愁半是娇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37313,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乙卯春自郡归赏牡丹适有故竟回唯魏紫略放二头 其二","author":"姜特立","text":"梦想看花归意浓，归来底事别花忙。\n魏家姊妹知人意，先试春风半面妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37314,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乙卯种牡丹","author":"姜特立","text":"课仆舁丰壤，辛勤种牡丹。\n不知从此去，更得几春看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37315,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丁未九日青宫侍饮","author":"姜特立","text":"重阳开燕侍清躬，次第携壶到菊丛。\n仙手撚花亲泛酒，此时荣遇少人同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37316,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"二月有霜海棠颇瘁","author":"姜特立","text":"青春淑景忽飞霜，馀烈犹能到海棠。\n中山靖王孺子妾，尚书门下主讴娘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37317,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"二月道傍梅花","author":"姜特立","text":"腊底春前探物华，一枝初发竞相誇。\n如今千树离披后，却爱迟开三两花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37318,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]