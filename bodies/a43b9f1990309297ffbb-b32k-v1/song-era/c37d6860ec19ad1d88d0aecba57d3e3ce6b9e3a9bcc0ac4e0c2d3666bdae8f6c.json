pointer":20921,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"醉中偶成","author":"乐雷发","text":"醉敲茶臼啸秋烟，苦欠高阳买酒钱。\n拟入乱山餐柏叶，石床閒对麝香眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20922,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题王尧章伫香亭 其三","author":"乐雷发","text":"故园荷屋傍濂溪，苦爱莲花入梦思。\n今日题诗还自笑，江湖尘土鬓成丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20923,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题王尧章伫香亭 其一","author":"乐雷发","text":"满池蜀锦照深衣，尽日凭栏课楚词。\n要识此花香绝处，露凉风细雨晴时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20924,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题王尧章伫香亭 其二","author":"乐雷发","text":"对花味道兴何长，好学颜家到坐忘。\n莫与红尘儿辈道，心清正自得真香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20925,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题杨从行湘诗卷 其二","author":"乐雷发","text":"叫云吹玉舜祠边，醉嚼琼糜漱石泉。\n旧读离骚今忘却，快披秋卷嗅兰荃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20926,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题杨从行湘诗卷 其一","author":"乐雷发","text":"仙云寒锁碧瑶天，突兀吟坛北斗边。\n试问凤凰谁得髓，竹林听雪对床眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20927,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题昭州田廷亮书稿后 其二","author":"乐雷发","text":"少海无波鹤禁虚，满朝闭口养曹蜍。\n白袍乌帽和宁外，却有山人请建储。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20928,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题昭州田廷亮书稿后 其一","author":"乐雷发","text":"槟榔口里吐参苓，折槛无门九虎深。\n家在道乡亭畔住，定应千古有知音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20929,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠吴季诗","author":"乐雷发","text":"燕子楼头一曲春，曾骑骄马掷黄金。\n如今世事漫头雪，破屋孤灯忍冻吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20930,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠李伯辉家谱诗","author":"乐雷发","text":"荡寇将军后，唐朝李郤家。\n绿华双荐者，况复古今誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20931,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"下第归后李伯辉李景魏索近诗","author":"乐雷发","text":"吟遍吴头楚尾春，多惭词客问征尘。\n振衣天目寻黄独，濯足湘江咏白蘋。\n宋五已惭称进士，陈三何用作诗人。\n锦囊原属君家有，分买鱼经理钓轮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20932,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"下摄市","author":"乐雷发","text":"吟到湘潭一叶黄，贾胡踪迹正悲凉。\n抱琴沽酒异乡客，打鼓发船何郡郎。\n楚女越商相杂沓，淮盐浙楮自低昂。\n尘埃市井无人识，濯足江头望八荒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20933,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与李盘翁知县登七星山吊石道士","author":"乐雷发","text":"叠嶂矗空青，耽幽共一寻。\n苔荒碑意古，茗苦道情深。\n有兴梯苍壁，无才咏玉簪。\n吟仙何处去，我辈复登临。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20934,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小舣袁家窑竹居买酒","author":"乐雷发","text":"江绕衡门接旅津，鲤鱼风歇水粼粼。\n湘醨三盏浇吟思，潇碧千竿对老身。\n题笔未能行客醉，典琴不用主人贫。\n隔江谁掉高名丽，满载鸬鹚捉锦鳞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20935,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书萧千岩集","author":"乐雷发","text":"向来杨陆共峥嵘，吟到停云趣转清。\n古似洞庭张雅乐，严如即墨敛残兵。\n茵蔯终不肥方朔，芣苡何堪病冉耕。\n细读残编搔白首，未应造物忌诗名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20936,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"归侍","author":"乐雷发","text":"石田茅屋野苔春，喜对庭闱话苦辛。\n客路本无如意事，瘴乡难有却回身。\n且寻农耒耕湘雨，待看天戈洗鞑尘。\n门外黄旗边饷急，可堪杯酒各伤神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20937,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戊戌冬仆客桂林雪中赵叔愚书张司业逢贾岛绝句为寄今冬对雪感而有作","author":"乐雷发","text":"朔风于水浸琼沙，曾共骚翁理钓槎。\n对酒又吟端木叶，论诗还忆款冬花。\n饥能驱我瓶储罄，老不饶人镜影华。\n拟唤扁舟寻剡叟，岭梅潇菊各天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20938,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"记萧大山父子","author":"乐雷发","text":"仙桂灵椿各典刑，飘飘姿韵激天鲸。\n家传八叶盐梅种，诗接三苏父子名。\n四海尽将看县谱，一堂那许与文盟。\n尘埃不敢相亲炙，且汲渝溪濯客缨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20939,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵史主簿雨夜见寄","author":"乐雷发","text":"水长许由溪，春寒入竹扉。\n几人听夜雨，惟我怯单衣。\n树罅青灯耿，篱根白菌肥。\n明朝有忙事，推枕问渔矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20940,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江华送熊清父游广州时予有衡阳之役","author":"乐雷发","text":"邂逅阳华且酒壶，海鹏衡雁各征途。\n閒身俱被饥寒役，老境还堪离别无。\n乡梦定应思款段，客吟何用说娵隅。\n曾从仙叟参玄诀，好访安期采涧蒲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20941,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"许介之以丞相周益公所书古乐府四篇见寄敬题其后","author":"乐雷发","text":"纸上珊瑚间木难，曾敲黄阁卸吟鞍。\n赏音今有平园否，得句堪寻岣嵝刊。\n鹦鹉夜栖金屋冷，的卢秋战玉关寒。\n春风归雁那知己，寄与深宫绝塞看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20942,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]