[{"title":"垂丝海棠","author":"任希夷","text":"宛转风前不自持，妖娆微傅淡胭脂。\n花如剪綵层层见，枝似轻丝袅袅垂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27647,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郊坛斋宫七首 其七","author":"任希夷","text":"汉苑空传承露盘，不闻临幸又春残。\n吾君恭俭前无比，只向郊祠响玉銮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27648,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郊坛斋宫七首 其五","author":"任希夷","text":"当日金阶白玉堂，不知春事到垂杨。\n休惊冉冉花飞片，正爱青青麦耀芒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27649,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郊坛斋宫七首 其四","author":"任希夷","text":"荣路辉辉日月依，云霄奕奕孔鸾飞。\n辅臣对罢升金殿，日日丝絇侍衮衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27650,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郊坛斋宫七首 其三","author":"任希夷","text":"玉津宏建中兴初，禁籞风光胜两都。\n惭愧逢辰瞻蠖濩，却思归老卧廜㢝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27651,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郊坛斋宫七首 其二","author":"任希夷","text":"上林日射苍龙阙，九陌风清野马尘。\n恰似楼台临渭水，未饶桃李满天津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27652,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郊坛斋宫七首 其一","author":"任希夷","text":"郊禋从昔重升中，八陛崇尊典礼隆。\n圣主寅恭先事举，云阳新筑望祠宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27653,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"青溪 其一","author":"任希夷","text":"蛾眉流落碧流中，走马来时事已空。\n此日不能留妲己，他年谁敢忆高公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27654,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"青溪 其二","author":"任希夷","text":"青溪不见丽华留，遗恨空馀故国羞。\n璧月只应明结绮，春风吹不上迷楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27655,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"青溪 其三","author":"任希夷","text":"闭门忽忆东风面，步向青溪绕碧湾。\n淡白深红了无迹，绿杨烟外一钟山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27656,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南朝故迹惟天禧凤凰台鹿苑寺郗氏窟为最久","author":"任希夷","text":"有泉何取台仪凤，事佛空教后作蛇。\n狐穴蚁巢零落尽，却能留此梵王家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27657,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"城东怀古","author":"任希夷","text":"谢安游处犹留墅，李白吟边亦有亭。\n两地东山春寂寂，至今白下柳青青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27658,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"钟山春游 其一","author":"任希夷","text":"青楼醽醁客中圣，碧苑鞦韆人半仙。\n春满江南佳丽地，绿杨芳草思娟娟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27659,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"钟山春游 其二","author":"任希夷","text":"柳边淮水一般绿，花底钟山分外青。\n闲趁游丝不知远，夕阳才过已疏星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27660,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宴玉津园江楼七首 其七","author":"任希夷","text":"柳花驰道雪，樱子上林红。\n留得青春住，从教白发翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27661,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宴玉津园江楼七首 其六","author":"任希夷","text":"翼翼瞻斋殿，深严步苑廊。\n三人俱汉杰，一老玷周行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27662,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宴玉津园江楼七首 其五","author":"任希夷","text":"浙江天阙下，波恶祖龙知。\n在汉如西渭，于周比右伊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27663,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宴玉津园江楼七首 其四","author":"任希夷","text":"参天宫柏翠，布地禁花红。\n台沼如文囿，规摹有汴风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27664,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宴玉津园江楼七首 其三","author":"任希夷","text":"虚斋留御榻，小径近层崖。\n再拜观奎画，浑疑侍玉阶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27665,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宴玉津园江楼七首 其二","author":"任希夷","text":"风光连北阙，景物傍西湖。\n禁籞涛江上，兹楼天下无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27666,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宴玉津园江楼七首 其一","author":"任希夷","text":"风静潮痕减，江空夕照多。\n星星波上艇，隐隐岸边莎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27667,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"达磨大师赞 其二","author":"释道冲","text":"人皆有心，人皆作佛。\n胡为西来，递相诳惑。\n心在何处，佛是何物。\n带累神光无处寻，后代儿孙厮淈?。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27668,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"海棠","author":"任希夷","text":"山碧花尤好，径长人自閒。\n锦围春照耀，红雨暮阑斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27669,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"莲","author":"任希夷","text":"五月荷池未见花，但擎馀盖碧参差。\n何人唤起凌波步，要见晨妆出晓霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27670,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"假面铺","author":"任希夷","text":"圣朝久变文身俗，四海谁非革面人。\n此地胡为名未改，犹胜酬伪必言真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27671,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"扈从朝献四首 其一","author":"任希夷","text":"齐宿连宵凤掖西，才交五鼓著朝衣。\n明当接盏天兴殿，免从金舆入殿帏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27672,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"扈从朝献四首 其四","author":"任希夷","text":"礼官前导赭黄袍，陟降灵宫九陛高。\n二十七筵俱再拜，精虔不惮圣躬劳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27673,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"扈从朝献四首 其三","author":"任希夷","text":"扈从齐宫每赐茶，玉瓯常瀹建溪芽。\n今朝值雨传宣免，只向阶前侍翠华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27674,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"扈从朝献四首 其二","author":"任希夷","text":"夕郎同列升金殿，分立虚皇宝座前。\n天子参神来缛位，侍臣夹跪御炉边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27675,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"检院即事","author":"任希夷","text":"禁路风清飞蚤鸦，官卑难望紫宸衙。\n了无公事钩帘坐，一本冬青落细花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27676,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绿萼梅二首 其二","author":"任希夷","text":"萼绿华堂艮岳东，梅花万数绕离宫。\n宣和旧事无人记，粉面含凄向朔风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27677,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绿萼梅二首 其一","author":"任希夷","text":"绿趺黄蕊衬瑶华，霜雪林中自一家。\n最好月寒迷粉素，翠钿依约独横斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27678,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"野花","author":"任希夷","text":"野径风来阵阵香，名花未省植何方。\n却思一卉何能尔，应是春原集众芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27679,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"植芙蓉有怀","author":"任希夷","text":"为爱秋花霜后红，故栽千树待西风。\n却思少日拊头语，泪落花前鬓影髼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27680,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游陶仙观林公辨诗 其二","author":"任希夷","text":"木落风高八月天，山荒屋老意萧然。\n道人香火但灰冷，何处如今更有仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27681,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游陶仙观林公辨诗 其一","author":"任希夷","text":"偶来殊恨酒尊空，只有青山对秃翁。\n细把故人诗卷读，却疑谈笑在闽中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27682,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赋梅下小池","author":"任希夷","text":"眼见梅花照玉堂，只今浓绿覆宫墙。\n樛枝偃盖云千叠，下荫清池玉一方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27683,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赏桂 其一","author":"任希夷","text":"人间植物月中根，碧树分敷散宝熏。\n自是庄严