[{"title":"元夕偶成","author":"苏籀","text":"里唱涂讴铙吹轰，软尘梁苑记前生。\n宝珠穿蚁嬉游肆，莲蕊然犀不夜城。\n透碗灯繁人昼绣，隔罗光酝酒渑清。\n春娃环舞云阶隘，邦媛鲜妆月地行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1302,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"公退三首 其三","author":"苏籀","text":"缺然资略每区区，抑冒扬清小小劬。\n诹律纲条思济理，算缗公帑较输储。\n三科识擢才能显，八计精研吏治孚。\n端有硕生如杜蒉，升堂洗觯降除趋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1303,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"公退三首 其二","author":"苏籀","text":"缪簉康庄列大夫，沈研历久到盘盂。\n囊馀佔毕乾萤火，家有凌云旧履凫。\n般若初心依耋老，参同内事靳儒臞。\n吐音悫讱尝闻见，邂逅周旋只小巫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1304,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"公退三首 其一","author":"苏籀","text":"披文不释遗编慕，耽禄终惭远贿称。\n劫劫抗尘非胜趣，寥寥出世有真乘。\n转头值寓无穷极，措足虚邪粗可胜。\n管晏空忧觉先物，未须薄薛与卑滕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1305,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"六月不雨至七月中自宽一首","author":"苏籀","text":"宿舂仅有忧将竭，嘉穗连云委暵旸。\n厦屋珍台求暂寓，桃笙葵扇殆难当。\n荷烝兰藉肴溪涧，藕脆萍馨饭莽苍。\n龙火西颓已辰浃，何时得见雨浪浪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1306,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"勾龙君贶求所居垂荫亭岷堂二首 其二","author":"苏籀","text":"岷阳英杰古贤乡，侍史香炉今望郎。\n柬擢欲书丹凤诏，梦魂勤到碧鸡坊。\n已应盛美摽其茇，不比畸人愚厥堂。\n宦牒随江归碧海，读书源派亦诚长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1307,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"勾龙君贶求所居垂荫亭岷堂二首 其一","author":"苏籀","text":"葱蔚敬亭非索漠，几希陶宅绕扶疏。\n江山壮观惟人助，祖祢高情陟彼砠。\n雄笔仙才镌勒见，属车尘界默存书。\n柴荆虽掩渔竿挂，旌戟嵯峨表旧庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1308,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王季海求父宣义挽词二首 其二","author":"苏籀","text":"里仁巾几寂，遗懿满瞻听。\n济美圭璋质，流芳琬琰铭。\n纸灰霏似雪，巷泣洒将冰。\n念念存伽释，超超拔九冥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1309,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王季海求父宣义挽词二首 其一","author":"苏籀","text":"缮性克知命，乡评行实尊。\n传经拾科第，綵服匝庭轩。\n韡萼专方面，良弓补谏垣。\n金坡振词笔，品藻不胜言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1310,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬日即事一首","author":"苏籀","text":"蜡栀五万酬鞭直，洴絖百金真食封。\n萧散不萌争闹趣，真醇缪觊养生慵。\n涤清研里憨凡笔，磨澈鉴中嚬窘容。\n晹旱玄冥僭春令，狐裘羔酒贮严冬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1311,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"永嘉周道人求诗一首","author":"苏籀","text":"气升期汗漫，世法一黔娄。\n启钥因师旨，咀芝从祖求。\n肆言谐律吕，不梦本精修。\n王室金堂迩，飘飘竹杖游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1312,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"仲秋较试净惠精舍会者六人约重九事毕置醴谢汤巩方以诗坚约次韵酬之","author":"苏籀","text":"稷下铢铢鉴择分，品评一目百知闻。\n初矜月殿挥毫赋，直到龙山吹帽文。\n邀勒公荣狎嵇阮，薰涂嫱媛侍渊云。\n尘惊珠贯纤罗袜，酹酒银篦不怕醺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1313,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"休沐日","author":"苏籀","text":"洗砚酬缄复论文，金书瑶笈忌膻荤。\n搔头冷枕遗簪弁，浣垢凉床洁帨帉。\n炀灶筚门无量燠，夏畦褐父若为芸。\n鸿飞遵陆抟寥廓，凫鹜胡然顾涧芹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1314,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"后数朝复依前韵二首 其二","author":"苏籀","text":"恤患周流喜逮鳏，当官掣肘汗惭颜。\n预虞飘兀筏能驾，取次耕犁手欲删。\n月窟日畿遵驿置，燕南越北洗恫瘝。\n一廛清佚陶元亮，万斛閒愁庾子山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1315,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"后数朝复依前韵二首 其一","author":"苏籀","text":"下国官臣无懈时，矫然白首瞩嵚嶷。\n鼠攘剪灭雷霆令，魃虐萧骚霈泽医。\n廉裤移文谨钤键，萧斋丝管覆玻瓈。\n烛阑松桂冥冥雾，赤豹文狸不许窥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1316,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岁晏即事","author":"苏籀","text":"硙霏白雪舂云子，盘摘黄金割蜜房。\n组织翻腾不停杼，芳甘酝酿馈先浆。\n西成仅有储囷窄，中土才归置枕康。\n敕赐宗盟旌德刹，扈阳珍木蔚葱苍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1317,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"巩采若求厥父令尹德秀挽诗","author":"苏籀","text":"东鲁怀经慕先哲，斋房僻处盛门徒。\n勉陪流寓推乡校，优选文华庆仕涂。\n议狱蚩氓生活路，削锄奸轨亟扬枹。\n遗编亹亹乘儒典，济美弓裘后世模。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1318,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"朱从事安诗挽词一首","author":"苏籀","text":"文阶王命渥，驯侃洽乡阛。\n末俗贾三倍，尤能赈百锾。\n宗盟遵倚阙，邑落旧知潸。\n翳翳佳城郁，镵山殆弗删。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1319,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"朱亭伯改转见过一首","author":"苏籀","text":"三就可怜繁马颈，一鸣须信绝鸡群。\n絷维才骏殊旌别，籍甚名声奈耳闻。\n浩渺池庭辈鸿鹭，腾轩馆殿擢兰芸。\n相容历稔逃诗债，大白惟当浮劝君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1320,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵孙邦求少监游刘园一首","author":"苏籀","text":"权使将军势不行，连云鸳甃鸟乌晴。\n池台溢郭锁扃固，林樾半空甍栱赪。\n席帽扬鞭来看鹤，绮疏褰幌政闻莺。\n贺兰青海勋名事，雅意未谐幽与并。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1321,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵范机宜感怀","author":"苏籀","text":"圭组纷纷蚁慕膻，徇人可否冀超迁。\n伤哉远略疲中国，恸矣长星出亘天。\n晋楚春秋书失国，惠昭徒驭竟言旋。\n朝廷得士为强弱，郭隗来归不首燕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1322,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵洪六丈舍人苏黄马券一首","author":"苏籀","text":"长鸣天厩起毛龙，万马皆喑一洗中。\n立仗式仪稽马叟，解骖牵赐有裴公。\n累年兵火苏黄迹，旧券山河带砺同。\n揽笔诗翁拟骚雅，雄然台阁快哉风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1323,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵洪令三月晦见寄","author":"苏籀","text":"掺袂东君属此觞，朱明履运返何乡。\n结成硕果鹂鹒语，吹尽落花桑柘光。\n梅雨闻君醉山阁，麦风招我步濠梁。\n惜春岁月那相贷，肠断连山草树长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1324,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵洪令谷瑞平远台","author":"苏籀","text":"能赋凭高所得多，海云岩崿若君何。\n兼通西竺瞿昙意，欲和南风虞舜歌。\n怪石甘泉作檀施，长廊古殿荫多罗。\n相期正始微言绪，诗眼休嫌俗吏过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1325,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵洪谷瑞见和","author":"苏籀","text":"此间空洞最无奇，整整从绳仅满规。\n并谱沈芗及苓藿，公言羊质录鸮鸱。\n秃巾鲍肆穿芒屩，争席畦丁与马医。\n海浸冰销元凯癖，玉杯繁露董生帷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1326,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵洪谷瑞模临皋亭四画","author":"苏籀","text":"退笔残煤作冢池，庶几极力更前追。\n寻源巴峡涛泷派，得骨柯山铁树枝。\n京口风云随叱咤，渭川霆电扫端攲。\n刻舟事往何嗟及，拙目高心付黠痴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1327,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵答晁以道见赠二首 其一","author":"苏籀","text":"骨髓缄藏万古谋，畔牢愁思不禁秋。\n常怜屈宋鸣中古，不遇丘轲放一头。\n文赋东坡推典丽，简书西路失归休。\n看公议论方游夏，岂数苏州与柳州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1328,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"汲东坡所浚井一首","author":"苏籀","text":"帅贰英英驻节旄，继唐流泽便滔滔。\n源深东绝三桥市，涨缩西湖二寸篙。\n沟驶甃坚无旱潦，瓶翻筒漏饮豚羔。\n私家诵佛千畦稻，官帑收功万斛醪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1329,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观兵","author":"苏籀","text":"错捐金带子舆台，李典张辽安在哉。\n济溺我应知大略，摧锋人自得高才。\n伍符勤选加搜练，戎阃徐图妙鉴裁。\n引领山西十万骑，中原失御实堪哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1330,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"访鹿田二首 其二","author":"苏籀","text":"夕阳红晒稊生粉，晓露凝清栗脱蓬。\n乐岁人并厖彘饱，高城地隔马牛风。\n禽鼯天籁互鸣啭，林薄山屏竞蔚蓊。\n采杞撷芎薪水暇，吾从庞老兴何穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1331,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"访鹿田二首 其一","author":"苏籀","text":"隐士云凝北山麓，将军树竦碧崖寒。\n乌犍户富犁千亩，苍簳梯空擢万竿。\n荦荦马鞭贪快睹，森森僧席饫奇观。\n未应泉石减天竺，自古英灵招考槃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1332,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过故丞相吕汲公坟刹二首 其二","author":"苏籀","text":"缠绵思旧赋，沈痛八哀篇。\n宇宙门人尽，谋谟国史传。\n高闳人莫及，何代独无贤。\n欲说源流远，还应笔似椽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1333,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过故丞相吕汲公坟刹二首 其一","author":"苏籀","text":"元祐推谐弼，乾坤岂小康。\n曹参尚清净，萧傅性刚方。\n报国无遗恨，兴邦举旧章。\n累年公议白，名与日星光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1334,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"何会卿妇清河张甥挽诗","author":"苏籀","text":"常念注西竺，浮生付六如。\n良人怆中馈，二稚未胜裾。\n妯党抆红泪，乡邻隘众车。\n金花它日诰，封号表松樗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1335,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"何武翼挽词","author":"苏籀","text":"横槊褫神佩，追随井钺军。\n周旋圉徼最，首虏驿书闻。\n斡榷承心计，污邪续力耘。\n门庐必高大，训子扩儒文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1336,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冻雨一首","author":"苏籀","text":"淋淋冻雨滴春朝，正月寒威倍凓憀。\n汩淖不甘劳皂隶，执舆岂必胜刍荛。\n素餐致寇思长策，失业疲氓想易招。\n驯伏强豪苏馁乏，济时筹略直须超。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1337,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"园人饷果","author":"苏籀","text":"紫绛李杨卢杏黄，红腮脆碧磊篝箱。\n春风媚世葩华过，夏日荐茶冰蜜尝。\n瓜步它时邵平意，木奴晚节李衡穰。\n君看饤坐百端辑，腐蠹萧然自弭忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1338,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"张子安求无外道人挽词 其二","author":"苏籀","text":"芙蓉城阙宜通籍，姑射山头素卜邻。\n举世难工断肠句，何时再得捧心人。\n芝兰奕代传遗懿，玉树千年锁暗尘。\n珍重清风入襟袖，每篇佳处想精神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1339,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"张子安求无外道人挽词 其一","author":"苏籀","text":"奉匜谁过仲卿贤，独泣牛衣枕泪眠。\n墨误唾花衫未故，诗题摘叶柹犹鲜。\n悽凉玉雪卿卿意，惆怅房栊步步莲。\n抚念琴书旧同赏，爵名重刻更巍然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1340,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"张孺人九十六岁签判求眉寿堂诗二首 其一","author":"苏籀","text":"鹊巢流庆嗣如参，鹤发人间仰达尊。\n经眼尽知三世事，含饴已看几重孙。\n承颜捧诏疏封邑，扇枕温床不倚门。\n取数西方无量佛，满堂氛馥贝多翻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1341,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"拟古","author":"苏籀","text":"六州斋榻釂分鹅，谁料延平最解歌。\n蒲阪崔姝白楼少，阖闾吴馆冶容多。\n频烦画戟凝芗寝，辍选鸾篦插皂罗。\n勿俾台山洞天侣，眇无刘阮醉颜酡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1342,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"李监庙求拙轩一首","author":"苏籀","text":"镘圬累瓴甓，几席面春丛。\n林坞纯真趣，衣巾质古风。\n宁非迂叟合，岂与漫郎同。\n不巧姑云尔，何妨诗更工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1343,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"近市一首","author":"苏籀","text":"摩肩蹑足吁屠贩，接衽骈颅坌驵筲。\n巷隘姑名为小隐，宾佳不必有珍肴。\n龙钟游宦如投耒，琐屑侨民一系匏。\n丘索典坟心迹远，烟埃咫尺自喧淆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1344,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"连雨作寒二首 其二","author":"苏籀","text":"未应牢杜敬通关，寄傲足怡元亮颜。\n冗龊凡庸何异目，粗疏潦倒幸投閒。\n平生那识贾三倍，晚节犹窥道一斑。\n调燮裁成真大治，茂弘先进实非孱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1345,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"连雨作寒二首 其一","author":"苏籀","text":"三杯卯酝雨轻寒，鼓腹侏儒恃县官。\n樵指汲肩亲课督，僧签禅榻谢雕钻。\n龛灯危蕊挑停久，编秩雌黄点?乾。\n未许汉阴修浑沌，周诗三百近研观。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1346,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"连雨偶成二首 其一","author":"苏籀","text":"槛棂生菌地生衣，釜甑有鱼盘有薇。\n适俗簪裾取萦挽，累人口腹得岖崎。\n行看海雾江云尽，却放风台月观辉。\n拨置图书绝欣慨，一巾一钵款山扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1347,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"连雨偶成二首 其二","author":"苏籀","text":"愚翁夸甫骨应寒，宇宙因谁危与安。\n治道灼知斯鞅妄，中兴窃拟导安难。\n文章一伎真何益，得失他年极易观。\n私喜崔骃薄班固，缪贤朱博毁师丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1348,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"閒咏一首","author":"苏籀","text":"肆筵无扣器，钉壁但镵碑。\n慨叹慕前躅，咨吁亦小知。\n饪谐棋酒伴，瓶远井泉湄。\n自许羲皇上，陶然绝旷夷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1349,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陈翁妻何氏挽词","author":"苏籀","text":"驯和乃宗竞，攻苦更家丰。\n不失蒸尝职，无非女士风。\n南陔泣笄冠，中馈叹光鸿。\n夜绩灯谁续，承承锡祚隆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1350,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陈䋖男求厥父挽诗二首 其二","author":"苏籀","text":"克家宗从誉，涧屋竹林庄。\n情话非前听，门庭付令郎。\n短生风烛顷，远日陇丘傍。\n红粉祠堂壁，亦应镌短章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1351,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陈䋖男求厥父挽诗二首 其一","author":"苏籀","text":"阃室良规范，萱堂子职修。\n仪形俨惇硕，积习肖风流。\n畴曩乡邻援，悽凉川逝愁。\n太丘纯岂弟，慈爱理能周。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1352,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"事毕汤巩方三君再用前韵复酬一首","author":"苏籀","text":"妙啜龙团啬少分，宝薰婆律靳多闻。\n泥封誊识遵程度，棘刺围藩按惠文。\n采菊骚人宁避雨，登楼朝彦气摩云。\n兰堂锦瑟笙簧闹，嬉笑啁讴共惜醺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1353,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"侨居","author":"苏籀","text":"买僮贷宅愈迂疏，颖士皆能讲旧庐。\n典学前闻质郯子，天人定胜取申胥。\n未应孤负囊中笔，粗尔消磨架上书。\n借问棼丝谁任理，岂惟短发每晨梳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1354,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"参云亭纳凉小集二首 其二","author":"苏籀","text":"踽踽迂疏彼一鳏，息交绝学殆顽颜。\n时侪傥获多谋助，少作曾希长者删。\n喂犬孱尪玩逋窃，辕驹牵局旷尤瘝。\n那无上术蠲人瘼，画戟临江城负山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1355,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"参云亭纳凉小集二首 其一","author":"苏籀","text":"设醴兹晨遨饫时，四围青峭互巇嶷。\n橐衣随牒何曾卜，饵药衔杯稍信医。\n短舞不妨擎菡萏，谈谐且勿负玻瓈。\n老夫直辔循吾范，无使斯民有以窥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1356,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和卷中韩子苍梅花三首 其三","author":"苏籀","text":"国香倾国色，天质殆天怜。\n含笑冰崖侧，无言石濑溅。\n湘娥愁暮倚，孙令馥终筵。\n卜夜多松炬，玉容殊更妍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1357,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和卷中韩子苍梅花三首 其二","author":"苏籀","text":"冻蘖虽臞甚，含英山意催。\n斲冰冲晓色，绽绿透春回。\n健步故人信，流芳好事杯。\n不论山水僻，往往拾香来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1358,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和卷中韩子苍梅花三首 其一","author":"苏籀","text":"先开媚晴昊，孤艳断魂时。\n绕树沈烟度，凌寒檀晕披。\n参横明月观，雪细影娥池。\n结实冥冥雨，君看雀啅枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1359,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和洪玉甫秘监荔枝三首 其二","author":"苏籀","text":"闽中谱殊盛，唐相赋初工。\n万点凝霞赤，三危滴露丛。\n驱芦抵乌鹊，投李饫儿童。\n子美吟西蜀，樱桃先后红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1360,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和洪玉甫秘监荔枝三首 其三","author":"苏籀","text":"瘴乡骈琐质，善地最蒲闽。\n冠绝林间品，难为坐上宾。\n蟠桃寿天帝，萍实荐居宸。\n无逸为龟策，何烦万马尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1361,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜凉","author":"苏籀","text":"白屋秋声里，蹉跎旅食春。\n挑灯鲁酒薄，拊枕越鸡晨。\n学术家传业，风流德有邻。\n似闻川陜捷，吾道付峨岷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1362,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"招范子仪登升山次范韵","author":"苏籀","text":"束带殊憎市声沸，幅巾聊复隐居寻。\n凌虚马鞍林峦表，滴翠驼裘涧谷深。\n个里膏肓空自许，何期烟雨挠重临。\n长瓶大白开狂喙，绝海驱山叹未禁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1363,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"择邻一首","author":"苏籀","text":"天然龊騃千金子，憬彼憸民亦有徒。\n蹴踏惟应怯龙象，灌输何足计瓶盂。\n神锥曾见汝颍士，道韵也欣山泽癯。\n栗尾著书趋圣处，老勤端恐负师模。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1364,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"林少伊直院母夫人柳氏挽词 其二","author":"苏籀","text":"遐年畀东榻，流庆羡停储。\n吊者九皋唳，幽夫百岁居。\n鱼轩川上逝，石窌墓前书。\n绝妙斯铭勒，宁惟崔蔡如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1365,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"林少伊直院母夫人柳氏挽词 其一","author":"苏籀","text":"英英批凤杰，遗懿诵高堂。\n淑质宗姻慕，慈怜寿凯康。\n委蛇瞷夫子，勤苦养尊章。\n驹隙八旬促，兰陔怆陨霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1366,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]