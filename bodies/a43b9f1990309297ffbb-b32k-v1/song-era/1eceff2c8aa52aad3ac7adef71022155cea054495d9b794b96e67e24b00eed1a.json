[{"title":"清平乐","author":"李弥逊","text":"推愁何计。\n车下忘乘坠。\n日上南枝春有意。\n已讶红酥如缀。\n儿童缓整余杯。\n芒鞋午夜重来。\n素面应憎月冷，真香不逐风回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61154,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清平乐","author":"李弥逊","text":"长红小白。\n何处寻梅格。\n日日南山云满额。\n暗老一分春色。\n广平赋罢瑶香。\n细□花蕊商量。\n留得笔端雨露，后来收拾群芳。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61155,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清平乐 春晚","author":"李弥逊","text":"一帘红雨。\n飘荡谁家去。\n门外垂杨千万缕。\n不把东风留住。\n旧巢燕子来迟。\n故园绿暗残枝。\n肠断画桥烟水，此情不许春知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61156,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清平乐 次韵叶少蕴和程进道梅花","author":"李弥逊","text":"断桥缺月。\n点点枝头雪。\n画角吹残声未歇。\n早是一年春别。\n寿阳弄粉成妆。\n柔肠结结丁香。\n可怕真梅轻妒，游蜂说与何妨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61157,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清平乐 登第","author":"李弥逊","text":"烛花催晓。\n醉玉颓春酒。\n一骑东风消息到。\n占得鳌头龙首。\n长安去路骎骎。\n明朝跃马芳阴。\n应是花繁莺巧，东君著意琼林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61158,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渔家傲 博士生日","author":"李弥逊","text":"海角秋高风力骤。\n楼台四面山容瘦。\n季子貂裘寒欲透。\n悬弧昼。\n高歌棣萼聊卮酒。\n且共追欢宽白首。\n清閒赢得身长久。\n世上功名翻覆手。\n为君寿。\n腰间要看悬金斗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61159,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 新秋","author":"李弥逊","text":"凉飙轻散馀霞绮。\n疏星冷浸明河水。\n欹枕画檐风。\n秋生草际蛩。\n雁门离塞晚。\n不道衡阳远。\n归恨隔重山。\n楼高莫凭栏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61160,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 富季申见约观月，以病不能往。夜分独卧横山阁，作此寄之","author":"李弥逊","text":"馀霞收尽寒烟绿。\n江山一片团明玉。\n欹枕画楼风。\n愁生草际蛩。\n金茎秋未老。\n两鬓吴霜早。\n忍负广寒期。\n清尊对语谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61161,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 管邦惠家小鬟善讴","author":"李弥逊","text":"小山娇翠低歌扇。\n雏莺学语春犹浅。\n无力响方檀。\n声随玉笋翻。\n垂鬟云乍染。\n媚靥香微点。\n未解作轻颦。\n凝情已动人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61162,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮","author":"李弥逊","text":"江城烽火连三月。\n不堪对酒长亭别。\n休作断肠声。\n老来无泪倾。\n风高帆影疾。\n目送舟痕碧。\n锦字几时来。\n薰风无雁回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61163,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮","author":"李弥逊","text":"风庭瑟瑟灯明灭。\n碧梧枝上蝉声歇。\n枕冷梦魂惊。\n一阶寒水明。\n鸟飞人未起。\n月露清如洗。\n无语听残更。\n愁从两鬓生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61164,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"感皇恩 次韵尚书兄老山堂作","author":"李弥逊","text":"入夜月华清，中天方好。\n更著山光两相照。\n星稀云净，玉树惊乌三绕。\n广寒风露近，秋光老。\n老山高胜，飞尘不到。\n亭上仙翁自昏晓。\n短封新唱，字字令人绝倒。\n待凭书寄恨，归鸿少。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61165,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"感皇恩 端礼节使生日","author":"李弥逊","text":"密竹剪轻绡，华堂初建。\n卷上虾须待开宴。\n寿期春聚，芍药一番开遍。\n砌成锦步帐，笼弦管。\n绛节近颁，丹雏重见。\n花里双双乍归燕。\n重重乐事，凭仗东风拘管。\n一时分付与，金荷劝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61166,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"感皇恩 学士生日","author":"李弥逊","text":"花院小回廊，庭萱成行。\n水面红妆翠绡帐。\n蓬莱云近，风露一番清旷。\n星郎来碧落，长庚象。\n素志未酬，丹心益壮。\n且醉真珠小槽酿。\n不须皓齿，拍手狂歌清唱。\n一尊为寿庆，羲皇上。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61167,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"满庭芳 中秋次刘梦弼韵","author":"李弥逊","text":"荷背翻黄，蕉心滴翠，雨洗庭院无尘。\n断云缺处，矫首望冰轮。\n迤逦天垂四幕，星杓淡、河汉横银。\n笙歌散，风帘自上，寒水满楼明。\n刘郎方得计，钗摇绣户，枕并华裀。\n笑狂客无眠，坐听钟鲸。\n明月中秋一梦，临鸳甃、三绕殷勤。\n清光里，持杯对影，风月两兼并。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61168,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蓦山溪 次李伯纪梅花韵","author":"李弥逊","text":"冲寒山意，未放江头树。\n老去恨春迟，数花期、朝朝暮暮。\n疏英冷蕊，也为有情忙，深夜月，小庭中，绝胜西城路。\n调元妙手，便是春来处。\n酝造十分香，更暖借、毫端烟雨。\n狂歌醉客，小摘问东风，花谢后，子成时，趁得和羹否。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61169,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蓦山溪 宣城丞厅双梅","author":"李弥逊","text":"竹边柳外，两两寒梅树。\n疏影上帘栊，似却□、一枝横暮。\n玉肌瘦损，有恨不禁春，萦冰佩，整风裳，怅望瑶台路。\n我来胜赏，持酒花深处。\n天晓酿幽香，正一霎、如酥小雨。\n江山得助，臭味许谁同，长安远，故人疏，梦到江南否。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61170,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"虞美人 次韵叶少蕴怀隐庵作","author":"李弥逊","text":"方壶小有人谁到。\n底事春知早。\n使君和气粲如花。\n更筑百花深处、驻春华。\n云关远枕苕溪浅。\n未放归怀展。\n看残红紫绿阴斜。\n鸾凤干霄却上、玉皇家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61171,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"虞美人 宜人生日","author":"李弥逊","text":"梨花院落溶溶雨。\n弱柳低金缕。\n画檐风露为谁明。\n青翼来时试问、董双成。\n去年春酒为眉寿。\n花影浮金斗。\n不须更觅老人星。\n但愿一年一上、一千龄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61172,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"虞美人 咏古","author":"李弥逊","text":"上阳迟日千门锁。\n花外流莺过。\n一番春去又经秋。\n惟有深宫明月、照人愁。\n暗中白发随芳草。\n却恨容颜好。\n更无魂梦到昭阳。\n肠断一双飞燕、在雕梁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61173,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"虞美人 赠富季申别","author":"李弥逊","text":"年年江上清秋节。\n盏面分霜月。\n不堪对月已伤离。\n那更梅花开后、海棠时。\n剑溪难驻仙游路。\n直上云霄去。\n藕花恰莫碍行舟。\n要趁潮头八月、到扬州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61174,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"虞美人 东山海棠","author":"李弥逊","text":"海棠开后春谁主。\n日日催花雨。\n可怜新绿遍残枝。\n不见香腮和粉、晕燕脂。\n去年携手听金缕。\n正是花飞处。\n老来先自不禁愁。\n这样愁来欺老、几时休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61175,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"虞美人","author":"李弥逊","text":"金泥捍拨春声碎。\n恨入相思泪。\n醉欺秋水绿云斜。\n浑似梦中重到、阿环家。\n主人著意留春住。\n不醉无归去。\n只愁银烛晓生寒。\n明日落花飞絮、满长安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61176,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"滴滴金 次韵尚书兄老山堂雪","author":"李弥逊","text":"广平未拚心如铁。\n恨梅花、隔年别。\n化工剪水斗春风，似南枝和月。\n长鲸一饮宁论石。\n想高歌、醉瑶席。\n几时归去共尊罍，看寒花连陌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61177,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蝶恋花 新晴用前韵","author":"李弥逊","text":"清晓天容争显晦。\n溪上群山，戢戢分驼背。\n谁似浮云知进退。\n疏林嫩日黄金碎。\n夜枕不眠憎鼠辈。\n困眼贪晴，拚被风烟醉。\n天意有情人不会。\n分明置我风波外。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61178,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蝶恋花 游南山过陈公立后亭作","author":"李弥逊","text":"足力穷时山已晦。\n却上轻舟，急棹穿沙背。\n云影渐随风力退。\n一川月白寒光碎。\n唤客主人陶谢辈。\n拂石移尊，不管游人醉。\n罗绮丛中无此会。\n只疑身在烟霞外。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61179,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蝶恋花 西山小湖，四月初，莲有一花","author":"李弥逊","text":"小小芙蕖红半展。\n占早争先，不奈腰肢软。\n罗袜淩波娇欲颤。\n向人如诉闺中怨。\n把酒与君成眷恋。\n约束新荷，四面低歌扇。\n不放游人偷眼盼。\n鸳鸯叶底潜窥见。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61180,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蝶恋花 福州横山阁","author":"李弥逊","text":"百叠青山江一缕。\n十里人家，路绕南台去。\n榕叶满川飞白鹭。\n疏帘半卷黄昏雨。\n楼阁峥嵘天尺五。\n荷芰风清，习习消袢暑。\n老子人间无著处。\n一尊来作横山主。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61181,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蝶恋花 拟古","author":"李弥逊","text":"百尺游丝当绣户。\n不系春晖，只系閒愁住。\n拾翠归来芳草路。\n避人蝴蝶双飞去。\n困脸羞眉无意绪。\n陌上行人，记得清明否。\n消息未来池阁暮。\n濛濛一饷梨花雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61182,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"醉花阴 学士生日","author":"李弥逊","text":"池面芙蕖红散绮。\n鹊噪朱门喜。\n环佩响天风，香霭杯盘，更约麻姑侍。\n尘寰不隔蓬莱水。\n束带岩廊戏。\n瘦鹤与长松，且伴臞仙，久住人间世。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61183,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"醉花阴 木犀","author":"李弥逊","text":"紫菊红萸开犯早。\n独占秋光老。\n酝造一般清，比著芝兰，犹自争多少。\n霜刀剪叶呈纤巧。\n手撚迎人笑。\n云鬓一枝斜，小阁幽窗，是处都香了。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61184,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"醉花阴 硕人生日","author":"李弥逊","text":"帘卷西风轻雨外。\n揖数峰横翠。\n楼上地行仙，压玉为醪，旋摘黄金蕊。\n一觞一阕千秋岁。\n不愿封侯贵。\n长伴紫髯翁，踏月吹箫，笑咏云山里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61185,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"醉落魄 硕人生日","author":"李弥逊","text":"霜林变绿。\n画帘桂子排香粟。\n一声檀板惊飞鹜。\n弦管楼高，谁在阑干曲。\n人生一笑难相属。\n满堂何必堆金玉。\n但求身健儿孙福。\n鹤发年年，同泛清尊菊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61186,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹤冲天 张仲宗以秋香酒见寄并词，次其韵","author":"李弥逊","text":"篘玉液，酿花光。\n来趁北窗凉。\n为君小摘蜀葵黄。\n一似嗅枝香。\n饮中仙，山中相。\n也道十分宫样。\n一般时候最宜尝。\n竹院月侵床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61187,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偈","author":"李弥逊","text":"漫说从来牧护，今日分明呈露。\n虚空拶倒须弥，说甚向上一路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61188,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"白水寺","author":"李弥素","text":"白水水逾白，疏山山不疏。\n林迷钟递响，路久衲分裾。\n寤寐念丘壑，征行怀简书。\n西来有意否，试与问何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61189,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"李承之","text":"珠鞍昔御恩犹在，玉辇亲扶事已非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61190,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题神霄宫壁","author":"李抱一","text":"一粒金丹续命基，算来由我更由谁。\n神龟移入云端去，彩凤抟归地母骑。\n溟涬浪中求白雪，昆崙山里采琼枝。\n只消千日工夫足，养个长棱八角儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61191,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游樵岚","author":"李明","text":"禅林昼静宝坊新，花木阴深别样春。\n不是红尘飞不到，只因无处著红尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61192,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋江打鱼 其二","author":"李泳","text":"鸣榔四合波围蹙，挂网雪鳞穿翠束。\n惊起沙头白雁群，斜行书破秋天绿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61193,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"华发","author":"李泳","text":"华发中年感，青阳万物和。\n倦寻先友记，贫羡力田科。\n江远千帆落，天空一雁过。\n还家得新岁，童稚想婆娑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61194,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西兴","author":"李泳","text":"山拥千家邑，江涵万顷天。\n洪涛舂落日，老树秣荒烟。\n失路或搔首，夷途争著鞭。\n劳生几寒暑，半鬓已苍然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61195,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"新昌逢故人","author":"李泳","text":"草县一相值，忽思倾盖时。\n年来无限事，别后几篇诗。\n石乱水流急，竹深烟散迟。\n兵戈方满眼，我辈欲何之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61196,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"拟古","author":"李泳","text":"鲜鲜歌者衣，扎扎机中练。\n美人富千绮，寒女无一线。\n古风日以远，薄俗日以变。\n悲哉扊扅歌，女子羞自衒。\n男儿乖持操，蹙踖叹贫贱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61197,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋江打鱼 其一","author":"李泳","text":"沧洲叶脱风有声，渔舠两两从复横。\n菁江步口日欲没，竹山潭边潮欲生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61198,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题甘将军庙卷雪楼","author":"李泳","text":"卷雪楼前万里江，乱峰卓列森旗枪。\n上有甘公古祠宇，节制洪流掌风雨。\n甘公一去踰千年，至今忠义犹凛然。\n我来再拜揽尘迹，斜阳白鸟横苍烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61199,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水调歌头","author":"李泳","text":"危楼云雨上，其下水扶天。\n群山四合，飞动寒翠落檐前。\n尽是秋清栏槛，一笑波翻涛怒，雪阵卷苍烟。\n炎暑去无迹，清驶久翩翩。\n夜将阑，人欲静，月初圆。\n素娥弄影，光射空际绿婵娟。\n不用濯缨垂钓，唤取龙宫仙驾，耕此万琼田。\n横笛望中起，吾意已超然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61200,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"定风波 感旧","author":"李泳","text":"点点行人趁落晖。\n摇摇烟艇出渔扉。\n一路水香流不断。\n零乱。\n春潮绿浸野蔷薇。\n南去北来愁几许，登临怀古欲沾衣。\n试问越王歌舞地。\n佳丽。\n只今惟有鹧鸪啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61201,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺新郎","author":"李泳","text":"门掩长安道。\n卷重帘、垂杨散暑，嫩凉生早。\n午梦惊回庭阴翠，蝶舞莺吟未了。\n政露冷、芙蓉池沼。\n金雁尘昏么弦断，理馀音、尚想腰支袅。\n欢渐远，思还绕。\n临皋望极沧江渺。\n晚潮平、湘烟万顷，断虹残照。\n彩舫凌波分飞后，别浦菱花自老。\n问锦鲤、何时重到。\n楼迥层城看不见，对潇潇、暮雨怜芳草。\n幽恨阔、楚天杳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61202,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"东湖","author":"李泽民","text":"四围图画簇鲜妍，为托湖天汇众川。\n蚁运笕泥千嶂满，虹牵堤势两山连。\n旌旗耀日鼓鼙壮，冠盖如云罗绮鲜。\n才谫冒然兴大役，幸而集事谢群贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61203,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵曾端伯晚过青山","author":"李牧","text":"怪底尘劳破，青山在眼中。\n竹桥低跨水，林磬小鸣风。\n半岭暮云碧，一村霜叶红。\n禅枝栖众鸟，回首意无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61204,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题灵岩洞","author":"李知己","text":"三岩九洞绝尘寰，问讯真人得纵观。\n丹就已乘仙鹤去，云深元有老龙蟠。\n铁船泛海源流远，玉柱擎天星斗寒。\n劈破莓苔认诗句，欲归传作画图看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61205,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"李知孝","text":"秋雨梧桐皇子宅，春风杨柳相公桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61206,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"洞霄宫二首 其二","author":"李知退","text":"早已飞升去，人间不记年。\n潜龙犹守卫，飞鼠尚蹁跹。\n烟锁栖真洞，云横抚掌泉。\n徘徊空竟日，令我忆坡仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61207,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"洞霄宫二首 其一","author":"李知退","text":"霁色横空碧，凉飙透客襟。\n萦回山九锁，崭绝石千寻。\n爱景心虽切，怀贤意更深。\n摩挲旧诗刻，拥鼻独行吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61208,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"景灵旧钟","author":"李知退","text":"思昔祥符日，先皇建景灵。\n六飞亲奠币，万国尽来庭。\n睹物知全盛，闻声识典刑。\n孤臣肠九折，不忍视斯铭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61209,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"昊天道院","author":"李知退","text":"脱屣繁机后，骑鲸到此山。\n一编藏玉笈，千古镇云关。\n仙仗今虽远，龙鳞尚欲攀。\n凝尘横御榻，拜起涕应潸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61210,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题延庆院","author":"李经","text":"桐柏分奇对郡楼，括苍真隐翠何尤。\n幽人选胜近龙穴，野客忽来忘虎丘。\n溪户便将尘事隔，云房曾遣宦情收。\n灰心到此方高尚，好学遗民结社游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61211,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"飞骑桥","author":"李育","text":"魏人野战如鹰扬，吴人水战如龙骧。\n气吞魏王惟吴王，建旗敢到新城旁。\n霸主身当万夫敌，麾下仓皇无羽翼。\n途穷事变接短兵，生死之间不容息。\n马奔津桥桥半撤，汹汹有声如地裂。\n蛟怒横飞秋水空，鹗惊径度秋云缺。\n奋迅金羁汗沾臆，济主艰难天借力。\n艰难始是报主时，平日主君须爱惜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61212,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三韵杂咏七首 其七","author":"李若川","text":"瞽者不视色，聋者不听声。\n观其动作间，视听由心生。\n一心苟有蔽，耳目绝聪明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61213,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三韵杂咏七首 其六","author":"李若川","text":"一气有清浊，二仪成覆载。\n鱼鸟各飞潜，草木异荣败。\n不齐乃至齐，造化所以大。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61214,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三韵杂咏七首 其五","author":"李若川","text":"足安咫尺地，临险生忧危。\n世故日纷扰，逐物心难持。\n心定境亦定，祸福安能移。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61215,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三韵杂咏七首 其四","author":"李若川","text":"鹭白固匪珍，鸦黑亦非贵。\n使其色相反，人皆竞称瑞。\n世情惟尚奇，在理则为蔽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61216,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三韵杂咏七首 其三","author":"李若川","text":"足随意以行，目惟心所视。\n若必待使之，动行即相戾。\n是故造自然，斯为理之至。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61217,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]