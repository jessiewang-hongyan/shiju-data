[{"title":"笑往","author":"吕陶","text":"卫青勋业已阑珊，骠骑门前辄得官。\n荣谢不同时事改，故人何独有任安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43672,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过张彦辅所居二首 其一","author":"吕陶","text":"城里尘埃空自忙，暂来城外觉清凉。\n临池静坐有馀味，雨后荷花无限香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43673,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过张彦辅所居二首 其二","author":"吕陶","text":"秀野垂杨数里青，夕阳犹占一峰晴。\n病来两耳如聋者，闻得岩泉㶁㶁声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43674,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梅花开尽小桃次之","author":"吕陶","text":"发尽寒梅千万枝，小桃乘暖欲开时。\n春风次第来须早，芳草垂杨莫恨迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43675,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答岳山莲惠茶","author":"吕陶","text":"春芽不染焙中烟，山客勤勤惠至前。\n洗涤肺肝时一啜，恐如云露得超仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43676,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"乍暖可爱","author":"吕陶","text":"马蹄经岁踏红尘，闰腊光阴已觉春。\n迟日暖风真可爱，年年长是伴行人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43677,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"久旱","author":"吕陶","text":"晓云将雨午还收，晚日馀炎未似秋。\n岂独稻畦枯已久，兼忧井竭饮污流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43678,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"绝句","author":"卢秉","text":"十月都门风薄衣，捣砧声重雁南飞。\n野人不识长安乐，且趁鲈鱼一棹肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43679,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"广济寺","author":"吕陶","text":"十年佛迹留于此，屈指山门皆所无。\n今日清诗重褒述，禅林又复有犀渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43680,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"瞻岷阁前双梅将开苏子美屡约一赏会予行部左锦未果次石泉道中僧舍见杨应之阻雨所题李义山诗极有意味因次其韵惜梅之未赏且以寄聚散离合之兴云","author":"吕陶","text":"欲赏寒梅先有期，却嗟人事又差池。\n西山雪后东风急，应是寒梅烂漫时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43681,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和通判阎朝奉赏花四绝 其一","author":"吕陶","text":"春来尊酒屡过从，万事无如一醉中。\n听唱欧公洛阳曲，今年花胜去年红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43682,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和通判阎朝奉赏花四绝 其二","author":"吕陶","text":"多年已分作衰翁，病眼看花似雾中。\n却谢东风无厚薄，芳心皆露十分红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43683,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和通判阎朝奉赏花四绝 其三","author":"吕陶","text":"田家僧舍有芳丛，竞折繁枝献座中。\n持语佳宾莫轻散，林稍犹见夕阳红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43684,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和通判阎朝奉赏花四绝 其四","author":"吕陶","text":"好花长是怯狂风，荣谢都来十日中。\n未过清明时节在，更须携酒觅残红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43685,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和提刑户部赏花","author":"吕陶","text":"年华易去三春半，花态增新一雨中。\n自笑白头连日赏，樽前犹插数枝红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43686,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"金州值雪留一日诘旦遂晴乃西","author":"吕陶","text":"山下孤城倍寂寥，行人无意暂停镳。\n千林万壑琼瑰满，赖有晴曦半日消。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43687,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"绝句五首 其一","author":"吕陶","text":"可爱山花百日红，南风开得到西风。\n一般颜色差长久，移取栽培后圃中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43688,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"绝句五首 其二","author":"吕陶","text":"可美盆池一寸鳞，圆荷阴底自由身。\n金刀落脍非吾事，不畏江边结网人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43689,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"绝句五首 其三","author":"吕陶","text":"可笑公庭种牡丹，日培肥壤设重栏。\n好花三岁方成就，谁向花前一醉看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43690,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"绝句五首 其四","author":"吕陶","text":"可惜賨城足海棠，山头涧底尽芬芳。\n成都花品分先后，此地谁人为发扬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43691,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"绝句五首 其五","author":"吕陶","text":"可喜公居近白云，眼前尘事少纷纷。\n纱橱竹簟偏宜睡，五月庭除不聚蚊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43692,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"庚申四月六日马上口占","author":"吕陶","text":"圣皇恩重恤狂愚，待罪山城岁已踰。\n更入西门三百度，便须跨马上成都。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43693,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"华阴道中","author":"吕陶","text":"畏日衔山势欲沉，马头西去又骎骎。\n道傍槐柳阴浓处，时有清风怏我襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43694,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过肃宁城","author":"吕陶","text":"百里郊原极目平，未寒林叶尚馀青。\n前村一穗浓烟起，知是逡巡到肃宁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43695,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋晚","author":"吕陶","text":"九月西风未肯凉，信知时节类炎荒。\n骚人不念天涯远，只爱青山对碧湘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43696,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西阳道中","author":"吕陶","text":"千山杂遝开还掩，一水萦纡浅复深。\n浑似嘉陵江上路，转令羁客动归心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43697,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过天彭怀昔游三首 其一","author":"吕陶","text":"西湖风物似当时，惟有流光去莫追。\n十四年前植修竹，茂阴如识绕方池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43698,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过天彭怀昔游三首 其二","author":"吕陶","text":"昔向朝亭种牡丹，花开酒熟不胜欢。\n雾中双眼犹能看，更约春深欲倚栏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43699,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过天彭怀昔游三首 其三","author":"吕陶","text":"曾向高楼赋晚晴，每看鱼鸟乐长生。\n下楼还是红尘道，不信机心胜野情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43700,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初春三绝 其一","author":"吕陶","text":"雪霜收尽苦寒威，六幕融融喜气归。\n原上枯荄还不死，有心刚欲报春晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43701,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初春三绝 其二","author":"吕陶","text":"谁知真宰执天端，天运无私造化宽。\n是物向荣皆锐意，莫于春色办蒿兰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43702,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初春三绝 其三","author":"吕陶","text":"穷山幽谷几重深，一树东风散积阴。\n从此薄冰尤慎履，世途平日已寒心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43703,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和王定国二首 其一","author":"吕陶","text":"三十年前愁送别，八千里外喜同归。\n自甘衰叟锄新圃，未许高才恋旧矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43704,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和王定国二首 其二","author":"吕陶","text":"峡上相逢惟话道，湘中一笑又成诗。\n竞将酬唱誇新句，不为穷愁减昔时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43705,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"见嘉陵","author":"吕陶","text":"嘉陵江水泼蓝青，彻底澄光明鉴形。\n一叶钓舟真自在，渔翁应是醉还醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43706,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过剑关","author":"吕陶","text":"一别京华十七年，野情长是恋家山。\n谋身太拙真堪笑，头白重来度剑关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43707,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和初食嘉鱼","author":"吕陶","text":"子美尝誇丙穴鱼，天涯聊此试珍腴。\n西风消息江南兴，未免樽前忆脍鲈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43708,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"芙蓉","author":"吕陶","text":"剪取芳条便种成，只从秋后吐繁英。\n清霜难拒红光减，仰视松筠浪得名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43709,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再咏芙蓉","author":"吕陶","text":"一夕西风一度开，不须人力为栽培。\n化工何事存芽蘖，长与炎荒作瘴媒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43710,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"相台道中","author":"吕陶","text":"北道风霜老未谙，倦驱羸马亦骖驔。\n此行谁信游沙漠，心逐晴云万里南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43711,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雄州村落","author":"吕陶","text":"家家桑枣尽成林，场圃充盈院落深。\n九十馀年事耕凿，不知金革到如今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43712,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和行金堂峡思云顶","author":"吕陶","text":"山腰路转多临水，峡口天开又见山。\n疑是庆云曾结盖，故留仙境在人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43713,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题明庆塔院","author":"孔淘","text":"古寺寻清赏，梯云出薜萝。\n举头知日近，极目得天多。\n别嶂千屏列，长江一带过。\n常闻净居境，况此复如何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43714,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送梵才上人归天台","author":"孔淘","text":"飞锡来穷岫，驰声满上京。\n衣从麟德赐，诗入集仙评。\n虎老文弥炳，松孤格愈清。\n投人夜光宝，按剑但频惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43715,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"石民英","text":"云兼野色过松径，水带秋声入稻田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43716,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"四望台","author":"满维端","text":"叠石层高暗绿苔，茂林深处独崔嵬。\n花阴竹影重重见，山色川光面面来。\n通夜阑干随月倚，纳凉窗户趁风开。\n踌躇触目堪嗟赏，倍费登高赋咏才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43717,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挹秀亭","author":"满维端","text":"林蔼波光秀可餐，登临都付一亭间。\n坐违世路尘埃远，静入湖天日月闲。\n对岸莺花迷阆苑，隔烟洲溆切蓬山。\n习池胜事无多较，只负襄阳倒载还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43718,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南池","author":"满维端","text":"偃月城西锦绣川，回环亭树曲池边。\n篮舆蜡屐闲投入，竹坞花溪信步前。\n照日寒梅融素艳，拂波垂柳弄轻烟。\n东君已放春消息，为赋寻芳第一篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43719,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"桐轩","author":"满维端","text":"轩外梧桐碧两行，跳空阑槛枕西堂。\n风条弄日摇窗幌，露叶惊秋坠井床。\n静想还思理琴瑟，高吟惟恐引凤凰。\n谁怜不种朝阳地，但爱清阴作晚凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43720,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同林介夫游梅雨潭和韵","author":"李钧","text":"欲追河朔一时游，曾效兰亭泛曲流。\n闻说仙岩为绝胜，喜同高客共探幽。\n清风未挹先蠲渴，灵地将登已觉秋。\n幸有兵厨三雅酝，论文应饮百杯不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43721,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"肖梅香","author":"张吉甫","text":"江村招得玉妃魂，化作金炉一炷云。\n但觉清芬暗浮动，不知碧篆已氤氲。\n春收东阁帘初下，梦想江湖被更熏。\n真似吾家雪溪上，东风一夜隔篱闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43722,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄长庆寺长老琼师道契","author":"朱诗","text":"住持传法者，自有祖家风。\n一言决洪涛，四海云从龙。\n横身六合外，万象皆虚空。\n易此而就彼，探月澄波中。\n臂然心亦然，于法难为功。\n宗师灭贪痴，乃可化凡庸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43723,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"洞霄宫 其一","author":"钱景谌","text":"清夜宿瑶宫，云开天柱峰。\n千岩空洞月，万籁古坛松。\n仙驭闻鸣鹤，琅舆想六龙。\n朝元步虚罢，祥吹引林中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43724,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"洞霄宫 其二","author":"钱景谌","text":"入谷初无路，山蹊九折回。\n紫庭藏玉室，碧落抱琼台。\n溪流人闲见，桃花源上开。\n只应有仙骨，得到洞天来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43725,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"洞霄宫 其三","author":"钱景谌","text":"洞天三十六，大涤上清房。\n物外云烟古，仙家日月长。\n溪消分玉酝，岩穴产灵香。\n须信风尘表，栖真自有方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43726,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送程给事知越州","author":"徐大方","text":"昨夜除书下太清，一麾千里拥双旌。\n漠符出守朱轓重，越邸怀章昼锦荣。\n青琐窗深传夕拜，红莲幕下得时英。\n稽山寻胜穷幽窈，禹穴采书极粹精。\n贺老清虚陶内景，微之惠爱浃舆情。\n舍人早促还朝计，旦暮追锋柄宰衡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43727,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游东禅寺","author":"徐大方","text":"溪流□□韵，路入□□根。\n刘阮□□□，萧疏松石门。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43728,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题韩左军马图","author":"吴觌","text":"韩公画马称神笔，矫首昂藏山鬼泣。\n眼明见此饮马图，乃知矩度不可轶。\n定嫌昔日徐庾体，渴骥奔泉超法律。\n骐骥骅骝志千里，屹立天闲甘伏枥。\n气势相宜适操纵，肉骨兼匀称肥瘠。\n世人但以骊黄求，翠驳玉花烦剪剔。\n苦论右军爱鹅趣，知公爱马应成癖。\n山阴道士不换经，已悟黄庭养生术。\n持将此卷参马祖，待须一口西江吸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43729,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题三山郡圃会稽亭","author":"乔孝本","text":"元侯选胜重经营，地取圆心正且平。\n揆日募工踰再浃，创亭合乐落初成。\n面开西向缘忠孝，榜揭新封纪宠荣。\n隐隐湖山藏故国，漫漫烟水隔都城。\n低迷叠嶂回峰抱，缭绕芳丛列艳迎。\n台上临风共萧洒，花间梦蝶助凄清。\n枕流小槛攲前沼，散绮幽轩接后甍。\n旧景周环如有待，夕阳偏照似多情。\n萦纡碧沚通潮浦，左右修篁拂画楹。\n自昔甘棠虽足爱，会稽从此擅佳名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43730,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题延庆院","author":"黄知良","text":"松竹冷交阴，萧森露宝林。\n门依青嶂静，僧隐白云深。\n凄切泉喷玉，壮严地布金。\n龙湫中致祷，朝夕冀为霖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43731,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"饯魏主簿席上作","author":"李殿丞","text":"今日不知明日事，人情反覆似车轮。\n我今自是飘萍客，更向长亭作主人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43732,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"王企立","text":"岚光入坐茶瓯绿，海气逢春柱础腥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43733,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"王企立","text":"老树阴中闲日月，小池波面醉家乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43734,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登金山观潮","author":"赵文昌","text":"浮沈日月走雷霆，偃蹇西来气未平。\n奔突楚山愁破碎，荡摇坤辅厌支撑。\n昔年此地分南北，今日中天洗甲兵。\n万里雄风双秃鬓，妙高台上看潮生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43735,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鹤林","author":"赵文昌","text":"江声撼群山，万马东南驰。\n盘盘铁瓮城，鼓角缠秋悲。\n维天有设险，实为奸雄资。\n阿奴何许来，王业自此基。\n金陵气已基，虎口馀义熙。\n潜机寿阳发，凛凛天象垂。\n划然九州鼎，竟属卖履儿。\n中原自汉蹶，神器良屡移。\n黄屋如传舍，与夺谁汝疵。\n顺守尚有策，嗜杀徒自隳。\n山阳作虞宾，豚犬犹能知。\n零陵一累囚，互亡何足疑。\n凶德一至再，鬼责其何辞。\n殄歼肘腋来，泉壤悔莫追。\n惜哉勤王功，一臭万古遗。\n我登黄鹤山，指顾生嗟咨。\n茫茫六合内，俯仰几盛衰。\n尧年与桀日，究竟孰纲维。\n东去云悠悠，西来风飔飔。\n把酒呼山灵，听我鹤林诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43736,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自金山泛舟至焦山饮吸江亭","author":"赵文昌","text":"金山据上流，怒挟汀声东。\n焦山护海门，坐折千里冲。\n两山势欲合，盛气薄苍穹。\n解纷谁巨擘，赖有疏凿功。\n至今买馀勇，角立相长雄。\n两皋汗漫游，目击大块中。\n手持一杯酒，浇尔磊块胸。\n鱼龙出鼓舞，摩荡青莲宫。\n山灵自不凡，感激欣相从。\n因笑魏与吴，乾坤两鸡虫。\n悠然一带水，往事寻无踪。\n夜深何处笛，呜呜起西风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43737,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"天目山","author":"赵文昌","text":"天目山前分两乳，一脉西来缠右股。\n溯流疑是武陵源，入山绝似盘之阻。\n椒峦隐隐入霄汉，从此去天才尺五。\n飞泉汇作千丈潭，下有蛟龙潜水府。\n玉芝瑶草净如拭，不见尘寰一抔土。\n三神山远未易到，洞天只在溪之浒。\n道人宴作疑不动，一榻云烟几寒暑。\n乍逢佳客喜盈颊，上山下山若飞虎。\n龟腹燕颔好颜色，凫舄御风轻步武。\n蘋蘩蕴藻盈倾筐，砧几腥膻不登俎。\n赢刘颠蹶问不知，那识人间有簪组。\n嗟予碌碌退不勇，窃食大官无寸补。\n回头四十九年非，白发手搔不可数。\n山禽唤我归去来，口未及言心已许。\n长安冠盖多豪杰，谁肯论交到尔汝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43738,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"七星岩","author":"康卫","text":"天坠北斗精，人间书景福。\n岩石骈七峰，漠漠太古色。\n磅礴压洪濛，崒嵂磨苍碧。\n中涵大穴洞，外与风云隔。\n千夫廓有容，万状成叵测。\n谽谺露肝胆，槎牙列矛戟。\n伏如龙虎卧，起若将士立。\n西窍通天关，虚明数千尺。\n豁然一罅入，寂阒燃灯隩。\n幽秘若为藏，暗阏不可极。\n龙床一鸟鷇，宛若蛇蜒迹。\n龙井下太阴，彷佛被元幄。\n岂伊鬼神秘，乃是造化力。\n江寒烈水涯，春盎回阳律。\n炎光流大地，凄凉入人骨。\n四时斡元气，可燕复可息。\n平生谢康乐，不废登山屐。\n蓬莱在人世，昧者恒弗识。\n达人昔来游，题诗满青壁。\n骎骎岁月深，惨惨烟霞积。\n绝唱者何人，清新压元白。\n镌石苟无分，灵怪亦我惜。\n缅思融结初，六丁万斧擘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43739,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再经旧游偶成拙句寄呈知郡殿丞 过端州","author":"康卫","text":"峡外烟云迤逦开，人家门户小楼台。\n青山渌水应相记，二十年前到此来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43740,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]