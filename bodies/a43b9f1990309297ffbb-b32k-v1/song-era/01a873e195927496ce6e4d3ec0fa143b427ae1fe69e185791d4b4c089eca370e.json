[{"title":"喜仲晦除江西宪二首 其一","author":"刘克庄","text":"江卿二臬除书下，不与寻常遣使同。\n玉佩懒随小儿走，绣衣聊展丈夫雄。\n剑刀俗革田秋熟，贯索芒收圄夜空。\n想伴清言惟小谢，有诗毋惜寄衰翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32526,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜汤伯纪登第","author":"刘克庄","text":"老觉人间无一忻，怪来乾鹊耳边闻。\n休嗔穷鬼揶揄我，绝喜春官摸索君。\n畴昔先生有高第，即今后死与斯文。\n不应也跃看花马，忘却江天树与云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32527,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜洪君畴除工侍内制 其一","author":"刘克庄","text":"热官不拜意何如，诏改冬卿眷礼殊。\n保晚节香似公少，问今日愈造朝无。\n儒绅易以黄金带，宫锦加诸白布襦。\n直待铺张太平了，却寻北阜与东湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32528,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜洪君畴除工侍内制 其二","author":"刘克庄","text":"不但持荷班法从，兼闻视草属鸿儒。\n迩英两讲烦箴砭，文德三麻待播敷。\n即日载赓虞帝作，几时重入洛英图。\n诸公若问樗庵叟，岁晚偏盲又夹扶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32529,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寒食","author":"刘克庄","text":"闻道江乡吹战尘，叵堪鼙鼓震于邻。\n荒城少有飞花处，高冢多无擘纸人。\n沙塞榆枯难取火，玉关柳少化为薪。\n遥知玉座焦劳处，闲却龙舟阁水滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32530,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寒食二首 其二","author":"刘克庄","text":"古来禁火惟汾晋，今遍天涯海角然。\n一老家才有黔突，五侯第各起青烟。\n绝谀墓笔方无愧，比乞墦人岂不贤。\n独恨海棠吹打尽，枝头粉泪湿红绵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32531,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寒食二首 其一","author":"刘克庄","text":"历历晓风传庙鼓，曈曈霁日上窗纱。\n孙同鱼队忙观社，翁入鸡窠且守家。\n已是湿灰并槁木，不知榆火与杨花。\n燔山无觅之推处，谁道斯人羡四蛇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32532,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寒食清明二首 其二","author":"刘克庄","text":"过眼年光疾弹丸，桐华半拆燕初还。\n汉宫有烛朱门煖，墨突无烟白屋寒。\n宁复斗鸡陪戏社，颇思携鹤访孤山。\n今年秫与金同价，偶得茅柴且尽欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32533,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寒食清明二首 其一","author":"刘克庄","text":"寂寂柴门村落里，也教插柳记年华。\n禁烟不到粤人国，上冢亦携庞老家。\n汉寝唐陵无麦饭，山蹊野径有梨花。\n一尊径藉青苔卧，莫管城头奏暮笳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32534,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寓言","author":"刘克庄","text":"赤肉团终当败坏，臭皮袋死尚贪痴。\n生憎铜镜催白发，残著珠襦待赤眉。\n高筑迷楼愁鬼瞰，多为疑冢怕人知。\n吾评裸葬尤坚久，来往何曾挂一丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32535,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寓言","author":"刘克庄","text":"梦里依稀若在傍，安知觉后忽他乡。\n裁成出戍衣封去，挑就回纹锦寄将。\n多谢旧官留破镜，半为荡子守空房。\n偶逢女伴悲酸叹，不似披缁意味长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32536,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"强甫西上","author":"刘克庄","text":"平进差贤似躁求，乃翁岂不为儿谋。\n今寒畯士难京秩，古子男邦亦小侯。\n翘馆讵宜频造请，孤山虽好勿淹留。\n谁言此老心如铁，临别无端作许愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32537,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"惠州弟哀诗二首 其二","author":"刘克庄","text":"同产居惭余最长，二尊尤向汝钟情。\n斑衣犹记循陔乐，白发皆从陟岵生。\n一老吹埙无复和，十年废乐未能平。\n伤心溪墅成陈迹，谁听松风看月明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32538,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"惠州弟哀诗二首 其一","author":"刘克庄","text":"两张遗墨六亲悲，台下黄瓜摘渐稀。\n用北辰阡殊不乱，似南柯梦复疑非。\n向来岂有葡萄博，末后元无薏苡归。\n七十残骸双秃鬓，可堪原上泪频挥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32539,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"曾景建自临川送予至丰城示诗为别次韵一首","author":"刘克庄","text":"追程送我剑池边，亹亹清谈晋宋前。\n岂意白头趋幕日，乃逢紫气出关年。\n夜深续炬俱忘寝，地冷吹薪久未然。\n临别祝君加帽絮，高峰雪后尚童颠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32540,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"棋","author":"刘克庄","text":"十年学弈天机浅，技不能高谩自娱。\n远听子声疑有著，近看局势始知输。\n危如巡远支孤垒，狭似孙刘保一隅。\n未肯人间称拙手，夜斋明烛按新图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32541,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"棕冠","author":"刘克庄","text":"羽士过门卖，新翻样愈奇。\n坚如龟屋制，精似鹿胎为。\n邛杖扶相称，唐衣戴最宜。\n笑他蝉冕客，忧畏白须眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32542,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"温陵诸贤接刊拙稿竹溪直院有诗助噪戏和一首","author":"刘克庄","text":"行世安能保不刊，自怜敝帚笑傍观。\n熏香未可疏班马，抓痒无过看杜韩。\n雷挟六丁来取易，天教两鸟不鸣难。\n吾闻海上鲸堪脍，休把鸾刀切蚁肝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32543,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游水东诸洞次同游韵二首 其二","author":"刘克庄","text":"旧闻岩洞胜，欲往自髫年。\n耸秀过灵隐，幽深似善权。\n远环州堞外，近献屋檐边。\n傥有登临约，甘为子执鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32544,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游水东诸洞次同游韵二首 其一","author":"刘克庄","text":"桂山前未到，今日是初游。\n招鹤登青巘，呼龙俯碧湫。\n深蹊通秉炬，小窦劣容舟。\n岂敢轻题咏，同官尽柳刘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32545,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游水南一首","author":"刘克庄","text":"九马如飞不用鞭，微尘一道起晴川。\n有司误谤为山贼，好事俄传是地仙。\n何处名楼风月爽，谁家脩竹主人贤。\n橐诗三百高无价，难向旗亭当酒钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32546,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湘南楼","author":"刘克庄","text":"偶陪群彦赋登楼，一笑聊宽故国愁。\n近郭山来晴槛里，待船人立晚沙头。\n春天晴雨常多变，晦日文书得小休。\n尚有残钱沽老酒，落花时节约重游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32547,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"祺山院","author":"刘克庄","text":"昔日祺山院，今惟认土丘。\n有僧逃债去，无主施钱修。\n野叟樵难禁，岩仙弈未休。\n何须悲幻境，佛比作浮沤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32548,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答友生","author":"刘克庄","text":"读易参禅事事奇，高情已恨挂冠迟。\n清于楚客滋兰日，贫似唐人乞米时。\n家为买琴添旧债，厨因养鹤减晨炊。\n君看江表英雄传，何似孤山一卷诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32549,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答尤溪赵广文","author":"刘克庄","text":"怪来喜事上双眉，袖有恬轩老子诗。\n几个□□□□断，十年长敢比肩随。\n古耆旧传犹堪续，今少微星更是谁。\n笑杀太清刘管辖，此冠不挂待何时。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32550,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答王与立上舍","author":"刘克庄","text":"汉唐科目各招延，中者端如拾芥然。\n明水赋曾拘八韵，大廷策亦限三篇。\n窃窥古调谐轩律，留取高吟和舜弦。\n圣代作人添舍法，祝君走马止三年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32551,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答王掀将士","author":"刘克庄","text":"明时无复精英气，化作祥风及庆云。\n马鬣安能埋此骨，□□亦可与斯文。\n当年宾客谁珠履，今日郎君尚练裙。\n独有后村翁尚在，匹雏无力漫殷勤。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32552,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答仙游黄尉岩孙","author":"刘克庄","text":"乡近尤谙俗，山深莫掩名。\n士皆誇尉好，民亦诵官清。\n入幕交游少，依僧去住轻。\n它年汉廷上，定不愧黄生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32553,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答汤升伯因悼紫芝","author":"刘克庄","text":"紫芝曾说子能诗，开卷如亲玉树枝。\n古佛写成翻水偈，天仙遗下步虚词。\n的然沈谢何难识，逝矣应刘不可追。\n寂寞西湖三尺墓，谁携斗酒一浇之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32554,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答吴侍郎二首 其二","author":"刘克庄","text":"宿昔瞻依日月光，迟迟去鲁未须忙。\n附炎渠自手炙热，忍冻儿宁足履霜。\n谏草平生慕王魏，诗名馀事压钱郎。\n可怜老病兼穷薄，推毂当朝愧郑庄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32555,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答吴侍郎二首 其一","author":"刘克庄","text":"昨泛灵槎河汉津，今撑小艇水云身。\n相居自作蹲池计，天子何曾如屋嗔。\n开绿野尊姑领客，第甘泉颂可无人。\n白沙翠竹宜闲步，绝胜东华踏软尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32556,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答吴□和梅百咏","author":"刘克庄","text":"□□空疏不拟传，安知腾播累诸贤。\n即今同社几千首，当日孤山止一联。\n眼饱诳他忍饥腹，句寒耸我□吟肩。\n未知谁是苏司业，肯向梅边送酒钱。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32557,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答杨?","author":"刘克庄","text":"一生忠孝发于诗，不为桃根与柳枝。\n枣本流传容有伪，笺家穿凿苦求奇。\n偶全要领惭轻典，虚呕心肝悔少时。\n泽畔累臣搔白首，孤吟不敢累亲知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32558,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答杨浩","author":"刘克庄","text":"往前曾爱铭文嘱，老病安知拟议差。\n柏下人埋将宿草，管城子秃已无花。\n自惭吾匪三长史，谁误君寻五作家。\n今代李邕领袖手，往来碑版不须嗟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32559,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答陈龙图","author":"刘克庄","text":"耆旧凋零尽，吾犹及太丘。\n岂云清易挹，自是广难周。\n尚絅烦翁教，书绅到老休。\n何由陪几杖，共看海山秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32560,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答陈珍","author":"刘克庄","text":"寂寂少游从，斯人未易逢。\n清贫今仲子，疏隽小元龙。\n君谨提诗笔，吾当避箭锋。\n勉旃鸣盛世，切勿效寒蛩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32561,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答陈珽主簿","author":"刘克庄","text":"主簿佳公子，何曾染绮纨。\n果能磨铁砚，真可歃铜盘。\n君壮雷惊蛰，吾衰月阙团。\n家贫无宝贝，珍贶欲酬难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32562,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答陈莆田投赠二首 其二","author":"刘克庄","text":"恬退已邀鸥入社，畸孤羞使鸩为媒。\n闻新令尹弹琴治，有远方人负耒来。\n雷邑地偏难舞袖，坳堂水浅易胶杯。\n一枝半朵真穷相，输与河阳满县开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32563,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答陈莆田投赠二首 其一","author":"刘克庄","text":"夙昔潘郎说孟公，讲闻久矣匪匆匆。\n君豪不忝十才子，吾老真成一秃翁。\n谢事安能誊妙墨，辍耕犹可和高风。\n画帘寂寂蒲鞭小，应许澹台至室中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32564,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答陈琯修职","author":"刘克庄","text":"陈氏源流远，吾犹及纪群。\n昔惟知伯氏，今又识郎君。\n后学尊师友，先贤贱艺文。\n沧洲书册在，努力缉前闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32565,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答陈楙伯二首 其二","author":"刘克庄","text":"圣处分明世鲜知，古人岂是异肝脾。\n谓鳌可钓无传法，视虱如轮有悟时。\n老子梦中还说梦，郎君诗外试求诗。\n向来柱立埋腰雪，妙在心通不在师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32566,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答陈楙伯二首 其一","author":"刘克庄","text":"乃翁良玉不劳攻，之子天葩特地红。\n海道扁舟明日具，江东尊酒几时同。\n上楼谁伴老玄德，惊座今逢小孟公。\n回首暮云千里合，有书何处托征鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32567,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答陈璘司户","author":"刘克庄","text":"丞相诗高妙，诸孙亦复奇。\n惠连康乐弟，子美审言儿。\n三舍犹当避，偏师未易支。\n老来怯酬唱，欲速反成迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32568,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答卓常簿二首 其二","author":"刘克庄","text":"点点新霜上鬓须，深藏谁辨握中瑜。\n曾为上寝斜封滥，可使人讥曲学谀。\n已作凤飞天外者，安能凫泛水中乎。\n近来赠诔多虚美，自考平生合谥愚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32569,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答卓常簿二首 其一","author":"刘克庄","text":"神仙富贵拟皆差，已把云台让仲华。\n幸有庾郎三种韭，别无滕叔两车麻。\n斩新句子包诸体，放泼腔儿令一家。\n白白红红满山谷，不知天女散何花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32570,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答学者","author":"刘克庄","text":"自古名家岂偶然，虽游于艺必精专。\n经生各守单传旧，国弈常争一著先。\n马老于行知向导，鹄腾而上睹方圆。\n殷勤寄语同袍者，努力磨教铁砚穿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32571,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答建士谢旿二首 其二","author":"刘克庄","text":"偶有幽人访，柴门始一开。\n大颠留偈去，小谢袖诗来。\n襆被嫌三宿，挑灯读百回。\n惟应双屐齿，历历在莓苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32572,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答建士谢旿二首 其一","author":"刘克庄","text":"贽余一两卷，览罢恍然惊。\n老子犹坚壁，偏师忽劫营。\n今人轻雅道，造物靳诗名。\n自笑空空者，将何赠尔行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32573,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答林文之","author":"刘克庄","text":"笔势翩翩渐入佳，晨檐怪得鹊查查。\n劳谦君子方求益，老秃中书不梦花。\n商颂以前殊简短，卫风而下稍淫哇。\n鹤天鲸海无边际，莫费工夫纳百家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32574,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答林祖武","author":"刘克庄","text":"向来思钝费冥搜，不觉呻吟到白头。\n曾与乃翁分雪案，今看吾子突烟楼。\n晚多借月留云作，却悔升天入海求。\n大有英才被诗赚，岂如黄册取公侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32575,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答林逮贽卷因以送行","author":"刘克庄","text":"都忘几桉有华笺，但怪虹光夜属天。\n唐律胚胎梨岭作，古文骨髓艾轩传。\n蚤陈董大夫三策，肯觅原夫辈一联。\n若过溪边叩宗旨，为余问讯玉堂仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32576,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答罗天骥","author":"刘克庄","text":"乃祖曾吞凤，郎君岂后身。\n颇闻精选理，何必慕唐人。\n玉麈王夷甫，乌绦吕洞宾。\n客谈溪墅胜，终拟卜比邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32577,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答范叔范","author":"刘克庄","text":"阔矣别离久，飒焉颜发苍。\n殷勤大范子，问讯老刘郎。\n渴睡添新懒，清谈减昔狂。\n今无望气者，宝剑且深藏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32578,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答客","author":"刘克庄","text":"谁谓贫难忍，三年闭户居。\n老兵能合药，小仆会抄书。\n白发羞弹铗，青山去荷锄。\n既于吟得趣，功业合乘除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32579,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答括士李同二首 其二","author":"刘克庄","text":"秃翁门巷冷涔涔，僮报诗人远见寻。\n微露毫芒足奇怪，少加煅炼愈高深。\n肯来邺下从公干，待向关中说季心。\n黄鹄池边需应制，劝君莫学冻蛩吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32580,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答括士李同二首 其一","author":"刘克庄","text":"忆昔骎骎逼要津，迂疏谁遣批龙鳞。\n羞为庆历一不肖，妄意熙宁三舍人。\n鬼质若非天夺魄，累臣岂有地容身。\n江湖社友应相问，为说萧萧雪鬓新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32581,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答赴补同人","author":"刘克庄","text":"莫厌春泥没膝深，公卿皆拔自词林。\n鹄袍肯在诸生列，虫篆原非壮士心。\n山下久无吾屐齿，苇间忽听子挐音。\n年来懒与人谀墓，欲赠刘叉未有金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32582,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答敖茂才","author":"刘克庄","text":"太傅品胡儿，樊川誉阿宜。\n既为诸父赏，焉用外人知。\n晓月家山梦，秋风客舍诗。\n桐城逢汝伯，一为说相思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32583,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答留通判元崇","author":"刘克庄","text":"不见龙骧与骥驰，纷纷虫篆斗蛛丝。\n君侯杰出南方者，老仆终当北面之。\n忆玉树枝劳远梦，熏蔷薇水读来诗。\n自惭眼力非关令，紫气浮空懵不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32584,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答翁权教","author":"刘克庄","text":"铁庵同队亦同庚，鹏鴳逍遥各问程。\n渠梦南柯曾富贵，君归西洛作耆英。\n戴花未肯疏刘监，起蕝终当致鲁生。\n须向乘除验天理，莫将夕秀博朝荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32585,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答翁定","author":"刘克庄","text":"牢落祠官冷似秋，赖诗消遣一襟愁。\n喜延明月常开户，贪对青山懒下楼。\n客诧瀑奇邀往看，僧誇寺僻约来游。\n何当与子分峰隐，饥嗅岩花渴饮流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32586,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答梁文杓","author":"刘克庄","text":"二梁大学同袍旧，晚识郎君亦隽才。\n柳永词堪腔里唱，刘叉诗自胆中来。\n老夫一榻何曾下，吾子扁舟作么回。\n见说桐城方调卒，未应能筑礼贤台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32587,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答黄镛","author":"刘克庄","text":"少年妄意假韶鸣，忧患欺人两鬓星。\n此去真当盟社友，向来不合诳山灵。\n百年如夜何由旦，万古惟天只么青。\n若到桐城逢旧友，为言多醉少曾醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32588,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答傅监仓","author":"刘克庄","text":"少豪颇似括谈兵，老去方惭理未明。\n窗下残书千遍读，卷中一字几回更。\n撚髭人尽嗤吾拙，歃血谁当豫此盟。\n肯啖菜根抄脱粟，许君十载共经营。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32589,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答循倅潜起","author":"刘克庄","text":"别后书稀梦亦稀，忽传尺素到柴扉。\n不知天骥方徐步，将谓云鹏久怒飞。\n句律斩新过似旧，姓名略是复疑非。\n长官仙去宾朋散，存者依稀有杜微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32590,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]