[{"title":"赠郑相士","author":"楼钥","text":"知君冰鉴照人寒，我相儒酸未足观。\n东甬从来多俊秀，为烦著眼细寻看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24875,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠凌一源道人","author":"楼钥","text":"知君曾住武当山，更解寻幽灊皖閒。\n老矣无缘穷胜处，但思归去卧乡关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24876,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠徐松","author":"楼钥","text":"我为浮名愧引年，老馀八十尚飘然。\n不如合却谈天口，归向白云深处眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24877,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"丁寺丞挽词 其一","author":"楼钥","text":"家世传经术，胶庠蔼隽声。\n上方思旧学，公乃擅专城。\n滁上功尤著，潮阳政愈明。\n哀哉锷流水，犹解不平鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24878,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"丁寺丞挽词 其二","author":"楼钥","text":"严冷不可向，其中实旷然。\n行藏睽素志，燕乐了馀年。\n鹤化人何处，鸾孤影自怜。\n才高不尽用，流庆尚绵绵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24879,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九月十一日杓孙得男","author":"楼钥","text":"郡斋弧矢记垂门，今日衰翁更觉尊。\n生晚不能瞻大父，年高却幸见曾孙。\n从今镜镊知无用，但喜芝兰近愈繁。\n愿汝孳孳守家法，为传衣钵到仍昆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24880,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"入雁山过双峰","author":"楼钥","text":"眼前未见古龙湫，望望前山景自幽。\n红日一门千嶂晓，翠峰双耸半空秋。\n风高落木无边下，气劲閒云逐处收。\n要识雁山真面目，直须霜后一来游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24881,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又示从子澶","author":"楼钥","text":"壮县人歌第一奇，过庭为有宁馨儿。\n亲旁色养宜加谨，户外分豪勿预知。\n寓意杯觞须自节，读书松竹有馀师。\n它时刮目相期待，连桂家风望一夔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24882,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又次丁端叔韵","author":"楼钥","text":"好风凉月湛中秋，自笑何为作远游。\n不有诸君故人恋，未应连日贾胡留。\n三千银界俱呈色，十二珠帘总上钩。\n饮罢客归清不寐，谁知心折大刀头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24883,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又次王瑞安韵","author":"楼钥","text":"云锁千峰碧，泉飞百尺湫。\n山蹊惊险绝，洞府足深幽。\n谷静摇虚箔，岩高卧老虬。\n贾胡还似我，到处辄迟留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24884,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又次徐仲宗通判韵","author":"楼钥","text":"老龙破蛰斩幽关，乱滴天飘不复悭。\n可但甘霖驱旱魃，自然凉气满人寰。\n民心徒切焦熬甚，神力毋劳指顾间。\n遥想清都应表贺，紫宸轩陛晓催班。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24885,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又次蒋甥仲愚韵","author":"楼钥","text":"山色空濛雪更奇，满空击碎吠琉璃。\n寒侵茅屋春无寐，冻合梅花夜不知。\n泛泛轻舟胜路滑，洋洋流水乐人饥。\n兴来但觉酒肠阔，江海安能实漏卮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24886,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又谢申之示诗卷","author":"楼钥","text":"不见贤甥十一年，新诗示我百馀篇。\n古风已喜能行意，近体尤欣细属联。\n宅相真成珠在侧，冷官休叹坐无毡。\n作诗勿谓今馀事，更下工夫继玉川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24887,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三月七日上赐牡丹并蔷薇露劝酒","author":"楼钥","text":"几见牡丹东海涯，暮年敢谓到京华。\n休论千品洛中谱，惊看百枝天上花。\n况有八珍来禁苑，更加双榼赐流霞。\n阖门饱暖聊同醉，稽首将何报宅家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24888,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三月九日从驾","author":"楼钥","text":"昨日为亲寿，今朝从驾行。\n君亲俱有喜，家国共增荣。\n淑气浮黄屋，欢声动玉京。\n人心真易感，翻手作升平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24889,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上魏丞相","author":"楼钥","text":"梦庵深坐宴朝曛，祇有梅花对此君。\n今日衣冠有巢许，向来元凯佐华勋。\n入山谁解访弘景，载酒时应问子云。\n童讽写成心未懒，可因贪佛赞论文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24890,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"下元日暖甚夜风雨大作早微雪从子潗以酴醾来","author":"楼钥","text":"眼明喜见早酴醾，窗外风号集霰时。\n梅蕊已惭前腊破，芳心休用怨春迟。\n纳凉除夜昨几似，见雪芭蕉今不疑。\n若使洛人真得此，应须更诧百宜枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24891,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"乞出过传法闻伯齐归姚江","author":"楼钥","text":"扶病还朝一秃翁，重来宁免笑何公。\n梦魂长是寻云北，归路何时向浙东。\n深愿耸身随画鹢，空劳举目送飞鸿。\n主人竹所终须到，最忆东轩一枕风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24892,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"千佛阁","author":"楼钥","text":"平横云栋塞空虚，倒影仍临碧玉壶。\n千佛威光归宝所，九霄宸藻粲河图。\n人天共叹未曾有，燕雀相惊不敢踰。\n试问南询童子看，化城曾见此楼无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24893,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"士颖弟作真率会次韵","author":"楼钥","text":"何羡祖希情好隆，朱陈累世意交通。\n舅甥巾屦频相接，兄弟樽罍喜更同。\n参坐幸容攻愧子，主盟全赖适斋翁。\n日来愈得清闲趣，斗酒不妨时一中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24894,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"子方移守四明见于浙江亭","author":"楼钥","text":"春初送别欠诗篇，岁晚还欣受一廛。\n都骑始闻临浙水，先声久已詟鄞川。\n里人见说俱延颈，海峤从今定息肩。\n夜夜故山频入梦，为君端欲买归船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24895,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山中怀仲兄","author":"楼钥","text":"雁山曾御九秋风，更喜春深到此中。\n芳草绝怜随意绿，野花真是映山红。\n未知方丈景何似，直恐桃源路已通。\n起听朝鸡无恙否，兹游恨不与君同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24896,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山行","author":"楼钥","text":"行入春山紫翠中，入山深处更桃红。\n一百五日麦秋冷，二十四番花信风。\n千顷摇青几蔽地，四山耸翠欲浮空。\n野桥横跨溪如练，待买轻舟下钓筒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24897,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山阴道中 其二","author":"楼钥","text":"捲上疏帘莫放垂，迎眸景色自淋漓。\n有云更觉千山秀，不雨争知万壑奇。\n古道经行尽遗迹，群贤风度想当时。\n奚囊莫怪新篇少，应接山川不暇诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24898,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"巾山曲肱斋","author":"楼钥","text":"山立青冥外，人行紫翠间。\n小窗开木末，孤塔映江湾。\n平楚一何远，白云相与閒。\n我来不暇寝，冷坐对前山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24899,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中秋","author":"楼钥","text":"岁岁当秋半，人人待月明。\n绝怜今夜赏，更胜去年晴。\n光彩澄高露，氛埃廓太清。\n众心方闵雨，却望暮云生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24900,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中秋无月","author":"楼钥","text":"凉意秋将半，深期月影清。\n昨宵云点缀，今夜雨纵横。\n睡久何曾著，更阑喜暂晴。\n起来聊旷望，终欠十分明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24901,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中秋次从子涔韵","author":"楼钥","text":"雨馀不见日西沈，将谓中秋又作阴。\n佳月忽开千里影，骚人满慰一年心。\n扫除宿翳风虽动，滓秽太清云尚深。\n坐待寒光谁会此，阿咸为我发微吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24902,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"为倪正父尚书题壮怀堂扁以诗来谢次韵","author":"楼钥","text":"久矣君宜任弼谐，果随召驲上天阶。\n几年不作相逢梦，一日俄倾积别怀。\n情厚夫君几鲍叔，愚如老我类高柴。\n它时户册高悬后，直欲扁舟访水涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24903,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书吴梦予古乐府后","author":"楼钥","text":"古来乐府近来无，笔力如君却有馀。\n日恐遗音亡正始，喜闻新作过黄初。\n不誇艺苑徒工瑟，应免侯门久曳裾。\n更向江西诗窟去，他年时寄一行书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24904,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书葛氏诗卷","author":"楼钥","text":"未年六十蚤休官，海角投闲尽自安。\n一纪时容奉香火，七旬遂许挂衣冠。\n重来深愧妨贤路，此去终期保岁寒。\n三上封章归未得，葛家诗卷却羞看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24905,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"五月望月蚀历家又言六月朔日蚀","author":"楼钥","text":"闾巷夜争呼，相传救望舒。\n偶因云暂破，真似月之初。\n孰谓蟆能瞎，端知历不疏。\n太阳交蚀近，试看更何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24906,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"从子淮过省寄伯中弟","author":"楼钥","text":"我家伯父德馀辉，吾弟风标具体微。\n七叶欣闻五争奋，四人先喜一雄飞。\n忍贫老尚甘箪食，教子今方擢省闱。\n他日双椿临六桂，麻衣俱换绿衣归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24907,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"从姑太令人挽词","author":"楼钥","text":"伯祖八贤女，惟姑寿且康。\n又闻歌薤露，谁复是灵光。\n采藻空南涧，生萱怆北堂。\n平生好心地，持以遗诸郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24908,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"以六经左氏传庄子遗伯中弟有诗来谢次韵 其一","author":"楼钥","text":"手披欲究百家编，奴婢年来识郑玄。\n顾我幸多千卷富，念君未有一经全。\n诗书心醉不容醒，父子笔耕期有年。\n此但古人糟粕耳，更须从此悟真筌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24909,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"以六经左氏传庄子遗伯中弟有诗来谢次韵 其二","author":"楼钥","text":"书种传来直到今，读书几似孝标淫。\n欲君终就九经库，与子平分一片心。\n更向漆园穷妙旨，何殊清庙奏遗音。\n中郎书籍付王粲，想得知余此意深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24910,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"元珍弟酌别赋此赠之","author":"楼钥","text":"归来十暑又三霜，衰病那知谒帝傍。\n采菊初期老陶令，种桃应是笑刘郎。\n不辞白首登鳌禁，正欲青衫及雁行。\n今夕团栾同醉后，未知何日驾归航。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24911,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"劝农","author":"楼钥","text":"一番好雨润桑麻，和气欢声十万家。\n太守劝农才出郭，老农含哺竞随车。\n土膏泽泽地宜稻，云物阴阴天养花。\n愿得四方无旱潦，尽教乐岁似东嘉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24912,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"厅事落成老母置酒喜而成诗","author":"楼钥","text":"数椽增葺苟全时，我爱吾庐喜得归。\n儿辈粗能勤父蛊，老夫元不费心机。\n年来每愧踰初望，病里尤知悟昨非。\n从此萧然无一事，但当日舞老莱衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24913,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"天竺祷晴","author":"楼钥","text":"早奉天香祷白衣，迟明宿雾故凄迷。\n忽惊红日穿林薄，无数碧山明涧溪。\n上竺寺连中竺寺，苏公堤映白公堤。\n湖光一碧几千顷，剩捲荷香送马蹄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24914,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"天童玲珑岩","author":"楼钥","text":"扪萝历栈上层峰，寖觉芒鞋踏半空。\n七窍几时开浑沌，八窗无处不玲珑。\n已欣古洞容身过，直恐丹丘有路通。\n俯视人间懒归去，拂衣径欲御天风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24915,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"太上皇帝圣体清康老母进封信安郡太夫人适斋除敷文阁学士有诗为贺次韵 其一","author":"楼钥","text":"清朝孝治古无伦，通籍推恩总及亲。\n八秩升班惟二老，九龄拜命更何人。\n春初庆席欢犹在，岁晚宸纶喜共新。\n须信长年多富贵，祇因同见会昌春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24916,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"太上皇帝圣体清康老母进封信安郡太夫人适斋除敷文阁学士有诗为贺次韵 其二","author":"楼钥","text":"吾母年高绝等伦，痴儿何幸得荣亲。\n九重锡类真千载，八座承恩只一人。\n共仰外门流庆远，喜同介弟宠光新。\n两家盛事人争贺，和气薰为腊里春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24917,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"太令人轩氏挽词 其一","author":"楼钥","text":"缘断身先隐，年侵鬓未华。\n死生犹晓梦，富贵更空花。\n佛祖亲提印，儿孙竞起家。\n无因拜灵几，一奠赵州茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24918,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"太令人轩氏挽词 其二","author":"楼钥","text":"旧说苏无著，夫人亦正宗。\n毒蛇横在路，栗棘更无踪。\n萧散超尘界，扶持礼绀容。\n觉庵谁嗣法，别去德云峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24919,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"太令人赵氏挽词 其三","author":"楼钥","text":"姻娅托三槐，同朝得往来。\n迎春烦设席，举寿荷携杯。\n京尹俄遭难，都人亦助哀。\n琅琅垂绝语，烈妇信高哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24920,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"太令人赵氏挽词 其一","author":"楼钥","text":"令德比鸤鸠，芳年誓柏舟。\n承平犹有态，旷达了无忧。\n方奉平反笑，俄成汗漫游。\n哀荣谁得似，同穴乐哉丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24921,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"太令人赵氏挽词 其二","author":"楼钥","text":"节悯名惊代，浮光孝绝人。\n宜生克家子，赖有断机亲。\n勉使方张虏，终能不帝秦。\n一杯扶上马，孰不为沾巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24922,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"太恭人刘氏挽词 其一","author":"楼钥","text":"籍甚成天助，薰然蔼妇容。\n家肥身愈约，福备礼弥恭。\n上寿九开秩，湛恩四受封。\n何人纪遗德，女婿正乘龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24923,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"太恭人刘氏挽词 其二","author":"楼钥","text":"卫氏一儿足，他人总不如。\n一麾欣义檄，千骑拥潘舆。\n台岳伤归旐，青山满送车。\n佳城流庆远，旁可万家居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24924,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"太淑人叶氏挽词 其一","author":"楼钥","text":"妇职躬蘋涧，芳年誓柏舟。\n壸彝全肃睦，梵行极清修。\n贝叶开空性，神篦豁病眸。\n飘然指归路，净观日西流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24925,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"太淑人叶氏挽词 其二","author":"楼钥","text":"为国生贤子，三迁备母慈。\n版舆崇色养，从櫜勉论思。\n戏舞老莱子，平反隽不疑。\n孝心天罔极，肠断蓼莪诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24926,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"太淑人管氏挽词","author":"楼钥","text":"彤史久不作，谁能有妇功。\n宁知贵家子，乃有昔人风。\n钿轴恩何渥，芝庭泽不穷。\n死生无可憾，况已悟真空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24927,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"太硕人潘氏挽词","author":"楼钥","text":"玉映清心著壸彝，闺房宾敬到齐眉。\n岂惟山水协高趣，更为国家生好儿。\n万口共推诸福备，八旬犹负一年期。\n伯仁冬日应肠断，不见堂前举酒时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24928,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"太孺人蒋氏挽词 其二","author":"楼钥","text":"润屋惟纯俭，居然法度循。\n松楸先垄下，风月旧湖滨。\n子妇皆知孝，孙曾亦可人。\n浦江如可赎，真欲百其身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24929,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"太孺人蒋氏挽词 其一","author":"楼钥","text":"之死靡他志，天乎不谅人。\n嫠孤蓬在首，艰苦棘成薪。\n晚福容千指，心空灭六尘。\n平生贞烈意，终作坐忘身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24930,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夫人携家泛湖","author":"楼钥","text":"三分春色二分休，始见鱼轩泛綵舟。\n诸子侍行欢尽日，一翁独坐淡于秋。\n满斟美酒应同醉，是处名园为少留。\n阴霭在前雷雨后，特晴此日称君游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24931,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"少保李公挽词","author":"楼钥","text":"戚闬疏恩厚，勋门积庆馀。\n弓弯飞将臂，架插邺侯书。\n六纛秦官重，三槐汉相如。\n惜哉终半百，闻者为欷歔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24932,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"少潜兄再立昼锦坊伯中弟有诗次韵","author":"楼钥","text":"东楼旧日史君家，盛德于今说孟嘉。\n昼锦门墙再兴起，乌衣巷陌倍辉华。\n虽无崔氏联三戟，肯学杨家簇五花。\n尤喜桂枝香不断，藏书满屋是生涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24933,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"尺五亭","author":"楼钥","text":"旧说城南社，今登山外亭。\n宫墙步可到，御柳望中青。\n引啸千岩响，哦诗过鸟听。\n曲栏频徙倚，归思渺东溟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24934,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"方兴化挽词 其二","author":"楼钥","text":"雁塔深论契，鹓班试著行。\n参亡闻易箦，越吊后除丧。\n支郡难留邓，佳城久梦方。\n吁嗟德浮位，回施与诸郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24935,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"方兴化挽词 其一","author":"楼钥","text":"庙乏著靴鬼，梦中言更明。\n起家尤感励，为吏极廉平。\n荐口声名重，朝行去就轻。\n奏篇真确论，何日遂施行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24936,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"方运使挽词","author":"楼钥","text":"圣主一见决，孤忠自致身。\n筹边满躯胆，处事掇皮真。\n气直老弥壮，言高用未伸。\n留屯十二事，公论付淮民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24937,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"木蕴之国博迁居 其二","author":"楼钥","text":"名大人称屈，心閒我自馀。\n言诗今子贡，作赋古玄虚。\n凤沼定平进，鸥盟殊未疏。\n潭潭府中去，只作寄斋居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24938,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"水月园","author":"楼钥","text":"具美杯残意未休，相将重上望湖楼。\n楼台忽已居平地，风月何曾识旧游。\n更挈酒樽过水月，坐增诗兴满沧洲。\n春风共约新桥畔，遥拜双龙万斛舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24939,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"水涨乘小舟","author":"楼钥","text":"一番冻雨洗郊丘，冷逼征衫四月秋。\n只喜青山泻悬瀑，不知黄潦涨平畴。\n登途已厌频舆轿，得意何妨且榜舟。\n处顺安贫聊自适，未应坎止愧乘流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24940,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]