ce":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26994,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题四皓对奕瀹茶图各一绝 其一","author":"艾性夫","text":"叠足支颐落子迟，松风冉冉动须眉。\n断蛇失鹿浑閒事，不直云根半局棋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26995,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题四皓对奕瀹茶图各一绝 其二","author":"艾性夫","text":"石乳云腴拨不开，春风潋滟碧磁杯。\n应无俗客烦敲臼，只恐东宫聘使来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26996,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题龟峰僧阁","author":"艾性夫","text":"芦竹丛高荫石阑，菩提香远出林端。\n雁声忽断梧桐雨，草阁秋深倚暮寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26997,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题素庵壁间六首 其六","author":"艾性夫","text":"红尘野马急，老意饥蚕懒。\n借取黄庭经，时时谩遮眼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26998,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题素庵壁间六首 其五","author":"艾性夫","text":"霜崖白石髓，火鼎黄金芽。\n生疏不入梦，饱饭煎江茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26999,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题素庵壁间六首 其四","author":"艾性夫","text":"松影乱书檐，鸟声隔山屋。\n有客抱琴来，为弹芝田曲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27000,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题素庵壁间六首 其三","author":"艾性夫","text":"閒花淡心事，不作春风妍。\n野竹三五枝，引凉吹昼眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27001,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题素庵壁间六首 其二","author":"艾性夫","text":"风粗或捲茅，雨饱颇生草。\n泓然老砚池，照我发缟缟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27002,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题素庵壁间六首 其一","author":"艾性夫","text":"两椅熨秋竹，一帘捲霜藤。\n山风长夜寒，兀兀挑青灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27003,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠僧","author":"艾性夫","text":"利门名路两何凭，百岁风前短焰灯。\n只恐为僧僧不了，为僧心了总输僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27004,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"避梦","author":"艾性夫","text":"困热依然梦不閒，起蒙絮帽待更阑。\n矮梅窗下清如水，淡月笼霜雁影寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27005,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"孺子亭","author":"艾性夫","text":"断草寒烟故宅荒，高风千古映湖光。\n独怜汉帝徵车重，不及陈蕃八尺床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27006,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"灌园","author":"艾性夫","text":"土渴群蔬不肯青，辘轳百转汲深清。\n山翁到老谋生拙，抱瓮崎岖博一羹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27007,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丁亥冬大雪十数作邓清旷以苦寒吟见寄","author":"艾性夫","text":"十雪势未已，一冬天积阴。\n背风留更久，入夜落偏深。\n禾稼连冰柱，天花幻玉林。\n遥怜五峰老，尚寄苦寒吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27008,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七夕对雨","author":"艾性夫","text":"门无辙迹草偏青，屋带秋山意转清。\n打梦易惊棋雹响，载愁不去酒船轻。\n幸无帘幕妨云影，尚欠芭蕉赠雨声。\n欲送星鸾过桥去，夜深河汉未分明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27009,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"人名诗戏效王半山 其二","author":"艾性夫","text":"偶来安石坐林塘，因得栖筠受晚凉。\n归鸟冲烟方陆续，寒花经雨尚黄香。\n云如仙客踪无定，风作山宾语自长。\n师古不成书谩读，乐天深结退居房。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27010,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"人名诗戏效王半山 其一","author":"艾性夫","text":"重耳盈盈岸柳黄，九龄冉冉涧松苍。\n梅开小白添新雪，鸦引童乌弄夕阳。\n樵唱转低春谷永，雁声不断暮云长。\n奔泉浑作山涛响，溅入悬岩百药香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27011,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上蓝寺吸江楼","author":"艾性夫","text":"拔地连云百尺楼，长风断雁十分秋。\n绝无山碍天空阔，独与江邻水拍浮。\n潭底老龙眠屋影，雨馀雌霓跨帘钩。\n愁来莫倚阑干北，一缕烽烟是汴州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27012,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与雪舟杨子圆十五年不相闻一日辱和猥句更号皓隐因复奉寄","author":"艾性夫","text":"羞把长裾事走趋，已将身世混樵渔。\n畏途咫尺如千里，老友多年欠一书。\n最喜山人题皓隐，莫教帝画到幽居。\n欲寻载雪舟边路，来为槃翁赋遂初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27013,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"义马冢","author":"艾性夫","text":"诉得冤伸意始休，敝帷埋骨几经秋。\n兽心犹办死报主，人面却甘生事仇。\n作传自应班豫让，论功何止及留侯。\n世间义字无人识，写在荒丘马冢头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27014,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中齿忽折","author":"艾性夫","text":"老丑移形转可吁，凋零已到骨之馀。\n似因漱石磨成磷，幸免投梭折得疏。\n根笋尚如儿龀短，医师欲实火田虚。\n喜无乾胏劳吾决，含咀犹能味古书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27015,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书东坡诗案","author":"艾性夫","text":"风刺成章昔有之，奸人捃拾欲何为。\n先生定以名招祸，自古何曾狱勘诗。\n下石几令无地死，诬金独幸有天知。\n明朝谪向黄州去，又是东坡觅句时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27016,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"文节谢公挽歌","author":"艾性夫","text":"不甘摇尾乞人怜，视死如归气浩然。\n千古六经俱扫地，独公一柱肯擎天。\n乾坤万劫英雄尽，文节双高日月悬。\n惆怅老身空有泪，玉亭无路荐寒泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27017,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"日永","author":"艾性夫","text":"日永驹难过，庭空雀亦无。\n花招蜂出早，草碍蚁行迂。\n蕉叶露台掌，水光天影图。\n下帘便道静，烟篆起茶炉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27018,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"日食","author":"艾性夫","text":"谁撤天门虎豹扃，群妖食日上青冥。\n一眉不及黄昏月，万目惊看白昼星。\n绝响无人槌败鼓，洗光何地激沧溟。\n仰天凝注需阳复，寂历西风老泪零。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27019,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬夜抄诗作","author":"艾性夫","text":"笔债穷年老发僧，砚寒还复夜敲冰。\n西堂梦后无灵运，夔府归来有少陵。\n诸老文章凡几变，千年风雅欠中兴。\n矮窗烛暗成惆怅，忽见梅花月一棱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27020,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]