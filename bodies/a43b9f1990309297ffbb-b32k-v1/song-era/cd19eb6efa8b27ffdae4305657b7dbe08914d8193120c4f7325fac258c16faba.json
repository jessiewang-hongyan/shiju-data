[{"title":"归次雄州","author":"彭汝砺","text":"雁奴到日人初别，燕子来时我亦还。\n驰马直登山绝顶，争图先见瓦桥关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50096,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颜子 其一","author":"彭汝砺","text":"孔门弟子数三千，高弟惟称七十贤。\n用舍行藏谁与比，当时独许一颜渊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50097,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颜子 其二","author":"彭汝砺","text":"高才独立圣人门，千载巍巍道愈尊。\n试读尘编问遗事，终身不及百馀言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50098,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和履中学士上元有作 其一","author":"彭汝砺","text":"楼头星斗烂文章，锦绣中焚百和香。\n月似中秋灯似昼，总将明德奉吾皇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50099,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和履中学士上元有作 其二","author":"彭汝砺","text":"灯火能催万物春，花间蜂蝶已缤纷。\n太平会与民同乐，总道吾君是圣君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50100,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和履中学士上元有作 其三","author":"彭汝砺","text":"市废商廛野废耕，通宵笑傲乐升平。\n楼前乐奏九成曲，楼下人呼万岁声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50101,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和履中学士上元有作 其四","author":"彭汝砺","text":"珠翠云随凤辇行，重楼截臬与天平。\n春风不禁宫中事，吹落珠帘笑语声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50102,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"二月己亥晓出城祀高禖 其一","author":"彭汝砺","text":"淡云斜月晓昏昏，风物迟回认故园。\n竹叶密藏林下寺，桃花低映水边村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50103,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"二月己亥晓出城祀高禖 其二","author":"彭汝砺","text":"袅袅溪边杨柳丝，纷纷墙外小桃枝。\n流莺恰似无机械，春满人间亦未知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50104,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"二月己亥晓出城祀高禖 其三","author":"彭汝砺","text":"尘沙骑马听溪流，淡薄春风却似秋。\n坐忆洞庭波万顷，滩声长在钓鱼舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50105,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"二月己亥晓出城祀高禖 其四","author":"彭汝砺","text":"尘土冥冥二月风，寥寥天外有归鸿。\n松阴想见芝山路，隔浦溪花岸岸红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50106,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清明早出城东斋","author":"彭汝砺","text":"娟娟花木向春荣，婉婉黄鹂隔叶声。\n冷淡一官祇自笑，五更骑马看清明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50107,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄景繁学士","author":"彭汝砺","text":"丛筠叶叶晓风寒，乔木阴阴昼日间。\n要路想公无此乐，蓬莱新有道家山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50108,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"景繁见和再用前韵驰寄","author":"彭汝砺","text":"鱼飞鲸跃出波澜，独立蓬莱缥缈间。\n会有清诗寄芦竹，能无归梦到溪山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50109,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"豫章彭真人观 其一","author":"彭汝砺","text":"药炉几日就丹砂，流出仙源万里赊。\n及物从来多隐德，功成知不在吞霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50110,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"豫章彭真人观 其二","author":"彭汝砺","text":"重云隐隐即吾家，竹影松阴一径赊。\n坐久肺肠清似觉，远心飞去出云霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50111,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"奉使湖南遇雨寄叔宜","author":"彭汝砺","text":"暮云不肯破重阴，祇系萱堂夜夜心。\n马上北风吹泪落，细随疏雨湿衣襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50112,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"元丰己未冬至夜万载驿尝有诗寄广汉今岁万安驿用前韵呈广汉友兄学士 其一","author":"彭汝砺","text":"去年万载驿逢冬，今夕万安村驿中。\n长笑布袍翁发白，不知今我亦如翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50113,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"元丰己未冬至夜万载驿尝有诗寄广汉今岁万安驿用前韵呈广汉友兄学士 其二","author":"彭汝砺","text":"道途泥滑水溶溶，嗟尔胡为风雨中。\n闭户熟眠无一事，浮生多谢富家翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50114,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄道林元祐长兄","author":"彭汝砺","text":"眼前百万四千门，尽与山河寄一尘。\n毕竟一尘还是梦，梦中无法亦无人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50115,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"途中食菜戏成呈诸僚友兄","author":"彭汝砺","text":"草草盘蔬村野中，粗疏祇似旧家风。\n猫儿虽有湖南笋，勺子即无江外菘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50116,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"役兵初自邓来戍邵因问法曹弟动静戏成小诗","author":"彭汝砺","text":"戍卒初来自邓州，问言曾见法曹否。\n祇云白发青衫者，黑瘦三分似状头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50117,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"民有金刚经风吹失所乃馀干县也时知县与民同见文渊兄作诗俾予和韵","author":"彭汝砺","text":"诸佛当年说色空，色空已坏合还风。\n定随妙喜山河去，西入维摩方丈中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50118,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"竹间见梅花呈都运大夫提刑学士一笑","author":"彭汝砺","text":"湖外春风未到时，竹间时复见梅枝。\n文章不似少陵客，漫对清风无好诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50119,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"忆北堂小梅","author":"彭汝砺","text":"梅与小桃相间栽，梅花应会斗寒开。\n春风最惬慈亲意，想得安舆暇日来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50120,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偶成","author":"彭汝砺","text":"大禅痛与藤条四，林际轻弹蒿指三。\n皮肉枉遭人戮辱，面颜犹使我羞惭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50121,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和梅堂祖心禅师答潭州知府谏议谢凡五遣人召禅师不往 其一","author":"彭汝砺","text":"万里江湖一钓舟，夜寒乘月过沧洲。\n投竿不比任公子，误得骊龙亦上钩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50122,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和梅堂祖心禅师答潭州知府谏议谢凡五遣人召禅师不往 其二","author":"彭汝砺","text":"胡床误看碧松枝，自爱壶中日月迟。\n冰尽暖沙眠犊子，波间细雨浴鱼儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50123,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和梅堂祖心禅师答潭州知府谏议谢凡五遣人召禅师不往 其三","author":"彭汝砺","text":"无弦不似伯牙琴，笑杀钟期错用心。\n却爱铁牛机外语，知音何似不知音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50124,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"得侗书称孟春渐暄因作一偈付愚儿侗","author":"彭汝砺","text":"想见匆匆眉发新，遥知祇是旧时人。\n不堪侮弄彭公老，二月犹呼作孟春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50125,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读孟子 其一","author":"彭汝砺","text":"饱食无庸近素餐，低徊还恐似墦间。\n黄昏一读遗编尽，梦寐清风亦厚颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50126,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读孟子 其二","author":"彭汝砺","text":"洙泗三千弟子贤，行藏独许一颜渊。\n先生出处俱天意，无怪公孙尚间然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50127,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次佛印韵 其一","author":"彭汝砺","text":"咫尺书从江外来，红尘心与眼俱开。\n盐官扇子真无用，漫得犀牛入手来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50128,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次佛印韵 其二","author":"彭汝砺","text":"明明佛日在颠崖，何事山岚不肯开。\n诸处即无甜水草，莫牵牛下雪山来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50129,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和周寺丞韵","author":"彭汝砺","text":"玉津亭树雪层层，故比人间分外清。\n恰似江南春到处，梅花一片拆园英。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50130,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和景繁韵驰寄","author":"彭汝砺","text":"珠珠露缀青云叶，幕幕烟藏碧玉枝。\n频有好风惊独寐，故留明月照相思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50131,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠仲至 其一","author":"彭汝砺","text":"愁忧平日漫纷纷，浅俗何能补上闻。\n欲乞一舟江海去，听君功业上青云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50132,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠仲至 其二","author":"彭汝砺","text":"倒囷虚廪出珠玑，万事从容指是非。\n世有贾生人未识，漫闻流涕欲沾衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50133,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"法轮院","author":"彭汝砺","text":"尘尘法法总无穷，宛转回环路路通。\n亿万恒河沙世界，会知都在一轮中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50134,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和粹老云居之句 其一","author":"彭汝砺","text":"重阳不醉篱边菊，故老匡庐访远公。\n信笔更题诗满叶，总随流水出云中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50135,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和粹老云居之句 其二","author":"彭汝砺","text":"海上句丽百衲衣，天南身毒一筇枝。\n卧龙独乐愁为雨，今问庞公过在谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50136,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和粹老云居之句 其三","author":"彭汝砺","text":"颠倒纵横如彼何，清词丽句不妨多。\n维摩亦漫称居士，木榻堪怜似老婆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50137,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和粹老云居之句 其四","author":"彭汝砺","text":"云中笑语觉风生，摩诘今时令独行。\n摇首谁能拜弥勒，皱眉却合怕渊明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50138,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和瑛师 其一","author":"彭汝砺","text":"山花时复对行舟，想笑行人易白头。\n流水尽窥春燕舞，近山晴见暮云收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50139,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和瑛师 其二","author":"彭汝砺","text":"篇章近日更腾掀，字字含容八万门。\n临水可怜人则远，浮云澄淡月黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50140,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和瑛师 其三","author":"彭汝砺","text":"江城双鲤得诗筒，应念劳劳梦幻中。\n雷电自知生有限，波澜还悟物无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50141,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄广汉","author":"彭汝砺","text":"今年万载驿逢冬，恰似淮南风雪中。\n草草杯盘浑自足，笑谈只欠布袍翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50142,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"己未冬至分宜道阻雨今岁冬至新喻道中亦雨","author":"彭汝砺","text":"去年冬至入分宜，雨雪思亲泪亦垂。\n今日载驰新喻道，大都浑似去年时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50143,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三年七到袁州","author":"彭汝砺","text":"三年把节走天涯，七过宜春城上台。\n林下道人还一笑，雪霜重见使华来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50144,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和执中及谢检法 其一","author":"彭汝砺","text":"天女匆忙来献花，庄严净妙一何嘉。\n儿童更少浑无著，自胜维摩长者家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50145,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和执中及谢检法 其二","author":"彭汝砺","text":"三年不见洛阳花，今日襄阳看转嘉。\n奔走簿书长似梦，不知春已满人家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50146,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答侗 其一","author":"彭汝砺","text":"说禅半夜雨天花，不似无言气味嘉。\n汝但为维摩长者，我甘作净饭王家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50147,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答侗 其二","author":"彭汝砺","text":"花即是空空是花，算来无恶亦无嘉。\n凌烟老将今无事，四海车书浑一家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50148,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"行舟芦苇中","author":"彭汝砺","text":"芦苇萧萧吹晚风，画船长在雨声中。\n浮生厌足江湖味，好在溪边旧钓筒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50149,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和致远","author":"彭汝砺","text":"过从准拟酒如渑，腊到春风次第生。\n七日风流金胜好，九霄雨露锡银罂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50150,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"君宜弟还鄱阳风雨未行驰寄此诗","author":"彭汝砺","text":"鸿雁行行如弟兄，天寒故故作秋声。\n江湖寂寞风雨急，今夜扁舟行未行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50151,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"泛丰陵溪 其一","author":"彭汝砺","text":"系马却行海上滨，夜寒孤月故随人。\n自怜不及溪心月，正照萱堂鬓雪新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50152,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"泛丰陵溪 其二","author":"彭汝砺","text":"溪边置酒稍徘徊，坐看溪声滚滚来。\n传语鸬鹚与鸂鶒，暂时相见莫相猜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50153,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"桥上","author":"彭汝砺","text":"桥南桥北水溅溅，江海归心已浩然。\n素食日惭无补报，临流端欲问归船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50154,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"道遇施户曹口占寄君时","author":"彭汝砺","text":"阴阴作雨祇漫漫，今日虽霜未苦寒。\n归去襄阳见吾弟，为言道路且平安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50155,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和君时弟南斋","author":"彭汝砺","text":"秋阴作雨拟如何，祇欲催人涕泗沱。\n愁绝暮蝉无限意，凄凉啼咽不成歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50156,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和君时语农者 其一","author":"彭汝砺","text":"儿女莫啼翁莫愁，十分栽插十分收。\n酒篘白蚁须盈面，花插黄金听满头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50157,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和君时语农者 其二","author":"彭汝砺","text":"大田既戒岁无忧，零雨其濛夜复收。\n籼稻可惟斋马鬣，圣禾亦自秀牛头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50158,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和君时","author":"彭汝砺","text":"形容枯槁心若灰，参军新读法华来。\n维摩莫道无言说，不二门庭总自开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50159,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"城东谢氏园亭即席上冲元","author":"彭汝砺","text":"小小林亭花竹幽，低徊似拟慰公愁。\n相看剧饮终无绪，坐叹风光信水流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50160,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄君时 其一","author":"彭汝砺","text":"綵服当年尚黑头，鸣铙打鼓下扬州。\n老来却到经游处，一曲烟波一曲愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50161,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄君时 其二","author":"彭汝砺","text":"今年秋是去年秋，自是今游非昔游。\n晚日西风吹泪落，逡巡想已到扬州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50162,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"天寒欲雪不可出门君时在城中促庭佐来君时柬云庭佐掉头云未来因驰寄","author":"彭汝砺","text":"伯兮引领望不断，叔也掉头云未来。\n事事伤心无说处，终朝眼合不能开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50163,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和君时见寄","author":"彭汝砺","text":"不是伤愁不作诗，吾言无益亦何为。\n肺肝欲语竟无处，惟有江头鸿雁知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50164,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和君时叔宜睡 其一","author":"彭汝砺","text":"毋论鸟梦并鱼梦，一听牛呼更马呼。\n看取南柯如许事，睡时扰扰觉时无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50165,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和君时叔宜睡 其二","author":"彭汝砺","text":"庄子蘧蘧梦蝴蝶，尹生昔昔睡呻呼。\n吾游直在诸方外，不但无忧乐亦无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50166,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和君时苦热","author":"彭汝砺","text":"穷檐祇似在蒸炊，无事形疲心亦疲。\n惟有清谈能胜热，终朝无处不相思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50167,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和君时弟芝山避暑","author":"彭汝砺","text":"避热犹如避火攻，尽将身世隐壶中。\n微云急送鹿头雨，远水故吹牛首风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50168,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄叔宜弟","author":"彭汝砺","text":"春风随意自东西，可爱初春燕子飞。\n池外墙头花好在，会应留著待君归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50169,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次云居老诗韵 其一","author":"彭汝砺","text":"西山云雾隐蓬莱，滕阁峨峨亦壮哉。\n莫道长江空自去，一波涛起一如来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50170,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次云居老诗韵 其二","author":"彭汝砺","text":"边庭老将已成功，名在麒麟画阁中。\n塞外牙旗归万马，云间羽箭落双鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50171,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次云居老诗韵 其三","author":"彭汝砺","text":"荆山有玉比山丘，爱玩还将木李投。\n掣电一机吾会得，天边月在水中流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50172,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]