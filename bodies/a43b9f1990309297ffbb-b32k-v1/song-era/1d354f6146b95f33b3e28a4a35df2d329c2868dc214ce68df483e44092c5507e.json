[{"title":"次韵士特试谷帘泉见怀之作 其二","author":"李纲","text":"片云摇曳不胜閒，行尽江南处处山。\n岂解为霖泽枯槁，只思归隐碧岩间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10454,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戊申冬至日有怀诸弟时赴澧阳","author":"李纲","text":"缇室初回律管阳，貂裘还是旅殊乡。\n可堪身向三湘远，更觉愁随一线长。\n棣萼相思劳梦寐，郊禋成礼想旂裳。\n羁臣与国同休戚，老眼犹期见治康。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10455,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"张氏二甥寄诗可喜赋此篇以赠之","author":"李纲","text":"每见吾甥学不休，信知积善有源流。\n骅骝汗血为驹日，松柏凌霜出地秋。\n努力年华成宅相，著鞭高跃破烟楼。\n渭阳正续离骚赋，频寄诗来慰客愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10456,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"得梁溪家书报黄氏女生外孙","author":"李纲","text":"怪底朝来鹊噪门，家书远报女生孙。\n须知钟庆由先德，故使遗芳衍后昆。\n肌骨遥怜凝玉雪，风光自与茁兰荪。\n何时归去亲怀抱，华发褒衣更觉尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10457,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自蒲圻临湘趋岳阳道中作十首 其一","author":"李纲","text":"鄂渚何尝一日安，澧阳犹喜远江干。\n帝妃降矣空遗佩，公子思兮欲采兰。\n水带潇湘疑有雁，地连岭蜀苦无寒。\n迂疏自笑谋身拙，却荷朝廷德意宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10458,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自蒲圻临湘趋岳阳道中作十首 其二","author":"李纲","text":"屈伸任道复何求，去国翻成汗漫游。\n处世久师齐物论，摅怀聊赋畔牢愁。\n霜清日薄寒光急，云惨天高阴气浮。\n袅袅西风洞庭阔，可堪更上岳阳楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10459,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自蒲圻临湘趋岳阳道中作十首 其三","author":"李纲","text":"岁寒又复事南征，桂楫兰舟过洞庭。\n水入重湖千里白，山连平楚数峰青。\n云鸿杳杳飞何远，汀芷微微气自馨。\n千古灵均英爽在，固应笑我学馀醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10460,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自蒲圻临湘趋岳阳道中作十首 其四","author":"李纲","text":"三年奔走未容归，敝尽东周季子衣。\n断垄连冈平野阔，扁舟短棹寸心违。\n凌晨白雾沾裳湿，薄暮彤云夹日飞。\n回首梁溪杳何处，翠烟空锁钓鱼矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10461,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自蒲圻临湘趋岳阳道中作十首 其五","author":"李纲","text":"还驱征骑向三湘，行尽骚人放逐乡。\n绿叶素荣歌橘颂，采衣姣服浴兰汤。\n云中帝子旌旗降，物外桃源日月长。\n便欲翛然与高蹈，故应脱屣谢轩裳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10462,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自蒲圻临湘趋岳阳道中作十首 其六","author":"李纲","text":"不解扬波与餔醨，又还来放楚江湄。\n椒兰气味何其烈，蘅药芬芳空尔为。\n宁赴湘流非我事，托怀鵩鸟乃吾师。\n醉醒清浊初难共，渔父从来自不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10463,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自蒲圻临湘趋岳阳道中作十首 其七","author":"李纲","text":"远谪三湘欲卜居，试从詹尹拂占书。\n昂昂愿作云间鹤，泛泛宁为波底鱼。\n咿喔突梯真得计，洁廉正直却成疏。\n益坚节操行吾志，龟策从来自不如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10464,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自蒲圻临湘趋岳阳道中作十首 其八","author":"李纲","text":"更欲投书吊汨罗，西风袅袅水增波。\n江分梦泽于菟远，地近芳洲杜若多。\n野鸟终年从萃止，木奴千树正婆娑。\n卜居更作终焉计，华发萧萧奈老何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10465,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自蒲圻临湘趋岳阳道中作十首 其九","author":"李纲","text":"俎豆其如军旅何，谁令瀚海起干戈。\n休将直道论三黜，且把微辞续九歌。\n山鬼含颦乘赤豹，湘灵解佩鼓云和。\n蛮邦虽陋吾何恨，厌见旌蕤相荡摩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10466,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自蒲圻临湘趋岳阳道中作十首 其十","author":"李纲","text":"龙驾翩翩帝子游，我因谪宦亦淹留。\n潇湘且傍鼋鼍窟，葭菼空怀鹦鹉洲。\n专气愿师周柱史，著书更笑陆忠州。\n变心从俗吾何敢，千古骚人共此愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10467,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再次韵崧老见和之作时传春秋集传又欲借易说故篇中及之","author":"李纲","text":"胡尘暗中原，河洛皆穹庐。\n衣冠竞南渡，故国靡复馀。\n襄陵大岳裔，亦尔困征涂。\n颠沛不忘道，呻吟曳长裾。\n如公巨川舟，岂止清庙瑚。\n愧我正羁束，未能踵汉疏。\n幸然声气同，鸣凤栖必梧。\n褰裳思琢磨，道阻不得俱。\n已从借麟经，更欲窥羲书。\n庶或晚闻道，洗心复其初。\n湘沅骚人乡，兰芷今岂无。\n回风摇蕙草，叹息空幽居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10468,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"岳阳楼三首 其一","author":"李纲","text":"缥缈层楼俯洞庭，湖光霁色两澄明。\n气蒸云梦浮天白，水合潇湘到底清。\n去棹来樯云共影，断鸿孤鹜笛连声。\n望中更觉君山小，一点青螺镜面平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10469,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"岳阳楼三首 其二","author":"李纲","text":"翛然多难偶存身，又到苍茫楚泽滨。\n鼓舞鱼龙张乐地，佩纫兰茝独醒人。\n涉江哀郢空回首，极目伤心欲向春。\n鼓枻寅缘傍枯苇，故应渔父尚垂纶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10470,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"岳阳楼三首 其三","author":"李纲","text":"常诵飞龙邅洞庭，登楼况复把骚经。\n琉璃万顷天同碧，翠黛一螺山更青。\n白鸟风高方倦翮，苍鹰冬暖正舒翎。\n客愁欲作长鲸吸，却笑三闾只独醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10471,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"鼠须笔 其一","author":"李纲","text":"鼠能为虎亦何功，用舍之间系所逢。\n谁谓有皮为有礼，剪须犹得管城封。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10472,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"鼠须笔 其二","author":"李纲","text":"中山毛颖久中书，鼠辈胡为亦可俱。\n寝庙穴居真得计，畏人端恐擢其须。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10473,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"渡江","author":"李纲","text":"桂枻兰旌楚泽东，碧空如水水如空。\n江湖落日浮秋橘，岛屿残霞拂断虹。\n世事茫然烟霭里，客愁都在橹声中。\n沙头凫雁相俦侣，笑我年年逐转蓬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10474,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"章华台 其一","author":"李纲","text":"断垄连冈云梦西，楚王宫殿尚遗基。\n桂花半落垂黄橘，想见章华九月时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10475,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"章华台 其二","author":"李纲","text":"章华夜饮晓从糜，翠被天寒雨雪霏。\n马足车尘竟何往，空令子革诵招祈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10476,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"华容西二十许里有墨山即离骚所谓玄石也山有大云寺寺有云母泉甘芳洁清大旱不竭唐李华有诗序之甚详其末云华贬杭州司公恩复左补阙次于岳阳江山延望思与高贤共饮云母之泉躬耕墨山之下敢违朝命以询私欲秋风露寒洞庭微波一闻猿声不觉涕下况支离多病年甫始衰愿饵药扶寿以究无生之学事乖志负火爇余心三复其言而悲之因次其韵","author":"李纲","text":"霜风振古林，肃肃有异声。\n我登玄石山，适此氛祲清。\n散策步山巅，僧庐窈而精。\n石磴尽云母，晶荧璨瑶英。\n涓涓幽谷泉，玉色凄芳馨。\n饮者得难老，沈疴体皆平。\n乃知泉源美，本自山川灵。\n沈吟遐叔诗，此其浪得名。\n肺腑久尘埃，于焉吸清泠。\n玉池艳生肥，漱濯归黄庭。\n却思陆子泉，厥味可弟兄。\n白首困飘泊，丹心竟何成。\n鼓枻渡潇湘，曳裾拂荆衡。\n回头故山远，怆恍若为情。\n区区金石坚，正赖日月明。\n卷舒随用舍，未觉殊亏盈。\n风高洞庭波，云瞑兰芷城。\n饵药扶始衰，究心学无生。\n庶几甫知命，寸田不废耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10477,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"至澧阳寓天宁僧舍有感 其一","author":"李纲","text":"常诵离骚澧有兰，那知谪宦憩其间。\n片云只鹤风方急，只恐飘零过别山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10478,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"至澧阳寓天宁僧舍有感 其二","author":"李纲","text":"此身又复寓精庐，丈室萧然一物无。\n每见招提心即喜，前生真是老浮屠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10479,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"深省轩在丈室之西余为名之","author":"李纲","text":"轩槛虚明丈室西，丛筠佳木翠阴垂。\n游观物物皆深省，岂在闻钟欲觉时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10480,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"见报以言者论六事其五皆靖康往故其一谓资囊士人上书以冀复用谪居海南震惧之馀斐然有作 其一","author":"李纲","text":"力小安能胜万钧，退藏深渺欲全身。\n大恩不报有馀责，何必烦言浪指陈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10481,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"见报以言者论六事其五皆靖康往故其一谓资囊士人上书以冀复用谪居海南震惧之馀斐然有作 其二","author":"李纲","text":"非才自丏罢钧衡，百念灰寒岂复萌。\n刚道资囊上书者，不知谁继颍川生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10482,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"见报以言者论六事其五皆靖康往故其一谓资囊士人上书以冀复用谪居海南震惧之馀斐然有作 其三","author":"李纲","text":"尼父乘桴居九夷，管宁浮海亦多时。\n古来圣贤犹如此，我泛鲸波岂足悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10483,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"见报以言者论六事其五皆靖康往故其一谓资囊士人上书以冀复用谪居海南震惧之馀斐然有作 其四","author":"李纲","text":"功似赞皇犹远涉，智如鹤相亦来游。\n世间万事非人力，只有安心百不忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10484,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"见报以言者论六事其五皆靖康往故其一谓资囊士人上书以冀复用谪居海南震惧之馀斐然有作 其五","author":"李纲","text":"苏子曾为海上仙，群龙三复绝韦编。\n我今日对羲文语，却恨公书取次传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10485,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"别夹山能老","author":"李纲","text":"相逢千偈口澜翻，已是亲曾到夹山。\n猿鸟可能知祖意，飞腾青嶂碧岩间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10486,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"药山三咏 其一 问道室","author":"李纲","text":"骨相崭岩心已安，松林谈道不胜寒。\n习之不会高人意，便作天云瓶水看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10487,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"药山三咏 其二 伏牛庵","author":"李纲","text":"侍者何须召二空，一元调伏自知风。\n轩然栋宇翚飞处，何似当年茅竹中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10488,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"药山三咏 其三 雷满池","author":"李纲","text":"英雄割据老渔师，习气难忘凿此池。\n尚想兴酣高会处，投身下取酒杯时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10489,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梁山观音寺","author":"李纲","text":"大士当年白鹿驯，宝坊千古閟松筠。\n风流帝婿膏粱客，也解来为护法神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10490,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自武陵舟行至德山","author":"李纲","text":"舍车泛兰舟，摇荡武陵水。\n憩装古丛林，幽胜冠南纪。\n当时霹雳手，掣电机在捶。\n钤锤今得人，宗旨振颓委。\n何须大雄殿，突兀踞巍址。\n龙蛇相混杂，衲子聚千指。\n齐竽一一吹，真赝见炉锤。\n青葱松竹阴，积翠纷可喜。\n春风一动摇，萧瑟鸣不已。\n却游德岘亭，枉渚抱中沚。\n襄阳今何如，风物略如此。\n空怀堕泪碑，愧叹羊叔子。\n坐令邹湛辈，名字随骥尾。\n胡雏窥汉疆，战哭多新鬼。\n王室如缀旒，寇盗结蜂蚁。\n而我荷宽恩，抱衅适万里。\n回头望中原，洒涕湿巾几。\n海山渺安在，澒洞鲸波里。\n飞仙时往来，当学长不死。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10491,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"益阳白鹿寺","author":"李纲","text":"寺枕清江荫碧梧，萧然景物类东吴。\n登临忽动思归兴，不待秋风可鲙鲈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10492,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"清修寺在益阳数十里间惠远之弟居之世谓之小庐山二首 其一","author":"李纲","text":"盘纡石磴白云间，风落岩花满路斑。\n峰岭横斜自重掩，个中真是小庐山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10493,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"清修寺在益阳数十里间惠远之弟居之世谓之小庐山二首 其二","author":"李纲","text":"傍山修竹翠檀栾，竦节疏枝碧玉寒。\n安得诛茅此君侧，世间浑作梦中看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10494,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自湘乡趋邵阳以避谤不敢取道衡岳有感五首 其一","author":"李纲","text":"平生性僻爱溪山，偶得经行秪为閒。\n叹息迂程避烦啧，坐令南岳阻跻攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10495,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自湘乡趋邵阳以避谤不敢取道衡岳有感五首 其二","author":"李纲","text":"石廪巉天堆祝融，遥看山色有无中。\n宽恩异日容归老，先到衡阳回雁峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10496,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自湘乡趋邵阳以避谤不敢取道衡岳有感五首 其三","author":"李纲","text":"恭闻南岳魏夫人，绛节霓旌拥玉轮。\n我欲他年受真诀，先从碧海涤埃尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10497,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自湘乡趋邵阳以避谤不敢取道衡岳有感五首 其四","author":"李纲","text":"邺侯奇谲世难知，放浪衡湘亦避时。\n懒瓒不知今在否，无心更与觅蹲鸱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10498,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自湘乡趋邵阳以避谤不敢取道衡岳有感五首 其五","author":"李纲","text":"退之昔谪恶溪滨，精意能开衡岳云。\n我匪天穷坐人阨，试从山外望氛氲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10499,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"邵阳道中云岩寺","author":"李纲","text":"山空小寺依嵌窦，日暖幽禽转好声。\n万个琅玕一茅屋，何当此处寄浮生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10500,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"清湘西山寺无量寿塔","author":"李纲","text":"黄花翠竹真如性，大地山河清净身。\n欲识今时无量寿，不知瞻礼是何人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10501,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"桂林道中二首 其一","author":"李纲","text":"桂林山水久闻风，身世茫然堕此中。\n日暮碧云浓作朵，春深稚笋翠成丛。\n仙家多住朱明洞，客梦来游群玉峰。\n雁荡武夷何足道，千岩元是小玲珑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10502,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"桂林道中二首 其二","author":"李纲","text":"时危远谪堕南峦，犹在乾坤覆载间。\n瘴雨岚烟殊气候，玉簪罗带巧溪山。\n桄榔叶暗伤心碧，踯躅花开满目斑。\n惟有月华依旧好，清辉应与照云鬟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10503,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山月驿闻子规次韵","author":"李纲","text":"春枕梦回孤馆悄，世故萦心愁不了。\n山深夜闲子规啼，残月满窗天未晓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10504,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"道阳朔山水尤奇绝旧传为天下第一非虚语也赋二绝句 其一","author":"李纲","text":"溪山此地蔼佳名，雨洗烟岚分外青。\n却恨征鞍太匆遽，无因一上万云亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10505,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"道阳朔山水尤奇绝旧传为天下第一非虚语也赋二绝句 其二","author":"李纲","text":"赋诗曾送谪仙人，垂老翻游到海滨。\n梦幻去来何日了，且将病眼看嶙峋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10506,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"献花铺唐相李德裕谪海南道此有山女献花因以名之次壁间韵","author":"李纲","text":"我亦乘桴向海涯，无人复献雨中花。\n却愁春梦归吴越，茗饮浓斟薄荷芽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10507,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"象州道中二首 其一","author":"李纲","text":"路入春山春日长，穿林渡水意徜徉。\n溪环石笋横舟小，风落林花扑面香。\n山鸟不知兴废恨，岭云自觉去来忙。\n炎荒景物随时好，何必深悲瘴疠乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10508,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"象州道中二首 其二","author":"李纲","text":"竹屋茅檐三四家，土风渐觉异中华。\n碧榕枝弱还生柱，红荔春深已著花。\n社燕不巢南候别，塞鸿无信北音赊。\n海山此去犹千里，会见安期枣似瓜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10509,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"饮修仁茶","author":"李纲","text":"北苑龙团久不尝，修仁茗饮亦甘芳。\n誇研斗白工夫拙，辟瘴消烦气味长。\n江表露芽空绝品，蜀中仙掌可同行。\n从容饭罢何为者，一椀还兼一炷香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10510,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自去冬不雨至今道傍井竭田多不耕有感","author":"李纲","text":"匝地风雷空震荡，终宵云雨竟虚无。\n媮閒农具田皆废，暍死行人井半枯。\n东海愆阳缘孝妇，桑林谒祷本谗夫。\n忠魂昭雪奸邪逐，坐见为霖万物苏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10511,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次贵州二首 其一","author":"李纲","text":"青枫夹道鹧鸪啼，古郡荒凉接岛夷。\n陆绩故城依石巘，葛洪遗灶俯江湄。\n光风苒苒吹香草，烟雨濛濛湿荔枝。\n欲作终焉卜居计，自应痀偻不吾欺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10512,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次贵州二首 其二","author":"李纲","text":"怀泽为邦古郁林，江边邑屋树森森。\n山连八桂峰峦秀，地近重溟雾雨淫。\n岁久承平消瘴疠，时危争战觉幽深。\n试谋十亩膏腴地，丹荔青蕉获我心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10513,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"伏读三月六日内禅诏书及传将士榜檄慨王室之艰危悯生灵之涂炭悼前策之不从恨奸回之误国感愤有作聊以述怀四首 其一","author":"李纲","text":"忆昔廷诤驻跸时，孤忠欲挽六龙飞。\n莱公谩有亲征策，亚父空求骸骨归。\n灵武中兴形势便，江都巡幸士心违。\n累臣独荷三朝眷，瘴海徒将血涕挥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10514,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"伏读三月六日内禅诏书及传将士榜檄慨王室之艰危悯生灵之涂炭悼前策之不从恨奸回之误国感愤有作聊以述怀四首 其二","author":"李纲","text":"胡骑长驱扰汉疆，庙堂高枕失提防。\n关河自昔称天府，淮海于今作战场。\n退避固知非得计，威灵何以镇殊方。\n中原夷狄相衰盛，圣哲从来只自彊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10515,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"伏读三月六日内禅诏书及传将士榜檄慨王室之艰危悯生灵之涂炭悼前策之不从恨奸回之误国感愤有作聊以述怀四首 其三","author":"李纲","text":"叹息奸臣术已疏，谋身误国竟何如。\n马嵬不进杨钊死，关陜初临元振除。\n王室威灵嗟索寞，苍生环堵未安居。\n荒陬不见中原事，望断东吴一纸书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10516,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]