[{"title":"田园词","author":"吕炎","text":"阴阴径底忽抽叶，莫莫篱边豆结花。\n唳鹤清愁牵犬恨，料应不到菜园家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36683,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渔父","author":"吕炎","text":"万顷江天一叶舟，桃花春水蓼花秋。\n翛然白鸟苍烟外，只有渔翁得自由。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36684,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闺思","author":"吕炎","text":"夜久香销翡翠奁，十分春恨上眉尖。\n荼蘼谢了樱桃过，人影参差月半帘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36685,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"洞仙歌","author":"吕直夫","text":"征鞍带月，浓露沾襟袖。\n马上轻衫峭寒透。\n望翠峰深浅，忆着眉儿，腰肢袅，忍看风前细柳。\n别时频嘱付，早寄书来，能趁清明到家否。\n这言语，便梦里、也在心头，重相见、不知伊瘦我瘦。\n纵百卉千花已离披，也趁得、酴醾牡丹时候。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36686,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"勿愿寿","author":"吕南公","text":"勿愿寿，寿不利贫袛利富。\n君不见生平龌龊南邻翁，绮纨合杂歌鼓雄。\n子孙奢华百事便，死后祭葬如王公。\n西家老人晓稼穑，白发空多缺衣食。\n儿孱妻病盆甑乾，静卧藜床冷无席。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36687,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"老樵","author":"吕南公","text":"何山老翁鬓垂雪，担负樵苏清晓发。\n城门在望来路长，樵重身羸如跛鳖。\n皮枯亦复汗淋沥，步强遥闻气呜咽。\n同行壮俊常后追，体倦心烦未容歇。\n街东少年殊傲岸，和袖高扉厉声唤。\n低眉索价退听言，移刻才蒙酬与半。\n纳樵收直不敢缓，病妇倚门待朝爨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36688,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"调笑令 其二","author":"吕南公","text":"华草。\n华草。\n秀发乘春更好。\n深心密竹纷纷。\n妖韶随处动人。\n人动。\n人动。\n王孙公子情重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36689,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大涤洞","author":"吕某","text":"古桧沉沉万籁微，祥光萦绕锁瑶扉。\n石间怪底泉涓滴，却是老龙行雨归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36690,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题议门胡氏华林书院","author":"吕祐之","text":"几朝旌表映门闾，更赏林园入画图。\n廷诏总宜名让水，树巢多恐是慈乌。\n花迎客馆清香远，竹绕书堂气节殊。\n我直紫垣无路到，乱云芳草隔洪都。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36691,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"禁林宴会之什","author":"吕祐之","text":"高会蓬瀛振德音，崇贤同庆湛恩深。\n瑞融云露飞宸翰，荣下烟霄饰禁林。\n凤藻镶奇清击石，龙文模琢丽雕金。\n辞臣喜适逢时愿，睿眷殊敦好士心。\n华照北门张组绣，秘逾东序敌球琳。\n玉堂宴罢尤知幸，御榜天章岂易寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36692,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题尉廨壁","author":"吕祖仁","text":"屈指未逾月，沿封十往还。\n路危频驻马，力倦怯登山。\n亲老难辞禄，时平懒养闲。\n自怜清苦节，谁与达天颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36693,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"县学秋试","author":"吕祖平","text":"细雨轻寒弄晓晴，纷纷鹄立拥书黉。\n广庭剩欲先耆艾，小试聊烦唤弟兄。\n韫椟此时增玉价，传家有子胜金籯。\n鸡虫得失能多少，也听春蚕叶上声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36694,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"呈孙元素","author":"吕祖异","text":"匹马先来破晓云，千章乔本翠缤纷。\n山围道院窗窗见，泉出丹池处处分。\n酒好便能浇磈磊，饭香何必御膻荤。\n明朝又踏红尘去，多羡烟霞总属君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36695,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重游洞庭","author":"吕祖异","text":"重来洞庭野，往事付行云。\n乐奏思黄帝，珠寒讶鄂君。\n朝廷用儒术，兵甲洗妖氛。\n好在胸中策，堂堂整六军。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36696,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送时法登舟","author":"吕祖俭","text":"四山寒雨送行舟，独掩柴扉泪未收。\n归见故人应问我，为言卒岁敢优游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36697,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送汪时法归金华 其一","author":"吕祖俭","text":"扁舟南去意茫然，襆被追随便欲前。\n亲故道途相与语，但言高义薄云天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36698,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送汪时法归金华 其五","author":"吕祖俭","text":"人言追送不嫌远，我独衰残懒出门。\n重教来时路旁候，犹留风月伴黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36699,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送汪时法归金华 其六","author":"吕祖俭","text":"归去儿曹欲与言，相思切处莫窥园。\n吾宗事业无多子，守得箪瓢始见根。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36700,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送汪时法归金华 其七","author":"吕祖俭","text":"携手山桥第一轩，谁能结我梦中缘。\n他年有意重过我，细细炉熏理旧编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36701,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送汪时法归金华 其三","author":"吕祖俭","text":"霁虹解缆动江声，风不随人舟易横。\n咫尺青泥含淡月，何时相对话平生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36702,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送汪时法归金华 其二","author":"吕祖俭","text":"梅潦因仍不计旬，舟车屡易敢因循。\n昭真观里泠泠水，岂解游人有怒瞋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36703,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送汪时法归金华 其四","author":"吕祖俭","text":"问途快阁得宽恩，舟转风移日未昏。\n山月相忘期度岁，别怀祗觉暗销魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36704,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"慈溪龙虎轩偶成 其四","author":"吕祖俭","text":"苍然暮色已峥嵘，姑射山头卧玉鲸。\n墨客强生龙虎想，我来犹自怯威名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36705,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"慈溪龙虎轩偶成 其三","author":"吕祖俭","text":"仙都石笋似天成，凫水松龙是弟兄。\n走遍游人与行客，未知谁可寄深情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36706,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"慈溪龙虎轩偶成 其六","author":"吕祖俭","text":"年来世路转蹉跎，正大中庸论愈多。\n出本无心归亦好，何须胸次自干戈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36707,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"慈溪龙虎轩偶成 其五","author":"吕祖俭","text":"尚书风节映鄞川，人物萧然又几年。\n世路逶迤虽已极，轩前龙虎尚依然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36708,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"慈溪龙虎轩偶成 其一","author":"吕祖俭","text":"龙蟠虎踞秣陵城，甬上苍官亦强名。\n独占高峰傲千古，夜深月照落潮声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36709,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"慈溪龙虎轩偶成 其二","author":"吕祖俭","text":"老松偃蹇卧江滨，风月烟云寄此身。\n不羡参天二千尺，低徊欲对小峨岷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36710,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"韶阳之迁道中呈汪时法 其一","author":"吕祖俭","text":"南江一道水分明，寂寂扁舟不记程。\n回望家山在云际，梦魂犹对短书檠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36711,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"韶阳之迁道中呈汪时法 其三","author":"吕祖俭","text":"一川风月下扁舟，荡漾金波泛白鸥。\n此去韶江知几里，九成缥渺在云头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36712,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"韶阳之迁道中呈汪时法 其二","author":"吕祖俭","text":"汪氏诸郎子独贤，相从过岭过韶川。\n九龄风味犹存否，莫向南华却问禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36713,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题史子仁碧沚 其二","author":"吕祖俭","text":"中州累石势嵯峨，城外遥峰耸翠螺。\n旧说夕阳无限好，此中更得夕阳多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36714,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和赵户曹游南湖之篇","author":"吕祖俭","text":"金华山下旧同游，甬水相逢又半秋。\n明月初开青玉匣，彻云吹破白云头。\n谁能共我同清赏，且得从君散客愁。\n深夜沉沉欲回棹，浩歌相送过青州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36715,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金沙台","author":"吕祖俭","text":"谪居无地寄幽怀，□有高台自汉开。\n紫极晨光招我望，锦江春色逐谁来。\n赓歌惟忆多炎裔，作赋应怜乏贾才。\n人物若增山水胜，诗仙龙种两奇哉。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36716,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"泛舟至竹洲","author":"吕祖俭","text":"湖光拍天浮竹洲，隐然一面城之幽。\n中有高士披素裘，我欲从之恐淹留。\n探囊百金办扁舟，又烦我友著意修。\n微风一动生波头，飞棹来往倦则休。\n兀兀坐曹如系囚，吏馀只有万斛愁。\n一生安坐无几求，今日栖迟如置邮。\n脱帽露顶固狂流，俯首折腰亦可羞。\n誓将入海登之罘，弃置人閒绕指柔。\n苍然暮色下羊牛，出处语默两悠悠。\n九原可起柳柳州，燕坐相与未始游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36717,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诗一首","author":"吕祖俭","text":"小斋标新名，清风自成响。\n世累已破除，阳来道方长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36718,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晁景迂大观庚寅冬为四明船场后七十有馀年某适以仓氏之职至此閒而王兄季和亦来作景迂官相与访问旧迹故传尚有可考偶成数语简季和因呈叔晦","author":"吕祖俭","text":"鄞川旧有船司空，小亭晚望江之东。\n父老犹能理前话，无钱无木人无功。\n风流已往四十载，水仙木犀徒自红。\n吾尝夜看司空集，元符上书入邪中。\n岁月蹉跎今几许，俯仰一身随转蓬。\n自尔怕道四明守，讵有律吕为始终。\n易系后谱此时有，又得刚说来发蒙。\n鲁人猎较亦猎较，复使妙句追飞鸿。\n朅来海头四阅月，尘埃满袖生?氃。\n平生执鞭所欣慕，追寻故迹得数弓。\n超然之名犹可想，海气微茫日未昽。\n越中岂是不好事，别乘皆贤心已㤝。\n场官缱绻真我友，欲来卜筑祠此翁。\n大书特书景迂号，庶几遗躅常清通。\n簿书期会目前耳，此意当令齐洛嵩。\n丰公室外草芃芃，了斋却埽耳若聋。\n当时二士相游从，夜阑太息非为躬。\n年运而往将溟濛，后辈风□□□□。\n薄材微宦犹未工，尸祝越俎自忡忡。\n谁图遗像寘学宫，时与先儒相磨砻。\n却归金华守吾宗，端坐不出固其穷。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36719,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"道上有感","author":"吕祖俭","text":"群书乱插架，荏苒忽忘年。\n归来谁谓必，拂拭复茫然。\n圣远道难继，事变如山连。\n寒夜煨芋栗，炎天浮藕莲。\n时与旧朋俦，曳杖访林泉。\n忽来朝市中，岁月复推迁。\n一朝忽南去，道里有馀艰。\n韶阳号善地，九龄亦称贤。\n杜门省愆咎，夙夜问周旋。\n异时归故里，拜扫明招阡。\n目力傥未衰，庶几守遗编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36720,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题听雨堂","author":"吕祖俭","text":"王笋参参好弟兄，幽轩共对短灯檠。\n抟风万里志将遂，听雨几年心独清。\n戏綵奉觞欢正洽，对床攲枕梦初成。\n此时细细檐花落，别是一觥风雨声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36721,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再赋真觉僧房芦三首 其三","author":"吕祖谦","text":"清晓霜钟唤客兴，馀声知度几棱层。\n烟霞深处无人到，时见凭栏一两僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36722,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再赋真觉僧房芦三首 其二","author":"吕祖谦","text":"屋角清渠濑浅沙，风斜雨重倒苍葭。\n沙鸥不下投前浦，塞雁重来失旧花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36723,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再赋真觉僧房芦三首 其一","author":"吕祖谦","text":"湖山近减江湖趣，寂历颓垣仲蔚蒿。\n纵有秋风何处著，绕篱无叶起苍涛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36724,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西兴道中二首 其二","author":"吕祖谦","text":"桑麻张王不知春，帝恐莺花太断魂。\n东岸红霞西岸绿，却将景色为平分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36725,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西兴道中二首 其一","author":"吕祖谦","text":"凫鹜迎船似有情，随波故起绿粼粼。\n野花照水开无主，谁信春归已两旬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36726,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜宿浦城鱼梁徐删定子出示林谦之挽其父二诗时谦之方按刑广东有怀次韵 其二","author":"吕祖谦","text":"两章宛转复清哀，读到鱼梁首重回。\n便使短笺无姓字，也应知自艾轩来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36727,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜宿浦城鱼梁徐删定子出示林谦之挽其父二诗时谦之方按刑广东有怀次韵 其一","author":"吕祖谦","text":"五年不说空山雨，今夜鱼梁著钓船。\n为问故人今健否，桄榔叶暗瘴江边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36728,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日西兴道中 其五","author":"张栻","text":"檐铎无声鸟语稀，径深钟梵出花迟。\n日长遍绕溪南寺，未信东风属酒旗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36729,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日 其二","author":"吕祖谦","text":"络石寒毛涧底明，春来绿遍小峥嵘。\n凭谁再续平泉记，为定芸兰孰弟兄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36730,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日 其一","author":"吕祖谦","text":"春波无力未胜鸥，夹岸山光翠欲流。\n若使画成惊顾陆，更教吟出压曹刘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36731,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日西兴道中 其三","author":"张栻","text":"岸容山意两溶溶，便是东皇第一功。\n春色平铺人不见，却将醉眼认繁红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36732,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送朱叔赐赴闽中幕府二首 其二","author":"吕祖谦","text":"路逢十客九衿青，半是同窗旧弟兄。\n最忆市桥灯火静，巷南巷北读书声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36733,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送朱叔赐赴闽中幕府二首 其一","author":"吕祖谦","text":"止戈堂上屐声閒，飞盖相追杳霭间。\n君到定知难入眼，倚天灊霍是家山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36734,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏日","author":"吕祖谦","text":"阶前水乐元无谱，檐外风琴不用弦。\n待唤青奴与黄奶，为君极意作今年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36735,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚春二首 其二","author":"吕祖谦","text":"风絮流花一任渠，北窗高卧绿阴初。\n闭门春色閒中老，为谢平生董仲舒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36736,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚春二首 其一","author":"吕祖谦","text":"卷地狂风殿晚春，落花盖水欲成云。\n向人不改故时面，惟有苍官与此君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36737,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"祭酒芮公既殁四年门人吕某始以十诗哭之 其三","author":"吕祖谦","text":"小醉初醒日半昏，森森赤棒绕篱门。\n慨然投袂无难色，不识从来狱吏尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36738,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"祭酒芮公既殁四年门人吕某始以十诗哭之 其九","author":"吕祖谦","text":"璧水经年奉宴居，天和袭物自舒徐。\n凭谁寄谢朱公掞，才向春风坐月馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36739,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"祭酒芮公既殁四年门人吕某始以十诗哭之 其七","author":"吕祖谦","text":"闻人有善己伸眉，倒廪倾囷更不疑。\n菶菶萋萋竟何许，卷阿空老凤皇枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36740,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"祭酒芮公既殁四年门人吕某始以十诗哭之 其八","author":"吕祖谦","text":"胸怀北海与南溟，却要涓涓一勺清。\n相对蹴然如重客，无人信道是门生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36741,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"祭酒芮公既殁四年门人吕某始以十诗哭之 其五","author":"吕祖谦","text":"殿前拜疏阅群公，献替从违各异同。\n陛楯诸郎自相语，白头祭酒最由衷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36742,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"祭酒芮公既殁四年门人吕某始以十诗哭之 其四","author":"吕祖谦","text":"交广归来里巷迎，破囊又比去时轻。\n何须更酌廉泉水，夫子胸中万斛清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36743,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"祭酒芮公既殁四年门人吕某始以十诗哭之 其六","author":"吕祖谦","text":"出祖津头六馆空，帽檐齐侧挂帆风。\n吴兴盛事人能数，直自胡公到芮公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36744,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"祭酒芮公既殁四年门人吕某始以十诗哭之 其十","author":"吕祖谦","text":"先生墓木绿成围，弟子摧颓昼掩扉。\n大雪繁霜心已死，有时清梦尚抠衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36745,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"祭酒芮公既殁四年门人吕某始以十诗哭之 其二","author":"吕祖谦","text":"际野尘埃扑面来，万人蚁聚拨难开。\n手中杓柄长多少，蛰尽饥肠十月雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36746,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"祭酒芮公既殁四年门人吕某始以十诗哭之 其一","author":"吕祖谦","text":"少年把笔便班扬，咳唾珠玑落四方。\n岁晚寒窗浑忘却，瓦炉香细雨声长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36747,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"富阳舟中夜雨","author":"吕祖谦","text":"万顷烟波一叶舟，已将心事付溟鸥。\n蓬笼夜半萧萧雨，探借幽人八月秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36748,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游丝","author":"张栻","text":"游丝浩荡醉春光，倚赖微风故故长。\n几度莺声留欲住，又随飞絮过东墙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36749,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登八咏楼有感","author":"吕祖谦","text":"仲舒旧事无人记，家令风流一世倾。\n天下何曾识真吏，古来几许尚虚名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36750,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题刘氏绿映亭 其二","author":"张栻","text":"鹭浴鱼跳在镜屏，摇青浮碧太鲜明。\n墙东种得阴成幄，隔叶看来却有情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36751,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]