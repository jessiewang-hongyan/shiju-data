":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46328,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其六十九","author":"宋白","text":"绣骑前驱尽国娃，芳园初看牡丹花。\n千官狼狈如蜂蝶，回避杨妃七宝车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46329,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其七十六","author":"宋白","text":"春来车驾入西都，父老千人拜路隅。\n潜问马嵬端正树，枝条犹似旧家无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46330,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其三十一","author":"宋白","text":"昨日传宣唤打毬，星丸月杖奉宸游。\n上阳宫女偏蹻捷，争得楼前第一筹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46331,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其五十二","author":"宋白","text":"如何帝女降钧天，泽国增封旧粉田。\n仙史多才颜似玉，乘鸾消息在今年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46332,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其七十七","author":"宋白","text":"腊日天寒苑猎迟，猎回诸卫龊枪旗。\n女真王子新朝觐，旋遣黄门赐口脂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46333,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其三十","author":"宋白","text":"小苏年少最多才，半酒扶将入内来。\n重饮玉钟方下笔，思泉如涌不劳催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46334,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其四十二","author":"宋白","text":"乐府新呈按舞图，教时仍遣促功夫。\n梨园弟子知天意，月五楼前欲大酺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46335,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其九十三","author":"宋白","text":"今夜金吾不禁街，灯山火树准宣牌。\n长安一片星河里，丹凤楼高众乐谐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46336,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其八十八","author":"宋白","text":"上苑欣逢祓禊辰，踏青因过望贤春。\n连昌宫使开金锁，步障花深不见人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46337,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其四十九","author":"宋白","text":"龙焙中春进乳茶，金瓶汤沃越瓯花。\n玉堂宣赐元承旨，明日登庸降白麻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46338,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其十四","author":"宋白","text":"帝诰皇坟味有馀，万几无暇旋生疏。\n终须别置三千女，分记金华殿里书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46339,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其十七","author":"宋白","text":"玉殿金扉夜不扃，露华如水洗圆灵。\n昭阳女伴新承宠，心祝君王拜寿星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46340,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其二十二","author":"宋白","text":"欢笑声高出禁园，禄儿新样绣初翻。\n青娥阿监知非礼，心怕君王不敢言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46341,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其三十七","author":"宋白","text":"道院秋眠对绮疏，翻思十五入宫初。\n花前听得君王道，禁掖三千总不如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46342,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其四十四","author":"宋白","text":"春云如鹤惹银台，银榜宫门隔水开。\n女史尚书供甲令，玉妃明日祀高禖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46343,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其三十九","author":"宋白","text":"彤管先修女史箴，清才绝妙继词林。\n玉纤亲出黄金赐，愈见中宫逮下心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46344,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其九","author":"宋白","text":"翰苑新除李谪仙，鳌宫春雨湿花砖。\n宣来立草和亲诏，一笔书成对御前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46345,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其二十四","author":"宋白","text":"棋品从来重一先，后庭无事绿窗闲。\n昭容不赌寻常物，言得千金紫玉环。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46346,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其六十三","author":"宋白","text":"裹头宫女浅妆梳，选入昭阳奉玉舆。\n一曲新声春称旨，赐绯教赐小金鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46347,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其九十九","author":"宋白","text":"宫棋初罢请银笙，合曲偏宜钿面筝。\n未伏延年花下唱，金钱百万赏新声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46348,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其六十七","author":"宋白","text":"万方琛贽泛云涛，来庆星枢电彩高。\n宴罢乐声移别殿，对花重换赭红袍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46349,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其一","author":"宋白","text":"千官朝谒五门前，一路春风蜡烛烟。\n宫漏乍停班已定，紫云开处望尧天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46350,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其十一","author":"宋白","text":"飞烟缥缈拂楼台，才捲珠帘雉扇开。\n春满天颜两眉喜，玉关新有捷书来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46351,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其七","author":"宋白","text":"中使传宣出未央，外宫庭燎发荣光。\n怪来连夜催仪注，元是平明册五王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46352,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其四十七","author":"宋白","text":"宫花灼灼柳绵绵，一道春风响静鞭。\n驾出未知何处去，月华池上教龙船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46353,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其五十一","author":"宋白","text":"日影风乌树影浓，黄门轻骑疾如风。\n一行御札缘何事，敕借宁王避暑宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46354,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其五十","author":"宋白","text":"新生帝子浴漪兰，三日宫中列绮筵。\n嫔御称觞呼万岁，笙歌一片夜掀天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46355,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其六","author":"宋白","text":"楼前宣赦掣金鸡，大礼新成彩仗归。\n万岁声高天地喜，庆云飞上衮龙衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46356,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其八","author":"宋白","text":"掖庭宫女仅千人，有敕都教放出门。\n恋主顿忘幽愤意，促辞中使尽啼痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46357,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]