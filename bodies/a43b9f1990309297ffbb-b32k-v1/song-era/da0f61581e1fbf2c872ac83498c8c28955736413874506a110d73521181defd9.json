[{"title":"潇湘八景 其二 烟寺晚钟","author":"赵扩","text":"金碧招提古，高峰最上层。\n喧风僧入梵，宿雾佛前灯。\n禅观延空寂，蒲牢忽震凌。\n黄昏山路险，窘步一枝藤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46279,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"潇湘八景 其三 渔村夕照","author":"赵扩","text":"林表堕金鸦，孤村三两家。\n晴光明浦溆，红影带蒹葭。\n傍舍收鱼网，隔溪横钓槎。\n炊烟未篝火，新月一钩斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46280,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"潇湘八景 其五 潇湘夜雨","author":"赵扩","text":"清泛三湘夜，中舱听雨眠。\n楚天闻过雁，北馆未归船。\n浊酒饮无算，青灯冷不烟。\n对床工觅句，达旦见新编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46281,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠朱质","author":"赵扩","text":"袖手长才世路轻，爱闲那有鬻荣名。\n挂冠便欲辞丹阙，策杖还归老故城。\n适喜不求三仕喜，传家惟有十分清。\n林间佳处真恬退，好向廉泉自濯缨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46282,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"盐泉","author":"宋永孚","text":"一泉流白玉，万里走黄金。\n人事有因革，宝源无古今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46283,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九日 其三","author":"宋白","text":"秋色萧萧野水边，茱萸时节菊花天。\n明时未达青云晚，惆怅登高又一年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46284,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九日 其二","author":"宋白","text":"陶家篱落菊花开，醉拟西风立钓台。\n一座良交皆不见，数声燕雁戛云来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46285,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九日 其一","author":"宋白","text":"霜冷风清九月九，茱萸黄菊家园有。\n何时玉殿接千官，称觞共进南山寿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46286,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中秋感怀 其二","author":"宋白","text":"云彩冰光似去年，去年人月两婵娟。\n今宵不辨连明坐，拚醉抽身黑处眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46287,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中秋感怀 其一","author":"宋白","text":"去年今夜此堂前，人正清歌月正圆。\n今夜秋来人且散，不如云雾蔽青天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46288,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其九十七","author":"宋白","text":"绣额珠帘窣地重，微风吹动牡丹枝。\n金笼鹦鹉耽春睡，忘却新教御制诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46289,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其三十五","author":"宋白","text":"去年因戏赐霓裳，权戴金冠奉玉皇。\n久著淡黄心觉厌，春来不敢便红妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46290,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其六十一","author":"宋白","text":"麝波兰滟涌温汤，白玉莲花吐异香。\n春雪怕融偎侍女，尚衣新进蹙金裳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46291,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其九十","author":"宋白","text":"花萼楼高望柳堤，春桥横水短虹蜺。\n五陵游侠翩翩过，半脱朱袍斗锦鸡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46292,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其七十五","author":"宋白","text":"禁脔成功大殿邦，入朝宫骑绣双双。\n九霄弟子黄金辇，十万人家凭看窗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46293,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其十九","author":"宋白","text":"离宫春晚雨霏霏，日晚君王带雨归。\n翠辇急行红袂湿，中途方忆瓦油衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46294,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其七十九","author":"宋白","text":"玉管金筝入夜调，今宵灵匹下青霄。\n穿针斗巧香烟湿，楼阁层层拂虹桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46295,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其四十一","author":"宋白","text":"慢拍红牙转眼波，念奴楼上一声歌。\n春喉爽朗天颜喜，不遣帘前乐器和。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46296,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其三十二","author":"宋白","text":"红骑翩翩小绣旗，苑中秋雁恰来时。\n何妨十日方归内，料得千官总不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46297,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其十八","author":"宋白","text":"宫门閒掩兽镮斜，微雨新晴满地花。\n番次未当车驾出，却寻同伴学宣麻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46298,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其二十六","author":"宋白","text":"水晶宫闭月光铺，羯鼓声乾雨点粗。\n一曲未终馀思在，急宣前殿唤花奴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46299,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其十五","author":"宋白","text":"后苑秋晴校猎归，淡妆宫女尽戎衣。\n数中供奉谁精熟，斜勒骄骢掠草飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46300,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其五十五","author":"宋白","text":"甘州唱罢晓光新，簇簇才人与美人。\n不分昭阳赵飞燕，汉皇誇是掌中身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46301,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其七十四","author":"宋白","text":"天地储祥集凤麟，凌烟高阁写功臣。\n宫中记得鸦儿句，偏问虞南第几人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46302,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其七十三","author":"宋白","text":"蚕馆春晴阴绿桑，亲蚕天气日初长。\n九嫔参酌前朝礼，须戴金钗十二行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46303,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其二十一","author":"宋白","text":"双双金刹出宫墙，内寺幡花散道场。\n妃子不来春雨细，玉真公主代行香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46304,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其四十五","author":"宋白","text":"御制新成喜雪篇，六宫传写满香笺。\n金銮殿女曾偷和，不敢将呈万乘前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46305,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其五十七","author":"宋白","text":"东宫鸾凤卦中飞，花烛荧煌夜纳妃。\n明日龙楼歌舞罢，门前扫聚碎珠玑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46306,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其二十九","author":"宋白","text":"竹宫春祀望神仙，百和烟高杂绛烟。\n中夜上元来玉座，五云随凤驾珠軿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46307,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其十二","author":"宋白","text":"水殿东西夹翠楼，春乘步辇过瀛洲。\n赭袍如日花如锦，一半宫人尽裹头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46308,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其六十八","author":"宋白","text":"年来春早过新丰，只向官池祭玉龙。\n一片香云千里雨，樊川杜曲绣重重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46309,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其七十二","author":"宋白","text":"外国人来献宝珠，琉璃双眼赤金须。\n奇形不欲宫中见，诏遣滕王进画图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46310,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其七十一","author":"宋白","text":"鱼龙百戏闹嘈嘈，戏罢珠楼日色高。\n移入芳林排小宴，赤瑛盘里进樱桃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46311,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其五十四","author":"宋白","text":"雪梅初谢小桃芳，院院莺啼报海棠。\n昨日司花新奉敕，后园差使结丁香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46312,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其四","author":"宋白","text":"十二楼前御柳垂，九重城里百花时。\n宣州恰进红丝毯，便遣宫娥舞柘枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46313,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其四十八","author":"宋白","text":"丝丝新织御■缰，紫燕春鞍照地光。\n双控坠梢皆侍女，玉鞭柔软拂垂杨。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46314,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其四十三","author":"宋白","text":"南宫春榜奏贤良，万乘临轩试一场。\n赋出御题深称旨，状元先拜秘书郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46315,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dy