[{"title":"鼓山用馀干赵相韵","author":"刘克庄","text":"城郭区区一聚埃，江山如此信佳哉。\n挟龙相国骑箕去，招鹤仙人弭节来。\n试问炊粱成短梦，何如煨芋拨残灰。\n危亭更著文公扁，日落山空未忍回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32655,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"墙西一首","author":"刘克庄","text":"只留一影伴山房，坐待墙西隙月光。\n鹤忽归来寻旧里，燕犹相对语斜阳。\n虽无传附青云显，赖有书消白日长。\n万一载醪人问字，为言侬仅识偏旁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32656,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"暝色","author":"刘克庄","text":"暝色千村静，遥峰带浅霞。\n荷锄归别墅，乞火到邻家。\n疏鼓闻更远，昏灯见字斜。\n小轩风露冷，自起灌兰花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32657,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"暮春一首","author":"刘克庄","text":"谢馆王亭安在哉，荒村亦自有池台。\n苦嫌野蔓萦纡竹，甚爱残花点缀苔。\n老送病来推不得，欢随春去挽难回。\n未应寂寞无心赏，墙下葵榴次第开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32658,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"漫兴","author":"刘克庄","text":"保社有幽子，户庭无杂宾。\n若非负苓者，即是耦耕人。\n筇稳慵呼马，蔬甘胜擘麟。\n箧中诗又满，谁谓此翁贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32659,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"漫兴一首","author":"刘克庄","text":"经行中野多新冢，检点高阳少酒徒。\n纵不能陪雍畤礼，尚堪添入洛英图。\n爱东皋子生沉醉，慕北山公死谥愚。\n赖有小诗自陶写，何须著论学王符。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32660,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"漫兴一首","author":"刘克庄","text":"生在重华内禅前，红颜倏忽变霜颠。\n吾虽后辈识前辈，彼以小年疑大年。\n殇子几曾知寿夭，死人安可语神仙。\n何须求入耆英社，作老农夫也自贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32661,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"漫兴二首 其二","author":"刘克庄","text":"送老虚无寂寞滨，圣朝乃复记遗民。\n□摛温洛荥河笔，藻饰寒灰槁木身。\n虽拜老龙呼学士，肯教夜鹤怨山人。\n它时题向征西墓，道是先皇献纳臣。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32662,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"漫兴二首 其一","author":"刘克庄","text":"身似著冠狂贺监，面如留发老卢能。\n无丹灶地烧铅汞，有海潮音话葛藤。\n龙象聋观俱赞叹，犬鸡痴望共飞升。\n门前蓦有侵晨客，向道先生寝未兴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32663,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"漳兰为丁窃货其半纪实四首 其四","author":"刘克庄","text":"离骚赏风韵，百卉莫之先。\n菊止香九日，莸曾臭十年。\n麝房吾割爱，鲍肆尔垂涎。\n晏相惜花者，红梅被窃然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32664,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"漳兰为丁窃货其半纪实四首 其三","author":"刘克庄","text":"池远疏浇溉，墙低劣蔽遮。\n初无虎守杏，况有蝶穿花。\n薄采难纫佩，深培待茁芽。\n嗟余愧迂叟，招汝兴仍赊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32665,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"漳兰为丁窃货其半纪实四首 其二","author":"刘克庄","text":"主人拙樊圃，家贼巧穿窬。\n鼠子敢予侮，麟翁以盗书。\n空搔双白鬓，不奈一长须。\n自笑关防晚，花傍且燕居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32666,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"漳兰为丁窃货其半纪实四首 其一","author":"刘克庄","text":"五十盆苍翠，皆从异县求。\n不能防狡窟，未免破鸿沟。\n惨甚兵初过，苛于吏倍抽。\n渠侬慕铜臭，肯为国香谋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32667,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"端明无惰赵公哀诗二首 其二","author":"刘克庄","text":"惜身顾影世滔滔，叹息斯人振古豪。\n中垒老犹献封事，三闾去尚作离骚。\n无金可遗贫如故，加璧难招节更高。\n有泪数行刍一束，若为飞渡浙江涛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32668,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"端明无惰赵公哀诗二首 其一","author":"刘克庄","text":"忆昔并居封驳地，相期叶力共推车。\n惯看东阁批黄敕，同向南衙沮白麻。\n高兴竟归安石墅，大疑犹访魏舒家。\n仅存一鉴今亡矣，想见昕朝亦叹嗟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32669,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蔡溪岩","author":"刘克庄","text":"爱瀑恋苔矶，难招出翠微。\n死因岩作墓，生以石为扉。\n已叹逃名是，犹嫌学佛非。\n后来无此士，不但鹤书稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32670,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"撷阳阡二首 其二","author":"刘克庄","text":"特起虽名世，相承必象贤。\n亦尝紬石室，终莫续铜川。\n颇觉卿惭长，徒知物本元。\n此生甘寂寂，白首抱遗编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32671,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"撷阳阡二首 其一","author":"刘克庄","text":"无论晴及雨，岁岁到寒原。\n下马陵如故，书麟笔不存。\n心灯长在世，谏笏尚传孙。\n毫发皆翁赐，难忘罔极恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32672,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"撷阳塘","author":"刘克庄","text":"塘水年时似练湖，春来亦已化平芜。\n农官久废存遗址，樵子公行作坦途。\n苇折鹭藏身不得，萍乾鱼以沫相濡。\n桔槔伊轧声如泣，借问龙公睡稳无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32673,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"聪老","author":"刘克庄","text":"聪老才堪将，髡缁意未平。\n僧中能结客，禅外又谈兵。\n喜听诗家话，多知虏地情。\n何当长须发，遣戍国西营。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32674,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蝶庵一首","author":"刘克庄","text":"万里求师脚力顽，可怜无药驻童颜。\n游梁曾在邹枚右，反鲁安能季孟间。\n但见堆金守郿坞，未闻全璧出函关。\n尧如天大逃焉往，莫费巢由自买山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32675,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"醉笔","author":"刘克庄","text":"无复戴花能起舞，有时逢曲尚流涎。\n年龄绛县老人长，交友青州从事贤。\n司业送钱真爱我，侍郎取榼亦欣然。\n吾诗浅易聊陶写，不似渊明述酒篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32676,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题丁给事祠堂","author":"刘克庄","text":"辽鹤何年返故乡，天风剑佩已骞翔。\n郡人议叶来胥宇，兄子才高肯弗堂。\n里选诸儒俱饮惠，谏书百世尚流芳。\n试歌此曲陈蕉荔，万一乘云下帝旁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32677,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题小室二首 其二","author":"刘克庄","text":"阡陌东西山北南，半生常带散人衔。\n何曾云梦芥八九，一任狙公芧四三。\n閤上大夫投欲死，瓮间吏部寝方酣。\n可怜子骏无家法，下见先人面有惭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32678,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题小室二首 其一","author":"刘克庄","text":"已向深林卓小庵，是中仅可著禅龛。\n士师何止三无愠，中散居然七不堪。\n一去重华那复得，方当盛汉勿多谈。\n近来弟子俱行脚，谁伴山僧面壁参。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32679,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题弋阳方友民所藏紫岩西山二帖","author":"刘克庄","text":"摩挲妙墨忆微言，故箧才馀二帖存。\n往昔翁为紫岩客，后来子及浦城门。\n晚生多说参诸老，它日谁堪见九原。\n自叹西河索居者，暮年归梦绕田园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32680,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题六二第诗卷","author":"刘克庄","text":"万卷胸中融化成，却怜郊岛太寒生。\n霜蹄历块骏无匹，赤子探珠龙失惊。\n警句宜为康乐弟，痴年谬作季方兄。\n此诗异日君牢记，后有钟嵘不改评。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32681,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题尤溪赵氏连桂堂","author":"刘克庄","text":"一从五窦联芳后，直至君家四桂堂。\n莫是燕山传下本，又疑蟾窟摘来香。\n即今录续题千佛，伊昔栽培记十郎。\n却笑郤生太矜露，一枝未足诧名场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32682,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题方元吉诗卷","author":"刘克庄","text":"古来名世者，一字费吟哦。\n物贵常因少，诗传不在多。\n词人三影句，处士五噫歌。\n子壮吾衰矣，无因共琢磨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32683,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题方友民诗卷","author":"刘克庄","text":"删定实惟曾大父，文忠况是老先生。\n力行所学斯无愧，偶发于诗亦有声。\n合止笙镛成雅奏，抉挑草木示微情。\n嗟予公事君归兴，不得相从细讲明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32684,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题方寺丞西重山瀑布亭","author":"刘克庄","text":"与客穷源上尽山，林霏初卷岭泥乾。\n似嫌甲第施朱戟，别筑茅亭俯碧湍。\n龙怒岂容缘磴汲，雹寒不敢近崖看。\n平生粗有登临胆，今日凭高立未安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32685,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题方至诗卷","author":"刘克庄","text":"华宗人物甲吾乡，丹穴由来出凤凰。\n万卷楼高谁敢上，五言城小不能当。\n几曾费我挥斤力，尚欲传君齧镞方。\n何日重寻溪上路，共羹苦荬饭黄粱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32686,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题方武成诗草","author":"刘克庄","text":"性僻爱诗如至宝，借君诗卷百回看。\n吟来体犯诸家少，改定人移一字难。\n束瀑为题犹夭矫，吞山入句尚苍寒。\n嗟余老钝资磨琢，安得同衾语夜阑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32687,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题方海丰诗卷","author":"刘克庄","text":"诗境高吟太白伦，梧州下笔李潮亲。\n今观天马非凡种，肯厌家鸡问外人。\n力大鳌来吞钓饵，心专虱看似车轮。\n盛年出手追风雅，莫与香奁作后尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32688,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题方楷一轩","author":"刘克庄","text":"初看华扁知趋向，徐览群言见切磋。\n鹄至安能令弈善，羊亡岂不为歧多。\n爻重翼十几繁矣，贰二参三奈一何。\n老汉暮年无顿处，轩中半榻肯分么。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32689,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题系年录","author":"刘克庄","text":"炎绍诸贤虑未精，今追遗恨尚难平。\n区区王谢营南渡，草草江徐议北征。\n往日中丞甘结好，暮年都督始知兵。\n可怜白发宗留守，力请銮舆幸旧京。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32690,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题永福黄生行卷","author":"刘克庄","text":"废诗二十馀年矣，忽读来诗眼暂明。\n处士梅曾如许瘦，化人酒莫过于清。\n蛩鸣竞起为唐体，牛耳谁堪主夏盟。\n事阔语长殊未竟，跨驴作么问归程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32691,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题永嘉黄仲炎文卷二首 其二","author":"刘克庄","text":"龙泉笔绝文章熄，此作居然可贵珍。\n激处翻嫌董生缓，新来却笑退之陈。\n假令覆瓿无知者，尚可藏山待后人。\n外物区区均粪土，祝君爱取不赀身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32692,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题永嘉黄仲炎文卷二首 其一","author":"刘克庄","text":"书坊黄册诱儿童，朝取封侯夕拜公。\n贾董奇材无地立，欧苏精鉴与人同。\n安知李廌麾门外，不觉刘几入彀中。\n蚤晚君王求极谏，莫教豪杰泣途穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32693,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题白渡方氏听蛙亭","author":"刘克庄","text":"塘水拍堤科斗生，想君亭子俯幽清。\n黄梅雨足野田润，牡曲烟收村墅晴。\n莫信人嫌无理闹，颇疑渠有不平鸣。\n画堂方喜听琴阮，谁爱天然律吕声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32694,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题刘生雪巢","author":"刘克庄","text":"吾宗手葺幽栖处，雪径依稀认虎跑。\n冻折岩前百寻木，压翻屋上几重茅。\n懒吟二首干韩愈，且耸双肩学孟郊。\n只怕景思来认业，别无人与子争巢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32695,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题后林李伯高诗卷","author":"刘克庄","text":"蝉噪螀啼众窍号，岂知今代有诗豪。\n谐如帝所闻天乐，壮似胥江看雪涛。\n险韵森严压皮陆，短章高雅逼韦陶。\n老夫欲反樊川序，长吉安能仆命骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32696,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题吕广文春秋易传大圭","author":"刘克庄","text":"砾裂扫空凡例说，精微勘破后先天。\n遥知长麈升高座，惜未巍冠列细毡。\n秦火安能燔六籍，汉儒浪自费三年。\n自惭不是韩宣子，获见春秋易象全。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32697,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题孙母陈孺人墓志","author":"刘克庄","text":"诲子如陶母，持身比伯姬。\n携扶同出峡，侨寄未还枝。\n阡有时而表，魂无所不之。\n一端差慰意，徐字与杨碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32698,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题安仁陈慧父词卷","author":"刘克庄","text":"已著西山序集端，欲添一字愧才悭。\n平生行脚千诗里，岁晚营巢万竹间。\n后有杨雄宁不好，世无孔子孰能删。\n归舟它日溪边过，珍重先生莫掩关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32699,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题竹溪近藁二首 其二","author":"刘克庄","text":"□□久让□□□，□□墙低怯浅攻。\n白敏居常嘲杜甫，愈谦自说效卢仝。\n三千首探骊颔宝，九万里抟鹏背风。\n欲往从之翅羽短，碧天无际海连空。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32700,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题竹溪近藁二首 其一","author":"刘克庄","text":"□上翁新授□□，□□字字费精研。\n韩婴岂敢为□□，郭象安能□□□。\n曾是呕心多警语，或疑枕膝有奇传。\n溪□□僻□□□，何日真乘入剡船。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32701,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题许介之诗草","author":"刘克庄","text":"我留鸢跕外，君住雁回边。\n走仆行千里，敲门授一编。\n真妍非粉黛，至巧谢雕镌。\n何必周丞相，男儿要自传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32702,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题达卿侄别墅","author":"刘克庄","text":"吾门不幸去华亡，赖有高才出雁行。\n自拟退之称稍黠，孰云白也是阳狂。\n表阡鹤许侬归老，饮砚虹为汝发祥。\n它日雏莺燎黄诰，分墦应许及联墙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32703,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题何秀才诗禅方丈","author":"刘克庄","text":"景建谈之子，诗禅丈室宽。\n能将铅椠事，止作葛藤看。\n坏衲蒙头易，玄机得髓难。\n何因清夜话，分我一蒲团。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32704,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题馀干姚三锡书钞","author":"刘克庄","text":"顷传汤序心倾挹，兹得姚钞手阖开。\n朱子所疑非孔传，汉儒之罪甚秦灰。\n时清纵未经筵召，岁晚宁无掌故来。\n揽辔远臣惭力薄，不能为国论遗材。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32705,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题听蛙方君诗卷二首 其二","author":"刘克庄","text":"前辈凋零雅道衰，陈岩一叟尚庞眉。\n昂藏且伴戴花老，么么安知撼树儿。\n警句可编半山集，高风宜配客星祠。\n有诗一卷留天地，绝胜征南立二碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32706,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题听蛙方君诗卷二首 其一","author":"刘克庄","text":"湘弦泗磬有遗声，肯作秋蛩唧唧鸣。\n同社共推一日长，古人尤重十年兄。\n放开只眼饶初祖，蟠屈长身接后生。\n不是学人无赞叹，学人见得未分明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32707,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题宋谦父四时佳致楼","author":"刘克庄","text":"四序推移景迭新，二诗体认理尤亲。\n爱莲亦既见君子，看竹不须通主人。\n领略春风来广坐，分张月色过比邻。\n端能著我西家否，客户何妨赘一民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32708,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题庐陵罗生诗卷","author":"刘克庄","text":"门巷萧然人迹少，华裾客子袖文过。\n织千机锦非常巧，熏一铢香已觉多。\n持赠白云情厚矣，暗投明月愧如何。\n桃花水煖鲈堪鲙，恨不相携买短蓑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32709,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题张元德著作春秋解二首 其二","author":"刘克庄","text":"白头召寘石渠中，将析微言合异同。\n灵寿不扶汉庭上，儒衣空立鲁门东。\n谁云丞相知殷侑，漫费君王遣所忠。\n犹觉暮年有遗恨，书成未及质文公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32710,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题张元德著作春秋解二首 其一","author":"刘克庄","text":"端平俱辱弓旌召，鹏鴳逍遥各不同。\n笑我赭衣钳楚市，愧君白帽老辽东。\n董迂因被公羊误，杜癖惟于左氏忠。\n晚取诸家高束起，且看渠与意林公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32711,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题张遁夫诗卷","author":"刘克庄","text":"忆昔乘云觐帝傍，一时耸听凤鸣阳。\n久无老子出幽谷，曾有谪仙流夜郎。\n嘿似铜人姑勿论，忧能玉汝义何伤。\n唾壶麈尾俱麾去，只挈随身古锦囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32712,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题近藁二首 其二","author":"刘克庄","text":"世间小家数，不瘦失之寒。\n都未饱鲸脍，徒然烹虮肝。\n于今无对垒，亘古有荒坛。\n改窜无全句，明朝更取看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32713,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题近藁二首 其一","author":"刘克庄","text":"吾年开八秩，形槁更心灰。\n禅缚病居士，诗殃冻秀才。\n无功上麟阁，有案在乌台。\n攻苦三千首，谁曾著价来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32714,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题陈主学达观堂二首 其二","author":"刘克庄","text":"华堂需被记，老笔岂能工。\n尺鴳飞篱下，醯鸡舞瓮中。\n形骸均土木，利欲等苓通。\n独学知闻少，烦君为击蒙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32715,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题陈主学达观堂二首 其一","author":"刘克庄","text":"大观鹏与鴳，小智管并蠡。\n椿菌年脩短，夔蚿足少多。\n交锋蜗左角，森戟蚁南柯。\n惟酒能齐物，醺醺合太和。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32716,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题陈复祖节推留远斋","author":"刘克庄","text":"曾读蔡公诗，夫君志可知。\n试看鸾铩翼，岂若豹留皮。\n寒柏无阳艳，朝花有夕披。\n长公真样子，何必远求师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32717,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题陈遂卿隐居","author":"刘克庄","text":"蚤日称雄翰墨林，暮年里巷且浮沉。\n诸公自负遗贤愧，此士元无谤国心。\n子佩子衿输少俊，某丘某水拣幽深。\n明时莫作逃尧计，忽有弓旌底处寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32718,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题陈霆诗卷","author":"刘克庄","text":"读它人作多遗恨，君似连城璧少瑕。\n楮叶国工如许刻，菖蒲灵物偶然花。\n今无摩诘携同宿，后有荆公选百家。\n不惜矮窗残烛下，与将朱笔撷菁华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32719,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]