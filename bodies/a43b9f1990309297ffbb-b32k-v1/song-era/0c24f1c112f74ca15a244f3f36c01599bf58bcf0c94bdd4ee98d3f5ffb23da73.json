[{"title":"句 其一","author":"谢伯初","text":"多情未老已白发，野思到春如乱云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5510,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"谢伯初","text":"园林换叶梅初熟，池馆无人燕学飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5511,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"忆君王/忆王孙","author":"谢克家","text":"依依宫柳拂宫墙。\n楼殿无人春昼长。\n燕子归来依旧忙。\n忆君王。\n月破黄昏人断肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5512,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"樱桃","author":"谢希孟","text":"谷雨樱桃落，薰风柳带斜。\n舜弦新曲在，休唱后庭花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5513,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏芍药","author":"谢希孟","text":"好是一时艳，本无千岁期。\n所以谑相赠，载之在声诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5514,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"谢希孟","text":"句牵主人衣，一步行不得。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5515,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其七","author":"谢希孟","text":"卞子真赏季，庄生梦还怯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5516,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其四","author":"谢希孟","text":"树既摧为薪，花亦落为尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5517,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"谢希孟","text":"为花虽可期，论德亦终鲜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5518,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其五","author":"谢希孟","text":"艳阳一何好，零落千载冤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5519,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其三","author":"谢希孟","text":"薰薰麝脐烈，灼灼猩血殷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5520,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其六","author":"谢希孟","text":"盗者得其便，掉头笑且歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5521,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"濉江","author":"谢诇","text":"雨过濉江宿霭收，粼粼澄碧净涵秋。\n双桥夹锁虹垂岸，练疋长拖玉作流。\n白鸟孤飞天外没，青螺倒浸镜中浮。\n朝宗东去知何极，愿一乘槎探尽头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5522,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"黄龙洞","author":"谢图南","text":"山水盘桓天地中，几多异事出仙宫。\n玉龙嘶断黄龙现，剑气曾凌上大空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5523,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大涤洞天留题 其一","author":"谢岳甫","text":"朝乘云气上蓬莱，九锁仙峰翠作堆。\n可惜洞天闲日月，人生能得几回来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5524,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大涤洞天留题 其二","author":"谢岳甫","text":"天然奇石耸云端，下浸龙泓一掬寒。\n静听潺湲眠未得，不妨乘月依阑干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5525,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大涤洞天留题 其三","author":"谢岳甫","text":"入山细问山中事，绀宇琼居八百年。\n五洞潜通谁缩地，一峰突起解擎天。\n眼前去马来牛债，梦里骖鸾跨鹄缘。\n却羡黄冠无一事，卧听箫吹落云边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5526,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮","author":"谢明远","text":"春风春雨花经眼。\n石泉槐火春容晚。\n流水自无情。\n回波聚落英。\n问春何处去。\n春向天边住。\n举酒欲销愁。\n酒阑愁更愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5527,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"踏莎行","author":"谢明远","text":"楚树芊绵，江云芜漫。\n晓风吹堕梅千片。\n惊禽飞去响春空，平沙月落光零乱。\n人意伤离，物华惊换。\n武夷此去如天远。\n临分为我少留连，柳条独在江南岸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5528,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九宫山","author":"谢枋得","text":"真人何代结幽栖，累世奎光焕紫泥。\n日月高奔黄道近，衡庐傍出玉绳低。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5529,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与魏梅野","author":"谢枋得","text":"义熙陶令书甲子，春秋仲尼尊天王。\n孔明汉贼不两立，梁公寸念臣而皇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5530,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"五星","author":"谢枋得","text":"五纬煌煌裹在秦，项王称霸沛公臣。\n谁知四百年天下，已属宽仁大度人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5531,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"元旦阻雨二首 其二","author":"谢枋得","text":"莫道新年贺客迟，晴天暖日却相期。\n春风只被多情苦，红嫩青新总要诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5532,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"元旦阻雨二首 其一","author":"谢枋得","text":"洪钧一转岁开端，草木群生亦喜欢。\n安得明年此时节，江南重睹旧衣冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5533,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"代上杜按察 其三","author":"谢枋得","text":"万物宁无吐气时，平生爱诵杜陵诗。\n如今天下知元结，六百年间再见之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5534,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"代上杜按察 其二","author":"谢枋得","text":"庆历诸公开太平，选贤按察救生灵。\n当时只有一杜杞，岂若先生真福星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5535,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"代上杜按察 其一","author":"谢枋得","text":"东南官吏欠清风，五十年来世道穷。\n须信太平在今日，人间又有杜祁公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5536,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"庆全庵桃花","author":"谢枋得","text":"寻得桃源好避秦，桃红又见一年春。\n花飞莫遣随流水，怕有渔郎来问津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5537,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贺道士阮太虚","author":"谢枋得","text":"阮郎正好住天台，玉女多情忽放回。\n雨散云收一天碧，薰风吹梦到瑶台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5538,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自况","author":"谢枋得","text":"手撚琪花吹玉萧，至人长与道逍遥。\n黄云白鹤无拘束，閒看吴儿弄晚潮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5539,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"花影","author":"谢枋得","text":"重重叠叠上瑶台，几度呼童扫不开。\n刚被太阳收拾去，又教明月送将来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5540,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"武夷山中","author":"谢枋得","text":"十年无梦得还家，独立青峰野水涯。\n天地寂寥山雨歇，几生修得到梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5541,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"思亲 其五","author":"谢枋得","text":"九十萱亲天下稀，教儿只诵白华诗。\n溪冰山玉人无愧，百拜慈帏喜可知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5542,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"思亲 其四","author":"谢枋得","text":"九十萱亲天下稀，平生教子欲何为。\n楚王肯立韩公子，良也归韩亦有辞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5543,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"思亲 其三","author":"谢枋得","text":"九十萱亲天下稀，人无容力荷天慈。\n衣冠礼乐江东聚，此是痴儿奉母时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5544,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"思亲 其二","author":"谢枋得","text":"九十萱亲天下稀，吾王何在子何之？\n倚闾日暮无他念，一片好心天得知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5545,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"思亲 其一","author":"谢枋得","text":"九十萱亲天下稀，十年甘旨误庭闱。\n临行有恳慈心喜，再睹衣冠儿便归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5546,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日闻杜鹃","author":"谢枋得","text":"杜鹃日日劝人归，一片归心谁得知。\n望帝有神如可问，谓余何日是归期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5547,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"绝粒偶书二首 其二","author":"谢枋得","text":"龟衔甘露争先到，凤吸醴泉随后来。\n投在太清仙酒瓮，道人日饮两三杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5548,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"绝粒偶书二首 其一","author":"谢枋得","text":"丹府金童善主家，百神听命静无哗。\n从今何必餐松柏，但吸日精吐月华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5549,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送程楚翁远游","author":"谢枋得","text":"近日人传庾岭梅，南枝落尽北枝开。\n长安旧日元无此，尽是江南人送来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5550,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"竹菊松扇四首 其四 扇","author":"谢枋得","text":"蒲葵也解归掌握，纨素未应捐箧中。\n莫把暗尘涴明月，好驱大暑来清风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5551,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秦人洞","author":"谢枋得","text":"来避秦人万事休，鸟啼花落几春秋。\n洞门深锁无人到，山自青青水自流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5552,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蚕妇吟","author":"谢枋得","text":"子规啼彻四更时，起视蚕稠怕叶稀。\n不信楼头杨柳月，玉人歌舞未曾归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5553,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄谢叔鲁 其三","author":"谢枋得","text":"平生结客知心少，乱世逢人笑口难。\n近日老天频送喜，谁来对酒共清欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5554,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄谢叔鲁 其二","author":"谢枋得","text":"一岁思君君不来，君来我去欠徘徊。\n归时只见留诗在，何日相逢畅好怀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5555,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄谢叔鲁 其一","author":"谢枋得","text":"红叶飘摇霜露清，去年今日正同行。\n夜来似与君相见，明月一窗梅影横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5556,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"窗间戏题","author":"谢枋得","text":"云在青山自往还，鹤穿云外上青天。\n云来鹤去不相试，两个无心莫结缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5557,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢送夏衣","author":"谢枋得","text":"南州久客困炎歊，汗浥春衫上白毛。\n细葛含风常著看，此情犹胜旧绨袍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5558,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢惠楮衾","author":"谢枋得","text":"吴宫金蹙凤花绫，春暖熏笼换水沉。\n那似冰桥楮夫子，满床明月解微吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5559,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"竹菊松扇四首 其三 松","author":"谢枋得","text":"乔松磊磊多奇节，冬无霜雪夏无热。\n根头更有千岁苓，知谁可语长生诀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5560,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赏牡丹 其二","author":"谢枋得","text":"洛阳园里草茵寒，梦想尧夫一寸丹。\n安得根头知上品，今人多是就花看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5561,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赏牡丹 其一","author":"谢枋得","text":"兰佩蓉裳骨相寒，山中何日鼎成丹。\n春深富贵花如此，一笑尊前醉眼看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5562,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题庆全庵 其一","author":"谢枋得","text":"莲如君子甘离世，菊似逸民难出山。\n不信众芳□寂寞，天香流出满人间。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5563,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"儒富庄二首 其一","author":"谢枋得","text":"一从孔氏去藏书，直至秦人不喜儒。\n柱下老仙今有后，安知文不在兹乎！","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5564,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"儒富庄二首 其二","author":"谢枋得","text":"东观群儒作好官，束书不许散人看。\n何时遂作西林友，读得韩文熟已难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5565,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠画士刘信可 其二","author":"谢枋得","text":"谱系庭筠出管城，胸中千亩尽秋清。\n儿童不悟挥毫意，閒傍虚檐听雨声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5566,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠画士刘信可 其一","author":"谢枋得","text":"毛颖摧锋入墨池，白云窗下展乌丝。\n乘君袖里孤山月，写尽横斜竹外枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5567,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠秋山道人","author":"谢枋得","text":"晒衣台上草春深，天遣诗人近士林。\n宇宙中间千万变，长歌收拾付閒心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5568,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠儒医陈西岩","author":"谢枋得","text":"株苓桔梗最为奇，药笼书囊用有时。\n莫把眼前穷达论，要知良相即良医。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5569,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"小孤山","author":"谢枋得","text":"人言此是海门关，海眼无涯骇众观。\n天地偶然留砥柱，江山有此障狂澜。\n坚如勇士专场立，危比孤臣末世难。\n明日登峰须造极，渺观宇宙我心宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5570,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"代上张经历","author":"谢枋得","text":"中原自古多豪杰，晋国尤多贤大夫。\n学问断无虚议论，功名须有大规模。\n臂閒弓矢真良将，舌底诗书笑腐儒。\n自恨两贤相识晚，不妨杯酒恣歌呼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5571,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"魏参政执拘投北，行有期，死有日，诗别二子及良友","author":"谢枋得","text":"雪中松柏愈青青，扶植纲常在此行。\n天下久无龚胜洁，人间何独伯夷清。\n义高便觉生堪舍，礼重方知死甚轻。\n南八男儿终不屈，皇天上帝眼分明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5572,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示儿 其二","author":"谢枋得","text":"千古兴亡我自知，一家消息又何疑。\n古来圣哲少才子，世乱英雄多义儿。\n靖节少陵能自解，孔明王猛使人悲。\n只虞错改金根字，焉用城南劝学诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5573,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示儿 其一","author":"谢枋得","text":"门户兴衰不自由，乐天知命我无忧。\n大儿安得孔文举，生子何如孙仲谋。\n天上麒麟元有数，人閒豚犬不须愁。\n养儿不教父之过，莫视诗书如寇雠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5574,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"求纸衾","author":"谢枋得","text":"避世知无地，危身只信天。\n宁持龚胜扇，不著挺之绵。\n养性真同道，知心有宿缘。\n纸衾加惠絮，晴日卧云边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5575,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和毛靖可韵","author":"谢枋得","text":"孟韩相慕久悬悬，恨不论诗早十年。\n吾道不行知有命，斯文将丧更由天。\n此生何恨为龚胜，来世谁能知少连。\n不信无人扶宇宙，是邦豪杰已潸然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5576,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和叶爱梅韵","author":"谢枋得","text":"道逢患难正当行，礼食从来孰重轻。\n绿鬓行藏堪检点，白头去就要分明。\n了知死别如龚胜，未必生还似子卿。\n纬地经天文不丧，许君独擅大声名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5577,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和曹东谷韵","author":"谢枋得","text":"万古纲常担上肩，脊梁铁硬对皇天。\n人生芳秽有千载，世上荣枯无百年。\n此日识公知有道，何时与我咏游仙。\n不为苏武即龚胜，万一因行拜杜鹃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5578,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和道士陈天隐 其二","author":"谢枋得","text":"岂不逍遥自乐真，世閒何地可容身？\n碧桃秋月原无物，丽日祥风只爱春。\n天上尽多知己友，尘中安得见心人。\n赤虬一跃蓬莱近，又恐丹邱有宿因。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5579,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和道士陈天隐 其三","author":"谢枋得","text":"学道无魔道不成，神人得计是无名。\n光风自觉长潇洒，明月何曾有死生。\n早悟梅花难养性，何如福地别寻盟。\n梅花香里堪联句，莫笑人閒石鼎鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5580,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"忠贤祠","author":"谢枋得","text":"正气冲融自一家，宦情儒墨共根芽。\n身因世故归民社，道为时谋重圣涯。\n千古寒光流夜月，满天馀彩漾晴霞。\n殷勤瞻拜诸公侧，送尽长林几晚鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5581,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挂冠","author":"谢枋得","text":"玉皇殿下卸恩袍，羞见冥鸿惜羽毛。\n天地有心扶社稷，朝廷无意得英豪。\n早知骨鲠撄时忌，何似山林遁迹高。\n次第秋风到兰菊，归家痛饮读离骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5582,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送刘治中之信州","author":"谢枋得","text":"冰玉古溪山，治中今仕元。\n邦人敬文简，道化望曾孙。\n朱子书堂在，东莱讲席存。\n十年儒道晦，此日喜登门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5583,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送张子高归延平","author":"谢枋得","text":"乱世读书少，前人教子难。\n青灯长合席，红日趱归鞍。\n梅自知春近，松应耐岁寒。\n楼高新月好，后夜与谁看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5584,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蚕","author":"谢枋得","text":"养口资身赖以桑，终成王道泽流长。\n吐丝不羡蜘蛛巧，饲叶频催织女忙。\n三起三眠时化运，一生一死命天常。\n待看献茧盆缫后，先与吾皇织衮裳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5585,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]