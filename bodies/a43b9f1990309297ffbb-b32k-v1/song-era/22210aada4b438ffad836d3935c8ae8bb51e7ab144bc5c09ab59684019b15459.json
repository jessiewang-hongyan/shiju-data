[{"title":"螳螂","author":"刘敞","text":"玄蝉无所营，风露正凄清。\n执翳机何密，当车勇自轻。\n将迷黄雀患，已变玉琴声。\n得丧还相召，南华所以惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39457,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨中入省","author":"刘敞","text":"简书无暇日，风雨送残秋。\n车马常侵旦，泥涂空自愁。\n平生本迂拙，岁暮强淹留。\n会将投劾去，偃息谢交游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39458,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"旅居雨中","author":"刘敞","text":"尘垢厌淟涊，风雨为驱除。\n稍稍烦襟尽，萧萧秋气初。\n堪忧忘陋巷，匡坐读群书。\n半夜梁山操，悲歌问起予。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39459,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨中","author":"刘敞","text":"萧萧过轩雨，物色送春归。\n树绿初成盖，垣青半长衣。\n吟怀空扰扰，愁思动依依。\n想似江南景，草长莺乱飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39460,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送因甫宰湘乡","author":"刘敞","text":"相思恨不见，今子去长沙。\n幸有国百里，可怜天一涯。\n春风洞庭水，殊俗楚人家。\n回首伤卑湿，知君发易华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39461,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽仁宗皇帝歌四首 其一","author":"刘敞","text":"汉恩隆四世，商历盛三宗。\n与子孙能继，宁民户可封。\n云归疑厌代，鼎就莫攀龙。\n庙乐兼韶武，应传盛德容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39462,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽仁宗皇帝歌四首 其二","author":"刘敞","text":"措刑文武后，四十有馀年。\n几与华胥比，宁知帝力然。\n占龄无协梦，弃躧趣登山。\n后世称稽古，应参尧舜篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39463,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽仁宗皇帝歌四首 其三","author":"刘敞","text":"不阵威逾远，无为俗自柔。\n诗书通月窟，箫勺靖炎陬。\n毕陌宫车晚，苍梧草露秋。\n定知千岁后，民尚是轩丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39464,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽仁宗皇帝歌四首 其四","author":"刘敞","text":"讴歌归命启，遏密罄宗尧。\n陵寝略依汉，衣冠深葬桥。\n空看同轨至，非复总章朝。\n西望新宫柏，悲风亦后凋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39465,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"太一斋居","author":"刘敞","text":"适野性所喜，采真今更谙。\n地偏尘土少，人远井泉甘。\n长日眠高枕，微风酒半酣。\n从来天尺五，信有此城南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39466,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"城南晚归","author":"刘敞","text":"高秋变摇落，远水露澄明。\n飞鸟江中堕，孤帆木末征。\n逆风吹帽侧，疏雨逐云行。\n兴尽聊当反，涂穷眼自惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39467,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"独酌忆和甫","author":"刘敞","text":"开窗一杯酒，独酌静无言。\n明蟾不可驻，流水自东奔。\n野犬迎虚吠，舟人争渡喧。\n怅然此时意，不醉已消魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39468,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"履冰","author":"刘敞","text":"昔闻小旻戒，今践薄冰行。\n涌水怒愁裂，寒蛟蟠畏惊。\n迟迟但觉远，战战尚思轻。\n谁断孤疑志，穷源更北征。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39469,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"烧残树","author":"刘敞","text":"古树荒祠侧，他年雷震馀。\n蛟龙从此逝，蝼蚁至今居。\n错节摧犀甲，烧痕蠹漆书。\n会看妨要路，终胜断沟渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39470,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"双树","author":"刘敞","text":"吾庐双好树，簇簇近浮烟。\n急雨仍堪倚，斜阳不废眠。\n山童勤扫叶，稚子莫惊蝉。\n俗态轻幽寂，柴门赖素偏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39471,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题巷北桃花","author":"刘敞","text":"深巷山桃树，无人亦自芳。\n青苔何限地，红萼可怜香。\n俗眼轻幽僻，阴天逼艳阳。\n殷勤谋一醉，容易送春光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39472,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杜祁公挽词二首 其一","author":"刘敞","text":"天下苍生望，朝端百辟师。\n辞荣如弃躧，得道去乘箕。\n无复临雍问，空馀罢市悲。\n会书廊庙语，世世奉萧规。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39473,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杜祁公挽词二首 其二","author":"刘敞","text":"第五廉莫比，留侯功不居。\n遗风何峻极，雅尚得冲虚。\n平昔常开阁，深惭晚曳裾。\n千金论一字，永慨袖中书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39474,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送人之洛","author":"刘敞","text":"逢人问嵩少，千里驾征轩。\n倦马夜未寝，鸣蝉秋尚烦。\n风烟新洛邑，冠盖上东门。\n合有西宾问，归时许共论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39475,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"圣俞坠马伤臂以其好言兵调之","author":"刘敞","text":"知兵心自许，见谓百夫雄。\n上马常慷慨，堕车宁困穷。\n诚非代大匠，疑欲作三公。\n匹似陈汤病，犹成绝域功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39476,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"烽火","author":"刘敞","text":"齐秦谁谓远，烽火自相通。\n消息雌雄国，关防百二同。\n流光下沧海，飞焰避惊鸿。\n不及承平日，空悲垂白翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39477,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"得贡甫巢县书云阻风","author":"刘敞","text":"别离常作恶，衰老异他时。\n望望风波苦，悠悠见女悲。\n江空人迹绝，天迥鸟飞迟。\n若复无双鲤，何由慰我思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39478,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晒书","author":"刘敞","text":"藏书不满万，幽蠹亦时除。\n上有朝廷副，多从秦汉馀。\n山川迷禹穴，云海隔昆墟。\n持此遗清白，归为林下居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39479,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"卲少卿挽词二首 其一","author":"刘敞","text":"湖海青云器，朝廷白首郎。\n蹉跎遇已晚，零落意仍伤。\n屡拥行台节，频腰太守章。\n东南满遗爱，不独一桐乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39480,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"卲少卿挽词二首 其二","author":"刘敞","text":"广柳非高盖，空山异昔归。\n善人天不与，行道涕交挥。\n髣髴音容在，留连义故违。\n安居自传世，闾里尚光辉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39481,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"镇潼观察留后赠侍中李君挽词","author":"刘敞","text":"筑坛辞将钺，分土继缁衣。\n忌满名犹误，宜年报尚非。\n离鸿哀断续，埋玉想光辉。\n冥漠金貂赠，空看卤簿归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39482,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"侍读右丞赠尚书李公挽词","author":"刘敞","text":"扶阳诗礼学，世世有知名。\n玉树芳荣早，金华地望清。\n川沈终合剑，风折欲分荆。\n萧瑟乌衣巷，偏伤道路情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39483,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再见禁卒住桂阳二首 其一","author":"刘敞","text":"古亦苗民患，今仍禁旅过。\n祅氛半翼轸，杀气覆山河。\n御史暴公子，将军马伏波。\n不应淹日月，频献凯旋歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39484,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再见禁卒住桂阳二首 其二","author":"刘敞","text":"肃肃卷征甲，萧萧出郢门。\n蛟螭雄步骤，鹰隼急飞翻。\n数有蛮夷警，遥怜赋税烦。\n唐虞两阶舞，帝肯用昌言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39485,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"丁右丞挽词二首 其一","author":"刘敞","text":"再历三公府，终崇万乘师。\n优游迩臣表，简淡古人为。\n爱士常推毂，传家不遗危。\n平生赤松愿，犹复白驹悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39486,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"丁右丞挽词二首 其二","author":"刘敞","text":"司籍归良史，调钟待一夔。\n遽闻麟掩袂，犹觖凤来仪。\n绝笔流风在，遗音后世知。\n春原国人送，黄鸟寄哀诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39487,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"国殇","author":"刘敞","text":"屡闻戎马入，辄有国殇诗。\n多垒非吾责，亡民痛尔为。\n请缨惭肉食，无敌怪王师。\n闻道临洮野，天阴战骨悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39488,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"暮角","author":"刘敞","text":"落日孤城闭，高风暮角愁。\n边声乱归马，物色向新秋。\n尚有单于怨，仍传出塞忧。\n时平翻感激，不语看层楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39489,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题天池馆二首 其一","author":"刘敞","text":"谁人画素屏，中座对沧溟。\n云气随蛟蜃，波涛涌户庭。\n风高鹏解羽，天近客浮星。\n会有汤汤意，无琴亦自听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39490,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题天池馆二首 其二","author":"刘敞","text":"粉墨势回环，沧波入座间。\n溟茫朝百谷，迢递隔三山。\n怪兽有时化，孤槎何日还。\n乘桴古人勇，向壁每惭颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39491,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自长平至陈州河水绝清","author":"刘敞","text":"清川百里馀，净渌照空虚。\n落日金波荡，微风雾縠舒。\n茔心看白石，明目数游鱼。\n洗耳非吾事，兹身与世疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39492,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"金山馆","author":"刘敞","text":"出塞二千里，荒亭无四邻。\n贪乌饥攫肉，狡兔急投人。\n短短西隅日，冥冥北路尘。\n腰间丈二组，空愧汉廷臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39493,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"庶几堂雨夜偃几作","author":"刘敞","text":"短夜催微月，流云湿太空。\n潇潇鸣竹雨，飒飒舞松风。\n形影明灯里，欢娱隐几中。\n吾衰傥未甚，正复梦周公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39494,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春晚","author":"刘敞","text":"芳菲不少住，白日定空长。\n庭树暗新绿，春衣生晚凉。\n悠悠向时节，细细到壶觞。\n谁使风前絮，来参醉后狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39495,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"铁浆馆","author":"刘敞","text":"稍出卢龙塞，回看万壑青。\n旷原开碛口，别道入松亭。\n虏马寒随草，奚车夕戴星。\n忽悲田子泰，寂寞向千龄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39496,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"凉雨","author":"刘敞","text":"晚雨萧萧急，秋阴处处高。\n风云愁宇宙，淮海怒波涛。\n贫有匣中剑，饥馀井上桃。\n谁能散积霭，万里度鸿毛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39497,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"风雨寄张野人","author":"刘敞","text":"天地初开泰，云雷未厌屯。\n泥深长闭户，谋拙苦忧贫。\n狼籍千株雪，空亡一半春。\n仍愁三径里，草色断幽人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39498,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"孤垒二首 其一","author":"刘敞","text":"孤垒敞新观，层轩临暮霞。\n分明鱼意乐，徙倚客愁赊。\n远近见百里，高低有万家。\n春风甚不远，更种满城花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39499,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"孤垒二首 其二","author":"刘敞","text":"落日含古意，高台多远心。\n鱼龙潜冻水，蟋蟀有哀音。\n江汉南浮远，关山北望深。\n张衡四愁意，历历起登临。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39500,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"连日西南风戏作","author":"刘敞","text":"连日风且曀，端居突不黔。\n西南人殆绝，甲子雨还兼。\n巫峡云屡起，洞庭波正添。\n谁能诛屏翳，试使后飞廉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39501,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨中送孜入京兼呈诸亲旧","author":"刘敞","text":"江外五年别，斋中三日留。\n何能慰衰疾，正足乱羁愁。\n泽国瓜时雨，淮山桂树秋。\n思归欲招隐，一一谢交游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39502,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"对雪","author":"刘敞","text":"朔雪似迎春，霏霏散玉尘。\n稍看人迹绝，坐对物华新。\n地暖消还疾，风高舞正频。\n郊扉聊自卧，误怪洛城人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39503,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"对雪忆隐直","author":"刘敞","text":"淅淅度窗竹，纷纷缀馆梅。\n怕消愁寂寞，看舞爱徘徊。\n寡和思吾友，相望共酒杯。\n时披白鹤氅，西北上高台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39504,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋霁望月","author":"刘敞","text":"明蟾此夜新，伫立爽精神。\n几夕隔霖雨，相看如故人。\n风生疑折桂，云过欲埋轮。\n应有关山客，长歌泪满巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39505,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送张器著作","author":"刘敞","text":"昔年闻子虚，上国重相如。\n老厌诸侯客，晚陪东观书。\n弦歌鲁儒习，风俗楚人馀。\n感激青云气，功名亦未疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39506,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江行寄隐直","author":"刘敞","text":"自念复远适，与君仍解携。\n天文鹑首尾，地势陜东西。\n江汉饶风雨，关山盛鼓鼙。\n离忧各易老，秋意欲悽悽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39507,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新梅寄春卿给事","author":"刘敞","text":"徂岁嗟无奈，新花笑自如。\n雪魂消去未，春色复归初。\n欲折意空远，少留香有馀。\n一枝寄驿使，浪语故愁予。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39508,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禦冬","author":"刘敞","text":"漂泊愁多病，差池岁复阑。\n老惊时月疾，贫畏雪霜寒。\n外物关身足，空堂寓膝宽。\n敢希王佐略，聊取一枝安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39509,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日小园忆张六","author":"刘敞","text":"不见张公子，春游分寂寥。\n独行愁楚泽，何处榜吴桡。\n芳树皆宜笑，垂杨总细腰。\n一樽成强醉，四望欲魂销。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39510,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪后游小园","author":"刘敞","text":"园林过新雪，草木散芳华。\n物色皆疑似，春归亦有涯。\n径泥生沮洳，冻乳滴楂枒。\n所适从吾乐，淹留见暮霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39511,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"纳凉明教台呈太守","author":"刘敞","text":"榻移随树影，杯侧见山岑。\n白鸟渴求水，玄蝉清噪林。\n道书无近语，天籁有遗音。\n向北新开径，行苔过竹阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39512,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"临渊亭寄辇下亲旧","author":"刘敞","text":"蚕鱼山迤逦，济汶水交流。\n信美终非土，思乡更倚楼。\n露滋黄菊晚，风起白云秋。\n长啸澄潭上，谁怜公子牟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39513,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"丁酉五月郭守恩战殁武戡走入壁守恩勇将有智略","author":"刘敞","text":"敌兵得汉巧，五月战西河。\n壮士平原死，孤城杀气多。\n犹闻疏勒守，无复鲁阳戈。\n不反东流水，滔滔奈尔何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39514,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻舅氏以秘书监致政谨献拙诗为贺","author":"刘敞","text":"今日王朝士，多称贤大夫。\n恩荣随几杖，官职上蓬壶。\n行路叹或泣，都城画有图。\n他时辟雍问，惇史记吁谟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39515,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"得和书自越入京时寓商丘","author":"刘敞","text":"遥想行舟处，春江花正繁。\n殊方更回首，不语独销魂。\n寡和愁郢客，雅游思兔园。\n吾能事应聘，见尔大梁门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39516,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送杜横州","author":"刘敞","text":"小郡横山外，居民半岛夷。\n路偏逢客少，地湿见秋迟。\n铜鼓侵城角，蛮旌接使麾。\n平生闻义勇，好祭伏波祠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39517,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送余江州","author":"刘敞","text":"潮汐通城下，东南仍上游。\n怀章趋便道，叠鼓送华舟。\n卷旆鹰隼急，落帆江汉秋。\n心知恋魏阙，频上庾家楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39518,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"冬至即事","author":"刘敞","text":"南极日差永，幽人喜不胜。\n阳生渐堙郁，阴老尚凭陵。\n风解吴山雪，江流蜀地冰。\n冲寒彊乘兴，屣履过邻僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39519,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晏公挽词三首 其一","author":"刘敞","text":"望苑牧英隽，岩廊奉德音。\n功如四支重，化以二南深。\n安仰嗟维石，能传赖碎金。\n浮云送哀挽，惨澹更为霖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39520,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晏公挽词三首 其二","author":"刘敞","text":"简易能容士，精诚乐与贤。\n如何五湖上，非复赤松年。\n几几空遗舄，悠悠不问天。\n独应春辍相，令望故依然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39521,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晏公挽词三首 其三","author":"刘敞","text":"衮韨三司旧，笳箫一品荣。\n独伤去国意，仍以抚封行。\n落日白驹影，空林黄鸟声。\n公归那不复，悽怆国人情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39522,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"邻几挽词二首 其一","author":"刘敞","text":"那知一樽酒，流涕寝门前。\n非复平生日，空看东逝川。\n诗书遗素业，山水閟空弦。\n人物陈留古，当凭耆旧传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39523,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"邻几挽词二首 其二","author":"刘敞","text":"忘年一倾盖，适意两虚舟。\n老去翻相失，人生固若浮。\n萧条蒿里饯，零落竹林游。\n知与不知者，同时俱涕流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39524,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"圣俞挽词","author":"刘敞","text":"孤宦众人后，空名三十年。\n交游一时绝，诗笔四方传。\n归旐江湖永，藏书日月边。\n应封史通子，他日慰穷泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39525,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"洗竹","author":"刘敞","text":"舍侧万竿绿，萧萧终岁佳。\n翠深疑魍魉，根老畏龙蛇。\n剪剔扶霜节，分张及马挝。\n世无嵇阮辈，竟负野人家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39526,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"岁暮忆隐直","author":"刘敞","text":"岁穷浩长叹，心事如波澜。\n高卧老将至，相思天正寒。\n浮云纷霰雪，陋巷独瓢箪。\n里饭非无意，悠悠行路难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39527,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]