[{"title":"洗竹","author":"苏辙","text":"寒甚南轩竹半黄，晚抽旱笋杂榛荒。\n不嫌毒手千竿尽，稍放清风八月凉。\n短彗只堪除粪壤，新萌会看伏牛羊。\n扶持造化须人力，早听人言布麦糠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":244,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"省事","author":"苏辙","text":"早岁读书无甚解，晚年省事有奇功。\n自许平生初不错，人言毕竟两皆空。\n空中有实何人见，实际心知与佛同。\n烦恼消除病亦去，闭门便了此生中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":245,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋后即事","author":"苏辙","text":"苦热真疑不复凉，火流渐见迫西方。\n清风一夜吹茅屋，竹簟今朝避石床。\n露湿中庭菊含蕊，水浮西浦稻生芒。\n秋成得饱家家事，莫笑农夫喜欲狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":246,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋社分题","author":"苏辙","text":"天公闵贫病，雨止得丰穰。\n南亩场功作，东家社酒香。\n分均思孺子，归遗笑东方。\n肯劝拾遗住，休嫌父老狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":247,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋雨","author":"苏辙","text":"禾田已熟畏愁霖，积潦欲乾泥尚深。\n一雨一凉秋向晚，似安似病老相侵。\n人间有尽皆归物，世外无生赖有心。\n要觅尘埃不到处，一灯相照夜愔愔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":248,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"种兰","author":"苏辙","text":"兰生幽谷无人识，客种东轩遗我香。\n知有清芬能解秽，更怜细叶巧凌霜。\n根便密石秋芳早，丛倚修筠午荫凉。\n欲遣蘼芜共堂下，眼前长见楚词章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":249,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"种花二首 其二","author":"苏辙","text":"筑室少闲地，种花能几畦。\n松筠旧满眼，桃李渐成蹊。\n无计通湖水，长思种藕泥。\n幽怀终不惬，拄杖出城西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":250,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"种花二首 其一","author":"苏辙","text":"筑室力已尽，种花功尚疏。\n山丹得春雨，艳色照庭除。\n末品何曾数，群芳自不如。\n今秋接千叶，试取洛人馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":251,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"种菜","author":"苏辙","text":"久种春蔬旱不生，园中汲水乱瓶罂。\n菘葵经火未出土，僮仆何朝饱食羹。\n强有人功趋节令，怅无甘雨困耘耕。\n家居闲暇厌长日，欲看年华上菜茎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":252,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绝胜亭","author":"苏辙","text":"夜郎秋涨水连空，上有虚亭缥缈中。\n山满长天宜落日，江吹旷野作惊风。\n爨烟惨淡浮前浦，渔艇纵横逐钓筒。\n未省岳阳何似此，应须子细问南公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":253,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"胡长史祠堂","author":"苏辙","text":"白首青衫仍隐居，晚抛环堵就安舆。\n生刍忽改烝尝地，函丈空悲讲解馀。\n弟子玙璠相照耀，儿孙松桂共扶疏。\n我来恨不瞻遗老，空怪乡邻尽读书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":254,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"荥阳唐高祖太宗石刻像","author":"苏辙","text":"谁言肤寸像，胜力妙人天。\n欲疗众生病，阴扶济世贤。\n身微须覆护，眼净照几先。\n岂为成功报，犹应历劫缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":255,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"追尊皇太后挽词二首 其二","author":"苏辙","text":"德美钟岐嶷，荣华倍感伤。\n一时朝野恨，百世本支长。\n出祖悲无憾，因山俭有光。\n他年过嵩洛，望拜裕陵旁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":256,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"追尊皇太后挽词二首 其一","author":"苏辙","text":"月缺年何久，龙飞事一新。\n追崇名号正，同袝礼容均。\n凤翣低迎日，龙輴细起尘。\n都人知舜孝，拥绋尽沾巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":257,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送元老西归","author":"苏辙","text":"昼锦西归及早秋，十年太学为亲留。\n读诗俛就当年说，答策甘从下第收。\n莫嫌簿领妨为学，从此文章始自由。\n家有吏师遗躅在，当令耆旧识风流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":258,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送文太师致仕还洛三首 其一","author":"苏辙","text":"国老无心岂为身，五年朝谒慰簪绅。\n元臣事业通三世，旧将威名服四邻。\n遍阅后生真有道，欲谈前事恐无人。\n比公惟有凌云桧，岁岁何妨雨露新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":259,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送文太师致仕还洛三首 其二","author":"苏辙","text":"齐鲁元勋古太师，寂寥千载恐无之。\n昔归暂缩经邦手，复起还当问道时。\n入谒何曾须掖侍，到家依旧拥旌麾。\n孔公灵寿固应在，秋晚香山访佛祠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":260,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送文太师致仕还洛三首 其三","author":"苏辙","text":"西都风物汉唐馀，天作溪山养退居。\n盈尺好花扶几杖，拂天修竹倚庭除。\n白头伴侣谁犹健，率意壶飧久已疏。\n我欲试求三亩宅，从公它日赋归欤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":261,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送毛滂斋郎","author":"苏辙","text":"先志承颜善养亲，束装骑马试为臣。\n酒肠天予浑无敌，诗律家传便出人。\n拥鼻高吟方自得，折腰奔走渐劳神。\n归来一笑须勤取，花发陈吴二月春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":262,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送王宗望郎中赴河东漕","author":"苏辙","text":"春初戎马掠河壖，属国仓皇不解鞍。\n未免驱民馈边食，旋闻奉使辍郎官。\n年高转觉精神胜，虑稳要令事业安。\n持节近看葱岭雪，拥裘应惯雁门寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":263,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送王适徐州赴举","author":"苏辙","text":"送别江南春雨淫，北方谁是子知音。\n性如白玉烧犹冷，文似朱弦叩愈深。\n万里同舟宽老病，一杯分袂发悲吟。\n明年榜上看名姓，杨柳春风正似今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":264,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送任师中通判黄州","author":"苏辙","text":"一别都门今五年，剧谈精壮故依然。\n厌居巴蜀千山底，决住荆河十顷田。\n老去功名无意取，身闲诗笔更能专。\n黄州无事聊须饮，世俗方今自足贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":265,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送吕由庚推官得替还洛中二首 其一","author":"苏辙","text":"君家相国旧元勋，凛凛中丞继后尘。\n谈笑二年同幕府，风流一倍愈它人。\n南都去后少佳客，西洛归来多老臣。\n我亦宦游无久意，它年松竹许相邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":266,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送吕由庚推官得替还洛中二首 其二","author":"苏辙","text":"洛水留人一向乾，雪泥溢路十分寒。\n送行我岂无樽酒，多难君知久鲜欢。\n回首祇应怜老病，凌风争看试轻翰。\n到家定见嵩阳老，问我衰迟未解官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":267,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送吕希道少卿知滁州","author":"苏辙","text":"长怪名卿亦坐曹，忽乘五马列旌旄。\n才多莫厌官无事，郡小不妨名自高。\n庶子定应牵赋咏，醉翁聊复继游遨。\n试寻苦战清流下，要识经纶帝业劳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":268,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送张恕朝奉南京签判二首 其一","author":"苏辙","text":"楚蟹吴柑初著霜，梁园官酒试羔羊。\n老如计相非无齿，清似留侯未却粮。\n杖屦稍通宾客过，殽蔬要遣子孙尝。\n诏书委曲如公意，幕府新除朱绂郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":269,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送张恕朝奉南京签判二首 其二","author":"苏辙","text":"朱绂还家罢倚门，留都无事最宜亲。\n下车趋走惊邻舍，决狱平反慰老人。\n相见只今多邂逅，旧游他日半埃尘。\n何年重起扁舟兴，会作东湖十日宾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":270,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送李宪司理还新喻","author":"苏辙","text":"采芹芹已老，浴沂沂尚寒。\n蒯缑长叹息，苜蓿正阑干。\n黄卷忘忧易，青衫行路难。\n归耕未有计，且复调闲官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":271,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送杜介归扬州","author":"苏辙","text":"扬州繁丽非前世，城郭萧条却古风。\n尚有花畦春雨后，不妨水调月明中。\n东都甲第非嫌汝，北牖羲皇自属翁。\n清洛放船经月事，急先鶗鴂绕芳丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":272,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送陈安期都官出城马上","author":"苏辙","text":"城中二月不知春，唯有东风满面尘。\n归意已随行客去，流年惊见柳条新。\n簿书填委休何日，学问榛芜愧古人。\n一顷稻田三亩竹，故园何负不收身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":273,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送侄迈赴河间令","author":"苏辙","text":"老去那堪用，恩深未敢归。\n谁能告民病，一一指吾非。\n尔赴河间治，无嫌野老讥。\n仍将尺书报，勿复问从违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":274,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送林子中安厚卿二学士奉使高丽二首 其一","author":"苏辙","text":"东夷从古慕中华，万里梯航今一家。\n夜静双星先渡海，风高八月自还槎。\n鱼龙定亦知忠信，象译何劳较齿牙。\n屈指归来应自笑，手持玉帛赐天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":275,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送林子中安厚卿二学士奉使高丽二首 其二","author":"苏辙","text":"官是蓬莱海上仙，此行聊复看桑田。\n鲲移鹏徙秋帆健，潮阔天低晓日鲜。\n平地谁言无崄岨，仁人何处不安全。\n但将美酒盈船去，多作新诗异域传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":276,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送青州签判俞退翁致仕还湖州","author":"苏辙","text":"不作清时言事官，海邦那复久盘桓。\n早依莲社尘缘少，新就草堂归计安。\n富贵暂时朝露过，江山故国水精寒。\n宦游从此知多事，收取《楞伽》静处看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":277,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送姜司马","author":"苏辙","text":"七岁立谈明主前，江湖晚节弄渔船。\n斗鸡谁识城东老，丧马方知塞上贤。\n生计未成归去咏，草书时发醉中颠。\n当年不解看齐物，气踊如山谁见怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":278,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送逊监淮西酒并示诸任二首 其二","author":"苏辙","text":"淮西留滞昔经年，唯有诸任时往还。\n炊黍留宾不嫌陋，借书度日免长闲。\n归来潩水无人问，梦绕伊家古桧间。\n二老旧游唯我在，后生谁复识苍颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":279,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送逊监淮西酒并示诸任二首 其一","author":"苏辙","text":"畴昔南迁海上雷，艰难唯与汝同来。\n再从龙尉茅丛底，旋卜云桥荔子堆。\n相与闭门寻旧学，谁言复出理官醅。\n乘田委吏先师事，莫学陶翁到即回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":280,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送饶州周沃秀才免解","author":"苏辙","text":"少年工作赋，中岁复穷经。\n骥老终知道，剑埋新发硎。\n束装邻里助，答策友朋听。\n还似临淄贡，随风起北溟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":281,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送唐觐","author":"苏辙","text":"溪上幽居少四邻，西家幸有著书人。\n经年食菜谁怜瘦，终日题诗自不贫。\n身在江湖钓竿地，心驰兰会战车尘。\n此行便有飞腾处，笑杀年来老病身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":282,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送贾讷朝奉通判眉州","author":"苏辙","text":"归念长依落日边，壶浆今见逆新官。\n声传已觉讴歌遍，身到前知政令宽。\n民病贤人来已暮，时平蜀道本无难。\n明年我欲修桑梓，为赏庭前荔子丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":283,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送钱承制赴广东都监","author":"苏辙","text":"家声远继河西守，游宦多便岭外官。\n南海无波闲斗舸，北堂多暇得羞兰。\n忽闻常棣歌离索，应寄寒梅报好安。\n它日扁舟定归计，仍将犀玉付江湍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":284,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送钱婺州纯老","author":"苏辙","text":"桃花汴水半河流，已作南行第一舟。\n倦报朝中言啧乱，喜闻淮上橹咿呦。\n平时答策词无枉，此去为邦学更优。\n自古东阳足贤守，请君重赋沈公楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":285,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送顿起及第还蔡州","author":"苏辙","text":"诏书京辅起沉沦，岁贡仍居第一人。\n不愧得官名暂屈，自誇对策语深淳。\n读书饱足终无厌，从宦奔驰自此新。\n我去淮阳今不久，邻邦时得问音尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":286,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送高士敦赴成都兵钤","author":"苏辙","text":"扬雄老病久思归，家在成都更向西。\n邂逅王孙驰驿骑，丁宁父老问耕犁。\n禅房何处不行乐，壁像君家有旧题。\n德厚不妨三世将，时平空见万夫齐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":287,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送高安罗令审礼","author":"苏辙","text":"一邑忧劳水旱中，牛刀闲暇似无功。\n政成仍喜新蚕熟，归去还将旧橐空。\n清白久闻誇父老，沉埋谁为诉诸公。\n谪居长恨交游少，怅望肩舆又欲东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":288,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送梁交供知莫州","author":"苏辙","text":"猛士当令守四方，中原诸将近相望。\n一樽度日空閒暇，千骑临边自激昂。\n谈笑定先降虏使，诗书仍得靖戎行。\n君看宿将何承矩，安用摧锋百战场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":289,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送傅宏著作归觐待观城阙","author":"苏辙","text":"胶西前辈郑康成，千载遗风及后生。\n旧学诗书儒术富，兼通法律吏能精。\n还家綵服频为寿，得邑河壖喜有兵。\n民事近来多迫促，弦歌聊试武城声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":290,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送董扬休比部知真州","author":"苏辙","text":"奏课西南最，分符江海冲。\n往来观惠术，蟠错试馀锋。\n文字从堆案，樽罍强解容。\n金山只隔水，时复听晨钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":291,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送蒋夔赴代州教授","author":"苏辙","text":"忆游太学十年初，犹见胡公岂弟馀。\n遍阅诸生非有道，最怜能赋似相如。\n青衫共笑方持板，白发相看各满梳。\n暂免百忧趋长吏，勉调三寸事新书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":292,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送道士杨见素南游","author":"苏辙","text":"黄河春涨入隋沟，往意随波日夜流。\n万里寻山如野鹤，一身浮水似轻鸥。\n湖风送客那论驿，岳寺留人暗度秋。\n迟子北归来见我，携琴委曲记深幽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":293,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送韩祗严户曹得替省亲成都","author":"苏辙","text":"宦游东土暂相依，政役频烦会合稀。\n每恃详明容老病，不堪羁旅送将归。\n思亲道路宁论远，入蜀山河渐觉非。\n我有旧庐江水上，因君聊复梦魂飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":294,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送颜复赴阙","author":"苏辙","text":"箪瓢未改安贫性，凫绎犹传直道馀。\n不见失官愁戚戚，但闻高卧起徐徐。\n居中旧厌军容讲，补外仍遭城旦书。\n此去将身置何许，秋风未免忆鲈鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":295,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送霸州司理翟曼","author":"苏辙","text":"大梁能赋客，边郡系囚曹。\n官职不相称，声名终自高。\n试观为吏苦，应过读书劳。\n努力事初宦，尺丝无厌缫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":296,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻子瞻习射","author":"苏辙","text":"旧读兵书气已振，近传能射喜征鼖。\n手随乐节宁论中，箭作鸱声不害文。\n力薄仅能胜五斗，才高应自敌三军。\n良家六郡传真法，马上今谁最出群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":297,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻子瞻重游南山","author":"苏辙","text":"终南重到已春回，山木缘崖绿似苔。\n谷鸟鸣呼嘲独往，野人笑语记曾来。\n定邀道士弹鸣鹿，谁与溪堂共酒杯。\n应有新诗还寄我，与君和取当游陪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":298,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻王巩还京会客剧饮戏赠","author":"苏辙","text":"闻君归去便招呼，笑语不知清夜徂。\n结束佳人试银甲，留连狂客恼金吾。\n烛花零落玉山倒，诗笔攲斜翠袖扶。\n暂醉何年依锦瑟，东斋还复卧氍毹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":299,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻京东有道人号贺郎中者唐人也其徒有识之者作诗寄之","author":"苏辙","text":"贺老稽山去不还，镜湖独棹钓鱼船。\n南来太白寻无处，却作郎官又几年。\n岱下迎鸾惊典谒，蒙山施药悯耕田。\n试穷脚力追行迹，亦使今生识地仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":300,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"除夕","author":"苏辙","text":"患难思年改，龙钟惜岁徂。\n关河先垄远，天地小臣孤。\n吾道凭温酒，时情付拥炉。\n南荒足妖怪，此日谩桃符。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":301,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"除日","author":"苏辙","text":"年年最后饮屠酥，不觉年来七十馀。\n十二春秋新罢讲，五千道德适亲书。\n木经霜雪根无蠹，船出风波载本虚。\n自怪多年客箕颍，每因吾党赋归欤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":302,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"除日二首 其二","author":"苏辙","text":"七十四年明日是，三千里外未归人。\n酒篘泉涌如迎节，诗句云生喜见春。\n贺客不来知我病，邻家窃语笑吾真。\n时人莫作乐天看，燕坐端能毕此身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":303,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"除日二首 其一","author":"苏辙","text":"屠苏末后不辞饮，七十四人今自希。\n筋力明年应更减，诚心忧世久知非。\n脾寒服药近方验，风痹经冬势渐微。\n得罪明时归已晚，此生此病任人讥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":304,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"除夜","author":"苏辙","text":"老去不自觉，岁除空一惊。\n深知无得丧，久已罢经营。\n黄卷讥前失，清樽借后生。\n何年遂疏懒，伏腊任躬耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":305,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"除夜二首 其二","author":"苏辙","text":"七十三年客，相从尚几年。\n西方他日事，东鲁一经传。\n渐解平生缚，初安半夜禅。\n纷纷争夺际，何意此心全。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":306,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"除夜二首 其一","author":"苏辙","text":"年年赋除夜，一赋一衰残。\n家有三斗酿，春馀半月寒。\n鸡豚不改旧，邻里自相欢。\n元日应无客，萧然不著冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":307,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"除夜会饮南湖怀王巩","author":"苏辙","text":"岁晚城东故相家，夜听帘外落琼花。\n醉眠东阁银釭暗，起视中庭风竹斜。\n鲁酒近来无奈薄，秦筝别后苦闻誇。\n思君倦对空陂饮，归去纷如日莫鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":308,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]