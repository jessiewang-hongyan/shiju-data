[{"title":"偶成 其二","author":"夏竦","text":"保庇孤根逢圣主，矜修晚节顺天机。\n空门自有清凉地，不向红尘议是非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52541,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"厩马","author":"夏竦","text":"万里无尘塞草秋，玉轮金轭未巡游。\n上林苜蓿天池水，饱食长鸣可自羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52542,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄传法二大卿并简译席诸大士 其一","author":"夏竦","text":"译案多年润法音，性根虽钝信根深。\n无明不起冤亲等，应有龙天證此心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52543,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"淑妃阁端午帖子 其一","author":"夏竦","text":"蕤宾布序逢良月，条达延祥记令辰。\n仰奉椒涂宣内治，永昭芳誉冠虞嫔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52544,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"淑妃阁端午帖子 其二","author":"夏竦","text":"芳园踏草迎嘉节，紫掖鸣环奉鞠衣。\n渥惠日新鸿庆远，永隆徽序耀层闱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52545,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"淑妃阁端午帖子 其四","author":"夏竦","text":"宴寝奉朝鸣采玉，良辰袭庆表长丝。\n仰承中壸垂芳裕，永播周南逮下诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52546,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"淑妃阁端午帖子 其三","author":"夏竦","text":"万宇清和当圣日，千门采拾遘良辰。\n上真鸿绪宜蕃衍，从此高禖美应新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52547,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔者","author":"夏竦","text":"读遍龙韬事可知，一竿闲把直钩垂。\n秋来江上西风急，且系扁舟卷钓丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52548,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪后赠雪苑师 其三","author":"夏竦","text":"千嶂崔嵬雪里看，东风一夜捲馀寒。\n岩前溜玉知多少，涨起西江十八滩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52549,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪后赠雪苑师 其二","author":"夏竦","text":"玉界琼田万顷平，一年光景一番新。\n苑中又见梅花发，信手拈来总是春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52550,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪后赠雪苑师 其四","author":"夏竦","text":"老去方知行路难，此心正要觅人安。\n室中半偈如闻得，便作当年立雪看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52551,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪后赠雪苑师 其一","author":"夏竦","text":"雪山修道六年成，云满长空雪满庭。\n便向个中登觉地，何须腊月待明星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52552,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"御阁春帖子 其二","author":"夏竦","text":"冰消太液生春水，日上披香积瑞烟。\n乔岳告成鸿庆远，垂衣无事永千年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52553,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"御阁春帖子 其五","author":"夏竦","text":"青逵布序韶晖盛，紫禁乘春乐事多。\n海域晏清无夕虑，斋居宣室顺天和。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52554,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"御阁春帖子 其三","author":"夏竦","text":"天人道洽真游降，禅祀功高帝业昌。\n迎气东郊风乍暖，受釐中禁日初长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52555,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"御阁春帖子 其六","author":"夏竦","text":"寒梅吐艳风初应，步辇宣游日渐迟。\n道荫无涯真绪远，永康寰海茂春祺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52556,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"御阁春帖子 其一","author":"夏竦","text":"金盘晓日融春露，黼帐鲜云荫瑞香。\n圣寿永同天地久，南山何足比延长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52557,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"御阁春帖子 其四","author":"夏竦","text":"九门和气冲鱼钥，层宙祥飙起鹤云。\n王泽下流慈煦远，万方歌舞戴明君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52558,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"御阁端午帖子 其二","author":"夏竦","text":"金缕开辰分五色，长丝献寿祝千年。\n垂衣日月承嘉庆，真祖飙游正在天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52559,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"御阁端午帖子 其三","author":"夏竦","text":"仙园采药回彫辇，禁殿迎祥启凤闱。\n四海乐康民富寿，穆清无事永垂衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52560,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"御阁端午帖子 其十二","author":"夏竦","text":"八龙焜耀长生箓，五采葳蕤续命丝。\n亿载延长资睿算，万区康乐遇昌期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52561,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"御阁端午帖子 其十","author":"夏竦","text":"五色綵丝初献寿，九重嘉气颂长生。\n庇民精意方虔巩，垂拱仁风更穆清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52562,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"御阁端午帖子 其六","author":"夏竦","text":"太官角黍迎嘉节，上圣斋居袭美祥。\n金阙鉴观真绪远，永延鸿庆庇多方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52563,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"御阁端午帖子 其九","author":"夏竦","text":"赐羹佳事传青简，续寿长丝献紫宸。\n帝祉荐彰符盛德，圣心勤恤为生民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52564,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"御阁端午帖子 其四","author":"夏竦","text":"彩丝祝寿芳辰启，紫禁凝旒瑞日长。\n亿兆归仁天祐德，绵绵真荫永无疆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52565,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"御阁端午帖子 其五","author":"夏竦","text":"绛台丹笔书金箓，紫殿瑶箱献巧衣。\n亿载延鸿资睿算，百祥重沓拥宸闱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52566,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"御阁端午帖子 其七","author":"夏竦","text":"尚方绶带迎嘉节，中禁彤闱纳美祥。\n畴德珍符方瑞圣，后天宸寿永无疆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52567,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"御阁端午帖子 其一","author":"夏竦","text":"续命彩丝登茧馆，长生金箓献琳宫。\n百灵拱卫天居峻，万国欢康帝业隆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52568,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"御阁端午帖子 其十一","author":"夏竦","text":"浴兰袭祉良辰启，握纪无为圣道尊。\n舄奕嘉祥充九禁，冲融和气遍干门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52569,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"御阁端午帖子 其八","author":"夏竦","text":"太官角黍初晨启，法坐垂衣介福隆。\n亿载昌期方赫奕，九天真荫永延鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52570,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"槛竹","author":"夏竦","text":"广厦长廊四面围，小栏霜雪两三枝。\n帘帷壅蔽无人见，赖有中天日照知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52571,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蔷薇","author":"夏竦","text":"红房深浅翠条低，满架清香敌麝脐。\n攀折若无花底刺，岂教桃李独成蹊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52572,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题华严经诗","author":"夏竦","text":"黼幄思贤已再三，诏书将拆紫泥缄。\n嘉言一句利天下，何必金文更彻函。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52573,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"二月昭州奏正月一日设醮上玉皇表烧钱次有鹤一只翱翔久之西北去","author":"夏竦","text":"平乐初正月，虚晨荐号时。\n瑞场燔碧币，仙骥驻霜仪。\n烟顶方遥辨，星精想下窥。\n天门俄翼去，杳霭瑞烟披。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52574,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"八月梓州奏广化寺池莲五茎各开二花","author":"夏竦","text":"梓潼名郡蜀川东，忽秀佳莲绀宇中。\n袅袅修茎孤引绿，盈盈双蕊对分红。\n绛跗相倚凝新露，紫菂交垂向晚风。\n爰考瑞图观美应，柳州嘉产实难同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52575,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"八年正月天庆节上清宫行香锡庆院御筵日扬辉有非烟非雾之云","author":"夏竦","text":"宝箓标嘉节，需云锡惠筵。\n烈晖腾爱景，瑞彩拟非烟。\n焜耀璿霄外，轮囷绛阙前。\n居歆方屡告，伟兆溢祥编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52576,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三月施州进金色小龟","author":"夏竦","text":"清江涵德泽，嘉瑞效灵龟。\n巢叶形偏小，如金色最奇。\n玉灵惭异质，绎属近幽姿。\n骑置遥承献，观图仰帝祺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52577,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"大中祥符七年七月锦州奏天庆观修圣祖殿毕五色云三朵各方丈馀见于殿上","author":"夏竦","text":"仙祠成秘殿，远郡在卢阳。\n旭日初流景，卿云忽降祥。\n三枝分玉叶，五色照琳房。\n元后成真荫，钦柴报上苍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52578,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"马跑泉","author":"夏竦","text":"天骥何年往，龙泓此地存。\n空馀曳练色，莫辨袅蹄痕。\n赴海妨苔甃，涵虚碍竹轩。\n会当逢禹凿，始可见鸿源。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52579,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"五月同州奏牡丹一枝开三花","author":"夏竦","text":"上圣德风驰率土，左冯嘉气袭鸿英。\n疏丛一干迎春茂，繁艳三房表瑞呈。\n承献珍图昭美应，考祥花品见维祯。\n帝宸钦翼崇昭报，荐玉燔柴极至诚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52580,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"天台道中","author":"夏竦","text":"驱马天台路，悠悠渐向晨。\n云开忽见寺，山尽偶逢人。\n细雨疏篁长，微烟古木春。\n行行遥驿道，落吹起轻尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52581,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"仙姬怨","author":"夏竦","text":"洞口垂杨拂地垂，年来期约又依违。\n红桃不解留人住，白鹤何曾觅信归。\n雉扇对开春寂寂，绣衣双卷雨霏霏。\n无言尽日云边立，不许霓裳按羽衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52582,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代村叟","author":"夏竦","text":"安居近幽谷，井赋籍良田。\n圣代无深隐，家山不直钱。\n候耕看土脉，祈谷赛豚肩。\n城市知何处，疏钟隔暮烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52583,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"四月昌州奏圣祖殿下生芝草一本四茎及面有红光如悦怿之状","author":"夏竦","text":"昌元远地凝和气，真祖仙宫发帝祺。\n穆穆睟容分喜色，煌煌宝座秀灵芝。\n已彰日监灵心显，更表晨敷协气滋。\n元后钦崇膺瑞命，殊庭荐号答繁禧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52584,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"本宫投龙简中使","author":"夏竦","text":"醮罢层霄鹤吹分，夜坛香火镂真文。\n羽人月笔封瑶检，使者星驰下绛云。\n蕊简荐诚川后耸，金龙传信洞天闻。\n再三鹊尾添檀炷，为祝虚心佑圣君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52585,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"石梁","author":"夏竦","text":"断涧横幽石，苍苔古木阴。\n攲危接山腹，迢递过云心。\n峭壁峙千仞，飞流下万寻。\n秦人若驱策，蓬岛路非深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52586,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"华山","author":"夏竦","text":"三峰森翠倚云棱，凝睇烟萝最上层。\n八水乱分秦帝国，四关空锁汉皇陵。\n仙羊未起眠春草，塞马初归放紫藤。\n堪惜圣朝无傲吏，夜来风月属闲僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52587,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江南怀古","author":"夏竦","text":"六朝云物更风流，澹澹烟藏古寺楼。\n敌国漫轻江似带，史臣能视橘为侯。\n荒台有鹿姑苏晚，坏阁无香建业秋。\n到了贤明出中土，莫誇歌舞霸南州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52588,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江南春日","author":"夏竦","text":"江北游人春未回，江南春色傍人来。\n茶经谷雨依稀绿，花接清明次第开。\n场上斗鸡金作距，槛前妆鉴玉为台。\n六朝风物今何在，莫负流年酒百杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52589,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江城秋思","author":"夏竦","text":"泽国迢迢枕海涯，眼前归思乱如麻。\n清秋泉石无多地，残日楼台有几家。\n两岸早霜红橘柚，半汀残雨老蒹葭。\n明时不见投簪客，落尽西风紫菊花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52590,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观夜醮","author":"夏竦","text":"万条银烛间灵旗，一片清香匝玉墀。\n羽帐星辰来不觉，仙坛冠帔立多时。\n红桃裛露风初细，白鹤迎云月渐迟。\n试托东皇问萧史，凤箫应许借人吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52591,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏有作","author":"夏竦","text":"玉琯葭灰昨夜吹，日华光暖向阳枝。\n东君乱点丹青笔，真宰忙挥造化椎。\n红日暗长人不觉，好花偷发蝶先知。\n后园无限桃兼李，留待新恩得意时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52592,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吴中怀古","author":"夏竦","text":"览古长江上，明时起叹嗟。\n水流吴国苑，花入野人家。\n夜气销龙剑，秋星见客槎。\n凄凉馆娃树，西日映平沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52593,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"灵溪","author":"夏竦","text":"剡东溪溜合，一派贯天台。\n白鸟蒙滩下，青山倚岸回。\n波心晴景动，渡口晚烟开。\n咫尺通沧海，千帆自去来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52594,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赤城","author":"夏竦","text":"丹壁排空叠綵虹，上真应此驻灵踪。\n烟沉晓日明孤顶，云破馀霞出半峰。\n岩下法师曾伏虎，洞中仙客屡投龙。\n他年翠盖东巡狩，玉牒终须受大封。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52595,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闰六月眉州奏禾生九穗","author":"夏竦","text":"眉山远地蜀川西，九穗嘉禾忽效祺。\n东极龙枝人莫睹，环丘玉粒世空知。\n中和积粹名方异，繁蔚呈祥事更奇。\n自可增封齐北里，岂将同颖比繁禧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52596,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和御制赏花诗","author":"夏竦","text":"禁园清跸赏春时，水殿晴阳照翠緌。\n步辇乍冲仙杏叶，御衣频拂露桃枝。\n风摇蕊粉星星坠，日引芳阴寸寸移。\n帝所甚欢宫漏永，宴馀仍奉柏梁诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52597,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"国清寺","author":"夏竦","text":"穿松渡双涧，宫殿五峰围。\n小院分寒水，高楼半落晖。\n叶从金地下，云向玉京飞。\n欲问西来意，谁传智者衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52598,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉和御制千叶黄牡丹","author":"夏竦","text":"千叶繁英吐异芳，中央瑞色蔼清香。\n密攒莺羽参差折，细叠霓裳次第黄。\n雾锁天衣临翠幄，露倾金盏沥霞浆。\n圣明盛事尊长乐，亲洒宸毫奉美祥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52599,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉和御制中和节","author":"夏竦","text":"中春遘初吉，嘉节著芳名。\n习习微和扇，欣欣万物荣。\n云融才化鹤，谷暖已迁莺。\n朝野多欢日，风谣会颂声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52600,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉和御制甘雨应祈","author":"夏竦","text":"少皞九秋当季月，成汤六祷动灵心。\n中宵甘澍均丰浸，尽日层云结远阴。\n销去骄阳为瑞重，招来嘉应感人深。\n侧身修道殊千古，仍叔焉能播德音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52601,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉和御制会庆殿宴","author":"夏竦","text":"禁门乘晓会，宴豆示慈伸。\n激水龙腾久，仪韶凤降频。\n云章流汉筑，衢酒洽尧民。\n百辟皆星拱，兢兢奉北辰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52602,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉和御制兖州景灵宫太极观牌登路","author":"夏竦","text":"崇丘紫馆集繁祯，躬勒璿题耀笔精。\n藻卫森沉登广路，彩云摇袅入层城。\n高侔曲密分都号，远法阳寥纪殿名。\n真祖览观鸿庆茂，寿山从此倍峥嵘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52603,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉和御制读三国志诗 其一","author":"夏竦","text":"白马当涂兆，黄家得岁兴。\n金符威既重，玉版事堪凭。\n汉火承前运，谯龙合旧徵。\n青云开后叶，下武倍兢兢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52604,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉和御制读三国志诗 其二","author":"夏竦","text":"许昌功未逞，江表地初平。\n汉帝居非远，吴侯志欲迎。\n壮图虽未遂，嘉虑实惟精。\n终阙尊崇礼，何关慎器名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52605,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉和御制读三国志诗 其三","author":"夏竦","text":"家乘桑盖瑞，国富卧龙才。\n汉水神晖彻，灵图密命开。\n横天嘉气应，继日景云来。\n傥乏英雄器，三分亦殆哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52606,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉和御制读五代史后唐史 其二","author":"夏竦","text":"长兴秉钧者，子晦道攸隆。\n刚介昌言远，忠清茂泽丰。\n懿文常体道，妙略早从戎。\n可惜亏同德，当年阻建功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52607,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉和御制读五代史后唐史 其一","author":"夏竦","text":"燕赵生奇士，仇方决志平。\n十年常竭节，一剑早知名。\n自取河南镇，终辞霸府兵。\n飞鹰昭庆路，穷达有高情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52608,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉和御制读五代汉史 其二","author":"夏竦","text":"求益诚贤牧，廉平致乐康。\n欢谣腾近辅，盛典茂徽章。\n旧相亲褒记，黎民竞感伤。\n丰碑应不朽，千载咏惟良。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52609,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉和御制读五代汉史 其一","author":"夏竦","text":"危邦有贤哲，力战镇州平。\n革弊还疲庶，从宽悦众情。\n爱人惟责已，徇节几忘生。\n青史惟馨在，千年仰令名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52610,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉和御制读五代周史 其二","author":"夏竦","text":"文伯怀明识，英规世所推。\n济时陈策画，急用备论思。\n隘郭爰增广，烦音亦改为。\n温恭非不济，感遇志如兹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52611,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉和御制读五代周史 其一","author":"夏竦","text":"文懿艰危际，虚心自晏宁。\n依违惭问战，闲淡贵无刑。\n镇俗惩浮躁，尊儒镂典经。\n忠诚亏美谥，良足愧幽灵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52612,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]