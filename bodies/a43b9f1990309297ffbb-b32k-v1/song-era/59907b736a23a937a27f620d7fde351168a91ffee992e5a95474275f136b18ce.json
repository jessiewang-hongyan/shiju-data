[{"title":"句 其五","author":"李良臣","text":"侯家荣经山水县，胜致绝出西南州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60291,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其三","author":"李良臣","text":"勿贻麟楦笑，千古愧公卿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60292,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其四","author":"李良臣","text":"简州何处景最佳，东溪清绝人最誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60293,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送吴将军元瑜","author":"李芬","text":"秦皇寤寐茅盈语，锐意长生欲轻举。\n徐福药就仙骨成，云海茫茫但延伫。\n东西日月秋复春，海变桑田更几人。\n忽思重看旧寰宇，骖鸾直下江淮滨。\n布衣野叟不耕艺，自向琳宫操祓彗。\n秘语亲书悟世人，一坐忽惊三十岁。\n淮南奉道闻真迹，命使扁舟访消息。\n画手从来独擅长，一见仙风心自得。\n归来目断苍烟垠，三尺生绡醉墨翻。\n轴上神翁不解语，彷佛白鹤乘孤云。\n海陵相望一千里，嗟我尘劳未云已。\n授书圯上会有期，诚心愿取黄公履。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60294,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"直钓岩","author":"李芮","text":"无械仙翁去，岩垂直钓名。\n重开茅苇塞，仰见斗山明。\n便觉天光近，从教俗眼惊。\n登临试一览，心目得双清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60295,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"木兰花慢 秋意","author":"李芸子","text":"占西风早处，一番雨，一番秋。\n记故国斜阳，去年今日，落叶林幽。\n悲歌几回激烈，寄疏狂、酒令与诗筹。\n遗恨清商易改，多情紫燕难留。\n嗟休。\n触绪茧丝抽。\n旧事续何由。\n奈予怀渺渺，羁愁郁郁，归梦悠悠。\n生平不如老杜，便如它、飘泊也风流。\n寄语庭柯径竹，甚时得棹孤舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60296,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浯溪读中兴颂","author":"李芾","text":"羯鼓梨园迹已荒，斯文犹在日星光。\n我来细拂青苔石，不忆三郎忆漫郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60297,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自赞","author":"李迎","text":"三仕三已，应缘而进。\n一丘一壑，倦游而归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60298,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"李迎","text":"籍甚人言易已东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60299,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郁林州","author":"李运使","text":"肩舆初入郁林州，井邑都如旧日游。\n虽有山川供远目，不堪雨露湿征裘。\n土风惯习瘴谁虑，客况寂寥心自愁。\n春去秋来人共见，十年辛苦在炎州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60300,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠写御真李长史","author":"李远","text":"玉座烟销砚水清，龙髯不动彩毫轻。\n乍分隆准山河秀，初点重瞳日月明。\n宫女卷帘皆暗认，侍臣开殿尽遥惊。\n六朝天下应无敌，始觉僧繇浪得名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60301,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仆久客钱塘有吹笛月下者同旅闻之凄然皆有归思属令赋之","author":"李远","text":"柯亭之椽不复得，蕲州黄竹今尚存。\n苍崖翠壁产脩干，千顷萧索烟云昏。\n羌人眼力发天巧，长笛裁成凤膺饱。\n老龙馀响出空星，欲喷炎天作秋晓。\n西湖夜寂凉风生，山头一钩新月明。\n商声悽悲羽声壮，行子忽忽难为情。\n时无绿珠清音激皓齿，野王临风三弄亦已矣。\n唯有愁端无古今，举刀不断东流水。\n深闺兰灯照空床，笛声不如离恨长。\n曲终人散一惆怅，回首江山非故乡。\n万事浮云过寥廓，且醉杯中琥珀薄。\n君不见玉管横吹黄鹤楼，江城五月梅花落。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60302,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其三","author":"李远","text":"钗斜穿綵燕，罗薄剪春虫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60303,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书台州上方不出院僧壁","author":"李邴","text":"不下山来十四年，区区笑我走尘寰。\n只应后夜经声寂，明月清风自往还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60304,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题康店铺","author":"李炳","text":"短衣自猎南山虎，正好渔樵不乱群。\n妄以宿嫌诛醉尉，令人翻恨李将军。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60305,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"访庆老不值","author":"李邴","text":"惠远过溪应送陆，玉川入寺不逢曦。\n夕阳半岭鸦栖树，拄杖寻山步步迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60306,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戒珠寺雪轩","author":"李邴","text":"四山环绕翠岧峣，想见凌晨雪未消。\n八万四千修月手，不知何处琢琼瑶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60307,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词四首 其四","author":"李邴","text":"妄意长如凤管寒，君恩不学缕衣宽。\n汉家公主歌黄鹄，犹有琵琶马上弹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60308,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词四首 其三","author":"李邴","text":"鲛绡泪滴鸳鸯冷，月上栏杆照孤影。\n踯躅开花过粉墙，辘轳汲水敲金井。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60309,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词四首 其二","author":"李邴","text":"舞袖何年络臂韝，蛛丝网断玉搔头。\n羊车一去空馀竹，纨扇相看不到秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60310,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词四首 其一","author":"李邴","text":"绿树莺啼春梦觉，楼外鸡人唱清晓。\n深红浅白竞东风，为怜满眼枝枝好。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60311,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄泉州教忠光禅师","author":"李邴","text":"曩岁曾经度厄津，深将法力荷云门。\n如今稍觉神明复，拟欲酬师不报恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60312,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅","author":"李邴","text":"绵霜历雪忿开迟，风笛无情抵死吹。\n鼎实未成心尚苦，不甘桃李傍疏篱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60313,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"铜雀砚","author":"李邴","text":"魏宫歌舞已成尘，重见陶家几世孙。\n铜雀不鸣唯解渴，管城何罪遽遭髡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60314,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"藏六庵","author":"李邴","text":"莫言藏六便忘筌，一六俱非是本然。\n枯木有人能采菌，白牛无地可施牵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60315,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庆老石帆庵","author":"李邴","text":"鹑作衣裳铁作肝，老将身事付寒岩。\n诸天香积犹多供，百鸟山花已罢衔。\n定起水沉和月冷，诗成冰彩敌云缄。\n山头画舸谁安楫，我欲看公使石帆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60316,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宝林寺","author":"李邴","text":"青灯映独宿，世事忽如遗。\n一榻寒无梦，高斋静见诗。\n长空消海气，远壑淡幽姿。\n欲问无生意，高人不可期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60317,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谒迪上人","author":"李邴","text":"数脊招提四面山，羡师终日掩禅关。\n凭阑人语风烟上，乞食僧来紫翠间。\n万水深藏云泱莽，一溪空锁月弯环。\n十年不踏门前路，只遗松风送我还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60318,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"琴泉轩次韵","author":"李邴","text":"但怪朱丝韵枯木，那知古涧坠寒泉。\n鸟啼静夜应传谱，风入寒松拟续弦。\n妙体难寻斤斲处，高吟宁堕膝横边。\n饮光到此如欣舞，笑倒云门逸格禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60319,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九日","author":"李邴","text":"木落霜洲溪水清，登临满目是飘零。\n黄花有意怜幽独，白酒无聊漫醉醒。\n牢愁错倚西风立，楚些巴渝不可听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60320,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"白莲庵","author":"李邴","text":"宴坐鹊巢肩，观花柳生肘。\n幽人夜半至，古月明户牖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60321,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"建炎丞相成国吕忠穆公退老堂诗","author":"李邴","text":"晋公伐叛致太平，归来绿野勤经营。\n沈沦不复经济意，晚节更为人所评。\n文饶佐武取河朔，平泉草木罗清英。\n功成未尝一寓目，镵石作记空传名。\n何如堂堂渭川老，崛起自与天扶倾。\n岁在作噩骇机发，忠臣愤叱思殒生。\n氛埃不为紫霄蔽，日月却向黄道行。\n壮年铁衣勤汗马，白首金鼎调和羹。\n张皇国威起颓压，约敕吏蠹归章程。\n羌戎破胆思寻盟，盗贼脱甲来输诚。\n辕门诸将指呼耳，公有胸中十万兵。\n锐然请老樊小圃，爨席却与渔樵争。\n烟霞放目傲轩冕，水石步屧遗机衡。\n虽然四海望不置，搴旒下瞩熙皇明。\n宣王于今事北伐，周公不日歌东征。\n迎还两宫天地庆，埽洒六合风尘清。\n是时公归乃可耳，岂得遽适羲皇情。\n祝公寿考如卫武，百岁箴儆谋群卿。\n祝公功名如郭令，身与庙社同安荣。\n忠诚向来金石贯，勋烈遂将天壤并。\n他年升堂奉杖屦，愿留隙地诛柴荆。\n但令公孙肯开閤，不用野王来抚筝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60322,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"女冠子 上元","author":"李邴","text":"帝城三五。\n灯光花市盈路。\n天街游处。\n此时方信，凤阙都民，奢华豪富。\n纱笼才过处。\n喝道转身，一壁小来且住。\n见许多、才子艳质，携手并肩低语。\n东来西往谁家女。\n买玉梅争戴，缓步香风度。\n北观南顾。\n见画烛影里，神仙无数。\n引人魂似醉，不如趁早，步月归去。\n这一双情眼，怎生禁得，许多胡觑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60323,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"木兰花 美人书字","author":"李邴","text":"沈吟不语晴窗畔。\n小字银钩题欲遍。\n云情散乱未成篇，花骨敧斜终带软。\n重重说尽情和怨。\n珍重提携常在眼。\n暂时得近玉纤纤，翻羡缕金红象管。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60324,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉蝴蝶","author":"李邴","text":"壮岁分符方面，惠风草偃，禾稼春融。\n报政朝天，归去稳步鳌宫。\n望尧蓂、九重绛阙，颁汉诏、五色芝封。\n湛恩浓。\n锦衣槐里，重继三公。\n雍容。\n临歧祖帐，绮罗环列，冠盖云丛。\n满城桃李，尽将芳意谢东风。\n柳烟轻、万条离恨，花露重、千点啼红。\n莫匆匆。\n且陪珠履，同醉金钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60325,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"念奴娇","author":"李邴","text":"素光练净，映秋山、隐隐修眉横绿。\n鳷鹊楼高天似水，碧瓦寒生银粟。\n千丈斜晖，奔云涌雾，飞过卢仝屋。\n更无尘气，满庭风碎梧竹。\n谁念鹤发仙翁，当年曾共赏，紫岩飞瀑。\n对影三人聊痛饮，一洗离愁千斛。\n斗转参横，翩然归去，万里骑黄鹄。\n满川霜晓，叫云吹断横玉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60326,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"洞仙歌","author":"李邴","text":"一团娇软，是将春揉做，撩乱随风到何处。\n自长亭、人去后，烟草萋迷，归来了、装点离愁无数。\n飘扬无个事，刚被萦牵，长是黄昏怕微雨。\n记那回，深院静，帘幕低垂，花阴下、霎时留住。\n又只恐、伊家太轻狂，蓦地和春，带将归去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60327,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"调笑令","author":"李邴","text":"双绿。\n淡匀拂。\n两脸春融光透玉。\n起来却怕东风触。\n本是一团香玉。\n飞鸾台上看未足。\n贮向阿娇金屋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60328,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清平乐 闺情","author":"李邴","text":"露花烟柳。\n春思浓如酒。\n几阵狂风新雨后。\n满地落红铺绣。\n风流何处疏狂。\n厌厌恨结柔肠。\n又是危阑独倚，一川烟草斜阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60329,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"满庭芳","author":"李邴","text":"凉风吹帽，横槊试登高。\n想见征西旧事，龙山会、宾主俱豪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60330,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其十二","author":"李邴","text":"为君醉倒烛花前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60331,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其三","author":"李邴","text":"姜坟馀马鬣，傅钓但龙泓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60332,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其十一","author":"李邴","text":"北窗人物羲皇上。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60333,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"李邴","text":"长廊风度磬，深院雨留重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60334,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其十","author":"李邴","text":"故斸云根带藓移。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60335,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其十三","author":"李邴","text":"等闲莫遣俗人看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60336,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"李邴","text":"柳老抛绵后，梅酸著骨时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60337,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其五","author":"李邴","text":"古来重九皆如此，无复龙山剧孟嘉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60338,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其九","author":"李邴","text":"东湖同住水云家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60339,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"双桧联句","author":"李周","text":"古宇列双桧，森郁攲檐角。\n高干若偃盖，低枝罗翠幄。\n叶硬攒猬毛，子圆如雀壳。\n盘根虽轮囷，呈才终卓荦。\n枯冬傲霜雪，炎夏宜雨雹。\n苍皮绕龙蛇，危巅巢鸑鷟。\n岁寒知后凋，清风到先觉。\n月涵烟影孤，雨溜苔藓驳。\n愿逢繁辂用，勿使为榱桷。\n春姿笔工偷，风韵溪虎学。\n松筠比节操，虫鸟敢蠹啄。\n黛色晚山分，清香朝露濯。\n桃李耻妖饶，椅梧羞龌龊。\n俗名强雌雄，奇胜重古朴。\n气势已千寻，栽培从一握。\n五松惭忝位，秦封受殊渥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60340,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽蔡西山先生","author":"李闳祖","text":"有名天所靳，无位世仍挤。\n不得西山卧，还同濂水栖。\n元精抽秘钥，众妙贯圆机。\n友尽人间士，岿然季子题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60341,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大涤洞天留题","author":"李闶先","text":"福地弯环古洞霄，古坛云冷宝□飘。\n无蛟可断泉犹怒，有虎难驯雾未消。\n一柱孤擎天妥帖，重峦九掩路迢遥。\n自怜骨相多奇蹇，只合山中种药苗。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60342,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同谢子肃诸公饮巾山岊上人房","author":"李龟朋","text":"石磴行崎曲，缘云入翠微。\n山寒惊岁晚，渚绿认春归。\n绝境为谁设，清欢如此稀。\n轩窗生夜气，檐角有星飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60343,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺熊克进九朝要略转一官","author":"李龟朋","text":"翰苑前资汉硕儒，苦心何翅十年馀。\n修成当代将来法，读尽生平未见书。\n黄帕奏篇登御府，紫纶加秩下宸除。\n近臣已是闻天语，鸾鹊催归定不虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60344,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"柘轩 其一","author":"李侗","text":"耕桑本是吾儒事，不免饥寒智者非。\n出处自然皆有据，不应感念泣牛衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60345,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"柘轩 其二","author":"李侗","text":"五亩之宫植以桑，孟轲举此助谈王。\n轩前蒙密知何意，要见经纶滋味长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60346,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"柘轩 其三","author":"李侗","text":"三春采采为蚕供，衣被生灵独有功。\n野外谩多閒草木，可惭无计谢东风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60347,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅林春信","author":"李侗","text":"积雪千林冻欲摧，倚栏日日望春回。\n天公为我传消息，故遣梅花特地开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60348,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舍上辞归罗豫章先生","author":"李侗","text":"学道求师久剑潭，岂缘枯朽预儒涵。\n致知事业同归理，克己工夫判立谈。\n未借老商颜笑一，已偕韩氏俗重三。\n过庭若问论诗礼，应问从谁学指南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60349,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"静庵山居","author":"李侗","text":"胜如城外宅，花木拥檐前。\n一雨晚时过，群峰翠色鲜。\n采荆烹白石，接竹引清泉。\n车马长无到，逍遥乐葛天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60350,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"藏春峡","author":"李侗","text":"咏归堂里静怡神，更步芳亭识趣新。\n爱竹心虚初长笋，观梅香散渐含仁。\n云将膏雨过桐岭，水泛桃花出剑津。\n生意峡中藏得否，自家收拾满腔春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60351,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟中闻木犀","author":"李叔达","text":"地近孤城水合流，天风吹下广寒秋。\n岩花似喜幽人至，先遣清香到小舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60352,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题太平兴国宫","author":"李受","text":"香炉峰下宅天官，三界方知可往还。\n白石眼前分世路，紫云头上接天班。\n沧溟岂隔毫芒内，忆劫皆归瞬息间。\n但得心源到真境，凌虚鸾鹤会跻攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60353,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"华清怀古 其二","author":"李周","text":"吾家居处本关西，旧记遗踪事不迷。\n屡过华清无一字，恐人笑我不留题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60354,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"华清怀古 其一","author":"李周","text":"胡雏铁骑正纵横，环上罗衣血染腥。\n蜀道归来应悔祸，香囊特地泣娉婷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60355,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"因痔痛彻心膂为诗","author":"李坤臣","text":"吾道由来贯古今，纤毫不假外推寻。\n只因疾病呻吟切，识得平生第一心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60356,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"风流子","author":"李坦然","text":"东君虽不语，年华事、今岁恰如期。\n向寒雨望中，晓霜清处，领些春意，开两三枝。\n又不是、山桃红锦烂，溪柳绿摇丝。\n别是一般，孤高风韵，绛裁纤萼，冰剪芳蕤。\n清香还有意，轻飘度勾引，几句新诗。\n须是放怀追赏，莫恁轻离。\n更嫦娥为爱，寒光满地，故移疏影，来伴南枝。\n谁道寿阳妆浅，偏入时宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60357,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观德堂","author":"李垂","text":"园池气象明，池沼春波平。\n东汇有朝势，北源无滞声。\n临流好鼓瑟，待月堪浮觥。\n濯足思馀绿，洗心思云清。\n篆沟合远派，布窦垂高城。\n我愿化飞雨，使君将劝耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60358,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]