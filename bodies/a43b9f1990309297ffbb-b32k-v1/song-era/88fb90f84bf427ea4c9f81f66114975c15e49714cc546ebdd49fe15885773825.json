[{"title":"采石李白墓","author":"晁补之","text":"客星一点太微傍，谈笑青蝇玉失光。\n载酒五湖狂到死，只今天地不能藏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55260,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"金陵南数十里江心烈山崒然特起犹金山也家人云安得隐于此作一绝","author":"晁补之","text":"山如浮玉一峰立，江似海门千顷开。\n我欲此中成小隐，莫教山脚有船来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55261,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陌上花八首 其八","author":"晁补之","text":"陌上偷来为看花，饶声鹦鹉莫夭斜。\n犊车缓缓随芳草，不去桃源阿母家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55262,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陌上花八首 其七","author":"晁补之","text":"云母蛮笺作信来，佳人陌上看花回。\n妾行不似东风急，为报花须缓缓开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55263,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陌上花八首 其六","author":"晁补之","text":"临安城郭半池台，曾是香尘扑面来。\n不见当时翠軿女，今年陌上又花开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55264,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陌上花八首 其五","author":"晁补之","text":"吴歌白纻怨芳菲，肠断怀王去不归。\n陌上如今小花伴，山前山后白鹇飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55265,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陌上花八首 其四","author":"晁补之","text":"荆王梦罢已春归，陌上花随暮雨飞。\n却唤江船人不识，杜秋红泪满罗衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55266,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陌上花八首 其三","author":"晁补之","text":"娘子歌传乐府悲，当年陌上看芳菲。\n曼声更缓何妨缓，莫似东风火急归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55267,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陌上花八首 其二","author":"晁补之","text":"朝云暮雨山头宅，暖日晴风陌上花。\n绛幕何妨行缓缓，送春归尽妾还家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55268,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陌上花八首 其一","author":"晁补之","text":"郊外金軿步帐随，道边游女看王妃。\n内官走马传书报，陌上花开缓缓归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55269,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鱼沟遇大水","author":"晁补之","text":"沙行水宿几江南，石斗龙求久已谙。\n秋水故应旋面目，顺流东望为君惭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55270,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"复至凝祥池上","author":"晁补之","text":"去岁相携此地游，西风垂果奉灵湫。\n春工变化浑无迹，红满枝条绿满洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55271,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"复和定国惠竹皮枕谑句","author":"晁补之","text":"老来山水兴弥深，不在长安侠少林。\n它日只为林下计，不将锦被作呻吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55272,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宫亭神甚灵云有婢名如愿以借客有所求叩如愿即获神又能于湖心分风使上下各得顺风故刘删诗云回舻乘派水举棹逐分风","author":"晁补之","text":"同舟自古无胡越，南北东西路不同。\n不问宫亭借如愿，只求四面与分风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55273,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"将行陪贰车观灯","author":"曾巩","text":"行歌红粉满城欢，犹作常时五马看。\n忽忆使君身是客，一时挥泪逐金鞍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55274,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"将别历下二首 其一","author":"晁补之","text":"来见红蕖隘渚香，归涂未变柳梢黄。\n殷勤趵突溪中水，相送扁舟向汶阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55275,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"将别历下二首 其二","author":"晁补之","text":"鸳鸯鸂鶒绕渔梁，摇漾山光与水光。\n不管使君征棹远，依然飞下旧池塘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55276,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"彦鲁?字号卷余擢为开封第三用彦鲁韵","author":"晁补之","text":"寂寂醒醒谁得知，万重故纸压须弥。\n不缘饶舌丰干道，拾得山间底小儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55277,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"省曹梦游山示无斁","author":"晁补之","text":"万里归来兄弟乐，百年多病井庐思。\n如何骑马穿靴地，只梦登山著屐时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55278,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"祝家墩阻水旦起舟人云天上风花顺矣作一绝","author":"晁补之","text":"依依牛马辨平沙，三日扁舟近祝家。\n明日扬帆应复驶，蒸云散乱作风花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55279,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贵溪在信州城南其水西流七百里入江","author":"晁补之","text":"玉山东去不通州，万壑千岩隘上游。\n应会逐臣西望意，故教溪水只西流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55280,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贵溪徐氏招隐园昔王表避乱居此山依之者数千家其诗云逍遥入南斗者也","author":"晁补之","text":"鬼谷西来一丈清，三山箕拱慰高情。\n时平尚欲依王表，南斗逍遥毕此生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55281,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赴广陵道中三首 其三","author":"晁补之","text":"杨柳青青欲哺乌，一春风雨暗隋渠。\n落帆未觉扬州远，已喜淮阴见白鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55282,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赴广陵道中三首 其二","author":"晁补之","text":"急鼓鼕鼕下泗州，却瞻金塔在中流。\n帆开朝日初生处，船转春山欲尽头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55283,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赴广陵道中三首 其一","author":"晁补之","text":"醉卧符离太守亭，别都弦筦记曾称。\n淮山杨柳春千里，尚有多情忆小胜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55284,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赴齐州","author":"曾巩","text":"淮南蒙召鬓毛斑，乞得东秦慰病颜。\n晓整轻鞍汶阳北，却冲微雨看青山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55285,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送永嘉君回至鹿邑东门外作","author":"晁补之","text":"冬温榆柳未全彫，黄蝶飞飞缀野蒿。\n华发不堪悲世故，斜川归兴满东皋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55286,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"钟山有石故名","author":"晁补之","text":"江上秋涛喷玉岩，风锼月鍊白云缄。\n为君一叩无人境，要听洪钟出万杉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55287,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"栖贤寺三峡桥","author":"晁补之","text":"绝壁秋标天外剑，深溪冬吼地中雷。\n上宫未信无人到，朱阁飞从顶上来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55288,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"栗区村与无斁别","author":"晁补之","text":"十年投分皆卿相，四海论心只弟昆。\n老忆躬耕困随牒，春风挥泪栗区村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55289,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"流民","author":"晁补之","text":"生涯不复旧桑田，瓦釜荆篮止道边。\n日暮榆园拾青荚，可怜无数沈郎钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55290,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"都门","author":"晁补之","text":"飘零何处是生涯，瘦马都门踏落花。\n芳物搅心看不得，绨袍遮眼畏风沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55291,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宿采石追怀沈丘叔父同应诏渡此今二十七年矣而叔父谢世补之方远适泣涕成篇","author":"晁补之","text":"二十七年前应诏，黄昏同上木兰舟。\n江山依旧人琴寂，白首南迁泪迸流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55292,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄李成季","author":"晁补之","text":"闻驱传节向秦关，何日重来玉笋班。\n犹胜谯都拙司马，苦无官况不教闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55293,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚发长芦","author":"晁补之","text":"船头勾曲洪涛外，船尾长芦白雾中。\n千里山容初上日，一江帆影尽乘风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55294,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚春二首 其一","author":"晁补之","text":"春呼群艳与偕藏，残英风劝作清狂。\n消愁贤圣酬酢寡，破睡枪旗幽兴长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55295,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚春二首 其二","author":"晁补之","text":"春归风雨一朝尽，昼静园林诸趣嘉。\n蜻蜓出水群掠蚋，鹎鵊卫巢双趁鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55296,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚雪示阎仲孺","author":"晁补之","text":"拂檐点砌静如沙，无限寒林顷刻花。\n明日穷檐深一尺，不知何处觅袁家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55297,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"望金陵","author":"晁补之","text":"龙盘虎踞望南津，馀烈峥嵘尚霸陈。\n醉著不知风揭屋，可能杨素是江神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55298,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"望香垆峰","author":"晁补之","text":"危楼曲径群岩遍，蜡屐青鞋到处逢。\n更上五峰双剑表，香垆依旧半天中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55299,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"欲求闲局理旧学作 其一","author":"晁补之","text":"莫求致仕且分司，此等刘伶笑妇儿。\n投老寸阴如寸玉，从君了事只名痴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55300,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"欲求闲局理旧学作 其二","author":"晁补之","text":"故园历历眼中分，非禹谁教不入门。\n何处功名有成遂，玉初不献足犹存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55301,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清口怀应书时雪中舟行","author":"晁补之","text":"蚤岁单舟此水滨，雪花都蔽引舟人。\n重来五马真何事，笑雪空成鬓上春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55302,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渑池道中","author":"晁补之","text":"虎狼敌国易良图，望见将军要引车。\n不畏秦强畏廉斗，古来只有蔺相如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55303,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"祷雨宿九曲池上三首 其一","author":"晁补之","text":"同辇笙歌地，荒池风露天。\n无心更怀古，凉夜正甘眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55304,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"祷雨宿九曲池上三首 其二","author":"晁补之","text":"荒城孤绝处，犹指玉钩亭。\n凉月遍宜上，江南山更青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55305,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"祷雨宿九曲池上三首 其三","author":"晁补之","text":"微月淡芜城，飞萤纵复横。\n蛙鱼凉亦乐，跳港触荷声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55306,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"移笇山五杉归植里第","author":"晁补之","text":"一丘一壑感归心，过尽青山几茂林。\n自载五杉如碧凤，欲看春雨舞庭阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55307,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"累得周同年锷书","author":"晁补之","text":"谯都司马拙依然，翻手为云绝可怜。\n唯有凤翔周录事，手书连月寄同年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55308,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"湖口","author":"晁补之","text":"彭蠡宫亭浸全楚，号呼喷吐出喉中。\n此间旷荡无穷水，何处还容地火风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55309,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"皖口寄怀前太平守陈公度","author":"晁补之","text":"常爱东陵早拂衣，我行曾不叩荆扉。\n凭君天柱峰头望，看我扁舟几日归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55310,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答李令","author":"晁补之","text":"知音惭李令，问我复何为。\n道义惟添睡，功名只有诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55311,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢王立之送蜡梅五首 其五","author":"晁补之","text":"去年不见蜡梅开，准拟新年恰恰来。\n芳菲意浅姿容淡，忆得素儿如此梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55312,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢王立之送蜡梅五首 其四","author":"晁补之","text":"诗报蜡梅开最先，小奁分寄雪中妍。\n水村映竹家家有，天汉桥边绝可怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55313,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢王立之送蜡梅五首 其三","author":"晁补之","text":"上林初就诏群臣，紫蒂同心各自新。\n谁见小园深雪里，破春一萼更惊人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55314,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢王立之送蜡梅五首 其二","author":"晁补之","text":"恐是凝酥染得黄，月中清露滴来香。\n定知何逊牵诗兴，借与穿帘一点光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55315,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢王立之送蜡梅五首 其一","author":"晁补之","text":"未教落素混冰池，且看轻黄缀雪枝。\n越使可因千里致，春风元自未曾知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55316,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"遇赦北归","author":"晁补之","text":"山犹故险水犹奔，无复前年溅泪痕。\n自是人心随境别，橹声帆色尽君恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55317,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新城塔山对雨二首 其一","author":"晁补之","text":"山外圆天一镜开，山头云起似浮埃。\n松吟竹舞水纹乱，坐见溪南风雨来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55318,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新城塔山对雨二首 其二","author":"晁补之","text":"竹枝草履步苍苔，山上孤亭四牖开。\n烟雨濛濛溪又急，小篷时转碧滩来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55319,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蒲萄","author":"晁补之","text":"蒲萄新条易扶疏，椿花锁碎满庭除。\n旱乾只喜雨破土，潦润不忧河决渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55320,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谪宋徙亳初闻周璠琵琶","author":"晁补之","text":"枣园憭慄桧厅寒，醉倚琵琶倒鹖冠。\n不似江州白司马，只成怨恨不成欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55321,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"漫成呈文潜五首 其二","author":"晁补之","text":"花如怨人不近眼，深院一枝春得知。\n东风不是不爱惜，刚为花愁真是谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55322,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"漫成呈文潜五首 其一","author":"晁补之","text":"无心看春只欲坐，偶骑马傍春街行。\n可怜愁以草得暖，一寸心从何处生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55323,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谯国嘲提壶","author":"晁补之","text":"何处提壶鸟，荒园自叫春。\n夕阳深樾里，持此劝何人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55324,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谯都对酒忆玉函山","author":"晁补之","text":"不遣西楼对玉函，宋谯频缀副车衔。\n今年重污花前酒，犹是扬州别驾衫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55325,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题工部文侍郎周翰郭熙平远二首 其一","author":"晁补之","text":"渔村半落楚江边，林外秋原雨外天。\n谁倚竹楼邀大艑，天涯暮色已苍然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55326,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题工部文侍郎周翰郭熙平远二首 其二","author":"晁补之","text":"洞庭木落万波秋，说与南人亦自愁。\n欲指吴松何处是，一行征雁海山头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55327,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题伯时画","author":"晁补之","text":"单于射获明妃笑，劝酌蒲萄跪小胡。\n不恨别宫昆莫老，应怜超乘子南夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55328,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题庐山","author":"晁补之","text":"南康南麓江州北，五百僧房缀蜜脾。\n尽是庐山佳绝处，不知何处合题诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55329,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题谷熟驿舍二首 其一","author":"晁补之","text":"驿后新篱接短墙，枯荷衰柳小池塘。\n倦游对此忘行路，徙倚轩窗看夕阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55330,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题谷熟驿舍二首 其二","author":"晁补之","text":"一官南北鬓将华，数亩荒池净水花。\n埽地开窗置书几，此生随处便为家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55331,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题周廉彦所收李甲画三首 其三 鸭","author":"晁补之","text":"急风吹雪满汀洲，迎腊淮南忆倦游。\n小鸭枯荷野艇冷，去年今日冻高邮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55332,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题周廉彦所收李甲画三首 其二 雁","author":"晁补之","text":"网罗无限稻粱微，怜尔冥冥亦庶几。\n戏鸭眠凫满中沚，衡阳无意更南飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55333,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题周廉彦所收李甲画三首 其一 鹊","author":"晁补之","text":"上林花妥逐莺飞，愁绝江南雪里时。\n嚄唶何须旁檐喜，毰毸相对两寒枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55334,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题宗室大年画扇四首 其一","author":"晁补之","text":"王孙蕴奇意，纨素澹云烟。\n借与王摩诘，含毫思邈然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55335,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题宗室大年画扇四首 其二","author":"晁补之","text":"西风入丛竹，惨澹带秋阴。\n惊起中坻雁，衡阳万里心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55336,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题宗室大年画扇四首 其三","author":"晁补之","text":"鸲之仍鹆之，尔名今是非。\n人言不踰济，何事满苔矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55337,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]