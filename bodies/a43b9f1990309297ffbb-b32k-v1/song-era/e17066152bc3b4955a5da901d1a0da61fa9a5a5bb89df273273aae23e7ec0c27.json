[{"title":"晚行田间书事三首 其二","author":"赵蕃","text":"郎罢肩犁稚子前，牛行熟路不须牵。\n归来饭倒羹初糁，洗脚还将草履穿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47919,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚行田间书事三首 其一","author":"赵蕃","text":"青裙汲水过前溪，白发应门儿戏啼。\n试问主人何所在，为言南亩正扶犁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47920,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚过刘伯山","author":"赵蕃","text":"晚向穷冈访竹亭，竹间忽有打禾声。\n凶年独使诗人饱，可见天公非世情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47921,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚过彦真山亭并呈允升季仪兼属照邻二首 其二","author":"赵蕃","text":"寤寐诗名岁月过，日来方喜和羊何。\n秋风奈我当归去，湘水湘山馀恨多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47922,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚过彦真山亭并呈允升季仪兼属照邻二首 其一","author":"赵蕃","text":"隔岸看山自足佳，背山仍有碧云遮。\n我来政值崚嶒际，却恨林端已暮鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47923,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚作","author":"赵蕃","text":"古屋黄昏蝙蝠飞，尔飞干我竟何为。\n但愁蚊子且生翼，饱尔亦当侵我肌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47924,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚卧二首 其二","author":"赵蕃","text":"戏学韩公盆作池，雨来亦解起风漪。\n蛙鸣莫作鼓吹想，更问属官仍属私。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47925,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚卧二首 其一","author":"赵蕃","text":"轩小才堪置竹床，晚来新浴快初凉。\n扫除诸妄归真想，薝卜林中闻妙香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47926,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚秋郊居八首 其八","author":"赵蕃","text":"邻父疑为三径孙，一生辛苦在田园。\n近来交友谁相顾，渠独频沾菜把恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47927,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚秋郊居八首 其七","author":"赵蕃","text":"蔓草依依网作窠，荒庭寂寂蚓能歌。\n人言病久须閒默，习气相攻未易诃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47928,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚秋郊居八首 其六","author":"赵蕃","text":"霜天柿叶须收拾，咫尺山园底去迟。\n不是功名羁绊得，病来筋力费扶持。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47929,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚秋郊居八首 其五","author":"赵蕃","text":"病夫慵出长蓬蒿，但见刍薪价益高。\n积雨了知寒在候，我方随事典衣袍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47930,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚秋郊居八首 其四","author":"赵蕃","text":"九日黄花信昔谈，是身何自见江南。\n故今开晚方为贵，失所胡为浪不堪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47931,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚秋郊居八首 其三","author":"赵蕃","text":"病橘萧萧祇古枝，二三酸子间虫丝。\n人言社酒堪医此，太息于今已后时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47932,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚秋郊居八首 其二","author":"赵蕃","text":"宋玉悲秋殆我欺，江南摇落定何时。\n不因枫树颜如渥，松柏连林漫莫知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47933,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚秋郊居八首 其一","author":"赵蕃","text":"梨枣熟时须一雨，江南底忽类中州。\n南人不识北人事，懔懔已怀禾黑忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47934,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚晴二首 其二","author":"赵蕃","text":"空山草木固能长，迩日曾经剪伐荒。\n一笑为渠成解说，政防妨我步斜阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47935,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚晴二首 其一","author":"赵蕃","text":"山中岑郁倍怀人，况是春来阴雨频。\n到得小晴堪细履，又嗟落莫与谁亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47936,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚登邬子亭用壁间韵四首 其四","author":"赵蕃","text":"何处鸣桹歌浊清，鹭飞鸥舞惯忘惊。\n卒逢已觉翩然逝，犹欲因之问水程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47937,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚登邬子亭用壁间韵四首 其三","author":"赵蕃","text":"中流掀簸势难停，望断龙祠与戍亭。\n胡不少留风止去，塔铃昨者故丁宁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47938,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚登邬子亭用壁间韵四首 其二","author":"赵蕃","text":"朝行忽尔逆风颠，已到津头尚耸然。\n不似渔翁易夷险，雨蓑晴笠住忘年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47939,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚登邬子亭用壁间韵四首 其一","author":"赵蕃","text":"秋入江湖事事幽，未妨著我咏洪流。\n水居三两似相识，苦问来船仍去舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47940,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚歇溪上","author":"赵蕃","text":"爱此沧浪水，临流坐写诗。\n赋诗元未就，藉水发幽姿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47941,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚霁","author":"赵蕃","text":"雨歇蝉声抱木悲，茅檐独立看云移。\n一阴十日不见月，想见清光分外奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47942,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"望金华山绝句四首 其四","author":"赵蕃","text":"九陌纷纷翳吾目，是间冰熨一尘无。\n十日五日一水石，造次著诗那得摹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47943,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"望金华山绝句四首 其三","author":"赵蕃","text":"一溪屈曲几弯环，赢得金华四面看。\n雨黛欲收晴翠滴，忽然云起又漫漫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47944,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"望金华山绝句四首 其二","author":"赵蕃","text":"云蔽云开山祇然，画无能事著诗传。\n扁舟尽日无多厌，信手拈来亦漫编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47945,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"望金华山绝句四首 其一","author":"赵蕃","text":"山青云白晚能佳，中有仙人旧隐家。\n弹压政须烦健笔，颉颃谁与佩飞霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47946,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅花十绝句 其八","author":"赵蕃","text":"十里荆溪溪上梅，故人几日寄诗来。\n相应载酒裴回次，忆我去年同此杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47947,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅花十绝句 其七","author":"赵蕃","text":"雨薄梅花似有情，定应怜我太饥生。\n不同玉屑和朝露，且效夕餐收落英。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47948,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅花十绝句 其三","author":"赵蕃","text":"断崖脩竹是吾庐，亦有梅花手自锄。\n岁晚平安久无报，不知春到又何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47949,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅花十绝句 其二","author":"赵蕃","text":"寒雀萧萧冻不喧，背人缘底过颓垣。\n似矜玉粒堪充饱，啄破霜包无乃冤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47950,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅花十绝句 其六","author":"赵蕃","text":"江上人家烟雨间，意行曾忆犯榛菅。\n祇今冷落人谁问，输与白鸥相对閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47951,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅花十绝句 其四","author":"赵蕃","text":"风月悬知非俗物，与梅相对却成三。\n是中故有无穷意，曲几团蒲须细参。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47952,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅花十绝句 其九","author":"赵蕃","text":"梅花佳处是孤影，月落参横真见之。\n几欲烦我为摹写，却愁才尽不能支。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47953,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅花十绝句 其十","author":"赵蕃","text":"松风亭下盛开时，曾辱苏仙与赋诗。\n今日折花怀此老，端如嗅菊念东篱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47954,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅花十绝句 其五","author":"赵蕃","text":"桃李纷纷倚市门，岂知幽谷有佳人。\n莫嗟玉粒终无偶，人物谁知温太真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47955,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"t