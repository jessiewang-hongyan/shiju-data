[{"title":"颂古六十二首 其二十四","author":"释清远","text":"五色狸奴尽力争，及乎按剑总生盲。\n分身两处重相为，直得悲风动地生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59495,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十首 其十七","author":"释守珣","text":"安国安家不在兵，鲁连一箭亦多情。\n三千剑客今何在，独许将军建太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59496,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古六十二首 其二十六","author":"释清远","text":"同气相求事可论，一回见面一欢情。\n两行何处闲文字，一队谁家好弟兄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59497,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古六十二首 其二十七","author":"释清远","text":"骨里皮兮皮里骨，大隋老子无窠窟。\n上士闻之笑未休，中流特地生疑惑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59498,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古六十二首 其二十八","author":"释清远","text":"老大宗师竖指头，一生用得最风流。\n玄沙拗折无人会，年来年去冷飕飕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59499,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古六十二首 其二十九","author":"释清远","text":"黄金为骨玉为棱，莫把他家此日寻。\n多少从来悟心匠，尽将底事继威音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59500,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古六十二首 其三十","author":"释清远","text":"池阳何处得扪摸，后代商量苦也无。\n古人刚地成多事，敢问如今会也无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59501,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古六十二首 其三十一","author":"释清远","text":"密密堂堂早二三，本来无物更何堪。\n痴人见了生欢喜，作者相逢满面惭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59502,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古六十二首 其三十二","author":"释清远","text":"悟人千个道无忧，肯信遭他第二头。\n寂寞山花寒食后，夕阳西去水东流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59503,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古六十二首 其三十三","author":"释清远","text":"长连床上狐屎尿，三圣堂前狗吠春。\n跳出金牛窠窟子，月明照见夜行人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59504,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古六十二首 其三十四","author":"释清远","text":"玄沙三种病人，有理不在高声。\n引得香严老子，走来树上悬身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59505,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古六十二首 其三十五","author":"释清远","text":"祸福威严不自灵，残杯冷炙享何人。\n一从去后无消息，野老犹敲祭鼓声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59506,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古六十二首 其三十六","author":"释清远","text":"春寒料峭，冻杀年少。\n切忌参商，别无奇妙。\n低头侍奉，欢喜问讯。\n佛法商量，伤子性命。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59507,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古六十二首 其三十七","author":"释清远","text":"赵州言勘破，笑杀老禅和。\n院主须眉落，南泉打粥锅。\n赵州勘破，却成罪过。\n大地众生，千个万个。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59508,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古六十二首 其三十八","author":"释清远","text":"醉眠醒卧不归家，一身流落在天涯。\n祖佛位中留不住，夜来依旧宿芦花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59509,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古六十二首 其三十九","author":"释清远","text":"一问当机绝异同，定乾坤箭验勋功。\n轰轰一掌胲腮下，笑杀雄山者老翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59510,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古六十二首 其四十","author":"释清远","text":"春至是花开，朱颜安在哉。\n可怜园里色，不入镜中来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59511,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古六十二首 其四十一","author":"释清远","text":"春来依旧一枝枝，同地同天道不疑。\n未彻之言人莫问，令余特地笑嘻嘻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59512,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古六十二首 其四十二","author":"释清远","text":"擘开华岳连天色，放出黄河到海声。\n瞎驴死后蒿枝折，大地如今有几人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59513,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古六十二首 其四十三","author":"释清远","text":"奉君三顿曲周遮，屈辱云门老作家。\n渡水穿云五湖客，欲将何物当生涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59514,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古六十二首 其四十四","author":"释清远","text":"云门答糊饼，言前句后领。\n驴鞍爷下颔，到了终不省。\n塞却你咽喉，把将糊饼来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59515,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古六十二首 其四十五","author":"释清远","text":"杨子江头杨柳春，杨花愁杀渡头人。\n一声残笛离亭晚，君向潇湘我向秦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59516,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古六十二首 其四十六","author":"释清远","text":"数目分明举即难，衲僧无不胆毛寒。\n须知更有壶中路，但向须弥顶外看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59517,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古六十二首 其四十七","author":"释清远","text":"万象之中独露身，一回相见一回嗔。\n东西南北吾皇化，莫向江头苦问津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59518,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古六十二首 其四十八","author":"释清远","text":"鳌山成道足人传，莫是从前话不圆。\n赖有玄沙知始末，遍身红烂在渔船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59519,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古六十二首 其四十九","author":"释清远","text":"老大宗师没巴鼻，养狗之缘太儿戏。\n夺牌禅客如到来，铅刀争及吹毛利。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59520,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古六十二首 其五十","author":"释清远","text":"欲求佛法往南方，老大宗师为举扬。\n山花满地虽狼藉，一阵风来一阵香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59521,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古六十二首 其五十一","author":"释清远","text":"宗师方便太慈悲，是汝之言实古锥。\n万里神光腾顶后，肯将生死嚇愚痴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59522,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古六十二首 其五十二","author":"释清远","text":"在途在舍若为酬，莫把先师一例求。\n雄雄宇宙如王者，未免半边无髑髅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59523,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古六十二首 其五十三","author":"释清远","text":"犊牛生子颇相谙，两眼通红色似蓝。\n把火照来无觅处，大家普请一时参。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59524,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古六十二首 其五十四","author":"释清远","text":"赵州一椀茶，验尽当行家。\n一期虽似好，争免事如麻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59525,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古六十二首 其五十五","author":"释清远","text":"师真丑拙不堪呈，用尽身心笑杀人。\n彼中莫觅丝头意，白鼻昆崙贺新正。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59526,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古六十二首 其五十六","author":"释清远","text":"出得出不得，初不离是定。\n圣者起凡情，凡人而乃圣。\n倒用与横拈，扶邪及显正。\n春雨春风竹户凉，落花啼鸟千峰静。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59527,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古六十二首 其五十七","author":"释清远","text":"平生心胆向人倾，到此门中有几人。\n别后都城旧知己，暖烟斜日又黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59528,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古六十二首 其五十八","author":"释清远","text":"佛手驴脚生缘，黄龙元无此语。\n直饶恁么知之，我侬亦未相许。\n奉报四海禅人，第一不得错举。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59529,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古六十二首 其五十九","author":"释清远","text":"著眼看来宁免瞎，全身何用佩金鱼。\n黄龙意气雄豪甚，祇为他家不识书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59530,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古六十二首 其六十","author":"释清远","text":"尽力不柰何，按牛头吃草。\n若无锦绣文，难以论嘉藻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59531,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古六十二首 其六十一","author":"释清远","text":"何故唤作手，衲僧难开口。\n拟议自颟顸，可怜大蒙斗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59532,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古六十二首 其六十二","author":"释清远","text":"彼此且无相负累，行人无不失钩锥。\n虽然不瞎众生眼，也好拳头劈口槌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59533,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其一","author":"释清远","text":"世尊拈花，迦叶微笑。\n亲切亲切，省要省要。\n眼目定动，料料掉掉。\n为报先生，莫打之绕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59534,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其二","author":"释清远","text":"两岸芦花一叶舟，凉风深夜月如钩。\n丝纶千尺慵抛放，归到家山即便休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59535,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其三","author":"释清远","text":"挥戈佛日不西流，照彻人间洞九幽。\n从此安居无一事，休将玄妙挂心头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59536,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其四","author":"释清远","text":"昨朝六月二十六，无角铁牛生四足。\n哮吼一声人未知，撼动天关并地轴。\n只履又西归，唱罢胡家曲。\n可怜末后太分明，无限清声遍溪谷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59537,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其五","author":"释清远","text":"棒喝齐施古佛宗，三玄三要绝狐踪。\n白云消散青山在，明月芦花对蓼红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59538,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其六","author":"释清远","text":"净名居士在家人，不二门深入者亲。\n一钵上方香积饭，寥寥千古转通津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59539,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其七","author":"释清远","text":"一与山门作境致，见者顿超无学地。\n二与后人作标榜，凡圣悟迷皆一样。\n若是丛林向上关，有人踏著喜无量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59540,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其八","author":"释清远","text":"少室无言语，曹溪有消息。\n可怜门大开，而人不能入。\n苍龙得云雨，猛虎生羽翼。\n但解自承当，何劳问知识。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59541,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其九","author":"释清远","text":"总记不得，天花满裓。\n纵有千言，不如一默。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59542,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其十","author":"释清远","text":"木伎机，石女儿。\n三冬阳气盛，六月降霜时。\n有语非干舌，无言切要词。\n会我最后句，出世少人知。\n午斋晨粥无馀事，笺茗炉香话道奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59543,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其十一","author":"释清远","text":"普光明殿在人间，凡圣交罗绝往还。\n若向一尘亲得见，毫光照处奉慈颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59544,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其十二","author":"释清远","text":"大众尽皆云集，僧堂横吞佛殿。\n露柱倒挂灯笼，天高地厚，月白风清。\n雨顺风调，河清海晏。\n饥则共君餐苦菜，渴则与子饮寒泉。\n直饶天外雨花飞，争似归堂吃茶去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59545,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其十三","author":"释清远","text":"台山路上，过客全稀。\n破灶堂前，感恩无地。\n雪埋庭柏，冰锁偃溪。\n虽在南方火炉头，不入他家齑瓮里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59546,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其十四","author":"释清远","text":"露柱多年出家，灯笼久已落发。\n佛殿坚持禁戒，三门近得休歇。\n大事本来平等无著，清凉满月度尽草木，丛林一似阳和齐发。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59547,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其十五","author":"释清远","text":"万物咸新论故乡，抬眸元是旧爷娘。\n先春花发馨香远，物外山河日月长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59548,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其十六","author":"释清远","text":"悟时此事元来易，迷后斯门实大难。\n处处绿杨堪系马，家家门口透长安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59549,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其十七","author":"释清远","text":"三月初三二月二，不坏假名谈大义。\n众生役役趁光阴，道流所以为虚弃。\n二月念九三月一，摩诃般若波罗蜜。\n假使多闻达古今，历劫何曾异今日。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59550,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其十八","author":"释清远","text":"如来妙色身，真实难藏覆。\n不挂本来衣，岂著娘生裤。\n无忧树下降生时，南北东西行七步。\n行七步，度尽众生无所度。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59551,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其十九","author":"释清远","text":"昨日如来垂法雨，今朝法雨洗如来。\n了然一味无差别，云外青山朵朵开。\n欲报如来深恩，殿上重新浴过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59552,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其二十","author":"释清远","text":"龙门结夏胜诸方，大地山河为举扬。\n若向九旬参得透，更无佛法可商量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59553,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其二十一","author":"释清远","text":"了知一，万事毕，释迦弥勒欣今日。\n但得心安是处安，无灾无难无今昔。\n要知佛法根源，记取五月初一。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59554,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其二十二","author":"释清远","text":"入得龙门事事奇，闻声见色不思议。\n山青水绿缘何事，尽是诸人力使之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59555,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其二十三","author":"释清远","text":"先师当年末后句，与人皮下挑出刺。\n譬如六月日中冰，销镕处处皆相似。\n后来听响各流传，更加一二与三四。\n个中孰是无耳人，明见去来不生死。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59556,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其二十四","author":"释清远","text":"世人尽道路行难，本分真金入火看。\n炼去炼来金体净，一槌打作玉栏干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59557,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其二十五","author":"释清远","text":"一竿一笠一蓑衣，急水滩头下钓丝。\n钩上锦鳞容易得，芦花深处月明归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59558,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其二十六","author":"释清远","text":"打动龙门鼓，唤起铁馂馅。\n请君一咬破，山僧岂相赚。\n先师曾得力，滋味今不减。\n若也不柰何，好个铁馂馅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59559,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其二十七","author":"释清远","text":"亲从家里来，家中何所有。\n持此一片石，广大坚且久。\n灵山曾献佛，帝释聊举手。\n心中出何物，安乐并长寿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59560,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其二十八","author":"释清远","text":"圆明了知，不由心念。\n抵死要道，堕坑落堑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59561,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其三十","author":"释清远","text":"拟思量，何劫悟。\n不思量，终莽卤。\n欲思不思踏破时，万里无云常显露。\n常显露，妙用恒沙非旦暮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59562,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其三十一","author":"释清远","text":"来来去去去来时，去去来来离觉知。\n了得去来无挂碍，方知尘劫不思议。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59563,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其三十二","author":"释清远","text":"遍界不藏全体露，丝毫有见事还差。\n会中谁是先陀客，不动纤尘便到家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59564,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其三十三","author":"释清远","text":"独自坐方信，西来有达磨。\n独自行不用，红莲足下生。\n独自语分明，向谁谁肯许。\n独自参刹刹，尘尘示指南。\n相逢相问穷端的，莫道山僧解放憨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59565,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其三十四","author":"释清远","text":"昔人已乘白云去，此地空馀绿水流。\n绿水一去不复返，白云千载空悠悠。\n湖南旧说老杨岐，失却金毛师子儿。\n江南江北无觅处，龙门今日顺风吹。\n顺风吹，啰啰哩，水急风高下钓矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59566,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其三十五","author":"释清远","text":"鸟从空里飞，人向心中住。\n人死心宛然，鸟没空何预。\n人生一过鸟，此心实可据。\n但自了其心，无劳问来去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59567,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其三十六","author":"释清远","text":"龙门别无奇妙，刚谓单传心要。\n岂惟浅水无鱼，拨剔全无孔窍。\n二时展钵开单，逐日屙屎送尿。\n万事与人一般，子细看来好笑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59568,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]