[{"title":"出汴过淮有作","author":"李弥逊","text":"十年犹愧饱侏儒，却到淮山识旧途。\n一棹轻于堂上芥，此身闲似水中凫。\n受风帆影随南北，弄日云容自有无。\n不用乘桴泛沧海，半生全欲老江湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60650,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"发桐庐","author":"李弥逊","text":"江尽溪流合，行舟落照催。\n棹歌来月浦，帆影上风桅。\n路转山容改，潮平水色回。\n兵戈满天下，飘泊壮心摧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60651,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"归自筠庄得似表弟晚步高字韵继和","author":"李弥逊","text":"一行作吏苦吹毛，小隐非关索价高。\n懒傍月边持玉斧，静看花上试霜刀。\n近人鱼鸟曾相识，入眼溪山昔未遭。\n谁与着鞭春色里，雁行风急正求曹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60652,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"未明出东门将入圣泉戏呈住山蒙庵老人","author":"李弥逊","text":"觌面峰峦碧障天，东方精色破昏烟。\n草头露下元无雨，衣角风生径欲仙。\n行树排宵高展画，孤云挂壑薄披绵。\n寸田暂喜捐尘虑，不着蒙庵一缕禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60653,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"瓜步阻风作 其一","author":"李弥逊","text":"西风趣秋去，何日放船回。\n不见澄江练，唯闻捲地雷。\n宦游双鬓改，飘泊寸心灰。\n落日乾坤里，微吟酒一杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60654,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"瓜步阻风作 其二","author":"李弥逊","text":"牢落穷途暮，扁舟水四涯。\n十年长作客，万里得还家。\n云散山排仗，潮生浪趁衙。\n殷勤谢风马，为挂一帆斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60655,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用陆元觐韵","author":"李弥逊","text":"自笑愚翁老一溪，鬓丝庭草共萋萋。\n愁边日永人思睡，花上春浓莺乱啼。\n十事未陈身已远，三钟无补首空低。\n年来灰冷人间念，惟有葵心日日西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60656,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"申伯坐上屡成佳语句独未见和德久贻信中之作次韵","author":"李弥逊","text":"得句情怀胜好官，敢穷笔力谩追攀。\n清新气味经三沐，煅炼工夫到九还。\n自是吟边有丘壑，不因行处在江山。\n凭君倚马移东道，为促金钗理鬓鬟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60657,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"节使少师王公挽诗 其二","author":"李弥逊","text":"晚岁闽江上，来从竹下贤。\n肯为文字饮，时访祖师禅。\n念旧藏遗墨，忘形出近编。\n忍倾一卮酒，挥泪对新阡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60658,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"节使少师王公挽诗 其一","author":"李弥逊","text":"家声许史旧，弱冠近天墀。\n权出诸公右，官嫌二品卑。\n多知缘好古，得句旧能诗。\n自怪文开后，风流有此儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60659,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"龙学许公挽诗 其二","author":"李弥逊","text":"晚起故园兴，柴车归鹿门。\n营家无立壁，爱客不空尊。\n丧乱长缨绝，悲凉旧剑存。\n不堪听楚些，无处可招魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60660,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"龙学许公挽诗 其一","author":"李弥逊","text":"粹德山藏玉，高标木秀林。\n三朝侍枫禁，列郡憩棠阴。\n文翰家声在，规模国计深。\n盖棺头正黑，空负济时心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60661,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丞相张公筑室湘江之上若欲远人间事尽心于山水之乐以奉寿母而末章以忠孝诏诸来者寓意深矣索诗寄之 其二","author":"李弥逊","text":"庭前兰玉走斑衣，堂上埙篪乐寿卮。\n永昼牙签纷简帙，深庭豹尾卧旌旗。\n笑谈自有江山助，勋业从来草木知。\n许国尚馀忠鲠在，此心还与岁寒期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60662,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丞相张公筑室湘江之上若欲远人间事尽心于山水之乐以奉寿母而末章以忠孝诏诸来者寓意深矣索诗寄之 其一","author":"李弥逊","text":"蕙櫋兰橑湿青红，衡岳湘江一望通。\n晓日云烟随几杖，春风花草近房栊。\n赤松未结忘机伴，绿野聊从避俗翁。\n更欲将心何处尽，山河全露妙明中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60663,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵叶成父尚书见留之什","author":"李弥逊","text":"山外孤云出寸岑，营巢其下一枝深。\n久从泛宅浮家伴，未遂穿云渡水心。\n百里跻攀方着屐，十年交旧欲分襟。\n西风落日非无恨，归卧桑榆惜寸阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60664,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵漳州邓教授二首 其二","author":"李弥逊","text":"十年猿鹤共萧萧，世事驱人肯见饶。\n老态岭云风更急，壮心炉篆日还销。\n催科政拙民犹病，禦侮才疏盗正骄。\n强拾陈言续清唱，却惭横槊按戎昭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60665,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵漳州邓教授二首 其一","author":"李弥逊","text":"绛帐初开识马融，尊罍聊共落新宫。\n三千避席方怀古，四十无毡独见公。\n尺璧未磨终可荐，兼金久炼要加功。\n男儿事业真堪戏，莫把行藏问塞翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60666,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仲宗许过我甚久一见便有去意戏用春字韵留之","author":"李弥逊","text":"麦秋数尽稻花春，六尺茅茨百懒身。\n散策崎岖聊永日，系舟剥啄定幽人。\n关心有念真形役，过眼无根俱客尘。\n肯着青鞋从我老，阿香径遣断归轮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60667,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仲宗访我筠溪出陪富文粹之游天宫诗见索属和次韵","author":"李弥逊","text":"作伴仙翁觅转春，净坊俱现宰官身。\n兰亭梦想如三月，莲社追游少一人。\n雨磴劳君鸣屐齿，风轩为我扫衣尘。\n应怜野老闻韶后，旋束蔬肠学练津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60668,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仲宗过筠庄作诗见招且有借庵之意次其韵","author":"李弥逊","text":"横山留我正青眼，不是归心久更微。\n病后团蒲随地隐，望中落木故园稀。\n一区已办云为盖，四壁但从山作围。\n不厌是中无一物，径来相就老禅扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60669,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"伟长知县奉议年兄作别十年邂逅于此复有数百里之隔以诗见寄辄次韵为谢","author":"李弥逊","text":"对着青衫下帝宸，十年不与并为仁。\n怜君卧困千金骨，笑我行摧四角轮。\n老眼相逢俱作客，新诸远寄底惊人。\n书来更数无多语，剩欲招携白水滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60670,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再用硕夫韵 其二","author":"李弥逊","text":"北窗攲卧风引裾，静看燕雀沿阶除。\n攀缘已断蚁旋磨，结习尚存鱼蠹书。\n一区未办扬雄宅，驷马不过渊明庐。\n苍松翠竹湖边趣，至乐岂在真知鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60671,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再用硕夫韵 其一","author":"李弥逊","text":"一丘一壑半生中，旁舍小儿见老翁。\n归来赋就晚径绿，醉时歌罢春灯红。\n壮心欲尽孤云薄，昨梦不留寒月空。\n茗盌粥盂能事毕，四三朝暮付狙公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60672,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再用粹中韵各赋牡丹梅花 其二","author":"李弥逊","text":"寒花入眼乱纷纷，高卧袁安雪塞门。\n春透交枝才照座，风摇断萼已飘村。\n返魂香细宁辞折，自暖杯深不待温。\n为约竹君同我老，交情此外更谁论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60673,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再用粹中韵各赋牡丹梅花 其一","author":"李弥逊","text":"曾倚沉香作好妆，竹篱茅屋肯深藏。\n天寒翠袖留空谷，岁晚长眉闭上阳。\n投辖尚能来好事，着鞭应恐并馀芳。\n广平赋罢诗肩瘦，不为梅花恼石肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60674,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再游龙潭","author":"李弥逊","text":"密雾开深径，幽奇得重行。\n水光沉树色，人语乱泉声。\n仙去山容寂，龙游雨阵轻。\n谁能筑云室，千古共凄清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60675,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"刘根道院","author":"李弥逊","text":"仙去久不返，遗宫仍倚嵩。\n终疑白云屋，犹隐绿毛翁。\n山晓水聚树，秋深霜影空。\n它年结庐地，千古想真风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60676,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同苏阮二公晚春游西溪 其二","author":"李弥逊","text":"唤客班荆杂乱言，雀罗成日罢张门。\n自缘贫病无过辙，可是疏慵不出村。\n阮子何人对青白，韦郎几日寄寒温。\n北枝留得瑶香在，更约文尊此地论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60677,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同苏阮二公晚春游西溪 其一","author":"李弥逊","text":"力破愁城觅醉乡，苏凫阮屐共行藏。\n解吟疏影思和靖，忍见夭红似洛阳。\n禅客缓催梅子熟，骚人正咏牡丹芳。\n酬花但促传杯手，冰炭君休置我肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60678,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"守风瓜步戏成","author":"李弥逊","text":"古语行船遇打头，此言端可作予羞。\n平生漫起江山兴，胜处偶为波浪留。\n败肉腐鱼三日醉，断芦衰柳十分秋。\n蒋陵秀色应凋尽，造物还能借便休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60679,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"成父居士于普光明堂之东别建大阁榜曰妙严将家焉阁成李子过而赋之","author":"李弥逊","text":"新成高屋碍云岚，下视诸方落二三。\n妙喜不从他界断，德云今向别峰参。\n按家便可超尘染，唤客何妨到酒酣。\n居士饱知名阁意，为言童子不须南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60680,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"早入昭亭与同游散步山中自樵径至水滨路穷还僧舍饭","author":"李弥逊","text":"散策春岗晓，樵苏一径长。\n钩衣藤挂石，断路水浮塘。\n山静竹生韵，池清兰自香。\n禅房得深憩，鱼鼓正鸣廊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60681,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"朴上人访筠翁于筠溪草堂袖诗为赠雨中告别将有雁荡之行屡挽不肯留索诗甚急以偈送之","author":"李弥逊","text":"一壑翛然听雨眠，君来着语破云烟。\n肯随鸥狎清江上，欲趁鸿飞白日边。\n童子不应多一指，学人正自少三拳。\n急行啖蔗逢佳境，春笋出林啼杜鹃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60682,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵子才曹溪道中","author":"李弥逊","text":"偶脱尘缨百虑宽，更穷目力快遐观。\n旋谋浊酒招强伴，行拾落英供晚餐。\n树拥山根张密幄，云随雨脚是惊湍。\n试追健笔难何似，倒策驽骀上石峦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60683,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵公晔席上见赠即席和之","author":"李弥逊","text":"酒边着语见真情，收拾应须遣六丁。\n戢戢瓮头堪一醉，栖栖泽畔忍长醒。\n汤盂茗椀香中泛，药圃蔬畦烛下经。\n漏尽却随江月去，舞鸥迎我过寒汀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60684,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵天宁通老见贻","author":"李弥逊","text":"病馀真是独醒人，还在僧窗自在身。\n竹杖芒鞋寻胜趣，斋盂禅板悟前因。\n江山臭味如相觅，猿鹤家风愿卜邻。\n更有高人来着语，交游不怕白头新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60685,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵王彦声赠梅公择","author":"李弥逊","text":"诗梅傲世独深居，气与孤云共捲舒。\n客辙每逢樽有酒，剑歌休叹食无鱼。\n鲸波坐隔三山外，鹏翼终腾万里馀。\n冠玉围金真戏事，醉髯聊复一轩渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60686,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵叶成甫有怀见寄","author":"李弥逊","text":"来辕去棹亦劳劳，晚岁丘园避俗陶。\n问事不知三语掾，阅人无意九方皋。\n交论金石穷犹见，诗得江山老更豪。\n清梦总能追蜡屐，雨声偏傍夜床高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60687,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵叶硕夫南归见贻 其一","author":"李弥逊","text":"未挂丹题雁塔中，重来溪上觅筠翁。\n相期老眼横摇碧，莫着征衫走软红。\n得失漫嗟蝉翼重，才名合见马群空。\n三年小试惊人手，未信朱衣也不公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60688,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵平仲侍郎移居见简","author":"李弥逊","text":"不寄斜封岁已馀，那闻异县更移居。\n羁怀易动野马也，归梦自成胡蝶与。\n有宅一区如子少，受薪十束见予疏。\n摇知富有千头橘，奉乞当年种树书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60689,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵似表弟春雨漫成","author":"李弥逊","text":"百念关身起猬毛，雨声偏近夜床高。\n正愁春事趁奔鹿，更觉归心折大刀。\n拥鼻吟边聊且遣，枕肱佳处亦时遭。\n曲生怀抱肯倾倒，一酌忘忧赖尔曹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60690,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵毕裕之喜雨","author":"李弥逊","text":"急雨翻盆破郁蒸，疏檐冰簟正关情。\n维摩示疾原非病，庾信裁诗老更清。\n游戏云生春浪势，吉祥风动夜潮声。\n麦秋未饱千畦润，更遣丰隆为一行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60691,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵邦直通判少尹题普现堂见简之作","author":"李弥逊","text":"饱知世路厌陈人，分得僧窗寄此身。\n载月笋舆成独往，缘云藜杖与谁亲。\n足间优钵藏千界，掌上庵摩等一尘。\n赖得诗翁来着语，五松从此有知津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60692,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵旸叔见示伽陀","author":"李弥逊","text":"无形何用强安名，只么腾腾信脚行。\n一事到头犹是幻，万缘何处可留情。\n云归夜壑空难状，月落秋江影自生。\n唯有庞家老居士，不将尘境碍虚明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60693,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵李丞相送行二首 其二","author":"李弥逊","text":"山畔孤亭一水滨，归来华发已欺人。\n脱身异县干戈地，得意吾庐笋蕨春。\n早着青衫成底事，惯遭白眼欲谁亲。\n此君真有高人节，肯与山翁作近邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60694,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵李丞相送行二首 其一","author":"李弥逊","text":"三年袖手卧江滨，着眼终成出世人。\n笔下风云作时雨，胸中丘壑作阳春。\n买山尘外曾相见，漉酒愁边情更亲。\n惜取风骚等闲句，他时密膝咏臣邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60695,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵李伯纪丞相游贤沙凤池之作 其二","author":"李弥逊","text":"几日公来浴凤池，蹇驴陪乘偶参差。\n羁栖自笑卧盘谷，健句争先诵渼陂。\n世路吹齑无念到，山游啖蔗不言知。\n紬书倘遂云根筑，肯与酸寒郑老期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60696,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵李伯纪丞相游贤沙凤池之作 其一","author":"李弥逊","text":"骑鲸破晓上崔嵬，人识仙翁第一回。\n杖屦不应尘外去，旌麾早自日边来。\n黑头半为忧时改，青眼唯逢胜地开。\n怪底尺书频寄雁，向来交味比陈雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60697,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵苏粹之发干见赠 其二","author":"李弥逊","text":"漂泊音书断，艰难会合迟。\n那知休老地，却数别君时。\n岁晚商山寂，天寒楚水悲。\n无言一杯酒，怀抱各相知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60698,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵苏粹之发干见赠 其一","author":"李弥逊","text":"颓龄知有几，谁复问行藏。\n散策苍林静，抛书白昼长。\n相呼山鸟聚，自落涧花香。\n此地无车马，真成物我忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60699,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵邵旸叔秋日怀归","author":"李弥逊","text":"天将物色助诗鸣，秋入吟肩句倍清。\n欲为鲈莼修故事，喜闻鸿雁寄先声。\n脱身鞅掌谋须早，过眼纷华梦已成。\n他日柴桑许同社，为君漉酒具南烹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60700,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵陆虞仲学士涂中咏雪 其二","author":"李弥逊","text":"岁行去似客程兼，诗债新随雪阵添。\n唱绝郢人誇洁白，舞低赵女斗轻纤。\n寒威瑩骨胜三沐，爽气薰心解六黏。\n险语赓酬难自勉，旋乾吟笔尽更签。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60701,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵陆虞仲学士涂中咏雪 其一","author":"李弥逊","text":"可笑无毡老郑虔，甘寒忍喜咏丰年。\n飞花穿树春疑早，秀麦分岐瑞有先。\n白玉楼成迷万井，青云路绕认双川。\n轻缣窘幅终难状，却借骚人好句传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60702,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵陈君实先生 其二","author":"李弥逊","text":"骑马长安漫踽凉，几番桃李艳晨妆。\n目官厌阅是非海，心地不闻知见香。\n九转未能超北陆，一廛终待老南塘。\n会令坚白消同异，世事秋棋玉石忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60703,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵陈君实先生 其一","author":"李弥逊","text":"阅世端如木偶人，不须离妄始逢真。\n功深夜鼎三时火，候转秋河万里银。\n可笑侏儒空饱粟，犹怜痀偻解凝神。\n他时应见鞭鸾凤，老去浮藜不夜辰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60704,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵陈泰定见赠 其二","author":"李弥逊","text":"偶语无人且复吞，昼晴饶睡憩榕根。\n鸟鸣幽谷何妨静，花发深林只自繁。\n逸思共怜居有竹，清阴谁伴酒盈尊。\n非关兴尽回船急，剥啄那知客至门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60705,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵陈泰定见赠 其一","author":"李弥逊","text":"月魄哉生望已几，豪华未厌老相随。\n放疏世故开黄卷，销尽尘心对紫芝。\n急雨知寒催叶落，断云乘晚截山低。\n小槽早作酬春计，又是梅花结蕊时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60706,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵陈颖仲晚步见山","author":"李弥逊","text":"青鞋布袜绕江湄，矫首山房送日西。\n小榼留人灯下觅，短筇邀我醉中携。\n峰峦过雨新涂泽，草木逢春自品题。\n投老归来同逆旅，好于此地斸愚溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60707,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵陈蹈元见和之作","author":"李弥逊","text":"漫逐江鱼吊楚臣，风骚今见出吾闽。\n遗音思远冰霜淡，味语功深脍炙珍。\n一壑我曹方税驾，九霄公等政推轮。\n屏除堆案痴儿事，肯着青鞋伴散人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60708,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵和韩知刚见贻之什","author":"李弥逊","text":"半生宦牒绊闲身，老惜跳丸过眼频。\n独笑真成当去客，相逢同是异乡人。\n静中着语已多事，熟处忘情久自亲。\n他日君来序盘谷，岩花溪竹是知津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60709,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵季申枢密万象亭","author":"李弥逊","text":"丈人手笔与仙通，点化虚无若转蓬。\n妙寄千言千嶂外，全收万象一檐中。\n深堂细篆观澄水，落日危栏数去鸿。\n更压小槽囊古锦，共临高处待春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60710,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵学士兄桐庐道中","author":"李弥逊","text":"溪水抱山曲，轻舟趁落霞。\n烟尘多战垒，冠盖半浮家。\n紫塞空归翼，黄河绝去槎。\n从谁论此事，心折莫云赊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60711,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]