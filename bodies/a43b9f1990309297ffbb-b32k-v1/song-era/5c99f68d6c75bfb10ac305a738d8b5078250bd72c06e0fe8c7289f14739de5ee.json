[{"title":"和奇父叔夏雪五首 其五","author":"胡寅","text":"善游不必慕阎敖，避雨休寻夏后皋。\n共喜九天羲驭整，要登千仞祝融高。\n交情自分居龙尾，酒算何妨剧猬毛。\n闻道雷池尚残雪，且携茗碗罢壶醪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42146,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和奇父叔夏雪五首 其四","author":"胡寅","text":"乍霁初离房与敖，又看云气压神皋。\n昆冈屡得因心友，东郭真惭举趾高。\n最爱谢儿方柳絮，可怜汉使齧毡毛。\n水晶盐是何人得，拜赐曾同御缥醪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42147,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和奇父叔夏雪五首 其三","author":"胡寅","text":"懒把冬雷问告敖，休将玉雪试方皋。\n但惊梁苑风流在，难继阳春格调高。\n宫女妆梅皆妒色，仙山花石总泠毛。\n自惭涸思无多子，糟粕何由更取醪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42148,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和奇父叔夏雪五首 其二","author":"胡寅","text":"谁能逐兽搏于敖，敏捷诗才笑鲁皋。\n桂魄梅花俱自好，海山银阙两相高。\n回风最爱翻双袖，润物全胜拔一毛。\n打底和成真少味，空惭清酎映甜醪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42149,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和奇父叔夏雪五首 其一","author":"胡寅","text":"不须十日照胥敖，且要仙花丽隰皋。\n集霰果然归望望，同云因得蔽高高。\n辉山玉璞韬虹气，乱眼烟霄隘羽毛。\n欲叩小斋拚醉赏，最怜纤玉劝持醪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42150,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和范元作二首 其二","author":"胡寅","text":"仇虏何须杀，调和乃妙机。\n又闻坚誓约，不用讲攻围。\n六月鹏南徙，三春雁北归。\n自知同斥鴳，蓬艾且卑飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42151,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和范元作二首 其一","author":"胡寅","text":"江北风尘静，江南水竹居。\n世交论契厚，岁晚莫情疏。\n斸雪重培菊，临溪易买鱼。\n潇湘有旧约，相就不投书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42152,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和信仲喜雨二首 其一","author":"胡寅","text":"云汉吁嗟堕杳冥，德音雷动走群灵。\n天心自契犠牲祷，田畯先闻黍稷馨。\n帘捲西山增爽气，水通南涧漫平汀。\n一篇可嗣东坡记，北榭今成喜雨亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42153,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和信仲喜雨二首 其二","author":"胡寅","text":"天公知我亦顽冥，不许山川借宠灵。\n何事民谣为膏泽，祇因君德荐明馨。\n楩楠未厌云迷谷，鸥鹭初便水满汀。\n试揽秋光澄北榭，千峰争翠岌岩亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42154,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和宣风寺壁间韵","author":"胡寅","text":"客梦到何许，南山桃李园。\n未能忘蜡屐，何意谒金门。\n愿举汉三杰，尽戡周陆浑。\n虎皮包剑戟，农务看村村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42155,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和彦冲云际院留题","author":"胡寅","text":"久闻幽寺渺云间，且向新诗见一斑。\n不羡宝华承白足，最怜澄水漾秋山。\n飞车要度重重岭，系艇还思浅浅湾。\n弹指大千何远近，却将游想付无还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42156,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和彦冲茉莉二首 其二","author":"胡寅","text":"谪堕天仙子，生憎袨服妆。\n华云油泼碧，花雪麝开香。\n晒喜金鸦热，洗宜玉井凉。\n芳根如可乞，携取诧娥湘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42157,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和彦冲茉莉二首 其一","author":"胡寅","text":"易刻无瑕玉，难匀不汗妆。\n有谁同素绚，无物比生香。\n宝靥三年笑，冰肌六月凉。\n畹兰何足佩，怀瑾枉沉湘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42158,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和彦冲晚饮","author":"胡寅","text":"北涧霜翻浪，南山翠竹堆。\n早酣随梦断，晚酌傍池开。\n莫放清欢阙，从教急管催。\n精深与雄健，剩欲见天才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42159,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和彦达","author":"胡寅","text":"扶藤有兴即东西，不用花骢向月啼。\n閒看浮云倚危峤，静临流水瞰寒溪。\n过频幸乐鸡豚社，归暮何忧虎豹蹊。\n肯似世尘名利客，班荆折柳怅分携。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42160,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和彦达九日","author":"胡寅","text":"满头黄菊斗芳妍，人与秋光两静便。\n试把杯觞论旧日，未须筋力较明年。\n诗惭戏马台头客，目断归鸿渚上天。\n更愧白衣能送酒，坐令彭泽意空传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42161,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和彦达至日木冰","author":"胡寅","text":"千林木稼苦低垂，惟有长松不受欺。\n兰雪方怀萧悫句，河冰还读鲍昭诗。\n卧闻写竹惊残梦，戏折寒枝调小儿。\n寄语达官不须怕，勉旃戈甲渡淮师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42162,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和彦达过先公旧居有感","author":"胡寅","text":"论文敩学两髫年，访旧同来雪上颠。\n我步鲤庭心欲折，公登龙坂足何缘。\n后凋尚喜无双士，不韡真惭大少连。\n桂楫又浮湘水去，家山回首共悽然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42163,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和彦达落梅","author":"胡寅","text":"为问东风有底忙，吹成疏雪洒林塘。\n应知剩馥归香骨，谁拾残英试粉妆。\n安得反魂三折臂，漫披能赋九回肠。\n枝间赖有青青子，不遣行人折过墙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42164,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和洪秀才八首 其八","author":"胡寅","text":"闻说频频党，深遵秩秩猷。\n题评归月旦，裁鉴比阳秋。\n赋谢雕虫手，诗通美盼眸。\n看君多直谅，端似汉朱游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42165,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和洪秀才八首 其七","author":"胡寅","text":"有烦推后觉，未克继先猷。\n痼疾资医缓，心专慕弈秋。\n远游方策足，参倚在凝眸。\n更仗磋磨力，时时警惰游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42166,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和洪秀才八首 其六","author":"胡寅","text":"鄙人闻道晚，何以播芳猷。\n未就三年刻，还惊一叶秋。\n论交无白足，对客有青眸。\n之子怀仙趣，相期汗漫游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42167,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和洪秀才八首 其五","author":"胡寅","text":"栽花为事业，种秫是谋猷。\n不羡两蜗角，从教双鬓秋。\n登楼山抹黛，垂钓水澄眸。\n此乐应谁侣，雩风昔从游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42168,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和洪秀才八首 其四","author":"胡寅","text":"于今闻议论，自昔际风猷。\n劲柏君凌雪，衰蒲我望秋。\n读书钦满腹，歌舞倦回眸。\n岂但人称善，无惭马少游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42169,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和洪秀才八首 其三","author":"胡寅","text":"爱酒希元亮，敲门重子猷。\n孤松将秀岭，万竹已摇秋。\n懒去手搔发，兴来书映眸。\n此生当皎皎，毋作梦中游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42170,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和洪秀才八首 其二","author":"胡寅","text":"自昔超群者，无非远大猷。\n要令心似镜，莫遣气横秋。\n末学多墙面，深窥异瞽眸。\n君看颜氏子，何以过商游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42171,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和洪秀才八首 其一","author":"胡寅","text":"杖策纷纷是，谁能志大猷。\n觕衣与粝饭，长夏及清秋。\n辩论轻三耳，斋明见两眸。\n圣门多要妙，文艺不须游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42172,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和赵生二首 其二","author":"胡寅","text":"冠月裾云佩绿霞，百年将此送生涯。\n愁心别后无诗草，病眼灯前有醉花。\n落笔擅场聊写意，背山临水遂成家。\n也须南亩多栽秫，休似东陵只种瓜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42173,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和赵生二首 其一","author":"胡寅","text":"遍游南北与西东，欲访人间国士风。\n处世甚疏皆笑我，宅心无累独奇公。\n诗才自愧非三上，酒圣相从又一中。\n芍药待开应且住，莫令清赏转头空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42174,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和赵荣州","author":"胡寅","text":"兵戎暌隔几春秋，又向南州话北州。\n一饭识君尘外趣，三川回首梦中游。\n可堪丽藻相华宠，自断沉疴合罢休。\n安得卜邻如二老，杖藜来往亦风流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42175,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和郡将劝农","author":"胡寅","text":"仁政惟敦本，躬行岂好夸。\n舞停衫飏雪，盘藉绮如霞。\n童马争骑竹，村厖息吠花。\n向来观馌地，和气满家家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42176,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和钟漕汝强四首 其四","author":"胡寅","text":"云自高閒水自深，此间谁契不传音。\n倦飞偶作归田赋，高卧时为梁甫吟。\n为己宫墙当独诣，过门车马肯相临。\n惟公知我迂愚甚，枉直何曾较尺寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42177,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和钟漕汝强四首 其三","author":"胡寅","text":"风日薰薰草树深，黄鹂迁木送新音。\n有怀春服成雩咏，遥想青山伴醉吟。\n诗老幽栖虽地僻，圣君高拱正天临。\n未须静处论方药，会见蒲轮远访寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42178,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和钟漕汝强四首 其二","author":"胡寅","text":"丈人爱客酒杯深，更和南山白石音。\n大户不知濡首节，逸才应笑撚髭吟。\n箴规有过风雷益，儆策无穷地泽临。\n每忆向来谈宴处，桃花流水路难寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42179,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和钟漕汝强四首 其一","author":"胡寅","text":"雾豹成文不厌深，喧卑何事竞翰音。\n为言墨客誇三赋，那似仙翁振八吟。\n欲继高踪其敢后，下看浮世岂须临。\n何时蜡屐携筇杖，来拨衡云一万寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42180,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和唐坚伯留题庄舍 其二","author":"胡寅","text":"卧看月落半瑶环，起唤清风紫翠间。\n玩意诗书千古乐，放怀天地一身閒。\n几多倦鸟归何晚，无限浮云去未还。\n不向此中真得趣，更论盘谷与商颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42181,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和唐寿隆上元五首 其五","author":"胡寅","text":"几年踪迹远中台，梦想传柑宴斝开。\n懒拥牙旗穿市去，纵看玉李堕天来。\n从教独照青藜炬，莫使轻吹画角梅。\n也有江风浮綵巘，坐令形势卷东莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42182,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和唐寿隆上元五首 其四","author":"胡寅","text":"山褰云色暗阳台，俄复晨曦万里开。\n行雨忽随新梦断，春风还似故人来。\n精神总属陶潜柳，燮理须归傅说梅。\n已共此邦同乐岁，更须躬稼辟田莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42183,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和唐寿隆上元五首 其三","author":"胡寅","text":"名章络绎走陪台，得对春风一笑开。\n楼外未知明月出，袖中疑有夜光来。\n秀如王子登门竹，味胜曹公止渴梅。\n已向歌谣挹和气，预知丰稔变污莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42184,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和唐寿隆上元五首 其二","author":"胡寅","text":"明月升天镜上台，灯如莲沼万枝开。\n恨无立部歌仍舞，空有游人往更来。\n续法未能窥佛祖，赓歌聊得继欧梅。\n壮心消尽嬉游兴，矧复斑衣怅老莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42185,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和贾阁老三首 其三","author":"胡寅","text":"西云十日结重阴，葵箑桃笙自不禁。\n书帙有缘灯耿耿，酒杯无伴雨沉沉。\n君恩未报空怀禄，民瘼难医只愧心。\n为问野麋何处好，莺鸣雕槛隔长林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42186,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和贾阁老三首 其二","author":"胡寅","text":"来朝杲日破顽阴，共指秋成喜不禁。\n寸碧遥岑供眺望，长空飞鸟自消沉。\n四时景物千钟酒，万古功名一寸心。\n尚愧先生游佛海，两忘轩冕与山林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42187,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和贾阁老三首 其一","author":"胡寅","text":"新柳逢秋叶尚阴，晚莲披露色难禁。\n坐听玉屑轩犀麈，静对山炉飏水沉。\n绿酒浅深皆有味，白云来去本无心。\n辱公丽藻相留句，且复追随翰墨林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42188,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和贾陶二老二首 其二","author":"胡寅","text":"节物匆匆度，边烽幸不传。\n名花空雨堕，秀树已云连。\n孤负杯莲倒，萧条烛蕊偏。\n但欣民小泰，凝寝有炉烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42189,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和贾陶二老二首 其一","author":"胡寅","text":"已愧名邦忝，仍无秀句传。\n花光随处好，草色与愁连。\n讼少庭常寂，心閒地更偏。\n先生肯乘兴，一醉赏风烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42190,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和黄执礼六首 其六","author":"胡寅","text":"文才久合步蟾宫，未肯争抟九万风。\n剩欲论诗宗典乐，故应怜我隶司空。\n高山宛在绿琴里，白发从多清镜中。\n要识起予真赏意，圣门千古望龟蒙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42191,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和黄执礼六首 其五","author":"胡寅","text":"尚德南宫勇北宫，羡君兼有古人风。\n无双自昔称江夏，第一于今鄙解空。\n会友更求三以上，策名应簉二之中。\n须惭颣语赓黄绢，但可厨人作酱蒙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42192,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和黄执礼六首 其四","author":"胡寅","text":"律吕旋相六十宫，声如佳句比南风。\n自非诗印全提得，难使言瑕一洗空。\n已向襟灵窥致远，更从彪炳见弸中。\n读书有益非虚语，请看孙权与阿蒙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42193,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和黄执礼六首 其三","author":"胡寅","text":"浮生均是大槐宫，永日聊便竹簟风。\n若要语言求要妙，犹将笔墨画虚空。\n一区聊寄尘嚣外，万景皆归眺望中。\n敢似越鸡孵鹄卵，正惭云将问鸿蒙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42194,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和黄执礼六首 其二","author":"胡寅","text":"赐墙那及仲尼宫，妄意坚高立下风。\n志士有求虽汲汲，鄙夫无得漫空空。\n诗鸣寡学安能善，酒圣多愁讵敢中。\n惟赖有朋想博约，过情之誉岂宜蒙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42195,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和黄执礼六首 其一","author":"胡寅","text":"税得东家一亩宫，向来喧市马牛风。\n誓将尤悔加深省，肯为饥寒叹屡空。\n十里溪山愁眼外，数家梧竹画屏中。\n惠然更感无双子，时有高谈发蔽蒙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42196,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和黄秀才","author":"胡寅","text":"羹藜饭糗自无馀，身世萧条亦自如。\n十里溪山连枕席，一堂风月伴琴书。\n畹兰幸袭仙人佩，径草欣承长者车。\n四海弟兄非浪语，先生何恨九夷居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42197,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和曾漕吉甫","author":"胡寅","text":"本来秋月映澄潭，墙面犹须学二南。\n径路枉寻难直尺，卮言暮四等朝三。\n文如楮叶何劳刻，道在蒲团恐费参。\n玉帛雍雍王会处，禹宫惆怅一精蓝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42198,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和路枢四首 其四","author":"胡寅","text":"进退行藏合道枢，讵分廊庙与江湖。\n愿陪东阁留宾后，定向南山卜宅无。\n不为避喧邻懒瓒，祗缘尝药访臾区。\n勉搜累句酬高韵，端似无盐簉子都。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42199,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和路枢四首 其三","author":"胡寅","text":"林壑苍茫渺一涯，辱公词藻借光华。\n大声岂直金投地，清梦悬知笔有花。\n不似罢兵初度岭，应同奏疏早名家。\n曳裾未惬平生志，常恐追锋侍绛纱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42200,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和路枢四首 其二","author":"胡寅","text":"前筹初见翊元枢，何事扁舟泛五湖。\n脱屣红尘谁肯办，挂冠黑发世应无。\n愿陪几杖登南阜，遥想氛埃暗北区。\n晚节功名端不免，云台依旧矗天都。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42201,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和路枢四首 其一","author":"胡寅","text":"图书虽是旧生涯，翰墨那能掞国华。\n戏綵便甘辞五马，退朝犹想覆千花。\n先民事业高三代，将圣春秋自一家。\n他日登门谢佳句，剧谈当许岸乌纱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42202,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和蔡生迁居二首蔡学佛故用杜老与赞公故事蔡常令一妪持简来 其二","author":"胡寅","text":"一壶村酒要同尝，脯醢菹肴取次将。\n谈话翠微修竹径，追随斜照晚风冈。\n梅花淡淡传春意，柳色依依作岁阳。\n只么往来成乐土，岂知身世落南荒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42203,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和德施赏金沙","author":"胡寅","text":"笼纱未暗尘，锦幄又经春。\n有艳晓酣酒，无言时恼人。\n后先争绚倩，开落自仍频。\n相对长松树，香心结蕊新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42204,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜大风雪次日快晴","author":"胡寅","text":"造物非难料，寒温本一家。\n冲风来雨雪，暖日放莺花。\n行矣春方嫩，悠哉兴未涯。\n芦蒿媚烟渚，荻笋破江沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42205,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"治园二首 其二","author":"胡寅","text":"莱菔瑶英体，芜菁翠羽丛。\n压黄千叶韭，竞秀一畦葱。\n渰渰金茎露，翻翻玉宇风。\n不忘藏聚力，醯酱有无同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42206,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"治园二首 其一","author":"胡寅","text":"涉圃亲锄草，分畦剩种蔬。\n润通邻沼近，色映野云虚。\n瘴重难求药，心閒易看书。\n但令羹有梜，那叹食无鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42207,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绍兴壬子六月先公再被掖垣之命某时侍行自清江登舟经祖印江口趋行在所未几罢归还憩丰城之龙泽寺明年初夏归隐南山己巳岁予偶游祖印留宿寺僧惠嵩能道昔寓龙泽之梗概两寺相望盖五十里时先公没十有二年矣予亦衰病投绂俯仰悲慨因成两诗以遗嵩 其二","author":"胡寅","text":"车骑纷来去，帆樯竞溯沿。\n云閒天淡淡，江静竹娟娟。\n耻学飞腾术，慵参寂灭禅。\n春风常满意，无处不怡然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42208,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绍兴壬子六月先公再被掖垣之命某时侍行自清江登舟经祖印江口趋行在所未几罢归还憩丰城之龙泽寺明年初夏归隐南山己巳岁予偶游祖印留宿寺僧惠嵩能道昔寓龙泽之梗概两寺相望盖五十里时先公没十有二年矣予亦衰病投绂俯仰悲慨因成两诗以遗嵩 其一","author":"胡寅","text":"云归龙泽寺，风引墨池船。\n谁识行藏妙，空惊岁序迁。\n从行矜壮齿，抚事叹华颠。\n约略人间世，耆僧亦怃然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42209,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]