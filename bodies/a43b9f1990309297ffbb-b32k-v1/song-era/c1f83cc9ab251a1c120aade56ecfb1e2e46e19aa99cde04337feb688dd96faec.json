[{"title":"题明觉寺在在堂十二首 其五","author":"舒亶","text":"一溪高自扑岩来，寺在岩腰水抱回。\n林下老僧相顾笑，柴门今始为君开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2589,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题明觉寺在在堂十二首 其四","author":"舒亶","text":"断桥高下路横斜，隔水人烟四五家。\n雨后一枝红带雪，风流不道有岩花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2590,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题明觉寺在在堂十二首 其三","author":"舒亶","text":"沙溪过雨半清浑，径石高低带雪痕。\n又见山农话春事，腰镰两两唤儿孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2591,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题明觉寺在在堂十二首 其二","author":"舒亶","text":"风吹雨脚细于丝，泠暖浑如寒食时。\n不待千山消尽雪，小红已到杏花枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2592,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题明觉寺在在堂十二首 其一","author":"舒亶","text":"不管霜毛不贷人，一年旧了一年新。\n山窗未晓闻山乐，可是梅花漏世春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2593,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题宝林院琼阇黎房","author":"舒亶","text":"山农未用踏沟车，一穴灵泉荫万家。\n香积从今饱檀施，会看讲夜落天花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2594,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题法喜院是院一瓦一木皆自能师手而师丈室惟布衾木枕无复长物即之坐庞眉皓顶泊然似不能言者无乃真有道者耶 其二","author":"舒亶","text":"了无情解作攀缘，一钵三衣只兀然。\n坐对青山不知老，学人休问祖师禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2595,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题法喜院是院一瓦一木皆自能师手而师丈室惟布衾木枕无复长物即之坐庞眉皓顶泊然似不能言者无乃真有道者耶 其一","author":"舒亶","text":"抱山重屋两回廊，杉桧如云百尺长。\n香火它年谁第一，老师辛苦顶如霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2596,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题崇福禅院二首 其二","author":"舒亶","text":"龛灯隐隐夜初分，落果猿啼枕上闻。\n客梦欲成成不得，一窗残月半床云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2597,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题崇福禅院二首 其一","author":"舒亶","text":"一峰傍倚两山朝，云里龙孙响佩瑶。\n长与幽人发高兴，不辞雨雪过溪桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2598,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题福胜院","author":"舒亶","text":"苍岩赤壁耸崎嵚，长者何年为布金。\n却忆樵风生乳窦，万松回合两龙吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2599,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"含珠林","author":"舒亶","text":"何代神僧机匠深，手栽珠树作珠林。\n狞龙离穴颔初凿，老蚌出泥光易寻。\n海近鲛人工迸泣，山深木客费愁吟。\n开窗夜半不成寐，明月时时照我心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2600,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和马粹老四明杂诗聊纪里俗耳十首 其十","author":"舒亶","text":"莲阁红堪掣，兰池静不流。\n梯航纷绝徼，冠盖错中州。\n草市朝朝合，沙城岁岁脩。\n两前茶更好，半属贾船收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2601,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和马粹老四明杂诗聊纪里俗耳十首 其九","author":"舒亶","text":"佛磬云中寺，樵歌郭里湖。\n城居荫杨柳，野寇息萑蒲。\n巫语传杯珓，渔蓑入画图。\n幽香满花谷，不趁雪霜枯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2602,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和马粹老四明杂诗聊纪里俗耳十首 其八","author":"舒亶","text":"禽孝传居俗，风痴动浃旬。\n灵鳗旱天雨，圣米歉年莼。\n江涨长如海，冬温恰似春。\n鸡豚追伏腊，行路亦情亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2603,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和马粹老四明杂诗聊纪里俗耳十首 其七","author":"舒亶","text":"稻饭雪翻白，鱼羹金斗黄。\n鲒埼千蚌熟，花屿一村香。\n海近春蒸湿，湖灵夜放光。\n北窗休寄傲，大隐即吾乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2604,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和马粹老四明杂诗聊纪里俗耳十首 其六","author":"舒亶","text":"岁熟禾论?，人归夜击钟。\n金澄沙底水，龙卧井边峰。\n香火常存社，渔盐每夺农。\n年来缣帛贱，砧杵万家舂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2605,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和马粹老四明杂诗聊纪里俗耳十首 其五","author":"舒亶","text":"巷陌随桥曲，闾阎占水穷。\n郡楼孤岭对，市港两潮通。\n春暖鸡鸣岙，秋寒鸭信风。\n家家人富足，击壤与吾同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2606,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和马粹老四明杂诗聊纪里俗耳十首 其四","author":"舒亶","text":"箔蚕迎豆熟，江雪伴梅消。\n抵虎螯经夏，跳沙蛤趁潮。\n酒罂双印贵，药肆万金饶。\n未觉西风远，三溪好采樵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2607,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和马粹老四明杂诗聊纪里俗耳十首 其三","author":"舒亶","text":"御史平囚日，郎中渡母年。\n丰碑推笔妙，孤冢枕城偏。\n白鹤空寥泬，黄蒿尚蔓延。\n九原如可作，执驭故忻然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2608,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和马粹老四明杂诗聊纪里俗耳十首 其二","author":"舒亶","text":"澄水铺千练，平山伏万犀。\n月桥莲棹小，春圃酒旗低。\n蓬岛云长在，桃源客不迷。\n风流未寂寞，游屐半香泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2609,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和马粹老四明杂诗聊纪里俗耳十首 其一","author":"舒亶","text":"百粤喧哗外，三江指顾中。\n耕桑遗俗在，草木故城空。\n近泽知田美，多鱼验海丰。\n由来形势地，越绝控辽东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2610,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和石尉早梅二首 其二","author":"舒亶","text":"依然想见故山傍，半倚垣阴半向阳。\n短笛楼头三弄夜，前村雪里一枝香。\n可能明月来同色，不待东风已自芳。\n幸免杜郎伤岁暮，莫辞吟对钓渔乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2611,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和石尉早梅二首 其一","author":"舒亶","text":"霜林尽处碧溪傍，小露檀心媚夕阳。\n天下三春无正色，人閒一味有真香。\n相思谁向风前寄，趁早先从雪后芳。\n朝夕催人头欲白，故园正在水云乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2612,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和刘谊翁留题惠安二首 其二","author":"舒亶","text":"十里松行翠插天，暗溪嫩草尚芊绵。\n笙歌自满萧郎宅，琴鹤空随贺老船。\n未分旧游云寂寞，遥知归梦蝶联翩。\n故山幸好宜回首，还见人间换一年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2613,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和刘谊翁留题惠安二首 其一","author":"舒亶","text":"坞云过雨翠成堆，天淡平湖一鉴开。\n万木号风韵丝竹，千峰带月上池台。\n静无俗驾金铺地，閒有高人玉满杯。\n闻道碧桃看欲发，刘郎何事不归来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2614,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和西湖即席二首 其二","author":"舒亶","text":"十洲风籁韵笙箫，疑有仙人燕碧桃。\n影逼银河星半堕，气吞月窟兔争豪。\n九秋波浪沙鸥狎，万古声名钓艇高。\n却恨何须明似镜，空令志士泣霜毛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2615,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和西湖即席二首 其一","author":"舒亶","text":"金碧楼台阁暮烟，彩虹双影卧漪涟。\n云铺物外无尘地，月满人间不夜天。\n细柳千门维画舸，华灯两岸度鸣弦。\n清狂亦有黄冠客，不负仙人载酒船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2616,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和西湖即席三首","author":"舒亶","text":"四明太守爱西湖，想像桃源旧日图。\n不放尘埃生水面，为传风月到皇都。\n花开别屿千机锦，稻熟僯田万斛珠。\n闻说儿童骑竹马，至今昂首望通衢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2617,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和游栖真寺见寄","author":"舒亶","text":"曾是谈经一草堂，千年金碧欲飞飏。\n顶峰有路青天近，绝壑无尘赤日凉。\n月底露惊猿鹤梦，云中风动薜萝香。\n芝?茶灶平生念，遥谢仙人白羽觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2618,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和新开西湖十洲之什","author":"舒亶","text":"洗出烟华紫翠匀，再将绝景付重闉。\n千山有影螺垂地，一水无尘镜照人。\n香溅钓筒萍雨夜，绿摇花坞柳风春。\n杖藜尽日沧浪兴，时有幽人岸白纶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2619,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和楼试可游育王","author":"舒亶","text":"参天松柏绿阴阴，古佛岩前一路深。\n猿鸟不惊如有旧，云山相对自无心。\n数泓寒水云藏雨，十里轻沙地布金。\n杖屦更知非世境，上方日日海潮音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2620,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨中游仗锡","author":"舒亶","text":"何人仗锡过千峰，雨里风烟转不穷。\n暗壑水声清决决，深岩花气湿濛濛。\n遥知雪岭开亭近，旧说云乡有路通。\n自恨青鞋踏城郭，仙游长在梦魂中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2621,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋宴十洲阁","author":"舒亶","text":"绿玉手持寻五岳，正应未识海边洲。\n倚栏花木参差见，对岸笙歌次第游。\n烟霁多疑九峰晓，波平全胜六鳌浮。\n仙风坐隔红尘路，消得丹青诧此州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2622,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送道士归桐柏观","author":"舒亶","text":"年来游尽海边山，独爱青青桐柏坛。\n光射斗牛腰下剑，气吞龙虎鼎中丹。\n白云千叠赤城晓，黄鹤一声华顶寒。\n玉简姓名仙约在，洞天莫放酒杯乾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2623,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"香山野步二首 其二","author":"舒亶","text":"空涧寒探月，高斋客聚星。\n霜分破窗白，山献隔帘青。\n窥水知僧定，占云识地灵。\n时时惊鹤梦，木叶下危亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2624,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"香山野步二首 其一","author":"舒亶","text":"龙护空堂钵，云笼古殿灯。\n经窗僧待月，茶井客敲冰。\n惊雁回峰影，疏星亚塔层。\n心清更无睡，未羡杜郎能。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2625,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄台州使君五首 其四","author":"舒亶","text":"几夜骊珠落蔀家，直疑光燄映朝霞。\n彩毫写就千篇赋，红烛才烧一寸花。\n卓荦高情欲飞动，淋浪醉墨半攲斜。\n阳春白雪知难继，捧对空惊衮绣华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2626,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄台州使君五首 其三","author":"舒亶","text":"赤城山下万人家，隐隐烟霄隔海霞。\n石上仙书留鸟迹，碗中佛供落天花。\n参云台树寒阴直，照日旌旗暖影斜。\n遥想铃斋无别事，只缘风景费才华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2627,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄台州使君五首 其三","author":"舒亶","text":"尽日书齐无案牍，有时佳客上云霞。\n清心自照江湖水，和气长开草木花。\n千里裤襦歌不足，万家弦管思无斜。\n笑谈坐觉仙风远，空卧秋山老岁华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2628,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄台州使君五首 其二","author":"舒亶","text":"使君家是八仙家，不负黄菁与紫霞。\n麦陇儿童行竹马，月楼鼓角度梅花。\n彩笺吟就云初合，玉局棋残月半斜。\n闻说握兰消息近，星郎昨夜倍光华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2629,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄台州使君五首 其一","author":"舒亶","text":"闻说天台太守家，全家日日在烟霞。\n壶中夜酿云分润，洞里秋香玉弄花。\n四郭青山连市合，一江寒水抱城斜。\n紫芝黄鹤应相识，梅福年来鬓欲华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2630,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游云湖过香山偶成二首 其二","author":"舒亶","text":"尘境回头隔圣凡，参差叠嶂巧如镵。\n归云堕碧粘僧屐，落叶飘红上客衫。\n果熟遥看猿渡涧，风号定想虎离岩。\n长天自有无穷景，未信西冈日半衔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2631,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游云湖过香山偶成二首 其一","author":"舒亶","text":"去路鶱腾逼紫霄，何年凫舄堕王乔。\n暗峰藏雨皆龙窟，灵草含霜半药苗。\n已觉山衣云扑扑，还疑风鬓雪潇潇。\n扪萝更上岧峣顶，下视沧溟百水潮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2632,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登五磊山","author":"舒亶","text":"五磊峰高笔插天，长松合抱几千年。\n尘氛洒落非人世，风露清明近月边。\n枕上数声敲夜磬，山前百亩起春田。\n我来欲步苍苔色，不著篮舆两两肩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2633,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题云湖庆安院","author":"舒亶","text":"门前屏障绕潺湲，付与林僧夜定还。\n松盖作云连十里，竹龙行雨出千山。\n白公香火莲红后，谢氏池塘草碧间。\n我亦凤凰台上客，图閒却笑未能閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2634,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题五峰兼简英禅师","author":"舒亶","text":"何人缩地海东偏，灵岳分来不计年。\n几见彩云争照日，真疑仙掌欲擎天。\n依稀故国松千尺，迤逦前山石一拳。\n四面开轩看不足，老僧时立碧溪前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2635,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题天童","author":"舒亶","text":"日日青鞋踏白沙，未应泛艇即灵槎。\n雨溪清越鸣哀玉，风蔓蜿蜒动暗蛇。\n晓润芝?挑秀茁，午香茶灶煮苍芽。\n玲珑仙客知何在，千古烟霞自一家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2636,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题布袋和尚","author":"舒亶","text":"休话人间我独尊，何妨廛肆且随群。\n乞钱往往多空手，问路时时向白云。\n壁上形容图尚在，囊中气味许谁分。\n分明提起无人问，欲会应须眼里闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2637,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题西山双乳泉","author":"舒亶","text":"石眼双开白欲漫，潺湲更傍碧琅玕。\n地饶爽气全无滓，天借灵源两不乾。\n晓月自分云外润，午茶谁斗雪中寒。\n孝先多睡相如渴，始把清甘乞取看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2638,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题灵桥门","author":"舒亶","text":"危楼清迥立江风，紫逻红旗落日中。\n暑雨涧溪来浩荡，暮烟洲渚隔朦胧。\n欢声不厌重城近，霁色遥知秀野丰。\n沧海一时传丽句，天才真是杜陵翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2639,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题灵鳗庙三首 其三","author":"舒亶","text":"亘古人间蒙润泽，数泓云底贮清泠。\n功将名并山无泐，道与人尊地转灵。\n晓殿千家供香火，旱天万里入风霆。\n谁知别有醍醐味，行路憧憧半未醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2640,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题灵鳗庙三首 其二","author":"舒亶","text":"绝境朱丹新栋宇，深山灵响杂蚖蛇。\n黄金地底应千岁，甘雨人间几万家。\n西域不劳方士咒，南州重识使君车。\n老农争赛丰年社，古木萧萧自晓鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2641,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题灵鳗庙三首 其一","author":"舒亶","text":"绕塔想曾随白马，蟠泥故复傍金沙。\n旱天霹雳长平地，乐岁污邪每满车。\n受赐由来千里境，论封消得万人家。\n朱门便是金涂榜，未负风云在一涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2642,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题桃源书院","author":"舒亶","text":"三月桃源路，先生安在哉。\n青衫尚颜色，蜂蝶已尘埃。\n白鹤山云暗，金鸡洞锁开。\n神游追不返，峦岳自崔嵬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2643,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题尊教院","author":"舒亶","text":"竹砌缘寒渚，松蹊藉绿苔。\n楼台隔林见，花木带云开。\n溪旱常流水，峰青自隐雷。\n月华几万顷，谁掉酒船来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2644,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题福源院","author":"舒亶","text":"地占灵龟背，山横小屿头。\n一桥云借路，双沼月分秋。\n竹影摇虚室，松烟著晓楼。\n残钟谁共听，空籁更飕飕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2645,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题蒙堂","author":"舒亶","text":"由来去住不相关，赢得随缘到处閒。\n笑出海云飞一锡，行分江月过千山。\n微言定许谁人叩，胜事偏于俗士悭。\n咫尺蒙堂隔霄壤，城东搔首只空还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2646,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题鄞江","author":"舒亶","text":"地吞越绝海分深，渺渺平流万马骎。\n早晚渡江潮有信，往来鸥鸟客无心。\n寒空倒影千山动，暖日澄波万籁沉。\n安用鱼龙閒养鬣，平时春雨自成霖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2647,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题翠岩丈室","author":"舒亶","text":"别移宝所出埃尘，无限金光欲照人。\n斤斧不惊龙象伏，栋梁特地水云新。\n千峰坐断人间路，一榻分来月里身。\n更看须弥师子座，未饶摩诘妙通神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2648,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再游天童山回吴与权诸友夜集","author":"舒亶","text":"太白崭岩几百尺，仙人一去无消息。\n临云时复倚栏干，独看千峰万峰碧。\n昨夜长须城里回，报道湖上秋风来。\n醉园雨过月台冷，篱根白菊看看开。\n却杖青藜趁流水，目送征鸿下山觜。\n蓬船荅浪绕丛芦，咫尺烟汀几万里。\n忽见江头江月白，纷纷笑语城东陌。\n一尊此酒一枰棋，未到懒堂犹是客。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2649,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"芦山寺 其七","author":"舒亶","text":"江云扶雨暖溶溶，来往东西只信风。\n早晚晴阴浑不定，青山半在有无中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2650,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赤陇山","author":"舒亶","text":"野草如排戟，山花似列屏。\n维舟一登览，误入小蓬瀛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2651,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"净居寺","author":"舒亶","text":"老厌冠盖场，万事不挂耳。\n时与林閒人，静话无生理。\n却闻钱长官，只饮净居水。\n使我夜不眠，灯花亦欢喜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2652,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和马粹老脩广德湖","author":"舒亶","text":"古作重虑始，功利故能永。\n末俗分锥刀，往往附光影。\n此几百岁馀，兴废屡动静。\n七乡十万家，利害寄俄顷。\n诪张好恶曹，聒乱剧池黾。\n使君武陵孙，明洁水中荇。\n坐啸黄堂春，独得意外景。\n登临莽芜没，叹息民不幸。\n一日山水光，荡漾出荒梗。\n黍禾杂菰鱼，狼籍被他境。\n人指白鹤祠，慇勤窃有请。\n衣冠俨郡公，一一画真鲠。\n斯人岂可作，庶用荐遗秉。\n公乎且勿去，何以慰乡井。\n愿属丹青手，千载共观省。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2653,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]