[{"title":"送笋与胡仲威","author":"赵蕃","text":"掘我窗前笋，与君充煮煨。\n槎牙勿多弃，聊用敌崔嵬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47766,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送智门祥师便呈斯远兄","author":"赵蕃","text":"寺后溪亭我所开，春风应已长莓苔。\n南州高士如临赋，为把新诗写寄来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47767,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送曾季永赴道州永明尉三首 其三","author":"赵蕃","text":"忆昔曾闻谪道州，每于文字见曾游。\n白鹅寺近永明县，试觅记碑还在不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47768,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送曾季永赴道州永明尉三首 其二","author":"赵蕃","text":"去年洞贼惊郴道，闻说居民甚可悲。\n太守只今谁漫叟，舂陵示吏两篇诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47769,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送曾季永赴道州永明尉三首 其一","author":"赵蕃","text":"西昌阀阅推曾氏，夫子家居仍旧溪。\n我政结亭临水际，君行谁与共攀跻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47770,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送曾耆英持胡端殿书谒张袁州四首 其四","author":"赵蕃","text":"我闻诸侯一朝享，可作寒士终年储。\n张家衣被及四海，不但一州歌裤襦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47771,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送曾耆英持胡端殿书谒张袁州四首 其三","author":"赵蕃","text":"袁州张侯吾所闻，政事不减大冯君。\n如云已召符节令，行矣君其无惮勤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47772,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送曾耆英持胡端殿书谒张袁州四首 其二","author":"赵蕃","text":"君知龙门不易陟，颇欲乞书南郡胡。\n一幅斜行半年得，费君趼足几工夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47773,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送曾耆英持胡端殿书谒张袁州四首 其一","author":"赵蕃","text":"是家风节在峨岷，仍见诸孙文字贫。\n闻道江南有蜀士，不辞奔走犯萧晨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47774,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送新茶与俞尉","author":"赵蕃","text":"山居每啜社前香，及是清明茶政尝。\n叹我白头无母遗，一杯持与供高堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47775,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送蕨与成父","author":"赵蕃","text":"道人惠我南山蕨，颇带斋厨法酱香。\n闻道城中少蔬供，急令健步走倾筐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47776,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重午日摘枇杷荐酒因成两绝句 其一","author":"赵蕃","text":"已载相如赋，还披杜老诗。\n团团自长叶，佳实欠累累。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47777,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重午日摘枇杷荐酒因成两绝句 其二","author":"赵蕃","text":"蜀酒能袪虑，昌阳解引年。\n楚君为楚节，湘客念湘船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47778,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重过东湖二首 其二","author":"赵蕃","text":"敝车羸服豫章城，几向东湖得细行。\n不但屡来人似识，白鸥相惯亦忘惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47779,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重过东湖二首 其一","author":"赵蕃","text":"忆昨追凉孺子亭，再来荷柳竞凋零。\n试当止水凭栏看，我亦疏髯白数茎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47780,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重阳甫近菊殊未花而木犀再开遂成一绝","author":"赵蕃","text":"今年为况添萧瑟，无菊能酬九日杯。\n天意似怜愁欲绝，故令岩桂为重开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47781,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重送处州斯远三首 其三","author":"赵蕃","text":"文字投盟不计官，古人能尔在今难。\n使君于此自为德，我辈因留后代看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47782,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重送处州斯远三首 其二","author":"赵蕃","text":"万木苍苍古钓台，白云楼观隔溪开。\n赋成赤壁后无对，好与驱从笔下来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47783,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重送处州斯远三首 其一","author":"赵蕃","text":"登临长病独成吟，连壁相依照映深。\n寄谢青山无偃蹇，好听绝唱乱清音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47784,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闺怨四首 其一","author":"赵蕃","text":"辞少不尽意，辞多还尽纸。\n纸尽意无穷，相思似流水。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47785,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻杜鹘","author":"赵蕃","text":"山禽劝我不如归，知我西游有定期。\n若使藜羹足供给，衡门之乐肯轻辞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47786,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻曾裘父丈亡追用前韵寄审知二首 其二","author":"赵蕃","text":"钓船颇欲佐涪翁，当世知余莫取容。\n谁料传亡终欠识，但同物论惜元龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47787,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻曾裘父丈亡追用前韵寄审知二首 其一","author":"赵蕃","text":"凉风不审意如何，逝日能言客有过。\n师友渊源说宗派，要君文字饱研磨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47788,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻禽","author":"赵蕃","text":"天公端以鸟鸣春，百族喧喧晓更频。\n最是客中贪听尔，弄晴忧湿似关人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47789,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻蛙","author":"赵蕃","text":"惊蛰已数日，闻蛙初此时。\n能知喜风月，不必问官私。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79