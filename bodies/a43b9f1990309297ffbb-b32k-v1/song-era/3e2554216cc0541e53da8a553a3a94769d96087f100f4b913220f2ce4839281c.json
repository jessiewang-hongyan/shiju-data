[{"title":"送帅初游浙西","author":"舒岳祥","text":"吴下吾游地，因君思又飘。\n水花香外雨，沙鸟梦边潮。\n载酒浮官舫，吟诗上驿桥。\n三高祠下过，为赋楚辞招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3144,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送俞宜民归马耳峰","author":"舒岳祥","text":"晴雪集林薄，朝阳熙陇苗。\n青天堪数雁，白路自通樵。\n愁我未归客，别君还过桥。\n何时烧短烛，软语更终宵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3145,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送潘少白赴连山馆","author":"舒岳祥","text":"桐木深坑岭，菊田高弟家。\n闻渠能馆致，去我使人嗟。\n箬长潜沙笋，兰开傍石花。\n古琴留挂壁，此意澹无邪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3146,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送潘少白游桐柏宫","author":"舒岳祥","text":"桐柏旧题句，方瀛新记文。\n因君重拂拭，为我致殷勤。\n仙过峰停鹤，龙藏井閟云。\n金丹如可鍊，此去访方闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3147,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重游龟石寺","author":"舒岳祥","text":"一龟先过水，更有一龟寻。\n鸟出石潭底，笋穿沙树心。\n平桥连断岸，古佛坐乔林。\n竹里何人住，时闻啸咏音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3148,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻有海船入鄞作诗附寄正仲","author":"舒岳祥","text":"华馆多髯客，深山短发翁。\n钟声更点外，萤焰烧痕中。\n春日同倾酒，寒溪数过鸿。\n天门通海路，诗寄鄮城东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3149,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻鸡早起","author":"舒岳祥","text":"钟扣星辰动，鸡号天地开。\n夜来新过雨，行处旋生苔。\n白日一窗转，飞霜两鬓摧。\n劳生何所恋，只忆两三杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3150,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻鄞兵入仙居二首 其二","author":"舒岳祥","text":"细雨残阳外，孤村乱水中。\n饥年才半菽，白发听疏舂。\n世事何曾了，吾生会有穷。\n深衣敛形日，嗟我一枝筇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3151,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻鄞兵入仙居二首 其一","author":"舒岳祥","text":"独岭斜阳笠，深溪夜雨灯。\n多忧未归客，万事不言僧。\n兵甲今如此，台明昔未曾。\n欲言徵敛数，天远有谁能。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3152,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"食鹿肉谢正仲见馈","author":"舒岳祥","text":"山寺曾闻叫，悲哉失侣音。\n能鸣终召祸，善走竟成禽。\n设罟须新雨，寻踪恋旧林。\n衰年资血味，生杀亦何心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3153,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"借正仲韵赋牡丹","author":"舒岳祥","text":"洛阳宫苑地，幻出几花身。\n艳色宜当午，开时惜殿春。\n管弦非旧国，风雨易愁人。\n同是多情客，相逢说梦因。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3154,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"兼静黄坛杨君书室也取钱起柴门兼竹静之句名之邑里吟人题咏殆遍矣予为友作反骚不知者便谓子云与屈子异意非也","author":"舒岳祥","text":"本自柴门静，谁令种竹喧。\n月来将画写，风过引书翻。\n默坐雨偏响，闲眠雪易繁。\n动中还有静，此意互为根。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3155,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"哭王达善","author":"舒岳祥","text":"一叟经年疟，萧然强饭蔬。\n残花清供后，瘦竹苦吟馀。\n女授伏生业，儿工阿买书。\n曾无一纸别，疑信问何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3156,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"哭李实甫","author":"舒岳祥","text":"帝阍尝再叩，龙颔竟难攀。\n帙散萤千点，诗留豹一斑。\n人生会有极，吾道几曾还。\n藏我择轩记，名垂天地间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3157,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"哭匊田诗老 其二","author":"舒岳祥","text":"本是攻文者，其如癖在诗。\n人皆尊岛佛，我欲效宗师。\n废圃营新屋，寒花带短篱。\n风流无此老，遗藁访佳儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3158,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"哭匊田诗老 其一","author":"舒岳祥","text":"寻源自永嘉，清响黜浮葩。\n一字不犯古，五言真到家。\n思幽多掩抑，情至重咨嗟。\n欲拟徵君诔，天寒日又斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3159,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夏日山居好十首 其十","author":"舒岳祥","text":"夏日山居好，藤床面北林。\n荷心风百顷，秧底月千寻。\n幽鸟珍毛羽，流泉响磬琴。\n此中多乐事，客至亦能吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3160,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夏日山居好十首 其九","author":"舒岳祥","text":"夏日山居好，日长宜学文。\n金门堪避世，?亩不忘君。\n林宿三冬雪，岩藏万里云。\n屈伸吾道在，何必杂人群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3161,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夏日山居好十首 其八","author":"舒岳祥","text":"夏日山居好，虫鸣山更幽。\n青鞋紫藤杖，玉醴绿瓷瓯。\n飞露吹黄葛，凉风洒白头。\n已知时雨顺，更有虎狼忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3162,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夏日山居好十首 其七","author":"舒岳祥","text":"夏日山居好，鸡鸣桑柘烟。\n笋摇知狖过，草偃觉鹅眠。\n休问田园计，聊随饮食缘。\n经营空自苦，烦恼更谁怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3163,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夏日山居好十首 其六","author":"舒岳祥","text":"夏日山居好，清溪一笛风。\n瘦躯便褐短，寡发爱梳松。\n细雨明归鹭，斜阳饮远虹。\n有时吟未稳，饱步自书空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3164,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夏日山居好十首 其五","author":"舒岳祥","text":"夏日山居好，凉风树下生。\n三茶还可瀹，二韭尚堪烹。\n永日闲言语，平生实讲明。\n半空飞赤电，燕坐不须惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3165,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夏日山居好十首 其四","author":"舒岳祥","text":"夏日山居好，茅檐水饼香。\n蕉衫身俭洁，纱帽顶清凉。\n润叶桑藏井，新梢笋过墙。\n莫言炎热苦，胜处苦寒乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3166,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夏日山居好十首 其三","author":"舒岳祥","text":"夏日山居好，还思童冠时。\n汗流修举业，浴罢间题诗。\n边事廷绅奏，朝除邸报驰。\n槐花时节近，新说合新知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3167,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夏日山居好十首 其二","author":"舒岳祥","text":"夏日山居好，吟来亦自豪。\n焚香诵周易，痛饮读离骚。\n莫讳无三甲，吾今已二毛。\n芜编三百卷，空费一生劳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3168,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夏日山居好十首 其一","author":"舒岳祥","text":"夏日山居好，清风报断梅。\n林深蚊却退，山合鸟飞回。\n一霎过云雨，数声深水雷。\n绕园寻蠹笋，聊以荐山杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3169,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽董知镇","author":"舒岳祥","text":"曾行栲源路，相访竹溪频。\n事帝清心旦，于人笑面春。\n升堂惊挂影，下榻忆延宾。\n风雪深尊夜，梅花满座茵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3170,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晓凉","author":"舒岳祥","text":"秋风万里清，客子最含情。\n山路残星在，柴门野水鸣。\n平田闻雁起，落月有人行。\n破箧无书册，何须眼复明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3171,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晓起观梅","author":"舒岳祥","text":"玉气占虹贯，珠光照夜阑。\n凄凉兼水净，的皪与星残。\n欲折先呵手，谁来独倚栏。\n白螺?晓露，起向月中看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3172,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晓寒独立红茶花下","author":"舒岳祥","text":"长物乌皮几，宜人白氎裘。\n晓霜花口噤，午雨柳绵收。\n毛发匆匆变，光阴冉冉休。\n直须瓜芡熟，长枕卧清秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3173,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"海眺","author":"舒岳祥","text":"自嫌林谷暗，欲作海天游。\n芦苇人家晓，蒹葭国士秋。\n树根生石上，山影占江流。\n载酒船头去，风波几瓦瓯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3174,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"消忧","author":"舒岳祥","text":"凤栖塘上路，春草思悠悠。\n绿树双黄鸟，青山一白头。\n诗书自有厄，盗贼本非仇。\n天道知难问，吾贫不肯忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3175,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"留山甫","author":"舒岳祥","text":"新舂知麦味，旧债了邻赊。\n借榻无鹃处，敲门有竹家。\n韭苗香煮饼，菊脑和烹茶。\n少驻还山屐，乌纱细雨斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3176,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"留正仲篆畦","author":"舒岳祥","text":"子欲寻安道，吾方梦惠连。\n雪花成小雨，春草傍残年。\n悄悄论诗夜，阴阴驻客天。\n自惭私酿薄，一酌醉谁先。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3177,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"病起寄二林","author":"舒岳祥","text":"心地缅然平，乔林夏气清。\n炎风疏鸟毳，凉雨滴蝉声。\n输翟专攻守，弓函誓死生。\n吟成与谁寄，二子在鄞城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3178,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"衰至和王达善","author":"舒岳祥","text":"衰来知已渐，老去不容迟。\n居长常先导，徐行且远期。\n相看飘鹤发，久坐绽乌皮。\n百岁休嫌短，修名千载垂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3179,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"郭似山道士寄惠竹笔两束启缄乃羊毫也作诗戏之","author":"舒岳祥","text":"似山惠我笋丝笔，乃是长须公子毫。\n竹简固应同祓涤，琅函宁肯近腥臊。\n若非月里霜㕙颖，恐是仙家云鹿毛。\n润笔定须三百束，为君滴露注庄骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3180,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"高人","author":"舒岳祥","text":"云日弄轻阴，前溪给缓寻。\n燕翻红雨乱，莺出翠微深。\n迥矣苏门啸，怀哉梁父吟。\n高人不可见，谁见此时心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3181,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿龟石寺","author":"舒岳祥","text":"朅来谁主我，野寺得闲行。\n借屋安书庋，就岩支饭铛。\n山晴分雁转，水煖见鱼生。\n无事人情好，相逢总笑迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3182,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄二林","author":"舒岳祥","text":"久客谁为主，无归莫问家。\n古书浇茗椀，冻酒咽梅花。\n岩静松抛子，沙虚笋养芽。\n二林谁远近，伫立日西斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3183,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄子堂","author":"舒岳祥","text":"知君不寂寞，禅悦只空房。\n书卷依经藏，吟声绕寺廊。\n早霜狸面白，新酒菊花黄。\n共此山家景，西峰隔夕阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3184,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄子堂","author":"舒岳祥","text":"欲出一雨隔，相违十日强。\n鼠过松落粉，雉步麦摇芒。\n酒尽夜难过，书清日自长。\n羊求三径约，来往莫相忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3185,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄子堂 其二","author":"舒岳祥","text":"不践山中约，时时梦见之。\n况当春雨夜，正作韭齑思。\n种菊秋堪撷，诛茅冬未迟。\n人生难自料，身后要名垂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3186,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄王真人","author":"舒岳祥","text":"象简银冠觐冕旒，一清沆瀣九天秋。\n西湖处士梅花屋，太乙真人莲叶舟。\n闻道辽东来白鹤，不知函谷度青牛。\n人间天上无拘束，且驾长螭赋远游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3187,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄帅初","author":"舒岳祥","text":"西家女儿长日愁，白头鼻息撼林丘。\n老去声名惜鸡肋，世间富贵烂羊头。\n青山白鹭水天远，绿叶黄鹂风日柔。\n欲往榆林忘南北，几回吹笛上高楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3188,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄正仲","author":"舒岳祥","text":"云峰双鸟破，雪径一僧分。\n红酒回丹渥，青编笑白纷。\n风昏生月晕，水落织冰文。\n岁莫无来客，开门独候君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3189,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄正仲","author":"舒岳祥","text":"相对石屏风，相邀石老翁。\n鱼游山影里，鸟睡水声中。\n诗卷行未了，书囊倒不空。\n笭箵君莫忘，犹约待秋风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3190,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄正仲","author":"舒岳祥","text":"淰淰清愁变暮寒，宾鸿去后燕来还。\n流红似雨人千里，总翠如山屋万间。\n竹杖行藏观动静，柴门开阖见忙闲。\n何如上传多髯客，白饭鱼羹养好颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3191,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄石泉策禅师","author":"舒岳祥","text":"不来三十载，僧与寺俱非。\n棕屦延苍藓，蒲团坐翠微。\n溪传松顶相，风助竹谈机。\n侍者能栽菊，秋深重扣扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3192,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄达善","author":"舒岳祥","text":"渺渺思君处，悠悠古道旁。\n柴荆人独自，榉柳月昏黄。\n渴鼠寻松溜，饥乌背夕阳。\n王塘在吾目，空费九回肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3193,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄赵敏求","author":"舒岳祥","text":"赵子贫愈好，吟诗送此生。\n焚巢同旅鸟，泛宅老书檠。\n八座清门户，王塘好弟兄。\n杉棚先辱和，欲报怨无琼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3194,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄袁中素季原","author":"舒岳祥","text":"清谈疏世虑，知发度年华。\n雀饮盆中水，蜂寻案上花。\n郊原新射雉，陂荡早开蛙。\n得句何人赠，棠溪有竹家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3195,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄袁季源","author":"舒岳祥","text":"当世佳公子，枝吾雅道多。\n江南有文献，鲁国自强歌。\n火后归新第，兵馀喜止戈。\n公车行有召，毋久恋松萝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3196,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晚晴","author":"舒岳祥","text":"九十日春长雨雪，喜君今日咏新晴。\n绿阴四面招人坐，芳草前头试我行。\n少驻飞花终有别，爱听啼鸟忽无声。\n东坡已作秋阳赋，欲赋春阳恨未成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3197,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梅花二首遗正仲少见折赠之意","author":"舒岳祥","text":"晴暖不妨临石濑，清寒多是傍柴关。\n香须蜂咬应知苦，斜影僧眠得占闲。\n数点稀星枝上下，一痕残雪树中间。\n入冬冷落愁眉结，见尔鲜明故展颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3198,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梅所将别夜坐叙怀","author":"舒岳祥","text":"相见岂无期，前年亦此时。\n青山吾有约，白发子能医。\n石室谁看鼎，岩泉似散丝。\n老人偏重别，去路渺相思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3199,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梦回","author":"舒岳祥","text":"月上芙蓉浦，船依杜若洲。\n岁行人冉冉，川永梦悠悠。\n天地回青眼，江山养白头。\n老生如朽木，安识有悲秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3200,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梦笑","author":"舒岳祥","text":"过尽江山十万鸿，梅花昨夜笑东风。\n客行草树绵绵外，梦觉乌鸦渺渺中。\n天道难知龟不信，人生有恨水无穷。\n今年厄闰有如此，万事绳床俯仰空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3201,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渔童","author":"舒岳祥","text":"丫角长身者，依然发懒梳。\n只将星子饵，钓得尺来鱼。\n险阻行来惯，风波舞自如。\n曾因潮岸塌，收得古人书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3202,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渚宫秋思","author":"舒岳祥","text":"石树表独立，瓦蛩相与言。\n双鸥定渔社，一犬护柴门。\n抱瓮非吾土，浮家何处村。\n枕边黄黍饭，用此了乾坤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3203,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"绿阴","author":"舒岳祥","text":"野色蒙茸翠羽盖，山光澹荡碧油幢。\n午烟时引煎茶灶，晓雾还沾读易窗。\n隐映掷金莺点点，分明藉玉鹭双双。\n莫疑蛇动杯中影，一笑开襟钓大江。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3204,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菖蒲最难养置而弗省则弗滋勤勤拂拭则病矣余性甚嗜之往往不特人病苗而苗亦病人矣讲求其法至备尝为之作谱书留南郭杨建处建摄令黄岩死于兵无从问矣端午日寻石菖蒲偶成一律","author":"舒岳祥","text":"多忘昏昏久废书，闲来石上采菖蒲。\n瘦鞭走石蛟龙窟，细叶穿苔虎豹须。\n阴洞容光明复晦，乳泉盈坎润难枯。\n试拈九节风前嗅，已觉登仙不用扶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3205,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"萤","author":"舒岳祥","text":"熠熠孤光阖复开，黄金一点亦微哉。\n凌风欲作炎云助，入屋翻疑夜雨来。\n本为微明生腐草，谁知残照落莓苔。\n暗飞只合藏形影，罗扇收来却是灾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3206,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"萤","author":"舒岳祥","text":"每向坳塘照，多从曲径烧。\n无烟知有焰，著草不曾焦。\n杂燐因风乱，随星没夜遥。\n老来疏简册，四散任渠飘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3207,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"野老","author":"舒岳祥","text":"野老巢居江上成，相亲幽事远浮名。\n近村饮酒携孙去，远寺寻兰领犬行。\n麦老秧高关念虑，花开果熟有将迎。\n旧时风俗今谁有，见尔令人忆太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3208,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"喜山甫相过 其一","author":"舒岳祥","text":"阆风有诗派，一派落山房。\n新思如春柳，别来应更长。\n相逢无可说，不见自难忘。\n此是空圆意，雨馀荷叶香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3209,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"喜山甫相过 其二","author":"舒岳祥","text":"梦回春草远，病起故人来。\n耿耿孤灯话，沈沈细雨杯。\n千愁双鸟过，一笑百花开。\n世事渺烟水，相携卧绿苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3210,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"喜帅初归剡","author":"舒岳祥","text":"吴客多流越，君寻古剡归。\n民贫官箠急，岁歉米船稀。\n岭鹿三丫入，溪鲈一尺肥。\n榆林知可隐，安得翅能飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3211,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"喜闻邻家食早麦","author":"舒岳祥","text":"七十三翁饮上池，始知糠籺也生肥。\n麦须似笔山雌下，荷叶如钱海鳦飞。\n天运无穷人自老，川流不返志多违。\n旧时此日尝新日，蚤笋窗前一尺围。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3212,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]