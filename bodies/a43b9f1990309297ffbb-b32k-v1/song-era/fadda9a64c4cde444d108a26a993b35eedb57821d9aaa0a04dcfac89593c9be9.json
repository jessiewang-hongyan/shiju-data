[{"title":"杨花 其四","author":"楼钥","text":"野芳庭草是生涯，老去祇宜闲在家。\n几日惜春留不住，小鬟为我拾杨花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24718,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杨花 其二","author":"楼钥","text":"柳绵无数糁枝头，日暖随风扑画楼。\n万象可观惟有雪，喜看晴昼满空游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24719,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杨花 其三","author":"楼钥","text":"为我轻攀绿柳枝，带花低护笑携归。\n日长深院微风动，要看松绵当面飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24720,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"灵光","author":"楼钥","text":"鲁邦宫殿久芜荒，惟有灵光最久长。\n身似灵光终变灭，岿然别有一灵光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24721,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陈留柏","author":"楼钥","text":"驿门深闭柏参天，月可中庭夜影圆。\n人静好风喧客枕，坐令归梦到林泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24722,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"京仲远尚书为澹然子作二大字","author":"楼钥","text":"浓墨新题付澹然，松坡为子老谈天。\n凭君推我行年看，何日归耕绵上田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24723,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜读王承家县丞诗编 其一","author":"楼钥","text":"向来深夜快挥犀，不听清谈又许时。\n净洗昏眸急呼烛，为君读尽一编诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24724,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜读王承家县丞诗编 其二","author":"楼钥","text":"鍊句工深兴味长，固知家学富青箱。\n莫言一脔能尝鼎，更欲为余倾锦囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24725,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"枕上","author":"楼钥","text":"不守庚申不坐禅，老来触事总悠然。\n天明门外无来客，尽好萧萧听雨眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24726,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"范牛","author":"楼钥","text":"人问吾何爱一牛，范仙真笔倍风流。\n绳牵虽未如自放，犹胜更著金笼头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24727,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"试俞珣长头笔","author":"楼钥","text":"倦游俞老又中州，霜兔抽豪饱盛秋。\n平日相亲管城子，结交今得贾长头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24728,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"金蹄","author":"楼钥","text":"金蹄垂耳小韩卢，饰以重镮驯可呼。\n谁击冬青碧阴下，恍然如见击梧图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24729,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"客省听燕乐","author":"楼钥","text":"晓入金门拜紫宸，门前错立士如云。\n未容密侍君王宴，祇许钧天隔殿闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24730,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"庭前一莲著花","author":"楼钥","text":"门外荷莲浥露华，绿云平地拥秋霞。\n病夫不能出门去，且看庭前第一花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24731,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"括苍烟雨楼","author":"楼钥","text":"莫为看山只凭栏，远怀犹恨两山间。\n坐深却得无穷趣，祇看平川一半山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24732,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春雨 其一","author":"楼钥","text":"石斗微微覆浅沙，兰丛短短茁青芽。\n春花著眼未云久，花事于人渐有涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24733,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春雨 其二","author":"楼钥","text":"漫漫平湖接远天，濛濛细雨湿轻烟。\n野桥横著草深外，何处渡头人上船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24734,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"昼寝","author":"楼钥","text":"弹彻悲风更广陵，沧浪一为濯尘缨。\n邯郸枕上梦初觉，喜听檐閒秋雨声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24735,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"洛社老僧听琴 其一","author":"楼钥","text":"宴坐萧斋不作劳，谓予何事走蓬蒿。\n从容试问今年几，手植黄杨三丈高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24736,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"洛社老僧听琴 其二","author":"楼钥","text":"自言几载不闻琴，屡听清弹苦契心。\n少待庭柯蝉噪静，为师更作醉翁吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24737,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"省宿","author":"楼钥","text":"树满茅山绿正肥，昏鸦日日向南归。\n如今身在三茅外，却看归鸦正北飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24738,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贺监湖上 其二","author":"楼钥","text":"狂客归来终好夸，越王城下占烟霞。\n此中信美非吾土，不似西湖是我家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24739,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贺监湖上 其一","author":"楼钥","text":"万顷平湖一苇杭，此归喜似贺知章。\n上恩赐与西湖曲，遂老吾家归照堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24740,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送一老住庐山归宗 其四","author":"楼钥","text":"归宗法窟寖湮微，拭眼馀风靡孑遗。\n法鼓一声精彩变，要如光弼用军时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24741,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送一老住庐山归宗 其五","author":"楼钥","text":"庐山面目非难识，横岭侧峰皆是真。\n若待出来方识破，不知何用个中人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24742,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送一老住庐山归宗 其三","author":"楼钥","text":"千古名山大道场，止因赋重遂荒凉。\n后之君子谁能弛，试向山前问老苍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24743,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送一老住庐山归宗 其二","author":"楼钥","text":"啐啄同时不偶然，史君提起正当年。\n向来闹市难行道，今日人天听说禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24744,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送一老住庐山归宗 其一","author":"楼钥","text":"久向东山捲藏经，鬼神推出举军惊。\n从来要去庐山住，好就山中过此生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24745,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送卫清叔著作提举淮东 其一","author":"楼钥","text":"汉庭早已冠群仙，阔步登瀛最少年。\n窃叹岂惟年叵及，人门才业总翘然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24746,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送卫清叔著作提举淮东 其二","author":"楼钥","text":"通泰牢盆亘海滨，宅家专欲用儒臣。\n淮南草木生颜色，又见龙头第一人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24747,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送卫清叔著作提举淮东 其四","author":"楼钥","text":"羡君持节拜庭闱，未老双亲看綵衣。\n若过盖公烦问信，坐曹日念旧游稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24748,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送卫清叔著作提举淮东 其五","author":"楼钥","text":"屡从樽酒接从容，叔宝风姿照座中。\n他日相逢年益老，棋坛尚可角雌雄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24749,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送卫清叔著作提举淮东 其三","author":"楼钥","text":"虎榜先登到凤池，前良多以十年期。\n虽知勇退急流去，壮岁功名会及时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24750,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送朱叔止守南剑 其四","author":"楼钥","text":"下水上山腰带州，人家无数起危楼。\n遨头不用喧箫鼓，祇把清诗纪胜游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24751,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送朱叔止守南剑 其二","author":"楼钥","text":"槜李曾蜚剸剧声，贰车仍赞虎头城。\n朱轓小试承流手，要继桐乡循吏名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24752,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送朱叔止守南剑 其三","author":"楼钥","text":"万竹蟠山喉不乾，两龙潜水气犹寒。\n郡斋见说真图画，公退何妨一倚栏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24753,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送朱叔止守南剑 其五","author":"楼钥","text":"同盟东下或西征，老我惟知管送迎。\n祇恐政成登省户，未容归骑向西城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24754,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送朱叔止守南剑 其六","author":"楼钥","text":"名画法书知几编，俸馀宁复计求田。\n麻沙剩买新文字，归满米家书画船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24755,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送朱叔止守南剑 其一","author":"楼钥","text":"舍人簪笔旧甘泉，家学相传子姓贤。\n未羡夹河为太守，阿连剖竹向封川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24756,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送朱季公守封川 其一","author":"楼钥","text":"韶阳生长十馀年，城郭重经固宛然。\n叹息紫微仙去久，尚馀遗墨照山川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24757,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送朱季公守封川 其五","author":"楼钥","text":"妙舞清歌有二姝，后堂曾见绣罗襦。\n岭南太守风流胜，不用归舟载绿珠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24758,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送朱季公守封川 其四","author":"楼钥","text":"吾乡棋社寖凋零，赖有朱家好弟兄。\n举酒看看故人少，阳关莫唱断肠声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24759,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送朱季公守封川 其二","author":"楼钥","text":"桐乡汉有大司农，封守今推陈秀公。\n君向邦人著遗爱，近追相业远家风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24760,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送朱季公守封川 其三","author":"楼钥","text":"乡评久说雁行贤，剖竹封川与剑川。\n不用对床风雨约，政成同取旧青毡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24761,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送林子方吏部将漕江东 其四","author":"楼钥","text":"殿庐官烛对风帘，郎舍修篁共一檐。\n别日苦多良晤少，掺袪不耐雨纤纤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24762,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送林子方吏部将漕江东 其二","author":"楼钥","text":"望郎三度到长安，垂上青云作好官。\n暂向江东一澄按，却归径著侍臣冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24763,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送林子方吏部将漕江东 其一","author":"楼钥","text":"光尧三纪焕文章，宝阁岧峣谨秘藏。\n寓直到君才第四，皇华礼乐远增光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24764,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送林子方吏部将漕江东 其三","author":"楼钥","text":"自说嵇康七不堪，上教持节向江南。\n江南父老应相贺，见说清明似晦庵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24765,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送赵晦之丞彭泽 其三","author":"楼钥","text":"陶令居官八十日，始为督邮方赋归。\n君家门户要兴起，未用飘然咏式微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24766,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送赵晦之丞彭泽 其一","author":"楼钥","text":"淮甸归来涉学深，孤云又出亦何心。\n公馀岩下读书去，远继风流石橘林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24767,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送赵晦之丞彭泽 其二","author":"楼钥","text":"渊明事晋肯臣刘，仁杰忠良不附周。\n见说三贤参羽士，盍将吴簿配蘋羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24768,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送赵清臣宰姚江 其四","author":"楼钥","text":"才刃恢恢妙拨烦，邻封抚字尚何难。\n更能触事加长虑，自有甘棠向后看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24769,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送赵清臣宰姚江 其五","author":"楼钥","text":"妇家故步懒重寻，藏拙年来恐不深。\n短棹有时乘兴去，径登竹所听鸣琴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24770,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送赵清臣宰姚江 其一","author":"楼钥","text":"玉立君家好弟兄，蓝田风采照花城。\n版舆寿母人间盛，千里何曾去送迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24771,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送赵清臣宰姚江 其三","author":"楼钥","text":"长江东去跨虹桥，千丈横堤捍海潮。\n更向烛溪图永利，坐令百里沸歌谣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24772,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送赵清臣宰姚江 其二","author":"楼钥","text":"鄞江水与舜江通，久矣威名满一同。\n试问何时到封部，数声柔橹一帆风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24773,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送雪窦璧老住雪峰","author":"楼钥","text":"雪窦移将住雪峰，两山雪色本皆同。\n莫言此去人千里，明月往来含太空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24774,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送黄真护道人住茅山赠以小黑玉虎","author":"楼钥","text":"少从黑虎谷中行，晚得于菟玉琢成。\n辍以赠君俱隐处，大茅峰顶看风生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24775,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送黄景声秘丞提举浙西 其四","author":"楼钥","text":"论诗才了便谈禅，鄙吝冰消更豁然。\n稽首心空先及第，敢将癸未论同年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24776,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送黄景声秘丞提举浙西 其五","author":"楼钥","text":"玉节光华照日曦，扬清激浊正当时。\n阿连幸出百僚底，正恐翁归不受私。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24777,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送黄景声秘丞提举浙西 其二","author":"楼钥","text":"宅家亲擢得真才，柏府兰堂更外台。\n未问遄驱向沟壑，半途应有诏书催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24778,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送黄景声秘丞提举浙西 其三","author":"楼钥","text":"从来轩冕一毫轻，朝迹初收去玉京。\n打破画瓶无个事，不妨游戏绣衣行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24779,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闾丘医视脉曰老人之脉如小春有感","author":"楼钥","text":"老去光阴似小春，如何比得少年人。\n君看桃李秋风后，纵有花开不是真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24780,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"唤仙阁 其一","author":"楼钥","text":"上到危层莫唤仙，祇凭横槛挹江天。\n江天如许来借眼，何用征侨更偓佺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24781,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"唤仙阁 其二","author":"楼钥","text":"多少寻仙更不还，渺茫竟堕有无閒。\n使其真有毋庸唤，仙自曾城我自山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24782,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晓雾","author":"楼钥","text":"晓雾冥濛水拍堤，棱嶒乱石与云齐。\n扁舟不用兼程去，到得稽城日已西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24783,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"海棠 其二","author":"楼钥","text":"海棠初发为题诗，倏见轻红万点吹。\n已惜落英铺满地，更怜几片罥蛛丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24784,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"海棠 其一","author":"楼钥","text":"海棠昨日始萌芽，一夜惊雷发万葩。\n老眼恍然何所得，凌云庵外见桃花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24785,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"病后戏作","author":"楼钥","text":"河鱼腹疾未全除，一饭充饥不愿馀。\n纵有珍羞难下箸，真成顿顿食黄鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24786,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"病告","author":"楼钥","text":"闭户垂帘尽自如，兀然终日拥红炉。\n得归足可优游老，此地何堪养病躯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24787,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酒边戏作","author":"楼钥","text":"未年六十已言归，七十重来自觉痴。\n未报君恩归未许，樽前羞听摸鱼儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24788,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿仙居民家","author":"楼钥","text":"投暝人家欲睡时，雨声不断水平池。\n回头已过三江渡，醉看车中总不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24789,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"常禅师塔 其二","author":"楼钥","text":"从来猛虎性坚刚，据石依林死不僵。\n何待寒林班侍者，千年陪葬祖师傍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24790,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"常禅师塔 其一","author":"楼钥","text":"当时道价极光华，鸷兽相随共一家。\n象去虎亡师亦老，不须百鸟更衔花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24791,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晚步少微阁","author":"楼钥","text":"落日谢虚阁，横琴相对閒。\n片云将急雨，一笑失前山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24792,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梅仙岩","author":"楼钥","text":"梅山遗迹若为寻，怪石崚嶒一径深。\n未必当时真隐处，清风自觉袭衣襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24793,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"淯月下鼓琴用淳韵","author":"楼钥","text":"老稚团栾鲤在庭，文姬为鼓玉琴声。\n起来同作悲风曲，倍觉先秋月影清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24794,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菁江迓客","author":"楼钥","text":"菁江十里路逶迟，两岸平畴接翠微。\n赢得闲中乘画舫，随潮西上趁潮归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24795,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鹿伯可郎中园池杂咏 三友径","author":"楼钥","text":"公是端人友必端，世情冷暖不相干。\n虽云门外可罗雀，三益还能耐岁寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24796,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]