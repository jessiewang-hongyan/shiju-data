[{"title":"枕上和圆机绝句梅花十有四首 其六","author":"晁说之","text":"负雪披霜不得依，梅寒恨不出幽诗。\n身梁根治荒江介，情调犹输第一辞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56095,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"枕上和圆机绝句梅花十有四首 其十四","author":"晁说之","text":"云母屏风只暂依，金乡公主嫁迟诗。\n宁论鲍照梅花恨，不及从来不惜辞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56096,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"枕上和圆机绝句梅花十有四首 其三","author":"晁说之","text":"岂是梅花最早开，六霙先已发阳台。\n泾南渭北花如锦，太白山头只有梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56097,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"枕上和圆机绝句梅花十有四首 其十三","author":"晁说之","text":"未须白眼便嫌开，早晚高低雪作台。\n春尽子山梅感叹，义山未腊已惊梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56098,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"枕上和圆机绝句梅花十有四首 其十","author":"晁说之","text":"东皇太一下无依，桂酒椒浆细奠诗。\n却问人间梅几种，郭仙尔有古人辞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56099,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"河中戏作绝句","author":"晁说之","text":"人物英雄异姓王，山河生气尚光芒。\n可怜只解誇佳丽，花落春空更断肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56100,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"直罗县三绝句 其三","author":"晁说之","text":"羌管戎歌亦斗新，长官家势洛阳人。\n相逢且觅山花好，莫话铜驼金谷春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56101,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"直罗县三绝句 其一","author":"晁说之","text":"萦回颉颃乱山河，目眩心摇到直罗。\n待得罗川平直处，晚来荀令恨如何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56102,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"直罗县三绝句 其二","author":"晁说之","text":"人生不合出都城，百坂千坡异县情。\n勃勃当年圣人道，如今狐兔不胜行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56103,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"知宗节使临渡江至金陵送蜡梅来","author":"晁说之","text":"江北江南叠鼓催，清香清泪各徘徊。\n知君清德用无尽，棹欲移时留蜡梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56104,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"试迈侄所寄冷金笺","author":"晁说之","text":"不烦钟鼓强吹萧，自有诗书共郁陶。\n暖玉何年来比德，冷金即日得抽毫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56105,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诗一首","author":"晁说之","text":"泗滨浮石岂不好，怊怅上方承眷时。\n今日道傍谁著眼，女墙犹得掷胡儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56106,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"郑州古有夕阳楼自唐末兵火后遂废况今圃田残破客中望扬州作绝句","author":"晁说之","text":"日月争流泪亦流，几年不见夕阳楼。\n太平时节古来少，却上迷楼一望休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56107,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨中","author":"晁说之","text":"雨中新种竹，波上旧来鸥。\n客子何时乐，幽人未肯愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56108,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"复入鄜城南门","author":"晁说之","text":"南走京洛道，羸骖到却回。\n只应如幕燕，自有社相催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56109,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"复作山字绝句呈圆机","author":"晁说之","text":"羊头山笑鸡头山，我粲文章尔漫顽。\n游子白头颜不少，任人讥侮亢高颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56110,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宫观请不遂拣兵戍河朔","author":"晁说之","text":"拟驾柴车反故园，却料甲士倚和门。\n桐孙竹祖俱相笑，欲肖秦音长子孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56111,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"将出江绝句","author":"晁说之","text":"脩门缥缈梦悠悠，岁暮长江斗柄浮。\n奋翼鸣鸡急自和，白头鼓枻为谁愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56112,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"将至鄜州","author":"晁说之","text":"平生心迹笑元龙，今日城边比蔡邕。\n岂是白头著书地，聊当涕泣自从容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56113,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"恨同","author":"晁说之","text":"恨同枉渚频潮汐，情与游丝斗短长。\n垂钓蛮童缘底泣，难将心事问何郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56114,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"拾康乐之意再作","author":"晁说之","text":"异时游子不须还，舍瑟含情醉醒间。\n今日烦君台上望，急挥苦泪湿千山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56115,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春尽 其一","author":"晁说之","text":"春尽天涯恨最长，啼莺不识紫游缰。\n空惊绿叶成尖发，何处残英伴落妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56116,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春尽 其二","author":"晁说之","text":"何曾有梦到瑶池，但见狂风落海陂。\n帘外飘英纷不识，谁人尚复忆辛夷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56117,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"昨日小诗同致上读张元善中散丈诗爱其读书轻富贵之句作绝句一首","author":"晁说之","text":"风流自古称张绪，诗句孰如孟景阳。\n今日读书轻富贵，当家好处得兼将。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56118,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"昼寝看壁上陈希夷","author":"晁说之","text":"昔人辛苦处难追，慵懒多閒自有奇。\n睡著不知春昼永，壁间图像傲希夷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56119,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋书","author":"晁说之","text":"秋为枣多暑，天因禾未霜。\n吁嗟尔凶虏，宜亦畏皇纲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56120,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋日有感因诵王元之送文元公诗云追思元白在江东不似晁丞今独步之句戏作","author":"晁说之","text":"三吴山水喜秋风，白蟹青虾甬水东。\n独步晁丞孙子到，谁怜憔悴众人中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56121,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋怀","author":"晁说之","text":"草木衰残意，关河离别情。\n秋风已如此，况复更论兵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56122,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绝句谢小邵寄柑脯","author":"晁说之","text":"曲肖欧文诗隐秀，山头仙驭势争飞。\n须知柑脯胜麟脯，更使荷衣笑锦衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56123,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"荔枝送郭玄机戏作 其二","author":"晁说之","text":"荔枝一骑红尘后，便有渔阳万骑来。\n郭令诸孙今得味，却同羯鼓逞诗才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56124,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"荔枝送郭玄机戏作 其一","author":"晁说之","text":"祸根妃子尝珍嗜，今日何须有荔枝。\n玉树后庭那结实，也能亡国更堪悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56125,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赵妹自咸阳寄华州石缝山芋来作绝句二首 其二","author":"晁说之","text":"秦中驩喜迎吾祖，知道官家不用兵。\n今日曾孙何所负，华山芋蓣自多情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56126,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赵妹自咸阳寄华州石缝山芋来作绝句二首 其一","author":"晁说之","text":"华州石缝无端芋，同谷斋中有恨翁。\n卯酒调来家法在，暂时不哭此途穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56127,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送二十二弟入浙","author":"晁说之","text":"世乱还家未有期，汝于何处望京师。\n韦郎旧恨今新恨，细学南音寄我诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56128,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送春","author":"晁说之","text":"雨里花开过，愁中燕到迟。\n一春都寂寞，不作送春诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56129,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"郡斋戏句 其三","author":"晁说之","text":"雪中猎户来呈虎，月下田夫走献麛。\n讳道山成应不得，关东谁肯有书题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56130,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"郡斋戏句 其七","author":"晁说之","text":"朝困十催何敢饱，暮虞百罚更生寒。\n鸡山小石凤山柳，移植庭前少自宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56131,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"郡斋戏句 其二","author":"晁说之","text":"一夫肆力能排闼，万旅无谋漫仰关。\n成败是非今有底，忍将鞭扑作威颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56132,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"郡斋戏句 其四","author":"晁说之","text":"㪷升白米能供酒，暝目红裙难听歌。\n为谢黄州王内翰，莫言官职也蹉跎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56133,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"郡斋戏句 其五","author":"晁说之","text":"萧条吏散如堪适，萧洒诗成亦可娱。\n王谢异时同惠我，只惭笔力不能俱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56134,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"郡斋戏句 其一","author":"晁说之","text":"乌髭四皓应无术，沉醉三闾岂有方。\n将此衰残斋戒里，郡人应笑使君狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56135,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"郡斋戏句 其六","author":"晁说之","text":"杂号将军人所薄，东宫赞善自曾嘲。\n如何今日余为守，黄独白?誇大庖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56136,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻八弟朝议二十一弟朝奉二十弟迪功与安郎仓部谢郎比部诸人集于葆真宫戏作绝句","author":"晁说之","text":"葆真宫是何年有，游子相将便得真。\n闻道流霞醒不醉，只应人世恨还新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56137,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻四明人不喜鞦韆因作","author":"晁说之","text":"思归未得恨深年，时节清明最可怜。\n越女腰支胜赵女，平生不敢赛鞦韆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56138,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻角","author":"晁说之","text":"边城百感漫兴嗟，客底令人警岁华。\n多谢何郎有新句，谁闻夜夜小梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56139,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻邹德久自常来州圩垾得良田数十顷遂可活辄作绝句","author":"晁说之","text":"乃公不识贾公闾，之子饥寒夜读书。\n前年避贼逐江鹭，今岁垾田鞭海鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56140,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻叔易隐居被召二首","author":"晁说之","text":"处士何人为作牙，尽携猿鹤到京华。\n故山岩壑应惆怅，六六峰前只一家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56141,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻叔易隐居被诏","author":"晁说之","text":"东海一生垂钓客，石渠万卷校书郎。\n丈人风味今如此，鹤到扬州兴更长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56142,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻胡少汲再入省","author":"晁说之","text":"南宫妙极天下选，鸡舌喜君重得香。\n既自能诗似前辈，何为不作水曹郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56143,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻钟五更起行","author":"晁说之","text":"野寺钟声报晓寒，征人方梦到长安。\n茫然涂路知难易，两避胡尘一岁残。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56144,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻圆机游山归作","author":"晁说之","text":"把酒相忘笑语违，新诗应已勒岩扉。\n何人龙尾道前出，独自鸡头山里归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56145,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻圆机游山政为梵供复用前韵作","author":"晁说之","text":"蹙缩饥肠与世违，崚嶒折屐到云扉。\n丹砂不逐飞仙去，白叠甘从佞佛归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56146,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻景龙不试灯","author":"晁说之","text":"华灯不试管弦新，八字歌声满市尘。\n今日景龙门寂寞，唯将明德照新春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56147,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"圆机用墨淡甚辄以上色三丸为好","author":"晁说之","text":"淡墨书名二十年，从军未许勒燕然。\n只疑淡墨为君累，故遣陈玄去草玄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56148,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"圆机再以梅绝句为谢复作二绝 其一","author":"晁说之","text":"根冷花难也自开，何须献纳在云台。\n几多得意人潜恨，江令伤心幽涧梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56149,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"圆机再以梅绝句为谢复作二绝 其二","author":"晁说之","text":"此日梅花剩足依，明年归只咏公诗。\n不堪霸水匆匆别，待寄越膏重觅辞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56150,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"峻极上院","author":"晁说之","text":"山下青青春已归，百花山上正芳菲。\n人间颜色易零落，百万千年云锦衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56151,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"席上有唱欧公送刘原甫辞者次日又有唱东坡三过平山堂辞者今联续唱之感怀作绝句","author":"晁说之","text":"龙门不见鬓垂丝，莫唱平山杨柳辞。\n纵使前声君忍听，后声恼杀木肠儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56152,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"旅舍朝鸡","author":"晁说之","text":"独抱微诚人不知，山公启事定何施。\n鸣鸡本候海潮信，不为金门上马时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56153,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"海陵社日","author":"晁说之","text":"信美非真美，徒劳本自劳。\n异乡今日社，寂寞食无糕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56154,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"海陵闻角","author":"晁说之","text":"秋风入角蹙山城，更觉淮南秋思清。\n惯听边威雷鼓里，梅花争发斗峥嵘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56155,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"途中遇雪二绝句 其一","author":"晁说之","text":"征裘不是谢庄衣，何事轻霙故故飞。\n应是多情要新句，敢酬琼藻触寒威。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56156,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"途中遇雪二绝句 其二","author":"晁说之","text":"惨淡修途问若何，璇蕤琼藻未须多。\n使君此夕应难醉，红玉看人子夜歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56157,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"消息","author":"晁说之","text":"两月中原消息断，不应京国亦无闻。\n庙堂如未弃黎庶，日日诏书清垢氛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56158,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病中谢张簿阳字韵诗","author":"晁说之","text":"药有一君元长厚，病教五鬼逞狂阳。\n公诗可但能除疟，万痾都如律令忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56159,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"眠睡","author":"晁说之","text":"病夫不睡情须怨，老子难眠思却清。\n况复斗横催角引，梅花烂漫散秋声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56160,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"致仕归东里","author":"晁说之","text":"板令悬车欠四年，散关如砥去欣然。\n郑州门首人争入，谁伴山翁老洧渊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56161,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"致仕后间夜雨","author":"晁说之","text":"厚矣皇恩得谢休，萧然白发更何求。\n雨声中夜生高兴，不似官人身外愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56162,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读沈下贤集绝句二呈圆机 其一","author":"晁说之","text":"晚来李杜擅文章，无奈情何忆沈郎。\n未掩西施朝薤泪，可堪弄玉暮魂香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56163,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自甘读沈下贤集绝句二呈圆机 其二","author":"晁说之","text":"荷叶拳拳恨未舒，伊人归兴问何如。\n空看蝇鼻灯花喜，不得平安一纸书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56164,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读韩退之诗有作","author":"晁说之","text":"万树残英委泥滓，柳花成絮独高飞。\n自怜纤质无人赏，宛转还从洛浦归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56165,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谈易寄壮舆","author":"晁说之","text":"拂拭尘埃艺靡它，象中系外得婆娑。\n何人为我易弟子，泪落一朝翻九河。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56166,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高二承宣与苏二左司唱和春雨诗远蒙见寄依韵和之 其一","author":"晁说之","text":"太乙池中舰，洞庭湖上篷。\n问谁今得乐，宇宙钓丝中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56167,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高二承宣与苏二左司唱和春雨诗远蒙见寄依韵和之 其二","author":"晁说之","text":"公子与王孙，何须更问耕。\n春心为花雨，梅杏尚难平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56168,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高邮人物绝句二首 其二 王令逢原","author":"晁说之","text":"高邮少年有王令，豪气雄才海内无。\n当日谈兵今可用，只愁遗像是癯儒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56169,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高邮人物绝句二首 其一 崔监伯易","author":"晁说之","text":"高邮崔监富诗书，笔力雄豪与世疏。\n不是魏公公道在，定垂白发老菰蒲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56170,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高邮忽见叔易嵩山下所寄绝句次韵和之旧所作不次韵也","author":"晁说之","text":"我忆故人头更白，故人梦我眼犹青。\n重湖叠浪君知否，正似当年翻水经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56171,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]