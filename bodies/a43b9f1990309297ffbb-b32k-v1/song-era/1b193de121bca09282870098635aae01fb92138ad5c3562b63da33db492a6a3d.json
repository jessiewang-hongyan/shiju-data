[{"title":"吴令人挽词二首 其二","author":"孙觌","text":"沄沄水东注，冉冉日西颓。\n侧手留难住，挥戈挽莫回。\n镜分天上月，剑逸地中雷。\n寂历空床夜，悲虫亦造哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6498,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"历阳通守张文举挽词","author":"孙觌","text":"六雄唐别驾，一乘汉题舆。\n自笑儒冠误，谁能刺绣如。\n彤襜方首路，画翣已随车。\n怅望城南陌，哀歌泪满裾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6499,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"通守李师稷大夫同年挽词","author":"孙觌","text":"桂籍联荣四十年，萍漂南北两茫然。\n寒暄粗接无淹晷，生死俄分有逝川。\n黄纸尚传批凤诏，青箱空掩绝韦编。\n诸郎头角皆翁似，试看煎胶为续弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6500,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"王廷茂挽词","author":"孙觌","text":"蝉联三世旧，晼晼二毛侵。\n白璧成长恸，青纶遂陆沈。\n看云空有泪，听雨若为心。\n咽咽吹箫送，哀湍共一音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6501,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"大卿范公师厚挽词","author":"孙觌","text":"籍甚金闺彦，从容玉帐筹。\n垂堂惩后戒，徙突慕前修。\n忽作隋珠弹，真成赵璧投。\n宁辞广武械，竟脱楚仪囚。\n蹇叔言犹在，殽函骨未收。\n云何即长夜，不复见焚舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6502,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"孙应求承事挽词","author":"孙觌","text":"棣萼联华满故枝，兰芽竞秀蔼春霏。\n荆州司马冯熊去，吴市仙人跨鹤归。\n绿涨一枝分柏垄，遥苍百叠拥松扉。\n仪形故有丹青在，想像平生果是非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6503,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"吴汉逸挽词二首 其一","author":"孙觌","text":"臞翁自是列仙儒，豪气骎骎若不除。\n东阁寻梅诗满箧，西郊问柳酒盈车。\n奇礓屡访陈仓鼓，古漆空存汲冢书。\n不信青山解埋玉，定应碧海控鲸鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6504,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"吴汉逸挽词二首 其二","author":"孙觌","text":"学省追攀四十年，故人重见两皤然。\n艰难共出兴戎后，奄忽安知弃我先。\n北道改辕谁解剑，西州无路相鸣鞭。\n伤心一梦成今古，忍看麒麟卧冢边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6505,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宝文李公挽词三首 其一","author":"孙觌","text":"十道观风使，三朝属老成。\n埋轮豺虎避，檄水鳄鱼惊。\n内阁徵书入，连城负弩迎。\n哀吟追往事，空复故人情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6506,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宝文李公挽词三首 其二","author":"孙觌","text":"绛雪飞丹鼎，苍云覆茗杯。\n聊从五禽戏，空使万牛回。\n拄笏看山坐，乘桴跨海来。\n仙游知有在，名字记丹台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6507,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宝文李公挽词三首 其三","author":"孙觌","text":"五纪周旋地，欣同七十稀。\n长庚陪月晓，孤鹜伴霞飞。\n忽作三休去，真成一梦非。\n不知华表上，白鹤几时归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6508,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"邵久中承事挽词三首 其一","author":"孙觌","text":"周分陜右开燕日，秦废侯家徙汉年。\n南国棠阴犹蔽芾，东陵爪蔓正芊绵。\n苍波吐月珠还浦，紫电冲星剑倚天。\n藉甚公孙望千载，书藏万卷有青毡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6509,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"邵久中承事挽词三首 其二","author":"孙觌","text":"手扶棁杖两眉厖，床下诸生拜老庞。\n讲肆共推三语妙，诗坛独受百城降。\n挥金屡费青钱万，种玉亲收白璧双。\n一卧遽先朝露尽，便随晨鼓去逢逢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6510,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"邵久中承事挽词三首 其三","author":"孙觌","text":"尺书问信墨犹新，杯酒邀欢迹已陈。\n倒屣方追尘外躅，盖棺俄作地中身。\n涛江滟滟三家渡，风树萧萧万鬼邻。\n他日故人千斛泪，会应洒向冢边麟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6511,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"张大资夫人挽词","author":"孙觌","text":"早岁乘龙见伯鸾，赐衣霞烂出齐官。\n自从东阁郎君贵，只作西池阿母看。\n紫玉箫吹丹凤去，青萍剑合两蛟蟠。\n素车白马城南路，愁见春风桂影团。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6512,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"族婶强氏挽词","author":"孙觌","text":"少日声名推大阮，一时门地数南强。\n家肥自称河鲂贵，庙荐犹闻涧藻香。\n羽化忽惊双鹤去，巢空不复九雏将。\n归魂无用哀笳送，彷佛吹箫在帝乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6513,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"王令人蔡氏挽词","author":"孙觌","text":"殿极中台应，淮流奕世祥。\n佳儿王武子，名父蔡中郎。\n传叶青毡在，谈经绛幔张。\n悬知黑头贵，已伫白眉良。\n蘋老那能采，萱留祗自芳。\n谁当授彤笔，端为刻青琅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6514,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"少保张公挽词三首 其一","author":"孙觌","text":"帝阃谋元师，斋坛属老儒。\n黄麻孚大号，皂纛拥前驱。\n便合联黄衮，犹应冠紫区。\n炎炎白昼日，奄忽下桑榆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6515,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"少保张公挽词三首 其二","author":"孙觌","text":"平土疏新渥，湛恩洞九泉。\n印悬金斗大，冠珥玉蝉连。\n坠剑今亡矣，鸣珂尚宛然。\n风流春月柳，无复似当年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6516,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"少保张公挽词三首 其三","author":"孙觌","text":"并辔天街里，联裾省户中。\n追参两班合，醉笑一尊同。\n我老犹占鵩，公豪正吐虹。\n忽骑箕尾去，悽断白头翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6517,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"周抚干挽词二首 其一","author":"孙觌","text":"手植千金产，情高一笑挥。\n怀奇空老去，种德自家肥。\n联舰收群溺，倾囷振大饥。\n谁云天未定，一鹗已横飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6518,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"周抚干挽词二首 其二","author":"孙觌","text":"谁续先贤传，犹推月旦评。\n命儒通德里，听法梵王城。\n除地黄金布，帷裳绛帐横。\n何人追旧事，扣角话三生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6519,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"领省枢相太傅信安王挽词三首 其一","author":"孙觌","text":"台路岩瞻峻，戎藩阃寄雄。\n九章公衮贵，六纛将牙崇。\n翊运三阶正，持危一栋隆。\n帝闲龙化后，冀北已成空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6520,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"领省枢相太傅信安王挽词三首 其二","author":"孙觌","text":"大号疏廷涣，中权秉帝枢。\n槐庭联上宰，芸省冠诸儒。\n国瑞麟一角，家肥凤九雏。\n便乘箕尾去，彷佛在星图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6521,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"领省枢相太傅信安王挽词三首 其三","author":"孙觌","text":"秉烛联飞盖，分茵托后车。\n兵厨千日酒，记室五云书。\n尚想仪形在，那闻语笑馀。\n龙钟随葬绋，老泪满衣裾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6522,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"永嘉郡夫人挽词二首 其一","author":"孙觌","text":"脂田开石窌，纶阁演金葩。\n綵服联三组，褕衣珥六珈。\n行携九节杖，坐驾五云车。\n便坐堂堂去，瑶台有故家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6523,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"永嘉郡夫人挽词二首 其二","author":"孙觌","text":"蔽芾斗城春，平反迹未陈。\n神驰一丹旐，泪湿两朱轮。\n故物悲萱草，哀吟念棘薪。\n室传青简上，千载望光尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6524,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"运使直阁郎中张公同年挽词三首 其一","author":"孙觌","text":"忽作霜松折，犹残旧桂丛。\n仙山芸阁冷，郎署粉闱空。\n节荡函金虎，车轓掩画熊。\n凄凉追往事，忍看一旌红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6525,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"运使直阁郎中张公同年挽词三首 其二","author":"孙觌","text":"门表尚巍昂，尊名擅一坊。\n珂鸣非故里，星聚有新堂。\n月暗乌啼夜，风高雁折行。\n吾生如寄耳，端是橘中藏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6526,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"运使直阁郎中张公同年挽词三首 其三","author":"孙觌","text":"学省周旋地，三朝四纪中。\n同听对床雨，共咏舞雩风。\n少日借千佛，残年独两翁。\n那知有存没，老泪落新宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6527,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"鲁国太夫人文氏挽词三首 其一","author":"孙觌","text":"席宠千龄盛，疏荣一品尊。\n魏公丞相妇，潞国太师孙。\n连骑珂鸣里，交柯戟拥门。\n平生种玉手，尽室满瑶琨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6528,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"鲁国太夫人文氏挽词三首 其二","author":"孙觌","text":"移孝繄慈母，遗忠有世臣。\n挺身安国步，抗节犯戎尘。\n锡壤开东鲁，持枢拱北辰。\n宁须待彤笔，诏墨在丝纶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6529,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"鲁国太夫人文氏挽词三首 其三","author":"孙觌","text":"鼎餗羞嘉飨，溪毛荐德馨。\n来符虺蛇梦，去嗫凤凰翎。\n盛事垂千载，华年阅九龄。\n凄凉便尘迹，柏垄自青青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6530,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过洞庭","author":"孙觌","text":"千尺银山屹嵩华，浪涌云屯天一罅。\n榜舟夜傍鼋鼍窟，杖藜晓入鸡豚社。\n处处人家橘柚垂，竹篱茅屋青黄亚。\n台殿青红坠半山，两腋清风策高驾。\n牛羊出没怪石走，蛟蛇起伏苍藤挂。\n饥鼠窥灯佛帐寒，华鲸吼粥僧趺下。\n世味饱谙真嚼蜡，老境得闲如啖蔗。\n山灵知我欲归耕，一夜筑垣应绕舍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6531,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"中兴颂","author":"孙觌","text":"水部天宝中兴碑，浯溪摩崖天与齐。\n龙亡虎逝今已矣，太宗社稷犹巍巍。\n泗滨九鼎不复出，陈仓石鼓今已非。\n岿然独立湘水上，往往或有神司之。\n我亦系舟石壁下，老眼惊顾眩欲迷。\n星图错落树挂斗，云物黯淡天投霓。\n遗忠寂寂閟千载，山颓木坏知河□。\n踟蹰对立三太息，风雨夜啸猩鼯悲。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6532,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"枢密胡公进诸子于学年方冠强记博览颖悟过人某每过公清夫廉夫立侍公侧赋巨题押强韵率有奇语叹爱之余作诗传坐客云","author":"孙觌","text":"于菟生而斑，骐子堕地走。\n眈眈百兽长，矫矫六龙友。\n家庭传吉梦，释氏曾抱送。\n英英玉雪如，连璧见二仲。\n读书夜不眠，历历数十年。\n吟成一寸烛，笑拍郊贺肩。\n聚讼破三语，下笔先风雨。\n妙句出锦囊，陈言陋盐絮。\n辟易四坐惊，难弟有难兄。\n传观莫放手，掷地有金声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6533,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和叔毅田园五首 其一","author":"孙觌","text":"投组弃不御，负耒行且耰。\n颓景谢东嵎，新畬遍西畴。\n烟墟牛羊夕，水岛橘柚秋。\n呼儿具鸡黍，一醉漫烂酬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6534,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和叔毅田园五首 其二","author":"孙觌","text":"休文固多病，长卿亦倦游。\n敢厌蓬荜陋，渐喜桑榆收。\n散策尘外往，脱屐区中留。\n坐看黄叶落，一洗风雨秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6535,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和叔毅田园五首 其三","author":"孙觌","text":"风旗喜初泊，野马不受鞿。\n万里涨江急，一棹秋风归。\n意行心自放，隅坐谈更剧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6536,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和叔毅田园五首 其四","author":"孙觌","text":"晨耕馌箪壶，夜绩课絺绤。\n感时百忧集，遇酒一笑适。\n五湖波浪阔，勿厌田庐窄。\n土膏燥不粘，山骨寒更瘠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6537,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和叔毅田园五首 其五","author":"孙觌","text":"伤心离离黍，触目青青穸。\n空畦理荒秽，流润滋霖霢。\n努力会有年，喜见乞浆客。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6538,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"得子次叔毅韵","author":"孙觌","text":"病木空中穴万蚁，龙卧泥蟠鞭不起。\n老气干霄四十围，雷折苍皮半生耳。\n人言种木十年期，桐已生孙竹有儿。\n添丁哇笑已堪喜，老干轮囷只自奇。\n刀头舐蜜何草草，平地变作褒斜道。\n我独爱之遗以安，家住鹿门山窈窕。\n阿奴碌碌在眼中，逢时不愿黑头公。\n三尺茅茨十具牛，不如长作多田翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6539,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"阅古阁","author":"孙觌","text":"劝君慎莫学为儒，令君甑釜生虫鱼。\n啼饥号寒祇四壁，拄腹撑肠谩五车。\n邓侯种德如种木，千金买书书满屋。\n缥缈玉京十二楼，纵横牙签三万轴。\n鄱阳太守笔如椽，雄文大字青瑶镌。\n千载风流追岘首，名字永与羊公传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6540,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"何利见新居四咏 其一 种德堂","author":"孙觌","text":"种德固自期百年，阴功可以宥十世。\n地灵崛郁荫万家，门大峥嵘纳千驷。\n老椿已老卧山根，戢戢阶庭满兰蕙。\n王郎故有青毡存，郑公又改缁衣敝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6541,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"何利见新居四咏 其二 停云阁","author":"孙觌","text":"桃李卧开樱半吐，嗟我怀人道伊阻。\n偶来见此衣上云，忽去已作山下雨。\n青青可藉草忘忧，昵昵如闻花解语。\n举鞭试问并州儿，酩酊醉翁在何许。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6542,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"何利见新居四咏 其三 偃寂轩","author":"孙觌","text":"玉辂亲巡万里沙，金鞭断折五侯家。\n胡尘阗空箭满眼，天地黤惨推龙蛇。\n何郎筑室山间曲，桃花流水空藏遮。\n一榻清风驾两腋，尚嫌蚁斗静中哗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6543,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"何利见新居四咏 其四 燕起轩","author":"孙觌","text":"竹坞松窗静者居，醉乡一梦追华胥。\n乱山攒青霭崷崒，老树偃翠横扶疏。\n主人投辖防客走，醉倒自有蛾眉扶。\n烁烁笼灯红一朵，孤芳独自占春馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6544,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"祥符寺大梅一树临水初开","author":"孙觌","text":"石梁茆屋雨苍苔，春风一笑冰容开。\n微澜浸月卧疏影，一枝的皪横江梅。\n含情不语立雪久，飞步欲去凌波回。\n纷纷红紫莫浪出，我欲楚些招归来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6545,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿天宁寺","author":"孙觌","text":"屋漏我无愧，室暗那可欺。\n老僧对清夜，浙风动伽梨。\n谆谆面墙壁，皎皎分渑淄。\n燎蚊隔烟语，闻鸡起蓐炊。\n我来何所见，兴尽意辄随。\n相逢不相识，聊问姓名谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6546,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次苦竹渡","author":"孙觌","text":"浮云涨天黑，锻此百鍊兵。\n匣卧韬白月，手挥沸奔星。\n风尘剑三尺，削尽多垒平。\n往往失其柄，倒戈来抗衡。\n养虎恐遗患，媚蟆终自盲。\n君子善藏之，绿林正横行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6547,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"简泽民","author":"孙觌","text":"穷途栖栖傍阡陌，俗态纷纷斗筲窄。\n杀牛毁车欲何向，握食解骖谁召客。\n吾髯一诺黄金百，醉溺应怜厕中客。\n萧萧穷巷席为门，不信陈平死糠覈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6548,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"诵次魏诗","author":"孙觌","text":"歌终白玉烂，梦觉黄粮熟。\n斯人已寂寥，皎皎在空谷。\n谁令黔首愚，竟坐城旦读。\n光芒丰城剑，恸哭荆山玉。\n邹郎乃其徒，阅世何烛局。\n高风渺不嗣，句法此遗躅。\n火攻真下策，吊古悼秦俗。\n骊山一炬燔，鸡林万金赎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6549,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"示长文","author":"孙觌","text":"于公种阴德，门大端可期。\n无钱囊更空，有子家自肥。\n戢戢树九畹，濯濯秀一枝。\n坐客瞩青眼，馀子让白眉。\n盐絮出妙语，春草先梦思。\n诗文未可量，家学岂其师。\n五车傥足用，万里到不疑。\n非无昂父贤，且伴济叔痴。\n芝兰莫当户，桃李自成蹊。\n它年一樽酒，名与少陵齐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6550,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"郭守冰花诗","author":"孙觌","text":"云藏红树三生缘，地涌青莲诸佛现。\n又见冰华此夜开，一盖亭亭倚天半。\n月中桂树影婆娑，海底珊瑚光璀璨。\n褰帘已化白银阙，照室尽成青玉案。\n悬知不受众目怜，端为使君娱一盼。\n何用孤松腹上生，行向三槐庭下见。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6551,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"武进王丞二首 其一 欣荣亭","author":"孙觌","text":"客有倦游者，置居在西畴。\n平生会心处，高引寄一丘。\n吟窗山入坐，钓濑雪满舟。\n更秉西园烛，宽我千岁忧。\n仍倾中山酒，浇此万斛愁。\n出门何所诣，真欲老菟裘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6552,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"全州道中","author":"孙觌","text":"桑柘十里交，乌犍随两童。\n川平牛背稳，一笛横秋风。\n漠漠水云里，濛濛烟雨中。\n人牛相尔汝，行过乱山东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6553,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"丰绩堂","author":"孙觌","text":"惊沙扑面犬羊腥，坐啸胡床却五兵。\n未忍焚庐攻腐鼠，要须劈水脍长鲸。\n收身且护千金璧，琢句尤夸五字城。\n筑室挂冠真漫耳，麒麟图画有高营。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6554,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寒食","author":"孙觌","text":"月落乌啼古木昏，宿云未敛日光暾。\n闭门喧豗百贾闹，尘埃一觉车云奔。\n据鞍已觉朝市远，细路渐入桑麻村。\n累累青冢繄蓬颗，风扫露沐松为门。\n魂飞骨冷唤不觉，只鸡斗酒聊相温。\n种种闲情便愁绝，行歌野哭不堪闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6555,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"舟次宁陵","author":"孙觌","text":"万舸连樯夜鸣柝，舟师鼻鼾风雷恶。\n何人勃窣夜深行，微步凌波上船阁。\n骎骎舐纸欲窥窗，稍稍开扃见门钥。\n櫜空甑倒无一锥，暗里不堪供摸索。\n吠形时听犬吽呀，戒晓已闻鸡呃喔。\n人穷智□亦可怜，与汝徒行吾更怍。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6556,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"泊陈留","author":"孙觌","text":"野水半篙碧，酿成归意浓。\n繁霜挟夜气，微露点秋容。\n嚼蜡有何好，尝胆聊自攻。\n翛然发深省，不待五更钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6557,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"奉祠朝日饮卯酒就寝既觉庭中萧然已无行迹马上赋诗","author":"孙觌","text":"萧晨按节齐房弭，冠盖环趍垤争蚁。\n屐声籍籍海上潮，人语喧喧日中市。\n明朝途人践刍狗，云散风休真梦尔。\n不须强记刻舟痕，满地苍苔馀屐齿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6558,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"读范周士诗卷二首 其一","author":"孙觌","text":"客舍空山里，丛祠古道旁。\n飘飘云外思，兀兀酒中藏。\n巧丽诗无敌，惊窥首一昂。\n缄封休浪出，珍重锦为囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6559,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]