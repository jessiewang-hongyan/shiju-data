[{"title":"禅人并化主写真求赞 其三一二","author":"释正觉","text":"形衰柳蒲，心老江湖。\n鱼潜波路静，鹤梦月巢孤。\n不损色香三昧手，粉黏双股理华须。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10882,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一六五","author":"释正觉","text":"鼻似截筒长，目如点漆光。\n据床握拄杖，河汉夜来霜。\n云山苍苍，水天茫茫。\n烁迦罗，眼三角。\n舜若多，身十方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10883,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二○九","author":"释正觉","text":"静而不纷，野而不文。\n丘壑身心麋鹿共，江湖风月白鸥分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10884,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二一五","author":"释正觉","text":"天庭宽而祖宗光，地阁阔而儿孙昌。\n中间鼻孔自家底，出气通快浑不妨。\n坤六短，乾三长。\n饱丛林汉休雌黄，今年蚕食两叶桑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10885,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其十六","author":"释正觉","text":"气貌棱棱，眉目温温。\n一脉之分派发昆崙之源，百川之吞潮落珊瑚之根。\n风烟清远秋之痕，草木秀拔春之恩。\n古壁之梭兮蛰龙之骨，寒潭之璧兮夜月之魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10886,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一二二","author":"释正觉","text":"疏豁性情，谷虚而不盈。\n舒散胸肤，冰涣而不凝。\n恁么来也，触处相应。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10887,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其六","author":"释正觉","text":"岩壑之间，草木之阳春。\n江湖之上，风烟之精神。\n发须野雪，眉目秋津。\n渊默入寒蟾之窟，圆明养老蚌之珍。\n步步入尘，门门出身。\n莫愁指端兮焦尾之曲，可意钩上兮赤稍之鳞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10888,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二二六","author":"释正觉","text":"两眼深秀，双眉下垂。\n面目严冷，身心古锥。\n云水盘游，寻常梦于行脚。\n丛林寂默，三十年之住持。\n穷河汉于昆崙之椒，渊源亲到。\n拈斗杓于混沌之外，佛祖犹疑。\n变通不倦，施设随宜。\n向道刹尘机用稳，却嫌石火电光迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10889,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三一三","author":"释正觉","text":"高岩之雪兮颠毛衰白，远水之秋兮眼棱寒碧。\n气清夜永兮月低，斗冷河空兮露泣。\n借伴之机，起家之力。\n二仪万像兮相与流通，十方三世兮自然平出。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10890,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其十","author":"释正觉","text":"山覆雪兮一颠白，水深秋兮两眼青。\n卦爻初作象，皮骨自成形。\n混沌已前之朴，阴阳未判之灵。\n道传不出世佛，义备勿开题经。\n应兮云月，用也雷霆。\n有守而涵海镇岳，无羁而断梗流萍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10891,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一二三","author":"释正觉","text":"锦云晚晴，璧月夜明。\n妙心无住住，幻事不生生。\n天际冥冥雁字没，潮痕滟滟鲸波平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10892,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三二三","author":"释正觉","text":"心心无住，了了有据。\n河汉横秋，斗柄濡露。\n须菩提坐禅，憍尸迦雨华。\n蚌含明月兔怀胎，勘破少林传底句。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10893,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其五","author":"释正觉","text":"口阔鼻隆，神静心空。\n雪芦岸棱远，水天秋色同。\n夜寒北斗垂金柄，月落西山藏玉弓。\n真机宛转，幻住圆融。\n古佛自然交露柱，翻手覆手看变通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10894,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三○四","author":"释正觉","text":"霜之须，雪之颅。\n竹之腹，松之肤。\n河汉拍天岸，魁杓旋夜枢。\n珊瑚林月长鲸?，琥珀松巢老鹤呼。\n竿头丝线从君弄，不犯清波意自殊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10895,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三三七","author":"释正觉","text":"默成用密，智空理得。\n历代祖心选同科，三世佛口闲挂壁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10896,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三八○","author":"释正觉","text":"默默有句兮祖祖相传，心心无住兮灵灵自然。\n石蕴玉而辉山，渊含珠而媚川。\n千亿门开弥勒弹，三十年用俱胝禅。\n一乘底事，百草头边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10897,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二五九","author":"释正觉","text":"事不在容，智不到宗。\n待云雷而陶壁梭蛰，授衣钵而卢老逃舂。\n犀通半夜月，鹤梦千年松。\n白发苍颜跛挈公，时人相笑老龙钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10898,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其十五","author":"释正觉","text":"顶雪抗春，目寒射人。\n蓑裹江湖雨，斗浮河汉津。\n拙忘机兮抱瓮，妙不传兮斲轮。\n谷鸟岩华自声色，十方普现刹尘身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10899,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一五九","author":"释正觉","text":"山肥拥云，水明濯月。\n动随偏正往来，静见离微出没。\n得万像之根源，识诸缘之窠窟。\n相随来也，不遗毫忽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10900,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三二八","author":"释正觉","text":"劫壶廓空，一句圆通。\n苔生玉殿，体露金风。\n妙尽不知处，光回还借功。\n鉴像之缘而妙触非受，谷神之应而随呼不穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10901,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二六○","author":"释正觉","text":"槁木之形，谷神之灵。\n水冷看秋色，天空垂晓星。\n一点心明兮非台之镜，大千卷出兮破尘之经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10902,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二二○","author":"释正觉","text":"蒲寒柳衰，融懒顾痴。\n坐稳实踰劫，心空佛是谁。\n明而了妙，微而入离。\n天清河汉阔，露冷斗杓垂。\n借伴而来应供，分身在处成规。\n百草头边春浩荡，黄莺之语对华枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10903,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一六一","author":"释正觉","text":"白发半山雪，青瞳两眼秋。\n的的环中意，绵绵方外游。\n虚空说法何须口，万像森罗自点头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10904,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一六四","author":"释正觉","text":"须发老白，眉目穷愁。\n六窗寒照雪，一点冷摩秋。\n乾处著脚，闹里刺头。\n枢静机活兮，全放全收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10905,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二九○","author":"释正觉","text":"百般千样，会归一相。\n一相无相识也无，廓与虚空等其量。\n河淡秋清，夜寒月亮。\n提携出也来人间，明明历历诸缘上。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10906,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三六六","author":"释正觉","text":"一切相空，其后之心。\n一切心空，其后之相。\n幽谷云生，寒潭月上。\n应因缘平定二仪，了幻化森罗万像。\n恰恰不疑，如指诸掌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10907,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三六○","author":"释正觉","text":"雪发霜须，鲵齿鸡肤。\n年侵蒲柳，日在桑榆。\n用持智之大柄，静守道之元枢。\n而今百草头边用，妙得云门一字俱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10908,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三四五","author":"释正觉","text":"拄杖倚床，默而成章。\n夜月通犀角，秋空没雁行。\n清写芭蕉雪，秀盛芙蓉霜。\n青原价问庐陵米，会有知音句厮当。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10909,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三六五","author":"释正觉","text":"有应之身，无位之人。\n随方而见，妙触而神。\n山林森森春在木，江湖澹澹秋生津。\n语不投机不展事，云门一路从来亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10910,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其四二二","author":"释正觉","text":"颦而嗔，伸而悦。\n默传鼻孔家风，用付眉毛时节。\n放下机投，展开漏泄。\n十方三世兮同得同参，二仪万像兮同听同说。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10911,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一九五","author":"释正觉","text":"默默之语，如如绝虑。\n野水有秋，閒云无雨。\n十方三世兮无我安排，六道四生兮非吾行伍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10912,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二六六","author":"释正觉","text":"默默神澄，棱棱气清。\n河汉之月耿耿而不夜，蒹葭之风凄凄而有声。\n相逢便说无生话，万像森罗作證明。\n佛灯未寒，祖华未残。\n其传今到你，其事素来难。\n座须诸法空为句，经在微尘破处看。\n而今呈似，莫道相谩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10913,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二八六","author":"释正觉","text":"额高眼深，该抹丛林。\n人惊大胆，我自无心。\n默转机梭路，谁投钵水针。\n觌面相呈了也，抬头何处相寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10914,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三三六","author":"释正觉","text":"癯形老残，孤节岁寒。\n照顶髑髅眼，随缘赤肉团。\n六街三市寻人去，相唤门门尽是檀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10915,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三","author":"释正觉","text":"松节老刚，岩棱早霜。\n鸥閒沙漠漠，雁没烟苍苍。\n爻象乾连坤断，形器规圆矩方。\n闹市相逢聊举似，东家杓短西家长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10916,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三四二","author":"释正觉","text":"性了有馀，体含太虚。\n心空历历，道契如如。\n答响神居谷，随缘井觑驴。\n向道尘尘住三昧，何妨触处卷而舒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10917,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二八三","author":"释正觉","text":"去就清贫，担何苦辛。\n兀默三椽老，平生五合陈。\n出家意谓了身，住院还相累人。\n野水连天半夜月，丛林和气十方春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10918,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其四○七","author":"释正觉","text":"湛乎性源，游乎度门。\n动静出碍，方圆不痕。\n寒木得春晚，雪窗亡夜昏。\n通塞也虚离实坎，变化也连乾断坤。\n六和合而无功兮脱略三千之界，万差别而有据兮齐承一点之恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10919,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二七二","author":"释正觉","text":"默而耀，虚而照。\n借用不悭，合体无兆。\n石牛卧而青山寒，木马嘶而明月晓。\n有底般人，相逢恰好。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10920,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三一一","author":"释正觉","text":"颠毛之丝，眼角之黐。\n是身颓老，与世支离。\n枯禅心了了，空劫鼻垂垂。\n晓寒霜结，山川薄霁。\n夜月行河汉，迟借伴还来。\n机用妙不销，弹指知音知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10921,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三七六","author":"释正觉","text":"山带雪而岁寒，水含月而夜阑。\n对机转物，影草探竿。\n游刃之牛解，烂柯之局残。\n西风雨敛烟云净，北斗脚垂河汉乾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10922,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其四二一","author":"释正觉","text":"鉴之现像，谷之藏神。\n六门随万汇，三昧入诸尘。\n月通犀角晕，华到蜜房春。\n历历之机果明了，更嫌何处不相亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10923,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二九二","author":"释正觉","text":"面皮微紫，眸子深青。\n默臻阃奥，妙得门庭。\n彻见二仪成一体，明知万像不他形。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10924,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二八七","author":"释正觉","text":"锁口而禅，篾腹而饿。\n透出劫空心相微，不见秋毫身量大。\n法憙为食，法空为座。\n毗耶门户打开，少室家风觑破。\n言满天下兮，而无口过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10925,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二六三","author":"释正觉","text":"出入离微，偏正之机。\n变通动静，杀活之柄。\n飞流电火兮持林际之威权，函盖乾坤兮得云门之号令。\n相随百草头边，恰恰初无欠剩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10926,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三○八","author":"释正觉","text":"兀兀堆堆，髑髅眼开。\n全身放下，借伴还来。\n一弹指响流通句，楼阁门门见善财。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10927,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三三一","author":"释正觉","text":"年齿垂垂，须发丝丝。\n月寒无影树，春在未萌枝。\n得失折肱塞人马，输赢烂柯樵子棋。\n示现威仪而不起灭尽之定，不由心念而自然圆明之知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10928,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一五三","author":"释正觉","text":"轻重之衡，妍媸之鉴。\n堂堂类而莫齐，的的混而不滥。\n身世闲闲，情田淡淡。\n秋水澄澄，江鸥泛泛。\n一点彻底兮丛林渊源，万化夤缘兮葛藤枝蔓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10929,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三○二","author":"释正觉","text":"雪发霜须，风袖烟裾。\n空壳累于可卜，木蠹偶以成书。\n豹雾之虎，龙雷之鱼。\n变化复何日，升腾似有初。\n旧时行履故然改，向道而今井觑驴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10930,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其四一五","author":"释正觉","text":"渊默而明，湛存而妙。\n三世齐平，十方圆照。\n月随水而流，风入松而啸。\n相逢会有知音，向道自然同调。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10931,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二三四","author":"释正觉","text":"发须衰白而霜雪益深，肌肤苍老而松桂剥皴。\n四十馀年而穷通一默，百千三昧而游戏诸尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10932,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二七八","author":"释正觉","text":"是心绝缘，寒灰不然。\n是身无我，芭蕉不坚。\n独灵兮卓卓，湛存兮绵绵。\n春逐华枝长短，月随水器方圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10933,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一八○","author":"释正觉","text":"应现般般，初无异端。\n春昼华丽，月明水寒。\n界方四棱榻地，珠圆一向走盘。\n呈似识与不识，请君急著眼看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10934,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其四十六","author":"释正觉","text":"灵灵一物，名模不得。\n长鲸居沧海之渊，老兔卧明月之窟。\n已展不缩，拗直作曲。\n只么赢时会也无，不须喝彩兮盘中双六。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10935,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其八十二","author":"释正觉","text":"赤肉凿窍，乾骨裹皮。\n自然无我，你道是谁。\n双瞳秋点点，两鬓雪丝丝。\n筇倚床头不去诸方行脚，口挂壁上欲学古人住持。\n渊默有句，真得无师。\n崖蜂春采薝卜华，海鸟梦卧珊瑚枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10936,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三二九","author":"释正觉","text":"规圆矩方，凫短鹤长。\n落日烟村牧笛，平湖月夜鱼榔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10937,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三○一","author":"释正觉","text":"棱眉苍厖，壑眼碧双。\n未开蛰户，谁识漳江。\n不须狡兔治三窟，自有孤猿应六窗。\n运水般柴呈妙用，儿孙事业更摐摐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10938,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其五十五","author":"释正觉","text":"寒坐无言，孤藤在拳。\n片心群像外，一句万机前。\n身闲眼活，盘滑珠旋。\n虚空故无壁落碍，解了十方三世缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10939,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二七五","author":"释正觉","text":"真非真，假非假。\n是影是形，成幻成化。\n根门随处拽得回，声色自然骑与跨。\n耕翻海月之泥牛，游遍春阳之木马。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10940,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二九七","author":"释正觉","text":"地水火风，因缘会同。\n见闻知觉，门户疏通。\n随宜而得用，及尽而亡功。\n明白机轮还自转，相逢谁识大家翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10941,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三六四","author":"释正觉","text":"疏齿如鲵，皴皮若鸡。\n万机顿削，一句全提。\n湛存性海阔，圆明心月低。\n有信风雷还破蛰，无言桃李自成蹊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10942,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二一○","author":"释正觉","text":"全心之相，全相之心。\n写成这个，聊应而今。\n天苍苍兮白鸟没，水深深兮红鳞沉。\n月钩云饵，玉线金针。\n一般料理兮，妙出威音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10943,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三六七","author":"释正觉","text":"清净本然，和合因缘。\n涅不缁而磨不磷，仰弥高而钻弥坚。\n随之无后，迎之无前，空空空处亡中边。\n而今信手拈来用，头尾相应正复偏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10944,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二二二","author":"释正觉","text":"清白之标，庄严匪销。\n袁安卧雪，许由弃瓢。\n不萌枝上春苒苒，无影树下秋寥寥。\n借伴入廛来买卖，相逢莫怪不相饶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10945,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三五一","author":"释正觉","text":"为僧?剞，与世支离。\n目瞳青炯炯，头发白丝丝。\n劫空有句，真得无师。\n借功分照用，借位解提持。\n万像森罗一音说，何须特地挂唇皮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10946,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]