[{"title":"舣舟怀信亭","author":"宋祁","text":"使麾得请印垂腰，不畏秋风病鬓凋。\n游子已携河上手，客槎犹在斗边桥。\n水从南浦伤离剧，马近东方作意骄。\n晓榻梦回翻自愧，卧听人赴午门朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47290,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"览聂长孺蕲春罢归舟中诗笔","author":"宋祁","text":"姑山羽客冰为骨，金掌仙人露代餐。\n化作妙辞真扣玉，写成初藁剩惊鸾。\n心随零雨濛濛密，恨过清溪曲曲寒。\n此秘东阳誇未睹，灵均千载有馀叹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47291,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贵溪周懿文寄遗建茶偶成长句代谢","author":"宋祁","text":"茗箧缄香自武夷，陆生家果最相宜。\n烹怜昼鼎花浮栅，采忆春山露满旗。\n品绝未甘奴视酪，啜清须要玉为瓷。\n茂陵渴肺消无几，争奈还书苦思迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47292,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺中丞晏尚书春阴","author":"宋祁","text":"轻寒剪剪著春旗，楼外晨光已暗移。\n小雾不还添柳弱，馀寒未去恼花迟。\n幺弦促柱愁成曲，远水迎船巧作漪。\n谁在河桥望归客，莫将雷响误轻辎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47293,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺齐都官","author":"宋祁","text":"十行泥检润琼芝，序转仙曹汉省闱。\n月隐偃波三署笔，光添侍史五时衣。\n星躔入夜哀乌动，军盖迎晨雊雉飞。\n几日霄涂归奏御，景龙妍唱掩牙绯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47294,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺紫微舍人改镇","author":"宋祁","text":"星翼分疆镇上游，江山和气拥行舟。\n芝房照露供盘剂，萍日横波送棹讴。\n楚塞路长云恋幕，孺亭天晚月呈钩。\n汉家夜席归期近，宫箧书空谤焰收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47295,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赴直马上观市","author":"宋祁","text":"上直驱羸马，凌晨望百廛。\n垆喧涤器市，箫暖卖饧天。\n流水随轻毂，翻花送驶鞯。\n区区市门吏，无复子真仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47296,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赴调","author":"宋祁","text":"编政黄堂碧鹳衣，远餐周粟位犹卑。\n人推东鲁丘园秀，吏得西京法令师。\n骊驾路长云拂盖，鹄歌亭晓桂凝卮。\n上书自荐时非晚，囊牍三千正集帷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47297,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"退居五首 其五","author":"宋祁","text":"勇退方藏密，营生信有涯。\n千株素封栗，五色故侯瓜。\n虞骨诚非媚，潘毛故易华。\n履穿谁复问，新进竞青緺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47298,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"退居五首 其四","author":"宋祁","text":"利固惭龙断，长非累纆牵。\n难求迎鲋水，空望戴盆天。\n喘急常悲月，惊多遂恶弦。\n诚非穷者叹，民颂正尧年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47299,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"退居五首 其三","author":"宋祁","text":"昔愧公车牍，今投海岸簪。\n逢齑还忌热，居陆更忧沈。\n楚岫偏藏玉，燕台岂乏金。\n前途见杨阮，只是有沾襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47300,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"退居五首 其二","author":"宋祁","text":"贫极非关病，忧多信自伤。\n悲歌一顷豆，惊馈五家浆。\n拥耒宜耕石，沈钩岂为璜。\n中林环室在，开径望求羊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47301,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"退居五首 其一","author":"宋祁","text":"干禄非三釜，躬耕恋一丘。\n才无作奏巧，穷有著书愁。\n雀噪门罗晚，蓬飞鬓葆秋。\n平生鸥鸟志，未去恋沧洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47302,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送丁殿直郴阳监军","author":"宋祁","text":"渠浪撼残星，飘然飏彩舲。\n怀人送归客，短候续长亭。\n望寺□垂组，还书待杀青。\n无妨军垒隙，壶柘侑宾醽。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47303,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送人归衡阳","author":"宋祁","text":"别曲惨鹍鸡，沿湘望翠微。\n人从南浦别，客向洞庭归。\n晓雁并芦远，宵禽负叶飞。\n还家落秋后，社橘老金衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47304,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送万池秀才","author":"宋祁","text":"有客柅征轮，羁怀慰蓼辛。\n来乘访戴雪，归趁浴沂春。\n酒所留飞盖，谈馀换爨薪。\n异时更月品，知冠汝南人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47305,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送马房","author":"宋祁","text":"百五天长甚雨回，祖筵离思冷如灰。\n骋辞睢苑繁云散，拄颊西山晓气来。\n草色不须争去袂，花光正欲傍迎醅。\n相君卧镇群英集，一府翘然用楚材。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47306,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送元诤归中岩","author":"宋祁","text":"景陵同坐贯花筵，日月飞驰三十年。\n两股寻回江上锡，一灯分照剑南天。\n岩云护钵龙降咒，林露侵衣鹤警眠。\n此地相逢须重别，在家灵运已华颠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47307,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送友人赴举","author":"宋祁","text":"玉树扶疏入紫烟，鸣驺偕计望甘泉。\n十行深诏言成綍，三道摛华藻掞天。\n泽国东风占鹊喜，杏园初日待鸾迁。\n自嗟拥鼻沈冥极，生看青云著祖鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47308,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送天雄监兵李中吉","author":"宋祁","text":"督府监军重，清时握节荣。\n长云抱汉垒，残月偃边兵。\n戍雾渔挝叠，衢风鹤盖平。\n不应烦暑路，河朔趁飞觥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47309,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送太尉相公赴镇安军二首 其二","author":"宋祁","text":"碧波三宿暂沿洄，豹尾双驱大旆开。\n堂上谟成萧宰去，人间事少赤松来。\n岩霖旧润为轩雨，醴曲馀甘作宴醅。\n下客无缘陪后乘，只应前席欠邹枚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47310,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送太尉相公赴镇安军二首 其一","author":"宋祁","text":"连章得请避洪钧，赭案除书天下闻。\n久冠鹓鸾为上宰，别驱貔虎作中军。\n单车款曲怀辽帐，一燧平安出陇云。\n今日朝绅回首看，始知知退是元勋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47311,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送太常边博士守永嘉郡","author":"宋祁","text":"稷野英僚抱蕝新，东瓯假守左朱轮。\n吴刀列卫州仪盛，越镈催耕海葑春。\n萍渚日华摇使旆，蜃天楼影暗潮津。\n射堂西出宾簪乐，飞尽歌梁几夕尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47312,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送屯田张中行罢成德军通判还朝","author":"宋祁","text":"中山花下举离樽，缟发萧萧重黯魂。\n假节共辞金马闼，满更先入玉关门。\n弥年锦帐残香燎，几夕兰陔撷露痕。\n早伏青规奏边事，五芝泥熟待新恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47313,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送王太尉被召归觐","author":"宋祁","text":"汉廷择日筑韩坛，绿诏连催觐帝关。\n十乘元戎方叔贵，九天鸣鼓亚夫还。\n袍薰瑞气葱葱外，仗入清尘九九间。\n好为君王言敌事，早将功业勒燕山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47314,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送王龙图镇秦亭","author":"宋祁","text":"皂衣京兆数论兵，西护秦台暂抗旌。\n显父百壶连帐出，良家六郡佩鞬迎。\n甘泉路迩烽槔偃，非子川长马庌平。\n左右汉臣聊作帅，非缘侍从厌承明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47315,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送王识游洛阳","author":"宋祁","text":"上京漫客刺，西道掺离裾。\n天倚呼嵩外，川横斗谷馀。\n敝襓琴晦轸，行笈简联书。\n却见槐花候，期君促计车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47316,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送王庾 其一","author":"宋祁","text":"土甑残炊黍，津航促扣舷。\n云迷孝王苑，星认太丘躔。\n破瑟弦鹍舞，吟囊锦兽鲜。\n晚淮他夜月，离思共娟娟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47317,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送王庾 其二","author":"宋祁","text":"倦客衣空化，求知刺欲漫。\n孤飞回鹢路，别泪溢鲛盘。\n待举秋槐老，承颜夏枕安。\n新篇时寄我，鱼信接长澜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47318,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送王鼎同年尉荥阳","author":"宋祁","text":"毡毫联署榜，兰酒怅离杯。\n作吏缁衣国，工吟白社才。\n浮凉御风至，澄翠溢荥来。\n盗息连殊课，章封刺史台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47319,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送长兄游随阳","author":"宋祁","text":"汉东烟树露蝉嘶，回首周南涕易危。\n梁苑谩传居右赋，扶风谁识最良眉。\n仙巾雨垫愁怀路，素壁尘凝忆问诗。\n他夜梦魂知不远，蘧蘧长绕越禽枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47320,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送令狐秀才赴举","author":"宋祁","text":"荐衡上表独垂蜺，密雪梁园逼赋期。\n秦市千金怀拱璧，舜韶九奏待长离。\n刘桢病久曾淹卧，宋玉才多故剩悲。\n几日绣衣荣白昼，郡章惊绂驷车驰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47321,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送冯彭寺丞长兴知县","author":"宋祁","text":"天外仙凫舄影翻，河干画鹢棹声喧。\n奇才欲向菰芦国，丽赋空留霰雪园。\n短柳摇摇迎去袂，初花的的伴离樽。\n汀蘋续赏饶清思，为拂吴兴旧墨痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47322,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送史温虞部佐郡四明","author":"宋祁","text":"外署清郎出佐州，嘲辞不畏上山头。\n天中倦目迷云阙，江上归帆避石邮。\n佳设自随宾早晏，还书宁畏渚沈浮。\n疁田越镈农知劝，时伴春旗暗绿畴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47323,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送叶苏州","author":"宋祁","text":"卧锦潜郎种种丝，为邦独爱阮咸麾。\n中台给契鱼初剖，外闼升车雉尚随。\n风汴杂花飘夕棹，雨吴芳树隐春旗。\n为寻刘白高吟地，酒熟螯香左右持。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47324,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送四舅朱掾赴英州","author":"宋祁","text":"拗柳亭皋晚，攀梅岭路长。\n北辞鳷鹊月，南冒鹧鸪霜。\n越蠹催征候，珍鲑奉庆觞。\n片言民讼息，归计伫林光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47325,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送刘学士守衡阳兼还故里","author":"宋祁","text":"名帖唐家十二时，囊封自乞阮咸麾。\n三行牛酒过乡墅，九向云山驻使旗。\n兰露夕薰欢洁膳，桂风秋遣怨丛枝。\n不应晚计还台约，紫掖深沈伫演辞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47326,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送同年叶文卿尉高邮","author":"宋祁","text":"桧楫舣河漘，东南再命新。\n还家倦游客，隐市谪仙人。\n驿舍霜梅早，乡壶蚁酎醇。\n疏林摇落尽，持底赠萧辰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47327,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送同年孙锡勾簿巢县","author":"宋祁","text":"干牍公车与愿违，却怀黄绶去江湄。\n中都食酪忧莼老，要路编苫笑锦迟。\n酒帜亭长离帟罢，浪花风稳暝帆移。\n惊秋感别俱成恨，瘦尽森森琼树枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47328,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送同年吴瑴尉乌程","author":"宋祁","text":"鼕鼕报曙天，归趁越人船。\n闽月长留梦，吴门自是仙。\n漆书多汗竹，圭祀有名田。\n剩著凌云赋，囊帷待奏篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47329,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送同年张孝孙勾簿颍阴","author":"宋祁","text":"雪序繁云掠苑回，行人此地一衔杯。\n东西沟上歌流水，南北枝头怨赠梅。\n绵竹诵篇沈秘幄，堵坡题字晦轻埃。\n莫辞县枳淹鸾翮，密启天官伫荐才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47330,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送吕太初法曹之许田","author":"宋祁","text":"秋涯舣客舻，潘鬓不胜梳。\n去决卿军事，还亲城旦书。\n驿鸦啼月早，庖鲤跃冰馀。\n白晰公庭步，翘材首曳裾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47331,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送孙皋","author":"宋祁","text":"江边瑶草斗袍青，所乐从军得四明。\n新水一篙催泛鹢，故林三月及闻莺。\n羽书无警栖毫熟，谈幄多欢醉叶倾。\n我亦中都厌羊酪，为传秋思与莼羹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47332,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送巩汉卿同年赴五原理掾","author":"宋祁","text":"再赴天官调，仍还多士乡。\n华阴馀雾散，光禄故垣长。\n春柳侵湖绿，秋云际幕黄。\n片言民讼息，编美冠州堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47333,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送朱十翁","author":"宋祁","text":"手把临涡酒，人归如梦城。\n何言一欢笑，便作两离情。\n园树丹蕤老，家山钿髻明。\n不妨还轸促，芝崦趁春耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47334,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送朱进士赴举","author":"宋祁","text":"汉家廉诏举翘英，银纻观宾望斗城。\n北地高门传玉节，西京旧学秘金籯。\n邮亭续食星轺急，岭路驰烟月狖惊。\n几日东归荣昼锦，度关遥识弃繻生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47335,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送江西转运李定度支","author":"宋祁","text":"江西使节拥朱轮，正用中台鹤发人。\n漕米争衔千鹢舶，即山催铸万蚨缗。\n宴斋螺岫披云出，醉馆星苞照露匀。\n双笔讵能藏藻思，落霞孤鹜向萧辰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47336,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送江阴簿江楚材先辈","author":"宋祁","text":"黉舍久过从，清言服阿戎。\n半纶人结绶，一箭水分风。\n行稻鲜原绿，攀花杂树红。\n羡君谈有助，新论得王充。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47337,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送齐殿丞监缙云军","author":"宋祁","text":"几信南风转曙乌，殿栏归思结丹涂。\n曳朱恩借鱼须笏，假节人同虎刻符。\n裳綵亲闱称雅寿，弩兰乡县壮前驱。\n飞霜郡阁遗文丽，更得韩陵共语无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47338,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送馀姚尉顾洵美先辈","author":"宋祁","text":"蓬葆已萧萧，从官越绝遥。\n山图禹穴近，涛气伍神骄。\n卧帐藏新论，舟行问故樵。\n寄声时谢我，江上足兰苕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47339,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送张士安同年赴上元尉","author":"宋祁","text":"千名联唱第，一尉滞徒劳。\n山入黄旗国，江浮白鹭涛。\n苑葩依日晚，官树共秋高。\n少赋思归恨，潘才是二毛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47340,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送张元安肃知军","author":"宋祁","text":"星闱几罢日薰衣，万里题封换使麾。\n都外鸱夷催軷酒，塞南杨柳望春旗。\n中军尺檄閒飞羽，前队鸣采列素支。\n竞病不须贪赋韵，路人笳鼓记归时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47341,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送张司勋福建转运使","author":"宋祁","text":"晚花吹酒送行人，迢递风烟上七闽。\n江海身孤虽恋阙，豺狼路静不埋轮。\n阳林撷露茶腴早，侧树烘霞荔子新。\n毛竹乾鱼仙祀古，请君寻遍武夷春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47342,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送张问南游","author":"宋祁","text":"草远花明沟水头，同君此地并离愁。\n盖馀瓮酒沈三赋，合作盘鲭厌五侯。\n觉在他乡应有梦，信非吾土少登楼。\n楚山不见西江远，莫反骚文剩驻留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47343,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送张状元监丞通理陕郊先觐亲蜀道","author":"宋祁","text":"苑树樱残罢宴瓯，骊驹籍籍望西州。\n左思丽赋都中贵，张载新铭剑外留。\n几日戏裳贪洁膳，即时归雨劝耕畴。\n如何蔽芾甘棠国，再见临淄第一流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47344,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送张法曹","author":"宋祁","text":"驶骑柳枝鞭，春逵望雒廛。\n赋才宾右俊，掾诺府中贤。\n宫楯含樱密，王渠泛醳联。\n胜期资一笑，刑矢措周年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47345,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送张清臣学士省侍金陵","author":"宋祁","text":"仙阁三休紫雾平，金门试罢得蒸青。\n同时第赋留宸幄，他日闻时恋相庭。\n逗箭夕流催桧楫，赐花春豫忆云屏。\n吴天此夜瞻台座，并是荀家父子星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47346,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送李芝还旧隐","author":"宋祁","text":"章冠惯趁舞雩春，属疾弥年素产贫。\n旧隐却招三径菊，归装不受九街尘。\n平时戏服欢为綵，日后迎蒲待裹轮。\n天下书生皆皓首，牛溪休访续经人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47347,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送杨子奇赴辟潭渊","author":"宋祁","text":"老避嘲师昼不眠，喜闻书辟冠初筵。\n车陪魏馆鸣笳路，食对何侯下箸钱。\n使驿马归催露檄，学帷鳣堕晦馀编。\n知君此举伸知己，宁似他人有一天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47348,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送杨告虞部知池阳","author":"宋祁","text":"新年卧锦直南宫，露绂归来使寄雄。\n秘地锵銮辞夜燎，离亭赠扇有仁风。\n梅根大冶兼金富，杨叶芳洲杂蘤红。\n伧楚俗移恩诏美，班春聊隐轼前熊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47349,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送杨学士三首 其三","author":"宋祁","text":"觚棱初日九天开，躞蹀桑郊五马回。\n群玉三山藏册府，偃壶双笔给中台。\n编堂旧政盘留薤，画省新辞砌有苔。\n阙里诸生弥属望，雪园他日待延枚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47350,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送杨学士三首 其二","author":"宋祁","text":"青丝千骑汉台郎，入奏星藩解郡章。\n荷橐再亲文石陛，班春初捲赤帷裳。\n百壶帐饮杯醽釂，一劄泥封诏检香。\n几日西清劳侍从，郁葱佳气接明光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47351,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送杨学士三首 其一","author":"宋祁","text":"左幡彤赤抗前旌，捧诏西归觐大庭。\n汉署馀香薰锦帐，唐家新政纪云屏。\n迎秋画隼开朱旆，别夜哀乌动列星。\n从此回翔宸渥厚，冠緌清晓俯阶蓂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47352,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送杨偕太傅知淮阳军","author":"宋祁","text":"下拜亲膺一札书，隋河风柂送行舻。\n晓辞汉署茅留蕝，暮听廉歌裤换襦。\n方志贡珍传磬错，客庖羞品盛鱼腴。\n双旌引入柔桑陌，少驻骖驔捋美须。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47353,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送连氏昆仲还省侍","author":"宋祁","text":"酥酪君家伯仲贤，相从黉舍倏经年。\n三卮酒薄难为圣，一腹书空但喜眠。\n庾信刻筠怀旧坞，隐侯题壁有新篇。\n糅甘调滑思归养，溢握陔兰照露鲜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47354,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送连庶","author":"宋祁","text":"之子远参卿，劳劳千里行。\n素衣因客变，华发看秋生。\n遇鲤频为讯，逢莼试作羹。\n尘埃半通绶，何地免将迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47355,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]