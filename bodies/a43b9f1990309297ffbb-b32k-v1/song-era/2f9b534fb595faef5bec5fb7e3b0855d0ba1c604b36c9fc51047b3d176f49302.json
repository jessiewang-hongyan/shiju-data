[{"title":"桂隐纪咏四十八首 其十七 泰定轩","author":"张镃","text":"触处天光发，何尝离定中。\n问云谁散乱，又道主人公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57362,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桂隐纪咏四十八首 其十五 真如轩","author":"张镃","text":"翠竹是真如，目前须荐取。\n恁么做禅和，被人鞔似鼓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57363,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桂隐纪咏四十八首 其十三 读易轩","author":"张镃","text":"大易缘何有，难逃此问中。\n不从横画会，爻象总能通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57364,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桂隐纪咏四十八首 其五 高寒堂","author":"张镃","text":"下瞰东邻寺，钟声殷两山。\n贪吟尝忍冷，薄夜不知还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57365,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桂隐纪咏四十八首 其八 清夏堂","author":"张镃","text":"夜月三杯色，晴荷十亩香。\n若教兴世念，不甚觉风凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57366,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桂隐纪咏四十八首 其三十一 琼莩亭","author":"张镃","text":"莫羡海棠色，听言著子时。\n骊珠千万颗，撒向嫩桑枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57367,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桂隐纪咏四十八首 其三十三 满霜亭","author":"张镃","text":"疑驾洞庭帆，累累看绕山。\n花时芳气洁，伯仲素馨间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57368,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桂隐纪咏四十八首 其十 煨芋轩","author":"张镃","text":"煖坐无寒涕，窗油雪让明。\n地炉糠火熟，饱听乱松声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57369,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桂隐纪咏四十八首 其三十二 粲金亭","author":"张镃","text":"柘弹黄金子，谁将满树装。\n珍禽来往惯，风落不惊忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57370,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桂隐纪咏四十八首 其二十九 鲈乡亭","author":"张镃","text":"溪叟挈笭箵，曾来候此亭。\n未知余不杀，刚要著鱼经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57371,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桂隐纪咏四十八首 其三十 摘霞亭","author":"张镃","text":"一片吹来锦，人言是杏花。\n倚栏堪把玩，胜似日边霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57372,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桂隐纪咏四十八首 其七 翠樾堂","author":"张镃","text":"宝画光腾处，乔林更碧峦。\n权衡主人福，压尽世间官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57373,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桂隐纪咏四十八首 其四十一 静乐庐","author":"张镃","text":"城市非无地，如何此结庐。\n一家耽静乐，两个水边居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57374,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桂隐纪咏四十八首 其四十六 樵径","author":"张镃","text":"路入前山处，苍苔裹石棱。\n不逢负薪叟，时见隔林僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57375,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桂隐纪咏四十八首 其四十八 舣蘋舟","author":"张镃","text":"玉立蜻蜓小，香欺漫港秋。\n百年清绝意，孤棹抵封侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57376,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桂隐纪咏四十八首 其四十七 霞川","author":"张镃","text":"方舟卧看花，丹霞二三里。\n穷眼谢玄晖，休言馀散绮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57377,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桥亭观月","author":"张镃","text":"全似苍崖涌月轮，暗林横贯一溪明。\n家中幻出山中景，圯上追凉恰二更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57378,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桥廊上作 其二","author":"张镃","text":"千载清风笠泽仙，提携曾置笔床边。\n吾行不汲长桥水，要煮青山陆羽泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57379,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"涧西閒汎","author":"张镃","text":"曲曲通航小，兰桡手自移。\n映丛怜白鹭，特地过湾迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57380,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读韩非传","author":"张镃","text":"谏鼓招言事蔑闻，昧时自鬻更纷纷。\n胸中著许堤防策，不救危身肯济君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57381,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"铁行者","author":"张镃","text":"僧舍生涯只且然，养他行者不须钱。\n龙潭莫问僧参得，吹灭灯时各自眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57382,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"堂中安奉高宗寿皇今上御书碑","author":"张镃","text":"路转修林特地殊，九光霞气羃仙庐。\n苍瑶不刻飞天篆，尽是三清玉帝书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57383,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿上湖","author":"张镃","text":"落日烘蒙紫翠间，舟人遥指洞庭山。\n云情水态明朝看，且伴新蟾宿柳湾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57384,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"崇德道中 其二","author":"张镃","text":"羊蹄根老漫溪浔，灰蝶閒飞兴亦深。\n春色醉人胜似酒，觅诗天气要微阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57385,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"崇德道中 其三","author":"张镃","text":"疏篱遮竹竹难遮，卧向溪流一桁斜。\n绿底睡凫应自爱，起来摇翅各成花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57386,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"崇德道中 其四","author":"张镃","text":"枸橘花繁雪有香，风吹成阵入船舱。\n若教知我园中路，不肯芳菲驿舍傍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57387,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"崇德道中 其一","author":"张镃","text":"破艇争划忽罢喧，野童村女闯篱边。\n令人说著苏堤路，花满清明画鼓船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57388,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"得巨鱼送叔祖","author":"张镃","text":"桃花流水正关渠，雨后俄收紫鲙鱼。\n岂是斋厨真欠此，小诗聊当腹中书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57389,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"得巨笋三尺围送王叔兴","author":"张镃","text":"猫头名字出长沙，别号犀株岂过誇。\n好对竹尊招二子，藕如船大枣如瓜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57390,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"得家书 其一","author":"张镃","text":"北堂萱独雁行疏，旅梦通宵只敝庐。\n未暇拆封忙唤仆，先将安否问何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57391,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"得家书 其二","author":"张镃","text":"玉塞金河阻去程，醉中尝梦赋西征。\n天时不与人心合，独守寒窗数雁声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57392,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"得家书 其三","author":"张镃","text":"风沙来往稻粱谋，江北江南一岁遒。\n非为红楼断消息，待梅暗候自清愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57393,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚兴","author":"张镃","text":"江汉旧名侯，飘萧发未秋。\n时荣那似此，天地入诗游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57394,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚步松下","author":"张镃","text":"人皆束缚夘申时，我独园居不必归。\n最是苍寒堂下好，乱松稍上看云飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57395,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚眺","author":"张镃","text":"小阁梯檐竹作篱，晴阴登眺百盘宜。\n悬知皓月升云海，不赋如钩似镜诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57396,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晨步西涧","author":"张镃","text":"日炙芹泥积渐融，一湾新涨小桥通。\n不因野鸭飞来喜，忘却生涯书卷中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57397,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"曹村观落日","author":"张镃","text":"日欲西时暮霭凝，何尝落向远山层。\n分明万丈青罗幕，遮却销金罩里灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57398,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"望亭夜泊","author":"张镃","text":"新月何曾展画帏，便教星斗避寒辉。\n思量自在天公最，昨日峰头有雪飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57399,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅 其二","author":"张镃","text":"驱鹤松门去却回，似知草际有香来。\n青条红眼才窥煖，拄杖先?费绿苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57400,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅 其一","author":"张镃","text":"群玉山头昨梦归，占祥获应必无疑。\n今朝暂歇抄书课，急为寒梅办早诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57401,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅 其三","author":"张镃","text":"冒寒岗路透溪桥，驴仆翩翩叶乱飘。\n还是去年初见处，青旗茅店恰相招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57402,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淳熙巳酉二月二日皇帝登宝位镃获厕廷绅辄成驩喜口号十首 其十","author":"张镃","text":"小臣奕世沐深恩，寓直蓬山三十春。\n空抱一编无所用，也叨拜望属车尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57403,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淳熙巳酉二月二日皇帝登宝位镃获厕廷绅辄成驩喜口号十首 其九","author":"张镃","text":"黎庶曾何帝力知，七旬三入乂宁时。\n春寒谁怕妨花柳，一日东风万国吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57404,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淳熙巳酉二月二日皇帝登宝位镃获厕廷绅辄成驩喜口号十首 其八","author":"张镃","text":"圣父移居太母傍，銮舆躬侍袭龙香。\n乍从黄伞窥天表，愈觉英资似寿皇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57405,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淳熙巳酉二月二日皇帝登宝位镃获厕廷绅辄成驩喜口号十首 其七","author":"张镃","text":"和风淑气夹钟初，寿域重开际八区。\n不战自令边徼服，喜看风动媲唐虞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57406,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淳熙巳酉二月二日皇帝登宝位镃获厕廷绅辄成驩喜口号十首 其六","author":"张镃","text":"聪哲从来简帝心，万方臣子合君临。\n东堂议事犹经岁，仰体慈皇属意深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57407,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淳熙巳酉二月二日皇帝登宝位镃获厕廷绅辄成驩喜口号十首 其五","author":"张镃","text":"百僚重入贺新君，亿载从今仰大昕。\n文德岂惟循舜道，武功行见访尧勋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57408,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淳熙巳酉二月二日皇帝登宝位镃获厕廷绅辄成驩喜口号十首 其四","author":"张镃","text":"宣召班排过隔廊，耸闻神器授储皇。\n只将揖逊为家法，我宋真宜万代昌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57409,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淳熙巳酉二月二日皇帝登宝位镃获厕廷绅辄成驩喜口号十首 其三","author":"张镃","text":"深严黼座瑞光中，彷佛遥瞻穆穆容。\n特衣赭袍缘底事，御天嗣圣欲乘龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57410,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淳熙巳酉二月二日皇帝登宝位镃获厕廷绅辄成驩喜口号十首 其二","author":"张镃","text":"只似閒时朝殿来，华驹徐步转东街。\n铜门已见飞腾象，先下浑银两字牌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57411,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淳熙巳酉二月二日皇帝登宝位镃获厕廷绅辄成驩喜口号十首 其一","author":"张镃","text":"晓色葱茏丽建章，今辰天地不寻常。\n中宵若没阴云蔽，应见前星日样光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57412,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清明日书亦庵壁二首 其二","author":"张镃","text":"光阴高柳欲飘绵，拂著蔷薇锦壁连。\n莫道行人总无识，定因罗爵爱门前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57413,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清明日书亦庵壁二首 其一","author":"张镃","text":"春情缘雨复缘晴，晴即閒行雨即吟。\n花好满园看未遍，出墙邻树又关心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57414,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绿筠轩旧在于潜寂照寺今移立县治之东竹间凿小池植莲为赋两绝 其一","author":"张镃","text":"按图得此已欣然，胜趣何尝有变迁。\n一把香茅千个玉，不妨邂逅揖苏仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57415,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绿筠轩旧在于潜寂照寺今移立县治之东竹间凿小池植莲为赋两绝 其二","author":"张镃","text":"气韵非关竹有无，莫嫌清荫杂芙蕖。\n官居不俗从何得，窗下风翻未尽书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57416,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谒陆礼部归偶成二绝句 其二","author":"张镃","text":"有口宁论黠与痴，相投无过只谈诗。\n要知此客非忙客，欲去迟回尚读碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57417,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谒陆礼部归偶成二绝句 其一","author":"张镃","text":"欲识清狂自在身，关门湖上独经春。\n今朝正接黄梅雨，却出冲泥访故人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57418,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"骑鲸桥","author":"张镃","text":"池港开门就作桥，朱栏相望压鲸腰。\n风摇慢摺游溶绿，波底何妨著霁霄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57419,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寒食前一日西湖閒泛三首 其三","author":"张镃","text":"衰鬓争如竹际苔，秋千犹记玉骢回。\n短篱数尺花成簇，一日春悰不往来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57420,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寒食前一日西湖閒泛三首 其二","author":"张镃","text":"骤暖悬知雨信浓，半阴台榭碧烘濛。\n何心更敢携壶去，孤桨微吟尚未工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57421,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寒食前一日西湖閒泛三首 其一","author":"张镃","text":"艳红香白遍游人，花柳酣歌识太平。\n野客独谙閒意趣，草烟空爱一川明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57422,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"敬和东宫早梅二首 其二","author":"张镃","text":"乾坤连夜玉为尘，照映冰容面面新。\n句妙莫疑难属和，真成白雪对阳春。","collecti