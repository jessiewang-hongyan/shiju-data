[{"title":"送僧还里","author":"释元肇","text":"送君重叠上高台，到得亲庭却早来。\n杨子江头应看取，无情潮水亦西回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30362,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送僧归淮西二首 其一","author":"释元肇","text":"高堂无地寄征衣，淮水西边近解围。\n想得夜阑更秉烛，天寒木落一僧归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30363,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送僧归淮西二首 其二","author":"释元肇","text":"满目乡心怕著秋，东州见了又西州。\n明年莫看中秋月，曾是当时照别愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30364,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"北堂寄布","author":"释元肇","text":"消息虽真见若何，愁中日月手中梭。\n莫言不写平安信，布眼争如望眼多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30365,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"同游归故隐","author":"释元肇","text":"庭前杏树手亲栽，曾见空花两度开。\n闻道濛濛烟雨里，乱禽争子落莓苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30366,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送僧游岳","author":"释元肇","text":"上人年少易抛乡，湖海茫茫道路长。\n凭内州军莫游尽，雁飞不肯过衡阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30367,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿凤山寄枫桥诠无言","author":"释元肇","text":"泽国春深绿暗天，来时已不见君船。\n十年湖海飘零恨，一夜空山听杜鹃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30368,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"石湖晚泊","author":"释元肇","text":"磨子峰头日已倾，楞伽塔顶月初生。\n鸱夷去后烟波冷，怅望吴台与越城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30369,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"西园晚春","author":"释元肇","text":"水影烟光上客衣，楼前燕子自由飞。\n鞦韆春去无人管，相伴垂杨舞落晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30370,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谢史春坊远招","author":"释元肇","text":"支林烟雨旧池台，麾节将春今几回。\n湖上梅花方做梦，楼头画角又相催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30371,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"徐神公墓","author":"释元肇","text":"出郭门东宿霭披，仙公灵迹尚堪追。\n空林日日传清响，敝帚年年付与谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30372,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送客","author":"释元肇","text":"迟迟送客过前溪，脱木风高日易低。\n寂寞归来理残菊，野禽啼在竹篱西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30373,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寒食","author":"释元肇","text":"荒冢无人捧土修，夕阳芳草替生愁。\n路傍知是谁家子，犹把花枝插满头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30374,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"江路午行","author":"释元肇","text":"谁家吠犬出低篱，桥在村西人未知。\n白鸟自来还自去，柳阴浓处立多时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30375,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"归涂雪","author":"释元肇","text":"蹇驴骑破野村前，爱惜飞花懒著鞭。\n到得归来山舍晚，竹篱遥认煮茶烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30376,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋霁","author":"释元肇","text":"一室虫悲万感生，林梢攧雨湿秋声。\n诗成后夜无人问，月到云间不肯明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30377,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送僧归武昌","author":"释元肇","text":"赤壁西边旧武昌，吴波蜀浪几兴亡。\n归来黄鹤楼前看，半是寒涛半夕阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30378,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"晓过吴江","author":"释元肇","text":"雨洗云梳晓色迟，空江枫冷一虹垂。\n渔人偷钓烟波破，鸥鹭沙头睡不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30379,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"渡江","author":"释元肇","text":"天地无情日夜流，树烟浓澹岸沈浮。\n浪花倏忽千堆雪，白似江南去客头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30380,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"别菊","author":"释元肇","text":"世情迁变总由他，冷眼相看只此花。\n露叶霜枝愁不语，主人明日又天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30381,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题饮仙图","author":"释元肇","text":"蹇驴破帽少陵寒，吐出歌辞字字酸。\n渭水骊山肠断日，诸公肯待醒时看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30382,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"牧野图","author":"释元肇","text":"焦头烈尾痛成功，麟阁何曾见画工。\n争似淡烟杨柳岸，四无阑圈自西东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30383,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送僧","author":"释元肇","text":"含晖亭上曾辞我，狼伍峰前又送君。\n只有月明相记忆，月明争得不逢云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30384,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"所寓","author":"释元肇","text":"旧恨新愁海样深，关河鱼雁各飞沈。\n芭蕉也似知人意，日日窗前吐寸心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30385,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"兰","author":"释元肇","text":"绝无人处有香飘，树底岩根雪未消。\n千古醒魂招不返，晚风斜日恨萧萧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30386,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"子规","author":"释元肇","text":"今古相传望帝魂，见之再拜感孤臣。\n天津桥上人初听，肠断江南三月春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30387,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"王乔","author":"释元肇","text":"弃世还如弃屣轻，玉箫吹彻月分明。\n许由不受尧天下，却道风瓢树有声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30388,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"见梅花","author":"释元肇","text":"闲爱梅花住武林，换人岁月已侵寻。\n水边竹外相逢瘦，一寸枝头一寸心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30389,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"探梅","author":"释元肇","text":"冰雪催诗瘦入肩，几回山后又山前。\n枝头不见春消息，空倚阑干忆去年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30390,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"孤山","author":"释元肇","text":"老柏槎牙自古今，两翁陈迹石泉深。\n孤山风物皆迁变，只有梅花独姓林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30391,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"柳絮","author":"释元肇","text":"飞时如雪聚成毬，长是随风不自由。\n便使化为萍去后，烟波无限更飘流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30392,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"杨补之梅","author":"释元肇","text":"一幅霜绡染壑烟，茹琼吐雪似年年。\n上林多少春风面，白首杨郎正草玄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30393,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"海棠","author":"释元肇","text":"昭阳殿里醉含情，三十六宫颜色轻。\n几向春风怜薄命，少陵诗史不书名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30394,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"客陈园二首 其一","author":"释元肇","text":"原上萧条寒食雨，江边牢落苦吟身。\n朝来也伴园林主，分白移红学种春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30395,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"客陈园二首 其二","author":"释元肇","text":"客来日日待花开，待得花开客又回。\n未肯尽情皆吐露，似应留客少徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30396,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"吊无著塔","author":"释元肇","text":"一定空山五百年，不须惆怅启颓砖。\n路傍多少麒麟冢，转眼无人赠纸钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30397,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送赵宪使除郎归班二首 其一","author":"释元肇","text":"使星照福八州城，新岁还依玉座明。\n直上垂虹高处望，空江一片接天清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30398,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送赵宪使除郎归班二首 其二","author":"释元肇","text":"淮云吹过浙西山，只在皇华指顾间。\n天际悠悠无定向，愿随霖雨不知还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30399,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠日者鉴堂","author":"释元肇","text":"镜里难逃陌上尘，广陵消息听来真。\n吴王故苑秋风起，欲采蘋花寄远人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30400,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"大梅山","author":"释元肇","text":"梅子青黄几烟雨，荷衣零落又秋风。\n松花满地无人食，粥鼓斋鱼两寺中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30401,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"海门道中","author":"释元肇","text":"云驶前林雨脚回，炎风赫日马蹄埃。\n道傍官柳应相笑，十二年中四往来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30402,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春日二首 其一","author":"释元肇","text":"柳塘春水涨如醅，掠眼风光燕子回。\n最苦杏花留不得，夜来雷雨尽惊开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30403,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春日二首 其二","author":"释元肇","text":"乍雨新晴媚物华，孤烟落日晚人家。\n柳摇浅浅深深水，篱露红红白白花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30404,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠殷道人","author":"释元肇","text":"经旬门巷掩苍苔，不觉春从何处来。\n想见道人殷七七，万红千紫为渠开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30405,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山居四首 其一","author":"释元肇","text":"四壁萧然一室风，只多诗债与诗穷。\n枯梅尽日临窗舞，时有寒禽动竹丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30406,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山居四首 其二","author":"释元肇","text":"欲向西山学采薇，可怜身瘦得名肥。\n天边多少能鸣雁，不到衡阳不肯归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30407,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山居四首 其三","author":"释元肇","text":"因笑红尘个个忙，故人沦落在殊方。\n地炉无火灰成字，却傍前轩曝夕阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30408,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山居四首 其四","author":"释元肇","text":"覆榻一床单纸被，挂身三事旧麻衣。\n吾庐只在深云里，笑折梅花月下归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30409,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"永宁寺","author":"释元肇","text":"寺出平郊开雨云，村藏桃李几家春。\n尘埃不渡沧洲梦，杨柳溪桥影照人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30410,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和天目见寄","author":"释元肇","text":"共折梅花竹岭西，白云粘袖带诗归。\n东风著尽青青子，双径峰前落照微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30411,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和天目上竺守岁","author":"释元肇","text":"林木悲嘶带断霞，淡烟楼阁梵王家。\n明朝岁律从头起，绕遍山茶一树花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30412,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"礼嵩明教塔二首 其一","author":"释元肇","text":"饥寒万卷寄萧疏，越路三千去上书。\n明主既知尧舜事，故山依旧爱吾庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30413,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"礼嵩明教塔二首 其二","author":"释元肇","text":"落涧流泉势欲豗，断碑古塔蚀苍苔。\n雨声一夜卷春去，风撼千山我独来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30414,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"登刘寺后山","author":"释元肇","text":"落日山光半有无，白鸥渔艇散晴湖。\n贵妃泉石无人管，寂寞孤僧信杖扶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30415,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"牵牛花","author":"释元肇","text":"星河明灭映篱根，风露开成碧玉温。\n晓色未开忙敛恨，柔条无力绊天孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30416,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春寒","author":"释元肇","text":"草色青青没烧瘢，游人未敢踏春寒。\n梅花吐尽溪头雪，只有沙鸥独自看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30417,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"与郑明府四首 其一","author":"释元肇","text":"疏烟漠漠走风沙，古木寒芜欲莫鸦。\n拾穗村童涉溪水，数声渔笛隔芦花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30418,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"与郑明府四首 其二","author":"释元肇","text":"柴门窄窄对江开，脉脉寒潮入浦回。\n笑语邻翁倚篱落，夕阳微处竹舆来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30419,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"与郑明府四首 其三","author":"释元肇","text":"结束才容四五人，绠长尤恐井生浑。\n浊醪不受殷勤劝，笑把黄花过一村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30420,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"与郑明府四首 其四","author":"释元肇","text":"天外横河泣露寒，中秋月好傍楼看。\n高标不及康庐远，难博渊明一笑欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30421,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送人","author":"释元肇","text":"疏雨梧桐滴滴秋，凉吹别袂上归舟。\n釜山青立苍茫外，潮落潮生一点愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30422,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送月上人之东州","author":"释元肇","text":"洞庭波上木兰舟，只解年年载客愁。\n月到甬东天似水，钓丝全力重金钩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30423,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送祖书记之武昌","author":"释元肇","text":"黄鹤楼前旧月明，吴王台上莫秋声。\n离情只在斜阳里，断柳荒烟写不成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30424,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"华夷图","author":"释元肇","text":"禹迹茫茫宇宙宽，等閒移向壁间安。\n从头指点须开展，莫只东南角上看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30425,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"池梅","author":"释元肇","text":"水净方塘晓镜清，依依冷照玉娉婷。\n昭君莫怨毛延寿，此意如何画得成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30426,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春意","author":"释元肇","text":"山客偶来城里住，频年孤负惜芳心。\n一株杨柳南池上，日日看春到浅深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30427,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"哀通人俘虏二首 其一","author":"释元肇","text":"沙漠无春雪满天，不知旧岁与新年。\n如何化得身双翼，飞向南方学杜鹃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30428,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"哀通人俘虏二首 其二","author":"释元肇","text":"见雁南飞欲寄音，裂衣刳血写乡心。\n书成刬地添惆怅，又恐无人射上林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30429,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"酬杜北山","author":"释元肇","text":"杜君世胄本蝉联，流落南天不记年。\n买个草堂湖上住，醉吟如在曲江边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30430,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"初至建邺","author":"释元肇","text":"六朝陈迹认应难，只有春风燕子还。\n陌上花开又花落，看人来往是钟山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30431,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"怀吴中","author":"释元肇","text":"消息传来竟不真，杨花落后更无春。\n谁知十载游吴梦，却作桑乾渡水人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30432,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"行宫词","author":"释元肇","text":"一片红云拥不开，天津桥上久徘徊。\n当时未了中兴业，应待君王法驾来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30433,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"晋元帝庙","author":"释元肇","text":"元帝遗宫在石头，年年长吏祀春秋。\n几多整顿乾坤手，閒绕回廊看不休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30434,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"王荆公半山祠","author":"释元肇","text":"来往钟山住半腰，骑驴松下莫萧萧。\n只因墩号分人我，到了经纶恨不消。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30435,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"桃红菊","author":"释元肇","text":"桃叶桃根逐水流，冷烟凉月几番秋。\n篱边强作春风面，满地黄金不替愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30436,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"酬张槎溪","author":"释元肇","text":"一笑相逢白下城，秋光满路雨初晴。\n沧江上与天河接，应是乘槎到玉清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30437,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"用赵倅韵二首 其一","author":"释元肇","text":"江山陈迹六朝遗，寂历寒花野水湄。\n犹有石头城畔月，夜深还照昔人诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30438,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"用赵倅韵二首 其二","author":"释元肇","text":"凭高一望兴何穷，晴雨朝昏景不同。\n莫向吟边苦怀古，败荷疏柳怯西风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30439,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄题孤屿琚师半云","author":"释元肇","text":"江上悠悠寄此身，一间茅屋半边云。\n长年相伴闲怡悦，去住无心不用分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30440,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送黄宰之江陵","author":"释元肇","text":"滑石桥寒玉万寻，到君游日正春深。\n诗人今拥油幢坐，曾听孤猿月下吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30441,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]