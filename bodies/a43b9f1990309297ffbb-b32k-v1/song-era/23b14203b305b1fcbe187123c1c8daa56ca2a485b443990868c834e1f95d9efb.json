[{"title":"资殿清惠陈公哀诗三首 其二","author":"刘克庄","text":"清德在人如皦日，荣名加我等浮云。\n漫张赞下青凉伞，不改辽东白布裙。\n老惜平生惟此友，吾虽后死愧斯文。\n昔贤千里怀鸡絮，安得陈之董相坟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32396,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"资殿清惠陈公哀诗三首 其一","author":"刘克庄","text":"不比尧夫新悦泽，依然迂叟旧清羸。\n末年先帝攀髯恨，几处遗民堕泪碑。\n上自易名真独断，史当立传要雄辞。\n道山堂上分襟句，岂料今为绝笔诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32397,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郭璞墓","author":"刘克庄","text":"先生精数学，卜穴未应疏。\n因捋虎须死，还寻鱼腹居。\n如何师鬼谷，却去友灵胥。\n此理凭谁诘，人方宝葬书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32398,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"铁塔寺","author":"刘克庄","text":"细认苔间字，方知铸塔时。\n不因兵废坏，似有物扶持。\n古殿人开少，深窗日上迟。\n僧言明受事，相对各攒眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32399,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"铁塔院","author":"刘克庄","text":"铁塔荒凉院，年深失主名。\n昔游基已废，今至屋皆成。\n人出私钱施，僧凭愿力营。\n如何榆塞上，却有未包城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32400,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陪宋侯赵倅过仓部弟家园宾主有诗次韵二首 其二","author":"刘克庄","text":"偶陪小队谢池行，云澹风轻雨未成。\n梦草诗情全老退，见花病眼尚分明。\n即今樵笛村童和，当日金莲院吏迎。\n得向骚坛分半席，绝胜一品与三旌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32401,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陪宋侯赵倅过仓部弟家园宾主有诗次韵二首 其一","author":"刘克庄","text":"驾鸡栖尾隼舆行，取次亭台若幻成。\n五亩季方荣独乐，一麾侯岂厌承明。\n芳时别驾联镳出，归晚华灯夹道迎。\n留得广平春却否，传闻已有玺书旌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32402,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陪诸先辈题名登春台臞轩即席次故相陈魏公韵某继作 其一","author":"刘克庄","text":"台荒屋老阅人深，拂拭留题重整襟。\n科目一朝来券外，姓名三世在碑阴。\n公孙晚岁叨明诏，裘氏当年费苦吟。\n报与曲江先辈道，老婆非复少时心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32403,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陪诸先辈题名登春台臞轩即席次故相陈魏公韵某继作 其二","author":"刘克庄","text":"遨头唱首各高深，才薄难披作赋襟。\n已觉莺花成一梦，尚贪萤雪竞分阴。\n即今空负台莱意，宿昔曾赓殿阁吟。\n北望钧天搔白首，区区终有祝尧心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32404,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陪新进士公宴用太守韵","author":"刘克庄","text":"去年黄敕许怀归，拭目乡邦一段奇。\n老马不堪空冀野，大鹏自合化天池。\n琼林花发浑如昨，玉塞锋销未有期。\n汲汲九重方旰食，吾侪何以补明时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32405,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶赋","author":"刘克庄","text":"身已深藏畏俗知，客来邻曲善为辞。\n偶弹冠起成何事，径拂衣归自一奇。\n村饮妇常留烛待，山行童亦挟书随。\n明时性学尤通显，却悔从初业小诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32406,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿千岁庵听泉","author":"刘克庄","text":"因爱庵前一脉泉，襆衾来此借房眠。\n骤闻将谓溪当户，久听翻疑屋是船。\n变作怒声犹壮伟，滴成细点更清圆。\n君看昔日兰亭帖，亦把湍流替管弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32407,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿小寺观主僧升座","author":"刘克庄","text":"静处尤宜策睡勋，径投禅榻炷炉熏。\n恰为胡蝶春游美，忽吼华鲸曙色分。\n僧袒右肩方说法，我聋左耳若无闻。\n平生不作桑间恋，草草挑包下白云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32408,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿庄家二首 其二","author":"刘克庄","text":"茅茨迷诘曲，度谷复踰陂。\n世上事如许，山中人不知。\n牛羊晴卧野，鹅鹜晚归池。\n粗识为农意，秋输每及时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32409,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿庄家二首 其一","author":"刘克庄","text":"初秋风露变，偶出憩庄家。\n原稼无全穗，陂荷有晚花。\n疏钟踰涧响，微月转林斜。\n邻媪头如雪，灯前自绩麻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32410,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿囊山怀洪岳二上人","author":"刘克庄","text":"忆在山中识二僧，一亡一已拂衣行。\n壁间笠徙名蓝挂，寺外松过寿塔生。\n陇月定知今夕恨，涧泉犹咽旧时声。\n隔房侍者皆新剃，不似闲人却有情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32411,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄方时父","author":"刘克庄","text":"忆骑竹马已情亲，何况而今雪鬓新。\n早日无金能结客，暮年有腻解污人。\n忝三品料余宜斥，厌五侯鲭子不贫。\n已向榕阴添钓石，傥来溪上伴垂纶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32412,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄方时父二首 其二","author":"刘克庄","text":"蹠富回贫赋予偏，有司之者勿尤天。\n不争贵倖铜山铸，专算书生纸裹钱。\n仅有玉川数间屋，素无鲁望百弓田。\n荒村牢落稀还往，傥肯重登入剡船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32413,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄方时父二首 其一","author":"刘克庄","text":"长君三岁觉衰残，当子之年乞退闲。\n兄已荷锄为老圃，弟方负笈上春官。\n轻红入谱因人重，淡墨遗贤岂命悭。\n欧九玉堂在天上，不如杜二草堂安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32414,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄冯初心给事","author":"刘克庄","text":"三入承明倦论思，都门祖帐忆当时。\n琴弹古调将归操，箧宝初心送别诗。\n经岁空函无一字，侵朝明镜有千丝。\n遥知手内封还笔，山尚堪移此不移。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32415,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄卢威仲中书","author":"刘克庄","text":"艾翁孝庙老词臣，曾许樗翁接后尘。\n想见柳边飞盖客，不忘花外小车人。\n无斜封出公严惮，有赐金挥仆未贫。\n闻上三房归大手，周洪以后欠新纶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32416,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄左次魏二首 其二","author":"刘克庄","text":"同事征西府，闻君已绣衣。\n小侵今视昔，大捷是耶非。\n酋长舆尸返，偏裨奏凯归。\n六关天样险，莫遣贼能飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32417,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄左次魏二首 其一","author":"刘克庄","text":"多谢齐安牧，交情未阔疏。\n方筹江北事，肯寄海南书。\n开幕交锋处，修城劫火馀。\n别来各添岁，筋力近何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32418,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄永嘉王侍郎","author":"刘克庄","text":"珍重西清老，书来访薜萝。\n为邦应好在，作佛竟如何。\n花押常衙少，柑香静坐多。\n闻公须尚黑，未害小婆娑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32419,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄汉阳守王中甫","author":"刘克庄","text":"自辞莫府径归耕，同舍分携阙寄声。\n帐下飞书空有草，军中上级独无名。\n山深仆不闻时事，塞近君应得虏情。\n闻道汉东堪卧治，讯来依旧说招兵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32420,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄刘实斋侍郎","author":"刘克庄","text":"狂胡昔犯高安郡，井邑皆经蹀血馀。\n儿童犹记驯治化，盗贼能全白鹤居。\n子政子骏皆博学，公是公非各著书。\n侍郎鼎贵殿诸老，刘氏愈蕃而大欤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32421,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄汤伯纪侍郎二首 其二","author":"刘克庄","text":"仗下鸣曾惊众听，省中语不愿人传。\n骚留屈子芳菲在，史视胡公粪土然。\n士到后凋方见节，世除勇退别无仙。\n遥知洛下诸君子，应笑侬诗老放颠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32422,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄汤伯纪侍郎二首 其一","author":"刘克庄","text":"明主虚怀相受言，苛留不住去翩然。\n久无疏傅还乡事，始觉甘槃遁野贤。\n真个浮云轻富贵，元来平地有神仙。\n两翁到老相追逐，君驾青牛我执鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32423,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄汤伯纪秘书","author":"刘克庄","text":"挽留天语极谆谆，愿为明时远牧民。\n倏去居然令国削，至清浑不怕州贫。\n断无苞匪聊崇俭，才用蒲鞭亦害仁。\n莫比寻常骑竹马，使君元结一流人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32424,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄何立可提刑","author":"刘克庄","text":"故人握节守齐安，闻说边头事愈难。\n赤手募丁修险隘，白头擐甲禦风寒。\n半腰城甫包围毕，一把兵皆点摘残。\n收得去年书在架，忆君灯下展来看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32425,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄吴恕斋侍郎","author":"刘克庄","text":"几年病卧禅床上，一旦名标御札中。\n收召东都无处士，记怜北谷有愚公。\n依然晚景垂衰白，胜似天街踏软红。\n多谢皋夔与周召，十分结裹后村翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32426,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄呈阳岩","author":"刘克庄","text":"与君非复昔年时，我瞎君聋各已衰。\n萤案头光何必照，蚁床下斗不须知。\n嵇康老觉形骸懒，扁鹊亡无耳目医。\n只恐蒲轮催强起，林间未免独吟诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32427,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄杨休文高士","author":"刘克庄","text":"未答前书每有惭，忽收近讯自开缄。\n缴回玉笥山人号，换得金门羽客衔。\n石鼎联诗尘满砚，竹宫应制草盈函。\n可怜予与君俱错，投老方思卸戏衫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32428,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄沂孙","author":"刘克庄","text":"帝失遗珠不知处，离朱象罔遍咨询。\n彼皆宗此于方外，汝独问之于水滨。\n求我声音难见佛，得吾骨髓别无人。\n即今牛骥嗟同皂，天网何时罩凤麟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32429,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄泉僧真济","author":"刘克庄","text":"师邃于医者，闻诸谏议然。\n若非禅性悟，必有脉书传。\n药贵逢人施，方灵尅日痊。\n西风瓶锡冷，傥肯访沉绵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32430,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄洪云岩尚书","author":"刘克庄","text":"再尹神皋逾两载，市无群斗狱无冤。\n至尊犹遣使传诏，细故何烦士举幡。\n昨日千牙兵绕帐，今朝几个客过门。\n悬知一念尤忠爱，报大臣知圣主恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32431,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄赵简叔知宗","author":"刘克庄","text":"造物方将贵此翁，煌煌三印屈盘红。\n笺天不受珠犀涴，表海新兼鈇钺雄。\n诗满名山留妙墨，舶归外国说清风。\n何当把臂登云榭，共看鲸波浸碧空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32432,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄徐直翁侍郎二首 其二","author":"刘克庄","text":"忆昨纷纷众喙鸣，怪君噤齘久无声。\n得非家客留廷尉，或是闺人沮仲卿。\n白璧微瑕终古在，黄金横带霎时荣。\n从来公议无情甚，莫遣蒙斋独擅名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32433,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄徐直翁侍郎二首 其一","author":"刘克庄","text":"锐惰皆由气所为，浩然不屈是男儿。\n未知重入脩门后，何似初攀折槛时。\n已有客贻绝交论，岂无人取送行诗。\n勿令一种求疵者，妄议君侯凤德衰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32434,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄徐夏叔","author":"刘克庄","text":"曾识徐卿二子奇，秋来往往梦琼枝。\n明时莫作沉湘赋，暇日应题望岳诗。\n主爱客卿宁忍舍，兄嗟予季若为思。\n湖南岁晚多回雁，频寄书归尉别离。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32435,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄翁丹山侍郎","author":"刘克庄","text":"阅尽诸公上要津，丹山除目一番新。\n六卿尤重大宗伯，九制须还老舍人。\n太史将封乃留滞，纪瞻虽召尚逡巡。\n应怜公干今衰病，频寄书来寂寞滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32436,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄章贡姚别驾","author":"刘克庄","text":"赣江当日血成川，谁肯身驰不测渊。\n尺檄约降诸峒静，单车禽畔一城全。\n带刀俗染惟新化，横槊诗刊第几编。\n想与元龙谈世事，亦怜疏拙老林泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32437,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄章贡姚使君","author":"刘克庄","text":"虔在江西尤钜丽，极知君相选侯难。\n昔多法从怀州绂，今少诗人上将坛。\n敛戍官兵申拆洗，放衙溪洞报平安。\n衰颓欲纳辕门谒，却怕崆峒腊雪寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32438,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄强甫","author":"刘克庄","text":"囝罢相依萤雪边，安知今汝亦华颠。\n宁从欸乃翁孤钓，肯要原夫辈一联。\n儿向诗中得三昧，吏钳纸尾怕分权。\n客言大尹尤谦挹，每见屏星榻必悬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32439,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄强甫二首 其二","author":"刘克庄","text":"守局喧卑地，携孥寂寞滨。\n鲁儒犹委吏，周礼有盐人。\n勿发泥涂叹，姑持玉雪身。\n秋风怀檄否，莆与福比邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32440,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄强甫二首 其一","author":"刘克庄","text":"出户询来使，能言别后臞。\n病馀双鬓改，俸外一钱无。\n撰杖陪诸老，篝灯课二雏。\n梅天费调燮，善保不赀躯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32441,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄韩仲止","author":"刘克庄","text":"昨仕京华豪未减，脱靴不问贵游嗔。\n诗家争欲推盟主，丞相差教作散人。\n闭户自为千载计，入山又忍十年贫。\n几思投劾从公去，背笈肩琴涧水滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32442,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄熊主簿","author":"刘克庄","text":"一出悬知计已非，更堪留滞未成归。\n即今白首负松菊，何处青山无蕨薇。\n不恨老从中岁至，但悲事与素心违。\n当斋寂寞生秋草，几度临风忆杜微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32443,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题上饶方氏野堂","author":"刘克庄","text":"尊君曾索野堂吟，忽忽归舟忘至今。\n旧有田庐无偃仰，新移花木已幽深。\n远书来责订金诺，拙咏聊酬挂剑心。\n行尽四方垂八十，始知朝市愧山林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32444,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题心泉","author":"刘克庄","text":"之子幽栖恨未深，飞泉来处有亭临。\n觚悬木杪犹烦耳，易在床头且洗心。\n夸士十浆须五馈，痴人一帚享千金。\n箕山颍水应如故，太息巢由不可寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32445,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题竹溪平远轩","author":"刘克庄","text":"颠米含毫野处名，略安栏槛不施扃。\n原田足雨陂塘白，天海无云岛屿青。\n邻叟扶犁耕斥卤，行人休树濯清泠。\n何时去作轩中客，并欲传公道德经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32446,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题李尚书秀野堂一首","author":"刘克庄","text":"江上归来两鬓丝，倒囊惟剩草堂赀。\n云山有态争呈献，天海无边入指麾。\n怪石远从商舶至，名花多自别州移。\n寄声独乐先生说，世事而今尚可为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32447,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题杨?卿孝感堂","author":"刘克庄","text":"哭时闻者亦欷歔，双鹤随声下碧虚。\n帝出丝纶照穹壤，官施绰楔表门闾。\n今无陶侃谁能尔，古有苏耽莫是渠。\n华发史儋曾载笔，尚能浓墨为君书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32448,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题沙县死事祝将祠堂","author":"刘克庄","text":"淮右多良将，吾犹识祝侯。\n虎生能肉食，豹死有皮留。\n铁汉为挥涕，冰翁与雪雠。\n标名忠义传，荣甚复何求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32449,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题邵武死事胡将祠堂","author":"刘克庄","text":"士各全躯命，惟侯视死轻。\n张巡须尽怒，先轸面如生。\n短刃犹枭寇，空弮尚背城。\n新祠箫鼓盛，人敬比神明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32450,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题建阳马氏晚香堂","author":"刘克庄","text":"自锄空旷汲潺湲，占断清溪第几湾。\n傍九日开侵岁晏，居千花殿觉天悭。\n餐英饮露平生事，遗臭流芳一念间。\n菊不负君君负菊，年年秋不在家山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32451,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题建阳宋景高友于堂","author":"刘克庄","text":"枢相落成文甚古，府君卜筑墨犹新。\n宛如酿枣分梨日，堪愧燃萁煮豆人。\n五桂必攀昆季爽，三荆不析户庭春。\n梦中犹识三溪路，安得登堂列下宾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32452,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题赵广文南墅","author":"刘克庄","text":"博士才名贺白流，讵应蚤计到菟裘。\n宫中未索清平调，海上聊为汗漫游。\n隐几饱看山变态，开轩惟对竹清脩。\n买邻有志嗟无力，肯与羊昙共赌不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32453,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题徐仲晦须友堂二首 其二","author":"刘克庄","text":"西山仙去各离群，穷达区区不足云。\n仅有尹谯守伊洛，更无房魏说河汾。\n虎皮子盍闿新义，蠹简予方辑旧闻。\n何日蹇驴载樽酒，一灯析理更论文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32454,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题徐仲晦须友堂二首 其一","author":"刘克庄","text":"病翁岁晚朋从绝，细读高文面发惭。\n士贵切磋宁独学，僧虽苦硬有同参。\n名堂盖取伦之五，开径那无益者三。\n见说户庭来不拒，傥分半席待樗庵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32455,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题徐候雨山堂","author":"刘克庄","text":"竹溪来索后村吟，读记披图已醒心。\n岂是沕渊行雨懒，亦非避地入山深。\n喜看素瀑飞青壁，不管苍苔卧绿沉。\n西北城高刁斗急，将军未可问山林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32456,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄夔漕王中甫","author":"刘克庄","text":"旧岁书犹至汉阳，新年梦已隔瞿唐。\n西人久苦供军费，南士专营出峡装。\n尘暗三边途尚梗，身游万里鬓应苍。\n蜀山闻说多仙者，试为余求辟谷方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32457,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"尉侄寄百雀图","author":"刘克庄","text":"犹子知余嗜，封来半尺绡。\n谁将一兔颖，写作百鹪鹩。\n具体侔针粟，卑飞集苇苕。\n笑他九万里，辛苦上云霄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32458,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"崇化麻沙道中","author":"刘克庄","text":"经行爱此人烟好，面俯清溪背负山。\n半?何妨呼渡去，小桥不碍负薪还。\n远闻清磬来林杪，忽有朱栏出竹间。\n深处安知无隐者，卜邻容我设柴关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32459,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]