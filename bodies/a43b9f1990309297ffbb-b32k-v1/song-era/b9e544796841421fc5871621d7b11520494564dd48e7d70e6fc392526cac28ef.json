[{"title":"感旱二首 其一","author":"郭印","text":"大旱如焚气不苏，云师谁遣上天衢。\n人人准拟为霖甚，风动雷行雨却无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60794,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题三士轩诗","author":"郭印","text":"独立未为真，万法皆吾侣。\n故于竹柏间，强名相尔汝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60795,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题苏村酒家亭","author":"郭印","text":"下马穿桥憩酒家，小溪清浅蘸桃花。\n红尘咫尺如相背，独坐幽亭对落霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60796,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题独有堂诗","author":"郭印","text":"俯仰天上下，尊称唯我独。\n无物亦无人，本来真面目。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60797,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夔州元宵和曾端伯韵四首 其四","author":"郭印","text":"斗转寅初月正中，昏灯达旦九衢通。\n汉家祀事传来远，想见当时太一宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60798,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夔州元宵和曾端伯韵四首 其三","author":"郭印","text":"华灯下上照楼台，无数银花一夕开。\n月色多情能助兴，游人去了却重回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60799,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夔州元宵和曾端伯韵四首 其二","author":"郭印","text":"游子何须念故乡，酒酣聊发次公狂。\n人生行乐真佳耳，休苦栖心名利场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60800,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夔州元宵和曾端伯韵四首 其一","author":"郭印","text":"绮陌家家不下帘，花光世界总成莲。\n村歌社舞欢呼处，都道今年胜去年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60801,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"七月二十八日蒲大受仲明举偶来会宿三首 其三","author":"郭印","text":"秋风今夕好，一笑偶然同。\n时事艰难际，交情会合中。\n青云浑作梦，白发也应公。\n拟卜栖山计，应为邻舍翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60802,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"七月二十八日蒲大受仲明举偶来会宿三首 其二","author":"郭印","text":"少城能款曲，敝馆辱留连。\n未搅秋风思，还同夜雨眠。\n烟尘惊绝塞，草木验流年。\n斗酒君须醉，新诗看百篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60803,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"七月二十八日蒲大受仲明举偶来会宿三首 其一","author":"郭印","text":"别袂无多日，愁肠已屡回。\n未便新舍稳，先喜故人来。\n忧国空千虑，忘怀但一杯。\n相看情意好，归辔不须催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60804,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"七月十三日对月小集","author":"郭印","text":"露坐仍盘斝，澄澄夜色清。\n酒如君子厚，月似故人明。\n短舞天然态，长歌格外声。\n欢情殊未极，楼鼓发深更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60805,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"八月十六日观月段氏亭次王师老韵","author":"郭印","text":"隐映孤亭小，回环万竹幽。\n水声喧暗谷，月影淡高秋。\n物与黄昏静，人随白日流。\n一椽堪送老，何必仲宣楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60806,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"八月十四至十六日无月二首 其二","author":"郭印","text":"不见团圆桂景森，清辉一片本常今。\n欲看静夜千家昼，先扫长空万里阴。\n宇宙光明思佛掌，儿童嚬蹙见人心。\n茫茫千里凭谁问，每使良辰罢访寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60807,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"八月十四至十六日无月二首 其一","author":"郭印","text":"秋中景色正萧森，月色超然重古今。\n要使万方倾素采，那知三日翳重阴。\n晦冥欲害天公眼，想像难忘海宇心。\n决断浮云须好手，明年此夕要追寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60808,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"八阵台","author":"郭印","text":"八阵台前水急流，累累石冢界沙洲。\n机深已尽吞吴策，事变空成守蜀谋。\n江月四时犹耿耿，云山千古谩悠悠。\n天公若遂兴刘愿，功烈应非管乐俦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60809,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十七日夜当可同去非观月而子仪进道与仆皆不在焉当可有诗辄次韵","author":"郭印","text":"月过中秋色尚鲜，赏心未厌惜流年。\n琼杯不许三人共，桂魄难同两夜圆。\n碧落无云星避彩，清辉满座烛销烟。\n新诗唱罢应愁绝，影入珠帘照客眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60810,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十二月十三日喜雪二首 其二","author":"郭印","text":"缤纷飞六出，景色兔园同。\n桂树非摧月，杨花不起风。\n布银成世界，屑玉满虚空。\n此地知丰乐，如何答上穹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60811,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十二月十三日喜雪二首 其一","author":"郭印","text":"蜀雪古来少，天云今始同。\n霏微初带雨，凌乱更从风。\n练欲拖平野，盐疑撒远空。\n小民咸喜见，谁复怨高穹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60812,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"卜居","author":"郭印","text":"只忧短发变星星，早葺生涯寄暮龄。\n二顷可能轻相印，一区聊欲著玄经。\n不嫌野水侵扉绿，更喜寒筠绕屋青。\n投绂归来成底事，要驱龙虎遁天刑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60813,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"又用前韵","author":"郭印","text":"春事关心曲，无人昼款扉。\n莺犹求友啭，燕亦认巢归。\n物色浓如酒，风光驶若飞。\n幽斋谁与伴，窗外柳依依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60814,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三月三十日前人有诗云共君今夜不须睡未到晓钟犹是春再和前韵二首 其二","author":"郭印","text":"三春浑索寞，百卉任摧残。\n有感诗频赋，无欢酒易阑。\n调和思玉烛，延驻仗金丹。\n难系西飞日，吾心一寸寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60815,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三月三十日前人有诗云共君今夜不须睡未到晓钟犹是春再和前韵二首 其一","author":"郭印","text":"风雨年年横，莺花处处残。\n衰颜随节变，幽兴与春阑。\n俗眼从渠白，孤衷祇自丹。\n平生知任运，那复较暄寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60816,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三伏不热","author":"郭印","text":"三伏元无暑，连旬雨复阴。\n朝朝闲旧扇，夜夜拥重衾。\n日晦浮云翳，天愁沴气侵。\n烽烟犹未息，一念一伤心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60817,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上巳曲水","author":"郭印","text":"良辰元巳惜芳菲，一笑林亭挽落晖。\n圆吭高低齐献曲，浓阴远近密成围。\n縠翻细浪环池转，羽挟清觞傍席飞。\n不为不祥来祓濯，欲因流水送春归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60818,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上郑漕二首 其二","author":"郭印","text":"孤迹平生似转蓬，少而豪迈老羁穷。\n荣华路上黄粱梦，英俊丛中白发翁。\n身堕穷山三峡里，心随流水大江东。\n夤缘展翅斜阳晚，须仗扶摇一鹗风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60819,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上郑漕二首 其一","author":"郭印","text":"穷经好客旧时声，千载遗风见典型。\n忠孝家传心自赤，功名路稳鬓方青。\n傅岩欲作商霖雨，蜀道犹观汉使星。\n小益提封重试可，定膺锋召入尧庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60820,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上政府五首 其五","author":"郭印","text":"起家白屋忝为郎，俯视同侪道亦光。\n已幸十年纡赤绂，犹期一日坐黄堂。\n纷纷奔竞真成笑，兀兀憃愚但守常。\n不是坤舆能厚载，敢干斧锧献猖狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60821,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上政府五首 其四","author":"郭印","text":"三纪徒劳祇疗饥，年踰耳顺已知非。\n行藏有定随缘过，功业无成与愿违。\n里闬傥能乘驷入，君门便欲挂冠归。\n交朋亲戚犹相庆，要看桑榆晚日晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60822,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上政府五首 其三","author":"郭印","text":"政和乙未对彤庭，袖笔曾陪四海英。\n三十七年浑梦境，六千馀里邈神京。\n大钧播物无垠际，小录搜才有姓名。\n屈指西南存者几，成都首县一孤生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60823,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上政府五首 其二","author":"郭印","text":"塞上烟尘永不扬，边民戍卒尽耕桑。\n抗言用武真非策，唾手扶危别有方。\n须信精诚能感格，由来道德本安强。\n恩沾动植知多少，天使千秋保炽昌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60824,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上政府五首 其一","author":"郭印","text":"王室当年若缀旒，片言戡定出奇谋。\n临机勇决千钧弩，济险优游万斛舟。\n掌上回旋皆造化，毫端升黜是春秋。\n虫鱼尽喜乾坤泰，宇县宁闻杞国忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60825,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上曾安抚二首 其二","author":"郭印","text":"圣门鼓瑟妙难窥，今日风流亲见之。\n五纪光阴惊电掣，一生忠孝仗天知。\n老庄座下须闻道，李杜坛边敢说诗。\n晚景功名非所慕，抠衣深喜得宗师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60826,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上曾安抚二首 其一","author":"郭印","text":"万口争称好使君，携持踊跃看朱轮。\n入门便洒随车雨，到处真成有脚春。\n鱼鸟一时生意气，江山千里有精神。\n大贤易镇朝廷重，巴峡穷愁要抚循。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60827,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"下岩寺","author":"郭印","text":"云安欣及境，小刹为徘徊。\n殿阁随岩展，轩窗向水开。\n僧虽持钵出，客自舣舟回。\n欲住无留计，幽怀亦畅哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60828,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"久雨","author":"郭印","text":"四旬常苦雨，秋令叹先行。\n滴滴天垂泪，昏昏日翳睛。\n敢言频屋漏，深恐害粢盛。\n换甲明朝是，人人望快晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60829,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山中九日","author":"郭印","text":"信马幽寻惯，重阳未及家。\n清游贪翠巘，素约负黄花。\n纵目心先折，经秋鬓欲华。\n因循时节过，底处觅流霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60830,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山茶","author":"郭印","text":"枯林独秀染胭脂，不使群芳次第窥。\n月桂殷勤来并色，江梅寂寞许同时。\n霜飞雪舞终难挫，蝶隐蜂逃各未知。\n折得一枝聊慰眼，儿童拍手误春期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60831,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山茶","author":"郭印","text":"严冬能独秀，浑不藉春风。\n叶自经霜碧，花应斗日红。\n望中几眩眼，高处欲燔空。\n安得栽培手，移根向邑中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60832,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"广都世真上人南游回见访出群公诗见示丐予一语因思世间衲子尽是求佛觅禅底痴汉遂作数语警之","author":"郭印","text":"法象森罗万，全归一寸庵。\n有佛平生碍，无禅底处参。\n乌玄元自白，荼苦本来甘。\n前日南游话，看君作么谈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60833,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"不寐","author":"郭印","text":"自怜闻道晚，习气误平生。\n诗债几时尽，睡魔终夕轻。\n语言空自苦，德业竟何成。\n誓欲抛书册，茅檐适性情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60834,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中秋日与诸公同游宝莲院分韵得尘字","author":"郭印","text":"路出青山近，招提更可人。\n清心钟磬响，远迹簿书尘。\n晚日池亭迥，秋风杖屦亲。\n频来一尊酒，不畏老僧嗔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60835,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中秋日赴史漕赏月二首 其二","author":"郭印","text":"此夕非常夕，金波涌碧岑。\n一轮初散彩，八表尽倾心。\n永夜真同昼，浮云不蔽阴。\n主人澄静性，万古亦常今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60836,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中秋日赴史漕赏月二首 其一","author":"郭印","text":"秋色平分日，开筵命月轮。\n云容休妒客，天意解随人。\n平地铺寒水，遥空绝点尘。\n素娥来入座，端不负良辰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60837,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中秋佳月怀杜安行冯当可二首 其二","author":"郭印","text":"绝胜寻常三五盈，魄成金气自然清。\n烟云敛迹秋空阔，星斗沉光夜色明。\n璧堕江心随浪涌，镜飞天面逐人行。\n四方万里同清赏，大地今成白玉京。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60838,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中秋佳月怀杜安行冯当可二首 其一","author":"郭印","text":"西风捲尽片云浮，天宇团圆素月流。\n玉斧修成三夜景，银盘赛过十年秋。\n佳人渺邈心相照，羁客徘徊影共愁。\n安得仙娥一招手，驱鸾驾鹤上琼楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60839,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书台","author":"郭印","text":"崛起扶刘氏，兼资将相才。\n臣心虽自切，天命若为猜。\n古壁空遗像，荒榛只旧台。\n斯人今不见，落日更徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60840,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书怀二首 其二","author":"郭印","text":"四十行将至，空怀晚岁忧。\n看书浑欲睡，照镜秪堪羞。\n开口舌犹在，拂衣心未休。\n西风羡雕鹗，鼓翮占高秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60841,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书怀二首 其一","author":"郭印","text":"奔走尘埃内，拘挛筦库间。\n是心能旷适，何地不清闲。\n有客劝投绂，无钱堪买山。\n尚怜耽寸禄，理乱亦相关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60842,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"云溪杂咏 其七","author":"郭印","text":"步屧寻幽胜，亭边水竹饶。\n地令人事远，江遣客愁销。\n自是尘难近，谁云隐可招。\n洞天无别景，于此日逍遥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60843,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"云溪杂咏 其十二","author":"郭印","text":"小阁供遐眺，凝眸万景闲。\n江流连旷野，林杪出遥山。\n思远凭栏外，吟成倚杖间。\n乾坤无尽藏，造物岂容悭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60844,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"云溪杂咏 其一","author":"郭印","text":"入门何所有，弥望祇林泉。\n尘垢人间世，云霞洞里天。\n闲亭藏复见，小径绝仍连。\n勿说桃源地，幽深自一川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60845,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"云溪杂咏 其十三","author":"郭印","text":"道眼全无障，机心了不生。\n园亭如著意，物色岂留情。\n水鸟元相狎，渊鱼自勿惊。\n超然忘我见，万化各天成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60846,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"云溪杂咏 其十","author":"郭印","text":"一到平桥上，萧然净客心。\n两边风细细，四面竹森森。\n更喜清流驶，宁容畏暑侵。\n我来归不去，日永镇长阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60847,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"云溪杂咏 其十五","author":"郭印","text":"生植依山谷，移根伴此君。\n丛中抽紫干，幽处吐清芬。\n入室能俱化，同心自远闻。\n灵均元不试，委佩楚江濆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60848,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"云溪杂咏 其三","author":"郭印","text":"好景发天秘，幽情得快哉。\n亭从江上见，路向竹间开。\n有客相将入，无人独自来。\n芒鞋元准拟，和雨踏苍苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60849,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"云溪杂咏 其九","author":"郭印","text":"竹里虹桥见，葱葱翠气浮。\n枝交笼短岸，叶落赴寒流。\n索莫终年计，徘徊竟月留。\n清凉宜避热，风色晚飕飕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60850,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"云溪杂咏 其六","author":"郭印","text":"竹色琅玕立，花光锦绣舒。\n物情奚得丧，人意妄分疏。\n污净川同纳，媸妍鉴本虚。\n和光聊复尔，看取未形初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60851,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"云溪杂咏 其十四","author":"郭印","text":"寒潭深百尺，潜物晦其真。\n雨施时为润，渊居每自珍。\n飞腾应有道，变化岂无神。\n直待功成日，驱云上紫宸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60852,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"云溪杂咏 其十一","author":"郭印","text":"虚舟横沼面，窗户四玲珑。\n绛宇三山上，青天一镜中。\n夜深杨柳月，日永芰荷风。\n公退浑无事，江湖兴莫穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60853,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"云溪杂咏 其八","author":"郭印","text":"小桥藏曲折，幽径一溪分。\n旭日筛金影，春流展縠文。\n周遭无限玉，参错几重云。\n觌面融真意，相知祇此君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60854,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"云溪杂咏 其二","author":"郭印","text":"俗客寻常少，珍禽自在啼。\n一溪如练净，万竹与云齐。\n纵目心贪看，回头路却迷。\n清游殊未足，日下小桥西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60855,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"五月十二日晚登平云亭得平字齐字 其二","author":"郭印","text":"磴道穿乔木，危亭喜杖藜。\n郊原春树暗，井邑暮烟低。\n日没牛羊下，山空鸟雀啼。\n超然尘世外，身与白云齐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60856,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"五月十二日晚登平云亭得平字齐字 其一","author":"郭印","text":"路向林端出，云从屐齿生。\n山风迎夕起，烟树接天平。\n倚杖听僧语，窥檐待月明。\n幽禽知客意，时送两三声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60857,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"五月十三日种竹偶成二首 其二","author":"郭印","text":"园夫扶出径，元是醉为媒。\n密叶疏疏理，纤根细细栽。\n捲帘斜日避，倚杖好风来。\n佳客如相顾，还能伴酒杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60858,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"五月十三日种竹偶成二首 其一","author":"郭印","text":"开拓无多地，栽培只数竿。\n云分千亩润，风送一窗寒。\n坐上清阴罩，墙边野色团。\n课奴勤灌溉，日日报平安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60859,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"仁寿县后有亭余名之曰明远赋诗二首 其二","author":"郭印","text":"小邦人物大邦同，万屋鳞鳞气郁葱。\n谁挈神峰离海底，幻将廛市纳壶中。\n垂帘拟学山阴画，飞舄难乘叶县风。\n举首穹旻才一尺，敢凭正直谢天公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60860,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"仁寿县后有亭余名之曰明远赋诗二首 其一","author":"郭印","text":"虚亭突兀枕崇冈，玉宇无风秋自凉。\n地阔群山争逶迤，天低远树立微茫。\n阴晴易辨云霞色，晓夕常吞日月光。\n我亦清心官事省，葛巾藜杖得徜徉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60861,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]